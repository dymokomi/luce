#==============================================================================================
#
#   kernel - The runtime of the value language
#
#   DESCRIPTION:
#       What an emitted Luce program calls that Base does not spell itself: Python's `//`,
#       `%` and `**`, text made of pieces, the display of scalars, indexes and slices with
#       Luce's bounds and traps, ranges as values, and the list. Every text lives on the heap
#       and is never freed in this slice; the reference-counted runtime replaces this module
#       as a whole. Nothing here fails: an allocation that cannot be met traps, as §12
#       says it must.
#
#==============================================================================================

import c
import io
import memory
import strings

extern func c_pow as "pow"(x: f64, y: f64) -> f64
extern func c_strtod as "strtod"(text: c.str, end: c.str*?) -> f64

pub let luce_failure: ErrorCode = ErrorCode.package(65535)

# mark: Arithmetic =============================================================================

pub func floor_div(a: i64, b: i64) -> i64:
    let q = a // b
    if (a % b != 0) and ((a < 0) != (b < 0)):
        return q - 1
    return q

pub func floor_mod(a: i64, b: i64) -> i64:
    let r = a % b
    if r != 0 and ((r < 0) != (b < 0)):
        return r + b
    return r

pub func power(base: i64, exponent: i64) -> i64:
    if exponent < 0:
        trap("a negative exponent needs a float base")
    var result: i64 = 1
    var i: i64 = 0
    while i < exponent:
        result = result * base
        i += 1
    return result

pub func floor_float(x: f64) -> f64:
    let t = f64(i64(x))
    return t - 1.0 if t > x else t

pub func ffloor_div(a: f64, b: f64) -> f64:
    return floor_float(a / b)

pub func ffloor_mod(a: f64, b: f64) -> f64:
    return a - floor_float(a / b) * b

pub func fpower(base: f64, exponent: f64) -> f64:
    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:
        var result = 1.0
        var i: i64 = 0
        while i < i64(exponent):
            result = result * base
            i += 1
        return result
    return c_pow(base, exponent)

pub func to_int(f: f64) -> i64:
    return i64(f)

# mark: Text ===================================================================================

## Room on the heap, or a trap: Luce's out of memory is not recoverable (§12).
pub func room(n: usize) -> u8[]:
    let out = alloc u8[n if n > 0 else 1] catch failure:
        trap("out of memory")
    return out

pub func concat(a: str, b: str) -> str:
    var out = room(a.length + b.length)
    memory.copy(out, a.bytes, a.length)
    memory.copy(out[a.length..], b.bytes, b.length)
    return (str)out[..<a.length + b.length]

## The pieces of a formatted text, joined.
pub func join(pieces: const str[]) -> str:
    var n: usize = 0
    for p in pieces:
        n += p.length
    var out = room(n)
    var at: usize = 0
    for p in pieces:
        memory.copy(out[at..], p.bytes, p.length)
        at += p.length
    return (str)out[..<n]

pub func show_int(i: i64) -> str:
    var buffer: u8[32]
    let text = format(buffer, f"{i}") catch failure:
        trap("out of memory")
    return copy_text(text)

pub func show_float(f: f64) -> str:
    var buffer: u8[64]
    let text = format(buffer, f"{f}") catch failure:
        trap("out of memory")
    return copy_text(text)

pub func show_bool(b: bool) -> str:
    return "true" if b else "false"

pub func show_bytes(data: const u8[]) -> str:
    var b = strings.Builder.create(16) catch failure:
        trap("out of memory")
    b.put("b\"") catch failure:
        trap("out of memory")
    var buffer: u8[4]
    for byte in data:
        buffer[0] = '\\'
        buffer[1] = 'x'
        buffer[2] = hex_digit(byte >> 4)
        buffer[3] = hex_digit(byte & 15)
        b.put((str)buffer[..<4]) catch failure:
            trap("out of memory")
    b.put("\"") catch failure:
        trap("out of memory")
    let out = copy_text(b.view())
    b.destroy()
    return out

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

pub func copy_text(text: str) -> str:
    var out = room(text.length)
    memory.copy(out, text.bytes, text.length)
    return (str)out[..<text.length]

pub func print_line(text: str):
    var out = io.stdout()
    discard(out.write(text.bytes) catch failure: recover 0)
    discard(out.write("\n".bytes) catch failure: recover 0)

pub func compare_text(a: str, b: str) -> i64:
    var i: usize = 0
    while i < a.length and i < b.length:
        if a.bytes[i] != b.bytes[i]:
            return -1 if a.bytes[i] < b.bytes[i] else 1
        i += 1
    if a.length == b.length:
        return 0
    return -1 if a.length < b.length else 1

pub func compare_bytes(a: const u8[], b: const u8[]) -> i64:
    return compare_text((str)a, (str)b)

pub func contains(text: str, needle: str) -> bool:
    return strings.contains(text, needle)

## Scalars in a text, and a slice by scalar index (§11.3).
pub func scalar_length(s: str) -> i64:
    var n: i64 = 0
    for b in s.bytes:
        if (b & 0xC0) != 0x80:
            n += 1
    return n

pub func slice_text(s: str, low: i64, high: i64, whole: bool) -> str:
    let n = scalar_length(s)
    let hi = n if whole else high
    check_bounds(low, hi, n)
    let b = s.bytes
    var start: usize = b.length
    var end: usize = b.length
    var scalar: i64 = 0
    var i: usize = 0
    if low == 0:
        start = 0
    while i < b.length:
        if (b[i] & 0xC0) != 0x80:
            if scalar == low:
                start = i
            if scalar == hi:
                end = i
                break
            scalar += 1
        i += 1
    return (str)b[start..<end]

pub func slice_bytes(data: const u8[], low: i64, high: i64, whole: bool) -> const u8[]:
    let n = (i64)data.length
    let hi = n if whole else high
    check_bounds(low, hi, n)
    return data[(usize)low..<(usize)hi]

pub func check_bounds(low: i64, high: i64, n: i64):
    if low < 0 or high < low or high > n:
        trap("slice out of range")

## A Luce index into `count` elements: negative counts from the end; out of range traps.
pub func index(i: i64, count: usize) -> usize:
    var k = i
    if k < 0:
        k += (i64)count
    if k < 0 or k >= (i64)count:
        trap("index out of range")
    return (usize)k

## The scalars of a text, one at a time, as texts of one scalar.
pub struct Scalars:
    var text: str
    var at: usize

    pub static func over(text: str) -> Scalars:
        return Scalars(text = text, at = 0)

    pub mutating func next() -> str?:
        let b = self.text.bytes
        if self.at >= b.length:
            return none
        var n: usize = 1
        while self.at + n < b.length and (b[self.at + n] & 0xC0) == 0x80:
            n += 1
        let out = (str)b[self.at..<self.at + n]
        self.at += n
        return out

pub func parse_int(text: str) -> i64!:
    let n = strings.to_i64(strings.trim(text)) else error(luce_failure, "not an integer")
    return n

pub func parse_float(text: str) -> f64!:
    let t = strings.trim(text)
    if t.length == 0:
        error(luce_failure, "not a number")
    var buffer = room(t.length + 1)
    memory.copy(buffer, t.bytes, t.length)
    buffer[t.length] = 0
    return c_strtod((c.str)buffer.data, none)

pub func parse_bool(text: str) -> bool!:
    if text == "true":
        return true
    if text == "false":
        return false
    error(luce_failure, "not a boolean")

# mark: Ranges =================================================================================

pub struct Range:
    pub var low: i64
    pub var high: i64
    pub var inclusive: bool

pub func range(low: i64, high: i64, inclusive: bool) -> Range:
    return Range(low = low, high = high, inclusive = inclusive)

pub func in_range(i: i64, r: Range) -> bool:
    return i >= r.low and (i <= r.high if r.inclusive else i < r.high)

pub func range_end(r: Range) -> i64:
    return r.high + 1 if r.inclusive else r.high

pub func show_range(r: Range) -> str:
    return join([show_int(r.low), "..=" if r.inclusive else "..<", show_int(r.high)])

# mark: Lists ==================================================================================

## A growable list with identity: a pointer to its storage, shared by every binding.
pub struct ListStore[T]:
    pub var items: T[]
    pub var count: usize

pub func new_list[T](capacity: usize) -> ListStore[T]*:
    let store = new ListStore[T] catch failure:
        trap("out of memory")
    let items = alloc T[capacity if capacity > 0 else 4] catch failure:
        trap("out of memory")
    store.items = items
    store.count = 0
    return store

pub func list_append[T](l: ListStore[T]*, item: T):
    if l.count == l.items.length:
        let grown = alloc T[l.items.length * 2] catch failure:
            trap("out of memory")
        memory.copy(grown, l.items, l.count)
        l.items = grown
    l.items[l.count] = item
    l.count += 1

pub func list_get[T](l: ListStore[T]*, i: i64) -> T:
    return l.items[index(i, l.count)]

pub func list_set[T](l: ListStore[T]*, i: i64, item: T):
    l.items[index(i, l.count)] = item

pub func list_length[T](l: ListStore[T]*) -> i64:
    return (i64)l.count

pub func list_from_args(arguments: str[]) -> ListStore[str]*:
    let l = new_list[str](arguments.length)
    for a in arguments:
        list_append[str](l, a)
    return l

## A failure leaving `main`: reported the way the interpreter reports it.
pub func print_error(message: str):
    var err = io.stderr()
    discard(err.write("error: ".bytes) catch failure: recover 0)
    discard(err.write(message.bytes) catch failure: recover 0)
    discard(err.write("\n".bytes) catch failure: recover 0)

pub func show_text(s: str) -> str:
    return s
