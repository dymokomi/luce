#==============================================================================================
#
#   kernel/text - Text operations (§11.3)
#
#   DESCRIPTION:
#       The methods of `str` and `bytes`: searching, splitting, trimming, case, padding and
#       the rest, each answering a text of its own.
#
#==============================================================================================

# mark: Text operations (§11.3) ================================================================

func find_bytes(haystack: const u8[], needle: const u8[], start: usize) -> usize?:
    if needle.length == 0:
        return start
    var i = start
    while i + needle.length <= haystack.length:
        var k: usize = 0
        while k < needle.length and haystack[i + k] == needle[k]:
            k += 1
        if k == needle.length:
            return i
        i += 1
    return none

pub func starts_with(text: Text*, prefix: Text*) -> bool:
    if prefix.data.length > text.data.length:
        return false
    return compare_bytes(text.data.bytes[..<prefix.data.length], prefix.data.bytes) == 0

pub func ends_with(text: Text*, suffix: Text*) -> bool:
    if suffix.data.length > text.data.length:
        return false
    return compare_bytes(text.data.bytes[text.data.length - suffix.data.length..], suffix.data.bytes) == 0

## The scalar index of the first occurrence, or none.
pub func index_of(text: Text*, needle: Text*) -> i64?:
    let at = find_bytes(text.data.bytes, needle.data.bytes, 0) else return none
    var n: i64 = 0
    for b in text.data.bytes[..<at]:
        if (b & 0xC0) != 0x80:
            n += 1
    return n

pub func split(text: Text*, separator: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:
    if separator.data.length == 0:
        heap.stop("split needs a separator")
    let out = list_new[Text*](info, ops)
    var start: usize = 0
    while true:
        let at = find_bytes(text.data.bytes, separator.data.bytes, start) else break
        list_push[Text*](out, text_of((str)text.data.bytes[start..<at]))
        start = at + separator.data.length
    list_push[Text*](out, text_of((str)text.data.bytes[start..]))
    return out

pub func lines(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:
    let out = list_new[Text*](info, ops)
    let b = text.data.bytes
    var start: usize = 0
    var i: usize = 0
    while i < b.length:
        if b[i] == '\n':
            var end = i
            if end > start and b[end - 1] == '\r':
                end -= 1
            list_push[Text*](out, text_of((str)b[start..<end]))
            start = i + 1
        i += 1
    if start < b.length:
        list_push[Text*](out, text_of((str)b[start..]))
    return out

## ASCII white space, as Python's `strip()` and `split()` take it there: a space, a tab, a
## line feed, a carriage return, a vertical tab, a form feed.
func is_white(byte: u8) -> bool:
    return byte == ' ' or byte == '\t' or byte == '\n' or byte == '\r' or byte == 11 or byte == 12

## `trim()`, `trim_start()` and `trim_end()`: white space gone from both ends or one.
pub func trim(text: Text*) -> Text*:
    return trimmed(text, true, true)

pub func trim_start(text: Text*) -> Text*:
    return trimmed(text, true, false)

pub func trim_end(text: Text*) -> Text*:
    return trimmed(text, false, true)

func trimmed(text: Text*, start_too: bool, end_too: bool) -> Text*:
    let b = text.data.bytes
    var start: usize = 0
    var end = b.length
    while start_too and start < end and is_white(b[start]):
        start += 1
    while end_too and end > start and is_white(b[end - 1]):
        end -= 1
    return text_of((str)b[start..<end])

pub func upper(text: Text*) -> Text*:
    let t = text_room(text.data.length)
    let out = text_bytes(t)
    var i: usize = 0
    while i < text.data.length:
        let byte = text.data.bytes[i]
        out[i] = byte - 32 if byte >= 'a' and byte <= 'z' else byte
        i += 1
    return t

pub func lower(text: Text*) -> Text*:
    let t = text_room(text.data.length)
    let out = text_bytes(t)
    var i: usize = 0
    while i < text.data.length:
        let byte = text.data.bytes[i]
        out[i] = byte + 32 if byte >= 'A' and byte <= 'Z' else byte
        i += 1
    return t

pub func replace(text: Text*, old: Text*, new_text: Text*) -> Text*:
    if old.data.length == 0:
        heap.stop("replace needs a text to replace")
    let source = text.data.bytes
    var count: usize = 0
    var start: usize = 0
    while true:
        let at = find_bytes(source, old.data.bytes, start) else break
        count += 1
        start = at + old.data.length
    let total = source.length - count * old.data.length + count * new_text.data.length
    let t = text_room(total)
    let out = text_bytes(t)
    var at_out: usize = 0
    start = 0
    while true:
        let at = find_bytes(source, old.data.bytes, start) else break
        memory.copy(out[at_out..], source[start..<at], at - start)
        at_out += at - start
        memory.copy(out[at_out..], new_text.data.bytes, new_text.data.length)
        at_out += new_text.data.length
        start = at + old.data.length
    memory.copy(out[at_out..], source[start..], source.length - start)
    return t

pub func repeat(text: Text*, n: i64) -> Text*:
    if n < 0:
        heap.stop("repeat of a negative count")
    let total = text.data.length * (usize)n
    let t = text_room(total)
    let out = text_bytes(t)
    var i: usize = 0
    while i < (usize)n:
        memory.copy(out[i * text.data.length..], text.data.bytes, text.data.length)
        i += 1
    return t

# mark: More text operations (§11.3) ===========================================================

## `split()`: the runs of text between runs of white space, no empty piece (Python's).
pub func split_white(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:
    let out = list_new[Text*](info, ops)
    let b = text.data.bytes
    var i: usize = 0
    while i < b.length:
        while i < b.length and is_white(b[i]):
            i += 1
        let start = i
        while i < b.length and not is_white(b[i]):
            i += 1
        if i > start:
            list_push[Text*](out, text_of((str)b[start..<i]))
    return out

## `count(s)`: the occurrences of `s` that do not overlap, left to right.
pub func count_of(text: Text*, needle: Text*) -> i64:
    if needle.data.length == 0:
        heap.stop("count needs a text to count")
    var n: i64 = 0
    var start: usize = 0
    while true:
        let at = find_bytes(text.data.bytes, needle.data.bytes, start) else break
        n += 1
        start = at + needle.data.length
    return n

## The scalar index of the last occurrence, or none; an empty needle is at the end.
pub func last_index_of(text: Text*, needle: Text*) -> i64?:
    let b = text.data.bytes
    let n = needle.data.length
    if n > b.length:
        return none
    var i = b.length - n + 1
    while i > 0:
        i -= 1
        if compare_bytes(b[i..<i + n], needle.data.bytes) == 0:
            return scalars_before(b, i)
    return none

func scalars_before(b: const u8[], at: usize) -> i64:
    var n: i64 = 0
    for byte in b[..<at]:
        if (byte & 0xC0) != 0x80:
            n += 1
    return n

## `remove_prefix(s)` and `remove_suffix(s)`: the text without it when it has it.
pub func remove_prefix(text: Text*, prefix: Text*) -> Text*:
    if starts_with(text, prefix):
        return text_of((str)text.data.bytes[prefix.data.length..])
    return text_of(text.data)

pub func remove_suffix(text: Text*, suffix: Text*) -> Text*:
    if ends_with(text, suffix):
        return text_of((str)text.data.bytes[..<text.data.length - suffix.data.length])
    return text_of(text.data)

## `pad_left`, `pad_right` and `center`: `fill`, one scalar, until the text is `width`
## scalars wide; `center` puts the odd one where Python's `str.center` does.
pub func pad_left(text: Text*, width: i64, fill: Text*) -> Text*:
    let margin = padding_of(text, width, fill)
    return padded(text, margin, 0, fill)

pub func pad_right(text: Text*, width: i64, fill: Text*) -> Text*:
    let margin = padding_of(text, width, fill)
    return padded(text, 0, margin, fill)

pub func center(text: Text*, width: i64, fill: Text*) -> Text*:
    let margin = padding_of(text, width, fill)
    let left = margin // 2 + (margin & width & 1)
    return padded(text, left, margin - left, fill)

func padding_of(text: Text*, width: i64, fill: Text*) -> i64:
    if scalar_length(fill) != 1:
        heap.stop("a fill is one scalar")
    let n = scalar_length(text)
    return width - n if width > n else 0

func padded(text: Text*, left: i64, right: i64, fill: Text*) -> Text*:
    let f = fill.data.length
    let t = text_room((usize)(left + right) * f + text.data.length)
    let out = text_bytes(t)
    var at: usize = 0
    for _ in 0..<left:
        memory.copy(out[at..], fill.data.bytes, f)
        at += f
    memory.copy(out[at..], text.data.bytes, text.data.length)
    at += text.data.length
    for _ in 0..<right:
        memory.copy(out[at..], fill.data.bytes, f)
        at += f
    return t

func ascii_letter(byte: u8) -> bool:
    return (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z')

func upper_byte(byte: u8) -> u8:
    return byte - 32 if byte >= 'a' and byte <= 'z' else byte

func lower_byte(byte: u8) -> u8:
    return byte + 32 if byte >= 'A' and byte <= 'Z' else byte

## `capitalize()`: the first scalar upper case, the rest lower (ASCII letters, as `upper`).
pub func capitalize(text: Text*) -> Text*:
    let t = text_room(text.data.length)
    let out = text_bytes(t)
    var i: usize = 0
    while i < text.data.length:
        let byte = text.data.bytes[i]
        out[i] = upper_byte(byte) if i == 0 else lower_byte(byte)
        i += 1
    return t

## `title()`: each word's first letter upper case and the rest lower, a word a run of
## letters, any scalar past ASCII counting as one (it is left as it is).
pub func title(text: Text*) -> Text*:
    let t = text_room(text.data.length)
    let out = text_bytes(t)
    var in_word = false
    var i: usize = 0
    while i < text.data.length:
        let byte = text.data.bytes[i]
        if ascii_letter(byte):
            out[i] = lower_byte(byte) if in_word else upper_byte(byte)
            in_word = true
        else:
            out[i] = byte
            in_word = byte >= 0x80
        i += 1
    return t

## `is_digit()`, `is_alpha()`, `is_alnum()`, `is_space()`: every scalar in the ASCII class,
## and at least one.
pub func is_digit(text: Text*) -> bool:
    return every_byte(text, 0)

pub func is_alpha(text: Text*) -> bool:
    return every_byte(text, 1)

pub func is_alnum(text: Text*) -> bool:
    return every_byte(text, 2)

pub func is_space(text: Text*) -> bool:
    return every_byte(text, 3)

func every_byte(text: Text*, class: u8) -> bool:
    if text.data.length == 0:
        return false
    for byte in text.data.bytes:
        let digit = byte >= '0' and byte <= '9'
        let fits = digit if class == 0 else ascii_letter(byte) if class == 1 else digit or ascii_letter(byte) if class == 2 else is_white(byte)
        if not fits:
            return false
    return true

## `reversed()`: the scalars in reverse order.
pub func reversed(text: Text*) -> Text*:
    let b = text.data.bytes
    let t = text_room(b.length)
    let out = text_bytes(t)
    var at = b.length
    var i: usize = 0
    while i < b.length:
        var n: usize = 1
        while i + n < b.length and (b[i + n] & 0xC0) == 0x80:
            n += 1
        at -= n
        memory.copy(out[at..], b[i..<i + n], n)
        i += n
    return t

## `characters()`: each scalar as a text of its own, in order.
pub func characters(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:
    let out = list_new[Text*](info, ops)
    var scalars = Scalars.over(text)
    while let one = scalars.next():
        list_push[Text*](out, one)
    return out

pub func text_to_bytes(t: Text*) -> Bytes*:
    return bytes_of(t.data.bytes)

## `bytes.text()`: the bytes as text when they are UTF-8 (§11.4).
pub func decode_text(data: Bytes*) -> Text*!:
    if not valid_utf8(data.data):
        error(luce_failure, "invalid UTF-8")
    return text_of((str)data.data)

func valid_utf8(b: const u8[]) -> bool:
    var i: usize = 0
    while i < b.length:
        let lead = b[i]
        var n: usize = 0
        if lead < 0x80:
            n = 0
        elif lead >= 0xC2 and lead <= 0xDF:
            n = 1
        elif lead >= 0xE0 and lead <= 0xEF:
            n = 2
        elif lead >= 0xF0 and lead <= 0xF4:
            n = 3
        else:
            return false
        var k: usize = 1
        while k <= n:
            if i + k >= b.length or (b[i + k] & 0xC0) != 0x80:
                return false
            k += 1
        if n == 2 and lead == 0xE0 and b[i + 1] < 0xA0:
            return false
        if n == 2 and lead == 0xED and b[i + 1] >= 0xA0:
            return false
        if n == 3 and lead == 0xF0 and b[i + 1] < 0x90:
            return false
        if n == 3 and lead == 0xF4 and b[i + 1] >= 0x90:
            return false
        i += n + 1
    return true

pub func concat_bytes(a: Bytes*, b: Bytes*) -> Bytes*:
    let out = (Bytes*)heap.allocate_sized(&bytes_info, memory.size_of(Bytes) + a.data.length + b.data.length)
    let store = u8[]((u8*)out + memory.size_of(Bytes), a.data.length + b.data.length)
    memory.copy(store, a.data, a.data.length)
    memory.copy(store[a.data.length..], b.data, b.data.length)
    out.data = store
    return out

## The pieces joined, then each let go of: what a generated display builds from.
pub func join_owned(pieces: const (Text*)[]) -> Text*:
    let out = join(pieces)
    for p in pieces:
        heap.release((heap.Object*)p)
    return out
