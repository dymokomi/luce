#==============================================================================================
#
#   kernel/list_methods - The list's searches, sorts and functions (§11.1)
#
#   DESCRIPTION:
#       What a list does with its elements beyond holding them: extending, counting and
#       removing by equality, sorting stably by the elements or by a key, the least and the
#       greatest, sums, and the methods taking a function. Each is the algorithm the
#       interpreter runs, call for call, so a key or a comparison with an effect is seen
#       alike. A function given an element gets a copy of its own; one that changes the
#       list's shape meanwhile traps, as a `for` over it does.
#
#==============================================================================================

# mark: Searching and changing =================================================================

## `extend(other)`: copies of `other`'s elements at the end, `other` the list itself or not.
pub func list_extend[T](l: List[T]*, other: List[T]*):
    let n = other.count
    list_room[T](l, l.count + n)
    var i: usize = 0
    while i < n:
        list_push[T](l, elem_copy[T](other, other.items[i]))
        i += 1
    l.version += 1

## `count(x)`: the elements equal to `x`.
pub func list_count[T](l: List[T]*, item: T) -> i64:
    var n: i64 = 0
    var i: usize = 0
    while i < l.count:
        if elem_equal[T](l, l.items[i], item):
            n += 1
        i += 1
    return n

## `remove(x)`: the first element equal to `x` taken out and let go of; whether there was one.
pub func list_remove[T](l: List[T]*, item: T) -> bool:
    var at: usize = 0
    while at < l.count and not elem_equal[T](l, l.items[at], item):
        at += 1
    if at == l.count:
        return false
    let out = l.items[at]
    var k = at
    while k + 1 < l.count:
        l.items[k] = l.items[k + 1]
        k += 1
    l.count -= 1
    l.version += 1
    elem_drop[T](l, out)
    return true

# mark: Sorting ================================================================================

## `sort(key, reverse)` by the elements themselves: in place and stable. The elements leave
## the list while it sorts, as in Python, so a comparison sees it empty, and one that
## changes it traps.
pub func list_sort[T](l: List[T]*, reverse: bool):
    let compare = l.ops.compare else heap.stop("elements without an ordering")
    let (items, n, version) = detach[T](l)
    let order = sorted_order[T](items[..<n], compare, reverse)
    attach_ordered[T](l, items, n, order, version)

## `sort(key = f, reverse)`: each element's key made once, in order, then the elements
## sorted stably by their keys.
pub func list_sort_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], reverse: bool):
    let compare = key_ops.compare else heap.stop("keys without an ordering")
    let (items, n, version) = detach[T](l)
    let keys = new K[n if n > 0 else 1] --- catch failure:
        heap.stop("out of memory")
    let code = (func(heap.Object*, T) -> K)key.code
    var i: usize = 0
    while i < n:
        keys[i] = code((heap.Object*)key, items[i])
        i += 1
    let order = sorted_order[K](keys[..<n], compare, reverse)
    if let drop = key_ops.drop:
        i = 0
        while i < n:
            drop(keys[i])
            i += 1
    free(keys)
    attach_ordered[T](l, items, n, order, version)

## `sorted(key, reverse)`: a sorted copy.
pub func list_sorted[T](l: List[T]*, reverse: bool) -> List[T]*:
    let out = list_copy[T](l)
    list_sort[T](out, reverse)
    return out

pub func list_sorted_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], reverse: bool) -> List[T]*:
    let out = list_copy[T](l)
    list_sort_by[T, K](out, key, key_ops, reverse)
    return out

## The elements out of the list, which is left empty, and the version it then has.
func detach[T](l: List[T]*) -> (T[], usize, u64):
    let items = l.items
    let n = l.count
    l.items = new T[4] --- catch failure:
        heap.stop("out of memory")
    l.count = 0
    l.version += 1
    return (items, n, l.version)

## The elements back in the list, in `order`; a list that changed meanwhile traps.
func attach_ordered[T](l: List[T]*, items: T[], n: usize, order: usize[], version: u64):
    if l.version != version or l.count != 0:
        heap.stop("the list changed while it was sorted")
    let sorted = new T[items.length] --- catch failure:
        heap.stop("out of memory")
    var i: usize = 0
    while i < n:
        sorted[i] = items[order[i]]
        i += 1
    free(items)
    free(order)
    free(l.items)
    l.items = sorted
    l.count = n
    l.version += 1

## The order that sorts `keys` stably by `compare`; `reverse` sorts the other way and still
## keeps equal keys in their order, as Python's does. A merge sort, top down, its
## comparisons in the interpreter's order.
func sorted_order[K](keys: const K[], compare: func(K, K) -> i64, reverse: bool) -> usize[]:
    let n = keys.length
    var order = new usize[n if n > 0 else 1] --- catch failure:
        heap.stop("out of memory")
    var spare = new usize[n if n > 0 else 1] --- catch failure:
        heap.stop("out of memory")
    var i: usize = 0
    while i < n:
        order[i] = i
        i += 1
    merge_sort[K](keys, compare, reverse, order, spare, 0, n)
    free(spare)
    return order

func merge_sort[K](keys: const K[], compare: func(K, K) -> i64, reverse: bool, order: usize[], spare: usize[], low: usize, high: usize):
    if high - low < 2:
        return
    let middle = low + (high - low) // 2
    merge_sort[K](keys, compare, reverse, order, spare, low, middle)
    merge_sort[K](keys, compare, reverse, order, spare, middle, high)
    var i = low
    var j = middle
    var k = low
    while i < middle and j < high:
        # the right one first only when it comes strictly before the left
        let sign = compare(keys[order[j]], keys[order[i]])
        if (sign > 0 if reverse else sign < 0):
            spare[k] = order[j]
            j += 1
        else:
            spare[k] = order[i]
            i += 1
        k += 1
    while i < middle:
        spare[k] = order[i]
        i += 1
        k += 1
    while j < high:
        spare[k] = order[j]
        j += 1
        k += 1
    k = low
    while k < high:
        order[k] = spare[k]
        k += 1

# mark: Least and greatest =====================================================================

## `min()` (`least`) and `max()`: a copy of the first least or greatest element, none of an
## empty list.
pub func list_min[T](l: List[T]*, least: bool) -> T?:
    if l.count == 0:
        return none
    let compare = l.ops.compare else heap.stop("elements without an ordering")
    let version = l.version
    var best: usize = 0
    var i: usize = 1
    while i < l.count:
        let sign = compare(l.items[i], l.items[best])
        list_check[T](l, version)
        if (sign < 0 if least else sign > 0):
            best = i
        i += 1
    return elem_copy[T](l, l.items[best])

## `min(key = f)` and `max(key = f)`: by each element's key, made once, in order.
pub func list_min_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], least: bool) -> T?:
    if l.count == 0:
        return none
    let compare = key_ops.compare else heap.stop("keys without an ordering")
    let version = l.version
    var best: usize = 0
    var best_key = call_on[T, K](l, key, 0, version)
    var i: usize = 1
    while i < l.count:
        let k = call_on[T, K](l, key, i, version)
        let sign = compare(k, best_key)
        if (sign < 0 if least else sign > 0):
            drop_value[K](key_ops, best_key)
            best_key = k
            best = i
        else:
            drop_value[K](key_ops, k)
        i += 1
    drop_value[K](key_ops, best_key)
    return elem_copy[T](l, l.items[best])

func drop_value[K](ops: Ops[K], v: K):
    if let drop = ops.drop:
        drop(v)

## `sum()` of a `list[int]`: overflow traps, as `+` does.
pub func list_sum_int(l: List[i64]*) -> i64:
    var total: i64 = 0
    var i: usize = 0
    while i < l.count:
        total = total +? l.items[i] else heap.stop("integer overflow")
        i += 1
    return total

## `sum()` of a `list[float]`: Neumaier's compensated sum, as Python's `sum` adds floats.
pub func list_sum_float(l: List[f64]*) -> f64:
    var total = 0.0
    var compensation = 0.0
    var i: usize = 0
    while i < l.count:
        let x = l.items[i]
        let t = total + x
        if magnitude(total) >= magnitude(x):
            compensation += (total - t) + x
        else:
            compensation += (x - t) + total
        total = t
        i += 1
    # the compensation of an infinite or overflowed sum is not added: it would make a NaN
    if compensation != 0.0 and compensation - compensation == 0.0:
        total += compensation
    return total

func magnitude(x: f64) -> f64:
    return -x if x < 0.0 else x

# mark: Functions of the elements ==============================================================

## A closure of one element called on a copy of its own, so the call may change the list
## and the element still live through it; a change of the list's shape then traps.
func call_on[T, R](l: List[T]*, f: Closure*, i: usize, version: u64) -> R:
    let item = elem_copy[T](l, l.items[i])
    let out = ((func(heap.Object*, T) -> R)f.code)((heap.Object*)f, item)
    elem_drop[T](l, item)
    list_check[T](l, version)
    return out

## `map(f)`: a new list of `f` over each element, the results owned by it; `f` is a
## closure, called by the convention every closure follows: its own object first.
pub func list_map[T, U](l: List[T]*, f: Closure*, info: heap.Info*, ops: Ops[U]) -> List[U]*:
    let out = list_new[U](info, ops)
    let version = l.version
    var i: usize = 0
    while i < l.count:
        list_push[U](out, call_on[T, U](l, f, i, version))
        i += 1
    return out

## `flat_map(f)`: the elements of every list `f` makes, in order.
pub func list_flat_map[T, U](l: List[T]*, f: Closure*, info: heap.Info*, ops: Ops[U]) -> List[U]*:
    let out = list_new[U](info, ops)
    let version = l.version
    var i: usize = 0
    while i < l.count:
        let part = call_on[T, List[U]*](l, f, i, version)
        var k: usize = 0
        while k < part.count:
            list_push[U](out, elem_copy[U](part, part.items[k]))
            k += 1
        heap.release((heap.Object*)part)
        i += 1
    return out

pub func list_filter[T](l: List[T]*, f: Closure*) -> List[T]*:
    let out = list_new[T](l.header.info, l.ops)
    let version = l.version
    var i: usize = 0
    while i < l.count:
        if call_on[T, bool](l, f, i, version):
            list_push[T](out, elem_copy[T](l, l.items[i]))
        i += 1
    return out

## `any(f)` and `all(f)`: whether `f` holds for one element, or for every one; they stop
## at the first that decides.
pub func list_any[T](l: List[T]*, f: Closure*) -> bool:
    let version = l.version
    var i: usize = 0
    while i < l.count:
        if call_on[T, bool](l, f, i, version):
            return true
        i += 1
    return false

pub func list_all[T](l: List[T]*, f: Closure*) -> bool:
    let version = l.version
    var i: usize = 0
    while i < l.count:
        if not call_on[T, bool](l, f, i, version):
            return false
        i += 1
    return true

## `find(f)`: a copy of the first element `f` holds for, or none.
pub func list_find[T](l: List[T]*, f: Closure*) -> T?:
    let version = l.version
    var i: usize = 0
    while i < l.count:
        if call_on[T, bool](l, f, i, version):
            return elem_copy[T](l, l.items[i])
        i += 1
    return none

## `reduce(f, initial)`: `f(f(initial, first), second)` and so on, left to right.
pub func list_reduce[T, A](l: List[T]*, f: Closure*, initial: A, ops: Ops[A]) -> A:
    var total = initial
    if let copy = ops.copy:
        total = copy(initial)
    let code = (func(heap.Object*, A, T) -> A)f.code
    let version = l.version
    var i: usize = 0
    while i < l.count:
        let item = elem_copy[T](l, l.items[i])
        let next = code((heap.Object*)f, total, item)
        elem_drop[T](l, item)
        drop_value[A](ops, total)
        total = next
        list_check[T](l, version)
        i += 1
    return total

# mark: New lists ===============================================================================

## `zip(other)`: pairs of the elements at each index, as long as the shorter list.
pub func list_zip[T, U](l: List[T]*, other: List[U]*, info: heap.Info*, ops: Ops[(T, U)]) -> List[(T, U)]*:
    let out = list_new[(T, U)](info, ops)
    let n = l.count if l.count < other.count else other.count
    var i: usize = 0
    while i < n:
        list_push[(T, U)](out, (elem_copy[T](l, l.items[i]), elem_copy[U](other, other.items[i])))
        i += 1
    return out

## `chunks(size)`: the elements in lists of `size`, the last one shorter when they run out.
pub func list_chunks[T](l: List[T]*, size: i64, info: heap.Info*, ops: Ops[List[T]*]) -> List[List[T]*]*:
    if size < 1:
        heap.stop("chunks of a size below one")
    let out = list_new[List[T]*](info, ops)
    var start: i64 = 0
    while start < (i64)l.count:
        let end = start + size if size < (i64)l.count - start else (i64)l.count
        list_push[List[T]*](out, list_slice[T](l, start, end, false))
        start = end
    return out

## `indexed()` as a value: each element with its index.
pub func list_indexed[T](l: List[T]*, info: heap.Info*, ops: Ops[(i64, T)]) -> List[(i64, T)]*:
    let out = list_new[(i64, T)](info, ops)
    var i: usize = 0
    while i < l.count:
        list_push[(i64, T)](out, ((i64)i, elem_copy[T](l, l.items[i])))
        i += 1
    return out

## `distinct()`: the elements without the ones equal to an earlier one, in order, found
## through a table of their hashes.
pub func list_distinct[T](l: List[T]*) -> List[T]*:
    let hashed = l.ops.hashed else heap.stop("elements without a hash")
    let out = list_new[T](l.header.info, l.ops)
    var size: usize = 8
    while size < l.count * 2:
        size *= 2
    var slots = new usize[size] --- catch failure:
        heap.stop("out of memory")
    let empty: usize = 18446744073709551615
    var i: usize = 0
    while i < size:
        slots[i] = empty
        i += 1
    i = 0
    while i < l.count:
        var at = (usize)hashed(l.items[i]) & (size - 1)
        var seen = false
        while slots[at] != empty and not seen:
            seen = elem_equal[T](l, out.items[slots[at]], l.items[i])
            if not seen:
                at = (at + 1) & (size - 1)
        if not seen:
            slots[at] = out.count
            list_push[T](out, elem_copy[T](l, l.items[i]))
        i += 1
    free(slots)
    return out
