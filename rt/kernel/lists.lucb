#==============================================================================================
#
#   kernel/lists - The list (§11.1)
#
#   DESCRIPTION:
#       `list[T]`: its storage and every operation of §11.1, its elements' copies, drops and
#       comparisons through the `Ops` the emitted program hands it.
#
#==============================================================================================

# mark: Lists =================================================================================

## What a collection needs of its element type; `none` where the type does not have it.
pub struct Ops[T]:
    pub var copy: (func(T) -> T)?
    pub var drop: (func(T) -> unit)?
    pub var trace: (func(T, func(heap.Object*, void*) -> unit, void*) -> unit)?
    pub var equal: (func(T, T) -> bool)?
    pub var compare: (func(T, T) -> i64)?
    pub var hashed: (func(T) -> u64)?

## `list[T]` (§11.1): an object the collector traces, its elements owned, `version`
## counting the structural changes a running `for` must not see.
pub struct List[T]:
    pub var header: heap.Object
    pub var items: T[]
    pub var count: usize
    pub var version: u64
    pub var ops: Ops[T]

pub func list_new[T](info: heap.Info*, ops: Ops[T]) -> List[T]*:
    let l = (List[T]*)heap.allocate(info)
    l.items = new T[4] --- catch failure:
        heap.stop("out of memory")
    l.count = 0
    l.version = 0
    l.ops = ops
    return l

## A literal: the elements are owned already.
pub func list_of[T](info: heap.Info*, ops: Ops[T], elements: const T[]) -> List[T]*:
    let l = list_new[T](info, ops)
    for e in elements:
        list_push[T](l, e)
    return l

func list_room[T](l: List[T]*, n: usize):
    if n <= l.items.length:
        return
    var size = l.items.length * 2
    while size < n:
        size = size * 2
    let grown = new T[size] --- catch failure:
        heap.stop("out of memory")
    memory.copy(grown, l.items, l.count)
    free(l.items)
    l.items = grown

func list_push[T](l: List[T]*, item: T):
    list_room[T](l, l.count + 1)
    l.items[l.count] = item
    l.count += 1

func elem_copy[T](l: List[T]*, v: T) -> T:
    if let f = l.ops.copy:
        return f(v)
    return v

func elem_drop[T](l: List[T]*, v: T):
    if let f = l.ops.drop:
        f(v)

## `append(x)`: the list takes the value.
pub func list_append[T](l: List[T]*, item: T):
    list_push[T](l, item)
    l.version += 1

pub func list_insert[T](l: List[T]*, i: i64, item: T):
    if i < 0 or i > (i64)l.count:
        heap.stop("index out of range")
    list_room[T](l, l.count + 1)
    var k = l.count
    while k > (usize)i:
        l.items[k] = l.items[k - 1]
        k -= 1
    l.items[(usize)i] = item
    l.count += 1
    l.version += 1

## `remove_at(i)`: the element, owned by the caller.
pub func list_remove_at[T](l: List[T]*, i: i64) -> T:
    let at = index(i, l.count)
    let out = l.items[at]
    var k = at
    while k + 1 < l.count:
        l.items[k] = l.items[k + 1]
        k += 1
    l.count -= 1
    l.version += 1
    return out

pub func list_pop[T](l: List[T]*) -> T:
    if l.count == 0:
        heap.stop("pop of an empty list")
    l.count -= 1
    l.version += 1
    return l.items[l.count]

## `clear()`: the elements are let go of once the list no longer holds them. Letting one go
## can run the cycle collector, whose walk must not find a released element in the list; a
## `deinit` that appends to the list meanwhile writes to fresh storage.
pub func list_clear[T](l: List[T]*):
    let n = l.count
    l.count = 0
    l.version += 1
    let drop = l.ops.drop else return
    if n == 0:
        return
    let items = l.items
    l.items = new T[items.length] --- catch failure:
        heap.stop("out of memory")
    var i: usize = 0
    while i < n:
        drop(items[i])
        i += 1
    free(items)

## `values[i]`: a copy of the element, the caller's own.
pub func list_get[T](l: List[T]*, i: i64) -> T:
    return elem_copy[T](l, l.items[index(i, l.count)])

## `values[i].field = x`: the element's own slot, neither copied nor retained, so a store
## through it changes the element in the list and takes no reference of its own.
pub func list_slot[T](l: List[T]*, i: i64) -> T*:
    return &l.items[index(i, l.count)]

## `values[i] = x`: the list takes the value and lets the old one go.
pub func list_set[T](l: List[T]*, i: i64, item: T):
    let at = index(i, l.count)
    let old = l.items[at]
    l.items[at] = item
    elem_drop[T](l, old)

pub func list_length[T](l: List[T]*) -> i64:
    return (i64)l.count

pub func list_first[T](l: List[T]*) -> T?:
    if l.count == 0:
        return none
    return elem_copy[T](l, l.items[0])

pub func list_last[T](l: List[T]*) -> T?:
    if l.count == 0:
        return none
    return elem_copy[T](l, l.items[l.count - 1])

## `values[a..<b]`: a new list of copies; bounds checked.
pub func list_slice[T](l: List[T]*, low: i64, high: i64, whole: bool) -> List[T]*:
    let n = (i64)l.count
    let end = n if whole else high
    check_bounds(low, end, n)
    let out = list_new[T](l.header.info, l.ops)
    var i = (usize)low
    while i < (usize)end:
        list_push[T](out, elem_copy[T](l, l.items[i]))
        i += 1
    return out

pub func list_copy[T](l: List[T]*) -> List[T]*:
    return list_slice[T](l, 0, 0, true)

## `a + b`: a new list of both.
pub func list_concat[T](a: List[T]*, b: List[T]*) -> List[T]*:
    let out = list_copy[T](a)
    var i: usize = 0
    while i < b.count:
        list_push[T](out, elem_copy[T](b, b.items[i]))
        i += 1
    return out

func elem_equal[T](l: List[T]*, a: T, b: T) -> bool:
    if let f = l.ops.equal:
        return f(a, b)
    heap.stop("elements without equality")

pub func list_contains[T](l: List[T]*, item: T) -> bool:
    var i: usize = 0
    while i < l.count:
        if elem_equal[T](l, l.items[i], item):
            return true
        i += 1
    return false

pub func list_index_of[T](l: List[T]*, item: T) -> i64?:
    var i: usize = 0
    while i < l.count:
        if elem_equal[T](l, l.items[i], item):
            return (i64)i
        i += 1
    return none

## `==` on lists: the same length and equal elements in order (§4.4).
pub func list_equal[T](a: List[T]*, b: List[T]*) -> bool:
    if a.count != b.count:
        return false
    var i: usize = 0
    while i < a.count:
        if not elem_equal[T](a, a.items[i], b.items[i]):
            return false
        i += 1
    return true

pub func list_reverse[T](l: List[T]*):
    var i: usize = 0
    while i + 1 < l.count - i:
        let tmp = l.items[i]
        l.items[i] = l.items[l.count - 1 - i]
        l.items[l.count - 1 - i] = tmp
        i += 1
    l.version += 1

pub func list_reversed[T](l: List[T]*) -> List[T]*:
    let out = list_copy[T](l)
    list_reverse[T](out)
    return out

## `join(separator)` on a `list[str]`.
pub func list_join(l: List[Text*]*, separator: Text*) -> Text*:
    var total: usize = 0
    var i: usize = 0
    while i < l.count:
        total += l.items[i].data.length
        if i > 0:
            total += separator.data.length
        i += 1
    let t = text_room(total)
    let out = text_bytes(t)
    var at: usize = 0
    i = 0
    while i < l.count:
        if i > 0:
            memory.copy(out[at..], separator.data.bytes, separator.data.length)
            at += separator.data.length
        memory.copy(out[at..], l.items[i].data.bytes, l.items[i].data.length)
        at += l.items[i].data.length
        i += 1
    return t

## A `for` over a list checks, at the start of every step, that nothing changed its shape.
pub func list_check[T](l: List[T]*, version: u64):
    if l.version != version:
        heap.stop("the list changed while it was iterated")

## The runtime's drop and trace of a list, through its descriptor.
pub func list_drop[T](o: heap.Object*):
    let l = (List[T]*)o
    var i: usize = 0
    while i < l.count:
        elem_drop[T](l, l.items[i])
        i += 1
    l.count = 0
    free(l.items)

pub func list_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):
    let l = (List[T]*)o
    if let f = l.ops.trace:
        var i: usize = 0
        while i < l.count:
            f(l.items[i], visit, context)
            i += 1

pub func list_from_args(info: heap.Info*, ops: Ops[Text*], arguments: str[]) -> List[Text*]*:
    let l = list_new[Text*](info, ops)
    for a in arguments:
        list_push[Text*](l, text_of(a))
    return l

