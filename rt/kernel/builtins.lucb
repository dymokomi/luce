#==============================================================================================
#
#   kernel/builtins - Ranges and the built-in functions
#
#   DESCRIPTION:
#       Ranges as values with a step and a direction (§6.6), and what the built-in functions
#       of §2.4 need beyond Base: `abs`, `min`, `max`, `round`, `ord`, `chr`, `input`, and the
#       fields of a formatted string with a specification (§3.3).
#
#==============================================================================================

# mark: Ranges =================================================================================

pub struct Range:
    pub var low: i64
    pub var high: i64
    pub var inclusive: bool

pub func range(low: i64, high: i64, inclusive: bool) -> Range:
    return Range(low = low, high = high, inclusive = inclusive)

pub func in_range(i: i64, r: Range) -> bool:
    return i >= r.low and (i <= r.high if r.inclusive else i < r.high)

pub func range_end(r: Range) -> i64:
    return r.high + 1 if r.inclusive else r.high

pub func show_range(r: Range) -> Text*:
    var buffer: u8[64]
    let text = format(buffer, f"{r.low}{"..=" if r.inclusive else "..<"}{r.high}") catch failure:
        heap.stop("a range that does not format")
    return text_of(text)

# mark: Built-in functions (§2.4) ==============================================================

## `abs(n)` of an `int`; the smallest has no magnitude that fits, and traps.
pub func abs_int(n: i64) -> i64:
    if n == -9223372036854775807 - 1:
        heap.stop("integer overflow")
    return -n if n < 0 else n

## `min(a, b)` (`least`) and `max(a, b)`: the first of two equals, the second only when it
## is strictly beyond, as Python's; a copy of its own.
pub func pick[T](a: T, b: T, ops: Ops[T], least: bool) -> T:
    let compare = ops.compare else heap.stop("values without an ordering")
    let order = compare(b, a)
    let chosen = b if (order < 0 if least else order > 0) else a
    if let copy = ops.copy:
        return copy(chosen)
    return chosen

## `round(x, digits)`, rounded by the numerals module; past the largest float it traps.
pub func rounded(value: f64?) -> f64:
    let out = value else heap.stop("the rounded value is too large for a float")
    return out

## `ord(text)` of a text of one scalar.
pub func ord(t: Text*) -> i64:
    if scalar_length(t) != 1:
        heap.stop("ord of a text that is not one scalar")
    let b = t.data.bytes
    let lead = (i64)b[0]
    if lead < 0x80:
        return lead
    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)
    var i: usize = 1
    while i < b.length:
        value = value * 64 + ((i64)b[i] & 0x3F)
        i += 1
    return value

## A text the numerals module made, as a `str` of the program's own; none traps with
## `message` (`chr` of no scalar, a field's `c` of no scalar).
pub func owned_text(text: str?, message: str) -> Text*:
    let made = text else heap.stop(message)
    let out = text_of(made)
    strings.release(made)
    return out

## `int(text, base)`'s base, 2 to 36, or a trap.
pub func int_base(base: i64) -> i64:
    if base < 2 or base > 36:
        heap.stop("an integer's base is 2 to 36")
    return base

## The integer the numerals module read, or the failure of a text that is not one (§6.5).
pub func parsed_int(value: i64?) -> i64!:
    let out = value else error(luce_failure, "not an integer")
    return out

## `input(prompt)`: the prompt written, then a line of standard input without its line end
## (and a `\r` before it), none at the end of the input. Read a byte at a time, as the
## interpreter reads, so nothing past the line is taken from a stream others may read.
pub func input(prompt: Text*) -> Text*?:
    var out = io.stdout()
    discard(out.write(prompt.data.bytes) catch failure: recover 0)
    var line = strings.Builder.create(64) catch failure:
        heap.stop("out of memory")
    defer line.destroy()
    var source = io.stdin()
    var one: u8[1]
    var read_any = false
    var ended = false
    while not ended:
        let n = source.read(one[..<1]) catch failure: recover 0
        if n == 0:
            break
        read_any = true
        if one[0] == '\n':
            ended = true
        else:
            discard(line.write(one[..<1]) catch failure: heap.stop("out of memory"))
    if not read_any:
        return none
    var text = line.view()
    if ended and text.length > 0 and text.bytes[text.length - 1] == '\r':
        text = (str)text.bytes[..<text.length - 1]
    return text_of(text)

