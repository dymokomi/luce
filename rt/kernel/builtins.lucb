#==============================================================================================
#
#   kernel/builtins - Ranges and the built-in functions
#
#   DESCRIPTION:
#       Ranges as values with a step and a direction (§6.6), and what the built-in functions
#       of §2.4 need beyond Base: `abs`, `min`, `max`, `round`, `ord`, `chr`, `input`, and the
#       fields of a formatted string with a specification (§3.3).
#
#==============================================================================================

# mark: Ranges =================================================================================

## `a..<b` or `a..=b` (§6.6), with a step: its elements are `low`, `low + |step|`, and so on
## while they are below `high`, or not above it when `inclusive`; a negative step walks the
## same elements from the last down. A range written is step 1.
pub struct Range:
    pub var low: i64
    pub var high: i64
    pub var inclusive: bool
    pub var step: i64

pub func range(low: i64, high: i64, inclusive: bool) -> Range:
    return Range(low = low, high = high, inclusive = inclusive, step = 1)

func step_size(r: Range) -> u64:
    return (u64)r.step if r.step > 0 else (u64)0 -% (u64)r.step

## The greatest element, or none when the range has none; differences are taken as `u64`,
## which holds any span between two `int`s.
func range_last(r: Range) -> i64?:
    var top = r.high
    if not r.inclusive:
        if r.high == -9223372036854775807 - 1:
            return none
        top = r.high - 1
    if top < r.low:
        return none
    let span = (u64)top -% (u64)r.low
    return (i64)((u64)r.low +% span // step_size(r) * step_size(r))

## `x in r` and `r.contains(x)`.
pub func in_range(i: i64, r: Range) -> bool:
    let last = range_last(r) else return false
    return i >= r.low and i <= last and ((u64)i -% (u64)r.low) % step_size(r) == 0

## `r.contains(x)`: the range first, as it is written first.
pub func range_contains(r: Range, i: i64) -> bool:
    return in_range(i, r)

## `r.is_empty`: whether it has no element.
pub func range_is_empty(r: Range) -> bool:
    return range_last(r) == none

## `r.length`: how many elements; past the largest `int` traps.
pub func range_length(r: Range) -> i64:
    let last = range_last(r) else return 0
    let steps = ((u64)last -% (u64)r.low) // step_size(r)
    if steps >= 9223372036854775807:
        heap.stop("integer overflow")
    return (i64)steps + 1

## `r.step(n)`: every `n`th element, from the first the range walks; `n` above zero.
pub func range_step(r: Range, n: i64) -> Range:
    if n < 1:
        heap.stop("a range's step is above zero")
    let size = (i64)step_size(r) *? n else heap.stop("integer overflow")
    if r.step > 0:
        return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = size)
    # walking down: the elements from the last, every `n`th, as a range of their own
    let last = range_last(r) else return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = -size)
    let steps = ((u64)last -% (u64)r.low) // (u64)size
    let low = (i64)((u64)last -% steps * (u64)size)
    return Range(low = low, high = last, inclusive = true, step = -size)

## `r.reversed()`: the same elements, the other way.
pub func range_reversed(r: Range) -> Range:
    return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = -r.step)

## The elements of a range value in the order it walks them, for a `for` over one.
pub struct RangeWalk:
    var current: i64
    var left: u64
    var delta: i64
    var done: bool

    pub static func over(r: Range) -> RangeWalk:
        let last = range_last(r) else return RangeWalk(current = 0, left = 0, delta = 0, done = true)
        let steps = ((u64)last -% (u64)r.low) // step_size(r)
        if r.step > 0:
            return RangeWalk(current = r.low, left = steps, delta = r.step, done = false)
        return RangeWalk(current = last, left = steps, delta = r.step, done = false)

    pub mutating func next() -> i64?:
        if self.done:
            return none
        let out = self.current
        if self.left == 0:
            self.done = true
        else:
            self.left -= 1
            self.current = (i64)((u64)self.current +% (u64)self.delta)
        return out

## A range's display: `a..<b`, and a step or a direction as the calls that made them,
## `(0..<10).step(2)`, `(0..<10).reversed()`.
pub func show_range(r: Range) -> Text*:
    let size = (i64)step_size(r)
    var stepped: u8[48]
    var step_text = ""
    if size != 1:
        step_text = format(stepped, f".step({size})") catch failure:
            heap.stop("a range that does not format")
    let open = "(" if r.step != 1 else ""
    let close = ")" if r.step != 1 else ""
    let dots = "..=" if r.inclusive else "..<"
    let turned = ".reversed()" if r.step < 0 else ""
    var buffer: u8[160]
    let text = format(buffer, f"{open}{r.low}{dots}{r.high}{close}{step_text}{turned}") catch failure:
        heap.stop("a range that does not format")
    return text_of(text)

# mark: Built-in functions (§2.4) ==============================================================

## `abs(n)` of an `int`; the smallest has no magnitude that fits, and traps.
pub func abs_int(n: i64) -> i64:
    if n == -9223372036854775807 - 1:
        heap.stop("integer overflow")
    return -n if n < 0 else n

## `min(a, b)` (`least`) and `max(a, b)`: the first of two equals, the second only when it
## is strictly beyond, as Python's; a copy of its own.
pub func pick[T](a: T, b: T, ops: Ops[T], least: bool) -> T:
    let compare = ops.compare else heap.stop("values without an ordering")
    let order = compare(b, a)
    let chosen = b if (order < 0 if least else order > 0) else a
    if let copy = ops.copy:
        return copy(chosen)
    return chosen

## `round(x, digits)`, rounded by the numerals module; past the largest float it traps.
pub func rounded(value: f64?) -> f64:
    let out = value else heap.stop("the rounded value is too large for a float")
    return out

## `ord(text)` of a text of one scalar.
pub func ord(t: Text*) -> i64:
    if scalar_length(t) != 1:
        heap.stop("ord of a text that is not one scalar")
    let b = t.data.bytes
    let lead = (i64)b[0]
    if lead < 0x80:
        return lead
    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)
    var i: usize = 1
    while i < b.length:
        value = value * 64 + ((i64)b[i] & 0x3F)
        i += 1
    return value

## A text the numerals module made, as a `str` of the program's own; none traps with
## `message` (`chr` of no scalar, a field's `c` of no scalar).
pub func owned_text(text: str?, message: str) -> Text*:
    let made = text else heap.stop(message)
    let out = text_of(made)
    strings.release(made)
    return out

## `int(text, base)`'s base, 2 to 36, or a trap.
pub func int_base(base: i64) -> i64:
    if base < 2 or base > 36:
        heap.stop("an integer's base is 2 to 36")
    return base

## The integer the numerals module read, or the failure of a text that is not one (§6.5).
pub func parsed_int(value: i64?) -> i64!:
    let out = value else error(luce_failure, "not an integer")
    return out

## `input(prompt)`: the prompt written, then a line of standard input without its line end
## (and a `\r` before it), none at the end of the input. Read a byte at a time, as the
## interpreter reads, so nothing past the line is taken from a stream others may read.
pub func input(prompt: Text*) -> Text*?:
    var out = io.stdout()
    discard(out.write(prompt.data.bytes) catch failure: recover 0)
    var line = strings.Builder.create(64) catch failure:
        heap.stop("out of memory")
    defer line.destroy()
    var source = io.stdin()
    var one: u8[1]
    var read_any = false
    var ended = false
    while not ended:
        let n = source.read(one[..<1]) catch failure: recover 0
        if n == 0:
            break
        read_any = true
        if one[0] == '\n':
            ended = true
        else:
            discard(line.write(one[..<1]) catch failure: heap.stop("out of memory"))
    if not read_any:
        return none
    var text = line.view()
    if ended and text.length > 0 and text.bytes[text.length - 1] == '\r':
        text = (str)text.bytes[..<text.length - 1]
    return text_of(text)

