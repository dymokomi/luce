#==============================================================================================
#
#   heap - Objects, their counts, the temporaries pool, the cycle collector
#
#   DESCRIPTION:
#       The runtime of §10 as docs/RUNTIME.md states it. A class instance is a block with an
#       `Object` header; the emitted program retains and releases through these functions
#       and never touches a count itself. A release that leaves a count above zero makes the
#       object a candidate for the cycle collector, which is synchronous trial deletion
#       (Bacon and Rajan, 2001) run when the candidate buffer is full and after `main`.
#       Nothing here fails: an allocation that cannot be met traps.
#
#==============================================================================================

import io
import memory

# mark: Objects ================================================================================

let black: u8 = 0
let gray: u8 = 1
let white: u8 = 2
let purple: u8 = 3
let color_mask: u8 = 3
let buffered: u8 = 4
let dead: u8 = 8
let collecting: u8 = 16
## A literal's text: never counted, never released, never alive at the end.
pub let immortal: u8 = 32

pub struct Object:
    pub var strong: u32
    pub var weak: u32
    pub var flags: u8
    pub var info: Info*

## What the collector and the destructor need to know about a class.
pub struct Info:
    pub var name: str
    pub var size: usize
    ## `deinit`, when the class declares one.
    pub var finish: (func(Object*) -> unit)?
    ## Releases the fields in reverse declaration order, tolerating unassigned ones.
    pub var drop: func(Object*) -> unit
    ## Visits every strong reference the object holds, fields in declaration order.
    pub var trace: func(Object*, func(Object*, void*) -> unit, void*) -> unit

## Objects alive: allocated and not yet destroyed.
var live: usize = 0

func color_of(o: Object*) -> u8:
    return o.flags & color_mask

func set_color(o: Object*, c: u8):
    o.flags = (o.flags & ~color_mask) | c

func has(o: Object*, flag: u8) -> bool:
    return (o.flags & flag) != 0

pub func allocate(info: Info*) -> Object*:
    return allocate_sized(info, info.size)

## An object whose size the descriptor does not know: a text, its bytes behind the header.
pub func allocate_sized(info: Info*, size: usize) -> Object*:
    let block = alloc(size, 16) catch failure:
        trap("out of memory")
    memory.set(block, 0)
    let o = (Object*)block.data
    o.strong = 1
    o.weak = 0
    o.flags = black
    o.info = info
    live += 1
    return o

pub func retain(o: Object*) -> Object*:
    if has(o, immortal):
        return o
    o.strong += 1
    set_color(o, black)
    return o

pub func release(o: Object*):
    if has(o, immortal):
        return
    if has(o, collecting):
        # a white object's field, released while the collector drops it: the count is
        # bookkeeping only, the collector frees the object
        if o.strong > 0:
            o.strong -= 1
        return
    o.strong -= 1
    if o.strong == 0:
        destroy(o)
    else:
        possible_root(o)

## `deinit`, then the fields, then the storage unless a weak reference keeps the shell.
func destroy(o: Object*):
    set_color(o, black)
    if let f = o.info.finish:
        o.strong = 1
        f(o)
        if o.strong != 1:
            trap("`deinit` published `self`")
        o.strong = 0
    o.info.drop(o)
    live -= 1
    o.flags |= dead
    if not has(o, buffered):
        release_shell(o)

## The storage goes when nothing, strong or weak or the candidate buffer, refers to it.
func release_shell(o: Object*):
    if o.weak == 0 and has(o, dead) and not has(o, buffered):
        free(u8[]((u8*)o, o.info.size if o.info.size > 0 else sized_of(o)))

## The size of an object whose descriptor gives none: a text, which records its own.
pub var sized_of: func(Object*) -> usize = no_size

func no_size(o: Object*) -> usize:
    return 16

## An object that lives to the end of the run and is not counted: an error's message,
## which the `Error` holding it only views (RUNTIME).
pub func immortalise(o: Object*):
    if not has(o, immortal):
        o.flags |= immortal
        live -= 1

## An `init` that failed: the fields assigned so far go, no `deinit` runs.
pub func abandon(o: Object*):
    o.info.drop(o)
    live -= 1
    o.strong = 0
    o.flags |= dead
    if not has(o, buffered):
        release_shell(o)

# mark: The temporaries pool ===================================================================

struct Pending:
    var object: Object*?
    var cell: void*?
    var drop: (func(void*) -> unit)?
    var size: usize

var pending: Pending[]
var pending_count: usize = 0

pub func mark() -> usize:
    return pending_count

func push_pending(p: Pending):
    if pending_count == pending.length:
        let grown = alloc Pending[pending.length * 2 if pending.length > 0 else 64] catch failure:
            trap("out of memory")
        var i: usize = 0
        while i < pending_count:
            grown[i] = pending[i]
            i += 1
        if pending.length > 0:
            free(pending)
        pending = grown
    pending[pending_count] = p
    pending_count += 1

## An owned object handed on as a temporary: released by the next `drain`.
pub func pool_object(o: Object*) -> Object*:
    push_pending(Pending(object = o, cell = none, drop = none, size = 0))
    return o

## An owned value of any type handed on as a temporary; `drop` releases what it holds.
pub func pool_value[T](v: T, drop: func(void*) -> unit) -> T:
    let block = alloc u8[sizeof(T)] catch failure:
        trap("out of memory")
    memory.write[T](block.data, v)
    push_pending(Pending(object = none, cell = block.data, drop = drop, size = sizeof(T)))
    return v

## Releases every temporary pooled since `mark`, in the order they were pooled.
pub func drain(since: usize):
    if pending_count <= since:
        return
    let count = pending_count
    var i = since
    while i < count:
        let p = pending[i]
        if let o = p.object:
            release(o)
        elif let cell = p.cell:
            if let d = p.drop:
                d(cell)
            free(u8[]((u8*)cell, p.size))
        i += 1
    # a release pools nothing of its own, so nothing was added above `count`
    pending_count = since

# mark: The cycle collector ====================================================================

pub let candidate_limit: usize = 1024

var roots: Object*[]
var root_count: usize = 0
var whites: Object*[]
var white_count: usize = 0
var collector_running: bool = false

func push_root(o: Object*):
    if root_count == roots.length:
        let grown = alloc Object*[roots.length * 2 if roots.length > 0 else candidate_limit] catch failure:
            trap("out of memory")
        var i: usize = 0
        while i < root_count:
            grown[i] = roots[i]
            i += 1
        if roots.length > 0:
            free(roots)
        roots = grown
    roots[root_count] = o
    root_count += 1

func push_white(o: Object*):
    if white_count == whites.length:
        let grown = alloc Object*[whites.length * 2 if whites.length > 0 else 256] catch failure:
            trap("out of memory")
        var i: usize = 0
        while i < white_count:
            grown[i] = whites[i]
            i += 1
        if whites.length > 0:
            free(whites)
        whites = grown
    whites[white_count] = o
    white_count += 1

func possible_root(o: Object*):
    if color_of(o) != purple:
        set_color(o, purple)
        if not has(o, buffered):
            o.flags |= buffered
            push_root(o)
            if root_count >= candidate_limit and not collector_running:
                collect()

func visit_mark_gray(child: Object*, context: void*):
    child.strong -= 1
    mark_gray(child)

func mark_gray(o: Object*):
    if color_of(o) != gray:
        set_color(o, gray)
        o.info.trace(o, visit_mark_gray, (void*)o)

func visit_scan(child: Object*, context: void*):
    scan(child)

func visit_scan_black(child: Object*, context: void*):
    child.strong += 1
    if color_of(child) != black:
        scan_black(child)

func scan(o: Object*):
    if color_of(o) == gray:
        if o.strong > 0:
            scan_black(o)
        else:
            set_color(o, white)
            o.info.trace(o, visit_scan, (void*)o)

func scan_black(o: Object*):
    set_color(o, black)
    o.info.trace(o, visit_scan_black, (void*)o)

func visit_gather(child: Object*, context: void*):
    gather(child)

## The white objects in discovery order, each once, flagged as being collected.
func gather(o: Object*):
    if color_of(o) == white and not has(o, collecting):
        o.flags |= collecting
        push_white(o)
        o.info.trace(o, visit_gather, (void*)o)

func visit_restore(child: Object*, context: void*):
    if has(child, collecting):
        child.strong += 1

## Free the garbage: deinits first, then every object's fields, then the storage.
pub func collect():
    if collector_running:
        return
    collector_running = true
    # candidates still purple and alive stay; the rest leave the buffer
    var kept: usize = 0
    var i: usize = 0
    while i < root_count:
        let o = roots[i]
        if color_of(o) == purple and o.strong > 0 and not has(o, dead):
            roots[kept] = o
            kept += 1
        else:
            o.flags &= ~buffered
            release_shell(o)
        i += 1
    root_count = kept
    i = 0
    while i < root_count:
        mark_gray(roots[i])
        i += 1
    i = 0
    while i < root_count:
        scan(roots[i])
        i += 1
    white_count = 0
    i = 0
    while i < root_count:
        gather(roots[i])
        i += 1
    i = 0
    while i < root_count:
        roots[i].flags &= ~buffered
        i += 1
    root_count = 0
    # the counts among the garbage are restored so that every field release below is an
    # ordinary one; a release of a white object then only lowers its count
    i = 0
    while i < white_count:
        whites[i].info.trace(whites[i], visit_restore, (void*)whites[i])
        i += 1
    i = 0
    while i < white_count:
        let o = whites[i]
        if let f = o.info.finish:
            let before = o.strong
            o.strong += 1
            f(o)
            if o.strong != before + 1:
                trap("`deinit` published `self`")
            o.strong = before
        i += 1
    i = 0
    while i < white_count:
        whites[i].info.drop(whites[i])
        i += 1
    i = 0
    while i < white_count:
        let o = whites[i]
        live -= 1
        o.strong = 0
        o.flags = dead
        release_shell(o)
        i += 1
    white_count = 0
    collector_running = false

# mark: Weak references ========================================================================

pub struct Weak:
    pub var target: Object*?

pub func weak_make(o: Object*) -> Weak:
    o.weak += 1
    return Weak(target = o)

pub func weak_copy(w: Weak) -> Weak:
    if let o = w.target:
        o.weak += 1
    return w

pub func weak_drop(w: Weak):
    if let o = w.target:
        o.weak -= 1
        release_shell(o)

## The object with a fresh strong reference, or none once it is dead.
pub func weak_get(w: Weak) -> Object*?:
    if let o = w.target:
        if not has(o, dead):
            return retain(o)
    return none

# mark: The end of a run =======================================================================

## After `main`: the collector runs, and anything still alive is a defect. The exit status.
pub func finish_run(status: i32) -> i32:
    drain(0)
    collect()
    if live != 0:
        var room: u8[96]
        let text = format(room, f"luce: {live} objects alive at exit\n") catch failure:
            recover "luce: objects alive at exit\n"
        var e = io.stderr()
        discard(e.write(text.bytes) catch failure: recover 0)
        return 3
    return status

# mark: Evidence ===============================================================================

## A hand-built class, shaped as the emitter shapes one: the header first, then the fields.
struct Node:
    var header: Object
    var value: i64
    var next: Node*?

var log: u8[64]
var logged: usize = 0

func note(byte: u8):
    if logged < log.length:
        log[logged] = byte
        logged += 1

func node_finish(o: Object*):
    let n = (Node*)o
    note(u8(48 + n.value))

func node_drop(o: Object*):
    let n = (Node*)o
    if let next = n.next:
        n.next = none
        release((Object*)next)

func node_trace(o: Object*, visit: func(Object*, void*) -> unit, context: void*):
    let n = (Node*)o
    if let next = n.next:
        visit((Object*)next, context)

var node_info: Info = Info(name = "Node", size = sizeof(Node), finish = node_finish, drop = node_drop, trace = node_trace)

func node(value: i64) -> Node*:
    let n = (Node*)allocate(&node_info)
    n.value = value
    return n

## Each test runs in a fresh arena, so what an earlier test left in the buffers is gone
## with it: the runtime starts over, without freeing.
func fresh():
    roots = roots[..<0]
    root_count = 0
    whites = whites[..<0]
    white_count = 0
    pending = pending[..<0]
    pending_count = 0
    live = 0
    logged = 0

test "a release at zero destroys: deinit, then the fields":
    fresh()
    let a = node(1)
    a.next = node(2)
    release((Object*)a)
    assert((str)log[..<logged] == "12")
    assert(live == 0)

test "a cycle is collected with its deinits in discovery order":
    fresh()
    let a = node(3)
    let b = node(4)
    a.next = (Node*)retain((Object*)b)
    b.next = (Node*)retain((Object*)a)
    release((Object*)b)
    release((Object*)a)
    assert(live == 2)
    collect()
    assert(live == 0)
    # `b` became a candidate first, so the walk finds it first
    assert((str)log[..<logged] == "43")

test "a weak reference outlives its object and answers none":
    fresh()
    let a = node(5)
    let w = weak_make((Object*)a)
    assert(weak_get(w) != none)
    release((Object*)a)   # the get above retained
    assert(live == 1)
    release((Object*)a)
    assert(live == 0)
    assert(weak_get(w) == none)
    weak_drop(w)
    assert((str)log[..<logged] == "5")

test "temporaries drain in the order they were pooled":
    fresh()
    let m = mark()
    discard(pool_object((Object*)node(6)))
    discard(pool_object((Object*)node(7)))
    assert(logged == 0)
    drain(m)
    assert((str)log[..<logged] == "67")
    assert(live == 0)

test "the run's end reports what is alive":
    fresh()
    let a = node(8)
    assert(finish_run(0) == 3)
    release((Object*)a)
    assert(finish_run(0) == 0)
