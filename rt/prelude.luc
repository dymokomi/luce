# These declarations are available in every module. Result is an ordinary enum;
# its payload and error follow the same ownership rules as user-defined values.
interface Equatable:
    func equals(self, other: Self) -> bool

interface Hashable:
    func hashed(self) -> int

interface Ordered:
    func compare(self, other: Self) -> int

interface Display:
    func display(self) -> str

interface Iterator[T]:
    func next(self) -> T?

interface Iterable[T]:
    func iterator(self) -> Iterator[T]

pub enum Result[T]:
    success(value: T)
    failure(reason: Error)

    ## Invoke the operation once and retain either its value or its owned error.
    ## A closure is explicit here: creating it does not execute its body.
    pub func capture(operation: func() -> T!) -> Result[T]:
        let value: T = operation() catch failure:
            return Result[T].failure(failure)
        return Result[T].success(value)

    ## Read the success value, or propagate the retained failure to this caller.
    pub func get(self) -> T!:
        match self:
            .success(value): return value
            .failure(failure): error(failure.code, failure.message)
