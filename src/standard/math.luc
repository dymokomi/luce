## Deterministic numeric constants and algorithms that do not belong to the
## language's literal grammar.

# mark: IEEE special values ====================================================================

# IEEE binary64 quiet NaN.
pub let nan_f64: f64 = 0.0 / 0.0
# IEEE binary64 positive infinity.
pub let positive_infinity_f64: f64 = 1.0 / 0.0
# IEEE binary64 negative infinity.
pub let negative_infinity_f64: f64 = -1.0 / 0.0

# IEEE binary32 quiet NaN.
pub let nan_f32: f32 = f32(nan_f64)
# IEEE binary32 positive infinity.
pub let positive_infinity_f32: f32 = f32(positive_infinity_f64)
# IEEE binary32 negative infinity.
pub let negative_infinity_f32: f32 = f32(negative_infinity_f64)

# IEEE binary16 quiet NaN.
pub let nan_f16: f16 = f16(nan_f64)
# IEEE binary16 positive infinity.
pub let positive_infinity_f16: f16 = f16(positive_infinity_f64)
# IEEE binary16 negative infinity.
pub let negative_infinity_f16: f16 = f16(negative_infinity_f64)
