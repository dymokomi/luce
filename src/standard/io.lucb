#==============================================================================================
#
#   io - The process's output streams as Writers, and the display functions
#        formatted output is written over
#
#   DESCRIPTION:
#       `stdout()` and `stderr()` answer the two streams the startup shim
#       owns, as `Writer` views (base.md §14.4, §16.6). The `write_*`
#       functions are the compiler-supplied `display` of §14.4 for the
#       scalar types: `print(f"...")` calls them for each field and text
#       piece, so a formatted string never becomes a value. Everything here
#       is Base code over the caller's sink; the only intrinsics are the two
#       raw writes a standard module may name.
#
#==============================================================================================

# mark: Location =============================================================================

## Where a call was written (base.md §9.1): `location()` answers one, and a
## parameter default `= location()` receives the caller's.
pub struct Location:
    pub let file: str
    pub let line: u32
    pub let function: str

# mark: Writers ===============================================================================

## The standard sink (base.md §14.1): `write` answers the count written.
pub interface Writer:
    mutating func write(self, data: const u8[]) -> usize!

## Standard output. The shim's write cannot be observed failing here, so the
## count is the whole span. Each stream is its own type, so neither global
## needs an initialiser or a descriptor field.
struct Output implements Writer:
    var reserved: u8

    pub mutating func write(self, data: const u8[]) -> usize!:
        Builtin.write_output(data)
        return data.length

## Standard error.
struct ErrorOutput implements Writer:
    var reserved: u8

    pub mutating func write(self, data: const u8[]) -> usize!:
        Builtin.write_error(data)
        return data.length

var standard_output: Output
var standard_error: ErrorOutput

## Standard output as a `Writer`.
pub func stdout() -> Writer:
    return &standard_output

## Standard error as a `Writer`.
pub func stderr() -> Writer:
    return &standard_error

## A `format` into a full buffer fails with this code.
pub let full: ErrorCode = ErrorCode.package(65010)

## `format(buffer, f"...")` writes through one of these over the caller's
## `u8[]`: bytes land from the start, a write past the end fails with
## `full`, and `finish` appends a NUL when there is room and answers the
## text written so far as a view (base.md §5.5).
pub struct BufferWriter implements Writer:
    var target: u8[]
    var used: usize

    pub mutating func write(self, data: const u8[]) -> usize!:
        if self.used + data.length > self.target.length: error(full, "format: the buffer is full")
        var index: usize = 0
        while index < data.length:
            self.target[self.used + index] = data[index]
            index += 1
        self.used += data.length
        return data.length

pub func buffer_writer(target: u8[]) -> BufferWriter:
    return BufferWriter(target = target, used = 0)

pub func finish(writer: BufferWriter*) -> str:
    if writer.used < writer.target.length: writer.target[writer.used] = 0
    return (str)writer.target[0..<writer.used]

# mark: Text =================================================================================

## `str(bytes)` and `str(text)` fail with this code when the bytes are not
## UTF-8 (base.md §5.5).
pub let invalid_text: ErrorCode = ErrorCode.package(65011)

## `str(bytes)`: the bytes as text once they prove to be UTF-8 (base.md §5.5).
pub func text_from_bytes(data: const u8[]) -> str!:
    if not is_utf8(data): error(invalid_text, "str: the bytes are not valid UTF-8")
    return (str)data

## `str(text)` from a `cstr`: the bytes up to the NUL, once they prove to be
## UTF-8 (base.md §5.5).
pub func text_from_c(text: cstr) -> str!:
    var count: usize = 0
    while text[count] != 0: count += 1
    let data: const u8[] = u8[]((u8*)text, count)
    return try text_from_bytes(data)

## Well-formed UTF-8: no overlong forms, no surrogates, nothing past U+10FFFF.
func is_utf8(data: const u8[]) -> bool:
    var index: usize = 0
    while index < data.length:
        let first = data[index]
        var width: usize = 1
        var minimum: u32 = 0
        var scalar: u32 = first
        if first >= 128:
            if first >= 194 and first <= 223:
                width = 2
                minimum = 128
                scalar = first & 31
            elif first >= 224 and first <= 239:
                width = 3
                minimum = 2048
                scalar = first & 15
            elif first >= 240 and first <= 244:
                width = 4
                minimum = 65536
                scalar = first & 7
            else:
                return false
            if index + width > data.length: return false
            var position: usize = 1
            while position < width:
                let following = data[index + position]
                if following < 128 or following > 191: return false
                scalar = (scalar << 6) | (following & 63)
                position += 1
            if scalar < minimum or scalar > 1114111: return false
            if scalar >= 55296 and scalar <= 57343: return false
        index += width
    return true

# mark: Formatted pieces =====================================================================

## What a `fmt` parameter carries (base.md §9.1): the caller's formatted
## string as a span of pieces on the caller's stack, each a text view or one
## field value with its kind. Nothing is allocated; the span is a pointer to
## the caller's values beside their kinds, and `write_pieces` is the
## formatting function every sink uses.
pub struct Piece:
    pub let kind: u8
    pub let bits: u64
    pub let text: str

pub let piece_text: u8 = 1
pub let piece_signed: u8 = 2
pub let piece_unsigned: u8 = 3
pub let piece_bool: u8 = 4
pub let piece_char: u8 = 5
pub let piece_pointer: u8 = 6
pub let piece_float64: u8 = 7
pub let piece_float32: u8 = 8

## Write every piece to `sink` in order; the first failure is the result.
pub func write_pieces(sink: Writer, pieces: const Piece[]) -> unit!:
    var index: usize = 0
    while index < pieces.length:
        let piece = pieces[index]
        if piece.kind == piece_text: try write_text(sink, piece.text)
        elif piece.kind == piece_signed: try write_signed(sink, (i64)piece.bits)
        elif piece.kind == piece_unsigned: try write_unsigned(sink, piece.bits)
        elif piece.kind == piece_bool: try write_bool(sink, piece.bits != 0)
        elif piece.kind == piece_char: try write_scalar(sink, u32(piece.bits))
        elif piece.kind == piece_pointer: try write_hex(sink, piece.bits)
        elif piece.kind == piece_float64: try write_float_bits(sink, piece.bits, false)
        elif piece.kind == piece_float32: try write_float_bits(sink, piece.bits, true)
        index += 1

# mark: Display ===============================================================================

## `str` displays as its bytes.
pub func write_text(sink: Writer, text: str) -> unit!:
    discard(try sink.write(text.bytes))

## `bool` displays as `true` or `false`.
pub func write_bool(sink: Writer, value: bool) -> unit!:
    if value:
        try write_text(sink, "true")
    else:
        try write_text(sink, "false")

## Signed decimal with a leading `-`; the magnitude is taken in `u64`, which
## holds the minimum's as well.
pub func write_signed(sink: Writer, value: i64) -> unit!:
    if value < 0:
        try write_text(sink, "-")
        try write_unsigned(sink, -%(u64)value)
        return
    try write_unsigned(sink, (u64)value)

## Unsigned decimal, built from the last digit back in a stack buffer.
pub func write_unsigned(sink: Writer, value: u64) -> unit!:
    var digits: u8[20]
    var remaining = value
    var start: usize = 20
    while true:
        start -= 1
        digits[start] = (u8)(remaining % 10 + 48)
        remaining //= 10
        if remaining == 0: break
    let all: const u8[] = digits
    discard(try sink.write(all[start..<20]))

## A `char` displays as its UTF-8 bytes.
pub func write_char(sink: Writer, value: char) -> unit!:
    try write_scalar(sink, u32(value))

## A Unicode scalar value as its UTF-8 bytes.
pub func write_scalar(sink: Writer, code: u32) -> unit!:
    var encoded: u8[4]
    var count: usize = 1
    if code < 128:
        encoded[0] = (u8)code
    elif code < 2048:
        encoded[0] = (u8)(192 | (code >> 6))
        encoded[1] = (u8)(128 | (code & 63))
        count = 2
    elif code < 65536:
        encoded[0] = (u8)(224 | (code >> 12))
        encoded[1] = (u8)(128 | ((code >> 6) & 63))
        encoded[2] = (u8)(128 | (code & 63))
        count = 3
    else:
        encoded[0] = (u8)(240 | (code >> 18))
        encoded[1] = (u8)(128 | ((code >> 12) & 63))
        encoded[2] = (u8)(128 | ((code >> 6) & 63))
        encoded[3] = (u8)(128 | (code & 63))
        count = 4
    let all: const u8[] = encoded
    discard(try sink.write(all[0..<count]))

## A pointer displays as `0x` and its address in lowercase hexadecimal.
pub func write_pointer(sink: Writer, value: const void*) -> unit!:
    try write_hex(sink, (u64)(usize)value)

## `0x` and a value in lowercase hexadecimal.
pub func write_hex(sink: Writer, value: u64) -> unit!:
    var digits: u8[16]
    var remaining = value
    var start: usize = 16
    while true:
        start -= 1
        let nibble = (u8)(remaining & 15)
        if nibble < 10:
            digits[start] = nibble + 48
        else:
            digits[start] = nibble + 87
        remaining >>= 4
        if remaining == 0: break
    try write_text(sink, "0x")
    let all: const u8[] = digits
    discard(try sink.write(all[start..<16]))
# mark: Float display =========================================================================

## The shortest decimal that reads back as the same float (base.md §14.4):
## Ryū over portable 64-bit words, the same algorithm the full-Luce runtime
## uses. A whole value keeps its `.0`, magnitudes outside a fixed window
## take the `e` form, and `inf`/`nan` are spelled so.
struct FloatingDecimal:
    let mantissa: u64
    let exponent: i64

struct DecimalBounds:
    let value: u64
    let upper: u64
    let lower: u64

struct WideProduct:
    let low: u64
    let high: u64

struct AddedWord:
    let value: u64
    let carry: u64

## The text of one float, built on the stack before one write to the sink.
struct FloatText:
    var digits: u8[40]
    var used: usize

    pub mutating func push(self, byte: u8):
        self.digits[self.used] = byte
        self.used += 1

## `f64` displays as its shortest round-tripping decimal.
pub func write_float64(sink: Writer, value: f64) -> unit!:
    try write_float_bits(sink, value.bits(), false)

## `f32` displays as its shortest round-tripping decimal.
pub func write_float32(sink: Writer, value: f32) -> unit!:
    try write_float_bits(sink, u64(value.bits()), true)

## A float given as its IEEE bit pattern, binary64 or binary32.
pub func write_float_bits(sink: Writer, bits: u64, is_binary32: bool) -> unit!:
    var text: FloatText
    render_float_bits(&text, bits, is_binary32)
    let all: const u8[] = text.digits
    discard(try sink.write(all[0..<text.used]))

func render_float_bits(text: FloatText*, bits: u64, is_binary32: bool):
    var sign_shift = 63u64
    var mantissa_bits = 52u64
    var exponent_bits = 11u64
    var maximum_fixed_position = 16i64
    var minimum_fixed_position = -5i64
    if is_binary32:
        sign_shift = 31u64
        mantissa_bits = 23u64
        exponent_bits = 8u64
        maximum_fixed_position = 13i64
        minimum_fixed_position = -6i64
    let negative = ((bits >> sign_shift) & 1u64) != 0u64
    let mantissa_mask = (1u64 << mantissa_bits) - 1u64
    let exponent_mask = (1u64 << exponent_bits) - 1u64
    let ieee_mantissa = bits & mantissa_mask
    let ieee_exponent = (bits >> mantissa_bits) & exponent_mask
    if ieee_exponent == exponent_mask:
        if ieee_mantissa != 0u64:
            push_ascii(text, 110u8, 97u8, 110u8)
        else:
            if negative: text.push(45u8)
            push_ascii(text, 105u8, 110u8, 102u8)
        return
    if ieee_exponent == 0u64 and ieee_mantissa == 0u64:
        if negative: text.push(45u8)
        text.push(48u8)
        text.push(46u8)
        text.push(48u8)
        return
    var decimal = ryu64(ieee_mantissa, ieee_exponent)
    if is_binary32: decimal = ryu32(ieee_mantissa, ieee_exponent)
    push_decimal_float(text, decimal, negative, maximum_fixed_position, minimum_fixed_position)

func push_ascii(text: FloatText*, first: u8, second: u8, third: u8):
    text.push(first)
    text.push(second)
    text.push(third)

# mark: Ryū binary32 ==========================================================================

func ryu32(ieee_mantissa: u64, ieee_exponent: u64) -> FloatingDecimal:
    var e2 = 0i64
    var m2 = 0u64
    if ieee_exponent == 0u64:
        e2 = 1i64 - 127i64 - 23i64 - 2i64
        m2 = ieee_mantissa
    else:
        e2 = i64(ieee_exponent) - 127i64 - 23i64 - 2i64
        m2 = (1u64 << 23u64) | ieee_mantissa
    let accept_bounds = (m2 & 1u64) == 0u64
    let mv = 4u64 * m2
    let mp = mv + 2u64
    var mm_shift = 0u64
    if ieee_mantissa != 0u64 or ieee_exponent <= 1u64: mm_shift = 1u64
    let mm = mv - 1u64 - mm_shift

    var vr = 0u64
    var vp = 0u64
    var vm = 0u64
    var e10 = 0i64
    var vm_trailing = false
    var vr_trailing = false
    var last_removed = 0u64
    if e2 >= 0i64:
        let q = log10_pow2(e2)
        e10 = q
        let k = 61i64 + pow5_bits(q) - 1i64
        let shift = -e2 + q + k
        let factor = compute_inverse_power5(u64(q)).high + 1u64
        vr = multiply_shift32(mv, factor, shift)
        vp = multiply_shift32(mp, factor, shift)
        vm = multiply_shift32(mm, factor, shift)
        if q != 0i64 and (vp - 1u64) // 10u64 <= vm // 10u64:
            let previous = q - 1i64
            let previous_shift = -e2 + previous + 61i64 + pow5_bits(previous) - 1i64
            let previous_factor = compute_inverse_power5(u64(previous)).high + 1u64
            last_removed = multiply_shift32(mv, previous_factor, previous_shift) % 10u64
        if q <= 9i64:
            if mv % 5u64 == 0u64: vr_trailing = multiple_of_power5(mv, u64(q))
            elif accept_bounds: vm_trailing = multiple_of_power5(mm, u64(q))
            elif multiple_of_power5(mp, u64(q)): vp -= 1u64
    else:
        let q = log10_pow5(-e2)
        e10 = q + e2
        let i = -e2 - q
        var shift = q - (pow5_bits(i) - 61i64)
        let factor = compute_power5(u64(i)).high
        vr = multiply_shift32(mv, factor, shift)
        vp = multiply_shift32(mp, factor, shift)
        vm = multiply_shift32(mm, factor, shift)
        if q != 0i64 and (vp - 1u64) // 10u64 <= vm // 10u64:
            shift = q - 1i64 - (pow5_bits(i + 1i64) - 61i64)
            let next_factor = compute_power5(u64(i + 1i64)).high
            last_removed = multiply_shift32(mv, next_factor, shift) % 10u64
        if q <= 1i64:
            vr_trailing = true
            if accept_bounds: vm_trailing = mm_shift == 1u64
            else: vp -= 1u64
        elif q < 31i64:
            vr_trailing = multiple_of_power2(mv, u64(q - 1i64))

    var removed = 0i64
    if vm_trailing or vr_trailing:
        while vp // 10u64 > vm // 10u64:
            vm_trailing = vm_trailing and vm % 10u64 == 0u64
            vr_trailing = vr_trailing and last_removed == 0u64
            last_removed = vr % 10u64
            vr //= 10u64
            vp //= 10u64
            vm //= 10u64
            removed += 1i64
        if vm_trailing:
            while vm % 10u64 == 0u64:
                vr_trailing = vr_trailing and last_removed == 0u64
                last_removed = vr % 10u64
                vr //= 10u64
                vp //= 10u64
                vm //= 10u64
                removed += 1i64
        if vr_trailing and last_removed == 5u64 and vr % 2u64 == 0u64: last_removed = 4u64
        if (vr == vm and (not accept_bounds or not vm_trailing)) or last_removed >= 5u64: vr += 1u64
    else:
        while vp // 10u64 > vm // 10u64:
            last_removed = vr % 10u64
            vr //= 10u64
            vp //= 10u64
            vm //= 10u64
            removed += 1i64
        if vr == vm or last_removed >= 5u64: vr += 1u64
    return FloatingDecimal(mantissa = vr, exponent = e10 + removed)

func multiply_shift32(value: u64, factor: u64, shift: i64) -> u64:
    let factor_low = factor & u64(0xFFFFFFFF)
    let factor_high = factor >> 32u64
    let low_product = value * factor_low
    let high_product = value * factor_high
    return ((low_product >> 32u64) + high_product) >> u64(shift - 32i64)

# mark: Ryū binary64 ==========================================================================

func ryu64(ieee_mantissa: u64, ieee_exponent: u64) -> FloatingDecimal:
    var e2 = 0i64
    var m2 = 0u64
    if ieee_exponent == 0u64:
        e2 = 1i64 - 1023i64 - 52i64 - 2i64
        m2 = ieee_mantissa
    else:
        e2 = i64(ieee_exponent) - 1023i64 - 52i64 - 2i64
        m2 = (1u64 << 52u64) | ieee_mantissa
    let accept_bounds = (m2 & 1u64) == 0u64
    let mv = 4u64 * m2
    var mm_shift = 0u64
    if ieee_mantissa != 0u64 or ieee_exponent <= 1u64: mm_shift = 1u64

    var bounds = DecimalBounds(value = 0u64, upper = 0u64, lower = 0u64)
    var e10 = 0i64
    var vm_trailing = false
    var vr_trailing = false
    if e2 >= 0i64:
        var q = log10_pow2(e2)
        if e2 > 3i64: q -= 1i64
        e10 = q
        let shift = -e2 + q + 125i64 + pow5_bits(q) - 1i64
        bounds = multiply_shift_all64(m2, compute_inverse_power5(u64(q)), shift, mm_shift)
        if q <= 21i64:
            if mv % 5u64 == 0u64: vr_trailing = multiple_of_power5(mv, u64(q))
            elif accept_bounds: vm_trailing = multiple_of_power5(mv - 1u64 - mm_shift, u64(q))
            elif multiple_of_power5(mv + 2u64, u64(q)):
                bounds = DecimalBounds(value = bounds.value, upper = bounds.upper - 1u64, lower = bounds.lower)
    else:
        var q = log10_pow5(-e2)
        if -e2 > 1i64: q -= 1i64
        e10 = q + e2
        let i = -e2 - q
        let shift = q - (pow5_bits(i) - 125i64)
        bounds = multiply_shift_all64(m2, compute_power5(u64(i)), shift, mm_shift)
        if q <= 1i64:
            vr_trailing = true
            if accept_bounds: vm_trailing = mm_shift == 1u64
            else: bounds = DecimalBounds(value = bounds.value, upper = bounds.upper - 1u64, lower = bounds.lower)
        elif q < 63i64:
            vr_trailing = multiple_of_power2(mv, u64(q))

    var vr = bounds.value
    var vp = bounds.upper
    var vm = bounds.lower
    var removed = 0i64
    var last_removed = 0u64
    if vm_trailing or vr_trailing:
        while vp // 10u64 > vm // 10u64:
            vm_trailing = vm_trailing and vm % 10u64 == 0u64
            vr_trailing = vr_trailing and last_removed == 0u64
            last_removed = vr % 10u64
            vr //= 10u64
            vp //= 10u64
            vm //= 10u64
            removed += 1i64
        if vm_trailing:
            while vm % 10u64 == 0u64:
                vr_trailing = vr_trailing and last_removed == 0u64
                last_removed = vr % 10u64
                vr //= 10u64
                vp //= 10u64
                vm //= 10u64
                removed += 1i64
        if vr_trailing and last_removed == 5u64 and vr % 2u64 == 0u64: last_removed = 4u64
        if (vr == vm and (not accept_bounds or not vm_trailing)) or last_removed >= 5u64: vr += 1u64
    else:
        var round_up = false
        if vp // 100u64 > vm // 100u64:
            round_up = vr % 100u64 >= 50u64
            vr //= 100u64
            vp //= 100u64
            vm //= 100u64
            removed += 2i64
        while vp // 10u64 > vm // 10u64:
            round_up = vr % 10u64 >= 5u64
            vr //= 10u64
            vp //= 10u64
            vm //= 10u64
            removed += 1i64
        if vr == vm or round_up: vr += 1u64
    return FloatingDecimal(mantissa = vr, exponent = e10 + removed)

func multiply_shift_all64(value: u64, factor: WideProduct, shift: i64, mm_shift: u64) -> DecimalBounds:
    return DecimalBounds(
        value = multiply_shift64(4u64 * value, factor, shift),
        upper = multiply_shift64(4u64 * value + 2u64, factor, shift),
        lower = multiply_shift64(4u64 * value - 1u64 - mm_shift, factor, shift),
    )

func multiply_shift64(value: u64, factor: WideProduct, shift: i64) -> u64:
    let low_product = multiply_words(value, factor.low)
    let high_product = multiply_words(value, factor.high)
    let middle = add_words(low_product.high, high_product.low)
    return shift_right_words(middle.value, high_product.high + middle.carry, u64(shift - 64i64))

# mark: Portable wide arithmetic ==============================================================

func multiply_words(left: u64, right: u64) -> WideProduct:
    let left_low = left & u64(0xFFFFFFFF)
    let left_high = left >> 32u64
    let right_low = right & u64(0xFFFFFFFF)
    let right_high = right >> 32u64
    let p00 = left_low * right_low
    let p01 = left_low * right_high
    let p10 = left_high * right_low
    let p11 = left_high * right_high
    let middle1 = p10 + (p00 >> 32u64)
    let middle2 = p01 + (middle1 & u64(0xFFFFFFFF))
    return WideProduct(
        low = ((middle2 & u64(0xFFFFFFFF)) << 32u64) | (p00 & u64(0xFFFFFFFF)),
        high = p11 + (middle1 >> 32u64) + (middle2 >> 32u64),
    )

func add_words(left: u64, right: u64) -> AddedWord:
    let room = 18446744073709551615u64 - left
    if right > room:
        return AddedWord(value = right - room - 1u64, carry = 1u64)
    return AddedWord(value = left + right, carry = 0u64)

func shift_right_words(low: u64, high: u64, distance: u64) -> u64:
    return (high << (64u64 - distance)) | (low >> distance)

# mark: Compact powers of five ================================================================

func compute_power5(index: u64) -> WideProduct:
    let base = index // 26u64
    let base_index = base * 26u64
    let offset = index - base_index
    let factor = power5_split(base)
    if offset == 0u64: return factor
    let multiplier = small_power5(offset)
    let low_product = multiply_words(multiplier, factor.low)
    let high_product = multiply_words(multiplier, factor.high)
    let middle = add_words(low_product.high, high_product.low)
    let high = high_product.high + middle.carry
    let distance = u64(pow5_bits(i64(index)) - pow5_bits(i64(base_index)))
    let adjustment = packed_offset(power5_offsets(index // 16u64), index)
    let low = add_words(shift_right_words(low_product.low, middle.value, distance), adjustment)
    return WideProduct(
        low = low.value,
        high = shift_right_words(middle.value, high, distance) + low.carry,
    )

func compute_inverse_power5(index: u64) -> WideProduct:
    let base = (index + 25u64) // 26u64
    let base_index = base * 26u64
    let offset = base_index - index
    let factor = inverse_power5_split(base)
    if offset == 0u64: return factor
    let multiplier = small_power5(offset)
    let low_product = multiply_words(multiplier, factor.low - 1u64)
    let high_product = multiply_words(multiplier, factor.high)
    let middle = add_words(low_product.high, high_product.low)
    let high = high_product.high + middle.carry
    let distance = u64(pow5_bits(i64(base_index)) - pow5_bits(i64(index)))
    let adjustment = 1u64 + packed_offset(inverse_power5_offsets(index // 16u64), index)
    let low = add_words(shift_right_words(low_product.low, middle.value, distance), adjustment)
    return WideProduct(
        low = low.value,
        high = shift_right_words(middle.value, high, distance) + low.carry,
    )

func packed_offset(word: u64, index: u64) -> u64:
    return (word >> ((index % 16u64) * 2u64)) & 3u64

func small_power5(exponent: u64) -> u64:
    var result = 1u64
    var current = 0u64
    while current < exponent:
        result *= 5u64
        current += 1u64
    return result

func inverse_power5_split(index: u64) -> WideProduct:
    match index:
        0: return WideProduct(low = 1u64, high = 2305843009213693952u64)
        1: return WideProduct(low = 5955668970331000884u64, high = 1784059615882449851u64)
        2: return WideProduct(low = 8982663654677661702u64, high = 1380349269358112757u64)
        3: return WideProduct(low = 7286864317269821294u64, high = 2135987035920910082u64)
