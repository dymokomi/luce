func log10_pow2(exponent: i64) -> i64:
    return (exponent * 78913i64) >> 18i64

func log10_pow5(exponent: i64) -> i64:
    return (exponent * 732923i64) >> 20i64

func pow5_bits(exponent: i64) -> i64:
    return ((exponent * 1217359i64) >> 19i64) + 1i64

func multiple_of_power5(value: u64, exponent: u64) -> bool:
    var remaining = exponent
    var current = value
    while remaining > 0u64:
        if current % 5u64 != 0u64: return false
        current //= 5u64
        remaining -= 1u64
    return true

func multiple_of_power2(value: u64, exponent: u64) -> bool:
    if exponent == 0u64: return true
    return (value & ((1u64 << exponent) - 1u64)) == 0u64

# mark: Decimal text ==========================================================================

func push_unsigned_decimal(text: FloatText*, value: u64):
    var divisor = 1u64
    while value // divisor >= 10u64: divisor *= 10u64
    var remainder = value
    while divisor > 0u64:
        text.push(u8(48u64 + remainder // divisor))
        remainder %= divisor
        divisor //= 10u64

func push_decimal_float(text: FloatText*, decimal: FloatingDecimal, negative: bool, maximum_fixed_position: i64, minimum_fixed_position: i64):
    let digits = decimal_length(decimal.mantissa)
    let position = decimal.exponent + i64(digits)
    if negative: text.push(45u8)
    if position > 0i64 and position <= maximum_fixed_position:
        if position >= i64(digits):
            push_unsigned_decimal(text, decimal.mantissa)
            var zero = i64(digits)
            while zero < position:
                text.push(48u8)
                zero += 1i64
            text.push(46u8)
            text.push(48u8)
            return
        var divisor = decimal_divisor(digits)
        var offset = 0i64
        var remainder = decimal.mantissa
        while divisor > 0u64:
            if offset == position: text.push(46u8)
            text.push(u8(48u64 + remainder // divisor))
            remainder %= divisor
            divisor //= 10u64
            offset += 1i64
        return
    if position <= 0i64 and position > minimum_fixed_position:
        text.push(48u8)
        text.push(46u8)
        var zero = 0i64
        while zero > position:
            text.push(48u8)
            zero -= 1i64
        push_unsigned_decimal(text, decimal.mantissa)
        return
    let divisor = decimal_divisor(digits)
    text.push(u8(48u64 + decimal.mantissa // divisor))
    let remainder = decimal.mantissa % divisor
    if digits > 1u64:
        text.push(46u8)
        push_unsigned_decimal_padded(text, remainder, digits - 1u64)
    text.push(101u8)
    let exponent = position - 1i64
    if exponent < 0i64:
        text.push(45u8)
        push_unsigned_decimal(text, u64(0i64 - exponent))
    else:
        push_unsigned_decimal(text, u64(exponent))

func decimal_length(value: u64) -> u64:
    var digits = 1u64
    var remaining = value
    while remaining >= 10u64:
        remaining //= 10u64
        digits += 1u64
    return digits

func push_unsigned_decimal_padded(text: FloatText*, value: u64, digits: u64):
    var divisor = decimal_divisor(digits)
    var remainder = value
    while divisor > 0u64:
        text.push(u8(48u64 + remainder // divisor))
        remainder %= divisor
        divisor //= 10u64

func decimal_divisor(digits: u64) -> u64:
    var divisor = 1u64
    var position = 1u64
    while position < digits:
        divisor *= 10u64
        position += 1u64
    return divisor
