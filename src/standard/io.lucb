#==============================================================================================
#
#   io - The process's output streams as Writers, and the display functions
#        formatted output is written over
#
#   DESCRIPTION:
#       `stdout()` and `stderr()` answer the two streams the startup shim
#       owns, as `Writer` views (base.md §14.4, §16.6). The `write_*`
#       functions are the compiler-supplied `display` of §14.4 for the
#       scalar types: `print(f"...")` calls them for each field and text
#       piece, so a formatted string never becomes a value. Everything here
#       is Base code over the caller's sink; the only intrinsics are the two
#       raw writes a standard module may name.
#
#==============================================================================================

# mark: Writers ===============================================================================

## The standard sink (base.md §14.1): `write` answers the count written.
pub interface Writer:
    mutating func write(self, data: const u8[]) -> usize!

## Standard output. The shim's write cannot be observed failing here, so the
## count is the whole span. Each stream is its own type, so neither global
## needs an initialiser or a descriptor field.
struct Output implements Writer:
    var reserved: u8

    pub mutating func write(self, data: const u8[]) -> usize!:
        Builtin.write_output(data)
        return data.length

## Standard error.
struct ErrorOutput implements Writer:
    var reserved: u8

    pub mutating func write(self, data: const u8[]) -> usize!:
        Builtin.write_error(data)
        return data.length

var standard_output: Output
var standard_error: ErrorOutput

## Standard output as a `Writer`.
pub func stdout() -> Writer:
    return &standard_output

## Standard error as a `Writer`.
pub func stderr() -> Writer:
    return &standard_error

# mark: Display ===============================================================================

## `str` displays as its bytes.
pub func write_text(sink: Writer, text: str) -> unit!:
    discard(try sink.write(text.bytes))

## `bool` displays as `true` or `false`.
pub func write_bool(sink: Writer, value: bool) -> unit!:
    if value:
        try write_text(sink, "true")
    else:
        try write_text(sink, "false")

## Signed decimal with a leading `-`; the magnitude is taken in `u64`, which
## holds the minimum's as well.
pub func write_signed(sink: Writer, value: i64) -> unit!:
    if value < 0:
        try write_text(sink, "-")
        try write_unsigned(sink, -%(u64)value)
        return
    try write_unsigned(sink, (u64)value)

## Unsigned decimal, built from the last digit back in a stack buffer.
pub func write_unsigned(sink: Writer, value: u64) -> unit!:
    var digits: u8[20]
    var remaining = value
    var start: usize = 20
    while true:
        start -= 1
        digits[start] = (u8)(remaining % 10 + 48)
        remaining //= 10
        if remaining == 0: break
    let all: const u8[] = digits
    discard(try sink.write(all[start..<20]))

## A `char` displays as its UTF-8 bytes.
pub func write_char(sink: Writer, value: char) -> unit!:
    let code = u32(value)
    var encoded: u8[4]
    var count: usize = 1
    if code < 128:
        encoded[0] = (u8)code
    elif code < 2048:
        encoded[0] = (u8)(192 | (code >> 6))
        encoded[1] = (u8)(128 | (code & 63))
        count = 2
    elif code < 65536:
        encoded[0] = (u8)(224 | (code >> 12))
        encoded[1] = (u8)(128 | ((code >> 6) & 63))
        encoded[2] = (u8)(128 | (code & 63))
        count = 3
    else:
        encoded[0] = (u8)(240 | (code >> 18))
        encoded[1] = (u8)(128 | ((code >> 12) & 63))
        encoded[2] = (u8)(128 | ((code >> 6) & 63))
        encoded[3] = (u8)(128 | (code & 63))
        count = 4
    let all: const u8[] = encoded
    discard(try sink.write(all[0..<count]))

## A pointer displays as `0x` and its address in lowercase hexadecimal.
pub func write_pointer(sink: Writer, value: const void*) -> unit!:
    var digits: u8[16]
    var remaining = (u64)(usize)value
    var start: usize = 16
    while true:
        start -= 1
        let nibble = (u8)(remaining & 15)
        if nibble < 10:
            digits[start] = nibble + 48
        else:
            digits[start] = nibble + 87
        remaining >>= 4
        if remaining == 0: break
    try write_text(sink, "0x")
    let all: const u8[] = digits
    discard(try sink.write(all[start..<16]))
