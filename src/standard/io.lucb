        11: return WideProduct(low = 5577825024675947042u64, high = 2194449627517475473u64)
        12: return WideProduct(low = 11006974540203867551u64, high = 1697873161311732311u64)
        13: return WideProduct(low = 10313493231639821582u64, high = 1313665730009899186u64)
        14: return WideProduct(low = 12701016819766672773u64, high = 2032799256770390445u64)
        _: trap("Ryu inverse power index is out of range")

func power5_split(index: u64) -> WideProduct:
    match index:
        0: return WideProduct(low = 0u64, high = 1152921504606846976u64)
        1: return WideProduct(low = 0u64, high = 1490116119384765625u64)
