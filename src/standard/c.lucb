## The C types of base.md §5.2. A type whose width and signedness are the
## same on every supported target is an alias of the Base type with that
## width, so either spelling may be used. The distinct `char`, `long`,
## `ulong`, `wchar`, and `va_list` types, whose width varies by target, and
## `errno`, `stdin`, `stdout`, and `stderr` wait for the next slice, as does
## `c.bool`, whose name the core namespace reserves.

pub type int = i32
pub type uint = u32
pub type short = i16
pub type ushort = u16
pub type schar = i8
pub type uchar = u8
pub type longlong = i64
pub type ulonglong = u64
pub type float = f32
pub type double = f64
pub type size = usize
pub type uintptr = usize
pub type ssize = isize
pub type ptrdiff = isize
pub type intptr = isize

## Distinct on purpose (base.md §5.2): their width or signedness differs by
## target, so a binding that says `c.long` stays right everywhere.
pub type char = c_char
pub type long = c_long
pub type ulong = c_ulong
pub type wchar = c_wchar
