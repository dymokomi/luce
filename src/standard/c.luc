# Explicit helpers for copying data out of C-owned memory. These functions
# are ordinary Luce wrappers; only this compiler-supplied source may reach
# the closed `Builtin` implementation bridge beneath them.

# mark: C scalar values ========================================================================

# C scalar wrappers carry a universal logical value, not C object layout.
# Boolean uses Luce `bool`: the generated C adapter and selected backend alone
# realize `_Bool` object representation and ABI placement.
# Signed families use `i64`, unsigned families use `u64`, and plain `char`
# uses `i64` on every target so its target-selected signedness cannot alter
# HIR or MIR. Generated adapters check the carrier against Clang's exact
# target range before the value enters C; values coming back from C widen
# losslessly. Arithmetic remains deliberately unavailable on these nominal
# values: convert to a portable integer, calculate, then cross explicitly.

## C `_Bool`, kept nominal even though its complete value domain is Boolean.
pub struct boolean:
    pub let raw: bool

    pub func portable(self) -> bool:
        return self.raw

## Plain C `char`, whose signedness remains a FIIR target fact.
pub struct plain_char:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `signed char` carried independently of its target width.
pub struct signed_char:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `unsigned char` carried independently of its target width.
pub struct unsigned_char:
    pub let raw: u64

    pub func portable(self) -> u64:
        return self.raw

## C `short` carried independently of its target width.
pub struct short:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `unsigned short` carried independently of its target width.
pub struct unsigned_short:
    pub let raw: u64

    pub func portable(self) -> u64:
        return self.raw

## C `int` carried independently of its target width.
pub struct int:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `unsigned int` carried independently of its target width.
pub struct unsigned_int:
    pub let raw: u64

    pub func portable(self) -> u64:
        return self.raw

## C `long` carried independently of its target width.
pub struct long:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `unsigned long` carried independently of its target width.
pub struct unsigned_long:
    pub let raw: u64

    pub func portable(self) -> u64:
        return self.raw

## C `long long` carried independently of its target width.
pub struct long_long:
    pub let raw: i64

    pub func portable(self) -> i64:
        return self.raw

## C `unsigned long long` carried independently of its target width.
pub struct unsigned_long_long:
    pub let raw: u64

    pub func portable(self) -> u64:
        return self.raw

## A C `float` whose Clang-proven representation is IEEE binary32.
pub struct float:
    pub let raw: f32

    pub func portable(self) -> f32:
        return self.raw

## A C `double` whose Clang-proven representation is IEEE binary64. The
## nominal wrapper prevents it from silently becoming Luce `f64`; generated
## native modules cross their private adapter ABI through `raw`, while safe
## code converts explicitly in either direction.
pub struct double:
    pub let raw: f64

    pub func portable(self) -> f64:
        return self.raw

## A C `long double` on targets where Clang proves it is exactly IEEE
## binary64. Extended formats remain unsupported rather than losing values.
pub struct long_double:
    pub let raw: f64

    pub func portable(self) -> f64:
        return self.raw

# mark: Borrowed inbound memory ================================================================

# Copy exactly `count` bytes from a non-null foreign token. The returned
# bytes own independent storage and remain valid after C mutates its memory.
pub func bytes_at(pointer: foreign, count: u64) -> bytes:
    return Builtin.bytes_at(pointer, count)

# Copy bytes through the first NUL and validate them as UTF-8. The returned
# string owns independent storage.
pub func cstring_at(pointer: foreign) -> str:
    return Builtin.cstring_at(pointer)

# mark: Owned inbound text ====================================================================

# Copy and validate one C-owned string, then dispose the original allocation
# exactly once. A copy failure traps before the disposer is invoked.
pub func take_str(at: foreign, free: cfunc(foreign)) -> str:
    let text = Builtin.cstring_at(at)
    free(at)
    return text
