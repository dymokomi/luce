# Explicit helpers for copying data out of C-owned memory. These functions
# are ordinary Luce wrappers; only this compiler-supplied source may reach
# the closed `Builtin` implementation bridge beneath them.

# mark: C scalar values ========================================================================

## A C `double` whose Clang-proven representation is IEEE binary64. The
## nominal wrapper prevents it from silently becoming Luce `f64`; generated
## native modules cross their private adapter ABI through `raw`, while safe
## code converts explicitly in either direction.
pub struct double:
    pub let raw: f64

    pub func portable(self) -> f64:
        return self.raw

# mark: Borrowed inbound memory ================================================================

# Copy exactly `count` bytes from a non-null foreign token. The returned
# bytes own independent storage and remain valid after C mutates its memory.
pub func bytes_at(pointer: foreign, count: u64) -> bytes:
    return Builtin.bytes_at(pointer, count)

# Copy bytes through the first NUL and validate them as UTF-8. The returned
# string owns independent storage.
pub func cstring_at(pointer: foreign) -> str:
    return Builtin.cstring_at(pointer)

# mark: Owned inbound text ====================================================================

# Copy and validate one C-owned string, then dispose the original allocation
# exactly once. A copy failure traps before the disposer is invoked.
pub func take_str(at: foreign, free: cfunc(foreign)) -> str:
    let text = Builtin.cstring_at(at)
    free(at)
    return text
