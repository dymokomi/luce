#==============================================================================================
#
#   memory - The Base allocator protocol and the current allocator
#
#   DESCRIPTION:
#       What `new`, `alloc`, and `free` need (base.md §12): the `Allocator`
#       interface every allocator implements, `exhausted` for a refused
#       request, the thread-local current allocator that a `with` block
#       sets and restores, and `FixedBuffer`, bump allocation over a
#       caller's bytes with no release.
#
#==============================================================================================

## A source of memory (base.md §12.4). `allocate` answers uninitialised
## memory of at least `size` bytes at `alignment`, or `none`; `resize` grows
## or shrinks a block in place and answers whether it could; `release`
## returns a block, recovering any size class from its own bookkeeping.
pub interface Allocator:
    mutating func allocate(self, size: usize, alignment: usize) -> u8[]?
    mutating func resize(self, block: u8[], size: usize) -> bool
    mutating func release(self, block: u8[])

## An allocator answered `none` (base.md §12.2). The standard modules share
## the package's code numbers, so this one sits far from the small numbers
## an application picks first.
pub let exhausted: ErrorCode = ErrorCode.package(65000)

## The current allocator: what `new`, `alloc`, and `free` use without `in`
## (base.md §12.3). A `with` block sets it for its suite. It starts unset;
## the startup shim or the program itself assigns it before the first `new`.
pub thread_local var allocator: Allocator?

## Bump allocation over a caller's buffer (base.md §12.4): each request is
## aligned and carved from the front, `release` keeps nothing, and the
## buffer is reused by making a new `FixedBuffer` over it.
pub struct FixedBuffer implements Allocator:
    var storage: u8[]
    var used: usize

    pub func over(buffer: u8[]) -> FixedBuffer:
        return FixedBuffer(storage = buffer, used = 0)

    pub mutating func allocate(self, size: usize, alignment: usize) -> u8[]?:
        var start = self.used
        let remainder = start % alignment
        if remainder != 0: start += alignment - remainder
        if start + size > self.storage.length: return none
        self.used = start + size
        return self.storage[start..<start + size]

    pub mutating func resize(self, block: u8[], size: usize) -> bool:
        return false

    pub mutating func release(self, block: u8[]):
        return
