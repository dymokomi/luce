#==============================================================================================
#
#   allocator - Freestanding storage policy for the sealed Luce runtime
#
#   DESCRIPTION:
#       The backend provides one stable byte arena. This module owns allocation
#       policy within it. Physical requests are normalized into power-of-two
#       classes and reclaimed blocks link themselves through their first
#       pointer-sized cell. The backend guarantees that every physical class
#       is at least pointer-sized/aligned while keeping that target fact behind
#       its layout boundary.
#
#       Byte zero remains unused so zero can retain its inert/null meaning at
#       representation boundaries. Every arithmetic operation is ordinary
#       checked Luce arithmetic; overflow traps before allocator state changes.
#
#==============================================================================================

# mark: Stable arena ===========================================================================

var next_offset: u64
var free_heads: array[native_mut_ptr[u8], 64]

# Return the one power-of-two class that satisfies both payload size and the
# backend-normalized recycling alignment. Checked doubling terminates before
# an unrepresentable or impossible arena request can corrupt allocator state.
func storage_class(byte_count: u64, byte_alignment: u64) -> u64:
    var required = byte_count
    if required < byte_alignment: required = byte_alignment
    var size = 1u64
    var index = 0u64
    while size < required:
        size *= 2u64
        index += 1u64
    return index

func storage_class_size(index: u64) -> u64:
    var size = 1u64
    var current = 0u64
    while current < index:
        size *= 2u64
        current += 1u64
    return size

func allocate_storage(byte_count: u64, byte_alignment: u64) -> native_mut_ptr[u8]:
    let size_class = storage_class(byte_count, byte_alignment)
    let reused = free_heads[size_class]
    if not native.is_null(reused):
        let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(reused)
        free_heads[size_class] = native.load(link)
        return reused

    let block_size = storage_class_size(size_class)
    var start = next_offset
    if start == 0u64: start = 1u64

    let remainder = start % block_size
    if remainder != 0u64: start += block_size - remainder

    let end = start + block_size
    let base = native.arena(end)
    next_offset = end
    return native.advance(base, start)

func deallocate_storage(value: native_mut_ptr[u8], byte_count: u64, byte_alignment: u64):
    let size_class = storage_class(byte_count, byte_alignment)
    let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(value)
    native.store(link, free_heads[size_class])
    free_heads[size_class] = value

# mark: Lists and immutable slices =============================================================

# A list handle points at this private header. Its layout is ordinary Luce
# structure chosen by each backend; neither HIR nor MIR knows these fields.
struct ListHeader:
    var data: native_mut_ptr[u8]
    var length: u64
    var capacity: u64
    var has_snapshot: bool
    var active_iterations: u64

struct SliceHeader:
    let data: native_mut_ptr[u8]
    let length: u64

func list_create() -> native_mut_ptr[u8]:
    let header = native.allocate[ListHeader](1u64)
    let empty = native.allocate[u8](0u64)
    native.store(header, ListHeader(data = empty, length = 0u64, capacity = 0u64, has_snapshot = false, active_iterations = 0u64))
    return native.rebind(header)

func list_length(value: native_mut_ptr[u8]) -> u64:
    let header: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(header).length

# Active traversal belongs to the list identity, so every alias observes the
# same shape-mutation barrier. Begin returns the captured length atomically
# with registration; nested read-only traversals simply increase the depth.
func list_iteration_begin(value: native_mut_ptr[u8]) -> u64:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    header.active_iterations += 1u64
    native.store(header_pointer, header)
    return header.length

func list_iteration_end(value: native_mut_ptr[u8]):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    header.active_iterations -= 1u64
    native.store(header_pointer, header)

func list_iteration_active(value: native_mut_ptr[u8]) -> bool:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(header_pointer).active_iterations > 0u64

# Return a header with room for at least `minimum_capacity` elements. Growth
# policy and byte layout remain private runtime/backend concerns; the updated
# header is stored by the caller only after allocation and copying succeed.
func grow_list(header_value: ListHeader, element_size: u64, element_alignment: u64, minimum_capacity: u64) -> ListHeader:
    var header = header_value
    if header.capacity >= minimum_capacity: return header

    var capacity = header.capacity
    if capacity == 0u64: capacity = 4u64
    while capacity < minimum_capacity:
        # Luce's current `u64` execution ceiling is i64.max. Avoid overflow
        # while retaining geometric growth; an impossible final allocation
        # still traps through the checked allocator without committing state.
        if capacity > 4611686018427387903u64: capacity = minimum_capacity
        else: capacity *= 2u64

    let data = allocate_storage(capacity * element_size, element_alignment)
    if header.length > 0u64:
        native.move(data, header.data, header.length * element_size)
    header.data = data
    header.capacity = capacity
    header.has_snapshot = false
    return header

# Copy the live prefix before its first write after a slice captured it. The
# slice retains the old arena storage; every alias of the list shares this
# updated header and therefore observes the same subsequent mutation.
func detach_list(header_value: ListHeader, element_size: u64, element_alignment: u64) -> ListHeader:
    var header = header_value
    if not header.has_snapshot: return header
    let data = allocate_storage(header.capacity * element_size, element_alignment)
    if header.length > 0u64:
        native.move(data, header.data, header.length * element_size)
    header.data = data
    header.has_snapshot = false
    return header

# Create a new list identity and independent element storage. Copying bytes is
# shallow by design: value elements retain their value representation and
# reference elements retain the same referenced identity.
func list_copy(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64) -> native_mut_ptr[u8]:
    let source_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let source = native.load(source_pointer)
    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    var copied = grow_list(native.load(result_pointer), element_size, element_alignment, source.length)
    if source.length > 0u64:
        native.move(copied.data, source.data, source.length * element_size)
    copied.length = source.length
    native.store(result_pointer, copied)
    return result

# Concatenate with one fresh header and one result buffer. Both input headers
# and exact live-prefix sizes are settled before allocation; `grow_list` then
# owns its ordinary checked capacity arithmetic.
func list_concat(left_value: native_mut_ptr[u8], right_value: native_mut_ptr[u8], element_size: u64, element_alignment: u64) -> native_mut_ptr[u8]:
    let left_pointer: native_mut_ptr[ListHeader] = native.rebind(left_value)
    let right_pointer: native_mut_ptr[ListHeader] = native.rebind(right_value)
    let left = native.load(left_pointer)
    let right = native.load(right_pointer)
    let total_length = left.length + right.length
    let left_bytes = left.length * element_size
    let right_bytes = right.length * element_size

    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    var joined = grow_list(native.load(result_pointer), element_size, element_alignment, total_length)
    if left.length > 0u64: native.move(joined.data, left.data, left_bytes)
    if right.length > 0u64:
        native.move(native.advance(joined.data, left_bytes), right.data, right_bytes)
    joined.length = total_length
    native.store(result_pointer, joined)
    return result

# Open an uninitialised slot and shift the tail overlap-safely. Passing the
# already-loaded header lets append and insert share policy without a second
# header read. Backends have already enforced `index <= length`.
func open_list_slot(header_pointer: native_mut_ptr[ListHeader], header_value: ListHeader, element_size: u64, element_alignment: u64, index: u64) -> native_mut_ptr[u8]:
    var header = detach_list(header_value, element_size, element_alignment)
    header = grow_list(header, element_size, element_alignment, header.length + 1u64)
    let slot = native.advance(header.data, index * element_size)
    if index < header.length:
        let destination = native.advance(slot, element_size)
        native.move(destination, slot, (header.length - index) * element_size)
    header.length += 1u64
    native.store(header_pointer, header)
    return slot

# Insert and append each load the header exactly once, then share all growth,
# movement, and commit logic through `open_list_slot`.
func list_insert_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return open_list_slot(header_pointer, native.load(header_pointer), element_size, element_alignment, index)

func list_append_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = native.load(header_pointer)
    return open_list_slot(header_pointer, header, element_size, element_alignment, header.length)

# Remove one existing element and close its slot. The compiler copies the
# result out before this service runs; backends independently enforce bounds.
func list_remove_at(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = detach_list(native.load(header_pointer), element_size, element_alignment)
    let tail = header.length - index - 1u64
    if tail > 0u64:
        let destination = native.advance(header.data, index * element_size)
        let source = native.advance(destination, element_size)
        native.move(destination, source, tail * element_size)
    header.length -= 1u64
    native.store(header_pointer, header)

func list_clear(value: native_mut_ptr[u8]):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    header.length = 0u64
    native.store(header_pointer, header)

func list_reserve(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, minimum_capacity: u64):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = grow_list(native.load(header_pointer), element_size, element_alignment, minimum_capacity)
    native.store(header_pointer, header)

# Bounds remain part of canonical ListElementAddress. Backends check them via
# list_length before entering this private unchecked address calculation.
func list_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = native.load(header_pointer)
    return native.advance(header.data, index * element_size)

# A mutable address is a semantic write barrier: preserve any existing slice
# before exposing storage that the following canonical store may change.
func list_mutable_element_address(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = detach_list(native.load(header_pointer), element_size, element_alignment)
    native.store(header_pointer, header)
    return native.advance(header.data, index * element_size)

func list_slice(value: native_mut_ptr[u8], element_size: u64, start: u64, end: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    let slice = native.allocate[SliceHeader](1u64)
    native.store(slice, SliceHeader(data = native.advance(header.data, start * element_size), length = end - start))
    header.has_snapshot = true
    native.store(header_pointer, header)
    return native.rebind(slice)

func slice_length(value: native_mut_ptr[u8]) -> u64:
    let header: native_mut_ptr[SliceHeader] = native.rebind(value)
    return native.load(header).length

# Bounds remain canonical; this service receives only a verified index.
func slice_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    let header = native.load(header_pointer)
    return native.advance(header.data, index * element_size)
