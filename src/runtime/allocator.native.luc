#==============================================================================================
#
#   allocator - Freestanding storage policy for the sealed Luce runtime
#
#   DESCRIPTION:
#       The backend provides one stable byte arena. This module owns allocation
#       policy within it. Physical requests are normalized into power-of-two
#       classes and reclaimed blocks link themselves through their first
#       pointer-sized cell. The backend guarantees that every physical class
#       is at least pointer-sized/aligned while keeping that target fact behind
#       its layout boundary.
#
#       Byte zero remains unused so zero can retain its inert/null meaning at
#       representation boundaries. Every arithmetic operation is ordinary
#       checked Luce arithmetic; overflow traps before allocator state changes.
#
#==============================================================================================

# mark: Stable arena ===========================================================================

var next_offset: u64
var free_heads: array[native_mut_ptr[u8], 64]

# Return the one power-of-two class that satisfies both payload size and the
# backend-normalized recycling alignment. Checked doubling terminates before
# an unrepresentable or impossible arena request can corrupt allocator state.
func storage_class(byte_count: u64, byte_alignment: u64) -> u64:
    var required = byte_count
    if required < byte_alignment: required = byte_alignment
    var size = 1u64
    var index = 0u64
    while size < required:
        size *= 2u64
        index += 1u64
    return index

func storage_class_size(index: u64) -> u64:
    var size = 1u64
    var current = 0u64
    while current < index:
        size *= 2u64
        current += 1u64
    return size

func allocate_storage(byte_count: u64, byte_alignment: u64) -> native_mut_ptr[u8]:
    let size_class = storage_class(byte_count, byte_alignment)
    let reused = free_heads[size_class]
    if not native.is_null(reused):
        let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(reused)
        free_heads[size_class] = native.load(link)
        return reused

    let block_size = storage_class_size(size_class)
    var start = next_offset
    if start == 0u64: start = 1u64

    let remainder = start % block_size
    if remainder != 0u64: start += block_size - remainder

    let end = start + block_size
    let base = native.arena(end)
    next_offset = end
    return native.advance(base, start)

func deallocate_storage(value: native_mut_ptr[u8], byte_count: u64, byte_alignment: u64):
    let size_class = storage_class(byte_count, byte_alignment)
    let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(value)
    native.store(link, free_heads[size_class])
    free_heads[size_class] = value

# mark: Lists and immutable slices =============================================================

# List identities and immutable slices retain a separately counted buffer.
# A list mutates a buffer only while it is the sole owner; otherwise it copies
# the live prefix and invokes the compiler-generated structural retain action
# once per copied element. The matching release action is called exactly once
# before the last buffer owner reclaims that element's storage.
struct ListBuffer:
    var references: u64
    var data: native_mut_ptr[u8]
    var length: u64
    var capacity: u64

struct ListHeader:
    var references: u64
    var buffer: native_mut_ptr[ListBuffer]
    var active_iterations: u64

struct SliceHeader:
    var references: u64
    let buffer: native_mut_ptr[ListBuffer]
    let start: u64
    let length: u64

func create_list_buffer() -> native_mut_ptr[ListBuffer]:
    let buffer = native.allocate[ListBuffer](1u64)
    let empty = native.allocate[u8](0u64)
    native.store(buffer, ListBuffer(references = 1u64, data = empty, length = 0u64, capacity = 0u64))
    return buffer

func retain_list_buffer(pointer: native_mut_ptr[ListBuffer]):
    var buffer = native.load(pointer)
    buffer.references += 1u64
    native.store(pointer, buffer)

func release_list_buffer(pointer: native_mut_ptr[ListBuffer], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    var buffer = native.load(pointer)
    buffer.references -= 1u64
    if buffer.references > 0u64:
        native.store(pointer, buffer)
        return

    var remaining = buffer.length
    while remaining > 0u64:
        remaining -= 1u64
        release_element(native.advance(buffer.data, remaining * element_size))
    if buffer.capacity > 0u64:
        deallocate_storage(buffer.data, buffer.capacity * element_size, element_alignment)
    native.deallocate(pointer, 1u64)

func retain_elements(buffer: ListBuffer, element_size: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    var index = 0u64
    while index < buffer.length:
        retain_element(native.advance(buffer.data, index * element_size))
        index += 1u64

func grow_list_buffer(pointer: native_mut_ptr[ListBuffer], element_size: u64, element_alignment: u64, minimum_capacity: u64):
    var buffer = native.load(pointer)
    if buffer.capacity >= minimum_capacity: return

    var capacity = buffer.capacity
    if capacity == 0u64: capacity = 4u64
    while capacity < minimum_capacity:
        if capacity > 4611686018427387903u64: capacity = minimum_capacity
        else: capacity *= 2u64

    let data = allocate_storage(capacity * element_size, element_alignment)
    if buffer.length > 0u64:
        native.move(data, buffer.data, buffer.length * element_size)
    if buffer.capacity > 0u64:
        deallocate_storage(buffer.data, buffer.capacity * element_size, element_alignment)
    buffer.data = data
    buffer.capacity = capacity
    native.store(pointer, buffer)

func list_create() -> native_mut_ptr[u8]:
    let header = native.allocate[ListHeader](1u64)
    native.store(header, ListHeader(references = 1u64, buffer = create_list_buffer(), active_iterations = 0u64))
    return native.rebind(header)

func list_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func list_release(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    release_list_buffer(header.buffer, element_size, element_alignment, release_element)
    native.deallocate(pointer, 1u64)

func list_length(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(native.load(pointer).buffer).length

# Active traversal belongs to the list identity, so every alias observes the
# same shape-mutation barrier. Begin returns the captured length atomically.
func list_iteration_begin(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations += 1u64
    native.store(pointer, header)
    return native.load(header.buffer).length

func list_iteration_end(value: native_mut_ptr[u8]):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations -= 1u64
    native.store(pointer, header)

func list_iteration_active(value: native_mut_ptr[u8]) -> bool:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(pointer).active_iterations > 0u64

# Return a unique buffer for a write. A shared snapshot keeps the old buffer;
# the list's copied representation becomes an additional element owner.
func detach_list(pointer: native_mut_ptr[ListHeader], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[ListBuffer]:
    var header = native.load(pointer)
    var source = native.load(header.buffer)
    if source.references == 1u64: return header.buffer

    let copied_pointer = create_list_buffer()
    grow_list_buffer(copied_pointer, element_size, element_alignment, source.capacity)
    var copied = native.load(copied_pointer)
    if source.length > 0u64:
        native.move(copied.data, source.data, source.length * element_size)
    copied.length = source.length
    native.store(copied_pointer, copied)
    retain_elements(copied, element_size, retain_element)

    source.references -= 1u64
    native.store(header.buffer, source)
    header.buffer = copied_pointer
    native.store(pointer, header)
    return copied_pointer

# Explicit list copy and concatenation own their copied element representations
# independently, while reference elements continue to name the same identity.
func list_copy(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let source_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let source = native.load(native.load(source_pointer).buffer)
    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    let result_buffer = native.load(result_pointer).buffer
    grow_list_buffer(result_buffer, element_size, element_alignment, source.length)
    var copied = native.load(result_buffer)
    if source.length > 0u64:
        native.move(copied.data, source.data, source.length * element_size)
    copied.length = source.length
    native.store(result_buffer, copied)
    retain_elements(copied, element_size, retain_element)
    return result

func list_concat(left_value: native_mut_ptr[u8], right_value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let left_pointer: native_mut_ptr[ListHeader] = native.rebind(left_value)
    let right_pointer: native_mut_ptr[ListHeader] = native.rebind(right_value)
    let left = native.load(native.load(left_pointer).buffer)
    let right = native.load(native.load(right_pointer).buffer)
    let total_length = left.length + right.length

    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    let result_buffer = native.load(result_pointer).buffer
    grow_list_buffer(result_buffer, element_size, element_alignment, total_length)
    var joined = native.load(result_buffer)
    if left.length > 0u64:
        native.move(joined.data, left.data, left.length * element_size)
    if right.length > 0u64:
        native.move(native.advance(joined.data, left.length * element_size), right.data, right.length * element_size)
    joined.length = total_length
    native.store(result_buffer, joined)
    retain_elements(joined, element_size, retain_element)
    return result

func open_list_slot(header_pointer: native_mut_ptr[ListHeader], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let buffer_pointer = detach_list(header_pointer, element_size, element_alignment, retain_element)
    var buffer = native.load(buffer_pointer)
    grow_list_buffer(buffer_pointer, element_size, element_alignment, buffer.length + 1u64)
    buffer = native.load(buffer_pointer)
    let slot = native.advance(buffer.data, index * element_size)
    if index < buffer.length:
        native.move(native.advance(slot, element_size), slot, (buffer.length - index) * element_size)
    buffer.length += 1u64
    native.store(buffer_pointer, buffer)
    return slot

func list_insert_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return open_list_slot(pointer, element_size, element_alignment, index, retain_element)

func list_append_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let length = native.load(native.load(pointer).buffer).length
    return open_list_slot(pointer, element_size, element_alignment, length, retain_element)

# The lowerer copies the removed element out before this operation. Detachment
# retains a second representation first, so removing from the new buffer
# transfers precisely that ownership to the result.
func list_remove_at(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer_pointer = detach_list(pointer, element_size, element_alignment, retain_element)
    var buffer = native.load(buffer_pointer)
    let tail = buffer.length - index - 1u64
    if tail > 0u64:
        let destination = native.advance(buffer.data, index * element_size)
        native.move(destination, native.advance(destination, element_size), tail * element_size)
    buffer.length -= 1u64
    native.store(buffer_pointer, buffer)

func list_clear(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    var buffer = native.load(header.buffer)
    if buffer.references > 1u64:
        buffer.references -= 1u64
        native.store(header.buffer, buffer)
        header.buffer = create_list_buffer()
        native.store(pointer, header)
        return

    var remaining = buffer.length
    while remaining > 0u64:
        remaining -= 1u64
        release_element(native.advance(buffer.data, remaining * element_size))
    buffer.length = 0u64
    native.store(header.buffer, buffer)

func list_reserve(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, minimum_capacity: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    if native.load(native.load(pointer).buffer).capacity >= minimum_capacity: return
    let buffer = detach_list(pointer, element_size, element_alignment, retain_element)
    grow_list_buffer(buffer, element_size, element_alignment, minimum_capacity)

# Bounds remain canonical; private address services receive only checked indices.
func list_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer = native.load(native.load(pointer).buffer)
    return native.advance(buffer.data, index * element_size)

func list_mutable_element_address(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer_pointer = detach_list(pointer, element_size, element_alignment, retain_element)
    return native.advance(native.load(buffer_pointer).data, index * element_size)

func list_slice(value: native_mut_ptr[u8], element_size: u64, start: u64, end: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer = native.load(pointer).buffer
    retain_list_buffer(buffer)
    let slice = native.allocate[SliceHeader](1u64)
    native.store(slice, SliceHeader(references = 1u64, buffer = buffer, start = start, length = end - start))
    return native.rebind(slice)

func slice_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func slice_release(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    if native.is_null(value): return
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    release_list_buffer(header.buffer, element_size, element_alignment, release_element)
    native.deallocate(pointer, 1u64)

func slice_length(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    return native.load(pointer).length

func slice_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    let header = native.load(pointer)
    let buffer = native.load(header.buffer)
    return native.advance(buffer.data, (header.start + index) * element_size)
