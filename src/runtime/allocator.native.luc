#==============================================================================================
#
#   allocator - Freestanding storage policy for the sealed Luce runtime
#
#   DESCRIPTION:
#       The backend provides one stable byte arena. This module owns allocation
#       policy within it. The first implementation is a checked, aligned bump
#       allocator: reclamation and reuse will extend this module when release
#       semantics arrive, without changing HIR, MIR, or a backend.
#
#       Byte zero remains unused so zero can retain its inert/null meaning at
#       representation boundaries. Every arithmetic operation is ordinary
#       checked Luce arithmetic; overflow traps before allocator state changes.
#
#==============================================================================================

var next_offset: u64

func allocate_storage(byte_count: u64, byte_alignment: u64) -> native_mut_ptr[u8]:
    var start = next_offset
    if start == 0u64: start = 1u64

    let remainder = start % byte_alignment
    if remainder != 0u64: start += byte_alignment - remainder

    let end = start + byte_count
    let base = native.arena(end)
    next_offset = end
    return native.advance(base, start)

# A list handle points at this private header. Its layout is ordinary Luce
# structure chosen by each backend; neither HIR nor MIR knows these fields.
struct ListHeader:
    var data: native_mut_ptr[u8]
    var length: u64
    var capacity: u64

func list_create() -> native_mut_ptr[u8]:
    let header = native.allocate[ListHeader](1u64)
    let empty = native.allocate[u8](0u64)
    native.store(header, ListHeader(data = empty, length = 0u64, capacity = 0u64))
    return native.rebind(header)

func list_length(value: native_mut_ptr[u8]) -> u64:
    let header: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(header).length

# Return a header with room for at least `minimum_capacity` elements. Growth
# policy and byte layout remain private runtime/backend concerns; the updated
# header is stored by the caller only after allocation and copying succeed.
func grow_list(header_value: ListHeader, element_size: u64, element_alignment: u64, minimum_capacity: u64) -> ListHeader:
    var header = header_value
    if header.capacity >= minimum_capacity: return header

    var capacity = header.capacity
    if capacity == 0u64: capacity = 4u64
    while capacity < minimum_capacity:
        # Luce's current `u64` execution ceiling is i64.max. Avoid overflow
        # while retaining geometric growth; an impossible final allocation
        # still traps through the checked allocator without committing state.
        if capacity > 4611686018427387903u64: capacity = minimum_capacity
        else: capacity *= 2u64

    let data = allocate_storage(capacity * element_size, element_alignment)
    if header.length > 0u64:
        native.move(data, header.data, header.length * element_size)
    header.data = data
    header.capacity = capacity
    return header

# Open an uninitialised slot and shift the tail overlap-safely. Passing the
# already-loaded header lets append and insert share policy without a second
# header read. Backends have already enforced `index <= length`.
func open_list_slot(header_pointer: native_mut_ptr[ListHeader], header_value: ListHeader, element_size: u64, element_alignment: u64, index: u64) -> native_mut_ptr[u8]:
    var header = header_value
    header = grow_list(header, element_size, element_alignment, header.length + 1u64)
    let slot = native.advance(header.data, index * element_size)
    if index < header.length:
        let destination = native.advance(slot, element_size)
        native.move(destination, slot, (header.length - index) * element_size)
    header.length += 1u64
    native.store(header_pointer, header)
    return slot

# Insert and append each load the header exactly once, then share all growth,
# movement, and commit logic through `open_list_slot`.
func list_insert_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return open_list_slot(header_pointer, native.load(header_pointer), element_size, element_alignment, index)

func list_append_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = native.load(header_pointer)
    return open_list_slot(header_pointer, header, element_size, element_alignment, header.length)

# Remove one existing element and close its slot. The compiler copies the
# result out before this service runs; backends independently enforce bounds.
func list_remove_at(value: native_mut_ptr[u8], element_size: u64, index: u64):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    let tail = header.length - index - 1u64
    if tail > 0u64:
        let destination = native.advance(header.data, index * element_size)
        let source = native.advance(destination, element_size)
        native.move(destination, source, tail * element_size)
    header.length -= 1u64
    native.store(header_pointer, header)

func list_clear(value: native_mut_ptr[u8]):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(header_pointer)
    header.length = 0u64
    native.store(header_pointer, header)

func list_reserve(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, minimum_capacity: u64):
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = grow_list(native.load(header_pointer), element_size, element_alignment, minimum_capacity)
    native.store(header_pointer, header)

# Bounds remain part of canonical ListElementAddress. Backends check them via
# list_length before entering this private unchecked address calculation.
func list_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let header_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let header = native.load(header_pointer)
    return native.advance(header.data, index * element_size)
