#==============================================================================================
#
#   allocator - Freestanding storage policy for the sealed Luce runtime
#
#   DESCRIPTION:
#       The backend provides one stable byte arena. This module owns allocation
#       policy within it. Physical requests are normalized into power-of-two
#       classes and reclaimed blocks link themselves through their first
#       pointer-sized cell. The backend guarantees that every physical class
#       is at least pointer-sized/aligned while keeping that target fact behind
#       its layout boundary.
#
#       Byte zero remains unused so zero can retain its inert/null meaning at
#       representation boundaries. Every arithmetic operation is ordinary
#       checked Luce arithmetic; overflow traps before allocator state changes.
#
#==============================================================================================

# mark: Stable arena ===========================================================================

var next_offset: u64
var free_heads: array[native_mut_ptr[u8], 64]

# Return the one power-of-two class that satisfies both payload size and the
# backend-normalized recycling alignment. Checked doubling terminates before
# an unrepresentable or impossible arena request can corrupt allocator state.
func storage_class(byte_count: u64, byte_alignment: u64) -> u64:
    var required = byte_count
    if required < byte_alignment: required = byte_alignment
    var size = 1u64
    var index = 0u64
    while size < required:
        size *= 2u64
        index += 1u64
    return index

func storage_class_size(index: u64) -> u64:
    var size = 1u64
    var current = 0u64
    while current < index:
        size *= 2u64
        current += 1u64
    return size

func allocate_storage(byte_count: u64, byte_alignment: u64) -> native_mut_ptr[u8]:
    let size_class = storage_class(byte_count, byte_alignment)
    let reused = free_heads[size_class]
    if not native.is_null(reused):
        let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(reused)
        free_heads[size_class] = native.load(link)
        return reused

    let block_size = storage_class_size(size_class)
    var start = next_offset
    if start == 0u64: start = 1u64

    let remainder = start % block_size
    if remainder != 0u64: start += block_size - remainder

    let end = start + block_size
    let base = native.arena(end)
    next_offset = end
    return native.advance(base, start)

func deallocate_storage(value: native_mut_ptr[u8], byte_count: u64, byte_alignment: u64):
    let size_class = storage_class(byte_count, byte_alignment)
    let link: native_mut_ptr[native_mut_ptr[u8]] = native.rebind(value)
    native.store(link, free_heads[size_class])
    free_heads[size_class] = value

# mark: Recursive equality ====================================================================

# Structural equality is coinductive only at mutable collection identities.
# One short-lived transaction records ordered pairs already being compared;
# generated MIR still owns every element and aggregate comparison. This
# runtime owner chooses only storage policy for the opaque pair set.
struct EqualityPair:
    let left: native_mut_ptr[u8]
    let right: native_mut_ptr[u8]

struct EqualityContext:
    var pairs: native_mut_ptr[EqualityPair]
    var length: u64
    var capacity: u64

func equality_context_create() -> native_mut_ptr[u8]:
    let context = native.allocate[EqualityContext](1u64)
    native.store(context, EqualityContext(
        pairs = native.allocate[EqualityPair](0u64),
        length = 0u64,
        capacity = 0u64,
    ))
    return native.rebind(context)

func equality_context_release(value: native_mut_ptr[u8]):
    let context: native_mut_ptr[EqualityContext] = native.rebind(value)
    let state = native.load(context)
    if state.capacity > 0u64: native.deallocate(state.pairs, state.capacity)
    native.deallocate(context, 1u64)

func equality_context_visit(value: native_mut_ptr[u8], left: native_mut_ptr[u8], right: native_mut_ptr[u8]) -> bool:
    let context: native_mut_ptr[EqualityContext] = native.rebind(value)
    var state = native.load(context)
    var index = 0u64
    while index < state.length:
        let pair = native.load(native.advance(state.pairs, index))
        if native.is_same(pair.left, left) and native.is_same(pair.right, right): return true
        index += 1u64

    if state.length == state.capacity:
        var capacity = 4u64
        if state.capacity > 0u64: capacity = state.capacity * 2u64
        let grown = native.allocate[EqualityPair](capacity)
        if state.length > 0u64: native.move(grown, state.pairs, state.length)
        if state.capacity > 0u64: native.deallocate(state.pairs, state.capacity)
        state.pairs = grown
        state.capacity = capacity

    native.store(native.advance(state.pairs, state.length), EqualityPair(left = left, right = right))
    state.length += 1u64
    native.store(context, state)
    return false

# mark: Insertion-ordered hash collections ====================================================

# Maps and sets share this dense entry table. Dense key/value arrays preserve
# insertion order; separate bucket heads and collision links keep lookup
# proportional to the matching hash chain rather than collection length.
# Entries move only as raw owned representations. Generated MIR remains the
# sole owner of key equality, hashing, and nested retain/release semantics.
struct HashHeader:
    var references: u64
    var hashes: native_mut_ptr[u64]
    var next: native_mut_ptr[u64]
    var keys: native_mut_ptr[u8]
    var values: native_mut_ptr[u8]
    var length: u64
    var capacity: u64
    var buckets: native_mut_ptr[u64]
    var bucket_capacity: u64
    var active_iterations: u64
    let seed: u64

func hash_create() -> native_mut_ptr[u8]:
    let pointer = native.allocate[HashHeader](1u64)
    let seed_address: native_mut_ptr[u8] = native.rebind(pointer)
    native.store(pointer, HashHeader(
        references = 1u64,
        hashes = native.allocate[u64](0u64),
        next = native.allocate[u64](0u64),
        keys = native.allocate[u8](0u64),
        values = native.allocate[u8](0u64),
        length = 0u64,
        capacity = 0u64,
        buckets = native.allocate[u64](0u64),
        bucket_capacity = 0u64,
        active_iterations = 0u64,
        seed = native.address_hash(seed_address),
    ))
    return native.rebind(pointer)

func hash_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func hash_bucket(key_hash: u64, seed: u64, capacity: u64) -> u64:
    return (key_hash ^ seed) % capacity

func rebuild_hash_buckets(pointer: native_mut_ptr[HashHeader]):
    var header = native.load(pointer)
    var bucket = 0u64
    while bucket < header.bucket_capacity:
        native.store(native.advance(header.buckets, bucket), 0u64)
        bucket += 1u64
    var index = 0u64
    while index < header.length:
        let selected = hash_bucket(native.load(native.advance(header.hashes, index)), header.seed, header.bucket_capacity)
        native.store(native.advance(header.next, index), native.load(native.advance(header.buckets, selected)))
        native.store(native.advance(header.buckets, selected), index + 1u64)
        index += 1u64

func grow_hash(pointer: native_mut_ptr[HashHeader], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, minimum_capacity: u64):
    var header = native.load(pointer)
    if header.capacity >= minimum_capacity: return

    var capacity = header.capacity
    if capacity == 0u64: capacity = 4u64
    while capacity < minimum_capacity:
        if capacity > 4611686018427387903u64: capacity = minimum_capacity
        else: capacity *= 2u64
    var bucket_capacity = 8u64
    while bucket_capacity < capacity * 2u64: bucket_capacity *= 2u64

    let hashes = native.allocate[u64](capacity)
    let next = native.allocate[u64](capacity)
    var keys = native.allocate[u8](0u64)
    var values = native.allocate[u8](0u64)
    if key_size > 0u64: keys = allocate_storage(capacity * key_size, key_alignment)
    if value_size > 0u64: values = allocate_storage(capacity * value_size, value_alignment)
    let buckets = native.allocate[u64](bucket_capacity)

    if header.length > 0u64:
        native.move(hashes, header.hashes, header.length)
        if key_size > 0u64: native.move(keys, header.keys, header.length * key_size)
        if value_size > 0u64: native.move(values, header.values, header.length * value_size)
    if header.capacity > 0u64:
        native.deallocate(header.hashes, header.capacity)
        native.deallocate(header.next, header.capacity)
        if key_size > 0u64: deallocate_storage(header.keys, header.capacity * key_size, key_alignment)
        if value_size > 0u64: deallocate_storage(header.values, header.capacity * value_size, value_alignment)
        native.deallocate(header.buckets, header.bucket_capacity)

    header.hashes = hashes
    header.next = next
    header.keys = keys
    header.values = values
    header.capacity = capacity
    header.buckets = buckets
    header.bucket_capacity = bucket_capacity
    native.store(pointer, header)
    rebuild_hash_buckets(pointer)

func hash_release(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, release_key: func(native_mut_ptr[u8]) -> unit, release_value: func(native_mut_ptr[u8]) -> unit):
    if native.is_null(value): return
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    var remaining = header.length
    while remaining > 0u64:
        remaining -= 1u64
        release_key(native.advance(header.keys, remaining * key_size))
        release_value(native.advance(header.values, remaining * value_size))
    if header.capacity > 0u64:
        native.deallocate(header.hashes, header.capacity)
        native.deallocate(header.next, header.capacity)
        if key_size > 0u64: deallocate_storage(header.keys, header.capacity * key_size, key_alignment)
        if value_size > 0u64: deallocate_storage(header.values, header.capacity * value_size, value_alignment)
        native.deallocate(header.buckets, header.bucket_capacity)
    native.deallocate(pointer, 1u64)

func hash_copy(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, retain_key: func(native_mut_ptr[u8]) -> unit, retain_value: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let source_pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    let source = native.load(source_pointer)
    let result = hash_create()
    let result_pointer: native_mut_ptr[HashHeader] = native.rebind(result)
    grow_hash(result_pointer, key_size, key_alignment, value_size, value_alignment, source.length)
    var copied = native.load(result_pointer)
    if source.length > 0u64:
        native.move(copied.hashes, source.hashes, source.length)
        if key_size > 0u64: native.move(copied.keys, source.keys, source.length * key_size)
        if value_size > 0u64: native.move(copied.values, source.values, source.length * value_size)
    copied.length = source.length
    native.store(result_pointer, copied)
    rebuild_hash_buckets(result_pointer)
    var index = 0u64
    while index < source.length:
        retain_key(native.advance(copied.keys, index * key_size))
        retain_value(native.advance(copied.values, index * value_size))
        index += 1u64
    return result

func hash_length(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    return native.load(pointer).length

func hash_iteration_begin(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations += 1u64
    native.store(pointer, header)
    return header.length

func hash_iteration_end(value: native_mut_ptr[u8]):
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations -= 1u64
    native.store(pointer, header)

func require_hash_shape_mutable(pointer: native_mut_ptr[HashHeader]):
    if native.load(pointer).active_iterations > 0u64:
        trap("hash collection structurally modified during active iteration")

func hash_find_first(value: native_mut_ptr[u8], key_hash: u64) -> u64:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    let header = native.load(pointer)
    if header.bucket_capacity == 0u64: return 0u64
    return native.load(native.advance(header.buckets, hash_bucket(key_hash, header.seed, header.bucket_capacity)))

func hash_find_next(value: native_mut_ptr[u8], current: u64) -> u64:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    return native.load(native.advance(native.load(pointer).next, current - 1u64))

func hash_key_address(value: native_mut_ptr[u8], key_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    return native.advance(native.load(pointer).keys, index * key_size)

func hash_value_address(value: native_mut_ptr[u8], value_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    return native.advance(native.load(pointer).values, index * value_size)

func hash_insert_entry(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, key_hash: u64) -> u64:
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    require_hash_shape_mutable(pointer)
    var header = native.load(pointer)
    grow_hash(pointer, key_size, key_alignment, value_size, value_alignment, header.length + 1u64)
    header = native.load(pointer)
    let index = header.length
    native.store(native.advance(header.hashes, index), key_hash)
    let bucket = hash_bucket(key_hash, header.seed, header.bucket_capacity)
    native.store(native.advance(header.next, index), native.load(native.advance(header.buckets, bucket)))
    native.store(native.advance(header.buckets, bucket), index + 1u64)
    header.length += 1u64
    native.store(pointer, header)
    return index

func hash_remove_entry(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, index: u64):
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    require_hash_shape_mutable(pointer)
    var header = native.load(pointer)
    let tail = header.length - index - 1u64
    if tail > 0u64:
        native.move(native.advance(header.hashes, index), native.advance(header.hashes, index + 1u64), tail)
        if key_size > 0u64: native.move(native.advance(header.keys, index * key_size), native.advance(header.keys, (index + 1u64) * key_size), tail * key_size)
        if value_size > 0u64: native.move(native.advance(header.values, index * value_size), native.advance(header.values, (index + 1u64) * value_size), tail * value_size)
    header.length -= 1u64
    native.store(pointer, header)
    rebuild_hash_buckets(pointer)

func hash_clear(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, release_key: func(native_mut_ptr[u8]) -> unit, release_value: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    require_hash_shape_mutable(pointer)
    var header = native.load(pointer)
    var remaining = header.length
    while remaining > 0u64:
        remaining -= 1u64
        release_key(native.advance(header.keys, remaining * key_size))
        release_value(native.advance(header.values, remaining * value_size))
    header.length = 0u64
    native.store(pointer, header)
    rebuild_hash_buckets(pointer)

func hash_reserve(value: native_mut_ptr[u8], key_size: u64, key_alignment: u64, value_size: u64, value_alignment: u64, minimum_capacity: u64):
    let pointer: native_mut_ptr[HashHeader] = native.rebind(value)
    grow_hash(pointer, key_size, key_alignment, value_size, value_alignment, minimum_capacity)

# mark: Class identities and weak references ==================================================

# Strong and weak handles share one control block. The implicit weak count
# keeps this header alive through final destruction; explicit weak references
# keep it alive afterward so promotion can deterministically observe death.
struct ClassHeader:
    var strong_references: u64
    var weak_references: u64
    var is_alive: bool
    var is_initialized: bool
    let payload: native_mut_ptr[u8]
    let payload_size: u64
    let payload_alignment: u64
    let destroy: func(native_mut_ptr[u8], bool) -> unit

func class_create(payload_size: u64, payload_alignment: u64, destroy: func(native_mut_ptr[u8], bool) -> unit) -> native_mut_ptr[u8]:
    var payload = native.allocate[u8](0u64)
    if payload_size > 0u64:
        payload = allocate_storage(payload_size, payload_alignment)
        var offset = 0u64
        while offset < payload_size:
            native.store(native.advance(payload, offset), 0u8)
            offset += 1u64
    let pointer = native.allocate[ClassHeader](1u64)
    native.store(pointer, ClassHeader(
        strong_references = 1u64,
        weak_references = 1u64,
        is_alive = true,
        is_initialized = false,
        payload = payload,
        payload_size = payload_size,
        payload_alignment = payload_alignment,
        destroy = destroy,
    ))
    return native.rebind(pointer)

func class_mark_initialized(value: native_mut_ptr[u8]):
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.is_initialized = true
    native.store(pointer, header)

func class_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.strong_references += 1u64
    native.store(pointer, header)

func class_release(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.strong_references -= 1u64
    if header.strong_references > 0u64:
        native.store(pointer, header)
        return

    # Weak reads become `none` before user code can observe deinitialization.
    header.is_alive = false
    native.store(pointer, header)
    header.destroy(value, header.is_initialized)
    if header.payload_size > 0u64:
        deallocate_storage(header.payload, header.payload_size, header.payload_alignment)

    # A weak field released by the destroyer may have changed this count.
    header = native.load(pointer)
    header.weak_references -= 1u64
    if header.weak_references > 0u64:
        native.store(pointer, header)
    else:
        native.deallocate(pointer, 1u64)

func class_payload(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    return native.load(pointer).payload

func weak_class_create(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.weak_references += 1u64
    native.store(pointer, header)
    return value

func weak_class_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.weak_references += 1u64
    native.store(pointer, header)

func weak_class_release(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.weak_references -= 1u64
    if header.weak_references > 0u64:
        native.store(pointer, header)
    else:
        native.deallocate(pointer, 1u64)

func weak_class_promote(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    if native.is_null(value): return native.allocate[u8](0u64)
    let pointer: native_mut_ptr[ClassHeader] = native.rebind(value)
    var header = native.load(pointer)
    if not header.is_alive: return native.allocate[u8](0u64)
    header.strong_references += 1u64
    native.store(pointer, header)
    return value

# mark: Interface values ======================================================================

# Existential storage owns one copied concrete value and the exact callbacks
# needed to copy or destroy that erased payload. Witness entries are opaque
# backend code descriptors; only the backend interprets a selected entry.
struct InterfaceHeader:
    var references: u64
    let payload: native_mut_ptr[u8]
    let payload_size: u64
    let payload_alignment: u64
    let retain_payload: func(native_mut_ptr[u8]) -> unit
    let release_payload: func(native_mut_ptr[u8]) -> unit
    let witnesses: native_ptr[native_ptr[u8]]

func interface_create(source: native_ptr[u8], payload_size: u64, payload_alignment: u64, retain_payload: func(native_mut_ptr[u8]) -> unit, release_payload: func(native_mut_ptr[u8]) -> unit, witnesses: native_ptr[native_ptr[u8]]) -> native_mut_ptr[u8]:
    var payload = native.allocate[u8](0u64)
    if payload_size > 0u64:
        payload = allocate_storage(payload_size, payload_alignment)
        native.move(payload, source, payload_size)
    let pointer = native.allocate[InterfaceHeader](1u64)
    native.store(pointer, InterfaceHeader(
        references = 1u64,
        payload = payload,
        payload_size = payload_size,
        payload_alignment = payload_alignment,
        retain_payload = retain_payload,
        release_payload = release_payload,
        witnesses = witnesses,
    ))
    return native.rebind(pointer)

func interface_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[InterfaceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func interface_release(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[InterfaceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    header.release_payload(header.payload)
    if header.payload_size > 0u64:
        deallocate_storage(header.payload, header.payload_size, header.payload_alignment)
    native.deallocate(pointer, 1u64)

func interface_detach(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[InterfaceHeader] = native.rebind(value)
    var header = native.load(pointer)
    if header.references == 1u64: return value
    header.references -= 1u64
    native.store(pointer, header)

    var payload = native.allocate[u8](0u64)
    if header.payload_size > 0u64:
        payload = allocate_storage(header.payload_size, header.payload_alignment)
        native.move(payload, header.payload, header.payload_size)
    header.retain_payload(payload)
    let detached = native.allocate[InterfaceHeader](1u64)
    native.store(detached, InterfaceHeader(
        references = 1u64,
        payload = payload,
        payload_size = header.payload_size,
        payload_alignment = header.payload_alignment,
        retain_payload = header.retain_payload,
        release_payload = header.release_payload,
        witnesses = header.witnesses,
    ))
    return native.rebind(detached)

func interface_payload(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[InterfaceHeader] = native.rebind(value)
    return native.load(pointer).payload

func interface_witness(value: native_mut_ptr[u8], requirement: u64) -> native_ptr[u8]:
    let pointer: native_mut_ptr[InterfaceHeader] = native.rebind(value)
    let witnesses = native.load(pointer).witnesses
    return native.load(native.advance(witnesses, requirement))

# mark: Lists and immutable slices =============================================================

# List identities and immutable slices retain a separately counted buffer.
# A list mutates a buffer only while it is the sole owner; otherwise it copies
# the live prefix and invokes the compiler-generated structural retain action
# once per copied element. The matching release action is called exactly once
# before the last buffer owner reclaims that element's storage.
struct ListBuffer:
    var references: u64
    var data: native_mut_ptr[u8]
    var length: u64
    var capacity: u64

struct ListHeader:
    var references: u64
    var buffer: native_mut_ptr[ListBuffer]
    var active_iterations: u64

# Immutable string and byte values own one compact allocation record. Their data never
# moves, so every escaping slice can keep it alive by retaining only this
# opaque record rather than copying bytes or exposing allocation policy.
struct ImmutableBuffer:
    var references: u64
    let data: native_mut_ptr[u8]
    let length: u64

struct SliceHeader:
    var references: u64
    let owner: native_mut_ptr[u8]
    let release_owner: func(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit
    let data: native_mut_ptr[u8]
    let length: u64

func create_list_buffer() -> native_mut_ptr[ListBuffer]:
    let buffer = native.allocate[ListBuffer](1u64)
    let empty = native.allocate[u8](0u64)
    native.store(buffer, ListBuffer(references = 1u64, data = empty, length = 0u64, capacity = 0u64))
    return buffer

func retain_list_buffer(pointer: native_mut_ptr[ListBuffer]):
    var buffer = native.load(pointer)
    buffer.references += 1u64
    native.store(pointer, buffer)

func release_list_buffer(pointer: native_mut_ptr[ListBuffer], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    var buffer = native.load(pointer)
    buffer.references -= 1u64
    if buffer.references > 0u64:
        native.store(pointer, buffer)
        return

    var remaining = buffer.length
    while remaining > 0u64:
        remaining -= 1u64
        release_element(native.advance(buffer.data, remaining * element_size))
    if buffer.capacity > 0u64:
        deallocate_storage(buffer.data, buffer.capacity * element_size, element_alignment)
    native.deallocate(pointer, 1u64)

func retain_elements(buffer: ListBuffer, element_size: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    var index = 0u64
    while index < buffer.length:
        retain_element(native.advance(buffer.data, index * element_size))
        index += 1u64

func grow_list_buffer(pointer: native_mut_ptr[ListBuffer], element_size: u64, element_alignment: u64, minimum_capacity: u64):
    var buffer = native.load(pointer)
    if buffer.capacity >= minimum_capacity: return

    var capacity = buffer.capacity
    if capacity == 0u64: capacity = 4u64
    while capacity < minimum_capacity:
        if capacity > 4611686018427387903u64: capacity = minimum_capacity
        else: capacity *= 2u64

    let data = allocate_storage(capacity * element_size, element_alignment)
    if buffer.length > 0u64:
        native.move(data, buffer.data, buffer.length * element_size)
    if buffer.capacity > 0u64:
        deallocate_storage(buffer.data, buffer.capacity * element_size, element_alignment)
    buffer.data = data
    buffer.capacity = capacity
    native.store(pointer, buffer)

func list_create() -> native_mut_ptr[u8]:
    let header = native.allocate[ListHeader](1u64)
    native.store(header, ListHeader(references = 1u64, buffer = create_list_buffer(), active_iterations = 0u64))
    return native.rebind(header)

func list_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func list_release(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    release_list_buffer(header.buffer, element_size, element_alignment, release_element)
    native.deallocate(pointer, 1u64)

func list_length(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(native.load(pointer).buffer).length

# Active traversal belongs to the list identity, so every alias observes the
# same shape-mutation barrier. Begin returns the captured length atomically.
func list_iteration_begin(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations += 1u64
    native.store(pointer, header)
    return native.load(header.buffer).length

func list_iteration_end(value: native_mut_ptr[u8]):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.active_iterations -= 1u64
    native.store(pointer, header)

func list_iteration_active(value: native_mut_ptr[u8]) -> bool:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return native.load(pointer).active_iterations > 0u64

# Return a unique buffer for a write. A shared snapshot keeps the old buffer;
# the list's copied representation becomes an additional element owner.
func detach_list(pointer: native_mut_ptr[ListHeader], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[ListBuffer]:
    var header = native.load(pointer)
    var source = native.load(header.buffer)
    if source.references == 1u64: return header.buffer

    let copied_pointer = create_list_buffer()
    grow_list_buffer(copied_pointer, element_size, element_alignment, source.capacity)
    var copied = native.load(copied_pointer)
    if source.length > 0u64:
        native.move(copied.data, source.data, source.length * element_size)
    copied.length = source.length
    native.store(copied_pointer, copied)
    retain_elements(copied, element_size, retain_element)

    source.references -= 1u64
    native.store(header.buffer, source)
    header.buffer = copied_pointer
    native.store(pointer, header)
    return copied_pointer

# Explicit list copy and concatenation own their copied element representations
# independently, while reference elements continue to name the same identity.
func list_copy(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let source_pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let source = native.load(native.load(source_pointer).buffer)
    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    let result_buffer = native.load(result_pointer).buffer
    grow_list_buffer(result_buffer, element_size, element_alignment, source.length)
    var copied = native.load(result_buffer)
    if source.length > 0u64:
        native.move(copied.data, source.data, source.length * element_size)
    copied.length = source.length
    native.store(result_buffer, copied)
    retain_elements(copied, element_size, retain_element)
    return result

func list_concat(left_value: native_mut_ptr[u8], right_value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let left_pointer: native_mut_ptr[ListHeader] = native.rebind(left_value)
    let right_pointer: native_mut_ptr[ListHeader] = native.rebind(right_value)
    let left = native.load(native.load(left_pointer).buffer)
    let right = native.load(native.load(right_pointer).buffer)
    let total_length = left.length + right.length

    let result = list_create()
    let result_pointer: native_mut_ptr[ListHeader] = native.rebind(result)
    let result_buffer = native.load(result_pointer).buffer
    grow_list_buffer(result_buffer, element_size, element_alignment, total_length)
    var joined = native.load(result_buffer)
    if left.length > 0u64:
        native.move(joined.data, left.data, left.length * element_size)
    if right.length > 0u64:
        native.move(native.advance(joined.data, left.length * element_size), right.data, right.length * element_size)
    joined.length = total_length
    native.store(result_buffer, joined)
    retain_elements(joined, element_size, retain_element)
    return result

func open_list_slot(header_pointer: native_mut_ptr[ListHeader], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let buffer_pointer = detach_list(header_pointer, element_size, element_alignment, retain_element)
    var buffer = native.load(buffer_pointer)
    grow_list_buffer(buffer_pointer, element_size, element_alignment, buffer.length + 1u64)
    buffer = native.load(buffer_pointer)
    let slot = native.advance(buffer.data, index * element_size)
    if index < buffer.length:
        native.move(native.advance(slot, element_size), slot, (buffer.length - index) * element_size)
    buffer.length += 1u64
    native.store(buffer_pointer, buffer)
    return slot

func list_insert_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    return open_list_slot(pointer, element_size, element_alignment, index, retain_element)

func list_append_slot(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let length = native.load(native.load(pointer).buffer).length
    return open_list_slot(pointer, element_size, element_alignment, length, retain_element)

# The lowerer copies the removed element out before this operation. Detachment
# retains a second representation first, so removing from the new buffer
# transfers precisely that ownership to the result.
func list_remove_at(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer_pointer = detach_list(pointer, element_size, element_alignment, retain_element)
    var buffer = native.load(buffer_pointer)
    let tail = buffer.length - index - 1u64
    if tail > 0u64:
        let destination = native.advance(buffer.data, index * element_size)
        native.move(destination, native.advance(destination, element_size), tail * element_size)
    buffer.length -= 1u64
    native.store(buffer_pointer, buffer)

func list_clear(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    var header = native.load(pointer)
    var buffer = native.load(header.buffer)
    if buffer.references > 1u64:
        buffer.references -= 1u64
        native.store(header.buffer, buffer)
        header.buffer = create_list_buffer()
        native.store(pointer, header)
        return

    var remaining = buffer.length
    while remaining > 0u64:
        remaining -= 1u64
        release_element(native.advance(buffer.data, remaining * element_size))
    buffer.length = 0u64
    native.store(header.buffer, buffer)

func list_reserve(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, minimum_capacity: u64, retain_element: func(native_mut_ptr[u8]) -> unit):
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    if native.load(native.load(pointer).buffer).capacity >= minimum_capacity: return
    let buffer = detach_list(pointer, element_size, element_alignment, retain_element)
    grow_list_buffer(buffer, element_size, element_alignment, minimum_capacity)

# Bounds remain canonical; private address services receive only checked indices.
func list_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer = native.load(native.load(pointer).buffer)
    return native.advance(buffer.data, index * element_size)

func list_mutable_element_address(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, index: u64, retain_element: func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer_pointer = detach_list(pointer, element_size, element_alignment, retain_element)
    return native.advance(native.load(buffer_pointer).data, index * element_size)

# mark: Immutable buffer storage ===============================================================

func buffer_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ImmutableBuffer] = native.rebind(value)
    var buffer = native.load(pointer)
    buffer.references += 1u64
    native.store(pointer, buffer)

func buffer_release(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[ImmutableBuffer] = native.rebind(value)
    var buffer = native.load(pointer)
    buffer.references -= 1u64
    if buffer.references > 0u64:
        native.store(pointer, buffer)
        return
    if buffer.length > 0u64: deallocate_storage(buffer.data, buffer.length, 1u64)
    native.deallocate(pointer, 1u64)

func buffer_concat(left_data: native_mut_ptr[u8], left_length: u64, right_data: native_mut_ptr[u8], right_length: u64) -> native_mut_ptr[u8]:
    let total_length = left_length + right_length
    var data = native.allocate[u8](0u64)
    if total_length > 0u64:
        data = allocate_storage(total_length, 1u64)
        if left_length > 0u64: native.move(data, left_data, left_length)
        if right_length > 0u64: native.move(native.advance(data, left_length), right_data, right_length)
    let buffer = native.allocate[ImmutableBuffer](1u64)
    native.store(buffer, ImmutableBuffer(references = 1u64, data = data, length = total_length))
    return native.rebind(buffer)

func buffer_data(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ImmutableBuffer] = native.rebind(value)
    return native.load(pointer).data

# Decode one scalar from compiler-verified UTF-8. String construction and MIR
# traversal establish the valid-data and in-bounds preconditions; repeating
# those checks in this private hot path would duplicate language validation.
# The low 32 bits contain the scalar value and the high 32 bits its byte width;
# this packing is private to the runtime/backend ABI and never enters MIR.
func string_decode(data: native_mut_ptr[u8], length: u64, offset: u64) -> u64:
    let first = u64(native.load(native.advance(data, offset)))
    if first < 128u64: return first | (1u64 << 32u64)

    var width = 4u64
    var scalar = first & 7u64
    if first <= 223u64:
        width = 2u64
        scalar = first & 31u64
    elif first <= 239u64:
        width = 3u64
        scalar = first & 15u64

    var index = 1u64
    while index < width:
        let continuation = u64(native.load(native.advance(data, offset + index)))
        scalar = (scalar << 6u64) | (continuation & 63u64)
        index += 1u64
    return scalar | (width << 32u64)

func string_scalar_count(data: native_mut_ptr[u8], length: u64) -> u64:
    var count = 0u64
    var offset = 0u64
    while offset < length:
        offset += string_decode(data, length, offset) >> 32u64
        count += 1u64
    return count

# Slice ownership is deliberately callback-driven. The common slice header
# knows only its stable data address and how to release its opaque owner;
# list element layout and byte-buffer representation remain private here.
func release_list_slice_owner(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    let buffer: native_mut_ptr[ListBuffer] = native.rebind(value)
    release_list_buffer(buffer, element_size, element_alignment, release_element)

func release_bytes_slice_owner(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    buffer_release(value)

func list_slice(value: native_mut_ptr[u8], element_size: u64, start: u64, end: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[ListHeader] = native.rebind(value)
    let buffer_pointer = native.load(pointer).buffer
    let buffer = native.load(buffer_pointer)
    retain_list_buffer(buffer_pointer)
    let view = native.allocate[SliceHeader](1u64)
    native.store(view, SliceHeader(
        references = 1u64,
        owner = native.rebind(buffer_pointer),
        release_owner = release_list_slice_owner,
        data = native.advance(buffer.data, start * element_size),
        length = end - start,
    ))
    return native.rebind(view)

func bytes_slice(owner: native_mut_ptr[u8], data: native_mut_ptr[u8], start: u64, end: u64) -> native_mut_ptr[u8]:
    buffer_retain(owner)
    let view = native.allocate[SliceHeader](1u64)
    native.store(view, SliceHeader(
        references = 1u64,
        owner = owner,
        release_owner = release_bytes_slice_owner,
        data = native.advance(data, start),
        length = end - start,
    ))
    return native.rebind(view)

func slice_retain(value: native_mut_ptr[u8]):
    if native.is_null(value): return
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references += 1u64
    native.store(pointer, header)

func slice_release(value: native_mut_ptr[u8], element_size: u64, element_alignment: u64, release_element: func(native_mut_ptr[u8]) -> unit):
    if native.is_null(value): return
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    var header = native.load(pointer)
    header.references -= 1u64
    if header.references > 0u64:
        native.store(pointer, header)
        return
    header.release_owner(header.owner, element_size, element_alignment, release_element)
    native.deallocate(pointer, 1u64)

func slice_length(value: native_mut_ptr[u8]) -> u64:
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    return native.load(pointer).length

func slice_element_address(value: native_mut_ptr[u8], element_size: u64, index: u64) -> native_mut_ptr[u8]:
    let pointer: native_mut_ptr[SliceHeader] = native.rebind(value)
    let header = native.load(pointer)
    return native.advance(header.data, index * element_size)
