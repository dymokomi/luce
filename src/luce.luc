#==============================================================================================
#
#   luce - The luce command line
#
#   DESCRIPTION:
#       Command line front-end for the compiler. Reads the arguments, calls the
#       matching function in compiler.pipeline and prints the result. All the
#       language logic lives under compiler/
#
#   COMMANDS:
#       luce build [--target TARGET] OUTPUT FILE...
#       luce check FILE...
#       luce run MODULE.FUNCTION FILE...
#       luce --version
#
#   TARGETS:
#       wasm            WebAssembly module (default)
#       arm64-macos     macOS executable (Mach-O, ad-hoc signed)
#       x86_64-linux    Linux executable (ELF)
#
#   EXIT STATUS:
#       0   ok
#       1   compile error or host tool failed
#       2   bad command line
#
#==============================================================================================

from compiler.backends.interpreter import format_value
from compiler.pipeline import build, build_arm64_macos, build_x86_64_linux, check, run
import std.files
import std.os
import std.strings

pub const version = "0.2"

# mark: Main ==================================================================================

# Program entry point
pub func main(args: list[str]):
    if len(args) == 0: usage("")

    let arguments = args[1:]
    match args[0]:
        "--version", "-v":
            print(f"Luce v{version}")

        "check":
            if len(arguments) == 0: usage("check: expected at least one FILE")
            check(arguments) catch reason:
                fail(reason)
            print(f"checked {len(arguments)} file(s)")

        "run":
            if len(arguments) < 2: usage("run: expected MODULE.FUNCTION and at least one FILE")
            let entry = strings.split(arguments[0], ".")

            if len(entry) != 2: usage("run: entry must be MODULE.FUNCTION")
            let value = run(arguments[1:], entry[0], entry[1]) catch reason:
                print(reason)
                exit(1)

            print(format_value(value))

        "build":
            var target = "wasm"
            var rest = arguments
            if len(rest) >= 2 and rest[0] == "--target":
                target = rest[1]
                rest = rest[2:]

            if len(rest) < 2: usage("build: expected OUTPUT and at least one FILE")
            build_target(target, rest[0], rest[1:]) catch reason:
                fail(reason)
            print("built " + rest[0])

        else:
            usage("unknown command " + args[0])

# mark: Build =================================================================================

# Compile source files for a target and write the result to output
func build_target(target: str, output: str, sources: list[str]) -> !:
    let artifact = try compile(target, sources)
    try files.write_bytes(output, artifact)

    # Native executables need a bit of help from the host before they run
    # NOTE: macOS refuses to run unsigned arm64 binaries, Linux just needs +x
    let path = shell_quote(local_path(output))
    if target == "arm64-macos": try host("/usr/bin/codesign --force --sign - -- " + path)
    if target == "arm64-macos" or target == "x86_64-linux": try host("/bin/chmod +x " + path)

# Compile source files for a target, returns the raw artifact bytes
func compile(target: str, sources: list[str]) -> list[u8]!:
    match target:
        "wasm":         return try build(sources)
        "arm64-macos":  return try build_arm64_macos(sources)
        "x86_64-linux": return try build_x86_64_linux(sources)
        else:           error("luce build: unknown target `" + target + "`")

# mark: Host ==================================================================================

# Run a shell command, fail if it exits non-zero
func host(line: str) -> !:
    let process = try os.Process(line)
    let status = try process.wait()
    if status != 0: error("luce build: `" + line + "` exited with status " + str(status))

# Add ./ in front of paths starting with '-' so tools don't take them as options
func local_path(path: str) -> str:
    if len(path) > 0 and path[0] == '-': return "./" + path
    return path

# Single-quote a string for the shell
func shell_quote(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

# Print an error and exit with status 1
func fail(reason: str):
    print(reason)
    exit(1)

# Print an error (if any) plus usage and exit with status 2
func usage(message: str):
    if len(message) > 0: print("luce: " + message)
    print("usage:")
    print("  luce build [--target wasm|arm64-macos|x86_64-linux] OUTPUT FILE...")
    print("  luce check FILE...")
    print("  luce run MODULE.FUNCTION FILE...")
    print("  luce --version")
    exit(2)
