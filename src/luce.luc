from tokenizer import Tokenizer
from utils.args import CmdParser

func main(args: list[str]) -> !:
    
    var parser = CmdParser(prog = "luce")
    parser.flag("--release")

    
    parser.flag("--help")
    parser.synonym("-h", "--help")
    parser.option("-o")
    parser.option("--emit")

    let parsed = try parser.parse(args)

    if parsed.has("--help") or parsed.count() == 0:
        print_usage()
        exit(0)

    let command = parsed.positional(0) else ""
    print("command: " + command)

    if parsed.has("--release"):
        print("release: on")

    let out = parsed.value("-o")
    if out != none:
        print("output: " + out)

    let emit = parsed.value("--emit")
    if emit != none:
        print("emit: " + emit)

    var index = 1
    while index < parsed.count():
        let input = parsed.positional(index) else ""
        print("input: " + input)
        index += 1

    let tokenizer = Tokenizer()
    exit(0)

func print_usage():
    print("usage: luce COMMAND [options] [inputs]")
    print("  commands: build, check, run, test")
    print("  options:")
    print("    -o OUT         write output to OUT")
    print("    --emit=WHAT    exe | library | object")
    print("    --release      optimized build")
    print("    -h, --help     show this help")
