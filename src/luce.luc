from compiler.compiler import Compiler
from utils.args import Cli
import std.os
const version = "0.2"

func main(args: list[str]) -> !:

    var cli = Cli(name = "luce")
    cli.root().flag("--version").synonym("-v", "--version")
    cli.command("build")

    # Invalid options
    let run = cli.parse(args) catch reason:
        print(reason)
        print_usage()
        exit(2)

    # Commnds
    if run.command == "":
        
        if run.has("--version"):
            print(f"Luce v{version}")
        else:
            print_usage()

    elif run.command == "build":
        if len(run.inputs) == 0:
            print("luce build: no input files")
            exit(2)
        let compiler = Compiler()
        let started = os.clock_ms()
        compiler.compile(run.inputs) catch reason:
            print(reason)
            exit(1)
        let elapsed = os.clock_ms() - started
        let count = len(run.inputs)
        print(f"compiled {count} file(s) in {elapsed} ms")
    else:
        print_usage()

    exit(0)

func print_usage():
    print("usage: luce COMMAND [options] [inputs]")
    print("  commands: build")
    print("  global: --version, -v")
