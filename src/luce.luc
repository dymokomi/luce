from compiler.pipeline import compile

const version = "0.2"

func main(args: list[str]):
    if len(args) == 0:
        print_usage()
        return

    match args[0]:
        "--version", "-v":  print(f"Luce v{version}")
        "check":            check_sources(args[1:len(args)])
        else:
            print("luce: unknown command " + args[0])
            print_usage()
            exit(2)

private func check_sources(paths: list[str]):
    if len(paths) == 0:
        print("luce check: no input files")
        exit(2)

    compile(paths) catch reason:
        print(reason)
        exit(1)
    print(f"checked {len(paths)} file(s)")

private func print_usage():
    print("usage: luce COMMAND [inputs]")
    print("  commands: check")
    print("  global: --version, -v")
