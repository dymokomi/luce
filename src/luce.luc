#**********************************************************************************************
#
#   luce - The luce command line
#
#   DESCRIPTION:
#       Command line front-end for the compiler. Every command reads its
#       arguments, calls the matching function in compiler.pipeline and prints
#       the result. All the language logic lives under compiler/
#
#   COMMANDS:
#       luce build [--target TARGET] OUTPUT FILE...
#       luce check FILE...
#       luce run MODULE.FUNCTION FILE...
#       luce --version
#
#   TARGETS:
#       wasm            WebAssembly module (default)
#       arm64-macos     macOS executable (Mach-O, ad-hoc signed)
#       x86_64-linux    Linux executable (ELF)
#
#   EXIT STATUS:
#       0   ok
#       1   compile error or host tool failed
#       2   bad command line
#
#**********************************************************************************************

from compiler.backends.interpreter import format_value
from compiler.pipeline import build, build_arm64_macos, build_x86_64_linux, check, run
import std.files
import std.os
import std.strings

pub const version = "0.2"

# mark: Entry point

# Program entry point
# NOTE: Commands never call exit() on failure, they just return the error;
# this is the one place that turns it into an exit status
pub func main(args: list[str]):
    if len(args) == 0: usage_error("")

    dispatch(args[0], args[1:]) catch reason:
        print(reason)
        exit(1)

# Run the command with the given name
func dispatch(command: str, arguments: list[str]) -> !:
    match command:
        "build":            try build_command(arguments)
        "check":            try check_command(arguments)
        "run":              try run_command(arguments)
        "--version", "-v":  version_command()
        else:               usage_error("unknown command " + command)

# mark: build

# Build source files into an output file for the selected target
func build_command(arguments: list[str]) -> !:
    var target = "wasm"
    let positional = list[str]()

    var index = 0
    while index < len(arguments):
        if arguments[index] == "--target":
            if index + 1 >= len(arguments): usage_error("build: --target needs a value")
            target = arguments[index + 1]
            index += 2
        else:
            positional.append(arguments[index])
            index += 1
    if len(positional) < 2: usage_error("build: expected OUTPUT and at least one FILE")

    let output_path = positional[0]
    let source_paths = positional[1:]

    let artifact = try compile_for_target(target, source_paths)
    try files.write_bytes(output_path, artifact)
    try finish_for_target(target, output_path)
    print("built " + output_path)

# mark: check

# Check source files without building anything
func check_command(paths: list[str]) -> !:
    if len(paths) == 0: usage_error("check: expected at least one FILE")

    try check(paths)
    print(f"checked {len(paths)} file(s)")

# mark: run

# Run one function from the source files in the interpreter and print its result
func run_command(arguments: list[str]) -> !:
    if len(arguments) < 2: usage_error("run: expected MODULE.FUNCTION and at least one FILE")

    let entry = strings.split(arguments[0], ".")
    if len(entry) != 2: usage_error("run: entry must be MODULE.FUNCTION")

    let value = try run(arguments[1:], entry[0], entry[1])
    print(format_value(value))

# mark: version

# Print version
func version_command():
    print(f"Luce v{version}")

# mark: Targets

# Compile source files for a target, returns the raw artifact bytes
# NOTE: The compiler only produces bytes, it never touches the file system or
# host tools, so anything a target needs after writing goes in finish_for_target()
func compile_for_target(target: str, source_paths: list[str]) -> list[u8]!:
    match target:
        "wasm":         return try build(source_paths)
        "arm64-macos":  return try build_arm64_macos(source_paths)
        "x86_64-linux": return try build_x86_64_linux(source_paths)
        else:           error("luce build: unknown target `" + target + "`")

# Post-process a written artifact so the host can use it
func finish_for_target(target: str, path: str) -> !:
    match target:
        "arm64-macos":  try sign_and_mark_executable(path)
        "x86_64-linux": try mark_executable(path)
        else:           return

# Ad-hoc sign a Mach-O executable and make it executable
# NOTE: macOS refuses to run unsigned arm64 binaries, codesign ships with the system
func sign_and_mark_executable(path: str) -> !:
    let argument = shell_argument(local_path(path))
    try run_host_tool("/usr/bin/codesign --force --sign - -- " + argument, "codesign")
    try run_host_tool("/bin/chmod +x " + argument, "chmod")

# Make an ELF executable, no signing needed on Linux
func mark_executable(path: str) -> !:
    try run_host_tool("/bin/chmod +x " + shell_argument(local_path(path)), "chmod")

# mark: Host tools

# Run a shell command, fail if it exits non-zero
func run_host_tool(command: str, name: str) -> !:
    let process = try os.Process(command)
    let status = try process.wait()
    if status != 0: error("luce build: " + name + " failed with exit status " + str(status))

# Add ./ in front of paths starting with '-' so tools don't take them as options
func local_path(path: str) -> str:
    if len(path) > 0 and path[0] == '-': return "./" + path
    return path

# Single-quote a string for the shell
func shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

# mark: Usage

# Print an error (if any) plus usage and exit with status 2
func usage_error(message: str):
    if len(message) > 0: print("luce: " + message)
    print("usage:")
    print("  luce build [--target wasm|arm64-macos|x86_64-linux] OUTPUT FILE...")
    print("  luce check FILE...")
    print("  luce run MODULE.FUNCTION FILE...")
    print("  luce --version")
    exit(2)
