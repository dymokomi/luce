from compiler.backends.interpreter import format_value
from compiler.pipeline import build, build_arm64_macos, build_x86_64_linux, check, run
import std.files
import std.os
import std.strings

# The luce command line. Each command hands its inputs to one pipeline entry
# point and renders the outcome; nothing here understands the language.

pub const version = "0.2"

pub func main(args: list[str]):
    if len(args) == 0:
        print_usage()
        return

    match args[0]:
        "--version", "-v":  print(f"Luce v{version}")
        "build":            build_sources(args[1:])
        "check":            check_sources(args[1:])
        "run":              run_sources(args[1:])
        else:
            print("luce: unknown command " + args[0])
            print_usage()
            exit(2)

func build_sources(arguments: list[str]):
    var target = "wasm"
    var output_index = 0
    if len(arguments) > 0 and arguments[0] == "--target":
        if len(arguments) < 4:
            print("luce build: expected TARGET, output path, and at least one input file")
            exit(2)
        target = arguments[1]
        output_index = 2
    elif len(arguments) < 2:
        print("luce build: expected an output path and at least one input file")
        exit(2)

    let artifact = compile_target(target, arguments[output_index + 1:]) catch reason:
        print(reason)
        exit(1)
    let output_path = arguments[output_index]
    files.write_bytes(output_path, artifact) catch reason:
        print(reason)
        exit(1)
    if target == "arm64-macos":
        finalize_arm64_macos(output_path) catch reason:
            print(reason)
            exit(1)
    elif target == "x86_64-linux":
        finalize_x86_64_linux(output_path) catch reason:
            print(reason)
            exit(1)
    print("built " + output_path)

func compile_target(target: str, source_paths: list[str]) -> list[u8]!:
    match target:
        "wasm": return try build(source_paths)
        "arm64-macos": return try build_arm64_macos(source_paths)
        "x86_64-linux": return try build_x86_64_linux(source_paths)
        else: error("luce build: unknown target `" + target + "`")

# Mach-O code signing and executable permissions belong to the host artifact,
# not its byte encoder. Both tools are fixed parts of macOS and run only for an
# explicitly selected macOS target.
func finalize_arm64_macos(path: str) -> !:
    var command_path = path
    if len(path) > 0 and path[0] == '-': command_path = "./" + path
    let argument = shell_argument(command_path)
    try run_host_tool("/usr/bin/codesign --force --sign - -- " + argument, "codesign")
    try run_host_tool("/bin/chmod +x " + argument, "chmod")

# An ELF executable needs no signature or loader fix-up on Linux; it only has
# to be marked runnable, and chmod is a fixed part of every Linux userland.
func finalize_x86_64_linux(path: str) -> !:
    var command_path = path
    if len(path) > 0 and path[0] == '-': command_path = "./" + path
    try run_host_tool("/bin/chmod +x " + shell_argument(command_path), "chmod")

func run_host_tool(command: str, name: str) -> !:
    let process = try os.Process(command)
    let status = try process.wait()
    if status != 0: error("luce build: " + name + " failed with exit status " + str(status))

func shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

func check_sources(paths: list[str]):
    if len(paths) == 0:
        print("luce check: no input files")
        exit(2)

    check(paths) catch reason:
        print(reason)
        exit(1)
    print(f"checked {len(paths)} file(s)")

func run_sources(arguments: list[str]):
    if len(arguments) < 2:
        print("luce run: expected MODULE.FUNCTION and at least one input file")
        exit(2)
    let target = strings.split(arguments[0], ".")
    if len(target) != 2:
        print("luce run: target must be MODULE.FUNCTION")
        exit(2)

    let value = run(arguments[1:], target[0], target[1]) catch reason:
        print(reason)
        exit(1)
    print(format_value(value))

func print_usage():
    print("usage:")
    print("  luce build [--target wasm|arm64-macos|x86_64-linux] OUTPUT FILE...")
    print("  luce check FILE...")
    print("  luce run MODULE.FUNCTION FILE...")
    print("  luce --version")
