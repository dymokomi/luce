#==============================================================================================
#
#   luce - The luce command line
#
#   DESCRIPTION:
#       Command line front-end for the compiler. Reads the arguments, calls the
#       matching function in compiler.pipeline and prints the result. All the
#       language logic lives under compiler/
#
#   COMMANDS:
#       luce build [--target TARGET] OUTPUT FILE...
#       luce check FILE...
#       luce run MODULE.FUNCTION FILE...
#       luce --version
#
#   TARGETS:
#       wasm            WebAssembly module (default)
#       arm64-macos     macOS executable (Mach-O, ad-hoc signed)
#       x86_64-linux    Linux executable (ELF)
#
#   EXIT STATUS:
#       0   ok
#       1   command failed
#       2   bad command line
#
#==============================================================================================

from compiler.pipeline import BuildTarget, build, check, run
import std.files
import std.os
import std.strings

## Current Luce command-line version.
pub let version = "1.0.0"

# mark: Main ==================================================================================

## Run the Luce command-line front end.
pub func main(args: list[str]):
    if len(args) == 0: exit_with_usage("")

    let arguments = args[1:]
    match args[0]:
        "--version", "-v":
            print(f"Luce v{version}")

        "check":
            if len(arguments) == 0:
                exit_with_usage("check: expected at least one FILE")
            discard(check(arguments)) catch reason:
                exit_with_error(reason)
            print(f"checked {len(arguments)} file(s)")

        "run":
            if len(arguments) < 2:
                exit_with_usage("run: expected MODULE.FUNCTION and at least one FILE")
            let entry = strings.split(arguments[0], ".")

            if len(entry) != 2:
                exit_with_usage("run: entry must be MODULE.FUNCTION")
            run_entry(entry[0], entry[1], arguments[1:]) catch reason:
                exit_with_error(reason)

        "build":
            var target = BuildTarget.wasm
            var rest = arguments
            if len(rest) >= 2 and rest[0] == "--target":
                match rest[1]:
                    "wasm":         target = BuildTarget.wasm
                    "arm64-macos":  target = BuildTarget.arm64_macos
                    "x86_64-linux": target = BuildTarget.x86_64_linux
                    else:           exit_with_usage("build: unknown target `" + rest[1] + "`")
                rest = rest[2:]

            if len(rest) < 2:
                exit_with_usage("build: expected OUTPUT and at least one FILE")
            build_target(target, rest[0], rest[1:]) catch reason:
                exit_with_error(reason)
            print("built " + rest[0])

        else:
            exit_with_usage("unknown command " + args[0])

# mark: Run ==================================================================================

# Interpret one entry function and print its value. Kept as a statement-form
# `catch` in `main`: Stage-0 miscompiles `let value = run(...) catch reason:
# exit(1)` into a silent trap, so the fallible call must not bind a value.
func run_entry(module_name: str, function_name: str, sources: list[str]) -> !:
    let value = try run(sources, module_name, function_name)
    print(value.render())

# mark: Build =================================================================================

# Compile source files for a target and write the result to output
func build_target(target: BuildTarget, output: str, sources: list[str]) -> !:
    let artifact = try build(target, sources)
    try files.write_bytes(output, artifact)

    # Native executables need a bit of help from the host before they run
    # NOTE: macOS refuses to run unsigned arm64 binaries, Linux just needs +x
    let path = quote_shell_argument(make_tool_path(output))
    match target:
        arm64_macos:
            try run_host_command("/usr/bin/codesign --force --sign - -- " + path)
            try run_host_command("/bin/chmod +x " + path)
        x86_64_linux:
            try run_host_command("/bin/chmod +x " + path)
        else:
            return

# mark: Host ==================================================================================

# Run a shell command, fail if it exits non-zero
func run_host_command(command: str) -> !:
    let process = try os.Process(command)
    let status = try process.wait()
    if status != 0: error("luce build: `" + command + "` exited with status " + str(status))

# Add ./ in front of paths starting with '-' so tools don't take them as options
func make_tool_path(path: str) -> str:
    if len(path) > 0 and path[0] == '-': return "./" + path
    return path

# Single-quote a string for the shell
func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

# mark: Exit ==================================================================================

# Print a diagnostic and exit with status 1. Pipeline diagnostics already
# carry `path:line:column:` or a stage prefix, so nothing is added here.
func exit_with_error(reason: str):
    print(reason)
    exit(1)

# Print an error (if any) plus usage and exit with status 2
func exit_with_usage(message: str):
    if len(message) > 0: print("luce: " + message)
    print("usage:")
    print("  luce build [--target wasm|arm64-macos|x86_64-linux] OUTPUT FILE...")
    print("  luce check FILE...")
    print("  luce run MODULE.FUNCTION FILE...")
    print("  luce --version")
    exit(2)
