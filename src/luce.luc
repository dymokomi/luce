#==============================================================================================
#
#   luce - The luce command line
#
#   DESCRIPTION:
#       Command line front-end for the compiler. Reads the arguments, calls the
#       matching function in compiler.pipeline and prints the result. All the
#       language logic lives under compiler/
#
#   COMMANDS:
#       luce build --package ID --root DIR [--generic-specializations N]
#                  [--time-report] [--target TARGET]
#                  [--c-header PATH] [--abi-report PATH]
#                  [--runtime-root DIR --runtime FILE]... OUTPUT FILE...
#       luce check --package ID --root DIR [--generic-specializations N] FILE...
#       luce run --package ID --root DIR [--generic-specializations N] MODULE.FUNCTION FILE...
#       luce explain --package ID --root DIR [--generic-specializations N] FILE...
#       luce --version
#
#   TARGETS:
#       wasm            WebAssembly module (default)
#       native          host executable through pinned QBE 1.3
#
#   EXIT STATUS:
#       0   ok
#       1   command failed
#       2   bad command line
#
#==============================================================================================

from compiler.pipeline import BuildOutputOptions, BuildTarget, CompilationOptions, PackageInput, build, build_with_runtime, check, explain, run
from compiler.frontend.source import Diagnostic
from compiler.reporting.generics import GenericReport
from compiler.runtime_package import sealed_runtime_package
import std.strings

## Current Luce command-line version.
pub let version: str = "1.0.0"

# mark: Main ==================================================================================

## Run the Luce command-line front end.
pub func main(args: list[str]):
    if len(args) == 0: exit_with_usage("")

    let arguments = args[1:]
    match args[0]:
        "--version", "-v":
            print(f"Luce v{version}")

        "check":
            let package = package_arguments("check", arguments, 1)
            check_entry(package.identity, package.source_root, package.options, package.rest) catch reason:
                exit_with_error(reason)
            print(f"checked {len(package.rest)} file(s)")

        "run":
            let package = package_arguments("run", arguments, 2)
            let entry = entry_argument(package.rest[0])
            run_entry(package.identity, package.source_root, package.options, entry.module_name, entry.function_name, package.rest[1:]) catch reason:
                exit_with_error(reason)

        "build":
            let package = package_arguments("build", arguments, 0)
            let options = build_arguments(package.rest)
            build_target(package.identity, package.source_root, package.options, options.target, options.runtime_root, options.runtime_sources, options.output, options.sources, options.time_report, options.c_header, options.abi_report) catch reason:
                exit_with_error(reason)
            print("built " + options.output)

        "explain":
            let package = package_arguments("explain", arguments, 1)
            explain_entry(package.identity, package.source_root, package.options, package.rest) catch reason:
                exit_with_error(reason)

        else:
            exit_with_usage("unknown command " + args[0])

# mark: Arguments =============================================================================

struct ParsedPackageArguments:
    let identity: str
    let source_root: str
    let options: CompilationOptions
    let rest: list[str]

struct ParsedBuildArguments:
    let target: BuildTarget
    let runtime_root: str?
    let runtime_sources: list[str]
    let time_report: bool
    let c_header: str?
    let abi_report: str?
    let output: str
    let sources: list[str]

struct ParsedEntryArgument:
    let module_name: str
    let function_name: str

func entry_argument(value: str) -> ParsedEntryArgument:
    let components = strings.split(value, ".")
    if len(components) < 2: exit_with_usage("run: entry must be MODULE.FUNCTION")
    var module_name = ""
    for index in range(0, len(components) - 1):
        if components[index] == "": exit_with_usage("run: entry must be MODULE.FUNCTION")
        if module_name != "": module_name += "."
        module_name += components[index]
    let function_name = components[len(components) - 1]
    if function_name == "": exit_with_usage("run: entry must be MODULE.FUNCTION")
    return ParsedEntryArgument(module_name = module_name, function_name = function_name)

# The raw compiler never guesses package identity from a directory or file
# name: identity is stable program data carried by ErrorCode.
func package_arguments(command: str, arguments: list[str], minimum_rest: i64) -> ParsedPackageArguments:
    if len(arguments) < 4 or arguments[0] != "--package" or len(arguments[1]) == 0:
        exit_with_usage(command + ": expected `--package ID --root DIR`")
    if arguments[2] != "--root" or len(arguments[3]) == 0:
        exit_with_usage(command + ": expected `--root DIR` after the package identity")
    var rest = arguments[4:]
    var generic_specialization_budget: i64 = 256
    var has_generic_specialization_budget = false
    while len(rest) > 0 and rest[0] == "--generic-specializations":
        if has_generic_specialization_budget:
            exit_with_usage(command + ": --generic-specializations may be supplied once")
        if len(rest) < 2:
            exit_with_usage(command + ": --generic-specializations expects a positive integer")
        let parsed_value = parse_i64(rest[1])
        if parsed_value == none:
            exit_with_usage(command + ": --generic-specializations expects a positive integer")
        let parsed = parsed_value else trap("validated generic specialization budget disappeared")
        if parsed <= 0:
            exit_with_usage(command + ": --generic-specializations expects a positive integer")
        generic_specialization_budget = parsed
        has_generic_specialization_budget = true
        rest = rest[2:]
    if len(rest) < minimum_rest:
        if command == "check": exit_with_usage("check: expected at least one FILE")
        if command == "run": exit_with_usage("run: expected MODULE.FUNCTION and at least one FILE")
        if command == "explain": exit_with_usage("explain: expected at least one FILE")
        exit_with_usage("build: expected OUTPUT and at least one FILE")
    return ParsedPackageArguments(
        identity = arguments[1],
        source_root = arguments[3],
        options = CompilationOptions(generic_specialization_budget = generic_specialization_budget),
        rest = rest,
    )

# Build options precede the output. A runtime source may be repeated because
# the reviewed sealed package can grow into multiple modules without changing
# compiler discovery policy or smuggling a checkout path into the binary.
func build_arguments(arguments: list[str]) -> ParsedBuildArguments:
    var target = BuildTarget.wasm
    var runtime_root: str? = none
    let runtime_sources = list[str]()
    var time_report = false
    var c_header: str? = none
    var abi_report: str? = none
    var rest = arguments
    while len(rest) > 0:
        if rest[0] == "--target":
            if len(rest) < 2: exit_with_usage("build: --target expects wasm or native")
            match rest[1]:
                "wasm": target = BuildTarget.wasm
                "native": target = BuildTarget.native
                else: exit_with_usage("build: unknown target `" + rest[1] + "`")
            rest = rest[2:]
        elif rest[0] == "--runtime":
            if len(rest) < 2: exit_with_usage("build: --runtime expects a source path")
            runtime_sources.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--runtime-root":
            if runtime_root != none: exit_with_usage("build: --runtime-root may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --runtime-root expects a directory")
            runtime_root = rest[1]
            rest = rest[2:]
        elif rest[0] == "--time-report":
            if time_report: exit_with_usage("build: --time-report may be supplied once")
            time_report = true
            rest = rest[1:]
        elif rest[0] == "--c-header":
            if c_header != none: exit_with_usage("build: --c-header may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --c-header expects an output path")
            c_header = rest[1]
            rest = rest[2:]
        elif rest[0] == "--abi-report":
            if abi_report != none: exit_with_usage("build: --abi-report may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --abi-report expects an output path")
            abi_report = rest[1]
            rest = rest[2:]
        else:
            break
    if len(rest) < 2: exit_with_usage("build: expected OUTPUT and at least one FILE")
    if len(runtime_sources) > 0 and runtime_root == none:
        exit_with_usage("build: --runtime sources require --runtime-root DIR")
    if len(runtime_sources) == 0 and runtime_root != none:
        exit_with_usage("build: --runtime-root requires at least one --runtime FILE")
    return ParsedBuildArguments(target = target, runtime_root = runtime_root, runtime_sources = runtime_sources, time_report = time_report, c_header = c_header, abi_report = abi_report, output = rest[0], sources = rest[1:])

# mark: Check =================================================================================

func check_entry(package_identity: str, source_root: str, options: CompilationOptions, sources: list[str]) -> !:
    let analyzed = try check(PackageInput(identity = package_identity, source_root = source_root, source_paths = sources), options)
    print_diagnostics(analyzed.diagnostics)

# mark: Run ===================================================================================

# Interpret one entry function and print its value. Kept as a statement-form
# `catch` in `main`: Stage-0 miscompiles `let value = run(...) catch reason:
# exit(1)` into a silent trap, so the fallible call must not bind a value.
func run_entry(package_identity: str, source_root: str, options: CompilationOptions, module_name: str, function_name: str, sources: list[str]) -> !:
    let result = try run(PackageInput(identity = package_identity, source_root = source_root, source_paths = sources), module_name, function_name, options)
    print_diagnostics(result.diagnostics)
    print(result.value.render())

# mark: Build =================================================================================

# Compile source files for a target and write the result to output
func build_target(package_identity: str, source_root: str, options: CompilationOptions, target: BuildTarget, runtime_root: str?, runtime_sources: list[str], output: str, sources: list[str], time_report: bool, c_header: str?, abi_report: str?) -> !:
    let package = PackageInput(identity = package_identity, source_root = source_root, source_paths = sources)
    let outputs = BuildOutputOptions(c_header = c_header, abi_report = abi_report)
    if len(runtime_sources) == 0:
        let result = try build(target, output, package, options, outputs)
        print_diagnostics(result.diagnostics)
        if time_report: print_generic_reports(result.generic_reports)
        return
    let root = runtime_root else trap("validated runtime root disappeared")
    let result = try build_with_runtime(target, output, package, sealed_runtime_package(root, runtime_sources), options, outputs)
    print_diagnostics(result.diagnostics)
    if time_report: print_generic_reports(result.generic_reports)

# mark: Explain ===============================================================================

func explain_entry(package_identity: str, source_root: str, options: CompilationOptions, sources: list[str]) -> !:
    let result = try explain(PackageInput(identity = package_identity, source_root = source_root, source_paths = sources), options)
    print_diagnostics(result.diagnostics)
    print(result.generic_report.render())
    print(result.interface_report.render())

# mark: Diagnostics ===========================================================================

func print_diagnostics(diagnostics: list[Diagnostic]):
    for diagnostic in diagnostics: print(diagnostic.render())

func print_generic_reports(reports: list[GenericReport]):
    for report in reports: print(report.render())

# mark: Exit ==================================================================================

# Print a diagnostic and exit with status 1. Pipeline diagnostics already
# carry `path:line:column:` or a stage prefix, so nothing is added here.
func exit_with_error(reason: str):
    print(reason)
    exit(1)

# Print an error (if any) plus usage and exit with status 2
func exit_with_usage(message: str):
    if len(message) > 0: print("luce: " + message)
    print("usage:")
    print("  luce build --package ID --root DIR [--generic-specializations N] [--time-report] [--target wasm|native] [--c-header PATH] [--abi-report PATH] [--runtime-root DIR --runtime FILE]... OUTPUT FILE...")
    print("  luce check --package ID --root DIR [--generic-specializations N] FILE...")
    print("  luce run --package ID --root DIR [--generic-specializations N] MODULE.FUNCTION FILE...")
    print("  luce explain --package ID --root DIR [--generic-specializations N] FILE...")
    print("  luce --version")
    exit(2)
