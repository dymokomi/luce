from tokenizer import Tokenizer
from utils.args import Cli

func main(args: list[str]) -> !:
    let version = "0.2"

    var cli = Cli(name = "luce")
    cli.root().flag("--version").synonym("-v", "--version")
    cli.command("build").flag("--release").option("-o").option("--emit")
    cli.command("check")
    cli.command("run").option("-o")
    cli.command("test")

    let run = cli.parse(args) catch reason:
        print(reason)
        print_usage()
        exit(2)

    match run.command:
        "":
            if run.has("--version"):
                print(f"Luce v{version}")
            else:
                print_usage()
        "build":
            print("command: build")
            if run.has("--release"):
                print("release: on")
            let out = run.value("-o")
            if out != none:
                print("output: " + out)
            let emit = run.value("--emit")
            if emit != none:
                print("emit: " + emit)
            for path in run.inputs:
                print("input: " + path)
        "check":
            print("check: not yet implemented")
        "run":
            print("run: not yet implemented")
        "test":
            print("test: not yet implemented")
        else:
            print_usage()

    exit(0)

func print_usage():
    print("usage: luce COMMAND [options] [inputs]")
    print("  commands: build, check, run, test")
    print("  build options: -o OUT, --emit=WHAT, --release")
    print("  global: --version, -v")
