#==============================================================================================
#
#   luce - The luce command line
#
#   DESCRIPTION:
#       Command line front-end for the compiler. Reads the arguments, calls the
#       matching function in compiler.pipeline and prints the result. All the
#       language logic lives under compiler/
#
#   COMMANDS:
#       luce build --package ID --root DIR [--standard-root DIR --standard FILE]...
#                  [--generic-specializations N]
#                  [--time-report] [--target TARGET]
#                  [--c-header PATH] [--abi-report PATH]
#                  [--c-source PATH] [--c-arg ARG]
#                  [--runtime-root DIR --runtime FILE]... OUTPUT FILE...
#       luce check --package ID --root DIR [--standard-root DIR --standard FILE]...
#                  [--generic-specializations N] FILE...
#       luce run --package ID --root DIR [--standard-root DIR --standard FILE]...
#                [--generic-specializations N] MODULE.FUNCTION FILE...
#       luce explain --package ID --root DIR [--standard-root DIR --standard FILE]...
#                    [--generic-specializations N] FILE...
#       luce bind --name NAME --fiir PATH --raw PATH --adapter PATH
#                 [--recipe PATH --safe PATH]
#                 [--clang COMMAND] [--clang-arg ARG]...
#                 [--macro-constant NAME]... HEADER
#       luce --version
#
#   TARGETS:
#       wasm            WebAssembly module (default)
#       native          host executable through pinned QBE 1.3
#
#   EXIT STATUS:
#       0   ok
#       1   command failed
#       2   bad command line
#
#==============================================================================================

from compiler.pipeline import BuildOutputOptions, BuildTarget, CompilationOptions, NativeBuildOptions, PackageInput, StandardSourceInput, build, build_with_runtime, check, explain, run
from compiler.backends.clang_fiir import CBindingOutputs, CBindingRequest, bind_c
from compiler.frontend.source import Diagnostic
from compiler.reporting.generics import GenericReport
from compiler.runtime_package import sealed_runtime_package
import std.strings

## Current Luce command-line version.
pub let version: str = "1.0.0"

# mark: Main ==================================================================================

## Run the Luce command-line front end.
pub func main(args: list[str]):
    if len(args) == 0: exit_with_usage("")

    let arguments = args[1:]
    match args[0]:
        "--version", "-v":
            print(f"Luce v{version}")

        "check":
            let package = package_arguments("check", arguments, 1)
            check_entry(package_input(package, package.rest), package.options) catch reason:
                exit_with_error(reason)
            print(f"checked {len(package.rest)} file(s)")

        "run":
            let package = package_arguments("run", arguments, 2)
            let entry = entry_argument(package.rest[0])
            run_entry(package_input(package, package.rest[1:]), package.options, entry.module_name, entry.function_name) catch reason:
                exit_with_error(reason)

        "build":
            let package = package_arguments("build", arguments, 0)
            let options = build_arguments(package.rest)
            build_target(package_input(package, options.sources), package.options, options.target, options.runtime_root, options.runtime_sources, options.output, options.time_report, options.c_header, options.abi_report, options.c_sources, options.c_arguments) catch reason:
                exit_with_error(reason)
            print("built " + options.output)

        "explain":
            let package = package_arguments("explain", arguments, 1)
            explain_entry(package_input(package, package.rest), package.options) catch reason:
                exit_with_error(reason)

        "bind":
            let options = bind_arguments(arguments)
            bind_entry(options) catch reason:
                exit_with_error(reason)
            print("bound " + options.header)

        else:
            exit_with_usage("unknown command " + args[0])

# mark: Arguments =============================================================================

struct ParsedPackageArguments:
    let identity: str
    let source_root: str
    let standard_root: str?
    let standard_sources: list[str]
    let options: CompilationOptions
    let rest: list[str]

struct ParsedBuildArguments:
    let target: BuildTarget
    let runtime_root: str?
    let runtime_sources: list[str]
    let time_report: bool
    let c_header: str?
    let abi_report: str?
    let c_sources: list[str]
    let c_arguments: list[str]
    let output: str
    let sources: list[str]

struct ParsedEntryArgument:
    let module_name: str
    let function_name: str

struct ParsedBindArguments:
    let name: str
    let header: str
    let clang_command: str
    let clang_arguments: list[str]
    let macro_constants: list[str]
    let fiir: str
    let raw_module: str
    let c_adapter: str
    let recipe_path: str?
    let safe_module: str?

func entry_argument(value: str) -> ParsedEntryArgument:
    let components = strings.split(value, ".")
    if len(components) < 2: exit_with_usage("run: entry must be MODULE.FUNCTION")
    var module_name = ""
    for index in range(0, len(components) - 1):
        if components[index] == "": exit_with_usage("run: entry must be MODULE.FUNCTION")
        if module_name != "": module_name += "."
        module_name += components[index]
    let function_name = components[len(components) - 1]
    if function_name == "": exit_with_usage("run: entry must be MODULE.FUNCTION")
    return ParsedEntryArgument(module_name = module_name, function_name = function_name)

# The raw compiler never guesses package identity from a directory or file
# name: identity is stable program data carried by ErrorCode.
func package_arguments(command: str, arguments: list[str], minimum_rest: i64) -> ParsedPackageArguments:
    if len(arguments) < 4 or arguments[0] != "--package" or len(arguments[1]) == 0:
        exit_with_usage(command + ": expected `--package ID --root DIR`")
    if arguments[2] != "--root" or len(arguments[3]) == 0:
        exit_with_usage(command + ": expected `--root DIR` after the package identity")
    var rest = arguments[4:]
    var generic_specialization_budget: i64 = 256
    var has_generic_specialization_budget = false
    var standard_root: str? = none
    let standard_sources = list[str]()
    while len(rest) > 0:
        if rest[0] == "--generic-specializations":
            if has_generic_specialization_budget:
                exit_with_usage(command + ": --generic-specializations may be supplied once")
            if len(rest) < 2:
                exit_with_usage(command + ": --generic-specializations expects a positive integer")
            let parsed_value = parse_i64(rest[1])
            if parsed_value == none:
                exit_with_usage(command + ": --generic-specializations expects a positive integer")
            let parsed = parsed_value else trap("validated generic specialization budget disappeared")
            if parsed <= 0:
                exit_with_usage(command + ": --generic-specializations expects a positive integer")
            generic_specialization_budget = parsed
            has_generic_specialization_budget = true
            rest = rest[2:]
        elif rest[0] == "--standard-root":
            if standard_root != none:
                exit_with_usage(command + ": --standard-root may be supplied once")
            if len(rest) < 2 or rest[1] == "":
                exit_with_usage(command + ": --standard-root expects a directory")
            standard_root = rest[1]
            rest = rest[2:]
        elif rest[0] == "--standard":
            if len(rest) < 2 or rest[1] == "":
                exit_with_usage(command + ": --standard expects a source path")
            standard_sources.append(rest[1])
            rest = rest[2:]
        else:
            break
    if len(standard_sources) > 0 and standard_root == none:
        exit_with_usage(command + ": --standard sources require --standard-root DIR")
    if len(standard_sources) == 0 and standard_root != none:
        exit_with_usage(command + ": --standard-root requires at least one --standard FILE")
    if len(rest) < minimum_rest:
        if command == "check": exit_with_usage("check: expected at least one FILE")
        if command == "run": exit_with_usage("run: expected MODULE.FUNCTION and at least one FILE")
        if command == "explain": exit_with_usage("explain: expected at least one FILE")
        exit_with_usage("build: expected OUTPUT and at least one FILE")
    return ParsedPackageArguments(
        identity = arguments[1],
        source_root = arguments[3],
        standard_root = standard_root,
        standard_sources = standard_sources,
        options = CompilationOptions(generic_specialization_budget = generic_specialization_budget),
        rest = rest,
    )

func package_input(arguments: ParsedPackageArguments, sources: list[str]) -> PackageInput:
    var standard: StandardSourceInput? = none
    let standard_root = arguments.standard_root
    if standard_root != none:
        standard = StandardSourceInput(
            source_root = standard_root,
            source_paths = arguments.standard_sources,
        )
    return PackageInput(
        identity = arguments.identity,
        source_root = arguments.source_root,
        source_paths = sources,
        standard_sources = standard,
    )

# Build options precede the output. A runtime source may be repeated because
# the reviewed sealed package can grow into multiple modules without changing
# compiler discovery policy or smuggling a checkout path into the binary.
func build_arguments(arguments: list[str]) -> ParsedBuildArguments:
    var target = BuildTarget.wasm
    var runtime_root: str? = none
    let runtime_sources = list[str]()
    var time_report = false
    var c_header: str? = none
    var abi_report: str? = none
    let c_sources = list[str]()
    let c_arguments = list[str]()
    var rest = arguments
    while len(rest) > 0:
        if rest[0] == "--target":
            if len(rest) < 2: exit_with_usage("build: --target expects wasm or native")
            match rest[1]:
                "wasm": target = BuildTarget.wasm
                "native": target = BuildTarget.native
                else: exit_with_usage("build: unknown target `" + rest[1] + "`")
            rest = rest[2:]
        elif rest[0] == "--runtime":
            if len(rest) < 2: exit_with_usage("build: --runtime expects a source path")
            runtime_sources.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--runtime-root":
            if runtime_root != none: exit_with_usage("build: --runtime-root may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --runtime-root expects a directory")
            runtime_root = rest[1]
            rest = rest[2:]
        elif rest[0] == "--time-report":
            if time_report: exit_with_usage("build: --time-report may be supplied once")
            time_report = true
            rest = rest[1:]
        elif rest[0] == "--c-header":
            if c_header != none: exit_with_usage("build: --c-header may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --c-header expects an output path")
            c_header = rest[1]
            rest = rest[2:]
        elif rest[0] == "--abi-report":
            if abi_report != none: exit_with_usage("build: --abi-report may be supplied once")
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --abi-report expects an output path")
            abi_report = rest[1]
            rest = rest[2:]
        elif rest[0] == "--c-source":
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --c-source expects a source path")
            c_sources.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--c-arg":
            if len(rest) < 2 or len(rest[1]) == 0: exit_with_usage("build: --c-arg expects one compiler argument")
            c_arguments.append(rest[1])
            rest = rest[2:]
        else:
            break
    if len(rest) < 2: exit_with_usage("build: expected OUTPUT and at least one FILE")
    if len(runtime_sources) > 0 and runtime_root == none:
        exit_with_usage("build: --runtime sources require --runtime-root DIR")
    if len(runtime_sources) == 0 and runtime_root != none:
        exit_with_usage("build: --runtime-root requires at least one --runtime FILE")
    return ParsedBuildArguments(target = target, runtime_root = runtime_root, runtime_sources = runtime_sources, time_report = time_report, c_header = c_header, abi_report = abi_report, c_sources = c_sources, c_arguments = c_arguments, output = rest[0], sources = rest[1:])

func bind_arguments(arguments: list[str]) -> ParsedBindArguments:
    var name: str? = none
    var clang_command = "clang"
    var has_clang_command = false
    let clang_arguments = list[str]()
    let macro_constants = list[str]()
    var fiir: str? = none
    var raw_module: str? = none
    var c_adapter: str? = none
    var recipe_path: str? = none
    var safe_module: str? = none
    var rest = arguments
    while len(rest) > 0:
        if rest[0] == "--name":
            if name != none: exit_with_usage("bind: --name may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --name expects a binding name")
            name = rest[1]
            rest = rest[2:]
        elif rest[0] == "--clang":
            if has_clang_command: exit_with_usage("bind: --clang may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --clang expects a command")
            clang_command = rest[1]
            has_clang_command = true
            rest = rest[2:]
        elif rest[0] == "--clang-arg":
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --clang-arg expects one argument")
            clang_arguments.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--macro-constant":
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --macro-constant expects a C macro name")
            macro_constants.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--fiir":
            if fiir != none: exit_with_usage("bind: --fiir may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --fiir expects an output path")
            fiir = rest[1]
            rest = rest[2:]
        elif rest[0] == "--raw":
            if raw_module != none: exit_with_usage("bind: --raw may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --raw expects an output path")
            raw_module = rest[1]
            rest = rest[2:]
        elif rest[0] == "--adapter":
            if c_adapter != none: exit_with_usage("bind: --adapter may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --adapter expects an output path")
            c_adapter = rest[1]
            rest = rest[2:]
        elif rest[0] == "--recipe":
            if recipe_path != none: exit_with_usage("bind: --recipe may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --recipe expects an input path")
            recipe_path = rest[1]
            rest = rest[2:]
        elif rest[0] == "--safe":
            if safe_module != none: exit_with_usage("bind: --safe may be supplied once")
            if len(rest) < 2 or rest[1] == "": exit_with_usage("bind: --safe expects an output path")
            safe_module = rest[1]
            rest = rest[2:]
        else:
            break
    if name == none or fiir == none or raw_module == none or c_adapter == none:
        exit_with_usage("bind: expected `--name NAME --fiir PATH --raw PATH --adapter PATH`")
    if len(rest) != 1: exit_with_usage("bind: expected exactly one HEADER")
    if recipe_path == none and safe_module != none: exit_with_usage("bind: --safe requires --recipe PATH")
    if recipe_path != none and safe_module == none: exit_with_usage("bind: --recipe requires --safe PATH")
    return ParsedBindArguments(
        name = name else "",
        header = rest[0],
        clang_command = clang_command,
        clang_arguments = clang_arguments,
        macro_constants = macro_constants,
        fiir = fiir else "",
        raw_module = raw_module else "",
        c_adapter = c_adapter else "",
        recipe_path = recipe_path,
        safe_module = safe_module,
    )

# mark: Check =================================================================================

func check_entry(package: PackageInput, options: CompilationOptions) -> !:
    let analyzed = try check(package, options)
    print_diagnostics(analyzed.diagnostics)

# mark: Bind ===================================================================================

func bind_entry(options: ParsedBindArguments) -> !:
    discard(try bind_c(
        CBindingRequest(name = options.name, header = options.header, clang_arguments = options.clang_arguments, macro_constants = options.macro_constants, recipe_path = options.recipe_path),
        CBindingOutputs(fiir = options.fiir, raw_module = options.raw_module, c_adapter = options.c_adapter, safe_module = options.safe_module),
        options.clang_command,
    ))

# mark: Run ===================================================================================

# Interpret one entry function and print its value. Kept as a statement-form
# `catch` in `main`: Stage-0 miscompiles `let value = run(...) catch reason:
# exit(1)` into a silent trap, so the fallible call must not bind a value.
func run_entry(package: PackageInput, options: CompilationOptions, module_name: str, function_name: str) -> !:
    let result = try run(package, module_name, function_name, options)
    print_diagnostics(result.diagnostics)
    print(result.value.render())

# mark: Build =================================================================================

# Compile source files for a target and write the result to output
func build_target(package: PackageInput, options: CompilationOptions, target: BuildTarget, runtime_root: str?, runtime_sources: list[str], output: str, time_report: bool, c_header: str?, abi_report: str?, c_sources: list[str], c_arguments: list[str]) -> !:
    let outputs = BuildOutputOptions(c_header = c_header, abi_report = abi_report)
    let native = NativeBuildOptions(c_sources = c_sources, c_arguments = c_arguments)
    if len(runtime_sources) == 0:
        let result = try build(target, output, package, options, outputs, native)
        print_diagnostics(result.diagnostics)
        if time_report: print_generic_reports(result.generic_reports)
        return
    let root = runtime_root else trap("validated runtime root disappeared")
    let result = try build_with_runtime(target, output, package, sealed_runtime_package(root, runtime_sources), options, outputs, native)
    print_diagnostics(result.diagnostics)
    if time_report: print_generic_reports(result.generic_reports)

# mark: Explain ===============================================================================

func explain_entry(package: PackageInput, options: CompilationOptions) -> !:
    let result = try explain(package, options)
    print_diagnostics(result.diagnostics)
    print(result.generic_report.render())
    print(result.interface_report.render())

# mark: Diagnostics ===========================================================================

func print_diagnostics(diagnostics: list[Diagnostic]):
    for diagnostic in diagnostics: print(diagnostic.render())

func print_generic_reports(reports: list[GenericReport]):
    for report in reports: print(report.render())

# mark: Exit ==================================================================================

# Print a diagnostic and exit with status 1. Pipeline diagnostics already
# carry `path:line:column:` or a stage prefix, so nothing is added here.
func exit_with_error(reason: str):
    print(reason)
    exit(1)

# Print an error (if any) plus usage and exit with status 2
func exit_with_usage(message: str):
    if len(message) > 0: print("luce: " + message)
    print("usage:")
    print("  luce build --package ID --root DIR [--standard-root DIR --standard FILE]... [--generic-specializations N] [--time-report] [--target wasm|native] [--c-header PATH] [--abi-report PATH] [--c-source PATH] [--c-arg ARG] [--runtime-root DIR --runtime FILE]... OUTPUT FILE...")
    print("  luce check --package ID --root DIR [--standard-root DIR --standard FILE]... [--generic-specializations N] FILE...")
    print("  luce run --package ID --root DIR [--standard-root DIR --standard FILE]... [--generic-specializations N] MODULE.FUNCTION FILE...")
    print("  luce explain --package ID --root DIR [--standard-root DIR --standard FILE]... [--generic-specializations N] FILE...")
    print("  luce bind --name NAME --fiir PATH --raw PATH --adapter PATH [--recipe PATH --safe PATH] [--clang COMMAND] [--clang-arg ARG]... [--macro-constant NAME]... HEADER")
    print("  luce --version")
    exit(2)
