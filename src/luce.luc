from compiler.interpreter import format_value
from compiler.pipeline import check, run
import std.strings

const version = "0.2"

func main(args: list[str]):
    if len(args) == 0:
        print_usage()
        return

    match args[0]:
        "--version", "-v":  print(f"Luce v{version}")
        "check":            check_sources(args[1:len(args)])
        "run":              run_sources(args[1:len(args)])
        else:
            print("luce: unknown command " + args[0])
            print_usage()
            exit(2)

private func check_sources(paths: list[str]):
    if len(paths) == 0:
        print("luce check: no input files")
        exit(2)

    check(paths) catch reason:
        print(reason)
        exit(1)
    print(f"checked {len(paths)} file(s)")

private func run_sources(arguments: list[str]):
    if len(arguments) < 2:
        print("luce run: expected MODULE.FUNCTION and at least one input file")
        exit(2)
    let target = strings.split(arguments[0], ".")
    if len(target) != 2:
        print("luce run: target must be MODULE.FUNCTION")
        exit(2)

    let value = run(arguments[1:len(arguments)], target[0], target[1]) catch reason:
        print(reason)
        exit(1)
    print(format_value(value))

private func print_usage():
    print("usage:")
    print("  luce check FILE...")
    print("  luce run MODULE.FUNCTION FILE...")
    print("  luce --version")
