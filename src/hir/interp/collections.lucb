#==============================================================================================
#
#   interp/collections - The methods of lists, maps, sets and ranges
#
#   DESCRIPTION:
#       The operations of §6.6 and §11.1 to §11.2 over the interpreter's values, each the same
#       algorithm as the kernel's, call for call, so a function, a key or a comparison with an
#       effect is seen alike in both executions. The checker named every argument by its
#       parameter (`ast.argument`).
#
#==============================================================================================
extend Interp:
    # mark: Lists ===============================================================================

    ## A list's own method (§11.1), the same operation as the kernel's.
    func list_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let l = try self.eval(receiver)
        let store = l.obj else error(fault, "no list")
        if name == "append":
            try heap.append(store, try self.eval_owned(ast.argument(e, "value") else error(fault, "no value")))
            return value.nothing()
        if name == "insert":
            let i = (try self.eval(ast.argument(e, "index") else error(fault, "no index"))).i
            let v = try self.eval_owned(ast.argument(e, "value") else error(fault, "no value"))
            if i < 0 or i > (i64)store.count:
                self.stop("index out of range")
            try heap.insert(store, (usize)i, v)
            return value.nothing()
        if name == "sort" or name == "sorted" or name == "min" or name == "max":
            return try self.ordering_method(e, name, store)
        if name == "map" or name == "flat_map" or name == "filter" or name == "any" or name == "all" or name == "find" or name == "reduce":
            return try self.function_method(e, name, store)
        if let first = e.body:
            let arg = try self.eval(first.left else error(fault, "empty argument"))
            return try self.list_method_of(e, name, store, arg)
        return try self.list_method_alone(e, name, store)

    ## A list method of one argument, a value, an index, a size, a separator or another list.
    func list_method_of(e: ast.Node*, name: str, store: value.Object*, arg: value.Value) -> value.Value!:
        if name == "remove_at":
            return heap.remove_at(store, try checked_index(arg.i, store.count))
        if name == "contains":
            return value.boolean(heap.find(store, arg) != none)
        if name == "index_of":
            let at = heap.find(store, arg) else return value.absent()
            return value.integer((i64)at)
        if name == "count":
            var n: i64 = 0
            var i: usize = 0
            while i < store.count:
                if try self.equal_value(store.elem, store.fields[i], arg):
                    n += 1
                i += 1
            return value.integer(n)
        if name == "remove":
            let at = heap.find(store, arg) else return value.boolean(false)
            heap.release(heap.remove_at(store, at))
            return value.boolean(true)
        if name == "extend":
            let other = arg.obj else error(fault, "no list")
            let n = other.count
            var i: usize = 0
            while i < n:
                try heap.push(store, try heap.copy(other.fields[i]))
                i += 1
            store.version += 1
            return value.nothing()
        if name == "join":
            var b = try strings.Builder.create(64)
            defer b.destroy()
            var i: usize = 0
            while i < store.count:
                if i > 0:
                    try b.put(arg.s)
                try b.put(store.fields[i].s)
                i += 1
            return value.text(try strings.copy(b.view()))
        if name == "zip":
            let other = arg.obj else error(fault, "no list")
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count and i < other.count:
                var pair = try value.members(value.Kind.tuple, 2, none)
                pair.items[0] = try heap.copy(store.fields[i])
                pair.items[1] = try heap.copy(other.fields[i])
                try heap.push(out, pair)
                i += 1
            return value.collection(value.Kind.list_, out)
        # chunks(size): the elements in lists of `size`
        if arg.i < 1:
            self.stop("chunks of a size below one")
        let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
        var start: usize = 0
        while start < store.count:
            let end = start + (usize)arg.i if arg.i < (i64)(store.count - start) else store.count
            try heap.push(out, value.collection(value.Kind.list_, try heap.sliced(store, start, end)))
            start = end
        return value.collection(value.Kind.list_, out)

    ## A list method of no argument: shape changes, copies, `distinct`, `indexed`, `sum`.
    func list_method_alone(e: ast.Node*, name: str, store: value.Object*) -> value.Value!:
        if name == "pop":
            if store.count == 0:
                self.stop("pop of an empty list")
            return heap.remove_at(store, store.count - 1)
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "reverse":
            heap.reverse(store)
            return value.nothing()
        if name == "reversed" or name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            if name == "reversed":
                heap.reverse(out)
            return value.collection(value.Kind.list_, out)
        if name == "distinct":
            return try self.distinct(store)
        if name == "indexed":
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count:
                var pair = try value.members(value.Kind.tuple, 2, none)
                pair.items[0] = value.integer((i64)i)
                pair.items[1] = try heap.copy(store.fields[i])
                try heap.push(out, pair)
                i += 1
            return value.collection(value.Kind.list_, out)
        if name == "sum":
            if store.elem == types.float_id:
                return value.floating(float_sum(store))
            var total: i64 = 0
            var i: usize = 0
            while i < store.count:
                total = total +? store.fields[i].i else self.stop("integer overflow")
                i += 1
            return value.integer(total)
        error(fault, "an unknown list method")

    ## `distinct()`: the kernel's table of hashes, probed and compared in its order.
    func distinct(store: value.Object*) -> value.Value!:
        let out = try heap.allocate_collection(store.elem, types.none_id)
        var size: usize = 8
        while size < store.count * 2:
            size *= 2
        var slots = try new usize[size] ---
        defer free(slots)
        let empty: usize = 18446744073709551615
        var i: usize = 0
        while i < size:
            slots[i] = empty
            i += 1
        i = 0
        while i < store.count:
            var at = (usize)self.hash_value(hash_offset, store.elem, store.fields[i]) & (size - 1)
            var seen = false
            while slots[at] != empty and not seen:
                seen = try self.equal_value(store.elem, out.fields[slots[at]], store.fields[i])
                if not seen:
                    at = (at + 1) & (size - 1)
            if not seen:
                slots[at] = out.count
                try heap.push(out, try heap.copy(store.fields[i]))
            i += 1
        return value.collection(value.Kind.list_, out)

    # mark: Sorting, least and greatest =========================================================

    ## `sort`, `sorted`, `min`, `max`, by the elements or by a key, as the kernel's.
    func ordering_method(e: ast.Node*, name: str, store: value.Object*) -> value.Value!:
        var key = value.nothing()
        var key_type = store.elem
        if let k = ast.argument(e, "key"):
            key = try self.eval(k)
            key_type = self.checker.table.get(k.type_id).elem
        var reverse = false
        if let r = ast.argument(e, "reverse"):
            reverse = value.truth(try self.eval(r))
        if name == "min" or name == "max":
            return try self.least(store, key, key_type, name == "min")
        if name == "sort":
            try self.sort_list(store, key, key_type, reverse)
            return value.nothing()
        let out = try heap.sliced(store, 0, store.count)
        try self.sort_list(out, key, key_type, reverse)
        return value.collection(value.Kind.list_, out)

    ## In place and stable; the elements out of the list while it sorts, as the kernel's
    ## `detach`, and a list changed meanwhile a trap.
    func sort_list(store: value.Object*, key: value.Value, key_type: u32, reverse: bool) -> !:
        let items = store.fields
        let n = store.count
        store.fields = try new value.Value[4] ---
        store.count = 0
        store.version += 1
        let version = store.version
        var keys = items
        if key.kind != value.Kind.unit_:
            keys = try new value.Value[n if n > 0 else 1] ---
            var i: usize = 0
            while i < n:
                var one = try new value.Value[1] ---
                one[0] = items[i]
                keys[i] = try self.call_value(key, one)
                i += 1
        let order = try self.sorted_order(keys[..<n], key_type, reverse)
        if key.kind != value.Kind.unit_:
            var i: usize = 0
            while i < n:
                heap.release(keys[i])
                i += 1
        if store.version != version or store.count != 0:
            self.stop("the list changed while it was sorted")
        var sorted = try new value.Value[items.length] ---
        var i: usize = 0
        while i < n:
            sorted[i] = items[order[i]]
            i += 1
        store.fields = sorted
        store.count = n
        store.version += 1

    ## The kernel's merge sort, top down: the order that sorts `keys` stably.
    func sorted_order(keys: value.Value[], t: u32, reverse: bool) -> usize[]!:
        let n = keys.length
        var order = try new usize[n if n > 0 else 1] ---
        var spare = try new usize[n if n > 0 else 1] ---
        defer free(spare)
        var i: usize = 0
        while i < n:
            order[i] = i
            i += 1
        try self.merge_sort(keys, t, reverse, order, spare, 0, n)
        return order

    func merge_sort(keys: value.Value[], t: u32, reverse: bool, order: usize[], spare: usize[], low: usize, high: usize) -> !:
        if high - low < 2:
            return
        let middle = low + (high - low) // 2
        try self.merge_sort(keys, t, reverse, order, spare, low, middle)
        try self.merge_sort(keys, t, reverse, order, spare, middle, high)
        var i = low
        var j = middle
        var k = low
        while i < middle and j < high:
            let sign = try self.compare_value(t, keys[order[j]], keys[order[i]])
            if (sign > 0 if reverse else sign < 0):
                spare[k] = order[j]
                j += 1
            else:
                spare[k] = order[i]
                i += 1
            k += 1
        while i < middle:
            spare[k] = order[i]
            i += 1
            k += 1
        while j < high:
            spare[k] = order[j]
            j += 1
            k += 1
        k = low
        while k < high:
            order[k] = spare[k]
            k += 1

    ## `min` and `max`: a copy of the first least or greatest, by key when there is one.
    func least(store: value.Object*, key: value.Value, key_type: u32, least: bool) -> value.Value!:
        if store.count == 0:
            return value.absent()
        let version = store.version
        let keyed = key.kind != value.Kind.unit_
        var best: usize = 0
        var best_key = try self.call_on(store, key, 0, version) if keyed else value.nothing()
        var i: usize = 1
        while i < store.count:
            if keyed:
                let k = try self.call_on(store, key, i, version)
                let sign = try self.compare_value(key_type, k, best_key)
                if (sign < 0 if least else sign > 0):
                    heap.release(best_key)
                    best_key = k
                    best = i
                else:
                    heap.release(k)
            else:
                let sign = try self.compare_value(store.elem, store.fields[i], store.fields[best])
                heap.check(store, version, "list")
                if (sign < 0 if least else sign > 0):
                    best = i
            i += 1
        heap.release(best_key)
        return try heap.copy(store.fields[best])

    # mark: Functions of the elements ===========================================================

    ## A function called on a copy of element `i`, the list's shape then checked, as the
    ## kernel's `call_on`.
    func call_on(store: value.Object*, f: value.Value, i: usize, version: u64) -> value.Value!:
        var one = try new value.Value[1] ---
        one[0] = try heap.copy(store.fields[i])
        let out = try self.call_value(f, one)
        heap.release(one[0])
        heap.check(store, version, "list")
        return out

    ## `map`, `flat_map`, `filter`, `any`, `all`, `find` and `reduce`, as the kernel's.
    func function_method(e: ast.Node*, name: str, store: value.Object*) -> value.Value!:
        if name == "reduce":
            return try self.reduce(e, store)
        let f = try self.eval(ast.argument(e, "function" if name == "map" or name == "flat_map" else "predicate") else error(fault, "no function"))
        let version = store.version
        if name == "any" or name == "all" or name == "find":
            # stopping at the first element that decides
            var i: usize = 0
            while i < store.count:
                let holds = value.truth(try self.call_on(store, f, i, version))
                if name == "find":
                    if holds:
                        return try heap.copy(store.fields[i])
                elif holds == (name == "any"):
                    return value.boolean(holds)
                i += 1
            return value.absent() if name == "find" else value.boolean(name == "all")
        let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
        var i: usize = 0
        while i < store.count:
            let r = try self.call_on(store, f, i, version)
            if name == "map":
                try heap.push(out, r)
            elif name == "flat_map":
                let part = r.obj else error(fault, "no list")
                var k: usize = 0
                while k < part.count:
                    try heap.push(out, try heap.copy(part.fields[k]))
                    k += 1
                heap.release(r)
            elif value.truth(r):
                try heap.push(out, try heap.copy(store.fields[i]))
            i += 1
        return value.collection(value.Kind.list_, out)

    ## `reduce(function, initial)`, as the kernel's: the total handed on, left to right.
    func reduce(e: ast.Node*, store: value.Object*) -> value.Value!:
        let f = try self.eval(ast.argument(e, "function") else error(fault, "no function"))
        var total = try self.eval_owned(ast.argument(e, "initial") else error(fault, "no initial value"))
        let version = store.version
        var i: usize = 0
        while i < store.count:
            var two = try new value.Value[2] ---
            two[0] = total
            two[1] = try heap.copy(store.fields[i])
            let next = try self.call_value(f, two)
            heap.release(two[1])
            heap.release(total)
            total = next
            heap.check(store, version, "list")
            i += 1
        return total

    # mark: Maps and sets =======================================================================

    ## A map's or a set's own method (§11.2), the same operation as the kernel's.
    func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let m = try self.eval(receiver)
        let store = m.obj else error(fault, "no collection")
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            return value.collection(m.kind, out)
        if is_map:
            return try self.map_only_method(e, name, store)
        let first = e.body else error(fault, "no argument")
        let v = first.left else error(fault, "empty argument")
        if name == "insert":
            try heap.set_insert(store, try self.eval_owned(v))
            return value.nothing()
        let arg = try self.eval(v)
        if name == "remove":
            return value.boolean(heap.set_remove(store, arg))
        let other = arg.obj else error(fault, "no set")
        if name == "is_subset" or name == "is_superset" or name == "is_disjoint":
            let (inner, outer) = (other, store) if name == "is_superset" else (store, other)
            var i: usize = 0
            while i < inner.count:
                let present = heap.find(outer, inner.fields[i]) != none
                if present == (name == "is_disjoint"):
                    return value.boolean(false)
                i += 1
            return value.boolean(true)
        # union, intersection, difference, symmetric_difference: a new set
        let out = try heap.allocate_collection(store.elem, types.none_id)
        var i: usize = 0
        if name == "union":
            while i < store.count:
                try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
            i = 0
            while i < other.count:
                try heap.set_insert(out, try heap.copy(other.fields[i]))
                i += 1
            return value.collection(value.Kind.set_, out)
        while i < store.count:
            let present = heap.find(other, store.fields[i]) != none
            if present == (name == "intersection"):
                try heap.push(out, try heap.copy(store.fields[i]))
            i += 1
        if name == "symmetric_difference":
            i = 0
            while i < other.count:
                if heap.find(store, other.fields[i]) == none:
                    try heap.set_insert(out, try heap.copy(other.fields[i]))
                i += 1
        return value.collection(value.Kind.set_, out)

    ## The methods only a map has: `remove`, `get`, `update`, and its keys, values and items.
    func map_only_method(e: ast.Node*, name: str, store: value.Object*) -> value.Value!:
        if name == "remove":
            let key = try self.eval(ast.argument(e, "key") else error(fault, "no key"))
            let out = heap.map_remove(store, key) else return value.absent()
            return out
        if name == "get":
            let key = try self.eval(ast.argument(e, "key") else error(fault, "no key"))
            let fallback = try self.eval(ast.argument(e, "default") else error(fault, "no default"))
            let at = heap.map_find(store, key) else return try heap.copy(fallback)
            return try heap.copy(store.fields[at + 1])
        if name == "update":
            let other = (try self.eval(ast.argument(e, "other") else error(fault, "no map"))).obj else error(fault, "no map")
            let n = other.count
            var i: usize = 0
            while i < n:
                try heap.map_set(store, try heap.copy(other.fields[i]), try heap.copy(other.fields[i + 1]))
                i += 2
            return value.nothing()
        let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
        var i: usize = 0
        while i < store.count:
            if name == "keys":
                try heap.push(out, try heap.copy(store.fields[i]))
            elif name == "values":
                try heap.push(out, try heap.copy(store.fields[i + 1]))
            else:
                var pair = try value.members(value.Kind.tuple, 2, none)
                pair.items[0] = try heap.copy(store.fields[i])
                pair.items[1] = try heap.copy(store.fields[i + 1])
                try heap.push(out, pair)
            i += 2
        return value.collection(value.Kind.list_, out)

    # mark: Ranges ==============================================================================

    ## `r.step(n)`, `r.reversed()` and `r.contains(x)` (§6.6), as the kernel's.
    func range_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let r = try self.eval(receiver)
        if callee.text == "reversed":
            var out = r
            out.step = -r.step
            return out
        let first = e.body else error(fault, "no argument")
        let n = (try self.eval(first.left else error(fault, "empty argument"))).i
        if callee.text == "contains":
            return value.boolean(range_contains(r, n))
        if n < 1:
            self.stop("a range's step is above zero")
        let size = (i64)step_size(r) *? n else self.stop("integer overflow")
        var out = r
        out.step = size
        if r.step > 0:
            return out
        out.step = -size
        let last = range_last(r) else return out
        let steps = ((u64)last -% (u64)r.i) // (u64)size
        out.i = (i64)((u64)last -% steps * (u64)size)
        out.hi = last
        out.inclusive = true
        return out

# mark: Range and sum helpers ==================================================================

## A range's step as a distance.
func step_size(r: value.Value) -> u64:
    return (u64)r.step if r.step > 0 else (u64)0 -% (u64)r.step

## The greatest element of a range, or none; spans taken as `u64`, as the kernel's.
func range_last(r: value.Value) -> i64?:
    var top = r.hi
    if not r.inclusive:
        if r.hi == -9223372036854775807 - 1:
            return none
        top = r.hi - 1
    if top < r.i:
        return none
    let span = (u64)top -% (u64)r.i
    return (i64)((u64)r.i +% span // step_size(r) * step_size(r))

## `x in r`: between the bounds, a whole number of steps from the low one.
func range_contains(r: value.Value, x: i64) -> bool:
    let last = range_last(r) else return false
    return x >= r.i and x <= last and ((u64)x -% (u64)r.i) % step_size(r) == 0

## `r.length`; past the largest `int` traps.
func range_length(r: value.Value) -> i64:
    let last = range_last(r) else return 0
    let steps = ((u64)last -% (u64)r.i) // step_size(r)
    if steps >= 9223372036854775807:
        heap.stop("integer overflow")
    return (i64)steps + 1

## `sum()` of a `list[float]`: the kernel's Neumaier sum, as Python's `sum` adds floats.
func float_sum(store: value.Object*) -> f64:
    var total = 0.0
    var compensation = 0.0
    var i: usize = 0
    while i < store.count:
        let x = store.fields[i].f
        let t = total + x
        if (-total if total < 0.0 else total) >= (-x if x < 0.0 else x):
            compensation += (total - t) + x
        else:
            compensation += (x - t) + total
        total = t
        i += 1
    if compensation != 0.0 and compensation - compensation == 0.0:
        total += compensation
    return total
