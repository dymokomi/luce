#==============================================================================================
#
#   interp/collections - The methods of lists, maps, sets and ranges
#
#   DESCRIPTION:
#       The operations of §6.6 and §11.1 to §11.2 over the interpreter's values, each the same
#       algorithm as the kernel's, so both executions answer alike.
#
#==============================================================================================
extend Interp:
    # mark: Collections =============================================================================

    ## A list's own method (§11.1), the same operation as the kernel's.
    mutating func list_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let l = try self.eval(receiver)
        let store = l.obj else error(fault, "no list")
        var args = try alloc value.Value[2]
        var n: usize = 0
        var cursor = e.body
        while let a = cursor:
            let v = a.left else error(fault, "empty argument")
            # a stored value is the list's own; a searched one is borrowed
            args[n] = try self.eval_owned(v) if name == "append" or name == "insert" else try self.eval(v)
            n += 1
            cursor = a.next
        if name == "append":
            try heap.append(store, args[0])
            return value.nothing()
        if name == "insert":
            let i = args[0].i
            if i < 0 or i > (i64)store.count:
                self.stop("index out of range")
            try heap.insert(store, (usize)i, args[1])
            return value.nothing()
        if name == "remove_at":
            let i = try checked_index(args[0].i, store.count)
            return heap.remove_at(store, i)
        if name == "pop":
            if store.count == 0:
                self.stop("pop of an empty list")
            return heap.remove_at(store, store.count - 1)
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "contains":
            return value.boolean(heap.find(store, args[0]) != none)
        if name == "index_of":
            let at = heap.find(store, args[0]) else return value.absent()
            return value.integer((i64)at)
        if name == "sort":
            heap.sort(store)
            return value.nothing()
        if name == "reverse":
            heap.reverse(store)
            return value.nothing()
        if name == "sorted" or name == "reversed" or name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            if name == "sorted":
                heap.sort(out)
            elif name == "reversed":
                heap.reverse(out)
            return value.collection(value.Kind.list_, out)
        if name == "join":
            var b = try strings.Builder.create(64)
            var i: usize = 0
            while i < store.count:
                if i > 0:
                    try b.put(args[0].s)
                try b.put(store.fields[i].s)
                i += 1
            let out = try strings.copy(b.view())
            b.destroy()
            return value.text(out)
        if name == "map" or name == "filter":
            let f = args[0]
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count:
                var one = try alloc value.Value[1]
                one[0] = store.fields[i]
                let r = try self.call_value(f, one)
                if name == "map":
                    try heap.push(out, r)
                elif value.truth(r):
                    try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
            return value.collection(value.Kind.list_, out)
        error(fault, "an unknown list method")

    ## A map's or a set's own method (§11.2), the same operation as the kernel's.
    mutating func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let m = try self.eval(receiver)
        let store = m.obj else error(fault, "no collection")
        var arg = value.nothing()
        if let first = e.body:
            let v = first.left else error(fault, "empty argument")
            arg = try self.eval_owned(v) if name == "insert" else try self.eval(v)
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            return value.collection(m.kind, out)
        if is_map:
            if name == "remove":
                let out = heap.map_remove(store, arg) else return value.absent()
                return out
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count:
                if name == "keys":
                    try heap.push(out, try heap.copy(store.fields[i]))
                elif name == "values":
                    try heap.push(out, try heap.copy(store.fields[i + 1]))
                else:
                    var pair = try value.members(value.Kind.tuple, 2, none)
                    pair.items[0] = try heap.copy(store.fields[i])
                    pair.items[1] = try heap.copy(store.fields[i + 1])
                    try heap.push(out, pair)
                i += 2
            return value.collection(value.Kind.list_, out)
        if name == "insert":
            try heap.set_insert(store, arg)
            return value.nothing()
        if name == "remove":
            return value.boolean(heap.set_remove(store, arg))
        # union, intersection, difference: a new set
        let other = arg.obj else error(fault, "no set")
        let out = try heap.allocate_collection(store.elem, types.none_id)
        var i: usize = 0
        if name == "union":
            while i < store.count:
                try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
            i = 0
            while i < other.count:
                try heap.set_insert(out, try heap.copy(other.fields[i]))
                i += 1
        else:
            while i < store.count:
                let present = heap.find(other, store.fields[i]) != none
                if present == (name == "intersection"):
                    try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
        return value.collection(value.Kind.set_, out)
