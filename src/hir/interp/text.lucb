#==============================================================================================
#
#   interp/text - The methods of texts and bytes
#
#   DESCRIPTION:
#       The operations of §11.3 and §11.4 over the interpreter's values, each the same
#       algorithm as the kernel's.
#
#==============================================================================================
extend Interp:
    # mark: Text ====================================================================================

    ## A text's or bytes' own method (§11.3, §11.4), the same operation as the kernel's. The
    ## checker named every argument by its parameter; a method of one takes the first.
    func text_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let v = try self.eval(receiver)
        if v.kind == value.Kind.blob:
            if name == "text":
                if not valid_utf8(v.b):
                    return try self.raise(0, "invalid UTF-8")
                return value.text(try strings.copy((str)v.b))
            error(fault, "an unknown bytes method")
        let text = v.s
        if e.body == none or name == "split":
            if name == "split":
                if let separator = ast.argument(e, "separator"):
                    return try self.split_text(text, (try self.eval(separator)).s)
            return try text_alone(text, name)
        if name == "replace":
            let old = try self.eval(ast.argument(e, "old") else error(fault, "no argument"))
            let new_text = try self.eval(ast.argument(e, "new") else error(fault, "no argument"))
            return try self.replace_text(text, old.s, new_text.s)
        if name == "pad_left" or name == "pad_right" or name == "center":
            let width = try self.eval(ast.argument(e, "width") else error(fault, "no width"))
            var fill = " "
            if let f = ast.argument(e, "fill"):
                fill = (try self.eval(f)).s
            return try padded_text(text, name, width.i, fill)
        let first = e.body else error(fault, "no argument")
        let arg = try self.eval(first.left else error(fault, "empty argument"))
        if name == "repeat":
            if arg.i < 0:
                self.stop("repeat of a negative count")
            var b: collections.Buffer
            defer b.destroy()
            var i: i64 = 0
            while i < arg.i:
                try b.put_text(text)
                i += 1
            return value.text(try strings.copy(b.text()))
        return try text_with(text, name, arg.s)

    ## `text.split(separator)`: the pieces between occurrences, as a list; an empty separator
    ## stops the program.
    func split_text(text: str, separator: str) -> value.Value!:
        if separator.length == 0:
            self.stop("split needs a separator")
        let out = try heap.allocate_collection(types.str_id, types.none_id)
        var start: usize = 0
        while true:
            let at = find_bytes(text.bytes, separator.bytes, start) else break
            try heap.push(out, value.text(try strings.copy((str)text.bytes[start..<at])))
            start = at + separator.length
        try heap.push(out, value.text(try strings.copy((str)text.bytes[start..])))
        return value.collection(value.Kind.list_, out)

    ## `text.replace(old, new)`: every occurrence of `old` replaced, left to right; an empty `old`
    ## stops the program.
    func replace_text(text: str, old: str, new_text: str) -> value.Value!:
        if old.length == 0:
            self.stop("replace needs a text to replace")
        var b: collections.Buffer
        var start: usize = 0
        while true:
            let at = find_bytes(text.bytes, old.bytes, start) else break
            try b.put_text((str)text.bytes[start..<at])
            try b.put_text(new_text)
            start = at + old.length
        try b.put_text((str)text.bytes[start..])
        let out = try strings.copy(b.text())
        b.destroy()
        return value.text(out)


## A method without arguments: a new text, a test of every scalar, or a list.
func text_alone(text: str, name: str) -> value.Value!:
    if name == "lines":
        return try text_lines(text)
    if name == "split":
        return try split_white(text)
    if name == "characters":
        let out = try heap.allocate_collection(types.str_id, types.none_id)
        var i: usize = 0
        while i < text.length:
            var n: usize = 1
            while i + n < text.length and (text.bytes[i + n] & 0xC0) == 0x80:
                n += 1
            try heap.push(out, value.text(try strings.copy((str)text.bytes[i..<i + n])))
            i += n
        return value.collection(value.Kind.list_, out)
    if name == "bytes":
        return value.blob(text.bytes)
    if name == "is_digit" or name == "is_alpha" or name == "is_alnum" or name == "is_space":
        return value.boolean(every_byte(text, name))
    if name == "trim" or name == "trim_start" or name == "trim_end":
        let b = text.bytes
        var start: usize = 0
        var end = b.length
        while name != "trim_end" and start < end and is_white(b[start]):
            start += 1
        while name != "trim_start" and end > start and is_white(b[end - 1]):
            end -= 1
        # a text of its own, as every other method answers: the receiver may go first
        return value.text(try strings.copy((str)b[start..<end]))
    return value.text(try cased_text(text, name))


## `text.lines()`: the text split at `\n`, a `\r` before it dropped, no empty last line.
func text_lines(text: str) -> value.Value!:
    let out = try heap.allocate_collection(types.str_id, types.none_id)
    let b = text.bytes
    var start: usize = 0
    var i: usize = 0
    while i < b.length:
        if b[i] == '\n':
            var end = i
            if end > start and b[end - 1] == '\r':
                end -= 1
            try heap.push(out, value.text(try strings.copy((str)b[start..<end])))
            start = i + 1
        i += 1
    if start < b.length:
        try heap.push(out, value.text(try strings.copy((str)b[start..])))
    return value.collection(value.Kind.list_, out)

# mark: Text helpers ===========================================================================

## ASCII white space, as the kernel's `is_white`: space, tab, line feed, carriage return,
## vertical tab, form feed.
func is_white(byte: u8) -> bool:
    return byte == ' ' or byte == '\t' or byte == '\n' or byte == '\r' or byte == 11 or byte == 12

func ascii_letter(byte: u8) -> bool:
    return (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z')

func upper_byte(byte: u8) -> u8:
    return byte - 32 if byte >= 'a' and byte <= 'z' else byte

func lower_byte(byte: u8) -> u8:
    return byte + 32 if byte >= 'A' and byte <= 'Z' else byte

## `split()`: the runs between runs of white space, no empty piece.
func split_white(text: str) -> value.Value!:
    let out = try heap.allocate_collection(types.str_id, types.none_id)
    let b = text.bytes
    var i: usize = 0
    while i < b.length:
        while i < b.length and is_white(b[i]):
            i += 1
        let start = i
        while i < b.length and not is_white(b[i]):
            i += 1
        if i > start:
            try heap.push(out, value.text(try strings.copy((str)b[start..<i])))
    return value.collection(value.Kind.list_, out)

## Every scalar in the ASCII class `is_digit`, `is_alpha`, `is_alnum` or `is_space` names,
## and at least one.
func every_byte(text: str, name: str) -> bool:
    if text.length == 0:
        return false
    for byte in text.bytes:
        let digit = byte >= '0' and byte <= '9'
        var fits = is_white(byte)
        if name == "is_digit":
            fits = digit
        elif name == "is_alpha":
            fits = ascii_letter(byte)
        elif name == "is_alnum":
            fits = digit or ascii_letter(byte)
        if not fits:
            return false
    return true

## `upper`, `lower`, `capitalize`, `title` (ASCII letters, as the kernel's) and `reversed`.
func cased_text(text: str, name: str) -> str!:
    var out = try new u8[text.length] ---
    if name == "reversed":
        var at = text.length
        var i: usize = 0
        while i < text.length:
            var n: usize = 1
            while i + n < text.length and (text.bytes[i + n] & 0xC0) == 0x80:
                n += 1
            at -= n
            memory.copy(out[at..], text.bytes[i..<i + n], n)
            i += n
        return (str)out
    var in_word = false
    var i: usize = 0
    while i < text.length:
        let byte = text.bytes[i]
        if name == "upper":
            out[i] = upper_byte(byte)
        elif name == "lower":
            out[i] = lower_byte(byte)
        elif name == "capitalize":
            out[i] = upper_byte(byte) if i == 0 else lower_byte(byte)
        elif ascii_letter(byte):
            out[i] = lower_byte(byte) if in_word else upper_byte(byte)
            in_word = true
        else:
            out[i] = byte
            in_word = byte >= 0x80
        i += 1
    return (str)out

## A method of one text argument: a search, a count, or the text without a prefix or suffix.
func text_with(text: str, name: str, arg: str) -> value.Value!:
    if name == "contains":
        return value.boolean(find_bytes(text.bytes, arg.bytes, 0) != none)
    if name == "starts_with":
        return value.boolean(arg.length <= text.length and (str)text.bytes[..<arg.length] == arg)
    if name == "ends_with":
        return value.boolean(arg.length <= text.length and (str)text.bytes[text.length - arg.length..] == arg)
    if name == "index_of":
        let at = find_bytes(text.bytes, arg.bytes, 0) else return value.absent()
        return value.integer((i64)scalar_length((str)text.bytes[..<at]))
    if name == "last_index_of":
        if arg.length > text.length:
            return value.absent()
        var i = text.length - arg.length + 1
        while i > 0:
            i -= 1
            if (str)text.bytes[i..<i + arg.length] == arg:
                return value.integer((i64)scalar_length((str)text.bytes[..<i]))
        return value.absent()
    if name == "count":
        if arg.length == 0:
            heap.stop("count needs a text to count")
        var n: i64 = 0
        var start: usize = 0
        while true:
            let at = find_bytes(text.bytes, arg.bytes, start) else break
            n += 1
            start = at + arg.length
        return value.integer(n)
    if name == "remove_prefix" and arg.length <= text.length and (str)text.bytes[..<arg.length] == arg:
        return value.text(try strings.copy((str)text.bytes[arg.length..]))
    if name == "remove_suffix" and arg.length <= text.length and (str)text.bytes[text.length - arg.length..] == arg:
        return value.text(try strings.copy((str)text.bytes[..<text.length - arg.length]))
    return value.text(try strings.copy(text))

## `pad_left`, `pad_right` and `center` to `width` scalars with `fill`, one scalar; `center`
## puts the odd one where Python's `str.center` does.
func padded_text(text: str, name: str, width: i64, fill: str) -> value.Value!:
    if scalar_length(fill) != 1:
        heap.stop("a fill is one scalar")
    let n = (i64)scalar_length(text)
    let margin = width - n if width > n else 0
    var left: i64 = 0
    if name == "pad_left":
        left = margin
    elif name == "center":
        left = margin // 2 + (margin & width & 1)
    var b: collections.Buffer
    defer b.destroy()
    for _ in 0..<left:
        try b.put_text(fill)
    try b.put_text(text)
    for _ in 0..<margin - left:
        try b.put_text(fill)
    return value.text(try strings.copy(b.text()))

