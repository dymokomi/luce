#==============================================================================================
#
#   interp/builtins - The core functions, the standard modules and formatted text
#
#   DESCRIPTION:
#       `print`, `assert`, `trap`, `error`, the conversions, a value's `hash()`, the functions
#       of the standard modules (§6.8), and formatted strings with their fields'
#       specifications (§3.3).
#
#==============================================================================================
import numerals
import support.number_text
import thread
import time

extend Interp:
    # mark: Core functions ==========================================================================

    ## The language's own functions.
    func core_call(e: ast.Node*, name: str) -> value.Value!:
        if name == "print":
            var b: collections.Buffer
            var cursor = e.body
            var first = true
            while let a = cursor:
                let v = a.left else error(fault, "empty argument")
                if not first:
                    try b.put_text(" ")
                first = false
                try self.show_value(&b, v.type_id, try self.eval(v))
                cursor = a.next
            try b.put_text("\n")
            _ = try self.out.write(b.view())
            b.destroy()
            return value.nothing()
        if name == "int":
            return try self.int_call(e)
        if standard.is_function(name):
            return try self.standard_function(e, name)
        let first = e.body else error(fault, "no argument")
        let arg = first.left else error(fault, "no argument")
        if name == "assert":
            let ok = value.truth(try self.eval(arg))
            if not ok:
                var message = try strings.join(["assert failed: ", e.text], "")
                if let second = first.next:
                    let m = second.left else error(fault, "no message")
                    let text = try self.eval(m)
                    message = try strings.join([message, ": ", text.s], "")
                # in a test's own body it fails the test (§17.3); anywhere else it traps
                if e.has(ast.flag_test_assert):
                    self.failed_at = self.at
                    return try self.raise(0, message)
                self.stop(message)
            return value.nothing()
        if name == "trap":
            let m = try self.eval(arg)
            self.stop(m.s)
        if name == "error":
            let second = first.next else error(fault, "no message")
            let m = second.left else error(fault, "no message")
            let code = try self.eval(arg)
            let message = try self.eval(m)
            return try self.raise(code.i, message.s)
        if name == "Weak":
            let v = try self.eval(arg)
            let o = v.obj else error(fault, "no object")
            return heap.weak_make(o)
        let v = try self.eval(arg)
        if name == "float":
            if v.kind == value.Kind.integer:
                return value.floating(f64(v.i))
            let trimmed = strings.trim(v.s)
            if not is_decimal(trimmed):
                return try self.raise(0, "not a number")
            let parsed = parse_float(trimmed) catch failure:
                return try self.raise(0, "not a number")
            return value.floating(parsed)
        if name == "bool":
            if v.s == "true":
                return value.boolean(true)
            if v.s == "false":
                return value.boolean(false)
            return try self.raise(0, "not a boolean")
        if name == "str":
            var b: collections.Buffer
            try self.show_value(&b, arg.type_id, v)
            let out = try strings.copy(b.text())
            b.destroy()
            return value.text(out)
        error(fault, "an unknown core function")

    ## `int(x)` of a `float`, truncated, or `int(text, base)` read as Python reads it (§6.5).
    func int_call(e: ast.Node*) -> value.Value!:
        let arg = ast.argument(e, "value") else error(fault, "no value")
        let v = try self.eval(arg)
        if v.kind == value.Kind.floating:
            if v.f != v.f or v.f >= 9223372036854775808.0 or v.f < -9223372036854775808.0:
                self.stop("integer conversion out of range")
            return value.integer(i64(v.f))
        var base: i64 = 10
        if let b = ast.argument(e, "base"):
            base = (try self.eval(b)).i
            if base < 2 or base > 36:
                self.stop("an integer's base is 2 to 36")
        let parsed = number_text.parse_int(v.s, base) else return try self.raise(0, "not an integer")
        return value.integer(parsed)

    ## `value.hash()` (§4.4): the number the runtime computes for the value.
    func hash_method(callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let v = try self.eval(receiver)
        return value.integer((i64)self.hash_value(hash_offset, receiver.type_id, v))

    ## The standard modules' functions (§6.8), as the kernel's.
    func standard_function(e: ast.Node*, name: str) -> value.Value!:
        if name == "console.read_line":
            return try self.read_line(e)
        if name == "time.now":
            return value.integer((i64)time.now())
        if name == "time.unix":
            return value.integer(time.unix())
        if name == "time.sleep":
            let s = try self.eval(ast.argument(e, "seconds") else error(fault, "no value"))
            let milliseconds = number_text.sleep_milliseconds(s.f if s.kind == value.Kind.floating else (f64)s.i) else self.stop("sleep length must be non-negative")
            thread.sleep(milliseconds)
            return value.nothing()
        if name == "math.min" or name == "math.max":
            let a = try self.eval(ast.argument(e, "a") else error(fault, "no value"))
            let b = try self.eval(ast.argument(e, "b") else error(fault, "no value"))
            # the first of equals, as Python's: the second only when strictly beyond
            let order = try self.compare_value(e.type_id, b, a)
            let second = order < 0 if name == "math.min" else order > 0
            return try heap.copy(b if second else a)
        if name == "math.round":
            let x = try self.eval(ast.argument(e, "x") else error(fault, "no value"))
            var digits: i64 = 0
            if let d = ast.argument(e, "digits"):
                digits = (try self.eval(d)).i
            let rounded = number_text.round(x.f, digits) else self.stop("the rounded value is too large for a float")
            return value.floating(rounded)
        let arg = ast.argument(e, "x" if name == "math.abs" else "s" if name == "text.code_of" else "n") else error(fault, "no value")
        let v = try self.eval(arg)
        if name == "math.abs":
            if v.kind == value.Kind.floating:
                return value.floating(number_text.absolute(v.f))
            if v.i == -9223372036854775807 - 1:
                self.stop("integer overflow")
            return value.integer(-v.i if v.i < 0 else v.i)
        if name == "text.code_of":
            if numerals.scalar_count(v.s.bytes) != 1:
                self.stop("text.code_of of a text that is not one scalar")
            return value.integer(number_text.scalar_value(v.s))
        let text = number_text.character(v.i) else self.stop("text.from_code of a number that is not a Unicode scalar")
        return value.text(text)

    ## `console.read_line(prompt)`: the prompt written, then a line of standard input without
    ## its line end (and a `\r` before it), none at the end of the input. A sandboxed run has
    ## none (§17.1). Read a byte at a time, as the kernel reads, so nothing past the line is
    ## taken.
    func read_line(e: ast.Node*) -> value.Value!:
        if let p = ast.argument(e, "prompt"):
            let prompt = try self.eval(p)
            _ = try self.out.write(prompt.s.bytes)
        if self.checker.sandbox_root.length > 0:
            return value.absent()
        var line: collections.Buffer
        defer line.destroy()
        var input = io.stdin()
        var one: u8[1]
        var read_any = false
        var ended = false
        while not ended:
            let n = input.read(one[..<1]) catch failure: recover 0
            if n == 0:
                break
            read_any = true
            if one[0] == '\n':
                ended = true
            else:
                _ = try line.write(one[..<1])
        if not read_any:
            return value.absent()
        var text = line.text()
        if ended and text.length > 0 and text.bytes[text.length - 1] == '\r':
            text = (str)text.bytes[..<text.length - 1]
        return value.text(try strings.copy(text))

    ## A formatted string: its text parts unescaped, each field shown as its type shows, or
    ## laid out by its specification (§3.3).
    func formatted(e: ast.Node*) -> value.Value!:
        var b: collections.Buffer
        var cursor = e.body
        while let part = cursor:
            if part.kind == ast.Kind.format_text:
                try b.put_text(try literals.unescape_format(part.text))
            else:
                let v = part.left else error(fault, "empty field")
                if part.text.length == 0:
                    try self.show_value(&b, v.type_id, try self.eval(v))
                else:
                    try self.format_field(&b, part.text, v)
            cursor = part.next
        let out = try strings.copy(b.text())
        b.destroy()
        return value.text(out)

    ## A field with a specification (§3.3): an `int` or a `float` laid out from its value,
    ## anything else from its display; `c` meeting no Unicode scalar traps.
    func format_field(b: collections.Buffer*, spec: str, v: ast.Node*) -> !:
        let x = try self.eval(v)
        var out = ""
        if v.type_id == types.int_id:
            out = number_text.format_int(x.i, spec) else self.stop("`c` formats a number that is not a Unicode scalar")
        elif v.type_id == types.float_id:
            out = number_text.format_float(x.f, spec)
        else:
            var shown: collections.Buffer
            defer shown.destroy()
            try self.show_value(&shown, v.type_id, x)
            out = number_text.format_text(shown.text(), spec)
        defer strings.release(out)
        try b.put_text(out)
