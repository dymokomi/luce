#==============================================================================================
#
#   heap - The interpreter's objects, by the runtime's contract
#
#   DESCRIPTION:
#       The interpreter's side of docs/RUNTIME.md: counts on every object, the temporaries
#       pool, the cycle collector, weak references, and the count of what is alive. It is
#       the same algorithm as Base's standard ownership module over the interpreter's
#       values, so that the two executions destroy objects in the same order, which
#       `deinit` makes observable. A `deinit` is run through the hook the interpreter
#       installs.
#
#==============================================================================================

import c
import front.ast
import hir.value
import io
import strings

let black: u8 = 0
let gray: u8 = 1
let white: u8 = 2
let purple: u8 = 3
let color_mask: u8 = 3
let buffered: u8 = 4
let dead: u8 = 8
let collecting: u8 = 16
## An object whose `init` failed, while `abandon` releases its fields: a release of it is
## bookkeeping only and the collector never walks into it.
let abandoning: u8 = 32

## How many possible cycle roots gather before the collector runs.
pub let candidate_limit: usize = 1024
## `LUCE_CYCLE_STRESS` in the environment: 0 not read yet, 1 absent, 2 present.
var stress_state: u8 = 0
extern func stress_getenv as "getenv"(name: c.str) -> c.str?

## Whether `LUCE_CYCLE_STRESS` is set: the collector then runs at every new candidate, as
## the compiled runtime's does (tools/cycles_fuzz.py). The interpreter runs on one thread.
func stressed() -> bool:
    if stress_state == 0:
        stress_state = 2 if stress_getenv("LUCE_CYCLE_STRESS") != none else 1
    return stress_state == 2

## Objects alive: allocated and not yet destroyed.
pub var live: usize = 0
## The serial the next object gets: the order objects are made in.
var next_serial: u64 = 1

## Runs a `deinit`: the interpreter, over its own state.
pub var finisher: (func(void*, value.Object*) -> unit)?
## The interpreter state every hook is called with.
pub var finisher_context: void*?

# mark: Objects ================================================================================

func color_of(o: value.Object*) -> u8:
    return o.flags & color_mask

func set_color(o: value.Object*, color: u8):
    o.flags = (o.flags & ~color_mask) | color

func has(o: value.Object*, flag: u8) -> bool:
    return (o.flags & flag) != 0

## A fresh object with `n` fields, each `unit` until set, held once.
pub func allocate(decl: ast.Node*, n: usize) -> value.Object*!:
    var fields = try new value.Value[n if n > 0 else 1] ---
    var i: usize = 0
    while i < n:
        fields[i] = value.nothing()
        i += 1
    let o = try new value.Object(strong = 1, weak = 0, flags = black, decl = decl, fields = fields[..<n], count = n, version = 0, elem = 0, value_type = 0, serial = next_serial)
    next_serial += 1
    live += 1
    return o

## A fresh, empty collection, held once, knowing its element types.
pub func allocate_collection(elem: u32, value_type: u32) -> value.Object*!:
    let fields = try new value.Value[4] ---
    let o = try new value.Object(strong = 1, weak = 0, flags = black, decl = none, fields = fields, count = 0, version = 0, elem = elem, value_type = value_type, serial = next_serial)
    next_serial += 1
    live += 1
    return o

## A trap asked of the interpreter, which names the statement it is running (§12.4).
pub var stop_hook: (func(void*, str) -> never)?

## Traps with `message`, through the interpreter's hook when one is installed.
pub func stop(message: str) -> never:
    if let f = stop_hook:
        if let context = finisher_context:
            f(context, message)
    trap(message)

## Equality by type, asked of the interpreter: a declared `equals` counts (§13.3).
pub var equal_hook: (func(void*, u32, value.Value, value.Value) -> bool)?

func same(elem: u32, a: value.Value, b: value.Value) -> bool:
    if let f = equal_hook:
        if let context = finisher_context:
            return f(context, elem, a, b)
    return value.equal(a, b)

# mark: Collections =============================================================================

## The same operations as rt/kernel.lucb's, over owned values; a structural change counts.
pub func reserve(o: value.Object*, n: usize) -> !:
    if n <= o.fields.length:
        return
    var size = o.fields.length * 2
    while size < n:
        size = size * 2
    var grown = try new value.Value[size] ---
    var i: usize = 0
    while i < o.count:
        grown[i] = o.fields[i]
        i += 1
    o.fields = grown

## Appends an owned value without counting a change (a literal being built).
pub func push(o: value.Object*, v: value.Value) -> !:
    try reserve(o, o.count + 1)
    o.fields[o.count] = v
    o.count += 1

## Appends an owned value at the end; a structural change.
pub func append(o: value.Object*, v: value.Value) -> !:
    try push(o, v)
    o.version += 1

## Inserts an owned value at `i`, moving the rest up; a structural change.
pub func insert(o: value.Object*, i: usize, v: value.Value) -> !:
    try reserve(o, o.count + 1)
    var k = o.count
    while k > i:
        o.fields[k] = o.fields[k - 1]
        k -= 1
    o.fields[i] = v
    o.count += 1
    o.version += 1

## The element removed, owned by the caller.
pub func remove_at(o: value.Object*, i: usize) -> value.Value:
    let out = o.fields[i]
    var k = i
    while k + 1 < o.count:
        o.fields[k] = o.fields[k + 1]
        k += 1
    o.count -= 1
    o.version += 1
    return out

## Releases every element and empties the collection; a structural change.
pub func clear(o: value.Object*):
    var i: usize = 0
    while i < o.count:
        let v = o.fields[i]
        o.fields[i] = value.nothing()
        release(v)
        i += 1
    o.count = 0
    o.version += 1

## Stores an owned value, letting the old one go.
pub func set(o: value.Object*, i: usize, v: value.Value):
    let old = o.fields[i]
    o.fields[i] = v
    release(old)

## Where `v` is among the elements, by the element type's equality.
pub func find(o: value.Object*, v: value.Value) -> usize?:
    var i: usize = 0
    while i < o.count:
        if same(o.elem, o.fields[i], v):
            return i
        i += 1
    return none

## Where `key` is among a map's entries, by the key type's equality.
pub func map_find(o: value.Object*, key: value.Value) -> usize?:
    var i: usize = 0
    while i < o.count:
        if same(o.elem, o.fields[i], key):
            return i
        i += 2
    return none

## Reverses the elements in place; a structural change.
pub func reverse(o: value.Object*):
    var i: usize = 0
    while i + 1 < o.count - i:
        let tmp = o.fields[i]
        o.fields[i] = o.fields[o.count - 1 - i]
        o.fields[o.count - 1 - i] = tmp
        i += 1
    o.version += 1

## A new collection of copies of the elements in `[low, high)`.
pub func sliced(o: value.Object*, low: usize, high: usize) -> value.Object*!:
    let out = try allocate_collection(o.elem, o.value_type)
    var i = low
    while i < high:
        try push(out, try copy(o.fields[i]))
        i += 1
    return out

## A `for` checks at the start of every step that the shape did not change.
pub func check(o: value.Object*, version: u64, what: str):
    if o.version != version:
        if what == "map":
            stop("the map changed while it was iterated")
        if what == "set":
            stop("the set changed while it was iterated")
        stop("the list changed while it was iterated")

## `m[key] = value`, both owned: an existing key keeps its place and lets its old value
## go, and the given key is let go of.
pub func map_set(o: value.Object*, key: value.Value, v: value.Value) -> !:
    if let at = map_find(o, key):
        let old = o.fields[at + 1]
        o.fields[at + 1] = v
        release(old)
        release(key)
        return
    try push(o, key)
    try push(o, v)
    o.version += 1

## The value of `key`, the caller's own, or none; the rest keep their order.
pub func map_remove(o: value.Object*, key: value.Value) -> value.Value?:
    let at = map_find(o, key) else return none
    let old_key = o.fields[at]
    let out = o.fields[at + 1]
    var k = at
    while k + 2 < o.count:
        o.fields[k] = o.fields[k + 2]
        k += 1
    o.count -= 2
    o.version += 1
    release(old_key)
    return out

## `s.insert(x)`, owned: let go of when it is there already.
pub func set_insert(o: value.Object*, v: value.Value) -> !:
    if find(o, v) != none:
        release(v)
        return
    try push(o, v)
    o.version += 1

## Removes and releases `v` from a set; whether it was there.
pub func set_remove(o: value.Object*, v: value.Value) -> bool:
    let at = find(o, v) else return false
    release(remove_at(o, at))
    return true

## Takes one more strong reference; a retained object is no cycle candidate.
pub func retain_object(o: value.Object*):
    o.strong += 1
    set_color(o, black)

## Drops one strong reference: at zero the object is destroyed, otherwise
## it may be a cycle's root and is noted for the collector.
pub func release_object(o: value.Object*):
    if has(o, collecting) or has(o, abandoning):
        if o.strong > 0:
            o.strong -= 1
        return
    o.strong -= 1
    if o.strong == 0:
        destroy(o)
    else:
        possible_root(o)

func run_finisher(o: value.Object*):
    if let f = finisher:
        let before = o.strong
        o.strong += 1
        f(finisher_context else trap("no interpreter behind the heap"), o)
        if o.strong != before + 1:
            stop("`deinit` published `self`")
        o.strong = before

## `deinit`, then the fields in reverse order; the shell stays for weak references.
func destroy(o: value.Object*):
    set_color(o, black)
    run_finisher(o)
    drop_fields(o)
    live -= 1
    o.flags |= dead

## A class releases its fields last first (§10.3); a collection its elements in order.
func drop_fields(o: value.Object*):
    if o.decl == none:
        var k: usize = 0
        while k < o.count:
            let f = o.fields[k]
            o.fields[k] = value.nothing()
            release(f)
            k += 1
        o.count = 0
        return
    var i = o.count
    while i > 0:
        i -= 1
        let f = o.fields[i]
        o.fields[i] = value.nothing()
        release(f)

## An `init` that failed: the fields assigned so far go, no `deinit` runs. A field that
## refers back to the object (a closure over `self`, a child holding its parent) lets go
## of it in the drop; a reference still held after that was published by the failed
## `init`, which stops the program, as the compiled runtime does.
pub func abandon(o: value.Object*):
    set_color(o, black)
    o.flags |= abandoning
    drop_fields(o)
    o.flags &= ~abandoning
    if o.strong != 1:
        stop("a failed `init` published `self`")
    live -= 1
    o.strong = 0
    o.flags |= dead

# mark: Values =================================================================================

## Whether a value can hold a reference at all, so the scalars cost nothing.
pub func holds_references(v: value.Value) -> bool:
    match v.kind:
        .object, .weak_, .list_, .map_, .set_, .cell_, .task_: return true
        .function: return v.obj != none
        .tuple, .record, .variant:
            var i: usize = 0
            while i < v.items.length:
                if holds_references(v.items[i]):
                    return true
                i += 1
            return false
        _: return false

## One more reference to every object the value holds.
pub func retain(v: value.Value):
    match v.kind:
        .object, .list_, .map_, .set_, .cell_, .function, .task_:
            if let o = v.obj:
                retain_object(o)
        .weak_:
            if let o = v.obj:
                o.weak += 1
        .tuple, .record, .variant:
            var i: usize = 0
            while i < v.items.length:
                retain(v.items[i])
                i += 1
        _: _ = 0

## One reference fewer to every object the value holds.
pub func release(v: value.Value):
    match v.kind:
        .object, .list_, .map_, .set_, .cell_, .function, .task_:
            if let o = v.obj:
                release_object(o)
        .weak_:
            if let o = v.obj:
                o.weak -= 1
        .tuple, .record, .variant:
            var i: usize = 0
            while i < v.items.length:
                release(v.items[i])
                i += 1
        _: _ = 0

## An owned copy: its own storage for a value type, a reference of its own to every object.
pub func copy(v: value.Value) -> value.Value!:
    let out = try value.clone(v)
    retain(out)
    return out

## A value as a worker receives it (§14): the same scalars and texts, a fresh copy of every
## collection with its elements sent in turn, so nothing is shared.
pub func send(v: value.Value) -> value.Value!:
    match v.kind:
        .list_, .map_, .set_:
            let o = v.obj else return v
            let out = try allocate_collection(o.elem, o.value_type)
            var i: usize = 0
            while i < o.count:
                try push(out, try send(o.fields[i]))
                i += 1
            return value.collection(v.kind, out)
        .tuple, .record, .variant:
            var out = v
            out.items = try new value.Value[v.items.length if v.items.length > 0 else 1] ---
            var i: usize = 0
            while i < v.items.length:
                out.items[i] = try send(v.items[i])
                i += 1
            out.items = out.items[..<v.items.length]
            return out
        _: return v

## The objects a value refers to directly, in order.
func trace(v: value.Value, visit: func(value.Object*) -> unit):
    match v.kind:
        .object, .list_, .map_, .set_, .cell_, .function, .task_:
            if let o = v.obj:
                visit(o)
        .tuple, .record, .variant:
            var i: usize = 0
            while i < v.items.length:
                trace(v.items[i], visit)
                i += 1
        _: _ = 0

func trace_fields(o: value.Object*, visit: func(value.Object*) -> unit):
    var i: usize = 0
    while i < o.count:
        trace(o.fields[i], visit)
        i += 1

# mark: The temporaries pool ===================================================================

var pending: value.Value[]
var pending_count: usize = 0

## Where the temporaries pool stands now, for a later `drain` back to it.
pub func mark() -> usize:
    return pending_count

## An owned value handed on as a temporary: released by the next `drain`.
pub func pool(v: value.Value) -> !:
    if not holds_references(v):
        return
    if pending_count == pending.length:
        pending = try grow(pending, pending_count, 64)
    pending[pending_count] = v
    pending_count += 1

## Releases every temporary pooled since `since`, in the order they were pooled.
pub func drain(since: usize):
    if pending_count <= since:
        return
    # a release may pool temporaries of its own (a `deinit` can): they are released too,
    # in the order pooled, before the pool goes back to `since`
    var i = since
    while i < pending_count:
        release(pending[i])
        i += 1
    pending_count = since

# mark: The cycle collector ====================================================================

var roots: value.Object*[]
var root_count: usize = 0
var whites: value.Object*[]
var white_count: usize = 0
var collector_running: bool = false

func push_root(o: value.Object*):
    if root_count == roots.length:
        roots = grow(roots, root_count, candidate_limit) catch failure:
            stop("out of memory")
    roots[root_count] = o
    root_count += 1

func push_white(o: value.Object*):
    if white_count == whites.length:
        whites = grow(whites, white_count, 256) catch failure:
            stop("out of memory")
    whites[white_count] = o
    white_count += 1

func possible_root(o: value.Object*):
    if color_of(o) != purple:
        set_color(o, purple)
        if not has(o, buffered):
            o.flags |= buffered
            push_root(o)
            if (root_count >= candidate_limit or stressed()) and not collector_running:
                collect()

func visit_mark_gray(child: value.Object*):
    if has(child, abandoning):
        return
    child.strong -= 1
    mark_gray(child)

func mark_gray(o: value.Object*):
    if color_of(o) != gray:
        set_color(o, gray)
        trace_fields(o, visit_mark_gray)

func visit_scan(child: value.Object*):
    if has(child, abandoning):
        return
    scan(child)

func visit_scan_black(child: value.Object*):
    if has(child, abandoning):
        return
    child.strong += 1
    if color_of(child) != black:
        scan_black(child)

func scan(o: value.Object*):
    if color_of(o) == gray:
        if o.strong > 0:
            scan_black(o)
        else:
            set_color(o, white)
            trace_fields(o, visit_scan)

func scan_black(o: value.Object*):
    set_color(o, black)
    trace_fields(o, visit_scan_black)

func visit_gather(child: value.Object*):
    if has(child, abandoning):
        return
    gather(child)

func gather(o: value.Object*):
    if color_of(o) == white and not has(o, collecting):
        o.flags |= collecting
        push_white(o)
        trace_fields(o, visit_gather)

## Undo the trial deletion of one edge out of a garbage object, whether it points at more
## garbage or at a live object, so every field release below is an ordinary one: a live object
## loses exactly the reference the garbage held, where it once lost two (RUNTIME, Cycles).
func visit_restore(child: value.Object*):
    if has(child, abandoning):
        return
    child.strong += 1

## The garbage in the order its objects were made, oldest first: what a cycle's deinits and
## the releases of its fields follow, the same in the interpreter and a compiled program
## whatever let go of what when (a heap sort, in place).
func sort_whites():
    var start = white_count // 2
    while start > 0:
        start -= 1
        sift_white(start, white_count)
    var end = white_count
    while end > 1:
        end -= 1
        let top = whites[0]
        whites[0] = whites[end]
        whites[end] = top
        sift_white(0, end)

func sift_white(first: usize, end: usize):
    var root = first
    while root * 2 + 1 < end:
        var child = root * 2 + 1
        if child + 1 < end and whites[child + 1].serial > whites[child].serial:
            child += 1
        if whites[root].serial >= whites[child].serial:
            return
        let held = whites[root]
        whites[root] = whites[child]
        whites[child] = held
        root = child

## Free the garbage: deinits first, then every object's fields, then the shells.
pub func collect():
    if collector_running:
        return
    collector_running = true
    var kept: usize = 0
    var i: usize = 0
    while i < root_count:
        let o = roots[i]
        if color_of(o) == purple and o.strong > 0 and not has(o, dead):
            roots[kept] = o
            kept += 1
        else:
            o.flags &= ~buffered
        i += 1
    root_count = kept
    i = 0
    while i < root_count:
        mark_gray(roots[i])
        i += 1
    i = 0
    while i < root_count:
        scan(roots[i])
        i += 1
    white_count = 0
    i = 0
    while i < root_count:
        gather(roots[i])
        i += 1
    i = 0
    while i < root_count:
        roots[i].flags &= ~buffered
        i += 1
    root_count = 0
    sort_whites()
    i = 0
    while i < white_count:
        trace_fields(whites[i], visit_restore)
        i += 1
    i = 0
    while i < white_count:
        run_finisher(whites[i])
        i += 1
    i = 0
    while i < white_count:
        drop_fields(whites[i])
        i += 1
    i = 0
    while i < white_count:
        let o = whites[i]
        live -= 1
        o.strong = 0
        o.flags = dead
        i += 1
    white_count = 0
    collector_running = false

# mark: Weak references ========================================================================

## A weak reference to `o`, counted on it.
pub func weak_make(o: value.Object*) -> value.Value:
    o.weak += 1
    return value.weak(o)

## The object with a fresh strong reference, or none once it is dead.
pub func weak_get(w: value.Value) -> value.Value:
    if let o = w.obj:
        if not has(o, dead):
            retain_object(o)
            return value.object(o)
    return value.absent()

# mark: The end of a run =======================================================================

## After `main`: the collector runs, and anything still alive is a defect. The exit status.
pub func finish_run(status: i64) -> i64:
    drain(0)
    collect()
    if live != 0:
        var line: u8[96]
        let text = strings.format(line, f"luce: {live} objects alive at exit\n") catch failure:
            recover "luce: objects alive at exit\n"
        var e = io.stderr()
        _ = e.write(text.bytes) catch failure: recover 0
        return 3
    return status

## For tests: the heap as at the start of a run.
pub func reset():
    roots = roots[..<0]
    root_count = 0
    whites = whites[..<0]
    white_count = 0
    pending = pending[..<0]
    pending_count = 0
    live = 0
    finisher = none
    finisher_context = none

## `items` with room for twice as many (`least` when it had none), its first `count`
## kept and its old storage freed: the growth of the heap's own lists.
func grow[T](items: T[], count: usize, least: usize) -> T[]!:
    let grown = try new T[items.length * 2 if items.length > 0 else least] ---
    for i in 0..<count:
        grown[i] = items[i]
    if items.length > 0:
        free(items)
    return grown
