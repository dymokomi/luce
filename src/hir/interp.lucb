#==============================================================================================
#
#   interp - The semantic oracle
#
#   DESCRIPTION:
#       Executes the typed tree directly: `luce run`, and the definition of behaviour that
#       the emitted Base must agree with. Every binding is a cell on the heap; a value type
#       is copied when bound, stored or returned, a reference type shares. Objects live on
#       `hir.heap` by docs/RUNTIME.md: `evaluate` says of every value whether the caller
#       owns it or borrows it, a binding owns what it holds and releases it when it goes,
#       and an owned value nobody binds is pooled and drained when its statement ends, so
#       the order in which `deinit` runs is the one the emitted program shows. Control flow
#       leaves a block as a `Flow`; a Luce failure travels as Base's own failure with the
#       `Error` kept aside; a violated rule traps through Base's `trap`, with the text the
#       emitted program's trap carries.
#
#==============================================================================================

import c
import front.ast
import hir.heap
import hir.value
import io
import memory
import process
import sema.check
import sema.types
import strings
import support.list
import support.literals

## A Luce failure passing through the interpreter's own results.
pub let luce_failure: ErrorCode = ErrorCode.package(13)
## An interpreter fault: something the checker should have refused.
let fault: ErrorCode = ErrorCode.package(14)

let max_depth: u32 = 4000

pub enum Flow as u8:
    normal = 0
    returned = 1
    broke = 2
    continued = 3
    recovered = 4

## One binding of a frame: its declaration, its cell, and whether the cell owns what it
## holds (a parameter borrows, §RUNTIME).
struct Slot:
    var decl: ast.Node*
    var cell: value.Value*
    var owned: bool

## A place evaluated ahead of its value (§5.3): a binding's or a field's slot, or a
## collection with the key or index to store at, checked when the store happens.
struct Prepared:
    var cell: value.Value*?
    var store: value.Object*?
    var key: value.Value
    var is_map: bool

pub struct Interp:
    var checker: check.Checker*
    var slots: list.List[Slot]
    ## The first slot of the current frame: a name resolves within it.
    var base: usize
    var depth: u32
    ## The control flow leaving the statement just run, its label, and its value.
    var flow: Flow
    var label: str
    var carried: value.Value
    ## The `Error` of the failure in flight.
    pub var pending: value.Value
    ## The statement being run, what a trap names (§12.4); the caller's again on return.
    var at: ast.Node*?
    var out: io.Writer

    pub static func over(checker: check.Checker*) -> Interp!:
        return Interp(checker = checker, slots = try list.List[Slot].create(256), base = 0, depth = 0, flow = Flow.normal,
                      label = "", carried = value.nothing(), pending = value.nothing(), out = io.stdout())

    # -- running --------------------------------------------------------------------------

    ## Run `main` with the program's arguments; its result, or the failure it ended with.
    ## After `main`, the collector runs and what is still alive is reported (RUNTIME).
    pub mutating func run_main(arguments: str[]) -> i64!:
        let main = self.checker.find_declaration("main") else error(fault, "no main")
        let store = try heap.allocate_collection(types.str_id, types.none_id)
        for a in arguments:
            try heap.push(store, value.text(a))
        let args = value.collection(value.Kind.list_, store)
        var one = try alloc value.Value[1]
        one[0] = args
        let result = self.call(main, none, one) catch failure:
            heap.release(args)
            error(failure.code, failure.message)
        heap.release(args)
        return heap.finish_run(result.i)

    ## Run one `test`: fails when the test does.
    pub mutating func run_test(d: ast.Node*) -> !:
        let body = d.body else return
        self.push_frame()
        try self.block(body)
        self.pop_frame()

    ## Every `test` of the program's own modules, in order, each reported as `luce test`
    ## prints it (§17.3); the status, with the heap's word on what was left alive.
    pub mutating func run_tests() -> i32!:
        var total: i64 = 0
        var failures: i64 = 0
        var k: usize = 0
        while k < self.checker.order.count:
            let index = (usize)self.checker.order.get(k)
            k += 1
            let m = self.checker.modules.get(index)
            if index == 0 or m.base:
                continue
            var cursor = m.tree.body
            while let d = cursor:
                if d.kind == ast.Kind.test_:
                    total += 1
                    let name = try literals.decode_text(d.text)
                    var passed = true
                    self.run_test(d) catch failure:
                        if failure.code != luce_failure:
                            error(failure.code, failure.message)
                        passed = false
                        failures += 1
                        let (line, column) = m.src.position(d.start)
                        var buffer: u8[256]
                        let at = try format(buffer, f"{m.src.path}:{line}:{column}")
                        try test_failed(name, at, self.pending.s)
                        self.flow = Flow.normal
                        recover ()
                    if passed:
                        try test_passed(name)
                    heap.drain(0)
                cursor = d.next
        let status = try test_summary(total, failures)
        return i32(heap.finish_run((i64)status))

    ## `deinit` on an object being destroyed, through the heap's hook: the interpreter's
    ## flow is kept aside, since destruction may happen while a `return` is in flight.
    mutating func run_deinit(o: value.Object*) -> !:
        let owner = o.decl else return
        if owner.kind != ast.Kind.class_:
            return
        let d = self.checker.find_member(owner, "deinit") else return
        let flow = self.flow
        let label = self.label
        let carried = self.carried
        let pending = self.pending
        let cell = try new value.Value
        *cell = value.object(o)
        discard(try self.call(d, cell, try alloc value.Value[0]))
        self.flow = flow
        self.label = label
        self.carried = carried
        self.pending = pending

    # -- frames ---------------------------------------------------------------------------

    mutating func push_frame():
        self.base = self.slots.count

    mutating func pop_frame():
        self.pop_to(self.base)

    ## An owned value, bound: the cell holds the one reference. A `var` some closure
    ## captures is bound to a cell object instead, which the closures share (§7.4).
    mutating func bind(decl: ast.Node*, v: value.Value) -> !:
        let cell = try new value.Value
        if decl.has(ast.flag_captured):
            let o = try heap.allocate(decl, 1)
            o.fields[0] = v
            *cell = value.cell(o)
        else:
            *cell = v
        try self.slots.push(Slot(decl = decl, cell = cell, owned = true))

    ## A parameter: it borrows what the caller holds for the length of the call.
    mutating func bind_borrowed(decl: ast.Node*, v: value.Value) -> !:
        let cell = try new value.Value
        *cell = v
        try self.slots.push(Slot(decl = decl, cell = cell, owned = false))

    ## Leave the bindings above `mark`: later ones first, each releasing what it owned.
    mutating func pop_to(mark: usize):
        var i = self.slots.count
        while i > mark:
            i -= 1
            let s = self.slots.get(i)
            if s.owned:
                let v = *s.cell
                *s.cell = value.nothing()
                heap.release(v)
        self.slots.count = mark

    func cell_of(decl: ast.Node*) -> value.Value*!:
        let slot = try self.slot_of(decl)
        if slot.kind == value.Kind.cell_:
            let o = slot.obj else error(fault, "an empty cell")
            return &o.fields[0]
        return slot

    ## The slot itself, a cell object when the binding is a captured `var`.
    func slot_of(decl: ast.Node*) -> value.Value*!:
        var i = self.slots.count
        while i > self.base:
            i -= 1
            let s = self.slots.get(i)
            if s.decl == decl:
                return s.cell
        error(fault, "an unbound name reached the interpreter")

    # -- calls ----------------------------------------------------------------------------

    ## Call a function or method with its arguments in parameter order (`self` excluded);
    ## the arguments are borrowed, the result is owned by the caller.
    pub mutating func call(f: ast.Node*, receiver: value.Value*?, args: value.Value[]) -> value.Value!:
        let body = f.body else error(fault, "a function without a body")
        if self.depth >= max_depth:
            self.stop("call depth exceeded")
        self.depth += 1
        let saved_base = self.base
        let saved_count = self.slots.count
        self.base = self.slots.count
        var i: usize = 0
        var cursor = f.right
        while let p = cursor:
            if p.text == "self":
                let r = receiver else error(fault, "a method without a receiver")
                try self.slots.push(Slot(decl = p, cell = r, owned = false))
            else:
                try self.bind_borrowed(p, args[i])
                i += 1
            cursor = p.next
        # a lambda's captures: each outer name bound to what the closure holds, a `let`
        # as the copy it took, a `var` as the shared cell (§7.4)
        if f.kind == ast.Kind.lambda:
            let env = receiver else error(fault, "a closure without its environment")
            let o = env.obj else error(fault, "a closure without its environment")
            var k: usize = 0
            var capture = f.left
            while let cap = capture:
                let decl = cap.resolved else error(fault, "an unresolved capture")
                try self.slots.push(Slot(decl = decl, cell = &o.fields[k], owned = false))
                k += 1
                capture = cap.next
        # a failure leaving the body restores the caller's frame before it travels on
        let saved_at = self.at
        self.run_body(f, body) catch failure:
            self.flow = Flow.normal
            let pending = self.pending
            self.pop_to(saved_count)
            self.pending = pending
            self.base = saved_base
            self.depth -= 1
            self.at = saved_at
            error(failure.code, failure.message)
        self.at = saved_at
        var result = value.nothing()
        if self.flow == Flow.returned:
            result = self.carried
            self.carried = value.nothing()
        self.flow = Flow.normal
        self.pop_to(saved_count)
        self.base = saved_base
        self.depth -= 1
        return result

    ## A function's suite, or an expression lambda's expression as its returned value.
    mutating func run_body(f: ast.Node*, body: ast.Node*) -> !:
        if f.kind == ast.Kind.lambda and not f.has(ast.flag_block_lambda):
            # the expression is the statement a trap in it names (§12.4)
            self.at = body
            let mark = heap.mark()
            self.carried = try self.eval_owned(body)
            heap.drain(mark)
            self.flow = Flow.returned
            return
        try self.block(body)

    ## The arguments of a call in parameter order, defaults filled in, on the heap; each
    ## is borrowed for the call, a temporary among them pooled until the statement ends.
    mutating func arguments(e: ast.Node*, params: ast.Node*?, skip_self: bool) -> value.Value[]!:
        var n: usize = 0
        var cursor = params
        while let p = cursor:
            if counts_as_param(p, skip_self):
                n += 1
            cursor = p.next
        var out = try alloc value.Value[n if n > 0 else 1]
        var given = try alloc bool[n if n > 0 else 1]
        var i: usize = 0
        while i < n:
            given[i] = false
            i += 1
        # arguments evaluate left to right, in the order written
        var a = e.body
        while let arg = a:
            let p = arg.resolved else error(fault, "an argument without its parameter")
            let v = arg.left else error(fault, "an empty argument")
            let slot = try index_of_param(params, p, skip_self)
            out[slot] = try self.eval(v)
            given[slot] = true
            a = arg.next
        i = 0
        cursor = params
        while let p = cursor:
            if counts_as_param(p, skip_self):
                if not given[i]:
                    let d = p.left else error(fault, "a missing argument without a default")
                    out[i] = try self.eval(d)
                i += 1
            cursor = p.next
        return out[..<n]

    # -- statements -----------------------------------------------------------------------

    ## Run a block; `self.flow` says how it left. Its bindings go when it does.
    mutating func block(b: ast.Node*) -> !:
        let mark = self.slots.count
        var cursor = b.body
        while let s = cursor:
            try self.statement(s)
            if self.flow != Flow.normal:
                break
            cursor = s.next
        self.pop_to(mark)

    ## One statement: the temporaries it produces die when it ends, however it ends.
    mutating func statement(s: ast.Node*) -> !:
        self.at = s
        let mark = heap.mark()
        self.run_statement(s) catch failure:
            let pending = self.pending
            heap.drain(mark)
            self.pending = pending
            error(failure.code, failure.message)
        heap.drain(mark)

    mutating func run_statement(s: ast.Node*) -> !:
        match s.kind:
            .let_, .var_:
                let init = s.left else return
                let v = try self.eval_owned(init)
                if s.body != none:
                    # the tuple's members move into the bindings
                    var i: usize = 0
                    var cursor = s.body
                    while let part = cursor:
                        try self.bind(part, v.items[i])
                        i += 1
                        cursor = part.next
                else:
                    try self.bind(s, v)
            .assign: try self.assign(s)
            .if_: try self.if_statement(s)
            .while_:
                while true:
                    let mark = heap.mark()
                    if s.has(ast.flag_if_let):
                        let cond = s.left else return
                        let init = cond.left else return
                        let (v, owned) = try self.evaluate(init)
                        if v.kind == value.Kind.absent:
                            heap.drain(mark)
                            break
                        let slots = self.slots.count
                        try self.bind(cond, v if owned else try heap.copy(v))
                        heap.drain(mark)
                        let body = s.body else return
                        try self.block(body)
                        self.pop_to(slots)
                    else:
                        let cond = s.left else return
                        let go = value.truth(try self.eval(cond))
                        heap.drain(mark)
                        if not go:
                            break
                        let body = s.body else return
                        try self.block(body)
                    if self.flow == Flow.broke and (self.label.length == 0 or self.label == s.text):
                        self.flow = Flow.normal
                        break
                    if self.flow == Flow.continued and (self.label.length == 0 or self.label == s.text):
                        self.flow = Flow.normal
                        continue
                    if self.flow != Flow.normal:
                        break
            .for_: try self.for_statement(s)
            .match_: try self.match_statement(s)
            .with_: try self.with_statement(s)
            .return_:
                var v = value.nothing()
                if let e = s.left:
                    v = try self.eval_owned(e)
                self.carried = v
                self.flow = Flow.returned
            .break_:
                self.flow = Flow.broke
                self.label = s.text
            .continue_:
                self.flow = Flow.continued
                self.label = s.text
            .recover_:
                let e = s.left else return
                self.carried = try self.eval_owned(e)
                self.flow = Flow.recovered
            .expr_stmt:
                let e = s.left else return
                discard(try self.eval(e))
            _: error(fault, "unexpected statement")

    ## The condition's temporaries die before a branch runs.
    mutating func if_statement(s: ast.Node*) -> !:
        let slots = self.slots.count
        var taken = false
        let mark = heap.mark()
        if s.has(ast.flag_if_let):
            let cond = s.left else return
            let init = cond.left else return
            let (v, owned) = try self.evaluate(init)
            if v.kind != value.Kind.absent:
                try self.bind(cond, v if owned else try heap.copy(v))
                taken = true
        else:
            let cond = s.left else return
            taken = value.truth(try self.eval(cond))
        heap.drain(mark)
        if taken:
            let body = s.body else return
            try self.block(body)
        elif let rest = s.right:
            if rest.kind == ast.Kind.if_:
                try self.if_statement(rest)
            else:
                try self.block(rest)
        self.pop_to(slots)

    mutating func for_statement(s: ast.Node*) -> !:
        let binding = s.left else return
        let seq = s.right else return
        let body = s.body else return
        # the sequence lives until the loop ends: a temporary among the statement's
        let source = try self.eval(seq)
        var count: usize = 0
        if let iterator_method = s.resolved:
            # `Iterable` (§13.3): `iterator()` once, then `next()` until it answers none
            let cell = try new value.Value
            *cell = source
            var target = iterator_method
            if iterator_method.body == none:
                let owner = source.decl else error(fault, "an iterable without a declaration")
                target = self.checker.find_member(owner, "iterator") else error(fault, "a conformance without iterator")
            let it = try self.call(target, cell, try alloc value.Value[0])
            let it_cell = try new value.Value
            *it_cell = it
            let owner = it.decl else error(fault, "an iterator without a declaration")
            let next = self.checker.find_member(owner, "next") else error(fault, "a conformance without next")
            while true:
                let element = try self.call(next, it_cell, try alloc value.Value[0])
                if element.kind == value.Kind.absent:
                    break
                let stop = try self.iteration(s, binding, body, element)
                heap.release(element)
                if stop:
                    break
            heap.release(it)
            return
        match source.kind:
            .range_:
                var i = source.i
                let limit = source.hi + 1 if source.inclusive else source.hi
                while i < limit:
                    if try self.iteration(s, binding, body, value.integer(i)):
                        break
                    i += 1
                return
            .list_, .set_:
                # the kernel's protocol: the check, the bound, the element, the step, the body
                let store = source.obj else error(fault, "no collection")
                let version = store.version
                var i: usize = 0
                while true:
                    heap.check(store, version, "set" if source.kind == value.Kind.set_ else "list")
                    if i >= store.count:
                        break
                    let element = store.fields[i]
                    i += 1
                    if try self.iteration(s, binding, body, element):
                        break
                return
            .map_:
                let store = source.obj else error(fault, "no map")
                let version = store.version
                var i: usize = 0
                while true:
                    heap.check(store, version, "map")
                    if i >= store.count:
                        break
                    var pair = try value.members(value.Kind.tuple, 2, none)
                    pair.items[0] = store.fields[i]
                    pair.items[1] = store.fields[i + 1]
                    i += 2
                    if try self.iteration(s, binding, body, pair):
                        break
                return
            .text:
                let b = source.s.bytes
                var i: usize = 0
                while i < b.length:
                    var n: usize = 1
                    while i + n < b.length and (b[i + n] & 0xC0) == 0x80:
                        n += 1
                    if try self.iteration(s, binding, body, value.text((str)b[i..<i + n])):
                        break
                    i += n
                return
            .blob:
                var i: usize = 0
                while i < source.b.length:
                    if try self.iteration(s, binding, body, value.integer((i64)source.b[i])):
                        break
                    i += 1
                return
            _: error(fault, "cannot iterate this value")

    ## One pass of a `for` body with the element bound; `break`/`continue` settled here.
    ## Whether the loop stops.
    mutating func iteration(s: ast.Node*, binding: ast.Node*, body: ast.Node*, element: value.Value) -> bool!:
        let mark = self.slots.count
        if binding.body != none:
            var i: usize = 0
            var cursor = binding.body
            while let part = cursor:
                try self.bind(part, try heap.copy(element.items[i]))
                i += 1
                cursor = part.next
        else:
            try self.bind(binding, try heap.copy(element))
        try self.block(body)
        self.pop_to(mark)
        if self.flow == Flow.broke and (self.label.length == 0 or self.label == s.text):
            self.flow = Flow.normal
            self.label = ""
            return true
        if self.flow == Flow.continued and (self.label.length == 0 or self.label == s.text):
            self.flow = Flow.normal
            self.label = ""
            return false
        return self.flow != Flow.normal

    mutating func match_statement(s: ast.Node*) -> !:
        let subject = s.left else return
        let v = try self.eval(subject)
        var cursor = s.body
        while let arm = cursor:
            let mark = self.slots.count
            if try self.arm_matches(arm, v):
                let body = arm.body else return
                try self.block(body)
                self.pop_to(mark)
                return
            self.pop_to(mark)
            cursor = arm.next
        trap("no arm of the match applied")

    ## Whether an arm's patterns match `v`, binding what they bind; the guard included.
    mutating func arm_matches(arm: ast.Node*, v: value.Value) -> bool!:
        var p = arm.left
        var any = false
        while let pattern = p:
            if try self.pattern_matches(pattern, v):
                any = true
                break
            p = pattern.next
        if not any:
            return false
        if let guard = arm.right:
            return value.truth(try self.eval(guard))
        return true

    mutating func pattern_matches(p: ast.Node*, v: value.Value) -> bool!:
        if p.has(ast.flag_wildcard):
            return true
        if p.text == "bind":
            let name = p.left else return true
            try self.bind(name, try heap.copy(v))
            return true
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            while let sub = cursor:
                if not try self.pattern_matches(sub, v.items[i]):
                    return false
                i += 1
                cursor = sub.next
            return true
        if p.text == "none":
            return v.kind == value.Kind.absent
        let lit = p.left else return false
        if lit.kind == ast.Kind.case_value:
            let case_node = lit.resolved else return false
            if v.kind == value.Kind.absent or v.case_node != case_node:
                return false
            var i: usize = 0
            var cursor = lit.body
            while let name = cursor:
                if not name.has(ast.flag_wildcard):
                    try self.bind(name, try heap.copy(v.items[i]))
                i += 1
                cursor = name.next
            return true
        if p.text == "..<" or p.text == "..=":
            let hi = p.right else return false
            let low = try self.eval(lit)
            let high = try self.eval(hi)
            if v.kind == value.Kind.absent:
                return false
            return v.i >= low.i and (v.i < high.i if p.text == "..<" else v.i <= high.i)
        if v.kind == value.Kind.absent:
            return false
        return value.equal(try self.eval(lit), v)

    ## `with e as name:` closes `name` however the suite ends (§8.5), then lets it go.
    mutating func with_statement(s: ast.Node*) -> !:
        let body = s.body else return
        let mark = self.slots.count
        var cursor = s.left
        while let item = cursor:
            let e = item.left else return
            try self.bind(item, try self.eval_owned(e))
            cursor = item.next
        var failed = false
        var code = luce_failure
        var message: str = ""
        var pending = self.pending
        self.block(body) catch failure:
            failed = true
            code = failure.code
            message = failure.message
            pending = self.pending
        # the suite's flow, a `return` or a `break`, survives the closing calls
        let flow = self.flow
        let label = self.label
        let carried = self.carried
        self.flow = Flow.normal
        # last first: each is closed through its `close`, then let go of
        var n = ast.count(s.left)
        while n > 0:
            n -= 1
            var i: usize = 0
            var it = s.left
            while let item = it:
                if i == n:
                    let close = item.resolved else return
                    let cell = try self.cell_of(item)
                    discard(try self.call(close, cell, try alloc value.Value[0]))
                    self.pop_to(mark + n)
                i += 1
                it = item.next
        self.pop_to(mark)
        self.flow = flow
        self.label = label
        self.carried = carried
        if failed:
            self.pending = pending
            error(code, message)

    # -- places and assignment ------------------------------------------------------------

    ## The cell an assignable expression names.
    mutating func place(e: ast.Node*) -> value.Value*!:
        match e.kind:
            .name:
                let d = e.resolved else error(fault, "an unresolved place")
                return try self.cell_of(d)
            .self_:
                let d = self.self_param() else error(fault, "no self")
                return try self.cell_of(d)
            .member:
                let receiver = e.left else error(fault, "no receiver")
                let field = e.resolved else error(fault, "no field")
                let owner = self.checker.table.get(receiver.type_id).decl else error(fault, "no owner")
                let index = field_index(owner, field)
                if self.checker.table.kind(receiver.type_id) == types.Kind.class_:
                    # any expression yields the object; its field is the place
                    let v = try self.eval(receiver)
                    let o = v.obj else error(fault, "no object")
                    return &o.fields[index]
                let container = try self.place(receiver)
                return &container.items[index]
            .index:
                let receiver = e.left else error(fault, "no receiver")
                let index_expr = e.body else error(fault, "no index")
                let container = try self.eval(receiver)
                let store = container.obj else error(fault, "no list")
                let index = try self.eval(index_expr)
                let i = try checked_index(index.i, store.count)
                return &store.fields[i]
            _: error(fault, "not a place")

    ## The `self` parameter of the function whose frame is current.
    func self_param() -> ast.Node*?:
        if self.slots.count > self.base:
            let first = self.slots.get(self.base)
            if first.decl.text == "self":
                return first.decl
        return none

    mutating func prepare(e: ast.Node*) -> Prepared!:
        if e.kind == ast.Kind.index:
            let receiver = e.left else error(fault, "no receiver")
            let index_expr = e.body else error(fault, "no index")
            let container = try self.eval(receiver)
            let store = container.obj else error(fault, "no collection")
            if self.checker.table.kind(receiver.type_id) == types.Kind.map_:
                return Prepared(cell = none, store = store, key = try self.eval_owned(index_expr), is_map = true)
            return Prepared(cell = none, store = store, key = try self.eval(index_expr), is_map = false)
        return Prepared(cell = try self.place(e), store = none, key = value.nothing(), is_map = false)

    ## The store into a prepared place: the new value kept, the old one released.
    mutating func store_prepared(p: Prepared, v: value.Value) -> !:
        if let store = p.store:
            if p.is_map:
                # `m[key] = v`: an insertion or a replacement, the map's own key and value
                try heap.map_set(store, p.key, v)
                return
            let i = try checked_index(p.key.i, store.count)
            heap.set(store, i, v)
            return
        let cell = p.cell else error(fault, "no place")
        let old = *cell
        *cell = v
        heap.release(old)

    ## The place is evaluated, then the value; the new value is stored and the old one
    ## released (§5.3, RUNTIME 1, 2).
    mutating func assign(s: ast.Node*) -> !:
        let place_expr = s.left else return
        let value_expr = s.right else return
        if place_expr.kind == ast.Kind.tuple:
            let count = ast.count(place_expr.body)
            var prepared = try alloc Prepared[count]
            defer free(prepared)
            var i: usize = 0
            var cursor = place_expr.body
            while let part = cursor:
                prepared[i] = try self.prepare(part)
                i += 1
                cursor = part.next
            let v = try self.eval_owned(value_expr)
            i = 0
            while i < count:
                try self.store_prepared(prepared[i], v.items[i])
                i += 1
            return
        if s.text == "=":
            let prepared = try self.prepare(place_expr)
            let v = try self.eval_owned(value_expr)
            try self.store_prepared(prepared, v)
            return
        let cell = try self.place(place_expr)
        let current = *cell
        let v = try self.eval(value_expr)
        let op = (str)s.text.bytes[..<s.text.length - 1]
        *cell = try self.arithmetic(op, current, v)

    # -- expressions ----------------------------------------------------------------------

    ## A value to use and let go of: a temporary among the statement's when it was owned.
    pub mutating func eval(e: ast.Node*) -> value.Value!:
        let (v, owned) = try self.evaluate(e)
        if owned:
            try heap.pool(v)
        return v

    ## A value to keep: a reference of its own to every object it holds.
    pub mutating func eval_owned(e: ast.Node*) -> value.Value!:
        let (v, owned) = try self.evaluate(e)
        if owned:
            return v
        return try heap.copy(v)

    ## The value of an expression, and whether the caller owns it: a read of a binding is
    ## borrowed, everything else, a call, a construction, a field read, is owned (RUNTIME 4).
    mutating func evaluate(e: ast.Node*) -> (value.Value, bool)!:
        match e.kind:
            .literal: return (try self.literal(e), true)
            .name:
                let d = e.resolved else error(fault, "an unresolved name")
                if d.kind == ast.Kind.func_:
                    return (value.function(d), true)
                if d.kind == ast.Kind.constant:
                    let init = d.left else error(fault, "a constant without a value")
                    return (try self.eval_owned(init), true)
                return (*(try self.cell_of(d)), false)
            .self_:
                let d = self.self_param() else error(fault, "no self")
                return (*(try self.cell_of(d)), false)
            .group:
                let inner = e.left else error(fault, "empty group")
                return try self.evaluate(inner)
            .convert, .widen_function:
                # the value knows its type; the interface adds nothing here (§13.2)
                let inner = e.left else error(fault, "no value")
                return try self.evaluate(inner)
            .spawn_:
                # the task runs when it is spawned (§14, RUNTIME): copies of the arguments in,
                # the result or the failure kept for `wait`
                let call = e.left else error(fault, "no call")
                let d = call.resolved else error(fault, "an unresolved spawn")
                let given = try self.arguments(call, d.right, true)
                var sent = try alloc value.Value[given.length if given.length > 0 else 1]
                var i: usize = 0
                while i < given.length:
                    sent[i] = try heap.send(given[i])
                    i += 1
                let o = try heap.allocate_collection(types.none_id, types.none_id)
                try heap.push(o, value.nothing())
                try heap.push(o, value.nothing())
                let result = self.call(d, none, sent[..<given.length]) catch failure:
                    if failure.code != luce_failure:
                        error(failure.code, failure.message)
                    o.fields[1] = self.pending
                    o.version = 1
                    recover value.nothing()
                if o.version == 0:
                    o.fields[0] = result
                i = 0
                while i < given.length:
                    heap.release(sent[i])
                    i += 1
                return (value.task(o), true)
            .wait_:
                let inner = e.left else error(fault, "no task")
                let t = try self.eval(inner)
                let o = t.obj else error(fault, "a task without its object")
                if o.version >= 2:
                    self.stop("the task was waited already")
                o.version += 2
                if o.version == 3:
                    self.pending = o.fields[1]
                    error(luce_failure, self.pending.s)
                return (try heap.send(o.fields[0]), true)
            .propagate:
                let inner = e.left else error(fault, "no failure operand")
                return try self.evaluate(inner)
            .unary:
                let inner = e.left else error(fault, "no operand")
                if e.text == "try":
                    return try self.evaluate(inner)
                return (try self.unary(e), true)
            .binary: return (try self.binary(e), true)
            .conditional:
                let cond = e.ty else error(fault, "no condition")
                let l = e.left else error(fault, "no value")
                let r = e.right else error(fault, "no alternative")
                if value.truth(try self.eval(cond)):
                    return (try self.eval_owned(l), true)
                return (try self.eval_owned(r), true)
            .tuple:
                var t = try value.members(value.Kind.tuple, ast.count(e.body), none)
                var i: usize = 0
                var cursor = e.body
                while let m = cursor:
                    t.items[i] = try self.eval_owned(m)
                    i += 1
                    cursor = m.next
                return (t, true)
            .unit_: return (value.nothing(), true)
            .lambda:
                # the closure: an object holding a copy of every captured `let` and the
                # cell of every captured `var`
                let o = try heap.allocate(e, ast.count(e.left))
                var k: usize = 0
                var capture = e.left
                while let cap = capture:
                    let decl = cap.resolved else error(fault, "an unresolved capture")
                    if cap.has(ast.flag_var_field):
                        let slot = try self.slot_of(decl)
                        o.fields[k] = try heap.copy(*slot)
                    else:
                        o.fields[k] = try heap.copy(*(try self.cell_of(decl)))
                    k += 1
                    capture = cap.next
                return (value.closure(e, o), true)
            .list_lit:
                let store = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
                let made = value.collection(value.Kind.list_, store)
                var cursor = e.body
                while let item = cursor:
                    let v = self.eval_owned(item) catch failure:
                        self.abandon_partial(made, value.nothing())
                        error(failure.code, failure.message)
                    try heap.push(store, v)
                    cursor = item.next
                return (made, true)
            .set_lit:
                let store = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
                let made = value.collection(value.Kind.set_, store)
                var cursor = e.body
                while let item = cursor:
                    let v = self.eval_owned(item) catch failure:
                        self.abandon_partial(made, value.nothing())
                        error(failure.code, failure.message)
                    try heap.set_insert(store, v)
                    cursor = item.next
                return (made, true)
            .map_lit:
                let store = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, self.checker.table.map_value(e.type_id))
                let kind = value.Kind.set_ if self.checker.table.kind(e.type_id) == types.Kind.set_ else value.Kind.map_
                let made = value.collection(kind, store)
                var cursor = e.body
                while let entry = cursor:
                    let k = entry.left else error(fault, "no key")
                    let v = entry.right else error(fault, "no value")
                    let key = self.eval_owned(k) catch failure:
                        self.abandon_partial(made, value.nothing())
                        error(failure.code, failure.message)
                    let val = self.eval_owned(v) catch failure:
                        self.abandon_partial(made, key)
                        error(failure.code, failure.message)
                    try heap.map_set(store, key, val)
                    cursor = entry.next
                return (made, true)
            .call: return (try self.call_expr(e), true)
            .member: return try self.member(e)
            .index:
                let receiver = e.left else error(fault, "no receiver")
                let index_expr = e.body else error(fault, "no index")
                let container = try self.eval(receiver)
                let index = try self.eval(index_expr)
                if container.kind == value.Kind.blob:
                    let i = try checked_index(index.i, container.b.length)
                    return (value.integer((i64)container.b[i]), true)
                if container.kind == value.Kind.map_:
                    let store = container.obj else error(fault, "no map")
                    let at = heap.map_find(store, index) else return (value.absent(), true)
                    return (try heap.copy(store.fields[at + 1]), true)
                let items = value.elements(container)
                let i = try checked_index(index.i, items.length)
                return (try heap.copy(items[i]), true)
            .slice: return (try self.slice(e), true)
            .else_:
                let l = e.left else error(fault, "no value")
                let r = e.right else error(fault, "no fallback")
                let (v, owned) = try self.evaluate(l)
                if v.kind != value.Kind.absent:
                    return (v if owned else try heap.copy(v), true)
                if r.kind == ast.Kind.return_ or r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
                    try self.run_statement(r)
                    return (value.absent(), true)
                return (try self.eval_owned(r), true)
            .catch_: return (try self.catch_expr(e), true)
            .case_value: return (try self.construct_case(e, e.body), true)
            .formatted:
                var b = try strings.Builder.create(64)
                var cursor = e.body
                while let part = cursor:
                    if part.kind == ast.Kind.format_text:
                        try b.put(try unescape_format(part.text))
                    else:
                        let v = part.left else error(fault, "empty field")
                        try self.show_value(&b, v.type_id, try self.eval(v))
                    cursor = part.next
                let out = try strings.copy(b.view())
                b.destroy()
                return (value.text(out), true)
            .match_expr:
                let subject = e.left else error(fault, "no value")
                let v = try self.eval(subject)
                var cursor = e.body
                while let arm = cursor:
                    let mark = self.slots.count
                    if try self.arm_matches(arm, v):
                        let body = arm.body else error(fault, "no arm value")
                        let result = try self.eval_owned(body)
                        self.pop_to(mark)
                        return (result, true)
                    self.pop_to(mark)
                    cursor = arm.next
                trap("no arm of the match applied")
            _:
                error(fault, try format(self.checker.scratch, f"an expression the interpreter does not know: {ast.kind_name(e.kind)} at line {e.line}"))

    mutating func literal(e: ast.Node*) -> value.Value!:
        let b = e.text.bytes
        if e.text == "true":
            return value.boolean(true)
        if e.text == "false":
            return value.boolean(false)
        if e.text == "none":
            return value.absent()
        if b[0] == '"' or (b[0] == 'r' and b.length > 1 and b[1] == '"'):
            return value.text(try literals.decode_text(e.text))
        if b[0] == 'b' and b.length > 1 and b[1] == '"':
            return value.blob((try literals.decode_text(e.text)).bytes)
        if literals.is_float_text(e.text):
            return value.floating(try parse_float(e.text))
        let magnitude = try literals.decode_integer(e.text)
        if magnitude == 9223372036854775808:
            return value.integer(-9223372036854775807 - 1)   # under the `-` that admits it
        return value.integer((i64)magnitude)

    mutating func unary(e: ast.Node*) -> value.Value!:
        let inner = e.left else error(fault, "no operand")
        if e.text == "not":
            return value.boolean(not value.truth(try self.eval(inner)))
        let v = try self.eval(inner)
        if v.kind == value.Kind.floating:
            return value.floating(-v.f)
        if inner.kind == ast.Kind.literal and v.i == -9223372036854775807 - 1:
            return v
        let negated = 0 -? v.i else self.stop("integer overflow")
        return value.integer(negated)

    mutating func binary(e: ast.Node*) -> value.Value!:
        let l = e.left else error(fault, "no operand")
        let r = e.right else error(fault, "no operand")
        let op = e.text
        if op == "and":
            if not value.truth(try self.eval(l)):
                return value.boolean(false)
            return value.boolean(value.truth(try self.eval(r)))
        if op == "or":
            if value.truth(try self.eval(l)):
                return value.boolean(true)
            return value.boolean(value.truth(try self.eval(r)))
        let a = try self.eval(l)
        let b = try self.eval(r)
        if op == "is" or op == "is not":
            let same = a.obj == b.obj
            return value.boolean(same if op == "is" else not same)
        if op == "..<" or op == "..=":
            return value.range(a.i, b.i, op == "..=")
        if op == "==":
            return value.boolean(try self.equal_value(l.type_id, a, b))
        if op == "!=":
            return value.boolean(not try self.equal_value(l.type_id, a, b))
        if op == "<":
            return value.boolean(try self.compare_value(l.type_id, a, b) < 0)
        if op == "<=":
            return value.boolean(try self.compare_value(l.type_id, a, b) <= 0)
        if op == ">":
            return value.boolean(try self.compare_value(l.type_id, a, b) > 0)
        if op == ">=":
            return value.boolean(try self.compare_value(l.type_id, a, b) >= 0)
        if op == "in":
            match b.kind:
                .text: return value.boolean(strings.contains(b.s, a.s))
                .range_: return value.boolean(a.i >= b.i and (a.i <= b.hi if b.inclusive else a.i < b.hi))
                .list_, .set_:
                    let store = b.obj else error(fault, "no collection")
                    return value.boolean(heap.find(store, a) != none)
                .map_:
                    let store = b.obj else error(fault, "no map")
                    return value.boolean(heap.map_find(store, a) != none)
                _: error(fault, "`in` over this value")
        if a.kind == value.Kind.list_:
            # `a + b`: a new list of both
            let x = value.elements(a)
            let y = value.elements(b)
            let store = try heap.allocate_collection(self.checker.table.get(l.type_id).elem, types.none_id)
            for item in x:
                try heap.push(store, try heap.copy(item))
            for item in y:
                try heap.push(store, try heap.copy(item))
            return value.collection(value.Kind.list_, store)
        return try self.arithmetic(op, a, b)

    ## `a op b` for the arithmetic operators (§6.2): checked on `int`, IEEE on `float`.
    mutating func arithmetic(op: str, a: value.Value, b: value.Value) -> value.Value!:
        if a.kind == value.Kind.blob:
            var joined = try alloc u8[a.b.length + b.b.length]
            memory.copy(joined, a.b, a.b.length)
            memory.copy(joined[a.b.length..], b.b, b.b.length)
            return value.blob(joined[..<a.b.length + b.b.length])
        if a.kind == value.Kind.text:
            let joined = try alloc u8[a.s.length + b.s.length]
            var i: usize = 0
            while i < a.s.length:
                joined[i] = a.s.bytes[i]
                i += 1
            var k: usize = 0
            while k < b.s.length:
                joined[i + k] = b.s.bytes[k]
                k += 1
            return value.text((str)joined)
        if a.kind == value.Kind.floating:
            if op == "+": return value.floating(a.f + b.f)
            if op == "-": return value.floating(a.f - b.f)
            if op == "*": return value.floating(a.f * b.f)
            if op == "/": return value.floating(a.f / b.f)
            if op == "//": return value.floating(floor_float(a.f / b.f))
            if op == "%": return value.floating(a.f - floor_float(a.f / b.f) * b.f)
            if op == "**": return value.floating(power_float(a.f, b.f))
            error(fault, "unknown float operator")
        # checked here, so that the trap names the Luce statement (§6.2, §12.4)
        if op == "+":
            let r = a.i +? b.i else self.stop("integer overflow")
            return value.integer(r)
        if op == "-":
            let r = a.i -? b.i else self.stop("integer overflow")
            return value.integer(r)
        if op == "*":
            let r = a.i *? b.i else self.stop("integer overflow")
            return value.integer(r)
        if op == "/": return value.floating(f64(a.i) / f64(b.i))
        if op == "//" or op == "%":
            if b.i == 0:
                self.stop("division by zero")
            if b.i == -1 and a.i == -9223372036854775807 - 1:
                self.stop("integer overflow")
            if op == "//":
                return value.integer(floor_div(a.i, b.i))
            return value.integer(floor_mod(a.i, b.i))
        if op == "**": return value.integer(power_int(a.i, b.i))
        error(fault, "unknown operator")

    mutating func slice(e: ast.Node*) -> value.Value!:
        let receiver = e.left else error(fault, "no receiver")
        let v = try self.eval(receiver)
        var low: i64 = 0
        var high: i64 = 0
        if let l = e.body:
            low = (try self.eval(l)).i
        if let h = e.right:
            high = (try self.eval(h)).i
        match v.kind:
            .text:
                let n = (i64)scalar_length(v.s)
                if e.has(ast.flag_no_high):
                    high = n
                try check_bounds(low, high, n)
                return value.text(scalar_slice(v.s, (usize)low, (usize)high))
            .blob:
                let n = (i64)v.b.length
                if e.has(ast.flag_no_high):
                    high = n
                try check_bounds(low, high, n)
                return value.blob(v.b[(usize)low..<(usize)high])
            .list_:
                let store = v.obj else error(fault, "no list")
                let n = (i64)store.count
                if e.has(ast.flag_no_high):
                    high = n
                try check_bounds(low, high, n)
                return value.collection(value.Kind.list_, try heap.sliced(store, (usize)low, (usize)high))
            _: error(fault, "cannot slice this value")

    ## A member read: a field's value is an owned copy (RUNTIME 4).
    mutating func member(e: ast.Node*) -> (value.Value, bool)!:
        let receiver = e.left else error(fault, "no receiver")
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.module:
            # `module.name`: the declaration itself, as a name would give it (§15.2)
            let d = e.resolved else error(fault, "no declaration")
            if d.kind == ast.Kind.func_:
                return (value.function(d), true)
            if d.kind == ast.Kind.constant:
                let init = d.left else error(fault, "a constant without a value")
                return (try self.eval_owned(init), true)
            error(fault, "a module member that is not a value")
        if rt.kind == types.Kind.type_name:
            # a case without a payload, or a type function
            let m = e.resolved else error(fault, "no member")
            if m.kind == ast.Kind.enum_case:
                return (try self.construct_case(e, none), true)
            return (value.function(m), true)
        let v = try self.eval(receiver)
        if rt.kind == types.Kind.tuple:
            let index = try literals.decode_integer(e.text)
            return (try heap.copy(v.items[(usize)index]), true)
        if e.text == "length" and (v.kind == value.Kind.text or v.kind == value.Kind.blob or v.kind == value.Kind.list_ or v.kind == value.Kind.set_ or v.kind == value.Kind.map_):
            if v.kind == value.Kind.text:
                return (value.integer((i64)scalar_length(v.s)), true)
            if v.kind == value.Kind.blob:
                return (value.integer((i64)v.b.length), true)
            if v.kind == value.Kind.map_:
                return (value.integer((i64)(value.elements(v).length // 2)), true)
            return (value.integer((i64)value.elements(v).length), true)
        if v.kind == value.Kind.text and e.text == "byte_count":
            return (value.integer((i64)v.s.length), true)
        if v.kind == value.Kind.list_ and (e.text == "first" or e.text == "last"):
            let items = value.elements(v)
            if items.length == 0:
                return (value.absent(), true)
            return (try heap.copy(items[0] if e.text == "first" else items[items.length - 1]), true)
        if v.kind == value.Kind.failure:
            if e.text == "code":
                return (value.code(v.i), true)
            return (value.text(v.s), true)
        let m = e.resolved else error(fault, "no member")
        if m.kind == ast.Kind.field:
            let owner = rt.decl else error(fault, "no owner")
            let index = field_index(owner, m)
            if v.kind == value.Kind.object:
                let o = v.obj else error(fault, "no object")
                return (try heap.copy(o.fields[index]), true)
            return (try heap.copy(v.items[index]), true)
        if m.kind == ast.Kind.func_:
            # a method bound to its receiver: an object holding the receiver
            let env = try heap.allocate(m, 1)
            env.fields[0] = try heap.copy(v)
            return (value.closure(m, env), true)
        error(fault, "an unknown member")

    mutating func call_expr(e: ast.Node*) -> value.Value!:
        let callee = e.left else error(fault, "nothing to call")
        if callee.kind == ast.Kind.name and callee.resolved == none and self.checker.find_declaration(callee.text) == none:
            return try self.core_call(e, callee.text)
        if callee.kind == ast.Kind.member and callee.text == "package":
            return value.code(try self.package_code(e))
        if callee.has(ast.flag_builtin):
            let k = self.checker.table.kind(callee.type_id)
            if k == types.Kind.map_ or k == types.Kind.set_:
                return try self.map_method(e, callee, k == types.Kind.map_)
            if k == types.Kind.str_ or k == types.Kind.bytes_:
                return try self.text_method(e, callee)
            return try self.list_method(e, callee)
        if callee.kind == ast.Kind.member and callee.text == "get" and self.checker.table.kind(callee.type_id) == types.Kind.weak_:
            let receiver = callee.left else error(fault, "no receiver")
            let w = try self.eval(receiver)
            return heap.weak_get(w)
        if callee.kind == ast.Kind.case_value:
            return try self.construct_case(e, e.body)
        if let d = e.resolved:
            match d.kind:
                .enum_case: return try self.construct_case(e, e.body)
                .struct_: return try self.construct_struct(e, d)
                .class_: return try self.construct_object(e, d, none)
                .func_:
                    if d.text == "init":
                        let owner = callee.resolved else error(fault, "no class")
                        return try self.construct_object(e, owner, d)
                    if check.has_self(d):
                        let receiver = callee.left else error(fault, "no receiver")
                        let cell = try self.receiver_cell(receiver)
                        let args = try self.arguments(e, d.right, true)
                        # a method of an interface dispatches to the value's own (§13.2)
                        var target = d
                        if d.body == none:
                            let owner = cell.decl else error(fault, "an interface value without a declaration")
                            target = self.checker.find_member(owner, d.text) else error(fault, "a conformance without the method")
                        return try self.call(target, cell, args)
                    let args = try self.arguments(e, d.right, true)
                    return try self.call(d, none, args)
                _: discard(0)
        # a function value
        let f = try self.eval(callee)
        var n: usize = 0
        var cursor = e.body
        while cursor != none:
            n += 1
            cursor = (cursor else error(fault, "")).next
        var args = try alloc value.Value[n if n > 0 else 1]
        var i: usize = 0
        cursor = e.body
        while let a = cursor:
            let v = a.left else error(fault, "empty argument")
            args[i] = try self.eval(v)
            i += 1
            cursor = a.next
        return try self.call_value(f, args[..<n])

    ## A function value called: a named function, a closure over its environment, or a
    ## method over the receiver it was bound to.
    mutating func call_value(f: value.Value, args: value.Value[]) -> value.Value!:
        let d = f.decl else error(fault, "not a function")
        if d.kind == ast.Kind.lambda:
            let cell = try new value.Value
            *cell = f
            return try self.call(d, cell, args)
        if let env = f.obj:
            # a bound method: the receiver is the environment's one field
            return try self.call(d, &env.fields[0], args)
        return try self.call(d, none, args)

    ## A list's own method (§11.1), the same operation as the kernel's.
    mutating func list_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let l = try self.eval(receiver)
        let store = l.obj else error(fault, "no list")
        var args = try alloc value.Value[2]
        var n: usize = 0
        var cursor = e.body
        while let a = cursor:
            let v = a.left else error(fault, "empty argument")
            # a stored value is the list's own; a searched one is borrowed
            args[n] = try self.eval_owned(v) if name == "append" or name == "insert" else try self.eval(v)
            n += 1
            cursor = a.next
        if name == "append":
            try heap.append(store, args[0])
            return value.nothing()
        if name == "insert":
            let i = args[0].i
            if i < 0 or i > (i64)store.count:
                self.stop("index out of range")
            try heap.insert(store, (usize)i, args[1])
            return value.nothing()
        if name == "remove_at":
            let i = try checked_index(args[0].i, store.count)
            return heap.remove_at(store, i)
        if name == "pop":
            if store.count == 0:
                self.stop("pop of an empty list")
            return heap.remove_at(store, store.count - 1)
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "contains":
            return value.boolean(heap.find(store, args[0]) != none)
        if name == "index_of":
            let at = heap.find(store, args[0]) else return value.absent()
            return value.integer((i64)at)
        if name == "sort":
            heap.sort(store)
            return value.nothing()
        if name == "reverse":
            heap.reverse(store)
            return value.nothing()
        if name == "sorted" or name == "reversed" or name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            if name == "sorted":
                heap.sort(out)
            elif name == "reversed":
                heap.reverse(out)
            return value.collection(value.Kind.list_, out)
        if name == "join":
            var b = try strings.Builder.create(64)
            var i: usize = 0
            while i < store.count:
                if i > 0:
                    try b.put(args[0].s)
                try b.put(store.fields[i].s)
                i += 1
            let out = try strings.copy(b.view())
            b.destroy()
            return value.text(out)
        if name == "map" or name == "filter":
            let f = args[0]
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count:
                var one = try alloc value.Value[1]
                one[0] = store.fields[i]
                let r = try self.call_value(f, one)
                if name == "map":
                    try heap.push(out, r)
                elif value.truth(r):
                    try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
            return value.collection(value.Kind.list_, out)
        error(fault, "an unknown list method")

    ## A map's or a set's own method (§11.2), the same operation as the kernel's.
    mutating func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let m = try self.eval(receiver)
        let store = m.obj else error(fault, "no collection")
        var arg = value.nothing()
        if let first = e.body:
            let v = first.left else error(fault, "empty argument")
            arg = try self.eval_owned(v) if name == "insert" else try self.eval(v)
        if name == "clear":
            heap.clear(store)
            return value.nothing()
        if name == "copy":
            let out = try heap.sliced(store, 0, store.count)
            return value.collection(m.kind, out)
        if is_map:
            if name == "remove":
                let out = heap.map_remove(store, arg) else return value.absent()
                return out
            let out = try heap.allocate_collection(self.checker.table.get(e.type_id).elem, types.none_id)
            var i: usize = 0
            while i < store.count:
                if name == "keys":
                    try heap.push(out, try heap.copy(store.fields[i]))
                elif name == "values":
                    try heap.push(out, try heap.copy(store.fields[i + 1]))
                else:
                    var pair = try value.members(value.Kind.tuple, 2, none)
                    pair.items[0] = try heap.copy(store.fields[i])
                    pair.items[1] = try heap.copy(store.fields[i + 1])
                    try heap.push(out, pair)
                i += 2
            return value.collection(value.Kind.list_, out)
        if name == "insert":
            try heap.set_insert(store, arg)
            return value.nothing()
        if name == "remove":
            return value.boolean(heap.set_remove(store, arg))
        # union, intersection, difference: a new set
        let other = arg.obj else error(fault, "no set")
        let out = try heap.allocate_collection(store.elem, types.none_id)
        var i: usize = 0
        if name == "union":
            while i < store.count:
                try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
            i = 0
            while i < other.count:
                try heap.set_insert(out, try heap.copy(other.fields[i]))
                i += 1
        else:
            while i < store.count:
                let present = heap.find(other, store.fields[i]) != none
                if present == (name == "intersection"):
                    try heap.push(out, try heap.copy(store.fields[i]))
                i += 1
        return value.collection(value.Kind.set_, out)

    ## A text's or bytes' own method (§11.3, §11.4), the same operation as the kernel's.
    mutating func text_method(e: ast.Node*, callee: ast.Node*) -> value.Value!:
        let receiver = callee.left else error(fault, "no receiver")
        let name = callee.text
        let v = try self.eval(receiver)
        var args = try alloc value.Value[2]
        var n: usize = 0
        var cursor = e.body
        while let a = cursor:
            let arg = a.left else error(fault, "empty argument")
            args[n] = try self.eval(arg)
            n += 1
            cursor = a.next
        if v.kind == value.Kind.blob:
            if name == "text":
                if not valid_utf8(v.b):
                    return try self.raise(0, "invalid UTF-8")
                return value.text(try strings.copy((str)v.b))
            error(fault, "an unknown bytes method")
        let text = v.s
        if name == "contains":
            return value.boolean(find_bytes(text.bytes, args[0].s.bytes, 0) != none)
        if name == "starts_with":
            return value.boolean(args[0].s.length <= text.length and (str)text.bytes[..<args[0].s.length] == args[0].s)
        if name == "ends_with":
            return value.boolean(args[0].s.length <= text.length and (str)text.bytes[text.length - args[0].s.length..] == args[0].s)
        if name == "index_of":
            let at = find_bytes(text.bytes, args[0].s.bytes, 0) else return value.absent()
            return value.integer((i64)scalar_length((str)text.bytes[..<at]))
        if name == "split":
            let separator = args[0].s
            if separator.length == 0:
                self.stop("split needs a separator")
            let out = try heap.allocate_collection(types.str_id, types.none_id)
            var start: usize = 0
            while true:
                let at = find_bytes(text.bytes, separator.bytes, start) else break
                try heap.push(out, value.text(try strings.copy((str)text.bytes[start..<at])))
                start = at + separator.length
            try heap.push(out, value.text(try strings.copy((str)text.bytes[start..])))
            return value.collection(value.Kind.list_, out)
        if name == "lines":
            let out = try heap.allocate_collection(types.str_id, types.none_id)
            let b = text.bytes
            var start: usize = 0
            var i: usize = 0
            while i < b.length:
                if b[i] == '\n':
                    var end = i
                    if end > start and b[end - 1] == '\r':
                        end -= 1
                    try heap.push(out, value.text(try strings.copy((str)b[start..<end])))
                    start = i + 1
                i += 1
            if start < b.length:
                try heap.push(out, value.text(try strings.copy((str)b[start..])))
            return value.collection(value.Kind.list_, out)
        if name == "trim":
            let b = text.bytes
            var start: usize = 0
            var end = b.length
            while start < end and is_space(b[start]):
                start += 1
            while end > start and is_space(b[end - 1]):
                end -= 1
            return value.text((str)b[start..<end])
        if name == "upper" or name == "lower":
            var out = try alloc u8[text.length]
            var i: usize = 0
            while i < text.length:
                let byte = text.bytes[i]
                if name == "upper":
                    out[i] = byte - 32 if byte >= 'a' and byte <= 'z' else byte
                else:
                    out[i] = byte + 32 if byte >= 'A' and byte <= 'Z' else byte
                i += 1
            return value.text((str)out)
        if name == "replace":
            let old = args[0].s
            let new_text = args[1].s
            if old.length == 0:
                self.stop("replace needs a text to replace")
            var b = try strings.Builder.create(64)
            var start: usize = 0
            while true:
                let at = find_bytes(text.bytes, old.bytes, start) else break
                try b.put((str)text.bytes[start..<at])
                try b.put(new_text)
                start = at + old.length
            try b.put((str)text.bytes[start..])
            let out = try strings.copy(b.view())
            b.destroy()
            return value.text(out)
        if name == "repeat":
            if args[0].i < 0:
                self.stop("repeat of a negative count")
            var b = try strings.Builder.create(64)
            var i: i64 = 0
            while i < args[0].i:
                try b.put(text)
                i += 1
            let out = try strings.copy(b.view())
            b.destroy()
            return value.text(out)
        if name == "bytes":
            return value.blob(text.bytes)
        error(fault, "an unknown text method")

    ## The method a type declares for a closed protocol (§13.3), if it declares one.
    func protocol_method(t: u32, protocol: str, method: str) -> ast.Node*?:
        let ty = self.checker.table.get(t)
        if ty.kind != types.Kind.struct_ and ty.kind != types.Kind.class_ and ty.kind != types.Kind.enum_:
            return none
        let d = ty.decl else return none
        let iface = self.checker.find_declaration(protocol) else return none
        var cursor = d.right
        while let conformance = cursor:
            if conformance.type_id == iface.type_id:
                return self.checker.find_member(d, method)
            cursor = conformance.next
        return none

    ## `a == b` by the type: a declared `equals`, else by structure (§4.4).
    mutating func equal_value(t: u32, a: value.Value, b: value.Value) -> bool!:
        if let m = self.protocol_method(t, "Equatable", "equals"):
            let cell = try new value.Value
            *cell = a
            var one = try alloc value.Value[1]
            one[0] = b
            return value.truth(try self.call(m, cell, one))
        let ty = self.checker.table.get(t)
        match ty.kind:
            .optional:
                if a.kind == value.Kind.absent or b.kind == value.Kind.absent:
                    return a.kind == b.kind
                return try self.equal_value(ty.elem, a, b)
            .tuple:
                var i: usize = 0
                while i < ty.args.length:
                    if not try self.equal_value(ty.args[i], a.items[i], b.items[i]):
                        return false
                    i += 1
                return true
            .struct_:
                let d = ty.decl else return false
                var i: usize = 0
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        if not try self.equal_value(m.type_id, a.items[i], b.items[i]):
                            return false
                        i += 1
                    cursor = m.next
                return true
            .enum_:
                if a.case_node != b.case_node:
                    return false
                let case_node = a.case_node else return true
                var i: usize = 0
                var cursor = case_node.body
                while let field = cursor:
                    if not try self.equal_value(field.type_id, a.items[i], b.items[i]):
                        return false
                    i += 1
                    cursor = field.next
                return true
            .list_:
                let x = value.elements(a)
                let y = value.elements(b)
                if x.length != y.length:
                    return false
                var i: usize = 0
                while i < x.length:
                    if not try self.equal_value(ty.elem, x[i], y[i]):
                        return false
                    i += 1
                return true
            _: return value.equal(a, b)

    ## `a < b` by the type: a declared `compare`, else the structural order (§4.4).
    mutating func compare_value(t: u32, a: value.Value, b: value.Value) -> i64!:
        if let m = self.protocol_method(t, "Ordered", "compare"):
            let cell = try new value.Value
            *cell = a
            var one = try alloc value.Value[1]
            one[0] = b
            return (try self.call(m, cell, one)).i
        let ty = self.checker.table.get(t)
        if ty.kind == types.Kind.tuple:
            var i: usize = 0
            while i < ty.args.length:
                let order = try self.compare_value(ty.args[i], a.items[i], b.items[i])
                if order != 0:
                    return order
                i += 1
            return 0
        return value.compare(a, b)

    ## The display of a value by its type: a declared `display`, else by structure (§10.5).
    mutating func show_value(out: strings.Builder*, t: u32, v: value.Value) -> !:
        if let m = self.protocol_method(t, "Display", "display"):
            let cell = try new value.Value
            *cell = v
            let shown = try self.call(m, cell, try alloc value.Value[0])
            try out.put(shown.s)
            return
        let ty = self.checker.table.get(t)
        match ty.kind:
            .optional:
                if v.kind == value.Kind.absent:
                    try out.put("none")
                else:
                    try self.show_value(out, ty.elem, v)
            .tuple:
                try out.put("(")
                var i: usize = 0
                while i < ty.args.length:
                    if i > 0:
                        try out.put(", ")
                    try self.show_value(out, ty.args[i], v.items[i])
                    i += 1
                if ty.args.length == 1:
                    try out.put(",")
                try out.put(")")
            .struct_:
                let d = ty.decl else return
                try out.put(self.checker.display_name(d))
                try out.put("(")
                var i: usize = 0
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        if i > 0:
                            try out.put(", ")
                        try out.put(m.text)
                        try out.put(" = ")
                        try self.show_value(out, m.type_id, v.items[i])
                        i += 1
                    cursor = m.next
                try out.put(")")
            .enum_:
                let d = ty.decl else return
                let case_node = v.case_node else return
                try out.put(self.checker.display_name(d))
                try out.put(".")
                try out.put(case_node.text)
                if v.items.length > 0:
                    try out.put("(")
                    var i: usize = 0
                    var cursor = case_node.body
                    while let field = cursor:
                        if i > 0:
                            try out.put(", ")
                        try out.put(field.text)
                        try out.put(" = ")
                        try self.show_value(out, field.type_id, v.items[i])
                        i += 1
                        cursor = field.next
                    try out.put(")")
            .list_, .set_:
                try out.put("[" if ty.kind == types.Kind.list_ else "{")
                let items = value.elements(v)
                var i: usize = 0
                while i < items.length:
                    if i > 0:
                        try out.put(", ")
                    try self.show_value(out, ty.elem, items[i])
                    i += 1
                try out.put("]" if ty.kind == types.Kind.list_ else "}")
            .map_:
                try out.put("{")
                let items = value.elements(v)
                var i: usize = 0
                while i < items.length:
                    if i > 0:
                        try out.put(", ")
                    try self.show_value(out, ty.elem, items[i])
                    try out.put(": ")
                    try self.show_value(out, self.checker.table.map_value(t), items[i + 1])
                    i += 2
                try out.put("}")
            _: try value.display(out, v)

    ## `hash(x)` (§4.4): FNV-1a over the value's canonical bytes, walked with its static
    ## type, the same number the runtime computes; a declared `hashed` stands in.
    mutating func hash_value(h: u64, t: u32, v: value.Value) -> u64:
        if let m = self.protocol_method(t, "Hashable", "hashed"):
            let cell = new value.Value catch failure:
                self.stop("out of memory")
            *cell = v
            let one = alloc value.Value[0] catch failure:
                self.stop("out of memory")
            let hashed = self.call(m, cell, one) catch failure:
                self.stop("`hashed` failed")
            return hash_int(h, hashed.i)
        let ty = self.checker.table.get(t)
        match ty.kind:
            .int_: return hash_int(h, v.i)
            .float_:
                let normal = 0.0 if v.f == 0.0 else v.f
                return hash_int(h, (i64)normal.bits())
            .bool_: return hash_byte(h, 1 if v.i != 0 else 0)
            .str_: return hash_byte(hash_bytes(h, v.s.bytes), 255)
            .bytes_: return hash_byte(hash_bytes(h, v.b), 255)
            .unit_: return h
            .error_code: return hash_int(h, v.i)
            .range_: return hash_byte(hash_int(hash_int(h, v.i), v.hi), 1 if v.inclusive else 0)
            .optional:
                if v.kind == value.Kind.absent:
                    return hash_byte(h, 0)
                return self.hash_value(hash_byte(h, 1), ty.elem, v)
            .tuple:
                var out = h
                var i: usize = 0
                while i < ty.args.length:
                    out = self.hash_value(out, ty.args[i], v.items[i])
                    i += 1
                return out
            .struct_:
                let d = ty.decl else return h
                var out = h
                var i: usize = 0
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        out = self.hash_value(out, m.type_id, v.items[i])
                        i += 1
                    cursor = m.next
                return out
            .enum_:
                var out = hash_int(h, v.i)
                let case_node = v.case_node else return out
                var i: usize = 0
                var cursor = case_node.body
                while let field = cursor:
                    out = self.hash_value(out, field.type_id, v.items[i])
                    i += 1
                    cursor = field.next
                return out
            .list_:
                var out = h
                for item in value.elements(v):
                    out = self.hash_value(out, ty.elem, item)
                return out
            .set_:
                var sum: u64 = 0
                for item in value.elements(v):
                    sum = sum +% self.hash_value(hash_offset, ty.elem, item)
                return hash_int(h, (i64)sum)
            .map_:
                var sum: u64 = 0
                let items = value.elements(v)
                var i: usize = 0
                while i < items.length:
                    let k = self.hash_value(hash_offset, ty.elem, items[i])
                    let w = self.hash_value(hash_offset, self.checker.table.map_value(t), items[i + 1])
                    sum = sum +% (k *% 31 +% w)
                    i += 2
                return hash_int(h, (i64)sum)
            _: return h

    ## The cell a method's receiver lives in: a place's cell, or a fresh cell holding a
    ## temporary that the statement's pool keeps alive.
    mutating func receiver_cell(receiver: ast.Node*) -> value.Value*!:
        if receiver.kind == ast.Kind.name or receiver.kind == ast.Kind.self_ or receiver.kind == ast.Kind.member or receiver.kind == ast.Kind.index:
            return self.place(receiver) catch failure:
                let cell = try new value.Value
                *cell = try self.eval(receiver)
                recover cell
        let cell = try new value.Value
        *cell = try self.eval(receiver)
        return cell

    mutating func construct_struct(e: ast.Node*, d: ast.Node*) -> value.Value!:
        let args = try self.arguments(e, d.body, false)
        var v = try value.members(value.Kind.record, args.length, d)
        var i: usize = 0
        while i < args.length:
            v.items[i] = try heap.copy(args[i])
            i += 1
        return v

    ## A literal whose item failed to evaluate: what was made so far, and a key waiting for
    ## its value, are released, and the failure travels on (RUNTIME 5).
    mutating func abandon_partial(made: value.Value, key: value.Value):
        let pending = self.pending
        heap.release(key)
        heap.release(made)
        self.pending = pending

    ## A class instance: fields from their defaults, then `init` over it; an `init` that
    ## fails leaves no object behind (RUNTIME).
    mutating func construct_object(e: ast.Node*, owner: ast.Node*, init: ast.Node*?) -> value.Value!:
        let n = field_count(owner)
        let o = try heap.allocate(owner, n)
        var i: usize = 0
        var cursor = owner.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                if let default = m.left:
                    o.fields[i] = try self.eval_owned(default)
                i += 1
            cursor = m.next
        if let f = init:
            let cell = try new value.Value
            *cell = value.object(o)
            let args = try self.arguments(e, f.right, true)
            self.call(f, cell, args) catch failure:
                let pending = self.pending
                heap.abandon(o)
                self.pending = pending
                error(failure.code, failure.message)
        return value.object(o)

    ## A case value: the enum, the case, and its payload from the arguments.
    mutating func construct_case(e: ast.Node*, args_list: ast.Node*?) -> value.Value!:
        let case_node = e.resolved else error(fault, "no case")
        var d: ast.Node*? = none
        let t = self.checker.table.get(e.type_id)
        if t.kind == types.Kind.enum_:
            d = t.decl
        elif t.kind == types.Kind.optional:
            d = self.checker.table.get(t.elem).decl
        elif t.kind == types.Kind.type_name:
            d = self.checker.table.get(t.elem).decl
        let owner = d else error(fault, "no enum")
        let n = ast.count(case_node.body)
        var v = try value.members(value.Kind.variant, n, owner)
        v.case_node = case_node
        v.i = (i64)case_index(owner, case_node)
        if n > 0:
            var saved = e.body
            e.body = args_list
            let args = try self.arguments(e, case_node.body, false)
            e.body = saved
            var i: usize = 0
            while i < n:
                v.items[i] = try heap.copy(args[i])
                i += 1
        return v

    mutating func catch_expr(e: ast.Node*) -> value.Value!:
        let l = e.left else error(fault, "no value")
        let body = e.body else error(fault, "no suite")
        let mark = self.slots.count
        let result = self.eval_owned(l) catch failure:
            if failure.code != luce_failure:
                error(failure.code, failure.message)
            let err = self.pending
            if e.text.length > 0:
                try self.bind(e, err)
            try self.block(body)
            self.pop_to(mark)
            if self.flow == Flow.recovered:
                self.flow = Flow.normal
                let carried = self.carried
                self.carried = value.nothing()
                recover carried
            recover value.nothing()
        return result

    ## The language's own functions.
    mutating func core_call(e: ast.Node*, name: str) -> value.Value!:
        if name == "print":
            var b = try strings.Builder.create(64)
            var cursor = e.body
            var first = true
            while let a = cursor:
                let v = a.left else error(fault, "empty argument")
                if not first:
                    try b.put(" ")
                first = false
                try self.show_value(&b, v.type_id, try self.eval(v))
                cursor = a.next
            try b.put("\n")
            discard(try self.out.write(b.view().bytes))
            b.destroy()
            return value.nothing()
        let first = e.body else error(fault, "no argument")
        let arg = first.left else error(fault, "no argument")
        if name == "assert":
            let ok = value.truth(try self.eval(arg))
            if not ok:
                if let second = first.next:
                    let m = second.left else error(fault, "no message")
                    let text = try self.eval(m)
                    var room: u8[512]
                    self.stop(try format(room, f"assert failed: {text.s}"))
                self.stop("assert failed")
            return value.nothing()
        if name == "trap":
            let m = try self.eval(arg)
            self.stop(m.s)
        if name == "error":
            let second = first.next else error(fault, "no message")
            let m = second.left else error(fault, "no message")
            let code = try self.eval(arg)
            let message = try self.eval(m)
            return try self.raise(code.i, message.s)
        if name == "discard":
            discard(try self.eval(arg))
            return value.nothing()
        if name == "Weak":
            let v = try self.eval(arg)
            let o = v.obj else error(fault, "no object")
            return heap.weak_make(o)
        if name == "hash":
            let v = try self.eval(arg)
            return value.integer((i64)self.hash_value(hash_offset, arg.type_id, v))
        let v = try self.eval(arg)
        if name == "int":
            if v.kind == value.Kind.floating:
                if v.f != v.f or v.f >= 9223372036854775808.0 or v.f < -9223372036854775808.0:
                    self.stop("integer conversion out of range")
                return value.integer(i64(v.f))
            let parsed = strings.parse_i64(strings.trim(v.s)) else return try self.raise(0, "not an integer")
            return value.integer(parsed)
        if name == "float":
            if v.kind == value.Kind.integer:
                return value.floating(f64(v.i))
            let trimmed = strings.trim(v.s)
            if not is_decimal(trimmed):
                return try self.raise(0, "not a number")
            let parsed = parse_float(trimmed) catch failure:
                return try self.raise(0, "not a number")
            return value.floating(parsed)
        if name == "bool":
            if v.s == "true":
                return value.boolean(true)
            if v.s == "false":
                return value.boolean(false)
            return try self.raise(0, "not a boolean")
        if name == "str":
            var b = try strings.Builder.create(64)
            try self.show_value(&b, arg.type_id, v)
            let out = try strings.copy(b.view())
            b.destroy()
            return value.text(out)
        error(fault, "an unknown core function")

    ## A trap: `trap: file:line:column: message` for the statement being run (§12.4), on
    ## standard error, and the program ends with status 1, as a built program does.
    pub func stop(message: str) -> never:
        var e = io.stderr()
        let prefix = "trap: "
        discard(e.write(prefix.bytes) catch failure: recover 0)
        if let s = self.at:
            let module = self.checker.modules.get((usize)s.module)
            let (line, column) = module.src.position(ast.statement_start(s))
            var room: u8[512]
            let where = format(room, f"{module.path}:{line}:{column}: ") catch failure: recover "?: "
            discard(e.write(where.bytes) catch failure: recover 0)
        discard(e.write(message.bytes) catch failure: recover 0)
        let newline = "\n"
        discard(e.write(newline.bytes) catch failure: recover 0)
        process.exit(1)

    ## A Luce failure: the `Error` kept aside, the Base failure carrying the message.
    mutating func raise(code: i64, message: str) -> never!:
        self.pending = value.failure(code, message)
        error(luce_failure, message)

    func package_code(e: ast.Node*) -> i64!:
        let first = e.body else error(fault, "no code")
        let v = first.left else error(fault, "no code")
        let n = try literals.decode_integer(v.text)
        return (i64)(((u64)package_identity(self.checker.package_name) << 16) | n)

## `luce test`'s report lines (§17.3), the same the kernel prints for a built runner.
func test_passed(name: str) -> !:
    var out = io.stdout()
    try out.write(f"ok    {name}\n")

func test_failed(name: str, at: str, message: str) -> !:
    var out = io.stdout()
    try out.write(f"FAIL  {name}\n      {at}: {message}\n")

func test_summary(total: i64, failures: i64) -> i32!:
    var out = io.stdout()
    try out.write(f"{total - failures} passed\n")
    if failures > 0:
        try out.write(f"{failures} failed\n")
        return 1
    return 0

## The heap's hook: a `deinit` runs on the interpreter behind the context.
func finish_object(context: void*, o: value.Object*):
    let me = (Interp*)context
    me.run_deinit(o) catch failure:
        me.stop("`deinit` failed")

## The heap's trap, named by the interpreter behind it.
func stop_by_interpreter(context: void*, message: str) -> never:
    let me = (Interp*)context
    me.stop(message)

## The heap's hook for equality by type: a declared `equals` counts in a collection too.
func equal_by_type(context: void*, t: u32, a: value.Value, b: value.Value) -> bool:
    let me = (Interp*)context
    return me.equal_value(t, a, b) catch failure:
        me.stop("`equals` failed")

## The heap's hook for ordering by type: a declared `compare` sorts a list too.
func compare_by_type(context: void*, t: u32, a: value.Value, b: value.Value) -> i64:
    let me = (Interp*)context
    return me.compare_value(t, a, b) catch failure:
        me.stop("`compare` failed")

## Installs the interpreter behind the heap; `me` must outlive every run.
pub func attach(me: Interp*):
    heap.finisher = finish_object
    heap.finisher_context = (void*)me
    heap.equal_hook = equal_by_type
    heap.compare_hook = compare_by_type
    heap.stop_hook = stop_by_interpreter

# mark: Helpers ================================================================================

func find_bytes(haystack: const u8[], needle: const u8[], start: usize) -> usize?:
    if needle.length == 0:
        return start
    var i = start
    while i + needle.length <= haystack.length:
        var k: usize = 0
        while k < needle.length and haystack[i + k] == needle[k]:
            k += 1
        if k == needle.length:
            return i
        i += 1
    return none

func is_space(byte: u8) -> bool:
    return byte == ' ' or byte == '\t' or byte == '\n' or byte == '\r'

## Whether bytes are UTF-8: the kernel's rule (§11.4).
func valid_utf8(b: const u8[]) -> bool:
    var i: usize = 0
    while i < b.length:
        let lead = b[i]
        var n: usize = 0
        if lead < 0x80:
            n = 0
        elif lead >= 0xC2 and lead <= 0xDF:
            n = 1
        elif lead >= 0xE0 and lead <= 0xEF:
            n = 2
        elif lead >= 0xF0 and lead <= 0xF4:
            n = 3
        else:
            return false
        var k: usize = 1
        while k <= n:
            if i + k >= b.length or (b[i + k] & 0xC0) != 0x80:
                return false
            k += 1
        if n == 2 and lead == 0xE0 and b[i + 1] < 0xA0:
            return false
        if n == 2 and lead == 0xED and b[i + 1] >= 0xA0:
            return false
        if n == 3 and lead == 0xF0 and b[i + 1] < 0x90:
            return false
        if n == 3 and lead == 0xF4 and b[i + 1] >= 0x90:
            return false
        i += n + 1
    return true

## FNV-1a over 64 bits (docs/RUNTIME.md), as the kernel computes it.
let hash_offset: u64 = 14695981039346656037

func hash_byte(h: u64, b: u8) -> u64:
    return (h ^ (u64)b) *% 1099511628211

func hash_bytes(h: u64, data: const u8[]) -> u64:
    var out = h
    for b in data:
        out = hash_byte(out, b)
    return out

func hash_int(h: u64, i: i64) -> u64:
    var out = h
    var bits = (u64)i
    var k: u32 = 0
    while k < 8:
        out = hash_byte(out, (u8)(bits & 255))
        bits = bits >> 8
        k += 1
    return out

## A parameter or a field of the list, `self` and methods excluded.
func counts_as_param(p: ast.Node*, skip_self: bool) -> bool:
    if p.kind != ast.Kind.param and p.kind != ast.Kind.field:
        return false
    return not (skip_self and p.text == "self")

func index_of_param(params: ast.Node*?, p: ast.Node*, skip_self: bool) -> usize!:
    var i: usize = 0
    var cursor = params
    while let q = cursor:
        if counts_as_param(q, skip_self):
            if q == p:
                return i
            i += 1
        cursor = q.next
    error(fault, "a parameter that is not in its list")

pub func field_index(owner: ast.Node*, field: ast.Node*) -> usize:
    var i: usize = 0
    var cursor = owner.body
    while let m = cursor:
        if m == field:
            return i
        if m.kind == ast.Kind.field:
            i += 1
        cursor = m.next
    return 0

pub func field_count(owner: ast.Node*) -> usize:
    var n: usize = 0
    var cursor = owner.body
    while let m = cursor:
        if m.kind == ast.Kind.field:
            n += 1
        cursor = m.next
    return n

pub func case_index(owner: ast.Node*, case_node: ast.Node*) -> usize:
    var i: usize = 0
    var cursor = owner.body
    while let m = cursor:
        if m == case_node:
            return i
        if m.kind == ast.Kind.enum_case:
            i += 1
        cursor = m.next
    return 0

func checked_index(i: i64, count: usize) -> usize!:
    var k = i
    if k < 0:
        k += (i64)count
    if k < 0 or k >= (i64)count:
        heap.stop("index out of range")
    return (usize)k

func check_bounds(low: i64, high: i64, n: i64) -> !:
    if low < 0 or high < low or high > n:
        heap.stop("slice out of range")

## `{{` and `}}` in the literal part of a formatted string are one brace each.
func unescape_format(text: str) -> str!:
    let b = text.bytes
    var out = try alloc u8[b.length + 1]
    var n: usize = 0
    var i: usize = 0
    while i < b.length:
        if (b[i] == '{' or b[i] == '}') and i + 1 < b.length and b[i + 1] == b[i]:
            out[n] = b[i]
            n += 1
            i += 2
            continue
        if b[i] == '\\' and i + 1 < b.length:
            let e = b[i + 1]
            out[n] = '\n' if e == 'n' else '\t' if e == 't' else '\r' if e == 'r' else 0 if e == '0' else e
            n += 1
            i += 2
            continue
        out[n] = b[i]
        n += 1
        i += 1
    return (str)out[..<n]

## Scalars in a text, and a slice by scalar index (§11.3).
pub func scalar_length(s: str) -> usize:
    var n: usize = 0
    for b in s.bytes:
        if (b & 0xC0) != 0x80:
            n += 1
    return n

pub func scalar_slice(s: str, low: usize, high: usize) -> str:
    let b = s.bytes
    var start: usize = 0
    var end: usize = b.length
    var scalar: usize = 0
    var i: usize = 0
    var found_start = low == 0
    while i < b.length:
        if (b[i] & 0xC0) != 0x80:
            if scalar == low:
                start = i
                found_start = true
            if scalar == high:
                end = i
                break
            scalar += 1
        i += 1
    if not found_start:
        start = b.length
    return (str)b[start..<end]

## Floor division and remainder as Python's (§6.2).
pub func floor_div(a: i64, b: i64) -> i64:
    let q = a // b
    if (a % b != 0) and ((a < 0) != (b < 0)):
        return q - 1
    return q

pub func floor_mod(a: i64, b: i64) -> i64:
    let r = a % b
    if r != 0 and ((r < 0) != (b < 0)):
        return r + b
    return r

pub func power_int(base: i64, exponent: i64) -> i64:
    if exponent < 0:
        heap.stop("a negative exponent needs a float base")
    var result: i64 = 1
    var i: i64 = 0
    while i < exponent:
        result = result *? base else heap.stop("integer overflow")
        i += 1
    return result

func floor_float(x: f64) -> f64:
    let t = f64(i64(x))
    return t - 1.0 if t > x else t

func power_float(base: f64, exponent: f64) -> f64:
    # exact for whole exponents, which is what programs write; `math.pow` otherwise
    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:
        var result = 1.0
        var i: i64 = 0
        while i < i64(exponent):
            result = result * base
            i += 1
        return result
    return c_pow(base, exponent)

extern func c_pow as "pow"(x: f64, y: f64) -> f64
extern func c_strtod as "strtod"(text: c.str, end: c.str*?) -> f64

## Whether the text is a decimal number as §6.5 reads one (the kernel's `is_decimal`):
## a sign, digits with an optional fraction, an optional exponent, and nothing else.
func is_decimal(text: str) -> bool:
    let b = text.bytes
    var i: usize = 0
    if i < b.length and (b[i] == '+' or b[i] == '-'):
        i += 1
    var digits: usize = 0
    while i < b.length and b[i] >= '0' and b[i] <= '9':
        i += 1
        digits += 1
    if i < b.length and b[i] == '.':
        i += 1
        while i < b.length and b[i] >= '0' and b[i] <= '9':
            i += 1
            digits += 1
    if digits == 0:
        return false
    if i < b.length and (b[i] == 'e' or b[i] == 'E'):
        i += 1
        if i < b.length and (b[i] == '+' or b[i] == '-'):
            i += 1
        var exponent: usize = 0
        while i < b.length and b[i] >= '0' and b[i] <= '9':
            i += 1
            exponent += 1
        if exponent == 0:
            return false
    return i == b.length

func parse_float(text: str) -> f64!:
    var buffer = try alloc u8[text.length + 1]
    var i: usize = 0
    while i < text.length:
        buffer[i] = text.bytes[i]
        i += 1
    buffer[text.length] = 0
    return c_strtod((c.str)buffer.data, none)

## The identity of a package's error codes (§12.3): sixteen bits of its name, the same
## computation in every compiler of the language.
pub func package_identity(name: str) -> u32:
    var h: u32 = 2166136261
    for byte in name.bytes:
        h = (h ^ (u32)byte) *% 16777619
    return (h ^ (h >> 16)) & 65535

test "floor division and remainder follow the divisor's sign":
    assert(floor_div(7, 2) == 3)
    assert(floor_div(-7, 2) == -4)
    assert(floor_mod(-7, 3) == 2)
    assert(floor_mod(7, -3) == -2)
    assert(power_int(2, 10) == 1024)
    assert(scalar_length("héllo") == 5)
    assert(scalar_slice("héllo", 1, 3) == "él")
