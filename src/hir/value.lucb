#==============================================================================================
#
#   value - What the interpreter computes over
#
#   DESCRIPTION:
#       A semantic value with no address in it: a scalar, a text, a tuple or struct or enum
#       value whose members are values, a class instance whose members are shared, a list.
#       Value types copy when bound or passed (`clone`), reference types share their storage,
#       which is what luce.md §9 and §10 say and all the interpreter needs to know. Display
#       (§10.5) is here too, so `print`, `str(x)` and f-strings agree.
#
#==============================================================================================

import front.ast
import strings

pub enum Kind as u8:
    unit_ = 0
    boolean = 2
    integer = 3
    floating = 4
    text = 5
    blob = 6
    absent = 7
    tuple = 8
    record = 9
    variant = 10
    object = 11
    list_ = 12
    range_ = 13
    code = 14
    failure = 15
    function = 16
    weak_ = 17
    map_ = 18
    set_ = 19

## A class instance, or a collection: the counts and flags of docs/RUNTIME.md, then the
## fields, or the elements in `fields[..<count]` with room beyond. A collection has no
## declaration; a map's entries are key, value pairs in sequence.
pub struct Object:
    pub var strong: u32
    pub var weak: u32
    pub var flags: u8
    pub var decl: ast.Node*?
    pub var fields: Value[]
    pub var count: usize
    ## Structural changes so far; a `for` running over the collection traps on a change.
    pub var version: u64

pub struct Value:
    pub var kind: Kind
    ## An integer, a boolean as 0 or 1, an error code, a range's low bound, a case's index.
    pub var i: i64
    pub var f: f64
    ## A text, or a failure's message.
    pub var s: str
    pub var b: const u8[]
    ## Members: a tuple's, a struct's fields, a case's payload, an object's fields, a list's
    ## elements. Shared for an object or a list, copied for a value.
    pub var items: Value[]
    ## The declaration behind a record, variant, object, or function; a variant also keeps
    ## its case node here.
    pub var decl: ast.Node*?
    pub var case_node: ast.Node*?
    ## A range's high bound, and whether it is included.
    pub var hi: i64
    pub var inclusive: bool
    ## A list's count; `items` is its capacity.
    pub var count: usize
    ## An object, or a weak reference's target.
    pub var obj: Object*?

pub func nothing() -> Value:
    return Value(kind = Kind.unit_, i = 0, f = 0.0, s = "", b = "".bytes, items = empty(), decl = none, case_node = none, hi = 0, inclusive = false, count = 0, obj = none)

pub func integer(i: i64) -> Value:
    var v = nothing()
    v.kind = Kind.integer
    v.i = i
    return v

pub func floating(f: f64) -> Value:
    var v = nothing()
    v.kind = Kind.floating
    v.f = f
    return v

pub func boolean(b: bool) -> Value:
    var v = nothing()
    v.kind = Kind.boolean
    v.i = 1 if b else 0
    return v

pub func text(s: str) -> Value:
    var v = nothing()
    v.kind = Kind.text
    v.s = s
    return v

pub func blob(b: const u8[]) -> Value:
    var v = nothing()
    v.kind = Kind.blob
    v.b = b
    return v

pub func absent() -> Value:
    var v = nothing()
    v.kind = Kind.absent
    return v

pub func code(i: i64) -> Value:
    var v = nothing()
    v.kind = Kind.code
    v.i = i
    return v

pub func failure(code_value: i64, message: str) -> Value:
    var v = nothing()
    v.kind = Kind.failure
    v.i = code_value
    v.s = message
    return v

pub func range(low: i64, high: i64, inclusive: bool) -> Value:
    var v = nothing()
    v.kind = Kind.range_
    v.i = low
    v.hi = high
    v.inclusive = inclusive
    return v

pub func function(decl: ast.Node*) -> Value:
    var v = nothing()
    v.kind = Kind.function
    v.decl = decl
    return v

pub func object(o: Object*) -> Value:
    var v = nothing()
    v.kind = Kind.object
    v.obj = o
    v.decl = o.decl
    return v

## A list, map or set over its object.
pub func collection(kind: Kind, o: Object*) -> Value:
    var v = nothing()
    v.kind = kind
    v.obj = o
    return v

## The elements of a collection value.
pub func elements(v: Value) -> Value[]:
    let o = v.obj else return v.items[..<0]
    return o.fields[..<o.count]

pub func weak(o: Object*) -> Value:
    var v = nothing()
    v.kind = Kind.weak_
    v.obj = o
    return v

## A tuple, record, or variant over `n` members, each `unit` until set.
pub func members(kind: Kind, n: usize, decl: ast.Node*?) -> Value!:
    var v = nothing()
    v.kind = kind
    v.decl = decl
    v.items = try alloc Value[n if n > 0 else 1]
    var i: usize = 0
    while i < n:
        v.items[i] = nothing()
        i += 1
    v.items = v.items[..<n]
    v.count = n
    return v

## Storage that lives forever, so that an empty member list is a view of something real
## (Base's empty span has a non-null address, §5.4) without an allocation per value.
var no_values: Value[1]

func empty() -> Value[]:
    return no_values[..<0]

pub func truth(v: Value) -> bool:
    return v.i != 0

## A copy with its own members, for a value type; an object or a list shares (§9, §10).
pub func clone(v: Value) -> Value!:
    if v.kind != Kind.tuple and v.kind != Kind.record and v.kind != Kind.variant:
        return v
    var out = v
    out.items = try alloc Value[v.items.length if v.items.length > 0 else 1]
    var i: usize = 0
    while i < v.items.length:
        out.items[i] = try clone(v.items[i])
        i += 1
    out.items = out.items[..<v.items.length]
    return out

## Structural equality (§4.4); an object or a list compares by identity.
pub func equal(a: Value, b: Value) -> bool:
    if a.kind != b.kind:
        return false
    match a.kind:
        .unit_, .absent: return true
        .boolean, .integer, .code: return a.i == b.i
        .floating: return a.f == b.f
        .text: return a.s == b.s
        .blob:
            if a.b.length != b.b.length:
                return false
            var i: usize = 0
            while i < a.b.length:
                if a.b[i] != b.b[i]:
                    return false
                i += 1
            return true
        .range_: return a.i == b.i and a.hi == b.hi and a.inclusive == b.inclusive
        .tuple, .record, .variant:
            if a.case_node != b.case_node or a.items.length != b.items.length:
                return false
            var i: usize = 0
            while i < a.items.length:
                if not equal(a.items[i], b.items[i]):
                    return false
                i += 1
            return true
        .object: return a.obj == b.obj
        .list_:
            let x = elements(a)
            let y = elements(b)
            if x.length != y.length:
                return false
            var i: usize = 0
            while i < x.length:
                if not equal(x[i], y[i]):
                    return false
                i += 1
            return true
        .failure: return a.i == b.i and a.s == b.s
        .set_:
            let x = elements(a)
            let y = elements(b)
            if x.length != y.length:
                return false
            for item in x:
                if find_in(y, item, 1) == none:
                    return false
            return true
        .map_:
            let x = elements(a)
            let y = elements(b)
            if x.length != y.length:
                return false
            var i: usize = 0
            while i < x.length:
                let at = find_in(y, x[i], 2) else return false
                if not equal(x[i + 1], y[at + 1]):
                    return false
                i += 2
            return true
        _: return false

## Where `key` sits among `items` read `step` at a time: an element, or a pair's key.
pub func find_in(items: Value[], key: Value, step: usize) -> usize?:
    var i: usize = 0
    while i < items.length:
        if equal(items[i], key):
            return i
        i += step
    return none

## Ordering (§4.4): -1, 0, 1.
pub func compare(a: Value, b: Value) -> i64:
    match a.kind:
        .integer:
            return -1 if a.i < b.i else 1 if a.i > b.i else 0
        .floating:
            return -1 if a.f < b.f else 1 if a.f > b.f else 0
        .text:
            return compare_bytes(a.s.bytes, b.s.bytes)
        .blob:
            return compare_bytes(a.b, b.b)
        .tuple:
            var i: usize = 0
            while i < a.items.length and i < b.items.length:
                let c = compare(a.items[i], b.items[i])
                if c != 0:
                    return c
                i += 1
            return 0
        _: return 0

func compare_bytes(a: const u8[], b: const u8[]) -> i64:
    var i: usize = 0
    while i < a.length and i < b.length:
        if a[i] != b[i]:
            return -1 if a[i] < b[i] else 1
        i += 1
    if a.length == b.length:
        return 0
    return -1 if a.length < b.length else 1

## The display of a value (§10.5), written to a builder.
pub func display(out: strings.Builder*, v: Value) -> !:
    match v.kind:
        .unit_: try out.put("()")
        .boolean: try out.put("true" if v.i != 0 else "false")
        .integer:
            var room: u8[32]
            try out.put(try format(room, f"{v.i}"))
        .floating:
            var room: u8[64]
            try out.put(try format(room, f"{v.f}"))
        .text: try out.put(v.s)
        .blob:
            try out.put("b\"")
            var room: u8[4]
            for byte in v.b:
                room[0] = '\\'
                room[1] = 'x'
                room[2] = hex_digit(byte >> 4)
                room[3] = hex_digit(byte & 15)
                try out.put((str)room[..<4])
            try out.put("\"")
        .absent: try out.put("none")
        .code:
            var room: u8[48]
            try out.put(try format(room, f"ErrorCode({v.i})"))
        .failure: try out.put(v.s)
        .range_:
            var room: u8[64]
            try out.put(try format(room, f"{v.i}{"..=" if v.inclusive else "..<"}{v.hi}"))
        .tuple:
            try out.put("(")
            var i: usize = 0
            while i < v.items.length:
                if i > 0:
                    try out.put(", ")
                try display(out, v.items[i])
                i += 1
            if v.items.length == 1:
                try out.put(",")
            try out.put(")")
        .record:
            let d = v.decl else return
            try out.put(d.text)
            try out.put("(")
            var i: usize = 0
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.field:
                    if i > 0:
                        try out.put(", ")
                    try out.put(m.text)
                    try out.put(" = ")
                    try display(out, v.items[i])
                    i += 1
                cursor = m.next
            try out.put(")")
        .variant:
            let d = v.decl else return
            let case_node = v.case_node else return
            try out.put(d.text)
            try out.put(".")
            try out.put(case_node.text)
            if v.items.length > 0:
                try out.put("(")
                var i: usize = 0
                var cursor = case_node.body
                while let p = cursor:
                    if i > 0:
                        try out.put(", ")
                    try out.put(p.text)
                    try out.put(" = ")
                    try display(out, v.items[i])
                    i += 1
                    cursor = p.next
                try out.put(")")
        .object:
            # a class shows through `Display` only (§10.5); the checker refuses the rest
            let d = v.decl else return
            try out.put(d.text)
        .list_:
            try out.put("[")
            let items = elements(v)
            var i: usize = 0
            while i < items.length:
                if i > 0:
                    try out.put(", ")
                try display(out, items[i])
                i += 1
            try out.put("]")
        .set_:
            try out.put("{")
            let items = elements(v)
            var i: usize = 0
            while i < items.length:
                if i > 0:
                    try out.put(", ")
                try display(out, items[i])
                i += 1
            try out.put("}")
        .map_:
            try out.put("{")
            let items = elements(v)
            var i: usize = 0
            while i < items.length:
                if i > 0:
                    try out.put(", ")
                try display(out, items[i])
                try out.put(": ")
                try display(out, items[i + 1])
                i += 2
            try out.put("}")
        _:
            try out.put("func")

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

## The display as a text of its own, on the heap.
pub func shown(v: Value) -> str!:
    var b = try strings.Builder.create(64)
    try display(&b, v)
    let out = try strings.copy(b.view())
    b.destroy()
    return out
