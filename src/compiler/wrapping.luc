#==============================================================================================
#
#   wrapping - Two's-complement arithmetic the host cannot be trusted to perform
#
#   DESCRIPTION:
#       Stage-0 arithmetic traps on overflow, so a wrapping `+%` (base.md
#       §7.2) cannot be computed by adding and letting the host wrap. These
#       functions form the exact modulo-2^64 result without ever creating a
#       host value that overflows, and reduce it to a narrower width when the
#       type asks for one. Both oracles share them; the compiled backends use
#       the machine's own wrapping instructions.
#
#==============================================================================================

let i64_minimum: i64 = -9223372036854775807 - 1
let i64_maximum: i64 = 9223372036854775807
let low_half_mask: u64 = u64(4294967295)

# Stage-0 folds no top-level `u64` literal above the `i64` range.
func u64_maximum() -> u64:
    return u64(18446744073709551615)

# mark: Width reduction =======================================================================

## Keep the low `bits` of a signed value as a signed value of that width.
pub func wrap_signed(value: i64, bits: i64) -> i64:
    if bits >= 64: return value
    let mask = (1 << bits) - 1
    let low = value & mask
    if low >= (1 << (bits - 1)): return low - (mask + 1)
    return low

## Keep the low `bits` of an unsigned value.
pub func wrap_unsigned(value: u64, bits: i64) -> u64:
    if bits >= 64: return value
    return value & ((u64(1) << u64(bits)) - u64(1))

# mark: Modulo 2^64 ===========================================================================

## `left + right` modulo 2^64, as a signed value.
pub func wrap_add_i64(left: i64, right: i64) -> i64:
    if right >= 0 and left > i64_maximum - right:
        # The true sum exceeds the maximum by `left - (maximum - right)`.
        return (left - (i64_maximum - right) - 1) + i64_minimum
    if right < 0 and left < i64_minimum - right:
        # The true sum lies below the minimum; `2^64 = -2 * minimum`.
        return (left - i64_minimum) + (right - i64_minimum)
    return left + right

## `left - right` modulo 2^64, as a signed value.
pub func wrap_sub_i64(left: i64, right: i64) -> i64:
    if right == i64_minimum:
        # `-minimum` does not exist; `left - minimum == left + minimum` modulo 2^64.
        return wrap_add_i64(left, i64_minimum)
    return wrap_add_i64(left, 0 - right)

## `-value` modulo 2^64, as a signed value.
pub func wrap_negate_i64(value: i64) -> i64:
    return wrap_sub_i64(0, value)

## `left * right` modulo 2^64, as a signed value.
pub func wrap_mul_i64(left: i64, right: i64) -> i64:
    return signed_of_bits(wrap_mul_u64(bits_of_signed(left), bits_of_signed(right)))

## `left + right` modulo 2^64 for unsigned values.
pub func wrap_add_u64(left: u64, right: u64) -> u64:
    if left > u64_maximum() - right: return left - (u64_maximum() - right) - u64(1)
    return left + right

## `left - right` modulo 2^64 for unsigned values.
pub func wrap_sub_u64(left: u64, right: u64) -> u64:
    if left >= right: return left - right
    return (u64_maximum() - right) + left + u64(1)

## `-value` modulo 2^64 for an unsigned value.
pub func wrap_negate_u64(value: u64) -> u64:
    return wrap_sub_u64(u64(0), value)

## `left * right` modulo 2^64 for unsigned values, by 32-bit halves: every
## partial product of two halves fits in 64 bits, and the cross terms
## contribute only their low 32 bits shifted up.
pub func wrap_mul_u64(left: u64, right: u64) -> u64:
    let left_low = left & low_half_mask
    let left_high = left >> u64(32)
    let right_low = right & low_half_mask
    let right_high = right >> u64(32)
    let low = left_low * right_low
    let cross = wrap_add_u64(left_low * right_high, left_high * right_low) & low_half_mask
    return wrap_add_u64(low, cross << u64(32))

# mark: Bit patterns ==========================================================================

## The two's-complement bit pattern of a signed value.
pub func bits_of_signed(value: i64) -> u64:
    if value >= 0: return u64(value)
    return u64(9223372036854775808) + u64(value - i64_minimum)

## The signed value whose two's-complement bit pattern is `bits`.
pub func signed_of_bits(bits: u64) -> i64:
    if bits <= u64(9223372036854775807): return i64(bits)
    return i64_minimum + i64(bits - u64(9223372036854775808))
