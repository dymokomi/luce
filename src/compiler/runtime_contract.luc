#==============================================================================================
#
#   runtime_contract - Semantic services implemented by the sealed Luce runtime
#
#   DESCRIPTION:
#       This is the one target-neutral vocabulary shared by source-package
#       binding, HIR, and canonical MIR. A service is resolved to an exact HIR
#       symbol while compiling the sealed runtime, then to an exact MIR
#       function during lowering. No later stage searches a source or linker
#       name, and no backend fact belongs here.
#
#==============================================================================================

# mark: Semantic services =====================================================================

## A semantic operation whose implementation is supplied by the sealed Luce
## runtime package. Add a case only when a language operation needs a private
## runtime implementation rather than a host-facing runtime symbol.
pub enum RuntimeService:
    storage_allocator
    storage_deallocator
    equality_context_create
    equality_context_release
    equality_context_visit
    list_create
    list_retain
    list_release
    list_copy
    list_concat
    list_length
    list_iteration_begin
    list_iteration_end
    list_iteration_active
    list_append_slot
    list_insert_slot
    list_remove_at
    list_clear
    list_reserve
    list_element_address
    list_mutable_element_address
    list_slice
    buffer_retain
    buffer_release
    buffer_concat
    buffer_data
    string_scalar_count
    string_decode
    bytes_slice
    slice_retain
    slice_release
    slice_length
    slice_element_address
    class_create
    class_mark_initialized
    class_retain
    class_release
    class_payload
    weak_class_create
    weak_class_retain
    weak_class_release
    weak_class_promote
    interface_create
    interface_retain
    interface_release
    interface_detach
    interface_payload
    interface_witness
