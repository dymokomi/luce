from compiler.syntax import ArgumentSyntax, BindingPatternSyntax, ExpressionSyntax
from compiler.syntax import FunctionSyntax, ModuleSyntax, PathSyntax, StatementSyntax
from compiler.syntax import TypeArgumentSyntax, TypeSyntax
from compiler.tokenizer import SourceSpan, Token, TokenKind
from compiler.typed_ir import SymbolId, TypedArgument, TypedExpression, TypedExpressionForm
from compiler.typed_ir import TypedFunction, TypedIfBranch, TypedModule, TypedParameter
from compiler.typed_ir import TypedProgram, TypedStatement, TypedStatementForm, ValueType

# One parsed file with the identity supplied by its caller. The checker never
# guesses module identity from import spelling or source contents.
struct SourceModule:
    name: str
    path: str
    syntax: ModuleSyntax

private struct FunctionSymbol:
    symbol: SymbolId
    module_index: i64
    name: str
    is_public: bool
    parameters: list[TypedParameter]
    result: ValueType
    syntax: FunctionSyntax
    span: SourceSpan

private struct ImportedModule:
    name: str
    module_index: i64

private struct ImportedFunction:
    name: str
    function_index: i64

private struct ModuleBindings:
    modules: list[ImportedModule]
    functions: list[ImportedFunction]

private struct LocalBinding:
    symbol: SymbolId
    name: str
    value_type: ValueType
    is_mutable: bool

# Resolves module and lexical names while producing typed IR. Signature
# collection is internal so callers cannot run the checker in a partial state.
class Checker:
    private sources: list[SourceModule]
    private functions: list[FunctionSymbol]
    private next_symbol: i64
    private current_module: i64
    private current_result: ValueType
    private bindings: ModuleBindings
    private locals: list[LocalBinding]
    private loop_depth: i64

    init(sources: list[SourceModule]):
        self.sources = sources
        self.functions = list[FunctionSymbol]()
        self.next_symbol = 0
        self.current_module = 0
        self.current_result = ValueType(name = "unit")
        self.bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        self.locals = list[LocalBinding]()
        self.loop_depth = 0

    func check() -> TypedProgram!:
        try self.validate_module_names()
        try self.collect_function_signatures()

        let modules = list[TypedModule]()
        var module_index = 0
        while module_index < len(self.sources):
            self.current_module = module_index
            self.bindings = try self.resolve_imports(module_index)
            let typed_functions = list[TypedFunction]()

            var function_index = 0
            while function_index < len(self.functions):
                let function = self.functions[function_index]
                if function.module_index == module_index:
                    typed_functions.append(try self.check_function(function))
                function_index += 1

            let source = self.sources[module_index]
            modules.append(TypedModule(name = source.name, path = source.path, functions = typed_functions))
            module_index += 1
        return TypedProgram(modules = modules)

    # mark: Modules and declarations ---------------------------------------

    private func validate_module_names() -> !:
        var i = 0
        while i < len(self.sources):
            var previous = 0
            while previous < i:
                if self.sources[previous].name == self.sources[i].name:
                    try self.fail_at(i, self.sources[i].syntax.span, "duplicate module `" + self.sources[i].name + "`")
                previous += 1
            i += 1

    private func collect_function_signatures() -> !:
        var module_index = 0
        while module_index < len(self.sources):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    Function(function):
                        try self.collect_function(module_index, declaration.is_public, function, declaration.span)
                    else:
                        try self.fail_at(module_index, declaration.span, "semantic checking for `" + str(declaration.value) + "` is not implemented yet")
            module_index += 1

    private func collect_function(module_index: i64, is_public: bool, function: FunctionSyntax, span: SourceSpan) -> !:
        if self.function_in_module(module_index, function.name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + function.name + "`")
        if len(function.generic_parameters) > 0:
            try self.fail_at(module_index, span, "generic functions are not implemented by the semantic checker yet")
        if len(function.effects) > 0:
            try self.fail_at(module_index, span, "function effects are not implemented by the semantic checker yet")

        let parameters = list[TypedParameter]()
        for parameter in function.parameters:
            for previous in parameters:
                if previous.name == parameter.name:
                    try self.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
            if parameter.annotation == none:
                try self.fail_at(module_index, parameter.span, "parameter `" + parameter.name + "` requires a type")
            let annotation = parameter.annotation else trap("parameter annotation disappeared")
            if parameter.default_value != none:
                try self.fail_at(module_index, parameter.span, "default arguments are not implemented by the semantic checker yet")
            parameters.append(TypedParameter(symbol = self.new_symbol(), name = parameter.name, value_type = try self.resolve_type(module_index, annotation)))

        var result = ValueType(name = "unit")
        let result_syntax = function.result
        if result_syntax != none:
            result = try self.resolve_type(module_index, result_syntax)
        self.functions.append(FunctionSymbol(symbol = self.new_symbol(), module_index = module_index, name = function.name, is_public = is_public, parameters = parameters, result = result, syntax = function, span = span))

    private func resolve_type(module_index: i64, value: TypeSyntax) -> ValueType!:
        match value.form:
            Named(path):
                if len(path.parts) != 1 or not is_value_type_name(path.parts[0]):
                    try self.fail_at(module_index, path.span, "unknown type `" + path_name(path) + "`")
                return ValueType(name = path.parts[0])
            Applied(path, arguments, span):
                try self.fail_at(module_index, span, "applied types are not implemented by the semantic checker yet")
            TupleType(elements, span):
                try self.fail_at(module_index, span, "tuple types are not implemented by the semantic checker yet")
            FunctionType(parameters, result, effects, span):
                try self.fail_at(module_index, span, "function types are not implemented by the semantic checker yet")
            OptionalType(optional_value, span):
                try self.fail_at(module_index, span, "optional types are not implemented by the semantic checker yet")
            FallibleType(successful_value, span):
                try self.fail_at(module_index, span, "fallible types are not implemented by the semantic checker yet")
        trap("unreachable type form")

    private func resolve_imports(module_index: i64) -> ModuleBindings!:
        let bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        for import_value in self.sources[module_index].syntax.imports:
            let imported_name = path_name(import_value.path)
            let imported_module = self.source_index(imported_name)
            if imported_module < 0:
                try self.fail_at(module_index, import_value.path.span, "unknown module `" + imported_name + "`")
            if imported_module == module_index:
                try self.fail_at(module_index, import_value.path.span, "a module cannot import itself")

            if len(import_value.names) == 0:
                let local_name = import_value.alias_name else last_path_part(import_value.path)
                try self.require_free_import_name(module_index, bindings, local_name, import_value.span)
                bindings.modules.append(ImportedModule(name = local_name, module_index = imported_module))
            else:
                for imported in import_value.names:
                    try self.require_free_import_name(module_index, bindings, imported.name, imported.span)
                    let function_index = self.function_in_module(imported_module, imported.name)
                    if function_index < 0:
                        try self.fail_at(module_index, imported.span, "module `" + imported_name + "` has no function `" + imported.name + "`")
                    if not self.functions[function_index].is_public:
                        try self.fail_at(module_index, imported.span, "`" + imported.name + "` is private to module `" + imported_name + "`")
                    bindings.functions.append(ImportedFunction(name = imported.name, function_index = function_index))
        return bindings

    private func require_free_import_name(module_index: i64, bindings: ModuleBindings, name: str, span: SourceSpan) -> !:
        if self.function_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        for imported in bindings.modules:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")
        for imported in bindings.functions:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")

    # mark: Functions and statements ---------------------------------------

    private func check_function(function: FunctionSymbol) -> TypedFunction!:
        self.current_result = function.result
        self.locals = list[LocalBinding]()
        self.loop_depth = 0

        for parameter in function.parameters:
            try self.require_free_local_name(parameter.name, function.span)
            self.locals.append(LocalBinding(symbol = parameter.symbol, name = parameter.name, value_type = parameter.value_type, is_mutable = false))

        let body_syntax = function.syntax.body else trap("function definition has no body")
        let body = try self.check_suite(body_syntax.statements)
        if function.result.name != "unit" and not statements_return(body):
            try self.fail(function.span, "function `" + function.name + "` may finish without returning `" + function.result.name + "`")
        return TypedFunction(symbol = function.symbol, name = function.name, is_public = function.is_public, parameters = function.parameters, result = function.result, body = body, span = function.span)

    private func check_suite(statements: list[StatementSyntax]) -> list[TypedStatement]!:
        let local_count = len(self.locals)
        let typed = list[TypedStatement]()
        for statement in statements:
            typed.append(try self.check_statement(statement))
        while len(self.locals) > local_count:
            self.locals.remove(len(self.locals) - 1)
        return typed

    private func check_statement(statement: StatementSyntax) -> TypedStatement!:
        match statement.form:
            BreakStatement(span):
                if self.loop_depth == 0: try self.fail(span, "`break` is only valid inside a loop")
                return TypedStatement(form = TypedStatementForm.BreakStatement, span = span)
            ContinueStatement(span):
                if self.loop_depth == 0: try self.fail(span, "`continue` is only valid inside a loop")
                return TypedStatement(form = TypedStatementForm.ContinueStatement, span = span)
            Binding(is_mutable, pattern, annotation, value, span):
                return try self.check_binding(is_mutable, pattern, annotation, value, span)
            Assignment(target, operator, value, span):
                return try self.check_assignment(target, operator, value, span)
            ReturnStatement(value, span):
                return try self.check_return(value, span)
            ExpressionStatement(value, span):
                return TypedStatement(form = TypedStatementForm.ExpressionStatement(value = try self.check_expression(value, none)), span = span)
            IfStatement(branches, fallback, span):
                let typed_branches = list[TypedIfBranch]()
                for branch in branches:
                    match branch.condition.form:
                        Expression(condition):
                            let checked = try self.check_expression(condition, ValueType(name = "bool"))
                            typed_branches.append(TypedIfBranch(condition = checked, body = try self.check_suite(branch.body.statements)))
                        else:
                            try self.fail(branch.span, "conditional bindings are not implemented by the semantic checker yet")
                var typed_fallback: list[TypedStatement]? = none
                if fallback != none:
                    let fallback_suite = fallback
                    typed_fallback = try self.check_suite(fallback_suite.statements)
                return TypedStatement(form = TypedStatementForm.IfStatement(branches = typed_branches, fallback = typed_fallback), span = span)
            WhileStatement(condition, body, span):
                let checked_condition = try self.check_expression(condition, ValueType(name = "bool"))
                self.loop_depth += 1
                let checked_body = try self.check_suite(body.statements)
                self.loop_depth -= 1
                return TypedStatement(form = TypedStatementForm.WhileStatement(condition = checked_condition, body = checked_body), span = span)
            else:
                try self.fail(statement_span(statement), "semantic checking for `" + str(statement.form) + "` is not implemented yet")
        trap("unreachable statement form")

    private func check_binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan) -> TypedStatement!:
        match pattern:
            Name(name, name_span):
                try self.require_free_local_name(name, name_span)
                var expected: ValueType? = none
                if annotation != none:
                    let type_syntax = annotation
                    expected = try self.resolve_type(self.current_module, type_syntax)
                let checked = try self.check_expression(value, expected)
                let symbol = self.new_symbol()
                self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = checked.value_type, is_mutable = is_mutable))
                return TypedStatement(form = TypedStatementForm.Binding(symbol = symbol, name = name, is_mutable = is_mutable, value = checked), span = span)
            else:
                try self.fail(span, "tuple bindings are not implemented by the semantic checker yet")
        trap("unreachable binding pattern")

    private func check_assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan) -> TypedStatement!:
        var name = ""
        match target.form:
            Name(value_name, target_span): name = value_name
            else: try self.fail(span, "member and index assignment are not implemented by the semantic checker yet")
        let local_index = self.local_index(name)
        if local_index < 0: try self.fail(span, "unknown local binding `" + name + "`")
        let local = self.locals[local_index]
        if not local.is_mutable: try self.fail(span, "cannot assign to immutable binding `" + name + "`; declare it with `var`")
        let checked = try self.check_expression(value, local.value_type)
        if operator != "=":
            let binary_operator = operator[0:len(operator) - 1]
            let result = try self.binary_type(local.value_type, binary_operator, checked.value_type, span)
            if result.name != local.value_type.name:
                try self.fail(span, "assignment changes `" + name + "` from `" + local.value_type.name + "` to `" + result.name + "`")
        return TypedStatement(form = TypedStatementForm.Assignment(symbol = local.symbol, operator = operator, value = checked), span = span)

    private func check_return(value: ExpressionSyntax?, span: SourceSpan) -> TypedStatement!:
        if value == none:
            if self.current_result.name != "unit":
                try self.fail(span, "return requires a `" + self.current_result.name + "` value")
            return TypedStatement(form = TypedStatementForm.ReturnStatement(value = none), span = span)
        if self.current_result.name == "unit":
            try self.fail(span, "a `unit` function cannot return a value")
        let returned = value
        let checked = try self.check_expression(returned, self.current_result)
        return TypedStatement(form = TypedStatementForm.ReturnStatement(value = checked), span = span)

    # mark: Expressions -----------------------------------------------------

    private func check_expression(value: ExpressionSyntax, expected: ValueType?) -> TypedExpression!:
        match value.form:
            Literal(token): return try self.check_literal(token, expected)
            Name(name, span):
                let local_index = self.local_index(name)
                if local_index >= 0:
                    let local = self.locals[local_index]
                    return try self.require_type(TypedExpression(value_type = local.value_type, form = TypedExpressionForm.Reference(symbol = local.symbol), span = span), expected)
                if self.visible_function(name) >= 0:
                    try self.fail(span, "function values are not implemented by the semantic checker yet")
                try self.fail(span, "unknown name `" + name + "`")
            Group(grouped, span): return try self.check_expression(grouped, expected)
            Unary(operator, operand, span): return try self.check_unary(operator, operand, span, expected)
            Binary(left, operator, right, span): return try self.check_binary(left, operator, right, span, expected)
            Conditional(selected, condition, alternative, span):
                let checked_condition = try self.check_expression(condition, ValueType(name = "bool"))
                let checked_value = try self.check_expression(selected, expected)
                let checked_alternative = try self.check_expression(alternative, checked_value.value_type)
                let typed = TypedExpression(value_type = checked_value.value_type, form = TypedExpressionForm.Conditional(value = checked_value, condition = checked_condition, alternative = checked_alternative), span = span)
                return try self.require_type(typed, expected)
            Call(callee, type_arguments, arguments, span):
                return try self.check_call(callee, type_arguments, arguments, span, expected)
            else:
                try self.fail(expression_span(value), "semantic checking for `" + str(value.form) + "` is not implemented yet")
        trap("unreachable expression form")

    private func check_literal(token: Token, expected: ValueType?) -> TypedExpression!:
        var value_type = ValueType(name = "unit")
        if token.kind == TokenKind.int_lit:
            if token.suffix != "":
                value_type = ValueType(name = token.suffix)
            elif expected != none and is_integer(expected.name):
                value_type = expected
            else:
                value_type = ValueType(name = "i64")
        elif token.kind == TokenKind.float_lit:
            if token.suffix != "":
                value_type = ValueType(name = token.suffix)
            elif expected != none and is_float(expected.name):
                value_type = expected
            else:
                value_type = ValueType(name = "f64")
        elif token.kind == TokenKind.char_lit:
            if expected != none and is_integer(expected.name):
                value_type = expected
            else:
                value_type = ValueType(name = "char")
        elif token.kind == TokenKind.str_lit:
            value_type = ValueType(name = "str")
        elif token.kind == TokenKind.byte_lit:
            value_type = ValueType(name = "bytes")
        elif token.text == "true" or token.text == "false":
            value_type = ValueType(name = "bool")
        else:
            try self.fail(token.span, "optional values are not implemented by the semantic checker yet")
        return try self.require_type(TypedExpression(value_type = value_type, form = TypedExpressionForm.Literal(text = token.text), span = token.span), expected)

    private func check_unary(operator: str, operand: ExpressionSyntax, span: SourceSpan, expected: ValueType?) -> TypedExpression!:
        if operator == "not":
            let checked = try self.check_expression(operand, ValueType(name = "bool"))
            return try self.require_type(TypedExpression(value_type = ValueType(name = "bool"), form = TypedExpressionForm.Unary(operator = operator, operand = checked), span = span), expected)
        if operator == "try": try self.fail(span, "fallible calls are not implemented by the semantic checker yet")

        let checked = try self.check_expression(operand, expected)
        if operator == "~" and not is_integer(checked.value_type.name):
            try self.fail(span, "`~` requires an integer, found `" + checked.value_type.name + "`")
        if (operator == "+" or operator == "-") and not is_numeric(checked.value_type.name):
            try self.fail(span, "`" + operator + "` requires a number, found `" + checked.value_type.name + "`")
        if operator == "-" and is_unsigned(checked.value_type.name):
            try self.fail(span, "unary `-` does not accept unsigned `" + checked.value_type.name + "`")
        return try self.require_type(TypedExpression(value_type = checked.value_type, form = TypedExpressionForm.Unary(operator = operator, operand = checked), span = span), expected)

    private func check_binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan, expected: ValueType?) -> TypedExpression!:
        var operand_context: ValueType? = none
        if is_arithmetic_operator(operator) and expected != none:
            operand_context = expected
        let checked_left = try self.check_expression(left, operand_context)
        let checked_right = try self.check_expression(right, checked_left.value_type)
        let result = try self.binary_type(checked_left.value_type, operator, checked_right.value_type, span)
        let typed = TypedExpression(value_type = result, form = TypedExpressionForm.Binary(left = checked_left, operator = operator, right = checked_right), span = span)
        return try self.require_type(typed, expected)

    private func binary_type(left: ValueType, operator: str, right: ValueType, span: SourceSpan) -> ValueType!:
        if left.name != right.name:
            try self.fail(span, "`" + operator + "` has `" + left.name + "` on the left and `" + right.name + "` on the right")
        if operator == "and" or operator == "or":
            if left.name != "bool": try self.fail(span, "`" + operator + "` requires `bool` operands")
            return ValueType(name = "bool")
        if operator == "==" or operator == "!=": return ValueType(name = "bool")
        if operator == "<" or operator == "<=" or operator == ">" or operator == ">=":
            if not is_ordered(left.name): try self.fail(span, "`" + operator + "` does not order `" + left.name + "`")
            return ValueType(name = "bool")
        if operator == "+" and (left.name == "str" or left.name == "bytes"): return left
        if operator == "/":
            if not is_float(left.name): try self.fail(span, "`/` requires floating-point operands")
            return left
        if operator == "//" or operator == "%":
            if not is_integer(left.name): try self.fail(span, "`" + operator + "` requires integer operands")
            return left
        if operator == "+" or operator == "-" or operator == "*":
            if not is_numeric(left.name): try self.fail(span, "`" + operator + "` requires numeric operands")
            return left
        if operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>":
            if not is_integer(left.name): try self.fail(span, "`" + operator + "` requires integer operands")
            return left
        try self.fail(span, "operator `" + operator + "` is not implemented by the semantic checker yet")
        trap("unreachable binary operator")

    private func check_call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: ValueType?) -> TypedExpression!:
        if len(type_arguments) > 0: try self.fail(span, "generic calls are not implemented by the semantic checker yet")
        let function_index = try self.resolve_callee(callee)
        let function = self.functions[function_index]
        let assigned = list[bool]()
        for parameter in function.parameters: assigned.append(false)
        let typed_arguments = list[TypedArgument]()
        var positional_index = 0
        var saw_named = false

        for argument in arguments:
            var parameter_index = -1
            if argument.label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                parameter_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                let label = argument.label else trap("argument label disappeared")
                parameter_index = parameter_named(function, label)
                if parameter_index < 0: try self.fail(argument.span, "function `" + function.name + "` has no parameter `" + label + "`")
            if parameter_index >= len(function.parameters):
                try self.fail(argument.span, "function `" + function.name + "` accepts " + str(len(function.parameters)) + " argument(s)")
            if assigned[parameter_index]:
                try self.fail(argument.span, "parameter `" + function.parameters[parameter_index].name + "` is supplied more than once")
            assigned[parameter_index] = true
            let checked = try self.check_expression(argument.value, function.parameters[parameter_index].value_type)
            typed_arguments.append(TypedArgument(parameter_index = parameter_index, value = checked))

        var parameter_index = 0
        while parameter_index < len(function.parameters):
            if not assigned[parameter_index]:
                try self.fail(span, "call to `" + function.name + "` is missing argument `" + function.parameters[parameter_index].name + "`")
            parameter_index += 1
        let typed = TypedExpression(value_type = function.result, form = TypedExpressionForm.Call(function = function.symbol, arguments = typed_arguments), span = span)
        return try self.require_type(typed, expected)

    private func resolve_callee(callee: ExpressionSyntax) -> i64!:
        match callee.form:
            Name(name, span):
                let local_index = self.local_index(name)
                if local_index >= 0:
                    try self.fail(span, "`" + name + "` has type `" + self.locals[local_index].value_type.name + "` and is not callable")
                let function_index = self.visible_function(name)
                if function_index < 0: try self.fail(span, "unknown function `" + name + "`")
                return function_index
            Member(value, name, span):
                var module_name = ""
                match value.form:
                    Name(candidate, value_span): module_name = candidate
                    else: try self.fail(span, "method calls are not implemented by the semantic checker yet")
                let imported_module = self.imported_module(module_name)
                if imported_module < 0: try self.fail(span, "unknown imported module `" + module_name + "`")
                let function_index = self.function_in_module(imported_module, name)
                if function_index < 0: try self.fail(span, "module `" + self.sources[imported_module].name + "` has no function `" + name + "`")
                if not self.functions[function_index].is_public:
                    try self.fail(span, "`" + name + "` is private to module `" + self.sources[imported_module].name + "`")
                return function_index
            else: try self.fail(expression_span(callee), "only named functions are callable in the current semantic slice")
        trap("unreachable callee form")

    # mark: Lookup and diagnostics -----------------------------------------

    private func require_type(value: TypedExpression, expected: ValueType?) -> TypedExpression!:
        if expected != none:
            let required = expected
            if value.value_type.name != required.name:
                try self.fail(value.span, "expected `" + required.name + "`, found `" + value.value_type.name + "`")
        return value

    private func require_free_local_name(name: str, span: SourceSpan) -> !:
        if self.local_index(name) >= 0:
            try self.fail(span, "`" + name + "` is already bound in this scope")
        if self.imported_function(name) >= 0 or self.imported_module(name) >= 0:
            try self.fail(span, "local `" + name + "` cannot shadow an imported name")

    private func local_index(name: str) -> i64:
        var i = len(self.locals) - 1
        while i >= 0:
            if self.locals[i].name == name: return i
            i -= 1
        return -1

    private func visible_function(name: str) -> i64:
        let imported = self.imported_function(name)
        if imported >= 0: return imported
        return self.function_in_module(self.current_module, name)

    private func imported_function(name: str) -> i64:
        for imported in self.bindings.functions:
            if imported.name == name: return imported.function_index
        return -1

    private func imported_module(name: str) -> i64:
        for imported in self.bindings.modules:
            if imported.name == name: return imported.module_index
        return -1

    private func function_in_module(module_index: i64, name: str) -> i64:
        var i = 0
        while i < len(self.functions):
            if self.functions[i].module_index == module_index and self.functions[i].name == name: return i
            i += 1
        return -1

    private func source_index(name: str) -> i64:
        var i = 0
        while i < len(self.sources):
            if self.sources[i].name == name: return i
            i += 1
        return -1

    private func new_symbol() -> SymbolId:
        let symbol = SymbolId(value = self.next_symbol)
        self.next_symbol += 1
        return symbol

    private func fail(span: SourceSpan, message: str) -> !:
        try self.fail_at(self.current_module, span, message)

    private func fail_at(module_index: i64, span: SourceSpan, message: str) -> !:
        error(self.sources[module_index].path + ":" + str(span.line) + ":" + str(span.column) + ": " + message)


private func parameter_named(function: FunctionSymbol, name: str) -> i64:
    var i = 0
    while i < len(function.parameters):
        if function.parameters[i].name == name: return i
        i += 1
    return -1

private func path_name(path: PathSyntax) -> str:
    var name = path.parts[0]
    var i = 1
    while i < len(path.parts):
        name = name + "." + path.parts[i]
        i += 1
    return name

private func last_path_part(path: PathSyntax) -> str:
    return path.parts[len(path.parts) - 1]

private func statements_return(statements: list[TypedStatement]) -> bool:
    for statement in statements:
        match statement.form:
            ReturnStatement(value): return true
            IfStatement(branches, fallback):
                if fallback != none:
                    var every_branch_returns = true
                    for branch in branches:
                        if not statements_return(branch.body): every_branch_returns = false
                    let fallback_body = fallback
                    if every_branch_returns and statements_return(fallback_body): return true
            else: continue
    return false

private func statement_span(statement: StatementSyntax) -> SourceSpan:
    match statement.form:
        BreakStatement(span): return span
        ContinueStatement(span): return span
        Binding(is_mutable, pattern, annotation, value, span): return span
        Assignment(target, operator, value, span): return span
        ReturnStatement(value, span): return span
        DeferStatement(value, span): return span
        RecoverStatement(value, span): return span
        ExpressionStatement(value, span): return span
        IfStatement(branches, fallback, span): return span
        WhileStatement(condition, body, span): return span
        ForStatement(name, iterable, body, span): return span
        MatchStatement(subject, arms, span): return span

private func expression_span(value: ExpressionSyntax) -> SourceSpan:
    match value.form:
        Literal(token): return token.span
        Name(name, span): return span
        CaseValue(name, arguments, span): return span
        Group(grouped, span): return span
        TupleValue(elements, span): return span
        ListValue(elements, span): return span
        MapValue(entries, span): return span
        Unary(operator, operand, span): return span
        Binary(left, operator, right, span): return span
        Conditional(selected, condition, alternative, span): return span
        Member(target, name, span): return span
        Call(callee, type_arguments, arguments, span): return span
        Index(target, subscript, span): return span
        Slice(target, start, operator, end, span): return span
        Lambda(parameters, body, span): return span
        Closure(captures, parameters, result, effects, body, span): return span
        MatchValue(subject, arms, span): return span
        NewValue(value_type, arguments, span): return span
        SpawnValue(function, arguments, span): return span
        CatchValue(fallible, failure_name, body, span): return span

private func is_integer(name: str) -> bool:
    return match name:
        "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64" => true
        else => false

private func is_unsigned(name: str) -> bool:
    return name == "u8" or name == "u16" or name == "u32" or name == "u64"

private func is_float(name: str) -> bool:
    return name == "f16" or name == "f32" or name == "f64"

private func is_numeric(name: str) -> bool:
    return is_integer(name) or is_float(name)

private func is_ordered(name: str) -> bool:
    return is_numeric(name) or name == "char" or name == "str" or name == "bytes"

private func is_arithmetic_operator(operator: str) -> bool:
    return operator == "+" or operator == "-" or operator == "*" or operator == "/" or operator == "//" or operator == "%" or operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>"

private func is_value_type_name(name: str) -> bool:
    return is_numeric(name) or name == "bool" or name == "char" or name == "str" or name == "bytes" or name == "unit"
