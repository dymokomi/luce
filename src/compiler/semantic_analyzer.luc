#==============================================================================================
#
#   semantic_analyzer - Whole-program rules over typed HIR
#
#   DESCRIPTION:
#       The semantic middle end between type checking and execution/lowering.
#       This stage will own rules that need typed program context rather than
#       source spelling: control-flow validity, declared effects, definite
#       initialization, moves, borrows, lifetimes, and ownership.
#
#       Today `Checker` already proves the flow and effect rules supported by
#       the executable slice, and Luce has no owning reference values to track.
#       The analyzer is therefore an intentional identity pass: it establishes
#       the permanent pipeline boundary without pretending to perform checks
#       that the language does not implement yet. Rules move here as typed HIR
#       grows rich enough to express them.
#
#       Example:
#
#       typed HIR -> SemanticAnalyzer.analyze -> analyzed typed HIR
#
#==============================================================================================

from compiler.typed_ir import TypedProgram

## Applies whole-program semantic rules to typed HIR. The returned type stays
## `TypedProgram` because analysis annotates or validates HIR rather than
## changing its abstraction level.
pub class SemanticAnalyzer:
    program: TypedProgram

    ## Prepare to analyze one typed program; no source syntax is needed beyond
    ## this boundary because names and types are already resolved in HIR.
    pub init(program: TypedProgram):
        self.program = program

    # mark: Analysis ===========================================================================

    ## Validate and annotate one typed program. For example, this will
    ## eventually reject a use after move and attach ownership facts needed by
    ## lowering. The current language slice needs no work beyond `Checker`.
    pub func analyze() -> TypedProgram!:
        return self.program
