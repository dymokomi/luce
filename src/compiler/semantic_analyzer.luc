#==============================================================================================
#
#   semantic_analyzer - Whole-program rules over typed HIR
#
#   DESCRIPTION:
#       The semantic middle end between type checking and execution/lowering.
#       This stage will own rules that need typed program context: control-flow validity, definite
#       initialization, moves, borrows, lifetimes, and ownership.
#
#       Today `Checker` already proves the flow rules supported by
#       the executable slice, and Luce has no owning reference values to track.
#       The analyzer is therefore an intentional identity pass over the HIR
#       data, but it returns a distinct `AnalyzedProgram` wrapper. That wrapper
#       makes the permanent pipeline boundary enforceable: interpreters and
#       lowerers cannot accidentally consume unchecked HIR. Rules move here as
#       HIR grows rich enough to express them.
#
#       Example:
#
#       HirProgram -> SemanticAnalyzer.analyze -> AnalyzedProgram
#
#==============================================================================================

from compiler.hir import HirProgram

## Typed HIR that has crossed whole-program semantic analysis. The wrapper
## carries no extra facts yet; future flow and ownership results belong here.
pub struct AnalyzedProgram:
    pub hir: HirProgram

## Applies whole-program semantic rules to typed HIR and marks the result as
## analyzed without changing its representation level.
pub class SemanticAnalyzer:
    program: HirProgram

    ## Prepare to analyze one HIR program; no source syntax is needed beyond
    ## this boundary because names and types are already resolved in HIR.
    pub init(program: HirProgram):
        self.program = program

    # mark: Analysis ===========================================================================

    ## Validate and annotate one HIR program. For example, this will
    ## eventually reject a use after move and attach ownership facts needed by
    ## lowering. The current language slice needs no work beyond `Checker`.
    pub func analyze() -> AnalyzedProgram!:
        return AnalyzedProgram(hir = self.program)
