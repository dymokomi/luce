#==============================================================================================
#
#   hir - Luce after names and types have meaning
#
#   DESCRIPTION:
#       The High-level Intermediate Representation is the compiler's semantic
#       center. Every reference is a `SymbolId`, every type is a `TypeId`, every
#       effect is an `Effect`, and every operator is a resolved tagged operation.
#       Source spellings such as `"i64"`, `"terminal"`, and `"+"` stop at the
#       checker and are never reinterpreted by analysis, execution, or lowering.
#
#       HIR deliberately keeps readable language structure: functions contain
#       suites, statements contain `if` and `while`, and expressions remain
#       trees. Canonical MIR later flattens that structure and fixes machine
#       evaluation order.
#
#       The file follows one program from broadest shape to smallest:
#
#       program -> modules/functions -> statements -> expressions
#               -> operations -> effects -> types/symbols -> values
#
#==============================================================================================

from compiler.tokenizer import SourceSpan

# mark: Program shape =========================================================================

## One fully resolved and type-checked program. Functions and symbols are flat
## program-wide tables so a resolved identity never requires a module-tree walk.
pub struct HirProgram:
    pub types: TypeTable
    pub symbols: list[HirSymbol]
    pub modules: list[HirModule]
    pub functions: list[HirFunction]

## One source module. `ModuleId.value` is its index in `HirProgram.modules`;
## functions refer back to that identity instead of copying module names.
pub struct HirModule:
    pub id: ModuleId
    pub name: str
    pub path: str

## One checked function with a resolved signature, effect set, and body.
pub struct HirFunction:
    pub symbol: SymbolId
    pub module: ModuleId
    pub name: str
    pub is_public: bool
    pub parameters: list[HirParameter]
    pub result: TypeId
    pub effects: EffectSet
    pub body: list[HirStatement]
    pub span: SourceSpan

## One parameter. Its diagnostic name remains, but references use its symbol.
pub struct HirParameter:
    pub symbol: SymbolId
    pub name: str
    pub value_type: TypeId

# mark: Statements =============================================================================

## One checked statement with its source location retained for diagnostics.
pub class HirStatement:
    pub form: HirStatementForm
    pub span: SourceSpan

    ## Store one resolved statement form and its original source location.
    pub init(form: HirStatementForm, span: SourceSpan):
        self.form = form
        self.span = span

## The semantic statement forms. Assignment carries a resolved operation, so
## consumers never need to interpret source spellings such as `+=`.
pub union HirStatementForm:
    BreakStatement
    ContinueStatement
    Binding(symbol: SymbolId, name: str, is_mutable: bool, value: HirExpression)
    Assignment(symbol: SymbolId, operation: AssignmentOperation, value: HirExpression)
    PrintText(value: str)
    ReturnStatement(value: HirExpression?)
    ExpressionStatement(value: HirExpression)
    IfStatement(branches: list[HirIfBranch], fallback: list[HirStatement]?)
    WhileStatement(condition: HirExpression, body: list[HirStatement])

## One `if` or `elif` arm: a bool condition and the statements it guards.
pub struct HirIfBranch:
    pub condition: HirExpression
    pub body: list[HirStatement]

# mark: Expressions ============================================================================

## One checked expression. Its result type and operation are already settled.
pub class HirExpression:
    pub value_type: TypeId
    pub form: HirExpressionForm
    pub span: SourceSpan

    ## Store one resolved expression form, result type, and source location.
    pub init(value_type: TypeId, form: HirExpressionForm, span: SourceSpan):
        self.value_type = value_type
        self.form = form
        self.span = span

## The semantic expression forms. Calls target symbols and arguments already
## occupy parameter positions, so evaluation performs no name resolution.
pub union HirExpressionForm:
    Constant(value: Value)
    Reference(symbol: SymbolId)
    Unary(operation: UnaryOperation, operand: HirExpression)
    Binary(left: HirExpression, operation: BinaryOperation, right: HirExpression)
    Conditional(value: HirExpression, condition: HirExpression, alternative: HirExpression)
    Call(function: SymbolId, arguments: list[HirArgument])

## One call argument already matched to its parameter slot.
pub struct HirArgument:
    pub parameter_index: i64
    pub value: HirExpression

# mark: Resolved operations ====================================================================

## How an assignment obtains its new value. `Combine(Add(i64))` is the semantic
## meaning of source `+=` after the checker has resolved its operand type.
pub union AssignmentOperation:
    Replace
    Combine(operation: BinaryOperation)

## One unary operation with its operand family fixed where needed.
pub union UnaryOperation:
    LogicalNot
    NumericIdentity(operand_type: TypeId)
    NumericNegate(operand_type: TypeId)
    IntegerBitwiseNot(operand_type: TypeId)

## One binary operation. The embedded operand type distinguishes, for example,
## integer addition from floating-point addition without target-specific detail.
pub union BinaryOperation:
    LogicalAnd
    LogicalOr
    Equal(operand_type: TypeId)
    NotEqual(operand_type: TypeId)
    Less(operand_type: TypeId)
    LessEqual(operand_type: TypeId)
    Greater(operand_type: TypeId)
    GreaterEqual(operand_type: TypeId)
    Add(operand_type: TypeId)
    Subtract(operand_type: TypeId)
    Multiply(operand_type: TypeId)
    Divide(operand_type: TypeId)
    FloorDivide(operand_type: TypeId)
    Remainder(operand_type: TypeId)
    BitwiseAnd(operand_type: TypeId)
    BitwiseOr(operand_type: TypeId)
    BitwiseXor(operand_type: TypeId)
    ShiftLeft(operand_type: TypeId)
    ShiftRight(operand_type: TypeId)

# mark: Effects ================================================================================

## A language effect after signature resolution.
pub enum Effect:
    terminal

## The effects one function may perform. The list is a set: the checker emits
## each effect at most once and consumers query it by semantic identity.
pub struct EffectSet:
    pub values: list[Effect]

## Create an effect set containing no capabilities.
pub func create_empty_effect_set() -> EffectSet:
    return EffectSet(values = list[Effect]())

## Report whether a resolved effect set contains one semantic effect.
pub func contains_effect(effects: EffectSet, expected: Effect) -> bool:
    for effect in effects.values:
        if effect == expected: return true
    return false

# mark: Types ==================================================================================

## The identity of one canonical type in `TypeTable.definitions`.
pub struct TypeId:
    pub value: i64

## The structural meaning of one type. New nominal and compound shapes grow
## here without changing every HIR node that refers to a type.
pub union TypeForm:
    Unit
    Boolean
    Integer(bits: i64, is_signed: bool)
    Floating(bits: i64)
    String
    Slice(element: TypeId)

## One canonical type table entry. `name` exists for diagnostics only; semantic
## consumers inspect `form` or compare `TypeId`s.
pub struct TypeDefinition:
    pub id: TypeId
    pub name: str
    pub form: TypeForm

## All canonical types known to one HIR program.
pub struct TypeTable:
    pub definitions: list[TypeDefinition]

## The built-in types with stable IDs used by the current language slice.
pub enum BuiltinType:
    unit
    boolean
    signed_i32
    signed_i64
    float64
    string
    string_slice

## Create the canonical built-in type table. For example, `slice[str]` refers
## to the same `str` TypeId stored earlier in this table.
pub func create_builtin_type_table() -> TypeTable:
    let definitions = list[TypeDefinition]()
    definitions.append(TypeDefinition(id = TypeId(value = 0), name = "unit", form = TypeForm.Unit))
    definitions.append(TypeDefinition(id = TypeId(value = 1), name = "bool", form = TypeForm.Boolean))
    definitions.append(TypeDefinition(id = TypeId(value = 2), name = "i32", form = TypeForm.Integer(bits = 32, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 3), name = "i64", form = TypeForm.Integer(bits = 64, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 4), name = "f64", form = TypeForm.Floating(bits = 64)))
    definitions.append(TypeDefinition(id = TypeId(value = 5), name = "str", form = TypeForm.String))
    definitions.append(TypeDefinition(id = TypeId(value = 6), name = "slice[str]", form = TypeForm.Slice(element = TypeId(value = 5))))
    return TypeTable(definitions = definitions)

## Create a valid empty HIR program for tests and tools that need a neutral
## starting value before adding modules, symbols, or functions.
pub func create_empty_hir_program() -> HirProgram:
    return HirProgram(
        types = create_builtin_type_table(),
        symbols = list[HirSymbol](),
        modules = list[HirModule](),
        functions = list[HirFunction](),
    )

## Resolve one built-in semantic type to its stable canonical identity.
pub func resolve_builtin_type(value: BuiltinType) -> TypeId:
    return match value:
        unit => TypeId(value = 0)
        boolean => TypeId(value = 1)
        signed_i32 => TypeId(value = 2)
        signed_i64 => TypeId(value = 3)
        float64 => TypeId(value = 4)
        string => TypeId(value = 5)
        string_slice => TypeId(value = 6)

## Return the diagnostic spelling of one type identity.
pub func describe_type(types: TypeTable, value: TypeId) -> str:
    if value.value < 0 or value.value >= len(types.definitions):
        return "<invalid type " + str(value.value) + ">"
    return types.definitions[value.value].name

## Report whether two type identities denote the same canonical type.
pub func types_match(left: TypeId, right: TypeId) -> bool:
    return left.value == right.value

## Report whether a type is either implemented integer type.
pub func is_integer_type(value: TypeId) -> bool:
    return value.value == resolve_builtin_type(BuiltinType.signed_i32).value or value.value == resolve_builtin_type(BuiltinType.signed_i64).value

## Report whether a type is the implemented floating-point type.
pub func is_floating_type(value: TypeId) -> bool:
    return value.value == resolve_builtin_type(BuiltinType.float64).value

## Report whether a type supports numeric arithmetic.
pub func is_numeric_type(value: TypeId) -> bool:
    return is_integer_type(value) or is_floating_type(value)

## Report whether a type supports ordered comparisons.
pub func is_ordered_type(value: TypeId) -> bool:
    return is_numeric_type(value)

# mark: Symbols ================================================================================

## The identity of one module in `HirProgram.modules`.
pub struct ModuleId:
    pub value: i64

## The identity of one binding or function in `HirProgram.symbols`.
pub struct SymbolId:
    pub value: i64

## What declaration introduced a symbol.
pub enum SymbolKind:
    function
    parameter
    local

## One program-wide semantic symbol. `value_type` is a binding's value type or
## a function's result type; full function signatures live in `HirFunction`.
pub struct HirSymbol:
    pub id: SymbolId
    pub name: str
    pub kind: SymbolKind
    pub value_type: TypeId

# mark: Runtime values =========================================================================

## Values already decoded by the checker. No consumer understands literal
## source spelling; it works only with these semantic values.
pub union Value:
    Unit
    Boolean(value: bool)
    Integer(value: i64)
    Floating(value: f64)

    ## Render one runtime value for command-line output.
    pub func render() -> str:
        match self:
            Unit: return "unit"
            Boolean(item): return str(item)
            Integer(item): return str(item)
            Floating(item): return str(item)
