from compiler.backend import ArtifactBackend
from compiler.canonical_ir import CanonicalProgram
import std.strings

# A direct WebAssembly encoder for the first canonical-IR slice. It writes the
# binary format itself: module header, function signature, exports, and code.
class WasmBackend: ArtifactBackend:
    init():
        return

    func emit(program: CanonicalProgram) -> list[u8]!:
        let output = list[u8]()
        append_all(output, [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00])

        let types = list[u8]()
        append_all(types, [0x01, 0x60, 0x00, 0x01, 0x7E])
        append_section(output, 0x01, types)

        let functions = list[u8]()
        append_unsigned(functions, len(program.functions))
        for function in program.functions:
            append_unsigned(functions, 0)
        append_section(output, 0x03, functions)

        let exports = list[u8]()
        var export_count = 0
        for function in program.functions:
            if function.is_public: export_count += 1
        append_unsigned(exports, export_count)

        var function_index = 0
        for function in program.functions:
            if function.is_public:
                let name = strings.to_bytes(function.name)
                append_unsigned(exports, len(name))
                append_all(exports, name)
                exports.append(0x00)
                append_unsigned(exports, function_index)
            function_index += 1
        if export_count > 0:
            append_section(output, 0x07, exports)

        let code = list[u8]()
        append_unsigned(code, len(program.functions))
        for function in program.functions:
            let body = list[u8]()
            body.append(0x00)
            for instruction in function.instructions:
                match instruction:
                    I64Constant(value):
                        body.append(0x42)
                        append_signed(body, value)
                    I64Add: body.append(0x7C)
                    I64Subtract: body.append(0x7D)
                    I64Multiply: body.append(0x7E)
                    Return: body.append(0x0F)
            body.append(0x0B)
            append_unsigned(code, len(body))
            append_all(code, body)
        append_section(output, 0x0A, code)
        return output

private func append_section(output: list[u8], section_id: u8, payload: list[u8]):
    output.append(section_id)
    append_unsigned(output, len(payload))
    append_all(output, payload)

private func append_unsigned(output: list[u8], number: i64):
    var value = number
    while value >= 0x80:
        output.append(u8(value & 0x7F | 0x80))
        value = value >> 7
    output.append(u8(value))

private func append_signed(output: list[u8], number: i64):
    var value = number
    while true:
        var byte = value & 0x7F
        value = value >> 7
        let finished = (value == 0 and byte & 0x40 == 0) or (value == -1 and byte & 0x40 != 0)
        if not finished: byte = byte | 0x80
        output.append(u8(byte))
        if finished: return

private func append_all(output: list[u8], values: list[u8]):
    for value in values:
        output.append(value)
