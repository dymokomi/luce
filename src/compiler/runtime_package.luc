#==============================================================================================
#
#   runtime_package - Describe the sealed runtime presented to the compiler
#
#   DESCRIPTION:
#       The runtime is ordinary privileged Luce source, but the semantic
#       services it provides are a closed compiler contract. This module is
#       the single place that maps those services to source-level identities.
#
#       Resource discovery deliberately remains a caller concern. Installed
#       tools, tests, and embedders may keep the runtime sources in different
#       locations, while every caller receives the same package identity and
#       binding manifest.
#
#==============================================================================================

from compiler.pipeline import RuntimeBindingInput, RuntimePackageInput
from compiler.runtime_contract import RuntimeService

# mark: Descriptor =============================================================================

## Construct the one sealed-runtime package descriptor from an explicitly
## located set of source files. Service names resolve to private HIR symbols
## during runtime compilation and become exact MIR function identities.
pub func sealed_runtime_package(source_paths: list[str]) -> RuntimePackageInput:
    return RuntimePackageInput(
        identity = "org.luce.runtime",
        source_paths = source_paths,
        bindings = [
            RuntimeBindingInput(service = RuntimeService.storage_allocator, module_name = "allocator", function_name = "allocate_storage"),
            RuntimeBindingInput(service = RuntimeService.storage_deallocator, module_name = "allocator", function_name = "deallocate_storage"),
            RuntimeBindingInput(service = RuntimeService.equality_context_create, module_name = "allocator", function_name = "equality_context_create"),
            RuntimeBindingInput(service = RuntimeService.equality_context_release, module_name = "allocator", function_name = "equality_context_release"),
            RuntimeBindingInput(service = RuntimeService.equality_context_visit, module_name = "allocator", function_name = "equality_context_visit"),
            RuntimeBindingInput(service = RuntimeService.hash_create, module_name = "allocator", function_name = "hash_create"),
            RuntimeBindingInput(service = RuntimeService.hash_retain, module_name = "allocator", function_name = "hash_retain"),
            RuntimeBindingInput(service = RuntimeService.hash_release, module_name = "allocator", function_name = "hash_release"),
            RuntimeBindingInput(service = RuntimeService.hash_copy, module_name = "allocator", function_name = "hash_copy"),
            RuntimeBindingInput(service = RuntimeService.hash_length, module_name = "allocator", function_name = "hash_length"),
            RuntimeBindingInput(service = RuntimeService.hash_iteration_begin, module_name = "allocator", function_name = "hash_iteration_begin"),
            RuntimeBindingInput(service = RuntimeService.hash_iteration_end, module_name = "allocator", function_name = "hash_iteration_end"),
            RuntimeBindingInput(service = RuntimeService.hash_find_first, module_name = "allocator", function_name = "hash_find_first"),
            RuntimeBindingInput(service = RuntimeService.hash_find_next, module_name = "allocator", function_name = "hash_find_next"),
            RuntimeBindingInput(service = RuntimeService.hash_key_address, module_name = "allocator", function_name = "hash_key_address"),
            RuntimeBindingInput(service = RuntimeService.hash_value_address, module_name = "allocator", function_name = "hash_value_address"),
            RuntimeBindingInput(service = RuntimeService.hash_insert_entry, module_name = "allocator", function_name = "hash_insert_entry"),
            RuntimeBindingInput(service = RuntimeService.hash_remove_entry, module_name = "allocator", function_name = "hash_remove_entry"),
            RuntimeBindingInput(service = RuntimeService.hash_clear, module_name = "allocator", function_name = "hash_clear"),
            RuntimeBindingInput(service = RuntimeService.hash_reserve, module_name = "allocator", function_name = "hash_reserve"),
            RuntimeBindingInput(service = RuntimeService.list_create, module_name = "allocator", function_name = "list_create"),
            RuntimeBindingInput(service = RuntimeService.list_retain, module_name = "allocator", function_name = "list_retain"),
            RuntimeBindingInput(service = RuntimeService.list_release, module_name = "allocator", function_name = "list_release"),
            RuntimeBindingInput(service = RuntimeService.list_copy, module_name = "allocator", function_name = "list_copy"),
            RuntimeBindingInput(service = RuntimeService.list_concat, module_name = "allocator", function_name = "list_concat"),
            RuntimeBindingInput(service = RuntimeService.list_length, module_name = "allocator", function_name = "list_length"),
            RuntimeBindingInput(service = RuntimeService.list_iteration_begin, module_name = "allocator", function_name = "list_iteration_begin"),
            RuntimeBindingInput(service = RuntimeService.list_iteration_end, module_name = "allocator", function_name = "list_iteration_end"),
            RuntimeBindingInput(service = RuntimeService.list_mutable_slice_begin, module_name = "allocator", function_name = "list_mutable_slice_begin"),
            RuntimeBindingInput(service = RuntimeService.list_iteration_active, module_name = "allocator", function_name = "list_iteration_active"),
            RuntimeBindingInput(service = RuntimeService.list_append_slot, module_name = "allocator", function_name = "list_append_slot"),
            RuntimeBindingInput(service = RuntimeService.list_insert_slot, module_name = "allocator", function_name = "list_insert_slot"),
            RuntimeBindingInput(service = RuntimeService.list_remove_at, module_name = "allocator", function_name = "list_remove_at"),
            RuntimeBindingInput(service = RuntimeService.list_clear, module_name = "allocator", function_name = "list_clear"),
            RuntimeBindingInput(service = RuntimeService.list_reserve, module_name = "allocator", function_name = "list_reserve"),
            RuntimeBindingInput(service = RuntimeService.list_element_address, module_name = "allocator", function_name = "list_element_address"),
            RuntimeBindingInput(service = RuntimeService.list_mutable_element_address, module_name = "allocator", function_name = "list_mutable_element_address"),
            RuntimeBindingInput(service = RuntimeService.list_slice, module_name = "allocator", function_name = "list_slice"),
            RuntimeBindingInput(service = RuntimeService.buffer_retain, module_name = "allocator", function_name = "buffer_retain"),
            RuntimeBindingInput(service = RuntimeService.buffer_release, module_name = "allocator", function_name = "buffer_release"),
            RuntimeBindingInput(service = RuntimeService.buffer_concat, module_name = "allocator", function_name = "buffer_concat"),
            RuntimeBindingInput(service = RuntimeService.buffer_data, module_name = "allocator", function_name = "buffer_data"),
            RuntimeBindingInput(service = RuntimeService.buffer_length, module_name = "allocator", function_name = "buffer_length"),
            RuntimeBindingInput(service = RuntimeService.buffer_builder_create, module_name = "allocator", function_name = "buffer_builder_create"),
            RuntimeBindingInput(service = RuntimeService.buffer_builder_append, module_name = "allocator", function_name = "buffer_builder_append"),
            RuntimeBindingInput(service = RuntimeService.buffer_builder_finish, module_name = "allocator", function_name = "buffer_builder_finish"),
            RuntimeBindingInput(service = RuntimeService.c_string_copy, module_name = "allocator", function_name = "c_string_copy"),
            RuntimeBindingInput(service = RuntimeService.display_signed, module_name = "allocator", function_name = "display_signed"),
            RuntimeBindingInput(service = RuntimeService.display_unsigned, module_name = "allocator", function_name = "display_unsigned"),
            RuntimeBindingInput(service = RuntimeService.display_float32, module_name = "allocator", function_name = "display_float32"),
            RuntimeBindingInput(service = RuntimeService.display_float64, module_name = "allocator", function_name = "display_float64"),
            RuntimeBindingInput(service = RuntimeService.display_character, module_name = "allocator", function_name = "display_character"),
            RuntimeBindingInput(service = RuntimeService.display_boolean, module_name = "allocator", function_name = "display_boolean"),
            RuntimeBindingInput(service = RuntimeService.string_scalar_count, module_name = "allocator", function_name = "string_scalar_count"),
            RuntimeBindingInput(service = RuntimeService.string_decode, module_name = "allocator", function_name = "string_decode"),
            RuntimeBindingInput(service = RuntimeService.bytes_slice, module_name = "allocator", function_name = "bytes_slice"),
            RuntimeBindingInput(service = RuntimeService.slice_retain, module_name = "allocator", function_name = "slice_retain"),
            RuntimeBindingInput(service = RuntimeService.slice_release, module_name = "allocator", function_name = "slice_release"),
            RuntimeBindingInput(service = RuntimeService.slice_length, module_name = "allocator", function_name = "slice_length"),
            RuntimeBindingInput(service = RuntimeService.slice_element_address, module_name = "allocator", function_name = "slice_element_address"),
            RuntimeBindingInput(service = RuntimeService.class_create, module_name = "allocator", function_name = "class_create"),
            RuntimeBindingInput(service = RuntimeService.class_mark_initialized, module_name = "allocator", function_name = "class_mark_initialized"),
            RuntimeBindingInput(service = RuntimeService.class_retain, module_name = "allocator", function_name = "class_retain"),
            RuntimeBindingInput(service = RuntimeService.class_release, module_name = "allocator", function_name = "class_release"),
            RuntimeBindingInput(service = RuntimeService.class_payload, module_name = "allocator", function_name = "class_payload"),
            RuntimeBindingInput(service = RuntimeService.weak_class_create, module_name = "allocator", function_name = "weak_class_create"),
            RuntimeBindingInput(service = RuntimeService.weak_class_retain, module_name = "allocator", function_name = "weak_class_retain"),
            RuntimeBindingInput(service = RuntimeService.weak_class_release, module_name = "allocator", function_name = "weak_class_release"),
            RuntimeBindingInput(service = RuntimeService.weak_class_promote, module_name = "allocator", function_name = "weak_class_promote"),
            RuntimeBindingInput(service = RuntimeService.interface_create, module_name = "allocator", function_name = "interface_create"),
            RuntimeBindingInput(service = RuntimeService.interface_retain, module_name = "allocator", function_name = "interface_retain"),
            RuntimeBindingInput(service = RuntimeService.interface_release, module_name = "allocator", function_name = "interface_release"),
            RuntimeBindingInput(service = RuntimeService.interface_detach, module_name = "allocator", function_name = "interface_detach"),
            RuntimeBindingInput(service = RuntimeService.interface_payload, module_name = "allocator", function_name = "interface_payload"),
            RuntimeBindingInput(service = RuntimeService.interface_witness, module_name = "allocator", function_name = "interface_witness"),
        ],
    )
