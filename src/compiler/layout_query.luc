#==============================================================================================
#
#   layout_query - The three layout questions a program may ask of a type
#
#   DESCRIPTION:
#       `sizeof(T)`, `alignof(T)`, and `offsetof(T, field)` are constants of
#       type `usize` in Luce Base (docs/language/base.md §5.11). Neither HIR
#       nor canonical MIR knows the answer: the target's C layout is a backend
#       fact, so both representations carry the question and each backend
#       folds the answer from its own layout rules (base.md §5.1, §19.2).
#
#       HIR and MIR share this one vocabulary so the question is spelled once.
#
#==============================================================================================

## Which fact about a type's layout is asked for.
pub enum LayoutQuery:
    size
    align
    offset

## The source spelling of a layout question, for diagnostics.
pub func layout_query_name(value: LayoutQuery) -> str:
    return match value:
        size => "sizeof"
        align => "alignof"
        offset => "offsetof"
