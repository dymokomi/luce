#==============================================================================================
#
#   package_import_model - One semantic-identity plan for typed HIR import
#
#   DESCRIPTION:
#       Computes every package-local identity translation before any imported
#       declaration or body is published. Canonical structural types are
#       interned into the destination table; nominal and package identities
#       remain distinct. This is semantic graph composition, not a backend or
#       object-linking model.
#
#==============================================================================================

from compiler.hir.ir import HirProgram, StandardInterface, TypeDefinition, TypeForm, TypeId, TypeTable
from compiler.hir.ir import create_builtin_type_table, type_forms_match

pub struct HirImportMap:
    pub let package_offset: i64
    pub let module_offset: i64
    pub let symbol_offset: i64
    pub let struct_offset: i64
    pub let class_offset: i64
    pub let enum_offset: i64
    pub let extern_type_offset: i64
    pub let extern_variable_offset: i64
    pub let global_offset: i64
    pub let closure_offset: i64
    pub let generic_offset: i64
    pub let generic_instance_offset: i64
    pub let conformance_offset: i64
    pub let interface_map: list[u32]
    ## True when this source interface owns a new destination declaration;
    ## false only when a compiler-known standard interface was canonicalized.
    pub let imports_interface: list[bool]
    pub let generic_sources: list[u32]
    pub let generic_destinations: list[u32]
    pub let type_map: list[TypeId]
    pub let imports_type: list[bool]
    pub let types: TypeTable

# mark: Complete remap plan ====================================================================

pub func build_hir_import_map(destination: HirProgram, source: HirProgram) -> HirImportMap!:
    let interface_map = list[u32]()
    let imports_interface = list[bool]()
    var next_interface = len(destination.interfaces)
    for value in source.interfaces:
        var existing = -1
        match value.origin:
            Source(module): pass
            Standard(identity): existing = find_standard_interface(destination, identity)
        if existing >= 0:
            interface_map.append(u32(existing))
            imports_interface.append(false)
        else:
            interface_map.append(u32(next_interface))
            imports_interface.append(true)
            next_interface += 1

    let generic_sources = list[u32]()
    let generic_destinations = list[u32]()
    var next_generic = next_generic_identity(destination)
    for index in range(0, len(source.interfaces)):
        if imports_interface[index]: continue
        let value = source.interfaces[index]
        if len(value.type_parameters) == 0: continue
        let existing = destination.interfaces[interface_map[index]]
        register_generic_identity(
            generic_sources, generic_destinations,
            value.generic_id, existing.generic_id,
        )
    for definition in source.types.definitions:
        match definition.form:
            TypeParameter(generic, position):
                if find_generic_identity(generic_sources, generic) < 0:
                    register_generic_identity(
                        generic_sources, generic_destinations,
                        generic, u32(next_generic),
                    )
                    next_generic += 1
            else: pass

    let partial = HirImportMap(
        package_offset = len(destination.packages),
        module_offset = len(destination.modules),
        symbol_offset = len(destination.symbols),
        struct_offset = len(destination.structs),
        class_offset = len(destination.classes),
        enum_offset = len(destination.enums),
        extern_type_offset = len(destination.extern_types),
        extern_variable_offset = len(destination.extern_variables),
        global_offset = len(destination.globals),
        closure_offset = len(destination.closures),
        generic_offset = len(destination.generic_functions),
        generic_instance_offset = len(destination.generic_instances),
        conformance_offset = len(destination.conformances),
        interface_map = interface_map,
        imports_interface = imports_interface,
        generic_sources = generic_sources,
        generic_destinations = generic_destinations,
        type_map = list[TypeId](),
        imports_type = list[bool](),
        types = destination.types,
    )
    let composed = try compose_types(destination.types, source.types, partial)
    return HirImportMap(
        package_offset = partial.package_offset,
        module_offset = partial.module_offset,
        symbol_offset = partial.symbol_offset,
        struct_offset = partial.struct_offset,
        class_offset = partial.class_offset,
        enum_offset = partial.enum_offset,
        extern_type_offset = partial.extern_type_offset,
        extern_variable_offset = partial.extern_variable_offset,
        global_offset = partial.global_offset,
        closure_offset = partial.closure_offset,
        generic_offset = partial.generic_offset,
        generic_instance_offset = partial.generic_instance_offset,
        conformance_offset = partial.conformance_offset,
        interface_map = partial.interface_map,
        imports_interface = partial.imports_interface,
        generic_sources = partial.generic_sources,
        generic_destinations = partial.generic_destinations,
        type_map = composed.type_map,
        imports_type = composed.imports_type,
        types = composed.types,
    )

struct ComposedTypes:
    let type_map: list[TypeId]
    let imports_type: list[bool]
    let types: TypeTable

func compose_types(destination: TypeTable, source: TypeTable, remap: HirImportMap) -> ComposedTypes!:
    let definitions = list[TypeDefinition]()
    for value in destination.definitions: definitions.append(value)
    let type_map = list[TypeId]()
    let imports_type = list[bool]()
    let builtin_count = len(create_builtin_type_table().definitions)
    for index in range(0, len(source.definitions)):
        if index < builtin_count:
            type_map.append(TypeId(value = u32(index)))
            imports_type.append(false)
            continue
        let form = try remap_type_form(source.definitions[index].form, remap, type_map)
        var existing = -1
        for candidate in definitions:
            if type_forms_match(candidate.form, form):
                existing = i64(candidate.id.value)
                break
        if existing >= 0:
            type_map.append(TypeId(value = u32(existing)))
            imports_type.append(false)
        else:
            let identity = TypeId(value = u32(len(definitions)))
            definitions.append(TypeDefinition(
                id = identity,
                name = source.definitions[index].name,
                form = form,
            ))
            type_map.append(identity)
            imports_type.append(true)
    return ComposedTypes(
        type_map = type_map,
        imports_type = imports_type,
        types = TypeTable(definitions = definitions),
    )

# mark: Identity accessors =====================================================================

pub func import_package_id(remap: HirImportMap, value: u32) -> u32:
    return u32(remap.package_offset) + value

pub func import_module_id(remap: HirImportMap, value: u32) -> u32:
    return u32(remap.module_offset) + value

pub func import_symbol_id(remap: HirImportMap, value: u32) -> u32:
    return u32(remap.symbol_offset) + value

pub func import_type_id(remap: HirImportMap, value: TypeId) -> TypeId:
    return remap.type_map[value.value]

pub func import_generic_id(remap: HirImportMap, value: u32) -> u32:
    let index = find_generic_identity(remap.generic_sources, value)
    if index < 0: trap("typed package import: generic identity has no remap")
    return remap.generic_destinations[index]

pub func import_interface_index(remap: HirImportMap, value: i64) -> i64:
    return i64(remap.interface_map[value])

# mark: Type graph =============================================================================

func remap_type_form(form: TypeForm, remap: HirImportMap, type_map: list[TypeId]) -> TypeForm!:
    match form:
        Unit: return TypeForm.Unit
        Boolean: return TypeForm.Boolean
        Never: return TypeForm.Never
        Integer(bits, is_signed): return TypeForm.Integer(bits = bits, is_signed = is_signed)
        Floating(bits): return TypeForm.Floating(bits = bits)
        Character: return TypeForm.Character
        String: return TypeForm.String
        Bytes: return TypeForm.Bytes
        ErrorCode: return TypeForm.ErrorCode
        Error: return TypeForm.Error
        Slice(element): return TypeForm.Slice(element = try mapped_type(type_map, element))
        MutableSlice(element): return TypeForm.MutableSlice(element = try mapped_type(type_map, element))
        List(element): return TypeForm.List(element = try mapped_type(type_map, element))
        Map(key, value): return TypeForm.Map(key = try mapped_type(type_map, key), value = try mapped_type(type_map, value))
        Set(element): return TypeForm.Set(element = try mapped_type(type_map, element))
        Weak(value): return TypeForm.Weak(value = try mapped_type(type_map, value))
        Range(element): return TypeForm.Range(element = try mapped_type(type_map, element))
        Array(element, count): return TypeForm.Array(element = try mapped_type(type_map, element), count = count)
        Optional(value): return TypeForm.Optional(value = try mapped_type(type_map, value))
        Fallible(value): return TypeForm.Fallible(value = try mapped_type(type_map, value))
        Tuple(elements): return TypeForm.Tuple(elements = try mapped_types(type_map, elements))
        Function(parameters, result):
            return TypeForm.Function(parameters = try mapped_types(type_map, parameters), result = try mapped_type(type_map, result))
        CFunction(parameters, result):
            return TypeForm.CFunction(parameters = try mapped_types(type_map, parameters), result = try mapped_type(type_map, result))
        Foreign: return TypeForm.Foreign
        NativePointer(pointee, is_mutable):
            return TypeForm.NativePointer(pointee = try mapped_type(type_map, pointee), is_mutable = is_mutable)
        TypeParameter(generic, position):
            return TypeForm.TypeParameter(generic = import_generic_id(remap, generic), position = position)
        Interface(index, arguments):
            return TypeForm.Interface(index = import_interface_index(remap, index), arguments = try mapped_types(type_map, arguments))
        Struct(index, arguments):
            return TypeForm.Struct(index = remap.struct_offset + index, arguments = try mapped_types(type_map, arguments))
        Class(index, arguments):
            return TypeForm.Class(index = remap.class_offset + index, arguments = try mapped_types(type_map, arguments))
        Enum(index, arguments):
            return TypeForm.Enum(index = remap.enum_offset + index, arguments = try mapped_types(type_map, arguments))
        Extern(index): return TypeForm.Extern(index = remap.extern_type_offset + index)

func mapped_type(type_map: list[TypeId], value: TypeId) -> TypeId!:
    if i64(value.value) >= len(type_map):
        error("typed package import: dependency type graph is not in canonical dependency order")
    return type_map[value.value]

func mapped_types(type_map: list[TypeId], values: list[TypeId]) -> list[TypeId]!:
    let mapped = list[TypeId]()
    for value in values: mapped.append(try mapped_type(type_map, value))
    return mapped

# mark: Generic and standard identities ========================================================

func next_generic_identity(program: HirProgram) -> i64:
    var next = 0
    for definition in program.types.definitions:
        match definition.form:
            TypeParameter(generic, position):
                if i64(generic) >= next: next = i64(generic) + 1
            else: pass
    return next

func register_generic_identity(sources: list[u32], destinations: list[u32], source: u32, destination: u32):
    let existing = find_generic_identity(sources, source)
    if existing >= 0:
        if destinations[existing] != destination:
            trap("typed package import: generic identity remap is inconsistent")
        return
    sources.append(source)
    destinations.append(destination)

func find_generic_identity(values: list[u32], value: u32) -> i64:
    for index in range(0, len(values)):
        if values[index] == value: return index
    return -1

func find_standard_interface(program: HirProgram, identity: StandardInterface) -> i64:
    for index in range(0, len(program.interfaces)):
        match program.interfaces[index].origin:
            Source(module): pass
            Standard(candidate):
                if candidate == identity: return index
    return -1
