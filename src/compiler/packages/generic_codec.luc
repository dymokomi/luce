#==============================================================================================
#
#   package_generic_codec - Checked generic declarations and retained bodies
#
#   DESCRIPTION:
#       Owns the canonical declaration-level wire shape for generic callables.
#       Signatures reuse the shared signature codec; implementations reuse the
#       isolated HIR body codec. Import remapping is a later transaction over
#       these decoded semantic identities, never a second decoding path.
#
#==============================================================================================

from compiler.hir.ir import HirGenericFunction
from compiler.packages.body_codec import read_generic_body, write_generic_body
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_documentation, read_module_id, read_span, read_symbol_id
from compiler.packages.hir_fields import read_type_id, write_documentation, write_module_id, write_span
from compiler.packages.hir_fields import write_symbol_id, write_type_id
from compiler.packages.generic_validation import HirGenericValidationContext, validate_generic_functions
from compiler.packages.signature_codec import read_optional_receiver, read_parameters, read_type_parameters
from compiler.packages.signature_codec import write_optional_receiver, write_parameters, write_type_parameters

# mark: Public codec ===========================================================================

pub func write_generic_functions(writer: PackageWriter, values: list[HirGenericFunction], context: HirGenericValidationContext) -> !:
    try validate_generic_functions(values, context)
    try writer.write_count(len(values))
    for value in values: try write_generic_function(writer, value)

pub func read_generic_functions(reader: PackageReader, context: HirGenericValidationContext) -> list[HirGenericFunction]!:
    let values = list[HirGenericFunction]()
    let count = try reader.read_count()
    for index in range(0, count): values.append(try read_generic_function(reader))
    try validate_generic_functions(values, context)
    return values

# mark: Declaration records ====================================================================

func write_generic_function(writer: PackageWriter, value: HirGenericFunction) -> !:
    write_symbol_id(writer, value.symbol)
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    write_optional_receiver(writer, value.receiver)
    writer.write_u32(value.generic_id)
    writer.write_i64(value.owner_parameter_count)
    try write_type_parameters(writer, value.type_parameters)
    try write_parameters(writer, value.parameters)
    write_type_id(writer, value.result)
    try write_generic_body(writer, value.body)
    write_span(writer, value.span)

func read_generic_function(reader: PackageReader) -> HirGenericFunction!:
    return HirGenericFunction(
        symbol = try read_symbol_id(reader),
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        receiver = try read_optional_receiver(reader),
        generic_id = try reader.read_u32(),
        owner_parameter_count = try reader.read_i64(),
        type_parameters = try read_type_parameters(reader),
        parameters = try read_parameters(reader),
        result = try read_type_id(reader),
        body = try read_generic_body(reader),
        span = try read_span(reader),
    )
