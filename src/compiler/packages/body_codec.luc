#==============================================================================================
#
#   package_body_codec - Retained generic HIR body storage
#
#   DESCRIPTION:
#       Serializes one isolated `HirBodyArena` together with the local symbols,
#       closures, shared cells, and generated closure functions that make the
#       graph self-contained. This is the ordinary HIR representation with a
#       local node namespace, not a second IR and not executable backend data.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.ir import HirBodyArena, HirCapture, HirCaptureKind, HirClosure
from compiler.hir.ir import HirFunction, HirFunctionImplementation, HirGenericBody
from compiler.hir.ir import HirNode, ModuleId, NodeId, SymbolId, TypeId, Value
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_documentation, read_module_id, read_node_id
from compiler.packages.hir_fields import read_operands, read_optional_symbol_id, read_span, read_symbol_id
from compiler.packages.hir_fields import read_type_id, write_documentation, write_module_id, write_node_id
from compiler.packages.hir_fields import write_operands, write_optional_symbol_id, write_span, write_symbol_id
from compiler.packages.hir_fields import write_type_id
from compiler.packages.literal_codec import read_literal, write_literal
from compiler.packages.node_codec import read_hir_node, write_hir_node
from compiler.packages.signature_codec import read_optional_receiver, read_parameters
from compiler.packages.signature_codec import write_optional_receiver, write_parameters

# mark: Public codec ===========================================================================

pub func write_generic_body(writer: PackageWriter, value: HirGenericBody) -> !:
    try write_arena(writer, value.arena)
    write_operands(writer, value.body)
    try writer.write_count(len(value.defaults))
    for item in value.defaults: write_node_id(writer, item)
    try writer.write_count(len(value.local_symbols))
    for item in value.local_symbols: write_symbol_id(writer, item)
    try writer.write_count(len(value.closures))
    for item in value.closures: try write_closure(writer, item)
    try writer.write_count(len(value.shared_cells))
    for item in value.shared_cells: write_symbol_id(writer, item)
    try writer.write_count(len(value.generated_functions))
    for item in value.generated_functions: try write_generated_function(writer, item)

pub func read_generic_body(reader: PackageReader) -> HirGenericBody!:
    let arena = try read_arena(reader)
    let body = try read_operands(reader)
    let defaults = list[NodeId]()
    let default_count = try reader.read_count()
    for index in range(0, default_count): defaults.append(try read_node_id(reader))
    let local_symbols = list[SymbolId]()
    let local_count = try reader.read_count()
    for index in range(0, local_count): local_symbols.append(try read_symbol_id(reader))
    let closures = list[HirClosure]()
    let closure_count = try reader.read_count()
    for index in range(0, closure_count): closures.append(try read_closure(reader))
    let shared_cells = list[SymbolId]()
    let shared_count = try reader.read_count()
    for index in range(0, shared_count): shared_cells.append(try read_symbol_id(reader))
    let generated_functions = list[HirFunction]()
    let function_count = try reader.read_count()
    for index in range(0, function_count): generated_functions.append(try read_generated_function(reader))
    return HirGenericBody(
        arena = arena,
        body = body,
        defaults = defaults,
        local_symbols = local_symbols,
        closures = closures,
        shared_cells = shared_cells,
        generated_functions = generated_functions,
    )

# mark: Flat arena =============================================================================

func write_arena(writer: PackageWriter, arena: HirBodyArena) -> !:
    if len(arena.nodes) != len(arena.node_types) or len(arena.nodes) != len(arena.node_modules) or len(arena.nodes) != len(arena.node_spans):
        error("typed package artifact: retained HIR arena parallel tables have different lengths")
    try writer.write_count(len(arena.nodes))
    for index in range(0, len(arena.nodes)):
        try write_hir_node(writer, arena.nodes[index])
        write_type_id(writer, arena.node_types[index])
        write_module_id(writer, arena.node_modules[index])
        write_span(writer, arena.node_spans[index])
    try writer.write_count(len(arena.extra))
    for item in arena.extra: writer.write_u32(item)
    try writer.write_count(len(arena.values))
    for item in arena.values: try write_literal(writer, item)

func read_arena(reader: PackageReader) -> HirBodyArena!:
    let nodes = list[HirNode]()
    let node_types = list[TypeId]()
    let node_modules = list[ModuleId]()
    let node_spans = list[SourceSpan]()
    let node_count = try reader.read_count()
    for index in range(0, node_count):
        nodes.append(try read_hir_node(reader))
        node_types.append(try read_type_id(reader))
        node_modules.append(try read_module_id(reader))
        node_spans.append(try read_span(reader))
    let extra = list[u32]()
    let extra_count = try reader.read_count()
    for index in range(0, extra_count): extra.append(try reader.read_u32())
    let values = list[Value]()
    let value_count = try reader.read_count()
    for index in range(0, value_count): values.append(try read_literal(reader))
    return HirBodyArena(
        nodes = nodes,
        node_types = node_types,
        node_modules = node_modules,
        node_spans = node_spans,
        extra = extra,
        values = values,
    )

# mark: Closure metadata =======================================================================

func write_closure(writer: PackageWriter, value: HirClosure) -> !:
    write_symbol_id(writer, value.function)
    try writer.write_count(len(value.captures))
    for capture in value.captures:
        write_symbol_id(writer, capture.symbol)
        write_optional_symbol_id(writer, capture.source)
        write_type_id(writer, capture.value_type)
        write_capture_kind(writer, capture.kind)
        write_span(writer, capture.span)
    write_span(writer, value.span)

func read_closure(reader: PackageReader) -> HirClosure!:
    let function = try read_symbol_id(reader)
    let captures = list[HirCapture]()
    let capture_count = try reader.read_count()
    for index in range(0, capture_count):
        captures.append(HirCapture(
            symbol = try read_symbol_id(reader),
            source = try read_optional_symbol_id(reader),
            value_type = try read_type_id(reader),
            kind = try read_capture_kind(reader),
            span = try read_span(reader),
        ))
    return HirClosure(function = function, captures = captures, span = try read_span(reader))

func write_capture_kind(writer: PackageWriter, value: HirCaptureKind):
    match value:
        value: writer.write_u8(0)
        shared_cell: writer.write_u8(1)
        weak_capture: writer.write_u8(2)

func read_capture_kind(reader: PackageReader) -> HirCaptureKind!:
    let tag = try reader.read_u8()
    if tag == 0: return HirCaptureKind.value
    if tag == 1: return HirCaptureKind.shared_cell
    if tag == 2: return HirCaptureKind.weak_capture
    error("typed package artifact: unknown retained HIR capture kind tag " + str(u64(tag)))

# mark: Generated closure functions =============================================================

func write_generated_function(writer: PackageWriter, value: HirFunction) -> !:
    write_symbol_id(writer, value.symbol)
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    write_optional_receiver(writer, value.receiver)
    write_optional_u32(writer, value.closure)
    try write_parameters(writer, value.parameters)
    write_type_id(writer, value.result)
    match value.implementation:
        Defined(body):
            writer.write_u8(0)
            write_operands(writer, body)
        ExportedC(body): error("typed package artifact: retained generated function cannot be exported to C")
        ExternalC(contract): error("typed package artifact: retained generated function cannot be external C")
    write_span(writer, value.span)

func read_generated_function(reader: PackageReader) -> HirFunction!:
    let symbol = try read_symbol_id(reader)
    let module = try read_module_id(reader)
    let name = try reader.read_text()
    let is_public = try reader.read_bool()
    let documentation = try read_documentation(reader)
    let receiver = try read_optional_receiver(reader)
    let closure = try read_optional_u32(reader)
    let parameters = try read_parameters(reader)
    let result = try read_type_id(reader)
    let implementation_tag = try reader.read_u8()
    if implementation_tag != 0:
        error("typed package artifact: unknown retained generated-function implementation tag " + str(u64(implementation_tag)))
    let implementation = HirFunctionImplementation.Defined(body = try read_operands(reader))
    return HirFunction(
        symbol = symbol,
        module = module,
        name = name,
        is_public = is_public,
        documentation = documentation,
        receiver = receiver,
        closure = closure,
        parameters = parameters,
        result = result,
        implementation = implementation,
        span = try read_span(reader),
    )

func write_optional_u32(writer: PackageWriter, value: u32?):
    if value == none:
        writer.write_bool(false)
    else:
        writer.write_bool(true)
        writer.write_u32(value)

func read_optional_u32(reader: PackageReader) -> u32?!:
    if not try reader.read_bool(): return none
    return try reader.read_u32()
