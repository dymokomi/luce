#==============================================================================================
#
#   package_signature_codec - Shared typed declaration signatures
#
#   DESCRIPTION:
#       Owns the one wire spelling for generic type parameters, callable value
#       parameters, and nominal receiver protocols. Nominal, interface, and
#       function sections reuse these exact records instead of maintaining
#       parallel encoders or validators.
#
#==============================================================================================

from compiler.hir.ir import HirParameter, HirReceiver, HirReceiverKind, HirTypeParameter
from compiler.hir.ir import TypeForm, TypeTable
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_node_id, read_symbol_id, read_type_id, read_type_ids
from compiler.packages.hir_fields import validate_optional_node_id, validate_symbol_id, validate_type_id
from compiler.packages.hir_fields import write_node_id, write_symbol_id, write_type_id, write_type_ids

# mark: Generic type parameters ================================================================

pub func write_type_parameters(writer: PackageWriter, values: list[HirTypeParameter]) -> !:
    try writer.write_count(len(values))
    for value in values:
        try writer.write_text(value.name)
        write_type_id(writer, value.value_type)
        try write_type_ids(writer, value.constraints)

pub func read_type_parameters(reader: PackageReader) -> list[HirTypeParameter]!:
    let count = try reader.read_count()
    let values = list[HirTypeParameter]()
    for index in range(0, count):
        values.append(HirTypeParameter(
            name = try reader.read_text(),
            value_type = try read_type_id(reader),
            constraints = try read_type_ids(reader),
        ))
    return values

pub func validate_type_parameters(
    values: list[HirTypeParameter],
    generic_id: u32,
    types: TypeTable,
) -> !:
    for index in range(0, len(values)):
        let value = values[index]
        if len(value.name) == 0:
            error("typed package artifact: generic type parameter name must not be empty")
        for previous in range(0, index):
            if values[previous].name == value.name:
                error("typed package artifact: duplicate generic type parameter `" + value.name + "`")
        try validate_type_id(value.value_type, len(types.definitions))
        match types.definitions[value.value_type.value].form:
            TypeParameter(owner, position):
                if owner != generic_id or position != u32(index):
                    error("typed package artifact: generic type parameter identity does not match its declaration")
            else: error("typed package artifact: generic parameter does not reference a TypeParameter")
        for constraint in value.constraints:
            try validate_type_id(constraint, len(types.definitions))
            match types.definitions[constraint.value].form:
                Interface(declaration, arguments): pass
                else: error("typed package artifact: generic constraint is not an interface type")

# mark: Value parameters =======================================================================

pub func write_parameters(writer: PackageWriter, values: list[HirParameter]) -> !:
    try writer.write_count(len(values))
    for value in values:
        write_symbol_id(writer, value.symbol)
        try writer.write_text(value.name)
        write_type_id(writer, value.value_type)
        write_node_id(writer, value.default_value)

pub func read_parameters(reader: PackageReader) -> list[HirParameter]!:
    let count = try reader.read_count()
    let values = list[HirParameter]()
    for index in range(0, count):
        values.append(HirParameter(
            symbol = try read_symbol_id(reader),
            name = try reader.read_text(),
            value_type = try read_type_id(reader),
            default_value = try read_node_id(reader),
        ))
    return values

pub func validate_parameters(
    values: list[HirParameter],
    types: TypeTable,
    symbol_count: i64,
    node_count: i64,
) -> !:
    for index in range(0, len(values)):
        let value = values[index]
        try validate_symbol_id(value.symbol, symbol_count)
        if len(value.name) == 0:
            error("typed package artifact: callable parameter name must not be empty")
        for previous in range(0, index):
            if values[previous].name == value.name:
                error("typed package artifact: duplicate callable parameter `" + value.name + "`")
        try validate_type_id(value.value_type, len(types.definitions))
        try validate_optional_node_id(value.default_value, node_count)

# mark: Receiver protocol ======================================================================

pub func write_optional_receiver(writer: PackageWriter, value: HirReceiver?):
    if value == none:
        writer.write_bool(false)
        return
    writer.write_bool(true)
    write_type_id(writer, value.owner)
    write_receiver_kind(writer, value.kind)

pub func read_optional_receiver(reader: PackageReader) -> HirReceiver?!:
    if not try reader.read_bool(): return none
    return HirReceiver(
        owner = try read_type_id(reader),
        kind = try read_receiver_kind(reader),
    )

pub func validate_optional_receiver(value: HirReceiver?, types: TypeTable) -> !:
    if value == none: return
    try validate_type_id(value.owner, len(types.definitions))
    match types.definitions[value.owner.value].form:
        Struct(declaration, arguments): pass
        Class(declaration, arguments): pass
        Enum(declaration, arguments): pass
        else: error("typed package artifact: callable receiver owner is not a nominal type")

func write_receiver_kind(writer: PackageWriter, value: HirReceiverKind):
    match value:
        type_function: writer.write_u8(0)
        value_method: writer.write_u8(1)
        mutating_method: writer.write_u8(2)
        initializer: writer.write_u8(3)
        deinitializer: writer.write_u8(4)

func read_receiver_kind(reader: PackageReader) -> HirReceiverKind!:
    let tag = try reader.read_u8()
    if tag == 0: return HirReceiverKind.type_function
    if tag == 1: return HirReceiverKind.value_method
    if tag == 2: return HirReceiverKind.mutating_method
    if tag == 3: return HirReceiverKind.initializer
    if tag == 4: return HirReceiverKind.deinitializer
    error("typed package artifact: unknown HIR receiver kind tag " + str(u64(tag)))
