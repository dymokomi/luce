#==============================================================================================
#
#   package_nominal_codec - Typed nominal declarations and applications
#
#   DESCRIPTION:
#       Serializes struct, class, and enum declaration schemas together with
#       the TypeId-aligned concrete views consumed by semantic execution and
#       MIR lowering. Declaration order and semantic identities are retained;
#       field placement, enum tag encoding, object headers, and ABI layout are
#       intentionally absent and remain backend responsibilities.
#
#==============================================================================================

from compiler.hir.ir import HirClass, HirClassApplication, HirEnum, HirEnumCase, HirField
from compiler.hir.ir import HirNominalApplication, HirNominalField, HirPayloadField, HirStruct
from compiler.hir.ir import HirTypeAlias, HirTypeParameter, ModuleId, TypeForm, TypeId, TypeTable, no_node
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import documentation_matches, read_documentation, read_module_id
from compiler.packages.hir_fields import read_node_id, read_symbol_id
from compiler.packages.hir_fields import read_optional_symbol_id, read_span, read_type_id
from compiler.packages.hir_fields import validate_module_id, validate_optional_node_id
from compiler.packages.hir_fields import validate_optional_symbol_id, validate_symbol_id, validate_type_id
from compiler.packages.hir_fields import write_documentation, write_module_id, write_node_id, write_symbol_id
from compiler.packages.hir_fields import write_optional_symbol_id, write_span, write_type_id
from compiler.packages.signature_codec import read_type_parameters, validate_type_parameters
from compiler.packages.signature_codec import write_type_parameters

## The declaration schemas and their canonical TypeId-indexed concrete views.
## Grouping these exact HIR tables prevents a caller from validating one side
## while accidentally omitting the other.
pub struct HirNominalTables:
    pub let aliases: list[HirTypeAlias]
    pub let structs: list[HirStruct]
    pub let classes: list[HirClass]
    pub let enums: list[HirEnum]
    pub let applications: list[HirNominalApplication?]

# mark: Public codec ===========================================================================

pub func write_nominal_tables(
    writer: PackageWriter,
    tables: HirNominalTables,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> !:
    try validate_nominal_tables(tables, types, module_count, symbol_count, node_count)
    try writer.write_count(len(tables.aliases))
    for value in tables.aliases: try write_alias(writer, value)
    try writer.write_count(len(tables.structs))
    for value in tables.structs: try write_struct(writer, value)
    try writer.write_count(len(tables.classes))
    for value in tables.classes: try write_class(writer, value)
    try writer.write_count(len(tables.enums))
    for value in tables.enums: try write_enum(writer, value)
    try writer.write_count(len(tables.applications))
    for value in tables.applications: try write_application(writer, value)

pub func read_nominal_tables(
    reader: PackageReader,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> HirNominalTables!:
    let aliases = list[HirTypeAlias]()
    let alias_count = try reader.read_count()
    for index in range(0, alias_count): aliases.append(try read_alias(reader))

    let structs = list[HirStruct]()
    let struct_count = try reader.read_count()
    for index in range(0, struct_count): structs.append(try read_struct(reader))

    let classes = list[HirClass]()
    let class_count = try reader.read_count()
    for index in range(0, class_count): classes.append(try read_class(reader))

    let enums = list[HirEnum]()
    let enum_count = try reader.read_count()
    for index in range(0, enum_count): enums.append(try read_enum(reader))

    let applications = list[HirNominalApplication?]()
    let application_count = try reader.read_count()
    for index in range(0, application_count): applications.append(try read_application(reader))

    let tables = HirNominalTables(
        aliases = aliases,
        structs = structs,
        classes = classes,
        enums = enums,
        applications = applications,
    )
    try validate_nominal_tables(tables, types, module_count, symbol_count, node_count)
    return tables

# mark: Declaration encoding ==================================================================

func write_alias(writer: PackageWriter, value: HirTypeAlias) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    write_type_id(writer, value.value_type)
    write_span(writer, value.span)

func read_alias(reader: PackageReader) -> HirTypeAlias!:
    return HirTypeAlias(
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        value_type = try read_type_id(reader),
        span = try read_span(reader),
    )

func write_struct(writer: PackageWriter, value: HirStruct) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    writer.write_u32(value.generic_id)
    try write_type_parameters(writer, value.type_parameters)
    writer.write_bool(value.is_extern)
    try write_fields(writer, value.fields)
    write_optional_symbol_id(writer, value.initializer)
    write_span(writer, value.span)

func read_struct(reader: PackageReader) -> HirStruct!:
    return HirStruct(
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        generic_id = try reader.read_u32(),
        type_parameters = try read_type_parameters(reader),
        is_extern = try reader.read_bool(),
        fields = try read_fields(reader),
        initializer = try read_optional_symbol_id(reader),
        span = try read_span(reader),
    )

func write_class(writer: PackageWriter, value: HirClass) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    writer.write_u32(value.generic_id)
    try write_type_parameters(writer, value.type_parameters)
    try write_fields(writer, value.fields)
    write_symbol_id(writer, value.initializer)
    write_optional_symbol_id(writer, value.deinitializer)
    write_span(writer, value.span)

func read_class(reader: PackageReader) -> HirClass!:
    return HirClass(
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        generic_id = try reader.read_u32(),
        type_parameters = try read_type_parameters(reader),
        fields = try read_fields(reader),
        initializer = try read_symbol_id(reader),
        deinitializer = try read_optional_symbol_id(reader),
        span = try read_span(reader),
    )

func write_enum(writer: PackageWriter, value: HirEnum) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    writer.write_u32(value.generic_id)
    try write_type_parameters(writer, value.type_parameters)
    try write_cases(writer, value.cases)
    write_span(writer, value.span)

func read_enum(reader: PackageReader) -> HirEnum!:
    return HirEnum(
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        generic_id = try reader.read_u32(),
        type_parameters = try read_type_parameters(reader),
        cases = try read_cases(reader),
        span = try read_span(reader),
    )

# mark: Shared declaration fields ===============================================================

func write_fields(writer: PackageWriter, values: list[HirField]) -> !:
    try writer.write_count(len(values))
    for value in values:
        try writer.write_text(value.name)
        write_type_id(writer, value.value_type)
        writer.write_bool(value.is_mutable)
        writer.write_bool(value.is_weak)
        writer.write_bool(value.is_public)
        try write_documentation(writer, value.documentation)
        write_node_id(writer, value.default_value)

func read_fields(reader: PackageReader) -> list[HirField]!:
    let count = try reader.read_count()
    let values = list[HirField]()
    for index in range(0, count):
        values.append(HirField(
            name = try reader.read_text(),
            value_type = try read_type_id(reader),
            is_mutable = try reader.read_bool(),
            is_weak = try reader.read_bool(),
            is_public = try reader.read_bool(),
            documentation = try read_documentation(reader),
            default_value = try read_node_id(reader),
        ))
    return values

func write_nominal_fields(writer: PackageWriter, values: list[HirNominalField]) -> !:
    try writer.write_count(len(values))
    for value in values:
        try writer.write_text(value.name)
        write_type_id(writer, value.value_type)
        writer.write_bool(value.is_mutable)
        writer.write_bool(value.is_weak)
        writer.write_bool(value.is_public)
        try write_documentation(writer, value.documentation)

func read_nominal_fields(reader: PackageReader) -> list[HirNominalField]!:
    let count = try reader.read_count()
    let values = list[HirNominalField]()
    for index in range(0, count):
        values.append(HirNominalField(
            name = try reader.read_text(),
            value_type = try read_type_id(reader),
            is_mutable = try reader.read_bool(),
            is_weak = try reader.read_bool(),
            is_public = try reader.read_bool(),
            documentation = try read_documentation(reader),
        ))
    return values

func write_cases(writer: PackageWriter, values: list[HirEnumCase]) -> !:
    try writer.write_count(len(values))
    for value in values:
        try writer.write_text(value.name)
        try write_documentation(writer, value.documentation)
        try writer.write_count(len(value.payload))
        for field in value.payload:
            try writer.write_text(field.name)
            write_type_id(writer, field.value_type)

func read_cases(reader: PackageReader) -> list[HirEnumCase]!:
    let count = try reader.read_count()
    let values = list[HirEnumCase]()
    for index in range(0, count):
        let name = try reader.read_text()
        let documentation = try read_documentation(reader)
        let payload_count = try reader.read_count()
        let payload = list[HirPayloadField]()
        for field_index in range(0, payload_count):
            payload.append(HirPayloadField(
                name = try reader.read_text(),
                value_type = try read_type_id(reader),
            ))
        values.append(HirEnumCase(name = name, documentation = documentation, payload = payload))
    return values

# mark: Applied schemas ========================================================================

func write_application(writer: PackageWriter, value: HirNominalApplication?) -> !:
    if value == none:
        writer.write_u8(0)
        return
    match value:
        StructApplication(fields):
            writer.write_u8(1)
            try write_nominal_fields(writer, fields)
        ClassApplication(application):
            writer.write_u8(2)
            try write_nominal_fields(writer, application.fields)
            write_optional_symbol_id(writer, application.deinitializer)
        EnumApplication(cases):
            writer.write_u8(3)
            try write_cases(writer, cases)

func read_application(reader: PackageReader) -> HirNominalApplication?!:
    let tag = try reader.read_u8()
    if tag == 0: return none
    if tag == 1:
        return HirNominalApplication.StructApplication(fields = try read_nominal_fields(reader))
    if tag == 2:
        return HirNominalApplication.ClassApplication(application = HirClassApplication(
            fields = try read_nominal_fields(reader),
            deinitializer = try read_optional_symbol_id(reader),
        ))
    if tag == 3: return HirNominalApplication.EnumApplication(cases = try read_cases(reader))
    error("typed package artifact: unknown HIR nominal application tag " + str(u64(tag)))

# mark: Semantic validation ====================================================================

pub func validate_nominal_tables(
    tables: HirNominalTables,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> !:
    if len(tables.applications) != len(types.definitions):
        error("typed package artifact: nominal application table must align with HIR TypeIds")
    for index in range(0, len(tables.aliases)):
        let value = tables.aliases[index]
        try validate_declaration_header(value.module, value.name, module_count)
        try validate_type_id(value.value_type, len(types.definitions))
        for previous in range(0, index):
            let other = tables.aliases[previous]
            if other.module.value == value.module.value and other.name == value.name:
                error("typed package artifact: duplicate type alias `" + value.name + "`")
    let generic_ids = list[u32]()
    for value in tables.structs:
        try validate_declaration_header(value.module, value.name, module_count)
        try register_generic_id(value.type_parameters, value.generic_id, generic_ids)
        try validate_type_parameters(value.type_parameters, value.generic_id, types)
        try validate_fields(value.fields, types, node_count, false)
        try validate_optional_symbol_id(value.initializer, symbol_count)
        if value.is_extern and len(value.type_parameters) > 0:
            error("typed package artifact: extern struct cannot be generic")
    for value in tables.classes:
        try validate_declaration_header(value.module, value.name, module_count)
        try register_generic_id(value.type_parameters, value.generic_id, generic_ids)
        try validate_type_parameters(value.type_parameters, value.generic_id, types)
        try validate_fields(value.fields, types, node_count, true)
        try validate_symbol_id(value.initializer, symbol_count)
        try validate_optional_symbol_id(value.deinitializer, symbol_count)
    for value in tables.enums:
        try validate_declaration_header(value.module, value.name, module_count)
        try register_generic_id(value.type_parameters, value.generic_id, generic_ids)
        try validate_type_parameters(value.type_parameters, value.generic_id, types)
        try validate_cases(value.cases, types)

    for index in range(0, len(types.definitions)):
        let application = tables.applications[index]
        match types.definitions[index].form:
            Struct(declaration, arguments):
                if declaration < 0 or declaration >= len(tables.structs):
                    error("typed package artifact: HIR struct type references a missing declaration")
                if application == none:
                    error("typed package artifact: HIR struct type has no struct application")
                match application:
                    StructApplication(fields):
                        try validate_applied_fields(fields, tables.structs[declaration].fields, types)
                    else: error("typed package artifact: HIR struct type has no struct application")
            Class(declaration, arguments):
                if declaration < 0 or declaration >= len(tables.classes):
                    error("typed package artifact: HIR class type references a missing declaration")
                if application == none:
                    error("typed package artifact: HIR class type has no class application")
                match application:
                    ClassApplication(value):
                        try validate_applied_fields(value.fields, tables.classes[declaration].fields, types)
                        try validate_optional_symbol_id(value.deinitializer, symbol_count)
                    else: error("typed package artifact: HIR class type has no class application")
            Enum(declaration, arguments):
                if declaration < 0 or declaration >= len(tables.enums):
                    error("typed package artifact: HIR enum type references a missing declaration")
                if application == none:
                    error("typed package artifact: HIR enum type has no enum application")
                match application:
                    EnumApplication(cases):
                        try validate_applied_cases(cases, tables.enums[declaration].cases, types)
                    else: error("typed package artifact: HIR enum type has no enum application")
            else:
                if application != none:
                    error("typed package artifact: non-nominal HIR type has nominal application metadata")

func validate_declaration_header(module: ModuleId, name: str, module_count: i64) -> !:
    try validate_module_id(module, module_count)
    if len(name) == 0: error("typed package artifact: nominal declaration name must not be empty")

func register_generic_id(values: list[HirTypeParameter], generic_id: u32, seen: list[u32]) -> !:
    if len(values) == 0: return
    for previous in seen:
        if previous == generic_id:
            error("typed package artifact: generic declaration identity is not unique")
    seen.append(generic_id)

func validate_fields(values: list[HirField], types: TypeTable, node_count: i64, class_fields: bool) -> !:
    for index in range(0, len(values)):
        let value = values[index]
        try validate_field_identity(value.name, index, values)
        try validate_type_id(value.value_type, len(types.definitions))
        try validate_optional_node_id(value.default_value, node_count)
        if class_fields and value.default_value.value != no_node:
            error("typed package artifact: class field cannot have a declaration default")
        if value.is_weak:
            if not class_fields:
                error("typed package artifact: struct field cannot be weak")
            if not value.is_mutable:
                error("typed package artifact: weak class field must be mutable")
            match types.definitions[value.value_type.value].form:
                Optional(inner):
                    match types.definitions[inner.value].form:
                        Class(declaration, arguments): pass
                        else: error("typed package artifact: weak field must contain an optional class")
                else: error("typed package artifact: weak field must contain an optional class")

func validate_cases(values: list[HirEnumCase], types: TypeTable) -> !:
    for index in range(0, len(values)):
        let value = values[index]
        if len(value.name) == 0: error("typed package artifact: enum case name must not be empty")
        for previous in range(0, index):
            if values[previous].name == value.name:
                error("typed package artifact: duplicate enum case `" + value.name + "`")
        for field_index in range(0, len(value.payload)):
            let field = value.payload[field_index]
            if len(field.name) == 0:
                error("typed package artifact: enum payload label must not be empty")
            for previous in range(0, field_index):
                if value.payload[previous].name == field.name:
                    error("typed package artifact: duplicate enum payload label `" + field.name + "`")
            try validate_type_id(field.value_type, len(types.definitions))

func validate_applied_fields(values: list[HirNominalField], schema: list[HirField], types: TypeTable) -> !:
    if len(values) != len(schema):
        error("typed package artifact: nominal application field count does not match its declaration")
    for index in range(0, len(values)):
        let value = values[index]
        let declared = schema[index]
        if value.name != declared.name:
            error("typed package artifact: nominal application field metadata does not match its declaration")
        if value.is_mutable != declared.is_mutable:
            error("typed package artifact: nominal application field metadata does not match its declaration")
        if value.is_weak != declared.is_weak or value.is_public != declared.is_public:
            error("typed package artifact: nominal application field metadata does not match its declaration")
        if not documentation_matches(value.documentation, declared.documentation):
            error("typed package artifact: nominal application field metadata does not match its declaration")
        try validate_type_id(value.value_type, len(types.definitions))

func validate_applied_cases(values: list[HirEnumCase], schema: list[HirEnumCase], types: TypeTable) -> !:
    if len(values) != len(schema):
        error("typed package artifact: enum application case count does not match its declaration")
    for index in range(0, len(values)):
        let value = values[index]
        let declared = schema[index]
        if value.name != declared.name or len(value.payload) != len(declared.payload):
            error("typed package artifact: enum application case metadata does not match its declaration")
        if not documentation_matches(value.documentation, declared.documentation):
            error("typed package artifact: enum application case metadata does not match its declaration")
        for field_index in range(0, len(value.payload)):
            let field = value.payload[field_index]
            if field.name != declared.payload[field_index].name:
                error("typed package artifact: enum application payload metadata does not match its declaration")
            try validate_type_id(field.value_type, len(types.definitions))

func validate_field_identity(name: str, index: i64, values: list[HirField]) -> !:
    if len(name) == 0: error("typed package artifact: nominal field name must not be empty")
    for previous in range(0, index):
        if values[previous].name == name:
            error("typed package artifact: duplicate nominal field `" + name + "`")
