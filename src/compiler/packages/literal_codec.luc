#==============================================================================================
#
#   package_literal_codec - Compile-time HIR literals in typed package bodies
#
#   DESCRIPTION:
#       Serializes only the immutable semantic values a checked source body
#       may place behind `HirNodeForm.Constant`. Runtime collection, closure,
#       interface, pointer, and storage carriers are deliberately rejected:
#       they are execution state, never package metadata.
#
#==============================================================================================

from compiler.formatting.ieee import ieee_float_bits, ieee_float_value
from compiler.hir.ir import Value
from compiler.packages.encoding import PackageReader, PackageWriter

# mark: Encoding ===============================================================================

pub func write_literal(writer: PackageWriter, value: Value) -> !:
    match value:
        Unit:
            writer.write_u8(0)
        Boolean(item):
            writer.write_u8(1)
            writer.write_bool(item)
        SignedInteger(item):
            writer.write_u8(2)
            writer.write_i64(item)
        UnsignedInteger(item):
            writer.write_u8(3)
            writer.write_u64(item)
        Floating(item):
            writer.write_u8(4)
            writer.write_u64(ieee_float_bits(item, 64))
        Character(item):
            writer.write_u8(5)
            writer.write_u32(u32(item))
        Text(item):
            writer.write_u8(6)
            try writer.write_text(item)
        Bytes(item):
            writer.write_u8(7)
            try writer.write_bytes(item)
        else:
            error("typed package artifact: retained HIR value is not a serializable literal")

# mark: Decoding ===============================================================================

pub func read_literal(reader: PackageReader) -> Value!:
    let tag = try reader.read_u8()
    if tag == 0: return Value.Unit
    if tag == 1: return Value.Boolean(value = try reader.read_bool())
    if tag == 2: return Value.SignedInteger(value = try reader.read_i64())
    if tag == 3: return Value.UnsignedInteger(value = try reader.read_u64())
    if tag == 4:
        return Value.Floating(value = try ieee_float_value(try reader.read_u64(), 64))
    if tag == 5:
        let scalar = try reader.read_u32()
        if scalar > u32(0x10FFFF) or (scalar >= u32(0xD800) and scalar <= u32(0xDFFF)):
            error("typed package artifact: character literal is not a Unicode scalar")
        return Value.Character(value = char(scalar))
    if tag == 6: return Value.Text(value = try reader.read_text())
    if tag == 7: return Value.Bytes(value = try reader.read_bytes())
    error("typed package artifact: unknown retained HIR literal tag " + str(u64(tag)))
