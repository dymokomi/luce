#==============================================================================================
#
#   package_hir_fields - Shared identity fields in typed HIR artifacts
#
#   DESCRIPTION:
#       Owns the canonical byte spelling of compact HIR identities and the
#       repeated text/type fields already shared by package sections. Section
#       codecs compose these primitives; none may invent a second spelling for
#       the same HIR fact. Fixed wire widths belong to the artifact format and
#       say nothing about a backend pointer width, alignment, layout, or ABI.
#
#==============================================================================================

from compiler.hir.ir import ModuleId, PackageId, SymbolId, TypeId
from compiler.packages.encoding import PackageReader, PackageWriter

# mark: Compact identities ====================================================================

pub func write_package_id(writer: PackageWriter, value: PackageId):
    writer.write_u32(value.value)

pub func read_package_id(reader: PackageReader) -> PackageId!:
    return PackageId(value = try reader.read_u32())

pub func write_module_id(writer: PackageWriter, value: ModuleId):
    writer.write_u32(value.value)

pub func read_module_id(reader: PackageReader) -> ModuleId!:
    return ModuleId(value = try reader.read_u32())

pub func write_symbol_id(writer: PackageWriter, value: SymbolId):
    writer.write_u32(value.value)

pub func read_symbol_id(reader: PackageReader) -> SymbolId!:
    return SymbolId(value = try reader.read_u32())

pub func write_type_id(writer: PackageWriter, value: TypeId):
    writer.write_u32(value.value)

pub func read_type_id(reader: PackageReader) -> TypeId!:
    return TypeId(value = try reader.read_u32())

# mark: Repeated identities ===================================================================

pub func write_type_ids(writer: PackageWriter, values: list[TypeId]) -> !:
    try writer.write_count(len(values))
    for value in values: write_type_id(writer, value)

pub func read_type_ids(reader: PackageReader) -> list[TypeId]!:
    let count = try reader.read_count()
    let values = list[TypeId]()
    for index in range(0, count): values.append(try read_type_id(reader))
    return values

pub func write_documentation(writer: PackageWriter, lines: list[str]) -> !:
    try writer.write_count(len(lines))
    for line in lines: try writer.write_text(line)

pub func read_documentation(reader: PackageReader) -> list[str]!:
    let count = try reader.read_count()
    let lines = list[str]()
    for index in range(0, count): lines.append(try reader.read_text())
    return lines

# mark: Reference validation ==================================================================

pub func validate_package_id(value: PackageId, count: i64) -> !:
    try validate_index(value.value, count, "PackageId")

pub func validate_type_id(value: TypeId, count: i64) -> !:
    try validate_index(value.value, count, "TypeId")

func validate_index(value: u32, count: i64, family: str) -> !:
    if count < 0 or i64(value) >= count:
        error("typed package artifact: HIR " + family + " references a missing table entry")
