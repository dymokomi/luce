#==============================================================================================
#
#   package_hir_fields - Shared identity fields in typed HIR artifacts
#
#   DESCRIPTION:
#       Owns the canonical byte spelling of compact HIR identities and the
#       repeated text/type fields already shared by package sections. Section
#       codecs compose these primitives; none may invent a second spelling for
#       the same HIR fact. Fixed wire widths belong to the artifact format and
#       say nothing about a backend pointer width, alignment, layout, or ABI.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.ir import ModuleId, NodeId, Operands, PackageId, SymbolId, TypeId, no_node
from compiler.packages.encoding import PackageReader, PackageWriter

# mark: Compact identities ====================================================================

pub func write_package_id(writer: PackageWriter, value: PackageId):
    writer.write_u32(value.value)

pub func read_package_id(reader: PackageReader) -> PackageId!:
    return PackageId(value = try reader.read_u32())

pub func write_module_id(writer: PackageWriter, value: ModuleId):
    writer.write_u32(value.value)

pub func read_module_id(reader: PackageReader) -> ModuleId!:
    return ModuleId(value = try reader.read_u32())

pub func write_symbol_id(writer: PackageWriter, value: SymbolId):
    writer.write_u32(value.value)

pub func read_symbol_id(reader: PackageReader) -> SymbolId!:
    return SymbolId(value = try reader.read_u32())

pub func write_type_id(writer: PackageWriter, value: TypeId):
    writer.write_u32(value.value)

pub func read_type_id(reader: PackageReader) -> TypeId!:
    return TypeId(value = try reader.read_u32())

pub func write_node_id(writer: PackageWriter, value: NodeId):
    writer.write_u32(value.value)

pub func read_node_id(reader: PackageReader) -> NodeId!:
    return NodeId(value = try reader.read_u32())

pub func write_operands(writer: PackageWriter, value: Operands):
    writer.write_u32(value.start)
    writer.write_u32(value.count)

pub func read_operands(reader: PackageReader) -> Operands!:
    return Operands(start = try reader.read_u32(), count = try reader.read_u32())

# mark: Repeated identities ===================================================================

pub func write_type_ids(writer: PackageWriter, values: list[TypeId]) -> !:
    try writer.write_count(len(values))
    for value in values: write_type_id(writer, value)

pub func read_type_ids(reader: PackageReader) -> list[TypeId]!:
    let count = try reader.read_count()
    let values = list[TypeId]()
    for index in range(0, count): values.append(try read_type_id(reader))
    return values

pub func write_documentation(writer: PackageWriter, lines: list[str]) -> !:
    try writer.write_count(len(lines))
    for line in lines: try writer.write_text(line)

pub func read_documentation(reader: PackageReader) -> list[str]!:
    let count = try reader.read_count()
    let lines = list[str]()
    for index in range(0, count): lines.append(try reader.read_text())
    return lines

pub func documentation_matches(left: list[str], right: list[str]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

# mark: Optional and structured fields =========================================================

pub func write_optional_symbol_id(writer: PackageWriter, value: SymbolId?):
    if value == none:
        writer.write_bool(false)
    else:
        writer.write_bool(true)
        write_symbol_id(writer, value)

pub func read_optional_symbol_id(reader: PackageReader) -> SymbolId?!:
    if not try reader.read_bool(): return none
    return try read_symbol_id(reader)

pub func write_span(writer: PackageWriter, value: SourceSpan):
    writer.write_u32(value.start)
    writer.write_u32(value.end)
    writer.write_u32(value.line)
    writer.write_u32(value.column)

pub func read_span(reader: PackageReader) -> SourceSpan!:
    return SourceSpan(
        start = try reader.read_u32(),
        end = try reader.read_u32(),
        line = try reader.read_u32(),
        column = try reader.read_u32(),
    )

pub func spans_match(left: SourceSpan, right: SourceSpan) -> bool:
    if left.start != right.start or left.end != right.end: return false
    return left.line == right.line and left.column == right.column

# mark: Reference validation ==================================================================

pub func validate_package_id(value: PackageId, count: i64) -> !:
    try validate_index(value.value, count, "PackageId")

pub func validate_type_id(value: TypeId, count: i64) -> !:
    try validate_index(value.value, count, "TypeId")

pub func validate_module_id(value: ModuleId, count: i64) -> !:
    try validate_index(value.value, count, "ModuleId")

pub func validate_symbol_id(value: SymbolId, count: i64) -> !:
    try validate_index(value.value, count, "SymbolId")

pub func validate_optional_symbol_id(value: SymbolId?, count: i64) -> !:
    if value != none: try validate_symbol_id(value, count)

pub func validate_optional_node_id(value: NodeId, count: i64) -> !:
    if value.value != no_node: try validate_index(value.value, count, "NodeId")

pub func validate_operands(value: Operands, count: i64, stride: i64 = 1) -> !:
    if stride <= 0 or i64(value.count) % stride != 0:
        error("typed package artifact: HIR operand run has an invalid structural count")
    if i64(value.start) > count or i64(value.count) > count - i64(value.start):
        error("typed package artifact: HIR operand run references missing arena data")

func validate_index(value: u32, count: i64, family: str) -> !:
    if count < 0 or i64(value) >= count:
        error("typed package artifact: HIR " + family + " references a missing table entry")
