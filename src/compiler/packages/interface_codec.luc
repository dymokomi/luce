#==============================================================================================
#
#   package_interface_codec - Nominal contracts, applications, and conformances
#
#   DESCRIPTION:
#       Serializes source and compiler-known interfaces, their fully applied
#       requirement signatures, and explicit nominal implementations. Witness
#       order is semantic declaration order; witness-table layout, existential
#       storage, and dispatch encoding remain backend-owned.
#
#==============================================================================================

from compiler.hir.ir import HirConformance, HirConformanceAdaptation, HirGenericConformance, HirInterface, HirInterfaceApplication
from compiler.hir.ir import HirInterfaceOrigin, HirInterfaceRequirement, StandardInterface
from compiler.hir.ir import SymbolId, TypeForm, TypeId, TypeTable, no_node
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import documentation_matches, read_documentation, read_module_id
from compiler.packages.hir_fields import read_span, read_symbol_id, read_type_id, spans_match
from compiler.packages.hir_fields import validate_module_id, validate_symbol_id, validate_type_id
from compiler.packages.hir_fields import write_documentation, write_module_id, write_span
from compiler.packages.hir_fields import write_symbol_id, write_type_id, write_type_ids
from compiler.packages.signature_codec import read_parameters, read_type_parameters
from compiler.packages.signature_codec import validate_parameters, validate_type_parameters
from compiler.packages.signature_codec import write_parameters, write_type_parameters

pub struct HirInterfaceTables:
    pub let interfaces: list[HirInterface]
    pub let applications: list[HirInterfaceApplication]
    pub let conformances: list[HirConformance]
    pub let generic_conformances: list[HirGenericConformance]

# mark: Public codec ===========================================================================

pub func write_interface_tables(
    writer: PackageWriter,
    tables: HirInterfaceTables,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> !:
    try validate_interface_tables(tables, types, module_count, symbol_count, node_count)
    try writer.write_count(len(tables.interfaces))
    for value in tables.interfaces: try write_interface(writer, value)
    try writer.write_count(len(tables.applications))
    for value in tables.applications: try write_application(writer, value)
    try writer.write_count(len(tables.conformances))
    for value in tables.conformances: try write_conformance(writer, value)
    try writer.write_count(len(tables.generic_conformances))
    for value in tables.generic_conformances: try write_generic_conformance(writer, value)

pub func read_interface_tables(
    reader: PackageReader,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> HirInterfaceTables!:
    let interfaces = list[HirInterface]()
    let interface_count = try reader.read_count()
    for index in range(0, interface_count): interfaces.append(try read_interface(reader))

    let applications = list[HirInterfaceApplication]()
    let application_count = try reader.read_count()
    for index in range(0, application_count): applications.append(try read_application(reader))

    let conformances = list[HirConformance]()
    let conformance_count = try reader.read_count()
    for index in range(0, conformance_count): conformances.append(try read_conformance(reader))

    let generic_conformances = list[HirGenericConformance]()
    let generic_conformance_count = try reader.read_count()
    for index in range(0, generic_conformance_count):
        generic_conformances.append(try read_generic_conformance(reader))

    let tables = HirInterfaceTables(
        interfaces = interfaces,
        applications = applications,
        conformances = conformances,
        generic_conformances = generic_conformances,
    )
    try validate_interface_tables(tables, types, module_count, symbol_count, node_count)
    return tables

# mark: Interface declarations =================================================================

func write_interface(writer: PackageWriter, value: HirInterface) -> !:
    write_origin(writer, value.origin)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    writer.write_u32(value.generic_id)
    try write_type_parameters(writer, value.type_parameters)
    try write_requirements(writer, value.requirements)
    write_span(writer, value.span)

func read_interface(reader: PackageReader) -> HirInterface!:
    return HirInterface(
        origin = try read_origin(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        generic_id = try reader.read_u32(),
        type_parameters = try read_type_parameters(reader),
        requirements = try read_requirements(reader),
        span = try read_span(reader),
    )

func write_origin(writer: PackageWriter, value: HirInterfaceOrigin):
    match value:
        Source(module):
            writer.write_u8(0)
            write_module_id(writer, module)
        Standard(identity):
            writer.write_u8(1)
            write_standard_interface(writer, identity)

func read_origin(reader: PackageReader) -> HirInterfaceOrigin!:
    let tag = try reader.read_u8()
    if tag == 0: return HirInterfaceOrigin.Source(module = try read_module_id(reader))
    if tag == 1: return HirInterfaceOrigin.Standard(identity = try read_standard_interface(reader))
    error("typed package artifact: unknown HIR interface origin tag " + str(u64(tag)))

func write_standard_interface(writer: PackageWriter, value: StandardInterface):
    match value:
        iterator: writer.write_u8(0)
        iterable: writer.write_u8(1)
        fallible_iterator: writer.write_u8(2)
        fallible_iterable: writer.write_u8(3)
        equatable: writer.write_u8(4)
        hashable: writer.write_u8(5)
        display: writer.write_u8(6)

func read_standard_interface(reader: PackageReader) -> StandardInterface!:
    let tag = try reader.read_u8()
    if tag == 0: return StandardInterface.iterator
    if tag == 1: return StandardInterface.iterable
    if tag == 2: return StandardInterface.fallible_iterator
    if tag == 3: return StandardInterface.fallible_iterable
    if tag == 4: return StandardInterface.equatable
    if tag == 5: return StandardInterface.hashable
    if tag == 6: return StandardInterface.display
    error("typed package artifact: unknown standard interface tag " + str(u64(tag)))

# mark: Requirements and applications ==========================================================

func write_requirements(writer: PackageWriter, values: list[HirInterfaceRequirement]) -> !:
    try writer.write_count(len(values))
    for value in values:
        write_symbol_id(writer, value.symbol)
        try writer.write_text(value.name)
        writer.write_bool(value.is_mutating)
        try write_documentation(writer, value.documentation)
        try write_parameters(writer, value.parameters)
        write_type_id(writer, value.result)
        write_span(writer, value.span)

func read_requirements(reader: PackageReader) -> list[HirInterfaceRequirement]!:
    let count = try reader.read_count()
    let values = list[HirInterfaceRequirement]()
    for index in range(0, count):
        values.append(HirInterfaceRequirement(
            symbol = try read_symbol_id(reader),
            name = try reader.read_text(),
            is_mutating = try reader.read_bool(),
            documentation = try read_documentation(reader),
            parameters = try read_parameters(reader),
            result = try read_type_id(reader),
            span = try read_span(reader),
        ))
    return values

func write_application(writer: PackageWriter, value: HirInterfaceApplication) -> !:
    write_type_id(writer, value.value_type)
    writer.write_u32(value.declaration)
    try write_requirements(writer, value.requirements)

func read_application(reader: PackageReader) -> HirInterfaceApplication!:
    return HirInterfaceApplication(
        value_type = try read_type_id(reader),
        declaration = try reader.read_u32(),
        requirements = try read_requirements(reader),
    )

func write_conformance(writer: PackageWriter, value: HirConformance) -> !:
    write_type_id(writer, value.value_type)
    write_type_id(writer, value.interface_type)
    try writer.write_count(len(value.implementations))
    for implementation in value.implementations: write_symbol_id(writer, implementation)

func read_conformance(reader: PackageReader) -> HirConformance!:
    let value_type = try read_type_id(reader)
    let interface_type = try read_type_id(reader)
    let count = try reader.read_count()
    let implementations = list[SymbolId]()
    for index in range(0, count): implementations.append(try read_symbol_id(reader))
    return HirConformance(
        value_type = value_type,
        interface_type = interface_type,
        implementations = implementations,
    )

func write_generic_conformance(writer: PackageWriter, value: HirGenericConformance) -> !:
    write_module_id(writer, value.module)
    writer.write_u32(value.generic_id)
    write_type_id(writer, value.value_type)
    write_type_id(writer, value.interface_type)
    writer.write_bool(value.is_class)
    try writer.write_count(len(value.adaptations))
    for adaptation in value.adaptations:
        match adaptation:
            direct: writer.write_u8(0)
            fallible_lift: writer.write_u8(1)
    write_span(writer, value.span)

func read_generic_conformance(reader: PackageReader) -> HirGenericConformance!:
    let module = try read_module_id(reader)
    let generic_id = try reader.read_u32()
    let value_type = try read_type_id(reader)
    let interface_type = try read_type_id(reader)
    let is_class = try reader.read_bool()
    let count = try reader.read_count()
    let adaptations = list[HirConformanceAdaptation]()
    for index in range(0, count):
        let tag = try reader.read_u8()
        if tag == 0: adaptations.append(HirConformanceAdaptation.direct)
        elif tag == 1: adaptations.append(HirConformanceAdaptation.fallible_lift)
        else: error("typed package artifact: unknown generic conformance adaptation tag " + str(u64(tag)))
    return HirGenericConformance(
        module = module,
        generic_id = generic_id,
        value_type = value_type,
        interface_type = interface_type,
        is_class = is_class,
        adaptations = adaptations,
        span = try read_span(reader),
    )

# mark: Semantic validation ====================================================================

pub func validate_interface_tables(
    tables: HirInterfaceTables,
    types: TypeTable,
    module_count: i64,
    symbol_count: i64,
    node_count: i64,
) -> !:
    let generic_ids = list[u32]()
    for index in range(0, len(tables.interfaces)):
        let value = tables.interfaces[index]
        if len(value.name) == 0:
            error("typed package artifact: interface name must not be empty")
        try validate_origin(value.origin, module_count)
        try validate_interface_identity(value, index, tables.interfaces)
        if len(value.type_parameters) > 0:
            for seen in generic_ids:
                if seen == value.generic_id:
                    error("typed package artifact: generic interface identity is not unique")
            generic_ids.append(value.generic_id)
        try validate_type_parameters(value.type_parameters, value.generic_id, types)
        try validate_requirements(value.requirements, types, symbol_count, node_count)

    var interface_type_count = 0
    for definition in types.definitions:
        match definition.form:
            Interface(declaration, arguments):
                interface_type_count += 1
                if declaration < 0 or declaration >= len(tables.interfaces):
                    error("typed package artifact: HIR interface type references a missing declaration")
                if len(arguments) != len(tables.interfaces[declaration].type_parameters):
                    error("typed package artifact: HIR interface type has the wrong argument count")
            else: pass
    if len(tables.applications) != interface_type_count:
        error("typed package artifact: interface application table does not cover every interface TypeId")

    for index in range(0, len(tables.applications)):
        let value = tables.applications[index]
        try validate_type_id(value.value_type, len(types.definitions))
        var declaration = -1
        match types.definitions[value.value_type.value].form:
            Interface(interface_index, arguments): declaration = interface_index
            else: error("typed package artifact: interface application value is not an interface type")
        if value.declaration != u32(declaration):
            error("typed package artifact: interface application names the wrong declaration")
        for previous in range(0, index):
            if tables.applications[previous].value_type.value == value.value_type.value:
                error("typed package artifact: duplicate interface application TypeId")
        let contract = tables.interfaces[declaration]
        try validate_requirements(value.requirements, types, symbol_count, node_count)
        try validate_applied_requirements(value.requirements, contract.requirements)

    for index in range(0, len(tables.conformances)):
        try validate_conformance(
            tables.conformances[index], index, tables.conformances,
            tables.applications, types, symbol_count,
        )
    for index in range(0, len(tables.generic_conformances)):
        try validate_generic_conformance(
            tables.generic_conformances[index], index,
            tables.generic_conformances, tables.applications, types, module_count,
        )

func validate_origin(value: HirInterfaceOrigin, module_count: i64) -> !:
    match value:
        Source(module): try validate_module_id(module, module_count)
        Standard(identity): pass

func validate_interface_identity(
    value: HirInterface,
    index: i64,
    interfaces: list[HirInterface],
) -> !:
    for previous in range(0, index):
        let other = interfaces[previous]
        match value.origin:
            Source(module):
                match other.origin:
                    Source(other_module):
                        if module.value == other_module.value and value.name == other.name:
                            error("typed package artifact: duplicate interface declaration `" + value.name + "`")
                    Standard(identity): pass
            Standard(identity):
                match other.origin:
                    Source(module): pass
                    Standard(other_identity):
                        if identity == other_identity:
                            error("typed package artifact: duplicate standard interface declaration")

func validate_requirements(
    values: list[HirInterfaceRequirement],
    types: TypeTable,
    symbol_count: i64,
    node_count: i64,
) -> !:
    for index in range(0, len(values)):
        let value = values[index]
        try validate_symbol_id(value.symbol, symbol_count)
        if len(value.name) == 0:
            error("typed package artifact: interface requirement name must not be empty")
        for previous in range(0, index):
            if values[previous].name == value.name:
                error("typed package artifact: duplicate interface requirement `" + value.name + "`")
        try validate_parameters(value.parameters, types, symbol_count, node_count)
        for parameter in value.parameters:
            if parameter.default_value.value != no_node:
                error("typed package artifact: interface requirement parameter cannot have a default")
        try validate_type_id(value.result, len(types.definitions))

func validate_applied_requirements(
    values: list[HirInterfaceRequirement],
    schema: list[HirInterfaceRequirement],
) -> !:
    if len(values) != len(schema):
        error("typed package artifact: interface application requirement count does not match its declaration")
    for index in range(0, len(values)):
        let value = values[index]
        let declared = schema[index]
        if value.symbol.value != declared.symbol.value or value.name != declared.name:
            error("typed package artifact: interface application requirement metadata does not match")
        if value.is_mutating != declared.is_mutating:
            error("typed package artifact: interface application requirement metadata does not match")
        if not documentation_matches(value.documentation, declared.documentation):
            error("typed package artifact: interface application requirement metadata does not match")
        if not spans_match(value.span, declared.span):
            error("typed package artifact: interface application requirement metadata does not match")
        if len(value.parameters) != len(declared.parameters):
            error("typed package artifact: interface application parameter count does not match")
        for parameter_index in range(0, len(value.parameters)):
            let parameter = value.parameters[parameter_index]
            let declared_parameter = declared.parameters[parameter_index]
            if parameter.symbol.value != declared_parameter.symbol.value:
                error("typed package artifact: interface application parameter metadata does not match")
            if parameter.name != declared_parameter.name:
                error("typed package artifact: interface application parameter metadata does not match")
            if parameter.default_value.value != declared_parameter.default_value.value:
                error("typed package artifact: interface application parameter metadata does not match")

func validate_conformance(
    value: HirConformance,
    index: i64,
    values: list[HirConformance],
    applications: list[HirInterfaceApplication],
    types: TypeTable,
    symbol_count: i64,
) -> !:
    try validate_type_id(value.value_type, len(types.definitions))
    match types.definitions[value.value_type.value].form:
        Struct(declaration, arguments): pass
        Class(declaration, arguments): pass
        Enum(declaration, arguments): pass
        else: error("typed package artifact: conformance value is not a nominal source type")
    try validate_type_id(value.interface_type, len(types.definitions))
    match types.definitions[value.interface_type.value].form:
        Interface(declaration, arguments): pass
        else: error("typed package artifact: conformance target is not an interface type")
    for previous in range(0, index):
        if values[previous].value_type.value != value.value_type.value: continue
        if values[previous].interface_type.value == value.interface_type.value:
            error("typed package artifact: duplicate nominal interface conformance")
    var requirement_count = -1
    for application in applications:
        if application.value_type.value == value.interface_type.value:
            requirement_count = len(application.requirements)
            break
    if requirement_count < 0:
        error("typed package artifact: conformance interface has no applied signature")
    if len(value.implementations) != requirement_count:
        error("typed package artifact: conformance implementation count does not match its interface")
    for implementation in value.implementations:
        try validate_symbol_id(implementation, symbol_count)

func validate_generic_conformance(
    value: HirGenericConformance,
    index: i64,
    values: list[HirGenericConformance],
    applications: list[HirInterfaceApplication],
    types: TypeTable,
    module_count: i64,
) -> !:
    try validate_module_id(value.module, module_count)
    try validate_type_id(value.value_type, len(types.definitions))
    let arguments = list[TypeId]()
    var actual_class = false
    match types.definitions[value.value_type.value].form:
        Struct(declaration, type_arguments):
            for argument in type_arguments: arguments.append(argument)
        Class(declaration, type_arguments):
            actual_class = true
            for argument in type_arguments: arguments.append(argument)
        Enum(declaration, type_arguments):
            for argument in type_arguments: arguments.append(argument)
        else: error("typed package artifact: generic conformance value is not a nominal source type")
    if actual_class != value.is_class:
        error("typed package artifact: generic conformance class identity does not match its value type")
    if len(arguments) == 0:
        error("typed package artifact: generic conformance value is not generic")
    for position in range(0, len(arguments)):
        match types.definitions[arguments[position].value].form:
            TypeParameter(generic_id, parameter_position):
                if generic_id != value.generic_id or parameter_position != u32(position):
                    error("typed package artifact: generic conformance owner parameters do not match its identity")
            else: error("typed package artifact: generic conformance owner is not abstract")

    try validate_type_id(value.interface_type, len(types.definitions))
    match types.definitions[value.interface_type.value].form:
        Interface(declaration, type_arguments): pass
        else: error("typed package artifact: generic conformance target is not an interface type")
    var requirement_count = -1
    for application in applications:
        if application.value_type.value == value.interface_type.value:
            requirement_count = len(application.requirements)
            break
    if requirement_count < 0:
        error("typed package artifact: generic conformance interface has no applied signature")
    if len(value.adaptations) != requirement_count:
        error("typed package artifact: generic conformance adaptation count does not match its interface")
    for previous in range(0, index):
        let other = values[previous]
        if other.value_type.value == value.value_type.value and other.interface_type.value == value.interface_type.value:
            error("typed package artifact: duplicate generic nominal interface conformance")
