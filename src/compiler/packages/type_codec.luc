#==============================================================================================
#
#   package_type_codec - Canonical target-neutral HIR type tables
#
#   DESCRIPTION:
#       Serializes the structural type graph shared by executable HIR and
#       typed generic bodies. Wire tags belong to the enclosing package format
#       version; there is no legacy decoder. Diagnostic names are retained,
#       while every semantic edge remains an explicit TypeId.
#
#==============================================================================================

from compiler.hir.ir import TypeDefinition, TypeForm, TypeId, TypeTable
from compiler.hir.ir import create_builtin_type_table, type_forms_match
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_type_id, read_type_ids, write_type_id, write_type_ids

# mark: Public codec ===========================================================================

pub func write_type_table(writer: PackageWriter, types: TypeTable) -> !:
    try validate_type_table(types)
    try writer.write_count(len(types.definitions))
    for definition in types.definitions:
        writer.write_u32(definition.id.value)
        try writer.write_text(definition.name)
        try write_type_form(writer, definition.form)

pub func read_type_table(reader: PackageReader) -> TypeTable!:
    let count = try reader.read_count()
    let definitions = list[TypeDefinition]()
    for index in range(0, count):
        let identity = TypeId(value = try reader.read_u32())
        let name = try reader.read_text()
        let form = try read_type_form(reader)
        definitions.append(TypeDefinition(id = identity, name = name, form = form))
    let types = TypeTable(definitions = definitions)
    try validate_type_table(types)
    return types

# mark: Type forms =============================================================================

func write_type_form(writer: PackageWriter, form: TypeForm) -> !:
    match form:
        Unit: writer.write_u8(0)
        Boolean: writer.write_u8(1)
        Never: writer.write_u8(2)
        Integer(bits, is_signed):
            writer.write_u8(3)
            try write_width(writer, bits, "integer")
            writer.write_bool(is_signed)
        Floating(bits):
            writer.write_u8(4)
            try write_width(writer, bits, "floating-point")
        Character: writer.write_u8(5)
        String: writer.write_u8(6)
        Bytes: writer.write_u8(7)
        ErrorCode: writer.write_u8(8)
        Error: writer.write_u8(9)
        Slice(element):
            writer.write_u8(10)
            write_type_id(writer, element)
        MutableSlice(element):
            writer.write_u8(11)
            write_type_id(writer, element)
        List(element):
            writer.write_u8(12)
            write_type_id(writer, element)
        Map(key, value):
            writer.write_u8(13)
            write_type_id(writer, key)
            write_type_id(writer, value)
        Set(element):
            writer.write_u8(14)
            write_type_id(writer, element)
        Weak(value):
            writer.write_u8(15)
            write_type_id(writer, value)
        Range(element):
            writer.write_u8(16)
            write_type_id(writer, element)
        Array(element, count):
            writer.write_u8(17)
            write_type_id(writer, element)
            writer.write_i64(count)
        Optional(value):
            writer.write_u8(18)
            write_type_id(writer, value)
        Fallible(value):
            writer.write_u8(19)
            write_type_id(writer, value)
        Tuple(elements):
            writer.write_u8(20)
            try write_type_ids(writer, elements)
        Function(parameters, result):
            writer.write_u8(21)
            try write_type_ids(writer, parameters)
            write_type_id(writer, result)
        CFunction(parameters, result):
            writer.write_u8(22)
            try write_type_ids(writer, parameters)
            write_type_id(writer, result)
        Foreign: writer.write_u8(23)
        NativePointer(pointee, is_mutable):
            writer.write_u8(24)
            write_type_id(writer, pointee)
            writer.write_bool(is_mutable)
        TypeParameter(generic, position):
            writer.write_u8(25)
            writer.write_u32(generic)
            writer.write_u32(position)
        Interface(index, arguments):
            writer.write_u8(26)
            try write_index(writer, index, "interface")
            try write_type_ids(writer, arguments)
        Struct(index, arguments):
            writer.write_u8(27)
            try write_index(writer, index, "struct")
            try write_type_ids(writer, arguments)
        Class(index, arguments):
            writer.write_u8(28)
            try write_index(writer, index, "class")
            try write_type_ids(writer, arguments)
        Enum(index, arguments):
            writer.write_u8(29)
            try write_index(writer, index, "enum")
            try write_type_ids(writer, arguments)
        Extern(index):
            writer.write_u8(30)
            try write_index(writer, index, "extern type")
        Task(result):
            writer.write_u8(31)
            write_type_id(writer, result)
        FrozenList(element):
            writer.write_u8(32)
            write_type_id(writer, element)
        FrozenMap(key, value):
            writer.write_u8(33)
            write_type_id(writer, key)
            write_type_id(writer, value)
        FrozenSet(element):
            writer.write_u8(34)
            write_type_id(writer, element)
        PointerInteger(is_signed):
            writer.write_u8(35)
            writer.write_bool(is_signed)
        Pointer(pointee, is_const, is_volatile):
            writer.write_u8(36)
            write_type_id(writer, pointee)
            writer.write_bool(is_const)
            writer.write_bool(is_volatile)
        Span(element, is_const):
            writer.write_u8(37)
            write_type_id(writer, element)
            writer.write_bool(is_const)
        StringView: writer.write_u8(38)
        Atomic(inner):
            writer.write_u8(39)
            write_type_id(writer, inner)

func read_type_form(reader: PackageReader) -> TypeForm!:
    let tag = try reader.read_u8()
    if tag == 0: return TypeForm.Unit
    if tag == 1: return TypeForm.Boolean
    if tag == 2: return TypeForm.Never
    if tag == 3:
        return TypeForm.Integer(bits = try read_width(reader, "integer"), is_signed = try reader.read_bool())
    if tag == 35: return TypeForm.PointerInteger(is_signed = try reader.read_bool())
    if tag == 36: return TypeForm.Pointer(pointee = try read_type_id(reader), is_const = try reader.read_bool(), is_volatile = try reader.read_bool())
    if tag == 37: return TypeForm.Span(element = try read_type_id(reader), is_const = try reader.read_bool())
    if tag == 38: return TypeForm.StringView
    if tag == 39: return TypeForm.Atomic(inner = try read_type_id(reader))
    if tag == 4: return TypeForm.Floating(bits = try read_width(reader, "floating-point"))
    if tag == 5: return TypeForm.Character
    if tag == 6: return TypeForm.String
    if tag == 7: return TypeForm.Bytes
    if tag == 8: return TypeForm.ErrorCode
    if tag == 9: return TypeForm.Error
    if tag == 10: return TypeForm.Slice(element = try read_type_id(reader))
    if tag == 11: return TypeForm.MutableSlice(element = try read_type_id(reader))
    if tag == 12: return TypeForm.List(element = try read_type_id(reader))
    if tag == 13: return TypeForm.Map(key = try read_type_id(reader), value = try read_type_id(reader))
    if tag == 14: return TypeForm.Set(element = try read_type_id(reader))
    if tag == 15: return TypeForm.Weak(value = try read_type_id(reader))
    if tag == 16: return TypeForm.Range(element = try read_type_id(reader))
    if tag == 17:
        let element = try read_type_id(reader)
        let count = try reader.read_i64()
        if count < 0: error("typed package artifact: array count must not be negative")
        return TypeForm.Array(element = element, count = count)
    if tag == 18: return TypeForm.Optional(value = try read_type_id(reader))
    if tag == 19: return TypeForm.Fallible(value = try read_type_id(reader))
    if tag == 20: return TypeForm.Tuple(elements = try read_type_ids(reader))
    if tag == 21:
        return TypeForm.Function(parameters = try read_type_ids(reader), result = try read_type_id(reader))
    if tag == 22:
        return TypeForm.CFunction(parameters = try read_type_ids(reader), result = try read_type_id(reader))
    if tag == 23: return TypeForm.Foreign
    if tag == 24:
        return TypeForm.NativePointer(pointee = try read_type_id(reader), is_mutable = try reader.read_bool())
    if tag == 25:
        return TypeForm.TypeParameter(generic = try reader.read_u32(), position = try reader.read_u32())
    if tag == 26:
        return TypeForm.Interface(index = i64(try reader.read_u32()), arguments = try read_type_ids(reader))
    if tag == 27:
        return TypeForm.Struct(index = i64(try reader.read_u32()), arguments = try read_type_ids(reader))
    if tag == 28:
        return TypeForm.Class(index = i64(try reader.read_u32()), arguments = try read_type_ids(reader))
    if tag == 29:
        return TypeForm.Enum(index = i64(try reader.read_u32()), arguments = try read_type_ids(reader))
    if tag == 30: return TypeForm.Extern(index = i64(try reader.read_u32()))
    if tag == 31: return TypeForm.Task(result = try read_type_id(reader))
    if tag == 32: return TypeForm.FrozenList(element = try read_type_id(reader))
    if tag == 33: return TypeForm.FrozenMap(key = try read_type_id(reader), value = try read_type_id(reader))
    if tag == 34: return TypeForm.FrozenSet(element = try read_type_id(reader))
    error("typed package artifact: unknown HIR type tag " + str(u64(tag)))

# mark: Scalar fields ==========================================================================

func write_width(writer: PackageWriter, bits: i64, family: str) -> !:
    if bits < 0 or bits > 255:
        error("typed package artifact: invalid " + family + " width " + str(bits))
    writer.write_u8(u8(bits))

func read_width(reader: PackageReader, family: str) -> i64!:
    let bits = i64(try reader.read_u8())
    if family == "integer" and bits != 8 and bits != 16 and bits != 32 and bits != 64:
        error("typed package artifact: invalid integer width " + str(bits))
    if family == "floating-point" and bits != 16 and bits != 32 and bits != 64:
        error("typed package artifact: invalid floating-point width " + str(bits))
    return bits

func write_index(writer: PackageWriter, value: i64, family: str) -> !:
    if value < 0 or u64(value) > u64(4294967295):
        error("typed package artifact: invalid " + family + " index " + str(value))
    writer.write_u32(u32(value))

# mark: Semantic validation ====================================================================

## Reject malformed or noncanonical graphs both before encoding and after
## decoding. The later package verifier additionally checks nominal indices
## against their declaration tables once those tables have been decoded.
pub func validate_type_table(types: TypeTable) -> !:
    let builtins = create_builtin_type_table()
    if len(types.definitions) < len(builtins.definitions):
        error("typed package artifact: HIR type table is missing canonical builtins")
    for index in range(0, len(types.definitions)):
        let definition = types.definitions[index]
        if definition.id.value != u32(index):
            error("typed package artifact: HIR TypeId does not match its table position")
        if len(definition.name) == 0:
            error("typed package artifact: HIR type diagnostic name must not be empty")
        for previous in range(0, index):
            if type_forms_match(types.definitions[previous].form, definition.form):
                error("typed package artifact: HIR type table contains a duplicate structural type")
        try validate_type_form(definition.form, len(types.definitions))
        if index < len(builtins.definitions):
            let expected = builtins.definitions[index]
            if definition.name != expected.name or not type_forms_match(definition.form, expected.form):
                error("typed package artifact: canonical builtin HIR type prefix does not match this compiler")

func validate_type_form(form: TypeForm, type_count: i64) -> !:
    match form:
        Unit, Boolean, Never, Character, String, Bytes, ErrorCode, Error, Foreign, StringView: pass
        Atomic(inner): try validate_type_id(inner, type_count)
        PointerInteger(is_signed): pass
        Integer(bits, is_signed):
            if bits != 8 and bits != 16 and bits != 32 and bits != 64:
                error("typed package artifact: invalid integer width " + str(bits))
        Floating(bits):
            if bits != 16 and bits != 32 and bits != 64:
                error("typed package artifact: invalid floating-point width " + str(bits))
        Slice(element): try validate_type_id(element, type_count)
        MutableSlice(element): try validate_type_id(element, type_count)
        List(element): try validate_type_id(element, type_count)
        Set(element): try validate_type_id(element, type_count)
        Weak(element): try validate_type_id(element, type_count)
        Range(element): try validate_type_id(element, type_count)
        Optional(element): try validate_type_id(element, type_count)
        Fallible(element): try validate_type_id(element, type_count)
        Task(result): try validate_type_id(result, type_count)
        FrozenList(element): try validate_type_id(element, type_count)
        FrozenSet(element): try validate_type_id(element, type_count)
        FrozenMap(key, value):
            try validate_type_id(key, type_count)
            try validate_type_id(value, type_count)
        Map(key, value):
            try validate_type_id(key, type_count)
            try validate_type_id(value, type_count)
        Array(element, count):
            try validate_type_id(element, type_count)
            if count < 0: error("typed package artifact: array count must not be negative")
        Tuple(elements): try validate_type_ids(elements, type_count)
        Function(parameters, result):
            try validate_type_ids(parameters, type_count)
            try validate_type_id(result, type_count)
        CFunction(parameters, result):
            try validate_type_ids(parameters, type_count)
            try validate_type_id(result, type_count)
        NativePointer(pointee, is_mutable): try validate_type_id(pointee, type_count)
        Pointer(pointee, is_const, is_volatile): try validate_type_id(pointee, type_count)
        Span(element, is_const): try validate_type_id(element, type_count)
        TypeParameter(generic, position): pass
        Interface(index, arguments):
            if index < 0 or u64(index) > u64(4294967295):
                error("typed package artifact: nominal HIR type has an invalid declaration index")
            try validate_type_ids(arguments, type_count)
        Struct(index, arguments):
            if index < 0 or u64(index) > u64(4294967295):
                error("typed package artifact: nominal HIR type has an invalid declaration index")
            try validate_type_ids(arguments, type_count)
        Class(index, arguments):
            if index < 0 or u64(index) > u64(4294967295):
                error("typed package artifact: nominal HIR type has an invalid declaration index")
            try validate_type_ids(arguments, type_count)
        Enum(index, arguments):
            if index < 0 or u64(index) > u64(4294967295):
                error("typed package artifact: nominal HIR type has an invalid declaration index")
            try validate_type_ids(arguments, type_count)
        Extern(index):
            if index < 0 or u64(index) > u64(4294967295):
                error("typed package artifact: extern HIR type has an invalid declaration index")

func validate_type_ids(values: list[TypeId], type_count: i64) -> !:
    for value in values: try validate_type_id(value, type_count)

func validate_type_id(value: TypeId, type_count: i64) -> !:
    if i64(value.value) >= type_count:
        error("typed package artifact: HIR type references a missing TypeId")
