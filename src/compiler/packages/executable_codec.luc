#==============================================================================================
#
#   package_executable_codec - Program-owned HIR declarations and callable bodies
#
#   DESCRIPTION:
#       Serializes the exact non-nominal declaration tables that share one
#       executable HIR arena: constants, C boundary declarations, sealed
#       globals/services, closures, concrete generic provenance, and ordinary
#       functions. The arena itself is owned by the enclosing program codec.
#
#==============================================================================================

from compiler.hir.ir import HirConstant, HirExternRepresentation, HirExternType
from compiler.hir.ir import HirExternVariable, HirFunction, HirGenericInstance, HirGlobal, HirRuntimeBinding
from compiler.hir.ir import HirClosure, HirSymbol, ModuleId, SymbolId, SymbolKind, TypeTable
from compiler.hir.ir import no_node
from compiler.packages.body_codec import read_hir_closure, write_hir_closure
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.function_codec import HirFunctionValidationContext
from compiler.packages.function_codec import read_hir_functions, validate_hir_functions, write_hir_functions
from compiler.packages.hir_fields import read_documentation, read_module_id, read_node_id, read_optional_u32
from compiler.packages.hir_fields import read_span, read_symbol_id, read_type_id, read_type_ids
from compiler.packages.hir_fields import validate_module_id, validate_optional_node_id, validate_optional_symbol_id
from compiler.packages.hir_fields import validate_symbol_id, validate_type_id
from compiler.packages.hir_fields import write_documentation, write_module_id, write_node_id, write_optional_u32
from compiler.packages.hir_fields import write_span, write_symbol_id, write_type_id, write_type_ids
from compiler.runtime_contract import RuntimeService

pub struct HirExecutableTables:
    pub let runtime_bindings: list[HirRuntimeBinding]
    pub let constants: list[HirConstant]
    pub let extern_types: list[HirExternType]
    pub let extern_variables: list[HirExternVariable]
    pub let globals: list[HirGlobal]
    pub let closures: list[HirClosure]
    pub let shared_cells: list[SymbolId]
    pub let generic_instances: list[HirGenericInstance]
    pub let generic_specialization_budget: i64
    pub let functions: list[HirFunction]

pub struct HirExecutableValidationContext:
    pub let types: TypeTable
    pub let symbols: list[HirSymbol]
    pub let module_count: i64
    pub let node_count: i64
    pub let extra_count: i64
    pub let generic_count: i64

# mark: Public codec ===========================================================================

pub func write_executable_tables(writer: PackageWriter, tables: HirExecutableTables) -> !:
    try writer.write_count(len(tables.runtime_bindings))
    for value in tables.runtime_bindings:
        write_runtime_service(writer, value.service)
        write_symbol_id(writer, value.function)

    try writer.write_count(len(tables.constants))
    for value in tables.constants: try write_constant(writer, value)
    try writer.write_count(len(tables.extern_types))
    for value in tables.extern_types: try write_extern_type(writer, value)
    try writer.write_count(len(tables.extern_variables))
    for value in tables.extern_variables: try write_extern_variable(writer, value)
    try writer.write_count(len(tables.globals))
    for value in tables.globals: try write_global(writer, value)
    try writer.write_count(len(tables.closures))
    for value in tables.closures: try write_hir_closure(writer, value)
    try writer.write_count(len(tables.shared_cells))
    for value in tables.shared_cells: write_symbol_id(writer, value)
    try writer.write_count(len(tables.generic_instances))
    for value in tables.generic_instances: try write_generic_instance(writer, value)
    writer.write_i64(tables.generic_specialization_budget)
    try write_hir_functions(writer, tables.functions)

pub func read_executable_tables(reader: PackageReader) -> HirExecutableTables!:
    let runtime_bindings = list[HirRuntimeBinding]()
    let runtime_count = try reader.read_count()
    for index in range(0, runtime_count):
        runtime_bindings.append(HirRuntimeBinding(
            service = try read_runtime_service(reader),
            function = try read_symbol_id(reader),
        ))

    let constants = list[HirConstant]()
    let constant_count = try reader.read_count()
    for index in range(0, constant_count): constants.append(try read_constant(reader))
    let extern_types = list[HirExternType]()
    let extern_type_count = try reader.read_count()
    for index in range(0, extern_type_count): extern_types.append(try read_extern_type(reader))
    let extern_variables = list[HirExternVariable]()
    let extern_variable_count = try reader.read_count()
    for index in range(0, extern_variable_count): extern_variables.append(try read_extern_variable(reader))
    let globals = list[HirGlobal]()
    let global_count = try reader.read_count()
    for index in range(0, global_count): globals.append(try read_global(reader))
    let closures = list[HirClosure]()
    let closure_count = try reader.read_count()
    for index in range(0, closure_count): closures.append(try read_hir_closure(reader))
    let shared_cells = list[SymbolId]()
    let shared_count = try reader.read_count()
    for index in range(0, shared_count): shared_cells.append(try read_symbol_id(reader))
    let generic_instances = list[HirGenericInstance]()
    let instance_count = try reader.read_count()
    for index in range(0, instance_count): generic_instances.append(try read_generic_instance(reader))
    let budget = try reader.read_i64()
    return HirExecutableTables(
        runtime_bindings = runtime_bindings,
        constants = constants,
        extern_types = extern_types,
        extern_variables = extern_variables,
        globals = globals,
        closures = closures,
        shared_cells = shared_cells,
        generic_instances = generic_instances,
        generic_specialization_budget = budget,
        functions = try read_hir_functions(reader),
    )

# mark: Declaration records ====================================================================

func write_constant(writer: PackageWriter, value: HirConstant) -> !:
    write_symbol_id(writer, value.symbol)
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    write_node_id(writer, value.value)

func read_constant(reader: PackageReader) -> HirConstant!:
    return HirConstant(
        symbol = try read_symbol_id(reader), module = try read_module_id(reader),
        name = try reader.read_text(), is_public = try reader.read_bool(),
        value = try read_node_id(reader),
    )

func write_extern_type(writer: PackageWriter, value: HirExternType) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    match value.representation:
        Pointer: writer.write_u8(0)
        Integer(value_type):
            writer.write_u8(1)
            write_type_id(writer, value_type)
    write_span(writer, value.span)

func read_extern_type(reader: PackageReader) -> HirExternType!:
    let module = try read_module_id(reader)
    let name = try reader.read_text()
    let is_public = try reader.read_bool()
    let documentation = try read_documentation(reader)
    let tag = try reader.read_u8()
    var representation = HirExternRepresentation.Pointer
    if tag == 1:
        representation = HirExternRepresentation.Integer(value_type = try read_type_id(reader))
    elif tag != 0:
        error("typed package artifact: unknown HIR extern representation tag " + str(u64(tag)))
    return HirExternType(
        module = module, name = name, is_public = is_public,
        documentation = documentation, representation = representation,
        span = try read_span(reader),
    )

func write_extern_variable(writer: PackageWriter, value: HirExternVariable) -> !:
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    write_type_id(writer, value.value_type)
    write_span(writer, value.span)

func read_extern_variable(reader: PackageReader) -> HirExternVariable!:
    return HirExternVariable(
        module = try read_module_id(reader), name = try reader.read_text(),
        is_public = try reader.read_bool(), documentation = try read_documentation(reader),
        value_type = try read_type_id(reader), span = try read_span(reader),
    )

func write_global(writer: PackageWriter, value: HirGlobal) -> !:
    write_symbol_id(writer, value.symbol)
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    write_type_id(writer, value.value_type)
    write_span(writer, value.span)

func read_global(reader: PackageReader) -> HirGlobal!:
    return HirGlobal(
        symbol = try read_symbol_id(reader), module = try read_module_id(reader),
        name = try reader.read_text(), value_type = try read_type_id(reader),
        span = try read_span(reader),
    )

func write_generic_instance(writer: PackageWriter, value: HirGenericInstance) -> !:
    writer.write_u32(value.generic)
    write_symbol_id(writer, value.function)
    try write_type_ids(writer, value.arguments)
    write_module_id(writer, value.origin_module)
    write_span(writer, value.origin_span)
    write_optional_u32(writer, value.parent)
    writer.write_u32(value.checked_nodes)
    writer.write_i64(value.check_time_ms)

func read_generic_instance(reader: PackageReader) -> HirGenericInstance!:
    return HirGenericInstance(
        generic = try reader.read_u32(),
        function = try read_symbol_id(reader),
        arguments = try read_type_ids(reader),
        origin_module = try read_module_id(reader),
        origin_span = try read_span(reader),
        parent = try read_optional_u32(reader),
        checked_nodes = try reader.read_u32(),
        check_time_ms = try reader.read_i64(),
    )

# mark: Semantic validation ====================================================================

pub func validate_executable_tables(tables: HirExecutableTables, context: HirExecutableValidationContext) -> !:
    if tables.generic_specialization_budget <= 0:
        error("typed package artifact: generic specialization budget must be positive")
    for index in range(0, len(tables.runtime_bindings)):
        let value = tables.runtime_bindings[index]
        try require_symbol_kind(value.function, SymbolKind.function, context.symbols)
        for previous in range(0, index):
            if tables.runtime_bindings[previous].service == value.service:
                error("typed package artifact: duplicate HIR runtime service binding")

    for value in tables.constants:
        try validate_named_symbol(value.symbol, value.module, value.name, SymbolKind.constant, context)
        if value.value.value == no_node:
            error("typed package artifact: HIR constant has no initializer")
        try validate_optional_node_id(value.value, context.node_count)
    try validate_extern_types(tables.extern_types, context)
    for value in tables.extern_variables:
        try validate_named_declaration(value.module, value.name, context.module_count)
        try validate_type_id(value.value_type, len(context.types.definitions))
    for value in tables.globals:
        try validate_named_symbol(value.symbol, value.module, value.name, SymbolKind.global, context)
        try validate_type_id(value.value_type, len(context.types.definitions))

    for index in range(0, len(tables.closures)):
        let closure = tables.closures[index]
        try require_symbol_kind(closure.function, SymbolKind.function, context.symbols)
        for capture in closure.captures:
            try validate_symbol_id(capture.symbol, len(context.symbols))
            try validate_optional_symbol_id(capture.source, len(context.symbols))
            try validate_type_id(capture.value_type, len(context.types.definitions))
    for index in range(0, len(tables.shared_cells)):
        try validate_symbol_id(tables.shared_cells[index], len(context.symbols))
        for previous in range(0, index):
            if tables.shared_cells[previous].value == tables.shared_cells[index].value:
                error("typed package artifact: duplicate HIR shared cell")

    for index in range(0, len(tables.generic_instances)):
        let value = tables.generic_instances[index]
        if i64(value.generic) >= context.generic_count:
            error("typed package artifact: concrete generic instance references a missing declaration")
        try require_symbol_kind(value.function, SymbolKind.function, context.symbols)
        for argument in value.arguments: try validate_type_id(argument, len(context.types.definitions))
        try validate_module_id(value.origin_module, context.module_count)
        let parent = value.parent
        if parent != none:
            if i64(parent) >= index:
                error("typed package artifact: concrete generic instance parent does not precede it")
        if value.check_time_ms < 0:
            error("typed package artifact: concrete generic instance has negative check time")

    let function_context = HirFunctionValidationContext(
        types = context.types,
        module_count = context.module_count,
        symbol_count = len(context.symbols),
        node_count = context.node_count,
        extra_count = context.extra_count,
        closure_count = len(tables.closures),
    )
    try validate_hir_functions(tables.functions, function_context)
    for index in range(0, len(tables.functions)):
        let function = tables.functions[index]
        try require_symbol_kind(function.symbol, SymbolKind.function, context.symbols)
        for previous in range(0, index):
            if tables.functions[previous].symbol.value == function.symbol.value:
                error("typed package artifact: duplicate HIR function symbol")
        let closure = function.closure
        if closure != none:
            if tables.closures[closure].function.value != function.symbol.value:
                error("typed package artifact: HIR function does not match its closure")
    for closure in tables.closures:
        var found = false
        for function in tables.functions:
            if function.symbol.value == closure.function.value: found = true
        if not found: error("typed package artifact: HIR closure has no function body")

func validate_extern_types(values: list[HirExternType], context: HirExecutableValidationContext) -> !:
    for value in values:
        try validate_named_declaration(value.module, value.name, context.module_count)
        match value.representation:
            Pointer: pass
            Integer(value_type):
                try validate_type_id(value_type, len(context.types.definitions))
                match context.types.definitions[value_type.value].form:
                    Integer(bits, is_signed): pass
                    else: error("typed package artifact: integer extern representation is not an integer type")
    let seen = list[bool]()
    for value in values: seen.append(false)
    for definition in context.types.definitions:
        match definition.form:
            Extern(index):
                if index < 0 or index >= len(values):
                    error("typed package artifact: HIR extern type references a missing declaration")
                if seen[index]:
                    error("typed package artifact: duplicate HIR extern type application")
                seen[index] = true
            else: pass
    for value in seen:
        if not value: error("typed package artifact: HIR extern declaration has no TypeId")

func validate_named_symbol(
    symbol: SymbolId,
    module: ModuleId,
    name: str,
    kind: SymbolKind,
    context: HirExecutableValidationContext,
) -> !:
    try validate_named_declaration(module, name, context.module_count)
    try require_symbol_kind(symbol, kind, context.symbols)
    if context.symbols[symbol.value].name != name:
        error("typed package artifact: HIR declaration name does not match its symbol")

func validate_named_declaration(module: ModuleId, name: str, module_count: i64) -> !:
    try validate_module_id(module, module_count)
    if len(name) == 0: error("typed package artifact: HIR declaration name must not be empty")

func require_symbol_kind(symbol: SymbolId, kind: SymbolKind, symbols: list[HirSymbol]) -> !:
    try validate_symbol_id(symbol, len(symbols))
    if symbols[symbol.value].kind != kind:
        error("typed package artifact: HIR declaration symbol has the wrong kind")

# mark: Runtime service wire tags ===============================================================

func write_runtime_service(writer: PackageWriter, value: RuntimeService):
    match value:
        storage_allocator: writer.write_u8(0)
        storage_deallocator: writer.write_u8(1)
        equality_context_create: writer.write_u8(2)
        equality_context_release: writer.write_u8(3)
        equality_context_visit: writer.write_u8(4)
        hash_create: writer.write_u8(5)
        hash_retain: writer.write_u8(6)
        hash_release: writer.write_u8(7)
        hash_copy: writer.write_u8(8)
        hash_length: writer.write_u8(9)
        hash_iteration_begin: writer.write_u8(10)
        hash_iteration_end: writer.write_u8(11)
        hash_find_first: writer.write_u8(12)
        hash_find_next: writer.write_u8(13)
        hash_key_address: writer.write_u8(14)
        hash_value_address: writer.write_u8(15)
        hash_insert_entry: writer.write_u8(16)
        hash_remove_entry: writer.write_u8(17)
        hash_clear: writer.write_u8(18)
        hash_reserve: writer.write_u8(19)
        list_create: writer.write_u8(20)
        list_retain: writer.write_u8(21)
        list_release: writer.write_u8(22)
        list_copy: writer.write_u8(23)
        list_concat: writer.write_u8(24)
        list_length: writer.write_u8(25)
        list_iteration_begin: writer.write_u8(26)
        list_iteration_end: writer.write_u8(27)
        list_mutable_slice_begin: writer.write_u8(28)
        list_iteration_active: writer.write_u8(29)
        list_append_slot: writer.write_u8(30)
        list_insert_slot: writer.write_u8(31)
        list_remove_at: writer.write_u8(32)
        list_clear: writer.write_u8(33)
        list_reserve: writer.write_u8(34)
        list_element_address: writer.write_u8(35)
        list_mutable_element_address: writer.write_u8(36)
        list_slice: writer.write_u8(37)
        buffer_retain: writer.write_u8(38)
        buffer_release: writer.write_u8(39)
        buffer_concat: writer.write_u8(40)
        buffer_data: writer.write_u8(41)
        buffer_length: writer.write_u8(42)
        buffer_builder_create: writer.write_u8(43)
        buffer_builder_append: writer.write_u8(44)
        buffer_builder_finish: writer.write_u8(45)
        c_string_copy: writer.write_u8(46)
        display_signed: writer.write_u8(47)
        display_unsigned: writer.write_u8(48)
        display_float32: writer.write_u8(49)
        display_float64: writer.write_u8(50)
        display_character: writer.write_u8(51)
        display_boolean: writer.write_u8(52)
        string_scalar_count: writer.write_u8(53)
        string_decode: writer.write_u8(54)
        bytes_slice: writer.write_u8(55)
        slice_retain: writer.write_u8(56)
        slice_release: writer.write_u8(57)
        slice_length: writer.write_u8(58)
        slice_element_address: writer.write_u8(59)
        class_create: writer.write_u8(60)
        class_mark_initialized: writer.write_u8(61)
        class_retain: writer.write_u8(62)
        class_release: writer.write_u8(63)
        class_payload: writer.write_u8(64)
        weak_class_create: writer.write_u8(65)
        weak_class_retain: writer.write_u8(66)
        weak_class_release: writer.write_u8(67)
        weak_class_promote: writer.write_u8(68)
        interface_create: writer.write_u8(69)
        interface_retain: writer.write_u8(70)
        interface_release: writer.write_u8(71)
        interface_detach: writer.write_u8(72)
        interface_payload: writer.write_u8(73)
        interface_witness: writer.write_u8(74)

func read_runtime_service(reader: PackageReader) -> RuntimeService!:
    let tag = try reader.read_u8()
    if tag == 0: return RuntimeService.storage_allocator
    if tag == 1: return RuntimeService.storage_deallocator
    if tag == 2: return RuntimeService.equality_context_create
    if tag == 3: return RuntimeService.equality_context_release
    if tag == 4: return RuntimeService.equality_context_visit
    if tag == 5: return RuntimeService.hash_create
    if tag == 6: return RuntimeService.hash_retain
    if tag == 7: return RuntimeService.hash_release
    if tag == 8: return RuntimeService.hash_copy
    if tag == 9: return RuntimeService.hash_length
    if tag == 10: return RuntimeService.hash_iteration_begin
    if tag == 11: return RuntimeService.hash_iteration_end
    if tag == 12: return RuntimeService.hash_find_first
    if tag == 13: return RuntimeService.hash_find_next
    if tag == 14: return RuntimeService.hash_key_address
    if tag == 15: return RuntimeService.hash_value_address
    if tag == 16: return RuntimeService.hash_insert_entry
    if tag == 17: return RuntimeService.hash_remove_entry
    if tag == 18: return RuntimeService.hash_clear
    if tag == 19: return RuntimeService.hash_reserve
    if tag == 20: return RuntimeService.list_create
    if tag == 21: return RuntimeService.list_retain
    if tag == 22: return RuntimeService.list_release
    if tag == 23: return RuntimeService.list_copy
    if tag == 24: return RuntimeService.list_concat
    if tag == 25: return RuntimeService.list_length
    if tag == 26: return RuntimeService.list_iteration_begin
    if tag == 27: return RuntimeService.list_iteration_end
    if tag == 28: return RuntimeService.list_mutable_slice_begin
    if tag == 29: return RuntimeService.list_iteration_active
    if tag == 30: return RuntimeService.list_append_slot
    if tag == 31: return RuntimeService.list_insert_slot
    if tag == 32: return RuntimeService.list_remove_at
    if tag == 33: return RuntimeService.list_clear
    if tag == 34: return RuntimeService.list_reserve
    if tag == 35: return RuntimeService.list_element_address
    if tag == 36: return RuntimeService.list_mutable_element_address
    if tag == 37: return RuntimeService.list_slice
    if tag == 38: return RuntimeService.buffer_retain
    if tag == 39: return RuntimeService.buffer_release
    if tag == 40: return RuntimeService.buffer_concat
    if tag == 41: return RuntimeService.buffer_data
    if tag == 42: return RuntimeService.buffer_length
    if tag == 43: return RuntimeService.buffer_builder_create
    if tag == 44: return RuntimeService.buffer_builder_append
    if tag == 45: return RuntimeService.buffer_builder_finish
    if tag == 46: return RuntimeService.c_string_copy
    if tag == 47: return RuntimeService.display_signed
    if tag == 48: return RuntimeService.display_unsigned
    if tag == 49: return RuntimeService.display_float32
    if tag == 50: return RuntimeService.display_float64
    if tag == 51: return RuntimeService.display_character
    if tag == 52: return RuntimeService.display_boolean
    if tag == 53: return RuntimeService.string_scalar_count
    if tag == 54: return RuntimeService.string_decode
    if tag == 55: return RuntimeService.bytes_slice
    if tag == 56: return RuntimeService.slice_retain
    if tag == 57: return RuntimeService.slice_release
    if tag == 58: return RuntimeService.slice_length
    if tag == 59: return RuntimeService.slice_element_address
    if tag == 60: return RuntimeService.class_create
    if tag == 61: return RuntimeService.class_mark_initialized
    if tag == 62: return RuntimeService.class_retain
    if tag == 63: return RuntimeService.class_release
    if tag == 64: return RuntimeService.class_payload
    if tag == 65: return RuntimeService.weak_class_create
    if tag == 66: return RuntimeService.weak_class_retain
    if tag == 67: return RuntimeService.weak_class_release
    if tag == 68: return RuntimeService.weak_class_promote
    if tag == 69: return RuntimeService.interface_create
    if tag == 70: return RuntimeService.interface_retain
    if tag == 71: return RuntimeService.interface_release
    if tag == 72: return RuntimeService.interface_detach
    if tag == 73: return RuntimeService.interface_payload
    if tag == 74: return RuntimeService.interface_witness
    error("typed package artifact: unknown HIR runtime service tag " + str(u64(tag)))
