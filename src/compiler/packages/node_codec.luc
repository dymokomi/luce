func write_layout_query(writer: PackageWriter, value: LayoutQuery):
    match value:
        size: writer.write_u8(0)
        align: writer.write_u8(1)
        offset: writer.write_u8(2)

func read_layout_query(reader: PackageReader) -> LayoutQuery!:
    let tag = try reader.read_u8()
    if tag == 0: return LayoutQuery.size
    if tag == 1: return LayoutQuery.align
    if tag == 2: return LayoutQuery.offset
    error("typed package artifact: invalid layout query " + str(tag))

func node1(form: HirNodeForm) -> HirNode:
    return HirNode(form = form)

# mark: Nested semantic tags ==================================================================

func write_iteration(writer: PackageWriter, value: HirIteration):
    match value:
        Builtin(item):
            writer.write_u8(0)
            write_node_id(writer, item)
        Protocol(symbol, iterator, next):
            writer.write_u8(1)
            write_symbol_id(writer, symbol)
            write_node_id(writer, iterator)
            write_node_id(writer, next)

func read_iteration(reader: PackageReader) -> HirIteration!:
    let tag = try reader.read_u8()
    if tag == 0: return HirIteration.Builtin(value = try read_node_id(reader))
    if tag == 1: return HirIteration.Protocol(iterator_symbol = try read_symbol_id(reader), iterator = try read_node_id(reader), next = try read_node_id(reader))
    error("typed package artifact: unknown retained HIR iteration tag " + str(u64(tag)))

func write_assignment(writer: PackageWriter, value: AssignmentOperation) -> !:
    match value:
        Replace: writer.write_u8(0)
        Combine(operation):
            writer.write_u8(1)
            try write_binary(writer, operation)

func read_assignment(reader: PackageReader) -> AssignmentOperation!:
    let tag = try reader.read_u8()
    if tag == 0: return AssignmentOperation.Replace
    if tag == 1: return AssignmentOperation.Combine(operation = try read_binary(reader))
    error("typed package artifact: unknown retained HIR assignment tag " + str(u64(tag)))

func write_unary(writer: PackageWriter, value: UnaryOperation) -> !:
    match value:
        LogicalNot: writer.write_u8(0)
        NumericIdentity(operand_type):
            writer.write_u8(1)
            write_type_id(writer, operand_type)
        NumericNegate(operand_type):
            writer.write_u8(2)
            write_type_id(writer, operand_type)
        IntegerBitwiseNot(operand_type):
            writer.write_u8(3)
            write_type_id(writer, operand_type)
        WrapNegate(operand_type):
            writer.write_u8(4)
            write_type_id(writer, operand_type)

func read_unary(reader: PackageReader) -> UnaryOperation!:
    let tag = try reader.read_u8()
    if tag == 0: return UnaryOperation.LogicalNot
    if tag == 1: return UnaryOperation.NumericIdentity(operand_type = try read_type_id(reader))
    if tag == 2: return UnaryOperation.NumericNegate(operand_type = try read_type_id(reader))
    if tag == 3: return UnaryOperation.IntegerBitwiseNot(operand_type = try read_type_id(reader))
    if tag == 4: return UnaryOperation.WrapNegate(operand_type = try read_type_id(reader))
    error("typed package artifact: unknown retained HIR unary-operation tag " + str(u64(tag)))

func write_binary(writer: PackageWriter, value: BinaryOperation) -> !:
    match value:
        LogicalAnd: writer.write_u8(0)
        LogicalOr: writer.write_u8(1)
        Equal(value_type): write_typed_binary(writer, 2, value_type)
        NotEqual(value_type): write_typed_binary(writer, 3, value_type)
        Identity(value_type): write_typed_binary(writer, 4, value_type)
        NotIdentity(value_type): write_typed_binary(writer, 5, value_type)
        Less(value_type): write_typed_binary(writer, 6, value_type)
        LessEqual(value_type): write_typed_binary(writer, 7, value_type)
        Greater(value_type): write_typed_binary(writer, 8, value_type)
        GreaterEqual(value_type): write_typed_binary(writer, 9, value_type)
        Add(value_type): write_typed_binary(writer, 10, value_type)
        Subtract(value_type): write_typed_binary(writer, 11, value_type)
        Multiply(value_type): write_typed_binary(writer, 12, value_type)
        Divide(value_type): write_typed_binary(writer, 13, value_type)
        FloorDivide(value_type): write_typed_binary(writer, 14, value_type)
        Remainder(value_type): write_typed_binary(writer, 15, value_type)
        TruncDivide(value_type): write_typed_binary(writer, 21, value_type)
        TruncRemainder(value_type): write_typed_binary(writer, 22, value_type)
        WrapAdd(value_type): write_typed_binary(writer, 23, value_type)
        WrapSubtract(value_type): write_typed_binary(writer, 24, value_type)
        WrapMultiply(value_type): write_typed_binary(writer, 25, value_type)
        SaturateAdd(value_type): write_typed_binary(writer, 26, value_type)
        SaturateSubtract(value_type): write_typed_binary(writer, 27, value_type)
        SaturateMultiply(value_type): write_typed_binary(writer, 28, value_type)
        CheckedAdd(value_type): write_typed_binary(writer, 29, value_type)
        CheckedSubtract(value_type): write_typed_binary(writer, 30, value_type)
        CheckedMultiply(value_type): write_typed_binary(writer, 31, value_type)
        BitwiseAnd(value_type): write_typed_binary(writer, 16, value_type)
        BitwiseOr(value_type): write_typed_binary(writer, 17, value_type)
        BitwiseXor(value_type): write_typed_binary(writer, 18, value_type)
        ShiftLeft(value_type): write_typed_binary(writer, 19, value_type)
        ShiftRight(value_type): write_typed_binary(writer, 20, value_type)

func write_typed_binary(writer: PackageWriter, tag: u8, value_type: TypeId):
    writer.write_u8(tag)
    write_type_id(writer, value_type)

func read_binary(reader: PackageReader) -> BinaryOperation!:
    let tag = try reader.read_u8()
    if tag == 0: return BinaryOperation.LogicalAnd
    if tag == 1: return BinaryOperation.LogicalOr
    if tag > 20:
        error("typed package artifact: unknown retained HIR binary-operation tag " + str(u64(tag)))
    let value_type = try read_type_id(reader)
    if tag == 2: return BinaryOperation.Equal(operand_type = value_type)
    if tag == 3: return BinaryOperation.NotEqual(operand_type = value_type)
    if tag == 4: return BinaryOperation.Identity(operand_type = value_type)
    if tag == 5: return BinaryOperation.NotIdentity(operand_type = value_type)
    if tag == 6: return BinaryOperation.Less(operand_type = value_type)
    if tag == 7: return BinaryOperation.LessEqual(operand_type = value_type)
    if tag == 8: return BinaryOperation.Greater(operand_type = value_type)
    if tag == 9: return BinaryOperation.GreaterEqual(operand_type = value_type)
    if tag == 10: return BinaryOperation.Add(operand_type = value_type)
    if tag == 11: return BinaryOperation.Subtract(operand_type = value_type)
    if tag == 12: return BinaryOperation.Multiply(operand_type = value_type)
    if tag == 13: return BinaryOperation.Divide(operand_type = value_type)
    if tag == 14: return BinaryOperation.FloorDivide(operand_type = value_type)
    if tag == 15: return BinaryOperation.Remainder(operand_type = value_type)
    if tag == 16: return BinaryOperation.BitwiseAnd(operand_type = value_type)
    if tag == 17: return BinaryOperation.BitwiseOr(operand_type = value_type)
    if tag == 18: return BinaryOperation.BitwiseXor(operand_type = value_type)
    if tag == 19: return BinaryOperation.ShiftLeft(operand_type = value_type)
    if tag == 20: return BinaryOperation.ShiftRight(operand_type = value_type)
    if tag == 21: return BinaryOperation.TruncDivide(operand_type = value_type)
    if tag == 22: return BinaryOperation.TruncRemainder(operand_type = value_type)
    if tag == 23: return BinaryOperation.WrapAdd(operand_type = value_type)
    if tag == 24: return BinaryOperation.WrapSubtract(operand_type = value_type)
    if tag == 25: return BinaryOperation.WrapMultiply(operand_type = value_type)
    if tag == 26: return BinaryOperation.SaturateAdd(operand_type = value_type)
    if tag == 27: return BinaryOperation.SaturateSubtract(operand_type = value_type)
    if tag == 28: return BinaryOperation.SaturateMultiply(operand_type = value_type)
    if tag == 29: return BinaryOperation.CheckedAdd(operand_type = value_type)
    if tag == 30: return BinaryOperation.CheckedSubtract(operand_type = value_type)
    if tag == 31: return BinaryOperation.CheckedMultiply(operand_type = value_type)
    trap("validated retained HIR binary-operation tag was not decoded")

func write_generic_call_kind(writer: PackageWriter, value: HirGenericCallKind):
    match value:
        function: writer.write_u8(0)
        initializer: writer.write_u8(1)

func read_generic_call_kind(reader: PackageReader) -> HirGenericCallKind!:
    let tag = try reader.read_u8()
    if tag == 0: return HirGenericCallKind.function
    if tag == 1: return HirGenericCallKind.initializer
    error("typed package artifact: unknown retained HIR generic-call kind tag " + str(u64(tag)))

# mark: Atomic encodings ======================================================================

func atomic_ordering_code(order: AtomicOrdering) -> u8:
    match order:
        relaxed: return u8(0)
        acquire: return u8(1)
        release: return u8(2)
        acq_rel: return u8(3)
        seq_cst: return u8(4)

func read_atomic_ordering(reader: PackageReader) -> AtomicOrdering!:
    let code = try reader.read_u8()
    if code == u8(0): return AtomicOrdering.relaxed
    if code == u8(1): return AtomicOrdering.acquire
    if code == u8(2): return AtomicOrdering.release
    if code == u8(3): return AtomicOrdering.acq_rel
    if code == u8(4): return AtomicOrdering.seq_cst
    error("typed package artifact: unknown atomic ordering " + str(code))

func atomic_operation_code(operation: AtomicOperation) -> u8:
    match operation:
        add: return u8(0)
        sub: return u8(1)
        or_bits: return u8(2)
        and_bits: return u8(3)
        xor_bits: return u8(4)
        swap: return u8(5)
        maximum: return u8(6)
        minimum: return u8(7)

func read_atomic_operation(reader: PackageReader) -> AtomicOperation!:
    let code = try reader.read_u8()
    if code == u8(0): return AtomicOperation.add
    if code == u8(1): return AtomicOperation.sub
    if code == u8(2): return AtomicOperation.or_bits
    if code == u8(3): return AtomicOperation.and_bits
    if code == u8(4): return AtomicOperation.xor_bits
    if code == u8(5): return AtomicOperation.swap
    if code == u8(6): return AtomicOperation.maximum
    if code == u8(7): return AtomicOperation.minimum
    error("typed package artifact: unknown atomic operation " + str(code))
