    if tag == 85: return node1(HirNodeForm.SetInsert(value = try read_node_id(reader), element = try read_node_id(reader)))
    if tag == 86: return node1(HirNodeForm.SetRemove(value = try read_node_id(reader), element = try read_node_id(reader)))
    if tag == 87: return node1(HirNodeForm.SetClear(value = try read_node_id(reader)))
    if tag == 88: return node1(HirNodeForm.SetReserve(value = try read_node_id(reader), minimum_capacity = try read_node_id(reader)))
    if tag == 89: return node1(HirNodeForm.SetCopy(value = try read_node_id(reader)))
    if tag == 90: return node1(HirNodeForm.WeakCreate(value = try read_node_id(reader)))
    if tag == 91: return node1(HirNodeForm.WeakGet(value = try read_node_id(reader)))
    if tag == 92: return node1(HirNodeForm.Element(value = try read_node_id(reader), index = try reader.read_i64()))
    if tag == 93: return node1(HirNodeForm.StructValue(struct_index = try reader.read_i64(), fields = try read_operands(reader)))
    if tag == 94: return node1(HirNodeForm.FieldAccess(value = try read_node_id(reader), field = try reader.read_i64()))
    if tag == 95: return node1(HirNodeForm.NoneLiteral)
    if tag == 96: return node1(HirNodeForm.Some(value = try read_node_id(reader)))
    if tag == 97: return node1(HirNodeForm.ElseFallback(value = try read_node_id(reader), arm = try read_node_id(reader)))
    if tag == 98: return node1(HirNodeForm.EnumValue(enum_index = try reader.read_i64(), case_index = try reader.read_i64(), payload = try read_operands(reader)))
    if tag == 99: return node1(HirNodeForm.Match(subject = try read_node_id(reader), arms = try read_operands(reader), has_result = try reader.read_bool()))
    if tag == 100: return node1(HirNodeForm.MatchArm(patterns = try read_operands(reader), statements = try read_operands(reader), value = try read_node_id(reader), guard = try read_node_id(reader)))
    if tag == 101: return node1(HirNodeForm.PatternWildcard)
    if tag == 102: return node1(HirNodeForm.PatternLiteral(value = try reader.read_u32()))
    if tag == 103: return node1(HirNodeForm.PatternRange(lower = try reader.read_u32(), upper = try reader.read_u32(), inclusive = try reader.read_bool()))
    if tag == 104: return node1(HirNodeForm.PatternCase(case_index = try reader.read_i64(), bindings = try read_operands(reader)))
