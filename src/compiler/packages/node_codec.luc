    if tag == 58: return node1(HirNodeForm.IndirectCall(callee = try read_node_id(reader), arguments = try read_operands(reader)))
    if tag == 59: return node1(HirNodeForm.Initialize(function = try read_symbol_id(reader), arguments = try read_operands(reader)))
    if tag == 60: return node1(HirNodeForm.ErrorCodeLiteral(package = try read_package_id(reader), value = try reader.read_u32()))
    if tag == 61: return node1(HirNodeForm.Raise(code = try read_node_id(reader), message = try read_node_id(reader)))
    if tag == 62: return node1(HirNodeForm.Trap(message = try read_node_id(reader)))
    if tag == 63: return node1(HirNodeForm.Assert(condition = try read_node_id(reader), message = try read_node_id(reader)))
    if tag == 64: return node1(HirNodeForm.Try(value = try read_node_id(reader)))
    if tag == 65: return node1(HirNodeForm.Catch(value = try read_node_id(reader), failure = try read_symbol_id(reader), body = try read_operands(reader)))
    if tag == 66: return node1(HirNodeForm.Tuple(elements = try read_operands(reader)))
    if tag == 67: return node1(HirNodeForm.Array(elements = try read_operands(reader)))
