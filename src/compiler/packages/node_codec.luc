#==============================================================================================
#
#   package_node_codec - Canonical wire form for one resolved HIR node
#
#   DESCRIPTION:
#       Encodes and decodes the closed `HirNodeForm` vocabulary and its
#       resolved operation tags. Arena ownership and cross-table validation
#       belong to the body validator; this module owns only the exact wire
#       spelling of one node payload.
#
#==============================================================================================

from compiler.hir.ir import AtomicOperation, AtomicOrdering, AssignmentOperation, BinaryOperation, HirGenericCallKind, HirIteration
from compiler.hir.ir import HirNode, HirNodeForm, NodeId, Operands, TypeId, UnaryOperation
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_node_id, read_operands, read_package_id
from compiler.packages.hir_fields import read_symbol_id, read_type_id, write_node_id, write_operands
from compiler.packages.hir_fields import write_package_id, write_symbol_id, write_type_id
from compiler.layout_query import LayoutQuery

# mark: Node encoding ==========================================================================

pub func write_hir_node(writer: PackageWriter, node: HirNode) -> !:
    match node.form:
        BreakStatement(levels):
            writer.write_u8(0)
            writer.write_u32(u32(levels))
        ContinueStatement(levels):
            writer.write_u8(1)
            writer.write_u32(u32(levels))
        Binding(symbol, is_mutable, value):
            writer.write_u8(2)
            write_symbol_id(writer, symbol)
            writer.write_bool(is_mutable)
            write_node_id(writer, value)
        Assignment(symbol, operation, value):
            writer.write_u8(3)
            write_symbol_id(writer, symbol)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        ExternStore(variable, operation, value):
            writer.write_u8(4)
            writer.write_u32(variable)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        GlobalStore(global, operation, value):
            writer.write_u8(5)
            writer.write_u32(global)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        PlaceAssignment(symbol, steps, operation, value):
            writer.write_u8(6)
            write_symbol_id(writer, symbol)
            write_operands(writer, steps)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        GlobalPlaceAssignment(global, steps, operation, value):
            writer.write_u8(7)
            writer.write_u32(global)
            write_operands(writer, steps)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        PrintText(value):
            writer.write_u8(8)
            try writer.write_text(value)
        PrintValue(value):
            writer.write_u8(9)
            write_node_id(writer, value)
        ReturnStatement(value):
            writer.write_u8(10)
            write_node_id(writer, value)
        RecoverStatement(value):
            writer.write_u8(11)
            write_node_id(writer, value)
        DeferStatement(action):
            writer.write_u8(12)
            write_node_id(writer, action)
        ErrorDeferStatement(action):
            writer.write_u8(129)
            write_node_id(writer, action)
        Allocate(prelude, request, initializer, count, zeroed, code, message):
            writer.write_u8(134)
            write_operands(writer, prelude)
            write_node_id(writer, request)
            write_node_id(writer, initializer)
            write_node_id(writer, count)
            writer.write_bool(zeroed)
            write_node_id(writer, code)
            write_node_id(writer, message)
        WithAllocator(global, allocator, body):
            writer.write_u8(135)
            writer.write_u32(global)
            write_node_id(writer, allocator)
            write_operands(writer, body)
        AtomicLoad(address, order):
            writer.write_u8(130)
            write_node_id(writer, address)
            writer.write_u8(atomic_ordering_code(order))
        AtomicStore(address, value, order):
            writer.write_u8(131)
            write_node_id(writer, address)
            write_node_id(writer, value)
            writer.write_u8(atomic_ordering_code(order))
        AtomicFence(order, is_signal):
            writer.write_u8(136)
            writer.write_u8(atomic_ordering_code(order))
            writer.write_bool(is_signal)
        CVariadicCall(function, arguments, extras):
            writer.write_u8(137)
            write_symbol_id(writer, function)
            write_operands(writer, arguments)
            write_operands(writer, extras)
        AtomicUpdate(operation, address, value, order):
            writer.write_u8(132)
            writer.write_u8(atomic_operation_code(operation))
            write_node_id(writer, address)
            write_node_id(writer, value)
            writer.write_u8(atomic_ordering_code(order))
        AtomicCompareExchange(address, expected, desired, success, failure, is_weak):
            writer.write_u8(133)
            write_node_id(writer, address)
            write_node_id(writer, expected)
            write_node_id(writer, desired)
            writer.write_u8(atomic_ordering_code(success))
            writer.write_u8(atomic_ordering_code(failure))
            writer.write_bool(is_weak)
        ExpressionStatement(value):
            writer.write_u8(13)
            write_node_id(writer, value)
        IfStatement(branches, has_fallback, fallback):
            writer.write_u8(14)
            write_operands(writer, branches)
            writer.write_bool(has_fallback)
            write_operands(writer, fallback)
        WhileStatement(condition, body):
            writer.write_u8(15)
            write_node_id(writer, condition)
            write_operands(writer, body)
        ForStatement(symbol, iteration, body):
            writer.write_u8(16)
            write_symbol_id(writer, symbol)
            write_iteration(writer, iteration)
            write_operands(writer, body)
        Constant(value):
            writer.write_u8(17)
            writer.write_u32(value)
        Reference(symbol):
            writer.write_u8(18)
            write_symbol_id(writer, symbol)
        ExternLoad(variable):
            writer.write_u8(19)
            writer.write_u32(variable)
        GlobalLoad(global):
            writer.write_u8(20)
            writer.write_u32(global)
        NativeLoad(pointer):
            writer.write_u8(21)
            write_node_id(writer, pointer)
        NativeStore(pointer, value):
            writer.write_u8(22)
            write_node_id(writer, pointer)
            write_node_id(writer, value)
        NativeAdvance(pointer, count):
            writer.write_u8(23)
            write_node_id(writer, pointer)
            write_node_id(writer, count)
        NativeRebind(pointer):
            writer.write_u8(24)
            write_node_id(writer, pointer)
        NativeMove(destination, source, count):
            writer.write_u8(25)
            write_node_id(writer, destination)
            write_node_id(writer, source)
            write_node_id(writer, count)
        NativeAllocate(element_type, count):
            writer.write_u8(26)
            write_type_id(writer, element_type)
            write_node_id(writer, count)
        NativeDeallocate(pointer, element_type, count):
            writer.write_u8(27)
            write_node_id(writer, pointer)
            write_type_id(writer, element_type)
            write_node_id(writer, count)
        NativeIsNull(pointer):
            writer.write_u8(28)
            write_node_id(writer, pointer)
        NativeIsSame(left, right):
            writer.write_u8(29)
            write_node_id(writer, left)
            write_node_id(writer, right)
        NativeAddressHash(pointer):
            writer.write_u8(30)
            write_node_id(writer, pointer)
        NativeFloatBits(value):
            writer.write_u8(31)
            write_node_id(writer, value)
        NativeArena(end):
            writer.write_u8(32)
            write_node_id(writer, end)
        NumericConvert(value):
            writer.write_u8(33)
            write_node_id(writer, value)
        LayoutConstant(query, subject, field):
            writer.write_u8(113)
            write_layout_query(writer, query)
            write_type_id(writer, subject)
            writer.write_i64(field)
        Cast(value):
            writer.write_u8(114)
            write_node_id(writer, value)
        PointerStore(pointer, steps, operation, value):
            writer.write_u8(115)
            write_node_id(writer, pointer)
            write_operands(writer, steps)
            try write_assignment(writer, operation)
            write_node_id(writer, value)
        AddressOf(pointer, symbol, global, steps):
            writer.write_u8(116)
            write_node_id(writer, pointer)
            write_symbol_id(writer, symbol)
            writer.write_i64(global)
            write_operands(writer, steps)
        Deref(pointer):
            writer.write_u8(117)
            write_node_id(writer, pointer)
        QualifyPointer(value):
            writer.write_u8(118)
            write_node_id(writer, value)
        PointerOffset(pointer, offset, negate):
            writer.write_u8(119)
            write_node_id(writer, pointer)
            write_node_id(writer, offset)
            writer.write_bool(negate)
        PointerDifference(left, right):
            writer.write_u8(120)
            write_node_id(writer, left)
            write_node_id(writer, right)
        SpanFromParts(pointer, length):
            writer.write_u8(121)
            write_node_id(writer, pointer)
            write_node_id(writer, length)
        SpanLength(span):
            writer.write_u8(122)
            write_node_id(writer, span)
        SpanData(span):
            writer.write_u8(123)
            write_node_id(writer, span)
        SpanElementAddress(span, index):
            writer.write_u8(124)
            write_node_id(writer, span)
            write_node_id(writer, index)
        ZeroValue: writer.write_u8(126)
        Uninitialized: writer.write_u8(127)
        EnumFromInteger(value):
            writer.write_u8(128)
            write_node_id(writer, value)
        SpanSlice(span, start, end, inclusive):
            writer.write_u8(125)
            write_node_id(writer, span)
            write_node_id(writer, start)
            write_node_id(writer, end)
            writer.write_bool(inclusive)
        Discard(value):
            writer.write_u8(34)
            write_node_id(writer, value)
        NeverCoercion(value):
            writer.write_u8(35)
            write_node_id(writer, value)
        DivergingSequence(values):
            writer.write_u8(36)
            write_operands(writer, values)
        StringScalarCount(value):
            writer.write_u8(37)
            write_node_id(writer, value)
        BuiltinDisplay(value):
            writer.write_u8(38)
            write_node_id(writer, value)
        FormattedString(parts):
            writer.write_u8(39)
            write_operands(writer, parts)
        Hash(value):
            writer.write_u8(40)
            write_node_id(writer, value)
        SequenceLength(value):
            writer.write_u8(41)
            write_node_id(writer, value)
        SequenceIndex(value, index):
            writer.write_u8(42)
            write_node_id(writer, value)
            write_node_id(writer, index)
        Unary(operation, operand):
            writer.write_u8(43)
            try write_unary(writer, operation)
            write_node_id(writer, operand)
        Binary(left, operation, right):
            writer.write_u8(44)
            write_node_id(writer, left)
            try write_binary(writer, operation)
            write_node_id(writer, right)
        Conditional(value, condition, alternative):
            writer.write_u8(45)
            write_node_id(writer, value)
            write_node_id(writer, condition)
            write_node_id(writer, alternative)
        Range(lower, upper, inclusive):
            writer.write_u8(46)
            write_node_id(writer, lower)
            write_node_id(writer, upper)
            writer.write_bool(inclusive)
        Call(function, arguments):
            writer.write_u8(47)
            write_symbol_id(writer, function)
            write_operands(writer, arguments)
        GenericCall(generic, type_arguments, arguments, kind):
            writer.write_u8(48)
            writer.write_u32(generic)
            write_operands(writer, type_arguments)
            write_operands(writer, arguments)
            write_generic_call_kind(writer, kind)
        GenericFunctionAddress(generic, type_arguments):
            writer.write_u8(49)
            writer.write_u32(generic)
            write_operands(writer, type_arguments)
        GenericDefaultArgument(generic, parameter, type_arguments):
            writer.write_u8(50)
            writer.write_u32(generic)
            writer.write_u32(parameter)
            write_operands(writer, type_arguments)
        GenericRequirementCall(interface_type, requirement, arguments):
            writer.write_u8(51)
            write_type_id(writer, interface_type)
            writer.write_u32(requirement)
            write_operands(writer, arguments)
        GenericInterfaceValue(value):
            writer.write_u8(52)
            write_node_id(writer, value)
        InterfaceValue(value, conformance):
            writer.write_u8(53)
            write_node_id(writer, value)
            writer.write_u32(conformance)
        InterfaceCall(receiver, interface_type, requirement, arguments):
            writer.write_u8(54)
            write_node_id(writer, receiver)
            write_type_id(writer, interface_type)
            writer.write_u32(requirement)
            write_operands(writer, arguments)
        FunctionAddress(function):
            writer.write_u8(55)
            write_symbol_id(writer, function)
        ClosureValue(closure, initializers):
            writer.write_u8(56)
            writer.write_u32(closure)
            write_operands(writer, initializers)
        WeakCaptureReference(symbol):
            writer.write_u8(57)
            write_symbol_id(writer, symbol)
        IndirectCall(callee, arguments):
            writer.write_u8(58)
            write_node_id(writer, callee)
            write_operands(writer, arguments)
        Initialize(function, arguments):
            writer.write_u8(59)
            write_symbol_id(writer, function)
            write_operands(writer, arguments)
        ErrorCodeLiteral(package, value):
            writer.write_u8(60)
            write_package_id(writer, package)
            writer.write_u32(value)
        Raise(code, message):
            writer.write_u8(61)
            write_node_id(writer, code)
            write_node_id(writer, message)
        Trap(message):
            writer.write_u8(62)
            write_node_id(writer, message)
        Assert(condition, message):
            writer.write_u8(63)
            write_node_id(writer, condition)
            write_node_id(writer, message)
        Try(value):
            writer.write_u8(64)
            write_node_id(writer, value)
        Catch(value, failure, body):
            writer.write_u8(65)
            write_node_id(writer, value)
            write_symbol_id(writer, failure)
            write_operands(writer, body)
        Tuple(elements):
            writer.write_u8(66)
            write_operands(writer, elements)
        Array(elements):
            writer.write_u8(67)
            write_operands(writer, elements)
        List(elements):
            writer.write_u8(68)
            write_operands(writer, elements)
        ListCopy(value):
            writer.write_u8(69)
            write_node_id(writer, value)
        ListWithMutableSlice(value, callback):
            writer.write_u8(70)
            write_node_id(writer, value)
            write_node_id(writer, callback)
        SequenceSlice(value, start, end):
            writer.write_u8(71)
            write_node_id(writer, value)
            write_node_id(writer, start)
            write_node_id(writer, end)
        ListAppend(value, element):
            writer.write_u8(72)
            write_node_id(writer, value)
            write_node_id(writer, element)
        ListInsert(value, index, element):
            writer.write_u8(73)
            write_node_id(writer, value)
            write_node_id(writer, index)
            write_node_id(writer, element)
        ListRemoveAt(value, index):
            writer.write_u8(74)
            write_node_id(writer, value)
            write_node_id(writer, index)
        ListClear(value):
            writer.write_u8(75)
            write_node_id(writer, value)
        ListReserve(value, minimum_capacity):
            writer.write_u8(76)
            write_node_id(writer, value)
            write_node_id(writer, minimum_capacity)
        Map(entries):
            writer.write_u8(77)
            write_operands(writer, entries)
        Set(elements):
            writer.write_u8(78)
            write_operands(writer, elements)
        MapLookup(value, key):
            writer.write_u8(79)
            write_node_id(writer, value)
            write_node_id(writer, key)
        MapRemove(value, key):
            writer.write_u8(80)
            write_node_id(writer, value)
            write_node_id(writer, key)
        MapClear(value):
            writer.write_u8(81)
            write_node_id(writer, value)
        MapReserve(value, minimum_capacity):
            writer.write_u8(82)
            write_node_id(writer, value)
            write_node_id(writer, minimum_capacity)
        MapCopy(value):
            writer.write_u8(83)
            write_node_id(writer, value)
        SetContains(value, element):
            writer.write_u8(84)
            write_node_id(writer, value)
            write_node_id(writer, element)
        SetInsert(value, element):
            writer.write_u8(85)
            write_node_id(writer, value)
            write_node_id(writer, element)
        SetRemove(value, element):
            writer.write_u8(86)
            write_node_id(writer, value)
            write_node_id(writer, element)
        SetClear(value):
            writer.write_u8(87)
            write_node_id(writer, value)
        SetReserve(value, minimum_capacity):
            writer.write_u8(88)
            write_node_id(writer, value)
            write_node_id(writer, minimum_capacity)
        SetCopy(value):
            writer.write_u8(89)
            write_node_id(writer, value)
        WeakCreate(value):
            writer.write_u8(90)
            write_node_id(writer, value)
        WeakGet(value):
            writer.write_u8(91)
            write_node_id(writer, value)
        Element(value, index):
            writer.write_u8(92)
            write_node_id(writer, value)
            writer.write_i64(index)
        StructValue(struct_index, fields):
            writer.write_u8(93)
            writer.write_i64(struct_index)
            write_operands(writer, fields)
        FieldAccess(value, field):
            writer.write_u8(94)
            write_node_id(writer, value)
            writer.write_i64(field)
        NoneLiteral: writer.write_u8(95)
        Some(value):
            writer.write_u8(96)
            write_node_id(writer, value)
        ElseFallback(value, arm):
            writer.write_u8(97)
            write_node_id(writer, value)
            write_node_id(writer, arm)
        EnumValue(enum_index, case_index, payload):
            writer.write_u8(98)
            writer.write_i64(enum_index)
            writer.write_i64(case_index)
            write_operands(writer, payload)
        Match(subject, arms, has_result):
            writer.write_u8(99)
            write_node_id(writer, subject)
            write_operands(writer, arms)
            writer.write_bool(has_result)
        MatchArm(patterns, statements, value, guard):
            writer.write_u8(100)
            write_operands(writer, patterns)
            write_operands(writer, statements)
            write_node_id(writer, value)
            write_node_id(writer, guard)
        PatternWildcard: writer.write_u8(101)
        PatternLiteral(value):
            writer.write_u8(102)
            writer.write_u32(value)
        PatternRange(lower, upper, inclusive):
            writer.write_u8(103)
            writer.write_u32(lower)
            writer.write_u32(upper)
            writer.write_bool(inclusive)
        PatternCase(case_index, bindings):
            writer.write_u8(104)
            writer.write_i64(case_index)
            write_operands(writer, bindings)
        Spawn(function, arguments):
            writer.write_u8(105)
            write_symbol_id(writer, function)
            write_operands(writer, arguments)
        GenericSpawn(generic, type_arguments, arguments):
            writer.write_u8(106)
            writer.write_u32(generic)
            write_operands(writer, type_arguments)
            write_operands(writer, arguments)
        TaskWait(value):
            writer.write_u8(107)
            write_node_id(writer, value)
        TaskCancel(value):
            writer.write_u8(108)
            write_node_id(writer, value)
        TaskWaitAll(tasks):
            writer.write_u8(109)
            write_node_id(writer, tasks)
        CollectionSnapshot(value):
            writer.write_u8(110)
            write_node_id(writer, value)
        ForeignBytesCopy(pointer, count):
            writer.write_u8(111)
            write_node_id(writer, pointer)
            write_node_id(writer, count)
        ForeignCStringCopy(pointer):
            writer.write_u8(112)
            write_node_id(writer, pointer)

# mark: Node decoding ==========================================================================

pub func read_hir_node(reader: PackageReader) -> HirNode!:
    let tag = try reader.read_u8()
    if tag == 0: return HirNode(form = HirNodeForm.BreakStatement(levels = i64(try reader.read_u32())))
    if tag == 1: return HirNode(form = HirNodeForm.ContinueStatement(levels = i64(try reader.read_u32())))
    if tag == 2: return HirNode(form = HirNodeForm.Binding(symbol = try read_symbol_id(reader), is_mutable = try reader.read_bool(), value = try read_node_id(reader)))
    if tag == 3: return HirNode(form = HirNodeForm.Assignment(symbol = try read_symbol_id(reader), operation = try read_assignment(reader), value = try read_node_id(reader)))
    if tag == 4: return HirNode(form = HirNodeForm.ExternStore(variable = try reader.read_u32(), operation = try read_assignment(reader), value = try read_node_id(reader)))
    if tag == 5: return HirNode(form = HirNodeForm.GlobalStore(global = try reader.read_u32(), operation = try read_assignment(reader), value = try read_node_id(reader)))
    if tag == 6: return HirNode(form = HirNodeForm.PlaceAssignment(symbol = try read_symbol_id(reader), steps = try read_operands(reader), operation = try read_assignment(reader), value = try read_node_id(reader)))
    if tag == 7: return HirNode(form = HirNodeForm.GlobalPlaceAssignment(global = try reader.read_u32(), steps = try read_operands(reader), operation = try read_assignment(reader), value = try read_node_id(reader)))
    if tag == 8: return HirNode(form = HirNodeForm.PrintText(value = try reader.read_text()))
    if tag == 9: return node1(HirNodeForm.PrintValue(value = try read_node_id(reader)))
    if tag == 10: return node1(HirNodeForm.ReturnStatement(value = try read_node_id(reader)))
    if tag == 11: return node1(HirNodeForm.RecoverStatement(value = try read_node_id(reader)))
    if tag == 12: return node1(HirNodeForm.DeferStatement(action = try read_node_id(reader)))
    if tag == 13: return node1(HirNodeForm.ExpressionStatement(value = try read_node_id(reader)))
    if tag == 14: return node1(HirNodeForm.IfStatement(branches = try read_operands(reader), has_fallback = try reader.read_bool(), fallback = try read_operands(reader)))
    if tag == 15: return node1(HirNodeForm.WhileStatement(condition = try read_node_id(reader), body = try read_operands(reader)))
    if tag == 16: return node1(HirNodeForm.ForStatement(symbol = try read_symbol_id(reader), iteration = try read_iteration(reader), body = try read_operands(reader)))
    if tag == 17: return node1(HirNodeForm.Constant(value = try reader.read_u32()))
    if tag == 18: return node1(HirNodeForm.Reference(symbol = try read_symbol_id(reader)))
    if tag == 19: return node1(HirNodeForm.ExternLoad(variable = try reader.read_u32()))
    if tag == 20: return node1(HirNodeForm.GlobalLoad(global = try reader.read_u32()))
    if tag == 21: return node1(HirNodeForm.NativeLoad(pointer = try read_node_id(reader)))
    if tag == 22: return node1(HirNodeForm.NativeStore(pointer = try read_node_id(reader), value = try read_node_id(reader)))
    if tag == 23: return node1(HirNodeForm.NativeAdvance(pointer = try read_node_id(reader), count = try read_node_id(reader)))
    if tag == 24: return node1(HirNodeForm.NativeRebind(pointer = try read_node_id(reader)))
    if tag == 25: return node1(HirNodeForm.NativeMove(destination = try read_node_id(reader), source = try read_node_id(reader), count = try read_node_id(reader)))
    if tag == 26: return node1(HirNodeForm.NativeAllocate(element_type = try read_type_id(reader), count = try read_node_id(reader)))
    if tag == 27: return node1(HirNodeForm.NativeDeallocate(pointer = try read_node_id(reader), element_type = try read_type_id(reader), count = try read_node_id(reader)))
    if tag == 28: return node1(HirNodeForm.NativeIsNull(pointer = try read_node_id(reader)))
    if tag == 29: return node1(HirNodeForm.NativeIsSame(left = try read_node_id(reader), right = try read_node_id(reader)))
    if tag == 30: return node1(HirNodeForm.NativeAddressHash(pointer = try read_node_id(reader)))
    if tag == 31: return node1(HirNodeForm.NativeFloatBits(value = try read_node_id(reader)))
