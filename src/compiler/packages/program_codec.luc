#==============================================================================================
#
#   package_program_codec - One complete target-neutral typed HIR package payload
#
#   DESCRIPTION:
#       Composes every HIR table into the canonical typed-package envelope.
#       Decode order follows dependency order—types, identities, executable
#       arena, nominal/interface declarations, executable declarations, then
#       retained generics—and no partially validated graph escapes this API.
#
#       This is still semantic HIR. Target layout, ABI placement, object
#       format, linking, and host-tool choices remain entirely backend-owned.
#
#==============================================================================================

from compiler.hir.ir import HirBodyArena, HirProgram, PackageRole, SymbolKind
from compiler.packages.artifact import decode_typed_package, encode_typed_package
from compiler.packages.body_codec import read_hir_body_arena, write_hir_body_arena
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.executable_codec import HirExecutableTables, HirExecutableValidationContext
from compiler.packages.executable_codec import read_executable_tables, validate_executable_tables
from compiler.packages.executable_codec import write_executable_tables
from compiler.packages.generic_codec import read_generic_functions, write_generic_functions
from compiler.packages.generic_validation import HirGenericValidationContext
from compiler.packages.generic_validation import validate_executable_hir_arena, validate_generic_functions
from compiler.packages.identity_codec import HirIdentityGraph, read_identity_graph, validate_identity_graph
from compiler.packages.identity_codec import write_identity_graph
from compiler.packages.interface_codec import HirInterfaceTables, read_interface_tables
from compiler.packages.interface_codec import validate_interface_tables, write_interface_tables
from compiler.packages.nominal_codec import HirNominalTables, read_nominal_tables
from compiler.packages.nominal_codec import validate_nominal_tables, write_nominal_tables
from compiler.packages.type_codec import read_type_table, validate_type_table, write_type_table

# mark: Canonical envelope =====================================================================

pub func encode_typed_hir_package(program: HirProgram) -> list[u8]!:
    try validate_typed_hir_package(program)
    let payload = PackageWriter()
    try write_type_table(payload, program.types)
    try write_identity_graph(payload, identity_graph(program), len(program.types.definitions))
    try write_hir_body_arena(payload, program_arena(program))
    try write_nominal_tables(
        payload, nominal_tables(program), program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    )
    try write_interface_tables(
        payload, interface_tables(program), program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    )
    try write_executable_tables(payload, executable_tables(program))
    try write_generic_functions(payload, program.generic_functions, generic_context(program))
    let package = program.packages[program.root_package.value]
    return try encode_typed_package(package.identity, payload.finish())

pub func decode_typed_hir_package(input: list[u8]) -> HirProgram!:
    let envelope = try decode_typed_package(input)
    let reader = PackageReader(envelope.payload)
    let types = try read_type_table(reader)
    let identities = try read_identity_graph(reader, len(types.definitions))
    let arena = try read_hir_body_arena(reader)
    let nominals = try read_nominal_tables(
        reader, types, len(identities.modules), len(identities.symbols), len(arena.nodes),
    )
    let interfaces = try read_interface_tables(
        reader, types, len(identities.modules), len(identities.symbols), len(arena.nodes),
    )
    let executable = try read_executable_tables(reader)
    let generic_validation = HirGenericValidationContext(
        types = types,
        package_count = len(identities.packages),
        module_count = len(identities.modules),
        symbol_count = len(identities.symbols),
        extern_variable_count = len(executable.extern_variables),
        global_count = len(executable.globals),
        struct_count = len(nominals.structs),
        enum_count = len(nominals.enums),
        interfaces = interfaces.interfaces,
        functions = executable.functions,
        nominal_applications = nominals.applications,
    )
    let generics = try read_generic_functions(reader, generic_validation)
    try reader.finish()

    let program = HirProgram(
        packages = identities.packages,
        root_package = identities.root_package,
        runtime_bindings = executable.runtime_bindings,
        types = types,
        symbols = identities.symbols,
        modules = identities.modules,
        constants = executable.constants,
        structs = nominals.structs,
        classes = nominals.classes,
        enums = nominals.enums,
        nominal_applications = nominals.applications,
        interfaces = interfaces.interfaces,
        interface_applications = interfaces.applications,
        conformances = interfaces.conformances,
        extern_types = executable.extern_types,
        extern_variables = executable.extern_variables,
        globals = executable.globals,
        closures = executable.closures,
        shared_cells = executable.shared_cells,
        generic_functions = generics,
        generic_instances = executable.generic_instances,
        generic_specialization_budget = executable.generic_specialization_budget,
        functions = executable.functions,
        nodes = arena.nodes,
        node_types = arena.node_types,
        node_modules = arena.node_modules,
        node_spans = arena.node_spans,
        extra = arena.extra,
        values = arena.values,
    )
    try validate_typed_hir_package(program)
    let root = program.packages[program.root_package.value]
    if envelope.identity != root.identity:
        error("typed package artifact: envelope identity does not match the root HIR package")
    return program

# mark: Whole-graph validation =================================================================

pub func validate_typed_hir_package(program: HirProgram) -> !:
    try validate_type_table(program.types)
    try validate_identity_graph(identity_graph(program), len(program.types.definitions))
    try validate_nominal_tables(
        nominal_tables(program), program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    )
    try validate_interface_tables(
        interface_tables(program), program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    )
    let generic_validation = generic_context(program)
    try validate_generic_functions(program.generic_functions, generic_validation)
    try validate_executable_tables(executable_tables(program), HirExecutableValidationContext(
        types = program.types,
        symbols = program.symbols,
        module_count = len(program.modules),
        node_count = len(program.nodes),
        extra_count = len(program.extra),
        generic_count = len(program.generic_functions),
    ))
    try validate_executable_hir_arena(
        program_arena(program), program.closures, program.functions, program.generic_functions,
        generic_validation, len(program.conformances),
    )
    try validate_cross_table_ownership(program)

func validate_cross_table_ownership(program: HirProgram) -> !:
    for index in range(0, len(program.generic_functions)):
        let generic = program.generic_functions[index]
        if program.symbols[generic.symbol.value].kind != SymbolKind.function:
            error("typed package artifact: generic declaration symbol has the wrong kind")
        if program.symbols[generic.symbol.value].name != generic.name:
            error("typed package artifact: generic declaration name does not match its symbol")
        for previous in range(0, index):
            if program.generic_functions[previous].symbol.value == generic.symbol.value:
                error("typed package artifact: duplicate generic declaration symbol")
        for function in program.functions:
            if function.symbol.value == generic.symbol.value:
                error("typed package artifact: generic and executable functions share a symbol")

    for global in program.globals:
        if package_role_of_module(program, global.module.value) != PackageRole.sealed_runtime:
            error("typed package artifact: HIR global is not owned by the sealed runtime package")
    for binding in program.runtime_bindings:
        var function_index = -1
        for index in range(0, len(program.functions)):
            if program.functions[index].symbol.value == binding.function.value: function_index = index
        if function_index < 0:
            error("typed package artifact: runtime service binding has no executable function")
        if package_role_of_module(program, program.functions[function_index].module.value) != PackageRole.sealed_runtime:
            error("typed package artifact: runtime service binding is not owned by the sealed runtime package")

func package_role_of_module(program: HirProgram, module: u32) -> PackageRole:
    let package = program.modules[module].package
    return program.packages[package.value].role

# mark: Exact table projections ================================================================

func identity_graph(program: HirProgram) -> HirIdentityGraph:
    return HirIdentityGraph(
        packages = program.packages,
        root_package = program.root_package,
        modules = program.modules,
        symbols = program.symbols,
    )

func program_arena(program: HirProgram) -> HirBodyArena:
    return HirBodyArena(
        nodes = program.nodes,
        node_types = program.node_types,
        node_modules = program.node_modules,
        node_spans = program.node_spans,
        extra = program.extra,
        values = program.values,
    )

func nominal_tables(program: HirProgram) -> HirNominalTables:
    return HirNominalTables(
        structs = program.structs,
        classes = program.classes,
        enums = program.enums,
        applications = program.nominal_applications,
    )

func interface_tables(program: HirProgram) -> HirInterfaceTables:
    return HirInterfaceTables(
        interfaces = program.interfaces,
        applications = program.interface_applications,
        conformances = program.conformances,
    )

func executable_tables(program: HirProgram) -> HirExecutableTables:
    return HirExecutableTables(
        runtime_bindings = program.runtime_bindings,
        constants = program.constants,
        extern_types = program.extern_types,
        extern_variables = program.extern_variables,
        globals = program.globals,
        closures = program.closures,
        shared_cells = program.shared_cells,
        generic_instances = program.generic_instances,
        generic_specialization_budget = program.generic_specialization_budget,
        functions = program.functions,
    )

func generic_context(program: HirProgram) -> HirGenericValidationContext:
    return HirGenericValidationContext(
        types = program.types,
        package_count = len(program.packages),
        module_count = len(program.modules),
        symbol_count = len(program.symbols),
        extern_variable_count = len(program.extern_variables),
        global_count = len(program.globals),
        struct_count = len(program.structs),
        enum_count = len(program.enums),
        interfaces = program.interfaces,
        functions = program.functions,
        nominal_applications = program.nominal_applications,
    )
