#==============================================================================================
#
#   package_function_codec - Exact HIR callable declarations and implementations
#
#   DESCRIPTION:
#       Serializes the one `HirFunction` representation used by executable
#       package bodies and generated closure bodies. Defined, C-exported, and
#       C-supplied implementations remain semantic HIR choices; calling
#       convention layout and linker spelling remain backend concerns.
#
#==============================================================================================

from compiler.hir.ir import HirCFunction, HirCSlot, HirFunction, HirFunctionImplementation
from compiler.hir.ir import TypeTable
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_attributes, read_documentation, read_module_id, read_operands, read_optional_u32
from compiler.packages.hir_fields import read_span, read_symbol_id, read_type_id
from compiler.packages.hir_fields import validate_module_id, validate_operands, validate_symbol_id, validate_type_id
from compiler.packages.hir_fields import write_attributes, write_documentation, write_module_id, write_operands, write_optional_u32
from compiler.packages.hir_fields import write_span, write_symbol_id, write_type_id
from compiler.packages.signature_codec import read_optional_receiver, read_parameters
from compiler.packages.signature_codec import validate_optional_receiver, validate_parameters
from compiler.packages.signature_codec import write_optional_receiver, write_parameters

pub struct HirFunctionValidationContext:
    pub let types: TypeTable
    pub let module_count: i64
    pub let symbol_count: i64
    pub let node_count: i64
    pub let extra_count: i64
    pub let closure_count: i64

# mark: Public codec ===========================================================================

pub func write_hir_functions(writer: PackageWriter, values: list[HirFunction]) -> !:
    try writer.write_count(len(values))
    for value in values: try write_hir_function(writer, value)

pub func read_hir_functions(reader: PackageReader) -> list[HirFunction]!:
    let values = list[HirFunction]()
    let count = try reader.read_count()
    for index in range(0, count): values.append(try read_hir_function(reader))
    return values

pub func write_hir_function(writer: PackageWriter, value: HirFunction) -> !:
    write_symbol_id(writer, value.symbol)
    write_module_id(writer, value.module)
    try writer.write_text(value.name)
    writer.write_bool(value.is_public)
    try write_documentation(writer, value.documentation)
    write_optional_receiver(writer, value.receiver)
    write_optional_u32(writer, value.closure)
    try write_parameters(writer, value.parameters)
    write_type_id(writer, value.result)
    try write_implementation(writer, value.implementation)
    write_span(writer, value.span)
    try write_attributes(writer, value.attributes)

pub func read_hir_function(reader: PackageReader) -> HirFunction!:
    return HirFunction(
        symbol = try read_symbol_id(reader),
        module = try read_module_id(reader),
        name = try reader.read_text(),
        is_public = try reader.read_bool(),
        documentation = try read_documentation(reader),
        receiver = try read_optional_receiver(reader),
        closure = try read_optional_u32(reader),
        parameters = try read_parameters(reader),
        result = try read_type_id(reader),
        implementation = try read_implementation(reader),
        span = try read_span(reader),
        attributes = try read_attributes(reader),
    )

# mark: Implementations ========================================================================

func write_implementation(writer: PackageWriter, value: HirFunctionImplementation) -> !:
    match value:
        Defined(body):
            writer.write_u8(0)
            write_operands(writer, body)
        ExportedC(body):
            writer.write_u8(1)
            write_operands(writer, body)
        ExternalC(contract):
            writer.write_u8(2)
            writer.write_bool(contract.is_blocking)
            try writer.write_count(len(contract.slots))
            for slot in contract.slots: try write_c_slot(writer, slot)
            write_type_id(writer, contract.declared_result)
            writer.write_bool(contract.is_variadic)
            try writer.write_text(contract.symbol)

func read_implementation(reader: PackageReader) -> HirFunctionImplementation!:
    let tag = try reader.read_u8()
    if tag == 0: return HirFunctionImplementation.Defined(body = try read_operands(reader))
    if tag == 1: return HirFunctionImplementation.ExportedC(body = try read_operands(reader))
    if tag == 2:
        let is_blocking = try reader.read_bool()
        let slots = list[HirCSlot]()
        let count = try reader.read_count()
        for index in range(0, count): slots.append(try read_c_slot(reader))
        return HirFunctionImplementation.ExternalC(contract = HirCFunction(
            is_blocking = is_blocking,
            slots = slots,
            declared_result = try read_type_id(reader),
            is_variadic = try reader.read_bool(),
            symbol = try reader.read_text(),
        ))
    error("typed package artifact: unknown HIR function implementation tag " + str(u64(tag)))

func write_c_slot(writer: PackageWriter, value: HirCSlot) -> !:
    match value:
        Input(parameter):
            writer.write_u8(0)
            writer.write_u32(parameter)
        Output(name, value_type):
            writer.write_u8(1)
            try writer.write_text(name)
            write_type_id(writer, value_type)

func read_c_slot(reader: PackageReader) -> HirCSlot!:
    let tag = try reader.read_u8()
    if tag == 0: return HirCSlot.Input(parameter = try reader.read_u32())
    if tag == 1:
        return HirCSlot.Output(name = try reader.read_text(), value_type = try read_type_id(reader))
    error("typed package artifact: unknown HIR C-slot tag " + str(u64(tag)))

# mark: Semantic validation ====================================================================

pub func validate_hir_functions(values: list[HirFunction], context: HirFunctionValidationContext) -> !:
    for value in values: try validate_hir_function(value, context)

pub func validate_hir_function(value: HirFunction, context: HirFunctionValidationContext) -> !:
    try validate_symbol_id(value.symbol, context.symbol_count)
    try validate_module_id(value.module, context.module_count)
    if len(value.name) == 0:
        error("typed package artifact: HIR function name must not be empty")
    try validate_optional_receiver(value.receiver, context.types)
    let closure = value.closure
    if closure != none:
        if i64(closure) >= context.closure_count:
            error("typed package artifact: HIR function references a missing closure")
    try validate_parameters(value.parameters, context.types, context.symbol_count, context.node_count)
    try validate_type_id(value.result, len(context.types.definitions))
    match value.implementation:
        Defined(body): try validate_operands(body, context.extra_count)
        ExportedC(body): try validate_operands(body, context.extra_count)
        ExternalC(contract): try validate_c_contract(contract, value, context.types)

func validate_c_contract(contract: HirCFunction, function: HirFunction, types: TypeTable) -> !:
    try validate_type_id(contract.declared_result, len(types.definitions))
    let seen_inputs = list[bool]()
    for parameter in function.parameters: seen_inputs.append(false)
    let output_names = list[str]()
    for slot in contract.slots:
        match slot:
            Input(parameter):
                if i64(parameter) >= len(function.parameters):
                    error("typed package artifact: HIR C input references a missing parameter")
                if seen_inputs[parameter]:
                    error("typed package artifact: HIR C input parameter appears more than once")
                seen_inputs[parameter] = true
            Output(name, value_type):
                if len(name) == 0:
                    error("typed package artifact: HIR C output name must not be empty")
                for previous in output_names:
                    if previous == name:
                        error("typed package artifact: duplicate HIR C output `" + name + "`")
                output_names.append(name)
                try validate_type_id(value_type, len(types.definitions))
