#==============================================================================================
#
#   package_identity_codec - Packages, modules, and semantic symbols
#
#   DESCRIPTION:
#       Serializes the identity graph that gives every later typed declaration
#       and body reference its meaning. Numeric IDs remain artifact-local and
#       are remapped exactly once by package composition. Package identity and
#       module ownership are explicit, so no importer guesses provenance from
#       a source path, symbol spelling, or table position.
#
#==============================================================================================

from compiler.hir.ir import HirModule, HirPackage, HirSymbol, ModuleAuthority, ModuleId
from compiler.hir.ir import PackageId, PackageRole, SymbolKind
from compiler.packages.encoding import PackageReader, PackageWriter
from compiler.packages.hir_fields import read_documentation, read_module_id, read_package_id
from compiler.packages.hir_fields import read_symbol_id, read_type_id
from compiler.packages.hir_fields import validate_package_id, validate_type_id
from compiler.packages.hir_fields import write_documentation, write_module_id, write_package_id
from compiler.packages.hir_fields import write_symbol_id, write_type_id

## The HIR tables whose references establish declaration and body provenance.
## This is deliberately not a second semantic IR: entries are the exact HIR
## records used after import, grouped only so validation cannot omit a table.
pub struct HirIdentityGraph:
    pub let packages: list[HirPackage]
    pub let root_package: PackageId
    pub let modules: list[HirModule]
    pub let symbols: list[HirSymbol]

# mark: Public codec ===========================================================================

pub func write_identity_graph(writer: PackageWriter, graph: HirIdentityGraph, type_count: i64) -> !:
    try validate_identity_graph(graph, type_count)
    try writer.write_count(len(graph.packages))
    for package in graph.packages:
        write_package_id(writer, package.id)
        try writer.write_text(package.identity)
        write_package_role(writer, package.role)
    write_package_id(writer, graph.root_package)

    try writer.write_count(len(graph.modules))
    for module in graph.modules:
        write_module_id(writer, module.id)
        write_package_id(writer, module.package)
        try writer.write_text(module.name)
        try writer.write_text(module.path)
        write_module_authority(writer, module.authority)
        try write_documentation(writer, module.documentation)

    try writer.write_count(len(graph.symbols))
    for symbol in graph.symbols:
        write_symbol_id(writer, symbol.id)
        try writer.write_text(symbol.name)
        write_symbol_kind(writer, symbol.kind)
        write_type_id(writer, symbol.value_type)

pub func read_identity_graph(reader: PackageReader, type_count: i64) -> HirIdentityGraph!:
    let package_count = try reader.read_count()
    let packages = list[HirPackage]()
    for index in range(0, package_count):
        packages.append(HirPackage(
            id = try read_package_id(reader),
            identity = try reader.read_text(),
            role = try read_package_role(reader),
        ))
    let root_package = try read_package_id(reader)

    let module_count = try reader.read_count()
    let modules = list[HirModule]()
    for index in range(0, module_count):
        modules.append(HirModule(
            id = try read_module_id(reader),
            package = try read_package_id(reader),
            name = try reader.read_text(),
            path = try reader.read_text(),
            authority = try read_module_authority(reader),
            documentation = try read_documentation(reader),
        ))

    let symbol_count = try reader.read_count()
    let symbols = list[HirSymbol]()
    for index in range(0, symbol_count):
        symbols.append(HirSymbol(
            id = try read_symbol_id(reader),
            name = try reader.read_text(),
            kind = try read_symbol_kind(reader),
            value_type = try read_type_id(reader),
        ))

    let graph = HirIdentityGraph(
        packages = packages,
        root_package = root_package,
        modules = modules,
        symbols = symbols,
    )
    try validate_identity_graph(graph, type_count)
    return graph

# mark: Closed enum spellings =================================================================

func write_package_role(writer: PackageWriter, value: PackageRole):
    match value:
        ordinary: writer.write_u8(0)
        sealed_runtime: writer.write_u8(1)

func read_package_role(reader: PackageReader) -> PackageRole!:
    let tag = try reader.read_u8()
    if tag == 0: return PackageRole.ordinary
    if tag == 1: return PackageRole.sealed_runtime
    error("typed package artifact: unknown package role tag " + str(u64(tag)))

func write_module_authority(writer: PackageWriter, value: ModuleAuthority):
    match value:
        safe: writer.write_u8(0)
        native: writer.write_u8(1)

func read_module_authority(reader: PackageReader) -> ModuleAuthority!:
    let tag = try reader.read_u8()
    if tag == 0: return ModuleAuthority.safe
    if tag == 1: return ModuleAuthority.native
    error("typed package artifact: unknown module authority tag " + str(u64(tag)))

func write_symbol_kind(writer: PackageWriter, value: SymbolKind):
    match value:
        function: writer.write_u8(0)
        parameter: writer.write_u8(1)
        local: writer.write_u8(2)
        constant: writer.write_u8(3)
        global: writer.write_u8(4)

func read_symbol_kind(reader: PackageReader) -> SymbolKind!:
    let tag = try reader.read_u8()
    if tag == 0: return SymbolKind.function
    if tag == 1: return SymbolKind.parameter
    if tag == 2: return SymbolKind.local
    if tag == 3: return SymbolKind.constant
    if tag == 4: return SymbolKind.global
    error("typed package artifact: unknown HIR symbol kind tag " + str(u64(tag)))

# mark: Semantic validation ====================================================================

## Validate the exact graph before encoding and after decoding. The package
## verifier later checks which declarations each symbol owns; this layer owns
## only identity, table shape, module provenance, and type references.
pub func validate_identity_graph(graph: HirIdentityGraph, type_count: i64) -> !:
    if len(graph.packages) == 0:
        error("typed package artifact: HIR identity graph must contain a package")
    if type_count <= 0:
        error("typed package artifact: HIR identity graph requires a type table")

    var sealed_runtime_count = 0
    for index in range(0, len(graph.packages)):
        let package = graph.packages[index]
        if package.id.value != u32(index):
            error("typed package artifact: HIR PackageId does not match its table position")
        if len(package.identity) == 0:
            error("typed package artifact: HIR package identity must not be empty")
        for previous in range(0, index):
            if graph.packages[previous].identity == package.identity:
                error("typed package artifact: duplicate HIR package identity `" + package.identity + "`")
        if package.role == PackageRole.sealed_runtime: sealed_runtime_count += 1
    if sealed_runtime_count > 1:
        error("typed package artifact: HIR identity graph contains multiple sealed runtime packages")
    try validate_package_id(graph.root_package, len(graph.packages))

    for index in range(0, len(graph.modules)):
        let module = graph.modules[index]
        if module.id.value != u32(index):
            error("typed package artifact: HIR ModuleId does not match its table position")
        try validate_package_id(module.package, len(graph.packages))
        if len(module.name) == 0:
            error("typed package artifact: HIR module name must not be empty")
        if len(module.path) == 0:
            error("typed package artifact: HIR module diagnostic path must not be empty")
        for previous in range(0, index):
            let other = graph.modules[previous]
            if other.package.value == module.package.value and other.name == module.name:
                error("typed package artifact: duplicate HIR module `" + module.name + "` in one package")

    for index in range(0, len(graph.symbols)):
        let symbol = graph.symbols[index]
        if symbol.id.value != u32(index):
            error("typed package artifact: HIR SymbolId does not match its table position")
        if len(symbol.name) == 0:
            error("typed package artifact: HIR symbol name must not be empty")
        try validate_type_id(symbol.value_type, type_count)
