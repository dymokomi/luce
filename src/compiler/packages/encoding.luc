#==============================================================================================
#
#   package_encoding - Canonical byte primitives for typed package artifacts
#
#   DESCRIPTION:
#       Owns the small, target-independent wire vocabulary shared by package
#       artifact sections. Fixed wire widths are format facts, not target
#       widths. Every read is bounded before allocation or indexing, text must
#       be canonical UTF-8, and callers must explicitly reject trailing data.
#
#==============================================================================================

import std.strings

# No single counted field may force an allocation larger than 64 MiB, and no
# table may claim more than one million entries. The whole artifact reader may
# impose a tighter product limit before constructing this decoder.
let maximum_field_bytes: u64 = 67108864
let maximum_table_entries: u32 = 1000000

# mark: Writer ================================================================================

## Append-only canonical artifact encoder. It deliberately exposes semantic
## operations rather than its storage so section codecs cannot disagree about
## Boolean, integer, count, byte, or text representation.
pub class PackageWriter:
    let output: list[u8]

    pub init():
        self.output = list[u8]()

    pub func write_u8(value: u8):
        self.output.append(value)

    pub func write_bool(value: bool):
        if value:
            self.write_u8(u8(1))
        else:
            self.write_u8(u8(0))

    pub func write_u32(value: u32):
        var remaining = value
        for index in range(0, 4):
            self.output.append(u8(remaining & u32(255)))
            remaining = remaining >> u32(8)

    pub func write_u64(value: u64):
        var remaining = value
        for index in range(0, 8):
            self.output.append(u8(remaining & u64(255)))
            remaining = remaining >> u64(8)

    ## Signed integers use a fixed-width zigzag payload. This preserves the
    ## complete i64 domain without relying on implementation-defined casts.
    pub func write_i64(value: i64):
        if value >= 0:
            self.write_u64(u64(value) * u64(2))
        else:
            self.write_u64(u64(0 - (value + 1)) * u64(2) + u64(1))

    pub func write_count(value: i64) -> !:
        if value < 0 or value > i64(maximum_table_entries):
            error("package artifact: table count is outside the supported range")
        self.write_u32(u32(value))

    pub func write_bytes(value: list[u8]) -> !:
        if u64(len(value)) > maximum_field_bytes:
            error("package artifact: byte field exceeds 64 MiB")
        self.write_u32(u32(len(value)))
        for byte in value: self.output.append(byte)

    pub func write_text(value: str) -> !:
        try self.write_bytes(strings.to_bytes(value))

    ## Return a detached result so subsequent writer use cannot mutate bytes
    ## already handed to an artifact owner.
    pub func finish() -> list[u8]:
        let result = list[u8]()
        for byte in self.output: result.append(byte)
        return result

# mark: Reader ================================================================================

## Strict cursor over one already size-bounded artifact. Each operation either
## advances completely or reports a stable malformed-artifact diagnostic.
pub class PackageReader:
    let input: list[u8]
    var cursor: i64

    pub init(input: list[u8]):
        self.input = input
        self.cursor = 0

    pub func remaining() -> i64:
        return len(self.input) - self.cursor

    pub func read_u8() -> u8!:
        try self.require(1, "u8")
        let value = self.input[self.cursor]
        self.cursor += 1
        return value

    pub func read_bool() -> bool!:
        let value = try self.read_u8()
        if value == 0: return false
        if value == 1: return true
        error("package artifact: Boolean tag must be 0 or 1")

    pub func read_u32() -> u32!:
        try self.require(4, "u32")
        var value: u32 = 0
        for shift in range(0, 4):
            value = value | (u32(self.input[self.cursor + shift]) << u32(shift * 8))
        self.cursor += 4
        return value

    pub func read_u64() -> u64!:
        try self.require(8, "u64")
        var value: u64 = 0
        for shift in range(0, 8):
            value = value | (u64(self.input[self.cursor + shift]) << u64(shift * 8))
        self.cursor += 8
        return value

    pub func read_i64() -> i64!:
        let encoded = try self.read_u64()
        let magnitude = encoded >> u64(1)
        if magnitude > u64(9223372036854775807):
            error("package artifact: signed integer payload is out of range")
        if encoded & u64(1) == u64(0): return i64(magnitude)
        return 0 - i64(magnitude) - 1

    pub func read_count() -> i64!:
        let value = try self.read_u32()
        if value > maximum_table_entries:
            error("package artifact: table count exceeds 1000000 entries")
        return i64(value)

    pub func read_bytes() -> list[u8]!:
        let count = try self.read_u32()
        if u64(count) > maximum_field_bytes:
            error("package artifact: byte field exceeds 64 MiB")
        try self.require(i64(count), "byte field")
        let result = list[u8]()
        for index in range(0, i64(count)):
            result.append(self.input[self.cursor + index])
        self.cursor += i64(count)
        return result

    pub func read_text() -> str!:
        let encoded = try self.read_bytes()
        return strings.from_bytes(encoded) else error("package artifact: text field is not valid UTF-8")

    pub func finish() -> !:
        if self.cursor != len(self.input):
            error("package artifact: trailing bytes after the final section")

    func require(count: i64, what: str) -> !:
        if count < 0 or count > self.remaining():
            error("package artifact: truncated " + what)
