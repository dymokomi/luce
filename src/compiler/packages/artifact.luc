#==============================================================================================
#
#   package_artifact - Canonical envelope for target-neutral typed packages
#
#   DESCRIPTION:
#       Frames one package identity and one semantic payload. This module owns
#       transport validation only: HIR declarations and typed generic bodies
#       are encoded by their own package codec and remain opaque here.
#
#       The format has no compatibility reader while Luce is in building mode.
#       A compiler accepts exactly its current version and rejects every other
#       one before interpreting payload bytes.
#
#==============================================================================================

from compiler.packages.encoding import PackageReader, PackageWriter

let format_version: u32 = 4

# mark: Model ==================================================================================

## A validated semantic package container. `payload` is still target-neutral
## compiler data; native objects, ABI facts, and executable artifacts never
## pass through this format.
pub struct TypedPackageEnvelope:
    pub let identity: str
    pub let payload: list[u8]

# mark: Encoding ===============================================================================

## Write the one canonical envelope spelling accepted by this compiler.
pub func encode_typed_package(identity: str, payload: list[u8]) -> list[u8]!:
    if len(identity) == 0: error("typed package artifact: identity must not be empty")
    let writer = PackageWriter()
    write_magic(writer)
    writer.write_u32(format_version)
    try writer.write_text(identity)
    try writer.write_bytes(payload)
    return writer.finish()

func write_magic(writer: PackageWriter):
    # `LUCEPKG` plus a zero byte cannot be confused with source text.
    writer.write_u8(0x4C)
    writer.write_u8(0x55)
    writer.write_u8(0x43)
    writer.write_u8(0x45)
    writer.write_u8(0x50)
    writer.write_u8(0x4B)
    writer.write_u8(0x47)
    writer.write_u8(0x00)

# mark: Decoding ===============================================================================

## Validate the complete envelope before exposing its semantic payload.
pub func decode_typed_package(input: list[u8]) -> TypedPackageEnvelope!:
    let reader = PackageReader(input)
    try read_magic(reader)
    let version = try reader.read_u32()
    if version != format_version:
        error("typed package artifact: unsupported format version " + str(u64(version)))
    let identity = try reader.read_text()
    if len(identity) == 0: error("typed package artifact: identity must not be empty")
    let payload = try reader.read_bytes()
    try reader.finish()
    return TypedPackageEnvelope(identity = identity, payload = payload)

func read_magic(reader: PackageReader) -> !:
    try require_magic_byte(reader, 0x4C)
    try require_magic_byte(reader, 0x55)
    try require_magic_byte(reader, 0x43)
    try require_magic_byte(reader, 0x45)
    try require_magic_byte(reader, 0x50)
    try require_magic_byte(reader, 0x4B)
    try require_magic_byte(reader, 0x47)
    try require_magic_byte(reader, 0x00)

func require_magic_byte(reader: PackageReader, expected: u8) -> !:
    let actual = reader.read_u8() catch reason:
        error("typed package artifact: truncated magic")
    if actual != expected: error("typed package artifact: invalid magic")
