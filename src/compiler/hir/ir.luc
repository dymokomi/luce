#==============================================================================================
#
#   hir - Luce after names and types have meaning
#
#   DESCRIPTION:
#       The High-level Intermediate Representation is the compiler's semantic
#       center. Every reference is a `SymbolId`, every type is a `TypeId`, and
#       every operator is a resolved tagged operation.
#       Source spellings such as `"i64"` and `"+"` stop at the
#       HirGenerator and are never reinterpreted by analysis, execution, or lowering.
#
#       HIR keeps readable language structure: functions contain
#       suites, statements contain `if` and `while`, and expressions remain
#       trees — but the tree lives in one flat table. Every statement and
#       expression is a `HirNode` stored inline in `HirProgram.nodes`; a
#       node's `form` is a union whose children are `NodeId`s (indices into
#       that table) and whose child lists are `Operands` (runs inside
#       `HirProgram.extra`). The two fields most walks never read — the
#       result type and the span — sit in parallel arrays, so a node is a
#       tag and its payload. Pattern matching on `form` reads exactly as it
#       would on a pointer tree; only the links are integers. Canonical MIR
#       later flattens control flow the same way.
#
#       The file follows one program from broadest shape to smallest:
#
#       program -> modules/functions -> statements -> expressions
#               -> operations -> types/symbols -> values
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.layout_query import LayoutQuery
from compiler.symbol_attributes import SymbolAttributes
import std.strings
from compiler.runtime_contract import RuntimeService

# mark: Program shape =========================================================================

## One fully resolved and type-checked program. Functions and symbols are flat
## program-wide tables so a resolved identity never requires a module-tree walk.
pub struct HirProgram:
    ## Every package contributing semantic declarations. Numeric identities
    ## keep nodes and modules compact; the opaque string remains the stable
    ## source identity carried by values such as `ErrorCode`.
    pub let packages: list[HirPackage]
    ## The package requested by the compilation command. Dependencies retain
    ## their own package entries when independently typed HIR is composed.
    pub let root_package: PackageId
    ## Exact private functions selected by the sealed package descriptor to
    ## implement semantic runtime services. Later stages use only identities.
    pub let runtime_bindings: list[HirRuntimeBinding]
    ## The root package's exact §20.5 callable, independent from source-public
    ## API and C-export identity. Host process ABI facts remain backend-owned.
    pub let process_entry: SymbolId?
    pub let types: TypeTable
    pub let symbols: list[HirSymbol]
    pub let modules: list[HirModule]
    ## Transparent source names retained for dependency resolution and API
    ## tooling. Their resolved canonical type is the complete semantics; no
    ## source type syntax survives HIR generation.
    pub let aliases: list[HirTypeAlias]
    pub let constants: list[HirConstant]
    pub let structs: list[HirStruct]
    pub let classes: list[HirClass]
    pub let enums: list[HirEnum]
    ## TypeId-aligned concrete views of nominal declaration schemas. Generic
    ## substitution happens once during HIR generation; semantic consumers
    ## never reinterpret declaration parameters independently.
    pub let nominal_applications: list[HirNominalApplication?]
    ## Nominal behavior contracts and explicit type-owned implementations.
    ## These are semantic identities; witness-table layout belongs to a
    ## backend once interface values become executable.
    pub let interfaces: list[HirInterface]
    ## Every canonical `TypeForm.Interface` with its fully substituted
    ## requirement signatures. Consumers never repeat generic substitution.
    pub let interface_applications: list[HirInterfaceApplication]
    pub let conformances: list[HirConformance]
    ## Abstract conformances owned by generic nominal declarations. Concrete
    ## applications materialize ordinary `HirConformance` entries during HIR
    ## generation; no generic fact reaches canonical MIR.
    pub let generic_conformances: list[HirGenericConformance]
    pub let extern_types: list[HirExternType]
    pub let extern_variables: list[HirExternVariable]
    pub let globals: list[HirGlobal]
    ## Anonymous functions with captured storage. Capture-free lambdas reuse
    ## ordinary function addresses and therefore need no environment entry.
    pub let closures: list[HirClosure]
    ## Mutable locals promoted to one shared cell because at least one closure
    ## captures them. Their source types remain unchanged; this table records
    ## the storage/lifetime fact once for every HIR consumer.
    pub let shared_cells: list[SymbolId]
    ## Generic declarations retain their abstractly checked bodies, then become
    ## ordinary concrete functions before MIR lowering.
    pub let generic_functions: list[HirGenericFunction]
    ## Concrete specialization provenance and front-end cost. This is compiler
    ## reporting metadata; executable calls still target ordinary functions.
    pub let generic_instances: list[HirGenericInstance]
    pub let generic_specialization_budget: i64
    pub let functions: list[HirFunction]
    # The node table: every statement and expression, with its result type,
    # source module, and span in parallel arrays, its child lists in `extra`,
    # and literal values in `values`.
    pub let nodes: list[HirNode]
    pub let node_types: list[TypeId]
    pub let node_modules: list[ModuleId]
    pub let node_spans: list[SourceSpan]
    pub let extra: list[u32]
    pub let values: list[Value]

## One independently addressable flat HIR body arena. Source package bodies
## use the lists published directly on `HirProgram`; typed generic templates
## use the same arena shape while keeping their local NodeIds and operand runs
## isolated from executable bodies. This is storage ownership, not a second IR.
pub struct HirBodyArena:
    pub let nodes: list[HirNode]
    pub let node_types: list[TypeId]
    pub let node_modules: list[ModuleId]
    pub let node_spans: list[SourceSpan]
    pub let extra: list[u32]
    pub let values: list[Value]

pub func create_hir_body_arena() -> HirBodyArena:
    return HirBodyArena(
        nodes = list[HirNode](),
        node_types = list[TypeId](),
        node_modules = list[ModuleId](),
        node_spans = list[SourceSpan](),
        extra = list[u32](),
        values = list[Value](),
    )

## Arena-local equivalents of the program body accessors below. Keeping these
## operations on the shared storage contract prevents a generic-body consumer
## from accidentally indexing the executable program arena.
pub func arena_node_at(arena: HirBodyArena, run: Operands, index: i64) -> NodeId:
    return NodeId(value = arena.extra[i64(run.start) + index])

pub func arena_entry_at(arena: HirBodyArena, run: Operands, index: i64) -> i64:
    return i64(arena.extra[i64(run.start) + index])

pub func arena_node_form(arena: HirBodyArena, id: NodeId) -> HirNodeForm:
    return arena.nodes[id.value].form

pub func arena_node_type(arena: HirBodyArena, id: NodeId) -> TypeId:
    return arena.node_types[id.value]

pub func arena_node_module(arena: HirBodyArena, id: NodeId) -> ModuleId:
    return arena.node_modules[id.value]

pub func arena_node_span(arena: HirBodyArena, id: NodeId) -> SourceSpan:
    return arena.node_spans[id.value]

## One package in the target-neutral semantic graph. Runtime privilege is an
## explicit compiler input and never inferred from the identity spelling.
pub struct HirPackage:
    pub let id: PackageId
    pub let identity: str
    pub let role: PackageRole

## The compact identity of one `HirProgram.packages` entry.
pub struct PackageId:
    pub let value: u32

## Resolve the root package without teaching consumers that it is table zero.
pub func root_package(program: HirProgram) -> HirPackage:
    return program.packages[program.root_package.value]

## The identity of one node in `HirProgram.nodes`.
pub struct NodeId:
    pub let value: u32

## "No node": an absent optional child, such as a bare `return`.
pub let no_node: u32 = 4294967295

## A run of `count` entries starting at `start` in `HirProgram.extra`: a
## suite's statements, a call's arguments, a tuple's elements.
pub struct Operands:
    pub let start: u32
    pub let count: u32

## One statement or expression, stored inline in the node table.
pub struct HirNode:
    pub let form: HirNodeForm

## The node a run names at position `index`.
pub func node_at(program: HirProgram, run: Operands, index: i64) -> NodeId:
    return NodeId(value = program.extra[i64(run.start) + index])

## The raw entry at position `index` of a run (a parameter index, a field index).
pub func entry_at(program: HirProgram, run: Operands, index: i64) -> i64:
    return i64(program.extra[i64(run.start) + index])

pub func node_form(program: HirProgram, id: NodeId) -> HirNodeForm:
    return program.nodes[id.value].form

pub func node_type(program: HirProgram, id: NodeId) -> TypeId:
    return program.node_types[id.value]

pub func node_module(program: HirProgram, id: NodeId) -> ModuleId:
    return program.node_modules[id.value]

pub func node_span(program: HirProgram, id: NodeId) -> SourceSpan:
    return program.node_spans[id.value]

## Return the concrete fields of one struct or class application.
pub func nominal_fields(program: HirProgram, value_type: TypeId) -> list[HirNominalField]:
    if i64(value_type.value) >= len(program.nominal_applications): trap("nominal TypeId has no application metadata")
    let nominal = program.nominal_applications[value_type.value] else trap("type has no nominal application metadata")
    match nominal:
        StructApplication(fields): return fields
        ClassApplication(class_value): return class_value.fields
        EnumApplication(cases): trap("enum application has cases, not fields")

## Return the concrete, fully substituted cases of one enum application.
## Consumers must not read payload types from the abstract declaration: two
## applications of the same generic enum may have different payload shapes.
## The value type behind `@T`, or none for any other type.
pub func atomic_inner(types: TypeTable, value_type: TypeId) -> TypeId?:
    match types.definitions[value_type.value].form:
        Atomic(inner): return inner
        else: return none

## The integer an integer-backed enum type is, or none for any other type.
## The C symbol an exported function has: its name, or `Type_method` for
## an exported method with `self` first (base.md §17.6).
pub func exported_c_name(program: HirProgram, function: HirFunction) -> str:
    let receiver = function.receiver
    if receiver == none: return function.name
    return describe_type(program.types, receiver.owner) + "_" + function.name

pub func integer_enum_representation(program: HirProgram, value_type: TypeId) -> TypeId?:
    let shape = integer_enum_shape(program, value_type)
    if shape == none: return none
    return shape.representation

## The case values of an integer-backed enum type, or none for any other type.
pub func integer_enum_shape(program: HirProgram, value_type: TypeId) -> HirCEnum?:
    match program.types.definitions[value_type.value].form:
        Enum(index, arguments):
            if not program.enums[index].is_integer_backed: return none
            return program.enums[index].c_shape
        else: return none

pub func nominal_cases(program: HirProgram, value_type: TypeId) -> list[HirEnumCase]:
    if i64(value_type.value) >= len(program.nominal_applications): trap("nominal TypeId has no application metadata")
    let nominal = program.nominal_applications[value_type.value] else trap("type has no nominal application metadata")
    match nominal:
        EnumApplication(cases): return cases
        StructApplication(fields): trap("struct application has fields, not cases")
        ClassApplication(class_value): trap("class application has fields, not cases")

## Return the concrete payload and lifecycle identities of one class
## application. A generic declaration has one abstract schema, but every
## executable application owns a distinct specialized deinitializer.
pub func class_application(program: HirProgram, value_type: TypeId) -> HirClassApplication:
    if i64(value_type.value) >= len(program.nominal_applications): trap("class TypeId has no application metadata")
    let application = program.nominal_applications[value_type.value] else trap("class type has no application metadata")
    match application:
        ClassApplication(value): return value
        else: trap("class application requested from a non-class type")

## Which explicit C-record boundary a semantic value struct participates in.
## The role changes only admissible crossings; it carries no size, alignment,
## field offset, calling convention placement, or other target fact.
pub enum HirCStructKind:
    external
    exported

## One declared struct. `TypeForm.Struct(index, arguments)` names its
## declaration and concrete generic arguments by position here.
## Fields keep semantic declaration order. Physical placement and any native
## ABI order are backend/boundary facts, never HIR facts.
pub struct HirStruct:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    ## Boundary capability only. Canonical HIR and ordinary MIR continue to
    ## represent this as the same value struct used by every semantic operation.
    pub let c_kind: HirCStructKind?
    ## Where the fields live: in order, or all at the start for a `union`.
    pub let layout: HirRecordLayout
    ## Base layout words (base.md §5.11): `packed struct` removes padding;
    ## `align(N) struct` raises the record's alignment to `N` (0 = natural).
    pub let is_packed: bool
    pub let alignment: i64
    pub let fields: list[HirField]
    ## The custom initializer's function symbol, or none when construction
    ## uses the synthesized memberwise initializer.
    pub let initializer: SymbolId?
    pub let span: SourceSpan

## The C11 memory orders an atomic operation may name (base.md §15.1).
pub enum AtomicOrdering:
    relaxed
    acquire
    release
    acq_rel
    seq_cst

## The read-modify-write operations of an `@T`, each yielding the previous
## value. `clear(mask)` is `and` with the mask's complement.
pub enum AtomicOperation:
    add
    sub
    or_bits
    and_bits
    xor_bits
    swap
    maximum
    minimum

## How a record places its fields. A struct lays them out in declaration
## order; a union (base.md §10.4) overlaps every member at its start, so
## writing one member and reading another reinterprets the bytes.
pub enum HirRecordLayout:
    sequential
    overlapping

## Is this type a Base `union`, a record whose members overlap?
pub func is_union_type(program: HirProgram, value_type: TypeId) -> bool:
    match program.types.definitions[value_type.value].form:
        Struct(index, arguments): return program.structs[index].layout == HirRecordLayout.overlapping
        else: return false

## One declared identity type. `TypeForm.Class(index, arguments)` names its
## declaration and concrete generic arguments here. Fields and lifecycle
## symbols are the declaration schema; generic entries may therefore name
## abstract types and generic-function symbols. `HirClassApplication` owns the
## executable substituted payload and deinitializer for each concrete TypeId.
## Allocation and reference counts are semantic operations, never HIR layout.
pub struct HirClass:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let fields: list[HirField]
    pub let initializer: SymbolId
    pub let deinitializer: SymbolId?
    pub let span: SourceSpan

## One declared enum: a closed sum of cases. `TypeForm.Enum(index, arguments)`
## names its declaration and concrete generic arguments; a case's position is
## its target-neutral semantic identity, not a source ordinal or ABI tag.
pub struct HirEnum:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let cases: list[HirEnumCase]
    ## Present for `export c enum` and for a Base integer-backed enum. Case
    ## positions remain the semantic identity of a tagged enum; this table
    ## maps them to fixed integer values at a C boundary, or, when the enum
    ## is integer-backed, names the values the enum's cases hold.
    pub let c_shape: HirCEnum?
    ## A Base `enum Access as u32:` (base.md §10.3): every value of the enum is
    ## a value of `c_shape.representation`, declared case or not, so `|`, `&`,
    ## `^`, and `~` produce the enum and `match` needs `_`.
    pub let is_integer_backed: bool
    pub let span: SourceSpan

## Target-neutral fixed representation of an exported C enum. Integer width
## and signedness are language types; physical ABI placement remains a backend
## decision. Values align one-for-one with `HirEnum.cases`.
pub struct HirCEnum:
    pub let representation: TypeId
    pub let values: list[Value]

## The fully substituted semantic schema for one canonical nominal TypeId.
## Entries live at the same index as `TypeTable.definitions`; non-nominal
## types have `none` in `HirProgram.nominal_applications`.
pub union HirNominalApplication:
    StructApplication(fields: list[HirNominalField])
    ClassApplication(application: HirClassApplication)
    EnumApplication(cases: list[HirEnumCase])

pub struct HirClassApplication:
    ## Semantic declaration order only; physical layout is backend-owned.
    pub let fields: list[HirNominalField]
    ## Exact concrete function, or none. Construction already records its
    ## concrete initializer directly on each `Initialize` node.
    pub let deinitializer: SymbolId?

## One callable requirement in declaration order. The receiver is implicit
## in this record: `parameters` contains only the arguments after `self`.
pub struct HirInterfaceRequirement:
    pub let symbol: SymbolId
    pub let name: str
    pub let is_mutating: bool
    pub let documentation: list[str]
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let span: SourceSpan

## A compiler-known interface has language identity without pretending to be
## declared by one source module. The closed identity is also how syntax such
## as `for` selects the standard protocol rather than a same-named method.
pub enum StandardInterface:
    iterator
    iterable
    fallible_iterator
    fallible_iterable
    equatable
    hashable
    comparable
    display

pub union HirInterfaceOrigin:
    Source(module: ModuleId)
    Standard(identity: StandardInterface)

## One nominal interface declaration. Generic arguments are carried by
## `TypeForm.Interface`; this table owns the abstract declaration signature.
pub struct HirInterface:
    pub let origin: HirInterfaceOrigin
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let requirements: list[HirInterfaceRequirement]
    pub let span: SourceSpan

## Built-in sequences and user-defined protocols share one source loop but
## retain the semantic operation that actually drives them. A protocol loop
## evaluates `iterator` once into `iterator_symbol`; `next` references that
## private mutable symbol and always has type `T?`. Fallible iteration uses an
## ordinary HIR `Try` around the dynamic `next` call.
pub union HirIteration:
    Builtin(value: NodeId)
    Protocol(iterator_symbol: SymbolId, iterator: NodeId, next: NodeId)

## One concrete application of a nominal interface declaration. Requirement
## symbols/order are preserved while parameter and result types are fully
## substituted for `value_type`'s arguments.
pub struct HirInterfaceApplication:
    pub let value_type: TypeId
    pub let declaration: u32
    pub let requirements: list[HirInterfaceRequirement]

## One explicit nominal conformance. Requirement and implementation symbols
## share declaration order, which later becomes witness-table order without
## introducing layout into HIR.
pub struct HirConformance:
    pub let value_type: TypeId
    pub let interface_type: TypeId
    pub let implementations: list[SymbolId]

## Whether a generic conformance requirement uses its implementation directly
## or through the language's sole infallible-to-fallible adaptation.
pub enum HirConformanceAdaptation:
    direct
    fallible_lift

## One already-checked conformance declared by an abstract generic nominal.
## The types retain its owner's type parameters; materialization substitutes
## them and specializes the corresponding generic methods without source.
pub struct HirGenericConformance:
    pub let module: ModuleId
    pub let generic_id: u32
    pub let value_type: TypeId
    pub let interface_type: TypeId
    pub let is_class: bool
    pub let adaptations: list[HirConformanceAdaptation]
    pub let span: SourceSpan

## The source-declared representation of one opaque C handle. `Pointer` is a
## target-neutral token, not a width or layout; `Integer` names one of the
## four exact-width boundary integers admitted by the parser.
pub union HirExternRepresentation:
    Pointer
    Integer(value_type: TypeId)

## One opaque source-level handle. The handle remains nominal throughout HIR:
## source code cannot construct a nonzero token, perform integer arithmetic on
## it, or confuse two equally represented handles. Canonical MIR erases that
## nominal identity to its target-neutral pointer or integer representation;
## ABI placement still begins only in a backend.
pub struct HirExternType:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let representation: HirExternRepresentation
    pub let span: SourceSpan

## One transparent module-level type name. Resolution has already collapsed
## alias chains to `value_type`; retaining the public name is sufficient for a
## dependent source module to resolve it without replaying dependency source.
pub struct HirTypeAlias:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let value_type: TypeId
    pub let span: SourceSpan

## One mutable C-owned global in the source value namespace. Its type is a
## target-neutral scalar or nominal handle; reads and writes remain explicit
## observable operations through HIR and canonical MIR. In particular, this
## is not compiler-owned global storage and a pointer-handle zero is ordinary
## state here, not a C call-slot crossing.
pub struct HirExternVariable:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let value_type: TypeId
    pub let span: SourceSpan

## One module-level cell: the sealed runtime's zero-initialized private
## storage, or a Base module global (base.md §6.3). Its index in
## `HirProgram.globals` is the stable identity used by HIR nodes.
pub struct HirGlobal:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let value_type: TypeId
    ## The constant expression the cell starts with, or `no_node` for zero.
    pub let initializer: NodeId
    ## One cell per thread (C11 `_Thread_local`) instead of one per process.
    pub let is_thread_local: bool
    pub let span: SourceSpan
    ## Base's declaration words (base.md §9.8), for the backend and linker.
    pub let attributes: SymbolAttributes = SymbolAttributes()

## One captured anonymous function. `function` names its checked body;
## captures are stored in environment-field order and map each hidden body
## binding back to the source value or cell used when the closure is formed.
pub struct HirClosure:
    pub let function: SymbolId
    pub let captures: list[HirCapture]
    pub let span: SourceSpan

## The source-visible type belongs to `symbol`. `source` is present for a
## direct outer binding and lets ownership/cycle analysis retain provenance;
## an explicit `copy name = expression` has no single source symbol.
pub struct HirCapture:
    pub let symbol: SymbolId
    pub let source: SymbolId?
    pub let value_type: TypeId
    pub let kind: HirCaptureKind
    ## The source use or explicit capture that formed this environment field.
    pub let span: SourceSpan

pub enum HirCaptureKind:
    ## Snapshot or strong/reference copy using ordinary value ownership.
    value
    ## One ARC cell shared by the outer scope and every capturing closure.
    shared_cell
    ## A non-owning class slot promoted to `T?` at each source read.
    weak_capture

## One case and its named payload, in declaration order.
pub struct HirEnumCase:
    pub let name: str
    pub let documentation: list[str]
    pub let payload: list[HirPayloadField]

pub struct HirPayloadField:
    pub let name: str
    pub let value_type: TypeId

## One stored field. `default_value` is a constant expression the synthesized
## initializer uses when a construction omits the field.
pub struct HirField:
    pub let name: str
    pub let value_type: TypeId
    pub let is_mutable: bool
    ## `align(N)` before the field raises its alignment to `N` (0 = natural).
    pub let alignment: i64
    ## A class-only optional reference slot that never owns its referent.
    ## Struct fields always set this to false.
    pub let is_weak: bool
    pub let is_public: bool
    pub let documentation: list[str]
    ## `no_node` when the field has no default.
    pub let default_value: NodeId

## One fully applied stored field. Defaults belong to a declaration's
## synthesized initializer rather than to runtime storage, so this schema
## contains only facts semantic consumers need after construction.
pub struct HirNominalField:
    pub let name: str
    pub let value_type: TypeId
    pub let is_mutable: bool
    pub let is_weak: bool
    pub let is_public: bool
    pub let documentation: list[str]

## One module-level constant. Its initializer is already typed; references
## use `symbol`.
pub struct HirConstant:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let value: NodeId

## One source module. `ModuleId.value` is its index in `HirProgram.modules`;
## functions refer back to that identity.
pub struct HirModule:
    pub let id: ModuleId
    pub let package: PackageId
    pub let name: str
    pub let path: str
    ## Authority comes from the package reader, never source text. It governs
    ## which compiler-known native types and operations HIR generation admits.
    pub let authority: ModuleAuthority
    pub let documentation: list[str]

## The kind of a source module, told apart by suffix (base.md §16.2): ordinary
## safe Luce (`.luc`), an audited native module (`.lucn`) that may use the raw
## pointer intrinsics, or a Luce Base module (`.lucb`) that needs no runtime.
## Authority is deliberately not transitive through imports.
pub enum ModuleAuthority:
    safe
    ## Compiler-supplied standard-library source is safe Luce with access to
    ## the closed `Builtin` implementation namespace. Projects cannot acquire
    ## this provenance from source spelling or imports.
    standard
    native
    base

## Ordinary packages cannot own module-global state or the sealed storage
## arena. The compiler constructs the runtime role only for `libluce_rt`.
pub enum PackageRole:
    ordinary
    sealed_runtime

## One semantic runtime service resolved to an exact source function identity.
## The package descriptor supplies the spelling once; HIR consumers never
## repeat that lookup.
pub struct HirRuntimeBinding:
    pub let service: RuntimeService
    pub let function: SymbolId

## One checked function, method, export, or import. Every source-level
## callable has one symbol and one table identity; `implementation` says
## whether its code is present or supplied by the C boundary. Calls therefore
## retain one shape through HIR instead of duplicating lookup and argument
## placement for ordinary and external functions.
##
## A value method is a function whose first
## parameter is `self` and whose `receiver` names the struct; a type function
## (`Point.origin`) has a receiver but no `self`. An initializer is kept
## distinct from both: its source result is `unit` or `unit!`, while a
## construction expression produces the receiver value. Documentation, parameter
## names, and defaults are retained on purpose: `luce describe` and
## `luce api diff` read them.
pub struct HirFunction:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let receiver: HirReceiver?
    ## The captured environment this body receives, or none for a declared or
    ## capture-free generated function.
    pub let closure: u32?
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let implementation: HirFunctionImplementation
    pub let span: SourceSpan
    ## Base's declaration words (base.md §9.8), for the backend and linker.
    pub let attributes: SymbolAttributes = SymbolAttributes()

## One source declaration slot in an external C function. Inputs point back
## into the ordinary callable parameter list; outputs have no source argument
## and become source-visible result components after the call. The order here
## is C declaration order, before any target chooses ABI placement.
pub union HirCSlot:
    Input(parameter: u32)
    Output(name: str, value_type: TypeId)

## Target-neutral C-only facts attached to an external implementation. The
## function's ordinary `parameters` and `result` remain exactly what a Luce
## caller sees; `declared_result` and `slots` retain the raw source contract
## needed by the one boundary adapter.
pub struct HirCFunction:
    pub let is_blocking: bool
    pub let slots: list[HirCSlot]
    pub let declared_result: TypeId
    ## `extern func printf(format: cstr, ...)`: extra arguments follow the
    ## declared ones under C's promotions (base.md §17.2).
    pub let is_variadic: bool = false
    ## The C symbol, when `as "symbol"` names one; empty means the function's name.
    pub let symbol: str = ""

## The three possible origins of a source-level callable. `ExportedC` is a
## defined Luce body with an externally visible C symbol; `ExternalC` is a C
## symbol supplied by the artifact host. C target ABI placement remains a
## backend fact—the HIR records only the language-level boundary contract.
pub union HirFunctionImplementation:
    Defined(body: Operands)
    ExportedC(body: Operands)
    ExternalC(contract: HirCFunction)

## Return a defined function's body. Consumers that walk bodies use this
## after rejecting `ExternalC`, so an impossible request is a compiler bug.
pub func function_body(function: HirFunction) -> Operands:
    match function.implementation:
        Defined(body): return body
        ExportedC(body): return body
        ExternalC(contract): trap("external function has no HIR body")

## The five meaningful receiver protocols. Keeping this as one closed choice
## prevents impossible combinations of `has_self`, `is_mutating`, and
## `is_initializer` from leaking into later stages.
pub enum HirReceiverKind:
    type_function
    value_method
    mutating_method
    initializer
    deinitializer

## A generic template call is still typed HIR, but not yet executable HIR.
## The HIR specializer replaces this distinction with `Call` or `Initialize`;
## canonical MIR therefore never needs a generic-call variant.
pub enum HirGenericCallKind:
    function
    initializer

## Which type a member belongs to and how its receiver crosses the call
## boundary. Initializers and mutating methods both receive writable storage,
## but only a mutating method starts from an existing caller value.
pub struct HirReceiver:
    pub let owner: TypeId
    pub let kind: HirReceiverKind

## One parameter. Its diagnostic name remains, but references use its symbol.
## `default_value` is a constant expression embedded at every call site that
## omits the argument (spec §8.2).
pub struct HirParameter:
    pub let symbol: SymbolId
    pub let name: str
    pub let value_type: TypeId
    ## `no_node` when the parameter has no default.
    pub let default_value: NodeId

## One abstract type parameter owned by a generic declaration. Constraints
## attach here as interface identities; equally named parameters from two
## declarations remain semantically distinct.
pub struct HirTypeParameter:
    pub let name: str
    pub let value_type: TypeId
    pub let constraints: list[TypeId]

## A checked generic source signature. Executable calls always target one
## memoized concrete `HirFunction`; this table retains the abstract API for
## diagnostics, package tooling, specialization, and serialization.
pub struct HirGenericFunction:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    ## Present when the template belongs to a generic nominal declaration.
    ## Every executable specialization substitutes this abstract receiver.
    pub let receiver: HirReceiver?
    pub let generic_id: u32
    ## Number of leading type parameters fixed by an applied nominal owner.
    ## The remaining parameters belong to the method declaration itself.
    pub let owner_parameter_count: i64
    pub let type_parameters: list[HirTypeParameter]
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    ## The abstractly checked implementation. Its NodeIds are local to this
    ## body and never index the executable arrays on `HirProgram`.
    pub let body: HirGenericBody
    pub let span: SourceSpan

## One retained generic implementation before type substitution. Types and
## symbols use the program-wide semantic tables, while nodes and closure-table
## indexes are local to this body. `defaults` is parameter-aligned and uses
## `no_node` for parameters without a source default.
pub struct HirGenericBody:
    pub let arena: HirBodyArena
    pub let body: Operands
    pub let defaults: list[NodeId]
    ## Symbols allocated while checking the body, excluding its already-owned
    ## declaration symbol and parameter symbols. A specializer remaps these
    ## locals and generated-function identities for each concrete instance.
    pub let local_symbols: list[SymbolId]
    pub let closures: list[HirClosure]
    pub let shared_cells: list[SymbolId]
    pub let generated_functions: list[HirFunction]

## One concrete generic callable and the source request that created it.
## `parent` forms an acyclic expansion path through this same table.
pub struct HirGenericInstance:
    pub let generic: u32
    pub let function: SymbolId
    pub let arguments: list[TypeId]
    pub let origin_module: ModuleId
    pub let origin_span: SourceSpan
    pub let parent: u32?
    pub let checked_nodes: u32
    pub let check_time_ms: i64

## Canonical target-neutral name of one concrete source function at the MIR
## boundary. Generated helpers use their own MIR-owned names.
pub func executable_function_name(program: HirProgram, function: HirFunction) -> str:
    let module = program.modules[function.module.value]
    let symbol_name = program.symbols[function.symbol.value].name
    let receiver = function.receiver
    if receiver != none:
        return module.name + "." + describe_type(program.types, receiver.owner) + "." + symbol_name
    return module.name + "." + symbol_name

# mark: Statements and expressions ============================================================

## Every node form. Statements come first, then expressions; a `NodeId`
## child names another node, an `Operands` child names a run in `extra`.
##
## Assignment carries a resolved operation, so consumers never need to
## interpret source spellings such as `+=`. `print` of a literal is
## `PrintText`; `print` of any other `str` expression is `PrintValue`, whose
## text exists only at run time. `PlaceAssignment` is an assignment through
## a mutable root binding (a `var` local, or `self` in a mutating method).
## Its `steps` are pairs in `extra`: a value/class field step plus a resolved
## field index, or an element step plus the NodeId of a checked `u64` index.
## Class-field steps cross shared identity without requiring a mutable root;
## weak-field steps expose the same source type but use non-owning storage.
## This one semantic path represents mixed places such as
## `model.document.pages[i]` without preserving source names or syntax.
## `IfStatement.branches` is a run of triples `(condition, body start, body
## count)`; `fallback` is the `else` suite when `has_fallback`.
##
## Calls target symbols; `arguments` is a run of pairs `(parameter index,
## node)`, so evaluation performs no name resolution, and a method call is a
## `Call` whose argument 0 is the receiver. `Initialize` has the same placed
## argument representation but omits parameter 0: execution supplies fresh
## receiver storage and returns it after the initializer succeeds.
## `StructValue.fields` and `EnumValue.payload` are runs of pairs `(field
## index, node)` in source evaluation order. Defaults are appended after
## explicit fields in declaration order. This is the same placed-argument
## convention as calls: storage order never changes source evaluation order.
## `Constant` names an entry of `HirProgram.values`.
##
## `Match` selects one arm; `arms` is a run of `MatchArm` nodes. An arm's
## `patterns` is a run of pattern nodes (alternatives), its `statements` the
## suite (statement form) and `value` the yielded node (expression form,
## `no_node` otherwise); `guard` is the arm's Base guard condition or
## `no_node` (base.md §8.4). A `PatternCase` names an enum case by index — or,
## for an optional subject, 0 for `.none` and 1 for `.some` — and its
## `bindings` are the symbols its payload lands in, one per payload field.
pub union HirNodeForm:
    ## `break`/`continue` leaving `levels` loops beyond the innermost, 0 for
    ## the innermost; a Base label resolves to this count (base.md §8.5).
    BreakStatement(levels: i64)
    ContinueStatement(levels: i64)
    Binding(symbol: SymbolId, is_mutable: bool, value: NodeId)
    Assignment(symbol: SymbolId, operation: AssignmentOperation, value: NodeId)
    ExternStore(variable: u32, operation: AssignmentOperation, value: NodeId)
    ## `*p = v` and `p.field = v` (base.md §7.7): a store through a Base
    ## pointer, then `steps` as `PlaceAssignment` spells them.
    PointerStore(pointer: NodeId, steps: Operands, operation: AssignmentOperation, value: NodeId)
    GlobalStore(global: u32, operation: AssignmentOperation, value: NodeId)
    PlaceAssignment(symbol: SymbolId, steps: Operands, operation: AssignmentOperation, value: NodeId)
    ## A resolved field/element path rooted in sealed runtime state. Ordinary
    ## application source cannot construct one because it cannot own globals.
    GlobalPlaceAssignment(global: u32, steps: Operands, operation: AssignmentOperation, value: NodeId)
    PrintText(value: str)
    PrintValue(value: NodeId)
    ReturnStatement(value: NodeId)
    RecoverStatement(value: NodeId)
    DeferStatement(action: NodeId)
    ## `errdefer`: an action run only when an error leaves the scope, in
    ## order with the scope's ordinary deferred actions (base.md §8.8).
    ErrorDeferStatement(action: NodeId)
    ExpressionStatement(value: NodeId)
    IfStatement(branches: Operands, has_fallback: bool, fallback: Operands)
    WhileStatement(condition: NodeId, body: Operands)
    ForStatement(symbol: SymbolId, iteration: HirIteration, body: Operands)
    Constant(value: u32)
    Reference(symbol: SymbolId)
    ExternLoad(variable: u32)
    GlobalLoad(global: u32)
    ## Closed operations available only in audited native modules. The pointer
    ## type carries pointee and mutability; these nodes need no target layout.
    NativeLoad(pointer: NodeId)
    NativeStore(pointer: NodeId, value: NodeId)
    NativeAdvance(pointer: NodeId, count: NodeId)
    ## Reinterpret one audited native address with a contextual pointee type.
    ## Mutability may be preserved or reduced, never introduced.
    NativeRebind(pointer: NodeId)
    ## Move `count` typed elements between possibly overlapping native ranges.
    NativeMove(destination: NodeId, source: NodeId, count: NodeId)
    ## Request `count` values of one structural type from the bound allocator.
    ## Only sealed runtime source can construct this node.
    NativeAllocate(element_type: TypeId, count: NodeId)
    ## Return one exact typed allocation to the bound runtime deallocator.
    ## The pointee identity and element count remain target-independent.
    NativeDeallocate(pointer: NodeId, element_type: TypeId, count: NodeId)
    ## Test the inert/null address without exposing an integer representation.
    NativeIsNull(pointer: NodeId)
    ## Compare two equally typed audited addresses for identity without
    ## exposing their numeric representation. Only sealed runtime source may
    ## construct this node.
    NativeIsSame(left: NodeId, right: NodeId)
    ## Produce one execution-local opaque mixed code for an audited native
    ## address. The sealed runtime uses it only to seed private hash tables;
    ## source code can never observe pointer representation.
    NativeAddressHash(pointer: NodeId)
    ## Return an f32/f64 operand's IEEE encoding in the low 32/all 64 bits.
    ## Only the sealed runtime can use this target-independent scalar fact.
    NativeFloatBits(value: NodeId)
    ## Ensure the sealed process arena contains `end` bytes and return its
    ## stable byte base. Only the runtime package can construct this node.
    NativeArena(end: NodeId)
    ## One explicit numeric construction. The destination is the node type;
    ## the operand retains its independently resolved source type. Integer
    ## range checks and floating-width rounding are semantic, never backend
    ## defaults.
    NumericConvert(value: NodeId)
    ## `&place` (base.md §6.6): the address of a local (`symbol`), a global
    ## (`global`), or the pointee of `pointer`, followed by `steps` as
    ## `PlaceAssignment` spells them. Exactly one root is present.
    AddressOf(pointer: NodeId, symbol: SymbolId, global: i64, steps: Operands)
    ## `*p`: the value a Base pointer addresses (base.md §7.7).
    Deref(pointer: NodeId)
    ## `T*` read as `const T*`: the same address under a stricter type.
    QualifyPointer(value: NodeId)
    ## `p + n` and `p - n` (`negate`): element-scaled, unchecked (base.md §7.7).
    PointerOffset(pointer: NodeId, offset: NodeId, negate: bool)
    ## `p - q`: the element difference of two pointers into one object, as `isize`.
    PointerDifference(left: NodeId, right: NodeId)
    ## A Base span (base.md §5.4) from an element pointer and a `usize` count;
    ## an array converts to one through the address of its first element.
    SpanFromParts(pointer: NodeId, length: NodeId)
    ## `span.length` as `usize` and `span.data` as the element pointer.
    SpanLength(span: NodeId)
    SpanData(span: NodeId)
    ## `&span[index]`: the checked address of one element, as `T*`.
    SpanElementAddress(span: NodeId, index: NodeId)
    ## `span[start..<end]` (`inclusive` for `..=`): a checked sub-span.
    SpanSlice(span: NodeId, start: NodeId, end: NodeId, inclusive: bool)
    ## The all-zero value of the node's zeroable type (base.md §6.1).
    ZeroValue
    ## Storage the program will write before it reads (base.md §6.2); the
    ## reference interpreter holds a zero there.
    Uninitialized
    ## A layout question about `subject` (`sizeof`, `alignof`, or `offsetof` of
    ## its field `field`; -1 otherwise), typed `usize`. HIR carries the
    ## question, never the answer: only a backend knows the target's layout
    ## (base.md §5.11).
    LayoutConstant(query: LayoutQuery, subject: TypeId, field: i64)
    ## C's cast of a number to the node's type (base.md §7.5): low bits between
    ## integers, truncation saturating to the range from a float, IEEE
    ## conversion into a float. Never a trap.
    Cast(value: NodeId)
    ## `Access(n)`, the checked conversion into an integer-backed enum
    ## (base.md §10.3): the integer when it is a declared case, else a trap.
    EnumFromInteger(value: NodeId)
    ## A Base allocation (base.md §12.2), a fallible expression. `request` is
    ## the `allocate` call on the chosen allocator, typed `u8[]?`; `none`
    ## fails the expression with `code` and `message`. Otherwise the block
    ## holds `initializer`'s value when it is a node, is zeroed when `zeroed`,
    ## and is left unwritten otherwise; `count` is `no_node` for one value
    ## and the element count for a span result.
    Allocate(prelude: Operands, request: NodeId, initializer: NodeId, count: NodeId, zeroed: bool, code: NodeId, message: NodeId)
    ## `with allocator:` (base.md §12.3): `allocator`, an `Allocator` view, is
    ## the current allocator, global `global`, for `body`; the previous value
    ## returns on every exit.
    WithAllocator(global: u32, allocator: NodeId, body: Operands)
    ## The operations on an `@T` location (base.md §15.1); `address` is the
    ## location's address, an `AddressOf` or a pointer expression.
    AtomicLoad(address: NodeId, order: AtomicOrdering)
    AtomicStore(address: NodeId, value: NodeId, order: AtomicOrdering)
    ## `atomic.fence(order)`: a standalone fence, or a compiler-only
    ## barrier when `is_signal` (base.md §15.1).
    AtomicFence(order: AtomicOrdering, is_signal: bool)
    ## A read-modify-write that yields the previous value.
    AtomicUpdate(operation: AtomicOperation, address: NodeId, value: NodeId, order: AtomicOrdering)
    ## `cas`: yields `(bool, T)`, whether it exchanged and the value observed.
    AtomicCompareExchange(address: NodeId, expected: NodeId, desired: NodeId, success: AtomicOrdering, failure: AtomicOrdering, is_weak: bool)
    ## Evaluate one non-fallible value exactly once and intentionally abandon
    ## its result. Managed lifetime remains ordinary full-expression cleanup.
    Discard(value: NodeId)
    ## Adapt an uninhabited expression to the value type required by its
    ## context. The wrapper can never produce that value; retaining it makes
    ## bottom coercion explicit without lying about an enclosing operation's
    ## ordinary result type.
    NeverCoercion(value: NodeId)
    ## Evaluate an eager prefix in source order through its terminating final
    ## expression. The outer operation is absent because it is unreachable.
    ## This is semantic control flow, not a backend-specific sequence form.
    DivergingSequence(values: Operands)
    ## Count Unicode scalar values by decoding valid UTF-8. `byte_count`
    ## remains the O(1) structural length carried by the string value.
    StringScalarCount(value: NodeId)
    ## Copy exact bytes out of C-owned memory. The opaque token and logical
    ## count are semantic facts; pointer layout belongs to an artifact backend.
    ForeignBytesCopy(pointer: NodeId, count: NodeId)
    ## Copy one NUL-terminated C string and validate its bytes as UTF-8.
    ## Ownership of the foreign allocation remains with the caller.
    ForeignCStringCopy(pointer: NodeId)
    ## Convert one closed builtin scalar to its canonical user-facing text.
    ## Nominal, constrained-generic, and existential values use ordinary
    ## resolved calls to the standard `Display.display` requirement instead.
    BuiltinDisplay(value: NodeId)
    ## Assemble already converted string pieces in source evaluation order.
    ## The representation deliberately retains no literal spelling or field
    ## boundary; MIR chooses one linear builder after evaluating every piece.
    FormattedString(parts: Operands)
    ## Produce one execution-local structural hash. The operand type has
    ## already been proven to belong to the closed `Hashable` family.
    Hash(value: NodeId)
    SequenceLength(value: NodeId)
    SequenceIndex(value: NodeId, index: NodeId)
    Unary(operation: UnaryOperation, operand: NodeId)
    Binary(left: NodeId, operation: BinaryOperation, right: NodeId)
    Conditional(value: NodeId, condition: NodeId, alternative: NodeId)
    Range(lower: NodeId, upper: NodeId, inclusive: bool)
    Call(function: SymbolId, arguments: Operands)
    ## A call to a variadic extern (base.md §17.2): the declared arguments
    ## placed as for `Call`, then the extra values already promoted.
    CVariadicCall(function: SymbolId, arguments: Operands, extras: Operands)
    ## Start one statically named Luce function in an isolated worker. Placed
    ## arguments retain ordinary call evaluation order; the node type is the
    ## locally scoped `Task(result)` handle.
    Spawn(function: SymbolId, arguments: Operands)
    ## Template-only call retaining the resolved generic declaration and its
    ## inferred semantic type arguments. `arguments` uses the ordinary placed
    ## call convention. The specializer removes this node before MIR.
    GenericCall(generic: u32, type_arguments: Operands, arguments: Operands, kind: HirGenericCallKind)
    ## Template-only spawn. Specialization resolves the concrete worker
    ## function before canonical MIR, exactly as for `GenericCall`.
    GenericSpawn(generic: u32, type_arguments: Operands, arguments: Operands)
    ## Template-only reference to one generic callable with all arguments
    ## inferred from its contextual function type.
    GenericFunctionAddress(generic: u32, type_arguments: Operands)
    ## An omitted generic parameter default. The callee declaration owns the
    ## typed default tree; specialization substitutes and clones it exactly.
    GenericDefaultArgument(generic: u32, parameter: u32, type_arguments: Operands)
    ## Template-only call fixed to one written interface requirement. Concrete
    ## conformance lookup happens during HIR specialization, never by name.
    GenericRequirementCall(interface_type: TypeId, requirement: u32, arguments: Operands)
    ## Template-only existential conversion. Abstract checking proves the
    ## requirement but does not retain the probe transaction's temporary
    ## conformance index; specialization resolves the concrete identity.
    GenericInterfaceValue(value: NodeId)
    ## Package one concrete value with an explicit conformance identity. The
    ## node type is the existential interface; physical storage is absent.
    InterfaceValue(value: NodeId, conformance: u32)
    ## Dynamically invoke one requirement in the interface's declaration
    ## order. The receiver supplies the concrete implementation at run time.
    ## `arguments` is a source-ordered run of (requirement parameter, node)
    ## pairs, matching direct calls while the receiver remains explicit.
    InterfaceCall(receiver: NodeId, interface_type: TypeId, requirement: u32, arguments: Operands)
    FunctionAddress(function: SymbolId)
    ## Form one managed function value. Initializers align with the closure's
    ## capture table; `no_node` denotes a shared cell whose storage is taken
    ## directly rather than read as a source value.
    ClosureValue(closure: u32, initializers: Operands)
    ## Read the optional source view of one hidden weak capture.
    WeakCaptureReference(symbol: SymbolId)
    IndirectCall(callee: NodeId, arguments: Operands)
    Initialize(function: SymbolId, arguments: Operands)
    ErrorCodeLiteral(package: PackageId, value: u32)
    Raise(code: NodeId, message: NodeId)
    ## Terminate the execution domain with one eagerly evaluated string.
    ## Unlike `Raise`, this is not recoverable and runs no lexical cleanup.
    Trap(message: NodeId)
    ## Evaluate both ordinary call arguments from left to right. Continue with
    ## unit when the condition is true; otherwise report the string and trap.
    Assert(condition: NodeId, message: NodeId)
    Try(value: NodeId)
    Catch(value: NodeId, failure: SymbolId, body: Operands)
    TaskWait(value: NodeId)
    TaskCancel(value: NodeId)
    TaskWaitAll(tasks: NodeId)
    Tuple(elements: Operands)
    Array(elements: Operands)
    ## Construct a fresh reference-identity list and append each element in
    ## source order.
    List(elements: Operands)
    ## Produce a shallow copy with independent list identity and storage.
    ListCopy(value: NodeId)
    ## Recursively copy one mutable collection graph into its immutable,
    ## sendable value counterpart. The node result distinguishes frozen
    ## list/map/set; no runtime representation or serializer enters HIR.
    CollectionSnapshot(value: NodeId)
    ## Invoke one function value synchronously with shape-stable mutable
    ## access to the list's current element sequence.
    ListWithMutableSlice(value: NodeId, callback: NodeId)
    ## Capture one immutable half-open view from a supported contiguous
    ## sequence. Missing bounds use zero and the receiver's length without
    ## re-evaluating it; its resolved type determines the retained backing.
    SequenceSlice(value: NodeId, start: NodeId, end: NodeId)
    ## Append one element to an existing list and produce unit.
    ListAppend(value: NodeId, element: NodeId)
    ## Shape-changing list operations retain source evaluation order and
    ## leave capacity policy to the runtime.
    ListInsert(value: NodeId, index: NodeId, element: NodeId)
    ListRemoveAt(value: NodeId, index: NodeId)
    ListClear(value: NodeId)
    ListReserve(value: NodeId, minimum_capacity: NodeId)
    ## Construct and operate on insertion-ordered reference hash collections.
    ## Map entry operands are alternating key/value nodes so the compact arena
    ## representation needs no parallel HIR side table.
    Map(entries: Operands)
    Set(elements: Operands)
    MapLookup(value: NodeId, key: NodeId)
    MapRemove(value: NodeId, key: NodeId)
    MapClear(value: NodeId)
    MapReserve(value: NodeId, minimum_capacity: NodeId)
    MapCopy(value: NodeId)
    SetContains(value: NodeId, element: NodeId)
    SetInsert(value: NodeId, element: NodeId)
    SetRemove(value: NodeId, element: NodeId)
    SetClear(value: NodeId)
    SetReserve(value: NodeId, minimum_capacity: NodeId)
    SetCopy(value: NodeId)
    ## Construct and atomically promote compiler-known `Weak[T]` values.
    WeakCreate(value: NodeId)
    WeakGet(value: NodeId)
    Element(value: NodeId, index: i64)
    StructValue(struct_index: i64, fields: Operands)
    FieldAccess(value: NodeId, field: i64)
    NoneLiteral
    Some(value: NodeId)
    ElseFallback(value: NodeId, arm: NodeId)
    EnumValue(enum_index: i64, case_index: i64, payload: Operands)
    Match(subject: NodeId, arms: Operands, has_result: bool)
    MatchArm(patterns: Operands, statements: Operands, value: NodeId, guard: NodeId)
    PatternWildcard
    PatternLiteral(value: u32)
    PatternRange(lower: u32, upper: u32, inclusive: bool)
    PatternCase(case_index: i64, bindings: Operands)

## Whether evaluating this node is statically known not to complete normally.
## `NeverCoercion` keeps its contextual value type, so the explicit form is as
## important as the canonical `never` type identity.
## Append every node that `node` refers to, in evaluation order: operands
## first, then nested statement suites and match arms. Absent optional
## operands are skipped. This is the one place that knows every form's
## operand shape; a walker matches the few forms it treats specially and
## sends everything else here.
pub func node_children(program: HirProgram, node: NodeId, into: list[NodeId]):
    match node_form(program, node):
        Binding(symbol, is_mutable, value): into.append(value)
        Assignment(symbol, operation, value): into.append(value)
        ExternStore(variable, operation, value): into.append(value)
        GlobalStore(global, operation, value): into.append(value)
        PlaceAssignment(symbol, steps, operation, value):
            place_step_nodes(program, steps, into)
            into.append(value)
        GlobalPlaceAssignment(global, steps, operation, value):
            place_step_nodes(program, steps, into)
            into.append(value)
        PrintValue(value): into.append(value)
        ReturnStatement(value): optional_node(value, into)
        RecoverStatement(value): optional_node(value, into)
        DeferStatement(action): into.append(action)
        ErrorDeferStatement(action): into.append(action)
        ExpressionStatement(value): into.append(value)
        IfStatement(branches, has_fallback, fallback):
            for branch in range(0, i64(branches.count) // 3):
                into.append(NodeId(value = program.extra[i64(branches.start) + branch * 3]))
                run_nodes(program, Operands(start = program.extra[i64(branches.start) + branch * 3 + 1], count = program.extra[i64(branches.start) + branch * 3 + 2]), into)
            if has_fallback: run_nodes(program, fallback, into)
        WhileStatement(condition, body):
            into.append(condition)
            run_nodes(program, body, into)
        ForStatement(symbol, iteration, body):
            match iteration:
                Builtin(value): into.append(value)
                Protocol(iterator_symbol, iterator, next):
                    into.append(iterator)
                    into.append(next)
            run_nodes(program, body, into)
        NativeLoad(pointer): into.append(pointer)
        NativeStore(pointer, value):
            into.append(pointer)
            into.append(value)
        NativeAdvance(pointer, count):
            into.append(pointer)
            into.append(count)
        NativeRebind(pointer): into.append(pointer)
        NativeMove(destination, source, count):
            into.append(destination)
            into.append(source)
            into.append(count)
        NativeAllocate(element_type, count): into.append(count)
        NativeDeallocate(pointer, element_type, count):
            into.append(pointer)
            into.append(count)
        NativeIsNull(pointer): into.append(pointer)
        NativeIsSame(left, right):
            into.append(left)
            into.append(right)
        NativeAddressHash(pointer): into.append(pointer)
        NativeFloatBits(value): into.append(value)
        NativeArena(end): into.append(end)
        NumericConvert(value): into.append(value)
        AddressOf(pointer, symbol, global, steps):
            if pointer.value != no_node: into.append(pointer)
            place_step_nodes(program, steps, into)
        Deref(pointer): into.append(pointer)
        QualifyPointer(value): into.append(value)
        PointerOffset(pointer, offset, negate):
            into.append(pointer)
            into.append(offset)
        PointerDifference(left, right):
            into.append(left)
            into.append(right)
        SpanFromParts(pointer, length):
            into.append(pointer)
            into.append(length)
        SpanLength(span): into.append(span)
        SpanData(span): into.append(span)
        SpanElementAddress(span, index):
            into.append(span)
            into.append(index)
        SpanSlice(span, start, end, inclusive):
            into.append(span)
            into.append(start)
            if end.value != no_node: into.append(end)
        ZeroValue: pass
        Uninitialized: pass
        PointerStore(pointer, steps, operation, value):
            into.append(pointer)
            place_step_nodes(program, steps, into)
            into.append(value)
        LayoutConstant(query, subject, field): pass
        Cast(value): into.append(value)
        EnumFromInteger(value): into.append(value)
        Allocate(prelude, request, initializer, count, zeroed, code, message):
            run_nodes(program, prelude, into)
            into.append(request)
            optional_node(initializer, into)
            optional_node(count, into)
            into.append(code)
            into.append(message)
        WithAllocator(global, allocator, body):
            into.append(allocator)
            run_nodes(program, body, into)
        AtomicLoad(address, order): into.append(address)
        AtomicStore(address, value, order):
            into.append(address)
            into.append(value)
        AtomicFence(order, is_signal): pass
        CVariadicCall(function, arguments, extras):
            placed_nodes(program, arguments, into)
            run_nodes(program, extras, into)
        AtomicUpdate(operation, address, value, order):
            into.append(address)
            into.append(value)
        AtomicCompareExchange(address, expected, desired, success, failure, is_weak):
            into.append(address)
            into.append(expected)
            into.append(desired)
        Discard(value): into.append(value)
        NeverCoercion(value): into.append(value)
        DivergingSequence(values): run_nodes(program, values, into)
        StringScalarCount(value): into.append(value)
        ForeignBytesCopy(pointer, count):
            into.append(pointer)
            into.append(count)
        ForeignCStringCopy(pointer): into.append(pointer)
        BuiltinDisplay(value): into.append(value)
        FormattedString(parts): run_nodes(program, parts, into)
        Hash(value): into.append(value)
        SequenceLength(value): into.append(value)
        SequenceIndex(value, index):
            into.append(value)
            into.append(index)
        Unary(operation, operand): into.append(operand)
        Binary(left, operation, right):
            into.append(left)
            into.append(right)
        Conditional(value, condition, alternative):
            into.append(condition)
            into.append(value)
            into.append(alternative)
        Range(lower, upper, inclusive):
            into.append(lower)
            into.append(upper)
        Call(function, arguments): placed_nodes(program, arguments, into)
        Spawn(function, arguments): placed_nodes(program, arguments, into)
        GenericCall(generic, type_arguments, arguments, kind): placed_nodes(program, arguments, into)
        GenericSpawn(generic, type_arguments, arguments): placed_nodes(program, arguments, into)
        GenericRequirementCall(interface_type, requirement, arguments): placed_nodes(program, arguments, into)
        GenericInterfaceValue(value): into.append(value)
        InterfaceValue(value, conformance): into.append(value)
        InterfaceCall(receiver, interface_type, requirement, arguments):
            into.append(receiver)
            placed_nodes(program, arguments, into)
        ClosureValue(closure, initializers): run_nodes(program, initializers, into)
        IndirectCall(callee, arguments):
            into.append(callee)
            run_nodes(program, arguments, into)
        Initialize(function, arguments): placed_nodes(program, arguments, into)
        Raise(code, message):
            into.append(code)
            into.append(message)
        Trap(message): into.append(message)
        Assert(condition, message):
            into.append(condition)
            into.append(message)
        Try(value): into.append(value)
        Catch(value, failure, body):
            into.append(value)
            run_nodes(program, body, into)
        TaskWait(value): into.append(value)
        TaskCancel(value): into.append(value)
        TaskWaitAll(tasks): into.append(tasks)
        Tuple(elements): run_nodes(program, elements, into)
        Array(elements): run_nodes(program, elements, into)
        List(elements): run_nodes(program, elements, into)
        ListCopy(value): into.append(value)
        CollectionSnapshot(value): into.append(value)
        ListWithMutableSlice(value, callback):
            into.append(value)
            into.append(callback)
        SequenceSlice(value, start, end):
            into.append(value)
            optional_node(start, into)
            optional_node(end, into)
        ListAppend(value, element):
            into.append(value)
            into.append(element)
        ListInsert(value, index, element):
            into.append(value)
            into.append(index)
            into.append(element)
        ListRemoveAt(value, index):
            into.append(value)
            into.append(index)
        ListClear(value): into.append(value)
        ListReserve(value, minimum_capacity):
            into.append(value)
            into.append(minimum_capacity)
        Map(entries): run_nodes(program, entries, into)
        Set(elements): run_nodes(program, elements, into)
        MapLookup(value, key):
            into.append(value)
            into.append(key)
        MapRemove(value, key):
            into.append(value)
            into.append(key)
        MapClear(value): into.append(value)
        MapReserve(value, minimum_capacity):
            into.append(value)
            into.append(minimum_capacity)
        MapCopy(value): into.append(value)
        SetContains(value, element):
            into.append(value)
            into.append(element)
        SetInsert(value, element):
            into.append(value)
            into.append(element)
        SetRemove(value, element):
            into.append(value)
            into.append(element)
        SetClear(value): into.append(value)
        SetReserve(value, minimum_capacity):
            into.append(value)
            into.append(minimum_capacity)
        SetCopy(value): into.append(value)
        WeakCreate(value): into.append(value)
        WeakGet(value): into.append(value)
        Element(value, index): into.append(value)
        StructValue(struct_index, fields): placed_nodes(program, fields, into)
        FieldAccess(value, field): into.append(value)
        Some(value): into.append(value)
        ElseFallback(value, arm):
            into.append(value)
            into.append(arm)
        EnumValue(enum_index, case_index, payload): placed_nodes(program, payload, into)
        Match(subject, arms, has_result):
            into.append(subject)
            run_nodes(program, arms, into)
        MatchArm(patterns, statements, value, guard):
            run_nodes(program, patterns, into)
            optional_node(guard, into)
            run_nodes(program, statements, into)
            optional_node(value, into)
        else: pass

## The nodes of one plain run. An absent entry (a capture that has no
## initializer, say) is not a child.
pub func run_nodes(program: HirProgram, run: Operands, into: list[NodeId]):
    for position in range(0, i64(run.count)): optional_node(node_at(program, run, position), into)

## The value nodes of a placed run: `(declaration slot, node)` pairs.
pub func placed_nodes(program: HirProgram, run: Operands, into: list[NodeId]):
    for pair in range(0, i64(run.count) // 2):
        into.append(NodeId(value = u32(entry_at(program, run, pair * 2 + 1))))

## The index nodes of a place path: `(step, payload)` pairs whose payload is a
## node only for element steps.
pub func place_step_nodes(program: HirProgram, steps: Operands, into: list[NodeId]):
    for position in range(0, i64(steps.count) // 2):
        let step = u32(entry_at(program, steps, position * 2))
        if step == place_element_step or step == place_list_element_step or step == place_map_element_step or step == place_mutable_slice_element_step:
            into.append(NodeId(value = u32(entry_at(program, steps, position * 2 + 1))))

func optional_node(value: NodeId, into: list[NodeId]):
    if value.value != no_node: into.append(value)

pub func node_diverges(program: HirProgram, node: NodeId) -> bool:
    match program.types.definitions[node_type(program, node).value].form:
        Never: return true
        else: pass
    match node_form(program, node):
        NeverCoercion(value): return true
        DivergingSequence(values): return true
        else: return false

# mark: Resolved operations ====================================================================

## How an assignment obtains its new value. `Combine(Add(i64))` is the semantic
## meaning of source `+=` after HirGenerator has resolved its operand type.
pub union AssignmentOperation:
    Replace
    Combine(operation: BinaryOperation)

## Tags used by the `(kind, payload)` pairs of `PlaceAssignment.steps`.
## Constants keep the compact HIR node independent of another side table.
pub let place_field_step: u32 = 0
pub let place_element_step: u32 = 1
## Index into shared list storage. Unlike an array element step, this mutates
## the referenced collection and therefore does not require a mutable binding.
pub let place_list_element_step: u32 = 2
## A strong field stored in a class payload.
pub let place_class_field_step: u32 = 3
## A non-owning optional class field stored as a weak slot.
pub let place_weak_field_step: u32 = 4
## A key-selected slot in a mutable map identity. Unlike sequence indexing,
## replacement also inserts when no entry currently exists.
pub let place_map_element_step: u32 = 5
## An element slot reached through a callback-scoped mutable view.
pub let place_mutable_slice_element_step: u32 = 6

## One unary operation with its operand family fixed where needed.
pub union UnaryOperation:
    LogicalNot
    NumericIdentity(operand_type: TypeId)
    NumericNegate(operand_type: TypeId)
    ## Two's-complement negation, defined on unsigned types too (base.md §7.2).
    WrapNegate(operand_type: TypeId)
    IntegerBitwiseNot(operand_type: TypeId)

## One binary operation. The embedded operand type distinguishes, for example,
## integer addition from floating-point addition without target-specific detail.
pub union BinaryOperation:
    LogicalAnd
    LogicalOr
    Equal(operand_type: TypeId)
    NotEqual(operand_type: TypeId)
    ## Reference identity is distinct from structural/value equality.
    Identity(operand_type: TypeId)
    NotIdentity(operand_type: TypeId)
    Less(operand_type: TypeId)
    LessEqual(operand_type: TypeId)
    Greater(operand_type: TypeId)
    GreaterEqual(operand_type: TypeId)
    Add(operand_type: TypeId)
    Subtract(operand_type: TypeId)
    Multiply(operand_type: TypeId)
    Divide(operand_type: TypeId)
    FloorDivide(operand_type: TypeId)
    Remainder(operand_type: TypeId)
    ## C's integer division and remainder, truncating toward zero with the
    ## dividend's sign; a Luce Base module's `//` and `%` (base.md §7.2).
    TruncDivide(operand_type: TypeId)
    TruncRemainder(operand_type: TypeId)
    ## Luce Base's explicit overflow behaviours (base.md §7.2): two's-complement
    ## wrapping, saturation at the type's bounds, and the checked forms whose
    ## result is `T?` with `none` on overflow.
    WrapAdd(operand_type: TypeId)
    WrapSubtract(operand_type: TypeId)
    WrapMultiply(operand_type: TypeId)
    SaturateAdd(operand_type: TypeId)
    SaturateSubtract(operand_type: TypeId)
    SaturateMultiply(operand_type: TypeId)
    CheckedAdd(operand_type: TypeId)
    CheckedSubtract(operand_type: TypeId)
    CheckedMultiply(operand_type: TypeId)
    BitwiseAnd(operand_type: TypeId)
    BitwiseOr(operand_type: TypeId)
    BitwiseXor(operand_type: TypeId)
    ShiftLeft(operand_type: TypeId)
    ShiftRight(operand_type: TypeId)

# mark: Types ==================================================================================

## The identity of one canonical type in `TypeTable.definitions`.
pub struct TypeId:
    pub let value: u32

## The structural meaning of one type. New nominal and compound shapes grow
## here without changing every HIR node that refers to a type.
pub union TypeForm:
    Unit
    Boolean
    Never
    Integer(bits: i64, is_signed: bool)
    ## A pointer-width integer (`usize`/`isize`, base.md §5.1). The width is the
    ## target's; the semantic model reasons about it as 64 bits wide and each
    ## backend folds the real width (Wasm rejects a literal that does not fit).
    PointerInteger(is_signed: bool)
    Floating(bits: i64)
    Character
    String
    Bytes
    ErrorCode
    Error
    Slice(element: TypeId)
    ## A callback-scoped mutable view. It may flow only through direct
    ## function parameters and never enters ordinary value storage.
    MutableSlice(element: TypeId)
    ## Mutable, growable reference collection. Storage policy is a runtime
    ## concern; HIR retains only its structural element type.
    List(element: TypeId)
    ## Insertion-ordered mutable hash collections. Hash-table layout, probing,
    ## and process seeding belong to the sealed runtime; HIR retains only the
    ## source key/value identities needed for checking and semantic execution.
    Map(key: TypeId, value: TypeId)
    Set(element: TypeId)
    ## Immutable value snapshots are core semantic shapes because transfer,
    ## iteration, lookup, and ownership cannot be implemented by an ordinary
    ## struct wrapping mutable collection identity. Standard-library modules
    ## own algorithms over these closed representations.
    FrozenList(element: TypeId)
    FrozenMap(key: TypeId, value: TypeId)
    FrozenSet(element: TypeId)
    ## A locally storable handle owned by the current invocation's implicit
    ## task group. The result is a semantic type, never a worker layout.
    Task(result: TypeId)
    ## Storable non-owning handle to one nominal class identity. This is a
    ## compiler-known value family, not an instantiation of user generics.
    Weak(value: TypeId)
    Range(element: TypeId)
    Array(element: TypeId, count: i64)
    Optional(value: TypeId)
    Fallible(value: TypeId)
    Tuple(elements: list[TypeId])
    Function(parameters: list[TypeId], result: TypeId)
    ## A synchronous C-callable pointer. Its signature remains semantic and
    ## target-independent; ABI placement begins only in a backend.
    CFunction(parameters: list[TypeId], result: TypeId)
    ## Anonymous raw C data pointer. This is an opaque, equatable token; only
    ## a backend assigns its width and ABI representation.
    Foreign
    ## A typed native address token. The pointee identity survives until a
    ## backend chooses layout; no pointer width or byte arithmetic exists here.
    NativePointer(pointee: TypeId, is_mutable: bool)
    ## A Luce Base pointer (base.md §5.3): never null, one word, C's layout.
    ## `is_const` forbids stores through it; `is_volatile` makes its loads and
    ## stores observable effects. Nullability is the ordinary optional.
    Pointer(pointee: TypeId, is_const: bool, is_volatile: bool)
    ## A Luce Base span (base.md §5.4): a pointer and a `usize` length over
    ## elements it does not own; `is_const` makes the elements read-only.
    Span(element: TypeId, is_const: bool)
    ## `@T` (base.md §5.9, §15.1): a location whose every access is one
    ## atomic instruction. Its storage is `inner`'s; the marker lives on the
    ## type so no plain access to the location can be spelled.
    Atomic(inner: TypeId)
    ## Luce Base's `str`: an immutable UTF-8 view, a `const u8*` and a `usize`
    ## byte count that owns nothing (base.md §5.5). Full Luce's owned `str`
    ## is `String`; the two cross only by the rules of base.md §18.
    StringView
    ## Abstract identity used only while a generic declaration is checked.
    ## Monomorphization removes it before canonical MIR construction.
    TypeParameter(generic: u32, position: u32)
    ## A nominal interface application. An empty argument list is the exact
    ## identity of a non-generic interface.
    Interface(index: i64, arguments: list[TypeId])
    ## Nominal applications retain their declaration identity and semantic
    ## arguments. An empty argument list is the exact non-generic identity.
    Struct(index: i64, arguments: list[TypeId])
    ## A nominal shared identity. The table owns fields and lifecycle methods;
    ## the type itself remains an abstract reference until a backend.
    Class(index: i64, arguments: list[TypeId])
    Enum(index: i64, arguments: list[TypeId])
    Extern(index: i64)

## One canonical type table entry. `name` exists for diagnostics only; semantic
## consumers inspect `form` or compare `TypeId`s.
pub struct TypeDefinition:
    pub let id: TypeId
    pub let name: str
    pub let form: TypeForm

## All canonical types known to one HIR program.
pub struct TypeTable:
    pub let definitions: list[TypeDefinition]

## The built-in semantic types, grouped in canonical table order.
pub enum BuiltinType:
    unit
    boolean
    signed_i8
    signed_i16
    signed_i32
    signed_i64
    unsigned_u8
    unsigned_u16
    unsigned_u32
    unsigned_u64
    unsigned_usize
    signed_isize
    float16
    float32
    float64
    character
    string
    byte_string
    string_slice
    error_code
    error_value
    never_type
    foreign

## Create the canonical built-in type table. For example, `slice[str]` refers
## to the same `str` TypeId stored earlier in this table.
pub func create_builtin_type_table() -> TypeTable:
    let definitions = list[TypeDefinition]()
    definitions.append(TypeDefinition(id = TypeId(value = 0), name = "unit", form = TypeForm.Unit))
    definitions.append(TypeDefinition(id = TypeId(value = 1), name = "bool", form = TypeForm.Boolean))
    definitions.append(TypeDefinition(id = TypeId(value = 2), name = "i8", form = TypeForm.Integer(bits = 8, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 3), name = "i16", form = TypeForm.Integer(bits = 16, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 4), name = "i32", form = TypeForm.Integer(bits = 32, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 5), name = "i64", form = TypeForm.Integer(bits = 64, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 6), name = "u8", form = TypeForm.Integer(bits = 8, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 7), name = "u16", form = TypeForm.Integer(bits = 16, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 8), name = "u32", form = TypeForm.Integer(bits = 32, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 9), name = "u64", form = TypeForm.Integer(bits = 64, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 10), name = "f16", form = TypeForm.Floating(bits = 16)))
    definitions.append(TypeDefinition(id = TypeId(value = 11), name = "f32", form = TypeForm.Floating(bits = 32)))
    definitions.append(TypeDefinition(id = TypeId(value = 12), name = "f64", form = TypeForm.Floating(bits = 64)))
    definitions.append(TypeDefinition(id = TypeId(value = 13), name = "char", form = TypeForm.Character))
    definitions.append(TypeDefinition(id = TypeId(value = 14), name = "str", form = TypeForm.String))
    definitions.append(TypeDefinition(id = TypeId(value = 15), name = "bytes", form = TypeForm.Bytes))
    definitions.append(TypeDefinition(id = TypeId(value = 16), name = "slice[str]", form = TypeForm.Slice(element = TypeId(value = 14))))
    definitions.append(TypeDefinition(id = TypeId(value = 17), name = "ErrorCode", form = TypeForm.ErrorCode))
    definitions.append(TypeDefinition(id = TypeId(value = 18), name = "Error", form = TypeForm.Error))
    definitions.append(TypeDefinition(id = TypeId(value = 19), name = "never", form = TypeForm.Never))
    definitions.append(TypeDefinition(id = TypeId(value = 20), name = "foreign", form = TypeForm.Foreign))
    definitions.append(TypeDefinition(id = TypeId(value = 21), name = "usize", form = TypeForm.PointerInteger(is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 22), name = "isize", form = TypeForm.PointerInteger(is_signed = true)))
    return TypeTable(definitions = definitions)

## Create a valid empty HIR program for tests and tools that need a neutral
## starting value before adding modules, symbols, or functions.
pub func create_empty_hir_program() -> HirProgram:
    return HirProgram(
        packages = [HirPackage(id = PackageId(value = 0), identity = "", role = PackageRole.ordinary)],
        root_package = PackageId(value = 0),
        runtime_bindings = list[HirRuntimeBinding](),
        process_entry = none,
        types = create_builtin_type_table(),
        symbols = list[HirSymbol](),
        aliases = list[HirTypeAlias](),
        structs = list[HirStruct](),
        classes = list[HirClass](),
        enums = list[HirEnum](),
        nominal_applications = list[HirNominalApplication?](),
        interfaces = list[HirInterface](),
        interface_applications = list[HirInterfaceApplication](),
        conformances = list[HirConformance](),
        generic_conformances = list[HirGenericConformance](),
        extern_types = list[HirExternType](),
        extern_variables = list[HirExternVariable](),
        globals = list[HirGlobal](),
        closures = list[HirClosure](),
        shared_cells = list[SymbolId](),
        generic_functions = list[HirGenericFunction](),
        generic_instances = list[HirGenericInstance](),
        generic_specialization_budget = 256,
        nodes = list[HirNode](),
        node_types = list[TypeId](),
        node_modules = list[ModuleId](),
        node_spans = list[SourceSpan](),
        extra = list[u32](),
        values = list[Value](),
        modules = list[HirModule](),
        constants = list[HirConstant](),
        functions = list[HirFunction](),
    )

## Resolve one built-in semantic type to its canonical table identity.
pub func resolve_builtin_type(value: BuiltinType) -> TypeId:
    return match value:
        unit => TypeId(value = 0)
        boolean => TypeId(value = 1)
        signed_i8 => TypeId(value = 2)
        signed_i16 => TypeId(value = 3)
        signed_i32 => TypeId(value = 4)
        signed_i64 => TypeId(value = 5)
        unsigned_u8 => TypeId(value = 6)
        unsigned_u16 => TypeId(value = 7)
        unsigned_u32 => TypeId(value = 8)
        unsigned_u64 => TypeId(value = 9)
        unsigned_usize => TypeId(value = 21)
        signed_isize => TypeId(value = 22)
        float16 => TypeId(value = 10)
        float32 => TypeId(value = 11)
        float64 => TypeId(value = 12)
        character => TypeId(value = 13)
        string => TypeId(value = 14)
        byte_string => TypeId(value = 15)
        string_slice => TypeId(value = 16)
        error_code => TypeId(value = 17)
        error_value => TypeId(value = 18)
        never_type => TypeId(value = 19)
        foreign => TypeId(value = 20)

## Return the diagnostic spelling of one type identity.
pub func describe_type(types: TypeTable, value: TypeId) -> str:
    if i64(value.value) >= len(types.definitions):
        return "<invalid type " + str(value.value) + ">"
    return types.definitions[value.value].name

## Report whether two type identities denote the same canonical type.
pub func types_match(left: TypeId, right: TypeId) -> bool:
    return left.value == right.value

## Report whether two type forms are the same structure, including nested
## `TypeId`s. Interning uses this so identity is form, not diagnostic name.
## One string that is equal exactly when `type_forms_match` is true. Interners
## key a hash map by it instead of scanning the whole table.
pub func type_form_key(form: TypeForm) -> str:
    match form:
        Unit: return "unit"
        Boolean: return "bool"
        Never: return "never"
        Integer(bits, is_signed):
            if is_signed: return "i" + str(bits)
            return "u" + str(bits)
        PointerInteger(is_signed):
            if is_signed: return "isize"
            return "usize"
        Floating(bits): return "f" + str(bits)
        Character: return "char"
        String: return "str"
        Bytes: return "bytes"
        ErrorCode: return "error_code"
        Error: return "error"
        Slice(element): return "slice:" + str(element.value)
        MutableSlice(element): return "mutable_slice:" + str(element.value)
        List(element): return "list:" + str(element.value)
        Map(key, value): return "map:" + str(key.value) + "," + str(value.value)
        Set(element): return "set:" + str(element.value)
        FrozenList(element): return "frozen_list:" + str(element.value)
        FrozenMap(key, value): return "frozen_map:" + str(key.value) + "," + str(value.value)
        FrozenSet(element): return "frozen_set:" + str(element.value)
        Task(result): return "task:" + str(result.value)
        Weak(value): return "weak:" + str(value.value)
        Range(element): return "range:" + str(element.value)
        Array(element, count): return "array:" + str(element.value) + "," + str(count)
        Optional(value): return "optional:" + str(value.value)
        Fallible(value): return "fallible:" + str(value.value)
        Tuple(elements): return "tuple:" + type_id_list_key(elements)
        Function(parameters, result): return "func:" + type_id_list_key(parameters) + "->" + str(result.value)
        CFunction(parameters, result): return "cfunc:" + type_id_list_key(parameters) + "->" + str(result.value)
        Foreign: return "foreign"
        NativePointer(pointee, is_mutable):
            if is_mutable: return "native_mut_ptr:" + str(pointee.value)
            return "native_ptr:" + str(pointee.value)
        Pointer(pointee, is_const, is_volatile):
            var key = "pointer:" + str(pointee.value)
            if is_const: key = key + ":const"
            if is_volatile: key = key + ":volatile"
            return key
        Atomic(inner): return "atomic:" + str(inner.value)
        Span(element, is_const):
            if is_const: return "span:" + str(element.value) + ":const"
            return "span:" + str(element.value)
        StringView: return "string_view"
        TypeParameter(generic, position): return "parameter:" + str(generic) + "," + str(position)
        Interface(index, arguments): return "interface:" + str(index) + "[" + type_id_list_key(arguments) + "]"
        Struct(index, arguments): return "struct:" + str(index) + "[" + type_id_list_key(arguments) + "]"
        Class(index, arguments): return "class:" + str(index) + "[" + type_id_list_key(arguments) + "]"
        Enum(index, arguments): return "enum:" + str(index) + "[" + type_id_list_key(arguments) + "]"
        Extern(index): return "extern:" + str(index)

func type_id_list_key(ids: list[TypeId]) -> str:
    let parts = list[str]()
    for id in ids: parts.append(str(id.value))
    return strings.join(parts, ",")

pub func type_forms_match(left: TypeForm, right: TypeForm) -> bool:
    match left:
        Unit:
            match right:
                Unit: return true
                else: return false
        Boolean:
            match right:
                Boolean: return true
                else: return false
        Never:
            match right:
                Never: return true
                else: return false
        Integer(bits, is_signed):
            match right:
                Integer(other_bits, other_signed): return bits == other_bits and is_signed == other_signed
                else: return false
        PointerInteger(is_signed):
            match right:
                PointerInteger(other_signed): return is_signed == other_signed
                else: return false
        Floating(bits):
            match right:
                Floating(other_bits): return bits == other_bits
                else: return false
        Character:
            match right:
                Character: return true
                else: return false
        String:
            match right:
                String: return true
                else: return false
        Bytes:
            match right:
                Bytes: return true
                else: return false
        ErrorCode:
            match right:
                ErrorCode: return true
                else: return false
        Error:
            match right:
                Error: return true
                else: return false
        Slice(element):
            match right:
                Slice(other): return element.value == other.value
                else: return false
        MutableSlice(element):
            match right:
                MutableSlice(other): return element.value == other.value
                else: return false
        List(element):
            match right:
                List(other): return element.value == other.value
                else: return false
        Map(key, value):
            match right:
                Map(other_key, other_value): return key.value == other_key.value and value.value == other_value.value
                else: return false
        Set(element):
            match right:
                Set(other): return element.value == other.value
                else: return false
        FrozenList(element):
            match right:
                FrozenList(other): return element.value == other.value
                else: return false
        FrozenMap(key, value):
            match right:
                FrozenMap(other_key, other_value): return key.value == other_key.value and value.value == other_value.value
                else: return false
        FrozenSet(element):
            match right:
                FrozenSet(other): return element.value == other.value
                else: return false
        Task(result):
            match right:
                Task(other): return result.value == other.value
                else: return false
        Weak(value):
            match right:
                Weak(other): return value.value == other.value
                else: return false
        Range(element):
            match right:
                Range(other): return element.value == other.value
                else: return false
        Array(element, count):
            match right:
                Array(other_element, other_count): return element.value == other_element.value and count == other_count
                else: return false
        Optional(value):
            match right:
                Optional(other): return value.value == other.value
                else: return false
        Fallible(value):
            match right:
                Fallible(other): return value.value == other.value
                else: return false
        Tuple(elements):
            match right:
                Tuple(other): return type_id_lists_match(elements, other)
                else: return false
        Function(parameters, result):
            match right:
                Function(other_parameters, other_result):
                    return type_id_lists_match(parameters, other_parameters) and result.value == other_result.value
                else: return false
        CFunction(parameters, result):
            match right:
                CFunction(other_parameters, other_result):
                    return type_id_lists_match(parameters, other_parameters) and result.value == other_result.value
                else: return false
        Foreign:
            match right:
                Foreign: return true
                else: return false
        NativePointer(pointee, is_mutable):
            match right:
                NativePointer(other_pointee, other_mutable):
                    return pointee.value == other_pointee.value and is_mutable == other_mutable
                else: return false
        Pointer(pointee, is_const, is_volatile):
            match right:
                Pointer(other_pointee, other_const, other_volatile):
                    return pointee.value == other_pointee.value and is_const == other_const and is_volatile == other_volatile
                else: return false
        Atomic(inner):
            match right:
                Atomic(other_inner): return inner.value == other_inner.value
                else: return false
        Span(element, is_const):
            match right:
                Span(other_element, other_const): return element.value == other_element.value and is_const == other_const
                else: return false
        StringView:
            match right:
                StringView: return true
                else: return false
        TypeParameter(generic, position):
            match right:
                TypeParameter(other_generic, other_position): return generic == other_generic and position == other_position
                else: return false
        Interface(index, arguments):
            match right:
                Interface(other_index, other_arguments): return index == other_index and type_id_lists_match(arguments, other_arguments)
                else: return false
        Struct(index, arguments):
            match right:
                Struct(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Class(index, arguments):
            match right:
                Class(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Enum(index, arguments):
            match right:
                Enum(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Extern(index):
            match right:
                Extern(other): return index == other
                else: return false

func type_id_lists_match(left: list[TypeId], right: list[TypeId]) -> bool:
    if len(left) != len(right): return false
    var index = 0
    while index < len(left):
        if left[index].value != right[index].value: return false
        index += 1
    return true

func type_definition(types: TypeTable, value: TypeId) -> TypeDefinition?:
    if i64(value.value) >= len(types.definitions): return none
    return types.definitions[value.value]

## Report whether a canonical type still contains an abstract generic
## parameter. Consumers use this to exclude declaration schemas from
## executable application tables without learning anything about lowering.
pub func type_contains_parameter(types: TypeTable, value: TypeId) -> bool:
    return type_contains_parameter_once(types, value, list[TypeId]())

func type_contains_parameter_once(types: TypeTable, value: TypeId, visited: list[TypeId]) -> bool:
    for previous in visited:
        if types_match(previous, value): return false
    visited.append(value)
    match types.definitions[value.value].form:
        TypeParameter(generic, position): return true
        Slice(element): return type_contains_parameter_once(types, element, visited)
        MutableSlice(element): return type_contains_parameter_once(types, element, visited)
        List(element): return type_contains_parameter_once(types, element, visited)
        Map(key, element): return type_contains_parameter_once(types, key, visited) or type_contains_parameter_once(types, element, visited)
        Set(element): return type_contains_parameter_once(types, element, visited)
        FrozenList(element): return type_contains_parameter_once(types, element, visited)
        FrozenMap(key, element): return type_contains_parameter_once(types, key, visited) or type_contains_parameter_once(types, element, visited)
        FrozenSet(element): return type_contains_parameter_once(types, element, visited)
        Task(result): return type_contains_parameter_once(types, result, visited)
        Weak(element): return type_contains_parameter_once(types, element, visited)
        Range(element): return type_contains_parameter_once(types, element, visited)
        Optional(element): return type_contains_parameter_once(types, element, visited)
        Fallible(element): return type_contains_parameter_once(types, element, visited)
        Array(element, count): return type_contains_parameter_once(types, element, visited)
        NativePointer(element, is_mutable): return type_contains_parameter_once(types, element, visited)
        Pointer(element, is_const, is_volatile): return type_contains_parameter_once(types, element, visited)
        Span(element, is_const): return type_contains_parameter_once(types, element, visited)
        Tuple(elements):
            for element in elements:
                if type_contains_parameter_once(types, element, visited): return true
        Function(parameters, result):
            for parameter in parameters:
                if type_contains_parameter_once(types, parameter, visited): return true
            return type_contains_parameter_once(types, result, visited)
        CFunction(parameters, result):
            for parameter in parameters:
                if type_contains_parameter_once(types, parameter, visited): return true
            return type_contains_parameter_once(types, result, visited)
        Interface(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Struct(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Class(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Enum(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        else: pass
    return false

## Report whether a type is an implemented integer width.
pub func is_integer_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Integer(bits, is_signed): return true
        PointerInteger(is_signed): return true
        else: return false

## Report whether a type is an unsigned integer width.
pub func is_unsigned_integer_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Integer(bits, is_signed): return not is_signed
        PointerInteger(is_signed): return not is_signed
        else: return false

## Bit width of an implemented integer type; 0 if the type is not an integer.
## A pointer-width integer answers the 64 bits of the semantic model.
pub func integer_bit_width(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed): return bits
        PointerInteger(is_signed): return 64
        else: return 0

## Report whether a type is a pointer-width integer (`usize`/`isize`).
pub func is_pointer_integer_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        PointerInteger(is_signed): return true
        else: return false

## Width of one built-in IEEE floating-point type, or zero for another type.
pub func floating_bit_width(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Floating(bits): return bits
        else: return 0

## Inclusive bounds for signed integer types.
pub func integer_minimum(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return -128
            if bits == 16: return -32768
            if bits == 32: return -2147483647 - 1
            return -9223372036854775807 - 1
        PointerInteger(is_signed):
            if not is_signed: return 0
            return -9223372036854775807 - 1
        else: return 0

## Inclusive maximum for signed integer types.
pub func integer_maximum(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return 127
            if bits == 16: return 32767
            if bits == 32: return 2147483647
            return 9223372036854775807
        PointerInteger(is_signed):
            if not is_signed: return 0
            return 9223372036854775807
        else: return 0

## Inclusive maximum for unsigned integer types. Keeping this separate from
## the signed interval prevents the semantic model from losing u64's top bit.
pub func unsigned_integer_maximum(types: TypeTable, value: TypeId) -> u64:
    let definition = type_definition(types, value)
    if definition == none: return u64(0)
    match definition.form:
        Integer(bits, is_signed):
            if is_signed: return u64(0)
            if bits == 8: return u64(255)
            if bits == 16: return u64(65535)
            if bits == 32: return u64(4294967295)
            return u64(18446744073709551615)
        PointerInteger(is_signed):
            if is_signed: return u64(0)
            return u64(18446744073709551615)
        else: return u64(0)

## Report whether a type is an implemented floating-point type.
pub func is_floating_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Floating(bits): return true
        else: return false

## Report whether a type supports numeric arithmetic.
pub func is_numeric_type(types: TypeTable, value: TypeId) -> bool:
    return is_integer_type(types, value) or is_floating_type(types, value)

## Report whether a type supports ordered comparisons.
pub func is_ordered_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Character: return true
        String: return true
        Bytes: return true
        # Base orders addresses totally, across objects (base.md §5.3), and
        # text by bytes (base.md §5.5).
        Pointer(pointee, is_const, is_volatile): return true
        StringView: return true
        else: return is_numeric_type(types, value)

# mark: Symbols ================================================================================

## The identity of one module in `HirProgram.modules`.
pub struct ModuleId:
    pub let value: u32

## The identity of one binding or function in `HirProgram.symbols`.
pub struct SymbolId:
    pub let value: u32

## What declaration introduced a symbol.
pub enum SymbolKind:
    function
    parameter
    local
    constant
    global

## One program-wide semantic symbol. `value_type` is a binding's value type or
## a function's result type; full function signatures live in `HirFunction`.
pub struct HirSymbol:
    pub let id: SymbolId
    pub let name: str
    pub let kind: SymbolKind
    pub let value_type: TypeId

# mark: Runtime values =========================================================================

## Heap box so optional and tuple payloads can nest without a recursive union.
pub class BoxedValue:
    pub let value: Value

    pub init(value: Value):
        self.value = value

## The semantic oracle owns class storage, but only the interpreter knows how
## to invoke a resolved source deinitializer. This narrow callback keeps that
## execution policy out of the HIR data model while allowing deterministic
## host ARC to trigger the language's final-release semantics.
pub interface ClassFinalizer:
    func finalize(class_type: TypeId, fields: list[BoxedValue], run_deinitializer: bool)

## Shared identity behind one interpreted class value. The concrete TypeId
## names semantic application metadata in HirProgram; neither target layout nor an ARC
## header is represented here. The finalizer runs while fields are still live.
pub class ClassStorage:
    pub let class_type: TypeId
    pub let fields: list[BoxedValue]
    ## Execution-local identity used only by opt-in semantic-oracle resource
    ## reporting. Ordinary runs use -1 and pay no tracking allocation.
    pub let allocation_id: i64
    ## False only for the borrowed, non-finalizing semantic proxy supplied to
    ## `deinit`; weak promotion must already observe that identity as dead.
    pub let is_alive: bool
    pub var is_initialized: bool
    let finalizer: ClassFinalizer
    var calls_finalizer: bool

    pub init(class_type: TypeId, fields: list[BoxedValue], allocation_id: i64, finalizer: ClassFinalizer, calls_finalizer: bool, is_alive: bool, is_initialized: bool):
        self.class_type = class_type
        self.fields = fields
        self.allocation_id = allocation_id
        self.finalizer = finalizer
        self.calls_finalizer = calls_finalizer
        self.is_alive = is_alive
        self.is_initialized = is_initialized

    deinit:
        if self.calls_finalizer:
            self.finalizer.finalize(self.class_type, self.fields, self.is_initialized)

    ## Isolated census runs must reclaim deliberately leaked source graphs
    ## after recording them. Suppression happens for every survivor before
    ## any edge is removed, so breaking one cycle cannot invoke user `deinit`
    ## on another half-discarded object.
    pub func suppress_finalization():
        self.calls_finalizer = false

    ## Drop oracle payload ownership in source reverse-declaration order.
    pub func discard_owned_fields():
        var remaining = len(self.fields)
        while remaining > 0:
            remaining -= 1
            self.fields.remove(remaining)

## One non-owning class slot. The host weak edge is an implementation of the
## HIR oracle only: canonical MIR will retain an abstract weak-slot operation,
## and each backend/runtime remains responsible for its concrete machinery.
pub class WeakClassStorage:
    pub weak var target: ClassStorage?

    pub init(target: ClassStorage?):
        self.target = target

## One mutable local promoted into shared closure storage by the HIR oracle.
## Canonical MIR retains the same cell identity while choosing no layout.
pub class CapturedCellStorage:
    pub var value: BoxedValue

    pub init(value: Value):
        self.value = BoxedValue(value = value)

## One escaping anonymous function and its environment values in capture-table
## order. Capture-free callables continue to use `Value.Function`.
pub class ClosureStorage:
    pub let closure: u32
    pub let captures: list[BoxedValue]

    pub init(closure: u32, captures: list[BoxedValue]):
        self.closure = closure
        self.captures = captures

## One semantic existential value. The concrete payload remains an ordinary
## HIR value and the conformance names its requirement implementations. The
## oracle may detach this wrapper before mutation; compiled storage policy is
## deliberately not represented here.
pub class InterfaceStorage:
    pub let conformance: u32
    pub let value: BoxedValue

    pub init(conformance: u32, value: Value):
        self.conformance = conformance
        self.value = BoxedValue(value = value)

## One backing buffer shared by a list and any immutable snapshots captured
## from it. A list replaces this buffer before its next write; slices keep the
## previous buffer alive without a source-visible lifetime.
pub class ListBuffer:
    pub var elements: list[BoxedValue]

    pub init(elements: list[BoxedValue]):
        self.elements = elements

## Mutable identity behind a semantic list value. Aliases share this object;
## snapshot detachment replaces only its backing buffer.
pub class ListStorage:
    pub var buffer: ListBuffer
    pub var has_snapshot: bool
    pub var active_iterations: i64

    pub init(elements: list[BoxedValue]):
        self.buffer = ListBuffer(elements)
        self.has_snapshot = false
        self.active_iterations = 0

## One insertion-ordered semantic hash entry. The HIR oracle deliberately
## stores entries linearly: it defines observable behavior, while the compiled
## runtime independently proves the hash-table performance contract.
pub class HashEntry:
    pub let key: BoxedValue
    pub var value: BoxedValue

    pub init(key: BoxedValue, value: BoxedValue):
        self.key = key
        self.value = value

## Shared identity carrier for maps and sets. Set entries use `unit` values;
## the distinct source type remains on the owning HIR node.
pub class HashStorage:
    pub let entries: list[HashEntry]
    pub var active_iterations: i64

    pub init(entries: list[HashEntry]):
        self.entries = entries
        self.active_iterations = 0

## Immutable ordered elements behind one frozen list value. Copies may share
## this storage inside a domain because source exposes no identity or mutation;
## worker transfer still recursively creates a fresh domain graph.
pub class FrozenListStorage:
    pub let elements: list[BoxedValue]

    pub init(elements: list[BoxedValue]):
        self.elements = elements

## One immutable insertion-ordered frozen map/set entry. Sets carry unit in
## `value`, mirroring the mutable semantic hash model without mutable slots.
pub struct FrozenHashEntry:
    pub let key: BoxedValue
    pub let value: BoxedValue

## Immutable insertion-ordered storage shared only inside one worker domain.
pub class FrozenHashStorage:
    pub let entries: list[FrozenHashEntry]

    pub init(entries: list[FrozenHashEntry]):
        self.entries = entries

## The semantic oracle keeps the concrete backing category only so it can
## read elements. Both cases are immutable owner-retaining snapshots with the
## same source-level `slice[T]` behavior.
pub union SliceBacking:
    List(buffer: ListBuffer)
    Bytes(value: list[u8])

## Immutable owner-retaining view into one contiguous backing.
pub class SliceStorage:
    pub let backing: SliceBacking
    pub let start: i64
    pub let length: i64

    pub init(backing: SliceBacking, start: i64, length: i64):
        self.backing = backing
        self.start = start
        self.length = length

## A non-owning callback-scoped view of one list identity. HIR keeps the
## source capability distinct even though its oracle reuses the list guard.
pub class MutableSliceStorage:
    pub let list: ListStorage

    pub init(list: ListStorage):
        self.list = list

## The cached terminal state of one interpreted worker. The HIR semantic
## oracle keeps this state beside the opaque task identity so aliases and
## repeated waits observe one execution. Compiled worker representation and
## scheduling remain backend/runtime concerns.
pub union HirTaskOutcome:
    Succeeded(value: BoxedValue)
    Failed(error_value: BoxedValue)
    Trapped(message: str)
    Cancelled

## One semantic task identity owned by an invocation's implicit task group.
## Arguments are already copied into the isolated worker domain. A handle is
## non-owning in canonical MIR; this oracle class merely lets the host model
## that identity without choosing a physical runtime layout.
pub class HirTaskStorage:
    pub let identity: u64
    pub let function: SymbolId
    pub let arguments: list[BoxedValue]
    pub var outcome: HirTaskOutcome?

    pub init(identity: u64, function: SymbolId, arguments: list[BoxedValue]):
        self.identity = identity
        self.function = function
        self.arguments = arguments
        self.outcome = none

## A C-callable value is either a compiler-resolved declaration/adapter or an
## opaque code token supplied by C. Keeping those origins explicit prevents
## the semantic oracle from pretending an arbitrary foreign pointer is a HIR
## `SymbolId`.
pub union HirCFunctionIdentity:
    Declared(symbol: SymbolId)
    ForeignPointer(token: i64)

## Values already decoded by HirGenerator. No consumer understands literal
## source spelling; it works only with these semantic values.
pub union Value:
    Unit
    Boolean(value: bool)
    ## Signed and unsigned mathematical values remain distinct. Their HIR type
    ## still owns width; the variant owns only the sign domain needed by
    ## semantic execution, rendering, constants, and native hosts.
    SignedInteger(value: i64)
    UnsignedInteger(value: u64)
    ## Opaque C-handle token. Its nominal type lives on the HIR node or
    ## function slot; keeping it distinct from the integer variants prevents
    ## hosts from accidentally treating a handle as arithmetic data.
    Foreign(token: i64)
    Floating(value: f64)
    Character(value: char)
    Text(value: str)
    Bytes(value: list[u8])
    Tuple(elements: list[BoxedValue])
    ## A fixed-size value array. Its element type and count live in TypeForm;
    ## this runtime carrier owns only the element values.
    Array(elements: list[BoxedValue])
    ## A mutable reference collection; copies share `storage`.
    List(storage: ListStorage)
    Map(storage: HashStorage)
    Set(storage: HashStorage)
    FrozenList(storage: FrozenListStorage)
    FrozenMap(storage: FrozenHashStorage)
    FrozenSet(storage: FrozenHashStorage)
    ## An immutable snapshot over one retained backing buffer.
    Slice(storage: SliceStorage)
    ## A non-storable mutable view valid only in its active callback frame.
    MutableSlice(storage: MutableSliceStorage)
    ## A locally storable, non-escaping handle into the creating invocation's
    ## structured task group. The group, not this value, owns worker lifetime.
    Task(storage: HirTaskStorage)
    ## A capture-free Luce function value, named by its resolved symbol.
    Function(symbol: SymbolId)
    ## Anonymous function with a managed capture environment.
    Closure(storage: ClosureStorage)
    ## A concrete value erased behind one nominal interface contract.
    Interface(storage: InterfaceStorage)
    ## A capture-free C-callable value. Its identity remains distinct from an
    ## ordinary Luce function descriptor and from opaque data handles.
    CFunction(identity: HirCFunctionIdentity)
    ## A struct value: its fields in declaration order.
    Record(fields: list[BoxedValue])
    ## A shared class identity. Payload fields live in the identity storage so
    ## every ordinary value copy observes the same mutations.
    Class(storage: ClassStorage)
    ## Non-owning class slot behind either a source `weak var field: Class?`
    ## or a first-class compiler-known `Weak[Class]` value.
    WeakClass(storage: WeakClassStorage)
    ## Hidden shared storage for a captured mutable local.
    CapturedCell(storage: CapturedCellStorage)
    ## An enum value: which case, and its payload in declaration order.
    Variant(case_index: i64, payload: list[BoxedValue])
    Absent
    Present(value: BoxedValue)
    ## The reference interpreter's Base pointer: a place in one call frame
    ## (`frame` indexes the run's frame stack), rooted at a local `symbol` or
    ## a `global`, followed by field and element indices. Addresses compare
    ## equal when they name one place (base.md §5.3).
    Address(frame: i64, symbol: SymbolId, global: i64, path: list[i64])
    ## The reference interpreter's Base span: the address of its first element
    ## and its length (base.md §5.4).
    Span(base: BoxedValue, length: i64)
    ## Internal carrier for the two outcomes of a `T!` call. HirGenerator
    ## ensures these are consumed only by Try/Catch nodes, so they never
    ## become ordinary source values.
    FallibleSuccess(value: BoxedValue)
    FallibleFailure(error_value: BoxedValue)

    ## Render one runtime value for command-line output.
    pub func render() -> str:
        match self:
            Unit: return "unit"
            Boolean(item): return str(item)
            SignedInteger(item): return str(item)
            UnsignedInteger(item): return str(item)
            Foreign(token): return "<foreign>"
            Address(frame, symbol, global, path): return "<address>"
            Span(base, length): return "<span of " + str(length) + ">"
            Floating(item): return str(item)
            Character(item): return str(item)
            Text(item): return item
            Bytes(item): return str(len(item)) + " bytes"
            Task(storage): return "<task " + str(storage.identity) + ">"
            Variant(case_index, payload):
                var text = "case " + str(case_index)
                if len(payload) == 0: return text
                text = text + "("
                var index = 0
                for field in payload:
                    if index > 0: text = text + ", "
                    text = text + field.value.render()
                    index += 1
                return text + ")"
            Record(fields):
                var text = "{"
                var index = 0
                for field in fields:
                    if index > 0: text = text + ", "
                    text = text + field.value.render()
                    index += 1
                return text + "}"
            Class(storage): return "<class-type#" + str(storage.class_type.value) + ">"
            WeakClass(storage): return "<weak-class>"
            CapturedCell(storage): return "<captured-cell>"
            Function(symbol): return "<function>"
            Closure(storage): return "<closure>"
            Interface(storage): return "<interface>"
            CFunction(identity): return "<cfunc>"
            Tuple(elements):
                var text = "("
                var index = 0
                for element in elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + ")"
            Array(elements):
                var text = "["
                var index = 0
                for element in elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + "]"
            List(storage):
                var text = "["
                var index = 0
                for element in storage.buffer.elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + "]"
            Map(storage): return "<map " + str(len(storage.entries)) + " entry(s)>"
            Set(storage): return "<set " + str(len(storage.entries)) + " element(s)>"
            FrozenList(storage):
                var text = "["
                var index = 0
                for element in storage.elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + "]"
            FrozenMap(storage): return "<frozen-map " + str(len(storage.entries)) + " entry(s)>"
            FrozenSet(storage): return "<frozen-set " + str(len(storage.entries)) + " element(s)>"
            Slice(storage):
                var text = "["
                for index in range(0, storage.length):
                    if index > 0: text = text + ", "
                    match storage.backing:
                        List(buffer): text = text + buffer.elements[storage.start + index].value.render()
                        Bytes(value): text = text + str(value[storage.start + index])
                return text + "]"
            MutableSlice(storage): return "<mutable-slice>"
            Absent: return "none"
            Present(item): return item.value.render()
            FallibleSuccess(item): trap("internal fallible success escaped its handler")
            FallibleFailure(item): trap("internal fallible failure escaped its handler")

## Compare two already-canonical integer literals without conflating signed
## and unsigned domains. Exported C enum validation and both boundary oracles
## share this one definition of exact numeric identity.
pub func integer_values_match(left: Value, right: Value) -> bool:
    match left:
        SignedInteger(value):
            match right:
                SignedInteger(other): return value == other
                else: return false
        UnsignedInteger(value):
            match right:
                UnsignedInteger(other): return value == other
                else: return false
        else: return false

# Structural comparison of source literals used by match coverage and static
# map-key equality. Floating signed zero follows language equality; named NaN
# is not a literal and therefore never reaches this proof.
pub func values_equal(left: Value, right: Value) -> bool:
    match left:
        Unit:
            match right:
                Unit: return true
                else: return false
        Address(frame, symbol, global, path):
            match right:
                Address(other_frame, other_symbol, other_global, other_path):
                    return frame == other_frame and symbol.value == other_symbol.value and global == other_global and integer_lists_equal(path, other_path)
                else: return false
        SignedInteger(a):
            match right:
                SignedInteger(b): return a == b
                else: return false
        UnsignedInteger(a):
            match right:
                UnsignedInteger(b): return a == b
                else: return false
        Boolean(a):
            match right:
                Boolean(b): return a == b
                else: return false
        Character(a):
            match right:
                Character(b): return a == b
                else: return false
        Text(a):
            match right:
                Text(b): return a == b
                else: return false
        Floating(a):
            match right:
                Floating(b): return a == b
                else: return false
        Bytes(a):
            match right:
                Bytes(b):
                    if len(a) != len(b): return false
                    for index in range(0, len(a)):
                        if a[index] != b[index]: return false
                    return true
                else: return false
        else: return false

func integer_lists_equal(left: list[i64], right: list[i64]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true
