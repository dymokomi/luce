#==============================================================================================
#
#   hir - Luce after names and types have meaning
#
#   DESCRIPTION:
#       The High-level Intermediate Representation is the compiler's semantic
#       center. Every reference is a `SymbolId`, every type is a `TypeId`, and
#       every operator is a resolved tagged operation.
#       Source spellings such as `"i64"` and `"+"` stop at the
#       HirGenerator and are never reinterpreted by analysis, execution, or lowering.
#
#       HIR keeps readable language structure: functions contain
#       suites, statements contain `if` and `while`, and expressions remain
#       trees — but the tree lives in one flat table. Every statement and
#       expression is a `HirNode` stored inline in `HirProgram.nodes`; a
#       node's `form` is a union whose children are `NodeId`s (indices into
#       that table) and whose child lists are `Operands` (runs inside
#       `HirProgram.extra`). The two fields most walks never read — the
#       result type and the span — sit in parallel arrays, so a node is a
#       tag and its payload. Pattern matching on `form` reads exactly as it
#       would on a pointer tree; only the links are integers. Canonical MIR
#       later flattens control flow the same way.
#
#       The file follows one program from broadest shape to smallest:
#
#       program -> modules/functions -> statements -> expressions
#               -> operations -> types/symbols -> values
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.runtime_contract import RuntimeService

# mark: Program shape =========================================================================

## One fully resolved and type-checked program. Functions and symbols are flat
## program-wide tables so a resolved identity never requires a module-tree walk.
pub struct HirProgram:
    ## Opaque, globally assigned package identity. `ErrorCode.package` stores
    ## this exact string in values; module names and source paths never stand
    ## in for package identity.
    pub let package_identity: str
    ## Runtime privilege is an explicit compiler input, never inferred from a
    ## package name or source spelling.
    pub let package_role: PackageRole
    ## Exact private functions selected by the sealed package descriptor to
    ## implement semantic runtime services. Later stages use only identities.
    pub let runtime_bindings: list[HirRuntimeBinding]
    pub let types: TypeTable
    pub let symbols: list[HirSymbol]
    pub let modules: list[HirModule]
    pub let constants: list[HirConstant]
    pub let structs: list[HirStruct]
    pub let classes: list[HirClass]
    pub let enums: list[HirEnum]
    ## TypeId-aligned concrete views of nominal declaration schemas. Generic
    ## substitution happens once during HIR generation; semantic consumers
    ## never reinterpret declaration parameters independently.
    pub let nominal_applications: list[HirNominalApplication?]
    ## Nominal behavior contracts and explicit type-owned implementations.
    ## These are semantic identities; witness-table layout belongs to a
    ## backend once interface values become executable.
    pub let interfaces: list[HirInterface]
    ## Every canonical `TypeForm.Interface` with its fully substituted
    ## requirement signatures. Consumers never repeat generic substitution.
    pub let interface_applications: list[HirInterfaceApplication]
    pub let conformances: list[HirConformance]
    pub let extern_types: list[HirExternType]
    pub let extern_variables: list[HirExternVariable]
    pub let globals: list[HirGlobal]
    ## Anonymous functions with captured storage. Capture-free lambdas reuse
    ## ordinary function addresses and therefore need no environment entry.
    pub let closures: list[HirClosure]
    ## Mutable locals promoted to one shared cell because at least one closure
    ## captures them. Their source types remain unchanged; this table records
    ## the storage/lifetime fact once for every HIR consumer.
    pub let shared_cells: list[SymbolId]
    ## Generic declarations are checked against abstract parameters and then
    ## instantiated into ordinary concrete functions before MIR lowering.
    pub let generic_functions: list[HirGenericFunction]
    pub let functions: list[HirFunction]
    # The node table: every statement and expression, with its result type,
    # source module, and span in parallel arrays, its child lists in `extra`,
    # and literal values in `values`.
    pub let nodes: list[HirNode]
    pub let node_types: list[TypeId]
    pub let node_modules: list[ModuleId]
    pub let node_spans: list[SourceSpan]
    pub let extra: list[u32]
    pub let values: list[Value]

## The identity of one node in `HirProgram.nodes`.
pub struct NodeId:
    pub let value: u32

## "No node": an absent optional child, such as a bare `return`.
pub let no_node: u32 = 4294967295

## A run of `count` entries starting at `start` in `HirProgram.extra`: a
## suite's statements, a call's arguments, a tuple's elements.
pub struct Operands:
    pub let start: u32
    pub let count: u32

## One statement or expression, stored inline in the node table.
pub struct HirNode:
    pub let form: HirNodeForm

## The node a run names at position `index`.
pub func node_at(program: HirProgram, run: Operands, index: i64) -> NodeId:
    return NodeId(value = program.extra[i64(run.start) + index])

## The raw entry at position `index` of a run (a parameter index, a field index).
pub func entry_at(program: HirProgram, run: Operands, index: i64) -> i64:
    return i64(program.extra[i64(run.start) + index])

pub func node_form(program: HirProgram, id: NodeId) -> HirNodeForm:
    return program.nodes[id.value].form

pub func node_type(program: HirProgram, id: NodeId) -> TypeId:
    return program.node_types[id.value]

pub func node_module(program: HirProgram, id: NodeId) -> ModuleId:
    return program.node_modules[id.value]

pub func node_span(program: HirProgram, id: NodeId) -> SourceSpan:
    return program.node_spans[id.value]

## Return the concrete fields of one struct or class application.
pub func nominal_fields(program: HirProgram, value_type: TypeId) -> list[HirNominalField]:
    if i64(value_type.value) >= len(program.nominal_applications): trap("nominal TypeId has no application metadata")
    let nominal = program.nominal_applications[value_type.value] else trap("type has no nominal application metadata")
    match nominal:
        StructApplication(fields): return fields
        ClassApplication(class_value): return class_value.fields
        EnumApplication(cases): trap("enum application has cases, not fields")

## Return the concrete, fully substituted cases of one enum application.
## Consumers must not read payload types from the abstract declaration: two
## applications of the same generic enum may have different payload shapes.
pub func nominal_cases(program: HirProgram, value_type: TypeId) -> list[HirEnumCase]:
    if i64(value_type.value) >= len(program.nominal_applications): trap("nominal TypeId has no application metadata")
    let nominal = program.nominal_applications[value_type.value] else trap("type has no nominal application metadata")
    match nominal:
        EnumApplication(cases): return cases
        StructApplication(fields): trap("struct application has fields, not cases")
        ClassApplication(class_value): trap("class application has fields, not cases")

## Return the concrete payload and lifecycle identities of one class
## application. A generic declaration has one abstract schema, but every
## executable application owns a distinct specialized deinitializer.
pub func class_application(program: HirProgram, value_type: TypeId) -> HirClassApplication:
    if i64(value_type.value) >= len(program.nominal_applications): trap("class TypeId has no application metadata")
    let application = program.nominal_applications[value_type.value] else trap("class type has no application metadata")
    match application:
        ClassApplication(value): return value
        else: trap("class application requested from a non-class type")

## One declared struct. `TypeForm.Struct(index, arguments)` names its
## declaration and concrete generic arguments by position here.
## Fields keep declaration order; that order is the value's layout order.
pub struct HirStruct:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let fields: list[HirField]
    ## The custom initializer's function symbol, or none when construction
    ## uses the synthesized memberwise initializer.
    pub let initializer: SymbolId?
    pub let span: SourceSpan

## One declared identity type. `TypeForm.Class(index, arguments)` names its
## declaration and concrete generic arguments here. Fields and lifecycle
## symbols are the declaration schema; generic entries may therefore name
## abstract types and generic-function symbols. `HirClassApplication` owns the
## executable substituted payload and deinitializer for each concrete TypeId.
## Allocation and reference counts are semantic operations, never HIR layout.
pub struct HirClass:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let fields: list[HirField]
    pub let initializer: SymbolId
    pub let deinitializer: SymbolId?
    pub let span: SourceSpan

## One declared enum: a closed sum of cases. `TypeForm.Enum(index, arguments)`
## names its declaration and concrete generic arguments; a case's position is
## its tag.
pub struct HirEnum:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let cases: list[HirEnumCase]
    pub let span: SourceSpan

## The fully substituted semantic schema for one canonical nominal TypeId.
## Entries live at the same index as `TypeTable.definitions`; non-nominal
## types have `none` in `HirProgram.nominal_applications`.
pub union HirNominalApplication:
    StructApplication(fields: list[HirNominalField])
    ClassApplication(application: HirClassApplication)
    EnumApplication(cases: list[HirEnumCase])

pub struct HirClassApplication:
    ## Semantic declaration order only; physical layout is backend-owned.
    pub let fields: list[HirNominalField]
    ## Exact concrete function, or none. Construction already records its
    ## concrete initializer directly on each `Initialize` node.
    pub let deinitializer: SymbolId?

## One callable requirement in declaration order. The receiver is implicit
## in this record: `parameters` contains only the arguments after `self`.
pub struct HirInterfaceRequirement:
    pub let symbol: SymbolId
    pub let name: str
    pub let is_mutating: bool
    pub let documentation: list[str]
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let span: SourceSpan

## One nominal interface declaration. Generic arguments are carried by
## `TypeForm.Interface`; this table owns the abstract declaration signature.
pub struct HirInterface:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let requirements: list[HirInterfaceRequirement]
    pub let span: SourceSpan

## One concrete application of a nominal interface declaration. Requirement
## symbols/order are preserved while parameter and result types are fully
## substituted for `value_type`'s arguments.
pub struct HirInterfaceApplication:
    pub let value_type: TypeId
    pub let declaration: u32
    pub let requirements: list[HirInterfaceRequirement]

## One explicit nominal conformance. Requirement and implementation symbols
## share declaration order, which later becomes witness-table order without
## introducing layout into HIR.
pub struct HirConformance:
    pub let value_type: TypeId
    pub let interface_type: TypeId
    pub let implementations: list[SymbolId]

## The source-declared representation of one opaque C handle. `Pointer` is a
## target-neutral token, not a width or layout; `Integer` names one of the
## four exact-width boundary integers admitted by the parser.
pub union HirExternRepresentation:
    Pointer
    Integer(value_type: TypeId)

## One opaque source-level handle. The handle remains nominal throughout HIR:
## source code cannot construct a nonzero token, perform integer arithmetic on
## it, or confuse two equally represented handles. Canonical MIR erases that
## nominal identity to its target-neutral pointer or integer representation;
## ABI placement still begins only in a backend.
pub struct HirExternType:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let representation: HirExternRepresentation
    pub let span: SourceSpan

## One mutable C-owned global in the source value namespace. Its type is a
## target-neutral scalar or nominal handle; reads and writes remain explicit
## observable operations through HIR and canonical MIR. In particular, this
## is not compiler-owned global storage and a pointer-handle zero is ordinary
## state here, not a C call-slot crossing.
pub struct HirExternVariable:
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let value_type: TypeId
    pub let span: SourceSpan

## One zero-initialized, module-private cell owned by the sealed runtime.
## Its index in `HirProgram.globals` is the stable identity used by HIR nodes.
pub struct HirGlobal:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let value_type: TypeId
    pub let span: SourceSpan

## One captured anonymous function. `function` names its checked body;
## captures are stored in environment-field order and map each hidden body
## binding back to the source value or cell used when the closure is formed.
pub struct HirClosure:
    pub let function: SymbolId
    pub let captures: list[HirCapture]
    pub let span: SourceSpan

## The source-visible type belongs to `symbol`. `source` is present for a
## direct outer binding and lets ownership/cycle analysis retain provenance;
## an explicit `copy name = expression` has no single source symbol.
pub struct HirCapture:
    pub let symbol: SymbolId
    pub let source: SymbolId?
    pub let value_type: TypeId
    pub let kind: HirCaptureKind
    ## The source use or explicit capture that formed this environment field.
    pub let span: SourceSpan

pub enum HirCaptureKind:
    ## Snapshot or strong/reference copy using ordinary value ownership.
    value
    ## One ARC cell shared by the outer scope and every capturing closure.
    shared_cell
    ## A non-owning class slot promoted to `T?` at each source read.
    weak_capture

## One case and its named payload, in declaration order.
pub struct HirEnumCase:
    pub let name: str
    pub let documentation: list[str]
    pub let payload: list[HirPayloadField]

pub struct HirPayloadField:
    pub let name: str
    pub let value_type: TypeId

## One stored field. `default_value` is a constant expression the synthesized
## initializer uses when a construction omits the field.
pub struct HirField:
    pub let name: str
    pub let value_type: TypeId
    pub let is_mutable: bool
    ## A class-only optional reference slot that never owns its referent.
    ## Struct fields always set this to false.
    pub let is_weak: bool
    pub let is_public: bool
    pub let documentation: list[str]
    ## `no_node` when the field has no default.
    pub let default_value: NodeId

## One fully applied stored field. Defaults belong to a declaration's
## synthesized initializer rather than to runtime storage, so this schema
## contains only facts semantic consumers need after construction.
pub struct HirNominalField:
    pub let name: str
    pub let value_type: TypeId
    pub let is_mutable: bool
    pub let is_weak: bool
    pub let is_public: bool
    pub let documentation: list[str]

## One module-level constant. Its initializer is already typed; references
## use `symbol`.
pub struct HirConstant:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let value: NodeId

## One source module. `ModuleId.value` is its index in `HirProgram.modules`;
## functions refer back to that identity.
pub struct HirModule:
    pub let id: ModuleId
    pub let name: str
    pub let path: str
    ## Authority comes from the package reader, never source text. It governs
    ## which compiler-known native types and operations HIR generation admits.
    pub let authority: ModuleAuthority
    pub let documentation: list[str]

## A source module is either ordinary safe Luce or an audited `.native.luc`
## module. Authority is deliberately not transitive through imports.
pub enum ModuleAuthority:
    safe
    native

## Ordinary packages cannot own module-global state or the sealed storage
## arena. The compiler constructs the runtime role only for `libluce_rt`.
pub enum PackageRole:
    application
    sealed_runtime

## One semantic runtime service resolved to an exact source function identity.
## The package descriptor supplies the spelling once; HIR consumers never
## repeat that lookup.
pub struct HirRuntimeBinding:
    pub let service: RuntimeService
    pub let function: SymbolId

## One checked function, method, export, or import. Every source-level
## callable has one symbol and one table identity; `implementation` says
## whether its code is present or supplied by the C boundary. Calls therefore
## retain one shape through HIR instead of duplicating lookup and argument
## placement for ordinary and external functions.
##
## A value method is a function whose first
## parameter is `self` and whose `receiver` names the struct; a type function
## (`Point.origin`) has a receiver but no `self`. An initializer is kept
## distinct from both: its source result is `unit` or `unit!`, while a
## construction expression produces the receiver value. Documentation, parameter
## names, and defaults are retained on purpose: `luce describe` and
## `luce api diff` read them.
pub struct HirFunction:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let receiver: HirReceiver?
    ## The captured environment this body receives, or none for a declared or
    ## capture-free generated function.
    pub let closure: u32?
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let implementation: HirFunctionImplementation
    pub let span: SourceSpan

## One source declaration slot in an external C function. Inputs point back
## into the ordinary callable parameter list; outputs have no source argument
## and become source-visible result components after the call. The order here
## is C declaration order, before any target chooses ABI placement.
pub union HirCSlot:
    Input(parameter: u32)
    Output(name: str, value_type: TypeId)

## Target-neutral C-only facts attached to an external implementation. The
## function's ordinary `parameters` and `result` remain exactly what a Luce
## caller sees; `declared_result` and `slots` retain the raw source contract
## needed by the one boundary adapter.
pub struct HirCFunction:
    pub let is_blocking: bool
    pub let slots: list[HirCSlot]
    pub let declared_result: TypeId

## The three possible origins of a source-level callable. `ExportedC` is a
## defined Luce body with an externally visible C symbol; `ExternalC` is a C
## symbol supplied by the artifact host. C target ABI placement remains a
## backend fact—the HIR records only the language-level boundary contract.
pub union HirFunctionImplementation:
    Defined(body: Operands)
    ExportedC(body: Operands)
    ExternalC(contract: HirCFunction)

## Return a defined function's body. Consumers that walk bodies use this
## after rejecting `ExternalC`, so an impossible request is a compiler bug.
pub func function_body(function: HirFunction) -> Operands:
    match function.implementation:
        Defined(body): return body
        ExportedC(body): return body
        ExternalC(contract): trap("external function has no HIR body")

## The five meaningful receiver protocols. Keeping this as one closed choice
## prevents impossible combinations of `has_self`, `is_mutating`, and
## `is_initializer` from leaking into later stages.
pub enum HirReceiverKind:
    type_function
    value_method
    mutating_method
    initializer
    deinitializer

## Which type a member belongs to and how its receiver crosses the call
## boundary. Initializers and mutating methods both receive writable storage,
## but only a mutating method starts from an existing caller value.
pub struct HirReceiver:
    pub let owner: TypeId
    pub let kind: HirReceiverKind

## One parameter. Its diagnostic name remains, but references use its symbol.
## `default_value` is a constant expression embedded at every call site that
## omits the argument (spec §8.2).
pub struct HirParameter:
    pub let symbol: SymbolId
    pub let name: str
    pub let value_type: TypeId
    ## `no_node` when the parameter has no default.
    pub let default_value: NodeId

## One abstract type parameter owned by a generic declaration. Constraints
## attach here as interface identities; equally named parameters from two
## declarations remain semantically distinct.
pub struct HirTypeParameter:
    pub let name: str
    pub let value_type: TypeId
    pub let constraints: list[TypeId]

## A checked generic source signature. Executable calls always target one
## memoized concrete `HirFunction`; this table retains the abstract API for
## diagnostics, package tooling, and later typed-body serialization.
pub struct HirGenericFunction:
    pub let symbol: SymbolId
    pub let module: ModuleId
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    ## Present when the template belongs to a generic nominal declaration.
    ## Every executable specialization substitutes this abstract receiver.
    pub let receiver: HirReceiver?
    pub let generic_id: u32
    ## Number of leading type parameters fixed by an applied nominal owner.
    ## The remaining parameters belong to the method declaration itself.
    pub let owner_parameter_count: i64
    pub let type_parameters: list[HirTypeParameter]
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let span: SourceSpan

# mark: Statements and expressions ============================================================

## Every node form. Statements come first, then expressions; a `NodeId`
## child names another node, an `Operands` child names a run in `extra`.
##
## Assignment carries a resolved operation, so consumers never need to
## interpret source spellings such as `+=`. `print` of a literal is
## `PrintText`; `print` of any other `str` expression is `PrintValue`, whose
## text exists only at run time. `PlaceAssignment` is an assignment through
## a mutable root binding (a `var` local, or `self` in a mutating method).
## Its `steps` are pairs in `extra`: a value/class field step plus a resolved
## field index, or an element step plus the NodeId of a checked `u64` index.
## Class-field steps cross shared identity without requiring a mutable root;
## weak-field steps expose the same source type but use non-owning storage.
## This one semantic path represents mixed places such as
## `model.document.pages[i]` without preserving source names or syntax.
## `IfStatement.branches` is a run of triples `(condition, body start, body
## count)`; `fallback` is the `else` suite when `has_fallback`.
##
## Calls target symbols; `arguments` is a run of pairs `(parameter index,
## node)`, so evaluation performs no name resolution, and a method call is a
## `Call` whose argument 0 is the receiver. `Initialize` has the same placed
## argument representation but omits parameter 0: execution supplies fresh
## receiver storage and returns it after the initializer succeeds.
## `StructValue.fields` and `EnumValue.payload` are runs of pairs `(field
## index, node)` in source evaluation order. Defaults are appended after
## explicit fields in declaration order. This is the same placed-argument
## convention as calls: storage order never changes source evaluation order.
## `Constant` names an entry of `HirProgram.values`.
##
## `Match` selects one arm; `arms` is a run of `MatchArm` nodes. An arm's
## `patterns` is a run of pattern nodes (alternatives), its `statements` the
## suite (statement form) and `value` the yielded node (expression form,
## `no_node` otherwise). A `PatternCase` names an enum case by index — or,
## for an optional subject, 0 for `.none` and 1 for `.some` — and its
## `bindings` are the symbols its payload lands in, one per payload field.
pub union HirNodeForm:
    BreakStatement
    ContinueStatement
    Binding(symbol: SymbolId, is_mutable: bool, value: NodeId)
    Assignment(symbol: SymbolId, operation: AssignmentOperation, value: NodeId)
    ExternStore(variable: u32, operation: AssignmentOperation, value: NodeId)
    GlobalStore(global: u32, operation: AssignmentOperation, value: NodeId)
    PlaceAssignment(symbol: SymbolId, steps: Operands, operation: AssignmentOperation, value: NodeId)
    ## A resolved field/element path rooted in sealed runtime state. Ordinary
    ## application source cannot construct one because it cannot own globals.
    GlobalPlaceAssignment(global: u32, steps: Operands, operation: AssignmentOperation, value: NodeId)
    PrintText(value: str)
    PrintValue(value: NodeId)
    ReturnStatement(value: NodeId)
    RecoverStatement(value: NodeId)
    DeferStatement(action: NodeId)
    ExpressionStatement(value: NodeId)
    IfStatement(branches: Operands, has_fallback: bool, fallback: Operands)
    WhileStatement(condition: NodeId, body: Operands)
    ForStatement(symbol: SymbolId, iterable: NodeId, body: Operands)
    Constant(value: u32)
    Reference(symbol: SymbolId)
    ExternLoad(variable: u32)
    GlobalLoad(global: u32)
    ## Closed operations available only in audited native modules. The pointer
    ## type carries pointee and mutability; these nodes need no target layout.
    NativeLoad(pointer: NodeId)
    NativeStore(pointer: NodeId, value: NodeId)
    NativeAdvance(pointer: NodeId, count: NodeId)
    ## Reinterpret one audited native address with a contextual pointee type.
    ## Mutability may be preserved or reduced, never introduced.
    NativeRebind(pointer: NodeId)
    ## Move `count` typed elements between possibly overlapping native ranges.
    NativeMove(destination: NodeId, source: NodeId, count: NodeId)
    ## Request `count` values of one structural type from the bound allocator.
    ## Only sealed runtime source can construct this node.
    NativeAllocate(element_type: TypeId, count: NodeId)
    ## Return one exact typed allocation to the bound runtime deallocator.
    ## The pointee identity and element count remain target-independent.
    NativeDeallocate(pointer: NodeId, element_type: TypeId, count: NodeId)
    ## Test the inert/null address without exposing an integer representation.
    NativeIsNull(pointer: NodeId)
    ## Ensure the sealed process arena contains `end` bytes and return its
    ## stable byte base. Only the runtime package can construct this node.
    NativeArena(end: NodeId)
    ## One explicit numeric construction. The destination is the node type;
    ## the operand retains its independently resolved source type. Integer
    ## range checks and floating-width rounding are semantic, never backend
    ## defaults.
    NumericConvert(value: NodeId)
    ## Evaluate one non-fallible value exactly once and intentionally abandon
    ## its result. Managed lifetime remains ordinary full-expression cleanup.
    Discard(value: NodeId)
    ## Count Unicode scalar values by decoding valid UTF-8. `byte_count`
    ## remains the O(1) structural length carried by the string value.
    StringScalarCount(value: NodeId)
    SequenceLength(value: NodeId)
    SequenceIndex(value: NodeId, index: NodeId)
    Unary(operation: UnaryOperation, operand: NodeId)
    Binary(left: NodeId, operation: BinaryOperation, right: NodeId)
    Conditional(value: NodeId, condition: NodeId, alternative: NodeId)
    Range(lower: NodeId, upper: NodeId, inclusive: bool)
    Call(function: SymbolId, arguments: Operands)
    ## Package one concrete value with an explicit conformance identity. The
    ## node type is the existential interface; physical storage is absent.
    InterfaceValue(value: NodeId, conformance: u32)
    ## Dynamically invoke one requirement in the interface's declaration
    ## order. The receiver supplies the concrete implementation at run time.
    InterfaceCall(receiver: NodeId, interface_type: TypeId, requirement: u32, arguments: Operands)
    FunctionAddress(function: SymbolId)
    ## Form one managed function value. Initializers align with the closure's
    ## capture table; `no_node` denotes a shared cell whose storage is taken
    ## directly rather than read as a source value.
    ClosureValue(closure: u32, initializers: Operands)
    ## Read the optional source view of one hidden weak capture.
    WeakCaptureReference(symbol: SymbolId)
    IndirectCall(callee: NodeId, arguments: Operands)
    Initialize(function: SymbolId, arguments: Operands)
    ErrorCodeLiteral(value: u32)
    Raise(code: NodeId, message: NodeId)
    ## Terminate the execution domain with one eagerly evaluated string.
    ## Unlike `Raise`, this is not recoverable and runs no lexical cleanup.
    Trap(message: NodeId)
    ## Evaluate both ordinary call arguments from left to right. Continue with
    ## unit when the condition is true; otherwise report the string and trap.
    Assert(condition: NodeId, message: NodeId)
    Try(value: NodeId)
    Catch(value: NodeId, failure: SymbolId, body: Operands)
    Tuple(elements: Operands)
    Array(elements: Operands)
    ## Construct a fresh reference-identity list and append each element in
    ## source order.
    List(elements: Operands)
    ## Produce a shallow copy with independent list identity and storage.
    ListCopy(value: NodeId)
    ## Capture one immutable half-open view from a supported contiguous
    ## sequence. Missing bounds use zero and the receiver's length without
    ## re-evaluating it; its resolved type determines the retained backing.
    SequenceSlice(value: NodeId, start: NodeId, end: NodeId)
    ## Append one element to an existing list and produce unit.
    ListAppend(value: NodeId, element: NodeId)
    ## Shape-changing list operations retain source evaluation order and
    ## leave capacity policy to the runtime.
    ListInsert(value: NodeId, index: NodeId, element: NodeId)
    ListRemoveAt(value: NodeId, index: NodeId)
    ListClear(value: NodeId)
    ListReserve(value: NodeId, minimum_capacity: NodeId)
    ## Construct and atomically promote compiler-known `Weak[T]` values.
    WeakCreate(value: NodeId)
    WeakGet(value: NodeId)
    Element(value: NodeId, index: i64)
    StructValue(struct_index: i64, fields: Operands)
    FieldAccess(value: NodeId, field: i64)
    NoneLiteral
    Some(value: NodeId)
    ElseFallback(value: NodeId, arm: NodeId)
    EnumValue(enum_index: i64, case_index: i64, payload: Operands)
    Match(subject: NodeId, arms: Operands, has_result: bool)
    MatchArm(patterns: Operands, statements: Operands, value: NodeId)
    PatternWildcard
    PatternLiteral(value: u32)
    PatternRange(lower: u32, upper: u32, inclusive: bool)
    PatternCase(case_index: i64, bindings: Operands)

# mark: Resolved operations ====================================================================

## How an assignment obtains its new value. `Combine(Add(i64))` is the semantic
## meaning of source `+=` after HirGenerator has resolved its operand type.
pub union AssignmentOperation:
    Replace
    Combine(operation: BinaryOperation)

## Tags used by the `(kind, payload)` pairs of `PlaceAssignment.steps`.
## Constants keep the compact HIR node independent of another side table.
pub let place_field_step: u32 = 0
pub let place_element_step: u32 = 1
## Index into shared list storage. Unlike an array element step, this mutates
## the referenced collection and therefore does not require a mutable binding.
pub let place_list_element_step: u32 = 2
## A strong field stored in a class payload.
pub let place_class_field_step: u32 = 3
## A non-owning optional class field stored as a weak slot.
pub let place_weak_field_step: u32 = 4

## One unary operation with its operand family fixed where needed.
pub union UnaryOperation:
    LogicalNot
    NumericIdentity(operand_type: TypeId)
    NumericNegate(operand_type: TypeId)
    IntegerBitwiseNot(operand_type: TypeId)

## One binary operation. The embedded operand type distinguishes, for example,
## integer addition from floating-point addition without target-specific detail.
pub union BinaryOperation:
    LogicalAnd
    LogicalOr
    Equal(operand_type: TypeId)
    NotEqual(operand_type: TypeId)
    ## Reference identity is distinct from structural/value equality.
    Identity(operand_type: TypeId)
    NotIdentity(operand_type: TypeId)
    Less(operand_type: TypeId)
    LessEqual(operand_type: TypeId)
    Greater(operand_type: TypeId)
    GreaterEqual(operand_type: TypeId)
    Add(operand_type: TypeId)
    Subtract(operand_type: TypeId)
    Multiply(operand_type: TypeId)
    Divide(operand_type: TypeId)
    FloorDivide(operand_type: TypeId)
    Remainder(operand_type: TypeId)
    BitwiseAnd(operand_type: TypeId)
    BitwiseOr(operand_type: TypeId)
    BitwiseXor(operand_type: TypeId)
    ShiftLeft(operand_type: TypeId)
    ShiftRight(operand_type: TypeId)

# mark: Types ==================================================================================

## The identity of one canonical type in `TypeTable.definitions`.
pub struct TypeId:
    pub let value: u32

## The structural meaning of one type. New nominal and compound shapes grow
## here without changing every HIR node that refers to a type.
pub union TypeForm:
    Unit
    Boolean
    Never
    Integer(bits: i64, is_signed: bool)
    Floating(bits: i64)
    Character
    String
    Bytes
    ErrorCode
    Error
    Slice(element: TypeId)
    ## Mutable, growable reference collection. Storage policy is a runtime
    ## concern; HIR retains only its structural element type.
    List(element: TypeId)
    ## Storable non-owning handle to one nominal class identity. This is a
    ## compiler-known value family, not an instantiation of user generics.
    Weak(value: TypeId)
    Range(element: TypeId)
    Array(element: TypeId, count: i64)
    Optional(value: TypeId)
    Fallible(value: TypeId)
    Tuple(elements: list[TypeId])
    Function(parameters: list[TypeId], result: TypeId)
    ## A synchronous C-callable pointer. Its signature remains semantic and
    ## target-independent; ABI placement begins only in a backend.
    CFunction(parameters: list[TypeId], result: TypeId)
    ## A typed native address token. The pointee identity survives until a
    ## backend chooses layout; no pointer width or byte arithmetic exists here.
    NativePointer(pointee: TypeId, is_mutable: bool)
    ## Abstract identity used only while a generic declaration is checked.
    ## Monomorphization removes it before canonical MIR construction.
    TypeParameter(generic: u32, position: u32)
    ## A nominal interface application. An empty argument list is the exact
    ## identity of a non-generic interface.
    Interface(index: i64, arguments: list[TypeId])
    ## Nominal applications retain their declaration identity and semantic
    ## arguments. An empty argument list is the exact non-generic identity.
    Struct(index: i64, arguments: list[TypeId])
    ## A nominal shared identity. The table owns fields and lifecycle methods;
    ## the type itself remains an abstract reference until a backend.
    Class(index: i64, arguments: list[TypeId])
    Enum(index: i64, arguments: list[TypeId])
    Extern(index: i64)

## One canonical type table entry. `name` exists for diagnostics only; semantic
## consumers inspect `form` or compare `TypeId`s.
pub struct TypeDefinition:
    pub let id: TypeId
    pub let name: str
    pub let form: TypeForm

## All canonical types known to one HIR program.
pub struct TypeTable:
    pub let definitions: list[TypeDefinition]

## The built-in types with stable IDs used by the current language slice.
## IDs 0–6 stay the original set; later scalars append after `slice[str]`.
pub enum BuiltinType:
    unit
    boolean
    signed_i32
    signed_i64
    float64
    string
    string_slice
    signed_i8
    signed_i16
    unsigned_u8
    unsigned_u16
    unsigned_u32
    unsigned_u64
    float32
    character
    byte_string
    error_code
    error_value

## Create the canonical built-in type table. For example, `slice[str]` refers
## to the same `str` TypeId stored earlier in this table.
pub func create_builtin_type_table() -> TypeTable:
    let definitions = list[TypeDefinition]()
    definitions.append(TypeDefinition(id = TypeId(value = 0), name = "unit", form = TypeForm.Unit))
    definitions.append(TypeDefinition(id = TypeId(value = 1), name = "bool", form = TypeForm.Boolean))
    definitions.append(TypeDefinition(id = TypeId(value = 2), name = "i32", form = TypeForm.Integer(bits = 32, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 3), name = "i64", form = TypeForm.Integer(bits = 64, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 4), name = "f64", form = TypeForm.Floating(bits = 64)))
    definitions.append(TypeDefinition(id = TypeId(value = 5), name = "str", form = TypeForm.String))
    definitions.append(TypeDefinition(id = TypeId(value = 6), name = "slice[str]", form = TypeForm.Slice(element = TypeId(value = 5))))
    definitions.append(TypeDefinition(id = TypeId(value = 7), name = "i8", form = TypeForm.Integer(bits = 8, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 8), name = "i16", form = TypeForm.Integer(bits = 16, is_signed = true)))
    definitions.append(TypeDefinition(id = TypeId(value = 9), name = "u8", form = TypeForm.Integer(bits = 8, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 10), name = "u16", form = TypeForm.Integer(bits = 16, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 11), name = "u32", form = TypeForm.Integer(bits = 32, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 12), name = "u64", form = TypeForm.Integer(bits = 64, is_signed = false)))
    definitions.append(TypeDefinition(id = TypeId(value = 13), name = "f32", form = TypeForm.Floating(bits = 32)))
    definitions.append(TypeDefinition(id = TypeId(value = 14), name = "char", form = TypeForm.Character))
    definitions.append(TypeDefinition(id = TypeId(value = 15), name = "bytes", form = TypeForm.Bytes))
    definitions.append(TypeDefinition(id = TypeId(value = 16), name = "ErrorCode", form = TypeForm.ErrorCode))
    definitions.append(TypeDefinition(id = TypeId(value = 17), name = "Error", form = TypeForm.Error))
    return TypeTable(definitions = definitions)

## Create a valid empty HIR program for tests and tools that need a neutral
## starting value before adding modules, symbols, or functions.
pub func create_empty_hir_program() -> HirProgram:
    return HirProgram(
        package_identity = "",
        package_role = PackageRole.application,
        runtime_bindings = list[HirRuntimeBinding](),
        types = create_builtin_type_table(),
        symbols = list[HirSymbol](),
        structs = list[HirStruct](),
        classes = list[HirClass](),
        enums = list[HirEnum](),
        nominal_applications = list[HirNominalApplication?](),
        interfaces = list[HirInterface](),
        interface_applications = list[HirInterfaceApplication](),
        conformances = list[HirConformance](),
        extern_types = list[HirExternType](),
        extern_variables = list[HirExternVariable](),
        globals = list[HirGlobal](),
        closures = list[HirClosure](),
        shared_cells = list[SymbolId](),
        generic_functions = list[HirGenericFunction](),
        nodes = list[HirNode](),
        node_types = list[TypeId](),
        node_modules = list[ModuleId](),
        node_spans = list[SourceSpan](),
        extra = list[u32](),
        values = list[Value](),
        modules = list[HirModule](),
        constants = list[HirConstant](),
        functions = list[HirFunction](),
    )

## Resolve one built-in semantic type to its stable canonical identity.
pub func resolve_builtin_type(value: BuiltinType) -> TypeId:
    return match value:
        unit => TypeId(value = 0)
        boolean => TypeId(value = 1)
        signed_i32 => TypeId(value = 2)
        signed_i64 => TypeId(value = 3)
        float64 => TypeId(value = 4)
        string => TypeId(value = 5)
        string_slice => TypeId(value = 6)
        signed_i8 => TypeId(value = 7)
        signed_i16 => TypeId(value = 8)
        unsigned_u8 => TypeId(value = 9)
        unsigned_u16 => TypeId(value = 10)
        unsigned_u32 => TypeId(value = 11)
        unsigned_u64 => TypeId(value = 12)
        float32 => TypeId(value = 13)
        character => TypeId(value = 14)
        byte_string => TypeId(value = 15)
        error_code => TypeId(value = 16)
        error_value => TypeId(value = 17)

## Return the diagnostic spelling of one type identity.
pub func describe_type(types: TypeTable, value: TypeId) -> str:
    if i64(value.value) >= len(types.definitions):
        return "<invalid type " + str(value.value) + ">"
    return types.definitions[value.value].name

## Report whether two type identities denote the same canonical type.
pub func types_match(left: TypeId, right: TypeId) -> bool:
    return left.value == right.value

## Report whether two type forms are the same structure, including nested
## `TypeId`s. Interning uses this so identity is form, not diagnostic name.
pub func type_forms_match(left: TypeForm, right: TypeForm) -> bool:
    match left:
        Unit:
            match right:
                Unit: return true
                else: return false
        Boolean:
            match right:
                Boolean: return true
                else: return false
        Never:
            match right:
                Never: return true
                else: return false
        Integer(bits, is_signed):
            match right:
                Integer(other_bits, other_signed): return bits == other_bits and is_signed == other_signed
                else: return false
        Floating(bits):
            match right:
                Floating(other_bits): return bits == other_bits
                else: return false
        Character:
            match right:
                Character: return true
                else: return false
        String:
            match right:
                String: return true
                else: return false
        Bytes:
            match right:
                Bytes: return true
                else: return false
        ErrorCode:
            match right:
                ErrorCode: return true
                else: return false
        Error:
            match right:
                Error: return true
                else: return false
        Slice(element):
            match right:
                Slice(other): return element.value == other.value
                else: return false
        List(element):
            match right:
                List(other): return element.value == other.value
                else: return false
        Weak(value):
            match right:
                Weak(other): return value.value == other.value
                else: return false
        Range(element):
            match right:
                Range(other): return element.value == other.value
                else: return false
        Array(element, count):
            match right:
                Array(other_element, other_count): return element.value == other_element.value and count == other_count
                else: return false
        Optional(value):
            match right:
                Optional(other): return value.value == other.value
                else: return false
        Fallible(value):
            match right:
                Fallible(other): return value.value == other.value
                else: return false
        Tuple(elements):
            match right:
                Tuple(other): return type_id_lists_match(elements, other)
                else: return false
        Function(parameters, result):
            match right:
                Function(other_parameters, other_result):
                    return type_id_lists_match(parameters, other_parameters) and result.value == other_result.value
                else: return false
        CFunction(parameters, result):
            match right:
                CFunction(other_parameters, other_result):
                    return type_id_lists_match(parameters, other_parameters) and result.value == other_result.value
                else: return false
        NativePointer(pointee, is_mutable):
            match right:
                NativePointer(other_pointee, other_mutable):
                    return pointee.value == other_pointee.value and is_mutable == other_mutable
                else: return false
        TypeParameter(generic, position):
            match right:
                TypeParameter(other_generic, other_position): return generic == other_generic and position == other_position
                else: return false
        Interface(index, arguments):
            match right:
                Interface(other_index, other_arguments): return index == other_index and type_id_lists_match(arguments, other_arguments)
                else: return false
        Struct(index, arguments):
            match right:
                Struct(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Class(index, arguments):
            match right:
                Class(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Enum(index, arguments):
            match right:
                Enum(other, other_arguments): return index == other and type_id_lists_match(arguments, other_arguments)
                else: return false
        Extern(index):
            match right:
                Extern(other): return index == other
                else: return false

func type_id_lists_match(left: list[TypeId], right: list[TypeId]) -> bool:
    if len(left) != len(right): return false
    var index = 0
    while index < len(left):
        if left[index].value != right[index].value: return false
        index += 1
    return true

func type_definition(types: TypeTable, value: TypeId) -> TypeDefinition?:
    if i64(value.value) >= len(types.definitions): return none
    return types.definitions[value.value]

## Report whether a canonical type still contains an abstract generic
## parameter. Consumers use this to exclude declaration schemas from
## executable application tables without learning anything about lowering.
pub func type_contains_parameter(types: TypeTable, value: TypeId) -> bool:
    return type_contains_parameter_once(types, value, list[TypeId]())

func type_contains_parameter_once(types: TypeTable, value: TypeId, visited: list[TypeId]) -> bool:
    for previous in visited:
        if types_match(previous, value): return false
    visited.append(value)
    match types.definitions[value.value].form:
        TypeParameter(generic, position): return true
        Slice(element): return type_contains_parameter_once(types, element, visited)
        List(element): return type_contains_parameter_once(types, element, visited)
        Weak(element): return type_contains_parameter_once(types, element, visited)
        Range(element): return type_contains_parameter_once(types, element, visited)
        Optional(element): return type_contains_parameter_once(types, element, visited)
        Fallible(element): return type_contains_parameter_once(types, element, visited)
        Array(element, count): return type_contains_parameter_once(types, element, visited)
        NativePointer(element, is_mutable): return type_contains_parameter_once(types, element, visited)
        Tuple(elements):
            for element in elements:
                if type_contains_parameter_once(types, element, visited): return true
        Function(parameters, result):
            for parameter in parameters:
                if type_contains_parameter_once(types, parameter, visited): return true
            return type_contains_parameter_once(types, result, visited)
        CFunction(parameters, result):
            for parameter in parameters:
                if type_contains_parameter_once(types, parameter, visited): return true
            return type_contains_parameter_once(types, result, visited)
        Interface(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Struct(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Class(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        Enum(index, arguments):
            for argument in arguments:
                if type_contains_parameter_once(types, argument, visited): return true
        else: pass
    return false

## Report whether a type is an implemented integer width.
pub func is_integer_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Integer(bits, is_signed): return true
        else: return false

## Report whether a type is an unsigned integer width.
pub func is_unsigned_integer_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Integer(bits, is_signed): return not is_signed
        else: return false

## Bit width of an implemented integer type; 0 if the type is not an integer.
pub func integer_bit_width(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed): return bits
        else: return 0

## Width of one built-in IEEE floating-point type, or zero for another type.
pub func floating_bit_width(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Floating(bits): return bits
        else: return 0

## Inclusive bounds for signed integer types.
pub func integer_minimum(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return -128
            if bits == 16: return -32768
            if bits == 32: return -2147483647 - 1
            return -9223372036854775807 - 1
        else: return 0

## Inclusive maximum for signed integer types.
pub func integer_maximum(types: TypeTable, value: TypeId) -> i64:
    let definition = type_definition(types, value)
    if definition == none: return 0
    match definition.form:
        Integer(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return 127
            if bits == 16: return 32767
            if bits == 32: return 2147483647
            return 9223372036854775807
        else: return 0

## Inclusive maximum for unsigned integer types. Keeping this separate from
## the signed interval prevents the semantic model from losing u64's top bit.
pub func unsigned_integer_maximum(types: TypeTable, value: TypeId) -> u64:
    let definition = type_definition(types, value)
    if definition == none: return u64(0)
    match definition.form:
        Integer(bits, is_signed):
            if is_signed: return u64(0)
            if bits == 8: return u64(255)
            if bits == 16: return u64(65535)
            if bits == 32: return u64(4294967295)
            return u64(18446744073709551615)
        else: return u64(0)

## Report whether a type is an implemented floating-point type.
pub func is_floating_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Floating(bits): return true
        else: return false

## Report whether a type supports numeric arithmetic.
pub func is_numeric_type(types: TypeTable, value: TypeId) -> bool:
    return is_integer_type(types, value) or is_floating_type(types, value)

## Report whether a type supports ordered comparisons.
pub func is_ordered_type(types: TypeTable, value: TypeId) -> bool:
    let definition = type_definition(types, value)
    if definition == none: return false
    match definition.form:
        Character: return true
        String: return true
        Bytes: return true
        else: return is_numeric_type(types, value)

# mark: Symbols ================================================================================

## The identity of one module in `HirProgram.modules`.
pub struct ModuleId:
    pub let value: u32

## The identity of one binding or function in `HirProgram.symbols`.
pub struct SymbolId:
    pub let value: u32

## What declaration introduced a symbol.
pub enum SymbolKind:
    function
    parameter
    local
    constant
    global

## One program-wide semantic symbol. `value_type` is a binding's value type or
## a function's result type; full function signatures live in `HirFunction`.
pub struct HirSymbol:
    pub let id: SymbolId
    pub let name: str
    pub let kind: SymbolKind
    pub let value_type: TypeId

# mark: Runtime values =========================================================================

## Heap box so optional and tuple payloads can nest without a recursive union.
pub class BoxedValue:
    pub let value: Value

    pub init(value: Value):
        self.value = value

## The semantic oracle owns class storage, but only the interpreter knows how
## to invoke a resolved source deinitializer. This narrow callback keeps that
## execution policy out of the HIR data model while allowing deterministic
## host ARC to trigger the language's final-release semantics.
pub interface ClassFinalizer:
    func finalize(class_type: TypeId, fields: list[BoxedValue], run_deinitializer: bool)

## Shared identity behind one interpreted class value. The concrete TypeId
## names semantic application metadata in HirProgram; neither target layout nor an ARC
## header is represented here. The finalizer runs while fields are still live.
pub class ClassStorage:
    pub let class_type: TypeId
    pub let fields: list[BoxedValue]
    ## False only for the borrowed, non-finalizing semantic proxy supplied to
    ## `deinit`; weak promotion must already observe that identity as dead.
    pub let is_alive: bool
    pub var is_initialized: bool
    let finalizer: ClassFinalizer
    let calls_finalizer: bool

    pub init(class_type: TypeId, fields: list[BoxedValue], finalizer: ClassFinalizer, calls_finalizer: bool, is_alive: bool, is_initialized: bool):
        self.class_type = class_type
        self.fields = fields
        self.finalizer = finalizer
        self.calls_finalizer = calls_finalizer
        self.is_alive = is_alive
        self.is_initialized = is_initialized

    deinit:
        if self.calls_finalizer:
            self.finalizer.finalize(self.class_type, self.fields, self.is_initialized)

## One non-owning class slot. The host weak edge is an implementation of the
## HIR oracle only: canonical MIR will retain an abstract weak-slot operation,
## and each backend/runtime remains responsible for its concrete machinery.
pub class WeakClassStorage:
    pub weak var target: ClassStorage?

    pub init(target: ClassStorage?):
        self.target = target

## One mutable local promoted into shared closure storage by the HIR oracle.
## Canonical MIR retains the same cell identity while choosing no layout.
pub class CapturedCellStorage:
    pub var value: BoxedValue

    pub init(value: Value):
        self.value = BoxedValue(value = value)

## One escaping anonymous function and its environment values in capture-table
## order. Capture-free callables continue to use `Value.Function`.
pub class ClosureStorage:
    pub let closure: u32
    pub let captures: list[BoxedValue]

    pub init(closure: u32, captures: list[BoxedValue]):
        self.closure = closure
        self.captures = captures

## One semantic existential value. The concrete payload remains an ordinary
## HIR value and the conformance names its requirement implementations. The
## oracle may detach this wrapper before mutation; compiled storage policy is
## deliberately not represented here.
pub class InterfaceStorage:
    pub let conformance: u32
    pub let value: BoxedValue

    pub init(conformance: u32, value: Value):
        self.conformance = conformance
        self.value = BoxedValue(value = value)

## One backing buffer shared by a list and any immutable snapshots captured
## from it. A list replaces this buffer before its next write; slices keep the
## previous buffer alive without a source-visible lifetime.
pub class ListBuffer:
    pub var elements: list[BoxedValue]

    pub init(elements: list[BoxedValue]):
        self.elements = elements

## Mutable identity behind a semantic list value. Aliases share this object;
## snapshot detachment replaces only its backing buffer.
pub class ListStorage:
    pub var buffer: ListBuffer
    pub var has_snapshot: bool
    pub var active_iterations: i64

    pub init(elements: list[BoxedValue]):
        self.buffer = ListBuffer(elements)
        self.has_snapshot = false
        self.active_iterations = 0

## The semantic oracle keeps the concrete backing category only so it can
## read elements. Both cases are immutable owner-retaining snapshots with the
## same source-level `slice[T]` behavior.
pub union SliceBacking:
    List(buffer: ListBuffer)
    Bytes(value: list[u8])

## Immutable owner-retaining view into one contiguous backing.
pub class SliceStorage:
    pub let backing: SliceBacking
    pub let start: i64
    pub let length: i64

    pub init(backing: SliceBacking, start: i64, length: i64):
        self.backing = backing
        self.start = start
        self.length = length

## Values already decoded by HirGenerator. No consumer understands literal
## source spelling; it works only with these semantic values.
pub union Value:
    Unit
    Boolean(value: bool)
    ## Signed and unsigned mathematical values remain distinct. Their HIR type
    ## still owns width; the variant owns only the sign domain needed by
    ## semantic execution, rendering, constants, and native hosts.
    SignedInteger(value: i64)
    UnsignedInteger(value: u64)
    ## Opaque C-handle token. Its nominal type lives on the HIR node or
    ## function slot; keeping it distinct from the integer variants prevents
    ## hosts from accidentally treating a handle as arithmetic data.
    Foreign(token: i64)
    Floating(value: f64)
    Character(value: char)
    Text(value: str)
    Bytes(value: list[u8])
    ## `slice[str]`: today only the entry's `arguments`, always empty.
    TextSlice(items: list[str])
    Tuple(elements: list[BoxedValue])
    ## A fixed-size value array. Its element type and count live in TypeForm;
    ## this runtime carrier owns only the element values.
    Array(elements: list[BoxedValue])
    ## A mutable reference collection; copies share `storage`.
    List(storage: ListStorage)
    ## An immutable snapshot over one retained backing buffer.
    Slice(storage: SliceStorage)
    ## A capture-free Luce function value, named by its resolved symbol.
    Function(symbol: SymbolId)
    ## Anonymous function with a managed capture environment.
    Closure(storage: ClosureStorage)
    ## A concrete value erased behind one nominal interface contract.
    Interface(storage: InterfaceStorage)
    ## A capture-free C-callable value. The symbol names either a Luce
    ## definition whose backend address is an adapter, or an extern function.
    CFunction(symbol: SymbolId)
    ## A struct value: its fields in declaration order.
    Record(fields: list[BoxedValue])
    ## A shared class identity. Payload fields live in the identity storage so
    ## every ordinary value copy observes the same mutations.
    Class(storage: ClassStorage)
    ## Non-owning class slot behind either a source `weak var field: Class?`
    ## or a first-class compiler-known `Weak[Class]` value.
    WeakClass(storage: WeakClassStorage)
    ## Hidden shared storage for a captured mutable local.
    CapturedCell(storage: CapturedCellStorage)
    ## An enum value: which case, and its payload in declaration order.
    Variant(case_index: i64, payload: list[BoxedValue])
    Absent
    Present(value: BoxedValue)
    ## Internal carrier for the two outcomes of a `T!` call. HirGenerator
    ## ensures these are consumed only by Try/Catch nodes, so they never
    ## become ordinary source values.
    FallibleSuccess(value: BoxedValue)
    FallibleFailure(error_value: BoxedValue)

    ## Render one runtime value for command-line output.
    pub func render() -> str:
        match self:
            Unit: return "unit"
            Boolean(item): return str(item)
            SignedInteger(item): return str(item)
            UnsignedInteger(item): return str(item)
            Foreign(token): return "<foreign>"
            Floating(item): return str(item)
            Character(item): return str(item)
            Text(item): return item
            Bytes(item): return str(len(item)) + " bytes"
            TextSlice(items): return str(len(items)) + " argument(s)"
            Variant(case_index, payload):
                var text = "case " + str(case_index)
                if len(payload) == 0: return text
                text = text + "("
                var index = 0
                for field in payload:
                    if index > 0: text = text + ", "
                    text = text + field.value.render()
                    index += 1
                return text + ")"
            Record(fields):
                var text = "{"
                var index = 0
                for field in fields:
                    if index > 0: text = text + ", "
                    text = text + field.value.render()
                    index += 1
                return text + "}"
            Class(storage): return "<class-type#" + str(storage.class_type.value) + ">"
            WeakClass(storage): return "<weak-class>"
            CapturedCell(storage): return "<captured-cell>"
            Function(symbol): return "<function>"
            Closure(storage): return "<closure>"
            Interface(storage): return "<interface>"
            CFunction(symbol): return "<cfunc>"
            Tuple(elements):
                var text = "("
                var index = 0
                for element in elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + ")"
            Array(elements):
                var text = "["
                var index = 0
                for element in elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + "]"
            List(storage):
                var text = "["
                var index = 0
                for element in storage.buffer.elements:
                    if index > 0: text = text + ", "
                    text = text + element.value.render()
                    index += 1
                return text + "]"
            Slice(storage):
                var text = "["
                for index in range(0, storage.length):
                    if index > 0: text = text + ", "
                    match storage.backing:
                        List(buffer): text = text + buffer.elements[storage.start + index].value.render()
                        Bytes(value): text = text + str(value[storage.start + index])
                return text + "]"
            Absent: return "none"
            Present(item): return item.value.render()
            FallibleSuccess(item): trap("internal fallible success escaped its handler")
            FallibleFailure(item): trap("internal fallible failure escaped its handler")
