#==============================================================================================
#
#   hir_arena - Ownership-preserving operations on flat HIR bodies
#
#   DESCRIPTION:
#       Copies declaration-owned constant trees into an independently owned
#       body arena. Generic template checking therefore never places a NodeId
#       from the executable arena into its local node or operand namespace.
#
#==============================================================================================

from compiler.hir.ir import HirBodyArena, HirNode, HirNodeForm, NodeId, Operands

# mark: Typed constant cloning ================================================================

## Copy one already-checked constant expression into `destination`. Type,
## module, and source metadata stay exact; every child, operand run, and value
## receives a destination-local identity. Unsupported input is a compiler bug
## because declaration defaults pass the closed constant-expression checker.
pub func clone_hir_constant(source: HirBodyArena, destination: HirBodyArena, id: NodeId) -> NodeId:
    var form = HirNodeForm.NoneLiteral
    match source.nodes[id.value].form:
        Constant(value):
            destination.values.append(source.values[value])
            form = HirNodeForm.Constant(value = u32(len(destination.values) - 1))
        NoneLiteral: form = HirNodeForm.NoneLiteral
        Some(value): form = HirNodeForm.Some(value = clone_hir_constant(source, destination, value))
        Tuple(elements): form = HirNodeForm.Tuple(elements = clone_node_run(source, destination, elements))
        Array(elements): form = HirNodeForm.Array(elements = clone_node_run(source, destination, elements))
        StructValue(struct_index, fields): form = HirNodeForm.StructValue(
            struct_index = struct_index,
            fields = clone_placed_run(source, destination, fields),
        )
        EnumValue(enum_index, case_index, payload): form = HirNodeForm.EnumValue(
            enum_index = enum_index,
            case_index = case_index,
            payload = clone_placed_run(source, destination, payload),
        )
        ErrorCodeLiteral(package, value): form = HirNodeForm.ErrorCodeLiteral(package = package, value = value)
        FunctionAddress(function): form = HirNodeForm.FunctionAddress(function = function)
        Unary(operation, operand): form = HirNodeForm.Unary(
            operation = operation,
            operand = clone_hir_constant(source, destination, operand),
        )
        NumericConvert(value): form = HirNodeForm.NumericConvert(value = clone_hir_constant(source, destination, value))
        LayoutConstant(query, subject, field): form = HirNodeForm.LayoutConstant(query = query, subject = subject, field = field)
        Cast(value): form = HirNodeForm.Cast(value = clone_hir_constant(source, destination, value))
        Binary(left, operation, right): form = HirNodeForm.Binary(
            left = clone_hir_constant(source, destination, left),
            operation = operation,
            right = clone_hir_constant(source, destination, right),
        )
        Range(lower, upper, inclusive): form = HirNodeForm.Range(
            lower = clone_hir_constant(source, destination, lower),
            upper = clone_hir_constant(source, destination, upper),
            inclusive = inclusive,
        )
        Conditional(value, condition, alternative): form = HirNodeForm.Conditional(
            value = clone_hir_constant(source, destination, value),
            condition = clone_hir_constant(source, destination, condition),
            alternative = clone_hir_constant(source, destination, alternative),
        )
        Reference(symbol): form = HirNodeForm.Reference(symbol = symbol)
        else: trap("non-constant HIR reached declaration default cloning")

    let cloned = NodeId(value = u32(len(destination.nodes)))
    destination.nodes.append(HirNode(form = form))
    destination.node_types.append(source.node_types[id.value])
    destination.node_modules.append(source.node_modules[id.value])
    destination.node_spans.append(source.node_spans[id.value])
    return cloned

func clone_node_run(source: HirBodyArena, destination: HirBodyArena, run: Operands) -> Operands:
    let start = len(destination.extra)
    for position in range(0, i64(run.count)):
        let source_id = NodeId(value = source.extra[i64(run.start) + position])
        destination.extra.append(clone_hir_constant(source, destination, source_id).value)
    return Operands(start = u32(start), count = run.count)

func clone_placed_run(source: HirBodyArena, destination: HirBodyArena, run: Operands) -> Operands:
    let start = len(destination.extra)
    for pair in range(0, i64(run.count) // 2):
        destination.extra.append(source.extra[i64(run.start) + pair * 2])
        let source_id = NodeId(value = source.extra[i64(run.start) + pair * 2 + 1])
        destination.extra.append(clone_hir_constant(source, destination, source_id).value)
    return Operands(start = u32(start), count = run.count)
