#==============================================================================================
#
#   generation_model - Shared source-to-HIR generation contracts
#
#   DESCRIPTION:
#       Holds the typed mutable-transaction records shared by declaration
#       collection and function-body checking. These are compiler-internal
#       contracts made public only because Luce modules are file-scoped; the
#       product API remains HirGenerator.
#
#==============================================================================================

from compiler.core_types import is_reserved_core_name
from compiler.frontend.source import SourceSpan, format_diagnostic
from compiler.frontend.syntax import EnumSyntax, ExpressionSyntax, FunctionSyntax, InterfaceSyntax, ModuleSyntax, NominalTypeSyntax, TypeAliasSyntax, TypeSyntax
from compiler.frontend.tokenizer import Token
from compiler.hir.ir import BinaryOperation, BuiltinType, HirCFunction, HirClosure, HirConformance, HirEnumCase, HirExternRepresentation, HirField, HirFunction, HirInterfaceOrigin, HirInterfaceRequirement, HirNode, HirNodeForm, HirParameter, HirReceiver, HirTypeParameter
from compiler.hir.ir import HirSymbol, ModuleAuthority, ModuleId, NodeId, Operands, PackageRole, SymbolId, SymbolKind, TypeDefinition, TypeForm, TypeId, TypeTable, Value, no_node
from compiler.hir.ir import create_builtin_type_table, describe_type, resolve_builtin_type, type_contains_parameter, type_forms_match, types_match
from compiler.runtime_contract import RuntimeService

# mark: Shared generation model ===============================================================

## One parsed file with the identity supplied by its caller. This stage never
## guesses module identity from import spelling or source contents.
pub struct SourceModule:
    pub let name: str
    pub let path: str
    pub let authority: ModuleAuthority
    pub let syntax: ModuleSyntax

# A package-descriptor entry before its module and function spellings resolve
# to the identities HIR retains.
pub struct RuntimeBindingRequest:
    pub let service: RuntimeService
    pub let module_name: str
    pub let function_name: str

# One collected function signature: everything a call site or a body check
# needs to know about a function before its own body is checked.
pub struct FunctionSymbol:
    pub let symbol: SymbolId
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let receiver: HirReceiver?
    pub let parameters: list[HirParameter]
    pub let result: TypeId
    pub let source: CollectedFunctionSource
    pub let span: SourceSpan
    ## Generic declaration table index for a concrete/abstract template body,
    ## or -1 for an ordinary function.
    pub let generic_origin: i64
    ## Concrete specialization table index, or -1 for an ordinary function
    ## and for the abstract declaration probe.
    pub let generic_instance: i64
    ## Empty for ordinary declarations. Generic probes and concrete instances
    ## resolve every source `T` through this lexical type environment.
    pub let type_bindings: list[TypeBinding]

## One lexical generic name mapped to its abstract or concrete type identity.
pub struct TypeBinding:
    pub let name: str
    pub let value_type: TypeId

## A generic source declaration after its abstract signature has resolved.
## Its body is checked once using `signature`, while executable instances are
## ordinary entries in `HirGenerationState.functions`.
pub struct GenericFunctionTemplate:
    pub let generic_id: u32
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    ## Leading parameters inherited from the nominal receiver. Independently
    ## declared method parameters follow this prefix, so explicit method type
    ## arguments never redundantly repeat the already-known owner arguments.
    pub let owner_parameter_count: i64
    pub let type_parameters: list[HirTypeParameter]
    pub let signature: FunctionSymbol
    pub let syntax: FunctionSyntax
    pub let span: SourceSpan

## Memoized monomorphization key, concrete function-table entry, and the
## target-neutral provenance/cost facts retained for compiler reporting.
pub struct GenericFunctionInstance:
    pub let generic_index: i64
    pub let arguments: list[TypeId]
    pub let function_index: i64
    pub let origin_module: i64
    pub let origin_span: SourceSpan
    ## Parent specialization table index, or -1 for a source-rooted request.
    pub let parent: i64
    pub let checked_nodes: i64
    pub let check_time_ms: i64

## One member call whose meaning was fixed by abstract constraint checking.
## Specialization replays this decision instead of rediscovering a same-named
## method from the concrete receiver and losing requirement-level adapters.
pub struct GenericRequirementUse:
    pub let generic_index: i64
    pub let span: SourceSpan
    pub let interface_type: TypeId
    pub let requirement_index: i64

## Source origin retained until every nominal conformance is known and an
## applied generic type's parameter constraints can be proven. Abstract
## declaration schemas are not pending applications: only source-written
## concrete or enclosing-generic uses enter this list.
pub struct PendingGenericApplication:
    pub let module_index: i64
    pub let value_type: TypeId
    pub let span: SourceSpan

## Whether a conformance implementation is used directly or through the one
## language-permitted infallible-to-fallible adapter.
pub enum ConformanceMethodAdaptation:
    direct
    fallible_lift

## One source conformance owned by a generic nominal declaration. It remains
## abstract until an applied nominal TypeId requests a concrete conformance;
## only the resulting `HirConformance` crosses into executable HIR.
pub struct GenericConformanceTemplate:
    pub let module_index: i64
    pub let generic_id: u32
    pub let value_type: TypeId
    pub let interface_type: TypeId
    pub let is_class: bool
    pub let adaptations: list[ConformanceMethodAdaptation]
    pub let span: SourceSpan

# A callable is collected once regardless of where its implementation lives.
# This prevents external declarations from growing parallel symbol, import,
# lookup, argument-placement, and HIR-call paths.
pub union CollectedFunctionSource:
    Defined(syntax: FunctionSyntax)
    ExportedC(syntax: FunctionSyntax)
    ExternalC(contract: HirCFunction)

## The declaration collector retains which callable table owns a nominal
## initializer, method, or lifecycle function. Ordinary and generic integer
## indexes are never interpreted through a separate kind flag.
pub union CollectedNominalCallable:
    Concrete(index: i64)
    Generic(index: i64)

# Ordinary structs retain their member syntax for defaults and generic
# specialization. Extern structs have a deliberately closed field-only source
# form, so retaining a fake nominal syntax would create impossible states.
pub union CollectedStructSource:
    Defined(syntax: NominalTypeSyntax)
    External

# One declared struct: its name and type identity exist before any field is
# resolved, so fields and methods anywhere may name any struct.
pub struct CollectedStruct:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let type_bindings: list[TypeBinding]
    pub let type_id: TypeId
    pub let fields: list[HirField]
    ## Exact callable table entry for a custom initializer; `none` selects the
    ## synthesized memberwise initializer.
    pub let initializer: CollectedNominalCallable?
    pub let source: CollectedStructSource
    pub let span: SourceSpan

pub func collected_struct_is_extern(item: CollectedStruct) -> bool:
    match item.source:
        External: return true
        Defined(syntax): return false

# One declared class. Unlike a struct, construction always uses the exact
# initializer and assignment shares identity. Lifecycle methods are retained
# separately so later stages never rediscover them by spelling.
pub struct CollectedClass:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let type_bindings: list[TypeBinding]
    pub let type_id: TypeId
    pub let fields: list[HirField]
    pub let initializer: CollectedNominalCallable?
    pub let deinitializer: CollectedNominalCallable?
    pub let syntax: NominalTypeSyntax
    pub let span: SourceSpan

# One declared enum, registered by name before its cases are resolved.
pub struct CollectedEnum:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let type_bindings: list[TypeBinding]
    pub let type_id: TypeId
    pub let cases: list[HirEnumCase]
    pub let syntax: EnumSyntax
    pub let span: SourceSpan

## A nominal behavior contract registered before any signature resolves.
## `generic_id` is declaration-wide and never assumes a table index.
pub struct CollectedInterface:
    pub let origin: HirInterfaceOrigin
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let generic_id: u32
    pub let type_parameters: list[HirTypeParameter]
    pub let type_bindings: list[TypeBinding]
    pub let requirements: list[HirInterfaceRequirement]
    ## Source declarations retain their syntax while compiler-known standard
    ## interfaces are already complete semantic declarations.
    pub let syntax: InterfaceSyntax?
    pub let span: SourceSpan

# One nominal integer-represented handle. Names are registered before any
# signature is resolved so forward and cross-module references use the same
# type path as structs and enums.
pub struct CollectedExternType:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let type_id: TypeId
    pub let representation: HirExternRepresentation
    pub let span: SourceSpan

# A C-owned mutable global. Collection resolves and validates its semantic
# type once; executable HIR refers to its table identity directly.
pub struct CollectedExternVariable:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let documentation: list[str]
    pub let value_type: TypeId
    pub let span: SourceSpan

pub struct CollectedGlobal:
    pub let symbol: SymbolId
    pub let module_index: i64
    pub let name: str
    pub let value_type: TypeId
    pub let span: SourceSpan

## The complete meanings of a resolved call head. A closed union prevents a
## function, construction, and generic type-function identity from occupying
## one sentinel-filled record with contradictory fields.
pub union ResolvedCallee:
    Function(function_index: i64, receiver: NodeId)
    StructConstructor(struct_index: i64)
    EnumConstructor(enum_index: i64, case_index: i64)
    GenericTypeFunction(generic_index: i64, owner: TypeId)

# One binding a match arm introduces: its name, symbol, and type, shared by
# every alternative of the arm.
pub struct ArmBinding:
    pub let name: str
    pub let symbol: SymbolId
    pub let value_type: TypeId

# One package error-code declaration already seen. The numeric component must
# be unique across every module in the package; the name makes the diagnostic
# useful without becoming runtime identity.
pub struct DeclaredErrorCode:
    pub let value: u32
    pub let module_index: i64
    pub let name: str

# What the arms of one `match` have covered so far, for exhaustiveness and
# reachability. Literal values are compared structurally; ranges are stored
# as inclusive (low, high) pairs.
pub class MatchCoverage:
    pub var saw_wildcard: bool
    pub let cases: list[i64]
    pub let literals: list[Value]
    pub let ranges: list[Value]

    pub init():
        self.saw_wildcard = false
        self.cases = list[i64]()
        self.literals = list[Value]()
        self.ranges = list[Value]()

pub struct ImportedModule:
    pub let name: str
    pub let module_index: i64

pub union ImportedValue:
    Function(function_index: i64)
    GenericFunction(generic_index: i64)
    ExternalVariable(variable_index: i64)

pub struct ImportedValueBinding:
    pub let name: str
    pub let value: ImportedValue

# What one module's imports made visible: module names for qualified access,
# and one typed value namespace for selective imports. Adding another source
# value kind extends `ImportedValue`; it does not add another parallel table.
pub struct ModuleBindings:
    pub let modules: list[ImportedModule]
    pub let values: list[ImportedValueBinding]

# One live local: `let total = 0` puts a `total` in scope until its suite ends.
pub struct LocalBinding:
    pub let symbol: SymbolId
    pub let name: str
    pub let value_type: TypeId
    pub let is_mutable: bool
    ## Source reads normally use `value`; a closure-only alias may instead
    ## name shared-cell storage or a hidden weak slot.
    pub let storage: LocalStorage

pub enum LocalStorage:
    value
    shared_cell
    weak_capture

# One module-level `type Name = T` waiting to be resolved, or already resolved.
pub struct CollectedAlias:
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let syntax: TypeAliasSyntax
    pub let span: SourceSpan
    pub let resolved: TypeId?

# One module-level constant. `typed` is filled after signatures exist.
pub struct CollectedConstant:
    pub let symbol: SymbolId
    pub let module_index: i64
    pub let name: str
    pub let is_public: bool
    pub let annotation: TypeSyntax?
    pub let value: ExpressionSyntax
    pub let span: SourceSpan
    # `no_node` until the constant's initializer has been checked.
    pub let typed: NodeId

# This stage resolves source operator spelling and result typing together, so
# no later HIR consumer needs to repeat either half of the operator table.
pub struct ResolvedBinary:
    pub let operation: BinaryOperation
    pub let result: TypeId

# The two checked operands retain source order even when contextual literal
# typing needs to learn the right operand's type first.
pub struct CheckedBinaryOperands:
    pub let left: NodeId
    pub let right: NodeId

# One fully resolved assignment destination. `steps` is the compact HIR
# `(kind, payload)` path from the root symbol to `value_type`.
pub struct CheckedPlace:
    pub let symbol: SymbolId
    ## `-1` for a local root; otherwise the sealed runtime global index.
    pub let global: i64
    pub let value_type: TypeId
    pub let steps: list[u32]
    pub let initializer_field: bool

# The resolved fact shared by every native pointer operation. Mutability is a
# capability on the address token, while the pointee remains an ordinary HIR
# type identity.
pub struct NativePointerType:
    pub let pointee: TypeId
    pub let is_mutable: bool

## The narrow semantic services that declaration collection and focused HIR
## feature owners borrow from the mutually recursive body checker.
pub interface HirSemanticChecker:
    func check_constant_expression(module_index: i64, value: ExpressionSyntax, expected: TypeId, what: str) -> NodeId!
    func check_expression_for_feature(value: ExpressionSyntax, expected: TypeId?) -> NodeId!
    func require_type_for_feature(value: NodeId, expected: TypeId?) -> NodeId!
    func check_function(function: FunctionSymbol) -> HirFunction!
    func check_function_address_for_feature(function_index: i64, span: SourceSpan, expected: TypeId?) -> NodeId!
    func instantiate_generic_method_for_feature(owner_type: TypeId, name: str, span: SourceSpan) -> i64!
    func materialize_generic_class_lifecycle_for_feature(value_type: TypeId) -> !
    func require_mutable_receiver_for_feature(value: NodeId, span: SourceSpan) -> !
    func checkpoint_generic_closures() -> i64
    func restore_generic_closures(checkpoint: i64)

# mark: Generation transaction ================================================================

## Owns every table and cursor in one source-to-HIR transaction. Declaration
## collection and body checking receive the same instance, so type, symbol,
## node, and source identities cannot drift across their module boundary.
pub class HirGenerationState:
    pub let package_identity: str
    pub let package_role: PackageRole
    pub let sources: list[SourceModule]
    pub let runtime_binding_requests: list[RuntimeBindingRequest]
    pub let types: TypeTable
    pub let symbols: list[HirSymbol]
    pub let aliases: list[CollectedAlias]
    pub let constants: list[CollectedConstant]
    pub let alias_stack: list[str]
    pub let constant_stack: list[str]
    pub let module_bindings: list[ModuleBindings]
    # Every function signature in the program, across all modules; methods
    # are here too, distinguished by `receiver`.
    pub let functions: list[FunctionSymbol]
    pub let generic_functions: list[GenericFunctionTemplate]
    pub let generic_instances: list[GenericFunctionInstance]
    pub let generic_requirement_uses: list[GenericRequirementUse]
    pub let monomorphization_budget: i64
    ## Optional monotonic clock supplied by the compiler product. The HIR
    ## transaction remains deterministic and host-independent when absent.
    pub let clock: (func() -> i64)?
    pub var next_generic_identity: u32
    pub let structs: list[CollectedStruct]
    pub let classes: list[CollectedClass]
    pub let enums: list[CollectedEnum]
    pub let interfaces: list[CollectedInterface]
    pub let conformances: list[HirConformance]
    pub let generic_conformances: list[GenericConformanceTemplate]
    pub let pending_generic_applications: list[PendingGenericApplication]
    pub let extern_types: list[CollectedExternType]
    pub let extern_variables: list[CollectedExternVariable]
    pub let globals: list[CollectedGlobal]
    pub let closures: list[HirClosure]
    pub let shared_cells: list[SymbolId]
    pub let generated_functions: list[HirFunction]
    pub var next_symbol: i64
    # These cursors describe the declaration or function currently checked.
    # Only one checker mutates them at a time within the generation transaction.
    pub var current_module: i64
    pub var current_result: TypeId
    pub var current_receiver: HirReceiver?
    pub var bindings: ModuleBindings
    pub var locals: list[LocalBinding]
    pub var loop_depth: i64
    pub var recovery_types: list[TypeId]
    pub var current_constant: i64
    pub var current_type_bindings: list[TypeBinding]
    pub var current_generic_origin: i64
    pub var current_generic_instance: i64
    pub let error_codes: list[DeclaredErrorCode]
    # Children precede parents in this shared flat HIR arena.
    pub let nodes: list[HirNode]
    pub let node_types: list[TypeId]
    pub let node_modules: list[ModuleId]
    pub let node_spans: list[SourceSpan]
    pub let extra: list[u32]
    pub let values: list[Value]

    pub init(package_identity: str, sources: list[SourceModule], package_role: PackageRole, monomorphization_budget: i64, clock: (func() -> i64)?):
        self.package_identity = package_identity
        self.package_role = package_role
        self.sources = sources
        self.runtime_binding_requests = list[RuntimeBindingRequest]()
        self.types = create_builtin_type_table()
        self.symbols = list[HirSymbol]()
        self.aliases = list[CollectedAlias]()
        self.constants = list[CollectedConstant]()
        self.alias_stack = list[str]()
        self.constant_stack = list[str]()
        self.module_bindings = list[ModuleBindings]()
        self.functions = list[FunctionSymbol]()
        self.generic_functions = list[GenericFunctionTemplate]()
        self.generic_instances = list[GenericFunctionInstance]()
        self.generic_requirement_uses = list[GenericRequirementUse]()
        self.monomorphization_budget = monomorphization_budget
        self.clock = clock
        self.next_generic_identity = 0
        self.structs = list[CollectedStruct]()
        self.classes = list[CollectedClass]()
        self.enums = list[CollectedEnum]()
        self.interfaces = list[CollectedInterface]()
        self.conformances = list[HirConformance]()
        self.generic_conformances = list[GenericConformanceTemplate]()
        self.pending_generic_applications = list[PendingGenericApplication]()
        self.extern_types = list[CollectedExternType]()
        self.extern_variables = list[CollectedExternVariable]()
        self.globals = list[CollectedGlobal]()
        self.closures = list[HirClosure]()
        self.shared_cells = list[SymbolId]()
        self.generated_functions = list[HirFunction]()
        self.next_symbol = 0
        self.current_module = 0
        self.current_result = resolve_builtin_type(BuiltinType.unit)
        self.current_receiver = none
        self.bindings = ModuleBindings(modules = list[ImportedModule](), values = list[ImportedValueBinding]())
        self.locals = list[LocalBinding]()
        self.loop_depth = 0
        self.recovery_types = list[TypeId]()
        self.current_constant = -1
        self.current_type_bindings = list[TypeBinding]()
        self.current_generic_origin = -1
        self.current_generic_instance = -1
        self.error_codes = list[DeclaredErrorCode]()
        self.nodes = list[HirNode]()
        self.node_types = list[TypeId]()
        self.node_modules = list[ModuleId]()
        self.node_spans = list[SourceSpan]()
        self.extra = list[u32]()
        self.values = list[Value]()

    ## Read the injected compiler clock. Tests and embedding callers that do
    ## not request operational accounting receive a stable zero duration.
    pub func clock_ms() -> i64:
        if self.clock == none: return 0
        let read = self.clock else trap("generation clock disappeared")
        return read()

    pub func elapsed_ms(start: i64) -> i64:
        if self.clock == none: return 0
        let elapsed = self.clock_ms() - start
        if elapsed < 0: return 0
        return elapsed

    ## Replace immutable accounting fields after one concrete body has been
    ## checked, preserving the memoization identity and expansion ancestry.
    pub func generic_instance_with_cost(instance: GenericFunctionInstance, checked_nodes: i64, check_time_ms: i64) -> GenericFunctionInstance:
        return GenericFunctionInstance(
            generic_index = instance.generic_index,
            arguments = instance.arguments,
            function_index = instance.function_index,
            origin_module = instance.origin_module,
            origin_span = instance.origin_span,
            parent = instance.parent,
            checked_nodes = checked_nodes,
            check_time_ms = check_time_ms,
        )

    # mark: Node table ==========================================================================

    pub func push_node(form: HirNodeForm, value_type: TypeId, span: SourceSpan) -> NodeId:
        var normalized_form = form
        var normalized_type = value_type
        let prefix = self.diverging_eager_prefix(form)
        if prefix != none:
            normalized_form = HirNodeForm.DivergingSequence(values = self.push_nodes(prefix))
            normalized_type = resolve_builtin_type(BuiltinType.never_type)
        self.nodes.append(HirNode(form = normalized_form))
        self.node_types.append(normalized_type)
        self.node_modules.append(ModuleId(value = u32(self.current_module)))
        self.node_spans.append(span)
        return NodeId(value = u32(len(self.nodes) - 1))

    # A statement has no value; its type slot holds `unit`.
    pub func push_statement(form: HirNodeForm, span: SourceSpan) -> NodeId:
        return self.push_node(form, resolve_builtin_type(BuiltinType.unit), span)

    pub func push_run(entries: list[u32]) -> Operands:
        let start = len(self.extra)
        for entry in entries: self.extra.append(entry)
        return Operands(start = u32(start), count = u32(len(entries)))

    pub func push_nodes(ids: list[NodeId]) -> Operands:
        let entries = list[u32]()
        for id in ids: entries.append(id.value)
        return self.push_run(entries)

    pub func node_form(id: NodeId) -> HirNodeForm:
        return self.nodes[id.value].form

    pub func type_of(id: NodeId) -> TypeId:
        return self.node_types[id.value]

    pub func span_of(id: NodeId) -> SourceSpan:
        return self.node_spans[id.value]

    # mark: Divergence =========================================================================

    # Resolve bottom coercion once at the flat HIR construction boundary.
    # Every listed operand is unconditionally eager and appears in source
    # evaluation order. Conditional/short-circuit operands are deliberately
    # excluded, so a terminating arm does not erase a reachable sibling.
    func diverging_eager_prefix(form: HirNodeForm) -> list[NodeId]?:
        let eager = list[NodeId]()
        match form:
            NeverCoercion(value): return none
            DivergingSequence(values): return none
            NativeLoad(pointer): eager.append(pointer)
            NativeStore(pointer, value):
                eager.append(pointer)
                eager.append(value)
            NativeAdvance(pointer, count):
                eager.append(pointer)
                eager.append(count)
            NativeRebind(pointer): eager.append(pointer)
            NativeMove(destination, source, count):
                eager.append(destination)
                eager.append(source)
                eager.append(count)
            NativeAllocate(element_type, count): eager.append(count)
            NativeDeallocate(pointer, element_type, count):
                eager.append(pointer)
                eager.append(count)
            NativeIsNull(pointer): eager.append(pointer)
            NativeIsSame(left, right):
                eager.append(left)
                eager.append(right)
            NativeAddressHash(pointer): eager.append(pointer)
            NativeFloatBits(value): eager.append(value)
            NativeArena(end): eager.append(end)
            NumericConvert(value): eager.append(value)
            Discard(value): eager.append(value)
            StringScalarCount(value): eager.append(value)
            BuiltinDisplay(value): eager.append(value)
            FormattedString(parts): self.append_node_run(eager, parts)
            Hash(value): eager.append(value)
            SequenceLength(value): eager.append(value)
            SequenceIndex(value, index):
                eager.append(value)
                eager.append(index)
            Unary(operation, operand): eager.append(operand)
            Binary(left, operation, right):
                eager.append(left)
                match operation:
                    LogicalAnd, LogicalOr: pass
                    else: eager.append(right)
            Conditional(value, condition, alternative): eager.append(condition)
            Range(lower, upper, inclusive):
                eager.append(lower)
                eager.append(upper)
            Call(function, arguments): self.append_placed_node_run(eager, arguments)
            InterfaceValue(value, conformance): eager.append(value)
            InterfaceCall(receiver, interface_type, requirement, arguments):
                eager.append(receiver)
                self.append_node_run(eager, arguments)
            ClosureValue(closure, initializers): self.append_node_run(eager, initializers)
            IndirectCall(callee, arguments):
                eager.append(callee)
                self.append_node_run(eager, arguments)
            Initialize(function, arguments): self.append_placed_node_run(eager, arguments)
            Raise(code, message):
                eager.append(code)
                eager.append(message)
            Trap(message): eager.append(message)
            Assert(condition, message):
                eager.append(condition)
                eager.append(message)
            Try(value): eager.append(value)
            Catch(value, failure, body): eager.append(value)
            Tuple(elements): self.append_node_run(eager, elements)
            Array(elements): self.append_node_run(eager, elements)
            List(elements): self.append_node_run(eager, elements)
            ListCopy(value): eager.append(value)
            SequenceSlice(value, start, end):
                eager.append(value)
                if start.value != no_node: eager.append(start)
                if end.value != no_node: eager.append(end)
            ListAppend(value, element):
                eager.append(value)
                eager.append(element)
            ListInsert(value, index, element):
                eager.append(value)
                eager.append(index)
                eager.append(element)
            ListRemoveAt(value, index):
                eager.append(value)
                eager.append(index)
            ListClear(value): eager.append(value)
            ListReserve(value, minimum_capacity):
                eager.append(value)
                eager.append(minimum_capacity)
            Map(entries): self.append_node_run(eager, entries)
            Set(elements): self.append_node_run(eager, elements)
            MapLookup(value, key):
                eager.append(value)
                eager.append(key)
            MapRemove(value, key):
                eager.append(value)
                eager.append(key)
            MapClear(value): eager.append(value)
            MapCopy(value): eager.append(value)
            MapReserve(value, minimum_capacity):
                eager.append(value)
                eager.append(minimum_capacity)
            SetContains(value, element):
                eager.append(value)
                eager.append(element)
            SetInsert(value, element):
                eager.append(value)
                eager.append(element)
            SetRemove(value, element):
                eager.append(value)
                eager.append(element)
            SetClear(value): eager.append(value)
            SetCopy(value): eager.append(value)
            SetReserve(value, minimum_capacity):
                eager.append(value)
                eager.append(minimum_capacity)
            WeakCreate(value): eager.append(value)
            WeakGet(value): eager.append(value)
            Element(value, index): eager.append(value)
            StructValue(struct_index, fields): self.append_placed_node_run(eager, fields)
            FieldAccess(value, field): eager.append(value)
            Some(value): eager.append(value)
            ElseFallback(value, arm): eager.append(value)
            EnumValue(enum_index, case_index, payload): self.append_placed_node_run(eager, payload)
            Match(subject, arms, has_result): eager.append(subject)
            else: return none
        let prefix = list[NodeId]()
        for node in eager:
            if node.value == no_node: continue
            prefix.append(node)
            if self.node_is_diverging(node): return prefix
        return none

    func append_node_run(nodes: list[NodeId], run: Operands):
        for position in range(0, i64(run.count)):
            let node = NodeId(value = self.extra[i64(run.start) + position])
            if node.value != no_node: nodes.append(node)

    func append_placed_node_run(nodes: list[NodeId], run: Operands):
        for pair in range(0, i64(run.count) // 2):
            nodes.append(NodeId(value = self.extra[i64(run.start) + pair * 2 + 1]))

    func node_is_diverging(node: NodeId) -> bool:
        match self.types.definitions[self.type_of(node).value].form:
            Never: return true
            else: pass
        match self.node_form(node):
            NeverCoercion(value): return true
            DivergingSequence(values): return true
            else: return false


    # mark: Name lookup =========================================================================

    # A new local may not reuse a live name or hide an import.
    pub func require_free_local_name(name: str, span: SourceSpan) -> !:
        try self.require_free_local_name_after(name, span, 0)

    ## Apply the same namespace rules at a nested function boundary while
    ## permitting its own locals and parameters to shadow inherited locals.
    pub func require_free_local_name_after(name: str, span: SourceSpan, first_local: i64) -> !:
        if is_reserved_core_name(name):
            try self.fail(span, "`" + name + "` belongs to the compiler-known core namespace")
        var local_index = first_local
        while local_index < len(self.locals):
            if self.locals[local_index].name == name:
                try self.fail(span, "`" + name + "` is already bound in this scope")
            local_index += 1
        if self.find_imported_function(name) >= 0 or self.find_imported_extern_variable(name) >= 0 or self.find_imported_module(name) >= 0:
            try self.fail(span, "local `" + name + "` cannot shadow an imported name")
        if self.find_global_in_module(self.current_module, name) >= 0:
            try self.fail(span, "local `" + name + "` cannot shadow a runtime global")

    # Innermost binding first, so a suite's binding wins over an outer one.
    pub func find_local(name: str) -> i64:
        var index = len(self.locals) - 1
        while index >= 0:
            if self.locals[index].name == name: return index
            index -= 1
        return -1

    ## Promote one ordinary mutable local to shared cell storage exactly once.
    pub func mark_shared_cell(symbol: SymbolId):
        if self.is_shared_cell(symbol): return
        self.shared_cells.append(symbol)

    pub func is_shared_cell(symbol: SymbolId) -> bool:
        for existing in self.shared_cells:
            if existing.value == symbol.value: return true
        return false

    # A bare name resolves to a selectively imported function first, then to a
    # declaration in the current module.
    pub func find_visible_function(name: str) -> i64:
        let imported = self.find_imported_function(name)
        if imported >= 0: return imported
        return self.find_function_in_module(self.current_module, name)

    pub func find_visible_generic_function(name: str) -> i64:
        let imported = self.find_imported_generic_function(name)
        if imported >= 0: return imported
        return self.find_generic_function_in_module(self.current_module, name)

    func find_imported_function(name: str) -> i64:
        for imported in self.bindings.values:
            if imported.name != name: continue
            match imported.value:
                Function(function_index): return function_index
                GenericFunction(generic_index): return -1
                ExternalVariable(variable_index): return -1
        return -1

    func find_imported_generic_function(name: str) -> i64:
        for imported in self.bindings.values:
            if imported.name != name: continue
            match imported.value:
                GenericFunction(generic_index): return generic_index
                Function(function_index): return -1
                ExternalVariable(variable_index): return -1
        return -1

    func find_imported_extern_variable(name: str) -> i64:
        for imported in self.bindings.values:
            if imported.name != name: continue
            match imported.value:
                ExternalVariable(variable_index): return variable_index
                Function(function_index): return -1
                GenericFunction(generic_index): return -1
        return -1

    pub func find_visible_extern_variable(name: str) -> i64:
        let imported = self.find_imported_extern_variable(name)
        if imported >= 0: return imported
        return self.find_extern_variable_in_module(self.current_module, name)

    pub func find_imported_module(name: str) -> i64:
        for imported in self.bindings.modules:
            if imported.name == name: return imported.module_index
        return -1

    # The same lookup for a module other than the one being checked. While
    # signatures are collected the import bindings do not exist yet, so a
    # whole-module import (`import math`, `import math as m`) is read from the
    # import syntax directly; that is all a type name in a signature can use.
    pub func find_imported_module_of(module_index: i64, name: str) -> i64:
        if module_index < len(self.module_bindings):
            for imported in self.module_bindings[module_index].modules:
                if imported.name == name: return imported.module_index
            return -1
        for imported in self.sources[module_index].syntax.imports:
            if len(imported.names) > 0: continue
            let local_name = imported.alias_name else imported.path.last()
            if local_name == name: return self.find_source(imported.path.dotted())
        return -1

    # Free functions only; methods are reached through `find_method`.
    pub func find_function_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.functions)):
            if self.functions[index].receiver != none: continue
            if self.functions[index].module_index == module_index and self.functions[index].name == name: return index
        return -1

    pub func find_generic_function_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.generic_functions)):
            let generic = self.generic_functions[index]
            if generic.signature.receiver != none: continue
            if generic.module_index == module_index and generic.name == name: return index
        return -1

    pub func allocate_generic_identity() -> u32:
        let identity = self.next_generic_identity
        self.next_generic_identity += 1
        return identity

    ## Recover the written bounds of one abstract type parameter regardless
    ## of which declaration kind owns it. Generic inference and delayed
    ## application validation must agree on inherited evidence.
    pub func type_parameter_constraints(generic_id: u32, position: u32) -> list[TypeId]?:
        for generic in self.generic_functions:
            if generic.generic_id == generic_id: return generic.type_parameters[position].constraints
        for contract in self.interfaces:
            if contract.generic_id == generic_id: return contract.type_parameters[position].constraints
        for item in self.structs:
            if item.generic_id == generic_id: return item.type_parameters[position].constraints
        for item in self.classes:
            if item.generic_id == generic_id: return item.type_parameters[position].constraints
        for item in self.enums:
            if item.generic_id == generic_id: return item.type_parameters[position].constraints
        return none

    ## Find one exact explicit conformance. Constraint validation, static
    ## specialization, and existential conversion all share this identity
    ## lookup rather than growing subtly different scans.
    pub func find_conformance(value_type: TypeId, interface_type: TypeId) -> i64:
        for index in range(0, len(self.conformances)):
            let conformance = self.conformances[index]
            if types_match(conformance.value_type, value_type) and types_match(conformance.interface_type, interface_type):
                return index
        return -1

    pub func find_type_binding(name: str) -> TypeId?:
        for binding in self.current_type_bindings:
            if binding.name == name: return binding.value_type
        return none

    ## Replace one template's abstract parameters throughout a structural
    ## type. Nominal generic types will extend this same operation; callers
    ## never reconstruct types independently.
    pub func substitute_type(value: TypeId, generic_id: u32, arguments: list[TypeId]) -> TypeId:
        match self.types.definitions[value.value].form:
            TypeParameter(owner, position):
                if owner != generic_id: return value
                if i64(position) >= len(arguments): trap("generic substitution argument is missing")
                return arguments[position]
            Slice(element): return self.intern_slice(self.substitute_type(element, generic_id, arguments))
            List(element): return self.intern_list(self.substitute_type(element, generic_id, arguments))
            Map(key, element):
                return self.intern_map(
                    self.substitute_type(key, generic_id, arguments),
                    self.substitute_type(element, generic_id, arguments),
                )
            Set(element): return self.intern_set(self.substitute_type(element, generic_id, arguments))
            Weak(inner): return self.intern_weak(self.substitute_type(inner, generic_id, arguments))
            Range(element): return self.intern_range(self.substitute_type(element, generic_id, arguments))
            Array(element, count): return self.intern_array(self.substitute_type(element, generic_id, arguments), count)
            Optional(inner): return self.intern_optional(self.substitute_type(inner, generic_id, arguments))
            Fallible(inner): return self.intern_fallible(self.substitute_type(inner, generic_id, arguments))
            Tuple(elements):
                let substituted = list[TypeId]()
                for element in elements: substituted.append(self.substitute_type(element, generic_id, arguments))
                return self.intern_tuple(substituted)
            Function(parameters, result):
                let substituted = list[TypeId]()
                for parameter in parameters: substituted.append(self.substitute_type(parameter, generic_id, arguments))
                return self.intern_function_type(substituted, self.substitute_type(result, generic_id, arguments))
            CFunction(parameters, result):
                let substituted = list[TypeId]()
                for parameter in parameters: substituted.append(self.substitute_type(parameter, generic_id, arguments))
                return self.intern_c_function_type(substituted, self.substitute_type(result, generic_id, arguments))
            NativePointer(pointee, is_mutable):
                return self.intern_native_pointer(self.substitute_type(pointee, generic_id, arguments), is_mutable)
            Interface(index, interface_arguments):
                let substituted = list[TypeId]()
                for argument in interface_arguments: substituted.append(self.substitute_type(argument, generic_id, arguments))
                return self.intern_interface(index, substituted)
            Struct(index, nominal_arguments):
                let substituted = list[TypeId]()
                for argument in nominal_arguments: substituted.append(self.substitute_type(argument, generic_id, arguments))
                return self.intern_struct(index, substituted)
            Class(index, nominal_arguments):
                let substituted = list[TypeId]()
                for argument in nominal_arguments: substituted.append(self.substitute_type(argument, generic_id, arguments))
                return self.intern_class(index, substituted)
            Enum(index, nominal_arguments):
                let substituted = list[TypeId]()
                for argument in nominal_arguments: substituted.append(self.substitute_type(argument, generic_id, arguments))
                return self.intern_enum(index, substituted)
            else: return value

    ## Whether a structural type still contains an abstract generic identity.
    ## Executable conformances and functions may be published only after this
    ## returns false.
    pub func contains_type_parameter(value: TypeId) -> bool:
        return type_contains_parameter(self.types, value)

    pub func find_generic_instance(generic_index: i64, arguments: list[TypeId]) -> i64:
        for instance in self.generic_instances:
            if instance.generic_index != generic_index or len(instance.arguments) != len(arguments): continue
            var matches = true
            for index in range(0, len(arguments)):
                if not types_match(instance.arguments[index], arguments[index]): matches = false
            if matches: return instance.function_index
        return -1

    ## Return an application's arguments when two nominal types name the same
    ## declaration and kind. Method and conformance specialization share this
    ## identity rule instead of maintaining parallel nominal-form switches.
    pub func nominal_application_arguments(template: TypeId, application: TypeId) -> list[TypeId]?:
        let arguments = list[TypeId]()
        match self.types.definitions[template.value].form:
            Struct(template_index, template_arguments):
                match self.types.definitions[application.value].form:
                    Struct(application_index, application_arguments):
                        if template_index != application_index: return none
                        for argument in application_arguments: arguments.append(argument)
                    else: return none
            Class(template_index, template_arguments):
                match self.types.definitions[application.value].form:
                    Class(application_index, application_arguments):
                        if template_index != application_index: return none
                        for argument in application_arguments: arguments.append(argument)
                    else: return none
            Enum(template_index, template_arguments):
                match self.types.definitions[application.value].form:
                    Enum(application_index, application_arguments):
                        if template_index != application_index: return none
                        for argument in application_arguments: arguments.append(argument)
                    else: return none
            else: return none
        return arguments

    pub func find_alias_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.aliases)):
            if self.aliases[index].module_index == module_index and self.aliases[index].name == name: return index
        return -1

    pub func find_constant_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.constants)):
            if self.constants[index].module_index == module_index and self.constants[index].name == name: return index
        return -1

    pub func find_extern_type_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.extern_types)):
            if self.extern_types[index].module_index == module_index and self.extern_types[index].name == name: return index
        return -1

    pub func find_extern_variable_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.extern_variables)):
            if self.extern_variables[index].module_index == module_index and self.extern_variables[index].name == name: return index
        return -1

    pub func find_global_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.globals)):
            if self.globals[index].module_index == module_index and self.globals[index].name == name: return index
        return -1

    # Intern by `TypeForm`. The diagnostic `name` is stored for messages; two
    # forms that describe the same structure share one TypeId.
    pub func intern_named(name: str, form: TypeForm) -> TypeId:
        for existing in self.types.definitions:
            if type_forms_match(existing.form, form): return existing.id
        let id = TypeId(value = u32(len(self.types.definitions)))
        self.types.definitions.append(TypeDefinition(id = id, name = name, form = form))
        return id

    pub func intern_optional(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "?", TypeForm.Optional(value = inner))

    pub func intern_fallible(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "!", TypeForm.Fallible(value = inner))

    pub func intern_slice(inner: TypeId) -> TypeId:
        return self.intern_named("slice[" + self.describe_type(inner) + "]", TypeForm.Slice(element = inner))

    pub func intern_list(inner: TypeId) -> TypeId:
        return self.intern_named("list[" + self.describe_type(inner) + "]", TypeForm.List(element = inner))

    pub func intern_map(key: TypeId, value: TypeId) -> TypeId:
        return self.intern_named(
            "map[" + self.describe_type(key) + ", " + self.describe_type(value) + "]",
            TypeForm.Map(key = key, value = value),
        )

    pub func intern_set(inner: TypeId) -> TypeId:
        return self.intern_named("set[" + self.describe_type(inner) + "]", TypeForm.Set(element = inner))

    pub func intern_weak(inner: TypeId) -> TypeId:
        return self.intern_named("Weak[" + self.describe_type(inner) + "]", TypeForm.Weak(value = inner))

    pub func intern_range(inner: TypeId) -> TypeId:
        return self.intern_named("range[" + self.describe_type(inner) + "]", TypeForm.Range(element = inner))

    pub func intern_array(element: TypeId, count: i64) -> TypeId:
        return self.intern_named("array[" + self.describe_type(element) + ", " + str(count) + "]", TypeForm.Array(element = element, count = count))

    pub func intern_tuple(elements: list[TypeId]) -> TypeId:
        var name = "("
        var index = 0
        for element in elements:
            if index > 0: name = name + ", "
            name = name + self.describe_type(element)
            index += 1
        return self.intern_named(name + ")", TypeForm.Tuple(elements = elements))

    pub func intern_function_type(parameters: list[TypeId], result: TypeId) -> TypeId:
        var name = "func("
        var index = 0
        for parameter in parameters:
            if index > 0: name = name + ", "
            name = name + self.describe_type(parameter)
            index += 1
        return self.intern_named(name + ") -> " + self.describe_type(result), TypeForm.Function(parameters = parameters, result = result))

    pub func intern_c_function_type(parameters: list[TypeId], result: TypeId) -> TypeId:
        var name = "cfunc("
        var index = 0
        for parameter in parameters:
            if index > 0: name = name + ", "
            name = name + self.describe_type(parameter)
            index += 1
        return self.intern_named(name + ") -> " + self.describe_type(result), TypeForm.CFunction(parameters = parameters, result = result))

    pub func intern_native_pointer(pointee: TypeId, is_mutable: bool) -> TypeId:
        var name = "native_ptr["
        if is_mutable: name = "native_mut_ptr["
        return self.intern_named(name + self.describe_type(pointee) + "]", TypeForm.NativePointer(pointee = pointee, is_mutable = is_mutable))

    pub func intern_interface(index: i64, arguments: list[TypeId]) -> TypeId:
        var name = self.interfaces[index].name
        if len(arguments) > 0:
            name = name + "["
            for position in range(0, len(arguments)):
                if position > 0: name = name + ", "
                name = name + self.describe_type(arguments[position])
            name = name + "]"
        return self.intern_named(name, TypeForm.Interface(index = index, arguments = arguments))

    pub func intern_struct(index: i64, arguments: list[TypeId]) -> TypeId:
        return self.intern_nominal(self.structs[index].name, TypeForm.Struct(index = index, arguments = arguments), arguments)

    pub func intern_class(index: i64, arguments: list[TypeId]) -> TypeId:
        return self.intern_nominal(self.classes[index].name, TypeForm.Class(index = index, arguments = arguments), arguments)

    pub func intern_enum(index: i64, arguments: list[TypeId]) -> TypeId:
        return self.intern_nominal(self.enums[index].name, TypeForm.Enum(index = index, arguments = arguments), arguments)

    func intern_nominal(base_name: str, form: TypeForm, arguments: list[TypeId]) -> TypeId:
        var name = base_name
        if len(arguments) > 0:
            name = name + "["
            for position in range(0, len(arguments)):
                if position > 0: name = name + ", "
                name = name + self.describe_type(arguments[position])
            name = name + "]"
        return self.intern_named(name, form)

    # Unwrap only the contextual optional injection that `require_type`
    # already owns. This lets `Some(c_callback)` choose C conversion without
    # duplicating optional construction here.
    pub func c_function_context(expected: TypeId?) -> TypeId?:
        if expected == none: return none
        match self.types.definitions[expected.value].form:
            CFunction(parameters, result): return expected
            Optional(inner):
                match self.types.definitions[inner.value].form:
                    CFunction(parameters, result): return inner
                    else: return none
            else: return none

    pub func optional_inner(value: TypeId) -> TypeId?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Optional(inner): return inner
            else: return none

    pub func range_inner(value: TypeId) -> TypeId?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Range(inner): return inner
            else: return none

    pub func tuple_elements(value: TypeId) -> list[TypeId]?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Tuple(elements): return elements
            else: return none

    pub func find_source(name: str) -> i64:
        for index in range(0, len(self.sources)):
            if self.sources[index].name == name: return index
        return -1

    # Allocate one program-wide identity and record the declaration metadata
    # that diagnostics, tooling, and later analysis can query by that identity.
    pub func make_symbol(name: str, kind: SymbolKind, value_type: TypeId) -> SymbolId:
        let symbol = SymbolId(value = u32(self.next_symbol))
        self.next_symbol += 1
        self.symbols.append(HirSymbol(id = symbol, name = name, kind = kind, value_type = value_type))
        return symbol



    # mark: Type validation ====================================================================

    # Render and locate identities only at diagnostics and source boundaries.
    pub func describe_type(value: TypeId) -> str:
        return describe_type(self.types, value)

    func diagnostic(span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[self.current_module].path, span, message)

    pub func diagnostic_at(module_index: i64, span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[module_index].path, span, message)

    func fail(span: SourceSpan, message: str) -> !:
        error(self.diagnostic(span, message))

    pub func fail_at(module_index: i64, span: SourceSpan, message: str) -> !:
        error(self.diagnostic_at(module_index, span, message))

    pub func fallible_inner(value: TypeId) -> TypeId?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Fallible(inner): return inner
            else: return none

    # Fallibility is control flow, not a source-level value representation.
    # Follow value containers so aliases cannot hide it in storage; function
    # types are a boundary because their result may itself declare an effect.
    pub func contains_fallible(value: TypeId) -> bool:
        let visited = list[bool]()
        for index in range(0, len(self.types.definitions)): visited.append(false)
        return self.contains_fallible_once(value, visited)

    func contains_fallible_once(value: TypeId, visited: list[bool]) -> bool:
        if i64(value.value) >= len(self.types.definitions): return false
        while len(visited) < len(self.types.definitions): visited.append(false)
        if visited[value.value]: return false
        visited[value.value] = true
        match self.types.definitions[value.value].form:
            Fallible(inner): return true
            Optional(inner): return self.contains_fallible_once(inner, visited)
            Slice(inner): return self.contains_fallible_once(inner, visited)
            List(inner): return self.contains_fallible_once(inner, visited)
            Map(key, inner): return self.contains_fallible_once(key, visited) or self.contains_fallible_once(inner, visited)
            Set(inner): return self.contains_fallible_once(inner, visited)
            Weak(inner): return self.contains_fallible_once(inner, visited)
            Range(inner): return self.contains_fallible_once(inner, visited)
            Array(inner, count): return self.contains_fallible_once(inner, visited)
            Tuple(elements):
                for element in elements:
                    if self.contains_fallible_once(element, visited): return true
                return false
            Struct(index, arguments):
                let item = self.structs[index]
                for field in item.fields:
                    if self.contains_fallible_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            Enum(index, arguments):
                let item = self.enums[index]
                for case_value in item.cases:
                    for field in case_value.payload:
                        if self.contains_fallible_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            else: return false

    ## Whether a stored type would place the uninhabited `never` type at a
    ## value boundary. A function value returning `never` is itself ordinary
    ## storable data, but every callable parameter still has to be inhabited.
    pub func contains_never_value(value: TypeId) -> bool:
        let visited = list[bool]()
        for index in range(0, len(self.types.definitions)): visited.append(false)
        return self.contains_never_value_once(value, visited)

    func contains_never_value_once(value: TypeId, visited: list[bool]) -> bool:
        if i64(value.value) >= len(self.types.definitions): return false
        while len(visited) < len(self.types.definitions): visited.append(false)
        if visited[value.value]: return false
        visited[value.value] = true
        match self.types.definitions[value.value].form:
            Never: return true
            Optional(inner): return self.contains_never_value_once(inner, visited)
            Slice(inner): return self.contains_never_value_once(inner, visited)
            List(inner): return self.contains_never_value_once(inner, visited)
            Map(key, inner): return self.contains_never_value_once(key, visited) or self.contains_never_value_once(inner, visited)
            Set(inner): return self.contains_never_value_once(inner, visited)
            Weak(inner): return self.contains_never_value_once(inner, visited)
            Range(inner): return self.contains_never_value_once(inner, visited)
            Array(inner, count): return self.contains_never_value_once(inner, visited)
            NativePointer(inner, is_mutable): return self.contains_never_value_once(inner, visited)
            Tuple(elements):
                for element in elements:
                    if self.contains_never_value_once(element, visited): return true
                return false
            Struct(index, arguments):
                let item = self.structs[index]
                for field in item.fields:
                    if self.contains_never_value_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            Class(index, arguments):
                let item = self.classes[index]
                for field in item.fields:
                    if self.contains_never_value_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            Enum(index, arguments):
                let item = self.enums[index]
                for case_value in item.cases:
                    for field in case_value.payload:
                        if self.contains_never_value_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            # A callable descriptor is inhabited independently of whether its
            # invocation can return successfully. Its parameters remain value
            # boundaries, so substitution may not hide `never` inside them.
            Function(parameters, result):
                for parameter in parameters:
                    if self.contains_never_value_once(parameter, visited): return true
                return false
            CFunction(parameters, result):
                for parameter in parameters:
                    if self.contains_never_value_once(parameter, visited): return true
                return false
            else: return false

    ## Reject an uninhabited control type at a value-storage boundary. A
    ## callable returning `never` remains storable because the descriptor is
    ## inhabited; `contains_never_value` deliberately skips callable results.
    pub func validate_stored_type(module_index: i64, value: TypeId, span: SourceSpan, what: str) -> !:
        if self.contains_never_value(value):
            try self.fail_at(module_index, span, what + " cannot store `never`; it is permitted only as a function's complete successful result")

    # Whether a value shape directly or transitively stores a native pointer.
    # The pointer itself is the boundary: its pointee is a type description,
    # not another value stored inline.
    pub func contains_native_pointer(value: TypeId) -> bool:
        let visited = list[bool]()
        for index in range(0, len(self.types.definitions)): visited.append(false)
        return self.contains_native_pointer_once(value, visited)

    func contains_native_pointer_once(value: TypeId, visited: list[bool]) -> bool:
        if i64(value.value) >= len(self.types.definitions): return false
        while len(visited) < len(self.types.definitions): visited.append(false)
        if visited[value.value]: return false
        visited[value.value] = true
        match self.types.definitions[value.value].form:
            NativePointer(pointee, is_mutable): return true
            Optional(inner): return self.contains_native_pointer_once(inner, visited)
            Fallible(inner): return self.contains_native_pointer_once(inner, visited)
            Slice(inner): return self.contains_native_pointer_once(inner, visited)
            List(inner): return self.contains_native_pointer_once(inner, visited)
            Map(key, inner): return self.contains_native_pointer_once(key, visited) or self.contains_native_pointer_once(inner, visited)
            Set(inner): return self.contains_native_pointer_once(inner, visited)
            Weak(inner): return self.contains_native_pointer_once(inner, visited)
            Range(inner): return self.contains_native_pointer_once(inner, visited)
            Array(inner, count): return self.contains_native_pointer_once(inner, visited)
            Tuple(elements):
                for element in elements:
                    if self.contains_native_pointer_once(element, visited): return true
                return false
            Function(parameters, result):
                for parameter in parameters:
                    if self.contains_native_pointer_once(parameter, visited): return true
                return self.contains_native_pointer_once(result, visited)
            CFunction(parameters, result):
                for parameter in parameters:
                    if self.contains_native_pointer_once(parameter, visited): return true
                return self.contains_native_pointer_once(result, visited)
            Struct(index, arguments):
                let item = self.structs[index]
                for field in item.fields:
                    if self.contains_native_pointer_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            Enum(index, arguments):
                let item = self.enums[index]
                for case_value in item.cases:
                    for field in case_value.payload:
                        if self.contains_native_pointer_once(self.substitute_type(field.value_type, item.generic_id, arguments), visited): return true
                return false
            else: return false

    # Runtime globals have no source initializer. Admit exactly the value
    # shapes whose all-zero canonical storage has a well-defined HIR value;
    # native pointers use their documented inert/null zero only inside this
    # sealed state; callable tokens and foreign handles still require their
    # explicit capabilities instead of being forged as zero.
    pub func has_structural_zero(value: TypeId) -> bool:
        match self.types.definitions[value.value].form:
            Boolean: return true
            Integer(bits, is_signed): return true
            Floating(bits): return true
            Character: return true
            String: return true
            Bytes: return true
            NativePointer(pointee, is_mutable): return true
            Range(element): return self.has_structural_zero(element)
            Array(element, count): return self.has_structural_zero(element)
            Optional(inner): return self.has_structural_zero(inner)
            Tuple(elements):
                for element in elements:
                    if not self.has_structural_zero(element): return false
                return true
            else: return false

    pub func validate_function_result(module_index: i64, result: TypeId, span: SourceSpan) -> !:
        let successful = self.fallible_inner(result)
        if successful != none:
            if self.contains_fallible(successful):
                try self.fail_at(module_index, span, "fallibility cannot nest; a function result has at most one outer `!`")
            match self.types.definitions[successful.value].form:
                Never: return
                else: pass
            if self.contains_never_value(successful):
                try self.fail_at(module_index, span, "`never` may appear only as the complete successful result of a function")
        elif self.contains_fallible(result):
            try self.fail_at(module_index, span, "fallibility must be the outermost function-result effect")
        else:
            match self.types.definitions[result.value].form:
                Never: return
                else: pass
            if self.contains_never_value(result):
                try self.fail_at(module_index, span, "`never` may appear only as the complete successful result of a function")


    # Integer spelling is needed while resolving array types as well as while
    # checking expressions, so it belongs to the shared source transaction.
    pub func decode_integer_at(module_index: i64, token: Token) -> i64!:
        let value = try self.decode_negative_integer_at(module_index, token)
        if value == -9223372036854775807 - 1:
            try self.fail_at(module_index, token.span, "integer literal is outside the representable integer range")
        return -value

    # Unsigned spelling uses the same base/underscore rules but accumulates in
    # u64 so the complete 0...2^64-1 domain survives semantic decoding.
    pub func decode_unsigned_integer_at(module_index: i64, token: Token) -> u64!:
        let text_end = len(token.text) - len(token.suffix)
        var base = u64(10)
        var position = 0
        if text_end >= 2 and token.text[0] == '0':
            match token.text[1]:
                'b', 'B': base = u64(2)
                'o', 'O': base = u64(8)
                'x', 'X': base = u64(16)
                else: base = u64(10)
            if base != u64(10): position = 2

        let maximum = u64(18446744073709551615)
        var value = u64(0)
        while position < text_end:
            let c = token.text[position]
            if c != '_':
                let digit = u64(decode_digit(c))
                if value > (maximum - digit) // base:
                    try self.fail_at(module_index, token.span, "integer literal is outside the representable integer range")
                value = value * base + digit
            position += 1
        return value

    # Accumulating below zero leaves room for the minimum signed magnitude,
    # which positive i64 cannot represent.
    pub func decode_negative_integer_at(module_index: i64, token: Token) -> i64!:
        let text_end = len(token.text) - len(token.suffix)
        var base = 10
        var position = 0
        if text_end >= 2 and token.text[0] == '0':
            match token.text[1]:
                'b', 'B': base = 2
                'o', 'O': base = 8
                'x', 'X': base = 16
                else: base = 10
            if base != 10: position = 2

        var value = 0
        while position < text_end:
            let c = token.text[position]
            if c != '_':
                let digit = decode_digit(c)
                let minimum = -9223372036854775807 - 1
                let numerator = minimum + digit
                var threshold = numerator // base
                if numerator % base != 0: threshold += 1
                if value < threshold:
                    try self.fail_at(module_index, token.span, "integer literal is outside the representable integer range")
                value = value * base - digit
            position += 1
        return value

func decode_digit(c: char) -> i64:
    let code = u32(c)
    if c <= '9': return i64(code - u32('0'))
    if c <= 'F': return i64(code - u32('A')) + 10
    return i64(code - u32('a')) + 10

## The implemented built-in type-name table shared by signature collection
## and expression literal suffixes.
pub func builtin_type_id(name: str) -> TypeId?:
    return match name:
        "unit" => resolve_builtin_type(BuiltinType.unit)
        "bool" => resolve_builtin_type(BuiltinType.boolean)
        "i8" => resolve_builtin_type(BuiltinType.signed_i8)
        "i16" => resolve_builtin_type(BuiltinType.signed_i16)
        "i32" => resolve_builtin_type(BuiltinType.signed_i32)
        "i64" => resolve_builtin_type(BuiltinType.signed_i64)
        "u8" => resolve_builtin_type(BuiltinType.unsigned_u8)
        "u16" => resolve_builtin_type(BuiltinType.unsigned_u16)
        "u32" => resolve_builtin_type(BuiltinType.unsigned_u32)
        "u64" => resolve_builtin_type(BuiltinType.unsigned_u64)
        "f32" => resolve_builtin_type(BuiltinType.float32)
        "f64" => resolve_builtin_type(BuiltinType.float64)
        "f16" => resolve_builtin_type(BuiltinType.float16)
        "char" => resolve_builtin_type(BuiltinType.character)
        "str" => resolve_builtin_type(BuiltinType.string)
        "bytes" => resolve_builtin_type(BuiltinType.byte_string)
        "ErrorCode" => resolve_builtin_type(BuiltinType.error_code)
        "Error" => resolve_builtin_type(BuiltinType.error_value)
        "never" => resolve_builtin_type(BuiltinType.never_type)
        "foreign" => resolve_builtin_type(BuiltinType.foreign)
        else => none
