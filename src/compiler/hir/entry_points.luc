#==============================================================================================
#
#   entry_points - Process entry selection and source-contract validation
#
#   DESCRIPTION:
#       Selects the root package's one conventional executable entry after
#       declaration types resolve. The selected SymbolId is semantic HIR data;
#       host ABI parameters and process-environment materialization belong to
#       backends and never enter this pass.
#
#==============================================================================================

from compiler.hir.generation_model import CollectedFunctionSource, FunctionSymbol, HirGenerationState
from compiler.hir.ir import BuiltinType, PackageRole, SymbolId, TypeForm, resolve_builtin_type, types_match

# mark: Entry selection =======================================================================

## Resolve the root package's optional entry and reject every public top-level
## `main` that is not the exact §20.5 contract.
pub class EntryPointChecker:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    pub func resolve() -> SymbolId?!:
        # A sealed runtime is a separately compiled implementation package,
        # never a process. Its ordinary helper names do not define an entry.
        if self.state.package_role == PackageRole.sealed_runtime: return none
        var found: SymbolId? = none
        for generic in self.state.generic_functions:
            if generic.module_index >= len(self.state.sources): continue
            if generic.is_public and generic.signature.receiver == none and generic.name == "main":
                try self.state.fail_at(
                    generic.module_index, generic.span,
                    "process entry `main` cannot be generic; expected `pub func main(arguments: slice[str]) -> i32!`",
                )

        for function in self.state.functions:
            if function.module_index >= len(self.state.sources): continue
            if not function.is_public or function.receiver != none or function.name != "main": continue
            try self.require_exact_contract(function)
            if found != none:
                try self.state.fail_at(
                    function.module_index, function.span,
                    "package defines more than one public process entry `main`",
                )
            found = function.symbol
        return found

    func require_exact_contract(function: FunctionSymbol) -> !:
        match function.source:
            Defined(syntax):
                # Entry defaults are forbidden by the entry contract itself.
                # Inspect retained declaration syntax before the general
                # default-expression pass so an invalid default cannot mask
                # this more fundamental diagnostic.
                if len(syntax.parameters) == 1 and syntax.parameters[0].default_value != none:
                    try self.fail(function, "parameter `arguments` cannot have a default")
            ExportedC(syntax): try self.fail(function, "must be a Luce function, not an `export c` declaration")
            ExternalC(contract): try self.fail(function, "must have a Luce body, not an `extern` declaration")
            Imported: trap("root source function has imported implementation")
            Specialized: trap("non-generic process entry became a specialization")

        if len(function.parameters) != 1:
            try self.fail(function, "must declare exactly one `arguments: slice[str]` parameter")
        let parameter = function.parameters[0]
        if parameter.name != "arguments":
            try self.fail(function, "parameter must be named `arguments`")
        if not types_match(parameter.value_type, resolve_builtin_type(BuiltinType.string_slice)):
            try self.fail(function, "parameter `arguments` must have type `slice[str]`")

        match self.state.types.definitions[function.result.value].form:
            Fallible(success):
                if types_match(success, resolve_builtin_type(BuiltinType.signed_i32)): return
            else: pass
        try self.fail(function, "result must be `i32!`")

    func fail(function: FunctionSymbol, detail: str) -> !:
        try self.state.fail_at(
            function.module_index, function.span,
            "invalid process entry `main`: " + detail + "; expected `pub func main(arguments: slice[str]) -> i32!`",
        )
