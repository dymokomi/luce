#==============================================================================================
#
#   hir_gen - Source syntax into typed HIR
#
#   DESCRIPTION:
#       Turns source trees into typed HIR: resolves module and lexical names,
#       checks the implemented type rules, and decodes literal spellings. The
#       semantic analyzer and reference interpreter consume that HIR directly;
#       the lowerer turns it into canonical MIR for compiled backends.
#       Anything the current slice cannot generate yet fails with
#       "not implemented yet".
#
#       Generation runs in two passes over one `HirGenerationState`:
#       `DeclarationCollector` fixes program-wide identities, then
#       `HirBodyChecker` checks constants and function-local semantics. This
#       facade alone controls their ordering and publishes the completed HIR.
#
#==============================================================================================

from compiler.hir.body_checker import HirBodyChecker
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generation_model import HirGenerationState, RuntimeBindingRequest, SourceModule, collected_struct_is_extern
from compiler.hir.ir import HirClass, HirClassApplication, HirConstant, HirEnum, HirEnumCase, HirExternType, HirExternVariable, HirField, HirFunction, HirGenericFunction, HirGenericInstance, HirGlobal, HirInterface, HirInterfaceApplication, HirInterfaceRequirement, HirModule, HirNominalApplication, HirNominalField, HirPackage, HirParameter, HirPayloadField, HirProgram, HirStruct
from compiler.hir.ir import ModuleId, PackageId, PackageRole, SymbolId, TypeId, no_node
from compiler.runtime_contract import RuntimeService

## Generates typed HIR for one whole program. Collection is internal so
## callers cannot run a partial generation. A sealed package may first bind
## its descriptor's runtime services; `generate` then performs the one whole
## source-to-HIR transaction.
pub class HirGenerator:
    let state: HirGenerationState
    let declarations: DeclarationCollector
    let bodies: HirBodyChecker

    pub init(package_identity: str, sources: list[SourceModule], package_role: PackageRole = PackageRole.ordinary, monomorphization_budget: i64 = 256, clock: (func() -> i64)? = none):
        if monomorphization_budget <= 0: trap("monomorphization budget must be positive")
        let state = HirGenerationState(package_identity, sources, package_role, monomorphization_budget, clock)
        let declarations = DeclarationCollector(state)
        self.state = state
        self.declarations = declarations
        self.bodies = HirBodyChecker(state, declarations)

    ## Select one private function from a sealed runtime package as the exact
    ## implementation of a semantic service. Resolution and contract checks
    ## happen during generation, alongside every other source identity.
    pub func bind_runtime_service(service: RuntimeService, module_name: str, function_name: str):
        self.state.runtime_binding_requests.append(RuntimeBindingRequest(
            service = service,
            module_name = module_name,
            function_name = function_name,
        ))

    # mark: Generation ==========================================================================

    ## Generate typed HIR or stop at the first semantic problem.
    pub func generate() -> HirProgram!:
        if self.state.package_identity == "": error("package identity must not be empty")
        try self.declarations.validate_module_names()
        try self.declarations.validate_mutating_placements()
        try self.declarations.collect_declarations(self.bodies)
        try self.declarations.collect_module_bindings()
        try self.declarations.resolve_aliases()
        try self.declarations.validate_native_boundaries()
        let runtime_bindings = try self.declarations.resolve_runtime_bindings()
        try self.bodies.check_constants()
        try self.declarations.resolve_function_defaults(self.bodies)
        try self.declarations.validate_generic_applications(self.bodies)
        try self.bodies.check_generic_templates()

        let modules = list[HirModule]()
        for module_index in range(0, len(self.state.sources)):
            let source = self.state.sources[module_index]
            modules.append(HirModule(id = ModuleId(value = u32(module_index)), package = PackageId(value = 0), name = source.name, path = source.path, authority = source.authority, documentation = source.syntax.documentation))

        let hir_functions = list[HirFunction]()
        var function_index = 0
        var conformance_type_index = 0
        while function_index < len(self.state.functions) or conformance_type_index < len(self.state.types.definitions):
            while conformance_type_index < len(self.state.types.definitions):
                try self.bodies.materialize_generic_class_lifecycle_for_feature(
                    self.state.types.definitions[conformance_type_index].id,
                )
                try self.declarations.materialize_generic_conformances_for_type(
                    self.bodies,
                    self.state.types.definitions[conformance_type_index].id,
                )
                conformance_type_index += 1
            while function_index < len(self.state.functions):
                let function = self.state.functions[function_index]
                self.declarations.enter_module(function.module_index)
                let node_count = len(self.state.arena.nodes)
                let started = self.state.clock_ms()
                if function.generic_instance >= 0:
                    hir_functions.append(try self.bodies.specialize_generic_function(function))
                else:
                    hir_functions.append(try self.bodies.check_function(function))
                if function.generic_instance >= 0:
                    let instance = self.state.generic_instances[function.generic_instance]
                    self.state.generic_instances[function.generic_instance] = self.state.generic_instance_with_cost(
                        instance,
                        len(self.state.arena.nodes) - node_count,
                        self.state.elapsed_ms(started),
                    )
                function_index += 1
        for function in self.state.generated_functions:
            hir_functions.append(function)

        let hir_generic_functions = list[HirGenericFunction]()
        for generic in self.state.generic_functions:
            let body = generic.body else trap("generic body was not checked")
            if len(generic.signature.parameters) != len(body.defaults):
                trap("generic body default table does not match its signature")
            let parameters = list[HirParameter]()
            for index in range(0, len(generic.signature.parameters)):
                let parameter = generic.signature.parameters[index]
                parameters.append(HirParameter(
                    symbol = parameter.symbol,
                    name = parameter.name,
                    value_type = parameter.value_type,
                    default_value = body.defaults[index],
                ))
            hir_generic_functions.append(HirGenericFunction(
                symbol = generic.signature.symbol,
                module = ModuleId(value = u32(generic.module_index)),
                name = generic.name,
                is_public = generic.is_public,
                documentation = generic.documentation,
                receiver = generic.signature.receiver,
                generic_id = generic.generic_id,
                owner_parameter_count = generic.owner_parameter_count,
                type_parameters = generic.type_parameters,
                parameters = parameters,
                result = generic.signature.result,
                body = body,
                span = generic.span,
            ))

        let hir_generic_instances = list[HirGenericInstance]()
        for instance in self.state.generic_instances:
            var parent: u32? = none
            if instance.parent >= 0: parent = u32(instance.parent)
            hir_generic_instances.append(HirGenericInstance(
                generic = u32(instance.generic_index),
                function = self.state.functions[instance.function_index].symbol,
                arguments = instance.arguments,
                origin_module = ModuleId(value = u32(instance.origin_module)),
                origin_span = instance.origin_span,
                parent = parent,
                checked_nodes = u32(instance.checked_nodes),
                check_time_ms = instance.check_time_ms,
            ))

        let hir_constants = list[HirConstant]()
        for constant in self.state.constants:
            if constant.typed.value == no_node: trap("constant was not typed")
            hir_constants.append(HirConstant(
                symbol = constant.symbol,
                module = ModuleId(value = u32(constant.module_index)),
                name = constant.name,
                is_public = constant.is_public,
                value = constant.typed,
            ))

        let hir_structs = list[HirStruct]()
        for item in self.state.structs:
            var initializer: SymbolId? = none
            if item.initializer != none:
                let collected_initializer = item.initializer else trap("struct initializer disappeared")
                match collected_initializer:
                    Concrete(index): initializer = self.state.functions[index].symbol
                    Generic(index): initializer = self.state.generic_functions[index].signature.symbol
            hir_structs.append(HirStruct(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                generic_id = item.generic_id,
                type_parameters = item.type_parameters,
                is_extern = collected_struct_is_extern(item),
                fields = item.fields,
                initializer = initializer,
                span = item.span,
            ))

        let hir_enums = list[HirEnum]()
        for item in self.state.enums:
            hir_enums.append(HirEnum(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                generic_id = item.generic_id,
                type_parameters = item.type_parameters,
                cases = item.cases,
                span = item.span,
            ))

        let hir_classes = list[HirClass]()
        for item in self.state.classes:
            let collected_initializer = item.initializer else trap("class has no initializer after declaration collection")
            var initializer = SymbolId(value = 0)
            var deinitializer: SymbolId? = none
            match collected_initializer:
                Concrete(index): initializer = self.state.functions[index].symbol
                Generic(index): initializer = self.state.generic_functions[index].signature.symbol
            if item.deinitializer != none:
                let collected_deinitializer = item.deinitializer else trap("class deinitializer disappeared")
                match collected_deinitializer:
                    Concrete(index): deinitializer = self.state.functions[index].symbol
                    Generic(index): deinitializer = self.state.generic_functions[index].signature.symbol
            hir_classes.append(HirClass(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                generic_id = item.generic_id,
                type_parameters = item.type_parameters,
                fields = item.fields,
                initializer = initializer,
                deinitializer = deinitializer,
                span = item.span,
            ))

        let hir_interfaces = list[HirInterface]()
        for item in self.state.interfaces:
            hir_interfaces.append(HirInterface(
                origin = item.origin,
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                generic_id = item.generic_id,
                type_parameters = item.type_parameters,
                requirements = item.requirements,
                span = item.span,
            ))

        # Publish applied interface and nominal schemas in one dynamic walk of
        # the canonical type table. Substitution of either schema may intern a
        # nested application of the other kind; growing the loop bound reaches
        # one shared fixed point without a phase-order dependency.
        let hir_interface_applications = list[HirInterfaceApplication]()
        let hir_nominal_applications = list[HirNominalApplication?]()
        var type_index = 0
        while type_index < len(self.state.types.definitions):
            let definition = self.state.types.definitions[type_index]
            var nominal_application: HirNominalApplication? = none
            match definition.form:
                Interface(interface_index, arguments):
                    hir_interface_applications.append(self.materialize_interface_application(definition.id, interface_index, arguments))
                Struct(declaration, arguments):
                    let item = self.state.structs[declaration]
                    nominal_application = HirNominalApplication.StructApplication(fields = self.materialize_fields(item.fields, item.generic_id, arguments))
                Class(declaration, arguments):
                    let item = self.state.classes[declaration]
                    var deinitializer: SymbolId? = none
                    if item.deinitializer != none:
                        let collected_deinitializer = item.deinitializer else trap("class deinitializer disappeared")
                        match collected_deinitializer:
                            Concrete(index): deinitializer = self.state.functions[index].symbol
                            Generic(index):
                                if not self.state.contains_type_parameter(definition.id):
                                    let specialized = self.state.find_generic_instance(index, arguments)
                                    if specialized < 0: trap("concrete generic class has no specialized deinitializer")
                                    deinitializer = self.state.functions[specialized].symbol
                    nominal_application = HirNominalApplication.ClassApplication(application = HirClassApplication(
                        fields = self.materialize_fields(item.fields, item.generic_id, arguments),
                        deinitializer = deinitializer,
                    ))
                Enum(declaration, arguments):
                    let item = self.state.enums[declaration]
                    let cases = list[HirEnumCase]()
                    for case_value in item.cases:
                        let payload = list[HirPayloadField]()
                        for field in case_value.payload:
                            payload.append(HirPayloadField(
                                name = field.name,
                                value_type = self.state.substitute_type(field.value_type, item.generic_id, arguments),
                            ))
                        cases.append(HirEnumCase(name = case_value.name, documentation = case_value.documentation, payload = payload))
                    nominal_application = HirNominalApplication.EnumApplication(cases = cases)
                else: pass
            hir_nominal_applications.append(nominal_application)
            type_index += 1

        if len(hir_nominal_applications) != len(self.state.types.definitions):
            trap("nominal application table is not aligned with canonical HIR types")

        let hir_extern_types = list[HirExternType]()
        for item in self.state.extern_types:
            hir_extern_types.append(HirExternType(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                representation = item.representation,
                span = item.span,
            ))

        let hir_extern_variables = list[HirExternVariable]()
        for item in self.state.extern_variables:
            hir_extern_variables.append(HirExternVariable(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                value_type = item.value_type,
                span = item.span,
            ))

        let hir_globals = list[HirGlobal]()
        for item in self.state.globals:
            hir_globals.append(HirGlobal(
                symbol = item.symbol,
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                value_type = item.value_type,
                span = item.span,
            ))

        return HirProgram(
            packages = [HirPackage(id = PackageId(value = 0), identity = self.state.package_identity, role = self.state.package_role)],
            root_package = PackageId(value = 0),
            runtime_bindings = runtime_bindings,
            types = self.state.types,
            symbols = self.state.symbols,
            modules = modules,
            constants = hir_constants,
            structs = hir_structs,
            classes = hir_classes,
            enums = hir_enums,
            nominal_applications = hir_nominal_applications,
            interfaces = hir_interfaces,
            interface_applications = hir_interface_applications,
            conformances = self.state.conformances,
            extern_types = hir_extern_types,
            extern_variables = hir_extern_variables,
            globals = hir_globals,
            closures = self.state.closures,
            shared_cells = self.state.shared_cells,
            generic_functions = hir_generic_functions,
            generic_instances = hir_generic_instances,
            generic_specialization_budget = self.state.monomorphization_budget,
            functions = hir_functions,
            nodes = self.state.program_arena.nodes,
            node_types = self.state.program_arena.node_types,
            node_modules = self.state.program_arena.node_modules,
            node_spans = self.state.program_arena.node_spans,
            extra = self.state.program_arena.extra,
            values = self.state.program_arena.values,
        )

    func materialize_fields(fields: list[HirField], generic_id: u32, arguments: list[TypeId]) -> list[HirNominalField]:
        let materialized = list[HirNominalField]()
        for field in fields:
            materialized.append(HirNominalField(
                name = field.name,
                value_type = self.state.substitute_type(field.value_type, generic_id, arguments),
                is_mutable = field.is_mutable,
                is_weak = field.is_weak,
                is_public = field.is_public,
                documentation = field.documentation,
            ))
        return materialized

    func materialize_interface_application(value_type: TypeId, interface_index: i64, arguments: list[TypeId]) -> HirInterfaceApplication:
        let contract = self.state.interfaces[interface_index]
        let requirements = list[HirInterfaceRequirement]()
        for requirement in contract.requirements:
            let parameters = list[HirParameter]()
            for parameter in requirement.parameters:
                parameters.append(HirParameter(
                    symbol = parameter.symbol,
                    name = parameter.name,
                    value_type = self.state.substitute_type(parameter.value_type, contract.generic_id, arguments),
                    default_value = parameter.default_value,
                ))
            requirements.append(HirInterfaceRequirement(
                symbol = requirement.symbol,
                name = requirement.name,
                is_mutating = requirement.is_mutating,
                documentation = requirement.documentation,
                parameters = parameters,
                result = self.state.substitute_type(requirement.result, contract.generic_id, arguments),
                span = requirement.span,
            ))
        return HirInterfaceApplication(value_type = value_type, declaration = u32(interface_index), requirements = requirements)
