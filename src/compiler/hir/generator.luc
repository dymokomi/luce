#==============================================================================================
#
#   hir_gen - Source syntax into typed HIR
#
#   DESCRIPTION:
#       Turns source trees into typed HIR: resolves module and lexical names,
#       checks the implemented type rules, and decodes literal spellings. The
#       semantic analyzer and reference interpreter consume that HIR directly;
#       the lowerer turns it into canonical MIR for compiled backends.
#       Anything the current slice cannot generate yet fails with
#       "not implemented yet".
#
#       Generation runs in two passes over one `HirGenerationState`:
#       `DeclarationCollector` fixes program-wide identities, then
#       `HirBodyChecker` checks constants and function-local semantics. This
#       facade alone controls their ordering and publishes the completed HIR.
#
#==============================================================================================

from compiler.hir.body_checker import HirBodyChecker
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generation_model import HirGenerationState, RuntimeBindingRequest, SourceModule
from compiler.hir.ir import HirClass, HirConstant, HirEnum, HirExternType, HirExternVariable, HirFunction, HirGlobal, HirModule, HirProgram, HirStruct
from compiler.hir.ir import ModuleId, PackageRole, SymbolId, no_node
from compiler.runtime_contract import RuntimeService

## Generates typed HIR for one whole program. Collection is internal so
## callers cannot run a partial generation. A sealed package may first bind
## its descriptor's runtime services; `generate` then performs the one whole
## source-to-HIR transaction.
pub class HirGenerator:
    let state: HirGenerationState
    let declarations: DeclarationCollector
    let bodies: HirBodyChecker

    pub init(package_identity: str, sources: list[SourceModule], package_role: PackageRole = PackageRole.application):
        let state = HirGenerationState(package_identity, sources, package_role)
        let declarations = DeclarationCollector(state)
        self.state = state
        self.declarations = declarations
        self.bodies = HirBodyChecker(state, declarations)

    ## Select one private function from a sealed runtime package as the exact
    ## implementation of a semantic service. Resolution and contract checks
    ## happen during generation, alongside every other source identity.
    pub func bind_runtime_service(service: RuntimeService, module_name: str, function_name: str):
        self.state.runtime_binding_requests.append(RuntimeBindingRequest(
            service = service,
            module_name = module_name,
            function_name = function_name,
        ))

    # mark: Generation ==========================================================================

    ## Generate typed HIR or stop at the first semantic problem.
    pub func generate() -> HirProgram!:
        if self.state.package_identity == "": error("package identity must not be empty")
        try self.declarations.validate_module_names()
        try self.declarations.validate_mutating_placements()
        try self.declarations.collect_declarations(self.bodies)
        try self.declarations.collect_module_bindings()
        try self.declarations.resolve_aliases()
        try self.declarations.validate_native_boundaries()
        let runtime_bindings = try self.declarations.resolve_runtime_bindings()
        try self.bodies.check_constants()

        let modules = list[HirModule]()
        for module_index in range(0, len(self.state.sources)):
            let source = self.state.sources[module_index]
            modules.append(HirModule(id = ModuleId(value = u32(module_index)), name = source.name, path = source.path, authority = source.authority, documentation = source.syntax.documentation))

        let hir_functions = list[HirFunction]()
        for module_index in range(0, len(self.state.sources)):
            self.declarations.enter_module(module_index)
            for function in self.state.functions:
                if function.module_index == module_index:
                    hir_functions.append(try self.bodies.check_function(function))
        for function in self.state.generated_functions:
            hir_functions.append(function)

        let hir_constants = list[HirConstant]()
        for constant in self.state.constants:
            if constant.typed.value == no_node: trap("constant was not typed")
            hir_constants.append(HirConstant(
                symbol = constant.symbol,
                module = ModuleId(value = u32(constant.module_index)),
                name = constant.name,
                is_public = constant.is_public,
                value = constant.typed,
            ))

        let hir_structs = list[HirStruct]()
        for item in self.state.structs:
            var initializer: SymbolId? = none
            if item.initializer >= 0: initializer = self.state.functions[item.initializer].symbol
            hir_structs.append(HirStruct(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                fields = item.fields,
                initializer = initializer,
                span = item.span,
            ))

        let hir_enums = list[HirEnum]()
        for item in self.state.enums:
            hir_enums.append(HirEnum(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                cases = item.cases,
                span = item.span,
            ))

        let hir_classes = list[HirClass]()
        for item in self.state.classes:
            if item.initializer < 0: trap("class has no initializer after declaration collection")
            var deinitializer: SymbolId? = none
            if item.deinitializer >= 0: deinitializer = self.state.functions[item.deinitializer].symbol
            hir_classes.append(HirClass(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                fields = item.fields,
                initializer = self.state.functions[item.initializer].symbol,
                deinitializer = deinitializer,
                span = item.span,
            ))

        let hir_extern_types = list[HirExternType]()
        for item in self.state.extern_types:
            hir_extern_types.append(HirExternType(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                representation = item.representation,
                span = item.span,
            ))

        let hir_extern_variables = list[HirExternVariable]()
        for item in self.state.extern_variables:
            hir_extern_variables.append(HirExternVariable(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                value_type = item.value_type,
                span = item.span,
            ))

        let hir_globals = list[HirGlobal]()
        for item in self.state.globals:
            hir_globals.append(HirGlobal(
                symbol = item.symbol,
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                value_type = item.value_type,
                span = item.span,
            ))

        return HirProgram(
            package_identity = self.state.package_identity,
            package_role = self.state.package_role,
            runtime_bindings = runtime_bindings,
            types = self.state.types,
            symbols = self.state.symbols,
            modules = modules,
            constants = hir_constants,
            structs = hir_structs,
            classes = hir_classes,
            enums = hir_enums,
            extern_types = hir_extern_types,
            extern_variables = hir_extern_variables,
            globals = hir_globals,
            closures = self.state.closures,
            shared_cells = self.state.shared_cells,
            functions = hir_functions,
            nodes = self.state.nodes,
            node_types = self.state.node_types,
            node_spans = self.state.node_spans,
            extra = self.state.extra,
            values = self.state.values,
        )
