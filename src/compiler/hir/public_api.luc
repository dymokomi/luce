#==============================================================================================
#
#   public_api - Public source API visibility validation
#
#   DESCRIPTION:
#       Walks every type reachable from a public declaration and rejects a
#       private nominal identity at the exact declaration boundary that would
#       expose it. This is a source API rule; it has no backend or layout role.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.generation_model import HirGenerationState
from compiler.hir.ir import HirInterfaceOrigin, HirTypeParameter, TypeForm, TypeId

# mark: Public API validation =================================================================

## Validates the root package's externally visible semantic surface after all
## declaration signatures and aliases have resolved.
pub class PublicApiChecker:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    pub func validate() -> !:
        try self.validate_functions()
        try self.validate_aliases_and_constants()
        try self.validate_nominals()
        try self.validate_interfaces()
        try self.validate_external_variables()

    # mark: Declaration surfaces ================================================================

    func validate_functions() -> !:
        for function in self.state.functions:
            if not function.is_public or not self.is_root_module(function.module_index): continue
            if function.receiver != none:
                let receiver = function.receiver else trap("function receiver disappeared")
                if self.first_private_type(receiver.owner) != none: continue
            let api = "public function `" + function.name + "`"
            if function.receiver != none:
                let receiver = function.receiver else trap("function receiver disappeared")
                try self.require_public_type(function.module_index, function.span, api, "receiver", receiver.owner)
            for parameter in function.parameters:
                try self.require_public_type(
                    function.module_index, function.span, api,
                    "parameter `" + parameter.name + "`", parameter.value_type,
                )
            try self.require_public_type(function.module_index, function.span, api, "result", function.result)

        for generic in self.state.generic_functions:
            if not generic.is_public or not self.is_root_module(generic.module_index): continue
            if generic.signature.receiver != none:
                let receiver = generic.signature.receiver else trap("generic function receiver disappeared")
                if self.first_private_type(receiver.owner) != none: continue
            let api = "public function `" + generic.name + "`"
            if generic.signature.receiver != none:
                let receiver = generic.signature.receiver else trap("generic function receiver disappeared")
                try self.require_public_type(generic.module_index, generic.span, api, "receiver", receiver.owner)
            for parameter in generic.signature.parameters:
                try self.require_public_type(
                    generic.module_index, generic.span, api,
                    "parameter `" + parameter.name + "`", parameter.value_type,
                )
            try self.require_public_type(
                generic.module_index, generic.span, api, "result", generic.signature.result,
            )
            try self.validate_type_parameters(generic.module_index, generic.span, api, generic.type_parameters)

    func validate_aliases_and_constants() -> !:
        for item in self.state.aliases:
            if not item.is_public or not self.is_root_module(item.module_index): continue
            let value_type = item.resolved else trap("public alias was not resolved")
            try self.require_public_type(
                item.module_index, item.span, "public type alias `" + item.name + "`", "aliased type", value_type,
            )
        for constant in self.state.constants:
            if not constant.is_public or not self.is_root_module(constant.module_index): continue
            try self.require_public_type(
                constant.module_index, constant.span, "public constant `" + constant.name + "`", "declared type",
                self.state.symbols[constant.symbol.value].value_type,
            )

    func validate_nominals() -> !:
        for item in self.state.structs:
            if not item.is_public or not self.is_root_module(item.module_index): continue
            let api = "public struct `" + item.name + "`"
            try self.validate_type_parameters(item.module_index, item.span, api, item.type_parameters)
            for field in item.fields:
                if field.is_public:
                    try self.require_public_type(
                        item.module_index, item.span, api, "field `" + field.name + "`", field.value_type,
                    )
        for item in self.state.classes:
            if not item.is_public or not self.is_root_module(item.module_index): continue
            let api = "public class `" + item.name + "`"
            try self.validate_type_parameters(item.module_index, item.span, api, item.type_parameters)
            for field in item.fields:
                if field.is_public:
                    try self.require_public_type(
                        item.module_index, item.span, api, "field `" + field.name + "`", field.value_type,
                    )
        for item in self.state.enums:
            if not item.is_public or not self.is_root_module(item.module_index): continue
            let api = "public enum `" + item.name + "`"
            try self.validate_type_parameters(item.module_index, item.span, api, item.type_parameters)
            for case_value in item.cases:
                for field in case_value.payload:
                    try self.require_public_type(
                        item.module_index, item.span, api,
                        "case `" + case_value.name + "` payload `" + field.name + "`", field.value_type,
                    )

    func validate_interfaces() -> !:
        for item in self.state.interfaces:
            var module_index = -1
            match item.origin:
                Source(module): module_index = i64(module.value)
                Standard(identity): continue
            if not item.is_public or not self.is_root_module(module_index): continue
            let api = "public interface `" + item.name + "`"
            try self.validate_type_parameters(module_index, item.span, api, item.type_parameters)
            for requirement in item.requirements:
                for parameter in requirement.parameters:
                    try self.require_public_type(
                        module_index, requirement.span, api,
                        "requirement `" + requirement.name + "` parameter `" + parameter.name + "`",
                        parameter.value_type,
                    )
                try self.require_public_type(
                    module_index, requirement.span, api,
                    "requirement `" + requirement.name + "` result", requirement.result,
                )

    func validate_external_variables() -> !:
        for item in self.state.extern_variables:
            if not item.is_public or not self.is_root_module(item.module_index): continue
            try self.require_public_type(
                item.module_index, item.span, "public extern variable `" + item.name + "`", "declared type", item.value_type,
            )

    func validate_type_parameters(module_index: i64, span: SourceSpan, api: str, parameters: list[HirTypeParameter]) -> !:
        for parameter in parameters:
            for constraint in parameter.constraints:
                try self.require_public_type(
                    module_index, span, api,
                    "type parameter `" + parameter.name + "` constraint", constraint,
                )

    # mark: Recursive type visibility ===========================================================

    func require_public_type(module_index: i64, span: SourceSpan, api: str, route: str, value_type: TypeId) -> !:
        let private_name = self.first_private_type(value_type)
        if private_name != none:
            try self.state.fail_at(
                module_index, span,
                api + " exposes private type `" + private_name + "` through " + route,
            )

    func first_private_type(value_type: TypeId) -> str?:
        match self.state.types.definitions[value_type.value].form:
            Slice(element): return self.first_private_type(element)
            MutableSlice(element): return self.first_private_type(element)
            List(element): return self.first_private_type(element)
            Set(element): return self.first_private_type(element)
            FrozenList(element): return self.first_private_type(element)
            FrozenSet(element): return self.first_private_type(element)
            Task(element): return self.first_private_type(element)
            Weak(element): return self.first_private_type(element)
            Range(element): return self.first_private_type(element)
            Array(element, count): return self.first_private_type(element)
            Optional(element): return self.first_private_type(element)
            Fallible(element): return self.first_private_type(element)
            NativePointer(element, is_mutable): return self.first_private_type(element)
            Map(key, value):
                let private_key = self.first_private_type(key)
                if private_key != none: return private_key
                return self.first_private_type(value)
            FrozenMap(key, value):
                let private_key = self.first_private_type(key)
                if private_key != none: return private_key
                return self.first_private_type(value)
            Tuple(elements): return self.first_private_type_in(elements)
            Function(parameters, result):
                let private_parameter = self.first_private_type_in(parameters)
                if private_parameter != none: return private_parameter
                return self.first_private_type(result)
            CFunction(parameters, result):
                let private_parameter = self.first_private_type_in(parameters)
                if private_parameter != none: return private_parameter
                return self.first_private_type(result)
            Interface(index, arguments):
                if not self.state.interfaces[index].is_public: return self.state.interfaces[index].name
                return self.first_private_type_in(arguments)
            Struct(index, arguments):
                if not self.state.structs[index].is_public: return self.state.structs[index].name
                return self.first_private_type_in(arguments)
            Class(index, arguments):
                if not self.state.classes[index].is_public: return self.state.classes[index].name
                return self.first_private_type_in(arguments)
            Enum(index, arguments):
                if not self.state.enums[index].is_public: return self.state.enums[index].name
                return self.first_private_type_in(arguments)
            Extern(index):
                if not self.state.extern_types[index].is_public: return self.state.extern_types[index].name
                return none
            else: return none

    func first_private_type_in(value_types: list[TypeId]) -> str?:
        for value_type in value_types:
            let private_name = self.first_private_type(value_type)
            if private_name != none: return private_name
        return none

    func is_root_module(module_index: i64) -> bool:
        return module_index >= 0 and module_index < len(self.state.sources)
