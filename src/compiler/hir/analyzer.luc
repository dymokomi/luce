#==============================================================================================
#
#   semantic_analyzer - Whole-program rules over typed HIR
#
#   DESCRIPTION:
#       The semantic middle end between type checking and execution/lowering.
#       HirGenerator resolves local facts; this stage proves facts that need
#       control-flow joins. Initializer safety is the first such proof:
#       successful paths initialize every field exactly once, while partial
#       `self` cannot be read or escape.
#
#==============================================================================================

from compiler.hir.ir import BinaryOperation, BuiltinType, HirCaptureKind, HirFunction, HirProgram, HirReceiverKind
from compiler.hir.ir import NodeId, Operands, SymbolId, TypeId, describe_type, entry_at, function_body, no_node, node_at, node_form, node_module, node_span, node_type, nominal_fields, resolve_builtin_type, types_match
from compiler.hir.ir import place_class_field_step, place_element_step, place_field_step, place_list_element_step, place_weak_field_step
from compiler.frontend.source import Diagnostic, DiagnosticLabel, DiagnosticSeverity, SourceSpan, format_diagnostic

## Typed HIR that has crossed whole-program semantic analysis.
pub struct AnalyzedProgram:
    pub let hir: HirProgram
    ## Structured non-fatal reports produced from target-independent facts.
    pub let diagnostics: list[Diagnostic]
    ## Functions whose first parameter may receive a class identity after its
    ## strong count reaches zero. Whole-program analysis proves that the exact
    ## receiver never escapes through any transitive same-class method call.
    pub let borrowed_receiver_methods: list[SymbolId]

# The three-point lattice needed at a branch join. `maybe_initialized` means
# some continuing paths wrote the field and others did not; neither another
# write nor successful completion is safe from that state.
enum FieldState:
    uninitialized
    initialized
    maybe_initialized

class InitializationState:
    pub let fields: list[FieldState]

    pub init(count: i64):
        self.fields = list[FieldState]()
        for index in range(0, count): self.fields.append(FieldState.uninitialized)

# A statement can reach the following statement normally, recover from the
# nearest catch handler, or leave the initializer entirely. Returns and
# failures need no stored state after their own safety checks.
struct InitializationFlow:
    pub let normal: InitializationState?
    pub let recovered: InitializationState?

## Applies whole-program semantic rules and marks the result as analyzed.
pub class SemanticAnalyzer:
    let program: HirProgram
    var function: HirFunction?
    var self_symbol: SymbolId
    var field_names: list[str]
    let borrowed_receiver_methods: list[SymbolId]
    let active_borrowed_receiver_methods: list[SymbolId]
    let diagnostics: list[Diagnostic]

    pub init(program: HirProgram):
        self.program = program
        self.function = none
        self.self_symbol = SymbolId(value = no_node)
        self.field_names = list[str]()
        self.borrowed_receiver_methods = list[SymbolId]()
        self.active_borrowed_receiver_methods = list[SymbolId]()
        self.diagnostics = list[Diagnostic]()

    # mark: Analysis ===========================================================================

    pub func analyze() -> AnalyzedProgram!:
        for function in self.program.functions:
            let receiver = function.receiver
            if receiver == none: continue
            if receiver.kind == HirReceiverKind.initializer:
                try self.analyze_initializer(function, receiver.owner)
            elif receiver.kind == HirReceiverKind.deinitializer:
                try self.analyze_deinitializer(function)
        self.diagnose_discarded_results()
        self.diagnose_shared_cells()
        return AnalyzedProgram(hir = self.program, diagnostics = self.diagnostics, borrowed_receiver_methods = self.borrowed_receiver_methods)

    # mark: Advisories ========================================================================

    # Expression statements intentionally preserve evaluation and ownership
    # cleanup, but silently losing a value is usually a bug. The flat HIR
    # arena already contains every statement exactly once, so this advisory is
    # one linear pass rather than another recursive source or HIR traversal.
    func diagnose_discarded_results():
        let unit_type = resolve_builtin_type(BuiltinType.unit)
        for index in range(0, len(self.program.nodes)):
            match self.program.nodes[index].form:
                ExpressionStatement(value):
                    let result = node_type(self.program, value)
                    if types_match(result, unit_type): continue
                    match self.program.types.definitions[result.value].form:
                        Never: continue
                        else: pass
                    let statement = NodeId(value = u32(index))
                    let module = node_module(self.program, statement)
                    self.diagnostics.append(Diagnostic(
                        severity = DiagnosticSeverity.warning,
                        code = "L0701",
                        message = "result of this expression is discarded",
                        primary = DiagnosticLabel(
                            path = self.program.modules[module.value].path,
                            span = node_span(self.program, statement),
                            message = "this expression produces `" + describe_type(self.program.types, result) + "`",
                        ),
                        secondary = list[DiagnosticLabel](),
                        help = "write `discard(...)` when ignoring the result is intentional",
                    ))
                else: pass

    # A nested closure can capture a shared-cell alias owned by its parent.
    # Chase that provenance to the source binding and report the allocation
    # consequence once, at the first capture that caused the promotion.
    func diagnose_shared_cells():
        let reported = list[SymbolId]()
        for closure in self.program.closures:
            for capture in closure.captures:
                if capture.kind != HirCaptureKind.shared_cell: continue
                let source = capture.source else trap("shared-cell capture lost its source binding")
                let root = self.shared_cell_root(source)
                if self.contains_symbol(reported, root): continue
                reported.append(root)
                let name = self.program.symbols[root.value].name
                let function = self.function_with_symbol(closure.function)
                let path = self.program.modules[function.module.value].path
                self.diagnostics.append(Diagnostic(
                    severity = DiagnosticSeverity.warning,
                    code = "L1401",
                    message = "mutable binding `" + name + "` is shared with this closure",
                    primary = DiagnosticLabel(
                        path = path,
                        span = capture.span,
                        message = "this capture promotes `" + name + "` to an ARC-managed shared cell, which may allocate",
                    ),
                    secondary = list[DiagnosticLabel](),
                    help = "use `copy " + name + " = " + name + "` when the closure should capture a value snapshot",
                ))

    func shared_cell_root(symbol: SymbolId) -> SymbolId:
        for closure in self.program.closures:
            for capture in closure.captures:
                if capture.symbol.value != symbol.value or capture.kind != HirCaptureKind.shared_cell: continue
                let source = capture.source
                if source == none: return symbol
                return self.shared_cell_root(source)
        return symbol

    func contains_symbol(symbols: list[SymbolId], sought: SymbolId) -> bool:
        for symbol in symbols:
            if symbol.value == sought.value: return true
        return false

    func analyze_initializer(function: HirFunction, owner: TypeId) -> !:
        self.function = function
        self.self_symbol = function.parameters[0].symbol
        self.field_names = list[str]()
        match self.program.types.definitions[owner.value].form:
            Struct(index, arguments):
                for field in nominal_fields(self.program, owner): self.field_names.append(field.name)
            Class(index, arguments):
                for field in nominal_fields(self.program, owner): self.field_names.append(field.name)
            else: trap("initializer receiver is not a struct or class")

        let initial = InitializationState(len(self.field_names))
        let flow = try self.analyze_suite(function_body(function), initial, false, false)
        let completion = flow.normal
        if completion != none: try self.require_complete(completion, function.span)
        self.function = none

    # Analyze a sequence. Normal exits feed the next statement; recover exits
    # bypass the remainder and are accumulated for the enclosing catch.
    func analyze_suite(statements: Operands, initial: InitializationState, may_repeat: bool, recover_allowed: bool) -> InitializationFlow!:
        var normal: InitializationState? = initial
        var recovered: InitializationState? = none
        for position in range(0, i64(statements.count)):
            if normal == none: break
            let statement = node_at(self.program, statements, position)
            let flow = try self.analyze_statement(statement, normal, may_repeat, recover_allowed)
            recovered = self.join_optional(recovered, flow.recovered)
            normal = flow.normal
        return InitializationFlow(normal = normal, recovered = recovered)

    func analyze_statement(statement: NodeId, state: InitializationState, may_repeat: bool, recover_allowed: bool) -> InitializationFlow!:
        let continuing = InitializationFlow(normal = state, recovered = none)
        match node_form(self.program, statement):
            BreakStatement: return InitializationFlow(normal = none, recovered = none)
            ContinueStatement: return InitializationFlow(normal = none, recovered = none)
            Binding(symbol, is_mutable, value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            Assignment(symbol, operation, value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            GlobalStore(global, operation, value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            ExternStore(variable, operation, value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            PlaceAssignment(symbol, steps, operation, value):
                if not try self.analyze_place_indices(steps, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                if symbol.value != self.self_symbol.value: return continuing
                let first_step = u32(entry_at(self.program, steps, 0))
                if steps.count != 2 or (first_step != place_field_step and first_step != place_class_field_step and first_step != place_weak_field_step):
                    try self.fail(statement, "an initializer assigns stored fields directly through `self`")
                let field = entry_at(self.program, steps, 1)
                if may_repeat:
                    try self.fail(statement, "field `" + self.field_names[field] + "` cannot be initialized inside a loop")
                match operation:
                    Replace: pass
                    Combine(binary): try self.fail(statement, "initialization uses `=`, not a compound assignment")
                if state.fields[field] != FieldState.uninitialized:
                    try self.fail(statement, "field `" + self.field_names[field] + "` may be initialized only once")
                state.fields[field] = FieldState.initialized
                return continuing
            GlobalPlaceAssignment(global, steps, operation, value):
                if not try self.analyze_place_indices(steps, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            PrintValue(value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            ReturnStatement(value):
                if value.value != no_node and not try self.analyze_expression(value, state, may_repeat):
                    return InitializationFlow(normal = none, recovered = none)
                try self.require_complete(state, node_span(self.program, statement))
                return InitializationFlow(normal = none, recovered = none)
            RecoverStatement(value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                if not recover_allowed: try self.fail(statement, "`recover` escaped its catch analysis")
                return InitializationFlow(normal = none, recovered = state)
            DeferStatement(action):
                discard(try self.analyze_expression_or_statement(action, state, may_repeat))
                return continuing
            ExpressionStatement(value):
                if not try self.analyze_expression(value, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return continuing
            IfStatement(branches, has_fallback, fallback):
                var joined_normal: InitializationState? = none
                var joined_recovered: InitializationState? = none
                var next_condition = self.copy_state(state)
                var conditions_continue = true
                for branch in range(0, i64(branches.count) // 3):
                    let condition = NodeId(value = u32(entry_at(self.program, branches, branch * 3)))
                    if not try self.analyze_expression(condition, next_condition, may_repeat):
                        conditions_continue = false
                        break
                    let branch_state = self.copy_state(next_condition)
                    let body = Operands(start = u32(entry_at(self.program, branches, branch * 3 + 1)), count = u32(entry_at(self.program, branches, branch * 3 + 2)))
                    let flow = try self.analyze_suite(body, branch_state, may_repeat, recover_allowed)
                    joined_normal = self.join_optional(joined_normal, flow.normal)
                    joined_recovered = self.join_optional(joined_recovered, flow.recovered)
                if conditions_continue:
                    if has_fallback:
                        let flow = try self.analyze_suite(fallback, self.copy_state(next_condition), may_repeat, recover_allowed)
                        joined_normal = self.join_optional(joined_normal, flow.normal)
                        joined_recovered = self.join_optional(joined_recovered, flow.recovered)
                    else:
                        joined_normal = self.join_optional(joined_normal, next_condition)
                return InitializationFlow(normal = joined_normal, recovered = joined_recovered)
            WhileStatement(condition, body):
                # The condition is part of the repeatable region too.
                if not try self.analyze_expression(condition, state, true):
                    return InitializationFlow(normal = none, recovered = none)
                let flow = try self.analyze_suite(body, self.copy_state(state), true, recover_allowed)
                return InitializationFlow(normal = state, recovered = flow.recovered)
            ForStatement(symbol, iteration, body):
                match iteration:
                    Builtin(iterable):
                        if not try self.analyze_expression(iterable, state, may_repeat):
                            return InitializationFlow(normal = none, recovered = none)
                    Protocol(iterator_symbol, iterator, next):
                        if not try self.analyze_expression(iterator, state, may_repeat):
                            return InitializationFlow(normal = none, recovered = none)
                        discard(try self.analyze_expression(next, state, true))
                let flow = try self.analyze_suite(body, self.copy_state(state), true, recover_allowed)
                return InitializationFlow(normal = state, recovered = flow.recovered)
            Match(subject, arms, has_result):
                if not try self.analyze_expression(subject, state, may_repeat): return InitializationFlow(normal = none, recovered = none)
                return try self.analyze_statement_match(arms, state, may_repeat, recover_allowed)
            else: return continuing

    # Assignment resolves index expressions from outermost to innermost before
    # evaluating its right-hand side, for both fixed arrays and reference lists.
    func analyze_place_indices(steps: Operands, state: InitializationState, may_repeat: bool) -> bool!:
        for position in range(0, i64(steps.count) // 2):
            let kind = u32(entry_at(self.program, steps, position * 2))
            if kind == place_element_step or kind == place_list_element_step:
                let index = NodeId(value = u32(entry_at(self.program, steps, position * 2 + 1)))
                if not try self.analyze_expression(index, state, may_repeat): return false
        return true

    func analyze_statement_match(arms: Operands, state: InitializationState, may_repeat: bool, recover_allowed: bool) -> InitializationFlow!:
        var normal: InitializationState? = none
        var recovered: InitializationState? = none
        for position in range(0, i64(arms.count)):
            match node_form(self.program, node_at(self.program, arms, position)):
                MatchArm(patterns, statements, value):
                    let flow = try self.analyze_suite(statements, self.copy_state(state), may_repeat, recover_allowed)
                    normal = self.join_optional(normal, flow.normal)
                    recovered = self.join_optional(recovered, flow.recovered)
                else: pass
        return InitializationFlow(normal = normal, recovered = recovered)

    # mark: Expressions ========================================================================

    # Returns whether the expression has a successful continuation. `Raise`
    # and `Trap` do not; fallible calls still have a success path, which is
    # the path definite initialization must prove.
    func analyze_expression(value: NodeId, state: InitializationState, may_repeat: bool) -> bool!:
        match node_form(self.program, value):
            Reference(symbol):
                if symbol.value == self.self_symbol.value: try self.require_complete(state, node_span(self.program, value))
            NativeLoad(inner): return try self.analyze_expression(inner, state, may_repeat)
            NativeRebind(inner): return try self.analyze_expression(inner, state, may_repeat)
            NativeIsNull(inner): return try self.analyze_expression(inner, state, may_repeat)
            NativeIsSame(left, right):
                let left_terminates = try self.analyze_expression(left, state, may_repeat)
                let right_terminates = try self.analyze_expression(right, state, may_repeat)
                return left_terminates or right_terminates
            NativeAddressHash(inner): return try self.analyze_expression(inner, state, may_repeat)
            NativeFloatBits(inner): return try self.analyze_expression(inner, state, may_repeat)
            NumericConvert(inner): return try self.analyze_expression(inner, state, may_repeat)
            Discard(inner): return try self.analyze_expression(inner, state, may_repeat)
            StringScalarCount(inner): return try self.analyze_expression(inner, state, may_repeat)
            BuiltinDisplay(inner): return try self.analyze_expression(inner, state, may_repeat)
            FormattedString(parts): return try self.analyze_run(parts, state, may_repeat)
            Hash(inner): return try self.analyze_expression(inner, state, may_repeat)
            SequenceLength(inner): return try self.analyze_expression(inner, state, may_repeat)
            ListCopy(inner): return try self.analyze_expression(inner, state, may_repeat)
            ListClear(inner): return try self.analyze_expression(inner, state, may_repeat)
            MapCopy(inner): return try self.analyze_expression(inner, state, may_repeat)
            MapClear(inner): return try self.analyze_expression(inner, state, may_repeat)
            SetCopy(inner): return try self.analyze_expression(inner, state, may_repeat)
            SetClear(inner): return try self.analyze_expression(inner, state, may_repeat)
            WeakCreate(inner): return try self.analyze_expression(inner, state, may_repeat)
            WeakGet(inner): return try self.analyze_expression(inner, state, may_repeat)
            NativeStore(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            NativeAdvance(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            ListAppend(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            ListRemoveAt(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            ListReserve(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            MapLookup(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            MapRemove(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            MapReserve(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            SetContains(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            SetInsert(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            SetRemove(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            SetReserve(pointer, stored):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(stored, state, may_repeat)
            NativeMove(destination, source, count):
                if not try self.analyze_expression(destination, state, may_repeat): return false
                if not try self.analyze_expression(source, state, may_repeat): return false
                return try self.analyze_expression(count, state, may_repeat)
            NativeAllocate(element_type, count): return try self.analyze_expression(count, state, may_repeat)
            NativeDeallocate(pointer, element_type, count):
                if not try self.analyze_expression(pointer, state, may_repeat): return false
                return try self.analyze_expression(count, state, may_repeat)
            NativeArena(end): return try self.analyze_expression(end, state, may_repeat)
            SequenceIndex(inner, index):
                if not try self.analyze_expression(inner, state, may_repeat): return false
                return try self.analyze_expression(index, state, may_repeat)
            SequenceSlice(inner, start, end):
                if not try self.analyze_expression(inner, state, may_repeat): return false
                if start.value != no_node and not try self.analyze_expression(start, state, may_repeat): return false
                if end.value != no_node: return try self.analyze_expression(end, state, may_repeat)
                return true
            Unary(operation, operand): return try self.analyze_expression(operand, state, may_repeat)
            Binary(left, operation, right):
                if not try self.analyze_expression(left, state, may_repeat): return false
                match operation:
                    LogicalAnd:
                        let skipped = self.copy_state(state)
                        let evaluated = self.copy_state(state)
                        let evaluated_continues = try self.analyze_expression(right, evaluated, may_repeat)
                        let joined = self.join_continuations(skipped, true, evaluated, evaluated_continues)
                        if joined != none: self.replace_state(state, joined)
                        return joined != none
                    LogicalOr:
                        let skipped = self.copy_state(state)
                        let evaluated = self.copy_state(state)
                        let evaluated_continues = try self.analyze_expression(right, evaluated, may_repeat)
                        let joined = self.join_continuations(skipped, true, evaluated, evaluated_continues)
                        if joined != none: self.replace_state(state, joined)
                        return joined != none
                    else: return try self.analyze_expression(right, state, may_repeat)
            Conditional(selected, condition, alternative):
                if not try self.analyze_expression(condition, state, may_repeat): return false
                let selected_state = self.copy_state(state)
                let selected_continues = try self.analyze_expression(selected, selected_state, may_repeat)
                let alternative_state = self.copy_state(state)
                let alternative_continues = try self.analyze_expression(alternative, alternative_state, may_repeat)
                let joined = self.join_continuations(selected_state, selected_continues, alternative_state, alternative_continues)
                if joined != none: self.replace_state(state, joined)
                return joined != none
            Range(lower, upper, inclusive):
                if not try self.analyze_expression(lower, state, may_repeat): return false
                return try self.analyze_expression(upper, state, may_repeat)
            Call(function, arguments): return try self.analyze_arguments(arguments, state, may_repeat)
            FunctionAddress(function): return true
            ClosureValue(closure, initializers):
                for position in range(0, i64(initializers.count)):
                    let initializer = entry_at(self.program, initializers, position)
                    if initializer != i64(no_node) and not try self.analyze_expression(NodeId(value = u32(initializer)), state, may_repeat): return false
                return true
            WeakCaptureReference(symbol): return true
            IndirectCall(callee, arguments):
                if not try self.analyze_expression(callee, state, may_repeat): return false
                return try self.analyze_run(arguments, state, may_repeat)
            Initialize(function, arguments): return try self.analyze_arguments(arguments, state, may_repeat)
            Raise(code, message):
                if not try self.analyze_expression(code, state, may_repeat): return false
                discard(try self.analyze_expression(message, state, may_repeat))
                return false
            Trap(message):
                discard(try self.analyze_expression(message, state, may_repeat))
                return false
            Assert(condition, message):
                if not try self.analyze_expression(condition, state, may_repeat): return false
                return try self.analyze_expression(message, state, may_repeat)
            Try(inner): return try self.analyze_expression(inner, state, may_repeat)
            Catch(caught, failure, body):
                let before = self.copy_state(state)
                let success = self.copy_state(state)
                let success_continues = try self.analyze_expression(caught, success, may_repeat)
                let handler = try self.analyze_suite(body, before, may_repeat, true)
                var joined: InitializationState? = none
                if success_continues: joined = success
                joined = self.join_optional(joined, handler.recovered)
                if joined != none: self.replace_state(state, joined)
                return joined != none
            Tuple(elements): return try self.analyze_run(elements, state, may_repeat)
            Array(elements): return try self.analyze_run(elements, state, may_repeat)
            List(elements): return try self.analyze_run(elements, state, may_repeat)
            Map(entries): return try self.analyze_run(entries, state, may_repeat)
            Set(elements): return try self.analyze_run(elements, state, may_repeat)
            ListInsert(inner, index, element):
                if not try self.analyze_expression(inner, state, may_repeat): return false
                if not try self.analyze_expression(index, state, may_repeat): return false
                return try self.analyze_expression(element, state, may_repeat)
            Element(inner, index): return try self.analyze_expression(inner, state, may_repeat)
            StructValue(struct_index, fields): return try self.analyze_arguments(fields, state, may_repeat)
            FieldAccess(inner, field):
                match node_form(self.program, inner):
                    Reference(symbol):
                        if symbol.value == self.self_symbol.value:
                            if state.fields[field] != FieldState.initialized:
                                try self.fail(value, "field `" + self.field_names[field] + "` is read before it is initialized")
                            return true
                    else: pass
                return try self.analyze_expression(inner, state, may_repeat)
            Some(inner): return try self.analyze_expression(inner, state, may_repeat)
            ElseFallback(inner, arm):
                if not try self.analyze_expression(inner, state, may_repeat): return false
                let present = self.copy_state(state)
                let absent = self.copy_state(state)
                let absent_continues = try self.analyze_expression(arm, absent, may_repeat)
                let joined = self.join_continuations(present, true, absent, absent_continues)
                if joined != none: self.replace_state(state, joined)
                return joined != none
            EnumValue(enum_index, case_index, payload): return try self.analyze_arguments(payload, state, may_repeat)
            Match(subject, arms, has_result):
                if not try self.analyze_expression(subject, state, may_repeat): return false
                var joined: InitializationState? = none
                for position in range(0, i64(arms.count)):
                    match node_form(self.program, node_at(self.program, arms, position)):
                        MatchArm(patterns, statements, arm_value):
                            let arm_state = self.copy_state(state)
                            let flow = try self.analyze_suite(statements, arm_state, may_repeat, false)
                            let arm_completion = flow.normal
                            if arm_completion != none and try self.analyze_expression(arm_value, arm_completion, may_repeat):
                                joined = self.join_optional(joined, arm_completion)
                        else: pass
                if joined != none: self.replace_state(state, joined)
                return joined != none
            else: pass
        return true

    func analyze_arguments(arguments: Operands, state: InitializationState, may_repeat: bool) -> bool!:
        for pair in range(0, i64(arguments.count) // 2):
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            if not try self.analyze_expression(argument, state, may_repeat): return false
        return true

    func analyze_run(values: Operands, state: InitializationState, may_repeat: bool) -> bool!:
        for position in range(0, i64(values.count)):
            if not try self.analyze_expression(node_at(self.program, values, position), state, may_repeat): return false
        return true

    # A deferred action is stored as a statement node, while every other
    # recursive child here is an expression node.
    func analyze_expression_or_statement(value: NodeId, state: InitializationState, may_repeat: bool) -> bool!:
        match node_form(self.program, value):
            ExpressionStatement(inner): return try self.analyze_expression(inner, state, may_repeat)
            PrintValue(inner): return try self.analyze_expression(inner, state, may_repeat)
            else: return true

    # mark: Deinitializers =====================================================================

    # A dying identity is a borrowed receiver. Reading or mutating its fields,
    # invoking a transitively proven same-class method, and storing it into a
    # weak slot are the only operations that cannot create a new strong owner
    # and resurrect it. Record that proof for ownership lowering rather than
    # making MIR rediscover a whole-program semantic fact.
    func analyze_deinitializer(function: HirFunction) -> !:
        try self.validate_borrowed_receiver_method(function)

    # Follow only calls that pass the exact dying `self` as another method's
    # receiver. The active set closes recursive call graphs; every reachable
    # body is still inspected for an eventual owning sink before it is marked
    # as proven.
    func validate_borrowed_receiver_method(function: HirFunction) -> !:
        if self.contains_borrowed_receiver_method(self.borrowed_receiver_methods, function.symbol): return
        if self.contains_borrowed_receiver_method(self.active_borrowed_receiver_methods, function.symbol): return
        self.active_borrowed_receiver_methods.append(function.symbol)

        let previous_function = self.function
        let previous_self = self.self_symbol
        self.function = function
        self.self_symbol = function.parameters[0].symbol
        try self.validate_deinitializer_suite(function_body(function))
        self.function = previous_function
        self.self_symbol = previous_self

        self.active_borrowed_receiver_methods.remove(len(self.active_borrowed_receiver_methods) - 1)
        self.borrowed_receiver_methods.append(function.symbol)

    func validate_deinitializer_suite(statements: Operands) -> !:
        for position in range(0, i64(statements.count)):
            try self.validate_deinitializer_statement(node_at(self.program, statements, position))

    func validate_deinitializer_statement(statement: NodeId) -> !:
        match node_form(self.program, statement):
            BreakStatement: return
            ContinueStatement: return
            PrintText(value): return
            Binding(symbol, is_mutable, value): try self.validate_deinitializer_expression(value, false)
            Assignment(symbol, operation, value): try self.validate_deinitializer_expression(value, false)
            ExternStore(symbol, operation, value): try self.validate_deinitializer_expression(value, false)
            GlobalStore(symbol, operation, value): try self.validate_deinitializer_expression(value, false)
            PlaceAssignment(symbol, steps, operation, value):
                try self.validate_deinitializer_place_indices(steps)
                try self.validate_deinitializer_expression(value, self.place_ends_in_weak_field(steps))
            GlobalPlaceAssignment(symbol, steps, operation, value):
                try self.validate_deinitializer_place_indices(steps)
                try self.validate_deinitializer_expression(value, self.place_ends_in_weak_field(steps))
            PrintValue(value): try self.validate_deinitializer_expression(value, false)
            ReturnStatement(value):
                if value.value != no_node: try self.validate_deinitializer_expression(value, false)
            RecoverStatement(value): try self.validate_deinitializer_expression(value, false)
            ExpressionStatement(value): try self.validate_deinitializer_expression(value, false)
            DeferStatement(action): try self.validate_deinitializer_statement(action)
            IfStatement(branches, has_fallback, fallback):
                for branch in range(0, i64(branches.count) // 3):
                    try self.validate_deinitializer_expression(NodeId(value = u32(entry_at(self.program, branches, branch * 3))), false)
                    try self.validate_deinitializer_suite(Operands(
                        start = u32(entry_at(self.program, branches, branch * 3 + 1)),
                        count = u32(entry_at(self.program, branches, branch * 3 + 2)),
                    ))
                if has_fallback: try self.validate_deinitializer_suite(fallback)
            WhileStatement(condition, body):
                try self.validate_deinitializer_expression(condition, false)
                try self.validate_deinitializer_suite(body)
            ForStatement(symbol, iteration, body):
                match iteration:
                    Builtin(iterable): try self.validate_deinitializer_expression(iterable, false)
                    Protocol(iterator_symbol, iterator, next):
                        try self.validate_deinitializer_expression(iterator, false)
                        try self.validate_deinitializer_expression(next, false)
                try self.validate_deinitializer_suite(body)
            Match(subject, arms, has_result):
                try self.validate_deinitializer_expression(subject, false)
                try self.validate_deinitializer_arms(arms)
            else: trap("expression node appeared directly in a deinitializer suite")

    func validate_deinitializer_expression(value: NodeId, allow_direct_self: bool) -> !:
        match node_form(self.program, value):
            Constant(index): return
            ExternLoad(index): return
            GlobalLoad(index): return
            FunctionAddress(index): return
            ClosureValue(closure, initializers):
                let capture_table = self.program.closures[closure].captures
                for position in range(0, i64(initializers.count)):
                    let initializer = entry_at(self.program, initializers, position)
                    if initializer == i64(no_node): continue
                    var allow_self = false
                    if capture_table[position].kind == HirCaptureKind.weak_capture: allow_self = true
                    try self.validate_deinitializer_expression(NodeId(value = u32(initializer)), allow_self)
            WeakCaptureReference(symbol): return
            ErrorCodeLiteral(index): return
            NoneLiteral: return
            Reference(symbol):
                if symbol.value == self.self_symbol.value and not allow_direct_self:
                    try self.fail(value, "deinitializer may use `self` only to access its fields, call one of its methods, or store a weak reference; a new strong reference would resurrect the class")
            NativeLoad(inner): try self.validate_deinitializer_expression(inner, false)
            NativeRebind(inner): try self.validate_deinitializer_expression(inner, false)
            NativeIsNull(inner): try self.validate_deinitializer_expression(inner, false)
            NativeIsSame(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            NativeAddressHash(inner): try self.validate_deinitializer_expression(inner, false)
            NativeFloatBits(inner): try self.validate_deinitializer_expression(inner, false)
            NumericConvert(inner): try self.validate_deinitializer_expression(inner, false)
            Discard(inner): try self.validate_deinitializer_expression(inner, false)
            StringScalarCount(inner): try self.validate_deinitializer_expression(inner, false)
            BuiltinDisplay(inner): try self.validate_deinitializer_expression(inner, false)
            FormattedString(parts): try self.validate_deinitializer_run(parts, false)
            Hash(inner): try self.validate_deinitializer_expression(inner, false)
            SequenceLength(inner): try self.validate_deinitializer_expression(inner, false)
            ListCopy(inner): try self.validate_deinitializer_expression(inner, false)
            ListClear(inner): try self.validate_deinitializer_expression(inner, false)
            MapCopy(inner): try self.validate_deinitializer_expression(inner, false)
            MapClear(inner): try self.validate_deinitializer_expression(inner, false)
            SetCopy(inner): try self.validate_deinitializer_expression(inner, false)
            SetClear(inner): try self.validate_deinitializer_expression(inner, false)
            Unary(operation, inner): try self.validate_deinitializer_expression(inner, false)
            Try(inner): try self.validate_deinitializer_expression(inner, false)
            NativeStore(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            NativeAdvance(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            SequenceIndex(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            ListAppend(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            ListRemoveAt(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            ListReserve(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            MapLookup(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            MapRemove(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            MapReserve(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            SetContains(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            SetInsert(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            SetRemove(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            SetReserve(left, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            WeakCreate(inner): try self.validate_deinitializer_expression(inner, true)
            WeakGet(inner): try self.validate_deinitializer_expression(inner, false)
            Range(left, right, inclusive):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            NativeMove(destination, source, count):
                try self.validate_deinitializer_expression(destination, false)
                try self.validate_deinitializer_expression(source, false)
                try self.validate_deinitializer_expression(count, false)
            NativeAllocate(element_type, count): try self.validate_deinitializer_expression(count, false)
            NativeArena(count): try self.validate_deinitializer_expression(count, false)
            NativeDeallocate(pointer, element_type, count):
                try self.validate_deinitializer_expression(pointer, false)
                try self.validate_deinitializer_expression(count, false)
            SequenceSlice(inner, start, end):
                try self.validate_deinitializer_expression(inner, false)
                if start.value != no_node: try self.validate_deinitializer_expression(start, false)
                if end.value != no_node: try self.validate_deinitializer_expression(end, false)
            Binary(left, operation, right):
                try self.validate_deinitializer_expression(left, false)
                try self.validate_deinitializer_expression(right, false)
            Conditional(selected, condition, alternative):
                try self.validate_deinitializer_expression(condition, false)
                try self.validate_deinitializer_expression(selected, allow_direct_self)
                try self.validate_deinitializer_expression(alternative, allow_direct_self)
            Call(symbol, arguments): try self.validate_deinitializer_call(value, symbol, arguments)
            IndirectCall(callee, arguments):
                self.diagnose_deinitializer_reentrancy(value, "indirect call")
                try self.validate_deinitializer_expression(callee, false)
                try self.validate_deinitializer_run(arguments, false)
            Initialize(symbol, arguments):
                self.diagnose_deinitializer_reentrancy(value, "construction")
                try self.validate_deinitializer_arguments(arguments, false)
            Raise(code, message):
                try self.validate_deinitializer_expression(code, false)
                try self.validate_deinitializer_expression(message, false)
            Trap(message): try self.validate_deinitializer_expression(message, false)
            Assert(condition, message):
                try self.validate_deinitializer_expression(condition, false)
                try self.validate_deinitializer_expression(message, false)
            Catch(caught, failure, body):
                try self.validate_deinitializer_expression(caught, false)
                try self.validate_deinitializer_suite(body)
            Tuple(elements): try self.validate_deinitializer_run(elements, false)
            Array(elements): try self.validate_deinitializer_run(elements, false)
            List(elements): try self.validate_deinitializer_run(elements, false)
            Map(elements): try self.validate_deinitializer_run(elements, false)
            Set(elements): try self.validate_deinitializer_run(elements, false)
            StructValue(struct_index, elements): try self.validate_deinitializer_arguments(elements, false)
            EnumValue(enum_index, case_index, elements): try self.validate_deinitializer_arguments(elements, false)
            ListInsert(inner, index, element):
                try self.validate_deinitializer_expression(inner, false)
                try self.validate_deinitializer_expression(index, false)
                try self.validate_deinitializer_expression(element, false)
            Element(inner, index): try self.validate_deinitializer_expression(inner, false)
            FieldAccess(inner, field):
                match node_form(self.program, inner):
                    Reference(symbol):
                        if symbol.value == self.self_symbol.value: return
                    else: pass
                try self.validate_deinitializer_expression(inner, false)
            Some(inner): try self.validate_deinitializer_expression(inner, allow_direct_self)
            ElseFallback(inner, arm):
                try self.validate_deinitializer_expression(inner, allow_direct_self)
                try self.validate_deinitializer_expression(arm, allow_direct_self)
            Match(subject, arms, has_result):
                try self.validate_deinitializer_expression(subject, false)
                try self.validate_deinitializer_arms(arms)
            else: trap("statement or pattern node appeared in a deinitializer expression")

    func validate_deinitializer_call(call: NodeId, symbol: SymbolId, arguments: Operands) -> !:
        let target = self.function_with_symbol(symbol)
        var permits_self_receiver = false
        let current = self.function else trap("deinitializer analysis lost its function")
        let current_receiver = current.receiver else trap("deinitializer has no receiver")
        let target_receiver = target.receiver
        if target_receiver != none:
            permits_self_receiver = target_receiver.kind == HirReceiverKind.value_method and types_match(target_receiver.owner, current_receiver.owner)
        var passes_borrowed_receiver = false
        for pair in range(0, i64(arguments.count) // 2):
            let parameter = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            let is_borrowed_receiver = permits_self_receiver and parameter == 0 and self.is_direct_self_reference(argument)
            try self.validate_deinitializer_expression(argument, is_borrowed_receiver)
            if is_borrowed_receiver: passes_borrowed_receiver = true
        if passes_borrowed_receiver:
            try self.validate_borrowed_receiver_method(target)
            return
        match target.implementation:
            ExternalC(contract): return
            else: self.diagnose_deinitializer_reentrancy(call, "call to `" + target.name + "`")

    func diagnose_deinitializer_reentrancy(call: NodeId, subject: str):
        let current = self.function else trap("deinitializer reentrancy analysis lost its function")
        let path = self.program.modules[current.module.value].path
        self.diagnostics.append(Diagnostic(
            severity = DiagnosticSeverity.warning,
            code = "L1101",
            message = subject + " from `deinit` may reenter arbitrary user code",
            primary = DiagnosticLabel(
                path = path,
                span = node_span(self.program, call),
                message = "destruction is already observable and the object cannot safely participate in reentrant callbacks",
            ),
            secondary = list[DiagnosticLabel](),
            help = "perform callbacks during explicit shutdown and keep `deinit` limited to same-class cleanup",
        ))

    func is_direct_self_reference(value: NodeId) -> bool:
        match node_form(self.program, value):
            Reference(symbol): return symbol.value == self.self_symbol.value
            else: return false

    func contains_borrowed_receiver_method(methods: list[SymbolId], symbol: SymbolId) -> bool:
        for method in methods:
            if method.value == symbol.value: return true
        return false

    func validate_deinitializer_arguments(arguments: Operands, allow_direct_self: bool) -> !:
        for pair in range(0, i64(arguments.count) // 2):
            try self.validate_deinitializer_expression(NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1))), allow_direct_self)

    func validate_deinitializer_run(values: Operands, allow_direct_self: bool) -> !:
        for position in range(0, i64(values.count)):
            try self.validate_deinitializer_expression(node_at(self.program, values, position), allow_direct_self)

    func validate_deinitializer_arms(arms: Operands) -> !:
        for position in range(0, i64(arms.count)):
            match node_form(self.program, node_at(self.program, arms, position)):
                MatchArm(patterns, statements, value):
                    try self.validate_deinitializer_suite(statements)
                    if value.value != no_node: try self.validate_deinitializer_expression(value, false)
                else: trap("match arm run names a non-arm node")

    func validate_deinitializer_place_indices(steps: Operands) -> !:
        for position in range(0, i64(steps.count) // 2):
            let kind = u32(entry_at(self.program, steps, position * 2))
            if kind == place_element_step or kind == place_list_element_step:
                try self.validate_deinitializer_expression(NodeId(value = u32(entry_at(self.program, steps, position * 2 + 1))), false)

    func place_ends_in_weak_field(steps: Operands) -> bool:
        if steps.count < 2: return false
        return u32(entry_at(self.program, steps, i64(steps.count) - 2)) == place_weak_field_step

    func function_with_symbol(symbol: SymbolId) -> HirFunction:
        for function in self.program.functions:
            if function.symbol.value == symbol.value: return function
        trap("deinitializer call names an unknown function")

    # mark: State ===============================================================================

    func copy_state(state: InitializationState) -> InitializationState:
        let copied = InitializationState(0)
        for field in state.fields: copied.fields.append(field)
        return copied

    func replace_state(destination: InitializationState, source: InitializationState):
        for index in range(0, len(destination.fields)): destination.fields[index] = source.fields[index]

    func join_optional(left: InitializationState?, right: InitializationState?) -> InitializationState?:
        if left == none: return right
        if right == none: return left
        return self.join_states(left, right)

    func join_continuations(left: InitializationState, left_continues: bool, right: InitializationState, right_continues: bool) -> InitializationState?:
        if left_continues and right_continues: return self.join_states(left, right)
        if left_continues: return left
        if right_continues: return right
        return none

    func join_states(left: InitializationState, right: InitializationState) -> InitializationState:
        let joined = InitializationState(0)
        for index in range(0, len(left.fields)):
            if left.fields[index] == right.fields[index]: joined.fields.append(left.fields[index])
            else: joined.fields.append(FieldState.maybe_initialized)
        return joined

    func require_complete(state: InitializationState, span: SourceSpan) -> !:
        for index in range(0, len(state.fields)):
            if state.fields[index] != FieldState.initialized:
                error(self.diagnostic(span, "initializer may finish before field `" + self.field_names[index] + "` is initialized"))

    func fail(node: NodeId, message: str) -> !:
        error(self.diagnostic(node_span(self.program, node), message))

    func diagnostic(span: SourceSpan, message: str) -> str:
        let active = self.function else trap("initializer diagnostic outside a function")
        return format_diagnostic(self.program.modules[active.module.value].path, span, message)
