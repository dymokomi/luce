#==============================================================================================
#
#   literal_decoder - Source literal spellings into semantic values
#
#   DESCRIPTION:
#       Decodes already-tokenized character, string, raw-string, and byte
#       spellings without knowing about source files, types, HIR nodes, or a
#       target. The tokenizer owns boundaries and lexical validation; this
#       module independently checks its input so callers never receive a
#       partially decoded value.
#
#==============================================================================================

import std.strings
from compiler.formatting.triple_strings import normalize_triple_literal
from compiler.formatting.utf8 import append_utf8

# One cursor over Unicode scalar values. Keeping the spelling as a character
# list makes every cursor step constant-time even though `str` indexing walks.
class LiteralDecoder:
    let characters: list[char]
    var position: i64

    init(characters: list[char]):
        self.characters = characters
        self.position = 0

    # mark: Literal families ==================================================================

    func text() -> str!:
        let output = list[u8]()
        let is_raw = self.take('r')
        try self.open_string("string")
        while self.position < len(self.characters) - 1:
            let character = self.characters[self.position]
            self.position += 1
            if character == '\\' and not is_raw:
                try append_utf8(output, try self.scalar_escape())
            else:
                try append_utf8(output, character)
        try self.close_string("string")
        return strings.from_bytes(output) else error("decoded string is not valid UTF-8")

    func character() -> char!:
        if not self.take('\''): error("malformed character literal")
        if self.position >= len(self.characters) - 1: error("character literal must contain one character")
        var value = char(0)
        if self.take('\\'):
            value = try self.scalar_escape()
        else:
            value = self.characters[self.position]
            self.position += 1
        if self.position != len(self.characters) - 1 or not self.take('\''):
            error("character literal must contain one character")
        return value

    func byte_string() -> list[u8]!:
        if not self.take('b'): error("malformed byte literal")
        try self.open_string("byte literal")
        let output = list[u8]()
        while self.position < len(self.characters) - 1:
            let character = self.characters[self.position]
            self.position += 1
            if character != '\\':
                if u32(character) > 127: error("byte literals require ASCII source characters")
                output.append(u8(u32(character)))
            elif self.peek() == 'x':
                self.position += 1
                if self.position + 1 >= len(self.characters) - 1:
                    error("byte escape must contain two hex digits")
                let high = try self.hex_digit(self.characters[self.position])
                let low = try self.hex_digit(self.characters[self.position + 1])
                output.append(u8(high * 16 + low))
                self.position += 2
            else:
                # A Unicode escape is explicit source encoding. It contributes
                # that scalar's canonical UTF-8 bytes, while `\xNN` remains the
                # spelling for one exact byte.
                try append_utf8(output, try self.scalar_escape())
        try self.close_string("byte literal")
        return output

    # mark: Delimiters and escapes =============================================================

    func open_string(kind: str) -> !:
        if not self.take('"'): error("malformed " + kind)

    func close_string(kind: str) -> !:
        if self.position != len(self.characters) - 1 or not self.take('"'):
            error("malformed " + kind)

    # Decode one escape after its leading backslash. Byte-only `xNN` is
    # handled by `byte_string`, leaving this function with scalar semantics.
    func scalar_escape() -> char!:
        if self.position >= len(self.characters): error("incomplete literal escape")
        let escaped = self.characters[self.position]
        self.position += 1
        match escaped:
            '\\': return '\\'
            '"': return '"'
            '\'': return '\''
            'n': return '\n'
            'r': return '\r'
            't': return '\t'
            '0': return char(0)
            'u':
                if not self.take('{'): error("Unicode escape must be \\u{HEX}")
                var scalar = i64(0)
                var digits = 0
                while self.peek() != '}':
                    if self.position >= len(self.characters): error("Unicode escape must be \\u{HEX}")
                    scalar = scalar * 16 + try self.hex_digit(self.characters[self.position])
                    digits += 1
                    self.position += 1
                if digits == 0 or digits > 6: error("Unicode escape must be \\u{HEX}")
                self.position += 1
                if scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
                    error("Unicode escape is not a scalar value")
                return char(u32(scalar))
            else: error("invalid literal escape")

    # mark: Cursor =============================================================================
    func hex_digit(character: char) -> i64!:
        if character >= '0' and character <= '9': return i64(u32(character) - u32('0'))
        if character >= 'a' and character <= 'f': return i64(u32(character) - u32('a')) + 10
        if character >= 'A' and character <= 'F': return i64(u32(character) - u32('A')) + 10
        error("literal escape contains a non-hexadecimal digit")

    func take(character: char) -> bool:
        if self.peek() != character: return false
        self.position += 1
        return true

    func peek(offset: i64 = 0) -> char:
        if self.position + offset >= len(self.characters): return char(0)
        return self.characters[self.position + offset]

# mark: Public boundary ========================================================================

pub func decode_text_literal(spelling: str) -> str!:
    let characters = try prepared_characters(spelling, text_prefix_length(spelling), "string")
    return try LiteralDecoder(characters).text()

pub func decode_character_literal(spelling: str) -> char!:
    return try LiteralDecoder(characters_of(spelling)).character()

pub func decode_byte_literal(spelling: str) -> list[u8]!:
    let characters = try prepared_characters(spelling, 1, "byte literal")
    return try LiteralDecoder(characters).byte_string()

## Decode one text token from a formatted string after triple indentation has
## been normalized. The token has no quotes of its own; doubled braces are
## source delimiters and ordinary string escapes retain their usual meaning.
pub func decode_formatted_text(spelling: str) -> str!:
    let decoder = LiteralDecoder(characters_of(spelling))
    let output = list[u8]()
    while decoder.position < len(decoder.characters):
        let character = decoder.characters[decoder.position]
        decoder.position += 1
        if character == '\\':
            try append_utf8(output, try decoder.scalar_escape())
        elif character == '{' or character == '}':
            if decoder.position >= len(decoder.characters) or decoder.characters[decoder.position] != character:
                error("formatted string contains an unescaped brace")
            decoder.position += 1
            try append_utf8(output, character)
        else:
            try append_utf8(output, character)
    return strings.from_bytes(output) else error("decoded formatted string text is not valid UTF-8")

# mark: Triple-literal preparation ==============================================================

func prepared_characters(spelling: str, prefix_length: i64, kind: str) -> list[char]!:
    let characters = characters_of(spelling)
    if has_triple_open(characters, prefix_length):
        return try normalize_triple_literal(characters, prefix_length, kind)
    return characters

func text_prefix_length(spelling: str) -> i64:
    for character in spelling:
        if character == 'r': return 1
        return 0
    return 0

func has_triple_open(characters: list[char], prefix_length: i64) -> bool:
    return (
        prefix_length >= 0
        and prefix_length + 2 < len(characters)
        and characters[prefix_length] == '"'
        and characters[prefix_length + 1] == '"'
        and characters[prefix_length + 2] == '"'
    )

func characters_of(spelling: str) -> list[char]:
    let characters = list[char]()
    for character in spelling: characters.append(character)
    return characters
