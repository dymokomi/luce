#==============================================================================================
#
#   interface_values - Existential conversion and dynamic requirement calls
#
#   DESCRIPTION:
#       Owns the function-local semantics of interface values. Declaration
#       collection has already fixed nominal interface identities. This pass
#       resolves or materializes one exact concrete conformance, packages the
#       value with it, and resolves calls by requirement position. HIR retains
#       those semantic identities without choosing a box, pointer, witness
#       layout, or calling convention.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ArgumentSyntax
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generation_model import HirGenerationState, HirSemanticChecker
from compiler.hir.ir import HirNodeForm, HirParameter, NodeId, TypeForm, TypeId, no_node

## Coordinates existential operations with the expression checker through
## the same narrow semantic services used by generic-function resolution.
pub class InterfaceValueChecker:
    let state: HirGenerationState
    let declarations: DeclarationCollector

    pub init(state: HirGenerationState, declarations: DeclarationCollector):
        self.state = state
        self.declarations = declarations

    # mark: Contextual conversion ==============================================================

    ## Insert the sole implicit existential conversion: a concrete value to
    ## an interface it explicitly implements. Interface-to-interface
    ## conversion is absent because interfaces do not inherit.
    pub func convert(semantics: HirSemanticChecker, value: NodeId, expected: TypeId) -> NodeId?!:
        var is_interface = false
        match self.state.types.definitions[expected.value].form:
            Interface(index, arguments): is_interface = true
            else: pass
        if not is_interface: return none

        let found = self.state.type_of(value)
        match self.state.types.definitions[found.value].form:
            Interface(index, arguments): return none
            else: pass
        return try semantics.convert_interface_value_for_feature(value, found, expected)

    ## Full Luce's existential: the conformance is proven and the value boxed.
    pub func convert_existential(semantics: HirSemanticChecker, value: NodeId, found: TypeId, expected: TypeId) -> NodeId?!:
        let conformance = try self.declarations.ensure_conformance(semantics, found, expected, self.state.span_of(value))
        if conformance < 0:
            try self.state.fail_at(
                self.state.current_module,
                self.state.span_of(value),
                "type `" + self.state.describe_type(found) + "` does not conform to `" + self.state.describe_type(expected) + "`",
            )
        var form = HirNodeForm.InterfaceValue(value = value, conformance = u32(conformance))
        if self.state.checking_generic_template():
            # The abstract conformance exists only inside the probe transaction
            # and is rolled back with it. Retained HIR keeps the proven
            # conversion, not an index that would dangle in a package artifact.
            form = HirNodeForm.GenericInterfaceValue(value = value)
        return self.state.push_node(form, expected, self.state.span_of(value))

    # mark: Dynamic calls ======================================================================

    ## Resolve a method from the existential's nominal requirement table.
    ## The HIR node retains the receiver and requirement position; no concrete
    ## implementation is selected until the value supplies its conformance at
    ## run time.
    pub func check_call(semantics: HirSemanticChecker, receiver: NodeId, owner_type: TypeId, name: str, arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?) -> NodeId?!:
        var interface_index = -1
        let interface_arguments = list[TypeId]()
        match self.state.types.definitions[owner_type.value].form:
            Interface(index, values):
                interface_index = index
                for value in values: interface_arguments.append(value)
            else: return none

        let contract = self.state.interfaces[interface_index]
        var requirement_index = -1
        for index in range(0, len(contract.requirements)):
            if contract.requirements[index].name == name:
                requirement_index = index
                break
        if requirement_index < 0:
            try self.state.fail_at(self.state.current_module, callee_span, "interface `" + contract.name + "` has no method `" + name + "`")
        let requirement = contract.requirements[requirement_index]
        try semantics.check_interface_receiver_for_feature(receiver, requirement.is_mutating, callee_span)
        let parameters = list[HirParameter]()
        for parameter in requirement.parameters:
            parameters.append(HirParameter(
                symbol = parameter.symbol,
                name = parameter.name,
                value_type = self.state.substitute_type(parameter.value_type, contract.generic_id, interface_arguments),
                default_value = NodeId(value = no_node),
            ))
        let placed = try semantics.check_declaration_arguments_for_feature(
            parameters,
            arguments,
            span,
            "interface method `" + name + "`",
            "call to interface method `" + name + "`",
        )
        let result_type = self.state.substitute_type(requirement.result, contract.generic_id, interface_arguments)
        let call = self.state.push_node(
            HirNodeForm.InterfaceCall(
                receiver = receiver,
                interface_type = owner_type,
                requirement = u32(requirement_index),
                arguments = placed,
            ),
            result_type,
            span,
        )
        return try semantics.require_type_for_feature(call, expected)
