#==============================================================================================
#
#   structural_protocols - Closed equality and hashing operations
#
#   DESCRIPTION:
#       Owns function-local use of the compiler-derived Equatable/Hashable
#       families. DeclarationCollector decides structural eligibility from
#       the one resolved type graph; this owner validates the closed `hash`
#       operation and records one target-independent HIR node. No backend
#       representation or hash-table policy enters HIR.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ArgumentSyntax, TypeArgumentSyntax
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generation_model import HirGenerationState, HirSemanticChecker
from compiler.hir.ir import BuiltinType, HirNodeForm, NodeId, TypeId, resolve_builtin_type

## Coordinates closed structural operations through the same narrow semantic
## interface used by the other focused HIR feature owners.
pub class StructuralProtocolChecker:
    let state: HirGenerationState
    let declarations: DeclarationCollector

    pub init(state: HirGenerationState, declarations: DeclarationCollector):
        self.state = state
        self.declarations = declarations

    # mark: Hashing =============================================================================

    ## Check `hash(value) -> u64`. The argument is evaluated once by the HIR
    ## node; concrete structural traversal belongs to the semantic oracle and
    ## canonical lowering. A constrained generic operand is accepted only
    ## when its abstract type carries the closed `Hashable` marker.
    pub func check_hash_call(semantics: HirSemanticChecker, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        if len(type_arguments) != 0:
            try self.state.fail_at(self.state.current_module, span, "`hash` infers its value type and takes no type arguments")
        if len(arguments) != 1:
            try self.state.fail_at(self.state.current_module, span, "`hash` takes exactly one positional value")
        if arguments[0].label != none:
            try self.state.fail_at(self.state.current_module, arguments[0].span, "`hash` uses one positional value")

        let value = try semantics.check_expression_for_feature(arguments[0].value, none)
        let value_type = self.state.type_of(value)
        if not self.declarations.is_hashable_type(value_type):
            try self.state.fail_at(
                self.state.current_module,
                arguments[0].span,
                "`hash` requires a `Hashable` value, found `" + self.state.describe_type(value_type) + "`",
            )
        let result = self.state.push_node(
            HirNodeForm.Hash(value = value),
            resolve_builtin_type(BuiltinType.unsigned_u64),
            span,
        )
        return try semantics.require_type_for_feature(result, expected)
