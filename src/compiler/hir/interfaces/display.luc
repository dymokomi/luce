#==============================================================================================
#
#   display - Resolution of formatted-string field conversion
#
#   DESCRIPTION:
#       Converts one checked interpolation field to canonical `str`. Closed
#       builtin scalars retain an explicit semantic conversion node; source
#       conformances become the same static, abstract, or dynamic calls used
#       by every other interface requirement. No runtime or backend policy is
#       selected here.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ArgumentSyntax
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generation_model import HirGenerationState, HirSemanticChecker
from compiler.hir.generics.functions import GenericFunctionChecker
from compiler.hir.interfaces.standard import ensure_standard_interface, standard_interface_name
from compiler.hir.interfaces.values import InterfaceValueChecker
from compiler.hir.ir import BuiltinType, HirNodeForm, NodeId, StandardInterface, TypeForm, TypeId
from compiler.hir.ir import is_floating_type, is_integer_type, resolve_builtin_type, types_match

# mark: Dispatch ===============================================================================

union DisplayDispatch:
    Abstract(interface_type: TypeId)
    Dynamic(interface_type: TypeId)
    Static(conformance: u32)

## Owns only the closed field-to-text decision. Template text normalization
## and aggregate construction remain with the formatted-string checker.
pub class DisplayChecker:
    let state: HirGenerationState
    let declarations: DeclarationCollector
    let generics: GenericFunctionChecker
    let interfaces: InterfaceValueChecker

    pub init(state: HirGenerationState, declarations: DeclarationCollector, generics: GenericFunctionChecker, interfaces: InterfaceValueChecker):
        self.state = state
        self.declarations = declarations
        self.generics = generics
        self.interfaces = interfaces

    ## Return a canonical string expression while preserving one evaluation of
    ## `value`. String is identity; closed scalars use compiler semantics; all
    ## other user types must explicitly conform to the standard `Display`.
    pub func check(semantics: HirSemanticChecker, value: NodeId, span: SourceSpan) -> NodeId!:
        let value_type = self.state.type_of(value)
        match self.state.types.definitions[value_type.value].form:
            String: return value
            Boolean, Character:
                return self.state.push_node(HirNodeForm.BuiltinDisplay(value = value), resolve_builtin_type(BuiltinType.string), span)
            else: pass
        if is_integer_type(self.state.types, value_type) or is_floating_type(self.state.types, value_type):
            return self.state.push_node(HirNodeForm.BuiltinDisplay(value = value), resolve_builtin_type(BuiltinType.string), span)

        let resolved = try self.resolve(semantics, value_type, span)
        if resolved == none:
            try self.fail(span, "formatted string field of type `" + self.state.describe_type(value_type) + "` does not conform to `" + standard_interface_name(StandardInterface.display) + "`")
        let dispatch = resolved else trap("resolved Display dispatch disappeared")
        match dispatch:
            Abstract(interface_type):
                return try self.generics.check_selected_requirement_call(semantics, value, interface_type, 0, span, span)
            Dynamic(interface_type):
                let called = try self.interfaces.check_call(
                    semantics,
                    value,
                    interface_type,
                    "display",
                    list[ArgumentSyntax](),
                    span,
                    span,
                    resolve_builtin_type(BuiltinType.string),
                )
                return called else trap("standard Display requirement did not resolve")
            Static(conformance_index):
                let conformance = self.state.conformances[conformance_index]
                let implementation = conformance.implementations[0]
                let arguments = self.state.push_run([u32(0), value.value])
                return self.state.push_node(
                    HirNodeForm.Call(function = implementation, arguments = arguments),
                    resolve_builtin_type(BuiltinType.string),
                    span,
                )

    # mark: Conformance selection ==============================================================

    func resolve(semantics: HirSemanticChecker, value_type: TypeId, span: SourceSpan) -> DisplayDispatch?!:
        let interface_index = ensure_standard_interface(self.state, StandardInterface.display)
        match self.state.types.definitions[value_type.value].form:
            TypeParameter(generic, position):
                let constraints = self.state.type_parameter_constraints(generic, position)
                if constraints == none: return none
                for constraint in constraints:
                    if interface_declaration(self.state, constraint) == interface_index:
                        return DisplayDispatch.Abstract(interface_type = constraint)
                return none
            Interface(index, arguments):
                if index == interface_index: return DisplayDispatch.Dynamic(interface_type = value_type)
                return none
            else: pass

        try self.declarations.materialize_generic_conformances_for_type(semantics, value_type)
        for index in range(0, len(self.state.conformances)):
            let conformance = self.state.conformances[index]
            if not types_match(conformance.value_type, value_type): continue
            if interface_declaration(self.state, conformance.interface_type) == interface_index:
                return DisplayDispatch.Static(conformance = u32(index))
        return none

    func fail(span: SourceSpan, message: str) -> !:
        try self.state.fail_at(self.state.current_module, span, message)

func interface_declaration(state: HirGenerationState, value_type: TypeId) -> i64:
    match state.types.definitions[value_type.value].form:
        Interface(index, arguments): return index
        else: return -1
