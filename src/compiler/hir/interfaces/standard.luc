#==============================================================================================
#
#   standard_interfaces - Compiler-known language protocol declarations
#
#   DESCRIPTION:
#       Materializes closed standard interface identities on demand. These are
#       ordinary HIR interface contracts after creation, but their origin is
#       the language rather than an invented source module. The declarations
#       contain no executable policy and introduce no MIR or backend facts.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.generation_model import CollectedInterface, HirGenerationState, TypeBinding
from compiler.hir.ir import HirInterfaceOrigin, HirInterfaceRequirement, HirParameter, HirTypeParameter, StandardInterface
from compiler.hir.ir import SymbolKind, TypeForm, TypeId

# mark: Identity ==============================================================================

pub func standard_interface_named(name: str) -> StandardInterface?:
    return match name:
        "Iterator" => StandardInterface.iterator
        "Iterable" => StandardInterface.iterable
        "FallibleIterator" => StandardInterface.fallible_iterator
        "FallibleIterable" => StandardInterface.fallible_iterable
        else => none

pub func standard_interface_name(identity: StandardInterface) -> str:
    return match identity:
        iterator => "Iterator"
        iterable => "Iterable"
        fallible_iterator => "FallibleIterator"
        fallible_iterable => "FallibleIterable"

pub func is_standard_interface(state: HirGenerationState, index: i64, identity: StandardInterface) -> bool:
    match state.interfaces[index].origin:
        Standard(found): return found == identity
        Source(module): return false

## Recover the language identity of an applied standard interface. Keeping
## this query here prevents declaration collection and operation resolution
## from independently interpreting interface-table indices.
pub func standard_interface_of(state: HirGenerationState, value_type: TypeId) -> StandardInterface?:
    match state.types.definitions[value_type.value].form:
        Interface(index, arguments):
            match state.interfaces[index].origin:
                Standard(identity): return identity
                Source(module): return none
        else: return none

## All four iteration contracts have exactly one element argument. Answer it
## only for standard interfaces so callers cannot accidentally apply the
## canonical-element rule to an unrelated generic interface.
pub func standard_interface_element(state: HirGenerationState, value_type: TypeId) -> TypeId?:
    if standard_interface_of(state, value_type) == none: return none
    match state.types.definitions[value_type.value].form:
        Interface(index, arguments):
            if len(arguments) != 1: trap("standard interface application has the wrong arity")
            return arguments[0]
        else: trap("standard interface identity belongs to a non-interface type")

## Infallible and fallible variants of the same role share one canonical
## element type. A value may independently be an iterator of one type and an
## iterable of another; those are different operations, not two traversals of
## the same role.
pub func standard_interfaces_share_role(left: StandardInterface, right: StandardInterface) -> bool:
    return match left:
        iterator, fallible_iterator => right == StandardInterface.iterator or right == StandardInterface.fallible_iterator
        iterable, fallible_iterable => right == StandardInterface.iterable or right == StandardInterface.fallible_iterable

# mark: Materialization =======================================================================

## Return the one declaration identity for a standard protocol, creating it
## only when source or a semantic operation actually uses it. Programs that
## do not use protocols therefore carry no irrelevant interface metadata.
pub func ensure_standard_interface(state: HirGenerationState, identity: StandardInterface) -> i64:
    for index in range(0, len(state.interfaces)):
        if is_standard_interface(state, index, identity): return index

    var result_interface: i64? = none
    match identity:
        iterable: result_interface = ensure_standard_interface(state, StandardInterface.iterator)
        fallible_iterable: result_interface = ensure_standard_interface(state, StandardInterface.fallible_iterator)
        else: pass

    let generic_id = state.allocate_generic_identity()
    let element = state.intern_named(
        "T",
        TypeForm.TypeParameter(generic = generic_id, position = 0),
    )
    let type_parameters = [HirTypeParameter(
        name = "T",
        value_type = element,
        constraints = list[TypeId](),
    )]
    let type_bindings = [TypeBinding(name = "T", value_type = element)]
    var requirement_name = "next"
    var is_mutating = true
    var result = state.intern_optional(element)
    match identity:
        iterator: pass
        fallible_iterator: result = state.intern_fallible(result)
        iterable:
            requirement_name = "iterator"
            is_mutating = false
            let iterator_index = result_interface else trap("Iterable lost Iterator identity")
            result = state.intern_interface(iterator_index, [element])
        fallible_iterable:
            requirement_name = "iterator"
            is_mutating = false
            let iterator_index = result_interface else trap("FallibleIterable lost FallibleIterator identity")
            result = state.intern_interface(iterator_index, [element])

    let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
    let requirement = HirInterfaceRequirement(
        symbol = state.make_symbol(requirement_name, SymbolKind.function, result),
        name = requirement_name,
        is_mutating = is_mutating,
        documentation = list[str](),
        parameters = list[HirParameter](),
        result = result,
        span = span,
    )
    let index = len(state.interfaces)
    state.interfaces.append(CollectedInterface(
        origin = HirInterfaceOrigin.Standard(identity = identity),
        name = standard_interface_name(identity),
        is_public = true,
        documentation = list[str](),
        generic_id = generic_id,
        type_parameters = type_parameters,
        type_bindings = type_bindings,
        requirements = [requirement],
        syntax = none,
        span = span,
    ))
    return index
