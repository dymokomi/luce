#==============================================================================================
#
#   generic_inference - Structural type-argument inference and constraint proof
#
#   DESCRIPTION:
#       Owns the declaration-independent generic algorithm shared by free
#       functions, nominal construction, and methods. It recursively relates
#       one abstract type pattern to a concrete type, builds contextual types
#       from arguments learned so far, and proves written interface bounds.
#       It mutates only caller-owned argument/bound lists; declaration owners
#       remain responsible for instance identity and specialization.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.generation_model import HirGenerationState
from compiler.hir.ir import TypeForm, TypeId, types_match

## Structural inference over the one canonical HIR type table. Keeping this
## algorithm independent of any particular generic declaration prevents free
## functions and nominal members from developing subtly different rules.
pub class GenericInference:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    # mark: Partial contextual types ===========================================================

    ## Substitute the arguments already learned into `pattern`. `none` means
    ## at least one required parameter remains unknown, so the caller should
    ## check its expression without a contextual type and infer afterward.
    pub func contextual_type(pattern: TypeId, generic_id: u32, arguments: list[TypeId], bound: list[bool]) -> TypeId?:
        match self.state.types.definitions[pattern.value].form:
            TypeParameter(owner, position):
                if owner != generic_id: return pattern
                if not bound[position]: return none
                return arguments[position]
            Slice(element):
                let inner = self.contextual_type(element, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_slice(inner)
            List(element):
                let inner = self.contextual_type(element, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_list(inner)
            Weak(value):
                let inner = self.contextual_type(value, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_weak(inner)
            Range(element):
                let inner = self.contextual_type(element, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_range(inner)
            Array(element, count):
                let inner = self.contextual_type(element, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_array(inner, count)
            Optional(value):
                let inner = self.contextual_type(value, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_optional(inner)
            Fallible(value):
                let inner = self.contextual_type(value, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_fallible(inner)
            Tuple(elements):
                let values = list[TypeId]()
                for element in elements:
                    let item = self.contextual_type(element, generic_id, arguments, bound)
                    if item == none: return none
                    values.append(item)
                return self.state.intern_tuple(values)
            Function(parameters, result):
                let values = list[TypeId]()
                for parameter in parameters:
                    let item = self.contextual_type(parameter, generic_id, arguments, bound)
                    if item == none: return none
                    values.append(item)
                let result_type = self.contextual_type(result, generic_id, arguments, bound)
                if result_type == none: return none
                return self.state.intern_function_type(values, result_type)
            CFunction(parameters, result):
                let values = list[TypeId]()
                for parameter in parameters:
                    let item = self.contextual_type(parameter, generic_id, arguments, bound)
                    if item == none: return none
                    values.append(item)
                let result_type = self.contextual_type(result, generic_id, arguments, bound)
                if result_type == none: return none
                return self.state.intern_c_function_type(values, result_type)
            NativePointer(pointee, is_mutable):
                let inner = self.contextual_type(pointee, generic_id, arguments, bound)
                if inner == none: return none
                return self.state.intern_native_pointer(inner, is_mutable)
            else: return pattern

    # mark: Structural binding =================================================================

    ## Unify one abstract pattern with an actual checked type. Repeated uses
    ## of a parameter must agree exactly; optional patterns retain Luce's sole
    ## successful-value lift and may infer from either `T` or `T?`.
    pub func infer(pattern: TypeId, actual: TypeId, generic_id: u32, arguments: list[TypeId], bound: list[bool], span: SourceSpan) -> !:
        match self.state.types.definitions[pattern.value].form:
            TypeParameter(owner, position):
                if owner != generic_id:
                    if not types_match(pattern, actual): try self.mismatch(span, pattern, actual)
                    return
                if bound[position]:
                    if not types_match(arguments[position], actual): try self.mismatch(span, arguments[position], actual)
                else:
                    arguments[position] = actual
                    bound[position] = true
                return
            Optional(inner):
                match self.state.types.definitions[actual.value].form:
                    Optional(actual_inner): try self.infer(inner, actual_inner, generic_id, arguments, bound, span)
                    else: try self.infer(inner, actual, generic_id, arguments, bound, span)
                return
            Fallible(inner):
                match self.state.types.definitions[actual.value].form:
                    Fallible(actual_inner):
                        try self.infer(inner, actual_inner, generic_id, arguments, bound, span)
                        return
                    else: pass
            Slice(element):
                match self.state.types.definitions[actual.value].form:
                    Slice(actual_element):
                        try self.infer(element, actual_element, generic_id, arguments, bound, span)
                        return
                    else: pass
            List(element):
                match self.state.types.definitions[actual.value].form:
                    List(actual_element):
                        try self.infer(element, actual_element, generic_id, arguments, bound, span)
                        return
                    else: pass
            Weak(inner):
                match self.state.types.definitions[actual.value].form:
                    Weak(actual_inner):
                        try self.infer(inner, actual_inner, generic_id, arguments, bound, span)
                        return
                    else: pass
            Range(element):
                match self.state.types.definitions[actual.value].form:
                    Range(actual_element):
                        try self.infer(element, actual_element, generic_id, arguments, bound, span)
                        return
                    else: pass
            Array(element, count):
                match self.state.types.definitions[actual.value].form:
                    Array(actual_element, actual_count):
                        if count == actual_count:
                            try self.infer(element, actual_element, generic_id, arguments, bound, span)
                            return
                    else: pass
            Tuple(elements):
                match self.state.types.definitions[actual.value].form:
                    Tuple(actual_elements):
                        if len(elements) == len(actual_elements):
                            for index in range(0, len(elements)):
                                try self.infer(elements[index], actual_elements[index], generic_id, arguments, bound, span)
                            return
                    else: pass
            Function(parameters, result):
                match self.state.types.definitions[actual.value].form:
                    Function(actual_parameters, actual_result):
                        if len(parameters) == len(actual_parameters):
                            for index in range(0, len(parameters)):
                                try self.infer(parameters[index], actual_parameters[index], generic_id, arguments, bound, span)
                            try self.infer(result, actual_result, generic_id, arguments, bound, span)
                            return
                    else: pass
            CFunction(parameters, result):
                match self.state.types.definitions[actual.value].form:
                    CFunction(actual_parameters, actual_result):
                        if len(parameters) == len(actual_parameters):
                            for index in range(0, len(parameters)):
                                try self.infer(parameters[index], actual_parameters[index], generic_id, arguments, bound, span)
                            try self.infer(result, actual_result, generic_id, arguments, bound, span)
                            return
                    else: pass
            NativePointer(pointee, is_mutable):
                match self.state.types.definitions[actual.value].form:
                    NativePointer(actual_pointee, actual_mutable):
                        if is_mutable == actual_mutable:
                            try self.infer(pointee, actual_pointee, generic_id, arguments, bound, span)
                            return
                    else: pass
            else:
                if types_match(pattern, actual): return
        try self.mismatch(span, pattern, actual)

    # mark: Constraints ========================================================================

    pub func satisfies_constraint(value_type: TypeId, constraint: TypeId) -> bool:
        if self.state.find_conformance(value_type, constraint) >= 0: return true
        let inherited = self.constraints_of(value_type)
        if inherited != none:
            for available in inherited:
                if types_match(available, constraint): return true
        return false

    pub func constraints_of(value_type: TypeId) -> list[TypeId]?:
        match self.state.types.definitions[value_type.value].form:
            TypeParameter(generic_id, position):
                for generic in self.state.generic_functions:
                    if generic.generic_id == generic_id: return generic.type_parameters[position].constraints
                for contract in self.state.interfaces:
                    if contract.generic_id == generic_id: return contract.type_parameters[position].constraints
                return none
            else: return none

    func mismatch(span: SourceSpan, expected: TypeId, actual: TypeId) -> !:
        try self.state.fail_at(
            self.state.current_module,
            span,
            "generic argument requires `" + self.state.describe_type(expected) + "`, found `" + self.state.describe_type(actual) + "`",
        )
