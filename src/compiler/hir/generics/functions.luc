#==============================================================================================
#
#   generic_functions - Abstract checking and concrete generic-function instances
#
#   DESCRIPTION:
#       Owns generic callable lookup, structural inference, contextual
#       function values, abstract declaration probes, and memoized concrete
#       function/method specialization. It writes ordinary concrete
#       FunctionSymbols into the shared HIR generation transaction; MIR and
#       backends never see an abstract executable callable.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ArgumentSyntax, ExpressionSyntax, TypeArgumentSyntax
from compiler.hir.declarations import DeclarationCollector
from compiler.hir.generics.inference import GenericInference
from compiler.hir.generation_model import CollectedFunctionSource, FunctionSymbol, GenericFunctionInstance, GenericRequirementUse, HirGenerationState, HirSemanticChecker, TypeBinding
from compiler.hir.ir import BuiltinType, HirInterfaceRequirement, HirNodeForm, HirParameter, HirReceiver, HirReceiverKind, NodeId, Operands, SymbolId, SymbolKind, TypeForm, TypeId, no_node
from compiler.hir.ir import resolve_builtin_type, types_match

struct ResolvedRequirement:
    let requirement: HirInterfaceRequirement
    let interface_type: TypeId
    let requirement_index: i64

struct PreparedGenericCall:
    let function_index: i64
    let type_arguments: list[TypeId]
    let arguments: Operands

## Declaration/call-site facts that vary across free calls, nominal
## construction, and instance methods. Keeping them together makes argument
## inference one transaction without turning `prepare_call` into a list of
## loosely related positional controls.
struct GenericCallShape:
    let first_source_parameter: i64
    let explicit_parameter_start: i64
    let context_pattern: TypeId?
    let context_value: TypeId?
    let receiver: NodeId?
    let type_subject: str
    let call_subject: str
    let missing_subject: str
    let inference_subject: str

## Coordinates generic semantics with the ordinary body checker through the
## narrow operations that require expression or closure knowledge.
pub class GenericFunctionChecker:
    let state: HirGenerationState
    let declarations: DeclarationCollector
    let inference: GenericInference
    var probing: bool

    pub init(state: HirGenerationState, declarations: DeclarationCollector):
        self.state = state
        self.declarations = declarations
        self.inference = GenericInference(state)
        self.probing = false

    # mark: Abstract declaration checking ======================================================

    ## Validate every generic definition using only its declared abstract
    ## types. All probe artifacts are removed afterward, so only signature
    ## metadata retains abstract type identities.
    pub func check_templates(semantics: HirSemanticChecker) -> !:
        for generic in self.state.generic_functions:
            let type_count = len(self.state.types.definitions)
            let symbol_count = len(self.state.symbols)
            let function_count = len(self.state.functions)
            let instance_count = len(self.state.generic_instances)
            let conformance_count = len(self.state.conformances)
            let closure_count = len(self.state.closures)
            let shared_cell_count = len(self.state.shared_cells)
            let generated_function_count = len(self.state.generated_functions)
            let error_code_count = len(self.state.error_codes)
            let node_count = len(self.state.nodes)
            let extra_count = len(self.state.extra)
            let value_count = len(self.state.values)
            let next_symbol = self.state.next_symbol
            let closure_checkpoint = semantics.checkpoint_generic_closures()
            let saved_module = self.state.current_module
            let saved_module_bindings = self.state.bindings
            let saved_locals = self.state.locals
            let saved_result = self.state.current_result
            let saved_receiver = self.state.current_receiver
            let saved_loop_depth = self.state.loop_depth
            let saved_recovery_types = self.state.recovery_types
            let saved_type_bindings = self.state.current_type_bindings
            let saved_generic_origin = self.state.current_generic_origin

            self.declarations.enter_module(generic.module_index)
            self.state.current_type_bindings = generic.signature.type_bindings
            self.probing = true
            for index in range(0, len(generic.signature.parameters)):
                let default_syntax = generic.syntax.parameters[index].default_value
                if default_syntax != none:
                    discard(try semantics.check_constant_expression(
                        generic.module_index,
                        default_syntax,
                        generic.signature.parameters[index].value_type,
                        "default of parameter `" + generic.signature.parameters[index].name + "`",
                    ))
            discard(try semantics.check_function(generic.signature))

            while len(self.state.types.definitions) > type_count: self.state.types.definitions.remove(len(self.state.types.definitions) - 1)
            while len(self.state.symbols) > symbol_count: self.state.symbols.remove(len(self.state.symbols) - 1)
            while len(self.state.functions) > function_count: self.state.functions.remove(len(self.state.functions) - 1)
            while len(self.state.generic_instances) > instance_count: self.state.generic_instances.remove(len(self.state.generic_instances) - 1)
            while len(self.state.conformances) > conformance_count: self.state.conformances.remove(len(self.state.conformances) - 1)
            while len(self.state.closures) > closure_count: self.state.closures.remove(len(self.state.closures) - 1)
            while len(self.state.shared_cells) > shared_cell_count: self.state.shared_cells.remove(len(self.state.shared_cells) - 1)
            while len(self.state.generated_functions) > generated_function_count: self.state.generated_functions.remove(len(self.state.generated_functions) - 1)
            while len(self.state.error_codes) > error_code_count: self.state.error_codes.remove(len(self.state.error_codes) - 1)
            while len(self.state.nodes) > node_count:
                self.state.nodes.remove(len(self.state.nodes) - 1)
                self.state.node_types.remove(len(self.state.node_types) - 1)
                self.state.node_modules.remove(len(self.state.node_modules) - 1)
                self.state.node_spans.remove(len(self.state.node_spans) - 1)
            while len(self.state.extra) > extra_count: self.state.extra.remove(len(self.state.extra) - 1)
            while len(self.state.values) > value_count: self.state.values.remove(len(self.state.values) - 1)
            self.state.next_symbol = next_symbol
            semantics.restore_generic_closures(closure_checkpoint)
            self.state.current_module = saved_module
            self.state.bindings = saved_module_bindings
            self.state.locals = saved_locals
            self.state.current_result = saved_result
            self.state.current_receiver = saved_receiver
            self.state.loop_depth = saved_loop_depth
            self.state.recovery_types = saved_recovery_types
            self.state.current_type_bindings = saved_type_bindings
            self.state.current_generic_origin = saved_generic_origin
            self.probing = false

    # mark: Call resolution and inference =======================================================

    ## Resolve only free generic functions. Instance methods use declaration
    ## identity plus their applied receiver through `check_method_call` below.
    pub func resolve_callee(callee: ExpressionSyntax) -> i64!:
        match callee.form:
            Name(name):
                if self.state.find_local(name) >= 0: return -1
                return self.state.find_visible_generic_function(name)
            Member(owner, name):
                match owner.form:
                    Name(module_name):
                        if self.state.find_local(module_name) >= 0: return -1
                        let module_index = self.state.find_imported_module(module_name)
                        if module_index < 0: return -1
                        let generic_index = self.state.find_generic_function_in_module(module_index, name)
                        if generic_index < 0: return -1
                        if not self.state.generic_functions[generic_index].is_public:
                            try self.fail(callee.span, "`" + name + "` is private to module `" + self.state.sources[module_index].name + "`")
                        return generic_index
                    else: return -1
            else: return -1

    pub func check_call(semantics: HirSemanticChecker, generic_index: i64, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[generic_index]
        let prepared = try self.prepare_call(
            semantics,
            generic_index,
            type_arguments,
            arguments,
            GenericCallShape(
                first_source_parameter = 0,
                explicit_parameter_start = 0,
                context_pattern = none,
                context_value = none,
                receiver = none,
                type_subject = "generic function `" + generic.name + "`",
                call_subject = "function `" + generic.name + "`",
                missing_subject = "call to `" + generic.name + "`",
                inference_subject = generic.name,
            ),
            span,
        )
        let function = self.state.functions[prepared.function_index]
        let typed = self.state.push_node(HirNodeForm.Call(function = function.symbol, arguments = prepared.arguments), function.result, span)
        return try semantics.require_type_for_feature(typed, expected)

    ## Infer an independently generic method's declared suffix after binding
    ## its owner prefix from the already-checked receiver. Owner-only generic
    ## methods use the same path with an empty explicit suffix.
    pub func check_method_call(semantics: HirSemanticChecker, generic_index: i64, owner_type: TypeId, receiver: NodeId, name: str, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[generic_index]
        let method_receiver = generic.signature.receiver else trap("generic method template has no receiver")
        if method_receiver.kind == HirReceiverKind.type_function:
            try self.fail(callee_span, "`" + name + "` is a type function; call it as `" + self.state.describe_type(owner_type) + "." + name + "(...)`")
        if method_receiver.kind == HirReceiverKind.initializer:
            try self.fail(callee_span, "initializer `init` is called by constructing a `" + self.state.describe_type(owner_type) + "` value")
        if method_receiver.kind == HirReceiverKind.deinitializer:
            try self.fail(callee_span, "deinitializer `deinit` runs automatically at the final strong release and cannot be called directly")
        try self.require_method_visible(generic_index, owner_type, callee_span)
        if method_receiver.kind == HirReceiverKind.mutating_method:
            try semantics.require_mutable_receiver_for_feature(receiver, callee_span)

        let prepared = try self.prepare_call(
            semantics,
            generic_index,
            type_arguments,
            arguments,
            GenericCallShape(
                first_source_parameter = 1,
                explicit_parameter_start = generic.owner_parameter_count,
                context_pattern = method_receiver.owner,
                context_value = owner_type,
                receiver = receiver,
                type_subject = "generic method `" + name + "`",
                call_subject = "method `" + name + "`",
                missing_subject = "call to `" + name + "`",
                inference_subject = name,
            ),
            span,
        )
        let function = self.state.functions[prepared.function_index]
        let typed = self.state.push_node(HirNodeForm.Call(function = function.symbol, arguments = prepared.arguments), function.result, span)
        return try semantics.require_type_for_feature(typed, expected)

    ## Infer a type function's owner application from its arguments, explicit
    ## callable arguments, or result context. Type functions have no value
    ## receiver; their enclosing nominal parameters therefore occupy the
    ## entire generic signature rather than an already-applied prefix.
    pub func check_type_function_call(semantics: HirSemanticChecker, generic_index: i64, owner_type: TypeId, name: str, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[generic_index]
        let receiver = generic.signature.receiver else trap("generic type function has no nominal owner")
        if receiver.kind != HirReceiverKind.type_function: trap("non-type method reached type-function call checking")
        if generic.owner_parameter_count != len(generic.type_parameters):
            trap("type function declares independent generic parameters")
        try self.require_method_visible(generic_index, owner_type, callee_span)
        let prepared = try self.prepare_call(
            semantics,
            generic_index,
            type_arguments,
            arguments,
            GenericCallShape(
                first_source_parameter = 0,
                explicit_parameter_start = 0,
                context_pattern = generic.signature.result,
                context_value = self.type_function_result_context(generic.signature.result, expected),
                receiver = none,
                type_subject = "generic type function `" + name + "`",
                call_subject = "type function `" + name + "`",
                missing_subject = "call to `" + name + "`",
                inference_subject = name,
            ),
            span,
        )
        let function = self.state.functions[prepared.function_index]
        let typed = self.state.push_node(HirNodeForm.Call(function = function.symbol, arguments = prepared.arguments), function.result, span)
        return try semantics.require_type_for_feature(typed, expected)

    ## Optional and fallible result injection must not hide a nominal result
    ## context from owner-argument inference. Only unwrap when the inner value
    ## is an application of the same nominal pattern; a bare result parameter
    ## remains exact and therefore has no ambiguous `T` versus `T?` choice.
    func type_function_result_context(pattern: TypeId, expected: TypeId?) -> TypeId?:
        if expected == none: return none
        var contextual: TypeId = expected
        var changed = true
        while changed:
            changed = false
            let fallible = self.state.fallible_inner(contextual)
            if fallible != none and self.state.nominal_application_arguments(pattern, fallible) != none:
                contextual = fallible
                changed = true
                continue
            let optional = self.state.optional_inner(contextual)
            if optional != none and self.state.nominal_application_arguments(pattern, optional) != none:
                contextual = optional
                changed = true
        return contextual

    pub func require_method_visible(generic_index: i64, owner_type: TypeId, span: SourceSpan) -> !:
        let generic = self.state.generic_functions[generic_index]
        let owner_module = self.declarations.owner_module(owner_type)
        if owner_module != self.state.current_module and not generic.is_public:
            try self.fail(span, "`" + generic.name + "` is private to module `" + self.state.sources[owner_module].name + "`")

    ## Construct one generic struct or class through its specialized
    ## initializer. The initializer remains an ordinary generic callable,
    ## while this operation substitutes the successful result with the
    ## concrete nominal identity.
    pub func check_nominal_initializer(semantics: HirSemanticChecker, owner_name: str, owner_template: TypeId, generic_index: i64, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[generic_index]
        if generic.module_index != self.state.current_module and not generic.is_public:
            try self.fail(span, "initializer `init` is private to module `" + self.state.sources[generic.module_index].name + "`")
        var contextual = expected
        if contextual != none:
            let optional = self.state.optional_inner(contextual)
            if optional != none: contextual = optional
            let fallible = self.state.fallible_inner(contextual)
            if fallible != none: contextual = fallible
        let prepared = try self.prepare_call(
            semantics,
            generic_index,
            type_arguments,
            arguments,
            GenericCallShape(
                first_source_parameter = 1,
                explicit_parameter_start = 0,
                context_pattern = owner_template,
                context_value = contextual,
                receiver = none,
                type_subject = "type `" + owner_name + "`",
                call_subject = "initializer for `" + owner_name + "`",
                missing_subject = "construction of `" + owner_name + "`",
                inference_subject = owner_name,
            ),
            span,
        )
        let function = self.state.functions[prepared.function_index]
        let owner_type = self.state.substitute_type(owner_template, generic.generic_id, prepared.type_arguments)
        var construction_type = owner_type
        if self.state.fallible_inner(function.result) != none:
            construction_type = self.state.intern_fallible(owner_type)
        let typed = self.state.push_node(HirNodeForm.Initialize(function = function.symbol, arguments = prepared.arguments), construction_type, span)
        return try semantics.require_type_for_feature(typed, expected)

    ## Infer, specialize, and place one generic callable's source arguments.
    ## Construction skips its allocated `self`; a method supplies its already
    ## checked receiver. Both otherwise share the same labels, defaults,
    ## evaluation order, and conversion transaction as a free generic call.
    func prepare_call(semantics: HirSemanticChecker, generic_index: i64, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], shape: GenericCallShape, span: SourceSpan) -> PreparedGenericCall!:
        let generic = self.state.generic_functions[generic_index]
        let inferred = list[TypeId]()
        let bound = list[bool]()
        for parameter in generic.type_parameters:
            inferred.append(resolve_builtin_type(BuiltinType.unit))
            bound.append(false)
        if len(type_arguments) > 0:
            let explicit_count = len(generic.type_parameters) - shape.explicit_parameter_start
            if len(type_arguments) != explicit_count:
                try self.fail(span, shape.type_subject + " needs " + str(explicit_count) + " type argument(s), got " + str(len(type_arguments)))
            for index in range(0, len(type_arguments)):
                let parameter_index = shape.explicit_parameter_start + index
                match type_arguments[index]:
                    TypeArgument(value): inferred[parameter_index] = try self.declarations.resolve_type(self.state.current_module, value)
                    IntegerArgument(token): try self.fail(token.span, "generic callable type arguments must be types")
                bound[parameter_index] = true

        let context_pattern = shape.context_pattern
        let context_value = shape.context_value
        if context_pattern != none and context_value != none:
            try self.inference.infer(context_pattern, context_value, generic.generic_id, inferred, bound, span)

        let assigned = list[bool]()
        for parameter_index in range(0, len(generic.signature.parameters)):
            assigned.append(parameter_index < shape.first_source_parameter)
        let placed_parameters = list[i64]()
        let placed_nodes = list[NodeId]()
        var positional_index = shape.first_source_parameter
        var saw_named = false
        for argument in arguments:
            var parameter_index = -1
            let label = argument.label
            if label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                parameter_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                parameter_index = self.find_parameter(generic.signature, label)
                if parameter_index < shape.first_source_parameter:
                    try self.fail(argument.span, shape.call_subject + " has no parameter `" + label + "`")
            if parameter_index >= len(generic.signature.parameters):
                try self.fail(argument.span, shape.call_subject + " accepts " + str(len(generic.signature.parameters) - shape.first_source_parameter) + " argument(s)")
            if assigned[parameter_index]:
                try self.fail(argument.span, "parameter `" + generic.signature.parameters[parameter_index].name + "` is supplied more than once")
            assigned[parameter_index] = true
            let pattern = generic.signature.parameters[parameter_index].value_type
            let context = self.inference.contextual_type(pattern, generic.generic_id, inferred, bound)
            let checked = try semantics.check_expression_for_feature(argument.value, context)
            try self.inference.infer(pattern, self.state.type_of(checked), generic.generic_id, inferred, bound, argument.span)
            placed_parameters.append(parameter_index)
            placed_nodes.append(checked)

        for index in range(0, len(bound)):
            if not bound[index]:
                try self.fail(span, "cannot infer generic parameter `" + generic.type_parameters[index].name + "` of `" + shape.inference_subject + "`; supply explicit type arguments")

        let function_index = try self.instantiate(semantics, generic_index, inferred, span)
        let function = self.state.functions[function_index]
        let placed = list[u32]()
        let call_receiver = shape.receiver
        if call_receiver != none:
            let receiver = try semantics.require_type_for_feature(call_receiver, function.parameters[0].value_type)
            placed.append(0)
            placed.append(receiver.value)
        for index in range(0, len(placed_nodes)):
            let parameter_index = placed_parameters[index]
            let converted = try semantics.require_type_for_feature(placed_nodes[index], function.parameters[parameter_index].value_type)
            placed.append(u32(parameter_index))
            placed.append(converted.value)
        for parameter_index in range(shape.first_source_parameter, len(function.parameters)):
            if assigned[parameter_index]: continue
            let default_value = function.parameters[parameter_index].default_value
            if default_value.value == no_node:
                try self.fail(span, shape.missing_subject + " is missing argument `" + function.parameters[parameter_index].name + "`")
            placed.append(u32(parameter_index))
            placed.append(default_value.value)
        let copied_arguments = list[TypeId]()
        for argument in inferred: copied_arguments.append(argument)
        return PreparedGenericCall(
            function_index = function_index,
            type_arguments = copied_arguments,
            arguments = self.state.push_run(placed),
        )

    ## Infer a concrete specialization from an expected function type.
    pub func check_function_address(semantics: HirSemanticChecker, generic_index: i64, span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[generic_index]
        let needed = expected else error(self.state.diagnostic_at(self.state.current_module, span, "generic function `" + generic.name + "` needs a function type from context"))
        var callable = needed
        let optional = self.state.optional_inner(needed)
        if optional != none: callable = optional
        let expected_parameters = list[TypeId]()
        var expected_result = resolve_builtin_type(BuiltinType.unit)
        match self.state.types.definitions[callable.value].form:
            Function(parameters, result):
                for parameter in parameters: expected_parameters.append(parameter)
                expected_result = result
            CFunction(parameters, result):
                for parameter in parameters: expected_parameters.append(parameter)
                expected_result = result
            else: try self.fail(span, "generic function `" + generic.name + "` needs a function type from context")
        if len(expected_parameters) != len(generic.signature.parameters):
            try self.fail(span, "generic function `" + generic.name + "` has " + str(len(generic.signature.parameters)) + " parameter(s), expected " + str(len(expected_parameters)))
        let inferred = list[TypeId]()
        let bound = list[bool]()
        for parameter in generic.type_parameters:
            inferred.append(resolve_builtin_type(BuiltinType.unit))
            bound.append(false)
        for index in range(0, len(expected_parameters)):
            try self.inference.infer(generic.signature.parameters[index].value_type, expected_parameters[index], generic.generic_id, inferred, bound, span)
        try self.inference.infer(generic.signature.result, expected_result, generic.generic_id, inferred, bound, span)
        for index in range(0, len(bound)):
            if not bound[index]:
                try self.fail(span, "cannot infer generic parameter `" + generic.type_parameters[index].name + "` of `" + generic.name + "` from the expected function type")
        return try semantics.check_function_address_for_feature(try self.instantiate(semantics, generic_index, inferred, span), span, expected)

    ## Type-check a method selected from an abstract parameter's written
    ## constraints. The abstract decision is retained by source identity and
    ## replayed against the conformance during every concrete specialization.
    pub func check_requirement_call(semantics: HirSemanticChecker, owner_type: TypeId, receiver: NodeId, name: str, arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?) -> NodeId?!:
        if not self.probing and self.state.current_generic_origin >= 0:
            let use = self.find_requirement_use(self.state.current_generic_origin, callee_span)
            if use != none:
                return try self.check_concrete_requirement_call(semantics, use, receiver, name, arguments, callee_span, span, expected)
        let resolved = try self.find_requirement(owner_type, name, callee_span)
        if resolved == none: return none
        if self.probing and self.state.current_generic_origin >= 0:
            self.state.generic_requirement_uses.append(GenericRequirementUse(
                generic_index = self.state.current_generic_origin,
                span = callee_span,
                interface_type = resolved.interface_type,
                requirement_index = resolved.requirement_index,
            ))
        let abstract_result = self.interface_requirement_result(resolved.requirement, resolved.interface_type)
        return try self.check_requirement_arguments(semantics, resolved.requirement, resolved.interface_type, resolved.requirement.symbol, abstract_result, receiver, name, arguments, callee_span, span, expected)

    func check_concrete_requirement_call(semantics: HirSemanticChecker, use: GenericRequirementUse, receiver: NodeId, name: str, arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?) -> NodeId!:
        let generic = self.state.generic_functions[use.generic_index]
        let generic_arguments = list[TypeId]()
        for parameter in generic.type_parameters:
            var found = false
            for binding in self.state.current_type_bindings:
                if binding.name == parameter.name:
                    generic_arguments.append(binding.value_type)
                    found = true
                    break
            if not found: trap("concrete generic binding is missing")
        let interface_type = self.state.substitute_type(use.interface_type, generic.generic_id, generic_arguments)
        var interface_index = -1
        match self.state.types.definitions[interface_type.value].form:
            Interface(index, values): interface_index = index
            else: trap("concrete constraint is not an interface")
        let contract = self.state.interfaces[interface_index]
        let requirement = contract.requirements[use.requirement_index]
        let conformance_index = self.state.find_conformance(self.state.type_of(receiver), interface_type)
        if conformance_index < 0: trap("validated generic constraint has no conformance")
        let implementation_symbol = self.state.conformances[conformance_index].implementations[use.requirement_index]
        let required_result = self.interface_requirement_result(requirement, interface_type)
        let implementation_result = self.state.symbols[implementation_symbol.value].value_type
        return try self.check_requirement_arguments(semantics, requirement, interface_type, implementation_symbol, implementation_result, receiver, name, arguments, callee_span, span, expected, required_result)

    func check_requirement_arguments(semantics: HirSemanticChecker, requirement: HirInterfaceRequirement, interface_type: TypeId, function: SymbolId, call_result: TypeId, receiver: NodeId, name: str, arguments: list[ArgumentSyntax], callee_span: SourceSpan, span: SourceSpan, expected: TypeId?, required_result: TypeId? = none) -> NodeId!:
        var interface_index = -1
        let interface_arguments = list[TypeId]()
        match self.state.types.definitions[interface_type.value].form:
            Interface(index, values):
                interface_index = index
                for value in values: interface_arguments.append(value)
            else: trap("constraint requirement owner is not an interface")
        let contract = self.state.interfaces[interface_index]
        if requirement.is_mutating: try semantics.require_mutable_receiver_for_feature(receiver, callee_span)
        if len(arguments) != len(requirement.parameters):
            try self.fail(span, "interface method `" + name + "` accepts " + str(len(requirement.parameters)) + " argument(s), got " + str(len(arguments)))
        let placed = list[u32]()
        placed.append(0)
        placed.append(receiver.value)
        for index in range(0, len(arguments)):
            let parameter = requirement.parameters[index]
            let label = arguments[index].label
            if label != none and label != parameter.name:
                try self.fail(arguments[index].span, "interface method `" + name + "` has no parameter `" + label + "`")
            let parameter_type = self.state.substitute_type(parameter.value_type, contract.generic_id, interface_arguments)
            let checked = try semantics.check_expression_for_feature(arguments[index].value, parameter_type)
            placed.append(u32(index + 1))
            placed.append(checked.value)
        let call = self.state.push_node(HirNodeForm.Call(function = function, arguments = self.state.push_run(placed)), call_result, span)
        var adapted = call
        if required_result != none: adapted = try semantics.require_type_for_feature(call, required_result)
        return try semantics.require_type_for_feature(adapted, expected)

    func interface_requirement_result(requirement: HirInterfaceRequirement, interface_type: TypeId) -> TypeId:
        match self.state.types.definitions[interface_type.value].form:
            Interface(index, arguments): return self.state.substitute_type(requirement.result, self.state.interfaces[index].generic_id, arguments)
            else: trap("requirement owner is not an interface")

    func find_requirement(owner_type: TypeId, name: str, span: SourceSpan) -> ResolvedRequirement?!:
        let constraints = self.inference.constraints_of(owner_type)
        if constraints == none: return none
        var found: ResolvedRequirement? = none
        for constraint in constraints:
            var interface_index = -1
            match self.state.types.definitions[constraint.value].form:
                Interface(index, arguments): interface_index = index
                else: continue
            for requirement_index in range(0, len(self.state.interfaces[interface_index].requirements)):
                let requirement = self.state.interfaces[interface_index].requirements[requirement_index]
                if requirement.name != name: continue
                if found != none:
                    if not self.requirements_match(found, requirement, constraint):
                        try self.fail(span, "method `" + name + "` is ambiguous across generic constraints")
                    continue
                found = ResolvedRequirement(requirement = requirement, interface_type = constraint, requirement_index = requirement_index)
        return found

    func requirements_match(left: ResolvedRequirement, right: HirInterfaceRequirement, right_interface: TypeId) -> bool:
        if left.requirement.is_mutating != right.is_mutating: return false
        if len(left.requirement.parameters) != len(right.parameters): return false
        for index in range(0, len(right.parameters)):
            if left.requirement.parameters[index].name != right.parameters[index].name: return false
            let left_type = self.interface_requirement_parameter(left.requirement, left.interface_type, index)
            let right_type = self.interface_requirement_parameter(right, right_interface, index)
            if not types_match(left_type, right_type): return false
        return types_match(
            self.interface_requirement_result(left.requirement, left.interface_type),
            self.interface_requirement_result(right, right_interface),
        )

    func interface_requirement_parameter(requirement: HirInterfaceRequirement, interface_type: TypeId, index: i64) -> TypeId:
        match self.state.types.definitions[interface_type.value].form:
            Interface(interface_index, arguments):
                return self.state.substitute_type(requirement.parameters[index].value_type, self.state.interfaces[interface_index].generic_id, arguments)
            else: trap("requirement owner is not an interface")

    func find_requirement_use(generic_index: i64, span: SourceSpan) -> GenericRequirementUse?:
        for use in self.state.generic_requirement_uses:
            if use.generic_index == generic_index and self.spans_match(use.span, span): return use
        return none

    func spans_match(left: SourceSpan, right: SourceSpan) -> bool:
        return left.start == right.start and left.end == right.end and left.line == right.line and left.column == right.column

    # mark: Concrete instances =================================================================

    ## Select and memoize the method template for one applied nominal owner.
    ## The returned entry is an ordinary concrete function; no abstract type
    ## reaches MIR or either backend.
    pub func instantiate_method(semantics: HirSemanticChecker, owner_type: TypeId, name: str, span: SourceSpan) -> i64!:
        let generic_index = self.declarations.find_generic_method(owner_type, name)
        if generic_index < 0: return -1
        let generic = self.state.generic_functions[generic_index]
        # Lifecycle and interface-conformance callers have no method-call
        # syntax from which to infer an independently declared suffix.
        if generic.owner_parameter_count != len(generic.type_parameters): return -1
        let template_receiver = generic.signature.receiver else trap("generic method template has no receiver")
        let arguments = self.state.nominal_application_arguments(template_receiver.owner, owner_type)
        let checked_arguments = arguments else trap("generic method owner does not match its application")
        return try self.instantiate(semantics, generic_index, checked_arguments, span)

    func instantiate(semantics: HirSemanticChecker, generic_index: i64, arguments: list[TypeId], span: SourceSpan) -> i64!:
        let existing = self.state.find_generic_instance(generic_index, arguments)
        if existing >= 0: return existing
        if not self.probing and len(self.state.generic_instances) >= self.state.monomorphization_budget:
            try self.fail(span, "generic specialization budget of " + str(self.state.monomorphization_budget) + " was exceeded")
        let generic = self.state.generic_functions[generic_index]
        for index in range(0, len(generic.type_parameters)):
            for constraint in generic.type_parameters[index].constraints:
                let required = self.state.substitute_type(constraint, generic.generic_id, arguments)
                if not try self.declarations.type_satisfies_interface(semantics, arguments[index], required, span):
                    try self.fail(span, "type `" + self.state.describe_type(arguments[index]) + "` does not conform to `" + self.state.describe_type(required) + "` required by `" + generic.type_parameters[index].name + "`")
        let bindings = list[TypeBinding]()
        var specialized_name = generic.name + "["
        for index in range(0, len(arguments)):
            if index > 0: specialized_name = specialized_name + ", "
            specialized_name = specialized_name + self.state.describe_type(arguments[index])
            bindings.append(TypeBinding(name = generic.type_parameters[index].name, value_type = arguments[index]))
        specialized_name = specialized_name + "]"

        let saved_bindings = self.state.current_type_bindings
        self.state.current_type_bindings = bindings
        let parameters = list[HirParameter]()
        for index in range(0, len(generic.signature.parameters)):
            let template_parameter = generic.signature.parameters[index]
            let value_type = self.state.substitute_type(template_parameter.value_type, generic.generic_id, arguments)
            var default_value = NodeId(value = no_node)
            let default_syntax = generic.syntax.parameters[index].default_value
            if default_syntax != none:
                default_value = try semantics.check_constant_expression(generic.module_index, default_syntax, value_type, "default of parameter `" + template_parameter.name + "`")
            parameters.append(HirParameter(
                symbol = self.state.make_symbol(template_parameter.name, SymbolKind.parameter, value_type),
                name = template_parameter.name,
                value_type = value_type,
                default_value = default_value,
            ))
        let result = self.state.substitute_type(generic.signature.result, generic.generic_id, arguments)
        let symbol = self.state.make_symbol(specialized_name, SymbolKind.function, result)
        var receiver: HirReceiver? = none
        let template_receiver = generic.signature.receiver
        if template_receiver != none:
            let checked_receiver = template_receiver
            receiver = HirReceiver(
                owner = self.state.substitute_type(checked_receiver.owner, generic.generic_id, arguments),
                kind = checked_receiver.kind,
            )
        var function_name = specialized_name
        if receiver != none: function_name = generic.name
        let function_index = len(self.state.functions)
        self.state.functions.append(FunctionSymbol(
            symbol = symbol,
            module_index = generic.module_index,
            name = function_name,
            is_public = false,
            documentation = generic.documentation,
            receiver = receiver,
            parameters = parameters,
            result = result,
            source = CollectedFunctionSource.Defined(syntax = generic.syntax),
            span = generic.span,
            generic_origin = generic_index,
            type_bindings = bindings,
        ))
        let key_arguments = list[TypeId]()
        for argument in arguments: key_arguments.append(argument)
        self.state.generic_instances.append(GenericFunctionInstance(generic_index = generic_index, arguments = key_arguments, function_index = function_index))
        self.state.current_type_bindings = saved_bindings
        return function_index

    func find_parameter(function: FunctionSymbol, name: str) -> i64:
        for index in range(0, len(function.parameters)):
            if function.parameters[index].name == name: return index
        return -1

    func fail(span: SourceSpan, message: str) -> !:
        try self.state.fail_at(self.state.current_module, span, message)
