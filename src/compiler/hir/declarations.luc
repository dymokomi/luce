#==============================================================================================
#
#   declarations - Program-wide source declaration collection
#
#   DESCRIPTION:
#       Registers module names, imports, aliases, constants, globals, callable
#       signatures, nominal types, and sealed-runtime bindings before any
#       function body is checked. Every identity is written into the one
#       HirGenerationState shared with body checking. Only constant default
#       expressions cross that boundary, through HirSemanticChecker.
#
#==============================================================================================

from compiler.profile import Profile, belongs_to_full_luce, profile_of
from compiler.core_types import is_core_type_name, is_reserved_core_name
from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ConstantSyntax, EnumCaseSyntax, EnumSyntax, ExportEnumCaseSyntax, ExportEnumSyntax, ExportStructSyntax, ExternFunctionSyntax, ExternStructSyntax, ExternTypeSyntax, ExternVariableSyntax, FieldSyntax, FunctionSyntax, GenericParameterSyntax, InterfaceSyntax, NominalTypeKind, NominalTypeSyntax
from compiler.frontend.syntax import NamedTypeSyntax, PathSyntax, RuntimeGlobalSyntax, TypeAliasSyntax, TypeArgumentSyntax, TypeMemberKind, TypeMemberSyntax, TypeSyntax
from compiler.hir.ir import BuiltinType, HirCEnum, HirCFunction, HirCSlot, HirCStructKind, HirConformance, HirConformanceAdaptation, HirEnumCase, HirExternRepresentation, HirField, HirFunction, HirFunctionImplementation, HirInterfaceOrigin, HirInterfaceRequirement, HirNodeForm, HirParameter, HirPayloadField, HirReceiver, HirReceiverKind, HirTypeParameter
from compiler.hir.ir import HirRuntimeBinding, ModuleAuthority, ModuleId, NodeId, PackageRole, StandardInterface, SymbolId, SymbolKind, TypeForm, TypeId, no_node
from compiler.hir.ir import Value, integer_maximum, integer_minimum, integer_values_match, is_integer_type, is_unsigned_integer_type, resolve_builtin_type, types_match, unsigned_integer_maximum
from compiler.hir.generation_model import CollectedAlias, CollectedClass, CollectedConstant, CollectedEnum, CollectedExternType, CollectedExternVariable, CollectedFunctionSource, CollectedInterface, CollectedNominalCallable
from compiler.hir.generation_model import CollectedGlobal, CollectedStruct, CollectedStructSource, FunctionSymbol, GenericConformanceTemplate, GenericFunctionTemplate, HirGenerationState, HirSemanticChecker, ImportedModule
from compiler.hir.generation_model import ImportedBinding, ModuleBindings, PendingGenericApplication, builtin_type_id
from compiler.hir.generation_model import TypeBinding, collected_struct_is_exported, collected_struct_is_extern
from compiler.hir.interfaces.standard import ensure_standard_interface, standard_interface_element, standard_interface_named, standard_interface_of, standard_interfaces_share_role

## One declaration-wide abstract type scope. Interfaces and nominal types use
## the same identity and duplicate-name rules; constraints resolve only after
## every nominal and interface name exists.
struct DeclaredTypeParameters:
    let generic_id: u32
    let parameters: list[HirTypeParameter]
    let bindings: list[TypeBinding]

union NominalTypeDeclaration:
    StructType(index: i64)
    ClassType(index: i64)
    EnumType(index: i64)

struct ConformanceMaterialization:
    let value_type: TypeId
    let interface_type: TypeId

# Normalize the raw C-friendly field spelling into the ordinary struct member
# model. From this point onward the external role is only a boundary
# capability; source and semantic member behavior have one implementation.
func extern_struct_nominal(syntax: ExternStructSyntax) -> NominalTypeSyntax:
    return NominalTypeSyntax(
        kind = NominalTypeKind.struct_type,
        name = syntax.name,
        generic_parameters = list[GenericParameterSyntax](),
        interfaces = syntax.interfaces,
        members = syntax.members,
    )

func export_struct_nominal(syntax: ExportStructSyntax) -> NominalTypeSyntax:
    let members = list[TypeMemberSyntax]()
    for item in syntax.fields:
        members.append(TypeMemberSyntax(
            documentation = item.documentation,
            is_public = true,
            value = TypeMemberKind.Field(value = FieldSyntax(
                is_weak = false,
                is_mutable = false,
                name = item.name,
                value_type = item.value_type,
                default_value = none,
                span = item.span,
            )),
            span = item.span,
        ))
    return NominalTypeSyntax(
        kind = NominalTypeKind.struct_type,
        name = syntax.name,
        generic_parameters = list[GenericParameterSyntax](),
        interfaces = list[TypeSyntax](),
        members = members,
    )

func export_enum_nominal(syntax: ExportEnumSyntax) -> EnumSyntax:
    let cases = list[EnumCaseSyntax]()
    for item in syntax.cases:
        cases.append(EnumCaseSyntax(
            documentation = item.documentation,
            name = item.name,
            payload = list[NamedTypeSyntax](),
            span = item.span,
        ))
    return EnumSyntax(
        name = syntax.name,
        generic_parameters = list[GenericParameterSyntax](),
        interfaces = list[TypeSyntax](),
        cases = cases,
        methods = list[TypeMemberSyntax](),
    )

## Collects every program-wide source identity into one generation transaction.
pub class DeclarationCollector:
    let state: HirGenerationState
    let materializing_conformances: list[ConformanceMaterialization]

    pub init(state: HirGenerationState):
        self.state = state
        self.materializing_conformances = list[ConformanceMaterialization]()

    # mark: Runtime binding validation ==========================================================
    pub func resolve_runtime_bindings() -> list[HirRuntimeBinding]!:
        let bindings = list[HirRuntimeBinding]()
        if len(self.state.runtime_binding_requests) > 0 and self.state.package_role != PackageRole.sealed_runtime:
            error("runtime service bindings require the sealed runtime package role")
        for request in self.state.runtime_binding_requests:
            for existing in bindings:
                if existing.service == request.service:
                    error("duplicate runtime binding for `" + str(request.service) + "`")
            let module_index = self.state.find_source(request.module_name)
            if module_index < 0:
                error("runtime binding `" + str(request.service) + "` names missing module `" + request.module_name + "`")
            let function_index = self.state.find_function_in_module(module_index, request.function_name)
            if function_index < 0:
                error("runtime binding `" + str(request.service) + "` names missing function `" + request.module_name + "." + request.function_name + "`")
            let function = self.state.functions[function_index]
            if function.is_public or self.state.modules[module_index].authority != ModuleAuthority.native:
                try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must name a private native function")
            match function.source:
                Defined(syntax): pass
                else: try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must name a Luce definition")
            match request.service:
                storage_allocator:
                    if not self.is_storage_allocator(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `storage_allocator` must have signature `(u64, u64) -> native_mut_ptr[u8]`")
                storage_deallocator:
                    if not self.is_storage_deallocator(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `storage_deallocator` must have signature `(native_mut_ptr[u8], u64, u64) -> unit`")
                equality_context_create, hash_create, list_create, buffer_builder_create:
                    if not self.is_list_create(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `() -> native_mut_ptr[u8]`")
                equality_context_release, hash_retain, list_retain, slice_retain:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> unit`")
                equality_context_visit:
                    if not self.is_equality_context_visit(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `equality_context_visit` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], native_mut_ptr[u8]) -> bool`")
                hash_release:
                    if not self.is_hash_service(function, 4, 2, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `hash_release` must have signature `(native_mut_ptr[u8], u64, u64, u64, u64, func(native_mut_ptr[u8]) -> unit, func(native_mut_ptr[u8]) -> unit) -> unit`")
                hash_copy:
                    if not self.is_hash_service(function, 4, 2, 1):
                        try self.state.fail_at(module_index, function.span, "runtime binding `hash_copy` must have signature `(native_mut_ptr[u8], u64, u64, u64, u64, func(native_mut_ptr[u8]) -> unit, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
                hash_length, hash_iteration_begin:
                    if not self.is_list_length(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> u64`")
                hash_iteration_end:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `hash_iteration_end` must have signature `(native_mut_ptr[u8]) -> unit`")
                hash_find_first, hash_find_next, hash_entry_hash:
                    if not self.is_string_u64_service(function, 1):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64) -> u64`")
                hash_key_address, hash_value_address:
                    if not self.is_list_pointer_service(function, 2):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64) -> native_mut_ptr[u8]`")
                hash_insert_entry:
                    if not self.is_hash_service(function, 5, 0, 2):
                        try self.state.fail_at(module_index, function.span, "runtime binding `hash_insert_entry` must have signature `(native_mut_ptr[u8], u64, u64, u64, u64, u64) -> u64`")
                hash_remove_entry, hash_reserve:
                    if not self.is_hash_service(function, 5, 0, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64, u64, u64, u64) -> unit`")
                hash_clear:
                    if not self.is_hash_service(function, 4, 2, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `hash_clear` must have signature `(native_mut_ptr[u8], u64, u64, u64, u64, func(native_mut_ptr[u8]) -> unit, func(native_mut_ptr[u8]) -> unit) -> unit`")
                list_release, slice_release:
                    if not self.is_list_action_service(function, 1, 2, false):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
                list_copy, list_mutable_slice_begin:
                    if not self.is_list_action_service(function, 1, 2, true):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
                list_concat:
                    if not self.is_list_action_service(function, 2, 2, true):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_concat` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
                list_length, list_iteration_begin, slice_length:
                    if not self.is_list_length(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> u64`")
                list_iteration_active:
                    if not self.is_list_bool_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_iteration_active` must have signature `(native_mut_ptr[u8]) -> bool`")
                list_append_slot:
                    if not self.is_list_action_service(function, 1, 2, true):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_append_slot` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
                list_element_address, slice_element_address:
                    if not self.is_list_pointer_service(function, 2):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64) -> native_mut_ptr[u8]`")
                list_insert_slot, list_mutable_element_address:
                    if not self.is_list_action_service(function, 1, 3, true):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
                list_slice:
                    if not self.is_list_pointer_service(function, 3):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8], u64, u64, u64) -> native_mut_ptr[u8]`")
                buffer_retain, buffer_release:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> unit`")
                buffer_concat:
                    if not self.is_buffer_concat_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `buffer_concat` must have signature `(native_mut_ptr[u8], u64, native_mut_ptr[u8], u64) -> native_mut_ptr[u8]`")
                buffer_data:
                    if not self.is_list_pointer_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `buffer_data` must have signature `(native_mut_ptr[u8]) -> native_mut_ptr[u8]`")
                buffer_length:
                    if not self.is_list_length(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `buffer_length` must have signature `(native_mut_ptr[u8]) -> u64`")
                buffer_builder_append:
                    if not self.is_buffer_builder_append_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `buffer_builder_append` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], u64) -> unit`")
                buffer_builder_finish, c_string_copy:
                    if not self.is_list_pointer_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> native_mut_ptr[u8]`")
                display_signed:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.signed_i64)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_signed` must have signature `(i64) -> native_mut_ptr[u8]`")
                display_unsigned:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.unsigned_u64)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_unsigned` must have signature `(u64) -> native_mut_ptr[u8]`")
                display_float32:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.float32)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_float32` must have signature `(f32) -> native_mut_ptr[u8]`")
                display_float64:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.float64)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_float64` must have signature `(f64) -> native_mut_ptr[u8]`")
                display_character:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.unsigned_u32)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_character` must have signature `(u32) -> native_mut_ptr[u8]`")
                display_boolean:
                    if not self.is_scalar_display_service(function, resolve_builtin_type(BuiltinType.boolean)):
                        try self.state.fail_at(module_index, function.span, "runtime binding `display_boolean` must have signature `(bool) -> native_mut_ptr[u8]`")
                string_scalar_count:
                    if not self.is_string_u64_service(function, 1):
                        try self.state.fail_at(module_index, function.span, "runtime binding `string_scalar_count` must have signature `(native_mut_ptr[u8], u64) -> u64`")
                string_decode:
                    if not self.is_string_u64_service(function, 2):
                        try self.state.fail_at(module_index, function.span, "runtime binding `string_decode` must have signature `(native_mut_ptr[u8], u64, u64) -> u64`")
                bytes_slice:
                    if not self.is_bytes_slice_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `bytes_slice` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], u64, u64) -> native_mut_ptr[u8]`")
                list_remove_at:
                    if not self.is_list_action_service(function, 1, 3, false):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_remove_at` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
                list_clear:
                    if not self.is_list_action_service(function, 1, 2, false):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_clear` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
                list_iteration_end:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> unit`")
                list_reserve:
                    if not self.is_list_action_service(function, 1, 3, false):
                        try self.state.fail_at(module_index, function.span, "runtime binding `list_reserve` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
                class_create:
                    if not self.is_class_create_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `class_create` must have signature `(u64, u64, func(native_mut_ptr[u8], bool) -> unit) -> native_mut_ptr[u8]`")
                class_mark_initialized, class_retain, class_release, weak_class_retain, weak_class_release:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> unit`")
                class_payload, weak_class_create, weak_class_promote:
                    if not self.is_list_pointer_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> native_mut_ptr[u8]`")
                interface_create:
                    if not self.is_interface_create_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `interface_create` must have signature `(native_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit, func(native_mut_ptr[u8]) -> unit, native_ptr[native_ptr[u8]]) -> native_mut_ptr[u8]`")
                interface_retain, interface_release:
                    if not self.is_list_unit_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> unit`")
                interface_detach, interface_payload:
                    if not self.is_list_pointer_service(function, 0):
                        try self.state.fail_at(module_index, function.span, "runtime binding `" + str(request.service) + "` must have signature `(native_mut_ptr[u8]) -> native_mut_ptr[u8]`")
                interface_witness:
                    if not self.is_interface_witness_service(function):
                        try self.state.fail_at(module_index, function.span, "runtime binding `interface_witness` must have signature `(native_mut_ptr[u8], u64) -> native_ptr[u8]`")
            bindings.append(HirRuntimeBinding(service = request.service, function = function.symbol))
        return bindings

    func is_storage_allocator(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 2: return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        if not types_match(function.parameters[0].value_type, u64_type) or not types_match(function.parameters[1].value_type, u64_type): return false
        if function.parameters[0].default_value.value != no_node or function.parameters[1].default_value.value != no_node: return false
        match self.state.types.definitions[function.result.value].form:
            NativePointer(pointee, is_mutable):
                return is_mutable and types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8))
            else: return false

    func is_storage_deallocator(function: FunctionSymbol) -> bool:
        return self.has_byte_pointer_parameters(function, 2) and types_match(function.result, resolve_builtin_type(BuiltinType.unit))

    func is_list_create(function: FunctionSymbol) -> bool:
        return function.receiver == none and len(function.parameters) == 0 and self.is_mutable_byte_pointer(function.result)

    func is_list_length(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 1: return false
        let value = function.parameters[0]
        return value.default_value.value == no_node and self.is_mutable_byte_pointer(value.value_type) and types_match(function.result, resolve_builtin_type(BuiltinType.unsigned_u64))

    func is_string_u64_service(function: FunctionSymbol, u64_count: i64) -> bool:
        return self.has_byte_pointer_parameters(function, u64_count) and types_match(function.result, resolve_builtin_type(BuiltinType.unsigned_u64))

    func is_list_bool_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 1: return false
        let value = function.parameters[0]
        return value.default_value.value == no_node and self.is_mutable_byte_pointer(value.value_type) and types_match(function.result, resolve_builtin_type(BuiltinType.boolean))

    func is_equality_context_visit(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 3: return false
        for parameter in function.parameters:
            if parameter.default_value.value != no_node or not self.is_mutable_byte_pointer(parameter.value_type): return false
        return types_match(function.result, resolve_builtin_type(BuiltinType.boolean))

    func is_list_action_service(function: FunctionSymbol, pointer_count: i64, u64_count: i64, returns_pointer: bool) -> bool:
        if function.receiver != none or len(function.parameters) != pointer_count + u64_count + 1: return false
        for index in range(0, pointer_count):
            if function.parameters[index].default_value.value != no_node or not self.is_mutable_byte_pointer(function.parameters[index].value_type): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        for index in range(pointer_count, pointer_count + u64_count):
            if not self.is_plain_parameter(function.parameters[index], u64_type): return false
        let action = function.parameters[len(function.parameters) - 1]
        if action.default_value.value != no_node or not self.is_element_action(action.value_type): return false
        if returns_pointer: return self.is_mutable_byte_pointer(function.result)
        return types_match(function.result, resolve_builtin_type(BuiltinType.unit))

    # `result_kind`: 0 unit, 1 mutable byte pointer, 2 u64.
    func is_hash_service(function: FunctionSymbol, u64_count: i64, action_count: i64, result_kind: i64) -> bool:
        if function.receiver != none or len(function.parameters) != 1 + u64_count + action_count: return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[0]): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        for index in range(1, 1 + u64_count):
            if not self.is_plain_parameter(function.parameters[index], u64_type): return false
        for index in range(1 + u64_count, len(function.parameters)):
            let action = function.parameters[index]
            if action.default_value.value != no_node or not self.is_element_action(action.value_type): return false
        if result_kind == 1: return self.is_mutable_byte_pointer(function.result)
        if result_kind == 2: return types_match(function.result, u64_type)
        return types_match(function.result, resolve_builtin_type(BuiltinType.unit))

    func is_element_action(value_type: TypeId) -> bool:
        match self.state.types.definitions[value_type.value].form:
            Function(parameters, result):
                return len(parameters) == 1 and self.is_mutable_byte_pointer(parameters[0]) and types_match(result, resolve_builtin_type(BuiltinType.unit))
            else: return false

    func is_class_create_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 3 or not self.is_mutable_byte_pointer(function.result): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        if not self.is_plain_parameter(function.parameters[0], u64_type): return false
        if not self.is_plain_parameter(function.parameters[1], u64_type): return false
        let callback = function.parameters[2]
        if callback.default_value.value != no_node: return false
        match self.state.types.definitions[callback.value_type.value].form:
            Function(parameters, result):
                return (
                    len(parameters) == 2
                    and self.is_mutable_byte_pointer(parameters[0])
                    and types_match(parameters[1], resolve_builtin_type(BuiltinType.boolean))
                    and types_match(result, resolve_builtin_type(BuiltinType.unit))
                )
            else: return false

    func is_interface_create_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 6 or not self.is_mutable_byte_pointer(function.result): return false
        if not self.is_plain_const_byte_pointer_parameter(function.parameters[0]): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        if not self.is_plain_parameter(function.parameters[1], u64_type): return false
        if not self.is_plain_parameter(function.parameters[2], u64_type): return false
        if function.parameters[3].default_value.value != no_node or not self.is_element_action(function.parameters[3].value_type): return false
        if function.parameters[4].default_value.value != no_node or not self.is_element_action(function.parameters[4].value_type): return false
        let witnesses = function.parameters[5]
        if witnesses.default_value.value != no_node: return false
        match self.state.types.definitions[witnesses.value_type.value].form:
            NativePointer(pointee, is_mutable):
                if is_mutable: return false
                match self.state.types.definitions[pointee.value].form:
                    NativePointer(element, element_is_mutable):
                        return not element_is_mutable and types_match(element, resolve_builtin_type(BuiltinType.unsigned_u8))
                    else: return false
            else: return false

    func is_interface_witness_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 2: return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[0]): return false
        if not self.is_plain_parameter(function.parameters[1], resolve_builtin_type(BuiltinType.unsigned_u64)): return false
        match self.state.types.definitions[function.result.value].form:
            NativePointer(pointee, is_mutable):
                return not is_mutable and types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8))
            else: return false

    func has_byte_pointer_parameters(function: FunctionSymbol, u64_count: i64) -> bool:
        if function.receiver != none or len(function.parameters) != u64_count + 1: return false
        if function.parameters[0].default_value.value != no_node or not self.is_mutable_byte_pointer(function.parameters[0].value_type): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        for index in range(1, len(function.parameters)):
            if not self.is_plain_parameter(function.parameters[index], u64_type): return false
        return true

    func is_list_pointer_service(function: FunctionSymbol, u64_count: i64) -> bool:
        return self.has_byte_pointer_parameters(function, u64_count) and self.is_mutable_byte_pointer(function.result)

    func is_buffer_concat_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 4 or not self.is_mutable_byte_pointer(function.result): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        if not self.is_plain_byte_pointer_parameter(function.parameters[0]): return false
        if not self.is_plain_parameter(function.parameters[1], u64_type): return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[2]): return false
        return self.is_plain_parameter(function.parameters[3], u64_type)

    func is_buffer_builder_append_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 3: return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[0]): return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[1]): return false
        if not self.is_plain_parameter(function.parameters[2], resolve_builtin_type(BuiltinType.unsigned_u64)): return false
        return types_match(function.result, resolve_builtin_type(BuiltinType.unit))

    func is_scalar_display_service(function: FunctionSymbol, value_type: TypeId) -> bool:
        if function.receiver != none or len(function.parameters) != 1: return false
        return self.is_plain_parameter(function.parameters[0], value_type) and self.is_mutable_byte_pointer(function.result)

    func is_bytes_slice_service(function: FunctionSymbol) -> bool:
        if function.receiver != none or len(function.parameters) != 4 or not self.is_mutable_byte_pointer(function.result): return false
        let u64_type = resolve_builtin_type(BuiltinType.unsigned_u64)
        if not self.is_plain_byte_pointer_parameter(function.parameters[0]): return false
        if not self.is_plain_byte_pointer_parameter(function.parameters[1]): return false
        if not self.is_plain_parameter(function.parameters[2], u64_type): return false
        return self.is_plain_parameter(function.parameters[3], u64_type)

    func is_plain_byte_pointer_parameter(parameter: HirParameter) -> bool:
        return parameter.default_value.value == no_node and self.is_mutable_byte_pointer(parameter.value_type)

    func is_plain_const_byte_pointer_parameter(parameter: HirParameter) -> bool:
        if parameter.default_value.value != no_node: return false
        match self.state.types.definitions[parameter.value_type.value].form:
            NativePointer(pointee, is_mutable):
                return not is_mutable and types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8))
            else: return false

    func is_list_unit_service(function: FunctionSymbol, u64_count: i64) -> bool:
        return self.has_byte_pointer_parameters(function, u64_count) and types_match(function.result, resolve_builtin_type(BuiltinType.unit))

    func is_plain_parameter(parameter: HirParameter, expected: TypeId) -> bool:
        return parameter.default_value.value == no_node and types_match(parameter.value_type, expected)

    func is_mutable_byte_pointer(value_type: TypeId) -> bool:
        match self.state.types.definitions[value_type.value].form:
            NativePointer(pointee, is_mutable): return is_mutable and types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8))
            else: return false

    # mark: Modules and imports =================================================================

    # Two files may not claim the same module name; the second one loses.
    pub func validate_module_names() -> !:
        for index in range(0, len(self.state.modules)):
            for previous in range(0, index):
                if self.state.modules[previous].name == self.state.modules[index].name:
                    if index < len(self.state.sources):
                        try self.state.fail_at(index, self.state.sources[index].syntax.span, "duplicate module `" + self.state.modules[index].name + "`")
                    error("typed package import: duplicate module `" + self.state.modules[index].name + "`")

    # `mutating` describes replacement of a value receiver. Module functions
    # have no receiver, while classes already mutate through shared identity;
    # structs, enums, and interface requirements retain the modifier.
    pub func validate_mutating_placements() -> !:
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    Function(function):
                        if function.is_mutating:
                            try self.state.fail_at(module_index, declaration.span, "`mutating` is valid only on value-type methods")
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            for member in nominal.members:
                                match member.value:
                                    Function(function):
                                        if function.is_mutating:
                                            try self.state.fail_at(module_index, member.span, "class methods do not use `mutating`; class identity already permits field mutation")
                                    else: pass
                    else: pass

    # Native authority permits implementation details, never an API leak.
    # Following structural values here prevents a public wrapper from hiding a
    # raw pointer inside an alias, tuple, function value, struct, or enum.
    pub func validate_native_boundaries() -> !:
        for item in self.state.aliases:
            let resolved = item.resolved else trap("alias was not resolved")
            if item.is_public and self.state.contains_native_pointer(resolved):
                try self.state.fail_at(item.module_index, item.span, "public type alias `" + item.name + "` cannot expose native pointers")
        for item in self.state.structs:
            if not item.is_public: continue
            for field in item.fields:
                if self.state.contains_native_pointer(field.value_type):
                    try self.state.fail_at(item.module_index, item.span, "public struct `" + item.name + "` cannot store native pointers")
        for item in self.state.classes:
            if not item.is_public: continue
            for field in item.fields:
                if field.is_public and self.state.contains_native_pointer(field.value_type):
                    try self.state.fail_at(item.module_index, item.span, "public class `" + item.name + "` cannot expose native pointers")
        for item in self.state.enums:
            if not item.is_public: continue
            for case_value in item.cases:
                for field in case_value.payload:
                    if self.state.contains_native_pointer(field.value_type):
                        try self.state.fail_at(item.module_index, item.span, "public enum `" + item.name + "` cannot store native pointers")
        for function in self.state.functions:
            if not function.is_public: continue
            for parameter in function.parameters:
                if self.state.contains_native_pointer(parameter.value_type):
                    try self.state.fail_at(function.module_index, function.span, "public function `" + function.name + "` cannot expose native pointers")
            if self.state.contains_native_pointer(function.result):
                try self.state.fail_at(function.module_index, function.span, "public function `" + function.name + "` cannot expose native pointers")


    # mark: Signature collection ================================================================

    # Declaration identity is order-independent. Nominal/interface names are
    # needed by aliases, then every alias name is needed before any signature
    # may resolve one. Bodies remain a later transaction in HirBodyChecker.
    pub func collect_declarations(checker: HirSemanticChecker) -> !:
        # Nominal names first, so an alias anywhere may name a struct, class,
        # enum, interface, or extern type declared later in the package.
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    InterfaceType(interface_type):
                        try self.collect_interface_name(module_index, declaration.is_public, declaration.documentation, interface_type, declaration.span)
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            try self.collect_class_name(module_index, declaration.is_public, declaration.documentation, nominal, declaration.span)
                        else:
                            try self.collect_struct_name(module_index, declaration.is_public, declaration.documentation, nominal, declaration.span)
                    Enumeration(enumeration):
                        try self.collect_enum_name(module_index, declaration.is_public, declaration.documentation, enumeration, declaration.span)
                    ExportStruct(export_struct):
                        try self.collect_export_struct_name(module_index, declaration.documentation, export_struct, declaration.span)
                    ExportEnum(export_enum):
                        try self.collect_enum_name(module_index, true, declaration.documentation, export_enum_nominal(export_enum), declaration.span)
                    ExternType(extern_type):
                        try self.collect_extern_type_name(module_index, declaration.is_public, declaration.documentation, extern_type, declaration.span)
                    ExternStruct(extern_struct):
                        try self.collect_extern_struct_name(module_index, declaration.is_public, declaration.documentation, extern_struct, declaration.span)
                    else: pass

        # Fixed C enum values are part of the declaration's boundary identity,
        # not its body. Publish every map before any callable signature is
        # checked so C declarations remain order-independent like Luce ones.
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    ExportEnum(export_enum): try self.collect_export_enum_shape(module_index, export_enum)
                    else: pass

        # Alias and constant identities precede every typed signature. Alias
        # targets still resolve lazily, which permits forward alias chains and
        # lets the one recursion guard diagnose cycles precisely.
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    Constant(constant):
                        try self.collect_constant(module_index, declaration.is_public, constant, declaration.span)
                    TypeAlias(type_alias):
                        try self.collect_alias(module_index, declaration.is_public, declaration.documentation, type_alias, declaration.span)
                    else: pass

        # Interface signatures precede functions and nominal members so
        # constraints and `implements` clauses may refer forward across the
        # entire package, including through aliases.
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    InterfaceType(interface_type):
                        try self.collect_interface_requirements(module_index, interface_type)
                    else: pass
        for module_index in range(0, len(self.state.sources)):
            for declaration in self.state.sources[module_index].syntax.declarations:
                match declaration.value:
                    Constant(constant): pass
                    RuntimeGlobal(global):
                        try self.collect_global(module_index, declaration.is_public, global, declaration.span)
                    TypeAlias(type_alias): pass
                    Function(function):
                        try self.collect_function(checker, module_index, declaration.is_public, declaration.documentation, none, function, false, declaration.span)
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            try self.collect_class_members(checker, module_index, nominal)
                        else:
                            try self.collect_struct_members(checker, module_index, nominal)
                    Enumeration(enumeration):
                        try self.collect_enum_members(checker, module_index, enumeration)
                    InterfaceType(interface_type):
                        pass
                    TestDeclaration(test_declaration):
                        try self.state.fail_at(module_index, declaration.span, "test declarations are not implemented yet")
                    ExportStruct(export_struct):
                        try self.collect_export_struct_members(checker, module_index, export_struct)
                    ExportEnum(export_enum):
                        try self.collect_export_enum_members(checker, module_index, export_enum)
                    ExportFunction(export_function):
                        try self.collect_function(checker, module_index, true, declaration.documentation, none, export_function, true, declaration.span)
                    ExternType(extern_type):
                        pass
                    ExternFunction(extern_function):
                        try self.collect_extern_function(module_index, declaration.is_public, declaration.documentation, extern_function, declaration.span)
                    ExternVariable(extern_variable):
                        try self.collect_extern_variable(module_index, declaration.is_public, declaration.documentation, extern_variable, declaration.span)
                    ExternStruct(extern_struct):
                        try self.collect_extern_struct_members(checker, module_index, extern_struct)
        try self.collect_conformances()

    func collect_alias(module_index: i64, is_public: bool, documentation: list[str], type_alias: TypeAliasSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, type_alias.name, span)
        self.state.aliases.append(CollectedAlias(
            module_index = module_index,
            name = type_alias.name,
            is_public = is_public,
            documentation = documentation,
            syntax = type_alias,
            span = span,
            resolved = none,
        ))

    func collect_constant(module_index: i64, is_public: bool, constant: ConstantSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, constant.name, span)
        if is_public and constant.annotation == none:
            try self.state.fail_at(module_index, span, "public constant `" + constant.name + "` requires an explicit type")
        let placeholder = resolve_builtin_type(BuiltinType.unit)
        let symbol = self.state.make_symbol(constant.name, SymbolKind.constant, placeholder)
        self.state.constants.append(CollectedConstant(
            symbol = symbol,
            module_index = module_index,
            name = constant.name,
            is_public = is_public,
            annotation = constant.annotation,
            value = constant.value,
            span = span,
            typed = NodeId(value = no_node),
        ))

    func collect_global(module_index: i64, is_public: bool, global: RuntimeGlobalSyntax, span: SourceSpan) -> !:
        if self.state.package_role != PackageRole.sealed_runtime:
            try self.state.fail_at(module_index, span, "mutable module globals are reserved for the sealed runtime package")
        if is_public:
            try self.state.fail_at(module_index, span, "a sealed runtime global must be module-private")
        try self.require_free_module_name(module_index, global.name, span)
        let value_type = try self.resolve_type(module_index, global.value_type)
        if self.state.contains_fallible(value_type):
            try self.state.fail_at(module_index, global.value_type.span, "runtime global `" + global.name + "` cannot store a fallible type")
        try self.state.validate_persistent_type(module_index, value_type, global.value_type.span, "runtime global `" + global.name + "`")
        if not self.state.has_structural_zero(value_type):
            try self.state.fail_at(module_index, global.value_type.span, "runtime global `" + global.name + "` needs a structurally zero-initializable value type")
        let symbol = self.state.make_symbol(global.name, SymbolKind.global, value_type)
        self.state.globals.append(CollectedGlobal(symbol = symbol, module_index = module_index, name = global.name, value_type = value_type, span = span))

    # C globals are mutable source values but not Luce-owned storage. Keep the
    # closed one-word vocabulary here so every later stage receives a valid,
    # already resolved contract.
    func collect_extern_variable(module_index: i64, is_public: bool, documentation: list[str], syntax: ExternVariableSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, syntax.name, span)
        let value_type = try self.resolve_type(module_index, syntax.value_type)
        if not self.is_c_variable_value(value_type):
            try self.state.fail_at(module_index, syntax.value_type.span, "extern variable `" + syntax.name + "` has unsupported boundary type `" + self.state.describe_type(value_type) + "`")
        self.state.extern_variables.append(CollectedExternVariable(
            module_index = module_index,
            name = syntax.name,
            is_public = is_public,
            documentation = documentation,
            value_type = value_type,
            span = span,
        ))

    func require_free_module_name(module_index: i64, name: str, span: SourceSpan) -> !:
        if is_reserved_core_name(name):
            try self.state.fail_at(module_index, span, "`" + name + "` belongs to the compiler-known core namespace")
        if self.state.find_function_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_generic_function_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_struct_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_class_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_enum_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_interface_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_extern_type_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_alias_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_constant_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_extern_variable_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.state.find_global_in_module(module_index, name) >= 0:
            try self.state.fail_at(module_index, span, "duplicate declaration `" + name + "`")

    pub func enter_module(module_index: i64):
        self.state.current_module = module_index
        if module_index < len(self.state.module_bindings):
            self.state.bindings = self.state.module_bindings[module_index]
        else:
            # Imported bodies are already resolved; specialization needs only
            # their semantic identities, never dependency import syntax.
            self.state.bindings = ModuleBindings(
                modules = list[ImportedModule](), declarations = list[ImportedBinding](),
            )

    pub func resolve_aliases() -> !:
        for index in range(0, len(self.state.aliases)):
            discard(try self.resolve_alias(index))

    func resolve_alias(index: i64) -> TypeId!:
        let item = self.state.aliases[index]
        let already = item.resolved
        if already != none: return already
        let key = str(item.module_index) + "." + item.name
        for previous in self.state.alias_stack:
            if previous == key:
                try self.state.fail_at(item.module_index, item.span, "type alias `" + item.name + "` is recursive")
        self.state.alias_stack.append(key)
        let previous_module = self.state.current_module
        self.state.current_module = item.module_index
        let syntax = item.syntax else trap("unresolved alias has no source syntax")
        let resolved = try self.resolve_type(item.module_index, syntax.value)
        self.state.current_module = previous_module
        self.state.alias_stack.remove(len(self.state.alias_stack) - 1)
        self.state.aliases[index] = CollectedAlias(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            syntax = item.syntax,
            span = item.span,
            resolved = resolved,
        )
        return resolved


    func collect_function(checker: HirSemanticChecker, module_index: i64, is_public: bool, documentation: list[str], receiver: HirReceiver?, function: FunctionSyntax, is_exported_c: bool, span: SourceSpan) -> !:
        if receiver == none: try self.require_free_module_name(module_index, function.name, span)
        let declares_type_parameters = len(function.generic_parameters) > 0
        let owner_parameters = self.receiver_type_parameters(receiver)
        var effective_receiver = receiver
        let is_generic = declares_type_parameters or owner_parameters != none
        if is_generic and is_exported_c:
            try self.state.fail_at(module_index, span, "an exported C function cannot be generic")
        if is_exported_c and receiver != none:
            try self.state.fail_at(module_index, span, "an exported C function cannot be a method")

        let saved_type_bindings = self.state.current_type_bindings
        let type_bindings = list[TypeBinding]()
        let type_parameters = list[HirTypeParameter]()
        var owner_parameter_count = 0
        var generic_id = u32(0)
        if declares_type_parameters:
            generic_id = self.state.allocate_generic_identity()
            # A generic method on a generic nominal has two lexical generic
            # declarations. Remap both into one combined identity so abstract
            # checking, inference, memoization, and specialization retain one
            # structural substitution operation. The owner remains an
            # explicit prefix because calls learn it from the receiver.
            if owner_parameters != none:
                let method_receiver = receiver else trap("generic owner parameters require a receiver")
                owner_parameter_count = len(owner_parameters.parameters)
                let remapped_owner_arguments = list[TypeId]()
                for position in range(0, owner_parameter_count):
                    let parameter = owner_parameters.parameters[position]
                    let value_type = self.state.intern_named(
                        parameter.name,
                        TypeForm.TypeParameter(generic = generic_id, position = u32(position)),
                    )
                    remapped_owner_arguments.append(value_type)
                    type_bindings.append(TypeBinding(name = parameter.name, value_type = value_type))
                for position in range(0, owner_parameter_count):
                    let parameter = owner_parameters.parameters[position]
                    let constraints = list[TypeId]()
                    for constraint in parameter.constraints:
                        constraints.append(self.state.substitute_type(constraint, owner_parameters.generic_id, remapped_owner_arguments))
                    type_parameters.append(HirTypeParameter(
                        name = parameter.name,
                        value_type = remapped_owner_arguments[position],
                        constraints = constraints,
                    ))
                effective_receiver = HirReceiver(
                    owner = self.state.substitute_type(method_receiver.owner, owner_parameters.generic_id, remapped_owner_arguments),
                    kind = method_receiver.kind,
                )
            for declared_position in range(0, len(function.generic_parameters)):
                let position = owner_parameter_count + declared_position
                let parameter = function.generic_parameters[declared_position]
                for previous in type_bindings:
                    if previous.name == parameter.name:
                        try self.state.fail_at(module_index, parameter.span, "duplicate generic parameter `" + parameter.name + "`")
                let value_type = self.state.intern_named(
                    parameter.name,
                    TypeForm.TypeParameter(generic = generic_id, position = u32(position)),
                )
                type_bindings.append(TypeBinding(name = parameter.name, value_type = value_type))
                # Bind the parameter before resolving its constraints so a
                # generic interface argument may refer to an earlier or the
                # current declaration parameter.
                self.state.current_type_bindings = type_bindings
                let constraints = list[TypeId]()
                for constraint in parameter.constraints:
                    let resolved = try self.resolve_owner_interface_reference(module_index, constraint, value_type)
                    for previous in constraints:
                        if types_match(previous, resolved):
                            try self.state.fail_at(module_index, constraint.span, "duplicate constraint `" + self.state.describe_type(resolved) + "` on `" + parameter.name + "`")
                    try self.require_unique_standard_constraint_element(module_index, constraints, resolved, parameter.name, constraint.span)
                    constraints.append(resolved)
                type_parameters.append(HirTypeParameter(name = parameter.name, value_type = value_type, constraints = constraints))
            self.state.current_type_bindings = type_bindings
        elif owner_parameters != none:
            generic_id = owner_parameters.generic_id
            owner_parameter_count = len(owner_parameters.parameters)
            for parameter in owner_parameters.parameters: type_parameters.append(parameter)
            for binding in owner_parameters.bindings: type_bindings.append(binding)
            self.state.current_type_bindings = type_bindings

        let parameters = list[HirParameter]()
        var has_self = false
        var saw_default = false
        for parameter in function.parameters:
            for previous in parameters:
                if previous.name == parameter.name:
                    try self.state.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
            var parameter_type = resolve_builtin_type(BuiltinType.unit)
            if parameter.name == "self":
                let owner = effective_receiver else error(self.state.diagnostic_at(module_index, parameter.span, "`self` is the receiver of a method; only a type member declares it"))
                if len(parameters) > 0: try self.state.fail_at(module_index, parameter.span, "`self` must be the first parameter")
                if parameter.annotation != none: try self.state.fail_at(module_index, parameter.span, "`self` does not take a type annotation")
                if parameter.default_value != none: try self.state.fail_at(module_index, parameter.span, "`self` does not take a default value")
                parameter_type = owner.owner
                has_self = true
            else:
                let annotation = parameter.annotation else error(self.state.diagnostic_at(
                    module_index,
                    parameter.span,
                    "parameter `" + parameter.name + "` requires a type",
                ))
                parameter_type = try self.resolve_type(module_index, annotation)
                if self.state.contains_fallible(parameter_type):
                    try self.state.fail_at(module_index, parameter.span, "parameter `" + parameter.name + "` cannot store a fallible type; `T!` is a function-result effect")
                try self.state.validate_parameter_type(module_index, parameter_type, parameter.span, "parameter `" + parameter.name + "`")
            let default_syntax = parameter.default_value
            if is_exported_c and default_syntax != none:
                try self.state.fail_at(module_index, parameter.span, "an exported C parameter takes no default")
            if default_syntax != none:
                saw_default = true
            elif saw_default:
                try self.state.fail_at(module_index, parameter.span, "parameter `" + parameter.name + "` follows a parameter with a default and needs one too")
            let parameter_symbol = self.state.make_symbol(parameter.name, SymbolKind.parameter, parameter_type)
            # Default expressions resolve only after imports and constants.
            # Generic declarations additionally need concrete substitution,
            # so their specialization pass performs the same transaction.
            parameters.append(HirParameter(symbol = parameter_symbol, name = parameter.name, value_type = parameter_type, default_value = NodeId(value = no_node)))

        var result = resolve_builtin_type(BuiltinType.unit)
        let result_syntax = function.result
        if result_syntax != none:
            result = try self.resolve_type(module_index, result_syntax)
        try self.state.validate_function_result(module_index, result, span)
        if is_exported_c and self.state.contains_fallible(result):
            try self.state.fail_at(module_index, span, "an exported C function cannot be fallible")
        if is_exported_c:
            try self.require_c_function_type(module_index, parameters, result, span, "exported C function `" + function.name + "`")
        var checked_receiver: HirReceiver? = none
        if effective_receiver != none:
            let function_receiver = effective_receiver
            if function_receiver.kind == HirReceiverKind.initializer:
                if not has_self:
                    try self.state.fail_at(module_index, span, "initializer `init` requires `self` as its first parameter")
                var successful = result
                let fallible = self.state.fallible_inner(result)
                if fallible != none: successful = fallible
                if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
                    try self.state.fail_at(module_index, span, "initializer `init` must return `unit` or `unit!`")
                checked_receiver = function_receiver
            elif function_receiver.kind == HirReceiverKind.deinitializer:
                if not has_self:
                    try self.state.fail_at(module_index, span, "deinitializer `deinit` requires `self` as its only parameter")
                if len(parameters) != 1:
                    try self.state.fail_at(module_index, span, "deinitializer `deinit` takes no arguments")
                if not types_match(result, resolve_builtin_type(BuiltinType.unit)):
                    try self.state.fail_at(module_index, span, "deinitializer `deinit` must return `unit` and cannot fail")
                checked_receiver = function_receiver
            elif function.is_mutating and not has_self:
                try self.state.fail_at(module_index, span, "`mutating` requires a `self` parameter")
            else:
                var kind = HirReceiverKind.type_function
                if has_self:
                    kind = HirReceiverKind.value_method
                    if function.is_mutating: kind = HirReceiverKind.mutating_method
                checked_receiver = HirReceiver(owner = function_receiver.owner, kind = kind)
        let function_symbol = self.state.make_symbol(function.name, SymbolKind.function, result)
        var source = CollectedFunctionSource.Defined(syntax = function)
        if is_exported_c: source = CollectedFunctionSource.ExportedC(syntax = function)
        var generic_origin = -1
        if is_generic: generic_origin = len(self.state.generic_functions)
        let collected = FunctionSymbol(
            symbol = function_symbol,
            module_index = module_index,
            name = function.name,
            is_public = is_public,
            documentation = documentation,
            receiver = checked_receiver,
            parameters = parameters,
            result = result,
            source = source,
            span = span,
            generic_origin = generic_origin,
            generic_instance = -1,
            type_bindings = type_bindings,
        )
        if is_generic:
            self.state.generic_functions.append(GenericFunctionTemplate(
                generic_id = generic_id,
                module_index = module_index,
                name = function.name,
                is_public = is_public,
                documentation = documentation,
                owner_parameter_count = owner_parameter_count,
                type_parameters = type_parameters,
                signature = collected,
                syntax = function,
                body = none,
                span = span,
            ))
        else:
            self.state.functions.append(collected)
        self.state.current_type_bindings = saved_type_bindings

    ## Resolve ordinary callable defaults after imports and constants exist.
    ## Signature collection deliberately records only types and identities;
    ## evaluating value syntax there would make legal imported constants
    ## depend on declaration-pass order. Generic defaults remain owned by
    ## their template and specialization transactions.
    pub func resolve_function_defaults(checker: HirSemanticChecker) -> !:
        for function_index in range(0, len(self.state.functions)):
            let function = self.state.functions[function_index]
            if function.generic_origin >= 0: continue
            var syntax: FunctionSyntax? = none
            match function.source:
                Defined(value): syntax = value
                ExportedC(value): syntax = value
                ExternalC(contract): pass
                Specialized: pass
                Imported: pass
            if syntax == none: continue
            let declaration = syntax
            let parameters = list[HirParameter]()
            for parameter_index in range(0, len(function.parameters)):
                let parameter = function.parameters[parameter_index]
                var default_value = NodeId(value = no_node)
                let default_syntax = declaration.parameters[parameter_index].default_value
                if default_syntax != none:
                    default_value = try checker.check_constant_expression(
                        function.module_index,
                        default_syntax,
                        parameter.value_type,
                        "default of parameter `" + parameter.name + "`",
                    )
                parameters.append(HirParameter(
                    symbol = parameter.symbol,
                    name = parameter.name,
                    value_type = parameter.value_type,
                    default_value = default_value,
                ))
            self.state.functions[function_index] = FunctionSymbol(
                symbol = function.symbol,
                module_index = function.module_index,
                name = function.name,
                is_public = function.is_public,
                documentation = function.documentation,
                receiver = function.receiver,
                parameters = parameters,
                result = function.result,
                source = function.source,
                span = function.span,
                generic_origin = function.generic_origin,
                generic_instance = function.generic_instance,
                type_bindings = function.type_bindings,
            )

    ## A method on a generic nominal inherits the owner's one lexical type
    ## environment. It is a template even when the method declares no
    ## additional parameters of its own.
    func receiver_type_parameters(receiver: HirReceiver?) -> DeclaredTypeParameters?:
        if receiver == none: return none
        match self.state.types.definitions[receiver.owner.value].form:
            Struct(index, arguments):
                let item = self.state.structs[index]
                if len(item.type_parameters) == 0: return none
                return DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
            Class(index, arguments):
                let item = self.state.classes[index]
                if len(item.type_parameters) == 0: return none
                return DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
            Enum(index, arguments):
                let item = self.state.enums[index]
                if len(item.type_parameters) == 0: return none
                return DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
            else: return none

    ## Capture the callable table selected by the just-completed collection
    ## transaction. The union keeps callers from manufacturing or later
    ## reinterpreting an integer index from the wrong table.
    func latest_collected_callable(is_generic: bool) -> CollectedNominalCallable:
        if is_generic:
            if len(self.state.generic_functions) == 0: trap("generic callable table is empty after collection")
            return CollectedNominalCallable.Generic(index = len(self.state.generic_functions) - 1)
        if len(self.state.functions) == 0: trap("concrete callable table is empty after collection")
        return CollectedNominalCallable.Concrete(index = len(self.state.functions) - 1)

    # Collect a host-supplied C function into the same callable table as a
    # definition. Inputs become ordinary source parameters. Outputs remain in
    # the ordered C contract and become source result components, so calls do
    # not grow a parallel argument-placement path.
    func collect_extern_function(module_index: i64, is_public: bool, documentation: list[str], function: ExternFunctionSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, function.name, span)
        let parameters = list[HirParameter]()
        let slots = list[HirCSlot]()
        let names = list[str]()
        for parameter in function.parameters:
            for previous in names:
                if previous == parameter.name:
                    try self.state.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
            names.append(parameter.name)
            let value_type = try self.resolve_type(module_index, parameter.value_type)
            match self.state.types.definitions[value_type.value].form:
                List(element):
                    if parameter.is_out:
                        try self.state.fail_at(module_index, parameter.span, "extern function `" + function.name + "` out parameter `" + parameter.name + "` cannot be a list; writable C arrays require a generated shim")
                    if not self.is_c_borrowed_list_element(element):
                        try self.state.fail_at(module_index, parameter.span, "extern function `" + function.name + "` borrowed list parameter `" + parameter.name + "` has unsupported element type `" + self.state.describe_type(element) + "`; use a boundary scalar, named handle, or `foreign`")
                else: pass
            var supported = self.is_c_function_value(value_type)
            if parameter.is_out: supported = self.is_c_function_output(value_type)
            if not supported:
                var kind = "parameter"
                if parameter.is_out: kind = "out parameter"
                try self.state.fail_at(module_index, parameter.span, "extern function `" + function.name + "` " + kind + " `" + parameter.name + "` has unsupported boundary type `" + self.state.describe_type(value_type) + "`")
            if parameter.is_out:
                slots.append(HirCSlot.Output(name = parameter.name, value_type = value_type))
                continue
            let symbol = self.state.make_symbol(parameter.name, SymbolKind.parameter, value_type)
            slots.append(HirCSlot.Input(parameter = u32(len(parameters))))
            parameters.append(HirParameter(symbol = symbol, name = parameter.name, value_type = value_type, default_value = NodeId(value = no_node)))
        var declared_result = resolve_builtin_type(BuiltinType.unit)
        let result_syntax = function.result
        if result_syntax != none: declared_result = try self.resolve_type(module_index, result_syntax)
        if self.state.contains_fallible(declared_result):
            try self.state.fail_at(module_index, span, "an extern function cannot be fallible")
        if self.is_extern_struct(declared_result):
            try self.state.fail_at(module_index, span, "extern function `" + function.name + "` cannot return extern struct `" + self.state.describe_type(declared_result) + "` by value; declare it as an `out` parameter or use a generated C shim")
        match self.state.types.definitions[declared_result.value].form:
            List(element):
                try self.state.fail_at(module_index, span, "extern function `" + function.name + "` cannot return a list; copy C-owned arrays through the explicit inbound-memory API")
            else: pass
        if not types_match(declared_result, resolve_builtin_type(BuiltinType.unit)) and not self.is_c_function_result(declared_result):
            try self.state.fail_at(module_index, span, "extern function `" + function.name + "` has unsupported result type `" + self.state.describe_type(declared_result) + "`")
        let contract = HirCFunction(is_blocking = function.is_blocking, slots = slots, declared_result = declared_result)
        let result = self.c_source_result(contract)
        let function_symbol = self.state.make_symbol(function.name, SymbolKind.function, result)
        self.state.functions.append(FunctionSymbol(
            symbol = function_symbol,
            module_index = module_index,
            name = function.name,
            is_public = is_public,
            documentation = documentation,
            receiver = none,
            parameters = parameters,
            result = result,
            source = CollectedFunctionSource.ExternalC(contract = contract),
            span = span,
            generic_origin = -1,
            generic_instance = -1,
            type_bindings = list[TypeBinding](),
        ))

    # A void C result contributes no source component. One remaining value is
    # returned directly; two or more use the language's ordinary tuple. This
    # is the only result-shaping rule for `out` declarations.
    func c_source_result(contract: HirCFunction) -> TypeId:
        let components = list[TypeId]()
        if not types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            components.append(contract.declared_result)
        for slot in contract.slots:
            match slot:
                Output(name, value_type): components.append(value_type)
                Input(parameter): pass
        if len(components) == 0: return resolve_builtin_type(BuiltinType.unit)
        if len(components) == 1: return components[0]
        return self.state.intern_tuple(components)

    # Register a pointer- or integer-shaped handle as a nominal HIR type. The
    # representation records only its source contract; null translation and
    # ABI placement happen later at the C boundary and in a backend.
    func collect_extern_type_name(module_index: i64, is_public: bool, documentation: list[str], syntax: ExternTypeSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, syntax.name, span)
        var representation = HirExternRepresentation.Pointer
        let representation_name = syntax.representation
        if representation_name != none:
            let value_type = builtin_type_id(representation_name) else trap("parser admitted an invalid extern type representation")
            representation = HirExternRepresentation.Integer(value_type = value_type)
        let index = len(self.state.extern_types)
        let type_id = self.state.intern_named(syntax.name, TypeForm.Extern(index = index))
        self.state.extern_types.append(CollectedExternType(
            module_index = module_index,
            name = syntax.name,
            is_public = is_public,
            documentation = documentation,
            type_id = type_id,
            representation = representation,
            span = span,
        ))

    # Exported C functions retain a deliberately smaller direct-boundary
    # vocabulary until their callback matrix is closed independently. Extern
    # calls use the direction-aware checks in `collect_extern_function`, which
    # admit cfunc values in both outbound inputs and incoming result slots.
    func require_c_function_type(module_index: i64, parameters: list[HirParameter], result: TypeId, span: SourceSpan, what: str) -> !:
        for parameter in parameters:
            if not self.is_c_function_component(parameter.value_type):
                try self.state.fail_at(module_index, span, what + " parameter `" + parameter.name + "` has unsupported boundary type `" + self.state.describe_type(parameter.value_type) + "`")
        if not types_match(result, resolve_builtin_type(BuiltinType.unit)) and not self.is_c_function_component(result):
            try self.state.fail_at(module_index, span, what + " has unsupported result type `" + self.state.describe_type(result) + "`")

    # Outbound extern-call inputs add only the two borrowed high-level shapes
    # and one complete cfunc to the common scalar/token row. Their adapters
    # remain confined to the call boundary below HIR.
    func is_c_function_value(value: TypeId) -> bool:
        if types_match(value, resolve_builtin_type(BuiltinType.string)): return true
        if self.is_c_scalar_or_token(value): return true
        if self.is_exported_c_enum(value): return true
        if self.is_exported_c_struct(value): return true
        if self.is_extern_struct(value): return true
        match self.state.types.definitions[value.value].form:
            List(element): return self.is_c_borrowed_list_element(element)
            CFunction(parameters, result): return true
            Optional(inner):
                if self.is_c_data_pointer(inner): return true
                match self.state.types.definitions[inner.value].form:
                    CFunction(parameters, result): return true
                    else: return false
            else: return false

    # A borrowed list crosses only as the dense representation already owned
    # by the list runtime. Keeping the element row identical to the direct
    # scalar/token vocabulary makes this a pointer exposure, never packing or
    # per-element representation conversion.
    func is_c_borrowed_list_element(value: TypeId) -> bool:
        return self.is_c_scalar_or_token(value)

    # C writes aggregates through declared pointer slots. Scalars, handles,
    # and complete raw cfunc values use the existing one-word output path.
    func is_c_function_output(value: TypeId) -> bool:
        return self.is_c_function_result(value) or self.is_c_struct(value)

    # A result or out slot may carry one complete raw C function pointer. The
    # callback's own signature remains closed and cannot recursively contain
    # another cfunc.
    func is_c_function_result(value: TypeId) -> bool:
        if types_match(value, resolve_builtin_type(BuiltinType.string)): return true
        if self.is_c_function_component(value): return true
        match self.state.types.definitions[value.value].form:
            CFunction(parameters, result): return true
            Optional(inner):
                match self.state.types.definitions[inner.value].form:
                    CFunction(parameters, result): return true
                    else: return false
            else: return false

    # A component inside a `cfunc` signature cannot itself be a function
    # pointer. This enforces the deliberately closed, non-recursive callback
    # vocabulary while ordinary extern slots may carry one complete cfunc.
    pub func is_c_function_component(value: TypeId) -> bool:
        if self.is_c_scalar_or_token(value): return true
        if self.is_exported_c_enum(value): return true
        if self.is_exported_c_struct(value): return true
        match self.state.types.definitions[value.value].form:
            Optional(inner): return self.is_c_data_pointer(inner)
            else: return false

    # An external variable is exactly one C scalar or opaque handle. Unlike a
    # call slot it admits no optional encoding and applies no null translation.
    func is_c_variable_value(value: TypeId) -> bool:
        if self.is_c_scalar(value): return true
        match self.state.types.definitions[value.value].form:
            Extern(index): return true
            else: return false

    # The common direct C vocabulary before a particular boundary position
    # decides whether pointer-shaped optional translation is meaningful.
    func is_c_scalar_or_token(value: TypeId) -> bool:
        if self.is_c_scalar(value): return true
        match self.state.types.definitions[value.value].form:
            Extern(index): return true
            Foreign: return true
            else: return false

    func is_c_scalar(value: TypeId) -> bool:
        if types_match(value, resolve_builtin_type(BuiltinType.boolean)) or is_integer_type(self.state.types, value): return true
        match self.state.types.definitions[value.value].form:
            # A direct C ABI has no portable binary16 carrier. FIIR-generated
            # adapters expose `_Float16` through an exact private f32 transport;
            # admitting f16 here would instead change an unadapted C signature.
            Floating(bits): return bits == 32 or bits == 64
            else: return false

    ## Extern-struct identity is a HIR declaration fact. It never changes the
    ## ordinary nominal value representation and carries no target layout.
    pub func is_extern_struct(value: TypeId) -> bool:
        match self.state.types.definitions[value.value].form:
            Struct(index, arguments): return collected_struct_is_extern(self.state.structs[index])
            else: return false

    pub func is_exported_c_struct(value: TypeId) -> bool:
        match self.state.types.definitions[value.value].form:
            Struct(index, arguments): return collected_struct_is_exported(self.state.structs[index])
            else: return false

    func is_c_struct(value: TypeId) -> bool:
        return self.is_extern_struct(value) or self.is_exported_c_struct(value)

    func is_exported_c_enum(value: TypeId) -> bool:
        match self.state.types.definitions[value.value].form:
            Enum(index, arguments): return self.state.enums[index].c_shape != none
            else: return false

    func is_c_data_pointer(value: TypeId) -> bool:
        match self.state.types.definitions[value.value].form:
            Foreign: return true
            Extern(index):
                match self.state.extern_types[index].representation:
                    Pointer: return true
                    Integer(value_type): return false
            else: return false

    # mark: Generic type scopes ================================================================

    ## Declare abstract parameters before resolving their constraints. This
    ## permits forward interface references without giving textual names any
    ## semantic identity beyond this declaration.
    func declare_type_parameters(module_index: i64, syntax: list[GenericParameterSyntax]) -> DeclaredTypeParameters!:
        let generic_id = self.state.allocate_generic_identity()
        let parameters = list[HirTypeParameter]()
        let bindings = list[TypeBinding]()
        for position in range(0, len(syntax)):
            let parameter = syntax[position]
            for previous in bindings:
                if previous.name == parameter.name:
                    try self.state.fail_at(module_index, parameter.span, "duplicate generic parameter `" + parameter.name + "`")
            let value_type = self.state.intern_named(
                parameter.name,
                TypeForm.TypeParameter(generic = generic_id, position = u32(position)),
            )
            bindings.append(TypeBinding(name = parameter.name, value_type = value_type))
            parameters.append(HirTypeParameter(name = parameter.name, value_type = value_type, constraints = list[TypeId]()))
        return DeclaredTypeParameters(generic_id = generic_id, parameters = parameters, bindings = bindings)

    ## Resolve written constraints in the declaration's complete abstract
    ## scope. All generic type owners share this one validation path.
    func resolve_type_parameter_constraints(module_index: i64, syntax: list[GenericParameterSyntax], declared: DeclaredTypeParameters) -> list[HirTypeParameter]!:
        let saved = self.state.current_type_bindings
        self.state.current_type_bindings = declared.bindings
        let parameters = list[HirTypeParameter]()
        for index in range(0, len(syntax)):
            let syntax_parameter = syntax[index]
            let constraints = list[TypeId]()
            for constraint in syntax_parameter.constraints:
                let resolved = try self.resolve_owner_interface_reference(module_index, constraint, declared.parameters[index].value_type)
                for previous in constraints:
                    if types_match(previous, resolved):
                        try self.state.fail_at(module_index, constraint.span, "duplicate constraint `" + self.state.describe_type(resolved) + "` on `" + syntax_parameter.name + "`")
                try self.require_unique_standard_constraint_element(module_index, constraints, resolved, syntax_parameter.name, constraint.span)
                constraints.append(resolved)
            parameters.append(HirTypeParameter(
                name = syntax_parameter.name,
                value_type = declared.parameters[index].value_type,
                constraints = constraints,
            ))
        self.state.current_type_bindings = saved
        return parameters

    ## A generic parameter has the same single standard-iteration element
    ## identity as a nominal conformer. Validate the written intersection once
    ## instead of letting a later loop select whichever constraint came first.
    func require_unique_standard_constraint_element(module_index: i64, constraints: list[TypeId], candidate: TypeId, name: str, span: SourceSpan) -> !:
        let identity = standard_interface_of(self.state, candidate)
        if identity == none: return
        let element_type = standard_interface_element(self.state, candidate)
        if element_type == none: return
        for existing in constraints:
            let existing_identity = standard_interface_of(self.state, existing)
            if existing_identity == none or not standard_interfaces_share_role(existing_identity, identity): continue
            let existing_element = standard_interface_element(self.state, existing)
            if existing_element != none and not types_match(existing_element, element_type):
                try self.state.fail_at(module_index, span, "generic parameter `" + name + "` cannot use more than one element type across standard iteration constraints")

    # mark: Interfaces =========================================================================

    ## Register an interface and its abstract type parameters before any
    ## requirement, constraint, or conformance resolves.
    func collect_interface_name(module_index: i64, is_public: bool, documentation: list[str], syntax: InterfaceSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, syntax.name, span)
        let declared = try self.declare_type_parameters(module_index, syntax.generic_parameters)
        self.state.interfaces.append(CollectedInterface(
            origin = HirInterfaceOrigin.Source(module = ModuleId(value = u32(module_index))),
            name = syntax.name,
            is_public = is_public,
            documentation = documentation,
            generic_id = declared.generic_id,
            type_parameters = declared.parameters,
            type_bindings = declared.bindings,
            requirements = list[HirInterfaceRequirement](),
            syntax = syntax,
            span = span,
        ))

    ## Resolve one interface body into callable requirements. Requirements
    ## own no executable function and therefore cannot leak into MIR.
    func collect_interface_requirements(module_index: i64, syntax: InterfaceSyntax) -> !:
        let interface_index = self.find_interface_in_module(module_index, syntax.name)
        if interface_index < 0: trap("interface name was not registered")
        let item = self.state.interfaces[interface_index]
        let saved_type_bindings = self.state.current_type_bindings
        self.state.current_type_bindings = item.type_bindings
        let declared = DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
        let type_parameters = try self.resolve_type_parameter_constraints(module_index, syntax.generic_parameters, declared)
        self.state.current_type_bindings = item.type_bindings
        let requirements = list[HirInterfaceRequirement]()
        for member in syntax.methods:
            match member.value:
                Function(function):
                    for previous in requirements:
                        if previous.name == function.name:
                            try self.state.fail_at(module_index, member.span, "duplicate interface requirement `" + function.name + "`")
                    if function.name == "init" or function.name == "deinit":
                        try self.state.fail_at(module_index, member.span, "an interface cannot require `" + function.name + "`")
                    if len(function.generic_parameters) > 0:
                        try self.state.fail_at(module_index, member.span, "interface requirements cannot be generic")
                    if len(function.parameters) == 0 or function.parameters[0].name != "self":
                        try self.state.fail_at(module_index, member.span, "interface requirement `" + function.name + "` must declare `self` first")
                    let parameters = list[HirParameter]()
                    for position in range(1, len(function.parameters)):
                        let parameter = function.parameters[position]
                        for previous in parameters:
                            if previous.name == parameter.name:
                                try self.state.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
                        if parameter.default_value != none:
                            try self.state.fail_at(module_index, parameter.span, "interface requirements cannot declare parameter defaults")
                        let annotation = parameter.annotation else error(self.state.diagnostic_at(module_index, parameter.span, "parameter `" + parameter.name + "` requires a type"))
                        let value_type = try self.resolve_type(module_index, annotation)
                        if self.state.contains_fallible(value_type):
                            try self.state.fail_at(module_index, parameter.span, "parameter `" + parameter.name + "` cannot store a fallible type; `T!` is a function-result effect")
                        try self.state.validate_parameter_type(module_index, value_type, parameter.span, "parameter `" + parameter.name + "`")
                        if self.state.contains_task_value(value_type):
                            try self.state.fail_at(module_index, parameter.span, "an interface requirement cannot receive a structured `task`; use a direct Luce call")
                        parameters.append(HirParameter(
                            symbol = self.state.make_symbol(parameter.name, SymbolKind.parameter, value_type),
                            name = parameter.name,
                            value_type = value_type,
                            default_value = NodeId(value = no_node),
                        ))
                    var result = resolve_builtin_type(BuiltinType.unit)
                    let result_syntax = function.result
                    if result_syntax != none: result = try self.resolve_type(module_index, result_syntax)
                    try self.state.validate_function_result(module_index, result, member.span)
                    requirements.append(HirInterfaceRequirement(
                        symbol = self.state.make_symbol(function.name, SymbolKind.function, result),
                        name = function.name,
                        is_mutating = function.is_mutating,
                        documentation = member.documentation,
                        parameters = parameters,
                        result = result,
                        span = member.span,
                    ))
                else: try self.state.fail_at(module_index, member.span, "an interface contains method requirements only")
        self.state.interfaces[interface_index] = CollectedInterface(
            origin = item.origin,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            requirements = requirements,
            syntax = item.syntax,
            span = item.span,
        )
        self.state.current_type_bindings = saved_type_bindings

    pub func find_interface_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.state.interfaces)):
            let item = self.state.interfaces[index]
            match item.origin:
                Source(module):
                    if i64(module.value) == module_index and item.name == name: return index
                Standard(identity): pass
        return -1

    ## Resolve a constraint or `implements` entry without admitting interface
    ## existentials into ordinary stored/function types yet.
    pub func resolve_interface_reference(module_index: i64, value: TypeSyntax) -> TypeId!:
        return try self.resolve_interface_reference_for_owner(module_index, value, none)

    ## Comparable's hidden `Self` is fixed by the declaration that owns a
    ## constraint or conformance. It is not source generic syntax and cannot
    ## be supplied explicitly or left unbound in an existential value.
    func resolve_owner_interface_reference(module_index: i64, value: TypeSyntax, owner_type: TypeId) -> TypeId!:
        return try self.resolve_interface_reference_for_owner(module_index, value, owner_type)

    ## Resolve one interface spelling exactly once. The optional owner changes
    ## only Comparable's implicit same-type application; every ordinary
    ## interface continues through the common arity and validation path.
    func resolve_interface_reference_for_owner(module_index: i64, value: TypeSyntax, optional_owner: TypeId?) -> TypeId!:
        match value.form:
            Named(path):
                let interface_index = try self.resolve_interface_path(module_index, path.parts, path.span)
                let item = self.state.interfaces[interface_index]
                match item.origin:
                    Standard(identity):
                        if identity == StandardInterface.comparable:
                            if optional_owner == none:
                                try self.state.fail_at(module_index, value.span, "`Comparable` has an implicit same-type operand and may appear only as a generic constraint or explicit conformance")
                            let owner_type = optional_owner else trap("Comparable owner disappeared")
                            let applied = self.state.intern_interface(interface_index, [owner_type])
                            try self.validate_interface_application(module_index, interface_index, [owner_type], value.span)
                            self.state.pending_generic_applications.append(PendingGenericApplication(module_index = module_index, value_type = applied, span = value.span))
                            return applied
                    Source(module): pass
                if len(item.type_parameters) != 0:
                    try self.state.fail_at(module_index, value.span, "interface `" + item.name + "` needs " + str(len(item.type_parameters)) + " type argument(s)")
                let resolved = self.state.intern_interface(interface_index, list[TypeId]())
                try self.validate_interface_application(module_index, interface_index, list[TypeId](), value.span)
                self.state.pending_generic_applications.append(PendingGenericApplication(module_index = module_index, value_type = resolved, span = value.span))
                return resolved
            Applied(path, arguments):
                let interface_index = try self.resolve_interface_path(module_index, path.parts, path.span)
                let item = self.state.interfaces[interface_index]
                match item.origin:
                    Standard(identity):
                        if identity == StandardInterface.comparable:
                            try self.state.fail_at(module_index, value.span, "`Comparable` has an implicit same-type operand and may appear only as a generic constraint or explicit conformance")
                    Source(module): pass
                if len(arguments) != len(item.type_parameters):
                    try self.state.fail_at(module_index, value.span, "interface `" + item.name + "` needs " + str(len(item.type_parameters)) + " type argument(s), got " + str(len(arguments)))
                let resolved = list[TypeId]()
                for argument in arguments:
                    match argument:
                        TypeArgument(argument_type): resolved.append(try self.resolve_type(module_index, argument_type))
                        IntegerArgument(token): try self.state.fail_at(module_index, token.span, "interface arguments must be types")
                let applied = self.state.intern_interface(interface_index, resolved)
                try self.validate_interface_application(module_index, interface_index, resolved, value.span)
                self.state.pending_generic_applications.append(PendingGenericApplication(module_index = module_index, value_type = applied, span = value.span))
                return applied
            else: try self.state.fail_at(module_index, value.span, "an interface reference must name a declared interface")
        trap("interface reference resolution did not return")

    # Generic interface declarations are checked once with abstract type
    # parameters. Revalidate each concrete callable shape at the application
    # boundary so substitution cannot manufacture an uninhabited parameter or
    # hide `never` inside a successful result.
    func validate_interface_application(module_index: i64, interface_index: i64, arguments: list[TypeId], span: SourceSpan) -> !:
        let contract = self.state.interfaces[interface_index]
        for requirement in contract.requirements:
            for parameter in requirement.parameters:
                let value_type = self.state.substitute_type(parameter.value_type, contract.generic_id, arguments)
                try self.state.validate_substituted_parameter_type(module_index, parameter.value_type, value_type, span, "parameter `" + parameter.name + "`")
            let result = self.state.substitute_type(requirement.result, contract.generic_id, arguments)
            try self.state.validate_function_result(module_index, result, span)

    func resolve_interface_path(module_index: i64, parts: list[str], span: SourceSpan) -> i64!:
        var owner_module = module_index
        var name = ""
        if len(parts) == 1:
            name = parts[0]
            let standard = standard_interface_named(name)
            if standard != none: return ensure_standard_interface(self.state, standard)
            let imported_module = self.state.use_selective_import_of(module_index, name)
            if imported_module >= 0: owner_module = imported_module
        elif len(parts) == 2:
            owner_module = self.state.use_imported_module_of(module_index, parts[0], parts[1])
            if owner_module < 0: try self.state.fail_at(module_index, span, "unknown interface `" + parts[0] + "." + parts[1] + "`")
            name = parts[1]
        else:
            try self.state.fail_at(module_index, span, "unknown interface")
        let interface_index = self.find_interface_in_module(owner_module, name)
        if interface_index < 0: try self.state.fail_at(module_index, span, "unknown interface `" + name + "`")
        if owner_module != module_index and not self.state.interfaces[interface_index].is_public:
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[owner_module].name + "`")
        return interface_index

    ## Validate every explicit conformance only after all nominal methods are
    ## known. Non-generic declarations publish concrete HIR immediately;
    ## generic declarations retain one abstract schema for later applications.
    func collect_conformances() -> !:
        let saved_type_bindings = self.state.current_type_bindings
        for item in self.state.structs:
            match item.source:
                Defined(nominal):
                    if len(item.type_parameters) == 0:
                        try self.collect_nominal_conformances(item.module_index, item.type_id, nominal.interfaces, item.name, false)
                    else:
                        self.state.current_type_bindings = item.type_bindings
                        try self.collect_generic_nominal_conformances(item.module_index, item.generic_id, item.type_id, nominal.interfaces, item.name, false)
                External(syntax):
                    if syntax != none:
                        let nominal = syntax
                        try self.collect_nominal_conformances(item.module_index, item.type_id, nominal.interfaces, item.name, false)
                else: pass
        for item in self.state.classes:
            let syntax = item.syntax
            if syntax == none: continue
            let nominal = syntax
            if len(item.type_parameters) == 0:
                try self.collect_nominal_conformances(item.module_index, item.type_id, nominal.interfaces, item.name, true)
            else:
                self.state.current_type_bindings = item.type_bindings
                try self.collect_generic_nominal_conformances(item.module_index, item.generic_id, item.type_id, nominal.interfaces, item.name, true)
        for item in self.state.enums:
            let syntax = item.syntax
            if syntax == none: continue
            let enumeration = syntax
            if len(item.type_parameters) == 0:
                try self.collect_nominal_conformances(item.module_index, item.type_id, enumeration.interfaces, item.name, false)
            else:
                self.state.current_type_bindings = item.type_bindings
                try self.collect_generic_nominal_conformances(item.module_index, item.generic_id, item.type_id, enumeration.interfaces, item.name, false)
        self.state.current_type_bindings = saved_type_bindings

    ## Prove every source-written generic application after conformances are
    ## complete. Interface and nominal bounds follow one algorithm; only the
    ## declaration owning the parameters differs.
    pub func validate_generic_applications(semantics: HirSemanticChecker) -> !:
        for application in self.state.pending_generic_applications:
            var generic_id: u32 = 0
            var parameters = list[HirTypeParameter]()
            let arguments = list[TypeId]()
            var description = "type"
            match self.state.types.definitions[application.value_type.value].form:
                Interface(index, values):
                    let declaration = self.state.interfaces[index]
                    generic_id = declaration.generic_id
                    parameters = declaration.type_parameters
                    for value in values: arguments.append(value)
                    description = "interface"
                Struct(index, values):
                    let declaration = self.state.structs[index]
                    generic_id = declaration.generic_id
                    parameters = declaration.type_parameters
                    for value in values: arguments.append(value)
                Class(index, values):
                    let declaration = self.state.classes[index]
                    generic_id = declaration.generic_id
                    parameters = declaration.type_parameters
                    for value in values: arguments.append(value)
                Enum(index, values):
                    let declaration = self.state.enums[index]
                    generic_id = declaration.generic_id
                    parameters = declaration.type_parameters
                    for value in values: arguments.append(value)
                else: trap("pending generic application is not a generic declaration")
            for index in range(0, len(parameters)):
                for constraint in parameters[index].constraints:
                    let required = self.state.substitute_type(constraint, generic_id, arguments)
                    if not try self.type_satisfies_interface(semantics, arguments[index], required, application.span):
                        try self.state.fail_at(application.module_index, application.span, description + " argument `" + self.state.describe_type(arguments[index]) + "` does not conform to `" + self.state.describe_type(required) + "` required by `" + parameters[index].name + "`")

    pub func type_satisfies_interface(semantics: HirSemanticChecker, value_type: TypeId, constraint: TypeId, span: SourceSpan) -> bool!:
        if self.state.find_conformance(value_type, constraint) >= 0: return true
        let optional_derived = standard_interface_of(self.state, constraint)
        if optional_derived != none:
            let derived = optional_derived
            if derived == StandardInterface.equatable: return self.is_equatable_type(value_type)
            if derived == StandardInterface.hashable: return self.is_hashable_type(value_type)
        match self.state.types.definitions[value_type.value].form:
            TypeParameter(generic_id, position):
                let inherited = self.state.type_parameter_constraints(generic_id, position)
                if inherited == none: return false
                for available in inherited:
                    if types_match(available, constraint): return true
            else: pass
        let template_index = try self.find_generic_conformance_template(value_type, constraint, span)
        if template_index < 0: return false
        if self.state.contains_type_parameter(value_type) or self.state.contains_type_parameter(constraint): return true
        return try self.materialize_generic_conformance(semantics, template_index, value_type, constraint, span) >= 0

    ## Resolve an exact conformance identity for an operation that must retain
    ## it in HIR, such as existential packaging. Abstract probe identities are
    ## permitted here because the generic checker rolls them back afterward.
    pub func ensure_conformance(semantics: HirSemanticChecker, value_type: TypeId, interface_type: TypeId, span: SourceSpan) -> i64!:
        let existing = self.state.find_conformance(value_type, interface_type)
        if existing >= 0: return existing
        let template_index = try self.find_generic_conformance_template(value_type, interface_type, span)
        if template_index < 0: return -1
        return try self.materialize_generic_conformance(semantics, template_index, value_type, interface_type, span)

    ## Complete every concrete generic conformance carried by one nominal
    ## application. Generator's type/function fixed point calls this even when
    ## no constraint or existential conversion demanded the witness first.
    pub func materialize_generic_conformances_for_type(semantics: HirSemanticChecker, value_type: TypeId) -> !:
        if self.state.contains_type_parameter(value_type): return
        for template_index in range(0, len(self.state.generic_conformances)):
            let template = self.state.generic_conformances[template_index]
            let arguments = self.state.nominal_application_arguments(template.value_type, value_type)
            if arguments == none: continue
            let interface_type = self.state.substitute_type(template.interface_type, template.generic_id, arguments)
            discard(try self.materialize_generic_conformance(semantics, template_index, value_type, interface_type, template.span))

    func collect_generic_nominal_conformances(module_index: i64, generic_id: u32, value_type: TypeId, declarations: list[TypeSyntax], name: str, is_class: bool) -> !:
        for declaration in declarations:
            let interface_type = try self.resolve_owner_interface_reference(module_index, declaration, value_type)
            let optional_derived = standard_interface_of(self.state, interface_type)
            if optional_derived != none:
                let derived = optional_derived
                if derived == StandardInterface.equatable or derived == StandardInterface.hashable:
                    try self.state.fail_at(module_index, declaration.span, "`" + self.state.describe_type(interface_type) + "` conformance is derived by the compiler and cannot appear in `implements`")
            for existing in self.state.generic_conformances:
                if types_match(existing.value_type, value_type) and types_match(existing.interface_type, interface_type):
                    try self.state.fail_at(module_index, declaration.span, "duplicate conformance of `" + name + "` to `" + self.state.describe_type(interface_type) + "`")
            try self.require_unique_standard_element_type(module_index, value_type, interface_type, name, declaration.span, true)
            var interface_index = -1
            let interface_arguments = list[TypeId]()
            match self.state.types.definitions[interface_type.value].form:
                Interface(index, arguments):
                    interface_index = index
                    for argument in arguments: interface_arguments.append(argument)
                else: trap("resolved interface reference is not an interface type")
            let contract = self.state.interfaces[interface_index]
            let adaptations = list[HirConformanceAdaptation]()
            for requirement in contract.requirements:
                let method_index = self.find_generic_method(value_type, requirement.name)
                if method_index < 0:
                    try self.state.fail_at(module_index, declaration.span, "type `" + name + "` does not implement requirement `" + requirement.name + "` of `" + self.state.describe_type(interface_type) + "`")
                let method = self.state.generic_functions[method_index]
                if method.owner_parameter_count != len(method.type_parameters):
                    try self.state.fail_at(module_index, declaration.span, "independently generic method `" + name + "." + requirement.name + "` cannot satisfy a non-generic interface requirement")
                adaptations.append(try self.validate_conformance_method(
                    module_index,
                    name,
                    method.signature,
                    requirement,
                    contract.generic_id,
                    interface_arguments,
                    is_class,
                    declaration.span,
                ))
            self.state.generic_conformances.append(GenericConformanceTemplate(
                module_index = module_index,
                generic_id = generic_id,
                value_type = value_type,
                interface_type = interface_type,
                is_class = is_class,
                adaptations = adaptations,
                span = declaration.span,
            ))

    func find_generic_conformance_template(value_type: TypeId, interface_type: TypeId, span: SourceSpan) -> i64!:
        var found = -1
        for index in range(0, len(self.state.generic_conformances)):
            let template = self.state.generic_conformances[index]
            let arguments = self.state.nominal_application_arguments(template.value_type, value_type)
            if arguments == none: continue
            let applied_interface = self.state.substitute_type(template.interface_type, template.generic_id, arguments)
            if not types_match(applied_interface, interface_type): continue
            if found >= 0:
                try self.state.fail_at(self.state.current_module, span, "conformance of `" + self.state.describe_type(value_type) + "` to `" + self.state.describe_type(interface_type) + "` is ambiguous")
            found = index
        return found

    func materialize_generic_conformance(semantics: HirSemanticChecker, template_index: i64, value_type: TypeId, interface_type: TypeId, span: SourceSpan) -> i64!:
        let existing = self.state.find_conformance(value_type, interface_type)
        if existing >= 0: return existing
        for active in self.materializing_conformances:
            if types_match(active.value_type, value_type) and types_match(active.interface_type, interface_type):
                try self.state.fail_at(self.state.current_module, span, "cyclic conformance materialization for `" + self.state.describe_type(value_type) + "` to `" + self.state.describe_type(interface_type) + "`")
        self.materializing_conformances.append(ConformanceMaterialization(value_type = value_type, interface_type = interface_type))

        let template = self.state.generic_conformances[template_index]
        var interface_index = -1
        let interface_arguments = list[TypeId]()
        match self.state.types.definitions[interface_type.value].form:
            Interface(index, arguments):
                interface_index = index
                for argument in arguments: interface_arguments.append(argument)
            else: trap("generic conformance did not produce an interface application")
        let contract = self.state.interfaces[interface_index]
        let implementations = list[SymbolId]()
        for requirement_index in range(0, len(contract.requirements)):
            let requirement = contract.requirements[requirement_index]
            let method_index = try semantics.instantiate_generic_method_for_feature(value_type, requirement.name, span)
            if method_index < 0: trap("validated generic conformance lost its method template")
            let method = self.state.functions[method_index]
            let adaptation = try self.validate_conformance_method(
                template.module_index,
                self.state.describe_type(value_type),
                method,
                requirement,
                contract.generic_id,
                interface_arguments,
                template.is_class,
                template.span,
            )
            if adaptation != template.adaptations[requirement_index]:
                trap("generic conformance adaptation changed during substitution")
            implementations.append(self.conformance_implementation(template.module_index, method, adaptation, requirement, contract.generic_id, interface_arguments, template.span))
        let conformance_index = len(self.state.conformances)
        self.state.conformances.append(HirConformance(value_type = value_type, interface_type = interface_type, implementations = implementations))
        self.materializing_conformances.remove(len(self.materializing_conformances) - 1)
        return conformance_index

    func collect_nominal_conformances(module_index: i64, value_type: TypeId, declarations: list[TypeSyntax], name: str, is_class: bool) -> !:
        for declaration in declarations:
            let interface_type = try self.resolve_owner_interface_reference(module_index, declaration, value_type)
            let optional_derived = standard_interface_of(self.state, interface_type)
            if optional_derived != none:
                let derived = optional_derived
                if derived == StandardInterface.equatable or derived == StandardInterface.hashable:
                    try self.state.fail_at(module_index, declaration.span, "`" + self.state.describe_type(interface_type) + "` conformance is derived by the compiler and cannot appear in `implements`")
            if self.state.find_conformance(value_type, interface_type) >= 0:
                try self.state.fail_at(module_index, declaration.span, "duplicate conformance of `" + name + "` to `" + self.state.describe_type(interface_type) + "`")
            try self.require_unique_standard_element_type(module_index, value_type, interface_type, name, declaration.span, false)
            var interface_index = -1
            let interface_arguments = list[TypeId]()
            match self.state.types.definitions[interface_type.value].form:
                Interface(index, arguments):
                    interface_index = index
                    for argument in arguments: interface_arguments.append(argument)
                else: trap("resolved interface reference is not an interface type")
            let contract = self.state.interfaces[interface_index]
            let implementations = list[SymbolId]()
            for requirement in contract.requirements:
                let method_index = self.find_method(value_type, requirement.name)
                if method_index < 0:
                    try self.state.fail_at(module_index, declaration.span, "type `" + name + "` does not implement requirement `" + requirement.name + "` of `" + self.state.describe_type(interface_type) + "`")
                let method = self.state.functions[method_index]
                let adaptation = try self.validate_conformance_method(module_index, name, method, requirement, contract.generic_id, interface_arguments, is_class, declaration.span)
                implementations.append(self.conformance_implementation(module_index, method, adaptation, requirement, contract.generic_id, interface_arguments, declaration.span))
            self.state.conformances.append(HirConformance(value_type = value_type, interface_type = interface_type, implementations = implementations))

    ## Iteration syntax has no element-type annotation, so one nominal value
    ## must select exactly one application of each standard protocol. Reject
    ## ambiguity at the declaration that creates it, before a later `for`
    ## happens to demand protocol resolution.
    func require_unique_standard_element_type(module_index: i64, value_type: TypeId, interface_type: TypeId, name: str, span: SourceSpan, is_generic: bool) -> !:
        let identity = standard_interface_of(self.state, interface_type)
        if identity == none: return
        let element_type = standard_interface_element(self.state, interface_type)
        if element_type == none: return
        if is_generic:
            for existing in self.state.generic_conformances:
                if not types_match(existing.value_type, value_type): continue
                let existing_identity = standard_interface_of(self.state, existing.interface_type)
                if existing_identity == none or not standard_interfaces_share_role(existing_identity, identity): continue
                let existing_element = standard_interface_element(self.state, existing.interface_type)
                if existing_element != none and not types_match(existing_element, element_type):
                    try self.state.fail_at(module_index, span, "type `" + name + "` cannot use more than one element type across standard iteration protocols")
            return
        for existing in self.state.conformances:
            if not types_match(existing.value_type, value_type): continue
            let existing_identity = standard_interface_of(self.state, existing.interface_type)
            if existing_identity == none or not standard_interfaces_share_role(existing_identity, identity): continue
            let existing_element = standard_interface_element(self.state, existing.interface_type)
            if existing_element != none and not types_match(existing_element, element_type):
                try self.state.fail_at(module_index, span, "type `" + name + "` cannot use more than one element type across standard iteration protocols")

    func validate_conformance_method(module_index: i64, owner_name: str, method: FunctionSymbol, requirement: HirInterfaceRequirement, generic_id: u32, arguments: list[TypeId], is_class: bool, span: SourceSpan) -> HirConformanceAdaptation!:
        let receiver = method.receiver else trap("conformance method has no receiver")
        if receiver.kind == HirReceiverKind.type_function or receiver.kind == HirReceiverKind.initializer or receiver.kind == HirReceiverKind.deinitializer:
            try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` is not an instance method required by the interface")
        if requirement.is_mutating:
            if not is_class and receiver.kind != HirReceiverKind.mutating_method:
                try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` must be `mutating` to satisfy the interface")
        elif receiver.kind == HirReceiverKind.mutating_method:
            try self.state.fail_at(module_index, span, "mutating method `" + owner_name + "." + method.name + "` cannot satisfy a non-mutating interface requirement")
        if not self.method_is_public(method):
            try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` must be public to satisfy an interface")
        if len(method.parameters) != len(requirement.parameters) + 1:
            try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` has the wrong number of parameters for the interface")
        for index in range(0, len(requirement.parameters)):
            let expected = self.state.substitute_type(requirement.parameters[index].value_type, generic_id, arguments)
            let actual = method.parameters[index + 1]
            if actual.name != requirement.parameters[index].name or not types_match(actual.value_type, expected):
                try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` does not match parameter `" + requirement.parameters[index].name + "` of the interface")
        let expected_result = self.state.substitute_type(requirement.result, generic_id, arguments)
        if types_match(method.result, expected_result): return HirConformanceAdaptation.direct
        let successful = self.state.fallible_inner(expected_result)
        if successful != none and types_match(method.result, successful):
            return HirConformanceAdaptation.fallible_lift
        try self.state.fail_at(module_index, span, "method `" + owner_name + "." + method.name + "` returns `" + self.state.describe_type(method.result) + "`, but the interface requires `" + self.state.describe_type(expected_result) + "`")
        trap("invalid conformance result did not fail")

    func method_is_public(method: FunctionSymbol) -> bool:
        if method.generic_origin >= 0: return self.state.generic_functions[method.generic_origin].is_public
        return method.is_public

    func conformance_implementation(module_index: i64, method: FunctionSymbol, adaptation: HirConformanceAdaptation, requirement: HirInterfaceRequirement, generic_id: u32, arguments: list[TypeId], span: SourceSpan) -> SymbolId:
        if adaptation == HirConformanceAdaptation.direct: return method.symbol
        let result = self.state.substitute_type(requirement.result, generic_id, arguments)
        return self.make_fallible_requirement_adapter(module_index, method, result, span)

    ## A non-fallible implementation may satisfy a fallible requirement. The
    ## conformance points at this ordinary Luce wrapper, so static calls and
    ## future witness tables share the same explicit caller-owned-error ABI.
    func make_fallible_requirement_adapter(module_index: i64, method: FunctionSymbol, result: TypeId, span: SourceSpan) -> SymbolId:
        let name = ".luce_interface_lift_" + str(len(self.state.generated_functions))
        let symbol = self.state.make_symbol(name, SymbolKind.function, result)
        let parameters = list[HirParameter]()
        let placed = list[u32]()
        for index in range(0, len(method.parameters)):
            let source = method.parameters[index]
            let parameter_symbol = self.state.make_symbol(source.name, SymbolKind.parameter, source.value_type)
            parameters.append(HirParameter(
                symbol = parameter_symbol,
                name = source.name,
                value_type = source.value_type,
                default_value = NodeId(value = no_node),
            ))
            let reference = self.state.push_node(HirNodeForm.Reference(symbol = parameter_symbol), source.value_type, span)
            placed.append(u32(index))
            placed.append(reference.value)
        let call = self.state.push_node(HirNodeForm.Call(function = method.symbol, arguments = self.state.push_run(placed)), method.result, span)
        let returned = self.state.push_statement(HirNodeForm.ReturnStatement(value = call), span)
        self.state.generated_functions.append(HirFunction(
            symbol = symbol,
            module = ModuleId(value = u32(module_index)),
            name = name,
            is_public = false,
            documentation = list[str](),
            # Preserve value/mutating receiver transport. A mutating
            # implementation must copy its updated `self` through the lift,
            # not merely adapt the fallible result channel.
            receiver = method.receiver,
            closure = none,
            parameters = parameters,
            result = result,
            implementation = HirFunctionImplementation.Defined(body = self.state.push_nodes([returned])),
            span = span,
        ))
        return symbol

    # A field default or parameter default: checked in an empty scope, so it
    # cannot name a local or `self`, and required to be a literal tree
    # (optionally wrapped, grouped, or negated) so it is embeddable anywhere.

    # mark: Classes =============================================================================

    func collect_class_name(module_index: i64, is_public: bool, documentation: list[str], nominal: NominalTypeSyntax, span: SourceSpan) -> !:
        if profile_of(self.state.modules[module_index].authority) == Profile.base:
            try self.state.fail_at(module_index, span, belongs_to_full_luce("`class`", "has no classes; use a struct, and a pointer where identity is needed (base.md §23)"))
        try self.require_free_module_name(module_index, nominal.name, span)
        let declared = try self.declare_type_parameters(module_index, nominal.generic_parameters)
        let arguments = list[TypeId]()
        for parameter in declared.parameters: arguments.append(parameter.value_type)
        let index = len(self.state.classes)
        let type_id = self.state.intern_named(nominal.name, TypeForm.Class(index = index, arguments = arguments))
        self.state.classes.append(CollectedClass(
            module_index = module_index,
            name = nominal.name,
            is_public = is_public,
            documentation = documentation,
            generic_id = declared.generic_id,
            type_parameters = declared.parameters,
            type_bindings = declared.bindings,
            type_id = type_id,
            fields = list[HirField](),
            initializer = none,
            deinitializer = none,
            syntax = nominal,
            span = span,
        ))

    # A class owns an identity payload rather than an inline value. Every
    # field is initialized by its one explicit initializer; `deinit` is kept
    # as a lifecycle identity and cannot be called as an ordinary method.
    func collect_class_members(checker: HirSemanticChecker, module_index: i64, nominal: NominalTypeSyntax) -> !:
        let class_index = self.find_class_in_module(module_index, nominal.name)
        let item = self.state.classes[class_index]
        let declared = DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
        let type_parameters = try self.resolve_type_parameter_constraints(module_index, nominal.generic_parameters, declared)
        # Methods must inherit the resolved owner constraints, not the
        # placeholder list registered during the name pass.
        self.state.invalidate_type_facts()
        self.state.classes[class_index] = CollectedClass(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            fields = item.fields,
            initializer = item.initializer,
            deinitializer = item.deinitializer,
            syntax = item.syntax,
            span = item.span,
        )
        let saved_type_bindings = self.state.current_type_bindings
        self.state.current_type_bindings = item.type_bindings
        let fields = list[HirField]()
        var initializer: CollectedNominalCallable? = none
        var deinitializer: CollectedNominalCallable? = none
        for member in nominal.members:
            match member.value:
                Field(field):
                    for previous in fields:
                        if previous.name == field.name:
                            try self.state.fail_at(module_index, field.span, "duplicate field `" + field.name + "`")
                    if self.find_method(self.state.classes[class_index].type_id, field.name) >= 0 or self.find_generic_method(self.state.classes[class_index].type_id, field.name) >= 0:
                        try self.state.fail_at(module_index, field.span, "`" + field.name + "` is both a field and a method of `" + nominal.name + "`")
                    if field.default_value != none:
                        try self.state.fail_at(module_index, field.span, "class field `" + field.name + "` is initialized exactly once in `init`, not by a declaration default")
                    let field_type = try self.resolve_type(module_index, field.value_type)
                    if self.state.contains_fallible(field_type):
                        try self.state.fail_at(module_index, field.span, "field `" + field.name + "` cannot store a fallible type; `T!` is a function-result effect")
                    try self.state.validate_persistent_type(module_index, field_type, field.span, "field `" + field.name + "`")
                    if field.is_weak:
                        if not field.is_mutable:
                            try self.state.fail_at(module_index, field.span, "a weak field must use `weak var` because object destruction writes `none`")
                        let referent = self.state.optional_inner(field_type) else error(self.state.diagnostic_at(module_index, field.span, "a weak field must have optional class type `T?`"))
                        if self.class_of(referent) < 0:
                            try self.state.fail_at(module_index, field.span, "a weak field must have optional class type `T?`")
                    fields.append(HirField(
                        name = field.name,
                        value_type = field_type,
                        is_mutable = field.is_mutable,
                        is_weak = field.is_weak,
                        is_public = member.is_public,
                        documentation = member.documentation,
                        default_value = NodeId(value = no_node),
                    ))
                Function(function):
                    var has_self = false
                    for parameter in function.parameters:
                        if parameter.name == "self": has_self = true
                    if len(function.generic_parameters) > 0:
                        if function.name == "init":
                            try self.state.fail_at(module_index, member.span, "an initializer cannot declare independent generic parameters; declare them on the class")
                        if function.name == "deinit":
                            try self.state.fail_at(module_index, member.span, "generic deinitializers are not permitted")
                        if not has_self:
                            try self.state.fail_at(module_index, member.span, "a type function cannot declare independent generic parameters; declare them on the class")
                    if self.find_method(self.state.classes[class_index].type_id, function.name) >= 0 or self.find_generic_method(self.state.classes[class_index].type_id, function.name) >= 0:
                        try self.state.fail_at(module_index, member.span, "duplicate method `" + function.name + "` in `" + nominal.name + "`")
                    for field in fields:
                        if field.name == function.name:
                            try self.state.fail_at(module_index, member.span, "`" + function.name + "` is both a field and a method of `" + nominal.name + "`")
                    var receiver_kind = HirReceiverKind.type_function
                    if function.name == "init": receiver_kind = HirReceiverKind.initializer
                    elif function.name == "deinit": receiver_kind = HirReceiverKind.deinitializer
                    let receiver = HirReceiver(owner = self.state.classes[class_index].type_id, kind = receiver_kind)
                    try self.collect_function(checker, module_index, member.is_public, member.documentation, receiver, function, false, member.span)
                    let method = self.latest_collected_callable(len(item.type_parameters) > 0 or len(function.generic_parameters) > 0)
                    if receiver_kind == HirReceiverKind.initializer: initializer = method
                    if receiver_kind == HirReceiverKind.deinitializer: deinitializer = method
        if initializer == none:
            try self.state.fail_at(module_index, self.state.classes[class_index].span, "class `" + nominal.name + "` must declare exactly one `init(self, ...)`")
        self.state.invalidate_type_facts()
        self.state.classes[class_index] = CollectedClass(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            fields = fields,
            initializer = initializer,
            deinitializer = deinitializer,
            syntax = item.syntax,
            span = item.span,
        )
        self.state.current_type_bindings = saved_type_bindings

    # mark: Structs =============================================================================

    # Register an extern struct in the ordinary nominal struct table. The
    # additional capability controls only which values may cross a C pointer
    # slot; all construction, field, equality, display, and copy semantics use
    # the same paths as any other value struct.
    func collect_extern_struct_name(module_index: i64, is_public: bool, documentation: list[str], syntax: ExternStructSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, syntax.name, span)
        let index = len(self.state.structs)
        let type_id = self.state.intern_named(syntax.name, TypeForm.Struct(index = index, arguments = list[TypeId]()))
        self.state.structs.append(CollectedStruct(
            module_index = module_index,
            name = syntax.name,
            is_public = is_public,
            documentation = documentation,
            generic_id = self.state.allocate_generic_identity(),
            type_parameters = list[HirTypeParameter](),
            type_bindings = list[TypeBinding](),
            type_id = type_id,
            fields = list[HirField](),
            c_kind = HirCStructKind.external,
            initializer = none,
            source = CollectedStructSource.External(syntax = extern_struct_nominal(syntax)),
            span = span,
        ))

    # Exported records are also ordinary Luce value structs. The exported role
    # records only that explicit C slots use their declaration-order field map.
    func collect_export_struct_name(module_index: i64, documentation: list[str], syntax: ExportStructSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, syntax.name, span)
        let index = len(self.state.structs)
        let type_id = self.state.intern_named(syntax.name, TypeForm.Struct(index = index, arguments = list[TypeId]()))
        self.state.structs.append(CollectedStruct(
            module_index = module_index,
            name = syntax.name,
            is_public = true,
            documentation = documentation,
            generic_id = self.state.allocate_generic_identity(),
            type_parameters = list[HirTypeParameter](),
            type_bindings = list[TypeBinding](),
            type_id = type_id,
            fields = list[HirField](),
            c_kind = HirCStructKind.exported,
            initializer = none,
            source = CollectedStructSource.Exported(syntax = export_struct_nominal(syntax)),
            span = span,
        ))

    func collect_export_struct_members(checker: HirSemanticChecker, module_index: i64, syntax: ExportStructSyntax) -> !:
        let struct_index = self.find_struct_in_module(module_index, syntax.name)
        if struct_index < 0: trap("exported C struct name was not registered")
        let item = self.state.structs[struct_index]
        if not collected_struct_is_exported(item): trap("exported C struct syntax resolved to an ordinary struct")
        try self.collect_struct_members(checker, module_index, export_struct_nominal(syntax))
        let collected = self.state.structs[struct_index]
        for field in collected.fields:
            if not self.is_export_struct_field(field.value_type):
                try self.state.fail_at(module_index, self.export_struct_field_span(syntax, field.name), "exported C struct `" + syntax.name + "` field `" + field.name + "` has unsupported C layout type `" + self.state.describe_type(field.value_type) + "`")

    func export_struct_field_span(syntax: ExportStructSyntax, name: str) -> SourceSpan:
        for field in syntax.fields:
            if field.name == name: return field.span
        trap("collected exported C struct field lost its source field")

    # Resolve ordinary value members through the one struct pipeline, then
    # validate the additional portable vocabulary that may cross a C pointer.
    # This is a semantic capability check, never a target layout computation.
    func collect_extern_struct_members(checker: HirSemanticChecker, module_index: i64, syntax: ExternStructSyntax) -> !:
        let struct_index = self.find_struct_in_module(module_index, syntax.name)
        if struct_index < 0: trap("extern struct name was not registered")
        let item = self.state.structs[struct_index]
        if not collected_struct_is_extern(item): trap("extern struct syntax resolved to an ordinary struct")
        try self.collect_struct_members(checker, module_index, extern_struct_nominal(syntax))
        let collected = self.state.structs[struct_index]
        for field in collected.fields:
            if not self.is_extern_struct_field(field.value_type):
                try self.state.fail_at(module_index, self.extern_struct_field_span(syntax, field.name), "extern struct `" + syntax.name + "` field `" + field.name + "` has unsupported C layout type `" + self.state.describe_type(field.value_type) + "`")

    func extern_struct_field_span(syntax: ExternStructSyntax, name: str) -> SourceSpan:
        for member in syntax.members:
            match member.value:
                Field(field):
                    if field.name == name: return field.span
                else: pass
        trap("collected extern struct field lost its source member")

    func is_extern_struct_field(value: TypeId) -> bool:
        if self.is_c_scalar_or_token(value): return true
        if self.is_c_struct(value) or self.is_exported_c_enum(value): return true
        match self.state.types.definitions[value.value].form:
            CFunction(parameters, result): return true
            else: pass
        return false

    # A generated standalone declaration can name only types whose complete C
    # spelling this package owns. Imported records and callback fields require
    # include/callback policy that belongs to their later dedicated slices.
    func is_export_struct_field(value: TypeId) -> bool:
        if self.is_c_scalar(value) or self.is_exported_c_enum(value): return true
        if self.is_exported_c_struct(value): return true
        return false

    func collect_struct_name(module_index: i64, is_public: bool, documentation: list[str], nominal: NominalTypeSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, nominal.name, span)
        let declared = try self.declare_type_parameters(module_index, nominal.generic_parameters)
        let arguments = list[TypeId]()
        for parameter in declared.parameters: arguments.append(parameter.value_type)
        let index = len(self.state.structs)
        let type_id = self.state.intern_named(nominal.name, TypeForm.Struct(index = index, arguments = arguments))
        self.state.structs.append(CollectedStruct(
            module_index = module_index,
            name = nominal.name,
            is_public = is_public,
            documentation = documentation,
            generic_id = declared.generic_id,
            type_parameters = declared.parameters,
            type_bindings = declared.bindings,
            type_id = type_id,
            fields = list[HirField](),
            c_kind = none,
            initializer = none,
            source = CollectedStructSource.Defined(syntax = nominal),
            span = span,
        ))

    # Fields are resolved in declaration order and methods are collected as
    # functions with a receiver. A struct may not contain itself by value.
    func collect_struct_members(checker: HirSemanticChecker, module_index: i64, nominal: NominalTypeSyntax) -> !:
        let struct_index = self.find_struct_in_module(module_index, nominal.name)
        let item = self.state.structs[struct_index]
        let declared = DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
        let type_parameters = try self.resolve_type_parameter_constraints(module_index, nominal.generic_parameters, declared)
        # Publish resolved owner constraints before method signatures inherit
        # the generic environment. Fields and initializer identity are filled
        # by the final assignment below.
        self.state.invalidate_type_facts()
        self.state.structs[struct_index] = CollectedStruct(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            fields = item.fields,
            c_kind = item.c_kind,
            initializer = item.initializer,
            source = item.source,
            span = item.span,
        )
        let saved_type_bindings = self.state.current_type_bindings
        self.state.current_type_bindings = item.type_bindings
        let fields = list[HirField]()
        var initializer: CollectedNominalCallable? = none
        for member in nominal.members:
            match member.value:
                Field(field):
                    for previous in fields:
                        if previous.name == field.name:
                            try self.state.fail_at(module_index, field.span, "duplicate field `" + field.name + "`")
                    if self.find_method(self.state.structs[struct_index].type_id, field.name) >= 0 or self.find_generic_method(self.state.structs[struct_index].type_id, field.name) >= 0:
                        try self.state.fail_at(module_index, field.span, "`" + field.name + "` is both a field and a method of `" + nominal.name + "`")
                    if field.is_weak: try self.state.fail_at(module_index, field.span, "`weak` fields belong to classes, not structs")
                    let field_type = try self.resolve_type(module_index, field.value_type)
                    if self.state.contains_fallible(field_type):
                        try self.state.fail_at(module_index, field.span, "field `" + field.name + "` cannot store a fallible type; `T!` is a function-result effect")
                    try self.state.validate_persistent_type(module_index, field_type, field.span, "field `" + field.name + "`")
                    var default_value = NodeId(value = no_node)
                    let default_syntax = field.default_value
                    if default_syntax != none:
                        default_value = try checker.check_constant_expression(module_index, default_syntax, field_type, "default of field `" + field.name + "`")
                    fields.append(HirField(
                        name = field.name,
                        value_type = field_type,
                        is_mutable = field.is_mutable,
                        is_weak = false,
                        is_public = member.is_public,
                        documentation = member.documentation,
                        default_value = default_value,
                    ))
                Function(function):
                    var has_self = false
                    for parameter in function.parameters:
                        if parameter.name == "self": has_self = true
                    if len(function.generic_parameters) > 0:
                        if function.name == "init":
                            try self.state.fail_at(module_index, member.span, "an initializer cannot declare independent generic parameters; declare them on the struct")
                        if not has_self:
                            try self.state.fail_at(module_index, member.span, "a type function cannot declare independent generic parameters; declare them on the struct")
                    if self.find_method(self.state.structs[struct_index].type_id, function.name) >= 0 or self.find_generic_method(self.state.structs[struct_index].type_id, function.name) >= 0:
                        try self.state.fail_at(module_index, member.span, "duplicate method `" + function.name + "` in `" + nominal.name + "`")
                    for field in fields:
                        if field.name == function.name:
                            try self.state.fail_at(module_index, member.span, "`" + function.name + "` is both a field and a method of `" + nominal.name + "`")
                    var receiver_kind = HirReceiverKind.type_function
                    if function.name == "init":
                        if function.is_mutating:
                            try self.state.fail_at(module_index, member.span, "an initializer does not use `mutating`; initialization already writes `self`")
                        receiver_kind = HirReceiverKind.initializer
                    let receiver = HirReceiver(owner = self.state.structs[struct_index].type_id, kind = receiver_kind)
                    try self.collect_function(checker, module_index, member.is_public, member.documentation, receiver, function, false, member.span)
                    if receiver_kind == HirReceiverKind.initializer:
                        initializer = self.latest_collected_callable(len(item.type_parameters) > 0)
        self.state.invalidate_type_facts()
        self.state.structs[struct_index] = CollectedStruct(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            fields = fields,
            c_kind = item.c_kind,
            initializer = initializer,
            source = item.source,
            span = item.span,
        )
        self.state.current_type_bindings = saved_type_bindings
        for field in fields:
            if self.contains_struct(field.value_type, struct_index):
                if collected_struct_is_extern(item):
                    try self.state.fail_at(module_index, item.span, "extern struct `" + item.name + "` contains itself through field `" + field.name + "`")
                if collected_struct_is_exported(item):
                    try self.state.fail_at(module_index, item.span, "exported C struct `" + item.name + "` contains itself through field `" + field.name + "`")
                try self.state.fail_at(module_index, item.span, "struct `" + item.name + "` contains itself through field `" + field.name + "`; use a class or a collection for recursive data")

    # Does a value of `value_type` store a `target` struct inline? Follows
    # tuples, optionals, and other structs, whose fields were resolved
    # earlier or are being resolved now (an empty field list is a struct
    # still being collected, which cannot be the target).
    func contains_struct(value_type: TypeId, target: i64) -> bool:
        return self.contains_type(value_type, self.state.structs[target].type_id)

    # Does a value of `value_type` store `target` inline? Follows tuples,
    # optionals, structs, and enum payloads. Reference collections deliberately
    # terminate the walk: their elements live behind runtime-owned storage.
    func contains_type(value_type: TypeId, target: TypeId) -> bool:
        # Any application of the declaration being defined is recursive
        # inline storage. Comparing only exact TypeIds misses expanding forms
        # such as `Node[list[T]]` and can recurse forever while substituting.
        match self.state.types.definitions[target.value].form:
            Struct(target_index, target_arguments):
                match self.state.types.definitions[value_type.value].form:
                    Struct(index, arguments):
                        if index == target_index: return true
                    else: pass
            Enum(target_index, target_arguments):
                match self.state.types.definitions[value_type.value].form:
                    Enum(index, arguments):
                        if index == target_index: return true
                    else: pass
            else: pass
        if types_match(value_type, target): return true
        match self.state.types.definitions[value_type.value].form:
            Struct(index, arguments):
                for field_index in range(0, len(self.state.structs[index].fields)):
                    let field = self.struct_field(value_type, field_index)
                    if self.contains_type(field.value_type, target): return true
                return false
            Enum(index, arguments):
                for case_index in range(0, len(self.state.enums[index].cases)):
                    let case_value = self.enum_case(value_type, case_index)
                    for field in case_value.payload:
                        if self.contains_type(field.value_type, target): return true
                return false
            Tuple(elements):
                for element in elements:
                    if self.contains_type(element, target): return true
                return false
            Array(element, count): return self.contains_type(element, target)
            Optional(inner): return self.contains_type(inner, target)
            else: return false

    # Equality is structural for value aggregates and exists exactly when
    # every stored component is itself equatable. This keeps unsupported
    # slice/function comparisons out of HIR instead of failing in lowering.
    pub func is_equatable_type(value_type: TypeId) -> bool:
        return self.is_equatable_type_once(value_type, self.state.begin_visit())

    # Collection indirection permits a finite type declaration to name its
    # own value shape (`Node { children: list[Node] }`). Treat a repeated type
    # on the current proof as the recursive hypothesis; every non-recursive
    # outgoing component is still checked before the root proof succeeds.
    func is_equatable_type_once(value_type: TypeId, visited: u32) -> bool:
        if self.state.visit(value_type, visited): return true
        match self.state.types.definitions[value_type.value].form:
            Unit: return true
            Boolean: return true
            Integer(bits, is_signed): return true
            Floating(bits): return true
            Character: return true
            String: return true
            Bytes: return true
            ErrorCode: return true
            Error: return true
            Extern(index): return true
            Foreign: return true
            TypeParameter(generic, position): return self.type_parameter_has_standard_constraint(generic, position, StandardInterface.equatable)
            Range(inner): return self.is_equatable_type_once(inner, visited)
            Array(element, count): return self.is_equatable_type_once(element, visited)
            List(element): return self.is_equatable_type_once(element, visited)
            Map(key, value):
                return self.is_equatable_type_once(key, visited) and self.is_equatable_type_once(value, visited)
            Set(element): return self.is_equatable_type_once(element, visited)
            FrozenList(element): return self.is_equatable_type_once(element, visited)
            FrozenMap(key, value):
                return self.is_equatable_type_once(key, visited) and self.is_equatable_type_once(value, visited)
            FrozenSet(element): return self.is_equatable_type_once(element, visited)
            Optional(inner): return self.is_equatable_type_once(inner, visited)
            Tuple(elements):
                for element in elements:
                    if not self.is_equatable_type_once(element, visited): return false
                return true
            Struct(index, arguments):
                for field_index in range(0, len(self.state.structs[index].fields)):
                    let field = self.struct_field(value_type, field_index)
                    if not self.is_equatable_type_once(field.value_type, visited): return false
                return true
            Enum(index, arguments):
                for case_index in range(0, len(self.state.enums[index].cases)):
                    let case_value = self.enum_case(value_type, case_index)
                    for field in case_value.payload:
                        if not self.is_equatable_type_once(field.value_type, visited): return false
                return true
            else: return false

    ## Hashability is deliberately narrower than equality: mutable reference
    ## collections, classes, interfaces, functions, and native identities can
    ## change or have representation-only identity and are never valid keys.
    ## Structural values qualify recursively, including IEEE floats under
    ## their ordinary equality rule.
    pub func is_hashable_type(value_type: TypeId) -> bool:
        return self.is_hashable_type_once(value_type, self.state.begin_visit())

    # The same recursive hypothesis as equality: a type repeated on the proof
    # path is assumed hashable while its other components are checked.
    func is_hashable_type_once(value_type: TypeId, visited: u32) -> bool:
        if self.state.visit(value_type, visited): return true
        match self.state.types.definitions[value_type.value].form:
            Unit: return true
            Boolean: return true
            Integer(bits, is_signed): return true
            Floating(bits): return true
            Character: return true
            String: return true
            Bytes: return true
            ErrorCode: return true
            Error: return true
            TypeParameter(generic, position): return self.type_parameter_has_standard_constraint(generic, position, StandardInterface.hashable)
            Range(inner): return self.is_hashable_type_once(inner, visited)
            Array(element, count): return self.is_hashable_type_once(element, visited)
            FrozenList(element): return self.is_hashable_type_once(element, visited)
            FrozenMap(key, value): return self.is_hashable_type_once(key, visited) and self.is_hashable_type_once(value, visited)
            FrozenSet(element): return self.is_hashable_type_once(element, visited)
            Optional(inner): return self.is_hashable_type_once(inner, visited)
            Tuple(elements):
                for element in elements:
                    if not self.is_hashable_type_once(element, visited): return false
                return true
            Struct(index, arguments):
                for field_index in range(0, len(self.state.structs[index].fields)):
                    let field = self.struct_field(value_type, field_index)
                    if not self.is_hashable_type_once(field.value_type, visited): return false
                return true
            Enum(index, arguments):
                for case_index in range(0, len(self.state.enums[index].cases)):
                    let case_value = self.enum_case(value_type, case_index)
                    for field in case_value.payload:
                        if not self.is_hashable_type_once(field.value_type, visited): return false
                return true
            else: return false

    ## Keys and set elements need both closed structural operations. Concrete
    ## hashable families imply equality, but generic constraints name the two
    ## marker proofs independently and must not acquire one from the other.
    pub func is_hash_key_type(value_type: TypeId) -> bool:
        return self.is_equatable_type(value_type) and self.is_hashable_type(value_type)

    func type_parameter_has_standard_constraint(generic: u32, position: u32, identity: StandardInterface) -> bool:
        let constraints = self.state.type_parameter_constraints(generic, position)
        if constraints == none: return false
        for constraint in constraints:
            let candidate = standard_interface_of(self.state, constraint)
            if candidate == none: continue
            let found = candidate
            if found == identity: return true
        return false

    pub func find_struct_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.state.structs)):
            if self.state.structs[index].module_index == module_index and self.state.structs[index].name == name: return index
        return -1

    pub func find_class_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.state.classes)):
            if self.state.classes[index].module_index == module_index and self.state.classes[index].name == name: return index
        return -1

    pub func find_method(owner: TypeId, name: str) -> i64:
        return self.state.find_method_of(owner, name)

    ## Find the abstract method template belonging to the same nominal
    ## declaration as `owner`. Applied arguments intentionally do not
    ## participate: they select a specialization after declaration lookup.
    pub func find_generic_method(owner: TypeId, name: str) -> i64:
        for index in range(0, len(self.state.generic_functions)):
            let generic = self.state.generic_functions[index]
            if generic.name != name: continue
            let receiver = generic.signature.receiver
            if receiver == none: continue
            if self.state.nominal_application_arguments(receiver.owner, owner) != none: return index
        return -1

    # mark: Enums ===============================================================================

    # An exported C enum is an ordinary payload-free enum in Luce. Its exact
    # integer spelling is a boundary map beside that semantic declaration;
    # case position never becomes a native ordinal in HIR or MIR.
    func collect_export_enum_members(checker: HirSemanticChecker, module_index: i64, syntax: ExportEnumSyntax) -> !:
        try self.collect_enum_members(checker, module_index, export_enum_nominal(syntax))

    func collect_export_enum_shape(module_index: i64, syntax: ExportEnumSyntax) -> !:
        let enum_index = self.find_enum_in_module(module_index, syntax.name)
        if enum_index < 0: trap("exported C enum name was not registered")
        let item = self.state.enums[enum_index]
        let representation = builtin_type_id(syntax.representation) else error(self.state.diagnostic_at(
            module_index,
            item.span,
            "exported C enum `" + syntax.name + "` representation must be an integer type",
        ))
        if not is_integer_type(self.state.types, representation):
            try self.state.fail_at(module_index, item.span, "exported C enum `" + syntax.name + "` representation must be an integer type")
        let values = list[Value]()
        for case_value in syntax.cases:
            if case_value.value.suffix != "" and case_value.value.suffix != syntax.representation:
                try self.state.fail_at(module_index, case_value.value.span, "exported C enum value suffix must match representation `" + syntax.representation + "`")
            let value = try self.export_enum_value(module_index, syntax.name, case_value, representation)
            for previous in values:
                if integer_values_match(previous, value):
                    try self.state.fail_at(module_index, case_value.span, "exported C enum `" + syntax.name + "` values must be unique")
            values.append(value)
        self.state.invalidate_type_facts()
        self.state.enums[enum_index] = CollectedEnum(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = item.type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            cases = item.cases,
            c_shape = HirCEnum(representation = representation, values = values),
            syntax = item.syntax,
            span = item.span,
        )

    func export_enum_value(module_index: i64, name: str, case_value: ExportEnumCaseSyntax, representation: TypeId) -> Value!:
        if is_unsigned_integer_type(self.state.types, representation):
            if case_value.is_negative:
                try self.state.fail_at(module_index, case_value.span, "exported C enum `" + name + "` value is outside `" + self.state.describe_type(representation) + "` range")
            let value = try self.state.decode_unsigned_integer_at(module_index, case_value.value)
            if value > unsigned_integer_maximum(self.state.types, representation):
                try self.state.fail_at(module_index, case_value.span, "exported C enum `" + name + "` value is outside `" + self.state.describe_type(representation) + "` range")
            return Value.UnsignedInteger(value = value)
        var value = i64(0)
        if case_value.is_negative:
            value = try self.state.decode_negative_integer_at(module_index, case_value.value)
        else:
            let unsigned = try self.state.decode_unsigned_integer_at(module_index, case_value.value)
            if unsigned > u64(integer_maximum(self.state.types, representation)):
                try self.state.fail_at(module_index, case_value.span, "exported C enum `" + name + "` value is outside `" + self.state.describe_type(representation) + "` range")
            value = i64(unsigned)
        if value < integer_minimum(self.state.types, representation) or value > integer_maximum(self.state.types, representation):
            try self.state.fail_at(module_index, case_value.span, "exported C enum `" + name + "` value is outside `" + self.state.describe_type(representation) + "` range")
        return Value.SignedInteger(value = value)

    func collect_enum_name(module_index: i64, is_public: bool, documentation: list[str], enumeration: EnumSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, enumeration.name, span)
        let declared = try self.declare_type_parameters(module_index, enumeration.generic_parameters)
        let arguments = list[TypeId]()
        for parameter in declared.parameters: arguments.append(parameter.value_type)
        let index = len(self.state.enums)
        let type_id = self.state.intern_named(enumeration.name, TypeForm.Enum(index = index, arguments = arguments))
        self.state.enums.append(CollectedEnum(
            module_index = module_index,
            name = enumeration.name,
            is_public = is_public,
            documentation = documentation,
            generic_id = declared.generic_id,
            type_parameters = declared.parameters,
            type_bindings = declared.bindings,
            type_id = type_id,
            cases = list[HirEnumCase](),
            c_shape = none,
            syntax = enumeration,
            span = span,
        ))

    # Cases in declaration order (the order is the tag); methods are functions
    # with the enum as receiver. An enum may not hold itself by value.
    func collect_enum_members(checker: HirSemanticChecker, module_index: i64, enumeration: EnumSyntax) -> !:
        let enum_index = self.find_enum_in_module(module_index, enumeration.name)
        let item = self.state.enums[enum_index]
        let declared = DeclaredTypeParameters(generic_id = item.generic_id, parameters = item.type_parameters, bindings = item.type_bindings)
        let type_parameters = try self.resolve_type_parameter_constraints(module_index, enumeration.generic_parameters, declared)
        let saved_type_bindings = self.state.current_type_bindings
        self.state.current_type_bindings = item.type_bindings
        let cases = list[HirEnumCase]()
        for case_syntax in enumeration.cases:
            for previous in cases:
                if previous.name == case_syntax.name:
                    try self.state.fail_at(module_index, case_syntax.span, "duplicate case `" + case_syntax.name + "`")
            let payload = list[HirPayloadField]()
            for field in case_syntax.payload:
                for previous in payload:
                    if previous.name == field.name:
                        try self.state.fail_at(module_index, case_syntax.span, "duplicate payload field `" + field.name + "` in case `" + case_syntax.name + "`")
                payload.append(HirPayloadField(name = field.name, value_type = try self.resolve_type(module_index, field.value_type)))
                if self.state.contains_fallible(payload[len(payload) - 1].value_type):
                    try self.state.fail_at(module_index, case_syntax.span, "case payload `" + field.name + "` cannot store a fallible type; `T!` is a function-result effect")
                try self.state.validate_persistent_type(module_index, payload[len(payload) - 1].value_type, case_syntax.span, "case payload `" + field.name + "`")
            cases.append(HirEnumCase(name = case_syntax.name, documentation = case_syntax.documentation, payload = payload))
        self.state.invalidate_type_facts()
        self.state.enums[enum_index] = CollectedEnum(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            generic_id = item.generic_id,
            type_parameters = type_parameters,
            type_bindings = item.type_bindings,
            type_id = item.type_id,
            cases = cases,
            c_shape = item.c_shape,
            syntax = item.syntax,
            span = item.span,
        )
        for case_value in cases:
            for field in case_value.payload:
                if self.contains_type(field.value_type, item.type_id):
                    try self.state.fail_at(module_index, item.span, "enum `" + item.name + "` contains itself through case `" + case_value.name + "`; use a class or a collection for recursive data")
        for member in enumeration.methods:
            match member.value:
                Function(function):
                    var has_self = false
                    for parameter in function.parameters:
                        if parameter.name == "self": has_self = true
                    if len(function.generic_parameters) > 0 and not has_self:
                        try self.state.fail_at(module_index, member.span, "a type function cannot declare independent generic parameters; declare them on the enum")
                    if self.find_method(item.type_id, function.name) >= 0 or self.find_generic_method(item.type_id, function.name) >= 0:
                        try self.state.fail_at(module_index, member.span, "duplicate method `" + function.name + "` in `" + enumeration.name + "`")
                    for case_value in cases:
                        if case_value.name == function.name:
                            try self.state.fail_at(module_index, member.span, "`" + function.name + "` is both a case and a method of `" + enumeration.name + "`")
                    let receiver = HirReceiver(owner = item.type_id, kind = HirReceiverKind.type_function)
                    try self.collect_function(checker, module_index, member.is_public, member.documentation, receiver, function, false, member.span)
                else: try self.state.fail_at(module_index, member.span, "an enum declares cases and methods only")
        self.state.current_type_bindings = saved_type_bindings

    pub func find_enum_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.state.enums)):
            if self.state.enums[index].module_index == module_index and self.state.enums[index].name == name: return index
        return -1

    pub func enum_of(value_type: TypeId) -> i64:
        if value_type.value < 0 or i64(value_type.value) >= len(self.state.types.definitions): return -1
        match self.state.types.definitions[value_type.value].form:
            Enum(index, arguments): return index
            else: return -1

    pub func find_case(enum_index: i64, name: str) -> i64:
        let cases = self.state.enums[enum_index].cases
        for index in range(0, len(cases)):
            if cases[index].name == name: return index
        return -1

    ## Materialize one case of a canonical enum application. Declaration
    ## metadata remains the abstract generic schema; construction, matching,
    ## equality and lowering consume only this substituted payload contract.
    pub func enum_case(value_type: TypeId, case_index: i64) -> HirEnumCase:
        match self.state.types.definitions[value_type.value].form:
            Enum(index, arguments):
                let item = self.state.enums[index]
                let case_value = item.cases[case_index]
                let payload = list[HirPayloadField]()
                for field in case_value.payload:
                    payload.append(HirPayloadField(
                        name = field.name,
                        value_type = self.state.substitute_type(field.value_type, item.generic_id, arguments),
                    ))
                return HirEnumCase(name = case_value.name, documentation = case_value.documentation, payload = payload)
            else: trap("enum case requested from a non-enum type")

    # The module that declared a nominal type.
    pub func owner_module(owner: TypeId) -> i64:
        let struct_index = self.struct_of(owner)
        if struct_index >= 0: return self.state.structs[struct_index].module_index
        let class_index = self.class_of(owner)
        if class_index >= 0: return self.state.classes[class_index].module_index
        let enum_index = self.enum_of(owner)
        if enum_index >= 0: return self.state.enums[enum_index].module_index
        return self.state.current_module

    pub func struct_of(value_type: TypeId) -> i64:
        if i64(value_type.value) >= len(self.state.types.definitions): return -1
        match self.state.types.definitions[value_type.value].form:
            Struct(index, arguments): return index
            else: return -1

    pub func class_of(value_type: TypeId) -> i64:
        if i64(value_type.value) >= len(self.state.types.definitions): return -1
        match self.state.types.definitions[value_type.value].form:
            Class(index, arguments): return index
            else: return -1

    pub func find_field(struct_index: i64, name: str) -> i64:
        let fields = self.state.structs[struct_index].fields
        for index in range(0, len(fields)):
            if fields[index].name == name: return index
        return -1

    ## Materialize one field of a canonical struct application. Declaration
    ## metadata stays abstract; body checking performs no independent
    ## substitution at access or construction sites.
    pub func struct_field(value_type: TypeId, field_index: i64) -> HirField:
        match self.state.types.definitions[value_type.value].form:
            Struct(index, arguments):
                let item = self.state.structs[index]
                let field = item.fields[field_index]
                return HirField(
                    name = field.name,
                    value_type = self.state.substitute_type(field.value_type, item.generic_id, arguments),
                    is_mutable = field.is_mutable,
                    is_weak = field.is_weak,
                    is_public = field.is_public,
                    documentation = field.documentation,
                    default_value = field.default_value,
                )
            else: trap("struct field requested from a non-struct type")

    pub func find_class_field(class_index: i64, name: str) -> i64:
        let fields = self.state.classes[class_index].fields
        for index in range(0, len(fields)):
            if fields[index].name == name: return index
        return -1

    ## Materialize one field of a canonical class application. Class identity
    ## is shared, but its payload schema is still specific to the concrete
    ## generic arguments and must not be read from the abstract declaration.
    pub func class_field(value_type: TypeId, field_index: i64) -> HirField:
        match self.state.types.definitions[value_type.value].form:
            Class(index, arguments):
                let item = self.state.classes[index]
                let field = item.fields[field_index]
                return HirField(
                    name = field.name,
                    value_type = self.state.substitute_type(field.value_type, item.generic_id, arguments),
                    is_mutable = field.is_mutable,
                    is_weak = field.is_weak,
                    is_public = field.is_public,
                    documentation = field.documentation,
                    default_value = field.default_value,
                )
            else: trap("class field requested from a non-class type")

    ## Resolve only the nominal declaration named by a `new` type. Unlike
    ## ordinary type resolution, a bare generic class remains available here
    ## so its arguments can be inferred from the initializer and context.
    pub func class_constructor_declaration(module_index: i64, value: TypeSyntax) -> i64!:
        var path: PathSyntax? = none
        match value.form:
            Named(named): path = named
            Applied(applied, arguments): path = applied
            else: return -1
        if path == none: return -1
        let nominal = try self.resolve_nominal_path(module_index, path.parts, path.span)
        if nominal == none: return -1
        match nominal:
            ClassType(index): return index
            else: return -1

    func find_nominal_in_module(module_index: i64, name: str) -> NominalTypeDeclaration?:
        let struct_index = self.find_struct_in_module(module_index, name)
        if struct_index >= 0: return NominalTypeDeclaration.StructType(index = struct_index)
        let class_index = self.find_class_in_module(module_index, name)
        if class_index >= 0: return NominalTypeDeclaration.ClassType(index = class_index)
        let enum_index = self.find_enum_in_module(module_index, name)
        if enum_index >= 0: return NominalTypeDeclaration.EnumType(index = enum_index)
        return none

    func find_visible_nominal(module_index: i64, name: str, span: SourceSpan) -> NominalTypeDeclaration?!:
        let local = self.find_nominal_in_module(module_index, name)
        if local != none: return local
        let imported_module = self.state.use_selective_import_of(module_index, name)
        if imported_module < 0: return none
        let imported = self.find_nominal_in_module(imported_module, name)
        if imported == none: return none
        if not self.nominal_is_public(imported):
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[imported_module].name + "`")
        return imported

    pub func find_visible_struct(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let nominal = try self.find_visible_nominal(module_index, name, span)
        if nominal == none: return -1
        match nominal:
            StructType(index): return index
            else: return -1

    pub func find_visible_class(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let nominal = try self.find_visible_nominal(module_index, name, span)
        if nominal == none: return -1
        match nominal:
            ClassType(index): return index
            else: return -1

    pub func find_visible_enum(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let nominal = try self.find_visible_nominal(module_index, name, span)
        if nominal == none: return -1
        match nominal:
            EnumType(index): return index
            else: return -1

    func find_visible_alias(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let local = self.state.find_alias_in_module(module_index, name)
        if local >= 0: return local
        let imported_module = self.state.use_selective_import_of(module_index, name)
        if imported_module < 0: return -1
        let imported = self.state.find_alias_in_module(imported_module, name)
        if imported >= 0 and not self.state.aliases[imported].is_public:
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[imported_module].name + "`")
        return imported

    func find_visible_interface(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let local = self.find_interface_in_module(module_index, name)
        if local >= 0: return local
        let imported_module = self.state.use_selective_import_of(module_index, name)
        if imported_module < 0: return -1
        let imported = self.find_interface_in_module(imported_module, name)
        if imported >= 0 and not self.state.interfaces[imported].is_public:
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[imported_module].name + "`")
        return imported

    func find_visible_extern_type(module_index: i64, name: str, span: SourceSpan) -> i64!:
        let local = self.state.find_extern_type_in_module(module_index, name)
        if local >= 0: return local
        let imported_module = self.state.use_selective_import_of(module_index, name)
        if imported_module < 0: return -1
        let imported = self.state.find_extern_type_in_module(imported_module, name)
        if imported >= 0 and not self.state.extern_types[imported].is_public:
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[imported_module].name + "`")
        return imported

    func nominal_name(value: NominalTypeDeclaration) -> str:
        match value:
            StructType(index): return self.state.structs[index].name
            ClassType(index): return self.state.classes[index].name
            EnumType(index): return self.state.enums[index].name

    func nominal_is_public(value: NominalTypeDeclaration) -> bool:
        match value:
            StructType(index): return self.state.structs[index].is_public
            ClassType(index): return self.state.classes[index].is_public
            EnumType(index): return self.state.enums[index].is_public

    func nominal_parameters(value: NominalTypeDeclaration) -> list[HirTypeParameter]:
        match value:
            StructType(index): return self.state.structs[index].type_parameters
            ClassType(index): return self.state.classes[index].type_parameters
            EnumType(index): return self.state.enums[index].type_parameters

    func nominal_unapplied_type(module_index: i64, value: NominalTypeDeclaration, span: SourceSpan) -> TypeId!:
        let parameters = self.nominal_parameters(value)
        if len(parameters) > 0:
            try self.state.fail_at(module_index, span, "type `" + self.nominal_name(value) + "` needs " + str(len(parameters)) + " type argument(s)")
        match value:
            StructType(index): return self.state.structs[index].type_id
            ClassType(index): return self.state.classes[index].type_id
            EnumType(index): return self.state.enums[index].type_id

    func nominal_application(module_index: i64, value: NominalTypeDeclaration, arguments: list[TypeArgumentSyntax], span: SourceSpan) -> TypeId!:
        let parameters = self.nominal_parameters(value)
        if len(arguments) != len(parameters):
            try self.state.fail_at(module_index, span, "type `" + self.nominal_name(value) + "` needs " + str(len(parameters)) + " type argument(s), got " + str(len(arguments)))
        let resolved = list[TypeId]()
        for argument in arguments:
            match argument:
                TypeArgument(argument_type): resolved.append(try self.resolve_type(module_index, argument_type))
                IntegerArgument(token): try self.state.fail_at(module_index, token.span, "generic nominal arguments must be types")
        var applied = resolve_builtin_type(BuiltinType.unit)
        match value:
            StructType(index): applied = self.state.intern_struct(index, resolved)
            ClassType(index): applied = self.state.intern_class(index, resolved)
            EnumType(index): applied = self.state.intern_enum(index, resolved)
        try self.state.validate_persistent_type(module_index, applied, span, "type `" + self.state.describe_type(applied) + "`")
        self.state.pending_generic_applications.append(PendingGenericApplication(module_index = module_index, value_type = applied, span = span))
        return applied

    func resolve_nominal_path(module_index: i64, parts: list[str], span: SourceSpan) -> NominalTypeDeclaration?!:
        var owner_module = module_index
        var name = ""
        if len(parts) == 1:
            name = parts[0]
        elif len(parts) == 2:
            owner_module = self.state.use_imported_module_of(module_index, parts[0], parts[1])
            if owner_module < 0: return none
            name = parts[1]
        else: return none
        var nominal = self.find_nominal_in_module(owner_module, name)
        if len(parts) == 1: nominal = try self.find_visible_nominal(module_index, name, span)
        if nominal == none: return none
        if owner_module != module_index and not self.nominal_is_public(nominal):
            try self.state.fail_at(module_index, span, "`" + name + "` is private to module `" + self.state.modules[owner_module].name + "`")
        return nominal

    # Turn a type spelling into a checked value type. A known-but-unimplemented
    # core type earns "not implemented yet".
    pub func resolve_type(module_index: i64, value: TypeSyntax) -> TypeId!:
        match value.form:
            Named(path):
                if len(path.parts) == 2:
                    # `module.Type` through an imported module. Aliases return
                    # their underlying identity; no alias spelling survives in
                    # typed HIR or creates a second nominal type.
                    let imported = self.state.use_imported_module_of(module_index, path.parts[0], path.parts[1])
                    if imported < 0: try self.state.fail_at(module_index, path.span, "unknown type `" + path.dotted() + "`")
                    let foreign_nominal = try self.resolve_nominal_path(module_index, path.parts, path.span)
                    if foreign_nominal != none: return try self.nominal_unapplied_type(module_index, foreign_nominal, value.span)
                    let foreign_alias = self.state.find_alias_in_module(imported, path.parts[1])
                    if foreign_alias >= 0:
                        if not self.state.aliases[foreign_alias].is_public:
                            try self.state.fail_at(module_index, path.span, "`" + path.parts[1] + "` is private to module `" + self.state.modules[imported].name + "`")
                        return try self.resolve_alias(foreign_alias)
                    let foreign_interface = self.find_interface_in_module(imported, path.parts[1])
                    if foreign_interface >= 0:
                        if not self.state.interfaces[foreign_interface].is_public:
                            try self.state.fail_at(module_index, path.span, "`" + path.parts[1] + "` is private to module `" + self.state.modules[imported].name + "`")
                        return try self.resolve_value_interface_reference(module_index, value)
                    let foreign_extern = self.state.find_extern_type_in_module(imported, path.parts[1])
                    if foreign_extern < 0: try self.state.fail_at(module_index, path.span, "module `" + self.state.modules[imported].name + "` has no type `" + path.parts[1] + "`")
                    if not self.state.extern_types[foreign_extern].is_public:
                        try self.state.fail_at(module_index, path.span, "`" + path.parts[1] + "` is private to module `" + self.state.modules[imported].name + "`")
                    return self.state.extern_types[foreign_extern].type_id
                if len(path.parts) != 1:
                    try self.state.fail_at(module_index, path.span, "unknown type `" + path.dotted() + "`")
                let name = path.parts[0]
                let type_binding = self.state.find_type_binding(name)
                if type_binding != none: return type_binding
                let alias_index = try self.find_visible_alias(module_index, name, path.span)
                if alias_index >= 0: return try self.resolve_alias(alias_index)
                if name == "Weak":
                    error(self.state.diagnostic_at(module_index, value.span, "`Weak` needs exactly one class type"))
                let builtin = builtin_type_id(name)
                if builtin != none: return builtin
                let nominal = try self.find_visible_nominal(module_index, name, path.span)
                if nominal != none: return try self.nominal_unapplied_type(module_index, nominal, value.span)
                if standard_interface_named(name) != none:
                    return try self.resolve_value_interface_reference(module_index, value)
                let interface_index = try self.find_visible_interface(module_index, name, path.span)
                if interface_index >= 0:
                    return try self.resolve_value_interface_reference(module_index, value)
                let extern_index = try self.find_visible_extern_type(module_index, name, path.span)
                if extern_index >= 0: return self.state.extern_types[extern_index].type_id
                if is_core_type_name(name):
                    error(self.state.diagnostic_at(module_index, path.span, "type `" + name + "` is not implemented yet"))
                error(self.state.diagnostic_at(module_index, path.span, "unknown type `" + path.dotted() + "`"))
            Applied(path, arguments):
                if len(path.parts) == 1 and standard_interface_named(path.parts[0]) != none:
                    return try self.resolve_value_interface_reference(module_index, value)
                var interface_index = -1
                if len(path.parts) == 1:
                    interface_index = try self.find_visible_interface(module_index, path.parts[0], path.span)
                elif len(path.parts) == 2:
                    let imported = self.state.use_imported_module_of(module_index, path.parts[0], path.parts[1])
                    if imported >= 0: interface_index = self.find_interface_in_module(imported, path.parts[1])
                if interface_index >= 0:
                    return try self.resolve_value_interface_reference(module_index, value)
                let nominal = try self.resolve_nominal_path(module_index, path.parts, path.span)
                if nominal != none: return try self.nominal_application(module_index, nominal, arguments, value.span)
                if profile_of(self.state.modules[module_index].authority) == Profile.base and is_runtime_type_name(path.dotted()):
                    try self.state.fail_at(module_index, value.span, belongs_to_full_luce("`" + path.dotted() + "`", "has no built-in collections, workers, or reference counting (base.md §23)"))
                if path.dotted() == "native_ptr" or path.dotted() == "native_mut_ptr":
                    if self.state.modules[module_index].authority != ModuleAuthority.native:
                        try self.state.fail_at(module_index, value.span, "native pointer types require a `.lucn` module")
                    if len(arguments) != 1:
                        try self.state.fail_at(module_index, value.span, "`" + path.dotted() + "` needs exactly one pointee type")
                    match arguments[0]:
                        TypeArgument(pointee):
                            let pointee_type = try self.resolve_type(module_index, pointee)
                            if self.state.contains_fallible(pointee_type):
                                try self.state.fail_at(module_index, pointee.span, "a native pointer pointee cannot store a fallible type; `T!` is a function-result effect")
                            try self.state.validate_stored_type(module_index, pointee_type, pointee.span, "a native pointer pointee")
                            return self.state.intern_native_pointer(pointee_type, path.dotted() == "native_mut_ptr")
                        else:
                            try self.state.fail_at(module_index, value.span, "`" + path.dotted() + "` needs exactly one pointee type")
                if path.dotted() == "slice" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            try self.state.validate_stored_type(module_index, inner, element.span, "a slice element")
                            return self.state.intern_slice(inner)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
                if path.dotted() == "mutable_slice" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            try self.state.validate_stored_type(module_index, inner, element.span, "a mutable-slice element")
                            return self.state.intern_mutable_slice(inner)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "`mutable_slice` needs exactly one element type"))
                if path.dotted() == "mutable_slice":
                    error(self.state.diagnostic_at(module_index, value.span, "`mutable_slice` needs exactly one element type"))
                if path.dotted() == "list" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            if self.state.contains_fallible(inner):
                                try self.state.fail_at(module_index, element.span, "a list cannot store a fallible type; `T!` is a function-result effect")
                            try self.state.validate_stored_type(module_index, inner, element.span, "a list element")
                            return self.state.intern_list(inner)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "`list` needs exactly one element type"))
                if path.dotted() == "list":
                    error(self.state.diagnostic_at(module_index, value.span, "`list` needs exactly one element type"))
                if path.dotted() == "map" and len(arguments) == 2:
                    var key_type = resolve_builtin_type(BuiltinType.unit)
                    var value_type = resolve_builtin_type(BuiltinType.unit)
                    match arguments[0]:
                        TypeArgument(key): key_type = try self.resolve_type(module_index, key)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`map` needs exactly two type arguments"))
                    match arguments[1]:
                        TypeArgument(element): value_type = try self.resolve_type(module_index, element)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`map` needs exactly two type arguments"))
                    if self.state.contains_fallible(key_type) or self.state.contains_fallible(value_type):
                        try self.state.fail_at(module_index, value.span, "a map cannot store a fallible type; `T!` is a function-result effect")
                    try self.state.validate_stored_type(module_index, key_type, value.span, "a map key")
                    try self.state.validate_stored_type(module_index, value_type, value.span, "a map value")
                    if not self.is_hash_key_type(key_type):
                        try self.state.fail_at(module_index, value.span, "map key type `" + self.state.describe_type(key_type) + "` must satisfy `Equatable & Hashable`")
                    return self.state.intern_map(key_type, value_type)
                if path.dotted() == "map":
                    error(self.state.diagnostic_at(module_index, value.span, "`map` needs exactly two type arguments"))
                if path.dotted() == "set" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let element_type = try self.resolve_type(module_index, element)
                            if self.state.contains_fallible(element_type):
                                try self.state.fail_at(module_index, element.span, "a set cannot store a fallible type; `T!` is a function-result effect")
                            try self.state.validate_stored_type(module_index, element_type, element.span, "a set element")
                            if not self.is_hash_key_type(element_type):
                                try self.state.fail_at(module_index, value.span, "set element type `" + self.state.describe_type(element_type) + "` must satisfy `Equatable & Hashable`")
                            return self.state.intern_set(element_type)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`set` needs exactly one element type"))
                if path.dotted() == "set":
                    error(self.state.diagnostic_at(module_index, value.span, "`set` needs exactly one element type"))
                if path.dotted() == "frozen_list" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let element_type = try self.resolve_type(module_index, element)
                            try self.state.validate_stored_type(module_index, element_type, element.span, "a frozen-list element")
                            return self.state.intern_frozen_list(element_type)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`frozen_list` needs exactly one element type"))
                if path.dotted() == "frozen_list":
                    error(self.state.diagnostic_at(module_index, value.span, "`frozen_list` needs exactly one element type"))
                if path.dotted() == "frozen_map" and len(arguments) == 2:
                    var key_type = resolve_builtin_type(BuiltinType.unit)
                    var value_type = resolve_builtin_type(BuiltinType.unit)
                    match arguments[0]:
                        TypeArgument(key): key_type = try self.resolve_type(module_index, key)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`frozen_map` needs exactly two type arguments"))
                    match arguments[1]:
                        TypeArgument(element): value_type = try self.resolve_type(module_index, element)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`frozen_map` needs exactly two type arguments"))
                    try self.state.validate_stored_type(module_index, key_type, value.span, "a frozen-map key")
                    try self.state.validate_stored_type(module_index, value_type, value.span, "a frozen-map value")
                    if not self.is_hash_key_type(key_type):
                        try self.state.fail_at(module_index, value.span, "frozen-map key type `" + self.state.describe_type(key_type) + "` must satisfy `Equatable & Hashable`")
                    return self.state.intern_frozen_map(key_type, value_type)
                if path.dotted() == "frozen_map":
                    error(self.state.diagnostic_at(module_index, value.span, "`frozen_map` needs exactly two type arguments"))
                if path.dotted() == "frozen_set" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let element_type = try self.resolve_type(module_index, element)
                            try self.state.validate_stored_type(module_index, element_type, element.span, "a frozen-set element")
                            if not self.is_hash_key_type(element_type):
                                try self.state.fail_at(module_index, value.span, "frozen-set element type `" + self.state.describe_type(element_type) + "` must satisfy `Equatable & Hashable`")
                            return self.state.intern_frozen_set(element_type)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`frozen_set` needs exactly one element type"))
                if path.dotted() == "frozen_set":
                    error(self.state.diagnostic_at(module_index, value.span, "`frozen_set` needs exactly one element type"))
                if path.dotted() == "task" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(result):
                            let result_type = try self.resolve_type(module_index, result)
                            if self.state.contains_fallible(result_type):
                                try self.state.fail_at(module_index, result.span, "`task` names the successful worker result; write `task[T]`, not `task[T!]`")
                            return self.state.intern_task(result_type)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "`task` needs exactly one result type"))
                if path.dotted() == "task":
                    error(self.state.diagnostic_at(module_index, value.span, "`task` needs exactly one result type"))
                if path.dotted() == "Weak" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(referent):
                            let inner = try self.resolve_type(module_index, referent)
                            if self.class_of(inner) < 0:
                                try self.state.fail_at(module_index, referent.span, "`Weak[T]` requires a class type, found `" + self.state.describe_type(inner) + "`")
                            return self.state.intern_weak(inner)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "`Weak` needs exactly one class type"))
                if path.dotted() == "Weak":
                    error(self.state.diagnostic_at(module_index, value.span, "`Weak` needs exactly one class type"))
                if path.dotted() == "range" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            if not is_integer_type(self.state.types, inner):
                                error(self.state.diagnostic_at(module_index, value.span, "`range` needs an integer element type"))
                            return self.state.intern_range(inner)
                        else:
                            error(self.state.diagnostic_at(module_index, value.span, "`range` needs one type argument"))
                if path.dotted() == "array" and len(arguments) == 2:
                    var element_type = resolve_builtin_type(BuiltinType.unit)
                    var count = -1
                    match arguments[0]:
                        TypeArgument(element): element_type = try self.resolve_type(module_index, element)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`array` needs an element type followed by a nonnegative integer length"))
                    match arguments[1]:
                        IntegerArgument(token): count = try self.state.decode_integer_at(module_index, token)
                        else: error(self.state.diagnostic_at(module_index, value.span, "`array` needs an element type followed by a nonnegative integer length"))
                    if count < 0: error(self.state.diagnostic_at(module_index, value.span, "`array` length cannot be negative"))
                    try self.state.validate_stored_type(module_index, element_type, value.span, "an array element")
                    return self.state.intern_array(element_type, count)
                if path.dotted() == "array":
                    error(self.state.diagnostic_at(module_index, value.span, "`array` needs an element type followed by a nonnegative integer length"))
                error(self.state.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
            GroupedType(grouped):
                return try self.resolve_type(module_index, grouped)
            TupleType(elements):
                let parts = list[TypeId]()
                for element in elements:
                    let part = try self.resolve_type(module_index, element)
                    try self.state.validate_stored_type(module_index, part, element.span, "a tuple element")
                    parts.append(part)
                return self.state.intern_tuple(parts)
            FunctionType(parameters, result):
                let parts = list[TypeId]()
                for parameter in parameters:
                    let parameter_type = try self.resolve_type(module_index, parameter)
                    if self.state.contains_fallible(parameter_type):
                        try self.state.fail_at(module_index, parameter.span, "a function-type parameter cannot store a fallible type; `T!` is a function-result effect")
                    try self.state.validate_parameter_type(module_index, parameter_type, parameter.span, "a function-type parameter")
                    if self.state.contains_task_value(parameter_type):
                        try self.state.fail_at(module_index, parameter.span, "a function value cannot receive a structured `task`; use a direct Luce call")
                    parts.append(parameter_type)
                let result_type = try self.resolve_type(module_index, result)
                try self.state.validate_function_result(module_index, result_type, result.span)
                return self.state.intern_function_type(parts, result_type)
            CFunctionType(parameters, result):
                let parts = list[TypeId]()
                for parameter in parameters:
                    let parameter_type = try self.resolve_type(module_index, parameter)
                    if not self.is_c_function_component(parameter_type):
                        try self.state.fail_at(module_index, parameter.span, "a `cfunc` parameter has unsupported C boundary type `" + self.state.describe_type(parameter_type) + "`")
                    parts.append(parameter_type)
                let result_type = try self.resolve_type(module_index, result)
                if not types_match(result_type, resolve_builtin_type(BuiltinType.unit)) and not self.is_c_function_component(result_type):
                    try self.state.fail_at(module_index, result.span, "a `cfunc` result has unsupported C boundary type `" + self.state.describe_type(result_type) + "`")
                return self.state.intern_c_function_type(parts, result_type)
            OptionalType(optional_value):
                let inner = try self.resolve_type(module_index, optional_value)
                if self.is_extern_struct(inner):
                    try self.state.fail_at(module_index, value.span, "extern struct `" + self.state.describe_type(inner) + "` is a value, not a nullable C pointer")
                try self.state.validate_stored_type(module_index, inner, optional_value.span, "an optional payload")
                return self.state.intern_optional(inner)
            FallibleType(successful_value):
                return self.state.intern_fallible(try self.resolve_type(module_index, successful_value))

    # Derived structural markers carry compile-time proofs only. They have no
    # witness requirements or runtime existential representation and therefore
    # may appear only in generic constraint lists.
    func resolve_value_interface_reference(module_index: i64, value: TypeSyntax) -> TypeId!:
        let resolved = try self.resolve_interface_reference(module_index, value)
        let standard = standard_interface_of(self.state, resolved)
        if standard != none:
            let identity = standard
            if identity == StandardInterface.equatable or identity == StandardInterface.hashable:
                try self.state.fail_at(module_index, value.span, "`" + self.state.describe_type(resolved) + "` may appear only in a generic constraint")
        return resolved

# The compiler-known generic type names whose values the Luce runtime owns;
# a Base module may not spell them (base.md §23).
func is_runtime_type_name(name: str) -> bool:
    return name == "list" or name == "map" or name == "set" or name == "slice" or name == "mutable_slice" or name == "frozen_list" or name == "frozen_map" or name == "frozen_set" or name == "task" or name == "Weak"
