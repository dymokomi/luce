#==============================================================================================
#
#   hir_sendability - Structural worker-transfer proofs
#
#   DESCRIPTION:
#       Decides whether one resolved HIR type is immutable copied data under
#       language §19. The proof follows semantic fields and type arguments;
#       it knows nothing about a serializer, process, thread, pointer width,
#       or backend. The first rejected edge retains its source-facing path so
#       spawn diagnostics identify the exact reason transfer is impossible.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.hir.generation_model import HirGenerationState
from compiler.hir.ir import TypeId

# mark: Structural proof =======================================================================

pub class SendabilityChecker:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    ## Require one complete value graph to cross a worker boundary. `subject`
    ## is already source-facing (`spawn argument `scene`` or `worker result`)
    ## and becomes the root of every recursively reported path.
    pub func require(value_type: TypeId, span: SourceSpan, subject: str) -> !:
        let visited = list[bool]()
        for definition in self.state.types.definitions: visited.append(false)
        let failure = self.first_failure(value_type, subject, visited)
        if failure != none:
            try self.state.fail_at(self.state.current_module, span, failure)

    func first_failure(value_type: TypeId, path: str, visited: list[bool]) -> str?:
        if i64(value_type.value) >= len(self.state.types.definitions):
            return path + " has an invalid semantic type"
        while len(visited) < len(self.state.types.definitions): visited.append(false)
        if visited[value_type.value]: return none
        visited[value_type.value] = true

        match self.state.types.definitions[value_type.value].form:
            Unit, Boolean, Never, Integer, PointerInteger, Pointer, Span, StringView, Atomic, Floating, Character, String, Bytes, ErrorCode, Error:
                return none
            Range(element): return self.first_failure(element, path + ".element", visited)
            Slice(element): return self.first_failure(element, path + ".element", visited)
            Array(element, count): return self.first_failure(element, path + ".element", visited)
            Optional(value): return self.first_failure(value, path + ".some", visited)
            Tuple(elements):
                for index in range(0, len(elements)):
                    let failure = self.first_failure(elements[index], path + "." + str(index), visited)
                    if failure != none: return failure
                return none
            Struct(index, arguments):
                let item = self.state.structs[index]
                for field in item.fields:
                    let concrete = self.state.substitute_type(field.value_type, item.generic_id, arguments)
                    let failure = self.first_failure(concrete, path + "." + field.name, visited)
                    if failure != none: return failure
                return none
            Enum(index, arguments):
                let item = self.state.enums[index]
                for case_value in item.cases:
                    for field in case_value.payload:
                        let concrete = self.state.substitute_type(field.value_type, item.generic_id, arguments)
                        let failure = self.first_failure(concrete, path + "." + case_value.name + "." + field.name, visited)
                        if failure != none: return failure
                return none
            FrozenList(element): return self.first_failure(element, path + ".element", visited)
            FrozenMap(key, value):
                let key_failure = self.first_failure(key, path + ".key", visited)
                if key_failure != none: return key_failure
                return self.first_failure(value, path + ".value", visited)
            FrozenSet(element): return self.first_failure(element, path + ".element", visited)
            MutableSlice(element): return self.rejection(path, value_type, "callback-scoped mutable access cannot cross workers")
            List(element): return self.rejection(path, value_type, "mutable list identity is not sendable; transfer an immutable snapshot")
            Map(key, value): return self.rejection(path, value_type, "mutable map identity is not sendable; transfer an immutable snapshot")
            Set(element): return self.rejection(path, value_type, "mutable set identity is not sendable; transfer an immutable snapshot")
            Task(result): return self.rejection(path, value_type, "task handles belong to their creating function's structured group")
            Weak(value): return self.rejection(path, value_type, "weak handles retain worker-local class identity")
            Class(index, arguments): return self.rejection(path, value_type, "class identity is shared mutable state")
            Function(parameters, result): return self.rejection(path, value_type, "function values and closure environments do not cross workers")
            CFunction(parameters, result): return self.rejection(path, value_type, "C function pointers are process-local capabilities")
            Interface(index, arguments): return self.rejection(path, value_type, "interface values erase a worker-local representation")
            Foreign: return self.rejection(path, value_type, "raw foreign pointers are process-local capabilities")
            NativePointer(pointee, is_mutable): return self.rejection(path, value_type, "native pointers and borrows cannot cross workers")
            Extern(index): return self.rejection(path, value_type, "native resource handles require generated transferable-token semantics")
            TypeParameter(generic, position): return self.rejection(path, value_type, "sendability cannot be proven for an abstract type parameter")
            Fallible(value): return self.rejection(path, value_type, "fallibility is control flow, not transferable value storage")

    func rejection(path: str, value_type: TypeId, reason: str) -> str:
        return path + " has non-sendable type `" + self.state.describe_type(value_type) + "`: " + reason
