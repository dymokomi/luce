#==============================================================================================
#
#   full_declarations - What declaration collection decides only for full Luce
#
#   DESCRIPTION:
#       Full Luce's side of `ProfileDeclarations` (plan.md §5.0): mutable
#       module globals belong to the sealed runtime package alone, begin at
#       structural zero, and take no initialiser; no type name is spelled
#       differently from the shared table.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import RuntimeGlobalSyntax
from compiler.hir.generation_model import HirGenerationState, HirSemanticChecker, ProfileDeclarations
from compiler.hir.ir import PackageRole, TypeId

pub class FullProfileDeclarations: ProfileDeclarations:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    pub func validate_global(module_index: i64, is_public: bool, global: RuntimeGlobalSyntax, span: SourceSpan) -> !:
        if self.state.package_role != PackageRole.sealed_runtime:
            try self.state.fail_at(module_index, span, "mutable module globals are reserved for the sealed runtime package")
        if is_public:
            try self.state.fail_at(module_index, span, "a sealed runtime global must be module-private")
        if global.initializer != none:
            try self.state.fail_at(module_index, span, "a sealed runtime global begins at structural zero and takes no initialiser")

    pub func validate_uninitialised_global(checker: HirSemanticChecker, module_index: i64, global: RuntimeGlobalSyntax, value_type: TypeId) -> !:
        if not self.state.has_structural_zero(value_type):
            try self.state.fail_at(module_index, global.value_type.span, "runtime global `" + global.name + "` needs a structurally zero-initializable value type")

    pub func builtin_type_named(name: str) -> TypeId?:
        return none
