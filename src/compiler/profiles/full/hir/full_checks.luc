#==============================================================================================
#
#   full_checks - What the checker decides only for a full-Luce module
#
#   DESCRIPTION:
#       Full Luce's side of `ProfileChecks` (plan.md §5.0): text literals are
#       owned strings, slices follow the runtime collections, integer
#       division floors, no named builtin answers layout questions, `Error`
#       carries an owned string, and nothing converts implicitly. Base's side
#       is `profiles/base/hir/base_checks.luc`.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import ArgumentSyntax, ExpressionSyntax, FormatPartSyntax, TypeArgumentSyntax
from compiler.frontend.tokenizer import Token
from compiler.hir.generation_model import CheckedBinaryOperands, HirGenerationState, HirSemanticChecker, ProfileChecks, ResolvedBinary
from compiler.hir.ir import BinaryOperation, BuiltinType, NodeId, TypeId, resolve_builtin_type

pub class FullProfileChecks: ProfileChecks:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    pub func text_literal_type() -> TypeId:
        return resolve_builtin_type(BuiltinType.string)

    pub func adapt_text_literal(semantics: HirSemanticChecker, text: NodeId, expected: TypeId?) -> NodeId?:
        return none

    pub func check_slice(semantics: HirSemanticChecker, sliced: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan, expected: TypeId?) -> NodeId!:
        return try semantics.check_common_slice_for_feature(sliced, start, end, span, expected)

    pub func check_span_slice(semantics: HirSemanticChecker, value: NodeId, element: TypeId, is_const: bool, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan, expected: TypeId?) -> NodeId!:
        error(self.state.diagnostic_at(self.state.current_module, span, "a span slice belongs to Luce Base; a `.luc` module has no spans (base.md §5.4)"))

    pub func check_binary_operands(semantics: HirSemanticChecker, left: ExpressionSyntax, right: ExpressionSyntax, operator: str, context: TypeId?) -> CheckedBinaryOperands?!:
        return none

    pub func resolve_pointer_arithmetic(semantics: HirSemanticChecker, operator: str, operands: CheckedBinaryOperands, span: SourceSpan, expected: TypeId?) -> NodeId?!:
        return none

    pub func widen_binary_operands(semantics: HirSemanticChecker, operands: CheckedBinaryOperands) -> CheckedBinaryOperands!:
        return operands

    ## Full Luce floors (spec §7.2).
    pub func integer_division(operator: str, operand_type: TypeId) -> ResolvedBinary:
        if operator == "//": return ResolvedBinary(operation = BinaryOperation.FloorDivide(operand_type = operand_type), result = operand_type)
        return ResolvedBinary(operation = BinaryOperation.Remainder(operand_type = operand_type), result = operand_type)

    pub func check_named_builtin(semantics: HirSemanticChecker, name: str, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId?!:
        return none

    pub func error_text_type() -> TypeId:
        return resolve_builtin_type(BuiltinType.string)

    pub func convert_implicitly(semantics: HirSemanticChecker, value: NodeId, found: TypeId, expected: TypeId) -> NodeId?!:
        return none

    pub func convert_interface_value(semantics: HirSemanticChecker, value: NodeId, found: TypeId, expected: TypeId) -> NodeId?!:
        return try semantics.convert_existential_for_feature(value, found, expected)

    ## A `mutating` requirement needs a mutable receiver (spec §14).
    pub func check_interface_receiver(semantics: HirSemanticChecker, receiver: NodeId, is_mutating: bool, span: SourceSpan) -> !:
        if is_mutating: try semantics.require_mutable_receiver_for_feature(receiver, span)

    # mark: Intrinsics and formatted output =====================================================

    ## Full Luce's standard modules are `.luc` files whose intrinsics the
    ## shared checker resolves itself; nothing reaches this profile hook.
    pub func check_intrinsic(semantics: HirSemanticChecker, name: str, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        error(self.state.diagnostic_at(self.state.current_module, span, "unknown standard-library intrinsic `Builtin." + name + "`"))

    ## `print(f"...")` prints the formatted string value.
    pub func check_formatted_print(semantics: HirSemanticChecker, start: Token, parts: list[FormatPartSyntax], span: SourceSpan) -> list[NodeId]?!:
        return none

    ## A formatted string is a value in full Luce; `write` receives it as one.
    pub func check_formatted_write(semantics: HirSemanticChecker, receiver: NodeId, owner_type: TypeId, start: Token, parts: list[FormatPartSyntax], span: SourceSpan, expected: TypeId?) -> NodeId?!:
        return none
