#==============================================================================================
#
#   entry - Full Luce's process entry contract
#
#   DESCRIPTION:
#       `pub func main(arguments: slice[str]) -> i32!` (spec §20.5). The
#       shared entry pass selects the profile; everything full-Luce-specific
#       about the contract is here.
#
#==============================================================================================

from compiler.hir.generation_model import FunctionSymbol, HirGenerationState
from compiler.hir.ir import BuiltinType, resolve_builtin_type, types_match

pub func require_full_entry_contract(state: HirGenerationState, function: FunctionSymbol) -> !:
    if len(function.parameters) != 1:
        try fail(state, function, "must declare exactly one `arguments: slice[str]` parameter")
    let parameter = function.parameters[0]
    if parameter.name != "arguments":
        try fail(state, function, "parameter must be named `arguments`")
    if not types_match(parameter.value_type, resolve_builtin_type(BuiltinType.string_slice)):
        try fail(state, function, "parameter `arguments` must have type `slice[str]`")
    match state.types.definitions[function.result.value].form:
        Fallible(success):
            if types_match(success, resolve_builtin_type(BuiltinType.signed_i32)): return
        else: pass
    try fail(state, function, "result must be `i32!`")

func fail(state: HirGenerationState, function: FunctionSymbol, detail: str) -> !:
    try state.fail_at(
        function.module_index, function.span,
        "invalid process entry `main`: " + detail + "; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
