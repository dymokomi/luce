#==============================================================================================
#
#   full_profile_wasm_planning - What the module plan must know about runtime instructions
#
#   DESCRIPTION:
#       The WebAssembly module plan decides the function table, descriptor
#       storage, and signature table from the instructions a program uses.
#       For the instructions only full Luce has, these three queries answer
#       the plan's questions: which target has no WASI legalization, which
#       functions are called through descriptors, and which call signatures
#       must be interned. `backends/wasm_plan` is the dispatch point; this
#       module names only canonical MIR vocabulary.
#
#==============================================================================================

from compiler.mir.canonical import BuiltinMirType, FunctionId, InstructionForm, MirProgram, MirSignature, TypeId, builtin_mir_type

## The diagnostic for a runtime instruction this target cannot legalize:
## isolated workers have no WASI preview 1 domain primitive.
pub func runtime_rejection(form: InstructionForm) -> str?:
    match form:
        TaskGroupCreate(result): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        TaskGroupFinish(group): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        TaskSpawn(result, group, target, arguments): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        TaskWait(result, destination, failure, error_destination, task): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        TaskWaitAll(result, failure, error_destination, tasks): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        TaskCancel(task): return "wasm backend: isolated tasks are unsupported on WASI preview 1"
        else: return none

## The functions a runtime instruction reaches through a descriptor: typed
## retain/release callbacks and class, cell, and closure destroyers.
pub func runtime_descriptor_targets(program: MirProgram, form: InstructionForm) -> list[FunctionId]:
    match form:
        HashRelease(value, key_release, value_release): return [key_release, value_release]
        HashCopy(result, value, key_retain, value_retain): return [key_retain, value_retain]
        HashSnapshot(result, value, key_retain, value_retain): return [key_retain, value_retain]
        HashClear(value, key_release, value_release): return [key_release, value_release]
        ListRelease(value, element_release): return [element_release]
        ListCopy(result, value, element_retain): return [element_retain]
        ListSnapshot(result, value, element_retain): return [element_retain]
        ListConcat(result, left, right, element_retain): return [element_retain]
        ListAppendSlot(result, value, element_retain): return [element_retain]
        ListInsertSlot(result, value, index, element_retain): return [element_retain]
        ListRemoveAt(value, index, element_retain): return [element_retain]
        ListClear(value, element_release): return [element_release]
        ListReserve(value, minimum_capacity, element_retain): return [element_retain]
        ListMutableElementAddress(result, value, index, element_retain): return [element_retain]
        SliceRelease(value, element_release): return [element_release]
        ClassCreate(result, identity): return [program.classes[identity.value].destroyer]
        CellCreate(result, element_type, destroyer): return [destroyer]
        ClosureCreate(environment, destination, function_type, closure): return [program.closures[closure.value].destroyer]
        else: return list[FunctionId]()

## The call signatures a dynamic runtime call needs in the type table: the
## source-visible closure signature and its hidden-environment form, or an
## interface requirement's signature.
pub func runtime_call_signatures(program: MirProgram, form: InstructionForm) -> list[MirSignature]:
    match form:
        CallClosure(results, signature, target, arguments):
            let hidden_parameters = list[TypeId]()
            for parameter in signature.parameters: hidden_parameters.append(parameter)
            var environment_index: i64 = 0
            if signature.is_fallible: environment_index = 1
            hidden_parameters.insert(environment_index, builtin_mir_type(BuiltinMirType.pointer))
            let hidden = MirSignature(parameters = hidden_parameters, results = signature.results, is_fallible = signature.is_fallible, returns_never = signature.returns_never)
            return [signature, hidden]
        CallInterface(results, interface_id, requirement, target, arguments):
            return [program.interfaces[interface_id.value].requirements[requirement].signature]
        else: return list[MirSignature]()
