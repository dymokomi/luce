#==============================================================================================
#
#   full_profile_wasm_emission - WebAssembly encoding of the instructions only full Luce has
#
#   DESCRIPTION:
#       Encodes the canonical instructions whose semantics the Luce runtime
#       supplies into WebAssembly: typed lists and hash collections, snapshot
#       slices, equality contexts, class identities with weak slots,
#       existential boxes, closure environments and cells, and dynamic calls
#       through descriptors and witness tables. It also encodes the full-Luce
#       process entry, which materializes WASI `argv` as an owned
#       `slice[str]`. `backends/wasm` is the one dispatch point that reaches
#       these functions; they build on the shared byte vocabulary in
#       `backends/wasm_encoding` and the module plan.
#
#       Layout facts are legal here: this is the backend side of the boundary.
#
#==============================================================================================

from compiler.backends.wasm_plan import ModulePlan, WasmSignature, defined_function_index, frame_alignment, i32_value_type, signature_index, wasm_signature
from compiler.mir.canonical import MirClass, MirFunction, MirInstruction, MirProgram, MirSignature, MirTypeTable, RegisterId, RegisterRun, TypeId, find_runtime_binding, mir_type, register_at
from compiler.runtime_contract import RuntimeService
from compiler.backends.wasm_encoding import append_constant, append_function_descriptor, append_memory_op, append_trap_if_true, append_unsigned, empty_block_type, encode_function_value, encode_index_guard, encode_pointer_runtime_call, i64_value_type, local_get, local_get_index
from compiler.backends.wasm_encoding import local_set, local_set_index, opcode_block, opcode_br, opcode_br_if, opcode_call, opcode_call_indirect, opcode_else, opcode_end, opcode_global_get, opcode_global_set, opcode_i32_add
from compiler.backends.wasm_encoding import opcode_i32_and, opcode_i32_eqz, opcode_i32_ge_u, opcode_i32_gt_u, opcode_i32_load, opcode_i32_lt_u, opcode_i32_mul, opcode_i32_store, opcode_i32_store8, opcode_i32_sub, opcode_i32_wrap_i64, opcode_i64_add
from compiler.backends.wasm_encoding import opcode_i64_extend_i32_u, opcode_i64_gt_u, opcode_i64_mul, opcode_i64_store, opcode_if, opcode_local_tee, opcode_loop, recycling_alignment, scratch_iovec_buffer, scratch_iovec_length, storage_alignment

# mark: Instructions ==========================================================================

## One straight-line runtime instruction. False when the instruction is
## shared and the module encoder legalizes it itself.
pub func encode_runtime_instruction(program: MirProgram, plan: ModulePlan, function: MirFunction, instruction: MirInstruction, body: list[u8]) -> bool!:
    let types = program.types
    match instruction.form:
        EqualityContextCreate(result):
            let service = find_runtime_binding(program, RuntimeService.equality_context_create) else error("wasm backend: verified `EqualityContextCreate` has no runtime binding")
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        EqualityContextRelease(value):
            let service = find_runtime_binding(program, RuntimeService.equality_context_release) else error("wasm backend: verified `EqualityContextRelease` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        EqualityContextVisit(result, context, left, right):
            let service = find_runtime_binding(program, RuntimeService.equality_context_visit) else error("wasm backend: verified `EqualityContextVisit` has no runtime binding")
            local_get(body, context)
            local_get(body, left)
            local_get(body, right)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashCreate(result):
            let service = find_runtime_binding(program, RuntimeService.hash_create) else error("wasm backend: verified `HashCreate` has no runtime binding")
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashRetain(value):
            let service = find_runtime_binding(program, RuntimeService.hash_retain) else error("wasm backend: verified `HashRetain` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        HashRelease(value, key_release, value_release):
            let service = find_runtime_binding(program, RuntimeService.hash_release) else error("wasm backend: verified `HashRelease` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            append_function_descriptor(plan, body, key_release)
            append_function_descriptor(plan, body, value_release)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        HashCopy(result, value, key_retain, value_retain):
            let service = find_runtime_binding(program, RuntimeService.hash_copy) else error("wasm backend: verified `HashCopy` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            append_function_descriptor(plan, body, key_retain)
            append_function_descriptor(plan, body, value_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashSnapshot(result, value, key_retain, value_retain):
            let service = find_runtime_binding(program, RuntimeService.hash_copy) else error("wasm backend: verified `HashSnapshot` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            append_function_descriptor(plan, body, key_retain)
            append_function_descriptor(plan, body, value_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashLength(result, value):
            let service = find_runtime_binding(program, RuntimeService.hash_length) else error("wasm backend: verified `HashLength` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashIterationBegin(result, value):
            let service = find_runtime_binding(program, RuntimeService.hash_iteration_begin) else error("wasm backend: verified `HashIterationBegin` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashIterationEnd(value):
            let service = find_runtime_binding(program, RuntimeService.hash_iteration_end) else error("wasm backend: verified `HashIterationEnd` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        HashFindFirst(result, value, key_hash):
            let service = find_runtime_binding(program, RuntimeService.hash_find_first) else error("wasm backend: verified `HashFindFirst` has no runtime binding")
            local_get(body, value)
            local_get(body, key_hash)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashFindNext(result, value, current_candidate):
            let service = find_runtime_binding(program, RuntimeService.hash_find_next) else error("wasm backend: verified `HashFindNext` has no runtime binding")
            local_get(body, value)
            local_get(body, current_candidate)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashKeyAddress(result, value, index):
            let service = find_runtime_binding(program, RuntimeService.hash_key_address) else error("wasm backend: verified `HashKeyAddress` has no runtime binding")
            let key_type = try hash_key_type(types, function, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(key_type), true)
            local_get(body, index)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashValueAddress(result, value, index):
            let service = find_runtime_binding(program, RuntimeService.hash_value_address) else error("wasm backend: verified `HashValueAddress` has no runtime binding")
            let value_type = try hash_value_type(types, function, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(value_type), true)
            local_get(body, index)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashInsertEntry(result, value, key_hash):
            let service = find_runtime_binding(program, RuntimeService.hash_insert_entry) else error("wasm backend: verified `HashInsertEntry` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            local_get(body, key_hash)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        HashRemoveEntry(value, index):
            let service = find_runtime_binding(program, RuntimeService.hash_remove_entry) else error("wasm backend: verified `HashRemoveEntry` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            local_get(body, index)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        HashClear(value, key_release, value_release):
            let service = find_runtime_binding(program, RuntimeService.hash_clear) else error("wasm backend: verified `HashClear` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            append_function_descriptor(plan, body, key_release)
            append_function_descriptor(plan, body, value_release)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        HashReserve(value, minimum_capacity):
            let service = find_runtime_binding(program, RuntimeService.hash_reserve) else error("wasm backend: verified `HashReserve` has no runtime binding")
            local_get(body, value)
            try append_hash_layout_arguments(program, plan, function, body, value)
            local_get(body, minimum_capacity)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListCreate(result):
            let service = find_runtime_binding(program, RuntimeService.list_create) else error("wasm backend: verified `ListCreate` has no runtime binding")
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListRetain(value):
            let service = find_runtime_binding(program, RuntimeService.list_retain) else error("wasm backend: verified `ListRetain` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListRelease(value, element_release):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_release) else error("wasm backend: verified `ListRelease` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_release)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListCopy(result, value, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_copy) else error("wasm backend: verified `ListCopy` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListSnapshot(result, value, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_copy) else error("wasm backend: verified `ListSnapshot` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListConcat(result, left, right, element_retain):
            let element_type = try list_element_type(types, function, left)
            let service = find_runtime_binding(program, RuntimeService.list_concat) else error("wasm backend: verified `ListConcat` has no runtime binding")
            local_get(body, left)
            local_get(body, right)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListLength(result, value):
            let service = find_runtime_binding(program, RuntimeService.list_length) else error("wasm backend: verified `ListLength` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListIterationBegin(result, value):
            let service = find_runtime_binding(program, RuntimeService.list_iteration_begin) else error("wasm backend: verified `ListIterationBegin` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListIterationEnd(value):
            let service = find_runtime_binding(program, RuntimeService.list_iteration_end) else error("wasm backend: verified `ListIterationEnd` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListMutableSliceBegin(result, value, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_mutable_slice_begin) else error("wasm backend: verified `ListMutableSliceBegin` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        MutableSliceEnd(value):
            let service = find_runtime_binding(program, RuntimeService.list_iteration_end) else error("wasm backend: verified `MutableSliceEnd` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        MutableSliceLength(result, value):
            let service = find_runtime_binding(program, RuntimeService.list_length) else error("wasm backend: verified `MutableSliceLength` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        MutableSliceElementAddress(result, value, index, element_retain):
            let element_type = try mutable_slice_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_mutable_element_address) else error("wasm backend: verified `MutableSliceElementAddress` has no runtime binding")
            try encode_list_index_guard(program, plan, body, value, index, false)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            local_get(body, index)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListAppendSlot(result, value, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_append_slot) else error("wasm backend: verified `ListAppendSlot` has no runtime binding")
            try encode_list_shape_guard(program, plan, body, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListInsertSlot(result, value, index, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_insert_slot) else error("wasm backend: verified `ListInsertSlot` has no runtime binding")
            try encode_list_index_guard(program, plan, body, value, index, true)
            try encode_list_shape_guard(program, plan, body, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            local_get(body, index)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListRemoveAt(value, index, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_remove_at) else error("wasm backend: verified `ListRemoveAt` has no runtime binding")
            try encode_list_index_guard(program, plan, body, value, index, false)
            try encode_list_shape_guard(program, plan, body, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            local_get(body, index)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListClear(value, element_release):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_clear) else error("wasm backend: verified `ListClear` has no runtime binding")
            try encode_list_shape_guard(program, plan, body, value)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_release)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListReserve(value, minimum_capacity, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_reserve) else error("wasm backend: verified `ListReserve` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            local_get(body, minimum_capacity)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        ListElementAddress(result, value, index):
            try encode_list_element_address(program, plan, function, body, result, value, index)
        ListMutableElementAddress(result, value, index, element_retain):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_mutable_element_address) else error("wasm backend: verified `ListMutableElementAddress` has no runtime binding")
            try encode_list_index_guard(program, plan, body, value, index, false)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            local_get(body, index)
            append_function_descriptor(plan, body, element_retain)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ListSlice(result, value, start, end):
            let element_type = try list_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.list_slice) else error("wasm backend: verified `ListSlice` has no runtime binding")
            local_get(body, start)
            local_get(body, end)
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
            let length_service = find_runtime_binding(program, RuntimeService.list_length) else error("wasm backend: verified `ListSlice` has no length binding")
            local_get(body, end)
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(length_service.value)))
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            local_get(body, start)
            local_get(body, end)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        BytesSlice(result, owner, data, length, start, end):
            local_get(body, start)
            local_get(body, end)
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
            local_get(body, end)
            local_get(body, length)
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
            let service = find_runtime_binding(program, RuntimeService.bytes_slice) else error("wasm backend: verified `BytesSlice` has no runtime binding")
            local_get(body, owner)
            local_get(body, data)
            local_get(body, start)
            local_get(body, end)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        SliceLength(result, value):
            let service = find_runtime_binding(program, RuntimeService.slice_length) else error("wasm backend: verified `SliceLength` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        SliceRetain(value):
            let service = find_runtime_binding(program, RuntimeService.slice_retain) else error("wasm backend: verified `SliceRetain` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        SliceRelease(value, element_release):
            let element_type = try slice_element_type(types, function, value)
            let service = find_runtime_binding(program, RuntimeService.slice_release) else error("wasm backend: verified `SliceRelease` has no runtime binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, element_release)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        SliceElementAddress(result, value, index):
            let element_type = try slice_element_type(types, function, value)
            let length_service = find_runtime_binding(program, RuntimeService.slice_length) else error("wasm backend: verified `SliceElementAddress` has no length binding")
            encode_index_guard(plan, body, value, index, false, length_service)
            let service = find_runtime_binding(program, RuntimeService.slice_element_address) else error("wasm backend: verified `SliceElementAddress` has no address binding")
            local_get(body, value)
            append_constant(body, plan.layout.size_of(element_type), true)
            local_get(body, index)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ClassCreate(result, identity):
            let metadata = program.classes[identity.value]
            let service = find_runtime_binding(program, RuntimeService.class_create) else error("wasm backend: verified `ClassCreate` has no runtime binding")
            append_constant(body, plan.layout.class_payload_size(metadata), true)
            append_constant(body, recycling_alignment(plan, plan.layout.class_payload_align(metadata)), true)
            append_function_descriptor(plan, body, metadata.destroyer)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ClassMarkInitialized(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_mark_initialized, value, "ClassMarkInitialized")
        ClassRetain(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_retain, value, "ClassRetain")
        ClassRelease(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_release, value, "ClassRelease")
        ClassFieldAddress(result, value, field):
            let metadata = try class_metadata_of(program, function, value, "ClassFieldAddress")
            let service = find_runtime_binding(program, RuntimeService.class_payload) else error("wasm backend: verified `ClassFieldAddress` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            append_constant(body, plan.layout.class_field_offset(metadata, field), false)
            body.append(opcode_i32_add)
            local_set(body, result)
        WeakClassCreate(result, value):
            let service = find_runtime_binding(program, RuntimeService.weak_class_create) else error("wasm backend: verified `WeakClassCreate` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        WeakClassRetain(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.weak_class_retain, value, "WeakClassRetain")
        WeakClassRelease(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.weak_class_release, value, "WeakClassRelease")
        WeakClassPromote(destination, value, optional_type):
            let service = find_runtime_binding(program, RuntimeService.weak_class_promote) else error("wasm backend: verified `WeakClassPromote` has no runtime binding")
            let payload_offset = plan.layout.enum_payload_offset(optional_type)
            # Store the promoted nullable handle in the optional payload first;
            # its nonzero bit then becomes the canonical u8 present tag.
            local_get(body, destination)
            append_constant(body, payload_offset, false)
            body.append(opcode_i32_add)
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            append_memory_op(body, opcode_i32_store, 2)
            local_get(body, destination)
            local_get(body, destination)
            append_constant(body, payload_offset, false)
            body.append(opcode_i32_add)
            append_memory_op(body, opcode_i32_load, 2)
            body.append(opcode_i32_eqz)
            body.append(opcode_i32_eqz)
            append_memory_op(body, opcode_i32_store8, 0)
        InterfaceCreate(result, source, conformance_id):
            let conformance = program.conformances[conformance_id.value]
            let service = find_runtime_binding(program, RuntimeService.interface_create) else error("wasm backend: verified `InterfaceCreate` has no runtime binding")
            local_get(body, source)
            append_constant(body, plan.layout.size_of(conformance.value_type), true)
            append_constant(body, storage_alignment(plan, conformance.value_type), true)
            append_function_descriptor(plan, body, conformance.retain)
            append_function_descriptor(plan, body, conformance.release)
            append_constant(body, plan.conformance_offsets[conformance_id.value], false)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        InterfaceRetain(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.interface_retain, value, "InterfaceRetain")
        InterfaceRelease(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.interface_release, value, "InterfaceRelease")
        InterfaceDetach(result, value):
            let service = find_runtime_binding(program, RuntimeService.interface_detach) else error("wasm backend: verified `InterfaceDetach` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        InterfacePayload(result, value):
            let service = find_runtime_binding(program, RuntimeService.interface_payload) else error("wasm backend: verified `InterfacePayload` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        CellCreate(result, element_type, destroyer):
            let service = find_runtime_binding(program, RuntimeService.class_create) else error("wasm backend: verified `CellCreate` has no runtime binding")
            append_constant(body, plan.layout.size_of(element_type), true)
            append_constant(body, storage_alignment(plan, element_type), true)
            append_function_descriptor(plan, body, destroyer)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        CellMarkInitialized(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_mark_initialized, value, "CellMarkInitialized")
        CellRetain(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_retain, value, "CellRetain")
        CellRelease(value):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_release, value, "CellRelease")
        CellValueAddress(result, value, element_type):
            let service = find_runtime_binding(program, RuntimeService.class_payload) else error("wasm backend: verified `CellValueAddress` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        ClosureCreate(environment, destination, function_type, closure):
            let metadata = program.closures[closure.value]
            let service = find_runtime_binding(program, RuntimeService.class_create) else error("wasm backend: verified `ClosureCreate` has no runtime binding")
            append_constant(body, plan.layout.closure_payload_size(metadata), true)
            append_constant(body, recycling_alignment(plan, plan.layout.closure_payload_align(metadata)), true)
            append_function_descriptor(plan, body, metadata.destroyer)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, environment)
            encode_function_value(body, destination, metadata.function, environment)
        ClosureMarkInitialized(environment):
            try encode_pointer_runtime_call(program, plan, body, RuntimeService.class_mark_initialized, environment, "ClosureMarkInitialized")
        ClosureCaptureAddress(result, environment, closure, capture):
            let metadata = program.closures[closure.value]
            let service = find_runtime_binding(program, RuntimeService.class_payload) else error("wasm backend: verified `ClosureCaptureAddress` has no runtime binding")
            local_get(body, environment)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            append_constant(body, plan.layout.closure_capture_offset(metadata, capture), false)
            body.append(opcode_i32_add)
            local_set(body, result)
        FunctionRetain(value):
            try encode_function_environment_call(program, plan, body, RuntimeService.class_retain, value, "FunctionRetain")
        FunctionRelease(value):
            try encode_function_environment_call(program, plan, body, RuntimeService.class_release, value, "FunctionRelease")
        CallClosure(results, signature, target, arguments):
            try encode_closure_call(program, plan, function, body, results, signature, target, arguments)
        CallInterface(results, interface_id, requirement, target, arguments):
            for index in range(0, i64(arguments.count)):
                local_get(body, register_at(function, arguments, index))
            let service = find_runtime_binding(program, RuntimeService.interface_witness) else error("wasm backend: verified `CallInterface` has no runtime binding")
            local_get(body, target)
            append_constant(body, i64(requirement), true)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            append_memory_op(body, opcode_i32_load, 2)
            let signature = program.interfaces[interface_id.value].requirements[requirement].signature
            body.append(opcode_call_indirect)
            append_unsigned(body, signature_index(plan.signatures, try wasm_signature(types, signature)))
            append_unsigned(body, 0)
            var index = i64(results.count) - 1
            while index >= 0:
                local_set(body, register_at(function, results, index))
                index -= 1
        else: return false
    return true

# mark: Process entry and helpers =============================================================

# `_start` asks WASI for the raw argument vector, copies each C string into the
# ordinary owned Luce buffer representation, and passes one retained slice to
# the unchanged fallible source function. All offsets and pointer widths below
# are WebAssembly backend facts; canonical MIR contains only semantic types and
# ownership identities.
pub func encode_start_body(program: MirProgram, plan: ModulePlan) -> list[u8]!:
    let entry = program.process_entry else trap("wasm `_start` planned without an entry")
    var element_type = entry.arguments_type
    match mir_type(program.types, entry.arguments_type):
        Slice(element): element_type = element
        else: trap("verified process entry has no slice type")
    let create = find_runtime_binding(program, RuntimeService.list_create) else trap("verified process entry has no list_create binding")
    let release_list = find_runtime_binding(program, RuntimeService.list_release) else trap("verified process entry has no list_release binding")
    let append = find_runtime_binding(program, RuntimeService.list_append_slot) else trap("verified process entry has no list_append_slot binding")
    let make_slice = find_runtime_binding(program, RuntimeService.list_slice) else trap("verified process entry has no list_slice binding")
    let buffer_data = find_runtime_binding(program, RuntimeService.buffer_data) else trap("verified process entry has no buffer_data binding")
    let buffer_length = find_runtime_binding(program, RuntimeService.buffer_length) else trap("verified process entry has no buffer_length binding")
    let copy_string = find_runtime_binding(program, RuntimeService.c_string_copy) else trap("verified process entry has no c_string_copy binding")
    let release_slice = find_runtime_binding(program, RuntimeService.slice_release) else trap("verified process entry has no slice_release binding")
    let element_size = plan.layout.size_of(element_type)
    let element_alignment = storage_alignment(plan, element_type)
    let failure_size = plan.layout.size_of(entry.failure_type)

    # Locals 0...14 are i32; local 15 is reused for the dynamic frame size and
    # then each string's u64 byte length.
    let argument_count = 0
    let argument_bytes = 1
    let old_stack = 2
    let frame_base = 3
    let argv = 4
    let argument_storage = 5
    let list_value = 6
    let index = 7
    let owner = 8
    let data = 9
    let slot = 10
    let slice_value = 11
    let error_value = 12
    let status = 13
    let failure = 14
    let wide_scratch = 15

    let body = list[u8]()
    append_unsigned(body, 2)
    append_unsigned(body, 15)
    body.append(i32_value_type)
    append_unsigned(body, 1)
    body.append(i64_value_type)

    # WASI writes argc and the packed-string byte count into the backend's
    # reserved scratch words. A nonzero errno is a host-contract trap.
    append_constant(body, scratch_iovec_buffer, false)
    append_constant(body, scratch_iovec_length, false)
    body.append(opcode_call)
    append_unsigned(body, plan.args_sizes_get_import)
    append_trap_if_true(body)
    append_constant(body, scratch_iovec_buffer, false)
    append_memory_op(body, opcode_i32_load, 2)
    local_set_index(body, argument_count)
    append_constant(body, scratch_iovec_length, false)
    append_memory_op(body, opcode_i32_load, 2)
    local_set_index(body, argument_bytes)

    # Reserve `argc * pointer_size + argument bytes + aligned Error` from the
    # shadow stack using i64 arithmetic first, so a wrapped i32 cannot cross
    # the static-data boundary.
    local_get_index(body, argument_count)
    body.append(opcode_i64_extend_i32_u)
    append_constant(body, plan.layout.pointer_size(), true)
    body.append(opcode_i64_mul)
    local_get_index(body, argument_bytes)
    body.append(opcode_i64_extend_i32_u)
    body.append(opcode_i64_add)
    append_constant(body, failure_size + frame_alignment - 1, true)
    body.append(opcode_i64_add)
    body.append(opcode_local_tee)
    append_unsigned(body, wide_scratch)
    append_constant(body, 4294967295, true)
    body.append(opcode_i64_gt_u)
    append_trap_if_true(body)
    body.append(opcode_global_get)
    append_unsigned(body, len(plan.global_imports))
    local_set_index(body, old_stack)
    local_get_index(body, wide_scratch)
    body.append(opcode_i32_wrap_i64)
    local_get_index(body, old_stack)
    body.append(opcode_i32_gt_u)
    append_trap_if_true(body)
    local_get_index(body, old_stack)
    local_get_index(body, wide_scratch)
    body.append(opcode_i32_wrap_i64)
    body.append(opcode_i32_sub)
    append_constant(body, -frame_alignment, false)
    body.append(opcode_i32_and)
    body.append(opcode_local_tee)
    append_unsigned(body, frame_base)
    body.append(opcode_global_set)
    append_unsigned(body, len(plan.global_imports))
    local_get_index(body, frame_base)
    append_constant(body, plan.data_end, false)
    body.append(opcode_i32_lt_u)
    append_trap_if_true(body)

    local_get_index(body, frame_base)
    local_set_index(body, argv)
    local_get_index(body, frame_base)
    local_get_index(body, argument_count)
    append_constant(body, plan.layout.pointer_size(), false)
    body.append(opcode_i32_mul)
    body.append(opcode_i32_add)
    local_set_index(body, argument_storage)
    local_get_index(body, argument_storage)
    local_get_index(body, argument_bytes)
    body.append(opcode_i32_add)
    append_constant(body, frame_alignment - 1, false)
    body.append(opcode_i32_add)
    append_constant(body, -frame_alignment, false)
    body.append(opcode_i32_and)
    local_set_index(body, error_value)

    local_get_index(body, argv)
    local_get_index(body, argument_storage)
    body.append(opcode_call)
    append_unsigned(body, plan.args_get_import)
    append_trap_if_true(body)

    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(create.value)))
    local_set_index(body, list_value)
    append_constant(body, 0, false)
    local_set_index(body, index)
    body.append(opcode_block)
    body.append(empty_block_type)
    body.append(opcode_loop)
    body.append(empty_block_type)
    local_get_index(body, index)
    local_get_index(body, argument_count)
    body.append(opcode_i32_ge_u)
    body.append(opcode_br_if)
    append_unsigned(body, 1)

    local_get_index(body, argv)
    local_get_index(body, index)
    append_constant(body, plan.layout.pointer_size(), false)
    body.append(opcode_i32_mul)
    body.append(opcode_i32_add)
    append_memory_op(body, opcode_i32_load, 2)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(copy_string.value)))
    local_set_index(body, owner)
    local_get_index(body, owner)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(buffer_data.value)))
    local_set_index(body, data)
    local_get_index(body, owner)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(buffer_length.value)))
    local_set_index(body, wide_scratch)

    local_get_index(body, list_value)
    append_constant(body, element_size, true)
    append_constant(body, element_alignment, true)
    append_function_descriptor(plan, body, entry.element_retain)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(append.value)))
    local_set_index(body, slot)
    store_process_string_field(plan, body, slot, owner, element_type, 0, false)
    store_process_string_field(plan, body, slot, data, element_type, 1, false)
    store_process_string_field(plan, body, slot, wide_scratch, element_type, 2, true)

    local_get_index(body, index)
    append_constant(body, 1, false)
    body.append(opcode_i32_add)
    local_set_index(body, index)
    body.append(opcode_br)
    append_unsigned(body, 0)
    body.append(opcode_end)
    body.append(opcode_end)

    local_get_index(body, list_value)
    append_constant(body, element_size, true)
    append_constant(body, 0, true)
    local_get_index(body, argument_count)
    body.append(opcode_i64_extend_i32_u)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(make_slice.value)))
    local_set_index(body, slice_value)
    local_get_index(body, list_value)
    append_constant(body, element_size, true)
    append_constant(body, element_alignment, true)
    append_function_descriptor(plan, body, entry.element_release)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(release_list.value)))

    local_get_index(body, error_value)
    local_get_index(body, slice_value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(entry.function.value)))
    local_set_index(body, failure)
    local_set_index(body, status)
    local_get_index(body, slice_value)
    append_constant(body, element_size, true)
    append_constant(body, element_alignment, true)
    append_function_descriptor(plan, body, entry.element_release)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(release_slice.value)))

    local_get_index(body, failure)
    body.append(opcode_if)
    body.append(empty_block_type)
    local_get_index(body, error_value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(entry.failure_release.value)))
    append_constant(body, 1, false)
    local_set_index(body, status)
    body.append(opcode_end)
    local_get_index(body, old_stack)
    body.append(opcode_global_set)
    append_unsigned(body, len(plan.global_imports))
    local_get_index(body, status)
    body.append(opcode_call)
    append_unsigned(body, plan.proc_exit_import)
    body.append(opcode_end)
    return body

func store_process_string_field(plan: ModulePlan, body: list[u8], slot: i64, value: i64, element_type: TypeId, field: i64, wide: bool):
    local_get_index(body, slot)
    let offset = plan.layout.field_offset(element_type, field)
    if offset > 0:
        append_constant(body, offset, false)
        body.append(opcode_i32_add)
    local_get_index(body, value)
    if wide: append_memory_op(body, opcode_i64_store, 3)
    else: append_memory_op(body, opcode_i32_store, 2)

func encode_list_element_address(program: MirProgram, plan: ModulePlan, function: MirFunction, body: list[u8], result: RegisterId, value: RegisterId, index: RegisterId) -> !:
    let element_type = try list_element_type(program.types, function, value)
    let address_service = find_runtime_binding(program, RuntimeService.list_element_address) else error("wasm backend: verified list indexing has no address binding")
    try encode_list_index_guard(program, plan, body, value, index, false)
    local_get(body, value)
    append_constant(body, plan.layout.size_of(element_type), true)
    local_get(body, index)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(address_service.value)))
    local_set(body, result)

# Check one structural list index before entering the private unchecked
# runtime service. Insertion alone admits the position at `length`.
func encode_list_index_guard(program: MirProgram, plan: ModulePlan, body: list[u8], value: RegisterId, index: RegisterId, allow_end: bool) -> !:
    let length_service = find_runtime_binding(program, RuntimeService.list_length) else error("wasm backend: verified list operation has no length binding")
    encode_index_guard(plan, body, value, index, allow_end, length_service)

func encode_list_shape_guard(program: MirProgram, plan: ModulePlan, body: list[u8], value: RegisterId) -> !:
    let service = find_runtime_binding(program, RuntimeService.list_iteration_active) else error("wasm backend: verified list shape mutation has no active-iteration binding")
    local_get(body, value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(service.value)))
    append_trap_if_true(body)

func list_element_type(types: MirTypeTable, function: MirFunction, value: RegisterId) -> TypeId!:
    match mir_type(types, function.registers[value.value]):
        List(element): return element
        FrozenList(element): return element
        else: error("wasm backend: verified list instruction has a non-list handle")

func hash_key_type(types: MirTypeTable, function: MirFunction, value: RegisterId) -> TypeId!:
    match mir_type(types, function.registers[value.value]):
        Map(key, item): return key
        FrozenMap(key, item): return key
        Set(element): return element
        FrozenSet(element): return element
        else: error("wasm backend: verified hash instruction has a non-map/set handle")

func hash_value_type(types: MirTypeTable, function: MirFunction, value: RegisterId) -> TypeId!:
    match mir_type(types, function.registers[value.value]):
        Map(key, item): return item
        FrozenMap(key, item): return item
        else: error("wasm backend: verified hash value instruction has a non-map handle")

func append_hash_layout_arguments(program: MirProgram, plan: ModulePlan, function: MirFunction, body: list[u8], value: RegisterId) -> !:
    let key_type = try hash_key_type(program.types, function, value)
    append_constant(body, plan.layout.size_of(key_type), true)
    append_constant(body, storage_alignment(plan, key_type), true)
    match mir_type(program.types, function.registers[value.value]):
        Map(key, item):
            append_constant(body, plan.layout.size_of(item), true)
            append_constant(body, storage_alignment(plan, item), true)
        FrozenMap(key, item):
            append_constant(body, plan.layout.size_of(item), true)
            append_constant(body, storage_alignment(plan, item), true)
        Set(element):
            append_constant(body, 0, true)
            append_constant(body, 1, true)
        FrozenSet(element):
            append_constant(body, 0, true)
            append_constant(body, 1, true)
        else: error("wasm backend: verified hash instruction has a non-map/set handle")

func slice_element_type(types: MirTypeTable, function: MirFunction, value: RegisterId) -> TypeId!:
    match mir_type(types, function.registers[value.value]):
        Slice(element): return element
        else: error("wasm backend: verified slice instruction has a non-slice handle")

func mutable_slice_element_type(types: MirTypeTable, function: MirFunction, value: RegisterId) -> TypeId!:
    match mir_type(types, function.registers[value.value]):
        MutableSlice(element): return element
        else: error("wasm backend: verified mutable-slice instruction has a non-view handle")

func class_metadata_of(program: MirProgram, function: MirFunction, value: RegisterId, instruction: str) -> MirClass!:
    match mir_type(program.types, function.registers[value.value]):
        Class(identity): return program.classes[identity.value]
        else: error("wasm backend: verified `" + instruction + "` has a non-class handle")

func encode_function_environment_call(program: MirProgram, plan: ModulePlan, body: list[u8], service: RuntimeService, value: RegisterId, instruction: str) -> !:
    let target = find_runtime_binding(program, service) else error("wasm backend: verified `" + instruction + "` has no runtime binding")
    local_get(body, value)
    append_constant(body, 4, false)
    body.append(opcode_i32_add)
    append_memory_op(body, opcode_i32_load, 2)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(target.value)))

func encode_closure_call(program: MirProgram, plan: ModulePlan, function: MirFunction, body: list[u8], results: RegisterRun, signature: MirSignature, target: RegisterId, arguments: RegisterRun) -> !:
    local_get(body, target)
    append_constant(body, 4, false)
    body.append(opcode_i32_add)
    append_memory_op(body, opcode_i32_load, 2)
    body.append(opcode_i32_eqz)
    body.append(opcode_if)
    body.append(empty_block_type)
    try encode_closure_call_arm(program, plan, function, body, results, signature, target, arguments, false)
    body.append(opcode_else)
    try encode_closure_call_arm(program, plan, function, body, results, signature, target, arguments, true)
    body.append(opcode_end)

func encode_closure_call_arm(program: MirProgram, plan: ModulePlan, function: MirFunction, body: list[u8], results: RegisterRun, signature: MirSignature, target: RegisterId, arguments: RegisterRun, captured: bool) -> !:
    var environment_index: i64 = 0
    if signature.is_fallible: environment_index = 1
    for index in range(0, i64(arguments.count)):
        if captured and index == environment_index:
            local_get(body, target)
            append_constant(body, 4, false)
            body.append(opcode_i32_add)
            append_memory_op(body, opcode_i32_load, 2)
        local_get(body, register_at(function, arguments, index))
    if captured and environment_index == i64(arguments.count):
        local_get(body, target)
        append_constant(body, 4, false)
        body.append(opcode_i32_add)
        append_memory_op(body, opcode_i32_load, 2)
    local_get(body, target)
    append_memory_op(body, opcode_i32_load, 2)
    var wasm_call_signature = try wasm_signature(program.types, signature)
    if captured:
        let parameters = list[u8]()
        for parameter in wasm_call_signature.parameters: parameters.append(parameter)
        parameters.insert(environment_index, i32_value_type)
        wasm_call_signature = WasmSignature(parameters = parameters, results = wasm_call_signature.results)
    body.append(opcode_call_indirect)
    append_unsigned(body, signature_index(plan.signatures, wasm_call_signature))
    append_unsigned(body, 0)
    var result_index = i64(results.count) - 1
    while result_index >= 0:
        local_set(body, register_at(function, results, result_index))
        result_index -= 1

