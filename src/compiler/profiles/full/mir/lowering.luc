#==============================================================================================
#
#   full_profile_lowering - Lowering of the forms that only full Luce has
#
#   DESCRIPTION:
#       Lowers the HIR forms whose meaning the Luce runtime supplies: the
#       built-in collections and their snapshot slices, nominal classes with
#       weak references, closures with captured cells, existential interface
#       values, and structured workers. `mir/function_lowerer` is the one
#       dispatch point: it hands over the nodes, types, and cleanup actions it
#       does not own, and this class writes ordinary canonical MIR into the
#       same function transaction through the `FunctionLoweringHost` services.
#
#       Like `FunctionLowerer`, this is a consumer of the shared
#       `MirLoweringState`. Aggregate structure and semantic operations stay
#       target-independent here exactly as they do there; no layout, ABI, or
#       platform fact is introduced.
#
#   CODE FLOW:
#
#       function_lowerer.luc
#            |  a full-only node, type, place step, or cleanup action
#            v
#       FullProfileLowerer.lower_* / emit_*      one method per dispatch site
#            |  ordinary registers and instructions
#            v
#       host.lower_expression, host.new_temp, ...  the shared emission services
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ClassId, ClosureId, ConformanceId, FunctionId, InterfaceId
from compiler.mir.canonical import InstructionForm, MirFunction, MirInstruction
from compiler.mir.canonical import MirSignature, RegisterId
from compiler.mir.canonical import MirType, TypeId, UnaryOp, builtin_mir_type
from compiler.mir.canonical import make_struct_type, mir_type, no_register, no_registers
from compiler.hir.ir import AssignmentOperation, BinaryOperation, BuiltinType, HirCaptureKind, HirFunction
from compiler.hir.ir import HirModule, NodeId, Operands, SymbolId, no_node
from compiler.hir.ir import entry_at, node_at, node_form, node_span, node_type, resolve_builtin_type, types_match
from compiler.hir.ir import place_class_field_step, place_list_element_step, place_map_element_step, place_mutable_slice_element_step, place_weak_field_step
import compiler.hir.ir
from compiler.frontend.source import SourceSpan
from compiler.mir.lowering_model import CellStorage, DeferredAction, FallibleResult, FunctionLoweringHost, MirLoweringState, PlaceStepOutcome, Region, contains_symbol, ProfileLowering

## The non-owning result of adapting a source `Class?` for a weak sink. Presence
## is kept separately from the weak handle because a dying `self` is already
## unreachable by promotion even while the optional expression is `.some`.
struct WeakClassSource:
    let is_present: RegisterId
    let value: RegisterId

# One fully evaluated dynamic-call site. `target` selects the witness table;
# `payload` is its erased receiver and `values` are in requirement order after
# their source-ordered evaluation.
struct InterfaceOperands:
    let target: RegisterId
    let payload: RegisterId
    let values: list[RegisterId]

## Result of one generated structural-key probe. `index` is the dense
## insertion-order entry index and is meaningful only when `found` is true.
struct HashLookup:
    let found: RegisterId
    let index: RegisterId

## The full-profile consumer of the shared lowering transaction.
pub class FullProfileLowerer: ProfileLowering:
    let state: MirLoweringState

    pub init(state: MirLoweringState):
        self.state = state

    # mark: Function shape ======================================================================

    ## Bind every captured symbol of a closure body to its environment slot
    ## before the prologue reserves ordinary locals.
    pub func begin_closure_environment(function: HirFunction, closure_environment: RegisterId, body: list[MirInstruction]):
        let hir_closure = function.closure else trap("capturing function lost its HIR closure identity")
        let closure = self.state.closure_id_of(i64(hir_closure))
        let source = self.state.program.closures[hir_closure]
        for capture_index in range(0, len(source.captures)):
            let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.ClosureCaptureAddress(
                result = address,
                environment = closure_environment,
                closure = closure,
                capture = capture_index,
            ), span = source.span))
            self.state.add_local(source.captures[capture_index].symbol, address)

    ## A function that spawns directly owns one structured task group.
    pub func begin_task_group(function: HirFunction, body: list[MirInstruction]):
        if not contains_symbol(self.state.direct_spawn_functions, function.symbol): return
        let group_type = self.state.intern_lowered_type(MirType.TaskGroup)
        let group = self.state.new_register(group_type)
        self.state.task_group = i64(group.value)
        body.append(MirInstruction(form = InstructionForm.TaskGroupCreate(result = group), span = function.span))

    ## Finish the invocation's task group on an ordinary exit, if it has one.
    pub func emit_task_group_finish(span: SourceSpan, body: list[MirInstruction]):
        if self.state.task_group < 0: return
        body.append(MirInstruction(form = InstructionForm.TaskGroupFinish(group = RegisterId(value = u32(self.state.task_group))), span = span))

    ## The compiler-registered cleanup actions of this profile: leaving an
    ## active collection traversal.
    pub func emit_deferred_action(action: DeferredAction, body: list[MirInstruction]):
        match action:
            ListIteration(value, span): body.append(MirInstruction(form = InstructionForm.ListIterationEnd(value = value), span = span))
            HashIteration(value, span): body.append(MirInstruction(form = InstructionForm.HashIterationEnd(value = value), span = span))
            else: trap("a shared cleanup action reached the full profile")

    # mark: Locals and places ===================================================================

    ## A `var` captured by a closure lives in one shared ARC cell. False when
    ## the binding is an ordinary slot.
    pub func bind_shared_cell(host: FunctionLoweringHost, span: SourceSpan, symbol: SymbolId, local_address: RegisterId, value_type: TypeId, register: RegisterId, body: list[MirInstruction]) -> bool:
        if not self.state.is_shared_symbol(symbol): return false
        let cell = self.state.cell_for_symbol(symbol)
        let storage = self.state.new_register(cell.cell_type)
        body.append(MirInstruction(form = InstructionForm.CellCreate(result = storage, element_type = cell.element_type, destroyer = cell.destroyer), span = span))
        host.initialize_owned_value(value_type, self.cell_value_address(host, storage, cell.element_type, span, body), register, span, body)
        body.append(MirInstruction(form = InstructionForm.CellMarkInitialized(value = storage), span = span))
        host.store_value(cell.cell_type, local_address, storage, span, body)
        self.state.defers.append(DeferredAction.DestroyAddress(address = local_address, value_type = cell.cell_type, span = span))
        return true

    ## The address of a captured or shared local: through its cell. Absent
    ## when the symbol uses an ordinary slot.
    pub func shared_cell_address(host: FunctionLoweringHost, function: HirFunction, span: SourceSpan, symbol: SymbolId, local_address: RegisterId, body: list[MirInstruction]) -> RegisterId?:
        if not self.symbol_uses_cell(host, function, symbol): return none
        let cell = self.state.cell_for_symbol(symbol)
        let storage = host.load_value(cell.cell_type, local_address, span, body)
        return self.cell_value_address(host, storage, cell.element_type, span, body)

    ## One assignment step through a runtime collection element, a scoped
    ## mutable slice, a map key, or a class field. Map assignment performs the
    ## complete store itself because insertion and replacement differ.
    pub func lower_place_step(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, kind: u32, payload: i64, root: RegisterId, address: RegisterId, root_is_value: bool, position: i64, last_position: i64, place_type: ir.TypeId, operation: AssignmentOperation, value: NodeId, body: list[MirInstruction]) -> PlaceStepOutcome!:
        if kind == place_list_element_step:
            let list_type = try self.state.mir_type_of(module, function, span, place_type)
            var list_value = address
            if not (root_is_value and position == 0):
                list_value = host.load_value(list_type, address, span, body)
            let index = try host.lower_expression(module, function, NodeId(value = u32(payload)), body)
            var element_type = resolve_builtin_type(BuiltinType.unit)
            match self.state.program.types.definitions[place_type.value].form:
                List(element): element_type = element
                else: trap("list assignment step has a non-list HIR type")
            let mir_element = try self.state.mir_type_of(module, function, span, element_type)
            let next = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.ListMutableElementAddress(result = next, value = list_value, index = index, element_retain = host.ownership_helper_for(mir_element).retain), span = span))
            return PlaceStepOutcome.Continue(address = next, place_type = element_type)
        if kind == place_mutable_slice_element_step:
            var view = address
            let view_type = try self.state.mir_type_of(module, function, span, place_type)
            if not (root_is_value and position == 0): view = host.load_value(view_type, address, span, body)
            let index = try host.lower_expression(module, function, NodeId(value = u32(payload)), body)
            var element_type = resolve_builtin_type(BuiltinType.unit)
            match self.state.program.types.definitions[place_type.value].form:
                MutableSlice(element): element_type = element
                else: trap("mutable-slice assignment step has a non-view HIR type")
            let mir_element = try self.state.mir_type_of(module, function, span, element_type)
            let next = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.MutableSliceElementAddress(result = next, value = view, index = index, element_retain = host.ownership_helper_for(mir_element).retain), span = span))
            return PlaceStepOutcome.Continue(address = next, place_type = element_type)
        if kind == place_map_element_step:
            if position != last_position: trap("map assignment step is not final")
            match operation:
                Replace: pass
                Combine(binary): trap("map element has a compound assignment")
            var hir_key_type = resolve_builtin_type(BuiltinType.unit)
            var hir_value_type = resolve_builtin_type(BuiltinType.unit)
            match self.state.program.types.definitions[place_type.value].form:
                Map(key, item):
                    hir_key_type = key
                    hir_value_type = item
                else: trap("map assignment step has a non-map HIR type")
            let map_type = try self.state.mir_type_of(module, function, span, place_type)
            let key = try host.lower_expression(module, function, NodeId(value = u32(payload)), body)
            # The selected key is fixed before the RHS, but candidate
            # discovery follows RHS effects against the authoritative
            # map identity. Existing-value replacement is not a shape
            # mutation; missing-key insertion is checked by the runtime.
            let assigned = try host.lower_expression(module, function, value, body)
            var collection = address
            if not (root_is_value and position == 0):
                collection = host.load_value(map_type, address, span, body)
            let key_hash = try host.lower_structural_hash(module, function, span, hir_key_type, key, body)
            let lookup = try self.lower_hash_lookup(host, module, function, span, hir_key_type, collection, key, key_hash, body)
            let value_type = try self.state.mir_type_of(module, function, span, hir_value_type)
            host.open_if(lookup.found, list[RegisterId](), span, body)
            let value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = value_address, value = collection, index = lookup.index), span = span))
            host.replace_owned_copy(value_type, value_address, assigned, span, body)
            host.emit_else(span, body)
            let inserted = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
            body.append(MirInstruction(form = InstructionForm.HashInsertEntry(result = inserted, value = collection, hash = key_hash), span = span))
            let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            let inserted_value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = collection, index = inserted), span = span))
            body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = inserted_value_address, value = collection, index = inserted), span = span))
            host.initialize_owned_copy(try self.state.mir_type_of(module, function, span, hir_key_type), key_address, key, span, body)
            host.initialize_owned_copy(value_type, inserted_value_address, assigned, span, body)
            host.emit_end(span, body)
            return PlaceStepOutcome.Stored
        if kind == place_class_field_step or kind == place_weak_field_step:
            let class_type = try self.state.mir_type_of(module, function, span, place_type)
            var class_index = -1
            match mir_type(self.state.types, class_type):
                Class(identity): class_index = i64(identity.value)
                else: trap("class-field assignment step has a non-class HIR type")
            var instance = root
            if not (root_is_value and position == 0): instance = host.load_value(class_type, address, span, body)
            let next = self.class_field_address(host, instance, payload, span, body)
            let field_type = ir.nominal_fields(self.state.program, place_type)[payload].value_type
            if kind == place_weak_field_step:
                return PlaceStepOutcome.WeakField(address = next, place_type = field_type, storage = self.state.classes[class_index].fields[payload].storage_type)
            return PlaceStepOutcome.Continue(address = next, place_type = field_type)
        trap("place assignment has an unknown step")

    ## The mutating receiver `items[i]` on a runtime list: a checked write
    ## barrier rather than an address into caller-owned storage. Absent for
    ## shared sequence types.
    pub func lower_collection_mutable_element_address(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, inner: NodeId, sequence_type: ir.TypeId, index: NodeId, body: list[MirInstruction]) -> RegisterId?!:
        match self.state.program.types.definitions[sequence_type.value].form:
            List(element):
                let list_value = try host.lower_expression(module, function, inner, body)
                let position = try host.lower_expression(module, function, index, body)
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.ListMutableElementAddress(result = address, value = list_value, index = position, element_retain = host.ownership_helper_for(element_type).retain), span = span))
                return address
            else: return none

    # mark: Statements and expressions ==========================================================

    ## Built-in `for` over a runtime collection or snapshot. False when the
    ## iterable is a shared type.
    pub func lower_collection_for(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> bool!:
        match self.state.program.types.definitions[node_type(self.state.program, iterable).value].form:
            List(element): try self.lower_list_for(host, module, function, span, symbol, iterable, element, statements, true, body)
            FrozenList(element): try self.lower_list_for(host, module, function, span, symbol, iterable, element, statements, false, body)
            Map(key, value): try self.lower_hash_for(host, module, function, span, symbol, iterable, key, statements, true, body)
            Set(element): try self.lower_hash_for(host, module, function, span, symbol, iterable, element, statements, true, body)
            FrozenMap(key, value): try self.lower_hash_for(host, module, function, span, symbol, iterable, key, statements, false, body)
            FrozenSet(element): try self.lower_hash_for(host, module, function, span, symbol, iterable, element, statements, false, body)
            else: return false
        return true

    ## Expression forms with no machine result type of their own, or whose
    ## result is a runtime handle. Absent when the form is shared.
    pub func lower_expression_form(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId?!:
        match node_form(self.state.program, expression):
            InterfaceValue(value, conformance): return try self.lower_interface_value(host, module, function, expression, value, conformance, body)
            InterfaceCall(receiver, interface_type, requirement, arguments):
                if self.state.fallible_inner(node_type(self.state.program, expression)) != none:
                    try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible interface call")
                return try self.lower_interface_call(host, module, function, expression, receiver, interface_type, requirement, arguments, body)
            Spawn(callee, arguments): return try self.lower_spawn(host, module, function, expression, callee, arguments, body)
            TaskWait(value):
                try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible task wait")
            TaskWaitAll(tasks):
                try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible wait_all")
            TaskCancel(value):
                let task = try host.lower_expression(module, function, value, body)
                body.append(MirInstruction(form = InstructionForm.TaskCancel(task = task), span = node_span(self.state.program, expression)))
                return RegisterId(value = no_register)
            CollectionSnapshot(value): return try self.lower_collection_snapshot(host, module, function, expression, value, body)
            ListCopy(value): return try self.lower_list_copy(host, module, function, expression, value, body)
            ListWithMutableSlice(value, callback): return try self.lower_list_with_mutable_slice(host, module, function, expression, value, callback, body)
            MapLookup(value, key): return try self.lower_map_lookup(host, module, function, expression, value, key, body)
            MapRemove(value, key): return try self.lower_map_remove(host, module, function, expression, value, key, body)
            MapClear(value): return try self.lower_hash_clear(host, module, function, expression, value, body)
            MapReserve(value, minimum_capacity): return try self.lower_hash_reserve(host, module, function, expression, value, minimum_capacity, body)
            MapCopy(value): return try self.lower_hash_copy(host, module, function, expression, value, body)
            SetContains(value, element): return try self.lower_set_membership(host, module, function, expression, value, element, 0, body)
            SetInsert(value, element): return try self.lower_set_membership(host, module, function, expression, value, element, 1, body)
            SetRemove(value, element): return try self.lower_set_membership(host, module, function, expression, value, element, 2, body)
            SetClear(value): return try self.lower_hash_clear(host, module, function, expression, value, body)
            SetReserve(value, minimum_capacity): return try self.lower_hash_reserve(host, module, function, expression, value, minimum_capacity, body)
            SetCopy(value): return try self.lower_hash_copy(host, module, function, expression, value, body)
            SequenceSlice(value, start, end): return try self.lower_sequence_slice(host, module, function, expression, value, start, end, body)
            ListAppend(value, element): return try self.lower_list_append(host, module, function, expression, value, element, body)
            ListInsert(value, index, element): return try self.lower_list_insert(host, module, function, expression, value, index, element, body)
            ListRemoveAt(value, index): return try self.lower_list_remove_at(host, module, function, expression, value, index, body)
            ListClear(value): return try self.lower_list_clear(host, module, function, expression, value, body)
            ListReserve(value, minimum_capacity): return try self.lower_list_reserve(host, module, function, expression, value, minimum_capacity, body)
            WeakCreate(value): return try self.lower_weak_create(host, module, function, expression, value, body)
            WeakGet(value): return try self.lower_weak_get(host, module, function, expression, value, body)
            else: return none
        return none

    ## Typed expression forms that produce a runtime value: closure values,
    ## weak captures, and collection literals. Absent when the form is shared.
    pub func lower_typed_expression(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId?!:
        match node_form(self.state.program, expression):
            ClosureValue(hir_closure, initializers):
                let closure = self.state.closure_id_of(i64(hir_closure))
                let source = self.state.program.closures[hir_closure]
                let metadata = self.state.closures[closure.value]
                if len(source.captures) != i64(initializers.count): trap("HIR closure initializers do not match capture metadata")
                let result = host.new_temp(value_type, span, body)
                let environment = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.ClosureCreate(environment = environment, destination = result, function_type = value_type, closure = closure), span = span))
                for capture_index in range(0, len(source.captures)):
                    let capture = source.captures[capture_index]
                    let storage_type = metadata.captures[capture_index].value_type
                    let address = self.closure_capture_address(host, environment, closure, capture_index, span, body)
                    if capture.kind == HirCaptureKind.shared_cell:
                        let source_symbol = capture.source else trap("shared closure capture has no source symbol")
                        let source_local = try self.state.local_of(module, function, span, source_symbol)
                        let cell = self.state.cell_for_symbol(source_symbol)
                        let storage = host.load_value(cell.cell_type, source_local.address, span, body)
                        host.initialize_owned_value(storage_type, address, storage, span, body)
                    elif capture.kind == HirCaptureKind.weak_capture:
                        let initializer = node_at(self.state.program, initializers, capture_index)
                        let strong = try host.lower_expression(module, function, initializer, body)
                        let weak_value = self.state.new_register(storage_type)
                        body.append(MirInstruction(form = InstructionForm.WeakClassCreate(result = weak_value, value = strong), span = span))
                        host.store_value(storage_type, address, weak_value, span, body)
                    else:
                        let initializer = node_at(self.state.program, initializers, capture_index)
                        let captured = try host.lower_expression(module, function, initializer, body)
                        host.initialize_owned_value(storage_type, address, captured, span, body)
                body.append(MirInstruction(form = InstructionForm.ClosureMarkInitialized(environment = environment), span = span))
                return result
            WeakCaptureReference(symbol):
                let hir_closure = function.closure else trap("weak capture reference appears outside a closure body")
                let capture_index = self.capture_index(host, function, symbol)
                if capture_index < 0: trap("weak capture reference has no capture field")
                let closure = self.state.closure_id_of(i64(hir_closure))
                let weak_type = self.state.closures[closure.value].captures[capture_index].value_type
                let local = try self.state.local_of(module, function, span, symbol)
                let weak_value = host.load_value(weak_type, local.address, span, body)
                let promoted = host.new_temp(value_type, span, body)
                body.append(MirInstruction(form = InstructionForm.WeakClassPromote(destination = promoted, value = weak_value, optional_type = value_type), span = span))
                return promoted
            List(elements):
                var hir_element = resolve_builtin_type(BuiltinType.unit)
                match self.state.program.types.definitions[node_type(self.state.program, expression).value].form:
                    List(element): hir_element = element
                    else: trap("list HIR node has a non-list type")
                let element_type = try self.state.mir_type_of(module, function, span, hir_element)
                let result = self.state.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.ListCreate(result = result), span = span))
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.state.program, elements, index)
                    let element = try host.lower_expression(module, function, element_node, body)
                    let slot = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                    body.append(MirInstruction(form = InstructionForm.ListAppendSlot(result = slot, value = result, element_retain = host.ownership_helper_for(element_type).retain), span = node_span(self.state.program, element_node)))
                    host.initialize_owned_value(element_type, slot, element, node_span(self.state.program, element_node), body)
                return result
            Map(entries): return try self.lower_map_literal(host, module, function, expression, entries, body)
            Set(elements): return try self.lower_set_literal(host, module, function, expression, elements, body)
            else: return none

    ## `.length` of a runtime collection or snapshot. Absent for arrays and
    ## buffers, whose length the shared lowerer reads.
    pub func lower_collection_length(hir_sequence_type: ir.TypeId, sequence: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId?:
        # The result register is allocated only once the type is known so a
        # shared sequence leaves the register numbering untouched.
        let length_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        match self.state.program.types.definitions[hir_sequence_type.value].form:
            List(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.ListLength(result = length, value = sequence), span = span))
                return length
            FrozenList(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.ListLength(result = length, value = sequence), span = span))
                return length
            Map(key, item):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.HashLength(result = length, value = sequence), span = span))
                return length
            Set(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.HashLength(result = length, value = sequence), span = span))
                return length
            FrozenMap(key, item):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.HashLength(result = length, value = sequence), span = span))
                return length
            FrozenSet(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.HashLength(result = length, value = sequence), span = span))
                return length
            Slice(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.SliceLength(result = length, value = sequence), span = span))
                return length
            MutableSlice(element):
                let length = self.state.new_register(length_type)
                body.append(MirInstruction(form = InstructionForm.MutableSliceLength(result = length, value = sequence), span = span))
                return length
            else: return none

    ## Checked element read from a runtime sequence. Absent for arrays and
    ## byte buffers.
    pub func lower_collection_index(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_sequence_type: ir.TypeId, sequence: RegisterId, position: RegisterId, body: list[MirInstruction]) -> RegisterId?!:
        match self.state.program.types.definitions[hir_sequence_type.value].form:
            List(element):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = sequence, index = position), span = span))
                return host.load_value(element_type, address, span, body)
            FrozenList(element):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = sequence, index = position), span = span))
                return host.load_value(element_type, address, span, body)
            Slice(element):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.SliceElementAddress(result = address, value = sequence, index = position), span = span))
                return host.load_value(element_type, address, span, body)
            MutableSlice(element):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.MutableSliceElementAddress(result = address, value = sequence, index = position, element_retain = host.ownership_helper_for(element_type).retain), span = span))
                return host.load_value(element_type, address, span, body)
            else: return none

    ## Reading a field through a class identity, promoting a weak field to an
    ## owned optional. Absent for value records.
    pub func lower_class_field_load(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, record_hir_type: ir.TypeId, base: RegisterId, field_index: i64, value_type: TypeId, body: list[MirInstruction]) -> RegisterId?!:
        match self.state.program.types.definitions[record_hir_type.value].form:
            Class(declaration, arguments):
                let field = self.class_field_address(host, base, field_index, span, body)
                let metadata = ir.nominal_fields(self.state.program, record_hir_type)[field_index]
                if metadata.is_weak:
                    let record_type = try self.state.mir_type_of(module, function, span, record_hir_type)
                    var class_index = -1
                    match mir_type(self.state.types, record_type):
                        Class(identity): class_index = i64(identity.value)
                        else: trap("class field access has a non-class MIR type")
                    let weak_type = self.state.classes[class_index].fields[field_index].storage_type
                    let weak_value = host.load_value(weak_type, field, span, body)
                    let promoted = host.new_temp(value_type, span, body)
                    body.append(MirInstruction(form = InstructionForm.WeakClassPromote(destination = promoted, value = weak_value, optional_type = value_type), span = span))
                    return promoted
                return host.load_value(value_type, field, span, body)
            else: return none

    ## Binary operators on runtime collections: list concatenation and
    ## structural equality. Absent for shared operand types.
    pub func lower_collection_binary(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, left_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId?!:
        var compares = false
        match self.state.program.types.definitions[left_type.value].form:
            List(element):
                match operation:
                    Add(item): return try self.lower_list_concatenation(host, module, function, span, left_type, left, right, body)
                    Equal(item): compares = true
                    NotEqual(item): compares = true
                    else: pass
            Map(key, item):
                match operation:
                    Equal(value): compares = true
                    NotEqual(value): compares = true
                    else: pass
            Set(element):
                match operation:
                    Equal(value): compares = true
                    NotEqual(value): compares = true
                    else: pass
            else: pass
        if not compares: return none
        return try host.lower_aggregate_comparison(module, function, span, operation, left_type, left, right, body)

    ## Structural equality of runtime collections. Absent for shared types.
    pub func lower_collection_equality(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId?!:
        match self.state.program.types.definitions[value_type.value].form:
            List(element): return try self.lower_list_equality(host, module, function, span, element, left, right, context, body)
            Map(key, item): return try self.lower_map_equality(host, module, function, span, key, item, left, right, context, body)
            Set(element): return try self.lower_set_equality(host, module, function, span, element, left, right, body)
            else: return none

    ## Fallible producers of this profile: waiting on workers and dynamic
    ## interface calls. Absent when the form is shared.
    pub func lower_fallible_expression(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> FallibleResult?!:
        match node_form(self.state.program, expression):
            TaskWait(value): return try self.lower_task_wait(host, module, function, expression, value, body)
            TaskWaitAll(tasks): return try self.lower_task_wait_all(host, module, function, expression, tasks, body)
            InterfaceCall(receiver, interface_type, requirement, arguments): return try self.lower_fallible_interface_call(host, module, function, expression, receiver, interface_type, requirement, arguments, body)
            else: return none

    ## Construction of a class identity: allocate, run the initializer on the
    ## payload, and mark it initialized. Absent when the owner is a value.
    pub func lower_class_initializer(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, target: i64, placed: list[RegisterId], owner: ir.TypeId, value_type: TypeId, body: list[MirInstruction]) -> RegisterId?:
        let class_index = self.class_index_of(owner, value_type)
        if class_index < 0: return none
        let value = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.ClassCreate(result = value, identity = ClassId(value = u32(class_index))), span = span))
        self.initialize_class_payload(host, class_index, value, span, body)
        placed[0] = value
        host.emit_call(target, list[RegisterId](), placed, span, body)
        body.append(MirInstruction(form = InstructionForm.ClassMarkInitialized(value = value), span = span))
        return value

    ## A fallible class initializer releases the partial identity on failure.
    pub func lower_fallible_class_initializer(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, target: i64, placed: list[RegisterId], owner: ir.TypeId, value_type: TypeId, body: list[MirInstruction]) -> FallibleResult?!:
        let class_index = self.class_index_of(owner, value_type)
        if class_index < 0: return none
        let value = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.ClassCreate(result = value, identity = ClassId(value = u32(class_index))), span = span))
        self.initialize_class_payload(host, class_index, value, span, body)
        placed[0] = value
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_temp = host.new_temp(error_type, span, body)
        let call_arguments = [error_temp]
        for argument in placed: call_arguments.append(argument)
        let reported_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        host.emit_call(target, [reported_error], call_arguments, span, body)
        let failed = host.error_is_present(reported_error, span, body)
        host.open_if(failed, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.ClassRelease(value = value), span = span))
        host.emit_else(span, body)
        body.append(MirInstruction(form = InstructionForm.ClassMarkInitialized(value = value), span = span))
        host.emit_end(span, body)
        return FallibleResult(value = value, error_value = reported_error)

    # The canonical class identity of an initializer owner, or -1 for a value.
    func class_index_of(owner: ir.TypeId, value_type: TypeId) -> i64:
        match self.state.program.types.definitions[owner.value].form:
            Class(index, type_arguments):
                match mir_type(self.state.types, value_type):
                    Class(identity): return i64(identity.value)
                    else: trap("class initializer has a non-class MIR type")
            else: return -1

    # mark: Ownership ===========================================================================

    ## Whether a managed handle of this profile owns a reference.
    pub func type_needs_ownership(value_type: TypeId) -> bool:
        match mir_type(self.state.types, value_type):
            List(element): return true
            FrozenList(element): return true
            Map(key, value): return true
            Set(element): return true
            FrozenMap(key, value): return true
            FrozenSet(element): return true
            Slice(element): return true
            Class(identity): return true
            WeakClass(identity): return true
            Interface(identity): return true
            Cell(element): return true
            Func(signature): return true
            else: return false

    ## Retain or release a managed handle held in a register. False when the
    ## type is not a handle of this profile.
    pub func emit_value_ownership(host: FunctionLoweringHost, value_type: TypeId, value: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]) -> bool:
        match mir_type(self.state.types, value_type):
            List(element):
                if retaining: body.append(MirInstruction(form = InstructionForm.ListRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.ListRelease(value = value, element_release = host.ownership_helper_for(element).release), span = span))
            FrozenList(element):
                if retaining: body.append(MirInstruction(form = InstructionForm.ListRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.ListRelease(value = value, element_release = host.ownership_helper_for(element).release), span = span))
            Map(key, element):
                if retaining: body.append(MirInstruction(form = InstructionForm.HashRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.HashRelease(value = value, key_release = host.ownership_helper_for(key).release, value_release = host.ownership_helper_for(element).release), span = span))
            Set(element):
                let unit = self.state.intern_lowered_type(make_struct_type(list[TypeId]()))
                if retaining: body.append(MirInstruction(form = InstructionForm.HashRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.HashRelease(value = value, key_release = host.ownership_helper_for(element).release, value_release = host.ownership_helper_for(unit).release), span = span))
            FrozenMap(key, element):
                if retaining: body.append(MirInstruction(form = InstructionForm.HashRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.HashRelease(value = value, key_release = host.ownership_helper_for(key).release, value_release = host.ownership_helper_for(element).release), span = span))
            FrozenSet(element):
                let unit = self.state.intern_lowered_type(make_struct_type(list[TypeId]()))
                if retaining: body.append(MirInstruction(form = InstructionForm.HashRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.HashRelease(value = value, key_release = host.ownership_helper_for(element).release, value_release = host.ownership_helper_for(unit).release), span = span))
            Slice(element):
                if retaining: body.append(MirInstruction(form = InstructionForm.SliceRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.SliceRelease(value = value, element_release = host.ownership_helper_for(element).release), span = span))
            Class(identity):
                if retaining: body.append(MirInstruction(form = InstructionForm.ClassRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.ClassRelease(value = value), span = span))
            WeakClass(identity):
                if retaining: body.append(MirInstruction(form = InstructionForm.WeakClassRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.WeakClassRelease(value = value), span = span))
            Interface(identity):
                if retaining: body.append(MirInstruction(form = InstructionForm.InterfaceRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.InterfaceRelease(value = value), span = span))
            Cell(element):
                if retaining: body.append(MirInstruction(form = InstructionForm.CellRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.CellRelease(value = value), span = span))
            Func(signature):
                if retaining: body.append(MirInstruction(form = InstructionForm.FunctionRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.FunctionRelease(value = value), span = span))
            else: return false
        return true

    ## Retain or release a managed handle stored at an address. False when
    ## the type is not a handle of this profile.
    pub func emit_ownership_at(host: FunctionLoweringHost, value_type: TypeId, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]) -> bool:
        match mir_type(self.state.types, value_type):
            Func(signature):
                if retaining: body.append(MirInstruction(form = InstructionForm.FunctionRetain(value = address), span = span))
                else: body.append(MirInstruction(form = InstructionForm.FunctionRelease(value = address), span = span))
                return true
            else: pass
        if not self.type_needs_ownership(value_type): return false
        let value = host.load_value(value_type, address, span, body)
        return self.emit_value_ownership(host, value_type, value, retaining, span, body)

    ## Establish the inert null state of a managed handle in fresh storage.
    ## False when the type is not a handle of this profile.
    pub func initialize_ownership_at(host: FunctionLoweringHost, value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> bool:
        match mir_type(self.state.types, value_type):
            List(element): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Map(key, value): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Set(element): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Slice(element): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Class(identity): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            WeakClass(identity): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Cell(element): host.store_value(value_type, address, host.typed_null_constant(value_type, span, body), span, body)
            Func(signature): host.function_null(value_type, address, span, body)
            else: return false
        return true

    # mark: Existential interface values ========================================================

    ## Adapt one concrete method to its interface's erased receiver protocol.
    ## The thunk changes only the receiver representation; hidden result/error
    ## slots and every explicit argument remain in their canonical positions.
    pub func lower_interface_witness(host: FunctionLoweringHost, conformance_index: i64, requirement_index: i64) -> MirFunction!:
        host.begin_function()
        let source = self.state.program.conformances[conformance_index]
        let metadata = self.state.conformances[conformance_index]
        let requirement = self.state.interfaces[metadata.interface_id.value].requirements[requirement_index]
        var applied: ir.HirInterfaceApplication? = none
        for candidate in self.state.program.interface_applications:
            if candidate.value_type.value == source.interface_type.value: applied = candidate
        let contract = applied else trap("HIR conformance has no applied interface contract")
        let source_requirement = contract.requirements[requirement_index]
        let span = source_requirement.span

        let parameters = list[RegisterId]()
        for value_type in requirement.signature.parameters: parameters.append(self.state.new_register(value_type))
        let results = list[RegisterId]()
        for value_type in requirement.signature.results: results.append(self.state.new_register(value_type))

        var receiver_index: i64 = 0
        if requirement.signature.is_fallible: receiver_index += 1
        let successful = self.state.fallible_inner(source_requirement.result)
        var result_type = source_requirement.result
        if successful != none: result_type = successful
        if not types_match(result_type, resolve_builtin_type(BuiltinType.unit)) and not requirement.signature.returns_never:
            let lowered_result = try self.state.lower_mir_type(result_type)
            if host.is_aggregate(lowered_result): receiver_index += 1

        let call_arguments = list[RegisterId]()
        for parameter in parameters: call_arguments.append(parameter)
        let body = list[MirInstruction]()
        match self.state.program.types.definitions[source.value_type.value].form:
            Class(class_index, arguments):
                let receiver = self.state.new_register(metadata.value_type)
                call_arguments[receiver_index] = receiver
                body.append(MirInstruction(form = InstructionForm.Load(result = receiver, value_type = metadata.value_type, address = parameters[receiver_index]), span = span))
            else: pass
        let target = self.state.function_index_of(source.implementations[requirement_index])
        if target < 0: trap("HIR conformance implementation has no function")
        host.emit_call(target, results, call_arguments, span, body)
        self.emit_interface_witness_return(host, requirement.signature, parameters, results, span, body)
        return self.interface_witness_function(host, conformance_index, requirement_index, requirement.signature, body, span)

    ## A fallible call reports failure by returning its caller-owned error
    ## slot. A witness must preserve that convention while also making the
    ## successful null result explicit enough for canonical verification.
    func emit_interface_witness_return(host: FunctionLoweringHost, signature: MirSignature, parameters: list[RegisterId], results: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        if signature.is_fallible:
            let reported = results[len(results) - 1]
            let failed = host.error_is_present(reported, span, body)
            host.open_if(failed, list[RegisterId](), span, body)
            body.append(MirInstruction(form = InstructionForm.Raise(failure = parameters[0]), span = span))
            host.emit_end(span, body)
            results[len(results) - 1] = host.null_constant(span, body)
        if signature.returns_never:
            body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
            return
        body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run(results)), span = span))

    func interface_witness_function(host: FunctionLoweringHost, conformance_index: i64, requirement_index: i64, signature: MirSignature, body: list[MirInstruction], span: SourceSpan) -> MirFunction:
        return MirFunction(
            name = ".luce_witness_c" + str(conformance_index) + "_r" + str(requirement_index),
            convention = CallingConvention.luce,
            signature = signature,
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = span,
        )

    func lower_interface_value(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, conformance: u32, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let concrete = try host.lower_expression(module, function, value, body)
        let concrete_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        if host.type_needs_ownership(concrete_type):
            # InterfaceCreate consumes the expression's concrete +1. Reads
            # acquired that +1 in lower_expression; constructors already had it.
            if not host.take_owned_value(concrete): trap("managed interface payload has no owned expression result")
        var source = concrete
        if not host.is_aggregate(concrete_type):
            source = host.new_temp(concrete_type, span, body)
            host.store_value(concrete_type, source, concrete, span, body)
        let interface_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(interface_type)
        body.append(MirInstruction(form = InstructionForm.InterfaceCreate(result = result, source = source, conformance = ConformanceId(value = conformance)), span = span))
        return result

    func lower_interface_call(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, receiver: NodeId, interface_type: ir.TypeId, requirement: u32, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let lowered_interface = try self.state.mir_type_of(module, function, span, interface_type)
        let interface_id = self.interface_identity(host, lowered_interface)
        let contract = self.state.interfaces[interface_id.value].requirements[requirement]
        let operands = try self.lower_interface_operands(host, module, function, receiver, lowered_interface, contract.is_mutating, arguments, span, body)
        let call_arguments = list[RegisterId]()
        let results = list[RegisterId]()
        let value = try host.place_call_result(module, function, span, node_type(self.state.program, expression), contract.signature.returns_never, call_arguments, results, body)
        call_arguments.append(operands.payload)
        for argument in operands.values: call_arguments.append(argument)
        body.append(MirInstruction(form = InstructionForm.CallInterface(
            results = self.state.operands.run(results),
            interface_id = interface_id,
            requirement = requirement,
            target = operands.target,
            arguments = self.state.operands.run(call_arguments),
        ), span = span))
        if contract.signature.returns_never:
            body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        return value

    func lower_fallible_interface_call(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, receiver: NodeId, interface_type: ir.TypeId, requirement: u32, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let lowered_interface = try self.state.mir_type_of(module, function, span, interface_type)
        let interface_id = self.interface_identity(host, lowered_interface)
        let contract = self.state.interfaces[interface_id.value].requirements[requirement]
        let operands = try self.lower_interface_operands(host, module, function, receiver, lowered_interface, contract.is_mutating, arguments, span, body)
        let successful = self.state.fallible_inner(node_type(self.state.program, expression)) else trap("fallible interface call has an infallible result")
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let call_arguments = [host.new_temp(error_type, span, body)]
        let results = list[RegisterId]()
        let value = try host.place_call_result(module, function, span, successful, contract.signature.returns_never, call_arguments, results, body)
        call_arguments.append(operands.payload)
        for argument in operands.values: call_arguments.append(argument)
        let reported_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        results.append(reported_error)
        body.append(MirInstruction(form = InstructionForm.CallInterface(
            results = self.state.operands.run(results),
            interface_id = interface_id,
            requirement = requirement,
            target = operands.target,
            arguments = self.state.operands.run(call_arguments),
        ), span = span))
        return FallibleResult(value = value, error_value = reported_error)

    func lower_interface_operands(host: FunctionLoweringHost, module: HirModule, function: HirFunction, receiver: NodeId, interface_type: TypeId, is_mutating: bool, arguments: Operands, span: SourceSpan, body: list[MirInstruction]) -> InterfaceOperands!:
        var target = RegisterId(value = no_register)
        var place = RegisterId(value = no_register)
        if is_mutating: place = try host.lower_mutable_place_address(module, function, receiver, body)
        else: target = try host.lower_expression(module, function, receiver, body)
        let values = list[RegisterId]()
        for pair in range(0, i64(arguments.count) // 2): values.append(RegisterId(value = no_register))
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.state.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.state.program, arguments, pair * 2 + 1)))
            values[parameter_index] = try host.lower_expression(module, function, argument, body)
        if is_mutating:
            target = host.load_value(interface_type, place, span, body)
            let detached = self.state.new_register(interface_type)
            body.append(MirInstruction(form = InstructionForm.InterfaceDetach(result = detached, value = target), span = span))
            host.store_value(interface_type, place, detached, span, body)
            target = detached
        let payload = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.InterfacePayload(result = payload, value = target), span = span))
        return InterfaceOperands(target = target, payload = payload, values = values)

    func interface_identity(host: FunctionLoweringHost, value_type: TypeId) -> InterfaceId:
        match mir_type(self.state.types, value_type):
            Interface(identity): return identity
            else: trap("dynamic HIR call has no MIR interface type")

    ## Final-release callback for one class identity. Runtime weak zeroing has

    # mark: Classes and weak references =========================================================

    ## already happened when this begins. A completed object runs its source
    ## deinitializer with a borrowed receiver, then payload ownership unwinds
    ## in reverse declaration order; a failed initializer skips only deinit.
    pub func lower_class_destroyer(host: FunctionLoweringHost, class_index: i64, identity: FunctionId) -> MirFunction:
        host.begin_function()
        let hir_type = self.state.class_hir_types[class_index]
        var declaration = -1
        match self.state.program.types.definitions[hir_type.value].form:
            Class(index, arguments): declaration = index
            else: trap("canonical class identity has a non-class HIR type")
        let class_value = self.state.program.classes[declaration]
        let application = ir.class_application(self.state.program, hir_type)
        let class_type = TypeId(value = self.state.lowered_class_types[hir_type.value])
        let instance = self.state.new_register(class_type)
        let initialized = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        let body = list[MirInstruction]()
        let deinitializer = application.deinitializer
        if deinitializer != none:
            host.open_if(initialized, list[RegisterId](), class_value.span, body)
            let target = self.state.function_index_of(deinitializer)
            if target < 0: trap("class deinitializer has no source function identity")
            host.emit_call(target, list[RegisterId](), [instance], class_value.span, body)
            host.emit_end(class_value.span, body)
        let fields = self.state.classes[class_index].fields
        var field_index = len(fields) - 1
        while field_index >= 0:
            let address = self.class_field_address(host, instance, field_index, class_value.span, body)
            host.emit_ownership_at(fields[field_index].storage_type, address, false, class_value.span, body)
            field_index -= 1
        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = class_value.span))
        return MirFunction(
            name = ".luce_destroy_class" + str(class_index) + "_f" + str(identity.value),
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = [class_type, builtin_mir_type(BuiltinMirType.boolean)], results = list[TypeId](), is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = class_value.span,
        )

    func initialize_class_payload(host: FunctionLoweringHost, class_index: i64, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let fields = self.state.classes[class_index].fields
        for field_index in range(0, len(fields)):
            let field_type = fields[field_index].storage_type
            if host.type_needs_ownership(field_type):
                host.initialize_ownership_at(field_type, self.class_field_address(host, value, field_index, span, body), span, body)

    func class_field_address(host: FunctionLoweringHost, value: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ClassFieldAddress(result = address, value = value, field = field), span = span))
        return address

    pub func is_weak_field_access(host: FunctionLoweringHost, value: NodeId, field: i64) -> bool:
        let value_type = node_type(self.state.program, value)
        match self.state.program.types.definitions[value_type.value].form:
            Class(index, arguments): return ir.nominal_fields(self.state.program, value_type)[field].is_weak
            else: return false

    ## Lower first-class `Weak[T]` construction without an owning wrapper.
    func lower_weak_create(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let referent = try host.lower_expression(module, function, value, body)
        let result_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(result_type)
        body.append(MirInstruction(form = InstructionForm.WeakClassCreate(result = result, value = referent), span = span))
        return result

    ## Atomically promote one `Weak[T]` into caller-owned `T?` storage.
    func lower_weak_get(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let weak_value = try host.lower_expression(module, function, value, body)
        let optional_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = host.new_temp(optional_type, span, body)
        body.append(MirInstruction(form = InstructionForm.WeakClassPromote(destination = result, value = weak_value, optional_type = optional_type), span = span))
        return result

    ## Replace one weak payload slot from its source-visible optional class.
    ## This sink lowers the optional directly to a weak handle: constructing an
    ## owning `Class?` first would retain a destruction-time borrowed `self` and
    ## resurrect an identity whose strong count has already reached zero.
    pub func lower_weak_store(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, storage_type: TypeId, address: RegisterId, value: NodeId, body: list[MirInstruction]) -> !:
        let source = try self.lower_class_source_as_weak(host, module, function, span, storage_type, value, body)
        host.emit_ownership_call(storage_type, address, false, span, body)
        host.store_value(storage_type, address, source.value, span, body)

    ## Adapt either `Class` or `Class?` to one weak +1 while preserving source
    ## optional presence. Keeping one recursive walk for both types is what lets
    ## conditionals and `else` compose without duplicating control-flow or
    ## constructing an owning wrapper around a borrowed dying receiver.
    func lower_class_source_as_weak(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, storage_type: TypeId, value: NodeId, body: list[MirInstruction]) -> WeakClassSource!:
        match node_form(self.state.program, value):
            NoneLiteral:
                return WeakClassSource(
                    is_present = host.bool_constant(false, span, body),
                    value = host.typed_null_constant(storage_type, span, body),
                )
            Some(inner):
                return try self.lower_class_source_as_weak(host, module, function, span, storage_type, inner, body)
            Conditional(selected, condition, alternative):
                let condition_start = len(self.state.defers)
                let tested = try host.lower_expression(module, function, condition, body)
                try host.emit_temporaries_from(condition_start, body)
                let result_present = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                let result_value = self.state.new_register(storage_type)
                host.open_if(tested, [result_present, result_value], span, body)
                let selected_start = len(self.state.defers)
                let chosen = try self.lower_class_source_as_weak(host, module, function, span, storage_type, selected, body)
                try host.emit_temporaries_from(selected_start, body)
                self.emit_weak_source_yield(host, chosen, span, body)
                host.emit_else(span, body)
                let alternative_start = len(self.state.defers)
                let fallback = try self.lower_class_source_as_weak(host, module, function, span, storage_type, alternative, body)
                try host.emit_temporaries_from(alternative_start, body)
                self.emit_weak_source_yield(host, fallback, span, body)
                host.emit_end(span, body)
                return WeakClassSource(is_present = result_present, value = result_value)
            ElseFallback(optional, arm):
                let optional_start = len(self.state.defers)
                let source = try self.lower_class_source_as_weak(host, module, function, span, storage_type, optional, body)
                try host.emit_temporaries_from(optional_start, body)
                let result = self.state.new_register(storage_type)
                host.open_if(source.is_present, [result], span, body)
                host.emit_yield(source.value, span, body)
                host.emit_else(span, body)
                let fallback_start = len(self.state.defers)
                let fallback = try self.lower_class_source_as_weak(host, module, function, span, storage_type, arm, body)
                try host.emit_temporaries_from(fallback_start, body)
                host.emit_yield(fallback.value, span, body)
                host.emit_end(span, body)
                return WeakClassSource(is_present = host.bool_constant(true, span, body), value = result)
            else:
                match self.state.program.types.definitions[node_type(self.state.program, value).value].form:
                    Class(class_index, arguments):
                        let referent = try host.lower_expression(module, function, value, body)
                        let created = self.state.new_register(storage_type)
                        body.append(MirInstruction(form = InstructionForm.WeakClassCreate(result = created, value = referent), span = span))
                        return WeakClassSource(is_present = host.bool_constant(true, span, body), value = created)
                    Optional(inner):
                        let optional = try host.lower_expression(module, function, value, body)
                        let present = host.load_present(optional, span, body)
                        let weak_value = self.state.new_register(storage_type)
                        host.open_if(present, [weak_value], span, body)
                        let optional_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                        var class_type = builtin_mir_type(BuiltinMirType.pointer)
                        match mir_type(self.state.types, optional_type):
                            Enum(tag, cases): class_type = cases[1]
                            else: trap("weak field source is not an optional MIR value")
                        let referent = host.load_value(class_type, host.payload_address(optional_type, optional, span, body), span, body)
                        let created = self.state.new_register(storage_type)
                        body.append(MirInstruction(form = InstructionForm.WeakClassCreate(result = created, value = referent), span = span))
                        host.emit_yield(created, span, body)
                        host.emit_else(span, body)
                        host.emit_yield(host.typed_null_constant(storage_type, span, body), span, body)
                        host.emit_end(span, body)
                        return WeakClassSource(is_present = present, value = weak_value)
                    else: trap("weak field source is neither a class nor an optional class")

    func emit_weak_source_yield(host: FunctionLoweringHost, source: WeakClassSource, span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.Yield(values = self.state.operands.run([source.is_present, source.value])), span = span))

    ## Final release for one closure environment. Capture initialization is

    # mark: Closures and cells ==================================================================

    ## atomic from the language's perspective; the initialized flag still
    ## makes the managed-object lifecycle explicit and robust to backend traps.
    pub func lower_closure_destroyer(host: FunctionLoweringHost, closure_index: i64, identity: FunctionId) -> MirFunction:
        host.begin_function()
        let closure = self.state.closures[closure_index]
        let source = self.state.program.closures[self.hir_closure_index(host, closure_index)]
        let span = source.span
        let pointer = builtin_mir_type(BuiltinMirType.pointer)
        let environment = self.state.new_register(pointer)
        let initialized = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        let body = list[MirInstruction]()
        host.open_if(initialized, list[RegisterId](), span, body)
        var capture_index = len(closure.captures) - 1
        while capture_index >= 0:
            let address = self.closure_capture_address(host, environment, ClosureId(value = u32(closure_index)), capture_index, span, body)
            host.emit_ownership_at(closure.captures[capture_index].value_type, address, false, span, body)
            capture_index -= 1
        host.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = span))
        return MirFunction(
            name = ".luce_destroy_closure" + str(closure_index) + "_f" + str(identity.value),
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = [pointer, builtin_mir_type(BuiltinMirType.boolean)], results = list[TypeId](), is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = span,
        )

    ## Final release for one mutable capture cell. A cell owns exactly one
    ## source value once its defining binding has finished initialization.
    pub func lower_cell_destroyer(host: FunctionLoweringHost, cell: CellStorage) -> MirFunction:
        host.begin_function()
        let instance = self.state.new_register(cell.cell_type)
        let initialized = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        let body = list[MirInstruction]()
        let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
        host.open_if(initialized, list[RegisterId](), span, body)
        let address = self.cell_value_address(host, instance, cell.element_type, span, body)
        host.emit_ownership_at(cell.element_type, address, false, span, body)
        host.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = span))
        return MirFunction(
            name = ".luce_destroy_cell_t" + str(cell.element_type.value) + "_f" + str(cell.destroyer.value),
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = [cell.cell_type, builtin_mir_type(BuiltinMirType.boolean)], results = list[TypeId](), is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = span,
        )

    func hir_closure_index(host: FunctionLoweringHost, lowered: i64) -> i64:
        for hir_index in range(0, len(self.state.lowered_closures)):
            if self.state.lowered_closures[hir_index] == u32(lowered): return hir_index
        trap("canonical closure has no HIR source")

    func symbol_uses_cell(host: FunctionLoweringHost, function: HirFunction, symbol: SymbolId) -> bool:
        if self.state.is_shared_symbol(symbol): return true
        let index = self.capture_index(host, function, symbol)
        if index < 0: return false
        let hir_closure = function.closure else trap("captured symbol belongs to a function without a closure")
        return self.state.program.closures[hir_closure].captures[index].kind == HirCaptureKind.shared_cell

    func capture_index(host: FunctionLoweringHost, function: HirFunction, symbol: SymbolId) -> i64:
        let hir_closure = function.closure
        if hir_closure == none: return -1
        let captures = self.state.program.closures[hir_closure].captures
        for index in range(0, len(captures)):
            if captures[index].symbol.value == symbol.value: return index
        return -1

    func closure_capture_address(host: FunctionLoweringHost, environment: RegisterId, closure: ClosureId, capture: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ClosureCaptureAddress(result = address, environment = environment, closure = closure, capture = capture), span = span))
        return address

    func cell_value_address(host: FunctionLoweringHost, value: RegisterId, element_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.CellValueAddress(result = address, value = value, element_type = element_type), span = span))
        return address

    ## Spawn preserves the direct-call argument contract: expressions execute

    # mark: Workers =============================================================================

    ## in source order, then the resolved registers are placed in parameter
    ## order for the exact named worker. The task instruction copies them
    ## immediately, so later source mutation cannot cross the worker boundary.
    func lower_spawn(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        if self.state.task_group < 0: trap("HIR direct-spawn analysis did not reserve a MIR task group")
        let target = self.state.function_index_of(callee)
        if target < 0: trap("HIR spawn names an unknown function")
        let called = self.state.program.functions[target]
        let placed = try host.lower_placed_arguments(module, function, called, arguments, body)
        var worker = FunctionId(value = 0)
        match self.state.lowered_functions[target]:
            Defined(identity): worker = identity
            External(external): trap("HIR spawn names an external function")
        let task_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(task_type)
        let transfer_types = list[TypeId]()
        for parameter in called.parameters:
            transfer_types.append(try self.state.mir_type_of(module, function, span, parameter.value_type))
        body.append(MirInstruction(form = InstructionForm.TaskSpawn(
            result = result,
            group = RegisterId(value = u32(self.state.task_group)),
            function = worker,
            arguments = self.state.operands.transfer_run(placed, transfer_types),
        ), span = span))
        return result

    func lower_task_wait(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let task = try host.lower_expression(module, function, value, body)
        let successful = self.state.fallible_inner(node_type(self.state.program, expression)) else trap("task wait is not fallible HIR")
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_destination = host.new_temp(error_type, span, body)
        var result = RegisterId(value = no_register)
        var destination = RegisterId(value = no_register)
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)) and not types_match(successful, resolve_builtin_type(BuiltinType.never_type)):
            let result_type = try self.state.mir_type_of(module, function, span, successful)
            if host.is_aggregate(result_type): destination = host.new_temp(result_type, span, body)
            else: result = self.state.new_register(result_type)
        let failure = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.TaskWait(
            result = result,
            destination = destination,
            failure = failure,
            error_destination = error_destination,
            task = task,
        ), span = span))
        if destination.value != no_register: result = destination
        return FallibleResult(value = result, error_value = failure)

    func lower_task_wait_all(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, tasks_node: NodeId, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let tasks = try host.lower_expression(module, function, tasks_node, body)
        let successful = self.state.fallible_inner(node_type(self.state.program, expression)) else trap("wait_all is not fallible HIR")
        let result_type = try self.state.mir_type_of(module, function, span, successful)
        let result = self.state.new_register(result_type)
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_destination = host.new_temp(error_type, span, body)
        let failure = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.TaskWaitAll(
            result = result,
            failure = failure,
            error_destination = error_destination,
            tasks = tasks,
        ), span = span))
        return FallibleResult(value = result, error_value = failure)

    # Enter traversal once, retain its captured length, and address the

    # mark: Collections =========================================================================

    # current slot through the list identity on every pass. `reserve` may
    # relocate storage during iteration, so caching a backend address here
    # would be both incorrect and a violation of canonical MIR's boundary.
    # The generated cleanup stays below body defers: `continue` skips it,
    # `break` reaches the common post-block copy, and function exits emit it
    # through the ordinary lexical cleanup stack.
    func lower_list_for(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, element_hir_type: ir.TypeId, statements: Operands, tracks_shape: bool, body: list[MirInstruction]) -> !:
        let list_value = try host.lower_expression(module, function, iterable, body)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let element_type = try self.state.mir_type_of(module, function, span, element_hir_type)
        let length = self.state.new_register(index_type)
        if tracks_shape: body.append(MirInstruction(form = InstructionForm.ListIterationBegin(result = length, value = list_value), span = span))
        else: body.append(MirInstruction(form = InstructionForm.ListLength(result = length, value = list_value), span = span))

        let cleanup_start = len(self.state.defers)
        if tracks_shape: self.state.defers.append(DeferredAction.ListIteration(value = list_value, span = span))
        let loop = host.begin_counted_loop(host.integer_constant(index_type, 0, span, body), length, list[RegisterId](), span, body)
        host.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
        let element_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = element_address, value = list_value, index = loop.index), span = span))
        let element = host.load_value(element_type, element_address, span, body)
        let binding = (try self.state.local_of(module, function, span, symbol)).address
        host.initialize_owned_value(element_type, binding, element, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        let iteration_start = len(self.state.defers)
        if host.type_needs_ownership(element_type):
            self.state.defers.append(DeferredAction.DestroyAddress(address = binding, value_type = element_type, span = span))
        self.state.loop_defer_starts.append(iteration_start)
        try host.lower_scope(module, function, statements, body)
        self.state.loop_defer_starts.remove(len(self.state.loop_defer_starts) - 1)
        try host.emit_deferred_from(module, function, iteration_start, body)
        while len(self.state.defers) > iteration_start: self.state.defers.remove(len(self.state.defers) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        host.emit_end(span, body)

        host.end_counted_loop(loop, span, body)

        try host.emit_deferred_from(module, function, cleanup_start, body)
        while len(self.state.defers) > cleanup_start: self.state.defers.remove(len(self.state.defers) - 1)

    ## Maps iterate keys and sets iterate elements; both are the key column of
    ## the shared insertion-ordered table. The active traversal is paired on
    ## every lexical exit, while each element binding has its own lifetime.
    func lower_hash_for(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, element_hir_type: ir.TypeId, statements: Operands, tracks_shape: bool, body: list[MirInstruction]) -> !:
        let hash_value = try host.lower_expression(module, function, iterable, body)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let element_type = try self.state.mir_type_of(module, function, span, element_hir_type)
        let length = self.state.new_register(index_type)
        if tracks_shape: body.append(MirInstruction(form = InstructionForm.HashIterationBegin(result = length, value = hash_value), span = span))
        else: body.append(MirInstruction(form = InstructionForm.HashLength(result = length, value = hash_value), span = span))

        let cleanup_start = len(self.state.defers)
        if tracks_shape: self.state.defers.append(DeferredAction.HashIteration(value = hash_value, span = span))
        let loop = host.begin_counted_loop(host.integer_constant(index_type, 0, span, body), length, list[RegisterId](), span, body)
        host.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
        let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = hash_value, index = loop.index), span = span))
        let element = host.load_value(element_type, key_address, span, body)
        let binding = (try self.state.local_of(module, function, span, symbol)).address
        host.initialize_owned_value(element_type, binding, element, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        let iteration_start = len(self.state.defers)
        if host.type_needs_ownership(element_type):
            self.state.defers.append(DeferredAction.DestroyAddress(address = binding, value_type = element_type, span = span))
        self.state.loop_defer_starts.append(iteration_start)
        try host.lower_scope(module, function, statements, body)
        self.state.loop_defer_starts.remove(len(self.state.loop_defer_starts) - 1)
        try host.emit_deferred_from(module, function, iteration_start, body)
        while len(self.state.defers) > iteration_start: self.state.defers.remove(len(self.state.defers) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        host.emit_end(span, body)

        host.end_counted_loop(loop, span, body)

        try host.emit_deferred_from(module, function, cleanup_start, body)
        while len(self.state.defers) > cleanup_start: self.state.defers.remove(len(self.state.defers) - 1)

    ## A snapshot reuses the collection family's storage protocol while
    ## changing its canonical type. Only read-only operations accept the
    ## frozen result; the exact retain helpers preserve nested immutable
    ## values without moving representation policy into MIR.
    func lower_collection_snapshot(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source = try host.lower_expression(module, function, value, body)
        let source_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        let result_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(result_type)
        match mir_type(self.state.types, source_type):
            List(element):
                body.append(MirInstruction(form = InstructionForm.ListSnapshot(
                    result = result,
                    value = source,
                    element_retain = host.ownership_helper_for(element).retain,
                ), span = span))
            Map(key, item):
                body.append(MirInstruction(form = InstructionForm.HashSnapshot(
                    result = result,
                    value = source,
                    key_retain = host.ownership_helper_for(key).retain,
                    value_retain = host.ownership_helper_for(item).retain,
                ), span = span))
            Set(element):
                let unit = self.state.intern_lowered_type(make_struct_type(list[TypeId]()))
                body.append(MirInstruction(form = InstructionForm.HashSnapshot(
                    result = result,
                    value = source,
                    key_retain = host.ownership_helper_for(element).retain,
                    value_retain = host.ownership_helper_for(unit).retain,
                ), span = span))
            else: trap("HIR collection snapshot has a non-collection source")
        return result

    func lower_list_copy(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let source = try host.lower_expression(module, function, value, body)
        let result_type = try self.state.mir_type_of(module, function, node_span(self.state.program, expression), node_type(self.state.program, expression))
        let result = self.state.new_register(result_type)
        let element_type = self.list_element_mir_type(host, result_type)
        body.append(MirInstruction(form = InstructionForm.ListCopy(result = result, value = source, element_retain = host.ownership_helper_for(element_type).retain), span = node_span(self.state.program, expression)))
        return result

    ## Probe one table using a source key's structural hash and equality.
    ## The runtime returns only same-hash candidates; generated MIR remains
    ## authoritative for language equality and therefore for membership.
    func lower_hash_lookup(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_key_type: ir.TypeId, collection: RegisterId, key: RegisterId, key_hash: RegisterId, body: list[MirInstruction]) -> HashLookup!:
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let bool_type = builtin_mir_type(BuiltinMirType.boolean)
        let found = self.state.new_register(bool_type)
        let index = self.state.new_register(u64_type)
        let candidate_slot = host.new_temp(u64_type, span, body)
        let first = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.HashFindFirst(result = first, value = collection, hash = key_hash), span = span))
        host.store_value(u64_type, candidate_slot, first, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([found, index])), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        let candidate = host.load_value(u64_type, candidate_slot, span, body)
        let zero = host.integer_constant(u64_type, 0, span, body)
        let exhausted = self.state.new_register(bool_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = exhausted, operation = BinaryOp.eq, left = candidate, right = zero), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = exhausted, depth = 1, values = self.state.operands.run([host.bool_constant(false, span, body), zero])), span = span))

        let raw_index = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = raw_index, operation = BinaryOp.sub, left = candidate, right = host.integer_constant(u64_type, 1, span, body)), span = span))
        let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = collection, index = raw_index), span = span))
        let mir_key_type = try self.state.mir_type_of(module, function, span, hir_key_type)
        let stored_key = host.load_value(mir_key_type, key_address, span, body)
        let equal = try host.lower_equality_definition(module, function, span, hir_key_type, stored_key, key, none, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = equal, depth = 1, values = self.state.operands.run([host.bool_constant(true, span, body), raw_index])), span = span))

        let next = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.HashFindNext(result = next, value = collection, current = candidate), span = span))
        host.store_value(u64_type, candidate_slot, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        host.emit_end(span, body)
        host.emit_end(span, body)
        return HashLookup(found = found, index = index)

    func lower_map_literal(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, entries: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let hir_map_type = node_type(self.state.program, expression)
        var hir_key_type = resolve_builtin_type(BuiltinType.unit)
        var hir_value_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[hir_map_type.value].form:
            Map(key, value):
                hir_key_type = key
                hir_value_type = value
            else: trap("map HIR node has a non-map type")
        let map_type = try self.state.mir_type_of(module, function, span, hir_map_type)
        let key_type = try self.state.mir_type_of(module, function, span, hir_key_type)
        let value_type = try self.state.mir_type_of(module, function, span, hir_value_type)
        let result = self.state.new_register(map_type)
        body.append(MirInstruction(form = InstructionForm.HashCreate(result = result), span = span))
        for position in range(0, i64(entries.count) // 2):
            let key_node = node_at(self.state.program, entries, position * 2)
            let value_node = node_at(self.state.program, entries, position * 2 + 1)
            let key = try host.lower_expression(module, function, key_node, body)
            let item = try host.lower_expression(module, function, value_node, body)
            let key_hash = try host.lower_structural_hash(module, function, node_span(self.state.program, key_node), hir_key_type, key, body)
            let lookup = try self.lower_hash_lookup(host, module, function, span, hir_key_type, result, key, key_hash, body)
            host.open_if(lookup.found, list[RegisterId](), span, body)
            let existing = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = existing, value = result, index = lookup.index), span = span))
            host.replace_owned_copy(value_type, existing, item, span, body)
            host.emit_else(span, body)
            let inserted = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
            body.append(MirInstruction(form = InstructionForm.HashInsertEntry(result = inserted, value = result, hash = key_hash), span = span))
            let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            let value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = result, index = inserted), span = span))
            body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = value_address, value = result, index = inserted), span = span))
            host.initialize_owned_copy(key_type, key_address, key, span, body)
            host.initialize_owned_copy(value_type, value_address, item, span, body)
            host.emit_end(span, body)
        return result

    func lower_set_literal(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, elements: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let hir_set_type = node_type(self.state.program, expression)
        var hir_element_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[hir_set_type.value].form:
            Set(element): hir_element_type = element
            else: trap("set HIR node has a non-set type")
        let set_type = try self.state.mir_type_of(module, function, span, hir_set_type)
        let element_type = try self.state.mir_type_of(module, function, span, hir_element_type)
        let result = self.state.new_register(set_type)
        body.append(MirInstruction(form = InstructionForm.HashCreate(result = result), span = span))
        for position in range(0, i64(elements.count)):
            let element_node = node_at(self.state.program, elements, position)
            let element = try host.lower_expression(module, function, element_node, body)
            let key_hash = try host.lower_structural_hash(module, function, node_span(self.state.program, element_node), hir_element_type, element, body)
            let lookup = try self.lower_hash_lookup(host, module, function, span, hir_element_type, result, element, key_hash, body)
            let missing = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Unary(result = missing, operation = UnaryOp.bool_not, operand = lookup.found), span = span))
            host.open_if(missing, list[RegisterId](), span, body)
            let inserted = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
            body.append(MirInstruction(form = InstructionForm.HashInsertEntry(result = inserted, value = result, hash = key_hash), span = span))
            let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = result, index = inserted), span = span))
            host.initialize_owned_copy(element_type, key_address, element, span, body)
            host.emit_end(span, body)
        return result

    func lower_map_lookup(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, key_node: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let collection = try host.lower_expression(module, function, value, body)
        let key = try host.lower_expression(module, function, key_node, body)
        var hir_key_type = resolve_builtin_type(BuiltinType.unit)
        var hir_value_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[node_type(self.state.program, value).value].form:
            Map(found_key, found_value):
                hir_key_type = found_key
                hir_value_type = found_value
            FrozenMap(found_key, found_value):
                hir_key_type = found_key
                hir_value_type = found_value
            else: trap("map lookup has a non-map receiver")
        let key_hash = try host.lower_structural_hash(module, function, span, hir_key_type, key, body)
        let lookup = try self.lower_hash_lookup(host, module, function, span, hir_key_type, collection, key, key_hash, body)
        let optional_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let value_type = try self.state.mir_type_of(module, function, span, hir_value_type)
        let result = host.new_temp(optional_type, span, body)
        host.open_if(lookup.found, list[RegisterId](), span, body)
        host.store_optional_tag(result, 1, span, body)
        let source = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = source, value = collection, index = lookup.index), span = span))
        host.initialize_owned_value(value_type, host.payload_address(optional_type, result, span, body), host.load_value(value_type, source, span, body), span, body)
        host.emit_else(span, body)
        host.store_optional_tag(result, 0, span, body)
        host.emit_end(span, body)
        return result

    func lower_map_remove(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, key_node: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let collection = try host.lower_expression(module, function, value, body)
        let key = try host.lower_expression(module, function, key_node, body)
        var hir_key_type = resolve_builtin_type(BuiltinType.unit)
        var hir_value_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[node_type(self.state.program, value).value].form:
            Map(found_key, found_value):
                hir_key_type = found_key
                hir_value_type = found_value
            else: trap("map removal has a non-map receiver")
        let key_hash = try host.lower_structural_hash(module, function, span, hir_key_type, key, body)
        let lookup = try self.lower_hash_lookup(host, module, function, span, hir_key_type, collection, key, key_hash, body)
        let optional_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let key_type = try self.state.mir_type_of(module, function, span, hir_key_type)
        let value_type = try self.state.mir_type_of(module, function, span, hir_value_type)
        let result = host.new_temp(optional_type, span, body)
        host.open_if(lookup.found, list[RegisterId](), span, body)
        host.store_optional_tag(result, 1, span, body)
        let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = collection, index = lookup.index), span = span))
        body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = value_address, value = collection, index = lookup.index), span = span))
        host.store_value(value_type, host.payload_address(optional_type, result, span, body), host.load_value(value_type, value_address, span, body), span, body)
        host.emit_ownership_call(key_type, key_address, false, span, body)
        body.append(MirInstruction(form = InstructionForm.HashRemoveEntry(value = collection, index = lookup.index), span = span))
        host.emit_else(span, body)
        host.store_optional_tag(result, 0, span, body)
        host.emit_end(span, body)
        return result

    # `mode`: 0 contains, 1 insert, 2 remove. This keeps the single semantic
    # probe and mutation protocol visibly shared without erasing source APIs.
    func lower_set_membership(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, element_node: NodeId, mode: i64, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let collection = try host.lower_expression(module, function, value, body)
        let element = try host.lower_expression(module, function, element_node, body)
        var hir_element_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[node_type(self.state.program, value).value].form:
            Set(found): hir_element_type = found
            FrozenSet(found): hir_element_type = found
            else: trap("set operation has a non-set receiver")
        let element_type = try self.state.mir_type_of(module, function, span, hir_element_type)
        let key_hash = try host.lower_structural_hash(module, function, span, hir_element_type, element, body)
        let lookup = try self.lower_hash_lookup(host, module, function, span, hir_element_type, collection, element, key_hash, body)
        if mode == 0: return lookup.found
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        if mode == 1:
            host.open_if(lookup.found, [result], span, body)
            host.emit_yield(host.bool_constant(false, span, body), span, body)
            host.emit_else(span, body)
            let inserted = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
            body.append(MirInstruction(form = InstructionForm.HashInsertEntry(result = inserted, value = collection, hash = key_hash), span = span))
            let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = collection, index = inserted), span = span))
            host.initialize_owned_copy(element_type, key_address, element, span, body)
            host.emit_yield(host.bool_constant(true, span, body), span, body)
            host.emit_end(span, body)
            return result
        host.open_if(lookup.found, [result], span, body)
        let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = collection, index = lookup.index), span = span))
        host.emit_ownership_call(element_type, key_address, false, span, body)
        body.append(MirInstruction(form = InstructionForm.HashRemoveEntry(value = collection, index = lookup.index), span = span))
        host.emit_yield(host.bool_constant(true, span, body), span, body)
        host.emit_else(span, body)
        host.emit_yield(host.bool_constant(false, span, body), span, body)
        host.emit_end(span, body)
        return result

    func lower_hash_clear(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let collection = try host.lower_expression(module, function, value, body)
        let collection_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        match mir_type(self.state.types, collection_type):
            Map(key, item): body.append(MirInstruction(form = InstructionForm.HashClear(value = collection, key_release = host.ownership_helper_for(key).release, value_release = host.ownership_helper_for(item).release), span = span))
            Set(element):
                let unit = self.state.intern_lowered_type(make_struct_type(list[TypeId]()))
                body.append(MirInstruction(form = InstructionForm.HashClear(value = collection, key_release = host.ownership_helper_for(element).release, value_release = host.ownership_helper_for(unit).release), span = span))
            else: trap("hash clear has a non-collection receiver")
        return RegisterId(value = no_register)

    func lower_hash_reserve(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, minimum_capacity: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let collection = try host.lower_expression(module, function, value, body)
        let minimum = try host.lower_expression(module, function, minimum_capacity, body)
        body.append(MirInstruction(form = InstructionForm.HashReserve(value = collection, minimum_capacity = minimum), span = node_span(self.state.program, expression)))
        return RegisterId(value = no_register)

    func lower_hash_copy(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source = try host.lower_expression(module, function, value, body)
        let result_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(result_type)
        match mir_type(self.state.types, result_type):
            Map(key, item): body.append(MirInstruction(form = InstructionForm.HashCopy(result = result, value = source, key_retain = host.ownership_helper_for(key).retain, value_retain = host.ownership_helper_for(item).retain), span = span))
            Set(element):
                let unit = self.state.intern_lowered_type(make_struct_type(list[TypeId]()))
                body.append(MirInstruction(form = InstructionForm.HashCopy(result = result, value = source, key_retain = host.ownership_helper_for(element).retain, value_retain = host.ownership_helper_for(unit).retain), span = span))
            else: trap("hash copy has a non-collection result")
        return result

    # Preserve concatenation as one typed semantic operation. Backends alone
    # supply element layout; the runtime can allocate once and bulk-copy both
    # inputs without MIR encoding capacity or byte movement.
    func lower_list_concatenation(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_list_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let list_type = try self.state.mir_type_of(module, function, span, hir_list_type)
        let result = self.state.new_register(list_type)
        let element_type = self.list_element_mir_type(host, list_type)
        body.append(MirInstruction(form = InstructionForm.ListConcat(result = result, left = left, right = right, element_retain = host.ownership_helper_for(element_type).retain), span = span))
        return result

    func lower_sequence_slice(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, start: NodeId, end: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source = try host.lower_expression(module, function, value, body)
        let hir_source_type = node_type(self.state.program, value)
        let source_type = try self.state.mir_type_of(module, function, span, hir_source_type)
        var lower = host.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), 0, span, body)
        if start.value != no_node: lower = try host.lower_expression(module, function, start, body)
        var upper = lower
        if end.value != no_node: upper = try host.lower_expression(module, function, end, body)
        else:
            match self.state.program.types.definitions[hir_source_type.value].form:
                Array(element, count): upper = host.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), count, span, body)
                List(element):
                    upper = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                    body.append(MirInstruction(form = InstructionForm.ListLength(result = upper, value = source), span = span))
                Bytes: upper = try host.load_field(source_type, source, self.state.buffer_length_field(), span, body)
                else: trap("HIR admitted an unsupported sequence slice")
        let result_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(result_type)
        match self.state.program.types.definitions[hir_source_type.value].form:
            Array(element, count):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                self.lower_array_slice(host, result, source, element_type, count, lower, upper, span, body)
            List(element): body.append(MirInstruction(form = InstructionForm.ListSlice(result = result, value = source, start = lower, end = upper), span = span))
            Bytes:
                let owner = try host.load_field(source_type, source, self.state.buffer_owner_field(), span, body)
                let data = try host.load_field(source_type, source, self.state.buffer_data_field(), span, body)
                let length = try host.load_field(source_type, source, self.state.buffer_length_field(), span, body)
                body.append(MirInstruction(form = InstructionForm.BytesSlice(result = result, owner = owner, data = data, length = length, start = lower, end = upper), span = span))
            else: trap("HIR admitted an unsupported sequence slice")
        return result

    # A fixed array lives inline and therefore cannot lend its frame storage
    # to an escaping safe slice. Copy only the selected elements into the
    # shared immutable list-buffer protocol, then release the temporary list
    # identity after the slice has retained its backing buffer.
    func lower_array_slice(host: FunctionLoweringHost, result: RegisterId, source: RegisterId, element_type: TypeId, count: i64, lower: RegisterId, upper: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let source_length = host.integer_constant(index_type, count, span, body)
        self.guard_slice_bounds(host, lower, upper, source_length, span, body)
        let snapshot_length = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = snapshot_length, operation = BinaryOp.sub, left = upper, right = lower), span = span))

        let snapshot_list_type = self.state.intern_lowered_type(MirType.List(element = element_type))
        let snapshot_source = self.state.new_register(snapshot_list_type)
        let ownership = host.ownership_helper_for(element_type)
        body.append(MirInstruction(form = InstructionForm.ListCreate(result = snapshot_source), span = span))
        body.append(MirInstruction(form = InstructionForm.ListReserve(value = snapshot_source, minimum_capacity = snapshot_length, element_retain = ownership.retain), span = span))
        let loop = host.begin_counted_loop(lower, upper, list[RegisterId](), span, body)
        host.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
        let item = host.load_value(element_type, host.element_address(element_type, source, loop.index, span, body), span, body)
        let destination = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListAppendSlot(result = destination, value = snapshot_source, element_retain = ownership.retain), span = span))
        host.initialize_owned_value(element_type, destination, item, span, body)
        host.end_counted_loop(loop, span, body)

        let zero = host.integer_constant(index_type, 0, span, body)
        body.append(MirInstruction(form = InstructionForm.ListSlice(result = result, value = snapshot_source, start = zero, end = snapshot_length), span = span))
        body.append(MirInstruction(form = InstructionForm.ListRelease(value = snapshot_source, element_release = ownership.release), span = span))

    func guard_slice_bounds(host: FunctionLoweringHost, lower: RegisterId, upper: RegisterId, length: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let reversed = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = reversed, operation = BinaryOp.gt, left = lower, right = upper), span = span))
        host.open_if(reversed, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "slice bounds out of range"), span = span))
        host.emit_else(span, body)
        host.emit_end(span, body)
        let beyond_end = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = beyond_end, operation = BinaryOp.gt, left = upper, right = length), span = span))
        host.open_if(beyond_end, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "slice bounds out of range"), span = span))
        host.emit_else(span, body)
        host.emit_end(span, body)

    ## Evaluate the receiver and callback once, establish the scoped view,
    ## invoke it synchronously, and close the identity-wide shape barrier.
    ## No address or target layout escapes this canonical transaction.
    func lower_list_with_mutable_slice(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, callback: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let list_value = try host.lower_expression(module, function, value, body)
        let target = try host.lower_expression(module, function, callback, body)
        let list_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        let element_type = self.list_element_mir_type(host, list_type)
        let signature = try host.lower_function_value_signature(module, function, span, node_type(self.state.program, callback))
        if signature.is_fallible or signature.returns_never or len(signature.parameters) != 1 or len(signature.results) != 0:
            trap("typed mutable-slice callback has the wrong canonical signature")
        let view = self.state.new_register(signature.parameters[0])
        body.append(MirInstruction(form = InstructionForm.ListMutableSliceBegin(
            result = view,
            value = list_value,
            element_retain = host.ownership_helper_for(element_type).retain,
        ), span = span))
        body.append(MirInstruction(form = InstructionForm.CallClosure(
            results = no_registers(),
            signature = signature,
            target = target,
            arguments = self.state.operands.run([view]),
        ), span = span))
        body.append(MirInstruction(form = InstructionForm.MutableSliceEnd(value = view), span = span))
        return RegisterId(value = no_register)

    func lower_list_append(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, element: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let list_value = try host.lower_expression(module, function, value, body)
        let stored = try host.lower_expression(module, function, element, body)
        let element_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, element))
        let slot = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListAppendSlot(result = slot, value = list_value, element_retain = host.ownership_helper_for(element_type).retain), span = span))
        host.initialize_owned_value(element_type, slot, stored, span, body)
        return RegisterId(value = no_register)

    func lower_list_insert(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, index: NodeId, element: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        # Evaluate every source operand before changing the list's shape.
        let list_value = try host.lower_expression(module, function, value, body)
        let position = try host.lower_expression(module, function, index, body)
        let stored = try host.lower_expression(module, function, element, body)
        let element_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, element))
        let slot = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListInsertSlot(result = slot, value = list_value, index = position, element_retain = host.ownership_helper_for(element_type).retain), span = span))
        host.initialize_owned_value(element_type, slot, stored, span, body)
        return RegisterId(value = no_register)

    func lower_list_remove_at(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, index: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let list_value = try host.lower_expression(module, function, value, body)
        let position = try host.lower_expression(module, function, index, body)
        let element_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = list_value, index = position), span = span))
        var removed = host.load_value(element_type, address, span, body)
        # Aggregate values are addresses under the MIR protocol. Preserve the
        # removed value in independent caller-owned storage before shifting.
        if host.is_aggregate(element_type):
            let copy = host.new_temp(element_type, span, body)
            body.append(MirInstruction(form = InstructionForm.Memcpy(destination = copy, source = address, value_type = element_type), span = span))
            removed = copy
        body.append(MirInstruction(form = InstructionForm.ListRemoveAt(value = list_value, index = position, element_retain = host.ownership_helper_for(element_type).retain), span = span))
        return removed

    func lower_list_clear(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let list_value = try host.lower_expression(module, function, value, body)
        let list_type = try self.state.mir_type_of(module, function, node_span(self.state.program, expression), node_type(self.state.program, value))
        let element_type = self.list_element_mir_type(host, list_type)
        body.append(MirInstruction(form = InstructionForm.ListClear(value = list_value, element_release = host.ownership_helper_for(element_type).release), span = node_span(self.state.program, expression)))
        return RegisterId(value = no_register)

    func lower_list_reserve(host: FunctionLoweringHost, module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, minimum_capacity: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let list_value = try host.lower_expression(module, function, value, body)
        let minimum = try host.lower_expression(module, function, minimum_capacity, body)
        let list_type = try self.state.mir_type_of(module, function, node_span(self.state.program, expression), node_type(self.state.program, value))
        let element_type = self.list_element_mir_type(host, list_type)
        body.append(MirInstruction(form = InstructionForm.ListReserve(value = list_value, minimum_capacity = minimum, element_retain = host.ownership_helper_for(element_type).retain), span = node_span(self.state.program, expression)))
        return RegisterId(value = no_register)

    # Lists compare identity first, then ordered contents. An existing pair in
    # the active context is a coinductive success; every new pair still checks
    # length and each element before the root can succeed.
    func lower_list_equality(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_element_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let yes = host.bool_constant(true, span, body)
        let no = host.bool_constant(false, span, body)
        let result = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))

        let same_identity = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = same_identity, operation = BinaryOp.eq, left = left, right = right), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = same_identity, depth = 0, values = self.state.operands.run([yes])), span = span))
        let left_length = self.state.new_register(index_type)
        let right_length = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.ListLength(result = left_length, value = left), span = span))
        body.append(MirInstruction(form = InstructionForm.ListLength(result = right_length, value = right), span = span))
        let lengths_differ = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = lengths_differ, operation = BinaryOp.ne, left = left_length, right = right_length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = lengths_differ, depth = 0, values = self.state.operands.run([no])), span = span))
        if context != none:
            let active = context
            let visited = self.state.new_register(boolean)
            body.append(MirInstruction(form = InstructionForm.EqualityContextVisit(result = visited, context = active, left = left, right = right), span = span))
            body.append(MirInstruction(form = InstructionForm.BrIf(condition = visited, depth = 0, values = self.state.operands.run([yes])), span = span))

        let loop = host.begin_counted_loop_body(host.integer_constant(index_type, 0, span, body), left_length, false, span, body)
        host.exit_counted_loop_when_done(loop, [yes], span, body)
        let element_type = try self.state.mir_type_of(module, function, span, hir_element_type)
        let left_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let right_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = left_address, value = left, index = loop.index), span = span))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = right_address, value = right, index = loop.index), span = span))
        let left_value = host.load_value(element_type, left_address, span, body)
        let right_value = host.load_value(element_type, right_address, span, body)
        var element_equal = host.bool_constant(true, span, body)
        if context != none:
            let active = context
            element_equal = try host.lower_nested_equality(module, function, span, hir_element_type, left_value, right_value, active, body)
        else:
            element_equal = try host.lower_equality_definition(module, function, span, hir_element_type, left_value, right_value, none, body)
        let differs = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Unary(result = differs, operation = UnaryOp.bool_not, operand = element_equal), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = differs, depth = 1, values = self.state.operands.run([no])), span = span))
        host.end_counted_loop(loop, span, body)
        return result

    # Maps compare unordered key/value contents. Dense left-table traversal
    # preserves no ordering requirement: every key probes the right table by
    # structural hash and generated equality, then compares its mapped value.
    func lower_map_equality(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_key_type: ir.TypeId, hir_value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let yes = host.bool_constant(true, span, body)
        let no = host.bool_constant(false, span, body)
        let result = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
        let same_identity = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = same_identity, operation = BinaryOp.eq, left = left, right = right), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = same_identity, depth = 0, values = self.state.operands.run([yes])), span = span))
        let left_length = self.state.new_register(u64_type)
        let right_length = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.HashLength(result = left_length, value = left), span = span))
        body.append(MirInstruction(form = InstructionForm.HashLength(result = right_length, value = right), span = span))
        let lengths_differ = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = lengths_differ, operation = BinaryOp.ne, left = left_length, right = right_length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = lengths_differ, depth = 0, values = self.state.operands.run([no])), span = span))
        if context != none:
            let active = context
            let visited = self.state.new_register(boolean)
            body.append(MirInstruction(form = InstructionForm.EqualityContextVisit(result = visited, context = active, left = left, right = right), span = span))
            body.append(MirInstruction(form = InstructionForm.BrIf(condition = visited, depth = 0, values = self.state.operands.run([yes])), span = span))

        let loop = host.begin_counted_loop_body(host.integer_constant(u64_type, 0, span, body), left_length, false, span, body)
        host.exit_counted_loop_when_done(loop, [yes], span, body)
        let key_type = try self.state.mir_type_of(module, function, span, hir_key_type)
        let left_key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = left_key_address, value = left, index = loop.index), span = span))
        let key = host.load_value(key_type, left_key_address, span, body)
        let key_hash = try host.lower_structural_hash(module, function, span, hir_key_type, key, body)
        let lookup = try self.lower_hash_lookup(host, module, function, span, hir_key_type, right, key, key_hash, body)
        let missing = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Unary(result = missing, operation = UnaryOp.bool_not, operand = lookup.found), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = missing, depth = 1, values = self.state.operands.run([no])), span = span))
        let left_value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let right_value_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = left_value_address, value = left, index = loop.index), span = span))
        body.append(MirInstruction(form = InstructionForm.HashValueAddress(result = right_value_address, value = right, index = lookup.index), span = span))
        let value_type = try self.state.mir_type_of(module, function, span, hir_value_type)
        let left_value = host.load_value(value_type, left_value_address, span, body)
        let right_value = host.load_value(value_type, right_value_address, span, body)
        var values_equal = host.bool_constant(true, span, body)
        if context != none:
            let active = context
            values_equal = try host.lower_nested_equality(module, function, span, hir_value_type, left_value, right_value, active, body)
        else:
            values_equal = try host.lower_equality_definition(module, function, span, hir_value_type, left_value, right_value, none, body)
        let values_differ = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Unary(result = values_differ, operation = UnaryOp.bool_not, operand = values_equal), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = values_differ, depth = 1, values = self.state.operands.run([no])), span = span))
        host.end_counted_loop(loop, span, body)
        return result

    func lower_set_equality(host: FunctionLoweringHost, module: HirModule, function: HirFunction, span: SourceSpan, hir_element_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let yes = host.bool_constant(true, span, body)
        let no = host.bool_constant(false, span, body)
        let result = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
        let same_identity = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = same_identity, operation = BinaryOp.eq, left = left, right = right), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = same_identity, depth = 0, values = self.state.operands.run([yes])), span = span))
        let left_length = self.state.new_register(u64_type)
        let right_length = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.HashLength(result = left_length, value = left), span = span))
        body.append(MirInstruction(form = InstructionForm.HashLength(result = right_length, value = right), span = span))
        let lengths_differ = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = lengths_differ, operation = BinaryOp.ne, left = left_length, right = right_length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = lengths_differ, depth = 0, values = self.state.operands.run([no])), span = span))
        let loop = host.begin_counted_loop_body(host.integer_constant(u64_type, 0, span, body), left_length, false, span, body)
        host.exit_counted_loop_when_done(loop, [yes], span, body)
        let element_type = try self.state.mir_type_of(module, function, span, hir_element_type)
        let key_address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.HashKeyAddress(result = key_address, value = left, index = loop.index), span = span))
        let element = host.load_value(element_type, key_address, span, body)
        let key_hash = try host.lower_structural_hash(module, function, span, hir_element_type, element, body)
        let lookup = try self.lower_hash_lookup(host, module, function, span, hir_element_type, right, element, key_hash, body)
        let missing = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Unary(result = missing, operation = UnaryOp.bool_not, operand = lookup.found), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = missing, depth = 1, values = self.state.operands.run([no])), span = span))
        host.end_counted_loop(loop, span, body)
        return result

    func list_element_mir_type(host: FunctionLoweringHost, value_type: TypeId) -> TypeId:
        match mir_type(self.state.types, value_type):
            List(element): return element
            FrozenList(element): return element
            else: trap("list element type requested from a non-list MIR type")
