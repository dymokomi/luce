#==============================================================================================
#
#   full_representation - How full Luce represents its types in MIR
#
#   DESCRIPTION:
#       Full Luce's side of `ProfileRepresentation` (plan.md §5.0): an
#       interface value is a runtime existential with a requirement table,
#       every optional is the uniform tagged enum, and `Error` carries an
#       owned string. Base's side is profiles/base/mir/base_lowering.luc.
#
#==============================================================================================

from compiler.hir.ir import BuiltinType, resolve_builtin_type
import compiler.hir.ir as ir
from compiler.mir.canonical import TypeId
from compiler.mir.lowering_model import MirLoweringState, ProfileRepresentation

pub class FullProfileRepresentation: ProfileRepresentation:
    pub init():
        pass

    pub func interface_type(model: MirLoweringState, value: ir.TypeId) -> TypeId!:
        return try model.lower_runtime_interface_type(value)

    pub func optional_type(model: MirLoweringState, inner: ir.TypeId) -> TypeId!:
        return try model.tagged_optional_type(inner)

    pub func error_text_type(model: MirLoweringState) -> TypeId:
        return model.string_type()

    pub func error_text_hir_type(model: MirLoweringState) -> ir.TypeId!:
        return resolve_builtin_type(BuiltinType.string)
