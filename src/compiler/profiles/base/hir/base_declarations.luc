#==============================================================================================
#
#   base_declarations - What declaration collection decides only for Base
#
#   DESCRIPTION:
#       Base's side of `ProfileDeclarations` (plan.md §5.0): a module may
#       declare `var` and `thread_local var` globals with constant
#       initialisers, a global without one holds its zero value when the
#       type has one (base.md §6.1, §6.3), and `str` and `cstr` name the
#       text view and C text (§5.2, §5.5).
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.syntax import RuntimeGlobalSyntax
from compiler.hir.generation_model import HirGenerationState, HirSemanticChecker, ProfileDeclarations
from compiler.hir.ir import BuiltinType, TypeId, resolve_builtin_type

pub class BaseProfileDeclarations: ProfileDeclarations:
    let state: HirGenerationState

    pub init(state: HirGenerationState):
        self.state = state

    pub func validate_global(module_index: i64, is_public: bool, global: RuntimeGlobalSyntax, span: SourceSpan) -> !:
        return

    pub func validate_uninitialised_global(checker: HirSemanticChecker, module_index: i64, global: RuntimeGlobalSyntax, value_type: TypeId) -> !:
        let blocker = checker.zero_blocker_for_feature(value_type)
        if blocker != none:
            try self.state.fail_at(module_index, global.value_type.span, "global `" + global.name + "` has no zero value because `" + self.state.describe_type(value_type) + "` holds `" + self.state.describe_type(blocker) + "`; write a constant initialiser (base.md §6.1, §6.3)")

    ## `func(A) -> R` is a C function pointer: one word, never null (base.md §5.7).
    pub func function_type(parameters: list[TypeId], result: TypeId) -> TypeId:
        return self.state.intern_c_function_type(parameters, result)

    pub func builtin_type_named(name: str) -> TypeId?:
        # A Base module's `str` is the text view, not the owned string (base.md §5.5).
        if name == "str": return self.state.intern_string_view()
        # `cstr` is C text, `const u8*` until the distinct `c.char` lands (§5.2, §17.1).
        if name == "cstr": return self.state.intern_pointer(resolve_builtin_type(BuiltinType.unsigned_u8), true, false)
        return none
