#==============================================================================================
#
#   base_entry - Base's process entry contract
#
#   DESCRIPTION:
#       `pub func main(arguments: str[])` or `cstr[]`, returning `i32` or
#       `i32!` (base.md §9.7). The shared entry pass selects the profile;
#       everything Base-specific about the contract is here.
#
#==============================================================================================

from compiler.hir.generation_model import FunctionSymbol, HirGenerationState
from compiler.hir.ir import BuiltinType, resolve_builtin_type, types_match

pub func require_base_entry_contract(state: HirGenerationState, function: FunctionSymbol) -> !:
    if len(function.parameters) != 1:
        try fail(state, function, "must declare exactly one `arguments: str[]` parameter")
    let parameter = function.parameters[0]
    if parameter.name != "arguments":
        try fail(state, function, "parameter must be named `arguments`")
    var admitted = false
    match state.types.definitions[parameter.value_type.value].form:
        Span(element, is_const):
            match state.types.definitions[element.value].form:
                StringView: admitted = true
                Pointer(pointee, pointee_const, is_volatile):
                    admitted = pointee_const and types_match(pointee, resolve_builtin_type(BuiltinType.c_char))
                else: pass
        else: pass
    if not admitted:
        try fail(state, function, "parameter `arguments` must have type `str[]` or `cstr[]`")
    let int32 = resolve_builtin_type(BuiltinType.signed_i32)
    if types_match(function.result, int32): return
    match state.types.definitions[function.result.value].form:
        Fallible(success):
            if types_match(success, int32): return
        else: pass
    try fail(state, function, "result must be `i32` or `i32!`")

func fail(state: HirGenerationState, function: FunctionSymbol, detail: str) -> !:
    try state.fail_at(
        function.module_index, function.span,
        "invalid process entry `main`: " + detail + "; expected `pub func main(arguments: str[]) -> i32` (base.md §9.7)",
    )
