#==============================================================================================
#
#   base_escape - The address of a local may be passed down but not up
#
#   DESCRIPTION:
#       Luce Base's escape rule (docs/language/base.md §6.6). A pointer to a
#       local, or a span or view over a local array, may be passed to a call
#       but must not outlive the frame: the checker rejects returning it,
#       passing it as the message to `error(...)`, storing it in a global, and
#       storing it through a pointer parameter or into a struct that is
#       returned. The check follows `let` aliases within one function and
#       stops at calls; it catches the common mistakes and promises nothing
#       about the rest.
#
#       The pass reads finished HIR for one Base function, so it sees the
#       same nodes every backend sees and adds nothing to the checker's
#       expression forms.
#
#==============================================================================================

from compiler.frontend.source import format_diagnostic
from compiler.hir.ir import HirFunction, HirProgram, NodeId, Operands, SymbolId, entry_at, function_body, no_node, node_at, node_children, node_form, node_span
from compiler.hir.ir import place_element_step, place_field_step

## Reject every escaping address in one Base function.
pub func check_escapes(program: HirProgram, function: HirFunction) -> !:
    # An `extern` declaration has no body to check (base.md §17.1).
    match function.implementation:
        ExternalC(contract): return
        else: pass
    let checker = EscapeChecker(program, function)
    let body = function_body(function)
    for position in range(0, i64(body.count)):
        try checker.visit(node_at(program, body, position))

class EscapeChecker:
    let program: HirProgram
    let function: HirFunction
    ## Symbols whose value holds the address of a local: `let p = &x` and the
    ## structs such a value was stored into.
    let holders: list[u32]

    init(program: HirProgram, function: HirFunction):
        self.program = program
        self.function = function
        self.holders = list[u32]()

    # mark: Statements ========================================================================

    func visit(node: NodeId) -> !:
        match node_form(self.program, node):
            ReturnStatement(value):
                if value.value != no_node and self.holds_local_address(value):
                    try self.fail(node, "returns the address of a local; it may be passed down but not up (base.md §6.6)")
            Raise(code, message):
                if message.value != no_node and self.holds_local_address(message):
                    try self.fail(node, "passes the address of a local as the message of `error(...)` (base.md §6.6)")
            GlobalStore(global, operation, value):
                if self.holds_local_address(value):
                    try self.fail(node, "stores the address of a local in a global (base.md §6.6)")
            GlobalPlaceAssignment(global, steps, operation, value):
                if self.holds_local_address(value):
                    try self.fail(node, "stores the address of a local in a global (base.md §6.6)")
            PointerStore(pointer, steps, operation, value):
                if self.holds_local_address(value) and self.roots_at_parameter(pointer):
                    try self.fail(node, "stores the address of a local through a pointer parameter (base.md §6.6)")
            Binding(symbol, is_mutable, value):
                if self.holds_local_address(value): self.hold(symbol)
            Assignment(symbol, operation, value):
                if self.holds_local_address(value): self.hold(symbol)
            PlaceAssignment(symbol, steps, operation, value):
                if self.holds_local_address(value): self.hold(symbol)
            else: pass
        let children = list[NodeId]()
        node_children(self.program, node, children)
        for child in children: try self.visit(child)

    # mark: Values ============================================================================

    # Whether a value is, or contains, the address of a local of this frame.
    func holds_local_address(node: NodeId) -> bool:
        match node_form(self.program, node):
            AddressOf(pointer, symbol, global, steps):
                if pointer.value != no_node: return self.holds_local_address(pointer)
                return global < 0
            Reference(symbol): return self.is_holder(symbol)
            QualifyPointer(value): return self.holds_local_address(value)
            Cast(value): return self.holds_local_address(value)
            EnumFromInteger(value): return false
            InterfaceValue(value, conformance): return self.holds_local_address(value)
            PointerOffset(pointer, offset, negate): return self.holds_local_address(pointer)
            SpanFromParts(pointer, length): return self.holds_local_address(pointer)
            SpanSlice(span, start, end, inclusive): return self.holds_local_address(span)
            SpanElementAddress(span, index): return self.holds_local_address(span)
            SpanData(span): return self.holds_local_address(span)
            Some(value): return self.holds_local_address(value)
            ElseFallback(value, arm): return self.holds_local_address(value) or self.holds_local_address(arm)
            Conditional(value, condition, alternative): return self.holds_local_address(value) or self.holds_local_address(alternative)
            StructValue(struct_index, fields):
                for pair in range(0, i64(fields.count) // 2):
                    if self.holds_local_address(NodeId(value = u32(entry_at(self.program, fields, pair * 2 + 1)))): return true
                return false
            FieldAccess(value, field): return self.holds_local_address(value)
            else: return false

    # Whether a store's pointer reaches memory the caller owns: it is rooted
    # at a parameter, directly or through offsets, fields, and qualifiers.
    func roots_at_parameter(node: NodeId) -> bool:
        match node_form(self.program, node):
            Reference(symbol):
                for parameter in self.function.parameters:
                    if parameter.symbol.value == symbol.value: return true
                return false
            QualifyPointer(value): return self.roots_at_parameter(value)
            Cast(value): return self.roots_at_parameter(value)
            InterfaceValue(value, conformance): return self.roots_at_parameter(value)
            PointerOffset(pointer, offset, negate): return self.roots_at_parameter(pointer)
            SpanElementAddress(span, index): return self.roots_at_parameter(span)
            FieldAccess(value, field): return self.roots_at_parameter(value)
            Deref(pointer): return self.roots_at_parameter(pointer)
            else: return false

    func hold(symbol: SymbolId):
        if not self.is_holder(symbol): self.holders.append(symbol.value)

    func is_holder(symbol: SymbolId) -> bool:
        for holder in self.holders:
            if holder == symbol.value: return true
        return false

    func fail(node: NodeId, message: str) -> !:
        error(format_diagnostic(self.program.modules[self.function.module.value].path, node_span(self.program, node), "`" + self.function.name + "` " + message))
