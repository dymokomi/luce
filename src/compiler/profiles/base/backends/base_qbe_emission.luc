#==============================================================================================
#
#   base_qbe_emission - Base's part of the QBE backend
#
#   DESCRIPTION:
#       What QBE emits only for a Base program: the startup shim of base.md
#       §9.7, which builds `main`'s argument span from `argc` and `argv`.
#       The shared translator reaches this through `QbeEmissionHost`; full
#       Luce's shim lives in profiles/full/backends/qbe_emission.luc.
#
#==============================================================================================

from compiler.backends.layout import TypeLayout
from compiler.backends.qbe_emission_model import QbeEmissionHost
from compiler.backends.qbe_representation import IlWriter
from compiler.mir.canonical import MirProcessEntry, MirProgram, is_aggregate_type

pub class BaseProfileQbeEmission:
    let program: MirProgram
    let layout: TypeLayout
    let out: IlWriter

    pub init(program: MirProgram, layout: TypeLayout, out: IlWriter):
        self.program = program
        self.layout = layout
        self.out = out

    # The startup shim of a Base program (base.md §9.7): `main(argc, argv)`
    # builds `arguments` as a span over one stack array, a text view or a
    # `cstr` per argument, calls the entry, and turns an unhandled failure
    # into exit status 1. A text view's byte count is `strlen`.
    pub func emit_process_entry(host: QbeEmissionHost, entry: MirProcessEntry) -> !:
        let function = self.program.functions[entry.function.value]
        let element_size = self.layout.size_of(entry.element_type)
        let is_view = is_aggregate_type(self.program.types, entry.element_type)
        host.begin_function_emission()
        self.out.write("export function w $main(w %argc, l %argv) {\n@start\n")
        self.out.line("%entry_count =l extsw %argc")
        self.out.line("%entry_bytes =l mul %entry_count, " + str(element_size))
        self.out.line("%entry_bytes_or_one =l add %entry_bytes, 1")
        self.out.line("%entry_storage =l alloc16 %entry_bytes_or_one")
        self.out.line("%entry_index =l copy 0")
        host.terminate("\tjmp @entry_test\n")
        host.label("entry_test")
        self.out.line("%entry_more =w csltl %entry_index, %entry_count")
        host.terminate("\tjnz %entry_more, @entry_argument, @entry_invoke\n")
        host.label("entry_argument")
        self.out.line("%entry_argv_offset =l mul %entry_index, 8")
        self.out.line("%entry_argv_slot =l add %argv, %entry_argv_offset")
        self.out.line("%entry_c_string =l loadl %entry_argv_slot")
        self.out.line("%entry_offset =l mul %entry_index, " + str(element_size))
        self.out.line("%entry_slot =l add %entry_storage, %entry_offset")
        self.out.line("storel %entry_c_string, %entry_slot")
        if is_view:
            self.out.line("%entry_length =l call $strlen(l %entry_c_string)")
            self.out.line("%entry_length_slot =l add %entry_slot, " + str(self.layout.field_offset(entry.element_type, 1)))
            self.out.line("storel %entry_length, %entry_length_slot")
        self.out.line("%entry_index =l add %entry_index, 1")
        host.terminate("\tjmp @entry_test\n")
        host.label("entry_invoke")
        self.out.line("%entry_span =l alloc8 " + str(self.layout.size_of(entry.arguments_type)))
        self.out.line("storel %entry_storage, %entry_span")
        self.out.line("%entry_span_count =l add %entry_span, " + str(self.layout.field_offset(entry.arguments_type, 1)))
        self.out.line("storel %entry_count, %entry_span_count")
        if function.signature.is_fallible:
            self.out.line("%entry_error =l alloc16 " + str(self.layout.size_of(entry.failure_type)))
            self.out.line("%entry_status_out =l alloc4 4")
            self.out.line("%entry_failure =l call $" + host.function_name(entry.function) + "(l %entry_error, l %entry_span, l %entry_status_out)")
            self.out.line("%entry_failed =w cnel %entry_failure, 0")
            host.terminate("\tjnz %entry_failed, @entry_failure, @entry_success\n")
            host.label("entry_failure")
            host.terminate("\tret 1\n")
            host.label("entry_success")
            self.out.line("%entry_status =w loadw %entry_status_out")
            host.terminate("\tret %entry_status\n")
        else:
            self.out.line("%entry_status =w call $" + host.function_name(entry.function) + "(l %entry_span)")
            host.terminate("\tret %entry_status\n")
        self.out.write("}\n\n")

