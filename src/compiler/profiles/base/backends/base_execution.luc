#==============================================================================================
#
#   base_execution - Base's part of the reference interpreter
#
#   DESCRIPTION:
#       What the reference interpreter does only for a Base program: build
#       the process entry's `arguments` span (base.md §9.7). The shared
#       interpreter reaches this through `HirExecutionHost`; nothing here is
#       shared with full Luce's execution profile.
#
#==============================================================================================

from compiler.backends.hir_execution_model import HirExecutionHost, heap_frame
from compiler.hir.ir import BoxedValue, HirProgram, SymbolId, TypeId, Value, no_node

## `main(arguments: str[])` receives a span of text views over one heap
## array; `cstr[]` has no value in the oracle, whose addresses are places.
pub func base_process_arguments(program: HirProgram, host: HirExecutionHost, element: TypeId, arguments: list[str]) -> Value!:
    match program.types.definitions[element.value].form:
        StringView: pass
        else: error("interpreter: `main(arguments: cstr[])` has no value in the reference interpreter (base.md §19.3)")
    let elements = list[BoxedValue]()
    for argument in arguments: elements.append(BoxedValue(value = Value.Text(value = argument)))
    let cell = host.allocate_heap_cell(Value.Array(elements = elements))
    let first = Value.Address(frame = heap_frame, symbol = SymbolId(value = no_node), global = cell, path = [0])
    return Value.Span(base = BoxedValue(value = first), length = len(arguments))
