#==============================================================================================
#
#   syntax - The source tree
#
#   DESCRIPTION:
#       What the programmer wrote, kept faithful. Nothing here is resolved, typed,
#       or lowered — the parser builds these nodes, and every later consumer
#       (HIR generation, diagnostics, documentation, a future formatter) reads the same
#       shapes. Resolved, typed meaning belongs to hir/ir.luc.
#
#       The file follows the grammar from broadest construct to smallest, the same
#       order the parser reads source:
#
#       module -> declarations -> C boundary declarations -> statements
#              -> expressions and patterns -> types -> shared forms
#
#       Each recursive node family is a class holding one tagged `Form` union
#       (`ExpressionSyntax` holds an `ExpressionForm`, and so on). A class
#       supplies the reference indirection a recursive tree needs, so anything
#       that holds a recursive node (`DeclarationSyntax`, `SuiteSyntax`,
#       `PathSyntax`) is a class too, and carries the source span. The union
#       names each source form once. Small leaf records stay plain value
#       structs. The parser never mutates a node after publishing it.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.frontend.tokenizer import Token

# mark: Module ================================================================================

## One `.luc` file: optional module documentation, leading imports, then
## module declarations.
pub struct ModuleSyntax:
    pub let documentation: list[str]
    pub let imports: list[ImportSyntax]
    pub let declarations: list[DeclarationSyntax]
    pub let span: SourceSpan

# `import compiler.frontend.parser as parser`, or a selective `from` import. An empty
# `names` list denotes a module import; selective imports never use an alias.
pub struct ImportSyntax:
    pub let path: PathSyntax
    pub let names: list[ImportedNameSyntax]
    pub let alias_name: str?
    pub let span: SourceSpan

# `ModuleSyntax` in `from compiler.frontend.syntax import ModuleSyntax`.
pub struct ImportedNameSyntax:
    pub let name: str
    pub let span: SourceSpan

# mark: Declarations ==========================================================================

## Documentation and visibility wrapped around one module declaration.
pub class DeclarationSyntax:
    pub let documentation: list[str]
    pub let is_public: bool
    pub let value: DeclarationKind
    pub let span: SourceSpan

    pub init(documentation: list[str], is_public: bool, value: DeclarationKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# Every non-import module declaration accepted by 1.0.
pub union DeclarationKind:
    Constant(value: ConstantSyntax)
    RuntimeGlobal(value: RuntimeGlobalSyntax)
    TypeAlias(value: TypeAliasSyntax)
    Function(value: FunctionSyntax)
    NominalType(value: NominalTypeSyntax)
    Enumeration(value: EnumSyntax)
    InterfaceType(value: InterfaceSyntax)
    TestDeclaration(value: TestSyntax)
    ExportStruct(value: ExportStructSyntax)
    ExportEnum(value: ExportEnumSyntax)
    ExportFunction(value: FunctionSyntax)
    ExternType(value: ExternTypeSyntax)
    ExternFunction(value: ExternFunctionSyntax)
    ExternVariable(value: ExternVariableSyntax)
    ExternStruct(value: ExternStructSyntax)

# `let maximum: u64 = 100`
pub struct ConstantSyntax:
    pub let name: str
    pub let annotation: TypeSyntax?
    pub let value: ExpressionSyntax

# `var next_offset: u64` in the sealed runtime package. It has no source
# initializer: every isolated runtime instance begins with structural zero.
pub struct RuntimeGlobalSyntax:
    pub let name: str
    pub let value_type: TypeSyntax

# `type Identifier = u64`
pub struct TypeAliasSyntax:
    pub let name: str
    pub let value: TypeSyntax

# `func clamp(value: i64) -> i64: ...`, with or without an interface body.
pub struct FunctionSyntax:
    pub let is_mutating: bool
    pub let name: str
    pub let generic_parameters: list[GenericParameterSyntax]
    pub let parameters: list[ParameterSyntax]
    pub let result: TypeSyntax?
    pub let body: SuiteSyntax?
    pub let span: SourceSpan

# `struct Point[T] implements Hashable: ...`
pub struct NominalTypeSyntax:
    pub let kind: NominalTypeKind
    pub let name: str
    pub let generic_parameters: list[GenericParameterSyntax]
    pub let interfaces: list[TypeSyntax]
    pub let members: list[TypeMemberSyntax]

# Distinguishes `struct Name:` from `class Name:`.
pub enum NominalTypeKind:
    struct_type
    class_type

# `pub let width: u32` or `pub func render(): ...` inside a type.
pub class TypeMemberSyntax:
    pub let documentation: list[str]
    pub let is_public: bool
    pub let value: TypeMemberKind
    pub let span: SourceSpan

    pub init(documentation: list[str], is_public: bool, value: TypeMemberKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# A field or method declared inside a struct, class, enum, or interface.
pub union TypeMemberKind:
    Field(value: FieldSyntax)
    Function(value: FunctionSyntax)

# `weak var parent: Node? = none`
pub struct FieldSyntax:
    pub let is_weak: bool
    pub let is_mutable: bool
    pub let name: str
    pub let value_type: TypeSyntax
    pub let default_value: ExpressionSyntax?
    pub let span: SourceSpan

# `enum Shape[T] implements Drawable: ...`
pub struct EnumSyntax:
    pub let name: str
    pub let generic_parameters: list[GenericParameterSyntax]
    pub let interfaces: list[TypeSyntax]
    pub let cases: list[EnumCaseSyntax]
    pub let methods: list[TypeMemberSyntax]

# `circle(radius: f64)` inside an enum.
pub struct EnumCaseSyntax:
    pub let documentation: list[str]
    pub let name: str
    pub let payload: list[NamedTypeSyntax]
    pub let span: SourceSpan

# `interface Reader[T]: ...`
pub struct InterfaceSyntax:
    pub let name: str
    pub let generic_parameters: list[GenericParameterSyntax]
    pub let methods: list[TypeMemberSyntax]

# `test "parser accepts a module": ...`
pub struct TestSyntax:
    pub let description: Token
    pub let body: SuiteSyntax

# mark: C boundary declarations ===============================================================

# `export c struct Pixel: ...`
pub struct ExportStructSyntax:
    pub let name: str
    pub let fields: list[ExportFieldSyntax]

# `let red: u8` inside an exported C struct. Export already makes every field
# part of the native API, so this node has no source-visibility state.
pub struct ExportFieldSyntax:
    pub let documentation: list[str]
    pub let name: str
    pub let value_type: TypeSyntax
    pub let span: SourceSpan

# `export c enum Status as u32: ...`
pub struct ExportEnumSyntax:
    pub let name: str
    pub let representation: str
    pub let cases: list[ExportEnumCaseSyntax]

# `ready = 1` inside an exported C enum.
pub struct ExportEnumCaseSyntax:
    pub let documentation: list[str]
    pub let name: str
    pub let is_negative: bool
    pub let value: Token
    pub let span: SourceSpan

# `extern type Window` or `extern type Device = i32`. The representation is
# one of the four integer handle widths, or none for a pointer-shaped handle.
pub struct ExternTypeSyntax:
    pub let name: str
    pub let representation: str?

# `extern func SDL_CreateWindow(title: str, w: i32) -> Window?`, with
# `extern blocking func` marking a call that may suspend the caller.
pub struct ExternFunctionSyntax:
    pub let is_blocking: bool
    pub let name: str
    pub let parameters: list[ExternParameterSyntax]
    pub let result: TypeSyntax?

# `window: Window` or `out w: i32` inside an extern function's parameters.
# The C shape is the whole declaration, so there is never a default value.
pub struct ExternParameterSyntax:
    pub let is_out: bool
    pub let name: str
    pub let value_type: TypeSyntax
    pub let span: SourceSpan

# `extern var SDL_version_number: i32`
pub struct ExternVariableSyntax:
    pub let name: str
    pub let value_type: TypeSyntax

# `extern struct Rect implements Display:`. Its plain `name: Type` fields
# are implicitly public immutable members, while methods use the ordinary
# nominal member syntax. C layout is an additional boundary fact, not a
# separate in-language representation.
pub struct ExternStructSyntax:
    pub let name: str
    pub let interfaces: list[TypeSyntax]
    pub let members: list[TypeMemberSyntax]

# mark: Statements ============================================================================

## Bindings, assignments, control flow, returns, and call statements.
pub class StatementSyntax:
    pub let form: StatementForm
    pub let span: SourceSpan

    pub init(form: StatementForm, span: SourceSpan):
        self.form = form
        self.span = span

# The tagged source form held by one `StatementSyntax` node.
pub union StatementForm:
    BreakStatement
    ContinueStatement
    Binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax)
    Assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax)
    ReturnStatement(value: ExpressionSyntax?)
    DeferStatement(value: ExpressionSyntax)
    RecoverStatement(value: ExpressionSyntax)
    ExpressionStatement(value: ExpressionSyntax)
    IfStatement(branches: list[IfBranchSyntax], fallback: SuiteSyntax?)
    WhileStatement(condition: ExpressionSyntax, body: SuiteSyntax)
    ForStatement(is_fallible: bool, name: str, iterable: ExpressionSyntax, body: SuiteSyntax)
    MatchStatement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax])

# `if ready: ...` or one following `elif retrying: ...` branch.
pub struct IfBranchSyntax:
    pub let condition: ConditionSyntax
    pub let body: SuiteSyntax
    pub let span: SourceSpan

# `ready` or `let value = optional` after `if`.
pub class ConditionSyntax:
    pub let form: ConditionForm
    pub let span: SourceSpan

    pub init(form: ConditionForm, span: SourceSpan):
        self.form = form
        self.span = span

pub union ConditionForm:
    Expression(value: ExpressionSyntax)
    Binding(name: str, value: ExpressionSyntax)

# `.open(path), .save(path): store(path)` inside a statement match.
pub struct MatchStatementArmSyntax:
    pub let patterns: list[PatternSyntax]
    pub let body: SuiteSyntax
    pub let span: SourceSpan

# mark: Expressions and patterns ==============================================================

## Literals, calls, operators, lambdas, closures, and value-producing matches.
pub class ExpressionSyntax:
    pub let form: ExpressionForm
    pub let span: SourceSpan

    pub init(form: ExpressionForm, span: SourceSpan):
        self.form = form
        self.span = span

# The tagged source form held by one `ExpressionSyntax` node.
pub union ExpressionForm:
    Literal(token: Token)
    FormattedString(start: Token, parts: list[FormatPartSyntax])
    Name(value: str)
    CaseValue(name: str, arguments: list[ArgumentSyntax])
    Group(value: ExpressionSyntax)
    ## `(T)x`, C's cast (base.md §7.5); the parser reads it only when the
    ## parenthesised text is a scalar type name.
    Cast(target: TypeSyntax, value: ExpressionSyntax)
    ## `T[](pointer, count)`: a Luce Base span from its parts (base.md §5.4).
    SpanConstruct(element: TypeSyntax, arguments: list[ArgumentSyntax])
    TupleValue(elements: list[ExpressionSyntax])
    ListValue(elements: list[ExpressionSyntax])
    MapValue(entries: list[MapEntrySyntax])
    Unary(operator: str, operand: ExpressionSyntax)
    Binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax)
    Conditional(value: ExpressionSyntax, condition: ExpressionSyntax, alternative: ExpressionSyntax)
    ElseValue(value: ExpressionSyntax, arm: ExpressionSyntax)
    Member(value: ExpressionSyntax, name: str)
    Call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax])
    Index(value: ExpressionSyntax, subscript: ExpressionSyntax)
    Slice(value: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?)
    Lambda(parameters: list[ParameterSyntax], body: ExpressionSyntax)
    Closure(captures: list[CaptureSyntax], parameters: list[ParameterSyntax], result: TypeSyntax?, body: SuiteSyntax)
    MatchValue(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax])
    NewValue(value_type: TypeSyntax, arguments: list[ArgumentSyntax])
    SpawnValue(function: PathSyntax, arguments: list[ArgumentSyntax])
    CatchValue(value: ExpressionSyntax, failure_name: str, body: SuiteSyntax)

# `frame ` or `{frame}` inside `f"frame {frame}"`. Text keeps its source
# spelling, `{{`/`}}` included; a field holds one ordinary expression.
pub union FormatPartSyntax:
    Text(token: Token)
    Field(value: ExpressionSyntax, span: SourceSpan)

# `"accent": "blue"` inside a map literal.
pub struct MapEntrySyntax:
    pub let key: ExpressionSyntax
    pub let value: ExpressionSyntax
    pub let span: SourceSpan

# `'0'..='9', _ => 0` inside an expression-valued match.
pub struct MatchValueArmSyntax:
    pub let patterns: list[PatternSyntax]
    pub let value: ExpressionSyntax
    pub let span: SourceSpan

# One literal in a pattern, preserving whether source unary `-` preceded its
# numeric token. For example, `-10` stores token `10` with `is_negative = true`.
pub struct PatternLiteralSyntax:
    pub let token: Token
    pub let is_negative: bool
    pub let span: SourceSpan

# `_`, `-1`, `'0'..='9'`, or `.open(path)` in a match arm. Case bindings are
# bare names for now; give them tokens, as `BindingPatternSyntax.TupleNames`
# has, once `match` reaches HIR and diagnostics need to point at one.
pub union PatternSyntax:
    Wildcard(span: SourceSpan)
    Literal(value: PatternLiteralSyntax)
    RangePattern(lower: PatternLiteralSyntax, operator: str, upper: PatternLiteralSyntax, span: SourceSpan)
    CasePattern(name: str, bindings: list[str], span: SourceSpan)

# `value` or `(quotient, remainder)` on the left of a binding. Tuple names
# keep their tokens so a diagnostic can point at one name, not the pattern.
pub union BindingPatternSyntax:
    Name(value: str, span: SourceSpan)
    TupleNames(values: list[Token], span: SourceSpan)

# mark: Types =================================================================================

## `Image`, `list[Point]`, `(i64, str)`, or `func(i64) -> bool`.
pub class TypeSyntax:
    pub let form: TypeForm
    pub let span: SourceSpan

    pub init(form: TypeForm, span: SourceSpan):
        self.form = form
        self.span = span

# The tagged source form held by one `TypeSyntax` node.
pub union TypeForm:
    Named(path: PathSyntax)
    Applied(path: PathSyntax, arguments: list[TypeArgumentSyntax])
    GroupedType(value: TypeSyntax)
    TupleType(elements: list[TypeSyntax])
    FunctionType(parameters: list[TypeSyntax], result: TypeSyntax)
    CFunctionType(parameters: list[TypeSyntax], result: TypeSyntax)
    OptionalType(value: TypeSyntax)
    ## `T*`, `const T*`, `volatile T*`: a Luce Base pointer to `pointee` (base.md §5.3).
    PointerType(pointee: TypeSyntax, is_const: bool, is_volatile: bool)
    ## `T[]`, `const T[]`: a Luce Base span, a pointer and a length (base.md §5.4).
    SpanType(element: TypeSyntax, is_const: bool)
    FallibleType(value: TypeSyntax)

# `Point` or the array length `16` inside generic brackets.
pub union TypeArgumentSyntax:
    TypeArgument(value: TypeSyntax)
    IntegerArgument(token: Token)

# `radius: f64` in an enum-case payload or another named typed slot.
pub struct NamedTypeSyntax:
    pub let name: str
    pub let value_type: TypeSyntax
    pub let span: SourceSpan

# mark: Shared forms ==========================================================================

## `compiler.frontend.parser` — a dotted name, one part per segment.
pub class PathSyntax:
    pub let parts: list[str]
    pub let span: SourceSpan

    pub init(parts: list[str], span: SourceSpan):
        self.parts = parts
        self.span = span

    # The path as written: `compiler.frontend.parser`.
    pub func dotted() -> str:
        var name = self.parts[0]
        for part in self.parts[1:]:
            name = name + "." + part
        return name

    # The final segment, which names the imported module by default.
    pub func last() -> str:
        return self.parts[len(self.parts) - 1]

# `: return value` or `:\n    return value`
pub class SuiteSyntax:
    pub let style: SuiteStyle
    pub let statements: list[StatementSyntax]
    pub let span: SourceSpan

    pub init(style: SuiteStyle, statements: list[StatementSyntax], span: SourceSpan):
        self.style = style
        self.statements = statements
        self.span = span

# `if ready: return value` versus an indented body after `:`.
pub enum SuiteStyle:
    inline_suite
    indented_suite

# `T: Hashable & Equatable` inside `[T: Hashable & Equatable]`.
pub struct GenericParameterSyntax:
    pub let name: str
    pub let constraints: list[TypeSyntax]
    pub let span: SourceSpan

# `samples: u32 = 64`, or inferred `value` in `(value) => value`.
pub struct ParameterSyntax:
    pub let name: str
    pub let annotation: TypeSyntax?
    pub let default_value: ExpressionSyntax?
    pub let span: SourceSpan

# `scene` or `samples: 256` inside a call.
pub struct ArgumentSyntax:
    pub let label: str?
    pub let value: ExpressionSyntax
    pub let span: SourceSpan

# `weak owner` or `copy snapshot = counter` inside a closure capture list.
pub struct CaptureSyntax:
    pub let name: str
    pub let value: ExpressionSyntax?
    pub let is_weak: bool
    pub let span: SourceSpan
