#==============================================================================================
#
#   source - Locations and diagnostics
#
#   DESCRIPTION:
#       Source coordinates shared by every compiler stage. Token, syntax, HIR,
#       and lowering all point at the same `SourceSpan`; they do not import the
#       tokenizer just to name a line and column.
#
#       Fatal diagnostics still cross Stage-0's error channel as strings:
#       tokenizer and parser emit `line:column: message` because they do not
#       know the file path, while later stages call `format_diagnostic`.
#       Recoverable reports use the structured `Diagnostic` value below so
#       analysis, commands, and future tooling share facts without printing
#       from a compiler pass.
#
#==============================================================================================

## Locates a half-open source range and its human-readable starting position.
## Four `u32`s (16 bytes): a span sits in every token, syntax node, HIR node,
## and MIR instruction, so its size is a compile-time cost paid everywhere.
pub struct SourceSpan:
    pub let start: u32
    pub let end: u32
    pub let line: u32
    pub let column: u32

# mark: Structured diagnostics ================================================================

## Classification carried independently of presentation and command policy.
pub enum DiagnosticSeverity:
    warning
    failure

## One annotated source range. Secondary labels let a diagnostic relate
## declarations and uses without flattening either location into prose.
pub struct DiagnosticLabel:
    pub let path: str
    pub let span: SourceSpan
    pub let message: str

## A structured compiler report. `code` is stable for tools and tests;
## `message` is the concise conclusion, labels hold source facts, and `help`
## gives one concrete correction. Empty help is permitted when none applies.
pub struct Diagnostic:
    pub let severity: DiagnosticSeverity
    pub let code: str
    pub let message: str
    pub let primary: DiagnosticLabel
    pub let secondary: list[DiagnosticLabel]
    pub let help: str

    ## Stable plain-text rendering used by the command line. Editors consume
    ## the fields directly and do not need to parse this presentation.
    pub func render() -> str:
        var severity_name = "error"
        if self.severity == DiagnosticSeverity.warning: severity_name = "warning"
        var rendered = severity_name + "[" + self.code + "]: " + self.message
        rendered = rendered + "\n  --> " + diagnostic_location(self.primary)
        if len(self.primary.message) > 0: rendered = rendered + "\n   = " + self.primary.message
        for label in self.secondary:
            rendered = rendered + "\n  ::: " + diagnostic_location(label)
            if len(label.message) > 0: rendered = rendered + "\n   = " + label.message
        if len(self.help) > 0: rendered = rendered + "\n   = help: " + self.help
        return rendered

func diagnostic_location(label: DiagnosticLabel) -> str:
    return label.path + ":" + str(i64(label.span.line)) + ":" + str(i64(label.span.column))

# mark: Legacy fatal formatting ================================================================

## `line:column: ` prefix used when the caller adds the path, or when there
## is no path yet. Example: `format_location(2, 7)` returns `2:7: `.
pub func format_location(line: i64, column: i64) -> str:
    return str(line) + ":" + str(column) + ": "

## `path:line:column: message`. Example: `src/main.luc:3:1: unknown name`.
pub func format_diagnostic(path: str, span: SourceSpan, message: str) -> str:
    return path + ":" + format_location(i64(span.line), i64(span.column)) + message
