#==============================================================================================
#
#   parser - Tokens into source syntax
#
#   DESCRIPTION:
#       Reads one token stream from top to bottom and builds the source tree
#       defined in the neighboring `syntax.luc`. The grammar it implements is the one in
#       `docs/language/1.0.md`; section numbers in this file refer to it.
#       The class follows the grammar from broadest construct to smallest,
#       and the marks below are its chapters:
#
#       Module -> Declarations -> C boundary declarations -> Declaration details
#       -> Suites and statements -> Match patterns -> Types
#       -> Expression precedence -> Primary expressions -> Arguments and subscripts
#       -> Token stream and diagnostics -> Expression lookahead -> Parser tables
#
#       Public use begins at `Parser.parse`. Three pieces of state shape how
#       every rule below decides where a construct ends:
#
#       - `in_inline_suite` is set while parsing the one-statement suite of
#         `if ready: return value`, so the statement may end at a closing
#         delimiter instead of a newline and may not open another suite.
#       - `expression_limit` is a token index a slice bound must stop at, so
#         `xs[a..<b]` parses `a` and `b` as two bounded expressions.
#       - `expression_has_ended` combines both with the layout tokens the
#         tokenizer emitted: an expression is over once a newline or dedent
#         has been consumed, or the limit is reached.
#
#       Cursor movement, lookahead, spans, and diagnostics stay private at the
#       bottom of the class; pure tables and predicates sit after it.
#
#==============================================================================================

from compiler.core_types import is_core_type_name, is_scalar_type_name
from compiler.profile import Profile
from compiler.frontend.source import SourceSpan, format_location
from compiler.frontend.tokenizer import Token, TokenKind
from compiler.frontend.syntax import ArgumentSyntax, BindingPatternSyntax, CaptureSyntax
from compiler.frontend.syntax import ConditionForm, ConditionSyntax, ConstantSyntax, DeclarationKind, DeclarationSyntax, RuntimeGlobalSyntax
from compiler.frontend.syntax import EnumCaseSyntax, EnumSyntax, ExportEnumCaseSyntax
from compiler.frontend.syntax import ExportEnumSyntax, ExportFieldSyntax
from compiler.frontend.syntax import ExportStructSyntax, ExpressionForm, ExpressionSyntax, ExternFunctionSyntax
from compiler.frontend.syntax import ExternParameterSyntax, ExternStructSyntax, ExternTypeSyntax, ExternVariableSyntax
from compiler.frontend.syntax import FieldSyntax, FormatPartSyntax, FunctionSyntax
from compiler.frontend.syntax import GenericParameterSyntax, IfBranchSyntax, ImportedNameSyntax
from compiler.frontend.syntax import ImportSyntax, InterfaceSyntax
from compiler.frontend.syntax import MapEntrySyntax, MatchStatementArmSyntax, MatchValueArmSyntax
from compiler.frontend.syntax import ModuleSyntax, NamedTypeSyntax, NominalTypeKind, NominalTypeSyntax
from compiler.frontend.syntax import ParameterSyntax, PathSyntax, PatternLiteralSyntax, PatternSyntax
from compiler.frontend.syntax import StatementForm, StatementSyntax
from compiler.frontend.syntax import SuiteStyle, SuiteSyntax, TestSyntax, TypeAliasSyntax
from compiler.frontend.syntax import TypeArgumentSyntax, TypeForm, TypeMemberKind, TypeMemberSyntax, TypeSyntax
import std.strings

# A declaration owns a body; an interface member ends after its signature.
# `parse_type_member` uses the same distinction to reject `pub` and fields
# inside an interface, where every member is a required signature.
enum FunctionForm:
    definition
    signature

## Parses one complete token stream into a 1.0 source tree.
# Pair every opening bracket with the token that closes it, in one pass per
# bracket kind. Each kind is counted on its own, exactly as the scan it
# replaces did, so unbalanced input pairs the same way it always has.
# The deepest the expression grammar may nest. 256 is what Swift's parser and
# Clang's `-fbracket-depth` allow, both from the C++ standard's recommended
# minimum limits, and it is far below the ~26000 at which the host stack goes.
let max_nesting: i64 = 256

func match_brackets(tokens: list[Token]) -> list[i64]:
    let matching = list[i64]()
    for token in tokens:
        matching.append(-1)
    let openings = ["(", "[", "{"]
    let closings = [")", "]", "}"]
    for pair in range(0, len(openings)):
        let opening = openings[pair]
        let closing = closings[pair]
        let stack = list[i64]()
        for index in range(0, len(tokens)):
            let text = tokens[index].text
            if text == opening:
                stack.append(index)
            elif text == closing and len(stack) > 0:
                matching[stack.pop()] = index
    return matching

pub class Parser:
    let tokens: list[Token]
    let profile: Profile
    # For every token that opens a bracket, the index of the one that closes
    # it; -1 everywhere else. Built once in `init`, because the lookaheads
    # that need it (`is_lambda_ahead`, `is_generic_call_ahead`,
    # `parse_subscript`) ask at every nesting level, and scanning for the
    # match each time makes parsing quadratic in nesting depth: 16 KiB of
    # nested parentheses cost 20 s that way, against 0.2 s for the 500 KiB of
    # this compiler's own source.
    let matching: list[i64]
    var position: i64
    # True while parsing `if ready: return value` — the one-statement suite
    # form, which cannot nest another suite.
    var in_inline_suite: bool
    # Token index a bounded slice-part parse must stop at; -1 when unbounded.
    var expression_limit: i64
    # How deep the expression grammar is currently nested. Bounded because the
    # descent is recursive and the host stack is not: 26250 nested parentheses
    # took SIGBUS before this, which is a crash where a diagnostic belongs.
    var nesting: i64

    ## The profile decides which grammar the module gets: only a Luce Base
    ## module reads `T[N]`, `T[]`, `(T)x`, and `T[](p, n)` (base.md §3.2).
    pub init(tokens: list[Token], profile: Profile = Profile.full):
        self.profile = profile
        self.tokens = tokens
        self.matching = match_brackets(tokens)
        self.position = 0
        self.in_inline_suite = false
        self.expression_limit = -1
        self.nesting = 0

    # mark: Module ==============================================================================

    pub func parse() -> ModuleSyntax!:
        let first = self.current()
        let documentation = try self.parse_module_documentation()
        let imports = list[ImportSyntax]()
        let declarations = list[DeclarationSyntax]()

        while self.at_keyword("import") or self.at_keyword("from"):
            imports.append(try self.parse_import())
        while not self.at_kind(TokenKind.eof):
            declarations.append(try self.parse_declaration())

        let end = self.current()

        try self.expect_kind(TokenKind.eof, "end of file")
        return ModuleSyntax(
            documentation = documentation,
            imports = imports,
            declarations = declarations,
            span = span_between(first, end),
        )

    # A `##` block at the top of the file documents the module when it stands
    # apart from what follows: a blank line, an import, or nothing at all. A
    # block touching the first declaration documents that declaration instead;
    # `parse_documentation` below enforces that touching rule for declarations.
    func parse_module_documentation() -> list[str]!:
        if not self.at_kind(TokenKind.doc_comment):
            return list[str]()
        var index = self.position
        while self.token_at(index + 1).kind == TokenKind.doc_comment:
            index += 1
        let following = self.token_at(index + 1)
        let is_detached = (
            following.kind == TokenKind.eof
            or (following.kind == TokenKind.keyword and (following.text == "import" or following.text == "from"))
            or following.span.line != self.token_at(index).span.line + 1
        )
        if not is_detached:
            return list[str]()
        return try self.read_documentation_lines()

    func parse_import() -> ImportSyntax!:
        let start = self.current()
        let names = list[ImportedNameSyntax]()
        var alias_name: str? = none
        let is_selective = self.take_keyword("from")

        if not is_selective:
            try self.expect_keyword("import")
        let path = try self.parse_path()
        if is_selective:
            try self.expect_keyword("import")
            while true:
                let name = try self.expect_name("imported name")
                names.append(ImportedNameSyntax(name = name.text, span = name.span))
                if not self.take_symbol(","):
                    break
        elif self.take_keyword("as"):
            alias_name = (try self.expect_name("import alias")).text

        let end = self.current()

        try self.expect_kind(TokenKind.newline, "newline after import")
        return ImportSyntax(
            path = path,
            names = names,
            alias_name = alias_name,
            span = span_between(start, end),
        )

    # mark: Declarations ========================================================================

    # One branch per declaration keyword, in the order section 28.1 lists
    # them: `let`, `type`, `func`, `struct`/`class`, `enum`, `interface`,
    # `test`, `export`, `extern`. Each branch parses its body and wraps it in
    # a `DeclarationSyntax` carrying the shared documentation and `pub` flag.
    func parse_declaration() -> DeclarationSyntax!:
        let documentation = try self.parse_documentation()
        let start = self.current()
        let is_public = self.take_keyword("pub")

        if self.take_keyword("let"):
            let value = try self.parse_constant()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.Constant(value = value),
            )

        if self.take_keyword("var"):
            let value = try self.parse_runtime_global()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.RuntimeGlobal(value = value),
            )

        if self.take_keyword("type"):
            let value = try self.parse_type_alias()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.TypeAlias(value = value),
            )

        var is_mutating = false
        if self.take_keyword("mutating"):
            is_mutating = true
        if self.take_keyword("func"):
            if is_mutating:
                try self.fail(start, "`mutating` marks a value method; a module function has no receiver")
            let value = try self.parse_function(start, false, FunctionForm.definition, false)
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.Function(value = value),
            )
        if is_mutating:
            try self.fail(self.current(), "`mutating` must modify a function declaration")

        if self.take_keyword("struct"):
            let value = try self.parse_nominal_type(NominalTypeKind.struct_type)
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.NominalType(value = value),
            )
        if self.take_keyword("class"):
            let value = try self.parse_nominal_type(NominalTypeKind.class_type)
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.NominalType(value = value),
            )
        if self.take_keyword("enum"):
            let value = try self.parse_enum()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.Enumeration(value = value),
            )
        if self.take_keyword("interface"):
            let value = try self.parse_interface()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.InterfaceType(value = value),
            )

        if self.take_keyword("test"):
            if is_public:
                try self.fail(start, "a test declaration cannot use `pub`")
            let value = try self.parse_test()
            return self.make_declaration(
                start,
                documentation,
                false,
                DeclarationKind.TestDeclaration(value = value),
            )

        if self.take_keyword("export"):
            if is_public:
                try self.fail(start, "an exported C declaration cannot also use `pub`")
            return try self.parse_export(start, documentation)

        if self.take_keyword("extern"):
            return try self.parse_extern(start, documentation, is_public)

        error(self.diagnostic(self.current(), "expected a module declaration"))

    func make_declaration(
        start: Token,
        documentation: list[str],
        is_public: bool,
        value: DeclarationKind,
    ) -> DeclarationSyntax:
        return DeclarationSyntax(
            documentation = documentation,
            is_public = is_public,
            value = value,
            span = self.span_from(start),
        )

    func parse_constant() -> ConstantSyntax!:
        let name = (try self.expect_name("constant name")).text
        var annotation: TypeSyntax? = none
        if self.take_symbol(":"):
            annotation = try self.parse_type()
        try self.expect_symbol("=")
        let value = try self.parse_expression()
        try self.expect_statement_end()
        return ConstantSyntax(
            name = name,
            annotation = annotation,
            value = value,
        )

    func parse_runtime_global() -> RuntimeGlobalSyntax!:
        let name = (try self.expect_name("runtime global name")).text
        try self.expect_symbol(":")
        let value_type = try self.parse_type()
        try self.expect_kind(TokenKind.newline, "newline after runtime global")
        return RuntimeGlobalSyntax(name = name, value_type = value_type)

    func parse_type_alias() -> TypeAliasSyntax!:
        let name = (try self.expect_name("type alias name")).text
        try self.expect_symbol("=")
        let value = try self.parse_type()
        try self.expect_kind(TokenKind.newline, "newline after type alias")
        return TypeAliasSyntax(name = name, value = value)

    # `is_method` admits the `self` receiver, which only a type member declares.
    func parse_function(start: Token, is_mutating: bool, form: FunctionForm, is_method: bool) -> FunctionSyntax!:
        let name = (try self.expect_name("function name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let parameters = try self.parse_parameters(is_method)
        let result = try self.parse_result_type()
        var body: SuiteSyntax? = none
        if form == FunctionForm.definition:
            try self.expect_symbol(":")
            body = try self.parse_suite()
        else:
            try self.expect_kind(TokenKind.newline, "newline after function signature")
        return FunctionSyntax(
            is_mutating = is_mutating,
            name = name,
            generic_parameters = generic_parameters,
            parameters = parameters,
            result = result,
            body = body,
            span = self.span_from(start),
        )

    func parse_nominal_type(kind: NominalTypeKind) -> NominalTypeSyntax!:
        let name = (try self.expect_name("type name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let interfaces = try self.parse_implements_clause()
        try self.expect_symbol(":")
        let members = try self.parse_type_members()
        return NominalTypeSyntax(
            kind = kind,
            name = name,
            generic_parameters = generic_parameters,
            interfaces = interfaces,
            members = members,
        )

    func parse_type_members() -> list[TypeMemberSyntax]!:
        try self.expect_kind(TokenKind.newline, "newline before type body")
        try self.expect_kind(TokenKind.indent, "indented type body")
        let members = list[TypeMemberSyntax]()
        while not self.at_kind(TokenKind.dedent):
            members.append(try self.parse_type_member(FunctionForm.definition))
        if len(members) == 0:
            try self.fail(self.current(), "a type body cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of type body")
        return members

    func parse_type_member(form: FunctionForm) -> TypeMemberSyntax!:
        let documentation = try self.parse_documentation()
        let start = self.current()
        let is_public = self.take_keyword("pub")
        if form == FunctionForm.signature and is_public:
            try self.fail(start, "interface methods are implicitly public; remove `pub`")
        let is_field = self.at_keyword("weak") or self.at_keyword("let") or self.at_keyword("var")
        if form == FunctionForm.signature and is_field:
            try self.fail(self.current(), "an interface member must be a function signature")
        let is_weak = self.take_keyword("weak")

        if self.at_keyword("let") or self.at_keyword("var"):
            let field = try self.parse_field(is_weak)
            return self.make_type_member(start, documentation, is_public, TypeMemberKind.Field(value = field))
        if is_weak:
            try self.fail(self.current(), "`weak` must modify a field")

        return try self.parse_method_member(start, documentation, is_public, form)

    # Parse the common method tail after a member grammar has decided how its
    # fields are spelled. Ordinary and extern structs deliberately share this
    # path so receiver, mutability, generic, and body rules cannot drift.
    func parse_method_member(
        start: Token,
        documentation: list[str],
        is_public: bool,
        form: FunctionForm,
    ) -> TypeMemberSyntax!:
        var is_mutating = false
        if self.take_keyword("mutating"):
            is_mutating = true
        try self.expect_keyword("func")
        let function = try self.parse_function(start, is_mutating, form, true)
        return self.make_type_member(
            start,
            documentation,
            is_public,
            TypeMemberKind.Function(value = function),
        )

    func make_type_member(
        start: Token,
        documentation: list[str],
        is_public: bool,
        value: TypeMemberKind,
    ) -> TypeMemberSyntax:
        return TypeMemberSyntax(
            documentation = documentation,
            is_public = is_public,
            value = value,
            span = self.span_from(start),
        )

    func parse_field(is_weak: bool) -> FieldSyntax!:
        let start = self.current()
        let is_mutable = self.take_keyword("var")
        if not is_mutable:
            try self.expect_keyword("let")
        let name = (try self.expect_name("field name")).text
        try self.expect_symbol(":")
        let value_type = try self.parse_type()
        var default_value: ExpressionSyntax? = none
        if self.take_symbol("="):
            default_value = try self.parse_expression()
        try self.expect_statement_end()
        return FieldSyntax(
            is_weak = is_weak,
            is_mutable = is_mutable,
            name = name,
            value_type = value_type,
            default_value = default_value,
            span = self.span_from(start),
        )

    func parse_enum() -> EnumSyntax!:
        let name = (try self.expect_name("enum name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let interfaces = try self.parse_implements_clause()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before enum body")
        try self.expect_kind(TokenKind.indent, "indented enum body")

        let cases = list[EnumCaseSyntax]()
        let methods = list[TypeMemberSyntax]()
        var parsing_methods = false
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            let is_public = self.take_keyword("pub")
            if self.at_keyword("func") or self.at_keyword("mutating"):
                parsing_methods = true
                var is_mutating = false
                if self.take_keyword("mutating"):
                    is_mutating = true
                try self.expect_keyword("func")
                let function = try self.parse_function(start, is_mutating, FunctionForm.definition, true)
                methods.append(self.make_type_member(
                    start,
                    documentation,
                    is_public,
                    TypeMemberKind.Function(value = function),
                ))
            else:
                if is_public:
                    try self.fail(start, "enum cases inherit visibility; remove `pub`")
                if parsing_methods:
                    try self.fail(start, "enum cases must precede enum methods")
                cases.append(try self.parse_enum_case(documentation))
        if len(cases) == 0:
            try self.fail(self.current(), "an enum must declare at least one case")
        try self.expect_kind(TokenKind.dedent, "end of enum body")
        return EnumSyntax(
            name = name,
            generic_parameters = generic_parameters,
            interfaces = interfaces,
            cases = cases,
            methods = methods,
        )

    func parse_enum_case(documentation: list[str]) -> EnumCaseSyntax!:
        let start = self.current()
        let name = (try self.expect_name("enum case name")).text
        let payload = list[NamedTypeSyntax]()
        if self.take_symbol("("):
            if not self.at_symbol(")"):
                while true:
                    let field_start = self.current()
                    let field_name = (try self.expect_name("payload name")).text
                    try self.expect_symbol(":")
                    let value_type = try self.parse_type()
                    payload.append(NamedTypeSyntax(
                        name = field_name,
                        value_type = value_type,
                        span = self.span_from(field_start),
                    ))
                    if not self.take_symbol(","):
                        break
                    if self.at_symbol(")"):
                        break
            try self.expect_symbol(")")
        try self.expect_kind(TokenKind.newline, "newline after enum case")
        return EnumCaseSyntax(
            documentation = documentation,
            name = name,
            payload = payload,
            span = self.span_from(start),
        )

    func parse_interface() -> InterfaceSyntax!:
        let name = (try self.expect_name("interface name")).text
        let generic_parameters = try self.parse_generic_parameters()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before interface body")
        try self.expect_kind(TokenKind.indent, "indented interface body")
        let methods = list[TypeMemberSyntax]()
        while not self.at_kind(TokenKind.dedent):
            methods.append(try self.parse_type_member(FunctionForm.signature))
        if len(methods) == 0:
            try self.fail(self.current(), "an interface body cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of interface body")
        return InterfaceSyntax(
            name = name,
            generic_parameters = generic_parameters,
            methods = methods,
        )

    func parse_test() -> TestSyntax!:
        let description = self.current()
        try self.expect_kind(TokenKind.str_lit, "test description")
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return TestSyntax(
            description = description,
            body = body,
        )

    # mark: C boundary declarations =============================================================

    func parse_export(start: Token, documentation: list[str]) -> DeclarationSyntax!:
        let abi = try self.expect_name("`c` after `export`")
        if abi.text != "c":
            try self.fail(abi, "expected `c` after `export`")

        if self.take_keyword("struct"):
            let value = try self.parse_export_struct()
            return self.make_declaration(
                start,
                documentation,
                false,
                DeclarationKind.ExportStruct(value = value),
            )
        if self.take_keyword("enum"):
            let value = try self.parse_export_enum()
            return self.make_declaration(
                start,
                documentation,
                false,
                DeclarationKind.ExportEnum(value = value),
            )
        if self.take_keyword("func"):
            let value = try self.parse_export_function(start)
            return self.make_declaration(
                start,
                documentation,
                false,
                DeclarationKind.ExportFunction(value = value),
            )
        error(self.diagnostic(self.current(), "expected `struct`, `enum`, or `func` after `export c`"))

    func parse_export_function(start: Token) -> FunctionSyntax!:
        let name = (try self.expect_name("exported function name")).text
        let parameters = try self.parse_parameters(false)
        let result = try self.parse_result_type()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return FunctionSyntax(
            is_mutating = false,
            name = name,
            generic_parameters = list[GenericParameterSyntax](),
            parameters = parameters,
            result = result,
            body = body,
            span = self.span_from(start),
        )

    func parse_export_struct() -> ExportStructSyntax!:
        let name = (try self.expect_name("exported struct name")).text
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before exported struct body")
        try self.expect_kind(TokenKind.indent, "indented exported struct body")
        let fields = list[ExportFieldSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            try self.expect_keyword("let")
            let name_token = try self.expect_name("exported field name")
            try self.expect_symbol(":")
            let value_type = try self.parse_type()
            try self.expect_kind(TokenKind.newline, "newline after exported field")
            fields.append(ExportFieldSyntax(
                documentation = documentation,
                name = name_token.text,
                value_type = value_type,
                span = self.span_from(start),
            ))
        if len(fields) == 0:
            try self.fail(self.current(), "an exported struct cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of exported struct body")
        return ExportStructSyntax(name = name, fields = fields)

    func parse_export_enum() -> ExportEnumSyntax!:
        let name = (try self.expect_name("exported enum name")).text
        try self.expect_keyword("as")
        let representation = (try self.expect_name("exported enum representation")).text
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before exported enum body")
        try self.expect_kind(TokenKind.indent, "indented exported enum body")
        let cases = list[ExportEnumCaseSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            let case_name = (try self.expect_name("exported enum case")).text
            try self.expect_symbol("=")
            let is_negative = self.take_symbol("-")
            let value = self.current()
            try self.expect_kind(TokenKind.int_lit, "integer enum value")
            try self.expect_kind(TokenKind.newline, "newline after exported enum case")
            cases.append(ExportEnumCaseSyntax(
                documentation = documentation,
                name = case_name,
                is_negative = is_negative,
                value = value,
                span = self.span_from(start),
            ))
        if len(cases) == 0:
            try self.fail(self.current(), "an exported enum cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of exported enum body")
        return ExportEnumSyntax(
            name = name,
            representation = representation,
            cases = cases,
        )

    # `extern` heads the four boundary declarations of section 21.16: a nominal
    # handle type, a C function, a C variable, and a C-layout struct.
    func parse_extern(start: Token, documentation: list[str], is_public: bool) -> DeclarationSyntax!:
        if self.take_keyword("type"):
            let value = try self.parse_extern_type()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.ExternType(value = value),
            )
        if self.take_keyword("var"):
            let value = try self.parse_extern_variable()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.ExternVariable(value = value),
            )
        if self.take_keyword("struct"):
            let value = try self.parse_extern_struct()
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.ExternStruct(value = value),
            )

        let is_blocking = self.take_contextual("blocking")
        if is_blocking or self.at_keyword("func"):
            try self.expect_keyword("func")
            let value = try self.parse_extern_function(is_blocking)
            return self.make_declaration(
                start,
                documentation,
                is_public,
                DeclarationKind.ExternFunction(value = value),
            )
        error(self.diagnostic(
            self.current(),
            "expected `type`, `func`, `blocking func`, `var`, or `struct` after `extern`",
        ))

    func parse_extern_type() -> ExternTypeSyntax!:
        let name = (try self.expect_name("extern type name")).text
        var representation: str? = none
        if self.take_symbol("="):
            let width = try self.expect_name("extern type representation")
            if not is_extern_handle_width(width.text):
                try self.fail(width, "an extern type representation must be `u32`, `i32`, `u64`, or `i64`")
            representation = width.text
        try self.expect_kind(TokenKind.newline, "newline after extern type")
        return ExternTypeSyntax(name = name, representation = representation)

    # An extern function is a declaration only: the C shape, never a body.
    func parse_extern_function(is_blocking: bool) -> ExternFunctionSyntax!:
        let name = (try self.expect_name("extern function name")).text
        let parameters = try self.parse_extern_parameters()
        let result = try self.parse_result_type()
        if result != none and is_fallible_type(result):
            try self.fail(
                self.previous(),
                "an extern is not fallible; C reports failure in its return value, and the wrapper is where `!` lives",
            )
        try self.expect_kind(TokenKind.newline, "newline after extern function")
        return ExternFunctionSyntax(
            is_blocking = is_blocking,
            name = name,
            parameters = parameters,
            result = result,
        )

    func parse_extern_parameters() -> list[ExternParameterSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[ExternParameterSyntax]()
        if not self.at_symbol(")"):
            while true:
                let start = self.current()
                # `out` is the result modifier only when a parameter name
                # follows it, so `out: i32` stays a parameter named `out`.
                var is_out = false
                let has_out_modifier = (
                    start.kind == TokenKind.name
                    and start.text == "out"
                    and self.peek(1).kind == TokenKind.name
                )
                if has_out_modifier:
                    self.step()
                    is_out = true
                let name = (try self.expect_name("extern parameter name")).text
                if not self.take_symbol(":"):
                    try self.fail(self.current(), "parameter requires a type")
                let value_type = try self.parse_type()
                if self.at_symbol("="):
                    try self.fail(
                        start,
                        "an extern parameter takes no default; the C shape is the whole truth",
                    )
                parameters.append(ExternParameterSyntax(
                    is_out = is_out,
                    name = name,
                    value_type = value_type,
                    span = self.span_from(start),
                ))
                if not self.take_symbol(","):
                    break
                if self.at_symbol(")"):
                    break
        try self.expect_symbol(")")
        return parameters

    func parse_extern_variable() -> ExternVariableSyntax!:
        let name = (try self.expect_name("extern variable name")).text
        try self.expect_symbol(":")
        let value_type = try self.parse_type()
        try self.expect_kind(TokenKind.newline, "newline after extern variable")
        return ExternVariableSyntax(name = name, value_type = value_type)

    func parse_extern_struct() -> ExternStructSyntax!:
        let name = (try self.expect_name("extern struct name")).text
        let interfaces = try self.parse_implements_clause()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before extern struct body")
        try self.expect_kind(TokenKind.indent, "indented extern struct body")
        let members = list[TypeMemberSyntax]()
        var field_count = 0
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            let is_public = self.take_keyword("pub")
            if self.at_keyword("func") or self.at_keyword("mutating"):
                members.append(try self.parse_method_member(
                    start,
                    documentation,
                    is_public,
                    FunctionForm.definition,
                ))
                continue
            if is_public:
                try self.fail(start, "extern struct fields are implicitly public; remove `pub`")
            let field_name = (try self.expect_name("extern field name")).text
            try self.expect_symbol(":")
            let value_type = try self.parse_type()
            var default_value: ExpressionSyntax? = none
            if self.take_symbol("="):
                default_value = try self.parse_expression()
            try self.expect_statement_end()
            let field = FieldSyntax(
                is_weak = false,
                is_mutable = false,
                name = field_name,
                value_type = value_type,
                default_value = default_value,
                span = self.span_from(start),
            )
            members.append(self.make_type_member(
                start,
                documentation,
                true,
                TypeMemberKind.Field(value = field),
            ))
            field_count += 1
        if field_count == 0:
            try self.fail(self.current(), "an extern struct must declare at least one field")
        try self.expect_kind(TokenKind.dedent, "end of extern struct body")
        return ExternStructSyntax(name = name, interfaces = interfaces, members = members)

    # mark: Declaration details ================================================================

    # Declaration documentation must touch the declaration it describes, so a
    # blank line separates commentary from documentation without a marker.
    # The module-level exception is `parse_module_documentation` above.
    func parse_documentation() -> list[str]!:
        let lines = try self.read_documentation_lines()
        if len(lines) > 0 and self.current().span.line != self.previous().span.line + 1:
            try self.fail(self.previous(), "documentation must immediately precede a declaration")
        return lines

    func read_documentation_lines() -> list[str]!:
        let lines = list[str]()
        var previous_line = 0
        while self.at_kind(TokenKind.doc_comment):
            let token = self.advance()
            if previous_line > 0 and i64(token.span.line) != previous_line + 1:
                try self.fail(token, "documentation lines must be consecutive")
            var content_start = 2
            if len(token.text) > 2 and token.text[2] == ' ':
                content_start = 3
            lines.append(token.text[content_start:])
            previous_line = i64(token.span.line)
        return lines

    func parse_generic_parameters() -> list[GenericParameterSyntax]!:
        let parameters = list[GenericParameterSyntax]()
        if not self.take_symbol("["):
            return parameters
        if self.at_symbol("]"):
            try self.fail(self.current(), "generic parameter list cannot be empty")

        while true:
            let start = self.current()
            let name = (try self.expect_name("generic parameter")).text
            let constraints = list[TypeSyntax]()
            if self.take_symbol(":"):
                constraints.append(try self.parse_type())
                while self.take_symbol("&"):
                    constraints.append(try self.parse_type())
            parameters.append(GenericParameterSyntax(
                name = name,
                constraints = constraints,
                span = self.span_from(start),
            ))
            if not self.take_symbol(","):
                break
            if self.at_symbol("]"):
                break
        try self.expect_symbol("]")
        return parameters

    func parse_implements_clause() -> list[TypeSyntax]!:
        let interfaces = list[TypeSyntax]()
        if not self.take_keyword("implements"):
            return interfaces
        interfaces.append(try self.parse_type())
        while self.take_symbol(","):
            interfaces.append(try self.parse_type())
        return interfaces

    func parse_parameters(is_method: bool) -> list[ParameterSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[ParameterSyntax]()
        if not self.at_symbol(")"):
            while true:
                parameters.append(try self.parse_parameter(is_method))
                if not self.take_symbol(","):
                    break
                if self.at_symbol(")"):
                    break
        try self.expect_symbol(")")
        return parameters

    func parse_parameter(is_method: bool) -> ParameterSyntax!:
        let start = self.current()
        var name = ""
        var annotation: TypeSyntax? = none
        let is_self = self.take_keyword("self")

        if is_self:
            if not is_method:
                try self.fail(start, "`self` is the receiver of a method; only a type member declares it")
            name = "self"
        else:
            name = (try self.expect_name("parameter name")).text
            if not self.take_symbol(":"):
                try self.fail(self.current(), "parameter requires a type")
            annotation = try self.parse_type()

        var default_value: ExpressionSyntax? = none
        if self.take_symbol("="):
            if is_self:
                try self.fail(self.previous(), "`self` cannot have a default value")
            default_value = try self.parse_expression()

        return ParameterSyntax(
            name = name,
            annotation = annotation,
            default_value = default_value,
            span = self.span_from(start),
        )

    func parse_result_type() -> TypeSyntax?!:
        if self.take_symbol("->"):
            return try self.parse_type()
        return none

    func parse_path() -> PathSyntax!:
        let start = self.current()
        let parts = list[str]()
        parts.append((try self.expect_name("name")).text)
        while self.take_symbol("."):
            parts.append((try self.expect_name("name after `.`")).text)
        return PathSyntax(parts = parts, span = self.span_from(start))

    # mark: Suites and statements ===============================================================

    func parse_suite() -> SuiteSyntax!:
        let start = self.current()
        if self.in_inline_suite:
            try self.fail(start, "a same-line suite cannot contain another suite")
        let statements = list[StatementSyntax]()
        if self.take_kind(TokenKind.newline):
            try self.expect_kind(TokenKind.indent, "indented suite")
            while not self.at_kind(TokenKind.dedent):
                if self.at_kind(TokenKind.eof):
                    try self.fail(self.current(), "unterminated suite")
                statements.append(try self.parse_statement())
            if len(statements) == 0:
                try self.fail(self.current(), "a suite cannot be empty")
            try self.expect_kind(TokenKind.dedent, "end of suite")
            return SuiteSyntax(
                style = SuiteStyle.indented_suite,
                statements = statements,
                span = self.span_from(start),
            )

        self.in_inline_suite = true
        statements.append(try self.parse_simple_statement())
        self.in_inline_suite = false
        return SuiteSyntax(
            style = SuiteStyle.inline_suite,
            statements = statements,
            span = self.span_from(start),
        )

    func parse_statement() -> StatementSyntax!:
        if self.at_kind(TokenKind.doc_comment):
            try self.fail(self.current(), "documentation comments must precede declarations")
        if self.at_keyword("if"):
            return try self.parse_if_statement()
        if self.at_keyword("while"):
            return try self.parse_while_statement()
        if self.at_keyword("for") or (self.at_keyword("try") and self.peek(1).text == "for"):
            return try self.parse_for_statement()
        if self.at_keyword("match"):
            return try self.parse_match_statement()
        return try self.parse_simple_statement()

    func parse_simple_statement() -> StatementSyntax!:
        let start = self.current()
        if self.take_keyword("let") or self.take_keyword("var"):
            return try self.parse_binding_statement(start)
        if self.take_keyword("break"):
            try self.expect_kind(TokenKind.newline, "newline after `break`")
            return StatementSyntax(form = StatementForm.BreakStatement, span = self.span_from(start))
        if self.take_keyword("continue"):
            try self.expect_kind(TokenKind.newline, "newline after `continue`")
            return StatementSyntax(form = StatementForm.ContinueStatement, span = self.span_from(start))
        if self.take_keyword("return"):
            var value: ExpressionSyntax? = none
            if not self.at_kind(TokenKind.newline):
                value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.ReturnStatement(
                value = value
            ), span = self.span_from(start))
        if self.take_keyword("defer"):
            let value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.DeferStatement(
                value = value
            ), span = self.span_from(start))
        if self.take_keyword("recover"):
            let value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.RecoverStatement(
                value = value
            ), span = self.span_from(start))

        let has_compound_statement = (
            self.at_keyword("if")
            or self.at_keyword("while")
            or self.at_keyword("for")
            or (self.at_keyword("try") and self.peek(1).text == "for")
            or self.at_keyword("match")
        )
        if has_compound_statement:
            try self.fail(self.current(), "a compound statement cannot be used in an inline suite")

        let value = try self.parse_expression()
        if is_assignment_operator(self.current().text):
            if not self.is_assignment_target(value):
                try self.fail(start, "invalid assignment target")
            let operator = self.advance().text
            let assigned_value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.Assignment(
                target = value,
                operator = operator,
                value = assigned_value
            ), span = self.span_from(start))
        try self.expect_statement_end()
        return StatementSyntax(form = StatementForm.ExpressionStatement(
            value = value
        ), span = self.span_from(start))

    func parse_binding_statement(start: Token) -> StatementSyntax!:
        let is_mutable = start.text == "var"
        let pattern = try self.parse_binding_pattern()
        var annotation: TypeSyntax? = none
        if self.take_symbol(":"):
            annotation = try self.parse_type()
        try self.expect_symbol("=")
        let value = try self.parse_expression()
        try self.expect_statement_end()
        return StatementSyntax(form = StatementForm.Binding(
            is_mutable = is_mutable,
            pattern = pattern,
            annotation = annotation,
            value = value
        ), span = self.span_from(start))

    func parse_binding_pattern() -> BindingPatternSyntax!:
        let start = self.current()
        if self.at_kind(TokenKind.name):
            let name = self.advance().text
            return BindingPatternSyntax.Name(value = name, span = self.span_from(start))

        try self.expect_symbol("(")
        let names = list[Token]()
        names.append(try self.expect_name("binding name"))
        try self.expect_symbol(",")
        names.append(try self.expect_name("binding name"))
        while self.take_symbol(","):
            if self.at_symbol(")"):
                break
            names.append(try self.expect_name("binding name"))
        try self.expect_symbol(")")
        return BindingPatternSyntax.TupleNames(values = names, span = self.span_from(start))

    func parse_if_statement() -> StatementSyntax!:
        let start = self.current()
        try self.expect_keyword("if")
        let branches = list[IfBranchSyntax]()
        let has_conditional_binding = self.at_keyword("let")
        let condition = try self.parse_condition()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        branches.append(IfBranchSyntax(
            condition = condition,
            body = body,
            span = span_between(start, self.previous()),
        ))

        while self.at_keyword("elif"):
            let branch_start = self.advance()
            if has_conditional_binding or self.at_keyword("let"):
                try self.fail(branch_start, "a conditional binding cannot have an `elif` branch")
            let branch_condition = try self.parse_condition()
            try self.expect_symbol(":")
            let branch_body = try self.parse_suite()
            branches.append(IfBranchSyntax(
                condition = branch_condition,
                body = branch_body,
                span = span_between(branch_start, self.previous()),
            ))

        var fallback: SuiteSyntax? = none
        if self.take_keyword("else"):
            try self.expect_symbol(":")
            fallback = try self.parse_suite()
        return StatementSyntax(form = StatementForm.IfStatement(
            branches = branches,
            fallback = fallback
        ), span = self.span_from(start))

    func parse_condition() -> ConditionSyntax!:
        if self.take_keyword("let"):
            let start = self.previous()
            let name = (try self.expect_name("conditional binding name")).text
            try self.expect_symbol("=")
            let value = try self.parse_expression()
            return ConditionSyntax(form = ConditionForm.Binding(
                name = name,
                value = value
            ), span = self.span_from(start))
        let value = try self.parse_expression()
        return ConditionSyntax(form = ConditionForm.Expression(value = value), span = value.span)

    func parse_while_statement() -> StatementSyntax!:
        let start = self.current()
        try self.expect_keyword("while")
        let condition = try self.parse_expression()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return StatementSyntax(form = StatementForm.WhileStatement(
            condition = condition,
            body = body
        ), span = self.span_from(start))

    func parse_for_statement() -> StatementSyntax!:
        let start = self.current()
        let is_fallible = self.take_keyword("try")
        try self.expect_keyword("for")
        let name = (try self.expect_name("iteration binding")).text
        try self.expect_keyword("in")
        let iterable = try self.parse_expression()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return StatementSyntax(form = StatementForm.ForStatement(
            is_fallible = is_fallible,
            name = name,
            iterable = iterable,
            body = body
        ), span = self.span_from(start))

    func parse_match_statement() -> StatementSyntax!:
        let start = self.current()
        try self.expect_keyword("match")
        let subject = try self.parse_expression()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before match arms")
        try self.expect_kind(TokenKind.indent, "indented match arms")
        let arms = list[MatchStatementArmSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let arm_start = self.current()
            let patterns = try self.parse_match_patterns()
            try self.expect_symbol(":")
            let body = try self.parse_suite()
            arms.append(MatchStatementArmSyntax(
                patterns = patterns,
                body = body,
                span = self.span_from(arm_start),
            ))
        if len(arms) == 0:
            try self.fail(self.current(), "a match must contain at least one arm")
        try self.expect_kind(TokenKind.dedent, "end of match arms")
        return StatementSyntax(form = StatementForm.MatchStatement(
            subject = subject,
            arms = arms
        ), span = self.span_from(start))

    # mark: Match patterns =======================================================================

    func parse_match_patterns() -> list[PatternSyntax]!:
        let patterns = list[PatternSyntax]()
        patterns.append(try self.parse_pattern())
        while self.take_symbol(","):
            patterns.append(try self.parse_pattern())
        return patterns

    func parse_pattern() -> PatternSyntax!:
        let start = self.current()
        if self.take_symbol("_"):
            return PatternSyntax.Wildcard(span = self.span_from(start))
        if self.is_literal(self.current()) or self.at_symbol("-"):
            let lower = try self.parse_pattern_literal()
            if self.at_symbol("..<") or self.at_symbol("..="):
                let operator = self.advance().text
                if not self.is_literal(self.current()) and not self.at_symbol("-"):
                    try self.fail(self.current(), "expected a literal at the end of a pattern range")
                let upper = try self.parse_pattern_literal()
                return PatternSyntax.RangePattern(
                    lower = lower,
                    operator = operator,
                    upper = upper,
                    span = self.span_from(start),
                )
            return PatternSyntax.Literal(value = lower)
        try self.expect_symbol(".")
        let name = (try self.expect_case_name()).text
        let bindings = list[str]()
        if self.take_symbol("("):
            if not self.at_symbol(")"):
                while true:
                    bindings.append((try self.expect_name("pattern binding")).text)
                    if not self.take_symbol(","):
                        break
            try self.expect_symbol(")")
        return PatternSyntax.CasePattern(name = name, bindings = bindings, span = self.span_from(start))

    # Read one pattern literal and preserve an optional numeric minus sign.
    # Examples: `'a'` is unsigned syntax; `-10i32` records `10i32` plus its sign.
    func parse_pattern_literal() -> PatternLiteralSyntax!:
        let start = self.current()
        let is_negative = self.take_symbol("-")
        if is_negative:
            let kind = self.current().kind
            if kind != TokenKind.int_lit and kind != TokenKind.float_lit:
                try self.fail(self.current(), "expected a numeric literal after `-` in a pattern")
        elif not self.is_literal(self.current()):
            try self.fail(self.current(), "expected a literal in a pattern")
        let token = self.advance()
        return PatternLiteralSyntax(
            token = token,
            is_negative = is_negative,
            span = self.span_from(start),
        )

    # mark: Types ================================================================================

    func parse_type() -> TypeSyntax!:
        let start = self.current()
        # Base qualifiers prefix the pointee and attach to the `*` that follows
        # (base.md §5.3); in full Luce these words are ordinary names.
        var is_const = false
        var is_volatile = false
        while self.at_keyword("const") or self.at_keyword("volatile"):
            if self.take_keyword("const"): is_const = true
            elif self.take_keyword("volatile"): is_volatile = true
        var value = try self.parse_primary_type()
        # `?` may follow any `*`: `Link*?*` is a pointer to a nullable pointer.
        # The Base lexer reads `*?` as one token (the checked multiply), so a
        # nullable pointer arrives as that token here.
        while self.at_symbol("*") or self.at_symbol("*?") or self.is_array_suffix_ahead():
            if self.at_symbol("["):
                # `T[N]` is the fixed array and `T[]` the span (base.md §5.4);
                # a bracket that starts with a type is a generic argument list.
                self.step()
                if self.take_symbol("]"):
                    value = TypeSyntax(form = TypeForm.SpanType(element = value, is_const = is_const), span = self.span_from(start))
                    is_const = false
                    continue
                if not self.at_kind(TokenKind.int_lit): try self.fail(self.current(), "an array length is an integer literal")
                let count = self.advance()
                try self.expect_symbol("]")
                value = TypeSyntax(form = TypeForm.Applied(
                    path = PathSyntax(parts = ["array"], span = start.span),
                    arguments = [TypeArgumentSyntax.TypeArgument(value = value), TypeArgumentSyntax.IntegerArgument(token = count)],
                ), span = self.span_from(start))
                continue
            let nullable = self.at_symbol("*?")
            self.step()
            value = TypeSyntax(form = TypeForm.PointerType(pointee = value, is_const = is_const, is_volatile = is_volatile), span = self.span_from(start))
            is_const = false
            is_volatile = false
            if nullable: value = TypeSyntax(form = TypeForm.OptionalType(value = value), span = self.span_from(start))
        if is_const or is_volatile: try self.fail(start, "`const` and `volatile` qualify a pointee: write `const T*`")
        if self.take_symbol("?"):
            value = TypeSyntax(form = TypeForm.OptionalType(
                value = value
            ), span = self.span_from(start))
        if self.take_symbol("!"):
            value = TypeSyntax(form = TypeForm.FallibleType(
                value = value
            ), span = self.span_from(start))
        return value

    func parse_primary_type() -> TypeSyntax!:
        let start = self.current()
        if self.take_keyword("func"):
            return try self.parse_function_type(start)

        # `cfunc` is C's function-pointer type only when a parameter list
        # follows; a bare `cfunc` stays an ordinary named type.
        let is_c_function = (
            self.current().kind == TokenKind.name
            and self.current().text == "cfunc"
            and self.peek(1).text == "("
        )
        if is_c_function:
            self.step()
            return try self.parse_c_function_type(start)

        if self.take_symbol("("):
            return try self.parse_group_or_tuple_type(start)

        let path = try self.parse_path()
        var arguments = list[TypeArgumentSyntax]()
        # `u8[4]` and `u8[]` are array and span suffixes, not arguments (base.md §5.4).
        if self.at_symbol("[") and not self.is_array_suffix_ahead():
            arguments = try self.parse_type_arguments()
        if len(arguments) == 0:
            return TypeSyntax(form = TypeForm.Named(path = path), span = path.span)
        return TypeSyntax(form = TypeForm.Applied(
            path = path,
            arguments = arguments
        ), span = self.span_from(start))

    func parse_function_type(start: Token) -> TypeSyntax!:
        let parameters = try self.parse_function_type_parameters()
        try self.expect_symbol("->")
        let result = try self.parse_type()
        return TypeSyntax(form = TypeForm.FunctionType(
            parameters = parameters,
            result = result
        ), span = self.span_from(start))

    func parse_c_function_type(start: Token) -> TypeSyntax!:
        let parameters = try self.parse_function_type_parameters()
        # A disposer is conventionally written `cfunc(foreign)`; omission of
        # the result is the exact `unit` form, matching function declarations.
        var result = TypeSyntax(
            form = TypeForm.Named(path = PathSyntax(parts = ["unit"], span = start.span)),
            span = start.span,
        )
        if self.take_symbol("->"): result = try self.parse_type()
        return TypeSyntax(form = TypeForm.CFunctionType(
            parameters = parameters,
            result = result
        ), span = self.span_from(start))

    func parse_function_type_parameters() -> list[TypeSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[TypeSyntax]()
        if not self.at_symbol(")"):
            while true:
                parameters.append(try self.parse_type())
                if not self.take_symbol(","):
                    break
                if self.at_symbol(")"):
                    break
        try self.expect_symbol(")")
        return parameters

    # Parentheses group one type; a comma changes the same opening into a tuple.
    # Examples: `(func() -> unit)?` is optional function, while `(i64, str)` is a tuple.
    func parse_group_or_tuple_type(start: Token) -> TypeSyntax!:
        let first = try self.parse_type()
        if not self.take_symbol(","):
            try self.expect_symbol(")")
            return TypeSyntax(form = TypeForm.GroupedType(
                value = first
            ), span = self.span_from(start))

        let elements = list[TypeSyntax]()
        elements.append(first)
        if self.at_symbol(")"):
            try self.fail(self.current(), "a tuple type requires at least two elements")
        elements.append(try self.parse_type())
        while self.take_symbol(","):
            if self.at_symbol(")"):
                break
            elements.append(try self.parse_type())
        try self.expect_symbol(")")
        return TypeSyntax(form = TypeForm.TupleType(
            elements = elements
        ), span = self.span_from(start))

    # mark: Expression precedence ================================================================
    #
    # Each layer below parses its own operators and calls the next tighter
    # layer for operands, loosest first:
    #
    #   catch          `value catch failure: ...`      parse_expression
    #   else           `optional else fallback`        parse_else_expression
    #   if/else        `a if condition else b`         parse_conditional_expression
    #   binary         `or` ... `*` by section 28.4    parse_binary_expression
    #   unary          `not`, `-`, `+`, `~`, `try`     parse_unary_expression
    #   postfix        `.member`, `(args)`, `[index]`  parse_postfix_expression
    #
    # Primary expressions (literals, names, groups, lambdas) follow in the
    # next mark.

    func parse_expression() -> ExpressionSyntax!:
        self.nesting += 1
        if self.nesting > max_nesting:
            try self.fail(self.current(), "expression nests deeper than " + str(max_nesting))
        let value = try self.parse_nested_expression()
        self.nesting -= 1
        return value

    func parse_nested_expression() -> ExpressionSyntax!:
        let start = self.current()
        let value = try self.parse_else_expression()
        if self.expression_has_ended():
            return value
        if not self.take_keyword("catch"):
            return value

        let failure_name = (try self.expect_name("catch binding")).text
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return ExpressionSyntax(form = ExpressionForm.CatchValue(
            value = value,
            failure_name = failure_name,
            body = body
        ), span = self.span_from(start))

    # `a else b` yields the optional when present and evaluates the arm
    # otherwise; a diverging `trap(...)`/`error(...)` arm is an ordinary call
    # here. The form binds looser than the conditional expression — whose own
    # `else` is a grammar delimiter, not this operator — and tighter than
    # `catch`, so chains associate to the right.
    func parse_else_expression() -> ExpressionSyntax!:
        let start = self.current()
        let value = try self.parse_conditional_expression()
        if self.expression_has_ended():
            return value
        if not self.take_keyword("else"):
            return value
        let arm = try self.parse_else_expression()
        return ExpressionSyntax(form = ExpressionForm.ElseValue(
            value = value,
            arm = arm
        ), span = self.span_from(start))

    func parse_conditional_expression() -> ExpressionSyntax!:
        let start = self.current()
        let value = try self.parse_binary_expression(1)
        if self.expression_has_ended():
            return value
        if not self.take_keyword("if"):
            return value
        let condition = try self.parse_binary_expression(1)
        try self.expect_keyword("else")
        let alternative = try self.parse_conditional_expression()
        return ExpressionSyntax(form = ExpressionForm.Conditional(
            value = value,
            condition = condition,
            alternative = alternative
        ), span = self.span_from(start))

    func parse_binary_expression(minimum_precedence: i64) -> ExpressionSyntax!:
        let start = self.current()
        var left = try self.parse_unary_expression()
        # Comparisons and ranges do not chain: `a < b < c` and `a..b..c` are
        # errors rather than Python-style chains, so one of each per level.
        var used_comparison = false
        var used_range = false

        while true:
            if self.expression_has_ended():
                break
            let operator = self.current_binary_operator()
            let precedence = precedence_of(operator)
            if precedence < minimum_precedence:
                break
            if precedence == comparison_precedence and used_comparison:
                try self.fail(self.current(), "comparison operators cannot be chained")
            if precedence == comparison_precedence and is_ungrouped_logical_not(left):
                try self.fail(
                    self.current(),
                    "ambiguous `not` before comparison; write `not (a == b)` or `(not a) == b`",
                )
            if precedence == range_precedence and used_range:
                try self.fail(self.current(), "range operators cannot be chained")
            if precedence == comparison_precedence:
                used_comparison = true
            if precedence == range_precedence:
                used_range = true

            self.step()
            if operator == "is not":
                self.step()
            let right = try self.parse_binary_expression(precedence + 1)
            left = ExpressionSyntax(form = ExpressionForm.Binary(
                left = left,
                operator = operator,
                right = right
            ), span = self.span_from(start))
        return left

    func parse_unary_expression() -> ExpressionSyntax!:
        let start = self.current()
        let has_unary_operator = (
            self.at_keyword("try")
            or self.at_keyword("not")
            or self.at_symbol("+")
            or self.at_symbol("-")
            or self.at_symbol("-%")
            or self.at_symbol("~")
            or self.at_symbol("&")
            or self.at_symbol("*")
        )
        if has_unary_operator:
            let operator = self.advance().text
            let operand = try self.parse_unary_expression()
            return ExpressionSyntax(form = ExpressionForm.Unary(
                operator = operator,
                operand = operand
            ), span = self.span_from(start))
        return try self.parse_postfix_expression()

    func parse_postfix_expression() -> ExpressionSyntax!:
        let start = self.current()
        var value = try self.parse_primary_expression()
        while true:
            if self.expression_has_ended():
                break
            elif self.take_symbol("."):
                let name = (try self.expect_name("member name")).text
                value = ExpressionSyntax(form = ExpressionForm.Member(
                    value = value,
                    name = name
                ), span = self.span_from(start))
            elif self.at_symbol("("):
                let arguments = try self.parse_arguments()
                value = ExpressionSyntax(form = ExpressionForm.Call(
                    callee = value,
                    type_arguments = list[TypeArgumentSyntax](),
                    arguments = arguments
                ), span = self.span_from(start))
            elif self.at_symbol("[") and self.is_generic_call_ahead():
                let type_arguments = try self.parse_type_arguments()
                let arguments = try self.parse_arguments()
                value = ExpressionSyntax(form = ExpressionForm.Call(
                    callee = value,
                    type_arguments = type_arguments,
                    arguments = arguments
                ), span = self.span_from(start))
            elif self.profile == Profile.base and self.at_symbol("[") and self.peek(1).text == "]" and self.peek(2).text == "(":
                # `u8[](pointer, count)`: the name before `[]` is the element type.
                let element = try self.expression_as_type(value)
                self.step()
                self.step()
                let arguments = try self.parse_arguments()
                value = ExpressionSyntax(form = ExpressionForm.SpanConstruct(element = element, arguments = arguments), span = self.span_from(start))
            elif self.take_symbol("["):
                value = try self.parse_subscript(value, start)
            else:
                break
        return value

    # A `Name` or `module.Name` expression read as the type path it spells.
    func expression_as_type(value: ExpressionSyntax) -> TypeSyntax!:
        match value.form:
            Name(name): return TypeSyntax(form = TypeForm.Named(path = PathSyntax(parts = [name], span = value.span)), span = value.span)
            Member(owner, name):
                match owner.form:
                    Name(owner_name): return TypeSyntax(form = TypeForm.Named(path = PathSyntax(parts = [owner_name, name], span = value.span)), span = value.span)
                    else: pass
            else: pass
        error(self.diagnostic(self.current(), "a span constructor names its element type: `u8[](pointer, count)`"))

    # mark: Primary expressions =================================================================

    func parse_primary_expression() -> ExpressionSyntax!:
        let start = self.current()
        if self.is_literal(self.current()):
            let token = self.advance()
            return ExpressionSyntax(form = ExpressionForm.Literal(token = token), span = token.span)
        if self.at_kind(TokenKind.format_start):
            return try self.parse_formatted_string()
        if self.at_kind(TokenKind.name):
            let name = self.advance().text
            return ExpressionSyntax(form = ExpressionForm.Name(value = name), span = self.span_from(start))
        if self.take_keyword("self"):
            return ExpressionSyntax(form = ExpressionForm.Name(value = "self"), span = self.span_from(start))
        if self.take_symbol("."):
            let name = (try self.expect_case_name()).text
            var arguments = list[ArgumentSyntax]()
            if self.at_symbol("("):
                arguments = try self.parse_arguments()
            return ExpressionSyntax(form = ExpressionForm.CaseValue(
                name = name,
                arguments = arguments
            ), span = self.span_from(start))
        if self.at_symbol("("):
            if self.is_lambda_ahead():
                return try self.parse_lambda_expression()
            return try self.parse_group_or_tuple()
        if self.at_symbol("["):
            return try self.parse_list_expression()
        if self.at_symbol("{"):
            return try self.parse_map_expression()
        if self.take_keyword("func"):
            return try self.parse_closure_expression(start)
        if self.take_keyword("match"):
            return try self.parse_match_expression(start)
        if self.take_keyword("new"):
            return try self.parse_new_expression(start)
        if self.take_keyword("spawn"):
            return try self.parse_spawn_expression(start)
        error(self.diagnostic(self.current(), "expected an expression"))

    # The tokenizer has already split `f"..."` into text and `{`-delimited
    # fields, so each field is parsed as an ordinary expression in place.
    func parse_formatted_string() -> ExpressionSyntax!:
        let start = self.advance()
        let parts = list[FormatPartSyntax]()
        while not self.at_kind(TokenKind.format_end):
            if self.at_kind(TokenKind.format_text):
                parts.append(FormatPartSyntax.Text(token = self.advance()))
            elif self.at_symbol("{"):
                let field_start = self.advance()
                if self.at_symbol("}"):
                    try self.fail(self.current(), "a formatted string field requires an expression")
                let value = try self.parse_expression()
                try self.expect_symbol("}")
                parts.append(FormatPartSyntax.Field(value = value, span = self.span_from(field_start)))
            else:
                try self.fail(self.current(), "expected formatted string text, a field, or the closing quote")
        let end = self.advance()
        return ExpressionSyntax(form = ExpressionForm.FormattedString(
            start = start,
            parts = parts
        ), span = span_between(start, end))

    func parse_group_or_tuple() -> ExpressionSyntax!:
        let start = self.current()
        if self.is_scalar_cast_ahead():
            try self.expect_symbol("(")
            let target = try self.parse_type()
            try self.expect_symbol(")")
            let operand = try self.parse_unary_expression()
            return ExpressionSyntax(form = ExpressionForm.Cast(target = target, value = operand), span = self.span_from(start))
        try self.expect_symbol("(")
        if self.take_symbol(")"):
            return ExpressionSyntax(form = ExpressionForm.TupleValue(
                elements = list[ExpressionSyntax]()
            ), span = self.span_from(start))

        let first = try self.parse_expression()
        if not self.take_symbol(","):
            try self.expect_symbol(")")
            return ExpressionSyntax(form = ExpressionForm.Group(value = first), span = self.span_from(start))

        let elements = list[ExpressionSyntax]()
        elements.append(first)
        if self.at_symbol(")"):
            try self.fail(self.current(), "a tuple requires at least two elements")
        while true:
            elements.append(try self.parse_expression())
            if not self.take_symbol(","):
                break
            if self.at_symbol(")"):
                break
        try self.expect_symbol(")")
        return ExpressionSyntax(form = ExpressionForm.TupleValue(
            elements = elements
        ), span = self.span_from(start))

    func parse_lambda_expression() -> ExpressionSyntax!:
        let start = self.current()
        let parameters = try self.parse_lambda_parameters()
        try self.expect_symbol("=>")
        let body = try self.parse_expression()
        return ExpressionSyntax(form = ExpressionForm.Lambda(
            parameters = parameters,
            body = body
        ), span = self.span_from(start))

    func parse_lambda_parameters() -> list[ParameterSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[ParameterSyntax]()
        if not self.at_symbol(")"):
            while true:
                parameters.append(try self.parse_lambda_parameter())
                if not self.take_symbol(","):
                    break
                if self.at_symbol(")"):
                    break
        try self.expect_symbol(")")
        return parameters

    func parse_lambda_parameter() -> ParameterSyntax!:
        let start = self.current()
        let name = (try self.expect_name("lambda parameter")).text
        var annotation: TypeSyntax? = none
        if self.take_symbol(":"):
            annotation = try self.parse_type()
        return ParameterSyntax(
            name = name,
            annotation = annotation,
            default_value = none,
            span = self.span_from(start),
        )

    func parse_list_expression() -> ExpressionSyntax!:
        let start = self.current()
        try self.expect_symbol("[")
        let elements = list[ExpressionSyntax]()
        if not self.at_symbol("]"):
            while true:
                elements.append(try self.parse_expression())
                if not self.take_symbol(","):
                    break
                if self.at_symbol("]"):
                    break
        try self.expect_symbol("]")
        return ExpressionSyntax(form = ExpressionForm.ListValue(
            elements = elements
        ), span = self.span_from(start))

    func parse_map_expression() -> ExpressionSyntax!:
        let start = self.current()
        try self.expect_symbol("{")
        if self.at_symbol("}"):
            try self.fail(self.current(), "an empty map uses `map[K, V]()`")
        let entries = list[MapEntrySyntax]()
        while true:
            let entry_start = self.current()
            let key = try self.parse_expression()
            try self.expect_symbol(":")
            let value = try self.parse_expression()
            entries.append(MapEntrySyntax(
                key = key,
                value = value,
                span = self.span_from(entry_start),
            ))
            if not self.take_symbol(","):
                break
            if self.at_symbol("}"):
                break
        try self.expect_symbol("}")
        return ExpressionSyntax(form = ExpressionForm.MapValue(
            entries = entries
        ), span = self.span_from(start))

    func parse_closure_expression(start: Token) -> ExpressionSyntax!:
        let captures = try self.parse_captures()
        let parameters = try self.parse_parameters(false)
        let result = try self.parse_result_type()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return ExpressionSyntax(form = ExpressionForm.Closure(
            captures = captures,
            parameters = parameters,
            result = result,
            body = body
        ), span = self.span_from(start))

    func parse_captures() -> list[CaptureSyntax]!:
        let captures = list[CaptureSyntax]()
        if not self.take_symbol("["):
            return captures
        if self.at_symbol("]"):
            try self.fail(self.current(), "capture list cannot be empty")

        while true:
            captures.append(try self.parse_capture())
            if not self.take_symbol(","):
                break
            if self.at_symbol("]"):
                break
        try self.expect_symbol("]")
        return captures

    func parse_capture() -> CaptureSyntax!:
        let start = self.current()
        let is_weak = self.take_keyword("weak")
        if not is_weak:
            let modifier = try self.expect_name("`copy` or `weak` capture")
            if modifier.text != "copy":
                try self.fail(modifier, "expected `copy` or `weak` capture")

        var name = ""
        if is_weak and self.take_keyword("self"):
            name = "self"
        else:
            name = (try self.expect_name("capture name")).text
        var value: ExpressionSyntax? = none
        if not is_weak:
            try self.expect_symbol("=")
            value = try self.parse_expression()
        return CaptureSyntax(
            name = name,
            value = value,
            is_weak = is_weak,
            span = self.span_from(start),
        )

    func parse_match_expression(start: Token) -> ExpressionSyntax!:
        if self.in_inline_suite:
            try self.fail(start, "a same-line suite cannot contain a match expression")
        let subject = try self.parse_expression()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before match arms")
        try self.expect_kind(TokenKind.indent, "indented match arms")
        let arms = list[MatchValueArmSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let arm_start = self.current()
            let patterns = try self.parse_match_patterns()
            try self.expect_symbol("=>")
            let value = try self.parse_expression()
            try self.expect_statement_end()
            arms.append(MatchValueArmSyntax(
                patterns = patterns,
                value = value,
                span = self.span_from(arm_start),
            ))
        if len(arms) == 0:
            try self.fail(self.current(), "a match must contain at least one arm")
        try self.expect_kind(TokenKind.dedent, "end of match arms")
        return ExpressionSyntax(form = ExpressionForm.MatchValue(
            subject = subject,
            arms = arms
        ), span = self.span_from(start))

    func parse_new_expression(start: Token) -> ExpressionSyntax!:
        let value_type = try self.parse_type()
        let arguments = try self.parse_arguments()
        return ExpressionSyntax(form = ExpressionForm.NewValue(
            value_type = value_type,
            arguments = arguments
        ), span = self.span_from(start))

    func parse_spawn_expression(start: Token) -> ExpressionSyntax!:
        let function = try self.parse_path()
        let arguments = try self.parse_arguments()
        return ExpressionSyntax(form = ExpressionForm.SpawnValue(
            function = function,
            arguments = arguments
        ), span = self.span_from(start))

    # mark: Arguments and subscripts =============================================================

    func parse_arguments() -> list[ArgumentSyntax]!:
        try self.expect_symbol("(")
        let arguments = list[ArgumentSyntax]()
        if not self.at_symbol(")"):
            while true:
                arguments.append(try self.parse_argument())
                if not self.take_symbol(","):
                    break
                if self.at_symbol(")"):
                    break
        try self.expect_symbol(")")
        return arguments

    func parse_argument() -> ArgumentSyntax!:
        let start = self.current()
        var label: str? = none
        # `name = value` (spec §8.2). The separator is `=` and not `:` because
        # `:` already means "has this type"; `==` tokenizes whole, so an
        # equality test in argument position is never mistaken for a label.
        if self.at_kind(TokenKind.name) and self.peek(1).text == "=":
            label = self.advance().text
            try self.expect_symbol("=")
        let value = try self.parse_expression()
        return ArgumentSyntax(
            label = label,
            value = value,
            span = self.span_from(start),
        )

    func parse_type_arguments() -> list[TypeArgumentSyntax]!:
        try self.expect_symbol("[")
        let arguments = list[TypeArgumentSyntax]()
        if self.at_symbol("]"):
            try self.fail(self.current(), "type argument list cannot be empty")
        while true:
            if self.at_kind(TokenKind.int_lit):
                arguments.append(TypeArgumentSyntax.IntegerArgument(token = self.advance()))
            else:
                arguments.append(TypeArgumentSyntax.TypeArgument(value = try self.parse_type()))
            if not self.take_symbol(","):
                break
            if self.at_symbol("]"):
                break
        try self.expect_symbol("]")
        return arguments

    # `xs[a..<b]` collides with the range operators: parsed naively, the
    # subscript expression would swallow `..<` as binary range syntax and the
    # slice form would never be seen. So the bracket's tokens are scanned
    # first — a slice operator at depth one splits the subscript into two
    # bounded expression parses, while anything else, including a
    # parenthesized `(a..<b)` range value, stays an ordinary index.
    #
    # Only `..<` and `..` are slice operators (`find_slice_operator`). `..=`
    # is range-only, so `xs[a..=b]` is an ordinary index by a range value —
    # a deliberate grammar decision, not an oversight.
    func parse_subscript(value: ExpressionSyntax, start: Token) -> ExpressionSyntax!:
        let opening_index = self.position - 1
        let closing_index = self.find_matching_symbol(opening_index, "[", "]")
        let separator_index = self.find_slice_operator(opening_index, closing_index)
        if separator_index < 0:
            let subscript = try self.parse_expression()
            try self.expect_symbol("]")
            return ExpressionSyntax(form = ExpressionForm.Index(
                value = value,
                subscript = subscript
            ), span = self.span_from(start))

        let previous_limit = self.expression_limit
        var slice_start: ExpressionSyntax? = none
        if self.position < separator_index:
            self.expression_limit = separator_index
            slice_start = try self.parse_expression()
        self.expression_limit = previous_limit
        if self.position != separator_index:
            try self.fail(self.current(), "expected a slice operator")

        let operator = self.advance().text
        if slice_start == none and self.position == closing_index:
            try self.fail(self.previous(), "a slice requires at least one bound")
        var slice_end: ExpressionSyntax? = none
        if self.position < closing_index:
            if operator == "..":
                try self.fail(self.current(), "an inclusive slice ends at `..`")
            self.expression_limit = closing_index
            slice_end = try self.parse_expression()
        self.expression_limit = previous_limit

        if operator == ".." and slice_start == none:
            try self.fail(self.previous(), "an inclusive slice requires a start")
        try self.expect_symbol("]")
        return ExpressionSyntax(form = ExpressionForm.Slice(
            value = value,
            start = slice_start,
            operator = operator,
            end = slice_end
        ), span = self.span_from(start))

    # mark: Token stream and diagnostics =========================================================
    #
    # Three verbs recur throughout the class: `at_*` peeks without moving,
    # `take_*` consumes the token only when it matches and reports whether it
    # did, and `expect_*` consumes or fails with a diagnostic.

    func current() -> Token:
        return self.token_at(self.position)

    func previous() -> Token:
        return self.token_at(max(self.position - 1, 0))

    func peek(offset: i64) -> Token:
        return self.token_at(self.position + offset)

    func token_at(index: i64) -> Token:
        if index >= len(self.tokens):
            return self.tokens[len(self.tokens) - 1]
        return self.tokens[index]

    # Two ways past a token. `advance` answers the one it moved past, for the
    # callers that want its text or span; `step` only moves, for the callers
    # that have already checked what is there and want the position to change.
    # Keeping them apart is what lets a dropped `advance` mean something.
    func advance() -> Token:
        let token = self.current()
        self.step()
        return token

    func step():
        if self.current().kind != TokenKind.eof:
            self.position += 1

    func at_kind(kind: TokenKind) -> bool:
        return self.current().kind == kind

    func take_kind(kind: TokenKind) -> bool:
        if not self.at_kind(kind):
            return false
        self.step()
        return true

    func expect_kind(kind: TokenKind, expected: str) -> !:
        if not self.at_kind(kind):
            try self.fail(self.current(), "expected " + expected)
        self.step()

    func at_keyword(keyword: str) -> bool:
        let token = self.current()
        return token.kind == TokenKind.keyword and token.text == keyword

    func take_keyword(keyword: str) -> bool:
        if not self.at_keyword(keyword):
            return false
        self.step()
        return true

    func expect_keyword(keyword: str) -> !:
        if not self.at_keyword(keyword):
            try self.fail(self.current(), "expected `" + keyword + "`")
        self.step()

    # Contextual words (`blocking`, section 28.5) are ordinary names outside
    # the one position that gives them meaning, so they are matched as names.
    func take_contextual(word: str) -> bool:
        let token = self.current()
        if token.kind != TokenKind.name or token.text != word:
            return false
        self.step()
        return true

    func at_symbol(symbol: str) -> bool:
        let token = self.current()
        return token.kind == TokenKind.symbol and token.text == symbol

    func take_symbol(symbol: str) -> bool:
        if not self.at_symbol(symbol):
            return false
        self.step()
        return true

    func expect_symbol(symbol: str) -> !:
        if not self.at_symbol(symbol):
            try self.fail(self.current(), "expected `" + symbol + "`")
        self.step()

    func expect_name(expected: str) -> Token!:
        if not self.at_kind(TokenKind.name):
            try self.fail(self.current(), "expected " + expected)
        return self.advance()

    # `none` is reserved, yet `.none` names the optional's absent case
    # (section 13.1), so a case name after `.` accepts it beside ordinary names.
    func expect_case_name() -> Token!:
        if self.at_keyword("none"):
            return self.advance()
        return try self.expect_name("case name")

    # A block-valued expression consumes the newline or dedent belonging to its
    # own suite. A same-line suite written inside delimiters, as in
    # `run(func (): return 1)`, ends where its delimiter closes. Every other
    # simple statement must consume one NEWLINE here.
    func expect_statement_end() -> !:
        let previous_kind = self.previous().kind
        if previous_kind == TokenKind.newline or previous_kind == TokenKind.dedent:
            return
        if self.in_inline_suite and self.at_closing_delimiter():
            return
        try self.expect_kind(TokenKind.newline, "newline after statement")

    func at_closing_delimiter() -> bool:
        return self.at_symbol(")") or self.at_symbol("]") or self.at_symbol("}")

    # An expression ends when a nested suite has already consumed the newline
    # or dedent that closes it (a block closure or `match` written as an
    # argument), or when a bounded slice part reaches its limit. Every
    # precedence layer asks this before looking for another operator.
    func expression_has_ended() -> bool:
        if self.expression_limit >= 0 and self.position == self.expression_limit:
            return true
        let kind = self.previous().kind
        return kind == TokenKind.newline or kind == TokenKind.dedent

    func span_from(start: Token) -> SourceSpan:
        return span_between(start, self.previous())

    func fail(token: Token, message: str) -> !:
        error(self.diagnostic(token, message))

    # Diagnostics carry only line and column; the pipeline prefixes the file
    # path, so a caller always reads `path:line:column: message`.
    func diagnostic(token: Token, message: str) -> str:
        return format_location(i64(token.span.line), i64(token.span.column)) + message

    # mark: Expression lookahead ================================================================

    func is_literal(token: Token) -> bool:
        if token.kind == TokenKind.int_lit or token.kind == TokenKind.float_lit:
            return true
        if token.kind == TokenKind.str_lit or token.kind == TokenKind.byte_lit:
            return true
        if token.kind == TokenKind.char_lit:
            return true
        let is_literal_keyword = (
            token.text == "true"
            or token.text == "false"
            or token.text == "none"
        )
        return token.kind == TokenKind.keyword and is_literal_keyword

    func is_assignment_target(value: ExpressionSyntax) -> bool:
        match value.form:
            Name(name): return true
            Member(target, name): return self.is_assignment_target(target)
            Index(target, subscript): return self.is_assignment_target(target)
            # `*p = v` and `(*p).field = v` store through a Base pointer (base.md §7.7).
            Unary(operator, operand): return operator == "*"
            Group(grouped): return self.is_assignment_target(grouped)
            else: return false

    func current_binary_operator() -> str:
        let token = self.current()
        if token.kind == TokenKind.keyword:
            if token.text == "is" and self.peek(1).text == "not":
                return "is not"
            if token.text == "is" or token.text == "and" or token.text == "or":
                return token.text
            return ""
        if token.kind != TokenKind.symbol:
            return ""
        if precedence_of(token.text) > 0:
            return token.text
        return ""

    # `(` opens a lambda when its matching `)` is followed by `=>`; the real
    # parameter parser reports any malformed contents.
    # `[` after a complete type opens an array or span suffix when it is
    # empty or holds a length, never when it starts a type (base.md §5.4).
    func is_array_suffix_ahead() -> bool:
        if self.profile != Profile.base or not self.at_symbol("["): return false
        let closing = self.find_matching_symbol(self.position, "[", "]")
        if closing < 0: return false
        if closing == self.position + 1: return true
        return self.token_at(self.position + 1).kind == TokenKind.int_lit and closing == self.position + 2

    # `(u8)value`: a scalar type name alone in parentheses, followed by
    # something an operand can start with (base.md §7.5). `(Name)(x)` with a
    # struct name stays a call, and `(value)` stays a group.
    func is_scalar_cast_ahead() -> bool:
        if self.profile != Profile.base: return false
        var index = self.position + 1
        while self.token_at(index).kind == TokenKind.keyword and (self.token_at(index).text == "const" or self.token_at(index).text == "volatile"):
            index += 1
        let name = self.token_at(index)
        if name.kind != TokenKind.name: return false
        index += 1
        # A pointer type ends in `*` (or the `*?` token) and may name any
        # type; without one, only a scalar name reads as a cast.
        var stars = 0
        while self.token_at(index).kind == TokenKind.symbol and (self.token_at(index).text == "*" or self.token_at(index).text == "*?"):
            stars += 1
            index += 1
        if stars == 0 and not is_scalar_type_name(name.text): return false
        if stars > 0 and index > self.position + 2 and self.token_at(index).text != ")": return false
        if self.token_at(index).text != ")": return false
        let operand = self.token_at(index + 1)
        if operand.kind == TokenKind.name or operand.kind == TokenKind.int_lit or operand.kind == TokenKind.float_lit or operand.kind == TokenKind.char_lit:
            return true
        return operand.kind == TokenKind.symbol and (operand.text == "(" or operand.text == "-" or operand.text == "-%" or operand.text == "~")

    func is_lambda_ahead() -> bool:
        let closing_index = self.find_matching_symbol(self.position, "(", ")")
        return closing_index >= 0 and self.token_at(closing_index + 1).text == "=>"

    # Generic-call brackets must close immediately before `(` and begin with a
    # syntactically recognizable type. An integer first item means indexing:
    # `values[0](argument)`, while `array[T, 4]` retains its later length item.
    func is_generic_call_ahead() -> bool:
        let closing_index = self.find_matching_symbol(self.position, "[", "]")
        if closing_index < 0 or self.token_at(closing_index + 1).text != "(":
            return false
        return self.looks_like_type_start(self.position + 1, closing_index)

    # The only place letter case carries meaning in the parser: after a core
    # type name, `func`, or `(`, a generic argument must start with a
    # capitalized (possibly dotted) type name, as section 3 requires of
    # types. Anything else means `foo[0](...)` is an index, then a call.
    func looks_like_type_start(index: i64, limit: i64) -> bool:
        if index >= limit:
            return false
        let token = self.token_at(index)
        if token.kind == TokenKind.keyword and token.text == "func":
            return true
        if token.kind == TokenKind.symbol and token.text == "(":
            return true
        if token.kind != TokenKind.name:
            return false
        if is_core_type_name(token.text) or strings.is_upper(token.text[0]):
            return true

        var last_part_index = index
        while last_part_index + 2 < limit and self.token_at(last_part_index + 1).text == ".":
            if self.token_at(last_part_index + 2).kind != TokenKind.name:
                return false
            last_part_index += 2
        return last_part_index > index and strings.is_upper(self.token_at(last_part_index).text[0])

    # The index of the bracket closing the one at `start`, or -1. `opening`
    # names the bracket the caller believes is there, so a caller that has
    # mis-stepped gets -1 rather than another pair's match.
    func find_matching_symbol(start: i64, opening: str, closing: str) -> i64:
        if start < 0 or start >= len(self.tokens): return -1
        if self.token_at(start).text != opening: return -1
        return self.matching[start]

    func find_slice_operator(opening_index: i64, closing_index: i64) -> i64:
        var depth = 0
        var operator_index = -1
        var index = opening_index
        while index < closing_index:
            let text = self.token_at(index).text
            if text == "(" or text == "[" or text == "{":
                depth += 1
            elif text == ")" or text == "]" or text == "}":
                depth -= 1
            elif depth == 1 and (text == "..<" or text == ".."):
                if operator_index >= 0:
                    return -2
                operator_index = index
            index += 1
        return operator_index


# mark: Parser tables ==========================================================================

let comparison_precedence = 3
let range_precedence = 4

func span_between(start: Token, end: Token) -> SourceSpan:
    return SourceSpan(
        start = start.span.start,
        end = end.span.end,
        line = start.span.line,
        column = start.span.column,
    )

# Recognize only a direct `not value`; parentheses hide it so
# `(not value) == other` remains an unambiguous comparison.
func is_ungrouped_logical_not(value: ExpressionSyntax) -> bool:
    match value.form:
        Unary(operator, operand): return operator == "not"
        else: return false

# The binary operator table of section 28.4, loosest first.
func precedence_of(operator: str) -> i64:
    return match operator:
        "or" => 1
        "and" => 2
        "==", "!=", "<", "<=", ">", ">=", "is", "is not" => comparison_precedence
        "..<", "..=" => range_precedence
        "|" => 5
        "^" => 6
        "&" => 7
        "<<", ">>" => 8
        "+", "-" => 9
        "*", "/", "//", "%" => 10
        # Luce Base's wrapping, saturating, and checked forms sit with their
        # checked spelling (base.md §7.2); the lexer admits them only in Base.
        "+%", "-%", "+|", "-|", "+?", "-?" => 9
        "*%", "*|", "*?" => 10
        else => 0

func is_assignment_operator(operator: str) -> bool:
    return match operator:
        "=", "+=", "-=", "*=", "/=", "//=", "%=" => true
        "&=", "|=", "^=", "<<=", ">>=" => true
        "+%=", "-%=", "*%=", "+|=", "-|=", "*|=" => true
        else => false

# An integer-shaped extern handle states its exact C width (section 21.16);
# the four widths C traffics handles in are the whole vocabulary.
func is_extern_handle_width(name: str) -> bool:
    return match name:
        "u32", "i32", "u64", "i64" => true
        else => false

func is_fallible_type(value: TypeSyntax) -> bool:
    match value.form:
        FallibleType(inner): return true
        else: return false
