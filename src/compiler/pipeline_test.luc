from compiler.backend import ExecutionBackend
from compiler.pipeline import run_with
from compiler.typed_ir import TypedProgram, Value

class ModuleCountBackend: ExecutionBackend:
    init():
        return

    func run(program: TypedProgram, module_name: str, function_name: str) -> Value!:
        return Value.Integer(value = len(program.modules))

func test_pipeline_accepts_an_execution_backend():
    let value = run_with(
        ModuleCountBackend(),
        ["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"],
        "main",
        "answer",
    ) catch reason:
        trap(reason)
    match value:
        Integer(module_count): assert(module_count == 2)
        else: assert(false)
