#==============================================================================================
#
#   executable - Process-entry convention for native artifacts
#
#   DESCRIPTION:
#       Native backends share one entry rule: a process starts at one public
#       `main` that returns `i32`. Wasm does not use this — it exports every
#       public function. The instruction set is the same either way.
#
#       A program may name its entry explicitly (`MirProgram.entry`); when it
#       does not, the one public function whose canonical name ends in
#       `.main` is the entry.
#
#==============================================================================================

from compiler.mir.canonical import BuiltinMirType, MirFunction, MirProgram, builtin_mir_type
import std.strings

## Process executables start at one public `main` returning `i32`.
pub func find_executable_entry(program: MirProgram) -> MirFunction!:
    var entry_index = -1
    let explicit = program.entry
    if explicit != none:
        if i64(explicit.value) >= len(program.functions):
            error("executable: needs one public `main`")
        entry_index = i64(explicit.value)
    else:
        for index in range(0, len(program.functions)):
            let function = program.functions[index]
            if function.is_public and strings.ends_with(function.name, ".main"):
                if entry_index >= 0: error("executable: more than one public `main`")
                entry_index = index
        if entry_index < 0: error("executable: needs one public `main`")

    let entry = program.functions[entry_index]
    if not entry.is_public: error("executable: needs one public `main`")
    let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
    let signature = entry.signature
    if signature.is_fallible or len(signature.results) != 1 or signature.results[0].value != i32_type.value:
        error("executable: `" + entry.name + "` must return `i32`")
    return entry
