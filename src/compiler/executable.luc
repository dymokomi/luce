#==============================================================================================
#
#   executable - Process-entry convention for native artifacts
#
#   DESCRIPTION:
#       Native backends share one entry rule: a process starts at one public
#       `main` that returns `i32`. Wasm does not use this — it exports every
#       public function. The instruction set is the same either way.
#
#==============================================================================================

from compiler.canonical_ir import CanonicalFunction, CanonicalProgram, CanonicalType
import std.strings

## Process executables start at one public `main` returning `i32`.
pub func find_executable_entry(program: CanonicalProgram) -> CanonicalFunction!:
    var entry_index = -1
    for index in range(0, len(program.functions)):
        let function = program.functions[index]
        if function.is_public and strings.ends_with(function.name, ".main"):
            if entry_index >= 0: error("executable has more than one public `main`")
            entry_index = index
    if entry_index < 0: error("executable needs one public `main`")

    let entry = program.functions[entry_index]
    if entry.result != CanonicalType.signed_i32:
        error("executable `" + entry.name + "` must return `i32`")
    return entry
