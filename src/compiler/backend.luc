#==============================================================================================
#
#   backend - The two backend contracts
#
#   DESCRIPTION:
#       The interfaces the pipeline swaps backends through. Backends implement
#       these and never decide language semantics — by the time a program
#       reaches them, every meaning has already been checked and fixed.
#
#       Execution and artifact emission are separate contracts because running
#       a program and producing a file have different inputs, outputs, and
#       failure modes: the interpreter runs typed HIR directly, while compiled
#       backends consume verified, optimized canonical MIR.
#
#       `ArtifactBackend.emit` currently owns the whole target-specific tail:
#
#       canonical MIR -> legalize -> select target instructions -> encode bytes
#
#       Every compiled backend consumes the same canonical instruction set.
#       Container shape (WebAssembly module vs process executable) and host
#       effects (syscall vs imported write) are legalization, not a second IR.
#       When target IR becomes useful, those operations can become separate
#       backend methods and values. Keeping them together today avoids a fake
#       representation while preserving the intended boundary in this contract.
#
#==============================================================================================

from compiler.canonical_ir import CanonicalFunction, CanonicalProgram, CanonicalType
from compiler.hir import Value
from compiler.semantic_analyzer import AnalyzedProgram
import std.strings

## The swappable engine behind `luce run`; it receives semantically analyzed
## typed HIR and returns the selected function's runtime value.
pub interface HirExecutionBackend:
    func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!

## The swappable compiled backend behind `luce build`. It legalizes canonical
## MIR for its target, selects target instructions, and emits artifact bytes;
## the caller owns where those bytes are written or how they are loaded.
pub interface ArtifactBackend:
    func emit(program: CanonicalProgram) -> list[u8]!

## Process executables start at one public `main` returning `i32`. Wasm
## modules do not use this: they export every public function. The
## instruction set is the same either way.
pub func find_executable_entry(program: CanonicalProgram) -> CanonicalFunction!:
    var entry_index = -1
    for index in range(0, len(program.functions)):
        let function = program.functions[index]
        if function.is_public and strings.ends_with(function.name, ".main"):
            if entry_index >= 0: error("executable has more than one public `main`")
            entry_index = index
    if entry_index < 0: error("executable needs one public `main`")

    let entry = program.functions[entry_index]
    if entry.result != CanonicalType.signed_i32:
        error("executable `" + entry.name + "` must return `i32`")
    return entry
