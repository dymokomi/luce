#==============================================================================================
#
#   backend - The swappable HIR execution contract
#
#   DESCRIPTION:
#       The interfaces the pipeline swaps backends through. Backends implement
#       these and never decide language semantics — by the time a program
#       reaches them, every meaning has already been checked and fixed.
#
#       The HIR interpreter is genuinely swappable because every execution
#       engine takes analyzed HIR and returns a language value. Compiled
#       backends deliberately have no fake common interface: Wasm returns
#       module bytes, while QBE first returns textual IL and its separate host
#       toolchain installs an executable. Their real shared contract is the
#       verified canonical `MirProgram` they consume.
#
#==============================================================================================

from compiler.hir.ir import Value
from compiler.hir.analyzer import AnalyzedProgram

## The swappable engine behind `luce run`; it receives semantically analyzed
## typed HIR and returns the selected function's runtime value.
pub interface HirExecutionBackend:
    func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!
