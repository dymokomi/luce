from compiler.canonical_ir import CanonicalProgram
from compiler.typed_ir import TypedProgram, Value

# The swappable engine behind `luce run`. Artifact emission is a separate
# backend contract because executing a program and producing a file have
# different outputs and failure modes.
interface ExecutionBackend:
    func run(program: TypedProgram, module_name: str, function_name: str) -> Value!

# Compiled backends consume canonical semantics and return an artifact. The
# caller owns where those bytes are written or how they are loaded.
interface ArtifactBackend:
    func emit(program: CanonicalProgram) -> list[u8]!
