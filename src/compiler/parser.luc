from compiler.tokenizer import Token, TokenKind, SourceSpan
from compiler.syntax import ArgumentSyntax, BindingPatternSyntax, CaptureSyntax
from compiler.syntax import ConditionForm, ConditionSyntax, ConstantSyntax, DeclarationKind, DeclarationSyntax
from compiler.syntax import EnumCaseSyntax, EnumSyntax, ExportEnumCaseSyntax, ExportEnumSyntax, ExportFieldSyntax
from compiler.syntax import ExportStructSyntax, ExpressionForm, ExpressionSyntax, FieldSyntax, FunctionSyntax
from compiler.syntax import GenericParameterSyntax, IfBranchSyntax, ImportedNameSyntax, ImportSyntax, InterfaceSyntax
from compiler.syntax import MapEntrySyntax, MatchStatementArmSyntax, MatchValueArmSyntax
from compiler.syntax import ModuleSyntax, NamedTypeSyntax, NominalTypeKind, NominalTypeSyntax
from compiler.syntax import ParameterSyntax, PathSyntax, PatternSyntax, StatementForm, StatementSyntax
from compiler.syntax import SuiteStyle, SuiteSyntax, TestSyntax, TypeAliasSyntax
from compiler.syntax import TypeArgumentSyntax, TypeForm, TypeMemberKind, TypeMemberSyntax, TypeSyntax
import std.strings

enum FunctionForm:
    definition
    signature

# Parses one complete token stream into an epoch-1 source tree. Cursor movement,
# precedence, and diagnostics remain private; stage order belongs to the pipeline.
pub class Parser:
    tokens: list[Token]
    position: i64
    # True while parsing `if ready: return value` — the one-statement suite
    # form, which cannot nest another suite.
    in_inline_suite: bool
    # Token index a bounded slice-part parse must stop at; -1 when unbounded.
    expression_limit: i64

    pub init(tokens: list[Token]):
        self.tokens = tokens
        self.position = 0
        self.in_inline_suite = false
        self.expression_limit = -1

    # mark: Module and declarations -----------------------------------------

    pub func parse() -> ModuleSyntax!:
        let first = self.current()
        let imports = list[ImportSyntax]()
        let declarations = list[DeclarationSyntax]()

        while self.at_keyword("import") or self.at_keyword("from"):
            imports.append(try self.parse_import())
        while not self.at_kind(TokenKind.eof):
            declarations.append(try self.parse_declaration())

        let end = try self.expect_kind(TokenKind.eof, "end of file")
        return ModuleSyntax(tokens = self.tokens, imports = imports, declarations = declarations, span = span_between(first, end))

    func parse_import() -> ImportSyntax!:
        let start = self.current()
        let names = list[ImportedNameSyntax]()
        var alias_name: str? = none
        let is_selective = self.take_keyword("from")

        if not is_selective: try self.expect_keyword("import")
        let path = try self.parse_path()
        if is_selective:
            try self.expect_keyword("import")
            while true:
                let name = try self.expect_name("imported name")
                names.append(ImportedNameSyntax(name = name.text, span = name.span))
                if not self.take_symbol(","): break
        elif self.take_keyword("as"):
            alias_name = (try self.expect_name("import alias")).text

        let end = try self.expect_kind(TokenKind.newline, "newline after import")
        return ImportSyntax(path = path, names = names, alias_name = alias_name, span = span_between(start, end))

    func parse_declaration() -> DeclarationSyntax!:
        let documentation = try self.parse_documentation()
        let start = self.current()
        let is_public = self.take_keyword("pub")

        if self.take_keyword("let"):
            let value = try self.parse_constant()
            return self.declaration(start, documentation, is_public, DeclarationKind.Constant(value = value))

        if self.take_keyword("type"):
            let value = try self.parse_type_alias()
            return self.declaration(start, documentation, is_public, DeclarationKind.TypeAlias(value = value))

        var is_mutating = false
        if self.take_keyword("mutating"):
            is_mutating = true
        if self.take_keyword("func"):
            let value = try self.parse_function(start, is_mutating, FunctionForm.definition)
            return self.declaration(start, documentation, is_public, DeclarationKind.Function(value = value))
        if is_mutating:
            try self.fail(self.current(), "`mutating` must modify a function declaration")

        if self.take_keyword("struct"):
            let value = try self.parse_nominal_type(NominalTypeKind.struct_type)
            return self.declaration(start, documentation, is_public, DeclarationKind.NominalType(value = value))
        if self.take_keyword("class"):
            let value = try self.parse_nominal_type(NominalTypeKind.class_type)
            return self.declaration(start, documentation, is_public, DeclarationKind.NominalType(value = value))
        if self.take_keyword("enum"):
            let value = try self.parse_enum()
            return self.declaration(start, documentation, is_public, DeclarationKind.Enumeration(value = value))
        if self.take_keyword("interface"):
            let value = try self.parse_interface()
            return self.declaration(start, documentation, is_public, DeclarationKind.InterfaceType(value = value))

        if self.take_keyword("test"):
            if is_public:
                try self.fail(start, "a test declaration cannot use `pub`")
            let value = try self.parse_test()
            return self.declaration(start, documentation, false, DeclarationKind.TestDeclaration(value = value))

        if self.take_keyword("export"):
            if is_public:
                try self.fail(start, "an exported C declaration cannot also use `pub`")
            return try self.parse_export(documentation, start)

        error(self.diagnostic(self.current(), "expected a module declaration"))

    func declaration(start: Token, documentation: list[str], is_public: bool, value: DeclarationKind) -> DeclarationSyntax:
        return DeclarationSyntax(documentation = documentation, is_public = is_public, value = value, span = self.span_from(start))

    func parse_constant() -> ConstantSyntax!:
        let name = (try self.expect_name("constant name")).text
        var annotation: TypeSyntax? = none
        if self.take_symbol(":"):
            annotation = try self.parse_type()
        try self.expect_symbol("=")
        let value = try self.parse_expression()
        try self.expect_statement_end()
        return ConstantSyntax(name = name, annotation = annotation, value = value)

    func parse_type_alias() -> TypeAliasSyntax!:
        let name = (try self.expect_name("type alias name")).text
        try self.expect_symbol("=")
        let value = try self.parse_type()
        try self.expect_kind(TokenKind.newline, "newline after type alias")
        return TypeAliasSyntax(name = name, value = value)

    func parse_function(start: Token, is_mutating: bool, form: FunctionForm) -> FunctionSyntax!:
        let name = (try self.expect_name("function name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let parameters = try self.parse_parameters()
        let result = try self.parse_result_type()
        let effects = try self.parse_effects()
        var body: SuiteSyntax? = none
        if form == FunctionForm.definition:
            try self.expect_symbol(":")
            body = try self.parse_suite()
        else:
            try self.expect_kind(TokenKind.newline, "newline after function signature")
        return FunctionSyntax(is_mutating = is_mutating, name = name, generic_parameters = generic_parameters, parameters = parameters, result = result, effects = effects, body = body, span = self.span_from(start))

    func parse_nominal_type(kind: NominalTypeKind) -> NominalTypeSyntax!:
        let name = (try self.expect_name("type name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let interfaces = try self.parse_implements_clause()
        try self.expect_symbol(":")
        let members = try self.parse_type_members()
        return NominalTypeSyntax(kind = kind, name = name, generic_parameters = generic_parameters, interfaces = interfaces, members = members)

    func parse_type_members() -> list[TypeMemberSyntax]!:
        try self.expect_kind(TokenKind.newline, "newline before type body")
        try self.expect_kind(TokenKind.indent, "indented type body")
        let members = list[TypeMemberSyntax]()
        while not self.at_kind(TokenKind.dedent):
            members.append(try self.parse_type_member(FunctionForm.definition))
        if len(members) == 0:
            try self.fail(self.current(), "a type body cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of type body")
        return members

    func parse_type_member(form: FunctionForm) -> TypeMemberSyntax!:
        let documentation = try self.parse_documentation()
        let start = self.current()
        let is_public = self.take_keyword("pub")
        if form == FunctionForm.signature and is_public:
            try self.fail(start, "interface methods are implicitly public; remove `pub`")
        if form == FunctionForm.signature and (self.at_keyword("weak") or self.at_keyword("let") or self.at_keyword("var")):
            try self.fail(self.current(), "an interface member must be a function signature")
        let is_weak = self.take_keyword("weak")

        if self.at_keyword("let") or self.at_keyword("var"):
            let field = try self.parse_field(is_weak)
            return self.type_member(start, documentation, is_public, TypeMemberKind.Field(value = field))
        if is_weak:
            try self.fail(self.current(), "`weak` must modify a field")

        var is_mutating = false
        if self.take_keyword("mutating"):
            is_mutating = true
        try self.expect_keyword("func")
        let function = try self.parse_function(start, is_mutating, form)
        return self.type_member(start, documentation, is_public, TypeMemberKind.Function(value = function))

    func type_member(start: Token, documentation: list[str], is_public: bool, value: TypeMemberKind) -> TypeMemberSyntax:
        return TypeMemberSyntax(documentation = documentation, is_public = is_public, value = value, span = self.span_from(start))

    func parse_field(is_weak: bool) -> FieldSyntax!:
        let start = self.current()
        let is_mutable = self.take_keyword("var")
        if not is_mutable:
            try self.expect_keyword("let")
        let name = (try self.expect_name("field name")).text
        try self.expect_symbol(":")
        let value_type = try self.parse_type()
        var default_value: ExpressionSyntax? = none
        if self.take_symbol("="):
            default_value = try self.parse_expression()
        try self.expect_statement_end()
        return FieldSyntax(is_weak = is_weak, is_mutable = is_mutable, name = name, value_type = value_type, default_value = default_value, span = self.span_from(start))

    func parse_enum() -> EnumSyntax!:
        let name = (try self.expect_name("enum name")).text
        let generic_parameters = try self.parse_generic_parameters()
        let interfaces = try self.parse_implements_clause()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before enum body")
        try self.expect_kind(TokenKind.indent, "indented enum body")

        let cases = list[EnumCaseSyntax]()
        let methods = list[TypeMemberSyntax]()
        var parsing_methods = false
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            let is_public = self.take_keyword("pub")
            if self.at_keyword("func") or self.at_keyword("mutating"):
                parsing_methods = true
                var is_mutating = false
                if self.take_keyword("mutating"):
                    is_mutating = true
                try self.expect_keyword("func")
                let function = try self.parse_function(start, is_mutating, FunctionForm.definition)
                methods.append(self.type_member(start, documentation, is_public, TypeMemberKind.Function(value = function)))
            else:
                if is_public:
                    try self.fail(start, "enum cases inherit visibility; remove `pub`")
                if parsing_methods:
                    try self.fail(start, "enum cases must precede enum methods")
                cases.append(try self.parse_enum_case(documentation))
        if len(cases) == 0:
            try self.fail(self.current(), "an enum must declare at least one case")
        try self.expect_kind(TokenKind.dedent, "end of enum body")
        return EnumSyntax(name = name, generic_parameters = generic_parameters, interfaces = interfaces, cases = cases, methods = methods)

    func parse_enum_case(documentation: list[str]) -> EnumCaseSyntax!:
        let start = self.current()
        let name = (try self.expect_name("enum case name")).text
        let payload = list[NamedTypeSyntax]()
        if self.take_symbol("("):
            if not self.at_symbol(")"):
                while true:
                    let field_start = self.current()
                    let field_name = (try self.expect_name("payload name")).text
                    try self.expect_symbol(":")
                    let value_type = try self.parse_type()
                    payload.append(NamedTypeSyntax(name = field_name, value_type = value_type, span = self.span_from(field_start)))
                    if not self.take_symbol(","): break
                    if self.at_symbol(")"): break
            try self.expect_symbol(")")
        try self.expect_kind(TokenKind.newline, "newline after enum case")
        return EnumCaseSyntax(documentation = documentation, name = name, payload = payload, span = self.span_from(start))

    func parse_interface() -> InterfaceSyntax!:
        let name = (try self.expect_name("interface name")).text
        let generic_parameters = try self.parse_generic_parameters()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before interface body")
        try self.expect_kind(TokenKind.indent, "indented interface body")
        let methods = list[TypeMemberSyntax]()
        while not self.at_kind(TokenKind.dedent):
            methods.append(try self.parse_type_member(FunctionForm.signature))
        if len(methods) == 0:
            try self.fail(self.current(), "an interface body cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of interface body")
        return InterfaceSyntax(name = name, generic_parameters = generic_parameters, methods = methods)

    func parse_test() -> TestSyntax!:
        let description = try self.expect_kind(TokenKind.str_lit, "test description")
        let effects = try self.parse_effects()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return TestSyntax(description = description, effects = effects, body = body)

    func parse_export(documentation: list[str], start: Token) -> DeclarationSyntax!:
        let c = try self.expect_name("`c` after `export`")
        if c.text != "c": try self.fail(c, "expected `c` after `export`")

        if self.take_keyword("struct"):
            let value = try self.parse_export_struct()
            return self.declaration(start, documentation, false, DeclarationKind.ExportStruct(value = value))
        if self.take_keyword("enum"):
            let value = try self.parse_export_enum()
            return self.declaration(start, documentation, false, DeclarationKind.ExportEnum(value = value))
        if self.take_keyword("func"):
            let value = try self.parse_export_function(start)
            return self.declaration(start, documentation, false, DeclarationKind.ExportFunction(value = value))
        error(self.diagnostic(self.current(), "expected `struct`, `enum`, or `func` after `export c`"))

    func parse_export_function(start: Token) -> FunctionSyntax!:
        let name = (try self.expect_name("exported function name")).text
        let parameters = try self.parse_parameters()
        let result = try self.parse_result_type()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return FunctionSyntax(is_mutating = false, name = name, generic_parameters = list[GenericParameterSyntax](), parameters = parameters, result = result, effects = list[str](), body = body, span = self.span_from(start))

    func parse_export_struct() -> ExportStructSyntax!:
        let name = (try self.expect_name("exported struct name")).text
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before exported struct body")
        try self.expect_kind(TokenKind.indent, "indented exported struct body")
        let fields = list[ExportFieldSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let documentation = try self.parse_documentation()
            let start = self.current()
            try self.expect_keyword("let")
            let name_token = try self.expect_name("exported field name")
            try self.expect_symbol(":")
            let value_type = try self.parse_type()
            try self.expect_kind(TokenKind.newline, "newline after exported field")
            fields.append(ExportFieldSyntax(documentation = documentation, name = name_token.text, value_type = value_type, span = self.span_from(start)))
        if len(fields) == 0: try self.fail(self.current(), "an exported struct cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of exported struct body")
        return ExportStructSyntax(name = name, fields = fields)

    func parse_export_enum() -> ExportEnumSyntax!:
        let name = (try self.expect_name("exported enum name")).text
        try self.expect_keyword("as")
        let representation = (try self.expect_name("exported enum representation")).text
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before exported enum body")
        try self.expect_kind(TokenKind.indent, "indented exported enum body")
        let cases = list[ExportEnumCaseSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let start = self.current()
            let case_name = (try self.expect_name("exported enum case")).text
            try self.expect_symbol("=")
            let value = try self.expect_kind(TokenKind.int_lit, "integer enum value")
            try self.expect_kind(TokenKind.newline, "newline after exported enum case")
            cases.append(ExportEnumCaseSyntax(name = case_name, value = value, span = self.span_from(start)))
        if len(cases) == 0: try self.fail(self.current(), "an exported enum cannot be empty")
        try self.expect_kind(TokenKind.dedent, "end of exported enum body")
        return ExportEnumSyntax(name = name, representation = representation, cases = cases)

    # mark: Declaration details ---------------------------------------------

    func parse_documentation() -> list[str]!:
        let lines = list[str]()
        var previous_line = 0
        while self.at_kind(TokenKind.doc_comment):
            let token = self.advance()
            if previous_line > 0 and token.span.line != previous_line + 1:
                try self.fail(token, "documentation lines must be consecutive")
            var content_start = 2
            if len(token.text) > 2 and token.text[2] == ' ':
                content_start = 3
            lines.append(token.text[content_start:])
            previous_line = token.span.line
        if previous_line > 0 and self.current().span.line != previous_line + 1:
            try self.fail(self.previous(), "documentation must immediately precede a declaration")
        return lines

    func parse_generic_parameters() -> list[GenericParameterSyntax]!:
        let parameters = list[GenericParameterSyntax]()
        if not self.take_symbol("["): return parameters
        if self.at_symbol("]"): try self.fail(self.current(), "generic parameter list cannot be empty")

        while true:
            let start = self.current()
            let name = (try self.expect_name("generic parameter")).text
            let constraints = list[TypeSyntax]()
            if self.take_symbol(":"):
                constraints.append(try self.parse_type())
                while self.take_symbol("&"):
                    constraints.append(try self.parse_type())
            parameters.append(GenericParameterSyntax(name = name, constraints = constraints, span = self.span_from(start)))
            if not self.take_symbol(","): break
            if self.at_symbol("]"): break
        try self.expect_symbol("]")
        return parameters

    func parse_implements_clause() -> list[TypeSyntax]!:
        let interfaces = list[TypeSyntax]()
        if not self.take_keyword("implements"): return interfaces
        interfaces.append(try self.parse_type())
        while self.take_symbol(","):
            interfaces.append(try self.parse_type())
        return interfaces

    func parse_parameters() -> list[ParameterSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[ParameterSyntax]()
        if not self.at_symbol(")"):
            while true:
                let start = self.current()
                var name = ""
                var annotation: TypeSyntax? = none
                var is_self = false
                if self.take_keyword("self"):
                    name = "self"
                    is_self = true
                else:
                    name = (try self.expect_name("parameter name")).text
                    if self.take_symbol(":"):
                        annotation = try self.parse_type()
                    else:
                        try self.fail(self.current(), "parameter requires a type")
                var default_value: ExpressionSyntax? = none
                if self.take_symbol("="):
                    if is_self: try self.fail(self.previous(), "`self` cannot have a default value")
                    default_value = try self.parse_expression()
                parameters.append(ParameterSyntax(name = name, annotation = annotation, default_value = default_value, span = self.span_from(start)))
                if not self.take_symbol(","): break
                if self.at_symbol(")"): break
        try self.expect_symbol(")")
        return parameters

    func parse_effects() -> list[str]!:
        let effects = list[str]()
        if not self.take_keyword("uses"): return effects
        effects.append((try self.expect_name("effect name")).text)
        while self.take_symbol(","):
            effects.append((try self.expect_name("effect name")).text)
        return effects

    func parse_result_type() -> TypeSyntax?!:
        if self.take_symbol("->"): return try self.parse_type()
        return none

    func parse_path() -> PathSyntax!:
        let start = self.current()
        let parts = list[str]()
        parts.append((try self.expect_name("name")).text)
        while self.take_symbol("."):
            parts.append((try self.expect_name("name after `.`")).text)
        return PathSyntax(parts = parts, span = self.span_from(start))

    # mark: Suites and statements -------------------------------------------

    func parse_suite() -> SuiteSyntax!:
        let start = self.current()
        if self.in_inline_suite:
            try self.fail(start, "a same-line suite cannot contain another suite")
        let statements = list[StatementSyntax]()
        if self.take_kind(TokenKind.newline):
            try self.expect_kind(TokenKind.indent, "indented suite")
            while not self.at_kind(TokenKind.dedent):
                if self.at_kind(TokenKind.eof): try self.fail(self.current(), "unterminated suite")
                statements.append(try self.parse_statement())
            if len(statements) == 0: try self.fail(self.current(), "a suite cannot be empty")
            try self.expect_kind(TokenKind.dedent, "end of suite")
            return SuiteSyntax(style = SuiteStyle.indented_suite, statements = statements, span = self.span_from(start))

        self.in_inline_suite = true
        statements.append(try self.parse_simple_statement())
        self.in_inline_suite = false
        return SuiteSyntax(style = SuiteStyle.inline_suite, statements = statements, span = self.span_from(start))

    func parse_statement() -> StatementSyntax!:
        if self.at_kind(TokenKind.doc_comment):
            try self.fail(self.current(), "documentation comments must precede declarations")
        if self.at_keyword("if"): return try self.parse_if_statement()
        if self.at_keyword("while"): return try self.parse_while_statement()
        if self.at_keyword("for"): return try self.parse_for_statement()
        if self.at_keyword("match"): return try self.parse_match_statement()
        return try self.parse_simple_statement()

    func parse_simple_statement() -> StatementSyntax!:
        let start = self.current()
        if self.take_keyword("let") or self.take_keyword("var"):
            return try self.parse_binding_statement(start)
        if self.take_keyword("break"):
            try self.expect_kind(TokenKind.newline, "newline after `break`")
            return StatementSyntax(form = StatementForm.BreakStatement(span = self.span_from(start)))
        if self.take_keyword("continue"):
            try self.expect_kind(TokenKind.newline, "newline after `continue`")
            return StatementSyntax(form = StatementForm.ContinueStatement(span = self.span_from(start)))
        if self.take_keyword("return"):
            var value: ExpressionSyntax? = none
            if not self.at_kind(TokenKind.newline): value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.ReturnStatement(value = value, span = self.span_from(start)))
        if self.take_keyword("defer"):
            let value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.DeferStatement(value = value, span = self.span_from(start)))
        if self.take_keyword("recover"):
            let value = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.RecoverStatement(value = value, span = self.span_from(start)))

        if self.at_keyword("if") or self.at_keyword("while") or self.at_keyword("for") or self.at_keyword("match"):
            try self.fail(self.current(), "a compound statement cannot be used in an inline suite")

        let value = try self.parse_expression()
        if is_assignment_operator(self.current().text):
            if not self.is_assignment_target(value):
                try self.fail(start, "invalid assignment target")
            let operator = self.advance().text
            let assigned = try self.parse_expression()
            try self.expect_statement_end()
            return StatementSyntax(form = StatementForm.Assignment(target = value, operator = operator, value = assigned, span = self.span_from(start)))
        try self.expect_statement_end()
        return StatementSyntax(form = StatementForm.ExpressionStatement(value = value, span = self.span_from(start)))

    func parse_binding_statement(start: Token) -> StatementSyntax!:
        let is_mutable = start.text == "var"
        let pattern = try self.parse_binding_pattern()
        var annotation: TypeSyntax? = none
        if self.take_symbol(":"): annotation = try self.parse_type()
        try self.expect_symbol("=")
        let value = try self.parse_expression()
        try self.expect_statement_end()
        return StatementSyntax(form = StatementForm.Binding(is_mutable = is_mutable, pattern = pattern, annotation = annotation, value = value, span = self.span_from(start)))

    func parse_binding_pattern() -> BindingPatternSyntax!:
        let start = self.current()
        if self.at_kind(TokenKind.name):
            let name = self.advance().text
            return BindingPatternSyntax.Name(value = name, span = self.span_from(start))

        try self.expect_symbol("(")
        let names = list[str]()
        names.append((try self.expect_name("binding name")).text)
        try self.expect_symbol(",")
        names.append((try self.expect_name("binding name")).text)
        while self.take_symbol(","):
            if self.at_symbol(")"): break
            names.append((try self.expect_name("binding name")).text)
        try self.expect_symbol(")")
        return BindingPatternSyntax.TupleNames(values = names, span = self.span_from(start))

    func parse_if_statement() -> StatementSyntax!:
        let start = try self.expect_keyword("if")
        let branches = list[IfBranchSyntax]()
        let has_binding = self.at_keyword("let")
        let condition = try self.parse_condition()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        branches.append(IfBranchSyntax(condition = condition, body = body, span = span_between(start, self.previous())))

        while self.at_keyword("elif"):
            let branch_start = self.advance()
            if has_binding or self.at_keyword("let"):
                try self.fail(branch_start, "a conditional binding cannot have an `elif` branch")
            let branch_condition = try self.parse_condition()
            try self.expect_symbol(":")
            let branch_body = try self.parse_suite()
            branches.append(IfBranchSyntax(condition = branch_condition, body = branch_body, span = span_between(branch_start, self.previous())))

        var fallback: SuiteSyntax? = none
        if self.take_keyword("else"):
            try self.expect_symbol(":")
            fallback = try self.parse_suite()
        return StatementSyntax(form = StatementForm.IfStatement(branches = branches, fallback = fallback, span = self.span_from(start)))

    func parse_condition() -> ConditionSyntax!:
        if self.take_keyword("let"):
            let start = self.previous()
            let name = (try self.expect_name("conditional binding name")).text
            try self.expect_symbol("=")
            let value = try self.parse_expression()
            return ConditionSyntax(form = ConditionForm.Binding(name = name, value = value, span = self.span_from(start)))
        return ConditionSyntax(form = ConditionForm.Expression(value = try self.parse_expression()))

    func parse_while_statement() -> StatementSyntax!:
        let start = try self.expect_keyword("while")
        let condition = try self.parse_expression()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return StatementSyntax(form = StatementForm.WhileStatement(condition = condition, body = body, span = self.span_from(start)))

    func parse_for_statement() -> StatementSyntax!:
        let start = try self.expect_keyword("for")
        let name = (try self.expect_name("iteration binding")).text
        try self.expect_keyword("in")
        let iterable = try self.parse_expression()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return StatementSyntax(form = StatementForm.ForStatement(name = name, iterable = iterable, body = body, span = self.span_from(start)))

    func parse_match_statement() -> StatementSyntax!:
        let start = try self.expect_keyword("match")
        let subject = try self.parse_expression()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before match arms")
        try self.expect_kind(TokenKind.indent, "indented match arms")
        let arms = list[MatchStatementArmSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let arm_start = self.current()
            let patterns = try self.parse_patterns()
            try self.expect_symbol(":")
            let body = try self.parse_suite()
            arms.append(MatchStatementArmSyntax(patterns = patterns, body = body, span = self.span_from(arm_start)))
        if len(arms) == 0: try self.fail(self.current(), "a match must contain at least one arm")
        try self.expect_kind(TokenKind.dedent, "end of match arms")
        return StatementSyntax(form = StatementForm.MatchStatement(subject = subject, arms = arms, span = self.span_from(start)))

    func parse_patterns() -> list[PatternSyntax]!:
        let patterns = list[PatternSyntax]()
        patterns.append(try self.parse_pattern())
        while self.take_symbol(","):
            patterns.append(try self.parse_pattern())
        return patterns

    func parse_pattern() -> PatternSyntax!:
        let start = self.current()
        if self.take_symbol("_"):
            return PatternSyntax.Wildcard(span = self.span_from(start))
        if self.is_literal(self.current()):
            let lower = self.advance()
            if self.at_symbol("..<") or self.at_symbol("..="):
                let operator = self.advance().text
                if not self.is_literal(self.current()):
                    try self.fail(self.current(), "expected a literal at the end of a pattern range")
                let upper = self.advance()
                return PatternSyntax.RangePattern(lower = lower, operator = operator, upper = upper, span = self.span_from(start))
            return PatternSyntax.Literal(token = lower)
        try self.expect_symbol(".")
        let name = (try self.expect_name("case name")).text
        let bindings = list[str]()
        if self.take_symbol("("):
            if not self.at_symbol(")"):
                while true:
                    bindings.append((try self.expect_name("pattern binding")).text)
                    if not self.take_symbol(","): break
            try self.expect_symbol(")")
        return PatternSyntax.CasePattern(name = name, bindings = bindings, span = self.span_from(start))

    # mark: Types ------------------------------------------------------------

    func parse_type() -> TypeSyntax!:
        let start = self.current()
        var value = try self.parse_primary_type()
        if self.take_symbol("?"):
            value = TypeSyntax(form = TypeForm.OptionalType(value = value, span = self.span_from(start)))
        if self.take_symbol("!"):
            value = TypeSyntax(form = TypeForm.FallibleType(value = value, span = self.span_from(start)))
        return value

    func parse_primary_type() -> TypeSyntax!:
        let start = self.current()
        if self.take_keyword("func"):
            try self.expect_symbol("(")
            let parameters = list[TypeSyntax]()
            if not self.at_symbol(")"):
                while true:
                    parameters.append(try self.parse_type())
                    if not self.take_symbol(","): break
                    if self.at_symbol(")"): break
            try self.expect_symbol(")")
            try self.expect_symbol("->")
            let result = try self.parse_type()
            let effects = try self.parse_effects()
            return TypeSyntax(form = TypeForm.FunctionType(parameters = parameters, result = result, effects = effects, span = self.span_from(start)))

        if self.take_symbol("("):
            let elements = list[TypeSyntax]()
            elements.append(try self.parse_type())
            try self.expect_symbol(",")
            elements.append(try self.parse_type())
            while self.take_symbol(","):
                if self.at_symbol(")"): break
                elements.append(try self.parse_type())
            try self.expect_symbol(")")
            return TypeSyntax(form = TypeForm.TupleType(elements = elements, span = self.span_from(start)))

        let path = try self.parse_path()
        var arguments = list[TypeArgumentSyntax]()
        if self.at_symbol("["):
            arguments = try self.parse_type_arguments()
        if len(arguments) == 0:
            return TypeSyntax(form = TypeForm.Named(path = path))
        return TypeSyntax(form = TypeForm.Applied(path = path, arguments = arguments, span = self.span_from(start)))

    # mark: Expressions ------------------------------------------------------

    func parse_expression() -> ExpressionSyntax!:
        let start = self.current()
        var value = try self.parse_conditional_expression()
        if self.expression_has_ended(): return value
        if self.take_keyword("catch"):
            let failure_name = (try self.expect_name("catch binding")).text
            try self.expect_symbol(":")
            let body = try self.parse_suite()
            value = ExpressionSyntax(form = ExpressionForm.CatchValue(value = value, failure_name = failure_name, body = body, span = self.span_from(start)))
        return value

    func parse_conditional_expression() -> ExpressionSyntax!:
        let start = self.current()
        let value = try self.parse_binary_expression(1)
        if self.expression_has_ended(): return value
        if not self.take_keyword("if"): return value
        let condition = try self.parse_binary_expression(1)
        try self.expect_keyword("else")
        let alternative = try self.parse_conditional_expression()
        return ExpressionSyntax(form = ExpressionForm.Conditional(value = value, condition = condition, alternative = alternative, span = self.span_from(start)))

    func parse_binary_expression(minimum_precedence: i64) -> ExpressionSyntax!:
        let start = self.current()
        var left = try self.parse_unary_expression()
        var used_comparison = false
        var used_range = false

        while true:
            if self.expression_has_ended(): break
            let operator = self.binary_operator()
            let precedence = binary_precedence(operator)
            if precedence < minimum_precedence: break
            if precedence == comparison_precedence and used_comparison:
                try self.fail(self.current(), "comparison operators cannot be chained")
            if precedence == range_precedence and used_range:
                try self.fail(self.current(), "range operators cannot be chained")
            if precedence == comparison_precedence: used_comparison = true
            if precedence == range_precedence: used_range = true

            self.advance()
            if operator == "is not": self.advance()
            let right = try self.parse_binary_expression(precedence + 1)
            left = ExpressionSyntax(form = ExpressionForm.Binary(left = left, operator = operator, right = right, span = self.span_from(start)))
        return left

    func parse_unary_expression() -> ExpressionSyntax!:
        let start = self.current()
        if self.at_keyword("try") or self.at_keyword("not") or self.at_symbol("+") or self.at_symbol("-") or self.at_symbol("~"):
            let operator = self.advance().text
            let operand = try self.parse_unary_expression()
            return ExpressionSyntax(form = ExpressionForm.Unary(operator = operator, operand = operand, span = self.span_from(start)))
        return try self.parse_postfix_expression()

    func parse_postfix_expression() -> ExpressionSyntax!:
        let start = self.current()
        var value = try self.parse_primary_expression()
        while true:
            if self.expression_has_ended():
                break
            elif self.take_symbol("."):
                let name = (try self.expect_name("member name")).text
                value = ExpressionSyntax(form = ExpressionForm.Member(value = value, name = name, span = self.span_from(start)))
            elif self.at_symbol("("):
                let arguments = try self.parse_arguments()
                value = ExpressionSyntax(form = ExpressionForm.Call(callee = value, type_arguments = list[TypeArgumentSyntax](), arguments = arguments, span = self.span_from(start)))
            elif self.at_symbol("[") and self.is_generic_call_ahead():
                let type_arguments = try self.parse_type_arguments()
                let arguments = try self.parse_arguments()
                value = ExpressionSyntax(form = ExpressionForm.Call(callee = value, type_arguments = type_arguments, arguments = arguments, span = self.span_from(start)))
            elif self.take_symbol("["):
                value = try self.parse_subscript(value, start)
            else:
                break
        return value

    func parse_primary_expression() -> ExpressionSyntax!:
        let start = self.current()
        if self.is_literal(self.current()):
            return ExpressionSyntax(form = ExpressionForm.Literal(token = self.advance()))
        if self.at_kind(TokenKind.name):
            let name = self.advance().text
            return ExpressionSyntax(form = ExpressionForm.Name(value = name, span = self.span_from(start)))
        if self.take_keyword("self"):
            return ExpressionSyntax(form = ExpressionForm.Name(value = "self", span = self.span_from(start)))
        if self.take_symbol("."):
            let name = (try self.expect_name("case name")).text
            var arguments = list[ArgumentSyntax]()
            if self.at_symbol("("): arguments = try self.parse_arguments()
            return ExpressionSyntax(form = ExpressionForm.CaseValue(name = name, arguments = arguments, span = self.span_from(start)))
        if self.at_symbol("("):
            if self.is_lambda_ahead(): return try self.parse_lambda_expression()
            return try self.parse_group_or_tuple()
        if self.at_symbol("["): return try self.parse_list_expression()
        if self.at_symbol("{"): return try self.parse_map_expression()
        if self.take_keyword("func"): return try self.parse_closure_expression(start)
        if self.take_keyword("match"): return try self.parse_match_expression(start)
        if self.take_keyword("new"): return try self.parse_new_expression(start)
        if self.take_keyword("spawn"): return try self.parse_spawn_expression(start)
        error(self.diagnostic(self.current(), "expected an expression"))

    func parse_group_or_tuple() -> ExpressionSyntax!:
        let start = try self.expect_symbol("(")
        if self.take_symbol(")"):
            return ExpressionSyntax(form = ExpressionForm.TupleValue(elements = list[ExpressionSyntax](), span = self.span_from(start)))

        let first = try self.parse_expression()
        if not self.take_symbol(","):
            try self.expect_symbol(")")
            return ExpressionSyntax(form = ExpressionForm.Group(value = first, span = self.span_from(start)))

        let elements = list[ExpressionSyntax]()
        elements.append(first)
        if self.at_symbol(")"):
            try self.fail(self.current(), "a tuple requires at least two elements")
        while true:
            elements.append(try self.parse_expression())
            if not self.take_symbol(","): break
            if self.at_symbol(")"): break
        try self.expect_symbol(")")
        return ExpressionSyntax(form = ExpressionForm.TupleValue(elements = elements, span = self.span_from(start)))

    func parse_lambda_expression() -> ExpressionSyntax!:
        let start = self.current()
        let parameters = try self.parse_lambda_parameters()
        try self.expect_symbol("=>")
        let body = try self.parse_expression()
        return ExpressionSyntax(form = ExpressionForm.Lambda(parameters = parameters, body = body, span = self.span_from(start)))

    func parse_lambda_parameters() -> list[ParameterSyntax]!:
        try self.expect_symbol("(")
        let parameters = list[ParameterSyntax]()
        if not self.at_symbol(")"):
            while true:
                let start = self.current()
                let name = (try self.expect_name("lambda parameter")).text
                var annotation: TypeSyntax? = none
                if self.take_symbol(":"): annotation = try self.parse_type()
                parameters.append(ParameterSyntax(name = name, annotation = annotation, default_value = none, span = self.span_from(start)))
                if not self.take_symbol(","): break
                if self.at_symbol(")"): break
        try self.expect_symbol(")")
        return parameters

    func parse_list_expression() -> ExpressionSyntax!:
        let start = try self.expect_symbol("[")
        let elements = list[ExpressionSyntax]()
        if not self.at_symbol("]"):
            while true:
                elements.append(try self.parse_expression())
                if not self.take_symbol(","): break
                if self.at_symbol("]"): break
        try self.expect_symbol("]")
        return ExpressionSyntax(form = ExpressionForm.ListValue(elements = elements, span = self.span_from(start)))

    func parse_map_expression() -> ExpressionSyntax!:
        let start = try self.expect_symbol("{")
        if self.at_symbol("}"): try self.fail(self.current(), "an empty map uses `map[K, V]()`")
        let entries = list[MapEntrySyntax]()
        while true:
            let entry_start = self.current()
            let key = try self.parse_expression()
            try self.expect_symbol(":")
            let value = try self.parse_expression()
            entries.append(MapEntrySyntax(key = key, value = value, span = self.span_from(entry_start)))
            if not self.take_symbol(","): break
            if self.at_symbol("}"): break
        try self.expect_symbol("}")
        return ExpressionSyntax(form = ExpressionForm.MapValue(entries = entries, span = self.span_from(start)))

    func parse_closure_expression(start: Token) -> ExpressionSyntax!:
        let captures = list[CaptureSyntax]()
        if self.take_symbol("["):
            if self.at_symbol("]"): try self.fail(self.current(), "capture list cannot be empty")
            while true:
                let capture_start = self.current()
                var is_weak = false
                var value: ExpressionSyntax? = none
                if self.take_keyword("weak"):
                    is_weak = true
                else:
                    let copy = try self.expect_name("`copy` or `weak` capture")
                    if copy.text != "copy": try self.fail(copy, "expected `copy` or `weak` capture")
                let name = (try self.expect_name("capture name")).text
                if not is_weak:
                    try self.expect_symbol("=")
                    value = try self.parse_expression()
                captures.append(CaptureSyntax(name = name, value = value, is_weak = is_weak, span = self.span_from(capture_start)))
                if not self.take_symbol(","): break
                if self.at_symbol("]"): break
            try self.expect_symbol("]")
        let parameters = try self.parse_parameters()
        let result = try self.parse_result_type()
        let effects = try self.parse_effects()
        try self.expect_symbol(":")
        let body = try self.parse_suite()
        return ExpressionSyntax(form = ExpressionForm.Closure(captures = captures, parameters = parameters, result = result, effects = effects, body = body, span = self.span_from(start)))

    func parse_match_expression(start: Token) -> ExpressionSyntax!:
        if self.in_inline_suite:
            try self.fail(start, "a same-line suite cannot contain a match expression")
        let subject = try self.parse_expression()
        try self.expect_symbol(":")
        try self.expect_kind(TokenKind.newline, "newline before match arms")
        try self.expect_kind(TokenKind.indent, "indented match arms")
        let arms = list[MatchValueArmSyntax]()
        while not self.at_kind(TokenKind.dedent):
            let arm_start = self.current()
            let patterns = try self.parse_patterns()
            try self.expect_symbol("=>")
            let value = try self.parse_expression()
            try self.expect_statement_end()
            arms.append(MatchValueArmSyntax(patterns = patterns, value = value, span = self.span_from(arm_start)))
        if len(arms) == 0: try self.fail(self.current(), "a match must contain at least one arm")
        try self.expect_kind(TokenKind.dedent, "end of match arms")
        return ExpressionSyntax(form = ExpressionForm.MatchValue(subject = subject, arms = arms, span = self.span_from(start)))

    func parse_new_expression(start: Token) -> ExpressionSyntax!:
        let value_type = try self.parse_type()
        let arguments = try self.parse_arguments()
        return ExpressionSyntax(form = ExpressionForm.NewValue(value_type = value_type, arguments = arguments, span = self.span_from(start)))

    func parse_spawn_expression(start: Token) -> ExpressionSyntax!:
        let function = try self.parse_path()
        let arguments = try self.parse_arguments()
        return ExpressionSyntax(form = ExpressionForm.SpawnValue(function = function, arguments = arguments, span = self.span_from(start)))

    func parse_arguments() -> list[ArgumentSyntax]!:
        try self.expect_symbol("(")
        let arguments = list[ArgumentSyntax]()
        if not self.at_symbol(")"):
            while true:
                let start = self.current()
                var label: str? = none
                if self.at_kind(TokenKind.name) and self.peek(1).text == ":":
                    label = self.advance().text
                    try self.expect_symbol(":")
                let value = try self.parse_expression()
                arguments.append(ArgumentSyntax(label = label, value = value, span = self.span_from(start)))
                if not self.take_symbol(","): break
                if self.at_symbol(")"): break
        try self.expect_symbol(")")
        return arguments

    func parse_type_arguments() -> list[TypeArgumentSyntax]!:
        try self.expect_symbol("[")
        let arguments = list[TypeArgumentSyntax]()
        if self.at_symbol("]"): try self.fail(self.current(), "type argument list cannot be empty")
        while true:
            if self.at_kind(TokenKind.int_lit):
                arguments.append(TypeArgumentSyntax.IntegerArgument(token = self.advance()))
            else:
                arguments.append(TypeArgumentSyntax.TypeArgument(value = try self.parse_type()))
            if not self.take_symbol(","): break
            if self.at_symbol("]"): break
        try self.expect_symbol("]")
        return arguments

    # `xs[a..<b]` collides with the range operators: parsed naively, the
    # subscript expression would swallow `..<` as binary range syntax and the
    # slice form would never be seen. So the bracket's tokens are scanned
    # first — a slice operator at depth one splits the subscript into two
    # bounded expression parses, while anything else, including a
    # parenthesized `(a..<b)` range value, stays an ordinary index.
    func parse_subscript(value: ExpressionSyntax, start: Token) -> ExpressionSyntax!:
        let opening = self.position - 1
        let closing = self.matching_symbol(opening, "[", "]")
        let separator = self.find_slice_operator(opening, closing)
        if separator < 0:
            let subscript = try self.parse_expression()
            try self.expect_symbol("]")
            return ExpressionSyntax(form = ExpressionForm.Index(value = value, subscript = subscript, span = self.span_from(start)))

        let previous_limit = self.expression_limit
        var slice_start: ExpressionSyntax? = none
        if self.position < separator:
            self.expression_limit = separator
            slice_start = try self.parse_expression()
        self.expression_limit = previous_limit
        if self.position != separator:
            try self.fail(self.current(), "expected a slice operator")

        let operator = self.advance().text
        var slice_end: ExpressionSyntax? = none
        if self.position < closing:
            if operator == "..":
                try self.fail(self.current(), "an inclusive slice ends at `..`")
            self.expression_limit = closing
            slice_end = try self.parse_expression()
        self.expression_limit = previous_limit

        if operator == ".." and slice_start == none:
            try self.fail(self.previous(), "an inclusive slice requires a start")
        try self.expect_symbol("]")
        return ExpressionSyntax(form = ExpressionForm.Slice(value = value, start = slice_start, operator = operator, end = slice_end, span = self.span_from(start)))

    # mark: Token stream and diagnostics ------------------------------------

    func current() -> Token:
        return self.token_at(self.position)

    func previous() -> Token:
        return self.token_at(max(self.position - 1, 0))

    func peek(offset: i64) -> Token:
        return self.token_at(self.position + offset)

    func token_at(index: i64) -> Token:
        if index >= len(self.tokens): return self.tokens[len(self.tokens) - 1]
        return self.tokens[index]

    func advance() -> Token:
        let token = self.current()
        if token.kind != TokenKind.eof: self.position += 1
        return token

    func at_kind(kind: TokenKind) -> bool:
        return self.current().kind == kind

    func take_kind(kind: TokenKind) -> bool:
        if not self.at_kind(kind): return false
        self.advance()
        return true

    func expect_kind(kind: TokenKind, expected: str) -> Token!:
        if not self.at_kind(kind):
            try self.fail(self.current(), "expected " + expected)
        return self.advance()

    func at_keyword(keyword: str) -> bool:
        let token = self.current()
        return token.kind == TokenKind.keyword and token.text == keyword

    func take_keyword(keyword: str) -> bool:
        if not self.at_keyword(keyword): return false
        self.advance()
        return true

    func expect_keyword(keyword: str) -> Token!:
        if not self.at_keyword(keyword):
            try self.fail(self.current(), "expected `" + keyword + "`")
        return self.advance()

    func at_symbol(symbol: str) -> bool:
        let token = self.current()
        return token.kind == TokenKind.symbol and token.text == symbol

    func take_symbol(symbol: str) -> bool:
        if not self.at_symbol(symbol): return false
        self.advance()
        return true

    func expect_symbol(symbol: str) -> Token!:
        if not self.at_symbol(symbol):
            try self.fail(self.current(), "expected `" + symbol + "`")
        return self.advance()

    func expect_name(expected: str) -> Token!:
        if not self.at_kind(TokenKind.name):
            try self.fail(self.current(), "expected " + expected)
        return self.advance()

    # A block-valued expression consumes the newline or dedent belonging to its
    # own suite. Every other simple statement must consume one NEWLINE here.
    func expect_statement_end() -> !:
        let previous_kind = self.previous().kind
        if previous_kind == TokenKind.newline or previous_kind == TokenKind.dedent:
            return
        try self.expect_kind(TokenKind.newline, "newline after statement")

    func expression_has_ended() -> bool:
        if self.expression_limit >= 0 and self.position == self.expression_limit: return true
        let kind = self.previous().kind
        return kind == TokenKind.newline or kind == TokenKind.dedent

    func span_from(start: Token) -> SourceSpan:
        return span_between(start, self.previous())

    func fail(token: Token, message: str) -> !:
        error(self.diagnostic(token, message))

    # Diagnostics carry only line and column; the pipeline prefixes the file
    # path, so a caller always reads `path:line:column: message`.
    func diagnostic(token: Token, message: str) -> str:
        return str(token.span.line) + ":" + str(token.span.column) + ": " + message

    # mark: Expression lookahead --------------------------------------------

    func is_literal(token: Token) -> bool:
        if token.kind == TokenKind.int_lit or token.kind == TokenKind.float_lit: return true
        if token.kind == TokenKind.str_lit or token.kind == TokenKind.byte_lit: return true
        if token.kind == TokenKind.char_lit: return true
        return token.kind == TokenKind.keyword and (token.text == "true" or token.text == "false" or token.text == "none")

    func is_assignment_target(value: ExpressionSyntax) -> bool:
        match value.form:
            Name(name, span): return true
            Member(target, name, span): return self.is_assignment_target(target)
            Index(target, subscript, span): return self.is_assignment_target(target)
            else: return false

    func binary_operator() -> str:
        let token = self.current()
        if token.kind == TokenKind.keyword:
            if token.text == "is" and self.peek(1).text == "not": return "is not"
            if token.text == "is" or token.text == "and" or token.text == "or": return token.text
            return ""
        if token.kind != TokenKind.symbol: return ""
        if binary_precedence(token.text) > 0: return token.text
        return ""

    # `(` opens a lambda when its matching `)` is followed by `=>`; the real
    # parameter parser reports any malformed contents.
    func is_lambda_ahead() -> bool:
        let close = self.matching_symbol(self.position, "(", ")")
        return close >= 0 and self.token_at(close + 1).text == "=>"

    # Generic-call brackets must close immediately before `(` and begin with a
    # syntactically recognizable type (or the integer array-length argument).
    func is_generic_call_ahead() -> bool:
        let close = self.matching_symbol(self.position, "[", "]")
        if close < 0 or self.token_at(close + 1).text != "(": return false
        return self.looks_like_type_start(self.position + 1, close)

    func looks_like_type_start(index: i64, limit: i64) -> bool:
        if index >= limit: return false
        let token = self.token_at(index)
        if token.kind == TokenKind.int_lit: return true
        if token.kind == TokenKind.keyword and token.text == "func": return true
        if token.kind == TokenKind.symbol and token.text == "(": return true
        if token.kind != TokenKind.name: return false
        if is_core_type_name(token.text) or strings.is_upper(token.text[0]): return true

        var part = index
        while part + 2 < limit and self.token_at(part + 1).text == ".":
            if self.token_at(part + 2).kind != TokenKind.name: return false
            part += 2
        return part > index and strings.is_upper(self.token_at(part).text[0])

    func matching_symbol(start: i64, opening: str, closing: str) -> i64:
        var depth = 0
        var index = start
        while index < len(self.tokens):
            let text = self.token_at(index).text
            if text == opening: depth += 1
            if text == closing:
                depth -= 1
                if depth == 0: return index
            index += 1
        return -1

    func find_slice_operator(opening: i64, closing: i64) -> i64:
        var depth = 0
        var found = -1
        var index = opening
        while index < closing:
            let text = self.token_at(index).text
            if text == "(" or text == "[" or text == "{":
                depth += 1
            elif text == ")" or text == "]" or text == "}":
                depth -= 1
            elif depth == 1 and (text == "..<" or text == ".."):
                if found >= 0: return -2
                found = index
            index += 1
        return found


# mark: Parser tables --------------------------------------------------------

const comparison_precedence = 3
const range_precedence = 4

func span_between(start: Token, end: Token) -> SourceSpan:
    return SourceSpan(start = start.span.start, end = end.span.end, line = start.span.line, column = start.span.column)

func binary_precedence(operator: str) -> i64:
    return match operator:
        "or" => 1
        "and" => 2
        "==", "!=", "<", "<=", ">", ">=", "is", "is not" => comparison_precedence
        "..<", "..=" => range_precedence
        "|" => 5
        "^" => 6
        "&" => 7
        "<<", ">>" => 8
        "+", "-" => 9
        "*", "/", "//", "%" => 10
        else => 0

func is_assignment_operator(operator: str) -> bool:
    return match operator:
        "=", "+=", "-=", "*=", "/=", "//=", "%=" => true
        "&=", "|=", "^=", "<<=", ">>=" => true
        else => false

func is_core_type_name(name: str) -> bool:
    return match name:
        "bool", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64" => true
        "f16", "f32", "f64", "char", "str", "bytes", "unit", "never" => true
        "array", "slice", "mutable_slice", "list", "map", "set", "range", "task" => true
        else => false
