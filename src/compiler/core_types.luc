#==============================================================================================
#
#   core_types - Source spellings of language-defined types
#
#   DESCRIPTION:
#       The reserved type names of `docs/language/1.0.md` section 5, whether
#       or not the compiler implements them yet. The parser uses them to tell
#       `foo[T](` from `foo[0](`; HIR generation uses them so a known-but-
#       unimplemented type is "not implemented yet" rather than "unknown".
#       The implemented subset lives in `builtin_type_id` in
#       `hir/generation_model.luc`.
#
#==============================================================================================

# mark: Core namespace =======================================================================

## Report whether `name` is a language-defined type spelling, implemented or not.
pub func is_core_type_name(name: str) -> bool:
    return match name:
        "bool", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64" => true
        "f16", "f32", "f64", "char", "str", "bytes", "unit", "never" => true
        "array", "slice", "mutable_slice", "list", "map", "set", "frozen_list", "frozen_map", "frozen_set", "range", "Weak", "task" => true
        "Iterator", "Iterable", "FallibleIterator", "FallibleIterable" => true
        "Display", "Equatable", "Hashable", "Comparable" => true
        "native_ptr", "native_mut_ptr", "foreign" => true
        "ErrorCode", "Error" => true
        else => false

## Report whether `name` belongs to the compiler-known core value namespace.
## These spellings remain reserved even before every operation is implemented.
pub func is_core_operation_name(name: str) -> bool:
    return name == "assert" or name == "discard" or name == "error" or name == "hash" or name == "trap" or name == "wait_all"

## The core namespace is closed across both type and value bindings.
pub func is_reserved_core_name(name: str) -> bool:
    return is_core_type_name(name) or is_core_operation_name(name)
