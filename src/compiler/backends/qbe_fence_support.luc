#==============================================================================================
#
#   qbe_fence_support - The C shim behind QBE's fence instruction
#
#   DESCRIPTION:
#       QBE has no fence, and `__atomic_thread_fence` is a compiler builtin
#       with no linkable symbol, so a program that fences is linked with two
#       one-line C functions that expand the builtins (base.md §19.3). The
#       toolchain and the test harness both ask here whether a program needs
#       them and what to compile.
#
#==============================================================================================

from compiler.mir.canonical import MirProgram

## Whether any function of `program` executes a `Fence`.
pub func qbe_program_uses_fences(program: MirProgram) -> bool:
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                Fence(order, is_signal): return true
                else: pass
    return false

## The C source of the two fence shims QBE output calls.
pub func qbe_fence_support_source() -> str:
    return (
        "void luce_atomic_thread_fence(int order) { __atomic_thread_fence(order); }\n"
        + "void luce_atomic_signal_fence(int order) { __atomic_signal_fence(order); }\n"
    )
