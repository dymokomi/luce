#==============================================================================================
#
#   hir_resources - Ownership graph observation for the HIR semantic oracle
#
#   DESCRIPTION:
#       Walks public HIR runtime values until the next source class identity.
#       The interpreter owns execution and allocation observations; this
#       module owns only the representation-specific graph traversal.
#
#       Containers and hidden managed storage are collapsed into class-to-
#       class edges. Weak storage is deliberately absent, and visited identity
#       sets keep cyclic collections and closure environments finite.
#
#==============================================================================================

from compiler.hir.ir import BoxedValue, CapturedCellStorage, ClosureStorage, HashStorage, InterfaceStorage, ListBuffer, Value

## Find every source-class identity strongly reachable from a class payload
## before crossing another source-class boundary.
pub func collect_hir_class_references(fields: list[BoxedValue]) -> list[i64]:
    let pending = list[BoxedValue]()
    for field in fields: pending.append(field)
    let references = list[i64]()
    let list_buffers = list[ListBuffer]()
    let hashes = list[HashStorage]()
    let closures = list[ClosureStorage]()
    let interfaces = list[InterfaceStorage]()
    let cells = list[CapturedCellStorage]()

    while len(pending) > 0:
        let position = len(pending) - 1
        let current = pending[position].value
        pending.remove(position)
        match current:
            Tuple(elements): append_values(pending, elements)
            Array(elements): append_values(pending, elements)
            Record(elements): append_values(pending, elements)
            Variant(case_index, payload): append_values(pending, payload)
            Present(value): pending.append(value)
            FallibleSuccess(value): pending.append(value)
            FallibleFailure(value): pending.append(value)
            List(storage):
                if not contains_list_buffer(list_buffers, storage.buffer):
                    list_buffers.append(storage.buffer)
                    append_values(pending, storage.buffer.elements)
            Map(storage): append_hash_storage(pending, hashes, storage)
            Set(storage): append_hash_storage(pending, hashes, storage)
            Slice(storage):
                match storage.backing:
                    List(buffer):
                        if not contains_list_buffer(list_buffers, buffer):
                            list_buffers.append(buffer)
                            # The complete retained snapshot owns its values,
                            # including those outside the visible slice range.
                            append_values(pending, buffer.elements)
                    Bytes(value): pass
            Closure(storage):
                if not contains_closure_storage(closures, storage):
                    closures.append(storage)
                    append_values(pending, storage.captures)
            Interface(storage):
                if not contains_interface_storage(interfaces, storage):
                    interfaces.append(storage)
                    pending.append(storage.value)
            CapturedCell(storage):
                if not contains_cell_storage(cells, storage):
                    cells.append(storage)
                    pending.append(storage.value)
            Class(storage):
                if storage.allocation_id >= 0 and not contains_allocation_id(references, storage.allocation_id):
                    references.append(storage.allocation_id)
            # Scalars, weak storage, raw boundaries, capture-free functions,
            # and immutable byte/text values own no source class identity.
            else: pass
    return references

# mark: Traversal helpers =====================================================================

func append_values(destination: list[BoxedValue], values: list[BoxedValue]):
    for value in values: destination.append(value)

func append_hash_storage(destination: list[BoxedValue], visited: list[HashStorage], storage: HashStorage):
    if contains_hash_storage(visited, storage): return
    visited.append(storage)
    for entry in storage.entries:
        destination.append(entry.key)
        destination.append(entry.value)

func contains_allocation_id(values: list[i64], sought: i64) -> bool:
    for value in values:
        if value == sought: return true
    return false

func contains_list_buffer(values: list[ListBuffer], sought: ListBuffer) -> bool:
    for value in values:
        if value is sought: return true
    return false

func contains_hash_storage(values: list[HashStorage], sought: HashStorage) -> bool:
    for value in values:
        if value is sought: return true
    return false

func contains_closure_storage(values: list[ClosureStorage], sought: ClosureStorage) -> bool:
    for value in values:
        if value is sought: return true
    return false

func contains_interface_storage(values: list[InterfaceStorage], sought: InterfaceStorage) -> bool:
    for value in values:
        if value is sought: return true
    return false

func contains_cell_storage(values: list[CapturedCellStorage], sought: CapturedCellStorage) -> bool:
    for value in values:
        if value is sought: return true
    return false
