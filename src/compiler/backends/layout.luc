#==============================================================================================
#
#   layout - Backend-owned byte layout for target-neutral MIR types
#
#   DESCRIPTION:
#       Canonical MIR records aggregate structure and abstract pointers, never
#       target byte offsets. A backend creates one TypeLayout from its pointer
#       rules and queries it while encoding. Sizes and alignments are cached by
#       TypeId, so every type is laid out at most once per backend emission.
#
#==============================================================================================

from compiler.mir.canonical import MirClass, MirClosure, MirTypeTable, TypeId, mir_type

# mark: Rules and cached layout ================================================================

## The only primitive layout choices required by the current MIR type system.
pub struct LayoutRules:
    pub let pointer_size: i64
    pub let pointer_align: i64

## Cached C-compatible layout for one backend and one MIR type table.
pub class TypeLayout:
    let types: MirTypeTable
    let rules: LayoutRules
    let sizes: list[i64]
    let alignments: list[i64]

    pub init(types: MirTypeTable, rules: LayoutRules):
        self.types = types
        self.rules = rules
        self.sizes = list[i64]()
        self.alignments = list[i64]()
        for index in range(0, len(types.definitions)):
            self.sizes.append(-1)
            self.alignments.append(-1)

    pub func pointer_size() -> i64:
        return self.rules.pointer_size

    pub func pointer_align() -> i64:
        return self.rules.pointer_align

    pub func size_of(id: TypeId) -> i64:
        let cached = self.sizes[id.value]
        if cached >= 0: return cached
        let value = self.compute_size(id)
        self.sizes[id.value] = value
        return value

    pub func align_of(id: TypeId) -> i64:
        let cached = self.alignments[id.value]
        if cached >= 0: return cached
        let value = self.compute_align(id)
        self.alignments[id.value] = value
        return value

    ## Byte offset of one struct field under this backend's rules.
    pub func field_offset(id: TypeId, selected: i64) -> i64:
        match mir_type(self.types, id):
            Struct(fields):
                var offset = 0
                for index in range(0, len(fields)):
                    let field = fields[index]
                    offset = align_up(offset, self.align_of(field.value_type))
                    if index == selected: return offset
                    offset += self.size_of(field.value_type)
                trap("field layout index is outside its struct")
            else: trap("field layout requested for a non-struct type")

    ## Byte offset of every enum payload under this backend's rules.
    pub func enum_payload_offset(id: TypeId) -> i64:
        match mir_type(self.types, id):
            Enum(tag, cases):
                var payload_align = 1
                for case_type in cases:
                    let case_align = self.align_of(case_type)
                    if case_align > payload_align: payload_align = case_align
                return align_up(self.size_of(tag), payload_align)
            else: trap("enum payload layout requested for a non-enum type")

    ## Size of one class's payload, excluding its runtime-owned identity
    ## header. Class metadata stays structural in MIR; only a backend applies
    ## its pointer rules and padding here.
    pub func class_payload_size(value: MirClass) -> i64:
        var offset = 0
        let alignment = self.class_payload_align(value)
        for field in value.fields:
            offset = align_up(offset, self.align_of(field.storage_type))
            offset += self.size_of(field.storage_type)
        return align_up(offset, alignment)

    ## Maximum field alignment of one class payload. Empty payloads retain the
    ## minimum valid allocation alignment even though they occupy no bytes.
    pub func class_payload_align(value: MirClass) -> i64:
        var alignment = 1
        for field in value.fields:
            let field_alignment = self.align_of(field.storage_type)
            if field_alignment > alignment: alignment = field_alignment
        return alignment

    ## Byte offset of one declaration-order class field inside its payload.
    pub func class_field_offset(value: MirClass, selected: i64) -> i64:
        var offset = 0
        for index in range(0, len(value.fields)):
            let field = value.fields[index]
            offset = align_up(offset, self.align_of(field.storage_type))
            if index == selected: return offset
            offset += self.size_of(field.storage_type)
        trap("field layout index is outside its class payload")

    ## Closure and cell payloads use the same managed allocation service as
    ## classes while retaining distinct canonical metadata. These helpers are
    ## the only place their declaration-order fields become byte offsets.
    pub func closure_payload_size(value: MirClosure) -> i64:
        var offset = 0
        let alignment = self.closure_payload_align(value)
        for capture in value.captures:
            offset = align_up(offset, self.align_of(capture.value_type))
            offset += self.size_of(capture.value_type)
        return align_up(offset, alignment)

    pub func closure_payload_align(value: MirClosure) -> i64:
        var alignment = 1
        for capture in value.captures:
            let capture_alignment = self.align_of(capture.value_type)
            if capture_alignment > alignment: alignment = capture_alignment
        return alignment

    pub func closure_capture_offset(value: MirClosure, selected: i64) -> i64:
        var offset = 0
        for index in range(0, len(value.captures)):
            let capture = value.captures[index]
            offset = align_up(offset, self.align_of(capture.value_type))
            if index == selected: return offset
            offset += self.size_of(capture.value_type)
        trap("capture layout index is outside its closure payload")

    func compute_size(id: TypeId) -> i64:
        match mir_type(self.types, id):
            Int(bits, is_signed): return bits // 8
            Float(bits): return bits // 8
            Bool: return 1
            Ptr: return self.rules.pointer_size
            BufferOwner: return self.rules.pointer_size
            List(element): return self.rules.pointer_size
            Slice(element): return self.rules.pointer_size
            Class(identity): return self.rules.pointer_size
            WeakClass(identity): return self.rules.pointer_size
            Interface(identity): return self.rules.pointer_size
            Cell(element): return self.rules.pointer_size
            Struct(fields):
                var offset = 0
                var aggregate_align = 1
                for field in fields:
                    let field_align = self.align_of(field.value_type)
                    offset = align_up(offset, field_align)
                    offset += self.size_of(field.value_type)
                    if field_align > aggregate_align: aggregate_align = field_align
                return align_up(offset, aggregate_align)
            Array(element, count): return self.size_of(element) * count
            Enum(tag, cases):
                var aggregate_align = self.align_of(tag)
                var payload_size = 0
                for case_type in cases:
                    let case_align = self.align_of(case_type)
                    if case_align > aggregate_align: aggregate_align = case_align
                    let case_size = self.size_of(case_type)
                    if case_size > payload_size: payload_size = case_size
                let payload = align_up(self.size_of(tag), aggregate_align)
                return align_up(payload + payload_size, aggregate_align)
            Func(signature): return self.rules.pointer_size * 2

    func compute_align(id: TypeId) -> i64:
        match mir_type(self.types, id):
            Int(bits, is_signed): return bits // 8
            Float(bits): return bits // 8
            Bool: return 1
            Ptr: return self.rules.pointer_align
            BufferOwner: return self.rules.pointer_align
            List(element): return self.rules.pointer_align
            Slice(element): return self.rules.pointer_align
            Class(identity): return self.rules.pointer_align
            WeakClass(identity): return self.rules.pointer_align
            Interface(identity): return self.rules.pointer_align
            Cell(element): return self.rules.pointer_align
            Struct(fields):
                var aggregate_align = 1
                for field in fields:
                    let field_align = self.align_of(field.value_type)
                    if field_align > aggregate_align: aggregate_align = field_align
                return aggregate_align
            Array(element, count): return self.align_of(element)
            Enum(tag, cases):
                var aggregate_align = self.align_of(tag)
                for case_type in cases:
                    let case_align = self.align_of(case_type)
                    if case_align > aggregate_align: aggregate_align = case_align
                return aggregate_align
            Func(signature): return self.rules.pointer_align

# mark: Alignment =============================================================================

## Round `value` up to a multiple of `alignment`.
pub func align_up(value: i64, alignment: i64) -> i64:
    if alignment <= 1: return value
    return (value + alignment - 1) // alignment * alignment
