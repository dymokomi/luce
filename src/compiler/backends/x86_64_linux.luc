#==============================================================================================
#
#   x86_64_linux - Canonical MIR into a Linux executable
#
#   DESCRIPTION:
#       A direct x86-64 Linux executable encoder, the native counterpart to the
#       Apple-silicon slice. It writes x86-64 instructions and the complete
#       static ELF container itself; the command-line driver only marks the
#       finished bytes executable, since Linux needs neither a signature nor a
#       dynamic loader here.
#
#       Read the file in the order `emit` works: `find_executable_entry`
#       picks `main`, `layout_data` places every constant data item right
#       after the headers (so its absolute address is known before any
#       instruction is written), `emit_code` turns the entry's MIR into
#       machine code through the encoders under "x86-64 encoding", and the
#       "ELF encoding" section wraps everything in one read-execute segment.
#
#       MIR registers live in fixed 8-byte frame slots below `rsp`; every
#       instruction loads its operands into rax/rcx, computes, and stores the
#       result back. Integer arithmetic is checked: an overflow reaches `ud2`
#       and the process dies with SIGILL, which is what the language means by
#       "traps".
#
#==============================================================================================

from compiler.backend import ArtifactBackend
from compiler.canonical_ir import BinaryOp, BuiltinMirType, InstructionForm, MirConstant, MirData, MirFunction
from compiler.canonical_ir import MirInstruction, register_at, MirProgram, RegisterId, TypeId, align_up, builtin_mir_type
from compiler.executable import find_executable_entry
import std.strings

# mark: ELF and x86-64 names ==================================================================

let elf_class_64: i64 = 2
let elf_data_lsb: i64 = 1
let elf_version: i64 = 1
let elf_type_exec: i64 = 2
let elf_machine_x86_64: i64 = 62

let program_load: i64 = 1
let program_flags_rx: i64 = 5
let program_align: i64 = 0x1000

let elf_header_size: i64 = 64
let program_header_size: i64 = 56
let base_address: i64 = 0x400000
let data_offset: i64 = elf_header_size + program_header_size   # data, then code, follow the headers

# System V AMD64 syscall numbers and the registers each one reads.
let syscall_write: i64 = 1
let syscall_exit: i64 = 60
let stdout: i64 = 1

let reg_rax: i64 = 0
let reg_rcx: i64 = 1
let reg_rdx: i64 = 2
let reg_rsi: i64 = 6
let reg_rdi: i64 = 7

# Each MIR register owns an 8-byte slot below rsp; the frame is rounded to
# 16 bytes so the stack stays aligned as the ABI requires.
let slot_size: i64 = 8

# Two-operand ALU opcodes in the `op r/m, r` form; the ModRM byte 0xC8 then
# selects `rax, rcx` (mod 11, reg rcx, r/m rax).
let opcode_add: i64 = 0x01               # add r/m, r
let opcode_sub: i64 = 0x29               # sub r/m, r
let modrm_rax_rcx: i64 = 0xC8
let modrm_rcx_into_rax: i64 = 0xC1       # for `imul r, r/m`: reg rax, r/m rcx
let rex_w: i64 = 0x48                    # 64-bit operand size prefix
let opcode_jno_short: i64 = 0x71         # jno rel8
let ud2_first: i64 = 0x0F                # ud2 — the overflow trap
let ud2_second: i64 = 0x0B

# mark: The encoder ===========================================================================

pub class X86_64LinuxBackend: ArtifactBackend:
    pub init():
        # Stateless; Stage-0 requires one statement in an empty init.
        return

    ## Encode one canonical program as the bytes of a complete ELF executable.
    pub func emit(program: MirProgram) -> list[u8]!:
        let entry = try find_executable_entry(program)
        let data = try layout_data(program)
        let entry_offset = data_offset + len(data.packed)
        let code = try emit_code(program, entry, data)

        let output = list[u8]()
        let file_size = entry_offset + len(code)
        append_elf_header(output, entry_offset)
        append_program_header(output, file_size)
        append_all(output, data.packed)
        append_all(output, code)
        return output

# mark: Data layout ===========================================================================

# Every `MirData` item packed right after the headers, each at its
# alignment, plus the absolute address of each. Placing data before code
# means an instruction can carry a data address as a plain immediate.
struct PlacedData:
    let packed: list[u8]
    let addresses: list[i64]

func layout_data(program: MirProgram) -> PlacedData!:
    let packed = list[u8]()
    let addresses = list[i64]()
    for item in program.data:
        if len(item.relocations) > 0:
            error("x86_64-linux backend does not support data relocations yet (`" + item.name + "`)")
        while (data_offset + len(packed)) % item.align != 0: packed.append(0)
        addresses.append(base_address + data_offset + len(packed))
        append_all(packed, item.bytes)
    return PlacedData(packed = packed, addresses = addresses)

# mark: Code emission =========================================================================

# Only the entry function is emitted in this slice, and only the straight-line
# instructions the lowerer produces today; every other form fails by name.
func emit_code(program: MirProgram, function: MirFunction, data: PlacedData) -> list[u8]!:
    let frame = align_up(len(function.registers) * slot_size, 16)
    let code = list[u8]()
    if frame > 0: append_sub_rsp(code, frame)
    let i64_type = builtin_mir_type(BuiltinMirType.signed_i64)

    for instruction in function.body:
        match instruction.form:
            Const(result, value):
                match value:
                    Int(item): append_load_immediate(code, reg_rax, item)
                    Null: append_load_immediate(code, reg_rax, 0)
                    Bool(item):
                        if item: append_load_immediate(code, reg_rax, 1)
                        else: append_load_immediate(code, reg_rax, 0)
                    else: error("x86_64-linux backend does not support float constants yet in `" + function.name + "`")
                append_store_slot(code, reg_rax, result)
            Binary(result, operation, left, right):
                append_load_slot(code, reg_rax, left)
                append_load_slot(code, reg_rcx, right)
                let wide = function.registers[left.value].value == i64_type.value
                if operation == BinaryOp.add:
                    append_alu(code, opcode_add, wide)
                elif operation == BinaryOp.sub:
                    append_alu(code, opcode_sub, wide)
                elif operation == BinaryOp.mul:
                    append_multiply(code, wide)
                else:
                    error("x86_64-linux backend does not support `" + str(operation) + "` yet in `" + function.name + "`")
                append_overflow_trap(code)
                append_store_slot(code, reg_rax, result)
            DataAddress(result, item):
                append_load_immediate(code, reg_rax, data.addresses[item.value])
                append_store_slot(code, reg_rax, result)
            CallExtern(results, external, arguments):
                let name = program.externs[external.value].name
                if name != "luce_rt_write":
                    error("x86_64-linux backend does not support extern `" + name + "` yet")
                # write(stdout, pointer, length): rax = 1, rdi = 1, rsi = bytes, rdx = length.
                append_load_immediate(code, reg_rax, syscall_write)
                append_load_immediate(code, reg_rdi, stdout)
                append_load_slot(code, reg_rsi, register_at(function, arguments, 0))
                append_load_slot(code, reg_rdx, register_at(function, arguments, 1))
                append_syscall(code)
            Return(values):
                # The entry function's return is the process exit status:
                # rdi = value, then the `exit` system call.
                append_load_slot(code, reg_rdi, register_at(function, values, 0))
                append_load_immediate(code, reg_rax, syscall_exit)
                append_syscall(code)
            else:
                error("x86_64-linux backend does not support `" + str(instruction.form) + "` yet in `" + function.name + "`")
    return code

# `add rax, rcx` / `sub rax, rcx`. i32 omits the REX.W prefix so the 32-bit
# form runs, sets OF for 32-bit overflow, and clears the high half of rax.
func append_alu(code: list[u8], opcode: i64, wide: bool):
    if wide: code.append(u8(rex_w))
    code.append(u8(opcode))
    code.append(u8(modrm_rax_rcx))

# `imul rax, rcx` / `imul eax, ecx` — the two-byte opcode 0F AF; the
# two-operand form sets OF when the signed product does not fit.
func append_multiply(code: list[u8], wide: bool):
    if wide: code.append(u8(rex_w))
    code.append(0x0F)
    code.append(0xAF)
    code.append(u8(modrm_rcx_into_rax))

# `jno +2` steps over `ud2` when the last arithmetic did not overflow;
# otherwise the undefined instruction fires and the process dies with SIGILL.
func append_overflow_trap(code: list[u8]):
    code.append(u8(opcode_jno_short))
    code.append(0x02)
    code.append(u8(ud2_first))
    code.append(u8(ud2_second))

# mark: x86-64 encoding =======================================================================

# `mov register, imm64` — REX.W prefix, then 0xB8 plus the register number.
func append_load_immediate(code: list[u8], register: i64, value: i64):
    code.append(u8(rex_w))
    code.append(u8(0xB8 + register))
    append_u64(code, value)

# `sub rsp, imm32` — REX.W 81 /5.
func append_sub_rsp(code: list[u8], amount: i64):
    code.append(u8(rex_w))
    code.append(0x81)
    code.append(0xEC)
    append_u32(code, amount)

# `mov [rsp + slot * 8], register` — REX.W 89 with ModRM mod 10, r/m 100
# (SIB follows), the SIB 0x24 selecting rsp with no index, then disp32.
func append_store_slot(code: list[u8], register: i64, target: RegisterId):
    code.append(u8(rex_w))
    code.append(0x89)
    code.append(u8(0x84 | register << 3))
    code.append(0x24)
    append_u32(code, i64(target.value) * slot_size)

# `mov register, [rsp + slot * 8]` — REX.W 8B, same addressing form.
func append_load_slot(code: list[u8], register: i64, source: RegisterId):
    code.append(u8(rex_w))
    code.append(0x8B)
    code.append(u8(0x84 | register << 3))
    code.append(0x24)
    append_u32(code, i64(source.value) * slot_size)

# `syscall` — number in rax, arguments in rdi, rsi, rdx.
func append_syscall(code: list[u8]):
    code.append(0x0F)
    code.append(0x05)

# mark: ELF encoding ==========================================================================

func append_elf_header(output: list[u8], entry_offset: i64):
    output.append(0x7F)
    output.append(u8('E'))
    output.append(u8('L'))
    output.append(u8('F'))
    output.append(u8(elf_class_64))
    output.append(u8(elf_data_lsb))
    output.append(u8(elf_version))
    # e_ident is 16 bytes: seven are set above, the rest (OS ABI, ABI version,
    # and padding) stay zero.
    for pad in range(7, 16): output.append(0)
    append_u16(output, elf_type_exec)                  # e_type
    append_u16(output, elf_machine_x86_64)             # e_machine
    append_u32(output, elf_version)                    # e_version
    append_u64(output, base_address + entry_offset)    # e_entry: first byte of code
    append_u64(output, elf_header_size)                # e_phoff: program headers follow this header
    append_u64(output, 0)                              # e_shoff: no section headers
    append_u32(output, 0)                              # e_flags
    append_u16(output, elf_header_size)                # e_ehsize
    append_u16(output, program_header_size)            # e_phentsize
    append_u16(output, 1)                              # e_phnum
    append_u16(output, 0)                              # e_shentsize
    append_u16(output, 0)                              # e_shnum
    append_u16(output, 0)                              # e_shstrndx

# One load command maps the whole file, headers included, as a read-execute
# image at a fixed address; data and code both live inside it.
func append_program_header(output: list[u8], file_size: i64):
    append_u32(output, program_load)                   # p_type
    append_u32(output, program_flags_rx)               # p_flags: read + execute
    append_u64(output, 0)                              # p_offset: from the file's first byte
    append_u64(output, base_address)                   # p_vaddr
    append_u64(output, base_address)                   # p_paddr
    append_u64(output, file_size)                      # p_filesz
    append_u64(output, file_size)                      # p_memsz
    append_u64(output, program_align)                  # p_align

# mark: Byte plumbing =========================================================================

func append_u16(output: list[u8], value: i64):
    for shift in [0, 8]: output.append(u8(value >> shift & 0xFF))

func append_u32(output: list[u8], value: i64):
    for shift in [0, 8, 16, 24]: output.append(u8(value >> shift & 0xFF))

func append_u64(output: list[u8], value: i64):
    append_u32(output, value)
    append_u32(output, value >> 32)

func append_all(output: list[u8], values: list[u8]):
    for value in values: output.append(value)
