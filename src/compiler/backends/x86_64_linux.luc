#==============================================================================================
#
#   x86_64_linux - Canonical instructions into a Linux executable
#
#   DESCRIPTION:
#       A direct x86-64 Linux executable encoder, the native counterpart to the
#       Apple-silicon slice. It writes x86-64 instructions and the complete
#       static ELF container itself; the command-line driver only marks the
#       finished bytes executable, since Linux needs neither a signature nor a
#       dynamic loader here.
#
#==============================================================================================

from compiler.backend import ArtifactBackend
from compiler.canonical_ir import CanonicalFunction, CanonicalProgram, CanonicalType
from compiler.executable import find_executable_entry
import std.strings

# mark: ELF and x86-64 names ==================================================================

const elf_class_64: i64 = 2
const elf_data_lsb: i64 = 1
const elf_version: i64 = 1
const elf_type_exec: i64 = 2
const elf_machine_x86_64: i64 = 62

const program_load: i64 = 1
const program_flags_rx: i64 = 5
const program_align: i64 = 0x1000

const elf_header_size: i64 = 64
const program_header_size: i64 = 56
const base_address: i64 = 0x400000
const code_offset: i64 = elf_header_size + program_header_size

# System V AMD64 syscall numbers and the registers each one reads.
const syscall_write: i64 = 1
const syscall_exit: i64 = 60
const stdout: i64 = 1

const reg_rax: i64 = 0
const reg_rdx: i64 = 2
const reg_rdi: i64 = 7
const push_rax: i64 = 0x50                 # push rax
const pop_rax: i64 = 0x58                  # pop rax
const pop_rcx: i64 = 0x59                  # pop rcx
const pop_rdi: i64 = 0x5F                  # pop rdi

# Two-operand ALU opcodes in the `op r/m, r` form; the ModRM byte 0xC8 then
# selects `rax, rcx` (mod 11, reg rcx, r/m rax).
const opcode_add: i64 = 0x01               # add r/m, r
const opcode_sub: i64 = 0x29               # sub r/m, r
const modrm_rax_rcx: i64 = 0xC8
const modrm_rcx_into_rax: i64 = 0xC1       # for `imul r, r/m`: reg rax, r/m rcx
const rex_w: i64 = 0x48                    # 64-bit operand size prefix

# mark: The encoder ===========================================================================

pub class X86_64LinuxBackend: ArtifactBackend:
    pub init():
        # Stateless; Stage-0 requires one statement in an empty init.
        return

    ## Encode one canonical program as the bytes of a complete ELF executable.
    pub func emit(program: CanonicalProgram) -> list[u8]!:
        let entry = try find_executable_entry(program)
        let code = try emit_code(entry)

        let output = list[u8]()
        let file_size = code_offset + len(code)
        append_elf_header(output)
        append_program_header(output, file_size)
        append_all(output, code)
        return output

# mark: Code emission =========================================================================

# Values live on the machine stack in native 8-byte slots, which keeps the
# stack aligned without a register allocator. Constant strings sit inline behind
# a jump, reached by a RIP-relative address, so neither an assembler nor a
# relocation table is needed for this first slice.
#
# The stack-depth and `Return` checks re-prove invariants `MirVerifier` has
# already established; they are defensive, so a verifier gap can never emit
# a malformed executable silently.
func emit_code(function: CanonicalFunction) -> list[u8]!:
    let code = list[u8]()
    var stack_depth = 0
    var returned = false
    for instruction in function.instructions:
        if returned: error("x86_64-linux backend: instruction follows `Return` in `" + function.name + "`")
        match instruction:
            Constant(value, value_type):
                append_load_immediate(code, reg_rax, value)
                code.append(u8(push_rax))
                stack_depth += 1
            Add(operand_type):
                append_binary(code, opcode_add, operand_type)
                stack_depth -= 1
            Subtract(operand_type):
                append_binary(code, opcode_sub, operand_type)
                stack_depth -= 1
            Multiply(operand_type):
                append_multiply(code, operand_type)
                stack_depth -= 1
            WriteText(value): try append_print(code, value)
            Return:
                # Pop the value into rdi and make the `exit` system call; the
                # entry function's return is the process exit status.
                if stack_depth != 1: error("x86_64-linux backend: `Return` needs one value in `" + function.name + "`")
                code.append(u8(pop_rdi))
                append_load_immediate(code, reg_rax, syscall_exit)
                append_syscall(code)
                stack_depth = 0
                returned = true
    if not returned: error("x86_64-linux backend: `" + function.name + "` has no `Return`")
    return code

# A `write(stdout, text, length)` system call whose text lives inline right
# behind a jump that steps over it.
func append_print(code: list[u8], text: str) -> !:
    let encoded = strings.to_bytes(text + "\n")
    if len(encoded) > 0x7FFFFFFF: error("x86_64-linux backend: one `print` is limited to 2147483647 UTF-8 bytes")

    append_load_immediate(code, reg_rax, syscall_write)
    append_load_immediate(code, reg_rdi, stdout)
    append_load_immediate(code, reg_rdx, len(encoded))
    # The text begins right after the `syscall` and the `jmp` that steps over
    # it: two bytes plus five, so it is seven bytes past this instruction.
    append_lea_rsi_relative(code, 7)
    append_syscall(code)
    append_jump(code, len(encoded))
    append_all(code, encoded)

# Pop right into rcx and left into rax, then `add rax, rcx` / `sub rax, rcx`.
# i32 omits the REX.W prefix so the 32-bit form runs and the hardware clears
# the high half of rax.
func append_binary(code: list[u8], opcode: i64, operand_type: CanonicalType):
    code.append(u8(pop_rcx))
    code.append(u8(pop_rax))
    if operand_type == CanonicalType.signed_i64: code.append(u8(rex_w))
    code.append(u8(opcode))
    code.append(u8(modrm_rax_rcx))
    code.append(u8(push_rax))

# `imul rax, rcx` / `imul eax, ecx` — the two-byte opcode 0F AF.
func append_multiply(code: list[u8], operand_type: CanonicalType):
    code.append(u8(pop_rcx))
    code.append(u8(pop_rax))
    if operand_type == CanonicalType.signed_i64: code.append(u8(rex_w))
    code.append(0x0F)
    code.append(0xAF)
    code.append(u8(modrm_rcx_into_rax))
    code.append(u8(push_rax))

# mark: x86-64 encoding =======================================================================

# `mov register, imm64` — REX.W prefix, then 0xB8 plus the register number.
func append_load_immediate(code: list[u8], register: i64, value: i64):
    code.append(u8(rex_w))
    code.append(u8(0xB8 + register))
    append_u64(code, value)

# `lea rsi, [rip + displacement]`
func append_lea_rsi_relative(code: list[u8], displacement: i64):
    code.append(u8(rex_w))
    code.append(0x8D)
    code.append(0x35)
    append_u32(code, displacement)

# `jmp` with a 32-bit relative target.
func append_jump(code: list[u8], relative: i64):
    code.append(0xE9)
    append_u32(code, relative)

# `syscall` — number in rax, arguments in rdi, rsi, rdx.
func append_syscall(code: list[u8]):
    code.append(0x0F)
    code.append(0x05)

# mark: ELF encoding ==========================================================================

func append_elf_header(output: list[u8]):
    output.append(0x7F)
    output.append(u8('E'))
    output.append(u8('L'))
    output.append(u8('F'))
    output.append(u8(elf_class_64))
    output.append(u8(elf_data_lsb))
    output.append(u8(elf_version))
    # e_ident is 16 bytes: seven are set above, the rest (OS ABI, ABI version,
    # and padding) stay zero.
    for pad in range(7, 16): output.append(0)
    append_u16(output, elf_type_exec)                  # e_type
    append_u16(output, elf_machine_x86_64)             # e_machine
    append_u32(output, elf_version)                    # e_version
    append_u64(output, base_address + code_offset)     # e_entry: first byte of code
    append_u64(output, elf_header_size)                # e_phoff: program headers follow this header
    append_u64(output, 0)                              # e_shoff: no section headers
    append_u32(output, 0)                              # e_flags
    append_u16(output, elf_header_size)                # e_ehsize
    append_u16(output, program_header_size)            # e_phentsize
    append_u16(output, 1)                              # e_phnum
    append_u16(output, 0)                              # e_shentsize
    append_u16(output, 0)                              # e_shnum
    append_u16(output, 0)                              # e_shstrndx

# One load command maps the whole file, headers included, as a read-execute
# image at a fixed address; the entry point is the first byte of code.
func append_program_header(output: list[u8], file_size: i64):
    append_u32(output, program_load)                   # p_type
    append_u32(output, program_flags_rx)               # p_flags: read + execute
    append_u64(output, 0)                              # p_offset: from the file's first byte
    append_u64(output, base_address)                   # p_vaddr
    append_u64(output, base_address)                   # p_paddr
    append_u64(output, file_size)                      # p_filesz
    append_u64(output, file_size)                      # p_memsz
    append_u64(output, program_align)                  # p_align

# mark: Byte plumbing =========================================================================

func append_u16(output: list[u8], value: i64):
    for shift in [0, 8]: output.append(u8(value >> shift & 0xFF))

func append_u32(output: list[u8], value: i64):
    for shift in [0, 8, 16, 24]: output.append(u8(value >> shift & 0xFF))

func append_u64(output: list[u8], value: i64):
    append_u32(output, value)
    append_u32(output, value >> 32)

func append_all(output: list[u8], values: list[u8]):
    for value in values: output.append(value)
