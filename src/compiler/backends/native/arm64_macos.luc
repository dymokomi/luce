#==============================================================================================
#
#   arm64_macos - Canonical MIR into an Apple-silicon executable
#
#   DESCRIPTION:
#       A direct Apple-silicon executable encoder for the native slice. It
#       writes ARM64 instructions and the complete unsigned Mach-O container
#       itself; the command-line driver applies the host-required ad-hoc
#       signature after the bytes reach their final path.
#
#       NOTE: macOS refuses to load an unsigned arm64 binary, so the raw bytes
#       from `emit` will not run until `codesign` has touched the file.
#
#       Read the file in the order `emit` works: `find_executable_entry`
#       picks `main`, `layout_data` places every constant data item at the
#       start of the code page (so its absolute address is known before any
#       instruction is written), `emit_code` turns the entry's MIR into
#       machine words through the small encoders under "ARM64 encoding", and
#       the "Mach-O encoding" section wraps everything in the container. Even
#       a 20-byte program needs eight load commands because dyld will not
#       start an image without a page-zero guard, a text segment, an (empty)
#       link-edit segment, dyld-info, the dynamic linker path, a platform
#       version, an entry point, and at least one linked library.
#
#       MIR registers live in fixed 16-byte frame slots below `sp`; every
#       instruction loads its operands into x0/x1, computes, and stores the
#       result back. Integer arithmetic is checked: an overflow reaches a
#       `brk #0` and the process dies with SIGTRAP, which is what the
#       language means by "traps".
#
#==============================================================================================

from compiler.backend import ArtifactBackend
from compiler.backends.layout import align_up
from compiler.mir.canonical import BinaryOp, BuiltinMirType, InstructionForm, MirConstant, MirData, MirFunction
from compiler.mir.canonical import MirInstruction, register_at, MirProgram, RegisterId, TypeId, builtin_mir_type
from compiler.executable import find_executable_entry
import std.strings

# mark: Mach-O and ARM64 names ================================================================

let mach_header_64: i64 = 0xFEEDFACF
let cpu_type_arm64: i64 = 0x0100000C
let mach_execute: i64 = 0x02
let executable_flags: i64 = 0x00200085

let load_segment_64: i64 = 0x19
let load_dyld_info_only: i64 = 0x80000022
let load_dylinker: i64 = 0x0E
let load_build_version: i64 = 0x32
let load_main: i64 = 0x80000028
let load_dylib: i64 = 0x0C

let text_address: i64 = 0x100000000     # where __TEXT is mapped
let code_offset: i64 = 0x1000            # data, then code, begin one 4 KiB header page in
let page_size: i64 = 0x4000              # Apple silicon uses 16 KiB pages

# Darwin system-call numbers and the registers each one reads: the number
# goes in x16, arguments in x0-x2.
let syscall_exit: i64 = 1
let syscall_write: i64 = 4
let stdout: i64 = 1
let reg_x0: i64 = 0
let reg_x1: i64 = 1
let reg_x2: i64 = 2
let reg_syscall_x16: i64 = 16
let reg_sp: i64 = 31

# Each MIR register owns a 16-byte slot, keeping `sp` 16-byte aligned as the
# ABI requires without a register allocator. `sub sp` takes a 12-bit
# immediate, which bounds the frame.
let slot_size: i64 = 16
let frame_limit: i64 = 4080

# `LC_MAIN.stacksize`: the initial stack macOS gives the main thread, or the
# 8 MiB default when zero. Zero is wrong for the program we most care about
# emitting — this compiler, once it compiles itself — because its HIR
# interpreter spends about 32 KiB of stack per interpreted call, so 8 MiB
# would hold roughly 256 of them and the oracle would run out before any
# test did. 64 MiB sits above the 46 MiB Zig gives its own compiler, and is
# a reservation of address space rather than of memory: untouched pages
# cost nothing. It is deliberately not Stage-0's 512 MiB, which the Linux
# and Windows paths we still have to emit for cannot honour.
let stack_reserve: i64 = 67108864            # 64 MiB

# Pre-encoded instruction words, each with its assembly spelling.
let supervisor_call: i64 = 0xD4001001    # svc #0x80
let breakpoint: i64 = 0xD4200000         # brk #0 — the overflow trap
let adr_base: i64 = 0x10000000           # adr xD, #imm21
let sub_sp_base: i64 = 0xD10003FF        # sub sp, sp, #imm12
let str_x_base: i64 = 0xF9000000         # str xT, [xN, #imm12 * 8]
let ldr_x_base: i64 = 0xF9400000         # ldr xT, [xN, #imm12 * 8]
let adds_x0_x1: i64 = 0xAB010000         # adds x0, x0, x1
let adds_w0_w1: i64 = 0x2B010000         # adds w0, w0, w1
let subs_x0_x1: i64 = 0xEB010000         # subs x0, x0, x1
let subs_w0_w1: i64 = 0x6B010000         # subs w0, w0, w1
let mul_x0_x1: i64 = 0x9B017C00          # mul x0, x0, x1
let smulh_x2_x0_x1: i64 = 0x9B417C02     # smulh x2, x0, x1 (high 64 bits of the product)
let smull_x0_w0_w1: i64 = 0x9B217C00     # smull x0, w0, w1 (full 64-bit product of two i32)
let cmp_x2_x0_asr_63: i64 = 0xEB80FC5F   # cmp x2, x0, asr #63
let cmp_x0_w0_sxtw: i64 = 0xEB20C01F     # cmp x0, w0, sxtw
let branch_vc_skip: i64 = 0x54000047     # b.vc #+8 (over the brk)
let branch_eq_skip: i64 = 0x54000040     # b.eq #+8 (over the brk)
let movz_base: i64 = 0xD2800000          # movz xN, #imm16
let movk_shift_16: i64 = 0xF2A00000      # movk xN, #imm16, lsl #16
let movk_shift_32: i64 = 0xF2C00000      # movk xN, #imm16, lsl #32
let movk_shift_48: i64 = 0xF2E00000      # movk xN, #imm16, lsl #48

# mark: The encoder ===========================================================================

pub class Arm64MacosBackend: ArtifactBackend:
    pub init():
        # Stateless; Stage-0 requires one statement in an empty init.
        return

    ## Encode one canonical program as the bytes of a complete Mach-O executable.
    pub func emit(program: MirProgram) -> list[u8]!:
        let entry = try find_executable_entry(program)
        let data = try layout_data(program)
        let entry_offset = code_offset + len(data.packed)
        let code = try emit_code(program, entry, data)
        if entry_offset + len(code) > page_size:
            error("arm64-macos backend: the executable slice is limited to one 16 KiB page")

        let output = list[u8]()
        append_mach_header(output)
        append_segment(output, "__PAGEZERO", 0, text_address, 0, 0, 0)
        append_segment(output, "__TEXT", text_address, page_size, 0, page_size, 5)
        append_segment(output, "__LINKEDIT", text_address + page_size, 0, page_size, 0, 1)
        append_dyld_info(output)
        append_dylinker(output)
        append_build_version(output)
        append_main(output, entry_offset)
        append_system_library(output)
        pad_to(output, code_offset)
        append_all(output, data.packed)
        append_all(output, code)
        pad_to(output, page_size)
        return output

# mark: Data layout ===========================================================================

# Every `MirData` item packed at the start of the code page, each at its
# alignment, plus each item's file offset. The image is position-independent
# (dyld slides it), so code reaches data with a PC-relative `adr`, never an
# absolute address; placing data before code keeps every offset known while
# the instructions are written.
struct PlacedData:
    let packed: list[u8]
    let offsets: list[i64]

func layout_data(program: MirProgram) -> PlacedData!:
    let packed = list[u8]()
    let offsets = list[i64]()
    for item in program.data:
        while len(packed) % item.align != 0: packed.append(0)
        offsets.append(code_offset + len(packed))
        append_all(packed, item.bytes)
    # Code must start on a 4-byte instruction boundary.
    while len(packed) % 4 != 0: packed.append(0)
    return PlacedData(packed = packed, offsets = offsets)

# mark: Code emission =========================================================================

# Only the entry function is emitted in this slice, and only the straight-line
# instructions the lowerer produces today; every other form fails by name.
func emit_code(program: MirProgram, function: MirFunction, data: PlacedData) -> list[u8]!:
    let frame = align_up(len(function.registers) * slot_size, 16)
    if frame > frame_limit:
        error("arm64-macos backend: `" + function.name + "` uses more than " + str(frame_limit // slot_size) + " registers")
    let code = list[u8]()
    if frame > 0: append_word(code, sub_sp_base | frame << 10)   # sub sp, sp, #frame
    let i64_type = builtin_mir_type(BuiltinMirType.signed_i64)

    for instruction in function.body:
        match instruction.form:
            Const(result, value):
                match value:
                    Int(item): append_move_wide(code, reg_x0, item)
                    Null: append_move_wide(code, reg_x0, 0)
                    Bool(item):
                        if item: append_move_wide(code, reg_x0, 1)
                        else: append_move_wide(code, reg_x0, 0)
                    else: error("arm64-macos backend does not support float constants yet in `" + function.name + "`")
                append_store(code, reg_x0, result)
            Binary(result, operation, left, right):
                append_load(code, reg_x0, left)
                append_load(code, reg_x1, right)
                let wide = function.registers[left.value].value == i64_type.value
                if operation == BinaryOp.add:
                    if wide: append_word(code, adds_x0_x1)
                    else: append_word(code, adds_w0_w1)
                    append_overflow_trap(code)
                elif operation == BinaryOp.sub:
                    if wide: append_word(code, subs_x0_x1)
                    else: append_word(code, subs_w0_w1)
                    append_overflow_trap(code)
                elif operation == BinaryOp.mul:
                    append_checked_multiply(code, wide)
                else:
                    error("arm64-macos backend does not support `" + str(operation) + "` yet in `" + function.name + "`")
                append_store(code, reg_x0, result)
            DataAddress(result, item):
                # `adr` measures from this instruction, which sits at
                # `entry_offset + len(code)` in the file.
                let here = code_offset + len(data.packed) + len(code)
                append_adr(code, reg_x0, data.offsets[item.value] - here)
                append_store(code, reg_x0, result)
            CallExtern(results, external, arguments):
                let name = program.externs[external.value].name
                if name != "luce_rt_write":
                    error("arm64-macos backend does not support extern `" + name + "` yet")
                # write(stdout, pointer, length): x0 = 1, x1 = bytes, x2 = length.
                append_load(code, reg_x1, register_at(function, arguments, 0))
                append_load(code, reg_x2, register_at(function, arguments, 1))
                append_move(code, reg_x0, stdout)
                append_move(code, reg_syscall_x16, syscall_write)
                append_word(code, supervisor_call)
            Return(values):
                # The entry function's return is the process exit status:
                # x0 = value, then the `exit` system call.
                append_load(code, reg_x0, register_at(function, values, 0))
                append_move(code, reg_syscall_x16, syscall_exit)
                append_word(code, supervisor_call)
            else:
                error("arm64-macos backend does not support `" + str(instruction.form) + "` yet in `" + function.name + "`")
    return code

# `b.vc` steps over the `brk` when the last flag-setting operation did not
# overflow; otherwise the breakpoint fires and the process dies with SIGTRAP.
func append_overflow_trap(code: list[u8]):
    append_word(code, branch_vc_skip)
    append_word(code, breakpoint)

# Multiplication sets no overflow flag, so the check compares against the
# full product. i64: `smulh` yields the high 64 bits of the 128-bit product,
# which must equal the sign extension of the low 64 (`x0 asr #63`). i32:
# `smull` yields the exact 64-bit product, which must equal its own low 32
# bits sign-extended (`w0 sxtw`).
func append_checked_multiply(code: list[u8], wide: bool):
    if wide:
        append_word(code, smulh_x2_x0_x1)
        append_word(code, mul_x0_x1)
        append_word(code, cmp_x2_x0_asr_63)
    else:
        append_word(code, smull_x0_w0_w1)
        append_word(code, cmp_x0_w0_sxtw)
    append_word(code, branch_eq_skip)
    append_word(code, breakpoint)

# mark: ARM64 encoding ========================================================================

# `movz register, #value` — load one 16-bit immediate, zeroing the rest.
func append_move(output: list[u8], register: i64, value: i64):
    append_word(output, movz_base | (value & 0xFFFF) << 5 | register)

# Load a full 64-bit pattern: `movz` sets the low 16 bits and each `movk`
# inserts the next 16 while keeping the rest.
func append_move_wide(output: list[u8], register: i64, value: i64):
    append_move(output, register, value & 0xFFFF)
    append_word(output, movk_shift_16 | ((value >> 16) & 0xFFFF) << 5 | register)
    append_word(output, movk_shift_32 | ((value >> 32) & 0xFFFF) << 5 | register)
    append_word(output, movk_shift_48 | ((value >> 48) & 0xFFFF) << 5 | register)

# `adr xD, #offset` — a PC-relative address; the 21-bit signed offset is
# split into immlo (bits 30:29) and immhi (bits 23:5).
func append_adr(output: list[u8], register: i64, offset: i64):
    let immediate = offset & 0x1FFFFF
    append_word(output, adr_base | (immediate & 3) << 29 | (immediate >> 2) << 5 | register)

# `str xT, [sp, #slot * 16]` — the immediate is scaled by 8.
func append_store(output: list[u8], register: i64, target: RegisterId):
    append_word(output, str_x_base | (i64(target.value) * slot_size // 8) << 10 | reg_sp << 5 | register)

# `ldr xT, [sp, #slot * 16]`
func append_load(output: list[u8], register: i64, source: RegisterId):
    append_word(output, ldr_x_base | (i64(source.value) * slot_size // 8) << 10 | reg_sp << 5 | register)

# ARM64 instructions are fixed 32-bit little-endian words.
func append_word(output: list[u8], value: i64):
    append_u32(output, value)

# mark: Mach-O encoding =======================================================================

# The eight load commands that follow total 400 bytes:
# 3 segments (72 each) + dyld-info 48 + dylinker 32 + build-version 24
# + main 24 + dylib 56.
let load_command_count: i64 = 8
let load_commands_size: i64 = 216 + 48 + 32 + 24 + 24 + 56

func append_mach_header(output: list[u8]):
    append_u32(output, mach_header_64)          # magic
    append_u32(output, cpu_type_arm64)          # cputype
    append_u32(output, 0)                       # cpusubtype: all
    append_u32(output, mach_execute)            # filetype
    append_u32(output, load_command_count)      # ncmds
    append_u32(output, load_commands_size)      # sizeofcmds
    append_u32(output, executable_flags)        # flags: NOUNDEFS, DYLDLINK, TWOLEVEL, PIE
    append_u32(output, 0)                       # reserved

# `protection` is a VM_PROT mask: 1 read, 2 write, 4 execute.
func append_segment(output: list[u8], name: str, address: i64, memory_size: i64, file_offset: i64, file_size: i64, protection: i64):
    append_u32(output, load_segment_64)
    append_u32(output, 72)                      # cmdsize
    append_fixed(output, name, 16)              # segname
    append_u64(output, address)                 # vmaddr
    append_u64(output, memory_size)             # vmsize
    append_u64(output, file_offset)             # fileoff
    append_u64(output, file_size)               # filesize
    append_u32(output, protection)              # maxprot
    append_u32(output, protection)              # initprot
    append_u32(output, 0)                       # nsects
    append_u32(output, 0)                       # flags

# An explicit empty dyld-info command prevents modern dyld from falling back
# to the legacy relocation tables that this relocation-free image omits.
func append_dyld_info(output: list[u8]):
    append_u32(output, load_dyld_info_only)
    append_u32(output, 48)                      # cmdsize
    for field in range(0, 10): append_u32(output, 0)  # five (offset, size) pairs, all empty

func append_dylinker(output: list[u8]):
    append_u32(output, load_dylinker)
    append_u32(output, 32)                      # cmdsize
    append_u32(output, 12)                      # name offset within the command
    append_fixed(output, "/usr/lib/dyld", 20)   # path, padded to the cmdsize

func append_build_version(output: list[u8]):
    append_u32(output, load_build_version)
    append_u32(output, 24)                      # cmdsize
    append_u32(output, 1)                       # platform: macOS
    append_u32(output, 0x000B0000)              # minos: 11.0 (xxxx.yy.zz packed)
    append_u32(output, 0)                       # sdk: unspecified
    append_u32(output, 0)                       # ntools

func append_main(output: list[u8], entry_offset: i64):
    append_u32(output, load_main)
    append_u32(output, 24)                      # cmdsize
    append_u64(output, entry_offset)            # entryoff: file offset of the first instruction
    append_u64(output, stack_reserve)           # stacksize: see the constant

# dyld insists on at least one linked library; libSystem is the one every
# process has anyway.
func append_system_library(output: list[u8]):
    append_u32(output, load_dylib)
    append_u32(output, 56)                      # cmdsize
    append_u32(output, 24)                      # name offset within the command
    append_u32(output, 2)                       # timestamp
    append_u32(output, 0)                       # current_version
    append_u32(output, 0x00010000)              # compatibility_version: 1.0.0
    append_fixed(output, "/usr/lib/libSystem.B.dylib", 32)

# mark: Byte plumbing =========================================================================

# A fixed-width name field, zero-padded like Mach-O expects.
func append_fixed(output: list[u8], value: str, width: i64):
    let encoded = strings.to_bytes(value)
    for byte in encoded: output.append(byte)
    for unused in range(len(encoded), width): output.append(0)

func append_u32(output: list[u8], value: i64):
    for shift in [0, 8, 16, 24]: output.append(u8(value >> shift & 0xFF))

func append_u64(output: list[u8], value: i64):
    append_u32(output, value)
    append_u32(output, value >> 32)

func append_all(output: list[u8], values: list[u8]):
    for value in values: output.append(value)

func pad_to(output: list[u8], size: i64):
    while len(output) < size: output.append(0)
