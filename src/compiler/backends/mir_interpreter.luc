#==============================================================================================
#
#   mir_interpreter - Executes canonical MIR directly
#
#   DESCRIPTION:
#       The second oracle. The HIR interpreter defines what a program means;
#       this one executes the lowerer's output, so the two together locate a
#       defect in either the lowerer or a backend without any target runtime.
#       It is also the constant folder's engine: language section 7 requires
#       folding to use runtime semantics, and sharing this code makes that so.
#
#       Public use begins at `MirInterpreter.run`. Memory is one flat byte
#       array with a bump allocator that never frees (a test program is
#       short-lived); address 0 is reserved so a null pointer is 0. Data items
#       are copied in at load, globals get storage initialised from their
#       data, and every call frame allocates
#       its `Alloca` slots on entry. A function's address, for `FunctionAddress`
#       and `CallIndirect`, is `function_address_base + index`.
#
#       This is the MIR-oracle dispatch point of the profile layout (plan.md
#       §5.0): the runtime instructions and their handle tables live in
#       `profiles/full/backends/mir_execution.luc`, reached through the
#       `MirExecutionHost` services of `mir_execution_model.luc`.
#
#       Every integer operation is checked against the register's type before
#       the host computes it, so overflow, a zero divisor, `minimum // -1`, and
#       an out-of-range shift count trap here exactly as the language says
#       (section 7) and never reach Stage-0's own trap. An `f32` is carried in
#       an `f64` host slot only after every producing operation has rounded it
#       with Stage-0's real binary32 arithmetic. Floats in memory live in a
#       side table keyed by address because Stage-0 offers no float-to-bits
#       conversion; a `Load` of a float address never written reads 0.0.
#
#       The walk is: `run` -> `call` (one frame) -> `execute_body` -> one
#       instruction. Control flow returns a `Flow` value that regions consume.
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp
from compiler.mir.canonical import MirExtern, MirExternalGlobal, MirInstruction, MirProgram, MirSignature
from compiler.mir.canonical import RegisterId, RegisterRun, no_registers, register_at, TypeId, UnaryOp
from compiler.mir.canonical import builtin_mir_type, describe_mir_type, find_mir_extern, find_mir_function
from compiler.mir.canonical import is_bool_type, is_float_type, is_identity_type, is_int_type, is_ptr_type, is_reference_type
from compiler.mir.canonical import is_aggregate_type, is_pointer_int_type, is_signed_int_type, mir_type, signatures_match
from compiler.backends.wrapping import wrap_add_i64, wrap_add_u64, wrap_mul_i64, wrap_mul_u64, wrap_negate_i64, wrap_negate_u64, wrap_signed, wrap_sub_i64, wrap_sub_u64, wrap_unsigned
from compiler.backends.mir_execution_model import Frame, MirExecutionHost, MirValue, integer_from_width
from compiler.backends.mir_execution_model import bool_of, checked_multiply, evaluate_float_binary, float_of, host_count_of, host_integer_of, integer_from_low_bits, normalize_mir_float, ptr_of, semantic_pointer_hash, shift_left_unsigned, shift_left_within, signed_int_of, trap_overflow, unsigned_int_of
from compiler.backends.mir_execution_model import buffer_builder_address_base, buffer_owner_address_base, extern_address_base, function_address_base
from compiler.backends.mir_task_runtime import MirTransferredValue
from compiler.profiles.full.backends.mir_execution import FullProfileMirExecution
from compiler.backends.layout import LayoutRules, TypeLayout, align_up
from compiler.formatting.float_display import display_float32, display_float64
from compiler.formatting.ieee import ieee_float_bits
from compiler.reporting.resources import ResourceCensus, resource_census
import std.strings

# mark: Values and flow ========================================================================

## Explicit behavior for C-convention externs. Runtime services remain owned
## by the MIR oracle itself; source imports never consult the host process.
## An extern with output pointers writes through this narrow memory view; the
## interpreter retains ownership of layout, bounds, and value validation.
pub interface MirExternMemory:
    func store_external(address: MirValue, value_type: TypeId, value: MirValue) -> !
    func store_external_field(address: MirValue, aggregate_type: TypeId, field: i64, value: MirValue) -> !
    func load_external_field(address: MirValue, aggregate_type: TypeId, field: i64) -> MirValue!
    ## Allocate exact raw bytes in the oracle's foreign-memory view. Tests use
    ## this for returned C strings, including malformed UTF-8 and termination.
    func allocate_external_bytes(value: list[u8]) -> MirValue
    ## Read through the first NUL without exposing byte offsets or target
    ## layout to a semantic host. The terminator itself is not returned.
    func load_external_c_string(address: MirValue) -> list[u8]!
    ## Read one borrowed list argument as logical C-width elements. The MIR
    ## oracle may represent list slots independently; this view preserves the
    ## compiled runtime's dense order without exposing either representation.
    func load_external_list(address: MirValue, element_type: TypeId, count: u64) -> list[MirValue]!

pub interface MirExternHost:
    func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!

## An arbitrary C code pointer has no `MirExtern` identity. The exact verified
## signature accompanies the call while the host supplies only its behavior.
pub interface MirCFunctionPointerHost:
    func call(pointer: i64, signature: MirSignature, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!

pub interface MirExternalGlobalHost:
    func load(global: MirExternalGlobal) -> MirValue!
    func store(global: MirExternalGlobal, value: MirValue) -> !

# How a body finished: fell off its end, or left the function.
union Flow:
    Next
    Returned(values: list[MirValue])
    Raised(failure: i64)

# Where the parts of every region sit in a flat body, computed once per
# call: `end_of[i]` is the `End` matching an opener or arm separator at `i`,
# and `next_arm[i]` is the next `Else`/`Case`/`Default` of the same region.
struct RegionPlan:
    let end_of: list[i64]
    let next_arm: list[i64]

# One region control is currently inside. A branch to a loop returns to
# `start + 1`; a branch to anything else binds `results` and continues at
# `end + 1`.
struct RunRegion:
    let is_loop: bool
    let start: i64
    let end: i64
    let results: RegisterRun

# A float stored in memory; see the header for why these are not bytes.
struct FloatCell:
    let address: i64
    let value: f64

struct FreedStorage:
    let address: i64
    let size: i64

class MirImmutableBuffer:
    let data: i64
    let length: i64
    var references: i64
    var is_alive: bool

    pub init(data: i64, length: i64):
        self.data = data
        self.length = length
        self.references = 1
        self.is_alive = true

class MirBufferBuilder:
    let bytes: list[u8]
    var is_alive: bool

    pub init():
        self.bytes = list[u8]()
        self.is_alive = true

let i64_maximum: i64 = 9223372036854775807
let i64_minimum: i64 = -9223372036854775807 - 1
# The MIR oracle is itself one backend. Its provider chooses a small fixed
# test capacity; canonical MIR observes only the stable-base/prefix contract.
let mir_arena_capacity: i64 = 1048576

# The semantic oracle models the runtime's power-of-two recycling classes
# using its explicit test layout. No target fact enters canonical MIR.
func storage_class_size(byte_count: i64, alignment: i64) -> i64:
    var required = byte_count
    if required < alignment: required = alignment
    var size = 1
    while size < required: size *= 2
    return size

# mark: The interpreter ========================================================================

## Executes functions of one verified MIR program.
# Frames allowed before the interpreter reports stack exhaustion, the
# language's trap for unbounded recursion (section 13.4). Held to the same
# 4000 as the HIR interpreter, whose per-call host cost was measured; this
# one walks a function body iteratively and so recurses no deeper per call.
let frame_limit: i64 = 2000

pub class MirInterpreter: MirExternMemory, MirExecutionHost:
    let program: MirProgram
    let rules: LayoutRules
    let layout: TypeLayout
    var depth: i64
    let memory: list[u8]
    let float_cells: list[FloatCell]
    let freed_storage: list[FreedStorage]
    let data_addresses: list[i64]
    let global_addresses: list[i64]
    let immutable_buffers: list[MirImmutableBuffer]
    let buffer_builders: list[MirBufferBuilder]
    ## The one dispatch point for full-Luce-only instructions: collections,
    ## classes, closures, existential boxes, and workers
    ## (profiles/full/backends/mir_execution.luc).
    let full: FullProfileMirExecution
    var arena_address: i64
    var arena_committed: i64
    var external_host: MirExternHost?
    var c_function_pointer_host: MirCFunctionPointerHost?
    var external_global_host: MirExternalGlobalHost?
    var is_loaded: bool
    ## Everything `luce_rt_write` has written, in order.
    pub var output: str

    ## Prepare to run one program; memory is laid out on the first `run`.
    pub init(program: MirProgram, rules: LayoutRules):
        self.program = program
        self.rules = rules
        self.layout = TypeLayout(program.types, rules)
        self.depth = 0
        self.memory = list[u8]()
        self.float_cells = list[FloatCell]()
        self.freed_storage = list[FreedStorage]()
        self.data_addresses = list[i64]()
        self.global_addresses = list[i64]()
        self.immutable_buffers = list[MirImmutableBuffer]()
        self.buffer_builders = list[MirBufferBuilder]()
        self.full = FullProfileMirExecution(program, self.layout)
        self.arena_address = 0
        self.arena_committed = 0
        self.external_host = none
        self.c_function_pointer_host = none
        self.external_global_host = none
        self.is_loaded = false
        self.output = ""

    # mark: Execution services ==================================================================
    #
    # The profile executor reaches the oracle's memory, calls, buffers, and
    # worker domains only through these.

    ## Invoke the language process boundary with the same semantic slice the
    ## HIR oracle sees. This is target-independent oracle construction: host
    ## argc/argv and WASI memory remain backend concerns.
    pub func run_process(arguments: list[str]) -> MirValue!:
        if not self.is_loaded: self.load_program()
        return try self.full.run_process(self, arguments)

    ## Observe live source classes after a run; see the profile executor.
    pub func resource_census() -> ResourceCensus:
        return self.full.resource_census(self)

    pub func write_byte(address: i64, value: u8):
        self.memory[address] = value

    pub func read_byte(address: i64) -> u8:
        return self.memory[address]

    pub func create_immutable_buffer(data: i64, length: i64) -> i64:
        self.immutable_buffers.append(MirImmutableBuffer(data, length))
        return buffer_owner_address_base + len(self.immutable_buffers) - 1

    pub func retain_immutable_buffer(owner: i64) -> !:
        let storage = try self.immutable_buffer_at(owner)
        storage.references += 1

    ## A worker runs in a fresh loaded domain: the same program, layout
    ## rules, and explicit hosts, but fresh memory, tables, and frames.
    pub func fresh_domain() -> MirExecutionHost:
        let worker = MirInterpreter(self.program, self.rules)
        worker.external_host = self.external_host
        worker.c_function_pointer_host = self.c_function_pointer_host
        worker.external_global_host = self.external_global_host
        worker.load_program()
        return worker

    pub func encode_transfer(value_type: TypeId, value: MirValue) -> MirTransferredValue!:
        return try self.full.encode_transfer(self, value_type, value)

    pub func encode_transfer_from_storage(value_type: TypeId, address: i64) -> MirTransferredValue!:
        return try self.full.encode_transfer_from_storage(self, value_type, address)

    pub func decode_transfer(value_type: TypeId, value: MirTransferredValue) -> MirValue!:
        return try self.full.decode_transfer(self, value_type, value)

    ## Bind source C imports for subsequent executions of this instance.
    pub func bind_externs(host: MirExternHost):
        self.external_host = host

    ## Bind behavior for raw C function pointers independently of named
    ## extern declarations.
    pub func bind_c_function_pointers(host: MirCFunctionPointerHost):
        self.c_function_pointer_host = host

    ## Bind C-owned global storage independently from callable imports.
    pub func bind_external_globals(host: MirExternalGlobalHost):
        self.external_global_host = host

    ## Store one C output through an abstract pointer supplied to an explicit
    ## test host. This is the oracle's equivalent of a foreign callee writing
    ## through `T*`; no host receives the interpreter's byte array or layout.
    pub func store_external(address: MirValue, value_type: TypeId, value: MirValue) -> !:
        if not self.external_value_matches(value, value_type):
            error("mir interpreter: extern tried to store an incompatible value")
        self.store(value_type, ptr_of(address), value)

    ## Store one logical aggregate field without exposing byte offsets to an
    ## extern host. Aggregate structure belongs to canonical MIR; this backend
    ## alone applies its configured layout when locating the selected field.
    pub func store_external_field(address: MirValue, aggregate_type: TypeId, field: i64, value: MirValue) -> !:
        match mir_type(self.program.types, aggregate_type):
            Struct(fields):
                if field < 0 or field >= len(fields):
                    error("mir interpreter: extern selected a field outside its struct")
                let field_type = fields[field].value_type
                if not self.external_value_matches(value, field_type):
                    error("mir interpreter: extern tried to store an incompatible struct field")
                let field_address = ptr_of(address) + self.layout.field_offset(aggregate_type, field)
                self.store(field_type, field_address, self.canonical_external_value(value, field_type))
            else: error("mir interpreter: extern field store requires a struct type")

    ## Read one logical aggregate field for an explicit semantic host. Nested
    ## aggregates remain address-shaped canonical MIR values, allowing the
    ## host to traverse them without learning this interpreter's byte layout.
    pub func load_external_field(address: MirValue, aggregate_type: TypeId, field: i64) -> MirValue!:
        match mir_type(self.program.types, aggregate_type):
            Struct(fields):
                if field < 0 or field >= len(fields):
                    error("mir interpreter: extern selected a field outside its struct")
                let field_type = fields[field].value_type
                let field_address = ptr_of(address) + self.layout.field_offset(aggregate_type, field)
                if is_aggregate_type(self.program.types, field_type): return MirValue.Ptr(value = field_address)
                return self.load(field_type, field_address)
            else: error("mir interpreter: extern field load requires a struct type")

    pub func allocate_external_bytes(value: list[u8]) -> MirValue:
        let address = self.allocate(len(value), 1)
        for index in range(0, len(value)): self.memory[address + index] = value[index]
        return MirValue.Ptr(value = address)

    pub func load_external_c_string(address: MirValue) -> list[u8]!:
        let start = ptr_of(address)
        if start <= 0 or start >= len(self.memory): error("mir interpreter: extern read an invalid C string pointer")
        let value = list[u8]()
        var position = start
        while position < len(self.memory):
            let byte = self.memory[position]
            if byte == u8(0): return value
            value.append(byte)
            position += 1
        error("mir interpreter: extern read an unterminated C string")

    pub func load_external_list(address: MirValue, element_type: TypeId, count: u64) -> list[MirValue]!:
        let start = ptr_of(address)
        if start == 0:
            if count == u64(0): return list[MirValue]()
            error("mir interpreter: extern read a nonempty list through null")
        let values = list[MirValue]()
        for element in try self.full.borrowed_list_elements(start, element_type, count):
            values.append(self.load(element_type, element))
        return values

    ## Run one function by name and return its results; a fallible function's
    ## last result is its caller-owned error-slot pointer, or `Ptr(0)` on
    ## success.
    pub func run(function_name: str, arguments: list[MirValue]) -> list[MirValue]!:
        if not self.is_loaded: self.load_program()
        let index = find_mir_function(self.program, function_name)
        if index < 0: error("mir interpreter: unknown function `" + function_name + "`")
        return try self.call(index, arguments)

    # mark: Resource census ====================================================================

    # mark: Program loading ====================================================================

    # Lay out data and globals once. Address 0 is null; nothing lives there.
    pub func load_program():
        self.is_loaded = true
        let program = self.program
        self.memory.append(0)
        if find_mir_extern(program, "luce_rt_arena") >= 0:
            self.arena_address = self.allocate(mir_arena_capacity, 16)
        for item in program.data:
            let address = self.allocate(len(item.bytes), item.align)
            for index in range(0, len(item.bytes)):
                self.memory[address + index] = item.bytes[index]
            self.data_addresses.append(address)
        for global in program.globals:
            let size = self.layout.size_of(global.value_type)
            self.global_addresses.append(self.allocate(size, self.layout.align_of(global.value_type)))
        for index in range(0, len(program.globals)):
            let initial = program.globals[index].initial
            if initial != none:
                let size = self.layout.size_of(program.globals[index].value_type)
                let source = self.data_addresses[initial.value]
                for offset in range(0, size):
                    self.memory[self.global_addresses[index] + offset] = self.memory[source + offset]

    # mark: Calls ===============================================================================

    # One call frame: parameters land in the leading registers, slots are
    # allocated, the body runs, and the flow it ends with becomes results.
    pub func call(index: i64, arguments: list[MirValue]) -> list[MirValue]!:
        let function = self.program.functions[index]
        if len(arguments) != len(function.signature.parameters):
            error("mir interpreter: `" + function.name + "` takes " + str(len(function.signature.parameters)) + " argument(s), got " + str(len(arguments)))
        let registers = list[MirValue]()
        for register_type in function.registers:
            registers.append(self.default_value(register_type))
        for position in range(0, len(arguments)):
            registers[position] = self.canonical_external_value(arguments[position], function.signature.parameters[position])
        let slots = list[i64]()
        for slot in function.slots:
            slots.append(self.allocate(self.layout.size_of(slot.value_type), self.layout.align_of(slot.value_type)))
        let frame = Frame(function = function, registers = registers, slots = slots)
        if self.depth >= frame_limit: error("mir interpreter: trap: call depth exceeded " + str(frame_limit) + " frames in `" + function.name + "`")
        self.depth += 1
        let outcome = self.execute_body(frame, function.body, plan_regions(function.body)) catch reason:
            self.depth -= 1
            error(reason)
        self.depth -= 1
        match outcome:
            Returned(values): return values
            Raised(failure):
                # An error leaves the value results at their defaults and the
                # error slot pointing at the error record.
                let results = list[MirValue]()
                for position in range(0, len(function.signature.results) - 1):
                    results.append(self.default_value(function.signature.results[position]))
                results.append(MirValue.Ptr(value = failure))
                return results
            else: trap("verified MIR function fell off its end")

    # A pointer-width constant is verified without a width; this oracle's
    # layout rules supply one, so a constant that does not fit is refused here.
    func require_pointer_width_fit(value_type: TypeId, outside: bool, text: str) -> !:
        if not outside or not is_pointer_int_type(self.program.types, value_type): return
        error("mir interpreter: constant " + text + " does not fit `" + describe_mir_type(self.program.types, value_type) + "` at pointer width " + str(self.layout.pointer_size() * 8))

    func default_value(id: TypeId) -> MirValue:
        let types = self.program.types
        if is_float_type(types, id): return MirValue.Float(value = 0.0)
        if is_bool_type(types, id): return MirValue.Bool(value = false)
        if is_reference_type(types, id): return MirValue.Ptr(value = 0)
        if is_signed_int_type(types, id): return MirValue.SignedInt(value = 0)
        return MirValue.UnsignedInt(value = u64(0))

    # mark: Bodies and regions ==================================================================

    # Run a flat body from its first instruction. Openers push a region,
    # arm separators reached by falling off an arm leave the region, `End`
    # pops it, and branches jump through the plan; everything else is a
    # straight-line instruction.
    func execute_body(frame: Frame, body: list[MirInstruction], plan: RegionPlan) -> Flow!:
        let regions = list[RunRegion]()
        var pc = 0
        while pc < len(body):
            let instruction = body[pc]
            match instruction.form:
                Block(results):
                    regions.append(RunRegion(is_loop = false, start = pc, end = plan.end_of[pc], results = results))
                    pc += 1
                Loop:
                    regions.append(RunRegion(is_loop = true, start = pc, end = plan.end_of[pc], results = no_registers()))
                    pc += 1
                If(condition, results):
                    regions.append(RunRegion(is_loop = false, start = pc, end = plan.end_of[pc], results = results))
                    if bool_of(frame.registers[condition.value]):
                        pc += 1
                    elif plan.next_arm[pc] >= 0:
                        pc = plan.next_arm[pc] + 1
                    else:
                        regions.remove(len(regions) - 1)
                        pc = plan.end_of[pc] + 1
                Else:
                    regions.remove(len(regions) - 1)
                    pc = plan.end_of[pc] + 1
                Switch(tag):
                    regions.append(RunRegion(is_loop = false, start = pc, end = plan.end_of[pc], results = no_registers()))
                    pc = select_arm(body, plan, pc, frame.registers[tag.value])
                Case(value):
                    regions.remove(len(regions) - 1)
                    pc = plan.end_of[pc] + 1
                Default:
                    regions.remove(len(regions) - 1)
                    pc = plan.end_of[pc] + 1
                End:
                    regions.remove(len(regions) - 1)
                    pc += 1
                Br(depth, values):
                    pc = self.branch(frame, regions, depth, self.collect(frame, values))
                BrIf(condition, depth, values):
                    if bool_of(frame.registers[condition.value]):
                        pc = self.branch(frame, regions, depth, self.collect(frame, values))
                    else:
                        pc += 1
                Yield(values):
                    pc = self.branch(frame, regions, 0, self.collect(frame, values))
                Return(values):
                    return Flow.Returned(values = self.collect(frame, values))
                Raise(failure):
                    return Flow.Raised(failure = ptr_of(frame.registers[failure.value]))
                else:
                    try self.execute(frame, instruction)
                    pc += 1
        return Flow.Next

    # Leave `depth` regions: a loop target restarts and stays open; any other
    # target receives the values and is left.
    func branch(frame: Frame, regions: list[RunRegion], depth: i64, values: list[MirValue]) -> i64:
        let target = regions[len(regions) - 1 - depth]
        if target.is_loop:
            let keep_loop = len(regions) - depth
            while len(regions) > keep_loop: regions.remove(len(regions) - 1)
            return target.start + 1
        self.bind(frame, target.results, values)
        let keep = len(regions) - 1 - depth
        while len(regions) > keep: regions.remove(len(regions) - 1)
        return target.end + 1

    pub func bind(frame: Frame, results: RegisterRun, values: list[MirValue]):
        for position in range(0, i64(results.count)):
            frame.registers[register_at(frame.function, results, position).value] = values[position]

    # mark: Instructions ========================================================================

    # One straight-line instruction; control flow never reaches here.
    func execute(frame: Frame, instruction: MirInstruction) -> !:
        let types = self.program.types
        match instruction.form:
            Const(result, value):
                match value:
                    SignedInt(item):
                        try self.require_pointer_width_fit(frame.function.registers[result.value], item < self.layout.int_minimum(frame.function.registers[result.value]) or item > self.layout.int_maximum(frame.function.registers[result.value]), str(item))
                        frame.registers[result.value] = MirValue.SignedInt(value = item)
                    UnsignedInt(item):
                        try self.require_pointer_width_fit(frame.function.registers[result.value], item > self.layout.uint_maximum(frame.function.registers[result.value]), str(item))
                        frame.registers[result.value] = MirValue.UnsignedInt(value = item)
                    Float(item): frame.registers[result.value] = MirValue.Float(value = normalize_mir_float(item, frame.function.registers[result.value], types))
                    Bool(item): frame.registers[result.value] = MirValue.Bool(value = item)
                    Null: frame.registers[result.value] = MirValue.Ptr(value = 0)
            Copy(result, source):
                frame.registers[result.value] = frame.registers[source.value]
            Binary(result, operation, left, right):
                frame.registers[result.value] = try self.evaluate_binary(operation, frame.function.registers[left.value], frame.registers[left.value], frame.registers[right.value])
            Unary(result, operation, operand):
                frame.registers[result.value] = try self.evaluate_unary(operation, frame.function.registers[operand.value], frame.registers[operand.value])
            Convert(result, operation, operand):
                frame.registers[result.value] = try self.evaluate_convert(operation, frame.function.registers[operand.value], frame.function.registers[result.value], frame.registers[operand.value])
            FloatBits(result, operand):
                frame.registers[result.value] = MirValue.UnsignedInt(value = ieee_float_bits(
                    float_of(frame.registers[operand.value]),
                    self.layout.integer_bits(frame.function.registers[operand.value]),
                ))
            PointerDifference(result, element_type, left, right):
                let byte_span = ptr_of(frame.registers[left.value]) - ptr_of(frame.registers[right.value])
                frame.registers[result.value] = MirValue.SignedInt(value = byte_span // self.layout.size_of(element_type))
            PointerHash(result, operand):
                frame.registers[result.value] = MirValue.UnsignedInt(value = semantic_pointer_hash(ptr_of(frame.registers[operand.value])))
            LayoutConstant(result, query, subject, field):
                frame.registers[result.value] = MirValue.UnsignedInt(value = u64(self.layout.answer(query, subject, field)))
            Alloca(result, slot):
                frame.registers[result.value] = MirValue.Ptr(value = frame.slots[slot])
            AllocateStorage(result, element_type, count):
                let item_count = try host_count_of(frame.registers[count.value], "storage element count")
                if item_count == 0:
                    frame.registers[result.value] = MirValue.Ptr(value = 0)
                else:
                    let element_size = self.layout.size_of(element_type)
                    var byte_count = 1
                    if element_size > 0:
                        byte_count = try checked_multiply(element_size, item_count)
                    var alignment = self.layout.align_of(element_type)
                    if alignment < self.layout.pointer_align(): alignment = self.layout.pointer_align()
                    let size = storage_class_size(byte_count, alignment)
                    frame.registers[result.value] = MirValue.Ptr(value = self.allocate_recyclable(size))
            DeallocateStorage(address, element_type, count):
                let item_count = try host_count_of(frame.registers[count.value], "storage element count")
                if item_count > 0:
                    let element_size = self.layout.size_of(element_type)
                    var byte_count = 1
                    if element_size > 0: byte_count = try checked_multiply(element_size, item_count)
                    var alignment = self.layout.align_of(element_type)
                    if alignment < self.layout.pointer_align(): alignment = self.layout.pointer_align()
                    let size = storage_class_size(byte_count, alignment)
                    let address_value = ptr_of(frame.registers[address.value])
                    self.clear_float_cells(address_value, size)
                    self.freed_storage.append(FreedStorage(address = address_value, size = size))
            Load(result, value_type, address):
                frame.registers[result.value] = self.load(value_type, ptr_of(frame.registers[address.value]))
            Store(value_type, address, value):
                self.store(value_type, ptr_of(frame.registers[address.value]), frame.registers[value.value])
            FieldAddress(result, struct_type, base, field):
                match mir_type(types, struct_type):
                    Struct(fields):
                        frame.registers[result.value] = MirValue.Ptr(value = ptr_of(frame.registers[base.value]) + self.layout.field_offset(struct_type, field))
                    else: trap("verified FieldAddress on a non-struct type")
            EnumPayloadAddress(result, enum_type, base):
                frame.registers[result.value] = MirValue.Ptr(value = ptr_of(frame.registers[base.value]) + self.layout.enum_payload_offset(enum_type))
            ElementAddress(result, element_type, base, index):
                let stride = self.layout.size_of(element_type)
                let position = try host_integer_of(frame.registers[index.value], "element index")
                let offset = try checked_multiply(position, stride)
                frame.registers[result.value] = MirValue.Ptr(value = ptr_of(frame.registers[base.value]) + offset)
            Memcpy(destination, source, value_type):
                let size = self.layout.size_of(value_type)
                let to = ptr_of(frame.registers[destination.value])
                let from = ptr_of(frame.registers[source.value])
                self.copy_bytes(from, to, size)
            MoveElements(destination, source, element_type, count):
                let element_count = try host_count_of(frame.registers[count.value], "move element count")
                let byte_count = try checked_multiply(self.layout.size_of(element_type), element_count)
                let to = ptr_of(frame.registers[destination.value])
                let from = ptr_of(frame.registers[source.value])
                let moved = list[u8]()
                let moved_float_cells = list[FloatCell]()
                for offset in range(0, byte_count): moved.append(self.memory[from + offset])
                for cell in self.float_cells:
                    if cell.address >= from and cell.address < from + byte_count:
                        moved_float_cells.append(FloatCell(address = cell.address - from, value = cell.value))
                for offset in range(0, byte_count): self.memory[to + offset] = moved[offset]
                self.clear_float_cells(to, byte_count)
                for cell in moved_float_cells: self.set_float_cell(to + cell.address, cell.value)
            BufferRetain(value):
                let owner = ptr_of(frame.registers[value.value])
                if owner != 0:
                    let storage = try self.immutable_buffer_at(owner)
                    storage.references += 1
            BufferRelease(value):
                try self.release_immutable_buffer(ptr_of(frame.registers[value.value]))
            BufferConcat(result, left_data, left_length, right_data, right_length):
                let left_count = try host_count_of(frame.registers[left_length.value], "left buffer length")
                let right_count = try host_count_of(frame.registers[right_length.value], "right buffer length")
                if left_count > i64_maximum - right_count:
                    error("mir interpreter: trap: integer overflow")
                let total = left_count + right_count
                let data = self.allocate(total, 1)
                let left_address = ptr_of(frame.registers[left_data.value])
                let right_address = ptr_of(frame.registers[right_data.value])
                for offset in range(0, left_count): self.memory[data + offset] = self.memory[left_address + offset]
                for offset in range(0, right_count): self.memory[data + left_count + offset] = self.memory[right_address + offset]
                self.immutable_buffers.append(MirImmutableBuffer(data, total))
                frame.registers[result.value] = MirValue.Ptr(value = buffer_owner_address_base + len(self.immutable_buffers) - 1)
            BufferData(result, owner):
                let storage = try self.immutable_buffer_at(ptr_of(frame.registers[owner.value]))
                frame.registers[result.value] = MirValue.Ptr(value = storage.data)
            BufferLength(result, owner):
                let storage = try self.immutable_buffer_at(ptr_of(frame.registers[owner.value]))
                frame.registers[result.value] = MirValue.UnsignedInt(value = u64(storage.length))
            BufferBuilderCreate(result):
                self.buffer_builders.append(MirBufferBuilder())
                frame.registers[result.value] = MirValue.Ptr(value = buffer_builder_address_base + len(self.buffer_builders) - 1)
            BufferBuilderAppend(builder, data, length):
                let storage = try self.buffer_builder_at(ptr_of(frame.registers[builder.value]))
                let address = ptr_of(frame.registers[data.value])
                let count = try host_count_of(frame.registers[length.value], "buffer builder append length")
                for offset in range(0, count): storage.bytes.append(self.memory[address + offset])
            BufferBuilderFinish(result, builder):
                let storage = try self.buffer_builder_at(ptr_of(frame.registers[builder.value]))
                let data = self.allocate(len(storage.bytes), 1)
                for offset in range(0, len(storage.bytes)): self.memory[data + offset] = storage.bytes[offset]
                storage.is_alive = false
                self.immutable_buffers.append(MirImmutableBuffer(data, len(storage.bytes)))
                frame.registers[result.value] = MirValue.Ptr(value = buffer_owner_address_base + len(self.immutable_buffers) - 1)
            CStringCopy(result, source):
                let address = ptr_of(frame.registers[source.value])
                var length = 0
                while address + length < len(self.memory) and self.memory[address + length] != u8(0): length += 1
                if address + length >= len(self.memory): error("mir interpreter: trap: unterminated C string")
                var offset = 0
                while offset < length:
                    let decoded = self.decode_string(address, length, offset) catch reason:
                        error("mir interpreter: trap: invalid_utf8")
                    offset += decoded >> 32
                let data = self.allocate(length, 1)
                for byte in range(0, length): self.memory[data + byte] = self.memory[address + byte]
                self.immutable_buffers.append(MirImmutableBuffer(data, length))
                frame.registers[result.value] = MirValue.Ptr(value = buffer_owner_address_base + len(self.immutable_buffers) - 1)
            DisplaySigned(result, value):
                self.store_display_buffer(frame, result, str(signed_int_of(frame.registers[value.value])))
            DisplayUnsigned(result, value):
                self.store_display_buffer(frame, result, str(unsigned_int_of(frame.registers[value.value])))
            DisplayFloat(result, value):
                let displayed = float_of(frame.registers[value.value])
                if self.layout.integer_bits(frame.function.registers[value.value]) <= 32:
                    self.store_display_buffer(frame, result, display_float32(f32(displayed)))
                else:
                    self.store_display_buffer(frame, result, display_float64(displayed))
            DisplayCharacter(result, value):
                self.store_display_buffer(frame, result, str(char(u32(unsigned_int_of(frame.registers[value.value])))))
            DisplayBoolean(result, value):
                var text = "false"
                if bool_of(frame.registers[value.value]): text = "true"
                self.store_display_buffer(frame, result, text)
            StringScalarCount(result, data, length):
                let address = ptr_of(frame.registers[data.value])
                let byte_length = try host_count_of(frame.registers[length.value], "string byte length")
                var offset = 0
                var count = 0
                while offset < byte_length:
                    offset += (try self.decode_string(address, byte_length, offset)) >> 32
                    count += 1
                frame.registers[result.value] = MirValue.UnsignedInt(value = u64(count))
            StringDecode(character, width, data, length, offset):
                let decoded = try self.decode_string(
                    ptr_of(frame.registers[data.value]),
                    try host_count_of(frame.registers[length.value], "string byte length"),
                    try host_count_of(frame.registers[offset.value], "string byte offset"),
                )
                frame.registers[character.value] = MirValue.UnsignedInt(value = u64(decoded & 4294967295))
                frame.registers[width.value] = MirValue.UnsignedInt(value = u64(decoded >> 32))
            DataAddress(result, data):
                frame.registers[result.value] = MirValue.Ptr(value = self.data_addresses[data.value])
            GlobalAddress(result, global):
                frame.registers[result.value] = MirValue.Ptr(value = self.global_addresses[global.value])
            LoadExternalGlobal(result, global_index):
                let global = self.program.external_globals[global_index.value]
                let host = self.external_global_host else error("mir interpreter: external global `" + global.name + "` is not available")
                let value = try host.load(global)
                if not self.external_value_matches(value, global.value_type):
                    error("mir interpreter: external global `" + global.name + "` has an incompatible host value")
                frame.registers[result.value] = self.canonical_external_value(value, global.value_type)
            StoreExternalGlobal(global_index, value_register):
                let global = self.program.external_globals[global_index.value]
                let value = frame.registers[value_register.value]
                if not self.external_value_matches(value, global.value_type):
                    error("mir interpreter: external global `" + global.name + "` received an incompatible value")
                let host = self.external_global_host else error("mir interpreter: external global `" + global.name + "` is not available")
                try host.store(global, self.canonical_external_value(value, global.value_type))
            FunctionAddress(result, function):
                frame.registers[result.value] = MirValue.Ptr(value = function_address_base + i64(function.value))
            ExternAddress(result, external):
                frame.registers[result.value] = MirValue.Ptr(value = extern_address_base + i64(external.value))
            FunctionNull(destination, function_type):
                let address = ptr_of(frame.registers[destination.value])
                self.store(builtin_mir_type(BuiltinMirType.pointer), address, MirValue.Ptr(value = 0))
                self.store(builtin_mir_type(BuiltinMirType.pointer), address + self.layout.pointer_size(), MirValue.Ptr(value = 0))
            FunctionValue(destination, function_type, function):
                let address = ptr_of(frame.registers[destination.value])
                self.store(builtin_mir_type(BuiltinMirType.pointer), address, MirValue.Ptr(value = function_address_base + i64(function.value)))
                self.store(builtin_mir_type(BuiltinMirType.pointer), address + self.layout.pointer_size(), MirValue.Ptr(value = 0))
            Call(results, function, arguments):
                let values = try self.call(i64(function.value), self.collect(frame, arguments))
                self.bind(frame, results, values)
            CallExtern(results, external, arguments):
                let values = try self.call_extern(self.program.externs[external.value], self.collect(frame, arguments))
                self.bind(frame, results, values)
            CallIndirect(results, signature, convention, target, arguments):
                let address = ptr_of(frame.registers[target.value])
                let function_index = address - function_address_base
                if function_index >= 0 and function_index < len(self.program.functions):
                    let called = self.program.functions[function_index]
                    if called.convention != convention or not signatures_match(called.signature, signature):
                        error("mir interpreter: trap: indirect call signature or convention mismatch")
                    let values = try self.call(function_index, self.collect(frame, arguments))
                    self.bind(frame, results, values)
                else:
                    let external_index = address - extern_address_base
                    if convention == CallingConvention.c and external_index >= 0 and external_index < len(self.program.externs):
                        let external = self.program.externs[external_index]
                        if external.convention != convention or not signatures_match(external.signature, signature):
                            error("mir interpreter: trap: indirect extern call signature or convention mismatch")
                        let values = try self.call_extern(external, self.collect(frame, arguments))
                        self.bind(frame, results, values)
                    else:
                        if convention != CallingConvention.c or address == 0:
                            error("mir interpreter: trap: indirect call through " + str(address) + ", which is not a compatible function address")
                        let host = self.c_function_pointer_host else error("mir interpreter: C function pointer " + str(address) + " is not available")
                        let values = try host.call(address, signature, self.collect(frame, arguments), self)
                        try self.validate_external_results("C function pointer " + str(address), signature, values)
                        self.bind(frame, results, values)
            CallClosure(results, signature, target, arguments):
                let target_address = ptr_of(frame.registers[target.value])
                let code = ptr_of(self.load(builtin_mir_type(BuiltinMirType.pointer), target_address))
                let environment = self.load(builtin_mir_type(BuiltinMirType.pointer), target_address + self.layout.pointer_size())
                let function_index = code - function_address_base
                if function_index < 0 or function_index >= len(self.program.functions):
                    error("mir interpreter: trap: function value contains an invalid code address")
                let called = self.program.functions[function_index]
                let values = self.collect(frame, arguments)
                if ptr_of(environment) == 0:
                    if not signatures_match(called.signature, signature): error("mir interpreter: trap: function-value signature mismatch")
                else:
                    let parameters = list[TypeId]()
                    for parameter in signature.parameters: parameters.append(parameter)
                    var environment_index: i64 = 0
                    if signature.is_fallible: environment_index = 1
                    parameters.insert(environment_index, builtin_mir_type(BuiltinMirType.pointer))
                    let hidden = MirSignature(parameters = parameters, results = signature.results, is_fallible = signature.is_fallible, returns_never = signature.returns_never)
                    if not signatures_match(called.signature, hidden): error("mir interpreter: trap: closure implementation signature mismatch")
                    values.insert(environment_index, environment)
                self.bind(frame, results, try self.call(function_index, values))
            Trap(reason):
                error("mir interpreter: trap: " + reason)
            Unreachable:
                trap("verified MIR reached `Unreachable`")
            else:
                if not try self.full.execute(self, frame, instruction):
                    trap("control-flow instruction reached the straight-line interpreter")

    # mark: Isolated task domains ==============================================================

    pub func collect(frame: Frame, registers: RegisterRun) -> list[MirValue]:
        let values = list[MirValue]()
        for position in range(0, i64(registers.count)):
            values.append(frame.registers[register_at(frame.function, registers, position).value])
        return values

    func immutable_buffer_at(owner: i64) -> MirImmutableBuffer!:
        let index = owner - buffer_owner_address_base
        if index < 0 or index >= len(self.immutable_buffers): error("mir interpreter: trap: invalid buffer owner")
        let storage = self.immutable_buffers[index]
        if not storage.is_alive: error("mir interpreter: trap: released buffer owner")
        return storage

    func buffer_builder_at(value: i64) -> MirBufferBuilder!:
        let index = value - buffer_builder_address_base
        if index < 0 or index >= len(self.buffer_builders): error("mir interpreter: trap: invalid buffer builder")
        let storage = self.buffer_builders[index]
        if not storage.is_alive: error("mir interpreter: trap: consumed buffer builder")
        return storage

    func store_display_buffer(frame: Frame, result: RegisterId, text: str):
        let encoded = strings.to_bytes(text)
        let data = self.allocate(len(encoded), 1)
        for offset in range(0, len(encoded)): self.memory[data + offset] = encoded[offset]
        self.immutable_buffers.append(MirImmutableBuffer(data, len(encoded)))
        frame.registers[result.value] = MirValue.Ptr(value = buffer_owner_address_base + len(self.immutable_buffers) - 1)

    pub func release_immutable_buffer(owner: i64) -> !:
        if owner == 0: return
        let storage = try self.immutable_buffer_at(owner)
        if storage.references <= 0: trap("buffer owner reference count underflow")
        storage.references -= 1
        if storage.references == 0: storage.is_alive = false

    pub func copy_bytes(source: i64, destination: i64, size: i64):
        for offset in range(0, size):
            self.memory[destination + offset] = self.memory[source + offset]
            self.copy_float_cell(source + offset, destination + offset)

    # mark: Arithmetic ==========================================================================
    #
    # `operand_type` is the register type both operands share; integer results
    # must land inside its bounds. Stage-0 traps on its own `i64` overflow, so
    # each operation is checked before it is computed.

    func evaluate_binary(operation: BinaryOp, operand_type: TypeId, left: MirValue, right: MirValue) -> MirValue!:
        let types = self.program.types
        if is_float_type(types, operand_type):
            return try evaluate_float_binary(operation, operand_type, float_of(left), float_of(right), types)
        if is_bool_type(types, operand_type):
            if operation == BinaryOp.eq: return MirValue.Bool(value = bool_of(left) == bool_of(right))
            if operation == BinaryOp.ne: return MirValue.Bool(value = bool_of(left) != bool_of(right))
            trap("verified bool operands reached a non-equality operation")
        if is_identity_type(types, operand_type):
            if operation == BinaryOp.eq: return MirValue.Bool(value = ptr_of(left) == ptr_of(right))
            if operation == BinaryOp.ne: return MirValue.Bool(value = ptr_of(left) != ptr_of(right))
            if is_ptr_type(types, operand_type):
                # Addresses order totally (base.md §5.3); the oracle's are non-negative.
                if operation == BinaryOp.lt: return MirValue.Bool(value = ptr_of(left) < ptr_of(right))
                if operation == BinaryOp.le: return MirValue.Bool(value = ptr_of(left) <= ptr_of(right))
                if operation == BinaryOp.gt: return MirValue.Bool(value = ptr_of(left) > ptr_of(right))
                if operation == BinaryOp.ge: return MirValue.Bool(value = ptr_of(left) >= ptr_of(right))
            trap("verified identity operands reached a non-equality operation")
        if is_signed_int_type(types, operand_type):
            return try self.evaluate_signed_int_binary(operation, operand_type, signed_int_of(left), signed_int_of(right))
        return try self.evaluate_unsigned_int_binary(operation, operand_type, unsigned_int_of(left), unsigned_int_of(right))

    func evaluate_signed_int_binary(operation: BinaryOp, operand_type: TypeId, left: i64, right: i64) -> MirValue!:
        let types = self.program.types
        let minimum = self.layout.int_minimum(operand_type)
        let maximum = self.layout.int_maximum(operand_type)
        let bits = self.layout.integer_bits(operand_type)
        if operation == BinaryOp.eq: return MirValue.Bool(value = left == right)
        if operation == BinaryOp.ne: return MirValue.Bool(value = left != right)
        if operation == BinaryOp.lt: return MirValue.Bool(value = left < right)
        if operation == BinaryOp.le: return MirValue.Bool(value = left <= right)
        if operation == BinaryOp.gt: return MirValue.Bool(value = left > right)
        if operation == BinaryOp.ge: return MirValue.Bool(value = left >= right)
        if operation == BinaryOp.add:
            if (right > 0 and left > maximum - right) or (right < 0 and left < minimum - right):
                try trap_overflow()
            return MirValue.SignedInt(value = left + right)
        if operation == BinaryOp.sub:
            if (right < 0 and left > maximum + right) or (right > 0 and left < minimum + right):
                try trap_overflow()
            return MirValue.SignedInt(value = left - right)
        if operation == BinaryOp.mul:
            let product = try checked_multiply(left, right)
            if product < minimum or product > maximum: try trap_overflow()
            return MirValue.SignedInt(value = product)
        if operation == BinaryOp.add_wrap: return MirValue.SignedInt(value = wrap_signed(wrap_add_i64(left, right), bits))
        if operation == BinaryOp.sub_wrap: return MirValue.SignedInt(value = wrap_signed(wrap_sub_i64(left, right), bits))
        if operation == BinaryOp.mul_wrap: return MirValue.SignedInt(value = wrap_signed(wrap_mul_i64(left, right), bits))
        if operation == BinaryOp.add_sat or operation == BinaryOp.add_overflows:
            let overflows = (right > 0 and left > maximum - right) or (right < 0 and left < minimum - right)
            if operation == BinaryOp.add_overflows: return MirValue.Bool(value = overflows)
            if not overflows: return MirValue.SignedInt(value = left + right)
            if right > 0: return MirValue.SignedInt(value = maximum)
            return MirValue.SignedInt(value = minimum)
        if operation == BinaryOp.sub_sat or operation == BinaryOp.sub_overflows:
            let overflows = (right < 0 and left > maximum + right) or (right > 0 and left < minimum + right)
            if operation == BinaryOp.sub_overflows: return MirValue.Bool(value = overflows)
            if not overflows: return MirValue.SignedInt(value = left - right)
            if right < 0: return MirValue.SignedInt(value = maximum)
            return MirValue.SignedInt(value = minimum)
        if operation == BinaryOp.mul_sat or operation == BinaryOp.mul_overflows:
            var overflows = false
            var product = 0
            let exact = checked_multiply(left, right) catch reason:
                overflows = true
                return try self.saturated_or_flag(operation, true, (left < 0) == (right < 0), minimum, maximum)
            if exact < minimum or exact > maximum:
                return try self.saturated_or_flag(operation, true, exact > 0, minimum, maximum)
            if operation == BinaryOp.mul_overflows: return MirValue.Bool(value = false)
            return MirValue.SignedInt(value = exact)
        if operation == BinaryOp.trunc_div or operation == BinaryOp.trunc_rem:
            if right == 0: error("mir interpreter: trap: division by zero")
            if operation == BinaryOp.trunc_rem and right == -1: return MirValue.SignedInt(value = 0)
            if left == minimum and right == -1: try trap_overflow()
            # C's quotient: the floor moved one step toward zero when the
            # remainder is non-zero and the signs differ (base.md §7.2).
            var quotient = left // right
            if left % right != 0 and ((left < 0) != (right < 0)): quotient += 1
            if operation == BinaryOp.trunc_div: return MirValue.SignedInt(value = quotient)
            return MirValue.SignedInt(value = left - right * quotient)
        if operation == BinaryOp.floor_div or operation == BinaryOp.rem:
            if right == 0: error("mir interpreter: trap: division by zero")
            # `minimum // -1` overflows; `minimum % -1` is simply 0.
            if operation == BinaryOp.rem and right == -1: return MirValue.SignedInt(value = 0)
            if left == minimum and right == -1: try trap_overflow()
            if operation == BinaryOp.floor_div: return MirValue.SignedInt(value = left // right)
            return MirValue.SignedInt(value = left % right)
        if operation == BinaryOp.bit_and: return MirValue.SignedInt(value = left & right)
        if operation == BinaryOp.bit_or: return MirValue.SignedInt(value = left | right)
        if operation == BinaryOp.bit_xor: return MirValue.SignedInt(value = left ^ right)
        if operation == BinaryOp.shift_left:
            if right < 0 or right >= bits: error("mir interpreter: trap: shift count is outside integer width")
            # Only the count is checked (language section 7); bits shifted
            # past the width are dropped and the result is re-canonicalised.
            return MirValue.SignedInt(value = shift_left_within(left, right, bits, true))
        if operation == BinaryOp.shift_right:
            if right < 0 or right >= bits: error("mir interpreter: trap: shift count is outside integer width")
            # Unsigned values are non-negative here, so `>>` is logical for
            # them and arithmetic for signed values, as the language requires.
            return MirValue.SignedInt(value = left >> right)
        if operation == BinaryOp.div: trap("verified integer operands reached `div`")
        trap("unhandled integer operation")

    func evaluate_unsigned_int_binary(operation: BinaryOp, operand_type: TypeId, left: u64, right: u64) -> MirValue!:
        let maximum = self.layout.uint_maximum(operand_type)
        let bits = self.layout.integer_bits(operand_type)
        if operation == BinaryOp.eq: return MirValue.Bool(value = left == right)
        if operation == BinaryOp.ne: return MirValue.Bool(value = left != right)
        if operation == BinaryOp.lt: return MirValue.Bool(value = left < right)
        if operation == BinaryOp.le: return MirValue.Bool(value = left <= right)
        if operation == BinaryOp.gt: return MirValue.Bool(value = left > right)
        if operation == BinaryOp.ge: return MirValue.Bool(value = left >= right)
        if operation == BinaryOp.add:
            if left > maximum - right: try trap_overflow()
            return MirValue.UnsignedInt(value = left + right)
        if operation == BinaryOp.sub:
            if left < right: try trap_overflow()
            return MirValue.UnsignedInt(value = left - right)
        if operation == BinaryOp.mul:
            if right != u64(0) and left > maximum // right: try trap_overflow()
            return MirValue.UnsignedInt(value = left * right)
        if operation == BinaryOp.add_wrap: return MirValue.UnsignedInt(value = wrap_unsigned(wrap_add_u64(left, right), bits))
        if operation == BinaryOp.sub_wrap: return MirValue.UnsignedInt(value = wrap_unsigned(wrap_sub_u64(left, right), bits))
        if operation == BinaryOp.mul_wrap: return MirValue.UnsignedInt(value = wrap_unsigned(wrap_mul_u64(left, right), bits))
        if operation == BinaryOp.add_overflows: return MirValue.Bool(value = left > maximum - right)
        if operation == BinaryOp.sub_overflows: return MirValue.Bool(value = left < right)
        if operation == BinaryOp.mul_overflows: return MirValue.Bool(value = right != u64(0) and left > maximum // right)
        if operation == BinaryOp.add_sat:
            if left > maximum - right: return MirValue.UnsignedInt(value = maximum)
            return MirValue.UnsignedInt(value = left + right)
        if operation == BinaryOp.sub_sat:
            if left < right: return MirValue.UnsignedInt(value = u64(0))
            return MirValue.UnsignedInt(value = left - right)
        if operation == BinaryOp.mul_sat:
            if right != u64(0) and left > maximum // right: return MirValue.UnsignedInt(value = maximum)
            return MirValue.UnsignedInt(value = left * right)
        if operation == BinaryOp.floor_div or operation == BinaryOp.rem or operation == BinaryOp.trunc_div or operation == BinaryOp.trunc_rem:
            if right == u64(0): error("mir interpreter: trap: division by zero")
            if operation == BinaryOp.floor_div or operation == BinaryOp.trunc_div: return MirValue.UnsignedInt(value = left // right)
            return MirValue.UnsignedInt(value = left % right)
        if operation == BinaryOp.bit_and: return MirValue.UnsignedInt(value = left & right)
        if operation == BinaryOp.bit_or: return MirValue.UnsignedInt(value = left | right)
        if operation == BinaryOp.bit_xor: return MirValue.UnsignedInt(value = left ^ right)
        if operation == BinaryOp.shift_left:
            if right >= u64(bits): error("mir interpreter: trap: shift count is outside integer width")
            return MirValue.UnsignedInt(value = shift_left_unsigned(left, i64(right), bits))
        if operation == BinaryOp.shift_right:
            if right >= u64(bits): error("mir interpreter: trap: shift count is outside integer width")
            return MirValue.UnsignedInt(value = left >> right)
        if operation == BinaryOp.div: trap("verified integer operands reached `div`")
        trap("unhandled unsigned integer operation")

    # `mul_sat` saturates toward the sign of the true product; `mul_overflows`
    # reports the same condition.
    func saturated_or_flag(operation: BinaryOp, overflows: bool, toward_maximum: bool, minimum: i64, maximum: i64) -> MirValue!:
        if operation == BinaryOp.mul_overflows: return MirValue.Bool(value = overflows)
        if toward_maximum: return MirValue.SignedInt(value = maximum)
        return MirValue.SignedInt(value = minimum)

    func evaluate_unary(operation: UnaryOp, operand_type: TypeId, operand: MirValue) -> MirValue!:
        let types = self.program.types
        match operation:
            neg_wrap:
                let bits = self.layout.integer_bits(operand_type)
                if is_signed_int_type(types, operand_type): return MirValue.SignedInt(value = wrap_signed(wrap_negate_i64(signed_int_of(operand)), bits))
                return MirValue.UnsignedInt(value = wrap_unsigned(wrap_negate_u64(unsigned_int_of(operand)), bits))
            neg:
                if is_float_type(types, operand_type):
                    return MirValue.Float(value = normalize_mir_float(-float_of(operand), operand_type, types))
                let value = signed_int_of(operand)
                if value == self.layout.int_minimum(operand_type): try trap_overflow()
                return MirValue.SignedInt(value = 0 - value)
            bit_not:
                if is_signed_int_type(types, operand_type): return MirValue.SignedInt(value = ~signed_int_of(operand))
                return MirValue.UnsignedInt(value = self.layout.uint_maximum(operand_type) - unsigned_int_of(operand))
            bool_not:
                return MirValue.Bool(value = not bool_of(operand))

    func evaluate_convert(operation: ConvertOp, operand_type: TypeId, result_type: TypeId, operand: MirValue) -> MirValue!:
        let types = self.program.types
        match operation:
            widen:
                # Value-preserving by construction; the semantic domain is unchanged.
                return operand
            ptr_to_nullable: return operand
            nullable_to_ptr: return operand
            ptr_to_int:
                if is_signed_int_type(types, result_type): return MirValue.SignedInt(value = ptr_of(operand))
                return MirValue.UnsignedInt(value = u64(ptr_of(operand)))
            int_to_ptr:
                if is_signed_int_type(types, operand_type): return MirValue.Ptr(value = signed_int_of(operand))
                return MirValue.Ptr(value = i64(unsigned_int_of(operand)))
            cast_int:
                return integer_from_width(operand, self.layout.integer_bits(result_type), is_signed_int_type(types, result_type))
            float_to_int_saturating:
                let value = float_of(operand)
                if value != value: return self.default_value(result_type)
                if is_signed_int_type(types, result_type):
                    let minimum = self.layout.int_minimum(result_type)
                    let maximum = self.layout.int_maximum(result_type)
                    if value <= f64(minimum): return MirValue.SignedInt(value = minimum)
                    if value >= f64(maximum) + 1.0: return MirValue.SignedInt(value = maximum)
                    return MirValue.SignedInt(value = i64(value))
                let maximum = self.layout.uint_maximum(result_type)
                if value <= 0.0: return MirValue.UnsignedInt(value = u64(0))
                if value >= 18446744073709551616.0 or value >= f64(maximum) + 1.0: return MirValue.UnsignedInt(value = maximum)
                return MirValue.UnsignedInt(value = u64(value))
            extend:
                return integer_from_low_bits(operand, result_type, types)
            wrap:
                return integer_from_low_bits(operand, result_type, types)
            int_reinterpret:
                return integer_from_low_bits(operand, result_type, types)
            int_to_float:
                if is_signed_int_type(types, operand_type): return MirValue.Float(value = normalize_mir_float(f64(signed_int_of(operand)), result_type, types))
                return MirValue.Float(value = normalize_mir_float(f64(unsigned_int_of(operand)), result_type, types))
            float_to_int:
                let value = float_of(operand)
                if value != value: error("mir interpreter: trap: float to integer conversion of NaN")
                if is_signed_int_type(types, result_type):
                    if value < f64(self.layout.int_minimum(result_type)) or value >= f64(self.layout.int_maximum(result_type)) + 1.0:
                        error("mir interpreter: trap: float to integer conversion is outside the integer range")
                    return MirValue.SignedInt(value = i64(value))
                let upper = f64(self.layout.uint_maximum(result_type)) + 1.0
                if value < 0.0 or value >= upper:
                    error("mir interpreter: trap: float to integer conversion is outside the integer range")
                return MirValue.UnsignedInt(value = u64(value))
            float_resize:
                return MirValue.Float(value = normalize_mir_float(float_of(operand), result_type, types))

    # mark: Memory ==============================================================================

    pub func allocate(size: i64, align: i64) -> i64:
        let address = align_up(len(self.memory), align)
        while len(self.memory) < address + size:
            self.memory.append(0)
        if size == 0: self.memory.append(0)
        return address

    func allocate_recyclable(size: i64) -> i64:
        for index in range(0, len(self.freed_storage)):
            let block = self.freed_storage[index]
            if block.size == size:
                self.freed_storage.remove(index)
                return block.address
        return self.allocate(size, size)

    pub func load(value_type: TypeId, address: i64) -> MirValue:
        let types = self.program.types
        if is_float_type(types, value_type):
            for cell in self.float_cells:
                if cell.address == address: return MirValue.Float(value = cell.value)
            return MirValue.Float(value = 0.0)
        if is_bool_type(types, value_type): return MirValue.Bool(value = self.memory[address] != 0)
        if is_reference_type(types, value_type): return MirValue.Ptr(value = self.read_int(address, self.layout.pointer_size(), false))
        if is_signed_int_type(types, value_type):
            return MirValue.SignedInt(value = self.read_int(address, self.layout.integer_bits(value_type) // 8, true))
        return MirValue.UnsignedInt(value = self.read_unsigned_int(address, self.layout.integer_bits(value_type) // 8))

    pub func store(value_type: TypeId, address: i64, value: MirValue):
        let types = self.program.types
        if is_float_type(types, value_type):
            self.set_float_cell(address, normalize_mir_float(float_of(value), value_type, types))
            return
        if is_bool_type(types, value_type):
            if bool_of(value): self.memory[address] = u8(1)
            else: self.memory[address] = u8(0)
            return
        if is_reference_type(types, value_type):
            self.write_int(address, self.layout.pointer_size(), ptr_of(value))
            return
        if is_signed_int_type(types, value_type):
            self.write_int(address, self.layout.integer_bits(value_type) // 8, signed_int_of(value))
        else:
            self.write_unsigned_int(address, self.layout.integer_bits(value_type) // 8, unsigned_int_of(value))

    # Little-endian, sign-extending on request. A negative value's two's
    # complement bytes are produced by adding 2^64 conceptually, one byte at a
    # time, without ever forming a value Stage-0 would reject.
    func write_int(address: i64, size: i64, value: i64):
        var remaining = value
        for offset in range(0, size):
            let low = remaining % 256
            self.memory[address + offset] = u8(low)
            remaining = (remaining - low) // 256

    func write_unsigned_int(address: i64, size: i64, value: u64):
        var remaining = value
        for offset in range(0, size):
            self.memory[address + offset] = u8(remaining % u64(256))
            remaining = remaining // u64(256)

    func read_int(address: i64, size: i64, is_signed: bool) -> i64:
        # The top byte is folded in as a signed digit so eight bytes never
        # form a value Stage-0 cannot hold; narrower reads sign-extend after.
        var top = i64(self.memory[address + size - 1])
        if (is_signed or size == 8) and top >= 128: top = top - 256
        var value = top
        var position = size - 2
        while position >= 0:
            value = value * 256 + i64(self.memory[address + position])
            position -= 1
        return value

    func read_unsigned_int(address: i64, size: i64) -> u64:
        var value = u64(0)
        var position = size - 1
        while position >= 0:
            value = value * u64(256) + u64(self.memory[address + position])
            position -= 1
        return value

    func set_float_cell(address: i64, value: f64):
        for index in range(0, len(self.float_cells)):
            if self.float_cells[index].address == address:
                self.float_cells[index] = FloatCell(address = address, value = value)
                return
        self.float_cells.append(FloatCell(address = address, value = value))

    func copy_float_cell(from: i64, to: i64):
        for cell in self.float_cells:
            if cell.address == from:
                self.set_float_cell(to, cell.value)
                return

    func clear_float_cells(address: i64, size: i64):
        var index = len(self.float_cells) - 1
        while index >= 0:
            let cell_address = self.float_cells[index].address
            if cell_address >= address and cell_address < address + size:
                self.float_cells.remove(index)
            index -= 1

    # mark: The runtime =========================================================================
    #
    # The services a program may call by name. Anything the interpreter does
    # not provide is reported, never trapped, so a test sees which one.

    func call_extern(external: MirExtern, arguments: list[MirValue]) -> list[MirValue]!:
        let none_results = list[MirValue]()
        if external.convention == CallingConvention.c:
            let host = self.external_host else error("mir interpreter: extern `" + external.name + "` is not available")
            let results = try host.call(external, arguments, self)
            try self.validate_external_results("extern `" + external.name + "`", external.signature, results)
            return results
        let name = external.name
        if name == "luce_rt_arena":
            let requested_end = try host_count_of(arguments[0], "arena end")
            if requested_end > mir_arena_capacity:
                error("mir interpreter: trap: arena capacity exceeded")
            if requested_end > self.arena_committed: self.arena_committed = requested_end
            return [MirValue.Ptr(value = self.arena_address)]
        if name == "luce_rt_write":
            self.output = self.output + self.text_at(ptr_of(arguments[0]), try host_count_of(arguments[1], "write length"))
            return none_results
        if name == "luce_rt_trap":
            error("mir interpreter: trap: " + self.text_at(ptr_of(arguments[0]), try host_count_of(arguments[1], "trap reason length")))
        if name == "luce_rt_retain" or name == "luce_rt_release":
            return none_results
        if name == "luce_rt_weak_make" or name == "luce_rt_weak_get":
            return [arguments[0]]
        error("mir interpreter: extern `" + name + "` is not available")

    func validate_external_results(subject: str, signature: MirSignature, results: list[MirValue]) -> !:
        if len(results) != len(signature.results):
            error("mir interpreter: " + subject + " returned " + str(len(results)) + " value(s), expected " + str(len(signature.results)))
        for index in range(0, len(results)):
            if not self.external_value_matches(results[index], signature.results[index]):
                error("mir interpreter: " + subject + " returned a value incompatible with result " + str(index))
            results[index] = self.canonical_external_value(results[index], signature.results[index])

    func external_value_matches(value: MirValue, value_type: TypeId) -> bool:
        if is_float_type(self.program.types, value_type):
            match value:
                Float(item): return true
                else: return false
        if is_bool_type(self.program.types, value_type):
            match value:
                Bool(item): return true
                else: return false
        if is_ptr_type(self.program.types, value_type):
            match value:
                Ptr(item): return true
                else: return false
        if is_int_type(self.program.types, value_type):
            if is_signed_int_type(self.program.types, value_type):
                match value:
                    SignedInt(item): return item >= self.layout.int_minimum(value_type) and item <= self.layout.int_maximum(value_type)
                    else: return false
            match value:
                UnsignedInt(item): return item <= self.layout.uint_maximum(value_type)
                else: return false
        return false

    func canonical_external_value(value: MirValue, value_type: TypeId) -> MirValue:
        if is_float_type(self.program.types, value_type):
            match value:
                Float(item): return MirValue.Float(value = normalize_mir_float(item, value_type, self.program.types))
                else: return value
        return value

    func text_at(address: i64, length: i64) -> str:
        let payload = list[u8]()
        for offset in range(0, length):
            payload.append(self.memory[address + offset])
        return strings.from_bytes(payload) else "<invalid utf-8>"

    # Return the scalar in the low 32 bits and its UTF-8 width in the high 32
    # bits. Canonical MIR exposes those as separate results; packing exists
    # only inside this oracle, matching the sealed runtime's private ABI.
    func decode_string(address: i64, length: i64, offset: i64) -> i64!:
        if offset < 0 or offset >= length: error("mir interpreter: trap: string decode offset is out of bounds")
        let first = i64(self.memory[address + offset])
        if first < 128: return first | (1 << 32)
        var width = 0
        var scalar = 0
        var minimum = 0
        if first >= 194 and first <= 223:
            width = 2
            scalar = first & 31
            minimum = 128
        elif first >= 224 and first <= 239:
            width = 3
            scalar = first & 15
            minimum = 2048
        elif first >= 240 and first <= 244:
            width = 4
            scalar = first & 7
            minimum = 65536
        else: error("mir interpreter: trap: string contains invalid UTF-8")
        if width > length - offset: error("mir interpreter: trap: string contains truncated UTF-8")
        var index = 1
        while index < width:
            let continuation = i64(self.memory[address + offset + index])
            if continuation < 128 or continuation > 191: error("mir interpreter: trap: string contains invalid UTF-8")
            scalar = (scalar << 6) | (continuation & 63)
            index += 1
        if scalar < minimum or scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
            error("mir interpreter: trap: string contains invalid Unicode scalar value")
        return scalar | (width << 32)

# mark: Region plans ===========================================================================

# One pass with a stack of open regions: every opener and separator is
# remembered until the `End` that closes them.
func plan_regions(body: list[MirInstruction]) -> RegionPlan:
    let end_of = list[i64]()
    let next_arm = list[i64]()
    for instruction in body:
        end_of.append(-1)
        next_arm.append(-1)
    let open_groups = list[list[i64]]()
    for index in range(0, len(body)):
        match body[index].form:
            Block(results): open_groups.append([index])
            Loop: open_groups.append([index])
            If(condition, results): open_groups.append([index])
            Switch(tag): open_groups.append([index])
            Else: extend_group(open_groups, next_arm, index)
            Case(value): extend_group(open_groups, next_arm, index)
            Default: extend_group(open_groups, next_arm, index)
            End:
                let group = open_groups[len(open_groups) - 1]
                open_groups.remove(len(open_groups) - 1)
                for member in group: end_of[member] = index
            else: pass
    return RegionPlan(end_of = end_of, next_arm = next_arm)

func extend_group(open_groups: list[list[i64]], next_arm: list[i64], index: i64):
    let group = open_groups[len(open_groups) - 1]
    next_arm[group[len(group) - 1]] = index
    group.append(index)

# The first instruction of the `Switch` arm for `selected`: the matching
# `Case`, else the `Default` (the verifier requires one).
func select_arm(body: list[MirInstruction], plan: RegionPlan, opener: i64, selected: MirValue) -> i64:
    var arm = plan.next_arm[opener]
    var fallback = -1
    while arm >= 0:
        match body[arm].form:
            Case(value):
                if case_matches(value, selected): return arm + 1
            Default: fallback = arm
            else: trap("switch arm plan names a non-arm instruction")
        arm = plan.next_arm[arm]
    if fallback < 0: trap("verified Switch without a Default")
    return fallback + 1

func case_matches(candidate: i64, selected: MirValue) -> bool:
    match selected:
        SignedInt(value): return candidate == value
        UnsignedInt(value):
            if candidate < 0: return false
            return u64(candidate) == value
        else: trap("verified MIR switch received a non-integer tag")
