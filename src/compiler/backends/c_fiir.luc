#==============================================================================================
#
#   c_fiir - Target C adapter generation from validated FIIR
#
#   DESCRIPTION:
#       This is the first consumer allowed to turn FIIR target facts into a
#       physical boundary. It emits target-invariant carrier functions for QBE,
#       checks the selected C target's scalar representation and integer ranges,
#       and translates enumeration values through exact C constants. The sibling
#       FIIR generator emits only target-independent Luce source.
#
#==============================================================================================

import compiler.fiir.generator as fiir_products
from compiler.fiir.schema import FiirBoundaryValue, FiirCFloatingKind, FiirCIntegerKind, FiirEnumCase, FiirFunction, FiirIntegerValue, FiirModule, FiirType, FiirTypeForm, FiirTypeId, resolve_fiir_type, validate_fiir

# mark: Adapter translation ===================================================================

## Render the C side of one validated FIIR binding. All target-dependent
## spelling, limits, casts, and representation assertions terminate here.
pub func render_c_adapter(module: FiirModule, binding: str) -> str!:
    try validate_fiir(module)
    try fiir_products.validate_adapter_symbols(module, binding)
    var output = "/* Generated by " + module.generator_version + ". Do not edit. */\n"
    output += "#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n"
    output += "#include \"" + c_string(module.header) + "\"\n\n"
    for index in range(0, len(module.types)):
        output += try render_type_assertions(module, FiirTypeId(value = u32(index)))
    if len(module.types) > 0: output += "\n"
    for function in module.functions:
        if function.is_variadic:
            error("FIIR generation: variadic C function `" + function.name + "` requires a generated typed adapter")
        output += try render_function(module, binding, function)
    return output

func render_function(module: FiirModule, binding: str, function: FiirFunction) -> str!:
    let names = try fiir_products.adapter_names(module, function)
    let checked = try fiir_products.function_needs_status(module, function)
    let result_is_enumeration = try fiir_products.boundary_is_enumeration(module, function.result)
    var result = "enumeration"
    if not result_is_enumeration:
        result = try c_carrier_type(module, function.result, "function `" + function.name + "` result", true)
    var output = ""
    if checked: output += "int32_t"
    else: output += result
    output += " " + fiir_products.adapter_symbol(binding, function.name) + "("
    var emitted = 0
    for index in range(0, len(function.parameters)):
        let declaration = try render_adapter_declaration(
            module,
            function.parameters[index].boundary,
            names.parameters[index],
            "function `" + function.name + "` parameter `" + names.source_parameters[index] + "`",
            false,
        )
        if emitted > 0: output += ", "
        output += declaration
        emitted += adapter_value_arity(names.parameters[index])
    if checked and result != "void":
        if emitted > 0: output += ", "
        output += try render_adapter_declaration(module, function.result, names.result, "function `" + function.name + "` result", true)
        emitted += adapter_value_arity(names.result)
    if emitted == 0: output += "void"
    output += ") {\n"

    if checked and result != "void": output += render_zero_result(names.result)
    if checked:
        for index in range(0, len(function.parameters)):
            let value_type = try resolve_fiir_type(module, function.parameters[index].boundary.value_type)
            match value_type.form:
                Integer(kind, bits, is_signed):
                    if bits < u16(64):
                        match names.parameters[index]:
                            Scalar(name): output += "    if (" + integer_out_of_range(name, bits, is_signed) + ") return " + status_constant(fiir_products.FiirAdapterStatus.integer_range) + ";\n"
                            else: trap("integer FIIR parameter has an expanded adapter shape")
                else: pass

    let call_names = list[str]()
    let used = adapter_identifiers(names)
    for index in range(0, len(function.parameters)):
        if try fiir_products.boundary_is_enumeration(module, function.parameters[index].boundary):
            let local = fresh_c_name(used, "luce_native_" + str(index))
            output += try render_enumeration_input(module, function.parameters[index].boundary, names.parameters[index], local)
            call_names.append(local)
        else:
            match names.parameters[index]:
                Scalar(name): call_names.append(name)
                else: trap("scalar FIIR parameter has an expanded adapter shape")

    let call = try render_foreign_call(module, function, call_names)
    if result == "void": output += "    " + call + ";\n"
    elif result_is_enumeration: output += try render_enumeration_result(module, function.result, names.result, call, used)
    elif checked:
        match names.result:
            Scalar(name): output += "    *" + name + " = " + try render_result(module, function.result, call) + ";\n"
            else: trap("scalar FIIR result has an expanded adapter shape")
    else: output += "    return " + try render_result(module, function.result, call) + ";\n"
    if checked: output += "    return " + status_constant(fiir_products.FiirAdapterStatus.success) + ";\n"
    return output + "}\n\n"

# mark: Expanded adapter signatures ============================================================

func render_adapter_declaration(module: FiirModule, boundary: FiirBoundaryValue, names: fiir_products.FiirAdapterValueNames, context: str, is_output: bool) -> str!:
    match names:
        Unit: return ""
        Scalar(name):
            var pointer = " "
            if is_output: pointer = " *"
            return try c_carrier_type(module, boundary, context, false) + pointer + name
        Enumeration(is_negative, magnitude):
            var pointer = " "
            if is_output: pointer = " *"
            return "_Bool" + pointer + is_negative + ", uint64_t" + pointer + magnitude

func adapter_value_arity(names: fiir_products.FiirAdapterValueNames) -> i64:
    return match names:
        Unit => 0
        Scalar(name) => 1
        Enumeration(is_negative, magnitude) => 2

func adapter_identifiers(names: fiir_products.FiirAdapterNames) -> list[str]:
    let result = list[str]()
    for value in names.parameters: append_adapter_identifiers(result, value)
    append_adapter_identifiers(result, names.result)
    result.append(names.status)
    return result

func append_adapter_identifiers(result: list[str], names: fiir_products.FiirAdapterValueNames):
    match names:
        Unit: pass
        Scalar(name): result.append(name)
        Enumeration(is_negative, magnitude):
            result.append(is_negative)
            result.append(magnitude)

func render_zero_result(names: fiir_products.FiirAdapterValueNames) -> str:
    return match names:
        Unit => ""
        Scalar(name) => "    *" + name + " = 0;\n"
        Enumeration(is_negative, magnitude) => "    *" + is_negative + " = 0;\n    *" + magnitude + " = UINT64_C(0);\n"

func status_constant(status: fiir_products.FiirAdapterStatus) -> str:
    return "INT32_C(" + str(fiir_products.adapter_status_code(status)) + ")"

func fresh_c_name(used: list[str], candidate: str) -> str:
    var selected = candidate
    while contains_text(used, selected): selected = "_" + selected
    used.append(selected)
    return selected

func contains_text(values: list[str], wanted: str) -> bool:
    for value in values:
        if value == wanted: return true
    return false

# mark: Enumeration conversion =================================================================

func render_enumeration_input(module: FiirModule, boundary: FiirBoundaryValue, names: fiir_products.FiirAdapterValueNames, local: str) -> str!:
    let exact_type = module.types[boundary.value_type.value].spelling
    let enumeration = try resolve_fiir_type(module, boundary.value_type)
    match enumeration.form:
        Enumeration(name, c_spelling, cases, origin):
            match names:
                Enumeration(is_negative, magnitude):
                    var output = "    " + exact_type + " " + local + ";\n"
                    var emitted = false
                    for index in range(0, len(cases)):
                        if has_previous_value(cases, index): continue
                        output += "    "
                        if emitted: output += "else "
                        output += "if (" + enum_value_condition(is_negative, magnitude, cases[index].value) + ") "
                        output += local + " = " + cases[index].name + ";\n"
                        emitted = true
                    output += "    else return " + status_constant(fiir_products.FiirAdapterStatus.enumeration_input) + ";\n"
                    return output
                else: error("FIIR generation: C enum `" + name + "` has no expanded adapter input")
        else: error("FIIR generation: enumeration adapter input resolved to `" + enumeration.spelling + "`")

func render_enumeration_result(module: FiirModule, boundary: FiirBoundaryValue, names: fiir_products.FiirAdapterValueNames, call: str, used: list[str]) -> str!:
    let exact_type = module.types[boundary.value_type.value].spelling
    let enumeration = try resolve_fiir_type(module, boundary.value_type)
    match enumeration.form:
        Enumeration(name, c_spelling, cases, origin):
            match names:
                Enumeration(is_negative, magnitude):
                    let local = fresh_c_name(used, "luce_result")
                    var output = "    " + exact_type + " " + local + " = " + call + ";\n"
                    var emitted = false
                    for index in range(0, len(cases)):
                        if has_previous_value(cases, index): continue
                        output += "    "
                        if emitted: output += "else "
                        output += "if (" + local + " == " + cases[index].name + ") { "
                        match cases[index].value:
                            Negative(value): output += "*" + is_negative + " = 1; *" + magnitude + " = UINT64_C(" + str(value) + ");"
                            Nonnegative(value): output += "*" + is_negative + " = 0; *" + magnitude + " = UINT64_C(" + str(value) + ");"
                        output += " }\n"
                        emitted = true
                    output += "    else return " + status_constant(fiir_products.FiirAdapterStatus.enumeration_result) + ";\n"
                    return output
                else: error("FIIR generation: C enum `" + name + "` has no expanded adapter result")
        else: error("FIIR generation: enumeration adapter result resolved to `" + enumeration.spelling + "`")

func enum_value_condition(is_negative: str, magnitude: str, value: FiirIntegerValue) -> str:
    return match value:
        Negative(integer) => is_negative + " && " + magnitude + " == UINT64_C(" + str(integer) + ")"
        Nonnegative(integer) => "!" + is_negative + " && " + magnitude + " == UINT64_C(" + str(integer) + ")"

func has_previous_value(cases: list[FiirEnumCase], index: i64) -> bool:
    for previous in range(0, index):
        if integer_values_equal(cases[previous].value, cases[index].value): return true
    return false

func integer_values_equal(left: FiirIntegerValue, right: FiirIntegerValue) -> bool:
    match left:
        Negative(left_value):
            match right:
                Negative(right_value): return left_value == right_value
                else: return false
        Nonnegative(left_value):
            match right:
                Nonnegative(right_value): return left_value == right_value
                else: return false

# mark: Foreign calls and results ===============================================================

func render_foreign_call(module: FiirModule, function: FiirFunction, names: list[str]) -> str!:
    var output = function.name + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        let boundary = function.parameters[index].boundary
        let value_type = module.types[boundary.value_type.value]
        match value_type.form:
            Typedef(target, origin): output += "(" + value_type.spelling + ")" + names[index]
            Enumeration(name, c_spelling, cases, origin): output += names[index]
            Boolean: output += names[index]
            Integer(kind, bits, is_signed): output += "(" + integer_spelling(kind) + ")" + names[index]
            Floating(kind, radix, significand_bits, maximum_exponent):
                if kind == FiirCFloatingKind.long_double: output += "(long double)" + names[index]
                else: output += names[index]
            else: error("FIIR generation: cannot pass C type `" + value_type.spelling + "` to a value adapter")
    return output + ")"

func render_result(module: FiirModule, boundary: FiirBoundaryValue, expression: str) -> str!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Boolean: return expression
        Integer(kind, bits, is_signed):
            let carrier = try c_carrier_type(module, boundary, "integer result", false)
            return "(" + carrier + ")(" + expression + ")"
        Floating(kind, radix, significand_bits, maximum_exponent):
            if kind == FiirCFloatingKind.long_double: return "(double)(" + expression + ")"
            return expression
        else: error("FIIR generation: cannot return C type `" + value_type.spelling + "` from a value adapter")

func c_carrier_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Integer(kind, bits, is_signed):
            if bits > u16(64): error("FIIR generation: " + context + " C type `" + value_type.spelling + "` exceeds the 64-bit integer carrier")
            if kind == FiirCIntegerKind.plain_char and not is_signed and bits == u16(64):
                error("FIIR generation: " + context + " unsigned plain C `char` exceeds the signed universal carrier")
        else: pass
    let carrier = try fiir_products.adapter_carrier_type(module, boundary, context, permits_unit)
    if carrier == "unit": return "void"
    if carrier == "i64": return "int64_t"
    if carrier == "u64": return "uint64_t"
    if carrier == "f32": return "float"
    if carrier == "f64": return "double"
    if carrier == "bool": return "_Bool"
    error("FIIR generation: no C carrier for Luce adapter type `" + carrier + "`")

# mark: Target representation assertions ======================================================

func render_type_assertions(module: FiirModule, type_id: FiirTypeId) -> str!:
    let value_type = module.types[type_id.value]
    match value_type.form:
        Unit: return ""
        Boolean:
            let size = value_type.size_bits else error("FIIR generation: C type `" + value_type.spelling + "` has no target size")
            return "_Static_assert(CHAR_BIT * sizeof(_Bool) == " + str(size) + ", \"FIIR C _Bool size changed\");\n"
        Integer(kind, bits, is_signed):
            let size = value_type.size_bits else error("FIIR generation: C type `" + value_type.spelling + "` has no target size")
            let spelling = integer_spelling(kind)
            let limits = integer_limits(kind)
            var output = "_Static_assert(CHAR_BIT * sizeof(" + spelling + ") == " + str(size) + ", \"FIIR C " + spelling + " size changed\");\n"
            if is_signed:
                output += "_Static_assert(" + limits + "_MIN == " + signed_minimum(bits) + " && " + limits + "_MAX == " + signed_maximum(bits) + ", \"FIIR C " + spelling + " range changed\");\n"
            else:
                output += "_Static_assert(" + limits + "_MAX == " + unsigned_maximum(bits) + ", \"FIIR C " + spelling + " range changed\");\n"
            return output
        Floating(kind, radix, significand_bits, maximum_exponent):
            let size = value_type.size_bits else error("FIIR generation: C type `" + value_type.spelling + "` has no target size")
            if kind == FiirCFloatingKind.single and radix == u16(2) and significand_bits == u16(24) and maximum_exponent == i32(128) and size == u16(32):
                return (
                    "_Static_assert(CHAR_BIT * sizeof(float) == 32, \"FIIR C float size changed\");\n"
                    + "_Static_assert(FLT_RADIX == 2 && FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128, \"FIIR C float format changed\");\n"
                )
            if kind == FiirCFloatingKind.double and radix == u16(2) and significand_bits == u16(53) and maximum_exponent == i32(1024) and size == u16(64):
                return (
                    "_Static_assert(CHAR_BIT * sizeof(double) == 64, \"FIIR C double size changed\");\n"
                    + "_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024, \"FIIR C double format changed\");\n"
                )
            if kind == FiirCFloatingKind.long_double and radix == u16(2) and significand_bits == u16(53) and maximum_exponent == i32(1024) and size == u16(64):
                return (
                    "_Static_assert(CHAR_BIT * sizeof(long double) == 64, \"FIIR C long double size changed\");\n"
                    + "_Static_assert(FLT_RADIX == 2 && LDBL_MANT_DIG == 53 && LDBL_MAX_EXP == 1024, \"FIIR C long double format changed\");\n"
                )
            return ""
        Enumeration(name, c_spelling, cases, origin): return ""
        Typedef(target, origin):
            let resolved = try resolve_fiir_type(module, type_id)
            match resolved.form:
                Enumeration(name, c_spelling, cases, enum_origin):
                    match module.types[target.value].form:
                        Enumeration(target_name, target_c_spelling, target_cases, target_origin):
                            if target_c_spelling == none: return ""
                        else: pass
                    let target_spelling = try exact_c_type(module.types[target.value])
                    return "_Static_assert(_Generic(((" + value_type.spelling + ")0), " + target_spelling + ": 1, default: 0), \"FIIR C typedef " + value_type.spelling + " target changed\");\n"
                else: pass
            let size = value_type.size_bits else error("FIIR generation: C typedef `" + value_type.spelling + "` has no target size")
            let target_spelling = try exact_c_type(module.types[target.value])
            return (
                "_Static_assert(CHAR_BIT * sizeof(" + value_type.spelling + ") == " + str(size) + ", \"FIIR C typedef " + value_type.spelling + " size changed\");\n"
                + "_Static_assert(_Generic(((" + value_type.spelling + ")0), " + target_spelling + ": 1, default: 0), \"FIIR C typedef " + value_type.spelling + " target changed\");\n"
            )

func exact_c_type(value_type: FiirType) -> str!:
    match value_type.form:
        Boolean: return "_Bool"
        Integer(kind, bits, is_signed): return integer_spelling(kind)
        Floating(kind, radix, significand_bits, maximum_exponent):
            return match kind:
                single => "float"
                double => "double"
                long_double => "long double"
        Enumeration(name, c_spelling, cases, origin):
            let spelling = c_spelling else error("FIIR generation: anonymous C enum `" + name + "` has no direct C spelling")
            return spelling
        Typedef(target, origin): return value_type.spelling
        Unit: error("FIIR generation: a scalar typedef cannot target `void`")

func integer_out_of_range(name: str, bits: u16, is_signed: bool) -> str:
    if is_signed: return name + " < " + signed_minimum(bits) + " || " + name + " > " + signed_maximum(bits)
    return name + " > " + unsigned_maximum(bits)

func signed_minimum(bits: u16) -> str:
    if bits == u16(64): return "INT64_MIN"
    let magnitude = u64(1) << u64(bits - u16(1))
    return "-INT64_C(" + str(magnitude) + ")"

func signed_maximum(bits: u16) -> str:
    if bits == u16(64): return "INT64_MAX"
    let value = (u64(1) << u64(bits - u16(1))) - u64(1)
    return "INT64_C(" + str(value) + ")"

func unsigned_maximum(bits: u16) -> str:
    if bits == u16(64): return "UINT64_MAX"
    let value = (u64(1) << u64(bits)) - u64(1)
    return "UINT64_C(" + str(value) + ")"

func integer_spelling(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "char"
        signed_char => "signed char"
        unsigned_char => "unsigned char"
        signed_short => "short"
        unsigned_short => "unsigned short"
        signed_int => "int"
        unsigned_int => "unsigned int"
        signed_long => "long"
        unsigned_long => "unsigned long"
        signed_long_long => "long long"
        unsigned_long_long => "unsigned long long"

func integer_limits(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "CHAR"
        signed_char => "SCHAR"
        unsigned_char => "UCHAR"
        signed_short => "SHRT"
        unsigned_short => "USHRT"
        signed_int => "INT"
        unsigned_int => "UINT"
        signed_long => "LONG"
        unsigned_long => "ULONG"
        signed_long_long => "LLONG"
        unsigned_long_long => "ULLONG"

# mark: C text escaping ========================================================================

func c_string(value: str) -> str:
    var output = ""
    for character in value:
        if character == '\\': output += "\\\\"
        elif character == '"': output += "\\\""
        elif character == '\n' or character == char(13): output += " "
        else: output += str(character)
    return output
