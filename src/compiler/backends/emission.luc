#==============================================================================================
#
#   backend_emission - Per-function artifact accounting shared by backends
#
#   DESCRIPTION:
#       Backends report only canonical function identity, emitted byte count,
#       and translation time. Source/generic provenance stays in the compiler
#       reporting layer and is joined there; no source concept enters backend
#       lowering or artifact layout.
#
#==============================================================================================

from compiler.mir.canonical import FunctionId

# mark: Emission records ======================================================================

pub struct FunctionEmission:
    pub let function: FunctionId
    pub let code_bytes: u64
    pub let codegen_time_ms: i64

pub struct TextEmission:
    pub let text: str
    pub let functions: list[FunctionEmission]

pub struct BinaryEmission:
    pub let bytes: list[u8]
    pub let functions: list[FunctionEmission]
