#==============================================================================================
#
#   hir_execution_model - The run-state vocabulary of the HIR interpreter
#
#   DESCRIPTION:
#       The values that flow between the reference interpreter's walkers: live
#       bindings, resolved assignment places, how a statement or expression
#       left, and the narrow set of services the interpreter lends to its
#       full-profile consumer. Keeping them here lets `backends/interpreter`
#       and `profiles/full/backends/hir_execution` share one vocabulary while
#       the dependency runs one way, exactly as `mir/lowering_model` does for
#       lowering.
#
#==============================================================================================

from compiler.hir.ir import BoxedValue, ClassFinalizer, HirFunction, NodeId, Operands, SymbolId, TypeId, Value

# mark: Run state =============================================================================

# One live local: the value currently bound to a symbol in some call frame.
pub struct Binding:
    pub let symbol: SymbolId
    pub let value: Value

# One resolved step of an assignment place. Dynamic index expressions have
# already run when an Element reaches the value-rebuilding helpers.
pub union AssignmentPlaceStep:
    Field(index: i64)
    ClassField(index: i64)
    WeakField(index: i64)
    Element(index: i64)
    ListElement(index: i64)
    MutableSliceElement(index: i64)
    MapElement(key: BoxedValue)

# A mutable place: a binding and resolved field/element steps to its value.
pub struct Place:
    pub let symbol: SymbolId
    pub let steps: list[AssignmentPlaceStep]

# What one call produced, plus the receiver's final value so a mutating
# method's writes to `self` can be copied back into the caller's place.
pub struct Invocation:
    pub let value: Value
    pub let receiver: Value

# How one statement left: fall through to the next, return a value, or unwind
# to the enclosing loop.
pub union Execution:
    Next
    Returned(value: Value)
    Raised(error_value: Value)
    Recovered(value: Value)
    ## `break`/`continue` still travelling out through `levels` more loops.
    Broke(levels: i64)
    Continued(levels: i64)

# Expression evaluation either produces its typed value or transfers control
# through the surrounding statement/scope. Host `!` remains reserved for
# traps and compiler/runtime faults; recoverable Luce failure never uses it.
pub union Evaluation:
    Evaluated(value: Value)
    Transferred(execution: Execution)

pub union PlaceUpdate:
    Updated(value: Value)
    Transferred(execution: Execution)

pub union RunEvaluation:
    EvaluatedRun(values: list[BoxedValue])
    TransferredRun(execution: Execution)

pub union PlaceEvaluation:
    EvaluatedPlace(place: Place, value: Value)
    TransferredPlace(execution: Execution)

## The code identity and captured environment behind a callable value that
## carries state. Absent for plain functions and C callables.
pub struct ClosureTarget:
    pub let function: SymbolId
    pub let captures: list[Value]

## One profile-owned assignment step, resolved: the recorded step and the
## value it selected, or the control transfer its index expression made.
pub union PlaceStepResolution:
    Resolved(step: AssignmentPlaceStep, current: Value)
    Transferred(execution: Execution)

# mark: Execution services ====================================================================

## The services `HirInterpreterRun` lends to the profile executor. A profile
## consumer evaluates and calls through these and never imports the
## interpreter, so the dependency runs one way.
## Frame number of the interpreter's heap: cells that `new`/`alloc` and the
## Base startup arguments live in, addressed by cell index in `global`.
pub let heap_frame: i64 = -2

pub interface HirExecutionHost:
    func evaluate(expression: NodeId, bindings: list[Binding]) -> Evaluation!
    ## Store one value in a fresh heap cell and answer its index.
    func allocate_heap_cell(value: Value) -> i64
    func execute_scope(statements: Operands, bindings: list[Binding]) -> Execution!
    func evaluate_mutable_place(value: NodeId, bindings: list[Binding]) -> PlaceEvaluation!
    func call(function: HirFunction, arguments: list[Value]) -> Invocation!
    func read_address(frame: i64, symbol: SymbolId, global: i64, path: list[i64]) -> Value!
    func write_address(frame: i64, symbol: SymbolId, global: i64, path: list[i64], stored: Value) -> !
    func invoke(function: HirFunction, arguments: list[Value]) -> Value!
    func call_with_captures(function: HirFunction, arguments: list[Value], captures: list[Value]) -> Invocation!
    func call_function_value(callable: Value, function_type: TypeId, arguments: list[Value]) -> Value!
    func find_function(symbol: SymbolId) -> HirFunction
    ## The ARC finalizer for class storage allocated by this domain.
    func class_finalizer() -> ClassFinalizer
    ## A fresh isolated interpreter domain over the same program and host
    ## capabilities: worker execution starts here.
    func fresh_domain() -> HirExecutionHost
