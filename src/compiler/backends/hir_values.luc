#==============================================================================================
#
#   hir_values - Bindings and places of the HIR interpreter
#
#   DESCRIPTION:
#       The interpreter's own value plumbing: binding lookup and assignment-
#       place reads and rebuilds over the execution model's steps. The
#       operators, equality, hashing, display, and numeric construction of
#       semantic values are language semantics and live in
#       `hir/evaluation.luc`; this module consumes them. The interpreter and
#       its profile executor both consume this module, so it imports neither.
#
#==============================================================================================

from compiler.backends.hir_execution_model import AssignmentPlaceStep, Binding
from compiler.hir.ir import BoxedValue, HashEntry, HashStorage, ListBuffer, ListStorage, SymbolId, Value, WeakClassStorage
from compiler.hir.evaluation import find_hash_entry, require_hash_shape_mutable

# mark: Bindings ==============================================================================

# Weak slots never expose their storage carrier to source semantics. Reading
# one atomically promotes a live host weak edge to the ordinary optional class
# value used for the remainder of the expression.
pub func weak_class_value(storage: WeakClassStorage) -> Value:
    let target = storage.target
    if target == none: return Value.Absent
    if not target.is_alive: return Value.Absent
    return Value.Present(value = BoxedValue(value = Value.Class(storage = target)))

# Store one source optional class value without retaining its referent.
pub func weak_class_storage_value(value: Value) -> Value:
    match value:
        Absent: return Value.WeakClass(storage = WeakClassStorage(none))
        Present(boxed):
            match boxed.value:
                Class(storage): return Value.WeakClass(storage = WeakClassStorage(storage))
                else: trap("weak field received a non-class optional payload")
        else: trap("weak field received a non-optional HIR value")

# The place an expression names: a reference, or fields reached from one.
# Read the value selected by a fully evaluated mixed field/array place.
pub func value_at_assignment_place(value: Value, steps: list[AssignmentPlaceStep], start: i64) -> Value!:
    if start >= len(steps): return value
    match steps[start]:
        Field(index):
            match value:
                Record(fields): return try value_at_assignment_place(fields[index].value, steps, start + 1)
                else: trap("field step applied to a non-struct HIR value")
        ClassField(index):
            match value:
                Class(storage): return try value_at_assignment_place(storage.fields[index].value, steps, start + 1)
                else: trap("class-field step applied to a non-class HIR value")
        WeakField(index):
            match value:
                Class(storage):
                    match storage.fields[index].value:
                        WeakClass(slot): return try value_at_assignment_place(weak_class_value(slot), steps, start + 1)
                        else: trap("weak class field has owning storage")
                else: trap("weak-field step applied to a non-class HIR value")
        Element(index):
            match value:
                Array(elements):
                    if index < 0 or index >= len(elements): error("interpreter: index out of bounds")
                    return try value_at_assignment_place(elements[index].value, steps, start + 1)
                else: trap("element step applied to a non-array HIR value")
        ListElement(index):
            match value:
                List(storage):
                    if index < 0 or index >= len(storage.buffer.elements): error("interpreter: index out of bounds")
                    return try value_at_assignment_place(storage.buffer.elements[index].value, steps, start + 1)
                else: trap("list element step applied to a non-list HIR value")
        MutableSliceElement(index):
            match value:
                MutableSlice(storage):
                    if index < 0 or index >= len(storage.list.buffer.elements): error("interpreter: index out of bounds")
                    return try value_at_assignment_place(storage.list.buffer.elements[index].value, steps, start + 1)
                else: trap("mutable-slice element step applied to a non-view HIR value")
        MapElement(key):
            match value:
                Map(storage):
                    let selected = try find_hash_entry(storage, key.value)
                    if selected < 0: trap("absent map value was read as an assignment place")
                    return try value_at_assignment_place(storage.entries[selected].value.value, steps, start + 1)
                else: trap("map element step applied to a non-map HIR value")

# Preserve every immutable snapshot by moving a list identity to a new buffer
# immediately before its first subsequent write. Aliases share ListStorage and
# therefore observe the same detachment and mutation.
pub func detach_list(storage: ListStorage):
    if not storage.has_snapshot: return
    let elements = list[BoxedValue]()
    for element in storage.buffer.elements: elements.append(element)
    storage.buffer = ListBuffer(elements)
    storage.has_snapshot = false

# Rebuild each enclosing value aggregate with the selected place replaced.
pub func value_with_assignment_place(value: Value, steps: list[AssignmentPlaceStep], start: i64, replacement: Value) -> Value!:
    if start >= len(steps): return replacement
    match steps[start]:
        Field(selected):
            match value:
                Record(fields):
                    let rebuilt = list[BoxedValue]()
                    for index in range(0, len(fields)):
                        if index == selected:
                            rebuilt.append(BoxedValue(value = try value_with_assignment_place(fields[index].value, steps, start + 1, replacement)))
                        else: rebuilt.append(fields[index])
                    return Value.Record(fields = rebuilt)
                else: trap("field step applied to a non-struct HIR value")
        ClassField(selected):
            match value:
                Class(storage):
                    storage.fields[selected] = BoxedValue(value = try value_with_assignment_place(storage.fields[selected].value, steps, start + 1, replacement))
                    return value
                else: trap("class-field step applied to a non-class HIR value")
        WeakField(selected):
            if start + 1 != len(steps): trap("weak-field step cannot contain a nested assignment")
            match value:
                Class(storage):
                    storage.fields[selected] = BoxedValue(value = weak_class_storage_value(replacement))
                    return value
                else: trap("weak-field step applied to a non-class HIR value")
        Element(selected):
            match value:
                Array(elements):
                    if selected < 0 or selected >= len(elements): error("interpreter: index out of bounds")
                    let rebuilt = list[BoxedValue]()
                    for index in range(0, len(elements)):
                        if index == selected:
                            rebuilt.append(BoxedValue(value = try value_with_assignment_place(elements[index].value, steps, start + 1, replacement)))
                        else: rebuilt.append(elements[index])
                    return Value.Array(elements = rebuilt)
                else: trap("element step applied to a non-array HIR value")
        ListElement(selected):
            match value:
                List(storage):
                    if selected < 0 or selected >= len(storage.buffer.elements): error("interpreter: index out of bounds")
                    detach_list(storage)
                    storage.buffer.elements[selected] = BoxedValue(value = try value_with_assignment_place(storage.buffer.elements[selected].value, steps, start + 1, replacement))
                    return value
                else: trap("list element step applied to a non-list HIR value")
        MutableSliceElement(selected):
            match value:
                MutableSlice(storage):
                    if selected < 0 or selected >= len(storage.list.buffer.elements): error("interpreter: index out of bounds")
                    detach_list(storage.list)
                    storage.list.buffer.elements[selected] = BoxedValue(value = try value_with_assignment_place(storage.list.buffer.elements[selected].value, steps, start + 1, replacement))
                    return value
                else: trap("mutable-slice element step applied to a non-view HIR value")
        MapElement(key):
            if start + 1 != len(steps): trap("map element step cannot contain a nested assignment")
            match value:
                Map(storage):
                    let selected = try find_hash_entry(storage, key.value)
                    if selected >= 0:
                        storage.entries[selected].value = BoxedValue(value = replacement)
                    else:
                        try require_hash_shape_mutable(storage, "map")
                        storage.entries.append(HashEntry(key = key, value = BoxedValue(value = replacement)))
                    return value
                else: trap("map element step applied to a non-map HIR value")

# Remove locals introduced after a lexical scope began.
pub func trim_bindings(bindings: list[Binding], count: i64):
    while len(bindings) > count: bindings.remove(len(bindings) - 1)

# Innermost binding first, so a suite's binding wins over an outer one.
pub func find_binding(bindings: list[Binding], symbol: SymbolId) -> i64:
    var index = len(bindings) - 1
    while index >= 0:
        if bindings[index].symbol.value == symbol.value: return index
        index -= 1
    return -1
