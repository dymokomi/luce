#==============================================================================================
#
#   qbe_tasks - Isolated-worker wrappers and value codecs for QBE
#
#   DESCRIPTION:
#       Canonical task instructions retain named workers and target-neutral
#       value types. This module alone chooses QBE's process-backed realization:
#       spawn-site wrappers call the exact worker inside a forked runtime
#       snapshot, while recursive codecs serialize only sendable value graphs
#       into the supervisor's framed pipe.
#
#       The codec never inspects sealed-runtime storage. Lists, slices, hashes,
#       and immutable buffers are traversed through semantic runtime services;
#       aggregate byte offsets come only from backend `TypeLayout`.
#
#==============================================================================================

from compiler.backends.layout import LayoutRules, TypeLayout
from compiler.backends.qbe_representation import qbe_function_name, qbe_storage_alignment, qbe_store_instruction, qbe_worker_base_type, qbe_worker_load_instruction
from compiler.mir.canonical import BuiltinMirType, FunctionId, InstructionForm, MirFunction, MirProgram
from compiler.mir.canonical import MirTaskResult, RegisterId, TransferRun, TypeId, builtin_mir_type, find_runtime_binding, is_aggregate_type, mir_type, transfer_at
from compiler.mir.canonical import is_buffer_value_type
from compiler.runtime_contract import RuntimeService

# mark: Public names and emission ===============================================================

pub func qbe_task_worker_name(site: i64) -> str:
    return "luce_qbe_worker_" + str(site)

pub func qbe_task_encode_name(value_type: TypeId) -> str:
    return "luce_qbe_encode_" + str(value_type.value)

pub func qbe_task_decode_name(value_type: TypeId) -> str:
    return "luce_qbe_decode_" + str(value_type.value)

## Emit every worker wrapper and codec after ordinary program functions. The
## main QBE emitter and this scan visit spawn instructions in the same stable
## function/body order, so a compact site number is sufficient linkage.
pub func emit_qbe_task_helpers(program: MirProgram) -> str!:
    return try QbeTaskEmitter(program).emit()

# mark: Emitter state ==========================================================================

class QbeTaskEmitter:
    let program: MirProgram
    let layout: TypeLayout
    let needed: list[bool]
    var output: str
    var temporaries: i64
    var labels: i64

    init(program: MirProgram):
        self.program = program
        self.layout = TypeLayout(program.types, LayoutRules(pointer_size = 8, pointer_align = 8))
        self.needed = list[bool]()
        for definition in program.types.definitions: self.needed.append(false)
        self.output = ""
        self.temporaries = 0
        self.labels = 0

    func emit() -> str!:
        self.discover_codec_types()
        self.output = "data $luce_qbe_task_noop_fd = align 8 { l $luce_qbe_task_noop, l 0 }\n\n"
        self.output = self.output + "function $luce_qbe_task_noop(l %address) {\n@start\n\tret\n}\n\n"
        var site = 0
        for owner in self.program.functions:
            for instruction in owner.body:
                match instruction.form:
                    TaskSpawn(result, group, target, arguments):
                        try self.emit_worker(site, owner, result, target, arguments)
                        site += 1
                    else: pass
        for index in range(0, len(self.needed)):
            if not self.needed[index]: continue
            let value_type = TypeId(value = u32(index))
            try self.emit_encoder(value_type)
            try self.emit_decoder(value_type)
        return self.output

    # mark: Codec discovery ====================================================================

    func discover_codec_types():
        for function in self.program.functions:
            for instruction in function.body:
                match instruction.form:
                    TaskSpawn(result, group, target, arguments):
                        for index in range(0, i64(arguments.count)):
                            self.mark_type(transfer_at(function, arguments, index).value_type)
                        self.mark_task_type(function.registers[result.value])
                    TaskWait(result, destination, failure, error_destination, task):
                        self.mark_task_type(function.registers[task.value])
                    TaskWaitAll(result, failure, error_destination, tasks):
                        match mir_type(self.program.types, function.registers[tasks.value]):
                            List(element): self.mark_task_type(element)
                            else: pass
                    else: pass

    func mark_task_type(task_type: TypeId):
        match mir_type(self.program.types, task_type):
            Task(result, failure_type):
                self.mark_type(failure_type)
                match result:
                    Value(value_type): self.mark_type(value_type)
                    else: pass
            else: pass

    func mark_type(value_type: TypeId):
        if self.needed[value_type.value]: return
        self.needed[value_type.value] = true
        match mir_type(self.program.types, value_type):
            Struct(fields):
                if is_buffer_value_type(self.program.types, value_type): return
                for field in fields: self.mark_type(field.value_type)
            Array(element, count): self.mark_type(element)
            Enum(tag, cases):
                self.mark_type(tag)
                for case_type in cases: self.mark_type(case_type)
            FrozenList(element): self.mark_type(element)
            FrozenMap(key, item):
                self.mark_type(key)
                self.mark_type(item)
            FrozenSet(element): self.mark_type(element)
            Slice(element): self.mark_type(element)
            else: pass

    # mark: Worker wrappers ====================================================================

    func emit_worker(site: i64, owner: MirFunction, task_register: RegisterId, target: FunctionId, transfers: TransferRun) -> !:
        self.reset_locals()
        let task_type = owner.registers[task_register.value]
        var result = MirTaskResult.Unit
        var failure_type = builtin_mir_type(BuiltinMirType.pointer)
        match mir_type(self.program.types, task_type):
            Task(found_result, found_failure):
                result = found_result
                failure_type = found_failure
            else: error("qbe task backend: spawn result is not a task handle")
        let worker = self.program.functions[target.value]
        self.output = self.output + "function $" + qbe_task_worker_name(site) + "(l %context) {\n@start\n"

        let arguments = list[str]()
        var parameter_offset = 0
        var error_storage = ""
        var result_storage = ""
        if worker.signature.is_fallible:
            error_storage = self.allocate(failure_type)
            arguments.append("l " + error_storage)
            parameter_offset += 1
        match result:
            Value(value_type):
                if is_aggregate_type(self.program.types, value_type):
                    result_storage = self.allocate(value_type)
                    arguments.append("l " + result_storage)
                    parameter_offset += 1
            else: pass

        for index in range(0, i64(transfers.count)):
            let transfer = transfer_at(owner, transfers, index)
            let loaded = self.temp()
            let address = self.address("%context", index * 8)
            let representation = worker.signature.parameters[parameter_offset + index]
            self.line(loaded + " =" + try self.base_type(representation) + " " + try self.load_instruction(representation) + " " + address)
            arguments.append(try self.base_type(representation) + " " + loaded)

        var scalar_storage = ""
        match result:
            Value(value_type):
                if not is_aggregate_type(self.program.types, value_type): scalar_storage = self.allocate(value_type)
            else: pass

        var failure = ""
        if worker.signature.is_fallible:
            failure = self.temp()
            self.output = self.output + "\t" + failure + " =l call $" + self.function_name(target) + "(" + self.join(arguments)
            if scalar_storage != "":
                if len(arguments) > 0: self.output = self.output + ", "
                self.output = self.output + "l " + scalar_storage
            self.output = self.output + ")\n"
            let failed = self.temp()
            let failed_label = self.label_name("worker_failed")
            let succeeded_label = self.label_name("worker_succeeded")
            self.line(failed + " =w cnel " + failure + ", 0")
            self.output = self.output + "\tjnz " + failed + ", @" + failed_label + ", @" + succeeded_label + "\n"
            self.label(failed_label)
            # The fallible ABI returns the authoritative caller-owned Error
            # address. It normally equals `error_storage`, but the codec must
            # follow the contract rather than assume that identity.
            try self.publish_value(1, failure_type, failure)
            self.label(succeeded_label)
        else:
            match result:
                Unit, Never: self.output = self.output + "\tcall $" + self.function_name(target) + "(" + self.join(arguments) + ")\n"
                Value(value_type):
                    if is_aggregate_type(self.program.types, value_type):
                        self.output = self.output + "\tcall $" + self.function_name(target) + "(" + self.join(arguments) + ")\n"
                    else:
                        let scalar = self.temp()
                        self.output = self.output + "\t" + scalar + " =" + try self.base_type(value_type) + " call $" + self.function_name(target) + "(" + self.join(arguments) + ")\n"
                        try self.store_scalar_result(value_type, scalar_storage, scalar)

        match result:
            Unit: self.publish_empty_success()
            Never: self.line("hlt")
            Value(value_type):
                var address = result_storage
                if not is_aggregate_type(self.program.types, value_type): address = scalar_storage
                try self.publish_value(0, value_type, address)
        self.output = self.output + "}\n\n"

    func publish_empty_success():
        let writer = self.temp()
        self.line(writer + " =l call $luce_qbe_task_writer_create()")
        self.line("call $luce_qbe_task_writer_publish(l " + writer + ", w 0)")
        self.line("hlt")

    ## Worker calls carry binary16 in QBE's `s` class. Its cached wire value,
    ## like all ordinary MIR memory, is the exact two-byte IEEE encoding.
    func store_scalar_result(value_type: TypeId, address: str, value: str) -> !:
        match mir_type(self.program.types, value_type):
            Float(bits):
                if bits == 16:
                    let encoded = self.temp()
                    self.line(encoded + " =w call $luce.f16.to_bits(s " + value + ")")
                    self.line("storeh " + encoded + ", " + address)
                    return
            else: pass
        self.line(try self.store_instruction(value_type) + " " + value + ", " + address)

    func publish_value(state: i64, value_type: TypeId, address: str) -> !:
        let writer = self.temp()
        self.line(writer + " =l call $luce_qbe_task_writer_create()")
        self.line("call $" + qbe_task_encode_name(value_type) + "(l " + writer + ", l " + address + ")")
        self.line("call $luce_qbe_task_writer_publish(l " + writer + ", w " + str(state) + ")")
        self.line("hlt")

    # mark: Encoders ===========================================================================

    func emit_encoder(value_type: TypeId) -> !:
        self.reset_locals()
        self.output = self.output + "function $" + qbe_task_encode_name(value_type) + "(l %writer, l %address) {\n@start\n"
        try self.encode_at(value_type, "%address")
        self.line("ret")
        self.output = self.output + "}\n\n"

    func encode_at(value_type: TypeId, address: str) -> !:
        match mir_type(self.program.types, value_type):
            Int(bits, is_signed): self.write_bytes(address, self.layout.size_of(value_type))
            Float(bits): self.write_bytes(address, self.layout.size_of(value_type))
            Bool: self.write_bytes(address, 1)
            Uninhabited: pass
            Struct(fields):
                if is_buffer_value_type(self.program.types, value_type):
                    try self.encode_buffer(value_type, address)
                else:
                    for index in range(0, len(fields)):
                        try self.call_encoder(fields[index].value_type, self.address(address, self.layout.field_offset(value_type, index)))
            Array(element, count): try self.emit_encode_array(element, count, address)
            Enum(tag, cases): try self.emit_encode_enum(value_type, tag, cases, address)
            FrozenList(element): try self.emit_encode_sequence(value_type, element, address, false)
            Slice(element): try self.emit_encode_sequence(value_type, element, address, true)
            FrozenMap(key, item): try self.emit_encode_hash(key, item, address)
            FrozenSet(element): try self.emit_encode_hash(element, none, address)
            else: error("qbe task backend: non-sendable codec type reached QBE")

    func write_bytes(address: str, count: i64):
        if count == 0: return
        self.line("call $luce_qbe_task_writer_write(l %writer, l " + address + ", l " + str(count) + ")")

    func call_encoder(value_type: TypeId, address: str) -> !:
        self.line("call $" + qbe_task_encode_name(value_type) + "(l %writer, l " + address + ")")

    func encode_buffer(value_type: TypeId, address: str) -> !:
        let length = self.temp()
        let data = self.temp()
        # Static literals deliberately have no runtime owner; their canonical
        # buffer value still carries exact data and length fields. Serialize
        # those semantic fields directly and let the receiver create a fresh
        # owned buffer regardless of the sender's storage provenance.
        self.line(data + " =l loadl " + self.address(address, self.layout.field_offset(value_type, 1)))
        self.line(length + " =l loadl " + self.address(address, self.layout.field_offset(value_type, 2)))
        let length_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel " + length + ", " + length_address)
        self.write_bytes(length_address, 8)
        self.line("call $luce_qbe_task_writer_write(l %writer, l " + data + ", l " + length + ")")

    func emit_encode_array(element: TypeId, count: i64, address: str) -> !:
        if count <= 0: return
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("encode_array")
        let body = self.label_name("encode_array_body")
        let done = self.label_name("encode_array_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + str(count))
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        let item = self.scaled_address(address, current, self.layout.size_of(element))
        try self.call_encoder(element, item)
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)

    func emit_encode_enum(value_type: TypeId, tag: TypeId, cases: list[TypeId], address: str) -> !:
        try self.call_encoder(tag, address)
        if len(cases) == 0: return
        let selected = self.temp()
        self.line(selected + " =" + try self.base_type(tag) + " " + try self.load_instruction(tag) + " " + address)
        let finished = self.label_name("encode_enum_done")
        let invalid = self.label_name("encode_enum_invalid")
        for index in range(0, len(cases)):
            let chosen = self.label_name("encode_enum_case")
            var next = invalid
            if index + 1 < len(cases): next = self.label_name("encode_enum_next")
            let matches = self.temp()
            self.line(matches + " =w ceq" + try self.base_type(tag) + " " + selected + ", " + str(index))
            self.line("jnz " + matches + ", @" + chosen + ", @" + next)
            self.label(chosen)
            try self.call_encoder(cases[index], self.address(address, self.layout.enum_payload_offset(value_type)))
            self.line("jmp @" + finished)
            if next != invalid: self.label(next)
        self.label(invalid)
        self.line("hlt")
        self.label(finished)

    func emit_encode_sequence(handle_type: TypeId, element: TypeId, address: str, slice: bool) -> !:
        let handle = self.temp()
        self.line(handle + " =l loadl " + address)
        var length_service = RuntimeService.list_length
        var address_service = RuntimeService.list_element_address
        if slice:
            length_service = RuntimeService.slice_length
            address_service = RuntimeService.slice_element_address
        let length = self.temp()
        self.line(length + " =l call $" + try self.service_name(length_service) + "(l " + handle + ")")
        try self.encode_count_and_elements(handle, length, element, address_service)

    func encode_count_and_elements(handle: str, length: str, element: TypeId, address_service: RuntimeService) -> !:
        let count_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel " + length + ", " + count_address)
        self.write_bytes(count_address, 8)
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("encode_sequence")
        let body = self.label_name("encode_sequence_body")
        let done = self.label_name("encode_sequence_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + length)
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        let item = self.temp()
        self.line(item + " =l call $" + try self.service_name(address_service) + "(l " + handle + ", l " + str(self.layout.size_of(element)) + ", l " + current + ")")
        try self.call_encoder(element, item)
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)

    func emit_encode_hash(key: TypeId, item: TypeId?, address: str) -> !:
        let handle = self.temp()
        self.line(handle + " =l loadl " + address)
        let length = self.temp()
        self.line(length + " =l call $" + try self.service_name(RuntimeService.hash_length) + "(l " + handle + ")")
        let count_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel " + length + ", " + count_address)
        self.write_bytes(count_address, 8)
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("encode_hash")
        let body = self.label_name("encode_hash_body")
        let done = self.label_name("encode_hash_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + length)
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        let hash = self.temp()
        self.line(hash + " =l call $" + try self.service_name(RuntimeService.hash_entry_hash) + "(l " + handle + ", l " + current + ")")
        let hash_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel " + hash + ", " + hash_address)
        self.write_bytes(hash_address, 8)
        let key_address = self.temp()
        self.line(key_address + " =l call $" + try self.service_name(RuntimeService.hash_key_address) + "(l " + handle + ", l " + str(self.layout.size_of(key)) + ", l " + current + ")")
        try self.call_encoder(key, key_address)
        if item != none:
            let item_type = item
            let value_address = self.temp()
            self.line(value_address + " =l call $" + try self.service_name(RuntimeService.hash_value_address) + "(l " + handle + ", l " + str(self.layout.size_of(item_type)) + ", l " + current + ")")
            try self.call_encoder(item_type, value_address)
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)

    # mark: Decoders ===========================================================================

    func emit_decoder(value_type: TypeId) -> !:
        self.reset_locals()
        self.output = self.output + "function l $" + qbe_task_decode_name(value_type) + "(l %task, l %cursor, l %address) {\n@start\n"
        try self.decode_at(value_type, "%address")
        self.line("ret %cursor")
        self.output = self.output + "}\n\n"

    func decode_at(value_type: TypeId, address: str) -> !:
        match mir_type(self.program.types, value_type):
            Int(bits, is_signed): self.read_bytes(address, self.layout.size_of(value_type))
            Float(bits): self.read_bytes(address, self.layout.size_of(value_type))
            Bool: self.read_bytes(address, 1)
            Uninhabited: pass
            Struct(fields):
                if is_buffer_value_type(self.program.types, value_type):
                    try self.decode_buffer(value_type, address)
                else:
                    for index in range(0, len(fields)):
                        try self.call_decoder(fields[index].value_type, self.address(address, self.layout.field_offset(value_type, index)))
            Array(element, count): try self.emit_decode_array(element, count, address)
            Enum(tag, cases): try self.emit_decode_enum(value_type, tag, cases, address)
            FrozenList(element): try self.emit_decode_list(element, address, false)
            Slice(element): try self.emit_decode_list(element, address, true)
            FrozenMap(key, item): try self.emit_decode_hash(key, item, address)
            FrozenSet(element): try self.emit_decode_hash(element, none, address)
            else: error("qbe task backend: non-sendable codec type reached QBE")

    func read_bytes(address: str, count: i64):
        if count == 0: return
        let next = self.temp()
        self.line(next + " =l call $luce_qbe_task_read(l %task, l %cursor, l " + address + ", l " + str(count) + ")")
        self.guard_valid_cursor(next)
        self.line("%cursor =l copy " + next)

    func call_decoder(value_type: TypeId, address: str) -> !:
        self.line("%cursor =l call $" + qbe_task_decode_name(value_type) + "(l %task, l %cursor, l " + address + ")")

    func decode_buffer(value_type: TypeId, address: str) -> !:
        let length_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.read_bytes(length_address, 8)
        let length = self.temp()
        self.line(length + " =l loadl " + length_address)
        let builder = self.temp()
        self.line(builder + " =l call $" + try self.service_name(RuntimeService.buffer_builder_create) + "()")
        let empty = self.temp()
        let append = self.label_name("decode_buffer_append")
        let finish = self.label_name("decode_buffer_finish")
        self.line(empty + " =w ceql " + length + ", 0")
        self.line("jnz " + empty + ", @" + finish + ", @" + append)
        self.label(append)
        let data = self.temp()
        self.line(data + " =l call $luce_qbe_task_peek(l %task, l %cursor, l " + length + ")")
        let invalid = self.temp()
        self.line(invalid + " =w ceql " + data + ", 0")
        self.guard(invalid)
        self.line("call $" + try self.service_name(RuntimeService.buffer_builder_append) + "(l " + builder + ", l " + data + ", l " + length + ")")
        let advanced = self.temp()
        self.line(advanced + " =l add %cursor, " + length)
        self.line("%cursor =l copy " + advanced)
        self.line("jmp @" + finish)
        self.label(finish)
        let owner = self.temp()
        self.line(owner + " =l call $" + try self.service_name(RuntimeService.buffer_builder_finish) + "(l " + builder + ")")
        self.line("storel " + owner + ", " + self.address(address, self.layout.field_offset(value_type, 0)))
        let owner_data = self.temp()
        let owner_length = self.temp()
        self.line(owner_data + " =l call $" + try self.service_name(RuntimeService.buffer_data) + "(l " + owner + ")")
        self.line(owner_length + " =l call $" + try self.service_name(RuntimeService.buffer_length) + "(l " + owner + ")")
        self.line("storel " + owner_data + ", " + self.address(address, self.layout.field_offset(value_type, 1)))
        self.line("storel " + owner_length + ", " + self.address(address, self.layout.field_offset(value_type, 2)))

    func emit_decode_array(element: TypeId, count: i64, address: str) -> !:
        if count <= 0: return
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("decode_array")
        let body = self.label_name("decode_array_body")
        let done = self.label_name("decode_array_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + str(count))
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        try self.call_decoder(element, self.scaled_address(address, current, self.layout.size_of(element)))
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)

    func emit_decode_enum(value_type: TypeId, tag: TypeId, cases: list[TypeId], address: str) -> !:
        try self.call_decoder(tag, address)
        if len(cases) == 0: return
        let selected = self.temp()
        self.line(selected + " =" + try self.base_type(tag) + " " + try self.load_instruction(tag) + " " + address)
        let finished = self.label_name("decode_enum_done")
        let invalid = self.label_name("decode_enum_invalid")
        for index in range(0, len(cases)):
            let chosen = self.label_name("decode_enum_case")
            var next = invalid
            if index + 1 < len(cases): next = self.label_name("decode_enum_next")
            let matches = self.temp()
            self.line(matches + " =w ceq" + try self.base_type(tag) + " " + selected + ", " + str(index))
            self.line("jnz " + matches + ", @" + chosen + ", @" + next)
            self.label(chosen)
            try self.call_decoder(cases[index], self.address(address, self.layout.enum_payload_offset(value_type)))
            self.line("jmp @" + finished)
            if next != invalid: self.label(next)
        self.label(invalid)
        self.line("hlt")
        self.label(finished)

    func emit_decode_list(element: TypeId, address: str, slice: bool) -> !:
        let count_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.read_bytes(count_address, 8)
        let count = self.temp()
        self.line(count + " =l loadl " + count_address)
        let list_value = self.temp()
        self.line(list_value + " =l call $" + try self.service_name(RuntimeService.list_create) + "()")
        self.line("call $" + try self.service_name(RuntimeService.list_reserve) + "(l " + list_value + ", l " + str(self.layout.size_of(element)) + ", l " + str(self.storage_alignment(element)) + ", l " + count + ", l $luce_qbe_task_noop_fd)")
        try self.decode_list_elements(list_value, count, element)
        if slice:
            let slice_value = self.temp()
            self.line(slice_value + " =l call $" + try self.service_name(RuntimeService.list_slice) + "(l " + list_value + ", l " + str(self.layout.size_of(element)) + ", l 0, l " + count + ")")
            self.line("call $" + try self.service_name(RuntimeService.list_release) + "(l " + list_value + ", l " + str(self.layout.size_of(element)) + ", l " + str(self.storage_alignment(element)) + ", l $luce_qbe_task_noop_fd)")
            self.line("storel " + slice_value + ", " + address)
        else:
            self.line("storel " + list_value + ", " + address)

    func decode_list_elements(list_value: str, count: str, element: TypeId) -> !:
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("decode_list")
        let body = self.label_name("decode_list_body")
        let done = self.label_name("decode_list_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + count)
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        let slot = self.temp()
        self.line(slot + " =l call $" + try self.service_name(RuntimeService.list_append_slot) + "(l " + list_value + ", l " + str(self.layout.size_of(element)) + ", l " + str(self.storage_alignment(element)) + ", l $luce_qbe_task_noop_fd)")
        try self.call_decoder(element, slot)
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)

    func emit_decode_hash(key: TypeId, item: TypeId?, address: str) -> !:
        let count_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.read_bytes(count_address, 8)
        let count = self.temp()
        self.line(count + " =l loadl " + count_address)
        let hash_value = self.temp()
        self.line(hash_value + " =l call $" + try self.service_name(RuntimeService.hash_create) + "()")
        var value_size = 0
        var value_alignment = 1
        if item != none:
            let item_type = item
            value_size = self.layout.size_of(item_type)
            value_alignment = self.storage_alignment(item_type)
        let layout_arguments = ", l " + str(self.layout.size_of(key)) + ", l " + str(self.storage_alignment(key)) + ", l " + str(value_size) + ", l " + str(value_alignment)
        self.line("call $" + try self.service_name(RuntimeService.hash_reserve) + "(l " + hash_value + layout_arguments + ", l " + count + ")")
        let index = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index)
        let loop = self.label_name("decode_hash")
        let body = self.label_name("decode_hash_body")
        let done = self.label_name("decode_hash_done")
        self.line("jmp @" + loop)
        self.label(loop)
        let current = self.temp()
        let complete = self.temp()
        self.line(current + " =l loadl " + index)
        self.line(complete + " =w cugel " + current + ", " + count)
        self.line("jnz " + complete + ", @" + done + ", @" + body)
        self.label(body)
        let hash_address = self.allocate(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.read_bytes(hash_address, 8)
        let key_hash = self.temp()
        self.line(key_hash + " =l loadl " + hash_address)
        let inserted = self.temp()
        self.line(inserted + " =l call $" + try self.service_name(RuntimeService.hash_insert_entry) + "(l " + hash_value + layout_arguments + ", l " + key_hash + ")")
        let key_address = self.temp()
        self.line(key_address + " =l call $" + try self.service_name(RuntimeService.hash_key_address) + "(l " + hash_value + ", l " + str(self.layout.size_of(key)) + ", l " + inserted + ")")
        try self.call_decoder(key, key_address)
        if item != none:
            let item_type = item
            let value_address = self.temp()
            self.line(value_address + " =l call $" + try self.service_name(RuntimeService.hash_value_address) + "(l " + hash_value + ", l " + str(self.layout.size_of(item_type)) + ", l " + inserted + ")")
            try self.call_decoder(item_type, value_address)
        let next = self.temp()
        self.line(next + " =l add " + current + ", 1")
        self.line("storel " + next + ", " + index)
        self.line("jmp @" + loop)
        self.label(done)
        self.line("storel " + hash_value + ", " + address)

    # mark: QBE text and layout helpers =========================================================

    func service_name(service: RuntimeService) -> str!:
        let binding = find_runtime_binding(self.program, service) else error("qbe task backend: missing sealed runtime service for worker transfer")
        return self.function_name(binding)

    func function_name(id: FunctionId) -> str:
        return qbe_function_name(self.program, id)

    func base_type(value_type: TypeId) -> str!:
        return try qbe_worker_base_type(self.program, value_type)

    func load_instruction(value_type: TypeId) -> str!:
        return try qbe_worker_load_instruction(self.program, value_type)

    func store_instruction(value_type: TypeId) -> str!:
        return try qbe_store_instruction(self.program, value_type)

    func storage_alignment(value_type: TypeId) -> i64:
        return qbe_storage_alignment(self.layout, value_type)

    func allocate(value_type: TypeId) -> str:
        var instruction = "alloc4"
        let alignment = self.layout.align_of(value_type)
        if alignment > 8: instruction = "alloc16"
        elif alignment > 4: instruction = "alloc8"
        var size = self.layout.size_of(value_type)
        if size == 0: size = 1
        let result = self.temp()
        self.line(result + " =l " + instruction + " " + str(size))
        return result

    func address(base: str, offset: i64) -> str:
        if offset == 0: return base
        let result = self.temp()
        self.line(result + " =l add " + base + ", " + str(offset))
        return result

    func scaled_address(base: str, index: str, stride: i64) -> str:
        if stride == 0: return base
        var offset = index
        if stride != 1:
            offset = self.temp()
            self.line(offset + " =l mul " + index + ", " + str(stride))
        let result = self.temp()
        self.line(result + " =l add " + base + ", " + offset)
        return result

    func guard_valid_cursor(cursor: str):
        let invalid = self.temp()
        self.line(invalid + " =w ceql " + cursor + ", -1")
        self.guard(invalid)

    func guard(condition: str):
        let failed = self.label_name("codec_invalid")
        let okay = self.label_name("codec_valid")
        self.line("jnz " + condition + ", @" + failed + ", @" + okay)
        self.label(failed)
        self.line("hlt")
        self.label(okay)

    func join(values: list[str]) -> str:
        var result = ""
        for index in range(0, len(values)):
            if index > 0: result = result + ", "
            result = result + values[index]
        return result

    func reset_locals():
        self.temporaries = 0
        self.labels = 0

    func temp() -> str:
        let result = "%t" + str(self.temporaries)
        self.temporaries += 1
        return result

    func label_name(prefix: str) -> str:
        let result = prefix + str(self.labels)
        self.labels += 1
        return result

    func line(value: str):
        self.output = self.output + "\t" + value + "\n"

    func label(value: str):
        self.output = self.output + "@" + value + "\n"
