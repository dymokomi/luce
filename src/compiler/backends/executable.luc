#==============================================================================================
#
#   executable - Process-entry convention for native artifacts
#
#   DESCRIPTION:
#       Native backends share one entry rule: canonical MIR explicitly names
#       the process function selected from source HIR. Backends validate its
#       executable signature but never rediscover source visibility from a
#       symbol spelling.
#
#==============================================================================================

from compiler.mir.canonical import BuiltinMirType, FunctionId, MirProgram, builtin_mir_type

## Process executables start at the explicit `() -> i32` MIR entry.
pub func find_executable_entry(program: MirProgram) -> FunctionId!:
    let entry_id = program.entry else error("executable: needs one public `main`")
    if i64(entry_id.value) >= len(program.functions): error("executable: needs one public `main`")
    let entry = program.functions[entry_id.value]
    let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
    let signature = entry.signature
    if signature.is_fallible or len(signature.parameters) != 0 or len(signature.results) != 1 or signature.results[0].value != i32_type.value:
        error("executable: `" + entry.name + "` must be `() -> i32`")
    return entry_id
