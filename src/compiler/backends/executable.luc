#==============================================================================================
#
#   executable - Process-entry convention for native artifacts
#
#   DESCRIPTION:
#       Native backends share one entry rule: canonical MIR explicitly names
#       the process function selected from source HIR. Backends validate its
#       executable signature but never rediscover source visibility from a
#       symbol spelling.
#
#==============================================================================================

from compiler.mir.canonical import BuiltinMirType, FunctionId, MirProgram, MirSignature, builtin_mir_type, signatures_match

## Process executables start at the explicit fallible source entry. The
## backend supplies its argument adapter; this shared product check never
## introduces a host calling convention into MIR.
pub func find_executable_entry(program: MirProgram) -> FunctionId!:
    let entry = program.process_entry else error("executable: needs one public `main`")
    let entry_id = entry.function
    if i64(entry_id.value) >= len(program.functions): error("executable: needs one public `main`")
    let function = program.functions[entry_id.value]
    let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
    let pointer = builtin_mir_type(BuiltinMirType.pointer)
    let expected = MirSignature(parameters = [pointer, entry.arguments_type], results = [i32_type, pointer], is_fallible = true, returns_never = false)
    if not signatures_match(function.signature, expected):
        error("executable: `" + function.name + "` must be `(slice[str]) -> i32!`")
    return entry_id
