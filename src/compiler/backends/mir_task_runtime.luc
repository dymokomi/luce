#==============================================================================================
#
#   mir_task_runtime - Target-neutral values crossing MIR oracle task domains
#
#   DESCRIPTION:
#       A MIR task does not share the parent interpreter's memory or runtime
#       handle tables. Values therefore cross the boundary as an immutable,
#       pointer-free semantic tree. The MIR interpreter alone encodes and
#       decodes this tree using canonical TypeIds; this module owns only task
#       identity, cached terminal state, and structured-group membership.
#
#       This is oracle state, not a compiled runtime ABI. QBE and other
#       backends remain free to choose their own scheduler and transfer
#       representation while being checked against the same semantics.
#
#==============================================================================================

from compiler.mir.canonical import FunctionId, MirTaskResult, TypeId

# mark: Transferred values ====================================================================

## One recursively boxed value with no address from either interpreter
## domain. `Aggregate` preserves declaration order, while `Variant` records
## the canonical tag value separately from its selected payload.
pub class MirTransferredValue:
    pub let form: MirTransferredForm

    pub init(form: MirTransferredForm):
        self.form = form

pub struct MirTransferredHashEntry:
    pub let hash: u64
    pub let key: MirTransferredValue
    pub let value: MirTransferredValue?

pub union MirTransferredForm:
    Signed(value: i64)
    Unsigned(value: u64)
    Floating(value: f64)
    Boolean(value: bool)
    Aggregate(fields: list[MirTransferredValue])
    Variant(tag: MirTransferredValue, payload: MirTransferredValue)
    Buffer(bytes: list[u8])
    Sequence(elements: list[MirTransferredValue])
    Hash(entries: list[MirTransferredHashEntry])

# mark: Tasks and groups ======================================================================

## A cached terminal outcome is encoded independently of both domains. Unit
## success has no value; a never-returning worker cannot produce success.
pub union MirTaskOutcome:
    Succeeded(value: MirTransferredValue?)
    Failed(error_value: MirTransferredValue)
    Trapped(message: str)
    Cancelled

## One worker invocation owned by exactly one structured group. Arguments
## are captured at spawn, and the first wait replaces `none` with one cached
## outcome observed by every alias and repeated wait.
pub class MirTaskStorage:
    pub let function: FunctionId
    pub let arguments: list[MirTransferredValue]
    pub let argument_types: list[TypeId]
    pub let result: MirTaskResult
    pub let failure_type: TypeId
    pub var outcome: MirTaskOutcome?

    pub init(function: FunctionId, arguments: list[MirTransferredValue], argument_types: list[TypeId], result: MirTaskResult, failure_type: TypeId):
        self.function = function
        self.arguments = arguments
        self.argument_types = argument_types
        self.result = result
        self.failure_type = failure_type
        self.outcome = none

## Function-local ownership of every directly spawned child. Handles are
## deliberately non-owning; finishing a group cancels each pending child.
pub class MirTaskGroup:
    pub let children: list[MirTaskStorage]
    pub var is_finished: bool

    pub init():
        self.children = list[MirTaskStorage]()
        self.is_finished = false
