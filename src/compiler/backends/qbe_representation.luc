#==============================================================================================
#
#   qbe_representation - Shared physical representation decisions for QBE
#
#   DESCRIPTION:
#       The ordinary MIR emitter and isolated-worker codecs are two consumers
#       of one native backend boundary. They must agree on QBE value classes,
#       exact memory operations, symbol names, and runtime storage alignment.
#       Keeping those decisions here prevents worker transport from becoming a
#       second, subtly different backend.
#
#==============================================================================================

from compiler.backends.layout import LayoutRules, TypeLayout
from compiler.mir.canonical import CallingConvention, FunctionId, MirProgram, TypeId
from compiler.mir.canonical import describe_mir_type, is_aggregate_type, mir_type
import std.strings

# mark: IL text ===============================================================================

## Accumulates QBE IL as fragments and joins once (appending to one growing
## string copies it every time, which made emission quadratic in IL size),
## and names the temporaries and labels every emitter needs.
pub class IlWriter:
    let parts: list[str]
    pub var length: i64
    var temporaries: i64
    var labels: i64

    pub init():
        self.parts = list[str]()
        self.length = 0
        self.temporaries = 0
        self.labels = 0

    pub func write(text: str):
        self.parts.append(text)
        self.length += len(text)

    ## One indented instruction line.
    pub func line(text: str):
        self.write("\t" + text + "\n")

    ## One block label.
    pub func label(name: str):
        self.write("@" + name + "\n")

    ## A fresh temporary name; QBE temporaries are function-local.
    pub func temp() -> str:
        let name = "%q" + str(self.temporaries)
        self.temporaries += 1
        return name

    pub func new_label(prefix: str) -> str:
        let name = prefix + str(self.labels)
        self.labels += 1
        return name

    ## Restart temporary and label numbering, for example per function.
    pub func reset_names():
        self.temporaries = 0
        self.labels = 0

    pub func finish() -> str:
        return strings.join(self.parts, "")

# mark: Value classes =========================================================================

## Current QBE 1.3 targets all use 64-bit pointers. Keeping this rule beside
## every other QBE representation choice lets IL emission and ABI reporting
## share one backend-owned layout authority.
pub func qbe_layout_rules() -> LayoutRules:
    return LayoutRules(pointer_size = 8, pointer_align = 8)

## QBE temporary class for a canonical non-aggregate MIR value. Aggregates
## remain addresses and are admitted explicitly at worker-call boundaries.
pub func qbe_base_type(program: MirProgram, value_type: TypeId) -> str!:
    match mir_type(program.types, value_type):
        Int(bits, is_signed):
            if bits <= 32: return "w"
            return "l"
        PointerInt(is_signed): return "l"
        Float(bits):
            if bits <= 32: return "s"
            return "d"
        Bool: return "w"
        Ptr: return "l"
        BufferOwner: return "l"
        BufferBuilder: return "l"
        List(element): return "l"
        FrozenList(element): return "l"
        Map(key, value): return "l"
        FrozenMap(key, value): return "l"
        Set(element): return "l"
        FrozenSet(element): return "l"
        Slice(element): return "l"
        MutableSlice(element): return "l"
        Task(result, failure_type): return "l"
        TaskGroup: return "l"
        Class(identity): return "l"
        WeakClass(identity): return "l"
        Cell(element): return "l"
        Interface(identity): return "l"
        else: error("qbe backend: aggregate `" + describe_mir_type(program.types, value_type) + "` cannot occupy a temporary")

pub func qbe_worker_base_type(program: MirProgram, value_type: TypeId) -> str!:
    if is_aggregate_type(program.types, value_type): return "l"
    return try qbe_base_type(program, value_type)

## QBE ABI extension classes occur only on the C boundary.
pub func qbe_abi_type(program: MirProgram, value_type: TypeId) -> str!:
    if is_aggregate_type(program.types, value_type): return qbe_aggregate_type_name(value_type)
    match mir_type(program.types, value_type):
        Int(bits, is_signed):
            if bits == 8:
                if is_signed: return "sb"
                return "ub"
            if bits == 16:
                if is_signed: return "sh"
                return "uh"
            return try qbe_base_type(program, value_type)
        Bool: return "ub"
        else: return try qbe_base_type(program, value_type)

pub func qbe_aggregate_type_name(value_type: TypeId) -> str:
    return ":luce_t" + str(value_type.value)

# mark: Exact memory operations ================================================================

pub func qbe_load_instruction(program: MirProgram, value_type: TypeId) -> str!:
    match mir_type(program.types, value_type):
        Int(bits, is_signed):
            if bits == 8:
                if is_signed: return "loadsb"
                return "loadub"
            if bits == 16:
                if is_signed: return "loadsh"
                return "loaduh"
            if bits == 32: return "loadw"
            return "loadl"
        PointerInt(is_signed): return "loadl"
        Float(bits):
            if bits == 16: return "loaduh"
            if bits == 32: return "loads"
            return "loadd"
        Bool: return "loadub"
        Ptr: return "loadl"
        BufferOwner: return "loadl"
        BufferBuilder: return "loadl"
        List(element): return "loadl"
        FrozenList(element): return "loadl"
        Map(key, value): return "loadl"
        FrozenMap(key, value): return "loadl"
        Set(element): return "loadl"
        FrozenSet(element): return "loadl"
        Slice(element): return "loadl"
        Task(result, failure_type): return "loadl"
        TaskGroup: return "loadl"
        Class(identity): return "loadl"
        WeakClass(identity): return "loadl"
        Cell(element): return "loadl"
        Interface(identity): return "loadl"
        else: error("qbe backend: cannot load an aggregate")

pub func qbe_worker_load_instruction(program: MirProgram, value_type: TypeId) -> str!:
    if is_aggregate_type(program.types, value_type): return "loadl"
    # Spawn contexts contain QBE call values, not canonical value storage.
    # Binary16 therefore occupies an `s` slot here and is rounded into its
    # two-byte memory encoding only when a value actually enters memory.
    match mir_type(program.types, value_type):
        Float(bits):
            if bits == 16: return "loads"
        else: pass
    return try qbe_load_instruction(program, value_type)

pub func qbe_store_instruction(program: MirProgram, value_type: TypeId) -> str!:
    match mir_type(program.types, value_type):
        Int(bits, is_signed):
            if bits == 8: return "storeb"
            if bits == 16: return "storeh"
            if bits == 32: return "storew"
            return "storel"
        PointerInt(is_signed): return "storel"
        Float(bits):
            if bits == 16: return "storeh"
            if bits == 32: return "stores"
            return "stored"
        Bool: return "storeb"
        Ptr: return "storel"
        BufferOwner: return "storel"
        BufferBuilder: return "storel"
        List(element): return "storel"
        FrozenList(element): return "storel"
        Map(key, value): return "storel"
        FrozenMap(key, value): return "storel"
        Set(element): return "storel"
        FrozenSet(element): return "storel"
        Slice(element): return "storel"
        Task(result, failure_type): return "storel"
        TaskGroup: return "storel"
        Class(identity): return "storel"
        WeakClass(identity): return "storel"
        Cell(element): return "storel"
        Interface(identity): return "storel"
        else: error("qbe backend: cannot store an aggregate")

# mark: Layout and symbols =====================================================================

pub func qbe_storage_alignment(layout: TypeLayout, value_type: TypeId) -> i64:
    let alignment = layout.align_of(value_type)
    if alignment < layout.pointer_align(): return layout.pointer_align()
    return alignment

pub func qbe_function_name(program: MirProgram, id: FunctionId) -> str:
    if program.functions[id.value].convention == CallingConvention.c: return program.functions[id.value].name
    return "luce_f" + str(id.value)
