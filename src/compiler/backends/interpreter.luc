from compiler.profile import Profile
from compiler.reporting.resources import ResourceCensus
import std.strings

# mark: Run state =============================================================================

enum CRecordDirection:
    encode
    decode_result
    decode_argument

## Deterministic bindings for source `extern func` declarations. Artifact
## backends bind the same callable by their own host mechanism; the semantic
## oracle receives behavior explicitly and never consults ambient symbols.
## `result` is the declared C return (unit for void); `outputs` contains raw
## C-shaped values for every `out` slot in declaration order.
pub struct HirExternResult:
    pub let result: Value
    pub let outputs: list[Value]

pub interface HirExternHost:
    func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!

## Behavior for an opaque C function pointer returned by an extern. Keeping
## this separate from named declarations forces semantic tests to prove that
## the pointer identity really survived the boundary.
pub interface HirCFunctionPointerHost:
    func call(pointer: i64, arguments: list[Value]) -> Value!

## Explicit bytes behind opaque `foreign` tokens. The HIR oracle knows no
## address arithmetic or host pointer representation; tests provide only the
## two copying views exposed by the standard C helpers.
pub interface HirForeignMemoryHost:
    func copy_bytes(pointer: i64, count: u64) -> list[u8]!
    func copy_c_string(pointer: i64) -> list[u8]!

## Explicit mutable storage for source `extern var` declarations. Keeping it
## separate from callable bindings lets an oracle host provide only the kind
## of foreign state a test uses.
pub interface HirExternVariableHost:
    func load(variable: HirExternVariable) -> Value!
    func store(variable: HirExternVariable, value: Value) -> !

# One evaluated Base span: its first element's address and its length.
struct SpanView:
    let base: BoxedValue
    let length: i64

# One resolved Base pointer: the place it names.
struct AddressTarget:
    let frame: i64
    let symbol: SymbolId
    let global: i64
    let path: list[i64]

## The reusable interpreter backend. Each execution gets private program state.
pub class HirInterpreter: HirExecutionBackend:
    ## The layout rules this interpreter answers `sizeof`-family questions
    ## with; the host's 8-byte pointers unless a test chooses otherwise.
    let rules: LayoutRules

    ## Create a stateless HIR interpreter; each `run` owns its call frames.
    pub init(rules: LayoutRules? = none):
        self.rules = rules else LayoutRules(pointer_size = 8, pointer_align = 8)

    ## Run one selected function from an analyzed HIR program.
    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        return try HirInterpreterRun(program.hir, none, none, none, none, false, self.rules).run(module_name, function_name)

    ## Run the program's exact language process entry with semantic arguments.
    ## No host ABI is involved in the HIR oracle.
    pub func run_process(program: AnalyzedProgram, arguments: list[str]) -> Value!:
        return try HirInterpreterRun(program.hir, none, none, none, none, false, self.rules).run_process(arguments)

    ## Run with opt-in live-class and probable-cycle instrumentation. Ordinary
    ## `run` does not allocate observations or walk the resulting object graph.
    pub func run_with_resource_census(program: AnalyzedProgram, module_name: str, function_name: str) -> ResourceCensus!:
        let execution = HirInterpreterRun(program.hir, none, none, none, none, true, self.rules)
        let value = execution.run(module_name, function_name) catch reason:
            execution.discard_resource_domain()
            error(reason)
        match value:
            Unit: pass
            else:
                execution.discard_resource_domain()
                error("interpreter: resource census entry must return unit")
        let census = execution.resource_census()
        execution.discard_resource_domain()
        return census

    ## Run with explicit behavior for any host-supplied C functions reached.
    pub func run_with_host(program: AnalyzedProgram, module_name: str, function_name: str, host: HirExternHost) -> Value!:
        return try HirInterpreterRun(program.hir, host, none, none, none, false, self.rules).run(module_name, function_name)

    ## Run with C-owned global storage but no callable C imports.
    pub func run_with_globals(program: AnalyzedProgram, module_name: str, function_name: str, host: HirExternVariableHost) -> Value!:
        return try HirInterpreterRun(program.hir, none, host, none, none, false, self.rules).run(module_name, function_name)

    ## Run a program that uses both callable imports and C-owned globals.
    pub func run_with_hosts(program: AnalyzedProgram, module_name: str, function_name: str, functions: HirExternHost?, variables: HirExternVariableHost?) -> Value!:
        return try HirInterpreterRun(program.hir, functions, variables, none, none, false, self.rules).run(module_name, function_name)

    ## Run with both named extern bindings and arbitrary C function pointers.
    pub func run_with_c_function_pointers(program: AnalyzedProgram, module_name: str, function_name: str, functions: HirExternHost, pointers: HirCFunctionPointerHost) -> Value!:
        return try HirInterpreterRun(program.hir, functions, none, pointers, none, false, self.rules).run(module_name, function_name)

    ## Run C imports, arbitrary C function pointers, and opaque foreign memory
    ## through separate explicit capabilities. This is the complete semantic
    ## environment needed by `c.take_str` without ambient host access.
    pub func run_with_c_memory(program: AnalyzedProgram, module_name: str, function_name: str, functions: HirExternHost, pointers: HirCFunctionPointerHost?, memory: HirForeignMemoryHost) -> Value!:
        return try HirInterpreterRun(program.hir, functions, none, pointers, memory, false, self.rules).run(module_name, function_name)

    ## Invoke one exact C export as an external caller would: arguments arrive
    ## in C boundary form and the result leaves in that form. This keeps export
    ## adaptation inside the semantic oracle instead of teaching tests or
    ## hosts how tagged Luce optionals happen to be represented.
    pub func call_c_export(program: AnalyzedProgram, function_name: str, arguments: list[Value]) -> Value!:
        return try HirInterpreterRun(program.hir, none, none, none, none, false, self.rules).call_c_export(function_name, arguments)

# Executes one checked program directly by symbol identity.
# Frames the interpreter allows before reporting exhaustion. Unbounded
# recursion is a trap in the language (section 13.4); the bound is what turns
# it into a reported failure rather than the host's own stack limit, so it
# must trip well before the guard page does.
#
# Measured on 0.25/arm64-macOS, not guessed. One interpreted call costs six
# host frames: evaluate 8768 + execute 8768 + execute_scope 8944 + call 608 +
# evaluate_call 2832 + evaluate 2032, about 32 KiB. Under the 512 MiB
# Stage-0 reserves that is a true ceiling of 16625 frames for a thin callee
# and 12875 for a fat one; past it the process takes SIGBUS instead of
# reporting. 2000 keeps a sixfold margin and clears the deepest fixture
# (`down(1500)`).
#
# Two things this number is honest about. Real implementations divide by ten
# to a hundred, not six (Swift caps parser nesting at 256 under a ceiling
# near 28000; Clang the same shape), because per-frame cost depends on the
# shape of the input. And 32 KiB per call is itself eight to thirty times
# the 1-4 KiB a lean tree-walker spends — it is Stage-0 allocating a slot per
# `match` arm in walkers like `evaluate`, reported in
# `build/stage0-0.25-repro/`. The durable fix is thinner frames and a limit
# derived at startup from the real stack bounds, not a larger constant here;
# both are on the checklist in `plan.md` §5.
let frame_limit: i64 = 2000

# Mirror canonical MIR's zero-filled global storage as semantic values.
# HirGenerator has already rejected types for which zero would forge an
# address, callable, foreign handle, failure effect, or `never` value.
## The frame number of the reference interpreter's allocation cells.

# mark: Byte images ============================================================================

func zero_image(size: i64) -> list[u8]:
    let octets = list[u8]()
    for index in range(0, size): octets.append(u8(0))
    return octets

func overlay_at(image: list[u8], octets: list[u8], offset: i64) -> list[u8]:
    let copied = list[u8]()
    for index in range(0, len(image)):
        if index >= offset and index - offset < len(octets): copied.append(octets[index - offset])
        else: copied.append(image[index])
    return copied

func little_endian(bits: u64, count: i64) -> list[u8]:
    let octets = list[u8]()
    for index in range(0, count):
        if index >= 8: octets.append(u8(0))
        else: octets.append(u8((bits >> u64(index * 8)) & u64(255)))
    return octets

func from_little_endian(image: list[u8], offset: i64, count: i64) -> u64:
    var bits = u64(0)
    for index in range(0, count):
        if index >= 8: break
        bits = bits | (u64(image[offset + index]) << u64(index * 8))
    return bits

func integer_image(value: Value, size: i64) -> list[u8]?:
    match value:
        SignedInteger(item): return little_endian(signed_bits(item), size)
        UnsignedInteger(item): return little_endian(item, size)
        else: return none

# Two's complement bits of a signed value in a u64.
func signed_bits(value: i64) -> u64:
    if value >= 0: return u64(value)
    return u64(value + 9223372036854775807 + 1) + u64(9223372036854775807) + u64(1)

# The signed value whose low `bits` bits are `raw`.
func signed_from_bits(raw: u64, bits: i64) -> i64:
    if bits < 64: return wrap_signed(i64(raw & ((u64(1) << u64(bits)) - u64(1))), bits)
    if raw < u64(9223372036854775807) + u64(1): return i64(raw)
    return i64(raw - u64(9223372036854775807) - u64(1)) + (-9223372036854775807 - 1)

# Does a type have a zero value the reference interpreter can hold? A bare
# pointer or function has none; a union member of such a type starts unreadable.
func has_structural_zero(program: HirProgram, value_type: TypeId) -> bool:
    match program.types.definitions[value_type.value].form:
        Pointer(pointee, is_const, is_volatile): return false
        Function(parameters, result): return false
        CFunction(parameters, result): return false
        Interface(index, arguments): return false
        Array(element, count): return has_structural_zero(program, element)
        Tuple(elements):
            for element in elements:
                if not has_structural_zero(program, element): return false
            return true
        Struct(index, arguments):
            if program.structs[index].layout == HirRecordLayout.overlapping: return true
            for field in nominal_fields(program, value_type):
                if not has_structural_zero(program, field.value_type): return false
            return true
        else: return true

func zero_hir_value(program: HirProgram, value_type: TypeId) -> Value:
    match program.types.definitions[value_type.value].form:
        Boolean: return Value.Boolean(value = false)
        Integer(bits, is_signed):
            if is_signed: return Value.SignedInteger(value = 0)
            return Value.UnsignedInteger(value = u64(0))
        PointerInteger(is_signed):
            if is_signed: return Value.SignedInteger(value = 0)
            return Value.UnsignedInteger(value = u64(0))
        Floating(bits): return Value.Floating(value = 0.0)
        Character: return Value.Character(value = char(0))
        String: return Value.Text(value = "")
        Bytes: return Value.Bytes(value = list[u8]())
        Range(element):
            return Value.Record(fields = [
                BoxedValue(value = zero_hir_value(program, element)),
                BoxedValue(value = zero_hir_value(program, element)),
                BoxedValue(value = Value.Boolean(value = false)),
            ])
        Array(element, count):
            let elements = list[BoxedValue]()
            for index in range(0, count): elements.append(BoxedValue(value = zero_hir_value(program, element)))
            return Value.Array(elements = elements)
        Optional(inner): return Value.Absent
        Tuple(elements):
            let values = list[BoxedValue]()
            for element in elements: values.append(BoxedValue(value = zero_hir_value(program, element)))
            return Value.Tuple(elements = values)
        # An empty span or text points nowhere it may read (base.md §5.4).
        Span(element, is_const): return Value.Span(base = BoxedValue(value = Value.Address(frame = -1, symbol = SymbolId(value = no_node), global = -1, path = list[i64]())), length = 0)
        StringView: return Value.Span(base = BoxedValue(value = Value.Address(frame = -1, symbol = SymbolId(value = no_node), global = -1, path = list[i64]())), length = 0)
        Struct(index, arguments):
            let fields = list[BoxedValue]()
            let is_union = program.structs[index].layout == HirRecordLayout.overlapping
            for field in nominal_fields(program, value_type):
                # A union is zeroed as bytes; a member with no zero of its own
                # starts unreadable (base.md §10.4).
                if is_union and not has_structural_zero(program, field.value_type): fields.append(BoxedValue(value = Value.Unit))
                else: fields.append(BoxedValue(value = zero_hir_value(program, field.value_type)))
            return Value.Record(fields = fields)
        Enum(index, arguments):
            let representation = integer_enum_representation(program, value_type) else trap("checked runtime global has no structural zero")
            return zero_hir_value(program, representation)
        Atomic(inner): return zero_hir_value(program, inner)
        else: trap("checked runtime global has no structural zero")

class HirInterpreterRun: ClassFinalizer, HirExecutionHost:
    let program: HirProgram
    let external_host: HirExternHost?
    let external_variable_host: HirExternVariableHost?
    let c_function_pointer_host: HirCFunctionPointerHost?
    let foreign_memory_host: HirForeignMemoryHost?
    ## Luce-owned module state belongs to one interpreter instance and is
    ## distinct from C-owned globals supplied by `external_variable_host`.
    let globals: list[Value]
    ## The one dispatch point for full-Luce-only forms: collections, classes,
    ## closures, existential calls, and workers (profiles/full/backends/hir_execution.luc).
    let full: FullProfileExecution
    var depth: i64
    # Symbol-indexed lookup over the program's functions.
    let function_by_symbol: list[i64]
    # The bindings of every live call, innermost last, so a Base pointer to a
    # caller's local (`Value.Address`) can be read and written from a callee.
    let frames: list[list[Binding]]
    # Program data the Base text views point into: one byte array per
    # literal, addressed as frame -1 (base.md §5.5).
    let literal_data: list[Value]
    ## Storage `new` and `alloc` hand out (base.md §12.2): each cell is one
    ## value or one array, addressed as frame `heap_frame`.
    let heap: list[Value]
    # Layout questions are answered with the compiled backends' own type
    # lowering and layout algorithm under `rules`; both are created on the
    # first question, since most programs ask none.
    let rules: LayoutRules
    var lowering: MirLoweringState?

    # Retain the immutable semantic program used for all calls in this run.
    pub init(program: HirProgram, external_host: HirExternHost?, external_variable_host: HirExternVariableHost?, c_function_pointer_host: HirCFunctionPointerHost?, foreign_memory_host: HirForeignMemoryHost?, collects_resources: bool, rules: LayoutRules):
        self.program = program
        self.external_host = external_host
        self.external_variable_host = external_variable_host
        self.c_function_pointer_host = c_function_pointer_host
        self.foreign_memory_host = foreign_memory_host
        self.function_by_symbol = list[i64]()
        for symbol in program.symbols:
            self.function_by_symbol.append(-1)
        for index in range(0, len(program.functions)):
            let symbol = program.functions[index].symbol.value
            if self.function_by_symbol[symbol] < 0: self.function_by_symbol[symbol] = index
        self.globals = list[Value]()
        for global in program.globals:
            # An initialised global takes its value when a run begins.
            if global.initializer.value != no_node: self.globals.append(Value.Unit)
            else: self.globals.append(zero_hir_value(program, global.value_type))
        self.full = FullProfileExecution(program, collects_resources)
        self.depth = 0
        self.rules = rules
        self.lowering = none
        self.frames = list[list[Binding]]()
        self.literal_data = list[Value]()
        self.heap = list[Value]()

    ## Host ARC reaches this callback exactly when an interpreted class loses
    ## its final strong reference. Source `deinit` runs before payload fields;
    ## removing those fields from the tail establishes reverse declaration
    ## order independently of the host list implementation.
    pub func finalize(class_type: TypeId, fields: list[BoxedValue], run_deinitializer: bool):
        self.full.finalize(self, class_type, fields, run_deinitializer)

    # mark: Base pointers =======================================================================
    #
    # A Base pointer is a place: the frame that owns the root binding (or a
    # global), then field and element indices. Reads and writes rebuild the
    # value along that path, as `PlaceAssignment` does for a local.

    func evaluate_address(pointer: NodeId, bindings: list[Binding]) -> AddressTarget!:
        match try self.evaluate(pointer, bindings):
            Evaluated(item):
                match item:
                    Address(frame, symbol, global, path): return AddressTarget(frame = frame, symbol = symbol, global = global, path = path)
                    else: trap("typed pointer operation received a non-address HIR value")
            Transferred(execution): error("interpreter: a pointer operand diverged")

    # Append a `PlaceAssignment`-shaped step run as indices: fields directly,
    # element steps by evaluating their index expression.
    func append_path_steps(path: list[i64], steps: Operands, bindings: list[Binding]) -> !:
        for position in range(0, i64(steps.count) // 2):
            let kind = u32(entry_at(self.program, steps, position * 2))
            let payload = entry_at(self.program, steps, position * 2 + 1)
            if kind == place_field_step: path.append(payload)
            elif kind == place_element_step:
                match try self.evaluate(NodeId(value = u32(payload)), bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(index): path.append(i64(index))
                            SignedInteger(index): path.append(index)
                            else: trap("element step index is not an integer")
                    Transferred(execution): error("interpreter: an index expression diverged")
            else: error("interpreter: a pointer path crosses a runtime collection")

    # Pointer arithmetic stays inside one array: the last step of the place
    # must index an array, and the count moves that index (base.md §7.7 leaves
    # anything else undefined; the oracle refuses it).
    func offset_address(target: AddressTarget, count: i64) -> Value!:
        if len(target.path) == 0: error("interpreter: trap: pointer arithmetic on a place that is not an array element")
        let parent_path = list[i64]()
        for index in range(0, len(target.path) - 1): parent_path.append(target.path[index])
        match try self.read_address(target.frame, target.symbol, target.global, parent_path):
            Array(elements):
                let moved = list[i64]()
                for step in parent_path: moved.append(step)
                let last = target.path[len(target.path) - 1] + count
                if last < 0 or last > len(elements): error("interpreter: trap: pointer arithmetic left its array")
                moved.append(last)
                return Value.Address(frame = target.frame, symbol = target.symbol, global = target.global, path = moved)
            else: error("interpreter: trap: pointer arithmetic on a place that is not an array element")

    func address_difference(left: AddressTarget, right: AddressTarget) -> i64!:
        let same_root = left.frame == right.frame and left.symbol.value == right.symbol.value and left.global == right.global
        if not same_root or len(left.path) != len(right.path) or len(left.path) == 0:
            error("interpreter: trap: pointer difference between two objects")
        for index in range(0, len(left.path) - 1):
            if left.path[index] != right.path[index]: error("interpreter: trap: pointer difference between two objects")
        return left.path[len(left.path) - 1] - right.path[len(right.path) - 1]

    func state_optional_pointer(value_type: TypeId) -> bool:
        match self.program.types.definitions[value_type.value].form:
            Optional(inner):
                match self.program.types.definitions[inner.value].form:
                    Pointer(pointee, is_const, is_volatile): return true
                    else: return false
            else: return false

    # mark: Text views =========================================================================

    func is_text_view(value_type: TypeId) -> bool:
        match self.program.types.definitions[value_type.value].form:
            StringView: return true
            else: return false

    # A literal's bytes become one program-data place; the view spans it.
    func literal_view(text: str) -> Value:
        let payload = list[BoxedValue]()
        for byte in strings.to_bytes(text): payload.append(BoxedValue(value = Value.UnsignedInteger(value = u64(byte))))
        self.literal_data.append(Value.Array(elements = payload))
        let base = Value.Address(frame = -1, symbol = SymbolId(value = no_node), global = len(self.literal_data) - 1, path = [0])
        return Value.Span(base = BoxedValue(value = base), length = len(payload))

    # The bytes a view covers, read through its places.
    func view_bytes(seen: SpanView) -> list[u8]!:
        let payload = list[u8]()
        for position in range(0, seen.length):
            match try self.span_element_address(seen, position):
                Address(frame, symbol, global, path):
                    match try self.read_address(frame, symbol, global, path):
                        UnsignedInteger(byte): payload.append(u8(byte))
                        else: trap("a text view covers a non-byte")
                else: trap("span element address is not an address")
        return payload

    # Text views compare by bytes (base.md §5.5): -1, 0, or 1.
    func compare_views(left: Value, right: Value) -> i64!:
        var first = SpanView(base = BoxedValue(value = Value.Unit), length = 0)
        var second = SpanView(base = BoxedValue(value = Value.Unit), length = 0)
        match left:
            Span(base, length): first = SpanView(base = base, length = length)
            else: trap("text comparison received a non-view")
        match right:
            Span(base, length): second = SpanView(base = base, length = length)
            else: trap("text comparison received a non-view")
        let left_bytes = try self.view_bytes(first)
        let right_bytes = try self.view_bytes(second)
        for index in range(0, len(left_bytes)):
            if index >= len(right_bytes): return 1
            if left_bytes[index] < right_bytes[index]: return -1
            if left_bytes[index] > right_bytes[index]: return 1
        if len(right_bytes) > len(left_bytes): return -1
        return 0

    func evaluate_span(viewed: NodeId, bindings: list[Binding]) -> SpanView!:
        match try self.evaluate(viewed, bindings):
            Evaluated(item):
                match item:
                    Span(base, length): return SpanView(base = base, length = length)
                    else: trap("typed span operation received a non-span HIR value")
            Transferred(execution): error("interpreter: a span operand diverged")

    # The address of element `position`: the base moved along its array.
    func span_element_address(seen: SpanView, position: i64) -> Value!:
        match seen.base.value:
            Address(frame, symbol, global, path):
                if position == 0: return seen.base.value
                return try self.offset_address(AddressTarget(frame = frame, symbol = symbol, global = global, path = path), position)
            else: trap("span base is not an address")

    func root_of(frame: i64, symbol: SymbolId, global: i64) -> Value!:
        if frame == heap_frame: return self.heap[global]
        if frame < 0: return self.literal_data[global]
        if global >= 0: return self.globals[global]
        if frame < 0 or frame >= len(self.frames): error("interpreter: trap: a pointer outlived the frame that owned its place")
        let index = find_binding(self.frames[frame], symbol)
        if index < 0: error("interpreter: trap: a pointer outlived the binding that owned its place")
        return self.full.binding_value(self.frames[frame][index].value)

    pub func read_address(frame: i64, symbol: SymbolId, global: i64, path: list[i64]) -> Value!:
        var current = try self.root_of(frame, symbol, global)
        for step in path:
            match current:
                Record(fields): current = fields[step].value
                Array(elements):
                    if step < 0 or step >= len(elements): error("interpreter: trap: index out of range")
                    current = elements[step].value
                else: trap("pointer path step applied to a non-aggregate HIR value")
        return current

    pub func write_address(frame: i64, symbol: SymbolId, global: i64, path: list[i64], stored: Value) -> !:
        let root = try self.root_of(frame, symbol, global)
        var updated = try self.replaced_at(root, path, 0, stored)
        let owner_type = self.root_type(frame, symbol, global)
        if owner_type != none: updated = try self.refresh_unions(owner_type, path, 0, updated)
        if frame == heap_frame:
            self.heap[global] = updated
            return
        if global >= 0:
            self.globals[global] = updated
            return
        let bindings = self.frames[frame]
        self.full.assign_binding(bindings, find_binding(bindings, symbol), updated)

    func replaced_at(current: Value, path: list[i64], position: i64, stored: Value) -> Value!:
        if position == len(path): return stored
        let step = path[position]
        match current:
            Record(fields):
                let copied = list[BoxedValue]()
                for index in range(0, len(fields)):
                    if index == step: copied.append(BoxedValue(value = try self.replaced_at(fields[index].value, path, position + 1, stored)))
                    else: copied.append(fields[index])
                return Value.Record(fields = copied)
            Array(elements):
                if step < 0 or step >= len(elements): error("interpreter: trap: index out of range")
                let copied = list[BoxedValue]()
                for index in range(0, len(elements)):
                    if index == step: copied.append(BoxedValue(value = try self.replaced_at(elements[index].value, path, position + 1, stored)))
                    else: copied.append(elements[index])
                return Value.Array(elements = copied)
            else: trap("pointer path step applied to a non-aggregate HIR value")

    # The reference interpreter is a backend for layout questions (design
    # §23.3): it lowers the type as the compiled backends do and answers under
    # its own pointer width, so `sizeof(usize)` follows `rules`.
    func layout_answer(query: LayoutQuery, subject: TypeId, field: i64) -> i64!:
        if self.lowering == none: self.lowering = MirLoweringState(self.program, list[SymbolId](), list[SymbolId]())
        let lowering = self.lowering else trap("layout lowering state was just created")
        # Layout questions are asked only by Base source (`sizeof`, unions,
        # allocation), so the answer follows Base's representations.
        lowering.use_representation(BaseProfileRepresentation())
        let lowered = lowering.lower_mir_type(subject) catch feature:
            error("interpreter: layout of a type the lowerer does not support yet: " + feature)
        return TypeLayout(lowering.types, self.rules).answer(query, lowered, field)


    # mark: Union images ========================================================================
    #
    # A union's members overlap one storage (base.md §10.4). The reference
    # interpreter keeps every member of a union value consistent with one
    # little-endian byte image: after any write below a union, the written
    # member's bytes overlay the image and the other members are decoded from
    # it. A member with no byte image (a pointer, a span, text) leaves the
    # others unreadable until the next write.

    func root_type(frame: i64, symbol: SymbolId, global: i64) -> TypeId?:
        if frame < 0: return none
        if global >= 0: return self.program.globals[global].value_type
        return self.program.symbols[symbol.value].value_type

    # The field and element indices of an assignment place, up to the first
    # step that leaves value records (a class field, a list element).
    func steps_path(steps: list[AssignmentPlaceStep]) -> list[i64]:
        let path = list[i64]()
        for step in steps:
            match step:
                Field(index): path.append(index)
                Element(index): path.append(index)
                else: return path
        return path

    # Rebuild every union on `path` after a write at its end.
    func refresh_unions(value_type: TypeId, path: list[i64], position: i64, value: Value) -> Value!:
        if position >= len(path): return value
        let step = path[position]
        match self.program.types.definitions[value_type.value].form:
            Struct(index, arguments):
                let fields = nominal_fields(self.program, value_type)
                match value:
                    Record(items):
                        if step < 0 or step >= len(items): return value
                        let copied = list[BoxedValue]()
                        for member in range(0, len(items)):
                            if member == step: copied.append(BoxedValue(value = try self.refresh_unions(fields[step].value_type, path, position + 1, items[step].value)))
                            else: copied.append(items[member])
                        if is_union_type(self.program, value_type): return try self.union_after_write(value_type, step, copied)
                        return Value.Record(fields = copied)
                    else: return value
            Array(element, count):
                match value:
                    Array(elements):
                        if step < 0 or step >= len(elements): return value
                        let copied = list[BoxedValue]()
                        for member in range(0, len(elements)):
                            if member == step: copied.append(BoxedValue(value = try self.refresh_unions(element, path, position + 1, elements[step].value)))
                            else: copied.append(elements[member])
                        return Value.Array(elements = copied)
                    else: return value
            Tuple(elements):
                match value:
                    Tuple(items):
                        if step < 0 or step >= len(items): return value
                        let copied = list[BoxedValue]()
                        for member in range(0, len(items)):
                            if member == step: copied.append(BoxedValue(value = try self.refresh_unions(elements[step], path, position + 1, items[step].value)))
                            else: copied.append(items[member])
                        return Value.Tuple(elements = copied)
                    else: return value
            else: return value

    # The union's members after member `written` changed: the previous image
    # (from any other member that still has one) under the new member's bytes.
    func union_after_write(union_type: TypeId, written: i64, members: list[BoxedValue]) -> Value!:
        let member_types = nominal_fields(self.program, union_type)
        let size = try self.layout_answer(LayoutQuery.size, union_type, 0)
        var image = zero_image(size)
        var widest = 0
        for index in range(0, len(members)):
            if index == written: continue
            let previous = try self.byte_image(members[index].value, member_types[index].value_type)
            if previous != none and len(previous) > widest:
                widest = len(previous)
                image = overlay_at(zero_image(size), previous, 0)
        let rebuilt = list[BoxedValue]()
        let written_image = try self.byte_image(members[written].value, member_types[written].value_type)
        if written_image == none:
            for index in range(0, len(members)):
                if index == written: rebuilt.append(members[written])
                else: rebuilt.append(BoxedValue(value = Value.Unit))
            return Value.Record(fields = rebuilt)
        image = overlay_at(image, written_image, 0)
        for index in range(0, len(members)):
            if index == written: rebuilt.append(members[written])
            else:
                let decoded = try self.decode_image(image, 0, member_types[index].value_type)
                rebuilt.append(BoxedValue(value = decoded else Value.Unit))
        return Value.Record(fields = rebuilt)

    # The little-endian bytes of a value, or none when it has no byte image.
    func byte_image(value: Value, value_type: TypeId) -> list[u8]?!:
        let size = try self.layout_answer(LayoutQuery.size, value_type, 0)
        match self.program.types.definitions[value_type.value].form:
            Boolean:
                match value:
                    Boolean(item):
                        if item: return little_endian(u64(1), size)
                        return little_endian(u64(0), size)
                    else: return none
            Integer(bits, is_signed): return integer_image(value, size)
            PointerInteger(is_signed): return integer_image(value, size)
            Character:
                match value:
                    Character(item): return little_endian(u64(u32(item)), size)
                    else: return none
            Floating(bits):
                match value:
                    Floating(item): return little_endian(ieee_float_bits(item, bits), size)
                    else: return none
            Enum(index, arguments):
                if integer_enum_representation(self.program, value_type) == none: return none
                return integer_image(value, size)
            Array(element, count):
                match value:
                    Array(elements):
                        let stride = try self.layout_answer(LayoutQuery.size, element, 0)
                        var image = zero_image(size)
                        for index in range(0, len(elements)):
                            let part = try self.byte_image(elements[index].value, element)
                            if part == none: return none
                            image = overlay_at(image, part, index * stride)
                        return image
                    else: return none
            Tuple(elements):
                match value:
                    Tuple(items):
                        var image = zero_image(size)
                        for index in range(0, len(items)):
                            let part = try self.byte_image(items[index].value, elements[index])
                            if part == none: return none
                            image = overlay_at(image, part, try self.layout_answer(LayoutQuery.offset, value_type, index))
                        return image
                    else: return none
            Struct(index, arguments):
                match value:
                    Record(items):
                        let fields = nominal_fields(self.program, value_type)
                        if is_union_type(self.program, value_type):
                            # Members agree, so the widest member with an image is the union's.
                            var best: list[u8]? = none
                            for member in range(0, len(items)):
                                let part = try self.byte_image(items[member].value, fields[member].value_type)
                                if part == none: continue
                                var take = true
                                if best != none: take = len(part) > len(best)
                                if take: best = overlay_at(zero_image(size), part, 0)
                            return best
                        var image = zero_image(size)
                        for member in range(0, len(items)):
                            let part = try self.byte_image(items[member].value, fields[member].value_type)
                            if part == none: return none
                            image = overlay_at(image, part, try self.layout_answer(LayoutQuery.offset, value_type, member))
                        return image
                    else: return none
            Optional(inner):
                # Only the null niche has an image: absent is address zero.
                if not self.state_optional_pointer(value_type): return none
                match value:
                    Absent: return zero_image(size)
                    else: return none
            else: return none

    # The value of `value_type` read from `image` at `offset`, or none when
    # the type has no byte image or the bytes are not one of its values.
    func decode_image(image: list[u8], offset: i64, value_type: TypeId) -> Value?!:
        let size = try self.layout_answer(LayoutQuery.size, value_type, 0)
        if offset < 0 or offset + size > len(image): return none
        match self.program.types.definitions[value_type.value].form:
            Boolean: return Value.Boolean(value = image[offset] != u8(0))
            Integer(bits, is_signed):
                let raw = from_little_endian(image, offset, size)
                if is_signed: return Value.SignedInteger(value = signed_from_bits(raw, bits))
                return Value.UnsignedInteger(value = raw)
            PointerInteger(is_signed):
                let raw = from_little_endian(image, offset, size)
                if is_signed: return Value.SignedInteger(value = signed_from_bits(raw, size * 8))
                return Value.UnsignedInteger(value = raw)
            Character:
                let raw = from_little_endian(image, offset, size)
                if raw > u64(1114111) or (raw >= u64(55296) and raw <= u64(57343)): return none
                return Value.Character(value = char(u32(raw)))
            Floating(bits):
                let raw = from_little_endian(image, offset, size)
                let item = ieee_float_value(raw, bits) catch reason:
                    return none
                return Value.Floating(value = item)
            Enum(index, arguments):
                let representation = integer_enum_representation(self.program, value_type)
                if representation == none: return none
                return try self.decode_image(image, offset, representation)
            Array(element, count):
                let stride = try self.layout_answer(LayoutQuery.size, element, 0)
                let elements = list[BoxedValue]()
                for index in range(0, count):
                    let item = try self.decode_image(image, offset + index * stride, element)
                    if item == none: return none
                    elements.append(BoxedValue(value = item))
                return Value.Array(elements = elements)
            Tuple(elements):
                let items = list[BoxedValue]()
                for index in range(0, len(elements)):
                    let item = try self.decode_image(image, offset + (try self.layout_answer(LayoutQuery.offset, value_type, index)), elements[index])
                    if item == none: return none
                    items.append(BoxedValue(value = item))
                return Value.Tuple(elements = items)
            Struct(index, arguments):
                let fields = nominal_fields(self.program, value_type)
                let items = list[BoxedValue]()
                if is_union_type(self.program, value_type):
                    for member in range(0, len(fields)):
                        let item = try self.decode_image(image, offset, fields[member].value_type)
                        items.append(BoxedValue(value = item else Value.Unit))
                    return Value.Record(fields = items)
                for member in range(0, len(fields)):
                    let item = try self.decode_image(image, offset + (try self.layout_answer(LayoutQuery.offset, value_type, member)), fields[member].value_type)
                    if item == none: return none
                    items.append(BoxedValue(value = item))
                return Value.Record(fields = items)
            Optional(inner):
                if not self.state_optional_pointer(value_type): return none
                if from_little_endian(image, offset, size) == u64(0): return Value.Absent
                return none
            else: return none

    # mark: Execution services ==================================================================
    #
    # The profile executor reaches the shared walkers only through these.

    pub func class_finalizer() -> ClassFinalizer:
        return self

    ## A worker runs in a fresh domain: the same program and explicit host
    ## capabilities, but fresh globals, frames, class storage, and groups.
    pub func fresh_domain() -> HirExecutionHost:
        return HirInterpreterRun(
            self.program,
            self.external_host,
            self.external_variable_host,
            self.c_function_pointer_host,
            self.foreign_memory_host,
            false,
            self.rules,
        )

    pub func resource_census() -> ResourceCensus:
        return self.full.resource_census()

    pub func discard_resource_domain():
        self.full.discard_resource_domain()

    ## Run one public function to its returned value. The convenience path
    ## supplies an empty semantic slice to the exact process entry; callers
    ## that model process arguments use `run_process` explicitly.
    pub func run(module_name: str, function_name: str) -> Value!:
        try self.initialize_globals()
        let function = try self.find_entry(module_name, function_name)
        if not function.is_public:
            error("interpreter: `" + module_name + "." + function_name + "` is private")
        let arguments = list[Value]()
        if self.full.takes_process_arguments(function):
            arguments.append(self.full.process_arguments(list[str]()))
        elif len(function.parameters) > 0:
            error("interpreter: entry function `" + module_name + "." + function_name + "` must take no arguments")
        let result = try self.invoke(function, arguments)
        match result:
            FallibleSuccess(success): return success.value
            FallibleFailure(failure):
                error("interpreter: unhandled failure from `" + module_name + "." + function_name + "`: " + render_error(try self.failure_with_text(failure.value)))
            else: return result

    ## Invoke the HIR-selected process entry directly. Backends separately
    ## prove that their host adapters construct this same semantic value.
    pub func allocate_heap_cell(value: Value) -> i64:
        self.heap.append(value)
        return len(self.heap) - 1

    pub func run_process(arguments: list[str]) -> Value!:
        try self.initialize_globals()
        let symbol = self.program.process_entry else error("interpreter: program has no process entry")
        let function = self.find_function(symbol)
        # The entry's parameter shape selects the profile that builds it:
        # a slice is full Luce's, a span is Base's.
        var argument_value = self.full.process_arguments(arguments)
        match self.program.types.definitions[function.parameters[0].value_type.value].form:
            Span(element, is_const): argument_value = try base_process_arguments(self.program, self, element, arguments)
            else: pass
        let result = try self.invoke(function, [argument_value])
        match result:
            FallibleSuccess(success): return success.value
            FallibleFailure(failure):
                error("interpreter: unhandled process failure: " + render_error(try self.failure_with_text(failure.value)))
            SignedInteger(status): return result
            else: trap("typed process entry returned a non-fallible value")

    # A Base error carries its texts as views (base.md §11.3); reading them
    # back gives the rendering the same words full Luce would show.
    func failure_with_text(value: Value) -> Value!:
        match value:
            Record(fields):
                if len(fields) != 2: return value
                var code = fields[0].value
                match code:
                    Record(code_fields):
                        if len(code_fields) == 2: code = Value.Record(fields = [BoxedValue(value = try self.text_of(code_fields[0].value)), code_fields[1]])
                    else: pass
                return Value.Record(fields = [BoxedValue(value = code), BoxedValue(value = try self.text_of(fields[1].value))])
            else: return value

    func text_of(value: Value) -> Value!:
        match value:
            Span(base, length):
                let text = strings.from_bytes(try self.view_bytes(SpanView(base = base, length = length))) else error("interpreter: trap: a text view holds invalid UTF-8")
                return Value.Text(value = text)
            else: return value

    # `new`/`alloc` (base.md §12.2): the allocator is asked, so its state and
    # its refusal are real, but the block it answers is not where the value
    # lives: the reference interpreter keeps each allocation in its own cell,
    # since its memory is values, not bytes.
    func evaluate_allocation(expression: NodeId, prelude: Operands, request: NodeId, initializer: NodeId, count: NodeId, zeroed: bool, code: NodeId, message: NodeId, bindings: list[Binding]) -> Evaluation!:
        let element = self.allocated_element_type(node_type(self.program, expression))
        for position in range(0, i64(prelude.count)):
            match try self.execute(node_at(self.program, prelude, position), bindings):
                Next: pass
                else: trap("an allocation prelude transferred control")
        var answered = Value.Unit
        match try self.evaluate(request, bindings):
            Evaluated(item): answered = item
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        match answered:
            Absent:
                var code_value = Value.Unit
                match try self.evaluate(code, bindings):
                    Evaluated(item): code_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        let failure = Value.Record(fields = [BoxedValue(value = code_value), BoxedValue(value = item)])
                        return Evaluation.Evaluated(value = Value.FallibleFailure(error_value = BoxedValue(value = failure)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            else: pass
        let cell = len(self.heap)
        let place = Value.Address(frame = heap_frame, symbol = SymbolId(value = no_node), global = cell, path = list[i64]())
        if count.value == no_node:
            var stored = Value.Unit
            if initializer.value != no_node:
                match try self.evaluate(initializer, bindings):
                    Evaluated(item): stored = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            else: stored = zero_hir_value(self.program, element)
            self.heap.append(stored)
            return Evaluation.Evaluated(value = Value.FallibleSuccess(value = BoxedValue(value = place)))
        var length = 0
        match try self.evaluate(count, bindings):
            Evaluated(item):
                match item:
                    UnsignedInteger(value): length = i64(value)
                    SignedInteger(value): length = value
                    else: trap("allocation count is not an integer")
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        let elements = list[BoxedValue]()
        for index in range(0, length): elements.append(BoxedValue(value = zero_hir_value(self.program, element)))
        self.heap.append(Value.Array(elements = elements))
        # A span's base names an element, as one formed from an array does.
        let first = Value.Address(frame = heap_frame, symbol = SymbolId(value = no_node), global = cell, path = [0])
        return Evaluation.Evaluated(value = Value.FallibleSuccess(value = BoxedValue(value = Value.Span(base = BoxedValue(value = first), length = length))))

    # The element an allocation's `T*!` or `T[]!` result holds.
    func allocated_element_type(fallible_type: TypeId) -> TypeId:
        var result = fallible_type
        match self.program.types.definitions[fallible_type.value].form:
            Fallible(inner): result = inner
            else: pass
        match self.program.types.definitions[result.value].form:
            Pointer(pointee, is_const, is_volatile): return pointee
            Span(element, is_const): return element
            else: trap("allocation yields neither a pointer nor a span")

    # A Base global starts at the constant its initialiser names (base.md
    # §6.3); every other global stays at its structural zero.
    func initialize_globals() -> !:
        for index in range(0, len(self.program.globals)):
            let node = self.program.globals[index].initializer
            if node.value == no_node: continue
            match try self.evaluate(node, list[Binding]()):
                Evaluated(item): self.globals[index] = item
                Transferred(execution): error("interpreter: the initialiser of global `" + self.program.globals[index].name + "` did not produce a value")

    func call_c_export(function_name: str, arguments: list[Value]) -> Value!:
        var selected: HirFunction? = none
        for function in self.program.functions:
            if function.name != function_name: continue
            match function.implementation:
                ExportedC(body):
                    if selected != none: error("interpreter: duplicate C export `" + function_name + "`")
                    selected = function
                else: pass
        let function = selected else error("interpreter: unknown C export `" + function_name + "`")
        if len(arguments) != len(function.parameters):
            error("interpreter: C export `" + function_name + "` expects " + str(len(function.parameters)) + " argument(s), got " + str(len(arguments)))
        let decoded = list[Value]()
        for index in range(0, len(arguments)):
            decoded.append(try self.decode_c_argument(function, arguments[index], function.parameters[index].value_type, "parameter `" + function.parameters[index].name + "`"))
        let result = try self.invoke(function, decoded)
        return try self.encode_c_value(function, result, function.result, "result")

    # mark: Functions and scopes ================================================================

    # Call one function: a fresh frame holding the arguments, then the body.
    pub func invoke(function: HirFunction, arguments: list[Value]) -> Value!:
        return (try self.call(function, arguments)).value

    # The parameters outlive the body's scope, so after the body runs the
    # frame still holds `self` as the method left it.
    pub func call(function: HirFunction, arguments: list[Value]) -> Invocation!:
        return try self.call_with_captures(function, arguments, list[Value]())

    pub func call_with_captures(function: HirFunction, arguments: list[Value], captures: list[Value]) -> Invocation!:
        match function.implementation:
            ExternalC(contract):
                let host = self.external_host else error("interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` has no host binding")
                let encoded = try self.encode_c_arguments(function, arguments)
                let external_result = try host.call(function, encoded)
                let result = try self.decode_c_result(function, contract, external_result)
                return Invocation(value = result, receiver = Value.Unit)
            else: pass
        if self.depth >= frame_limit: error("interpreter: call depth exceeded " + str(frame_limit) + " frames in `" + function.name + "`")
        let bindings = list[Binding]()
        self.full.bind_captures(function, captures, bindings)
        var index = 0
        while index < len(function.parameters):
            bindings.append(Binding(symbol = function.parameters[index].symbol, value = self.full.initial_binding(function.parameters[index].symbol, arguments[index])))
            index += 1

        self.full.begin_invocation()
        self.depth += 1
        self.frames.append(bindings)
        let outcome = self.execute_function_scope(function_body(function), bindings, true) catch reason:
            self.frames.remove(len(self.frames) - 1)
            self.depth -= 1
            self.full.end_invocation()
            error(reason)
        self.frames.remove(len(self.frames) - 1)
        self.depth -= 1
        self.full.end_invocation()
        var receiver = Value.Unit
        if len(bindings) > 0: receiver = bindings[0].value
        match outcome:
            Returned(value):
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner): return Invocation(value = Value.FallibleSuccess(value = BoxedValue(value = value)), receiver = receiver)
                    else: return Invocation(value = value, receiver = receiver)
            Raised(error_value):
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner): return Invocation(value = Value.FallibleFailure(error_value = BoxedValue(value = error_value)), receiver = receiver)
                    else: trap("failure escaped a non-fallible checked function")
            Next:
                if types_match(function.result, resolve_builtin_type(BuiltinType.unit)): return Invocation(value = Value.Unit, receiver = receiver)
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner):
                        if types_match(inner, resolve_builtin_type(BuiltinType.unit)):
                            return Invocation(value = Value.FallibleSuccess(value = BoxedValue(value = Value.Unit)), receiver = receiver)
                    else: pass
                trap("checked function `" + function.name + "` finished without returning a value")
            Recovered(value): trap("recover escaped its catch handler")
            else: trap("loop control escaped a function")

    # mark: Captured local storage ==============================================================

    # mark: C boundary ==========================================================================

    # Encode ordinary semantic values into the C-shaped values an explicit
    # host receives. This is a boundary operation: tagged optionals become a
    # zero/nonzero token, and a zero token in a bare pointer slot traps.
    func encode_c_arguments(function: HirFunction, arguments: list[Value]) -> list[Value]!:
        let encoded = list[Value]()
        for index in range(0, len(arguments)):
            encoded.append(try self.encode_c_value(function, arguments[index], function.parameters[index].value_type, "parameter `" + function.parameters[index].name + "`"))
        return encoded

    func encode_c_value(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        let c_enum = self.c_enum_shape(value_type)
        if c_enum != none:
            let shape = c_enum
            match value:
                Variant(case_index, payload):
                    if len(payload) != 0 or case_index < 0 or case_index >= len(shape.values):
                        trap("typed exported C enum contains an invalid case")
                    return shape.values[case_index]
                else: trap("typed exported C enum slot contains a non-enum value")
        if self.is_c_struct(value_type):
            return try self.transcode_c_struct(function, value, value_type, slot, CRecordDirection.encode)
        match self.program.types.definitions[value_type.value].form:
            List(element_type):
                match value:
                    List(storage):
                        # The semantic host receives an immutable C-shaped
                        # sequence. Compiled execution exposes the same dense
                        # elements without this oracle materialization.
                        let elements = list[BoxedValue]()
                        for index in range(0, len(storage.buffer.elements)):
                            elements.append(BoxedValue(value = try self.encode_c_component(
                                storage.buffer.elements[index].value,
                                element_type,
                                self.null_foreign(function, slot + " element " + str(index)),
                            )))
                        return Value.Array(elements = elements)
                    else: trap("typed borrowed-list slot contains a non-list value")
            else: pass
        if types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            match value:
                Text(text):
                    let encoded = strings.to_bytes(text)
                    encoded.append(u8(0))
                    return Value.Bytes(value = encoded)
                else: trap("typed string slot contains a non-string value")
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                Absent: return Value.CFunction(identity = HirCFunctionIdentity.ForeignPointer(token = 0))
                Present(item):
                    match item.value:
                        CFunction(identity): return item.value
                        else: trap("typed nullable cfunc contains a non-cfunc value")
                else: trap("typed nullable cfunc has a non-optional value")
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity):
                        match identity:
                            ForeignPointer(token):
                                if token == 0: error(self.null_foreign(function, slot))
                            Declared(symbol): pass
                        return value
                    else: trap("typed cfunc slot contains a non-cfunc value")
            else: pass

        return try self.encode_c_component(value, value_type, self.null_foreign(function, slot))

    # Decode the declared return and every output immediately after a C call,
    # then apply the one source result-shaping rule from HirGenerator.
    func decode_c_result(function: HirFunction, contract: HirCFunction, external: HirExternResult) -> Value!:
        let values = list[BoxedValue]()
        if types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            match external.result:
                Unit: pass
                else: error(self.incompatible_c_result(function, "result", contract.declared_result))
        else:
            values.append(BoxedValue(value = try self.decode_c_value(function, external.result, contract.declared_result, "result")))

        var expected_outputs = 0
        for slot in contract.slots:
            match slot:
                Output(name, value_type): expected_outputs += 1
                Input(parameter): pass
        if len(external.outputs) != expected_outputs:
            error("interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` returned " + str(len(external.outputs)) + " out value(s), expected " + str(expected_outputs))
        var output_index = 0
        for slot in contract.slots:
            match slot:
                Output(name, value_type):
                    values.append(BoxedValue(value = try self.decode_c_value(function, external.outputs[output_index], value_type, "out parameter `" + name + "`")))
                    output_index += 1
                Input(parameter): pass

        if len(values) == 0: return Value.Unit
        if len(values) == 1: return values[0].value
        return Value.Tuple(elements = values)

    # Decode one raw C value. A nullable pointer token becomes an ordinary
    # tagged optional. A bare handle still rejects null, while a bare cfunc may
    # retain it inertly until invocation or its next C input crossing.
    func decode_c_value(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        let c_enum = self.c_enum_shape(value_type)
        if c_enum != none:
            return try self.decode_c_enum(value, c_enum, self.incompatible_c_result(function, slot, value_type))
        if self.is_c_struct(value_type):
            return try self.transcode_c_struct(function, value, value_type, slot, CRecordDirection.decode_result)
        if types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            match value:
                Foreign(token):
                    if token == 0: error(self.null_foreign(function, slot))
                Bytes(raw):
                    let payload = list[u8]()
                    var terminated = false
                    for byte in raw:
                        if byte == u8(0):
                            terminated = true
                            break
                        payload.append(byte)
                    if not terminated: error(self.incompatible_c_result(function, slot, value_type))
                    let text = strings.from_bytes(payload) else error("interpreter: trap: invalid_utf8")
                    return Value.Text(value = text)
                else: pass
            error(self.incompatible_c_result(function, slot, value_type))
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                CFunction(identity):
                    match identity:
                        ForeignPointer(token):
                            if token == 0: return Value.Absent
                        Declared(symbol): pass
                    return Value.Present(value = BoxedValue(value = value))
                else: error(self.incompatible_c_result(function, slot, value_type))
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity): return value
                    else: error(self.incompatible_c_result(function, slot, value_type))
            else: pass

        return try self.decode_c_component(value, value_type, self.null_foreign(function, slot), self.incompatible_c_result(function, slot, value_type))

    func decode_c_argument(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        let c_enum = self.c_enum_shape(value_type)
        if c_enum != none:
            return try self.decode_c_enum(value, c_enum, self.incompatible_c_argument(function, slot, value_type))
        if self.is_c_struct(value_type):
            return try self.transcode_c_struct(function, value, value_type, slot, CRecordDirection.decode_argument)
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                CFunction(identity):
                    match identity:
                        ForeignPointer(token):
                            if token == 0: return Value.Absent
                        Declared(symbol): pass
                    return Value.Present(value = BoxedValue(value = value))
                else: error(self.incompatible_c_argument(function, slot, value_type))
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity):
                        match identity:
                            ForeignPointer(token):
                                if token == 0: error(self.null_foreign(function, slot))
                            Declared(symbol): pass
                        return value
                    else: error(self.incompatible_c_argument(function, slot, value_type))
            else: pass

        return try self.decode_c_component(value, value_type, self.null_foreign(function, slot), self.incompatible_c_argument(function, slot, value_type))

    func decode_c_enum(value: Value, shape: HirCEnum, incompatible: str) -> Value!:
        if not self.scalar_value_matches(value, shape.representation): error(incompatible)
        let canonical = self.canonical_scalar_value(value, shape.representation)
        for index in range(0, len(shape.values)):
            if integer_values_match(canonical, shape.values[index]):
                return Value.Variant(case_index = index, payload = list[BoxedValue]())
        error(incompatible)

    # Shared scalar/handle boundary vocabulary for declarations, exports, and
    # raw cfunc invocation. Aggregate and cfunc-container shapes are handled
    # by their explicit callers before entering this closed component path.
    func encode_c_component(value: Value, value_type: TypeId, null_error: str) -> Value!:
        if self.optional_data_pointer(value_type) != none:
            match value:
                Absent: return Value.Foreign(token = 0)
                Present(item):
                    match item.value:
                        Foreign(token): return Value.Foreign(token = token)
                        else: trap("typed data-pointer optional contains a non-pointer value")
                else: trap("typed data-pointer optional has a non-optional value")
        if types_match(value_type, resolve_builtin_type(BuiltinType.foreign)):
            match value:
                Foreign(token):
                    if token == 0: error(null_error)
                    return value
                else: trap("typed foreign slot contains a non-pointer value")
        let extern_index = self.extern_type_index(value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer:
                            if token == 0: error(null_error)
                        Integer(representation):
                            if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation):
                                trap("typed integer handle is outside its declared representation")
                    return value
                else: trap("typed handle slot contains a non-handle value")
        if self.scalar_value_matches(value, value_type): return self.canonical_scalar_value(value, value_type)
        trap("typed C argument is incompatible with its HIR slot")

    func decode_c_component(value: Value, value_type: TypeId, null_error: str, incompatible: str) -> Value!:
        if self.optional_data_pointer(value_type) != none:
            match value:
                Foreign(token):
                    if token == 0: return Value.Absent
                    return Value.Present(value = BoxedValue(value = Value.Foreign(token = token)))
                else: error(incompatible)
        if types_match(value_type, resolve_builtin_type(BuiltinType.foreign)):
            match value:
                Foreign(token):
                    if token == 0: error(null_error)
                    return value
                else: error(incompatible)
        let extern_index = self.extern_type_index(value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer:
                            if token == 0: error(null_error)
                        Integer(representation):
                            if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation): error(incompatible)
                    return value
                else: error(incompatible)
        if self.scalar_value_matches(value, value_type): return self.canonical_scalar_value(value, value_type)
        error(incompatible)

    func canonical_scalar_value(value: Value, value_type: TypeId) -> Value:
        if is_floating_type(self.program.types, value_type):
            match value:
                Floating(item): return Value.Floating(value = normalize_float(item, value_type, self.program.types))
                else: trap("validated floating slot contains a non-floating value")
        return value

    func scalar_value_matches(value: Value, value_type: TypeId) -> bool:
        if types_match(value_type, resolve_builtin_type(BuiltinType.unit)):
            match value:
                Unit: return true
                else: return false
        if types_match(value_type, resolve_builtin_type(BuiltinType.boolean)):
            match value:
                Boolean(item): return true
                else: return false
        if is_integer_type(self.program.types, value_type):
            if is_unsigned_integer_type(self.program.types, value_type):
                match value:
                    UnsignedInteger(item): return item <= unsigned_integer_maximum(self.program.types, value_type)
                    else: return false
            match value:
                SignedInteger(item): return item >= integer_minimum(self.program.types, value_type) and item <= integer_maximum(self.program.types, value_type)
                else: return false
        if is_floating_type(self.program.types, value_type):
            match value:
                Floating(item): return true
                else: return false
        return false

    # External globals are not call slots: a zero pointer-shaped handle is a
    # valid stored token and is therefore checked only for nominal value shape.
    func require_external_variable_value(variable: HirExternVariable, value: Value) -> !:
        let extern_index = self.extern_type_index(variable.value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer: return
                        Integer(representation):
                            if token >= integer_minimum(self.program.types, representation) and token <= integer_maximum(self.program.types, representation): return
                else: pass
            error("interpreter: extern variable `" + variable.name + "` has a value incompatible with `" + describe_type(self.program.types, variable.value_type) + "`")
        if self.scalar_value_matches(value, variable.value_type): return
        error("interpreter: extern variable `" + variable.name + "` has a value incompatible with `" + describe_type(self.program.types, variable.value_type) + "`")

    func extern_type_index(value_type: TypeId) -> i64:
        match self.program.types.definitions[value_type.value].form:
            Extern(index): return index
            else: return -1

    func is_extern_struct(value_type: TypeId) -> bool:
        match self.program.types.definitions[value_type.value].form:
            Struct(index, arguments):
                let kind = self.program.structs[index].c_kind
                if kind == none: return false
                return kind == HirCStructKind.external
            else: return false

    func is_exported_c_struct(value_type: TypeId) -> bool:
        match self.program.types.definitions[value_type.value].form:
            Struct(index, arguments):
                let kind = self.program.structs[index].c_kind
                if kind == none: return false
                return kind == HirCStructKind.exported
            else: return false

    func is_c_struct(value_type: TypeId) -> bool:
        return self.is_extern_struct(value_type) or self.is_exported_c_struct(value_type)

    func c_enum_shape(value_type: TypeId) -> HirCEnum?:
        match self.program.types.definitions[value_type.value].form:
            Enum(index, arguments):
                if self.program.enums[index].is_integer_backed: return none
                return self.program.enums[index].c_shape
            else: return none

    # The semantic oracle models packing as a fresh field-by-field record.
    # It has no target layout, but it enforces the same closed values and bare
    # out-field handle/cfunc rule as canonical MIR's explicit boundary copy.
    func transcode_c_struct(function: HirFunction, value: Value, value_type: TypeId, slot: str, direction: CRecordDirection) -> Value!:
        let source_fields = list[BoxedValue]()
        match value:
            Record(fields):
                for field in fields: source_fields.append(field)
            else: error(self.incompatible_c_record(function, slot, value_type, direction))
        let schema = nominal_fields(self.program, value_type)
        if len(source_fields) != len(schema): error(self.incompatible_c_record(function, slot, value_type, direction))
        let copied = list[BoxedValue]()
        for index in range(0, len(schema)):
            let field = schema[index]
            let field_slot = slot + "." + field.name
            let item = source_fields[index].value
            if self.is_c_struct(field.value_type):
                copied.append(BoxedValue(value = try self.transcode_c_struct(function, item, field.value_type, field_slot, direction)))
                continue
            let enum_shape = self.c_enum_shape(field.value_type)
            if enum_shape != none:
                let shape = enum_shape
                if direction == CRecordDirection.encode:
                    copied.append(BoxedValue(value = try self.encode_c_value(function, item, field.value_type, field_slot)))
                else:
                    copied.append(BoxedValue(value = try self.decode_c_enum(item, shape, self.incompatible_c_record(function, field_slot, field.value_type, direction))))
                continue
            match self.program.types.definitions[field.value_type.value].form:
                Foreign:
                    match item:
                        Foreign(token):
                            if direction == CRecordDirection.encode and token == 0: error(self.null_foreign(function, field_slot))
                        else: error(self.incompatible_c_record(function, field_slot, field.value_type, direction))
                    copied.append(BoxedValue(value = item))
                    continue
                CFunction(parameters, result):
                    match item:
                        CFunction(identity):
                            match identity:
                                ForeignPointer(token):
                                    if direction == CRecordDirection.encode and token == 0: error(self.null_foreign(function, field_slot))
                                Declared(symbol): pass
                        else: error(self.incompatible_c_record(function, field_slot, field.value_type, direction))
                    copied.append(BoxedValue(value = item))
                    continue
                else: pass
            let extern_index = self.extern_type_index(field.value_type)
            if extern_index >= 0:
                match item:
                    Foreign(token):
                        match self.program.extern_types[extern_index].representation:
                            Pointer:
                                if direction == CRecordDirection.encode and token == 0: error(self.null_foreign(function, field_slot))
                            Integer(representation):
                                if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation):
                                    error(self.incompatible_c_record(function, field_slot, field.value_type, direction))
                    else: error(self.incompatible_c_record(function, field_slot, field.value_type, direction))
                copied.append(BoxedValue(value = item))
                continue
            if not self.scalar_value_matches(item, field.value_type):
                error(self.incompatible_c_record(function, field_slot, field.value_type, direction))
            copied.append(BoxedValue(value = self.canonical_scalar_value(item, field.value_type)))
        return Value.Record(fields = copied)

    func incompatible_c_record(function: HirFunction, slot: str, value_type: TypeId, direction: CRecordDirection) -> str:
        if direction == CRecordDirection.decode_argument:
            return self.incompatible_c_argument(function, slot, value_type)
        return self.incompatible_c_result(function, slot, value_type)

    func optional_data_pointer(value_type: TypeId) -> TypeId?:
        match self.program.types.definitions[value_type.value].form:
            Optional(inner):
                match self.program.types.definitions[inner.value].form:
                    Foreign: return inner
                    else: pass
                let index = self.extern_type_index(inner)
                if index < 0: return none
                match self.program.extern_types[index].representation:
                    Pointer: return inner
                    Integer(representation): return none
            else: return none

    func optional_c_function(value_type: TypeId) -> TypeId?:
        match self.program.types.definitions[value_type.value].form:
            Optional(inner):
                match self.program.types.definitions[inner.value].form:
                    CFunction(parameters, result): return inner
                    else: return none
            else: return none

    func incompatible_c_result(function: HirFunction, slot: str, value_type: TypeId) -> str:
        return "interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` returned " + slot + " incompatible with `" + describe_type(self.program.types, value_type) + "`"

    func incompatible_c_argument(function: HirFunction, slot: str, value_type: TypeId) -> str:
        return "interpreter: C export `" + function.name + "` received " + slot + " incompatible with `" + describe_type(self.program.types, value_type) + "`"

    func null_foreign(function: HirFunction, slot: str) -> str:
        var label = "extern `" + self.program.modules[function.module.value].name + "." + function.name + "`"
        match function.implementation:
            ExportedC(body): label = "C export `" + function.name + "`"
            else: pass
        return "interpreter: null_foreign crossing " + label + " " + slot

    # A suite is one lexical scope: bindings made inside it are trimmed away
    # however the suite exits.
    pub func execute_scope(statements: Operands, bindings: list[Binding]) -> Execution!:
        return try self.execute_function_scope(statements, bindings, false)

    # A function scope finishes its invocation's structured worker group
    # before its own deferred suffix. Nested lexical scopes retain ordinary
    # cleanup.
    func execute_function_scope(statements: Operands, bindings: list[Binding], is_function_scope: bool) -> Execution!:
        let outer_count = len(bindings)
        let deferred = list[NodeId]()
        let on_error_only = list[bool]()
        for position in range(0, i64(statements.count)):
            let statement = node_at(self.program, statements, position)
            match node_form(self.program, statement):
                DeferStatement(action):
                    deferred.append(action)
                    on_error_only.append(false)
                    continue
                ErrorDeferStatement(action):
                    deferred.append(action)
                    on_error_only.append(true)
                    continue
                else: pass
            let result = try self.execute(statement, bindings)
            match result:
                Next: continue
                else:
                    if is_function_scope: self.full.finish_invocation_group()
                    var leaving_by_error = false
                    match result:
                        Raised(error_value): leaving_by_error = true
                        else: pass
                    try self.execute_deferred(self.actions_to_run(deferred, on_error_only, leaving_by_error), bindings)
                    trim_bindings(bindings, outer_count)
                    return result
        if is_function_scope: self.full.finish_invocation_group()
        try self.execute_deferred(self.actions_to_run(deferred, on_error_only, false), bindings)
        trim_bindings(bindings, outer_count)
        return Execution.Next

    # `errdefer` actions run only when an error leaves the scope, in order
    # with the scope's ordinary deferred actions (base.md §8.8).
    func actions_to_run(deferred: list[NodeId], on_error_only: list[bool], leaving_by_error: bool) -> list[NodeId]:
        let selected = list[NodeId]()
        for index in range(0, len(deferred)):
            if leaving_by_error or not on_error_only[index]: selected.append(deferred[index])
        return selected

    # Cleanup is LIFO. HirGenerator admits only unit-producing actions, so
    # any control transfer here means malformed HIR rather than source input.
    func execute_deferred(deferred: list[NodeId], bindings: list[Binding]) -> !:
        var index = len(deferred) - 1
        while index >= 0:
            match try self.execute(deferred[index], bindings):
                Next: pass
                else: trap("deferred action attempted control transfer")
            index -= 1

    # Execute one statement and report how it left.
    func execute(statement: NodeId, bindings: list[Binding]) -> Execution!:
        match node_form(self.program, statement):
            BreakStatement(levels): return Execution.Broke(levels = levels)
            ContinueStatement(levels): return Execution.Continued(levels = levels)
            Binding(symbol, is_mutable, value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): bindings.append(Binding(symbol = symbol, value = self.full.initial_binding(symbol, item)))
                    Transferred(execution): return execution
                return Execution.Next
            Assignment(symbol, operation, value):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed assignment refers to an unknown binding")
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: assigned = right
                    Combine(binary): assigned = try evaluate_binary(self.full.binding_value(bindings[index].value), binary, right, self.program.types)
                self.full.assign_binding(bindings, index, assigned)
                return Execution.Next
            ExternStore(variable_index, operation, value):
                let variable = self.program.extern_variables[variable_index]
                let host = self.external_variable_host else error("interpreter: extern variable `" + variable.name + "` has no host binding")
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: pass
                    Combine(binary):
                        let current = try host.load(variable)
                        try self.require_external_variable_value(variable, current)
                        assigned = try evaluate_binary(self.canonical_scalar_value(current, variable.value_type), binary, right, self.program.types)
                try self.require_external_variable_value(variable, assigned)
                try host.store(variable, self.canonical_scalar_value(assigned, variable.value_type))
                return Execution.Next
            GlobalStore(global_index, operation, value):
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: pass
                    Combine(binary): assigned = try evaluate_binary(self.globals[global_index], binary, right, self.program.types)
                self.globals[global_index] = assigned
                return Execution.Next
            PointerStore(pointer, step_run, operation, value):
                let target = try self.evaluate_address(pointer, bindings)
                var path = list[i64]()
                for step in target.path: path.append(step)
                try self.append_path_steps(path, step_run, bindings)
                let current = try self.read_address(target.frame, target.symbol, target.global, path)
                var stored = Value.Unit
                match operation:
                    Replace:
                        match try self.evaluate(value, bindings):
                            Evaluated(item): stored = item
                            Transferred(execution): return execution
                    Combine(binary):
                        match try self.evaluate(value, bindings):
                            Evaluated(item): stored = try evaluate_binary(current, binary, item, self.program.types)
                            Transferred(execution): return execution
                try self.write_address(target.frame, target.symbol, target.global, path, stored)
                return Execution.Next
            PlaceAssignment(symbol, step_run, operation, value):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed place assignment refers to an unknown binding")
                match try self.execute_place_update(self.full.binding_value(bindings[index].value), symbol, -1, step_run, operation, value, bindings):
                    Updated(updated):
                        self.full.assign_binding(bindings, index, updated)
                        return Execution.Next
                    Transferred(execution): return execution
            GlobalPlaceAssignment(global_index, step_run, operation, value):
                match try self.execute_place_update(self.globals[global_index], SymbolId(value = no_node), i64(global_index), step_run, operation, value, bindings):
                    Updated(updated):
                        self.globals[global_index] = updated
                        return Execution.Next
                    Transferred(execution): return execution
            PrintText(value):
                print(value)
                return Execution.Next
            PrintValue(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): print(text)
                            else: trap("typed `print` received a non-string HIR value")
                    Transferred(execution): return execution
                return Execution.Next
            ReturnStatement(value):
                if value.value == no_node: return Execution.Returned(value = Value.Unit)
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Returned(value = item)
                    Transferred(execution): return execution
            RecoverStatement(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Recovered(value = item)
                    Transferred(execution): return execution
            DeferStatement(action): trap("defer marker executed outside its lexical scope")
            ErrorDeferStatement(action): trap("errdefer marker executed outside its lexical scope")
            WithAllocator(global, allocator, body):
                # The view is current for the suite and the previous value
                # returns on every exit (base.md §12.3).
                var view = Value.Unit
                match try self.evaluate(allocator, bindings):
                    Evaluated(item): view = item
                    Transferred(execution): return execution
                let saved = self.globals[global]
                self.globals[global] = Value.Present(value = BoxedValue(value = view))
                let outcome = self.execute_scope(body, bindings) catch reason:
                    self.globals[global] = saved
                    error(reason)
                self.globals[global] = saved
                return outcome
            AtomicFence(order, is_signal):
                # One thread: a fence orders nothing the oracle could observe.
                return Execution.Next
            AtomicStore(address, value, order):
                let target = try self.evaluate_address(address, bindings)
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        try self.write_address(target.frame, target.symbol, target.global, target.path, item)
                        return Execution.Next
                    Transferred(execution): return execution
            ExpressionStatement(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Next
                    Transferred(execution): return execution
            IfStatement(branches, has_fallback, fallback):
                # Each branch is a triple: condition, body start, body count.
                for branch in range(0, i64(branches.count) // 3):
                    let condition = NodeId(value = u32(entry_at(self.program, branches, branch * 3)))
                    match try self.evaluate(condition, bindings):
                        Evaluated(item):
                            if as_boolean(item):
                                let body = Operands(start = u32(entry_at(self.program, branches, branch * 3 + 1)), count = u32(entry_at(self.program, branches, branch * 3 + 2)))
                                return try self.execute_scope(body, bindings)
                        Transferred(execution): return execution
                if has_fallback: return try self.execute_scope(fallback, bindings)
                return Execution.Next
            WhileStatement(condition, body):
                while true:
                    let evaluated = try self.evaluate(condition, bindings)
                    var keep_going = false
                    match evaluated:
                        Evaluated(item): keep_going = as_boolean(item)
                        Transferred(execution): return execution
                    if not keep_going: return Execution.Next
                    match try self.execute_scope(body, bindings):
                        Next: continue
                        Continued(levels):
                            if levels == 0: continue
                            return Execution.Continued(levels = levels - 1)
                        Broke(levels):
                            if levels == 0: return Execution.Next
                            return Execution.Broke(levels = levels - 1)
                        Returned(value): return Execution.Returned(value = value)
                        Raised(error_value): return Execution.Raised(error_value = error_value)
                        Recovered(value): return Execution.Recovered(value = value)
            ForStatement(symbol, iteration, body):
                return try self.execute_for(symbol, iteration, body, bindings)
            Match(subject, arms, has_result): return try self.execute_match(subject, arms, bindings)
            else: trap("expression node executed as a statement")

    # Resolve a complete target before the right-hand side, then rebuild its
    # local or runtime-global root through the same semantic path.
    func execute_place_update(root: Value, root_symbol: SymbolId, global_index: i64, step_run: Operands, operation: AssignmentOperation, value: NodeId, bindings: list[Binding]) -> PlaceUpdate!:
        let steps = list[AssignmentPlaceStep]()
        var current = root
        for position in range(0, i64(step_run.count) // 2):
            let kind = u32(entry_at(self.program, step_run, position * 2))
            let payload = entry_at(self.program, step_run, position * 2 + 1)
            if kind == place_field_step:
                steps.append(AssignmentPlaceStep.Field(index = payload))
                match current:
                    Record(fields): current = fields[payload].value
                    else: trap("field step applied to a non-struct HIR value")
            elif kind == place_element_step:
                match try self.evaluate(NodeId(value = u32(payload)), bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(element_index):
                                match current:
                                    Array(elements):
                                        if element_index >= u64(len(elements)): error("interpreter: index out of bounds")
                                        steps.append(AssignmentPlaceStep.Element(index = i64(element_index)))
                                        current = elements[element_index].value
                                    else: trap("element step applied to a non-array HIR value")
                            else: trap("typed place index is not an integer")
                    Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
            else:
                match try self.full.resolve_place_step(self, kind, payload, current, bindings):
                    Resolved(step, next): 
                        steps.append(step)
                        current = next
                    Transferred(execution): return PlaceUpdate.Transferred(execution = execution)

        var right = Value.Unit
        match try self.evaluate(value, bindings):
            Evaluated(item): right = item
            Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
        # `current` retains the traversal value, which may contain boxed
        # container members. Reload the authoritative root after RHS effects
        # instead of attempting to reuse that traversal value.
        var latest_root = Value.Unit
        if global_index >= 0:
            latest_root = self.globals[global_index]
        else:
            let binding_index = find_binding(bindings, root_symbol)
            if binding_index < 0: trap("typed place assignment lost its root binding")
            latest_root = self.full.binding_value(bindings[binding_index].value)
        var assigned = right
        match operation:
            Replace: pass
            # The right-hand side may itself mutate the root; read the selected
            # value afterward while retaining the already-resolved indices.
            Combine(binary): assigned = try evaluate_binary(try value_at_assignment_place(latest_root, steps, 0), binary, right, self.program.types)
        let updated = try value_with_assignment_place(latest_root, steps, 0, assigned)
        var root_type = self.program.symbols[root_symbol.value].value_type
        if global_index >= 0: root_type = self.program.globals[global_index].value_type
        return PlaceUpdate.Updated(value = try self.refresh_unions(root_type, self.steps_path(steps), 0, updated))

    # Execute either a compiler-known sequence or the resolved standard
    # protocol. Protocol setup runs once; its private mutable iterator remains
    # live across calls while the source element binding is per-iteration.
    func execute_for(symbol: SymbolId, iteration: HirIteration, body: Operands, bindings: list[Binding]) -> Execution!:
        match iteration:
            Builtin(iterable): return try self.execute_builtin_for(symbol, iterable, body, bindings)
            Protocol(iterator_symbol, iterator, next):
                return try self.execute_protocol_for(symbol, iterator_symbol, iterator, next, body, bindings)

    func execute_builtin_for(symbol: SymbolId, iterable: NodeId, body: Operands, bindings: list[Binding]) -> Execution!:
        let evaluated = try self.evaluate(iterable, bindings)
        var value = Value.Unit
        match evaluated:
            Evaluated(item): value = item
            Transferred(execution): return execution
        let iterable_type = node_type(self.program, iterable)
        let collection = try self.full.execute_collection_for(self, symbol, value, iterable_type, body, bindings)
        if collection != none: return collection
        match self.program.types.definitions[iterable_type.value].form:
            Range(element): return try self.execute_range_for(symbol, value, element, body, bindings)
            Array(element, count): return try self.execute_sequence_for(symbol, value, body, bindings)
            Span(element, is_const): return try self.execute_sequence_for(symbol, value, body, bindings)
            Pointer(pointee, is_const, is_volatile): return try self.execute_address_for(symbol, value, body, bindings)
            String: return try self.execute_string_for(symbol, value, body, bindings)
            StringView:
                # A view's bytes are valid UTF-8; iterate them as text.
                var seen = SpanView(base = BoxedValue(value = Value.Unit), length = 0)
                match value:
                    Span(base, length): seen = SpanView(base = base, length = length)
                    else: trap("typed text iteration received a non-view")
                let text = strings.from_bytes(try self.view_bytes(seen)) else error("interpreter: trap: a text view holds invalid UTF-8")
                return try self.execute_string_for(symbol, Value.Text(value = text), body, bindings)
            else: trap("typed `for` received a non-iterable value")

    func execute_protocol_for(symbol: SymbolId, iterator_symbol: SymbolId, iterator: NodeId, next: NodeId, body: Operands, bindings: list[Binding]) -> Execution!:
        let outer_count = len(bindings)
        match try self.evaluate(iterator, bindings):
            Evaluated(value): bindings.append(Binding(symbol = iterator_symbol, value = value))
            Transferred(execution): return execution
        while true:
            let evaluated = self.evaluate(next, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                error(reason)
            var element: Value? = none
            match evaluated:
                Evaluated(value):
                    match value:
                        Absent:
                            trim_bindings(bindings, outer_count)
                            return Execution.Next
                        Present(item): element = item.value
                        else: trap("typed protocol iterator returned a non-optional value")
                Transferred(execution):
                    trim_bindings(bindings, outer_count)
                    return execution
            let item = element else trap("present iterator result lost its element")
            let iteration_count = len(bindings)
            bindings.append(Binding(symbol = symbol, value = item))
            let outcome = self.execute_scope(body, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                error(reason)
            trim_bindings(bindings, iteration_count)
            match outcome:
                Broke(levels):
                    trim_bindings(bindings, outer_count)
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0:
                        trim_bindings(bindings, outer_count)
                        return Execution.Continued(levels = levels - 1)
                Returned(value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Returned(value = value)
                Raised(error_value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Raised(error_value = error_value)
                Recovered(value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Recovered(value = value)
                else: pass

    func execute_string_for(symbol: SymbolId, iterated: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        var text = ""
        match iterated:
            Text(value): text = value
            else: trap("typed string iteration received a non-string value")
        let outer_count = len(bindings)
        for character in text:
            bindings.append(Binding(symbol = symbol, value = Value.Character(value = character)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke(levels):
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0: return Execution.Continued(levels = levels - 1)
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
        return Execution.Next

    # `for x in items` over an array value or a span: each element by value.
    func execute_sequence_for(symbol: SymbolId, sequence: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        let elements = list[Value]()
        match sequence:
            Array(items):
                for item in items: elements.append(item.value)
            Span(base, length):
                let seen = SpanView(base = base, length = length)
                for position in range(0, length):
                    match try self.span_element_address(seen, position):
                        Address(frame, item_symbol, global, path): elements.append(try self.read_address(frame, item_symbol, global, path))
                        else: trap("span element address is not an address")
            else: trap("typed sequence iteration received a non-sequence value")
        let outer_count = len(bindings)
        for element in elements:
            bindings.append(Binding(symbol = symbol, value = element))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke(levels):
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0: return Execution.Continued(levels = levels - 1)
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
        return Execution.Next

    # `for x in &items`: the address of each element of the array or span the
    # pointer names.
    func execute_address_for(symbol: SymbolId, pointer: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        var target = AddressTarget(frame = 0, symbol = SymbolId(value = no_node), global = -1, path = list[i64]())
        match pointer:
            Address(frame, address_symbol, global, path): target = AddressTarget(frame = frame, symbol = address_symbol, global = global, path = path)
            else: trap("typed address iteration received a non-address value")
        let addresses = list[Value]()
        match try self.read_address(target.frame, target.symbol, target.global, target.path):
            Array(items):
                for index in range(0, len(items)):
                    let path = list[i64]()
                    for step in target.path: path.append(step)
                    path.append(index)
                    addresses.append(Value.Address(frame = target.frame, symbol = target.symbol, global = target.global, path = path))
            Span(base, length):
                let seen = SpanView(base = base, length = length)
                for index in range(0, length): addresses.append(try self.span_element_address(seen, index))
            else: trap("typed address iteration received a non-sequence place")
        let outer_count = len(bindings)
        for address in addresses:
            bindings.append(Binding(symbol = symbol, value = address))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke(levels):
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0: return Execution.Continued(levels = levels - 1)
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
        return Execution.Next

    func execute_range_for(symbol: SymbolId, ranged: Value, element_type: TypeId, body: Operands, bindings: list[Binding]) -> Execution!:
        if is_unsigned_integer_type(self.program.types, element_type):
            return try self.execute_unsigned_range_for(symbol, ranged, body, bindings)
        var lower = 0
        var upper = 0
        var inclusive = false
        match ranged:
            Record(fields):
                if len(fields) != 3: trap("typed range has the wrong field count")
                match fields[0].value:
                    SignedInteger(value): lower = value
                    else: trap("typed range lower bound is not an integer")
                match fields[1].value:
                    SignedInteger(value): upper = value
                    else: trap("typed range upper bound is not an integer")
                match fields[2].value:
                    Boolean(value): inclusive = value
                    else: trap("typed range boundary flag is not boolean")
            else: trap("typed range iteration received a non-range value")
        let outer_count = len(bindings)
        var current = lower
        while current < upper or (inclusive and current == upper):
            bindings.append(Binding(symbol = symbol, value = Value.SignedInteger(value = current)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke(levels):
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0: return Execution.Continued(levels = levels - 1)
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
            # Do not overflow when a closed range ends at the type's maximum;
            # the endpoint has already been delivered.
            if inclusive and current == upper: return Execution.Next
            match try checked_integer_result(try checked_add(current, 1), element_type, self.program.types):
                SignedInteger(value): current = value
                else: trap("range increment produced a non-integer")
        return Execution.Next

    func execute_unsigned_range_for(symbol: SymbolId, ranged: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        var lower = u64(0)
        var upper = u64(0)
        var inclusive = false
        match ranged:
            Record(fields):
                if len(fields) != 3: trap("typed range has the wrong field count")
                match fields[0].value:
                    UnsignedInteger(value): lower = value
                    else: trap("typed unsigned range lower bound is not an integer")
                match fields[1].value:
                    UnsignedInteger(value): upper = value
                    else: trap("typed unsigned range upper bound is not an integer")
                match fields[2].value:
                    Boolean(value): inclusive = value
                    else: trap("typed range boundary flag is not boolean")
            else: trap("typed range iteration received a non-range value")
        let outer_count = len(bindings)
        var current = lower
        while current < upper or (inclusive and current == upper):
            bindings.append(Binding(symbol = symbol, value = Value.UnsignedInteger(value = current)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke(levels):
                    if levels == 0: return Execution.Next
                    return Execution.Broke(levels = levels - 1)
                Continued(levels):
                    if levels > 0: return Execution.Continued(levels = levels - 1)
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
            if inclusive and current == upper: return Execution.Next
            if current == u64(18446744073709551615): error("interpreter: integer arithmetic overflow")
            current += u64(1)
        return Execution.Next

    func execute_match(subject: NodeId, arms: Operands, bindings: list[Binding]) -> Execution!:
        let evaluated = try self.evaluate(subject, bindings)
        var selected = Value.Unit
        match evaluated:
            Evaluated(item): selected = item
            Transferred(execution): return execution
        let outer_count = len(bindings)
        for position in range(0, i64(arms.count)):
            let arm = node_at(self.program, arms, position)
            match node_form(self.program, arm):
                MatchArm(patterns, statements, value, guard):
                    if try self.arm_matches(patterns, selected, bindings):
                        # A guard runs after the pattern binds (base.md §8.4).
                        if guard.value != no_node:
                            var passes = false
                            match try self.evaluate(guard, bindings):
                                Evaluated(item): passes = as_boolean(item)
                                Transferred(execution): return execution
                            if not passes:
                                trim_bindings(bindings, outer_count)
                                continue
                        let outcome = try self.execute_scope(statements, bindings)
                        trim_bindings(bindings, outer_count)
                        return outcome
                else: trap("match arm run names a non-arm node")
        trap("checked `match` selected no arm")

    # mark: Expressions =========================================================================

    # Evaluate one expression to its value.
    pub func evaluate(expression: NodeId, bindings: list[Binding]) -> Evaluation!:
        match node_form(self.program, expression):
            Constant(value):
                # A Base text literal is a view over program data.
                if self.is_text_view(node_type(self.program, expression)):
                    match self.program.values[value]:
                        Text(text): return Evaluation.Evaluated(value = self.literal_view(text))
                        else: trap("text view constant is not text")
                return Evaluation.Evaluated(value = self.program.values[value])
            Reference(symbol):
                let index = find_binding(bindings, symbol)
                if index >= 0: return Evaluation.Evaluated(value = self.full.binding_value(bindings[index].value))
                for constant in self.program.constants:
                    if constant.symbol.value == symbol.value:
                        # Initializers are literal trees; re-evaluating is lookup.
                        return try self.evaluate(constant.value, list[Binding]())
                trap("typed reference points outside its call frame")
            ExternLoad(variable_index):
                let variable = self.program.extern_variables[variable_index]
                let host = self.external_variable_host else error("interpreter: extern variable `" + variable.name + "` has no host binding")
                let value = try host.load(variable)
                try self.require_external_variable_value(variable, value)
                return Evaluation.Evaluated(value = self.canonical_scalar_value(value, variable.value_type))
            GlobalLoad(global_index): return Evaluation.Evaluated(value = self.globals[global_index])
            Discard(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Unit)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            NeverCoercion(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): trap("a `never` coercion completed normally")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            DivergingSequence(values):
                for position in range(0, i64(values.count)):
                    match try self.evaluate(node_at(self.program, values, position), bindings):
                        Evaluated(item): pass
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                trap("a diverging evaluation prefix completed normally")
            LayoutConstant(query, subject, field):
                return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(try self.layout_answer(query, subject, field))))
            Cast(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Span(base, length): return Evaluation.Evaluated(value = item)
                            Text(text): error("interpreter: `(cstr)text` has no value in the reference interpreter, whose addresses are places, not numbers (base.md §19.3)")
                            Address(frame, symbol, global, path):
                                # A pointer-to-pointer cast keeps the place; the
                                # reference interpreter has no numeric addresses.
                                if is_pointer_integer_type(self.program.types, node_type(self.program, expression)):
                                    error("interpreter: `(usize)p` has no value in the reference interpreter, whose addresses are places, not numbers (base.md §19.3)")
                                return Evaluation.Evaluated(value = item)
                            else: pass
                        if self.state_optional_pointer(node_type(self.program, expression)):
                            match item:
                                UnsignedInteger(address):
                                    if address == u64(0): return Evaluation.Evaluated(value = Value.Absent)
                                    error("interpreter: `(T*?)n` names no place in the reference interpreter for a non-zero integer (base.md §19.3)")
                                else: trap("integer-to-pointer cast received a non-integer")
                        # An integer-backed enum casts as its representation (base.md §10.3).
                        let destination = integer_enum_representation(self.program, node_type(self.program, expression)) else node_type(self.program, expression)
                        return Evaluation.Evaluated(value = cast_numeric_value(item, destination, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Allocate(prelude, request, initializer, count, zeroed, code, message):
                return try self.evaluate_allocation(expression, prelude, request, initializer, count, zeroed, code, message, bindings)
            AtomicLoad(address, order):
                let target = try self.evaluate_address(address, bindings)
                return Evaluation.Evaluated(value = try self.read_address(target.frame, target.symbol, target.global, target.path))
            AtomicFence(order, is_signal): return Evaluation.Evaluated(value = Value.Unit)
            AtomicStore(address, value, order):
                # `x.store(v)` is a unit-valued expression as well as a statement.
                let target = try self.evaluate_address(address, bindings)
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        try self.write_address(target.frame, target.symbol, target.global, target.path, item)
                        return Evaluation.Evaluated(value = Value.Unit)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            AtomicUpdate(operation, address, value, order):
                let target = try self.evaluate_address(address, bindings)
                var operand = Value.Unit
                match try self.evaluate(value, bindings):
                    Evaluated(item): operand = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                let previous = try self.read_address(target.frame, target.symbol, target.global, target.path)
                let operand_type = node_type(self.program, value)
                var updated = operand
                match operation:
                    swap: pass
                    add: updated = try evaluate_binary(previous, BinaryOperation.WrapAdd(operand_type = operand_type), operand, self.program.types)
                    sub: updated = try evaluate_binary(previous, BinaryOperation.WrapSubtract(operand_type = operand_type), operand, self.program.types)
                    or_bits: updated = try evaluate_binary(previous, BinaryOperation.BitwiseOr(operand_type = operand_type), operand, self.program.types)
                    and_bits: updated = try evaluate_binary(previous, BinaryOperation.BitwiseAnd(operand_type = operand_type), operand, self.program.types)
                    xor_bits: updated = try evaluate_binary(previous, BinaryOperation.BitwiseXor(operand_type = operand_type), operand, self.program.types)
                    maximum:
                        match try evaluate_binary(previous, BinaryOperation.Greater(operand_type = operand_type), operand, self.program.types):
                            Boolean(larger):
                                if larger: updated = previous
                            else: trap("atomic comparison answered a non-boolean")
                    minimum:
                        match try evaluate_binary(previous, BinaryOperation.Less(operand_type = operand_type), operand, self.program.types):
                            Boolean(smaller):
                                if smaller: updated = previous
                            else: trap("atomic comparison answered a non-boolean")
                try self.write_address(target.frame, target.symbol, target.global, target.path, updated)
                return Evaluation.Evaluated(value = previous)
            AtomicCompareExchange(address, expected, desired, success, failure, is_weak):
                let target = try self.evaluate_address(address, bindings)
                var expected_value = Value.Unit
                match try self.evaluate(expected, bindings):
                    Evaluated(item): expected_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                var desired_value = Value.Unit
                match try self.evaluate(desired, bindings):
                    Evaluated(item): desired_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                let observed = try self.read_address(target.frame, target.symbol, target.global, target.path)
                let same = try values_equal(observed, expected_value, EqualityContext())
                if same: try self.write_address(target.frame, target.symbol, target.global, target.path, desired_value)
                return Evaluation.Evaluated(value = Value.Tuple(elements = [BoxedValue(value = Value.Boolean(value = same)), BoxedValue(value = observed)]))
            EnumFromInteger(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        let shape = integer_enum_shape(self.program, node_type(self.program, expression)) else trap("checked enum conversion into a tagged enum")
                        for declared in shape.values:
                            if integer_values_match(declared, item): return Evaluation.Evaluated(value = item)
                        error("interpreter: trap: integer-backed enum conversion of a value that is not a declared case")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            PointerOffset(pointer, offset, negate):
                let target = try self.evaluate_address(pointer, bindings)
                var count = 0
                match try self.evaluate(offset, bindings):
                    Evaluated(item):
                        match item:
                            SignedInteger(value): count = value
                            UnsignedInteger(value): count = i64(value)
                            else: trap("pointer offset is not an integer")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                if negate: count = 0 - count
                if count == 0: return Evaluation.Evaluated(value = Value.Address(frame = target.frame, symbol = target.symbol, global = target.global, path = target.path))
                return Evaluation.Evaluated(value = try self.offset_address(target, count))
            SpanFromParts(pointer, length):
                let base = try self.evaluate_address(pointer, bindings)
                var count = 0
                match try self.evaluate(length, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(value): count = i64(value)
                            else: trap("span length is not an unsigned integer")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                return Evaluation.Evaluated(value = Value.Span(base = BoxedValue(value = Value.Address(frame = base.frame, symbol = base.symbol, global = base.global, path = base.path)), length = count))
            SpanLength(viewed):
                let seen = try self.evaluate_span(viewed, bindings)
                return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(seen.length)))
            SpanData(viewed):
                let seen = try self.evaluate_span(viewed, bindings)
                return Evaluation.Evaluated(value = seen.base.value)
            SpanElementAddress(viewed, index):
                let seen = try self.evaluate_span(viewed, bindings)
                var position = 0
                match try self.evaluate(index, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(value): position = i64(value)
                            else: trap("span index is not an unsigned integer")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                if position < 0 or position >= seen.length: error("interpreter: index out of bounds")
                return Evaluation.Evaluated(value = try self.span_element_address(seen, position))
            SpanSlice(viewed, start, end, inclusive):
                let seen = try self.evaluate_span(viewed, bindings)
                var low = 0
                var high = 0
                match try self.evaluate(start, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(value): low = i64(value)
                            else: trap("slice bound is not an unsigned integer")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                high = seen.length
                if end.value != no_node:
                    match try self.evaluate(end, bindings):
                        Evaluated(item):
                            match item:
                                UnsignedInteger(value): high = i64(value)
                                else: trap("slice bound is not an unsigned integer")
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                    if inclusive: high += 1
                if low > high or high > seen.length: error("interpreter: slice out of bounds")
                var first = seen.base.value
                if low > 0: first = try self.span_element_address(seen, low)
                return Evaluation.Evaluated(value = Value.Span(base = BoxedValue(value = first), length = high - low))
            PointerDifference(left, right):
                let first = try self.evaluate_address(left, bindings)
                let second = try self.evaluate_address(right, bindings)
                return Evaluation.Evaluated(value = Value.SignedInteger(value = try self.address_difference(first, second)))
            QualifyPointer(value): return try self.evaluate(value, bindings)
            ZeroValue: return Evaluation.Evaluated(value = zero_hir_value(self.program, node_type(self.program, expression)))
            Uninitialized: return Evaluation.Evaluated(value = zero_hir_value(self.program, node_type(self.program, expression)))
            Deref(pointer):
                let target = try self.evaluate_address(pointer, bindings)
                return Evaluation.Evaluated(value = try self.read_address(target.frame, target.symbol, target.global, target.path))
            AddressOf(pointer, symbol, global, steps):
                var frame = len(self.frames) - 1
                # A global's place belongs to no frame; a global initialiser
                # runs before any, and frame -1 names literal data.
                if global >= 0: frame = 0
                var root_symbol = symbol
                var root_global = global
                var path = list[i64]()
                if pointer.value != no_node:
                    let inner = try self.evaluate_address(pointer, bindings)
                    frame = inner.frame
                    root_symbol = inner.symbol
                    root_global = inner.global
                    for step in inner.path: path.append(step)
                try self.append_path_steps(path, steps, bindings)
                return Evaluation.Evaluated(value = Value.Address(frame = frame, symbol = root_symbol, global = root_global, path = path))
            NumericConvert(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        let destination = node_type(self.program, expression)
                        return Evaluation.Evaluated(value = try convert_numeric_value(item, destination, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            StringScalarCount(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(text))))
                            else: trap("typed scalar count has a non-string value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            ForeignBytesCopy(pointer, count):
                match try self.evaluate(pointer, bindings):
                    Evaluated(pointer_value):
                        match try self.evaluate(count, bindings):
                            Evaluated(count_value):
                                var token = 0
                                match pointer_value:
                                    Foreign(value): token = value
                                    else: trap("typed foreign-memory copy has a non-foreign token")
                                if token == 0: error("interpreter: trap: null_foreign")
                                var amount = u64(0)
                                match count_value:
                                    UnsignedInteger(value): amount = value
                                    else: trap("typed foreign-memory copy has a non-u64 count")
                                let host = self.foreign_memory_host else error("interpreter: foreign memory has no host")
                                let payload = try host.copy_bytes(token, amount)
                                if u64(len(payload)) != amount: error("interpreter: foreign memory host returned the wrong byte count")
                                return Evaluation.Evaluated(value = Value.Bytes(value = payload))
                            Transferred(execution): return Evaluation.Transferred(execution = execution)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            ForeignCStringCopy(pointer):
                match try self.evaluate(pointer, bindings):
                    Evaluated(pointer_value):
                        var token = 0
                        match pointer_value:
                            Foreign(value): token = value
                            else: trap("typed C-string copy has a non-foreign token")
                        if token == 0: error("interpreter: trap: null_foreign")
                        let host = self.foreign_memory_host else error("interpreter: foreign memory has no host")
                        let payload = try host.copy_c_string(token)
                        let text = strings.from_bytes(payload) else error("interpreter: trap: invalid_utf8")
                        return Evaluation.Evaluated(value = Value.Text(value = text))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            BuiltinDisplay(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Text(value = display_builtin(item, node_type(self.program, value), self.program.types)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            FormattedString(parts):
                let output_bytes = list[u8]()
                for position in range(0, i64(parts.count)):
                    match try self.evaluate(node_at(self.program, parts, position), bindings):
                        Evaluated(item):
                            match item:
                                Text(text):
                                    for byte in strings.to_bytes(text): output_bytes.append(byte)
                                else: trap("typed formatted string contains a non-string piece")
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                let text = strings.from_bytes(output_bytes) else trap("formatted string pieces produced invalid UTF-8")
                return Evaluation.Evaluated(value = Value.Text(value = text))
            Hash(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = structural_hash(item)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            SequenceLength(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Bytes(payload): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(payload))))
                            Text(text): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(strings.to_bytes(text)))))
                            Array(elements): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(elements))))
                            else:
                                let length = self.full.collection_length(item) else trap("typed sequence length has a non-sequence value")
                                return Evaluation.Evaluated(value = Value.UnsignedInteger(value = length))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            SequenceIndex(value, index):
                let sequence = try self.evaluate(value, bindings)
                var sequence_value = Value.Unit
                match sequence:
                    Evaluated(item): sequence_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(index, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(position):
                                match sequence_value:
                                    Bytes(payload):
                                        if position >= u64(len(payload)): error("interpreter: index out of bounds")
                                        return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(payload[position])))
                                    Array(elements):
                                        if position >= u64(len(elements)): error("interpreter: index out of bounds")
                                        return Evaluation.Evaluated(value = elements[position].value)
                                    else:
                                        let element = try self.full.index_collection(sequence_value, position) else trap("typed sequence index has a non-sequence value")
                                        return Evaluation.Evaluated(value = element)
                            else: trap("typed sequence index has a non-integer index")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Unary(operation, operand):
                match try self.evaluate(operand, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = try evaluate_unary(operation, item, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Binary(left, operation, right):
                let left_evaluation = try self.evaluate(left, bindings)
                var left_value = Value.Unit
                match left_evaluation:
                    Evaluated(item): left_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                # `and` and `or` short-circuit: the right side must not run
                # when the left side already decides the answer.
                match operation:
                    LogicalAnd:
                        if not as_boolean(left_value): return Evaluation.Evaluated(value = Value.Boolean(value = false))
                    LogicalOr:
                        if as_boolean(left_value): return Evaluation.Evaluated(value = Value.Boolean(value = true))
                    else: pass
                match try self.evaluate(right, bindings):
                    Evaluated(item):
                        match operation:
                            LogicalAnd, LogicalOr: return Evaluation.Evaluated(value = Value.Boolean(value = as_boolean(item)))
                            else:
                                # Base text views compare by bytes through their places.
                                if self.is_text_view(node_type(self.program, left)):
                                    let order = try self.compare_views(left_value, item)
                                    match operation:
                                        Equal(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order == 0))
                                        NotEqual(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order != 0))
                                        Less(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order < 0))
                                        LessEqual(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order <= 0))
                                        Greater(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order > 0))
                                        GreaterEqual(operand_type): return Evaluation.Evaluated(value = Value.Boolean(value = order >= 0))
                                        else: trap("text views support only comparison operators")
                                return Evaluation.Evaluated(value = try evaluate_binary(left_value, operation, item, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Conditional(value, condition, alternative):
                match try self.evaluate(condition, bindings):
                    Evaluated(item):
                        if as_boolean(item): return try self.evaluate(value, bindings)
                        return try self.evaluate(alternative, bindings)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Range(lower, upper, inclusive):
                let low = try self.evaluate(lower, bindings)
                var low_value = Value.Unit
                match low:
                    Evaluated(item): low_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                let high = try self.evaluate(upper, bindings)
                match high:
                    Evaluated(item):
                        return Evaluation.Evaluated(value = Value.Record(fields = [
                            BoxedValue(value = low_value),
                            BoxedValue(value = item),
                            BoxedValue(value = Value.Boolean(value = inclusive)),
                        ]))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Call(function, arguments): return try self.evaluate_call(function, arguments, bindings)
            CVariadicCall(function, arguments, extras):
                error("interpreter: a variadic C call has no host in the reference interpreter (base.md §17.2)")
            FunctionAddress(function):
                match self.program.types.definitions[node_type(self.program, expression).value].form:
                    CFunction(parameters, result): return Evaluation.Evaluated(value = Value.CFunction(identity = HirCFunctionIdentity.Declared(symbol = function)))
                    else: return Evaluation.Evaluated(value = Value.Function(symbol = function))
            IndirectCall(callee, arguments): return try self.evaluate_indirect_call(callee, arguments, bindings)
            Initialize(function, arguments): return try self.evaluate_initializer(expression, function, arguments, bindings)
            ErrorCodeLiteral(package, value):
                return Evaluation.Evaluated(value = Value.Record(fields = [
                    BoxedValue(value = Value.Text(value = self.program.packages[package.value].identity)),
                    BoxedValue(value = Value.UnsignedInteger(value = u64(value))),
                ]))
            Raise(code, message):
                let code_evaluation = try self.evaluate(code, bindings)
                var code_value = Value.Unit
                match code_evaluation:
                    Evaluated(item): code_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        let error_value = Value.Record(fields = [BoxedValue(value = code_value), BoxedValue(value = item)])
                        return Evaluation.Transferred(execution = Execution.Raised(error_value = error_value))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Trap(message):
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): error("interpreter: trap: " + text)
                            else: trap("typed `trap` received a non-string HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Assert(condition, message):
                let checked = try self.evaluate(condition, bindings)
                var passed = false
                match checked:
                    Evaluated(item): passed = as_boolean(item)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        match item:
                            Text(text):
                                if not passed: error("interpreter: trap: " + text)
                                return Evaluation.Evaluated(value = Value.Unit)
                            else: trap("typed `assert` received a non-string HIR message")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Try(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            FallibleSuccess(success): return Evaluation.Evaluated(value = success.value)
                            FallibleFailure(error_value): return Evaluation.Transferred(execution = Execution.Raised(error_value = error_value.value))
                            else: trap("typed `try` received a non-fallible HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Catch(value, failure, body): return try self.evaluate_catch(value, failure, body, bindings)
            StructValue(struct_index, fields):
                let record_type = node_type(self.program, expression)
                let field_count = len(nominal_fields(self.program, record_type))
                match try self.evaluate_placed_run(fields, field_count, bindings):
                    EvaluatedRun(items):
                        # A union's construction writes its one named member.
                        if is_union_type(self.program, record_type) and fields.count >= 2:
                            return Evaluation.Evaluated(value = try self.union_after_write(record_type, entry_at(self.program, fields, 0), items))
                        return Evaluation.Evaluated(value = Value.Record(fields = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            FieldAccess(record, field):
                match try self.evaluate(record, bindings):
                    Evaluated(item):
                        match item:
                            Record(fields):
                                let stored = fields[field].value
                                let record_type = node_type(self.program, record)
                                if is_union_type(self.program, record_type):
                                    match stored:
                                        Unit: error("interpreter: union member `" + nominal_fields(self.program, record_type)[field].name + "` cannot be read in the reference interpreter: the member last written has no byte image (base.md §10.4)")
                                        else: pass
                                return Evaluation.Evaluated(value = stored)
                            else:
                                let stored = self.full.read_class_field(item, field) else trap("field access applied to a non-record HIR value")
                                return Evaluation.Evaluated(value = stored)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Tuple(elements):
                match try self.evaluate_run(elements, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Tuple(elements = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            Array(elements):
                match try self.evaluate_run(elements, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Array(elements = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            Element(value, index):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Tuple(elements):
                                if index < 0 or index >= len(elements): trap("tuple element index is out of range")
                                return Evaluation.Evaluated(value = elements[index].value)
                            else: trap("tuple element applied to a non-tuple HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            NoneLiteral: return Evaluation.Evaluated(value = Value.Absent)
            Some(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Present(value = BoxedValue(value = item)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            ElseFallback(value, arm):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Absent: return try self.evaluate(arm, bindings)
                            Present(present): return Evaluation.Evaluated(value = present.value)
                            else: trap("`else` applied to a non-optional HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            EnumValue(enum_index, case_index, payload):
                if self.program.enums[enum_index].is_integer_backed:
                    # The case is its declared integer (base.md §10.3).
                    let shape = self.program.enums[enum_index].c_shape else trap("integer-backed enum lost its representation")
                    return Evaluation.Evaluated(value = shape.values[case_index])
                let field_count = len(nominal_cases(self.program, node_type(self.program, expression))[case_index].payload)
                match try self.evaluate_placed_run(payload, field_count, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Variant(case_index = case_index, payload = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            Match(subject, arms, has_result): return try self.evaluate_match(subject, arms, bindings)
            else:
                let runtime_value = try self.full.evaluate(self, expression, bindings)
                if runtime_value != none: return runtime_value
                trap("statement node evaluated as an expression")

    # The recursive walkers are kept small on purpose: the oracle recurses
    # once per interpreted call, and every local of `evaluate` is host stack
    # for the whole depth. Each heavy arm lives in its own function.
    func evaluate_run(run: Operands, bindings: list[Binding]) -> RunEvaluation!:
        let items = list[BoxedValue]()
        for position in range(0, i64(run.count)):
            match try self.evaluate(node_at(self.program, run, position), bindings):
                Evaluated(item): items.append(BoxedValue(value = item))
                Transferred(execution): return RunEvaluation.TransferredRun(execution = execution)
        return RunEvaluation.EvaluatedRun(values = items)

    ## Evaluate placed aggregate children in source order, then publish their
    ## semantic value in declaration order. Layout is not part of this oracle.
    func evaluate_placed_run(run: Operands, field_count: i64, bindings: list[Binding]) -> RunEvaluation!:
        let items = list[BoxedValue]()
        for index in range(0, field_count): items.append(BoxedValue(value = Value.Unit))
        for pair in range(0, i64(run.count) // 2):
            let field_index = entry_at(self.program, run, pair * 2)
            let child = NodeId(value = u32(entry_at(self.program, run, pair * 2 + 1)))
            match try self.evaluate(child, bindings):
                Evaluated(item): items[field_index] = BoxedValue(value = item)
                Transferred(execution): return RunEvaluation.TransferredRun(execution = execution)
        return RunEvaluation.EvaluatedRun(values = items)

    # mark: Structured task lifetimes ==========================================================

    func evaluate_call(function: SymbolId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let target = self.find_function(function)
        let values = list[Value]()
        for parameter in target.parameters: values.append(Value.Unit)
        let receiver = target.receiver
        var mutable_receiver_place: Place? = none
        # Arguments are pairs: parameter index, then the argument node.
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            if parameter_index == 0 and receiver != none and receiver.kind == HirReceiverKind.mutating_method:
                match try self.evaluate_mutable_place(argument, bindings):
                    EvaluatedPlace(place, item):
                        mutable_receiver_place = place
                        values[parameter_index] = item
                    TransferredPlace(execution): return Evaluation.Transferred(execution = execution)
            else:
                match try self.evaluate(argument, bindings):
                    Evaluated(item): values[parameter_index] = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
        if receiver != none and receiver.kind == HirReceiverKind.mutating_method:
            # Selecting an inout receiver happens before later arguments, but
            # its value is read when the call begins. A later argument may
            # have mutated the same place; MIR naturally observes that through
            # the selected address, so the semantic oracle must do so too.
            let place = mutable_receiver_place else trap("mutating call on a value that is not a place")
            let index = find_binding(bindings, place.symbol)
            if index < 0: trap("mutating call refers to an unknown binding")
            values[0] = try value_at_assignment_place(self.full.binding_value(bindings[index].value), place.steps, 0)
        let invocation = try self.call(target, values)
        # A mutating method changed its copy of `self`; the caller's place
        # receives that copy (HirGenerator proved it is a place).
        if receiver != none and receiver.kind == HirReceiverKind.mutating_method:
            let place = mutable_receiver_place else trap("mutating call on a value that is not a place")
            let index = find_binding(bindings, place.symbol)
            if index < 0: trap("mutating call refers to an unknown binding")
            let updated = try value_with_assignment_place(self.full.binding_value(bindings[index].value), place.steps, 0, invocation.receiver)
            let root_type = self.program.symbols[place.symbol.value].value_type
            self.full.assign_binding(bindings, index, try self.refresh_unions(root_type, self.steps_path(place.steps), 0, updated))
        return Evaluation.Evaluated(value = invocation.value)

    # A function-value call evaluates its pointer first and positional
    # arguments left to right. HIR typing already proved the exact signature.
    func evaluate_indirect_call(callee: NodeId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let selected = try self.evaluate(callee, bindings)
        var callable = Value.Unit
        match selected:
            Evaluated(value): callable = value
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        let values = list[Value]()
        for position in range(0, i64(arguments.count)):
            match try self.evaluate(node_at(self.program, arguments, position), bindings):
                Evaluated(value): values.append(value)
                Transferred(execution): return Evaluation.Transferred(execution = execution)
        return Evaluation.Evaluated(value = try self.call_function_value(callable, node_type(self.program, callee), values))

    # Invoke an already-evaluated function value. Compiler-known scoped APIs
    # share this path with ordinary indirect calls, preserving one callable
    # identity and capture contract in the semantic oracle.
    pub func call_function_value(callable: Value, function_type: TypeId, arguments: list[Value]) -> Value!:
        var function = SymbolId(value = 0)
        var raw_c_function: i64? = none
        let captures = list[Value]()
        match callable:
            Function(symbol): function = symbol
            CFunction(identity):
                match identity:
                    Declared(symbol): function = symbol
                    ForeignPointer(token): raw_c_function = token
            else:
                let target = self.full.closure_target(callable) else trap("typed indirect call has a non-function value")
                function = target.function
                for capture in target.captures: captures.append(capture)
        if raw_c_function != none:
            return try self.call_c_function_pointer(raw_c_function, function_type, arguments)
        return (try self.call_with_captures(self.find_function(function), arguments, captures)).value

    # Invoke one opaque pointer through the exact checked cfunc signature.
    # The semantic host sees raw C-shaped components; it never receives a
    # fabricated HIR symbol standing in for the pointer.
    func call_c_function_pointer(pointer_value: i64, function_type: TypeId, arguments: list[Value]) -> Value!:
        if pointer_value == 0: error("interpreter: null_foreign invoking cfunc")
        let host = self.c_function_pointer_host else error("interpreter: cfunc pointer " + str(pointer_value) + " has no host binding")
        let parameters = list[TypeId]()
        var result_type = resolve_builtin_type(BuiltinType.unit)
        match self.program.types.definitions[function_type.value].form:
            CFunction(items, result):
                for item in items: parameters.append(item)
                result_type = result
            else: trap("raw C function pointer has a non-cfunc HIR type")
        if len(arguments) != len(parameters): trap("typed cfunc call has the wrong argument count")
        let encoded = list[Value]()
        for index in range(0, len(arguments)):
            encoded.append(try self.encode_c_component(arguments[index], parameters[index], "interpreter: null_foreign crossing cfunc parameter " + str(index)))
        let raw_result = try host.call(pointer_value, encoded)
        if types_match(result_type, resolve_builtin_type(BuiltinType.unit)):
            match raw_result:
                Unit: return Value.Unit
                else: error("interpreter: cfunc pointer returned a value incompatible with `unit`")
        return try self.decode_c_component(raw_result, result_type, "interpreter: null_foreign crossing cfunc result", "interpreter: cfunc pointer returned a value incompatible with `" + describe_type(self.program.types, result_type) + "`")

    # Evaluate one mutable receiver exactly once while retaining where its
    # final value must be copied back after the method returns.
    pub func evaluate_mutable_place(value: NodeId, bindings: list[Binding]) -> PlaceEvaluation!:
        match node_form(self.program, value):
            Reference(symbol):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("mutating call refers to an unknown binding")
                return PlaceEvaluation.EvaluatedPlace(place = Place(symbol = symbol, steps = list[AssignmentPlaceStep]()), value = self.full.binding_value(bindings[index].value))
            FieldAccess(inner, field):
                match try self.evaluate_mutable_place(inner, bindings):
                    EvaluatedPlace(place, base):
                        match base:
                            Record(fields):
                                place.steps.append(AssignmentPlaceStep.Field(index = field))
                                return PlaceEvaluation.EvaluatedPlace(place = place, value = fields[field].value)
                            else:
                                let class_place = self.full.class_field_place(place, base, field) else trap("mutating field receiver has a non-record base")
                                return class_place
                    TransferredPlace(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
            SequenceIndex(inner, index_node):
                match try self.evaluate_mutable_place(inner, bindings):
                    EvaluatedPlace(place, base):
                        match try self.evaluate(index_node, bindings):
                            Evaluated(index_value):
                                match index_value:
                                    UnsignedInteger(index):
                                        match base:
                                            Array(elements):
                                                if index >= u64(len(elements)): error("interpreter: index out of bounds")
                                                place.steps.append(AssignmentPlaceStep.Element(index = i64(index)))
                                                return PlaceEvaluation.EvaluatedPlace(place = place, value = elements[index].value)
                                            List(storage):
                                                if index >= u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                                place.steps.append(AssignmentPlaceStep.ListElement(index = i64(index)))
                                                return PlaceEvaluation.EvaluatedPlace(place = place, value = storage.buffer.elements[index].value)
                                            else: trap("mutating element receiver has a non-sequence base")
                                    else: trap("mutating element receiver has a non-integer index")
                            Transferred(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
                    TransferredPlace(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
            else: trap("mutating call on a value that is not a place")

    # Construction owns fresh receiver storage. The initializer's source
    # result is unit-shaped; success substitutes the completed receiver while
    # failure preserves the Error unchanged.
    func evaluate_initializer(site_node: NodeId, function: SymbolId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let target = self.find_function(function)
        let receiver = target.receiver else trap("initializer without a receiver")
        if receiver.kind != HirReceiverKind.initializer: trap("Initialize names a non-initializer")
        let values = list[Value]()
        for parameter in target.parameters: values.append(Value.Unit)
        let class_receiver = self.full.initialize_class_receiver(self, site_node, receiver.owner)
        if class_receiver != none:
            values[0] = class_receiver
        else:
            match self.program.types.definitions[receiver.owner.value].form:
                Struct(struct_index, type_arguments):
                    let fields = list[BoxedValue]()
                    for field in nominal_fields(self.program, receiver.owner):
                        fields.append(BoxedValue(value = Value.Unit))
                    values[0] = Value.Record(fields = fields)
                else: trap("initializer receiver is not a struct or class")
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            match try self.evaluate(argument, bindings):
                Evaluated(item): values[parameter_index] = item
                Transferred(execution): return Evaluation.Transferred(execution = execution)
        let invocation = try self.call(target, values)
        match invocation.value:
            FallibleSuccess(success):
                self.full.mark_initialized(invocation.receiver)
                return Evaluation.Evaluated(value = Value.FallibleSuccess(value = BoxedValue(value = invocation.receiver)))
            FallibleFailure(failure): return Evaluation.Evaluated(value = invocation.value)
            else:
                self.full.mark_initialized(invocation.receiver)
                return Evaluation.Evaluated(value = invocation.receiver)

    func evaluate_match(subject: NodeId, arms: Operands, bindings: list[Binding]) -> Evaluation!:
        let evaluated = try self.evaluate(subject, bindings)
        var selected = Value.Unit
        match evaluated:
            Evaluated(item): selected = item
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        let outer_count = len(bindings)
        for position in range(0, i64(arms.count)):
            let arm = node_at(self.program, arms, position)
            match node_form(self.program, arm):
                MatchArm(patterns, statements, value, guard):
                    if try self.arm_matches(patterns, selected, bindings):
                        if guard.value != no_node:
                            var passes = false
                            match try self.evaluate(guard, bindings):
                                Evaluated(item): passes = as_boolean(item)
                                Transferred(execution): return Evaluation.Transferred(execution = execution)
                            if not passes:
                                trim_bindings(bindings, outer_count)
                                continue
                        let result = try self.evaluate(value, bindings)
                        trim_bindings(bindings, outer_count)
                        return result
                else: trap("match arm run names a non-arm node")
        trap("checked `match` selected no arm")

    # Handle the failure of exactly `value`. Success bypasses the handler;
    # failure binds Error and runs a lexical scope whose Recovered transfer
    # becomes this expression's value. Every other transfer keeps travelling.
    func evaluate_catch(value: NodeId, failure: SymbolId, body: Operands, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate(value, bindings):
            Transferred(execution): return Evaluation.Transferred(execution = execution)
            Evaluated(item):
                match item:
                    FallibleSuccess(success): return Evaluation.Evaluated(value = success.value)
                    FallibleFailure(error_value):
                        let outer_count = len(bindings)
                        bindings.append(Binding(symbol = failure, value = error_value.value))
                        let outcome = try self.execute_scope(body, bindings)
                        trim_bindings(bindings, outer_count)
                        match outcome:
                            Recovered(recovered): return Evaluation.Evaluated(value = recovered)
                            Next: trap("checked catch handler finished without transferring")
                            else: return Evaluation.Transferred(execution = outcome)
                    else: trap("typed `catch` received a non-fallible HIR value")

    # mark: Patterns ============================================================================

    # Does any alternative of an arm match? A case pattern that matches also
    # binds its payload, so the arm's body sees the names.
    func arm_matches(patterns: Operands, selected: Value, bindings: list[Binding]) -> bool!:
        for position in range(0, i64(patterns.count)):
            if try self.pattern_matches(node_at(self.program, patterns, position), selected, bindings): return true
        return false

    func pattern_matches(pattern: NodeId, selected: Value, bindings: list[Binding]) -> bool!:
        match node_form(self.program, pattern):
            PatternWildcard: return true
            PatternLiteral(value):
                return as_boolean(try evaluate_binary(selected, BinaryOperation.Equal(operand_type = TypeId(value = 0)), self.program.values[value], self.program.types))
            PatternRange(lower, upper, inclusive):
                let low = self.program.values[lower]
                let high = self.program.values[upper]
                if not as_boolean(try evaluate_binary(low, BinaryOperation.LessEqual(operand_type = TypeId(value = 0)), selected, self.program.types)): return false
                if inclusive: return as_boolean(try evaluate_binary(selected, BinaryOperation.LessEqual(operand_type = TypeId(value = 0)), high, self.program.types))
                return as_boolean(try evaluate_binary(selected, BinaryOperation.Less(operand_type = TypeId(value = 0)), high, self.program.types))
            PatternCase(case_index, pattern_bindings):
                match selected:
                    Variant(actual, payload):
                        if actual != case_index: return false
                        for position in range(0, i64(pattern_bindings.count)):
                            bindings.append(Binding(symbol = SymbolId(value = u32(entry_at(self.program, pattern_bindings, position))), value = payload[position].value))
                        return true
                    SignedInteger(item): return self.integer_case_matches(pattern, selected, case_index)
                    UnsignedInteger(item): return self.integer_case_matches(pattern, selected, case_index)
                    Absent: return case_index == 0
                    Present(item):
                        if case_index != 1: return false
                        if pattern_bindings.count > 0:
                            bindings.append(Binding(symbol = SymbolId(value = u32(entry_at(self.program, pattern_bindings, 0))), value = item.value))
                        return true
                    else: trap("case pattern applied to non-enum, non-optional value `" + selected.render() + "`")
            else: trap("match pattern run names a non-pattern node")

    # `.case` on an integer-backed enum matches the case's declared value.
    func integer_case_matches(pattern: NodeId, selected: Value, case_index: i64) -> bool:
        let shape = integer_enum_shape(self.program, node_type(self.program, pattern)) else trap("case pattern applied to an integer that is not an integer-backed enum")
        return integer_values_match(shape.values[case_index], selected)

    # A run of field indices as plain integers.
    func entries(run: Operands) -> list[i64]:
        let items = list[i64]()
        for position in range(0, i64(run.count)): items.append(entry_at(self.program, run, position))
        return items

    # mark: Program lookup ======================================================================

    # Resolve the external `module.function` request once at the execution
    # boundary; internal calls below use only SymbolId.
    func find_entry(module_name: str, function_name: str) -> HirFunction!:
        for module in self.program.modules:
            if module.name == module_name:
                for function in self.program.functions:
                    if function.module.value == module.id.value and function.name == function_name: return function
                error("interpreter: module `" + module_name + "` has no function `" + function_name + "`")
        error("interpreter: unknown module `" + module_name + "`")

    # Find an internal call target by its resolved program-wide symbol.
    pub func find_function(symbol: SymbolId) -> HirFunction:
        let index = self.function_by_symbol[symbol.value]
        if index < 0: trap("typed call refers to an unknown function")
        return self.program.functions[index]
