#==============================================================================================
#
#   interpreter - The semantic oracle
#
#   DESCRIPTION:
#       The default execution backend: runs typed IR directly, no lowering and
#       no artifact. Every compiled backend must agree with what this one does
#       (LUCE_LANGUAGE_DESIGN.md §23.3) — when they disagree, the interpreter
#       is right.
#
#       Public use begins at `Interpreter.run`. Call frames, lexical scope,
#       argument order, and control transfer stay private to one run, and
#       evaluation trusts the checker completely: a shape the checker could not
#       have produced is a trap here, never a user-facing error.
#
#==============================================================================================

from compiler.backend import ExecutionBackend
from compiler.typed_ir import SymbolId, TypedExpression, TypedFunction, TypedProgram
from compiler.typed_ir import TypedStatement, Value

# mark: Run state =============================================================================

# One live local: the value currently bound to a symbol in some call frame.
struct Binding:
    pub symbol: SymbolId
    pub value: Value

# How one statement left: fall through to the next, return a value, or unwind
# to the enclosing loop.
union Execution:
    Next
    Returned(value: Value)
    Broke
    Continued

## The reusable interpreter backend. Each execution gets private program state.
pub class Interpreter: ExecutionBackend:
    pub init():
        # Stateless; stage-0 requires one statement in an empty init.
        return

    pub func run(program: TypedProgram, module_name: str, function_name: str) -> Value!:
        return try InterpreterRun(program).run(module_name, function_name)

# Executes one checked program directly by symbol identity.
class InterpreterRun:
    program: TypedProgram

    pub init(program: TypedProgram):
        self.program = program

    ## Run one public, argument-free entry function to its returned value.
    pub func run(module_name: str, function_name: str) -> Value!:
        let function = try self.find_entry(module_name, function_name)
        if not function.is_public:
            error("interpreter: `" + module_name + "." + function_name + "` is private")
        if len(function.parameters) > 0:
            error("interpreter: entry function `" + module_name + "." + function_name + "` must take no arguments")
        return self.invoke(function, list[Value]())

    # mark: Functions and scopes ================================================================

    # Call one function: a fresh frame holding the arguments, then the body.
    func invoke(function: TypedFunction, arguments: list[Value]) -> Value:
        let bindings = list[Binding]()
        var index = 0
        while index < len(function.parameters):
            bindings.append(Binding(symbol = function.parameters[index].symbol, value = arguments[index]))
            index += 1

        match self.execute_scope(function.body, bindings):
            Returned(value): return value
            Next:
                if function.result.name == "unit": return Value.Unit
                trap("checked function `" + function.name + "` finished without returning a value")
            else: trap("loop control escaped a function")

    # A suite is one lexical scope: bindings made inside it are trimmed away
    # however the suite exits.
    func execute_scope(statements: list[TypedStatement], bindings: list[Binding]) -> Execution:
        let outer_count = len(bindings)
        for statement in statements:
            let result = self.execute(statement, bindings)
            match result:
                Next: continue
                else:
                    trim_bindings(bindings, outer_count)
                    return result
        trim_bindings(bindings, outer_count)
        return Execution.Next

    # Execute one statement and report how it left.
    func execute(statement: TypedStatement, bindings: list[Binding]) -> Execution:
        match statement.form:
            BreakStatement: return Execution.Broke
            ContinueStatement: return Execution.Continued
            Binding(symbol, name, is_mutable, value):
                bindings.append(Binding(symbol = symbol, value = self.evaluate(value, bindings)))
                return Execution.Next
            Assignment(symbol, operator, value):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed assignment refers to an unknown binding")
                let right = self.evaluate(value, bindings)
                var assigned = right
                # `value += delta` evaluates the binary operation it abbreviates.
                if operator != "=":
                    assigned = evaluate_binary(bindings[index].value, operator[0:len(operator) - 1], right)
                bindings[index] = Binding(symbol = symbol, value = assigned)
                return Execution.Next
            PrintText(value):
                print(value)
                return Execution.Next
            ReturnStatement(value):
                if value == none: return Execution.Returned(value = Value.Unit)
                let returned = value
                return Execution.Returned(value = self.evaluate(returned, bindings))
            ExpressionStatement(value):
                self.evaluate(value, bindings)
                return Execution.Next
            IfStatement(branches, fallback):
                for branch in branches:
                    if as_boolean(self.evaluate(branch.condition, bindings)):
                        return self.execute_scope(branch.body, bindings)
                if fallback != none:
                    let body = fallback
                    return self.execute_scope(body, bindings)
                return Execution.Next
            WhileStatement(condition, body):
                while as_boolean(self.evaluate(condition, bindings)):
                    match self.execute_scope(body, bindings):
                        Next: continue
                        Continued: continue
                        Broke: return Execution.Next
                        Returned(value): return Execution.Returned(value = value)
                return Execution.Next

    # mark: Expressions =========================================================================

    # Evaluate one expression to its value.
    func evaluate(expression: TypedExpression, bindings: list[Binding]) -> Value:
        match expression.form:
            Constant(value): return value
            Reference(symbol):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed reference points outside its call frame")
                return bindings[index].value
            Unary(operator, operand):
                return evaluate_unary(operator, self.evaluate(operand, bindings))
            Binary(left, operator, right):
                let left_value = self.evaluate(left, bindings)
                # `and` and `or` short-circuit: the right side must not run
                # when the left side already decides the answer.
                if operator == "and":
                    if not as_boolean(left_value): return Value.Boolean(value = false)
                    return Value.Boolean(value = as_boolean(self.evaluate(right, bindings)))
                if operator == "or":
                    if as_boolean(left_value): return Value.Boolean(value = true)
                    return Value.Boolean(value = as_boolean(self.evaluate(right, bindings)))
                return evaluate_binary(left_value, operator, self.evaluate(right, bindings))
            Conditional(value, condition, alternative):
                if as_boolean(self.evaluate(condition, bindings)):
                    return self.evaluate(value, bindings)
                return self.evaluate(alternative, bindings)
            Call(function, arguments):
                let target = self.find_function(function)
                let values = list[Value]()
                for parameter in target.parameters: values.append(Value.Unit)
                for argument in arguments:
                    values[argument.parameter_index] = self.evaluate(argument.value, bindings)
                return self.invoke(target, values)

    # mark: Program lookup ======================================================================

    func find_entry(module_name: str, function_name: str) -> TypedFunction!:
        for module in self.program.modules:
            if module.name == module_name:
                for function in module.functions:
                    if function.name == function_name: return function
                error("interpreter: module `" + module_name + "` has no function `" + function_name + "`")
        error("interpreter: unknown module `" + module_name + "`")

    func find_function(symbol: SymbolId) -> TypedFunction:
        for module in self.program.modules:
            for function in module.functions:
                if function.symbol.value == symbol.value: return function
        trap("typed call refers to an unknown function")

# mark: Bindings ==============================================================================

func trim_bindings(bindings: list[Binding], count: i64):
    while len(bindings) > count: bindings.remove(len(bindings) - 1)

# Innermost binding first, so a suite's binding wins over an outer one.
func find_binding(bindings: list[Binding], symbol: SymbolId) -> i64:
    var index = len(bindings) - 1
    while index >= 0:
        if bindings[index].symbol.value == symbol.value: return index
        index -= 1
    return -1

# mark: Operators =============================================================================

func as_boolean(value: Value) -> bool:
    match value:
        Boolean(item): return item
        else: trap("typed Boolean expression contains another value")

func evaluate_unary(operator: str, value: Value) -> Value:
    match value:
        Boolean(item):
            if operator == "not": return Value.Boolean(value = not item)
        Integer(item):
            if operator == "+": return value
            if operator == "-": return Value.Integer(value = -item)
            if operator == "~": return Value.Integer(value = ~item)
        Floating(item):
            if operator == "+": return value
            if operator == "-": return Value.Floating(value = -item)
        else: trap("unit has no unary operators")
    trap("typed unary expression contains an invalid operator")

# Dispatch on the value family; the checker already guaranteed both sides
# share it, so a mismatch here is a compiler bug, not a user error.
func evaluate_binary(left: Value, operator: str, right: Value) -> Value:
    match left:
        Unit:
            match right:
                Unit:
                    if operator == "==": return Value.Boolean(value = true)
                    if operator == "!=": return Value.Boolean(value = false)
                else: trap("typed binary expression has unequal value types")
        Boolean(left_value):
            match right:
                Boolean(right_value):
                    if operator == "==": return Value.Boolean(value = left_value == right_value)
                    if operator == "!=": return Value.Boolean(value = left_value != right_value)
                else: trap("typed binary expression has unequal value types")
        Integer(left_value):
            match right:
                Integer(right_value): return evaluate_integer_binary(left_value, operator, right_value)
                else: trap("typed binary expression has unequal value types")
        Floating(left_value):
            match right:
                Floating(right_value): return evaluate_float_binary(left_value, operator, right_value)
                else: trap("typed binary expression has unequal value types")
    trap("typed binary expression contains an invalid operator")

func evaluate_integer_binary(left: i64, operator: str, right: i64) -> Value:
    match operator:
        "+": return Value.Integer(value = left + right)
        "-": return Value.Integer(value = left - right)
        "*": return Value.Integer(value = left * right)
        "//": return Value.Integer(value = left // right)
        "%": return Value.Integer(value = left % right)
        "&": return Value.Integer(value = left & right)
        "|": return Value.Integer(value = left | right)
        "^": return Value.Integer(value = left ^ right)
        "<<": return Value.Integer(value = left << right)
        ">>": return Value.Integer(value = left >> right)
        "==": return Value.Boolean(value = left == right)
        "!=": return Value.Boolean(value = left != right)
        "<": return Value.Boolean(value = left < right)
        "<=": return Value.Boolean(value = left <= right)
        ">": return Value.Boolean(value = left > right)
        ">=": return Value.Boolean(value = left >= right)
        else: trap("typed integer expression contains an invalid operator")

func evaluate_float_binary(left: f64, operator: str, right: f64) -> Value:
    match operator:
        "+": return Value.Floating(value = left + right)
        "-": return Value.Floating(value = left - right)
        "*": return Value.Floating(value = left * right)
        "/": return Value.Floating(value = left / right)
        "==": return Value.Boolean(value = left == right)
        "!=": return Value.Boolean(value = left != right)
        "<": return Value.Boolean(value = left < right)
        "<=": return Value.Boolean(value = left <= right)
        ">": return Value.Boolean(value = left > right)
        ">=": return Value.Boolean(value = left >= right)
        else: trap("typed floating-point expression contains an invalid operator")
