#==============================================================================================
#
#   interpreter - The semantic oracle
#
#   DESCRIPTION:
#       The default execution backend: runs analyzed typed HIR directly, with
#       no MIR lowering and no artifact. Every compiled backend must agree with
#       what this one does (docs/language/1.0.md §23.3) — when they disagree,
#       the interpreter is right.
#
#       Public use begins at `HirInterpreter.run`. Call frames, lexical scope,
#       argument order, and control transfer stay private to one run, and
#       evaluation trusts HirGenerator completely: a shape it could not
#       have produced is a trap here, never a user-facing error.
#
#==============================================================================================

from compiler.backend import HirExecutionBackend
from compiler.hir.ir import AssignmentOperation, BinaryOperation, BoxedValue, BuiltinType, CapturedCellStorage, ClassFinalizer, ClassStorage, ClosureStorage, HashEntry, HashStorage, HirCaptureKind, HirNodeForm, InterfaceStorage, ListBuffer, ListStorage, NodeId, SliceBacking, SliceStorage, WeakClassStorage
from compiler.hir.ir import HirCFunction, HirCFunctionIdentity, HirCSlot, HirExternVariable, HirFunction, HirFunctionImplementation, HirIteration, HirProgram, HirReceiverKind, Operands, SymbolId, TypeId, UnaryOperation, Value, no_node
from compiler.hir.ir import class_application, entry_at, node_at, node_form, node_type, nominal_cases, nominal_fields
from compiler.hir.ir import TypeTable, floating_bit_width, integer_bit_width, integer_maximum, integer_minimum, unsigned_integer_maximum
from compiler.hir.ir import describe_type, function_body, is_floating_type, is_integer_type, is_unsigned_integer_type, resolve_builtin_type, types_match
from compiler.hir.ir import place_class_field_step, place_element_step, place_field_step, place_list_element_step, place_map_element_step, place_weak_field_step
from compiler.hir.analyzer import AnalyzedProgram
from compiler.formatting.float_display import display_float32, display_float64
from compiler.formatting.ieee import normalize_ieee_float
import std.strings

# mark: Run state =============================================================================

# One live local: the value currently bound to a symbol in some call frame.
struct Binding:
    pub let symbol: SymbolId
    pub let value: Value

# One resolved step of an assignment place. Dynamic index expressions have
# already run when an Element reaches the value-rebuilding helpers.
union AssignmentPlaceStep:
    Field(index: i64)
    ClassField(index: i64)
    WeakField(index: i64)
    Element(index: i64)
    ListElement(index: i64)
    MapElement(key: BoxedValue)

# A mutable place: a binding and resolved field/element steps to its value.
struct Place:
    pub let symbol: SymbolId
    pub let steps: list[AssignmentPlaceStep]

# What one call produced, plus the receiver's final value so a mutating
# method's writes to `self` can be copied back into the caller's place.
struct Invocation:
    pub let value: Value
    pub let receiver: Value

# How one statement left: fall through to the next, return a value, or unwind
# to the enclosing loop.
union Execution:
    Next
    Returned(value: Value)
    Raised(error_value: Value)
    Recovered(value: Value)
    Broke
    Continued

# Expression evaluation either produces its typed value or transfers control
# through the surrounding statement/scope. Host `!` remains reserved for
# traps and compiler/runtime faults; recoverable Luce failure never uses it.
union Evaluation:
    Evaluated(value: Value)
    Transferred(execution: Execution)

union PlaceUpdate:
    Updated(value: Value)
    Transferred(execution: Execution)

union RunEvaluation:
    EvaluatedRun(values: list[BoxedValue])
    TransferredRun(execution: Execution)

union ListEvaluation:
    EvaluatedList(storage: ListStorage)
    TransferredList(execution: Execution)

union HashEvaluation:
    EvaluatedHash(storage: HashStorage)
    TransferredHash(execution: Execution)

union PlaceEvaluation:
    EvaluatedPlace(place: Place, value: Value)
    TransferredPlace(execution: Execution)

## Deterministic bindings for source `extern func` declarations. Artifact
## backends bind the same callable by their own host mechanism; the semantic
## oracle receives behavior explicitly and never consults ambient symbols.
## `result` is the declared C return (unit for void); `outputs` contains raw
## C-shaped values for every `out` slot in declaration order.
pub struct HirExternResult:
    pub let result: Value
    pub let outputs: list[Value]

pub interface HirExternHost:
    func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!

## Behavior for an opaque C function pointer returned by an extern. Keeping
## this separate from named declarations forces semantic tests to prove that
## the pointer identity really survived the boundary.
pub interface HirCFunctionPointerHost:
    func call(pointer: i64, arguments: list[Value]) -> Value!

## Explicit mutable storage for source `extern var` declarations. Keeping it
## separate from callable bindings lets an oracle host provide only the kind
## of foreign state a test uses.
pub interface HirExternVariableHost:
    func load(variable: HirExternVariable) -> Value!
    func store(variable: HirExternVariable, value: Value) -> !

## The reusable interpreter backend. Each execution gets private program state.
pub class HirInterpreter: HirExecutionBackend:
    ## Create a stateless HIR interpreter; each `run` owns its call frames.
    pub init():
        # Stateless; Stage-0 requires one statement in an empty init.
        return

    ## Run one selected function from an analyzed HIR program.
    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        return try HirInterpreterRun(program.hir, none, none, none).run(module_name, function_name)

    ## Run with explicit behavior for any host-supplied C functions reached.
    pub func run_with_host(program: AnalyzedProgram, module_name: str, function_name: str, host: HirExternHost) -> Value!:
        return try HirInterpreterRun(program.hir, host, none, none).run(module_name, function_name)

    ## Run with C-owned global storage but no callable C imports.
    pub func run_with_globals(program: AnalyzedProgram, module_name: str, function_name: str, host: HirExternVariableHost) -> Value!:
        return try HirInterpreterRun(program.hir, none, host, none).run(module_name, function_name)

    ## Run a program that uses both callable imports and C-owned globals.
    pub func run_with_hosts(program: AnalyzedProgram, module_name: str, function_name: str, functions: HirExternHost?, variables: HirExternVariableHost?) -> Value!:
        return try HirInterpreterRun(program.hir, functions, variables, none).run(module_name, function_name)

    ## Run with both named extern bindings and arbitrary C function pointers.
    pub func run_with_c_function_pointers(program: AnalyzedProgram, module_name: str, function_name: str, functions: HirExternHost, pointers: HirCFunctionPointerHost) -> Value!:
        return try HirInterpreterRun(program.hir, functions, none, pointers).run(module_name, function_name)

    ## Invoke one exact C export as an external caller would: arguments arrive
    ## in C boundary form and the result leaves in that form. This keeps export
    ## adaptation inside the semantic oracle instead of teaching tests or
    ## hosts how tagged Luce optionals happen to be represented.
    pub func call_c_export(program: AnalyzedProgram, function_name: str, arguments: list[Value]) -> Value!:
        return try HirInterpreterRun(program.hir, none, none, none).call_c_export(function_name, arguments)

# Executes one checked program directly by symbol identity.
# Frames the interpreter allows before reporting exhaustion. Unbounded
# recursion is a trap in the language (section 13.4); the bound is what turns
# it into a reported failure rather than the host's own stack limit, so it
# must trip well before the guard page does.
#
# Measured on 0.25/arm64-macOS, not guessed. One interpreted call costs six
# host frames: evaluate 8768 + execute 8768 + execute_scope 8944 + call 608 +
# evaluate_call 2832 + evaluate 2032, about 32 KiB. Under the 512 MiB
# Stage-0 reserves that is a true ceiling of 16625 frames for a thin callee
# and 12875 for a fat one; past it the process takes SIGBUS instead of
# reporting. 2000 keeps a sixfold margin and clears the deepest fixture
# (`down(1500)`).
#
# Two things this number is honest about. Real implementations divide by ten
# to a hundred, not six (Swift caps parser nesting at 256 under a ceiling
# near 28000; Clang the same shape), because per-frame cost depends on the
# shape of the input. And 32 KiB per call is itself eight to thirty times
# the 1-4 KiB a lean tree-walker spends — it is Stage-0 allocating a slot per
# `match` arm in walkers like `evaluate`, reported in
# `build/stage0-0.25-repro/`. The durable fix is thinner frames and a limit
# derived at startup from the real stack bounds, not a larger constant here;
# both are on the checklist in `plan.md` §5.
let frame_limit: i64 = 2000

# Mirror canonical MIR's zero-filled global storage as semantic values.
# HirGenerator has already rejected types for which zero would forge an
# address, callable, foreign handle, failure effect, or `never` value.
func zero_hir_value(program: HirProgram, value_type: TypeId) -> Value:
    match program.types.definitions[value_type.value].form:
        Boolean: return Value.Boolean(value = false)
        Integer(bits, is_signed):
            if is_signed: return Value.SignedInteger(value = 0)
            return Value.UnsignedInteger(value = u64(0))
        Floating(bits): return Value.Floating(value = 0.0)
        Character: return Value.Character(value = char(0))
        String: return Value.Text(value = "")
        Bytes: return Value.Bytes(value = list[u8]())
        Range(element):
            return Value.Record(fields = [
                BoxedValue(value = zero_hir_value(program, element)),
                BoxedValue(value = zero_hir_value(program, element)),
                BoxedValue(value = Value.Boolean(value = false)),
            ])
        Array(element, count):
            let elements = list[BoxedValue]()
            for index in range(0, count): elements.append(BoxedValue(value = zero_hir_value(program, element)))
            return Value.Array(elements = elements)
        Optional(inner): return Value.Absent
        Tuple(elements):
            let values = list[BoxedValue]()
            for element in elements: values.append(BoxedValue(value = zero_hir_value(program, element)))
            return Value.Tuple(elements = values)
        else: trap("checked runtime global has no structural zero")

class HirInterpreterRun: ClassFinalizer:
    let program: HirProgram
    let external_host: HirExternHost?
    let external_variable_host: HirExternVariableHost?
    let c_function_pointer_host: HirCFunctionPointerHost?
    ## Luce-owned module state belongs to one interpreter instance and is
    ## distinct from C-owned globals supplied by `external_variable_host`.
    let globals: list[Value]
    var depth: i64

    # Retain the immutable semantic program used for all calls in this run.
    pub init(program: HirProgram, external_host: HirExternHost?, external_variable_host: HirExternVariableHost?, c_function_pointer_host: HirCFunctionPointerHost?):
        self.program = program
        self.external_host = external_host
        self.external_variable_host = external_variable_host
        self.c_function_pointer_host = c_function_pointer_host
        self.globals = list[Value]()
        for global in program.globals:
            self.globals.append(zero_hir_value(program, global.value_type))
        self.depth = 0

    ## Host ARC reaches this callback exactly when an interpreted class loses
    ## its final strong reference. Source `deinit` runs before payload fields;
    ## removing those fields from the tail establishes reverse declaration
    ## order independently of the host list implementation.
    pub func finalize(class_type: TypeId, fields: list[BoxedValue], run_deinitializer: bool):
        self.finalize_class(class_type, fields, run_deinitializer) catch reason:
            trap(reason)

    func finalize_class(class_type: TypeId, fields: list[BoxedValue], run_deinitializer: bool) -> !:
        let deinitializer = class_application(self.program, class_type).deinitializer
        if run_deinitializer and deinitializer != none:
            let target = self.find_function(deinitializer)
            # Stage-0 rightly forbids passing a dying `self` as a new strong
            # callback argument. A non-finalizing proxy over the same payload
            # supplies the borrowed source receiver without resurrecting the
            # original identity or recursively invoking finalization.
            let proxy = ClassStorage(class_type, fields, self, false, false, true)
            let invocation = try self.call(target, [Value.Class(storage = proxy)])
            match invocation.value:
                Unit: pass
                else: trap("checked class deinitializer returned a value")

        # Box destruction, and therefore nested class finalization, follows
        # source declaration order in reverse rather than host list policy.
        var remaining = len(fields)
        while remaining > 0:
            remaining -= 1
            fields.remove(remaining)

    ## Run one public entry function to its returned value. It takes no
    ## arguments, or the process entry's `(arguments: slice[str])`, which
    ## receives an empty slice: the interpreter has no command line to pass.
    pub func run(module_name: str, function_name: str) -> Value!:
        let function = try self.find_entry(module_name, function_name)
        if not function.is_public:
            error("interpreter: `" + module_name + "." + function_name + "` is private")
        let arguments = list[Value]()
        if len(function.parameters) == 1 and types_match(function.parameters[0].value_type, resolve_builtin_type(BuiltinType.string_slice)):
            arguments.append(Value.TextSlice(items = list[str]()))
        elif len(function.parameters) > 0:
            error("interpreter: entry function `" + module_name + "." + function_name + "` must take no arguments")
        let result = try self.invoke(function, arguments)
        match result:
            FallibleSuccess(success): return success.value
            FallibleFailure(failure):
                error("interpreter: unhandled failure from `" + module_name + "." + function_name + "`: " + render_error(failure.value))
            else: return result

    func call_c_export(function_name: str, arguments: list[Value]) -> Value!:
        var selected: HirFunction? = none
        for function in self.program.functions:
            if function.name != function_name: continue
            match function.implementation:
                ExportedC(body):
                    if selected != none: error("interpreter: duplicate C export `" + function_name + "`")
                    selected = function
                else: pass
        let function = selected else error("interpreter: unknown C export `" + function_name + "`")
        if len(arguments) != len(function.parameters):
            error("interpreter: C export `" + function_name + "` expects " + str(len(function.parameters)) + " argument(s), got " + str(len(arguments)))
        let decoded = list[Value]()
        for index in range(0, len(arguments)):
            decoded.append(try self.decode_c_argument(function, arguments[index], function.parameters[index].value_type, "parameter `" + function.parameters[index].name + "`"))
        let result = try self.invoke(function, decoded)
        return try self.encode_c_value(function, result, function.result, "result")

    # mark: Functions and scopes ================================================================

    # Call one function: a fresh frame holding the arguments, then the body.
    func invoke(function: HirFunction, arguments: list[Value]) -> Value!:
        return (try self.call(function, arguments)).value

    # The parameters outlive the body's scope, so after the body runs the
    # frame still holds `self` as the method left it.
    func call(function: HirFunction, arguments: list[Value]) -> Invocation!:
        return try self.call_with_captures(function, arguments, list[Value]())

    func call_with_captures(function: HirFunction, arguments: list[Value], captures: list[Value]) -> Invocation!:
        match function.implementation:
            ExternalC(contract):
                let host = self.external_host else error("interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` has no host binding")
                let encoded = try self.encode_c_arguments(function, arguments)
                let external_result = try host.call(function, encoded)
                let result = try self.decode_c_result(function, contract, external_result)
                return Invocation(value = result, receiver = Value.Unit)
            else: pass
        if self.depth >= frame_limit: error("interpreter: call depth exceeded " + str(frame_limit) + " frames in `" + function.name + "`")
        let bindings = list[Binding]()
        let closure_index = function.closure
        if closure_index != none:
            let capture_table = self.program.closures[closure_index].captures
            if len(captures) != len(capture_table): trap("closure environment does not match its HIR capture table")
            for capture_index in range(0, len(capture_table)):
                bindings.append(Binding(symbol = capture_table[capture_index].symbol, value = captures[capture_index]))
        elif len(captures) > 0:
            trap("capture-free function received a closure environment")
        var index = 0
        while index < len(function.parameters):
            bindings.append(Binding(symbol = function.parameters[index].symbol, value = self.initial_binding(function.parameters[index].symbol, arguments[index])))
            index += 1

        self.depth += 1
        let outcome = self.execute_scope(function_body(function), bindings) catch reason:
            self.depth -= 1
            error(reason)
        self.depth -= 1
        var receiver = Value.Unit
        if len(bindings) > 0: receiver = bindings[0].value
        match outcome:
            Returned(value):
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner): return Invocation(value = Value.FallibleSuccess(value = BoxedValue(value = value)), receiver = receiver)
                    else: return Invocation(value = value, receiver = receiver)
            Raised(error_value):
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner): return Invocation(value = Value.FallibleFailure(error_value = BoxedValue(value = error_value)), receiver = receiver)
                    else: trap("failure escaped a non-fallible checked function")
            Next:
                if types_match(function.result, resolve_builtin_type(BuiltinType.unit)): return Invocation(value = Value.Unit, receiver = receiver)
                match self.program.types.definitions[function.result.value].form:
                    Fallible(inner):
                        if types_match(inner, resolve_builtin_type(BuiltinType.unit)):
                            return Invocation(value = Value.FallibleSuccess(value = BoxedValue(value = Value.Unit)), receiver = receiver)
                    else: pass
                trap("checked function `" + function.name + "` finished without returning a value")
            Recovered(value): trap("recover escaped its catch handler")
            else: trap("loop control escaped a function")

    # mark: Captured local storage ==============================================================

    # Promotion is a property of the semantic symbol, not of the point where
    # its declaration executes. Parameters and local bindings therefore pass
    # through the same initializer and converge on one cell identity.
    func initial_binding(symbol: SymbolId, value: Value) -> Value:
        if not self.is_shared_cell(symbol): return value
        match value:
            CapturedCell(storage): return value
            else: return Value.CapturedCell(storage = CapturedCellStorage(value = value))

    func is_shared_cell(symbol: SymbolId) -> bool:
        for shared in self.program.shared_cells:
            if shared.value == symbol.value: return true
        return false

    # Source reads see the cell payload; closure construction alone reads the
    # raw binding so it can share the cell rather than snapshot its value.
    func binding_value(value: Value) -> Value:
        match value:
            CapturedCell(storage): return storage.value.value
            else: return value

    func assign_binding(bindings: list[Binding], index: i64, value: Value):
        match bindings[index].value:
            CapturedCell(storage): storage.value = BoxedValue(value = value)
            else: bindings[index] = Binding(symbol = bindings[index].symbol, value = value)

    # mark: C boundary ==========================================================================

    # Encode ordinary semantic values into the C-shaped values an explicit
    # host receives. This is a boundary operation: tagged optionals become a
    # zero/nonzero token, and a zero token in a bare pointer slot traps.
    func encode_c_arguments(function: HirFunction, arguments: list[Value]) -> list[Value]!:
        let encoded = list[Value]()
        for index in range(0, len(arguments)):
            encoded.append(try self.encode_c_value(function, arguments[index], function.parameters[index].value_type, "parameter `" + function.parameters[index].name + "`"))
        return encoded

    func encode_c_value(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        if self.is_extern_struct(value_type):
            return try self.transcode_extern_struct(function, value, value_type, slot, true)
        match self.program.types.definitions[value_type.value].form:
            List(element_type):
                match value:
                    List(storage):
                        # The semantic host receives an immutable C-shaped
                        # sequence. Compiled execution exposes the same dense
                        # elements without this oracle materialization.
                        let elements = list[BoxedValue]()
                        for index in range(0, len(storage.buffer.elements)):
                            elements.append(BoxedValue(value = try self.encode_c_component(
                                storage.buffer.elements[index].value,
                                element_type,
                                self.null_foreign(function, slot + " element " + str(index)),
                            )))
                        return Value.Array(elements = elements)
                    else: trap("typed borrowed-list slot contains a non-list value")
            else: pass
        if types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            match value:
                Text(text):
                    let encoded = strings.to_bytes(text)
                    encoded.append(u8(0))
                    return Value.Bytes(value = encoded)
                else: trap("typed string slot contains a non-string value")
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                Absent: return Value.CFunction(identity = HirCFunctionIdentity.ForeignPointer(token = 0))
                Present(item):
                    match item.value:
                        CFunction(identity): return item.value
                        else: trap("typed nullable cfunc contains a non-cfunc value")
                else: trap("typed nullable cfunc has a non-optional value")
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity):
                        match identity:
                            ForeignPointer(token):
                                if token == 0: error(self.null_foreign(function, slot))
                            Declared(symbol): pass
                        return value
                    else: trap("typed cfunc slot contains a non-cfunc value")
            else: pass

        return try self.encode_c_component(value, value_type, self.null_foreign(function, slot))

    # Decode the declared return and every output immediately after a C call,
    # then apply the one source result-shaping rule from HirGenerator.
    func decode_c_result(function: HirFunction, contract: HirCFunction, external: HirExternResult) -> Value!:
        let values = list[BoxedValue]()
        if types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            match external.result:
                Unit: pass
                else: error(self.incompatible_c_result(function, "result", contract.declared_result))
        else:
            values.append(BoxedValue(value = try self.decode_c_value(function, external.result, contract.declared_result, "result")))

        var expected_outputs = 0
        for slot in contract.slots:
            match slot:
                Output(name, value_type): expected_outputs += 1
                Input(parameter): pass
        if len(external.outputs) != expected_outputs:
            error("interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` returned " + str(len(external.outputs)) + " out value(s), expected " + str(expected_outputs))
        var output_index = 0
        for slot in contract.slots:
            match slot:
                Output(name, value_type):
                    values.append(BoxedValue(value = try self.decode_c_value(function, external.outputs[output_index], value_type, "out parameter `" + name + "`")))
                    output_index += 1
                Input(parameter): pass

        if len(values) == 0: return Value.Unit
        if len(values) == 1: return values[0].value
        return Value.Tuple(elements = values)

    # Decode one raw C value. A nullable pointer token becomes an ordinary
    # tagged optional. A bare handle still rejects null, while a bare cfunc may
    # retain it inertly until invocation or its next C input crossing.
    func decode_c_value(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        if self.is_extern_struct(value_type):
            return try self.transcode_extern_struct(function, value, value_type, slot, false)
        if types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            match value:
                Foreign(token):
                    if token == 0: error(self.null_foreign(function, slot))
                Bytes(raw):
                    let payload = list[u8]()
                    var terminated = false
                    for byte in raw:
                        if byte == u8(0):
                            terminated = true
                            break
                        payload.append(byte)
                    if not terminated: error(self.incompatible_c_result(function, slot, value_type))
                    let text = strings.from_bytes(payload) else error("interpreter: trap: invalid_utf8")
                    return Value.Text(value = text)
                else: pass
            error(self.incompatible_c_result(function, slot, value_type))
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                CFunction(identity):
                    match identity:
                        ForeignPointer(token):
                            if token == 0: return Value.Absent
                        Declared(symbol): pass
                    return Value.Present(value = BoxedValue(value = value))
                else: error(self.incompatible_c_result(function, slot, value_type))
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity): return value
                    else: error(self.incompatible_c_result(function, slot, value_type))
            else: pass

        return try self.decode_c_component(value, value_type, self.null_foreign(function, slot), self.incompatible_c_result(function, slot, value_type))

    func decode_c_argument(function: HirFunction, value: Value, value_type: TypeId, slot: str) -> Value!:
        let optional_cfunc = self.optional_c_function(value_type)
        if optional_cfunc != none:
            match value:
                CFunction(identity):
                    match identity:
                        ForeignPointer(token):
                            if token == 0: return Value.Absent
                        Declared(symbol): pass
                    return Value.Present(value = BoxedValue(value = value))
                else: error(self.incompatible_c_argument(function, slot, value_type))
        match self.program.types.definitions[value_type.value].form:
            CFunction(parameters, result):
                match value:
                    CFunction(identity):
                        match identity:
                            ForeignPointer(token):
                                if token == 0: error(self.null_foreign(function, slot))
                            Declared(symbol): pass
                        return value
                    else: error(self.incompatible_c_argument(function, slot, value_type))
            else: pass

        return try self.decode_c_component(value, value_type, self.null_foreign(function, slot), self.incompatible_c_argument(function, slot, value_type))

    # Shared scalar/handle boundary vocabulary for declarations, exports, and
    # raw cfunc invocation. Aggregate and cfunc-container shapes are handled
    # by their explicit callers before entering this closed component path.
    func encode_c_component(value: Value, value_type: TypeId, null_error: str) -> Value!:
        if self.optional_data_pointer(value_type) != none:
            match value:
                Absent: return Value.Foreign(token = 0)
                Present(item):
                    match item.value:
                        Foreign(token): return Value.Foreign(token = token)
                        else: trap("typed data-pointer optional contains a non-pointer value")
                else: trap("typed data-pointer optional has a non-optional value")
        if types_match(value_type, resolve_builtin_type(BuiltinType.foreign)):
            match value:
                Foreign(token):
                    if token == 0: error(null_error)
                    return value
                else: trap("typed foreign slot contains a non-pointer value")
        let extern_index = self.extern_type_index(value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer:
                            if token == 0: error(null_error)
                        Integer(representation):
                            if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation):
                                trap("typed integer handle is outside its declared representation")
                    return value
                else: trap("typed handle slot contains a non-handle value")
        if self.scalar_value_matches(value, value_type): return self.canonical_scalar_value(value, value_type)
        trap("typed C argument is incompatible with its HIR slot")

    func decode_c_component(value: Value, value_type: TypeId, null_error: str, incompatible: str) -> Value!:
        if self.optional_data_pointer(value_type) != none:
            match value:
                Foreign(token):
                    if token == 0: return Value.Absent
                    return Value.Present(value = BoxedValue(value = Value.Foreign(token = token)))
                else: error(incompatible)
        if types_match(value_type, resolve_builtin_type(BuiltinType.foreign)):
            match value:
                Foreign(token):
                    if token == 0: error(null_error)
                    return value
                else: error(incompatible)
        let extern_index = self.extern_type_index(value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer:
                            if token == 0: error(null_error)
                        Integer(representation):
                            if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation): error(incompatible)
                    return value
                else: error(incompatible)
        if self.scalar_value_matches(value, value_type): return self.canonical_scalar_value(value, value_type)
        error(incompatible)

    func canonical_scalar_value(value: Value, value_type: TypeId) -> Value:
        if is_floating_type(self.program.types, value_type):
            match value:
                Floating(item): return Value.Floating(value = normalize_float(item, value_type, self.program.types))
                else: trap("validated floating slot contains a non-floating value")
        return value

    func scalar_value_matches(value: Value, value_type: TypeId) -> bool:
        if types_match(value_type, resolve_builtin_type(BuiltinType.unit)):
            match value:
                Unit: return true
                else: return false
        if types_match(value_type, resolve_builtin_type(BuiltinType.boolean)):
            match value:
                Boolean(item): return true
                else: return false
        if is_integer_type(self.program.types, value_type):
            if is_unsigned_integer_type(self.program.types, value_type):
                match value:
                    UnsignedInteger(item): return item <= unsigned_integer_maximum(self.program.types, value_type)
                    else: return false
            match value:
                SignedInteger(item): return item >= integer_minimum(self.program.types, value_type) and item <= integer_maximum(self.program.types, value_type)
                else: return false
        if is_floating_type(self.program.types, value_type):
            match value:
                Floating(item): return true
                else: return false
        return false

    # External globals are not call slots: a zero pointer-shaped handle is a
    # valid stored token and is therefore checked only for nominal value shape.
    func require_external_variable_value(variable: HirExternVariable, value: Value) -> !:
        let extern_index = self.extern_type_index(variable.value_type)
        if extern_index >= 0:
            match value:
                Foreign(token):
                    match self.program.extern_types[extern_index].representation:
                        Pointer: return
                        Integer(representation):
                            if token >= integer_minimum(self.program.types, representation) and token <= integer_maximum(self.program.types, representation): return
                else: pass
            error("interpreter: extern variable `" + variable.name + "` has a value incompatible with `" + describe_type(self.program.types, variable.value_type) + "`")
        if self.scalar_value_matches(value, variable.value_type): return
        error("interpreter: extern variable `" + variable.name + "` has a value incompatible with `" + describe_type(self.program.types, variable.value_type) + "`")

    func extern_type_index(value_type: TypeId) -> i64:
        match self.program.types.definitions[value_type.value].form:
            Extern(index): return index
            else: return -1

    func is_extern_struct(value_type: TypeId) -> bool:
        match self.program.types.definitions[value_type.value].form:
            Struct(index, arguments): return self.program.structs[index].is_extern
            else: return false

    # The semantic oracle models packing as a fresh field-by-field record.
    # It has no target layout, but it enforces the same closed values and bare
    # out-field handle/cfunc rule as canonical MIR's explicit boundary copy.
    func transcode_extern_struct(function: HirFunction, value: Value, value_type: TypeId, slot: str, encoding: bool) -> Value!:
        let source_fields = list[BoxedValue]()
        match value:
            Record(fields):
                for field in fields: source_fields.append(field)
            else: error(self.incompatible_c_result(function, slot, value_type))
        let schema = nominal_fields(self.program, value_type)
        if len(source_fields) != len(schema): error(self.incompatible_c_result(function, slot, value_type))
        let copied = list[BoxedValue]()
        for index in range(0, len(schema)):
            let field = schema[index]
            let field_slot = slot + "." + field.name
            let item = source_fields[index].value
            if self.is_extern_struct(field.value_type):
                copied.append(BoxedValue(value = try self.transcode_extern_struct(function, item, field.value_type, field_slot, encoding)))
                continue
            match self.program.types.definitions[field.value_type.value].form:
                Foreign:
                    match item:
                        Foreign(token):
                            if encoding and token == 0: error(self.null_foreign(function, field_slot))
                        else: error(self.incompatible_c_result(function, field_slot, field.value_type))
                    copied.append(BoxedValue(value = item))
                    continue
                CFunction(parameters, result):
                    match item:
                        CFunction(identity):
                            match identity:
                                ForeignPointer(token):
                                    if encoding and token == 0: error(self.null_foreign(function, field_slot))
                                Declared(symbol): pass
                        else: error(self.incompatible_c_result(function, field_slot, field.value_type))
                    copied.append(BoxedValue(value = item))
                    continue
                else: pass
            let extern_index = self.extern_type_index(field.value_type)
            if extern_index >= 0:
                match item:
                    Foreign(token):
                        match self.program.extern_types[extern_index].representation:
                            Pointer:
                                if encoding and token == 0: error(self.null_foreign(function, field_slot))
                            Integer(representation):
                                if token < integer_minimum(self.program.types, representation) or token > integer_maximum(self.program.types, representation):
                                    error(self.incompatible_c_result(function, field_slot, field.value_type))
                    else: error(self.incompatible_c_result(function, field_slot, field.value_type))
                copied.append(BoxedValue(value = item))
                continue
            if not self.scalar_value_matches(item, field.value_type):
                error(self.incompatible_c_result(function, field_slot, field.value_type))
            copied.append(BoxedValue(value = self.canonical_scalar_value(item, field.value_type)))
        return Value.Record(fields = copied)

    func optional_data_pointer(value_type: TypeId) -> TypeId?:
        match self.program.types.definitions[value_type.value].form:
            Optional(inner):
                match self.program.types.definitions[inner.value].form:
                    Foreign: return inner
                    else: pass
                let index = self.extern_type_index(inner)
                if index < 0: return none
                match self.program.extern_types[index].representation:
                    Pointer: return inner
                    Integer(representation): return none
            else: return none

    func optional_c_function(value_type: TypeId) -> TypeId?:
        match self.program.types.definitions[value_type.value].form:
            Optional(inner):
                match self.program.types.definitions[inner.value].form:
                    CFunction(parameters, result): return inner
                    else: return none
            else: return none

    func incompatible_c_result(function: HirFunction, slot: str, value_type: TypeId) -> str:
        return "interpreter: extern `" + self.program.modules[function.module.value].name + "." + function.name + "` returned " + slot + " incompatible with `" + describe_type(self.program.types, value_type) + "`"

    func incompatible_c_argument(function: HirFunction, slot: str, value_type: TypeId) -> str:
        return "interpreter: C export `" + function.name + "` received " + slot + " incompatible with `" + describe_type(self.program.types, value_type) + "`"

    func null_foreign(function: HirFunction, slot: str) -> str:
        var label = "extern `" + self.program.modules[function.module.value].name + "." + function.name + "`"
        match function.implementation:
            ExportedC(body): label = "C export `" + function.name + "`"
            else: pass
        return "interpreter: null_foreign crossing " + label + " " + slot

    # A suite is one lexical scope: bindings made inside it are trimmed away
    # however the suite exits.
    func execute_scope(statements: Operands, bindings: list[Binding]) -> Execution!:
        let outer_count = len(bindings)
        let deferred = list[NodeId]()
        for position in range(0, i64(statements.count)):
            let statement = node_at(self.program, statements, position)
            match node_form(self.program, statement):
                DeferStatement(action):
                    deferred.append(action)
                    continue
                else: pass
            let result = try self.execute(statement, bindings)
            match result:
                Next: continue
                else:
                    try self.execute_deferred(deferred, bindings)
                    trim_bindings(bindings, outer_count)
                    return result
        try self.execute_deferred(deferred, bindings)
        trim_bindings(bindings, outer_count)
        return Execution.Next

    # Cleanup is LIFO. HirGenerator admits only unit-producing actions, so
    # any control transfer here means malformed HIR rather than source input.
    func execute_deferred(deferred: list[NodeId], bindings: list[Binding]) -> !:
        var index = len(deferred) - 1
        while index >= 0:
            match try self.execute(deferred[index], bindings):
                Next: pass
                else: trap("deferred action attempted control transfer")
            index -= 1

    # Execute one statement and report how it left.
    func execute(statement: NodeId, bindings: list[Binding]) -> Execution!:
        match node_form(self.program, statement):
            BreakStatement: return Execution.Broke
            ContinueStatement: return Execution.Continued
            Binding(symbol, is_mutable, value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): bindings.append(Binding(symbol = symbol, value = self.initial_binding(symbol, item)))
                    Transferred(execution): return execution
                return Execution.Next
            Assignment(symbol, operation, value):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed assignment refers to an unknown binding")
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: assigned = right
                    Combine(binary): assigned = try evaluate_binary(self.binding_value(bindings[index].value), binary, right, self.program.types)
                self.assign_binding(bindings, index, assigned)
                return Execution.Next
            ExternStore(variable_index, operation, value):
                let variable = self.program.extern_variables[variable_index]
                let host = self.external_variable_host else error("interpreter: extern variable `" + variable.name + "` has no host binding")
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: pass
                    Combine(binary):
                        let current = try host.load(variable)
                        try self.require_external_variable_value(variable, current)
                        assigned = try evaluate_binary(self.canonical_scalar_value(current, variable.value_type), binary, right, self.program.types)
                try self.require_external_variable_value(variable, assigned)
                try host.store(variable, self.canonical_scalar_value(assigned, variable.value_type))
                return Execution.Next
            GlobalStore(global_index, operation, value):
                let evaluated = try self.evaluate(value, bindings)
                var right = Value.Unit
                match evaluated:
                    Evaluated(item): right = item
                    Transferred(execution): return execution
                var assigned = right
                match operation:
                    Replace: pass
                    Combine(binary): assigned = try evaluate_binary(self.globals[global_index], binary, right, self.program.types)
                self.globals[global_index] = assigned
                return Execution.Next
            PlaceAssignment(symbol, step_run, operation, value):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("typed place assignment refers to an unknown binding")
                match try self.execute_place_update(self.binding_value(bindings[index].value), symbol, -1, step_run, operation, value, bindings):
                    Updated(updated):
                        self.assign_binding(bindings, index, updated)
                        return Execution.Next
                    Transferred(execution): return execution
            GlobalPlaceAssignment(global_index, step_run, operation, value):
                match try self.execute_place_update(self.globals[global_index], SymbolId(value = no_node), i64(global_index), step_run, operation, value, bindings):
                    Updated(updated):
                        self.globals[global_index] = updated
                        return Execution.Next
                    Transferred(execution): return execution
            PrintText(value):
                print(value)
                return Execution.Next
            PrintValue(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): print(text)
                            else: trap("typed `print` received a non-string HIR value")
                    Transferred(execution): return execution
                return Execution.Next
            ReturnStatement(value):
                if value.value == no_node: return Execution.Returned(value = Value.Unit)
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Returned(value = item)
                    Transferred(execution): return execution
            RecoverStatement(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Recovered(value = item)
                    Transferred(execution): return execution
            DeferStatement(action): trap("defer marker executed outside its lexical scope")
            ExpressionStatement(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Execution.Next
                    Transferred(execution): return execution
            IfStatement(branches, has_fallback, fallback):
                # Each branch is a triple: condition, body start, body count.
                for branch in range(0, i64(branches.count) // 3):
                    let condition = NodeId(value = u32(entry_at(self.program, branches, branch * 3)))
                    match try self.evaluate(condition, bindings):
                        Evaluated(item):
                            if as_boolean(item):
                                let body = Operands(start = u32(entry_at(self.program, branches, branch * 3 + 1)), count = u32(entry_at(self.program, branches, branch * 3 + 2)))
                                return try self.execute_scope(body, bindings)
                        Transferred(execution): return execution
                if has_fallback: return try self.execute_scope(fallback, bindings)
                return Execution.Next
            WhileStatement(condition, body):
                while true:
                    let evaluated = try self.evaluate(condition, bindings)
                    var keep_going = false
                    match evaluated:
                        Evaluated(item): keep_going = as_boolean(item)
                        Transferred(execution): return execution
                    if not keep_going: return Execution.Next
                    match try self.execute_scope(body, bindings):
                        Next: continue
                        Continued: continue
                        Broke: return Execution.Next
                        Returned(value): return Execution.Returned(value = value)
                        Raised(error_value): return Execution.Raised(error_value = error_value)
                        Recovered(value): return Execution.Recovered(value = value)
            ForStatement(symbol, iteration, body):
                return try self.execute_for(symbol, iteration, body, bindings)
            Match(subject, arms, has_result): return try self.execute_match(subject, arms, bindings)
            else: trap("expression node executed as a statement")

    # Resolve a complete target before the right-hand side, then rebuild its
    # local or runtime-global root through the same semantic path.
    func execute_place_update(root: Value, root_symbol: SymbolId, global_index: i64, step_run: Operands, operation: AssignmentOperation, value: NodeId, bindings: list[Binding]) -> PlaceUpdate!:
        let steps = list[AssignmentPlaceStep]()
        var current = root
        for position in range(0, i64(step_run.count) // 2):
            let kind = u32(entry_at(self.program, step_run, position * 2))
            let payload = entry_at(self.program, step_run, position * 2 + 1)
            if kind == place_field_step:
                steps.append(AssignmentPlaceStep.Field(index = payload))
                match current:
                    Record(fields): current = fields[payload].value
                    else: trap("field step applied to a non-struct HIR value")
            elif kind == place_class_field_step:
                steps.append(AssignmentPlaceStep.ClassField(index = payload))
                match current:
                    Class(storage): current = storage.fields[payload].value
                    else: trap("class-field step applied to a non-class HIR value")
            elif kind == place_weak_field_step:
                steps.append(AssignmentPlaceStep.WeakField(index = payload))
                match current:
                    Class(storage):
                        match storage.fields[payload].value:
                            WeakClass(slot): current = weak_class_value(slot)
                            else: trap("weak class field has owning storage")
                    else: trap("weak-field step applied to a non-class HIR value")
            elif kind == place_element_step:
                match try self.evaluate(NodeId(value = u32(payload)), bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(element_index):
                                match current:
                                    Array(elements):
                                        if element_index >= u64(len(elements)): error("interpreter: index out of bounds")
                                        steps.append(AssignmentPlaceStep.Element(index = i64(element_index)))
                                        current = elements[element_index].value
                                    else: trap("element step applied to a non-array HIR value")
                            else: trap("typed place index is not an integer")
                    Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
            elif kind == place_list_element_step:
                match try self.evaluate(NodeId(value = u32(payload)), bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(element_index):
                                match current:
                                    List(storage):
                                        if element_index >= u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                        steps.append(AssignmentPlaceStep.ListElement(index = i64(element_index)))
                                        current = storage.buffer.elements[element_index].value
                                    else: trap("list element step applied to a non-list HIR value")
                            else: trap("typed place index is not an integer")
                    Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
            elif kind == place_map_element_step:
                match try self.evaluate(NodeId(value = u32(payload)), bindings):
                    Evaluated(key):
                        steps.append(AssignmentPlaceStep.MapElement(key = BoxedValue(value = key)))
                        match current:
                            Map(storage):
                                let entry = try find_hash_entry(storage, key)
                                if entry >= 0: current = storage.entries[entry].value.value
                                else: current = Value.Unit
                            else: trap("map element step applied to a non-map HIR value")
                    Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
            else: trap("typed place assignment has an unknown step")

        var right = Value.Unit
        match try self.evaluate(value, bindings):
            Evaluated(item): right = item
            Transferred(execution): return PlaceUpdate.Transferred(execution = execution)
        # `current` retains the traversal value, which may contain boxed
        # container members. Reload the authoritative root after RHS effects
        # instead of attempting to reuse that traversal value.
        var latest_root = Value.Unit
        if global_index >= 0:
            latest_root = self.globals[global_index]
        else:
            let binding_index = find_binding(bindings, root_symbol)
            if binding_index < 0: trap("typed place assignment lost its root binding")
            latest_root = self.binding_value(bindings[binding_index].value)
        var assigned = right
        match operation:
            Replace: pass
            # The right-hand side may itself mutate the root; read the selected
            # value afterward while retaining the already-resolved indices.
            Combine(binary): assigned = try evaluate_binary(try value_at_assignment_place(latest_root, steps, 0), binary, right, self.program.types)
        return PlaceUpdate.Updated(value = try value_with_assignment_place(latest_root, steps, 0, assigned))

    # Execute either a compiler-known sequence or the resolved standard
    # protocol. Protocol setup runs once; its private mutable iterator remains
    # live across calls while the source element binding is per-iteration.
    func execute_for(symbol: SymbolId, iteration: HirIteration, body: Operands, bindings: list[Binding]) -> Execution!:
        match iteration:
            Builtin(iterable): return try self.execute_builtin_for(symbol, iterable, body, bindings)
            Protocol(iterator_symbol, iterator, next):
                return try self.execute_protocol_for(symbol, iterator_symbol, iterator, next, body, bindings)

    func execute_builtin_for(symbol: SymbolId, iterable: NodeId, body: Operands, bindings: list[Binding]) -> Execution!:
        let evaluated = try self.evaluate(iterable, bindings)
        var value = Value.Unit
        match evaluated:
            Evaluated(item): value = item
            Transferred(execution): return execution
        match self.program.types.definitions[node_type(self.program, iterable).value].form:
            Range(element): return try self.execute_range_for(symbol, value, element, body, bindings)
            List(element): return try self.execute_list_for(symbol, value, body, bindings)
            Map(key, element): return try self.execute_hash_for(symbol, value, true, body, bindings)
            Set(element): return try self.execute_hash_for(symbol, value, false, body, bindings)
            String: return try self.execute_string_for(symbol, value, body, bindings)
            else: trap("typed `for` received a non-iterable value")

    func execute_protocol_for(symbol: SymbolId, iterator_symbol: SymbolId, iterator: NodeId, next: NodeId, body: Operands, bindings: list[Binding]) -> Execution!:
        let outer_count = len(bindings)
        match try self.evaluate(iterator, bindings):
            Evaluated(value): bindings.append(Binding(symbol = iterator_symbol, value = value))
            Transferred(execution): return execution
        while true:
            let evaluated = self.evaluate(next, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                error(reason)
            var element: Value? = none
            match evaluated:
                Evaluated(value):
                    match value:
                        Absent:
                            trim_bindings(bindings, outer_count)
                            return Execution.Next
                        Present(item): element = item.value
                        else: trap("typed protocol iterator returned a non-optional value")
                Transferred(execution):
                    trim_bindings(bindings, outer_count)
                    return execution
            let item = element else trap("present iterator result lost its element")
            let iteration_count = len(bindings)
            bindings.append(Binding(symbol = symbol, value = item))
            let outcome = self.execute_scope(body, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                error(reason)
            trim_bindings(bindings, iteration_count)
            match outcome:
                Broke:
                    trim_bindings(bindings, outer_count)
                    return Execution.Next
                Returned(value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Returned(value = value)
                Raised(error_value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Raised(error_value = error_value)
                Recovered(value):
                    trim_bindings(bindings, outer_count)
                    return Execution.Recovered(value = value)
                else: pass

    func execute_string_for(symbol: SymbolId, iterated: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        var text = ""
        match iterated:
            Text(value): text = value
            else: trap("typed string iteration received a non-string value")
        let outer_count = len(bindings)
        for character in text:
            bindings.append(Binding(symbol = symbol, value = Value.Character(value = character)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke: return Execution.Next
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
        return Execution.Next

    func execute_range_for(symbol: SymbolId, ranged: Value, element_type: TypeId, body: Operands, bindings: list[Binding]) -> Execution!:
        if is_unsigned_integer_type(self.program.types, element_type):
            return try self.execute_unsigned_range_for(symbol, ranged, body, bindings)
        var lower = 0
        var upper = 0
        var inclusive = false
        match ranged:
            Record(fields):
                if len(fields) != 3: trap("typed range has the wrong field count")
                match fields[0].value:
                    SignedInteger(value): lower = value
                    else: trap("typed range lower bound is not an integer")
                match fields[1].value:
                    SignedInteger(value): upper = value
                    else: trap("typed range upper bound is not an integer")
                match fields[2].value:
                    Boolean(value): inclusive = value
                    else: trap("typed range boundary flag is not boolean")
            else: trap("typed range iteration received a non-range value")
        let outer_count = len(bindings)
        var current = lower
        while current < upper or (inclusive and current == upper):
            bindings.append(Binding(symbol = symbol, value = Value.SignedInteger(value = current)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke: return Execution.Next
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
            # Do not overflow when a closed range ends at the type's maximum;
            # the endpoint has already been delivered.
            if inclusive and current == upper: return Execution.Next
            match try checked_integer_result(try checked_add(current, 1), element_type, self.program.types):
                SignedInteger(value): current = value
                else: trap("range increment produced a non-integer")
        return Execution.Next

    func execute_unsigned_range_for(symbol: SymbolId, ranged: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        var lower = u64(0)
        var upper = u64(0)
        var inclusive = false
        match ranged:
            Record(fields):
                if len(fields) != 3: trap("typed range has the wrong field count")
                match fields[0].value:
                    UnsignedInteger(value): lower = value
                    else: trap("typed unsigned range lower bound is not an integer")
                match fields[1].value:
                    UnsignedInteger(value): upper = value
                    else: trap("typed unsigned range upper bound is not an integer")
                match fields[2].value:
                    Boolean(value): inclusive = value
                    else: trap("typed range boundary flag is not boolean")
            else: trap("typed range iteration received a non-range value")
        let outer_count = len(bindings)
        var current = lower
        while current < upper or (inclusive and current == upper):
            bindings.append(Binding(symbol = symbol, value = Value.UnsignedInteger(value = current)))
            let outcome = try self.execute_scope(body, bindings)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke: return Execution.Next
                Returned(value): return Execution.Returned(value = value)
                Raised(error_value): return Execution.Raised(error_value = error_value)
                Recovered(value): return Execution.Recovered(value = value)
                else: pass
            if inclusive and current == upper: return Execution.Next
            if current == u64(18446744073709551615): error("interpreter: integer arithmetic overflow")
            current += u64(1)
        return Execution.Next

    func execute_list_for(symbol: SymbolId, iterated: Value, body: Operands, bindings: list[Binding]) -> Execution!:
        let storage = require_list_storage(iterated)
        storage.active_iterations += 1
        let outer_count = len(bindings)
        let length = len(storage.buffer.elements)
        var index = 0
        while index < length:
            bindings.append(Binding(symbol = symbol, value = storage.buffer.elements[index].value))
            let outcome = self.execute_scope(body, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                storage.active_iterations -= 1
                error(reason)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke: return self.finish_list_iteration(storage, Execution.Next)
                Returned(value): return self.finish_list_iteration(storage, Execution.Returned(value = value))
                Raised(error_value): return self.finish_list_iteration(storage, Execution.Raised(error_value = error_value))
                Recovered(value): return self.finish_list_iteration(storage, Execution.Recovered(value = value))
                else: pass
            index += 1
        return self.finish_list_iteration(storage, Execution.Next)

    func finish_list_iteration(storage: ListStorage, outcome: Execution) -> Execution:
        storage.active_iterations -= 1
        return outcome

    func execute_hash_for(symbol: SymbolId, iterated: Value, is_map: bool, body: Operands, bindings: list[Binding]) -> Execution!:
        var storage: HashStorage? = none
        match iterated:
            Map(value):
                if is_map: storage = value
            Set(value):
                if not is_map: storage = value
            else: pass
        let collection = storage else trap("typed hash-collection iteration received the wrong value")
        collection.active_iterations += 1
        let outer_count = len(bindings)
        let length = len(collection.entries)
        for index in range(0, length):
            bindings.append(Binding(symbol = symbol, value = collection.entries[index].key.value))
            let outcome = self.execute_scope(body, bindings) catch reason:
                trim_bindings(bindings, outer_count)
                collection.active_iterations -= 1
                error(reason)
            trim_bindings(bindings, outer_count)
            match outcome:
                Broke: return self.finish_hash_iteration(collection, Execution.Next)
                Returned(value): return self.finish_hash_iteration(collection, Execution.Returned(value = value))
                Raised(error_value): return self.finish_hash_iteration(collection, Execution.Raised(error_value = error_value))
                Recovered(value): return self.finish_hash_iteration(collection, Execution.Recovered(value = value))
                else: pass
        return self.finish_hash_iteration(collection, Execution.Next)

    func finish_hash_iteration(storage: HashStorage, outcome: Execution) -> Execution:
        storage.active_iterations -= 1
        return outcome

    func execute_match(subject: NodeId, arms: Operands, bindings: list[Binding]) -> Execution!:
        let evaluated = try self.evaluate(subject, bindings)
        var selected = Value.Unit
        match evaluated:
            Evaluated(item): selected = item
            Transferred(execution): return execution
        let outer_count = len(bindings)
        for position in range(0, i64(arms.count)):
            let arm = node_at(self.program, arms, position)
            match node_form(self.program, arm):
                MatchArm(patterns, statements, value):
                    if try self.arm_matches(patterns, selected, bindings):
                        let outcome = try self.execute_scope(statements, bindings)
                        trim_bindings(bindings, outer_count)
                        return outcome
                else: trap("match arm run names a non-arm node")
        trap("checked `match` selected no arm")

    # mark: Expressions =========================================================================

    # Evaluate one expression to its value.
    func evaluate(expression: NodeId, bindings: list[Binding]) -> Evaluation!:
        match node_form(self.program, expression):
            Constant(value): return Evaluation.Evaluated(value = self.program.values[value])
            Reference(symbol):
                let index = find_binding(bindings, symbol)
                if index >= 0: return Evaluation.Evaluated(value = self.binding_value(bindings[index].value))
                for constant in self.program.constants:
                    if constant.symbol.value == symbol.value:
                        # Initializers are literal trees; re-evaluating is lookup.
                        return try self.evaluate(constant.value, list[Binding]())
                trap("typed reference points outside its call frame")
            ExternLoad(variable_index):
                let variable = self.program.extern_variables[variable_index]
                let host = self.external_variable_host else error("interpreter: extern variable `" + variable.name + "` has no host binding")
                let value = try host.load(variable)
                try self.require_external_variable_value(variable, value)
                return Evaluation.Evaluated(value = self.canonical_scalar_value(value, variable.value_type))
            GlobalLoad(global_index): return Evaluation.Evaluated(value = self.globals[global_index])
            Discard(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Unit)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            NeverCoercion(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): trap("a `never` coercion completed normally")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            DivergingSequence(values):
                for position in range(0, i64(values.count)):
                    match try self.evaluate(node_at(self.program, values, position), bindings):
                        Evaluated(item): pass
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                trap("a diverging evaluation prefix completed normally")
            NumericConvert(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        let destination = node_type(self.program, expression)
                        return Evaluation.Evaluated(value = try convert_numeric_value(item, destination, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            StringScalarCount(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(text))))
                            else: trap("typed scalar count has a non-string value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            BuiltinDisplay(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Text(value = display_builtin(item, node_type(self.program, value), self.program.types)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            FormattedString(parts):
                let output_bytes = list[u8]()
                for position in range(0, i64(parts.count)):
                    match try self.evaluate(node_at(self.program, parts, position), bindings):
                        Evaluated(item):
                            match item:
                                Text(text):
                                    for byte in strings.to_bytes(text): output_bytes.append(byte)
                                else: trap("typed formatted string contains a non-string piece")
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                let text = strings.from_bytes(output_bytes) else trap("formatted string pieces produced invalid UTF-8")
                return Evaluation.Evaluated(value = Value.Text(value = text))
            Hash(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = structural_hash(item)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            SequenceLength(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Bytes(payload): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(payload))))
                            Text(text): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(strings.to_bytes(text)))))
                            Array(elements): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(elements))))
                            List(storage): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(storage.buffer.elements))))
                            Map(storage): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(storage.entries))))
                            Set(storage): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(len(storage.entries))))
                            Slice(storage): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(storage.length)))
                            else: trap("typed sequence length has a non-sequence value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            SequenceIndex(value, index):
                let sequence = try self.evaluate(value, bindings)
                var sequence_value = Value.Unit
                match sequence:
                    Evaluated(item): sequence_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(index, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(position):
                                match sequence_value:
                                    Bytes(payload):
                                        if position >= u64(len(payload)): error("interpreter: index out of bounds")
                                        return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(payload[position])))
                                    Array(elements):
                                        if position >= u64(len(elements)): error("interpreter: index out of bounds")
                                        return Evaluation.Evaluated(value = elements[position].value)
                                    List(storage):
                                        if position >= u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                        return Evaluation.Evaluated(value = storage.buffer.elements[position].value)
                                    Slice(storage):
                                        if position >= u64(storage.length): error("interpreter: index out of bounds")
                                        match storage.backing:
                                            List(buffer): return Evaluation.Evaluated(value = buffer.elements[storage.start + i64(position)].value)
                                            Bytes(payload): return Evaluation.Evaluated(value = Value.UnsignedInteger(value = u64(payload[storage.start + i64(position)])))
                                    else: trap("typed sequence index has a non-sequence value")
                            else: trap("typed sequence index has a non-integer index")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Unary(operation, operand):
                match try self.evaluate(operand, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = try evaluate_unary(operation, item, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Binary(left, operation, right):
                let left_evaluation = try self.evaluate(left, bindings)
                var left_value = Value.Unit
                match left_evaluation:
                    Evaluated(item): left_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                # `and` and `or` short-circuit: the right side must not run
                # when the left side already decides the answer.
                match operation:
                    LogicalAnd:
                        if not as_boolean(left_value): return Evaluation.Evaluated(value = Value.Boolean(value = false))
                    LogicalOr:
                        if as_boolean(left_value): return Evaluation.Evaluated(value = Value.Boolean(value = true))
                    else: pass
                match try self.evaluate(right, bindings):
                    Evaluated(item):
                        match operation:
                            LogicalAnd, LogicalOr: return Evaluation.Evaluated(value = Value.Boolean(value = as_boolean(item)))
                            else: return Evaluation.Evaluated(value = try evaluate_binary(left_value, operation, item, self.program.types))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Conditional(value, condition, alternative):
                match try self.evaluate(condition, bindings):
                    Evaluated(item):
                        if as_boolean(item): return try self.evaluate(value, bindings)
                        return try self.evaluate(alternative, bindings)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Range(lower, upper, inclusive):
                let low = try self.evaluate(lower, bindings)
                var low_value = Value.Unit
                match low:
                    Evaluated(item): low_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                let high = try self.evaluate(upper, bindings)
                match high:
                    Evaluated(item):
                        return Evaluation.Evaluated(value = Value.Record(fields = [
                            BoxedValue(value = low_value),
                            BoxedValue(value = item),
                            BoxedValue(value = Value.Boolean(value = inclusive)),
                        ]))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Call(function, arguments): return try self.evaluate_call(function, arguments, bindings)
            InterfaceValue(value, conformance):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Interface(storage = InterfaceStorage(conformance, item)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            InterfaceCall(receiver, interface_type, requirement, arguments):
                return try self.evaluate_interface_call(receiver, interface_type, requirement, arguments, bindings)
            FunctionAddress(function):
                match self.program.types.definitions[node_type(self.program, expression).value].form:
                    CFunction(parameters, result): return Evaluation.Evaluated(value = Value.CFunction(identity = HirCFunctionIdentity.Declared(symbol = function)))
                    else: return Evaluation.Evaluated(value = Value.Function(symbol = function))
            ClosureValue(closure, initializers):
                let capture_table = self.program.closures[closure].captures
                if initializers.count != u32(len(capture_table)): trap("closure initializer run does not match its capture table")
                let captures = list[BoxedValue]()
                for position in range(0, len(capture_table)):
                    let capture = capture_table[position]
                    if capture.kind == HirCaptureKind.shared_cell:
                        let source = capture.source else trap("shared-cell capture has no source binding")
                        let binding_index = find_binding(bindings, source)
                        if binding_index < 0: trap("shared-cell capture refers outside its call frame")
                        match bindings[binding_index].value:
                            CapturedCell(storage): captures.append(BoxedValue(value = Value.CapturedCell(storage = storage)))
                            else: trap("shared-cell capture source was not promoted")
                        continue
                    let initializer = node_at(self.program, initializers, position)
                    match try self.evaluate(initializer, bindings):
                        Evaluated(item):
                            if capture.kind == HirCaptureKind.weak_capture:
                                match item:
                                    Class(storage): captures.append(BoxedValue(value = Value.WeakClass(storage = WeakClassStorage(target = storage))))
                                    else: trap("weak closure capture initializer is not a class value")
                            else:
                                captures.append(BoxedValue(value = item))
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                return Evaluation.Evaluated(value = Value.Closure(storage = ClosureStorage(closure = closure, captures = captures)))
            WeakCaptureReference(symbol):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("weak capture reference points outside its call frame")
                match bindings[index].value:
                    WeakClass(storage): return Evaluation.Evaluated(value = weak_class_value(storage))
                    else: trap("weak capture reference names owning storage")
            IndirectCall(callee, arguments): return try self.evaluate_indirect_call(callee, arguments, bindings)
            Initialize(function, arguments): return try self.evaluate_initializer(function, arguments, bindings)
            ErrorCodeLiteral(value):
                return Evaluation.Evaluated(value = Value.Record(fields = [
                    BoxedValue(value = Value.Text(value = self.program.package_identity)),
                    BoxedValue(value = Value.UnsignedInteger(value = u64(value))),
                ]))
            Raise(code, message):
                let code_evaluation = try self.evaluate(code, bindings)
                var code_value = Value.Unit
                match code_evaluation:
                    Evaluated(item): code_value = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        let error_value = Value.Record(fields = [BoxedValue(value = code_value), BoxedValue(value = item)])
                        return Evaluation.Transferred(execution = Execution.Raised(error_value = error_value))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Trap(message):
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        match item:
                            Text(text): error("interpreter: trap: " + text)
                            else: trap("typed `trap` received a non-string HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Assert(condition, message):
                let checked = try self.evaluate(condition, bindings)
                var passed = false
                match checked:
                    Evaluated(item): passed = as_boolean(item)
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(message, bindings):
                    Evaluated(item):
                        match item:
                            Text(text):
                                if not passed: error("interpreter: trap: " + text)
                                return Evaluation.Evaluated(value = Value.Unit)
                            else: trap("typed `assert` received a non-string HIR message")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Try(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            FallibleSuccess(success): return Evaluation.Evaluated(value = success.value)
                            FallibleFailure(error_value): return Evaluation.Transferred(execution = Execution.Raised(error_value = error_value.value))
                            else: trap("typed `try` received a non-fallible HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Catch(value, failure, body): return try self.evaluate_catch(value, failure, body, bindings)
            StructValue(struct_index, fields):
                let field_count = len(nominal_fields(self.program, node_type(self.program, expression)))
                match try self.evaluate_placed_run(fields, field_count, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Record(fields = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            FieldAccess(record, field):
                match try self.evaluate(record, bindings):
                    Evaluated(item):
                        match item:
                            Record(fields): return Evaluation.Evaluated(value = fields[field].value)
                            Class(storage):
                                let stored = storage.fields[field].value
                                if nominal_fields(self.program, storage.class_type)[field].is_weak:
                                    match stored:
                                        WeakClass(slot): return Evaluation.Evaluated(value = weak_class_value(slot))
                                        else: trap("weak class field has owning storage")
                                return Evaluation.Evaluated(value = stored)
                            else: trap("field access applied to a non-record HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Tuple(elements):
                match try self.evaluate_run(elements, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Tuple(elements = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            Array(elements):
                match try self.evaluate_run(elements, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Array(elements = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            List(elements):
                # Allocate the identity before evaluating its elements, then
                # append each one immediately. This matches canonical MIR and
                # fixes allocation/trap order without weakening left-to-right
                # element evaluation.
                let storage = ListStorage(list[BoxedValue]())
                for position in range(0, i64(elements.count)):
                    match try self.evaluate(node_at(self.program, elements, position), bindings):
                        Evaluated(item): storage.buffer.elements.append(BoxedValue(value = item))
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                return Evaluation.Evaluated(value = Value.List(storage = storage))
            Map(entries):
                let storage = HashStorage(list[HashEntry]())
                for position in range(0, i64(entries.count) // 2):
                    var key = Value.Unit
                    match try self.evaluate(node_at(self.program, entries, position * 2), bindings):
                        Evaluated(item): key = item
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                    match try self.evaluate(node_at(self.program, entries, position * 2 + 1), bindings):
                        Evaluated(item):
                            let selected = try find_hash_entry(storage, key)
                            if selected >= 0:
                                storage.entries[selected].value = BoxedValue(value = item)
                            else:
                                storage.entries.append(HashEntry(key = BoxedValue(value = key), value = BoxedValue(value = item)))
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                return Evaluation.Evaluated(value = Value.Map(storage = storage))
            Set(elements):
                let storage = HashStorage(list[HashEntry]())
                for position in range(0, i64(elements.count)):
                    match try self.evaluate(node_at(self.program, elements, position), bindings):
                        Evaluated(item):
                            if try find_hash_entry(storage, item) < 0:
                                storage.entries.append(HashEntry(key = BoxedValue(value = item), value = BoxedValue(value = Value.Unit)))
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                return Evaluation.Evaluated(value = Value.Set(storage = storage))
            ListCopy(value):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage):
                        let elements = list[BoxedValue]()
                        for element in storage.buffer.elements: elements.append(element)
                        return Evaluation.Evaluated(value = Value.List(storage = ListStorage(elements)))
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
            WeakCreate(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Class(storage): return Evaluation.Evaluated(value = Value.WeakClass(storage = WeakClassStorage(storage)))
                            else: trap("typed `Weak` construction received a non-class HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            WeakGet(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            WeakClass(storage): return Evaluation.Evaluated(value = weak_class_value(storage))
                            else: trap("typed `Weak.get` received a non-weak HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            SequenceSlice(value, start, end): return try self.evaluate_sequence_slice(value, start, end, bindings)
            ListAppend(value, element):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage):
                        match try self.evaluate(element, bindings):
                            Evaluated(item):
                                try require_list_shape_mutable(storage)
                                detach_list(storage)
                                storage.buffer.elements.append(BoxedValue(value = item))
                                return Evaluation.Evaluated(value = Value.Unit)
                            Transferred(execution): return Evaluation.Transferred(execution = execution)
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
            ListInsert(value, index, element):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage):
                        match try self.evaluate(index, bindings):
                            Evaluated(index_value):
                                match index_value:
                                    UnsignedInteger(position):
                                        match try self.evaluate(element, bindings):
                                            Evaluated(item):
                                                if position > u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                                let position_index = i64(position)
                                                try require_list_shape_mutable(storage)
                                                detach_list(storage)
                                                let rebuilt = list[BoxedValue]()
                                                for current in range(0, len(storage.buffer.elements) + 1):
                                                    if current == position_index: rebuilt.append(BoxedValue(value = item))
                                                    else:
                                                        var old = current
                                                        if current > position_index: old -= 1
                                                        rebuilt.append(storage.buffer.elements[old])
                                                storage.buffer.elements = rebuilt
                                                return Evaluation.Evaluated(value = Value.Unit)
                                            Transferred(execution): return Evaluation.Transferred(execution = execution)
                                    else: trap("typed list insert index is not an integer")
                            Transferred(execution): return Evaluation.Transferred(execution = execution)
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
            ListRemoveAt(value, index):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage):
                        match try self.evaluate(index, bindings):
                            Evaluated(index_value):
                                match index_value:
                                    UnsignedInteger(position):
                                        if position >= u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                        let position_index = i64(position)
                                        try require_list_shape_mutable(storage)
                                        let removed = storage.buffer.elements[position_index].value
                                        detach_list(storage)
                                        let rebuilt = list[BoxedValue]()
                                        for current in range(0, len(storage.buffer.elements)):
                                            if current != position_index: rebuilt.append(storage.buffer.elements[current])
                                        storage.buffer.elements = rebuilt
                                        return Evaluation.Evaluated(value = removed)
                                    else: trap("typed list removal index is not an integer")
                            Transferred(execution): return Evaluation.Transferred(execution = execution)
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
            ListClear(value):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage):
                        try require_list_shape_mutable(storage)
                        storage.buffer = ListBuffer(list[BoxedValue]())
                        storage.has_snapshot = false
                        return Evaluation.Evaluated(value = Value.Unit)
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
            ListReserve(value, minimum_capacity):
                match try self.evaluate_list(value, bindings):
                    EvaluatedList(storage): pass
                    TransferredList(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(minimum_capacity, bindings):
                    Evaluated(item):
                        match item:
                            UnsignedInteger(minimum): return Evaluation.Evaluated(value = Value.Unit)
                            else: trap("typed list reserve capacity is not an integer")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            MapLookup(value, key):
                let receiver = try self.evaluate(value, bindings)
                var storage: HashStorage? = none
                match receiver:
                    Evaluated(item):
                        match item:
                            Map(found): storage = found
                            else: trap("typed map lookup has a non-map receiver")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
                match try self.evaluate(key, bindings):
                    Evaluated(item):
                        let found = storage else trap("map lookup lost its storage")
                        let selected = try find_hash_entry(found, item)
                        if selected < 0: return Evaluation.Evaluated(value = Value.Absent)
                        return Evaluation.Evaluated(value = Value.Present(value = found.entries[selected].value))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            MapCopy(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Map(storage):
                                let entries = list[HashEntry]()
                                for entry in storage.entries: entries.append(HashEntry(key = entry.key, value = entry.value))
                                return Evaluation.Evaluated(value = Value.Map(storage = HashStorage(entries)))
                            else: trap("typed map copy has a non-map receiver")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            MapRemove(value, key): return try self.evaluate_map_remove(value, key, bindings)
            MapClear(value): return try self.evaluate_hash_clear(value, true, bindings)
            MapReserve(value, minimum_capacity): return try self.evaluate_hash_reserve(value, true, minimum_capacity, bindings)
            SetContains(value, element): return try self.evaluate_set_membership(value, element, 0, bindings)
            SetInsert(value, element): return try self.evaluate_set_membership(value, element, 1, bindings)
            SetRemove(value, element): return try self.evaluate_set_membership(value, element, 2, bindings)
            SetClear(value): return try self.evaluate_hash_clear(value, false, bindings)
            SetReserve(value, minimum_capacity): return try self.evaluate_hash_reserve(value, false, minimum_capacity, bindings)
            SetCopy(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Set(storage):
                                let entries = list[HashEntry]()
                                for entry in storage.entries: entries.append(HashEntry(key = entry.key, value = entry.value))
                                return Evaluation.Evaluated(value = Value.Set(storage = HashStorage(entries)))
                            else: trap("typed set copy has a non-set receiver")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            Element(value, index):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Tuple(elements):
                                if index < 0 or index >= len(elements): trap("tuple element index is out of range")
                                return Evaluation.Evaluated(value = elements[index].value)
                            else: trap("tuple element applied to a non-tuple HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            NoneLiteral: return Evaluation.Evaluated(value = Value.Absent)
            Some(value):
                match try self.evaluate(value, bindings):
                    Evaluated(item): return Evaluation.Evaluated(value = Value.Present(value = BoxedValue(value = item)))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            ElseFallback(value, arm):
                match try self.evaluate(value, bindings):
                    Evaluated(item):
                        match item:
                            Absent: return try self.evaluate(arm, bindings)
                            Present(present): return Evaluation.Evaluated(value = present.value)
                            else: trap("`else` applied to a non-optional HIR value")
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            EnumValue(enum_index, case_index, payload):
                let field_count = len(nominal_cases(self.program, node_type(self.program, expression))[case_index].payload)
                match try self.evaluate_placed_run(payload, field_count, bindings):
                    EvaluatedRun(items): return Evaluation.Evaluated(value = Value.Variant(case_index = case_index, payload = items))
                    TransferredRun(execution): return Evaluation.Transferred(execution = execution)
            Match(subject, arms, has_result): return try self.evaluate_match(subject, arms, bindings)
            else: trap("statement node evaluated as an expression")

    # The recursive walkers are kept small on purpose: the oracle recurses
    # once per interpreted call, and every local of `evaluate` is host stack
    # for the whole depth. Each heavy arm lives in its own function.
    func evaluate_run(run: Operands, bindings: list[Binding]) -> RunEvaluation!:
        let items = list[BoxedValue]()
        for position in range(0, i64(run.count)):
            match try self.evaluate(node_at(self.program, run, position), bindings):
                Evaluated(item): items.append(BoxedValue(value = item))
                Transferred(execution): return RunEvaluation.TransferredRun(execution = execution)
        return RunEvaluation.EvaluatedRun(values = items)

    ## Evaluate placed aggregate children in source order, then publish their
    ## semantic value in declaration order. Layout is not part of this oracle.
    func evaluate_placed_run(run: Operands, field_count: i64, bindings: list[Binding]) -> RunEvaluation!:
        let items = list[BoxedValue]()
        for index in range(0, field_count): items.append(BoxedValue(value = Value.Unit))
        for pair in range(0, i64(run.count) // 2):
            let field_index = entry_at(self.program, run, pair * 2)
            let child = NodeId(value = u32(entry_at(self.program, run, pair * 2 + 1)))
            match try self.evaluate(child, bindings):
                Evaluated(item): items[field_index] = BoxedValue(value = item)
                Transferred(execution): return RunEvaluation.TransferredRun(execution = execution)
        return RunEvaluation.EvaluatedRun(values = items)

    # Centralize the trusted typed-list assertion while preserving a receiver
    # expression's control transfer for every list operation.
    func evaluate_list(value: NodeId, bindings: list[Binding]) -> ListEvaluation!:
        match try self.evaluate(value, bindings):
            Evaluated(item):
                match item:
                    List(storage): return ListEvaluation.EvaluatedList(storage = storage)
                    else: trap("typed list operation has a non-list receiver")
            Transferred(execution): return ListEvaluation.TransferredList(execution = execution)

    func evaluate_hash(value: NodeId, is_map: bool, bindings: list[Binding]) -> HashEvaluation!:
        match try self.evaluate(value, bindings):
            Evaluated(item):
                match item:
                    Map(storage):
                        if is_map: return HashEvaluation.EvaluatedHash(storage = storage)
                    Set(storage):
                        if not is_map: return HashEvaluation.EvaluatedHash(storage = storage)
                    else: pass
                trap("typed hash-collection operation has the wrong receiver")
            Transferred(execution): return HashEvaluation.TransferredHash(execution = execution)

    func evaluate_map_remove(value: NodeId, key: NodeId, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate_hash(value, true, bindings):
            EvaluatedHash(storage):
                match try self.evaluate(key, bindings):
                    Evaluated(item):
                        let selected = try find_hash_entry(storage, item)
                        if selected < 0: return Evaluation.Evaluated(value = Value.Absent)
                        try require_hash_shape_mutable(storage, "map")
                        let removed = storage.entries[selected].value
                        let rebuilt = list[HashEntry]()
                        for index in range(0, len(storage.entries)):
                            if index != selected: rebuilt.append(storage.entries[index])
                        while len(storage.entries) > 0: storage.entries.remove(len(storage.entries) - 1)
                        for entry in rebuilt: storage.entries.append(entry)
                        return Evaluation.Evaluated(value = Value.Present(value = removed))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            TransferredHash(execution): return Evaluation.Transferred(execution = execution)

    func evaluate_hash_clear(value: NodeId, is_map: bool, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate_hash(value, is_map, bindings):
            EvaluatedHash(storage):
                var kind = "set"
                if is_map: kind = "map"
                try require_hash_shape_mutable(storage, kind)
                while len(storage.entries) > 0: storage.entries.remove(len(storage.entries) - 1)
                return Evaluation.Evaluated(value = Value.Unit)
            TransferredHash(execution): return Evaluation.Transferred(execution = execution)

    func evaluate_hash_reserve(value: NodeId, is_map: bool, minimum_capacity: NodeId, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate_hash(value, is_map, bindings):
            EvaluatedHash(storage): pass
            TransferredHash(execution): return Evaluation.Transferred(execution = execution)
        match try self.evaluate(minimum_capacity, bindings):
            Evaluated(item):
                match item:
                    UnsignedInteger(minimum): return Evaluation.Evaluated(value = Value.Unit)
                    else: trap("typed hash-collection reserve capacity is not an integer")
            Transferred(execution): return Evaluation.Transferred(execution = execution)

    # Operation 0 is contains, 1 insert, and 2 remove. The compact internal
    # tag keeps the shared semantic transaction in one place without leaking
    # a source-level enum or duplicating receiver/operand evaluation.
    func evaluate_set_membership(value: NodeId, element: NodeId, operation: i64, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate_hash(value, false, bindings):
            EvaluatedHash(storage):
                match try self.evaluate(element, bindings):
                    Evaluated(item):
                        let selected = try find_hash_entry(storage, item)
                        if operation == 0: return Evaluation.Evaluated(value = Value.Boolean(value = selected >= 0))
                        if operation == 1:
                            if selected >= 0: return Evaluation.Evaluated(value = Value.Boolean(value = false))
                            try require_hash_shape_mutable(storage, "set")
                            storage.entries.append(HashEntry(key = BoxedValue(value = item), value = BoxedValue(value = Value.Unit)))
                            return Evaluation.Evaluated(value = Value.Boolean(value = true))
                        if selected < 0: return Evaluation.Evaluated(value = Value.Boolean(value = false))
                        try require_hash_shape_mutable(storage, "set")
                        let rebuilt = list[HashEntry]()
                        for index in range(0, len(storage.entries)):
                            if index != selected: rebuilt.append(storage.entries[index])
                        while len(storage.entries) > 0: storage.entries.remove(len(storage.entries) - 1)
                        for entry in rebuilt: storage.entries.append(entry)
                        return Evaluation.Evaluated(value = Value.Boolean(value = true))
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
            TransferredHash(execution): return Evaluation.Transferred(execution = execution)

    func evaluate_sequence_slice(value: NodeId, start: NodeId, end: NodeId, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate(value, bindings):
            Evaluated(sequence):
                var length = 0
                match sequence:
                    Array(elements): length = len(elements)
                    List(storage): length = len(storage.buffer.elements)
                    Bytes(payload): length = len(payload)
                    else: trap("typed slice operation has a non-contiguous receiver")
                var lower = 0
                if start.value != no_node:
                    match try self.evaluate(start, bindings):
                        Evaluated(item):
                            match item:
                                UnsignedInteger(bound):
                                    if bound > u64(length): error("interpreter: slice bounds out of range")
                                    lower = i64(bound)
                                else: trap("typed slice start is not an integer")
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                var upper = length
                if end.value != no_node:
                    match try self.evaluate(end, bindings):
                        Evaluated(item):
                            match item:
                                UnsignedInteger(bound):
                                    if bound > u64(length): error("interpreter: slice bounds out of range")
                                    upper = i64(bound)
                                else: trap("typed slice end is not an integer")
                        Transferred(execution): return Evaluation.Transferred(execution = execution)
                if lower > upper or upper > length:
                    error("interpreter: slice bounds out of range")
                var offset = lower
                var backing = SliceBacking.Bytes(value = list[u8]())
                match sequence:
                    Array(elements):
                        let snapshot = list[BoxedValue]()
                        for position in range(lower, upper): snapshot.append(elements[position])
                        backing = SliceBacking.List(buffer = ListBuffer(snapshot))
                        offset = 0
                    List(storage):
                        storage.has_snapshot = true
                        backing = SliceBacking.List(buffer = storage.buffer)
                    Bytes(payload): backing = SliceBacking.Bytes(value = payload)
                    else: trap("typed slice operation has a non-contiguous receiver")
                return Evaluation.Evaluated(value = Value.Slice(storage = SliceStorage(backing, offset, upper - lower)))
            Transferred(execution): return Evaluation.Transferred(execution = execution)

    func evaluate_call(function: SymbolId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let target = self.find_function(function)
        let values = list[Value]()
        for parameter in target.parameters: values.append(Value.Unit)
        let receiver = target.receiver
        var mutable_receiver_place: Place? = none
        # Arguments are pairs: parameter index, then the argument node.
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            if parameter_index == 0 and receiver != none and receiver.kind == HirReceiverKind.mutating_method:
                match try self.evaluate_mutable_place(argument, bindings):
                    EvaluatedPlace(place, item):
                        mutable_receiver_place = place
                        values[parameter_index] = item
                    TransferredPlace(execution): return Evaluation.Transferred(execution = execution)
            else:
                match try self.evaluate(argument, bindings):
                    Evaluated(item): values[parameter_index] = item
                    Transferred(execution): return Evaluation.Transferred(execution = execution)
        if receiver != none and receiver.kind == HirReceiverKind.mutating_method:
            # Selecting an inout receiver happens before later arguments, but
            # its value is read when the call begins. A later argument may
            # have mutated the same place; MIR naturally observes that through
            # the selected address, so the semantic oracle must do so too.
            let place = mutable_receiver_place else trap("mutating call on a value that is not a place")
            let index = find_binding(bindings, place.symbol)
            if index < 0: trap("mutating call refers to an unknown binding")
            values[0] = try value_at_assignment_place(self.binding_value(bindings[index].value), place.steps, 0)
        let invocation = try self.call(target, values)
        # A mutating method changed its copy of `self`; the caller's place
        # receives that copy (HirGenerator proved it is a place).
        if receiver != none and receiver.kind == HirReceiverKind.mutating_method:
            let place = mutable_receiver_place else trap("mutating call on a value that is not a place")
            let index = find_binding(bindings, place.symbol)
            if index < 0: trap("mutating call refers to an unknown binding")
            let updated = try value_with_assignment_place(self.binding_value(bindings[index].value), place.steps, 0, invocation.receiver)
            self.assign_binding(bindings, index, updated)
        return Evaluation.Evaluated(value = invocation.value)

    # Dynamic interface dispatch preserves the ordinary method-call ordering:
    # select the receiver place first, evaluate later arguments left-to-right,
    # then read and (for mutation) detach the current existential payload.
    func evaluate_interface_call(receiver: NodeId, interface_type: TypeId, requirement_index: u32, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        var interface_index = -1
        match self.program.types.definitions[interface_type.value].form:
            Interface(index, values): interface_index = index
            else: trap("interface call has a non-interface owner type")
        let requirement = self.program.interfaces[interface_index].requirements[requirement_index]
        var mutable_place: Place? = none
        var selected = Value.Unit
        if requirement.is_mutating:
            match try self.evaluate_mutable_place(receiver, bindings):
                EvaluatedPlace(place, value):
                    mutable_place = place
                    selected = value
                TransferredPlace(execution): return Evaluation.Transferred(execution = execution)
        else:
            match try self.evaluate(receiver, bindings):
                Evaluated(value): selected = value
                Transferred(execution): return Evaluation.Transferred(execution = execution)

        let explicit = list[Value]()
        for index in range(0, i64(arguments.count)):
            match try self.evaluate(node_at(self.program, arguments, index), bindings):
                Evaluated(value): explicit.append(value)
                Transferred(execution): return Evaluation.Transferred(execution = execution)

        if requirement.is_mutating:
            let place = mutable_place else trap("mutating interface call has no receiver place")
            let binding_index = find_binding(bindings, place.symbol)
            if binding_index < 0: trap("mutating interface call refers to an unknown binding")
            selected = try value_at_assignment_place(self.binding_value(bindings[binding_index].value), place.steps, 0)
        var selected_storage: InterfaceStorage? = none
        match selected:
            Interface(value): selected_storage = value
            else: trap("interface call receiver is not an existential value")
        let storage = selected_storage else trap("interface call has no existential storage")
        if i64(storage.conformance) >= len(self.program.conformances): trap("interface value has an unknown conformance")
        let conformance = self.program.conformances[storage.conformance]
        if not types_match(conformance.interface_type, interface_type): trap("interface value has the wrong conformance identity")
        if i64(requirement_index) >= len(conformance.implementations): trap("interface requirement is outside its conformance table")

        let values = list[Value]()
        values.append(storage.value.value)
        for value in explicit: values.append(value)
        let invocation = try self.call(self.find_function(conformance.implementations[requirement_index]), values)
        if requirement.is_mutating:
            # Always detaching the semantic wrapper is conservative COW. A
            # value conformer's aliases keep their old payload; a class
            # conformer's detached wrappers still name the same class identity.
            let place = mutable_place else trap("mutating interface call has no receiver place")
            let binding_index = find_binding(bindings, place.symbol)
            if binding_index < 0: trap("mutating interface call refers to an unknown binding")
            let updated_interface = Value.Interface(storage = InterfaceStorage(storage.conformance, invocation.receiver))
            let updated = try value_with_assignment_place(self.binding_value(bindings[binding_index].value), place.steps, 0, updated_interface)
            self.assign_binding(bindings, binding_index, updated)
        return Evaluation.Evaluated(value = invocation.value)

    # A function-value call evaluates its pointer first and positional
    # arguments left to right. HIR typing already proved the exact signature.
    func evaluate_indirect_call(callee: NodeId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let selected = try self.evaluate(callee, bindings)
        var function = SymbolId(value = 0)
        var raw_c_function: i64? = none
        let captures = list[Value]()
        match selected:
            Evaluated(value):
                match value:
                    Function(symbol): function = symbol
                    CFunction(identity):
                        match identity:
                            Declared(symbol): function = symbol
                            ForeignPointer(token): raw_c_function = token
                    Closure(storage):
                        function = self.program.closures[storage.closure].function
                        for capture in storage.captures: captures.append(capture.value)
                    else: trap("typed indirect call has a non-function value")
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        let values = list[Value]()
        for position in range(0, i64(arguments.count)):
            match try self.evaluate(node_at(self.program, arguments, position), bindings):
                Evaluated(value): values.append(value)
                Transferred(execution): return Evaluation.Transferred(execution = execution)
        if raw_c_function != none:
            return Evaluation.Evaluated(value = try self.call_c_function_pointer(raw_c_function, node_type(self.program, callee), values))
        return Evaluation.Evaluated(value = (try self.call_with_captures(self.find_function(function), values, captures)).value)

    # Invoke one opaque pointer through the exact checked cfunc signature.
    # The semantic host sees raw C-shaped components; it never receives a
    # fabricated HIR symbol standing in for the pointer.
    func call_c_function_pointer(pointer_value: i64, function_type: TypeId, arguments: list[Value]) -> Value!:
        if pointer_value == 0: error("interpreter: null_foreign invoking cfunc")
        let host = self.c_function_pointer_host else error("interpreter: cfunc pointer " + str(pointer_value) + " has no host binding")
        let parameters = list[TypeId]()
        var result_type = resolve_builtin_type(BuiltinType.unit)
        match self.program.types.definitions[function_type.value].form:
            CFunction(items, result):
                for item in items: parameters.append(item)
                result_type = result
            else: trap("raw C function pointer has a non-cfunc HIR type")
        if len(arguments) != len(parameters): trap("typed cfunc call has the wrong argument count")
        let encoded = list[Value]()
        for index in range(0, len(arguments)):
            encoded.append(try self.encode_c_component(arguments[index], parameters[index], "interpreter: null_foreign crossing cfunc parameter " + str(index)))
        let raw_result = try host.call(pointer_value, encoded)
        if types_match(result_type, resolve_builtin_type(BuiltinType.unit)):
            match raw_result:
                Unit: return Value.Unit
                else: error("interpreter: cfunc pointer returned a value incompatible with `unit`")
        return try self.decode_c_component(raw_result, result_type, "interpreter: null_foreign crossing cfunc result", "interpreter: cfunc pointer returned a value incompatible with `" + describe_type(self.program.types, result_type) + "`")

    # Evaluate one mutable receiver exactly once while retaining where its
    # final value must be copied back after the method returns.
    func evaluate_mutable_place(value: NodeId, bindings: list[Binding]) -> PlaceEvaluation!:
        match node_form(self.program, value):
            Reference(symbol):
                let index = find_binding(bindings, symbol)
                if index < 0: trap("mutating call refers to an unknown binding")
                return PlaceEvaluation.EvaluatedPlace(place = Place(symbol = symbol, steps = list[AssignmentPlaceStep]()), value = self.binding_value(bindings[index].value))
            FieldAccess(inner, field):
                match try self.evaluate_mutable_place(inner, bindings):
                    EvaluatedPlace(place, base):
                        match base:
                            Record(fields):
                                place.steps.append(AssignmentPlaceStep.Field(index = field))
                                return PlaceEvaluation.EvaluatedPlace(place = place, value = fields[field].value)
                            Class(storage):
                                if nominal_fields(self.program, storage.class_type)[field].is_weak:
                                    trap("weak optional field cannot be a mutating value receiver")
                                place.steps.append(AssignmentPlaceStep.ClassField(index = field))
                                return PlaceEvaluation.EvaluatedPlace(place = place, value = storage.fields[field].value)
                            else: trap("mutating field receiver has a non-record base")
                    TransferredPlace(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
            SequenceIndex(inner, index_node):
                match try self.evaluate_mutable_place(inner, bindings):
                    EvaluatedPlace(place, base):
                        match try self.evaluate(index_node, bindings):
                            Evaluated(index_value):
                                match index_value:
                                    UnsignedInteger(index):
                                        match base:
                                            Array(elements):
                                                if index >= u64(len(elements)): error("interpreter: index out of bounds")
                                                place.steps.append(AssignmentPlaceStep.Element(index = i64(index)))
                                                return PlaceEvaluation.EvaluatedPlace(place = place, value = elements[index].value)
                                            List(storage):
                                                if index >= u64(len(storage.buffer.elements)): error("interpreter: index out of bounds")
                                                place.steps.append(AssignmentPlaceStep.ListElement(index = i64(index)))
                                                return PlaceEvaluation.EvaluatedPlace(place = place, value = storage.buffer.elements[index].value)
                                            else: trap("mutating element receiver has a non-sequence base")
                                    else: trap("mutating element receiver has a non-integer index")
                            Transferred(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
                    TransferredPlace(execution): return PlaceEvaluation.TransferredPlace(execution = execution)
            else: trap("mutating call on a value that is not a place")

    # Construction owns fresh receiver storage. The initializer's source
    # result is unit-shaped; success substitutes the completed receiver while
    # failure preserves the Error unchanged.
    func evaluate_initializer(function: SymbolId, arguments: Operands, bindings: list[Binding]) -> Evaluation!:
        let target = self.find_function(function)
        let receiver = target.receiver else trap("initializer without a receiver")
        if receiver.kind != HirReceiverKind.initializer: trap("Initialize names a non-initializer")
        let values = list[Value]()
        for parameter in target.parameters: values.append(Value.Unit)
        let fields = list[BoxedValue]()
        match self.program.types.definitions[receiver.owner.value].form:
            Struct(struct_index, type_arguments):
                for field in nominal_fields(self.program, receiver.owner):
                    fields.append(BoxedValue(value = Value.Unit))
                values[0] = Value.Record(fields = fields)
            Class(class_index, type_arguments):
                for field in nominal_fields(self.program, receiver.owner):
                    if field.is_weak:
                        fields.append(BoxedValue(value = Value.WeakClass(storage = WeakClassStorage(none))))
                    else:
                        fields.append(BoxedValue(value = Value.Unit))
                let storage = ClassStorage(receiver.owner, fields, self, true, true, false)
                values[0] = Value.Class(storage = storage)
            else: trap("initializer receiver is not a struct or class")
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            match try self.evaluate(argument, bindings):
                Evaluated(item): values[parameter_index] = item
                Transferred(execution): return Evaluation.Transferred(execution = execution)
        let invocation = try self.call(target, values)
        match invocation.value:
            FallibleSuccess(success):
                mark_class_initialized(invocation.receiver)
                return Evaluation.Evaluated(value = Value.FallibleSuccess(value = BoxedValue(value = invocation.receiver)))
            FallibleFailure(failure): return Evaluation.Evaluated(value = invocation.value)
            else:
                mark_class_initialized(invocation.receiver)
                return Evaluation.Evaluated(value = invocation.receiver)

    func evaluate_match(subject: NodeId, arms: Operands, bindings: list[Binding]) -> Evaluation!:
        let evaluated = try self.evaluate(subject, bindings)
        var selected = Value.Unit
        match evaluated:
            Evaluated(item): selected = item
            Transferred(execution): return Evaluation.Transferred(execution = execution)
        let outer_count = len(bindings)
        for position in range(0, i64(arms.count)):
            let arm = node_at(self.program, arms, position)
            match node_form(self.program, arm):
                MatchArm(patterns, statements, value):
                    if try self.arm_matches(patterns, selected, bindings):
                        let result = try self.evaluate(value, bindings)
                        trim_bindings(bindings, outer_count)
                        return result
                else: trap("match arm run names a non-arm node")
        trap("checked `match` selected no arm")

    # Handle the failure of exactly `value`. Success bypasses the handler;
    # failure binds Error and runs a lexical scope whose Recovered transfer
    # becomes this expression's value. Every other transfer keeps travelling.
    func evaluate_catch(value: NodeId, failure: SymbolId, body: Operands, bindings: list[Binding]) -> Evaluation!:
        match try self.evaluate(value, bindings):
            Transferred(execution): return Evaluation.Transferred(execution = execution)
            Evaluated(item):
                match item:
                    FallibleSuccess(success): return Evaluation.Evaluated(value = success.value)
                    FallibleFailure(error_value):
                        let outer_count = len(bindings)
                        bindings.append(Binding(symbol = failure, value = error_value.value))
                        let outcome = try self.execute_scope(body, bindings)
                        trim_bindings(bindings, outer_count)
                        match outcome:
                            Recovered(recovered): return Evaluation.Evaluated(value = recovered)
                            Next: trap("checked catch handler finished without transferring")
                            else: return Evaluation.Transferred(execution = outcome)
                    else: trap("typed `catch` received a non-fallible HIR value")

    # mark: Patterns ============================================================================

    # Does any alternative of an arm match? A case pattern that matches also
    # binds its payload, so the arm's body sees the names.
    func arm_matches(patterns: Operands, selected: Value, bindings: list[Binding]) -> bool!:
        for position in range(0, i64(patterns.count)):
            if try self.pattern_matches(node_at(self.program, patterns, position), selected, bindings): return true
        return false

    func pattern_matches(pattern: NodeId, selected: Value, bindings: list[Binding]) -> bool!:
        match node_form(self.program, pattern):
            PatternWildcard: return true
            PatternLiteral(value):
                return as_boolean(try evaluate_binary(selected, BinaryOperation.Equal(operand_type = TypeId(value = 0)), self.program.values[value], self.program.types))
            PatternRange(lower, upper, inclusive):
                let low = self.program.values[lower]
                let high = self.program.values[upper]
                if not as_boolean(try evaluate_binary(low, BinaryOperation.LessEqual(operand_type = TypeId(value = 0)), selected, self.program.types)): return false
                if inclusive: return as_boolean(try evaluate_binary(selected, BinaryOperation.LessEqual(operand_type = TypeId(value = 0)), high, self.program.types))
                return as_boolean(try evaluate_binary(selected, BinaryOperation.Less(operand_type = TypeId(value = 0)), high, self.program.types))
            PatternCase(case_index, pattern_bindings):
                match selected:
                    Variant(actual, payload):
                        if actual != case_index: return false
                        for position in range(0, i64(pattern_bindings.count)):
                            bindings.append(Binding(symbol = SymbolId(value = u32(entry_at(self.program, pattern_bindings, position))), value = payload[position].value))
                        return true
                    Absent: return case_index == 0
                    Present(item):
                        if case_index != 1: return false
                        if pattern_bindings.count > 0:
                            bindings.append(Binding(symbol = SymbolId(value = u32(entry_at(self.program, pattern_bindings, 0))), value = item.value))
                        return true
                    else: trap("case pattern applied to non-enum, non-optional value `" + selected.render() + "`")
            else: trap("match pattern run names a non-pattern node")

    # A run of field indices as plain integers.
    func entries(run: Operands) -> list[i64]:
        let items = list[i64]()
        for position in range(0, i64(run.count)): items.append(entry_at(self.program, run, position))
        return items

    # mark: Program lookup ======================================================================

    # Resolve the external `module.function` request once at the execution
    # boundary; internal calls below use only SymbolId.
    func find_entry(module_name: str, function_name: str) -> HirFunction!:
        for module in self.program.modules:
            if module.name == module_name:
                for function in self.program.functions:
                    if function.module.value == module.id.value and function.name == function_name: return function
                error("interpreter: module `" + module_name + "` has no function `" + function_name + "`")
        error("interpreter: unknown module `" + module_name + "`")

    # Find an internal call target by its resolved program-wide symbol.
    func find_function(symbol: SymbolId) -> HirFunction:
        for function in self.program.functions:
            if function.symbol.value == symbol.value: return function
        trap("typed call refers to an unknown function")

# mark: Bindings ==============================================================================

# Construction arms source `deinit` only after an initializer reaches its
# successful return. Struct receivers pass through unchanged.
func mark_class_initialized(value: Value):
    match value:
        Class(storage): storage.is_initialized = true
        else: pass

# Weak slots never expose their storage carrier to source semantics. Reading
# one atomically promotes a live host weak edge to the ordinary optional class
# value used for the remainder of the expression.
func weak_class_value(storage: WeakClassStorage) -> Value:
    let target = storage.target
    if target == none: return Value.Absent
    if not target.is_alive: return Value.Absent
    return Value.Present(value = BoxedValue(value = Value.Class(storage = target)))

# Store one source optional class value without retaining its referent.
func weak_class_storage_value(value: Value) -> Value:
    match value:
        Absent: return Value.WeakClass(storage = WeakClassStorage(none))
        Present(boxed):
            match boxed.value:
                Class(storage): return Value.WeakClass(storage = WeakClassStorage(storage))
                else: trap("weak field received a non-class optional payload")
        else: trap("weak field received a non-optional HIR value")

# The place an expression names: a reference, or fields reached from one.
# Read the value selected by a fully evaluated mixed field/array place.
func value_at_assignment_place(value: Value, steps: list[AssignmentPlaceStep], start: i64) -> Value!:
    if start >= len(steps): return value
    match steps[start]:
        Field(index):
            match value:
                Record(fields): return try value_at_assignment_place(fields[index].value, steps, start + 1)
                else: trap("field step applied to a non-struct HIR value")
        ClassField(index):
            match value:
                Class(storage): return try value_at_assignment_place(storage.fields[index].value, steps, start + 1)
                else: trap("class-field step applied to a non-class HIR value")
        WeakField(index):
            match value:
                Class(storage):
                    match storage.fields[index].value:
                        WeakClass(slot): return try value_at_assignment_place(weak_class_value(slot), steps, start + 1)
                        else: trap("weak class field has owning storage")
                else: trap("weak-field step applied to a non-class HIR value")
        Element(index):
            match value:
                Array(elements):
                    if index < 0 or index >= len(elements): error("interpreter: index out of bounds")
                    return try value_at_assignment_place(elements[index].value, steps, start + 1)
                else: trap("element step applied to a non-array HIR value")
        ListElement(index):
            match value:
                List(storage):
                    if index < 0 or index >= len(storage.buffer.elements): error("interpreter: index out of bounds")
                    return try value_at_assignment_place(storage.buffer.elements[index].value, steps, start + 1)
                else: trap("list element step applied to a non-list HIR value")
        MapElement(key):
            match value:
                Map(storage):
                    let selected = try find_hash_entry(storage, key.value)
                    if selected < 0: trap("absent map value was read as an assignment place")
                    return try value_at_assignment_place(storage.entries[selected].value.value, steps, start + 1)
                else: trap("map element step applied to a non-map HIR value")

# Preserve every immutable snapshot by moving a list identity to a new buffer
# immediately before its first subsequent write. Aliases share ListStorage and
# therefore observe the same detachment and mutation.
func detach_list(storage: ListStorage):
    if not storage.has_snapshot: return
    let elements = list[BoxedValue]()
    for element in storage.buffer.elements: elements.append(element)
    storage.buffer = ListBuffer(elements)
    storage.has_snapshot = false

# Rebuild each enclosing value aggregate with the selected place replaced.
func value_with_assignment_place(value: Value, steps: list[AssignmentPlaceStep], start: i64, replacement: Value) -> Value!:
    if start >= len(steps): return replacement
    match steps[start]:
        Field(selected):
            match value:
                Record(fields):
                    let rebuilt = list[BoxedValue]()
                    for index in range(0, len(fields)):
                        if index == selected:
                            rebuilt.append(BoxedValue(value = try value_with_assignment_place(fields[index].value, steps, start + 1, replacement)))
                        else: rebuilt.append(fields[index])
                    return Value.Record(fields = rebuilt)
                else: trap("field step applied to a non-struct HIR value")
        ClassField(selected):
            match value:
                Class(storage):
                    storage.fields[selected] = BoxedValue(value = try value_with_assignment_place(storage.fields[selected].value, steps, start + 1, replacement))
                    return value
                else: trap("class-field step applied to a non-class HIR value")
        WeakField(selected):
            if start + 1 != len(steps): trap("weak-field step cannot contain a nested assignment")
            match value:
                Class(storage):
                    storage.fields[selected] = BoxedValue(value = weak_class_storage_value(replacement))
                    return value
                else: trap("weak-field step applied to a non-class HIR value")
        Element(selected):
            match value:
                Array(elements):
                    if selected < 0 or selected >= len(elements): error("interpreter: index out of bounds")
                    let rebuilt = list[BoxedValue]()
                    for index in range(0, len(elements)):
                        if index == selected:
                            rebuilt.append(BoxedValue(value = try value_with_assignment_place(elements[index].value, steps, start + 1, replacement)))
                        else: rebuilt.append(elements[index])
                    return Value.Array(elements = rebuilt)
                else: trap("element step applied to a non-array HIR value")
        ListElement(selected):
            match value:
                List(storage):
                    if selected < 0 or selected >= len(storage.buffer.elements): error("interpreter: index out of bounds")
                    detach_list(storage)
                    storage.buffer.elements[selected] = BoxedValue(value = try value_with_assignment_place(storage.buffer.elements[selected].value, steps, start + 1, replacement))
                    return value
                else: trap("list element step applied to a non-list HIR value")
        MapElement(key):
            if start + 1 != len(steps): trap("map element step cannot contain a nested assignment")
            match value:
                Map(storage):
                    let selected = try find_hash_entry(storage, key.value)
                    if selected >= 0:
                        storage.entries[selected].value = BoxedValue(value = replacement)
                    else:
                        try require_hash_shape_mutable(storage, "map")
                        storage.entries.append(HashEntry(key = key, value = BoxedValue(value = replacement)))
                    return value
                else: trap("map element step applied to a non-map HIR value")

# Remove locals introduced after a lexical scope began.
func trim_bindings(bindings: list[Binding], count: i64):
    while len(bindings) > count: bindings.remove(len(bindings) - 1)

# Innermost binding first, so a suite's binding wins over an outer one.
func find_binding(bindings: list[Binding], symbol: SymbolId) -> i64:
    var index = len(bindings) - 1
    while index >= 0:
        if bindings[index].symbol.value == symbol.value: return index
        index -= 1
    return -1

# mark: Operators =============================================================================

# Extract the bool proven by HIR typing, trapping only on a compiler defect.
func as_boolean(value: Value) -> bool:
    match value:
        Boolean(item): return item
        else: trap("typed Boolean expression contains another value")

# mark: Display ================================================================================

## Canonical user-facing spellings for the closed builtin Display family.
## Numeric width lives in the checked HIR type, but decimal spelling depends
## only on the mathematical value retained by the semantic oracle.
func display_builtin(value: Value, value_type: TypeId, types: TypeTable) -> str:
    match value:
        Boolean(item):
            if item: return "true"
            return "false"
        SignedInteger(item): return str(item)
        UnsignedInteger(item): return str(item)
        Floating(item):
            if floating_bit_width(types, value_type) <= 32: return display_float32(f32(item))
            return display_float64(item)
        Character(item): return str(item)
        else: trap("BuiltinDisplay received a non-displayable HIR value")

# mark: Primitive operations ==================================================================

# Apply one resolved unary operation. For example, `NumericNegate(i64)` maps
# integer 3 to -3 without consulting source `-` spelling.
func evaluate_unary(operation: UnaryOperation, value: Value, types: TypeTable) -> Value!:
    match operation:
        LogicalNot:
            match value:
                Boolean(item): return Value.Boolean(value = not item)
                else: trap("LogicalNot received a non-boolean HIR value")
        NumericIdentity(operand_type):
            match value:
                SignedInteger(item): return value
                UnsignedInteger(item): return value
                Floating(item): return value
                else: trap("NumericIdentity received a non-numeric HIR value")
        NumericNegate(operand_type):
            match value:
                SignedInteger(item): return try checked_integer_result(try checked_subtract(0, item), operand_type, types)
                Floating(item): return Value.Floating(value = normalize_float(-item, operand_type, types))
                else: trap("NumericNegate received a non-numeric HIR value")
        IntegerBitwiseNot(operand_type):
            match value:
                SignedInteger(item): return Value.SignedInteger(value = ~item)
                UnsignedInteger(item):
                    # Fixed width: `~0u8` is 255, never host-width u64.max.
                    return Value.UnsignedInteger(value = unsigned_integer_maximum(types, operand_type) - item)
                else: trap("IntegerBitwiseNot received a non-integer HIR value")

# Dispatch on the value family; HirGenerator already guaranteed both sides
# share it, so a mismatch here is a compiler bug, not a user error.
func evaluate_binary(left: Value, operation: BinaryOperation, right: Value, types: TypeTable) -> Value!:
    match operation:
        Equal(operand_type): return Value.Boolean(value = try values_equal(left, right, EqualityContext()))
        NotEqual(operand_type): return Value.Boolean(value = not (try values_equal(left, right, EqualityContext())))
        else: pass
    match left:
        Unit:
            match right:
                Unit: return evaluate_unit_binary(operation)
                else: trap("typed binary expression has unequal value types")
        Boolean(left_value):
            match right:
                Boolean(right_value): return evaluate_boolean_binary(left_value, operation, right_value)
                else: trap("typed binary expression has unequal value types")
        SignedInteger(left_value):
            match right:
                SignedInteger(right_value): return try evaluate_integer_binary(left_value, operation, right_value, types)
                else: trap("typed binary expression has unequal value types")
        UnsignedInteger(left_value):
            match right:
                UnsignedInteger(right_value): return try evaluate_unsigned_integer_binary(left_value, operation, right_value, types)
                else: trap("typed binary expression has unequal value types")
        Foreign(left_token):
            match right:
                Foreign(right_token): return evaluate_optional_equality(left_token == right_token, operation)
                else: trap("typed binary expression has unequal value types")
        Floating(left_value):
            match right:
                Floating(right_value): return evaluate_float_binary(left_value, operation, right_value, types)
                else: trap("typed binary expression has unequal value types")
        Character(left_value):
            match right:
                Character(right_value): return evaluate_comparable_equality(str(left_value) == str(right_value), u32(left_value) < u32(right_value), operation)
                else: trap("typed binary expression has unequal value types")
        Text(left_value):
            match right:
                Text(right_value): return evaluate_text_binary(left_value, operation, right_value)
                else: trap("typed binary expression has unequal value types")
        Bytes(left_value):
            match right:
                Bytes(right_value): return evaluate_bytes_binary(left_value, operation, right_value)
                else: trap("typed binary expression has unequal value types")
        Tuple(left_value):
            match right:
                Tuple(right_value): return try evaluate_tuple_binary(left_value, operation, right_value, types)
                else: trap("typed binary expression has unequal value types")
        Array(left_value):
            match right:
                Array(right_value): return try evaluate_tuple_binary(left_value, operation, right_value, types)
                else: trap("typed binary expression has unequal value types")
        Function(symbol): trap("function values have no binary operations")
        Closure(storage): trap("closure values have no binary operations")
        Interface(storage): trap("interface values have no binary operations")
        CFunction(identity): trap("cfunc values have no binary operations")
        Record(left_fields):
            match right:
                Record(right_fields): return try evaluate_tuple_binary(left_fields, operation, right_fields, types)
                else: trap("typed binary expression has unequal value types")
        Class(left_storage):
            match right:
                Class(right_storage):
                    match operation:
                        Identity(operand_type): return Value.Boolean(value = left_storage is right_storage)
                        NotIdentity(operand_type): return Value.Boolean(value = not (left_storage is right_storage))
                        else: trap("classes support identity operations only")
                else: trap("typed binary expression has unequal value types")
        WeakClass(storage): trap("hidden weak storage escaped field access")
        CapturedCell(storage): trap("hidden captured-cell storage escaped source reads")
        Variant(left_case, left_payload):
            match right:
                Variant(right_case, right_payload):
                    if left_case != right_case: return evaluate_optional_equality(false, operation)
                    return try evaluate_tuple_binary(left_payload, operation, right_payload, types)
                else: trap("typed binary expression has unequal value types")
        Absent:
            match right:
                Absent: return evaluate_optional_equality(true, operation)
                Present(item): return evaluate_optional_equality(false, operation)
                else: trap("typed binary expression has unequal value types")
        Present(left_value):
            match right:
                Absent: return evaluate_optional_equality(false, operation)
                Present(right_value): return try evaluate_binary(left_value.value, operation, right_value.value, types)
                else: trap("typed binary expression has unequal value types")
        FallibleSuccess(value): trap("fallible call outcome escaped `try` or `catch`")
        FallibleFailure(error_value): trap("fallible call outcome escaped `try` or `catch`")
        TextSlice(left_items): trap("slices have no binary operations in the current slice")
        Slice(storage): trap("slices have no binary operations in the current slice")
        List(left_storage):
            match right:
                List(right_storage): return evaluate_list_binary(left_storage, operation, right_storage)
                else: trap("typed binary expression has unequal value types")
        Map(left_storage):
            match right:
                Map(right_storage): return evaluate_hash_identity(left_storage, operation, right_storage, "maps")
                else: trap("typed binary expression has unequal value types")
        Set(left_storage):
            match right:
                Set(right_storage): return evaluate_hash_identity(left_storage, operation, right_storage, "sets")
                else: trap("typed binary expression has unequal value types")

# Render the source-visible Error shape only at the host execution boundary.
# Internal propagation retains the structured value and never parses text.
func render_error(value: Value) -> str:
    match value:
        Record(error_fields):
            if len(error_fields) != 2: return "malformed Error"
            var message = "<non-string message>"
            match error_fields[1].value:
                Text(text): message = text
                else: pass
            match error_fields[0].value:
                Record(code_fields):
                    if len(code_fields) == 2:
                        var domain = "<invalid package>"
                        var code = -1
                        match code_fields[0].value:
                            Text(text): domain = text
                            else: pass
                        match code_fields[1].value:
                            UnsignedInteger(number): code = i64(number)
                            else: pass
                        return domain + ":" + str(code) + ": " + message
                else: pass
            return "malformed Error: " + message
        else: return "malformed Error"

# Unit supports equality only; `unit == unit` is true.
func evaluate_unit_binary(operation: BinaryOperation) -> Value:
    match operation:
        Equal(operand_type): return Value.Boolean(value = true)
        NotEqual(operand_type): return Value.Boolean(value = false)
        else: trap("unit HIR value received a non-equality operation")

# Apply resolved equality to two bool values.
func evaluate_boolean_binary(left: bool, operation: BinaryOperation, right: bool) -> Value:
    match operation:
        Equal(operand_type): return Value.Boolean(value = left == right)
        NotEqual(operand_type): return Value.Boolean(value = left != right)
        else: trap("boolean HIR values received a non-equality operation")

# Apply resolved arithmetic, bitwise, equality, or ordering to integer values.
func evaluate_integer_binary(left: i64, operation: BinaryOperation, right: i64, types: TypeTable) -> Value!:
    match operation:
        Add(operand_type): return try checked_integer_result(try checked_add(left, right), operand_type, types)
        Subtract(operand_type): return try checked_integer_result(try checked_subtract(left, right), operand_type, types)
        Multiply(operand_type): return try checked_integer_result(try checked_multiply(left, right), operand_type, types)
        FloorDivide(operand_type): return try checked_integer_result(try checked_floor_divide(left, right), operand_type, types)
        Remainder(operand_type): return try checked_integer_result(try checked_remainder(left, right), operand_type, types)
        BitwiseAnd(operand_type): return Value.SignedInteger(value = left & right)
        BitwiseOr(operand_type): return Value.SignedInteger(value = left | right)
        BitwiseXor(operand_type): return Value.SignedInteger(value = left ^ right)
        ShiftLeft(operand_type):
            try require_valid_shift(right, operand_type, types)
            return Value.SignedInteger(value = normalize_shift_left(left, right, operand_type, types))
        ShiftRight(operand_type):
            try require_valid_shift(right, operand_type, types)
            return Value.SignedInteger(value = left >> right)
        Equal(operand_type): return Value.Boolean(value = left == right)
        NotEqual(operand_type): return Value.Boolean(value = left != right)
        Less(operand_type): return Value.Boolean(value = left < right)
        LessEqual(operand_type): return Value.Boolean(value = left <= right)
        Greater(operand_type): return Value.Boolean(value = left > right)
        GreaterEqual(operand_type): return Value.Boolean(value = left >= right)
        else: trap("typed integer expression contains an invalid operator")

# Unsigned arithmetic uses u64 all the way through, then applies the resolved
# source width. Guards run before host arithmetic so Stage-0 never decides a
# Luce overflow on our behalf.
func evaluate_unsigned_integer_binary(left: u64, operation: BinaryOperation, right: u64, types: TypeTable) -> Value!:
    match operation:
        Add(operand_type):
            if left > u64(18446744073709551615) - right: try overflow()
            return try checked_unsigned_integer_result(left + right, operand_type, types)
        Subtract(operand_type):
            if left < right: try overflow()
            return try checked_unsigned_integer_result(left - right, operand_type, types)
        Multiply(operand_type):
            if right != u64(0) and left > u64(18446744073709551615) // right: try overflow()
            return try checked_unsigned_integer_result(left * right, operand_type, types)
        FloorDivide(operand_type):
            if right == u64(0): error("interpreter: division by zero")
            return Value.UnsignedInteger(value = left // right)
        Remainder(operand_type):
            if right == u64(0): error("interpreter: division by zero")
            return Value.UnsignedInteger(value = left % right)
        BitwiseAnd(operand_type): return Value.UnsignedInteger(value = left & right)
        BitwiseOr(operand_type): return Value.UnsignedInteger(value = left | right)
        BitwiseXor(operand_type): return Value.UnsignedInteger(value = left ^ right)
        ShiftLeft(operand_type):
            try require_valid_unsigned_shift(right, operand_type, types)
            return Value.UnsignedInteger(value = shift_left_unsigned(left, i64(right), integer_bit_width(types, operand_type)))
        ShiftRight(operand_type):
            try require_valid_unsigned_shift(right, operand_type, types)
            return Value.UnsignedInteger(value = left >> right)
        Equal(operand_type): return Value.Boolean(value = left == right)
        NotEqual(operand_type): return Value.Boolean(value = left != right)
        Less(operand_type): return Value.Boolean(value = left < right)
        LessEqual(operand_type): return Value.Boolean(value = left <= right)
        Greater(operand_type): return Value.Boolean(value = left > right)
        GreaterEqual(operand_type): return Value.Boolean(value = left >= right)
        else: trap("typed unsigned integer expression contains an invalid operator")

# mark: Checked host arithmetic ================================================================
#
# Signed values travel as host `i64`s, and Stage-0 itself traps when one of
# those overflows. Every signed operation therefore proves the 64-bit result
# exists before computing it; unsigned operations use the separate `u64`
# path above. The final checked helper narrows to the resolved HIR width.

let i64_minimum: i64 = -9223372036854775807 - 1
let i64_maximum: i64 = 9223372036854775807

func overflow() -> !:
    error("interpreter: integer arithmetic overflow")

func checked_add(left: i64, right: i64) -> i64!:
    if right > 0 and left > i64_maximum - right: try overflow()
    if right < 0 and left < i64_minimum - right: try overflow()
    return left + right

func checked_subtract(left: i64, right: i64) -> i64!:
    if right < 0 and left > i64_maximum + right: try overflow()
    if right > 0 and left < i64_minimum + right: try overflow()
    return left - right

# Compare magnitudes against `maximum // |right|` so the only 2^63 product,
# `minimum` itself, is recognised without ever forming an overflowing value.
func checked_multiply(left: i64, right: i64) -> i64!:
    if left == 0 or right == 0: return 0
    if left == 1: return right
    if right == 1: return left
    if left == i64_minimum or right == i64_minimum: try overflow()
    let negative = (left < 0) != (right < 0)
    var left_magnitude = left
    if left_magnitude < 0: left_magnitude = 0 - left_magnitude
    var right_magnitude = right
    if right_magnitude < 0: right_magnitude = 0 - right_magnitude
    let limit = i64_maximum // right_magnitude
    if left_magnitude > limit:
        let divides_exactly = i64_maximum % right_magnitude == right_magnitude - 1
        if negative and divides_exactly and left_magnitude == limit + 1: return i64_minimum
        try overflow()
    return left * right

func checked_floor_divide(left: i64, right: i64) -> i64!:
    if right == 0: error("interpreter: division by zero")
    if left == i64_minimum and right == -1: try overflow()
    return left // right

func checked_remainder(left: i64, right: i64) -> i64!:
    if right == 0: error("interpreter: division by zero")
    if right == -1: return 0
    return left % right

# Enforce the fixed width carried by HIR after a checked arithmetic operation.
# For example, `2147483647i32 + 1i32` reports overflow.
func checked_integer_result(value: i64, operand_type: TypeId, types: TypeTable) -> Value!:
    if value < integer_minimum(types, operand_type) or value > integer_maximum(types, operand_type):
        error("interpreter: integer arithmetic overflow")
    return Value.SignedInteger(value = value)

func checked_unsigned_integer_result(value: u64, operand_type: TypeId, types: TypeTable) -> Value!:
    if value > unsigned_integer_maximum(types, operand_type):
        error("interpreter: integer arithmetic overflow")
    return Value.UnsignedInteger(value = value)

# Reject a shift count outside the resolved operand width before Stage-0 can
# apply its host-width behavior. For example, i32 counts must be in 0..<32.
func require_valid_shift(count: i64, operand_type: TypeId, types: TypeTable) -> !:
    let width = integer_bit_width(types, operand_type)
    if width == 0: trap("shift applied to a non-integer HIR type")
    if count < 0 or count >= width:
        error("interpreter: shift count is outside integer width")

func require_valid_unsigned_shift(count: u64, operand_type: TypeId, types: TypeTable) -> !:
    let width = integer_bit_width(types, operand_type)
    if width == 0: trap("shift applied to a non-integer HIR type")
    if count >= u64(width): error("interpreter: shift count is outside integer width")

# Shift one bit at a time after discarding the outgoing high bit. The value
# that remains can always be doubled in host `u64`, including at width 64.
func shift_left_unsigned(value: u64, count: i64, bits: i64) -> u64:
    let high_bit = u64(1) << u64(bits - 1)
    var result = value
    for step in range(0, count):
        if result >= high_bit: result -= high_bit
        result += result
    return result

# Model fixed-width left shift while values are physically stored as i64.
# `1i32 << 31i32`, for example, has the signed i32 value -2147483648.
func normalize_shift_left(value: i64, count: i64, operand_type: TypeId, types: TypeTable) -> i64:
    let width = integer_bit_width(types, operand_type)
    if width == 0: trap("shift applied to a non-integer HIR type")
    return shift_left_within(value, count, width, not is_unsigned_integer_type(types, operand_type))

# Keep the low `bits` of a value, sign-extending for signed types.
func wrap_to_width(value: i64, bits: i64, is_signed: bool) -> i64:
    if bits >= 64: return value
    let mask = (1 << bits) - 1
    let low = value & mask
    if is_signed and low >= (1 << (bits - 1)): return low - (mask + 1)
    return low

# Shift left within `bits`, dropping bits shifted past the width, without
# ever forming a host `i64` that overflows (Stage-0 traps on `1 << 63`).
# The surviving low `bits - count` bits of `value` are split into their top
# bit and the rest; the rest shifts safely below bit 63, and the top bit is
# added back as 2^(bits-1) — which for 64 bits is the i64 minimum.
func shift_left_within(value: i64, count: i64, bits: i64, is_signed: bool) -> i64:
    if count == 0: return wrap_to_width(value, bits, is_signed)
    let keep = bits - count
    var mask = 9223372036854775807
    if keep < 63: mask = (1 << keep) - 1
    let low = value & mask
    let top = (low >> (keep - 1)) & 1
    let rest = low & (mask >> 1)
    var shifted = rest << count
    if top == 1:
        if bits == 64: shifted = shifted + (-9223372036854775807 - 1)
        else: shifted = shifted + (1 << (bits - 1))
    return wrap_to_width(shifted, bits, is_signed)

# Derive every comparison from `equal` and `less`. Characters use this:
# they order by Unicode code point, never by locale.
func evaluate_comparable_equality(equal: bool, less: bool, operation: BinaryOperation) -> Value:
    match operation:
        Equal(operand_type): return Value.Boolean(value = equal)
        NotEqual(operand_type): return Value.Boolean(value = not equal)
        Less(operand_type): return Value.Boolean(value = less)
        LessEqual(operand_type): return Value.Boolean(value = less or equal)
        Greater(operand_type): return Value.Boolean(value = not less and not equal)
        GreaterEqual(operand_type): return Value.Boolean(value = not less)
        else: trap("ordered HIR values received a non-comparison operation")

# Valid UTF-8 preserves Unicode scalar order under unsigned byte comparison,
# while the semantic oracle can compare its decoded strings directly.
func evaluate_text_binary(left: str, operation: BinaryOperation, right: str) -> Value:
    match operation:
        Add(operand_type): return Value.Text(value = left + right)
        else: return evaluate_comparable_equality(left == right, left < right, operation)

# Byte strings concatenate and compare lexicographically by unsigned byte.
func evaluate_bytes_binary(left: list[u8], operation: BinaryOperation, right: list[u8]) -> Value:
    match operation:
        Add(operand_type):
            let joined = list[u8]()
            for value in left: joined.append(value)
            for value in right: joined.append(value)
            return Value.Bytes(value = joined)
        else: pass
    var equal = len(left) == len(right)
    var index = 0
    while equal and index < len(left):
        if left[index] != right[index]: equal = false
        index += 1
    var less = false
    index = 0
    while index < len(left) and index < len(right):
        if left[index] < right[index]:
            less = true
            break
        if left[index] > right[index]: break
        index += 1
    if index == len(left) and index < len(right): less = true
    match operation:
        Equal(operand_type): return Value.Boolean(value = equal)
        NotEqual(operand_type): return Value.Boolean(value = not equal)
        Less(operand_type): return Value.Boolean(value = less)
        LessEqual(operand_type): return Value.Boolean(value = less or equal)
        Greater(operand_type): return Value.Boolean(value = not less and not equal)
        GreaterEqual(operand_type): return Value.Boolean(value = not less)
        else: trap("bytes HIR values received an unsupported operation")

# Lists retain identity under assignment, but `+` constructs a fresh shallow
# collection whose slots contain the left elements followed by the right.
func evaluate_list_binary(left: ListStorage, operation: BinaryOperation, right: ListStorage) -> Value:
    match operation:
        Identity(operand_type): return Value.Boolean(value = left is right)
        NotIdentity(operand_type): return Value.Boolean(value = not (left is right))
        Add(operand_type):
            let elements = list[BoxedValue]()
            for element in left.buffer.elements: elements.append(element)
            for element in right.buffer.elements: elements.append(element)
            return Value.List(storage = ListStorage(elements))
        else: trap("lists have no other binary operations in the current slice")

func evaluate_hash_identity(left: HashStorage, operation: BinaryOperation, right: HashStorage, kind: str) -> Value:
    match operation:
        Identity(operand_type): return Value.Boolean(value = left is right)
        NotIdentity(operand_type): return Value.Boolean(value = not (left is right))
        else: trap(kind + " have no non-structural binary operation")

# mark: Cycle-aware equality ==================================================================

# A comparison is one coinductive transaction. Revisiting the same ordered
# pair of list identities proves the recursive edge already being compared;
# later scalar/shape differences in that transaction still make the root
# unequal. Keeping pairs in the oracle, rather than on ListStorage, makes
# equality reentrant and leaves collection identity unmodified.
class EqualityContext:
    let left_lists: list[ListStorage]
    let right_lists: list[ListStorage]
    let left_maps: list[HashStorage]
    let right_maps: list[HashStorage]

    pub init():
        self.left_lists = list[ListStorage]()
        self.right_lists = list[ListStorage]()
        self.left_maps = list[HashStorage]()
        self.right_maps = list[HashStorage]()

    func seen_or_add(left: ListStorage, right: ListStorage) -> bool:
        for index in range(0, len(self.left_lists)):
            if self.left_lists[index] is left and self.right_lists[index] is right: return true
        self.left_lists.append(left)
        self.right_lists.append(right)
        return false

    func seen_map_or_add(left: HashStorage, right: HashStorage) -> bool:
        for index in range(0, len(self.left_maps)):
            if self.left_maps[index] is left and self.right_maps[index] is right: return true
        self.left_maps.append(left)
        self.right_maps.append(right)
        return false

func boxed_values_equal(left: list[BoxedValue], right: list[BoxedValue], context: EqualityContext) -> bool!:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if not (try values_equal(left[index].value, right[index].value, context)): return false
    return true

func byte_values_equal(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

func find_hash_entry(storage: HashStorage, key: Value) -> i64!:
    for index in range(0, len(storage.entries)):
        if try values_equal(storage.entries[index].key.value, key, EqualityContext()): return index
    return -1

func values_equal(left: Value, right: Value, context: EqualityContext) -> bool!:
    match left:
        Unit:
            match right:
                Unit: return true
                else: return false
        Boolean(value):
            match right:
                Boolean(other): return value == other
                else: return false
        SignedInteger(value):
            match right:
                SignedInteger(other): return value == other
                else: return false
        UnsignedInteger(value):
            match right:
                UnsignedInteger(other): return value == other
                else: return false
        Foreign(value):
            match right:
                Foreign(other): return value == other
                else: return false
        Floating(value):
            match right:
                Floating(other): return value == other
                else: return false
        Character(value):
            match right:
                Character(other): return value == other
                else: return false
        Text(value):
            match right:
                Text(other): return value == other
                else: return false
        Bytes(value):
            match right:
                Bytes(other): return byte_values_equal(value, other)
                else: return false
        Tuple(values):
            match right:
                Tuple(other): return try boxed_values_equal(values, other, context)
                else: return false
        Array(values):
            match right:
                Array(other): return try boxed_values_equal(values, other, context)
                else: return false
        Record(values):
            match right:
                Record(other): return try boxed_values_equal(values, other, context)
                else: return false
        Variant(case_index, payload):
            match right:
                Variant(other_case, other_payload):
                    return case_index == other_case and try boxed_values_equal(payload, other_payload, context)
                else: return false
        Absent:
            match right:
                Absent: return true
                else: return false
        Present(value):
            match right:
                Present(other): return try values_equal(value.value, other.value, context)
                else: return false
        List(storage):
            match right:
                List(other):
                    if storage is other: return true
                    if len(storage.buffer.elements) != len(other.buffer.elements): return false
                    if context.seen_or_add(storage, other): return true
                    return try boxed_values_equal(storage.buffer.elements, other.buffer.elements, context)
                else: return false
        Map(storage):
            match right:
                Map(other):
                    if storage is other: return true
                    if len(storage.entries) != len(other.entries): return false
                    if context.seen_map_or_add(storage, other): return true
                    for entry in storage.entries:
                        let found = try find_hash_entry(other, entry.key.value)
                        if found < 0: return false
                        if not (try values_equal(entry.value.value, other.entries[found].value.value, context)): return false
                    return true
                else: return false
        Set(storage):
            match right:
                Set(other):
                    if storage is other: return true
                    if len(storage.entries) != len(other.entries): return false
                    for entry in storage.entries:
                        if try find_hash_entry(other, entry.key.value) < 0: return false
                    return true
                else: return false
        else: trap("non-equatable HIR value reached structural equality")

func require_list_shape_mutable(storage: ListStorage) -> !:
    if storage.active_iterations > 0:
        error("interpreter: list structurally modified during active iteration")

func require_hash_shape_mutable(storage: HashStorage, kind: str) -> !:
    if storage.active_iterations > 0:
        error("interpreter: " + kind + " structurally modified during active iteration")

func require_list_storage(value: Value) -> ListStorage:
    match value:
        List(storage): return storage
        else: trap("typed list iteration received a non-list value")

# mark: Structural hashing ====================================================================

# One deliberately private xorshift combiner. Hash values are execution-local
# and have no persistent representation; this oracle needs only the language
# invariant that equal values in one run produce equal codes.
func mix_structural_hash(state: u64, value: u64) -> u64:
    var mixed = state ^ value
    # Reuse the oracle's explicit fixed-width shift because Stage-0 traps when
    # a host expression itself discards a high bit.
    mixed = mixed ^ shift_left_unsigned(mixed, 13, 64)
    mixed = mixed ^ (mixed >> u64(7))
    mixed = mixed ^ shift_left_unsigned(mixed, 17, 64)
    return mixed

func hash_bytes(state: u64, value: list[u8]) -> u64:
    var result = mix_structural_hash(state, u64(len(value)))
    for byte in value: result = mix_structural_hash(result, u64(byte))
    return result

func hash_values(state: u64, values: list[BoxedValue]) -> u64:
    var result = mix_structural_hash(state, u64(len(values)))
    for value in values: result = mix_structural_hash(result, structural_hash(value.value))
    return result

func structural_hash(value: Value) -> u64:
    let seed = u64(1469598103934665603)
    match value:
        Unit: return mix_structural_hash(seed, u64(1))
        Boolean(item):
            if item: return mix_structural_hash(seed, u64(2))
            return mix_structural_hash(seed, u64(3))
        SignedInteger(item):
            var magnitude = u64(0)
            if item < 0: magnitude = u64(0 - (item + 1))
            else: magnitude = u64(item)
            let signed = mix_structural_hash(seed, magnitude)
            if item < 0: return mix_structural_hash(signed, u64(5))
            return mix_structural_hash(signed, u64(4))
        UnsignedInteger(item): return mix_structural_hash(seed, mix_structural_hash(u64(6), item))
        Floating(item):
            if item == 0.0: return mix_structural_hash(seed, u64(7))
            return hash_bytes(mix_structural_hash(seed, u64(8)), strings.to_bytes(str(item)))
        Character(item): return mix_structural_hash(seed, mix_structural_hash(u64(9), u64(u32(item))))
        Text(item): return hash_bytes(mix_structural_hash(seed, u64(10)), strings.to_bytes(item))
        Bytes(item): return hash_bytes(mix_structural_hash(seed, u64(11)), item)
        Tuple(items): return hash_values(mix_structural_hash(seed, u64(12)), items)
        Array(items): return hash_values(mix_structural_hash(seed, u64(13)), items)
        Record(fields): return hash_values(mix_structural_hash(seed, u64(14)), fields)
        Variant(case_index, payload):
            let tagged = mix_structural_hash(mix_structural_hash(seed, u64(15)), u64(case_index))
            return hash_values(tagged, payload)
        Absent: return mix_structural_hash(seed, u64(16))
        Present(item): return mix_structural_hash(mix_structural_hash(seed, u64(17)), structural_hash(item.value))
        Foreign(token): trap("foreign handles are not structurally hashable")
        TextSlice(items): trap("slices are not structurally hashable")
        List(storage): trap("mutable lists are not structurally hashable")
        Map(storage): trap("mutable maps are not structurally hashable")
        Set(storage): trap("mutable sets are not structurally hashable")
        Slice(storage): trap("slices are not structurally hashable")
        Function(symbol): trap("functions are not structurally hashable")
        Closure(storage): trap("closures are not structurally hashable")
        Interface(storage): trap("interface values are not structurally hashable")
        CFunction(identity): trap("C functions are not structurally hashable")
        Class(storage): trap("classes are not structurally hashable")
        WeakClass(storage): trap("weak handles are not structurally hashable")
        CapturedCell(storage): trap("captured cells are not structurally hashable")
        FallibleSuccess(item): trap("fallible outcomes are not structurally hashable")
        FallibleFailure(item): trap("fallible outcomes are not structurally hashable")

# Tuples compare elementwise through `evaluate_binary`, so each element uses
# its own family's equality; HirGenerator already made both sides one type.
func evaluate_tuple_binary(left: list[BoxedValue], operation: BinaryOperation, right: list[BoxedValue], types: TypeTable) -> Value!:
    if len(left) != len(right): trap("typed tuples have unequal length")
    var index = 0
    while index < len(left):
        # Equality does not read `operand_type`; the values already share a type.
        let compared = try evaluate_binary(left[index].value, BinaryOperation.Equal(operand_type = TypeId(value = 0)), right[index].value, types)
        match compared:
            Boolean(equal):
                if not equal:
                    match operation:
                        Equal(operand_type): return Value.Boolean(value = false)
                        NotEqual(operand_type): return Value.Boolean(value = true)
                        else: trap("tuple HIR values received a non-equality operation")
            else: trap("tuple equality produced a non-boolean HIR value")
        index += 1
    match operation:
        Equal(operand_type): return Value.Boolean(value = true)
        NotEqual(operand_type): return Value.Boolean(value = false)
        else: trap("tuple HIR values received a non-equality operation")

# Two optionals are equal when both are absent, or both are present with
# equal payloads; `evaluate_binary` has already settled which case applies.
func evaluate_optional_equality(both_absent_or_equal: bool, operation: BinaryOperation) -> Value:
    match operation:
        Equal(operand_type): return Value.Boolean(value = both_absent_or_equal)
        NotEqual(operand_type): return Value.Boolean(value = not both_absent_or_equal)
        else: trap("optional HIR values received a non-equality operation")

# Apply resolved arithmetic, equality, or ordering to floating-point values.
func evaluate_float_binary(left: f64, operation: BinaryOperation, right: f64, types: TypeTable) -> Value:
    match operation:
        Add(operand_type): return Value.Floating(value = normalize_float(left + right, operand_type, types))
        Subtract(operand_type): return Value.Floating(value = normalize_float(left - right, operand_type, types))
        Multiply(operand_type): return Value.Floating(value = normalize_float(left * right, operand_type, types))
        Divide(operand_type): return Value.Floating(value = normalize_float(left / right, operand_type, types))
        Equal(operand_type): return Value.Boolean(value = left == right)
        NotEqual(operand_type): return Value.Boolean(value = left != right)
        Less(operand_type): return Value.Boolean(value = left < right)
        LessEqual(operand_type): return Value.Boolean(value = left <= right)
        Greater(operand_type): return Value.Boolean(value = left > right)
        GreaterEqual(operand_type): return Value.Boolean(value = left >= right)
        else: trap("typed floating-point expression contains an invalid operator")

# mark: Numeric construction ==================================================================

func normalize_float(value: f64, value_type: TypeId, types: TypeTable) -> f64:
    return normalize_ieee_float(value, floating_bit_width(types, value_type))

func checked_float_conversion(value: f64, destination: TypeId, types: TypeTable) -> f64!:
    let rounded = normalize_float(value, destination, types)
    if (value - value) == 0.0 and (rounded - rounded) != 0.0:
        error("interpreter: trap: floating-point conversion out of range")
    return rounded

func convert_numeric_value(value: Value, destination: TypeId, types: TypeTable) -> Value!:
    match value:
        SignedInteger(integer):
            if is_floating_type(types, destination):
                return Value.Floating(value = try checked_float_conversion(f64(integer), destination, types))
            if is_unsigned_integer_type(types, destination):
                if integer < 0 or u64(integer) > unsigned_integer_maximum(types, destination):
                    error("interpreter: trap: integer conversion out of range")
                return Value.UnsignedInteger(value = u64(integer))
            if integer < integer_minimum(types, destination) or integer > integer_maximum(types, destination):
                error("interpreter: trap: integer conversion out of range")
            return Value.SignedInteger(value = integer)
        UnsignedInteger(integer):
            if is_floating_type(types, destination):
                return Value.Floating(value = try checked_float_conversion(f64(integer), destination, types))
            if is_unsigned_integer_type(types, destination):
                if integer > unsigned_integer_maximum(types, destination): error("interpreter: trap: integer conversion out of range")
                return Value.UnsignedInteger(value = integer)
            if integer > u64(integer_maximum(types, destination)):
                error("interpreter: trap: integer conversion out of range")
            return Value.SignedInteger(value = i64(integer))
        Floating(item):
            if is_floating_type(types, destination):
                return Value.Floating(value = try checked_float_conversion(item, destination, types))
            if item != item: error("interpreter: trap: float to integer conversion of NaN")
            if is_unsigned_integer_type(types, destination):
                let upper = f64(unsigned_integer_maximum(types, destination)) + 1.0
                if item < 0.0 or item >= upper: error("interpreter: trap: float to integer conversion is outside the integer range")
                return Value.UnsignedInteger(value = u64(item))
            if item < f64(integer_minimum(types, destination)) or item >= f64(integer_maximum(types, destination)) + 1.0:
                error("interpreter: trap: float to integer conversion is outside the integer range")
            return Value.SignedInteger(value = i64(item))
        else: trap("typed numeric conversion has a non-numeric value")
