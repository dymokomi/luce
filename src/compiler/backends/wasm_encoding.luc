#==============================================================================================
#
#   wasm_encoding - The WebAssembly byte vocabulary and shared byte emitters
#
#   DESCRIPTION:
#       The binary format's section, type, and opcode names, the LEB128
#       integer encodings, and the small byte emitters every encoder shares:
#       locals, constants, memory operations, guards, runtime calls, and
#       function descriptors. `backends/wasm` and the profile encoder in
#       `profiles/full/backends/wasm_emission` both build on this module, so
#       it imports neither of them.
#
#==============================================================================================

from compiler.backends.wasm_plan import ModulePlan, defined_function_index
from compiler.mir.canonical import FunctionId, MirProgram, RegisterId, TypeId, find_runtime_binding
from compiler.runtime_contract import RuntimeService

# mark: WebAssembly binary format names =======================================================

pub let type_section: u8 = 0x01
pub let import_section: u8 = 0x02
pub let function_section: u8 = 0x03
pub let table_section: u8 = 0x04
pub let memory_section: u8 = 0x05
pub let global_section: u8 = 0x06
pub let export_section: u8 = 0x07
pub let element_section: u8 = 0x09
pub let code_section: u8 = 0x0A
pub let data_section: u8 = 0x0B

pub let function_type_tag: u8 = 0x60
pub let i64_value_type: u8 = 0x7E
pub let f32_value_type: u8 = 0x7D
pub let f64_value_type: u8 = 0x7C
pub let function_reference_type: u8 = 0x70
pub let function_import_kind: u8 = 0x00
pub let global_import_kind: u8 = 0x03
pub let function_export_kind: u8 = 0x00
pub let memory_export_kind: u8 = 0x02
pub let global_mutable: u8 = 0x01
pub let empty_block_type: u8 = 0x40

# WASI preview 1: the module name, the two services used, and the scratch
# area at the start of memory that `fd_write` reads its iovec from.
pub let wasi_module: str = "wasi_snapshot_preview1"
pub let wasi_fd_write: str = "fd_write"
pub let wasi_proc_exit: str = "proc_exit"
# Only WebAssembly interprets a host namespace. The same canonical C symbol
# is linked directly by QBE/native backends.
pub let c_import_module: str = "env"
pub let wasi_stdout: i64 = 1
pub let wasi_stderr: i64 = 2
pub let scratch_iovec_buffer: i64 = 0     # iovec.buf: i32 offset of the bytes
pub let scratch_iovec_length: i64 = 4     # iovec.buf_len: i32 byte count
pub let scratch_written: i64 = 8          # where fd_write stores the count written
pub let scratch_trap_newline: i64 = 12    # one backend-owned diagnostic newline

# The shadow stack pointer follows imported external globals in Wasm's global
# index space, starts at the top of a sixteen-page memory, and grows down
# toward the data. Frames are
# 16-byte aligned. A memory without a stack stays one page.
pub let page_size: i64 = 65536
pub let stack_pages: i64 = 16

