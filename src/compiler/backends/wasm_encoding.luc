#==============================================================================================
#
#   wasm_encoding - Shared WebAssembly integer encodings
#
#   DESCRIPTION:
#       Small byte-level primitives shared by the module encoder and its
#       backend-local legalization modules. They know only WebAssembly's
#       integer representation, never canonical MIR or target policy.
#
#==============================================================================================

# mark: LEB128 =================================================================================

## Append an unsigned WebAssembly LEB128 integer.
pub func append_unsigned(output: list[u8], number: i64):
    var value = number
    while value >= 0x80:
        output.append(u8(value & 0x7F | 0x80))
        value = value >> 7
    output.append(u8(value))

## Append a signed WebAssembly LEB128 integer.
pub func append_signed(output: list[u8], number: i64):
    var value = number
    while true:
        var byte = value & 0x7F
        value = value >> 7
        let finished = (value == 0 and byte & 0x40 == 0) or (value == -1 and byte & 0x40 != 0)
        if not finished: byte = byte | 0x80
        output.append(u8(byte))
        if finished: return
