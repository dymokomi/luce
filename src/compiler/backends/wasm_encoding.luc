# mark: LEB128 =================================================================================

## Append an unsigned WebAssembly LEB128 integer.
pub func append_unsigned(output: list[u8], number: i64):
    var value = number
    while value >= 0x80:
        output.append(u8(value & 0x7F | 0x80))
        value = value >> 7
    output.append(u8(value))

## Append a signed WebAssembly LEB128 integer.
pub func append_signed(output: list[u8], number: i64):
    var value = number
    while true:
        var byte = value & 0x7F
        value = value >> 7
        let finished = (value == 0 and byte & 0x40 == 0) or (value == -1 and byte & 0x40 != 0)
        if not finished: byte = byte | 0x80
        output.append(u8(byte))
        if finished: return

# mark: Shared byte emitters ===================================================================

pub func append_constant(body: list[u8], value: i64, is_wide: bool):
    body.append(pick(is_wide, opcode_i64_const, opcode_i32_const))
    append_signed(body, value)

pub func append_function_descriptor(plan: ModulePlan, body: list[u8], function: FunctionId):
    let offset = plan.function_descriptor_offsets[function.value]
    if offset < 0: trap("module plan omitted a function callback descriptor")
    append_constant(body, offset, false)

pub func append_memory_op(body: list[u8], opcode: u8, alignment: i64):
    body.append(opcode)
    append_unsigned(body, alignment)
    append_unsigned(body, 0)

# `if <condition> unreachable end`: trap when the i32 on the stack is true.
pub func append_trap_if_true(body: list[u8]):
    body.append(opcode_if)
    body.append(empty_block_type)
    body.append(opcode_unreachable)
    body.append(opcode_end)

pub func encode_function_value(body: list[u8], destination: RegisterId, function: FunctionId?, environment: RegisterId?):
    local_get(body, destination)
    var table_slot: i64 = 0
    if function != none: table_slot = i64(function.value)
    append_constant(body, table_slot, false)
    append_memory_op(body, opcode_i32_store, 2)
    local_get(body, destination)
    append_constant(body, 4, false)
    body.append(opcode_i32_add)
    if environment == none: append_constant(body, 0, false)
    else: local_get(body, environment)
    append_memory_op(body, opcode_i32_store, 2)

pub func encode_index_guard(plan: ModulePlan, body: list[u8], value: RegisterId, index: RegisterId, allow_end: bool, length_service: FunctionId):
    local_get(body, index)
    local_get(body, value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(length_service.value)))
    if allow_end: body.append(opcode_i64_gt_u)
    else: body.append(opcode_i64_ge_u)
    append_trap_if_true(body)

pub func encode_pointer_runtime_call(program: MirProgram, plan: ModulePlan, body: list[u8], service: RuntimeService, value: RegisterId, instruction: str) -> !:
    let target = find_runtime_binding(program, service) else error("wasm backend: verified `" + instruction + "` has no runtime binding")
    local_get(body, value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(target.value)))

pub func local_get(body: list[u8], register: RegisterId):
    body.append(opcode_local_get)
    append_unsigned(body, i64(register.value))

pub func local_get_index(body: list[u8], index: i64):
    body.append(opcode_local_get)
    append_unsigned(body, index)

pub func local_set(body: list[u8], register: RegisterId):
    body.append(opcode_local_set)
    append_unsigned(body, i64(register.value))

pub func local_set_index(body: list[u8], index: i64):
    body.append(opcode_local_set)
    append_unsigned(body, index)

pub func pick(is_wide: bool, wide: u8, narrow: u8) -> u8:
    if is_wide: return wide
    return narrow

pub func recycling_alignment(plan: ModulePlan, alignment: i64) -> i64:
    let pointer_alignment = plan.layout.pointer_align()
    if alignment < pointer_alignment: return pointer_alignment
    return alignment

pub func storage_alignment(plan: ModulePlan, element_type: TypeId) -> i64:
    return recycling_alignment(plan, plan.layout.align_of(element_type))

