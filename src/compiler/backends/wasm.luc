#==============================================================================================
#
#   wasm - Canonical instructions into a WebAssembly module
#
#   DESCRIPTION:
#       A direct WebAssembly encoder for the first canonical-IR slice. It writes
#       the binary format itself — module header, one shared `() -> i64`
#       signature, exports, and code — with no assembler or library in between.
#
#       Canonical instructions map one-to-one onto WASM opcodes because both are
#       stack machines with explicit operand order, which makes this the easiest
#       compiled backend to read first.
#
#==============================================================================================

from compiler.backend import ArtifactBackend
from compiler.canonical_ir import CanonicalProgram
import std.strings

# mark: WebAssembly binary format names =======================================================

const type_section: u8 = 0x01
const function_section: u8 = 0x03
const export_section: u8 = 0x07
const code_section: u8 = 0x0A

const function_type_tag: u8 = 0x60
const i64_value_type: u8 = 0x7E
const function_export_kind: u8 = 0x00

const opcode_i64_const: u8 = 0x42
const opcode_i64_add: u8 = 0x7C
const opcode_i64_subtract: u8 = 0x7D
const opcode_i64_multiply: u8 = 0x7E
const opcode_return: u8 = 0x0F
const opcode_end: u8 = 0x0B

# mark: The encoder ===========================================================================

pub class WasmBackend: ArtifactBackend:
    pub init():
        # Stateless; stage-0 requires one statement in an empty init.
        return

    ## Encode one canonical program as the bytes of a complete `.wasm` module.
    pub func emit(program: CanonicalProgram) -> list[u8]!:
        try self.validate(program)
        let output = list[u8]()
        # `\0asm`, then binary format version 1.
        append_all(output, [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00])
        append_section(output, type_section, self.encode_type_entries())
        append_section(output, function_section, self.encode_function_entries(program))
        let exports = self.encode_export_entries(program)
        if len(exports) > 1:
            append_section(output, export_section, exports)
        append_section(output, code_section, self.encode_code_entries(program))
        return output

    # Reject anything outside the slice up front, so the encoding walk below
    # never has to fail halfway through a section.
    func validate(program: CanonicalProgram) -> !:
        for function in program.functions:
            if function.result != "i64":
                error("wasm backend does not support result type `" + function.result + "` yet in `" + function.name + "`")
            for instruction in function.instructions:
                match instruction:
                    I64Constant(value): continue
                    I64Add: continue
                    I64Subtract: continue
                    I64Multiply: continue
                    Return: continue
                    else: error("wasm backend does not support instruction `" + str(instruction) + "` yet in `" + function.name + "`")

    # One shared type: every current function is `() -> i64`.
    func encode_type_entries() -> list[u8]:
        return [0x01, function_type_tag, 0x00, 0x01, i64_value_type]

    # Every function uses type index zero.
    func encode_function_entries(program: CanonicalProgram) -> list[u8]:
        let entries = list[u8]()
        append_unsigned(entries, len(program.functions))
        for function in program.functions:
            append_unsigned(entries, 0)
        return entries

    # Public functions export under their canonical `module.function` name.
    # A lone leading count byte means "no exports"; the caller writes this
    # section only when something follows the count.
    func encode_export_entries(program: CanonicalProgram) -> list[u8]:
        let entries = list[u8]()
        var export_count = 0
        for function in program.functions:
            if function.is_public: export_count += 1
        append_unsigned(entries, export_count)

        var function_index = 0
        for function in program.functions:
            if function.is_public:
                let name = strings.to_bytes(function.name)
                append_unsigned(entries, len(name))
                append_all(entries, name)
                entries.append(function_export_kind)
                append_unsigned(entries, function_index)
            function_index += 1
        return entries

    # One body per function: canonical instructions become their opcodes.
    func encode_code_entries(program: CanonicalProgram) -> list[u8]:
        let entries = list[u8]()
        append_unsigned(entries, len(program.functions))
        for function in program.functions:
            let body = list[u8]()
            # Zero local declarations; operands live on the WASM stack.
            body.append(0x00)
            for instruction in function.instructions:
                match instruction:
                    I64Constant(value):
                        body.append(opcode_i64_const)
                        append_signed(body, value)
                    I64Add: body.append(opcode_i64_add)
                    I64Subtract: body.append(opcode_i64_subtract)
                    I64Multiply: body.append(opcode_i64_multiply)
                    Return: body.append(opcode_return)
                    else: trap("WASM instruction was not validated")
            body.append(opcode_end)
            append_unsigned(entries, len(body))
            append_all(entries, body)
        return entries

# mark: LEB128 and byte plumbing ==============================================================

func append_section(output: list[u8], section_id: u8, payload: list[u8]):
    output.append(section_id)
    append_unsigned(output, len(payload))
    append_all(output, payload)

# Unsigned LEB128: seven value bits per byte, high bit says "more follows".
func append_unsigned(output: list[u8], number: i64):
    var value = number
    while value >= 0x80:
        output.append(u8(value & 0x7F | 0x80))
        value = value >> 7
    output.append(u8(value))

# Signed LEB128: same shape, but the sign lives in bit six of the last byte,
# so an extra byte is emitted when that bit would read as the wrong sign.
func append_signed(output: list[u8], number: i64):
    var value = number
    while true:
        var byte = value & 0x7F
        value = value >> 7
        let finished = (value == 0 and byte & 0x40 == 0) or (value == -1 and byte & 0x40 != 0)
        if not finished: byte = byte | 0x80
        output.append(u8(byte))
        if finished: return

func append_all(output: list[u8], values: list[u8]):
    for value in values:
        output.append(value)
