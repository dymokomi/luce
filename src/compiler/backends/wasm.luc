# mark: The encoder ===========================================================================

pub class WasmBackend:
    let clock: (func() -> i64)?

    pub init(clock: (func() -> i64)? = none):
        self.clock = clock

    ## Encode one canonical program as the bytes of a complete `.wasm` module.
    pub func emit(program: MirProgram) -> list[u8]!:
        return (try self.emit_with_report(program)).bytes

    pub func emit_with_report(program: MirProgram) -> BinaryEmission!:
        let plan = try plan_module(program)
        let output = list[u8]()
        # `\0asm`, then binary format version 1.
        append_all(output, [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00])
        append_section(output, type_section, encode_type_entries(plan))
        if len(plan.imports) > 0 or len(plan.global_imports) > 0:
            append_section(output, import_section, encode_import_entries(plan))
        append_section(output, function_section, encode_function_entries(program, plan))
        if plan.has_function_table:
            append_section(output, table_section, encode_table_entry(program, plan))
        if plan.has_memory:
            append_section(output, memory_section, encode_memory_entry(plan))
        if plan.has_stack:
            append_section(output, global_section, encode_global_entries())
        let exports = encode_export_entries(program, plan)
        # A lone leading count byte means "no exports"; write the section only
        # when something follows the count.
        if len(exports) > 1:
            append_section(output, export_section, exports)
        if plan.has_function_table:
            append_section(output, element_section, encode_element_entries(program, plan))
        let code = try encode_code_entries(program, plan, self.clock)
        append_section(output, code_section, code.bytes)
        if data_segment_count(program, plan) > 0:
            append_section(output, data_section, try encode_data_entries(program, plan))
        return BinaryEmission(bytes = output, functions = code.functions)

# mark: Sections ==============================================================================

# One `0x60` entry per distinct signature: parameter types, then result types.
func encode_type_entries(plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(plan.signatures))
    for signature in plan.signatures:
        entries.append(function_type_tag)
        append_unsigned(entries, len(signature.parameters))
        append_all(entries, signature.parameters)
        append_unsigned(entries, len(signature.results))
        append_all(entries, signature.results)
    return entries

# Function and global imports share one section but retain their independent
# WebAssembly index spaces. Functions are emitted first; external globals
# follow in canonical table order and are all mutable by language contract.
func encode_import_entries(plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(plan.imports) + len(plan.global_imports))
    for item in plan.imports:
        append_name(entries, item.module_name)
        append_name(entries, item.field_name)
        entries.append(function_import_kind)
        append_unsigned(entries, item.type_index)
    for item in plan.global_imports:
        append_name(entries, item.module_name)
        append_name(entries, item.field_name)
        entries.append(global_import_kind)
        entries.append(item.value_type)
        entries.append(global_mutable)
    return entries

# The function section only names each defined function's type index; the
# bodies come later in the code section, in the same order.
func encode_function_entries(program: MirProgram, plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    var count = len(program.functions)
    if has_start(plan): count += 1
    append_unsigned(entries, count)
    for type_index in plan.function_types:
        append_unsigned(entries, type_index)
    if has_start(plan): append_unsigned(entries, plan.start_type)
    return entries

# One funcref table. Defined functions occupy their canonical FunctionId
# slots; addressed C imports follow in first-address-use order. Keeping this
# artifact mapping here prevents table indices from leaking into MIR.
func encode_table_entry(program: MirProgram, plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, 1)
    entries.append(function_reference_type)
    entries.append(0x00) # minimum only
    append_unsigned(entries, len(program.functions) + len(plan.table_imports))
    return entries

# One memory with no maximum. The shadow stack occupies the first sixteen
# pages. When the sealed runtime requests its stable arena, that arena begins
# immediately above those pages and grows memory on demand.
func encode_memory_entry(plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, 1)
    entries.append(0x00)
    if plan.has_stack or plan.has_runtime_arena: append_unsigned(entries, stack_pages)
    else:
        var pages = (plan.data_end + page_size - 1) // page_size
        if pages < 1: pages = 1
        append_unsigned(entries, pages)
    return entries

# One mutable i32 global — the shadow stack pointer — initialised to the top
# of the stack pages with the constant expression `i32.const top; end`.
func encode_global_entries() -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, 1)
    entries.append(i32_value_type)
    entries.append(global_mutable)
    entries.append(opcode_i32_const)
    append_signed(entries, stack_top)
    entries.append(opcode_end)
    return entries

# Package-public and explicitly exported functions use their canonical names.
# These remain distinct MIR facts: `pub` exposes the Wasm package API but is
# not a native ABI promise. Memory exports as `memory` and the entry wrapper as
# `_start`, the two names WASI looks for.
func encode_export_entries(program: MirProgram, plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    var export_count = 0
    for function in program.functions:
        if function.is_public or function.is_exported: export_count += 1
    if plan.has_memory: export_count += 1
    if has_start(plan): export_count += 1
    append_unsigned(entries, export_count)
    for index in range(0, len(program.functions)):
        let function = program.functions[index]
        if function.is_public or function.is_exported:
            append_name(entries, function.name)
            entries.append(function_export_kind)
            append_unsigned(entries, defined_function_index(plan, index))
    if plan.has_memory:
        append_name(entries, "memory")
        entries.append(memory_export_kind)
        append_unsigned(entries, 0)
    if has_start(plan):
        append_name(entries, "_start")
        entries.append(function_export_kind)
        append_unsigned(entries, start_function_index(program, plan))
    return entries

# One body per function: its local declarations, its frame prologue when it
# has slots, then its instructions.
func encode_code_entries(program: MirProgram, plan: ModulePlan, clock: (func() -> i64)?) -> BinaryEmission!:
    let entries = list[u8]()
    let emissions = list[FunctionEmission]()
    var count = len(program.functions)
    if has_start(plan): count += 1
    append_unsigned(entries, count)
    for function_index in range(0, len(program.functions)):
        let function = program.functions[function_index]
        let started = clock_ms(clock)
        let frame = plan_frame(program.types, plan.layout, function)
        let body = list[u8]()
        try encode_locals(program.types, function, frame, body)
        encode_prologue(frame, plan, body)
        try encode_body(program, plan, function, frame, function.body, body)
        # MIR only needs every path to terminate; wasm also needs the
        # function's result on the stack at its final `end`. A body whose
        # last instruction is an `If` with returning arms leaves the stack
        # empty there, so close it with `unreachable`, which validates as
        # any type and can never execute.
        if not ends_in_return(function.body): body.append(opcode_unreachable)
        body.append(opcode_end)
        append_unsigned(entries, len(body))
        append_all(entries, body)
        emissions.append(FunctionEmission(
            function = FunctionId(value = u32(function_index)),
            code_bytes = u64(len(body)),
            codegen_time_ms = elapsed_ms(clock, started),
        ))
    if has_start(plan):
        let body = try encode_start_body(program, plan)
        append_unsigned(entries, len(body))
        append_all(entries, body)
    return BinaryEmission(bytes = entries, functions = emissions)

func clock_ms(clock: (func() -> i64)?) -> i64:
    if clock == none: return 0
    return clock()

func elapsed_ms(clock: (func() -> i64)?, start: i64) -> i64:
    if clock == none: return 0
    let elapsed = clock_ms(clock) - start
    if elapsed < 0: return 0
    return elapsed

func ends_in_return(body: list[MirInstruction]) -> bool:
    if len(body) == 0: return false
    match body[len(body) - 1].form:
        Return(values): return true
        Unreachable: return true
        Trap(reason): return true
        else: return false

# mark: Process entry ========================================================================

# One active data segment per item, placed into memory 0 at its packed offset
# when the module is instantiated.
func encode_data_entries(program: MirProgram, plan: ModulePlan) -> list[u8]!:
    let entries = list[u8]()
    append_unsigned(entries, data_segment_count(program, plan))
    for index in range(0, len(plan.function_descriptor_offsets)):
        let offset = plan.function_descriptor_offsets[index]
        if offset < 0: continue
        entries.append(0x00)
        entries.append(opcode_i32_const)
        append_signed(entries, offset)
        entries.append(opcode_end)
        append_unsigned(entries, 8)
        append_fixed_u32(entries, index)
        append_fixed_u32(entries, 0)
    for index in range(0, len(program.conformances)):
        let conformance = program.conformances[index]
        entries.append(0x00)
        entries.append(opcode_i32_const)
        append_signed(entries, plan.conformance_offsets[index])
        entries.append(opcode_end)
        append_unsigned(entries, len(conformance.implementations) * plan.layout.pointer_size())
        for implementation in conformance.implementations:
            append_fixed_u32(entries, plan.function_descriptor_offsets[implementation.value])
    for index in range(0, len(program.data)):
        let item = program.data[index]
        entries.append(0x00)                # active segment in memory 0
        entries.append(opcode_i32_const)    # offset expression: `i32.const offset; end`
        append_signed(entries, plan.data_offsets[index])
        entries.append(opcode_end)
        append_unsigned(entries, len(item.bytes))
        append_all(entries, item.bytes)
    for index in range(0, len(program.globals)):
        let global = program.globals[index]
        let initial = global.initial
        if initial == none: continue
        let size = plan.layout.size_of(global.value_type)
        let payload = program.data[initial.value].bytes
        if len(payload) < size:
            error("wasm backend: initializer for global `" + global.name + "` is shorter than its type")
        entries.append(0x00)
        entries.append(opcode_i32_const)
        append_signed(entries, plan.global_offsets[index])
        entries.append(opcode_end)
        append_unsigned(entries, size)
        for offset in range(0, size): entries.append(payload[offset])
    return entries

func data_segment_count(program: MirProgram, plan: ModulePlan) -> i64:
    var count = len(program.data)
    for offset in plan.function_descriptor_offsets:
        if offset >= 0: count += 1
    count += len(program.conformances)
    for global in program.globals:
        if global.initial != none: count += 1
    return count

# Initialise defined-function slots first, then only addressed C imports. The
# runtime imports and synthetic `_start` wrapper are not source callable values.
func encode_element_entries(program: MirProgram, plan: ModulePlan) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, 1)
    entries.append(0x00)             # active segment for table 0
    entries.append(opcode_i32_const)
    append_signed(entries, 0)
    entries.append(opcode_end)
    append_unsigned(entries, len(program.functions) + len(plan.table_imports))
    for index in range(0, len(program.functions)):
        append_unsigned(entries, defined_function_index(plan, index))
    for import_index in plan.table_imports:
        append_unsigned(entries, import_index)
    return entries

# mark: Registers as locals ===================================================================
#
# Register `r{i}` is wasm local `i`. Parameters are the leading locals wasm
# declares implicitly; the remaining registers are declared here as runs of
# one value type, the compressed form the code section wants. A function
# with slots gets one extra i32 local after the registers: the frame pointer.

func encode_locals(types: MirTypeTable, function: MirFunction, frame: FramePlan, body: list[u8]) -> !:
    let parameter_count = len(function.signature.parameters)
    let runs = list[u8]()
    let run_counts = list[i64]()
    for index in range(parameter_count, len(function.registers)):
        let value_type = try wasm_value_type(types, function.registers[index])
        append_local_run(runs, run_counts, value_type)
    if frame.float16_scratch >= 0:
        for index in range(0, float16_i32_scratch_count): append_local_run(runs, run_counts, i32_value_type)
        for index in range(0, float16_i64_scratch_count): append_local_run(runs, run_counts, i64_value_type)
    # Even an all-zero-size frame needs an address local: `Alloca` still
    # names each logical slot, and all such addresses may equal the current
    # stack pointer because no byte can be read or written through them.
    if len(frame.slot_offsets) > 0: append_local_run(runs, run_counts, i32_value_type)
    append_unsigned(body, len(runs))
    for index in range(0, len(runs)):
        append_unsigned(body, run_counts[index])
        body.append(runs[index])

func append_local_run(runs: list[u8], run_counts: list[i64], value_type: u8):
    if len(runs) > 0 and runs[len(runs) - 1] == value_type:
        run_counts[len(run_counts) - 1] = run_counts[len(run_counts) - 1] + 1
    else:
        runs.append(value_type)
        run_counts.append(1)

# mark: The frame =============================================================================
#
# Slots live on a shadow stack in linear memory. A function with slots
# reserves a 16-byte-aligned frame in its prologue — `sp -= size; fp = sp` —
# and `Alloca slot` is `fp + offset`. Every `Return` gives the frame back:
# `sp = fp + size`. Functions without slots touch neither.

struct FramePlan:
    let slot_offsets: list[i64]
    let size: i64
    let frame_pointer_local: i64
    # Five backend-private i32 locals hold the pieces of an IEEE binary16
    # conversion. Five adjacent i64 locals prevent binary64 narrowing from
    # double-rounding through binary32. Both groups exist only in functions
    # whose MIR mentions Float(16).
    let float16_scratch: i64
    let float16_wide_scratch: i64

func plan_frame(types: MirTypeTable, layout: TypeLayout, function: MirFunction) -> FramePlan:
    let offsets = list[i64]()
    var offset = 0
    for slot in function.slots:
        offset = align_up(offset, layout.align_of(slot.value_type))
        offsets.append(offset)
        offset += layout.size_of(slot.value_type)
    var size = 0
    if len(function.slots) > 0: size = align_up(offset, frame_alignment)
    var float16_scratch = -1
    var float16_wide_scratch = -1
    var frame_pointer_local = len(function.registers)
    if function_uses_float16(types, function):
        float16_scratch = frame_pointer_local
        float16_wide_scratch = float16_scratch + float16_i32_scratch_count
        frame_pointer_local = float16_wide_scratch + float16_i64_scratch_count
    return FramePlan(
        slot_offsets = offsets,
        size = size,
        frame_pointer_local = frame_pointer_local,
        float16_scratch = float16_scratch,
        float16_wide_scratch = float16_wide_scratch,
    )

func function_uses_float16(types: MirTypeTable, function: MirFunction) -> bool:
    for value_type in function.registers:
        match mir_type(types, value_type):
            Float(bits):
                if bits == 16: return true
            else: pass
    return false

# `global.get sp; i32.const size; i32.sub; local.tee fp; global.set sp`,
# then the overflow guard: `local.get fp; i32.const data_end; i32.lt_u; if
# unreachable end`. The stack grows down toward the data, so a frame whose
# base would fall below the data's end is a stack overflow and traps.
func encode_prologue(frame: FramePlan, plan: ModulePlan, body: list[u8]):
    if len(frame.slot_offsets) == 0: return
    if frame.size == 0:
        body.append(opcode_global_get)
        append_unsigned(body, len(plan.global_imports))
        body.append(opcode_local_set)
        append_unsigned(body, frame.frame_pointer_local)
        return
    body.append(opcode_global_get)
    append_unsigned(body, len(plan.global_imports))
    append_constant(body, frame.size, false)
    body.append(opcode_i32_sub)
    body.append(opcode_local_tee)
    append_unsigned(body, frame.frame_pointer_local)
    body.append(opcode_global_set)
    append_unsigned(body, len(plan.global_imports))
    local_get_index(body, frame.frame_pointer_local)
    append_constant(body, plan.data_end, false)
    body.append(opcode_i32_lt_u)
    append_trap_if_true(body)

# `local.get fp; i32.const size; i32.add; global.set sp`
func encode_epilogue(frame: FramePlan, plan: ModulePlan, body: list[u8]):
    if frame.size == 0: return
    local_get_index(body, frame.frame_pointer_local)
    append_constant(body, frame.size, false)
    body.append(opcode_i32_add)
    body.append(opcode_global_set)
    append_unsigned(body, len(plan.global_imports))

# mark: Register kinds ========================================================================

# What the encoder needs to know about a register's type, decoded once.
struct Kind:
    let value_type: u8
    let bits: i64
    let is_signed: bool
    let is_int: bool
    let is_float: bool
    let is_wide: bool

func kind_of(types: MirTypeTable, id: TypeId) -> Kind!:
    let value_type = try wasm_value_type(types, id)
    match mir_type(types, id):
        Int(bits, is_signed):
            return Kind(value_type = value_type, bits = bits, is_signed = is_signed, is_int = true, is_float = false, is_wide = bits == 64)
        PointerInt(is_signed):
            # wasm32: a pointer-width integer is 32 bits wide (base.md §5.1).
            return Kind(value_type = value_type, bits = 32, is_signed = is_signed, is_int = true, is_float = false, is_wide = false)
        Float(bits):
            return Kind(value_type = value_type, bits = bits, is_signed = true, is_int = false, is_float = true, is_wide = bits == 64)
        Bool:
            return Kind(value_type = value_type, bits = 1, is_signed = false, is_int = false, is_float = false, is_wide = false)
        else:
            return Kind(value_type = value_type, bits = 32, is_signed = false, is_int = false, is_float = false, is_wide = false)

func register_kind(types: MirTypeTable, function: MirFunction, register: RegisterId) -> Kind!:
    return try kind_of(types, function.registers[register.value])

# The absent success value of a `Raise`. MIR permits at most one value result
# before the error pointer; it still has to occupy the target ABI's result
# position even though source code cannot observe it on the failure path.
func append_default_value(body: list[u8], types: MirTypeTable, value_type: TypeId) -> !:
    let kind = try kind_of(types, value_type)
    if kind.is_float:
        if kind.is_wide: append_f64_constant(body, 0.0)
        else: append_f32_constant(body, 0.0)
        return
    append_constant(body, 0, kind.is_wide)

# A narrow integer is any width below 32, plus u32, whose top bit is not
# a sign inside its i32 local.
func is_narrow(kind: Kind) -> bool:
    return kind.is_int and kind.bits < 32

# Bring the i32 on the stack back to the canonical form for a narrow type:
# sign-extend i8/i16, mask u8/u16. Wider types are canonical already.
func append_canonicalise(body: list[u8], kind: Kind):
    if not is_narrow(kind): return
    if kind.is_signed:
        if kind.bits == 8: body.append(opcode_i32_extend8_s)
        else: body.append(opcode_i32_extend16_s)
    else:
        append_constant(body, narrow_mask(kind), false)
        body.append(opcode_i32_and)

func narrow_mask(kind: Kind) -> i64:
    if kind.bits == 8: return 0xFF
    return 0xFFFF

# mark: Instructions ==========================================================================

# One enclosing MIR region while a body is encoded: the registers a branch
# or `Yield` to it must set, and whether it is a `Loop`.
#
# Depth invariant: every MIR region (`Block`, `Loop`, `If`) becomes exactly
# one wasm structured instruction, and an `If` is a label in wasm just as it
# is a region in MIR, so a MIR depth is the wasm label depth unchanged. No
# helper below may wrap code in an extra `block`, or every `br` inside it
# would be off by one.
struct Region:
    let results: RegisterRun
    let is_loop: bool

# Encode one flat body. The MIR region instructions map one-to-one onto
# wasm's: `Block`/`Loop`/`If` open, `Else` separates, `End` closes. Region
# results travel through locals, so every wasm block has the empty type. A
# `Yield` that ends an arm falls through to the arm's `else`/`end`; one in
# the middle branches to it.
func encode_body(program: MirProgram, plan: ModulePlan, function: MirFunction, frame: FramePlan, instructions: list[MirInstruction], body: list[u8]) -> !:
    let regions = list[Region]()
    for index in range(0, len(instructions)):
        let instruction = instructions[index]
        match instruction.form:
            Block(results):
                body.append(opcode_block)
                body.append(empty_block_type)
                regions.append(Region(results = results, is_loop = false))
            Loop:
                # A branch to a `loop` label restarts it; falling off its end
                # leaves it, in wasm exactly as in MIR.
                body.append(opcode_loop)
                body.append(empty_block_type)
                regions.append(Region(results = no_registers(), is_loop = true))
            If(condition, results):
                local_get(body, condition)
                body.append(opcode_if)
                body.append(empty_block_type)
                regions.append(Region(results = results, is_loop = false))
            Else:
                body.append(opcode_else)
            End:
                body.append(opcode_end)
                regions.remove(len(regions) - 1)
            Switch(tag): error("wasm backend does not support `Switch` yet")
            Case(value): error("wasm backend does not support `Switch` yet")
            Default: error("wasm backend does not support `Switch` yet")
            Yield(values):
                let target = try region_at(regions, 0)
                if target.is_loop: error("wasm backend does not support `Yield` inside a `Loop`")
                try set_region_results(body, function, target, values, "`Yield`")
                if not next_closes_arm(instructions, index):
                    body.append(opcode_br)
                    append_unsigned(body, 0)
            else: try encode_instruction(program, plan, function, frame, instruction, regions, body)

# Is the instruction after `index` the `Else` or `End` of the current arm?
func next_closes_arm(instructions: list[MirInstruction], index: i64) -> bool:
    if index + 1 >= len(instructions): return false
    match instructions[index + 1].form:
        Else: return true
        End: return true
        else: return false

func encode_instruction(program: MirProgram, plan: ModulePlan, function: MirFunction, frame: FramePlan, instruction: MirInstruction, regions: list[Region], body: list[u8]) -> !:
    let types = program.types
    match instruction.form:
        Const(result, value):
            let kind = try register_kind(types, function, result)
            let pointer_width = is_pointer_int_type(types, function.registers[result.value])
            match value:
                SignedInt(item):
                    if pointer_width and (item < -2147483647 - 1 or item > 2147483647):
                        error("wasm backend: constant " + str(item) + " does not fit `isize`, which is 32 bits wide on wasm32 (base.md §5.1)")
                    append_constant(body, item, kind.is_wide)
                UnsignedInt(item):
                    if pointer_width and item > u64(4294967295):
                        error("wasm backend: constant " + str(item) + " does not fit `usize`, which is 32 bits wide on wasm32 (base.md §5.1)")
                    append_constant(body, unsigned_wasm_immediate(item, kind.is_wide), kind.is_wide)
                Bool(item):
                    if item: append_constant(body, 1, false)
                    else: append_constant(body, 0, false)
                Null: append_constant(body, 0, false)
                Float(item):
                    if kind.bits == 16:
                        append_f64_constant(body, item)
                        append_float64_to_float16_bits(body, frame.float16_wide_scratch)
                        append_float16_value(body, frame.float16_scratch)
                    elif kind.is_wide: append_f64_constant(body, item)
                    else:
                        append_f32_constant(body, item)
            local_set(body, result)
        Copy(result, source):
            local_get(body, source)
            local_set(body, result)
        Binary(result, operation, left, right):
            let kind = try register_kind(types, function, left)
            try encode_binary(body, operation, kind, frame, result, left, right)
        Unary(result, operation, operand):
            let kind = try register_kind(types, function, operand)
            try encode_unary(body, operation, kind, frame, result, operand)
        Convert(result, operation, operand):
            let from = try register_kind(types, function, operand)
            let to = try register_kind(types, function, result)
            try encode_convert(body, operation, from, to, frame, result, operand)
        FloatBits(result, operand):
            let from = try register_kind(types, function, operand)
            local_get(body, operand)
            if from.bits == 16:
                append_float16_bits(body, frame.float16_scratch)
                body.append(opcode_i64_extend_i32_u)
            elif from.is_wide: body.append(opcode_i64_reinterpret_f64)
            else:
                body.append(opcode_i32_reinterpret_f32)
                body.append(opcode_i64_extend_i32_u)
            local_set(body, result)
        PointerDifference(result, element_type, left, right):
            local_get(body, left)
            local_get(body, right)
            body.append(opcode_i32_sub)
            append_constant(body, plan.layout.size_of(element_type), false)
            body.append(opcode_i32_div_s)
            local_set(body, result)
        PointerHash(result, operand):
            local_get(body, operand)
            body.append(opcode_i64_extend_i32_u)
            append_constant(body, -7046029254386353131, true)
            body.append(opcode_i64_xor)
            body.append(opcode_local_tee)
            append_unsigned(body, i64(result.value))
            local_get(body, result)
            append_constant(body, 33, true)
            body.append(opcode_i64_shr_u)
            body.append(opcode_i64_xor)
            local_set(body, result)
        LayoutConstant(result, query, subject, field):
            append_constant(body, plan.layout.answer(query, subject, field), false)
            local_set(body, result)
        Alloca(result, slot):
            # `fp + offset`
            local_get_index(body, frame.frame_pointer_local)
            append_constant(body, frame.slot_offsets[slot], false)
            body.append(opcode_i32_add)
            local_set(body, result)
        AllocateStorage(result, element_type, count):
            try encode_allocate_storage(program, plan, body, result, element_type, count)
        DeallocateStorage(address, element_type, count):
            try encode_deallocate_storage(program, plan, body, address, element_type, count)
        BufferRetain(value):
            let service = find_runtime_binding(program, RuntimeService.buffer_retain) else error("wasm backend: verified `BufferRetain` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        BufferRelease(value):
            let service = find_runtime_binding(program, RuntimeService.buffer_release) else error("wasm backend: verified `BufferRelease` has no runtime binding")
            local_get(body, value)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        BufferConcat(result, left_data, left_length, right_data, right_length):
            let service = find_runtime_binding(program, RuntimeService.buffer_concat) else error("wasm backend: verified `BufferConcat` has no runtime binding")
            local_get(body, left_data)
            local_get(body, left_length)
            local_get(body, right_data)
            local_get(body, right_length)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        BufferData(result, owner):
            let service = find_runtime_binding(program, RuntimeService.buffer_data) else error("wasm backend: verified `BufferData` has no runtime binding")
            local_get(body, owner)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        BufferLength(result, owner):
            let service = find_runtime_binding(program, RuntimeService.buffer_length) else error("wasm backend: verified `BufferLength` has no runtime binding")
            local_get(body, owner)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        BufferBuilderCreate(result):
            let service = find_runtime_binding(program, RuntimeService.buffer_builder_create) else error("wasm backend: verified `BufferBuilderCreate` has no runtime binding")
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        BufferBuilderAppend(builder, data, length):
            let service = find_runtime_binding(program, RuntimeService.buffer_builder_append) else error("wasm backend: verified `BufferBuilderAppend` has no runtime binding")
            local_get(body, builder)
            local_get(body, data)
            local_get(body, length)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
        BufferBuilderFinish(result, builder):
            let service = find_runtime_binding(program, RuntimeService.buffer_builder_finish) else error("wasm backend: verified `BufferBuilderFinish` has no runtime binding")
            local_get(body, builder)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        CStringCopy(result, source):
            let service = find_runtime_binding(program, RuntimeService.c_string_copy) else error("wasm backend: verified `CStringCopy` has no runtime binding")
            local_get(body, source)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        DisplaySigned(result, value): encode_display_call(program, plan, body, result, value, RuntimeService.display_signed)
        DisplayUnsigned(result, value): encode_display_call(program, plan, body, result, value, RuntimeService.display_unsigned)
        DisplayFloat(result, value):
            if bits_of(types, function.registers[value.value]) == 32:
                encode_display_call(program, plan, body, result, value, RuntimeService.display_float32)
            else:
                encode_display_call(program, plan, body, result, value, RuntimeService.display_float64)
        DisplayCharacter(result, value): encode_display_call(program, plan, body, result, value, RuntimeService.display_character)
        DisplayBoolean(result, value): encode_display_call(program, plan, body, result, value, RuntimeService.display_boolean)
        StringScalarCount(result, data, length):
            let service = find_runtime_binding(program, RuntimeService.string_scalar_count) else error("wasm backend: verified `StringScalarCount` has no runtime binding")
            local_get(body, data)
            local_get(body, length)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, result)
        StringDecode(character, width, data, length, offset):
            let service = find_runtime_binding(program, RuntimeService.string_decode) else error("wasm backend: verified `StringDecode` has no runtime binding")
            local_get(body, data)
            local_get(body, length)
            local_get(body, offset)
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(service.value)))
            local_set(body, width)
            local_get(body, width)
            body.append(opcode_i32_wrap_i64)
            local_set(body, character)
            local_get(body, width)
            append_constant(body, 32, true)
            body.append(opcode_i64_shr_u)
            local_set(body, width)
        Load(result, value_type, address):
            let kind = try kind_of(types, value_type)
            local_get(body, address)
            append_load(body, kind, frame)
            local_set(body, result)
        Store(value_type, address, value):
            let kind = try kind_of(types, value_type)
            local_get(body, address)
            local_get(body, value)
            append_store(body, kind, frame)
        FieldAddress(result, struct_type, base, field):
            # `base + offset`, computed under WebAssembly's layout rules.
            match mir_type(types, struct_type):
                Struct(fields):
                    local_get(body, base)
                    append_constant(body, plan.layout.field_offset(struct_type, field), false)
                    body.append(opcode_i32_add)
                    local_set(body, result)
                else: error("wasm backend: `FieldAddress` on a non-struct type")
        EnumPayloadAddress(result, enum_type, base):
            local_get(body, base)
            append_constant(body, plan.layout.enum_payload_offset(enum_type), false)
            body.append(opcode_i32_add)
            local_set(body, result)
        ElementAddress(result, element_type, base, index):
            # `base + index * stride`; a 64-bit index is wrapped, which is
            # exact for any address inside a 32-bit memory.
            let index_kind = try register_kind(types, function, index)
            local_get(body, base)
            local_get(body, index)
            if index_kind.is_wide: body.append(opcode_i32_wrap_i64)
            append_constant(body, plan.layout.size_of(element_type), false)
            body.append(opcode_i32_mul)
            body.append(opcode_i32_add)
            local_set(body, result)
        Memcpy(destination, source, value_type):
            local_get(body, destination)
            local_get(body, source)
            append_constant(body, plan.layout.size_of(value_type), false)
            body.append(opcode_prefix_fc)
            body.append(subopcode_memory_copy)
            body.append(0)
            body.append(0)
        Zero(address, value_type):
            # `memory.fill address, 0, size`.
            local_get(body, address)
            append_constant(body, 0, false)
            append_constant(body, plan.layout.size_of(value_type), false)
            body.append(opcode_prefix_fc)
            body.append(subopcode_memory_fill)
            body.append(0)
        MoveElements(destination, source, element_type, count):
            try encode_move_elements(plan, body, destination, source, element_type, count)
        DataAddress(result, data):
            append_constant(body, plan.data_offsets[data.value], false)
            local_set(body, result)
        GlobalAddress(result, global):
            append_constant(body, plan.global_offsets[global.value], false)
            local_set(body, result)
        LoadExternalGlobal(result, global):
            body.append(opcode_global_get)
            append_unsigned(body, i64(global.value))
            append_canonicalise(body, try register_kind(types, function, result))
            local_set(body, result)
        StoreExternalGlobal(global, value):
            local_get(body, value)
            body.append(opcode_global_set)
            append_unsigned(body, i64(global.value))
        FunctionAddress(result, target):
            # The element segment preserves FunctionId order exactly.
            append_constant(body, i64(target.value), false)
            local_set(body, result)
        ExternAddress(result, target):
            var table_slot = -1
            let import_index = plan.external_imports[target.value]
            for index in range(0, len(plan.table_imports)):
                if plan.table_imports[index] == import_index: table_slot = index
            if table_slot < 0: trap("module plan omitted an extern-address table slot")
            append_constant(body, len(program.functions) + table_slot, false)
            local_set(body, result)
        FunctionNull(destination, function_type):
            encode_function_value(body, destination, none, none)
        FunctionValue(destination, function_type, target):
            encode_function_value(body, destination, target, none)
        Call(results, target, arguments):
            # Direct call: arguments in order, the callee's index in the
            # function index space, then results popped into their locals.
            # WebAssembly leaves the last result on top, so stores are
            # necessarily reversed for a fallible two-result call.
            for index in range(0, i64(arguments.count)):
                local_get(body, register_at(function, arguments, index))
            body.append(opcode_call)
            append_unsigned(body, defined_function_index(plan, i64(target.value)))
            var index = i64(results.count) - 1
            while index >= 0:
                local_set(body, register_at(function, results, index))
                index -= 1
        CallIndirect(results, signature, convention, target, arguments):
            for index in range(0, i64(arguments.count)):
                local_get(body, register_at(function, arguments, index))
            local_get(body, target)
            body.append(opcode_call_indirect)
            append_unsigned(body, signature_index(plan.signatures, try wasm_signature(types, signature)))
            append_unsigned(body, 0) # table index
            var index = i64(results.count) - 1
            while index >= 0:
                local_set(body, register_at(function, results, index))
                index -= 1
        CallExtern(results, external, arguments):
            let declaration = program.externs[external.value]
            if declaration.convention == CallingConvention.runtime and declaration.name == "luce_rt_arena":
                try encode_runtime_arena(function, body, results, arguments)
            else:
                let import_index = plan.external_imports[external.value]
                if import_index < 0: error("wasm backend has no import for extern " + str(external.value))
                match declaration.convention:
                    runtime:
                        # Host-facing runtime services are legalized to their
                        # Wasm contracts. The arena above is backend-provided.
                        if declaration.name == "luce_rt_write":
                            encode_write(body, import_index, wasi_stdout, register_at(function, arguments, 0), register_at(function, arguments, 1))
                        elif declaration.name == "luce_rt_trap":
                            encode_write(body, import_index, wasi_stderr, register_at(function, arguments, 0), register_at(function, arguments, 1))
                            encode_trap_newline(body, import_index)
                            body.append(opcode_unreachable)
                        else:
                            error("wasm backend does not implement runtime service `" + declaration.name + "`")
                    c:
                        for index in range(0, i64(arguments.count)):
                            local_get(body, register_at(function, arguments, index))
                        body.append(opcode_call)
                        append_unsigned(body, import_index)
                        # Multi-results leave the last value on top. Restore MIR
                        # locals in reverse and canonicalize narrow C integers.
                        var index = i64(results.count) - 1
                        while index >= 0:
                            let result = register_at(function, results, index)
                            append_canonicalise(body, try register_kind(types, function, result))
                            local_set(body, result)
                            index -= 1
                    else: error("wasm backend found a Luce-convention extern call")
        Br(depth, values):
            let target = try region_at(regions, depth)
            try set_region_results(body, function, target, values, "`Br`")
            body.append(opcode_br)
            append_unsigned(body, depth)
        BrIf(condition, depth, values):
            let target = try region_at(regions, depth)
            if values.count == 0:
                local_get(body, condition)
                body.append(opcode_br_if)
                append_unsigned(body, depth)
            else:
                # The sets must happen only when the branch is taken, so
                # they live inside an `if`, which adds one label: `depth + 1`.
                local_get(body, condition)
                body.append(opcode_if)
                body.append(empty_block_type)
                try set_region_results(body, function, target, values, "`BrIf`")
                body.append(opcode_br)
                append_unsigned(body, depth + 1)
                body.append(opcode_end)
        Return(values):
            encode_epilogue(frame, plan, body)
            for index in range(0, i64(values.count)):
                local_get(body, register_at(function, values, index))
            body.append(opcode_return)
        Raise(failure):
            # Value results are absent on failure. The final result is the
            # caller-owned error slot that r0 names by MIR invariant.
            encode_epilogue(frame, plan, body)
            for index in range(0, len(function.signature.results) - 1):
                try append_default_value(body, types, function.signature.results[index])
            local_get(body, failure)
            body.append(opcode_return)
        Trap(reason):
            body.append(opcode_unreachable)
        Unreachable:
            body.append(opcode_unreachable)
        else:
            if not try encode_runtime_instruction(program, plan, function, instruction, body):
                error("wasm backend does not support `" + str(instruction.form) + "` yet")

# The sealed arena is a backend capability, not a WASI import. Its stable base
# is the first byte above the shadow-stack reservation. Each request grows the
# one linear memory to cover the requested prefix and traps cleanly when the
# Wasm32 address space or host memory cannot satisfy it.
func encode_runtime_arena(function: MirFunction, body: list[u8], results: RegisterRun, arguments: RegisterRun) -> !:
    if results.count != 1 or arguments.count != 1:
        error("wasm backend: verified arena service has an invalid call shape")
    let requested_end = register_at(function, arguments, 0)
    let result = register_at(function, results, 0)
    let maximum_prefix = 4294967296 - stack_top

    local_get(body, requested_end)
    append_constant(body, maximum_prefix, true)
    body.append(opcode_i64_gt_u)
    append_trap_if_true(body)

    # required_pages = ceil((stack_top + requested_end) / 64 KiB)
    local_get(body, requested_end)
    append_constant(body, stack_top + page_size - 1, true)
    body.append(opcode_i64_add)
    append_constant(body, 16, true)
    body.append(opcode_i64_shr_u)
    body.append(opcode_i32_wrap_i64)
    body.append(opcode_local_tee)
    append_unsigned(body, i64(result.value))
    body.append(opcode_memory_size)
    body.append(0)
    body.append(opcode_i32_gt_u)
    body.append(opcode_if)
    body.append(empty_block_type)
    local_get(body, result)
    body.append(opcode_memory_size)
    body.append(0)
    body.append(opcode_i32_sub)
    body.append(opcode_memory_grow)
    body.append(0)
    append_constant(body, -1, false)
    body.append(opcode_i32_eq)
    append_trap_if_true(body)
    body.append(opcode_end)

    append_constant(body, stack_top, false)
    local_set(body, result)

# `count == 0 ? null : allocator(count * size, align)`. Wasm arithmetic
# wraps, so the multiplication is guarded before it is emitted. The bound
# allocator is an ordinary composed MIR function and therefore uses the
# defined-function index space, never a host import or symbol lookup.
func encode_allocate_storage(program: MirProgram, plan: ModulePlan, body: list[u8], result: RegisterId, element_type: TypeId, count: RegisterId) -> !:
    let allocator = find_runtime_binding(program, RuntimeService.storage_allocator) else error("wasm backend: verified `AllocateStorage` has no runtime binding")
    local_get(body, count)
    body.append(opcode_i64_eqz)
    body.append(opcode_if)
    body.append(empty_block_type)
    append_constant(body, 0, false)
    local_set(body, result)
    body.append(opcode_else)

    let element_size = plan.layout.size_of(element_type)
    if element_size == 0:
        append_constant(body, 1, true)
    else:
        if element_size > 1:
            local_get(body, count)
            append_constant(body, 9223372036854775807 // element_size, true)
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
        local_get(body, count)
        if element_size > 1:
            append_constant(body, element_size, true)
            body.append(opcode_i64_mul)
    let alignment = storage_alignment(plan, element_type)
    append_constant(body, alignment, true)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(allocator.value)))
    local_set(body, result)
    body.append(opcode_end)

# Release a positive typed allocation through the same byte-count and
# pointer-alignment legalization as `AllocateStorage`. A zero element count is
# the inert null allocation and performs no runtime call.
func encode_deallocate_storage(program: MirProgram, plan: ModulePlan, body: list[u8], address: RegisterId, element_type: TypeId, count: RegisterId) -> !:
    let deallocator = find_runtime_binding(program, RuntimeService.storage_deallocator) else error("wasm backend: verified `DeallocateStorage` has no runtime binding")
    local_get(body, count)
    body.append(opcode_i64_eqz)
    body.append(opcode_if)
    body.append(empty_block_type)
    body.append(opcode_else)

    local_get(body, address)
    let element_size = plan.layout.size_of(element_type)
    if element_size == 0:
        append_constant(body, 1, true)
    else:
        if element_size > 1:
            local_get(body, count)
            append_constant(body, 9223372036854775807 // element_size, true)
            body.append(opcode_i64_gt_u)
            append_trap_if_true(body)
        local_get(body, count)
        if element_size > 1:
            append_constant(body, element_size, true)
            body.append(opcode_i64_mul)
    let alignment = storage_alignment(plan, element_type)
    append_constant(body, alignment, true)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(deallocator.value)))
    body.append(opcode_end)

func encode_display_call(program: MirProgram, plan: ModulePlan, body: list[u8], result: RegisterId, value: RegisterId, service: RuntimeService):
    let target = find_runtime_binding(program, service) else trap("verified display operation has no runtime binding")
    local_get(body, value)
    body.append(opcode_call)
    append_unsigned(body, defined_function_index(plan, i64(target.value)))
    local_set(body, result)

# `memory.copy` already has overlap-safe move semantics. Its byte count is an
# i32, however, while canonical MIR deliberately retains a u64 element count.
# Prove that the backend-computed byte count fits WebAssembly's address space
# before narrowing it; a zero-sized element has no bytes to move.
func encode_move_elements(plan: ModulePlan, body: list[u8], destination: RegisterId, source: RegisterId, element_type: TypeId, count: RegisterId) -> !:
    let element_size = plan.layout.size_of(element_type)
    if element_size == 0: return

    local_get(body, count)
    append_constant(body, 4294967295 // element_size, true)
    body.append(opcode_i64_gt_u)
    append_trap_if_true(body)

    local_get(body, destination)
    local_get(body, source)
    local_get(body, count)
    if element_size > 1:
        append_constant(body, element_size, true)
        body.append(opcode_i64_mul)
    body.append(opcode_i32_wrap_i64)
    body.append(opcode_prefix_fc)
    body.append(subopcode_memory_copy)
    body.append(0)
    body.append(0)

# The region `depth` levels out, innermost first.
func region_at(regions: list[Region], depth: i64) -> Region!:
    if depth < 0 or depth >= len(regions): error("wasm backend found a branch to depth " + str(depth) + " with " + str(len(regions)) + " enclosing region(s)")
    return regions[len(regions) - 1 - depth]

# Hand `values` to a region's result locals before leaving toward it.
func set_region_results(body: list[u8], function: MirFunction, target: Region, values: RegisterRun, what: str) -> !:
    if values.count != target.results.count: error("wasm backend found " + what + " with " + str(values.count) + " value(s) for " + str(target.results.count) + " result(s)")
    for index in range(0, i64(values.count)):
        local_get(body, register_at(function, values, index))
        local_set(body, register_at(function, target.results, index))

# mark: Memory access =========================================================================
#
# Loads widen narrow values into their canonical i32 form on the way in
# (`load8_s` for i8, `load8_u` for u8, ...); stores keep only the low bytes.
# The memarg is alignment (log2 of the natural size) and offset 0.

func append_load(body: list[u8], kind: Kind, frame: FramePlan):
    if kind.is_float:
        if kind.bits == 16:
            append_memory_op(body, opcode_i32_load16_u, 1)
            append_float16_value(body, frame.float16_scratch)
        elif kind.is_wide: append_memory_op(body, opcode_f64_load, 3)
        else: append_memory_op(body, opcode_f32_load, 2)
    elif kind.is_int:
        if kind.bits == 64: append_memory_op(body, opcode_i64_load, 3)
        elif kind.bits == 32: append_memory_op(body, opcode_i32_load, 2)
        elif kind.bits == 16:
            if kind.is_signed: append_memory_op(body, opcode_i32_load16_s, 1)
            else: append_memory_op(body, opcode_i32_load16_u, 1)
        else:
            if kind.is_signed: append_memory_op(body, opcode_i32_load8_s, 0)
            else: append_memory_op(body, opcode_i32_load8_u, 0)
    elif kind.bits == 1:
        append_memory_op(body, opcode_i32_load8_u, 0)
    else:
        append_memory_op(body, opcode_i32_load, 2)

func append_store(body: list[u8], kind: Kind, frame: FramePlan):
    if kind.is_float:
        if kind.bits == 16:
            append_float16_bits(body, frame.float16_scratch)
            append_memory_op(body, opcode_i32_store16, 1)
        elif kind.is_wide: append_memory_op(body, opcode_f64_store, 3)
        else: append_memory_op(body, opcode_f32_store, 2)
    elif kind.is_int:
        if kind.bits == 64: append_memory_op(body, opcode_i64_store, 3)
        elif kind.bits == 32: append_memory_op(body, opcode_i32_store, 2)
        elif kind.bits == 16: append_memory_op(body, opcode_i32_store16, 1)
        else: append_memory_op(body, opcode_i32_store8, 0)
    elif kind.bits == 1:
        append_memory_op(body, opcode_i32_store8, 0)
    else:
        append_memory_op(body, opcode_i32_store, 2)

# mark: WASI write ============================================================================

# `luce_rt_write`/`luce_rt_trap` as `fd_write(fd, iovs, 1, nwritten)`:
# fill the scratch iovec with the pointer and the wrapped length, call, and
# drop the errno — a failed diagnostic write has nowhere else to be reported.
func encode_write(body: list[u8], import_index: i64, descriptor: i64, pointer: RegisterId, length: RegisterId):
    append_constant(body, scratch_iovec_buffer, false)
    local_get(body, pointer)
    append_memory_op(body, opcode_i32_store, 2)
    append_constant(body, scratch_iovec_length, false)
    local_get(body, length)
    body.append(opcode_i32_wrap_i64)
    append_memory_op(body, opcode_i32_store, 2)
    append_constant(body, descriptor, false)
    append_constant(body, scratch_iovec_buffer, false)
    append_constant(body, 1, false)
    append_constant(body, scratch_written, false)
    body.append(opcode_call)
    append_unsigned(body, import_index)
    body.append(opcode_drop)

func encode_trap_newline(body: list[u8], import_index: i64):
    append_constant(body, scratch_trap_newline, false)
    append_constant(body, 10, false)
    append_memory_op(body, opcode_i32_store8, 0)
    append_constant(body, scratch_iovec_buffer, false)
    append_constant(body, scratch_trap_newline, false)
    append_memory_op(body, opcode_i32_store, 2)
    append_constant(body, scratch_iovec_length, false)
    append_constant(body, 1, false)
    append_memory_op(body, opcode_i32_store, 2)
    append_constant(body, wasi_stderr, false)
    append_constant(body, scratch_iovec_buffer, false)
    append_constant(body, 1, false)
    append_constant(body, scratch_written, false)
    body.append(opcode_call)
    append_unsigned(body, import_index)
    body.append(opcode_drop)

# mark: Binary operations =====================================================================

func encode_binary(body: list[u8], operation: BinaryOp, kind: Kind, frame: FramePlan, result: RegisterId, left: RegisterId, right: RegisterId) -> !:
    if kind.is_float:
        encode_float_binary(body, operation, kind, frame, result, left, right)
        return
    if operation == BinaryOp.add or operation == BinaryOp.sub or operation == BinaryOp.mul:
        encode_checked_arithmetic(body, operation, kind, result, left, right)
    elif operation == BinaryOp.floor_div:
        encode_floor_div(body, kind, result, left, right)
    elif operation == BinaryOp.rem:
        encode_rem(body, kind, result, left, right)
    elif operation == BinaryOp.trunc_div or operation == BinaryOp.trunc_rem:
        encode_trunc_division(body, operation, kind, result, left, right)
    elif operation == BinaryOp.add_wrap or operation == BinaryOp.sub_wrap or operation == BinaryOp.mul_wrap:
        encode_wrapping_arithmetic(body, operation, kind, result, left, right)
    elif operation == BinaryOp.add_overflows or operation == BinaryOp.sub_overflows or operation == BinaryOp.mul_overflows:
        append_overflow_flag(body, overflow_operation(operation), kind, left, right)
        local_set(body, result)
    elif operation == BinaryOp.add_sat or operation == BinaryOp.sub_sat or operation == BinaryOp.mul_sat:
        encode_saturating_arithmetic(body, overflow_operation(operation), kind, result, left, right)
    elif operation == BinaryOp.shift_left or operation == BinaryOp.shift_right:
        encode_shift(body, operation, kind, result, left, right)
    elif operation == BinaryOp.bit_and or operation == BinaryOp.bit_or or operation == BinaryOp.bit_xor:
        local_get(body, left)
        local_get(body, right)
        if operation == BinaryOp.bit_and: body.append(pick(kind.is_wide, opcode_i64_and, opcode_i32_and))
        elif operation == BinaryOp.bit_or: body.append(pick(kind.is_wide, opcode_i64_or, opcode_i32_or))
        else: body.append(pick(kind.is_wide, opcode_i64_xor, opcode_i32_xor))
        local_set(body, result)
    elif operation == BinaryOp.div:
        error("wasm backend found `div` on an integer; the verifier admits it only for floats")
    else:
        # Comparisons: every operand kind that reaches here (ints, bool, ptr)
        # lives in an integer local; signedness picks the `_s`/`_u` form.
        local_get(body, left)
        local_get(body, right)
        body.append(integer_comparison_opcode(operation, kind))
        local_set(body, result)

func integer_comparison_opcode(operation: BinaryOp, kind: Kind) -> u8:
    let wide = kind.is_wide
    if operation == BinaryOp.eq: return pick(wide, opcode_i64_eq, opcode_i32_eq)
    if operation == BinaryOp.ne: return pick(wide, opcode_i64_ne, opcode_i32_ne)
    if kind.is_signed:
        if operation == BinaryOp.lt: return pick(wide, opcode_i64_lt_s, opcode_i32_lt_s)
        if operation == BinaryOp.le: return pick(wide, opcode_i64_le_s, opcode_i32_le_s)
        if operation == BinaryOp.gt: return pick(wide, opcode_i64_gt_s, opcode_i32_gt_s)
        return pick(wide, opcode_i64_ge_s, opcode_i32_ge_s)
    if operation == BinaryOp.lt: return pick(wide, opcode_i64_lt_u, opcode_i32_lt_u)
    if operation == BinaryOp.le: return pick(wide, opcode_i64_le_u, opcode_i32_le_u)
    if operation == BinaryOp.gt: return pick(wide, opcode_i64_gt_u, opcode_i32_gt_u)
    return pick(wide, opcode_i64_ge_u, opcode_i32_ge_u)

# Floats: wasm's IEEE operations are the language's; nothing to check.
func encode_float_binary(body: list[u8], operation: BinaryOp, kind: Kind, frame: FramePlan, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, left)
    local_get(body, right)
    if operation == BinaryOp.add: body.append(pick(wide, opcode_f64_add, opcode_f32_add))
    elif operation == BinaryOp.sub: body.append(pick(wide, opcode_f64_sub, opcode_f32_sub))
    elif operation == BinaryOp.mul: body.append(pick(wide, opcode_f64_mul, opcode_f32_mul))
    elif operation == BinaryOp.div: body.append(pick(wide, opcode_f64_div, opcode_f32_div))
    elif operation == BinaryOp.eq: body.append(pick(wide, opcode_f64_eq, opcode_f32_eq))
    elif operation == BinaryOp.ne: body.append(pick(wide, opcode_f64_ne, opcode_f32_ne))
    elif operation == BinaryOp.lt: body.append(pick(wide, opcode_f64_lt, opcode_f32_lt))
    elif operation == BinaryOp.le: body.append(pick(wide, opcode_f64_le, opcode_f32_le))
    elif operation == BinaryOp.gt: body.append(pick(wide, opcode_f64_gt, opcode_f32_gt))
    else: body.append(pick(wide, opcode_f64_ge, opcode_f32_ge))
    if kind.bits == 16 and (operation == BinaryOp.add or operation == BinaryOp.sub or operation == BinaryOp.mul or operation == BinaryOp.div):
        append_float16_round(body, frame.float16_scratch)
    local_set(body, result)

# mark: Checked arithmetic ====================================================================
#
# Wasm integer arithmetic wraps; MIR's traps on overflow (language section
# 7). Four shapes cover every width:
#
#   i32, i64   compute in the native width, then detect signed or unsigned
#              wrap from the operands and result (`encode_checked_*`);
#   i8..u16    compute in i32, where the true result always fits, then trap
#              if it is outside the type's range — a value in range is
#              already canonical;
#   u32        compute in i64, where the true result always fits, trap if it
#              is above 0xFFFFFFFF or below zero, then wrap to i32;
#   u64        compute in i64 machine bits and use unsigned carry, borrow, or
#              quotient checks; the sign bit has no semantic significance.

func encode_checked_arithmetic(body: list[u8], operation: BinaryOp, kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    if is_narrow(kind):
        local_get(body, left)
        local_get(body, right)
        body.append(narrow_arithmetic_opcode(operation))
        local_set(body, result)
        append_range_trap(body, result, kind)
        return
    if kind.bits == 32 and not kind.is_signed:
        encode_u32_arithmetic(body, operation, result, left, right)
        return
    if kind.is_wide and not kind.is_signed:
        encode_u64_arithmetic(body, operation, result, left, right)
        return
    if operation == BinaryOp.add: encode_checked_add(body, result, left, right, kind.is_wide)
    elif operation == BinaryOp.sub: encode_checked_sub(body, result, left, right, kind.is_wide)
    else: encode_checked_mul(body, result, left, right, kind.is_wide)

# mark: Overflow without trapping =============================================================
#
# Base's `+%`, `+|`, and `+?` (base.md §7.2) observe overflow instead of
# trapping on it. The wrapped value is the machine's own result; the overflow
# flag is the same condition the checked forms trap on, left as an i32 on the
# stack without any local, so it can feed a `select` or a result register.

func overflow_operation(operation: BinaryOp) -> BinaryOp:
    if operation == BinaryOp.add_overflows or operation == BinaryOp.add_sat: return BinaryOp.add
    if operation == BinaryOp.sub_overflows or operation == BinaryOp.sub_sat: return BinaryOp.sub
    return BinaryOp.mul

func wrapping_opcode(operation: BinaryOp, wide: bool) -> u8:
    if operation == BinaryOp.add_wrap or operation == BinaryOp.add: return pick(wide, opcode_i64_add, opcode_i32_add)
    if operation == BinaryOp.sub_wrap or operation == BinaryOp.sub: return pick(wide, opcode_i64_sub, opcode_i32_sub)
    return pick(wide, opcode_i64_mul, opcode_i32_mul)

func encode_wrapping_arithmetic(body: list[u8], operation: BinaryOp, kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    local_get(body, left)
    local_get(body, right)
    body.append(wrapping_opcode(operation, kind.is_wide))
    append_canonicalise(body, kind)
    local_set(body, result)

# Leaves the wrapped `left op right` on the stack in the type's value type.
func append_wrapped(body: list[u8], operation: BinaryOp, kind: Kind, left: RegisterId, right: RegisterId):
    local_get(body, left)
    local_get(body, right)
    body.append(wrapping_opcode(operation, kind.is_wide))
    append_canonicalise(body, kind)

# Leaves the i32 overflow flag of `left op right` on the stack.
func append_overflow_flag(body: list[u8], operation: BinaryOp, kind: Kind, left: RegisterId, right: RegisterId):
    if is_narrow(kind):
        # The i32 result is exact; it overflowed when outside the narrow range.
        local_get(body, left)
        local_get(body, right)
        body.append(wrapping_opcode(operation, false))
        append_constant(body, narrow_minimum(kind), false)
        body.append(opcode_i32_lt_s)
        local_get(body, left)
        local_get(body, right)
        body.append(wrapping_opcode(operation, false))
        append_constant(body, narrow_maximum(kind), false)
        body.append(opcode_i32_gt_s)
        body.append(opcode_i32_or)
        return
    if kind.bits == 32 and not kind.is_signed:
        # The exact i64 result overflowed u32 when it has bits above 32.
        local_get(body, left)
        body.append(opcode_i64_extend_i32_u)
        local_get(body, right)
        body.append(opcode_i64_extend_i32_u)
        body.append(wrapping_opcode(operation, true))
        append_constant(body, 0xFFFFFFFF, true)
        body.append(opcode_i64_gt_u)
        return
    if kind.is_wide and not kind.is_signed:
        if operation == BinaryOp.add:
            # Carry: the sum is below either input.
            local_get(body, left)
            local_get(body, right)
            body.append(opcode_i64_add)
            local_get(body, left)
            body.append(opcode_i64_lt_u)
            return
        if operation == BinaryOp.sub:
            local_get(body, left)
            local_get(body, right)
            body.append(opcode_i64_lt_u)
            return
        # `b != 0 and (a * b) / b != a`, dividing only when `b` is non-zero.
        local_get(body, right)
        body.append(opcode_i64_eqz)
        body.append(opcode_if)
        body.append(i32_value_type)
        append_constant(body, 0, false)
        body.append(opcode_else)
        local_get(body, left)
        local_get(body, right)
        body.append(opcode_i64_mul)
        local_get(body, right)
        body.append(opcode_i64_div_u)
        local_get(body, left)
        body.append(opcode_i64_ne)
        body.append(opcode_end)
        return
    let wide = kind.is_wide
    if operation == BinaryOp.add or operation == BinaryOp.sub:
        # Signed add: `((a ^ r) & (b ^ r)) < 0`; sub: `((a ^ b) & (a ^ r)) < 0`.
        local_get(body, left)
        if operation == BinaryOp.add: append_wrapped(body, operation, kind, left, right)
        else: local_get(body, right)
        body.append(pick(wide, opcode_i64_xor, opcode_i32_xor))
        if operation == BinaryOp.add: local_get(body, right)
        else: local_get(body, left)
        append_wrapped(body, operation, kind, left, right)
        body.append(pick(wide, opcode_i64_xor, opcode_i32_xor))
        body.append(pick(wide, opcode_i64_and, opcode_i32_and))
        append_zero(body, wide)
        body.append(pick(wide, opcode_i64_lt_s, opcode_i32_lt_s))
        return
    # Signed multiply: `b == 0` never overflows; `b == -1` overflows exactly
    # for `a == minimum` (and its division would trap); otherwise the wrapped
    # product divided by `b` differs from `a`.
    local_get(body, right)
    body.append(pick(wide, opcode_i64_eqz, opcode_i32_eqz))
    body.append(opcode_if)
    body.append(i32_value_type)
    append_constant(body, 0, false)
    body.append(opcode_else)
    local_get(body, right)
    append_constant(body, -1, wide)
    body.append(pick(wide, opcode_i64_eq, opcode_i32_eq))
    body.append(opcode_if)
    body.append(i32_value_type)
    local_get(body, left)
    if wide: append_constant(body, -9223372036854775807 - 1, true)
    else: append_constant(body, -2147483647 - 1, false)
    body.append(pick(wide, opcode_i64_eq, opcode_i32_eq))
    body.append(opcode_else)
    append_wrapped(body, operation, kind, left, right)
    local_get(body, right)
    body.append(pick(wide, opcode_i64_div_s, opcode_i32_div_s))
    local_get(body, left)
    body.append(pick(wide, opcode_i64_ne, opcode_i32_ne))
    body.append(opcode_end)
    body.append(opcode_end)

# `select(bound, wrapped, flag)`: the bound the exact result passed, else the
# exact result. A signed bound is `maximum + (toward_minimum ? 1 : 0)`, which
# wraps to the minimum; unsigned saturates at the type's maximum or at zero.
func encode_saturating_arithmetic(body: list[u8], operation: BinaryOp, kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    if kind.is_signed:
        append_constant(body, saturation_maximum(kind), wide)
        if operation == BinaryOp.add:
            # The sign bit of `right`, as 0/1: overflow toward the minimum
            # happens exactly when `right` is negative.
            local_get(body, right)
            append_constant(body, sign_shift(kind), wide)
            body.append(pick(wide, opcode_i64_shr_u, opcode_i32_shr_u))
        elif operation == BinaryOp.sub:
            # `0 < right` as 0/1: subtracting a positive overflows downward.
            append_zero(body, wide)
            local_get(body, right)
            body.append(pick(wide, opcode_i64_lt_s, opcode_i32_lt_s))
            if wide: body.append(opcode_i64_extend_i32_u)
        else:
            # Differing signs make a negative product.
            local_get(body, left)
            local_get(body, right)
            body.append(pick(wide, opcode_i64_xor, opcode_i32_xor))
            append_constant(body, sign_shift(kind), wide)
            body.append(pick(wide, opcode_i64_shr_u, opcode_i32_shr_u))
        body.append(pick(wide, opcode_i64_add, opcode_i32_add))
    elif operation == BinaryOp.sub: append_zero(body, wide)
    else: append_constant(body, saturation_maximum(kind), wide)
    append_wrapped(body, operation, kind, left, right)
    append_overflow_flag(body, operation, kind, left, right)
    body.append(opcode_select)
    append_canonicalise(body, kind)
    local_set(body, result)

# A canonical value's sign bit is the top bit of its machine word.
func sign_shift(kind: Kind) -> i64:
    if kind.is_wide: return 63
    return 31

func saturation_maximum(kind: Kind) -> i64:
    if kind.is_signed:
        if kind.bits == 8: return 127
        if kind.bits == 16: return 32767
        if kind.bits == 32: return 2147483647
        return 9223372036854775807
    if kind.bits == 8: return 255
    if kind.bits == 16: return 65535
    if kind.bits == 32: return -1
    return -1

func narrow_arithmetic_opcode(operation: BinaryOp) -> u8:
    if operation == BinaryOp.add: return opcode_i32_add
    if operation == BinaryOp.sub: return opcode_i32_sub
    return opcode_i32_mul

# `local.get r; i32.const min; i32.lt_s; if unreachable end` and the same
# against the maximum with `gt_s`.
func append_range_trap(body: list[u8], register: RegisterId, kind: Kind):
    local_get(body, register)
    append_constant(body, narrow_minimum(kind), false)
    body.append(opcode_i32_lt_s)
    append_trap_if_true(body)
    local_get(body, register)
    append_constant(body, narrow_maximum(kind), false)
    body.append(opcode_i32_gt_s)
    append_trap_if_true(body)

func narrow_minimum(kind: Kind) -> i64:
    if not kind.is_signed: return 0
    if kind.bits == 8: return -128
    return -32768

func narrow_maximum(kind: Kind) -> i64:
    if kind.is_signed:
        if kind.bits == 8: return 127
        return 32767
    if kind.bits == 8: return 255
    return 65535

# u32: `i64.extend_i32_u` both operands, operate in i64, trap unless
# `0 <= r <= 0xFFFFFFFF` (as an unsigned compare, one `gt_u` covers both
# ends), then `i32.wrap_i64` into the result.
func encode_u32_arithmetic(body: list[u8], operation: BinaryOp, result: RegisterId, left: RegisterId, right: RegisterId):
    local_get(body, left)
    body.append(opcode_i64_extend_i32_u)
    local_get(body, right)
    body.append(opcode_i64_extend_i32_u)
    if operation == BinaryOp.add: body.append(opcode_i64_add)
    elif operation == BinaryOp.sub: body.append(opcode_i64_sub)
    else: body.append(opcode_i64_mul)
    body.append(opcode_i32_wrap_i64)
    local_set(body, result)
    # Recompute the i64 result for the test; cheaper than a temporary local.
    local_get(body, left)
    body.append(opcode_i64_extend_i32_u)
    local_get(body, right)
    body.append(opcode_i64_extend_i32_u)
    if operation == BinaryOp.add: body.append(opcode_i64_add)
    elif operation == BinaryOp.sub: body.append(opcode_i64_sub)
    else: body.append(opcode_i64_mul)
    append_constant(body, 0xFFFFFFFF, true)
    body.append(opcode_i64_gt_u)
    append_trap_if_true(body)

# Full-width unsigned arithmetic cannot widen. Addition checks carry, and
# subtraction checks borrow, in the machine's unsigned ordering. For a
# nonzero multiplier, a wrapped product divided by that multiplier cannot
# recover the original left operand.
func encode_u64_arithmetic(body: list[u8], operation: BinaryOp, result: RegisterId, left: RegisterId, right: RegisterId):
    local_get(body, left)
    local_get(body, right)
    if operation == BinaryOp.add: body.append(opcode_i64_add)
    elif operation == BinaryOp.sub: body.append(opcode_i64_sub)
    else: body.append(opcode_i64_mul)
    local_set(body, result)
    if operation == BinaryOp.add:
        local_get(body, result)
        local_get(body, left)
        body.append(opcode_i64_lt_u)
        append_trap_if_true(body)
        return
    if operation == BinaryOp.sub:
        local_get(body, left)
        local_get(body, right)
        body.append(opcode_i64_lt_u)
        append_trap_if_true(body)
        return
    body.append(opcode_block)
    body.append(empty_block_type)
    local_get(body, right)
    body.append(opcode_i64_eqz)
    body.append(opcode_br_if)
    append_unsigned(body, 0)
    local_get(body, result)
    local_get(body, right)
    body.append(opcode_i64_div_u)
    local_get(body, left)
    body.append(opcode_i64_ne)
    append_trap_if_true(body)
    body.append(opcode_end)

# `r = a + b` overflows exactly when both operands have the sign opposite to
# the result's: `((a ^ r) & (b ^ r)) < 0`.
func encode_checked_add(body: list[u8], result: RegisterId, left: RegisterId, right: RegisterId, is_wide: bool):
    local_get(body, left)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_add, opcode_i32_add))
    local_set(body, result)
    local_get(body, left)
    local_get(body, result)
    body.append(pick(is_wide, opcode_i64_xor, opcode_i32_xor))
    local_get(body, right)
    local_get(body, result)
    body.append(pick(is_wide, opcode_i64_xor, opcode_i32_xor))
    body.append(pick(is_wide, opcode_i64_and, opcode_i32_and))
    append_zero(body, is_wide)
    body.append(pick(is_wide, opcode_i64_lt_s, opcode_i32_lt_s))
    append_trap_if_true(body)

# `r = a - b` overflows exactly when the operands differ in sign and the
# result's sign differs from `a`'s: `((a ^ b) & (a ^ r)) < 0`.
func encode_checked_sub(body: list[u8], result: RegisterId, left: RegisterId, right: RegisterId, is_wide: bool):
    local_get(body, left)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_sub, opcode_i32_sub))
    local_set(body, result)
    local_get(body, left)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_xor, opcode_i32_xor))
    local_get(body, left)
    local_get(body, result)
    body.append(pick(is_wide, opcode_i64_xor, opcode_i32_xor))
    body.append(pick(is_wide, opcode_i64_and, opcode_i32_and))
    append_zero(body, is_wide)
    body.append(pick(is_wide, opcode_i64_lt_s, opcode_i32_lt_s))
    append_trap_if_true(body)

# `r = a * b` overflowed when `b != 0` and `r / b != a`, or when `a == -1`
# and `b` is the minimum (whose negation does not exist). The checks sit in
# a block that `b == 0` skips, since dividing by zero would itself trap.
# When `r / b` is `minimum / -1` the division traps too — that case is an
# overflow as well, so either trap is the right answer.
func encode_checked_mul(body: list[u8], result: RegisterId, left: RegisterId, right: RegisterId, is_wide: bool):
    local_get(body, left)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_mul, opcode_i32_mul))
    local_set(body, result)
    body.append(opcode_block)
    body.append(empty_block_type)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_eqz, opcode_i32_eqz))
    body.append(opcode_br_if)
    append_unsigned(body, 0)
    local_get(body, result)
    local_get(body, right)
    body.append(pick(is_wide, opcode_i64_div_s, opcode_i32_div_s))
    local_get(body, left)
    body.append(pick(is_wide, opcode_i64_ne, opcode_i32_ne))
    append_trap_if_true(body)
    local_get(body, left)
    append_constant(body, -1, is_wide)
    body.append(pick(is_wide, opcode_i64_eq, opcode_i32_eq))
    local_get(body, right)
    if is_wide: append_constant(body, -9223372036854775807 - 1, true)
    else: append_constant(body, -2147483647 - 1, false)
    body.append(pick(is_wide, opcode_i64_eq, opcode_i32_eq))
    body.append(opcode_i32_and)
    append_trap_if_true(body)
    body.append(opcode_end)

# mark: Division ==============================================================================
#
# `//` is floor division and `%` its paired remainder (language section 7);
# wasm's `div_s`/`rem_s` truncate toward zero. The signed forms compute the
# truncated result and adjust it by one step when the remainder is non-zero
# and the operands' signs differ. Unsigned operands need no adjustment.
# Wasm traps on a zero divisor and on `minimum / -1`, which is exactly the
# language rule, so no explicit test guards those; a narrow signed
# `minimum // -1` overflows in i32 without trapping and gets a range test.

# floor_div: `q = a / b; if (a % b != 0) & ((a ^ b) < 0): q -= 1`
func encode_floor_div(body: list[u8], kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, left)
    local_get(body, right)
    if kind.is_signed: body.append(pick(wide, opcode_i64_div_s, opcode_i32_div_s))
    else: body.append(pick(wide, opcode_i64_div_u, opcode_i32_div_u))
    if kind.is_signed:
        append_sign_adjustment_condition(body, kind, left, right)
        # `q - adjust` where adjust is the i32 condition, widened for i64.
        if wide: body.append(opcode_i64_extend_i32_u)
        body.append(pick(wide, opcode_i64_sub, opcode_i32_sub))
    local_set(body, result)
    if is_narrow(kind) and kind.is_signed: append_range_trap(body, result, kind)

# rem: `r = a % b; if (r != 0) & ((a ^ b) < 0): r += b`
func encode_rem(body: list[u8], kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, left)
    local_get(body, right)
    if kind.is_signed: body.append(pick(wide, opcode_i64_rem_s, opcode_i32_rem_s))
    else: body.append(pick(wide, opcode_i64_rem_u, opcode_i32_rem_u))
    local_set(body, result)
    if kind.is_signed:
        # `r + (b & -adjust)`: adds `b` exactly when the condition holds.
        local_get(body, result)
        local_get(body, right)
        append_zero(body, wide)
        append_sign_adjustment_condition(body, kind, left, right)
        if wide: body.append(opcode_i64_extend_i32_u)
        body.append(pick(wide, opcode_i64_sub, opcode_i32_sub))
        body.append(pick(wide, opcode_i64_and, opcode_i32_and))
        body.append(pick(wide, opcode_i64_add, opcode_i32_add))
        local_set(body, result)

# C's division and remainder are wasm's own `div_s`/`rem_s`; only a narrow
# signed `minimum // -1` needs the range test the floor form also carries.
func encode_trunc_division(body: list[u8], operation: BinaryOp, kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, left)
    local_get(body, right)
    if operation == BinaryOp.trunc_div:
        if kind.is_signed: body.append(pick(wide, opcode_i64_div_s, opcode_i32_div_s))
        else: body.append(pick(wide, opcode_i64_div_u, opcode_i32_div_u))
    elif kind.is_signed: body.append(pick(wide, opcode_i64_rem_s, opcode_i32_rem_s))
    else: body.append(pick(wide, opcode_i64_rem_u, opcode_i32_rem_u))
    local_set(body, result)
    if operation == BinaryOp.trunc_div and is_narrow(kind) and kind.is_signed: append_range_trap(body, result, kind)

# Leaves the i32 `((a % b) != 0) & ((a ^ b) < 0)` on the stack.
func append_sign_adjustment_condition(body: list[u8], kind: Kind, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, left)
    local_get(body, right)
    body.append(pick(wide, opcode_i64_rem_s, opcode_i32_rem_s))
    append_zero(body, wide)
    body.append(pick(wide, opcode_i64_ne, opcode_i32_ne))
    local_get(body, left)
    local_get(body, right)
    body.append(pick(wide, opcode_i64_xor, opcode_i32_xor))
    append_zero(body, wide)
    body.append(pick(wide, opcode_i64_lt_s, opcode_i32_lt_s))
    body.append(opcode_i32_and)

# mark: Shifts ================================================================================
#
# A shift count outside the type's width traps (language section 7); wasm
# masks it instead, so the count is tested first as an unsigned compare —
# `count >= bits` catches negatives too. Signed right shift is arithmetic,
# unsigned is logical; a left shift of a narrow type re-canonicalises.

func encode_shift(body: list[u8], operation: BinaryOp, kind: Kind, result: RegisterId, left: RegisterId, right: RegisterId):
    let wide = kind.is_wide
    local_get(body, right)
    append_constant(body, kind.bits, wide)
    body.append(pick(wide, opcode_i64_ge_u, opcode_i32_ge_u))
    append_trap_if_true(body)
    local_get(body, left)
    local_get(body, right)
    if operation == BinaryOp.shift_left:
        body.append(pick(wide, opcode_i64_shl, opcode_i32_shl))
        append_canonicalise(body, kind)
    elif kind.is_signed:
        body.append(pick(wide, opcode_i64_shr_s, opcode_i32_shr_s))
    else:
        body.append(pick(wide, opcode_i64_shr_u, opcode_i32_shr_u))
    local_set(body, result)

# mark: Unary operations ======================================================================

func encode_unary(body: list[u8], operation: UnaryOp, kind: Kind, frame: FramePlan, result: RegisterId, operand: RegisterId) -> !:
    match operation:
        bool_not:
            local_get(body, operand)
            body.append(opcode_i32_eqz)
            local_set(body, result)
        bit_not:
            # `x ^ -1` for signed and 32/64-bit types keeps the canonical
            # form; an unsigned narrow type flips only its own bits.
            local_get(body, operand)
            if is_narrow(kind) and not kind.is_signed: append_constant(body, narrow_mask(kind), false)
            else: append_constant(body, -1, kind.is_wide)
            body.append(pick(kind.is_wide, opcode_i64_xor, opcode_i32_xor))
            local_set(body, result)
        neg_wrap:
            append_zero(body, kind.is_wide)
            local_get(body, operand)
            body.append(pick(kind.is_wide, opcode_i64_sub, opcode_i32_sub))
            append_canonicalise(body, kind)
            local_set(body, result)
        neg:
            if kind.is_float:
                local_get(body, operand)
                body.append(pick(kind.is_wide, opcode_f64_neg, opcode_f32_neg))
                if kind.bits == 16: append_float16_round(body, frame.float16_scratch)
                local_set(body, result)
            elif is_narrow(kind):
                # `0 - x` fits in i32; only `-minimum` leaves the range.
                append_zero(body, false)
                local_get(body, operand)
                body.append(opcode_i32_sub)
                local_set(body, result)
                append_range_trap(body, result, kind)
            else:
                # `-minimum` does not exist: trap first, then `0 - x`.
                local_get(body, operand)
                if kind.is_wide: append_constant(body, -9223372036854775807 - 1, true)
                else: append_constant(body, -2147483647 - 1, false)
                body.append(pick(kind.is_wide, opcode_i64_eq, opcode_i32_eq))
                append_trap_if_true(body)
                append_zero(body, kind.is_wide)
                local_get(body, operand)
                body.append(pick(kind.is_wide, opcode_i64_sub, opcode_i32_sub))
                local_set(body, result)

# mark: Conversions ===========================================================================
#
# `extend` widens by the source's signedness; within i32 a canonical narrow
# value already is the wider value. `wrap` narrows and re-canonicalises.
# Integer-to-float picks the convert by source width and signedness;
# float-to-integer truncates and, as the language requires, traps when the
# value does not fit — wasm's `trunc` does that for i32/i64 and a range test
# does it for narrow targets.

func encode_convert(body: list[u8], operation: ConvertOp, from: Kind, to: Kind, frame: FramePlan, result: RegisterId, operand: RegisterId) -> !:
    local_get(body, operand)
    match operation:
        extend:
            if to.is_wide and not from.is_wide:
                if from.is_signed: body.append(opcode_i64_extend_i32_s)
                else: body.append(opcode_i64_extend_i32_u)
        cast_int:
            # C's cast at wasm32 widths: wrap, copy, or extend by the source.
            if to.is_wide and not from.is_wide:
                if from.is_signed: body.append(opcode_i64_extend_i32_s)
                else: body.append(opcode_i64_extend_i32_u)
            elif from.is_wide and not to.is_wide: body.append(opcode_i32_wrap_i64)
            append_canonicalise(body, to)
        float_to_int_saturating:
            body.append(opcode_prefix_fc)
            if to.is_wide:
                if from.is_wide: body.append(pick(to.is_signed, saturating_trunc_i64_f64_s, saturating_trunc_i64_f64_u))
                else: body.append(pick(to.is_signed, saturating_trunc_i64_f32_s, saturating_trunc_i64_f32_u))
            else:
                if from.is_wide: body.append(pick(to.is_signed, saturating_trunc_i32_f64_s, saturating_trunc_i32_f64_u))
                else: body.append(pick(to.is_signed, saturating_trunc_i32_f32_s, saturating_trunc_i32_f32_u))
            if is_narrow(to):
                # The i32 result still needs the narrow type's bounds.
                local_set(body, result)
                local_get(body, result)
                append_constant(body, narrow_maximum(to), false)
                local_get(body, result)
                append_constant(body, narrow_maximum(to), false)
                if to.is_signed: body.append(opcode_i32_gt_s)
                else: body.append(opcode_i32_gt_u)
                body.append(opcode_select)
                if to.is_signed:
                    local_set(body, result)
                    local_get(body, result)
                    append_constant(body, narrow_minimum(to), false)
                    local_get(body, result)
                    append_constant(body, narrow_minimum(to), false)
                    body.append(opcode_i32_lt_s)
                    body.append(opcode_select)
        ptr_to_nullable: pass
        nullable_to_ptr: pass
        ptr_to_int: pass
        int_to_ptr: pass
        widen:
            # Pointer-width integers are 32 bits here: extend or copy.
            if to.is_wide and not from.is_wide:
                if from.is_signed: body.append(opcode_i64_extend_i32_s)
                else: body.append(opcode_i64_extend_i32_u)
        wrap:
            if from.is_wide: body.append(opcode_i32_wrap_i64)
            append_canonicalise(body, to)
        int_reinterpret: pass
        int_to_float:
            if to.is_wide:
                if from.is_wide: body.append(pick(from.is_signed, opcode_f64_convert_i64_s, opcode_f64_convert_i64_u))
                else: body.append(pick(from.is_signed, opcode_f64_convert_i32_s, opcode_f64_convert_i32_u))
            else:
                if from.is_wide: body.append(pick(from.is_signed, opcode_f32_convert_i64_s, opcode_f32_convert_i64_u))
                else: body.append(pick(from.is_signed, opcode_f32_convert_i32_s, opcode_f32_convert_i32_u))
            if to.bits == 16: append_float16_round(body, frame.float16_scratch)
        float_to_int:
            if to.is_wide:
                if from.is_wide: body.append(pick(to.is_signed, opcode_i64_trunc_f64_s, opcode_i64_trunc_f64_u))
                else: body.append(pick(to.is_signed, opcode_i64_trunc_f32_s, opcode_i64_trunc_f32_u))
            else:
                if from.is_wide: body.append(pick(to.is_signed, opcode_i32_trunc_f64_s, opcode_i32_trunc_f64_u))
                else: body.append(pick(to.is_signed, opcode_i32_trunc_f32_s, opcode_i32_trunc_f32_u))
        float_resize:
            if to.bits == 16:
                if from.is_wide:
                    append_float64_to_float16_bits(body, frame.float16_wide_scratch)
                    append_float16_value(body, frame.float16_scratch)
                else: append_float16_round(body, frame.float16_scratch)
            elif to.is_wide:
                body.append(opcode_f64_promote_f32)
            elif from.is_wide:
                body.append(opcode_f32_demote_f64)
    local_set(body, result)
    if operation == ConvertOp.float_to_int and is_narrow(to): append_range_trap(body, result, to)

# mark: Small helpers =========================================================================

# WebAssembly integer constants use signed LEB128 for an untyped bit pattern.
# Reinterpret canonical unsigned values only at this backend encoding seam.
func unsigned_wasm_immediate(value: u64, is_wide: bool) -> i64:
    if is_wide:
        if value <= u64(9223372036854775807): return i64(value)
        return (-9223372036854775807 - 1) + i64(value - u64(9223372036854775808))
    if value <= u64(2147483647): return i64(value)
    return i64(value) - 4294967296

func append_zero(body: list[u8], is_wide: bool):
    append_constant(body, 0, is_wide)

# mark: Float constants =======================================================================
#
# The shared semantic utility reconstructs target-independent IEEE bits;
# this backend owns only Wasm's little-endian immediate byte order.

func append_f64_constant(body: list[u8], value: f64):
    body.append(opcode_f64_const)
    append_float_bytes(body, ieee_float_bits(value, 64), 8)

func append_f32_constant(body: list[u8], value: f64):
    body.append(opcode_f32_const)
    append_float_bytes(body, ieee_float_bits(value, 32), 4)

func append_float_bytes(body: list[u8], value: u64, count: i64):
    var remaining = value
    for index in range(0, count):
        body.append(u8(remaining & u64(0xFF)))
        remaining = remaining >> u64(8)

# mark: LEB128 and byte plumbing ==============================================================

# Every section is its id, its payload size, then the payload.
func append_section(output: list[u8], section_id: u8, payload: list[u8]):
    output.append(section_id)
    append_unsigned(output, len(payload))
    append_all(output, payload)

# A name is its UTF-8 length followed by the bytes.
func append_name(output: list[u8], value: str):
    let encoded = strings.to_bytes(value)
    append_unsigned(output, len(encoded))
    append_all(output, encoded)

func append_fixed_u32(output: list[u8], number: i64):
    var value = number
    for index in range(0, 4):
        output.append(u8(value & 0xFF))
        value = value >> 8

func append_all(output: list[u8], values: list[u8]):
    for value in values:
        output.append(value)
