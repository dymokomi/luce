#==============================================================================================
#
#   wasm - Canonical instructions into a WebAssembly module
#
#   DESCRIPTION:
#       A direct WebAssembly encoder for canonical MIR. It writes the binary
#       format itself with no assembler in between. Integer ops map onto WASM
#       opcodes because both are stack machines. `WriteText` legalizes to an
#       imported `luce.write` plus a data payload; a host that can load the
#       module supplies that write. Arithmetic-only modules stay import-free.
#
#       Read `emit` top-down: it writes the sections in the order the binary
#       format requires — type, import, function, memory, export, code, data —
#       and each `encode_*` below produces one section's payload. When a write
#       import exists it is function 0 and type 0, so every defined function's
#       index and type index shift by one; `defined_function_base` carries
#       that shift everywhere an index is written. The LEB128 helpers at the
#       end are the only byte-level plumbing.
#
#==============================================================================================

from compiler.backend import ArtifactBackend
from compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType
import std.strings

# mark: WebAssembly binary format names =======================================================

const type_section: u8 = 0x01
const import_section: u8 = 0x02
const function_section: u8 = 0x03
const memory_section: u8 = 0x05
const export_section: u8 = 0x07
const code_section: u8 = 0x0A
const data_section: u8 = 0x0B

const function_type_tag: u8 = 0x60
const i32_value_type: u8 = 0x7F
const i64_value_type: u8 = 0x7E
const function_import_kind: u8 = 0x00
const function_export_kind: u8 = 0x00

const opcode_i32_const: u8 = 0x41
const opcode_i32_add: u8 = 0x6A
const opcode_i32_subtract: u8 = 0x6B
const opcode_i32_multiply: u8 = 0x6C
const opcode_i64_const: u8 = 0x42
const opcode_i64_add: u8 = 0x7C
const opcode_i64_subtract: u8 = 0x7D
const opcode_i64_multiply: u8 = 0x7E
const opcode_call: u8 = 0x10
const opcode_return: u8 = 0x0F
const opcode_end: u8 = 0x0B

# mark: The encoder ===========================================================================

pub class WasmBackend: ArtifactBackend:
    pub init():
        # Stateless; Stage-0 requires one statement in an empty init.
        return

    ## Encode one canonical program as the bytes of a complete `.wasm` module.
    pub func emit(program: CanonicalProgram) -> list[u8]!:
        let writes = collect_writes(program)
        let type_map = collect_result_types(program)
        let has_write = len(writes) > 0
        let function_base = defined_function_base(has_write)
        let output = list[u8]()
        # `\0asm`, then binary format version 1.
        append_all(output, [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00])
        append_section(output, type_section, encode_type_entries(has_write, type_map))
        if has_write:
            append_section(output, import_section, encode_write_import())
        append_section(output, function_section, encode_function_entries(program, type_map, function_base))
        if has_write:
            append_section(output, memory_section, encode_memory_entry())
        let exports = encode_export_entries(program, function_base)
        # A lone leading count byte means "no exports"; write the section only
        # when something follows the count.
        if len(exports) > 1:
            append_section(output, export_section, exports)
        append_section(output, code_section, encode_code_entries(program, writes, write_function_index))
        if len(writes) > 0:
            append_section(output, data_section, encode_data_entries(writes))
        return output

# mark: Module layout =========================================================================

# One string payload per `WriteText`, packed from offset zero.
struct WritePayload:
    offset: i64
    bytes: list[u8]

# Walk functions then instructions in program order. `encode_code_entries`
# must use the same walk: `write_index` is the position in this list.
func collect_writes(program: CanonicalProgram) -> list[WritePayload]:
    let writes = list[WritePayload]()
    var offset = 0
    for function in program.functions:
        for instruction in function.instructions:
            match instruction:
                WriteText(value):
                    let encoded = strings.to_bytes(value + "\n")
                    writes.append(WritePayload(offset = offset, bytes = encoded))
                    offset += len(encoded)
                else: continue
    return writes

# Result types in first-seen order, so an i64-only module still has a single
# type index zero and keeps the previous arithmetic encoding.
func collect_result_types(program: CanonicalProgram) -> list[CanonicalType]:
    let types = list[CanonicalType]()
    for function in program.functions:
        var seen = false
        for existing in types:
            if existing == function.result: seen = true
        if not seen: types.append(function.result)
    return types

func result_type_index(type_map: list[CanonicalType], result: CanonicalType) -> i64:
    var index = 0
    for existing in type_map:
        if existing == result: return index
        index += 1
    return 0

# Imports come before defined functions in WebAssembly's single function
# index space, and the write import is also type 0. This one number is the
# shift applied to every defined function's index and type index.
const write_function_index: i64 = 0

func defined_function_base(has_write: bool) -> i64:
    if has_write: return write_function_index + 1
    return 0

# Type 0 is the write import `(i32, i32) -> ()` when present; each result
# type in `type_map` then gets one `() -> T` entry in first-seen order.
func encode_type_entries(has_write: bool, type_map: list[CanonicalType]) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(type_map) + defined_function_base(has_write))
    if has_write:
        entries.append(function_type_tag)
        entries.append(0x02)                # two parameters: offset, length
        entries.append(i32_value_type)
        entries.append(i32_value_type)
        entries.append(0x00)                # no results
    for result in type_map:
        entries.append(function_type_tag)
        entries.append(0x00)                # no parameters
        entries.append(0x01)                # one result
        entries.append(wasm_value_type(result))
    return entries

# One import: module `luce`, name `write`, function of type 0.
func encode_write_import() -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, 1)
    append_name(entries, "luce")
    append_name(entries, "write")
    entries.append(function_import_kind)
    append_unsigned(entries, 0)
    return entries

# The function section only names each defined function's type index; the
# bodies come later in the code section, in the same order.
func encode_function_entries(program: CanonicalProgram, type_map: list[CanonicalType], function_base: i64) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(program.functions))
    for function in program.functions:
        append_unsigned(entries, result_type_index(type_map, function.result) + function_base)
    return entries

# One memory with a one-page (64 KiB) minimum and no maximum; it holds the
# `WriteText` payloads placed by the data section.
func encode_memory_entry() -> list[u8]:
    return [0x01, 0x00, 0x01]

# Public functions export under their canonical `module.function` name.
func encode_export_entries(program: CanonicalProgram, function_base: i64) -> list[u8]:
    let entries = list[u8]()
    var export_count = 0
    for function in program.functions:
        if function.is_public: export_count += 1
    append_unsigned(entries, export_count)

    var function_index = function_base
    for function in program.functions:
        if function.is_public:
            append_name(entries, function.name)
            entries.append(function_export_kind)
            append_unsigned(entries, function_index)
        function_index += 1
    return entries

# One body per function: canonical instructions become their opcodes.
# `write_index` is the next payload from `collect_writes`. Both functions
# walk `program.functions` then `function.instructions` in the same order.
func encode_code_entries(program: CanonicalProgram, writes: list[WritePayload], write_function: i64) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(program.functions))
    var write_index = 0
    for function in program.functions:
        let body = list[u8]()
        # Zero local declarations; operands live on the WASM stack.
        body.append(0x00)
        for instruction in function.instructions:
            match instruction:
                Constant(value, value_type):
                    body.append(wasm_const_opcode(value_type))
                    append_signed(body, value)
                Add(operand_type): body.append(wasm_add_opcode(operand_type))
                Subtract(operand_type): body.append(wasm_subtract_opcode(operand_type))
                Multiply(operand_type): body.append(wasm_multiply_opcode(operand_type))
                WriteText(value):
                    let payload = writes[write_index]
                    write_index += 1
                    body.append(opcode_i32_const)
                    append_signed(body, payload.offset)
                    body.append(opcode_i32_const)
                    append_signed(body, len(payload.bytes))
                    body.append(opcode_call)
                    append_unsigned(body, write_function)
                Return: body.append(opcode_return)
        body.append(opcode_end)
        append_unsigned(entries, len(body))
        append_all(entries, body)
    return entries

# One active data segment per payload, each placed into memory 0 at its
# packed offset when the module is instantiated.
func encode_data_entries(writes: list[WritePayload]) -> list[u8]:
    let entries = list[u8]()
    append_unsigned(entries, len(writes))
    for payload in writes:
        entries.append(0x00)                # active segment in memory 0
        entries.append(opcode_i32_const)    # offset expression: `i32.const offset; end`
        append_signed(entries, payload.offset)
        entries.append(opcode_end)
        append_unsigned(entries, len(payload.bytes))
        append_all(entries, payload.bytes)
    return entries

# mark: Opcode tables =========================================================================

func wasm_value_type(value: CanonicalType) -> u8:
    return match value:
        signed_i32 => i32_value_type
        signed_i64 => i64_value_type

func wasm_const_opcode(value: CanonicalType) -> u8:
    return match value:
        signed_i32 => opcode_i32_const
        signed_i64 => opcode_i64_const

func wasm_add_opcode(value: CanonicalType) -> u8:
    return match value:
        signed_i32 => opcode_i32_add
        signed_i64 => opcode_i64_add

func wasm_subtract_opcode(value: CanonicalType) -> u8:
    return match value:
        signed_i32 => opcode_i32_subtract
        signed_i64 => opcode_i64_subtract

func wasm_multiply_opcode(value: CanonicalType) -> u8:
    return match value:
        signed_i32 => opcode_i32_multiply
        signed_i64 => opcode_i64_multiply

# mark: LEB128 and byte plumbing ==============================================================

# Every section is its id, its payload size, then the payload.
func append_section(output: list[u8], section_id: u8, payload: list[u8]):
    output.append(section_id)
    append_unsigned(output, len(payload))
    append_all(output, payload)

# A name is its UTF-8 length followed by the bytes.
func append_name(output: list[u8], value: str):
    let encoded = strings.to_bytes(value)
    append_unsigned(output, len(encoded))
    append_all(output, encoded)

# Unsigned LEB128: seven value bits per byte, high bit says "more follows".
func append_unsigned(output: list[u8], number: i64):
    var value = number
    while value >= 0x80:
        output.append(u8(value & 0x7F | 0x80))
        value = value >> 7
    output.append(u8(value))

# Signed LEB128: same shape, but the sign lives in bit six of the last byte,
# so an extra byte is emitted when that bit would read as the wrong sign.
func append_signed(output: list[u8], number: i64):
    var value = number
    while true:
        var byte = value & 0x7F
        value = value >> 7
        let finished = (value == 0 and byte & 0x40 == 0) or (value == -1 and byte & 0x40 != 0)
        if not finished: byte = byte | 0x80
        output.append(u8(byte))
        if finished: return

func append_all(output: list[u8], values: list[u8]):
    for value in values:
        output.append(value)
