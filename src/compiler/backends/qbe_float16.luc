#==============================================================================================
#
#   qbe_float16 - QBE-local IEEE binary16 legalization helpers
#
#   DESCRIPTION:
#       QBE 1.3 has binary32 and binary64 registers but no binary16 value
#       class. The backend carries an f16 temporarily as an `s`, rounds every
#       producing operation through these helpers, and uses the returned low
#       sixteen bits for two-byte storage. HIR and canonical MIR retain the
#       semantic `Float(16)` identity and never see this representation.
#
#==============================================================================================

# mark: Helper IL ==============================================================================

## Private QBE functions for exact round-to-nearest-even binary32/binary64 ↔
## binary16 conversion. The binary64 entry point is intentionally distinct:
## demoting through binary32 first can double-round values close to a binary16
## midpoint. NaNs use Luce's canonical quiet payload; signed zero, subnormals,
## infinities, and a significand carry into infinity are retained.
pub func qbe_float16_helpers() -> str:
    return (
        "function w $luce.f16.double_to_bits(d %value) {\n"
        + "@start\n"
        + "    %raw =l cast %value\n"
        + "    %sign_shifted =l shr %raw, 48\n"
        + "    %sign =l and %sign_shifted, 32768\n"
        + "    %exponent_shifted =l shr %raw, 52\n"
        + "    %exponent =l and %exponent_shifted, 2047\n"
        + "    %mantissa =l and %raw, 4503599627370495\n"
        + "    %special =w ceql %exponent, 2047\n"
        + "    jnz %special, @special, @finite\n"
        + "@special\n"
        + "    %is_nan =w cnel %mantissa, 0\n"
        + "    jnz %is_nan, @nan, @infinity\n"
        + "@nan\n"
        + "    %result64 =l copy 32256\n"
        + "    jmp @done\n"
        + "@infinity\n"
        + "    %result64 =l or %sign, 31744\n"
        + "    jmp @done\n"
        + "@finite\n"
        + "    %overflow =w cugtl %exponent, 1038\n"
        + "    jnz %overflow, @overflow, @range\n"
        + "@overflow\n"
        + "    %result64 =l or %sign, 31744\n"
        + "    jmp @done\n"
        + "@range\n"
        + "    %normal =w cugel %exponent, 1009\n"
        + "    jnz %normal, @normal, @small\n"
        + "@small\n"
        + "    %underflow =w cultl %exponent, 998\n"
        + "    jnz %underflow, @underflow, @subnormal\n"
        + "@underflow\n"
        + "    %result64 =l copy %sign\n"
        + "    jmp @done\n"
        + "@subnormal\n"
        + "    %sub_hidden =l or %mantissa, 4503599627370496\n"
        + "    %sub_shift =l sub 1051, %exponent\n"
        + "    %sub_base =l shr %sub_hidden, %sub_shift\n"
        + "    %sub_one =l shl 1, %sub_shift\n"
        + "    %sub_mask =l sub %sub_one, 1\n"
        + "    %sub_remainder =l and %sub_hidden, %sub_mask\n"
        + "    %sub_half_shift =l sub %sub_shift, 1\n"
        + "    %sub_half =l shl 1, %sub_half_shift\n"
        + "    %sub_greater =w cugtl %sub_remainder, %sub_half\n"
        + "    %sub_equal =w ceql %sub_remainder, %sub_half\n"
        + "    %sub_odd64 =l and %sub_base, 1\n"
        + "    %sub_odd =w copy %sub_odd64\n"
        + "    %sub_tie =w and %sub_equal, %sub_odd\n"
        + "    %sub_up =w or %sub_greater, %sub_tie\n"
        + "    %sub_up64 =l extuw %sub_up\n"
        + "    %sub_rounded =l add %sub_base, %sub_up64\n"
        + "    %result64 =l or %sign, %sub_rounded\n"
        + "    jmp @done\n"
        + "@normal\n"
        + "    %half_exponent =l sub %exponent, 1008\n"
        + "    %half_exponent_bits =l shl %half_exponent, 10\n"
        + "    %normal_base =l shr %mantissa, 42\n"
        + "    %normal_remainder =l and %mantissa, 4398046511103\n"
        + "    %normal_greater =w cugtl %normal_remainder, 2199023255552\n"
        + "    %normal_equal =w ceql %normal_remainder, 2199023255552\n"
        + "    %normal_odd64 =l and %normal_base, 1\n"
        + "    %normal_odd =w copy %normal_odd64\n"
        + "    %normal_tie =w and %normal_equal, %normal_odd\n"
        + "    %normal_up =w or %normal_greater, %normal_tie\n"
        + "    %normal_up64 =l extuw %normal_up\n"
        + "    %normal_rounded =l add %normal_base, %normal_up64\n"
        + "    %normal_body =l add %half_exponent_bits, %normal_rounded\n"
        + "    %result64 =l or %sign, %normal_body\n"
        + "    jmp @done\n"
        + "@done\n"
        + "    %result =w copy %result64\n"
        + "    ret %result\n"
        + "}\n"
        + "\n"
        + "function w $luce.f16.to_bits(s %value) {\n"
        + "@start\n"
        + "    %raw =w cast %value\n"
        + "    %sign_shifted =w shr %raw, 16\n"
        + "    %sign =w and %sign_shifted, 32768\n"
        + "    %exponent_shifted =w shr %raw, 23\n"
        + "    %exponent =w and %exponent_shifted, 255\n"
        + "    %mantissa =w and %raw, 8388607\n"
        + "    %special =w ceqw %exponent, 255\n"
        + "    jnz %special, @special, @finite\n"
        + "@special\n"
        + "    %is_nan =w cnew %mantissa, 0\n"
        + "    jnz %is_nan, @nan, @infinity\n"
        + "@nan\n"
        + "    %result =w copy 32256\n"
        + "    jmp @done\n"
        + "@infinity\n"
        + "    %result =w or %sign, 31744\n"
        + "    jmp @done\n"
        + "@finite\n"
        + "    %overflow =w cugtw %exponent, 142\n"
        + "    jnz %overflow, @overflow, @range\n"
        + "@overflow\n"
        + "    %result =w or %sign, 31744\n"
        + "    jmp @done\n"
        + "@range\n"
        + "    %normal =w cugew %exponent, 113\n"
        + "    jnz %normal, @normal, @small\n"
        + "@small\n"
        + "    %underflow =w cultw %exponent, 102\n"
        + "    jnz %underflow, @underflow, @subnormal\n"
        + "@underflow\n"
        + "    %result =w copy %sign\n"
        + "    jmp @done\n"
        + "@subnormal\n"
        + "    %sub_hidden =w or %mantissa, 8388608\n"
        + "    %sub_shift =w sub 126, %exponent\n"
        + "    %sub_base =w shr %sub_hidden, %sub_shift\n"
        + "    %sub_one =w shl 1, %sub_shift\n"
        + "    %sub_mask =w sub %sub_one, 1\n"
        + "    %sub_remainder =w and %sub_hidden, %sub_mask\n"
        + "    %sub_half_shift =w sub %sub_shift, 1\n"
        + "    %sub_half =w shl 1, %sub_half_shift\n"
        + "    %sub_greater =w cugtw %sub_remainder, %sub_half\n"
        + "    %sub_equal =w ceqw %sub_remainder, %sub_half\n"
        + "    %sub_odd =w and %sub_base, 1\n"
        + "    %sub_tie =w and %sub_equal, %sub_odd\n"
        + "    %sub_up =w or %sub_greater, %sub_tie\n"
        + "    %sub_rounded =w add %sub_base, %sub_up\n"
        + "    %result =w or %sign, %sub_rounded\n"
        + "    jmp @done\n"
        + "@normal\n"
        + "    %half_exponent =w sub %exponent, 112\n"
        + "    %half_exponent_bits =w shl %half_exponent, 10\n"
        + "    %normal_base =w shr %mantissa, 13\n"
        + "    %normal_remainder =w and %mantissa, 8191\n"
        + "    %normal_greater =w cugtw %normal_remainder, 4096\n"
        + "    %normal_equal =w ceqw %normal_remainder, 4096\n"
        + "    %normal_odd =w and %normal_base, 1\n"
        + "    %normal_tie =w and %normal_equal, %normal_odd\n"
        + "    %normal_up =w or %normal_greater, %normal_tie\n"
        + "    %normal_rounded =w add %normal_base, %normal_up\n"
        + "    %normal_body =w add %half_exponent_bits, %normal_rounded\n"
        + "    %result =w or %sign, %normal_body\n"
        + "    jmp @done\n"
        + "@done\n"
        + "    ret %result\n"
        + "}\n"
        + "\n"
        + "function s $luce.f16.from_bits(w %input) {\n"
        + "@start\n"
        + "    %bits =w and %input, 65535\n"
        + "    %sign16 =w and %bits, 32768\n"
        + "    %sign =w shl %sign16, 16\n"
        + "    %exponent_shifted =w shr %bits, 10\n"
        + "    %exponent =w and %exponent_shifted, 31\n"
        + "    %mantissa =w and %bits, 1023\n"
        + "    %special =w ceqw %exponent, 31\n"
        + "    jnz %special, @special, @finite\n"
        + "@special\n"
        + "    %is_nan =w cnew %mantissa, 0\n"
        + "    jnz %is_nan, @nan, @infinity\n"
        + "@nan\n"
        + "    %result =w copy -4194304\n"
        + "    jmp @done\n"
        + "@infinity\n"
        + "    %result =w or %sign, 2139095040\n"
        + "    jmp @done\n"
        + "@finite\n"
        + "    %nonzero_exponent =w cnew %exponent, 0\n"
        + "    jnz %nonzero_exponent, @normal, @zero_or_subnormal\n"
        + "@zero_or_subnormal\n"
        + "    %nonzero_mantissa =w cnew %mantissa, 0\n"
        + "    jnz %nonzero_mantissa, @subnormal, @zero\n"
        + "@zero\n"
        + "    %result =w copy %sign\n"
        + "    jmp @done\n"
        + "@subnormal\n"
        + "    %normalized =w copy %mantissa\n"
        + "    %single_exponent =w copy 113\n"
        + "    jmp @normalize\n"
        + "@normalize\n"
        + "    %hidden =w and %normalized, 1024\n"
        + "    %ready =w cnew %hidden, 0\n"
        + "    jnz %ready, @subnormal_ready, @normalize_shift\n"
        + "@normalize_shift\n"
        + "    %normalized =w shl %normalized, 1\n"
        + "    %single_exponent =w sub %single_exponent, 1\n"
        + "    jmp @normalize\n"
        + "@subnormal_ready\n"
        + "    %fraction =w and %normalized, 1023\n"
        + "    %single_exponent_bits =w shl %single_exponent, 23\n"
        + "    %fraction_bits =w shl %fraction, 13\n"
        + "    %magnitude =w or %single_exponent_bits, %fraction_bits\n"
        + "    %result =w or %sign, %magnitude\n"
        + "    jmp @done\n"
        + "@normal\n"
        + "    %single_exponent =w add %exponent, 112\n"
        + "    %single_exponent_bits =w shl %single_exponent, 23\n"
        + "    %fraction_bits =w shl %mantissa, 13\n"
        + "    %magnitude =w or %single_exponent_bits, %fraction_bits\n"
        + "    %result =w or %sign, %magnitude\n"
        + "    jmp @done\n"
        + "@done\n"
        + "    %value =s cast %result\n"
        + "    ret %value\n"
        + "}\n"
    )
