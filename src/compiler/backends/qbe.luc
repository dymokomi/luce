#==============================================================================================
#
#   qbe - Verified canonical MIR into QBE 1.3 intermediate language
#
#   DESCRIPTION:
#       This is the native stage-1 translation boundary. It does not introduce
#       another shared IR: one emitter flattens MIR's structured regions into
#       QBE blocks, maps registers and memory operations directly, and computes
#       byte layout under QBE's current 64-bit targets. QBE then owns SSA
#       construction, slot promotion, instruction selection, register
#       allocation, C ABI lowering, and assembly emission.
#
#       QBE accepts non-SSA temporaries, which is especially useful for MIR
#       region results. Every `Yield` or value-carrying branch copies into the
#       region's result temporaries; QBE inserts the necessary phi nodes.
#
#       `emit_il` deliberately stops at textual QBE IL. Tool invocation and
#       linking are a separate host concern: they need paths, diagnostics, and
#       an output location, while this translation is deterministic and pure.
#       Keeping the seam explicit makes the emitter unit-testable even when QBE
#       is not installed and prevents shell/toolchain policy leaking into MIR.
#
#       This is the QBE dispatch point of the profile layout (plan.md §5.0):
#       runtime instructions, worker codecs, and the full-Luce process entry
#       are emitted by `profiles/full/backends/qbe_emission.luc` through the
#       `QbeEmissionHost` services.
#
#==============================================================================================

from compiler.backends.layout import TypeLayout
from compiler.backends.emission import FunctionEmission, TextEmission
from compiler.backends.qbe_float16 import qbe_float16_helpers
from compiler.backends.qbe_representation import IlWriter, qbe_abi_type, qbe_aggregate_type_name, qbe_base_type, qbe_function_name, qbe_layout_rules, qbe_load_instruction, qbe_section_linkage, qbe_store_instruction
from compiler.backends.qbe_emission_model import QbeEmissionHost
from compiler.profiles.full.backends.qbe_emission import FullProfileQbeEmission
from compiler.mir.canonical import AtomicOp, AtomicOrder, BinaryOp, CallingConvention, ConvertOp, FunctionId, InstructionForm, MirConstant
from compiler.formatting.ieee import ieee_float_bits
from compiler.mir.canonical import MirInitializer
from compiler.wrapping import bits_of_signed
from compiler.mir.canonical import MirFunction, MirProgram, MirSignature, RegisterId, RegisterRun, TypeId, UnaryOp
from compiler.runtime_contract import RuntimeService
import std.strings
from compiler.mir.canonical import describe_mir_type, find_runtime_binding, is_aggregate_type, is_float_type, is_int_type
from compiler.mir.canonical import is_ptr_type, is_signed_int_type, mir_type, register_at

## Pure canonical-MIR to QBE-IL translation.
# The wrapped machine value of an arithmetic operation and its overflow flag.
struct OverflowEmission:
    let value: str
    let flag: str

# The member types and byte offsets of one aggregate initialiser's parts.
struct AggregatePlacements:
    let member_types: list[TypeId]
    let offsets: list[i64]

# The ABI class a `__atomic_load_N` result takes: sub-word widths extend
# through QBE's `sb`/`ub`/`sh`/`uh` classes, words and longs as themselves.
func volatile_word_class(width: i64, is_signed: bool) -> str:
    if width == 8: return "l"
    if width == 4: return "w"
    var prefix = "u"
    if is_signed: prefix = "s"
    if width == 2: return prefix + "h"
    return prefix + "b"

# C11's `memory_order` encoding, which the `__atomic_*` library takes.
func c_memory_order(order: AtomicOrder) -> i64:
    match order:
        relaxed: return 0
        acquire: return 2
        release: return 3
        acq_rel: return 4
        seq_cst: return 5

# The register class a `__atomic_store_N` value travels in.
func volatile_register_class(width: i64) -> str:
    if width == 8: return "l"
    return "w"

# The QBE data item letter for a scalar of `size` bytes.
func qbe_data_kind(size: i64) -> str:
    if size == 1: return "b"
    if size == 2: return "h"
    if size == 4: return "w"
    return "l"

pub class QbeBackend:
    let clock: (func() -> i64)?

    pub init(clock: (func() -> i64)? = none):
        self.clock = clock

    pub func emit_il(program: MirProgram) -> str!:
        return (try self.emit_il_with_report(program)).text

    pub func emit_il_with_report(program: MirProgram) -> TextEmission!:
        return try QbeEmitter(program, self.clock).emit()

# QBE's provider reserves one zero-filled BSS arena. Its capacity is a backend
# host policy, never a MIR fact; the source runtime sees only a stable base and
# an all-or-trap committed-prefix request. The loader may commit these pages
# lazily while preserving exactly that contract.
let qbe_arena_capacity: i64 = 67108864

enum RegionKind:
    block
    loop
    conditional

struct Region:
    let kind: RegionKind
    let branch_label: str
    let exit_label: str
    let alternative_label: str
    let results: RegisterRun
    var saw_alternative: bool
    var has_exit_edge: bool

class QbeEmitter: QbeEmissionHost:
    let program: MirProgram
    let layout: TypeLayout
    let clock: (func() -> i64)?
    let function_emissions: list[FunctionEmission]
    let out: IlWriter
    var regions: list[Region]
    var terminated: bool
    var uses_float16: bool
    ## The one dispatch point for full-Luce-only instructions: collections,
    ## classes, closures, existential boxes, and workers
    ## (profiles/full/backends/qbe_emission.luc).
    let full: FullProfileQbeEmission
    # Every distinct trap message, emitted as data after the functions.
    let trap_messages: list[str]
    let trap_message_index: map[str, i64]

    init(program: MirProgram, clock: (func() -> i64)?):
        self.program = program
        self.layout = TypeLayout(program.types, qbe_layout_rules())
        self.clock = clock
        self.function_emissions = list[FunctionEmission]()
        self.out = IlWriter()
        self.regions = list[Region]()
        self.terminated = false
        self.uses_float16 = false
        self.full = FullProfileQbeEmission(program, self.layout, self.out)
        self.trap_messages = list[str]()
        self.trap_message_index = map[str, i64]()

    ## Reset the per-function region and termination state; the profile's
    ## process entry starts from the same clean slate as every function.
    pub func begin_function_emission():
        self.regions = list[Region]()
        self.terminated = false

    pub func is_terminated() -> bool:
        return self.terminated

    func emit() -> TextEmission!:
        try self.emit_c_abi_types()
        try self.emit_data()
        try self.emit_globals()
        for index in range(0, len(self.program.functions)):
            let output_start = self.out.length
            let started = self.clock_ms()
            try self.emit_function(FunctionId(value = u32(index)), self.program.functions[index])
            self.function_emissions.append(FunctionEmission(
                function = FunctionId(value = u32(index)),
                code_bytes = u64(self.out.length - output_start),
                codegen_time_ms = self.elapsed_ms(started),
            ))
        if self.program.process_entry != none: try self.full.emit_process_entry(self)
        try self.full.emit_helpers()
        if self.uses_float16: self.out.write(qbe_float16_helpers() + "\n\n")
        self.emit_trap_messages()
        return TextEmission(text = self.out.finish(), functions = self.function_emissions)

    func clock_ms() -> i64:
        if self.clock == none: return 0
        let read = self.clock else trap("QBE emission clock disappeared")
        return read()

    func elapsed_ms(start: i64) -> i64:
        if self.clock == none: return 0
        let elapsed = self.clock_ms() - start
        if elapsed < 0: return 0
        return elapsed

    # mark: File-scope definitions -------------------------------------------------------------

    # QBE owns the concrete aggregate vocabulary used to ask its C ABI
    # classifier about exported records. Canonical MIR supplies only ordered
    # structural fields; this backend chooses QBE type names and storage atoms.
    func emit_c_abi_types() -> !:
        let states = list[i64]()
        for value in self.program.types.definitions: states.append(0)
        for function in self.program.functions:
            if function.convention != CallingConvention.c: continue
            for parameter in function.signature.parameters: try self.emit_c_abi_type(parameter, states)
            for result in function.signature.results: try self.emit_c_abi_type(result, states)
        # A callback obtained from C can be invoked without any named extern
        # or locally generated C wrapper carrying its complete signature.
        # Discover those structural ABI types from the canonical indirect call.
        for function in self.program.functions:
            for instruction in function.body:
                match instruction.form:
                    CallIndirect(results, signature, convention, target, arguments):
                        if convention != CallingConvention.c: continue
                        for parameter in signature.parameters: try self.emit_c_abi_type(parameter, states)
                        for result in signature.results: try self.emit_c_abi_type(result, states)
                    else: pass
        for external in self.program.externs:
            if external.convention != CallingConvention.c: continue
            for parameter in external.signature.parameters: try self.emit_c_abi_type(parameter, states)
            for result in external.signature.results: try self.emit_c_abi_type(result, states)

    func emit_c_abi_type(value_type: TypeId, states: list[i64]) -> !:
        if not is_aggregate_type(self.program.types, value_type): return
        if states[value_type.value] == 2: return
        if states[value_type.value] == 1: error("qbe backend: recursive C aggregate type")
        states[value_type.value] = 1
        match mir_type(self.program.types, value_type):
            Struct(fields):
                for field in fields: try self.emit_c_abi_type(field.value_type, states)
                self.out.write("type " + qbe_aggregate_type_name(value_type) + " = {")
                for index in range(0, len(fields)):
                    if index > 0: self.out.write(",")
                    self.out.write(" " + try self.c_abi_storage_type(fields[index].value_type))
                self.out.write(" }\n")
            Array(element, count):
                try self.emit_c_abi_type(element, states)
                self.out.write("type " + qbe_aggregate_type_name(value_type) + " = { " + try self.c_abi_storage_type(element) + " " + str(count) + " }\n")
            else: error("qbe backend: unsupported C aggregate `" + describe_mir_type(self.program.types, value_type) + "`")
        states[value_type.value] = 2
        self.out.write("\n")

    func c_abi_storage_type(value_type: TypeId) -> str!:
        if is_aggregate_type(self.program.types, value_type): return qbe_aggregate_type_name(value_type)
        match mir_type(self.program.types, value_type):
            Int(bits, is_signed):
                if bits == 8: return "b"
                if bits == 16: return "h"
                if bits == 32: return "w"
                if bits == 64: return "l"
            PointerInt(is_signed): return "l"
            Float(bits):
                if bits == 32: return "s"
                if bits == 64: return "d"
            Bool: return "b"
            Ptr: return "l"
            NullablePtr: return "l"
            else: pass
        error("qbe backend: unsupported C aggregate field `" + describe_mir_type(self.program.types, value_type) + "`")

    func emit_data() -> !:
        var emitted = false
        if self.has_runtime_arena():
            self.out.write("data $luce_rt_arena_storage = align 16 { z " + str(qbe_arena_capacity) + " }\n")
            emitted = true
        if self.full.emit_runtime_data(self): emitted = true
        for index in range(0, len(self.program.data)):
            let item = self.program.data[index]
            self.out.write("data $d" + str(index) + " = align " + str(item.align) + " { ")
            if len(item.bytes) == 0:
                self.out.write("z 0")
            else:
                self.out.write("b")
                for byte in item.bytes: self.out.write(" " + str(byte))
            self.out.write(" }\n")
            emitted = true
        if emitted: self.out.write("\n")

    # mark: Process entry ======================================================================

    pub func function_descriptor(target: FunctionId) -> str:
        return "$luce_fd" + str(target.value)

    func has_runtime_arena() -> bool:
        for external in self.program.externs:
            if external.convention == CallingConvention.runtime and external.name == "luce_rt_arena": return true
        return false

    func has_runtime_trap() -> bool:
        for external in self.program.externs:
            if external.convention == CallingConvention.runtime and external.name == "luce_rt_trap": return true
        return false

    # Static storage: zero, or the initialiser laid out under this backend's
    # rules with `z` padding between items. `thread` asks the linker for one
    # cell per thread (base.md §6.3).
    # Stage-0 0.30 leaks a retain when a struct holding an optional union with
    # a list payload is read by index, so this walks the globals directly.
    func emit_globals() -> !:
        var index = -1
        for global in self.program.globals:
            index += 1
            let size = self.layout.size_of(global.value_type)
            let align = self.layout.align_of(global.value_type)
            var head = "data $g" + str(index)
            if global.is_thread_local: head = "thread " + head
            head = qbe_section_linkage(global.attributes) + head
            self.out.write(head + " = align " + str(align) + " { ")
            let initial = global.initial
            if initial == none:
                self.out.write("z " + str(size))
            else:
                let items = list[str]()
                let cursor = self.initializer_items(initial, global.value_type, 0, 0, items)
                if cursor < size: items.append("z " + str(size - cursor))
                self.out.write(strings.join(items, ", "))
            self.out.write(" }\n")
        if len(self.program.globals) > 0: self.out.write("\n")

    # Append the data items of one initialiser placed at `offset`; `cursor` is
    # the byte the previous item ended at, and the answer is the new cursor.
    func initializer_items(initial: MirInitializer, value_type: TypeId, offset: i64, cursor: i64, items: list[str]) -> i64:
        var position = cursor
        if offset > position:
            items.append("z " + str(offset - position))
            position = offset
        match initial:
            Constant(value, constant_type):
                let size = self.layout.size_of(constant_type)
                var bits = u64(0)
                match value:
                    SignedInt(item): bits = bits_of_signed(item)
                    UnsignedInt(item): bits = item
                    Float(item): bits = ieee_float_bits(item, size * 8)
                    Bool(item):
                        if item: bits = u64(1)
                    Null: bits = u64(0)
                if size < 8: bits = bits & ((u64(1) << u64(size * 8)) - u64(1))
                items.append(qbe_data_kind(size) + " " + str(bits))
                position += size
            Aggregate(aggregate_type, parts):
                let placements = self.aggregate_placements(aggregate_type, len(parts))
                for index in range(0, len(parts)):
                    position = self.initializer_items(parts[index], placements.member_types[index], offset + placements.offsets[index], position, items)
            Member(union_type, member, parts):
                let member_type = self.union_member_type(union_type, member)
                position = self.initializer_items(parts[0], member_type, offset, position, items)
            Zero(zero_type):
                let size = self.layout.size_of(zero_type)
                items.append("z " + str(size))
                position += size
            Layout(query, subject, field, answer_type):
                let size = self.layout.size_of(answer_type)
                items.append(qbe_data_kind(size) + " " + str(self.layout.answer(query, subject, field)))
                position += size
            GlobalAddress(global):
                items.append("l $g" + str(global.value))
                position += 8
            FunctionAddress(function):
                items.append("l $" + self.function_name(function))
                position += 8
            DataAddress(data):
                items.append("l $d" + str(data.value))
                position += 8
        return position

    # Where each part of a struct or array initialiser lands.
    # Verified MIR never places an aggregate initialiser on a scalar.
    func aggregate_placements(aggregate_type: TypeId, count: i64) -> AggregatePlacements:
        let member_types = list[TypeId]()
        let offsets = list[i64]()
        match mir_type(self.program.types, aggregate_type):
            Struct(fields):
                for index in range(0, count):
                    member_types.append(fields[index].value_type)
                    offsets.append(self.layout.field_offset(aggregate_type, index))
            Array(element, elements):
                let stride = self.layout.size_of(element)
                for index in range(0, count):
                    member_types.append(element)
                    offsets.append(index * stride)
            else: trap("verified aggregate initialiser on a non-aggregate type")
        return AggregatePlacements(member_types = member_types, offsets = offsets)

    func union_member_type(union_type: TypeId, member: i64) -> TypeId:
        match mir_type(self.program.types, union_type):
            Union(members): return members[member].value_type
            else: trap("verified member initialiser on a non-union type")

    # mark: Functions --------------------------------------------------------------------------

    func emit_function(id: FunctionId, function: MirFunction) -> !:
        if len(function.signature.results) > 1 and not function.signature.is_fallible:
            error("qbe backend: multiple results are not implemented for `" + function.name + "`")
        if function.signature.is_fallible and len(function.signature.results) > 2:
            error("qbe backend: fallible function `" + function.name + "` has an invalid verified signature")

        self.begin_function_emission()
        self.full.begin_function()
        if function.is_exported: self.out.write("export ")
        self.out.write(qbe_section_linkage(function.attributes) + "function")
        if function.signature.is_fallible:
            self.out.write(" l")
        elif len(function.signature.results) == 1:
            if function.convention == CallingConvention.c:
                self.out.write(" " + try self.abi_type(function.signature.results[0]))
            else:
                self.out.write(" " + try self.base_type(function.signature.results[0]))
        self.out.write(" $" + self.function_name(id) + "(")
        for index in range(0, len(function.signature.parameters)):
            if index > 0: self.out.write(", ")
            if function.convention == CallingConvention.c:
                self.out.write(try self.abi_type(function.signature.parameters[index]) + " %r" + str(index))
            else:
                self.out.write(try self.base_type(function.signature.parameters[index]) + " %r" + str(index))
        if function.signature.is_fallible and len(function.signature.results) == 2:
            if len(function.signature.parameters) > 0: self.out.write(", ")
            self.out.write("l %q_result_out")
        self.out.write(") {\n@start\n")

        for instruction in function.body:
            try self.emit_instruction(function, instruction.form)
        if len(self.regions) != 0: error("qbe backend: unterminated MIR region in `" + function.name + "`")
        if not self.terminated: error("qbe backend: function `" + function.name + "` has no terminating instruction")
        self.out.write("}\n\n")

    func emit_instruction(function: MirFunction, form: InstructionForm) -> !:
        match form:
            Block(results): self.open_block(results)
            Loop: self.open_loop()
            If(condition, results):
                self.ensure_open_block()
                self.open_if(condition, results)
            Else: try self.emit_else()
            End: try self.close_region()
            Switch(tag): error("qbe backend: `Switch` is not implemented")
            Case(value): error("qbe backend: `Case` outside a supported switch")
            Default: error("qbe backend: `Default` outside a supported switch")
            Br(depth, values):
                self.ensure_open_block()
                try self.emit_branch(function, depth, values)
            BrIf(condition, depth, values):
                self.ensure_open_block()
                try self.emit_conditional_branch(function, condition, depth, values)
            Yield(values):
                self.ensure_open_block()
                try self.emit_branch(function, 0, values)
            Return(values):
                self.ensure_open_block()
                self.full.emit_return_cleanup(self)
                try self.emit_return(function, values)
            Raise(failure):
                self.ensure_open_block()
                self.full.emit_return_cleanup(self)
                self.terminate("\tret " + self.reg(failure) + "\n")
            Trap(reason):
                self.ensure_open_block()
                self.emit_trap(reason)
            Unreachable:
                if not self.terminated: self.terminate("\thlt\n")
            else:
                self.ensure_open_block()
                try self.emit_operation(function, form)

    # mark: Straight-line operations -----------------------------------------------------------

    func emit_operation(function: MirFunction, form: InstructionForm) -> !:
        match form:
            Const(result, value):
                let value_type = self.register_type(function, result)
                if self.is_float16(value_type):
                    let raw = self.out.temp()
                    match value:
                        Float(item):
                            self.out.line(raw + " =d copy d_" + str(item))
                            self.emit_float64_to_float16(self.reg(result), raw)
                        else: error("qbe backend: Float(16) constant is not floating")
                else:
                    self.out.line(self.reg(result) + " =" + try self.base_type(value_type) + " copy " + try self.constant(function, result, value))
            Copy(result, source):
                self.out.line(self.reg(result) + " =" + try self.base_type(self.register_type(function, result)) + " copy " + self.reg(source))
            Binary(result, operation, left, right):
                try self.emit_binary(function, result, operation, left, right)
            Unary(result, operation, operand):
                try self.emit_unary(function, result, operation, operand)
            Convert(result, operation, operand):
                try self.emit_convert(function, result, operation, operand)
            FloatBits(result, operand):
                let source = self.register_type(function, operand)
                if self.bits(source) == 16:
                    let raw = self.emit_float16_bits(self.reg(operand))
                    self.out.line(self.reg(result) + " =l extuw " + raw)
                elif self.bits(source) == 32:
                    let raw = self.out.temp()
                    self.out.line(raw + " =w cast " + self.reg(operand))
                    self.out.line(self.reg(result) + " =l extuw " + raw)
                else:
                    self.out.line(self.reg(result) + " =l cast " + self.reg(operand))
            PointerDifference(result, element_type, left, right):
                let byte_span = self.out.temp()
                self.out.line(byte_span + " =l sub " + self.reg(left) + ", " + self.reg(right))
                self.out.line(self.reg(result) + " =l div " + byte_span + ", " + str(self.layout.size_of(element_type)))
            PointerHash(result, operand):
                let first = self.out.temp()
                let second = self.out.temp()
                self.out.line(first + " =l xor " + self.reg(operand) + ", -7046029254386353131")
                self.out.line(second + " =l shr " + first + ", 33")
                self.out.line(self.reg(result) + " =l xor " + first + ", " + second)
            LayoutConstant(result, query, subject, field):
                self.out.line(self.reg(result) + " =l copy " + str(self.layout.answer(query, subject, field)))
            Alloca(result, slot):
                if slot < 0 or slot >= len(function.slots): error("qbe backend: invalid slot in `" + function.name + "`")
                let value_type = function.slots[slot].value_type
                let align = self.layout.align_of(value_type)
                var instruction = "alloc4"
                if align > 8: instruction = "alloc16"
                elif align > 4: instruction = "alloc8"
                self.out.line(self.reg(result) + " =l " + instruction + " " + str(self.layout.size_of(value_type)))
            AllocateStorage(result, element_type, count):
                self.emit_allocate_storage(result, element_type, count)
            DeallocateStorage(address, element_type, count):
                self.emit_deallocate_storage(address, element_type, count)
            Load(result, value_type, address):
                try self.emit_load(self.reg(result), value_type, self.reg(address))
            Store(value_type, address, value):
                try self.emit_store(value_type, self.reg(address), self.reg(value))
            VolatileLoad(result, value_type, address):
                try self.emit_volatile_load(self.reg(result), value_type, self.reg(address))
            VolatileStore(value_type, address, value):
                try self.emit_volatile_store(value_type, self.reg(address), self.reg(value))
            AtomicLoad(result, value_type, address, order):
                let width = self.layout.size_of(value_type)
                self.out.line(self.reg(result) + " =" + volatile_word_class(width, is_signed_int_type(self.program.types, value_type)) + " call $__atomic_load_" + str(width) + "(l " + self.reg(address) + ", w " + str(c_memory_order(order)) + ")")
            AtomicStore(value_type, address, value, order):
                let width = self.layout.size_of(value_type)
                self.out.line("call $__atomic_store_" + str(width) + "(l " + self.reg(address) + ", " + volatile_register_class(width) + " " + self.reg(value) + ", w " + str(c_memory_order(order)) + ")")
            AtomicUpdate(result, operation, value_type, address, value, order):
                let width = self.layout.size_of(value_type)
                var name = "__atomic_exchange_"
                var is_extreme = false
                match operation:
                    add: name = "__atomic_fetch_add_"
                    sub: name = "__atomic_fetch_sub_"
                    bit_or: name = "__atomic_fetch_or_"
                    bit_and: name = "__atomic_fetch_and_"
                    bit_xor: name = "__atomic_fetch_xor_"
                    swap: name = "__atomic_exchange_"
                    maximum: is_extreme = true
                    minimum: is_extreme = true
                if is_extreme:
                    try self.emit_atomic_extreme(result, operation == AtomicOp.maximum, value_type, address, value, order)
                else:
                    self.out.line(self.reg(result) + " =" + volatile_word_class(width, is_signed_int_type(self.program.types, value_type)) + " call $" + name + str(width) + "(l " + self.reg(address) + ", " + volatile_register_class(width) + " " + self.reg(value) + ", w " + str(c_memory_order(order)) + ")")
            AtomicCompareExchange(exchanged, observed, value_type, address, expected, desired, success, failure, is_weak):
                # The library reads the expectation from memory and leaves the
                # value it observed there.
                let width = self.layout.size_of(value_type)
                let slot = self.out.temp()
                self.out.line(slot + " =l alloc8 8")
                try self.emit_store(value_type, slot, self.reg(expected))
                var weak_flag = "0"
                if is_weak: weak_flag = "1"
                self.out.line(self.reg(exchanged) + " =w call $__atomic_compare_exchange_" + str(width) + "(l " + self.reg(address) + ", l " + slot + ", " + volatile_register_class(width) + " " + self.reg(desired) + ", w " + weak_flag + ", w " + str(c_memory_order(success)) + ", w " + str(c_memory_order(failure)) + ")")
                try self.emit_load(self.reg(observed), value_type, slot)
            FieldAddress(result, struct_type, base, field):
                self.out.line(self.reg(result) + " =l add " + self.reg(base) + ", " + str(self.layout.field_offset(struct_type, field)))
            EnumPayloadAddress(result, enum_type, base):
                self.out.line(self.reg(result) + " =l add " + self.reg(base) + ", " + str(self.layout.enum_payload_offset(enum_type)))
            ElementAddress(result, element_type, base, index):
                let scaled = self.out.temp()
                self.out.line(scaled + " =l mul " + self.reg(index) + ", " + str(self.layout.size_of(element_type)))
                self.out.line(self.reg(result) + " =l add " + self.reg(base) + ", " + scaled)
            Memcpy(destination, source, value_type):
                self.out.line("blit " + self.reg(source) + ", " + self.reg(destination) + ", " + str(self.layout.size_of(value_type)))
            Zero(address, value_type):
                # Word stores, then the tail: QBE has no fill instruction.
                var written = 0
                let size = self.layout.size_of(value_type)
                while written + 8 <= size:
                    self.out.line("storel 0, " + self.address_at(self.reg(address), written))
                    written += 8
                while written + 4 <= size:
                    self.out.line("storew 0, " + self.address_at(self.reg(address), written))
                    written += 4
                while written < size:
                    self.out.line("storeb 0, " + self.address_at(self.reg(address), written))
                    written += 1
            MoveElements(destination, source, element_type, count):
                self.emit_move_elements(destination, source, element_type, count)
            DataAddress(result, data):
                self.out.line(self.reg(result) + " =l copy $d" + str(data.value))
            GlobalAddress(result, global):
                # A thread-local cell is reached through the target's TLS
                # sequence, which QBE emits for a `thread` symbol reference.
                if self.program.globals[global.value].is_thread_local:
                    self.out.line(self.reg(result) + " =l copy thread $g" + str(global.value))
                else:
                    self.out.line(self.reg(result) + " =l copy $g" + str(global.value))
            LoadExternalGlobal(result, global):
                let declaration = self.program.external_globals[global.value]
                try self.emit_load(self.reg(result), declaration.value_type, "extern $" + declaration.name)
            StoreExternalGlobal(global, value):
                let declaration = self.program.external_globals[global.value]
                try self.emit_store(declaration.value_type, "extern $" + declaration.name, self.reg(value))
            FunctionAddress(result, target):
                self.out.line(self.reg(result) + " =l copy $" + self.function_name(target))
            ExternAddress(result, target):
                # An imported symbol used as data needs QBE's explicit
                # GOT/PIC address form; a direct `call $name` does not.
                self.out.line(self.reg(result) + " =l copy extern $" + self.program.externs[target.value].name)
            FunctionNull(destination, function_type):
                self.out.line("storel 0, " + self.reg(destination))
                let environment = self.out.temp()
                self.out.line(environment + " =l add " + self.reg(destination) + ", 8")
                self.out.line("storel 0, " + environment)
            FunctionValue(destination, function_type, target):
                self.out.line("storel $" + self.function_name(target) + ", " + self.reg(destination))
                let environment = self.out.temp()
                self.out.line(environment + " =l add " + self.reg(destination) + ", 8")
                self.out.line("storel 0, " + environment)
            Call(results, target, arguments):
                let called = self.program.functions[target.value]
                try self.emit_call(function, results, "$" + self.function_name(target), called.signature, called.convention, arguments)
            CallExtern(results, external, arguments):
                let symbol = self.program.externs[external.value]
                if symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_arena":
                    try self.emit_runtime_arena(function, results, arguments)
                elif symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_write":
                    try self.emit_runtime_write(function, arguments, 1)
                elif symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_trap":
                    if arguments.count != 2: error("qbe backend: verified runtime trap has an invalid call shape")
                    let data = register_at(function, arguments, 0)
                    let length = register_at(function, arguments, 1)
                    if self.full.emit_trap_call(self.reg(data), self.reg(length)):
                        pass
                    else:
                        try self.emit_runtime_write(function, arguments, 2)
                        self.out.line("call $write(w 2, l $luce_rt_trap_newline, l 1)")
                    self.terminate("\thlt\n")
                else:
                    try self.emit_call(function, results, "$" + symbol.name, symbol.signature, symbol.convention, arguments)
            CallIndirect(results, signature, convention, target, arguments):
                try self.emit_call(function, results, self.reg(target), signature, convention, arguments)
            BufferRetain(value):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_retain) else trap("verified `BufferRetain` has no runtime binding")
                self.out.line("call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            BufferRelease(value):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_release) else trap("verified `BufferRelease` has no runtime binding")
                self.out.line("call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            BufferConcat(result, left_data, left_length, right_data, right_length):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_concat) else trap("verified `BufferConcat` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(left_data) + ", l " + self.reg(left_length) + ", l " + self.reg(right_data) + ", l " + self.reg(right_length) + ")")
            BufferData(result, owner):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_data) else trap("verified `BufferData` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(owner) + ")")
            BufferLength(result, owner):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_length) else trap("verified `BufferLength` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(owner) + ")")
            BufferBuilderCreate(result):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_builder_create) else trap("verified `BufferBuilderCreate` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "()")
            BufferBuilderAppend(builder, data, length):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_builder_append) else trap("verified `BufferBuilderAppend` has no runtime binding")
                self.out.line("call $" + self.function_name(service) + "(l " + self.reg(builder) + ", l " + self.reg(data) + ", l " + self.reg(length) + ")")
            BufferBuilderFinish(result, builder):
                let service = find_runtime_binding(self.program, RuntimeService.buffer_builder_finish) else trap("verified `BufferBuilderFinish` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(builder) + ")")
            CStringCopy(result, source):
                let service = find_runtime_binding(self.program, RuntimeService.c_string_copy) else trap("verified `CStringCopy` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(source) + ")")
            DisplaySigned(result, value): self.emit_display_call(result, value, RuntimeService.display_signed, "l")
            DisplayUnsigned(result, value): self.emit_display_call(result, value, RuntimeService.display_unsigned, "l")
            DisplayFloat(result, value):
                let value_type = self.register_type(function, value)
                if self.bits(value_type) == 32:
                    self.emit_display_call(result, value, RuntimeService.display_float32, "s")
                else:
                    self.emit_display_call(result, value, RuntimeService.display_float64, "d")
            DisplayCharacter(result, value): self.emit_display_call(result, value, RuntimeService.display_character, "w")
            DisplayBoolean(result, value): self.emit_display_call(result, value, RuntimeService.display_boolean, "w")
            StringScalarCount(result, data, length):
                let service = find_runtime_binding(self.program, RuntimeService.string_scalar_count) else trap("verified `StringScalarCount` has no runtime binding")
                self.out.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(data) + ", l " + self.reg(length) + ")")
            StringDecode(character, width, data, length, offset):
                let service = find_runtime_binding(self.program, RuntimeService.string_decode) else trap("verified `StringDecode` has no runtime binding")
                let decoded = self.out.temp()
                self.out.line(decoded + " =l call $" + self.function_name(service) + "(l " + self.reg(data) + ", l " + self.reg(length) + ", l " + self.reg(offset) + ")")
                self.out.line(self.reg(character) + " =w copy " + decoded)
                self.out.line(self.reg(width) + " =l shr " + decoded + ", 32")
            else:
                if not try self.full.emit_operation(self, function, form):
                    error("qbe backend: internal operation dispatch failure")

    # QBE's native oracle uses the host's write(2) directly. A language trap
    # reports to stderr and terminates in this backend; ordinary output uses
    # stdout and continues.
    func emit_runtime_write(function: MirFunction, arguments: RegisterRun, descriptor: i64) -> !:
        if arguments.count != 2: error("qbe backend: verified runtime write has an invalid call shape")
        self.out.write("\tcall $write(w " + str(descriptor))
        for index in range(0, i64(arguments.count)):
            let argument = register_at(function, arguments, index)
            self.out.write(", " + try self.base_type(self.register_type(function, argument)) + " " + self.reg(argument))
        self.out.write(")\n")

    ## Emit one private runtime operation whose complete physical contract is
    ## a pointer-shaped handle and no result. The service identity remains
    ## semantic until this backend selects QBE's `l` representation.
    pub func emit_pointer_runtime_call(service: RuntimeService, value: RegisterId, instruction: str):
        let target = find_runtime_binding(self.program, service) else trap("verified `" + instruction + "` has no runtime binding")
        self.out.line("call $" + self.function_name(target) + "(l " + self.reg(value) + ")")

    pub func emit_display_call(result: RegisterId, value: RegisterId, service: RuntimeService, qbe_type: str):
        let target = find_runtime_binding(self.program, service) else trap("verified display operation has no runtime binding")
        self.out.line(self.reg(result) + " =l call $" + self.function_name(target) + "(" + qbe_type + " " + self.reg(value) + ")")

    # Ensure the requested byte prefix fits the backend-owned reservation and
    # return its stable base. Precommitted/BSS storage is a valid monotonic
    # provider: every later prefix is already readable and writable.
    func emit_runtime_arena(function: MirFunction, results: RegisterRun, arguments: RegisterRun) -> !:
        if results.count != 1 or arguments.count != 1:
            error("qbe backend: verified arena service has an invalid call shape")
        let requested_end = register_at(function, arguments, 0)
        let outside = self.out.temp()
        self.out.line(outside + " =w cugtl " + self.reg(requested_end) + ", " + str(qbe_arena_capacity))
        self.emit_guard(outside, "arena capacity exceeded")
        let result = register_at(function, results, 0)
        self.out.line(self.reg(result) + " =l copy $luce_rt_arena_storage")

    # mark: Isolated tasks ---------------------------------------------------------------------

    pub func emit_stack_allocation(value_type: TypeId) -> str:
        let align = self.layout.align_of(value_type)
        var instruction = "alloc4"
        if align > 8: instruction = "alloc16"
        elif align > 4: instruction = "alloc8"
        var size = self.layout.size_of(value_type)
        if size == 0: size = 1
        let result = self.out.temp()
        self.out.line(result + " =l " + instruction + " " + str(size))
        return result

    pub func address_text(base: str, offset: i64) -> str:
        if offset == 0: return base
        let result = self.out.temp()
        self.out.line(result + " =l add " + base + ", " + str(offset))
        return result

    # Count zero is the canonical null storage token. A positive allocation
    # keeps the element type until this boundary, where its target layout is
    # checked and passed to the composed allocator as bytes plus alignment.
    func emit_allocate_storage(result: RegisterId, element_type: TypeId, count: RegisterId):
        let allocator = find_runtime_binding(self.program, RuntimeService.storage_allocator) else trap("verified `AllocateStorage` has no runtime binding")
        let empty = self.out.new_label("allocation_empty")
        let reserve = self.out.new_label("allocation_reserve")
        let complete = self.out.new_label("allocation_complete")
        let is_empty = self.out.temp()
        self.out.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + empty + ", @" + reserve + "\n")
        self.label(empty)
        self.out.line(self.reg(result) + " =l copy 0")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(reserve)

        let element_size = self.layout.size_of(element_type)
        var byte_count = "1"
        if element_size > 0: byte_count = self.emit_scaled_byte_count(count, element_size)
        let alignment = self.storage_alignment(element_type)
        self.out.line(self.reg(result) + " =l call $" + self.function_name(allocator) + "(l " + byte_count + ", l " + str(alignment) + ")")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    # Count zero owns no block. Positive requests use exactly the same
    # backend-normalized byte class as allocation, including pointer alignment
    # so the freestanding runtime can store an intrusive free-list link.
    func emit_deallocate_storage(address: RegisterId, element_type: TypeId, count: RegisterId):
        let deallocator = find_runtime_binding(self.program, RuntimeService.storage_deallocator) else trap("verified `DeallocateStorage` has no runtime binding")
        let release = self.out.new_label("deallocation_release")
        let complete = self.out.new_label("deallocation_complete")
        let is_empty = self.out.temp()
        self.out.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + complete + ", @" + release + "\n")
        self.label(release)
        let element_size = self.layout.size_of(element_type)
        var byte_count = "1"
        if element_size > 0: byte_count = self.emit_scaled_byte_count(count, element_size)
        let alignment = self.storage_alignment(element_type)
        self.out.line("call $" + self.function_name(deallocator) + "(l " + self.reg(address) + ", l " + byte_count + ", l " + str(alignment) + ")")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    pub func storage_alignment(element_type: TypeId) -> i64:
        return self.recycling_alignment(self.layout.align_of(element_type))

    pub func recycling_alignment(alignment: i64) -> i64:
        let pointer_alignment = self.layout.pointer_align()
        if alignment < pointer_alignment: return pointer_alignment
        return alignment

    pub func emit_index_guard(value: RegisterId, index: RegisterId, allow_end: bool, length_service: FunctionId):
        let length = self.out.temp()
        self.out.line(length + " =l call $" + self.function_name(length_service) + "(l " + self.reg(value) + ")")
        let invalid = self.out.temp()
        if allow_end:
            self.out.line(invalid + " =w cugtl " + self.reg(index) + ", " + length)
        else:
            let valid = self.out.temp()
            self.out.line(valid + " =w cultl " + self.reg(index) + ", " + length)
            self.out.line(invalid + " =w ceqw " + valid + ", 0")
        self.emit_guard(invalid, "index out of bounds")

    pub func emit_slice_bounds_guard(length: RegisterId, start: RegisterId, end: RegisterId):
        self.emit_slice_bounds_guard_text(self.reg(length), start, end)

    pub func emit_slice_bounds_guard_text(length: str, start: RegisterId, end: RegisterId):
        let reversed = self.out.temp()
        self.out.line(reversed + " =w cugtl " + self.reg(start) + ", " + self.reg(end))
        let past_end = self.out.temp()
        self.out.line(past_end + " =w cugtl " + self.reg(end) + ", " + length)
        let invalid = self.out.temp()
        self.out.line(invalid + " =w or " + reversed + ", " + past_end)
        self.emit_guard(invalid, "slice bounds out of range")

    # Preserve overlap semantics by selecting the host's move primitive only
    # after target layout has turned a structural element count into bytes.
    func emit_move_elements(destination: RegisterId, source: RegisterId, element_type: TypeId, count: RegisterId):
        let element_size = self.layout.size_of(element_type)
        if element_size == 0: return
        let empty = self.out.new_label("move_empty")
        let moving = self.out.new_label("move_elements")
        let is_empty = self.out.temp()
        self.out.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + empty + ", @" + moving + "\n")
        self.label(moving)
        let byte_count = self.emit_scaled_byte_count(count, element_size)
        self.out.line("call $memmove(l " + self.reg(destination) + ", l " + self.reg(source) + ", l " + byte_count + ")")
        self.terminate("\tjmp @" + empty + "\n")
        self.label(empty)

    func emit_scaled_byte_count(count: RegisterId, element_size: i64) -> str:
        if element_size == 1: return self.reg(count)
        let byte_count = self.out.temp()
        self.out.line(byte_count + " =l mul " + self.reg(count) + ", " + str(element_size))
        let quotient = self.out.temp()
        self.out.line(quotient + " =l udiv " + byte_count + ", " + str(element_size))
        let wrapped = self.out.temp()
        self.out.line(wrapped + " =w cnel " + quotient + ", " + self.reg(count))
        self.emit_guard(wrapped, "allocation size overflow")
        let outside_mir = self.out.temp()
        self.out.line(outside_mir + " =w csltl " + byte_count + ", 0")
        self.emit_guard(outside_mir, "allocation size overflow")
        return byte_count

    pub func emit_call(function: MirFunction, results: RegisterRun, target: str, signature: MirSignature, convention: CallingConvention, arguments: RegisterRun) -> !:
        try self.emit_call_with_environment(function, results, target, signature, convention, arguments, none)

    pub func emit_call_with_environment(function: MirFunction, results: RegisterRun, target: str, signature: MirSignature, convention: CallingConvention, arguments: RegisterRun, environment: str?) -> !:
        if results.count > 1 and not signature.is_fallible: error("qbe backend: multiple call results are not implemented")
        var result_storage = ""
        if signature.is_fallible and results.count == 2:
            let value_result = register_at(function, results, 0)
            let value_type = self.register_type(function, value_result)
            result_storage = self.out.temp()
            var allocation = "alloc4"
            let align = self.layout.align_of(value_type)
            if align > 8: allocation = "alloc16"
            elif align > 4: allocation = "alloc8"
            self.out.line(result_storage + " =l " + allocation + " " + str(self.layout.size_of(value_type)))
        self.out.write("\t")
        if signature.is_fallible:
            let error_result = register_at(function, results, i64(results.count) - 1)
            self.out.write(self.reg(error_result) + " =l ")
        elif results.count == 1:
            let result = register_at(function, results, 0)
            if convention == CallingConvention.c and is_aggregate_type(self.program.types, signature.results[0]):
                self.out.write(self.reg(result) + " =" + try self.abi_type(signature.results[0]) + " ")
            else:
                self.out.write(self.reg(result) + " =" + try self.base_type(self.register_type(function, result)) + " ")
        self.out.write("call " + target + "(")
        var written = 0
        var environment_index: i64 = 0
        if signature.is_fallible: environment_index = 1
        for index in range(0, i64(arguments.count)):
            if environment != none and index == environment_index:
                if written > 0: self.out.write(", ")
                self.out.write("l " + environment)
                written += 1
            if written > 0: self.out.write(", ")
            let argument = register_at(function, arguments, index)
            if convention == CallingConvention.c:
                self.out.write(try self.abi_type(signature.parameters[index]) + " " + self.reg(argument))
            else:
                self.out.write(try self.base_type(self.register_type(function, argument)) + " " + self.reg(argument))
            written += 1
        if environment != none and environment_index == i64(arguments.count):
            if written > 0: self.out.write(", ")
            self.out.write("l " + environment)
            written += 1
        if result_storage != "":
            if written > 0: self.out.write(", ")
            self.out.write("l " + result_storage)
        self.out.write(")\n")
        if result_storage != "":
            let value_result = register_at(function, results, 0)
            let value_type = self.register_type(function, value_result)
            try self.emit_load(self.reg(value_result), value_type, result_storage)

    # mark: Arithmetic -------------------------------------------------------------------------

    func emit_binary(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, left)
        if operation == BinaryOp.eq or operation == BinaryOp.ne or operation == BinaryOp.lt or operation == BinaryOp.le or operation == BinaryOp.gt or operation == BinaryOp.ge:
            try self.emit_comparison(function, result, operation, left, right)
            return
        if is_float_type(self.program.types, value_type):
            var name = ""
            match operation:
                add: name = "add"
                sub: name = "sub"
                mul: name = "mul"
                div: name = "div"
                else: error("qbe backend: floating `" + str(operation) + "` is not implemented")
            if self.is_float16(value_type):
                let raw = self.out.temp()
                self.out.line(raw + " =s " + name + " " + self.reg(left) + ", " + self.reg(right))
                self.emit_float16_round(self.reg(result), raw)
            else:
                self.out.line(self.reg(result) + " =" + try self.base_type(value_type) + " " + name + " " + self.reg(left) + ", " + self.reg(right))
            return
        if not is_int_type(self.program.types, value_type): error("qbe backend: binary operation on `" + describe_mir_type(self.program.types, value_type) + "`")

        match operation:
            add, sub, mul: try self.emit_checked_arithmetic(function, result, operation, left, right)
            floor_div: try self.emit_integer_division(function, result, left, right, false, false)
            rem: try self.emit_integer_division(function, result, left, right, true, false)
            trunc_div: try self.emit_integer_division(function, result, left, right, false, true)
            trunc_rem: try self.emit_integer_division(function, result, left, right, true, true)
            add_wrap: self.emit_integer_result(function, result, "add", left, right)
            sub_wrap: self.emit_integer_result(function, result, "sub", left, right)
            mul_wrap: self.emit_integer_result(function, result, "mul", left, right)
            add_overflows: try self.emit_overflow_test(function, result, BinaryOp.add, left, right)
            sub_overflows: try self.emit_overflow_test(function, result, BinaryOp.sub, left, right)
            mul_overflows: try self.emit_overflow_test(function, result, BinaryOp.mul, left, right)
            add_sat: try self.emit_saturating_arithmetic(function, result, BinaryOp.add, left, right)
            sub_sat: try self.emit_saturating_arithmetic(function, result, BinaryOp.sub, left, right)
            mul_sat: try self.emit_saturating_arithmetic(function, result, BinaryOp.mul, left, right)
            bit_and: self.emit_integer_result(function, result, "and", left, right)
            bit_or: self.emit_integer_result(function, result, "or", left, right)
            bit_xor: self.emit_integer_result(function, result, "xor", left, right)
            shift_left: try self.emit_shift(function, result, "shl", left, right)
            shift_right:
                var name = "shr"
                if is_signed_int_type(self.program.types, value_type): name = "sar"
                try self.emit_shift(function, result, name, left, right)
            else: error("qbe backend: integer `" + str(operation) + "` is not implemented")

    func emit_checked_arithmetic(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        let bits = self.bits(value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        var name = "add"
        if operation == BinaryOp.sub: name = "sub"
        elif operation == BinaryOp.mul: name = "mul"

        if bits < 64:
            let wide_left = try self.widen_integer(value_type, left)
            let wide_right = try self.widen_integer(value_type, right)
            let wide_result = self.out.temp()
            self.out.line(wide_result + " =l " + name + " " + wide_left + ", " + wide_right)
            try self.guard_range(value_type, wide_result)
            self.out.line(self.reg(result) + " =w copy " + wide_result)
            return

        let computed = self.reg(result)
        self.out.line(computed + " =l " + name + " " + self.reg(left) + ", " + self.reg(right))
        let bad = self.out.temp()
        try self.emit_wide_overflow_flag(bad, operation, signed, computed, left, right)
        self.emit_guard(bad, "integer overflow")

    # The wrapped result of `left op right` at the type's width and a `w` flag
    # that is non-zero exactly when the exact result does not fit; both forms
    # of base.md §7.2 that observe overflow without trapping build on this.
    func emit_overflow_flag(function: MirFunction, value_type: TypeId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> OverflowEmission!:
        let bits = self.bits(value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        var name = "add"
        if operation == BinaryOp.sub: name = "sub"
        elif operation == BinaryOp.mul: name = "mul"
        let flag = self.out.temp()
        if bits < 64:
            let wide_left = try self.widen_integer(value_type, left)
            let wide_right = try self.widen_integer(value_type, right)
            let wide_result = self.out.temp()
            self.out.line(wide_result + " =l " + name + " " + wide_left + ", " + wide_right)
            self.emit_range_flag(flag, value_type, wide_result)
            return OverflowEmission(value = wide_result, flag = flag)
        let computed = self.out.temp()
        self.out.line(computed + " =l " + name + " " + self.reg(left) + ", " + self.reg(right))
        try self.emit_wide_overflow_flag(flag, operation, signed, computed, left, right)
        return OverflowEmission(value = computed, flag = flag)

    func emit_overflow_test(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, left)
        let emission = try self.emit_overflow_flag(function, value_type, operation, left, right)
        self.out.line(self.reg(result) + " =w copy " + emission.flag)

    # Saturation lands on the bound the exact result passed: for a signed type
    # `maximum + 1` wraps to the minimum, so one add of a 0/1 sign selects it.
    func emit_saturating_arithmetic(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        let signed = is_signed_int_type(self.program.types, value_type)
        let emission = try self.emit_overflow_flag(function, value_type, operation, left, right)
        let bound = self.out.temp()
        if signed:
            let toward_minimum = self.out.temp()
            if operation == BinaryOp.add: self.out.line(toward_minimum + " =l shr " + try self.arithmetic_value(value_type, right) + ", 63")
            elif operation == BinaryOp.sub:
                let positive = self.out.temp()
                self.out.line(positive + " =w csgtl " + try self.arithmetic_value(value_type, right) + ", 0")
                self.out.line(toward_minimum + " =l extuw " + positive)
            else:
                let signs = self.out.temp()
                self.out.line(signs + " =l xor " + try self.arithmetic_value(value_type, left) + ", " + try self.arithmetic_value(value_type, right))
                self.out.line(toward_minimum + " =l shr " + signs + ", 63")
            self.out.line(bound + " =l add " + str(self.layout.int_maximum(value_type)) + ", " + toward_minimum)
        elif operation == BinaryOp.sub: self.out.line(bound + " =l copy 0")
        else: self.out.line(bound + " =l copy " + str(self.layout.uint_maximum(value_type)))
        let saturated = self.out.new_label("saturate")
        let exact = self.out.new_label("exact")
        let join = self.out.new_label("saturate_end")
        let chosen = self.out.temp()
        self.terminate("\tjnz " + emission.flag + ", @" + saturated + ", @" + exact + "\n")
        self.label(saturated)
        self.out.line(chosen + " =l copy " + bound)
        self.terminate("\tjmp @" + join + "\n")
        self.label(exact)
        self.out.line(chosen + " =l copy " + emission.value)
        self.terminate("\tjmp @" + join + "\n")
        self.label(join)
        self.canonicalize_integer(value_type, result, chosen)

    # The 64-bit overflow conditions, into `flag` (`w`, non-zero on overflow).
    func emit_wide_overflow_flag(bad: str, operation: BinaryOp, signed: bool, computed: str, left: RegisterId, right: RegisterId) -> !:
        if operation == BinaryOp.add:
            if signed:
                let a = self.out.temp()
                let b = self.out.temp()
                let both = self.out.temp()
                self.out.line(a + " =l xor " + self.reg(left) + ", " + computed)
                self.out.line(b + " =l xor " + self.reg(right) + ", " + computed)
                self.out.line(both + " =l and " + a + ", " + b)
                self.out.line(bad + " =w csltl " + both + ", 0")
            else:
                # Unsigned addition wrapped exactly when the result is below
                # either input in the machine's unsigned ordering.
                self.out.line(bad + " =w cultl " + computed + ", " + self.reg(left))
        elif operation == BinaryOp.sub:
            if signed:
                let different = self.out.temp()
                let changed = self.out.temp()
                let both = self.out.temp()
                self.out.line(different + " =l xor " + self.reg(left) + ", " + self.reg(right))
                self.out.line(changed + " =l xor " + self.reg(left) + ", " + computed)
                self.out.line(both + " =l and " + different + ", " + changed)
                self.out.line(bad + " =w csltl " + both + ", 0")
            else:
                self.out.line(bad + " =w cultl " + self.reg(left) + ", " + self.reg(right))
        else:
            if signed:
                # `minimum * -1` wraps to `minimum`, and the division check
                # below cannot see it: arm64 `sdiv minimum, -1` also yields
                # `minimum`, while amd64 raises SIGFPE instead of trapping.
                let is_minimum = self.out.temp()
                let is_negative_one = self.out.temp()
                let overflows = self.out.temp()
                self.out.line(is_minimum + " =w ceql " + self.reg(left) + ", -9223372036854775808")
                self.out.line(is_negative_one + " =w ceql " + self.reg(right) + ", -1")
                self.out.line(overflows + " =w and " + is_minimum + ", " + is_negative_one)
                # `minimum / -1` would fault on amd64, so that pair answers here
                # and never reaches the division below.
                let plain = self.out.new_label("mul_plain")
                let done = self.out.new_label("mul_done")
                self.out.line(bad + " =w copy 1")
                self.terminate("\tjnz " + overflows + ", @" + done + ", @" + plain + "\n")
                self.label(plain)
                try self.emit_multiplication_flag(bad, signed, computed, left, right)
                self.terminate("\tjmp @" + done + "\n")
                self.label(done)
                return
            try self.emit_multiplication_flag(bad, signed, computed, left, right)

    # `computed / right != left` detects a wrapped product once `right` is
    # known to be neither zero nor the one divisor that faults.
    func emit_multiplication_flag(bad: str, signed: bool, computed: str, left: RegisterId, right: RegisterId) -> !:
        if true:
            let zero = self.out.temp()
            let check = self.out.new_label("mul_check")
            let okay = self.out.new_label("mul_ok")
            self.out.line(bad + " =w copy 0")
            self.out.line(zero + " =w ceql " + self.reg(right) + ", 0")
            self.terminate("\tjnz " + zero + ", @" + okay + ", @" + check + "\n")
            self.label(check)
            let quotient = self.out.temp()
            var divide = "div"
            if not signed: divide = "udiv"
            self.out.line(quotient + " =l " + divide + " " + computed + ", " + self.reg(right))
            self.out.line(bad + " =w cnel " + quotient + ", " + self.reg(left))
            self.terminate("\tjmp @" + okay + "\n")
            self.label(okay)

    # QBE's `div`/`rem` truncate as C does; the floor forms adjust the
    # quotient afterwards when the remainder is non-zero and the signs differ.
    func emit_integer_division(function: MirFunction, result: RegisterId, left: RegisterId, right: RegisterId, wants_remainder: bool, truncating: bool) -> !:
        let value_type = self.register_type(function, result)
        let signed = is_signed_int_type(self.program.types, value_type)
        let bits = self.bits(value_type)
        let left_value = try self.arithmetic_value(value_type, left)
        let right_value = try self.arithmetic_value(value_type, right)
        let divisor_is_zero = self.out.temp()
        self.out.line(divisor_is_zero + " =w ceql " + right_value + ", 0")
        self.emit_guard(divisor_is_zero, "division by zero")

        if not wants_remainder and signed and bits == 64:
            let is_minimum = self.out.temp()
            let is_negative_one = self.out.temp()
            let overflows = self.out.temp()
            self.out.line(is_minimum + " =w ceql " + left_value + ", -9223372036854775808")
            self.out.line(is_negative_one + " =w ceql " + right_value + ", -1")
            self.out.line(overflows + " =w and " + is_minimum + ", " + is_negative_one)
            self.emit_guard(overflows, "integer overflow")

        var special_end = ""
        if wants_remainder and signed and bits == 64:
            # Luce defines minimum % -1 as zero even though the corresponding
            # division overflows. Avoid issuing the target division at all.
            let is_minimum = self.out.temp()
            let is_negative_one = self.out.temp()
            let is_special = self.out.temp()
            let special = self.out.new_label("remainder_minimum")
            let ordinary = self.out.new_label("remainder_ordinary")
            special_end = self.out.new_label("remainder_end")
            self.out.line(is_minimum + " =w ceql " + self.reg(left) + ", -9223372036854775808")
            self.out.line(is_negative_one + " =w ceql " + self.reg(right) + ", -1")
            self.out.line(is_special + " =w and " + is_minimum + ", " + is_negative_one)
            self.terminate("\tjnz " + is_special + ", @" + special + ", @" + ordinary + "\n")
            self.label(special)
            self.out.line(self.reg(result) + " =l copy 0")
            self.terminate("\tjmp @" + special_end + "\n")
            self.label(ordinary)
        var divide = "div"
        if not signed: divide = "udiv"
        let quotient = self.out.temp()
        self.out.line(quotient + " =l " + divide + " " + left_value + ", " + right_value)
        var floored = quotient
        if signed and not truncating:
            let truncated_remainder = self.out.temp()
            let nonzero = self.out.temp()
            let signs = self.out.temp()
            let negative = self.out.temp()
            let adjust = self.out.temp()
            let wide_adjust = self.out.temp()
            floored = self.out.temp()
            self.out.line(truncated_remainder + " =l rem " + left_value + ", " + right_value)
            self.out.line(nonzero + " =w cnel " + truncated_remainder + ", 0")
            self.out.line(signs + " =l xor " + left_value + ", " + right_value)
            self.out.line(negative + " =w csltl " + signs + ", 0")
            self.out.line(adjust + " =w and " + nonzero + ", " + negative)
            self.out.line(wide_adjust + " =l extuw " + adjust)
            self.out.line(floored + " =l sub " + quotient + ", " + wide_adjust)
        var value = floored
        if wants_remainder:
            let product = self.out.temp()
            value = self.out.temp()
            self.out.line(product + " =l mul " + floored + ", " + right_value)
            self.out.line(value + " =l sub " + left_value + ", " + product)
        if bits < 64:
            if not wants_remainder: try self.guard_range(value_type, value)
            self.out.line(self.reg(result) + " =w copy " + value)
        else:
            self.out.line(self.reg(result) + " =l copy " + value)
        if special_end != "": self.label(special_end)

    func emit_integer_result(function: MirFunction, result: RegisterId, operation: str, left: RegisterId, right: RegisterId):
        let value_type = self.register_type(function, result)
        let base = self.integer_base(value_type)
        let raw = self.out.temp()
        self.out.line(raw + " =" + base + " " + operation + " " + self.reg(left) + ", " + self.reg(right))
        self.canonicalize_integer(value_type, result, raw)

    func emit_shift(function: MirFunction, result: RegisterId, operation: str, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        let bits = self.bits(value_type)
        let valid = self.out.temp()
        self.out.line(valid + " =w cult" + self.integer_base(value_type) + " " + self.reg(right) + ", " + str(bits))
        let bad = self.out.temp()
        self.out.line(bad + " =w ceqw " + valid + ", 0")
        self.emit_guard(bad, "shift count is outside integer width")
        self.emit_integer_result(function, result, operation, left, right)

    func emit_comparison(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, left)
        var relation = "eq"
        match operation:
            eq: relation = "eq"
            ne: relation = "ne"
            lt: relation = "lt"
            le: relation = "le"
            gt: relation = "gt"
            ge: relation = "ge"
            else: error("qbe backend: invalid comparison")
        if is_int_type(self.program.types, value_type) and operation != BinaryOp.eq and operation != BinaryOp.ne:
            if is_signed_int_type(self.program.types, value_type): relation = "s" + relation
            else: relation = "u" + relation
        elif is_ptr_type(self.program.types, value_type) and operation != BinaryOp.eq and operation != BinaryOp.ne:
            relation = "u" + relation
        self.out.line(self.reg(result) + " =w c" + relation + try self.base_type(value_type) + " " + self.reg(left) + ", " + self.reg(right))

    func emit_unary(function: MirFunction, result: RegisterId, operation: UnaryOp, operand: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        match operation:
            neg_wrap:
                let negated = self.out.temp()
                self.out.line(negated + " =" + self.integer_base(value_type) + " sub 0, " + self.reg(operand))
                self.canonicalize_integer(value_type, result, negated)
            neg:
                if self.is_float16(value_type):
                    let raw = self.out.temp()
                    self.out.line(raw + " =s neg " + self.reg(operand))
                    self.emit_float16_round(self.reg(result), raw)
                elif is_float_type(self.program.types, value_type): self.out.line(self.reg(result) + " =" + try self.base_type(value_type) + " neg " + self.reg(operand))
                else:
                    let bits = self.bits(value_type)
                    if bits < 64:
                        let wide = try self.widen_integer(value_type, operand)
                        let negated = self.out.temp()
                        self.out.line(negated + " =l sub 0, " + wide)
                        try self.guard_range(value_type, negated)
                        self.out.line(self.reg(result) + " =w copy " + negated)
                    else:
                        let minimum = -9223372036854775807 - 1
                        let bad = self.out.temp()
                        self.out.line(bad + " =w ceql " + self.reg(operand) + ", " + str(minimum))
                        self.emit_guard(bad, "integer overflow")
                        self.out.line(self.reg(result) + " =l neg " + self.reg(operand))
            bit_not:
                let raw = self.out.temp()
                self.out.line(raw + " =" + self.integer_base(value_type) + " xor " + self.reg(operand) + ", -1")
                self.canonicalize_integer(value_type, result, raw)
            bool_not:
                self.out.line(self.reg(result) + " =w ceqw " + self.reg(operand) + ", 0")

    func emit_convert(function: MirFunction, result: RegisterId, operation: ConvertOp, operand: RegisterId) -> !:
        let source = self.register_type(function, operand)
        let destination = self.register_type(function, result)
        match operation:
            extend:
                let widened = try self.widen_integer(source, operand)
                self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + widened)
            cast_int:
                # C's cast at this target's widths: narrow, copy, or extend by
                # the source's signedness.
                if self.bits(destination) < self.bits(source):
                    self.canonicalize_integer(destination, result, self.reg(operand))
                elif self.bits(destination) == self.bits(source):
                    self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + self.reg(operand))
                else:
                    let widened = try self.widen_integer(source, operand)
                    self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + widened)
            float_to_int_saturating:
                try self.emit_saturating_float_to_integer(source, destination, result, operand)
            ptr_to_int: self.out.line(self.reg(result) + " =l copy " + self.reg(operand))
            int_to_ptr: self.out.line(self.reg(result) + " =l copy " + self.reg(operand))
            ptr_to_nullable: self.out.line(self.reg(result) + " =l copy " + self.reg(operand))
            nullable_to_ptr: self.out.line(self.reg(result) + " =l copy " + self.reg(operand))
            widen:
                # Pointer-width integers are 64 bits here: extend or copy.
                if self.bits(destination) > self.bits(source):
                    let widened = try self.widen_integer(source, operand)
                    self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + widened)
                else:
                    self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + self.reg(operand))
            wrap:
                self.canonicalize_integer(destination, result, self.reg(operand))
            int_reinterpret:
                self.out.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + self.reg(operand))
            int_to_float:
                var prefix = "u"
                if is_signed_int_type(self.program.types, source): prefix = "s"
                var width = "l"
                if self.bits(source) <= 32: width = "w"
                if self.is_float16(destination):
                    let raw = self.out.temp()
                    self.out.line(raw + " =s " + prefix + width + "tof " + self.reg(operand))
                    self.emit_float16_round(self.reg(result), raw)
                else:
                    self.out.line(self.reg(result) + " =" + try self.base_type(destination) + " " + prefix + width + "tof " + self.reg(operand))
            float_to_int:
                try self.guard_float_to_integer(source, destination, operand)
                var prefix = "d"
                if try self.base_type(source) == "s": prefix = "s"
                var sign = "ui"
                if is_signed_int_type(self.program.types, destination): sign = "si"
                let converted = self.out.temp()
                self.out.line(converted + " =" + self.integer_base(destination) + " " + prefix + "to" + sign + " " + self.reg(operand))
                if self.bits(destination) < 32:
                    let wide = self.out.temp()
                    self.out.line(wide + " =l extsw " + converted)
                    try self.guard_range(destination, wide)
                self.canonicalize_integer(destination, result, converted)
            float_resize:
                if self.is_float16(destination):
                    if self.bits(source) == 64:
                        self.emit_float64_to_float16(self.reg(result), self.reg(operand))
                    else: self.emit_float16_round(self.reg(result), self.reg(operand))
                elif self.bits(source) == 16:
                    if self.bits(destination) == 64:
                        self.out.line(self.reg(result) + " =d exts " + self.reg(operand))
                    else:
                        self.out.line(self.reg(result) + " =s copy " + self.reg(operand))
                elif self.bits(source) == 32:
                    self.out.line(self.reg(result) + " =d exts " + self.reg(operand))
                else:
                    self.out.line(self.reg(result) + " =s truncd " + self.reg(operand))

    # C's float-to-integer cast (base.md §7.5): NaN is 0, a value past either
    # bound is that bound, and anything else truncates toward zero.
    func emit_saturating_float_to_integer(source: TypeId, destination: TypeId, result: RegisterId, operand: RegisterId) -> !:
        let base = try self.base_type(source)
        let lower = self.float_integer_bound(base, destination, false)
        let upper = self.float_integer_bound(base, destination, true)
        let nan = self.out.temp()
        let below = self.out.temp()
        let above = self.out.temp()
        let zero = self.out.new_label("cast_nan")
        let low = self.out.new_label("cast_low")
        let high = self.out.new_label("cast_high")
        let convert = self.out.new_label("cast_convert")
        let test_low = self.out.new_label("cast_test_low")
        let test_high = self.out.new_label("cast_test_high")
        let done = self.out.new_label("cast_done")
        let chosen = self.out.temp()
        self.out.line(nan + " =w cne" + base + " " + self.reg(operand) + ", " + self.reg(operand))
        self.terminate("\tjnz " + nan + ", @" + zero + ", @" + test_low + "\n")
        self.label(test_low)
        self.out.line(below + " =w clt" + base + " " + self.reg(operand) + ", " + lower)
        self.terminate("\tjnz " + below + ", @" + low + ", @" + test_high + "\n")
        self.label(test_high)
        self.out.line(above + " =w cge" + base + " " + self.reg(operand) + ", " + upper)
        self.terminate("\tjnz " + above + ", @" + high + ", @" + convert + "\n")
        self.label(zero)
        self.out.line(chosen + " =l copy 0")
        self.terminate("\tjmp @" + done + "\n")
        self.label(low)
        var minimum = "0"
        if is_signed_int_type(self.program.types, destination): minimum = str(self.layout.int_minimum(destination))
        self.out.line(chosen + " =l copy " + minimum)
        self.terminate("\tjmp @" + done + "\n")
        self.label(high)
        var maximum = str(self.layout.uint_maximum(destination))
        if is_signed_int_type(self.program.types, destination): maximum = str(self.layout.int_maximum(destination))
        self.out.line(chosen + " =l copy " + maximum)
        self.terminate("\tjmp @" + done + "\n")
        self.label(convert)
        var prefix = "d"
        if base == "s": prefix = "s"
        var sign = "ui"
        if is_signed_int_type(self.program.types, destination): sign = "si"
        self.out.line(chosen + " =l " + prefix + "to" + sign + " " + self.reg(operand))
        self.terminate("\tjmp @" + done + "\n")
        self.label(done)
        self.canonicalize_integer(destination, result, chosen)

    # QBE leaves out-of-domain floating-to-integer conversion target-defined.
    # Canonical MIR promises a trap, so reject NaN and the half-open integer
    # interval before issuing QBE's conversion instruction.
    func guard_float_to_integer(source: TypeId, destination: TypeId, operand: RegisterId) -> !:
        let base = try self.base_type(source)
        let lower = self.float_integer_bound(base, destination, false)
        let upper = self.float_integer_bound(base, destination, true)
        let nan = self.out.temp()
        let below = self.out.temp()
        let above = self.out.temp()
        let outside = self.out.temp()
        self.out.line(nan + " =w cne" + base + " " + self.reg(operand) + ", " + self.reg(operand))
        self.emit_guard(nan, "float to integer conversion of NaN")
        self.out.line(below + " =w clt" + base + " " + self.reg(operand) + ", " + lower)
        self.out.line(above + " =w cge" + base + " " + self.reg(operand) + ", " + upper)
        self.out.line(outside + " =w or " + below + ", " + above)
        self.emit_guard(outside, "float to integer conversion is outside the integer range")

    func float_integer_bound(base: str, destination: TypeId, upper: bool) -> str:
        let prefix = base + "_"
        if not upper:
            if not is_signed_int_type(self.program.types, destination): return prefix + "0"
            let bits = self.bits(destination)
            if bits == 8: return prefix + "-128"
            if bits == 16: return prefix + "-32768"
            if bits == 32: return prefix + "-2147483648"
            return prefix + "-9223372036854775808"
        let bits = self.bits(destination)
        if is_signed_int_type(self.program.types, destination):
            if bits == 8: return prefix + "128"
            if bits == 16: return prefix + "32768"
            if bits == 32: return prefix + "2147483648"
            return prefix + "9223372036854775808"
        if bits == 8: return prefix + "256"
        if bits == 16: return prefix + "65536"
        if bits == 32: return prefix + "4294967296"
        return prefix + "18446744073709551616"

    # mark: Structured control ----------------------------------------------------------------

    func open_block(results: RegisterRun):
        let end_label = self.out.new_label("block_end")
        self.regions.append(Region(kind = RegionKind.block, branch_label = end_label, exit_label = end_label, alternative_label = "", results = results, saw_alternative = false, has_exit_edge = false))

    func open_loop():
        let header = self.out.new_label("loop")
        let end_label = self.out.new_label("loop_end")
        if not self.terminated: self.terminate("\tjmp @" + header + "\n")
        self.label(header)
        self.regions.append(Region(kind = RegionKind.loop, branch_label = header, exit_label = end_label, alternative_label = "", results = RegisterRun(start = 0, count = 0), saw_alternative = false, has_exit_edge = false))

    func open_if(condition: RegisterId, results: RegisterRun):
        let yes = self.out.new_label("if_yes")
        let no = self.out.new_label("if_no")
        let end_label = self.out.new_label("if_end")
        self.terminate("\tjnz " + self.reg(condition) + ", @" + yes + ", @" + no + "\n")
        self.label(yes)
        self.regions.append(Region(kind = RegionKind.conditional, branch_label = end_label, exit_label = end_label, alternative_label = no, results = results, saw_alternative = false, has_exit_edge = false))

    func emit_else() -> !:
        if len(self.regions) == 0: error("qbe backend: `Else` without an open region")
        let index = len(self.regions) - 1
        if self.regions[index].kind != RegionKind.conditional or self.regions[index].saw_alternative:
            error("qbe backend: invalid `Else`")
        if not self.terminated:
            self.terminate("\tjmp @" + self.regions[index].exit_label + "\n")
            self.regions[index].has_exit_edge = true
        self.regions[index].saw_alternative = true
        self.label(self.regions[index].alternative_label)

    func close_region() -> !:
        if len(self.regions) == 0: error("qbe backend: `End` without an open region")
        let region = self.regions[len(self.regions) - 1]
        self.regions.remove(len(self.regions) - 1)
        var reaches_exit = region.has_exit_edge
        if region.kind == RegionKind.conditional and not region.saw_alternative:
            if not self.terminated:
                self.terminate("\tjmp @" + region.exit_label + "\n")
                reaches_exit = true
            self.label(region.alternative_label)
            self.terminate("\tjmp @" + region.exit_label + "\n")
            reaches_exit = true
        elif not self.terminated:
            self.terminate("\tjmp @" + region.exit_label + "\n")
            reaches_exit = true
        self.label(region.exit_label)
        if not reaches_exit: self.terminate("\thlt\n")

    func emit_branch(function: MirFunction, depth: i64, values: RegisterRun) -> !:
        let index = try self.region_index(depth)
        let region = self.regions[index]
        if region.kind != RegionKind.loop: self.regions[index].has_exit_edge = true
        try self.assign_results(function, region.results, values)
        self.terminate("\tjmp @" + region.branch_label + "\n")

    func emit_conditional_branch(function: MirFunction, condition: RegisterId, depth: i64, values: RegisterRun) -> !:
        let taken = self.out.new_label("branch_taken")
        let following = self.out.new_label("branch_next")
        self.terminate("\tjnz " + self.reg(condition) + ", @" + taken + ", @" + following + "\n")
        self.label(taken)
        let index = try self.region_index(depth)
        let region = self.regions[index]
        if region.kind != RegionKind.loop: self.regions[index].has_exit_edge = true
        try self.assign_results(function, region.results, values)
        self.terminate("\tjmp @" + region.branch_label + "\n")
        self.label(following)

    func emit_return(function: MirFunction, values: RegisterRun) -> !:
        if function.signature.is_fallible:
            if values.count == 2:
                let value = register_at(function, values, 0)
                let value_type = self.register_type(function, value)
                try self.emit_store(value_type, "%q_result_out", self.reg(value))
                self.terminate("\tret " + self.reg(register_at(function, values, 1)) + "\n")
            elif values.count == 1:
                self.terminate("\tret " + self.reg(register_at(function, values, 0)) + "\n")
            else:
                error("qbe backend: fallible return has an invalid arity")
        elif values.count == 0: self.terminate("\tret\n")
        elif values.count == 1: self.terminate("\tret " + self.reg(register_at(function, values, 0)) + "\n")
        else: error("qbe backend: multiple return values are not implemented")

    func assign_results(function: MirFunction, destinations: RegisterRun, values: RegisterRun) -> !:
        if destinations.count != values.count: error("qbe backend: region result arity changed after verification")
        for index in range(0, i64(values.count)):
            let destination = register_at(function, destinations, index)
            let value = register_at(function, values, index)
            self.out.line(self.reg(destination) + " =" + try self.base_type(self.register_type(function, destination)) + " copy " + self.reg(value))

    func region_index(depth: i64) -> i64!:
        if depth < 0 or depth >= len(self.regions): error("qbe backend: branch depth is outside its regions")
        return len(self.regions) - 1 - depth

    # mark: Binary16 legalization --------------------------------------------------------------

    func is_float16(value_type: TypeId) -> bool:
        match mir_type(self.program.types, value_type):
            Float(bits): return bits == 16
            else: return false

    func emit_float16_bits(value: str) -> str:
        self.uses_float16 = true
        let bits = self.out.temp()
        self.out.line(bits + " =w call $luce.f16.to_bits(s " + value + ")")
        return bits

    func emit_float16_round(destination: str, value: str):
        let bits = self.emit_float16_bits(value)
        self.out.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")

    func emit_float64_to_float16(destination: str, value: str):
        self.uses_float16 = true
        let bits = self.out.temp()
        self.out.line(bits + " =w call $luce.f16.double_to_bits(d " + value + ")")
        self.out.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")

    # `max`/`min` have no `__atomic_fetch_*` form: read the value, pick the
    # extreme in the type's own signedness, and compare-exchange until the
    # location still held what was read. The loop's temporaries are
    # assigned in more than one block, which QBE's SSA construction admits.
    func emit_atomic_extreme(result: RegisterId, is_max: bool, value_type: TypeId, address: RegisterId, value: RegisterId, order: AtomicOrder) -> !:
        let width = self.layout.size_of(value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        let value_class = volatile_word_class(width, signed)
        let argument_class = volatile_register_class(width)
        var compare = "cugt"
        if is_max and signed: compare = "csgt"
        elif not is_max and signed: compare = "cslt"
        elif not is_max: compare = "cult"
        var compare_class = "w"
        if width == 8: compare_class = "l"
        let slot = self.out.temp()
        let old = self.out.temp()
        let keep = self.out.temp()
        let replacement = self.out.temp()
        let exchanged = self.out.temp()
        let loop = self.out.new_label("atomic_loop")
        let keep_old = self.out.new_label("atomic_keep")
        let take_new = self.out.new_label("atomic_take")
        let attempt = self.out.new_label("atomic_attempt")
        let done = self.out.new_label("atomic_done")
        self.out.line(slot + " =l alloc8 8")
        self.out.line("jmp @" + loop)
        self.label(loop)
        self.out.line(old + " =" + value_class + " call $__atomic_load_" + str(width) + "(l " + self.reg(address) + ", w 0)")
        self.out.line(keep + " =w " + compare + compare_class + " " + old + ", " + self.reg(value))
        self.out.line("jnz " + keep + ", @" + keep_old + ", @" + take_new)
        self.label(keep_old)
        self.out.line(replacement + " =" + value_class + " copy " + old)
        self.out.line("jmp @" + attempt)
        self.label(take_new)
        self.out.line(replacement + " =" + value_class + " copy " + self.reg(value))
        self.out.line("jmp @" + attempt)
        self.label(attempt)
        try self.emit_store(value_type, slot, old)
        self.out.line(exchanged + " =w call $__atomic_compare_exchange_" + str(width) + "(l " + self.reg(address) + ", l " + slot + ", " + argument_class + " " + replacement + ", w 0, w " + str(c_memory_order(order)) + ", w 0)")
        self.out.line("jnz " + exchanged + ", @" + done + ", @" + loop)
        self.label(done)
        self.out.line(self.reg(result) + " =" + value_class + " copy " + old)

    pub func emit_load(destination: str, value_type: TypeId, address: str) -> !:
        if self.is_float16(value_type):
            self.uses_float16 = true
            let bits = self.out.temp()
            self.out.line(bits + " =w loaduh " + address)
            self.out.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")
            return
        self.out.line(destination + " =" + try self.base_type(value_type) + " " + try self.load_instruction(value_type) + " " + address)

    pub func emit_store(value_type: TypeId, address: str, value: str) -> !:
        if self.is_float16(value_type):
            let bits = self.emit_float16_bits(value)
            self.out.line("storeh " + bits + ", " + address)
            return
        self.out.line(try self.store_instruction(value_type) + " " + value + ", " + address)

    # QBE's load optimiser forwards stores to loads and drops repeated loads
    # of one address, so a volatile access goes through the relaxed
    # `__atomic_load_N`/`__atomic_store_N` calls, which are opaque to it
    # (base.md §19.3). A float travels as its bits.
    pub func emit_volatile_load(destination: str, value_type: TypeId, address: str) -> !:
        let width = self.layout.size_of(value_type)
        if is_float_type(self.program.types, value_type):
            let bits = self.out.temp()
            self.out.line(bits + " =" + volatile_word_class(width, false) + " call $__atomic_load_" + str(width) + "(l " + address + ", w 0)")
            if self.is_float16(value_type):
                self.uses_float16 = true
                self.out.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")
            else:
                self.out.line(destination + " =" + try self.base_type(value_type) + " cast " + bits)
            return
        self.out.line(destination + " =" + volatile_word_class(width, is_signed_int_type(self.program.types, value_type)) + " call $__atomic_load_" + str(width) + "(l " + address + ", w 0)")

    pub func emit_volatile_store(value_type: TypeId, address: str, value: str) -> !:
        let width = self.layout.size_of(value_type)
        var stored = value
        if is_float_type(self.program.types, value_type):
            if self.is_float16(value_type):
                stored = self.emit_float16_bits(value)
            else:
                stored = self.out.temp()
                self.out.line(stored + " =" + volatile_register_class(width) + " cast " + value)
        self.out.line("call $__atomic_store_" + str(width) + "(l " + address + ", " + volatile_register_class(width) + " " + stored + ", w 0)")

    # mark: Type and text helpers ---------------------------------------------------------------

    pub func base_type(id: TypeId) -> str!:
        if self.is_float16(id): self.uses_float16 = true
        return try qbe_base_type(self.program, id)

    func integer_base(id: TypeId) -> str:
        if self.bits(id) <= 32: return "w"
        return "l"

    # `base + offset` as a fresh temporary, or `base` itself at offset 0.
    func address_at(base: str, offset: i64) -> str:
        if offset == 0: return base
        let moved = self.out.temp()
        self.out.line(moved + " =l add " + base + ", " + str(offset))
        return moved

    # Integer width under QBE's 64-bit targets; a pointer-width integer is 64.
    func bits(id: TypeId) -> i64:
        return self.layout.integer_bits(id)

    # QBE's ABI extension types appear only at C function boundaries. MIR
    # keeps the portable width/sign; this backend chooses the QBE spelling.
    func abi_type(id: TypeId) -> str!:
        if self.is_float16(id): self.uses_float16 = true
        return try qbe_abi_type(self.program, id)

    func load_instruction(id: TypeId) -> str!:
        return try qbe_load_instruction(self.program, id)

    func store_instruction(id: TypeId) -> str!:
        return try qbe_store_instruction(self.program, id)

    func constant(function: MirFunction, result: RegisterId, value: MirConstant) -> str!:
        match value:
            SignedInt(item): return str(item)
            UnsignedInt(item): return str(self.unsigned_bits_as_i64(item))
            Float(item):
                if try self.base_type(self.register_type(function, result)) == "s": return "s_" + str(item)
                return "d_" + str(item)
            Bool(item):
                if item: return "1"
                return "0"
            Null: return "0"

    ## QBE integer constants are signed decimal spellings of fixed-width bit
    ## patterns. Canonical MIR retains the unsigned mathematical value; only
    ## this backend boundary reinterprets its top bit for textual QBE IL.
    func unsigned_bits_as_i64(value: u64) -> i64:
        if value <= u64(9223372036854775807): return i64(value)
        return (-9223372036854775807 - 1) + i64(value - u64(9223372036854775808))

    pub func register_type(function: MirFunction, register: RegisterId) -> TypeId:
        return function.registers[register.value]

    func widen_integer(value_type: TypeId, register: RegisterId) -> str!:
        let bits = self.bits(value_type)
        if bits == 64: return self.reg(register)
        let widened = self.out.temp()
        var operation = "extu"
        if is_signed_int_type(self.program.types, value_type): operation = "exts"
        if bits == 8: operation = operation + "b"
        elif bits == 16: operation = operation + "h"
        else: operation = operation + "w"
        self.out.line(widened + " =l " + operation + " " + self.reg(register))
        return widened

    func arithmetic_value(value_type: TypeId, register: RegisterId) -> str!:
        if self.bits(value_type) < 64: return try self.widen_integer(value_type, register)
        return self.reg(register)

    func guard_range(value_type: TypeId, value: str) -> !:
        let below = self.out.temp()
        let above = self.out.temp()
        let bad = self.out.temp()
        self.emit_range_test(below, above, bad, value_type, value)
        self.emit_guard(bad, "integer overflow")

    # `flag` (`w`) is non-zero when the wide `value` lies outside the narrow type.
    func emit_range_flag(flag: str, value_type: TypeId, value: str):
        let below = self.out.temp()
        let above = self.out.temp()
        self.emit_range_test(below, above, flag, value_type, value)

    func emit_range_test(below: str, above: str, flag: str, value_type: TypeId, value: str):
        let bits = self.bits(value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        var minimum = 0
        var maximum = 0
        if signed:
            if bits == 8:
                minimum = -128
                maximum = 127
            elif bits == 16:
                minimum = -32768
                maximum = 32767
            else:
                minimum = -2147483647 - 1
                maximum = 2147483647
        else:
            if bits == 8: maximum = 255
            elif bits == 16: maximum = 65535
            else: maximum = 4294967295
        self.out.line(below + " =w csltl " + value + ", " + str(minimum))
        self.out.line(above + " =w csgtl " + value + ", " + str(maximum))
        self.out.line(flag + " =w or " + below + ", " + above)

    pub func emit_guard(bad: str, reason: str):
        let trap_label = self.out.new_label("trap")
        let okay = self.out.new_label("checked")
        self.terminate("\tjnz " + bad + ", @" + trap_label + ", @" + okay + "\n")
        self.label(trap_label)
        self.emit_trap(reason)
        self.label(okay)

    # A trap names its reason on stderr before halting, exactly as the
    # language trap contract does; inside a worker the supervisor relays it.
    pub func emit_trap(reason: str):
        var index = 0
        if self.trap_message_index.has(reason):
            index = self.trap_message_index[reason]
        else:
            index = len(self.trap_messages)
            self.trap_messages.append(reason)
            self.trap_message_index[reason] = index
        let symbol = "$luce_trap" + str(index)
        let length = str(len(strings.to_bytes(reason)))
        if not self.full.emit_trap_call(symbol, length):
            self.out.line("call $write(w 2, l " + symbol + ", l " + length + ")")
            self.out.line("call $write(w 2, l $luce_rt_trap_newline, l 1)")
        self.terminate("\thlt\n")

    # Trap text is data the functions discovered; QBE accepts it after them.
    func emit_trap_messages():
        if len(self.trap_messages) > 0 or self.has_runtime_trap():
            self.out.write("data $luce_rt_trap_newline = align 1 { b 10 }\n")
        for index in range(0, len(self.trap_messages)):
            let encoded = strings.to_bytes(self.trap_messages[index])
            let digits = list[str]()
            for byte in encoded: digits.append(str(byte))
            self.out.write("data $luce_trap" + str(index) + " = align 1 { b " + strings.join(digits, " ") + " }\n")

    func canonicalize_integer(value_type: TypeId, result: RegisterId, value: str):
        let bits = self.bits(value_type)
        if bits >= 32:
            self.out.line(self.reg(result) + " =" + self.integer_base(value_type) + " copy " + value)
            return
        var operation = "extu"
        if is_signed_int_type(self.program.types, value_type): operation = "exts"
        if bits == 8: operation = operation + "b"
        else: operation = operation + "h"
        self.out.line(self.reg(result) + " =w " + operation + " " + value)

    pub func function_name(id: FunctionId) -> str:
        return qbe_function_name(self.program, id)

    pub func reg(id: RegisterId) -> str:
        return "%r" + str(id.value)

    pub func terminate(text: str):
        self.out.write(text)
        self.terminated = true

    pub func label(name: str):
        self.out.label(name)
        self.terminated = false

    pub func ensure_open_block():
        if self.terminated: self.label(self.out.new_label("dead"))
