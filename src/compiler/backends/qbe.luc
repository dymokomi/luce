            ClassFieldAddress(result, value, field):
                let class_value = self.class_value(function, value)
                let service = find_runtime_binding(self.program, RuntimeService.class_payload) else trap("verified `ClassFieldAddress` has no runtime binding")
                let payload = self.temp()
                self.line(payload + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
                self.line(self.reg(result) + " =l add " + payload + ", " + str(self.layout.class_field_offset(class_value, field)))
            WeakClassCreate(result, value):
                let service = find_runtime_binding(self.program, RuntimeService.weak_class_create) else trap("verified `WeakClassCreate` has no runtime binding")
                self.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            WeakClassRetain(value):
                self.emit_pointer_runtime_call(RuntimeService.weak_class_retain, value, "WeakClassRetain")
            WeakClassRelease(value):
                self.emit_pointer_runtime_call(RuntimeService.weak_class_release, value, "WeakClassRelease")
            WeakClassPromote(destination, value, optional_type):
                let service = find_runtime_binding(self.program, RuntimeService.weak_class_promote) else trap("verified `WeakClassPromote` has no runtime binding")
                let promoted = self.temp()
                let payload = self.temp()
                let present = self.temp()
                self.line(promoted + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
                self.line(payload + " =l add " + self.reg(destination) + ", " + str(self.layout.enum_payload_offset(optional_type)))
                self.line("storel " + promoted + ", " + payload)
                self.line(present + " =w cnel " + promoted + ", 0")
                self.line("storeb " + present + ", " + self.reg(destination))
            InterfaceCreate(result, source, conformance_id):
                let conformance = self.program.conformances[conformance_id.value]
                let service = find_runtime_binding(self.program, RuntimeService.interface_create) else trap("verified `InterfaceCreate` has no runtime binding")
                self.line(
                    self.reg(result) + " =l call $" + self.function_name(service)
                    + "(l " + self.reg(source)
                    + ", l " + str(self.layout.size_of(conformance.value_type))
                    + ", l " + str(self.storage_alignment(conformance.value_type))
                    + ", l " + self.function_descriptor(conformance.retain)
                    + ", l " + self.function_descriptor(conformance.release)
                    + ", l $luce_wt" + str(conformance_id.value) + ")"
                )
            InterfaceRetain(value):
                self.emit_pointer_runtime_call(RuntimeService.interface_retain, value, "InterfaceRetain")
            InterfaceRelease(value):
                self.emit_pointer_runtime_call(RuntimeService.interface_release, value, "InterfaceRelease")
            InterfaceDetach(result, value):
                let service = find_runtime_binding(self.program, RuntimeService.interface_detach) else trap("verified `InterfaceDetach` has no runtime binding")
                self.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            InterfacePayload(result, value):
                let service = find_runtime_binding(self.program, RuntimeService.interface_payload) else trap("verified `InterfacePayload` has no runtime binding")
                self.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            CellCreate(result, element_type, destroyer):
                let service = find_runtime_binding(self.program, RuntimeService.class_create) else trap("verified `CellCreate` has no runtime binding")
                self.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + str(self.layout.size_of(element_type)) + ", l " + str(self.storage_alignment(element_type)) + ", l " + self.function_descriptor(destroyer) + ")")
            CellMarkInitialized(value):
                self.emit_pointer_runtime_call(RuntimeService.class_mark_initialized, value, "CellMarkInitialized")
            CellRetain(value):
                self.emit_pointer_runtime_call(RuntimeService.class_retain, value, "CellRetain")
            CellRelease(value):
                self.emit_pointer_runtime_call(RuntimeService.class_release, value, "CellRelease")
            CellValueAddress(result, value, element_type):
                let service = find_runtime_binding(self.program, RuntimeService.class_payload) else trap("verified `CellValueAddress` has no runtime binding")
                self.line(self.reg(result) + " =l call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
            Load(result, value_type, address):
                try self.emit_load(self.reg(result), value_type, self.reg(address))
            Store(value_type, address, value):
                try self.emit_store(value_type, self.reg(address), self.reg(value))
            FieldAddress(result, struct_type, base, field):
                self.line(self.reg(result) + " =l add " + self.reg(base) + ", " + str(self.layout.field_offset(struct_type, field)))
            EnumPayloadAddress(result, enum_type, base):
                self.line(self.reg(result) + " =l add " + self.reg(base) + ", " + str(self.layout.enum_payload_offset(enum_type)))
            ElementAddress(result, element_type, base, index):
                let scaled = self.temp()
                self.line(scaled + " =l mul " + self.reg(index) + ", " + str(self.layout.size_of(element_type)))
                self.line(self.reg(result) + " =l add " + self.reg(base) + ", " + scaled)
            Memcpy(destination, source, value_type):
                self.line("blit " + self.reg(source) + ", " + self.reg(destination) + ", " + str(self.layout.size_of(value_type)))
            MoveElements(destination, source, element_type, count):
                self.emit_move_elements(destination, source, element_type, count)
            DataAddress(result, data):
                self.line(self.reg(result) + " =l copy $d" + str(data.value))
            GlobalAddress(result, global):
                self.line(self.reg(result) + " =l copy $g" + str(global.value))
            LoadExternalGlobal(result, global):
                let declaration = self.program.external_globals[global.value]
                try self.emit_load(self.reg(result), declaration.value_type, "extern $" + declaration.name)
            StoreExternalGlobal(global, value):
                let declaration = self.program.external_globals[global.value]
                try self.emit_store(declaration.value_type, "extern $" + declaration.name, self.reg(value))
            FunctionAddress(result, target):
                self.line(self.reg(result) + " =l copy $" + self.function_name(target))
            ExternAddress(result, target):
                # An imported symbol used as data needs QBE's explicit
                # GOT/PIC address form; a direct `call $name` does not.
                self.line(self.reg(result) + " =l copy extern $" + self.program.externs[target.value].name)
            FunctionNull(destination, function_type):
                self.line("storel 0, " + self.reg(destination))
                let environment = self.temp()
                self.line(environment + " =l add " + self.reg(destination) + ", 8")
                self.line("storel 0, " + environment)
            FunctionValue(destination, function_type, target):
                self.line("storel $" + self.function_name(target) + ", " + self.reg(destination))
                let environment = self.temp()
                self.line(environment + " =l add " + self.reg(destination) + ", 8")
                self.line("storel 0, " + environment)
            ClosureCreate(environment, destination, function_type, closure):
                let metadata = self.program.closures[closure.value]
                let service = find_runtime_binding(self.program, RuntimeService.class_create) else trap("verified `ClosureCreate` has no runtime binding")
                self.line(self.reg(environment) + " =l call $" + self.function_name(service) + "(l " + str(self.layout.closure_payload_size(metadata)) + ", l " + str(self.recycling_alignment(self.layout.closure_payload_align(metadata))) + ", l " + self.function_descriptor(metadata.destroyer) + ")")
                self.line("storel $" + self.function_name(metadata.function) + ", " + self.reg(destination))
                let environment_field = self.temp()
                self.line(environment_field + " =l add " + self.reg(destination) + ", 8")
                self.line("storel " + self.reg(environment) + ", " + environment_field)
            ClosureMarkInitialized(environment):
                self.emit_pointer_runtime_call(RuntimeService.class_mark_initialized, environment, "ClosureMarkInitialized")
            ClosureCaptureAddress(result, environment, closure, capture):
                let metadata = self.program.closures[closure.value]
                let service = find_runtime_binding(self.program, RuntimeService.class_payload) else trap("verified `ClosureCaptureAddress` has no runtime binding")
                let payload = self.temp()
                self.line(payload + " =l call $" + self.function_name(service) + "(l " + self.reg(environment) + ")")
                self.line(self.reg(result) + " =l add " + payload + ", " + str(self.layout.closure_capture_offset(metadata, capture)))
            FunctionRetain(value):
                self.emit_function_environment_call(RuntimeService.class_retain, value, "FunctionRetain")
            FunctionRelease(value):
                self.emit_function_environment_call(RuntimeService.class_release, value, "FunctionRelease")
            Call(results, target, arguments):
                let called = self.program.functions[target.value]
                try self.emit_call(function, results, "$" + self.function_name(target), called.signature, called.convention, arguments)
            CallExtern(results, external, arguments):
                let symbol = self.program.externs[external.value]
                if symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_arena":
                    try self.emit_runtime_arena(function, results, arguments)
                elif symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_write":
                    try self.emit_runtime_write(function, arguments, 1)
                elif symbol.convention == CallingConvention.runtime and symbol.name == "luce_rt_trap":
                    if self.uses_tasks:
                        if arguments.count != 2: error("qbe backend: verified runtime trap has an invalid call shape")
                        let data = register_at(function, arguments, 0)
                        let length = register_at(function, arguments, 1)
                        self.line("call $luce_qbe_task_trap(l " + self.reg(data) + ", l " + self.reg(length) + ")")
                    else:
                        try self.emit_runtime_write(function, arguments, 2)
                        self.line("call $write(w 2, l $luce_rt_trap_newline, l 1)")
                    self.terminate("\thlt\n")
                else:
                    try self.emit_call(function, results, "$" + symbol.name, symbol.signature, symbol.convention, arguments)
            CallIndirect(results, signature, convention, target, arguments):
                try self.emit_call(function, results, self.reg(target), signature, convention, arguments)
            CallClosure(results, signature, target, arguments):
                try self.emit_closure_call(function, results, signature, target, arguments)
            CallInterface(results, interface_id, requirement, target, arguments):
                let service = find_runtime_binding(self.program, RuntimeService.interface_witness) else trap("verified `CallInterface` has no runtime binding")
                let descriptor = self.temp()
                let code = self.temp()
                self.line(descriptor + " =l call $" + self.function_name(service) + "(l " + self.reg(target) + ", l " + str(requirement) + ")")
                self.line(code + " =l loadl " + descriptor)
                let signature = self.program.interfaces[interface_id.value].requirements[requirement].signature
                try self.emit_call(function, results, code, signature, CallingConvention.luce, arguments)
            else: error("qbe backend: internal operation dispatch failure")

    # QBE's native oracle uses the host's write(2) directly. A language trap
    # reports to stderr and terminates in this backend; ordinary output uses
    # stdout and continues.
    func emit_runtime_write(function: MirFunction, arguments: RegisterRun, descriptor: i64) -> !:
        if arguments.count != 2: error("qbe backend: verified runtime write has an invalid call shape")
        self.output = self.output + "\tcall $write(w " + str(descriptor)
        for index in range(0, i64(arguments.count)):
            let argument = register_at(function, arguments, index)
            self.output = self.output + ", " + try self.base_type(self.register_type(function, argument)) + " " + self.reg(argument)
        self.output = self.output + ")\n"

    ## Emit one private runtime operation whose complete physical contract is
    ## a pointer-shaped handle and no result. The service identity remains
    ## semantic until this backend selects QBE's `l` representation.
    func emit_pointer_runtime_call(service: RuntimeService, value: RegisterId, instruction: str):
        let target = find_runtime_binding(self.program, service) else trap("verified `" + instruction + "` has no runtime binding")
        self.line("call $" + self.function_name(target) + "(l " + self.reg(value) + ")")

    func emit_display_call(result: RegisterId, value: RegisterId, service: RuntimeService, qbe_type: str):
        let target = find_runtime_binding(self.program, service) else trap("verified display operation has no runtime binding")
        self.line(self.reg(result) + " =l call $" + self.function_name(target) + "(" + qbe_type + " " + self.reg(value) + ")")

    func emit_function_environment_call(service: RuntimeService, value: RegisterId, instruction: str):
        let environment_address = self.temp()
        let environment = self.temp()
        self.line(environment_address + " =l add " + self.reg(value) + ", 8")
        self.line(environment + " =l loadl " + environment_address)
        let target = find_runtime_binding(self.program, service) else trap("verified `" + instruction + "` has no runtime binding")
        self.line("call $" + self.function_name(target) + "(l " + environment + ")")

    # Ensure the requested byte prefix fits the backend-owned reservation and
    # return its stable base. Precommitted/BSS storage is a valid monotonic
    # provider: every later prefix is already readable and writable.
    func emit_runtime_arena(function: MirFunction, results: RegisterRun, arguments: RegisterRun) -> !:
        if results.count != 1 or arguments.count != 1:
            error("qbe backend: verified arena service has an invalid call shape")
        let requested_end = register_at(function, arguments, 0)
        let outside = self.temp()
        self.line(outside + " =w cugtl " + self.reg(requested_end) + ", " + str(qbe_arena_capacity))
        self.emit_guard(outside)
        let result = register_at(function, results, 0)
        self.line(self.reg(result) + " =l copy $luce_rt_arena_storage")

    # mark: Isolated tasks ---------------------------------------------------------------------

    ## Capture only the worker's call representation in the transient fork
    ## context. `fork` occurs inside this call, before the parent can mutate or
    ## unwind any source storage; the child therefore observes one immediate
    ## copy-on-write snapshot of the complete reachable value graph.
    func emit_task_spawn(function: MirFunction, result: RegisterId, group: RegisterId, arguments: TransferRun) -> !:
        var context_size = i64(arguments.count) * 8
        if context_size == 0: context_size = 1
        let context = self.temp()
        self.line(context + " =l alloc16 " + str(context_size))
        for index in range(0, i64(arguments.count)):
            let transfer = transfer_at(function, arguments, index)
            let representation = self.register_type(function, transfer.value)
            var address = context
            if index > 0:
                address = self.temp()
                self.line(address + " =l add " + context + ", " + str(index * 8))
            self.line(try self.task_context_store(representation) + " " + self.reg(transfer.value) + ", " + address)
        self.line(self.reg(result) + " =l call $luce_qbe_task_spawn(l " + self.reg(group) + ", l $" + qbe_task_worker_name(self.task_site) + ", l " + context + ")")
        self.task_site += 1

    func task_context_store(value_type: TypeId) -> str!:
        match mir_type(self.program.types, value_type):
            Float(bits):
                if bits <= 32: return "stores"
                return "stored"
            Int(bits, is_signed):
                if bits <= 32: return "storew"
                return "storel"
            Bool: return "storew"
            else:
                if is_aggregate_type(self.program.types, value_type) or try self.base_type(value_type) == "l": return "storel"
                error("qbe task backend: unsupported spawn operand representation")

    func emit_task_wait(function: MirFunction, result: RegisterId, destination: RegisterId, failure: RegisterId, error_destination: RegisterId, task: RegisterId) -> !:
        let shape = try self.task_shape(self.register_type(function, task))
        let state = self.temp()
        self.line(state + " =w call $luce_qbe_task_wait(l " + self.reg(task) + ")")
        try self.emit_observed_task(function, shape, state, self.reg(task), result, destination, failure, error_destination)

    ## Join first, then decode. This guarantees `wait_all` observes every
    ## distinct child before reporting the first failure in input order and
    ## avoids constructing result values that would immediately be discarded.
    func emit_task_wait_all(function: MirFunction, result: RegisterId, failure: RegisterId, error_destination: RegisterId, tasks: RegisterId) -> !:
        var task_type = builtin_mir_type(BuiltinMirType.pointer)
        match mir_type(self.program.types, self.register_type(function, tasks)):
            List(element): task_type = element
            else: error("qbe task backend: wait_all operand is not a task list")
        let shape = try self.task_shape(task_type)
        let length_service = find_runtime_binding(self.program, RuntimeService.list_length) else error("qbe task backend: wait_all needs list length runtime")
        let address_service = find_runtime_binding(self.program, RuntimeService.list_element_address) else error("qbe task backend: wait_all needs list element runtime")
        let length = self.temp()
        self.line(length + " =l call $" + self.function_name(length_service) + "(l " + self.reg(tasks) + ")")
        let index_slot = self.emit_stack_allocation(builtin_mir_type(BuiltinMirType.unsigned_u64))
        let first_task_slot = self.emit_stack_allocation(builtin_mir_type(BuiltinMirType.pointer))
        let first_state_slot = self.emit_stack_allocation(builtin_mir_type(BuiltinMirType.signed_i32))
        self.line("storel 0, " + index_slot)
        self.line("storel 0, " + first_task_slot)
        self.line("storew 0, " + first_state_slot)
        let join_loop = self.new_label("wait_all_join")
        let join_body = self.new_label("wait_all_join_body")
        let join_done = self.new_label("wait_all_join_done")
        self.terminate("\tjmp @" + join_loop + "\n")
        self.label(join_loop)
        let index = self.temp()
        let joined = self.temp()
        self.line(index + " =l loadl " + index_slot)
        self.line(joined + " =w cugel " + index + ", " + length)
        self.terminate("\tjnz " + joined + ", @" + join_done + ", @" + join_body + "\n")
        self.label(join_body)
        let task_address = self.temp()
        let task = self.temp()
        let state = self.temp()
        self.line(task_address + " =l call $" + self.function_name(address_service) + "(l " + self.reg(tasks) + ", l 8, l " + index + ")")
        self.line(task + " =l loadl " + task_address)
        self.line(state + " =w call $luce_qbe_task_wait(l " + task + ")")
        let succeeded = self.temp()
        let existing = self.temp()
        let no_existing = self.temp()
        let record = self.temp()
        self.line(succeeded + " =w ceqw " + state + ", 0")
        self.line(existing + " =l loadl " + first_task_slot)
        self.line(no_existing + " =w ceql " + existing + ", 0")
        self.line(record + " =w and " + no_existing + ", " + self.bool_not_text(succeeded))
        let remember = self.new_label("wait_all_remember")
        let advance = self.new_label("wait_all_advance")
        self.terminate("\tjnz " + record + ", @" + remember + ", @" + advance + "\n")
        self.label(remember)
        self.line("storel " + task + ", " + first_task_slot)
        self.line("storew " + state + ", " + first_state_slot)
        self.terminate("\tjmp @" + advance + "\n")
        self.label(advance)
        let next = self.temp()
        self.line(next + " =l add " + index + ", 1")
        self.line("storel " + next + ", " + index_slot)
        self.terminate("\tjmp @" + join_loop + "\n")
        self.label(join_done)
        let first_task = self.temp()
        let has_failure = self.temp()
        self.line(first_task + " =l loadl " + first_task_slot)
        self.line(has_failure + " =w cnel " + first_task + ", 0")
        let failed = self.new_label("wait_all_failed")
        let successful = self.new_label("wait_all_successful")
        let complete = self.new_label("wait_all_complete")
        self.terminate("\tjnz " + has_failure + ", @" + failed + ", @" + successful + "\n")
        self.label(failed)
        let first_state = self.temp()
        self.line(first_state + " =w loadw " + first_state_slot)
        try self.emit_task_failure(shape.failure_type, first_state, first_task, error_destination)
        self.line(self.reg(result) + " =l copy 0")
        self.line(self.reg(failure) + " =l copy " + self.reg(error_destination))
        self.terminate("\tjmp @" + complete + "\n")
        self.label(successful)
        try self.emit_wait_all_results(function, result, tasks, length, shape, address_service)
        self.line(self.reg(failure) + " =l copy 0")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    func emit_wait_all_results(function: MirFunction, result: RegisterId, tasks: RegisterId, length: str, shape: QbeTaskShape, address_service: FunctionId) -> !:
        var element_type = builtin_mir_type(BuiltinMirType.pointer)
        match mir_type(self.program.types, self.register_type(function, result)):
            List(found): element_type = found
            else: error("qbe task backend: wait_all result is not a list")
        let create = find_runtime_binding(self.program, RuntimeService.list_create) else error("qbe task backend: wait_all needs list creation runtime")
        let reserve = find_runtime_binding(self.program, RuntimeService.list_reserve) else error("qbe task backend: wait_all needs list reserve runtime")
        let append = find_runtime_binding(self.program, RuntimeService.list_append_slot) else error("qbe task backend: wait_all needs list append runtime")
        self.line(self.reg(result) + " =l call $" + self.function_name(create) + "()")
        self.line("call $" + self.function_name(reserve) + "(l " + self.reg(result) + ", l " + str(self.layout.size_of(element_type)) + ", l " + str(self.storage_alignment(element_type)) + ", l " + length + ", l $luce_qbe_task_noop_fd)")
        let index_slot = self.emit_stack_allocation(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.line("storel 0, " + index_slot)
        let loop = self.new_label("wait_all_decode")
        let body = self.new_label("wait_all_decode_body")
        let done = self.new_label("wait_all_decode_done")
        self.terminate("\tjmp @" + loop + "\n")
        self.label(loop)
        let index = self.temp()
        let complete = self.temp()
        self.line(index + " =l loadl " + index_slot)
        self.line(complete + " =w cugel " + index + ", " + length)
        self.terminate("\tjnz " + complete + ", @" + done + ", @" + body + "\n")
        self.label(body)
        let task_address = self.temp()
        let task = self.temp()
        self.line(task_address + " =l call $" + self.function_name(address_service) + "(l " + self.reg(tasks) + ", l 8, l " + index + ")")
        self.line(task + " =l loadl " + task_address)
        let slot = self.temp()
        self.line(slot + " =l call $" + self.function_name(append) + "(l " + self.reg(result) + ", l " + str(self.layout.size_of(element_type)) + ", l " + str(self.storage_alignment(element_type)) + ", l $luce_qbe_task_noop_fd)")
        match shape.result:
            Unit:
                let finished = self.temp()
                self.line(finished + " =w call $luce_qbe_task_read_finished(l " + task + ", l 0)")
                let invalid = self.temp()
                self.line(invalid + " =w ceqw " + finished + ", 0")
                self.emit_guard(invalid)
            Never: self.terminate("\thlt\n")
            Value(value_type): try self.emit_decode_task_value(task, value_type, slot)
        if not self.terminated:
            let next = self.temp()
            self.line(next + " =l add " + index + ", 1")
            self.line("storel " + next + ", " + index_slot)
            self.terminate("\tjmp @" + loop + "\n")
        self.label(done)

    func bool_not_text(value: str) -> str:
        let result = self.temp()
        self.line(result + " =w ceqw " + value + ", 0")
        return result

    func emit_observed_task(function: MirFunction, shape: QbeTaskShape, state: str, task: str, result: RegisterId, destination: RegisterId, failure: RegisterId, error_destination: RegisterId) -> !:
        let success = self.new_label("task_success")
        let failed = self.new_label("task_failure")
        let complete = self.new_label("task_observed")
        let succeeded = self.temp()
        self.line(succeeded + " =w ceqw " + state + ", 0")
        self.terminate("\tjnz " + succeeded + ", @" + success + ", @" + failed + "\n")
        self.label(success)
        match shape.result:
            Unit: pass
            Never: self.terminate("\thlt\n")
            Value(value_type):
                var address = self.reg(destination)
                var scalar_storage = ""
                if not is_aggregate_type(self.program.types, value_type):
                    scalar_storage = self.emit_stack_allocation(value_type)
                    address = scalar_storage
                try self.emit_decode_task_value(task, value_type, address)
                if scalar_storage != "": try self.emit_load(self.reg(result), value_type, scalar_storage)
        self.line(self.reg(failure) + " =l copy 0")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(failed)
        try self.emit_task_failure(shape.failure_type, state, task, error_destination)
        self.line(self.reg(failure) + " =l copy " + self.reg(error_destination))
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    func emit_decode_task_value(task: str, value_type: TypeId, address: str) -> !:
        let cursor = self.temp()
        self.line(cursor + " =l call $" + qbe_task_decode_name(value_type) + "(l " + task + ", l 0, l " + address + ")")
        let complete = self.temp()
        self.line(complete + " =w call $luce_qbe_task_read_finished(l " + task + ", l " + cursor + ")")
        let invalid = self.temp()
        self.line(invalid + " =w ceqw " + complete + ", 0")
        self.emit_guard(invalid)

    func emit_task_failure(failure_type: TypeId, state: str, task: str, destination: RegisterId) -> !:
        let ordinary = self.new_label("task_error")
        let runtime = self.new_label("task_runtime_error")
        let complete = self.new_label("task_error_ready")
        let is_failure = self.temp()
        self.line(is_failure + " =w ceqw " + state + ", 1")
        self.terminate("\tjnz " + is_failure + ", @" + ordinary + ", @" + runtime + "\n")
        self.label(ordinary)
        try self.emit_decode_task_value(task, failure_type, self.reg(destination))
        self.terminate("\tjmp @" + complete + "\n")
        self.label(runtime)
        let code = self.temp()
        let cancelled = self.temp()
        let exhausted = self.temp()
        self.line(code + " =w copy 1")
        self.line(cancelled + " =w ceqw " + state + ", 3")
        let after_cancelled = self.new_label("task_code_after_cancelled")
        let set_cancelled = self.new_label("task_code_cancelled")
        self.terminate("\tjnz " + cancelled + ", @" + set_cancelled + ", @" + after_cancelled + "\n")
        self.label(set_cancelled)
        self.line(code + " =w copy 2")
        self.terminate("\tjmp @" + after_cancelled + "\n")
        self.label(after_cancelled)
        self.line(exhausted + " =w ceqw " + state + ", 4")
        let after_exhausted = self.new_label("task_code_ready")
        let set_exhausted = self.new_label("task_code_exhausted")
        self.terminate("\tjnz " + exhausted + ", @" + set_exhausted + ", @" + after_exhausted + "\n")
        self.label(set_exhausted)
        self.line(code + " =w copy 3")
        self.terminate("\tjmp @" + after_exhausted + "\n")
        self.label(after_exhausted)
        let message = self.temp()
        let message_length = self.temp()
        self.line(message + " =l call $luce_qbe_task_message_data(l " + task + ")")
        self.line(message_length + " =l call $luce_qbe_task_message_length(l " + task + ")")
        try self.emit_task_error_value(failure_type, self.reg(destination), code, message, message_length)
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    ## Materialize the language's structural Error without giving the process
    ## supervisor any knowledge of MIR layout or the sealed buffer runtime.
    func emit_task_error_value(failure_type: TypeId, destination: str, code: str, message: str, message_length: str) -> !:
        var code_type = builtin_mir_type(BuiltinMirType.pointer)
        var message_type = builtin_mir_type(BuiltinMirType.pointer)
        match mir_type(self.program.types, failure_type):
            Struct(fields):
                if len(fields) != 2: error("qbe task backend: Error has the wrong field count")
                code_type = fields[0].value_type
                message_type = fields[1].value_type
            else: error("qbe task backend: task failure is not structural Error")
        var domain_type = builtin_mir_type(BuiltinMirType.pointer)
        var numeric_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
        match mir_type(self.program.types, code_type):
            Struct(fields):
                if len(fields) != 2: error("qbe task backend: ErrorCode has the wrong field count")
                domain_type = fields[0].value_type
                numeric_type = fields[1].value_type
            else: error("qbe task backend: task ErrorCode is not structural")
        let code_address = self.address_text(destination, self.layout.field_offset(failure_type, 0))
        try self.emit_buffer_value_from_bytes(domain_type, self.address_text(code_address, self.layout.field_offset(code_type, 0)), "$luce_qbe_task_domain", "9")
        try self.emit_store(numeric_type, self.address_text(code_address, self.layout.field_offset(code_type, 1)), code)
        try self.emit_buffer_value_from_bytes(message_type, self.address_text(destination, self.layout.field_offset(failure_type, 1)), message, message_length)

    func emit_buffer_value_from_bytes(value_type: TypeId, destination: str, data: str, length: str) -> !:
        var fields = list[MirField]()
        match mir_type(self.program.types, value_type):
            Struct(found): fields = found
            else: error("qbe task backend: task diagnostic text is not a buffer value")
        if len(fields) != 3: error("qbe task backend: task diagnostic buffer has the wrong shape")
        let create = find_runtime_binding(self.program, RuntimeService.buffer_builder_create) else error("qbe task backend: missing buffer builder runtime")
        let append = find_runtime_binding(self.program, RuntimeService.buffer_builder_append) else error("qbe task backend: missing buffer append runtime")
        let finish = find_runtime_binding(self.program, RuntimeService.buffer_builder_finish) else error("qbe task backend: missing buffer finish runtime")
        let data_service = find_runtime_binding(self.program, RuntimeService.buffer_data) else error("qbe task backend: missing buffer data runtime")
        let length_service = find_runtime_binding(self.program, RuntimeService.buffer_length) else error("qbe task backend: missing buffer length runtime")
        let builder = self.temp()
        let owner = self.temp()
        let copied_data = self.temp()
        let copied_length = self.temp()
        self.line(builder + " =l call $" + self.function_name(create) + "()")
        self.line("call $" + self.function_name(append) + "(l " + builder + ", l " + data + ", l " + length + ")")
        self.line(owner + " =l call $" + self.function_name(finish) + "(l " + builder + ")")
        self.line(copied_data + " =l call $" + self.function_name(data_service) + "(l " + owner + ")")
        self.line(copied_length + " =l call $" + self.function_name(length_service) + "(l " + owner + ")")
        try self.emit_store(fields[0].value_type, self.address_text(destination, self.layout.field_offset(value_type, 0)), owner)
        try self.emit_store(fields[1].value_type, self.address_text(destination, self.layout.field_offset(value_type, 1)), copied_data)
        try self.emit_store(fields[2].value_type, self.address_text(destination, self.layout.field_offset(value_type, 2)), copied_length)

    func task_shape(task_type: TypeId) -> QbeTaskShape!:
        match mir_type(self.program.types, task_type):
            Task(result, failure_type): return QbeTaskShape(result = result, failure_type = failure_type)
            else: error("qbe task backend: task operation has a non-task handle")

    func emit_stack_allocation(value_type: TypeId) -> str:
        let align = self.layout.align_of(value_type)
        var instruction = "alloc4"
        if align > 8: instruction = "alloc16"
        elif align > 4: instruction = "alloc8"
        var size = self.layout.size_of(value_type)
        if size == 0: size = 1
        let result = self.temp()
        self.line(result + " =l " + instruction + " " + str(size))
        return result

    func address_text(base: str, offset: i64) -> str:
        if offset == 0: return base
        let result = self.temp()
        self.line(result + " =l add " + base + ", " + str(offset))
        return result

    func emit_task_group_destroy():
        if self.task_group == none: return
        let group = self.task_group else trap("QBE task group disappeared")
        self.line("call $luce_qbe_task_group_destroy(l " + self.reg(group) + ")")

    # Count zero is the canonical null storage token. A positive allocation
    # keeps the element type until this boundary, where its target layout is
    # checked and passed to the composed allocator as bytes plus alignment.
    func emit_allocate_storage(result: RegisterId, element_type: TypeId, count: RegisterId):
        let allocator = find_runtime_binding(self.program, RuntimeService.storage_allocator) else trap("verified `AllocateStorage` has no runtime binding")
        let empty = self.new_label("allocation_empty")
        let reserve = self.new_label("allocation_reserve")
        let complete = self.new_label("allocation_complete")
        let is_empty = self.temp()
        self.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + empty + ", @" + reserve + "\n")
        self.label(empty)
        self.line(self.reg(result) + " =l copy 0")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(reserve)

        let element_size = self.layout.size_of(element_type)
        var byte_count = "1"
        if element_size > 0: byte_count = self.emit_scaled_byte_count(count, element_size)
        let alignment = self.storage_alignment(element_type)
        self.line(self.reg(result) + " =l call $" + self.function_name(allocator) + "(l " + byte_count + ", l " + str(alignment) + ")")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    # Count zero owns no block. Positive requests use exactly the same
    # backend-normalized byte class as allocation, including pointer alignment
    # so the freestanding runtime can store an intrusive free-list link.
    func emit_deallocate_storage(address: RegisterId, element_type: TypeId, count: RegisterId):
        let deallocator = find_runtime_binding(self.program, RuntimeService.storage_deallocator) else trap("verified `DeallocateStorage` has no runtime binding")
        let release = self.new_label("deallocation_release")
        let complete = self.new_label("deallocation_complete")
        let is_empty = self.temp()
        self.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + complete + ", @" + release + "\n")
        self.label(release)
        let element_size = self.layout.size_of(element_type)
        var byte_count = "1"
        if element_size > 0: byte_count = self.emit_scaled_byte_count(count, element_size)
        let alignment = self.storage_alignment(element_type)
        self.line("call $" + self.function_name(deallocator) + "(l " + self.reg(address) + ", l " + byte_count + ", l " + str(alignment) + ")")
        self.terminate("\tjmp @" + complete + "\n")
        self.label(complete)

    func storage_alignment(element_type: TypeId) -> i64:
        return self.recycling_alignment(self.layout.align_of(element_type))

    func recycling_alignment(alignment: i64) -> i64:
        let pointer_alignment = self.layout.pointer_align()
        if alignment < pointer_alignment: return pointer_alignment
        return alignment

    func emit_list_element_address(function: MirFunction, result: RegisterId, value: RegisterId, index: RegisterId):
        let element_type = self.list_element_type(function, value)
        let address_service = find_runtime_binding(self.program, RuntimeService.list_element_address) else trap("verified `ListElementAddress` has no address binding")
        self.emit_list_index_guard(value, index, false)
        self.line(self.reg(result) + " =l call $" + self.function_name(address_service) + "(l " + self.reg(value) + ", l " + str(self.layout.size_of(element_type)) + ", l " + self.reg(index) + ")")

    # Canonical list operations retain checked bounds. `insert` alone accepts
    # the position immediately after the last existing element.
    func emit_list_index_guard(value: RegisterId, index: RegisterId, allow_end: bool):
        let length_service = find_runtime_binding(self.program, RuntimeService.list_length) else trap("verified list operation has no length binding")
        self.emit_index_guard(value, index, allow_end, length_service)

    func emit_list_shape_guard(value: RegisterId):
        let service = find_runtime_binding(self.program, RuntimeService.list_iteration_active) else trap("verified list shape mutation has no active-iteration binding")
        let active = self.temp()
        self.line(active + " =w call $" + self.function_name(service) + "(l " + self.reg(value) + ")")
        self.emit_guard(active)

    func emit_index_guard(value: RegisterId, index: RegisterId, allow_end: bool, length_service: FunctionId):
        let length = self.temp()
        self.line(length + " =l call $" + self.function_name(length_service) + "(l " + self.reg(value) + ")")
        let invalid = self.temp()
        if allow_end:
            self.line(invalid + " =w cugtl " + self.reg(index) + ", " + length)
        else:
            let valid = self.temp()
            self.line(valid + " =w cultl " + self.reg(index) + ", " + length)
            self.line(invalid + " =w ceqw " + valid + ", 0")
        self.emit_guard(invalid)

    func emit_list_slice_guard(value: RegisterId, start: RegisterId, end: RegisterId):
        let length_service = find_runtime_binding(self.program, RuntimeService.list_length) else trap("verified list slice has no length binding")
        let length = self.temp()
        self.line(length + " =l call $" + self.function_name(length_service) + "(l " + self.reg(value) + ")")
        self.emit_slice_bounds_guard_text(length, start, end)

    func emit_slice_bounds_guard(length: RegisterId, start: RegisterId, end: RegisterId):
        self.emit_slice_bounds_guard_text(self.reg(length), start, end)

    func emit_slice_bounds_guard_text(length: str, start: RegisterId, end: RegisterId):
        let reversed = self.temp()
        self.line(reversed + " =w cugtl " + self.reg(start) + ", " + self.reg(end))
        let past_end = self.temp()
        self.line(past_end + " =w cugtl " + self.reg(end) + ", " + length)
        let invalid = self.temp()
        self.line(invalid + " =w or " + reversed + ", " + past_end)
        self.emit_guard(invalid)

    # Preserve overlap semantics by selecting the host's move primitive only
    # after target layout has turned a structural element count into bytes.
    func emit_move_elements(destination: RegisterId, source: RegisterId, element_type: TypeId, count: RegisterId):
        let element_size = self.layout.size_of(element_type)
        if element_size == 0: return
        let empty = self.new_label("move_empty")
        let moving = self.new_label("move_elements")
        let is_empty = self.temp()
        self.line(is_empty + " =w ceql " + self.reg(count) + ", 0")
        self.terminate("\tjnz " + is_empty + ", @" + empty + ", @" + moving + "\n")
        self.label(moving)
        let byte_count = self.emit_scaled_byte_count(count, element_size)
        self.line("call $memmove(l " + self.reg(destination) + ", l " + self.reg(source) + ", l " + byte_count + ")")
        self.terminate("\tjmp @" + empty + "\n")
        self.label(empty)

    func emit_scaled_byte_count(count: RegisterId, element_size: i64) -> str:
        if element_size == 1: return self.reg(count)
        let byte_count = self.temp()
        self.line(byte_count + " =l mul " + self.reg(count) + ", " + str(element_size))
        let quotient = self.temp()
        self.line(quotient + " =l udiv " + byte_count + ", " + str(element_size))
        let wrapped = self.temp()
        self.line(wrapped + " =w cnel " + quotient + ", " + self.reg(count))
        self.emit_guard(wrapped)
        let outside_mir = self.temp()
        self.line(outside_mir + " =w csltl " + byte_count + ", 0")
        self.emit_guard(outside_mir)
        return byte_count

    func emit_call(function: MirFunction, results: RegisterRun, target: str, signature: MirSignature, convention: CallingConvention, arguments: RegisterRun) -> !:
        try self.emit_call_with_environment(function, results, target, signature, convention, arguments, none)

    func emit_call_with_environment(function: MirFunction, results: RegisterRun, target: str, signature: MirSignature, convention: CallingConvention, arguments: RegisterRun, environment: str?) -> !:
        if results.count > 1 and not signature.is_fallible: error("qbe backend: multiple call results are not implemented")
        var result_storage = ""
        if signature.is_fallible and results.count == 2:
            let value_result = register_at(function, results, 0)
            let value_type = self.register_type(function, value_result)
            result_storage = self.temp()
            var allocation = "alloc4"
            let align = self.layout.align_of(value_type)
            if align > 8: allocation = "alloc16"
            elif align > 4: allocation = "alloc8"
            self.line(result_storage + " =l " + allocation + " " + str(self.layout.size_of(value_type)))
        self.output = self.output + "\t"
        if signature.is_fallible:
            let error_result = register_at(function, results, i64(results.count) - 1)
            self.output = self.output + self.reg(error_result) + " =l "
        elif results.count == 1:
            let result = register_at(function, results, 0)
            if convention == CallingConvention.c and is_aggregate_type(self.program.types, signature.results[0]):
                self.output = self.output + self.reg(result) + " =" + try self.abi_type(signature.results[0]) + " "
            else:
                self.output = self.output + self.reg(result) + " =" + try self.base_type(self.register_type(function, result)) + " "
        self.output = self.output + "call " + target + "("
        var written = 0
        var environment_index: i64 = 0
        if signature.is_fallible: environment_index = 1
        for index in range(0, i64(arguments.count)):
            if environment != none and index == environment_index:
                if written > 0: self.output = self.output + ", "
                self.output = self.output + "l " + environment
                written += 1
            if written > 0: self.output = self.output + ", "
            let argument = register_at(function, arguments, index)
            if convention == CallingConvention.c:
                self.output = self.output + try self.abi_type(signature.parameters[index]) + " " + self.reg(argument)
            else:
                self.output = self.output + try self.base_type(self.register_type(function, argument)) + " " + self.reg(argument)
            written += 1
        if environment != none and environment_index == i64(arguments.count):
            if written > 0: self.output = self.output + ", "
            self.output = self.output + "l " + environment
            written += 1
        if result_storage != "":
            if written > 0: self.output = self.output + ", "
            self.output = self.output + "l " + result_storage
        self.output = self.output + ")\n"
        if result_storage != "":
            let value_result = register_at(function, results, 0)
            let value_type = self.register_type(function, value_result)
            try self.emit_load(self.reg(value_result), value_type, result_storage)

    func emit_closure_call(function: MirFunction, results: RegisterRun, signature: MirSignature, target: RegisterId, arguments: RegisterRun) -> !:
        let code = self.temp()
        let environment_address = self.temp()
        let environment = self.temp()
        self.line(code + " =l loadl " + self.reg(target))
        self.line(environment_address + " =l add " + self.reg(target) + ", 8")
        self.line(environment + " =l loadl " + environment_address)
        let captured = self.temp()
        self.line(captured + " =w cnel " + environment + ", 0")
        let with_environment = self.new_label("closure_environment")
        let without_environment = self.new_label("closure_plain")
        let finished = self.new_label("closure_end")
        self.terminate("\tjnz " + captured + ", @" + with_environment + ", @" + without_environment + "\n")
        self.label(without_environment)
        try self.emit_call_with_environment(function, results, code, signature, CallingConvention.luce, arguments, none)
        self.terminate("\tjmp @" + finished + "\n")
        self.label(with_environment)
        try self.emit_call_with_environment(function, results, code, signature, CallingConvention.luce, arguments, environment)
        self.terminate("\tjmp @" + finished + "\n")
        self.label(finished)

    # mark: Arithmetic -------------------------------------------------------------------------

    func emit_binary(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, left)
        if operation == BinaryOp.eq or operation == BinaryOp.ne or operation == BinaryOp.lt or operation == BinaryOp.le or operation == BinaryOp.gt or operation == BinaryOp.ge:
            try self.emit_comparison(function, result, operation, left, right)
            return
        if is_float_type(self.program.types, value_type):
            var name = ""
            match operation:
                add: name = "add"
                sub: name = "sub"
                mul: name = "mul"
                div: name = "div"
                else: error("qbe backend: floating `" + str(operation) + "` is not implemented")
            if self.is_float16(value_type):
                let raw = self.temp()
                self.line(raw + " =s " + name + " " + self.reg(left) + ", " + self.reg(right))
                self.emit_float16_round(self.reg(result), raw)
            else:
                self.line(self.reg(result) + " =" + try self.base_type(value_type) + " " + name + " " + self.reg(left) + ", " + self.reg(right))
            return
        if not is_int_type(self.program.types, value_type): error("qbe backend: binary operation on `" + describe_mir_type(self.program.types, value_type) + "`")

        match operation:
            add, sub, mul: try self.emit_checked_arithmetic(function, result, operation, left, right)
            floor_div: try self.emit_floor_division(function, result, left, right, false)
            rem: try self.emit_floor_division(function, result, left, right, true)
            bit_and: self.emit_integer_result(function, result, "and", left, right)
            bit_or: self.emit_integer_result(function, result, "or", left, right)
            bit_xor: self.emit_integer_result(function, result, "xor", left, right)
            shift_left: try self.emit_shift(function, result, "shl", left, right)
            shift_right:
                var name = "shr"
                if is_signed_int_type(self.program.types, value_type): name = "sar"
                try self.emit_shift(function, result, name, left, right)
            else: error("qbe backend: integer `" + str(operation) + "` is not implemented")

    func emit_checked_arithmetic(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        let bits = bits_of(self.program.types, value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        var name = "add"
        if operation == BinaryOp.sub: name = "sub"
        elif operation == BinaryOp.mul: name = "mul"

        if bits < 64:
            let wide_left = try self.widen_integer(value_type, left)
            let wide_right = try self.widen_integer(value_type, right)
            let wide_result = self.temp()
            self.line(wide_result + " =l " + name + " " + wide_left + ", " + wide_right)
            try self.guard_range(value_type, wide_result)
            self.line(self.reg(result) + " =w copy " + wide_result)
            return

        let computed = self.reg(result)
        self.line(computed + " =l " + name + " " + self.reg(left) + ", " + self.reg(right))
        let bad = self.temp()
        if operation == BinaryOp.add:
            if signed:
                let a = self.temp()
                let b = self.temp()
                let both = self.temp()
                self.line(a + " =l xor " + self.reg(left) + ", " + computed)
                self.line(b + " =l xor " + self.reg(right) + ", " + computed)
                self.line(both + " =l and " + a + ", " + b)
                self.line(bad + " =w csltl " + both + ", 0")
            else:
                # Unsigned addition wrapped exactly when the result is below
                # either input in the machine's unsigned ordering.
                self.line(bad + " =w cultl " + computed + ", " + self.reg(left))
        elif operation == BinaryOp.sub:
            if signed:
                let different = self.temp()
                let changed = self.temp()
                let both = self.temp()
                self.line(different + " =l xor " + self.reg(left) + ", " + self.reg(right))
                self.line(changed + " =l xor " + self.reg(left) + ", " + computed)
                self.line(both + " =l and " + different + ", " + changed)
                self.line(bad + " =w csltl " + both + ", 0")
            else:
                self.line(bad + " =w cultl " + self.reg(left) + ", " + self.reg(right))
        else:
            let zero = self.temp()
            let check = self.new_label("mul_check")
            let okay = self.new_label("mul_ok")
            self.line(zero + " =w ceql " + self.reg(right) + ", 0")
            self.terminate("\tjnz " + zero + ", @" + okay + ", @" + check + "\n")
            self.label(check)
            let quotient = self.temp()
            var divide = "div"
            if not signed: divide = "udiv"
            self.line(quotient + " =l " + divide + " " + computed + ", " + self.reg(right))
            self.line(bad + " =w cnel " + quotient + ", " + self.reg(left))
            self.emit_guard(bad)
            self.terminate("\tjmp @" + okay + "\n")
            self.label(okay)
            return
        self.emit_guard(bad)

    func emit_floor_division(function: MirFunction, result: RegisterId, left: RegisterId, right: RegisterId, wants_remainder: bool) -> !:
        let value_type = self.register_type(function, result)
        let signed = is_signed_int_type(self.program.types, value_type)
        let bits = bits_of(self.program.types, value_type)
        let left_value = try self.arithmetic_value(value_type, left)
        let right_value = try self.arithmetic_value(value_type, right)
        let divisor_is_zero = self.temp()
        self.line(divisor_is_zero + " =w ceql " + right_value + ", 0")
        self.emit_guard(divisor_is_zero)

        if not wants_remainder and signed and bits == 64:
            let is_minimum = self.temp()
            let is_negative_one = self.temp()
            let overflows = self.temp()
            self.line(is_minimum + " =w ceql " + left_value + ", -9223372036854775808")
            self.line(is_negative_one + " =w ceql " + right_value + ", -1")
            self.line(overflows + " =w and " + is_minimum + ", " + is_negative_one)
            self.emit_guard(overflows)

        var special_end = ""
        if wants_remainder and signed and bits == 64:
            # Luce defines minimum % -1 as zero even though the corresponding
            # division overflows. Avoid issuing the target division at all.
            let is_minimum = self.temp()
            let is_negative_one = self.temp()
            let is_special = self.temp()
            let special = self.new_label("remainder_minimum")
            let ordinary = self.new_label("remainder_ordinary")
            special_end = self.new_label("remainder_end")
            self.line(is_minimum + " =w ceql " + self.reg(left) + ", -9223372036854775808")
            self.line(is_negative_one + " =w ceql " + self.reg(right) + ", -1")
            self.line(is_special + " =w and " + is_minimum + ", " + is_negative_one)
            self.terminate("\tjnz " + is_special + ", @" + special + ", @" + ordinary + "\n")
            self.label(special)
            self.line(self.reg(result) + " =l copy 0")
            self.terminate("\tjmp @" + special_end + "\n")
            self.label(ordinary)
        var divide = "div"
        if not signed: divide = "udiv"
        let quotient = self.temp()
        self.line(quotient + " =l " + divide + " " + left_value + ", " + right_value)
        var floored = quotient
        if signed:
            let truncated_remainder = self.temp()
            let nonzero = self.temp()
            let signs = self.temp()
            let negative = self.temp()
            let adjust = self.temp()
            let wide_adjust = self.temp()
            floored = self.temp()
            self.line(truncated_remainder + " =l rem " + left_value + ", " + right_value)
            self.line(nonzero + " =w cnel " + truncated_remainder + ", 0")
            self.line(signs + " =l xor " + left_value + ", " + right_value)
            self.line(negative + " =w csltl " + signs + ", 0")
            self.line(adjust + " =w and " + nonzero + ", " + negative)
            self.line(wide_adjust + " =l extuw " + adjust)
            self.line(floored + " =l sub " + quotient + ", " + wide_adjust)
        var value = floored
        if wants_remainder:
            let product = self.temp()
            value = self.temp()
            self.line(product + " =l mul " + floored + ", " + right_value)
            self.line(value + " =l sub " + left_value + ", " + product)
        if bits < 64:
            if not wants_remainder: try self.guard_range(value_type, value)
            self.line(self.reg(result) + " =w copy " + value)
        else:
            self.line(self.reg(result) + " =l copy " + value)
        if special_end != "": self.label(special_end)

    func emit_integer_result(function: MirFunction, result: RegisterId, operation: str, left: RegisterId, right: RegisterId):
        let value_type = self.register_type(function, result)
        let base = self.integer_base(value_type)
        let raw = self.temp()
        self.line(raw + " =" + base + " " + operation + " " + self.reg(left) + ", " + self.reg(right))
        self.canonicalize_integer(value_type, result, raw)

    func emit_shift(function: MirFunction, result: RegisterId, operation: str, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        let bits = bits_of(self.program.types, value_type)
        let valid = self.temp()
        self.line(valid + " =w cult" + self.integer_base(value_type) + " " + self.reg(right) + ", " + str(bits))
        let bad = self.temp()
        self.line(bad + " =w ceqw " + valid + ", 0")
        self.emit_guard(bad)
        self.emit_integer_result(function, result, operation, left, right)

    func emit_comparison(function: MirFunction, result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId) -> !:
        let value_type = self.register_type(function, left)
        var relation = "eq"
        match operation:
            eq: relation = "eq"
            ne: relation = "ne"
            lt: relation = "lt"
            le: relation = "le"
            gt: relation = "gt"
            ge: relation = "ge"
            else: error("qbe backend: invalid comparison")
        if is_int_type(self.program.types, value_type) and operation != BinaryOp.eq and operation != BinaryOp.ne:
            if is_signed_int_type(self.program.types, value_type): relation = "s" + relation
            else: relation = "u" + relation
        self.line(self.reg(result) + " =w c" + relation + try self.base_type(value_type) + " " + self.reg(left) + ", " + self.reg(right))

    func emit_unary(function: MirFunction, result: RegisterId, operation: UnaryOp, operand: RegisterId) -> !:
        let value_type = self.register_type(function, result)
        match operation:
            neg:
                if self.is_float16(value_type):
                    let raw = self.temp()
                    self.line(raw + " =s neg " + self.reg(operand))
                    self.emit_float16_round(self.reg(result), raw)
                elif is_float_type(self.program.types, value_type): self.line(self.reg(result) + " =" + try self.base_type(value_type) + " neg " + self.reg(operand))
                else:
                    let bits = bits_of(self.program.types, value_type)
                    if bits < 64:
                        let wide = try self.widen_integer(value_type, operand)
                        let negated = self.temp()
                        self.line(negated + " =l sub 0, " + wide)
                        try self.guard_range(value_type, negated)
                        self.line(self.reg(result) + " =w copy " + negated)
                    else:
                        let minimum = -9223372036854775807 - 1
                        let bad = self.temp()
                        self.line(bad + " =w ceql " + self.reg(operand) + ", " + str(minimum))
                        self.emit_guard(bad)
                        self.line(self.reg(result) + " =l neg " + self.reg(operand))
            bit_not:
                let raw = self.temp()
                self.line(raw + " =" + self.integer_base(value_type) + " xor " + self.reg(operand) + ", -1")
                self.canonicalize_integer(value_type, result, raw)
            bool_not:
                self.line(self.reg(result) + " =w ceqw " + self.reg(operand) + ", 0")

    func emit_convert(function: MirFunction, result: RegisterId, operation: ConvertOp, operand: RegisterId) -> !:
        let source = self.register_type(function, operand)
        let destination = self.register_type(function, result)
        match operation:
            extend:
                let widened = try self.widen_integer(source, operand)
                self.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + widened)
            wrap:
                self.canonicalize_integer(destination, result, self.reg(operand))
            int_reinterpret:
                self.line(self.reg(result) + " =" + self.integer_base(destination) + " copy " + self.reg(operand))
            int_to_float:
                var prefix = "u"
                if is_signed_int_type(self.program.types, source): prefix = "s"
                var width = "l"
                if bits_of(self.program.types, source) <= 32: width = "w"
                if self.is_float16(destination):
                    let raw = self.temp()
                    self.line(raw + " =s " + prefix + width + "tof " + self.reg(operand))
                    self.emit_float16_round(self.reg(result), raw)
                else:
                    self.line(self.reg(result) + " =" + try self.base_type(destination) + " " + prefix + width + "tof " + self.reg(operand))
            float_to_int:
                try self.guard_float_to_integer(source, destination, operand)
                var prefix = "d"
                if try self.base_type(source) == "s": prefix = "s"
                var sign = "ui"
                if is_signed_int_type(self.program.types, destination): sign = "si"
                let converted = self.temp()
                self.line(converted + " =" + self.integer_base(destination) + " " + prefix + "to" + sign + " " + self.reg(operand))
                if bits_of(self.program.types, destination) < 32:
                    let wide = self.temp()
                    self.line(wide + " =l extsw " + converted)
                    try self.guard_range(destination, wide)
                self.canonicalize_integer(destination, result, converted)
            float_resize:
                if self.is_float16(destination):
                    if bits_of(self.program.types, source) == 64:
                        self.emit_float64_to_float16(self.reg(result), self.reg(operand))
                    else: self.emit_float16_round(self.reg(result), self.reg(operand))
                elif bits_of(self.program.types, source) == 16:
                    if bits_of(self.program.types, destination) == 64:
                        self.line(self.reg(result) + " =d exts " + self.reg(operand))
                    else:
                        self.line(self.reg(result) + " =s copy " + self.reg(operand))
                elif bits_of(self.program.types, source) == 32:
                    self.line(self.reg(result) + " =d exts " + self.reg(operand))
                else:
                    self.line(self.reg(result) + " =s truncd " + self.reg(operand))

    # QBE leaves out-of-domain floating-to-integer conversion target-defined.
    # Canonical MIR promises a trap, so reject NaN and the half-open integer
    # interval before issuing QBE's conversion instruction.
    func guard_float_to_integer(source: TypeId, destination: TypeId, operand: RegisterId) -> !:
        let base = try self.base_type(source)
        let lower = self.float_integer_bound(base, destination, false)
        let upper = self.float_integer_bound(base, destination, true)
        let nan = self.temp()
        let below = self.temp()
        let above = self.temp()
        let outside = self.temp()
        let bad = self.temp()
        self.line(nan + " =w cne" + base + " " + self.reg(operand) + ", " + self.reg(operand))
        self.line(below + " =w clt" + base + " " + self.reg(operand) + ", " + lower)
        self.line(above + " =w cge" + base + " " + self.reg(operand) + ", " + upper)
        self.line(outside + " =w or " + below + ", " + above)
        self.line(bad + " =w or " + nan + ", " + outside)
        self.emit_guard(bad)

    func float_integer_bound(base: str, destination: TypeId, upper: bool) -> str:
        let prefix = base + "_"
        if not upper:
            if not is_signed_int_type(self.program.types, destination): return prefix + "0"
            let bits = bits_of(self.program.types, destination)
            if bits == 8: return prefix + "-128"
            if bits == 16: return prefix + "-32768"
            if bits == 32: return prefix + "-2147483648"
            return prefix + "-9223372036854775808"
        let bits = bits_of(self.program.types, destination)
        if is_signed_int_type(self.program.types, destination):
            if bits == 8: return prefix + "128"
            if bits == 16: return prefix + "32768"
            if bits == 32: return prefix + "2147483648"
            return prefix + "9223372036854775808"
        if bits == 8: return prefix + "256"
        if bits == 16: return prefix + "65536"
        if bits == 32: return prefix + "4294967296"
        return prefix + "18446744073709551616"

    # mark: Structured control ----------------------------------------------------------------

    func open_block(results: RegisterRun):
        let end_label = self.new_label("block_end")
        self.regions.append(Region(kind = RegionKind.block, branch_label = end_label, exit_label = end_label, alternative_label = "", results = results, saw_alternative = false, has_exit_edge = false))

    func open_loop():
        let header = self.new_label("loop")
        let end_label = self.new_label("loop_end")
        if not self.terminated: self.terminate("\tjmp @" + header + "\n")
        self.label(header)
        self.regions.append(Region(kind = RegionKind.loop, branch_label = header, exit_label = end_label, alternative_label = "", results = RegisterRun(start = 0, count = 0), saw_alternative = false, has_exit_edge = false))

    func open_if(condition: RegisterId, results: RegisterRun):
        let yes = self.new_label("if_yes")
        let no = self.new_label("if_no")
        let end_label = self.new_label("if_end")
        self.terminate("\tjnz " + self.reg(condition) + ", @" + yes + ", @" + no + "\n")
        self.label(yes)
        self.regions.append(Region(kind = RegionKind.conditional, branch_label = end_label, exit_label = end_label, alternative_label = no, results = results, saw_alternative = false, has_exit_edge = false))

    func emit_else() -> !:
        if len(self.regions) == 0: error("qbe backend: `Else` without an open region")
        let index = len(self.regions) - 1
        if self.regions[index].kind != RegionKind.conditional or self.regions[index].saw_alternative:
            error("qbe backend: invalid `Else`")
        if not self.terminated:
            self.terminate("\tjmp @" + self.regions[index].exit_label + "\n")
            self.regions[index].has_exit_edge = true
        self.regions[index].saw_alternative = true
        self.label(self.regions[index].alternative_label)

    func close_region() -> !:
        if len(self.regions) == 0: error("qbe backend: `End` without an open region")
        let region = self.regions[len(self.regions) - 1]
        self.regions.remove(len(self.regions) - 1)
        var reaches_exit = region.has_exit_edge
        if region.kind == RegionKind.conditional and not region.saw_alternative:
            if not self.terminated:
                self.terminate("\tjmp @" + region.exit_label + "\n")
                reaches_exit = true
            self.label(region.alternative_label)
            self.terminate("\tjmp @" + region.exit_label + "\n")
            reaches_exit = true
        elif not self.terminated:
            self.terminate("\tjmp @" + region.exit_label + "\n")
            reaches_exit = true
        self.label(region.exit_label)
        if not reaches_exit: self.terminate("\thlt\n")

    func emit_branch(function: MirFunction, depth: i64, values: RegisterRun) -> !:
        let index = try self.region_index(depth)
        let region = self.regions[index]
        if region.kind != RegionKind.loop: self.regions[index].has_exit_edge = true
        try self.assign_results(function, region.results, values)
        self.terminate("\tjmp @" + region.branch_label + "\n")

    func emit_conditional_branch(function: MirFunction, condition: RegisterId, depth: i64, values: RegisterRun) -> !:
        let taken = self.new_label("branch_taken")
        let following = self.new_label("branch_next")
        self.terminate("\tjnz " + self.reg(condition) + ", @" + taken + ", @" + following + "\n")
        self.label(taken)
        let index = try self.region_index(depth)
        let region = self.regions[index]
        if region.kind != RegionKind.loop: self.regions[index].has_exit_edge = true
        try self.assign_results(function, region.results, values)
        self.terminate("\tjmp @" + region.branch_label + "\n")
        self.label(following)

    func emit_return(function: MirFunction, values: RegisterRun) -> !:
        if function.signature.is_fallible:
            if values.count == 2:
                let value = register_at(function, values, 0)
                let value_type = self.register_type(function, value)
                try self.emit_store(value_type, "%q_result_out", self.reg(value))
                self.terminate("\tret " + self.reg(register_at(function, values, 1)) + "\n")
            elif values.count == 1:
                self.terminate("\tret " + self.reg(register_at(function, values, 0)) + "\n")
            else:
                error("qbe backend: fallible return has an invalid arity")
        elif values.count == 0: self.terminate("\tret\n")
        elif values.count == 1: self.terminate("\tret " + self.reg(register_at(function, values, 0)) + "\n")
        else: error("qbe backend: multiple return values are not implemented")

    func assign_results(function: MirFunction, destinations: RegisterRun, values: RegisterRun) -> !:
        if destinations.count != values.count: error("qbe backend: region result arity changed after verification")
        for index in range(0, i64(values.count)):
            let destination = register_at(function, destinations, index)
            let value = register_at(function, values, index)
            self.line(self.reg(destination) + " =" + try self.base_type(self.register_type(function, destination)) + " copy " + self.reg(value))

    func region_index(depth: i64) -> i64!:
        if depth < 0 or depth >= len(self.regions): error("qbe backend: branch depth is outside its regions")
        return len(self.regions) - 1 - depth

    # mark: Binary16 legalization --------------------------------------------------------------

    func is_float16(value_type: TypeId) -> bool:
        match mir_type(self.program.types, value_type):
            Float(bits): return bits == 16
            else: return false

    func emit_float16_bits(value: str) -> str:
        self.uses_float16 = true
        let bits = self.temp()
        self.line(bits + " =w call $luce.f16.to_bits(s " + value + ")")
        return bits

    func emit_float16_round(destination: str, value: str):
        let bits = self.emit_float16_bits(value)
        self.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")

    func emit_float64_to_float16(destination: str, value: str):
        self.uses_float16 = true
        let bits = self.temp()
        self.line(bits + " =w call $luce.f16.double_to_bits(d " + value + ")")
        self.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")

    func emit_load(destination: str, value_type: TypeId, address: str) -> !:
        if self.is_float16(value_type):
            self.uses_float16 = true
            let bits = self.temp()
            self.line(bits + " =w loaduh " + address)
            self.line(destination + " =s call $luce.f16.from_bits(w " + bits + ")")
            return
        self.line(destination + " =" + try self.base_type(value_type) + " " + try self.load_instruction(value_type) + " " + address)

    func emit_store(value_type: TypeId, address: str, value: str) -> !:
        if self.is_float16(value_type):
            let bits = self.emit_float16_bits(value)
            self.line("storeh " + bits + ", " + address)
            return
        self.line(try self.store_instruction(value_type) + " " + value + ", " + address)

    # mark: Type and text helpers ---------------------------------------------------------------

    func base_type(id: TypeId) -> str!:
        if self.is_float16(id): self.uses_float16 = true
        return try qbe_base_type(self.program, id)

    func integer_base(id: TypeId) -> str:
        if bits_of(self.program.types, id) <= 32: return "w"
        return "l"

    # QBE's ABI extension types appear only at C function boundaries. MIR
    # keeps the portable width/sign; this backend chooses the QBE spelling.
    func abi_type(id: TypeId) -> str!:
        if self.is_float16(id): self.uses_float16 = true
        return try qbe_abi_type(self.program, id)

    func load_instruction(id: TypeId) -> str!:
        return try qbe_load_instruction(self.program, id)

    func store_instruction(id: TypeId) -> str!:
        return try qbe_store_instruction(self.program, id)

    func constant(function: MirFunction, result: RegisterId, value: MirConstant) -> str!:
        match value:
            SignedInt(item): return str(item)
            UnsignedInt(item): return str(self.unsigned_bits_as_i64(item))
            Float(item):
                if try self.base_type(self.register_type(function, result)) == "s": return "s_" + str(item)
                return "d_" + str(item)
            Bool(item):
                if item: return "1"
                return "0"
            Null: return "0"

    ## QBE integer constants are signed decimal spellings of fixed-width bit
    ## patterns. Canonical MIR retains the unsigned mathematical value; only
    ## this backend boundary reinterprets its top bit for textual QBE IL.
    func unsigned_bits_as_i64(value: u64) -> i64:
        if value <= u64(9223372036854775807): return i64(value)
        return (-9223372036854775807 - 1) + i64(value - u64(9223372036854775808))

    func register_type(function: MirFunction, register: RegisterId) -> TypeId:
        return function.registers[register.value]

    func list_element_type(function: MirFunction, value: RegisterId) -> TypeId:
        match mir_type(self.program.types, self.register_type(function, value)):
            List(element): return element
            FrozenList(element): return element
            else: trap("verified list instruction has a non-list handle")

    func hash_key_type(function: MirFunction, value: RegisterId) -> TypeId:
        match mir_type(self.program.types, self.register_type(function, value)):
            Map(key, item): return key
            FrozenMap(key, item): return key
            Set(element): return element
            FrozenSet(element): return element
            else: trap("verified hash instruction has a non-map/set handle")

    func hash_value_type(function: MirFunction, value: RegisterId) -> TypeId:
        match mir_type(self.program.types, self.register_type(function, value)):
            Map(key, item): return item
            FrozenMap(key, item): return item
            else: trap("verified hash value instruction has a non-map handle")

    func hash_layout_arguments(function: MirFunction, value: RegisterId) -> str:
        let key = self.hash_key_type(function, value)
        var value_size = 0
        var value_alignment = 1
        match mir_type(self.program.types, self.register_type(function, value)):
            Map(found_key, item):
                value_size = self.layout.size_of(item)
                value_alignment = self.storage_alignment(item)
            FrozenMap(found_key, item):
                value_size = self.layout.size_of(item)
                value_alignment = self.storage_alignment(item)
            Set(element): pass
            FrozenSet(element): pass
            else: trap("verified hash instruction has a non-map/set handle")
        return ", l " + str(self.layout.size_of(key)) + ", l " + str(self.storage_alignment(key)) + ", l " + str(value_size) + ", l " + str(value_alignment)

    func slice_element_type(function: MirFunction, value: RegisterId) -> TypeId:
        match mir_type(self.program.types, self.register_type(function, value)):
            Slice(element): return element
            else: trap("verified slice instruction has a non-slice handle")

    func mutable_slice_element_type(function: MirFunction, value: RegisterId) -> TypeId:
        match mir_type(self.program.types, self.register_type(function, value)):
            MutableSlice(element): return element
            else: trap("verified mutable-slice instruction has a non-view handle")

    func class_value(function: MirFunction, value: RegisterId) -> MirClass:
        match mir_type(self.program.types, self.register_type(function, value)):
            Class(identity): return self.program.classes[identity.value]
            else: trap("verified class instruction has a non-class handle")

    func widen_integer(value_type: TypeId, register: RegisterId) -> str!:
        let bits = bits_of(self.program.types, value_type)
        if bits == 64: return self.reg(register)
        let widened = self.temp()
        var operation = "extu"
        if is_signed_int_type(self.program.types, value_type): operation = "exts"
        if bits == 8: operation = operation + "b"
        elif bits == 16: operation = operation + "h"
        else: operation = operation + "w"
        self.line(widened + " =l " + operation + " " + self.reg(register))
        return widened

    func arithmetic_value(value_type: TypeId, register: RegisterId) -> str!:
        if bits_of(self.program.types, value_type) < 64: return try self.widen_integer(value_type, register)
        return self.reg(register)

    func guard_range(value_type: TypeId, value: str) -> !:
        let bits = bits_of(self.program.types, value_type)
        let signed = is_signed_int_type(self.program.types, value_type)
        var minimum = 0
        var maximum = 0
        if signed:
            if bits == 8:
                minimum = -128
                maximum = 127
            elif bits == 16:
                minimum = -32768
                maximum = 32767
            else:
                minimum = -2147483647 - 1
                maximum = 2147483647
        else:
            if bits == 8: maximum = 255
            elif bits == 16: maximum = 65535
            else: maximum = 4294967295
        let below = self.temp()
        let above = self.temp()
        let bad = self.temp()
        self.line(below + " =w csltl " + value + ", " + str(minimum))
        self.line(above + " =w csgtl " + value + ", " + str(maximum))
        self.line(bad + " =w or " + below + ", " + above)
        self.emit_guard(bad)

    func emit_guard(bad: str):
        let trap_label = self.new_label("trap")
        let okay = self.new_label("checked")
        self.terminate("\tjnz " + bad + ", @" + trap_label + ", @" + okay + "\n")
        self.label(trap_label)
        self.terminate("\thlt\n")
        self.label(okay)

    func canonicalize_integer(value_type: TypeId, result: RegisterId, value: str):
        let bits = bits_of(self.program.types, value_type)
        if bits >= 32:
            self.line(self.reg(result) + " =" + self.integer_base(value_type) + " copy " + value)
            return
        var operation = "extu"
        if is_signed_int_type(self.program.types, value_type): operation = "exts"
        if bits == 8: operation = operation + "b"
        else: operation = operation + "h"
        self.line(self.reg(result) + " =w " + operation + " " + value)

    func function_name(id: FunctionId) -> str:
        return qbe_function_name(self.program, id)

    func reg(id: RegisterId) -> str:
        return "%r" + str(id.value)

    func temp() -> str:
        let name = "%q" + str(self.temporaries)
        self.temporaries += 1
        return name

    func new_label(prefix: str) -> str:
        let name = prefix + str(self.labels)
        self.labels += 1
        return name

    func line(text: str):
        self.output = self.output + "\t" + text + "\n"

    func terminate(text: str):
        self.output = self.output + text
        self.terminated = true

    func label(name: str):
        self.output = self.output + "@" + name + "\n"
        self.terminated = false

    func ensure_open_block():
        if self.terminated: self.label(self.new_label("dead"))
