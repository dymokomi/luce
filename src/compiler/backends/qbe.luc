#==============================================================================================
#
#   qbe - Verified canonical MIR into QBE 1.3 intermediate language
#
#   DESCRIPTION:
#       This is the native stage-1 translation boundary. It does not introduce
#       another shared IR: one emitter flattens MIR's structured regions into
#       QBE blocks, maps registers and memory operations directly, and computes
#       byte layout under QBE's current 64-bit targets. QBE then owns SSA
#       construction, slot promotion, instruction selection, register
#       allocation, C ABI lowering, and assembly emission.
#
#       QBE accepts non-SSA temporaries, which is especially useful for MIR
#       region results. Every `Yield` or value-carrying branch copies into the
#       region's result temporaries; QBE inserts the necessary phi nodes.
#
#       `emit_il` deliberately stops at textual QBE IL. Tool invocation and
#       linking are a separate host concern: they need paths, diagnostics, and
#       an output location, while this translation is deterministic and pure.
#       Keeping the seam explicit makes the emitter unit-testable even when QBE
#       is not installed and prevents shell/toolchain policy leaking into MIR.
#
#==============================================================================================

from compiler.backends.layout import LayoutRules, TypeLayout
from compiler.backends.emission import FunctionEmission, TextEmission
from compiler.backends.qbe_float16 import qbe_float16_helpers
from compiler.backends.qbe_representation import qbe_abi_type, qbe_aggregate_type_name, qbe_base_type, qbe_function_name, qbe_load_instruction, qbe_store_instruction
from compiler.backends.qbe_task_support import qbe_program_uses_tasks
from compiler.backends.qbe_tasks import emit_qbe_task_helpers, qbe_task_decode_name, qbe_task_worker_name
from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, FunctionId, InstructionForm, MirConstant
from compiler.mir.canonical import MirClass, MirField, MirFunction, MirProgram, MirSignature, MirTaskResult, RegisterId, RegisterRun, TransferRun, TypeId, UnaryOp
from compiler.runtime_contract import RuntimeService
from compiler.mir.canonical import bits_of, builtin_mir_type, describe_mir_type, find_runtime_binding, is_aggregate_type, is_float_type, is_int_type
from compiler.mir.canonical import is_signed_int_type, mir_type, no_register, register_at, transfer_at

## Pure canonical-MIR to QBE-IL translation.
pub class QbeBackend:
    let clock: (func() -> i64)?

    pub init(clock: (func() -> i64)? = none):
        self.clock = clock

    pub func emit_il(program: MirProgram) -> str!:
        return (try self.emit_il_with_report(program)).text

    pub func emit_il_with_report(program: MirProgram) -> TextEmission!:
        return try QbeEmitter(program, self.clock).emit()

# Current QBE targets are all 64-bit. Target selection remains in the
# toolchain invocation; byte layout belongs here at the backend boundary.
func qbe_layout() -> LayoutRules:
    return LayoutRules(pointer_size = 8, pointer_align = 8)

# QBE's provider reserves one zero-filled BSS arena. Its capacity is a backend
# host policy, never a MIR fact; the source runtime sees only a stable base and
# an all-or-trap committed-prefix request. The loader may commit these pages
# lazily while preserving exactly that contract.
let qbe_arena_capacity: i64 = 67108864

enum RegionKind:
    block
    loop
    conditional

struct Region:
    let kind: RegionKind
    let branch_label: str
    let exit_label: str
    let alternative_label: str
    let results: RegisterRun
    var saw_alternative: bool
    var has_exit_edge: bool

struct QbeTaskShape:
    let result: MirTaskResult
    let failure_type: TypeId

class QbeEmitter:
    let program: MirProgram
    let layout: TypeLayout
    let clock: (func() -> i64)?
    let function_emissions: list[FunctionEmission]
    var output: str
    var labels: i64
    var temporaries: i64
    var regions: list[Region]
    var terminated: bool
    var uses_float16: bool
    let uses_tasks: bool
    var task_site: i64
    var task_group: RegisterId?

    init(program: MirProgram, clock: (func() -> i64)?):
        self.program = program
        self.layout = TypeLayout(program.types, qbe_layout())
        self.clock = clock
        self.function_emissions = list[FunctionEmission]()
        self.output = ""
        self.labels = 0
        self.temporaries = 0
        self.regions = list[Region]()
        self.terminated = false
        self.uses_float16 = false
        self.uses_tasks = qbe_program_uses_tasks(program)
        self.task_site = 0
        self.task_group = none

    func emit() -> TextEmission!:
        try self.emit_c_abi_types()
        try self.emit_data()
        try self.emit_globals()
        for index in range(0, len(self.program.functions)):
            let output_start = len(self.output)
            let started = self.clock_ms()
            try self.emit_function(FunctionId(value = u32(index)), self.program.functions[index])
            self.function_emissions.append(FunctionEmission(
                function = FunctionId(value = u32(index)),
                code_bytes = u64(len(self.output) - output_start),
                codegen_time_ms = self.elapsed_ms(started),
            ))
        if self.program.process_entry != none: try self.emit_process_entry()
        if self.uses_tasks: self.output = self.output + try emit_qbe_task_helpers(self.program)
        if self.uses_float16: self.output = self.output + qbe_float16_helpers() + "\n\n"
        return TextEmission(text = self.output, functions = self.function_emissions)

    func clock_ms() -> i64:
        if self.clock == none: return 0
        let read = self.clock else trap("QBE emission clock disappeared")
        return read()

    func elapsed_ms(start: i64) -> i64:
        if self.clock == none: return 0
        let elapsed = self.clock_ms() - start
        if elapsed < 0: return 0
        return elapsed

    # mark: File-scope definitions -------------------------------------------------------------

    # QBE owns the concrete aggregate vocabulary used to ask its C ABI
    # classifier about exported records. Canonical MIR supplies only ordered
    # structural fields; this backend chooses QBE type names and storage atoms.
    func emit_c_abi_types() -> !:
        let states = list[i64]()
        for value in self.program.types.definitions: states.append(0)
        for function in self.program.functions:
            if function.convention != CallingConvention.c: continue
            for parameter in function.signature.parameters: try self.emit_c_abi_type(parameter, states)
            for result in function.signature.results: try self.emit_c_abi_type(result, states)
        # A callback obtained from C can be invoked without any named extern
        # or locally generated C wrapper carrying its complete signature.
        # Discover those structural ABI types from the canonical indirect call.
        for function in self.program.functions:
            for instruction in function.body:
                match instruction.form:
                    CallIndirect(results, signature, convention, target, arguments):
                        if convention != CallingConvention.c: continue
                        for parameter in signature.parameters: try self.emit_c_abi_type(parameter, states)
                        for result in signature.results: try self.emit_c_abi_type(result, states)
                    else: pass
        for external in self.program.externs:
            if external.convention != CallingConvention.c: continue
            for parameter in external.signature.parameters: try self.emit_c_abi_type(parameter, states)
            for result in external.signature.results: try self.emit_c_abi_type(result, states)

    func emit_c_abi_type(value_type: TypeId, states: list[i64]) -> !:
        if not is_aggregate_type(self.program.types, value_type): return
        if states[value_type.value] == 2: return
        if states[value_type.value] == 1: error("qbe backend: recursive C aggregate type")
        states[value_type.value] = 1
        match mir_type(self.program.types, value_type):
            Struct(fields):
                for field in fields: try self.emit_c_abi_type(field.value_type, states)
                self.output = self.output + "type " + qbe_aggregate_type_name(value_type) + " = {"
                for index in range(0, len(fields)):
                    if index > 0: self.output = self.output + ","
                    self.output = self.output + " " + try self.c_abi_storage_type(fields[index].value_type)
                self.output = self.output + " }\n"
            Array(element, count):
                try self.emit_c_abi_type(element, states)
                self.output = self.output + "type " + qbe_aggregate_type_name(value_type) + " = { " + try self.c_abi_storage_type(element) + " " + str(count) + " }\n"
            else: error("qbe backend: unsupported C aggregate `" + describe_mir_type(self.program.types, value_type) + "`")
        states[value_type.value] = 2
        self.output = self.output + "\n"

    func c_abi_storage_type(value_type: TypeId) -> str!:
        if is_aggregate_type(self.program.types, value_type): return qbe_aggregate_type_name(value_type)
        match mir_type(self.program.types, value_type):
            Int(bits, is_signed):
                if bits == 8: return "b"
                if bits == 16: return "h"
                if bits == 32: return "w"
                if bits == 64: return "l"
            Float(bits):
                if bits == 32: return "s"
                if bits == 64: return "d"
            Bool: return "b"
            Ptr: return "l"
            else: pass
        error("qbe backend: unsupported C aggregate field `" + describe_mir_type(self.program.types, value_type) + "`")

    func emit_data() -> !:
        var emitted = false
        if self.has_runtime_arena():
            self.output = self.output + "data $luce_rt_arena_storage = align 16 { z " + str(qbe_arena_capacity) + " }\n"
            emitted = true
        if self.has_runtime_trap():
            self.output = self.output + "data $luce_rt_trap_newline = align 1 { b 10 }\n"
            emitted = true
        if self.uses_tasks:
            self.output = self.output + "data $luce_qbe_task_domain = align 1 { b 108 117 99 101 46 116 97 115 107 }\n"
            emitted = true
        for index in range(0, len(self.program.functions)):
            let function = FunctionId(value = u32(index))
            if not self.function_descriptor_is_used(function): continue
            self.output = self.output + "data $luce_fd" + str(index) + " = align 8 { l $" + self.function_name(function) + ", l 0 }\n"
            emitted = true
        for index in range(0, len(self.program.conformances)):
            let conformance = self.program.conformances[index]
            self.output = self.output + "data $luce_wt" + str(index) + " = align 8 {"
            for requirement in range(0, len(conformance.implementations)):
                if requirement > 0: self.output = self.output + ","
                self.output = self.output + " l " + self.function_descriptor(conformance.implementations[requirement])
            self.output = self.output + " }\n"
            emitted = true
        for index in range(0, len(self.program.data)):
            let item = self.program.data[index]
            self.output = self.output + "data $d" + str(index) + " = align " + str(item.align) + " { "
            if len(item.bytes) == 0:
                self.output = self.output + "z 0"
            else:
                self.output = self.output + "b"
                for byte in item.bytes: self.output = self.output + " " + str(byte)
            self.output = self.output + " }\n"
            emitted = true
        if emitted: self.output = self.output + "\n"

    func function_descriptor_is_used(target: FunctionId) -> bool:
        let process_entry = self.program.process_entry
        if process_entry != none:
            if process_entry.element_retain.value == target.value: return true
            if process_entry.element_release.value == target.value: return true
        for conformance in self.program.conformances:
            if conformance.retain.value == target.value or conformance.release.value == target.value: return true
            for implementation in conformance.implementations:
                if implementation.value == target.value: return true
        for class_value in self.program.classes:
            if class_value.destroyer.value == target.value: return true
        for closure in self.program.closures:
            if closure.destroyer.value == target.value: return true
        for function in self.program.functions:
            for instruction in function.body:
                match instruction.form:
                    HashRelease(value, key_callback, value_callback):
                        if key_callback.value == target.value or value_callback.value == target.value: return true
                    HashCopy(result, value, key_callback, value_callback):
                        if key_callback.value == target.value or value_callback.value == target.value: return true
                    HashSnapshot(result, value, key_callback, value_callback):
                        if key_callback.value == target.value or value_callback.value == target.value: return true
                    HashClear(value, key_callback, value_callback):
                        if key_callback.value == target.value or value_callback.value == target.value: return true
                    ListRelease(value, callback):
                        if callback.value == target.value: return true
                    ListCopy(result, value, callback):
                        if callback.value == target.value: return true
                    ListSnapshot(result, value, callback):
                        if callback.value == target.value: return true
                    ListConcat(result, left, right, callback):
                        if callback.value == target.value: return true
                    ListAppendSlot(result, value, callback):
                        if callback.value == target.value: return true
                    ListInsertSlot(result, value, index, callback):
                        if callback.value == target.value: return true
                    ListRemoveAt(value, index, callback):
                        if callback.value == target.value: return true
                    ListClear(value, callback):
                        if callback.value == target.value: return true
                    ListReserve(value, minimum, callback):
                        if callback.value == target.value: return true
                    ListMutableElementAddress(result, value, index, callback):
                        if callback.value == target.value: return true
                    SliceRelease(value, callback):
                        if callback.value == target.value: return true
                    CellCreate(result, element_type, callback):
                        if callback.value == target.value: return true
                    else: pass
        return false

    # mark: Process entry ======================================================================

    ## Materialize the host's C `argc`/`argv` as owned Luce strings behind
    ## the backend boundary, invoke the unchanged fallible source function,
    ## and release both success- and failure-path values. Rich fatal error
    ## reporting is the separate §13 runtime slice; until then an unhandled
    ## entry error exits with status 1 after deterministic cleanup.
    func emit_process_entry() -> !:
        if self.program.process_entry == none: return
        let entry = self.program.process_entry else trap("process entry disappeared")
        self.regions = list[Region]()
        self.terminated = false
        self.task_group = none
        var element_type = entry.arguments_type
        match mir_type(self.program.types, entry.arguments_type):
            Slice(element): element_type = element
            else: trap("verified process entry has no slice type")
        let create = find_runtime_binding(self.program, RuntimeService.list_create) else trap("verified process entry has no list_create binding")
        let release_list = find_runtime_binding(self.program, RuntimeService.list_release) else trap("verified process entry has no list_release binding")
        let append = find_runtime_binding(self.program, RuntimeService.list_append_slot) else trap("verified process entry has no list_append_slot binding")
        let make_slice = find_runtime_binding(self.program, RuntimeService.list_slice) else trap("verified process entry has no list_slice binding")
        let buffer_data = find_runtime_binding(self.program, RuntimeService.buffer_data) else trap("verified process entry has no buffer_data binding")
        let buffer_length = find_runtime_binding(self.program, RuntimeService.buffer_length) else trap("verified process entry has no buffer_length binding")
        let copy_string = find_runtime_binding(self.program, RuntimeService.c_string_copy) else trap("verified process entry has no c_string_copy binding")
        let release_slice = find_runtime_binding(self.program, RuntimeService.slice_release) else trap("verified process entry has no slice_release binding")
        let pointer_size = self.layout.size_of(builtin_mir_type(BuiltinMirType.pointer))
        let size = self.layout.size_of(element_type)
        let alignment = self.storage_alignment(element_type)

        self.output = self.output + "export function w $main(w %argc, l %argv) {\n@start\n"
        self.line("%entry_list =l call $" + self.function_name(create) + "()")
        self.line("%entry_index =w copy 0")
        self.terminate("\tjmp @entry_test\n")
        self.label("entry_test")
        self.line("%entry_more =w csltw %entry_index, %argc")
        self.terminate("\tjnz %entry_more, @entry_argument, @entry_invoke\n")
        self.label("entry_argument")
        self.line("%entry_index64 =l extsw %entry_index")
        self.line("%entry_offset =l mul %entry_index64, " + str(pointer_size))
        self.line("%entry_argv_slot =l add %argv, %entry_offset")
        self.line("%entry_c_string =l loadl %entry_argv_slot")
        self.line("%entry_owner =l call $" + self.function_name(copy_string) + "(l %entry_c_string)")
        self.line("%entry_data =l call $" + self.function_name(buffer_data) + "(l %entry_owner)")
        self.line("%entry_length =l call $" + self.function_name(buffer_length) + "(l %entry_owner)")
        self.line("%entry_slot =l call $" + self.function_name(append) + "(l %entry_list, l " + str(size) + ", l " + str(alignment) + ", l " + self.function_descriptor(entry.element_retain) + ")")
        self.line("storel %entry_owner, %entry_slot")
        let data_offset = self.layout.field_offset(element_type, 1)
        let length_offset = self.layout.field_offset(element_type, 2)
        self.line("%entry_data_slot =l add %entry_slot, " + str(data_offset))
        self.line("storel %entry_data, %entry_data_slot")
        self.line("%entry_length_slot =l add %entry_slot, " + str(length_offset))
        self.line("storel %entry_length, %entry_length_slot")
        self.line("%entry_index =w add %entry_index, 1")
        self.terminate("\tjmp @entry_test\n")

        self.label("entry_invoke")
        self.line("%entry_count =l extsw %argc")
        self.line("%entry_slice =l call $" + self.function_name(make_slice) + "(l %entry_list, l " + str(size) + ", l 0, l %entry_count)")
        self.line("call $" + self.function_name(release_list) + "(l %entry_list, l " + str(size) + ", l " + str(alignment) + ", l " + self.function_descriptor(entry.element_release) + ")")
        self.line("%entry_error =l alloc16 " + str(self.layout.size_of(entry.failure_type)))
        self.line("%entry_status_out =l alloc4 4")
        self.line("%entry_failure =l call $" + self.function_name(entry.function) + "(l %entry_error, l %entry_slice, l %entry_status_out)")
        self.line("call $" + self.function_name(release_slice) + "(l %entry_slice, l " + str(size) + ", l " + str(alignment) + ", l " + self.function_descriptor(entry.element_release) + ")")
        self.line("%entry_failed =w cnel %entry_failure, 0")
        self.terminate("\tjnz %entry_failed, @entry_failure, @entry_success\n")
        self.label("entry_failure")
        self.line("call $" + self.function_name(entry.failure_release) + "(l %entry_error)")
        self.terminate("\tret 1\n")
        self.label("entry_success")
        self.line("%entry_status =w loadw %entry_status_out")
        self.terminate("\tret %entry_status\n")
        self.output = self.output + "}\n\n"

    func function_descriptor(target: FunctionId) -> str:
        return "$luce_fd" + str(target.value)

    func has_runtime_arena() -> bool:
        for external in self.program.externs:
            if external.convention == CallingConvention.runtime and external.name == "luce_rt_arena": return true
        return false

    func has_runtime_trap() -> bool:
        for external in self.program.externs:
            if external.convention == CallingConvention.runtime and external.name == "luce_rt_trap": return true
        return false

    func emit_globals() -> !:
        for index in range(0, len(self.program.globals)):
            let global = self.program.globals[index]
            let size = self.layout.size_of(global.value_type)
            let align = self.layout.align_of(global.value_type)
            self.output = self.output + "data $g" + str(index) + " = align " + str(align) + " { "
            let initial = global.initial
            if initial == none:
                self.output = self.output + "z " + str(size)
            else:
                let payload = self.program.data[initial.value].bytes
                if len(payload) < size: error("qbe backend: initializer for global `" + global.name + "` is shorter than its type")
                self.output = self.output + "b"
                for offset in range(0, size): self.output = self.output + " " + str(payload[offset])
            self.output = self.output + " }\n"
        if len(self.program.globals) > 0: self.output = self.output + "\n"

    # mark: Functions --------------------------------------------------------------------------

    func emit_function(id: FunctionId, function: MirFunction) -> !:
        if len(function.signature.results) > 1 and not function.signature.is_fallible:
            error("qbe backend: multiple results are not implemented for `" + function.name + "`")
        if function.signature.is_fallible and len(function.signature.results) > 2:
            error("qbe backend: fallible function `" + function.name + "` has an invalid verified signature")

        self.regions = list[Region]()
        self.terminated = false
        self.task_group = none
        if function.is_exported: self.output = self.output + "export "
        self.output = self.output + "function"
        if function.signature.is_fallible:
            self.output = self.output + " l"
        elif len(function.signature.results) == 1:
            if function.convention == CallingConvention.c:
                self.output = self.output + " " + try self.abi_type(function.signature.results[0])
            else:
                self.output = self.output + " " + try self.base_type(function.signature.results[0])
        self.output = self.output + " $" + self.function_name(id) + "("
        for index in range(0, len(function.signature.parameters)):
            if index > 0: self.output = self.output + ", "
            if function.convention == CallingConvention.c:
                self.output = self.output + try self.abi_type(function.signature.parameters[index]) + " %r" + str(index)
            else:
                self.output = self.output + try self.base_type(function.signature.parameters[index]) + " %r" + str(index)
        if function.signature.is_fallible and len(function.signature.results) == 2:
            if len(function.signature.parameters) > 0: self.output = self.output + ", "
            self.output = self.output + "l %q_result_out"
        self.output = self.output + ") {\n@start\n"

        for instruction in function.body:
            try self.emit_instruction(function, instruction.form)
        if len(self.regions) != 0: error("qbe backend: unterminated MIR region in `" + function.name + "`")
        if not self.terminated: error("qbe backend: function `" + function.name + "` has no terminating instruction")
        self.output = self.output + "}\n\n"

    func emit_instruction(function: MirFunction, form: InstructionForm) -> !:
        match form:
            Block(results): self.open_block(results)
            Loop: self.open_loop()
            If(condition, results):
                self.ensure_open_block()
                self.open_if(condition, results)
            Else: try self.emit_else()
            End: try self.close_region()
            Switch(tag): error("qbe backend: `Switch` is not implemented")
            Case(value): error("qbe backend: `Case` outside a supported switch")
            Default: error("qbe backend: `Default` outside a supported switch")
            Br(depth, values):
                self.ensure_open_block()
                try self.emit_branch(function, depth, values)
            BrIf(condition, depth, values):
                self.ensure_open_block()
                try self.emit_conditional_branch(function, condition, depth, values)
            Yield(values):
                self.ensure_open_block()
                try self.emit_branch(function, 0, values)
            Return(values):
                self.ensure_open_block()
                self.emit_task_group_destroy()
                try self.emit_return(function, values)
            Raise(failure):
                self.ensure_open_block()
                self.emit_task_group_destroy()
                self.terminate("\tret " + self.reg(failure) + "\n")
            Trap(reason):
                self.ensure_open_block()
                self.terminate("\thlt\n")
            Unreachable:
                if not self.terminated: self.terminate("\thlt\n")
            else:
                self.ensure_open_block()
                try self.emit_operation(function, form)

    # mark: Straight-line operations -----------------------------------------------------------

    func emit_operation(function: MirFunction, form: InstructionForm) -> !:
        match form:
            Const(result, value):
                let value_type = self.register_type(function, result)
                if self.is_float16(value_type):
                    let raw = self.temp()
                    match value:
                        Float(item):
                            self.line(raw + " =d copy d_" + str(item))
                            self.emit_float64_to_float16(self.reg(result), raw)
                        else: error("qbe backend: Float(16) constant is not floating")
                else:
                    self.line(self.reg(result) + " =" + try self.base_type(value_type) + " copy " + try self.constant(function, result, value))
            Copy(result, source):
                self.line(self.reg(result) + " =" + try self.base_type(self.register_type(function, result)) + " copy " + self.reg(source))
            Binary(result, operation, left, right):
                try self.emit_binary(function, result, operation, left, right)
            Unary(result, operation, operand):
                try self.emit_unary(function, result, operation, operand)
            Convert(result, operation, operand):
                try self.emit_convert(function, result, operation, operand)
            FloatBits(result, operand):
                let source = self.register_type(function, operand)
                if bits_of(self.program.types, source) == 16:
                    let raw = self.emit_float16_bits(self.reg(operand))
                    self.line(self.reg(result) + " =l extuw " + raw)
                elif bits_of(self.program.types, source) == 32:
                    let raw = self.temp()
                    self.line(raw + " =w cast " + self.reg(operand))
                    self.line(self.reg(result) + " =l extuw " + raw)
                else:
                    self.line(self.reg(result) + " =l cast " + self.reg(operand))
            PointerHash(result, operand):
