#==============================================================================================
#
#   clang_fiir - Host Clang boundary for C-header inspection
#
#   DESCRIPTION:
#       Owns the impure target/tool half of FIIR construction and the complete
#       binding-product transaction. The mechanical JSON decoder and raw Luce
#       renderer remain in `compiler.fiir`; process execution, target
#       selection, C adapter generation, scratch files, and captured
#       diagnostics begin here at the backend boundary.
#
#       Each inspection uses one uniquely owned directory supplied by the
#       caller's scratch parent. The same injected Clang executable and
#       argument prefix report the target, predefined scalar facts, header AST,
#       and declaration-specific target facts. No host width or platform
#       spelling is inferred by Luce.
#
#==============================================================================================

from compiler.backends.c_fiir import render_c_adapter
from compiler.fiir.clang import ClangMacroDefinition, ClangMacroProducts, decode_clang_ast, decode_clang_macro_definitions, decode_clang_scalar_facts, render_macro_type_probe, render_macro_value_probe, render_target_fact_probe
from compiler.fiir.schema import FiirModule, FiirSourceOrigin
from compiler.fiir.recipe import attach_binding_recipe, parse_binding_recipe
from compiler.fiir.safe_generator import render_safe_module
from compiler.product_io import install_text_atomically
import compiler.fiir.generator as fiir_products
import std.files
import std.os
import std.paths
import std.strings

# mark: Binding product contract ===============================================================

pub struct CBindingRequest:
    pub let name: str
    pub let header: str
    pub let clang_arguments: list[str]
    pub let macro_constants: list[str]
    pub let recipe_path: str?

pub struct CBindingOutputs:
    pub let fiir: str
    pub let raw_module: str
    pub let c_adapter: str
    pub let safe_module: str?

## The pure source pair produced from one validated FIIR module.
pub struct CBindingProducts:
    pub let raw_module: str
    pub let c_adapter: str
    pub let safe_module: str?

pub func render_binding_products(module: FiirModule, binding: str) -> CBindingProducts!:
    var safe_module: str? = none
    if module.recipe != none: safe_module = try render_safe_module(module)
    return CBindingProducts(
        raw_module = try fiir_products.render_raw_module(module, binding),
        c_adapter = try render_c_adapter(module, binding),
        safe_module = safe_module,
    )

## Inspect, validate, render, and install one C binding. All candidates are
## rendered before any destination changes; FIIR is installed last as the
## durable completion marker for the generated source pair.
pub func bind_c(request: CBindingRequest, outputs: CBindingOutputs, clang_command: str = "clang") -> FiirModule!:
    try validate_binding_request(request, outputs)
    var module = try ClangFiirToolchain(clang_command).inspect(
        request.header,
        request.clang_arguments,
        paths.dir(outputs.fiir),
        request.macro_constants,
    )
    let recipe_path = request.recipe_path
    if recipe_path != none:
        let document = files.read(recipe_path) catch reason:
            error("bind: cannot read recipe `" + recipe_path + "`: " + reason)
        let recipe = try parse_binding_recipe(document, recipe_path, request.name)
        module = try attach_binding_recipe(module, recipe)
    let products = try render_binding_products(module, request.name)
    let encoded = try fiir_products.render_fiir_json(module)
    try install_text_atomically(outputs.raw_module, products.raw_module, "bind: raw module")
    try install_text_atomically(outputs.c_adapter, products.c_adapter, "bind: C adapter")
    if outputs.safe_module != none:
        let safe_path = outputs.safe_module else trap("validated safe output path disappeared")
        let safe = products.safe_module else trap("validated safe binding product disappeared")
        try install_text_atomically(safe_path, safe, "bind: safe module")
    try install_text_atomically(outputs.fiir, encoded, "bind: FIIR")
    return module

func validate_binding_request(request: CBindingRequest, outputs: CBindingOutputs) -> !:
    if outputs.fiir == "": error("bind: FIIR output path cannot be empty")
    if outputs.raw_module == "": error("bind: raw-module output path cannot be empty")
    if outputs.c_adapter == "": error("bind: C-adapter output path cannot be empty")
    if request.recipe_path == none and outputs.safe_module != none:
        error("bind: a safe-module output requires a binding recipe")
    if request.recipe_path != none and outputs.safe_module == none:
        error("bind: a binding recipe requires a safe-module output")
    if outputs.fiir == outputs.raw_module or outputs.fiir == outputs.c_adapter or outputs.raw_module == outputs.c_adapter:
        error("bind: FIIR, raw-module, and C-adapter outputs must be distinct")
    if not strings.ends_with(outputs.fiir, ".json"):
        error("bind: FIIR output must end in `.json`")
    if not strings.ends_with(outputs.raw_module, ".native.luc"):
        error("bind: raw module output must end in `.native.luc`")
    if not strings.ends_with(outputs.c_adapter, ".c"):
        error("bind: C adapter output must end in `.c`")
    let safe = outputs.safe_module
    if safe != none:
        if safe == outputs.fiir or safe == outputs.raw_module or safe == outputs.c_adapter:
            error("bind: safe-module output must be distinct from every raw product")
        if not strings.ends_with(safe, ".luc") or strings.ends_with(safe, ".native.luc"):
            error("bind: safe module output must end in `.luc`, but not `.native.luc`")

# mark: Clang inspection =======================================================================

## Clang is constructor-injected so products can use PATH while tests can
## prove missing-tool diagnostics without changing process-global state.
pub class ClangFiirToolchain:
    let command: str

    pub init(command: str = "clang"):
        self.command = command

    ## Inspect one C header for one explicit Clang argument vector. The
    ## returned FIIR owns all durable facts; scratch output is always removed.
    pub func inspect(header: str, arguments: list[str], scratch_parent: str, macro_constants: list[str]? = none) -> FiirModule!:
        if header == "": error("Clang FIIR toolchain: source header cannot be empty")
        let selected_macros = macro_constants else list[str]()
        let scratch = files.make_temporary_directory(scratch_parent, ".luce-clang-fiir-") catch reason:
            error("Clang FIIR toolchain: cannot create scratch directory: " + reason)
        let empty_source = paths.join(scratch, "empty.c")
        let target_output = paths.join(scratch, "target.txt")
        let target_error = paths.join(scratch, "target.stderr")
        let macro_output = paths.join(scratch, "macros.txt")
        let macro_error = paths.join(scratch, "macros.stderr")
        let ast_output = paths.join(scratch, "ast.json")
        let ast_error = paths.join(scratch, "ast.stderr")
        let macro_inventory_output = paths.join(scratch, "macro-inventory.txt")
        let macro_inventory_error = paths.join(scratch, "macro-inventory.stderr")
        let target_fact_source = paths.join(scratch, "target-facts.c")
        let target_fact_output = paths.join(scratch, "target-facts.json")
        let target_fact_error = paths.join(scratch, "target-facts.stderr")
        let macro_type_source = paths.join(scratch, "macro-types.c")
        let macro_type_output = paths.join(scratch, "macro-types.json")
        let macro_type_error = paths.join(scratch, "macro-types.stderr")
        let macro_value_source = paths.join(scratch, "macro-values.c")
        let macro_value_output = paths.join(scratch, "macro-values.json")
        let macro_value_error = paths.join(scratch, "macro-values.stderr")

        files.write(empty_source, "") catch reason:
            error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot write empty probe source: " + reason))
        self.run(appending(arguments, ["-dumpmachine"]), target_output, target_error, "target query") catch reason:
            error(failure_after_cleanup(scratch, reason))
        let target = read_nonempty(target_output, "target") catch reason:
            error(failure_after_cleanup(scratch, reason))
        self.run(appending(arguments, ["-dM", "-E", "-x", "c", empty_source]), macro_output, macro_error, "predefined-macro query") catch reason:
            error(failure_after_cleanup(scratch, reason))
        let macros = files.read(macro_output) catch reason:
            error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read predefined macros: " + reason))
        let facts = decode_clang_scalar_facts(macros) catch reason:
            error(failure_after_cleanup(scratch, reason))
        self.run(appending(arguments, ["-Xclang", "-ast-dump=json", "-fsyntax-only", "-x", "c", header]), ast_output, ast_error, "header inspection") catch reason:
            error(failure_after_cleanup(scratch, reason))
        let ast = files.read(ast_output) catch reason:
            error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read serialized AST: " + reason))
        var macro_definitions = list[ClangMacroDefinition]()
        if len(selected_macros) > 0:
            self.run(appending(arguments, ["-E", "-dD", "-x", "c", header]), macro_inventory_output, macro_inventory_error, "selected-macro inventory") catch reason:
                error(failure_after_cleanup(scratch, reason))
            let inventory = files.read(macro_inventory_output) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read selected-macro inventory: " + reason))
            let decoded = decode_clang_macro_definitions(inventory, header, selected_macros) catch reason:
                error(failure_after_cleanup(scratch, reason))
            macro_definitions = locate_macro_definitions(decoded) catch reason:
                error(failure_after_cleanup(scratch, reason))
        let probe = render_target_fact_probe(ast, header) catch reason:
            error(failure_after_cleanup(scratch, reason))
        var target_fact_ast = ""
        if probe != "":
            files.write(target_fact_source, probe) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot write target-fact probe: " + reason))
            self.run(appending(arguments, ["-include", header, "-Xclang", "-ast-dump=json", "-fsyntax-only", "-x", "c", target_fact_source]), target_fact_output, target_fact_error, "target-fact query") catch reason:
                error(failure_after_cleanup(scratch, reason))
            target_fact_ast = files.read(target_fact_output) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read target-fact AST: " + reason))
        let macro_type_probe = render_macro_type_probe(macro_definitions)
        var macro_type_ast = ""
        if macro_type_probe != "":
            files.write(macro_type_source, macro_type_probe) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot write macro-type probe: " + reason))
            self.run(appending(arguments, ["-include", header, "-Xclang", "-ast-dump=json", "-Xclang", "-ast-dump-filter=__luce_fiir_macro_type_facts", "-fsyntax-only", "-x", "c", macro_type_source]), macro_type_output, macro_type_error, "macro-type query") catch reason:
                error(failure_after_cleanup(scratch, reason))
            macro_type_ast = files.read(macro_type_output) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read macro-type AST: " + reason))
        let macro_value_probe = render_macro_value_probe(ast, macro_definitions, macro_type_ast) catch reason:
            error(failure_after_cleanup(scratch, reason))
        var macro_value_ast = ""
        if macro_value_probe != "":
            files.write(macro_value_source, macro_value_probe) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot write macro-value probe: " + reason))
            self.run(appending(arguments, ["-include", header, "-Xclang", "-ast-dump=json", "-Xclang", "-ast-dump-filter=__luce_fiir_macro_value_facts", "-fsyntax-only", "-x", "c", macro_value_source]), macro_value_output, macro_value_error, "macro-value query") catch reason:
                error(failure_after_cleanup(scratch, reason))
            macro_value_ast = files.read(macro_value_output) catch reason:
                error(failure_after_cleanup(scratch, "Clang FIIR toolchain: cannot read macro-value AST: " + reason))
        var macro_products: ClangMacroProducts? = none
        if len(macro_definitions) > 0:
            macro_products = ClangMacroProducts(definitions = macro_definitions, type_document = macro_type_ast, value_document = macro_value_ast)
        let module = decode_clang_ast(ast, header, target, arguments, facts, target_fact_ast, macro_products) catch reason:
            error(failure_after_cleanup(scratch, reason))
        files.remove_all(scratch) catch reason:
            error("Clang FIIR toolchain: inspected `" + header + "` but cannot remove scratch `" + scratch + "`: " + reason)
        return module

    func run(arguments: list[str], output_path: str, error_path: str, operation: str) -> !:
        var shell = quote_shell_argument(self.command)
        for argument in arguments: shell += " " + quote_shell_argument(argument)
        shell += " > " + quote_shell_argument(output_path) + " 2> " + quote_shell_argument(error_path)
        let process = os.Process(shell) catch reason:
            error("Clang FIIR toolchain: cannot start `" + self.command + "` for " + operation + ": " + reason)
        let status = process.wait() catch reason:
            error("Clang FIIR toolchain: cannot wait for " + operation + ": " + reason)
        if status != 0: error(tool_failure(operation, status, error_path))

## Clang's preprocessor stream identifies the defining file and line. Recover
## the exact directive column from that source file so FIIR never invents a
## position. Built-in and command-line definitions have no physical file.
func locate_macro_definitions(definitions: list[ClangMacroDefinition]) -> list[ClangMacroDefinition]!:
    let located = list[ClangMacroDefinition]()
    for definition in definitions:
        var column = u32(1)
        if not strings.starts_with(definition.origin.path, "<") or not strings.ends_with(definition.origin.path, ">"):
            let source = files.read(definition.origin.path) catch reason:
                error("Clang FIIR toolchain: cannot read macro origin `" + definition.origin.path + "`: " + reason)
            let lines = strings.split(source, "\n")
            if definition.origin.line == u32(0) or i64(definition.origin.line) > len(lines):
                error("Clang FIIR toolchain: macro `" + definition.name + "` has a source line outside `" + definition.origin.path + "`")
            let line = lines[i64(definition.origin.line) - 1]
            var index = 0
            while index < len(line) and (line[index] == ' ' or line[index] == '\t'): index += 1
            if index >= len(line) or line[index] != '#':
                error("Clang FIIR toolchain: macro `" + definition.name + "` origin does not point at a preprocessing directive")
            column = u32(index + 1)
        located.append(ClangMacroDefinition(
            name = definition.name,
            origin = FiirSourceOrigin(path = definition.origin.path, line = definition.origin.line, column = column),
        ))
    return located

# mark: Diagnostics and cleanup ================================================================

func appending(arguments: list[str], suffix: list[str]) -> list[str]:
    let result = list[str]()
    for argument in arguments: result.append(argument)
    for argument in suffix: result.append(argument)
    return result

func read_nonempty(path: str, product: str) -> str!:
    let value = strings.trim(try files.read(path))
    if value == "": error("Clang FIIR toolchain: Clang returned an empty " + product)
    return value

func tool_failure(operation: str, status: i64, error_path: str) -> str:
    let detail = files.read(error_path) catch reason:
        return "Clang FIIR toolchain: " + operation + " exited with status " + str(status) + " (cannot read stderr: " + reason + ")"
    let trimmed = strings.trim(detail)
    if trimmed == "": return "Clang FIIR toolchain: " + operation + " exited with status " + str(status)
    return "Clang FIIR toolchain: " + operation + " exited with status " + str(status) + ": " + trimmed

func failure_after_cleanup(scratch: str, reason: str) -> str:
    files.remove_all(scratch) catch cleanup_reason:
        return reason + "; cannot remove scratch `" + scratch + "`: " + cleanup_reason
    return reason

# The Stage-0 process boundary is a shell string. Every argument is quoted in
# one place; callers never interpolate a path or user-provided flag directly.
func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"
