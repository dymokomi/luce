#==============================================================================================
#
#   qbe_toolchain - Turn QBE IL into an atomically installed host executable
#
#   DESCRIPTION:
#       `qbe.luc` is the pure canonical-MIR translator. This file owns the
#       deliberately impure half of the QBE backend: child processes, the host
#       assembler/linker, scratch storage, and installation of the finished
#       artifact.
#
#       QBE IL, assembly, diagnostics, and the candidate executable live only
#       in one uniquely owned directory beside the requested output. Regular
#       files deliberately connect the host tools: feeding an entire child
#       stdin before draining stdout can deadlock once both pipes fill. Renaming
#       the candidate into place is atomic on the same filesystem, so a failed
#       build cannot truncate or partly replace the previous artifact and
#       concurrent builds cannot share scratch state.
#
#       Tool stderr is captured inside the owned directory and included in a
#       stage-prefixed diagnostic. Cleanup is attempted on every failure path.
#
#==============================================================================================

from compiler.backends.qbe import QbeBackend
from compiler.backends.qbe_fence_support import qbe_fence_support_source, qbe_program_uses_fences
from compiler.backends.qbe_representation import qbe_symbol_directives
from compiler.profiles.full.backends.qbe_task_support import qbe_program_uses_tasks, qbe_task_support_source
from compiler.backends.emission import FunctionEmission
from compiler.backends.executable import find_executable_entry
from compiler.mir.canonical import MirProgram
import std.files
import std.os
import std.paths
import std.strings

## Materialization facts needed by compiler-product reporting. The target is
## the exact triple reported by the C compiler that linked this artifact.
pub struct QbeMaterialization:
    pub let functions: list[FunctionEmission]
    pub let target: str

## The host half of the QBE backend. Command names are constructor inputs so
## tests can prove missing-tool diagnostics without changing process-global
## state; product builds use `qbe` and `cc` from PATH.
pub class QbeToolchain:
    let qbe_command: str
    let c_compiler_command: str

    pub init(qbe_command: str = "qbe", c_compiler_command: str = "cc"):
        self.qbe_command = qbe_command
        self.c_compiler_command = c_compiler_command

    ## Translate verified canonical MIR, assemble and link it for the host, and
    ## atomically replace `output` only after the complete executable exists.
    pub func materialize(program: MirProgram, output: str, c_sources: list[str]? = none, c_arguments: list[str]? = none) -> !:
        discard(try self.materialize_with_report(program, output, c_sources, c_arguments))

    pub func materialize_with_report(program: MirProgram, output: str, c_sources: list[str]? = none, c_arguments: list[str]? = none) -> QbeMaterialization!:
        discard(try find_executable_entry(program))
        let emission = try QbeBackend(os.clock_ms).emit_il_with_report(program)
        let il = emission.text
        let parent = paths.dir(output)
        let scratch = try files.make_temporary_directory(parent, ".luce-qbe-")
        let il_path = paths.join(scratch, "input.ssa")
        let assembly_path = paths.join(scratch, "output.s")
        let qbe_error = paths.join(scratch, "qbe.stderr")
        let target_output = paths.join(scratch, "target.txt")
        let target_error = paths.join(scratch, "target.stderr")
        let linker_error = paths.join(scratch, "linker.stderr")
        let candidate = paths.join(scratch, "artifact")
        var task_support: str? = none
        var fence_support: str? = none

        self.require_qbe(qbe_error) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let target = self.detect_target(target_output, target_error, c_arguments) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let qbe_target = qbe_target_for(target) catch reason:
            error(failure_after_cleanup(scratch, reason))
        files.write(il_path, il) catch reason:
            error(failure_after_cleanup(scratch, "qbe toolchain: cannot write QBE input: " + reason))
        self.assemble(il_path, assembly_path, qbe_error, qbe_target) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let directives = qbe_symbol_directives(program, target)
        if len(directives) > 0:
            let assembly = files.read(assembly_path) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot read QBE output: " + reason))
            files.write(assembly_path, assembly + directives) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot write symbol directives: " + reason))
        if qbe_program_uses_tasks(program):
            let support_path = paths.join(scratch, "task_support.c")
            files.write(support_path, qbe_task_support_source()) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot write task support: " + reason))
            task_support = support_path
        if qbe_program_uses_fences(program):
            let support_path = paths.join(scratch, "fence_support.c")
            files.write(support_path, qbe_fence_support_source()) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot write fence support: " + reason))
            fence_support = support_path
        self.link(assembly_path, candidate, linker_error, task_support, fence_support, c_sources, c_arguments) catch reason:
            error(failure_after_cleanup(scratch, reason))
        files.rename(candidate, output) catch reason:
            error(failure_after_cleanup(scratch, "qbe toolchain: cannot install `" + output + "`: " + reason))
        files.remove_all(scratch) catch reason:
            error("qbe toolchain: built `" + output + "` but cannot remove scratch `" + scratch + "`: " + reason)
        return QbeMaterialization(functions = emission.functions, target = target)

    ## Translate, assemble, and compile to a library: one relocatable object
    ## a C program links against beside the generated header (`luce build
    ## --lib`, base.md §19.6). No entry is required and nothing is linked; a
    ## program that needs the fence or task shims is refused, since the
    ## object holds one translation unit.
    pub func materialize_library_with_report(program: MirProgram, output: str, c_arguments: list[str]? = none) -> QbeMaterialization!:
        if qbe_program_uses_fences(program): error("qbe toolchain: a library cannot carry the fence shims; build an executable or link `fence_support.c` yourself")
        if qbe_program_uses_tasks(program): error("qbe toolchain: a library cannot carry the task runtime; build an executable")
        let emission = try QbeBackend(os.clock_ms).emit_il_with_report(program)
        let parent = paths.dir(output)
        let scratch = try files.make_temporary_directory(parent, ".luce-qbe-")
        let il_path = paths.join(scratch, "input.ssa")
        let assembly_path = paths.join(scratch, "output.s")
        let qbe_error = paths.join(scratch, "qbe.stderr")
        let target_output = paths.join(scratch, "target.txt")
        let target_error = paths.join(scratch, "target.stderr")
        let compiler_error = paths.join(scratch, "compiler.stderr")
        let candidate = paths.join(scratch, "artifact.o")
        self.require_qbe(qbe_error) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let target = self.detect_target(target_output, target_error, c_arguments) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let qbe_target = qbe_target_for(target) catch reason:
            error(failure_after_cleanup(scratch, reason))
        files.write(il_path, emission.text) catch reason:
            error(failure_after_cleanup(scratch, "qbe toolchain: cannot write QBE input: " + reason))
        self.assemble(il_path, assembly_path, qbe_error, qbe_target) catch reason:
            error(failure_after_cleanup(scratch, reason))
        let directives = qbe_symbol_directives(program, target)
        if len(directives) > 0:
            let assembly = files.read(assembly_path) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot read QBE output: " + reason))
            files.write(assembly_path, assembly + directives) catch reason:
                error(failure_after_cleanup(scratch, "qbe toolchain: cannot write symbol directives: " + reason))
        self.compile_object(assembly_path, candidate, compiler_error, c_arguments) catch reason:
            error(failure_after_cleanup(scratch, reason))
        files.rename(candidate, output) catch reason:
            error(failure_after_cleanup(scratch, "qbe toolchain: cannot install `" + output + "`: " + reason))
        files.remove_all(scratch) catch reason:
            error("qbe toolchain: built `" + output + "` but cannot remove scratch `" + scratch + "`: " + reason)
        return QbeMaterialization(functions = emission.functions, target = target)

    func compile_object(assembly_path: str, candidate: str, error_path: str, c_arguments: list[str]?) -> !:
        var command = quote_shell_argument(self.c_compiler_command)
        if c_arguments != none:
            for argument in c_arguments: command += " " + quote_shell_argument(argument)
        command += " -c -o " + quote_shell_argument(candidate) + " -x assembler " + quote_shell_argument(assembly_path) + " 2> " + quote_shell_argument(error_path)
        let process = os.Process(command) catch reason:
            error("qbe toolchain: cannot start `" + self.c_compiler_command + "`: " + reason)
        let status = process.wait() catch reason:
            error("qbe toolchain: cannot wait for the host compiler: " + reason)
        if status != 0:
            error(tool_failure("host compiler", status, error_path))

    func require_qbe(error_path: str) -> !:
        let command = quote_shell_argument(self.qbe_command) + " -h >/dev/null 2> " + quote_shell_argument(error_path)
        let process = os.Process(command) catch reason:
            error("qbe toolchain: cannot start `" + self.qbe_command + "`: " + reason)
        let status = process.wait() catch reason:
            error("qbe toolchain: cannot wait for QBE: " + reason)
        if status != 0: error(tool_failure("qbe", status, error_path))

    func detect_target(output_path: str, error_path: str, c_arguments: list[str]?) -> str!:
        var command = quote_shell_argument(self.c_compiler_command)
        if c_arguments != none:
            for argument in c_arguments: command += " " + quote_shell_argument(argument)
        command += " -dumpmachine > " + quote_shell_argument(output_path) + " 2> " + quote_shell_argument(error_path)
        let process = os.Process(command) catch reason:
            error("qbe toolchain: cannot start `" + self.c_compiler_command + "`: " + reason)
        let status = process.wait() catch reason:
            error("qbe toolchain: cannot wait for host compiler target: " + reason)
        if status != 0: error(tool_failure("host compiler target query", status, error_path))
        let target = strings.trim(try files.read(output_path))
        if len(target) == 0: error("qbe toolchain: host compiler returned an empty target")
        return target

    func assemble(il_path: str, assembly_path: str, error_path: str, target: str) -> !:
        let command = quote_shell_argument(self.qbe_command) + " -t " + quote_shell_argument(target) + " -o " + quote_shell_argument(assembly_path) + " " + quote_shell_argument(il_path) + " 2> " + quote_shell_argument(error_path)
        let process = os.Process(command) catch reason:
            error("qbe toolchain: cannot start `" + self.qbe_command + "`: " + reason)
        let status = process.wait() catch reason:
            error("qbe toolchain: cannot wait for QBE: " + reason)
        if status != 0:
            error(tool_failure("qbe", status, error_path))

    func link(assembly_path: str, candidate: str, error_path: str, task_support: str?, fence_support: str?, c_sources: list[str]?, c_arguments: list[str]?) -> !:
        var inputs = " -x assembler " + quote_shell_argument(assembly_path)
        if task_support != none:
            # Reset the language after the assembly input: `-x` applies to all
            # following files, and the companion must be compiled as C.
            inputs = inputs + " -x c " + quote_shell_argument(task_support)
        if fence_support != none: inputs = inputs + " -x c " + quote_shell_argument(fence_support)
        if c_sources != none:
            for source in c_sources: inputs += " -x c " + quote_shell_argument(source)
        var command = quote_shell_argument(self.c_compiler_command)
        if c_arguments != none:
            for argument in c_arguments: command += " " + quote_shell_argument(argument)
        command += " -o " + quote_shell_argument(candidate) + inputs + " 2> " + quote_shell_argument(error_path)
        let process = os.Process(command) catch reason:
            error("qbe toolchain: cannot start `" + self.c_compiler_command + "`: " + reason)
        let status = process.wait() catch reason:
            error("qbe toolchain: cannot wait for the host compiler: " + reason)
        if status != 0:
            error(tool_failure("host compiler", status, error_path))

# The shell is the Stage-0 process boundary. Keep its quoting here, beside the
# commands that need it, and never interpolate an unquoted path or tool name.
func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

func tool_failure(tool: str, status: i64, error_path: str) -> str:
    let detail = files.read(error_path) catch reason:
        return "qbe toolchain: " + tool + " exited with status " + str(status) + " (cannot read stderr: " + reason + ")"
    let trimmed = strings.trim(detail)
    if len(trimmed) == 0:
        return "qbe toolchain: " + tool + " exited with status " + str(status)
    return "qbe toolchain: " + tool + " exited with status " + str(status) + ": " + trimmed

func failure_after_cleanup(scratch: str, reason: str) -> str:
    files.remove_all(scratch) catch cleanup_reason:
        return reason + "; cannot remove scratch `" + scratch + "`: " + cleanup_reason
    return reason

# Map the linker's explicit target triple to QBE's target vocabulary. This is
# intentionally behind the backend boundary; no target identity enters HIR or
# canonical MIR. The current product hosts are macOS arm64 and Linux amd64,
# while the additional spellings make QBE's other Unix host builds explicit.
func qbe_target_for(target: str) -> str!:
    if strings.contains(target, "apple"):
        if strings.contains(target, "arm64") or strings.contains(target, "aarch64"): return "arm64_apple"
        if strings.contains(target, "x86_64") or strings.contains(target, "amd64"): return "amd64_apple"
    elif strings.contains(target, "x86_64") or strings.contains(target, "amd64"):
        return "amd64_sysv"
    elif strings.contains(target, "aarch64") or strings.contains(target, "arm64"):
        return "arm64"
    elif strings.contains(target, "riscv64"):
        return "rv64"
    error("qbe toolchain: unsupported host target `" + target + "`")
