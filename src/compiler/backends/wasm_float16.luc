#==============================================================================================
#
#   wasm_float16 - WebAssembly-local IEEE binary16 legalization
#
#   DESCRIPTION:
#       WebAssembly has no binary16 value type. These bytecode emitters carry
#       canonical MIR Float(16) values temporarily in f32 locals, round every
#       producer, and translate two-byte memory representations without
#       exposing that choice outside the Wasm backend.
#
#==============================================================================================

from compiler.backends.wasm_encoding import append_signed, append_unsigned

pub let float16_i32_scratch_count: i64 = 5
pub let float16_i64_scratch_count: i64 = 5

let opcode_if: u8 = 0x04
let opcode_else: u8 = 0x05
let opcode_end: u8 = 0x0B
let opcode_local_get: u8 = 0x20
let opcode_local_set: u8 = 0x21
let opcode_i32_const: u8 = 0x41
let opcode_i32_eqz: u8 = 0x45
let opcode_i32_eq: u8 = 0x46
let opcode_i32_lt_u: u8 = 0x49
let opcode_i32_gt_u: u8 = 0x4B
let opcode_i32_ge_u: u8 = 0x4F
let opcode_i32_clz: u8 = 0x67
let opcode_i32_add: u8 = 0x6A
let opcode_i32_sub: u8 = 0x6B
let opcode_i32_and: u8 = 0x71
let opcode_i32_or: u8 = 0x72
let opcode_i32_shl: u8 = 0x74
let opcode_i32_shr_u: u8 = 0x76
let opcode_i32_reinterpret_f32: u8 = 0xBC
let opcode_i64_reinterpret_f64: u8 = 0xBD
let opcode_f32_reinterpret_i32: u8 = 0xBE
let opcode_i32_wrap_i64: u8 = 0xA7
let opcode_i64_extend_i32_u: u8 = 0xAD
let opcode_i64_const: u8 = 0x42
let opcode_i64_eqz: u8 = 0x50
let opcode_i64_eq: u8 = 0x51
let opcode_i64_lt_u: u8 = 0x54
let opcode_i64_gt_u: u8 = 0x56
let opcode_i64_ge_u: u8 = 0x5A
let opcode_i64_add: u8 = 0x7C
let opcode_i64_sub: u8 = 0x7D
let opcode_i64_and: u8 = 0x83
let opcode_i64_or: u8 = 0x84
let opcode_i64_shl: u8 = 0x86
let opcode_i64_shr_u: u8 = 0x88
let i32_value_type: u8 = 0x7F
let i64_value_type: u8 = 0x7E

# mark: Binary16 legalization =================================================================

# WebAssembly has no binary16 value type. An f16 therefore occupies an f32
# local only while it is live in this backend. Every producer passes through
# this exact round-to-nearest-even conversion, and memory always contains the
# canonical two-byte IEEE encoding promised by MIR's Float(16).
func float16_local(scratch: i64, offset: i64) -> i64:
    if scratch < 0: trap("wasm binary16 legalization has no scratch locals")
    return scratch + offset

func scratch_get(body: list[u8], scratch: i64, offset: i64):
    body.append(opcode_local_get)
    append_unsigned(body, float16_local(scratch, offset))

func scratch_set(body: list[u8], scratch: i64, offset: i64):
    body.append(opcode_local_set)
    append_unsigned(body, float16_local(scratch, offset))

# Consume one f32 and leave its low sixteen binary16 bits as an i32.
pub func append_float16_bits(body: list[u8], scratch: i64):
    let raw = 0
    let sign = 1
    let exponent = 2
    let mantissa = 3
    let temporary = 4

    body.append(opcode_i32_reinterpret_f32)
    scratch_set(body, scratch, raw)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 16)
    body.append(opcode_i32_shr_u)
    append_i32_constant(body, 32768)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, sign)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 23)
    body.append(opcode_i32_shr_u)
    append_i32_constant(body, 255)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, exponent)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 8388607)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, mantissa)

    # NaN and infinity.
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 255)
    body.append(opcode_i32_eq)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, mantissa)
    body.append(opcode_i32_eqz)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, sign)
    append_i32_constant(body, 31744)
    body.append(opcode_i32_or)
    body.append(opcode_else)
    append_i32_constant(body, 32256)
    body.append(opcode_end)
    body.append(opcode_else)

    # Finite overflow.
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 142)
    body.append(opcode_i32_gt_u)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, sign)
    append_i32_constant(body, 31744)
    body.append(opcode_i32_or)
    body.append(opcode_else)

    # Normal versus small magnitude.
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 113)
    body.append(opcode_i32_ge_u)
    body.append(opcode_if)
    body.append(i32_value_type)

    # sign | (((exponent - 112) << 10) + (mantissa >> 13) + round_up)
    scratch_get(body, scratch, sign)
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 112)
    body.append(opcode_i32_sub)
    append_i32_constant(body, 10)
    body.append(opcode_i32_shl)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 13)
    body.append(opcode_i32_shr_u)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 8191)
    body.append(opcode_i32_and)
    append_i32_constant(body, 4096)
    body.append(opcode_i32_gt_u)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 8191)
    body.append(opcode_i32_and)
    append_i32_constant(body, 4096)
    body.append(opcode_i32_eq)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 13)
    body.append(opcode_i32_shr_u)
    append_i32_constant(body, 1)
    body.append(opcode_i32_and)
    body.append(opcode_i32_and)
    body.append(opcode_i32_or)
    body.append(opcode_i32_add)
    body.append(opcode_i32_add)
    body.append(opcode_i32_or)
    body.append(opcode_else)

    # Magnitudes below half the minimum subnormal become signed zero.
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 102)
    body.append(opcode_i32_lt_u)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, sign)
    body.append(opcode_else)

    # Subnormal: restore the hidden bit and round after a variable shift.
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 8388608)
    body.append(opcode_i32_or)
    scratch_set(body, scratch, mantissa)
    append_i32_constant(body, 126)
    scratch_get(body, scratch, exponent)
    body.append(opcode_i32_sub)
    scratch_set(body, scratch, temporary)
    scratch_get(body, scratch, sign)
    scratch_get(body, scratch, mantissa)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_shr_u)

    # remainder > half
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 1)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_shl)
    append_i32_constant(body, 1)
    body.append(opcode_i32_sub)
    body.append(opcode_i32_and)
    append_i32_constant(body, 1)
    scratch_get(body, scratch, temporary)
    append_i32_constant(body, 1)
    body.append(opcode_i32_sub)
    body.append(opcode_i32_shl)
    body.append(opcode_i32_gt_u)

    # remainder == half && base is odd
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 1)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_shl)
    append_i32_constant(body, 1)
    body.append(opcode_i32_sub)
    body.append(opcode_i32_and)
    append_i32_constant(body, 1)
    scratch_get(body, scratch, temporary)
    append_i32_constant(body, 1)
    body.append(opcode_i32_sub)
    body.append(opcode_i32_shl)
    body.append(opcode_i32_eq)
    scratch_get(body, scratch, mantissa)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_shr_u)
    append_i32_constant(body, 1)
    body.append(opcode_i32_and)
    body.append(opcode_i32_and)
    body.append(opcode_i32_or)
    body.append(opcode_i32_add)
    body.append(opcode_i32_or)
    body.append(opcode_end) # underflow/subnormal
    body.append(opcode_end) # normal/small
    body.append(opcode_end) # overflow/range
    body.append(opcode_end) # special/finite

# Consume one f64 and leave its exactly rounded binary16 bits as an i32.
# This cannot demote through f32: values close to a binary16 midpoint can
# round once to that midpoint and a second time to the wrong binary16 value.
pub func append_float64_to_float16_bits(body: list[u8], scratch: i64):
    let raw = 0
    let sign = 1
    let exponent = 2
    let mantissa = 3
    let temporary = 4

    body.append(opcode_i64_reinterpret_f64)
    scratch_set(body, scratch, raw)
    scratch_get(body, scratch, raw)
    append_i64_constant(body, 48)
    body.append(opcode_i64_shr_u)
    append_i64_constant(body, 32768)
    body.append(opcode_i64_and)
    scratch_set(body, scratch, sign)
    scratch_get(body, scratch, raw)
    append_i64_constant(body, 52)
    body.append(opcode_i64_shr_u)
    append_i64_constant(body, 2047)
    body.append(opcode_i64_and)
    scratch_set(body, scratch, exponent)
    scratch_get(body, scratch, raw)
    append_i64_constant(body, 4503599627370495)
    body.append(opcode_i64_and)
    scratch_set(body, scratch, mantissa)

    # NaN and infinity.
    scratch_get(body, scratch, exponent)
    append_i64_constant(body, 2047)
    body.append(opcode_i64_eq)
    body.append(opcode_if)
    body.append(i64_value_type)
    scratch_get(body, scratch, mantissa)
    body.append(opcode_i64_eqz)
    body.append(opcode_if)
    body.append(i64_value_type)
    scratch_get(body, scratch, sign)
    append_i64_constant(body, 31744)
    body.append(opcode_i64_or)
    body.append(opcode_else)
    append_i64_constant(body, 32256)
    body.append(opcode_end)
    body.append(opcode_else)

    # Finite overflow.
    scratch_get(body, scratch, exponent)
    append_i64_constant(body, 1038)
    body.append(opcode_i64_gt_u)
    body.append(opcode_if)
    body.append(i64_value_type)
    scratch_get(body, scratch, sign)
    append_i64_constant(body, 31744)
    body.append(opcode_i64_or)
    body.append(opcode_else)

    # Normal versus small magnitude.
    scratch_get(body, scratch, exponent)
    append_i64_constant(body, 1009)
    body.append(opcode_i64_ge_u)
    body.append(opcode_if)
    body.append(i64_value_type)

    # sign | (((exponent - 1008) << 10) + (mantissa >> 42) + round_up)
    scratch_get(body, scratch, sign)
    scratch_get(body, scratch, exponent)
    append_i64_constant(body, 1008)
    body.append(opcode_i64_sub)
    append_i64_constant(body, 10)
    body.append(opcode_i64_shl)
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 42)
    body.append(opcode_i64_shr_u)
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 4398046511103)
    body.append(opcode_i64_and)
    append_i64_constant(body, 2199023255552)
    body.append(opcode_i64_gt_u)
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 4398046511103)
    body.append(opcode_i64_and)
    append_i64_constant(body, 2199023255552)
    body.append(opcode_i64_eq)
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 42)
    body.append(opcode_i64_shr_u)
    append_i64_constant(body, 1)
    body.append(opcode_i64_and)
    body.append(opcode_i32_wrap_i64)
    body.append(opcode_i32_and)
    body.append(opcode_i32_or)
    body.append(opcode_i64_extend_i32_u)
    body.append(opcode_i64_add)
    body.append(opcode_i64_add)
    body.append(opcode_i64_or)
    body.append(opcode_else)

    # Magnitudes below half the minimum subnormal become signed zero.
    scratch_get(body, scratch, exponent)
    append_i64_constant(body, 998)
    body.append(opcode_i64_lt_u)
    body.append(opcode_if)
    body.append(i64_value_type)
    scratch_get(body, scratch, sign)
    body.append(opcode_else)

    # Subnormal: restore the hidden bit and round after a variable shift.
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 4503599627370496)
    body.append(opcode_i64_or)
    scratch_set(body, scratch, mantissa)
    append_i64_constant(body, 1051)
    scratch_get(body, scratch, exponent)
    body.append(opcode_i64_sub)
    scratch_set(body, scratch, temporary)
    scratch_get(body, scratch, sign)
    scratch_get(body, scratch, mantissa)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i64_shr_u)

    # remainder > half
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 1)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i64_shl)
    append_i64_constant(body, 1)
    body.append(opcode_i64_sub)
    body.append(opcode_i64_and)
    append_i64_constant(body, 1)
    scratch_get(body, scratch, temporary)
    append_i64_constant(body, 1)
    body.append(opcode_i64_sub)
    body.append(opcode_i64_shl)
    body.append(opcode_i64_gt_u)

    # remainder == half && base is odd
    scratch_get(body, scratch, mantissa)
    append_i64_constant(body, 1)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i64_shl)
    append_i64_constant(body, 1)
    body.append(opcode_i64_sub)
    body.append(opcode_i64_and)
    append_i64_constant(body, 1)
    scratch_get(body, scratch, temporary)
    append_i64_constant(body, 1)
    body.append(opcode_i64_sub)
    body.append(opcode_i64_shl)
    body.append(opcode_i64_eq)
    scratch_get(body, scratch, mantissa)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i64_shr_u)
    append_i64_constant(body, 1)
    body.append(opcode_i64_and)
    body.append(opcode_i32_wrap_i64)
    body.append(opcode_i32_and)
    body.append(opcode_i32_or)
    body.append(opcode_i64_extend_i32_u)
    body.append(opcode_i64_add)
    body.append(opcode_i64_or)
    body.append(opcode_end) # underflow/subnormal
    body.append(opcode_end) # normal/small
    body.append(opcode_end) # overflow/range
    body.append(opcode_end) # special/finite
    body.append(opcode_i32_wrap_i64)

# Consume low binary16 bits as an i32 and leave the exact f32 value.
pub func append_float16_value(body: list[u8], scratch: i64):
    let raw = 0
    let sign = 1
    let exponent = 2
    let mantissa = 3
    let temporary = 4

    append_i32_constant(body, 65535)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, raw)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 32768)
    body.append(opcode_i32_and)
    append_i32_constant(body, 16)
    body.append(opcode_i32_shl)
    scratch_set(body, scratch, sign)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 10)
    body.append(opcode_i32_shr_u)
    append_i32_constant(body, 31)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, exponent)
    scratch_get(body, scratch, raw)
    append_i32_constant(body, 1023)
    body.append(opcode_i32_and)
    scratch_set(body, scratch, mantissa)

    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 31)
    body.append(opcode_i32_eq)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, mantissa)
    body.append(opcode_i32_eqz)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, sign)
    append_i32_constant(body, 2139095040)
    body.append(opcode_i32_or)
    body.append(opcode_else)
    append_i32_constant(body, -4194304)
    body.append(opcode_end)
    body.append(opcode_else)

    scratch_get(body, scratch, exponent)
    body.append(opcode_i32_eqz)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, mantissa)
    body.append(opcode_i32_eqz)
    body.append(opcode_if)
    body.append(i32_value_type)
    scratch_get(body, scratch, sign)
    body.append(opcode_else)

    # Subnormal: shift the leading one to bit ten. clz(1..1023) - 21 is
    # exactly the required shift count and avoids a helper loop in each use.
    scratch_get(body, scratch, mantissa)
    body.append(opcode_i32_clz)
    append_i32_constant(body, 21)
    body.append(opcode_i32_sub)
    scratch_set(body, scratch, temporary)
    scratch_get(body, scratch, mantissa)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_shl)
    scratch_set(body, scratch, mantissa)
    scratch_get(body, scratch, sign)
    append_i32_constant(body, 113)
    scratch_get(body, scratch, temporary)
    body.append(opcode_i32_sub)
    append_i32_constant(body, 23)
    body.append(opcode_i32_shl)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 1023)
    body.append(opcode_i32_and)
    append_i32_constant(body, 13)
    body.append(opcode_i32_shl)
    body.append(opcode_i32_or)
    body.append(opcode_i32_or)
    body.append(opcode_end)
    body.append(opcode_else)

    # Normal finite value.
    scratch_get(body, scratch, sign)
    scratch_get(body, scratch, exponent)
    append_i32_constant(body, 112)
    body.append(opcode_i32_add)
    append_i32_constant(body, 23)
    body.append(opcode_i32_shl)
    scratch_get(body, scratch, mantissa)
    append_i32_constant(body, 13)
    body.append(opcode_i32_shl)
    body.append(opcode_i32_or)
    body.append(opcode_i32_or)
    body.append(opcode_end) # zero/subnormal versus normal
    body.append(opcode_end) # special versus finite
    body.append(opcode_f32_reinterpret_i32)

pub func append_float16_round(body: list[u8], scratch: i64):
    append_float16_bits(body, scratch)
    append_float16_value(body, scratch)

func append_i32_constant(body: list[u8], value: i64):
    body.append(opcode_i32_const)
    append_signed(body, value)

func append_i64_constant(body: list[u8], value: i64):
    body.append(opcode_i64_const)
    append_signed(body, value)
