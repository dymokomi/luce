#==============================================================================================
#
#   float_display - Canonical spelling of compiler-owned floating Display values
#
#   DESCRIPTION:
#       Normalizes a host's shortest round-trip float spelling to Luce's
#       width-specific presentation policy. Semantic oracles may use their
#       independently tested host conversion to obtain the shortest digits;
#       the compiled runtime uses Ryū to obtain the same decimal pair. This
#       module owns only presentation, never HIR dispatch or runtime storage.
#
#==============================================================================================

from compiler.formatting.ieee import ieee_float_value
from compiler.formatting.utf8 import string_from_characters

struct ParsedDecimal:
    let negative: bool
    let digits: list[char]
    let decimal_position: i64
    let explicit_exponent: i64

# mark: Public policy =========================================================================

## Binary32 and binary64 use Ryū's established readable fixed/scientific
## windows. Keeping them distinct is required: widening before selecting the
## shortest digits can expose binary32's widened approximation.
pub func display_float32(value: f32) -> str:
    let widened = f64(value)
    if widened != widened: return "nan"
    if widened > 3.4028234663852886e38: return "inf"
    if widened < -3.4028234663852886e38: return "-inf"
    return canonical_float_spelling(str(value), 13, -6)

pub func display_float64(value: f64) -> str:
    if value != value: return "nan"
    if value > 1.7976931348623157e308: return "inf"
    if value < -1.7976931348623157e308: return "-inf"
    return canonical_float_spelling(str(value), 16, -5)

## Render an exact IEEE encoding through the same spelling policy used by
## source-visible values. Binary16 widens exactly to binary64; binary32 must
## narrow before host spelling so its widened approximation never leaks.
pub func display_ieee_float_bits(bits: u64, width: i64) -> str!:
    let value = try ieee_float_value(bits, width)
    if width == 16: return display_float64(value)
    if width == 32: return display_float32(f32(value))
    if width == 64: return display_float64(value)
    error("floating display width must be 16, 32, or 64")

## Convert either a fixed or scientific shortest spelling into one canonical
## presentation. This boundary is public so focused tests can exercise the
## policy without manufacturing every IEEE value through source arithmetic.
pub func canonical_float_spelling(spelling: str, maximum_fixed_digits: i64, minimum_fixed_position: i64) -> str:
    let parsed = parse_decimal(spelling)
    var first = 0
    while first < len(parsed.digits) and parsed.digits[first] == '0': first += 1
    if first == len(parsed.digits):
        if parsed.negative: return "-0.0"
        return "0.0"

    var last = len(parsed.digits) - 1
    while last > first and parsed.digits[last] == '0': last -= 1
    let significant = list[char]()
    for index in range(first, last + 1): significant.append(parsed.digits[index])

    # `position` is Ryū's `kk`: 10^(position-1) <= abs(value) < 10^position.
    let position = parsed.decimal_position - first + parsed.explicit_exponent
    let output = list[char]()
    if parsed.negative: output.append('-')
    if position > 0 and position <= maximum_fixed_digits:
        append_positive_fixed(output, significant, position)
    elif position <= 0 and position > minimum_fixed_position:
        output.append('0')
        output.append('.')
        for zero in range(0, 0 - position): output.append('0')
        append_characters(output, significant)
    else:
        output.append(significant[0])
        if len(significant) > 1:
            output.append('.')
            for index in range(1, len(significant)): output.append(significant[index])
        output.append('e')
        append_text(output, str(position - 1))
    let result = string_from_characters(output) catch reason:
        trap("canonical float display produced invalid Unicode")
    return result

# mark: Decimal parsing =======================================================================

func parse_decimal(spelling: str) -> ParsedDecimal:
    let characters = list[char]()
    for character in spelling: characters.append(character)
    var position = 0
    var negative = false
    if position < len(characters) and characters[position] == '-':
        negative = true
        position += 1
    elif position < len(characters) and characters[position] == '+':
        position += 1

    let digits = list[char]()
    var decimal_position = -1
    while position < len(characters) and characters[position] != 'e' and characters[position] != 'E':
        let character = characters[position]
        if character == '.':
            if decimal_position >= 0: trap("host float spelling contains two decimal points")
            decimal_position = len(digits)
        elif character >= '0' and character <= '9':
            digits.append(character)
        else:
            trap("host float spelling is not decimal")
        position += 1
    if decimal_position < 0: decimal_position = len(digits)
    if len(digits) == 0: trap("host float spelling has no digits")

    var exponent = 0
    if position < len(characters):
        position += 1
        var exponent_negative = false
        if position < len(characters) and characters[position] == '-':
            exponent_negative = true
            position += 1
        elif position < len(characters) and characters[position] == '+':
            position += 1
        if position == len(characters): trap("host float spelling has an empty exponent")
        while position < len(characters):
            let character = characters[position]
            if character < '0' or character > '9': trap("host float spelling has a non-decimal exponent")
            exponent = exponent * 10 + i64(u32(character) - u32('0'))
            position += 1
        if exponent_negative: exponent = 0 - exponent
    return ParsedDecimal(
        negative = negative,
        digits = digits,
        decimal_position = decimal_position,
        explicit_exponent = exponent,
    )

# mark: Rendering =============================================================================

func append_positive_fixed(output: list[char], digits: list[char], position: i64):
    if position >= len(digits):
        append_characters(output, digits)
        for zero in range(len(digits), position): output.append('0')
        output.append('.')
        output.append('0')
        return
    for index in range(0, len(digits)):
        if index == position: output.append('.')
        output.append(digits[index])

func append_characters(output: list[char], value: list[char]):
    for character in value: output.append(character)

func append_text(output: list[char], value: str):
    for character in value: output.append(character)
