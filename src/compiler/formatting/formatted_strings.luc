#==============================================================================================
#
#   formatted_strings - Source normalization for formatted-string text
#
#   DESCRIPTION:
#       Normalizes the text stream around interpolation fields before escape
#       decoding. Fields are zero-width semantic boundaries: they interrupt
#       text tokens without inventing output or losing physical-line state.
#       This module knows only source characters, never HIR types or targets.
#
#==============================================================================================

from compiler.formatting.utf8 import string_from_characters

# mark: Source parts and entry point ===========================================================

## One source fragment. The tokenizer omits empty text tokens, so `Field`
## must remain explicit to diagnose an outdented field at a line boundary.
pub union FormattedSourcePart:
    Text(value: str)
    Field

## Return one normalized spelling per input text part, in encounter order.
## Ordinary formatted strings need no physical-line normalization. Triple
## strings share the exact opening/closing and indentation rules of ordinary
## triple literals while retaining field boundaries.
pub func normalize_formatted_parts(parts: list[FormattedSourcePart], is_triple: bool) -> list[str]!:
    let text = source_text_parts(parts)
    if not is_triple: return text
    if len(text) == 0: return text

    var indentation = 0
    var remove_closing_line = false
    let last = text[len(text) - 1]
    let suffix = trailing_line(last)
    if suffix.has_line_break and spaces_only(suffix.value):
        indentation = len(characters_of(suffix.value))
        remove_closing_line = true

    let prepared = list[str]()
    var text_index = 0
    for part in parts:
        match part:
            Text(value):
                var spelling = value
                if text_index == 0: spelling = without_opening_line_break(spelling)
                if remove_closing_line and text_index == len(text) - 1:
                    spelling = without_closing_line(spelling)
                prepared.append(spelling)
                text_index += 1
            Field: pass

    return try strip_indentation(parts, prepared, indentation)

# mark: Stream normalization ==================================================================

func strip_indentation(parts: list[FormattedSourcePart], text: list[str], indentation: i64) -> list[str]!:
    let output = list[str]()
    var text_index = 0
    var at_line_boundary = first_part_starts_at_line_boundary(parts, text)
    for part in parts:
        match part:
            Field:
                if at_line_boundary and indentation > 0:
                    error("triple-quoted formatted string line is indented less than its closing delimiter")
                at_line_boundary = false
            Text(value):
                let normalized = list[char]()
                let characters = characters_of(text[text_index])
                var position = 0
                while position < len(characters):
                    if at_line_boundary and indentation > 0:
                        let available = leading_spaces(characters, position)
                        if available < indentation:
                            let after = position + available
                            if after == len(characters):
                                # A following field is content on this same
                                # under-indented line; retain the boundary so
                                # the explicit Field part diagnoses it.
                                position = after
                                break
                            if characters[after] != '\n' and characters[after] != '\r':
                                error("triple-quoted formatted string line is indented less than its closing delimiter")
                            position = after
                        else:
                            position += indentation
                        at_line_boundary = false
                        if position >= len(characters): break

                    let character = characters[position]
                    if character == '\r':
                        position += 1
                        if position < len(characters) and characters[position] == '\n': position += 1
                        normalized.append('\n')
                        at_line_boundary = true
                    elif character == '\n':
                        position += 1
                        normalized.append('\n')
                        at_line_boundary = true
                    else:
                        normalized.append(character)
                        position += 1
                        at_line_boundary = false
                output.append(try string_from_characters(normalized))
                text_index += 1
    return output

## Removing the opening structural newline puts the first content fragment at
## a physical line boundary. When the first source part is a field there was
## no structural newline to remove.
func first_part_starts_at_line_boundary(parts: list[FormattedSourcePart], text: list[str]) -> bool:
    if len(parts) == 0 or len(text) == 0: return false
    match parts[0]:
        Text(value): return starts_with_line_break(value)
        Field: return false

# mark: Delimiter lines =======================================================================

struct TrailingLine:
    let value: str
    let has_line_break: bool

func trailing_line(value: str) -> TrailingLine:
    let characters = characters_of(value)
    var start = len(characters)
    while start > 0:
        let previous = characters[start - 1]
        if previous == '\n' or previous == '\r':
            return TrailingLine(value = try_string_range(characters, start, len(characters)), has_line_break = true)
        start -= 1
    return TrailingLine(value = value, has_line_break = false)

func without_opening_line_break(value: str) -> str:
    let characters = characters_of(value)
    if len(characters) == 0: return value
    var start = 0
    if characters[0] == '\r':
        start = 1
        if len(characters) > 1 and characters[1] == '\n': start = 2
    elif characters[0] == '\n': start = 1
    return try_string_range(characters, start, len(characters))

func without_closing_line(value: str) -> str:
    let characters = characters_of(value)
    var end = len(characters)
    while end > 0 and characters[end - 1] == ' ': end -= 1
    if end > 0 and characters[end - 1] == '\n': end -= 1
    if end > 0 and characters[end - 1] == '\r': end -= 1
    return try_string_range(characters, 0, end)

func starts_with_line_break(value: str) -> bool:
    let characters = characters_of(value)
    return len(characters) > 0 and (characters[0] == '\n' or characters[0] == '\r')

func spaces_only(value: str) -> bool:
    for character in characters_of(value):
        if character != ' ': return false
    return true

func leading_spaces(characters: list[char], start: i64) -> i64:
    var position = start
    while position < len(characters) and characters[position] == ' ': position += 1
    return position - start

# mark: Character conversion ==================================================================

func source_text_parts(parts: list[FormattedSourcePart]) -> list[str]:
    let output = list[str]()
    for part in parts:
        match part:
            Text(value): output.append(value)
            Field: pass
    return output

func characters_of(value: str) -> list[char]:
    let result = list[char]()
    for character in value: result.append(character)
    return result

## Delimiter helpers operate on already-valid source characters, so an
## encoding failure is an internal invariant rather than a user diagnostic.
func try_string_range(characters: list[char], start: i64, end: i64) -> str:
    let value = string_from_characters(characters, start, end) catch reason:
        trap("source characters were not valid Unicode scalars")
    return value
