#==============================================================================================
#
#   ieee - Exact binary floating-point representation facts
#
#   DESCRIPTION:
#       Reconstructs the language's IEEE binary16, binary32, or binary64 encoding without
#       relying on a host bit cast. Canonical MIR exposes the same fact through
#       `FloatBits`; semantic consumers use this function when Stage-0 cannot
#       reinterpret a float directly. Byte order, storage, ABI, and target
#       layout do not belong here and remain backend responsibilities.
#
#==============================================================================================

# mark: Semantic encoding =====================================================================

## Return `value`'s IEEE encoding in the low `width` bits of a `u64`.
## NaNs use one canonical quiet payload because payload identity is not a
## source-observable Luce value. Scaling by two is exact for binary floating
## point, and the normalized significand is an exactly representable integer.
pub func ieee_float_bits(value: f64, width: i64) -> u64:
    if width == 16: return binary16_bits(value)
    if width != 32 and width != 64: trap("IEEE encoding width must be 16, 32, or 64")

    var sign_mask = u64(0x8000000000000000)
    var mantissa_bits = 52
    var maximum_exponent = 1023
    var exponent_mask = u64(0x7FF0000000000000)
    var quiet_nan = u64(0x0008000000000000)
    if width == 32:
        sign_mask = u64(0x80000000)
        mantissa_bits = 23
        maximum_exponent = 127
        exponent_mask = u64(0x7F800000)
        quiet_nan = u64(0x00400000)
    let minimum_normal_exponent = 1 - maximum_exponent

    var input = value
    if width == 32: input = f64(f32(value))
    # Reciprocal infinity distinguishes signed zero without consulting a host
    # decimal spelling; all other negative values compare normally.
    let negative = input < 0.0 or (input == 0.0 and 1.0 / input < 0.0)
    var sign = u64(0)
    if negative:
        sign = sign_mask
        input = 0.0 - input
    if input != input: return exponent_mask | quiet_nan
    if input > 1.7976931348623157e308: return sign | exponent_mask
    if input == 0.0: return sign

    var normalized = input
    var exponent = 0
    while normalized >= 2.0:
        normalized /= 2.0
        exponent += 1
    while normalized < 1.0:
        normalized *= 2.0
        exponent -= 1

    if exponent >= minimum_normal_exponent:
        var fraction = normalized - 1.0
        for bit in range(0, mantissa_bits): fraction *= 2.0
        let biased = u64(exponent + maximum_exponent)
        return sign | (biased << u64(mantissa_bits)) | u64(fraction)

    var subnormal = normalized
    for bit in range(0, exponent - minimum_normal_exponent + mantissa_bits): subnormal *= 2.0
    return sign | u64(subnormal)

## Round one host binary64 value to the language's requested IEEE width and
## return the exact result as binary64. Binary32 delegates to Stage-0's exact
## conversion; binary16 is reconstructed from its semantic encoding so hosts
## need no half-precision type or bit-cast facility.
pub func normalize_ieee_float(value: f64, width: i64) -> f64:
    if width == 16: return binary16_value(binary16_bits(value))
    if width == 32: return f64(f32(value))
    if width == 64: return value
    trap("IEEE normalization width must be 16, 32, or 64")

# mark: Binary16 ===============================================================================

# Encode binary16 with round-to-nearest, ties-to-even. Scaling uses only exact
# powers of two; the largest rounded significand is 2048, so every integer and
# midpoint involved is represented exactly in binary64.
func binary16_bits(value: f64) -> u64:
    let negative = value < 0.0 or (value == 0.0 and 1.0 / value < 0.0)
    var sign = u64(0)
    if negative: sign = u64(0x8000)
    var input = value
    if negative: input = 0.0 - input
    if input != input: return u64(0x7E00)
    if input > 1.7976931348623157e308: return sign | u64(0x7C00)
    if input == 0.0: return sign

    var normalized = input
    var exponent = 0
    while normalized >= 2.0:
        normalized /= 2.0
        exponent += 1
    while normalized < 1.0:
        normalized *= 2.0
        exponent -= 1

    if exponent < -14:
        var scaled = input
        for bit in range(0, 24): scaled *= 2.0
        let fraction = round_nearest_even(scaled)
        if fraction >= u64(1024): return sign | u64(0x0400)
        return sign | fraction

    var scaled_fraction = normalized - 1.0
    for bit in range(0, 10): scaled_fraction *= 2.0
    var fraction = round_nearest_even(scaled_fraction)
    if fraction == u64(1024):
        fraction = u64(0)
        exponent += 1
    if exponent > 15: return sign | u64(0x7C00)
    return sign | (u64(exponent + 15) << u64(10)) | fraction

func round_nearest_even(value: f64) -> u64:
    let lower = u64(value)
    let remainder = value - f64(lower)
    if remainder > 0.5: return lower + u64(1)
    if remainder < 0.5: return lower
    if lower % u64(2) == u64(1): return lower + u64(1)
    return lower

func binary16_value(bits: u64) -> f64:
    let negative = (bits & u64(0x8000)) != u64(0)
    let exponent = (bits >> u64(10)) & u64(0x1F)
    let fraction = bits & u64(0x03FF)
    var value = 0.0
    if exponent == u64(0x1F):
        if fraction != u64(0): return 0.0 / 0.0
        value = 1.0 / 0.0
    elif exponent == u64(0):
        value = f64(fraction)
        for bit in range(0, 24): value /= 2.0
    else:
        value = 1.0 + f64(fraction) / 1024.0
        let unbiased = i64(exponent) - 15
        if unbiased >= 0:
            for bit in range(0, unbiased): value *= 2.0
        else:
            for bit in range(0, 0 - unbiased): value /= 2.0
    if negative:
        if value == 0.0: return -0.0
        return 0.0 - value
    return value
