#==============================================================================================
#
#   utf8 - Linear Unicode-scalar encoding for compiler text
#
#   DESCRIPTION:
#       Converts already validated Luce `char` values to UTF-8 without
#       repeated immutable-string concatenation. Source normalization and
#       literal decoding share this byte-level mechanism, while each caller
#       retains ownership of its own syntax and diagnostic policy.
#
#==============================================================================================

import std.strings

# mark: Scalar encoding =======================================================================

## Append one Unicode scalar's canonical UTF-8 spelling.
pub func append_utf8(output: list[u8], character: char) -> !:
    let scalar = i64(u32(character))
    if scalar <= 127:
        output.append(u8(scalar))
    elif scalar <= 2047:
        output.append(u8(192 | (scalar >> 6)))
        output.append(u8(128 | (scalar & 63)))
    elif scalar <= 65535:
        output.append(u8(224 | (scalar >> 12)))
        output.append(u8(128 | ((scalar >> 6) & 63)))
        output.append(u8(128 | (scalar & 63)))
    elif scalar <= 1114111:
        output.append(u8(240 | (scalar >> 18)))
        output.append(u8(128 | ((scalar >> 12) & 63)))
        output.append(u8(128 | ((scalar >> 6) & 63)))
        output.append(u8(128 | (scalar & 63)))
    else:
        error("text contains a value that is not a Unicode scalar")

## Encode a complete character range in linear time.
pub func string_from_characters(characters: list[char], start: i64 = 0, end: i64 = -1) -> str!:
    var upper = end
    if upper < 0: upper = len(characters)
    if start < 0 or upper < start or upper > len(characters):
        error("invalid character range")
    let output = list[u8]()
    for index in range(start, upper): try append_utf8(output, characters[index])
    return strings.from_bytes(output) else error("encoded text is not valid UTF-8")
