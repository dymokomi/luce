#==============================================================================================
#
#   triple_strings - Canonical semantic content of triple-quoted literals
#
#   DESCRIPTION:
#       Owns the source-level line and indentation normalization shared by
#       literal decoding and the canonical formatter. It knows characters and
#       delimiters, never HIR types, runtime storage, targets, or backends.
#
#==============================================================================================

## Rewrite one validated triple-quoted spelling to the equivalent ordinary
## quoted spelling. `prefix_length` preserves `r` or `b`; the tokenizer has
## already established the outer boundary, while this function independently
## validates it for direct callers and tests.
pub func normalize_triple_literal(characters: list[char], prefix_length: i64, kind: str) -> list[char]!:
    let body_start = prefix_length + 3
    if prefix_length < 0 or len(characters) < body_start + 3:
        error("malformed triple-quoted " + kind)
    if not quotes_at(characters, prefix_length) or not quotes_at(characters, len(characters) - 3):
        error("malformed triple-quoted " + kind)

    let close_start = len(characters) - 3
    let close_line = line_start(characters, body_start, close_start)
    let close_has_own_line = close_line > body_start and spaces_only(characters, close_line, close_start)
    var content_end = close_start
    var indentation = 0
    if close_has_own_line:
        indentation = close_start - close_line
        content_end = without_preceding_line_break(characters, close_line)

    var content_start = body_start
    var starts_at_line_boundary = false
    if content_start < content_end and characters[content_start] == '\r':
        content_start += 1
        if content_start < content_end and characters[content_start] == '\n': content_start += 1
        starts_at_line_boundary = true
    elif content_start < content_end and characters[content_start] == '\n':
        content_start += 1
        starts_at_line_boundary = true

    let output = list[char]()
    for index in range(0, prefix_length): output.append(characters[index])
    output.append('"')
    try append_content(
        output,
        characters,
        content_start,
        content_end,
        indentation,
        starts_at_line_boundary,
        kind,
    )
    output.append('"')
    return output

# mark: Indentation normalization ==============================================================

## Append semantic content in one pass. Physical CRLF and CR line endings
## become LF, and every content line that begins at a physical line boundary
## loses exactly the closing delimiter's space indentation. A whitespace-only
## line may be shorter because its indentation has no semantic content.
func append_content(
    output: list[char],
    characters: list[char],
    start: i64,
    end: i64,
    indentation: i64,
    starts_at_line_boundary: bool,
    kind: str,
) -> !:
    var position = start
    var at_line_boundary = starts_at_line_boundary
    while position < end:
        if at_line_boundary and indentation > 0:
            let available = leading_spaces(characters, position, end)
            if available < indentation:
                let after = position + available
                if after < end and characters[after] != '\n' and characters[after] != '\r':
                    error("triple-quoted " + kind + " line is indented less than its closing delimiter")
                position = after
            else:
                position += indentation
            at_line_boundary = false
            if position >= end: break

        let character = characters[position]
        if character == '\r':
            position += 1
            if position < end and characters[position] == '\n': position += 1
            output.append('\n')
            at_line_boundary = true
        elif character == '\n':
            position += 1
            output.append('\n')
            at_line_boundary = true
        else:
            output.append(character)
            position += 1
            at_line_boundary = false

# mark: Delimiter inspection ==================================================================

func quotes_at(characters: list[char], start: i64) -> bool:
    return (
        start >= 0
        and start + 2 < len(characters)
        and characters[start] == '"'
        and characters[start + 1] == '"'
        and characters[start + 2] == '"'
    )

func line_start(characters: list[char], lower: i64, upper: i64) -> i64:
    var position = upper
    while position > lower:
        let previous = characters[position - 1]
        if previous == '\n' or previous == '\r': break
        position -= 1
    return position

func spaces_only(characters: list[char], start: i64, end: i64) -> bool:
    for position in range(start, end):
        if characters[position] != ' ': return false
    return true

func without_preceding_line_break(characters: list[char], line: i64) -> i64:
    var end = line
    if end > 0 and characters[end - 1] == '\n': end -= 1
    if end > 0 and characters[end - 1] == '\r': end -= 1
    return end

func leading_spaces(characters: list[char], start: i64, end: i64) -> i64:
    var position = start
    while position < end and characters[position] == ' ': position += 1
    return position - start
