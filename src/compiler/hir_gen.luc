#==============================================================================================
#
#   hir_gen - Source syntax into typed HIR
#
#   DESCRIPTION:
#       Turns source trees into typed HIR: resolves module and lexical names,
#       checks the implemented type rules, and decodes literal spellings. The
#       semantic analyzer and reference interpreter consume that HIR directly;
#       the lowerer turns it into canonical MIR for compiled backends.
#       Anything the current slice cannot generate yet fails with
#       "not implemented yet".
#
#       Generation runs in two passes: signatures are collected across every
#       module first, so bodies can call forward and across modules; then each
#       body is generated in order. Topics inside this file — and the split to
#       make when a section grows — are modules and imports, aliases,
#       constants, signatures, functions and statements, expressions, literal
#       decoding, and name lookup. Language-defined type spellings live in
#       `core_types.luc`; the names this slice can actually generate live in
#       `builtin_type_id`.
#
#       Two failure idioms, shared with the parser: `try self.fail(...)` raises
#       mid-flow, and a match arm or function tail that cannot continue ends
#       with `error(self.diagnostic(...))` directly.
#
#==============================================================================================

from compiler.core_types import is_core_type_name
from compiler.source import SourceSpan, format_diagnostic
from compiler.syntax import ArgumentSyntax, BindingPatternSyntax, ConstantSyntax, EnumSyntax, ExpressionSyntax
from compiler.syntax import MatchStatementArmSyntax, MatchValueArmSyntax, PatternLiteralSyntax, PatternSyntax
from compiler.syntax import FunctionSyntax, IfBranchSyntax, ModuleSyntax, NominalTypeKind, NominalTypeSyntax, StatementSyntax
from compiler.syntax import SuiteSyntax, TypeAliasSyntax, TypeArgumentSyntax, TypeSyntax
from compiler.tokenizer import Token, TokenKind
from compiler.hir import AssignmentOperation, BinaryOperation, BuiltinType
from compiler.hir import HirConstant, HirFunction, HirNode, HirNodeForm, NodeId, Operands, no_node
from compiler.hir import HirEnum, HirEnumCase, HirField, HirModule, HirParameter, HirPayloadField, HirProgram, HirReceiver, HirStruct
from compiler.hir import HirSymbol, ModuleId, SymbolId, SymbolKind, TypeDefinition, TypeForm, TypeId, TypeTable
from compiler.hir import UnaryOperation, Value, create_builtin_type_table
from compiler.hir import describe_type, integer_maximum, integer_minimum
from compiler.hir import is_floating_type, is_integer_type, is_numeric_type, is_ordered_type
from compiler.hir import is_unsigned_integer_type, resolve_builtin_type, type_forms_match, types_match

# mark: HirGenerator state ====================================================================

## One parsed file with the identity supplied by its caller. This stage never
## guesses module identity from import spelling or source contents.
pub struct SourceModule:
    pub name: str
    pub path: str
    pub syntax: ModuleSyntax

# One collected function signature: everything a call site or a body check
# needs to know about a function before its own body is checked.
struct FunctionSymbol:
    pub symbol: SymbolId
    pub module_index: i64
    pub name: str
    pub is_public: bool
    pub documentation: list[str]
    pub receiver: HirReceiver?
    pub parameters: list[HirParameter]
    pub result: TypeId
    pub syntax: FunctionSyntax
    pub span: SourceSpan

# One declared struct: its name and type identity exist before any field is
# resolved, so fields and methods anywhere may name any struct.
struct CollectedStruct:
    pub module_index: i64
    pub name: str
    pub is_public: bool
    pub documentation: list[str]
    pub type_id: TypeId
    pub fields: list[HirField]
    pub syntax: NominalTypeSyntax
    pub span: SourceSpan

# One declared enum, registered by name before its cases are resolved.
struct CollectedEnum:
    pub module_index: i64
    pub name: str
    pub is_public: bool
    pub documentation: list[str]
    pub type_id: TypeId
    pub cases: list[HirEnumCase]
    pub syntax: EnumSyntax
    pub span: SourceSpan

# What a callee spelling resolved to: a function (with the receiver value
# when it is a method call), a struct whose memberwise initializer is being
# called, or an enum case being constructed.
struct ResolvedCallee:
    pub function_index: i64
    # `no_node` unless this is a method call on a value.
    pub receiver: NodeId
    pub struct_index: i64
    pub enum_index: i64
    pub case_index: i64

# One binding a match arm introduces: its name, symbol, and type, shared by
# every alternative of the arm.
struct ArmBinding:
    pub name: str
    pub symbol: SymbolId
    pub value_type: TypeId

# What the arms of one `match` have covered so far, for exhaustiveness and
# reachability. Literal values are compared structurally; ranges are stored
# as inclusive (low, high) pairs.
class MatchCoverage:
    pub saw_wildcard: bool
    pub cases: list[i64]
    pub literals: list[Value]
    pub ranges: list[Value]

    pub init():
        self.saw_wildcard = false
        self.cases = list[i64]()
        self.literals = list[Value]()
        self.ranges = list[Value]()

struct ImportedModule:
    pub name: str
    pub module_index: i64

struct ImportedFunction:
    pub name: str
    pub function_index: i64

# What one module's imports made visible: module names for qualified calls,
# and selectively imported functions for direct calls.
struct ModuleBindings:
    pub modules: list[ImportedModule]
    pub functions: list[ImportedFunction]

# One live local: `let total = 0` puts a `total` in scope until its suite ends.
struct LocalBinding:
    pub symbol: SymbolId
    pub name: str
    pub value_type: TypeId
    pub is_mutable: bool

# One module-level `type Name = T` waiting to be resolved, or already resolved.
struct CollectedAlias:
    module_index: i64
    name: str
    is_public: bool
    syntax: TypeAliasSyntax
    span: SourceSpan
    resolved: TypeId?

# One module-level constant. `typed` is filled after signatures exist.
struct CollectedConstant:
    symbol: SymbolId
    module_index: i64
    name: str
    is_public: bool
    annotation: TypeSyntax?
    value: ExpressionSyntax
    span: SourceSpan
    # `no_node` until the constant's initializer has been checked.
    typed: NodeId

# This stage resolves source operator spelling and result typing together, so
# no later HIR consumer needs to repeat either half of the operator table.
struct ResolvedBinary:
    pub operation: BinaryOperation
    pub result: TypeId

# The two checked operands retain source order even when contextual literal
# typing needs to learn the right operand's type first.
struct CheckedBinaryOperands:
    pub left: NodeId
    pub right: NodeId

## Generates typed HIR for one whole program. Collection is internal so
## callers cannot run a partial generation; public use begins and ends at
## `HirGenerator.generate`.
pub class HirGenerator:
    sources: list[SourceModule]
    types: TypeTable
    symbols: list[HirSymbol]
    aliases: list[CollectedAlias]
    constants: list[CollectedConstant]
    alias_stack: list[str]
    constant_stack: list[str]
    module_bindings: list[ModuleBindings]
    # Every function signature in the program, across all modules; methods
    # are here too, distinguished by `receiver`.
    functions: list[FunctionSymbol]
    structs: list[CollectedStruct]
    enums: list[CollectedEnum]
    next_symbol: i64
    # The module, function contract, import bindings, live local bindings, and
    # loop depth of whatever is being checked right now.
    current_module: i64
    current_result: TypeId
    current_receiver: HirReceiver?
    bindings: ModuleBindings
    locals: list[LocalBinding]
    loop_depth: i64
    # The node table under construction (see `hir.luc`): children are pushed
    # before their parents, so every `NodeId` a form names already exists.
    nodes: list[HirNode]
    node_types: list[TypeId]
    node_spans: list[SourceSpan]
    extra: list[u32]
    values: list[Value]

    pub init(sources: list[SourceModule]):
        self.sources = sources
        self.types = create_builtin_type_table()
        self.symbols = list[HirSymbol]()
        self.aliases = list[CollectedAlias]()
        self.constants = list[CollectedConstant]()
        self.alias_stack = list[str]()
        self.constant_stack = list[str]()
        self.module_bindings = list[ModuleBindings]()
        self.functions = list[FunctionSymbol]()
        self.structs = list[CollectedStruct]()
        self.enums = list[CollectedEnum]()
        self.next_symbol = 0
        self.current_module = 0
        self.current_result = resolve_builtin_type(BuiltinType.unit)
        self.current_receiver = none
        self.bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        self.locals = list[LocalBinding]()
        self.loop_depth = 0
        self.nodes = list[HirNode]()
        self.node_types = list[TypeId]()
        self.node_spans = list[SourceSpan]()
        self.extra = list[u32]()
        self.values = list[Value]()

    # mark: Node table ==========================================================================

    func push_node(form: HirNodeForm, value_type: TypeId, span: SourceSpan) -> NodeId:
        self.nodes.append(HirNode(form = form))
        self.node_types.append(value_type)
        self.node_spans.append(span)
        return NodeId(value = u32(len(self.nodes) - 1))

    # A statement has no value; its type slot holds `unit`.
    func push_statement(form: HirNodeForm, span: SourceSpan) -> NodeId:
        return self.push_node(form, resolve_builtin_type(BuiltinType.unit), span)

    func push_run(entries: list[u32]) -> Operands:
        let start = len(self.extra)
        for entry in entries: self.extra.append(entry)
        return Operands(start = u32(start), count = u32(len(entries)))

    func push_nodes(ids: list[NodeId]) -> Operands:
        let entries = list[u32]()
        for id in ids: entries.append(id.value)
        return self.push_run(entries)

    func node_form(id: NodeId) -> HirNodeForm:
        return self.nodes[i64(id.value)].form

    func type_of(id: NodeId) -> TypeId:
        return self.node_types[i64(id.value)]

    func span_of(id: NodeId) -> SourceSpan:
        return self.node_spans[i64(id.value)]

    # mark: Generation ==========================================================================

    ## Generate typed HIR or stop at the first semantic problem.
    pub func generate() -> HirProgram!:
        try self.validate_module_names()
        try self.validate_mutating_placements()
        try self.collect_declarations()
        try self.collect_module_bindings()
        try self.resolve_aliases()
        try self.check_constants()

        let modules = list[HirModule]()
        for module_index in range(0, len(self.sources)):
            let source = self.sources[module_index]
            modules.append(HirModule(id = ModuleId(value = u32(module_index)), name = source.name, path = source.path, documentation = source.syntax.documentation))

        let hir_functions = list[HirFunction]()
        for module_index in range(0, len(self.sources)):
            self.enter_module(module_index)
            for function in self.functions:
                if function.module_index == module_index:
                    hir_functions.append(try self.check_function(function))

        let hir_constants = list[HirConstant]()
        for constant in self.constants:
            if constant.typed.value == no_node: trap("constant was not typed")
            hir_constants.append(HirConstant(
                symbol = constant.symbol,
                module = ModuleId(value = u32(constant.module_index)),
                name = constant.name,
                is_public = constant.is_public,
                value = constant.typed,
            ))

        let hir_structs = list[HirStruct]()
        for item in self.structs:
            hir_structs.append(HirStruct(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                fields = item.fields,
                span = item.span,
            ))

        let hir_enums = list[HirEnum]()
        for item in self.enums:
            hir_enums.append(HirEnum(
                module = ModuleId(value = u32(item.module_index)),
                name = item.name,
                is_public = item.is_public,
                documentation = item.documentation,
                cases = item.cases,
                span = item.span,
            ))

        return HirProgram(
            types = self.types,
            symbols = self.symbols,
            modules = modules,
            constants = hir_constants,
            structs = hir_structs,
            enums = hir_enums,
            functions = hir_functions,
            nodes = self.nodes,
            node_types = self.node_types,
            node_spans = self.node_spans,
            extra = self.extra,
            values = self.values,
        )

    # mark: Modules and imports =================================================================

    # Two files may not claim the same module name; the second one loses.
    func validate_module_names() -> !:
        for index in range(0, len(self.sources)):
            for previous in range(0, index):
                if self.sources[previous].name == self.sources[index].name:
                    try self.fail_at(index, self.sources[index].syntax.span, "duplicate module `" + self.sources[index].name + "`")

    # `mutating` describes replacement of a value receiver. Module functions
    # have no receiver, while classes already mutate through shared identity;
    # structs, enums, and interface requirements retain the modifier.
    func validate_mutating_placements() -> !:
        for module_index in range(0, len(self.sources)):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    Function(function):
                        if function.is_mutating:
                            try self.fail_at(module_index, declaration.span, "`mutating` is valid only on value-type methods")
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            for member in nominal.members:
                                match member.value:
                                    Function(function):
                                        if function.is_mutating:
                                            try self.fail_at(module_index, member.span, "class methods do not use `mutating`; class identity already permits field mutation")
                                    else: continue
                    else: continue

    # Turn one module's import lines into name bindings, checking that every
    # imported module exists, every selected function exists and is public,
    # and no two imports land on the same local name.
    func resolve_imports(module_index: i64) -> ModuleBindings!:
        let bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        for imported in self.sources[module_index].syntax.imports:
            let imported_name = imported.path.dotted()
            let imported_module = self.find_source(imported_name)
            if imported_module < 0:
                try self.fail_at(module_index, imported.path.span, "unknown module `" + imported_name + "`")
            if imported_module == module_index:
                try self.fail_at(module_index, imported.path.span, "a module cannot import itself")

            if len(imported.names) == 0:
                let local_name = imported.alias_name else imported.path.last()
                try self.require_free_import_name(module_index, bindings, local_name, imported.span)
                bindings.modules.append(ImportedModule(name = local_name, module_index = imported_module))
            else:
                for selected in imported.names:
                    try self.require_free_import_name(module_index, bindings, selected.name, selected.span)
                    let function_index = self.find_function_in_module(imported_module, selected.name)
                    if function_index < 0:
                        try self.fail_at(module_index, selected.span, "module `" + imported_name + "` has no function `" + selected.name + "`")
                    if not self.functions[function_index].is_public:
                        try self.fail_at(module_index, selected.span, "`" + selected.name + "` is private to module `" + imported_name + "`")
                    bindings.functions.append(ImportedFunction(name = selected.name, function_index = function_index))
        return bindings

    # An imported name may not collide with a declaration or another import.
    func require_free_import_name(module_index: i64, bindings: ModuleBindings, name: str, span: SourceSpan) -> !:
        if self.find_function_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        if self.find_constant_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        if self.find_alias_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        for imported in bindings.modules:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")
        for imported in bindings.functions:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")

    # mark: Signature collection ================================================================

    # The first pass: record aliases, constants, and function signatures so
    # later bodies can see every module-level name.
    func collect_declarations() -> !:
        # Struct names first, so a field or signature anywhere may name a
        # struct declared later or in another module.
        for module_index in range(0, len(self.sources)):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            try self.fail_at(module_index, declaration.span, "class types are not implemented yet")
                        try self.collect_struct_name(module_index, declaration.is_public, declaration.documentation, nominal, declaration.span)
                    Enumeration(enumeration):
                        try self.collect_enum_name(module_index, declaration.is_public, declaration.documentation, enumeration, declaration.span)
                    else: continue
        for module_index in range(0, len(self.sources)):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    Constant(constant):
                        try self.collect_constant(module_index, declaration.is_public, constant, declaration.span)
                    TypeAlias(type_alias):
                        try self.collect_alias(module_index, declaration.is_public, type_alias, declaration.span)
                    Function(function):
                        try self.collect_function(module_index, declaration.is_public, declaration.documentation, none, function, declaration.span)
                    NominalType(nominal):
                        try self.collect_struct_members(module_index, nominal)
                    Enumeration(enumeration):
                        try self.collect_enum_members(module_index, enumeration)
                    InterfaceType(interface_type):
                        try self.fail_at(module_index, declaration.span, "interfaces are not implemented yet")
                    TestDeclaration(test_declaration):
                        try self.fail_at(module_index, declaration.span, "test declarations are not implemented yet")
                    ExportStruct(export_struct):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExportEnum(export_enum):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExportFunction(export_function):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExternType(extern_type):
                        try self.fail_at(module_index, declaration.span, "extern type declarations are not implemented yet")
                    ExternFunction(extern_function):
                        try self.fail_at(module_index, declaration.span, "extern function declarations are not implemented yet")
                    ExternVariable(extern_variable):
                        try self.fail_at(module_index, declaration.span, "extern variable declarations are not implemented yet")
                    ExternStruct(extern_struct):
                        try self.fail_at(module_index, declaration.span, "extern struct declarations are not implemented yet")

    func collect_alias(module_index: i64, is_public: bool, type_alias: TypeAliasSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, type_alias.name, span)
        self.aliases.append(CollectedAlias(
            module_index = module_index,
            name = type_alias.name,
            is_public = is_public,
            syntax = type_alias,
            span = span,
            resolved = none,
        ))

    func collect_constant(module_index: i64, is_public: bool, constant: ConstantSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, constant.name, span)
        let placeholder = resolve_builtin_type(BuiltinType.unit)
        let symbol = self.make_symbol(constant.name, SymbolKind.constant, placeholder)
        self.constants.append(CollectedConstant(
            symbol = symbol,
            module_index = module_index,
            name = constant.name,
            is_public = is_public,
            annotation = constant.annotation,
            value = constant.value,
            span = span,
            typed = NodeId(value = no_node),
        ))

    func require_free_module_name(module_index: i64, name: str, span: SourceSpan) -> !:
        if self.find_function_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_struct_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_enum_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_alias_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_constant_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")

    func collect_module_bindings() -> !:
        for module_index in range(0, len(self.sources)):
            self.module_bindings.append(try self.resolve_imports(module_index))

    func enter_module(module_index: i64):
        self.current_module = module_index
        self.bindings = self.module_bindings[module_index]

    func resolve_aliases() -> !:
        for index in range(0, len(self.aliases)):
            try self.resolve_alias(index)

    func resolve_alias(index: i64) -> TypeId!:
        let item = self.aliases[index]
        let already = item.resolved
        if already != none: return already
        let key = str(item.module_index) + "." + item.name
        for previous in self.alias_stack:
            if previous == key:
                try self.fail_at(item.module_index, item.span, "type alias `" + item.name + "` is recursive")
        self.alias_stack.append(key)
        self.current_module = item.module_index
        let resolved = try self.resolve_type(item.module_index, item.syntax.value)
        self.alias_stack.remove(len(self.alias_stack) - 1)
        self.aliases[index] = CollectedAlias(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            syntax = item.syntax,
            span = item.span,
            resolved = resolved,
        )
        return resolved

    func check_constants() -> !:
        for index in range(0, len(self.constants)):
            try self.resolve_constant(index)

    # Type one constant's initializer, resolving other constants as needed.
    # Cycles (`let a = a`, or `let a = b` / `let b = a`) fail as recursion.
    func resolve_constant(index: i64) -> !:
        let item = self.constants[index]
        if item.typed.value != no_node: return
        let key = str(item.module_index) + "." + item.name
        for previous in self.constant_stack:
            if previous == key:
                try self.fail_at(item.module_index, item.span, "constant `" + item.name + "` is recursive")
        self.constant_stack.append(key)
        let saved_module = self.current_module
        let saved_bindings = self.bindings
        self.enter_module(item.module_index)
        var expected: TypeId? = none
        let annotation = item.annotation
        if annotation != none:
            expected = try self.resolve_type(item.module_index, annotation)
        let typed = try self.check_expression(item.value, expected)
        self.constant_stack.remove(len(self.constant_stack) - 1)
        self.current_module = saved_module
        self.bindings = saved_bindings
        self.symbols[i64(item.symbol.value)] = HirSymbol(
            id = item.symbol,
            name = item.name,
            kind = SymbolKind.constant,
            value_type = self.type_of(typed),
        )
        self.constants[index] = CollectedConstant(
            symbol = item.symbol,
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            annotation = item.annotation,
            value = item.value,
            span = item.span,
            typed = typed,
        )

    # Record one function's signature: resolved parameter and result types,
    # a fresh symbol per parameter, and a fresh symbol for the function itself.
    # A method passes its struct as `receiver`; `self` then takes the struct's
    # type, and every following parameter is ordinary. A default is checked
    # once here as a constant expression and embedded at each call site that
    # omits the argument.
    func collect_function(module_index: i64, is_public: bool, documentation: list[str], receiver: HirReceiver?, function: FunctionSyntax, span: SourceSpan) -> !:
        if receiver == none: try self.require_free_module_name(module_index, function.name, span)
        if len(function.generic_parameters) > 0:
            try self.fail_at(module_index, span, "generic functions are not implemented yet")

        let parameters = list[HirParameter]()
        var has_self = false
        var saw_default = false
        for parameter in function.parameters:
            for previous in parameters:
                if previous.name == parameter.name:
                    try self.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
            var parameter_type = resolve_builtin_type(BuiltinType.unit)
            if parameter.name == "self":
                let owner = receiver else error(self.diagnostic_at(module_index, parameter.span, "`self` is the receiver of a method; only a type member declares it"))
                if len(parameters) > 0: try self.fail_at(module_index, parameter.span, "`self` must be the first parameter")
                parameter_type = owner.owner
                has_self = true
            else:
                let annotation = parameter.annotation else error(self.diagnostic_at(
                    module_index,
                    parameter.span,
                    "parameter `" + parameter.name + "` requires a type",
                ))
                parameter_type = try self.resolve_type(module_index, annotation)
            var default_value = NodeId(value = no_node)
            let default_syntax = parameter.default_value
            if default_syntax != none:
                default_value = try self.check_constant_expression(module_index, default_syntax, parameter_type, "default of parameter `" + parameter.name + "`")
                saw_default = true
            elif saw_default:
                try self.fail_at(module_index, parameter.span, "parameter `" + parameter.name + "` follows a parameter with a default and needs one too")
            let parameter_symbol = self.make_symbol(parameter.name, SymbolKind.parameter, parameter_type)
            parameters.append(HirParameter(symbol = parameter_symbol, name = parameter.name, value_type = parameter_type, default_value = default_value))

        var result = resolve_builtin_type(BuiltinType.unit)
        let result_syntax = function.result
        if result_syntax != none:
            result = try self.resolve_type(module_index, result_syntax)
        var checked_receiver: HirReceiver? = none
        if receiver != none:
            if function.is_mutating and not has_self:
                try self.fail_at(module_index, span, "`mutating` requires a `self` parameter")
            checked_receiver = HirReceiver(owner = receiver.owner, has_self = has_self, is_mutating = function.is_mutating)
        let function_symbol = self.make_symbol(function.name, SymbolKind.function, result)
        self.functions.append(FunctionSymbol(
            symbol = function_symbol,
            module_index = module_index,
            name = function.name,
            is_public = is_public,
            documentation = documentation,
            receiver = checked_receiver,
            parameters = parameters,
            result = result,
            syntax = function,
            span = span,
        ))

    # A field default or parameter default: checked in an empty scope, so it
    # cannot name a local or `self`, and required to be a literal tree
    # (optionally wrapped, grouped, or negated) so it is embeddable anywhere.
    func check_constant_expression(module_index: i64, value: ExpressionSyntax, expected: TypeId, what: str) -> NodeId!:
        let saved_module = self.current_module
        let saved_bindings = self.bindings
        let saved_locals = self.locals
        # Signatures are collected before import bindings exist; a default
        # may not name imports then, and sees an empty binding set.
        self.current_module = module_index
        self.bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        if module_index < len(self.module_bindings): self.enter_module(module_index)
        self.locals = list[LocalBinding]()
        let checked = try self.check_expression(value, expected)
        self.locals = saved_locals
        self.current_module = saved_module
        self.bindings = saved_bindings
        if not self.is_constant_expression(checked):
            try self.fail_at(module_index, value.span, what + " must be a constant expression")
        return checked

    # mark: Structs =============================================================================

    func collect_struct_name(module_index: i64, is_public: bool, documentation: list[str], nominal: NominalTypeSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, nominal.name, span)
        if len(nominal.generic_parameters) > 0:
            try self.fail_at(module_index, span, "generic structs are not implemented yet")
        if len(nominal.interfaces) > 0:
            try self.fail_at(module_index, span, "interfaces are not implemented yet")
        let index = len(self.structs)
        let type_id = self.intern_named(nominal.name, TypeForm.Struct(index = index))
        self.structs.append(CollectedStruct(
            module_index = module_index,
            name = nominal.name,
            is_public = is_public,
            documentation = documentation,
            type_id = type_id,
            fields = list[HirField](),
            syntax = nominal,
            span = span,
        ))

    # Fields are resolved in declaration order and methods are collected as
    # functions with a receiver. A struct may not contain itself by value.
    func collect_struct_members(module_index: i64, nominal: NominalTypeSyntax) -> !:
        let struct_index = self.find_struct_in_module(module_index, nominal.name)
        let fields = list[HirField]()
        for member in nominal.members:
            match member.value:
                Field(field):
                    for previous in fields:
                        if previous.name == field.name:
                            try self.fail_at(module_index, field.span, "duplicate field `" + field.name + "`")
                    if field.is_weak: try self.fail_at(module_index, field.span, "`weak` fields belong to classes, not structs")
                    let field_type = try self.resolve_type(module_index, field.value_type)
                    var default_value = NodeId(value = no_node)
                    let default_syntax = field.default_value
                    if default_syntax != none:
                        default_value = try self.check_constant_expression(module_index, default_syntax, field_type, "default of field `" + field.name + "`")
                    fields.append(HirField(
                        name = field.name,
                        value_type = field_type,
                        is_mutable = field.is_mutable,
                        is_public = member.is_public,
                        documentation = member.documentation,
                        default_value = default_value,
                    ))
                Function(function):
                    if function.name == "init":
                        try self.fail_at(module_index, member.span, "custom initializers are not implemented yet")
                    if self.find_method(self.structs[struct_index].type_id, function.name) >= 0:
                        try self.fail_at(module_index, member.span, "duplicate method `" + function.name + "` in `" + nominal.name + "`")
                    for field in fields:
                        if field.name == function.name:
                            try self.fail_at(module_index, member.span, "`" + function.name + "` is both a field and a method of `" + nominal.name + "`")
                    let receiver = HirReceiver(owner = self.structs[struct_index].type_id, has_self = false, is_mutating = function.is_mutating)
                    try self.collect_function(module_index, member.is_public, member.documentation, receiver, function, member.span)
        let item = self.structs[struct_index]
        self.structs[struct_index] = CollectedStruct(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            type_id = item.type_id,
            fields = fields,
            syntax = item.syntax,
            span = item.span,
        )
        for field in fields:
            if self.contains_struct(field.value_type, struct_index):
                try self.fail_at(module_index, item.span, "struct `" + item.name + "` contains itself through field `" + field.name + "`; use a class or a collection for recursive data")

    # Does a value of `value_type` store a `target` struct inline? Follows
    # tuples, optionals, and other structs, whose fields were resolved
    # earlier or are being resolved now (an empty field list is a struct
    # still being collected, which cannot be the target).
    func contains_struct(value_type: TypeId, target: i64) -> bool:
        return self.contains_type(value_type, self.structs[target].type_id)

    # Does a value of `value_type` store `target` inline? Follows tuples,
    # optionals, structs, and enum payloads.
    func contains_type(value_type: TypeId, target: TypeId) -> bool:
        if types_match(value_type, target): return true
        match self.types.definitions[i64(value_type.value)].form:
            Struct(index):
                for field in self.structs[index].fields:
                    if self.contains_type(field.value_type, target): return true
                return false
            Enum(index):
                for case_value in self.enums[index].cases:
                    for field in case_value.payload:
                        if self.contains_type(field.value_type, target): return true
                return false
            Tuple(elements):
                for element in elements:
                    if self.contains_type(element, target): return true
                return false
            Optional(inner): return self.contains_type(inner, target)
            else: return false

    func find_struct_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.structs)):
            if self.structs[index].module_index == module_index and self.structs[index].name == name: return index
        return -1

    func find_method(owner: TypeId, name: str) -> i64:
        for index in range(0, len(self.functions)):
            let receiver = self.functions[index].receiver
            if receiver == none: continue
            if types_match(receiver.owner, owner) and self.functions[index].name == name: return index
        return -1

    # mark: Enums ===============================================================================

    func collect_enum_name(module_index: i64, is_public: bool, documentation: list[str], enumeration: EnumSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, enumeration.name, span)
        if len(enumeration.generic_parameters) > 0:
            try self.fail_at(module_index, span, "generic enums are not implemented yet")
        if len(enumeration.interfaces) > 0:
            try self.fail_at(module_index, span, "interfaces are not implemented yet")
        let index = len(self.enums)
        let type_id = self.intern_named(enumeration.name, TypeForm.Enum(index = index))
        self.enums.append(CollectedEnum(
            module_index = module_index,
            name = enumeration.name,
            is_public = is_public,
            documentation = documentation,
            type_id = type_id,
            cases = list[HirEnumCase](),
            syntax = enumeration,
            span = span,
        ))

    # Cases in declaration order (the order is the tag); methods are functions
    # with the enum as receiver. An enum may not hold itself by value.
    func collect_enum_members(module_index: i64, enumeration: EnumSyntax) -> !:
        let enum_index = self.find_enum_in_module(module_index, enumeration.name)
        let cases = list[HirEnumCase]()
        for case_syntax in enumeration.cases:
            for previous in cases:
                if previous.name == case_syntax.name:
                    try self.fail_at(module_index, case_syntax.span, "duplicate case `" + case_syntax.name + "`")
            let payload = list[HirPayloadField]()
            for field in case_syntax.payload:
                for previous in payload:
                    if previous.name == field.name:
                        try self.fail_at(module_index, case_syntax.span, "duplicate payload field `" + field.name + "` in case `" + case_syntax.name + "`")
                payload.append(HirPayloadField(name = field.name, value_type = try self.resolve_type(module_index, field.value_type)))
            cases.append(HirEnumCase(name = case_syntax.name, documentation = case_syntax.documentation, payload = payload))
        let item = self.enums[enum_index]
        self.enums[enum_index] = CollectedEnum(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            documentation = item.documentation,
            type_id = item.type_id,
            cases = cases,
            syntax = item.syntax,
            span = item.span,
        )
        for case_value in cases:
            for field in case_value.payload:
                if self.contains_type(field.value_type, item.type_id):
                    try self.fail_at(module_index, item.span, "enum `" + item.name + "` contains itself through case `" + case_value.name + "`; use a class or a collection for recursive data")
        for member in enumeration.methods:
            match member.value:
                Function(function):
                    if self.find_method(item.type_id, function.name) >= 0:
                        try self.fail_at(module_index, member.span, "duplicate method `" + function.name + "` in `" + enumeration.name + "`")
                    for case_value in cases:
                        if case_value.name == function.name:
                            try self.fail_at(module_index, member.span, "`" + function.name + "` is both a case and a method of `" + enumeration.name + "`")
                    let receiver = HirReceiver(owner = item.type_id, has_self = false, is_mutating = function.is_mutating)
                    try self.collect_function(module_index, member.is_public, member.documentation, receiver, function, member.span)
                else: try self.fail_at(module_index, member.span, "an enum declares cases and methods only")

    func find_enum_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.enums)):
            if self.enums[index].module_index == module_index and self.enums[index].name == name: return index
        return -1

    func enum_of(value_type: TypeId) -> i64:
        if value_type.value < 0 or i64(value_type.value) >= len(self.types.definitions): return -1
        match self.types.definitions[i64(value_type.value)].form:
            Enum(index): return index
            else: return -1

    func find_case(enum_index: i64, name: str) -> i64:
        let cases = self.enums[enum_index].cases
        for index in range(0, len(cases)):
            if cases[index].name == name: return index
        return -1

    # The module that declared a struct or enum type.
    func owner_module(owner: TypeId) -> i64:
        let struct_index = self.struct_of(owner)
        if struct_index >= 0: return self.structs[struct_index].module_index
        let enum_index = self.enum_of(owner)
        if enum_index >= 0: return self.enums[enum_index].module_index
        return self.current_module

    func struct_of(value_type: TypeId) -> i64:
        if i64(value_type.value) >= len(self.types.definitions): return -1
        match self.types.definitions[i64(value_type.value)].form:
            Struct(index): return index
            else: return -1

    func find_field(struct_index: i64, name: str) -> i64:
        let fields = self.structs[struct_index].fields
        for index in range(0, len(fields)):
            if fields[index].name == name: return index
        return -1

    # Turn a type spelling into a checked value type. A known-but-unimplemented
    # core type earns "not implemented yet".
    func resolve_type(module_index: i64, value: TypeSyntax) -> TypeId!:
        match value.form:
            Named(path):
                if len(path.parts) == 2:
                    # `module.Struct` through an imported module.
                    let imported = self.find_imported_module_of(module_index, path.parts[0])
                    if imported < 0: try self.fail_at(module_index, path.span, "unknown type `" + path.dotted() + "`")
                    let foreign = self.find_struct_in_module(imported, path.parts[1])
                    if foreign >= 0:
                        if not self.structs[foreign].is_public:
                            try self.fail_at(module_index, path.span, "`" + path.parts[1] + "` is private to module `" + self.sources[imported].name + "`")
                        return self.structs[foreign].type_id
                    let foreign_enum = self.find_enum_in_module(imported, path.parts[1])
                    if foreign_enum < 0: try self.fail_at(module_index, path.span, "module `" + self.sources[imported].name + "` has no type `" + path.parts[1] + "`")
                    if not self.enums[foreign_enum].is_public:
                        try self.fail_at(module_index, path.span, "`" + path.parts[1] + "` is private to module `" + self.sources[imported].name + "`")
                    return self.enums[foreign_enum].type_id
                if len(path.parts) != 1:
                    try self.fail_at(module_index, path.span, "unknown type `" + path.dotted() + "`")
                let name = path.parts[0]
                let alias_index = self.find_alias_in_module(module_index, name)
                if alias_index >= 0: return try self.resolve_alias(alias_index)
                let builtin = builtin_type_id(name)
                if builtin != none: return builtin
                let struct_index = self.find_struct_in_module(module_index, name)
                if struct_index >= 0: return self.structs[struct_index].type_id
                let enum_index = self.find_enum_in_module(module_index, name)
                if enum_index >= 0: return self.enums[enum_index].type_id
                if is_core_type_name(name):
                    error(self.diagnostic_at(module_index, path.span, "type `" + name + "` is not implemented yet"))
                error(self.diagnostic_at(module_index, path.span, "unknown type `" + path.dotted() + "`"))
            Applied(path, arguments):
                if path.dotted() == "slice" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            return self.intern_slice(inner)
                        else:
                            error(self.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
                error(self.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
            GroupedType(grouped):
                return try self.resolve_type(module_index, grouped)
            TupleType(elements):
                let parts = list[TypeId]()
                for element in elements:
                    parts.append(try self.resolve_type(module_index, element))
                return self.intern_tuple(parts)
            FunctionType(parameters, result):
                let parts = list[TypeId]()
                for parameter in parameters:
                    parts.append(try self.resolve_type(module_index, parameter))
                return self.intern_function_type(parts, try self.resolve_type(module_index, result))
            CFunctionType(parameters, result):
                error(self.diagnostic_at(module_index, value.span, "cfunc types are not implemented yet"))
            OptionalType(optional_value):
                return self.intern_optional(try self.resolve_type(module_index, optional_value))
            FallibleType(successful_value):
                return self.intern_fallible(try self.resolve_type(module_index, successful_value))

    # mark: Functions and statements ============================================================

    # The second pass, one function at a time: parameters enter scope, the body
    # is checked statement by statement, and a non-unit function must provably
    # return on every path.
    func check_function(function: FunctionSymbol) -> HirFunction!:
        self.current_result = function.result
        self.current_receiver = function.receiver
        self.locals = list[LocalBinding]()
        self.loop_depth = 0

        # `self` is assignable only in a mutating method (spec §8.7).
        var self_is_mutable = false
        let receiver = function.receiver
        if receiver != none: self_is_mutable = receiver.is_mutating
        for parameter in function.parameters:
            try self.require_free_local_name(parameter.name, function.span)
            let is_mutable = parameter.name == "self" and self_is_mutable
            self.locals.append(LocalBinding(symbol = parameter.symbol, name = parameter.name, value_type = parameter.value_type, is_mutable = is_mutable))

        let body_syntax = function.syntax.body else trap("function definition has no body")
        let body = try self.check_suite(body_syntax.statements)
        if not types_match(function.result, resolve_builtin_type(BuiltinType.unit)) and not self.statements_return(body):
            try self.fail(function.span, "function `" + function.name + "` may finish without returning `" + self.describe_type(function.result) + "`")
        return HirFunction(
            symbol = function.symbol,
            module = ModuleId(value = u32(function.module_index)),
            name = function.name,
            is_public = function.is_public,
            documentation = function.documentation,
            receiver = function.receiver,
            parameters = function.parameters,
            result = function.result,
            body = self.push_nodes(body),
            span = function.span,
        )

    # A suite is one lexical scope: bindings made inside it end with it.
    func check_suite(statements: list[StatementSyntax]) -> list[NodeId]!:
        let outer_count = len(self.locals)
        let typed = list[NodeId]()
        for statement in statements:
            for item in try self.check_statement(statement):
                typed.append(item)
        while len(self.locals) > outer_count:
            self.locals.remove(len(self.locals) - 1)
        return typed

    # Check one statement. Each statement family owns its detailed rules below.
    func check_statement(statement: StatementSyntax) -> list[NodeId]!:
        match statement.form:
            BreakStatement:
                if self.loop_depth == 0: try self.fail(statement.span, "`break` is only valid inside a loop")
                return [self.push_statement(HirNodeForm.BreakStatement, statement.span)]
            ContinueStatement:
                if self.loop_depth == 0: try self.fail(statement.span, "`continue` is only valid inside a loop")
                return [self.push_statement(HirNodeForm.ContinueStatement, statement.span)]
            Binding(is_mutable, pattern, annotation, value):
                return try self.check_binding(is_mutable, pattern, annotation, value, statement.span)
            Assignment(target, operator, value):
                return [try self.check_assignment(target, operator, value, statement.span)]
            ReturnStatement(value):
                return [try self.check_return(value, statement.span)]
            ExpressionStatement(value):
                let printed = try self.check_print_call(value)
                if printed != none: return [printed]
                let checked = try self.check_expression(value, none)
                return [self.push_statement(HirNodeForm.ExpressionStatement(value = checked), statement.span)]
            IfStatement(branches, fallback):
                return [try self.check_if(branches, fallback, statement.span)]
            WhileStatement(condition, body):
                return [try self.check_while(condition, body, statement.span)]
            DeferStatement(value):
                error(self.diagnostic(statement.span, "`defer` is not implemented yet"))
            RecoverStatement(value):
                error(self.diagnostic(statement.span, "`recover` is not implemented yet"))
            ForStatement(name, iterable, body):
                error(self.diagnostic(statement.span, "`for` is not implemented yet"))
            MatchStatement(subject, arms):
                return [try self.check_match_statement(subject, arms, statement.span)]

    # Recognize a bare `print(...)` statement so it can take the special path
    # below; anything else falls through to ordinary expression checking.
    func check_print_call(value: ExpressionSyntax) -> NodeId?!:
        match value.form:
            Call(callee, type_arguments, arguments):
                match callee.form:
                    Name(name):
                        if name == "print": return try self.check_print(type_arguments, arguments, value.span)
                        return none
                    else: return none
            else: return none

    # `print` is the first terminal operation in the executable slice. A
    # string literal becomes `PrintText`, whose bytes are known now; any other
    # `str` expression becomes `PrintValue` and is written at run time.
    func check_print(type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan) -> NodeId!:
        if len(type_arguments) > 0 or len(arguments) != 1 or arguments[0].label != none:
            try self.fail(span, "`print` expects one positional string")
        var literal: Token? = none
        match arguments[0].value.form:
            Literal(token):
                if token.kind == TokenKind.str_lit: literal = token
            else: literal = none
        if literal != none:
            let text = try self.decode_print_text(literal)
            return self.push_statement(HirNodeForm.PrintText(value = text), span)
        let printed = try self.check_expression(arguments[0].value, resolve_builtin_type(BuiltinType.string))
        return self.push_statement(HirNodeForm.PrintValue(value = printed), span)

    # Turn a plain `"..."` spelling into the bytes `print` will write, decoding
    # the handful of escapes the slice supports.
    func decode_print_text(token: Token) -> str!:
        if len(token.text) < 2 or token.text[0] != '"' or token.text[len(token.text) - 1] != '"':
            try self.fail(token.span, "prefixed and triple-quoted strings are not implemented by `print` yet")
        if len(token.text) >= 3 and token.text[1] == '"':
            try self.fail(token.span, "prefixed and triple-quoted strings are not implemented by `print` yet")

        var decoded = ""
        var position = 1
        while position < len(token.text) - 1:
            let c = token.text[position]
            if c != '\\':
                decoded = decoded + str(c)
            else:
                position += 1
                if position >= len(token.text) - 1: try self.fail(token.span, "incomplete string escape")
                match token.text[position]:
                    'n': decoded = decoded + "\n"
                    'r': decoded = decoded + "\r"
                    't': decoded = decoded + "\t"
                    '\\': decoded = decoded + "\\"
                    '"': decoded = decoded + "\""
                    else: try self.fail(token.span, "this string escape is not implemented by `print` yet")
            position += 1
        return decoded

    # `let name = value` or `var name: T = value` — the annotation, when
    # present, becomes the expected type of the initializer.
    func check_binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan) -> list[NodeId]!:
        match pattern:
            Name(name, name_span):
                try self.require_free_local_name(name, name_span)
                var expected: TypeId? = none
                if annotation != none:
                    expected = try self.resolve_type(self.current_module, annotation)
                let checked = try self.check_expression(value, expected)
                let checked_type = self.type_of(checked)
                let symbol = self.make_symbol(name, SymbolKind.local, checked_type)
                self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = checked_type, is_mutable = is_mutable))
                return [self.push_statement(HirNodeForm.Binding(symbol = symbol, is_mutable = is_mutable, value = checked), span)]
            TupleNames(names, pattern_span):
                # Duplicate names report at the binding statement; the pattern
                # stores names without per-name spans.
                var expected: TypeId? = none
                if annotation != none:
                    expected = try self.resolve_type(self.current_module, annotation)
                let checked = try self.check_expression(value, expected)
                let checked_type = self.type_of(checked)
                let elements = self.tuple_elements(checked_type) else error(self.diagnostic(span, "tuple binding requires a tuple value, found `" + self.describe_type(checked_type) + "`"))
                if len(names) != len(elements):
                    try self.fail(span, "tuple binding has " + str(len(names)) + " name(s), value has " + str(len(elements)))
                let tuple_symbol = self.make_symbol("_tuple", SymbolKind.local, checked_type)
                let statements = list[NodeId]()
                statements.append(self.push_statement(HirNodeForm.Binding(symbol = tuple_symbol, is_mutable = false, value = checked), span))
                var index = 0
                while index < len(names):
                    let name = names[index].text
                    try self.require_free_local_name(name, names[index].span)
                    let element_type = elements[index]
                    let symbol = self.make_symbol(name, SymbolKind.local, element_type)
                    self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = element_type, is_mutable = is_mutable))
                    let tuple_ref = self.push_node(HirNodeForm.Reference(symbol = tuple_symbol), checked_type, span)
                    let element = self.push_node(HirNodeForm.Element(value = tuple_ref, index = index), element_type, span)
                    statements.append(self.push_statement(HirNodeForm.Binding(symbol = symbol, is_mutable = is_mutable, value = element), names[index].span))
                    index += 1
                return statements

    # `name = value` and the augmented forms; only mutable local names are
    # assignable in the current slice.
    func check_assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan) -> NodeId!:
        var name = ""
        match target.form:
            Name(value_name): name = value_name
            Member(member_value, field_name): return try self.check_field_assignment(member_value, field_name, operator, value, span)
            else: try self.fail(span, "index assignment is not implemented yet")
        let local_index = self.find_local(name)
        if local_index < 0: try self.fail(span, "unknown local binding `" + name + "`")
        let local = self.locals[local_index]
        if not local.is_mutable:
            if name == "self": try self.fail(span, "cannot assign to `self` in a non-mutating method; declare the method `mutating`")
            try self.fail(span, "cannot assign to immutable binding `" + name + "`; declare it with `var`")
        let checked = try self.check_expression(value, local.value_type)
        # `value += delta` must leave `value` its own type, so the compound
        # operator is checked as the binary operation it abbreviates.
        var operation: AssignmentOperation = AssignmentOperation.Replace
        if operator != "=":
            let binary_operator = operator[0:len(operator) - 1]
            let resolved = try self.resolve_binary_operation(local.value_type, binary_operator, self.type_of(checked), span)
            if not types_match(resolved.result, local.value_type):
                try self.fail(
                    span,
                    "assignment changes `" + name + "` from `" + self.describe_type(local.value_type) + "` to `" + self.describe_type(resolved.result) + "`",
                )
            operation = AssignmentOperation.Combine(operation = resolved.operation)
        return self.push_statement(HirNodeForm.Assignment(symbol = local.symbol, operation = operation, value = checked), span)

    # `root.a.b = value`: the root is a mutable local (or `self` in a mutating
    # method), every field on the way is `var`, and the path is recorded as
    # field indices so no consumer repeats the name resolution.
    func check_field_assignment(member_value: ExpressionSyntax, field_name: str, operator: str, value: ExpressionSyntax, span: SourceSpan) -> NodeId!:
        # Walk down to the root name, collecting field names outermost last.
        let names = [field_name]
        var current = member_value
        var root_name = ""
        while true:
            match current.form:
                Name(candidate):
                    root_name = candidate
                    break
                Member(inner, inner_name):
                    names.append(inner_name)
                    current = inner
                Group(grouped): current = grouped
                else: try self.fail(span, "assignment needs a named place; `" + field_name + "` here is a field of a temporary value")
        let local_index = self.find_local(root_name)
        if local_index < 0: try self.fail(span, "unknown local binding `" + root_name + "`")
        let local = self.locals[local_index]
        if not local.is_mutable:
            if root_name == "self": try self.fail(span, "cannot assign to a field of `self` in a non-mutating method; declare the method `mutating`")
            try self.fail(span, "cannot assign through immutable binding `" + root_name + "`; declare it with `var`")
        let path = list[u32]()
        var place_type = local.value_type
        var index = len(names) - 1
        while index >= 0:
            let struct_index = self.struct_of(place_type)
            if struct_index < 0: try self.fail(span, "`" + self.describe_type(place_type) + "` has no field `" + names[index] + "`")
            let field_index = self.find_field(struct_index, names[index])
            if field_index < 0: try self.fail(span, "struct `" + self.structs[struct_index].name + "` has no field `" + names[index] + "`")
            let field = self.structs[struct_index].fields[field_index]
            if not field.is_public and self.structs[struct_index].module_index != self.current_module:
                try self.fail(span, "field `" + names[index] + "` is private to module `" + self.sources[self.structs[struct_index].module_index].name + "`")
            if not field.is_mutable: try self.fail(span, "cannot assign to `let` field `" + names[index] + "`; declare it with `var`")
            path.append(u32(field_index))
            place_type = field.value_type
            index -= 1
        let checked = try self.check_expression(value, place_type)
        var operation: AssignmentOperation = AssignmentOperation.Replace
        if operator != "=":
            let binary_operator = operator[0:len(operator) - 1]
            let resolved = try self.resolve_binary_operation(place_type, binary_operator, self.type_of(checked), span)
            if not types_match(resolved.result, place_type):
                try self.fail(span, "assignment changes `" + field_name + "` from `" + self.describe_type(place_type) + "` to `" + self.describe_type(resolved.result) + "`")
            operation = AssignmentOperation.Combine(operation = resolved.operation)
        return self.push_statement(HirNodeForm.FieldAssignment(symbol = local.symbol, path = self.push_run(path), operation = operation, value = checked), span)

    # A return must match the enclosing function's contract: a value
    # for a value-returning function, nothing for a unit function.
    func check_return(value: ExpressionSyntax?, span: SourceSpan) -> NodeId!:
        if value == none:
            if not types_match(self.current_result, resolve_builtin_type(BuiltinType.unit)):
                try self.fail(span, "return requires a `" + self.describe_type(self.current_result) + "` value")
            return self.push_statement(HirNodeForm.ReturnStatement(value = NodeId(value = no_node)), span)
        if types_match(self.current_result, resolve_builtin_type(BuiltinType.unit)):
            try self.fail(span, "a `unit` function cannot return a value")
        let checked = try self.check_expression(value, self.current_result)
        return self.push_statement(HirNodeForm.ReturnStatement(value = checked), span)

    # Each `if`/`elif` condition must be bool; every branch body is its own
    # lexical scope.
    func check_if(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan) -> NodeId!:
        # One triple per branch: condition node, body run start, body run count.
        let triples = list[u32]()
        for branch in branches:
            match branch.condition.form:
                Expression(condition):
                    let checked = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
                    let body = self.push_nodes(try self.check_suite(branch.body.statements))
                    triples.append(checked.value)
                    triples.append(body.start)
                    triples.append(body.count)
                else:
                    try self.fail(branch.span, "conditional bindings are not implemented yet")
        var has_fallback = false
        var typed_fallback = Operands(start = 0, count = 0)
        if fallback != none:
            has_fallback = true
            typed_fallback = self.push_nodes(try self.check_suite(fallback.statements))
        return self.push_statement(HirNodeForm.IfStatement(branches = self.push_run(triples), has_fallback = has_fallback, fallback = typed_fallback), span)

    # The loop depth makes `break` and `continue` valid inside the body.
    func check_while(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan) -> NodeId!:
        let checked_condition = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
        self.loop_depth += 1
        let checked_body = try self.check_suite(body.statements)
        self.loop_depth -= 1
        return self.push_statement(HirNodeForm.WhileStatement(condition = checked_condition, body = self.push_nodes(checked_body)), span)

    # mark: Expressions =========================================================================

    # Check one expression. `expected` is the type the surrounding context
    # requires, or none where any type is welcome; every produced expression
    # passes `require_type` on its way out.
    func check_expression(value: ExpressionSyntax, expected: TypeId?) -> NodeId!:
        match value.form:
            Literal(token): return try self.check_literal(token, expected)
            Name(name):
                let local_index = self.find_local(name)
                if local_index >= 0:
                    let local = self.locals[local_index]
                    let reference = self.push_node(HirNodeForm.Reference(symbol = local.symbol), local.value_type, value.span)
                    return try self.require_type(reference, expected)
                let constant_index = self.find_constant_in_module(self.current_module, name)
                if constant_index >= 0:
                    try self.resolve_constant(constant_index)
                    let constant = self.constants[constant_index]
                    if constant.typed.value == no_node: trap("constant was not typed")
                    let reference = self.push_node(HirNodeForm.Reference(symbol = constant.symbol), self.type_of(constant.typed), value.span)
                    return try self.require_type(reference, expected)
                if self.find_visible_function(name) >= 0:
                    try self.fail(value.span, "function values are not implemented yet")
                if self.find_struct_in_module(self.current_module, name) >= 0:
                    try self.fail(value.span, "`" + name + "` is a type; construct a value with `" + name + "(...)` or call a type function with `" + name + ".name(...)`")
                if self.find_enum_in_module(self.current_module, name) >= 0:
                    try self.fail(value.span, "`" + name + "` is a type; name a case with `" + name + ".case`")
                error(self.diagnostic(value.span, "unknown name `" + name + "`"))
            Group(grouped): return try self.check_expression(grouped, expected)
            TupleValue(elements):
                return try self.check_tuple(elements, value.span, expected)
            Unary(operator, operand): return try self.check_unary(operator, operand, value.span, expected)
            Binary(left, operator, right): return try self.check_binary(left, operator, right, value.span, expected)
            Conditional(selected, condition, alternative):
                let checked_condition = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
                let checked_value = try self.check_expression(selected, expected)
                let checked_alternative = try self.check_expression(alternative, self.type_of(checked_value))
                let typed = self.push_node(
                    HirNodeForm.Conditional(value = checked_value, condition = checked_condition, alternative = checked_alternative),
                    self.type_of(checked_value),
                    value.span,
                )
                return try self.require_type(typed, expected)
            Call(callee, type_arguments, arguments):
                return try self.check_call(callee, type_arguments, arguments, value.span, expected)
            ElseValue(optional_value, arm):
                return try self.check_else(optional_value, arm, value.span, expected)
            FormattedString(start, parts):
                error(self.diagnostic(value.span, "formatted strings are not implemented yet"))
            CaseValue(name, arguments):
                # `.case(...)`: the enum comes from context, looking through
                # an optional (`let s: Shape? = .dot`).
                let needed = expected else error(self.diagnostic(value.span, "`." + name + "` needs an enum type from context"))
                var target = needed
                let inner = self.optional_inner(needed)
                if inner != none and self.enum_of(inner) >= 0: target = inner
                let enum_index = self.enum_of(target)
                if enum_index < 0: try self.fail(value.span, "expected `" + self.describe_type(needed) + "`, found the case spelling `." + name + "`")
                let case_index = self.find_case(enum_index, name)
                if case_index < 0: try self.fail(value.span, "enum `" + self.enums[enum_index].name + "` has no case `" + name + "`")
                return try self.check_enum_value(enum_index, case_index, arguments, value.span, expected)
            ListValue(elements):
                error(self.diagnostic(value.span, "list literals are not implemented yet"))
            MapValue(entries):
                error(self.diagnostic(value.span, "map literals are not implemented yet"))
            Member(member_value, name):
                return try self.check_field_access(member_value, name, value.span, expected)
            Index(indexed, subscript):
                error(self.diagnostic(value.span, "indexing is not implemented yet"))
            Slice(sliced, start, operator, end):
                error(self.diagnostic(value.span, "slicing is not implemented yet"))
            Lambda(parameters, body):
                error(self.diagnostic(value.span, "lambdas are not implemented yet"))
            Closure(captures, parameters, result, body):
                error(self.diagnostic(value.span, "closures are not implemented yet"))
            MatchValue(subject, arms):
                return try self.check_match_value(subject, arms, value.span, expected)
            NewValue(value_type, arguments):
                error(self.diagnostic(value.span, "`new` is not implemented yet"))
            SpawnValue(function, arguments):
                error(self.diagnostic(value.span, "`spawn` is not implemented yet"))
            CatchValue(caught, failure_name, body):
                error(self.diagnostic(value.span, "`catch` is not implemented yet"))

    # A bare literal becomes a constant. An unsuffixed integer is i64 unless
    # the context asks for another integer width, e.g. `let count: i32 = 7`.
    func check_literal(token: Token, expected: TypeId?) -> NodeId!:
        var value_type = resolve_builtin_type(BuiltinType.unit)
        var value = Value.Unit
        if token.kind == TokenKind.int_lit:
            let integer_type = try self.integer_literal_type(token, expected)
            let integer = try self.decode_integer(token)
            try self.require_integer_range(token.span, integer, integer_type)
            value_type = integer_type
            value = Value.Integer(value = integer)
        elif token.kind == TokenKind.float_lit:
            if token.suffix == "f32":
                value_type = resolve_builtin_type(BuiltinType.float32)
            elif token.suffix == "" or token.suffix == "f64":
                value_type = resolve_builtin_type(BuiltinType.float64)
            else:
                try self.fail(token.span, "float type `" + token.suffix + "` is not implemented yet")
            value = Value.Floating(value = try self.decode_float(token))
        elif token.text == "true" or token.text == "false":
            value_type = resolve_builtin_type(BuiltinType.boolean)
            value = Value.Boolean(value = token.text == "true")
        elif token.text == "none":
            let needed = expected else error(self.diagnostic(token.span, "`none` needs an optional type from context"))
            if self.optional_inner(needed) == none:
                try self.fail(token.span, "expected `" + self.describe_type(needed) + "`, found `none`")
            return self.push_node(HirNodeForm.NoneLiteral, needed, token.span)
        elif token.kind == TokenKind.char_lit:
            value_type = resolve_builtin_type(BuiltinType.character)
            value = Value.Character(value = try self.decode_character(token))
        elif token.kind == TokenKind.str_lit:
            value_type = resolve_builtin_type(BuiltinType.string)
            value = Value.Text(value = try self.decode_print_text(token))
        elif token.kind == TokenKind.byte_lit:
            value_type = resolve_builtin_type(BuiltinType.byte_string)
            value = Value.Bytes(value = try self.decode_bytes(token))
        else:
            error(self.diagnostic(token.span, "this literal is not implemented yet"))
        return try self.require_type(self.push_constant(value, value_type, token.span), expected)

    func integer_literal_type(token: Token, expected: TypeId?) -> TypeId!:
        if token.suffix != "":
            let suffix_type = builtin_type_id(token.suffix) else error(self.diagnostic(token.span, "integer type `" + token.suffix + "` is not implemented yet"))
            if not is_integer_type(self.types, suffix_type):
                try self.fail(token.span, "integer type `" + token.suffix + "` is not implemented yet")
            return suffix_type
        if expected != none and is_integer_type(self.types, expected): return expected
        return resolve_builtin_type(BuiltinType.signed_i64)

    func require_integer_range(span: SourceSpan, value: i64, value_type: TypeId) -> !:
        if value < integer_minimum(self.types, value_type) or value > integer_maximum(self.types, value_type):
            try self.fail(span, "integer literal is outside `" + self.describe_type(value_type) + "` range")

    func check_unary(operator: str, operand: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> NodeId!:
        if operator == "not":
            let boolean_type = resolve_builtin_type(BuiltinType.boolean)
            let checked = try self.check_expression(operand, boolean_type)
            let expression = self.push_node(HirNodeForm.Unary(operation = UnaryOperation.LogicalNot, operand = checked), boolean_type, span)
            return try self.require_type(expression, expected)
        if operator == "try": try self.fail(span, "fallible calls are not implemented yet")

        # `-9223372036854775808` must fold as one negative literal: its
        # magnitude does not fit positive i64, so negate-after-check would
        # reject the minimum. Other operands take the general path below.
        if operator == "-" and expected != none and is_unsigned_integer_type(self.types, expected):
            try self.fail(span, "`-` is invalid for `" + self.describe_type(expected) + "`")
        if operator == "-" and (expected == none or is_integer_type(self.types, expected)):
            let literal = find_literal_token(operand)
            if literal != none and literal.kind == TokenKind.int_lit:
                let integer_type = try self.integer_literal_type(literal, expected)
                if is_unsigned_integer_type(self.types, integer_type):
                    try self.fail(span, "`-` is invalid for `" + self.describe_type(integer_type) + "`")
                let integer = try self.decode_negative_integer(literal)
                try self.require_integer_range(literal.span, integer, integer_type)
                let value = Value.Integer(value = integer)
                return try self.require_type(self.push_constant(value, integer_type, span), expected)

        let checked = try self.check_expression(operand, expected)
        let checked_type = self.type_of(checked)
        var operation = UnaryOperation.NumericIdentity(operand_type = checked_type)
        if operator == "~":
            if not is_integer_type(self.types, checked_type):
                try self.fail(span, "`~` requires an integer, found `" + self.describe_type(checked_type) + "`")
            operation = UnaryOperation.IntegerBitwiseNot(operand_type = checked_type)
        elif operator == "+" or operator == "-":
            if not is_numeric_type(self.types, checked_type):
                try self.fail(span, "`" + operator + "` requires a number, found `" + self.describe_type(checked_type) + "`")
            if operator == "-" and is_unsigned_integer_type(self.types, checked_type):
                try self.fail(span, "`-` is invalid for `" + self.describe_type(checked_type) + "`")
            if operator == "-": operation = UnaryOperation.NumericNegate(operand_type = checked_type)
        else:
            error(self.diagnostic(span, "operator `" + operator + "` is not implemented yet"))
        let expression = self.push_node(HirNodeForm.Unary(operation = operation, operand = checked), checked_type, span)
        return try self.require_type(expression, expected)

    func check_binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> NodeId!:
        # An arithmetic result has its operands' type, so the expected type
        # reaches down into the operands; comparisons produce bool, so it
        # must not.
        var operand_context: TypeId? = none
        if is_arithmetic_operator(operator) and expected != none:
            operand_context = expected

        let operands = try self.check_binary_operands(left, right, operand_context)
        let resolved = try self.resolve_binary_operation(self.type_of(operands.left), operator, self.type_of(operands.right), span)
        let typed = self.push_node(HirNodeForm.Binary(left = operands.left, operation = resolved.operation, right = operands.right), resolved.result, span)
        return try self.require_type(typed, expected)

    # Give an unsuffixed integer literal context from either neighbor. For
    # `5 * count`, the informative right side is checked first, but the returned
    # HIR operands remain in source order and therefore execute left-to-right.
    func check_binary_operands(left: ExpressionSyntax, right: ExpressionSyntax, context: TypeId?) -> CheckedBinaryOperands!:
        if context == none and is_contextual_integer_expression(left) and not is_contextual_integer_expression(right):
            let checked_right = try self.check_expression(right, none)
            let checked_left = try self.check_expression(left, self.type_of(checked_right))
            return CheckedBinaryOperands(left = checked_left, right = checked_right)

        let checked_left = try self.check_expression(left, context)
        let checked_right = try self.check_expression(right, self.type_of(checked_left))
        return CheckedBinaryOperands(left = checked_left, right = checked_right)

    # The operator table: what each binary operator accepts and what it
    # produces. Both sides must already have the same type; there are no
    # implicit conversions anywhere in the language.
    func resolve_binary_operation(left: TypeId, operator: str, right: TypeId, span: SourceSpan) -> ResolvedBinary!:
        if not types_match(left, right):
            try self.fail(span, "`" + operator + "` has `" + self.describe_type(left) + "` on the left and `" + self.describe_type(right) + "` on the right")
        let boolean_type = resolve_builtin_type(BuiltinType.boolean)
        if operator == "and" or operator == "or":
            if not types_match(left, boolean_type): try self.fail(span, "`" + operator + "` requires `bool` operands")
            if operator == "and": return ResolvedBinary(operation = BinaryOperation.LogicalAnd, result = boolean_type)
            return ResolvedBinary(operation = BinaryOperation.LogicalOr, result = boolean_type)
        if operator == "==": return ResolvedBinary(operation = BinaryOperation.Equal(operand_type = left), result = boolean_type)
        if operator == "!=": return ResolvedBinary(operation = BinaryOperation.NotEqual(operand_type = left), result = boolean_type)
        if operator == "<" or operator == "<=" or operator == ">" or operator == ">=":
            if not is_ordered_type(self.types, left): try self.fail(span, "`" + operator + "` does not order `" + self.describe_type(left) + "`")
            if operator == "<": return ResolvedBinary(operation = BinaryOperation.Less(operand_type = left), result = boolean_type)
            if operator == "<=": return ResolvedBinary(operation = BinaryOperation.LessEqual(operand_type = left), result = boolean_type)
            if operator == ">": return ResolvedBinary(operation = BinaryOperation.Greater(operand_type = left), result = boolean_type)
            return ResolvedBinary(operation = BinaryOperation.GreaterEqual(operand_type = left), result = boolean_type)
        if operator == "/":
            if not is_floating_type(self.types, left): try self.fail(span, "`/` requires floating-point operands")
            return ResolvedBinary(operation = BinaryOperation.Divide(operand_type = left), result = left)
        if operator == "//" or operator == "%":
            if not is_integer_type(self.types, left): try self.fail(span, "`" + operator + "` requires integer operands")
            if operator == "//": return ResolvedBinary(operation = BinaryOperation.FloorDivide(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.Remainder(operand_type = left), result = left)
        if operator == "+" or operator == "-" or operator == "*":
            if not is_numeric_type(self.types, left): try self.fail(span, "`" + operator + "` requires numeric operands")
            if operator == "+": return ResolvedBinary(operation = BinaryOperation.Add(operand_type = left), result = left)
            if operator == "-": return ResolvedBinary(operation = BinaryOperation.Subtract(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.Multiply(operand_type = left), result = left)
        if operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>":
            if not is_integer_type(self.types, left): try self.fail(span, "`" + operator + "` requires integer operands")
            if operator == "&": return ResolvedBinary(operation = BinaryOperation.BitwiseAnd(operand_type = left), result = left)
            if operator == "|": return ResolvedBinary(operation = BinaryOperation.BitwiseOr(operand_type = left), result = left)
            if operator == "^": return ResolvedBinary(operation = BinaryOperation.BitwiseXor(operand_type = left), result = left)
            if operator == "<<": return ResolvedBinary(operation = BinaryOperation.ShiftLeft(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.ShiftRight(operand_type = left), result = left)
        error(self.diagnostic(span, "operator `" + operator + "` is not implemented yet"))

    # Check one call: each parameter must be supplied once.
    func check_call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        if len(type_arguments) > 0: try self.fail(span, "generic calls are not implemented yet")
        let resolved = try self.resolve_callee(callee)
        if resolved.struct_index >= 0:
            return try self.check_struct_value(resolved.struct_index, arguments, span, expected)
        if resolved.enum_index >= 0:
            return try self.check_enum_value(resolved.enum_index, resolved.case_index, arguments, span, expected)
        let function = self.functions[resolved.function_index]

        # Positional arguments fill parameters left to right; named arguments
        # then land anywhere, but each parameter is supplied once. A method
        # call's receiver is argument 0, and must be a mutable place when the
        # method is `mutating`.
        let assigned = list[bool]()
        for parameter in function.parameters: assigned.append(false)
        # Pairs of (parameter index, argument node), in source order.
        let typed_arguments = list[u32]()
        var positional_index = 0
        var saw_named = false
        let receiver_value = resolved.receiver
        if receiver_value.value != no_node:
            let method = function.receiver else trap("a receiver was resolved for a function without one")
            if method.is_mutating: try self.require_mutable_place(receiver_value, callee.span)
            typed_arguments.append(0)
            typed_arguments.append(receiver_value.value)
            assigned[0] = true
            positional_index = 1

        for argument in arguments:
            var parameter_index = -1
            let label = argument.label
            if label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                parameter_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                parameter_index = find_parameter(function, label)
                if parameter_index < 0: try self.fail(argument.span, "function `" + function.name + "` has no parameter `" + label + "`")
            if parameter_index >= len(function.parameters):
                try self.fail(argument.span, "function `" + function.name + "` accepts " + str(len(function.parameters)) + " argument(s)")
            if assigned[parameter_index]:
                try self.fail(argument.span, "parameter `" + function.parameters[parameter_index].name + "` is supplied more than once")
            assigned[parameter_index] = true
            let checked = try self.check_expression(argument.value, function.parameters[parameter_index].value_type)
            typed_arguments.append(u32(parameter_index))
            typed_arguments.append(checked.value)

        for parameter_index in range(0, len(function.parameters)):
            if assigned[parameter_index]: continue
            let default_value = function.parameters[parameter_index].default_value
            if default_value.value != no_node:
                typed_arguments.append(u32(parameter_index))
                typed_arguments.append(default_value.value)
                continue
            try self.fail(span, "call to `" + function.name + "` is missing argument `" + function.parameters[parameter_index].name + "`")
        let typed = self.push_node(HirNodeForm.Call(function = function.symbol, arguments = self.push_run(typed_arguments)), function.result, span)
        return try self.require_type(typed, expected)

    # `Point(x: 1.0, y: 2.0)`: the synthesized memberwise initializer. Fields
    # fill like parameters and defaults cover omissions. From another module
    # the struct and every field *given* must be public; a private field may
    # still be omitted when it has a default.
    func check_struct_value(struct_index: i64, arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        let item = self.structs[struct_index]
        let foreign = item.module_index != self.current_module
        if foreign and not item.is_public:
            try self.fail(span, "`" + item.name + "` is private to module `" + self.sources[item.module_index].name + "`")
        # Given values by field position; `supplied` says which are real.
        let values = list[NodeId]()
        let supplied = list[bool]()
        for field in item.fields:
            values.append(NodeId(value = no_node))
            supplied.append(false)
        var positional_index = 0
        var saw_named = false
        for argument in arguments:
            var field_index = -1
            let label = argument.label
            if label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                field_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                field_index = self.find_field(struct_index, label)
                if field_index < 0: try self.fail(argument.span, "struct `" + item.name + "` has no field `" + label + "`")
            if field_index >= len(item.fields):
                try self.fail(argument.span, "struct `" + item.name + "` has " + str(len(item.fields)) + " field(s)")
            let field = item.fields[field_index]
            if supplied[field_index]:
                try self.fail(argument.span, "field `" + field.name + "` is supplied more than once")
            if foreign and not field.is_public:
                try self.fail(argument.span, "field `" + field.name + "` is private to module `" + self.sources[item.module_index].name + "`")
            values[field_index] = try self.check_expression(argument.value, field.value_type)
            supplied[field_index] = true
        let fields = list[NodeId]()
        for field_index in range(0, len(item.fields)):
            let field = item.fields[field_index]
            if supplied[field_index]:
                fields.append(values[field_index])
                continue
            # A private field with a default is not *required*, so it does
            # not make the initializer private (spec §10.1).
            if field.default_value.value == no_node:
                try self.fail(span, "construction of `" + item.name + "` is missing field `" + field.name + "`")
            fields.append(field.default_value)
        let typed = self.push_node(HirNodeForm.StructValue(struct_index = struct_index, fields = self.push_nodes(fields)), item.type_id, span)
        return try self.require_type(typed, expected)

    # `value.field`: the value must be a struct with that field, visible here.
    func check_field_access(member_value: ExpressionSyntax, name: str, span: SourceSpan, expected: TypeId?) -> NodeId!:
        var root_name = ""
        var module_name = ""
        var type_name = ""
        match member_value.form:
            Name(candidate): root_name = candidate
            Member(inner, inner_name):
                match inner.form:
                    Name(candidate):
                        module_name = candidate
                        type_name = inner_name
                    else: module_name = ""
            else: root_name = ""
        # `module.Enum.case`
        if module_name != "" and self.find_local(module_name) < 0:
            let imported_module = self.find_imported_module(module_name)
            if imported_module >= 0:
                let enum_index = self.find_enum_in_module(imported_module, type_name)
                if enum_index >= 0:
                    let case_index = self.find_case(enum_index, name)
                    if case_index < 0: try self.fail(span, "enum `" + type_name + "` has no case `" + name + "`")
                    return try self.check_enum_value(enum_index, case_index, list[ArgumentSyntax](), span, expected)
        if root_name != "" and self.find_local(root_name) < 0:
            if self.find_imported_module(root_name) >= 0:
                try self.fail(span, "module members other than functions are not implemented yet")
            if self.find_struct_in_module(self.current_module, root_name) >= 0:
                try self.fail(span, "`" + root_name + "." + name + "` is a type function; call it with `(...)`")
            let enum_index = self.find_enum_in_module(self.current_module, root_name)
            if enum_index >= 0:
                let case_index = self.find_case(enum_index, name)
                if case_index < 0:
                    if self.find_method(self.enums[enum_index].type_id, name) >= 0:
                        try self.fail(span, "`" + root_name + "." + name + "` is a type function; call it with `(...)`")
                    try self.fail(span, "enum `" + root_name + "` has no case `" + name + "`")
                return try self.check_enum_value(enum_index, case_index, list[ArgumentSyntax](), span, expected)
        let checked = try self.check_expression(member_value, none)
        let struct_index = self.struct_of(self.type_of(checked))
        if struct_index < 0:
            try self.fail(span, "`" + self.describe_type(self.type_of(checked)) + "` has no field `" + name + "`")
        let field_index = self.find_field(struct_index, name)
        if field_index < 0:
            if self.find_method(self.structs[struct_index].type_id, name) >= 0:
                try self.fail(span, "`" + name + "` is a method of `" + self.structs[struct_index].name + "`; call it with `(...)`")
            try self.fail(span, "struct `" + self.structs[struct_index].name + "` has no field `" + name + "`")
        let field = self.structs[struct_index].fields[field_index]
        if not field.is_public and self.structs[struct_index].module_index != self.current_module:
            try self.fail(span, "field `" + name + "` is private to module `" + self.sources[self.structs[struct_index].module_index].name + "`")
        let typed = self.push_node(HirNodeForm.FieldAccess(value = checked, field = field_index), field.value_type, span)
        return try self.require_type(typed, expected)

    # A mutating method needs somewhere to write: a `var` local, `self` in a
    # mutating method, or a `var` field reached through such a place.
    func require_mutable_place(value: NodeId, span: SourceSpan) -> !:
        match self.node_form(value):
            Reference(symbol):
                for local in self.locals:
                    if local.symbol.value == symbol.value:
                        if local.is_mutable: return
                        try self.fail(span, "mutating method needs a `var` receiver; `" + local.name + "` is immutable")
                try self.fail(span, "mutating method needs a `var` receiver")
            FieldAccess(inner, field):
                let struct_index = self.struct_of(self.type_of(inner))
                let stored = self.structs[struct_index].fields[field]
                if not stored.is_mutable:
                    try self.fail(span, "mutating method needs a `var` receiver; field `" + stored.name + "` is `let`")
                try self.require_mutable_place(inner, span)
            else: try self.fail(span, "mutating method needs a `var` receiver, not a temporary value")

    # Find which function a callee spelling names: a bare `helper(...)`, or a
    # qualified `module.helper(...)` through an imported module.
    # `helper(...)`, `module.helper(...)`, `Point(...)`, `Point.origin(...)`,
    # `module.Point(...)`, `module.Point.origin(...)`, or `value.method(...)`.
    func resolve_callee(callee: ExpressionSyntax) -> ResolvedCallee!:
        match callee.form:
            Name(name):
                let local_index = self.find_local(name)
                if local_index >= 0:
                    try self.fail(callee.span, "`" + name + "` has type `" + self.describe_type(self.locals[local_index].value_type) + "` and is not callable")
                let function_index = self.find_visible_function(name)
                if function_index >= 0: return ResolvedCallee(function_index = function_index, receiver = NodeId(value = no_node), struct_index = -1, enum_index = -1, case_index = -1)
                let struct_index = self.find_struct_in_module(self.current_module, name)
                if struct_index >= 0: return ResolvedCallee(function_index = -1, receiver = NodeId(value = no_node), struct_index = struct_index, enum_index = -1, case_index = -1)
                error(self.diagnostic(callee.span, "unknown function `" + name + "`"))
            Member(value, name):
                let named = try self.resolve_named_callee(value, name, callee.span)
                if named != none: return named
                let receiver = try self.check_expression(value, none)
                let owner = self.type_of(receiver)
                let struct_index = self.struct_of(owner)
                if struct_index < 0 and self.enum_of(owner) < 0:
                    try self.fail(callee.span, "`" + self.describe_type(owner) + "` has no method `" + name + "`")
                let method_index = self.find_method(owner, name)
                if method_index < 0:
                    if struct_index >= 0 and self.find_field(struct_index, name) >= 0:
                        try self.fail(callee.span, "`" + name + "` is a field of `" + self.describe_type(owner) + "`, not a method")
                    try self.fail(callee.span, "`" + self.describe_type(owner) + "` has no method `" + name + "`")
                let method = self.functions[method_index]
                let method_receiver = method.receiver else trap("method without a receiver")
                if not method_receiver.has_self:
                    try self.fail(callee.span, "`" + name + "` is a type function; call it as `" + self.describe_type(owner) + "." + name + "(...)`")
                try self.require_method_visible(method_index, owner, callee.span)
                return ResolvedCallee(function_index = method_index, receiver = receiver, struct_index = -1, enum_index = -1, case_index = -1)
            else:
                error(self.diagnostic(callee.span, "only named functions are callable in the current semantic slice"))

    # The spellings whose head is a module or type name rather than a value:
    # `module.f`, `module.Type`, `Type.f`, `module.Type.f`. Absent when the
    # head is a value, so the caller treats the call as a method call.
    func resolve_named_callee(value: ExpressionSyntax, name: str, span: SourceSpan) -> ResolvedCallee?!:
        var head = ""
        var type_name = ""
        var is_two_level = false
        match value.form:
            Name(candidate): head = candidate
            Member(inner, inner_name):
                match inner.form:
                    Name(module_name):
                        head = module_name
                        type_name = inner_name
                        is_two_level = true
                    else: head = ""
            else: head = ""
        if head == "" or self.find_local(head) >= 0: return none
        if not is_two_level:
            let imported_module = self.find_imported_module(head)
            if imported_module >= 0: return try self.resolve_module_member_callee(imported_module, name, span)
            let struct_index = self.find_struct_in_module(self.current_module, head)
            if struct_index >= 0: return try self.resolve_type_function(self.structs[struct_index].type_id, name, span)
            let enum_index = self.find_enum_in_module(self.current_module, head)
            if enum_index >= 0: return try self.resolve_enum_member(enum_index, name, span)
            return none
        let imported_module = self.find_imported_module(head)
        if imported_module < 0: return none
        let struct_index = self.find_struct_in_module(imported_module, type_name)
        if struct_index >= 0:
            if not self.structs[struct_index].is_public:
                try self.fail(span, "`" + type_name + "` is private to module `" + self.sources[imported_module].name + "`")
            return try self.resolve_type_function(self.structs[struct_index].type_id, name, span)
        let enum_index = self.find_enum_in_module(imported_module, type_name)
        if enum_index < 0: return none
        if not self.enums[enum_index].is_public:
            try self.fail(span, "`" + type_name + "` is private to module `" + self.sources[imported_module].name + "`")
        return try self.resolve_enum_member(enum_index, name, span)

    # `Enum.case(...)` constructs; `Enum.function(...)` calls a type function.
    func resolve_enum_member(enum_index: i64, name: str, span: SourceSpan) -> ResolvedCallee!:
        let case_index = self.find_case(enum_index, name)
        if case_index >= 0: return ResolvedCallee(function_index = -1, receiver = NodeId(value = no_node), struct_index = -1, enum_index = enum_index, case_index = case_index)
        return try self.resolve_type_function(self.enums[enum_index].type_id, name, span)

    func resolve_module_member_callee(imported_module: i64, name: str, span: SourceSpan) -> ResolvedCallee!:
        let function_index = self.find_function_in_module(imported_module, name)
        if function_index >= 0:
            if not self.functions[function_index].is_public:
                try self.fail(span, "`" + name + "` is private to module `" + self.sources[imported_module].name + "`")
            return ResolvedCallee(function_index = function_index, receiver = NodeId(value = no_node), struct_index = -1, enum_index = -1, case_index = -1)
        let struct_index = self.find_struct_in_module(imported_module, name)
        if struct_index >= 0:
            if not self.structs[struct_index].is_public:
                try self.fail(span, "`" + name + "` is private to module `" + self.sources[imported_module].name + "`")
            return ResolvedCallee(function_index = -1, receiver = NodeId(value = no_node), struct_index = struct_index, enum_index = -1, case_index = -1)
        error(self.diagnostic(span, "module `" + self.sources[imported_module].name + "` has no function `" + name + "`"))

    # `Type.function(...)`: a method without `self`.
    func resolve_type_function(owner: TypeId, name: str, span: SourceSpan) -> ResolvedCallee!:
        let method_index = self.find_method(owner, name)
        if method_index < 0:
            try self.fail(span, "`" + self.describe_type(owner) + "` has no type function `" + name + "`")
        let receiver = self.functions[method_index].receiver else trap("method without a receiver")
        if receiver.has_self:
            try self.fail(span, "`" + name + "` takes `self`; call it through a `" + self.describe_type(owner) + "` value")
        try self.require_method_visible(method_index, owner, span)
        return ResolvedCallee(function_index = method_index, receiver = NodeId(value = no_node), struct_index = -1, enum_index = -1, case_index = -1)

    func require_method_visible(method_index: i64, owner: TypeId, span: SourceSpan) -> !:
        let owner_module = self.owner_module(owner)
        if owner_module != self.current_module and not self.functions[method_index].is_public:
            try self.fail(span, "`" + self.functions[method_index].name + "` is private to module `" + self.sources[owner_module].name + "`")

    func check_tuple(elements: list[ExpressionSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        var expected_parts: list[TypeId]? = none
        if expected != none:
            expected_parts = self.tuple_elements(expected)
            if expected_parts != none and len(expected_parts) != len(elements):
                try self.fail(span, "tuple has " + str(len(elements)) + " element(s), expected `" + self.describe_type(expected) + "`")
        let checked = list[NodeId]()
        var index = 0
        for element in elements:
            var part_expected: TypeId? = none
            if expected_parts != none:
                part_expected = expected_parts[index]
            checked.append(try self.check_expression(element, part_expected))
            index += 1
        let parts = list[TypeId]()
        for item in checked:
            parts.append(self.type_of(item))
        let tuple_type = self.intern_tuple(parts)
        return try self.require_type(self.push_node(HirNodeForm.Tuple(elements = self.push_nodes(checked)), tuple_type, span), expected)

    func check_else(optional_value: ExpressionSyntax, arm: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> NodeId!:
        let checked_optional = try self.check_expression(optional_value, none)
        let inner = self.optional_inner(self.type_of(checked_optional)) else error(self.diagnostic(span, "`else` requires an optional value, found `" + self.describe_type(self.type_of(checked_optional)) + "`"))
        let checked_arm = try self.check_expression(arm, inner)
        let typed = self.push_node(HirNodeForm.ElseFallback(value = checked_optional, arm = checked_arm), inner, span)
        return try self.require_type(typed, expected)

    # mark: Literal decoding ====================================================================
    #
    # The tokenizer keeps every literal's exact source spelling; here that
    # spelling becomes a value, with range failures reported at the token.

    func decode_integer(token: Token) -> i64!:
        let value = try self.decode_negative_integer(token)
        if value == -9223372036854775807 - 1:
            try self.fail(token.span, "integer literal is outside the representable integer range")
        return -value

    # Accumulating below zero leaves room for the minimum signed magnitude,
    # which positive i64 cannot represent.
    func decode_negative_integer(token: Token) -> i64!:
        let text_end = len(token.text) - len(token.suffix)
        var base = 10
        var position = 0
        if text_end >= 2 and token.text[0] == '0':
            match token.text[1]:
                'b', 'B': base = 2
                'o', 'O': base = 8
                'x', 'X': base = 16
                else: base = 10
            if base != 10: position = 2

        var value = 0
        while position < text_end:
            let c = token.text[position]
            if c != '_':
                let digit = decode_digit(c)
                let minimum = -9223372036854775807 - 1
                let numerator = minimum + digit
                var threshold = numerator // base
                if numerator % base != 0: threshold += 1
                if value < threshold:
                    try self.fail(token.span, "integer literal is outside the representable integer range")
                value = value * base - digit
            position += 1
        return value

    func decode_float(token: Token) -> f64!:
        let text_end = len(token.text) - len(token.suffix)
        var text = ""
        var position = 0
        while position < text_end:
            if token.text[position] != '_': text = text + str(token.text[position])
            position += 1
        return parse_f64(text) else error(self.diagnostic(token.span, "floating-point literal is outside `f64` range"))

    func decode_character(token: Token) -> char!:
        if len(token.text) < 3 or token.text[0] != '\'':
            try self.fail(token.span, "malformed character literal")
        if token.text[1] != '\\':
            if len(token.text) != 3: try self.fail(token.span, "character literal must contain one character")
            return token.text[1]
        if len(token.text) < 4: try self.fail(token.span, "incomplete character escape")
        match token.text[2]:
            'n': return '\n'
            'r': return '\r'
            't': return '\t'
            '\\': return '\\'
            '\'': return '\''
            '0': return char(0)
            else: error(self.diagnostic(token.span, "this character escape is not implemented yet"))

    func decode_bytes(token: Token) -> list[u8]!:
        if len(token.text) < 3 or token.text[0] != 'b':
            try self.fail(token.span, "malformed byte literal")
        let inner = Token(kind = TokenKind.str_lit, text = token.text[1:], suffix = "", span = token.span)
        let decoded = try self.decode_print_text(inner)
        let payload = list[u8]()
        for c in decoded:
            payload.append(u8(u32(c)))
        return payload

    # mark: Name lookup =========================================================================

    # A new local may not reuse a live name or hide an import.
    func require_free_local_name(name: str, span: SourceSpan) -> !:
        if self.find_local(name) >= 0:
            try self.fail(span, "`" + name + "` is already bound in this scope")
        if self.find_imported_function(name) >= 0 or self.find_imported_module(name) >= 0:
            try self.fail(span, "local `" + name + "` cannot shadow an imported name")

    # Innermost binding first, so a suite's binding wins over an outer one.
    func find_local(name: str) -> i64:
        var index = len(self.locals) - 1
        while index >= 0:
            if self.locals[index].name == name: return index
            index -= 1
        return -1

    # A bare name resolves to a selectively imported function first, then to a
    # declaration in the current module.
    func find_visible_function(name: str) -> i64:
        let imported = self.find_imported_function(name)
        if imported >= 0: return imported
        return self.find_function_in_module(self.current_module, name)

    func find_imported_function(name: str) -> i64:
        for imported in self.bindings.functions:
            if imported.name == name: return imported.function_index
        return -1

    func find_imported_module(name: str) -> i64:
        for imported in self.bindings.modules:
            if imported.name == name: return imported.module_index
        return -1

    # The same lookup for a module other than the one being checked. While
    # signatures are collected the import bindings do not exist yet, so a
    # whole-module import (`import math`, `import math as m`) is read from the
    # import syntax directly; that is all a type name in a signature can use.
    func find_imported_module_of(module_index: i64, name: str) -> i64:
        if module_index < len(self.module_bindings):
            for imported in self.module_bindings[module_index].modules:
                if imported.name == name: return imported.module_index
            return -1
        for imported in self.sources[module_index].syntax.imports:
            if len(imported.names) > 0: continue
            let local_name = imported.alias_name else imported.path.last()
            if local_name == name: return self.find_source(imported.path.dotted())
        return -1

    # Free functions only; methods are reached through `find_method`.
    func find_function_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.functions)):
            if self.functions[index].receiver != none: continue
            if self.functions[index].module_index == module_index and self.functions[index].name == name: return index
        return -1

    func find_alias_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.aliases)):
            if self.aliases[index].module_index == module_index and self.aliases[index].name == name: return index
        return -1

    func find_constant_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.constants)):
            if self.constants[index].module_index == module_index and self.constants[index].name == name: return index
        return -1

    # Intern by `TypeForm`. The diagnostic `name` is stored for messages; two
    # forms that describe the same structure share one TypeId.
    func intern_named(name: str, form: TypeForm) -> TypeId:
        for existing in self.types.definitions:
            if type_forms_match(existing.form, form): return existing.id
        let id = TypeId(value = u32(len(self.types.definitions)))
        self.types.definitions.append(TypeDefinition(id = id, name = name, form = form))
        return id

    func intern_optional(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "?", TypeForm.Optional(value = inner))

    func intern_fallible(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "!", TypeForm.Fallible(value = inner))

    func intern_slice(inner: TypeId) -> TypeId:
        return self.intern_named("slice[" + self.describe_type(inner) + "]", TypeForm.Slice(element = inner))

    func intern_tuple(elements: list[TypeId]) -> TypeId:
        var name = "("
        var index = 0
        for element in elements:
            if index > 0: name = name + ", "
            name = name + self.describe_type(element)
            index += 1
        return self.intern_named(name + ")", TypeForm.Tuple(elements = elements))

    func intern_function_type(parameters: list[TypeId], result: TypeId) -> TypeId:
        var name = "func("
        var index = 0
        for parameter in parameters:
            if index > 0: name = name + ", "
            name = name + self.describe_type(parameter)
            index += 1
        return self.intern_named(name + ") -> " + self.describe_type(result), TypeForm.Function(parameters = parameters, result = result))

    func optional_inner(value: TypeId) -> TypeId?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[i64(value.value)].form:
            Optional(inner): return inner
            else: return none

    func tuple_elements(value: TypeId) -> list[TypeId]?:
        if i64(value.value) >= len(self.types.definitions): return none
        match self.types.definitions[i64(value.value)].form:
            Tuple(elements): return elements
            else: return none

    func find_source(name: str) -> i64:
        for index in range(0, len(self.sources)):
            if self.sources[index].name == name: return index
        return -1

    # Allocate one program-wide identity and record the declaration metadata
    # that diagnostics, tooling, and later analysis can query by that identity.
    func make_symbol(name: str, kind: SymbolKind, value_type: TypeId) -> SymbolId:
        let symbol = SymbolId(value = u32(self.next_symbol))
        self.next_symbol += 1
        self.symbols.append(HirSymbol(id = symbol, name = name, kind = kind, value_type = value_type))
        return symbol

    # mark: Diagnostics =========================================================================

    # `Command.open(path: "x")`, `.open("x")`, or `Direction.north`: every
    # payload field is required, positional or named. From another module the
    # enum must be public.
    func check_enum_value(enum_index: i64, case_index: i64, arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        let item = self.enums[enum_index]
        if item.module_index != self.current_module and not item.is_public:
            try self.fail(span, "`" + item.name + "` is private to module `" + self.sources[item.module_index].name + "`")
        let case_value = item.cases[case_index]
        let values = list[NodeId]()
        let supplied = list[bool]()
        for field in case_value.payload:
            values.append(NodeId(value = no_node))
            supplied.append(false)
        var positional_index = 0
        var saw_named = false
        for argument in arguments:
            var field_index = -1
            let label = argument.label
            if label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                field_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                for index in range(0, len(case_value.payload)):
                    if case_value.payload[index].name == label: field_index = index
                if field_index < 0: try self.fail(argument.span, "case `" + case_value.name + "` has no payload field `" + label + "`")
            if field_index >= len(case_value.payload):
                try self.fail(argument.span, "case `" + case_value.name + "` carries " + str(len(case_value.payload)) + " value(s)")
            if supplied[field_index]:
                try self.fail(argument.span, "payload field `" + case_value.payload[field_index].name + "` is supplied more than once")
            values[field_index] = try self.check_expression(argument.value, case_value.payload[field_index].value_type)
            supplied[field_index] = true
        for index in range(0, len(case_value.payload)):
            if not supplied[index]: try self.fail(span, "case `" + case_value.name + "` is missing payload field `" + case_value.payload[index].name + "`")
        let typed = self.push_node(HirNodeForm.EnumValue(enum_index = enum_index, case_index = case_index, payload = self.push_nodes(values)), item.type_id, span)
        return try self.require_type(typed, expected)

    # mark: Match ===============================================================================

    func check_match_statement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax], span: SourceSpan) -> NodeId!:
        let checked_subject = try self.check_expression(subject, none)
        let subject_type = self.type_of(checked_subject)
        let coverage = MatchCoverage()
        let arm_nodes = list[NodeId]()
        for arm in arms:
            let outer_count = len(self.locals)
            let bindings = list[ArmBinding]()
            let patterns = try self.check_patterns(arm.patterns, subject_type, coverage, bindings, arm.span)
            let statements = list[NodeId]()
            for statement in arm.body.statements:
                for item in try self.check_statement(statement): statements.append(item)
            while len(self.locals) > outer_count: self.locals.remove(len(self.locals) - 1)
            arm_nodes.append(self.push_statement(HirNodeForm.MatchArm(patterns = patterns, statements = self.push_nodes(statements), value = NodeId(value = no_node)), arm.span))
        try self.require_exhaustive(subject_type, coverage, span)
        return self.push_statement(HirNodeForm.Match(subject = checked_subject, arms = self.push_nodes(arm_nodes), has_result = false), span)

    # The expression form: every arm yields a value of one type, taken from
    # the context or from the first arm.
    func check_match_value(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax], span: SourceSpan, expected: TypeId?) -> NodeId!:
        let checked_subject = try self.check_expression(subject, none)
        let subject_type = self.type_of(checked_subject)
        let coverage = MatchCoverage()
        let arm_nodes = list[NodeId]()
        var result_type: TypeId? = expected
        for arm in arms:
            let outer_count = len(self.locals)
            let bindings = list[ArmBinding]()
            let patterns = try self.check_patterns(arm.patterns, subject_type, coverage, bindings, arm.span)
            let value = try self.check_expression(arm.value, result_type)
            if result_type == none: result_type = self.type_of(value)
            while len(self.locals) > outer_count: self.locals.remove(len(self.locals) - 1)
            arm_nodes.append(self.push_statement(HirNodeForm.MatchArm(patterns = patterns, statements = Operands(start = 0, count = 0), value = value), arm.span))
        try self.require_exhaustive(subject_type, coverage, span)
        let settled = result_type else error(self.diagnostic(span, "`match` needs at least one arm"))
        let typed = self.push_node(HirNodeForm.Match(subject = checked_subject, arms = self.push_nodes(arm_nodes), has_result = true), settled, span)
        return try self.require_type(typed, expected)

    # Check one arm's alternatives against the subject type, recording what
    # they cover and declaring the arm's bindings as locals. Every alternative
    # must bind the same names with the same types (spec §9.6), so they share
    # symbols.
    func check_patterns(patterns: list[PatternSyntax], subject_type: TypeId, coverage: MatchCoverage, bindings: list[ArmBinding], span: SourceSpan) -> Operands!:
        if coverage.saw_wildcard: try self.fail(span, "this arm is unreachable; an earlier `_` matches everything")
        let nodes = list[NodeId]()
        var alternative = 0
        for pattern in patterns:
            let is_first = alternative == 0
            let bound = list[str]()
            match pattern:
                Wildcard(pattern_span):
                    if len(patterns) > 1: try self.fail(pattern_span, "`_` cannot share an arm with other patterns")
                    coverage.saw_wildcard = true
                    nodes.append(self.push_node(HirNodeForm.PatternWildcard, subject_type, pattern_span))
                Literal(literal):
                    let value = try self.check_pattern_literal(literal, subject_type)
                    for previous in coverage.literals:
                        if values_equal(previous, self.values[i64(value)]): try self.fail(literal.span, "duplicate pattern")
                    for index in range(0, len(coverage.ranges) // 2):
                        if value_in_range(self.values[i64(value)], coverage.ranges[index * 2], coverage.ranges[index * 2 + 1]):
                            try self.fail(literal.span, "pattern is already covered by an earlier range")
                    coverage.literals.append(self.values[i64(value)])
                    nodes.append(self.push_node(HirNodeForm.PatternLiteral(value = value), subject_type, literal.span))
                RangePattern(lower, operator, upper, pattern_span):
                    if not is_integer_type(self.types, subject_type) and not types_match(subject_type, resolve_builtin_type(BuiltinType.character)):
                        try self.fail(pattern_span, "range patterns need an integer or `char` subject, found `" + self.describe_type(subject_type) + "`")
                    let low = try self.check_pattern_literal(lower, subject_type)
                    let high = try self.check_pattern_literal(upper, subject_type)
                    let inclusive = operator == "..="
                    let low_value = self.values[i64(low)]
                    var high_value = self.values[i64(high)]
                    if not value_less_or_equal(low_value, high_value) or (not inclusive and values_equal(low_value, high_value)):
                        try self.fail(pattern_span, "range pattern needs its lower bound below its upper bound")
                    # Coverage stores every range as an inclusive pair.
                    if not inclusive: high_value = predecessor(high_value)
                    for previous in coverage.literals:
                        if value_in_range(previous, low_value, high_value): try self.fail(pattern_span, "range overlaps an earlier pattern")
                    for index in range(0, len(coverage.ranges) // 2):
                        if ranges_overlap(low_value, high_value, coverage.ranges[index * 2], coverage.ranges[index * 2 + 1]):
                            try self.fail(pattern_span, "range overlaps an earlier pattern")
                    coverage.ranges.append(low_value)
                    coverage.ranges.append(high_value)
                    nodes.append(self.push_node(HirNodeForm.PatternRange(lower = low, upper = high, inclusive = inclusive), subject_type, pattern_span))
                CasePattern(name, names, pattern_span):
                    let case_index = try self.resolve_case_pattern(name, subject_type, pattern_span)
                    for previous in coverage.cases:
                        if previous == case_index: try self.fail(pattern_span, "duplicate case pattern `." + name + "`")
                    coverage.cases.append(case_index)
                    let payload_types = self.case_payload_types(subject_type, case_index)
                    if len(names) != len(payload_types):
                        try self.fail(pattern_span, "`." + name + "` carries " + str(len(payload_types)) + " value(s), the pattern binds " + str(len(names)))
                    let symbols = list[u32]()
                    for index in range(0, len(names)):
                        let symbol = try self.bind_pattern_name(names[index], payload_types[index], is_first, bindings, bound, pattern_span)
                        symbols.append(symbol.value)
                    nodes.append(self.push_node(HirNodeForm.PatternCase(case_index = case_index, bindings = self.push_run(symbols)), subject_type, pattern_span))
            if not is_first and len(bound) != len(bindings):
                try self.fail(span, "every alternative of an arm must bind the same names")
            alternative += 1
        return self.push_nodes(nodes)

    # The first alternative declares a binding; later ones must repeat it.
    func bind_pattern_name(name: str, value_type: TypeId, is_first: bool, bindings: list[ArmBinding], bound: list[str], span: SourceSpan) -> SymbolId!:
        for previous in bound:
            if previous == name: try self.fail(span, "`" + name + "` is bound twice in one pattern")
        bound.append(name)
        if is_first:
            try self.require_free_local_name(name, span)
            let symbol = self.make_symbol(name, SymbolKind.local, value_type)
            self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = value_type, is_mutable = false))
            bindings.append(ArmBinding(name = name, symbol = symbol, value_type = value_type))
            return symbol
        for binding in bindings:
            if binding.name == name:
                if not types_match(binding.value_type, value_type):
                    try self.fail(span, "`" + name + "` has type `" + self.describe_type(value_type) + "` here and `" + self.describe_type(binding.value_type) + "` in an earlier alternative")
                return binding.symbol
        error(self.diagnostic(span, "every alternative of an arm must bind the same names; `" + name + "` is new here"))

    # `.name` against an enum names a case; against an optional, `.none` is
    # case 0 and `.some` case 1.
    func resolve_case_pattern(name: str, subject_type: TypeId, span: SourceSpan) -> i64!:
        let enum_index = self.enum_of(subject_type)
        if enum_index >= 0:
            let case_index = self.find_case(enum_index, name)
            if case_index < 0: try self.fail(span, "enum `" + self.enums[enum_index].name + "` has no case `" + name + "`")
            return case_index
        if self.optional_inner(subject_type) != none:
            if name == "none": return 0
            if name == "some": return 1
            try self.fail(span, "an optional matches `.none` or `.some(value)`, not `." + name + "`")
        error(self.diagnostic(span, "case patterns need an enum or optional subject, found `" + self.describe_type(subject_type) + "`"))

    func case_payload_types(subject_type: TypeId, case_index: i64) -> list[TypeId]:
        let enum_index = self.enum_of(subject_type)
        if enum_index >= 0:
            let payload_types = list[TypeId]()
            for field in self.enums[enum_index].cases[case_index].payload: payload_types.append(field.value_type)
            return payload_types
        let inner = self.optional_inner(subject_type) else trap("case payload of a non-enum, non-optional subject")
        if case_index == 1: return [inner]
        return list[TypeId]()

    # A literal pattern: the subject's type is the context, a leading `-`
    # folds into an integer literal exactly as in an expression.
    func check_pattern_literal(literal: PatternLiteralSyntax, subject_type: TypeId) -> u32!:
        if self.optional_inner(subject_type) != none or self.enum_of(subject_type) >= 0:
            try self.fail(literal.span, "literal patterns need a scalar or string subject, found `" + self.describe_type(subject_type) + "`")
        var node = NodeId(value = no_node)
        if literal.is_negative:
            if literal.token.kind != TokenKind.int_lit: try self.fail(literal.span, "`-` in a pattern needs an integer literal")
            let integer_type = try self.integer_literal_type(literal.token, subject_type)
            if is_unsigned_integer_type(self.types, integer_type): try self.fail(literal.span, "`-` is invalid for `" + self.describe_type(integer_type) + "`")
            let integer = try self.decode_negative_integer(literal.token)
            try self.require_integer_range(literal.span, integer, integer_type)
            node = try self.require_type(self.push_constant(Value.Integer(value = integer), integer_type, literal.span), subject_type)
        else:
            node = try self.check_literal(literal.token, subject_type)
        match self.node_form(node):
            Constant(value): return value
            else: error(self.diagnostic(literal.span, "pattern must be a literal of `" + self.describe_type(subject_type) + "`"))

    # Every `match` is exhaustive: enums, optionals, and bools by their cases,
    # anything else by a `_` arm.
    func require_exhaustive(subject_type: TypeId, coverage: MatchCoverage, span: SourceSpan) -> !:
        if coverage.saw_wildcard: return
        let enum_index = self.enum_of(subject_type)
        if enum_index >= 0:
            let missing = list[str]()
            for index in range(0, len(self.enums[enum_index].cases)):
                var covered = false
                for case_index in coverage.cases:
                    if case_index == index: covered = true
                if not covered: missing.append("." + self.enums[enum_index].cases[index].name)
            if len(missing) > 0: try self.fail(span, "`match` does not cover " + join_names(missing))
            return
        if self.optional_inner(subject_type) != none:
            var has_none = false
            var has_some = false
            for case_index in coverage.cases:
                if case_index == 0: has_none = true
                if case_index == 1: has_some = true
            if not has_none: try self.fail(span, "`match` does not cover `.none`")
            if not has_some: try self.fail(span, "`match` does not cover `.some`")
            return
        if types_match(subject_type, resolve_builtin_type(BuiltinType.boolean)):
            var has_true = false
            var has_false = false
            for literal in coverage.literals:
                match literal:
                    Boolean(item):
                        if item: has_true = true
                        else: has_false = true
                    else: continue
            if not has_true: try self.fail(span, "`match` does not cover `true`")
            if not has_false: try self.fail(span, "`match` does not cover `false`")
            return
        try self.fail(span, "`match` on `" + self.describe_type(subject_type) + "` needs a `_` arm")

    # The one gate every checked expression passes: its type must satisfy the
    # context that asked for it.
    func require_type(value: NodeId, expected: TypeId?) -> NodeId!:
        if expected == none: return value
        let found = self.type_of(value)
        if types_match(found, expected): return value
        let inner = self.optional_inner(expected)
        if inner != none and types_match(found, inner):
            return self.push_node(HirNodeForm.Some(value = value), expected, self.span_of(value))
        error(self.diagnostic(self.span_of(value), "expected `" + self.describe_type(expected) + "`, found `" + self.describe_type(found) + "`"))

    # A literal: its value goes into the value table, the node names it.
    func push_constant(value: Value, value_type: TypeId, span: SourceSpan) -> NodeId:
        self.values.append(value)
        return self.push_node(HirNodeForm.Constant(value = u32(len(self.values) - 1)), value_type, span)

    # A literal tree: constants, tuples and optionals of constants, and unary
    # or binary operators over them. Constant references are allowed because
    # a module constant is itself such a tree.
    func is_constant_expression(id: NodeId) -> bool:
        match self.node_form(id):
            Constant(item): return true
            NoneLiteral: return true
            Some(inner): return self.is_constant_expression(inner)
            Tuple(elements): return self.run_is_constant(elements)
            StructValue(struct_index, fields): return self.run_is_constant(fields)
            EnumValue(enum_index, case_index, payload): return self.run_is_constant(payload)
            Unary(operation, operand): return self.is_constant_expression(operand)
            Binary(left, operation, right): return self.is_constant_expression(left) and self.is_constant_expression(right)
            Conditional(chosen, condition, alternative):
                return self.is_constant_expression(chosen) and self.is_constant_expression(condition) and self.is_constant_expression(alternative)
            Reference(symbol): return true
            else: return false

    func run_is_constant(run: Operands) -> bool:
        for index in range(0, i64(run.count)):
            if not self.is_constant_expression(NodeId(value = self.extra[i64(run.start) + index])): return false
        return true

    # Conservative: a suite definitely returns only when a statement is a
    # `return`, or an `if` with an `else` whose every arm definitely returns.
    func statements_return(statements: list[NodeId]) -> bool:
        for statement in statements:
            match self.node_form(statement):
                ReturnStatement(value): return true
                IfStatement(branches, has_fallback, fallback):
                    if has_fallback:
                        var every_branch_returns = true
                        for branch in range(0, i64(branches.count) // 3):
                            let body = Operands(start = self.extra[i64(branches.start) + branch * 3 + 1], count = self.extra[i64(branches.start) + branch * 3 + 2])
                            if not self.statements_return(self.run_nodes(body)): every_branch_returns = false
                        if every_branch_returns and self.statements_return(self.run_nodes(fallback)): return true
                Match(subject, arms, has_result):
                    # Exhaustive, so returning in every arm returns.
                    var every_arm_returns = true
                    for position in range(0, i64(arms.count)):
                        match self.node_form(NodeId(value = self.extra[i64(arms.start) + position])):
                            MatchArm(patterns, arm_statements, value):
                                if not self.statements_return(self.run_nodes(arm_statements)): every_arm_returns = false
                            else: every_arm_returns = false
                    if every_arm_returns: return true
                else: continue
        return false

    func run_nodes(run: Operands) -> list[NodeId]:
        let ids = list[NodeId]()
        for index in range(0, i64(run.count)):
            ids.append(NodeId(value = self.extra[i64(run.start) + index]))
        return ids

    # Render a TypeId only when producing a diagnostic. Semantic decisions use
    # identity and type forms, never this human-readable spelling.
    func describe_type(value: TypeId) -> str:
        return describe_type(self.types, value)

    # `path:line:column: message` for the current module, or a chosen one.
    func diagnostic(span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[self.current_module].path, span, message)

    func diagnostic_at(module_index: i64, span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[module_index].path, span, message)

    func fail(span: SourceSpan, message: str) -> !:
        error(self.diagnostic(span, message))

    func fail_at(module_index: i64, span: SourceSpan, message: str) -> !:
        error(self.diagnostic_at(module_index, span, message))


# mark: Type and operator tables ==============================================================

func find_literal_token(value: ExpressionSyntax) -> Token?:
    match value.form:
        Literal(token): return token
        else: return none

# Report whether an integer expression still needs a type from its context.
# Examples: `5`, `-5`, and `(5)` qualify; `5i64` and `count` do not.
func is_contextual_integer_expression(value: ExpressionSyntax) -> bool:
    match value.form:
        Literal(token): return token.kind == TokenKind.int_lit and token.suffix == ""
        Group(grouped): return is_contextual_integer_expression(grouped)
        Unary(operator, operand):
            return (operator == "+" or operator == "-") and is_contextual_integer_expression(operand)
        else: return false

# Structural comparison of pattern literals; only scalars and strings appear.
func values_equal(left: Value, right: Value) -> bool:
    match left:
        Integer(a):
            match right:
                Integer(b): return a == b
                else: return false
        Boolean(a):
            match right:
                Boolean(b): return a == b
                else: return false
        Character(a):
            match right:
                Character(b): return a == b
                else: return false
        Text(a):
            match right:
                Text(b): return a == b
                else: return false
        else: return false

func value_less_or_equal(left: Value, right: Value) -> bool:
    match left:
        Integer(a):
            match right:
                Integer(b): return a <= b
                else: return false
        Character(a):
            match right:
                Character(b): return u32(a) <= u32(b)
                else: return false
        else: return false

# The value just below a range's exclusive upper bound.
func predecessor(value: Value) -> Value:
    match value:
        Integer(a): return Value.Integer(value = a - 1)
        Character(a): return Value.Character(value = char(u32(a) - 1))
        else: return value

func value_in_range(value: Value, low: Value, high: Value) -> bool:
    return value_less_or_equal(low, value) and value_less_or_equal(value, high)

func ranges_overlap(low: Value, high: Value, other_low: Value, other_high: Value) -> bool:
    return value_less_or_equal(low, other_high) and value_less_or_equal(other_low, high)

func join_names(names: list[str]) -> str:
    var text = ""
    for index in range(0, len(names)):
        if index > 0: text = text + ", "
        text = text + "`" + names[index] + "`"
    return text

func find_parameter(function: FunctionSymbol, name: str) -> i64:
    for index in range(0, len(function.parameters)):
        if function.parameters[index].name == name: return index
    return -1

func is_arithmetic_operator(operator: str) -> bool:
    return match operator:
        "+", "-", "*", "/", "//", "%" => true
        "&", "|", "^", "<<", ">>" => true
        else => false

# The one implemented-name table. `resolve_type` uses this both to decide
# "not implemented yet" and to obtain the canonical TypeId, so the two cannot
# drift.
func builtin_type_id(name: str) -> TypeId?:
    return match name:
        "unit" => resolve_builtin_type(BuiltinType.unit)
        "bool" => resolve_builtin_type(BuiltinType.boolean)
        "i8" => resolve_builtin_type(BuiltinType.signed_i8)
        "i16" => resolve_builtin_type(BuiltinType.signed_i16)
        "i32" => resolve_builtin_type(BuiltinType.signed_i32)
        "i64" => resolve_builtin_type(BuiltinType.signed_i64)
        "u8" => resolve_builtin_type(BuiltinType.unsigned_u8)
        "u16" => resolve_builtin_type(BuiltinType.unsigned_u16)
        "u32" => resolve_builtin_type(BuiltinType.unsigned_u32)
        "u64" => resolve_builtin_type(BuiltinType.unsigned_u64)
        "f32" => resolve_builtin_type(BuiltinType.float32)
        "f64" => resolve_builtin_type(BuiltinType.float64)
        "char" => resolve_builtin_type(BuiltinType.character)
        "str" => resolve_builtin_type(BuiltinType.string)
        "bytes" => resolve_builtin_type(BuiltinType.byte_string)
        else => none

func decode_digit(c: char) -> i64:
    let code = u32(c)
    if c <= '9': return i64(code - u32('0'))
    if c <= 'F': return i64(code - u32('A')) + 10
    return i64(code - u32('a')) + 10
