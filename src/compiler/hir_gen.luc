#==============================================================================================
#
#   hir_gen - Source syntax into typed HIR
#
#   DESCRIPTION:
#       Turns source trees into typed HIR: resolves module and lexical names,
#       checks the implemented type rules, and decodes literal spellings. The
#       semantic analyzer and reference interpreter consume that HIR directly;
#       the lowerer turns it into canonical MIR for compiled backends.
#       Anything the current slice cannot generate yet fails with
#       "not implemented yet".
#
#       Generation runs in two passes: signatures are collected across every
#       module first, so bodies can call forward and across modules; then each
#       body is generated in order. Topics inside this file — and the split to
#       make when a section grows — are modules and imports, aliases,
#       constants, signatures, functions and statements, expressions, literal
#       decoding, and name lookup. Language-defined type spellings live in
#       `core_types.luc`; the names this slice can actually generate live in
#       `builtin_type_id`.
#
#       Two failure idioms, shared with the parser: `try self.fail(...)` raises
#       mid-flow, and a match arm or function tail that cannot continue ends
#       with `error(self.diagnostic(...))` directly.
#
#==============================================================================================

from compiler.core_types import is_core_type_name
from compiler.source import SourceSpan, format_diagnostic
from compiler.syntax import ArgumentSyntax, BindingPatternSyntax, ConstantSyntax, ExpressionSyntax
from compiler.syntax import FunctionSyntax, IfBranchSyntax, ModuleSyntax, NominalTypeKind, StatementSyntax
from compiler.syntax import SuiteSyntax, TypeAliasSyntax, TypeArgumentSyntax, TypeSyntax
from compiler.tokenizer import Token, TokenKind
from compiler.hir import AssignmentOperation, BinaryOperation, BuiltinType
from compiler.hir import HirArgument, HirConstant, HirExpression, HirExpressionForm, HirFunction, HirIfBranch
from compiler.hir import HirModule, HirParameter, HirProgram, HirStatement, HirStatementForm
from compiler.hir import HirSymbol, ModuleId, SymbolId, SymbolKind, TypeDefinition, TypeForm, TypeId, TypeTable
from compiler.hir import UnaryOperation, Value, create_builtin_type_table
from compiler.hir import describe_type, integer_maximum, integer_minimum
from compiler.hir import is_floating_type, is_integer_type, is_numeric_type, is_ordered_type
from compiler.hir import is_unsigned_integer_type, resolve_builtin_type, type_forms_match, types_match

# mark: HirGenerator state ====================================================================

## One parsed file with the identity supplied by its caller. This stage never
## guesses module identity from import spelling or source contents.
pub struct SourceModule:
    pub name: str
    pub path: str
    pub syntax: ModuleSyntax

# One collected function signature: everything a call site or a body check
# needs to know about a function before its own body is checked.
struct FunctionSymbol:
    pub symbol: SymbolId
    pub module_index: i64
    pub name: str
    pub is_public: bool
    pub parameters: list[HirParameter]
    pub result: TypeId
    pub syntax: FunctionSyntax
    pub span: SourceSpan

struct ImportedModule:
    pub name: str
    pub module_index: i64

struct ImportedFunction:
    pub name: str
    pub function_index: i64

# What one module's imports made visible: module names for qualified calls,
# and selectively imported functions for direct calls.
struct ModuleBindings:
    pub modules: list[ImportedModule]
    pub functions: list[ImportedFunction]

# One live local: `let total = 0` puts a `total` in scope until its suite ends.
struct LocalBinding:
    pub symbol: SymbolId
    pub name: str
    pub value_type: TypeId
    pub is_mutable: bool

# One module-level `type Name = T` waiting to be resolved, or already resolved.
struct CollectedAlias:
    module_index: i64
    name: str
    is_public: bool
    syntax: TypeAliasSyntax
    span: SourceSpan
    resolved: TypeId?

# One module-level constant. `typed` is filled after signatures exist.
struct CollectedConstant:
    symbol: SymbolId
    module_index: i64
    name: str
    is_public: bool
    annotation: TypeSyntax?
    value: ExpressionSyntax
    span: SourceSpan
    typed: HirExpression?

# This stage resolves source operator spelling and result typing together, so
# no later HIR consumer needs to repeat either half of the operator table.
struct ResolvedBinary:
    pub operation: BinaryOperation
    pub result: TypeId

# The two checked operands retain source order even when contextual literal
# typing needs to learn the right operand's type first.
struct CheckedBinaryOperands:
    pub left: HirExpression
    pub right: HirExpression

## Generates typed HIR for one whole program. Collection is internal so
## callers cannot run a partial generation; public use begins and ends at
## `HirGenerator.generate`.
pub class HirGenerator:
    sources: list[SourceModule]
    types: TypeTable
    symbols: list[HirSymbol]
    aliases: list[CollectedAlias]
    constants: list[CollectedConstant]
    alias_stack: list[str]
    constant_stack: list[str]
    module_bindings: list[ModuleBindings]
    # Every function signature in the program, across all modules.
    functions: list[FunctionSymbol]
    next_symbol: i64
    # The module, function contract, import bindings, live local bindings, and
    # loop depth of whatever is being checked right now.
    current_module: i64
    current_result: TypeId
    bindings: ModuleBindings
    locals: list[LocalBinding]
    loop_depth: i64

    pub init(sources: list[SourceModule]):
        self.sources = sources
        self.types = create_builtin_type_table()
        self.symbols = list[HirSymbol]()
        self.aliases = list[CollectedAlias]()
        self.constants = list[CollectedConstant]()
        self.alias_stack = list[str]()
        self.constant_stack = list[str]()
        self.module_bindings = list[ModuleBindings]()
        self.functions = list[FunctionSymbol]()
        self.next_symbol = 0
        self.current_module = 0
        self.current_result = resolve_builtin_type(BuiltinType.unit)
        self.bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        self.locals = list[LocalBinding]()
        self.loop_depth = 0

    # mark: Generation ==========================================================================

    ## Generate typed HIR or stop at the first semantic problem.
    pub func generate() -> HirProgram!:
        try self.validate_module_names()
        try self.validate_mutating_placements()
        try self.collect_declarations()
        try self.collect_module_bindings()
        try self.resolve_aliases()
        try self.check_constants()

        let modules = list[HirModule]()
        for module_index in range(0, len(self.sources)):
            let source = self.sources[module_index]
            modules.append(HirModule(id = ModuleId(value = module_index), name = source.name, path = source.path))

        let hir_functions = list[HirFunction]()
        for module_index in range(0, len(self.sources)):
            self.enter_module(module_index)
            for function in self.functions:
                if function.module_index == module_index:
                    hir_functions.append(try self.check_function(function))

        let hir_constants = list[HirConstant]()
        for constant in self.constants:
            let typed = constant.typed else trap("constant was not typed")
            hir_constants.append(HirConstant(
                symbol = constant.symbol,
                module = ModuleId(value = constant.module_index),
                name = constant.name,
                is_public = constant.is_public,
                value = typed,
            ))

        return HirProgram(types = self.types, symbols = self.symbols, modules = modules, constants = hir_constants, functions = hir_functions)

    # mark: Modules and imports =================================================================

    # Two files may not claim the same module name; the second one loses.
    func validate_module_names() -> !:
        for index in range(0, len(self.sources)):
            for previous in range(0, index):
                if self.sources[previous].name == self.sources[index].name:
                    try self.fail_at(index, self.sources[index].syntax.span, "duplicate module `" + self.sources[index].name + "`")

    # `mutating` describes replacement of a value receiver. Module functions
    # have no receiver, while classes already mutate through shared identity;
    # structs, enums, and interface requirements retain the modifier.
    func validate_mutating_placements() -> !:
        for module_index in range(0, len(self.sources)):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    Function(function):
                        if function.is_mutating:
                            try self.fail_at(module_index, declaration.span, "`mutating` is valid only on value-type methods")
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            for member in nominal.members:
                                match member.value:
                                    Function(function):
                                        if function.is_mutating:
                                            try self.fail_at(module_index, member.span, "class methods do not use `mutating`; class identity already permits field mutation")
                                    else: continue
                    else: continue

    # Turn one module's import lines into name bindings, checking that every
    # imported module exists, every selected function exists and is public,
    # and no two imports land on the same local name.
    func resolve_imports(module_index: i64) -> ModuleBindings!:
        let bindings = ModuleBindings(modules = list[ImportedModule](), functions = list[ImportedFunction]())
        for imported in self.sources[module_index].syntax.imports:
            let imported_name = imported.path.dotted()
            let imported_module = self.find_source(imported_name)
            if imported_module < 0:
                try self.fail_at(module_index, imported.path.span, "unknown module `" + imported_name + "`")
            if imported_module == module_index:
                try self.fail_at(module_index, imported.path.span, "a module cannot import itself")

            if len(imported.names) == 0:
                let local_name = imported.alias_name else imported.path.last()
                try self.require_free_import_name(module_index, bindings, local_name, imported.span)
                bindings.modules.append(ImportedModule(name = local_name, module_index = imported_module))
            else:
                for selected in imported.names:
                    try self.require_free_import_name(module_index, bindings, selected.name, selected.span)
                    let function_index = self.find_function_in_module(imported_module, selected.name)
                    if function_index < 0:
                        try self.fail_at(module_index, selected.span, "module `" + imported_name + "` has no function `" + selected.name + "`")
                    if not self.functions[function_index].is_public:
                        try self.fail_at(module_index, selected.span, "`" + selected.name + "` is private to module `" + imported_name + "`")
                    bindings.functions.append(ImportedFunction(name = selected.name, function_index = function_index))
        return bindings

    # An imported name may not collide with a declaration or another import.
    func require_free_import_name(module_index: i64, bindings: ModuleBindings, name: str, span: SourceSpan) -> !:
        if self.find_function_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        if self.find_constant_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        if self.find_alias_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "imported name `" + name + "` conflicts with a declaration")
        for imported in bindings.modules:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")
        for imported in bindings.functions:
            if imported.name == name:
                try self.fail_at(module_index, span, "duplicate imported name `" + name + "`")

    # mark: Signature collection ================================================================

    # The first pass: record aliases, constants, and function signatures so
    # later bodies can see every module-level name.
    func collect_declarations() -> !:
        for module_index in range(0, len(self.sources)):
            for declaration in self.sources[module_index].syntax.declarations:
                match declaration.value:
                    Constant(constant):
                        try self.collect_constant(module_index, declaration.is_public, constant, declaration.span)
                    TypeAlias(type_alias):
                        try self.collect_alias(module_index, declaration.is_public, type_alias, declaration.span)
                    Function(function):
                        try self.collect_function(module_index, declaration.is_public, function, declaration.span)
                    NominalType(nominal):
                        if nominal.kind == NominalTypeKind.class_type:
                            try self.fail_at(module_index, declaration.span, "class types are not implemented yet")
                        try self.fail_at(module_index, declaration.span, "struct types are not implemented yet")
                    Enumeration(enumeration):
                        try self.fail_at(module_index, declaration.span, "enum types are not implemented yet")
                    InterfaceType(interface_type):
                        try self.fail_at(module_index, declaration.span, "interfaces are not implemented yet")
                    TestDeclaration(test_declaration):
                        try self.fail_at(module_index, declaration.span, "test declarations are not implemented yet")
                    ExportStruct(export_struct):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExportEnum(export_enum):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExportFunction(export_function):
                        try self.fail_at(module_index, declaration.span, "export declarations are not implemented yet")
                    ExternType(extern_type):
                        try self.fail_at(module_index, declaration.span, "extern type declarations are not implemented yet")
                    ExternFunction(extern_function):
                        try self.fail_at(module_index, declaration.span, "extern function declarations are not implemented yet")
                    ExternVariable(extern_variable):
                        try self.fail_at(module_index, declaration.span, "extern variable declarations are not implemented yet")
                    ExternStruct(extern_struct):
                        try self.fail_at(module_index, declaration.span, "extern struct declarations are not implemented yet")

    func collect_alias(module_index: i64, is_public: bool, type_alias: TypeAliasSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, type_alias.name, span)
        self.aliases.append(CollectedAlias(
            module_index = module_index,
            name = type_alias.name,
            is_public = is_public,
            syntax = type_alias,
            span = span,
            resolved = none,
        ))

    func collect_constant(module_index: i64, is_public: bool, constant: ConstantSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, constant.name, span)
        let placeholder = resolve_builtin_type(BuiltinType.unit)
        let symbol = self.make_symbol(constant.name, SymbolKind.constant, placeholder)
        self.constants.append(CollectedConstant(
            symbol = symbol,
            module_index = module_index,
            name = constant.name,
            is_public = is_public,
            annotation = constant.annotation,
            value = constant.value,
            span = span,
            typed = none,
        ))

    func require_free_module_name(module_index: i64, name: str, span: SourceSpan) -> !:
        if self.find_function_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_alias_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")
        if self.find_constant_in_module(module_index, name) >= 0:
            try self.fail_at(module_index, span, "duplicate declaration `" + name + "`")

    func collect_module_bindings() -> !:
        for module_index in range(0, len(self.sources)):
            self.module_bindings.append(try self.resolve_imports(module_index))

    func enter_module(module_index: i64):
        self.current_module = module_index
        self.bindings = self.module_bindings[module_index]

    func resolve_aliases() -> !:
        for index in range(0, len(self.aliases)):
            try self.resolve_alias(index)

    func resolve_alias(index: i64) -> TypeId!:
        let item = self.aliases[index]
        let already = item.resolved
        if already != none: return already
        let key = str(item.module_index) + "." + item.name
        for previous in self.alias_stack:
            if previous == key:
                try self.fail_at(item.module_index, item.span, "type alias `" + item.name + "` is recursive")
        self.alias_stack.append(key)
        self.current_module = item.module_index
        let resolved = try self.resolve_type(item.module_index, item.syntax.value)
        self.alias_stack.remove(len(self.alias_stack) - 1)
        self.aliases[index] = CollectedAlias(
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            syntax = item.syntax,
            span = item.span,
            resolved = resolved,
        )
        return resolved

    func check_constants() -> !:
        for index in range(0, len(self.constants)):
            try self.resolve_constant(index)

    # Type one constant's initializer, resolving other constants as needed.
    # Cycles (`let a = a`, or `let a = b` / `let b = a`) fail as recursion.
    func resolve_constant(index: i64) -> !:
        let item = self.constants[index]
        if item.typed != none: return
        let key = str(item.module_index) + "." + item.name
        for previous in self.constant_stack:
            if previous == key:
                try self.fail_at(item.module_index, item.span, "constant `" + item.name + "` is recursive")
        self.constant_stack.append(key)
        let saved_module = self.current_module
        let saved_bindings = self.bindings
        self.enter_module(item.module_index)
        var expected: TypeId? = none
        let annotation = item.annotation
        if annotation != none:
            expected = try self.resolve_type(item.module_index, annotation)
        let typed = try self.check_expression(item.value, expected)
        self.constant_stack.remove(len(self.constant_stack) - 1)
        self.current_module = saved_module
        self.bindings = saved_bindings
        self.symbols[item.symbol.value] = HirSymbol(
            id = item.symbol,
            name = item.name,
            kind = SymbolKind.constant,
            value_type = typed.value_type,
        )
        self.constants[index] = CollectedConstant(
            symbol = item.symbol,
            module_index = item.module_index,
            name = item.name,
            is_public = item.is_public,
            annotation = item.annotation,
            value = item.value,
            span = item.span,
            typed = typed,
        )

    # Record one function's signature: resolved parameter and result types,
    # a fresh symbol per parameter, and a fresh symbol for the function itself.
    func collect_function(module_index: i64, is_public: bool, function: FunctionSyntax, span: SourceSpan) -> !:
        try self.require_free_module_name(module_index, function.name, span)
        if len(function.generic_parameters) > 0:
            try self.fail_at(module_index, span, "generic functions are not implemented yet")

        let parameters = list[HirParameter]()
        for parameter in function.parameters:
            for previous in parameters:
                if previous.name == parameter.name:
                    try self.fail_at(module_index, parameter.span, "duplicate parameter `" + parameter.name + "`")
            let annotation = parameter.annotation else error(self.diagnostic_at(
                module_index,
                parameter.span,
                "parameter `" + parameter.name + "` requires a type",
            ))
            if parameter.default_value != none:
                try self.fail_at(module_index, parameter.span, "default arguments are not implemented yet")
            let parameter_type = try self.resolve_type(module_index, annotation)
            let parameter_symbol = self.make_symbol(parameter.name, SymbolKind.parameter, parameter_type)
            parameters.append(HirParameter(symbol = parameter_symbol, name = parameter.name, value_type = parameter_type))

        var result = resolve_builtin_type(BuiltinType.unit)
        let result_syntax = function.result
        if result_syntax != none:
            result = try self.resolve_type(module_index, result_syntax)
        let function_symbol = self.make_symbol(function.name, SymbolKind.function, result)
        self.functions.append(FunctionSymbol(
            symbol = function_symbol,
            module_index = module_index,
            name = function.name,
            is_public = is_public,
            parameters = parameters,
            result = result,
            syntax = function,
            span = span,
        ))

    # Turn a type spelling into a checked value type. A known-but-unimplemented
    # core type earns "not implemented yet".
    func resolve_type(module_index: i64, value: TypeSyntax) -> TypeId!:
        match value.form:
            Named(path):
                if len(path.parts) != 1:
                    try self.fail_at(module_index, path.span, "unknown type `" + path.dotted() + "`")
                let name = path.parts[0]
                let alias_index = self.find_alias_in_module(module_index, name)
                if alias_index >= 0: return try self.resolve_alias(alias_index)
                let builtin = builtin_type_id(name)
                if builtin != none: return builtin
                if is_core_type_name(name):
                    error(self.diagnostic_at(module_index, path.span, "type `" + name + "` is not implemented yet"))
                error(self.diagnostic_at(module_index, path.span, "unknown type `" + path.dotted() + "`"))
            Applied(path, arguments):
                if path.dotted() == "slice" and len(arguments) == 1:
                    match arguments[0]:
                        TypeArgument(element):
                            let inner = try self.resolve_type(module_index, element)
                            return self.intern_slice(inner)
                        else:
                            error(self.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
                error(self.diagnostic_at(module_index, value.span, "applied types are not implemented yet"))
            GroupedType(grouped):
                return try self.resolve_type(module_index, grouped)
            TupleType(elements):
                let parts = list[TypeId]()
                for element in elements:
                    parts.append(try self.resolve_type(module_index, element))
                return self.intern_tuple(parts)
            FunctionType(parameters, result):
                let parts = list[TypeId]()
                for parameter in parameters:
                    parts.append(try self.resolve_type(module_index, parameter))
                return self.intern_function_type(parts, try self.resolve_type(module_index, result))
            CFunctionType(parameters, result):
                error(self.diagnostic_at(module_index, value.span, "cfunc types are not implemented yet"))
            OptionalType(optional_value):
                return self.intern_optional(try self.resolve_type(module_index, optional_value))
            FallibleType(successful_value):
                return self.intern_fallible(try self.resolve_type(module_index, successful_value))

    # mark: Functions and statements ============================================================

    # The second pass, one function at a time: parameters enter scope, the body
    # is checked statement by statement, and a non-unit function must provably
    # return on every path.
    func check_function(function: FunctionSymbol) -> HirFunction!:
        self.current_result = function.result
        self.locals = list[LocalBinding]()
        self.loop_depth = 0

        for parameter in function.parameters:
            try self.require_free_local_name(parameter.name, function.span)
            self.locals.append(LocalBinding(symbol = parameter.symbol, name = parameter.name, value_type = parameter.value_type, is_mutable = false))

        let body_syntax = function.syntax.body else trap("function definition has no body")
        let body = try self.check_suite(body_syntax.statements)
        if not types_match(function.result, resolve_builtin_type(BuiltinType.unit)) and not statements_return(body):
            try self.fail(function.span, "function `" + function.name + "` may finish without returning `" + self.describe_type(function.result) + "`")
        return HirFunction(
            symbol = function.symbol,
            module = ModuleId(value = function.module_index),
            name = function.name,
            is_public = function.is_public,
            parameters = function.parameters,
            result = function.result,
            body = body,
            span = function.span,
        )

    # A suite is one lexical scope: bindings made inside it end with it.
    func check_suite(statements: list[StatementSyntax]) -> list[HirStatement]!:
        let outer_count = len(self.locals)
        let typed = list[HirStatement]()
        for statement in statements:
            for item in try self.check_statement(statement):
                typed.append(item)
        while len(self.locals) > outer_count:
            self.locals.remove(len(self.locals) - 1)
        return typed

    # Check one statement. Each statement family owns its detailed rules below.
    func check_statement(statement: StatementSyntax) -> list[HirStatement]!:
        match statement.form:
            BreakStatement:
                if self.loop_depth == 0: try self.fail(statement.span, "`break` is only valid inside a loop")
                return [HirStatement(form = HirStatementForm.BreakStatement, span = statement.span)]
            ContinueStatement:
                if self.loop_depth == 0: try self.fail(statement.span, "`continue` is only valid inside a loop")
                return [HirStatement(form = HirStatementForm.ContinueStatement, span = statement.span)]
            Binding(is_mutable, pattern, annotation, value):
                return try self.check_binding(is_mutable, pattern, annotation, value, statement.span)
            Assignment(target, operator, value):
                return [try self.check_assignment(target, operator, value, statement.span)]
            ReturnStatement(value):
                return [try self.check_return(value, statement.span)]
            ExpressionStatement(value):
                let printed = try self.check_print_call(value)
                if printed != none: return [printed]
                return [HirStatement(form = HirStatementForm.ExpressionStatement(value = try self.check_expression(value, none)), span = statement.span)]
            IfStatement(branches, fallback):
                return [try self.check_if(branches, fallback, statement.span)]
            WhileStatement(condition, body):
                return [try self.check_while(condition, body, statement.span)]
            DeferStatement(value):
                error(self.diagnostic(statement.span, "`defer` is not implemented yet"))
            RecoverStatement(value):
                error(self.diagnostic(statement.span, "`recover` is not implemented yet"))
            ForStatement(name, iterable, body):
                error(self.diagnostic(statement.span, "`for` is not implemented yet"))
            MatchStatement(subject, arms):
                error(self.diagnostic(statement.span, "`match` is not implemented yet"))

    # Recognize a bare `print(...)` statement so it can take the special path
    # below; anything else falls through to ordinary expression checking.
    func check_print_call(value: ExpressionSyntax) -> HirStatement?!:
        match value.form:
            Call(callee, type_arguments, arguments):
                match callee.form:
                    Name(name):
                        if name == "print": return try self.check_print(type_arguments, arguments, value.span)
                        return none
                    else: return none
            else: return none

    # `print` is the first terminal operation in the executable slice. A
    # string literal becomes `PrintText`, whose bytes are known now; any other
    # `str` expression becomes `PrintValue` and is written at run time.
    func check_print(type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan) -> HirStatement!:
        if len(type_arguments) > 0 or len(arguments) != 1 or arguments[0].label != none:
            try self.fail(span, "`print` expects one positional string")
        var literal: Token? = none
        match arguments[0].value.form:
            Literal(token):
                if token.kind == TokenKind.str_lit: literal = token
            else: literal = none
        if literal != none:
            return HirStatement(form = HirStatementForm.PrintText(value = try self.decode_print_text(literal)), span = span)
        let printed = try self.check_expression(arguments[0].value, resolve_builtin_type(BuiltinType.string))
        return HirStatement(form = HirStatementForm.PrintValue(value = printed), span = span)

    # Turn a plain `"..."` spelling into the bytes `print` will write, decoding
    # the handful of escapes the slice supports.
    func decode_print_text(token: Token) -> str!:
        if len(token.text) < 2 or token.text[0] != '"' or token.text[len(token.text) - 1] != '"':
            try self.fail(token.span, "prefixed and triple-quoted strings are not implemented by `print` yet")
        if len(token.text) >= 3 and token.text[1] == '"':
            try self.fail(token.span, "prefixed and triple-quoted strings are not implemented by `print` yet")

        var decoded = ""
        var position = 1
        while position < len(token.text) - 1:
            let c = token.text[position]
            if c != '\\':
                decoded = decoded + str(c)
            else:
                position += 1
                if position >= len(token.text) - 1: try self.fail(token.span, "incomplete string escape")
                match token.text[position]:
                    'n': decoded = decoded + "\n"
                    'r': decoded = decoded + "\r"
                    't': decoded = decoded + "\t"
                    '\\': decoded = decoded + "\\"
                    '"': decoded = decoded + "\""
                    else: try self.fail(token.span, "this string escape is not implemented by `print` yet")
            position += 1
        return decoded

    # `let name = value` or `var name: T = value` — the annotation, when
    # present, becomes the expected type of the initializer.
    func check_binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan) -> list[HirStatement]!:
        match pattern:
            Name(name, name_span):
                try self.require_free_local_name(name, name_span)
                var expected: TypeId? = none
                if annotation != none:
                    expected = try self.resolve_type(self.current_module, annotation)
                let checked = try self.check_expression(value, expected)
                let symbol = self.make_symbol(name, SymbolKind.local, checked.value_type)
                self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = checked.value_type, is_mutable = is_mutable))
                return [HirStatement(form = HirStatementForm.Binding(symbol = symbol, name = name, is_mutable = is_mutable, value = checked), span = span)]
            TupleNames(names, pattern_span):
                # Duplicate names report at the binding statement; the pattern
                # stores names without per-name spans.
                var expected: TypeId? = none
                if annotation != none:
                    expected = try self.resolve_type(self.current_module, annotation)
                let checked = try self.check_expression(value, expected)
                let elements = self.tuple_elements(checked.value_type) else error(self.diagnostic(span, "tuple binding requires a tuple value, found `" + self.describe_type(checked.value_type) + "`"))
                if len(names) != len(elements):
                    try self.fail(span, "tuple binding has " + str(len(names)) + " name(s), value has " + str(len(elements)))
                let tuple_symbol = self.make_symbol("_tuple", SymbolKind.local, checked.value_type)
                let statements = list[HirStatement]()
                statements.append(HirStatement(form = HirStatementForm.Binding(symbol = tuple_symbol, name = "_tuple", is_mutable = false, value = checked), span = span))
                var index = 0
                while index < len(names):
                    let name = names[index].text
                    try self.require_free_local_name(name, names[index].span)
                    let element_type = elements[index]
                    let symbol = self.make_symbol(name, SymbolKind.local, element_type)
                    self.locals.append(LocalBinding(symbol = symbol, name = name, value_type = element_type, is_mutable = is_mutable))
                    let tuple_ref = HirExpression(
                        value_type = checked.value_type,
                        form = HirExpressionForm.Reference(symbol = tuple_symbol),
                        span = span,
                    )
                    let element = HirExpression(
                        value_type = element_type,
                        form = HirExpressionForm.Element(value = tuple_ref, index = index),
                        span = span,
                    )
                    statements.append(HirStatement(form = HirStatementForm.Binding(symbol = symbol, name = name, is_mutable = is_mutable, value = element), span = names[index].span))
                    index += 1
                return statements

    # `name = value` and the augmented forms; only mutable local names are
    # assignable in the current slice.
    func check_assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan) -> HirStatement!:
        var name = ""
        match target.form:
            Name(value_name): name = value_name
            else: try self.fail(span, "member and index assignment are not implemented yet")
        let local_index = self.find_local(name)
        if local_index < 0: try self.fail(span, "unknown local binding `" + name + "`")
        let local = self.locals[local_index]
        if not local.is_mutable: try self.fail(span, "cannot assign to immutable binding `" + name + "`; declare it with `var`")
        let checked = try self.check_expression(value, local.value_type)
        # `value += delta` must leave `value` its own type, so the compound
        # operator is checked as the binary operation it abbreviates.
        var operation: AssignmentOperation = AssignmentOperation.Replace
        if operator != "=":
            let binary_operator = operator[0:len(operator) - 1]
            let resolved = try self.resolve_binary_operation(local.value_type, binary_operator, checked.value_type, span)
            if not types_match(resolved.result, local.value_type):
                try self.fail(
                    span,
                    "assignment changes `" + name + "` from `" + self.describe_type(local.value_type) + "` to `" + self.describe_type(resolved.result) + "`",
                )
            operation = AssignmentOperation.Combine(operation = resolved.operation)
        return HirStatement(form = HirStatementForm.Assignment(symbol = local.symbol, operation = operation, value = checked), span = span)

    # A return must match the enclosing function's contract: a value
    # for a value-returning function, nothing for a unit function.
    func check_return(value: ExpressionSyntax?, span: SourceSpan) -> HirStatement!:
        if value == none:
            if not types_match(self.current_result, resolve_builtin_type(BuiltinType.unit)):
                try self.fail(span, "return requires a `" + self.describe_type(self.current_result) + "` value")
            return HirStatement(form = HirStatementForm.ReturnStatement(value = none), span = span)
        if types_match(self.current_result, resolve_builtin_type(BuiltinType.unit)):
            try self.fail(span, "a `unit` function cannot return a value")
        let checked = try self.check_expression(value, self.current_result)
        return HirStatement(form = HirStatementForm.ReturnStatement(value = checked), span = span)

    # Each `if`/`elif` condition must be bool; every branch body is its own
    # lexical scope.
    func check_if(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan) -> HirStatement!:
        let typed_branches = list[HirIfBranch]()
        for branch in branches:
            match branch.condition.form:
                Expression(condition):
                    let checked = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
                    typed_branches.append(HirIfBranch(condition = checked, body = try self.check_suite(branch.body.statements)))
                else:
                    try self.fail(branch.span, "conditional bindings are not implemented yet")
        var typed_fallback: list[HirStatement]? = none
        if fallback != none:
            typed_fallback = try self.check_suite(fallback.statements)
        return HirStatement(form = HirStatementForm.IfStatement(branches = typed_branches, fallback = typed_fallback), span = span)

    # The loop depth makes `break` and `continue` valid inside the body.
    func check_while(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan) -> HirStatement!:
        let checked_condition = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
        self.loop_depth += 1
        let checked_body = try self.check_suite(body.statements)
        self.loop_depth -= 1
        return HirStatement(form = HirStatementForm.WhileStatement(condition = checked_condition, body = checked_body), span = span)

    # mark: Expressions =========================================================================

    # Check one expression. `expected` is the type the surrounding context
    # requires, or none where any type is welcome; every produced expression
    # passes `require_type` on its way out.
    func check_expression(value: ExpressionSyntax, expected: TypeId?) -> HirExpression!:
        match value.form:
            Literal(token): return try self.check_literal(token, expected)
            Name(name):
                let local_index = self.find_local(name)
                if local_index >= 0:
                    let local = self.locals[local_index]
                    let reference = HirExpression(
                        value_type = local.value_type,
                        form = HirExpressionForm.Reference(symbol = local.symbol),
                        span = value.span,
                    )
                    return try self.require_type(reference, expected)
                let constant_index = self.find_constant_in_module(self.current_module, name)
                if constant_index >= 0:
                    try self.resolve_constant(constant_index)
                    let constant = self.constants[constant_index]
                    let typed = constant.typed else trap("constant was not typed")
                    let reference = HirExpression(
                        value_type = typed.value_type,
                        form = HirExpressionForm.Reference(symbol = constant.symbol),
                        span = value.span,
                    )
                    return try self.require_type(reference, expected)
                if self.find_visible_function(name) >= 0:
                    try self.fail(value.span, "function values are not implemented yet")
                error(self.diagnostic(value.span, "unknown name `" + name + "`"))
            Group(grouped): return try self.check_expression(grouped, expected)
            TupleValue(elements):
                return try self.check_tuple(elements, value.span, expected)
            Unary(operator, operand): return try self.check_unary(operator, operand, value.span, expected)
            Binary(left, operator, right): return try self.check_binary(left, operator, right, value.span, expected)
            Conditional(selected, condition, alternative):
                let checked_condition = try self.check_expression(condition, resolve_builtin_type(BuiltinType.boolean))
                let checked_value = try self.check_expression(selected, expected)
                let checked_alternative = try self.check_expression(alternative, checked_value.value_type)
                let typed = HirExpression(
                    value_type = checked_value.value_type,
                    form = HirExpressionForm.Conditional(
                        value = checked_value,
                        condition = checked_condition,
                        alternative = checked_alternative,
                    ),
                    span = value.span,
                )
                return try self.require_type(typed, expected)
            Call(callee, type_arguments, arguments):
                return try self.check_call(callee, type_arguments, arguments, value.span, expected)
            ElseValue(optional_value, arm):
                return try self.check_else(optional_value, arm, value.span, expected)
            FormattedString(start, parts):
                error(self.diagnostic(value.span, "formatted strings are not implemented yet"))
            CaseValue(name, arguments):
                error(self.diagnostic(value.span, "enum cases are not implemented yet"))
            ListValue(elements):
                error(self.diagnostic(value.span, "list literals are not implemented yet"))
            MapValue(entries):
                error(self.diagnostic(value.span, "map literals are not implemented yet"))
            Member(member_value, name):
                error(self.diagnostic(value.span, "field access is not implemented yet"))
            Index(indexed, subscript):
                error(self.diagnostic(value.span, "indexing is not implemented yet"))
            Slice(sliced, start, operator, end):
                error(self.diagnostic(value.span, "slicing is not implemented yet"))
            Lambda(parameters, body):
                error(self.diagnostic(value.span, "lambdas are not implemented yet"))
            Closure(captures, parameters, result, body):
                error(self.diagnostic(value.span, "closures are not implemented yet"))
            MatchValue(subject, arms):
                error(self.diagnostic(value.span, "`match` is not implemented yet"))
            NewValue(value_type, arguments):
                error(self.diagnostic(value.span, "`new` is not implemented yet"))
            SpawnValue(function, arguments):
                error(self.diagnostic(value.span, "`spawn` is not implemented yet"))
            CatchValue(caught, failure_name, body):
                error(self.diagnostic(value.span, "`catch` is not implemented yet"))

    # A bare literal becomes a constant. An unsuffixed integer is i64 unless
    # the context asks for another integer width, e.g. `let count: i32 = 7`.
    func check_literal(token: Token, expected: TypeId?) -> HirExpression!:
        var value_type = resolve_builtin_type(BuiltinType.unit)
        var value = Value.Unit
        if token.kind == TokenKind.int_lit:
            let integer_type = try self.integer_literal_type(token, expected)
            let integer = try self.decode_integer(token)
            try self.require_integer_range(token.span, integer, integer_type)
            value_type = integer_type
            value = Value.Integer(value = integer)
        elif token.kind == TokenKind.float_lit:
            if token.suffix == "f32":
                value_type = resolve_builtin_type(BuiltinType.float32)
            elif token.suffix == "" or token.suffix == "f64":
                value_type = resolve_builtin_type(BuiltinType.float64)
            else:
                try self.fail(token.span, "float type `" + token.suffix + "` is not implemented yet")
            value = Value.Floating(value = try self.decode_float(token))
        elif token.text == "true" or token.text == "false":
            value_type = resolve_builtin_type(BuiltinType.boolean)
            value = Value.Boolean(value = token.text == "true")
        elif token.text == "none":
            let needed = expected else error(self.diagnostic(token.span, "`none` needs an optional type from context"))
            if self.optional_inner(needed) == none:
                try self.fail(token.span, "expected `" + self.describe_type(needed) + "`, found `none`")
            return HirExpression(value_type = needed, form = HirExpressionForm.NoneLiteral, span = token.span)
        elif token.kind == TokenKind.char_lit:
            value_type = resolve_builtin_type(BuiltinType.character)
            value = Value.Character(value = try self.decode_character(token))
        elif token.kind == TokenKind.str_lit:
            value_type = resolve_builtin_type(BuiltinType.string)
            value = Value.Text(value = try self.decode_print_text(token))
        elif token.kind == TokenKind.byte_lit:
            value_type = resolve_builtin_type(BuiltinType.byte_string)
            value = Value.Bytes(value = try self.decode_bytes(token))
        else:
            error(self.diagnostic(token.span, "this literal is not implemented yet"))
        return try self.require_type(HirExpression(value_type = value_type, form = HirExpressionForm.Constant(value = value), span = token.span), expected)

    func integer_literal_type(token: Token, expected: TypeId?) -> TypeId!:
        if token.suffix != "":
            let suffix_type = builtin_type_id(token.suffix) else error(self.diagnostic(token.span, "integer type `" + token.suffix + "` is not implemented yet"))
            if not is_integer_type(self.types, suffix_type):
                try self.fail(token.span, "integer type `" + token.suffix + "` is not implemented yet")
            return suffix_type
        if expected != none and is_integer_type(self.types, expected): return expected
        return resolve_builtin_type(BuiltinType.signed_i64)

    func require_integer_range(span: SourceSpan, value: i64, value_type: TypeId) -> !:
        if value < integer_minimum(self.types, value_type) or value > integer_maximum(self.types, value_type):
            try self.fail(span, "integer literal is outside `" + self.describe_type(value_type) + "` range")

    func check_unary(operator: str, operand: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> HirExpression!:
        if operator == "not":
            let boolean_type = resolve_builtin_type(BuiltinType.boolean)
            let checked = try self.check_expression(operand, boolean_type)
            let expression = HirExpression(
                value_type = boolean_type,
                form = HirExpressionForm.Unary(operation = UnaryOperation.LogicalNot, operand = checked),
                span = span,
            )
            return try self.require_type(expression, expected)
        if operator == "try": try self.fail(span, "fallible calls are not implemented yet")

        # `-9223372036854775808` must fold as one negative literal: its
        # magnitude does not fit positive i64, so negate-after-check would
        # reject the minimum. Other operands take the general path below.
        if operator == "-" and expected != none and is_unsigned_integer_type(self.types, expected):
            try self.fail(span, "`-` is invalid for `" + self.describe_type(expected) + "`")
        if operator == "-" and (expected == none or is_integer_type(self.types, expected)):
            let literal = find_literal_token(operand)
            if literal != none and literal.kind == TokenKind.int_lit:
                let integer_type = try self.integer_literal_type(literal, expected)
                if is_unsigned_integer_type(self.types, integer_type):
                    try self.fail(span, "`-` is invalid for `" + self.describe_type(integer_type) + "`")
                let integer = try self.decode_negative_integer(literal)
                try self.require_integer_range(literal.span, integer, integer_type)
                let value = Value.Integer(value = integer)
                return try self.require_type(HirExpression(value_type = integer_type, form = HirExpressionForm.Constant(value = value), span = span), expected)

        let checked = try self.check_expression(operand, expected)
        var operation = UnaryOperation.NumericIdentity(operand_type = checked.value_type)
        if operator == "~":
            if not is_integer_type(self.types, checked.value_type):
                try self.fail(span, "`~` requires an integer, found `" + self.describe_type(checked.value_type) + "`")
            operation = UnaryOperation.IntegerBitwiseNot(operand_type = checked.value_type)
        elif operator == "+" or operator == "-":
            if not is_numeric_type(self.types, checked.value_type):
                try self.fail(span, "`" + operator + "` requires a number, found `" + self.describe_type(checked.value_type) + "`")
            if operator == "-" and is_unsigned_integer_type(self.types, checked.value_type):
                try self.fail(span, "`-` is invalid for `" + self.describe_type(checked.value_type) + "`")
            if operator == "-": operation = UnaryOperation.NumericNegate(operand_type = checked.value_type)
        else:
            error(self.diagnostic(span, "operator `" + operator + "` is not implemented yet"))
        let expression = HirExpression(
            value_type = checked.value_type,
            form = HirExpressionForm.Unary(operation = operation, operand = checked),
            span = span,
        )
        return try self.require_type(expression, expected)

    func check_binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> HirExpression!:
        # An arithmetic result has its operands' type, so the expected type
        # reaches down into the operands; comparisons produce bool, so it
        # must not.
        var operand_context: TypeId? = none
        if is_arithmetic_operator(operator) and expected != none:
            operand_context = expected

        let operands = try self.check_binary_operands(left, right, operand_context)
        let resolved = try self.resolve_binary_operation(operands.left.value_type, operator, operands.right.value_type, span)
        let typed = HirExpression(
            value_type = resolved.result,
            form = HirExpressionForm.Binary(left = operands.left, operation = resolved.operation, right = operands.right),
            span = span,
        )
        return try self.require_type(typed, expected)

    # Give an unsuffixed integer literal context from either neighbor. For
    # `5 * count`, the informative right side is checked first, but the returned
    # HIR operands remain in source order and therefore execute left-to-right.
    func check_binary_operands(left: ExpressionSyntax, right: ExpressionSyntax, context: TypeId?) -> CheckedBinaryOperands!:
        if context == none and is_contextual_integer_expression(left) and not is_contextual_integer_expression(right):
            let checked_right = try self.check_expression(right, none)
            let checked_left = try self.check_expression(left, checked_right.value_type)
            return CheckedBinaryOperands(left = checked_left, right = checked_right)

        let checked_left = try self.check_expression(left, context)
        let checked_right = try self.check_expression(right, checked_left.value_type)
        return CheckedBinaryOperands(left = checked_left, right = checked_right)

    # The operator table: what each binary operator accepts and what it
    # produces. Both sides must already have the same type; there are no
    # implicit conversions anywhere in the language.
    func resolve_binary_operation(left: TypeId, operator: str, right: TypeId, span: SourceSpan) -> ResolvedBinary!:
        if not types_match(left, right):
            try self.fail(span, "`" + operator + "` has `" + self.describe_type(left) + "` on the left and `" + self.describe_type(right) + "` on the right")
        let boolean_type = resolve_builtin_type(BuiltinType.boolean)
        if operator == "and" or operator == "or":
            if not types_match(left, boolean_type): try self.fail(span, "`" + operator + "` requires `bool` operands")
            if operator == "and": return ResolvedBinary(operation = BinaryOperation.LogicalAnd, result = boolean_type)
            return ResolvedBinary(operation = BinaryOperation.LogicalOr, result = boolean_type)
        if operator == "==": return ResolvedBinary(operation = BinaryOperation.Equal(operand_type = left), result = boolean_type)
        if operator == "!=": return ResolvedBinary(operation = BinaryOperation.NotEqual(operand_type = left), result = boolean_type)
        if operator == "<" or operator == "<=" or operator == ">" or operator == ">=":
            if not is_ordered_type(self.types, left): try self.fail(span, "`" + operator + "` does not order `" + self.describe_type(left) + "`")
            if operator == "<": return ResolvedBinary(operation = BinaryOperation.Less(operand_type = left), result = boolean_type)
            if operator == "<=": return ResolvedBinary(operation = BinaryOperation.LessEqual(operand_type = left), result = boolean_type)
            if operator == ">": return ResolvedBinary(operation = BinaryOperation.Greater(operand_type = left), result = boolean_type)
            return ResolvedBinary(operation = BinaryOperation.GreaterEqual(operand_type = left), result = boolean_type)
        if operator == "/":
            if not is_floating_type(self.types, left): try self.fail(span, "`/` requires floating-point operands")
            return ResolvedBinary(operation = BinaryOperation.Divide(operand_type = left), result = left)
        if operator == "//" or operator == "%":
            if not is_integer_type(self.types, left): try self.fail(span, "`" + operator + "` requires integer operands")
            if operator == "//": return ResolvedBinary(operation = BinaryOperation.FloorDivide(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.Remainder(operand_type = left), result = left)
        if operator == "+" or operator == "-" or operator == "*":
            if not is_numeric_type(self.types, left): try self.fail(span, "`" + operator + "` requires numeric operands")
            if operator == "+": return ResolvedBinary(operation = BinaryOperation.Add(operand_type = left), result = left)
            if operator == "-": return ResolvedBinary(operation = BinaryOperation.Subtract(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.Multiply(operand_type = left), result = left)
        if operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>":
            if not is_integer_type(self.types, left): try self.fail(span, "`" + operator + "` requires integer operands")
            if operator == "&": return ResolvedBinary(operation = BinaryOperation.BitwiseAnd(operand_type = left), result = left)
            if operator == "|": return ResolvedBinary(operation = BinaryOperation.BitwiseOr(operand_type = left), result = left)
            if operator == "^": return ResolvedBinary(operation = BinaryOperation.BitwiseXor(operand_type = left), result = left)
            if operator == "<<": return ResolvedBinary(operation = BinaryOperation.ShiftLeft(operand_type = left), result = left)
            return ResolvedBinary(operation = BinaryOperation.ShiftRight(operand_type = left), result = left)
        error(self.diagnostic(span, "operator `" + operator + "` is not implemented yet"))

    # Check one call: each parameter must be supplied once.
    func check_call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan, expected: TypeId?) -> HirExpression!:
        if len(type_arguments) > 0: try self.fail(span, "generic calls are not implemented yet")
        let function_index = try self.resolve_callee(callee)
        let function = self.functions[function_index]

        # Positional arguments fill parameters left to right; named arguments
        # then land anywhere, but each parameter is supplied once.
        let assigned = list[bool]()
        for parameter in function.parameters: assigned.append(false)
        let typed_arguments = list[HirArgument]()
        var positional_index = 0
        var saw_named = false

        for argument in arguments:
            var parameter_index = -1
            let label = argument.label
            if label == none:
                if saw_named: try self.fail(argument.span, "positional arguments must precede named arguments")
                parameter_index = positional_index
                positional_index += 1
            else:
                saw_named = true
                parameter_index = find_parameter(function, label)
                if parameter_index < 0: try self.fail(argument.span, "function `" + function.name + "` has no parameter `" + label + "`")
            if parameter_index >= len(function.parameters):
                try self.fail(argument.span, "function `" + function.name + "` accepts " + str(len(function.parameters)) + " argument(s)")
            if assigned[parameter_index]:
                try self.fail(argument.span, "parameter `" + function.parameters[parameter_index].name + "` is supplied more than once")
            assigned[parameter_index] = true
            let checked = try self.check_expression(argument.value, function.parameters[parameter_index].value_type)
            typed_arguments.append(HirArgument(parameter_index = parameter_index, value = checked))

        for parameter_index in range(0, len(function.parameters)):
            if not assigned[parameter_index]:
                try self.fail(span, "call to `" + function.name + "` is missing argument `" + function.parameters[parameter_index].name + "`")
        let typed = HirExpression(
            value_type = function.result,
            form = HirExpressionForm.Call(function = function.symbol, arguments = typed_arguments),
            span = span,
        )
        return try self.require_type(typed, expected)

    # Find which function a callee spelling names: a bare `helper(...)`, or a
    # qualified `module.helper(...)` through an imported module.
    func resolve_callee(callee: ExpressionSyntax) -> i64!:
        match callee.form:
            Name(name):
                let local_index = self.find_local(name)
                if local_index >= 0:
                    try self.fail(callee.span, "`" + name + "` has type `" + self.describe_type(self.locals[local_index].value_type) + "` and is not callable")
                let function_index = self.find_visible_function(name)
                if function_index < 0: try self.fail(callee.span, "unknown function `" + name + "`")
                return function_index
            Member(value, name):
                var module_name = ""
                match value.form:
                    Name(candidate): module_name = candidate
                    else: try self.fail(callee.span, "method calls are not implemented yet")
                let imported_module = self.find_imported_module(module_name)
                if imported_module < 0: try self.fail(callee.span, "unknown imported module `" + module_name + "`")
                let function_index = self.find_function_in_module(imported_module, name)
                if function_index < 0: try self.fail(callee.span, "module `" + self.sources[imported_module].name + "` has no function `" + name + "`")
                if not self.functions[function_index].is_public:
                    try self.fail(callee.span, "`" + name + "` is private to module `" + self.sources[imported_module].name + "`")
                return function_index
            else:
                error(self.diagnostic(callee.span, "only named functions are callable in the current semantic slice"))

    func check_tuple(elements: list[ExpressionSyntax], span: SourceSpan, expected: TypeId?) -> HirExpression!:
        var expected_parts: list[TypeId]? = none
        if expected != none:
            expected_parts = self.tuple_elements(expected)
            if expected_parts != none and len(expected_parts) != len(elements):
                try self.fail(span, "tuple has " + str(len(elements)) + " element(s), expected `" + self.describe_type(expected) + "`")
        let checked = list[HirExpression]()
        var index = 0
        for element in elements:
            var part_expected: TypeId? = none
            if expected_parts != none:
                part_expected = expected_parts[index]
            checked.append(try self.check_expression(element, part_expected))
            index += 1
        let parts = list[TypeId]()
        for item in checked:
            parts.append(item.value_type)
        let tuple_type = self.intern_tuple(parts)
        return try self.require_type(
            HirExpression(value_type = tuple_type, form = HirExpressionForm.Tuple(elements = checked), span = span),
            expected,
        )

    func check_else(optional_value: ExpressionSyntax, arm: ExpressionSyntax, span: SourceSpan, expected: TypeId?) -> HirExpression!:
        let checked_optional = try self.check_expression(optional_value, none)
        let inner = self.optional_inner(checked_optional.value_type) else error(self.diagnostic(span, "`else` requires an optional value, found `" + self.describe_type(checked_optional.value_type) + "`"))
        let checked_arm = try self.check_expression(arm, inner)
        let typed = HirExpression(
            value_type = inner,
            form = HirExpressionForm.ElseFallback(value = checked_optional, arm = checked_arm),
            span = span,
        )
        return try self.require_type(typed, expected)

    # mark: Literal decoding ====================================================================
    #
    # The tokenizer keeps every literal's exact source spelling; here that
    # spelling becomes a value, with range failures reported at the token.

    func decode_integer(token: Token) -> i64!:
        let value = try self.decode_negative_integer(token)
        if value == -9223372036854775807 - 1:
            try self.fail(token.span, "integer literal is outside the representable integer range")
        return -value

    # Accumulating below zero leaves room for the minimum signed magnitude,
    # which positive i64 cannot represent.
    func decode_negative_integer(token: Token) -> i64!:
        let text_end = len(token.text) - len(token.suffix)
        var base = 10
        var position = 0
        if text_end >= 2 and token.text[0] == '0':
            match token.text[1]:
                'b', 'B': base = 2
                'o', 'O': base = 8
                'x', 'X': base = 16
                else: base = 10
            if base != 10: position = 2

        var value = 0
        while position < text_end:
            let c = token.text[position]
            if c != '_':
                let digit = decode_digit(c)
                let minimum = -9223372036854775807 - 1
                let numerator = minimum + digit
                var threshold = numerator // base
                if numerator % base != 0: threshold += 1
                if value < threshold:
                    try self.fail(token.span, "integer literal is outside the representable integer range")
                value = value * base - digit
            position += 1
        return value

    func decode_float(token: Token) -> f64!:
        let text_end = len(token.text) - len(token.suffix)
        var text = ""
        var position = 0
        while position < text_end:
            if token.text[position] != '_': text = text + str(token.text[position])
            position += 1
        return parse_f64(text) else error(self.diagnostic(token.span, "floating-point literal is outside `f64` range"))

    func decode_character(token: Token) -> char!:
        if len(token.text) < 3 or token.text[0] != '\'':
            try self.fail(token.span, "malformed character literal")
        if token.text[1] != '\\':
            if len(token.text) != 3: try self.fail(token.span, "character literal must contain one character")
            return token.text[1]
        if len(token.text) < 4: try self.fail(token.span, "incomplete character escape")
        match token.text[2]:
            'n': return '\n'
            'r': return '\r'
            't': return '\t'
            '\\': return '\\'
            '\'': return '\''
            '0': return char(0)
            else: error(self.diagnostic(token.span, "this character escape is not implemented yet"))

    func decode_bytes(token: Token) -> list[u8]!:
        if len(token.text) < 3 or token.text[0] != 'b':
            try self.fail(token.span, "malformed byte literal")
        let inner = Token(kind = TokenKind.str_lit, text = token.text[1:], suffix = "", span = token.span)
        let decoded = try self.decode_print_text(inner)
        let payload = list[u8]()
        for c in decoded:
            payload.append(u8(u32(c)))
        return payload

    # mark: Name lookup =========================================================================

    # A new local may not reuse a live name or hide an import.
    func require_free_local_name(name: str, span: SourceSpan) -> !:
        if self.find_local(name) >= 0:
            try self.fail(span, "`" + name + "` is already bound in this scope")
        if self.find_imported_function(name) >= 0 or self.find_imported_module(name) >= 0:
            try self.fail(span, "local `" + name + "` cannot shadow an imported name")

    # Innermost binding first, so a suite's binding wins over an outer one.
    func find_local(name: str) -> i64:
        var index = len(self.locals) - 1
        while index >= 0:
            if self.locals[index].name == name: return index
            index -= 1
        return -1

    # A bare name resolves to a selectively imported function first, then to a
    # declaration in the current module.
    func find_visible_function(name: str) -> i64:
        let imported = self.find_imported_function(name)
        if imported >= 0: return imported
        return self.find_function_in_module(self.current_module, name)

    func find_imported_function(name: str) -> i64:
        for imported in self.bindings.functions:
            if imported.name == name: return imported.function_index
        return -1

    func find_imported_module(name: str) -> i64:
        for imported in self.bindings.modules:
            if imported.name == name: return imported.module_index
        return -1

    func find_function_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.functions)):
            if self.functions[index].module_index == module_index and self.functions[index].name == name: return index
        return -1

    func find_alias_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.aliases)):
            if self.aliases[index].module_index == module_index and self.aliases[index].name == name: return index
        return -1

    func find_constant_in_module(module_index: i64, name: str) -> i64:
        for index in range(0, len(self.constants)):
            if self.constants[index].module_index == module_index and self.constants[index].name == name: return index
        return -1

    # Intern by `TypeForm`. The diagnostic `name` is stored for messages; two
    # forms that describe the same structure share one TypeId.
    func intern_named(name: str, form: TypeForm) -> TypeId:
        for existing in self.types.definitions:
            if type_forms_match(existing.form, form): return existing.id
        let id = TypeId(value = len(self.types.definitions))
        self.types.definitions.append(TypeDefinition(id = id, name = name, form = form))
        return id

    func intern_optional(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "?", TypeForm.Optional(value = inner))

    func intern_fallible(inner: TypeId) -> TypeId:
        return self.intern_named(self.describe_type(inner) + "!", TypeForm.Fallible(value = inner))

    func intern_slice(inner: TypeId) -> TypeId:
        return self.intern_named("slice[" + self.describe_type(inner) + "]", TypeForm.Slice(element = inner))

    func intern_tuple(elements: list[TypeId]) -> TypeId:
        var name = "("
        var index = 0
        for element in elements:
            if index > 0: name = name + ", "
            name = name + self.describe_type(element)
            index += 1
        return self.intern_named(name + ")", TypeForm.Tuple(elements = elements))

    func intern_function_type(parameters: list[TypeId], result: TypeId) -> TypeId:
        var name = "func("
        var index = 0
        for parameter in parameters:
            if index > 0: name = name + ", "
            name = name + self.describe_type(parameter)
            index += 1
        return self.intern_named(name + ") -> " + self.describe_type(result), TypeForm.Function(parameters = parameters, result = result))

    func optional_inner(value: TypeId) -> TypeId?:
        if value.value < 0 or value.value >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Optional(inner): return inner
            else: return none

    func tuple_elements(value: TypeId) -> list[TypeId]?:
        if value.value < 0 or value.value >= len(self.types.definitions): return none
        match self.types.definitions[value.value].form:
            Tuple(elements): return elements
            else: return none

    func find_source(name: str) -> i64:
        for index in range(0, len(self.sources)):
            if self.sources[index].name == name: return index
        return -1

    # Allocate one program-wide identity and record the declaration metadata
    # that diagnostics, tooling, and later analysis can query by that identity.
    func make_symbol(name: str, kind: SymbolKind, value_type: TypeId) -> SymbolId:
        let symbol = SymbolId(value = self.next_symbol)
        self.next_symbol += 1
        self.symbols.append(HirSymbol(id = symbol, name = name, kind = kind, value_type = value_type))
        return symbol

    # mark: Diagnostics =========================================================================

    # The one gate every checked expression passes: its type must satisfy the
    # context that asked for it.
    func require_type(value: HirExpression, expected: TypeId?) -> HirExpression!:
        if expected == none: return value
        if types_match(value.value_type, expected): return value
        let inner = self.optional_inner(expected)
        if inner != none and types_match(value.value_type, inner):
            return HirExpression(
                value_type = expected,
                form = HirExpressionForm.Some(value = value),
                span = value.span,
            )
        error(self.diagnostic(value.span, "expected `" + self.describe_type(expected) + "`, found `" + self.describe_type(value.value_type) + "`"))

    # Render a TypeId only when producing a diagnostic. Semantic decisions use
    # identity and type forms, never this human-readable spelling.
    func describe_type(value: TypeId) -> str:
        return describe_type(self.types, value)

    # `path:line:column: message` for the current module, or a chosen one.
    func diagnostic(span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[self.current_module].path, span, message)

    func diagnostic_at(module_index: i64, span: SourceSpan, message: str) -> str:
        return format_diagnostic(self.sources[module_index].path, span, message)

    func fail(span: SourceSpan, message: str) -> !:
        error(self.diagnostic(span, message))

    func fail_at(module_index: i64, span: SourceSpan, message: str) -> !:
        error(self.diagnostic_at(module_index, span, message))


# mark: Type and operator tables ==============================================================

func find_literal_token(value: ExpressionSyntax) -> Token?:
    match value.form:
        Literal(token): return token
        else: return none

# Report whether an integer expression still needs a type from its context.
# Examples: `5`, `-5`, and `(5)` qualify; `5i64` and `count` do not.
func is_contextual_integer_expression(value: ExpressionSyntax) -> bool:
    match value.form:
        Literal(token): return token.kind == TokenKind.int_lit and token.suffix == ""
        Group(grouped): return is_contextual_integer_expression(grouped)
        Unary(operator, operand):
            return (operator == "+" or operator == "-") and is_contextual_integer_expression(operand)
        else: return false

func find_parameter(function: FunctionSymbol, name: str) -> i64:
    for index in range(0, len(function.parameters)):
        if function.parameters[index].name == name: return index
    return -1

# Conservative: a function definitely returns only when its statement list
# reaches a `return`, or an `if` whose every branch and fallback do.
func statements_return(statements: list[HirStatement]) -> bool:
    for statement in statements:
        match statement.form:
            ReturnStatement(value): return true
            IfStatement(branches, fallback):
                if fallback != none:
                    var every_branch_returns = true
                    for branch in branches:
                        if not statements_return(branch.body): every_branch_returns = false
                    if every_branch_returns and statements_return(fallback): return true
            else: continue
    return false

func is_arithmetic_operator(operator: str) -> bool:
    return match operator:
        "+", "-", "*", "/", "//", "%" => true
        "&", "|", "^", "<<", ">>" => true
        else => false

# The one implemented-name table. `resolve_type` uses this both to decide
# "not implemented yet" and to obtain the canonical TypeId, so the two cannot
# drift.
func builtin_type_id(name: str) -> TypeId?:
    return match name:
        "unit" => resolve_builtin_type(BuiltinType.unit)
        "bool" => resolve_builtin_type(BuiltinType.boolean)
        "i8" => resolve_builtin_type(BuiltinType.signed_i8)
        "i16" => resolve_builtin_type(BuiltinType.signed_i16)
        "i32" => resolve_builtin_type(BuiltinType.signed_i32)
        "i64" => resolve_builtin_type(BuiltinType.signed_i64)
        "u8" => resolve_builtin_type(BuiltinType.unsigned_u8)
        "u16" => resolve_builtin_type(BuiltinType.unsigned_u16)
        "u32" => resolve_builtin_type(BuiltinType.unsigned_u32)
        "u64" => resolve_builtin_type(BuiltinType.unsigned_u64)
        "f32" => resolve_builtin_type(BuiltinType.float32)
        "f64" => resolve_builtin_type(BuiltinType.float64)
        "char" => resolve_builtin_type(BuiltinType.character)
        "str" => resolve_builtin_type(BuiltinType.string)
        "bytes" => resolve_builtin_type(BuiltinType.byte_string)
        else => none

func decode_digit(c: char) -> i64:
    let code = u32(c)
    if c <= '9': return i64(code - u32('0'))
    if c <= 'F': return i64(code - u32('A')) + 10
    return i64(code - u32('a')) + 10
