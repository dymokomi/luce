#==============================================================================================
#
#   profile - The two language profiles and what each one admits
#
#   DESCRIPTION:
#       One compiler serves two spellings of Luce: full Luce, whose classes,
#       collections, closures, workers, and existential interface values are
#       implemented by the Luce runtime, and Luce Base, the C-like profile
#       that needs no runtime (docs/language/base.md). The profile is selected
#       by the module suffix and is the only fact the shared stages consult
#       when deciding what a module may say.
#
#       This file is the single place that names a profile inside the shared
#       frontend, HIR, MIR, and backend folders. Code that only one profile
#       executes lives in `profiles/full/` or `profiles/base/`; each shared
#       stage reaches it through one dispatch point (`hir/body_checker`,
#       `mir/function_lowerer`, the two interpreters, each backend). The
#       folder rules are checked by `test.sh`.
#
#       Admission is stated over the existing structural keys
#       (`type_form_key`, `mir_type_key`) so no second vocabulary table
#       exists. Token and node-form admission arrive with the Base profile
#       (plan.md §5.1, B1), when the tokenizer and checker first consult them.
#       Owned text and byte buffers stay shared here: `str` becomes a view in
#       Base with B2, and that slice decides their placement.
#
#==============================================================================================

from compiler.hir.ir import ModuleAuthority
import std.strings

## The two profiles of one compiler. A module belongs to exactly one.
pub enum Profile:
    full
    base

## The suffix that selects a profile. A `.lucb` module is Base; every other
## Luce module, including the audited native tier, is full Luce.
pub func profile_for_path(path: str) -> Profile:
    if has_suffix(path, ".lucb"): return Profile.base
    return Profile.full

## The profile a module kind belongs to: only `.lucb` modules are Base.
pub func profile_of(authority: ModuleAuthority) -> Profile:
    match authority:
        base: return Profile.base
        else: return Profile.full

## The name a diagnostic uses when a construct belongs to the other profile.
pub func profile_name(profile: Profile) -> str:
    match profile:
        full: return "full Luce"
        base: return "Luce Base"

## The diagnostic for a construct a Base module spelled but only full Luce
## has: it names the construct and the tier it belongs to (base.md §3.6).
pub func belongs_to_full_luce(construct: str, reason: str) -> str:
    return construct + " belongs to full Luce; a Luce Base module " + reason

## Reserved words that only full Luce spells. Base rejects each of them with
## a diagnostic naming the tier it belongs to (base.md §3.6).
pub func full_only_reserved_words() -> list[str]:
    return ["class", "spawn", "weak"]

## Reserved words only Luce Base spells (base.md §3.6); in a full-Luce module
## they are ordinary names.
pub func base_only_reserved_words() -> list[str]:
    return ["alloc", "asm", "const", "errdefer", "free", "goto", "static", "thread_local", "union", "volatile", "with"]

## Operator and marker spellings only Luce Base has, longest first so the
## lexer matches `+%=` before `+%` (base.md §21).
pub func base_only_symbols() -> list[str]:
    return ["+%=", "-%=", "*%=", "+|=", "-|=", "*|=", "---", "...", "+%", "-%", "*%", "+|", "-|", "*|", "+?", "-?", "*?", "@"]

# mark: Grammar admission =====================================================================

## The spellings one parser admits by profile (plan.md §6: one grammar,
## every profile-only token admitted here, never by a second grammar).
## Each case names a production or lookahead; the parser asks
## `admits_grammar` and never compares profiles itself.
pub enum GrammarFeature:
    ## Base's own reserved words and operator spellings in the lexer.
    base_words
    base_symbols
    ## `inline`, `cold`, `used`, `section("...")` before a declaration (base.md §9.8).
    attributes
    ## `packed struct`, `align(N) struct`, `align(N)` on a field (§5.11).
    layout_words
    ## `export func` without the ABI word (§17.6); full Luce writes `export c`.
    export_func
    ## `extern func name as "symbol"` (§17.1).
    extern_symbol
    ## `...` closing an extern parameter list (§17.2).
    variadic_extern
    ## `with allocator:` (§12.3) and `free(x)` (§12.2).
    with_statement
    free_statement
    ## `var x: T` with no initialiser (§6.1) and `= ---` (§6.2).
    zero_binding
    uninitialised_binding
    ## `name:` before a loop, and `break name` (§8.5).
    loop_labels
    ## `pattern if condition:` on a match arm (§8.4).
    match_guards
    ## `@T` (§5.9).
    atomic_types
    ## `u8[](pointer, count)` (§5.4).
    span_construct
    ## `new` and `alloc` as allocation (§12.2); full Luce's `new` builds a class.
    allocation
    ## `enum Name as u32:` (§10.3).
    integer_enums
    ## `T[N]` and `T[]` after a type (§5.4).
    array_suffix
    ## `(u8)value` (§7.5).
    scalar_casts

pub func admits_grammar(profile: Profile, feature: GrammarFeature) -> bool:
    match profile:
        full: return false
        base: return true

# mark: Construct admission ==================================================================

## Language constructs that only one profile has. The checker and the
## declaration collector ask `admits_construct` and, when the answer is no,
## report `construct_diagnostic`; neither names a profile itself.
pub enum Construct:
    # Base only
    errdefer
    pointer_deref
    address_of
    span_construct
    span_type
    pointer_type
    atomic_type
    free_statement
    with_statement
    scalar_cast
    thread_local
    pointer_width_integer
    ## A plain struct that crosses a C boundary as a record (base.md §17.6).
    c_record_struct
    ## `for x in items` over a fixed array, by value (base.md §8.3).
    array_iteration
    ## An exported fallible function, in C's status form (base.md §17.6).
    fallible_export
    ## A function pointer in an exported signature (base.md §17.6).
    function_pointer_export
    # full Luce only
    map_literal
    list_literal
    block_closure
    capturing_lambda
    class_new
    class_declaration
    spawn_expression
    collection_constructor
    weak_reference
    wait_all
    runtime_type

pub func admits_construct(profile: Profile, construct: Construct) -> bool:
    match profile:
        base: return not is_full_only_construct(construct)
        full: return is_full_only_construct(construct)

## The same question asked of a module by its authority.
pub func module_admits(authority: ModuleAuthority, construct: Construct) -> bool:
    return admits_construct(profile_of(authority), construct)

## Whether a module may import another: a Luce Base module imports only
## Base modules and C (base.md §16.2); full Luce imports anything.
pub func admits_import(importer: ModuleAuthority, imported: ModuleAuthority) -> bool:
    match profile_of(importer):
        base: return profile_of(imported) == Profile.base
        full: return true

func is_full_only_construct(construct: Construct) -> bool:
    match construct:
        map_literal: return true
        list_literal: return true
        block_closure: return true
        capturing_lambda: return true
        class_new: return true
        class_declaration: return true
        spawn_expression: return true
        collection_constructor: return true
        weak_reference: return true
        wait_all: return true
        runtime_type: return true
        else: return false

## The diagnostic for a construct the current profile does not admit.
## `subject` is the spelling the message names when it varies (an operator,
## a type name); it is empty when the message is fixed.
pub func construct_diagnostic(construct: Construct, subject: str) -> str:
    match construct:
        errdefer: return "`errdefer` belongs to Luce Base; a `.luc` module recovers with `catch` (base.md §8.8)"
        pointer_deref: return "`*` on a value belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)"
        address_of: return "`" + subject + "` on a value belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)"
        span_construct: return "`T[](pointer, count)` belongs to Luce Base; a `.luc` module has no spans (base.md §5.4)"
        span_type: return "`T[]` belongs to Luce Base; a `.luc` module spells `slice[T]` (base.md §5.4)"
        pointer_type: return "`T*` belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)"
        atomic_type: return "`@T` belongs to Luce Base; a `.luc` module has no atomics (base.md §5.9)"
        free_statement: return "`free` belongs to Luce Base; a `.luc` module has no allocators (base.md §12.2)"
        with_statement: return "`with` belongs to Luce Base; a `.luc` module has no allocators (base.md §12.3)"
        scalar_cast: return "a `(T)x` cast belongs to Luce Base; a `.luc` module spells the checked conversion `T(x)` (base.md §7.5)"
        thread_local: return "`thread_local` belongs to Luce Base (base.md §6.3)"
        pointer_width_integer: return "`" + subject + "` belongs to Luce Base; a `.luc` module spells the integer width, and a `.lucb` module's `" + subject + "` is the target's pointer width (base.md §5.1)"
        c_record_struct: return "a struct crosses a C boundary as a record only from a Luce Base module (base.md §17.6)"
        array_iteration: return "iterating a fixed array by value belongs to Luce Base; a `.luc` module iterates a list or a slice (base.md §8.3)"
        fallible_export: return "an exported C function cannot be fallible"
        function_pointer_export: return "a function pointer in an exported C signature belongs to Luce Base (base.md §17.6)"
        map_literal: return belongs_to_full_luce("a map literal", "has no built-in collections (base.md §12.1)")
        list_literal: return belongs_to_full_luce("a list literal", "has no built-in collections; a Base `[...]` is a fixed array and needs its array type from context (base.md §4.5)")
        block_closure: return belongs_to_full_luce("a block closure", "has no closures (base.md §9.6)")
        capturing_lambda: return belongs_to_full_luce("a lambda that captures a local", "converts only capture-free lambdas to function pointers (base.md §9.6)")
        class_new: return belongs_to_full_luce("`new` of a class", "has no classes; Base `new` allocates from an allocator (base.md §12.2)")
        class_declaration: return belongs_to_full_luce("`class`", "has no classes; use a struct, and a pointer where identity is needed (base.md §23)")
        spawn_expression: return belongs_to_full_luce("`spawn`", "has no workers; threads are the `thread` module (base.md §15.3)")
        collection_constructor: return belongs_to_full_luce("`" + subject + "`", "has no built-in collections (base.md §12.1)")
        weak_reference: return belongs_to_full_luce("`Weak`", "has no reference counting (base.md §23)")
        wait_all: return belongs_to_full_luce("`wait_all`", "has no workers (base.md §15.3)")
        runtime_type: return belongs_to_full_luce("`" + subject + "`", "has no built-in collections, workers, or reference counting (base.md §23)")

# mark: Type admission ========================================================================

## The type names only a Luce Base module resolves: the pointer-width
## integers whose width the backend chooses (base.md §5.1).
pub func base_only_type_names() -> list[str]:
    return ["usize", "isize"]

## Whether `name` is one of the Base-only type names.
pub func is_base_only_type_name(name: str) -> bool:
    return contains(base_only_type_names(), name)

## Type-form families (the text before `:` of a `type_form_key`) that only
## full Luce admits: runtime-owned collections and their views, structured
## task handles, weak class references, and nominal classes.
pub func full_only_type_families() -> list[str]:
    return ["slice", "mutable_slice", "list", "map", "set", "frozen_list", "frozen_map", "frozen_set", "task", "weak", "class"]

## Canonical MIR type families (the text before `:` of a `mir_type_key`)
## that only full Luce admits: the managed handles the runtime implements.
pub func full_only_mir_type_families() -> list[str]:
    return ["list", "frozen_list", "map", "set", "frozen_map", "frozen_set", "slice", "mutable_slice", "task", "task_group", "class", "weak_class", "interface", "cell"]

## Whether `profile` admits a HIR type whose structural key is `key`.
pub func admits_type_form(profile: Profile, key: str) -> bool:
    match profile:
        full: return true
        base: return not contains(full_only_type_families(), key_family(key))

## Whether `profile` admits a canonical MIR type whose key is `key`.
pub func admits_mir_type(profile: Profile, key: str) -> bool:
    match profile:
        full: return true
        base: return not contains(full_only_mir_type_families(), key_family(key))

# mark: Key helpers ===========================================================================

# The family of a structural key: `list:7` is `list`, `bool` is `bool`.
func key_family(key: str) -> str:
    let separator = strings.find(key, ":") else len(key)
    return key[0:separator]

func contains(items: list[str], item: str) -> bool:
    for candidate in items:
        if candidate == item: return true
    return false

func has_suffix(text: str, suffix: str) -> bool:
    if len(text) < len(suffix): return false
    return text[len(text) - len(suffix):] == suffix
