#==============================================================================================
#
#   profile - The two language profiles and what each one admits
#
#   DESCRIPTION:
#       One compiler serves two spellings of Luce: full Luce, whose classes,
#       collections, closures, workers, and existential interface values are
#       implemented by the Luce runtime, and Luce Base, the C-like profile
#       that needs no runtime (docs/language/base.md). The profile is selected
#       by the module suffix and is the only fact the shared stages consult
#       when deciding what a module may say.
#
#       This file is the single place that names a profile inside the shared
#       frontend, HIR, MIR, and backend folders. Code that only one profile
#       executes lives in `profiles/full/` or `profiles/base/`; each shared
#       stage reaches it through one dispatch point (`hir/body_checker`,
#       `mir/function_lowerer`, the two interpreters, each backend). The
#       folder rules are checked by `test.sh`.
#
#       Admission is stated over the existing structural keys
#       (`type_form_key`, `mir_type_key`) so no second vocabulary table
#       exists. Token and node-form admission arrive with the Base profile
#       (plan.md §5.1, B1), when the tokenizer and checker first consult them.
#       Owned text and byte buffers stay shared here: `str` becomes a view in
#       Base with B2, and that slice decides their placement.
#
#==============================================================================================

import std.strings

## The two profiles of one compiler. A module belongs to exactly one.
pub enum Profile:
    full
    base

## The suffix that selects a profile. A `.lucb` module is Base; every other
## Luce module, including the audited native tier, is full Luce.
pub func profile_for_path(path: str) -> Profile:
    if has_suffix(path, ".lucb"): return Profile.base
    return Profile.full

## The name a diagnostic uses when a construct belongs to the other profile.
pub func profile_name(profile: Profile) -> str:
    match profile:
        full: return "full Luce"
        base: return "Luce Base"

## Reserved words that only full Luce spells. Base rejects each of them with
## a diagnostic naming the tier it belongs to (base.md §3.6).
pub func full_only_reserved_words() -> list[str]:
    return ["class", "spawn", "weak"]

# mark: Type admission ========================================================================

## Type-form families (the text before `:` of a `type_form_key`) that only
## full Luce admits: runtime-owned collections and their views, structured
## task handles, weak class references, and nominal classes.
pub func full_only_type_families() -> list[str]:
    return ["slice", "mutable_slice", "list", "map", "set", "frozen_list", "frozen_map", "frozen_set", "task", "weak", "class"]

## Canonical MIR type families (the text before `:` of a `mir_type_key`)
## that only full Luce admits: the managed handles the runtime implements.
pub func full_only_mir_type_families() -> list[str]:
    return ["list", "frozen_list", "map", "set", "frozen_map", "frozen_set", "slice", "mutable_slice", "task", "task_group", "class", "weak_class", "interface", "cell"]

## Whether `profile` admits a HIR type whose structural key is `key`.
pub func admits_type_form(profile: Profile, key: str) -> bool:
    match profile:
        full: return true
        base: return not contains(full_only_type_families(), key_family(key))

## Whether `profile` admits a canonical MIR type whose key is `key`.
pub func admits_mir_type(profile: Profile, key: str) -> bool:
    match profile:
        full: return true
        base: return not contains(full_only_mir_type_families(), key_family(key))

# mark: Key helpers ===========================================================================

# The family of a structural key: `list:7` is `list`, `bool` is `bool`.
func key_family(key: str) -> str:
    let separator = strings.find(key, ":") else len(key)
    return key[0:separator]

func contains(items: list[str], item: str) -> bool:
    for candidate in items:
        if candidate == item: return true
    return false

func has_suffix(text: str, suffix: str) -> bool:
    if len(text) < len(suffix): return false
    return text[len(text) - len(suffix):] == suffix
