#==============================================================================================
#
#   mir_verifier - Structural and type checks for canonical MIR
#
#   DESCRIPTION:
#       Proves the invariants every optimizer and compiled backend may rely on.
#       Verification belongs to canonical MIR, not to a particular target, so
#       the same malformed program fails before WASM, ARM64, or x86-64 sees it.
#
#       The current MIR is a typed stack instruction stream. The verifier
#       simulates that stack, checks arithmetic operands, requires one return
#       value of the declared type, and rejects missing or trailing returns.
#       As canonical MIR gains blocks, values, and control-flow edges, their
#       dominance and type rules will grow here.
#
#       Example:
#
#       I64Constant(2), I64Constant(3), I64Add, Return  -> valid `i64`
#       I32Constant(2), I64Constant(3), I64Add, Return  -> type error
#
#==============================================================================================

from compiler.canonical_ir import CanonicalFunction, CanonicalProgram, CanonicalType, describe_canonical_type

## Verifies one complete canonical program before it crosses a pipeline
## boundary. Calling `verify` again after optimization checks that transforms
## preserved the same invariants.
pub class MirVerifier:
    program: CanonicalProgram

    ## Prepare to verify one canonical program without changing it.
    pub init(program: CanonicalProgram):
        self.program = program

    # mark: Verification =======================================================================

    ## Verify function identities and every function instruction stream.
    pub func verify() -> !:
        try self.verify_unique_function_names()
        for function in self.program.functions:
            try self.verify_function(function)

    # A canonical name identifies exactly one function in the whole program;
    # for example, two functions named `math.sum` would make backend exports
    # and future call targets ambiguous.
    func verify_unique_function_names() -> !:
        for index in range(0, len(self.program.functions)):
            let function = self.program.functions[index]
            for previous in range(0, index):
                if self.program.functions[previous].name == function.name:
                    error("MIR verifier: duplicate function `" + function.name + "`")

    # Simulate one function's value stack from its first instruction through
    # its return. `WriteText` is an effect and leaves the value stack alone.
    func verify_function(function: CanonicalFunction) -> !:
        let value_stack = list[CanonicalType]()
        var returned = false
        for instruction in function.instructions:
            if returned:
                try self.fail(function, "instruction follows `Return`")

            match instruction:
                I32Constant(value): value_stack.append(CanonicalType.signed_i32)
                I64Constant(value): value_stack.append(CanonicalType.signed_i64)
                I64Add: try self.verify_i64_binary(function, value_stack, "I64Add")
                I64Subtract: try self.verify_i64_binary(function, value_stack, "I64Subtract")
                I64Multiply: try self.verify_i64_binary(function, value_stack, "I64Multiply")
                WriteText(value): continue
                Return:
                    try self.verify_return(function, value_stack)
                    returned = true

        if not returned:
            try self.fail(function, "missing `Return`")

    # Pop two `i64` operands and push their `i64` result. For example,
    # `[i64, i64] I64Add` becomes `[i64]`; `[i32, i64]` is invalid.
    func verify_i64_binary(function: CanonicalFunction, value_stack: list[CanonicalType], operation: str) -> !:
        if len(value_stack) < 2:
            try self.fail(function, "`" + operation + "` needs two `i64` operands")
        let right = value_stack[len(value_stack) - 1]
        let left = value_stack[len(value_stack) - 2]
        if left != CanonicalType.signed_i64 or right != CanonicalType.signed_i64:
            try self.fail(function, "`" + operation + "` needs two `i64` operands, found `" + describe_canonical_type(left) + "` and `" + describe_canonical_type(right) + "`")
        value_stack.remove(len(value_stack) - 1)
        value_stack.remove(len(value_stack) - 1)
        value_stack.append(CanonicalType.signed_i64)

    # A return consumes exactly one value of the function's declared type.
    # For example, an `i32` function must reach `Return` with stack `[i32]`.
    func verify_return(function: CanonicalFunction, value_stack: list[CanonicalType]) -> !:
        if len(value_stack) != 1:
            try self.fail(function, "`Return` needs exactly one value, found " + str(len(value_stack)))
        let returned_type = value_stack[len(value_stack) - 1]
        if returned_type != function.result:
            try self.fail(function, "`Return` has `" + describe_canonical_type(returned_type) + "`, expected `" + describe_canonical_type(function.result) + "`")
        value_stack.remove(len(value_stack) - 1)

    # Prefix every invariant failure with the stage and canonical function, so
    # a diagnostic still identifies its origin after source syntax is gone.
    func fail(function: CanonicalFunction, message: str) -> !:
        error("MIR verifier: `" + function.name + "`: " + message)
