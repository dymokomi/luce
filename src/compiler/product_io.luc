#==============================================================================================
#
#   product_io - Atomic installation of compiler text products
#
#   DESCRIPTION:
#       Owns the filesystem transaction shared by generated headers, reports,
#       FIIR, and binding source. Rendering stays pure; a complete candidate is
#       written inside an owner-only sibling directory and installed by one
#       same-filesystem rename.
#
#==============================================================================================

import std.files
import std.paths

# mark: Text products ==========================================================================

## Atomically replace one text product. A failed write or rename preserves the
## previous destination, and every failure attempts to remove owned scratch.
pub func install_text_atomically(output: str, contents: str, description: str) -> !:
    if output == "": error(description + ": output path cannot be empty")
    let scratch = files.make_temporary_directory(paths.dir(output), ".luce-product-") catch reason:
        error(description + ": cannot create scratch directory: " + reason)
    let candidate = paths.join(scratch, "artifact")
    files.write(candidate, contents) catch reason:
        error(failure_after_cleanup(scratch, description + ": cannot write candidate: " + reason))
    files.rename(candidate, output) catch reason:
        error(failure_after_cleanup(scratch, description + ": cannot install `" + output + "`: " + reason))
    files.remove_all(scratch) catch reason:
        error(description + ": installed `" + output + "` but cannot remove scratch `" + scratch + "`: " + reason)

func failure_after_cleanup(scratch: str, reason: str) -> str:
    files.remove_all(scratch) catch cleanup_reason:
        return reason + "; cannot remove scratch `" + scratch + "`: " + cleanup_reason
    return reason
