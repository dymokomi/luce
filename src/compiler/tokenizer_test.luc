from compiler.tokenizer import Tokenizer, Token, TokenKind

func lex(source: str) -> list[Token]:
    let t = Tokenizer(source)
    let tokens = t.tokenize() catch reason:
        return list[Token]()
    return tokens

func fails(source: str) -> bool:
    let t = Tokenizer(source)
    let tokens = t.tokenize() catch reason:
        return true
    return false

func test_keywords_are_distinct_from_names():
    let tokens = lex("func foo")
    assert(tokens[0].kind == TokenKind.keyword)
    assert(tokens[0].text == "func")
    assert(tokens[1].kind == TokenKind.name)
    assert(tokens[1].text == "foo")

func test_a_block_opens_with_indent_and_closes_with_dedent():
    let tokens = lex("if a:\n    b\n")
    var indents = 0
    var dedents = 0
    for t in tokens:
        if t.kind == TokenKind.indent:
            indents += 1
        if t.kind == TokenKind.dedent:
            dedents += 1
    assert(indents == 1)
    assert(dedents == 1)
    assert(tokens[len(tokens) - 1].kind == TokenKind.eof)

func test_numbers_split_into_int_and_float():
    let tokens = lex("42 0xff 1_000.25 6.0e2")
    assert(tokens[0].kind == TokenKind.int_lit)
    assert(tokens[1].kind == TokenKind.int_lit)
    assert(tokens[1].text == "0xff")
    assert(tokens[2].kind == TokenKind.float_lit)
    assert(tokens[3].kind == TokenKind.float_lit)

func test_operators_match_the_longest_run():
    let tokens = lex("a -> b == c")
    assert(tokens[1].text == "->")
    assert(tokens[3].text == "==")

func test_brackets_suspend_layout():
    let tokens = lex("x = [\n    1,\n    2,\n]\n")
    for t in tokens:
        assert(t.kind != TokenKind.indent)
        assert(t.kind != TokenKind.dedent)

func test_string_and_char_literals():
    let tokens = lex("\"hi\" 'a'")
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].text == "\"hi\"")
    assert(tokens[1].kind == TokenKind.char_lit)

func test_comment_only_lines_produce_no_tokens():
    let tokens = lex("# just a comment\nx\n")
    assert(tokens[0].kind == TokenKind.name)
    assert(tokens[0].text == "x")
    assert(tokens[0].line == 2)

func test_unterminated_string_is_rejected():
    assert(fails("\"oops"))
    assert(not fails("\"fine\""))

func test_tabs_in_indentation_are_rejected():
    assert(fails("if a:\n\tb\n"))
