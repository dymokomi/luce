from compiler.tokenizer import Tokenizer, Token, TokenKind

# Stage-0 0.19 discovers zero-argument `test_*` functions. Epoch 1 replaces
# this bootstrap convention with `test "description":` declarations.

# mark: Test helpers ---------------------------------------------------------

# Tokenize successful fixtures. Returning an empty list makes an unexpected
# tokenizer failure turn into an ordinary assertion/index failure in the test.
func lex(source: str) -> list[Token]:
    let tokenizer = Tokenizer(source)
    let tokens = tokenizer.tokenize() catch reason:
        return list[Token]()
    return tokens

# Return the stable diagnostic for a rejected fixture, or an empty string when
# the fixture unexpectedly succeeds.
func failure(source: str) -> str:
    let tokenizer = Tokenizer(source)
    let tokens = tokenizer.tokenize() catch reason:
        return reason
    return ""

func fails(source: str) -> bool:
    return len(failure(source)) > 0

func count_kind(tokens: list[Token], kind: TokenKind) -> i64:
    var count = 0
    for token in tokens:
        if token.kind == kind:
            count += 1
    return count

func assert_token(token: Token, kind: TokenKind, text: str, line: i64, column: i64):
    assert(token.kind == kind)
    assert(token.text == text)
    assert(token.line == line)
    assert(token.column == column)


# mark: Basic tokens and names ----------------------------------------------

# Verifies that an empty module has no synthetic logical line and ends with one
# EOF token at the initial source position.
func test_empty_source_emits_only_eof():
    let tokens = lex("")
    assert(len(tokens) == 1)
    assert_token(tokens[0], TokenKind.eof, "", 1, 1)

# Verifies token start positions and the synthetic NEWLINE inserted when a
# non-empty final logical line has no physical line ending.
func test_token_positions_and_synthetic_newline():
    let tokens = lex("alpha + 20")
    assert_token(tokens[0], TokenKind.name, "alpha", 1, 1)
    assert_token(tokens[1], TokenKind.symbol, "+", 1, 7)
    assert_token(tokens[2], TokenKind.int_lit, "20", 1, 9)
    assert_token(tokens[3], TokenKind.newline, "", 1, 11)
    assert_token(tokens[4], TokenKind.eof, "", 1, 11)

# Verifies the complete 41-word epoch-1 reserved set from specification section
# 29.5, including words that the original tokenizer omitted.
func test_all_epoch_one_reserved_words_are_keywords():
    let source = "and as break catch class continue defer elif else enum export false for func if implements import in interface is let match mutating new none not or public recover return self spawn struct test true try type uses var weak while"
    let tokens = lex(source)
    assert(len(tokens) == 43)
    var i = 0
    while i < 41:
        assert(tokens[i].kind == TokenKind.keyword)
        i += 1
    assert(tokens[0].text == "and")
    assert(tokens[40].text == "while")

# Verifies that contextual words and words deliberately removed from epoch 1
# remain ordinary identifiers rather than silently expanding the keyword set.
func test_contextual_and_removed_words_remain_names():
    let tokens = lex("c cpp copy init deinit bool files private static const alias extern union f r b")
    var i = 0
    while i < 16:
        assert(tokens[i].kind == TokenKind.name)
        i += 1

# Verifies ASCII identifier continuation rules and the standalone underscore
# catch-all token used by match patterns.
func test_names_allow_digits_and_underscores_after_the_first_letter():
    let tokens = lex("snake_case2 HttpClient _")
    assert_token(tokens[0], TokenKind.name, "snake_case2", 1, 1)
    assert_token(tokens[1], TokenKind.name, "HttpClient", 1, 13)
    assert_token(tokens[2], TokenKind.symbol, "_", 1, 24)

# mark: Layout and line handling --------------------------------------------

# Verifies nested four-space blocks, multi-level dedentation, and automatic block
# closure at end of source.
func test_layout_opens_and_closes_nested_blocks():
    let tokens = lex("if a:\n    if b:\n        c\nd")
    assert(count_kind(tokens, TokenKind.indent) == 2)
    assert(count_kind(tokens, TokenKind.dedent) == 2)
    assert(count_kind(tokens, TokenKind.newline) == 4)
    assert(tokens[len(tokens) - 1].kind == TokenKind.eof)

# Verifies a one-statement suite remains on its physical line and therefore does
# not manufacture indentation tokens around the statement after the colon.
func test_inline_suites_do_not_create_layout_tokens():
    let tokens = lex("if ready: return value\nelse: return none\n")
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 2)
    assert_token(tokens[2], TokenKind.symbol, ":", 1, 9)
    assert_token(tokens[3], TokenKind.keyword, "return", 1, 11)

# Verifies that blank lines plus ordinary/documentation comment-only lines do
# not create layout tokens or alter the surrounding indentation level.
func test_blank_and_comment_only_lines_do_not_affect_layout():
    let source = "if ready:\n    first\n      \n    # ordinary\n\n    ## documentation\n    second\nafter\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)
    assert_token(tokens[7], TokenKind.name, "second", 7, 5)
    assert_token(tokens[9], TokenKind.dedent, "", 8, 1)

# Verifies both illegal indentation transitions: a block may only grow by four
# spaces and every dedent must land on an existing four-space boundary.
func test_invalid_indentation_transitions_are_rejected():
    assert(fails("if a:\n  b\n"))
    assert(fails("if a:\n    b\n      c\n"))
    assert(fails("if a:\n    if b:\n        c\n  d\n"))

# Verifies the source-wide tab ban in indentation, between tokens, comments, and
# literal text; escaped backslash-t remains valid source.
func test_raw_tabs_are_rejected_everywhere():
    assert(fails("if a:\n\tb\n"))
    assert(fails("left\tright"))
    assert(fails("# comment\ttext"))
    assert(fails("\"text\ttext\""))
    assert(not fails("\"text\\ttext\""))

# Verifies that CRLF is one physical newline for layout and source positions,
# while a lone carriage return is rejected.
func test_crlf_is_normalized_for_tokenization():
    let tokens = lex("first\r\nsecond\r\n")
    assert_token(tokens[0], TokenKind.name, "first", 1, 1)
    assert_token(tokens[1], TokenKind.newline, "", 1, 6)
    assert_token(tokens[2], TokenKind.name, "second", 2, 1)
    assert_token(tokens[3], TokenKind.newline, "", 2, 7)
    assert_token(tokens[4], TokenKind.eof, "", 3, 1)
    assert(fails("first\rsecond"))

# mark: Source text and comments --------------------------------------------

# Verifies that a byte-zero UTF-8 BOM is ignored without shifting columns and a
# BOM anywhere else is rejected as source text.
func test_bom_is_allowed_only_at_source_start():
    let bom = str('\u{feff}')
    let tokens = lex(bom + "name")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(fails("name" + bom))

# Verifies the source security preflight for NUL and bidirectional controls,
# including controls hidden inside otherwise legal comments or literals.
func test_nul_and_bidirectional_controls_are_rejected():
    assert(fails("left" + str('\u{0}') + "right"))
    assert(fails("# hidden " + str('\u{202e}')))
    assert(fails("\"hidden " + str('\u{2066}') + "\""))

# Verifies non-ASCII Unicode remains valid inside text and comments even though
# epoch-1 identifiers themselves are restricted to ASCII.
func test_unicode_is_allowed_in_text_and_comments():
    let accent = str('\u{e9}')
    let tokens = lex("\"caf" + accent + "\" # caf" + accent + "\n")
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].text == "\"caf" + accent + "\"")
    let character_tokens = lex("'" + accent + "'")
    assert(character_tokens[0].kind == TokenKind.char_lit)

# Verifies that comments start only outside literals and consume text through
# the physical line ending without swallowing the line's NEWLINE token.
func test_comments_and_hash_characters_in_strings_are_distinct():
    let tokens = lex("name # mark: Scanner --------------------------------\n\"# text\"\n")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.str_lit, "\"# text\"", 2, 1)
    assert(tokens[3].kind == TokenKind.newline)

# mark: Numbers --------------------------------------------------------------

# Verifies decimal, separated, binary, octal, hexadecimal, and explicitly typed
# integer spellings are each captured as one integer token.
func test_integer_literal_families_are_tokenized_whole():
    let tokens = lex("42 1_000_000 0xff 0o755 0b1010_1100 255u8 20i32")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.int_lit)
        i += 1
    assert(tokens[1].text == "1_000_000")
    assert(tokens[4].text == "0b1010_1100")
    assert(tokens[6].text == "20i32")

# Verifies fractional, exponent, separated, and all three floating-width suffix
# spellings, including the previously omitted f16 suffix.
func test_float_literal_families_are_classified_as_float():
    let tokens = lex("1.0 6.022e23 1e-3 0.5f32 1_000.25 2f16 3f64")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.float_lit)
        i += 1
    assert(tokens[1].text == "6.022e23")
    assert(tokens[2].text == "1e-3")
    assert(tokens[5].text == "2f16")

# Verifies numeric separators stay between digits, base digits match their
# prefix, exponents contain digits, and suffixes name compatible core types.
func test_malformed_numeric_spellings_are_rejected():
    assert(fails("1_"))
    assert(fails("1__0"))
    assert(fails("0x_ff"))
    assert(fails("0b102"))
    assert(fails("0o8"))
    assert(fails("0x"))
    assert(fails("1e+"))
    assert(fails("42u7"))
    assert(fails("1.0i32"))
    assert(not fails("0xffu8 1_000 1e1_0 2f16"))

# Verifies that number scanning stops before member access and each range form,
# preventing a dot from being consumed as an incomplete fractional part.
func test_numbers_do_not_consume_member_or_range_dots():
    let tokens = lex("1.member 0..<10 1..=2 3..")
    assert(tokens[0].kind == TokenKind.int_lit)
    assert(tokens[1].text == ".")
    assert(tokens[2].text == "member")
    assert(tokens[4].text == "..<")
    assert(tokens[7].text == "..=")
    assert(tokens[10].text == "..")

# mark: Symbols and delimiters ----------------------------------------------

# Verifies longest-match behavior for every multi-character symbol and basic
# recognition for every single-character punctuation token in section 29.
func test_complete_symbol_surface_uses_longest_match():
    let source = "//= <<= >>= ..< ..= -> => == != <= >= // << >> += -= *= /= %= &= |= ^= .. + - * / % & | ^ ~ < > = : , . ? ! ( ) [ ] { } _"
    let expected: list[str] = ["//=", "<<=", ">>=", "..<", "..=", "->", "=>", "==", "!=", "<=", ">=", "//", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "..", "+", "-", "*", "/", "%", "&", "|", "^", "~", "<", ">", "=", ":", ",", ".", "?", "!", "(", ")", "[", "]", "{", "}", "_"]
    let tokens = lex(source)
    var i = 0
    while i < len(expected):
        assert(tokens[i].kind == TokenKind.symbol)
        assert(tokens[i].text == expected[i])
        i += 1

# Verifies `=>` is shared by expression lambdas and expression-valued match
# arms, while `:` continues to introduce the match's indented arm list.
func test_value_arrow_tokens_lambda_and_match_expressions():
    let source = "let above = (x) => x > 5\nlet digit = match c:\n    '0' => 0\n    _ => 1\n"
    let tokens = lex(source)
    var arrows = 0
    for token in tokens:
        if token.text == "=>": arrows += 1
    assert(arrows == 3)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)

# Verifies that nested parentheses, brackets, and braces suppress physical
# NEWLINE and indentation tokens until the outermost delimiter closes.
func test_nested_delimiters_suspend_layout():
    let source = "value = (\n    [\n        {\"x\": 1}\n    ]\n)\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 1)

# Verifies that delimiter tracking rejects unmatched closers, mismatched pairs,
# and end-of-source with an opener still active.
func test_unbalanced_delimiters_are_rejected():
    assert(fails(")"))
    assert(fails("(]"))
    assert(fails("([)]"))
    assert(fails("("))

# mark: String and character literals ---------------------------------------

# Verifies ordinary strings plus literal and Unicode-escaped characters retain
# exact source text and receive their dedicated token kinds.
func test_string_and_character_literals_preserve_spelling():
    let tokens = lex("\"hello\\n\" 'A' '\\n' '\\u{1f600}'")
    assert_token(tokens[0], TokenKind.str_lit, "\"hello\\n\"", 1, 1)
    assert(tokens[1].kind == TokenKind.char_lit)
    assert(tokens[2].kind == TokenKind.char_lit)
    assert(tokens[3].kind == TokenKind.char_lit)
    assert(tokens[3].text == "'\\u{1f600}'")

# Verifies that plain, raw, formatted, and byte literals are distinguished, and
# that raw backslashes remain source characters instead of escapes.
func test_prefixed_literal_families_have_the_right_token_kind():
    let source = "\"hello\" r\"C:\\studio\\shots\" f\"frame {frame}\" b\"\\x89PNG\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[1].kind == TokenKind.str_lit)
    assert(tokens[1].text == "r\"C:\\studio\\shots\"")
    assert(tokens[2].kind == TokenKind.str_lit)
    assert(tokens[3].kind == TokenKind.byte_lit)
    assert(tokens[3].text == "b\"\\x89PNG\"")

# Verifies formatted strings remain one token when fields contain nested quoted
# literals and when doubled braces request literal brace characters.
func test_formatted_strings_balance_fields_and_nested_literals():
    let source = "f\"{{value}} {format(\"x\")}\""
    let tokens = lex(source)
    assert_token(tokens[0], TokenKind.str_lit, source, 1, 1)
    assert(fails("f\"{value\""))
    assert(fails("f\"value }\""))

# Verifies multiline triple strings form one token, retain their opening source
# position, and advance the location of the token that follows them.
func test_triple_quoted_strings_span_physical_lines():
    let source = "\"\"\"first\nsecond\"\"\"\nafter"
    let tokens = lex(source)
    assert_token(tokens[0], TokenKind.str_lit, "\"\"\"first\nsecond\"\"\"", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.name, "after", 3, 1)

# Verifies prefixes also work with triple delimiters and that an internal newline
# changes the next literal's physical line without emitting layout inside either.
func test_prefixed_triple_strings_are_supported():
    let source = "r\"\"\"C:\\one\nC:\\two\"\"\" b\"\"\"PNG\"\"\" f\"\"\"value {x}\"\"\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].line == 1)
    assert(tokens[1].kind == TokenKind.byte_lit)
    assert(tokens[1].line == 2)
    assert(tokens[2].kind == TokenKind.str_lit)
    assert(tokens[2].line == 2)

# Verifies invalid literal boundaries: raw newlines in short literals, missing
# closing delimiters, empty characters, and multi-scalar characters all fail.
func test_malformed_literal_boundaries_are_rejected():
    assert(fails("\"line\nnext\""))
    assert(fails("\"unterminated"))
    assert(fails("\"\"\"unterminated"))
    assert(fails("r\"unterminated"))
    assert(fails("''"))
    assert(fails("'ab'"))

# Verifies the specified escape vocabulary, Unicode scalar bounds, exact byte
# escapes, and the ASCII-source restriction for byte literals.
func test_invalid_escapes_and_byte_source_are_rejected():
    assert(fails("\"\\q\""))
    assert(fails("\"\\x41\""))
    assert(fails("'\\u{110000}'"))
    assert(fails("'\\u{d800}'"))
    assert(fails("b\"\\x8\""))
    assert(fails("b\"" + str('\u{e9}') + "\""))
    assert(not fails("r\"\\q\""))

# mark: Completion and diagnostics ------------------------------------------

# Verifies comments-only input produces no logical-line token, while an open
# indented block at EOF is closed after a synthetic NEWLINE and before EOF.
func test_eof_balances_layout_without_inventing_comment_lines():
    let comment_tokens = lex("# comment without newline")
    assert(len(comment_tokens) == 1)
    assert(comment_tokens[0].kind == TokenKind.eof)

    let block_tokens = lex("if ready:\n    run()")
    let n = len(block_tokens)
    assert(block_tokens[n - 3].kind == TokenKind.newline)
    assert(block_tokens[n - 2].kind == TokenKind.dedent)
    assert(block_tokens[n - 1].kind == TokenKind.eof)

# Verifies lexical exclusions that keep the surface unambiguous: semicolons,
# backslash continuation, Unicode identifiers, and look-alike punctuation.
func test_excluded_source_forms_are_rejected():
    assert(fails("left; right"))
    assert(fails("left \\\nright"))
    assert(fails("caf" + str('\u{e9}')))
    assert(fails("left" + str('\u{ff1b}') + "right"))

# Verifies diagnostics report the first offending physical line and column in a
# stable machine-readable prefix.
func test_diagnostic_reports_first_offending_position():
    assert(failure("first\n@") == "tokenizer:2:1: unexpected character")
