#==============================================================================================
#
#   interface_reporting - Existential storage and dynamic-dispatch costs
#
#   DESCRIPTION:
#       Presents the target-neutral interface operations already fixed in HIR.
#       A conversion is explicit existential storage and every interface call
#       is explicit dynamic dispatch. Current runtime contracts materialize
#       existential storage as an allocation; no backend layout or ABI fact is
#       introduced here.
#
#==============================================================================================

from compiler.hir.ir import HirProgram, NodeId, TypeForm, TypeId, describe_type, node_form, node_module, node_span, node_type, root_package

## One concrete-to-interface conversion site.
pub struct InterfaceBoxingSite:
    pub let location: str
    pub let source_type: str
    pub let interface_type: str
    ## Value payloads detach on mutation; class payloads keep shared identity.
    pub let payload_semantics: str

## One call whose implementation is selected from an existential method table.
pub struct InterfaceDispatchSite:
    pub let location: str
    pub let interface_type: str
    pub let requirement: str
    pub let is_mutating: bool

## Package-wide existential cost accounting used by `luce explain`.
pub struct InterfaceCostReport:
    pub let package_identity: str
    pub let boxing_sites: list[InterfaceBoxingSite]
    pub let dispatch_sites: list[InterfaceDispatchSite]

    pub func render() -> str:
        var text = "interface costs for `" + self.package_identity + "`: " + str(len(self.boxing_sites)) + " box(es), " + str(len(self.dispatch_sites)) + " dynamic call(s)"
        for site in self.boxing_sites:
            text = text + "\n" + site.location + ": box `" + site.source_type + "` as `" + site.interface_type + "`"
            text = text + "\n  current runtime: allocation; semantics: " + site.payload_semantics
        for site in self.dispatch_sites:
            text = text + "\n" + site.location + ": dynamic call `" + site.interface_type + "." + site.requirement + "`"
            if site.is_mutating:
                text = text + "\n  mutation: value payload may detach; class payload keeps shared identity"
        return text

# mark: HIR accounting ========================================================================

## Report executable HIR only. Abstract generic bodies are excluded; each
## concrete specialization contributes its actual conversion/call sites.
pub func report_interface_costs(program: HirProgram) -> InterfaceCostReport:
    let boxes = list[InterfaceBoxingSite]()
    let dispatches = list[InterfaceDispatchSite]()
    for index in range(0, len(program.nodes)):
        let node = NodeId(value = u32(index))
        match node_form(program, node):
            InterfaceValue(value, conformance):
                boxes.append(InterfaceBoxingSite(
                    location = location(program, node),
                    source_type = describe_type(program.types, node_type(program, value)),
                    interface_type = describe_type(program.types, node_type(program, node)),
                    payload_semantics = payload_semantics(program, node_type(program, value)),
                ))
            InterfaceCall(receiver, interface_type, requirement, arguments):
                var declaration = -1
                match program.types.definitions[interface_type.value].form:
                    Interface(interface_index, values): declaration = interface_index
                    else: trap("typed interface call has a non-interface owner")
                let contract = program.interfaces[declaration]
                if i64(requirement) >= len(contract.requirements): trap("typed interface call names a missing requirement")
                dispatches.append(InterfaceDispatchSite(
                    location = location(program, node),
                    interface_type = describe_type(program.types, interface_type),
                    requirement = contract.requirements[requirement].name,
                    is_mutating = contract.requirements[requirement].is_mutating,
                ))
            else: pass
    return InterfaceCostReport(
        package_identity = root_package(program).identity,
        boxing_sites = boxes,
        dispatch_sites = dispatches,
    )

# mark: Presentation helpers ==================================================================

func location(program: HirProgram, node: NodeId) -> str:
    let module = program.modules[node_module(program, node).value]
    let span = node_span(program, node)
    return module.path + ":" + str(i64(span.line)) + ":" + str(i64(span.column))

func payload_semantics(program: HirProgram, value_type: TypeId) -> str:
    match program.types.definitions[value_type.value].form:
        Class(index, arguments): return "shared class identity"
        else: return "copy-on-write value"
