from compiler.tokenizer import SourceSpan, Token

# The source tree: what the programmer wrote, kept faithful. Nothing here is
# resolved, typed, or lowered — the parser builds these nodes, and every later
# consumer (checker, diagnostics, documentation, a future formatter) reads the
# same shapes. Typed meaning belongs to typed_ir.luc.
#
# Each recursive node family is a class holding one tagged `Form` union
# (`ExpressionSyntax` holds an `ExpressionForm`, and so on). The class supplies
# the reference indirection a recursive tree needs; the union names each source
# form once. Small leaf records stay plain value structs. The parser never
# mutates a node after publishing it.

# mark: Shared forms ---------------------------------------------------------

# `compiler.frontend.parser` — a dotted name, one part per segment.
pub class PathSyntax:
    pub parts: list[str]
    pub span: SourceSpan

    pub init(parts: list[str], span: SourceSpan):
        self.parts = parts
        self.span = span

    # The path as written: `compiler.frontend.parser`.
    pub func dotted() -> str:
        var name = self.parts[0]
        for part in self.parts[1:]:
            name = name + "." + part
        return name

    # The final segment, which names the imported module by default.
    pub func last() -> str:
        return self.parts[len(self.parts) - 1]

# `if ready: return value` versus an indented body after `:`.
pub enum SuiteStyle:
    inline_suite
    indented_suite

# `: return value` or `:\n    return value`
pub class SuiteSyntax:
    pub style: SuiteStyle
    pub statements: list[StatementSyntax]
    pub span: SourceSpan

    pub init(style: SuiteStyle, statements: list[StatementSyntax], span: SourceSpan):
        self.style = style
        self.statements = statements
        self.span = span

# `T: Hashable & Equatable` inside `[T: Hashable & Equatable]`.
pub struct GenericParameterSyntax:
    pub name: str
    pub constraints: list[TypeSyntax]
    pub span: SourceSpan

# `samples: u32 = 64`, or inferred `value` in `(value) => value`.
pub struct ParameterSyntax:
    pub name: str
    pub annotation: TypeSyntax?
    pub default_value: ExpressionSyntax?
    pub span: SourceSpan

# `scene` or `samples: 256` inside a call.
pub struct ArgumentSyntax:
    pub label: str?
    pub value: ExpressionSyntax
    pub span: SourceSpan

# `weak owner` or `copy snapshot = counter` inside a closure capture list.
pub struct CaptureSyntax:
    pub name: str
    pub value: ExpressionSyntax?
    pub is_weak: bool
    pub span: SourceSpan

# mark: Types ----------------------------------------------------------------

# `Image`, `list[Point]`, `(i64, str)`, or `func(i64) -> bool`.
pub class TypeSyntax:
    pub form: TypeForm

    pub init(form: TypeForm):
        self.form = form

# The tagged source form held by one `TypeSyntax` node.
pub union TypeForm:
    Named(path: PathSyntax)
    Applied(path: PathSyntax, arguments: list[TypeArgumentSyntax], span: SourceSpan)
    TupleType(elements: list[TypeSyntax], span: SourceSpan)
    FunctionType(parameters: list[TypeSyntax], result: TypeSyntax, effects: list[str], span: SourceSpan)
    CFunctionType(parameters: list[TypeSyntax], result: TypeSyntax, span: SourceSpan)
    OptionalType(value: TypeSyntax, span: SourceSpan)
    FallibleType(value: TypeSyntax, span: SourceSpan)

# `Point` or the array length `16` inside generic brackets.
pub union TypeArgumentSyntax:
    TypeArgument(value: TypeSyntax)
    IntegerArgument(token: Token)

# mark: Expressions and patterns --------------------------------------------

# `"accent": "blue"` inside a map literal.
pub struct MapEntrySyntax:
    pub key: ExpressionSyntax
    pub value: ExpressionSyntax
    pub span: SourceSpan

# `'0'..='9', _ => 0` inside an expression-valued match.
pub struct MatchValueArmSyntax:
    pub patterns: list[PatternSyntax]
    pub value: ExpressionSyntax
    pub span: SourceSpan

# Literals, calls, operators, lambdas, closures, and value-producing matches.
pub class ExpressionSyntax:
    pub form: ExpressionForm

    pub init(form: ExpressionForm):
        self.form = form

    # Where this expression sits in source, whichever form it takes.
    pub func span() -> SourceSpan:
        match self.form:
            Literal(token): return token.span
            Name(value, span): return span
            CaseValue(name, arguments, span): return span
            Group(value, span): return span
            TupleValue(elements, span): return span
            ListValue(elements, span): return span
            MapValue(entries, span): return span
            Unary(operator, operand, span): return span
            Binary(left, operator, right, span): return span
            Conditional(value, condition, alternative, span): return span
            ElseValue(value, arm, span): return span
            Member(value, name, span): return span
            Call(callee, type_arguments, arguments, span): return span
            Index(value, subscript, span): return span
            Slice(value, start, operator, end, span): return span
            Lambda(parameters, body, span): return span
            Closure(captures, parameters, result, effects, body, span): return span
            MatchValue(subject, arms, span): return span
            NewValue(value_type, arguments, span): return span
            SpawnValue(function, arguments, span): return span
            CatchValue(value, failure_name, body, span): return span

# The tagged source form held by one `ExpressionSyntax` node.
pub union ExpressionForm:
    Literal(token: Token)
    Name(value: str, span: SourceSpan)
    CaseValue(name: str, arguments: list[ArgumentSyntax], span: SourceSpan)
    Group(value: ExpressionSyntax, span: SourceSpan)
    TupleValue(elements: list[ExpressionSyntax], span: SourceSpan)
    ListValue(elements: list[ExpressionSyntax], span: SourceSpan)
    MapValue(entries: list[MapEntrySyntax], span: SourceSpan)
    Unary(operator: str, operand: ExpressionSyntax, span: SourceSpan)
    Binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan)
    Conditional(value: ExpressionSyntax, condition: ExpressionSyntax, alternative: ExpressionSyntax, span: SourceSpan)
    ElseValue(value: ExpressionSyntax, arm: ExpressionSyntax, span: SourceSpan)
    Member(value: ExpressionSyntax, name: str, span: SourceSpan)
    Call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan)
    Index(value: ExpressionSyntax, subscript: ExpressionSyntax, span: SourceSpan)
    Slice(value: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan)
    Lambda(parameters: list[ParameterSyntax], body: ExpressionSyntax, span: SourceSpan)
    Closure(captures: list[CaptureSyntax], parameters: list[ParameterSyntax], result: TypeSyntax?, effects: list[str], body: SuiteSyntax, span: SourceSpan)
    MatchValue(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax], span: SourceSpan)
    NewValue(value_type: TypeSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    SpawnValue(function: PathSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    CatchValue(value: ExpressionSyntax, failure_name: str, body: SuiteSyntax, span: SourceSpan)

# `value` or `(quotient, remainder)` on the left of a binding.
pub union BindingPatternSyntax:
    Name(value: str, span: SourceSpan)
    TupleNames(values: list[str], span: SourceSpan)

# `_`, `'0'`, `'0'..='9'`, or `.open(path)` in a match arm.
pub union PatternSyntax:
    Wildcard(span: SourceSpan)
    Literal(token: Token)
    RangePattern(lower: Token, operator: str, upper: Token, span: SourceSpan)
    CasePattern(name: str, bindings: list[str], span: SourceSpan)

# mark: Statements -----------------------------------------------------------

# `ready` or `let value = optional` after `if`.
pub class ConditionSyntax:
    pub form: ConditionForm

    pub init(form: ConditionForm):
        self.form = form

pub union ConditionForm:
    Expression(value: ExpressionSyntax)
    Binding(name: str, value: ExpressionSyntax, span: SourceSpan)

# `if ready: ...` or one following `elif retrying: ...` branch.
pub struct IfBranchSyntax:
    pub condition: ConditionSyntax
    pub body: SuiteSyntax
    pub span: SourceSpan

# `.open(path), .save(path): store(path)` inside a statement match.
pub struct MatchStatementArmSyntax:
    pub patterns: list[PatternSyntax]
    pub body: SuiteSyntax
    pub span: SourceSpan

# Bindings, assignments, control flow, returns, and call statements.
pub class StatementSyntax:
    pub form: StatementForm

    pub init(form: StatementForm):
        self.form = form

    # Where this statement sits in source, whichever form it takes.
    pub func span() -> SourceSpan:
        match self.form:
            BreakStatement(span): return span
            ContinueStatement(span): return span
            Binding(is_mutable, pattern, annotation, value, span): return span
            Assignment(target, operator, value, span): return span
            ReturnStatement(value, span): return span
            DeferStatement(value, span): return span
            RecoverStatement(value, span): return span
            ExpressionStatement(value, span): return span
            IfStatement(branches, fallback, span): return span
            WhileStatement(condition, body, span): return span
            ForStatement(name, iterable, body, span): return span
            MatchStatement(subject, arms, span): return span

# The tagged source form held by one `StatementSyntax` node.
pub union StatementForm:
    BreakStatement(span: SourceSpan)
    ContinueStatement(span: SourceSpan)
    Binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan)
    Assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan)
    ReturnStatement(value: ExpressionSyntax?, span: SourceSpan)
    DeferStatement(value: ExpressionSyntax, span: SourceSpan)
    RecoverStatement(value: ExpressionSyntax, span: SourceSpan)
    ExpressionStatement(value: ExpressionSyntax, span: SourceSpan)
    IfStatement(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan)
    WhileStatement(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    ForStatement(name: str, iterable: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    MatchStatement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax], span: SourceSpan)

# mark: Declarations ---------------------------------------------------------

# `ModuleSyntax` in `from compiler.syntax import ModuleSyntax`.
pub struct ImportedNameSyntax:
    pub name: str
    pub span: SourceSpan

# `import compiler.parser as parser`, or a selective `from` import. An empty
# `names` list denotes a module import; selective imports never use an alias.
pub struct ImportSyntax:
    pub path: PathSyntax
    pub names: list[ImportedNameSyntax]
    pub alias_name: str?
    pub span: SourceSpan

# `func clamp(value: i64) -> i64: ...`, with or without an interface body.
pub struct FunctionSyntax:
    pub is_mutating: bool
    pub name: str
    pub generic_parameters: list[GenericParameterSyntax]
    pub parameters: list[ParameterSyntax]
    pub result: TypeSyntax?
    pub effects: list[str]
    pub body: SuiteSyntax?
    pub span: SourceSpan

# `weak var parent: Node? = none`
pub struct FieldSyntax:
    pub is_weak: bool
    pub is_mutable: bool
    pub name: str
    pub value_type: TypeSyntax
    pub default_value: ExpressionSyntax?
    pub span: SourceSpan

# A field or method declared inside a struct, class, enum, or interface.
pub union TypeMemberKind:
    Field(value: FieldSyntax)
    Function(value: FunctionSyntax)

# `pub let width: u32` or `pub func render(): ...` inside a type.
pub class TypeMemberSyntax:
    pub documentation: list[str]
    pub is_public: bool
    pub value: TypeMemberKind
    pub span: SourceSpan

    pub init(documentation: list[str], is_public: bool, value: TypeMemberKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# Distinguishes `struct Name:` from `class Name:`.
pub enum NominalTypeKind:
    struct_type
    class_type

# `struct Point[T] implements Hashable: ...`
pub struct NominalTypeSyntax:
    pub kind: NominalTypeKind
    pub name: str
    pub generic_parameters: list[GenericParameterSyntax]
    pub interfaces: list[TypeSyntax]
    pub members: list[TypeMemberSyntax]

# `radius: f64` in an enum-case payload or another named typed slot.
pub struct NamedTypeSyntax:
    pub name: str
    pub value_type: TypeSyntax
    pub span: SourceSpan

# `circle(radius: f64)` inside an enum.
pub struct EnumCaseSyntax:
    pub documentation: list[str]
    pub name: str
    pub payload: list[NamedTypeSyntax]
    pub span: SourceSpan

# `enum Shape[T] implements Drawable: ...`
pub struct EnumSyntax:
    pub name: str
    pub generic_parameters: list[GenericParameterSyntax]
    pub interfaces: list[TypeSyntax]
    pub cases: list[EnumCaseSyntax]
    pub methods: list[TypeMemberSyntax]

# `interface Reader[T]: ...`
pub struct InterfaceSyntax:
    pub name: str
    pub generic_parameters: list[GenericParameterSyntax]
    pub methods: list[TypeMemberSyntax]

# `let maximum: u64 = 100`
pub struct ConstantSyntax:
    pub name: str
    pub annotation: TypeSyntax?
    pub value: ExpressionSyntax

# `type Identifier = u64`
pub struct TypeAliasSyntax:
    pub name: str
    pub value: TypeSyntax

# `test "parser accepts a module": ...`
pub struct TestSyntax:
    pub description: Token
    pub effects: list[str]
    pub body: SuiteSyntax

# `let red: u8` inside an exported C struct. Export already makes every field
# part of the native API, so this node has no source-visibility state.
pub struct ExportFieldSyntax:
    pub documentation: list[str]
    pub name: str
    pub value_type: TypeSyntax
    pub span: SourceSpan

# `export c struct Pixel: ...`
pub struct ExportStructSyntax:
    pub name: str
    pub fields: list[ExportFieldSyntax]

# `ready = 1` inside an exported C enum.
pub struct ExportEnumCaseSyntax:
    pub name: str
    pub value: Token
    pub span: SourceSpan

# `export c enum Status as u32: ...`
pub struct ExportEnumSyntax:
    pub name: str
    pub representation: str
    pub cases: list[ExportEnumCaseSyntax]

# `extern type Window` or `extern type Device = i32`. The representation is
# one of the four integer handle widths, or none for a pointer-shaped handle.
pub struct ExternTypeSyntax:
    pub name: str
    pub representation: str?

# `window: Window` or `out w: i32` inside an extern function's parameters.
# The C shape is the whole declaration, so there is never a default value.
pub struct ExternParameterSyntax:
    pub is_out: bool
    pub name: str
    pub value_type: TypeSyntax
    pub span: SourceSpan

# `extern func SDL_CreateWindow(title: str, w: i32) -> Window?`, with
# `extern blocking func` marking a call that may suspend the caller.
pub struct ExternFunctionSyntax:
    pub is_blocking: bool
    pub name: str
    pub parameters: list[ExternParameterSyntax]
    pub result: TypeSyntax?

# `extern var SDL_version_number: i32`
pub struct ExternVariableSyntax:
    pub name: str
    pub value_type: TypeSyntax

# `extern struct Rect:` with a body of plain `name: Type` field lines —
# C layout, so no methods, defaults, or visibility markers.
pub struct ExternStructSyntax:
    pub name: str
    pub fields: list[NamedTypeSyntax]

# Every non-import module declaration accepted by epoch 1.
pub union DeclarationKind:
    Constant(value: ConstantSyntax)
    TypeAlias(value: TypeAliasSyntax)
    Function(value: FunctionSyntax)
    NominalType(value: NominalTypeSyntax)
    Enumeration(value: EnumSyntax)
    InterfaceType(value: InterfaceSyntax)
    TestDeclaration(value: TestSyntax)
    ExportStruct(value: ExportStructSyntax)
    ExportEnum(value: ExportEnumSyntax)
    ExportFunction(value: FunctionSyntax)
    ExternType(value: ExternTypeSyntax)
    ExternFunction(value: ExternFunctionSyntax)
    ExternVariable(value: ExternVariableSyntax)
    ExternStruct(value: ExternStructSyntax)

# Documentation and visibility wrapped around one module declaration.
pub class DeclarationSyntax:
    pub documentation: list[str]
    pub is_public: bool
    pub value: DeclarationKind
    pub span: SourceSpan

    pub init(documentation: list[str], is_public: bool, value: DeclarationKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# One `.luc` file: leading imports followed by module declarations.
pub struct ModuleSyntax:
    pub tokens: list[Token]
    pub imports: list[ImportSyntax]
    pub declarations: list[DeclarationSyntax]
    pub span: SourceSpan
