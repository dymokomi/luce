from compiler.tokenizer import SourceSpan, Token

# The source tree preserves what the programmer wrote without resolving names,
# inferring types, or lowering syntax. Parser, diagnostics, documentation, and
# semantic analysis share this representation; typed meaning belongs in IR.
# Recursive and aggregate nodes are stable references, while small leaf records
# remain values. The `from_form` entry points keep union temporaries rooted for
# Stage 0; the parser never mutates a node after publishing it.

# mark: Shared forms ---------------------------------------------------------

# `compiler.frontend.parser`
class PathSyntax:
    parts: list[str]
    span: SourceSpan

    init(parts: list[str], span: SourceSpan):
        self.parts = parts
        self.span = span

# `if ready: return value` versus an indented body after `:`.
enum SuiteStyle:
    inline_suite
    indented_suite

# `: return value` or `:\n    return value`
class SuiteSyntax:
    style: SuiteStyle
    statements: list[StatementSyntax]
    span: SourceSpan

    init(style: SuiteStyle, statements: list[StatementSyntax], span: SourceSpan):
        self.style = style
        self.statements = statements
        self.span = span

# `T: Hashable & Equatable` inside `[T: Hashable & Equatable]`.
struct GenericParameterSyntax:
    name: str
    constraints: list[TypeSyntax]
    span: SourceSpan

# `samples: u32 = 64`, or inferred `value` in `(value) => value`.
struct ParameterSyntax:
    name: str
    annotation: TypeSyntax?
    default_value: ExpressionSyntax?
    span: SourceSpan

# `scene` or `samples: 256` inside a call.
struct ArgumentSyntax:
    label: str?
    value: ExpressionSyntax
    span: SourceSpan

# `weak owner` or `copy snapshot = counter` inside a closure capture list.
struct CaptureSyntax:
    name: str
    value: ExpressionSyntax?
    is_weak: bool
    span: SourceSpan

# mark: Types ----------------------------------------------------------------

# `Image`, `list[Point]`, `(i64, str)`, or `func(i64) -> bool`.
class TypeSyntax:
    form: TypeForm

    init(form: TypeForm):
        self.form = form

    static func from_form(form: TypeForm) -> TypeSyntax:
        return TypeSyntax(form = form)

# The tagged source form held by one `TypeSyntax` node.
union TypeForm:
    Named(path: PathSyntax)
    Applied(path: PathSyntax, arguments: list[TypeArgumentSyntax], span: SourceSpan)
    TupleType(elements: list[TypeSyntax], span: SourceSpan)
    FunctionType(parameters: list[TypeSyntax], result: TypeSyntax, effects: list[str], span: SourceSpan)
    OptionalType(value: TypeSyntax, span: SourceSpan)
    FallibleType(value: TypeSyntax, span: SourceSpan)

# `Point` or the array length `16` inside generic brackets.
union TypeArgumentSyntax:
    TypeArgument(value: TypeSyntax)
    IntegerArgument(token: Token)

# mark: Expressions and patterns --------------------------------------------

# `"accent": "blue"` inside a map literal.
struct MapEntrySyntax:
    key: ExpressionSyntax
    value: ExpressionSyntax
    span: SourceSpan

# `'0' => 0` inside an expression-valued match.
struct MatchValueArmSyntax:
    pattern: PatternSyntax
    value: ExpressionSyntax
    span: SourceSpan

# Literals, calls, operators, lambdas, closures, and value-producing matches.
class ExpressionSyntax:
    form: ExpressionForm

    init(form: ExpressionForm):
        self.form = form

    static func from_form(form: ExpressionForm) -> ExpressionSyntax:
        return ExpressionSyntax(form = form)

# The tagged source form held by one `ExpressionSyntax` node.
union ExpressionForm:
    Literal(token: Token)
    Name(value: str, span: SourceSpan)
    CaseValue(name: str, arguments: list[ArgumentSyntax], span: SourceSpan)
    Group(value: ExpressionSyntax, span: SourceSpan)
    TupleValue(elements: list[ExpressionSyntax], span: SourceSpan)
    ListValue(elements: list[ExpressionSyntax], span: SourceSpan)
    MapValue(entries: list[MapEntrySyntax], span: SourceSpan)
    Unary(operator: str, operand: ExpressionSyntax, span: SourceSpan)
    Binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan)
    Conditional(value: ExpressionSyntax, condition: ExpressionSyntax, alternative: ExpressionSyntax, span: SourceSpan)
    Member(value: ExpressionSyntax, name: str, span: SourceSpan)
    Call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan)
    Index(value: ExpressionSyntax, subscript: ExpressionSyntax, span: SourceSpan)
    Slice(value: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan)
    Lambda(parameters: list[ParameterSyntax], body: ExpressionSyntax, span: SourceSpan)
    Closure(captures: list[CaptureSyntax], parameters: list[ParameterSyntax], result: TypeSyntax?, effects: list[str], body: SuiteSyntax, span: SourceSpan)
    MatchValue(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax], span: SourceSpan)
    NewValue(value_type: TypeSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    SpawnValue(function: PathSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    CatchValue(value: ExpressionSyntax, failure_name: str, body: SuiteSyntax, span: SourceSpan)

# `value` or `(quotient, remainder)` on the left of a binding.
union BindingPatternSyntax:
    Name(value: str, span: SourceSpan)
    TupleNames(values: list[str], span: SourceSpan)

# `_`, `'0'`, or `.open(path)` in a match arm.
union PatternSyntax:
    Wildcard(span: SourceSpan)
    Literal(token: Token)
    CasePattern(name: str, bindings: list[str], span: SourceSpan)

# mark: Statements -----------------------------------------------------------

# `ready` or `let value = optional` after `if`.
union ConditionSyntax:
    Expression(value: ExpressionSyntax)
    Binding(name: str, value: ExpressionSyntax, span: SourceSpan)

# `if ready: ...` or one following `elif retrying: ...` branch.
struct IfBranchSyntax:
    condition: ConditionSyntax
    body: SuiteSyntax
    span: SourceSpan

# `.save(path): save_document(path)` inside a statement match.
struct MatchStatementArmSyntax:
    pattern: PatternSyntax
    body: SuiteSyntax
    span: SourceSpan

# Bindings, assignments, control flow, returns, and call statements.
class StatementSyntax:
    form: StatementForm

    init(form: StatementForm):
        self.form = form

    static func from_form(form: StatementForm) -> StatementSyntax:
        return StatementSyntax(form = form)

# The tagged source form held by one `StatementSyntax` node.
union StatementForm:
    BreakStatement(span: SourceSpan)
    ContinueStatement(span: SourceSpan)
    Binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan)
    Assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan)
    ReturnStatement(value: ExpressionSyntax?, span: SourceSpan)
    DeferStatement(value: ExpressionSyntax, span: SourceSpan)
    RecoverStatement(value: ExpressionSyntax, span: SourceSpan)
    ExpressionStatement(value: ExpressionSyntax, span: SourceSpan)
    IfStatement(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan)
    WhileStatement(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    ForStatement(name: str, iterable: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    MatchStatement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax], span: SourceSpan)

# mark: Declarations ---------------------------------------------------------

# `import compiler.parser as parser`
struct ImportSyntax:
    path: PathSyntax
    alias_name: str?
    span: SourceSpan

# `func clamp(value: i64) -> i64: ...`, with or without an interface body.
struct FunctionSyntax:
    is_mutating: bool
    name: str
    generic_parameters: list[GenericParameterSyntax]
    parameters: list[ParameterSyntax]
    result: TypeSyntax?
    effects: list[str]
    body: SuiteSyntax?
    span: SourceSpan

# `weak var parent: Node? = none`
struct FieldSyntax:
    is_weak: bool
    is_mutable: bool
    name: str
    value_type: TypeSyntax
    default_value: ExpressionSyntax?
    span: SourceSpan

# A field or method declared inside a struct, class, enum, or interface.
union TypeMemberKind:
    Field(value: FieldSyntax)
    Function(value: FunctionSyntax)

# `public let width: u32` or `public func render(): ...` inside a type.
class TypeMemberSyntax:
    documentation: list[str]
    is_public: bool
    value: TypeMemberKind
    span: SourceSpan

    init(documentation: list[str], is_public: bool, value: TypeMemberKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# Distinguishes `struct Name:` from `class Name:`.
enum NominalTypeKind:
    struct_type
    class_type

# `struct Point[T] implements Hashable: ...`
struct NominalTypeSyntax:
    kind: NominalTypeKind
    name: str
    generic_parameters: list[GenericParameterSyntax]
    interfaces: list[TypeSyntax]
    members: list[TypeMemberSyntax]

# `radius: f64` in an enum-case payload or another named typed slot.
struct NamedTypeSyntax:
    name: str
    value_type: TypeSyntax
    span: SourceSpan

# `circle(radius: f64)` inside an enum.
struct EnumCaseSyntax:
    documentation: list[str]
    name: str
    payload: list[NamedTypeSyntax]
    span: SourceSpan

# `enum Shape[T] implements Drawable: ...`
struct EnumSyntax:
    name: str
    generic_parameters: list[GenericParameterSyntax]
    interfaces: list[TypeSyntax]
    cases: list[EnumCaseSyntax]
    methods: list[TypeMemberSyntax]

# `interface Reader[T]: ...`
struct InterfaceSyntax:
    name: str
    generic_parameters: list[GenericParameterSyntax]
    methods: list[TypeMemberSyntax]

# `let maximum: u64 = 100`
struct ConstantSyntax:
    name: str
    annotation: TypeSyntax?
    value: ExpressionSyntax

# `type Identifier = u64`
struct TypeAliasSyntax:
    name: str
    value: TypeSyntax

# `test "parser accepts a module": ...`
struct TestSyntax:
    description: Token
    effects: list[str]
    body: SuiteSyntax

# `export c struct Pixel: ...`
struct ExportStructSyntax:
    name: str
    fields: list[TypeMemberSyntax]

# `ready = 1` inside an exported C enum.
struct ExportEnumCaseSyntax:
    name: str
    value: Token
    span: SourceSpan

# `export c enum Status as u32: ...`
struct ExportEnumSyntax:
    name: str
    representation: str
    cases: list[ExportEnumCaseSyntax]

# Every non-import module declaration accepted by epoch 1.
union DeclarationKind:
    Constant(value: ConstantSyntax)
    TypeAlias(value: TypeAliasSyntax)
    Function(value: FunctionSyntax)
    NominalType(value: NominalTypeSyntax)
    Enumeration(value: EnumSyntax)
    InterfaceType(value: InterfaceSyntax)
    TestDeclaration(value: TestSyntax)
    ExportStruct(value: ExportStructSyntax)
    ExportEnum(value: ExportEnumSyntax)
    ExportFunction(value: FunctionSyntax)

# Documentation and visibility wrapped around one module declaration.
class DeclarationSyntax:
    documentation: list[str]
    is_public: bool
    value: DeclarationKind
    span: SourceSpan

    init(documentation: list[str], is_public: bool, value: DeclarationKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# One `.luc` file: leading imports followed by module declarations.
struct ModuleSyntax:
    tokens: list[Token]
    imports: list[ImportSyntax]
    declarations: list[DeclarationSyntax]
    span: SourceSpan
