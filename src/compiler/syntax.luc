from compiler.tokenizer import SourceSpan, Token

# The source tree preserves what the programmer wrote without resolving names,
# inferring types, or lowering syntax. Parser, diagnostics, documentation, and
# semantic analysis share this representation; typed meaning belongs in IR.
# Recursive and aggregate nodes are stable references, while small leaf records
# remain values. Construction is centralized here and the parser never mutates a
# node after publishing it.

# mark: Shared forms ---------------------------------------------------------

# `compiler.frontend.parser`
class PathSyntax:
    parts: list[str]
    span: SourceSpan

    init(parts: list[str], span: SourceSpan):
        self.parts = parts
        self.span = span

# `if ready: return value` versus an indented body after `:`.
enum SuiteStyle:
    inline_suite
    indented_suite

# `: return value` or `:\n    return value`
class SuiteSyntax:
    style: SuiteStyle
    statements: list[StatementSyntax]
    span: SourceSpan

    init(style: SuiteStyle, statements: list[StatementSyntax], span: SourceSpan):
        self.style = style
        self.statements = statements
        self.span = span

# `T: Hashable & Equatable` inside `[T: Hashable & Equatable]`.
struct GenericParameterSyntax:
    name: str
    constraints: list[TypeSyntax]
    span: SourceSpan

# `samples: u32 = 64`, or inferred `value` in `(value) => value`.
struct ParameterSyntax:
    name: str
    annotation: TypeSyntax?
    default_value: ExpressionSyntax?
    span: SourceSpan

# `scene` or `samples: 256` inside a call.
struct ArgumentSyntax:
    label: str?
    value: ExpressionSyntax
    span: SourceSpan

# `weak owner` or `copy snapshot = counter` inside a closure capture list.
struct CaptureSyntax:
    name: str
    value: ExpressionSyntax?
    is_weak: bool
    span: SourceSpan

# mark: Types ----------------------------------------------------------------

# `Image`, `list[Point]`, `(i64, str)`, or `func(i64) -> bool`.
class TypeSyntax:
    form: TypeForm

    init(form: TypeForm):
        self.form = form

    static func named(path: PathSyntax) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.named(path = path))

    static func applied(path: PathSyntax, arguments: list[TypeArgumentSyntax], span: SourceSpan) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.applied(path = path, arguments = arguments, span = span))

    static func tuple_type(elements: list[TypeSyntax], span: SourceSpan) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.tuple_type(elements = elements, span = span))

    static func function_type(parameters: list[TypeSyntax], result: TypeSyntax, effects: list[str], span: SourceSpan) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.function_type(parameters = parameters, result = result, effects = effects, span = span))

    static func optional_type(value: TypeSyntax, span: SourceSpan) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.optional_type(value = value, span = span))

    static func fallible_type(value: TypeSyntax, span: SourceSpan) -> TypeSyntax:
        return TypeSyntax(form = TypeForm.fallible_type(value = value, span = span))

# The tagged source form held by one `TypeSyntax` node.
union TypeForm:
    named(path: PathSyntax)
    applied(path: PathSyntax, arguments: list[TypeArgumentSyntax], span: SourceSpan)
    tuple_type(elements: list[TypeSyntax], span: SourceSpan)
    function_type(parameters: list[TypeSyntax], result: TypeSyntax, effects: list[str], span: SourceSpan)
    optional_type(value: TypeSyntax, span: SourceSpan)
    fallible_type(value: TypeSyntax, span: SourceSpan)

# `Point` or the array length `16` inside generic brackets.
union TypeArgumentSyntax:
    type_argument(value: TypeSyntax)
    integer_argument(token: Token)

# mark: Expressions and patterns --------------------------------------------

# `"accent": "blue"` inside a map literal.
struct MapEntrySyntax:
    key: ExpressionSyntax
    value: ExpressionSyntax
    span: SourceSpan

# `'0' => 0` inside an expression-valued match.
struct MatchValueArmSyntax:
    pattern: PatternSyntax
    value: ExpressionSyntax
    span: SourceSpan

# Literals, calls, operators, lambdas, closures, and value-producing matches.
class ExpressionSyntax:
    form: ExpressionForm

    init(form: ExpressionForm):
        self.form = form

    static func literal(token: Token) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.literal(token = token))

    static func name(value: str, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.name(value = value, span = span))

    static func case_value(name: str, arguments: list[ArgumentSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.case_value(name = name, arguments = arguments, span = span))

    static func group(value: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.group(value = value, span = span))

    static func tuple_value(elements: list[ExpressionSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.tuple_value(elements = elements, span = span))

    static func list_value(elements: list[ExpressionSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.list_value(elements = elements, span = span))

    static func map_value(entries: list[MapEntrySyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.map_value(entries = entries, span = span))

    static func unary(operator: str, operand: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.unary(operator = operator, operand = operand, span = span))

    static func binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.binary(left = left, operator = operator, right = right, span = span))

    static func conditional(value: ExpressionSyntax, condition: ExpressionSyntax, alternative: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.conditional(value = value, condition = condition, alternative = alternative, span = span))

    static func member(value: ExpressionSyntax, name: str, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.member(value = value, name = name, span = span))

    static func call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.call(callee = callee, type_arguments = type_arguments, arguments = arguments, span = span))

    static func index(value: ExpressionSyntax, subscript: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.index(value = value, subscript = subscript, span = span))

    static func slice(value: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.slice(value = value, start = start, operator = operator, end = end, span = span))

    static func lambda(parameters: list[ParameterSyntax], body: ExpressionSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.lambda(parameters = parameters, body = body, span = span))

    static func closure(captures: list[CaptureSyntax], parameters: list[ParameterSyntax], result: TypeSyntax?, effects: list[str], body: SuiteSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.closure(captures = captures, parameters = parameters, result = result, effects = effects, body = body, span = span))

    static func match_value(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.match_value(subject = subject, arms = arms, span = span))

    static func new_value(value_type: TypeSyntax, arguments: list[ArgumentSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.new_value(value_type = value_type, arguments = arguments, span = span))

    static func spawn_value(function: PathSyntax, arguments: list[ArgumentSyntax], span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.spawn_value(function = function, arguments = arguments, span = span))

    static func catch_value(value: ExpressionSyntax, failure_name: str, body: SuiteSyntax, span: SourceSpan) -> ExpressionSyntax:
        return ExpressionSyntax(form = ExpressionForm.catch_value(value = value, failure_name = failure_name, body = body, span = span))

# The tagged source form held by one `ExpressionSyntax` node.
union ExpressionForm:
    literal(token: Token)
    name(value: str, span: SourceSpan)
    case_value(name: str, arguments: list[ArgumentSyntax], span: SourceSpan)
    group(value: ExpressionSyntax, span: SourceSpan)
    tuple_value(elements: list[ExpressionSyntax], span: SourceSpan)
    list_value(elements: list[ExpressionSyntax], span: SourceSpan)
    map_value(entries: list[MapEntrySyntax], span: SourceSpan)
    unary(operator: str, operand: ExpressionSyntax, span: SourceSpan)
    binary(left: ExpressionSyntax, operator: str, right: ExpressionSyntax, span: SourceSpan)
    conditional(value: ExpressionSyntax, condition: ExpressionSyntax, alternative: ExpressionSyntax, span: SourceSpan)
    member(value: ExpressionSyntax, name: str, span: SourceSpan)
    call(callee: ExpressionSyntax, type_arguments: list[TypeArgumentSyntax], arguments: list[ArgumentSyntax], span: SourceSpan)
    index(value: ExpressionSyntax, subscript: ExpressionSyntax, span: SourceSpan)
    slice(value: ExpressionSyntax, start: ExpressionSyntax?, operator: str, end: ExpressionSyntax?, span: SourceSpan)
    lambda(parameters: list[ParameterSyntax], body: ExpressionSyntax, span: SourceSpan)
    closure(captures: list[CaptureSyntax], parameters: list[ParameterSyntax], result: TypeSyntax?, effects: list[str], body: SuiteSyntax, span: SourceSpan)
    match_value(subject: ExpressionSyntax, arms: list[MatchValueArmSyntax], span: SourceSpan)
    new_value(value_type: TypeSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    spawn_value(function: PathSyntax, arguments: list[ArgumentSyntax], span: SourceSpan)
    catch_value(value: ExpressionSyntax, failure_name: str, body: SuiteSyntax, span: SourceSpan)

# `value` or `(quotient, remainder)` on the left of a binding.
union BindingPatternSyntax:
    name(value: str, span: SourceSpan)
    tuple_names(values: list[str], span: SourceSpan)

# `_`, `'0'`, or `.open(path)` in a match arm.
union PatternSyntax:
    wildcard(span: SourceSpan)
    literal(token: Token)
    case_pattern(name: str, bindings: list[str], span: SourceSpan)

# mark: Statements -----------------------------------------------------------

# `ready` or `let value = optional` after `if`.
union ConditionSyntax:
    expression(value: ExpressionSyntax)
    binding(name: str, value: ExpressionSyntax, span: SourceSpan)

# `if ready: ...` or one following `elif retrying: ...` branch.
struct IfBranchSyntax:
    condition: ConditionSyntax
    body: SuiteSyntax
    span: SourceSpan

# `.save(path): save_document(path)` inside a statement match.
struct MatchStatementArmSyntax:
    pattern: PatternSyntax
    body: SuiteSyntax
    span: SourceSpan

# Bindings, assignments, control flow, returns, and call statements.
class StatementSyntax:
    form: StatementForm

    init(form: StatementForm):
        self.form = form

    static func break_statement(span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.break_statement(span = span))

    static func continue_statement(span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.continue_statement(span = span))

    static func binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.binding(is_mutable = is_mutable, pattern = pattern, annotation = annotation, value = value, span = span))

    static func assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.assignment(target = target, operator = operator, value = value, span = span))

    static func return_statement(value: ExpressionSyntax?, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.return_statement(value = value, span = span))

    static func defer_statement(value: ExpressionSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.defer_statement(value = value, span = span))

    static func recover_statement(value: ExpressionSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.recover_statement(value = value, span = span))

    static func expression_statement(value: ExpressionSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.expression_statement(value = value, span = span))

    static func if_statement(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.if_statement(branches = branches, fallback = fallback, span = span))

    static func while_statement(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.while_statement(condition = condition, body = body, span = span))

    static func for_statement(name: str, iterable: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.for_statement(name = name, iterable = iterable, body = body, span = span))

    static func match_statement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax], span: SourceSpan) -> StatementSyntax:
        return StatementSyntax(form = StatementForm.match_statement(subject = subject, arms = arms, span = span))

# The tagged source form held by one `StatementSyntax` node.
union StatementForm:
    break_statement(span: SourceSpan)
    continue_statement(span: SourceSpan)
    binding(is_mutable: bool, pattern: BindingPatternSyntax, annotation: TypeSyntax?, value: ExpressionSyntax, span: SourceSpan)
    assignment(target: ExpressionSyntax, operator: str, value: ExpressionSyntax, span: SourceSpan)
    return_statement(value: ExpressionSyntax?, span: SourceSpan)
    defer_statement(value: ExpressionSyntax, span: SourceSpan)
    recover_statement(value: ExpressionSyntax, span: SourceSpan)
    expression_statement(value: ExpressionSyntax, span: SourceSpan)
    if_statement(branches: list[IfBranchSyntax], fallback: SuiteSyntax?, span: SourceSpan)
    while_statement(condition: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    for_statement(name: str, iterable: ExpressionSyntax, body: SuiteSyntax, span: SourceSpan)
    match_statement(subject: ExpressionSyntax, arms: list[MatchStatementArmSyntax], span: SourceSpan)

# mark: Declarations ---------------------------------------------------------

# `import compiler.parser as parser`
struct ImportSyntax:
    path: PathSyntax
    alias_name: str?
    span: SourceSpan

# `func clamp(value: i64) -> i64: ...`, with or without an interface body.
struct FunctionSyntax:
    is_mutating: bool
    name: str
    generic_parameters: list[GenericParameterSyntax]
    parameters: list[ParameterSyntax]
    result: TypeSyntax?
    effects: list[str]
    body: SuiteSyntax?
    span: SourceSpan

# `weak var parent: Node? = none`
struct FieldSyntax:
    is_weak: bool
    is_mutable: bool
    name: str
    value_type: TypeSyntax
    default_value: ExpressionSyntax?
    span: SourceSpan

# A field or method declared inside a struct, class, enum, or interface.
union TypeMemberKind:
    field(value: FieldSyntax)
    function(value: FunctionSyntax)

# `public let width: u32` or `public func render(): ...` inside a type.
class TypeMemberSyntax:
    documentation: list[str]
    is_public: bool
    value: TypeMemberKind
    span: SourceSpan

    init(documentation: list[str], is_public: bool, value: TypeMemberKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# Distinguishes `struct Name:` from `class Name:`.
enum NominalTypeKind:
    struct_type
    class_type

# `struct Point[T] implements Hashable: ...`
struct NominalTypeSyntax:
    kind: NominalTypeKind
    name: str
    generic_parameters: list[GenericParameterSyntax]
    interfaces: list[TypeSyntax]
    members: list[TypeMemberSyntax]

# `radius: f64` in an enum-case payload or another named typed slot.
struct NamedTypeSyntax:
    name: str
    value_type: TypeSyntax
    span: SourceSpan

# `circle(radius: f64)` inside an enum.
struct EnumCaseSyntax:
    documentation: list[str]
    name: str
    payload: list[NamedTypeSyntax]
    span: SourceSpan

# `enum Shape[T] implements Drawable: ...`
struct EnumSyntax:
    name: str
    generic_parameters: list[GenericParameterSyntax]
    interfaces: list[TypeSyntax]
    cases: list[EnumCaseSyntax]
    methods: list[TypeMemberSyntax]

# `interface Reader[T]: ...`
struct InterfaceSyntax:
    name: str
    generic_parameters: list[GenericParameterSyntax]
    methods: list[TypeMemberSyntax]

# `let maximum: u64 = 100`
struct ConstantSyntax:
    name: str
    annotation: TypeSyntax?
    value: ExpressionSyntax

# `type Identifier = u64`
struct TypeAliasSyntax:
    name: str
    value: TypeSyntax

# `test "parser accepts a module": ...`
struct TestSyntax:
    description: Token
    effects: list[str]
    body: SuiteSyntax

# `export c struct Pixel: ...`
struct ExportStructSyntax:
    name: str
    fields: list[TypeMemberSyntax]

# `ready = 1` inside an exported C enum.
struct ExportEnumCaseSyntax:
    name: str
    value: Token
    span: SourceSpan

# `export c enum Status as u32: ...`
struct ExportEnumSyntax:
    name: str
    representation: str
    cases: list[ExportEnumCaseSyntax]

# Every non-import module declaration accepted by epoch 1.
union DeclarationKind:
    constant(value: ConstantSyntax)
    type_alias(value: TypeAliasSyntax)
    function(value: FunctionSyntax)
    nominal_type(value: NominalTypeSyntax)
    enumeration(value: EnumSyntax)
    interface_type(value: InterfaceSyntax)
    test_declaration(value: TestSyntax)
    export_struct(value: ExportStructSyntax)
    export_enum(value: ExportEnumSyntax)
    export_function(value: FunctionSyntax)

# Documentation and visibility wrapped around one module declaration.
class DeclarationSyntax:
    documentation: list[str]
    is_public: bool
    value: DeclarationKind
    span: SourceSpan

    init(documentation: list[str], is_public: bool, value: DeclarationKind, span: SourceSpan):
        self.documentation = documentation
        self.is_public = is_public
        self.value = value
        self.span = span

# One `.luc` file: leading imports followed by module declarations.
struct ModuleSyntax:
    tokens: list[Token]
    imports: list[ImportSyntax]
    declarations: list[DeclarationSyntax]
    span: SourceSpan
