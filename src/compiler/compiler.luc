from compiler.tokenizer import Tokenizer, dump
import std.files

class Compiler:
    init():
        return

    # Read and tokenize each source file, printing its token stream. Later
    # stages (parser, typed IR, backend) will chain on from here.
    func compile(paths: list[str]) -> !:
        for path in paths:
            try self.compile_file(path)

    private func compile_file(path: str) -> !:
        let source = try files.read(path)
        let tokens = try Tokenizer(source).tokenize()
        print("# " + path)
        print(dump(tokens))
