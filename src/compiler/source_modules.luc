#==============================================================================================
#
#   source_modules - Package-relative source module identities
#
#   DESCRIPTION:
#       Converts an explicitly rooted source path into the dotted module name
#       mandated by §20.1. Filesystem spelling is consumed at the product
#       boundary; HIR receives only the stable package-relative identity.
#
#==============================================================================================

from compiler.hir.ir import ModuleAuthority
import std.strings

# mark: Module paths ===========================================================================

## Derive one dotted module identity from a lexically package-relative `.luc`
## path. The caller owns filesystem discovery and supplies the exact root.
pub func source_module_name(source_root: str, source_path: str, authority: ModuleAuthority) -> str!:
    let relative = try relative_source_path(source_root, source_path)
    var suffix_length = 4
    if authority == ModuleAuthority.native: suffix_length = 11
    if len(relative) <= suffix_length:
        error("source path `" + source_path + "` does not name a module")
    let suffix = relative[len(relative) - suffix_length:]
    if authority == ModuleAuthority.native:
        if suffix != ".native.luc": error("native source path `" + source_path + "` must end in `.native.luc`")
    elif suffix != ".luc":
        error("source path `" + source_path + "` must end in `.luc`")

    let components = strings.split(relative[:len(relative) - suffix_length], "/")
    var dotted = ""
    for component in components:
        if not is_identifier(component):
            error("source path `" + source_path + "` has invalid module component `" + component + "`")
        if dotted != "": dotted += "."
        dotted += component
    return dotted

func relative_source_path(source_root: str, source_path: str) -> str!:
    if source_root == "": error("package source root cannot be empty")
    if source_path == "": error("source path cannot be empty")
    if len(source_root) > 1 and source_root[len(source_root) - 1] == '/':
        error("package source root must not end in `/`")

    var relative = ""
    if source_root == ".":
        relative = source_path
        if len(relative) >= 2 and relative[:2] == "./": relative = relative[2:]
    elif source_root == "/":
        if source_path[0] != '/': error("source path `" + source_path + "` is outside package source root `/`")
        relative = source_path[1:]
    elif len(source_path) > len(source_root) and source_path[:len(source_root)] == source_root and source_path[len(source_root)] == '/':
        relative = source_path[len(source_root) + 1:]
    else:
        error("source path `" + source_path + "` is outside package source root `" + source_root + "`")

    if relative == "": error("source path `" + source_path + "` does not name a module")
    for component in strings.split(relative, "/"):
        if component == "" or component == "." or component == "..":
            error("source path `" + source_path + "` is not a canonical package-relative path")
    return relative

func is_identifier(value: str) -> bool:
    if len(value) == 0: return false
    if value[0] != '_' and not strings.is_alpha(value[0]): return false
    for index in range(1, len(value)):
        if value[index] != '_' and not strings.is_alnum(value[index]): return false
    return true
