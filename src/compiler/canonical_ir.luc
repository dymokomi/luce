#==============================================================================================
#
#   canonical_ir - The backend-independent machine representation
#
#   DESCRIPTION:
#       Canonical MIR is the compiler's target-independent machine
#       representation: what semantic typed HIR lowers into, what verification
#       and optimization operate on, and the one shape every compiled backend
#       consumes. Evaluation order is explicit: operands are pushed before the
#       instruction that consumes them, like a stack machine. `2 + 3` becomes:
#
#       Constant(2, i64)
#       Constant(3, i64)
#       Add(i64)
#
#       The instruction set is one language. Backends legalize it to a target;
#       they do not keep a private dialect. Integer widths live on the
#       instruction as `CanonicalType` so i8/u32 can join later without a new
#       opcode family. `WriteText` is a host effect: native backends turn it
#       into a write syscall, WebAssembly into an imported write. Process
#       entry (`main` -> i32) is an artifact convention, not a second IR.
#
#       The instruction set grows with the executable slice; today that means
#       integer arithmetic, constant terminal output, and returning. This flat
#       stack form is the first MIR slice, not a commitment to stay stack-based:
#       explicit values, basic blocks, branches, calls, and memory operations
#       belong here as the language becomes executable enough to need them.
#
#==============================================================================================

## The machine types canonical MIR can name today. Names are not identity;
## backends and the verifier compare these tags, not diagnostic spellings.
pub enum CanonicalType:
    signed_i32
    signed_i64

## One canonical operation. Constants push a typed value; arithmetic pops two
## operands of `operand_type` and pushes the result; `WriteText` is an effect;
## `Return` pops the final value and leaves the function.
pub union CanonicalInstruction:
    Constant(value: i64, value_type: CanonicalType)
    Add(operand_type: CanonicalType)
    Subtract(operand_type: CanonicalType)
    Multiply(operand_type: CanonicalType)
    WriteText(value: str)
    Return

## One lowered function, named `module.function` so artifacts stay unambiguous
## across modules.
pub struct CanonicalFunction:
    pub name: str
    pub is_public: bool
    pub result: CanonicalType
    pub instructions: list[CanonicalInstruction]

## Diagnostic spelling of one canonical type. Semantic decisions compare the
## `CanonicalType` tag; this string is only for messages.
pub func describe_canonical_type(value: CanonicalType) -> str:
    return match value:
        signed_i32 => "i32"
        signed_i64 => "i64"

## The canonical machine representation of one whole program. Verification and
## optimization consume and return this value before a target backend sees it.
pub struct CanonicalProgram:
    pub functions: list[CanonicalFunction]
