# The small, backend-independent instruction stream produced after semantic
# checking. Evaluation order is explicit: operands are pushed before the
# instruction that consumes them.

union CanonicalInstruction:
    I64Constant(value: i64)
    I64Add
    I64Subtract
    I64Multiply
    Return

struct CanonicalFunction:
    name: str
    is_public: bool
    instructions: list[CanonicalInstruction]

struct CanonicalProgram:
    functions: list[CanonicalFunction]
