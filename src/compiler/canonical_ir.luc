# The small, backend-independent instruction stream produced after semantic
# checking. Evaluation order is explicit: operands are pushed before the
# instruction that consumes them.

pub union CanonicalInstruction:
    I64Constant(value: i64)
    I64Add
    I64Subtract
    I64Multiply
    Return

pub struct CanonicalFunction:
    pub name: str
    pub is_public: bool
    pub instructions: list[CanonicalInstruction]

pub struct CanonicalProgram:
    pub functions: list[CanonicalFunction]
