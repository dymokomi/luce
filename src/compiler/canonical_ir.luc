#==============================================================================================
#
#   canonical_ir - The backend-independent instruction stream
#
#   DESCRIPTION:
#       What the lowerer produces after semantic checking, and the one shape
#       every compiled backend consumes. Evaluation order is explicit: operands
#       are pushed before the instruction that consumes them, like a stack
#       machine. `2 + 3` becomes:
#
#       I64Constant(2)
#       I64Constant(3)
#       I64Add
#
#       The instruction set grows with the executable slice; today that means
#       integer arithmetic, constant terminal output, and returning.
#
#==============================================================================================

## One canonical operation. Constants push a value; arithmetic pops two and
## pushes the result; `Return` pops the final value and leaves the function.
pub union CanonicalInstruction:
    I32Constant(value: i64)
    I64Constant(value: i64)
    I64Add
    I64Subtract
    I64Multiply
    WriteText(value: str)
    Return

## One lowered function, named `module.function` so artifacts stay unambiguous
## across modules.
pub struct CanonicalFunction:
    pub name: str
    pub is_public: bool
    pub result: str
    pub instructions: list[CanonicalInstruction]

## One lowered program, ready for any artifact backend.
pub struct CanonicalProgram:
    pub functions: list[CanonicalFunction]
