#==============================================================================================
#
#   tokenizer - Source text into tokens
#
#   DESCRIPTION:
#       Reads source text from left to right and emits the token stream consumed
#       by the parser. Logical lines become NEWLINE/INDENT/DEDENT layout tokens;
#       blank lines and ordinary comments remain invisible.
#
#       Inside `()`, `[]`, and `{}` newlines are ordinary spacing, except that a
#       `:` ending its line opens an indented suite whose layout tokens resume
#       until the enclosing delimiter closes (a block closure, `catch` handler,
#       or `match` expression written as an argument).
#
#       A formatted string is not one token: `f"a {b} c"` becomes format_start,
#       format_text, the field's own tokens between `{` and `}`, more text, and
#       format_end, so the parser reads each field as an ordinary expression.
#
#       Literal tokens keep their exact source spelling for later compiler stages.
#       Public use begins at `Tokenizer.tokenize`; scanning rules, source movement,
#       and diagnostics stay private below it.
#
#==============================================================================================

from compiler.source import SourceSpan, format_location
import std.strings

# mark: Token model ==========================================================================

## Identifies one lexical token family.
pub enum TokenKind:
    name
    keyword
    int_lit
    float_lit
    str_lit
    byte_lit
    char_lit
    format_start
    format_text
    format_end
    symbol
    newline
    indent
    dedent
    doc_comment
    eof

## Preserves one token's source spelling, optional numeric suffix, and location.
pub struct Token:
    pub kind: TokenKind
    pub text: str
    pub suffix: str
    pub span: SourceSpan

# An indentation region opened by a suite-opening `:` inside delimiters: layout
# is live while exactly `depth` delimiters are open, and the region's block
# dedents back to `base` when its delimiter closes.
struct LayoutRegion:
    depth: i64
    base: i64

# One formatted string whose field is being scanned; the location names the
# string in diagnostics, and `is_triple` decides whether lines may be crossed.
struct FormattedMode:
    is_triple: bool
    line: i64
    column: i64

## Converts one complete source string into a layout-aware token stream.
pub class Tokenizer:
    source: str
    position: i64
    line: i64
    line_start: i64
    tokens: list[Token]
    indent_width: i64
    open_delimiters: list[char]
    pending_layout: bool
    layout_regions: list[LayoutRegion]
    formatted_modes: list[FormattedMode]
    # Where a triple-quoted field's `}"""` was swallowed by a comment, if ever.
    commented_close_line: i64
    commented_close_column: i64

    ## Create a tokenizer positioned before the first source character.
    ## Example: `Tokenizer("name")` starts at line 1, column 1 with no tokens.
    pub init(source: str):
        self.source = source
        self.position = 0
        self.line = 1
        self.line_start = 0
        self.tokens = list[Token]()
        self.indent_width = 0
        self.open_delimiters = list[char]()
        self.pending_layout = true
        self.layout_regions = list[LayoutRegion]()
        self.formatted_modes = list[FormattedMode]()
        self.commented_close_line = 0
        self.commented_close_column = 0

    # mark: Tokenization ========================================================================

    ## Tokenize the complete source or stop at its first invalid lexical form.
    ## Example: `let value = 1` emits keyword, name, symbol, int_lit, newline, eof.
    pub func tokenize() -> list[Token]!:
        try self.validate_source()
        while not self.has_reached_end():
            if self.pending_layout and self.layout_active():
                try self.scan_line_start()
            else:
                try self.scan_token()
        try self.finish_tokenization()
        return self.tokens

    # Validate source-wide rules before tokenization. The stage-0 `str` boundary
    # already guarantees valid UTF-8, so this pass handles the remaining source
    # restrictions and makes a byte-zero BOM invisible to token columns.
    # Example: a leading BOM is skipped, while `left<TAB>right` reports column 5.
    func validate_source() -> !:
        if len(self.source) > 0 and self.source[0] == '\u{feff}':
            self.position = 1
            self.line_start = 1

        var position = self.position
        var source_line = 1
        var source_column = 1
        while position < len(self.source):
            let character = self.source[position]
            if character == '\u{0}':
                error(format_location(source_line, source_column) + "NUL is not allowed in source")
            if character == '\u{feff}':
                error(
                    format_location(source_line, source_column)
                    + "a UTF-8 BOM is allowed only at byte zero"
                )
            if is_bidi_control(character):
                error(
                    format_location(source_line, source_column)
                    + "bidirectional controls are not allowed in source"
                )
            if character == '\t':
                error(format_location(source_line, source_column) + "tabs are not allowed; use spaces")

            if character == '\r':
                if position + 1 >= len(self.source) or self.source[position + 1] != '\n':
                    error(
                        format_location(source_line, source_column)
                        + "carriage return must be followed by newline"
                    )
                position += 2
                source_line += 1
                source_column = 1
            elif character == '\n':
                position += 1
                source_line += 1
                source_column = 1
            else:
                position += 1
                source_column += 1

    # mark: Layout ==============================================================================

    # Resolve indentation at the start of a logical line. Blank and comment-only
    # lines are skipped first, so they never change the active block depth.
    # Example: the four spaces before `value` in `if ok:\n    value` emit indent.
    func scan_line_start() -> !:
        while not self.has_reached_end():
            var width = 0
            while self.position + width < len(self.source) and self.source[self.position + width] == ' ':
                width += 1
            let content_position = self.position + width

            if content_position >= len(self.source):
                self.position = content_position
                return
            if self.source[content_position] == '\n' or self.source[content_position] == '\r':
                self.position = content_position
                self.advance_line()
            elif self.source[content_position] == '#':
                self.position = content_position
                if self.matches_source("##"):
                    try self.update_indentation(width)
                    self.scan_documentation()
                else:
                    self.skip_comment()
            else:
                self.position = content_position
                try self.update_indentation(width)
                self.pending_layout = false
                return

    # Every block step is exactly four spaces, so the current width contains the
    # same information that a general indentation stack would contain.
    # Example: width 0 -> 4 emits indent; width 8 -> 0 emits two dedent tokens.
    func update_indentation(width: i64) -> !:
        if len(self.layout_regions) > 0 and width < self.layout_regions[len(self.layout_regions) - 1].base:
            error(
                self.format_location_at(width + 1)
                + "a suite inside delimiters cannot dedent past the line that opened it"
            )
        if width > self.indent_width:
            if width != self.indent_width + 4:
                error(self.format_location_at(width + 1) + "indentation must increase by four spaces")
            self.indent_width = width
            self.emit(TokenKind.indent, "", width + 1)
            return

        while width < self.indent_width:
            self.indent_width -= 4
            self.emit(TokenKind.dedent, "", width + 1)
        if width != self.indent_width:
            error(self.format_location_at(width + 1) + "dedent does not match any outer indentation")
        # Dedenting back to the opening line closes a delimiter suite: the
        # remaining tokens up to the delimiter are ordinary spacing-only source.
        if len(self.layout_regions) > 0 and width == self.layout_regions[len(self.layout_regions) - 1].base:
            self.layout_regions.remove(len(self.layout_regions) - 1)

    # Preserve documentation as a token; unlike an ordinary comment, it belongs
    # to the declaration or member that follows it.
    # Example: `## Stored value.` emits one doc_comment with that exact spelling.
    func scan_documentation():
        let start = self.position
        let column = self.calculate_column()
        self.skip_comment()
        self.emit(TokenKind.doc_comment, self.source[start:self.position], column)

    # Consume an ordinary comment but leave its physical newline for layout.
    # Inside a triple-quoted field the comment owns the rest of the line, so an
    # apparent `}"""` inside it is remembered for the diagnostic at EOF.
    # Example: in `name # note\n`, this stops on `\n` after consuming `# note`.
    func skip_comment():
        while not self.has_reached_end() and self.peek() != '\n' and self.peek() != '\r':
            if len(self.formatted_modes) > 0 and self.commented_close_line == 0 and self.matches_source("}\"\"\""):
                self.commented_close_line = self.line
                self.commented_close_column = self.calculate_column()
            self.position += 1

    # Layout is live at the top level and inside a suite opened within
    # delimiters, but suspended by any delimiter opened deeper than that suite.
    # Example: in `run(func ():\n    g(\n1))`, the line after `g(` is spacing.
    func layout_active() -> bool:
        if len(self.layout_regions) == 0:
            return len(self.open_delimiters) == 0
        return len(self.open_delimiters) == self.layout_regions[len(self.layout_regions) - 1].depth

    # mark: Tokens ==============================================================================

    # Scan one significant token, or advance past insignificant source.
    # Each token family owns its detailed scanning rules below.
    # Example: at `42` it calls scan_number; at `(` it calls scan_symbol.
    func scan_token() -> !:
        let start = self.position
        let start_line = self.line
        let column = self.calculate_column()
        let character = self.peek()

        if character == ' ':
            self.position += 1
            return
        if character == '#':
            try self.require_multiline_field()
            self.skip_comment()
            return
        if character == '\n' or character == '\r':
            try self.require_multiline_field()
            if self.layout_active():
                self.emit(TokenKind.newline, "", column)
                self.pending_layout = true
            self.advance_line()
            return

        # A prefix is part of a string/byte literal only when a quote follows it.
        if is_string_prefix(character) and self.peek(1) == '"':
            try self.scan_string_literal(start, start_line, column, character)
            return
        if character == '"':
            try self.scan_string_literal(start, start_line, column, '\u{0}')
            return
        if character == '\'':
            try self.scan_character_body()
            self.emit(TokenKind.char_lit, self.source[start:self.position], column)
            return
        # `_` alone is the wildcard symbol; with another identifier character
        # it begins an ordinary name such as `_unused`.
        if strings.is_alpha(character) or (character == '_' and is_identifier_continue(self.peek(1))):
            self.scan_word(start, column)
            return
        if strings.is_digit(character):
            try self.scan_number(start, column)
            return
        let width = self.measure_symbol_width()
        if width > 0:
            try self.scan_symbol(start, column, width)
            return

        error(self.format_location_at(column) + "unexpected character")

    # Scan a word and classify reserved spellings as keywords.
    # Example: `while` emits keyword, while `while_ready2` emits name.
    func scan_word(start: i64, column: i64):
        self.position += 1
        while is_identifier_continue(self.peek()):
            self.position += 1
        let word = self.source[start:self.position]
        if is_keyword(word): self.emit(TokenKind.keyword, word, column)
        else: self.emit(TokenKind.name, word, column)

    # mark: Strings and characters ==============================================================

    # String prefixes have deliberately separate meanings: r disables escapes,
    # f opens a formatted string whose fields are tokenized in place, and b
    # selects the byte-literal token kind.
    # Example: `b"ABC"` emits byte_lit; `r"\n"` emits str_lit without decoding.
    func scan_string_literal(start: i64, start_line: i64, column: i64, prefix: char) -> !:
        if prefix != '\u{0}': self.position += 1
        if prefix == 'f':
            let is_triple = self.matches_source("\"\"\"")
            if is_triple:
                self.position += 3
            else:
                self.position += 1
            self.emit_at(TokenKind.format_start, self.source[start:self.position], start_line, column)
            self.formatted_modes.append(FormattedMode(is_triple = is_triple, line = start_line, column = column))
            try self.scan_formatted_text()
            return

        try self.scan_string_body(prefix, start_line, column)
        if prefix == 'b':
            self.emit_at(TokenKind.byte_lit, self.source[start:self.position], start_line, column)
        else:
            self.emit_at(TokenKind.str_lit, self.source[start:self.position], start_line, column)

    # Consume either a single-line or triple-quoted body. Triple strings update
    # source positions for every physical line but remain one literal token.
    # Example: `"""first\nsecond"""` advances a line but stays one string body.
    func scan_string_body(prefix: char, start_line: i64, column: i64) -> !:
        let is_raw = prefix == 'r'
        let byte_mode = prefix == 'b'
        let is_triple = self.matches_source("\"\"\"")
        if is_triple:
            self.position += 3
        else:
            self.position += 1

        while not self.has_reached_end():
            if is_triple and self.matches_source("\"\"\""):
                self.position += 3
                return

            let character = self.peek()
            if not is_triple and character == '"':
                self.position += 1
                return
            if not is_raw and character == '\\':
                try self.scan_escape(byte_mode)
            elif character == '\n' or character == '\r':
                if not is_triple:
                    error(format_location(start_line, column) + "unterminated string literal")
                self.advance_line()
            else:
                if byte_mode and character > '\u{7f}':
                    error(
                        self.format_location_at(self.calculate_column())
                        + "byte literals require ASCII source characters"
                    )
                self.position += 1

        error(format_location(start_line, column) + "unterminated string literal")

    # Consume the literal text of the innermost formatted string up to its next
    # field or closing quote. Text is emitted with its `{{`/`}}` spellings
    # intact; a field's `{` is pushed as the delimiter `f` so its tokens are
    # scanned by the ordinary rules and its `}` returns here.
    # Example: `f"a {b} c"` emits format_start, text `a `, `{`, name, `}`, text ` c`, format_end.
    func scan_formatted_text() -> !:
        let mode = self.formatted_modes[len(self.formatted_modes) - 1]
        let start = self.position
        let start_line = self.line
        let column = self.calculate_column()
        while not self.has_reached_end():
            let character = self.peek()
            if mode.is_triple and self.matches_source("\"\"\""):
                self.emit_formatted_text(start, start_line, column)
                let close_column = self.calculate_column()
                self.position += 3
                self.emit(TokenKind.format_end, "\"\"\"", close_column)
                self.formatted_modes.remove(len(self.formatted_modes) - 1)
                return
            if not mode.is_triple and character == '"':
                self.emit_formatted_text(start, start_line, column)
                let close_column = self.calculate_column()
                self.position += 1
                self.emit(TokenKind.format_end, "\"", close_column)
                self.formatted_modes.remove(len(self.formatted_modes) - 1)
                return
            if character == '\\':
                try self.scan_escape(false)
            elif character == '{':
                if self.matches_source("{{"):
                    self.position += 2
                else:
                    self.emit_formatted_text(start, start_line, column)
                    let brace_column = self.calculate_column()
                    self.position += 1
                    self.open_delimiters.append('f')
                    self.emit(TokenKind.symbol, "{", brace_column)
                    return
            elif character == '}':
                if self.matches_source("}}"):
                    self.position += 2
                else:
                    error(format_location(mode.line, mode.column) + "unescaped '}' in formatted string")
            elif character == '\n' or character == '\r':
                if not mode.is_triple:
                    error(format_location(mode.line, mode.column) + "unterminated string literal")
                self.advance_line()
            else:
                self.position += 1
        error(format_location(mode.line, mode.column) + "unterminated string literal")

    # Emit the text scanned so far as one format_text token, skipping empty runs
    # so `f"{a}{b}"` carries no vacuous text between its fields.
    func emit_formatted_text(start: i64, start_line: i64, column: i64):
        if self.position > start:
            self.emit_at(TokenKind.format_text, self.source[start:self.position], start_line, column)

    # A field of a single-line formatted string ends on its own line: neither a
    # newline nor a comment (which owns the rest of the line) may appear in it.
    # Example: `f"{value # }"` and `f"{value\n}"` both report the string's start.
    func require_multiline_field() -> !:
        if len(self.formatted_modes) == 0:
            return
        let mode = self.formatted_modes[len(self.formatted_modes) - 1]
        if not mode.is_triple:
            error(format_location(mode.line, mode.column) + "formatted string interpolation cannot cross a line")

    # Consume a character literal body and require exactly one decoded scalar.
    # Example: `'a'` and `'\n'` succeed, while `'ab'` reports a lexical error.
    func scan_character_body() -> !:
        let start_line = self.line
        let column = self.calculate_column()
        self.position += 1
        var scalars = 0
        while not self.has_reached_end():
            let character = self.peek()
            if character == '\\':
                try self.scan_escape(false)
                scalars += 1
            elif character == '\'':
                self.position += 1
                if scalars != 1:
                    error(
                        format_location(start_line, column)
                        + "character literal must contain one Unicode scalar"
                    )
                return
            elif character == '\n' or character == '\r':
                error(format_location(start_line, column) + "unterminated character literal")
            else:
                scalars += 1
                self.position += 1
        error(format_location(start_line, column) + "unterminated character literal")

    # Validate the finite escape vocabulary while leaving actual value decoding
    # to the literal-lowering pass.
    # Example: `\u{41}` is valid everywhere; `\x41` is valid only in byte mode.
    func scan_escape(byte_mode: bool) -> !:
        let escape_column = self.calculate_column()
        self.position += 1
        if self.has_reached_end() or self.peek() == '\n' or self.peek() == '\r':
            error(self.format_location_at(escape_column) + "unterminated literal escape")

        let escaped = self.peek()
        let is_simple_escape = (
            escaped == '\\' or escaped == '"' or escaped == '\''
            or escaped == 'n' or escaped == 'r' or escaped == 't' or escaped == '0'
        )
        if is_simple_escape:
            self.position += 1
            return

        if escaped == 'u' and self.peek(1) == '{':
            self.position += 2
            var digits = 0
            var scalar = 0
            while is_hex_digit(self.peek()):
                scalar = scalar * 16 + decode_hex_digit(self.peek())
                digits += 1
                self.position += 1
            if digits == 0 or digits > 6 or self.peek() != '}':
                error(self.format_location_at(escape_column) + "Unicode escape must be \\u{HEX}")
            if scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
                error(self.format_location_at(escape_column) + "Unicode escape is not a scalar value")
            self.position += 1
            return

        if byte_mode and escaped == 'x':
            self.position += 1
            if not is_hex_digit(self.peek()) or not is_hex_digit(self.peek(1)):
                error(
                    self.format_location_at(escape_column)
                    + "byte escape must contain exactly two hex digits"
                )
            self.position += 2
            return

        error(self.format_location_at(escape_column) + "invalid literal escape")

    # mark: Numbers =============================================================================

    # Consume and validate a complete numeric spelling. Literal lowering still
    # owns value conversion and contextual range checks.
    # Example: `0xffu8` emits int_lit with suffix `u8`; `1.5f32` emits float_lit.
    func scan_number(start: i64, column: i64) -> !:
        var kind = TokenKind.int_lit
        var suffix = ""
        if self.peek() == '0' and (self.peek(1) == 'X' or self.peek(1) == 'O' or self.peek(1) == 'B'):
            error(self.format_location_at(column) + "based integer prefixes must use lowercase `0x`, `0o`, or `0b`")
        if self.peek() == '0' and is_base_prefix(self.peek(1)):
            let base = self.peek(1)
            self.position += 2
            try self.scan_digit_sequence(base)
            if strings.is_digit(self.peek()):
                error(
                    self.format_location_at(self.calculate_column())
                    + "digit is not valid for this numeric base"
                )
            suffix = self.scan_numeric_suffix()
            if len(suffix) > 0 and not is_integer_suffix(suffix):
                error(self.format_location_at(column) + "invalid integer literal suffix")
        else:
            try self.scan_digit_sequence('d')
            # A dot starts a fraction only when a digit follows. This keeps both
            # `1.member` and the range spellings unambiguous.
            if self.peek() == '.' and strings.is_digit(self.peek(1)):
                kind = TokenKind.float_lit
                self.position += 1
                try self.scan_digit_sequence('d')
            if self.peek() == 'e' or self.peek() == 'E':
                kind = TokenKind.float_lit
                self.position += 1
                if self.peek() == '+' or self.peek() == '-':
                    self.position += 1
                try self.scan_digit_sequence('d')

            suffix = self.scan_numeric_suffix()
            if is_float_suffix(suffix):
                kind = TokenKind.float_lit
            elif len(suffix) > 0 and (kind == TokenKind.float_lit or not is_integer_suffix(suffix)):
                error(self.format_location_at(column) + "invalid numeric literal suffix")
        self.emit(kind, self.source[start:self.position], column, suffix)

    # Consume digits and separating underscores for one numeric base.
    # Example: base `b` accepts `1010_0011`, but rejects `102` and `1__0`.
    func scan_digit_sequence(base: char) -> !:
        let column = self.calculate_column()
        var has_digit = false
        var after_separator = false
        while is_digit_for_base(self.peek(), base) or self.peek() == '_':
            if self.peek() == '_':
                if not has_digit or after_separator:
                    error(
                        self.format_location_at(self.calculate_column())
                        + "underscores must separate numeric digits"
                    )
                after_separator = true
            else:
                has_digit = true
                after_separator = false
            self.position += 1
        if not has_digit:
            error(self.format_location_at(column) + "numeric literal requires a digit")
        if after_separator:
            error(
                self.format_location_at(self.calculate_column() - 1)
                + "numeric literal cannot end with underscore"
            )

    # Consume an identifier-shaped numeric suffix, leaving validation to the caller.
    # Example: at the `u` in `u16`, this returns `u16`; at whitespace it returns "".
    func scan_numeric_suffix() -> str:
        if not strings.is_alpha(self.peek()):
            return ""
        let start = self.position
        while is_identifier_continue(self.peek()):
            self.position += 1
        return self.source[start:self.position]

    # mark: Symbols and delimiters ==============================================================

    # Emit one matched symbol and update the delimiter stack when needed.
    # Example: `(` pushes an opener, `)` closes it, and `+=` changes no stack state.
    func scan_symbol(start: i64, column: i64, width: i64) -> !:
        let text = self.source[start:start + width]
        self.position = start + width

        var closes_field = false
        if width == 1:
            let symbol = text[0]
            if symbol == '(' or symbol == '[' or symbol == '{':
                self.open_delimiters.append(symbol)
            elif symbol == ')' or symbol == ']' or symbol == '}':
                self.finish_layout_region()
                closes_field = try self.close_delimiter(symbol, column)
            elif symbol == ':' and len(self.open_delimiters) > 0 and self.colon_ends_line():
                self.layout_regions.append(LayoutRegion(
                    depth = len(self.open_delimiters),
                    base = self.indent_width,
                ))
        self.emit(TokenKind.symbol, text, column)
        if closes_field:
            try self.scan_formatted_text()

    # A `:` inside delimiters opens a suite exactly when nothing but spacing or
    # a comment follows it on the line, which is the only place a suite can go.
    # Example: `run(func ():` qualifies; the `:` in `run(label: 1)` does not.
    func colon_ends_line() -> bool:
        var offset = 0
        while self.peek(offset) == ' ':
            offset += 1
        let next = self.peek(offset)
        return next == '#' or next == '\n' or next == '\r' or next == '\u{0}'

    # Close the suite still open when its delimiter closes on the suite's last
    # line: the statement gets the newline it lacked, then every dedent to base.
    # Example: `run(func ():\n    return 1)` emits newline and dedent before `)`.
    func finish_layout_region():
        if len(self.layout_regions) == 0:
            return
        let region = self.layout_regions[len(self.layout_regions) - 1]
        if region.depth != len(self.open_delimiters):
            return
        let last = self.tokens[len(self.tokens) - 1]
        if last.kind != TokenKind.newline:
            self.emit(TokenKind.newline, "", self.calculate_column() - 1)
        while self.indent_width > region.base:
            self.indent_width -= 4
            self.emit(TokenKind.dedent, "", self.calculate_column() - 1)
        self.layout_regions.remove(len(self.layout_regions) - 1)

    # Longest-match ordering is visible here: expression/pattern ranges and
    # augmented assignments win before their shorter prefixes.
    # Example: at `..=`, this returns 3 rather than matching the shorter `..`.
    func measure_symbol_width() -> i64:
        if self.matches_source("//=") or self.matches_source("<<=") or self.matches_source(">>="): return 3
        if self.matches_source("..<") or self.matches_source("..="): return 3
        let is_arrow_or_equality = (
            self.matches_source("->") or self.matches_source("=>")
            or self.matches_source("==") or self.matches_source("!=")
        )
        if is_arrow_or_equality: return 2
        if self.matches_source("<=") or self.matches_source(">=") or self.matches_source("//"): return 2
        if self.matches_source("<<") or self.matches_source(">>") or self.matches_source("+="): return 2
        if self.matches_source("-=") or self.matches_source("*=") or self.matches_source("/="): return 2
        let is_augmented_bitwise = (
            self.matches_source("%=") or self.matches_source("&=")
            or self.matches_source("|=") or self.matches_source("^=")
        )
        if is_augmented_bitwise: return 2
        if self.matches_source(".."): return 2
        if is_single_symbol(self.peek()): return 1
        return 0

    # Match and remove the latest opening delimiter or report the mismatch.
    # Returns whether the closed delimiter was a formatted string's field.
    # Example: `([ ])` closes successfully, while `(]` reports the `]` column.
    func close_delimiter(closing: char, column: i64) -> bool!:
        if len(self.open_delimiters) == 0:
            error(self.format_location_at(column) + "closing delimiter has no matching opener")
        let opening = self.open_delimiters[len(self.open_delimiters) - 1]
        if closing != find_closing_delimiter(opening):
            error(self.format_location_at(column) + "closing delimiter does not match its opener")
        self.open_delimiters.remove(len(self.open_delimiters) - 1)
        return opening == 'f'

    # mark: Completion ==========================================================================

    # Complete the stream with its synthetic newline, remaining dedents, and eof.
    # Example: `if ok:\n    value` ends with newline, dedent, eof.
    func finish_tokenization() -> !:
        if len(self.formatted_modes) > 0:
            if self.commented_close_line > 0:
                error(
                    format_location(self.commented_close_line, self.commented_close_column)
                    + "formatted string interpolation cannot close inside a comment; put `}` on a later line"
                )
            let mode = self.formatted_modes[len(self.formatted_modes) - 1]
            error(format_location(mode.line, mode.column) + "unterminated formatted string interpolation")
        if len(self.open_delimiters) > 0:
            error(self.format_location_at(self.calculate_column()) + "unclosed delimiter")

        if len(self.tokens) > 0:
            let last = self.tokens[len(self.tokens) - 1]
            let needs_newline = (
                last.kind != TokenKind.newline
                and last.kind != TokenKind.indent
                and last.kind != TokenKind.dedent
                and last.kind != TokenKind.doc_comment
            )
            if needs_newline:
                self.emit(TokenKind.newline, "", self.calculate_column())
        while self.indent_width > 0:
            self.indent_width -= 4
            self.emit(TokenKind.dedent, "", self.calculate_column())
        self.emit(TokenKind.eof, "", self.calculate_column())

    # mark: Source cursor =======================================================================

    # Consume one LF or CRLF sequence and move the cursor to the next line.
    # Example: after consuming `\r\n`, line increases once and column becomes 1.
    func advance_line():
        if self.peek() == '\r':
            self.position += 2
        else:
            self.position += 1
        self.line += 1
        self.line_start = self.position

    # Emit a token whose starting line is the tokenizer's current line.
    # Example: after scanning `name`, emit(TokenKind.name, "name", 1) records line 1.
    func emit(kind: TokenKind, text: str, column: i64, suffix: str = ""):
        self.emit_at(kind, text, self.line, column, suffix)

    # Emit a token using an explicit starting line for tokens spanning many lines.
    # Example: a triple string ending on line 3 can still record token_line 1.
    func emit_at(kind: TokenKind, text: str, token_line: i64, column: i64, suffix: str = ""):
        let span = SourceSpan(
            start = self.position - len(text),
            end = self.position,
            line = token_line,
            column = column,
        )
        self.tokens.append(Token(kind = kind, text = text, suffix = suffix, span = span))

    # Calculate the one-based column at the current source position.
    # Example: position 7 with line_start 4 produces column 4.
    func calculate_column() -> i64:
        return self.position - self.line_start + 1

    # Format a diagnostic prefix using the current line and a supplied column.
    # Example: on line 3, column 5 becomes `3:5: `.
    func format_location_at(column: i64) -> str:
        return format_location(self.line, column)

    # Test whether text begins exactly at the current source position.
    # Example: at the first dot in `..=`, matches_source("..=") is true.
    func matches_source(text: str) -> bool:
        if self.position + len(text) > len(self.source): return false
        return self.source[self.position:self.position + len(text)] == text

    # Report whether the cursor has consumed every source character.
    # Example: position 3 has reached the end of a three-character source.
    func has_reached_end() -> bool:
        return self.position >= len(self.source)

    # Sentinel peeks keep scanners compact. Raw NUL source is rejected by the
    # validation pass, so the sentinel can never be mistaken for source text.
    # Example: at `a` in `ab`, peek(1) returns `b`; past `b`, it returns NUL.
    func peek(offset: i64 = 0) -> char:
        if self.position + offset >= len(self.source): return '\u{0}'
        return self.source[self.position + offset]


# mark: Lexical rules ========================================================================

# Recognize Unicode characters that can visually reorder source text.
# Example: U+202E is a bidi control; an ordinary right arrow is not.
func is_bidi_control(character: char) -> bool:
    if character == '\u{061c}' or character == '\u{200e}' or character == '\u{200f}': return true
    if character >= '\u{202a}' and character <= '\u{202e}': return true
    return character >= '\u{2066}' and character <= '\u{2069}'

# Recognize the exact reserved-word set from language-design section 29.5.
# Example: `while` is reserved, while contextual `cfunc` remains a name.
func is_keyword(word: str) -> bool:
    # `c`, `cpp`, `copy`, extern-position `blocking`/`out`/`cfunc`, core types,
    # `init`, and `deinit` remain contextual.
    return match word:
        "and", "as", "break", "catch", "class", "continue", "defer" => true
        "elif", "else", "enum", "export", "extern", "false", "for", "from" => true
        "func", "if", "implements", "import", "in", "interface", "is", "let" => true
        "match", "mutating", "new", "none", "not", "or", "pub" => true
        "recover", "return", "self", "spawn", "struct", "test", "true" => true
        "try", "type", "var", "weak", "while" => true
        else => false

# Recognize a one-character literal prefix before a double quote.
# Example: `f`, `r`, and `b` qualify; the `f` in `file` does not without `"`.
func is_string_prefix(character: char) -> bool:
    return character == 'f' or character == 'r' or character == 'b'

# Recognize a character allowed after the first identifier letter.
# Example: digits and `_` continue `item_2`, but `-` ends the name.
func is_identifier_continue(character: char) -> bool:
    return strings.is_alnum(character) or character == '_'

# Recognize the lowercase letter following zero in a based integer literal.
# Example: `x`, `o`, and `b` begin `0xff`, `0o77`, and `0b10`; `X` is rejected.
func is_base_prefix(character: char) -> bool:
    return character == 'x' or character == 'o' or character == 'b'

# Test whether a character is a digit in the selected numeric base.
# Example: `f` is valid for base `x`, while `2` is invalid for base `b`.
func is_digit_for_base(character: char, base: char) -> bool:
    match base:
        'b': return character == '0' or character == '1'
        'o': return character >= '0' and character <= '7'
        'x': return is_hex_digit(character)
        else: return strings.is_digit(character)

# Recognize one hexadecimal digit for literals and escapes.
# Example: `0`, `a`, and `F` qualify; `g` does not.
func is_hex_digit(character: char) -> bool:
    return (
        strings.is_digit(character)
        or (character >= 'a' and character <= 'f')
        or (character >= 'A' and character <= 'F')
    )

# Convert one already-validated hexadecimal digit to its integer value.
# Example: `decode_hex_digit('F')` returns 15.
func decode_hex_digit(character: char) -> i64:
    let code = u32(character)
    if character <= '9': return i64(code - u32('0'))
    if character <= 'F': return i64(code - u32('A')) + 10
    return i64(code - u32('a')) + 10

# Recognize the complete fixed-width integer suffix vocabulary.
# Example: `u8` and `i64` qualify, while `u7` does not.
func is_integer_suffix(suffix: str) -> bool:
    return match suffix:
        "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64" => true
        else => false

# Recognize the complete floating-point suffix vocabulary.
# Example: `f16`, `f32`, and `f64` qualify; `f128` does not.
func is_float_suffix(suffix: str) -> bool:
    return suffix == "f16" or suffix == "f32" or suffix == "f64"

# Recognize a character that forms a symbol without lookahead.
# Example: `+`, `(`, and `_` qualify; `@` is unexpected source.
func is_single_symbol(character: char) -> bool:
    return match character:
        '+', '-', '*', '/', '%' => true
        '&', '|', '^', '~' => true
        '<', '>', '=', ':', ',' => true
        '.', '?', '!' => true
        '(', ')', '[', ']', '{', '}', '_' => true
        else => false

# Return the closing delimiter paired with an opening delimiter; `f` is the
# `{` that opens a formatted string field.
# Example: `find_closing_delimiter('[')` returns `]`.
func find_closing_delimiter(opening: char) -> char:
    return match opening:
        '(' => ')'
        '[' => ']'
        else => '}'
