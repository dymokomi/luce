import std.strings

# The epoch-1 Luce tokenizer. It turns source text into significant tokens plus
# the NEWLINE/INDENT/DEDENT layout stream consumed by the parser.
#
# The implementation follows the lexical contracts in sections 3, 4, and 29 of
# LUCE_LANGUAGE_DESIGN.md. Literal tokens retain their exact source spelling;
# decoding their values remains a later compiler stage. Errors use stable
# LINE:COLUMN locations and stop at the first invalid source form.

pub enum TokenKind:
    name
    keyword
    int_lit
    float_lit
    str_lit
    byte_lit
    char_lit
    symbol
    newline
    indent
    dedent
    doc_comment
    eof

pub struct SourceSpan:
    pub start: i64
    pub end: i64
    pub line: i64
    pub column: i64

pub struct Token:
    pub kind: TokenKind
    pub text: str
    pub suffix: str
    pub span: SourceSpan

pub class Tokenizer:
    source: str
    tokens: list[Token]
    indent_width: i64
    open_delimiters: list[char]
    pos: i64
    line: i64
    line_start: i64
    pending_layout: bool

    pub init(source: str):
        self.source = source
        self.tokens = list[Token]()
        self.indent_width = 0
        self.open_delimiters = list[char]()
        self.pos = 0
        self.line = 1
        self.line_start = 0
        self.pending_layout = true

    pub func tokenize() -> list[Token]!:
        try self.prepare_source()
        while not self.at_end():
            if self.pending_layout and len(self.open_delimiters) == 0:
                try self.scan_layout()
            else:
                try self.scan_token()
        try self.finish()
        return self.tokens

    # Validate source-wide rules before tokenization. The stage-0 `str` boundary
    # already guarantees valid UTF-8, so this pass handles the remaining source
    # restrictions and makes a byte-zero BOM invisible to token columns.
    func prepare_source() -> !:
        if len(self.source) > 0 and self.source[0] == '\u{feff}':
            self.pos = 1
            self.line_start = 1

        var i = self.pos
        var source_line = 1
        var source_column = 1
        while i < len(self.source):
            let c = self.source[i]
            if c == '\u{0}':
                error(location(source_line, source_column) + "NUL is not allowed in source")
            if c == '\u{feff}':
                error(location(source_line, source_column) + "a UTF-8 BOM is allowed only at byte zero")
            if is_bidi_control(c):
                error(location(source_line, source_column) + "bidirectional controls are not allowed in source")
            if c == '\t':
                error(location(source_line, source_column) + "tabs are not allowed; use spaces")

            if c == '\r':
                if i + 1 >= len(self.source) or self.source[i + 1] != '\n':
                    error(location(source_line, source_column) + "carriage return must be followed by newline")
                i += 2
                source_line += 1
                source_column = 1
            elif c == '\n':
                i += 1
                source_line += 1
                source_column = 1
            else:
                i += 1
                source_column += 1

    # mark: Layout ------------------------------------------------------------

    # Resolve indentation at the start of a logical line. Blank and comment-only
    # lines are skipped first, so they never change the active block depth.
    func scan_layout() -> !:
        while not self.at_end():
            var width = 0
            while self.pos + width < len(self.source) and self.source[self.pos + width] == ' ':
                width += 1
            let head = self.pos + width

            if head >= len(self.source):
                self.pos = head
                return
            if self.source[head] == '\n' or self.source[head] == '\r':
                self.pos = head
                self.advance_line()
            elif self.source[head] == '#':
                self.pos = head
                if self.starts_here("##"):
                    try self.adjust_indent(width)
                    self.scan_doc_comment()
                else:
                    self.skip_comment()
            else:
                self.pos = head
                try self.adjust_indent(width)
                self.pending_layout = false
                return

    # Every block step is exactly four spaces, so the current width contains the
    # same information that a general indentation stack would contain.
    func adjust_indent(width: i64) -> !:
        if width > self.indent_width:
            if width != self.indent_width + 4:
                error(self.location_at(width + 1) + "indentation must increase by four spaces")
            self.indent_width = width
            self.emit(TokenKind.indent, "", width + 1)
            return

        while width < self.indent_width:
            self.indent_width -= 4
            self.emit(TokenKind.dedent, "", width + 1)
        if width != self.indent_width:
            error(self.location_at(width + 1) + "dedent does not match any outer indentation")

    # mark: Token scanning ----------------------------------------------------

    # Scan one significant token, or consume one run of insignificant source.
    # Each token family owns its detailed scanning rules below.
    func scan_token() -> !:
        let start = self.pos
        let token_line = self.line
        let column = self.current_column()
        let c = self.peek()

        if c == ' ':
            self.pos += 1
            return
        if c == '#':
            self.skip_comment()
            return
        if c == '\n' or c == '\r':
            if len(self.open_delimiters) == 0:
                self.emit(TokenKind.newline, "", column)
                self.pending_layout = true
            self.advance_line()
            return

        # A prefix is part of a string/byte literal only when a quote follows it.
        if is_string_prefix(c) and self.peek(1) == '"':
            try self.scan_string_literal(start, token_line, column, c)
            return
        if c == '"':
            try self.scan_string_literal(start, token_line, column, '\u{0}')
            return
        if c == '\'':
            try self.scan_char_body()
            self.emit(TokenKind.char_lit, self.source[start:self.pos], column)
            return
        if strings.is_alpha(c):
            self.scan_identifier(start, column)
            return
        if strings.is_digit(c):
            try self.scan_number(start, column)
            return
        let width = self.symbol_width()
        if width > 0:
            try self.scan_symbol(start, column, width)
            return

        error(self.location_at(column) + "unexpected character")

    func scan_identifier(start: i64, column: i64):
        self.pos += 1
        while is_ident_continue(self.peek()):
            self.pos += 1
        let word = self.source[start:self.pos]
        if is_keyword(word): self.emit(TokenKind.keyword, word, column)
        else: self.emit(TokenKind.name, word, column)

    # mark: Literals ----------------------------------------------------------

    # String prefixes have deliberately separate meanings: r disables escapes,
    # f enables interpolation fields, and b selects the byte-literal token kind.
    func scan_string_literal(start: i64, start_line: i64, column: i64, prefix: char) -> !:
        if prefix != '\u{0}': self.pos += 1

        try self.scan_string_body(prefix, start_line, column)
        if prefix == 'b':
            self.emit_at(TokenKind.byte_lit, self.source[start:self.pos], start_line, column)
        else:
            self.emit_at(TokenKind.str_lit, self.source[start:self.pos], start_line, column)

    # Consume either a single-line or triple-quoted body. Triple strings update
    # source positions for every physical line but remain one literal token.
    func scan_string_body(prefix: char, start_line: i64, column: i64) -> !:
        let raw = prefix == 'r'
        let formatted = prefix == 'f'
        let byte_mode = prefix == 'b'
        let triple = self.starts_here("\"\"\"")
        if triple:
            self.pos += 3
        else:
            self.pos += 1

        while not self.at_end():
            if triple and self.starts_here("\"\"\""):
                self.pos += 3
                return

            let c = self.peek()
            if not triple and c == '"':
                self.pos += 1
                return
            if not raw and c == '\\':
                try self.scan_escape(byte_mode)
            elif formatted and c == '{':
                if self.starts_here("{{"):
                    self.pos += 2
                else:
                    try self.scan_interpolation(triple, start_line, column)
            elif formatted and c == '}':
                if self.starts_here("}}"):
                    self.pos += 2
                else:
                    error(location(start_line, column) + "unescaped '}' in formatted string")
            elif c == '\n' or c == '\r':
                if not triple:
                    error(location(start_line, column) + "unterminated string literal")
                self.advance_line()
            else:
                if byte_mode and c > '\u{7f}':
                    error(self.location_at(self.current_column()) + "byte literals require ASCII source characters")
                self.pos += 1

        error(location(start_line, column) + "unterminated string literal")

    # Interpolation stays inside one STRING token, but its balanced braces and
    # nested quoted literals must be understood so an inner quote cannot end the
    # outer formatted string accidentally.
    func scan_interpolation(multiline: bool, start_line: i64, column: i64) -> !:
        self.pos += 1
        var braces = 1
        while not self.at_end():
            let c = self.peek()
            if is_string_prefix(c) and self.peek(1) == '"':
                let nested_line = self.line
                let nested_column = self.current_column()
                self.pos += 1
                try self.scan_string_body(c, nested_line, nested_column)
            elif c == '"':
                let nested_line = self.line
                let nested_column = self.current_column()
                try self.scan_string_body('\u{0}', nested_line, nested_column)
            elif c == '\'':
                try self.scan_char_body()
            elif c == '{':
                braces += 1
                self.pos += 1
            elif c == '}':
                braces -= 1
                self.pos += 1
                if braces == 0:
                    return
            elif c == '#':
                if not multiline:
                    error(location(start_line, column) + "formatted string interpolation cannot cross a line")
                self.skip_comment()
            elif c == '\n' or c == '\r':
                if not multiline:
                    error(location(start_line, column) + "formatted string interpolation cannot cross a line")
                self.advance_line()
            else:
                self.pos += 1

        error(location(start_line, column) + "unterminated formatted string interpolation")

    # A character literal is lexically one Unicode scalar after escape decoding.
    func scan_char_body() -> !:
        let start_line = self.line
        let column = self.current_column()
        self.pos += 1
        var scalars = 0
        while not self.at_end():
            let c = self.peek()
            if c == '\\':
                try self.scan_escape(false)
                scalars += 1
            elif c == '\'':
                self.pos += 1
                if scalars != 1:
                    error(location(start_line, column) + "character literal must contain one Unicode scalar")
                return
            elif c == '\n' or c == '\r':
                error(location(start_line, column) + "unterminated character literal")
            else:
                scalars += 1
                self.pos += 1
        error(location(start_line, column) + "unterminated character literal")

    # Validate the finite escape vocabulary while leaving actual value decoding
    # to the literal-lowering pass.
    func scan_escape(byte_mode: bool) -> !:
        let escape_column = self.current_column()
        self.pos += 1
        if self.at_end() or self.peek() == '\n' or self.peek() == '\r':
            error(self.location_at(escape_column) + "unterminated literal escape")

        let escaped = self.peek()
        if escaped == '\\' or escaped == '"' or escaped == '\'' or escaped == 'n' or escaped == 'r' or escaped == 't' or escaped == '0':
            self.pos += 1
            return

        if escaped == 'u' and self.peek(1) == '{':
            self.pos += 2
            var digits = 0
            var scalar = 0
            while is_hex(self.peek()):
                scalar = scalar * 16 + hex_value(self.peek())
                digits += 1
                self.pos += 1
            if digits == 0 or digits > 6 or self.peek() != '}':
                error(self.location_at(escape_column) + "Unicode escape must be \\u{HEX}")
            if scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
                error(self.location_at(escape_column) + "Unicode escape is not a scalar value")
            self.pos += 1
            return

        if byte_mode and escaped == 'x':
            self.pos += 1
            if not is_hex(self.peek()) or not is_hex(self.peek(1)):
                error(self.location_at(escape_column) + "byte escape must contain exactly two hex digits")
            self.pos += 2
            return

        error(self.location_at(escape_column) + "invalid literal escape")

    # mark: Numbers -----------------------------------------------------------

    # Consume and validate a complete numeric spelling. Literal lowering still
    # owns value conversion and contextual range checks.
    func scan_number(start: i64, column: i64) -> !:
        var kind = TokenKind.int_lit
        var suffix = ""
        if self.peek() == '0' and is_base_prefix(self.peek(1)):
            let base = self.peek(1)
            self.pos += 2
            try self.scan_digit_sequence(base)
            if strings.is_digit(self.peek()):
                error(self.location_at(self.current_column()) + "digit is not valid for this numeric base")
            suffix = self.scan_numeric_suffix()
            if len(suffix) > 0 and not is_integer_suffix(suffix):
                error(self.location_at(column) + "invalid integer literal suffix")
        else:
            try self.scan_digit_sequence('d')
            # A dot starts a fraction only when a digit follows. This keeps both
            # `1.member` and the range spellings unambiguous.
            if self.peek() == '.' and strings.is_digit(self.peek(1)):
                kind = TokenKind.float_lit
                self.pos += 1
                try self.scan_digit_sequence('d')
            if self.peek() == 'e' or self.peek() == 'E':
                kind = TokenKind.float_lit
                self.pos += 1
                if self.peek() == '+' or self.peek() == '-':
                    self.pos += 1
                try self.scan_digit_sequence('d')

            suffix = self.scan_numeric_suffix()
            if is_float_suffix(suffix):
                kind = TokenKind.float_lit
            elif len(suffix) > 0 and (kind == TokenKind.float_lit or not is_integer_suffix(suffix)):
                error(self.location_at(column) + "invalid numeric literal suffix")
        self.emit(kind, self.source[start:self.pos], column, suffix)

    func scan_digit_sequence(base: char) -> !:
        let column = self.current_column()
        var has_digit = false
        var after_separator = false
        while is_digit_for_base(self.peek(), base) or self.peek() == '_':
            if self.peek() == '_':
                if not has_digit or after_separator:
                    error(self.location_at(self.current_column()) + "underscores must separate numeric digits")
                after_separator = true
            else:
                has_digit = true
                after_separator = false
            self.pos += 1
        if not has_digit:
            error(self.location_at(column) + "numeric literal requires a digit")
        if after_separator:
            error(self.location_at(self.current_column() - 1) + "numeric literal cannot end with underscore")

    func scan_numeric_suffix() -> str:
        if not strings.is_alpha(self.peek()):
            return ""
        let start = self.pos
        while is_ident_continue(self.peek()):
            self.pos += 1
        return self.source[start:self.pos]

    # mark: Operators and delimiters ------------------------------------------

    func scan_symbol(start: i64, column: i64, width: i64) -> !:
        let text = self.source[start:start + width]
        self.pos = start + width

        if width == 1:
            let symbol = text[0]
            if symbol == '(' or symbol == '[' or symbol == '{':
                self.open_delimiters.append(symbol)
            elif symbol == ')' or symbol == ']' or symbol == '}':
                try self.close_delimiter(symbol, column)
        self.emit(TokenKind.symbol, text, column)

    # Longest-match ordering is visible here: expression/pattern ranges and
    # augmented assignments win before their shorter prefixes.
    func symbol_width() -> i64:
        if self.starts_here("//=") or self.starts_here("<<=") or self.starts_here(">>="): return 3
        if self.starts_here("..<") or self.starts_here("..="): return 3
        if self.starts_here("->") or self.starts_here("=>") or self.starts_here("==") or self.starts_here("!="): return 2
        if self.starts_here("<=") or self.starts_here(">=") or self.starts_here("//"): return 2
        if self.starts_here("<<") or self.starts_here(">>") or self.starts_here("+="): return 2
        if self.starts_here("-=") or self.starts_here("*=") or self.starts_here("/="): return 2
        if self.starts_here("%=") or self.starts_here("&=") or self.starts_here("|=") or self.starts_here("^="): return 2
        if self.starts_here(".."): return 2
        if is_single_symbol(self.peek()): return 1
        return 0

    func close_delimiter(close: char, column: i64) -> !:
        if len(self.open_delimiters) == 0:
            error(self.location_at(column) + "closing delimiter has no matching opener")
        let open = self.open_delimiters[len(self.open_delimiters) - 1]
        if close != matching_close(open):
            error(self.location_at(column) + "closing delimiter does not match its opener")
        self.open_delimiters.remove(len(self.open_delimiters) - 1)

    # mark: Completion and source movement -----------------------------------

    func finish() -> !:
        if len(self.open_delimiters) > 0:
            error(self.location_at(self.current_column()) + "unclosed delimiter")

        if len(self.tokens) > 0:
            let last = self.tokens[len(self.tokens) - 1]
            if last.kind != TokenKind.newline and last.kind != TokenKind.indent and last.kind != TokenKind.dedent and last.kind != TokenKind.doc_comment:
                self.emit(TokenKind.newline, "", self.current_column())
        while self.indent_width > 0:
            self.indent_width -= 4
            self.emit(TokenKind.dedent, "", self.current_column())
        self.emit(TokenKind.eof, "", self.current_column())

    func skip_comment():
        while not self.at_end() and self.peek() != '\n' and self.peek() != '\r':
            self.pos += 1

    func scan_doc_comment():
        let start = self.pos
        let column = self.current_column()
        self.skip_comment()
        self.emit(TokenKind.doc_comment, self.source[start:self.pos], column)

    func advance_line():
        if self.peek() == '\r':
            self.pos += 2
        else:
            self.pos += 1
        self.line += 1
        self.line_start = self.pos

    func emit(kind: TokenKind, text: str, column: i64, suffix: str = ""):
        self.emit_at(kind, text, self.line, column, suffix)

    func emit_at(kind: TokenKind, text: str, token_line: i64, column: i64, suffix: str = ""):
        let span = SourceSpan(start = self.pos - len(text), end = self.pos, line = token_line, column = column)
        self.tokens.append(Token(kind = kind, text = text, suffix = suffix, span = span))

    func current_column() -> i64:
        return self.pos - self.line_start + 1

    func location_at(column: i64) -> str:
        return location(self.line, column)

    func starts_here(text: str) -> bool:
        if self.pos + len(text) > len(self.source): return false
        return self.source[self.pos:self.pos + len(text)] == text

    func at_end() -> bool:
        return self.pos >= len(self.source)

    # Sentinel peeks keep scanners compact. Raw NUL source is rejected by the
    # preparation pass, so the sentinel can never be mistaken for source text.
    func peek(offset: i64 = 0) -> char:
        if self.pos + offset >= len(self.source): return '\u{0}'
        return self.source[self.pos + offset]


# mark: Token classes ---------------------------------------------------------

# Locations carry only line and column; the pipeline prefixes the file path,
# so a caller always reads `path:line:column: message`.
func location(line: i64, column: i64) -> str:
    return str(line) + ":" + str(column) + ": "

func is_keyword(word: str) -> bool:
    # Section 29.5 fixes this list at exactly 43 reserved words. `c`, `cpp`,
    # `copy`, extern-position `blocking`/`out`/`cfunc`, core types, effect
    # names, `init`, and `deinit` remain contextual.
    return match word:
        "and", "as", "break", "catch", "class", "continue", "defer" => true
        "elif", "else", "enum", "export", "extern", "false", "for", "from" => true
        "func", "if", "implements", "import", "in", "interface", "is", "let" => true
        "match", "mutating", "new", "none", "not", "or", "pub" => true
        "recover", "return", "self", "spawn", "struct", "test", "true" => true
        "try", "type", "uses", "var", "weak", "while" => true
        else => false

func is_string_prefix(c: char) -> bool:
    return c == 'f' or c == 'r' or c == 'b'

func is_ident_continue(c: char) -> bool:
    return strings.is_alnum(c) or c == '_'

func is_hex(c: char) -> bool:
    return strings.is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')

func is_digit_for_base(c: char, base: char) -> bool:
    match base:
        'b', 'B': return c == '0' or c == '1'
        'o', 'O': return c >= '0' and c <= '7'
        'x', 'X': return is_hex(c)
        else: return strings.is_digit(c)

func is_integer_suffix(suffix: str) -> bool:
    return match suffix:
        "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64" => true
        else => false

func is_float_suffix(suffix: str) -> bool:
    return suffix == "f16" or suffix == "f32" or suffix == "f64"

func hex_value(c: char) -> i64:
    let code = u32(c)
    if c <= '9': return i64(code - u32('0'))
    if c <= 'F': return i64(code - u32('A')) + 10
    return i64(code - u32('a')) + 10

func is_base_prefix(c: char) -> bool:
    return c == 'x' or c == 'X' or c == 'o' or c == 'O' or c == 'b' or c == 'B'

func matching_close(open: char) -> char:
    return match open:
        '(' => ')'
        '[' => ']'
        else => '}'

func is_bidi_control(c: char) -> bool:
    if c == '\u{061c}' or c == '\u{200e}' or c == '\u{200f}': return true
    if c >= '\u{202a}' and c <= '\u{202e}': return true
    return c >= '\u{2066}' and c <= '\u{2069}'

func is_single_symbol(c: char) -> bool:
    return match c:
        '+', '-', '*', '/', '%' => true
        '&', '|', '^', '~' => true
        '<', '>', '=', ':', ',' => true
        '.', '?', '!' => true
        '(', ')', '[', ']', '{', '}', '_' => true
        else => false
