#==============================================================================================
#
#   optimizer - Semantics-preserving canonical MIR transforms
#
#   DESCRIPTION:
#       Improves canonical MIR without choosing a target. Future passes can
#       fold constants, remove unreachable blocks, eliminate dead values, and
#       simplify control flow here; target-specific rewrites belong later in a
#       backend.
#
#       Optimization is optional for correctness. Closed-world reachability is
#       the first pass: package APIs, process entries, and explicit artifact
#       symbols are roots; direct calls and function addresses are edges.
#       Unreachable definitions and their resources never reach a backend.
#       `MirVerifier` runs before and after this stage.
#
#       Example:
#
#       r0 = Const 2; r1 = Const 3; r2 = Add r0, r1  -> eventually r2 = Const 5
#
#==============================================================================================

from compiler.mir.canonical import ClosureId, DataId, ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm
from compiler.mir.canonical import MirConformance, MirData, MirExtern, MirExternalGlobal, MirFunction, MirGlobal, MirInstruction, MirProgram
from compiler.mir.canonical import MirClass, MirClosure, MirRuntimeBinding
from compiler.runtime_contract import RuntimeService

## Runs target-independent optimization passes over canonical MIR.
pub class Optimizer:
    let program: MirProgram

    ## Prepare target-independent optimization for one canonical program.
    pub init(program: MirProgram):
        self.program = program

    # mark: Optimization =======================================================================

    ## Return optimized canonical MIR together with the old-to-new function
    ## identity map needed by out-of-band compiler reports. The map is not a
    ## MIR field and therefore cannot become backend or source semantics.
    pub func optimize() -> OptimizationResult:
        return ProgramReachability(self.program).run()

## One optimized program and the identity rewrite applied by reachability.
## A `-1` entry names a function eliminated before backend emission.
pub struct OptimizationResult:
    pub let program: MirProgram
    pub let function_remap: list[i64]

# mark: Closed-world reachability ============================================================

## Keeps exactly the program state reachable from a package API, process entry,
## or explicit artifact symbol. Original order is retained so output and
## diagnostics stay deterministic; surviving table identities are remapped
## once afterward.
class ProgramReachability:
    let program: MirProgram
    let reachable_functions: list[bool]
    let reachable_externs: list[bool]
    let reachable_external_globals: list[bool]
    let reachable_globals: list[bool]
    let reachable_data: list[bool]
    let reachable_runtime_bindings: list[bool]
    let reachable_closures: list[bool]
    let pending: list[FunctionId]

    init(program: MirProgram):
        self.program = program
        self.reachable_functions = false_marks(len(program.functions))
        self.reachable_externs = false_marks(len(program.externs))
        self.reachable_external_globals = false_marks(len(program.external_globals))
        self.reachable_globals = false_marks(len(program.globals))
        self.reachable_data = false_marks(len(program.data))
        self.reachable_runtime_bindings = false_marks(len(program.runtime_bindings))
        self.reachable_closures = false_marks(len(program.closures))
        self.pending = list[FunctionId]()

    func run() -> OptimizationResult:
        let entry = self.program.entry
        if entry != none: self.discover(entry)
        for index in range(0, len(self.program.functions)):
            let function = self.program.functions[index]
            if function.is_public or function.is_exported:
                self.discover(FunctionId(value = u32(index)))
        # Class metadata remains nominally indexed in the unpruned type table,
        # so each exact destroyer remains a root and can be remapped safely.
        for class_value in self.program.classes: self.discover(class_value.destroyer)
        # Interface/conformance tables likewise retain their stable nominal
        # identities. Every function named by that metadata must survive and
        # be remapped even when a dynamic call is reached only through a
        # public interface-typed parameter.
        for conformance in self.program.conformances:
            for implementation in conformance.implementations: self.discover(implementation)
            self.discover(conformance.retain)
            self.discover(conformance.release)
        # With no process entry, package API, or explicit artifact exports,
        # this is not a closed world (for example, a library awaiting a
        # packaging policy).
        # Preserving it is the only sound target-independent choice.
        if len(self.pending) == 0:
            return OptimizationResult(
                program = self.program,
                function_remap = identity_remap(len(self.program.functions)),
            )
        self.trace_edges()

        let function_remap = build_remap(self.reachable_functions)
        let extern_remap = build_remap(self.reachable_externs)
        let external_global_remap = build_remap(self.reachable_external_globals)
        let global_remap = build_remap(self.reachable_globals)
        let data_remap = build_remap(self.reachable_data)
        let closure_remap = build_remap(self.reachable_closures)
        let functions = list[MirFunction]()
        for index in range(0, len(self.program.functions)):
            if self.reachable_functions[index]:
                functions.append(self.rewrite_function(
                    self.program.functions[index],
                    function_remap,
                    extern_remap,
                    external_global_remap,
                    global_remap,
                    data_remap,
                    closure_remap,
                ))

        let externs = list[MirExtern]()
        for index in range(0, len(self.program.externs)):
            if self.reachable_externs[index]: externs.append(self.program.externs[index])
        let external_globals = list[MirExternalGlobal]()
        for index in range(0, len(self.program.external_globals)):
            if self.reachable_external_globals[index]:
                external_globals.append(self.program.external_globals[index])
        let globals = list[MirGlobal]()
        for index in range(0, len(self.program.globals)):
            if self.reachable_globals[index]:
                globals.append(self.rewrite_global(self.program.globals[index], data_remap))
        let data = list[MirData]()
        for index in range(0, len(self.program.data)):
            if self.reachable_data[index]: data.append(self.program.data[index])

        var optimized_entry: FunctionId? = none
        if entry != none: optimized_entry = self.remapped_function(entry, function_remap)
        let runtime_bindings = list[MirRuntimeBinding]()
        for index in range(0, len(self.program.runtime_bindings)):
            if self.reachable_runtime_bindings[index]:
                let binding = self.program.runtime_bindings[index]
                runtime_bindings.append(MirRuntimeBinding(
                    service = binding.service,
                    function = self.remapped_function(binding.function, function_remap),
                ))
        let classes = list[MirClass]()
        for class_value in self.program.classes:
            classes.append(MirClass(
                fields = class_value.fields,
                destroyer = self.remapped_function(class_value.destroyer, function_remap),
            ))
        let closures = list[MirClosure]()
        for index in range(0, len(self.program.closures)):
            if not self.reachable_closures[index]: continue
            let closure = self.program.closures[index]
            closures.append(MirClosure(
                function = self.remapped_function(closure.function, function_remap),
                signature = closure.signature,
                captures = closure.captures,
                destroyer = self.remapped_function(closure.destroyer, function_remap),
            ))
        let conformances = list[MirConformance]()
        for conformance in self.program.conformances:
            let implementations = list[FunctionId]()
            for implementation in conformance.implementations:
                implementations.append(self.remapped_function(implementation, function_remap))
            conformances.append(MirConformance(
                interface_id = conformance.interface_id,
                value_type = conformance.value_type,
                implementations = implementations,
                retain = self.remapped_function(conformance.retain, function_remap),
                release = self.remapped_function(conformance.release, function_remap),
            ))
        return OptimizationResult(
            program = MirProgram(
                types = self.program.types,
                classes = classes,
                interfaces = self.program.interfaces,
                conformances = conformances,
                closures = closures,
                runtime_bindings = runtime_bindings,
                externs = externs,
                external_globals = external_globals,
                globals = globals,
                data = data,
                functions = functions,
                entry = optimized_entry,
            ),
            function_remap = function_remap,
        )

    func discover(function: FunctionId):
        let index = i64(function.value)
        if self.reachable_functions[index]: return
        self.reachable_functions[index] = true
        self.pending.append(function)

    func trace_edges():
        var next = 0
        while next < len(self.pending):
            let function = self.program.functions[self.pending[next].value]
            next += 1
            for instruction in function.body:
                match instruction.form:
                    AllocateStorage(result, element_type, count):
                        self.discover_runtime(RuntimeService.storage_allocator)
                    DeallocateStorage(address, element_type, count):
                        self.discover_runtime(RuntimeService.storage_deallocator)
                    EqualityContextCreate(result): self.discover_runtime(RuntimeService.equality_context_create)
                    EqualityContextRelease(value): self.discover_runtime(RuntimeService.equality_context_release)
                    EqualityContextVisit(result, context, left, right): self.discover_runtime(RuntimeService.equality_context_visit)
                    ListCreate(result): self.discover_runtime(RuntimeService.list_create)
                    ListRetain(value): self.discover_runtime(RuntimeService.list_retain)
                    ListRelease(value, element_release):
                        self.discover(element_release)
                        self.discover_runtime(RuntimeService.list_release)
                    ListCopy(result, value, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_copy)
                    ListConcat(result, left, right, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_concat)
                    ListLength(result, value): self.discover_runtime(RuntimeService.list_length)
                    ListIterationBegin(result, value): self.discover_runtime(RuntimeService.list_iteration_begin)
                    ListIterationEnd(value): self.discover_runtime(RuntimeService.list_iteration_end)
                    ListAppendSlot(result, value, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_iteration_active)
                        self.discover_runtime(RuntimeService.list_append_slot)
                    ListInsertSlot(result, value, index, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_length)
                        self.discover_runtime(RuntimeService.list_iteration_active)
                        self.discover_runtime(RuntimeService.list_insert_slot)
                    ListRemoveAt(value, index, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_length)
                        self.discover_runtime(RuntimeService.list_iteration_active)
                        self.discover_runtime(RuntimeService.list_remove_at)
                    ListClear(value, element_release):
                        self.discover(element_release)
                        self.discover_runtime(RuntimeService.list_iteration_active)
                        self.discover_runtime(RuntimeService.list_clear)
                    ListReserve(value, minimum_capacity, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_reserve)
                    ListElementAddress(result, value, index):
                        self.discover_runtime(RuntimeService.list_length)
                        self.discover_runtime(RuntimeService.list_element_address)
                    ListMutableElementAddress(result, value, index, element_retain):
                        self.discover(element_retain)
                        self.discover_runtime(RuntimeService.list_length)
                        self.discover_runtime(RuntimeService.list_mutable_element_address)
                    ListSlice(result, value, start, end):
                        self.discover_runtime(RuntimeService.list_length)
                        self.discover_runtime(RuntimeService.list_slice)
                    BufferRetain(value): self.discover_runtime(RuntimeService.buffer_retain)
                    BufferRelease(value): self.discover_runtime(RuntimeService.buffer_release)
                    BufferConcat(result, left_data, left_length, right_data, right_length): self.discover_runtime(RuntimeService.buffer_concat)
                    BufferData(result, owner): self.discover_runtime(RuntimeService.buffer_data)
                    StringScalarCount(result, data, length): self.discover_runtime(RuntimeService.string_scalar_count)
                    StringDecode(character, width, data, length, offset): self.discover_runtime(RuntimeService.string_decode)
                    BytesSlice(result, owner, data, length, start, end): self.discover_runtime(RuntimeService.bytes_slice)
                    SliceRetain(value): self.discover_runtime(RuntimeService.slice_retain)
                    SliceRelease(value, element_release):
                        self.discover(element_release)
                        self.discover_runtime(RuntimeService.slice_release)
                    SliceLength(result, value): self.discover_runtime(RuntimeService.slice_length)
                    SliceElementAddress(result, value, index):
                        self.discover_runtime(RuntimeService.slice_length)
                        self.discover_runtime(RuntimeService.slice_element_address)
                    ClassCreate(result, identity): self.discover_runtime(RuntimeService.class_create)
                    ClassMarkInitialized(value): self.discover_runtime(RuntimeService.class_mark_initialized)
                    ClassRetain(value): self.discover_runtime(RuntimeService.class_retain)
                    ClassRelease(value): self.discover_runtime(RuntimeService.class_release)
                    ClassFieldAddress(result, value, field): self.discover_runtime(RuntimeService.class_payload)
                    WeakClassCreate(result, value): self.discover_runtime(RuntimeService.weak_class_create)
                    WeakClassRetain(value): self.discover_runtime(RuntimeService.weak_class_retain)
                    WeakClassRelease(value): self.discover_runtime(RuntimeService.weak_class_release)
                    WeakClassPromote(destination, value, optional_type): self.discover_runtime(RuntimeService.weak_class_promote)
                    InterfaceCreate(result, source, conformance): self.discover_runtime(RuntimeService.interface_create)
                    InterfaceRetain(value): self.discover_runtime(RuntimeService.interface_retain)
                    InterfaceRelease(value): self.discover_runtime(RuntimeService.interface_release)
                    InterfaceDetach(result, value): self.discover_runtime(RuntimeService.interface_detach)
                    InterfacePayload(result, value): self.discover_runtime(RuntimeService.interface_payload)
                    CellCreate(result, element_type, destroyer):
                        self.discover(destroyer)
                        self.discover_runtime(RuntimeService.class_create)
                    CellMarkInitialized(value): self.discover_runtime(RuntimeService.class_mark_initialized)
                    CellRetain(value): self.discover_runtime(RuntimeService.class_retain)
                    CellRelease(value): self.discover_runtime(RuntimeService.class_release)
                    CellValueAddress(result, value, element_type): self.discover_runtime(RuntimeService.class_payload)
                    FunctionAddress(result, target): self.discover(target)
                    FunctionValue(destination, function_type, target): self.discover(target)
                    ClosureCreate(environment, destination, function_type, closure):
                        self.discover_closure(closure)
                        self.discover_runtime(RuntimeService.class_create)
                    ClosureMarkInitialized(environment): self.discover_runtime(RuntimeService.class_mark_initialized)
                    ClosureCaptureAddress(result, environment, closure, capture):
                        self.discover_closure(closure)
                        self.discover_runtime(RuntimeService.class_payload)
                    FunctionRetain(value): self.discover_runtime(RuntimeService.class_retain)
                    FunctionRelease(value): self.discover_runtime(RuntimeService.class_release)
                    ExternAddress(result, target): self.reachable_externs[target.value] = true
                    Call(results, target, arguments): self.discover(target)
                    CallExtern(results, external, arguments): self.reachable_externs[external.value] = true
                    CallInterface(results, interface_id, requirement, target, arguments): self.discover_runtime(RuntimeService.interface_witness)
                    LoadExternalGlobal(result, global): self.reachable_external_globals[global.value] = true
                    StoreExternalGlobal(global, value): self.reachable_external_globals[global.value] = true
                    DataAddress(result, data): self.reachable_data[data.value] = true
                    GlobalAddress(result, global): self.discover_global(global)
                    else: pass

    func discover_closure(closure: ClosureId):
        if self.reachable_closures[closure.value]: return
        self.reachable_closures[closure.value] = true
        let metadata = self.program.closures[closure.value]
        self.discover(metadata.function)
        self.discover(metadata.destroyer)

    func discover_runtime(service: RuntimeService):
        for index in range(0, len(self.program.runtime_bindings)):
            let binding = self.program.runtime_bindings[index]
            if binding.service == service:
                self.reachable_runtime_bindings[index] = true
                self.discover(binding.function)
                return
        trap("verified MIR instruction has no runtime binding")

    func discover_global(global: GlobalId):
        self.reachable_globals[global.value] = true
        let initial = self.program.globals[global.value].initial
        if initial != none: self.reachable_data[initial.value] = true

    func remapped_function(function: FunctionId, remap: list[i64]) -> FunctionId:
        let mapped = remapped_index(function.value, remap, "function")
        return FunctionId(value = u32(mapped))

    func remapped_extern(external: ExternId, remap: list[i64]) -> ExternId:
        return ExternId(value = u32(remapped_index(external.value, remap, "extern")))

    func remapped_external_global(global: ExternalGlobalId, remap: list[i64]) -> ExternalGlobalId:
        return ExternalGlobalId(value = u32(remapped_index(global.value, remap, "external global")))

    func remapped_global(global: GlobalId, remap: list[i64]) -> GlobalId:
        return GlobalId(value = u32(remapped_index(global.value, remap, "global")))

    func remapped_data(data: DataId, remap: list[i64]) -> DataId:
        return DataId(value = u32(remapped_index(data.value, remap, "data")))

    func remapped_closure(closure: ClosureId, remap: list[i64]) -> ClosureId:
        return ClosureId(value = u32(remapped_index(closure.value, remap, "closure")))

    func rewrite_function(
        function: MirFunction,
        function_remap: list[i64],
        extern_remap: list[i64],
        external_global_remap: list[i64],
        global_remap: list[i64],
        data_remap: list[i64],
        closure_remap: list[i64],
    ) -> MirFunction:
        let body = list[MirInstruction]()
        for instruction in function.body:
            var form = instruction.form
            match instruction.form:
                ListRelease(value, element_release):
                    form = InstructionForm.ListRelease(value = value, element_release = self.remapped_function(element_release, function_remap))
                ListCopy(result, value, element_retain):
                    form = InstructionForm.ListCopy(result = result, value = value, element_retain = self.remapped_function(element_retain, function_remap))
                ListConcat(result, left, right, element_retain):
                    form = InstructionForm.ListConcat(result = result, left = left, right = right, element_retain = self.remapped_function(element_retain, function_remap))
                ListAppendSlot(result, value, element_retain):
                    form = InstructionForm.ListAppendSlot(result = result, value = value, element_retain = self.remapped_function(element_retain, function_remap))
                ListInsertSlot(result, value, index, element_retain):
                    form = InstructionForm.ListInsertSlot(result = result, value = value, index = index, element_retain = self.remapped_function(element_retain, function_remap))
                ListRemoveAt(value, index, element_retain):
                    form = InstructionForm.ListRemoveAt(value = value, index = index, element_retain = self.remapped_function(element_retain, function_remap))
                ListClear(value, element_release):
                    form = InstructionForm.ListClear(value = value, element_release = self.remapped_function(element_release, function_remap))
                ListReserve(value, minimum_capacity, element_retain):
                    form = InstructionForm.ListReserve(value = value, minimum_capacity = minimum_capacity, element_retain = self.remapped_function(element_retain, function_remap))
                ListMutableElementAddress(result, value, index, element_retain):
                    form = InstructionForm.ListMutableElementAddress(result = result, value = value, index = index, element_retain = self.remapped_function(element_retain, function_remap))
                SliceRelease(value, element_release):
                    form = InstructionForm.SliceRelease(value = value, element_release = self.remapped_function(element_release, function_remap))
                CellCreate(result, element_type, destroyer):
                    form = InstructionForm.CellCreate(result = result, element_type = element_type, destroyer = self.remapped_function(destroyer, function_remap))
                FunctionAddress(result, target):
                    form = InstructionForm.FunctionAddress(
                        result = result,
                        function = self.remapped_function(target, function_remap),
                    )
                FunctionValue(destination, function_type, target):
                    form = InstructionForm.FunctionValue(destination = destination, function_type = function_type, function = self.remapped_function(target, function_remap))
                ClosureCreate(environment, destination, function_type, closure):
                    form = InstructionForm.ClosureCreate(environment = environment, destination = destination, function_type = function_type, closure = self.remapped_closure(closure, closure_remap))
                ClosureCaptureAddress(result, environment, closure, capture):
                    form = InstructionForm.ClosureCaptureAddress(result = result, environment = environment, closure = self.remapped_closure(closure, closure_remap), capture = capture)
                ExternAddress(result, target):
                    form = InstructionForm.ExternAddress(
                        result = result,
                        external = self.remapped_extern(target, extern_remap),
                    )
                Call(results, target, arguments):
                    form = InstructionForm.Call(
                        results = results,
                        function = self.remapped_function(target, function_remap),
                        arguments = arguments,
                    )
                CallExtern(results, external, arguments):
                    form = InstructionForm.CallExtern(
                        results = results,
                        external = self.remapped_extern(external, extern_remap),
                        arguments = arguments,
                    )
                LoadExternalGlobal(result, global):
                    form = InstructionForm.LoadExternalGlobal(
                        result = result,
                        global = self.remapped_external_global(global, external_global_remap),
                    )
                StoreExternalGlobal(global, value):
                    form = InstructionForm.StoreExternalGlobal(
                        global = self.remapped_external_global(global, external_global_remap),
                        value = value,
                    )
                DataAddress(result, data):
                    form = InstructionForm.DataAddress(
                        result = result,
                        data = self.remapped_data(data, data_remap),
                    )
                GlobalAddress(result, global):
                    form = InstructionForm.GlobalAddress(
                        result = result,
                        global = self.remapped_global(global, global_remap),
                    )
                else: pass
            body.append(MirInstruction(form = form, span = instruction.span))
        return MirFunction(
            name = function.name,
            convention = function.convention,
            signature = function.signature,
            registers = function.registers,
            slots = function.slots,
            body = body,
            operands = function.operands,
            is_public = function.is_public,
            is_exported = function.is_exported,
            span = function.span,
        )

    func rewrite_global(global: MirGlobal, data_remap: list[i64]) -> MirGlobal:
        var initial: DataId? = none
        let old_initial = global.initial
        if old_initial != none: initial = self.remapped_data(old_initial, data_remap)
        return MirGlobal(
            name = global.name,
            value_type = global.value_type,
            initial = initial,
            is_mutable = global.is_mutable,
        )

# A compact index map shared by every program table. `-1` means discarded;
# asking to remap it is an optimizer invariant violation on already-verified MIR.
func false_marks(count: i64) -> list[bool]:
    let marks = list[bool]()
    for index in range(0, count): marks.append(false)
    return marks

func identity_remap(count: i64) -> list[i64]:
    let remap = list[i64]()
    for index in range(0, count): remap.append(index)
    return remap

func build_remap(reachable: list[bool]) -> list[i64]:
    let remap = list[i64]()
    var next = 0
    for is_reachable in reachable:
        if is_reachable:
            remap.append(next)
            next += 1
        else:
            remap.append(-1)
    return remap

func remapped_index(old: u32, remap: list[i64], kind: str) -> i64:
    let mapped = remap[old]
    if mapped < 0: trap("reachable MIR refers to discarded " + kind)
    return mapped
