#==============================================================================================
#
#   mir_verifier - Proves the rules every backend may assume
#
#   DESCRIPTION:
#       Runs on canonical MIR before and after optimization. A backend that
#       receives a verified program checks nothing: registers are defined once
#       and before use with the type they were declared with, operands match
#       their instruction, branch depths are in range, every region's results
#       are supplied on every exit, aggregate types are structurally valid,
#       fallible functions end each path in `Return` or `Raise`, C
#       signatures carry only C-representable types, runtime symbols carry
#       their known signatures.
#
#       The walk mirrors the program's own shape: the type table, then each
#       extern, global, and data item, then each function's body in one
#       linear pass. A body is a flat list in which `Block`/`Loop`/`If`/
#       `Switch` open a region, `Else`/`Case`/`Default` start a new arm, and
#       `End` closes it; the verifier keeps a stack of open regions, and each
#       arm is checked on a copy of the "defined so far" set taken at the
#       opener, so a register defined inside an `If` arm is not visible after
#       the `End` unless the region names it as a result.
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ClassId, ConvertOp, DataId, InterfaceId
from compiler.mir.canonical import FunctionId, GlobalId, InstructionForm, MirConstant, MirData, MirExtern
from compiler.mir.canonical import MirExternalGlobal, MirField, MirFunction, MirGlobal, MirInstruction, MirProgram, MirSignature, MirTaskResult, MirType
from compiler.runtime_contract import RuntimeService
from compiler.mir.canonical import MirTypeTable, RegisterId, RegisterRun, TransferRun, TypeId, no_register, no_registers, registers_of, transfer_at
from compiler.mir.canonical import bits_of, builtin_mir_type, describe_mir_type, describe_signature
from compiler.mir.canonical import find_runtime_symbol, int_maximum, int_minimum, is_bool_type, is_float_type
from compiler.mir.canonical import is_identity_type, is_int_type, is_numeric_mir_type, is_ptr_type, is_reference_type, is_signed_int_type
from compiler.mir.canonical import find_runtime_binding, is_aggregate_type, mir_type, signatures_match, uint_maximum
from compiler.mir.builder_verifier import verify_transient_capability_lifetimes

# One enclosing region while a body is walked: what a `Br` to it must supply.
# One open region while a body is walked. `defined_before` is the copy of
# the defined set every arm starts from; the `arms_*` flags accumulate what
# every completed arm proved; `last_*` describe the instruction just seen in
# the current arm.
class Region:
    pub let kind: RegionKind
    pub let results: RegisterRun
    pub let result_types: list[TypeId]
    pub let defined_before: list[bool]
    pub var arms_leave: bool
    pub var arms_terminate: bool
    pub var last_leaves: bool
    pub var last_terminates: bool
    pub var seen_else: bool
    pub var seen_default: bool
    pub var expecting_arm: bool
    pub let case_values: list[i64]

    pub init(kind: RegionKind, results: RegisterRun, result_types: list[TypeId], defined_before: list[bool]):
        self.kind = kind
        self.results = results
        self.result_types = result_types
        self.defined_before = defined_before
        self.arms_leave = true
        self.arms_terminate = true
        self.last_leaves = false
        self.last_terminates = false
        self.seen_else = false
        self.seen_default = false
        self.expecting_arm = false
        self.case_values = list[i64]()

enum RegionKind:
    block
    loop_body
    if_region
    switch_region
    # The function body itself, so the same flags serve the end-of-function check.
    function_body

## Verifies one complete canonical program.
pub class MirVerifier:
    let program: MirProgram
    # The function being walked, for diagnostics and register types.
    var function_name: str
    var registers: list[TypeId]

    pub init(program: MirProgram):
        self.program = program
        self.function_name = ""
        self.registers = list[TypeId]()

    # mark: Program =============================================================================

    ## Verify the whole program, or stop at the first violated rule.
    pub func verify() -> !:
        try self.verify_types()
        try self.verify_classes()
        try self.verify_interfaces()
        try self.verify_closures()
        try self.verify_runtime_bindings()
        for external in self.program.externs:
            try self.verify_extern(external)
        for global in self.program.external_globals:
            try self.verify_external_global(global)
        for global in self.program.globals:
            try self.verify_global(global)
        for item in self.program.data:
            try self.verify_data(item)
        try self.verify_unique_function_names()
        try self.verify_unique_external_symbols()
        for function in self.program.functions:
            try self.verify_function(function)
        try self.verify_entry()

    # Runtime composition binds semantic services to ordinary private Luce
    # functions. No later stage performs symbol lookup or invents an ABI.
    func verify_runtime_bindings() -> !:
        for index in range(0, len(self.program.runtime_bindings)):
            let binding = self.program.runtime_bindings[index]
            for previous in range(0, index):
                if self.program.runtime_bindings[previous].service == binding.service:
                    try self.fail_program("duplicate runtime binding for `" + str(binding.service) + "`")
            if i64(binding.function.value) >= len(self.program.functions):
                try self.fail_program("runtime binding `" + str(binding.service) + "` names function " + str(binding.function.value) + ", which does not exist")
            let function = self.program.functions[binding.function.value]
            if function.convention != CallingConvention.luce or function.is_public or function.is_exported:
                try self.fail_program("runtime binding `" + str(binding.service) + "` must name a private Luce function")
            match binding.service:
                storage_allocator:
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let expected = MirSignature(parameters = [u64_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false)
                    if not signatures_match(function.signature, expected):
                        try self.fail_program("runtime binding `storage_allocator` has signature " + describe_signature(self.program.types, function.signature) + ", expected " + describe_signature(self.program.types, expected))
                storage_deallocator:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                equality_context_create, hash_create, list_create, buffer_builder_create:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = list[TypeId](), results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                equality_context_release, hash_retain, hash_iteration_end, list_retain, slice_retain, list_iteration_end, buffer_retain, buffer_release:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = list[TypeId](), is_fallible = false, returns_never = false))
                equality_context_visit:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, ptr_type], results = [builtin_mir_type(BuiltinMirType.boolean)], is_fallible = false, returns_never = false))
                hash_release, hash_clear:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, u64_type, ptr_type, ptr_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                hash_copy:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, u64_type, ptr_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                hash_length, hash_iteration_begin:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.unsigned_u64)], is_fallible = false, returns_never = false))
                hash_find_first, hash_find_next, hash_entry_hash:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type], results = [u64_type], is_fallible = false, returns_never = false))
                hash_key_address, hash_value_address:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))
                hash_insert_entry:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, u64_type, u64_type], results = [u64_type], is_fallible = false, returns_never = false))
                hash_remove_entry, hash_reserve:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, u64_type, u64_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                list_release, slice_release, list_clear:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                list_copy, list_append_slot:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                list_element_address, slice_element_address:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))
                list_concat:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                buffer_concat:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, ptr_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))
                buffer_data:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                buffer_length:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [builtin_mir_type(BuiltinMirType.unsigned_u64)], is_fallible = false, returns_never = false))
                buffer_builder_append:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, u64_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                buffer_builder_finish, c_string_copy:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                display_signed:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.signed_i64)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                display_unsigned:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.unsigned_u64)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                display_float32:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.float32)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                display_float64:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.float64)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                display_character:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.unsigned_u32)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                display_boolean:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.boolean)], results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false, returns_never = false))
                string_scalar_count:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type], results = [u64_type], is_fallible = false, returns_never = false))
                string_decode:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = [u64_type], is_fallible = false, returns_never = false))
                list_length, list_iteration_begin, slice_length:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.unsigned_u64)], is_fallible = false, returns_never = false))
                list_iteration_active:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.boolean)], is_fallible = false, returns_never = false))
                list_mutable_slice_begin:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                list_insert_slot, list_mutable_element_address:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                list_slice:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))
                bytes_slice:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, u64_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))
                list_remove_at:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                list_reserve:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false, returns_never = false))
                class_create:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                class_mark_initialized, class_retain, class_release, weak_class_retain, weak_class_release:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = list[TypeId](), is_fallible = false, returns_never = false))
                class_payload, weak_class_create, weak_class_promote:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                interface_create:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type, ptr_type, ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                interface_retain, interface_release:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = list[TypeId](), is_fallible = false, returns_never = false))
                interface_detach, interface_payload:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [ptr_type], is_fallible = false, returns_never = false))
                interface_witness:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type], results = [ptr_type], is_fallible = false, returns_never = false))

    func require_runtime_signature(service: RuntimeService, function: MirFunction, expected: MirSignature) -> !:
        if not signatures_match(function.signature, expected):
            try self.fail_program("runtime binding `" + str(service) + "` has signature " + describe_signature(self.program.types, function.signature) + ", expected " + describe_signature(self.program.types, expected))

    # Type identities may point forward: a nominal aggregate can contain a
    # `List(Self)` because the list is a reference-sized break in its layout
    # graph. Validate every identity first, then reject only genuine by-value
    # cycles instead of imposing table order as a semantic restriction.
    func verify_types() -> !:
        let types = self.program.types
        for index in range(0, len(types.definitions)):
            match types.definitions[index]:
                Int(bits, is_signed):
                    if bits != 8 and bits != 16 and bits != 32 and bits != 64:
                        try self.fail_program("integer type " + str(index) + " has unsupported width " + str(bits))
                Float(bits):
                    if bits != 16 and bits != 32 and bits != 64:
                        try self.fail_program("float type " + str(index) + " has unsupported width " + str(bits))
                Struct(fields):
                    for field in fields:
                        try self.require_storable_type_id(field.value_type, "type " + str(index))
                Enum(tag, cases):
                    try self.require_type_id(tag, "enum type " + str(index) + " tag")
                    if not is_int_type(types, tag) or is_signed_int_type(types, tag):
                        try self.fail_program("enum type " + str(index) + " has a tag that is not an unsigned integer")
                    if len(cases) == 0: try self.fail_program("enum type " + str(index) + " has no cases")
                    if u64(len(cases) - 1) > uint_maximum(types, tag):
                        try self.fail_program("enum type " + str(index) + " tag cannot represent all " + str(len(cases)) + " cases")
                    for case_type in cases:
                        try self.require_storable_type_id(case_type, "enum type " + str(index))
                Array(element, count):
                    try self.require_storable_type_id(element, "array type " + str(index))
                    if count < 0: try self.fail_program("array type " + str(index) + " has a negative count")
                List(element):
                    try self.require_storable_type_id(element, "list type " + str(index))
                FrozenList(element):
                    try self.require_storable_type_id(element, "frozen-list type " + str(index))
                Map(key, value):
                    try self.require_storable_type_id(key, "map type " + str(index) + " key")
                    try self.require_storable_type_id(value, "map type " + str(index) + " value")
                Set(element):
                    try self.require_storable_type_id(element, "set type " + str(index) + " element")
                FrozenMap(key, value):
                    try self.require_storable_type_id(key, "frozen-map type " + str(index) + " key")
                    try self.require_storable_type_id(value, "frozen-map type " + str(index) + " value")
                FrozenSet(element):
                    try self.require_storable_type_id(element, "frozen-set type " + str(index) + " element")
                Slice(element):
                    try self.require_storable_type_id(element, "slice type " + str(index))
                MutableSlice(element):
                    try self.require_storable_type_id(element, "mutable-slice type " + str(index))
                Task(result, failure_type):
                    try self.require_storable_type_id(failure_type, "task type " + str(index) + " failure")
                    if not self.is_sendable_type(failure_type):
                        try self.fail_program("task type " + str(index) + " has non-sendable failure `" + describe_mir_type(types, failure_type) + "`")
                    match result:
                        Value(value_type):
                            try self.require_storable_type_id(value_type, "task type " + str(index) + " result")
                            if not self.is_sendable_type(value_type):
                                try self.fail_program("task type " + str(index) + " has non-sendable result `" + describe_mir_type(types, value_type) + "`")
                        else: pass
                Class(identity):
                    if i64(identity.value) >= len(self.program.classes):
                        try self.fail_program("type " + str(index) + " names class " + str(identity.value) + ", which does not exist")
                WeakClass(identity):
                    if i64(identity.value) >= len(self.program.classes):
                        try self.fail_program("type " + str(index) + " names class " + str(identity.value) + ", which does not exist")
                Interface(identity):
                    if i64(identity.value) >= len(self.program.interfaces):
                        try self.fail_program("type " + str(index) + " names interface " + str(identity.value) + ", which does not exist")
                Cell(element): try self.require_storable_type_id(element, "cell type " + str(index) + " element")
                Func(signature):
                    try self.verify_signature_types(signature, "function type " + str(index))
                else: pass
        let states = list[i64]()
        for index in range(0, len(types.definitions)): states.append(0)
        for index in range(0, len(types.definitions)):
            try self.verify_type_is_well_founded(TypeId(value = u32(index)), states)

    ## Validate nominal payload metadata independently from backend layout.
    ## Every class has one strong MIR type and one exact private destroyer.
    func verify_classes() -> !:
        for class_index in range(0, len(self.program.classes)):
            let class_type = try self.class_type(class_index)
            let class_value = self.program.classes[class_index]
            for field_index in range(0, len(class_value.fields)):
                try self.require_storable_type_id(class_value.fields[field_index].storage_type, "class " + str(class_index) + " field " + str(field_index))
                if self.contains_task_type(class_value.fields[field_index].storage_type):
                    try self.fail_program("class " + str(class_index) + " field " + str(field_index) + " cannot store a task capability")
            if i64(class_value.destroyer.value) >= len(self.program.functions):
                try self.fail_program("class " + str(class_index) + " destroyer names function " + str(class_value.destroyer.value) + ", which does not exist")
            let destroyer = self.program.functions[class_value.destroyer.value]
            if destroyer.convention != CallingConvention.luce or destroyer.is_public or destroyer.is_exported:
                try self.fail_program("class " + str(class_index) + " destroyer must name a private Luce function")
            let expected = MirSignature(
                parameters = [class_type, builtin_mir_type(BuiltinMirType.boolean)],
                results = list[TypeId](),
                is_fallible = false, returns_never = false,
            )
            if not signatures_match(destroyer.signature, expected):
                try self.fail_program("class " + str(class_index) + " destroyer has signature " + describe_signature(self.program.types, destroyer.signature) + ", expected " + describe_signature(self.program.types, expected))

    func class_type(class_index: i64) -> TypeId!:
        var found: i64 = -1
        for type_index in range(0, len(self.program.types.definitions)):
            match self.program.types.definitions[type_index]:
                Class(identity):
                    if i64(identity.value) == class_index:
                        if found >= 0: try self.fail_program("class " + str(class_index) + " has more than one strong MIR type")
                        found = type_index
                else: pass
        if found < 0: try self.fail_program("class " + str(class_index) + " has no strong MIR type")
        return TypeId(value = u32(found))

    ## Interface and witness metadata is the complete dynamic-call contract.
    ## Requirement signatures use an erased payload pointer, while every
    ## conformance thunk proves that exact normalized signature.
    func verify_interfaces() -> !:
        for interface_index in range(0, len(self.program.interfaces)):
            let interface_value = self.program.interfaces[interface_index]
            for requirement_index in range(0, len(interface_value.requirements)):
                try self.verify_signature_types(interface_value.requirements[requirement_index].signature, "interface " + str(interface_index) + " requirement " + str(requirement_index))
        for conformance_index in range(0, len(self.program.conformances)):
            let conformance = self.program.conformances[conformance_index]
            if i64(conformance.interface_id.value) >= len(self.program.interfaces):
                try self.fail_program("conformance " + str(conformance_index) + " names interface " + str(conformance.interface_id.value) + ", which does not exist")
            try self.require_storable_type_id(conformance.value_type, "conformance " + str(conformance_index) + " value")
            let requirements = self.program.interfaces[conformance.interface_id.value].requirements
            if len(conformance.implementations) != len(requirements):
                try self.fail_program("conformance " + str(conformance_index) + " has " + str(len(conformance.implementations)) + " witness(es), expected " + str(len(requirements)))
            for requirement_index in range(0, len(conformance.implementations)):
                let implementation = conformance.implementations[requirement_index]
                if i64(implementation.value) >= len(self.program.functions):
                    try self.fail_program("conformance " + str(conformance_index) + " witness " + str(requirement_index) + " names a missing function")
                let function = self.program.functions[implementation.value]
                if function.convention != CallingConvention.luce or function.is_public or function.is_exported or not signatures_match(function.signature, requirements[requirement_index].signature):
                    try self.fail_program("conformance " + str(conformance_index) + " witness " + str(requirement_index) + " does not match its requirement")
            try self.require_element_action_for_type(conformance.retain, conformance.value_type, "conformance " + str(conformance_index) + " retain")
            try self.require_element_action_for_type(conformance.release, conformance.value_type, "conformance " + str(conformance_index) + " release")

    ## Closure metadata is the complete target-neutral calling and payload
    ## contract. A hidden body differs from its public function signature only
    ## by the opaque environment parameter; its destroyer owns that payload.
    func verify_closures() -> !:
        let pointer = builtin_mir_type(BuiltinMirType.pointer)
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        for closure_index in range(0, len(self.program.closures)):
            let closure = self.program.closures[closure_index]
            try self.verify_signature_types(closure.signature, "closure " + str(closure_index) + " signature")
            for capture_index in range(0, len(closure.captures)):
                try self.require_storable_type_id(closure.captures[capture_index].value_type, "closure " + str(closure_index) + " capture " + str(capture_index))
                if self.contains_task_type(closure.captures[capture_index].value_type):
                    try self.fail_program("closure " + str(closure_index) + " capture " + str(capture_index) + " cannot store a task capability")
            if i64(closure.function.value) >= len(self.program.functions):
                try self.fail_program("closure " + str(closure_index) + " names function " + str(closure.function.value) + ", which does not exist")
            let target = self.program.functions[closure.function.value]
            if target.convention != CallingConvention.luce or target.is_public or target.is_exported:
                try self.fail_program("closure " + str(closure_index) + " must name a private Luce function")
            let parameters = list[TypeId]()
            for parameter in closure.signature.parameters: parameters.append(parameter)
            var environment_index: i64 = 0
            if closure.signature.is_fallible: environment_index = 1
            parameters.insert(environment_index, pointer)
            let expected_target = MirSignature(parameters = parameters, results = closure.signature.results, is_fallible = closure.signature.is_fallible, returns_never = closure.signature.returns_never)
            if not signatures_match(target.signature, expected_target):
                try self.fail_program("closure " + str(closure_index) + " body has signature " + describe_signature(self.program.types, target.signature) + ", expected " + describe_signature(self.program.types, expected_target))
            if i64(closure.destroyer.value) >= len(self.program.functions):
                try self.fail_program("closure " + str(closure_index) + " destroyer names function " + str(closure.destroyer.value) + ", which does not exist")
            let destroyer = self.program.functions[closure.destroyer.value]
            if destroyer.convention != CallingConvention.luce or destroyer.is_public or destroyer.is_exported:
                try self.fail_program("closure " + str(closure_index) + " destroyer must name a private Luce function")
            let expected_destroyer = MirSignature(parameters = [pointer, boolean], results = list[TypeId](), is_fallible = false, returns_never = false)
            if not signatures_match(destroyer.signature, expected_destroyer):
                try self.fail_program("closure " + str(closure_index) + " destroyer has signature " + describe_signature(self.program.types, destroyer.signature) + ", expected " + describe_signature(self.program.types, expected_destroyer))

    func verify_type_is_well_founded(id: TypeId, states: list[i64]) -> !:
        if states[id.value] == 2: return
        if states[id.value] == 1:
            try self.fail_program("type " + str(id.value) + " contains itself by value")
        states[id.value] = 1
        match self.program.types.definitions[id.value]:
            Struct(fields):
                for field in fields:
                    try self.verify_type_is_well_founded(field.value_type, states)
            Array(element, count): try self.verify_type_is_well_founded(element, states)
            Enum(tag, cases):
                for case_type in cases:
                    try self.verify_type_is_well_founded(case_type, states)
            else: pass
        states[id.value] = 2

    func verify_signature_types(signature: MirSignature, what: str) -> !:
        for parameter in signature.parameters:
            try self.require_parameter_type_id(parameter, what + " parameter")
        for result in signature.results:
            try self.require_storable_type_id(result, what + " result")
            if self.contains_task_type(result): try self.fail_program(what + " cannot return a task capability")
        if signature.is_fallible:
            if len(signature.parameters) == 0 or not is_ptr_type(self.program.types, signature.parameters[0]):
                try self.fail_program(what + " is fallible but parameter 0 is not the caller-owned `ptr` error slot")
            if len(signature.results) == 0 or not is_ptr_type(self.program.types, signature.results[len(signature.results) - 1]):
                try self.fail_program(what + " is fallible but its last result is not the `ptr` error pointer")
            if len(signature.results) > 2: try self.fail_program(what + " has more than one value result")
        elif len(signature.results) > 1:
            try self.fail_program(what + " has more than one result")
        if signature.returns_never:
            var expected_results: i64 = 0
            if signature.is_fallible: expected_results = 1
            if len(signature.results) != expected_results:
                try self.fail_program(what + " returns `never` but has a successful value result")

    # A runtime extern must be a known service with its known signature; a C
    # extern must be C-representable.
    func verify_extern(external: MirExtern) -> !:
        try self.verify_signature_types(external.signature, "extern `" + external.name + "`")
        match external.convention:
            runtime:
                let known = find_runtime_symbol(external.name) else error("MIR verifier: extern `" + external.name + "` is not a runtime service")
                if not signatures_match(known.signature, external.signature):
                    try self.fail_program("runtime extern `" + external.name + "` has signature " + describe_signature(self.program.types, external.signature) + ", expected " + describe_signature(self.program.types, known.signature))
            c:
                try self.require_c_signature(external.signature, "extern `" + external.name + "`")
            luce:
                try self.fail_program("extern `" + external.name + "` uses the `luce` convention; externs are C or runtime symbols")

    func verify_global(global: MirGlobal) -> !:
        try self.require_storable_type_id(global.value_type, "global `" + global.name + "`")
        if self.contains_task_type(global.value_type): try self.fail_program("global `" + global.name + "` cannot store a task capability")
        let initial = global.initial
        if initial != none:
            if i64(initial.value) >= len(self.program.data):
                try self.fail_program("global `" + global.name + "` is initialised from data item " + str(initial.value) + ", which does not exist")

    func verify_external_global(global: MirExternalGlobal) -> !:
        try self.require_type_id(global.value_type, "external global `" + global.name + "`")
        match mir_type(self.program.types, global.value_type):
            Int(bits, is_signed): pass
            Float(bits):
                if bits == 16: try self.fail_program("external global `" + global.name + "` has non-C-ABI type `f16`")
            Bool: pass
            Ptr: pass
            else: try self.fail_program("external global `" + global.name + "` has non-scalar type `" + describe_mir_type(self.program.types, global.value_type) + "`")

    func verify_data(item: MirData) -> !:
        if item.align < 1: try self.fail_program("data `" + item.name + "` has alignment " + str(item.align))
        if (item.align & (item.align - 1)) != 0:
            try self.fail_program("data `" + item.name + "` has non-power-of-two alignment " + str(item.align))

    # Only functions whose spelling survives into an artifact inhabit a name
    # namespace. Private Luce definitions are addressed exclusively by their
    # FunctionId; independently lowered packages may legitimately synthesize
    # the same diagnostic name for structurally identical ownership helpers.
    func verify_unique_function_names() -> !:
        for index in range(0, len(self.program.functions)):
            let function = self.program.functions[index]
            let has_artifact_name = function.is_public or function.is_exported or function.convention == CallingConvention.c
            if not has_artifact_name: continue
            for previous in range(0, index):
                let other = self.program.functions[previous]
                let other_has_artifact_name = other.is_public or other.is_exported or other.convention == CallingConvention.c
                if other_has_artifact_name and other.name == function.name:
                    try self.fail_program("duplicate function `" + function.name + "`")

    # C functions and objects inhabit one external symbol namespace.
    func verify_unique_external_symbols() -> !:
        for index in range(0, len(self.program.externs)):
            for previous in range(0, index):
                if self.program.externs[previous].name == self.program.externs[index].name:
                    try self.fail_program("duplicate extern symbol `" + self.program.externs[index].name + "`")
        for index in range(0, len(self.program.external_globals)):
            let name = self.program.external_globals[index].name
            for external in self.program.externs:
                if external.name == name: try self.fail_program("external symbol `" + name + "` is both a function and a global")
            for previous in range(0, index):
                if self.program.external_globals[previous].name == name:
                    try self.fail_program("duplicate external global `" + name + "`")

    # A process entry takes nothing and returns the `i32` exit status.
    func verify_entry() -> !:
        let entry = self.program.entry
        if entry == none: return
        if i64(entry.value) >= len(self.program.functions):
            try self.fail_program("entry names function " + str(entry.value) + ", which does not exist")
        let function = self.program.functions[entry.value]
        let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
        let expected = MirSignature(parameters = list[TypeId](), results = [i32_type], is_fallible = false, returns_never = false)
        if not signatures_match(function.signature, expected):
            try self.fail_program("entry `" + function.name + "` must be `() -> i32`, found " + describe_signature(self.program.types, function.signature))

    # mark: Functions ===========================================================================

    func verify_function(function: MirFunction) -> !:
        self.function_name = function.name
        self.registers = function.registers
        try self.verify_signature_types(function.signature, "function `" + function.name + "`")
        if function.convention == CallingConvention.c:
            try self.require_c_signature(function.signature, "function `" + function.name + "`")
        if function.convention == CallingConvention.runtime:
            try self.fail("uses the `runtime` convention, which belongs to externs")

        for register_type in function.registers:
            try self.require_type_id(register_type, "function `" + function.name + "`")
            match mir_type(self.program.types, register_type):
                Uninhabited: try self.fail("has an uninhabited `never` register")
                else: pass
        for slot in function.slots:
            try self.require_storable_type_id(slot.value_type, "function `" + function.name + "` slot")

        # Parameters are the leading registers, in signature order.
        let defined = list[bool]()
        let known_null = list[bool]()
        for index in range(0, len(function.registers)):
            defined.append(index < len(function.signature.parameters))
            known_null.append(false)
        if len(function.signature.parameters) > len(function.registers):
            try self.fail("declares fewer registers than parameters")
        for index in range(0, len(function.signature.parameters)):
            if function.registers[index].value != function.signature.parameters[index].value:
                try self.fail("register r" + str(index) + " must have its parameter's type")

        let root = Region(kind = RegionKind.function_body, results = no_registers(), result_types = list[TypeId](), defined_before = copy_defined(defined))
        let regions = [root]
        for instruction in function.body:
            try self.verify_instruction(function, instruction, defined, known_null, regions)
        if len(regions) != 1:
            try self.fail("has " + str(len(regions) - 1) + " region(s) without an `End`")
        if not root.last_terminates:
            try self.fail("can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")
        try verify_transient_capability_lifetimes(self.program, function)

    # mark: Bodies ==============================================================================

    # Check one instruction of the flat body. Openers push a region, arm
    # separators restore the defined set the region started from, `End`
    # pops and defines the region's results; everything else is a straight-
    # line definition or use.
    func verify_instruction(function: MirFunction, instruction: MirInstruction, defined: list[bool], known_null: list[bool], regions: list[Region]) -> !:
        let types = self.program.types
        let current = regions[len(regions) - 1]
        if current.expecting_arm:
            match instruction.form:
                Case(value): current.expecting_arm = false
                Default: current.expecting_arm = false
                else: try self.fail_at(instruction, "`Switch` must be followed by `Case` or `Default`")
        # Every instruction below either sets these itself or is straight-line.
        var leaves = false
        var terminates_here = false
        match instruction.form:
            Const(result, value):
                let result_type = try self.result_type(result, defined)
                match value:
                    SignedInt(item):
                        if not is_signed_int_type(types, result_type): try self.fail_at(instruction, "signed integer constant into `" + describe_mir_type(types, result_type) + "` register")
                        if item < int_minimum(types, result_type) or item > int_maximum(types, result_type):
                            try self.fail_at(instruction, "constant " + str(item) + " is outside `" + describe_mir_type(types, result_type) + "`")
                    UnsignedInt(item):
                        if not is_int_type(types, result_type) or is_signed_int_type(types, result_type):
                            try self.fail_at(instruction, "unsigned integer constant into `" + describe_mir_type(types, result_type) + "` register")
                        if item > uint_maximum(types, result_type):
                            try self.fail_at(instruction, "constant " + str(item) + " is outside `" + describe_mir_type(types, result_type) + "`")
                    Float(item):
                        if not is_float_type(types, result_type): try self.fail_at(instruction, "float constant into `" + describe_mir_type(types, result_type) + "` register")
                    Bool(item):
                        if not is_bool_type(types, result_type): try self.fail_at(instruction, "bool constant into `" + describe_mir_type(types, result_type) + "` register")
                    Null:
                        if not is_ptr_type(types, result_type) and not is_reference_type(types, result_type):
                            try self.fail_at(instruction, "null into `" + describe_mir_type(types, result_type) + "` register")
                        known_null[result.value] = true
                self.define(result, defined)
            Copy(result, source):
                let source_type = try self.operand_type(instruction, source, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, source_type, "`Copy`")
                known_null[result.value] = known_null[source.value]
                self.define(result, defined)
            Binary(result, operation, left, right):
                let left_type = try self.operand_type(instruction, left, defined)
                let right_type = try self.operand_type(instruction, right, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, left_type, right_type, "`" + str(operation) + "` operands")
                try self.verify_binary(instruction, operation, left_type, result_type)
                self.define(result, defined)
            Unary(result, operation, operand):
                let operand_type = try self.operand_type(instruction, operand, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, operand_type, "`" + str(operation) + "`")
                match operation:
                    neg:
                        if not is_float_type(types, operand_type) and not is_signed_int_type(types, operand_type):
                            try self.fail_at(instruction, "`neg` needs a signed integer or float, found `" + describe_mir_type(types, operand_type) + "`")
                    bit_not:
                        if not is_int_type(types, operand_type): try self.fail_at(instruction, "`bit_not` needs an integer, found `" + describe_mir_type(types, operand_type) + "`")
                    bool_not:
                        if not is_bool_type(types, operand_type): try self.fail_at(instruction, "`bool_not` needs `bool`, found `" + describe_mir_type(types, operand_type) + "`")
                self.define(result, defined)
            Convert(result, operation, operand):
                let operand_type = try self.operand_type(instruction, operand, defined)
                let result_type = try self.result_type(result, defined)
                match operation:
                    extend:
                        if not is_int_type(types, operand_type) or not is_int_type(types, result_type) or bits_of(types, result_type) <= bits_of(types, operand_type):
                            try self.fail_at(instruction, "`extend` must widen an integer, found `" + describe_mir_type(types, operand_type) + "` to `" + describe_mir_type(types, result_type) + "`")
                    wrap:
                        if not is_int_type(types, operand_type) or not is_int_type(types, result_type) or bits_of(types, result_type) >= bits_of(types, operand_type):
                            try self.fail_at(instruction, "`wrap` must narrow an integer, found `" + describe_mir_type(types, operand_type) + "` to `" + describe_mir_type(types, result_type) + "`")
                    int_reinterpret:
                        if not is_int_type(types, operand_type) or not is_int_type(types, result_type) or bits_of(types, result_type) != bits_of(types, operand_type):
                            try self.fail_at(instruction, "`int_reinterpret` needs equal-width integers")
                    int_to_float:
                        if not is_int_type(types, operand_type) or not is_float_type(types, result_type):
                            try self.fail_at(instruction, "`int_to_float` needs an integer operand and a float result")
                    float_to_int:
                        if not is_float_type(types, operand_type) or not is_int_type(types, result_type):
                            try self.fail_at(instruction, "`float_to_int` needs a float operand and an integer result")
                    float_resize:
                        if not is_float_type(types, operand_type) or not is_float_type(types, result_type) or bits_of(types, operand_type) == bits_of(types, result_type):
                            try self.fail_at(instruction, "`float_resize` needs floats of different widths")
                self.define(result, defined)
            FloatBits(result, operand):
                let operand_type = try self.operand_type(instruction, operand, defined)
                if not is_float_type(types, operand_type):
                    try self.fail_at(instruction, "`FloatBits` needs a float operand, found `" + describe_mir_type(types, operand_type) + "`")
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, builtin_mir_type(BuiltinMirType.unsigned_u64), "`FloatBits` result")
                self.define(result, defined)
            PointerHash(result, operand):
                try self.require_ptr_operand(instruction, operand, defined, "`PointerHash` operand")
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, builtin_mir_type(BuiltinMirType.unsigned_u64), "`PointerHash` result")
                self.define(result, defined)
            Alloca(result, slot):
                if slot < 0 or slot >= len(function.slots): try self.fail_at(instruction, "`Alloca` names slot " + str(slot) + ", which does not exist")
                try self.require_ptr_result(instruction, result, defined, "`Alloca`")
                self.define(result, defined)
            AllocateStorage(result, element_type, count):
                try self.require_storable_instruction_type(instruction, element_type, "`AllocateStorage` element")
                let count_type = try self.operand_type(instruction, count, defined)
                let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                try self.require_same(instruction, count_type, u64_type, "`AllocateStorage` count")
                if find_runtime_binding(self.program, RuntimeService.storage_allocator) == none:
                    try self.fail_at(instruction, "`AllocateStorage` requires the `storage_allocator` runtime binding")
                try self.require_ptr_result(instruction, result, defined, "`AllocateStorage`")
                self.define(result, defined)
            DeallocateStorage(address, element_type, count):
                let address_type = try self.operand_type(instruction, address, defined)
                try self.require_same(instruction, address_type, builtin_mir_type(BuiltinMirType.pointer), "`DeallocateStorage` address")
                try self.require_storable_instruction_type(instruction, element_type, "`DeallocateStorage` element")
                let count_type = try self.operand_type(instruction, count, defined)
                try self.require_same(instruction, count_type, builtin_mir_type(BuiltinMirType.unsigned_u64), "`DeallocateStorage` count")
                if find_runtime_binding(self.program, RuntimeService.storage_deallocator) == none:
                    try self.fail_at(instruction, "`DeallocateStorage` requires the `storage_deallocator` runtime binding")
            EqualityContextCreate(result):
                if find_runtime_binding(self.program, RuntimeService.equality_context_create) == none:
                    try self.fail_at(instruction, "`EqualityContextCreate` requires the `equality_context_create` runtime binding")
                try self.require_ptr_result(instruction, result, defined, "`EqualityContextCreate`")
                self.define(result, defined)
            EqualityContextRelease(value):
                try self.require_ptr_operand(instruction, value, defined, "`EqualityContextRelease` value")
                if find_runtime_binding(self.program, RuntimeService.equality_context_release) == none:
                    try self.fail_at(instruction, "`EqualityContextRelease` requires the `equality_context_release` runtime binding")
            EqualityContextVisit(result, context, left, right):
                try self.require_ptr_operand(instruction, context, defined, "`EqualityContextVisit` context")
                let left_type = try self.operand_type(instruction, left, defined)
                let right_type = try self.operand_type(instruction, right, defined)
                match mir_type(self.program.types, left_type):
                    List(element): pass
                    Map(key, value): pass
                    FrozenList(element): pass
                    FrozenMap(key, value): pass
                    FrozenSet(element): pass
                    else: try self.fail_at(instruction, "`EqualityContextVisit` left value must be a recursive collection, found `" + describe_mir_type(self.program.types, left_type) + "`")
