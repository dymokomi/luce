                try self.require_same(instruction, stored_type, value_type, "`Store`")
                try self.require_register_sized(instruction, value_type, "`Store`")
            FieldAddress(result, struct_type, base, field):
                try self.require_type_id(struct_type, "`FieldAddress`")
                match mir_type(types, struct_type):
                    Struct(fields):
                        if field < 0 or field >= len(fields): try self.fail_at(instruction, "`FieldAddress` names field " + str(field) + " of a struct with " + str(len(fields)) + " field(s)")
                    else: try self.fail_at(instruction, "`FieldAddress` needs a struct type, found `" + describe_mir_type(types, struct_type) + "`")
