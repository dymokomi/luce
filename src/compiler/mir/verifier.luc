#==============================================================================================
#
#   mir_verifier - Proves the rules every backend may assume
#
#   DESCRIPTION:
#       Runs on canonical MIR before and after optimization. A backend that
#       receives a verified program checks nothing: registers are defined once
#       and before use with the type they were declared with, operands match
#       their instruction, branch depths are in range, every region's results
#       are supplied on every exit, aggregate types are structurally valid,
#       fallible functions end each path in `Return` or `Raise`, C
#       signatures carry only C-representable types, runtime symbols carry
#       their known signatures.
#
#       The walk mirrors the program's own shape: the type table, then each
#       extern, global, and data item, then each function's body in one
#       linear pass. A body is a flat list in which `Block`/`Loop`/`If`/
#       `Switch` open a region, `Else`/`Case`/`Default` start a new arm, and
#       `End` closes it; the verifier keeps a stack of open regions, and each
#       arm is checked on a copy of the "defined so far" set taken at the
#       opener, so a register defined inside an `If` arm is not visible after
#       the `End` unless the region names it as a result.
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from compiler.mir.canonical import FunctionId, GlobalId, InstructionForm, MirConstant, MirData, MirExtern
from compiler.mir.canonical import MirExternalGlobal, MirFunction, MirGlobal, MirInstruction, MirProgram, MirSignature, MirType
from compiler.runtime_contract import RuntimeService
from compiler.mir.canonical import MirTypeTable, RegisterId, RegisterRun, TypeId, no_registers, registers_of
from compiler.mir.canonical import bits_of, builtin_mir_type, describe_mir_type, describe_signature
from compiler.mir.canonical import find_runtime_symbol, int_maximum, int_minimum, is_bool_type, is_float_type
from compiler.mir.canonical import is_identity_type, is_int_type, is_numeric_mir_type, is_ptr_type, is_reference_type, is_signed_int_type
from compiler.mir.canonical import find_runtime_binding, mir_type, signatures_match

# One enclosing region while a body is walked: what a `Br` to it must supply.
# One open region while a body is walked. `defined_before` is the copy of
# the defined set every arm starts from; the `arms_*` flags accumulate what
# every completed arm proved; `last_*` describe the instruction just seen in
# the current arm.
class Region:
    pub let kind: RegionKind
    pub let results: RegisterRun
    pub let result_types: list[TypeId]
    pub let defined_before: list[bool]
    pub var arms_leave: bool
    pub var arms_terminate: bool
    pub var last_leaves: bool
    pub var last_terminates: bool
    pub var seen_else: bool
    pub var seen_default: bool
    pub var expecting_arm: bool
    pub let case_values: list[i64]

    pub init(kind: RegionKind, results: RegisterRun, result_types: list[TypeId], defined_before: list[bool]):
        self.kind = kind
        self.results = results
        self.result_types = result_types
        self.defined_before = defined_before
        self.arms_leave = true
        self.arms_terminate = true
        self.last_leaves = false
        self.last_terminates = false
        self.seen_else = false
        self.seen_default = false
        self.expecting_arm = false
        self.case_values = list[i64]()

enum RegionKind:
    block
    loop_body
    if_region
    switch_region
    # The function body itself, so the same flags serve the end-of-function check.
    function_body

## Verifies one complete canonical program.
pub class MirVerifier:
    let program: MirProgram
    # The function being walked, for diagnostics and register types.
    var function_name: str
    var registers: list[TypeId]

    pub init(program: MirProgram):
        self.program = program
        self.function_name = ""
        self.registers = list[TypeId]()

    # mark: Program =============================================================================

    ## Verify the whole program, or stop at the first violated rule.
    pub func verify() -> !:
        try self.verify_types()
        try self.verify_runtime_bindings()
        for external in self.program.externs:
            try self.verify_extern(external)
        for global in self.program.external_globals:
            try self.verify_external_global(global)
        for global in self.program.globals:
            try self.verify_global(global)
        for item in self.program.data:
            try self.verify_data(item)
        try self.verify_unique_function_names()
        try self.verify_unique_external_symbols()
        for function in self.program.functions:
            try self.verify_function(function)
        try self.verify_entry()

    # Runtime composition binds semantic services to ordinary private Luce
    # functions. No later stage performs symbol lookup or invents an ABI.
    func verify_runtime_bindings() -> !:
        for index in range(0, len(self.program.runtime_bindings)):
            let binding = self.program.runtime_bindings[index]
            for previous in range(0, index):
                if self.program.runtime_bindings[previous].service == binding.service:
                    try self.fail_program("duplicate runtime binding for `" + str(binding.service) + "`")
            if i64(binding.function.value) >= len(self.program.functions):
                try self.fail_program("runtime binding `" + str(binding.service) + "` names function " + str(binding.function.value) + ", which does not exist")
            let function = self.program.functions[binding.function.value]
            if function.convention != CallingConvention.luce or function.is_public or function.is_exported:
                try self.fail_program("runtime binding `" + str(binding.service) + "` must name a private Luce function")
            match binding.service:
                storage_allocator:
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let expected = MirSignature(parameters = [u64_type, u64_type], results = [ptr_type], is_fallible = false)
                    if not signatures_match(function.signature, expected):
                        try self.fail_program("runtime binding `storage_allocator` has signature " + describe_signature(self.program.types, function.signature) + ", expected " + describe_signature(self.program.types, expected))
                storage_deallocator:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = list[TypeId](), is_fallible = false))
                list_create:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = list[TypeId](), results = [builtin_mir_type(BuiltinMirType.pointer)], is_fallible = false))
                list_retain, slice_retain, list_iteration_end, buffer_retain, buffer_release:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = list[TypeId](), is_fallible = false))
                list_release, slice_release, list_clear:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false))
                list_copy, list_append_slot:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false))
                list_element_address, slice_element_address:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = [ptr_type], is_fallible = false))
                list_concat:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false))
                buffer_concat:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, ptr_type, u64_type], results = [ptr_type], is_fallible = false))
                buffer_data:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type], results = [ptr_type], is_fallible = false))
                string_scalar_count:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type], results = [u64_type], is_fallible = false))
                string_decode:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type], results = [u64_type], is_fallible = false))
                list_length, list_iteration_begin, slice_length:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.unsigned_u64)], is_fallible = false))
                list_iteration_active:
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.boolean)], is_fallible = false))
                list_insert_slot, list_mutable_element_address:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = [ptr_type], is_fallible = false))
                list_slice:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type], results = [ptr_type], is_fallible = false))
                bytes_slice:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, ptr_type, u64_type, u64_type], results = [ptr_type], is_fallible = false))
                list_remove_at:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false))
                list_reserve:
                    let ptr_type = builtin_mir_type(BuiltinMirType.pointer)
                    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
                    try self.require_runtime_signature(binding.service, function, MirSignature(parameters = [ptr_type, u64_type, u64_type, u64_type, ptr_type], results = list[TypeId](), is_fallible = false))

    func require_runtime_signature(service: RuntimeService, function: MirFunction, expected: MirSignature) -> !:
        if not signatures_match(function.signature, expected):
            try self.fail_program("runtime binding `" + str(service) + "` has signature " + describe_signature(self.program.types, function.signature) + ", expected " + describe_signature(self.program.types, expected))

    # Type identities may point forward: a nominal aggregate can contain a
    # `List(Self)` because the list is a reference-sized break in its layout
    # graph. Validate every identity first, then reject only genuine by-value
    # cycles instead of imposing table order as a semantic restriction.
    func verify_types() -> !:
        let types = self.program.types
        for index in range(0, len(types.definitions)):
            match types.definitions[index]:
                Struct(fields):
                    for field in fields:
                        try self.require_type_id(field.value_type, "type " + str(index))
                Enum(tag, cases):
                    try self.require_type_id(tag, "enum type " + str(index) + " tag")
                    if not is_int_type(types, tag): try self.fail_program("enum type " + str(index) + " has a non-integer tag")
                    for case_type in cases:
                        try self.require_type_id(case_type, "enum type " + str(index))
                Array(element, count):
                    try self.require_type_id(element, "array type " + str(index))
                    if count < 0: try self.fail_program("array type " + str(index) + " has a negative count")
                List(element):
                    try self.require_type_id(element, "list type " + str(index))
                Slice(element):
                    try self.require_type_id(element, "slice type " + str(index))
                Func(signature):
                    try self.verify_signature_types(signature, "function type " + str(index))
                else: pass
        let states = list[i64]()
        for index in range(0, len(types.definitions)): states.append(0)
        for index in range(0, len(types.definitions)):
            try self.verify_type_is_well_founded(TypeId(value = u32(index)), states)

    func verify_type_is_well_founded(id: TypeId, states: list[i64]) -> !:
        if states[id.value] == 2: return
        if states[id.value] == 1:
            try self.fail_program("type " + str(id.value) + " contains itself by value")
        states[id.value] = 1
        match self.program.types.definitions[id.value]:
            Struct(fields):
                for field in fields:
                    try self.verify_type_is_well_founded(field.value_type, states)
            Array(element, count): try self.verify_type_is_well_founded(element, states)
            Enum(tag, cases):
                for case_type in cases:
                    try self.verify_type_is_well_founded(case_type, states)
            else: pass
        states[id.value] = 2

    func verify_signature_types(signature: MirSignature, what: str) -> !:
        for parameter in signature.parameters:
            try self.require_type_id(parameter, what)
        for result in signature.results:
            try self.require_type_id(result, what)
        if signature.is_fallible:
            if len(signature.parameters) == 0 or not is_ptr_type(self.program.types, signature.parameters[0]):
                try self.fail_program(what + " is fallible but parameter 0 is not the caller-owned `ptr` error slot")
            if len(signature.results) == 0 or not is_ptr_type(self.program.types, signature.results[len(signature.results) - 1]):
                try self.fail_program(what + " is fallible but its last result is not the `ptr` error pointer")
            if len(signature.results) > 2: try self.fail_program(what + " has more than one value result")
        elif len(signature.results) > 1:
            try self.fail_program(what + " has more than one result")

    # A runtime extern must be a known service with its known signature; a C
    # extern must be C-representable.
    func verify_extern(external: MirExtern) -> !:
        try self.verify_signature_types(external.signature, "extern `" + external.name + "`")
        match external.convention:
            runtime:
                let known = find_runtime_symbol(external.name) else error("MIR verifier: extern `" + external.name + "` is not a runtime service")
                if not signatures_match(known.signature, external.signature):
                    try self.fail_program("runtime extern `" + external.name + "` has signature " + describe_signature(self.program.types, external.signature) + ", expected " + describe_signature(self.program.types, known.signature))
            c:
                try self.require_c_signature(external.signature, "extern `" + external.name + "`")
            luce:
                try self.fail_program("extern `" + external.name + "` uses the `luce` convention; externs are C or runtime symbols")

    func verify_global(global: MirGlobal) -> !:
        try self.require_type_id(global.value_type, "global `" + global.name + "`")
        let initial = global.initial
        if initial != none:
            if i64(initial.value) >= len(self.program.data):
                try self.fail_program("global `" + global.name + "` is initialised from data item " + str(initial.value) + ", which does not exist")

    func verify_external_global(global: MirExternalGlobal) -> !:
        try self.require_type_id(global.value_type, "external global `" + global.name + "`")
        match mir_type(self.program.types, global.value_type):
            Int(bits, is_signed): pass
            Float(bits): pass
            Bool: pass
            Ptr: pass
            else: try self.fail_program("external global `" + global.name + "` has non-scalar type `" + describe_mir_type(self.program.types, global.value_type) + "`")

    func verify_data(item: MirData) -> !:
        if item.align < 1: try self.fail_program("data `" + item.name + "` has alignment " + str(item.align))
        if (item.align & (item.align - 1)) != 0:
            try self.fail_program("data `" + item.name + "` has non-power-of-two alignment " + str(item.align))

    # A canonical name identifies one function in the whole program.
    func verify_unique_function_names() -> !:
        for index in range(0, len(self.program.functions)):
            let function = self.program.functions[index]
            for previous in range(0, index):
                if self.program.functions[previous].name == function.name:
                    try self.fail_program("duplicate function `" + function.name + "`")

    # C functions and objects inhabit one external symbol namespace.
    func verify_unique_external_symbols() -> !:
        for index in range(0, len(self.program.externs)):
            for previous in range(0, index):
                if self.program.externs[previous].name == self.program.externs[index].name:
                    try self.fail_program("duplicate extern symbol `" + self.program.externs[index].name + "`")
        for index in range(0, len(self.program.external_globals)):
            let name = self.program.external_globals[index].name
            for external in self.program.externs:
                if external.name == name: try self.fail_program("external symbol `" + name + "` is both a function and a global")
            for previous in range(0, index):
                if self.program.external_globals[previous].name == name:
                    try self.fail_program("duplicate external global `" + name + "`")

    # A process entry takes nothing and returns the `i32` exit status.
    func verify_entry() -> !:
        let entry = self.program.entry
        if entry == none: return
        if i64(entry.value) >= len(self.program.functions):
            try self.fail_program("entry names function " + str(entry.value) + ", which does not exist")
        let function = self.program.functions[entry.value]
        let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
        let expected = MirSignature(parameters = list[TypeId](), results = [i32_type], is_fallible = false)
        if not signatures_match(function.signature, expected):
            try self.fail_program("entry `" + function.name + "` must be `() -> i32`, found " + describe_signature(self.program.types, function.signature))

    # mark: Functions ===========================================================================

    func verify_function(function: MirFunction) -> !:
        self.function_name = function.name
        self.registers = function.registers
        try self.verify_signature_types(function.signature, "function `" + function.name + "`")
        if function.convention == CallingConvention.c:
            try self.require_c_signature(function.signature, "function `" + function.name + "`")
        if function.convention == CallingConvention.runtime:
            try self.fail("uses the `runtime` convention, which belongs to externs")

        for register_type in function.registers:
            try self.require_type_id(register_type, "function `" + function.name + "`")
        for slot in function.slots:
            try self.require_type_id(slot.value_type, "function `" + function.name + "`")

        # Parameters are the leading registers, in signature order.
        let defined = list[bool]()
        let known_null = list[bool]()
        for index in range(0, len(function.registers)):
            defined.append(index < len(function.signature.parameters))
            known_null.append(false)
        if len(function.signature.parameters) > len(function.registers):
            try self.fail("declares fewer registers than parameters")
        for index in range(0, len(function.signature.parameters)):
            if function.registers[index].value != function.signature.parameters[index].value:
                try self.fail("register r" + str(index) + " must have its parameter's type")

        let root = Region(kind = RegionKind.function_body, results = no_registers(), result_types = list[TypeId](), defined_before = copy_defined(defined))
        let regions = [root]
        for instruction in function.body:
            try self.verify_instruction(function, instruction, defined, known_null, regions)
        if len(regions) != 1:
            try self.fail("has " + str(len(regions) - 1) + " region(s) without an `End`")
        if not root.last_terminates:
            try self.fail("can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")

    # mark: Bodies ==============================================================================

    # Check one instruction of the flat body. Openers push a region, arm
    # separators restore the defined set the region started from, `End`
    # pops and defines the region's results; everything else is a straight-
    # line definition or use.
    func verify_instruction(function: MirFunction, instruction: MirInstruction, defined: list[bool], known_null: list[bool], regions: list[Region]) -> !:
        let types = self.program.types
        let current = regions[len(regions) - 1]
        if current.expecting_arm:
            match instruction.form:
                Case(value): current.expecting_arm = false
                Default: current.expecting_arm = false
                else: try self.fail_at(instruction, "`Switch` must be followed by `Case` or `Default`")
        # Every instruction below either sets these itself or is straight-line.
        var leaves = false
        var terminates_here = false
        match instruction.form:
            Const(result, value):
                let result_type = try self.result_type(result, defined)
                match value:
                    Int(item):
                        if not is_int_type(types, result_type): try self.fail_at(instruction, "integer constant into `" + describe_mir_type(types, result_type) + "` register")
                        if item < int_minimum(types, result_type) or item > int_maximum(types, result_type):
                            try self.fail_at(instruction, "constant " + str(item) + " is outside `" + describe_mir_type(types, result_type) + "`")
                    Float(item):
                        if not is_float_type(types, result_type): try self.fail_at(instruction, "float constant into `" + describe_mir_type(types, result_type) + "` register")
                    Bool(item):
                        if not is_bool_type(types, result_type): try self.fail_at(instruction, "bool constant into `" + describe_mir_type(types, result_type) + "` register")
                    Null:
                        if not is_ptr_type(types, result_type) and not is_reference_type(types, result_type):
                            try self.fail_at(instruction, "null into `" + describe_mir_type(types, result_type) + "` register")
                        known_null[result.value] = true
                self.define(result, defined)
            Copy(result, source):
                let source_type = try self.operand_type(instruction, source, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, source_type, "`Copy`")
                known_null[result.value] = known_null[source.value]
                self.define(result, defined)
            Binary(result, operation, left, right):
                let left_type = try self.operand_type(instruction, left, defined)
                let right_type = try self.operand_type(instruction, right, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, left_type, right_type, "`" + str(operation) + "` operands")
                try self.verify_binary(instruction, operation, left_type, result_type)
                self.define(result, defined)
            Unary(result, operation, operand):
                let operand_type = try self.operand_type(instruction, operand, defined)
                let result_type = try self.result_type(result, defined)
                try self.require_same(instruction, result_type, operand_type, "`" + str(operation) + "`")
                match operation:
                    neg:
                        if not is_float_type(types, operand_type) and not is_signed_int_type(types, operand_type):
                            try self.fail_at(instruction, "`neg` needs a signed integer or float, found `" + describe_mir_type(types, operand_type) + "`")
                    bit_not:
                        if not is_int_type(types, operand_type): try self.fail_at(instruction, "`bit_not` needs an integer, found `" + describe_mir_type(types, operand_type) + "`")
                    bool_not:
                        if not is_bool_type(types, operand_type): try self.fail_at(instruction, "`bool_not` needs `bool`, found `" + describe_mir_type(types, operand_type) + "`")
                self.define(result, defined)
            Convert(result, operation, operand):
                let operand_type = try self.operand_type(instruction, operand, defined)
                let result_type = try self.result_type(result, defined)
                match operation:
                    extend:
                        if not is_int_type(types, operand_type) or not is_int_type(types, result_type) or bits_of(types, result_type) <= bits_of(types, operand_type):
                            try self.fail_at(instruction, "`extend` must widen an integer, found `" + describe_mir_type(types, operand_type) + "` to `" + describe_mir_type(types, result_type) + "`")
                    wrap:
                        if not is_int_type(types, operand_type) or not is_int_type(types, result_type) or bits_of(types, result_type) >= bits_of(types, operand_type):
                            try self.fail_at(instruction, "`wrap` must narrow an integer, found `" + describe_mir_type(types, operand_type) + "` to `" + describe_mir_type(types, result_type) + "`")
                    int_reinterpret:
