                if self.program.externs[target.value].convention != CallingConvention.c: try self.fail_at(instruction, "`ExternAddress` requires a C-convention extern")
                try self.require_ptr_result(instruction, result, defined, "`ExternAddress`")
                self.define(result, defined)
            Call(results, target, arguments):
                if i64(target.value) >= len(self.program.functions): try self.fail_at(instruction, "`Call` names function " + str(target.value) + ", which does not exist")
                try self.verify_call(instruction, self.program.functions[target.value].signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallExtern(results, external, arguments):
                if i64(external.value) >= len(self.program.externs): try self.fail_at(instruction, "`CallExtern` names extern " + str(external.value) + ", which does not exist")
                try self.verify_call(instruction, self.program.externs[external.value].signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallIndirect(results, signature, convention, target, arguments):
                try self.verify_signature_types(signature, "`CallIndirect` signature")
                if convention == CallingConvention.runtime: try self.fail_at(instruction, "`CallIndirect` cannot use the runtime calling convention")
                if convention == CallingConvention.c:
                    if signature.is_fallible: try self.fail_at(instruction, "a C-convention `CallIndirect` cannot be fallible")
                    for parameter in signature.parameters:
                        if not self.is_c_representable(parameter): try self.fail_at(instruction, "C-convention `CallIndirect` passes `" + describe_mir_type(self.program.types, parameter) + "` across the C boundary")
                    for result in signature.results:
                        if not self.is_c_representable(result): try self.fail_at(instruction, "C-convention `CallIndirect` returns `" + describe_mir_type(self.program.types, result) + "` across the C boundary")
