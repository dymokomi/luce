                if target_function.convention != CallingConvention.luce or not signatures_match(target_function.signature, signature):
                    try self.fail_at(instruction, "`FunctionValue` target has signature " + describe_signature(types, target_function.signature) + ", expected " + describe_signature(types, signature))
            ClosureCreate(environment, destination, function_type, closure):
                try self.require_ptr_operand(instruction, destination, defined, "`ClosureCreate` destination")
                let signature = try self.require_function_type(instruction, function_type, "`ClosureCreate` type")
                if i64(closure.value) >= len(self.program.closures): try self.fail_at(instruction, "`ClosureCreate` names a missing closure")
                elif not signatures_match(self.program.closures[closure.value].signature, signature):
                    try self.fail_at(instruction, "`ClosureCreate` metadata has signature " + describe_signature(types, self.program.closures[closure.value].signature) + ", expected " + describe_signature(types, signature))
                try self.require_ptr_result(instruction, environment, defined, "`ClosureCreate` environment")
                if find_runtime_binding(self.program, RuntimeService.class_create) == none:
                    try self.fail_at(instruction, "`ClosureCreate` requires the `class_create` runtime binding")
                self.define(environment, defined)
            ClosureMarkInitialized(environment):
                try self.require_ptr_operand(instruction, environment, defined, "`ClosureMarkInitialized` environment")
                if find_runtime_binding(self.program, RuntimeService.class_mark_initialized) == none:
                    try self.fail_at(instruction, "`ClosureMarkInitialized` requires the `class_mark_initialized` runtime binding")
            ClosureCaptureAddress(result, environment, closure, capture):
                try self.require_ptr_operand(instruction, environment, defined, "`ClosureCaptureAddress` environment")
                if i64(closure.value) >= len(self.program.closures): try self.fail_at(instruction, "`ClosureCaptureAddress` names a missing closure")
                elif capture < 0 or capture >= len(self.program.closures[closure.value].captures): try self.fail_at(instruction, "`ClosureCaptureAddress` names a missing capture")
                try self.require_ptr_result(instruction, result, defined, "`ClosureCaptureAddress`")
                if find_runtime_binding(self.program, RuntimeService.class_payload) == none:
                    try self.fail_at(instruction, "`ClosureCaptureAddress` requires the `class_payload` runtime binding")
                self.define(result, defined)
            FunctionRetain(value):
                try self.require_ptr_operand(instruction, value, defined, "function ownership value")
                if find_runtime_binding(self.program, RuntimeService.class_retain) == none:
                    try self.fail_at(instruction, "`FunctionRetain` requires the `class_retain` runtime binding")
            FunctionRelease(value):
                try self.require_ptr_operand(instruction, value, defined, "function ownership value")
                if find_runtime_binding(self.program, RuntimeService.class_release) == none:
                    try self.fail_at(instruction, "`FunctionRelease` requires the `class_release` runtime binding")
            Call(results, target, arguments):
                if i64(target.value) >= len(self.program.functions): try self.fail_at(instruction, "`Call` names function " + str(target.value) + ", which does not exist")
                try self.verify_call(instruction, self.program.functions[target.value].signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallExtern(results, external, arguments):
                if i64(external.value) >= len(self.program.externs): try self.fail_at(instruction, "`CallExtern` names extern " + str(external.value) + ", which does not exist")
                try self.verify_call(instruction, self.program.externs[external.value].signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallIndirect(results, signature, convention, target, arguments):
                try self.verify_signature_types(signature, "`CallIndirect` signature")
                if convention == CallingConvention.runtime: try self.fail_at(instruction, "`CallIndirect` cannot use the runtime calling convention")
                if convention == CallingConvention.c:
                    if signature.is_fallible: try self.fail_at(instruction, "a C-convention `CallIndirect` cannot be fallible")
                    for parameter in signature.parameters:
                        if not self.is_c_representable(parameter): try self.fail_at(instruction, "C-convention `CallIndirect` passes `" + describe_mir_type(self.program.types, parameter) + "` across the C boundary")
                    for result in signature.results:
                        if not self.is_c_representable(result): try self.fail_at(instruction, "C-convention `CallIndirect` returns `" + describe_mir_type(self.program.types, result) + "` across the C boundary")
                try self.require_ptr_operand(instruction, target, defined, "`CallIndirect` target")
                try self.verify_call(instruction, signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallClosure(results, signature, target, arguments):
                try self.verify_signature_types(signature, "`CallClosure` signature")
                try self.require_ptr_operand(instruction, target, defined, "`CallClosure` target")
                try self.verify_call(instruction, signature, registers_of(function, results), registers_of(function, arguments), defined)
            CallInterface(results, interface_id, requirement, target, arguments):
                if i64(interface_id.value) >= len(self.program.interfaces):
                    try self.fail_at(instruction, "`CallInterface` names interface " + str(interface_id.value) + ", which does not exist")
                let target_identity = try self.require_interface_operand(instruction, target, defined, "`CallInterface` target")
                if target_identity.value != interface_id.value:
                    try self.fail_at(instruction, "`CallInterface` target names interface " + str(target_identity.value) + ", expected " + str(interface_id.value))
                let metadata = self.program.interfaces[interface_id.value]
                if i64(requirement) >= len(metadata.requirements):
                    try self.fail_at(instruction, "`CallInterface` names requirement " + str(requirement) + ", which does not exist")
                if find_runtime_binding(self.program, RuntimeService.interface_witness) == none:
                    try self.fail_at(instruction, "`CallInterface` requires the `interface_witness` runtime binding")
                try self.verify_call(instruction, metadata.requirements[requirement].signature, registers_of(function, results), registers_of(function, arguments), defined)
            Block(results):
                let result_types = try self.region_result_types(instruction, registers_of(function, results), defined)
                regions.append(Region(kind = RegionKind.block, results = results, result_types = result_types, defined_before = copy_defined(defined)))
            Loop:
                regions.append(Region(kind = RegionKind.loop_body, results = no_registers(), result_types = list[TypeId](), defined_before = copy_defined(defined)))
            If(condition, results):
                let condition_type = try self.operand_type(instruction, condition, defined)
                if not is_bool_type(types, condition_type): try self.fail_at(instruction, "`If` condition must be `bool`, found `" + describe_mir_type(types, condition_type) + "`")
                let result_types = try self.region_result_types(instruction, registers_of(function, results), defined)
                regions.append(Region(kind = RegionKind.if_region, results = results, result_types = result_types, defined_before = copy_defined(defined)))
            Else:
                if current.kind != RegionKind.if_region or current.seen_else:
                    try self.fail_at(instruction, "`Else` outside an `If`, or a second `Else`")
                current.seen_else = true
                self.finish_arm(current, defined)
            Switch(tag):
                let tag_type = try self.operand_type(instruction, tag, defined)
                if not is_int_type(types, tag_type): try self.fail_at(instruction, "`Switch` tag must be an integer, found `" + describe_mir_type(types, tag_type) + "`")
                let opened = Region(kind = RegionKind.switch_region, results = no_registers(), result_types = list[TypeId](), defined_before = copy_defined(defined))
                opened.expecting_arm = true
                regions.append(opened)
            Case(value):
                if current.kind != RegionKind.switch_region: try self.fail_at(instruction, "`Case` outside a `Switch`")
                if current.seen_default: try self.fail_at(instruction, "`Case` after `Default`")
                for previous in current.case_values:
                    if previous == value: try self.fail_at(instruction, "`Switch` repeats case " + str(value))
                if len(current.case_values) > 0: self.finish_arm(current, defined)
                current.case_values.append(value)
            Default:
                if current.kind != RegionKind.switch_region: try self.fail_at(instruction, "`Default` outside a `Switch`")
                if current.seen_default: try self.fail_at(instruction, "a second `Default`")
                if len(current.case_values) > 0: self.finish_arm(current, defined)
                current.seen_default = true
            End:
                if current.kind == RegionKind.function_body: try self.fail_at(instruction, "`End` without an open region")
                self.finish_arm(current, defined)
                var region_leaves = current.arms_leave
                var region_terminates = current.arms_terminate
                if current.kind == RegionKind.if_region and not current.seen_else:
                    if current.results.count > 0: try self.fail_at(instruction, "`If` with results must supply them on both arms with `Yield` or `Br`")
                    # The missing else-arm falls through.
                    region_leaves = false
                    region_terminates = false
                if current.kind == RegionKind.switch_region and not current.seen_default:
                    try self.fail_at(instruction, "`Switch` needs a `Default` arm")
                if current.kind == RegionKind.block or current.kind == RegionKind.loop_body:
                    # A branch to a Block lands after it; a Loop is left by falling off.
                    region_terminates = false
                if current.results.count > 0 and not region_leaves:
                    try self.fail_at(instruction, "`Block` with results can fall off its end; supply them with `Yield` or `Br`")
                regions.remove(len(regions) - 1)
                for result in registers_of(function, current.results): self.define(result, defined)
                leaves = region_leaves
                terminates_here = region_terminates
            Br(depth, values):
                try self.verify_branch(instruction, depth, registers_of(function, values), defined, regions)
                leaves = true
            BrIf(condition, depth, values):
                let condition_type = try self.operand_type(instruction, condition, defined)
                if not is_bool_type(types, condition_type): try self.fail_at(instruction, "`BrIf` condition must be `bool`, found `" + describe_mir_type(types, condition_type) + "`")
                try self.verify_branch(instruction, depth, registers_of(function, values), defined, regions)
            Yield(values):
                if current.kind == RegionKind.function_body: try self.fail_at(instruction, "`Yield` outside any region; use `Return`")
                if current.kind == RegionKind.loop_body: try self.fail_at(instruction, "`Yield` inside a `Loop`; a loop has no results, leave it with `Br`")
                leaves = true
                try self.verify_values(instruction, registers_of(function, values), current.result_types, defined, "`Yield`")
            Return(values):
                if function.signature.returns_never:
                    try self.fail_at(instruction, "`Return` in a function whose successful result is `never`")
                let returned = registers_of(function, values)
                try self.verify_values(instruction, returned, function.signature.results, defined, "`Return`")
                if function.signature.is_fallible:
                    let error_result = returned[len(returned) - 1]
                    if not known_null[error_result.value]:
                        try self.fail_at(instruction, "`Return` from a fallible function must report success with a null error pointer; use `Raise r0` for failure")
                leaves = true
                terminates_here = true
            Raise(failure):
                if not function.signature.is_fallible: try self.fail_at(instruction, "`Raise` in a function that cannot fail")
                try self.require_ptr_operand(instruction, failure, defined, "`Raise` error")
                if failure.value != 0: try self.fail_at(instruction, "`Raise` must return the caller-owned error slot in r0")
                leaves = true
                terminates_here = true
            Trap(reason):
                leaves = true
                terminates_here = true
            Unreachable:
                leaves = true
                terminates_here = true
        # Record what this instruction proved for the arm it sits in (after
        # an `End`, that is the enclosing region's arm).
        let top = regions[len(regions) - 1]
        top.last_leaves = leaves
        top.last_terminates = terminates_here

    # An arm has ended: fold its flags into the region's, and start the next
    # arm from the defined set the region opened with.
    func finish_arm(region: Region, defined: list[bool]):
        region.arms_leave = region.arms_leave and region.last_leaves
        region.arms_terminate = region.arms_terminate and region.last_terminates
        for index in range(0, len(defined)): defined[index] = region.defined_before[index]
        region.last_leaves = false
        region.last_terminates = false

    # mark: Instruction rules ===================================================================

    func verify_binary(instruction: MirInstruction, operation: BinaryOp, operand_type: TypeId, result_type: TypeId) -> !:
        let types = self.program.types
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let name = "`" + str(operation) + "`"
        if is_arithmetic(operation):
            if not is_numeric_mir_type(types, operand_type): try self.fail_at(instruction, name + " needs numeric operands, found `" + describe_mir_type(types, operand_type) + "`")
            try self.require_same(instruction, result_type, operand_type, name + " result")
        elif operation == BinaryOp.div:
            if not is_float_type(types, operand_type): try self.fail_at(instruction, "`div` needs float operands; integers use `floor_div`")
            try self.require_same(instruction, result_type, operand_type, "`div` result")
        elif is_integer_only(operation):
            if not is_int_type(types, operand_type): try self.fail_at(instruction, name + " needs integer operands, found `" + describe_mir_type(types, operand_type) + "`")
            try self.require_same(instruction, result_type, operand_type, name + " result")
        elif operation == BinaryOp.eq or operation == BinaryOp.ne:
            if not is_numeric_mir_type(types, operand_type) and not is_bool_type(types, operand_type) and not is_identity_type(types, operand_type):
                try self.fail_at(instruction, name + " cannot compare `" + describe_mir_type(types, operand_type) + "`")
            try self.require_same(instruction, result_type, boolean, name + " result")
        else:
            if not is_numeric_mir_type(types, operand_type): try self.fail_at(instruction, name + " needs numeric operands, found `" + describe_mir_type(types, operand_type) + "`")
            try self.require_same(instruction, result_type, boolean, name + " result")

    func verify_call(instruction: MirInstruction, signature: MirSignature, results: list[RegisterId], arguments: list[RegisterId], defined: list[bool]) -> !:
        if len(arguments) != len(signature.parameters):
            try self.fail_at(instruction, "call passes " + str(len(arguments)) + " argument(s) to a signature with " + str(len(signature.parameters)))
        for index in range(0, len(arguments)):
            let argument_type = try self.operand_type(instruction, arguments[index], defined)
            try self.require_same(instruction, argument_type, signature.parameters[index], "argument " + str(index))
        if len(results) != len(signature.results):
            try self.fail_at(instruction, "call defines " + str(len(results)) + " result(s) for a signature with " + str(len(signature.results)))
        for index in range(0, len(results)):
            let result_type = try self.result_type(results[index], defined)
            try self.require_same(instruction, result_type, signature.results[index], "result " + str(index))
        for result in results: self.define(result, defined)

    # `regions[0]` is the function body itself, which no branch may name.
    func verify_branch(instruction: MirInstruction, depth: i64, values: list[RegisterId], defined: list[bool], regions: list[Region]) -> !:
        if depth < 0 or depth >= len(regions) - 1: try self.fail_at(instruction, "branch depth " + str(depth) + " with " + str(len(regions) - 1) + " enclosing region(s)")
        let region = regions[len(regions) - 1 - depth]
        if region.kind == RegionKind.loop_body:
            if len(values) > 0: try self.fail_at(instruction, "a branch to a `Loop` restarts it and carries no values")
            return
        try self.verify_values(instruction, values, region.result_types, defined, "branch")

    func verify_values(instruction: MirInstruction, values: list[RegisterId], expected: list[TypeId], defined: list[bool], what: str) -> !:
        if len(values) != len(expected):
            try self.fail_at(instruction, what + " supplies " + str(len(values)) + " value(s), expected " + str(len(expected)))
        for index in range(0, len(values)):
            let value_type = try self.operand_type(instruction, values[index], defined)
            try self.require_same(instruction, value_type, expected[index], what + " value " + str(index))

    # A region's results are registers it defines; they must be fresh here.
    func region_result_types(instruction: MirInstruction, results: list[RegisterId], defined: list[bool]) -> list[TypeId]!:
        let result_types = list[TypeId]()
        for result in results:
            result_types.append(try self.result_type(result, defined))
        return result_types

    # mark: Register and type helpers ===========================================================

    func operand_type(instruction: MirInstruction, register: RegisterId, defined: list[bool]) -> TypeId!:
        if i64(register.value) >= len(self.registers):
            try self.fail_at(instruction, "uses r" + str(register.value) + ", which is not declared")
        if not defined[register.value]:
            try self.fail_at(instruction, "uses r" + str(register.value) + " before it is defined")
        return self.registers[register.value]

    func result_type(register: RegisterId, defined: list[bool]) -> TypeId!:
        if i64(register.value) >= len(self.registers):
            try self.fail("defines r" + str(register.value) + ", which is not declared")
        if defined[register.value]:
            try self.fail("defines r" + str(register.value) + " twice")
        return self.registers[register.value]

    func define(register: RegisterId, defined: list[bool]):
        defined[register.value] = true

    func require_ptr_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.operand_type(instruction, register, defined)
        if not is_ptr_type(self.program.types, found):
            try self.fail_at(instruction, what + " must be `ptr`, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_ptr_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.result_type(register, defined)
        if not is_ptr_type(self.program.types, found):
            try self.fail_at(instruction, what + " result must be `ptr`, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_function_type(instruction: MirInstruction, id: TypeId, what: str) -> MirSignature!:
        try self.require_type_id(id, what)
        match mir_type(self.program.types, id):
            Func(signature): return signature
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be `func`, found `" + describe_mir_type(self.program.types, id) + "`")

    func require_buffer_owner_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            BufferOwner: return
            else: try self.fail_at(instruction, what + " must be `buffer-owner`, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_buffer_owner_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            BufferOwner: return
            else: try self.fail_at(instruction, what + " result must be `buffer-owner`, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_buffer_builder_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            BufferBuilder: return
            else: try self.fail_at(instruction, what + " must be `buffer-builder`, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_buffer_builder_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            BufferBuilder: return
            else: try self.fail_at(instruction, what + " result must be `buffer-builder`, found `" + describe_mir_type(self.program.types, found) + "`")

    func verify_display(instruction: MirInstruction, result: RegisterId, value: RegisterId, expected: TypeId, service: RuntimeService, defined: list[bool], what: str) -> !:
        try self.require_same(instruction, try self.operand_type(instruction, value, defined), expected, what + " value")
        try self.require_buffer_owner_result(instruction, result, defined, what)
        if find_runtime_binding(self.program, service) == none:
            try self.fail_at(instruction, what + " requires the `" + str(service) + "` runtime binding")
        self.define(result, defined)

    ## Return the logical stored types: `[key, value]` for a map and
    ## `[element]` for a set. The sealed runtime may share their table
    ## substrate, but canonical MIR never erases their distinct type shapes.
    func require_hash_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> list[TypeId]!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Map(key, value): return [key, value]
            Set(element): return [element]
            FrozenMap(key, value): return [key, value]
            FrozenSet(element): return [element]
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a typed map or set handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_mutable_hash_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> list[TypeId]!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Map(key, value): return [key, value]
            Set(element): return [element]
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a mutable map or set handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_hash_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> list[TypeId]!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            Map(key, value): return [key, value]
            Set(element): return [element]
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a typed map or set handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_u64_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        try self.require_same(instruction, try self.operand_type(instruction, register, defined), builtin_mir_type(BuiltinMirType.unsigned_u64), what)

    func require_u64_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        try self.require_same(instruction, try self.result_type(register, defined), builtin_mir_type(BuiltinMirType.unsigned_u64), what + " result")

    func require_list_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            List(element): return element
            FrozenList(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a typed list handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_mutable_list_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            List(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a mutable list handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_list_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            List(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a typed list handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_slice_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Slice(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a typed slice handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_slice_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            Slice(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a typed slice handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_mutable_slice_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            MutableSlice(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a typed mutable-slice handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_mutable_slice_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> TypeId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            MutableSlice(element): return element
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a typed mutable-slice handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_class_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> ClassId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Class(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a class handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_class_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> ClassId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            Class(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a class handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_weak_class_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> ClassId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            WeakClass(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a weak-class handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_weak_class_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> ClassId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            WeakClass(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a weak-class handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_interface_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> InterfaceId!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Interface(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be an interface handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_interface_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> InterfaceId!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            Interface(identity): return identity
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be an interface handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_element_action_for_type(action: FunctionId, value_type: TypeId, what: str) -> !:
        try self.require_type_id(value_type, what + " value")
        if i64(action.value) >= len(self.program.functions):
            try self.fail_program(what + " names function " + str(action.value) + ", which does not exist")
        let function = self.program.functions[action.value]
        let expected = MirSignature(parameters = [builtin_mir_type(BuiltinMirType.pointer)], results = list[TypeId](), is_fallible = false, returns_never = false)
        if function.convention != CallingConvention.luce or function.is_public or function.is_exported or not signatures_match(function.signature, expected):
            try self.fail_program(what + " must name a private structural ownership helper")

    func require_element_action(instruction: MirInstruction, action: FunctionId, what: str) -> !:
        if i64(action.value) >= len(self.program.functions):
            try self.fail_at(instruction, what + " names function " + str(action.value) + ", which does not exist")
        let function = self.program.functions[action.value]
        if function.convention != CallingConvention.luce or function.is_public or function.is_exported:
            try self.fail_at(instruction, what + " must name a private Luce function")
        let expected = MirSignature(
            parameters = [builtin_mir_type(BuiltinMirType.pointer)],
            results = list[TypeId](),
            is_fallible = false, returns_never = false,
        )
        if not signatures_match(function.signature, expected):
            try self.fail_at(instruction, what + " has signature " + describe_signature(self.program.types, function.signature) + ", expected " + describe_signature(self.program.types, expected))

    # mark: Structured-task rules =============================================================

    func require_task_group_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            TaskGroup: return
            else: try self.fail_at(instruction, what + " must be a task-group capability, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_task_group_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> !:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            TaskGroup: return
            else: try self.fail_at(instruction, what + " result must be a task-group capability, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_task_operand(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> MirTaskResult!:
        let found = try self.operand_type(instruction, register, defined)
        match mir_type(self.program.types, found):
            Task(result, failure_type): return result
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " must be a task handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_task_result(instruction: MirInstruction, register: RegisterId, defined: list[bool], what: str) -> MirTaskResult!:
        let found = try self.result_type(register, defined)
        match mir_type(self.program.types, found):
            Task(result, failure_type): return result
            else: error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + what + " result must be a task handle, found `" + describe_mir_type(self.program.types, found) + "`")

    func require_absent_register(instruction: MirInstruction, register: RegisterId, what: str) -> !:
        if register.value != no_register:
            try self.fail_at(instruction, what + " must be absent")

    ## Prove the worker's lowered call protocol and every isolated transfer.
    ## Hidden error/result pointers are derived solely from the task result and
    ## target signature; the transfer arena retains source value types after
    ## aggregate arguments have become addresses.
    func verify_task_spawn(function: MirFunction, instruction: MirInstruction, target: FunctionId, arguments: TransferRun, task_result: MirTaskResult, defined: list[bool]) -> !:
        if i64(target.value) >= len(self.program.functions):
            try self.fail_at(instruction, "`TaskSpawn` names function " + str(target.value) + ", which does not exist")
        let worker = self.program.functions[target.value]
        if worker.convention != CallingConvention.luce:
            try self.fail_at(instruction, "`TaskSpawn` target must use the Luce calling convention")
        if i64(arguments.start) + i64(arguments.count) > len(function.transfers):
            try self.fail_at(instruction, "`TaskSpawn` transfer run is outside the function transfer table")

        var parameter_index: i64 = 0
        var successful_results = list[TypeId]()
        if worker.signature.is_fallible: parameter_index += 1
        match task_result:
            Unit:
                if worker.signature.returns_never: try self.fail_at(instruction, "`TaskSpawn` unit task targets a never-returning worker")
            Never:
                if not worker.signature.returns_never: try self.fail_at(instruction, "`TaskSpawn` never task targets a worker with an ordinary success path")
            Value(value_type):
                if worker.signature.returns_never: try self.fail_at(instruction, "`TaskSpawn` value task targets a never-returning worker")
                if is_aggregate_type(self.program.types, value_type):
                    if parameter_index >= len(worker.signature.parameters):
                        try self.fail_at(instruction, "`TaskSpawn` worker is missing its aggregate-result destination")
                    try self.require_same(instruction, worker.signature.parameters[parameter_index], builtin_mir_type(BuiltinMirType.pointer), "`TaskSpawn` aggregate-result parameter")
                    parameter_index += 1
                else: successful_results.append(value_type)

        let expected_results = list[TypeId]()
        for value_type in successful_results: expected_results.append(value_type)
        if worker.signature.is_fallible: expected_results.append(builtin_mir_type(BuiltinMirType.pointer))
        if len(worker.signature.results) != len(expected_results):
            try self.fail_at(instruction, "`TaskSpawn` worker result protocol does not match its task type")
        for index in range(0, len(expected_results)):
            try self.require_same(instruction, worker.signature.results[index], expected_results[index], "`TaskSpawn` worker result " + str(index))

        if len(worker.signature.parameters) - parameter_index != i64(arguments.count):
            try self.fail_at(instruction, "`TaskSpawn` passes " + str(arguments.count) + " source argument(s) to a worker with " + str(len(worker.signature.parameters) - parameter_index))
        for index in range(0, i64(arguments.count)):
            let transfer = transfer_at(function, arguments, index)
            try self.require_type_id(transfer.value_type, "`TaskSpawn` transfer " + str(index))
            if not self.is_sendable_type(transfer.value_type):
                try self.fail_at(instruction, "`TaskSpawn` transfer " + str(index) + " has non-sendable type `" + describe_mir_type(self.program.types, transfer.value_type) + "`")
            var representation = transfer.value_type
            if is_aggregate_type(self.program.types, transfer.value_type): representation = builtin_mir_type(BuiltinMirType.pointer)
            try self.require_same(instruction, try self.operand_type(instruction, transfer.value, defined), representation, "`TaskSpawn` transfer " + str(index) + " register")
            try self.require_same(instruction, worker.signature.parameters[parameter_index + index], representation, "`TaskSpawn` worker parameter " + str(index))

    func is_sendable_type(value_type: TypeId) -> bool:
        let visiting = list[bool]()
        for definition in self.program.types.definitions: visiting.append(false)
        return self.is_sendable_type_on_path(value_type, visiting)

    func is_sendable_type_on_path(value_type: TypeId, visiting: list[bool]) -> bool:
        if i64(value_type.value) >= len(self.program.types.definitions): return false
        if visiting[value_type.value]: return true
        visiting[value_type.value] = true
        var result = false
        match mir_type(self.program.types, value_type):
            Int(bits, is_signed): result = true
            Float(bits): result = true
            Bool: result = true
            Slice(element): result = self.is_sendable_type_on_path(element, visiting)
            FrozenList(element): result = self.is_sendable_type_on_path(element, visiting)
            FrozenSet(element): result = self.is_sendable_type_on_path(element, visiting)
            FrozenMap(key, value): result = self.is_sendable_type_on_path(key, visiting) and self.is_sendable_type_on_path(value, visiting)
            Array(element, count): result = self.is_sendable_type_on_path(element, visiting)
            Struct(fields):
                if self.is_buffer_value_shape(fields): result = true
                else:
                    result = true
                    for field in fields:
                        if not self.is_sendable_type_on_path(field.value_type, visiting): result = false
            Enum(tag, cases):
                result = self.is_sendable_type_on_path(tag, visiting)
                for case_type in cases:
                    if not self.is_sendable_type_on_path(case_type, visiting): result = false
            else: result = false
        visiting[value_type.value] = false
        return result

    func is_buffer_value_shape(fields: list[MirField]) -> bool:
        if len(fields) != 3: return false
        match mir_type(self.program.types, fields[0].value_type):
            BufferOwner: pass
            else: return false
        if not is_ptr_type(self.program.types, fields[1].value_type): return false
        return fields[2].value_type.value == builtin_mir_type(BuiltinMirType.unsigned_u64).value

    func require_same(instruction: MirInstruction, found: TypeId, expected: TypeId, what: str) -> !:
        if found.value != expected.value:
            try self.fail_at(instruction, what + " has `" + describe_mir_type(self.program.types, found) + "`, expected `" + describe_mir_type(self.program.types, expected) + "`")

    # Only scalars and pointers travel through registers; aggregates move
    # with `Memcpy`.
    func require_register_sized(instruction: MirInstruction, value_type: TypeId, what: str) -> !:
        match mir_type(self.program.types, value_type):
            Uninhabited: try self.fail_at(instruction, what + " of uninhabited `never`")
            Struct(fields): try self.fail_at(instruction, what + " of a struct; aggregates move with `Memcpy`")
            Array(element, count): try self.fail_at(instruction, what + " of an array; aggregates move with `Memcpy`")
            Enum(tag, cases): try self.fail_at(instruction, what + " of an enum; aggregates move with `Memcpy`")
            Func(signature): try self.fail_at(instruction, what + " of a function descriptor; aggregates move with `Memcpy`")
            else: return

    func require_type_id(id: TypeId, what: str) -> !:
        if i64(id.value) >= len(self.program.types.definitions):
            try self.fail_program(what + " names type " + str(id.value) + ", which does not exist")

    ## Transient builders and callback-scoped views never enter ordinary
    ## aggregate, slot, global, result, or generic memory storage.
    func require_storable_type_id(id: TypeId, what: str) -> !:
        try self.require_type_id(id, what)
        match mir_type(self.program.types, id):
            BufferBuilder: try self.fail_program(what + " cannot store transient `buffer-builder`")
            MutableSlice(element): try self.fail_program(what + " cannot store callback-scoped `mutable-slice`")
            TaskGroup: try self.fail_program(what + " cannot store compiler-owned `task-group`")
            else: pass

    func require_parameter_type_id(id: TypeId, what: str) -> !:
        try self.require_type_id(id, what)
        match mir_type(self.program.types, id):
            MutableSlice(element):
                try self.require_storable_type_id(element, what + " element")
            else: try self.require_storable_type_id(id, what)

    func require_storable_instruction_type(instruction: MirInstruction, id: TypeId, what: str) -> !:
        try self.require_type_id(id, what)
        match mir_type(self.program.types, id):
            BufferBuilder: try self.fail_at(instruction, what + " cannot store transient `buffer-builder`")
            MutableSlice(element): try self.fail_at(instruction, what + " cannot store callback-scoped `mutable-slice`")
            TaskGroup: try self.fail_at(instruction, what + " cannot store compiler-owned `task-group`")
            else: pass

    func contains_task_type(value_type: TypeId) -> bool:
        let visiting = list[bool]()
        for definition in self.program.types.definitions: visiting.append(false)
        return self.contains_task_type_on_path(value_type, visiting)

    func contains_task_type_on_path(value_type: TypeId, visiting: list[bool]) -> bool:
        if i64(value_type.value) >= len(self.program.types.definitions): return false
        if visiting[value_type.value]: return false
        visiting[value_type.value] = true
        var found = false
        match mir_type(self.program.types, value_type):
            Task(result, failure_type): found = true
            TaskGroup: found = true
            List(element): found = self.contains_task_type_on_path(element, visiting)
            FrozenList(element): found = self.contains_task_type_on_path(element, visiting)
            Set(element): found = self.contains_task_type_on_path(element, visiting)
            FrozenSet(element): found = self.contains_task_type_on_path(element, visiting)
            Slice(element): found = self.contains_task_type_on_path(element, visiting)
            MutableSlice(element): found = self.contains_task_type_on_path(element, visiting)
            Cell(element): found = self.contains_task_type_on_path(element, visiting)
            Map(key, value):
                found = self.contains_task_type_on_path(key, visiting) or self.contains_task_type_on_path(value, visiting)
            FrozenMap(key, value):
                found = self.contains_task_type_on_path(key, visiting) or self.contains_task_type_on_path(value, visiting)
            Struct(fields):
                for field in fields:
                    if self.contains_task_type_on_path(field.value_type, visiting): found = true
            Array(element, count): found = self.contains_task_type_on_path(element, visiting)
            Enum(tag, cases):
                for case_type in cases:
                    if self.contains_task_type_on_path(case_type, visiting): found = true
            Func(signature):
                for parameter in signature.parameters:
                    if self.contains_task_type_on_path(parameter, visiting): found = true
                for result in signature.results:
                    if self.contains_task_type_on_path(result, visiting): found = true
            else: pass
        visiting[value_type.value] = false
        return found

    # The C boundary admits scalars, pointers, and structs of those, never
    # failure.
    func require_c_signature(signature: MirSignature, what: str) -> !:
        if signature.is_fallible: try self.fail_program(what + " uses the `c` convention and cannot be fallible")
        for parameter in signature.parameters:
            if not self.is_c_representable(parameter): try self.fail_program(what + " passes `" + describe_mir_type(self.program.types, parameter) + "` across the C boundary")
        for result in signature.results:
            if not self.is_c_representable(result): try self.fail_program(what + " returns `" + describe_mir_type(self.program.types, result) + "` across the C boundary")

    func is_c_representable(id: TypeId) -> bool:
        match mir_type(self.program.types, id):
            Float(bits): return bits == 32 or bits == 64
            Struct(fields):
                for field in fields:
                    if not self.is_c_representable(field.value_type): return false
                return true
            Array(element, count): return self.is_c_representable(element)
            Enum(tag, cases): return false
            Func(signature): return false
            else: return true

    # mark: Diagnostics =========================================================================

    func fail_program(message: str) -> !:
        error("MIR verifier: " + message)

    func fail(message: str) -> !:
        error("MIR verifier: `" + self.function_name + "` " + message)

    func fail_at(instruction: MirInstruction, message: str) -> !:
        error("MIR verifier: `" + self.function_name + "` at " + str(instruction.span.line) + ":" + str(instruction.span.column) + ": " + message)

# mark: Structural helpers =====================================================================

func is_arithmetic(operation: BinaryOp) -> bool:
    return operation == BinaryOp.add or operation == BinaryOp.sub or operation == BinaryOp.mul

func is_integer_only(operation: BinaryOp) -> bool:
    return (
        operation == BinaryOp.floor_div or operation == BinaryOp.rem
        or operation == BinaryOp.bit_and or operation == BinaryOp.bit_or or operation == BinaryOp.bit_xor
        or operation == BinaryOp.shift_left or operation == BinaryOp.shift_right
    )

func copy_defined(defined: list[bool]) -> list[bool]:
    let copied = list[bool]()
    for item in defined: copied.append(item)
    return copied

# A body terminates when control cannot fall off its end: every path ends
# in `Return`, `Raise`, `Trap`, or `Unreachable`. The same arm bookkeeping
# as the verifier, without the type checks, so the lowerer can ask before
# it appends a trailing `Return` or `Unreachable`.
pub func terminates(body: list[MirInstruction]) -> bool:
    let no_defined = list[bool]()
    let root = Region(kind = RegionKind.function_body, results = no_registers(), result_types = list[TypeId](), defined_before = no_defined)
    let regions = [root]
    for instruction in body:
        let current = regions[len(regions) - 1]
        var terminates_here = false
        match instruction.form:
            Block(results): regions.append(Region(kind = RegionKind.block, results = results, result_types = list[TypeId](), defined_before = no_defined))
            Loop: regions.append(Region(kind = RegionKind.loop_body, results = no_registers(), result_types = list[TypeId](), defined_before = no_defined))
            If(condition, results): regions.append(Region(kind = RegionKind.if_region, results = results, result_types = list[TypeId](), defined_before = no_defined))
            Switch(tag): regions.append(Region(kind = RegionKind.switch_region, results = no_registers(), result_types = list[TypeId](), defined_before = no_defined))
            Else:
                current.seen_else = true
                fold_arm(current)
            Case(value):
                if len(current.case_values) > 0: fold_arm(current)
                current.case_values.append(value)
            Default:
                if len(current.case_values) > 0: fold_arm(current)
                current.seen_default = true
            End:
                fold_arm(current)
                terminates_here = current.arms_terminate
                if current.kind == RegionKind.if_region and not current.seen_else: terminates_here = false
                if current.kind == RegionKind.block or current.kind == RegionKind.loop_body: terminates_here = false
                regions.remove(len(regions) - 1)
            Return(values): terminates_here = true
            Raise(failure): terminates_here = true
            Trap(reason): terminates_here = true
            Unreachable: terminates_here = true
            else: terminates_here = false
        regions[len(regions) - 1].last_terminates = terminates_here
    return root.last_terminates

func fold_arm(region: Region):
    region.arms_terminate = region.arms_terminate and region.last_terminates
    region.last_terminates = false
