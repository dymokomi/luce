#==============================================================================================
#
#   lowering_model - Shared HIR-to-MIR lowering transaction
#
#   DESCRIPTION:
#       Owns the one mutable program transaction shared by whole-program
#       coordination and function-local lowering. Program identities, canonical
#       type interning, generated-helper reservations, and the active function's
#       register/slot/lexical state therefore cannot drift into parallel paths.
#
#       These contracts are public only because Luce modules are file-scoped.
#       The product API remains Lowerer in lowerer.luc.
#
#==============================================================================================

from compiler.mir.canonical import BuiltinMirType, CallingConvention, ClassId, ClosureId, ExternId, ExternalGlobalId, FunctionId, InterfaceId
from compiler.mir.canonical import MirClass, MirClassField, MirClosure, MirConformance, MirData, MirExtern, MirExternalGlobal, MirField, MirGlobal
from compiler.mir.canonical import MirInterface, MirInterfaceRequirement, MirRuntimeBinding, MirSignature, MirSlot, MirTypeTable, RegisterId
from compiler.mir.canonical import MirTaskResult, MirType, TypeId, builtin_mir_type, create_builtin_mir_types
from compiler.mir.canonical import find_runtime_symbol, make_enum_type, pointer_int_type
from compiler.mir.canonical import OperandBuilder, is_aggregate_type, is_ptr_type, make_struct_type, mir_type, mir_type_key, signatures_match
from compiler.mir.canonical import MirInstruction
from compiler.hir.ir import BinaryOperation, BuiltinType, HirCEnum, HirCFunction, HirCStructKind, HirCaptureKind, HirConstant, HirFunction, Operands, Value
from compiler.hir.ir import HirModule, HirProgram, NodeId, SymbolId, describe_type
from compiler.hir.ir import nominal_cases, nominal_fields, resolve_builtin_type, types_match
import compiler.hir.ir
from compiler.frontend.source import SourceSpan, format_diagnostic
import std.strings

# mark: Shared lowering model ==================================================================

pub func contains_symbol(symbols: list[SymbolId], target: SymbolId) -> bool:
    for symbol in symbols:
        if symbol.value == target.value: return true
    return false

# One local of the function being lowered: its HIR symbol and the register
# holding its slot address.
pub struct Local:
    pub let symbol: u32
    pub let address: RegisterId

# One MIR region the lowerer is currently inside, innermost last. `break`
# targets the block wrapped around a loop; `continue` targets the loop.
pub enum Region:
    block
    loop_body
    for_continue
    if_arm

# How one shared match-arm dispatcher leaves the selected arm. Statement
# matches execute a scope; value and fallible matches branch to a result block.
pub union MatchExit:
    Statement
    Value(block_depth: i64)
    Diverging
    Fallible(block_depth: i64)

pub struct FallibleResult:
    pub let value: RegisterId
    pub let error_value: RegisterId

# The already-evaluated components of an indirect call. Keeping them together
# makes the required source order explicit: select the callee first, then
# evaluate every positional argument from left to right.
pub struct IndirectOperands:
    pub let target: RegisterId
    pub let values: list[RegisterId]

# One C output slot allocated around a call. `raw_type` is what C writes;
# `value_type` is the tagged/nominal HIR type reconstructed afterward.
pub struct COutputSlot:
    pub let value_type: ir.TypeId
    pub let raw_type: TypeId
    pub let address: RegisterId

## What one full-profile assignment step did: continued the address walk,
## reached a weak class field whose store must go through its storage type,
## or performed the complete store itself.
pub union PlaceStepOutcome:
    Continue(address: RegisterId, place_type: ir.TypeId)
    WeakField(address: RegisterId, place_type: ir.TypeId, storage: TypeId)
    Stored

# Where a recover leaves its catch expression, and which deferred suffix
# belongs to the handler rather than the surrounding function.
pub struct RecoverTarget:
    pub let region_index: i64
    pub let defer_start: i64

# HIR has one callable identity. MIR distinguishes code in this artifact from
# a host binding, so this table is the single, explicit split point used by
# every call after all source-level lookup and argument placement is finished.
pub union LoweredFunction:
    Defined(function: FunctionId)
    External(external: ExternId)

# A C-callable adapter is generated only when an address conversion needs
# one, except that an explicit `export c` already owns the same adapter.
pub union CWrapper:
    Absent
    Present(function: FunctionId)

# The source-level contract behind one interned C symbol. Canonical MIR has
# already erased handle nominality and boundary optionals when it describes a
# raw call slot, so its signature alone cannot distinguish `Window` from
# `Window?` or from another pointer-shaped handle. Keep that semantic identity
# beside the interned extern until every declaration has been checked.
pub union CExternSlot:
    Input(value_type: ir.TypeId)
    Output(value_type: ir.TypeId)

pub struct CExternContract:
    pub let external: ExternId
    pub let name: str
    pub let slots: list[CExternSlot]
    pub let declared_result: ir.TypeId
    pub let is_blocking: bool

pub struct ExternalGlobalContract:
    pub let global: ExternalGlobalId
    pub let name: str
    pub let value_type: ir.TypeId

# One shared pair of structural actions for a canonical value type. Collection
# runtime services receive these exact private function identities whenever a
# raw element representation is copied or destroyed.
pub struct OwnershipHelper:
    pub let value_type: TypeId
    pub let retain: FunctionId
    pub let release: FunctionId

# One equality implementation for a concrete source type whose reachable
# value graph contains mutable collection identity. `hir_type` owns semantic
# structure; `value_type` owns its already-lowered canonical representation.
pub struct EqualityHelper:
    pub let module: ir.ModuleId
    pub let owner: SymbolId
    pub let hir_type: ir.TypeId
    pub let value_type: TypeId
    pub let function: FunctionId

# Generated function identities are reserved lazily while ordinary bodies or
# earlier helpers lower. One ordered queue prevents independent helper
# families from making incompatible assumptions about FunctionId order.
pub union GeneratedHelper:
    Ownership(value_type: TypeId, retaining: bool, function: FunctionId)
    Equality(helper: EqualityHelper)

## One canonical cell representation shared by every captured mutable binding
## of the same source type. Its generated destroyer releases the payload only
## after successful initialization.
pub struct CellStorage:
    pub let hir_type: ir.TypeId
    pub let element_type: TypeId
    pub let cell_type: TypeId
    pub let destroyer: FunctionId

# Source `defer` statements and semantic compiler cleanups share one lexical
# LIFO. The latter are explicit canonical MIR actions rather than synthetic
# HIR nodes, so HIR remains an exact representation of the source program.
pub union DeferredAction:
    Source(statement: NodeId)
    ListIteration(value: RegisterId, span: SourceSpan)
    HashIteration(value: RegisterId, span: SourceSpan)
    DestroyAddress(address: RegisterId, value_type: TypeId, span: SourceSpan)
    OwnedValue(value: RegisterId, value_type: TypeId, span: SourceSpan)

let unlowered_nominal_type: u32 = 4294967295

## Mutable state for one complete HIR-to-MIR lowering transaction. Lowerer
## fixes program order; FunctionLowerer is the only consumer that mutates the
## active function fields.
pub class MirLoweringState:
    pub let program: HirProgram
    ## Whole-program HIR proof that these functions may receive their exact
    ## class receiver as a non-owning capability during destruction.
    pub let borrowed_receiver_methods: list[SymbolId]
    ## Exact functions whose own bodies contain `spawn`. This analyzed HIR
    ## fact is deliberately non-transitive because each invocation owns only
    ## the children it creates directly.
    pub let direct_spawn_functions: list[SymbolId]
    # Program-wide tables the lowered functions refer to by identity.
    pub let types: MirTypeTable
    pub let externs: list[MirExtern]
    pub let external_globals: list[MirExternalGlobal]
    pub let lowered_external_globals: list[ExternalGlobalId]
    pub let external_global_contracts: list[ExternalGlobalContract]
    pub let globals: list[MirGlobal]
    pub let data: list[MirData]
    pub let lowered_functions: list[LoweredFunction]
    pub let classes: list[MirClass]
    ## Concrete HIR class application in the same order as canonical
    ## `classes`. Source declaration indices are deliberately insufficient:
    ## `Box[i64]` and `Box[str]` have distinct payload and lifecycle identity.
    pub let class_hir_types: list[ir.TypeId]
    ## HIR TypeId-aligned reverse map to the canonical class table. Concrete
    ## application lookup stays constant-time while `class_hir_types` retains
    ## the inverse mapping needed to build payloads and destroyers.
    pub let class_identities: list[u32]
    pub let class_destroyers: list[FunctionId]
    pub let interfaces: list[MirInterface]
    pub let conformances: list[MirConformance]
    pub let conformance_witnesses: list[list[FunctionId]]
    pub let closures: list[MirClosure]
    # HIR contains entries for capture-free lambdas as an observable semantic
    # fact. Only allocating closures enter canonical MIR; this parallel table
    # maps the former identities to the latter or the unlowered sentinel.
    pub let lowered_closures: list[u32]
    pub let closure_destroyers: list[FunctionId]
    pub let cells: list[CellStorage]
    # Nominal aggregates reserve their MIR identity before lowering fields.
    # A collection reference may point back to that identity without making
    # the aggregate's byte layout recursive.
    pub let lowered_struct_types: list[u32]
    pub let lowered_class_types: list[u32]
    pub let lowered_enum_types: list[u32]
    pub let lowered_interface_types: list[u32]
    pub let active_nominal_types: list[u32]
    ## Structural key of every complete definition; reservations join it once
    ## their fields are known.
    let type_index: map[str, u32]
    pub let c_wrappers: list[CWrapper]
    pub let c_extern_contracts: list[CExternContract]
    pub let ownership_helpers: list[OwnershipHelper]
    # Identity-indexed lookups over the tables above and over HIR symbols.
    let function_index_by_symbol: list[i64]
    let constant_index_by_symbol: list[i64]
    let shared_symbol_flags: list[bool]
    let ownership_helper_by_type: list[i64]
    let equality_helper_by_type: list[i64]
    # Locals of the function being lowered, valid while the stamp matches.
    let local_index_by_symbol: list[i64]
    let local_stamp_by_symbol: list[u32]
    var local_generation: u32
    pub let equality_helpers: list[EqualityHelper]
    pub let generated_helpers: list[GeneratedHelper]
    pub var next_generated_function: u32
    # The register table, slots, live locals, and parameter registers of the
    # function being lowered.
    pub var registers: list[TypeId]
    pub var slots: list[MirSlot]
    pub var locals: list[Local]
    pub var parameters: list[Local]
    pub var regions: list[Region]
    # Deferred actions currently registered in enclosing lexical scopes, and
    # the first action belonging to each active source loop.
    pub var defers: list[DeferredAction]
    ## Start of every active lexical source scope, root first. Function exits
    ## use the first nested boundary to finish workers after nested cleanup but
    ## before the root function-scope cleanup suffix.
    pub var scope_defer_starts: list[i64]
    pub var loop_defer_starts: list[i64]
    pub var recover_targets: list[RecoverTarget]
    # The operand table of the function being lowered.
    pub var operands: OperandBuilder
    # Hidden caller-owned Error and aggregate-result pointers (`-1` when the
    # function does not use that protocol), and the newline data item.
    pub var error_slot: i64
    pub var result_slot: i64
    ## The compiler-internal task-group register, or `-1` when this function
    ## contains no direct spawn.
    pub var task_group: i64
    pub var newline_data: i64

    ## Prepare to lower one analyzed program; `lower` walks it once for every backend.
    pub init(program: HirProgram, borrowed_receiver_methods: list[SymbolId], direct_spawn_functions: list[SymbolId]):
        self.program = program
        self.borrowed_receiver_methods = borrowed_receiver_methods
        self.direct_spawn_functions = direct_spawn_functions
        self.types = create_builtin_mir_types()
        self.externs = list[MirExtern]()
        self.external_globals = list[MirExternalGlobal]()
        self.lowered_external_globals = list[ExternalGlobalId]()
        self.external_global_contracts = list[ExternalGlobalContract]()
        self.globals = list[MirGlobal]()
        self.data = list[MirData]()
        self.lowered_functions = list[LoweredFunction]()
        self.classes = list[MirClass]()
        self.class_hir_types = list[ir.TypeId]()
        self.class_identities = list[u32]()
        for definition in self.program.types.definitions: self.class_identities.append(unlowered_nominal_type)
        self.class_destroyers = list[FunctionId]()
        self.interfaces = list[MirInterface]()
        self.conformances = list[MirConformance]()
        self.conformance_witnesses = list[list[FunctionId]]()
        self.closures = list[MirClosure]()
        self.lowered_closures = list[u32]()
        for closure in self.program.closures: self.lowered_closures.append(unlowered_nominal_type)
        self.closure_destroyers = list[FunctionId]()
        self.cells = list[CellStorage]()
        self.lowered_struct_types = list[u32]()
        for definition in self.program.types.definitions: self.lowered_struct_types.append(unlowered_nominal_type)
        self.lowered_class_types = list[u32]()
        for definition in self.program.types.definitions: self.lowered_class_types.append(unlowered_nominal_type)
        self.lowered_enum_types = list[u32]()
        for definition in self.program.types.definitions: self.lowered_enum_types.append(unlowered_nominal_type)
        self.lowered_interface_types = list[u32]()
        for definition in self.program.types.definitions: self.lowered_interface_types.append(unlowered_nominal_type)
        self.active_nominal_types = list[u32]()
        self.type_index = map[str, u32]()
        for index in range(0, len(self.types.definitions)):
            let key = mir_type_key(self.types.definitions[index])
            if not self.type_index.has(key): self.type_index[key] = u32(index)
        self.c_wrappers = list[CWrapper]()
        self.c_extern_contracts = list[CExternContract]()
        self.ownership_helpers = list[OwnershipHelper]()
        self.function_index_by_symbol = list[i64]()
        self.constant_index_by_symbol = list[i64]()
        self.shared_symbol_flags = list[bool]()
        self.local_index_by_symbol = list[i64]()
        self.local_stamp_by_symbol = list[u32]()
        self.local_generation = 0
        for symbol in program.symbols:
            self.function_index_by_symbol.append(-1)
            self.constant_index_by_symbol.append(-1)
            self.shared_symbol_flags.append(false)
            self.local_index_by_symbol.append(-1)
            self.local_stamp_by_symbol.append(0)
        for index in range(0, len(program.functions)):
            let symbol = program.functions[index].symbol.value
            if self.function_index_by_symbol[symbol] < 0: self.function_index_by_symbol[symbol] = index
        for index in range(0, len(program.constants)):
            let symbol = program.constants[index].symbol.value
            if self.constant_index_by_symbol[symbol] < 0: self.constant_index_by_symbol[symbol] = index
        for symbol in program.shared_cells: self.shared_symbol_flags[symbol.value] = true
        self.ownership_helper_by_type = list[i64]()
        self.equality_helper_by_type = list[i64]()
        self.equality_helpers = list[EqualityHelper]()
        self.generated_helpers = list[GeneratedHelper]()
        self.next_generated_function = 0
        self.registers = list[TypeId]()
        self.slots = list[MirSlot]()
        self.locals = list[Local]()
        self.parameters = list[Local]()
        self.regions = list[Region]()
        self.defers = list[DeferredAction]()
        self.scope_defer_starts = list[i64]()
        self.loop_defer_starts = list[i64]()
        self.recover_targets = list[RecoverTarget]()
        self.operands = OperandBuilder()
        self.error_slot = -1
        self.result_slot = -1
        self.task_group = -1
        self.newline_data = -1

    # mark: Program declarations ================================================================

    # HIR already resolved each package-descriptor entry to a SymbolId. Map
    # that identity through the same callable table as ordinary direct calls;
    # no source spelling survives to MIR composition or a backend.
    pub func lower_runtime_bindings() -> list[MirRuntimeBinding]:
        let bindings = list[MirRuntimeBinding]()
        for binding in self.program.runtime_bindings:
            let source_index = self.function_index_of(binding.function)
            if source_index < 0: trap("HIR runtime binding names an unknown function symbol")
            match self.lowered_functions[source_index]:
                Defined(function): bindings.append(MirRuntimeBinding(service = binding.service, function = function))
                External(external): trap("HIR runtime binding names an external function")
        return bindings

    # HIR has already fixed each address conversion's type. Scan that one
    # canonical fact before assigning FunctionIds so generated adapters never
    # require late identity patching or backend-specific discovery.
    pub func c_wrapper_symbols() -> list[SymbolId]:
        let symbols = list[SymbolId]()
        for index in range(0, len(self.program.nodes)):
            match self.program.nodes[index].form:
                FunctionAddress(target):
                    match self.program.types.definitions[self.program.node_types[index].value].form:
                        CFunction(parameters, result):
                            if not contains_symbol(symbols, target): symbols.append(target)
                        else: pass
                else: pass
        return symbols

    pub func lower_external_signature(module: HirModule, function: HirFunction, contract: HirCFunction) -> MirSignature!:
        let parameters = list[TypeId]()
        for slot in contract.slots:
            match slot:
                Input(parameter):
                    parameters.append(try self.c_boundary_type_of(module, function, function.span, function.parameters[parameter].value_type))
                Output(name, value_type):
                    # C receives the address of caller-owned raw storage.
                    parameters.append(builtin_mir_type(BuiltinMirType.pointer))
        let results = list[TypeId]()
        if not types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            results.append(try self.c_boundary_type_of(module, function, function.span, contract.declared_result))
        return MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false)

    # C symbols inhabit one linker namespace even when several source
    # modules declare them. Equal source contracts share one MIR identity; a
    # conflict is rejected before handle identity or nullability is erased.
    pub func declare_c_extern(function: HirFunction, boundary: HirCFunction, signature: MirSignature) -> ExternId!:
        for contract in self.c_extern_contracts:
            if contract.name != function.name: continue
            if not self.c_extern_contract_matches(contract, function, boundary):
                error("lowerer: conflicting declarations of C symbol `" + function.name + "`")
            let existing = self.externs[contract.external.value]
            if not signatures_match(existing.signature, signature):
                trap("matching C contracts lowered to different MIR signatures")
            return contract.external

        let external = ExternId(value = u32(len(self.externs)))
        self.externs.append(MirExtern(name = function.name, convention = CallingConvention.c, signature = signature))
        let slots = list[CExternSlot]()
        for slot in boundary.slots:
            match slot:
                Input(parameter): slots.append(CExternSlot.Input(value_type = function.parameters[parameter].value_type))
                Output(name, value_type): slots.append(CExternSlot.Output(value_type = value_type))
        self.c_extern_contracts.append(CExternContract(
            external = external,
            name = function.name,
            slots = slots,
            declared_result = boundary.declared_result,
            is_blocking = boundary.is_blocking,
        ))
        return external

    pub func c_extern_contract_matches(contract: CExternContract, function: HirFunction, boundary: HirCFunction) -> bool:
        if contract.is_blocking != boundary.is_blocking: return false
        if not types_match(contract.declared_result, boundary.declared_result): return false
        if len(contract.slots) != len(boundary.slots): return false
        for index in range(0, len(contract.slots)):
            let expected = contract.slots[index]
            match boundary.slots[index]:
                Input(parameter):
                    match expected:
                        Input(value_type):
                            if not types_match(value_type, function.parameters[parameter].value_type): return false
                        Output(value_type): return false
                Output(name, value_type):
                    match expected:
                        Input(input_type): return false
                        Output(output_type):
                            if not types_match(output_type, value_type): return false
        return true

    # One external object identity per linker symbol. HIR type identity is
    # compared before nominal handles are erased to their MIR token shape.
    pub func declare_external_global(variable: ir.HirExternVariable) -> ExternalGlobalId!:
        for external in self.externs:
            if external.name == variable.name:
                error("lowerer: C symbol `" + variable.name + "` is declared as both a function and a variable")
        for contract in self.external_global_contracts:
            if contract.name != variable.name: continue
            if not types_match(contract.value_type, variable.value_type):
                error("lowerer: conflicting declarations of C global `" + variable.name + "`")
            return contract.global
        let global = ExternalGlobalId(value = u32(len(self.external_globals)))
        self.external_globals.append(MirExternalGlobal(name = variable.name, value_type = self.external_global_type(variable.value_type)))
        self.external_global_contracts.append(ExternalGlobalContract(global = global, name = variable.name, value_type = variable.value_type))
        return global

    # Lower one function body. The canonical name is `module.function` so
    # artifacts stay unambiguous across modules. `main` keeps the entry
    # signature from the header note above; every other function's parameters
    # become its leading registers.
    # A method is named `module.Struct.method`; `self` is its first parameter
    # and, being an aggregate, arrives as a pointer — which is exactly what a
    # `mutating` method needs: its stores land in the caller's slot.

    # mark: Tables ==============================================================================

    pub func new_register(value_type: TypeId) -> RegisterId:
        self.registers.append(value_type)
        return RegisterId(value = u32(len(self.registers) - 1))

    # The HIR function a call symbol names, as its index in `program.functions`.
    pub func function_index_of(symbol: SymbolId) -> i64:
        return self.function_index_by_symbol[symbol.value]

    pub func is_shared_symbol(symbol: SymbolId) -> bool:
        return self.shared_symbol_flags[symbol.value]

    pub func cell_for_hir_type(value_type: ir.TypeId) -> CellStorage?:
        for cell in self.cells:
            if types_match(cell.hir_type, value_type): return cell
        return none

    pub func cell_for_symbol(symbol: SymbolId) -> CellStorage:
        let cell = self.cell_for_hir_type(self.program.symbols[symbol.value].value_type) else trap("shared HIR symbol has no reserved MIR cell representation")
        return cell

    ## Reserve one typed cell and its lifecycle callback before any body can
    ## refer to either identity.
    pub func reserve_cell(value_type: ir.TypeId, destroyer: FunctionId) -> !:
        if self.cell_for_hir_type(value_type) != none: return
        let element_type = try self.lower_mir_type(value_type)
        let cell_type = self.intern_lowered_type(MirType.Cell(element = element_type))
        self.cells.append(CellStorage(hir_type = value_type, element_type = element_type, cell_type = cell_type, destroyer = destroyer))

    pub func closure_id_of(hir_closure: i64) -> ClosureId:
        if hir_closure < 0 or hir_closure >= len(self.lowered_closures): trap("HIR closure identity is out of range")
        let lowered = self.lowered_closures[hir_closure]
        if lowered == unlowered_nominal_type: trap("capture-free HIR closure has no MIR environment")
        return ClosureId(value = lowered)

    # The module constant a reference names, if any.
    pub func constant_of(symbol: SymbolId) -> HirConstant?:
        let index = self.constant_index_by_symbol[symbol.value]
        if index < 0: return none
        return self.program.constants[index]

    ## Forget the previous function's locals in O(1).
    pub func begin_locals():
        self.locals = list[Local]()
        self.local_generation += 1

    pub func add_local(symbol: SymbolId, address: RegisterId):
        let stamp = self.local_stamp_by_symbol[symbol.value]
        # The first slot reserved for a symbol keeps it, as a scan would.
        if stamp != self.local_generation:
            self.local_index_by_symbol[symbol.value] = len(self.locals)
            self.local_stamp_by_symbol[symbol.value] = self.local_generation
        self.locals.append(Local(symbol = symbol.value, address = address))

    # The slot address of a local the prologue reserved.
    pub func local_of(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId) -> Local!:
        if self.local_stamp_by_symbol[symbol.value] == self.local_generation:
            return self.locals[self.local_index_by_symbol[symbol.value]]
        error(self.unsupported(module, function, span, "a reference to a symbol that is not a local"))

    ## Index of the ownership helper for `value_type`, or -1.
    pub func ownership_helper_index(value_type: TypeId) -> i64:
        if i64(value_type.value) >= len(self.ownership_helper_by_type): return -1
        return self.ownership_helper_by_type[value_type.value]

    pub func add_ownership_helper(helper: OwnershipHelper):
        while len(self.ownership_helper_by_type) <= i64(helper.value_type.value): self.ownership_helper_by_type.append(-1)
        self.ownership_helper_by_type[helper.value_type.value] = len(self.ownership_helpers)
        self.ownership_helpers.append(helper)

    pub func equality_helper_index(hir_type: ir.TypeId) -> i64:
        if i64(hir_type.value) >= len(self.equality_helper_by_type): return -1
        return self.equality_helper_by_type[hir_type.value]

    pub func add_equality_helper(helper: EqualityHelper):
        while len(self.equality_helper_by_type) <= i64(helper.hir_type.value): self.equality_helper_by_type.append(-1)
        self.equality_helper_by_type[helper.hir_type.value] = len(self.equality_helpers)
        self.equality_helpers.append(helper)

    # Declare a runtime service once, with the signature the runtime table
    # fixes for it. Runtime services and source C declarations share the
    # linker's symbol namespace, but never each other's semantic contract.
    pub func runtime_extern(name: str) -> ExternId!:
        for index in range(0, len(self.externs)):
            let external = self.externs[index]
            if external.name != name: continue
            if external.convention != CallingConvention.runtime:
                error("lowerer: C symbol `" + name + "` conflicts with runtime service")
            return ExternId(value = u32(index))
        for global in self.external_globals:
            if global.name == name:
                error("lowerer: C symbol `" + name + "` conflicts with runtime service")
        let symbol = find_runtime_symbol(name) else error("lowerer: `" + name + "` is not a runtime service")
        self.externs.append(MirExtern(name = name, convention = CallingConvention.runtime, signature = symbol.signature))
        return ExternId(value = u32(len(self.externs) - 1))

    # Map a scalar HIR type onto its canonical machine type. HIR and MIR each
    # have a `TypeId`; the HIR one is spelled `ir.TypeId` here. `char` is its
    # code point in a `u32`.
    pub func mir_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: ir.TypeId) -> TypeId!:
        let lowered = self.lower_mir_type(value) catch feature:
            error(self.unsupported(module, function, span, feature))
        return lowered

    # HIR-to-MIR type lowering is program-wide and backend-independent. The
    # function and global wrappers add source context only if this shared
    # conversion fails.
    pub func lower_mir_type(value: ir.TypeId) -> TypeId!:
        let scalar = self.scalar_mir_type(value)
        if scalar != none: return scalar
        # Composites are interned structurally, so two `(i64, bool)` tuples
        # share one MIR type and the verifier sees each layout once.
        match self.program.types.definitions[value.value].form:
            # Unit normally has no register, but it is a legitimate zero-size
            # element of a collection such as the ordered result of
            # `wait_all(list[task[unit]])`.
            Unit: return self.intern_lowered_type(make_struct_type(list[TypeId]()))
            Never: return self.intern_lowered_type(MirType.Uninhabited)
            String: return self.string_type()
            Bytes: return self.bytes_type()
            ErrorCode:
                let fields = [self.string_type(), builtin_mir_type(BuiltinMirType.unsigned_u32)]
                return self.intern_lowered_type(make_struct_type(fields))
            Error:
                let code = try self.lower_mir_type(resolve_builtin_type(BuiltinType.error_code))
                let fields = [code, self.string_type()]
                return self.intern_lowered_type(make_struct_type(fields))
            Tuple(elements):
                let field_types = list[TypeId]()
                for element in elements:
                    field_types.append(try self.lower_mir_type(element))
                return self.intern_lowered_type(make_struct_type(field_types))
            Array(element, count):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.Array(element = element_type, count = count))
            Range(element):
                let element_type = try self.lower_mir_type(element)
                let field_types = [element_type, element_type, builtin_mir_type(BuiltinMirType.boolean)]
                return self.intern_lowered_type(make_struct_type(field_types))
            Struct(index, arguments):
                let existing = self.lowered_struct_types[value.value]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_struct_types[value.value] = result.value
                self.types.definitions.append(make_struct_type(list[TypeId]()))
                self.active_nominal_types.append(result.value)
                let field_types = list[TypeId]()
                for field in nominal_fields(self.program, value):
                    field_types.append(try self.lower_mir_type(field.value_type))
                self.complete_nominal_type(result, make_struct_type(field_types))
                let completed = self.active_nominal_types.pop()
                if completed != result.value: trap("nominal MIR type reservations are not nested")
                return result
            Class(index, arguments):
                let existing = self.lowered_class_types[value.value]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let identity = self.class_identity(value)
                if identity == none: trap("concrete HIR class application was not reserved")
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_class_types[value.value] = result.value
                self.types.definitions.append(MirType.Class(identity = identity))
                self.type_index[mir_type_key(MirType.Class(identity = identity))] = result.value
                return result
            Weak(inner):
                let class_type = try self.lower_mir_type(inner)
                match mir_type(self.types, class_type):
                    Class(identity): return self.intern_lowered_type(MirType.WeakClass(identity = identity))
                    else: trap("HIR `Weak[T]` referent is not a class")
            Interface(declaration, arguments):
                let existing = self.lowered_interface_types[value.value]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let application = self.interface_application(value)
                let identity = InterfaceId(value = u32(len(self.interfaces)))
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_interface_types[value.value] = result.value
                self.types.definitions.append(MirType.Interface(identity = identity))
                self.type_index[mir_type_key(MirType.Interface(identity = identity))] = result.value
                self.interfaces.append(MirInterface(requirements = list[MirInterfaceRequirement]()))
                let requirements = list[MirInterfaceRequirement]()
                for requirement in application.requirements:
                    requirements.append(MirInterfaceRequirement(
                        signature = try self.lower_interface_signature(requirement.parameters, requirement.result),
                        is_mutating = requirement.is_mutating,
                    ))
                self.interfaces[identity.value] = MirInterface(requirements = requirements)
                return result
            Enum(index, arguments):
                # One payload struct per case, in semantic case order. The
                # smallest Luce unsigned scalar that can name every case keeps
                # canonical MIR compact without imposing a source ordinal or
                # a target ABI decision.
                let cases = nominal_cases(self.program, value)
                let tag_type = self.enum_tag_type(len(cases))
                let existing = self.lowered_enum_types[value.value]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_enum_types[value.value] = result.value
                self.types.definitions.append(MirType.Enum(tag = tag_type, cases = list[TypeId]()))
                self.active_nominal_types.append(result.value)
                let case_types = list[TypeId]()
                for case_value in cases:
                    let field_types = list[TypeId]()
                    for field in case_value.payload:
                        field_types.append(try self.lower_mir_type(field.value_type))
                    case_types.append(self.intern_lowered_type(make_struct_type(field_types)))
                self.complete_nominal_type(result, make_enum_type(tag_type, case_types))
                let completed = self.active_nominal_types.pop()
                if completed != result.value: trap("nominal MIR type reservations are not nested")
                return result
            Optional(inner):
                let absent = self.intern_lowered_type(make_struct_type(list[TypeId]()))
                let present = try self.lower_mir_type(inner)
                return self.intern_lowered_type(make_enum_type(builtin_mir_type(BuiltinMirType.unsigned_u8), [absent, present]))
            Function(parameters, result):
                return self.intern_lowered_type(MirType.Func(signature = try self.lower_luce_function_signature(parameters, result)))
            CFunction(parameters, result): return builtin_mir_type(BuiltinMirType.pointer)
            Foreign: return builtin_mir_type(BuiltinMirType.pointer)
            NativePointer(pointee, is_mutable): return builtin_mir_type(BuiltinMirType.pointer)
            List(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.List(element = element_type))
            FrozenList(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.FrozenList(element = element_type))
            Map(key, element):
                let key_type = try self.lower_mir_type(key)
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.Map(key = key_type, value = element_type))
            Set(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.Set(element = element_type))
            FrozenMap(key, element):
                let key_type = try self.lower_mir_type(key)
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.FrozenMap(key = key_type, value = element_type))
            FrozenSet(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.FrozenSet(element = element_type))
            Slice(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.Slice(element = element_type))
            MutableSlice(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.MutableSlice(element = element_type))
            Task(result):
                let failure_type = try self.lower_mir_type(resolve_builtin_type(BuiltinType.error_value))
                if types_match(result, resolve_builtin_type(BuiltinType.unit)):
                    return self.intern_lowered_type(MirType.Task(result = MirTaskResult.Unit, failure_type = failure_type))
                if types_match(result, resolve_builtin_type(BuiltinType.never_type)):
                    return self.intern_lowered_type(MirType.Task(result = MirTaskResult.Never, failure_type = failure_type))
                let result_type = try self.lower_mir_type(result)
                return self.intern_lowered_type(MirType.Task(result = MirTaskResult.Value(value_type = result_type), failure_type = failure_type))
            Extern(index):
                # Nominality is a source/HIR rule. Canonical MIR carries the
                # declared target-neutral token representation; ABI placement
                # remains a backend concern.
                match self.program.extern_types[index].representation:
                    Pointer: return builtin_mir_type(BuiltinMirType.pointer)
                    Integer(representation): return try self.lower_mir_type(representation)
            else: error("type `" + describe_type(self.program.types, value) + "`")

    ## An enum's internal case selector is not a source-visible ordinal. This
    ## target-neutral width only bounds canonical storage; a native boundary
    ## must still declare its own explicit representation.
    func enum_tag_type(case_count: i64) -> TypeId:
        if case_count <= 256: return builtin_mir_type(BuiltinMirType.unsigned_u8)
        if case_count <= 65536: return builtin_mir_type(BuiltinMirType.unsigned_u16)
        if case_count <= 4294967296: return builtin_mir_type(BuiltinMirType.unsigned_u32)
        return builtin_mir_type(BuiltinMirType.unsigned_u64)

    ## Reserve one concrete class application and its generated destroyer.
    ## Reservation precedes type/body lowering so every implicit release edge
    ## refers to stable canonical identities.
    pub func reserve_class(value_type: ir.TypeId, destroyer: FunctionId):
        if self.class_identities[value_type.value] != unlowered_nominal_type: trap("class application was reserved more than once")
        self.class_identities[value_type.value] = u32(len(self.class_hir_types))
        self.class_hir_types.append(value_type)
        self.class_destroyers.append(destroyer)

    pub func class_identity(value_type: ir.TypeId) -> ClassId?:
        if i64(value_type.value) >= len(self.class_identities): return none
        let identity = self.class_identities[value_type.value]
        if identity == unlowered_nominal_type: return none
        return ClassId(value = identity)

    # Function values retain the same hidden result/error protocol as direct
    # Luce calls. Their aggregate handle is separate from this invocation
    # signature, so backends can keep capture layout private.
    ## The canonical Luce call shape for a source signature. Parameter 0 is
    ## the caller-owned error slot of a fallible result, `leading` are hidden
    ## pointer parameters that follow it (a closure environment), an aggregate
    ## result becomes a hidden result-slot pointer next, and source parameters
    ## come last with aggregates passed by address.
    pub func assemble_signature(result: ir.TypeId, leading: list[TypeId], parameters: list[TypeId]) -> MirSignature!:
        let pointer = builtin_mir_type(BuiltinMirType.pointer)
        let lowered_parameters = list[TypeId]()
        let lowered_results = list[TypeId]()
        let fallible = self.fallible_inner(result)
        var successful = result
        if fallible != none:
            successful = fallible
            lowered_parameters.append(pointer)
        for hidden in leading: lowered_parameters.append(hidden)
        let returns_never = types_match(successful, resolve_builtin_type(BuiltinType.never_type))
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)) and not returns_never:
            let result_type = try self.lower_mir_type(successful)
            if is_aggregate_type(self.types, result_type): lowered_parameters.append(pointer)
            else: lowered_results.append(result_type)
        if fallible != none: lowered_results.append(pointer)
        for parameter in parameters:
            if is_aggregate_type(self.types, parameter): lowered_parameters.append(pointer)
            else: lowered_parameters.append(parameter)
        return MirSignature(parameters = lowered_parameters, results = lowered_results, is_fallible = fallible != none, returns_never = returns_never)

    pub func lower_luce_function_signature(parameters: list[ir.TypeId], result: ir.TypeId) -> MirSignature!:
        let lowered = list[TypeId]()
        for parameter in parameters: lowered.append(try self.lower_mir_type(parameter))
        return try self.assemble_signature(result, list[TypeId](), lowered)

    # Dynamic witnesses use one erased payload pointer in the source receiver
    # position. Hidden fallibility and aggregate-result slots keep the same
    # ordering as every direct Luce call.
    pub func lower_interface_signature(parameters: list[ir.HirParameter], result: ir.TypeId) -> MirSignature!:
        let lowered = [builtin_mir_type(BuiltinMirType.pointer)]
        for parameter in parameters: lowered.append(try self.lower_mir_type(parameter.value_type))
        return try self.assemble_signature(result, list[TypeId](), lowered)

    func interface_application(value_type: ir.TypeId) -> ir.HirInterfaceApplication:
        for application in self.program.interface_applications:
            if application.value_type.value == value_type.value: return application
        trap("HIR interface type has no applied signature table")

    ## Publish each nominal payload schema after all class types and destroyer
    ## identities have been reserved. Weak fields deliberately lower to a
    ## distinct storage handle rather than their source optional type.
    pub func lower_classes() -> !:
        if len(self.class_destroyers) != len(self.class_hir_types): trap("class destroyer identities were not reserved")
        for class_index in range(0, len(self.class_hir_types)):
            let class_type = self.class_hir_types[class_index]
            let fields = list[MirClassField]()
            for field in nominal_fields(self.program, class_type):
                var storage_type = try self.lower_mir_type(field.value_type)
                if field.is_weak:
                    var referent_type: ir.TypeId? = none
                    match self.program.types.definitions[field.value_type.value].form:
                        Optional(inner): referent_type = inner
                        else: pass
                    let referent_hir_type = referent_type else trap("HIR weak field is not optional")
                    let referent = try self.lower_mir_type(referent_hir_type)
                    match mir_type(self.types, referent):
                        Class(identity): storage_type = self.intern_lowered_type(MirType.WeakClass(identity = identity))
                        else: trap("HIR weak field does not contain an optional class")
                fields.append(MirClassField(storage_type = storage_type))
            self.classes.append(MirClass(
                name = describe_type(self.program.types, class_type),
                fields = fields,
                destroyer = self.class_destroyers[class_index],
            ))

    ## Publish only allocating closure environments. Capture-free anonymous
    ## functions remain ordinary function values and therefore need neither
    ## metadata nor a generated destroyer in canonical MIR.
    pub func lower_closures() -> !:
        var allocating_index: i64 = 0
        for hir_index in range(0, len(self.program.closures)):
            let source = self.program.closures[hir_index]
            if len(source.captures) == 0: continue
            if allocating_index >= len(self.closure_destroyers): trap("closure destroyer identities were not reserved")
            let fields = list[MirField]()
            for capture in source.captures:
                var storage_type = try self.lower_mir_type(capture.value_type)
                if capture.kind == HirCaptureKind.shared_cell:
                    let cell = self.cell_for_hir_type(capture.value_type) else trap("shared HIR capture has no reserved MIR cell")
                    storage_type = cell.cell_type
                elif capture.kind == HirCaptureKind.weak_capture:
                    var referent_type: ir.TypeId? = none
                    match self.program.types.definitions[capture.value_type.value].form:
                        Optional(inner): referent_type = inner
                        else: pass
                    let referent_hir_type = referent_type else trap("weak HIR closure capture is not optional")
                    let referent = try self.lower_mir_type(referent_hir_type)
                    match mir_type(self.types, referent):
                        Class(identity): storage_type = self.intern_lowered_type(MirType.WeakClass(identity = identity))
                        else: trap("weak HIR closure capture is not an optional class")
                fields.append(MirField(value_type = storage_type))
            let function_index = self.function_index_of(source.function)
            if function_index < 0: trap("HIR closure body has no function identity")
            var target = FunctionId(value = 0)
            match self.lowered_functions[function_index]:
                Defined(function): target = function
                External(external): trap("HIR closure body names an external function")
            let hidden = self.program.functions[function_index]
            let parameters = list[ir.TypeId]()
            for parameter in hidden.parameters: parameters.append(parameter.value_type)
            let signature = try self.lower_luce_function_signature(parameters, hidden.result)
            let closure = ClosureId(value = u32(len(self.closures)))
            self.lowered_closures[hir_index] = closure.value
            self.closures.append(MirClosure(
                function = target,
                signature = signature,
                captures = fields,
                destroyer = self.closure_destroyers[allocating_index],
            ))
            allocating_index += 1
        if allocating_index != len(self.closure_destroyers): trap("closure destroyer reservation count does not match allocating closures")

    # Nominal aggregates reserve a valid empty definition so collection
    # references can point back to them. Structural interning skips only the
    # active reservations; no malformed sentinel type ever enters the table.
    pub func intern_lowered_type(value: MirType) -> TypeId:
        let key = mir_type_key(value)
        if self.type_index.has(key): return TypeId(value = self.type_index[key])
        let result = TypeId(value = u32(len(self.types.definitions)))
        self.types.definitions.append(value)
        self.type_index[key] = result.value
        return result

    # A completed nominal definition becomes structurally visible; the first
    # definition of a structure keeps its identity.
    func complete_nominal_type(id: TypeId, value: MirType):
        self.types.definitions[id.value] = value
        let key = mir_type_key(value)
        if not self.type_index.has(key): self.type_index[key] = id.value

    pub func global_mir_type(global: ir.HirGlobal) -> TypeId!:
        let module = self.program.modules[global.module.value]
        let lowered = self.lower_mir_type(global.value_type) catch feature:
            error(format_diagnostic(
                module.path,
                global.span,
                "lowerer does not support " + feature + " yet in runtime global `" + module.name + "." + global.name + "`",
            ))
        return lowered

    # The one scalar mapping shared by ordinary values and external-global
    # declarations. This is semantic width, not target ABI placement.
    pub func scalar_mir_type(value: ir.TypeId) -> TypeId?:
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i8)): return builtin_mir_type(BuiltinMirType.signed_i8)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i16)): return builtin_mir_type(BuiltinMirType.signed_i16)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i32)): return builtin_mir_type(BuiltinMirType.signed_i32)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i64)): return builtin_mir_type(BuiltinMirType.signed_i64)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u8)): return builtin_mir_type(BuiltinMirType.unsigned_u8)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u16)): return builtin_mir_type(BuiltinMirType.unsigned_u16)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u32)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u64)): return builtin_mir_type(BuiltinMirType.unsigned_u64)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_usize)): return pointer_int_type(self.types, false)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_isize)): return pointer_int_type(self.types, true)
        if types_match(value, resolve_builtin_type(BuiltinType.float16)): return builtin_mir_type(BuiltinMirType.float16)
        if types_match(value, resolve_builtin_type(BuiltinType.float32)): return builtin_mir_type(BuiltinMirType.float32)
        if types_match(value, resolve_builtin_type(BuiltinType.float64)): return builtin_mir_type(BuiltinMirType.float64)
        if types_match(value, resolve_builtin_type(BuiltinType.boolean)): return builtin_mir_type(BuiltinMirType.boolean)
        if types_match(value, resolve_builtin_type(BuiltinType.character)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        return none

    pub func external_global_type(value: ir.TypeId) -> TypeId:
        let scalar = self.scalar_mir_type(value)
        if scalar != none: return scalar
        match self.program.types.definitions[value.value].form:
            Extern(index):
                match self.program.extern_types[index].representation:
                    Pointer: return builtin_mir_type(BuiltinMirType.pointer)
                    Integer(representation):
                        let lowered = self.scalar_mir_type(representation)
                        if lowered != none: return lowered
            else: pass
        trap("HIR admitted an unsupported external-global type")

    # Borrowed text/list values, extern-struct pointers, and nullable C tokens
    # all become one abstract pointer at this boundary. Their ordinary MIR
    # representations remain unchanged; this is target-independent shape
    # translation, never ABI placement.
    pub func c_boundary_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: ir.TypeId) -> TypeId!:
        let c_enum = self.c_enum_shape(value)
        if c_enum != none:
            return try self.mir_type_of(module, function, span, c_enum.representation)
        if types_match(value, resolve_builtin_type(BuiltinType.string)): return builtin_mir_type(BuiltinMirType.pointer)
        match self.program.types.definitions[value.value].form:
            List(element): return builtin_mir_type(BuiltinMirType.pointer)
            else: pass
        if self.optional_c_pointer(value) != none: return builtin_mir_type(BuiltinMirType.pointer)
        if self.is_extern_struct(value): return builtin_mir_type(BuiltinMirType.pointer)
        if self.is_exported_c_struct(value): return try self.c_record_type_of(module, function, span, value)
        return try self.mir_type_of(module, function, span, value)

    ## HIR retains the only semantic distinction between an ordinary struct
    ## and a value that may be packed into a C pointer slot. MIR's value type
    ## remains the same target-neutral structural aggregate.
    pub func is_extern_struct(value: ir.TypeId) -> bool:
        match self.program.types.definitions[value.value].form:
            Struct(index, arguments):
                let kind = self.program.structs[index].c_kind
                if kind == none: return false
                return kind == HirCStructKind.external
            else: return false

    pub func is_exported_c_struct(value: ir.TypeId) -> bool:
        match self.program.types.definitions[value.value].form:
            Struct(index, arguments):
                let kind = self.program.structs[index].c_kind
                if kind == none: return false
                return kind == HirCStructKind.exported
            else: return false

    pub func is_c_struct(value: ir.TypeId) -> bool:
        return self.is_extern_struct(value) or self.is_exported_c_struct(value)

    ## Declaration-order C record shape, expressed only as structural MIR
    ## types. Exact byte layout and ABI classification remain backend work.
    pub func c_record_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: ir.TypeId) -> TypeId!:
        if not self.is_c_struct(value): trap("C record type requested for an ordinary struct")
        let fields = list[TypeId]()
        for field in nominal_fields(self.program, value):
            if self.is_c_struct(field.value_type):
                fields.append(try self.c_record_type_of(module, function, span, field.value_type))
            else:
                fields.append(try self.c_boundary_type_of(module, function, span, field.value_type))
        return self.intern_lowered_type(make_struct_type(fields))

    pub func c_enum_shape(value: ir.TypeId) -> HirCEnum?:
        match self.program.types.definitions[value.value].form:
            Enum(index, arguments): return self.program.enums[index].c_shape
            else: return none

    pub func is_c_data_pointer(value: ir.TypeId) -> bool:
        match self.program.types.definitions[value.value].form:
            Foreign: return true
            Extern(index):
                match self.program.extern_types[index].representation:
                    Pointer: return true
                    Integer(representation): return false
            else: return false

    ## Ordinary MIR storage keeps every optional tagged. Only a C call slot
    ## recognizes nullable data handles and nullable cfuncs as one raw pointer.
    pub func optional_c_pointer(value: ir.TypeId) -> ir.TypeId?:
        match self.program.types.definitions[value.value].form:
            Optional(inner):
                if self.is_c_data_pointer(inner) or self.is_c_function(inner): return inner
                return none
            else: return none

    pub func is_c_function(value: ir.TypeId) -> bool:
        match self.program.types.definitions[value.value].form:
            CFunction(parameters, result): return true
            else: return false

    # Immutable strings and bytes share one owned-buffer value protocol.
    # Literals keep an inert null owner; dynamic construction retains one
    # opaque runtime owner without exposing its layout.
    pub func string_type() -> TypeId:
        return self.buffer_value_type()

    pub func bytes_type() -> TypeId:
        return self.buffer_value_type()

    func buffer_value_type() -> TypeId:
        let fields = [
            builtin_mir_type(BuiltinMirType.buffer_owner),
            builtin_mir_type(BuiltinMirType.pointer),
            builtin_mir_type(BuiltinMirType.unsigned_u64),
        ]
        return self.intern_lowered_type(make_struct_type(fields))

    pub func is_buffer_mir_type(value_type: TypeId) -> bool:
        match mir_type(self.types, value_type):
            Struct(fields):
                if len(fields) != 3: return false
                match mir_type(self.types, fields[0].value_type):
                    BufferOwner: pass
                    else: return false
                if not is_ptr_type(self.types, fields[1].value_type): return false
                return fields[2].value_type.value == builtin_mir_type(BuiltinMirType.unsigned_u64).value
            else: return false

    pub func buffer_owner_field() -> i64: return 0
    pub func buffer_data_field() -> i64: return 1
    pub func buffer_length_field() -> i64: return 2

    pub func fallible_inner(value: ir.TypeId) -> ir.TypeId?:
        if i64(value.value) >= len(self.program.types.definitions): return none
        match self.program.types.definitions[value.value].form:
            Fallible(inner): return inner
            else: return none

    # mark: Diagnostics =========================================================================

    # Fail at the unsupported node while still naming its enclosing function.
    # Example: a binding on line 2 reports line 2, not the function's line 1.
    pub func fail_unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> !:
        error(self.unsupported(module, function, span, feature))

    pub func unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> str:
        return format_diagnostic(
            module.path,
            span,
            "lowerer does not support " + feature + " yet in `" + module.name + "." + function.name + "`",
        )

# mark: Function lowering services =============================================================

## One ascending `u64` counter loop under construction. `index` is the value
## loaded at the top of the current iteration; `done` is `index >= limit`.
pub struct CountedLoop:
    pub let counter: RegisterId
    pub let index: RegisterId
    pub let done: RegisterId
    pub let opened_block: bool

## The emission services `FunctionLowerer` lends to the profile lowerer. A
## profile consumer writes into the same function transaction through these
## and never imports the lowerer, so the dependency runs one way.
pub interface FunctionLoweringHost:
    func begin_counted_loop(start: RegisterId, limit: RegisterId, results: list[RegisterId], span: SourceSpan, body: list[MirInstruction]) -> CountedLoop
    func begin_counted_loop_body(start: RegisterId, limit: RegisterId, opened_block: bool, span: SourceSpan, body: list[MirInstruction]) -> CountedLoop
    func begin_function()
    func bool_constant(value: bool, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func element_address(element_type: TypeId, base: RegisterId, index: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func emit_call(target: i64, results: list[RegisterId], arguments: list[RegisterId], span: SourceSpan, body: list[MirInstruction])
    func emit_deferred_from(module: HirModule, function: HirFunction, start: i64, body: list[MirInstruction]) -> !
    func emit_else(span: SourceSpan, body: list[MirInstruction])
    func emit_end(span: SourceSpan, body: list[MirInstruction])
    func emit_ownership_at(value_type: TypeId, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction])
    func emit_ownership_call(value_type: TypeId, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction])
    func emit_temporaries_from(start: i64, body: list[MirInstruction]) -> !
    func emit_yield(value: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func end_counted_loop(loop: CountedLoop, span: SourceSpan, body: list[MirInstruction])
    func error_is_present(error_value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func exit_counted_loop_when_done(loop: CountedLoop, values: list[RegisterId], span: SourceSpan, body: list[MirInstruction])
    func function_null(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func initialize_owned_copy(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func initialize_owned_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func initialize_ownership_at(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func integer_constant(value_type: TypeId, value: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func is_aggregate(value_type: TypeId) -> bool
    func load_field(struct_type: TypeId, base: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!
    func load_present(base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func load_value(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func lower_aggregate_comparison(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!
    func lower_equality_definition(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!
    func lower_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!
    func lower_function_value_signature(module: HirModule, function: HirFunction, span: SourceSpan, function_type: ir.TypeId) -> MirSignature!
    func lower_mutable_place_address(module: HirModule, function: HirFunction, value: NodeId, body: list[MirInstruction]) -> RegisterId!
    func lower_nested_equality(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId, body: list[MirInstruction]) -> RegisterId!
    func lower_placed_arguments(module: HirModule, function: HirFunction, called: HirFunction, arguments: Operands, body: list[MirInstruction]) -> list[RegisterId]!
    func lower_scope(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !
    func lower_structural_hash(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!
    func new_temp(value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func null_constant(span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func open_if(condition: RegisterId, results: list[RegisterId], span: SourceSpan, body: list[MirInstruction])
    func ownership_helper_for(value_type: TypeId) -> OwnershipHelper
    func payload_address(enum_type: TypeId, base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
    func place_call_result(module: HirModule, function: HirFunction, span: SourceSpan, result: ir.TypeId, returns_never: bool, call_arguments: list[RegisterId], results: list[RegisterId], body: list[MirInstruction]) -> RegisterId!
    func replace_owned_copy(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func store_optional_tag(base: RegisterId, tag: i64, span: SourceSpan, body: list[MirInstruction])
    func store_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction])
    func take_owned_value(value: RegisterId) -> bool
    func type_needs_ownership(value_type: TypeId) -> bool
    func typed_null_constant(value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId
