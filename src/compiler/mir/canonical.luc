#==============================================================================================
#
#   canonical_ir - The machine representation every compiled backend consumes
#
#   DESCRIPTION:
#       Canonical MIR is the program as a machine sees it: typed write-once
#       registers, explicit memory, structured control flow, and explicit
#       runtime services. The lowerer produces it from typed HIR; the verifier
#       proves its rules; the optimizer transforms it; every compiled backend
#       translates it and never reinterprets it. The design and the reasons
#       behind each decision are in `docs/compiler/mir.md`; this file is the
#       code that follows from that page, in the same order:
#
#       types -> identities -> instructions -> functions, externs, globals,
#       data -> the program -> the runtime symbol table
#
#       Three rules shape everything here. A register is written once, so its
#       type is fixed at its definition. Anything with more than one part
#       lives in memory, addressed through `Ptr`. Control flow is a nest of
#       regions (`Block`, `Loop`, `If`, `Switch`) left by depth-relative
#       branches, never a jump to a label.
#
#==============================================================================================

from compiler.frontend.source import SourceSpan
from compiler.runtime_contract import RuntimeService

# mark: Types ==================================================================================

## The identity of one type in `MirTypeTable.definitions`.
pub struct TypeId:
    pub let value: u32

## One struct field in declaration order. Byte placement is a backend fact.
pub struct MirField:
    pub let value_type: TypeId

## The identity of one nominal class payload in `MirProgram.classes`.
## Keeping it separate from `TypeId` makes nominal identity explicit while
## allowing strong and weak handles to name the same source class.
pub struct ClassId:
    pub let value: u32

## A source interface's nominal identity in `MirProgram.interfaces`.
pub struct InterfaceId:
    pub let value: u32

## One exact concrete implementation table in `MirProgram.conformances`.
pub struct ConformanceId:
    pub let value: u32

## A function's shape as a caller sees it. A fallible function receives a
## caller-owned error slot as parameter 0 and returns that pointer as its last
## result on failure, or null on success. The slot makes the error outlive the
## callee's frame without allocating or hiding ownership in the runtime.
## `returns_never` distinguishes an absent successful result from `unit`; a
## fallible diverging function may still return its failure pointer.
pub struct MirSignature:
    pub let parameters: list[TypeId]
    pub let results: list[TypeId]
    pub let is_fallible: bool
    pub let returns_never: bool

## A task's successful result is part of the handle's canonical type. Unit and
## never both have no value representation, but they are not interchangeable:
## a unit worker can complete successfully while a never worker cannot.
pub union MirTaskResult:
    Unit
    Never
    Value(value_type: TypeId)

## Target-neutral storage types. Scalars, abstract pointers, and typed
## reference handles live in registers; aggregates live in memory. Backends
## compute byte layout and legalize a `List` handle to their pointer shape.
pub union MirType:
    Int(bits: i64, is_signed: bool)
    Float(bits: i64)
    Bool
    ## Zero-size, uninhabited element marker for containers such as the
    ## successful empty result of `wait_all(list[task[never]])`. It never
    ## occupies a register and does not represent source `unit`.
    Uninhabited
    Ptr
    ## Opaque ownership identity for immutable string/byte storage. It is
    ## pointer-shaped only after backend legalization and is never address
    ## authority.
    BufferOwner
    ## Opaque, uniquely owned mutable state used only while assembling an
    ## immutable text/byte buffer. It is pointer-shaped after legalization but
    ## cannot be used as address authority or confused with a frozen owner.
    BufferBuilder
    List(element: TypeId)
    ## Immutable collection snapshots are distinct semantic handles. They
    ## permit read-only traversal and structural equality/hash, but no
    ## identity comparison or shape mutation.
    FrozenList(element: TypeId)
    ## Opaque insertion-ordered hash collection identities. Probing and
    ## physical tables begin in the sealed runtime/backend boundary.
    Map(key: TypeId, value: TypeId)
    Set(element: TypeId)
    FrozenMap(key: TypeId, value: TypeId)
    FrozenSet(element: TypeId)
    Slice(element: TypeId)
    ## Opaque callback-scoped mutable sequence view. It is register-shaped
    ## but prohibited from every storage/result boundary by the verifier.
    MutableSlice(element: TypeId)
    ## A locally scoped handle into one invocation's structured task group.
    ## The handle itself is non-owning; the group keeps every child record
    ## alive until `TaskGroupFinish`.
    ## Every task may also report the language's canonical Error value for a
    ## worker failure, trap, or cancellation. Retaining that structural type
    ## is necessary when a backend copies failure data between isolated
    ## domains; a raw caller-owned pointer carries no such information.
    Task(result: MirTaskResult, failure_type: TypeId)
    ## Compiler-internal owner for children spawned by one invocation. Source
    ## types and signatures can never name this handle.
    TaskGroup
    ## An owning, non-null identity handle. Its payload schema lives in the
    ## program's class table; only a backend chooses the handle's pointer shape.
    Class(identity: ClassId)
    ## A non-owning slot for the same nominal identity. Promotion is an atomic
    ## semantic operation and never exposes a nullable class value to source.
    WeakClass(identity: ClassId)
    ## One managed existential identity. Payload and witness layout remain
    ## private to the runtime/backend boundary.
    Interface(identity: InterfaceId)
    ## One ARC-managed mutable box shared by closure environments.
    Cell(element: TypeId)
    Struct(fields: list[MirField])
    Array(element: TypeId, count: i64)
    Enum(tag: TypeId, cases: list[TypeId])
    Func(signature: MirSignature)

## Every type a program uses. Scalars occupy fixed leading slots (see
## `BuiltinMirType`); the lowerer interns aggregates after them.
pub struct MirTypeTable:
    pub let definitions: list[MirType]

## The scalar types with stable identities, in table order.
pub enum BuiltinMirType:
    signed_i8
    signed_i16
    signed_i32
    signed_i64
    unsigned_u8
    unsigned_u16
    unsigned_u32
    unsigned_u64
    float16
    float32
    float64
    boolean
    pointer
    buffer_owner

pub func builtin_mir_type(value: BuiltinMirType) -> TypeId:
    return match value:
        signed_i8 => TypeId(value = 0)
        signed_i16 => TypeId(value = 1)
        signed_i32 => TypeId(value = 2)
        signed_i64 => TypeId(value = 3)
        unsigned_u8 => TypeId(value = 4)
        unsigned_u16 => TypeId(value = 5)
        unsigned_u32 => TypeId(value = 6)
        unsigned_u64 => TypeId(value = 7)
        float16 => TypeId(value = 8)
        float32 => TypeId(value = 9)
        float64 => TypeId(value = 10)
        boolean => TypeId(value = 11)
        pointer => TypeId(value = 12)
        buffer_owner => TypeId(value = 13)

## The type table every program starts from: thirteen semantic scalars and one
## target-neutral ownership handle. Transient builder handles are interned
## only by programs that assemble buffers.
pub func create_builtin_mir_types() -> MirTypeTable:
    let definitions = list[MirType]()
    definitions.append(MirType.Int(bits = 8, is_signed = true))
    definitions.append(MirType.Int(bits = 16, is_signed = true))
    definitions.append(MirType.Int(bits = 32, is_signed = true))
    definitions.append(MirType.Int(bits = 64, is_signed = true))
    definitions.append(MirType.Int(bits = 8, is_signed = false))
    definitions.append(MirType.Int(bits = 16, is_signed = false))
    definitions.append(MirType.Int(bits = 32, is_signed = false))
    definitions.append(MirType.Int(bits = 64, is_signed = false))
    definitions.append(MirType.Float(bits = 16))
    definitions.append(MirType.Float(bits = 32))
    definitions.append(MirType.Float(bits = 64))
    definitions.append(MirType.Bool)
    definitions.append(MirType.Ptr)
    definitions.append(MirType.BufferOwner)
    return MirTypeTable(definitions = definitions)

## Look one type up; an identity outside the table is a compiler bug.
pub func mir_type(types: MirTypeTable, id: TypeId) -> MirType:
    if i64(id.value) >= len(types.definitions): trap("MIR type identity is outside the type table")
    return types.definitions[id.value]

## Add a type unless a structurally identical one exists; return its identity.
pub func intern_mir_type(types: MirTypeTable, value: MirType) -> TypeId:
    for index in range(0, len(types.definitions)):
        if mir_types_match(types.definitions[index], value): return TypeId(value = u32(index))
    types.definitions.append(value)
    return TypeId(value = u32(len(types.definitions) - 1))

## Structural equality of two type definitions.
pub func mir_types_match(left: MirType, right: MirType) -> bool:
    match left:
        Int(bits, is_signed):
            match right:
                Int(other_bits, other_signed): return bits == other_bits and is_signed == other_signed
                else: return false
        Float(bits):
            match right:
                Float(other_bits): return bits == other_bits
                else: return false
        Bool:
            match right:
                Bool: return true
                else: return false
        Uninhabited:
            match right:
                Uninhabited: return true
                else: return false
        Ptr:
            match right:
                Ptr: return true
                else: return false
        BufferOwner:
            match right:
                BufferOwner: return true
                else: return false
        BufferBuilder:
            match right:
                BufferBuilder: return true
                else: return false
        List(element):
            match right:
                List(other_element): return element.value == other_element.value
                else: return false
        FrozenList(element):
            match right:
                FrozenList(other_element): return element.value == other_element.value
                else: return false
        Map(key, value):
            match right:
                Map(other_key, other_value): return key.value == other_key.value and value.value == other_value.value
                else: return false
        Set(element):
            match right:
                Set(other_element): return element.value == other_element.value
                else: return false
        FrozenMap(key, value):
            match right:
                FrozenMap(other_key, other_value): return key.value == other_key.value and value.value == other_value.value
                else: return false
        FrozenSet(element):
            match right:
                FrozenSet(other_element): return element.value == other_element.value
                else: return false
        Slice(element):
            match right:
                Slice(other_element): return element.value == other_element.value
                else: return false
        MutableSlice(element):
            match right:
                MutableSlice(other_element): return element.value == other_element.value
                else: return false
        Task(result, failure_type):
            match right:
                Task(other_result, other_failure): return task_results_match(result, other_result) and failure_type.value == other_failure.value
                else: return false
        TaskGroup:
            match right:
                TaskGroup: return true
                else: return false
        Class(identity):
            match right:
                Class(other_identity): return identity.value == other_identity.value
                else: return false
        WeakClass(identity):
            match right:
                WeakClass(other_identity): return identity.value == other_identity.value
                else: return false
        Interface(identity):
            match right:
                Interface(other_identity): return identity.value == other_identity.value
                else: return false
        Cell(element):
            match right:
                Cell(other_element): return element.value == other_element.value
                else: return false
        Struct(fields):
            match right:
                Struct(other_fields):
                    if len(fields) != len(other_fields): return false
                    for index in range(0, len(fields)):
                        if fields[index].value_type.value != other_fields[index].value_type.value: return false
                    return true
                else: return false
        Array(element, count):
            match right:
                Array(other_element, other_count): return element.value == other_element.value and count == other_count
                else: return false
        Enum(tag, cases):
            match right:
                Enum(other_tag, other_cases):
                    if tag.value != other_tag.value or len(cases) != len(other_cases): return false
                    for index in range(0, len(cases)):
                        if cases[index].value != other_cases[index].value: return false
                    return true
                else: return false
        Func(signature):
            match right:
                Func(other_signature): return signatures_match(signature, other_signature)
                else: return false

func task_results_match(left: MirTaskResult, right: MirTaskResult) -> bool:
    match left:
        Unit:
            match right:
                Unit: return true
                else: return false
        Never:
            match right:
                Never: return true
                else: return false
        Value(value_type):
            match right:
                Value(other_type): return value_type.value == other_type.value
                else: return false

pub func signatures_match(left: MirSignature, right: MirSignature) -> bool:
    if left.is_fallible != right.is_fallible: return false
    if left.returns_never != right.returns_never: return false
    if len(left.parameters) != len(right.parameters) or len(left.results) != len(right.results): return false
    for index in range(0, len(left.parameters)):
        if left.parameters[index].value != right.parameters[index].value: return false
    for index in range(0, len(left.results)):
        if left.results[index].value != right.results[index].value: return false
    return true

## Construct a structural aggregate without choosing its byte layout.
pub func make_struct_type(field_types: list[TypeId]) -> MirType:
    let fields = list[MirField]()
    for field_type in field_types:
        fields.append(MirField(value_type = field_type))
    return MirType.Struct(fields = fields)

## Construct a structural enum. Backends place the payload after its tag.
pub func make_enum_type(tag: TypeId, cases: list[TypeId]) -> MirType:
    return MirType.Enum(tag = tag, cases = cases)

# mark: Type predicates ========================================================================

pub func is_int_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Int(bits, is_signed): return true
        else: return false

pub func is_signed_int_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Int(bits, is_signed): return is_signed
        else: return false

pub func is_float_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Float(bits): return true
        else: return false

pub func is_bool_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Bool: return true
        else: return false

pub func is_ptr_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Ptr: return true
        else: return false

## Values represented by backend pointers but not interchangeable in
## canonical MIR. Raw `Ptr` is address authority; the remaining cases are
## typed language/runtime references that cannot be interchanged with it.
pub func is_reference_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Ptr: return true
        BufferOwner: return true
        BufferBuilder: return true
        List(element): return true
        FrozenList(element): return true
        Map(key, value): return true
        Set(element): return true
        FrozenMap(key, value): return true
        FrozenSet(element): return true
        Slice(element): return true
        MutableSlice(element): return true
        Task(result, failure_type): return true
        TaskGroup: return true
        Class(identity): return true
        WeakClass(identity): return true
        Interface(identity): return true
        Cell(element): return true
        else: return false

## Canonical handles whose identity is itself an observable semantic value.
## Slices are reference-shaped for backend legalization but represent views,
## so comparing their handle addresses would expose an implementation detail.
pub func is_identity_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Ptr: return true
        List(element): return true
        Map(key, value): return true
        Set(element): return true
        Class(identity): return true
        else: return false

## Values whose canonical register representation is an address to storage.
pub func is_aggregate_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Struct(fields): return true
        Array(element, count): return true
        Enum(tag, cases): return true
        Func(signature): return true
        else: return false

## True only for the canonical `{owner, data, length}` representation shared
## by immutable strings and bytes. Consumers ask this semantic question here
## instead of independently recognizing one structural runtime protocol.
pub func is_buffer_value_type(types: MirTypeTable, id: TypeId) -> bool:
    match mir_type(types, id):
        Struct(fields):
            if len(fields) != 3: return false
            match mir_type(types, fields[0].value_type):
                BufferOwner: pass
                else: return false
            match mir_type(types, fields[1].value_type):
                Ptr: pass
                else: return false
            return fields[2].value_type.value == builtin_mir_type(BuiltinMirType.unsigned_u64).value
        else: return false

pub func is_numeric_mir_type(types: MirTypeTable, id: TypeId) -> bool:
    return is_int_type(types, id) or is_float_type(types, id)

## Bit width of an integer or float type; 0 for anything else.
pub func bits_of(types: MirTypeTable, id: TypeId) -> i64:
    match mir_type(types, id):
        Int(bits, is_signed): return bits
        Float(bits): return bits
        else: return 0

## Inclusive bounds of a signed integer type.
pub func int_minimum(types: MirTypeTable, id: TypeId) -> i64:
    match mir_type(types, id):
        Int(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return -128
            if bits == 16: return -32768
            if bits == 32: return -2147483647 - 1
            return -9223372036854775807 - 1
        else: return 0

pub func int_maximum(types: MirTypeTable, id: TypeId) -> i64:
    match mir_type(types, id):
        Int(bits, is_signed):
            if not is_signed: return 0
            if bits == 8: return 127
            if bits == 16: return 32767
            if bits == 32: return 2147483647
            return 9223372036854775807
        else: return 0

## Inclusive maximum of an unsigned integer type. This is a separate domain
## so canonical MIR can represent all of `u64` without disguising its top bit
## as a negative signed value.
pub func uint_maximum(types: MirTypeTable, id: TypeId) -> u64:
    match mir_type(types, id):
        Int(bits, is_signed):
            if is_signed: return u64(0)
            if bits == 8: return u64(255)
            if bits == 16: return u64(65535)
            if bits == 32: return u64(4294967295)
            return u64(18446744073709551615)
        else: return u64(0)

## Diagnostic spelling of a type. Semantic decisions compare identities and
## inspect `MirType`; this string is for messages.
pub func describe_mir_type(types: MirTypeTable, id: TypeId) -> str:
    let path = list[bool]()
    for index in range(0, len(types.definitions)): path.append(false)
    return describe_mir_type_on_path(types, id, path)

func describe_mir_type_on_path(types: MirTypeTable, id: TypeId, path: list[bool]) -> str:
    if i64(id.value) >= len(types.definitions): return "type#" + str(id.value)
    if path[id.value]: return "type#" + str(id.value)
    let nested = list[bool]()
    for item in path: nested.append(item)
    nested[id.value] = true
    match mir_type(types, id):
        Int(bits, is_signed):
            if is_signed: return "i" + str(bits)
            return "u" + str(bits)
        Float(bits): return "f" + str(bits)
        Bool: return "bool"
        Uninhabited: return "never"
        Ptr: return "ptr"
        BufferOwner: return "buffer-owner"
        BufferBuilder: return "buffer-builder"
        List(element): return "list[" + describe_mir_type_on_path(types, element, nested) + "]"
        FrozenList(element): return "frozen-list[" + describe_mir_type_on_path(types, element, nested) + "]"
        Map(key, value): return "map[" + describe_mir_type_on_path(types, key, nested) + ", " + describe_mir_type_on_path(types, value, nested) + "]"
        Set(element): return "set[" + describe_mir_type_on_path(types, element, nested) + "]"
        FrozenMap(key, value): return "frozen-map[" + describe_mir_type_on_path(types, key, nested) + ", " + describe_mir_type_on_path(types, value, nested) + "]"
        FrozenSet(element): return "frozen-set[" + describe_mir_type_on_path(types, element, nested) + "]"
        Slice(element): return "slice[" + describe_mir_type_on_path(types, element, nested) + "]"
        MutableSlice(element): return "mutable-slice[" + describe_mir_type_on_path(types, element, nested) + "]"
        Task(result, failure_type):
            match result:
                Unit: return "task[unit]"
                Never: return "task[never]"
                Value(value_type): return "task[" + describe_mir_type_on_path(types, value_type, nested) + "]"
        TaskGroup: return "task-group"
        Class(identity): return "class#" + str(identity.value)
        WeakClass(identity): return "weak-class#" + str(identity.value)
        Interface(identity): return "interface#" + str(identity.value)
        Cell(element): return "cell[" + describe_mir_type_on_path(types, element, nested) + "]"
        Struct(fields):
            var text = "{"
            for index in range(0, len(fields)):
                if index > 0: text = text + ", "
                text = text + describe_mir_type_on_path(types, fields[index].value_type, nested)
            return text + "}"
        Array(element, count): return "[" + describe_mir_type_on_path(types, element, nested) + "; " + str(count) + "]"
        Enum(tag, cases):
            var text = "enum(" + describe_mir_type_on_path(types, tag, nested)
            for case_type in cases:
                text = text + " | " + describe_mir_type_on_path(types, case_type, nested)
            return text + ")"
        Func(signature): return "func" + describe_signature_on_path(types, signature, nested)

pub func describe_signature(types: MirTypeTable, signature: MirSignature) -> str:
    let path = list[bool]()
    for index in range(0, len(types.definitions)): path.append(false)
    return describe_signature_on_path(types, signature, path)

func describe_signature_on_path(types: MirTypeTable, signature: MirSignature, path: list[bool]) -> str:
    var text = "("
    for index in range(0, len(signature.parameters)):
        if index > 0: text = text + ", "
        text = text + describe_mir_type_on_path(types, signature.parameters[index], path)
    text = text + ") -> ("
    for index in range(0, len(signature.results)):
        if index > 0: text = text + ", "
        text = text + describe_mir_type_on_path(types, signature.results[index], path)
    text = text + ")"
    if signature.returns_never: text = text + " never"
    if signature.is_fallible: text = text + "!"
    return text

# mark: Identities =============================================================================
#
# Everything a program contains is numbered. Names survive only for artifacts
# and diagnostics; an instruction never resolves a string.

pub struct RegisterId:
    pub let value: u32

## The register a unit-valued expression "produces": no register at all.
pub let no_register: u32 = 4294967295

## A run of `count` registers starting at `start` in `MirFunction.operands`:
## a call's arguments or results, a region's results, a branch's values. An
## instruction is then a fixed-size value with no list of its own.
pub struct RegisterRun:
    pub let start: u32
    pub let count: u32

pub func no_registers() -> RegisterRun:
    return RegisterRun(start = 0, count = 0)

## Register `index` of a run in a function's operand table.
pub func register_at(function: MirFunction, run: RegisterRun, index: i64) -> RegisterId:
    return RegisterId(value = function.operands[i64(run.start) + index])

## A run as a list, for consumers that read it more than once.
pub func registers_of(function: MirFunction, run: RegisterRun) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in range(0, i64(run.count)): registers.append(register_at(function, run, index))
    return registers

## One value copied into an isolated worker domain. `value_type` preserves the
## source value shape after ordinary call lowering has represented an
## aggregate argument by address. Without it, a backend could see only `Ptr`
## and could neither prove nor perform the required structural copy.
pub struct MirTransfer:
    pub let value: RegisterId
    pub let value_type: TypeId

## A contiguous run in `MirFunction.transfers`. Task spawn is the only current
## consumer; keeping the side table function-local preserves fixed-size
## instructions and makes register ownership unambiguous.
pub struct TransferRun:
    pub let start: u32
    pub let count: u32

pub func transfer_at(function: MirFunction, run: TransferRun, index: i64) -> MirTransfer:
    return function.transfers[i64(run.start) + index]

## Collects a function's operand table while its body is built: `run`
## appends the registers and returns where they landed. Typed worker transfers
## have their own parallel arena because aggregate call operands are pointers.
pub class OperandBuilder:
    pub let operands: list[u32]
    pub let transfers: list[MirTransfer]

    pub init():
        self.operands = list[u32]()
        self.transfers = list[MirTransfer]()

    pub func run(registers: list[RegisterId]) -> RegisterRun:
        let start = len(self.operands)
        for register in registers: self.operands.append(register.value)
        return RegisterRun(start = u32(start), count = u32(len(registers)))

    pub func transfer_run(values: list[RegisterId], value_types: list[TypeId]) -> TransferRun:
        if len(values) != len(value_types): trap("MIR transfer values and types have different lengths")
        let start = len(self.transfers)
        for index in range(0, len(values)):
            self.transfers.append(MirTransfer(value = values[index], value_type = value_types[index]))
        return TransferRun(start = u32(start), count = u32(len(values)))

pub struct FunctionId:
    pub let value: u32

pub struct ClosureId:
    pub let value: u32

## One field in a class payload, in declaration order. Weak source fields use
## a `WeakClass` storage type rather than the source-visible optional class
## type; all other fields use their ordinary canonical MIR type.
pub struct MirClassField:
    pub let storage_type: TypeId

## Target-neutral metadata for one nominal identity. The generated destroyer
## receives `(class, initialized)`; it runs source `deinit` only for a fully
## initialized object, then releases every payload field in reverse order.
pub struct MirClass:
    ## Source identity retained for target-neutral diagnostics and resource
    ## reports. It does not participate in layout or code generation.
    pub let name: str
    pub let fields: list[MirClassField]
    pub let destroyer: FunctionId

## One normalized dynamic requirement. `signature` includes an erased `Ptr`
## receiver at the ordinary source-receiver position; every witness thunk for
## this requirement therefore has exactly the same canonical call shape.
pub struct MirInterfaceRequirement:
    pub let signature: MirSignature
    pub let is_mutating: bool

## Nominal interface metadata in source requirement order.
pub struct MirInterface:
    pub let requirements: list[MirInterfaceRequirement]

## One concrete witness table. Implementations are normalized MIR thunks in
## interface requirement order; structural helpers own the erased payload.
pub struct MirConformance:
    pub let interface_id: InterfaceId
    pub let value_type: TypeId
    pub let implementations: list[FunctionId]
    pub let retain: FunctionId
    pub let release: FunctionId

## One anonymous-function environment. Its hidden body receives the opaque
## environment handle before source-visible call parameters.
pub struct MirClosure:
    pub let function: FunctionId
    ## The invocation shape visible through the source `func` value. The
    ## hidden function inserts one environment parameter immediately after
    ## the fallible error slot (or first for an infallible call).
    pub let signature: MirSignature
    pub let captures: list[MirField]
    pub let destroyer: FunctionId

## A semantic service supplied by the sealed Luce runtime. The binding is an
## ordinary MIR function identity: optimizers can follow and remap it without
## resolving a source or linker name, while backends still receive the exact
## implementation chosen during runtime composition.
pub struct MirRuntimeBinding:
    pub let service: RuntimeService
    pub let function: FunctionId

## The language-level process boundary after source entry selection. The
## function keeps its ordinary fallible `(slice[str]) -> i32!` MIR signature;
## backends use this metadata to construct the argument slice and dispose of
## both argument and failure values without placing a host ABI in MIR.
pub struct MirProcessEntry:
    pub let function: FunctionId
    pub let arguments_type: TypeId
    pub let element_retain: FunctionId
    pub let element_release: FunctionId
    pub let failure_type: TypeId
    pub let failure_release: FunctionId

pub struct ExternId:
    pub let value: u32

pub struct GlobalId:
    pub let value: u32

pub struct ExternalGlobalId:
    pub let value: u32

pub struct DataId:
    pub let value: u32

# mark: Instructions ===========================================================================

## A literal placed in a register. `Null` is the absent pointer and the inert
## internal state of an ownership-bearing reference slot before initialization.
pub union MirConstant:
    SignedInt(value: i64)
    UnsignedInt(value: u64)
    Float(value: f64)
    Bool(value: bool)
    Null

## Two-operand operations. Integer arithmetic is checked: overflow, a zero
## divisor, `minimum // -1`, and an out-of-range shift count all trap
## (language section 7). `div` is floating-point only; `floor_div` and `rem`
## are integer floor division and its paired remainder.
pub enum BinaryOp:
    add
    sub
    mul
    div
    floor_div
    rem
    bit_and
    bit_or
    bit_xor
    shift_left
    shift_right
    eq
    ne
    lt
    le
    gt
    ge

pub enum UnaryOp:
    neg
    bit_not
    bool_not

## Width and representation changes, always explicit. `wrap` performs only
## physical narrowing; language-level checked construction emits its range
## guards first. `float_to_int` traps when the value does not fit;
## `float_resize` applies the language's IEEE width conversion.
pub enum ConvertOp:
    extend
    wrap
    int_reinterpret
    int_to_float
    float_to_int
    float_resize

## One instruction with its source location, stored inline in a function's
## body list. Regions do not nest in memory: `Block`, `Loop`, `If`, and
## `Switch` open a region in the flat list, `Else`/`Case`/`Default` separate
## its arms, and `End` closes it.
pub struct MirInstruction:
    pub let form: InstructionForm
    pub let span: SourceSpan

## Every instruction. `result` registers are defined by the instruction;
## every other register operand must already be defined. Regions (`Block`,
## `Loop`, `If`, `Switch`) nest; `Br` and `BrIf` name an enclosing region by
## depth, zero being the innermost, and `Yield` leaves the innermost region
## normally. A region's `results` are the registers it defines for the code
## after it, supplied by every `Br`/`Yield` that leaves it.
pub union InstructionForm:
    Const(result: RegisterId, value: MirConstant)
    Copy(result: RegisterId, source: RegisterId)
    Binary(result: RegisterId, operation: BinaryOp, left: RegisterId, right: RegisterId)
    Unary(result: RegisterId, operation: UnaryOp, operand: RegisterId)
    Convert(result: RegisterId, operation: ConvertOp, operand: RegisterId)
    ## Return one scalar's IEEE encoding in a `u64`; binary32 occupies the low
    ## 32 bits. This is a representation-neutral semantic fact used by the
    ## sealed runtime's exact decimal conversion and by structural hashing.
    ## No pointer, ABI, layout, or target representation is exposed.
    FloatBits(result: RegisterId, operand: RegisterId)
    ## One execution-local opaque mixed code for an audited address. This is a
    ## sealed-runtime seed primitive, not pointer-to-integer conversion.
    PointerHash(result: RegisterId, operand: RegisterId)
    Alloca(result: RegisterId, slot: i64)
    ## Reserve storage for `count` consecutive values. Element structure stays
    ## in MIR; only a backend may turn it into a byte count and alignment.
    AllocateStorage(result: RegisterId, element_type: TypeId, count: RegisterId)
    ## Return one typed allocation. The backend alone turns its structural
    ## element type/count into the allocator's physical byte class.
    DeallocateStorage(address: RegisterId, element_type: TypeId, count: RegisterId)
    ## One comparison-local visited-pair transaction for recursive mutable
    ## collection equality. The context is opaque; only the sealed runtime
    ## owns its storage and pair-set policy.
    EqualityContextCreate(result: RegisterId)
    EqualityContextRelease(value: RegisterId)
    ## Return true when this ordered list-identity pair was already visited;
    ## otherwise record it and return false.
    EqualityContextVisit(result: RegisterId, context: RegisterId, left: RegisterId, right: RegisterId)
    ## Maps and sets share one typed table protocol while keeping distinct MIR
    ## types. Candidate discovery is hash-only; generated MIR compares keys so
    ## the runtime never owns language value semantics.
    HashCreate(result: RegisterId)
    HashRetain(value: RegisterId)
    HashRelease(value: RegisterId, key_release: FunctionId, value_release: FunctionId)
    HashCopy(result: RegisterId, value: RegisterId, key_retain: FunctionId, value_retain: FunctionId)
    HashLength(result: RegisterId, value: RegisterId)
    HashIterationBegin(result: RegisterId, value: RegisterId)
    HashIterationEnd(value: RegisterId)
    ## Zero means no candidate; otherwise the result is entry index + 1.
    HashFindFirst(result: RegisterId, value: RegisterId, hash: RegisterId)
    HashFindNext(result: RegisterId, value: RegisterId, current: RegisterId)
    HashKeyAddress(result: RegisterId, value: RegisterId, index: RegisterId)
    HashValueAddress(result: RegisterId, value: RegisterId, index: RegisterId)
    HashInsertEntry(result: RegisterId, value: RegisterId, hash: RegisterId)
    HashRemoveEntry(value: RegisterId, index: RegisterId)
    HashClear(value: RegisterId, key_release: FunctionId, value_release: FunctionId)
    HashReserve(value: RegisterId, minimum_capacity: RegisterId)
    ## Runtime-backed reference lists remain typed opaque handles. The result
    ## register retains the element type; operations derive it from the handle
    ## so malformed MIR cannot reinterpret one list as another.
    ListCreate(result: RegisterId)
    ## Reference-count one list identity. Final release invokes the exact
    ## compiler-generated structural element destructor before reclamation.
    ListRetain(value: RegisterId)
    ListRelease(value: RegisterId, element_release: FunctionId)
    ## Copy element storage shallowly into a fresh list identity. Layout and
    ## byte movement remain backend/runtime concerns; the exact helper retains
    ## every reference nested in each copied element.
    ListCopy(result: RegisterId, value: RegisterId, element_retain: FunctionId)
    ## Concatenate two same-element lists into one fresh shallow identity.
    ListConcat(result: RegisterId, left: RegisterId, right: RegisterId, element_retain: FunctionId)
    ListLength(result: RegisterId, value: RegisterId)
    ## Enter one active traversal and capture its stable element count. The
    ## matching end is a semantic cleanup on every ordinary loop exit.
    ListIterationBegin(result: RegisterId, value: RegisterId)
    ListIterationEnd(value: RegisterId)
    ## Establish one callback-scoped mutable view after detaching any retained
    ## immutable snapshot. The view keeps list layout and pointer facts opaque.
    ListMutableSliceBegin(result: RegisterId, value: RegisterId, element_retain: FunctionId)
    MutableSliceEnd(value: RegisterId)
    MutableSliceLength(result: RegisterId, value: RegisterId)
    MutableSliceElementAddress(result: RegisterId, value: RegisterId, index: RegisterId, element_retain: FunctionId)
    ListAppendSlot(result: RegisterId, value: RegisterId, element_retain: FunctionId)
    ## Insert exposes the newly opened slot after checking `index <= length`;
    ## the caller stores the already-evaluated source value into that slot.
    ListInsertSlot(result: RegisterId, value: RegisterId, index: RegisterId, element_retain: FunctionId)
    ## Removal shifts storage after the lowerer has copied out the selected
    ## element. It independently checks `index < length` so hand-built MIR is
    ## safe without relying on a preceding address instruction.
    ListRemoveAt(value: RegisterId, index: RegisterId, element_retain: FunctionId)
    ListClear(value: RegisterId, element_release: FunctionId)
    ListReserve(value: RegisterId, minimum_capacity: RegisterId, element_retain: FunctionId)
    ## Read-only addressing never detaches snapshots; mutable addressing does.
    ListElementAddress(result: RegisterId, value: RegisterId, index: RegisterId)
    ListMutableElementAddress(result: RegisterId, value: RegisterId, index: RegisterId, element_retain: FunctionId)
    ## Capture one immutable half-open list snapshot after checked bounds.
    ListSlice(result: RegisterId, value: RegisterId, start: RegisterId, end: RegisterId)
    ## Snapshot one mutable list into a distinct immutable identity. Elements
    ## are copied in order and the exact helper retains immutable references
    ## nested in each copied value; no mutable collection can be sendable.
    ListSnapshot(result: RegisterId, value: RegisterId, element_retain: FunctionId)
    ## Immutable strings and bytes carry `{owner, data, byte_length}`. Static
    ## data has a null inert owner; dynamically produced data names one sealed
    ## runtime owner.
    BufferRetain(value: RegisterId)
    BufferRelease(value: RegisterId)
    BufferConcat(result: RegisterId, left_data: RegisterId, left_length: RegisterId, right_data: RegisterId, right_length: RegisterId)
    BufferData(result: RegisterId, owner: RegisterId)
    BufferLength(result: RegisterId, owner: RegisterId)
    ## Opaque growable construction is canonical MIR, while allocation and
    ## growth policy remain in the sealed target-neutral runtime.
    BufferBuilderCreate(result: RegisterId)
    BufferBuilderAppend(builder: RegisterId, data: RegisterId, length: RegisterId)
    BufferBuilderFinish(result: RegisterId, builder: RegisterId)
    ## Scan one non-null borrowed C string, validate its UTF-8, and copy its
    ## bytes into a fresh immutable owner before foreign storage can change.
    CStringCopy(result: RegisterId, source: RegisterId)
    DisplaySigned(result: RegisterId, value: RegisterId)
    DisplayUnsigned(result: RegisterId, value: RegisterId)
    DisplayFloat(result: RegisterId, value: RegisterId)
    DisplayCharacter(result: RegisterId, value: RegisterId)
    DisplayBoolean(result: RegisterId, value: RegisterId)
    ## Count Unicode scalar values in one verified UTF-8 string.
    StringScalarCount(result: RegisterId, data: RegisterId, length: RegisterId)
    ## Decode the scalar beginning at `offset`. Both semantic results remain
    ## explicit even when a backend legalizes the private runtime call to one
    ## packed machine value.
    StringDecode(character: RegisterId, width: RegisterId, data: RegisterId, length: RegisterId, offset: RegisterId)
    ## Capture an immutable half-open view. The slice retains `owner` when it
    ## is non-null, so the view remains valid after the source bytes value dies.
    BytesSlice(result: RegisterId, owner: RegisterId, data: RegisterId, length: RegisterId, start: RegisterId, end: RegisterId)
    SliceRetain(value: RegisterId)
    SliceRelease(value: RegisterId, element_release: FunctionId)
    SliceLength(result: RegisterId, value: RegisterId)
    SliceElementAddress(result: RegisterId, value: RegisterId, index: RegisterId)
    ## Snapshot an insertion-ordered map or set into its immutable counterpart.
    ## The frozen type preserves map-versus-set and exact key/value structure.
    HashSnapshot(result: RegisterId, value: RegisterId, key_retain: FunctionId, value_retain: FunctionId)
    ## One invocation-owned structured group. Task handles remain non-owning;
    ## every ordinary function exit finishes the group before function-scope
    ## resources are released.
    TaskGroupCreate(result: RegisterId)
    TaskGroupFinish(group: RegisterId)
    ## Begin one exact named Luce function in the group's isolated domain.
    ## Arguments are already evaluated in source order and copied immediately.
    TaskSpawn(result: RegisterId, group: RegisterId, function: FunctionId, arguments: TransferRun)
    ## Observe one task. Scalar success defines `result`; aggregate success is
    ## copied into `destination`; unit/never use neither. `failure` is null on
    ## success or names the copied Error in caller-owned `error_destination`.
    TaskWait(result: RegisterId, destination: RegisterId, failure: RegisterId, error_destination: RegisterId, task: RegisterId)
    ## Observe every handle in one `List(Task(T))`, preserving order and first
    ## failure after joining all distinct children. Success creates `List(T)`.
    TaskWaitAll(result: RegisterId, failure: RegisterId, error_destination: RegisterId, tasks: RegisterId)
    TaskCancel(task: RegisterId)
    ## Allocate one uninitialized identity. The class table supplies its
    ## payload schema and exact destroyer; the backend supplies only layout.
    ClassCreate(result: RegisterId, identity: ClassId)
    ## Arm source `deinit` after a successful initializer. Failed construction
    ## still destroys already-initialized payload fields, but skips `deinit`.
    ClassMarkInitialized(value: RegisterId)
    ClassRetain(value: RegisterId)
    ClassRelease(value: RegisterId)
    ## Address one payload field without exposing object-header representation.
    ClassFieldAddress(result: RegisterId, value: RegisterId, field: i64)
    WeakClassCreate(result: RegisterId, value: RegisterId)
    WeakClassRetain(value: RegisterId)
    WeakClassRelease(value: RegisterId)
    ## Atomically promote a weak slot into an owned source optional. The
    ## destination is caller-owned storage of `optional_type`.
    WeakClassPromote(destination: RegisterId, value: RegisterId, optional_type: TypeId)
    ## Package one concrete value behind a nominal interface. Backend
    ## legalization supplies layout and the runtime stores witness identity.
    InterfaceCreate(result: RegisterId, source: RegisterId, conformance: ConformanceId)
    InterfaceRetain(value: RegisterId)
    InterfaceRelease(value: RegisterId)
    ## Consume one reference and return a unique value wrapper before a
    ## mutating requirement. Class payloads still retain shared class identity.
    InterfaceDetach(result: RegisterId, value: RegisterId)
    InterfacePayload(result: RegisterId, value: RegisterId)
    CellCreate(result: RegisterId, element_type: TypeId, destroyer: FunctionId)
    CellMarkInitialized(value: RegisterId)
    CellRetain(value: RegisterId)
    CellRelease(value: RegisterId)
    CellValueAddress(result: RegisterId, value: RegisterId, element_type: TypeId)
    Load(result: RegisterId, value_type: TypeId, address: RegisterId)
    Store(value_type: TypeId, address: RegisterId, value: RegisterId)
    FieldAddress(result: RegisterId, struct_type: TypeId, base: RegisterId, field: i64)
    EnumPayloadAddress(result: RegisterId, enum_type: TypeId, base: RegisterId)
    ElementAddress(result: RegisterId, element_type: TypeId, base: RegisterId, index: RegisterId)
    Memcpy(destination: RegisterId, source: RegisterId, value_type: TypeId)
    ## Move `count` possibly overlapping values. Element structure survives so
    ## a backend alone computes the byte count for its host move primitive.
    MoveElements(destination: RegisterId, source: RegisterId, element_type: TypeId, count: RegisterId)
    DataAddress(result: RegisterId, data: DataId)
    GlobalAddress(result: RegisterId, global: GlobalId)
    LoadExternalGlobal(result: RegisterId, global: ExternalGlobalId)
    StoreExternalGlobal(global: ExternalGlobalId, value: RegisterId)
    FunctionAddress(result: RegisterId, function: FunctionId)
    ExternAddress(result: RegisterId, external: ExternId)
    ## Initialize or fill one ordinary-function descriptor in caller-owned
    ## storage. The canonical `Func` identity lets the verifier prove the code
    ## target's exact signature without exposing descriptor layout.
    FunctionNull(destination: RegisterId, function_type: TypeId)
    FunctionValue(destination: RegisterId, function_type: TypeId, function: FunctionId)
    ClosureCreate(environment: RegisterId, destination: RegisterId, function_type: TypeId, closure: ClosureId)
    ClosureMarkInitialized(environment: RegisterId)
    ClosureCaptureAddress(result: RegisterId, environment: RegisterId, closure: ClosureId, capture: i64)
    FunctionRetain(value: RegisterId)
    FunctionRelease(value: RegisterId)
    Call(results: RegisterRun, function: FunctionId, arguments: RegisterRun)
    CallExtern(results: RegisterRun, external: ExternId, arguments: RegisterRun)
    CallIndirect(results: RegisterRun, signature: MirSignature, convention: CallingConvention, target: RegisterId, arguments: RegisterRun)
    CallClosure(results: RegisterRun, signature: MirSignature, target: RegisterId, arguments: RegisterRun)
    CallInterface(results: RegisterRun, interface_id: InterfaceId, requirement: u32, target: RegisterId, arguments: RegisterRun)
    Block(results: RegisterRun)
    Loop
    If(condition: RegisterId, results: RegisterRun)
    Else
    Switch(tag: RegisterId)
    Case(value: i64)
    Default
    End
    Br(depth: i64, values: RegisterRun)
    BrIf(condition: RegisterId, depth: i64, values: RegisterRun)
    Yield(values: RegisterRun)
    Return(values: RegisterRun)
    Raise(failure: RegisterId)
    Trap(reason: str)
    Unreachable

# mark: Functions, externs, globals, data ======================================================

## How parameters and results travel. `luce` is the compiler's own
## convention; `c` marks exports and callbacks and admits only
## C-representable types; `runtime` names a `luce_rt_*` service.
pub enum CallingConvention:
    luce
    c
    runtime

## One stack slot reserved by `Alloca`.
pub struct MirSlot:
    pub let value_type: TypeId

## One defined function. `registers[i]` is the type of `r{i}`; parameters
## occupy the first registers in order.
pub struct MirFunction:
    pub let name: str
    pub let convention: CallingConvention
    pub let signature: MirSignature
    pub let registers: list[TypeId]
    pub let slots: list[MirSlot]
    pub let body: list[MirInstruction]
    ## The register runs the body's instructions name (see `RegisterRun`).
    pub let operands: list[u32]
    ## Typed worker-domain copies named by `TransferRun`.
    pub let transfers: list[MirTransfer]
    ## Source-package API visibility. Backends may expose a package API in
    ## their artifact model, but this is not itself a native ABI export.
    pub let is_public: bool
    ## True only when the artifact exposes this exact symbol. Source `pub`
    ## visibility remains an independent package-level fact.
    pub let is_exported: bool
    pub let span: SourceSpan

## A symbol the artifact binds from outside: a C function or a runtime service.
pub struct MirExtern:
    pub let name: str
    pub let convention: CallingConvention
    pub let signature: MirSignature

## Module-level mutable state, optionally initialised from a data item.
pub struct MirGlobal:
    pub let name: str
    pub let value_type: TypeId
    pub let initial: DataId?
    pub let is_mutable: bool

## C-owned mutable scalar storage. Unlike `MirGlobal`, this defines no bytes
## in the artifact; every access is observable and the backend binds `name` in
## its host/linker model. The value type remains target-neutral canonical MIR.
pub struct MirExternalGlobal:
    pub let name: str
    pub let value_type: TypeId

## Constant bytes. Address-bearing constants will gain a structural form when
## a language feature needs them; target-sized raw relocations do not belong
## in canonical MIR.
pub struct MirData:
    pub let name: str
    pub let bytes: list[u8]
    pub let align: i64

# mark: The program ============================================================================

## One target-neutral program. `process_entry` describes the language-level
## function a process starts in; a library or module leaves it absent.
pub struct MirProgram:
    pub let types: MirTypeTable
    pub let classes: list[MirClass]
    pub let interfaces: list[MirInterface]
    pub let conformances: list[MirConformance]
    pub let closures: list[MirClosure]
    pub let runtime_bindings: list[MirRuntimeBinding]
    pub let externs: list[MirExtern]
    pub let external_globals: list[MirExternalGlobal]
    pub let globals: list[MirGlobal]
    pub let data: list[MirData]
    pub let functions: list[MirFunction]
    pub var process_entry: MirProcessEntry?

## A valid empty program for tests and tools.
pub func create_empty_mir_program() -> MirProgram:
    return MirProgram(
        types = create_builtin_mir_types(),
        classes = list[MirClass](),
        interfaces = list[MirInterface](),
        conformances = list[MirConformance](),
        closures = list[MirClosure](),
        runtime_bindings = list[MirRuntimeBinding](),
        externs = list[MirExtern](),
        external_globals = list[MirExternalGlobal](),
        globals = list[MirGlobal](),
        data = list[MirData](),
        functions = list[MirFunction](),
        process_entry = none,
    )

## Find the exact implementation composed for one semantic runtime service.
pub func find_runtime_binding(program: MirProgram, service: RuntimeService) -> FunctionId?:
    for binding in program.runtime_bindings:
        if binding.service == service: return binding.function
    return none

pub func find_mir_function(program: MirProgram, name: str) -> i64:
    for index in range(0, len(program.functions)):
        if program.functions[index].name == name: return index
    return -1

pub func find_mir_extern(program: MirProgram, name: str) -> i64:
    for index in range(0, len(program.externs)):
        if program.externs[index].name == name: return index
    return -1

# mark: The runtime ============================================================================
#
# Runtime calls whose signatures are already target-independent use these
# symbols (language section 23.4). The lowerer declares only the ones a program
# calls as `runtime`-convention externs; the verifier checks this table and
# each backend supplies its host contract. `luce_rt_arena` is the sealed
# runtime's one provider capability: it ensures a byte prefix and returns a
# stable base without exposing capacity, pages, reservation APIs, or layout.
# Typed storage is deliberately not here: `AllocateStorage` must retain its
# element `TypeId` until a backend and must reach its composed implementation
# through `MirRuntimeBinding`.

pub struct RuntimeSymbol:
    pub let name: str
    pub let signature: MirSignature

pub func runtime_symbols() -> list[RuntimeSymbol]:
    let ptr = builtin_mir_type(BuiltinMirType.pointer)
    let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
    let none_results = list[TypeId]()
    let symbols = list[RuntimeSymbol]()
    symbols.append(RuntimeSymbol(name = "luce_rt_arena", signature = MirSignature(parameters = [u64_type], results = [ptr], is_fallible = false, returns_never = false)))
    symbols.append(RuntimeSymbol(name = "luce_rt_write", signature = MirSignature(parameters = [ptr, u64_type], results = none_results, is_fallible = false, returns_never = false)))
    symbols.append(RuntimeSymbol(name = "luce_rt_trap", signature = MirSignature(parameters = [ptr, u64_type], results = none_results, is_fallible = false, returns_never = true)))
    symbols.append(RuntimeSymbol(name = "luce_rt_retain", signature = MirSignature(parameters = [ptr], results = none_results, is_fallible = false, returns_never = false)))
    symbols.append(RuntimeSymbol(name = "luce_rt_release", signature = MirSignature(parameters = [ptr], results = none_results, is_fallible = false, returns_never = false)))
    symbols.append(RuntimeSymbol(name = "luce_rt_weak_make", signature = MirSignature(parameters = [ptr], results = [ptr], is_fallible = false, returns_never = false)))
    symbols.append(RuntimeSymbol(name = "luce_rt_weak_get", signature = MirSignature(parameters = [ptr], results = [ptr], is_fallible = false, returns_never = false)))
    return symbols

pub func find_runtime_symbol(name: str) -> RuntimeSymbol?:
    for symbol in runtime_symbols():
        if symbol.name == name: return symbol
    return none
