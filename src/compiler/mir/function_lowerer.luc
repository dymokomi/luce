#==============================================================================================
#
#   function_lowerer - One analyzed HIR function into canonical MIR
#
#   DESCRIPTION:
#       Lowers function-local statements, expressions, patterns, calls,
#       aggregates, ownership, and lexical cleanup through one shared
#       MirLoweringState. These operations remain together because they are
#       mutually recursive and must observe one register, region, local, and
#       defer transaction.
#
#       Aggregate structure and semantic operations remain target-independent.
#       No layout, ABI, object-format, linker, or platform fact is introduced
#       here; backends alone legalize canonical MIR.
#
#       This is the MIR dispatch point of the profile layout (plan.md §5.0):
#       collections, classes, closures, existential values, and workers lower
#       in `profiles/full/mir/lowering.luc`, which reaches back only through
#       the `FunctionLoweringHost` services declared in `lowering_model`.
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, DataId, FunctionId, GlobalId
from compiler.mir.canonical import ConvertOp, InstructionForm, MirConstant, MirData, MirFunction, MirInstruction
from compiler.mir.canonical import MirSignature, MirSlot, RegisterId
from compiler.mir.canonical import MirType, TypeId, UnaryOp, builtin_mir_type
from compiler.mir.canonical import OperandBuilder, bits_of, int_maximum, int_minimum, is_nullable_ptr_type, pointer_int_type, intern_mir_type, is_float_type, is_int_type, is_ptr_type, is_reference_type, is_signed_int_type, mir_type, no_register, no_registers, signature_register_type, uint_maximum
from compiler.hir.ir import AssignmentOperation, BinaryOperation, BuiltinType, HirCEnum, HirCFunction, HirFunction, HirReceiverKind, Value
from compiler.hir.ir import HirIteration, HirModule, NodeId, Operands, SymbolId, describe_type, no_node, node_children
from compiler.hir.ir import entry_at, function_body, node_at, node_diverges, node_form, node_span, node_type, resolve_builtin_type, types_match
from compiler.hir.ir import executable_function_name, place_element_step, place_field_step
import compiler.hir.ir
from compiler.mir.verifier import terminates
from compiler.frontend.source import SourceSpan
import std.strings
from compiler.mir.lowering_model import COutputSlot, DeferredAction
from compiler.mir.lowering_model import FallibleResult, IndirectOperands, Local, MatchExit, MirLoweringState, contains_symbol
from compiler.mir.lowering_model import CellStorage, CountedLoop, EqualityHelper, FunctionLoweringHost, GeneratedHelper, OwnershipHelper, RecoverTarget, Region
from compiler.profiles.full.mir.lowering import FullProfileLowerer

## Storage owned solely by one in-flight C call. String results are decoded
## before these allocations are released because a C result may alias an
## input string (for example, `strchr`).
struct CInputTemporary:
    let address: RegisterId
    let count: RegisterId

## Function-local consumer of the shared lowering transaction. A single
## instance is reused in source order; begin_function resets only active
## function state while program identities remain stable.
pub class FunctionLowerer: FunctionLoweringHost:
    let state: MirLoweringState
    ## The one dispatch point for full-Luce-only forms: collections, classes,
    ## closures, existential values, and workers (profiles/full/mir/lowering.luc).
    let full: FullProfileLowerer

    pub init(state: MirLoweringState):
        self.state = state
        self.full = FullProfileLowerer(state)

    # mark: Profile entry points ===============================================================
    #
    # Program-level lowering names these generated bodies; the profile owns
    # their shape while this lowerer remains the sole consumer it reaches.

    pub func lower_interface_witness(conformance_index: i64, requirement_index: i64) -> MirFunction!:
        return try self.full.lower_interface_witness(self, conformance_index, requirement_index)

    pub func lower_class_destroyer(class_index: i64, destroyer: FunctionId) -> MirFunction:
        return self.full.lower_class_destroyer(self, class_index, destroyer)

    pub func lower_closure_destroyer(closure_index: i64, destroyer: FunctionId) -> MirFunction:
        return self.full.lower_closure_destroyer(self, closure_index, destroyer)

    pub func lower_cell_destroyer(cell: CellStorage) -> MirFunction:
        return self.full.lower_cell_destroyer(self, cell)

    # mark: Functions ==========================================================================

    pub func lower_function(module: HirModule, function: HirFunction) -> MirFunction!:
        self.begin_function()
        let pointer = builtin_mir_type(BuiltinMirType.pointer)
        let is_fallible = self.state.fallible_inner(function.result) != none
        var successful_result = function.result
        let fallible_result = self.state.fallible_inner(function.result)
        if fallible_result != none: successful_result = fallible_result
        let returns_unit = types_match(successful_result, resolve_builtin_type(BuiltinType.unit))
        let leading = list[TypeId]()
        if function.closure != none: leading.append(pointer)
        let source_parameters = list[TypeId]()
        for parameter in function.parameters:
            source_parameters.append(try self.state.mir_type_of(module, function, function.span, parameter.value_type))
        let signature = try self.state.assemble_signature(function.result, leading, source_parameters)
        # Registers follow the assembled parameter order: error slot, closure
        # environment, aggregate result slot, then the source parameters.
        var next = 0
        var environment: RegisterId? = none
        if is_fallible:
            self.state.error_slot = i64(self.state.new_register(pointer).value)
            next += 1
        if function.closure != none:
            environment = self.state.new_register(pointer)
            next += 1
        if len(signature.parameters) - next > len(source_parameters):
            self.state.result_slot = i64(self.state.new_register(pointer).value)
            next += 1
        for index in range(0, len(source_parameters)):
            let parameter_type = signature.parameters[next + index]
            self.state.parameters.append(Local(symbol = function.parameters[index].symbol.value, address = self.state.new_register(parameter_type)))

        let body = list[MirInstruction]()
        if environment != none:
            self.full.begin_closure_environment(function, environment, body)
        let source_body = function_body(function)
        try self.lower_prologue(module, function, source_body, body)
        self.full.begin_task_group(function, body)
        self.state.scope_defer_starts.append(0)
        for position in range(0, i64(source_body.count)):
            try self.lower_statement(module, function, node_at(self.state.program, source_body, position), body)
        # MIR ends every path with a syntactic terminator. A unit function may
        # simply finish, so it gets `Return []`. A value function whose body
        # does not end in a terminator has already been proved by HirGenerator
        # to return on every path (an `if` chain whose arms all return, say);
        # the trailing `Unreachable` records that proof for the verifier.
        if not terminates(body):
            try self.emit_function_exit_cleanup(module, function, function.span, false, body)
            if returns_unit:
                if is_fallible:
                    let no_error = self.null_constant(function.span, body)
                    body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run([no_error])), span = function.span))
                else:
                    body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = function.span))
            else:
                body.append(MirInstruction(form = InstructionForm.Unreachable, span = function.span))
        self.state.scope_defer_starts.remove(len(self.state.scope_defer_starts) - 1)
        while len(self.state.defers) > 0: self.state.defers.remove(len(self.state.defers) - 1)
        # A generic method keeps its source name for member lookup, while its
        # symbol names the complete concrete specialization. Use that symbol
        # at the executable boundary so two method-argument applications on
        # the same nominal receiver remain distinct MIR functions.
        let name = executable_function_name(self.state.program, function)
        return MirFunction(
            name = name,
            convention = CallingConvention.luce,
            signature = signature,
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = function.is_public,
            is_exported = false,
            span = function.span,
        )

    pub func begin_function():
        self.state.registers = list[TypeId]()
        self.state.slots = list[MirSlot]()
        self.state.begin_locals()
        self.state.parameters = list[Local]()
        self.state.regions = list[Region]()
        self.state.defers = list[DeferredAction]()
        self.state.scope_defer_starts = list[i64]()
        self.state.loop_defer_starts = list[i64]()
        self.state.recover_targets = list[RecoverTarget]()
        self.state.operands = OperandBuilder()
        self.state.error_slot = -1
        self.state.result_slot = -1
        self.state.task_group = -1

    # mark: Ownership helpers ==================================================================

    # Reserve both identities before generating either body. Recursive value
    # shapes can then refer back through list/slice element callbacks without
    # late patching or backend discovery.
    pub func ownership_helper_for(value_type: TypeId) -> OwnershipHelper:
        let existing = self.state.ownership_helper_index(value_type)
        if existing >= 0: return self.state.ownership_helpers[existing]
        let retain = FunctionId(value = self.state.next_generated_function)
        let release = FunctionId(value = self.state.next_generated_function + 1)
        self.state.next_generated_function += 2
        let helper = OwnershipHelper(value_type = value_type, retain = retain, release = release)
        self.state.add_ownership_helper(helper)
        self.state.generated_helpers.append(GeneratedHelper.Ownership(value_type = value_type, retaining = true, function = retain))
        self.state.generated_helpers.append(GeneratedHelper.Ownership(value_type = value_type, retaining = false, function = release))
        return helper

    # Reserve before body generation so `Node -> list[Node] -> Node` closes by
    # calling the already named helper instead of recursively expanding the
    # compiler's own lowering stack.
    func equality_helper_for(module: HirModule, function: HirFunction, hir_type: ir.TypeId) -> EqualityHelper!:
        let existing = self.state.equality_helper_index(hir_type)
        if existing >= 0: return self.state.equality_helpers[existing]
        let helper = EqualityHelper(
            module = module.id,
            owner = function.symbol,
            hir_type = hir_type,
            value_type = try self.state.lower_mir_type(hir_type),
            function = FunctionId(value = self.state.next_generated_function),
        )
        self.state.next_generated_function += 1
        self.state.add_equality_helper(helper)
        self.state.generated_helpers.append(GeneratedHelper.Equality(helper = helper))
        return helper

    pub func lower_ownership_helper(value_type: TypeId, retaining: bool, identity: FunctionId) -> MirFunction:
        self.begin_function()
        let pointer = builtin_mir_type(BuiltinMirType.pointer)
        let address = self.state.new_register(pointer)
        let body = list[MirInstruction]()
        let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
        self.emit_ownership_at(value_type, address, retaining, span, body)
        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = span))
        var operation = "retain"
        if not retaining: operation = "release"
        return MirFunction(
            name = ".luce_" + operation + "_t" + str(value_type.value),
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = [pointer], results = list[TypeId](), is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = span,
        )

    pub func type_needs_ownership(value_type: TypeId) -> bool:
        match mir_type(self.state.types, value_type):
            BufferOwner: return true
            Struct(fields):
                for field in fields:
                    if self.type_needs_ownership(field.value_type): return true
                return false
            Array(element, count): return count > 0 and self.type_needs_ownership(element)
            Enum(tag, cases):
                for case_type in cases:
                    if self.type_needs_ownership(case_type): return true
                return false
            else: return self.full.type_needs_ownership(value_type)

    pub func emit_ownership_call(value_type: TypeId, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]):
        if not self.type_needs_ownership(value_type): return
        let helper = self.ownership_helper_for(value_type)
        var target = helper.retain
        if not retaining: target = helper.release
        body.append(MirInstruction(form = InstructionForm.Call(results = no_registers(), function = target, arguments = self.state.operands.run([address])), span = span))

    # Scalar collection handles travel in registers; structural values travel
    # by address. This is the single bridge from that MIR value protocol to
    # the shared address-based ownership helpers.
    func emit_value_ownership(value_type: TypeId, value: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]):
        if not self.type_needs_ownership(value_type): return
        if self.is_aggregate(value_type):
            self.emit_ownership_call(value_type, value, retaining, span, body)
            return
        match mir_type(self.state.types, value_type):
            BufferOwner:
                if retaining: body.append(MirInstruction(form = InstructionForm.BufferRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.BufferRelease(value = value), span = span))
            else:
                if not self.full.emit_value_ownership(self, value_type, value, retaining, span, body):
                    trap("managed scalar has no ownership operation")

    # Every managed expression result owns one structural reference. A value
    # copied from existing storage first retains that reference; a constructor
    # or call already produces it. Full-expression cleanup consumes any value
    # not transferred into longer-lived storage.
    func remember_owned_value(value: RegisterId, value_type: TypeId, span: SourceSpan):
        self.state.defers.append(DeferredAction.OwnedValue(value = value, value_type = value_type, span = span))

    pub func take_owned_value(value: RegisterId) -> bool:
        var index = len(self.state.defers) - 1
        while index >= 0:
            match self.state.defers[index]:
                OwnedValue(candidate, value_type, span):
                    if candidate.value == value.value:
                        self.state.defers.remove(index)
                        return true
                else: pass
            index -= 1
        return false

    # Initialize unowned storage by moving an expression's +1 when possible;
    # a raw borrowed value is retained before the byte/register copy.
    pub func initialize_owned_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if self.type_needs_ownership(value_type) and not self.take_owned_value(value):
            self.emit_value_ownership(value_type, value, true, span, body)
        self.store_value(value_type, address, value, span, body)

    # Assignment establishes the incoming +1 before dropping the old one, so
    # self-assignment and references into the destination remain valid.
    func replace_owned_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if not self.type_needs_ownership(value_type):
            self.store_value(value_type, address, value, span, body)
            return
        if not self.take_owned_value(value): self.emit_value_ownership(value_type, value, true, span, body)
        self.emit_ownership_call(value_type, address, false, span, body)
        self.store_value(value_type, address, value, span, body)

    # A conditional store cannot consume the lowerer's one compile-time
    # ownership record: only one runtime arm executes. Copy the +1 into the
    # selected storage and leave full-expression cleanup branch-independent.
    pub func initialize_owned_copy(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        self.emit_value_ownership(value_type, value, true, span, body)
        self.store_value(value_type, address, value, span, body)

    pub func replace_owned_copy(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if not self.type_needs_ownership(value_type):
            self.store_value(value_type, address, value, span, body)
            return
        self.emit_value_ownership(value_type, value, true, span, body)
        self.emit_ownership_call(value_type, address, false, span, body)
        self.store_value(value_type, address, value, span, body)

    # Recursion follows only by-value structure. List and slice handles stop
    # the walk and delegate their identity/buffer counts to the sealed runtime.
    pub func emit_ownership_at(value_type: TypeId, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]):
        match mir_type(self.state.types, value_type):
            BufferOwner:
                let value = self.load_value(value_type, address, span, body)
                if retaining: body.append(MirInstruction(form = InstructionForm.BufferRetain(value = value), span = span))
                else: body.append(MirInstruction(form = InstructionForm.BufferRelease(value = value), span = span))
            Struct(fields):
                if retaining:
                    for index in range(0, len(fields)):
                        let field = fields[index]
                        self.emit_ownership_call(field.value_type, self.field_address(value_type, address, index, span, body), true, span, body)
                else:
                    var index = len(fields) - 1
                    while index >= 0:
                        let field = fields[index]
                        self.emit_ownership_call(field.value_type, self.field_address(value_type, address, index, span, body), false, span, body)
                        index -= 1
            Array(element, count):
                if count > 0 and self.type_needs_ownership(element):
                    self.emit_array_ownership(value_type, element, count, address, retaining, span, body)
            Enum(tag, cases):
                let selected = self.load_enum_tag(value_type, address, span, body)
                for index in range(0, len(cases)):
                    let case_type = cases[index]
                    if self.type_needs_ownership(case_type):
                        let wanted = self.integer_constant(tag, index, span, body)
                        let matches = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                        body.append(MirInstruction(form = InstructionForm.Binary(result = matches, operation = BinaryOp.eq, left = selected, right = wanted), span = span))
                        self.open_if(matches, list[RegisterId](), span, body)
                        self.emit_ownership_call(case_type, self.payload_address(value_type, address, span, body), retaining, span, body)
                        self.emit_end(span, body)
            else: discard(self.full.emit_ownership_at(self, value_type, address, retaining, span, body))

    # Fresh custom-initializer storage has no source value yet. Initialize
    # only its ownership-bearing representation so ordinary field assignment
    # may replace null handles safely and a failed initializer can destroy the
    # complete partial value without target layout or a per-field bit mask.
    pub func initialize_ownership_at(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        match mir_type(self.state.types, value_type):
            BufferOwner: self.store_value(value_type, address, self.typed_null_constant(value_type, span, body), span, body)
            Struct(fields):
                for index in range(0, len(fields)):
                    let field = fields[index]
                    if self.type_needs_ownership(field.value_type):
                        self.initialize_ownership_at(field.value_type, self.field_address(value_type, address, index, span, body), span, body)
            Array(element, count):
                if count > 0 and self.type_needs_ownership(element):
                    self.initialize_array_ownership(element, count, address, span, body)
            Enum(tag, cases):
                self.store_enum_tag(value_type, address, 0, span, body)
                if len(cases) > 0 and self.type_needs_ownership(cases[0]):
                    self.initialize_ownership_at(cases[0], self.payload_address(value_type, address, span, body), span, body)
            else: discard(self.full.initialize_ownership_at(self, value_type, address, span, body))

    func initialize_array_ownership(element_type: TypeId, count: i64, address: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let loop = self.begin_counted_loop(self.integer_constant(index_type, 0, span, body), self.integer_constant(index_type, count, span, body), list[RegisterId](), span, body)
        self.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
        self.initialize_ownership_at(element_type, self.element_address(element_type, address, loop.index, span, body), span, body)
        self.end_counted_loop(loop, span, body)

    # Runtime allocation yields raw storage, while `native.store` has ordinary
    # replacement semantics so audited runtime code can update managed header
    # values without leaking their former contents. Establish an inert state
    # for every owning field before that first replacement. The element count
    # and type remain canonical MIR facts; backends still choose only layout.
    func initialize_allocated_ownership(element_type: TypeId, count: RegisterId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if not self.type_needs_ownership(element_type): return
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let loop = self.begin_counted_loop(self.integer_constant(index_type, 0, span, body), count, list[RegisterId](), span, body)
        self.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
        self.initialize_ownership_at(element_type, self.element_address(element_type, address, loop.index, span, body), span, body)
        self.end_counted_loop(loop, span, body)

    func emit_array_ownership(array_type: TypeId, element_type: TypeId, count: i64, address: RegisterId, retaining: bool, span: SourceSpan, body: list[MirInstruction]):
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let counter = self.new_temp(index_type, span, body)
        var initial = 0
        if not retaining: initial = count
        self.store_value(index_type, counter, self.integer_constant(index_type, initial, span, body), span, body)
        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        var index = self.load_value(index_type, counter, span, body)
        var boundary_value = 0
        if retaining: boundary_value = count
        let boundary = self.integer_constant(index_type, boundary_value, span, body)
        let done = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        var operation = BinaryOp.eq
        if retaining: operation = BinaryOp.ge
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = operation, left = index, right = boundary), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))
        if not retaining:
            let previous = self.state.new_register(index_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = previous, operation = BinaryOp.sub, left = index, right = self.integer_constant(index_type, 1, span, body)), span = span))
            index = previous
            self.store_value(index_type, counter, index, span, body)
        self.emit_ownership_call(element_type, self.element_address(element_type, address, index, span, body), retaining, span, body)
        if retaining:
            let next = self.state.new_register(index_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = index, right = self.integer_constant(index_type, 1, span, body)), span = span))
            self.store_value(index_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.emit_end(span, body)
        self.emit_end(span, body)

    # One target-neutral C adapter. The source body remains an ordinary
    # Luce-convention function so source calls never acquire boundary traps or
    # null encoding. Explicit exports and named cfunc conversions share it;
    # both artifact backends consume the same canonical wrapper.
    pub func lower_c_wrapper(module: HirModule, function: HirFunction, is_exported: bool) -> MirFunction!:
        self.begin_function()
        let body = list[MirInstruction]()
        let parameter_types = list[TypeId]()
        let internal_arguments = list[RegisterId]()
        for parameter in function.parameters:
            let raw_type = try self.state.c_boundary_type_of(module, function, function.span, parameter.value_type)
            parameter_types.append(raw_type)
            let raw_value = self.state.new_register(signature_register_type(self.state.types, CallingConvention.c, raw_type))
            internal_arguments.append(try self.decode_c_boundary_value(module, function, function.span, parameter.value_type, raw_value, body))

        let source_index = self.state.function_index_of(function.symbol)
        if source_index < 0: error("lowerer: C export has no source function identity")
        var internal = FunctionId(value = 0)
        match self.state.lowered_functions[source_index]:
            Defined(function_id): internal = function_id
            External(external): trap("C export mapped to an external identity")
        let results = list[TypeId]()
        if types_match(function.result, resolve_builtin_type(BuiltinType.unit)):
            body.append(MirInstruction(form = InstructionForm.Call(results = no_registers(), function = internal, arguments = self.state.operands.run(internal_arguments)), span = function.span))
            body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = function.span))
        else:
            let internal_type = try self.state.mir_type_of(module, function, function.span, function.result)
            var internal_result = RegisterId(value = no_register)
            let call_results = list[RegisterId]()
            if self.is_aggregate(internal_type):
                internal_result = self.new_temp(internal_type, function.span, body)
                let with_result = [internal_result]
                for argument in internal_arguments: with_result.append(argument)
                body.append(MirInstruction(form = InstructionForm.Call(results = no_registers(), function = internal, arguments = self.state.operands.run(with_result)), span = function.span))
            else:
                internal_result = self.state.new_register(internal_type)
                call_results.append(internal_result)
                body.append(MirInstruction(form = InstructionForm.Call(results = self.state.operands.run(call_results), function = internal, arguments = self.state.operands.run(internal_arguments)), span = function.span))
            let encoded = try self.encode_c_boundary_value(module, function, function.span, function.result, internal_result, body)
            results.append(try self.state.c_boundary_type_of(module, function, function.span, function.result))
            body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run([encoded])), span = function.span))

        var wrapper_name = function.name
        # A leading dot cannot be written as a Luce declaration name, making
        # the generated namespace collision-free without backend mangling.
        if not is_exported: wrapper_name = ".luce_cfunc_" + str(function.symbol.value)
        return MirFunction(
            name = wrapper_name,
            convention = CallingConvention.c,
            signature = MirSignature(parameters = parameter_types, results = results, is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = is_exported,
            span = function.span,
        )

    # Every binding in the body — at any nesting depth — gets its slot up
    # front, so the address registers exist before any statement runs and a
    # backend can size the frame from `slots` alone.
    func lower_prologue(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            let statement = node_at(self.state.program, statements, position)
            match node_form(self.state.program, statement):
                Binding(symbol, is_mutable, value):
                    let span = node_span(self.state.program, statement)
                    var slot_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                    if self.state.is_shared_symbol(symbol): slot_type = self.state.cell_for_symbol(symbol).cell_type
                    let slot = len(self.state.slots)
                    self.state.slots.append(MirSlot(value_type = slot_type))
                    let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                    body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
                    self.state.add_local(symbol, address)
                    try self.lower_prologue_node(module, function, value, body)
                else: try self.lower_prologue_node(module, function, statement, body)

    # Reserve slots for every binding an expression or statement introduces:
    # `for` and iterator symbols, `catch` failures, and pattern bindings, which
    # may sit inside any `match` anywhere an expression can. Nested suites go
    # back through `lower_prologue` so their `let`s get slots too; every other
    # form only contributes its children.
    func lower_prologue_node(module: HirModule, function: HirFunction, node: NodeId, body: list[MirInstruction]) -> !:
        let span = node_span(self.state.program, node)
        match node_form(self.state.program, node):
            IfStatement(branches, has_fallback, fallback):
                for branch in range(0, i64(branches.count) // 3):
                    try self.lower_prologue_node(module, function, self.branch_condition(branches, branch), body)
                    try self.lower_prologue(module, function, self.branch_body(branches, branch), body)
                if has_fallback: try self.lower_prologue(module, function, fallback, body)
            WhileStatement(condition, loop_body):
                try self.lower_prologue_node(module, function, condition, body)
                try self.lower_prologue(module, function, loop_body, body)
            ForStatement(symbol, iteration, loop_body):
                match iteration:
                    Builtin(iterable): try self.lower_prologue_node(module, function, iterable, body)
                    Protocol(iterator_symbol, iterator, next):
                        try self.reserve_slot(module, function, iterator_symbol, span, body)
                        try self.lower_prologue_node(module, function, iterator, body)
                        try self.lower_prologue_node(module, function, next, body)
                try self.reserve_slot(module, function, symbol, span, body)
                try self.lower_prologue(module, function, loop_body, body)
            Catch(value, failure, catch_body):
                try self.lower_prologue_node(module, function, value, body)
                try self.reserve_slot(module, function, failure, span, body)
                try self.lower_prologue(module, function, catch_body, body)
            MatchArm(patterns, statements, value, guard):
                for pattern_position in range(0, i64(patterns.count)):
                    match node_form(self.state.program, node_at(self.state.program, patterns, pattern_position)):
                        PatternCase(case_index, bindings):
                            for binding in range(0, i64(bindings.count)):
                                try self.reserve_slot(module, function, SymbolId(value = u32(entry_at(self.state.program, bindings, binding))), span, body)
                        else: pass
                try self.lower_prologue(module, function, statements, body)
                if value.value != no_node: try self.lower_prologue_node(module, function, value, body)
            else:
                let children = list[NodeId]()
                node_children(self.state.program, node, children)
                for child in children: try self.lower_prologue_node(module, function, child, body)

    # One slot for a binding introduced by a pattern; its type is the symbol's.
    func reserve_slot(module: HirModule, function: HirFunction, symbol: SymbolId, span: SourceSpan, body: list[MirInstruction]) -> !:
        var slot_type = try self.state.mir_type_of(module, function, span, self.state.program.symbols[symbol.value].value_type)
        if self.state.is_shared_symbol(symbol): slot_type = self.state.cell_for_symbol(symbol).cell_type
        let slot = len(self.state.slots)
        self.state.slots.append(MirSlot(value_type = slot_type))
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
        self.state.add_local(symbol, address)

    # Branch `index` of an `IfStatement`: the triple's condition and body run.
    func branch_condition(branches: Operands, index: i64) -> NodeId:
        return NodeId(value = u32(entry_at(self.state.program, branches, index * 3)))

    func branch_body(branches: Operands, index: i64) -> Operands:
        return Operands(start = u32(entry_at(self.state.program, branches, index * 3 + 1)), count = u32(entry_at(self.state.program, branches, index * 3 + 2)))

    # Append the instructions for one HIR statement. For example, `return 7`
    # emits a constant into a fresh register and returns that register.
    func lower_statement(module: HirModule, function: HirFunction, statement: NodeId, body: list[MirInstruction]) -> !:
        let temporary_start = len(self.state.defers)
        let span = node_span(self.state.program, statement)
        match node_form(self.state.program, statement):
            PrintText(value):
                try self.lower_print(value, span, body)
            PrintValue(value):
                try self.lower_print_value(module, function, value, span, body)
            ReturnStatement(value):
                if value.value == no_node:
                    try self.emit_function_exit_cleanup(module, function, span, false, body)
                    if self.state.error_slot >= 0:
                        let no_error = self.null_constant(span, body)
                        body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run([no_error])), span = span))
                    else:
                        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = span))
                    return
                let register = try self.lower_expression(module, function, value, body)
                if node_diverges(self.state.program, value):
                    return
                let returned = list[RegisterId]()
                # `return effectful_unit_call()` carries no machine value.
                # Every non-unit result still follows the ordinary direct or
                # caller-owned aggregate result path below.
                if register.value != no_register:
                    if self.state.result_slot >= 0:
                        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                        self.initialize_owned_value(value_type, RegisterId(value = u32(self.state.result_slot)), register, span, body)
                    else:
                        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                        if self.type_needs_ownership(value_type) and not self.take_owned_value(register):
                            self.emit_value_ownership(value_type, register, true, span, body)
                        returned.append(register)
                try self.emit_function_exit_cleanup(module, function, span, false, body)
                if self.state.error_slot >= 0: returned.append(self.null_constant(span, body))
                body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run(returned)), span = span))
            RecoverStatement(value):
                if len(self.state.recover_targets) == 0:
                    try self.state.fail_unsupported(module, function, span, "`recover` outside a catch handler")
                let target = self.state.recover_targets[len(self.state.recover_targets) - 1]
                let recovered = try self.lower_expression(module, function, value, body)
                # The recovered value leaves the handler as the catch result,
                # so its +1 transfers out with it instead of dying with the
                # handler's temporaries.
                if recovered.value != no_register:
                    let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                    if self.type_needs_ownership(value_type): discard(self.take_owned_value(recovered))
                try self.emit_deferred_from(module, function, target.defer_start, body)
                let values = list[RegisterId]()
                if recovered.value != no_register: values.append(recovered)
                let depth = len(self.state.regions) - 1 - target.region_index
                body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.state.operands.run(values)), span = span))
            DeferStatement(action):
                self.state.defers.append(DeferredAction.Source(statement = action))
            ErrorDeferStatement(action):
                self.state.defers.append(DeferredAction.ErrorSource(statement = action))
            Binding(symbol, is_mutable, value):
                let local = try self.state.local_of(module, function, span, symbol)
                match node_form(self.state.program, value):
                    ZeroValue:
                        # The slot takes the all-zero pattern of its type (base.md §6.1).
                        let zeroed_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                        body.append(MirInstruction(form = InstructionForm.Zero(address = local.address, value_type = zeroed_type), span = span))
                        return
                    Uninitialized: return
                    else: pass
                let register = try self.lower_expression(module, function, value, body)
                let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                if not self.full.bind_shared_cell(self, span, symbol, local.address, value_type, register, body):
                    self.initialize_owned_value(value_type, local.address, register, span, body)
                    if self.type_needs_ownership(value_type):
                        self.state.defers.append(DeferredAction.DestroyAddress(address = local.address, value_type = value_type, span = span))
            Assignment(symbol, operation, value):
                let address = try self.address_of(module, function, span, symbol, body)
                let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                try self.lower_store(module, function, span, value_type, address, operation, value, body)
            ExternStore(variable_index, operation, value):
                let global = self.state.lowered_external_globals[variable_index]
                let value_type = self.state.external_globals[global.value].value_type
                let right = try self.lower_expression(module, function, value, body)
                var stored = right
                match operation:
                    Replace: pass
                    Combine(binary):
                        let current = self.state.new_register(value_type)
                        body.append(MirInstruction(form = InstructionForm.LoadExternalGlobal(result = current, global = global), span = span))
                        stored = try self.lower_binary_operation(module, function, span, binary, value_type, current, right, body)
                body.append(MirInstruction(form = InstructionForm.StoreExternalGlobal(global = global, value = stored), span = span))
            GlobalStore(global_index, operation, value):
                let address = self.global_address(global_index, span, body)
                let value_type = self.state.globals[global_index].value_type
                try self.lower_store(module, function, span, value_type, address, operation, value, body)
            PointerStore(pointer, steps, operation, value):
                # `*p = v`, `p.field = v`: the pointee is the place's root (base.md §7.7).
                let address = try self.lower_expression(module, function, pointer, body)
                let pointee = pointee_of(self.state.program.types, node_type(self.state.program, pointer))
                try self.lower_place_store(module, function, span, address, false, pointee, steps, operation, value, body)
                return
            PlaceAssignment(symbol, steps, operation, value):
                let root_type = self.state.program.symbols[symbol.value].value_type
                let parameter = self.parameter_value(symbol)
                # A reference parameter is already its immutable handle value;
                # the place mutates storage reached through that handle, not
                # the parameter binding. Value aggregates retain their
                # caller-owned address and follow the ordinary address path.
                var root_is_reference_value = false
                if parameter != none:
                    let lowered_root = try self.state.mir_type_of(module, function, span, root_type)
                    root_is_reference_value = is_reference_type(self.state.types, lowered_root)
                if root_is_reference_value:
                    let reference_parameter = parameter else trap("reference place lost its parameter register")
                    try self.lower_place_store(module, function, span, reference_parameter, true, root_type, steps, operation, value, body)
                else:
                    try self.lower_place_store(module, function, span, try self.address_of(module, function, span, symbol, body), false, root_type, steps, operation, value, body)
            GlobalPlaceAssignment(global, steps, operation, value):
                try self.lower_place_store(module, function, span, self.global_address(global, span, body), false, self.state.program.globals[global].value_type, steps, operation, value, body)
            ExpressionStatement(value):
                let discarded = try self.lower_expression(module, function, value, body)
            IfStatement(branches, has_fallback, fallback):
                try self.lower_if(module, function, span, branches, 0, has_fallback, fallback, body)
            WhileStatement(condition, loop_body):
                try self.lower_while(module, function, span, condition, loop_body, body)
            ForStatement(symbol, iteration, loop_body):
                try self.lower_for(module, function, span, symbol, iteration, loop_body, body)
            Match(subject, arms, has_result):
                let discarded = try self.lower_match(module, function, statement, subject, arms, false, body)
            BreakStatement(levels):
                try self.emit_loop_deferred(module, function, span, levels, body)
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.break_depth(module, function, span, levels), values = no_registers()), span = span))
            ContinueStatement(levels):
                try self.emit_loop_deferred(module, function, span, levels, body)
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.continue_depth(module, function, span, levels), values = no_registers()), span = span))
            else: try self.state.fail_unsupported(module, function, span, "an expression node where a statement was expected")
        try self.emit_temporaries_from(temporary_start, body)

    # Walk one resolved target-neutral field/element path from an addressable
    # root or a direct reference-parameter value, then perform the shared store
    # protocol.
    func lower_place_store(module: HirModule, function: HirFunction, span: SourceSpan, root: RegisterId, root_is_value: bool, root_type: ir.TypeId, steps: Operands, operation: AssignmentOperation, value: NodeId, body: list[MirInstruction]) -> !:
        var address = root
        var place_type = root_type
        var weak_storage: TypeId? = none
        for position in range(0, i64(steps.count) // 2):
            let kind = u32(entry_at(self.state.program, steps, position * 2))
            let payload = entry_at(self.state.program, steps, position * 2 + 1)
            if kind == place_field_step:
                let struct_type = try self.state.mir_type_of(module, function, span, place_type)
                address = self.field_address(struct_type, address, payload, span, body)
                place_type = self.hir_field_type(place_type, payload)
            elif kind == place_element_step:
                let index = try self.lower_expression(module, function, NodeId(value = u32(payload)), body)
                var element_type = place_type
                var count = -1
                match self.state.program.types.definitions[place_type.value].form:
                    Array(element, array_count):
                        element_type = element
                        count = array_count
                    else: trap("element assignment step has a non-array HIR type")
                let mir_element = try self.state.mir_type_of(module, function, span, element_type)
                address = self.checked_element_address(mir_element, address, index, count, span, body)
                place_type = element_type
            else:
                let last_position = i64(steps.count) // 2 - 1
                match try self.full.lower_place_step(self, module, function, span, kind, payload, root, address, root_is_value, position, last_position, place_type, operation, value, body):
                    Continue(next_address, next_type):
                        address = next_address
                        place_type = next_type
                    WeakField(next_address, next_type, storage):
                        address = next_address
                        place_type = next_type
                        weak_storage = storage
                    Stored: return
        if weak_storage != none:
            match operation:
                Replace: pass
                Combine(binary): trap("weak class field has a compound assignment")
            try self.full.lower_weak_store(self, module, function, span, weak_storage, address, value, body)
            return
        let value_type = try self.state.mir_type_of(module, function, span, place_type)
        try self.lower_store(module, function, span, value_type, address, operation, value, body)

    # mark: Weak references ====================================================================

    # Store a value, or combine it with what the place holds, at an address.
    func lower_store(module: HirModule, function: HirFunction, span: SourceSpan, value_type: TypeId, address: RegisterId, operation: AssignmentOperation, value: NodeId, body: list[MirInstruction]) -> !:
        let register = try self.lower_expression(module, function, value, body)
        var stored = register
        match operation:
            Replace: stored = register
            Combine(binary):
                let current = self.state.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.Load(result = current, value_type = value_type, address = address), span = span))
                stored = try self.lower_binary_operation(module, function, span, binary, value_type, current, register, body)
        self.replace_owned_value(value_type, address, stored, span, body)

    # The address a mutable binding lives at: a local's slot, or — for `self`
    # in a mutating method — the pointer the caller passed.
    func address_of(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, body: list[MirInstruction]) -> RegisterId!:
        for parameter in self.state.parameters:
            if parameter.symbol == symbol.value:
                if is_ptr_type(self.state.types, self.state.registers[parameter.address.value]): return parameter.address
                try self.state.fail_unsupported(module, function, span, "assignment to a scalar parameter")
        let local = try self.state.local_of(module, function, span, symbol)
        let cell_address = self.full.shared_cell_address(self, function, span, symbol, local.address, body)
        if cell_address != none: return cell_address
        return local.address

    func parameter_value(symbol: SymbolId) -> RegisterId?:
        for parameter in self.state.parameters:
            if parameter.symbol == symbol.value: return parameter.address
        return none

    # The HIR type of field `field` of a struct-typed HIR value.
    func hir_field_type(value_type: ir.TypeId, field: i64) -> ir.TypeId:
        match self.state.program.types.definitions[value_type.value].form:
            Struct(index, arguments): return ir.nominal_fields(self.state.program, value_type)[field].value_type
            Class(index, arguments): return ir.nominal_fields(self.state.program, value_type)[field].value_type
            Error:
                if field == 0: return resolve_builtin_type(BuiltinType.error_code)
                if field == 1: return resolve_builtin_type(BuiltinType.string)
                trap("field of Error is out of range")
            else: trap("field of a non-struct HIR type")

    # mark: Control flow =======================================================================
    #
    # Regions are emitted in place: an opener, the arm's instructions, `Else`
    # for a second arm, and `End`. The lowerer never builds a nested list.

    pub func open_if(condition: RegisterId, results: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.If(condition = condition, results = self.state.operands.run(results)), span = span))

    pub func emit_else(span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.Else, span = span))

    pub func emit_end(span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.End, span = span))

    pub func emit_yield(value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.Yield(values = self.state.operands.run([value])), span = span))

    # `if a: ... elif b: ... else: ...` nests: branch `index` is one `If`
    # whose else-arm holds the next branch, and the last else-arm is the
    # fallback. Each arm is its own region, so registers defined inside stay
    # inside; locals reach across through their slots.
    func lower_if(module: HirModule, function: HirFunction, span: SourceSpan, branches: Operands, index: i64, has_fallback: bool, fallback: Operands, body: list[MirInstruction]) -> !:
        let condition_start = len(self.state.defers)
        let condition = try self.lower_expression(module, function, self.branch_condition(branches, index), body)
        try self.emit_temporaries_from(condition_start, body)
        self.open_if(condition, list[RegisterId](), span, body)
        try self.lower_region(module, function, Region.if_arm, self.branch_body(branches, index), body)
        if index + 1 < i64(branches.count) // 3:
            self.emit_else(span, body)
            self.state.regions.append(Region.if_arm)
            try self.lower_if(module, function, span, branches, index + 1, has_fallback, fallback, body)
            self.state.regions.remove(len(self.state.regions) - 1)
        elif has_fallback:
            self.emit_else(span, body)
            try self.lower_region(module, function, Region.if_arm, fallback, body)
        self.emit_end(span, body)

    # `while c: body` is a block around a loop. The loop re-tests `c` on
    # every pass and leaves the block when it fails; the body's last act is a
    # branch back to the loop. `break` is a branch to the block, `continue`
    # a branch to the loop; both count the regions in between.
    func lower_while(module: HirModule, function: HirFunction, span: SourceSpan, condition: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)
        let condition_start = len(self.state.defers)
        let tested = try self.lower_expression(module, function, condition, body)
        let failed = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        let condition_span = node_span(self.state.program, condition)
        body.append(MirInstruction(form = InstructionForm.Unary(result = failed, operation = UnaryOp.bool_not, operand = tested), span = condition_span))
        try self.emit_temporaries_from(condition_start, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = failed, depth = 1, values = no_registers()), span = condition_span))
        try self.lower_loop_scope(module, function, statements, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # Source iteration retains its semantic driver in HIR. Built-in sequences
    # use their canonical operations; standard protocols are already ordinary
    # resolved calls and therefore add no protocol instruction to MIR.
    func lower_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iteration: HirIteration, statements: Operands, body: list[MirInstruction]) -> !:
        match iteration:
            Builtin(iterable):
                if try self.full.lower_collection_for(self, module, function, span, symbol, iterable, statements, body): return
                match self.state.program.types.definitions[node_type(self.state.program, iterable).value].form:
                    Range(element): try self.lower_range_for(module, function, span, symbol, iterable, statements, body)
                    String: try self.lower_string_for(module, function, span, symbol, iterable, statements, body)
                    Span(element, is_const): try self.lower_span_for(module, function, span, symbol, iterable, statements, body)
                    Array(element, count): try self.lower_span_for(module, function, span, symbol, iterable, statements, body)
                    Pointer(pointee, is_const, is_volatile): try self.lower_span_for(module, function, span, symbol, iterable, statements, body)
                    StringView: try self.lower_text_for(module, function, span, symbol, iterable, statements, body)
                    else: try self.state.fail_unsupported(module, function, span, "a non-iterable built-in `for` value")
            Protocol(iterator_symbol, iterator, next):
                try self.lower_protocol_for(module, function, span, symbol, iterator_symbol, iterator, next, statements, body)

    ## Lower resolved protocol iteration entirely in terms of existing calls,
    ## optionals, ownership, and structured control. The iterator slot is one
    ## lexical owner; each successful element is a separate per-pass owner.
    func lower_protocol_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterator_symbol: SymbolId, iterator: NodeId, next: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        let cleanup_start = len(self.state.defers)
        let iterator_value = try self.lower_expression(module, function, iterator, body)
        let iterator_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, iterator))
        let iterator_address = (try self.state.local_of(module, function, span, iterator_symbol)).address
        self.initialize_owned_value(iterator_type, iterator_address, iterator_value, span, body)
        try self.emit_temporaries_from(cleanup_start, body)
        if self.type_needs_ownership(iterator_type):
            self.state.defers.append(DeferredAction.DestroyAddress(address = iterator_address, value_type = iterator_type, span = span))

        let optional_hir_type = node_type(self.state.program, next)
        var element_hir_type = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[optional_hir_type.value].form:
            Optional(element): element_hir_type = element
            else: trap("protocol iterator next expression is not optional")
        let optional_type = try self.state.mir_type_of(module, function, span, optional_hir_type)
        let element_type = try self.state.mir_type_of(module, function, span, element_hir_type)
        let element_address = (try self.state.local_of(module, function, span, symbol)).address

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)

        let next_start = len(self.state.defers)
        let optional_value = try self.lower_expression(module, function, next, body)
        let present = self.optional_present(optional_type, optional_value, span, body)
        self.open_if(present, list[RegisterId](), span, body)
        self.initialize_owned_value(element_type, element_address, self.optional_payload(optional_type, element_type, optional_value, span, body), span, body)
        self.emit_end(span, body)
        try self.emit_temporaries_from(next_start, body)
        let absent = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Unary(result = absent, operation = UnaryOp.bool_not, operand = present), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = absent, depth = 1, values = no_registers()), span = span))

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        let iteration_start = len(self.state.defers)
        if self.type_needs_ownership(element_type):
            self.state.defers.append(DeferredAction.DestroyAddress(address = element_address, value_type = element_type, span = span))
        self.state.loop_defer_starts.append(iteration_start)
        try self.lower_scope(module, function, statements, body)
        self.state.loop_defer_starts.remove(len(self.state.loop_defer_starts) - 1)
        try self.emit_deferred_from(module, function, iteration_start, body)
        while len(self.state.defers) > iteration_start: self.state.defers.remove(len(self.state.defers) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))

        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

        try self.emit_deferred_from(module, function, cleanup_start, body)
        while len(self.state.defers) > cleanup_start: self.state.defers.remove(len(self.state.defers) - 1)

    # A range loop uses its immutable iteration binding as the private
    # counter slot. The extra inner block is the `continue` target: leaving
    # it reaches the increment, while `break` crosses it, the loop, and lands
    # at the outer block. The endpoint test before increment keeps a closed
    # range ending at the integer maximum from overflowing.
    func lower_range_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        let ranged = try self.lower_expression(module, function, iterable, body)
        let range_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, iterable))
        var element_hir_type = node_type(self.state.program, iterable)
        match self.state.program.types.definitions[element_hir_type.value].form:
            Range(element): element_hir_type = element
            else: try self.state.fail_unsupported(module, function, span, "a non-range `for` iterable")
        let element_type = try self.state.mir_type_of(module, function, span, element_hir_type)
        let lower = try self.load_field(range_type, ranged, 0, span, body)
        let upper = try self.load_field(range_type, ranged, 1, span, body)
        let inclusive = try self.load_field(range_type, ranged, 2, span, body)
        let counter = (try self.state.local_of(module, function, span, symbol)).address
        self.store_value(element_type, counter, lower, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)

        let current = self.load_value(element_type, counter, span, body)
        let above = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = above, operation = BinaryOp.gt, left = current, right = upper), span = span))
        let at_or_above = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = at_or_above, operation = BinaryOp.ge, left = current, right = upper), span = span))
        let done = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(inclusive, [done], span, body)
        self.emit_yield(above, span, body)
        self.emit_else(span, body)
        self.emit_yield(at_or_above, span, body)
        self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        try self.lower_loop_scope(module, function, statements, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)

        let is_upper = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_upper, operation = BinaryOp.eq, left = current, right = upper), span = span))
        let is_last = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(inclusive, [is_last], span, body)
        self.emit_yield(is_upper, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = is_last, depth = 1, values = no_registers()), span = span))

        let one = self.state.new_register(element_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = self.integer_constant_value(element_type, 1)), span = span))
        let next = self.state.new_register(element_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = current, right = one), span = span))
        self.store_value(element_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))

        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # Walk one UTF-8 string by scalar boundary. The source expression is
    # evaluated once, and the canonical decode operation produces both the
    # language `char` and the byte width used only by traversal.
    func lower_string_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        let text = try self.lower_expression(module, function, iterable, body)
        let text_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, iterable))
        let data = try self.load_field(text_type, text, self.state.buffer_data_field(), span, body)
        let length = try self.load_field(text_type, text, self.state.buffer_length_field(), span, body)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let counter = self.new_temp(index_type, span, body)
        self.store_value(index_type, counter, self.integer_constant(index_type, 0, span, body), span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)
        let offset = self.load_value(index_type, counter, span, body)
        let done = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = offset, right = length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))

        let character_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
        let character = self.state.new_register(character_type)
        let width = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.StringDecode(character = character, width = width, data = data, length = length, offset = offset), span = span))
        let binding = (try self.state.local_of(module, function, span, symbol)).address
        self.store_value(character_type, binding, character, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        try self.lower_loop_scope(module, function, statements, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)

        let next = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = offset, right = width), span = span))
        self.store_value(index_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # Lower statements inside one new region.
    func lower_region(module: HirModule, function: HirFunction, region: Region, statements: Operands, body: list[MirInstruction]) -> !:
        self.state.regions.append(region)
        try self.lower_scope(module, function, statements, body)
        self.state.regions.remove(len(self.state.regions) - 1)

    # Lower one lexical suite and duplicate its registered cleanup calls on
    # the normal fallthrough path. Explicit exits emit the same active suffix
    # before their branch or return.
    pub func lower_scope(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        let start = len(self.state.defers)
        self.state.scope_defer_starts.append(start)
        try self.lower_scope_from(module, function, statements, start, body)
        self.state.scope_defer_starts.remove(len(self.state.scope_defer_starts) - 1)

    # Lower a suite whose active lifetime began before its first statement.
    # Match payload bindings use this form because their storage belongs to
    # the selected arm and must be destroyed with the arm's local bindings.
    func lower_scope_from(module: HirModule, function: HirFunction, statements: Operands, start: i64, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.state.program, statements, position), body)
        try self.emit_deferred_from(module, function, start, body)
        while len(self.state.defers) > start: self.state.defers.remove(len(self.state.defers) - 1)

    # A loop body is a lexical scope and the boundary for both `break` and
    # `continue`; nested suites add actions above this starting index.
    func lower_loop_scope(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        self.state.loop_defer_starts.append(len(self.state.defers))
        try self.lower_scope(module, function, statements, body)
        self.state.loop_defer_starts.remove(len(self.state.loop_defer_starts) - 1)

    # Emit actions in reverse registration order without removing the
    # compile-time list: another control-flow path may need the same copies.
    pub func emit_deferred_from(module: HirModule, function: HirFunction, start: i64, body: list[MirInstruction]) -> !:
        try self.emit_deferred_range(module, function, start, len(self.state.defers), false, body)

    # `on_error` is the error exit: it also runs `errdefer` actions, in the
    # same LIFO order as the ordinary ones (base.md §8.8).
    func emit_deferred_range(module: HirModule, function: HirFunction, start: i64, end: i64, on_error: bool, body: list[MirInstruction]) -> !:
        var index = end - 1
        while index >= start:
            match self.state.defers[index]:
                Source(statement): try self.lower_statement(module, function, statement, body)
                ErrorSource(statement):
                    if on_error: try self.lower_statement(module, function, statement, body)
                DestroyAddress(address, value_type, span): self.emit_ownership_call(value_type, address, false, span, body)
                OwnedValue(value, value_type, span): self.emit_value_ownership(value_type, value, false, span, body)
                else: self.full.emit_deferred_action(self.state.defers[index], body)
            index -= 1

    ## Preserve lexical LIFO while placing structured-worker completion at
    ## the invocation boundary: nested scopes unwind first, then children are
    ## cancelled/joined, then root resources and source defers are released.
    func emit_function_exit_cleanup(module: HirModule, function: HirFunction, span: SourceSpan, on_error: bool, body: list[MirInstruction]) -> !:
        var root_end = len(self.state.defers)
        if len(self.state.scope_defer_starts) > 1: root_end = self.state.scope_defer_starts[1]
        try self.emit_deferred_range(module, function, root_end, len(self.state.defers), on_error, body)
        self.full.emit_task_group_finish(span, body)
        try self.emit_deferred_range(module, function, 0, root_end, on_error, body)

    # End a full expression without disturbing lexical source/compiler
    # cleanups registered by the statement itself.
    pub func emit_temporaries_from(start: i64, body: list[MirInstruction]) -> !:
        var index = len(self.state.defers) - 1
        while index >= start:
            match self.state.defers[index]:
                OwnedValue(value, value_type, span):
                    self.emit_value_ownership(value_type, value, false, span, body)
                    self.state.defers.remove(index)
                else: pass
            index -= 1

    # A `never` expression has no successor on which its owned operands can
    # be released. Remove their compile-time lifetime records without emitting
    # cleanup after the terminating instruction. Lexical source `defer`s are
    # intentionally untouched: they belong to the surrounding scope and may
    # still be needed by a different control-flow path.
    func forget_terminated_temporaries_from(start: i64):
        var index = len(self.state.defers) - 1
        while index >= start:
            match self.state.defers[index]:
                OwnedValue(value, value_type, span): self.state.defers.remove(index)
                else: pass
            index -= 1

    # `defer` runs for every scope a `break`/`continue` leaves, innermost
    # first (base.md §8.5); `levels` counts the loops beyond the innermost.
    func emit_loop_deferred(module: HirModule, function: HirFunction, span: SourceSpan, levels: i64, body: list[MirInstruction]) -> !:
        if len(self.state.loop_defer_starts) <= levels:
            try self.state.fail_unsupported(module, function, span, "`break`/`continue` outside a loop")
        try self.emit_deferred_from(module, function, self.state.loop_defer_starts[len(self.state.loop_defer_starts) - 1 - levels], body)

    # `continue` targets a range loop's increment block or a while loop's
    # loop label, whichever belongs to the selected source loop.
    func continue_depth(module: HirModule, function: HirFunction, span: SourceSpan, levels: i64) -> i64!:
        var depth = 0
        var remaining = levels
        var index = len(self.state.regions) - 1
        while index >= 0:
            if self.state.regions[index] == Region.for_continue and remaining == 0: return depth
            if self.state.regions[index] == Region.loop_body:
                if remaining == 0: return depth
                remaining -= 1
            depth += 1
            index -= 1
        error(self.state.unsupported(module, function, span, "`break`/`continue` outside a loop"))

    # `break` crosses the loop itself and reaches its surrounding block. A
    # range loop's continue block is counted naturally on the walk.
    func break_depth(module: HirModule, function: HirFunction, span: SourceSpan, levels: i64) -> i64!:
        var depth = 0
        var remaining = levels
        var index = len(self.state.regions) - 1
        while index >= 0:
            if self.state.regions[index] == Region.loop_body:
                if remaining == 0: return depth + 1
                remaining -= 1
            depth += 1
            index -= 1
        error(self.state.unsupported(module, function, span, "`break`/`continue` outside a loop"))

    # Constant terminal output is a data item holding the bytes plus a
    # newline, then `luce_rt_write(address, length)`.
    func lower_print(text: str, span: SourceSpan, body: list[MirInstruction]) -> !:
        let payload = strings.to_bytes(text + "\n")
        let data_id = DataId(value = u32(len(self.state.data)))
        self.state.data.append(MirData(
            name = "text" + str(data_id.value),
            bytes = payload,
            align = 1,
        ))
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = address, data = data_id), span = span))
        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.UnsignedInt(value = u64(len(payload)))), span = span))
        let write = try self.state.runtime_extern("luce_rt_write")
        body.append(MirInstruction(
            form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.state.operands.run([address, length])),
            span = span,
        ))

    # `print(value)` for a `str` value: write its bytes, then a newline.
    func lower_print_value(module: HirModule, function: HirFunction, value: NodeId, span: SourceSpan, body: list[MirInstruction]) -> !:
        let text = try self.lower_expression(module, function, value, body)
        let text_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        let pointer = try self.load_field(text_type, text, self.state.buffer_data_field(), span, body)
        let length = try self.load_field(text_type, text, self.state.buffer_length_field(), span, body)
        let write = try self.state.runtime_extern("luce_rt_write")
        body.append(MirInstruction(form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.state.operands.run([pointer, length])), span = span))
        if self.state.newline_data < 0: self.state.newline_data = self.add_data("newline", strings.to_bytes("\n"))
        let newline = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = newline, data = DataId(value = u32(self.state.newline_data))), span = span))
        let one = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.UnsignedInt(value = u64(1))), span = span))
        body.append(MirInstruction(form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.state.operands.run([newline, one])), span = span))

    func add_data(prefix: str, payload: list[u8]) -> i64:
        self.state.data.append(MirData(name = prefix + str(len(self.state.data)), bytes = payload, align = 1))
        return len(self.state.data) - 1

    # mark: Expressions =========================================================================

    # Lower one expression and return an owned managed result. Scalar values
    # need no lifetime bookkeeping. A read from existing storage retains its
    # recursive value; constructors, collection operations, and calls already
    # produce the +1 which this full expression owns.
    pub func lower_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let temporary_start = len(self.state.defers)
        let value = try self.lower_expression_form(module, function, expression, body)
        if node_diverges(self.state.program, expression):
            self.forget_terminated_temporaries_from(temporary_start)
            return value
        if value.value == no_register: return value
        let span = node_span(self.state.program, expression)
        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        if not self.type_needs_ownership(value_type): return value
        # A proven destruction-time receiver is a borrowed capability over an
        # object whose strong count has already reached zero. Retaining or
        # scheduling a release for that exact reference would resurrect or
        # over-release it. Values read from its fields keep ordinary ownership.
        if self.is_borrowed_self(function, expression): return value
        if self.expression_borrows_ownership(expression):
            # Aggregate reads are addresses into mutable storage. Snapshot the
            # bytes before retaining so a later write to the source cannot
            # redirect this temporary's eventual release to the replacement
            # value (for example `text = text + suffix`).
            if self.is_aggregate(value_type):
                let snapshot = self.new_temp(value_type, span, body)
                self.store_value(value_type, snapshot, value, span, body)
                self.emit_value_ownership(value_type, snapshot, true, span, body)
                self.remember_owned_value(snapshot, value_type, span)
                return snapshot
            self.emit_value_ownership(value_type, value, true, span, body)
        self.remember_owned_value(value, value_type, span)
        return value

    func is_borrowed_self(function: HirFunction, expression: NodeId) -> bool:
        if not contains_symbol(self.state.borrowed_receiver_methods, function.symbol): return false
        match node_form(self.state.program, expression):
            Reference(symbol): return len(function.parameters) > 0 and symbol.value == function.parameters[0].symbol.value
            else: return false

    func expression_borrows_ownership(expression: NodeId) -> bool:
        match node_form(self.state.program, expression):
            Reference(symbol): return true
            ExternLoad(variable): return true
            GlobalLoad(global): return true
            NativeLoad(pointer): return true
            SequenceIndex(value, index): return true
            Element(value, index): return true
            FieldAccess(value, field): return not self.full.is_weak_field_access(self, value, field)
            else: return false

    # Operands are lowered left to right, so `2 + 3` defines the register for
    # 2, then 3, then their sum.
    func lower_expression_form(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!:
        # A call may produce `unit`, which has no machine type; every other
        # expression form has a scalar type or is refused below.
        match node_form(self.state.program, expression):
            NeverCoercion(value): return try self.lower_expression(module, function, value, body)
            DivergingSequence(values):
                for position in range(0, i64(values.count)):
                    discard(try self.lower_expression(module, function, node_at(self.state.program, values, position), body))
                return RegisterId(value = no_register)
            Call(callee, arguments):
                if self.state.fallible_inner(node_type(self.state.program, expression)) != none:
                    try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible call")
                return try self.lower_call(module, function, expression, callee, arguments, body)
            IndirectCall(callee, arguments):
                if self.state.fallible_inner(node_type(self.state.program, expression)) != none:
                    try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible function-value call")
                return try self.lower_indirect_call(module, function, expression, callee, arguments, body)
            Initialize(callee, arguments):
                if self.state.fallible_inner(node_type(self.state.program, expression)) != none:
                    try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "an unhandled fallible initializer")
                return try self.lower_initializer(module, function, expression, callee, arguments, body)
            NativeStore(pointer, stored):
                let span = node_span(self.state.program, expression)
                let address = try self.lower_expression(module, function, pointer, body)
                let value = try self.lower_expression(module, function, stored, body)
                let stored_type = try self.state.mir_type_of(module, function, node_span(self.state.program, stored), node_type(self.state.program, stored))
                self.replace_owned_value(stored_type, address, value, span, body)
                return RegisterId(value = no_register)
            NativeMove(destination, source, count):
                let span = node_span(self.state.program, expression)
                let to = try self.lower_expression(module, function, destination, body)
                let from = try self.lower_expression(module, function, source, body)
                let element_count = try self.lower_expression(module, function, count, body)
                var pointee = resolve_builtin_type(BuiltinType.unit)
                match self.state.program.types.definitions[node_type(self.state.program, destination).value].form:
                    NativePointer(element, is_mutable): pointee = element
                    else: trap("typed native move has a non-pointer destination")
                let element_type = try self.state.mir_type_of(module, function, span, pointee)
                body.append(MirInstruction(form = InstructionForm.MoveElements(destination = to, source = from, element_type = element_type, count = element_count), span = span))
                return RegisterId(value = no_register)
            NativeDeallocate(pointer, element_type, count):
                let span = node_span(self.state.program, expression)
                let address = try self.lower_expression(module, function, pointer, body)
                let element_count = try self.lower_expression(module, function, count, body)
                let stored_type = try self.state.mir_type_of(module, function, span, element_type)
                body.append(MirInstruction(form = InstructionForm.DeallocateStorage(address = address, element_type = stored_type, count = element_count), span = span))
                return RegisterId(value = no_register)
            NativeIsNull(pointer):
                let span = node_span(self.state.program, expression)
                let address = try self.lower_expression(module, function, pointer, body)
                let null = self.null_constant(span, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = result, operation = BinaryOp.eq, left = address, right = null), span = span))
                return result
            NativeIsSame(left, right):
                let span = node_span(self.state.program, expression)
                let left_address = try self.lower_expression(module, function, left, body)
                let right_address = try self.lower_expression(module, function, right, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = result, operation = BinaryOp.eq, left = left_address, right = right_address), span = span))
                return result
            NativeAddressHash(pointer):
                let span = node_span(self.state.program, expression)
                let address = try self.lower_expression(module, function, pointer, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                body.append(MirInstruction(form = InstructionForm.PointerHash(result = result, operand = address), span = span))
                return result
            NativeFloatBits(value):
                let span = node_span(self.state.program, expression)
                let scalar = try self.lower_expression(module, function, value, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                body.append(MirInstruction(form = InstructionForm.FloatBits(result = result, operand = scalar), span = span))
                return result
            Discard(value):
                let discarded = try self.lower_expression(module, function, value, body)
                return RegisterId(value = no_register)
            Raise(code, message): return try self.lower_raise(module, function, expression, code, message, body)
            Trap(message): return try self.lower_trap(module, function, expression, message, body)
            Assert(condition, message): return try self.lower_assert(module, function, expression, condition, message, body)
            Try(value): return try self.lower_try(module, function, expression, value, body)
            Catch(value, failure, catch_body): return try self.lower_catch(module, function, expression, value, failure, catch_body, body)
            Conditional(value, condition, alternative):
                if types_match(node_type(self.state.program, expression), resolve_builtin_type(BuiltinType.never_type)):
                    return try self.lower_diverging_conditional(module, function, expression, value, condition, alternative, body)
            Match(subject, arms, has_result):
                if types_match(node_type(self.state.program, expression), resolve_builtin_type(BuiltinType.never_type)):
                    return try self.lower_match(module, function, expression, subject, arms, true, body)
            else:
                let runtime_value = try self.full.lower_expression_form(self, module, function, expression, body)
                if runtime_value != none: return runtime_value
        return try self.lower_typed_expression(module, function, expression, body)

    func lower_diverging_conditional(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, condition: NodeId, alternative: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let tested = try self.lower_expression(module, function, condition, body)
        self.open_if(tested, list[RegisterId](), span, body)
        discard(try self.lower_expression(module, function, value, body))
        self.emit_else(span, body)
        discard(try self.lower_expression(module, function, alternative, body))
        self.emit_end(span, body)
        return RegisterId(value = no_register)

    # mark: Structured tasks ==================================================================

    # mark: Immutable collection snapshots ====================================================

    # mark: Interface values ==================================================================

    # mark: Runtime-backed collections =========================================================

    # mark: Hash collections -------------------------------------------------------------------

    # Dynamic immutable strings and bytes receive one opaque owner from the runtime. MIR
    # keeps data and length explicit for O(1) reads while ownership remains a
    # distinct non-address handle that backends cannot accidentally dereference.
    func lower_buffer_concatenation(value_type: TypeId, left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let left_data = try self.load_field(value_type, left, self.state.buffer_data_field(), span, body)
        let left_length = try self.load_field(value_type, left, self.state.buffer_length_field(), span, body)
        let right_data = try self.load_field(value_type, right, self.state.buffer_data_field(), span, body)
        let right_length = try self.load_field(value_type, right, self.state.buffer_length_field(), span, body)
        let owner_type = builtin_mir_type(BuiltinMirType.buffer_owner)
        let owner = self.state.new_register(owner_type)
        body.append(MirInstruction(form = InstructionForm.BufferConcat(result = owner, left_data = left_data, left_length = left_length, right_data = right_data, right_length = right_length), span = span))
        let data = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.BufferData(result = data, owner = owner), span = span))
        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Binary(result = length, operation = BinaryOp.add, left = left_length, right = right_length), span = span))
        return self.materialize_buffer_value(value_type, owner, data, length, span, body)

    func materialize_buffer_value(value_type: TypeId, owner: RegisterId, data: RegisterId, length: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let owner_type = builtin_mir_type(BuiltinMirType.buffer_owner)
        let result = self.new_temp(value_type, span, body)
        self.store_value(owner_type, self.field_address(value_type, result, self.state.buffer_owner_field(), span, body), owner, span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.pointer), self.field_address(value_type, result, self.state.buffer_data_field(), span, body), data, span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.unsigned_u64), self.field_address(value_type, result, self.state.buffer_length_field(), span, body), length, span, body)
        return result

    func materialize_owned_buffer(value_type: TypeId, owner: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let data = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.BufferData(result = data, owner = owner), span = span))
        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.BufferLength(result = length, owner = owner), span = span))
        return self.materialize_buffer_value(value_type, owner, data, length, span, body)

    # Evaluate every canonical string piece before allocating the builder.
    # A field therefore transfers before mutable assembly state exists; after
    # that point append/freeze can only complete or trap.
    func lower_formatted_string(module: HirModule, function: HirFunction, expression: NodeId, parts: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let text_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
        let values = list[RegisterId]()
        for position in range(0, i64(parts.count)):
            values.append(try self.lower_expression(module, function, node_at(self.state.program, parts, position), body))

        let builder = self.state.new_register(intern_mir_type(self.state.types, MirType.BufferBuilder))
        body.append(MirInstruction(form = InstructionForm.BufferBuilderCreate(result = builder), span = span))
        for value in values:
            let data = try self.load_field(text_type, value, self.state.buffer_data_field(), span, body)
            let length = try self.load_field(text_type, value, self.state.buffer_length_field(), span, body)
            body.append(MirInstruction(form = InstructionForm.BufferBuilderAppend(builder = builder, data = data, length = length), span = span))
        let owner = self.state.new_register(builtin_mir_type(BuiltinMirType.buffer_owner))
        body.append(MirInstruction(form = InstructionForm.BufferBuilderFinish(result = owner, builder = builder), span = span))
        return self.materialize_owned_buffer(text_type, owner, span, body)

    func lower_builtin_display(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source_hir_type = node_type(self.state.program, value)
        let source_type = try self.state.mir_type_of(module, function, span, source_hir_type)
        var operand = try self.lower_expression(module, function, value, body)
        let owner = self.state.new_register(builtin_mir_type(BuiltinMirType.buffer_owner))

        match self.state.program.types.definitions[source_hir_type.value].form:
            Boolean: body.append(MirInstruction(form = InstructionForm.DisplayBoolean(result = owner, value = operand), span = span))
            Character: body.append(MirInstruction(form = InstructionForm.DisplayCharacter(result = owner, value = operand), span = span))
            else:
                if is_int_type(self.state.types, source_type):
                    if is_signed_int_type(self.state.types, source_type):
                        operand = self.extend_display_operand(operand, source_type, builtin_mir_type(BuiltinMirType.signed_i64), span, body)
                        body.append(MirInstruction(form = InstructionForm.DisplaySigned(result = owner, value = operand), span = span))
                    else:
                        operand = self.extend_display_operand(operand, source_type, builtin_mir_type(BuiltinMirType.unsigned_u64), span, body)
                        body.append(MirInstruction(form = InstructionForm.DisplayUnsigned(result = owner, value = operand), span = span))
                elif is_float_type(self.state.types, source_type):
                    if bits_of(self.state.types, source_type) == 16:
                        operand = self.extend_display_operand(operand, source_type, builtin_mir_type(BuiltinMirType.float32), span, body)
                    body.append(MirInstruction(form = InstructionForm.DisplayFloat(result = owner, value = operand), span = span))
                else: trap("BuiltinDisplay reached a non-displayable MIR type")

        let data = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.BufferData(result = data, owner = owner), span = span))
        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.BufferLength(result = length, owner = owner), span = span))
        let text_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
        return self.materialize_buffer_value(text_type, owner, data, length, span, body)

    func extend_display_operand(value: RegisterId, source: TypeId, destination: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        if source.value == destination.value: return value
        let result = self.state.new_register(destination)
        var operation = ConvertOp.extend
        if is_float_type(self.state.types, source): operation = ConvertOp.float_resize
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = operation, operand = value), span = span))
        return result

    # mark: Immutable sequence snapshots =======================================================

    # mark: Mutable lists ======================================================================

    # mark: Failure and termination =============================================================

    # Fill this function's caller-owned Error and leave through `Raise r0`.
    # The code and message are ordinary aggregate values copied fieldwise.
    func lower_raise(module: HirModule, function: HirFunction, expression: NodeId, code: NodeId, message: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        if self.state.error_slot < 0: try self.state.fail_unsupported(module, function, span, "`error` in a non-fallible function")
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let code_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_code))
        let message_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
        let destination = RegisterId(value = u32(self.state.error_slot))
        let code_value = try self.lower_expression(module, function, code, body)
        self.store_value(code_type, self.field_address(error_type, destination, 0, span, body), code_value, span, body)
        let message_value = try self.lower_expression(module, function, message, body)
        self.store_value(message_type, self.field_address(error_type, destination, 1, span, body), message_value, span, body)
        try self.emit_function_exit_cleanup(module, function, span, true, body)
        body.append(MirInstruction(form = InstructionForm.Raise(failure = destination), span = span))
        return RegisterId(value = no_register)

    # A source trap carries dynamic text through the existing target-neutral
    # runtime contract. The following `Unreachable` makes termination explicit
    # to canonical MIR without pretending that an ordinary extern call returns.
    func lower_trap(module: HirModule, function: HirFunction, expression: NodeId, message: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let text = try self.lower_expression(module, function, message, body)
        try self.emit_dynamic_trap(module, function, span, text, body)
        return RegisterId(value = no_register)

    # Assertions evaluate both source arguments before branching, matching
    # ordinary call order. Their failed arm reuses the same target-neutral
    # diagnostic contract as `trap`; successful control flow rejoins as unit.
    func lower_assert(module: HirModule, function: HirFunction, expression: NodeId, condition: NodeId, message: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let passed = try self.lower_expression(module, function, condition, body)
        let text = try self.lower_expression(module, function, message, body)
        let failed = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Unary(result = failed, operation = UnaryOp.bool_not, operand = passed), span = span))
        self.open_if(failed, list[RegisterId](), span, body)
        try self.emit_dynamic_trap(module, function, span, text, body)
        self.emit_end(span, body)
        return RegisterId(value = no_register)

    func emit_dynamic_trap(module: HirModule, function: HirFunction, span: SourceSpan, text: RegisterId, body: list[MirInstruction]) -> !:
        let text_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
        let pointer = try self.load_field(text_type, text, self.state.buffer_data_field(), span, body)
        let length = try self.load_field(text_type, text, self.state.buffer_length_field(), span, body)
        let trap_service = try self.state.runtime_extern("luce_rt_trap")
        body.append(MirInstruction(form = InstructionForm.CallExtern(results = no_registers(), external = trap_service, arguments = self.state.operands.run([pointer, length])), span = span))
        body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))

    # Propagation is a null test followed by one explicit failure arm. Copying
    # into r0 transfers ownership to our caller before local slots disappear.
    func lower_try(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        if self.state.error_slot < 0: try self.state.fail_unsupported(module, function, span, "`try` in a non-fallible function")
        let attempted = try self.lower_fallible_expression(module, function, value, body)
        let failed = self.error_is_present(attempted.error_value, span, body)
        self.open_if(failed, list[RegisterId](), span, body)
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        body.append(MirInstruction(form = InstructionForm.Memcpy(destination = RegisterId(value = u32(self.state.error_slot)), source = attempted.error_value, value_type = error_type), span = span))
        try self.emit_function_exit_cleanup(module, function, span, true, body)
        body.append(MirInstruction(form = InstructionForm.Raise(failure = RegisterId(value = u32(self.state.error_slot))), span = span))
        self.emit_end(span, body)
        if types_match(node_type(self.state.program, expression), resolve_builtin_type(BuiltinType.never_type)):
            body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        return attempted.value

    # Recovery is the same data test with a value-producing If. The failure
    # arm binds Error in its reserved slot; recover branches out of the If,
    # while success yields the call's value directly.
    func lower_catch(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, failure: SymbolId, catch_body: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let attempted = try self.lower_fallible_expression(module, function, value, body)
        var result = RegisterId(value = no_register)
        let results = list[RegisterId]()
        if not types_match(node_type(self.state.program, expression), resolve_builtin_type(BuiltinType.unit)):
            let success_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
            result = self.state.new_register(self.register_type_for(success_type))
            results.append(result)
        let failed = self.error_is_present(attempted.error_value, span, body)
        self.open_if(failed, results, span, body)
        self.state.regions.append(Region.if_arm)
        let local = try self.state.local_of(module, function, span, failure)
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        self.store_value(error_type, local.address, attempted.error_value, span, body)
        let defer_start = len(self.state.defers)
        self.state.recover_targets.append(RecoverTarget(region_index = len(self.state.regions) - 1, defer_start = defer_start))
        try self.lower_scope(module, function, catch_body, body)
        # HirGenerator proved every handler path transfers. `lower_scope`
        # still emits the normal-fallthrough copies of deferred actions after
        # those branches; this marker preserves that proof for the region
        # verifier without making the unreachable copies observable.
        body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        self.state.recover_targets.remove(len(self.state.recover_targets) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_else(span, body)
        if attempted.value.value != no_register: self.emit_yield(attempted.value, span, body)
        self.emit_end(span, body)
        return result

    pub func error_is_present(error_value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let no_error = self.null_constant(span, body)
        let failed = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = failed, operation = BinaryOp.ne, left = error_value, right = no_error), span = span))
        return failed

    func lower_typed_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        match node_form(self.state.program, expression):
            ErrorCodeLiteral(package, value):
                let temp = self.new_temp(value_type, span, body)
                let domain_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
                let domain = try self.lower_buffer_constant(domain_type, strings.to_bytes(self.state.program.packages[package.value].identity), span, body)
                self.store_value(domain_type, self.field_address(value_type, temp, 0, span, body), domain, span, body)
                let code_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
                let code = self.state.new_register(code_type)
                body.append(MirInstruction(form = InstructionForm.Const(result = code, value = MirConstant.UnsignedInt(value = u64(value))), span = span))
                self.store_value(code_type, self.field_address(value_type, temp, 1, span, body), code, span, body)
                return temp
            Constant(index):
                # A Base text literal is a view of program data: no owner, no runtime.
                if self.state.is_string_view(node_type(self.state.program, expression)):
                    match self.state.program.values[index]:
                        Text(text): return try self.lower_text_constant(value_type, text, span, body)
                        else: trap("text view constant is not text")
                var constant = MirConstant.Null
                match self.state.program.values[index]:
                    SignedInteger(item): constant = MirConstant.SignedInt(value = item)
                    UnsignedInteger(item): constant = MirConstant.UnsignedInt(value = item)
                    Floating(item): constant = MirConstant.Float(value = item)
                    Boolean(item): constant = MirConstant.Bool(value = item)
                    Character(item): constant = MirConstant.UnsignedInt(value = u64(u32(item)))
                    Text(item): return try self.lower_buffer_constant(value_type, strings.to_bytes(item), span, body)
                    Bytes(item): return try self.lower_buffer_constant(value_type, item, span, body)
                    else: try self.state.fail_unsupported(module, function, span, "constant `" + str(self.state.program.values[index]) + "`")
                let register = self.state.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.Const(result = register, value = constant), span = span))
                return register
            Reference(symbol):
                for parameter in self.state.parameters:
                    if parameter.symbol == symbol.value: return parameter.address
                let constant = self.state.constant_of(symbol)
                if constant != none:
                    return try self.lower_expression(module, function, constant.value, body)
                return self.load_value(value_type, try self.address_of(module, function, span, symbol, body), span, body)
            FunctionAddress(target):
                let source_index = self.state.function_index_of(target)
                if source_index < 0: trap("function address names an unknown HIR symbol")
                match self.state.program.types.definitions[node_type(self.state.program, expression).value].form:
                    CFunction(parameters, function_result):
                        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                        match self.state.lowered_functions[source_index]:
                            External(external): body.append(MirInstruction(form = InstructionForm.ExternAddress(result = result, external = external), span = span))
                            Defined(function_id):
                                match self.state.c_wrappers[source_index]:
                                    Present(wrapper): body.append(MirInstruction(form = InstructionForm.FunctionAddress(result = result, function = wrapper), span = span))
                                    Absent: trap("cfunc conversion has no predeclared C wrapper")
                        return result
                    else:
                        var lowered = FunctionId(value = 0)
                        match self.state.lowered_functions[source_index]:
                            Defined(function_id): lowered = function_id
                            External(external): trap("Luce function address names a C extern")
                        let result = self.new_temp(value_type, span, body)
                        body.append(MirInstruction(form = InstructionForm.FunctionValue(destination = result, function_type = value_type, function = lowered), span = span))
                        return result
            ExternLoad(variable_index):
                let global = self.state.lowered_external_globals[variable_index]
                let result = self.state.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.LoadExternalGlobal(result = result, global = global), span = span))
                return result
            GlobalLoad(global_index):
                let address = self.global_address(global_index, span, body)
                return self.load_value(value_type, address, span, body)
            NativeLoad(pointer):
                let address = try self.lower_expression(module, function, pointer, body)
                return self.load_value(value_type, address, span, body)
            NativeAdvance(pointer, count):
                let address = try self.lower_expression(module, function, pointer, body)
                let offset = try self.lower_expression(module, function, count, body)
                var pointee = resolve_builtin_type(BuiltinType.unit)
                match self.state.program.types.definitions[node_type(self.state.program, pointer).value].form:
                    NativePointer(element, is_mutable): pointee = element
                    else: trap("typed native advance has a non-pointer operand")
                let element_type = try self.state.mir_type_of(module, function, span, pointee)
                return self.element_address(element_type, address, offset, span, body)
            NativeRebind(pointer): return try self.lower_expression(module, function, pointer, body)
            NativeAllocate(element_type, count):
                let element_count = try self.lower_expression(module, function, count, body)
                let stored_type = try self.state.mir_type_of(module, function, span, element_type)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.AllocateStorage(result = result, element_type = stored_type, count = element_count), span = span))
                self.initialize_allocated_ownership(stored_type, element_count, result, span, body)
                return result
            NativeArena(end):
                let requested_end = try self.lower_expression(module, function, end, body)
                let provider = try self.state.runtime_extern("luce_rt_arena")
                let result = self.state.new_register(value_type)
                let arguments = self.state.operands.run([requested_end])
                let results = self.state.operands.run([result])
                body.append(MirInstruction(form = InstructionForm.CallExtern(results = results, external = provider, arguments = arguments), span = span))
                return result
            NumericConvert(value): return try self.lower_numeric_conversion(module, function, expression, value, body)
            Cast(value): return try self.lower_cast(module, function, expression, value, body)
            EnumFromInteger(value): return try self.lower_enum_from_integer(module, function, expression, value, body)
            QualifyPointer(value): return try self.lower_expression(module, function, value, body)
            Deref(pointer):
                let address = try self.lower_expression(module, function, pointer, body)
                return self.load_value(value_type, address, span, body)
            AddressOf(pointer, symbol, global, steps): return try self.lower_address_of(module, function, span, pointer, symbol, global, steps, body)
            PointerOffset(pointer, offset, negate):
                let base = try self.lower_expression(module, function, pointer, body)
                var index = try self.lower_expression(module, function, offset, body)
                let pointee = pointee_of(self.state.program.types, node_type(self.state.program, pointer))
                let element_type = try self.state.mir_type_of(module, function, span, pointee)
                if negate:
                    # `p - n`: negate a signed count; an unsigned one is read as `isize` first.
                    let index_type = self.state.registers[index.value]
                    if not is_signed_int_type(self.state.types, index_type):
                        let signed = self.state.new_register(pointer_int_type(self.state.types, true))
                        body.append(MirInstruction(form = InstructionForm.Convert(result = signed, operation = ConvertOp.cast_int, operand = index), span = span))
                        index = signed
                    let negated = self.state.new_register(self.state.registers[index.value])
                    body.append(MirInstruction(form = InstructionForm.Unary(result = negated, operation = UnaryOp.neg_wrap, operand = index), span = span))
                    index = negated
                return self.element_address(element_type, base, index, span, body)
            SpanFromParts(pointer, length):
                let data = try self.lower_expression(module, function, pointer, body)
                let count = try self.lower_expression(module, function, length, body)
                let temp = self.new_temp(value_type, span, body)
                self.store_value(builtin_mir_type(BuiltinMirType.pointer), self.field_address(value_type, temp, 0, span, body), data, span, body)
                self.store_value(pointer_int_type(self.state.types, false), self.field_address(value_type, temp, 1, span, body), count, span, body)
                return temp
            SpanLength(viewed):
                let span_value = try self.lower_expression(module, function, viewed, body)
                let span_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, viewed))
                return try self.load_field(span_type, span_value, 1, span, body)
            SpanData(viewed):
                let span_value = try self.lower_expression(module, function, viewed, body)
                let span_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, viewed))
                return try self.load_field(span_type, span_value, 0, span, body)
            SpanElementAddress(viewed, index):
                let span_value = try self.lower_expression(module, function, viewed, body)
                let position = try self.lower_expression(module, function, index, body)
                let span_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, viewed))
                let element_type = try self.state.mir_type_of(module, function, span, span_element_of(self.state.program.types, node_type(self.state.program, viewed)))
                let data = try self.load_field(span_type, span_value, 0, span, body)
                let length = try self.load_field(span_type, span_value, 1, span, body)
                return self.checked_element_address_with_length(element_type, data, position, length, span, body)
            SpanSlice(viewed, start, end, inclusive):
                return try self.lower_span_slice(module, function, span, value_type, viewed, start, end, inclusive, body)
            PointerDifference(left, right):
                let left_address = try self.lower_expression(module, function, left, body)
                let right_address = try self.lower_expression(module, function, right, body)
                let pointee = pointee_of(self.state.program.types, node_type(self.state.program, left))
                let element_type = try self.state.mir_type_of(module, function, span, pointee)
                let result = self.state.new_register(pointer_int_type(self.state.types, true))
                body.append(MirInstruction(form = InstructionForm.PointerDifference(result = result, element_type = element_type, left = left_address, right = right_address), span = span))
                return result
            LayoutConstant(query, subject, field):
                # The question stays symbolic: canonical MIR names the type and
                # the backend folds the target's answer (base.md §5.1, §5.11).
                let subject_type = try self.state.mir_type_of(module, function, span, subject)
                let result = self.state.new_register(pointer_int_type(self.state.types, false))
                body.append(MirInstruction(form = InstructionForm.LayoutConstant(result = result, query = query, subject = subject_type, field = field), span = span))
                return result
            SequenceLength(value):
                let hir_sequence_type = node_type(self.state.program, value)
                # A fixed array's length is static, but its receiver remains
                # an ordinary expression whose effects happen first.
                let sequence = try self.lower_expression(module, function, value, body)
                match self.state.program.types.definitions[hir_sequence_type.value].form:
                    Array(element, count):
                        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.UnsignedInt(value = u64(count))), span = span))
                        return length
                    else:
                        let collection_length = self.full.lower_collection_length(hir_sequence_type, sequence, span, body)
                        if collection_length != none: return collection_length
                        let sequence_type = try self.state.mir_type_of(module, function, span, hir_sequence_type)
                        return try self.load_field(sequence_type, sequence, self.state.buffer_length_field(), span, body)
            StringScalarCount(value):
                let text = try self.lower_expression(module, function, value, body)
                let text_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
                let data = try self.load_field(text_type, text, self.state.buffer_data_field(), span, body)
                let length = try self.load_field(text_type, text, self.state.buffer_length_field(), span, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                body.append(MirInstruction(form = InstructionForm.StringScalarCount(result = result, data = data, length = length), span = span))
                return result
            ForeignBytesCopy(pointer, count): return try self.lower_foreign_bytes_copy(module, function, expression, pointer, count, body)
            ForeignCStringCopy(pointer): return try self.lower_foreign_c_string_copy(module, function, expression, pointer, body)
            BuiltinDisplay(value): return try self.lower_builtin_display(module, function, expression, value, body)
            FormattedString(parts): return try self.lower_formatted_string(module, function, expression, parts, body)
            Hash(value):
                let lowered = try self.lower_expression(module, function, value, body)
                return try self.lower_structural_hash(module, function, span, node_type(self.state.program, value), lowered, body)
            SequenceIndex(value, index):
                return try self.lower_sequence_index(module, function, span, value, index, body)
            Tuple(elements):
                # Fill a fresh slot field by field; the slot's address is the value.
                let temp = self.new_temp(value_type, span, body)
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.state.program, elements, index)
                    let element = try self.lower_expression(module, function, element_node, body)
                    let element_type = try self.state.mir_type_of(module, function, node_span(self.state.program, element_node), node_type(self.state.program, element_node))
                    let field = self.field_address(value_type, temp, index, span, body)
                    self.initialize_owned_value(element_type, field, element, span, body)
                return temp
            Array(elements):
                let temp = self.new_temp(value_type, span, body)
                var element_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
                match mir_type(self.state.types, value_type):
                    Array(item, count): element_type = item
                    else: trap("array HIR node has a non-array MIR type")
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.state.program, elements, index)
                    let element = try self.lower_expression(module, function, element_node, body)
                    let position = self.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), index, span, body)
                    let address = self.element_address(element_type, temp, position, span, body)
                    self.initialize_owned_value(element_type, address, element, span, body)
                return temp
            Range(lower, upper, inclusive):
                let temp = self.new_temp(value_type, span, body)
                let lower_value = try self.lower_expression(module, function, lower, body)
                let element_type = try self.state.mir_type_of(module, function, node_span(self.state.program, lower), node_type(self.state.program, lower))
                self.store_value(element_type, self.field_address(value_type, temp, 0, span, body), lower_value, span, body)
                let upper_value = try self.lower_expression(module, function, upper, body)
                self.store_value(element_type, self.field_address(value_type, temp, 1, span, body), upper_value, span, body)
                let boundary = self.bool_constant(inclusive, span, body)
                self.store_value(builtin_mir_type(BuiltinMirType.boolean), self.field_address(value_type, temp, 2, span, body), boundary, span, body)
                return temp
            Element(tuple_value, index):
                let base = try self.lower_expression(module, function, tuple_value, body)
                let tuple_type = try self.state.mir_type_of(module, function, node_span(self.state.program, tuple_value), node_type(self.state.program, tuple_value))
                let field = self.field_address(tuple_type, base, index, span, body)
                return self.load_value(value_type, field, span, body)
            StructValue(struct_index, fields):
                let temp = self.new_temp(value_type, span, body)
                for pair in range(0, i64(fields.count) // 2):
                    let field_index = entry_at(self.state.program, fields, pair * 2)
                    let field_node = NodeId(value = u32(entry_at(self.state.program, fields, pair * 2 + 1)))
                    let element = try self.lower_expression(module, function, field_node, body)
                    let element_type = try self.state.mir_type_of(module, function, node_span(self.state.program, field_node), node_type(self.state.program, field_node))
                    let field = self.field_address(value_type, temp, field_index, span, body)
                    self.initialize_owned_value(element_type, field, element, span, body)
                return temp
            FieldAccess(record, field_index):
                let base = try self.lower_expression(module, function, record, body)
                let record_hir_type = node_type(self.state.program, record)
                let class_field = try self.full.lower_class_field_load(self, module, function, span, record_hir_type, base, field_index, value_type, body)
                if class_field != none: return class_field
                let struct_type = try self.state.mir_type_of(module, function, node_span(self.state.program, record), node_type(self.state.program, record))
                let field = self.field_address(struct_type, base, field_index, span, body)
                return self.load_value(value_type, field, span, body)
            NoneLiteral:
                # The nullable pointer niche is one word whose zero is `none`.
                if is_nullable_ptr_type(self.state.types, value_type): return self.typed_null_constant(value_type, span, body)
                let temp = self.new_temp(value_type, span, body)
                self.store_optional_tag(temp, 0, span, body)
                return temp
            Some(inner):
                if is_nullable_ptr_type(self.state.types, value_type):
                    let pointer = try self.lower_expression(module, function, inner, body)
                    let wrapped = self.state.new_register(value_type)
                    body.append(MirInstruction(form = InstructionForm.Convert(result = wrapped, operation = ConvertOp.ptr_to_nullable, operand = pointer), span = span))
                    return wrapped
                let temp = self.new_temp(value_type, span, body)
                self.store_optional_tag(temp, 1, span, body)
                let payload = try self.lower_expression(module, function, inner, body)
                let payload_type = try self.state.mir_type_of(module, function, node_span(self.state.program, inner), node_type(self.state.program, inner))
                let payload_address = self.payload_address(value_type, temp, span, body)
                self.initialize_owned_value(payload_type, payload_address, payload, span, body)
                return temp
            EnumValue(enum_index, case_index, payload):
                let shape = ir.integer_enum_shape(self.state.program, node_type(self.state.program, expression))
                if shape != none:
                    # The case is its declared integer (base.md §10.3).
                    return self.c_enum_constant(value_type, shape.values[case_index], span, body)
                # Tag first, then the case's payload struct after it.
                let temp = self.new_temp(value_type, span, body)
                self.store_enum_tag(value_type, temp, case_index, span, body)
                if payload.count > 0:
                    let case_type = self.case_struct_type(value_type, case_index)
                    let payload_base = self.payload_address(value_type, temp, span, body)
                    for pair in range(0, i64(payload.count) // 2):
                        let field_index = entry_at(self.state.program, payload, pair * 2)
                        let field_node = NodeId(value = u32(entry_at(self.state.program, payload, pair * 2 + 1)))
                        let element = try self.lower_expression(module, function, field_node, body)
                        let element_type = try self.state.mir_type_of(module, function, node_span(self.state.program, field_node), node_type(self.state.program, field_node))
                        let field = self.field_address(case_type, payload_base, field_index, span, body)
                        self.initialize_owned_value(element_type, field, element, span, body)
                return temp
            Match(subject, arms, has_result):
                return try self.lower_match(module, function, expression, subject, arms, true, body)
            ElseFallback(optional_value, arm):
                # `If(tag == 1)`: the present arm yields the payload, the
                # absent arm evaluates and yields the fallback.
                let optional = try self.lower_expression(module, function, optional_value, body)
                let optional_type = try self.state.mir_type_of(module, function, node_span(self.state.program, optional_value), node_type(self.state.program, optional_value))
                let present = self.optional_present(optional_type, optional, span, body)
                let result = self.state.new_register(self.register_type_for(value_type))
                self.open_if(present, [result], span, body)
                let present_start = len(self.state.defers)
                let payload = self.optional_payload(optional_type, value_type, optional, span, body)
                if self.type_needs_ownership(value_type): self.emit_value_ownership(value_type, payload, true, span, body)
                try self.emit_temporaries_from(present_start, body)
                self.emit_yield(payload, span, body)
                self.emit_else(span, body)
                let fallback_start = len(self.state.defers)
                let fallback = try self.lower_expression(module, function, arm, body)
                if not node_diverges(self.state.program, arm):
                    if self.type_needs_ownership(value_type): discard(self.take_owned_value(fallback))
                    try self.emit_temporaries_from(fallback_start, body)
                    self.emit_yield(fallback, span, body)
                self.emit_end(span, body)
                return result
            Unary(operation, operand):
                let operand_register = try self.lower_expression(module, function, operand, body)
                let register = self.state.new_register(value_type)
                match operation:
                    LogicalNot:
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bool_not, operand = operand_register), span = span))
                    NumericNegate(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.neg, operand = operand_register), span = span))
                    WrapNegate(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.neg_wrap, operand = operand_register), span = span))
                    IntegerBitwiseNot(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bit_not, operand = operand_register), span = span))
                    NumericIdentity(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Copy(result = register, source = operand_register), span = span))
                return register
            Binary(left, operation, right):
                match operation:
                    LogicalAnd: return try self.lower_short_circuit(module, function, expression, left, right, true, body)
                    LogicalOr: return try self.lower_short_circuit(module, function, expression, left, right, false, body)
                    else:
                        let left_register = try self.lower_expression(module, function, left, body)
                        let right_register = try self.lower_expression(module, function, right, body)
                        let left_type = node_type(self.state.program, left)
                        let operand_type = try self.state.mir_type_of(module, function, node_span(self.state.program, left), left_type)
                        let collection = try self.full.lower_collection_binary(self, module, function, span, operation, left_type, left_register, right_register, body)
                        if collection != none: return collection
                        match self.state.program.types.definitions[left_type.value].form:
                            Bytes:
                                match operation:
                                    Add(item): return try self.lower_buffer_concatenation(operand_type, left_register, right_register, span, body)
                                    else: return try self.lower_buffer_comparison(module, function, span, operation, operand_type, left_register, right_register, body)
                            String:
                                match operation:
                                    Add(item): return try self.lower_buffer_concatenation(operand_type, left_register, right_register, span, body)
                                    else: return try self.lower_buffer_comparison(module, function, span, operation, operand_type, left_register, right_register, body)
                            StringView: return try self.lower_buffer_comparison(module, function, span, operation, operand_type, left_register, right_register, body)
                            else: pass
                        if self.is_aggregate(operand_type):
                            return try self.lower_aggregate_comparison(module, function, span, operation, left_type, left_register, right_register, body)
                        match operation:
                            CheckedAdd(item): return try self.lower_checked_optional(module, function, span, value_type, BinaryOp.add_wrap, BinaryOp.add_overflows, operand_type, left_register, right_register, body)
                            CheckedSubtract(item): return try self.lower_checked_optional(module, function, span, value_type, BinaryOp.sub_wrap, BinaryOp.sub_overflows, operand_type, left_register, right_register, body)
                            CheckedMultiply(item): return try self.lower_checked_optional(module, function, span, value_type, BinaryOp.mul_wrap, BinaryOp.mul_overflows, operand_type, left_register, right_register, body)
                            else: pass
                        return try self.lower_binary_operation(module, function, span, operation, operand_type, left_register, right_register, body)
            Conditional(value, condition, alternative):
                let condition_start = len(self.state.defers)
                let condition_register = try self.lower_expression(module, function, condition, body)
                try self.emit_temporaries_from(condition_start, body)
                let result = self.state.new_register(self.register_type_for(value_type))
                self.open_if(condition_register, [result], span, body)
                let chosen_start = len(self.state.defers)
                let chosen = try self.lower_expression(module, function, value, body)
                if not node_diverges(self.state.program, value):
                    if self.type_needs_ownership(value_type): discard(self.take_owned_value(chosen))
                    try self.emit_temporaries_from(chosen_start, body)
                    self.emit_yield(chosen, span, body)
                self.emit_else(span, body)
                let fallback_start = len(self.state.defers)
                let fallback = try self.lower_expression(module, function, alternative, body)
                if not node_diverges(self.state.program, alternative):
                    if self.type_needs_ownership(value_type): discard(self.take_owned_value(fallback))
                    try self.emit_temporaries_from(fallback_start, body)
                    self.emit_yield(fallback, span, body)
                self.emit_end(span, body)
                return result
            else:
                let runtime_value = try self.full.lower_typed_expression(self, module, function, expression, value_type, span, body)
                if runtime_value != none: return runtime_value
                error(self.state.unsupported(module, function, span, "expression `" + str(node_form(self.state.program, expression)) + "`"))

    # A fallible expression yields its success register (absent for unit) and
    # reported error pointer together. Calls are the primitive producer;
    # conditional expressions join both components through region results.
    func lower_fallible_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        match node_form(self.state.program, expression):
            Call(callee, arguments): return try self.lower_fallible_call(module, function, expression, callee, arguments, body)
            IndirectCall(callee, arguments): return try self.lower_fallible_indirect_call(module, function, expression, callee, arguments, body)
            Initialize(callee, arguments): return try self.lower_fallible_initializer(module, function, expression, callee, arguments, body)
            Match(subject, arms, has_result): return try self.lower_fallible_match(module, function, expression, subject, arms, body)
            Conditional(value, condition, alternative):
                let successful = self.state.fallible_inner(node_type(self.state.program, expression)) else error(self.state.unsupported(module, function, span, "a non-fallible expression in fallible lowering"))
                let condition_start = len(self.state.defers)
                let condition_value = try self.lower_expression(module, function, condition, body)
                try self.emit_temporaries_from(condition_start, body)
                var result_value = RegisterId(value = no_register)
                let results = list[RegisterId]()
                if not types_match(successful, resolve_builtin_type(BuiltinType.unit)) and not types_match(successful, resolve_builtin_type(BuiltinType.never_type)):
                    let value_type = try self.state.mir_type_of(module, function, span, successful)
                    result_value = self.state.new_register(self.register_type_for(value_type))
                    results.append(result_value)
                let result_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
                results.append(result_error)
                self.open_if(condition_value, results, span, body)
                let chosen_start = len(self.state.defers)
                if node_diverges(self.state.program, value):
                    discard(try self.lower_expression(module, function, value, body))
                else:
                    let chosen = try self.lower_fallible_expression(module, function, value, body)
                    try self.emit_temporaries_from(chosen_start, body)
                    self.emit_fallible_yield(chosen, span, body)
                self.emit_else(span, body)
                let fallback_start = len(self.state.defers)
                if node_diverges(self.state.program, alternative):
                    discard(try self.lower_expression(module, function, alternative, body))
                else:
                    let fallback = try self.lower_fallible_expression(module, function, alternative, body)
                    try self.emit_temporaries_from(fallback_start, body)
                    self.emit_fallible_yield(fallback, span, body)
                self.emit_end(span, body)
                return FallibleResult(value = result_value, error_value = result_error)
            else:
                let runtime_value = try self.full.lower_fallible_expression(self, module, function, expression, body)
                if runtime_value != none: return runtime_value
                error(self.state.unsupported(module, function, span, "fallible expression `" + str(node_form(self.state.program, expression)) + "`"))

    # A fallible match joins both halves of the effect at one block: the
    # successful value (when non-unit) and the reported Error pointer. Pattern
    # testing and bindings mirror ordinary match lowering, while arm exits use
    # `lower_fallible_expression` so no T! value ever becomes a MIR register.
    func lower_fallible_match(module: HirModule, function: HirFunction, node: NodeId, subject: NodeId, arms: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, node)
        let successful = self.state.fallible_inner(node_type(self.state.program, node)) else error(self.state.unsupported(module, function, span, "a non-fallible match in fallible lowering"))
        let subject_type = node_type(self.state.program, subject)
        let selected = try self.lower_expression(module, function, subject, body)
        var result_value = RegisterId(value = no_register)
        let result_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let results = list[RegisterId]()
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)) and not types_match(successful, resolve_builtin_type(BuiltinType.never_type)):
            let value_type = try self.state.mir_type_of(module, function, span, successful)
            result_value = self.state.new_register(self.register_type_for(value_type))
            results.append(result_value)
        results.append(result_error)
        let block_depth = len(self.state.regions)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run(results)), span = span))
        self.state.regions.append(Region.block)

        try self.lower_match_arms(module, function, selected, subject_type, arms, MatchExit.Fallible(block_depth = block_depth), span, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        return FallibleResult(value = result_value, error_value = result_error)

    func lower_fallible_arm_body(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, block_depth: i64, defer_start: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.state.program, statements, position), body)
        if node_diverges(self.state.program, value):
            discard(try self.lower_expression(module, function, value, body))
            while len(self.state.defers) > defer_start: self.state.defers.remove(len(self.state.defers) - 1)
            return
        let result = try self.lower_fallible_expression(module, function, value, body)
        try self.emit_deferred_from(module, function, defer_start, body)
        while len(self.state.defers) > defer_start: self.state.defers.remove(len(self.state.defers) - 1)
        let values = list[RegisterId]()
        if result.value.value != no_register: values.append(result.value)
        values.append(result.error_value)
        let depth = len(self.state.regions) - 1 - block_depth
        body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.state.operands.run(values)), span = span))

    func emit_fallible_yield(result: FallibleResult, span: SourceSpan, body: list[MirInstruction]):
        let values = list[RegisterId]()
        if result.value.value != no_register: values.append(result.value)
        values.append(result.error_value)
        body.append(MirInstruction(form = InstructionForm.Yield(values = self.state.operands.run(values)), span = span))

    # mark: Calls and C boundaries =============================================================

    # Source arguments are evaluated in source order and then placed by the
    # parameter indices HIR resolved for named arguments.
    pub func lower_placed_arguments(module: HirModule, function: HirFunction, called: HirFunction, arguments: Operands, body: list[MirInstruction]) -> list[RegisterId]!:
        let placed = list[RegisterId]()
        for parameter in called.parameters: placed.append(RegisterId(value = no_register))
        var has_mutating_receiver = false
        let receiver = called.receiver
        if receiver != none: has_mutating_receiver = receiver.kind == HirReceiverKind.mutating_method
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.state.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.state.program, arguments, pair * 2 + 1)))
            if parameter_index == 0 and has_mutating_receiver:
                placed[parameter_index] = try self.lower_mutable_place_address(module, function, argument, body)
            else:
                placed[parameter_index] = try self.lower_expression(module, function, argument, body)
        return placed

    # A mutating value receiver is passed by address. Walking its resolved HIR
    # place here keeps field/array addressing structural and makes crossing a
    # list element the one canonical snapshot write barrier. Reference-valued
    # elements are loaded normally: mutating the referenced identity does not
    # replace the containing list slot and therefore must not detach it.
    pub func lower_mutable_place_address(module: HirModule, function: HirFunction, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, value)
        match node_form(self.state.program, value):
            Reference(symbol): return try self.address_of(module, function, span, symbol, body)
            FieldAccess(inner, field):
                let base = try self.lower_mutable_place_address(module, function, inner, body)
                let owner_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, inner))
                return self.field_address(owner_type, base, field, span, body)
            SequenceIndex(inner, index):
                let sequence_type = node_type(self.state.program, inner)
                match self.state.program.types.definitions[sequence_type.value].form:
                    Array(element, count):
                        let base = try self.lower_mutable_place_address(module, function, inner, body)
                        let position = try self.lower_expression(module, function, index, body)
                        let element_type = try self.state.mir_type_of(module, function, span, element)
                        return self.checked_element_address(element_type, base, position, count, span, body)
                    else:
                        let collection = try self.full.lower_collection_mutable_element_address(self, module, function, span, inner, sequence_type, index, body)
                        if collection != none: return collection
                        error(self.state.unsupported(module, function, span, "a mutating receiver that is not a resolved mutable place"))
            else: error(self.state.unsupported(module, function, span, "a mutating receiver that is not a resolved mutable place"))

    # Canonical calling shape for either callable type. Luce values reuse the
    # direct-call hidden result/error protocol; cfunc values use the closed raw
    # C boundary shape and are necessarily infallible.
    pub func lower_function_value_signature(module: HirModule, function: HirFunction, span: SourceSpan, function_type: ir.TypeId) -> MirSignature!:
        match self.state.program.types.definitions[function_type.value].form:
            Function(parameters, result): return try self.state.lower_luce_function_signature(parameters, result)
            CFunction(parameters, result):
                let c_parameters = list[TypeId]()
                for parameter in parameters:
                    c_parameters.append(try self.state.c_boundary_type_of(module, function, span, parameter))
                let c_results = list[TypeId]()
                if not types_match(result, resolve_builtin_type(BuiltinType.unit)):
                    c_results.append(try self.state.c_boundary_type_of(module, function, span, result))
                return MirSignature(parameters = c_parameters, results = c_results, is_fallible = false, returns_never = false)
            else: trap("indirect call has a non-function HIR type")

    func function_value_convention(function_type: ir.TypeId) -> CallingConvention:
        match self.state.program.types.definitions[function_type.value].form:
            CFunction(parameters, result): return CallingConvention.c
            Function(parameters, result): return CallingConvention.luce
            else: trap("indirect call has a non-function HIR type")

    # Callee expression first, then positional arguments left to right.
    func lower_indirect_operands(module: HirModule, function: HirFunction, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> IndirectOperands!:
        let target = try self.lower_expression(module, function, callee, body)
        let values = list[RegisterId]()
        for position in range(0, i64(arguments.count)):
            values.append(try self.lower_expression(module, function, node_at(self.state.program, arguments, position), body))
        return IndirectOperands(target = target, values = values)

    func lower_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let operands = try self.lower_indirect_operands(module, function, callee, arguments, body)
        let callee_type = node_type(self.state.program, callee)
        let signature = try self.lower_function_value_signature(module, function, span, callee_type)
        if signature.is_fallible: trap("fallible indirect call entered infallible lowering")
        if self.function_value_convention(callee_type) == CallingConvention.c:
            return try self.lower_c_indirect_call(module, function, expression, callee_type, operands, signature, body)
        let call_arguments = list[RegisterId]()
        let results = list[RegisterId]()
        let value = try self.place_call_result(module, function, span, node_type(self.state.program, expression), signature.returns_never, call_arguments, results, body)
        for argument in operands.values: call_arguments.append(argument)
        body.append(MirInstruction(form = InstructionForm.CallClosure(results = self.state.operands.run(results), signature = signature, target = operands.target, arguments = self.state.operands.run(call_arguments)), span = span))
        if signature.returns_never:
            body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        return value

    # A cfunc call uses the same evaluated callee/argument list as an ordinary
    # indirect call, but each nullable pointer-shaped slot is translated at
    # this one C boundary. ABI placement is still a backend responsibility.
    func lower_c_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee_type: ir.TypeId, operands: IndirectOperands, signature: MirSignature, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source_parameters = list[ir.TypeId]()
        var source_result = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[callee_type.value].form:
            CFunction(parameters, result):
                for parameter in parameters: source_parameters.append(parameter)
                source_result = result
            else: trap("C indirect call has a non-cfunc HIR type")
        let call_arguments = list[RegisterId]()
        for index in range(0, len(operands.values)):
            call_arguments.append(try self.encode_c_boundary_value(module, function, span, source_parameters[index], operands.values[index], body))
        # A bare cfunc is pointer-shaped: zero is observable while stored but
        # invoking it is the precise `null_foreign` trap boundary.
        self.emit_nonnull_c_guard(operands.target, span, body)
        let raw_results = list[RegisterId]()
        if not types_match(source_result, resolve_builtin_type(BuiltinType.unit)):
            raw_results.append(self.state.new_register(try self.state.c_boundary_type_of(module, function, span, source_result)))
        body.append(MirInstruction(form = InstructionForm.CallIndirect(results = self.state.operands.run(raw_results), signature = signature, convention = CallingConvention.c, target = operands.target, arguments = self.state.operands.run(call_arguments)), span = span))
        if len(raw_results) == 0: return RegisterId(value = no_register)
        return try self.decode_c_boundary_value(module, function, span, source_result, raw_results[0], body)

    func lower_fallible_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let operands = try self.lower_indirect_operands(module, function, callee, arguments, body)
        let signature = try self.lower_function_value_signature(module, function, span, node_type(self.state.program, callee))
        if not signature.is_fallible: trap("infallible indirect call entered fallible lowering")
        let successful = self.state.fallible_inner(node_type(self.state.program, expression)) else trap("fallible indirect call has an infallible result")
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let call_arguments = [self.new_temp(error_type, span, body)]
        let results = list[RegisterId]()
        let value = try self.place_call_result(module, function, span, successful, signature.returns_never, call_arguments, results, body)
        for argument in operands.values: call_arguments.append(argument)
        let reported_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        results.append(reported_error)
        body.append(MirInstruction(form = InstructionForm.CallClosure(results = self.state.operands.run(results), signature = signature, target = operands.target, arguments = self.state.operands.run(call_arguments)), span = span))
        return FallibleResult(value = value, error_value = reported_error)

    func lower_fallible_call(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let target = self.state.function_index_of(callee)
        if target < 0: try self.state.fail_unsupported(module, function, span, "a call to a symbol that is not a function")
        let called = self.state.program.functions[target]
        let successful = self.state.fallible_inner(called.result) else error(self.state.unsupported(module, function, span, "a non-fallible call in fallible lowering"))
        let returns_never = types_match(successful, resolve_builtin_type(BuiltinType.never_type))
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_temp = self.new_temp(error_type, span, body)
        let call_arguments = [error_temp]
        let results = list[RegisterId]()
        let value = try self.place_call_result(module, function, span, successful, returns_never, call_arguments, results, body)
        for argument in placed: call_arguments.append(argument)
        let reported_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        results.append(reported_error)
        self.emit_call(target, results, call_arguments, span, body)
        return FallibleResult(value = value, error_value = reported_error)

    # A fallible initializer writes into fresh caller-owned struct storage and
    # returns the ordinary caller-owned Error pointer. Its source-level unit
    # success is replaced by the completed storage address in HIR.
    func lower_fallible_initializer(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.state.program, expression)
        let target = self.state.function_index_of(callee)
        if target < 0: try self.state.fail_unsupported(module, function, span, "an initializer symbol that is not a function")
        let called = self.state.program.functions[target]
        let receiver = called.receiver else error(self.state.unsupported(module, function, span, "an initializer without a receiver"))
        if receiver.kind != HirReceiverKind.initializer:
            try self.state.fail_unsupported(module, function, span, "an Initialize node naming a non-initializer")
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let value_type = try self.state.mir_type_of(module, function, span, receiver.owner)
        let class_value = try self.full.lower_fallible_class_initializer(self, module, function, span, target, placed, receiver.owner, value_type, body)
        if class_value != none: return class_value
        let value = self.new_temp(value_type, span, body)
        self.initialize_ownership_at(value_type, value, span, body)
        placed[0] = value
        let error_type = try self.state.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_temp = self.new_temp(error_type, span, body)
        let call_arguments = [error_temp]
        for argument in placed: call_arguments.append(argument)
        let reported_error = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        self.emit_call(target, [reported_error], call_arguments, span, body)
        # The caller owns fresh receiver storage on both outcomes. A failed
        # initializer may have completed only some managed fields; their
        # null-initialized remainder makes one structural release exact.
        if self.type_needs_ownership(value_type):
            let failed = self.error_is_present(reported_error, span, body)
            self.open_if(failed, list[RegisterId](), span, body)
            self.emit_ownership_call(value_type, value, false, span, body)
            self.emit_end(span, body)
        return FallibleResult(value = value, error_value = reported_error)

    # Arguments are lowered in the order they were written, then placed by
    # the parameter index HIR resolved for each (named arguments may be
    # written in any order). The callee is a `FunctionId`, its index in
    # `program.functions`, which is the same index in the MIR program.
    ## Where one call's successful value lands: for an aggregate, a fresh slot
    ## whose address leads the source arguments; otherwise a result register;
    ## and no register at all for `unit` or `never`.
    pub func place_call_result(module: HirModule, function: HirFunction, span: SourceSpan, result: ir.TypeId, returns_never: bool, call_arguments: list[RegisterId], results: list[RegisterId], body: list[MirInstruction]) -> RegisterId!:
        if returns_never or types_match(result, resolve_builtin_type(BuiltinType.unit)): return RegisterId(value = no_register)
        let result_type = try self.state.mir_type_of(module, function, span, result)
        if self.is_aggregate(result_type):
            let slot = self.new_temp(result_type, span, body)
            call_arguments.append(slot)
            return slot
        let register = self.state.new_register(result_type)
        results.append(register)
        return register

    func lower_call(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let target = self.state.function_index_of(callee)
        if target < 0: try self.state.fail_unsupported(module, function, span, "a call to a symbol that is not a function")
        let called = self.state.program.functions[target]
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        match called.implementation:
            ExternalC(contract): return try self.lower_c_import_call(module, function, span, target, called, contract, placed, body)
            else: pass
        let call_arguments = list[RegisterId]()
        let results = list[RegisterId]()
        let returns_never = types_match(called.result, resolve_builtin_type(BuiltinType.never_type))
        let value = try self.place_call_result(module, function, span, called.result, returns_never, call_arguments, results, body)
        for argument in placed: call_arguments.append(argument)
        self.emit_call(target, results, call_arguments, span, body)
        if returns_never:
            body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        return value

    # Adapt one host-supplied C call without changing ordinary HIR or canonical
    # MIR value representations. Nullable pointer handles are tagged optionals
    # everywhere except the raw call operands/results; bare nulls trap at this
    # exact boundary in both directions.
    func lower_c_import_call(module: HirModule, function: HirFunction, span: SourceSpan, target: i64, called: HirFunction, contract: HirCFunction, placed: list[RegisterId], body: list[MirInstruction]) -> RegisterId!:
        let encoded = list[RegisterId]()
        let temporaries = list[CInputTemporary]()
        let output_slots = list[COutputSlot]()
        for slot in contract.slots:
            match slot:
                Input(parameter):
                    let value_type = called.parameters[parameter].value_type
                    encoded.append(try self.encode_c_import_value(module, function, span, value_type, placed[parameter], temporaries, body))
                Output(name, value_type):
                    var raw_type = try self.state.c_boundary_type_of(module, function, span, value_type)
                    # The call operand is still one pointer, but C writes the
                    # aggregate itself into this slot rather than a pointer
                    # value into a pointer-to-pointer slot.
                    if self.state.is_c_struct(value_type):
                        raw_type = try self.state.c_record_type_of(module, function, span, value_type)
                    let address = self.new_temp(raw_type, span, body)
                    encoded.append(address)
                    output_slots.append(COutputSlot(value_type = value_type, raw_type = raw_type, address = address))
        let raw_results = list[RegisterId]()
        if not types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            let raw_result = try self.state.c_boundary_type_of(module, function, span, contract.declared_result)
            raw_results.append(self.state.new_register(signature_register_type(self.state.types, CallingConvention.c, raw_result)))
        self.emit_call(target, raw_results, encoded, span, body)

        let values = list[RegisterId]()
        let value_types = list[ir.TypeId]()
        if len(raw_results) > 0:
            values.append(try self.decode_c_boundary_value(module, function, span, contract.declared_result, raw_results[0], body))
            value_types.append(contract.declared_result)
        for output in output_slots:
            let raw_value = self.load_value(output.raw_type, output.address, span, body)
            values.append(try self.decode_c_boundary_value(module, function, span, output.value_type, raw_value, body))
            value_types.append(output.value_type)

        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        for temporary in temporaries:
            body.append(MirInstruction(form = InstructionForm.DeallocateStorage(address = temporary.address, element_type = byte_type, count = temporary.count), span = span))

        if len(values) == 0: return RegisterId(value = no_register)
        if len(values) == 1: return values[0]
        let tuple_type = try self.state.mir_type_of(module, function, span, called.result)
        let result = self.new_temp(tuple_type, span, body)
        for index in range(0, len(values)):
            let field = self.field_address(tuple_type, result, index, span, body)
            let field_type = try self.state.mir_type_of(module, function, span, value_types[index])
            self.store_value(field_type, field, values[index], span, body)
        return result

    # Adapt the two borrowed high-level inputs without changing their ordinary
    # MIR representation. Lists lend dense storage directly. A string has no
    # promised spare byte, so it receives exact call-scoped storage plus a C
    # terminator; cleanup waits until every possibly aliasing result is copied.
    func encode_c_import_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, temporaries: list[CInputTemporary], body: list[MirInstruction]) -> RegisterId!:
        match self.state.program.types.definitions[value_type.value].form:
            List(element): return try self.encode_borrowed_c_list(module, function, span, value, element, body)
            else: pass
        if not types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            return try self.encode_c_boundary_value(module, function, span, value_type, value, body)
        let text_type = try self.state.mir_type_of(module, function, span, value_type)
        let data = try self.load_field(text_type, value, self.state.buffer_data_field(), span, body)
        let length = try self.load_field(text_type, value, self.state.buffer_length_field(), span, body)
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let one = self.integer_constant(u64_type, 1, span, body)
        let count = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = count, operation = BinaryOp.add, left = length, right = one), span = span))
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.AllocateStorage(result = address, element_type = byte_type, count = count), span = span))
        body.append(MirInstruction(form = InstructionForm.MoveElements(destination = address, source = data, element_type = byte_type, count = length), span = span))
        let terminator = self.element_address(byte_type, address, length, span, body)
        self.store_value(byte_type, terminator, self.integer_constant(byte_type, 0, span, body), span, body)
        temporaries.append(CInputTemporary(address = address, count = count))
        return address

    # Lists already own dense C-width element storage in the runtime. The
    # adapter therefore exposes the first element directly, or null for the
    # empty value, and never packs or copies. Bare pointer-shaped elements are
    # checked in a target-neutral loop before C can observe a forged null.
    func encode_borrowed_c_list(module: HirModule, function: HirFunction, span: SourceSpan, value: RegisterId, element_hir_type: ir.TypeId, body: list[MirInstruction]) -> RegisterId!:
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let length = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.ListLength(result = length, value = value), span = span))

        let zero = self.integer_constant(index_type, 0, span, body)
        if self.state.is_c_data_pointer(element_hir_type):
            let element_type = try self.state.mir_type_of(module, function, span, element_hir_type)
            let loop = self.begin_counted_loop(zero, length, list[RegisterId](), span, body)
            self.exit_counted_loop_when_done(loop, list[RegisterId](), span, body)
            let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = value, index = loop.index), span = span))
            self.emit_nonnull_c_guard(self.load_value(element_type, address, span, body), span, body)
            self.end_counted_loop(loop, span, body)

        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let empty = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = empty, operation = BinaryOp.eq, left = length, right = zero), span = span))
        self.open_if(empty, [result], span, body)
        self.emit_yield(self.null_constant(span, body), span, body)
        self.emit_else(span, body)
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = value, index = zero), span = span))
        self.emit_yield(address, span, body)
        self.emit_end(span, body)
        return result

    # Internal value -> C slot. Only nullable pointer-shaped values need
    # structural conversion; a bare pointer is validated, and every other
    # admitted scalar already has its canonical C-width MIR type.
    func encode_c_boundary_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let c_enum = self.state.c_enum_shape(value_type)
        if c_enum != none:
            let enum_type = try self.state.mir_type_of(module, function, span, value_type)
            let shape = c_enum
            let representation = try self.state.mir_type_of(module, function, span, shape.representation)
            return self.encode_c_enum(enum_type, representation, value, shape, span, body)
        if self.state.is_c_struct(value_type):
            return try self.transcode_c_record(module, function, span, value_type, value, true, body)
        let optional_inner = self.state.optional_c_pointer(value_type)
        if optional_inner != none:
            let optional_type = try self.state.mir_type_of(module, function, span, value_type)
            let present = self.load_present(value, span, body)
            let encoded = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
            self.open_if(present, [encoded], span, body)
            let payload = self.load_value(
                builtin_mir_type(BuiltinMirType.pointer),
                self.payload_address(optional_type, value, span, body),
                span,
                body,
            )
            self.emit_yield(payload, span, body)
            self.emit_else(span, body)
            self.emit_yield(self.null_constant(span, body), span, body)
            self.emit_end(span, body)
            return encoded
        if self.state.is_c_data_pointer(value_type) or self.state.is_c_function(value_type): self.emit_nonnull_c_guard(value, span, body)
        return value

    # Standard-library reads keep the source token opaque until this shared
    # lowering point. Both operations reject null before consulting foreign
    # memory and materialize the ordinary owned `{owner, data, length}` value.
    func lower_foreign_bytes_copy(module: HirModule, function: HirFunction, expression: NodeId, pointer: NodeId, count: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source = try self.lower_expression(module, function, pointer, body)
        let length = try self.lower_expression(module, function, count, body)
        self.emit_nonnull_c_guard(source, span, body)
        let builder = self.state.new_register(intern_mir_type(self.state.types, MirType.BufferBuilder))
        body.append(MirInstruction(form = InstructionForm.BufferBuilderCreate(result = builder), span = span))
        body.append(MirInstruction(form = InstructionForm.BufferBuilderAppend(builder = builder, data = source, length = length), span = span))
        let owner = self.state.new_register(builtin_mir_type(BuiltinMirType.buffer_owner))
        body.append(MirInstruction(form = InstructionForm.BufferBuilderFinish(result = owner, builder = builder), span = span))
        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        return self.materialize_owned_buffer(value_type, owner, span, body)

    func lower_foreign_c_string_copy(module: HirModule, function: HirFunction, expression: NodeId, pointer: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let source = try self.lower_expression(module, function, pointer, body)
        return try self.copy_c_string_value(module, function, span, node_type(self.state.program, expression), source, body)

    func copy_c_string_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, source: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        self.emit_nonnull_c_guard(source, span, body)
        let owner = self.state.new_register(builtin_mir_type(BuiltinMirType.buffer_owner))
        body.append(MirInstruction(form = InstructionForm.CStringCopy(result = owner, source = source), span = span))
        let aggregate_type = try self.state.mir_type_of(module, function, span, value_type)
        return self.materialize_owned_buffer(aggregate_type, owner, span, body)

    # C slot -> internal value. Decoding allocates the ordinary tagged
    # optional before any source operation can observe the value.
    func decode_c_boundary_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let c_enum = self.state.c_enum_shape(value_type)
        if c_enum != none:
            let enum_type = try self.state.mir_type_of(module, function, span, value_type)
            let shape = c_enum
            let representation = try self.state.mir_type_of(module, function, span, shape.representation)
            return self.decode_c_enum(enum_type, representation, value, shape, span, body)
        if self.state.is_c_struct(value_type):
            return try self.transcode_c_record(module, function, span, value_type, value, false, body)
        if types_match(value_type, resolve_builtin_type(BuiltinType.string)):
            return try self.copy_c_string_value(module, function, span, value_type, value, body)
        let optional_inner = self.state.optional_c_pointer(value_type)
        if optional_inner != none:
            let optional_type = try self.state.mir_type_of(module, function, span, value_type)
            let decoded = self.new_temp(optional_type, span, body)
            let null_value = self.null_constant(span, body)
            let present = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Binary(result = present, operation = BinaryOp.ne, left = value, right = null_value), span = span))
            self.open_if(present, list[RegisterId](), span, body)
            self.store_optional_tag(decoded, 1, span, body)
            self.store_value(
                builtin_mir_type(BuiltinMirType.pointer),
                self.payload_address(optional_type, decoded, span, body),
                value,
                span,
                body,
            )
            self.emit_else(span, body)
            self.store_optional_tag(decoded, 0, span, body)
            self.emit_end(span, body)
            return decoded
        if self.state.is_c_data_pointer(value_type): self.emit_nonnull_c_guard(value, span, body)
        return value

    # Exported C enums remain ordinary tagged semantic enums everywhere except
    # an explicit C slot. Flat structured dispatch keeps IR and lowering stack
    # depth constant even for a generated enum with many cases; backends still
    # own physical placement and calling ABI.
    func encode_c_enum(enum_type: TypeId, representation: TypeId, value: RegisterId, shape: HirCEnum, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let tag = self.load_enum_tag(enum_type, value, span, body)
        let result = self.state.new_register(representation)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
        for index in range(0, len(shape.values)):
            let wanted = self.integer_constant(self.enum_tag_type(enum_type), index, span, body)
            let selected = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Binary(result = selected, operation = BinaryOp.eq, left = tag, right = wanted), span = span))
            self.open_if(selected, list[RegisterId](), span, body)
            let encoded = self.c_enum_constant(representation, shape.values[index], span, body)
            body.append(MirInstruction(form = InstructionForm.Br(depth = 1, values = self.state.operands.run([encoded])), span = span))
            self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "invalid exported C enum case"), span = span))
        self.emit_end(span, body)
        return result

    func decode_c_enum(enum_type: TypeId, representation: TypeId, value: RegisterId, shape: HirCEnum, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
        for index in range(0, len(shape.values)):
            let wanted = self.c_enum_constant(representation, shape.values[index], span, body)
            let selected = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Binary(result = selected, operation = BinaryOp.eq, left = value, right = wanted), span = span))
            self.open_if(selected, list[RegisterId](), span, body)
            let decoded = self.new_temp(enum_type, span, body)
            self.store_enum_tag(enum_type, decoded, index, span, body)
            body.append(MirInstruction(form = InstructionForm.Br(depth = 1, values = self.state.operands.run([decoded])), span = span))
            self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "invalid C enum value"), span = span))
        self.emit_end(span, body)
        return result

    func c_enum_constant(representation: TypeId, value: Value, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        match value:
            SignedInteger(item): return self.signed_integer_constant(representation, item, span, body)
            UnsignedInteger(item): return self.unsigned_integer_constant(representation, item, span, body)
            else: trap("exported C enum has a non-integer boundary value")

    # Materialize call-owned boundary storage member by member. Internal and C
    # record shapes are distinct structural MIR types, because a nested fixed
    # C enum is scalar only in the latter. Backends alone place either shape.
    func transcode_c_record(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, source: RegisterId, encoding: bool, body: list[MirInstruction]) -> RegisterId!:
        let internal_type = try self.state.mir_type_of(module, function, span, value_type)
        let boundary_type = try self.state.c_record_type_of(module, function, span, value_type)
        var destination_type = internal_type
        if encoding: destination_type = boundary_type
        let destination = self.new_temp(destination_type, span, body)
        try self.transcode_c_record_fields(module, function, span, value_type, internal_type, boundary_type, source, destination, encoding, body)
        return destination

    func transcode_c_record_fields(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, internal_type: TypeId, boundary_type: TypeId, source: RegisterId, destination: RegisterId, encoding: bool, body: list[MirInstruction]) -> !:
        var source_type = boundary_type
        var destination_type = internal_type
        if encoding:
            source_type = internal_type
            destination_type = boundary_type
        let fields = ir.nominal_fields(self.state.program, value_type)
        for index in range(0, len(fields)):
            let field = fields[index]
            let internal_field_type = try self.state.mir_type_of(module, function, span, field.value_type)
            let boundary_field_type = try self.state.c_boundary_type_of(module, function, span, field.value_type)
            let source_field = self.field_address(source_type, source, index, span, body)
            let destination_field = self.field_address(destination_type, destination, index, span, body)
            if self.state.is_c_struct(field.value_type):
                let nested_boundary = try self.state.c_record_type_of(module, function, span, field.value_type)
                try self.transcode_c_record_fields(module, function, span, field.value_type, internal_field_type, nested_boundary, source_field, destination_field, encoding, body)
                continue
            var source_field_type = boundary_field_type
            var destination_field_type = internal_field_type
            if encoding:
                source_field_type = internal_field_type
                destination_field_type = boundary_field_type
            let field_value = self.load_value(source_field_type, source_field, span, body)
            var converted = field_value
            if encoding: converted = try self.encode_c_boundary_value(module, function, span, field.value_type, field_value, body)
            elif self.state.c_enum_shape(field.value_type) != none:
                converted = try self.decode_c_boundary_value(module, function, span, field.value_type, field_value, body)
            # External records are raw snapshots: pointer/cfunc fields may be
            # null until a later explicit input crossing consumes them. An
            # exported record is itself that public input contract, so its
            # fields receive the ordinary inbound validation here.
            elif self.state.is_exported_c_struct(value_type):
                converted = try self.decode_c_boundary_value(module, function, span, field.value_type, field_value, body)
            self.store_value(destination_field_type, destination_field, converted, span, body)

    func emit_nonnull_c_guard(value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let null_value = self.null_constant(span, body)
        let is_null = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_null, operation = BinaryOp.eq, left = value, right = null_value), span = span))
        self.open_if(is_null, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "null_foreign"), span = span))
        self.emit_end(span, body)

    # The non-fallible form uses the same fresh receiver slot without an
    # Error parameter. The initializer returns unit; the expression returns
    # the slot it completed.
    func lower_initializer(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let target = self.state.function_index_of(callee)
        if target < 0: try self.state.fail_unsupported(module, function, span, "an initializer symbol that is not a function")
        let called = self.state.program.functions[target]
        let receiver = called.receiver else error(self.state.unsupported(module, function, span, "an initializer without a receiver"))
        if receiver.kind != HirReceiverKind.initializer:
            try self.state.fail_unsupported(module, function, span, "an Initialize node naming a non-initializer")
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let value_type = try self.state.mir_type_of(module, function, span, receiver.owner)
        let class_value = self.full.lower_class_initializer(self, module, function, span, target, placed, receiver.owner, value_type, body)
        if class_value != none: return class_value
        let value = self.new_temp(value_type, span, body)
        self.initialize_ownership_at(value_type, value, span, body)
        placed[0] = value
        self.emit_call(target, list[RegisterId](), placed, span, body)
        return value

    # The sole HIR-call → MIR-call split. Argument and result placement is
    # shared; only the identity space changes at the canonical MIR boundary.
    pub func emit_call(target: i64, results: list[RegisterId], arguments: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        let result_run = self.state.operands.run(results)
        let argument_run = self.state.operands.run(arguments)
        match self.state.lowered_functions[target]:
            Defined(function):
                body.append(MirInstruction(form = InstructionForm.Call(results = result_run, function = function, arguments = argument_run), span = span))
            External(external):
                body.append(MirInstruction(form = InstructionForm.CallExtern(results = result_run, external = external, arguments = argument_run), span = span))

    # `a and b` evaluates `b` only when `a` is true; `a or b` only when `a`
    # is false. Both are an `If` whose unevaluated arm yields the constant
    # that decided the answer.
    func lower_short_circuit(module: HirModule, function: HirFunction, expression: NodeId, left: NodeId, right: NodeId, is_and: bool, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let expression_span = node_span(self.state.program, expression)
        let left_start = len(self.state.defers)
        let left_register = try self.lower_expression(module, function, left, body)
        try self.emit_temporaries_from(left_start, body)
        let result = self.state.new_register(boolean)
        self.open_if(left_register, [result], expression_span, body)
        # `and`: the left decided only when false; `or`: only when true.
        if is_and:
            let right_start = len(self.state.defers)
            let right_register = try self.lower_expression(module, function, right, body)
            if not node_diverges(self.state.program, right):
                try self.emit_temporaries_from(right_start, body)
                self.emit_yield(right_register, expression_span, body)
            self.emit_else(expression_span, body)
            let decided = self.bool_constant(false, expression_span, body)
            self.emit_yield(decided, expression_span, body)
        else:
            let decided = self.bool_constant(true, expression_span, body)
            self.emit_yield(decided, expression_span, body)
            self.emit_else(expression_span, body)
            let right_start = len(self.state.defers)
            let right_register = try self.lower_expression(module, function, right, body)
            if not node_diverges(self.state.program, right):
                try self.emit_temporaries_from(right_start, body)
                self.emit_yield(right_register, expression_span, body)
        self.emit_end(expression_span, body)
        return result

    # mark: Numeric construction ===============================================================

    # Preserve one HIR numeric construction while selecting the canonical MIR
    # conversion family from its resolved source and destination types.
    func lower_numeric_conversion(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let hir_source = node_type(self.state.program, value)
        let hir_destination = node_type(self.state.program, expression)
        if ir.is_pointer_integer_type(self.state.program.types, hir_source) or ir.is_pointer_integer_type(self.state.program.types, hir_destination):
            # Only the implicit widening of base.md §7.5 has a canonical form so far.
            if is_implicit_widening(self.state.program.types, hir_source, hir_destination):
                return try self.lower_widening(module, function, expression, value, body)
            try self.state.fail_unsupported(module, function, node_span(self.state.program, expression), "a numeric conversion to or from a pointer-width integer (the Base cast family, B1d)")
        if ir.is_integer_type(self.state.program.types, hir_source) and ir.is_integer_type(self.state.program.types, hir_destination):
            return try self.lower_integer_conversion(module, function, expression, value, body)

        let span = node_span(self.state.program, expression)
        let operand = try self.lower_expression(module, function, value, body)
        let source_type = try self.state.mir_type_of(module, function, span, hir_source)
        let destination_type = try self.state.mir_type_of(module, function, span, hir_destination)
        if source_type.value == destination_type.value: return operand

        let result = self.state.new_register(destination_type)
        var operation = ConvertOp.float_resize
        if is_int_type(self.state.types, source_type):
            operation = ConvertOp.int_to_float
            if bits_of(self.state.types, destination_type) == 16:
                if is_signed_int_type(self.state.types, source_type):
                    if int_maximum(self.state.types, source_type) > 65519:
                        self.emit_signed_conversion_bound(operand, source_type, BinaryOp.gt, 65519, span, body)
                    if int_minimum(self.state.types, source_type) < -65519:
                        self.emit_signed_conversion_bound(operand, source_type, BinaryOp.lt, -65519, span, body)
                else:
                    if uint_maximum(self.state.types, source_type) > u64(65519):
                        self.emit_unsigned_conversion_bound(operand, source_type, u64(65519), span, body)
        elif is_int_type(self.state.types, destination_type): operation = ConvertOp.float_to_int
        else:
            # IEEE narrowing rounds, but a finite value outside the narrower
            # finite range must not silently become infinity. NaN and existing
            # infinities remain IEEE values of the narrower type.
            if bits_of(self.state.types, destination_type) == 16:
                self.emit_float_conversion_bound(operand, source_type, BinaryOp.ge, 65520.0, span, body)
                self.emit_float_conversion_bound(operand, source_type, BinaryOp.le, -65520.0, span, body)
            elif bits_of(self.state.types, source_type) == 64 and bits_of(self.state.types, destination_type) == 32:
                self.emit_float_conversion_bound(operand, source_type, BinaryOp.gt, 3.4028234663852886e38, span, body)
                self.emit_float_conversion_bound(operand, source_type, BinaryOp.lt, -3.4028234663852886e38, span, body)
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = operation, operand = operand), span = span))
        return result

    # Explicit integer construction checks the destination interval before
    # MIR changes representation. Widening uses the source signedness;
    # narrowing wraps only after the guards prove that no bits are lost.
    func lower_integer_conversion(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let operand = try self.lower_expression(module, function, value, body)
        let source_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        let destination_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        if source_type.value == destination_type.value: return operand

        let source_signed = is_signed_int_type(self.state.types, source_type)
        let destination_signed = is_signed_int_type(self.state.types, destination_type)
        if source_signed:
            if not destination_signed:
                self.emit_signed_conversion_bound(operand, source_type, BinaryOp.lt, 0, span, body)
                let destination_maximum = uint_maximum(self.state.types, destination_type)
                if destination_maximum <= u64(9223372036854775807) and i64(destination_maximum) < int_maximum(self.state.types, source_type):
                    self.emit_signed_conversion_bound(operand, source_type, BinaryOp.gt, i64(destination_maximum), span, body)
            else:
                let source_minimum = int_minimum(self.state.types, source_type)
                let source_maximum = int_maximum(self.state.types, source_type)
                let destination_minimum = int_minimum(self.state.types, destination_type)
                let destination_maximum = int_maximum(self.state.types, destination_type)
                if destination_minimum > source_minimum:
                    self.emit_signed_conversion_bound(operand, source_type, BinaryOp.lt, destination_minimum, span, body)
                if destination_maximum < source_maximum:
                    self.emit_signed_conversion_bound(operand, source_type, BinaryOp.gt, destination_maximum, span, body)
        else:
            var destination_maximum = uint_maximum(self.state.types, destination_type)
            if destination_signed: destination_maximum = u64(int_maximum(self.state.types, destination_type))
            if destination_maximum < uint_maximum(self.state.types, source_type):
                self.emit_unsigned_conversion_bound(operand, source_type, destination_maximum, span, body)

        let result = self.state.new_register(destination_type)
        var operation = ConvertOp.wrap
        if bits_of(self.state.types, destination_type) > bits_of(self.state.types, source_type): operation = ConvertOp.extend
        elif bits_of(self.state.types, destination_type) == bits_of(self.state.types, source_type): operation = ConvertOp.int_reinterpret
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = operation, operand = operand), span = span))
        return result

    # `a +? b`: the overflow test and the wrapped value are two canonical
    # instructions; the optional is `none` exactly when the test holds.
    func lower_checked_optional(module: HirModule, function: HirFunction, span: SourceSpan, optional_type: TypeId, wrapping: BinaryOp, overflow_test: BinaryOp, operand_type: TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let temp = self.new_temp(optional_type, span, body)
        let overflows = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = overflows, operation = overflow_test, left = left, right = right), span = span))
        let wrapped = self.state.new_register(operand_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = wrapped, operation = wrapping, left = left, right = right), span = span))
        self.open_if(overflows, list[RegisterId](), span, body)
        self.store_optional_tag(temp, 0, span, body)
        self.emit_else(span, body)
        self.store_optional_tag(temp, 1, span, body)
        let payload = self.payload_address(optional_type, temp, span, body)
        self.initialize_owned_value(operand_type, payload, wrapped, span, body)
        self.emit_end(span, body)
        return temp

    # The two words of a text literal: the data address and its byte count.
    func lower_text_constant(value_type: TypeId, text: str, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let payload = strings.to_bytes(text)
        let data_id = self.add_data("text", payload)
        let temp = self.new_temp(value_type, span, body)
        let pointer = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = pointer, data = DataId(value = u32(data_id))), span = span))
        self.store_value(builtin_mir_type(BuiltinMirType.pointer), self.field_address(value_type, temp, 0, span, body), pointer, span, body)
        let usize_type = pointer_int_type(self.state.types, false)
        self.store_value(usize_type, self.field_address(value_type, temp, 1, span, body), self.integer_constant(usize_type, len(payload), span, body), span, body)
        return temp

    # `s[start..<end]`: `start <= end <= length` or a trap, then the sub-span
    # `(data + start, end - start)`; `..=` includes `end` (base.md §5.4).
    func lower_span_slice(module: HirModule, function: HirFunction, span: SourceSpan, value_type: TypeId, viewed: NodeId, start: NodeId, end: NodeId, inclusive: bool, body: list[MirInstruction]) -> RegisterId!:
        let span_value = try self.lower_expression(module, function, viewed, body)
        let low = try self.lower_expression(module, function, start, body)
        let usize_type = pointer_int_type(self.state.types, false)
        var high = try self.load_field(value_type, span_value, 1, span, body)
        if end.value != no_node: high = try self.lower_expression(module, function, end, body)
        if inclusive:
            let bumped = self.state.new_register(usize_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = bumped, operation = BinaryOp.add, left = high, right = self.integer_constant(usize_type, 1, span, body)), span = span))
            high = bumped
        let element_type = try self.state.mir_type_of(module, function, span, span_element_of(self.state.program.types, node_type(self.state.program, viewed)))
        let data = try self.load_field(value_type, span_value, 0, span, body)
        let length = try self.load_field(value_type, span_value, 1, span, body)
        let ordered = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = ordered, operation = BinaryOp.le, left = low, right = high), span = span))
        let within = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = within, operation = BinaryOp.le, left = high, right = length), span = span))
        let valid = self.lower_and(ordered, within, span, body)
        self.open_if(valid, list[RegisterId](), span, body)
        self.emit_else(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "slice out of bounds"), span = span))
        self.emit_end(span, body)
        let temp = self.new_temp(value_type, span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.pointer), self.field_address(value_type, temp, 0, span, body), self.element_address(element_type, data, low, span, body), span, body)
        let count = self.state.new_register(usize_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = count, operation = BinaryOp.sub, left = high, right = low), span = span))
        self.store_value(usize_type, self.field_address(value_type, temp, 1, span, body), count, span, body)
        return temp

    # `for x in items` over a span or an array: index from 0 to the length,
    # loading each element by value (base.md §8.3).
    func lower_span_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        var iterable_type = node_type(self.state.program, iterable)
        let sequence = try self.lower_expression(module, function, iterable, body)
        let usize_type = pointer_int_type(self.state.types, false)
        # `&items` iterates the pointee's elements by address instead of by value.
        var by_address = false
        match self.state.program.types.definitions[iterable_type.value].form:
            Pointer(pointee, is_const, is_volatile):
                by_address = true
                iterable_type = pointee
            else: pass
        var data = sequence
        var length = self.integer_constant(usize_type, 0, span, body)
        var element_hir = resolve_builtin_type(BuiltinType.unit)
        match self.state.program.types.definitions[iterable_type.value].form:
            Span(element, is_const):
                let span_type = try self.state.mir_type_of(module, function, span, iterable_type)
                data = try self.load_field(span_type, sequence, 0, span, body)
                length = try self.load_field(span_type, sequence, 1, span, body)
                element_hir = element
            Array(element, count):
                length = self.integer_constant(usize_type, count, span, body)
                element_hir = element
            else: trap("span iteration over a non-sequence")
        let element_type = try self.state.mir_type_of(module, function, span, element_hir)
        let counter = self.new_temp(usize_type, span, body)
        self.store_value(usize_type, counter, self.integer_constant(usize_type, 0, span, body), span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)

        let offset = self.load_value(usize_type, counter, span, body)
        let done = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = offset, right = length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))
        let binding = (try self.state.local_of(module, function, span, symbol)).address
        let element_address = self.element_address(element_type, data, offset, span, body)
        if by_address: self.store_value(builtin_mir_type(BuiltinMirType.pointer), binding, element_address, span, body)
        else: self.initialize_owned_value(element_type, binding, self.load_value(element_type, element_address, span, body), span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        try self.lower_loop_scope(module, function, statements, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)

        let next = self.state.new_register(usize_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = offset, right = self.integer_constant(usize_type, 1, span, body)), span = span))
        self.store_value(usize_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # `for character in text` over a Base view: UTF-8 decoded inline, one
    # scalar per pass, with no runtime service (base.md §5.5). The view's
    # invariant makes every lead byte trustworthy, so the width comes from
    # the lead byte alone and the continuation bytes contribute six bits each.
    func lower_text_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        let view = try self.lower_expression(module, function, iterable, body)
        let view_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, iterable))
        let data = try self.load_field(view_type, view, 0, span, body)
        let length = try self.load_field(view_type, view, 1, span, body)
        let usize_type = pointer_int_type(self.state.types, false)
        let u32_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let counter = self.new_temp(usize_type, span, body)
        self.store_value(usize_type, counter, self.integer_constant(usize_type, 0, span, body), span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.block)
        self.state.regions.append(Region.loop_body)

        let offset = self.load_value(usize_type, counter, span, body)
        let done = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = offset, right = length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))

        let lead = self.text_byte_at(data, offset, 0, span, body)
        let four = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = four, operation = BinaryOp.ge, left = lead, right = self.integer_constant(u32_type, 240, span, body)), span = span))
        let three = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = three, operation = BinaryOp.ge, left = lead, right = self.integer_constant(u32_type, 224, span, body)), span = span))
        let two = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = two, operation = BinaryOp.ge, left = lead, right = self.integer_constant(u32_type, 192, span, body)), span = span))

        # The scalar's width in bytes.
        let width = self.state.new_register(usize_type)
        self.open_if(four, [width], span, body)
        self.emit_yield(self.integer_constant(usize_type, 4, span, body), span, body)
        self.emit_else(span, body)
        let width_three = self.state.new_register(usize_type)
        self.open_if(three, [width_three], span, body)
        self.emit_yield(self.integer_constant(usize_type, 3, span, body), span, body)
        self.emit_else(span, body)
        let width_two = self.state.new_register(usize_type)
        self.open_if(two, [width_two], span, body)
        self.emit_yield(self.integer_constant(usize_type, 2, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(self.integer_constant(usize_type, 1, span, body), span, body)
        self.emit_end(span, body)
        self.emit_yield(width_two, span, body)
        self.emit_end(span, body)
        self.emit_yield(width_three, span, body)
        self.emit_end(span, body)

        # The lead byte's payload bits, then six bits per continuation byte.
        let code = self.state.new_register(u32_type)
        self.open_if(four, [code], span, body)
        self.emit_yield(self.text_bits(lead, 7, span, body), span, body)
        self.emit_else(span, body)
        let code_three = self.state.new_register(u32_type)
        self.open_if(three, [code_three], span, body)
        self.emit_yield(self.text_bits(lead, 15, span, body), span, body)
        self.emit_else(span, body)
        let code_two = self.state.new_register(u32_type)
        self.open_if(two, [code_two], span, body)
        self.emit_yield(self.text_bits(lead, 31, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(lead, span, body)
        self.emit_end(span, body)
        self.emit_yield(code_two, span, body)
        self.emit_end(span, body)
        self.emit_yield(code_three, span, body)
        self.emit_end(span, body)
        var scalar = code
        for position in range(1, 4):
            let more = self.state.new_register(boolean)
            body.append(MirInstruction(form = InstructionForm.Binary(result = more, operation = BinaryOp.gt, left = width, right = self.integer_constant(usize_type, position, span, body)), span = span))
            let extended = self.state.new_register(u32_type)
            self.open_if(more, [extended], span, body)
            let shifted = self.state.new_register(u32_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = shifted, operation = BinaryOp.shift_left, left = scalar, right = self.integer_constant(u32_type, 6, span, body)), span = span))
            let continuation = self.text_bits(self.text_byte_at(data, offset, position, span, body), 63, span, body)
            let joined = self.state.new_register(u32_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = joined, operation = BinaryOp.bit_or, left = shifted, right = continuation), span = span))
            self.emit_yield(joined, span, body)
            self.emit_else(span, body)
            self.emit_yield(scalar, span, body)
            self.emit_end(span, body)
            scalar = extended
        let binding = (try self.state.local_of(module, function, span, symbol)).address
        self.store_value(u32_type, binding, scalar, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.state.regions.append(Region.for_continue)
        try self.lower_loop_scope(module, function, statements, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)

        let next = self.state.new_register(usize_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = offset, right = width), span = span))
        self.store_value(usize_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.state.regions.remove(len(self.state.regions) - 1)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # The byte at `offset + position`, widened to `u32`.
    func text_byte_at(data: RegisterId, offset: RegisterId, position: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let usize_type = pointer_int_type(self.state.types, false)
        let u8_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        var at = offset
        if position > 0:
            at = self.state.new_register(usize_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = at, operation = BinaryOp.add, left = offset, right = self.integer_constant(usize_type, position, span, body)), span = span))
        let byte = self.load_value(u8_type, self.element_address(u8_type, data, at, span, body), span, body)
        let wide = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u32))
        body.append(MirInstruction(form = InstructionForm.Convert(result = wide, operation = ConvertOp.extend, operand = byte), span = span))
        return wide

    func text_bits(value: RegisterId, mask: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let u32_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
        let masked = self.state.new_register(u32_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = masked, operation = BinaryOp.bit_and, left = value, right = self.integer_constant(u32_type, mask, span, body)), span = span))
        return masked

    # `&place` (base.md §6.6): the root's address, then the field and element
    # addresses of the path. Locals live in frame slots, so a local's address
    # is its slot; a pointer root is the pointer's value.
    func lower_address_of(module: HirModule, function: HirFunction, span: SourceSpan, pointer: NodeId, symbol: SymbolId, global: i64, steps: Operands, body: list[MirInstruction]) -> RegisterId!:
        var address = RegisterId(value = 0)
        var place_type = resolve_builtin_type(BuiltinType.unit)
        if pointer.value != no_node:
            address = try self.lower_expression(module, function, pointer, body)
            place_type = pointee_of(self.state.program.types, node_type(self.state.program, pointer))
        elif global >= 0:
            try self.state.fail_unsupported(module, function, span, "the address of a global")
        else:
            address = try self.address_of(module, function, span, symbol, body)
            place_type = self.state.program.symbols[symbol.value].value_type
        for position in range(0, i64(steps.count) // 2):
            let kind = u32(entry_at(self.state.program, steps, position * 2))
            let payload = entry_at(self.state.program, steps, position * 2 + 1)
            if kind == place_field_step:
                let struct_type = try self.state.mir_type_of(module, function, span, place_type)
                address = self.field_address(struct_type, address, payload, span, body)
                place_type = self.hir_field_type(place_type, payload)
            elif kind == place_element_step:
                let index = try self.lower_expression(module, function, NodeId(value = u32(payload)), body)
                match self.state.program.types.definitions[place_type.value].form:
                    Array(element, count):
                        let mir_element = try self.state.mir_type_of(module, function, span, element)
                        address = self.checked_element_address(mir_element, address, index, count, span, body)
                        place_type = element
                    else: trap("element address step has a non-array HIR type")
            else: try self.state.fail_unsupported(module, function, span, "the address of a place inside a runtime collection")
        return address

    # C's cast (base.md §7.5) is one conversion with no guard: the backend
    # legalizes `cast_int` at its widths and saturates the float case itself.
    func lower_cast(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let operand = try self.lower_expression(module, function, value, body)
        let source_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        let destination_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        if source_type.value == destination_type.value: return operand
        var operation = ConvertOp.cast_int
        if is_ptr_type(self.state.types, source_type):
            operation = ConvertOp.ptr_to_int
            if is_nullable_ptr_type(self.state.types, destination_type): operation = ConvertOp.ptr_to_nullable
        elif is_nullable_ptr_type(self.state.types, destination_type): operation = ConvertOp.int_to_ptr
        elif is_int_type(self.state.types, source_type):
            if is_float_type(self.state.types, destination_type): operation = ConvertOp.int_to_float
        elif is_int_type(self.state.types, destination_type): operation = ConvertOp.float_to_int_saturating
        else: operation = ConvertOp.float_resize
        let result = self.state.new_register(destination_type)
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = operation, operand = operand), span = span))
        return result

    # `Access(n)` keeps the integer when it is a declared case and traps
    # otherwise (base.md §10.3); flat dispatch like a C enum decode.
    func lower_enum_from_integer(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let enum_type = node_type(self.state.program, expression)
        let shape = ir.integer_enum_shape(self.state.program, enum_type) else trap("checked enum conversion into a tagged enum")
        let representation = try self.state.mir_type_of(module, function, span, enum_type)
        let operand = try self.lower_expression(module, function, value, body)
        let result = self.state.new_register(representation)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
        for declared in shape.values:
            let wanted = self.c_enum_constant(representation, declared, span, body)
            let selected = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Binary(result = selected, operation = BinaryOp.eq, left = operand, right = wanted), span = span))
            self.open_if(selected, list[RegisterId](), span, body)
            body.append(MirInstruction(form = InstructionForm.Br(depth = 1, values = self.state.operands.run([operand])), span = span))
            self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "integer-backed enum conversion of a value that is not a declared case"), span = span))
        self.emit_end(span, body)
        return result

    # A widening no target can narrow needs no guard; the backend that knows
    # the pointer width chooses between an extension and a copy.
    func lower_widening(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, expression)
        let operand = try self.lower_expression(module, function, value, body)
        let destination_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, expression))
        let result = self.state.new_register(destination_type)
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = ConvertOp.widen, operand = operand), span = span))
        return result

    func emit_signed_conversion_bound(operand: RegisterId, source_type: TypeId, operation: BinaryOp, bound: i64, span: SourceSpan, body: list[MirInstruction]):
        let invalid = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(
            result = invalid,
            operation = operation,
            left = operand,
            right = self.signed_integer_constant(source_type, bound, span, body),
        ), span = span))
        self.emit_integer_conversion_guard(invalid, span, body)

    func emit_unsigned_conversion_bound(operand: RegisterId, source_type: TypeId, bound: u64, span: SourceSpan, body: list[MirInstruction]):
        let invalid = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(
            result = invalid,
            operation = BinaryOp.gt,
            left = operand,
            right = self.unsigned_integer_constant(source_type, bound, span, body),
        ), span = span))
        self.emit_integer_conversion_guard(invalid, span, body)

    func emit_integer_conversion_guard(invalid: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        self.open_if(invalid, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "integer conversion out of range"), span = span))
        self.emit_else(span, body)
        self.emit_end(span, body)

    func emit_float_conversion_bound(operand: RegisterId, source_type: TypeId, operation: BinaryOp, bound: f64, span: SourceSpan, body: list[MirInstruction]):
        let constant = self.state.new_register(source_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = constant, value = MirConstant.Float(value = bound)), span = span))
        let invalid = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = invalid, operation = operation, left = operand, right = constant), span = span))
        self.open_if(invalid, list[RegisterId](), span, body)
        # `x - x` is NaN only for an existing infinity or NaN. The ordered
        # bound above is false for NaN, so this inner test distinguishes an
        # infinity (representable) from a finite overflow (must trap) without
        # adding a target-specific classification operation to MIR.
        let difference = self.state.new_register(source_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = difference, operation = BinaryOp.sub, left = operand, right = operand), span = span))
        let non_finite = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = non_finite, operation = BinaryOp.ne, left = difference, right = difference), span = span))
        self.open_if(non_finite, list[RegisterId](), span, body)
        self.emit_else(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "floating-point conversion out of range"), span = span))
        self.emit_end(span, body)
        self.emit_else(span, body)
        self.emit_end(span, body)

    # Emit one `Binary` for a resolved HIR operation on two lowered operands.
    # Comparisons produce a `bool` register; everything else keeps the operand
    # type.
    func lower_binary_operation(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var binary_operation = BinaryOp.add
        var is_comparison = false
        match operation:
            Add(item): binary_operation = BinaryOp.add
            Subtract(item): binary_operation = BinaryOp.sub
            Multiply(item): binary_operation = BinaryOp.mul
            Divide(item): binary_operation = BinaryOp.div
            FloorDivide(item): binary_operation = BinaryOp.floor_div
            Remainder(item): binary_operation = BinaryOp.rem
            TruncDivide(item): binary_operation = BinaryOp.trunc_div
            TruncRemainder(item): binary_operation = BinaryOp.trunc_rem
            WrapAdd(item): binary_operation = BinaryOp.add_wrap
            WrapSubtract(item): binary_operation = BinaryOp.sub_wrap
            WrapMultiply(item): binary_operation = BinaryOp.mul_wrap
            SaturateAdd(item): binary_operation = BinaryOp.add_sat
            SaturateSubtract(item): binary_operation = BinaryOp.sub_sat
            SaturateMultiply(item): binary_operation = BinaryOp.mul_sat
            BitwiseAnd(item): binary_operation = BinaryOp.bit_and
            BitwiseOr(item): binary_operation = BinaryOp.bit_or
            BitwiseXor(item): binary_operation = BinaryOp.bit_xor
            ShiftLeft(item): binary_operation = BinaryOp.shift_left
            ShiftRight(item): binary_operation = BinaryOp.shift_right
            Equal(item):
                binary_operation = BinaryOp.eq
                is_comparison = true
            NotEqual(item):
                binary_operation = BinaryOp.ne
                is_comparison = true
            Identity(item):
                binary_operation = BinaryOp.eq
                is_comparison = true
            NotIdentity(item):
                binary_operation = BinaryOp.ne
                is_comparison = true
            Less(item):
                binary_operation = BinaryOp.lt
                is_comparison = true
            LessEqual(item):
                binary_operation = BinaryOp.le
                is_comparison = true
            Greater(item):
                binary_operation = BinaryOp.gt
                is_comparison = true
            GreaterEqual(item):
                binary_operation = BinaryOp.ge
                is_comparison = true
            else: try self.state.fail_unsupported(module, function, span, "operation `" + str(operation) + "`")
        var result_type = operand_type
        if is_comparison: result_type = builtin_mir_type(BuiltinMirType.boolean)
        let register = self.state.new_register(result_type)
        body.append(MirInstruction(
            form = InstructionForm.Binary(result = register, operation = binary_operation, left = left, right = right),
            span = span,
        ))
        return register

    # mark: Match ===============================================================================
    #
    # A `match` is an `If` chain testing the subject once per alternative,
    # innermost-last, so arms are tried in source order. An arm whose
    # alternatives bind payloads gets its body once per alternative (each
    # alternative's payload lives in a different case struct). The expression
    # form wraps the chain in a `Block` with the result register and every arm
    # branches to it with its value; the last `Else` traps, since HirGenerator
    # proved the arms exhaustive. `Switch` is left for the native backends'
    # jump tables.
    func lower_match(module: HirModule, function: HirFunction, node: NodeId, subject: NodeId, arms: Operands, has_result: bool, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, node)
        let subject_type = node_type(self.state.program, subject)
        let selected = try self.lower_expression(module, function, subject, body)
        var result = RegisterId(value = no_register)
        var block_depth = len(self.state.regions)
        let returns_never = types_match(node_type(self.state.program, node), resolve_builtin_type(BuiltinType.never_type))
        if has_result and not returns_never:
            result = self.state.new_register(self.register_type_for(try self.state.mir_type_of(module, function, span, node_type(self.state.program, node))))
            body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run([result])), span = span))
            self.state.regions.append(Region.block)
        var arm_exit = MatchExit.Statement
        if has_result and returns_never: arm_exit = MatchExit.Diverging
        elif has_result: arm_exit = MatchExit.Value(block_depth = block_depth)
        try self.lower_match_arms(module, function, selected, subject_type, arms, arm_exit, span, body)
        if has_result and not returns_never:
            self.state.regions.remove(len(self.state.regions) - 1)
            self.emit_end(span, body)
        return result

    # Emit the pattern-test chain shared by statement, value, and fallible
    # matches. Each open If remains around the following arm's Else, which is
    # why a branch to an outer result block counts all earlier alternatives.
    func lower_match_arms(module: HirModule, function: HirFunction, selected: RegisterId, subject_type: ir.TypeId, arms: Operands, arm_exit: MatchExit, span: SourceSpan, body: list[MirInstruction]) -> !:
        var open_arms = 0
        var closed = false
        for position in range(0, i64(arms.count)):
            if closed: break
            let arm = node_at(self.state.program, arms, position)
            match node_form(self.state.program, arm):
                MatchArm(patterns, statements, value, guard):
                    if self.arm_binds(patterns):
                        # Payload bindings point into a case-specific layout,
                        # so every alternative needs its own copy of the arm.
                        for alternative in range(0, i64(patterns.count)):
                            let pattern = node_at(self.state.program, patterns, alternative)
                            var test = try self.lower_pattern_test(module, function, pattern, selected, subject_type, body)
                            if guard.value != no_node:
                                # Bind first, then ask the guard (base.md §8.4).
                                test = try self.lower_guarded_test(module, function, test, pattern, guard, selected, subject_type, span, body)
                            self.open_if(test, list[RegisterId](), span, body)
                            self.state.regions.append(Region.if_arm)
                            let defer_start = len(self.state.defers)
                            if guard.value == no_node: try self.lower_pattern_bindings(module, function, pattern, selected, subject_type, body)
                            try self.lower_selected_match_arm(module, function, statements, value, arm_exit, defer_start, span, body)
                            self.emit_else(span, body)
                            open_arms += 1
                    elif self.arm_is_wildcard(patterns) and guard.value == no_node:
                        try self.lower_selected_match_arm(module, function, statements, value, arm_exit, len(self.state.defers), span, body)
                        closed = true
                    else:
                        var test = try self.lower_pattern_test(module, function, node_at(self.state.program, patterns, 0), selected, subject_type, body)
                        for alternative in range(1, i64(patterns.count)):
                            let next = try self.lower_pattern_test(module, function, node_at(self.state.program, patterns, alternative), selected, subject_type, body)
                            test = self.lower_or(test, next, span, body)
                        if guard.value != no_node:
                            test = try self.lower_guarded_test(module, function, test, NodeId(value = no_node), guard, selected, subject_type, span, body)
                        self.open_if(test, list[RegisterId](), span, body)
                        self.state.regions.append(Region.if_arm)
                        try self.lower_selected_match_arm(module, function, statements, value, arm_exit, len(self.state.defers), span, body)
                        self.emit_else(span, body)
                        open_arms += 1
                else: try self.state.fail_unsupported(module, function, span, "a match arm that is not a `MatchArm` node")
        if not closed: body.append(MirInstruction(form = InstructionForm.Trap(reason = "unreachable match arm"), span = span))
        for arm in range(0, open_arms):
            self.state.regions.remove(len(self.state.regions) - 1)
            self.emit_end(span, body)

    # `test and guard`, where the guard sees the pattern's bindings: a
    # value-producing `If` that binds and asks, or yields false.
    func lower_guarded_test(module: HirModule, function: HirFunction, test: RegisterId, pattern: NodeId, guard: NodeId, selected: RegisterId, subject_type: ir.TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let matched = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(test, [matched], span, body)
        self.state.regions.append(Region.if_arm)
        if pattern.value != no_node: try self.lower_pattern_bindings(module, function, pattern, selected, subject_type, body)
        let passes = try self.lower_expression(module, function, guard, body)
        self.emit_yield(passes, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        return matched

    func lower_selected_match_arm(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, arm_exit: MatchExit, defer_start: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        match arm_exit:
            Statement: try self.lower_scope_from(module, function, statements, defer_start, body)
            Value(block_depth): try self.lower_value_match_arm(module, function, statements, value, block_depth, defer_start, span, body)
            Diverging: try self.lower_diverging_match_arm(module, function, statements, value, defer_start, span, body)
            Fallible(block_depth): try self.lower_fallible_arm_body(module, function, statements, value, block_depth, defer_start, span, body)

    func lower_diverging_match_arm(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, defer_start: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.state.program, statements, position), body)
        discard(try self.lower_expression(module, function, value, body))
        while len(self.state.defers) > defer_start: self.state.defers.remove(len(self.state.defers) - 1)

    # A value arm branches to the match's result block through every pattern
    # region opened since the block.
    func lower_value_match_arm(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, block_depth: i64, defer_start: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.state.program, statements, position), body)
        let register = try self.lower_expression(module, function, value, body)
        if node_diverges(self.state.program, value):
            while len(self.state.defers) > defer_start: self.state.defers.remove(len(self.state.defers) - 1)
            return
        let value_type = try self.state.mir_type_of(module, function, span, node_type(self.state.program, value))
        if self.type_needs_ownership(value_type): discard(self.take_owned_value(register))
        try self.emit_deferred_from(module, function, defer_start, body)
        while len(self.state.defers) > defer_start: self.state.defers.remove(len(self.state.defers) - 1)
        let depth = len(self.state.regions) - 1 - block_depth
        body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.state.operands.run([register])), span = span))

    func arm_binds(patterns: Operands) -> bool:
        for position in range(0, i64(patterns.count)):
            match node_form(self.state.program, node_at(self.state.program, patterns, position)):
                PatternCase(case_index, bindings):
                    if bindings.count > 0: return true
                else: pass
        return false

    func arm_is_wildcard(patterns: Operands) -> bool:
        if patterns.count != 1: return false
        match node_form(self.state.program, node_at(self.state.program, patterns, 0)):
            PatternWildcard: return true
            else: return false

    # `a or b` / `a and b` over two already-computed tests, as an `If` with a
    # result (bool has no bitwise operators in MIR).
    func lower_or(left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(left, [result], span, body)
        self.emit_yield(self.bool_constant(true, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(right, span, body)
        self.emit_end(span, body)
        return result

    func lower_and(left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(left, [result], span, body)
        self.emit_yield(right, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.emit_end(span, body)
        return result

    # A bool register: does the subject match this pattern?
    func lower_pattern_test(module: HirModule, function: HirFunction, pattern: NodeId, selected: RegisterId, subject_type: ir.TypeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.state.program, pattern)
        match node_form(self.state.program, pattern):
            PatternWildcard: return self.bool_constant(true, span, body)
            PatternLiteral(value):
                let literal = try self.lower_value_constant(module, function, self.state.program.values[value], subject_type, span, body)
                return try self.lower_equality(module, function, span, subject_type, selected, literal, body)
            PatternRange(lower, upper, inclusive):
                let operand_type = try self.state.mir_type_of(module, function, span, subject_type)
                let low = try self.lower_value_constant(module, function, self.state.program.values[lower], subject_type, span, body)
                let high = try self.lower_value_constant(module, function, self.state.program.values[upper], subject_type, span, body)
                let above = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = above, operation = BinaryOp.ge, left = selected, right = low), span = span))
                let below = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                var upper_test = BinaryOp.lt
                if inclusive: upper_test = BinaryOp.le
                body.append(MirInstruction(form = InstructionForm.Binary(result = below, operation = upper_test, left = selected, right = high), span = span))
                return self.lower_and(above, below, span, body)
            PatternCase(case_index, bindings):
                let enum_type = try self.state.mir_type_of(module, function, span, subject_type)
                let shape = ir.integer_enum_shape(self.state.program, subject_type)
                if shape != none:
                    # An integer-backed enum's case is a declared value of the
                    # representation (base.md §10.3).
                    let wanted = self.c_enum_constant(enum_type, shape.values[case_index], span, body)
                    let same = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                    body.append(MirInstruction(form = InstructionForm.Binary(result = same, operation = BinaryOp.eq, left = selected, right = wanted), span = span))
                    return same
                if is_nullable_ptr_type(self.state.types, enum_type):
                    # `.none` is case 0 and `.some` case 1 of the optional; the
                    # niche answers both with one null test.
                    let present = self.optional_present(enum_type, selected, span, body)
                    if case_index == 1: return present
                    let absent = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                    body.append(MirInstruction(form = InstructionForm.Unary(result = absent, operation = UnaryOp.bool_not, operand = present), span = span))
                    return absent
                let tag_type = self.enum_tag_type(enum_type)
                let tag = self.load_enum_tag(enum_type, selected, span, body)
                let wanted = self.state.new_register(tag_type)
                body.append(MirInstruction(form = InstructionForm.Const(result = wanted, value = self.integer_constant_value(tag_type, case_index)), span = span))
                let same = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = same, operation = BinaryOp.eq, left = tag, right = wanted), span = span))
                return same
            else: error(self.state.unsupported(module, function, span, "a pattern that is not a pattern node"))

    # After a case test succeeds, each payload binding takes an independent
    # owned value from the borrowed subject storage. The selected arm's
    # lifetime boundary destroys these bindings on every exit path.
    func lower_pattern_bindings(module: HirModule, function: HirFunction, pattern: NodeId, selected: RegisterId, subject_type: ir.TypeId, body: list[MirInstruction]) -> !:
        let span = node_span(self.state.program, pattern)
        match node_form(self.state.program, pattern):
            PatternCase(case_index, bindings):
                if bindings.count == 0: return
                let enum_type = try self.state.mir_type_of(module, function, span, subject_type)
                match self.state.program.types.definitions[subject_type.value].form:
                    Optional(inner):
                        # `.some(value)`: the payload is the value itself.
                        let inner_type = try self.state.mir_type_of(module, function, span, inner)
                        let symbol = SymbolId(value = u32(entry_at(self.state.program, bindings, 0)))
                        let local = try self.state.local_of(module, function, span, symbol)
                        self.initialize_owned_value(inner_type, local.address, self.optional_payload(enum_type, inner_type, selected, span, body), span, body)
                        if self.type_needs_ownership(inner_type):
                            self.state.defers.append(DeferredAction.DestroyAddress(address = local.address, value_type = inner_type, span = span))
                    Enum(enum_index, arguments):
                        let case_type = self.case_struct_type(enum_type, case_index)
                        let payload_base = self.payload_address(enum_type, selected, span, body)
                        let fields = ir.nominal_cases(self.state.program, subject_type)[case_index].payload
                        for index in range(0, i64(bindings.count)):
                            let symbol = SymbolId(value = u32(entry_at(self.state.program, bindings, index)))
                            let local = try self.state.local_of(module, function, span, symbol)
                            let field_type = try self.state.mir_type_of(module, function, span, fields[index].value_type)
                            let field = self.field_address(case_type, payload_base, index, span, body)
                            self.initialize_owned_value(field_type, local.address, self.load_value(field_type, field, span, body), span, body)
                            if self.type_needs_ownership(field_type):
                                self.state.defers.append(DeferredAction.DestroyAddress(address = local.address, value_type = field_type, span = span))
                    else: try self.state.fail_unsupported(module, function, span, "payload bindings on `" + describe_type(self.state.program.types, subject_type) + "`")
            else: return

    # A pattern's literal as a register of the subject's type.
    func lower_value_constant(module: HirModule, function: HirFunction, value: Value, subject_type: ir.TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let value_type = try self.state.mir_type_of(module, function, span, subject_type)
        var constant = MirConstant.Null
        match value:
            SignedInteger(item): constant = MirConstant.SignedInt(value = item)
            UnsignedInteger(item): constant = MirConstant.UnsignedInt(value = item)
            Floating(item): constant = MirConstant.Float(value = item)
            Boolean(item): constant = MirConstant.Bool(value = item)
            Character(item): constant = MirConstant.UnsignedInt(value = u64(u32(item)))
            Text(item): return try self.lower_buffer_constant(value_type, strings.to_bytes(item), span, body)
            Bytes(item): return try self.lower_buffer_constant(value_type, item, span, body)
            else: try self.state.fail_unsupported(module, function, span, "pattern literal `" + str(value) + "`")
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = constant), span = span))
        return register

    # The payload struct of one enum case, from the enum's MIR type.
    func case_struct_type(enum_type: TypeId, case_index: i64) -> TypeId:
        match mir_type(self.state.types, enum_type):
            Enum(tag, cases): return cases[case_index]
            else: trap("case struct of a non-enum MIR type")

    # `payload_cases[position..]` compared in turn: `If(tag == case)` compares
    # that case's fields, its else-arm tries the next; past the last, two
    # values with equal tags and no payload are equal.
    func lower_enum_case_chain(module: HirModule, function: HirFunction, span: SourceSpan, hir_enum_type: ir.TypeId, enum_type: TypeId, left: RegisterId, right: RegisterId, left_tag: RegisterId, payload_cases: list[i64], position: i64, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        if position >= len(payload_cases): return self.bool_constant(true, span, body)
        let case_index = payload_cases[position]
        let tag_type = self.enum_tag_type(enum_type)
        let wanted = self.state.new_register(tag_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = wanted, value = self.integer_constant_value(tag_type, case_index)), span = span))
        let is_case = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_case, operation = BinaryOp.eq, left = left_tag, right = wanted), span = span))
        let compared = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(is_case, [compared], span, body)
        let case_type = self.case_struct_type(enum_type, case_index)
        let left_payload = self.payload_address(enum_type, left, span, body)
        let right_payload = self.payload_address(enum_type, right, span, body)
        let fields = ir.nominal_cases(self.state.program, hir_enum_type)[case_index].payload
        var so_far = self.bool_constant(true, span, body)
        for field_index in range(0, len(fields)):
            let element_type = try self.state.mir_type_of(module, function, span, fields[field_index].value_type)
            let left_value = self.load_value(element_type, self.field_address(case_type, left_payload, field_index, span, body), span, body)
            let right_value = self.load_value(element_type, self.field_address(case_type, right_payload, field_index, span, body), span, body)
            so_far = try self.lower_and_then(module, function, span, so_far, fields[field_index].value_type, left_value, right_value, context, body)
        self.emit_yield(so_far, span, body)
        self.emit_else(span, body)
        let rest = try self.lower_enum_case_chain(module, function, span, hir_enum_type, enum_type, left, right, left_tag, payload_cases, position + 1, context, body)
        self.emit_yield(rest, span, body)
        self.emit_end(span, body)
        return compared

    # mark: Aggregates ==========================================================================
    #
    # The helpers below implement the memory protocol described in the header:
    # a register of aggregate type is an address, copies are `Memcpy`, and
    # scalars inside an aggregate are reached through `FieldAddress`.

    pub func is_aggregate(value_type: TypeId) -> bool:
        match mir_type(self.state.types, value_type):
            Struct(fields): return true
            Union(members): return true
            Enum(tag, cases): return true
            Array(element, count): return true
            Func(signature): return true
            else: return false

    # The type of the register holding a value of `value_type`.
    func register_type_for(value_type: TypeId) -> TypeId:
        if self.is_aggregate(value_type): return builtin_mir_type(BuiltinMirType.pointer)
        return value_type

    # A fresh scratch slot allocated where it is needed. Aggregates use it for
    # values; structured lowering may use a scalar slot for loop-carried state.
    # The backend sizes the frame from `slots` regardless of where `Alloca` sits.
    pub func new_temp(value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let slot = len(self.state.slots)
        self.state.slots.append(MirSlot(value_type = value_type))
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
        return address

    # mark: Counted loops ======================================================================
    #
    # Every generated traversal has the same shape: a `u64` counter in a slot,
    # `Block Loop`, load, compare with the limit, leave on `done`, the body,
    # increment, `Br 0`, `End End`. The three steps below own that shape and
    # the region bookkeeping, so a caller writes only the body.

    ## Open `Block(results) Loop` with the counter at `start` and compute `done`.
    pub func begin_counted_loop(start: RegisterId, limit: RegisterId, results: list[RegisterId], span: SourceSpan, body: list[MirInstruction]) -> CountedLoop:
        body.append(MirInstruction(form = InstructionForm.Block(results = self.state.operands.run(results)), span = span))
        self.state.regions.append(Region.block)
        return self.begin_counted_loop_body(start, limit, true, span, body)

    ## Open only the `Loop` inside a block the caller already opened.
    pub func begin_counted_loop_body(start: RegisterId, limit: RegisterId, opened_block: bool, span: SourceSpan, body: list[MirInstruction]) -> CountedLoop:
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let counter = self.new_temp(index_type, span, body)
        self.store_value(index_type, counter, start, span, body)
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.state.regions.append(Region.loop_body)
        let index = self.load_value(index_type, counter, span, body)
        let done = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = index, right = limit), span = span))
        return CountedLoop(counter = counter, index = index, done = done, opened_block = opened_block)

    ## Leave the enclosing block with `values` once the counter reaches the limit.
    pub func exit_counted_loop_when_done(loop: CountedLoop, values: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = loop.done, depth = 1, values = self.state.operands.run(values)), span = span))

    ## Advance the counter, restart the loop, and close both regions.
    pub func end_counted_loop(loop: CountedLoop, span: SourceSpan, body: list[MirInstruction]):
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let next = self.state.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = loop.index, right = self.integer_constant(index_type, 1, span, body)), span = span))
        self.store_value(index_type, loop.counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)
        if loop.opened_block: self.state.regions.remove(len(self.state.regions) - 1)
        self.emit_end(span, body)

    pub func function_null(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.FunctionNull(destination = address, function_type = value_type), span = span))

    # Put a value at an address: `Memcpy` for an aggregate, `Store` otherwise.
    pub func store_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if self.is_aggregate(value_type):
            body.append(MirInstruction(form = InstructionForm.Memcpy(destination = address, source = value, value_type = value_type), span = span))
        else:
            body.append(MirInstruction(form = InstructionForm.Store(value_type = value_type, address = address, value = value), span = span))

    # Read a value at an address: the address itself for an aggregate (no
    # copy until it is stored somewhere), a `Load` otherwise.
    pub func load_value(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        if self.is_aggregate(value_type): return address
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Load(result = register, value_type = value_type, address = address), span = span))
        return register

    func field_address(struct_type: TypeId, base: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.FieldAddress(result = address, struct_type = struct_type, base = base, field = field), span = span))
        return address

    pub func element_address(element_type: TypeId, base: RegisterId, index: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ElementAddress(result = address, element_type = element_type, base = base, index = index), span = span))
        return address

    func global_address(index: u32, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.GlobalAddress(result = address, global = GlobalId(value = index)), span = span))
        return address

    # The scalar field `field` of the struct at `base`, loaded.
    pub func load_field(struct_type: TypeId, base: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        match mir_type(self.state.types, struct_type):
            Struct(fields):
                return self.load_value(fields[field].value_type, self.field_address(struct_type, base, field, span, body), span, body)
            Union(members):
                return self.load_value(members[field].value_type, self.field_address(struct_type, base, field, span, body), span, body)
            else: error("lowerer: field of a non-struct type")

    # Keep payload placement symbolic until a backend chooses its byte layout.
    pub func payload_address(enum_type: TypeId, base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.EnumPayloadAddress(result = address, enum_type = enum_type, base = base), span = span))
        return address

    # Optional tags have their specified uniform two-case `u8` shape.
    pub func store_optional_tag(base: RegisterId, tag: i64, span: SourceSpan, body: list[MirInstruction]):
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let value = self.state.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = value, value = self.integer_constant_value(byte_type, tag)), span = span))
        body.append(MirInstruction(form = InstructionForm.Store(value_type = byte_type, address = base, value = value), span = span))

    func load_optional_tag(base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let tag = self.state.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Load(result = tag, value_type = byte_type, address = base), span = span))
        return tag

    # Every canonical enum carries its selected unsigned tag type. Keep each
    # use tied to the enum so ordinary cases can scale while optionals retain
    # their independent two-case `u8` shape.
    func enum_tag_type(enum_type: TypeId) -> TypeId:
        match mir_type(self.state.types, enum_type):
            Enum(tag, cases): return tag
            else: trap("enum tag requested from a non-enum MIR type")

    func store_enum_tag(enum_type: TypeId, base: RegisterId, tag: i64, span: SourceSpan, body: list[MirInstruction]):
        let tag_type = self.enum_tag_type(enum_type)
        let value = self.state.new_register(tag_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = value, value = self.integer_constant_value(tag_type, tag)), span = span))
        body.append(MirInstruction(form = InstructionForm.Store(value_type = tag_type, address = base, value = value), span = span))

    func load_enum_tag(enum_type: TypeId, base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let tag_type = self.enum_tag_type(enum_type)
        return self.load_value(tag_type, base, span, body)

    # Whether an optional holds a value: a null test for the nullable pointer
    # niche, the tag otherwise. `optional` is the register-sized word or the
    # tagged enum's address, as the type decides.
    pub func optional_present(optional_type: TypeId, optional: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        if not is_nullable_ptr_type(self.state.types, optional_type): return self.load_present(optional, span, body)
        let null_value = self.typed_null_constant(optional_type, span, body)
        let present = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = present, operation = BinaryOp.ne, left = optional, right = null_value), span = span))
        return present

    # The payload of an optional proved present: the word read as an address
    # for the niche, the enum payload otherwise.
    pub func optional_payload(optional_type: TypeId, inner_type: TypeId, optional: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        if not is_nullable_ptr_type(self.state.types, optional_type):
            return self.load_value(inner_type, self.payload_address(optional_type, optional, span, body), span, body)
        let pointer = self.state.new_register(inner_type)
        body.append(MirInstruction(form = InstructionForm.Convert(result = pointer, operation = ConvertOp.nullable_to_ptr, operand = optional), span = span))
        return pointer

    # `tag == 1` as a bool register.
    pub func load_present(base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let tag = self.load_optional_tag(base, span, body)
        let one = self.state.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.UnsignedInt(value = u64(1))), span = span))
        let present = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = present, operation = BinaryOp.eq, left = tag, right = one), span = span))
        return present

    # Literal strings and bytes live in immutable program data with a null
    # owner. Null is deliberately inert, so literals pay no allocation or
    # reference-counting cost while retaining the dynamic value shape.
    func lower_buffer_constant(value_type: TypeId, payload: list[u8], span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let data_id = self.add_data("bytes", payload)
        let temp = self.new_temp(value_type, span, body)
        if self.state.is_buffer_mir_type(value_type):
            let owner_type = builtin_mir_type(BuiltinMirType.buffer_owner)
            self.store_value(owner_type, self.field_address(value_type, temp, self.state.buffer_owner_field(), span, body), self.typed_null_constant(owner_type, span, body), span, body)
        let pointer = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = pointer, data = DataId(value = u32(data_id))), span = span))
        let pointer_field = self.field_address(value_type, temp, self.state.buffer_data_field(), span, body)
        body.append(MirInstruction(form = InstructionForm.Store(value_type = builtin_mir_type(BuiltinMirType.pointer), address = pointer_field, value = pointer), span = span))
        let length = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.UnsignedInt(value = u64(len(payload)))), span = span))
        let length_field = self.field_address(value_type, temp, self.state.buffer_length_field(), span, body)
        body.append(MirInstruction(form = InstructionForm.Store(value_type = builtin_mir_type(BuiltinMirType.unsigned_u64), address = length_field, value = length), span = span))
        return temp

    # A sequence index evaluates both operands once, checks its `u64` bound,
    # and exposes only structural MIR addressing. Fixed arrays carry their
    # count in the canonical type; byte strings carry it in the value.
    func lower_sequence_index(module: HirModule, function: HirFunction, span: SourceSpan, value: NodeId, index: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let sequence = try self.lower_expression(module, function, value, body)
        let position = try self.lower_expression(module, function, index, body)
        let hir_sequence_type = node_type(self.state.program, value)
        match self.state.program.types.definitions[hir_sequence_type.value].form:
            Array(element, count):
                let element_type = try self.state.mir_type_of(module, function, span, element)
                let address = self.checked_element_address(element_type, sequence, position, count, span, body)
                return self.load_value(element_type, address, span, body)
            else:
                let collection = try self.full.lower_collection_index(self, module, function, span, hir_sequence_type, sequence, position, body)
                if collection != none: return collection
                let sequence_type = try self.state.mir_type_of(module, function, span, hir_sequence_type)
                let length = try self.load_field(sequence_type, sequence, self.state.buffer_length_field(), span, body)
                let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
                let byte_data = try self.load_field(sequence_type, sequence, self.state.buffer_data_field(), span, body)
                let address = self.checked_element_address_with_length(byte_type, byte_data, position, length, span, body)
                return self.load_value(byte_type, address, span, body)

    func checked_element_address(element_type: TypeId, base: RegisterId, index: RegisterId, count: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let length = self.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), count, span, body)
        return self.checked_element_address_with_length(element_type, base, index, length, span, body)

    func checked_element_address_with_length(element_type: TypeId, base: RegisterId, index: RegisterId, length: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let in_bounds = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = in_bounds, operation = BinaryOp.lt, left = index, right = length), span = span))
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        self.open_if(in_bounds, [result], span, body)
        self.emit_yield(self.element_address(element_type, base, index, span, body), span, body)
        self.emit_else(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "index out of bounds"), span = span))
        self.emit_end(span, body)
        return result

    pub func integer_constant(value_type: TypeId, value: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = self.integer_constant_value(value_type, value)), span = span))
        return register

    func signed_integer_constant(value_type: TypeId, value: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.SignedInt(value = value)), span = span))
        return register

    func unsigned_integer_constant(value_type: TypeId, value: u64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.UnsignedInt(value = value)), span = span))
        return register

    func integer_constant_value(value_type: TypeId, value: i64) -> MirConstant:
        if is_signed_int_type(self.state.types, value_type): return MirConstant.SignedInt(value = value)
        if value < 0: trap("negative constant requested for an unsigned MIR type")
        return MirConstant.UnsignedInt(value = u64(value))

    pub func bool_constant(value: bool, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.Bool(value = value)), span = span))
        return register

    pub func null_constant(span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        return self.typed_null_constant(builtin_mir_type(BuiltinMirType.pointer), span, body)

    pub func typed_null_constant(value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.Null), span = span))
        return register

    # mark: Structural hashing ==================================================================
    #
    # Hashing is expanded into ordinary canonical integer/control/memory
    # operations here, once. Backends therefore never re-walk source types or
    # choose aggregate semantics. `FloatBits` is the sole IEEE representation
    # primitive; signed zero is normalized before hashing, preserving the
    # required equality implication.

    pub func lower_structural_hash(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let seed = self.hash_constant(1469598103934665603, span, body)
        match self.state.program.types.definitions[value_type.value].form:
            Unit: return self.mix_hash(seed, self.hash_constant(1, span, body), span, body)
            Boolean:
                let state = self.mix_hash(seed, self.hash_constant(2, span, body), span, body)
                return self.mix_hash(state, self.hash_bool_code(value, span, body), span, body)
            PointerInteger(is_signed):
                error(self.state.unsupported(module, function, span, "hashing a pointer-width integer (its hash width comes with the Base cast family, B1d)"))
            Integer(bits, is_signed):
                let state = self.mix_hash(seed, self.hash_constant(3, span, body), span, body)
                return self.mix_hash(state, self.hash_integer_code(value, try self.state.mir_type_of(module, function, span, value_type), span, body), span, body)
            Floating(bits):
                let state = self.mix_hash(seed, self.hash_constant(4, span, body), span, body)
                return self.mix_hash(state, self.hash_float_code(value, try self.state.mir_type_of(module, function, span, value_type), span, body), span, body)
            Character:
                let state = self.mix_hash(seed, self.hash_constant(5, span, body), span, body)
                return self.mix_hash(state, self.hash_integer_code(value, try self.state.mir_type_of(module, function, span, value_type), span, body), span, body)
            String:
                return try self.lower_buffer_hash(module, function, span, value_type, value, self.mix_hash(seed, self.hash_constant(6, span, body), span, body), body)
            Bytes:
                return try self.lower_buffer_hash(module, function, span, value_type, value, self.mix_hash(seed, self.hash_constant(7, span, body), span, body), body)
            Range(inner):
                let fields = [inner, inner, resolve_builtin_type(BuiltinType.boolean)]
                return try self.lower_hash_fields(module, function, span, try self.state.mir_type_of(module, function, span, value_type), fields, value, self.mix_hash(seed, self.hash_constant(8, span, body), span, body), body)
            Array(element, count):
                return try self.lower_array_hash(module, function, span, element, count, value, self.mix_hash(seed, self.hash_constant(9, span, body), span, body), body)
            Optional(inner):
                return try self.lower_optional_hash(module, function, span, value_type, inner, value, self.mix_hash(seed, self.hash_constant(10, span, body), span, body), body)
            Tuple(elements):
                return try self.lower_hash_fields(module, function, span, try self.state.mir_type_of(module, function, span, value_type), elements, value, self.mix_hash(seed, self.hash_constant(11, span, body), span, body), body)
            Struct(index, arguments):
                let fields = list[ir.TypeId]()
                for field in ir.nominal_fields(self.state.program, value_type): fields.append(field.value_type)
                return try self.lower_hash_fields(module, function, span, try self.state.mir_type_of(module, function, span, value_type), fields, value, self.mix_hash(seed, self.hash_constant(12, span, body), span, body), body)
            ErrorCode:
                let fields = [resolve_builtin_type(BuiltinType.string), resolve_builtin_type(BuiltinType.unsigned_u32)]
                return try self.lower_hash_fields(module, function, span, try self.state.mir_type_of(module, function, span, value_type), fields, value, self.mix_hash(seed, self.hash_constant(13, span, body), span, body), body)
            Error:
                let fields = [resolve_builtin_type(BuiltinType.error_code), resolve_builtin_type(BuiltinType.string)]
                return try self.lower_hash_fields(module, function, span, try self.state.mir_type_of(module, function, span, value_type), fields, value, self.mix_hash(seed, self.hash_constant(14, span, body), span, body), body)
            Enum(index, arguments):
                let representation = ir.integer_enum_representation(self.state.program, value_type)
                if representation != none: return try self.lower_structural_hash(module, function, span, representation, value, body)
                return try self.lower_enum_hash(module, function, span, value_type, value, self.mix_hash(seed, self.hash_constant(15, span, body), span, body), body)
            else: error(self.state.unsupported(module, function, span, "hashing `" + describe_type(self.state.program.types, value_type) + "`"))

    func hash_constant(value: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        return self.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), value, span, body)

    # A multiplication-free xorshift combiner avoids checked-overflow
    # arithmetic while still diffusing every input bit through a u64 state.
    func mix_hash(state: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        var mixed = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = mixed, operation = BinaryOp.bit_xor, left = state, right = value), span = span))
        for distance in [13, 7, 17]:
            let shifted = self.state.new_register(u64_type)
            var operation = BinaryOp.shift_left
            if distance == 7: operation = BinaryOp.shift_right
            body.append(MirInstruction(form = InstructionForm.Binary(result = shifted, operation = operation, left = mixed, right = self.hash_constant(distance, span, body)), span = span))
            let next = self.state.new_register(u64_type)
            body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.bit_xor, left = mixed, right = shifted), span = span))
            mixed = next
        return mixed

    func hash_bool_code(value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.open_if(value, [result], span, body)
        self.emit_yield(self.hash_constant(1, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(self.hash_constant(0, span, body), span, body)
        self.emit_end(span, body)
        return result

    func hash_integer_code(value: RegisterId, value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let u64_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        if value_type.value == u64_type.value: return value
        var source = value
        var source_type = value_type
        if is_signed_int_type(self.state.types, value_type):
            let unsigned = self.unsigned_integer_type(bits_of(self.state.types, value_type))
            source = self.state.new_register(unsigned)
            body.append(MirInstruction(form = InstructionForm.Convert(result = source, operation = ConvertOp.int_reinterpret, operand = value), span = span))
            source_type = unsigned
        if bits_of(self.state.types, source_type) == 64: return source
        let result = self.state.new_register(u64_type)
        body.append(MirInstruction(form = InstructionForm.Convert(result = result, operation = ConvertOp.extend, operand = source), span = span))
        return result

    func unsigned_integer_type(bits: i64) -> TypeId:
        if bits == 8: return builtin_mir_type(BuiltinMirType.unsigned_u8)
        if bits == 16: return builtin_mir_type(BuiltinMirType.unsigned_u16)
        if bits == 32: return builtin_mir_type(BuiltinMirType.unsigned_u32)
        if bits == 64: return builtin_mir_type(BuiltinMirType.unsigned_u64)
        trap("hashing encountered an unsupported integer width")

    func hash_float_code(value: RegisterId, value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let zero = self.state.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = zero, value = MirConstant.Float(value = 0.0)), span = span))
        let is_zero = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_zero, operation = BinaryOp.eq, left = value, right = zero), span = span))
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.open_if(is_zero, [result], span, body)
        self.emit_yield(self.hash_constant(0, span, body), span, body)
        self.emit_else(span, body)
        let raw = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.FloatBits(result = raw, operand = value), span = span))
        self.emit_yield(raw, span, body)
        self.emit_end(span, body)
        return result

    func lower_hash_fields(module: HirModule, function: HirFunction, span: SourceSpan, struct_type: TypeId, fields: list[ir.TypeId], value: RegisterId, initial: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var state = self.mix_hash(initial, self.hash_constant(len(fields), span, body), span, body)
        for index in range(0, len(fields)):
            let field_type = try self.state.mir_type_of(module, function, span, fields[index])
            let field = self.load_value(field_type, self.field_address(struct_type, value, index, span, body), span, body)
            let code = try self.lower_structural_hash(module, function, span, fields[index], field, body)
            state = self.mix_hash(state, code, span, body)
        return state

    func lower_buffer_hash(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, initial: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let buffer_type = try self.state.mir_type_of(module, function, span, value_type)
        let data = try self.load_field(buffer_type, value, self.state.buffer_data_field(), span, body)
        let length = try self.load_field(buffer_type, value, self.state.buffer_length_field(), span, body)
        let state_slot = self.new_temp(builtin_mir_type(BuiltinMirType.unsigned_u64), span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, self.mix_hash(initial, length, span, body), span, body)
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        let loop = self.begin_counted_loop(self.hash_constant(0, span, body), length, [result], span, body)
        let current = self.load_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, span, body)
        self.exit_counted_loop_when_done(loop, [current], span, body)
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let byte = self.load_value(byte_type, self.element_address(byte_type, data, loop.index, span, body), span, body)
        let code = self.hash_integer_code(byte, byte_type, span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, self.mix_hash(current, code, span, body), span, body)
        self.end_counted_loop(loop, span, body)
        return result

    func lower_array_hash(module: HirModule, function: HirFunction, span: SourceSpan, element: ir.TypeId, count: i64, value: RegisterId, initial: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let element_type = try self.state.mir_type_of(module, function, span, element)
        let state_slot = self.new_temp(builtin_mir_type(BuiltinMirType.unsigned_u64), span, body)
        self.store_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, self.mix_hash(initial, self.hash_constant(count, span, body), span, body), span, body)
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        let loop = self.begin_counted_loop(self.hash_constant(0, span, body), self.hash_constant(count, span, body), [result], span, body)
        let current = self.load_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, span, body)
        self.exit_counted_loop_when_done(loop, [current], span, body)
        let item = self.load_value(element_type, self.element_address(element_type, value, loop.index, span, body), span, body)
        let code = try self.lower_structural_hash(module, function, span, element, item, body)
        self.store_value(builtin_mir_type(BuiltinMirType.unsigned_u64), state_slot, self.mix_hash(current, code, span, body), span, body)
        self.end_counted_loop(loop, span, body)
        return result

    func lower_optional_hash(module: HirModule, function: HirFunction, span: SourceSpan, optional_type: ir.TypeId, inner: ir.TypeId, value: RegisterId, initial: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let mir_optional = try self.state.mir_type_of(module, function, span, optional_type)
        let present = self.optional_present(mir_optional, value, span, body)
        let tagged = self.mix_hash(initial, self.hash_bool_code(present, span, body), span, body)
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.open_if(present, [result], span, body)
        let inner_type = try self.state.mir_type_of(module, function, span, inner)
        let payload = self.optional_payload(mir_optional, inner_type, value, span, body)
        let code = try self.lower_structural_hash(module, function, span, inner, payload, body)
        self.emit_yield(self.mix_hash(tagged, code, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(tagged, span, body)
        self.emit_end(span, body)
        return result

    func lower_enum_hash(module: HirModule, function: HirFunction, span: SourceSpan, hir_enum_type: ir.TypeId, value: RegisterId, initial: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let enum_type = try self.state.mir_type_of(module, function, span, hir_enum_type)
        let tag_type = self.enum_tag_type(enum_type)
        let tag = self.load_enum_tag(enum_type, value, span, body)
        let tagged = self.mix_hash(initial, self.hash_integer_code(tag, tag_type, span, body), span, body)
        let payload_cases = list[i64]()
        let cases = ir.nominal_cases(self.state.program, hir_enum_type)
        for case_index in range(0, len(cases)):
            if len(cases[case_index].payload) > 0: payload_cases.append(case_index)
        return try self.lower_enum_hash_chain(module, function, span, hir_enum_type, enum_type, value, tag, tagged, payload_cases, 0, body)

    func lower_enum_hash_chain(module: HirModule, function: HirFunction, span: SourceSpan, hir_enum_type: ir.TypeId, enum_type: TypeId, value: RegisterId, tag: RegisterId, initial: RegisterId, payload_cases: list[i64], position: i64, body: list[MirInstruction]) -> RegisterId!:
        if position >= len(payload_cases): return initial
        let case_index = payload_cases[position]
        let tag_type = self.enum_tag_type(enum_type)
        let wanted = self.state.new_register(tag_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = wanted, value = self.integer_constant_value(tag_type, case_index)), span = span))
        let is_case = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_case, operation = BinaryOp.eq, left = tag, right = wanted), span = span))
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        self.open_if(is_case, [result], span, body)
        let case_type = self.case_struct_type(enum_type, case_index)
        let payload = self.payload_address(enum_type, value, span, body)
        let fields = list[ir.TypeId]()
        for field in ir.nominal_cases(self.state.program, hir_enum_type)[case_index].payload: fields.append(field.value_type)
        let hashed = try self.lower_hash_fields(module, function, span, case_type, fields, payload, initial, body)
        self.emit_yield(hashed, span, body)
        self.emit_else(span, body)
        let rest = try self.lower_enum_hash_chain(module, function, span, hir_enum_type, enum_type, value, tag, initial, payload_cases, position + 1, body)
        self.emit_yield(rest, span, body)
        self.emit_end(span, body)
        return result

    # mark: Aggregate equality ==================================================================
    #
    # Ordinary finite value graphs expand once into structured MIR. A type
    # graph recursive through mutable lists instead calls one generated helper
    # per concrete recursive type and carries one opaque visited-pair context.
    # This prevents both compiler recursion and runtime recursion while keeping
    # element semantics in canonical MIR rather than a backend/runtime callback.

    pub func lower_aggregate_comparison(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var negate = false
        match operation:
            Equal(item): negate = false
            NotEqual(item): negate = true
            else: try self.state.fail_unsupported(module, function, span, "operation `" + str(operation) + "` on `" + describe_type(self.state.program.types, operand_type) + "`")
        let equal = try self.lower_equality(module, function, span, operand_type, left, right, body)
        if not negate: return equal
        let unequal = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Unary(result = unequal, operation = UnaryOp.bool_not, operand = equal), span = span))
        return unequal

    # The source operation owns exactly one comparison transaction. Finite
    # shapes allocate nothing; only a genuinely recursive collection type
    # creates the opaque context used by its generated helpers.
    func lower_equality(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        if not self.equality_type_is_recursive(value_type):
            return try self.lower_equality_definition(module, function, span, value_type, left, right, none, body)
        let context = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.EqualityContextCreate(result = context), span = span))
        let equal = try self.lower_nested_equality(module, function, span, value_type, left, right, context, body)
        body.append(MirInstruction(form = InstructionForm.EqualityContextRelease(value = context), span = span))
        return equal

    # Emit one generated recursive equality body. Its parameters follow the
    # canonical value protocol: aggregates arrive by address, scalars by value,
    # and the final pointer is the shared comparison context.
    pub func lower_equality_helper(helper: EqualityHelper) -> MirFunction!:
        let module = self.state.program.modules[helper.module.value]
        let owner_index = self.state.function_index_of(helper.owner)
        if owner_index < 0: trap("equality helper lost its source owner")
        let owner = self.state.program.functions[owner_index]
        self.begin_function()
        let parameter_type = self.register_type_for(helper.value_type)
        let left = self.state.new_register(parameter_type)
        let right = self.state.new_register(parameter_type)
        let context = self.state.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let body = list[MirInstruction]()
        let equal = try self.lower_equality_definition(module, owner, owner.span, helper.hir_type, left, right, context, body)
        body.append(MirInstruction(form = InstructionForm.Return(values = self.state.operands.run([equal])), span = owner.span))
        return MirFunction(
            # HIR identity is part of the generated function identity. Two
            # nominal recursive types may lower to one structural MIR shape;
            # naming only that shape would collide in the program-wide
            # function namespace even though the helpers compare different
            # source definitions.
            name = ".luce_equal_h" + str(helper.hir_type.value) + "_t" + str(helper.value_type.value),
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = [parameter_type, parameter_type, builtin_mir_type(BuiltinMirType.pointer)], results = [builtin_mir_type(BuiltinMirType.boolean)], is_fallible = false, returns_never = false),
            registers = self.state.registers,
            slots = self.state.slots,
            body = body,
            operands = self.state.operands.operands,
            transfers = self.state.operands.transfers,
            is_public = false,
            is_exported = false,
            span = owner.span,
        )

    # A repeated HIR type on one structural path means collection indirection
    # closed a cycle; direct value cycles were rejected before lowering.
    func equality_type_is_recursive(value_type: ir.TypeId) -> bool:
        let visiting = list[bool]()
        for definition in self.state.program.types.definitions: visiting.append(false)
        return self.equality_type_is_recursive_once(value_type, visiting)

    func equality_type_is_recursive_once(value_type: ir.TypeId, visiting: list[bool]) -> bool:
        if visiting[value_type.value]: return true
        visiting[value_type.value] = true
        var recursive = false
        match self.state.program.types.definitions[value_type.value].form:
            Range(inner): recursive = self.equality_type_is_recursive_once(inner, visiting)
            Array(inner, count): recursive = self.equality_type_is_recursive_once(inner, visiting)
            List(inner): recursive = self.equality_type_is_recursive_once(inner, visiting)
            Map(key, item): recursive = self.equality_type_is_recursive_once(item, visiting)
            Optional(inner): recursive = self.equality_type_is_recursive_once(inner, visiting)
            Tuple(elements):
                for element in elements:
                    if self.equality_type_is_recursive_once(element, visiting):
                        recursive = true
                        break
            Struct(index, arguments):
                for field in ir.nominal_fields(self.state.program, value_type):
                    if self.equality_type_is_recursive_once(field.value_type, visiting):
                        recursive = true
                        break
            Enum(index, arguments):
                for case_value in ir.nominal_cases(self.state.program, value_type):
                    for field in case_value.payload:
                        if self.equality_type_is_recursive_once(field.value_type, visiting):
                            recursive = true
                            break
                    if recursive: break
            else: pass
        visiting[value_type.value] = false
        return recursive

    # Recursive children call their already-reserved helper. Finite children
    # remain inline, preserving the compact path for ordinary equality.
    pub func lower_nested_equality(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        if not self.equality_type_is_recursive(value_type):
            return try self.lower_equality_definition(module, function, span, value_type, left, right, context, body)
        let helper = try self.equality_helper_for(module, function, value_type)
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Call(
            results = self.state.operands.run([result]),
            function = helper.function,
            arguments = self.state.operands.run([left, right, context]),
        ), span = span))
        return result

    # Compare one concrete type definition. `context` is present only while a
    # recursive graph is active; non-recursive list types use the same loop
    # without allocating or consulting a pair set.
    pub func lower_equality_definition(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        let mir_value_type = try self.state.mir_type_of(module, function, span, value_type)
        let collection = try self.full.lower_collection_equality(self, module, function, span, value_type, left, right, context, body)
        if collection != none: return collection
        if not self.is_aggregate(mir_value_type):
            return try self.lower_binary_operation(module, function, span, BinaryOperation.Equal(operand_type = value_type), mir_value_type, left, right, body)
        match self.state.program.types.definitions[value_type.value].form:
            Tuple(elements):
                var so_far = self.bool_constant(true, span, body)
                for index in range(0, len(elements)):
                    let element_type = try self.state.mir_type_of(module, function, span, elements[index])
                    let left_value = self.load_value(element_type, self.field_address(mir_value_type, left, index, span, body), span, body)
                    let right_value = self.load_value(element_type, self.field_address(mir_value_type, right, index, span, body), span, body)
                    so_far = try self.lower_and_then(module, function, span, so_far, elements[index], left_value, right_value, context, body)
                return so_far
            Array(element, count):
                return try self.lower_array_equality(module, function, span, element, count, left, right, context, body)
            Range(inner):
                let fields = [inner, inner, resolve_builtin_type(BuiltinType.boolean)]
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, context, body)
            Struct(index, arguments):
                let fields = list[ir.TypeId]()
                for field in ir.nominal_fields(self.state.program, value_type): fields.append(field.value_type)
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, context, body)
            Optional(inner):
                if is_nullable_ptr_type(self.state.types, mir_value_type):
                    # Two nullable pointers are equal when their words are.
                    let same = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                    body.append(MirInstruction(form = InstructionForm.Binary(result = same, operation = BinaryOp.eq, left = left, right = right), span = span))
                    return same
                let left_present = self.load_present(left, span, body)
                let right_present = self.load_present(right, span, body)
                let tags_equal = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = tags_equal, operation = BinaryOp.eq, left = left_present, right = right_present), span = span))
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(tags_equal, [result], span, body)
                let compared = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(left_present, [compared], span, body)
                let inner_type = try self.state.mir_type_of(module, function, span, inner)
                let left_payload = self.load_value(inner_type, self.payload_address(mir_value_type, left, span, body), span, body)
                let right_payload = self.load_value(inner_type, self.payload_address(mir_value_type, right, span, body), span, body)
                var payloads_equal = self.bool_constant(true, span, body)
                if context != none:
                    let active = context
                    payloads_equal = try self.lower_nested_equality(module, function, span, inner, left_payload, right_payload, active, body)
                else:
                    payloads_equal = try self.lower_equality_definition(module, function, span, inner, left_payload, right_payload, none, body)
                self.emit_yield(payloads_equal, span, body)
                self.emit_else(span, body)
                self.emit_yield(self.bool_constant(true, span, body), span, body)
                self.emit_end(span, body)
                self.emit_yield(compared, span, body)
                self.emit_else(span, body)
                self.emit_yield(self.bool_constant(false, span, body), span, body)
                self.emit_end(span, body)
                return result
            String: return try self.lower_buffer_equality(mir_value_type, left, right, span, body)
            Bytes: return try self.lower_buffer_equality(mir_value_type, left, right, span, body)
            ErrorCode:
                let fields = [resolve_builtin_type(BuiltinType.string), resolve_builtin_type(BuiltinType.unsigned_u32)]
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, context, body)
            Error:
                let fields = [resolve_builtin_type(BuiltinType.error_code), resolve_builtin_type(BuiltinType.string)]
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, context, body)
            Enum(index, arguments):
                let left_tag = self.load_enum_tag(mir_value_type, left, span, body)
                let right_tag = self.load_enum_tag(mir_value_type, right, span, body)
                let tags_equal = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = tags_equal, operation = BinaryOp.eq, left = left_tag, right = right_tag), span = span))
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(tags_equal, [result], span, body)
                let payload_cases = list[i64]()
                let cases = ir.nominal_cases(self.state.program, value_type)
                for case_index in range(0, len(cases)):
                    if len(cases[case_index].payload) > 0: payload_cases.append(case_index)
                let compared = try self.lower_enum_case_chain(module, function, span, value_type, mir_value_type, left, right, left_tag, payload_cases, 0, context, body)
                self.emit_yield(compared, span, body)
                self.emit_else(span, body)
                self.emit_yield(self.bool_constant(false, span, body), span, body)
                self.emit_end(span, body)
                return result
            else: error(self.state.unsupported(module, function, span, "equality on `" + describe_type(self.state.program.types, value_type) + "`"))

    func lower_array_equality(module: HirModule, function: HirFunction, span: SourceSpan, hir_element_type: ir.TypeId, count: i64, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let boolean_type = builtin_mir_type(BuiltinMirType.boolean)
        let element_type = try self.state.mir_type_of(module, function, span, hir_element_type)
        let equal_value = self.bool_constant(true, span, body)
        let unequal_value = self.bool_constant(false, span, body)
        let result = self.state.new_register(boolean_type)
        let loop = self.begin_counted_loop(self.integer_constant(index_type, 0, span, body), self.integer_constant(index_type, count, span, body), [result], span, body)
        self.exit_counted_loop_when_done(loop, [equal_value], span, body)
        let left_value = self.load_value(element_type, self.element_address(element_type, left, loop.index, span, body), span, body)
        let right_value = self.load_value(element_type, self.element_address(element_type, right, loop.index, span, body), span, body)
        var element_equal = self.bool_constant(true, span, body)
        if context != none:
            let active = context
            element_equal = try self.lower_nested_equality(module, function, span, hir_element_type, left_value, right_value, active, body)
        else:
            element_equal = try self.lower_equality_definition(module, function, span, hir_element_type, left_value, right_value, none, body)
        let differs = self.state.new_register(boolean_type)
        body.append(MirInstruction(form = InstructionForm.Unary(result = differs, operation = UnaryOp.bool_not, operand = element_equal), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = differs, depth = 1, values = self.state.operands.run([unequal_value])), span = span))
        self.end_counted_loop(loop, span, body)
        return result

    func lower_structural_fields(module: HirModule, function: HirFunction, span: SourceSpan, mir_value_type: TypeId, fields: list[ir.TypeId], left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        var so_far = self.bool_constant(true, span, body)
        for index in range(0, len(fields)):
            let field_type = try self.state.mir_type_of(module, function, span, fields[index])
            let left_value = self.load_value(field_type, self.field_address(mir_value_type, left, index, span, body), span, body)
            let right_value = self.load_value(field_type, self.field_address(mir_value_type, right, index, span, body), span, body)
            so_far = try self.lower_and_then(module, function, span, so_far, fields[index], left_value, right_value, context, body)
        return so_far

    # `so_far and left == right`, evaluated only when `so_far` holds.
    func lower_and_then(module: HirModule, function: HirFunction, span: SourceSpan, so_far: RegisterId, value_type: ir.TypeId, left: RegisterId, right: RegisterId, context: RegisterId?, body: list[MirInstruction]) -> RegisterId!:
        let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(so_far, [result], span, body)
        var equal = self.bool_constant(true, span, body)
        if context != none:
            let active = context
            equal = try self.lower_nested_equality(module, function, span, value_type, left, right, active, body)
        else:
            equal = try self.lower_equality_definition(module, function, span, value_type, left, right, none, body)
        self.emit_yield(equal, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.emit_end(span, body)
        return result

    func lower_buffer_comparison(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, value_type: TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        match operation:
            Equal(item): return try self.lower_buffer_equality(value_type, left, right, span, body)
            NotEqual(item):
                let equal = try self.lower_buffer_equality(value_type, left, right, span, body)
                let result = self.state.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Unary(result = result, operation = UnaryOp.bool_not, operand = equal), span = span))
                return result
            Less(item): return try self.lower_buffer_ordering(operation, value_type, left, right, span, body)
            LessEqual(item): return try self.lower_buffer_ordering(operation, value_type, left, right, span, body)
            Greater(item): return try self.lower_buffer_ordering(operation, value_type, left, right, span, body)
            GreaterEqual(item): return try self.lower_buffer_ordering(operation, value_type, left, right, span, body)
            else: try self.state.fail_unsupported(module, function, span, "operation `" + str(operation) + "` on immutable buffer data")
        return RegisterId(value = no_register)

    # Return the requested relation over the first differing byte, or over
    # lengths when one byte sequence is an exact prefix of the other.
    func lower_buffer_ordering(operation: BinaryOperation, value_type: TypeId, left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let order_type = builtin_mir_type(BuiltinMirType.signed_i8)
        let left_length = try self.text_length(value_type, left, span, body)
        let right_length = try self.text_length(value_type, right, span, body)
        let left_data = try self.text_data(value_type, left, span, body)
        let right_data = try self.text_data(value_type, right, span, body)
        let left_is_not_longer = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = left_is_not_longer, operation = BinaryOp.le, left = left_length, right = right_length), span = span))
        let shared_length = self.state.new_register(index_type)
        self.open_if(left_is_not_longer, [shared_length], span, body)
        self.emit_yield(left_length, span, body)
        self.emit_else(span, body)
        self.emit_yield(right_length, span, body)
        self.emit_end(span, body)

        let length_order = self.state.new_register(order_type)
        let lengths_equal = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = lengths_equal, operation = BinaryOp.eq, left = left_length, right = right_length), span = span))
        self.open_if(lengths_equal, [length_order], span, body)
        self.emit_yield(self.integer_constant(order_type, 0, span, body), span, body)
        self.emit_else(span, body)
        let unequal_length_order = self.state.new_register(order_type)
        self.open_if(left_is_not_longer, [unequal_length_order], span, body)
        self.emit_yield(self.integer_constant(order_type, -1, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(self.integer_constant(order_type, 1, span, body), span, body)
        self.emit_end(span, body)
        self.emit_yield(unequal_length_order, span, body)
        self.emit_end(span, body)

        let ordering = self.state.new_register(order_type)
        let loop = self.begin_counted_loop(self.integer_constant(index_type, 0, span, body), shared_length, [ordering], span, body)
        self.exit_counted_loop_when_done(loop, [length_order], span, body)
        let left_address = self.element_address(byte_type, left_data, loop.index, span, body)
        let right_address = self.element_address(byte_type, right_data, loop.index, span, body)
        let left_byte = self.load_value(byte_type, left_address, span, body)
        let right_byte = self.load_value(byte_type, right_address, span, body)
        let less = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = less, operation = BinaryOp.lt, left = left_byte, right = right_byte), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = less, depth = 1, values = self.state.operands.run([self.integer_constant(order_type, -1, span, body)])), span = span))
        let greater = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = greater, operation = BinaryOp.gt, left = left_byte, right = right_byte), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = greater, depth = 1, values = self.state.operands.run([self.integer_constant(order_type, 1, span, body)])), span = span))
        self.end_counted_loop(loop, span, body)

        var relation = BinaryOp.lt
        match operation:
            Less(item): relation = BinaryOp.lt
            LessEqual(item): relation = BinaryOp.le
            Greater(item): relation = BinaryOp.gt
            GreaterEqual(item): relation = BinaryOp.ge
            else: trap("non-ordering operation reached buffer ordering")
        let result = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = result, operation = relation, left = ordering, right = self.integer_constant(order_type, 0, span, body)), span = span))
        return result

    # Same length, then the same bytes: a counter in a slot drives a loop
    # that leaves its block with `false` at the first mismatch and `true`
    # when the counter reaches the length.
    # The bytes and the `u64` byte count of a text value: an owned buffer's
    # data and length fields, or a Base view's two words, its `usize` widened.
    func text_data(text_type: TypeId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        if self.is_text_view_type(text_type): return try self.load_field(text_type, value, 0, span, body)
        return try self.load_field(text_type, value, self.state.buffer_data_field(), span, body)

    func text_length(text_type: TypeId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        if not self.is_text_view_type(text_type): return try self.load_field(text_type, value, self.state.buffer_length_field(), span, body)
        let count = try self.load_field(text_type, value, 1, span, body)
        let widened = self.state.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Convert(result = widened, operation = ConvertOp.widen, operand = count), span = span))
        return widened

    # A view is the two-word struct; an owned buffer carries its owner first.
    func is_text_view_type(text_type: TypeId) -> bool:
        match mir_type(self.state.types, text_type):
            Struct(fields): return len(fields) == 2
            else: return false

    func lower_buffer_equality(text_type: TypeId, left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let left_length = try self.text_length(text_type, left, span, body)
        let right_length = try self.text_length(text_type, right, span, body)
        let same_length = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = same_length, operation = BinaryOp.eq, left = left_length, right = right_length), span = span))
        let result = self.state.new_register(boolean)
        self.open_if(same_length, [result], span, body)
        let left_bytes = try self.text_data(text_type, left, span, body)
        let right_bytes = try self.text_data(text_type, right, span, body)
        let compared = self.state.new_register(boolean)
        let loop = self.begin_counted_loop(self.integer_constant(index_type, 0, span, body), left_length, [compared], span, body)
        self.exit_counted_loop_when_done(loop, [self.bool_constant(true, span, body)], span, body)
        let left_byte = self.load_value(byte_type, self.element_address(byte_type, left_bytes, loop.index, span, body), span, body)
        let right_byte = self.load_value(byte_type, self.element_address(byte_type, right_bytes, loop.index, span, body), span, body)
        let differ = self.state.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = differ, operation = BinaryOp.ne, left = left_byte, right = right_byte), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = differ, depth = 1, values = self.state.operands.run([self.bool_constant(false, span, body)])), span = span))
        self.end_counted_loop(loop, span, body)
        self.emit_yield(compared, span, body)
        self.emit_else(span, body)
        let shorter = self.bool_constant(false, span, body)
        self.emit_yield(shorter, span, body)
        self.emit_end(span, body)
        return result

# The implicit widening of base.md §7.5 between a fixed width and a
# pointer-width integer: one signedness, and no target can lose a value.
func is_implicit_widening(types: ir.TypeTable, source: ir.TypeId, destination: ir.TypeId) -> bool:
    if ir.is_unsigned_integer_type(types, source) != ir.is_unsigned_integer_type(types, destination): return false
    if ir.is_pointer_integer_type(types, source):
        return not ir.is_pointer_integer_type(types, destination) and ir.integer_bit_width(types, destination) == 64
    return ir.integer_bit_width(types, source) <= 32

# The pointee of a Base pointer type; a compiler bug if the type is not one.
func pointee_of(types: ir.TypeTable, pointer_type: ir.TypeId) -> ir.TypeId:
    match types.definitions[pointer_type.value].form:
        Pointer(pointee, is_const, is_volatile): return pointee
        else: trap("pointer operation on a non-pointer HIR type")

# The element of a Base span type; a compiler bug if the type is not one.
func span_element_of(types: ir.TypeTable, span_type: ir.TypeId) -> ir.TypeId:
    match types.definitions[span_type.value].form:
        Span(element, is_const): return element
        else: trap("span operation on a non-span HIR type")
