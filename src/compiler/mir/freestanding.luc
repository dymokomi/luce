#==============================================================================================
#
#   freestanding - A Base package reaches nothing the Luce runtime implements
#
#   DESCRIPTION:
#       A Luce Base artifact links no Luce runtime (base.md §1.3). The HIR
#       checker already refuses every runtime-backed spelling in a `.lucb`
#       module, so this is the structural guard behind that promise: after
#       lowering, no function of a Base package may hold a value whose
#       canonical type only full Luce admits. The check names the function and
#       the type so a violation is a diagnostic, never a trap or a link error.
#
#       Admission is answered by `profile.luc` over `mir_type_key`; no target
#       fact enters here.
#
#==============================================================================================

from compiler.mir.canonical import MirProgram, TypeId, describe_mir_type, mir_type, mir_type_key
from compiler.profile import Profile, admits_mir_type

## Reject the first function whose registers, slots, or signature use a type
## the Base profile does not admit.
pub func require_freestanding(program: MirProgram) -> !:
    for function in program.functions:
        for register_type in function.registers: try require_base_type(program, function.name, register_type)
        for slot in function.slots: try require_base_type(program, function.name, slot.value_type)
        for parameter in function.signature.parameters: try require_base_type(program, function.name, parameter)
        for result in function.signature.results: try require_base_type(program, function.name, result)

func require_base_type(program: MirProgram, function_name: str, value_type: TypeId) -> !:
    let definition = mir_type(program.types, value_type)
    if not admits_mir_type(Profile.base, mir_type_key(definition)):
        error("freestanding: `" + function_name + "` needs the Luce runtime for its `" + describe_mir_type(program.types, value_type) + "` value; a Luce Base artifact links none (base.md §1.3)")
