#==============================================================================================
#
#   lowerer - Typed HIR into canonical MIR
#
#   DESCRIPTION:
#       Coordinates one analyzed program lowering transaction. It declares all
#       callable, C, global, runtime, and generated-helper identities before
#       publishing a MirProgram, while FunctionLowerer owns the mutually
#       recursive walk of each function body.
#
#       Lowering runs once. The resulting canonical MIR is identical for every
#       backend; target layout, ABI, linking, and host-tool concerns begin only
#       behind the backend boundary.
#
#==============================================================================================

from compiler.hir.analyzer import AnalyzedProgram
from compiler.hir.ir import BuiltinType, HirFunctionImplementation, SymbolId, TypeForm, no_node, resolve_builtin_type, type_contains_parameter
from compiler.mir.canonical import FunctionId, InterfaceId, MirClosure, MirConformance, MirFunction, MirGlobal, MirInitializer, MirInterface, MirProcessEntry, MirProgram, MirType, mir_type
from compiler.mir.constant_folder import ConstantFolder
from compiler.mir.function_lowerer import FunctionLowerer
from compiler.frontend.source import format_diagnostic
from compiler.mir.lowering_model import CWrapper, LoweredFunction, MirLoweringState, contains_symbol

## Turns one semantically analyzed typed-HIR program into canonical MIR.
pub class Lowerer:
    let state: MirLoweringState
    let functions: FunctionLowerer

    ## Prepare one shared transaction; lower walks it exactly once.
    pub init(program: AnalyzedProgram):
        let direct_spawn_functions = list[SymbolId]()
        for summary in program.operational_summaries:
            if summary.has_direct_spawn: direct_spawn_functions.append(summary.function)
        let state = MirLoweringState(program.hir, program.borrowed_receiver_methods, direct_spawn_functions)
        self.state = state
        self.functions = FunctionLowerer(state)
        # Program-wide tables (classes, closures, conformances) are lowered
        # before any module is entered, under full Luce's representation;
        # each module installs its own on entry.
        self.state.use_representation(self.functions.full_representation)

    # mark: Program lowering ====================================================================

    ## Declare every program identity before lowering bodies and publish one
    ## verified-shape canonical program for every backend.
    pub func lower() -> MirProgram!:
        var next_definition: u32 = 0
        let callback_symbols = self.state.c_wrapper_symbols()
        for function in self.state.program.functions:
            match function.implementation:
                ExternalC(contract):
                    let module = self.state.program.modules[function.module.value]
                    let signature = try self.state.lower_external_signature(module, function, contract)
                    let external = try self.state.declare_c_extern(function, contract, signature)
                    self.state.lowered_functions.append(LoweredFunction.External(external = external))
                    self.state.c_wrappers.append(CWrapper.Absent)
                ExportedC(body):
                    self.state.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    self.state.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition + 1)))
                    next_definition += 2
                Defined(body):
                    self.state.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    next_definition += 1
                    if contains_symbol(callback_symbols, function.symbol):
                        self.state.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition)))
                        next_definition += 1
                    else:
                        self.state.c_wrappers.append(CWrapper.Absent)

        # Every concrete class application owns one exact lifecycle callback.
        # Abstract generic declaration schemas never enter canonical MIR.
        for definition in self.state.program.types.definitions:
            match definition.form:
                Class(declaration, arguments):
                    if not type_contains_parameter(self.state.program.types, definition.id):
                        self.state.reserve_class(definition.id, FunctionId(value = next_definition))
                        next_definition += 1
                else: pass

        # Capturing closures and mutable capture cells share the managed
        # object runtime but own distinct payload schemas and destroyers.
        for closure in self.state.program.closures:
            if len(closure.captures) == 0: continue
            self.state.closure_destroyers.append(FunctionId(value = next_definition))
            next_definition += 1
        for symbol in self.state.program.shared_cells:
            let value_type = self.state.program.symbols[symbol.value].value_type
            if self.state.cell_for_hir_type(value_type) != none: continue
            try self.state.reserve_cell(value_type, FunctionId(value = next_definition))
            next_definition += 1

        # Every conformance owns one normalized thunk per requirement. Fix all
        # identities before any body or structural helper is lowered.
        for conformance in self.state.program.conformances:
            let witnesses = list[FunctionId]()
            for implementation in conformance.implementations:
                witnesses.append(FunctionId(value = next_definition))
                next_definition += 1
            self.state.conformance_witnesses.append(witnesses)
        self.state.next_generated_function = next_definition
        try self.state.lower_classes()
        try self.state.lower_closures()

        # Lower exact applied contracts once, then pair each concrete type
        # with its fixed witnesses and structural ownership callbacks.
        for conformance_index in range(0, len(self.state.program.conformances)):
            let source = self.state.program.conformances[conformance_index]
            let interface_type = try self.state.lower_mir_type(source.interface_type)
            var interface_id = InterfaceId(value = 0)
            match mir_type(self.state.types, interface_type):
                Interface(identity): interface_id = identity
                else: trap("HIR conformance has no MIR interface type")
            let value_type = try self.state.lower_mir_type(source.value_type)
            let ownership = self.functions.ownership_helper_for(value_type)
            self.state.conformances.append(MirConformance(
                interface_id = interface_id,
                value_type = value_type,
                implementations = self.state.conformance_witnesses[conformance_index],
                retain = ownership.retain,
                release = ownership.release,
            ))

        # C objects share the linker namespace with C functions. Equal
        # declarations in several raw modules share one canonical identity.
        for variable in self.state.program.extern_variables:
            self.state.lowered_external_globals.append(try self.state.declare_external_global(variable))
        for global in self.state.program.globals:
            let global_module = self.state.program.modules[global.module.value]
            self.state.enter_module(global_module, self.functions.representation_for(global_module))
            var initial: MirInitializer? = none
            if global.initializer.value != no_node:
                initial = ConstantFolder(self.state).initializer_of(global.initializer) catch reason:
                    let module = self.state.program.modules[global.module.value]
                    error(format_diagnostic(module.path, global.span, "initialiser of global `" + global.name + "`: " + reason))
            self.state.globals.append(MirGlobal(
                name = self.state.program.modules[global.module.value].name + "." + global.name,
                value_type = try self.state.global_mir_type(global),
                initial = initial,
                is_thread_local = global.is_thread_local,
                is_mutable = true,
                attributes = global.attributes,
            ))

        let functions = list[MirFunction]()
        for function in self.state.program.functions:
            match function.implementation:
                ExternalC(contract): pass
                ExportedC(body):
                    let module = self.state.program.modules[function.module.value]
                    self.state.enter_module(module, self.functions.representation_for(module))
                    functions.append(try self.functions.lower_function(module, function))
                    functions.append(try self.functions.lower_c_wrapper(module, function, true))
                Defined(body):
                    let module = self.state.program.modules[function.module.value]
                    self.state.enter_module(module, self.functions.representation_for(module))
                    functions.append(try self.functions.lower_function(module, function))
                    match self.state.c_wrappers[self.state.function_index_of(function.symbol)]:
                        Present(wrapper): functions.append(try self.functions.lower_c_wrapper(module, function, false))
                        Absent: pass

        for class_index in range(0, len(self.state.class_hir_types)):
            let destroyer = self.state.class_destroyers[class_index]
            if len(functions) != i64(destroyer.value): trap("class destroyer function identities lost declaration order")
            functions.append(self.functions.lower_class_destroyer(class_index, destroyer))

        for closure_index in range(0, len(self.state.closures)):
            let destroyer = self.state.closure_destroyers[closure_index]
            if len(functions) != i64(destroyer.value): trap("closure destroyer function identities lost declaration order")
            functions.append(self.functions.lower_closure_destroyer(closure_index, destroyer))

        for cell in self.state.cells:
            if len(functions) != i64(cell.destroyer.value): trap("cell destroyer function identities lost declaration order")
            functions.append(self.functions.lower_cell_destroyer(cell))

        for conformance_index in range(0, len(self.state.program.conformances)):
            let witnesses = self.state.conformance_witnesses[conformance_index]
            for requirement_index in range(0, len(witnesses)):
                if len(functions) != i64(witnesses[requirement_index].value): trap("interface witness function identities lost declaration order")
                functions.append(try self.functions.lower_interface_witness(conformance_index, requirement_index))

        # HIR has already selected and validated the exact source entry. MIR
        # retains its ordinary fallible signature and only adds the semantic
        # ownership facts a backend needs to materialize process arguments.
        # Reserving these helpers before draining the generated-function queue
        # keeps all FunctionIds stable.
        let process_entry = try self.lower_process_entry()

        # Helper identities are reserved lazily while bodies lower. Generate
        # the shared queue in reservation order; recursive value shapes may
        # reserve more ownership or equality helpers while an earlier body is
        # emitted.
        var helper_index = 0
        while helper_index < len(self.state.generated_helpers):
            let generated = self.state.generated_helpers[helper_index]
            match generated:
                Ownership(value_type, retaining, function):
                    if len(functions) != i64(function.value): trap("ownership helper function identities lost declaration order")
                    functions.append(self.functions.lower_ownership_helper(value_type, retaining, function))
                Equality(helper):
                    if len(functions) != i64(helper.function.value): trap("equality helper function identities lost declaration order")
                    functions.append(try self.functions.lower_equality_helper(helper))
            helper_index += 1

        return MirProgram(
            types = self.state.types,
            classes = self.state.classes,
            interfaces = self.state.interfaces,
            conformances = self.state.conformances,
            closures = self.state.closures,
            runtime_bindings = self.state.lower_runtime_bindings(),
            externs = self.state.externs,
            external_globals = self.state.external_globals,
            globals = self.state.globals,
            data = self.state.data,
            functions = functions,
            process_entry = process_entry,
        )

    func lower_process_entry() -> MirProcessEntry?!:
        let source_entry = self.state.program.process_entry
        if source_entry == none: return none
        let source_index = self.state.function_index_of(source_entry)
        if source_index < 0: trap("HIR process entry names an unknown function")
        var function = FunctionId(value = 0)
        match self.state.lowered_functions[source_index]:
            Defined(identity): function = identity
            External(external): trap("HIR process entry names an external function")
        let source = self.state.program.functions[source_index]
        if len(source.parameters) != 1: trap("validated HIR process entry lost its parameter")
        let arguments_type = try self.state.lower_mir_type(source.parameters[0].value_type)
        var element_type = arguments_type
        match mir_type(self.state.types, arguments_type):
            Slice(element): element_type = element
            else:
                # A Base span is `{data, count}`; its element is the HIR span's.
                match self.state.program.types.definitions[source.parameters[0].value_type.value].form:
                    Span(element, is_const): element_type = try self.state.lower_mir_type(element)
                    else: trap("validated HIR process entry lost its argument span")
        let failure_type = try self.state.lower_mir_type(resolve_builtin_type(BuiltinType.error_value))
        let element_ownership = self.functions.ownership_helper_for(element_type)
        let failure_ownership = self.functions.ownership_helper_for(failure_type)
        return MirProcessEntry(
            function = function,
            arguments_type = arguments_type,
            element_type = element_type,
            element_retain = element_ownership.retain,
            element_release = element_ownership.release,
            failure_type = failure_type,
            failure_release = failure_ownership.release,
        )
