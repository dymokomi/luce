#==============================================================================================
#
#   lowerer - Typed HIR into canonical MIR
#
#   DESCRIPTION:
#       Turns analyzed typed-HIR trees into canonical MIR: every value lands
#       in a fresh write-once register, every local lives in a stack slot
#       reached through `Load`/`Store`, terminal output becomes a data item
#       plus a call to the `luce_rt_write` runtime service, and a function's
#       result is an explicit `Return`. Public use begins at `Lowerer.lower`;
#       the walk goes program -> function -> statement -> expression, and
#       anything outside the executable slice fails with a clear
#       "does not support ... yet".
#
#       The compiled slice today: every scalar type (all integer widths,
#       `f32`/`f64`, `bool`, `char`), `let`/`var` locals with plain and
#       compound assignment, every unary and binary operator including
#       short-circuit `and`/`or` and the conditional expression, `if`/`elif`/
#       `else`, `while` with `break` and `continue`, functions with direct
#       calls between them across modules, module constants, parameter
#       defaults, tuples, optionals, `str` and `bytes` values with equality,
#       integer range values and `for` iteration, lexical `defer`,
#       structs with memberwise and custom initializers, fields, methods,
#       `mutating` methods and type functions,
#       exact named function values and indirect calls,
#       terminal output of a literal or a `str` value, and returning. The slice boundary lives
#       here, not in canonical MIR — failure, classes, and collections reach
#       the lowerer as HIR and stop with "does not support ... yet" until this
#       file emits the instructions for them. `main(arguments: slice[str])`
#       is the 1.0 entry signature (docs/language/1.0.md §23); its argument
#       is dropped until slices exist, so the MIR entry is `() -> i32`.
#
#       Aggregates — tuples, optionals, `str`, `bytes` — never sit in a
#       register. A value of aggregate type lives in memory, and the register
#       an expression of that type produces holds its *address*: a temporary
#       slot the expression filled, a local's slot, a field inside another
#       aggregate, or a parameter's pointer. Copies are explicit `Memcpy`s at
#       a binding, an assignment, a tuple element, a `some` payload, or a
#       `return`. A tuple is a struct of its elements; an optional is an enum
#       with a `u8` tag (0 absent, 1 present) and the payload after it; `str`
#       and `bytes` are `{pointer, u64 length}` whose bytes are a data item
#       for a literal; a struct is the same `Struct` as a tuple of its field
#       types (the name lives only in HIR). A function returning an aggregate
#       takes a hidden leading `pointer` parameter — the caller's slot for the
#       result — and returns nothing; an aggregate parameter is passed as a
#       pointer. The callee never writes through that pointer, with one
#       deliberate exceptions: a `mutating` method's `self`, whose stores land
#       in the caller's `var` slot — that is what `mutating` means, and
#       HirGenerator has already proved the receiver is a mutable place; and
#       an initializer's `self`, which is fresh caller-owned storage. A custom
#       initializer returns source-level unit, while its `Initialize` HIR
#       expression yields that completed storage (or the ordinary Error).
#       Aggregate structure stays symbolic. Field and enum-payload addresses
#       name their type and logical component; only a backend turns them into
#       target byte offsets.
#
#       Parameters are the leading registers of a function (`r0..rN-1`), as
#       canonical MIR requires; a parameter is immutable in Luce, so a
#       reference to it is the register itself. A module constant is a
#       restricted literal tree and is lowered inline at each use; aggregate
#       constants receive ordinary temporary slots through the same protocol
#       as an inline literal. A future separately addressable constant belongs
#       in a `MirGlobal`, not in backend-specific lowering.
#
#       Locals take the simple form on purpose: one `Alloca` per binding in
#       the prologue, a `Store` at the binding, a `Load` at every use. An
#       optimizer may promote them to registers later; correctness comes
#       first (docs/compiler/mir.md, "Registers").
#
#       Control flow keeps the source's shape. An `if` chain is nested `If`
#       regions; a `while` is a `Block` around a `Loop`: the loop tests its
#       condition and branches out of the block when it fails, `continue`
#       branches back to the loop, `break` branches out of the block. Branch
#       depths count every region between the branch and its target, so the
#       lowerer keeps a stack of the regions it is inside. Regions are
#       emitted in place into one flat body — opener, arm, `Else`, arm,
#       `End` — never as nested lists.
#
#       Lowering runs once. The resulting MIR is identical for every backend.
#
#==============================================================================================

from compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, DataId, ExternId, ExternalGlobalId, FunctionId, GlobalId
from compiler.mir.canonical import InstructionForm, MirConstant, MirData, MirExtern, MirExternalGlobal, MirFunction, MirGlobal, MirInstruction
from compiler.mir.canonical import MirProgram, MirRuntimeBinding, MirSignature, MirSlot, MirTypeTable, RegisterId
from compiler.mir.canonical import MirType, TypeId, UnaryOp, builtin_mir_type, create_builtin_mir_types
from compiler.mir.canonical import find_runtime_symbol, make_enum_type
from compiler.mir.canonical import OperandBuilder, RegisterRun, is_ptr_type, make_struct_type, mir_type, mir_types_match, no_register, no_registers, signatures_match
from compiler.hir.ir import AssignmentOperation, BinaryOperation, BuiltinType, HirCFunction, HirCSlot, HirConstant, HirFunction, HirFunctionImplementation, HirNodeForm, HirReceiverKind, Value
from compiler.hir.ir import HirModule, HirProgram, NodeId, Operands, SymbolId, TypeForm, describe_type, no_node
from compiler.hir.ir import entry_at, function_body, node_at, node_form, node_span, node_type, resolve_builtin_type, types_match
from compiler.hir.ir import place_element_step, place_field_step, place_list_element_step
import compiler.hir.ir
from compiler.mir.verifier import terminates
from compiler.hir.analyzer import AnalyzedProgram
from compiler.frontend.source import SourceSpan, format_diagnostic
import std.strings

func contains_symbol(symbols: list[SymbolId], target: SymbolId) -> bool:
    for symbol in symbols:
        if symbol.value == target.value: return true
    return false

# One local of the function being lowered: its HIR symbol and the register
# holding its slot address.
struct Local:
    let symbol: u32
    let address: RegisterId

# One MIR region the lowerer is currently inside, innermost last. `break`
# targets the block wrapped around a loop; `continue` targets the loop.
enum Region:
    block
    loop_body
    for_continue
    if_arm

# How one shared match-arm dispatcher leaves the selected arm. Statement
# matches execute a scope; value and fallible matches branch to a result block.
union MatchExit:
    Statement
    Value(block_depth: i64)
    Fallible(block_depth: i64)

struct FallibleResult:
    pub let value: RegisterId
    pub let error_value: RegisterId

# The already-evaluated components of an indirect call. Keeping them together
# makes the required source order explicit: select the callee first, then
# evaluate every positional argument from left to right.
struct IndirectOperands:
    let target: RegisterId
    let values: list[RegisterId]

# One C output slot allocated around a call. `raw_type` is what C writes;
# `value_type` is the tagged/nominal HIR type reconstructed afterward.
struct COutputSlot:
    let value_type: ir.TypeId
    let raw_type: TypeId
    let address: RegisterId

# Where a recover leaves its catch expression, and which deferred suffix
# belongs to the handler rather than the surrounding function.
struct RecoverTarget:
    pub let region_index: i64
    pub let defer_start: i64

# HIR has one callable identity. MIR distinguishes code in this artifact from
# a host binding, so this table is the single, explicit split point used by
# every call after all source-level lookup and argument placement is finished.
union LoweredFunction:
    Defined(function: FunctionId)
    External(external: ExternId)

# A C-callable adapter is generated only when an address conversion needs
# one, except that an explicit `export c` already owns the same adapter.
union CWrapper:
    Absent
    Present(function: FunctionId)

# The source-level contract behind one interned C symbol. Canonical MIR has
# already erased handle nominality and boundary optionals when it describes a
# raw call slot, so its signature alone cannot distinguish `Window` from
# `Window?` or from another pointer-shaped handle. Keep that semantic identity
# beside the interned extern until every declaration has been checked.
union CExternSlot:
    Input(value_type: ir.TypeId)
    Output(value_type: ir.TypeId)

struct CExternContract:
    let external: ExternId
    let name: str
    let slots: list[CExternSlot]
    let declared_result: ir.TypeId
    let is_blocking: bool

struct ExternalGlobalContract:
    let global: ExternalGlobalId
    let name: str
    let value_type: ir.TypeId

let unlowered_nominal_type: u32 = 4294967295

## Turns one semantically analyzed typed-HIR program into canonical MIR.
pub class Lowerer:
    let program: HirProgram
    # Program-wide tables the lowered functions refer to by identity.
    let types: MirTypeTable
    let externs: list[MirExtern]
    let external_globals: list[MirExternalGlobal]
    let lowered_external_globals: list[ExternalGlobalId]
    let external_global_contracts: list[ExternalGlobalContract]
    let globals: list[MirGlobal]
    let data: list[MirData]
    let lowered_functions: list[LoweredFunction]
    # Nominal aggregates reserve their MIR identity before lowering fields.
    # A collection reference may point back to that identity without making
    # the aggregate's byte layout recursive.
    let lowered_struct_types: list[u32]
    let lowered_enum_types: list[u32]
    let active_nominal_types: list[u32]
    let c_wrappers: list[CWrapper]
    let c_extern_contracts: list[CExternContract]
    # The register table, slots, live locals, and parameter registers of the
    # function being lowered.
    var registers: list[TypeId]
    var slots: list[MirSlot]
    var locals: list[Local]
    var parameters: list[Local]
    var regions: list[Region]
    # Deferred actions currently registered in enclosing lexical scopes, and
    # the first action belonging to each active source loop.
    var defers: list[NodeId]
    var loop_defer_starts: list[i64]
    var recover_targets: list[RecoverTarget]
    # The operand table of the function being lowered.
    var operands: OperandBuilder
    # Hidden caller-owned Error and aggregate-result pointers (`-1` when the
    # function does not use that protocol), and the newline data item.
    var error_slot: i64
    var result_slot: i64
    var newline_data: i64

    ## Prepare to lower one analyzed program; `lower` walks it once for every backend.
    pub init(program: AnalyzedProgram):
        self.program = program.hir
        self.types = create_builtin_mir_types()
        self.externs = list[MirExtern]()
        self.external_globals = list[MirExternalGlobal]()
        self.lowered_external_globals = list[ExternalGlobalId]()
        self.external_global_contracts = list[ExternalGlobalContract]()
        self.globals = list[MirGlobal]()
        self.data = list[MirData]()
        self.lowered_functions = list[LoweredFunction]()
        self.lowered_struct_types = list[u32]()
        for index in range(0, len(self.program.structs)): self.lowered_struct_types.append(unlowered_nominal_type)
        self.lowered_enum_types = list[u32]()
        for index in range(0, len(self.program.enums)): self.lowered_enum_types.append(unlowered_nominal_type)
        self.active_nominal_types = list[u32]()
        self.c_wrappers = list[CWrapper]()
        self.c_extern_contracts = list[CExternContract]()
        self.registers = list[TypeId]()
        self.slots = list[MirSlot]()
        self.locals = list[Local]()
        self.parameters = list[Local]()
        self.regions = list[Region]()
        self.defers = list[NodeId]()
        self.loop_defer_starts = list[i64]()
        self.recover_targets = list[RecoverTarget]()
        self.operands = OperandBuilder()
        self.error_slot = -1
        self.result_slot = -1
        self.newline_data = -1

    # mark: Lowering ============================================================================

    ## Lower every function in every module, or stop at the first construct
    ## the executable slice cannot express yet.
    pub func lower() -> MirProgram!:
        # Declare every callable identity before lowering any body, so forward
        # and cross-module calls need no late lookup or placeholder state.
        var next_definition: u32 = 0
        let callback_symbols = self.c_wrapper_symbols()
        for function in self.program.functions:
            match function.implementation:
                ExternalC(contract):
                    let module = self.program.modules[function.module.value]
                    let signature = try self.lower_external_signature(module, function, contract)
                    let external = try self.declare_c_extern(function, contract, signature)
                    self.lowered_functions.append(LoweredFunction.External(external = external))
                    self.c_wrappers.append(CWrapper.Absent)
                ExportedC(body):
                    self.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    self.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition + 1)))
                    next_definition += 2
                Defined(body):
                    self.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    next_definition += 1
                    if contains_symbol(callback_symbols, function.symbol):
                        self.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition)))
                        next_definition += 1
                    else:
                        self.c_wrappers.append(CWrapper.Absent)
        # C objects share the linker namespace with C functions. Equal
        # declarations in several raw modules share one canonical identity.
        for variable in self.program.extern_variables:
            self.lowered_external_globals.append(try self.declare_external_global(variable))
        for global in self.program.globals:
            self.globals.append(MirGlobal(
                name = self.program.modules[global.module.value].name + "." + global.name,
                value_type = try self.global_mir_type(global),
                initial = none,
                is_mutable = true,
            ))
        let functions = list[MirFunction]()
        for function in self.program.functions:
            match function.implementation:
                ExternalC(contract): pass
                ExportedC(body):
                    let module = self.program.modules[function.module.value]
                    functions.append(try self.lower_function(module, function))
                    functions.append(try self.lower_c_wrapper(module, function, true))
                Defined(body):
                    let module = self.program.modules[function.module.value]
                    functions.append(try self.lower_function(module, function))
                    match self.c_wrappers[self.function_index_of(function.symbol)]:
                        Present(wrapper): functions.append(try self.lower_c_wrapper(module, function, false))
                        Absent: pass
        let entry = self.find_entry(functions)
        let runtime_bindings = self.lower_runtime_bindings()
        return MirProgram(
            types = self.types,
            runtime_bindings = runtime_bindings,
            externs = self.externs,
            external_globals = self.external_globals,
            globals = self.globals,
            data = self.data,
            functions = functions,
            entry = entry,
        )

    # HIR already resolved each package-descriptor entry to a SymbolId. Map
    # that identity through the same callable table as ordinary direct calls;
    # no source spelling survives to MIR composition or a backend.
    func lower_runtime_bindings() -> list[MirRuntimeBinding]:
        let bindings = list[MirRuntimeBinding]()
        for binding in self.program.runtime_bindings:
            let source_index = self.function_index_of(binding.function)
            if source_index < 0: trap("HIR runtime binding names an unknown function symbol")
            match self.lowered_functions[source_index]:
                Defined(function): bindings.append(MirRuntimeBinding(service = binding.service, function = function))
                External(external): trap("HIR runtime binding names an external function")
        return bindings

    # HIR has already fixed each address conversion's type. Scan that one
    # canonical fact before assigning FunctionIds so generated adapters never
    # require late identity patching or backend-specific discovery.
    func c_wrapper_symbols() -> list[SymbolId]:
        let symbols = list[SymbolId]()
        for index in range(0, len(self.program.nodes)):
            match self.program.nodes[index].form:
                FunctionAddress(target):
                    match self.program.types.definitions[self.program.node_types[index].value].form:
                        CFunction(parameters, result):
                            if not contains_symbol(symbols, target): symbols.append(target)
                        else: pass
                else: pass
        return symbols

    # Entry selection uses source visibility directly without confusing it
    # with the separate artifact-export flag retained in MIR. The function
    # table was declared before bodies were lowered, so the HIR-to-MIR identity
    # map gives us the exact candidate without inspecting backend symbol
    # spelling.
    func find_entry(functions: list[MirFunction]) -> FunctionId?:
        let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
        var found: FunctionId? = none
        for index in range(0, len(self.program.functions)):
            let source = self.program.functions[index]
            if not source.is_public or source.receiver != none or source.name != "main": continue
            var candidate: FunctionId? = none
            match self.lowered_functions[index]:
                Defined(function): candidate = function
                External(external): pass
            if candidate == none: continue
            let lowered = functions[candidate.value]
            let signature = lowered.signature
            if signature.is_fallible or len(signature.parameters) != 0 or len(signature.results) != 1: continue
            if signature.results[0].value != i32_type.value: continue
            if found != none: return none
            found = candidate
        return found

    # Source process-entry recognition is shared by entry selection, its
    # temporary parameter erasure, and the function-address safety check.
    func is_process_entry(function: HirFunction) -> bool:
        if not function.is_public or function.receiver != none or function.name != "main": return false
        if len(function.parameters) != 1: return false
        return types_match(function.parameters[0].value_type, resolve_builtin_type(BuiltinType.string_slice))

    func lower_external_signature(module: HirModule, function: HirFunction, contract: HirCFunction) -> MirSignature!:
        let parameters = list[TypeId]()
        for slot in contract.slots:
            match slot:
                Input(parameter):
                    parameters.append(try self.c_boundary_type_of(module, function, function.span, function.parameters[parameter].value_type))
                Output(name, value_type):
                    # C receives the address of caller-owned raw storage.
                    parameters.append(builtin_mir_type(BuiltinMirType.pointer))
        let results = list[TypeId]()
        if not types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            results.append(try self.c_boundary_type_of(module, function, function.span, contract.declared_result))
        return MirSignature(parameters = parameters, results = results, is_fallible = false)

    # C symbols inhabit one linker namespace even when several source
    # modules declare them. Equal source contracts share one MIR identity; a
    # conflict is rejected before handle identity or nullability is erased.
    func declare_c_extern(function: HirFunction, boundary: HirCFunction, signature: MirSignature) -> ExternId!:
        for contract in self.c_extern_contracts:
            if contract.name != function.name: continue
            if not self.c_extern_contract_matches(contract, function, boundary):
                error("lowerer: conflicting declarations of C symbol `" + function.name + "`")
            let existing = self.externs[contract.external.value]
            if not signatures_match(existing.signature, signature):
                trap("matching C contracts lowered to different MIR signatures")
            return contract.external

        let external = ExternId(value = u32(len(self.externs)))
        self.externs.append(MirExtern(name = function.name, convention = CallingConvention.c, signature = signature))
        let slots = list[CExternSlot]()
        for slot in boundary.slots:
            match slot:
                Input(parameter): slots.append(CExternSlot.Input(value_type = function.parameters[parameter].value_type))
                Output(name, value_type): slots.append(CExternSlot.Output(value_type = value_type))
        self.c_extern_contracts.append(CExternContract(
            external = external,
            name = function.name,
            slots = slots,
            declared_result = boundary.declared_result,
            is_blocking = boundary.is_blocking,
        ))
        return external

    func c_extern_contract_matches(contract: CExternContract, function: HirFunction, boundary: HirCFunction) -> bool:
        if contract.is_blocking != boundary.is_blocking: return false
        if not types_match(contract.declared_result, boundary.declared_result): return false
        if len(contract.slots) != len(boundary.slots): return false
        for index in range(0, len(contract.slots)):
            let expected = contract.slots[index]
            match boundary.slots[index]:
                Input(parameter):
                    match expected:
                        Input(value_type):
                            if not types_match(value_type, function.parameters[parameter].value_type): return false
                        Output(value_type): return false
                Output(name, value_type):
                    match expected:
                        Input(input_type): return false
                        Output(output_type):
                            if not types_match(output_type, value_type): return false
        return true

    # One external object identity per linker symbol. HIR type identity is
    # compared before nominal handles are erased to their MIR token shape.
    func declare_external_global(variable: ir.HirExternVariable) -> ExternalGlobalId!:
        for external in self.externs:
            if external.name == variable.name:
                error("lowerer: C symbol `" + variable.name + "` is declared as both a function and a variable")
        for contract in self.external_global_contracts:
            if contract.name != variable.name: continue
            if not types_match(contract.value_type, variable.value_type):
                error("lowerer: conflicting declarations of C global `" + variable.name + "`")
            return contract.global
        let global = ExternalGlobalId(value = u32(len(self.external_globals)))
        self.external_globals.append(MirExternalGlobal(name = variable.name, value_type = self.external_global_type(variable.value_type)))
        self.external_global_contracts.append(ExternalGlobalContract(global = global, name = variable.name, value_type = variable.value_type))
        return global

    # Lower one function body. The canonical name is `module.function` so
    # artifacts stay unambiguous across modules. `main` keeps the entry
    # signature from the header note above; every other function's parameters
    # become its leading registers.
    # A method is named `module.Struct.method`; `self` is its first parameter
    # and, being an aggregate, arrives as a pointer — which is exactly what a
    # `mutating` method needs: its stores land in the caller's slot.
    func lower_function(module: HirModule, function: HirFunction) -> MirFunction!:
        let is_entry_name = function.is_public and function.receiver == none and function.name == "main"
        let is_entry = self.is_process_entry(function)
        if is_entry_name and not is_entry:
            try self.fail_unsupported(module, function, function.span, "entry parameters other than `(arguments: slice[str])`")

        self.begin_function()
        let parameter_types = list[TypeId]()
        let results = list[TypeId]()
        let fallible_result = self.fallible_inner(function.result)
        let is_fallible = fallible_result != none
        var successful_result = function.result
        if fallible_result != none: successful_result = fallible_result
        let returns_unit = types_match(successful_result, resolve_builtin_type(BuiltinType.unit))
        if is_fallible:
            let pointer = builtin_mir_type(BuiltinMirType.pointer)
            parameter_types.append(pointer)
            self.error_slot = i64(self.new_register(pointer).value)
        if not returns_unit:
            let result_type = try self.mir_type_of(module, function, function.span, successful_result)
            if self.is_aggregate(result_type):
                let pointer = builtin_mir_type(BuiltinMirType.pointer)
                parameter_types.append(pointer)
                self.result_slot = i64(self.new_register(pointer).value)
            else:
                results.append(result_type)
        if is_fallible: results.append(builtin_mir_type(BuiltinMirType.pointer))
        if not is_entry:
            for parameter in function.parameters:
                let parameter_type = self.register_type_for(try self.mir_type_of(module, function, function.span, parameter.value_type))
                parameter_types.append(parameter_type)
                self.parameters.append(Local(symbol = parameter.symbol.value, address = self.new_register(parameter_type)))

        let body = list[MirInstruction]()
        let source_body = function_body(function)
        try self.lower_prologue(module, function, source_body, body)
        try self.lower_scope(module, function, source_body, body)
        # MIR ends every path with a syntactic terminator. A unit function may
        # simply finish, so it gets `Return []`. A value function whose body
        # does not end in a terminator has already been proved by HirGenerator
        # to return on every path (an `if` chain whose arms all return, say);
        # the trailing `Unreachable` records that proof for the verifier.
        if not terminates(body):
            if returns_unit:
                if is_fallible:
                    let no_error = self.null_constant(function.span, body)
                    body.append(MirInstruction(form = InstructionForm.Return(values = self.operands.run([no_error])), span = function.span))
                else:
                    body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = function.span))
            else:
                body.append(MirInstruction(form = InstructionForm.Unreachable, span = function.span))
        var name = module.name + "." + function.name
        let receiver = function.receiver
        if receiver != none: name = module.name + "." + describe_type(self.program.types, receiver.owner) + "." + function.name
        return MirFunction(
            name = name,
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = parameter_types, results = results, is_fallible = is_fallible),
            registers = self.registers,
            slots = self.slots,
            body = body,
            operands = self.operands.operands,
            is_public = function.is_public,
            is_exported = false,
            span = function.span,
        )

    func begin_function():
        self.registers = list[TypeId]()
        self.slots = list[MirSlot]()
        self.locals = list[Local]()
        self.parameters = list[Local]()
        self.regions = list[Region]()
        self.defers = list[NodeId]()
        self.loop_defer_starts = list[i64]()
        self.recover_targets = list[RecoverTarget]()
        self.operands = OperandBuilder()
        self.error_slot = -1
        self.result_slot = -1

    # One target-neutral C adapter. The source body remains an ordinary
    # Luce-convention function so source calls never acquire boundary traps or
    # null encoding. Explicit exports and named cfunc conversions share it;
    # both artifact backends consume the same canonical wrapper.
    func lower_c_wrapper(module: HirModule, function: HirFunction, is_exported: bool) -> MirFunction!:
        self.begin_function()
        let body = list[MirInstruction]()
        let parameter_types = list[TypeId]()
        let internal_arguments = list[RegisterId]()
        for parameter in function.parameters:
            let raw_type = try self.c_boundary_type_of(module, function, function.span, parameter.value_type)
            parameter_types.append(raw_type)
            let raw_value = self.new_register(raw_type)
            internal_arguments.append(try self.decode_c_boundary_value(module, function, function.span, parameter.value_type, raw_value, body))

        let source_index = self.function_index_of(function.symbol)
        if source_index < 0: error("lowerer: C export has no source function identity")
        var internal = FunctionId(value = 0)
        match self.lowered_functions[source_index]:
            Defined(function_id): internal = function_id
            External(external): trap("C export mapped to an external identity")
        let results = list[TypeId]()
        if types_match(function.result, resolve_builtin_type(BuiltinType.unit)):
            body.append(MirInstruction(form = InstructionForm.Call(results = no_registers(), function = internal, arguments = self.operands.run(internal_arguments)), span = function.span))
            body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = function.span))
        else:
            let internal_type = try self.mir_type_of(module, function, function.span, function.result)
            var internal_result = RegisterId(value = no_register)
            let call_results = list[RegisterId]()
            if self.is_aggregate(internal_type):
                internal_result = self.new_temp(internal_type, function.span, body)
                let with_result = [internal_result]
                for argument in internal_arguments: with_result.append(argument)
                body.append(MirInstruction(form = InstructionForm.Call(results = no_registers(), function = internal, arguments = self.operands.run(with_result)), span = function.span))
            else:
                internal_result = self.new_register(internal_type)
                call_results.append(internal_result)
                body.append(MirInstruction(form = InstructionForm.Call(results = self.operands.run(call_results), function = internal, arguments = self.operands.run(internal_arguments)), span = function.span))
            let encoded = try self.encode_c_boundary_value(module, function, function.span, function.result, internal_result, body)
            results.append(try self.c_boundary_type_of(module, function, function.span, function.result))
            body.append(MirInstruction(form = InstructionForm.Return(values = self.operands.run([encoded])), span = function.span))

        var wrapper_name = function.name
        # A leading dot cannot be written as a Luce declaration name, making
        # the generated namespace collision-free without backend mangling.
        if not is_exported: wrapper_name = ".luce_cfunc_" + str(function.symbol.value)
        return MirFunction(
            name = wrapper_name,
            convention = CallingConvention.c,
            signature = MirSignature(parameters = parameter_types, results = results, is_fallible = false),
            registers = self.registers,
            slots = self.slots,
            body = body,
            operands = self.operands.operands,
            is_public = false,
            is_exported = is_exported,
            span = function.span,
        )

    # Every binding in the body — at any nesting depth — gets its slot up
    # front, so the address registers exist before any statement runs and a
    # backend can size the frame from `slots` alone.
    func lower_prologue(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        for position in range(0, i64(statements.count)):
            let statement = node_at(self.program, statements, position)
            let span = node_span(self.program, statement)
            # Pattern bindings inside any `match` the statement contains.
            try self.lower_prologue_node(module, function, statement, body)
            match node_form(self.program, statement):
                Binding(symbol, is_mutable, value):
                    let slot_type = try self.mir_type_of(module, function, span, node_type(self.program, value))
                    let slot = len(self.slots)
                    self.slots.append(MirSlot(value_type = slot_type))
                    let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                    body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
                    self.locals.append(Local(symbol = symbol.value, address = address))
                IfStatement(branches, has_fallback, fallback):
                    for branch in range(0, i64(branches.count) // 3):
                        try self.lower_prologue(module, function, self.branch_body(branches, branch), body)
                    if has_fallback: try self.lower_prologue(module, function, fallback, body)
                WhileStatement(condition, loop_body):
                    try self.lower_prologue(module, function, loop_body, body)
                ForStatement(symbol, iterable, loop_body):
                    try self.reserve_slot(module, function, symbol, span, body)
                    try self.lower_prologue(module, function, loop_body, body)
                else: pass

    # A `match` may sit anywhere an expression can and binds payloads in its
    # arms, so slots for pattern bindings are found by walking expressions.
    func lower_prologue_node(module: HirModule, function: HirFunction, node: NodeId, body: list[MirInstruction]) -> !:
        let span = node_span(self.program, node)
        match node_form(self.program, node):
            Match(subject, arms, has_result):
                try self.lower_prologue_node(module, function, subject, body)
                for position in range(0, i64(arms.count)):
                    let arm = node_at(self.program, arms, position)
                    match node_form(self.program, arm):
                        MatchArm(patterns, statements, value):
                            for pattern_position in range(0, i64(patterns.count)):
                                match node_form(self.program, node_at(self.program, patterns, pattern_position)):
                                    PatternCase(case_index, bindings):
                                        for binding in range(0, i64(bindings.count)):
                                            let symbol = SymbolId(value = u32(entry_at(self.program, bindings, binding)))
                                            try self.reserve_slot(module, function, symbol, span, body)
                                    else: pass
                            try self.lower_prologue(module, function, statements, body)
                            if value.value != no_node: try self.lower_prologue_node(module, function, value, body)
                        else: pass
            Binding(symbol, is_mutable, value): try self.lower_prologue_node(module, function, value, body)
            Assignment(symbol, operation, value): try self.lower_prologue_node(module, function, value, body)
            ExternStore(variable, operation, value): try self.lower_prologue_node(module, function, value, body)
            GlobalStore(global, operation, value): try self.lower_prologue_node(module, function, value, body)
            NativeLoad(pointer): try self.lower_prologue_node(module, function, pointer, body)
            NativeStore(pointer, value):
                try self.lower_prologue_node(module, function, pointer, body)
                try self.lower_prologue_node(module, function, value, body)
            NativeAdvance(pointer, count):
                try self.lower_prologue_node(module, function, pointer, body)
                try self.lower_prologue_node(module, function, count, body)
            NativeRebind(pointer): try self.lower_prologue_node(module, function, pointer, body)
            NativeMove(destination, source, count):
                try self.lower_prologue_node(module, function, destination, body)
                try self.lower_prologue_node(module, function, source, body)
                try self.lower_prologue_node(module, function, count, body)
            NativeAllocate(element_type, count): try self.lower_prologue_node(module, function, count, body)
            NativeArena(end): try self.lower_prologue_node(module, function, end, body)
            PlaceAssignment(symbol, steps, operation, value):
                for position in range(0, i64(steps.count) // 2):
                    let step = u32(entry_at(self.program, steps, position * 2))
                    if step == place_element_step or step == place_list_element_step:
                        try self.lower_prologue_node(module, function, NodeId(value = u32(entry_at(self.program, steps, position * 2 + 1))), body)
                try self.lower_prologue_node(module, function, value, body)
            PrintValue(value): try self.lower_prologue_node(module, function, value, body)
            ReturnStatement(value):
                if value.value != no_node: try self.lower_prologue_node(module, function, value, body)
            RecoverStatement(value): try self.lower_prologue_node(module, function, value, body)
            DeferStatement(action): try self.lower_prologue_node(module, function, action, body)
            ExpressionStatement(value): try self.lower_prologue_node(module, function, value, body)
            IfStatement(branches, has_fallback, fallback):
                for branch in range(0, i64(branches.count) // 3):
                    try self.lower_prologue_node(module, function, self.branch_condition(branches, branch), body)
            WhileStatement(condition, loop_body): try self.lower_prologue_node(module, function, condition, body)
            ForStatement(symbol, iterable, loop_body): try self.lower_prologue_node(module, function, iterable, body)
            SequenceLength(value): try self.lower_prologue_node(module, function, value, body)
            SequenceIndex(value, index):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, index, body)
            Array(elements):
                for position in range(0, i64(elements.count)):
                    try self.lower_prologue_node(module, function, node_at(self.program, elements, position), body)
            List(elements): try self.lower_prologue_run(module, function, elements, body)
            ListCopy(value): try self.lower_prologue_node(module, function, value, body)
            ListAppend(value, element):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, element, body)
            ListInsert(value, index, element):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, index, body)
                try self.lower_prologue_node(module, function, element, body)
            ListRemoveAt(value, index):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, index, body)
            ListClear(value): try self.lower_prologue_node(module, function, value, body)
            ListReserve(value, minimum_capacity):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, minimum_capacity, body)
            Unary(operation, operand): try self.lower_prologue_node(module, function, operand, body)
            Binary(left, operation, right):
                try self.lower_prologue_node(module, function, left, body)
                try self.lower_prologue_node(module, function, right, body)
            Range(lower, upper, inclusive):
                try self.lower_prologue_node(module, function, lower, body)
                try self.lower_prologue_node(module, function, upper, body)
            Conditional(value, condition, alternative):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, condition, body)
                try self.lower_prologue_node(module, function, alternative, body)
            Call(callee, arguments):
                for pair in range(0, i64(arguments.count) // 2):
                    try self.lower_prologue_node(module, function, NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1))), body)
            FunctionAddress(target): pass
            IndirectCall(callee, arguments):
                try self.lower_prologue_node(module, function, callee, body)
                try self.lower_prologue_run(module, function, arguments, body)
            Initialize(callee, arguments):
                for pair in range(0, i64(arguments.count) // 2):
                    try self.lower_prologue_node(module, function, NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1))), body)
            Raise(code, message):
                try self.lower_prologue_node(module, function, code, body)
                try self.lower_prologue_node(module, function, message, body)
            Try(value): try self.lower_prologue_node(module, function, value, body)
            Catch(value, failure, catch_body):
                try self.lower_prologue_node(module, function, value, body)
                try self.reserve_slot(module, function, failure, span, body)
                try self.lower_prologue(module, function, catch_body, body)
            Tuple(elements): try self.lower_prologue_run(module, function, elements, body)
            Element(value, index): try self.lower_prologue_node(module, function, value, body)
            StructValue(struct_index, fields): try self.lower_prologue_run(module, function, fields, body)
            EnumValue(enum_index, case_index, payload): try self.lower_prologue_run(module, function, payload, body)
            FieldAccess(value, field): try self.lower_prologue_node(module, function, value, body)
            Some(value): try self.lower_prologue_node(module, function, value, body)
            ElseFallback(value, arm):
                try self.lower_prologue_node(module, function, value, body)
                try self.lower_prologue_node(module, function, arm, body)
            else: return

    func lower_prologue_run(module: HirModule, function: HirFunction, run: Operands, body: list[MirInstruction]) -> !:
        for position in range(0, i64(run.count)):
            try self.lower_prologue_node(module, function, node_at(self.program, run, position), body)

    # One slot for a binding introduced by a pattern; its type is the symbol's.
    func reserve_slot(module: HirModule, function: HirFunction, symbol: SymbolId, span: SourceSpan, body: list[MirInstruction]) -> !:
        let slot_type = try self.mir_type_of(module, function, span, self.program.symbols[symbol.value].value_type)
        let slot = len(self.slots)
        self.slots.append(MirSlot(value_type = slot_type))
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
        self.locals.append(Local(symbol = symbol.value, address = address))

    # Branch `index` of an `IfStatement`: the triple's condition and body run.
    func branch_condition(branches: Operands, index: i64) -> NodeId:
        return NodeId(value = u32(entry_at(self.program, branches, index * 3)))

    func branch_body(branches: Operands, index: i64) -> Operands:
        return Operands(start = u32(entry_at(self.program, branches, index * 3 + 1)), count = u32(entry_at(self.program, branches, index * 3 + 2)))

    # Append the instructions for one HIR statement. For example, `return 7`
    # emits a constant into a fresh register and returns that register.
    func lower_statement(module: HirModule, function: HirFunction, statement: NodeId, body: list[MirInstruction]) -> !:
        let span = node_span(self.program, statement)
        match node_form(self.program, statement):
            PrintText(value):
                try self.lower_print(value, span, body)
            PrintValue(value):
                try self.lower_print_value(module, function, value, span, body)
            ReturnStatement(value):
                if value.value == no_node:
                    try self.emit_deferred_from(module, function, 0, body)
                    if self.error_slot >= 0:
                        let no_error = self.null_constant(span, body)
                        body.append(MirInstruction(form = InstructionForm.Return(values = self.operands.run([no_error])), span = span))
                    else:
                        body.append(MirInstruction(form = InstructionForm.Return(values = no_registers()), span = span))
                    return
                let register = try self.lower_expression(module, function, value, body)
                let returned = list[RegisterId]()
                if self.result_slot >= 0:
                    # The caller owns the result's memory; fill it and return nothing.
                    let value_type = try self.mir_type_of(module, function, span, node_type(self.program, value))
                    body.append(MirInstruction(form = InstructionForm.Memcpy(destination = RegisterId(value = u32(self.result_slot)), source = register, value_type = value_type), span = span))
                else:
                    returned.append(register)
                try self.emit_deferred_from(module, function, 0, body)
                if self.error_slot >= 0: returned.append(self.null_constant(span, body))
                body.append(MirInstruction(form = InstructionForm.Return(values = self.operands.run(returned)), span = span))
            RecoverStatement(value):
                if len(self.recover_targets) == 0:
                    try self.fail_unsupported(module, function, span, "`recover` outside a catch handler")
                let target = self.recover_targets[len(self.recover_targets) - 1]
                let recovered = try self.lower_expression(module, function, value, body)
                try self.emit_deferred_from(module, function, target.defer_start, body)
                let values = list[RegisterId]()
                if recovered.value != no_register: values.append(recovered)
                let depth = len(self.regions) - 1 - target.region_index
                body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.operands.run(values)), span = span))
            DeferStatement(action):
                self.defers.append(action)
            Binding(symbol, is_mutable, value):
                let local = try self.local_of(module, function, span, symbol)
                let register = try self.lower_expression(module, function, value, body)
                let value_type = try self.mir_type_of(module, function, span, node_type(self.program, value))
                self.store_value(value_type, local.address, register, span, body)
            Assignment(symbol, operation, value):
                let address = try self.address_of(module, function, span, symbol)
                let value_type = try self.mir_type_of(module, function, span, node_type(self.program, value))
                try self.lower_store(module, function, span, value_type, address, operation, value, body)
            ExternStore(variable_index, operation, value):
                let global = self.lowered_external_globals[variable_index]
                let value_type = self.external_globals[global.value].value_type
                let right = try self.lower_expression(module, function, value, body)
                var stored = right
                match operation:
                    Replace: pass
                    Combine(binary):
                        let current = self.new_register(value_type)
                        body.append(MirInstruction(form = InstructionForm.LoadExternalGlobal(result = current, global = global), span = span))
                        stored = try self.lower_binary_operation(module, function, span, binary, value_type, current, right, body)
                body.append(MirInstruction(form = InstructionForm.StoreExternalGlobal(global = global, value = stored), span = span))
            GlobalStore(global_index, operation, value):
                let address = self.global_address(global_index, span, body)
                let value_type = self.globals[global_index].value_type
                try self.lower_store(module, function, span, value_type, address, operation, value, body)
            PlaceAssignment(symbol, steps, operation, value):
                # Walk the resolved HIR field/array path to its final address.
                var address = try self.address_of(module, function, span, symbol)
                var place_type = self.program.symbols[symbol.value].value_type
                for position in range(0, i64(steps.count) // 2):
                    let kind = u32(entry_at(self.program, steps, position * 2))
                    let payload = entry_at(self.program, steps, position * 2 + 1)
                    if kind == place_field_step:
                        let struct_type = try self.mir_type_of(module, function, span, place_type)
                        address = self.field_address(struct_type, address, payload, span, body)
                        place_type = self.hir_field_type(place_type, payload)
                    elif kind == place_element_step:
                        let index = try self.lower_expression(module, function, NodeId(value = u32(payload)), body)
                        var element_type = place_type
                        var count = -1
                        match self.program.types.definitions[place_type.value].form:
                            Array(element, array_count):
                                element_type = element
                                count = array_count
                            else: trap("element assignment step has a non-array HIR type")
                        let mir_element = try self.mir_type_of(module, function, span, element_type)
                        address = self.checked_element_address(mir_element, address, index, count, span, body)
                        place_type = element_type
                    elif kind == place_list_element_step:
                        let list_type = try self.mir_type_of(module, function, span, place_type)
                        let list_value = self.load_value(list_type, address, span, body)
                        let index = try self.lower_expression(module, function, NodeId(value = u32(payload)), body)
                        var element_type = resolve_builtin_type(BuiltinType.unit)
                        match self.program.types.definitions[place_type.value].form:
                            List(element): element_type = element
                            else: trap("list assignment step has a non-list HIR type")
                        address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = list_value, index = index), span = span))
                        place_type = element_type
                    else: trap("place assignment has an unknown step")
                let value_type = try self.mir_type_of(module, function, span, place_type)
                try self.lower_store(module, function, span, value_type, address, operation, value, body)
            ExpressionStatement(value):
                let discarded = try self.lower_expression(module, function, value, body)
            IfStatement(branches, has_fallback, fallback):
                try self.lower_if(module, function, span, branches, 0, has_fallback, fallback, body)
            WhileStatement(condition, loop_body):
                try self.lower_while(module, function, span, condition, loop_body, body)
            ForStatement(symbol, iterable, loop_body):
                try self.lower_for(module, function, span, symbol, iterable, loop_body, body)
            Match(subject, arms, has_result):
                let discarded = try self.lower_match(module, function, statement, subject, arms, false, body)
            BreakStatement:
                try self.emit_loop_deferred(module, function, span, body)
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.break_depth(module, function, span), values = no_registers()), span = span))
            ContinueStatement:
                try self.emit_loop_deferred(module, function, span, body)
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.continue_depth(module, function, span), values = no_registers()), span = span))
            else: try self.fail_unsupported(module, function, span, "an expression node where a statement was expected")

    # Store a value, or combine it with what the place holds, at an address.
    func lower_store(module: HirModule, function: HirFunction, span: SourceSpan, value_type: TypeId, address: RegisterId, operation: AssignmentOperation, value: NodeId, body: list[MirInstruction]) -> !:
        let register = try self.lower_expression(module, function, value, body)
        var stored = register
        match operation:
            Replace: stored = register
            Combine(binary):
                let current = self.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.Load(result = current, value_type = value_type, address = address), span = span))
                stored = try self.lower_binary_operation(module, function, span, binary, value_type, current, register, body)
        self.store_value(value_type, address, stored, span, body)

    # The address a mutable binding lives at: a local's slot, or — for `self`
    # in a mutating method — the pointer the caller passed.
    func address_of(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId) -> RegisterId!:
        for parameter in self.parameters:
            if parameter.symbol == symbol.value:
                if is_ptr_type(self.types, self.registers[parameter.address.value]): return parameter.address
                try self.fail_unsupported(module, function, span, "assignment to a scalar parameter")
        let local = try self.local_of(module, function, span, symbol)
        return local.address

    # The HIR type of field `field` of a struct-typed HIR value.
    func hir_field_type(value_type: ir.TypeId, field: i64) -> ir.TypeId:
        match self.program.types.definitions[value_type.value].form:
            Struct(index): return self.program.structs[index].fields[field].value_type
            Error:
                if field == 0: return resolve_builtin_type(BuiltinType.error_code)
                if field == 1: return resolve_builtin_type(BuiltinType.string)
                trap("field of Error is out of range")
            else: trap("field of a non-struct HIR type")

    # mark: Control flow =======================================================================
    #
    # Regions are emitted in place: an opener, the arm's instructions, `Else`
    # for a second arm, and `End`. The lowerer never builds a nested list.

    func open_if(condition: RegisterId, results: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.If(condition = condition, results = self.operands.run(results)), span = span))

    func emit_else(span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.Else, span = span))

    func emit_end(span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.End, span = span))

    func emit_yield(value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        body.append(MirInstruction(form = InstructionForm.Yield(values = self.operands.run([value])), span = span))

    # `if a: ... elif b: ... else: ...` nests: branch `index` is one `If`
    # whose else-arm holds the next branch, and the last else-arm is the
    # fallback. Each arm is its own region, so registers defined inside stay
    # inside; locals reach across through their slots.
    func lower_if(module: HirModule, function: HirFunction, span: SourceSpan, branches: Operands, index: i64, has_fallback: bool, fallback: Operands, body: list[MirInstruction]) -> !:
        let condition = try self.lower_expression(module, function, self.branch_condition(branches, index), body)
        self.open_if(condition, list[RegisterId](), span, body)
        try self.lower_region(module, function, Region.if_arm, self.branch_body(branches, index), body)
        if index + 1 < i64(branches.count) // 3:
            self.emit_else(span, body)
            self.regions.append(Region.if_arm)
            try self.lower_if(module, function, span, branches, index + 1, has_fallback, fallback, body)
            self.regions.remove(len(self.regions) - 1)
        elif has_fallback:
            self.emit_else(span, body)
            try self.lower_region(module, function, Region.if_arm, fallback, body)
        self.emit_end(span, body)

    # `while c: body` is a block around a loop. The loop re-tests `c` on
    # every pass and leaves the block when it fails; the body's last act is a
    # branch back to the loop. `break` is a branch to the block, `continue`
    # a branch to the loop; both count the regions in between.
    func lower_while(module: HirModule, function: HirFunction, span: SourceSpan, condition: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.regions.append(Region.block)
        self.regions.append(Region.loop_body)
        let tested = try self.lower_expression(module, function, condition, body)
        let failed = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        let condition_span = node_span(self.program, condition)
        body.append(MirInstruction(form = InstructionForm.Unary(result = failed, operation = UnaryOp.bool_not, operand = tested), span = condition_span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = failed, depth = 1, values = no_registers()), span = condition_span))
        try self.lower_loop_scope(module, function, statements, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.regions.remove(len(self.regions) - 1)
        self.regions.remove(len(self.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # A range loop uses its immutable iteration binding as the private
    # counter slot. The extra inner block is the `continue` target: leaving
    # it reaches the increment, while `break` crosses it, the loop, and lands
    # at the outer block. The endpoint test before increment keeps a closed
    # range ending at the integer maximum from overflowing.
    func lower_for(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId, iterable: NodeId, statements: Operands, body: list[MirInstruction]) -> !:
        let ranged = try self.lower_expression(module, function, iterable, body)
        let range_type = try self.mir_type_of(module, function, span, node_type(self.program, iterable))
        var element_hir_type = node_type(self.program, iterable)
        match self.program.types.definitions[element_hir_type.value].form:
            Range(element): element_hir_type = element
            else: try self.fail_unsupported(module, function, span, "a non-range `for` iterable")
        let element_type = try self.mir_type_of(module, function, span, element_hir_type)
        let lower = try self.load_field(range_type, ranged, 0, span, body)
        let upper = try self.load_field(range_type, ranged, 1, span, body)
        let inclusive = try self.load_field(range_type, ranged, 2, span, body)
        let counter = (try self.local_of(module, function, span, symbol)).address
        self.store_value(element_type, counter, lower, span, body)

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        self.regions.append(Region.block)
        self.regions.append(Region.loop_body)

        let current = self.load_value(element_type, counter, span, body)
        let above = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = above, operation = BinaryOp.gt, left = current, right = upper), span = span))
        let at_or_above = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = at_or_above, operation = BinaryOp.ge, left = current, right = upper), span = span))
        let done = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(inclusive, [done], span, body)
        self.emit_yield(above, span, body)
        self.emit_else(span, body)
        self.emit_yield(at_or_above, span, body)
        self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = no_registers()), span = span))

        body.append(MirInstruction(form = InstructionForm.Block(results = no_registers()), span = span))
        self.regions.append(Region.for_continue)
        try self.lower_loop_scope(module, function, statements, body)
        self.regions.remove(len(self.regions) - 1)
        self.emit_end(span, body)

        let is_upper = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_upper, operation = BinaryOp.eq, left = current, right = upper), span = span))
        let is_last = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(inclusive, [is_last], span, body)
        self.emit_yield(is_upper, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.emit_end(span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = is_last, depth = 1, values = no_registers()), span = span))

        let one = self.new_register(element_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.Int(value = 1)), span = span))
        let next = self.new_register(element_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = current, right = one), span = span))
        self.store_value(element_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))

        self.regions.remove(len(self.regions) - 1)
        self.regions.remove(len(self.regions) - 1)
        self.emit_end(span, body)
        self.emit_end(span, body)

    # Lower statements inside one new region.
    func lower_region(module: HirModule, function: HirFunction, region: Region, statements: Operands, body: list[MirInstruction]) -> !:
        self.regions.append(region)
        try self.lower_scope(module, function, statements, body)
        self.regions.remove(len(self.regions) - 1)

    # Lower one lexical suite and duplicate its registered cleanup calls on
    # the normal fallthrough path. Explicit exits emit the same active suffix
    # before their branch or return.
    func lower_scope(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        let start = len(self.defers)
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.program, statements, position), body)
        try self.emit_deferred_from(module, function, start, body)
        while len(self.defers) > start: self.defers.remove(len(self.defers) - 1)

    # A loop body is a lexical scope and the boundary for both `break` and
    # `continue`; nested suites add actions above this starting index.
    func lower_loop_scope(module: HirModule, function: HirFunction, statements: Operands, body: list[MirInstruction]) -> !:
        self.loop_defer_starts.append(len(self.defers))
        try self.lower_scope(module, function, statements, body)
        self.loop_defer_starts.remove(len(self.loop_defer_starts) - 1)

    # Emit actions in reverse registration order without removing the
    # compile-time list: another control-flow path may need the same copies.
    func emit_deferred_from(module: HirModule, function: HirFunction, start: i64, body: list[MirInstruction]) -> !:
        var index = len(self.defers) - 1
        while index >= start:
            try self.lower_statement(module, function, self.defers[index], body)
            index -= 1

    func emit_loop_deferred(module: HirModule, function: HirFunction, span: SourceSpan, body: list[MirInstruction]) -> !:
        if len(self.loop_defer_starts) == 0:
            try self.fail_unsupported(module, function, span, "`break`/`continue` outside a loop")
        try self.emit_deferred_from(module, function, self.loop_defer_starts[len(self.loop_defer_starts) - 1], body)

    # `continue` targets a range loop's increment block or a while loop's
    # loop label, whichever belongs to the innermost source loop.
    func continue_depth(module: HirModule, function: HirFunction, span: SourceSpan) -> i64!:
        var depth = 0
        var index = len(self.regions) - 1
        while index >= 0:
            if self.regions[index] == Region.for_continue: return depth
            if self.regions[index] == Region.loop_body: return depth
            depth += 1
            index -= 1
        error(self.unsupported(module, function, span, "`break`/`continue` outside a loop"))

    # `break` crosses the loop itself and reaches its surrounding block. A
    # range loop's continue block is counted naturally on the walk.
    func break_depth(module: HirModule, function: HirFunction, span: SourceSpan) -> i64!:
        var depth = 0
        var index = len(self.regions) - 1
        while index >= 0:
            if self.regions[index] == Region.loop_body: return depth + 1
            depth += 1
            index -= 1
        error(self.unsupported(module, function, span, "`break`/`continue` outside a loop"))

    # Constant terminal output is a data item holding the bytes plus a
    # newline, then `luce_rt_write(address, length)`.
    func lower_print(text: str, span: SourceSpan, body: list[MirInstruction]) -> !:
        let payload = strings.to_bytes(text + "\n")
        let data_id = DataId(value = u32(len(self.data)))
        self.data.append(MirData(
            name = "text" + str(data_id.value),
            bytes = payload,
            align = 1,
        ))
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = address, data = data_id), span = span))
        let length = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.Int(value = len(payload))), span = span))
        let write = try self.runtime_extern("luce_rt_write")
        body.append(MirInstruction(
            form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.operands.run([address, length])),
            span = span,
        ))

    # `print(value)` for a `str` value: write its bytes, then a newline.
    func lower_print_value(module: HirModule, function: HirFunction, value: NodeId, span: SourceSpan, body: list[MirInstruction]) -> !:
        let text = try self.lower_expression(module, function, value, body)
        let text_type = try self.mir_type_of(module, function, span, node_type(self.program, value))
        let pointer = try self.load_field(text_type, text, 0, span, body)
        let length = try self.load_field(text_type, text, 1, span, body)
        let write = try self.runtime_extern("luce_rt_write")
        body.append(MirInstruction(form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.operands.run([pointer, length])), span = span))
        if self.newline_data < 0: self.newline_data = self.add_data("newline", strings.to_bytes("\n"))
        let newline = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = newline, data = DataId(value = u32(self.newline_data))), span = span))
        let one = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.Int(value = 1)), span = span))
        body.append(MirInstruction(form = InstructionForm.CallExtern(results = no_registers(), external = write, arguments = self.operands.run([newline, one])), span = span))

    func add_data(prefix: str, payload: list[u8]) -> i64:
        self.data.append(MirData(name = prefix + str(len(self.data)), bytes = payload, align = 1))
        return len(self.data) - 1

    # mark: Expressions =========================================================================

    # Lower one expression and return the register holding its value.
    # Operands are lowered left to right, so `2 + 3` defines the register for
    # 2, then 3, then their sum.
    func lower_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!:
        # A call may produce `unit`, which has no machine type; every other
        # expression form has a scalar type or is refused below.
        match node_form(self.program, expression):
            Call(callee, arguments):
                if self.fallible_inner(node_type(self.program, expression)) != none:
                    try self.fail_unsupported(module, function, node_span(self.program, expression), "an unhandled fallible call")
                return try self.lower_call(module, function, expression, callee, arguments, body)
            IndirectCall(callee, arguments):
                if self.fallible_inner(node_type(self.program, expression)) != none:
                    try self.fail_unsupported(module, function, node_span(self.program, expression), "an unhandled fallible function-value call")
                return try self.lower_indirect_call(module, function, expression, callee, arguments, body)
            Initialize(callee, arguments):
                if self.fallible_inner(node_type(self.program, expression)) != none:
                    try self.fail_unsupported(module, function, node_span(self.program, expression), "an unhandled fallible initializer")
                return try self.lower_initializer(module, function, expression, callee, arguments, body)
            NativeStore(pointer, stored):
                let span = node_span(self.program, expression)
                let address = try self.lower_expression(module, function, pointer, body)
                let value = try self.lower_expression(module, function, stored, body)
                let stored_type = try self.mir_type_of(module, function, node_span(self.program, stored), node_type(self.program, stored))
                self.store_value(stored_type, address, value, span, body)
                return RegisterId(value = no_register)
            NativeMove(destination, source, count):
                let span = node_span(self.program, expression)
                let to = try self.lower_expression(module, function, destination, body)
                let from = try self.lower_expression(module, function, source, body)
                let element_count = try self.lower_expression(module, function, count, body)
                var pointee = resolve_builtin_type(BuiltinType.unit)
                match self.program.types.definitions[node_type(self.program, destination).value].form:
                    NativePointer(element, is_mutable): pointee = element
                    else: trap("typed native move has a non-pointer destination")
                let element_type = try self.mir_type_of(module, function, span, pointee)
                body.append(MirInstruction(form = InstructionForm.MoveElements(destination = to, source = from, element_type = element_type, count = element_count), span = span))
                return RegisterId(value = no_register)
            ListCopy(value): return try self.lower_list_copy(module, function, expression, value, body)
            ListAppend(value, element): return try self.lower_list_append(module, function, expression, value, element, body)
            ListInsert(value, index, element): return try self.lower_list_insert(module, function, expression, value, index, element, body)
            ListRemoveAt(value, index): return try self.lower_list_remove_at(module, function, expression, value, index, body)
            ListClear(value): return try self.lower_list_clear(module, function, expression, value, body)
            ListReserve(value, minimum_capacity): return try self.lower_list_reserve(module, function, expression, value, minimum_capacity, body)
            Raise(code, message): return try self.lower_raise(module, function, expression, code, message, body)
            Try(value): return try self.lower_try(module, function, expression, value, body)
            Catch(value, failure, catch_body): return try self.lower_catch(module, function, expression, value, failure, catch_body, body)
            else: return try self.lower_typed_expression(module, function, expression, body)

    func lower_list_copy(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let source = try self.lower_expression(module, function, value, body)
        let result_type = try self.mir_type_of(module, function, node_span(self.program, expression), node_type(self.program, expression))
        let result = self.new_register(result_type)
        body.append(MirInstruction(form = InstructionForm.ListCopy(result = result, value = source), span = node_span(self.program, expression)))
        return result

    func lower_list_append(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, element: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let list_value = try self.lower_expression(module, function, value, body)
        let stored = try self.lower_expression(module, function, element, body)
        let element_type = try self.mir_type_of(module, function, span, node_type(self.program, element))
        let slot = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListAppendSlot(result = slot, value = list_value), span = span))
        self.store_value(element_type, slot, stored, span, body)
        return RegisterId(value = no_register)

    func lower_list_insert(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, index: NodeId, element: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        # Evaluate every source operand before changing the list's shape.
        let list_value = try self.lower_expression(module, function, value, body)
        let position = try self.lower_expression(module, function, index, body)
        let stored = try self.lower_expression(module, function, element, body)
        let element_type = try self.mir_type_of(module, function, span, node_type(self.program, element))
        let slot = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListInsertSlot(result = slot, value = list_value, index = position), span = span))
        self.store_value(element_type, slot, stored, span, body)
        return RegisterId(value = no_register)

    func lower_list_remove_at(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, index: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let list_value = try self.lower_expression(module, function, value, body)
        let position = try self.lower_expression(module, function, index, body)
        let element_type = try self.mir_type_of(module, function, span, node_type(self.program, expression))
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = list_value, index = position), span = span))
        var removed = self.load_value(element_type, address, span, body)
        # Aggregate values are addresses under the MIR protocol. Preserve the
        # removed value in independent caller-owned storage before shifting.
        if self.is_aggregate(element_type):
            let copy = self.new_temp(element_type, span, body)
            body.append(MirInstruction(form = InstructionForm.Memcpy(destination = copy, source = address, value_type = element_type), span = span))
            removed = copy
        body.append(MirInstruction(form = InstructionForm.ListRemoveAt(value = list_value, index = position), span = span))
        return removed

    func lower_list_clear(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let list_value = try self.lower_expression(module, function, value, body)
        body.append(MirInstruction(form = InstructionForm.ListClear(value = list_value), span = node_span(self.program, expression)))
        return RegisterId(value = no_register)

    func lower_list_reserve(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, minimum_capacity: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let list_value = try self.lower_expression(module, function, value, body)
        let minimum = try self.lower_expression(module, function, minimum_capacity, body)
        body.append(MirInstruction(form = InstructionForm.ListReserve(value = list_value, minimum_capacity = minimum), span = node_span(self.program, expression)))
        return RegisterId(value = no_register)

    # Fill this function's caller-owned Error and leave through `Raise r0`.
    # The code and message are ordinary aggregate values copied fieldwise.
    func lower_raise(module: HirModule, function: HirFunction, expression: NodeId, code: NodeId, message: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        if self.error_slot < 0: try self.fail_unsupported(module, function, span, "`error` in a non-fallible function")
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let code_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_code))
        let message_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
        let destination = RegisterId(value = u32(self.error_slot))
        let code_value = try self.lower_expression(module, function, code, body)
        self.store_value(code_type, self.field_address(error_type, destination, 0, span, body), code_value, span, body)
        let message_value = try self.lower_expression(module, function, message, body)
        self.store_value(message_type, self.field_address(error_type, destination, 1, span, body), message_value, span, body)
        try self.emit_deferred_from(module, function, 0, body)
        body.append(MirInstruction(form = InstructionForm.Raise(failure = destination), span = span))
        return RegisterId(value = no_register)

    # Propagation is a null test followed by one explicit failure arm. Copying
    # into r0 transfers ownership to our caller before local slots disappear.
    func lower_try(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        if self.error_slot < 0: try self.fail_unsupported(module, function, span, "`try` in a non-fallible function")
        let attempted = try self.lower_fallible_expression(module, function, value, body)
        let failed = self.error_is_present(attempted.error_value, span, body)
        self.open_if(failed, list[RegisterId](), span, body)
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        body.append(MirInstruction(form = InstructionForm.Memcpy(destination = RegisterId(value = u32(self.error_slot)), source = attempted.error_value, value_type = error_type), span = span))
        try self.emit_deferred_from(module, function, 0, body)
        body.append(MirInstruction(form = InstructionForm.Raise(failure = RegisterId(value = u32(self.error_slot))), span = span))
        self.emit_end(span, body)
        return attempted.value

    # Recovery is the same data test with a value-producing If. The failure
    # arm binds Error in its reserved slot; recover branches out of the If,
    # while success yields the call's value directly.
    func lower_catch(module: HirModule, function: HirFunction, expression: NodeId, value: NodeId, failure: SymbolId, catch_body: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let attempted = try self.lower_fallible_expression(module, function, value, body)
        var result = RegisterId(value = no_register)
        let results = list[RegisterId]()
        if not types_match(node_type(self.program, expression), resolve_builtin_type(BuiltinType.unit)):
            let success_type = try self.mir_type_of(module, function, span, node_type(self.program, expression))
            result = self.new_register(self.register_type_for(success_type))
            results.append(result)
        let failed = self.error_is_present(attempted.error_value, span, body)
        self.open_if(failed, results, span, body)
        self.regions.append(Region.if_arm)
        let local = try self.local_of(module, function, span, failure)
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        self.store_value(error_type, local.address, attempted.error_value, span, body)
        let defer_start = len(self.defers)
        self.recover_targets.append(RecoverTarget(region_index = len(self.regions) - 1, defer_start = defer_start))
        try self.lower_scope(module, function, catch_body, body)
        # HirGenerator proved every handler path transfers. `lower_scope`
        # still emits the normal-fallthrough copies of deferred actions after
        # those branches; this marker preserves that proof for the region
        # verifier without making the unreachable copies observable.
        body.append(MirInstruction(form = InstructionForm.Unreachable, span = span))
        self.recover_targets.remove(len(self.recover_targets) - 1)
        self.regions.remove(len(self.regions) - 1)
        self.emit_else(span, body)
        if attempted.value.value != no_register: self.emit_yield(attempted.value, span, body)
        self.emit_end(span, body)
        return result

    func error_is_present(error_value: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let no_error = self.null_constant(span, body)
        let failed = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = failed, operation = BinaryOp.ne, left = error_value, right = no_error), span = span))
        return failed

    func lower_typed_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let value_type = try self.mir_type_of(module, function, span, node_type(self.program, expression))
        match node_form(self.program, expression):
            ErrorCodeLiteral(value):
                let temp = self.new_temp(value_type, span, body)
                let domain_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.string))
                let domain = try self.lower_byte_constant(domain_type, strings.to_bytes(self.program.package_identity), span, body)
                self.store_value(domain_type, self.field_address(value_type, temp, 0, span, body), domain, span, body)
                let code_type = builtin_mir_type(BuiltinMirType.unsigned_u32)
                let code = self.new_register(code_type)
                body.append(MirInstruction(form = InstructionForm.Const(result = code, value = MirConstant.Int(value = i64(value))), span = span))
                self.store_value(code_type, self.field_address(value_type, temp, 1, span, body), code, span, body)
                return temp
            Constant(index):
                var constant = MirConstant.Null
                match self.program.values[index]:
                    Integer(item): constant = MirConstant.Int(value = item)
                    Floating(item): constant = MirConstant.Float(value = item)
                    Boolean(item): constant = MirConstant.Bool(value = item)
                    Character(item): constant = MirConstant.Int(value = i64(u32(item)))
                    Text(item): return try self.lower_byte_constant(value_type, strings.to_bytes(item), span, body)
                    Bytes(item): return try self.lower_byte_constant(value_type, item, span, body)
                    else: try self.fail_unsupported(module, function, span, "constant `" + str(self.program.values[index]) + "`")
                let register = self.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.Const(result = register, value = constant), span = span))
                return register
            Reference(symbol):
                for parameter in self.parameters:
                    if parameter.symbol == symbol.value: return parameter.address
                let constant = self.constant_of(symbol)
                if constant != none:
                    return try self.lower_expression(module, function, constant.value, body)
                let local = try self.local_of(module, function, span, symbol)
                return self.load_value(value_type, local.address, span, body)
            FunctionAddress(target):
                let source_index = self.function_index_of(target)
                if source_index < 0: trap("function address names an unknown HIR symbol")
                # The temporary entry lowering drops its not-yet-representable
                # `slice[str]` parameter. Refuse its address rather than emit
                # an indirect signature that disagrees with the definition.
                if self.is_process_entry(self.program.functions[source_index]):
                    try self.fail_unsupported(module, function, span, "process-entry function values")
                let result = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                match self.program.types.definitions[node_type(self.program, expression).value].form:
                    CFunction(parameters, function_result):
                        match self.lowered_functions[source_index]:
                            External(external): body.append(MirInstruction(form = InstructionForm.ExternAddress(result = result, external = external), span = span))
                            Defined(function_id):
                                match self.c_wrappers[source_index]:
                                    Present(wrapper): body.append(MirInstruction(form = InstructionForm.FunctionAddress(result = result, function = wrapper), span = span))
                                    Absent: trap("cfunc conversion has no predeclared C wrapper")
                    else:
                        var lowered = FunctionId(value = 0)
                        match self.lowered_functions[source_index]:
                            Defined(function_id): lowered = function_id
                            External(external): trap("Luce function address names a C extern")
                        body.append(MirInstruction(form = InstructionForm.FunctionAddress(result = result, function = lowered), span = span))
                return result
            ExternLoad(variable_index):
                let global = self.lowered_external_globals[variable_index]
                let result = self.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.LoadExternalGlobal(result = result, global = global), span = span))
                return result
            GlobalLoad(global_index):
                let address = self.global_address(global_index, span, body)
                return self.load_value(value_type, address, span, body)
            NativeLoad(pointer):
                let address = try self.lower_expression(module, function, pointer, body)
                return self.load_value(value_type, address, span, body)
            NativeAdvance(pointer, count):
                let address = try self.lower_expression(module, function, pointer, body)
                let offset = try self.lower_expression(module, function, count, body)
                var pointee = resolve_builtin_type(BuiltinType.unit)
                match self.program.types.definitions[node_type(self.program, pointer).value].form:
                    NativePointer(element, is_mutable): pointee = element
                    else: trap("typed native advance has a non-pointer operand")
                let element_type = try self.mir_type_of(module, function, span, pointee)
                return self.element_address(element_type, address, offset, span, body)
            NativeRebind(pointer): return try self.lower_expression(module, function, pointer, body)
            NativeAllocate(element_type, count):
                let element_count = try self.lower_expression(module, function, count, body)
                let stored_type = try self.mir_type_of(module, function, span, element_type)
                let result = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.AllocateStorage(result = result, element_type = stored_type, count = element_count), span = span))
                return result
            NativeArena(end):
                let requested_end = try self.lower_expression(module, function, end, body)
                let provider = try self.runtime_extern("luce_rt_arena")
                let result = self.new_register(value_type)
                let arguments = self.operands.run([requested_end])
                let results = self.operands.run([result])
                body.append(MirInstruction(form = InstructionForm.CallExtern(results = results, external = provider, arguments = arguments), span = span))
                return result
            SequenceLength(value):
                let hir_sequence_type = node_type(self.program, value)
                # A fixed array's length is static, but its receiver remains
                # an ordinary expression whose effects happen first.
                let sequence = try self.lower_expression(module, function, value, body)
                match self.program.types.definitions[hir_sequence_type.value].form:
                    Array(element, count):
                        let length = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.Int(value = count)), span = span))
                        return length
                    List(element):
                        let length = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
                        body.append(MirInstruction(form = InstructionForm.ListLength(result = length, value = sequence), span = span))
                        return length
                    else:
                        let sequence_type = try self.mir_type_of(module, function, span, hir_sequence_type)
                        return try self.load_field(sequence_type, sequence, 1, span, body)
            SequenceIndex(value, index):
                return try self.lower_sequence_index(module, function, span, value, index, body)
            Tuple(elements):
                # Fill a fresh slot field by field; the slot's address is the value.
                let temp = self.new_temp(value_type, span, body)
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.program, elements, index)
                    let element = try self.lower_expression(module, function, element_node, body)
                    let element_type = try self.mir_type_of(module, function, node_span(self.program, element_node), node_type(self.program, element_node))
                    let field = self.field_address(value_type, temp, index, span, body)
                    self.store_value(element_type, field, element, span, body)
                return temp
            Array(elements):
                let temp = self.new_temp(value_type, span, body)
                var element_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
                match mir_type(self.types, value_type):
                    Array(item, count): element_type = item
                    else: trap("array HIR node has a non-array MIR type")
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.program, elements, index)
                    let element = try self.lower_expression(module, function, element_node, body)
                    let position = self.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), index, span, body)
                    let address = self.element_address(element_type, temp, position, span, body)
                    self.store_value(element_type, address, element, span, body)
                return temp
            List(elements):
                var hir_element = resolve_builtin_type(BuiltinType.unit)
                match self.program.types.definitions[node_type(self.program, expression).value].form:
                    List(element): hir_element = element
                    else: trap("list HIR node has a non-list type")
                let element_type = try self.mir_type_of(module, function, span, hir_element)
                let result = self.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.ListCreate(result = result), span = span))
                for index in range(0, i64(elements.count)):
                    let element_node = node_at(self.program, elements, index)
                    let element = try self.lower_expression(module, function, element_node, body)
                    let slot = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                    body.append(MirInstruction(form = InstructionForm.ListAppendSlot(result = slot, value = result), span = node_span(self.program, element_node)))
                    self.store_value(element_type, slot, element, node_span(self.program, element_node), body)
                return result
            Range(lower, upper, inclusive):
                let temp = self.new_temp(value_type, span, body)
                let lower_value = try self.lower_expression(module, function, lower, body)
                let element_type = try self.mir_type_of(module, function, node_span(self.program, lower), node_type(self.program, lower))
                self.store_value(element_type, self.field_address(value_type, temp, 0, span, body), lower_value, span, body)
                let upper_value = try self.lower_expression(module, function, upper, body)
                self.store_value(element_type, self.field_address(value_type, temp, 1, span, body), upper_value, span, body)
                let boundary = self.bool_constant(inclusive, span, body)
                self.store_value(builtin_mir_type(BuiltinMirType.boolean), self.field_address(value_type, temp, 2, span, body), boundary, span, body)
                return temp
            Element(tuple_value, index):
                let base = try self.lower_expression(module, function, tuple_value, body)
                let tuple_type = try self.mir_type_of(module, function, node_span(self.program, tuple_value), node_type(self.program, tuple_value))
                let field = self.field_address(tuple_type, base, index, span, body)
                return self.load_value(value_type, field, span, body)
            StructValue(struct_index, fields):
                let temp = self.new_temp(value_type, span, body)
                for index in range(0, i64(fields.count)):
                    let field_node = node_at(self.program, fields, index)
                    let element = try self.lower_expression(module, function, field_node, body)
                    let element_type = try self.mir_type_of(module, function, node_span(self.program, field_node), node_type(self.program, field_node))
                    let field = self.field_address(value_type, temp, index, span, body)
                    self.store_value(element_type, field, element, span, body)
                return temp
            FieldAccess(record, field_index):
                let base = try self.lower_expression(module, function, record, body)
                let struct_type = try self.mir_type_of(module, function, node_span(self.program, record), node_type(self.program, record))
                let field = self.field_address(struct_type, base, field_index, span, body)
                return self.load_value(value_type, field, span, body)
            NoneLiteral:
                let temp = self.new_temp(value_type, span, body)
                self.store_tag(temp, 0, span, body)
                return temp
            Some(inner):
                let temp = self.new_temp(value_type, span, body)
                self.store_tag(temp, 1, span, body)
                let payload = try self.lower_expression(module, function, inner, body)
                let payload_type = try self.mir_type_of(module, function, node_span(self.program, inner), node_type(self.program, inner))
                let payload_address = self.payload_address(value_type, temp, span, body)
                self.store_value(payload_type, payload_address, payload, span, body)
                return temp
            EnumValue(enum_index, case_index, payload):
                # Tag first, then the case's payload struct after it.
                let temp = self.new_temp(value_type, span, body)
                self.store_tag(temp, case_index, span, body)
                if payload.count > 0:
                    let case_type = self.case_struct_type(value_type, case_index)
                    let payload_base = self.payload_address(value_type, temp, span, body)
                    for index in range(0, i64(payload.count)):
                        let field_node = node_at(self.program, payload, index)
                        let element = try self.lower_expression(module, function, field_node, body)
                        let element_type = try self.mir_type_of(module, function, node_span(self.program, field_node), node_type(self.program, field_node))
                        let field = self.field_address(case_type, payload_base, index, span, body)
                        self.store_value(element_type, field, element, span, body)
                return temp
            Match(subject, arms, has_result):
                return try self.lower_match(module, function, expression, subject, arms, true, body)
            ElseFallback(optional_value, arm):
                # `If(tag == 1)`: the present arm yields the payload, the
                # absent arm evaluates and yields the fallback.
                let optional = try self.lower_expression(module, function, optional_value, body)
                let optional_type = try self.mir_type_of(module, function, node_span(self.program, optional_value), node_type(self.program, optional_value))
                let present = self.load_present(optional, span, body)
                let result = self.new_register(self.register_type_for(value_type))
                self.open_if(present, [result], span, body)
                let payload_address = self.payload_address(optional_type, optional, span, body)
                let payload = self.load_value(value_type, payload_address, span, body)
                self.emit_yield(payload, span, body)
                self.emit_else(span, body)
                let fallback = try self.lower_expression(module, function, arm, body)
                self.emit_yield(fallback, span, body)
                self.emit_end(span, body)
                return result
            Unary(operation, operand):
                let operand_register = try self.lower_expression(module, function, operand, body)
                let register = self.new_register(value_type)
                match operation:
                    LogicalNot:
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bool_not, operand = operand_register), span = span))
                    NumericNegate(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.neg, operand = operand_register), span = span))
                    IntegerBitwiseNot(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bit_not, operand = operand_register), span = span))
                    NumericIdentity(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Copy(result = register, source = operand_register), span = span))
                return register
            Binary(left, operation, right):
                match operation:
                    LogicalAnd: return try self.lower_short_circuit(module, function, expression, left, right, true, body)
                    LogicalOr: return try self.lower_short_circuit(module, function, expression, left, right, false, body)
                    else:
                        let left_register = try self.lower_expression(module, function, left, body)
                        let right_register = try self.lower_expression(module, function, right, body)
                        let left_type = node_type(self.program, left)
                        let operand_type = try self.mir_type_of(module, function, node_span(self.program, left), left_type)
                        if self.is_aggregate(operand_type):
                            return try self.lower_aggregate_comparison(module, function, span, operation, left_type, left_register, right_register, body)
                        return try self.lower_binary_operation(module, function, span, operation, operand_type, left_register, right_register, body)
            Conditional(value, condition, alternative):
                let condition_register = try self.lower_expression(module, function, condition, body)
                let result = self.new_register(self.register_type_for(value_type))
                self.open_if(condition_register, [result], span, body)
                let chosen = try self.lower_expression(module, function, value, body)
                self.emit_yield(chosen, span, body)
                self.emit_else(span, body)
                let fallback = try self.lower_expression(module, function, alternative, body)
                self.emit_yield(fallback, span, body)
                self.emit_end(span, body)
                return result
            else:
                error(self.unsupported(module, function, span, "expression `" + str(node_form(self.program, expression)) + "`"))

    # A fallible expression yields its success register (absent for unit) and
    # reported error pointer together. Calls are the primitive producer;
    # conditional expressions join both components through region results.
    func lower_fallible_expression(module: HirModule, function: HirFunction, expression: NodeId, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.program, expression)
        match node_form(self.program, expression):
            Call(callee, arguments): return try self.lower_fallible_call(module, function, expression, callee, arguments, body)
            IndirectCall(callee, arguments): return try self.lower_fallible_indirect_call(module, function, expression, callee, arguments, body)
            Initialize(callee, arguments): return try self.lower_fallible_initializer(module, function, expression, callee, arguments, body)
            Match(subject, arms, has_result): return try self.lower_fallible_match(module, function, expression, subject, arms, body)
            Conditional(value, condition, alternative):
                let successful = self.fallible_inner(node_type(self.program, expression)) else error(self.unsupported(module, function, span, "a non-fallible expression in fallible lowering"))
                let condition_value = try self.lower_expression(module, function, condition, body)
                var result_value = RegisterId(value = no_register)
                let results = list[RegisterId]()
                if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
                    let value_type = try self.mir_type_of(module, function, span, successful)
                    result_value = self.new_register(self.register_type_for(value_type))
                    results.append(result_value)
                let result_error = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                results.append(result_error)
                self.open_if(condition_value, results, span, body)
                let chosen = try self.lower_fallible_expression(module, function, value, body)
                self.emit_fallible_yield(chosen, span, body)
                self.emit_else(span, body)
                let fallback = try self.lower_fallible_expression(module, function, alternative, body)
                self.emit_fallible_yield(fallback, span, body)
                self.emit_end(span, body)
                return FallibleResult(value = result_value, error_value = result_error)
            else: error(self.unsupported(module, function, span, "fallible expression `" + str(node_form(self.program, expression)) + "`"))

    # A fallible match joins both halves of the effect at one block: the
    # successful value (when non-unit) and the reported Error pointer. Pattern
    # testing and bindings mirror ordinary match lowering, while arm exits use
    # `lower_fallible_expression` so no T! value ever becomes a MIR register.
    func lower_fallible_match(module: HirModule, function: HirFunction, node: NodeId, subject: NodeId, arms: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.program, node)
        let successful = self.fallible_inner(node_type(self.program, node)) else error(self.unsupported(module, function, span, "a non-fallible match in fallible lowering"))
        let subject_type = node_type(self.program, subject)
        let selected = try self.lower_expression(module, function, subject, body)
        var result_value = RegisterId(value = no_register)
        let result_error = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        let results = list[RegisterId]()
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
            let value_type = try self.mir_type_of(module, function, span, successful)
            result_value = self.new_register(self.register_type_for(value_type))
            results.append(result_value)
        results.append(result_error)
        let block_depth = len(self.regions)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.operands.run(results)), span = span))
        self.regions.append(Region.block)

        try self.lower_match_arms(module, function, selected, subject_type, arms, MatchExit.Fallible(block_depth = block_depth), span, body)
        self.regions.remove(len(self.regions) - 1)
        self.emit_end(span, body)
        return FallibleResult(value = result_value, error_value = result_error)

    func lower_fallible_arm_body(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, block_depth: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        let defer_start = len(self.defers)
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.program, statements, position), body)
        let result = try self.lower_fallible_expression(module, function, value, body)
        try self.emit_deferred_from(module, function, defer_start, body)
        while len(self.defers) > defer_start: self.defers.remove(len(self.defers) - 1)
        let values = list[RegisterId]()
        if result.value.value != no_register: values.append(result.value)
        values.append(result.error_value)
        let depth = len(self.regions) - 1 - block_depth
        body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.operands.run(values)), span = span))

    func emit_fallible_yield(result: FallibleResult, span: SourceSpan, body: list[MirInstruction]):
        let values = list[RegisterId]()
        if result.value.value != no_register: values.append(result.value)
        values.append(result.error_value)
        body.append(MirInstruction(form = InstructionForm.Yield(values = self.operands.run(values)), span = span))

    # Source arguments are evaluated in source order and then placed by the
    # parameter indices HIR resolved for named arguments.
    func lower_placed_arguments(module: HirModule, function: HirFunction, called: HirFunction, arguments: Operands, body: list[MirInstruction]) -> list[RegisterId]!:
        let placed = list[RegisterId]()
        for parameter in called.parameters: placed.append(RegisterId(value = no_register))
        for pair in range(0, i64(arguments.count) // 2):
            let parameter_index = entry_at(self.program, arguments, pair * 2)
            let argument = NodeId(value = u32(entry_at(self.program, arguments, pair * 2 + 1)))
            placed[parameter_index] = try self.lower_expression(module, function, argument, body)
        return placed

    # Canonical calling shape for either callable type. Luce values reuse the
    # direct-call hidden result/error protocol; cfunc values use the closed raw
    # C boundary shape and are necessarily infallible.
    func lower_function_value_signature(module: HirModule, function: HirFunction, span: SourceSpan, function_type: ir.TypeId) -> MirSignature!:
        let source_parameters = list[ir.TypeId]()
        var source_result = resolve_builtin_type(BuiltinType.unit)
        match self.program.types.definitions[function_type.value].form:
            Function(parameters, result):
                for parameter in parameters: source_parameters.append(parameter)
                source_result = result
            CFunction(parameters, result):
                let c_parameters = list[TypeId]()
                for parameter in parameters:
                    c_parameters.append(try self.c_boundary_type_of(module, function, span, parameter))
                let c_results = list[TypeId]()
                if not types_match(result, resolve_builtin_type(BuiltinType.unit)):
                    c_results.append(try self.c_boundary_type_of(module, function, span, result))
                return MirSignature(parameters = c_parameters, results = c_results, is_fallible = false)
            else: trap("indirect call has a non-function HIR type")
        let parameters = list[TypeId]()
        let results = list[TypeId]()
        let fallible = self.fallible_inner(source_result)
        var successful = source_result
        if fallible != none:
            successful = fallible
            parameters.append(builtin_mir_type(BuiltinMirType.pointer))
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
            let result_type = try self.mir_type_of(module, function, span, successful)
            if self.is_aggregate(result_type): parameters.append(builtin_mir_type(BuiltinMirType.pointer))
            else: results.append(result_type)
        if fallible != none: results.append(builtin_mir_type(BuiltinMirType.pointer))
        for parameter in source_parameters:
            let value_type = try self.mir_type_of(module, function, span, parameter)
            parameters.append(self.register_type_for(value_type))
        return MirSignature(parameters = parameters, results = results, is_fallible = fallible != none)

    func function_value_convention(function_type: ir.TypeId) -> CallingConvention:
        match self.program.types.definitions[function_type.value].form:
            CFunction(parameters, result): return CallingConvention.c
            Function(parameters, result): return CallingConvention.luce
            else: trap("indirect call has a non-function HIR type")

    # Callee expression first, then positional arguments left to right.
    func lower_indirect_operands(module: HirModule, function: HirFunction, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> IndirectOperands!:
        let target = try self.lower_expression(module, function, callee, body)
        let values = list[RegisterId]()
        for position in range(0, i64(arguments.count)):
            values.append(try self.lower_expression(module, function, node_at(self.program, arguments, position), body))
        return IndirectOperands(target = target, values = values)

    func lower_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let operands = try self.lower_indirect_operands(module, function, callee, arguments, body)
        let callee_type = node_type(self.program, callee)
        let signature = try self.lower_function_value_signature(module, function, span, callee_type)
        if signature.is_fallible: trap("fallible indirect call entered infallible lowering")
        if self.function_value_convention(callee_type) == CallingConvention.c:
            return try self.lower_c_indirect_call(module, function, expression, callee_type, operands, signature, body)
        let call_arguments = list[RegisterId]()
        let results = list[RegisterId]()
        let source_result = node_type(self.program, expression)
        var value = RegisterId(value = no_register)
        if not types_match(source_result, resolve_builtin_type(BuiltinType.unit)):
            let result_type = try self.mir_type_of(module, function, span, source_result)
            if self.is_aggregate(result_type):
                value = self.new_temp(result_type, span, body)
                call_arguments.append(value)
            else:
                value = self.new_register(result_type)
                results.append(value)
        for argument in operands.values: call_arguments.append(argument)
        body.append(MirInstruction(form = InstructionForm.CallIndirect(results = self.operands.run(results), signature = signature, convention = CallingConvention.luce, target = operands.target, arguments = self.operands.run(call_arguments)), span = span))
        return value

    # A cfunc call uses the same evaluated callee/argument list as an ordinary
    # indirect call, but each nullable pointer-shaped slot is translated at
    # this one C boundary. ABI placement is still a backend responsibility.
    func lower_c_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee_type: ir.TypeId, operands: IndirectOperands, signature: MirSignature, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let source_parameters = list[ir.TypeId]()
        var source_result = resolve_builtin_type(BuiltinType.unit)
        match self.program.types.definitions[callee_type.value].form:
            CFunction(parameters, result):
                for parameter in parameters: source_parameters.append(parameter)
                source_result = result
            else: trap("C indirect call has a non-cfunc HIR type")
        let call_arguments = list[RegisterId]()
        for index in range(0, len(operands.values)):
            call_arguments.append(try self.encode_c_boundary_value(module, function, span, source_parameters[index], operands.values[index], body))
        # A bare cfunc is pointer-shaped: zero is observable while stored but
        # invoking it is the precise `null_foreign` trap boundary.
        self.emit_nonnull_c_guard(operands.target, span, body)
        let raw_results = list[RegisterId]()
        if not types_match(source_result, resolve_builtin_type(BuiltinType.unit)):
            raw_results.append(self.new_register(try self.c_boundary_type_of(module, function, span, source_result)))
        body.append(MirInstruction(form = InstructionForm.CallIndirect(results = self.operands.run(raw_results), signature = signature, convention = CallingConvention.c, target = operands.target, arguments = self.operands.run(call_arguments)), span = span))
        if len(raw_results) == 0: return RegisterId(value = no_register)
        return try self.decode_c_boundary_value(module, function, span, source_result, raw_results[0], body)

    func lower_fallible_indirect_call(module: HirModule, function: HirFunction, expression: NodeId, callee: NodeId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.program, expression)
        let operands = try self.lower_indirect_operands(module, function, callee, arguments, body)
        let signature = try self.lower_function_value_signature(module, function, span, node_type(self.program, callee))
        if not signature.is_fallible: trap("infallible indirect call entered fallible lowering")
        let successful = self.fallible_inner(node_type(self.program, expression)) else trap("fallible indirect call has an infallible result")
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let call_arguments = [self.new_temp(error_type, span, body)]
        let results = list[RegisterId]()
        var value = RegisterId(value = no_register)
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
            let result_type = try self.mir_type_of(module, function, span, successful)
            if self.is_aggregate(result_type):
                value = self.new_temp(result_type, span, body)
                call_arguments.append(value)
            else:
                value = self.new_register(result_type)
                results.append(value)
        for argument in operands.values: call_arguments.append(argument)
        let reported_error = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        results.append(reported_error)
        body.append(MirInstruction(form = InstructionForm.CallIndirect(results = self.operands.run(results), signature = signature, convention = self.function_value_convention(node_type(self.program, callee)), target = operands.target, arguments = self.operands.run(call_arguments)), span = span))
        return FallibleResult(value = value, error_value = reported_error)

    func lower_fallible_call(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.program, expression)
        let target = self.function_index_of(callee)
        if target < 0: try self.fail_unsupported(module, function, span, "a call to a symbol that is not a function")
        let called = self.program.functions[target]
        let successful = self.fallible_inner(called.result) else error(self.unsupported(module, function, span, "a non-fallible call in fallible lowering"))
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_temp = self.new_temp(error_type, span, body)
        let call_arguments = [error_temp]
        var value = RegisterId(value = no_register)
        let results = list[RegisterId]()
        if not types_match(successful, resolve_builtin_type(BuiltinType.unit)):
            let result_type = try self.mir_type_of(module, function, span, successful)
            if self.is_aggregate(result_type):
                value = self.new_temp(result_type, span, body)
                call_arguments.append(value)
            else:
                value = self.new_register(result_type)
                results.append(value)
        for argument in placed: call_arguments.append(argument)
        let reported_error = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        results.append(reported_error)
        self.emit_call(target, results, call_arguments, span, body)
        return FallibleResult(value = value, error_value = reported_error)

    # A fallible initializer writes into fresh caller-owned struct storage and
    # returns the ordinary caller-owned Error pointer. Its source-level unit
    # success is replaced by the completed storage address in HIR.
    func lower_fallible_initializer(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> FallibleResult!:
        let span = node_span(self.program, expression)
        let target = self.function_index_of(callee)
        if target < 0: try self.fail_unsupported(module, function, span, "an initializer symbol that is not a function")
        let called = self.program.functions[target]
        let receiver = called.receiver else error(self.unsupported(module, function, span, "an initializer without a receiver"))
        if receiver.kind != HirReceiverKind.initializer:
            try self.fail_unsupported(module, function, span, "an Initialize node naming a non-initializer")
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let value_type = try self.mir_type_of(module, function, span, receiver.owner)
        let value = self.new_temp(value_type, span, body)
        placed[0] = value
        let error_type = try self.mir_type_of(module, function, span, resolve_builtin_type(BuiltinType.error_value))
        let error_temp = self.new_temp(error_type, span, body)
        let call_arguments = [error_temp]
        for argument in placed: call_arguments.append(argument)
        let reported_error = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        self.emit_call(target, [reported_error], call_arguments, span, body)
        return FallibleResult(value = value, error_value = reported_error)

    # Arguments are lowered in the order they were written, then placed by
    # the parameter index HIR resolved for each (named arguments may be
    # written in any order). The callee is a `FunctionId`, its index in
    # `program.functions`, which is the same index in the MIR program.
    func lower_call(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let target = self.function_index_of(callee)
        if target < 0: try self.fail_unsupported(module, function, span, "a call to a symbol that is not a function")
        let called = self.program.functions[target]
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        match called.implementation:
            ExternalC(contract): return try self.lower_c_import_call(module, function, span, target, called, contract, placed, body)
            else: pass
        let results = list[RegisterId]()
        if not types_match(called.result, resolve_builtin_type(BuiltinType.unit)):
            let result_type = try self.mir_type_of(module, function, span, called.result)
            if self.is_aggregate(result_type):
                # The callee fills the caller's slot through its hidden first
                # parameter, so the slot's address leads the arguments.
                let result_temp = self.new_temp(result_type, span, body)
                let with_slot = [result_temp]
                for argument in placed: with_slot.append(argument)
                self.emit_call(target, results, with_slot, span, body)
                return result_temp
            results.append(self.new_register(result_type))
        self.emit_call(target, results, placed, span, body)
        if len(results) == 0: return RegisterId(value = no_register)
        return results[0]

    # Adapt one host-supplied C call without changing ordinary HIR or canonical
    # MIR value representations. Nullable pointer handles are tagged optionals
    # everywhere except the raw call operands/results; bare nulls trap at this
    # exact boundary in both directions.
    func lower_c_import_call(module: HirModule, function: HirFunction, span: SourceSpan, target: i64, called: HirFunction, contract: HirCFunction, placed: list[RegisterId], body: list[MirInstruction]) -> RegisterId!:
        let encoded = list[RegisterId]()
        let output_slots = list[COutputSlot]()
        for slot in contract.slots:
            match slot:
                Input(parameter):
                    let value_type = called.parameters[parameter].value_type
                    encoded.append(try self.encode_c_boundary_value(module, function, span, value_type, placed[parameter], body))
                Output(name, value_type):
                    let raw_type = try self.c_boundary_type_of(module, function, span, value_type)
                    let address = self.new_temp(raw_type, span, body)
                    encoded.append(address)
                    output_slots.append(COutputSlot(value_type = value_type, raw_type = raw_type, address = address))
        let raw_results = list[RegisterId]()
        if not types_match(contract.declared_result, resolve_builtin_type(BuiltinType.unit)):
            raw_results.append(self.new_register(try self.c_boundary_type_of(module, function, span, contract.declared_result)))
        self.emit_call(target, raw_results, encoded, span, body)

        let values = list[RegisterId]()
        let value_types = list[ir.TypeId]()
        if len(raw_results) > 0:
            values.append(try self.decode_c_boundary_value(module, function, span, contract.declared_result, raw_results[0], body))
            value_types.append(contract.declared_result)
        for output in output_slots:
            let raw_value = self.load_value(output.raw_type, output.address, span, body)
            values.append(try self.decode_c_boundary_value(module, function, span, output.value_type, raw_value, body))
            value_types.append(output.value_type)

        if len(values) == 0: return RegisterId(value = no_register)
        if len(values) == 1: return values[0]
        let tuple_type = try self.mir_type_of(module, function, span, called.result)
        let result = self.new_temp(tuple_type, span, body)
        for index in range(0, len(values)):
            let field = self.field_address(tuple_type, result, index, span, body)
            let field_type = try self.mir_type_of(module, function, span, value_types[index])
            self.store_value(field_type, field, values[index], span, body)
        return result

    # Internal value -> C slot. Only nullable pointer handles need structural
    # conversion; a bare pointer is validated, and every other admitted scalar
    # already has its canonical C-width MIR type.
    func encode_c_boundary_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let optional_inner = self.optional_pointer_handle(value_type)
        if optional_inner != none:
            let optional_type = try self.mir_type_of(module, function, span, value_type)
            let present = self.load_present(value, span, body)
            let encoded = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
            self.open_if(present, [encoded], span, body)
            let payload = self.load_value(
                builtin_mir_type(BuiltinMirType.pointer),
                self.payload_address(optional_type, value, span, body),
                span,
                body,
            )
            self.emit_yield(payload, span, body)
            self.emit_else(span, body)
            self.emit_yield(self.null_constant(span, body), span, body)
            self.emit_end(span, body)
            return encoded
        if self.is_pointer_handle(value_type): self.emit_nonnull_c_guard(value, span, body)
        return value

    # C slot -> internal value. Decoding allocates the ordinary tagged
    # optional before any source operation can observe the value.
    func decode_c_boundary_value(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, value: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let optional_inner = self.optional_pointer_handle(value_type)
        if optional_inner != none:
            let optional_type = try self.mir_type_of(module, function, span, value_type)
            let decoded = self.new_temp(optional_type, span, body)
            let null_value = self.null_constant(span, body)
            let present = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
            body.append(MirInstruction(form = InstructionForm.Binary(result = present, operation = BinaryOp.ne, left = value, right = null_value), span = span))
            self.open_if(present, list[RegisterId](), span, body)
            self.store_tag(decoded, 1, span, body)
            self.store_value(
                builtin_mir_type(BuiltinMirType.pointer),
                self.payload_address(optional_type, decoded, span, body),
                value,
                span,
                body,
            )
            self.emit_else(span, body)
            self.store_tag(decoded, 0, span, body)
            self.emit_end(span, body)
            return decoded
        if self.is_pointer_handle(value_type): self.emit_nonnull_c_guard(value, span, body)
        return value

    func emit_nonnull_c_guard(value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        let null_value = self.null_constant(span, body)
        let is_null = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_null, operation = BinaryOp.eq, left = value, right = null_value), span = span))
        self.open_if(is_null, list[RegisterId](), span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "null_foreign"), span = span))
        self.emit_end(span, body)

    # The non-fallible form uses the same fresh receiver slot without an
    # Error parameter. The initializer returns unit; the expression returns
    # the slot it completed.
    func lower_initializer(module: HirModule, function: HirFunction, expression: NodeId, callee: SymbolId, arguments: Operands, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, expression)
        let target = self.function_index_of(callee)
        if target < 0: try self.fail_unsupported(module, function, span, "an initializer symbol that is not a function")
        let called = self.program.functions[target]
        let receiver = called.receiver else error(self.unsupported(module, function, span, "an initializer without a receiver"))
        if receiver.kind != HirReceiverKind.initializer:
            try self.fail_unsupported(module, function, span, "an Initialize node naming a non-initializer")
        let placed = try self.lower_placed_arguments(module, function, called, arguments, body)
        let value_type = try self.mir_type_of(module, function, span, receiver.owner)
        let value = self.new_temp(value_type, span, body)
        placed[0] = value
        self.emit_call(target, list[RegisterId](), placed, span, body)
        return value

    # The sole HIR-call → MIR-call split. Argument and result placement is
    # shared; only the identity space changes at the canonical MIR boundary.
    func emit_call(target: i64, results: list[RegisterId], arguments: list[RegisterId], span: SourceSpan, body: list[MirInstruction]):
        let result_run = self.operands.run(results)
        let argument_run = self.operands.run(arguments)
        match self.lowered_functions[target]:
            Defined(function):
                body.append(MirInstruction(form = InstructionForm.Call(results = result_run, function = function, arguments = argument_run), span = span))
            External(external):
                body.append(MirInstruction(form = InstructionForm.CallExtern(results = result_run, external = external, arguments = argument_run), span = span))

    # `a and b` evaluates `b` only when `a` is true; `a or b` only when `a`
    # is false. Both are an `If` whose unevaluated arm yields the constant
    # that decided the answer.
    func lower_short_circuit(module: HirModule, function: HirFunction, expression: NodeId, left: NodeId, right: NodeId, is_and: bool, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let expression_span = node_span(self.program, expression)
        let left_register = try self.lower_expression(module, function, left, body)
        let result = self.new_register(boolean)
        self.open_if(left_register, [result], expression_span, body)
        # `and`: the left decided only when false; `or`: only when true.
        if is_and:
            let right_register = try self.lower_expression(module, function, right, body)
            self.emit_yield(right_register, expression_span, body)
            self.emit_else(expression_span, body)
            let decided = self.bool_constant(false, expression_span, body)
            self.emit_yield(decided, expression_span, body)
        else:
            let decided = self.bool_constant(true, expression_span, body)
            self.emit_yield(decided, expression_span, body)
            self.emit_else(expression_span, body)
            let right_register = try self.lower_expression(module, function, right, body)
            self.emit_yield(right_register, expression_span, body)
        self.emit_end(expression_span, body)
        return result

    # Emit one `Binary` for a resolved HIR operation on two lowered operands.
    # Comparisons produce a `bool` register; everything else keeps the operand
    # type.
    func lower_binary_operation(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var binary_operation = BinaryOp.add
        var is_comparison = false
        match operation:
            Add(item): binary_operation = BinaryOp.add
            Subtract(item): binary_operation = BinaryOp.sub
            Multiply(item): binary_operation = BinaryOp.mul
            Divide(item): binary_operation = BinaryOp.div
            FloorDivide(item): binary_operation = BinaryOp.floor_div
            Remainder(item): binary_operation = BinaryOp.rem
            BitwiseAnd(item): binary_operation = BinaryOp.bit_and
            BitwiseOr(item): binary_operation = BinaryOp.bit_or
            BitwiseXor(item): binary_operation = BinaryOp.bit_xor
            ShiftLeft(item): binary_operation = BinaryOp.shift_left
            ShiftRight(item): binary_operation = BinaryOp.shift_right
            Equal(item):
                binary_operation = BinaryOp.eq
                is_comparison = true
            NotEqual(item):
                binary_operation = BinaryOp.ne
                is_comparison = true
            Less(item):
                binary_operation = BinaryOp.lt
                is_comparison = true
            LessEqual(item):
                binary_operation = BinaryOp.le
                is_comparison = true
            Greater(item):
                binary_operation = BinaryOp.gt
                is_comparison = true
            GreaterEqual(item):
                binary_operation = BinaryOp.ge
                is_comparison = true
            else: try self.fail_unsupported(module, function, span, "operation `" + str(operation) + "`")
        var result_type = operand_type
        if is_comparison: result_type = builtin_mir_type(BuiltinMirType.boolean)
        let register = self.new_register(result_type)
        body.append(MirInstruction(
            form = InstructionForm.Binary(result = register, operation = binary_operation, left = left, right = right),
            span = span,
        ))
        return register

    # mark: Match ===============================================================================
    #
    # A `match` is an `If` chain testing the subject once per alternative,
    # innermost-last, so arms are tried in source order. An arm whose
    # alternatives bind payloads gets its body once per alternative (each
    # alternative's payload lives in a different case struct). The expression
    # form wraps the chain in a `Block` with the result register and every arm
    # branches to it with its value; the last `Else` traps, since HirGenerator
    # proved the arms exhaustive. `Switch` is left for the native backends'
    # jump tables.
    func lower_match(module: HirModule, function: HirFunction, node: NodeId, subject: NodeId, arms: Operands, has_result: bool, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, node)
        let subject_type = node_type(self.program, subject)
        let selected = try self.lower_expression(module, function, subject, body)
        var result = RegisterId(value = no_register)
        var block_depth = len(self.regions)
        if has_result:
            result = self.new_register(self.register_type_for(try self.mir_type_of(module, function, span, node_type(self.program, node))))
            body.append(MirInstruction(form = InstructionForm.Block(results = self.operands.run([result])), span = span))
            self.regions.append(Region.block)
        var arm_exit = MatchExit.Statement
        if has_result: arm_exit = MatchExit.Value(block_depth = block_depth)
        try self.lower_match_arms(module, function, selected, subject_type, arms, arm_exit, span, body)
        if has_result:
            self.regions.remove(len(self.regions) - 1)
            self.emit_end(span, body)
        return result

    # Emit the pattern-test chain shared by statement, value, and fallible
    # matches. Each open If remains around the following arm's Else, which is
    # why a branch to an outer result block counts all earlier alternatives.
    func lower_match_arms(module: HirModule, function: HirFunction, selected: RegisterId, subject_type: ir.TypeId, arms: Operands, arm_exit: MatchExit, span: SourceSpan, body: list[MirInstruction]) -> !:
        var open_arms = 0
        var closed = false
        for position in range(0, i64(arms.count)):
            if closed: break
            let arm = node_at(self.program, arms, position)
            match node_form(self.program, arm):
                MatchArm(patterns, statements, value):
                    if self.arm_binds(patterns):
                        # Payload bindings point into a case-specific layout,
                        # so every alternative needs its own copy of the arm.
                        for alternative in range(0, i64(patterns.count)):
                            let pattern = node_at(self.program, patterns, alternative)
                            let test = try self.lower_pattern_test(module, function, pattern, selected, subject_type, body)
                            self.open_if(test, list[RegisterId](), span, body)
                            self.regions.append(Region.if_arm)
                            try self.lower_pattern_bindings(module, function, pattern, selected, subject_type, body)
                            try self.lower_selected_match_arm(module, function, statements, value, arm_exit, span, body)
                            self.emit_else(span, body)
                            open_arms += 1
                    elif self.arm_is_wildcard(patterns):
                        try self.lower_selected_match_arm(module, function, statements, value, arm_exit, span, body)
                        closed = true
                    else:
                        var test = try self.lower_pattern_test(module, function, node_at(self.program, patterns, 0), selected, subject_type, body)
                        for alternative in range(1, i64(patterns.count)):
                            let next = try self.lower_pattern_test(module, function, node_at(self.program, patterns, alternative), selected, subject_type, body)
                            test = self.lower_or(test, next, span, body)
                        self.open_if(test, list[RegisterId](), span, body)
                        self.regions.append(Region.if_arm)
                        try self.lower_selected_match_arm(module, function, statements, value, arm_exit, span, body)
                        self.emit_else(span, body)
                        open_arms += 1
                else: try self.fail_unsupported(module, function, span, "a match arm that is not a `MatchArm` node")
        if not closed: body.append(MirInstruction(form = InstructionForm.Trap(reason = "unreachable match arm"), span = span))
        for arm in range(0, open_arms):
            self.regions.remove(len(self.regions) - 1)
            self.emit_end(span, body)

    func lower_selected_match_arm(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, arm_exit: MatchExit, span: SourceSpan, body: list[MirInstruction]) -> !:
        match arm_exit:
            Statement: try self.lower_scope(module, function, statements, body)
            Value(block_depth): try self.lower_value_match_arm(module, function, statements, value, block_depth, span, body)
            Fallible(block_depth): try self.lower_fallible_arm_body(module, function, statements, value, block_depth, span, body)

    # A value arm branches to the match's result block through every pattern
    # region opened since the block.
    func lower_value_match_arm(module: HirModule, function: HirFunction, statements: Operands, value: NodeId, block_depth: i64, span: SourceSpan, body: list[MirInstruction]) -> !:
        let defer_start = len(self.defers)
        for position in range(0, i64(statements.count)):
            try self.lower_statement(module, function, node_at(self.program, statements, position), body)
        let register = try self.lower_expression(module, function, value, body)
        try self.emit_deferred_from(module, function, defer_start, body)
        while len(self.defers) > defer_start: self.defers.remove(len(self.defers) - 1)
        let depth = len(self.regions) - 1 - block_depth
        body.append(MirInstruction(form = InstructionForm.Br(depth = depth, values = self.operands.run([register])), span = span))

    func arm_binds(patterns: Operands) -> bool:
        for position in range(0, i64(patterns.count)):
            match node_form(self.program, node_at(self.program, patterns, position)):
                PatternCase(case_index, bindings):
                    if bindings.count > 0: return true
                else: pass
        return false

    func arm_is_wildcard(patterns: Operands) -> bool:
        if patterns.count != 1: return false
        match node_form(self.program, node_at(self.program, patterns, 0)):
            PatternWildcard: return true
            else: return false

    # `a or b` / `a and b` over two already-computed tests, as an `If` with a
    # result (bool has no bitwise operators in MIR).
    func lower_or(left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(left, [result], span, body)
        self.emit_yield(self.bool_constant(true, span, body), span, body)
        self.emit_else(span, body)
        self.emit_yield(right, span, body)
        self.emit_end(span, body)
        return result

    func lower_and(left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let result = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(left, [result], span, body)
        self.emit_yield(right, span, body)
        self.emit_else(span, body)
        self.emit_yield(self.bool_constant(false, span, body), span, body)
        self.emit_end(span, body)
        return result

    # A bool register: does the subject match this pattern?
    func lower_pattern_test(module: HirModule, function: HirFunction, pattern: NodeId, selected: RegisterId, subject_type: ir.TypeId, body: list[MirInstruction]) -> RegisterId!:
        let span = node_span(self.program, pattern)
        match node_form(self.program, pattern):
            PatternWildcard: return self.bool_constant(true, span, body)
            PatternLiteral(value):
                let literal = try self.lower_value_constant(module, function, self.program.values[value], subject_type, span, body)
                return try self.lower_equality(module, function, span, subject_type, selected, literal, body)
            PatternRange(lower, upper, inclusive):
                let operand_type = try self.mir_type_of(module, function, span, subject_type)
                let low = try self.lower_value_constant(module, function, self.program.values[lower], subject_type, span, body)
                let high = try self.lower_value_constant(module, function, self.program.values[upper], subject_type, span, body)
                let above = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = above, operation = BinaryOp.ge, left = selected, right = low), span = span))
                let below = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                var upper_test = BinaryOp.lt
                if inclusive: upper_test = BinaryOp.le
                body.append(MirInstruction(form = InstructionForm.Binary(result = below, operation = upper_test, left = selected, right = high), span = span))
                return self.lower_and(above, below, span, body)
            PatternCase(case_index, bindings):
                let tag = self.load_tag(selected, span, body)
                let wanted = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u8))
                body.append(MirInstruction(form = InstructionForm.Const(result = wanted, value = MirConstant.Int(value = case_index)), span = span))
                let same = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = same, operation = BinaryOp.eq, left = tag, right = wanted), span = span))
                return same
            else: error(self.unsupported(module, function, span, "a pattern that is not a pattern node"))

    # After a case test succeeds: copy each payload field into its binding's slot.
    func lower_pattern_bindings(module: HirModule, function: HirFunction, pattern: NodeId, selected: RegisterId, subject_type: ir.TypeId, body: list[MirInstruction]) -> !:
        let span = node_span(self.program, pattern)
        match node_form(self.program, pattern):
            PatternCase(case_index, bindings):
                if bindings.count == 0: return
                let enum_type = try self.mir_type_of(module, function, span, subject_type)
                let payload_base = self.payload_address(enum_type, selected, span, body)
                match self.program.types.definitions[subject_type.value].form:
                    Optional(inner):
                        # `.some(value)`: the payload is the value itself.
                        let inner_type = try self.mir_type_of(module, function, span, inner)
                        let symbol = SymbolId(value = u32(entry_at(self.program, bindings, 0)))
                        let local = try self.local_of(module, function, span, symbol)
                        self.store_value(inner_type, local.address, self.load_value(inner_type, payload_base, span, body), span, body)
                    Enum(enum_index):
                        let case_type = self.case_struct_type(enum_type, case_index)
                        let fields = self.program.enums[enum_index].cases[case_index].payload
                        for index in range(0, i64(bindings.count)):
                            let symbol = SymbolId(value = u32(entry_at(self.program, bindings, index)))
                            let local = try self.local_of(module, function, span, symbol)
                            let field_type = try self.mir_type_of(module, function, span, fields[index].value_type)
                            let field = self.field_address(case_type, payload_base, index, span, body)
                            self.store_value(field_type, local.address, self.load_value(field_type, field, span, body), span, body)
                    else: try self.fail_unsupported(module, function, span, "payload bindings on `" + describe_type(self.program.types, subject_type) + "`")
            else: return

    # A pattern's literal as a register of the subject's type.
    func lower_value_constant(module: HirModule, function: HirFunction, value: Value, subject_type: ir.TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let value_type = try self.mir_type_of(module, function, span, subject_type)
        var constant = MirConstant.Null
        match value:
            Integer(item): constant = MirConstant.Int(value = item)
            Floating(item): constant = MirConstant.Float(value = item)
            Boolean(item): constant = MirConstant.Bool(value = item)
            Character(item): constant = MirConstant.Int(value = i64(u32(item)))
            Text(item): return try self.lower_byte_constant(value_type, strings.to_bytes(item), span, body)
            Bytes(item): return try self.lower_byte_constant(value_type, item, span, body)
            else: try self.fail_unsupported(module, function, span, "pattern literal `" + str(value) + "`")
        let register = self.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = constant), span = span))
        return register

    # The payload struct of one enum case, from the enum's MIR type.
    func case_struct_type(enum_type: TypeId, case_index: i64) -> TypeId:
        match mir_type(self.types, enum_type):
            Enum(tag, cases): return cases[case_index]
            else: trap("case struct of a non-enum MIR type")

    # `payload_cases[position..]` compared in turn: `If(tag == case)` compares
    # that case's fields, its else-arm tries the next; past the last, two
    # values with equal tags and no payload are equal.
    func lower_enum_case_chain(module: HirModule, function: HirFunction, span: SourceSpan, enum_index: i64, enum_type: TypeId, left: RegisterId, right: RegisterId, left_tag: RegisterId, payload_cases: list[i64], position: i64, body: list[MirInstruction]) -> RegisterId!:
        if position >= len(payload_cases): return self.bool_constant(true, span, body)
        let case_index = payload_cases[position]
        let wanted = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u8))
        body.append(MirInstruction(form = InstructionForm.Const(result = wanted, value = MirConstant.Int(value = case_index)), span = span))
        let is_case = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = is_case, operation = BinaryOp.eq, left = left_tag, right = wanted), span = span))
        let compared = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(is_case, [compared], span, body)
        let case_type = self.case_struct_type(enum_type, case_index)
        let left_payload = self.payload_address(enum_type, left, span, body)
        let right_payload = self.payload_address(enum_type, right, span, body)
        let fields = self.program.enums[enum_index].cases[case_index].payload
        var so_far = self.bool_constant(true, span, body)
        for field_index in range(0, len(fields)):
            let element_type = try self.mir_type_of(module, function, span, fields[field_index].value_type)
            let left_value = self.load_value(element_type, self.field_address(case_type, left_payload, field_index, span, body), span, body)
            let right_value = self.load_value(element_type, self.field_address(case_type, right_payload, field_index, span, body), span, body)
            so_far = try self.lower_and_then(module, function, span, so_far, fields[field_index].value_type, left_value, right_value, body)
        self.emit_yield(so_far, span, body)
        self.emit_else(span, body)
        let rest = try self.lower_enum_case_chain(module, function, span, enum_index, enum_type, left, right, left_tag, payload_cases, position + 1, body)
        self.emit_yield(rest, span, body)
        self.emit_end(span, body)
        return compared

    # mark: Aggregates ==========================================================================
    #
    # The helpers below implement the memory protocol described in the header:
    # a register of aggregate type is an address, copies are `Memcpy`, and
    # scalars inside an aggregate are reached through `FieldAddress`.

    func is_aggregate(value_type: TypeId) -> bool:
        match mir_type(self.types, value_type):
            Struct(fields): return true
            Enum(tag, cases): return true
            Array(element, count): return true
            else: return false

    # The type of the register holding a value of `value_type`.
    func register_type_for(value_type: TypeId) -> TypeId:
        if self.is_aggregate(value_type): return builtin_mir_type(BuiltinMirType.pointer)
        return value_type

    # A fresh scratch slot allocated where it is needed. Aggregates use it for
    # values; structured lowering may use a scalar slot for loop-carried state.
    # The backend sizes the frame from `slots` regardless of where `Alloca` sits.
    func new_temp(value_type: TypeId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let slot = len(self.slots)
        self.slots.append(MirSlot(value_type = value_type))
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = span))
        return address

    # Put a value at an address: `Memcpy` for an aggregate, `Store` otherwise.
    func store_value(value_type: TypeId, address: RegisterId, value: RegisterId, span: SourceSpan, body: list[MirInstruction]):
        if self.is_aggregate(value_type):
            body.append(MirInstruction(form = InstructionForm.Memcpy(destination = address, source = value, value_type = value_type), span = span))
        else:
            body.append(MirInstruction(form = InstructionForm.Store(value_type = value_type, address = address, value = value), span = span))

    # Read a value at an address: the address itself for an aggregate (no
    # copy until it is stored somewhere), a `Load` otherwise.
    func load_value(value_type: TypeId, address: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        if self.is_aggregate(value_type): return address
        let register = self.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Load(result = register, value_type = value_type, address = address), span = span))
        return register

    func field_address(struct_type: TypeId, base: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.FieldAddress(result = address, struct_type = struct_type, base = base, field = field), span = span))
        return address

    func element_address(element_type: TypeId, base: RegisterId, index: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ElementAddress(result = address, element_type = element_type, base = base, index = index), span = span))
        return address

    func global_address(index: u32, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.GlobalAddress(result = address, global = GlobalId(value = index)), span = span))
        return address

    # The scalar field `field` of the struct at `base`, loaded.
    func load_field(struct_type: TypeId, base: RegisterId, field: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        match mir_type(self.types, struct_type):
            Struct(fields):
                return self.load_value(fields[field].value_type, self.field_address(struct_type, base, field, span, body), span, body)
            else: error("lowerer: field of a non-struct type")

    # Keep payload placement symbolic until a backend chooses its byte layout.
    func payload_address(enum_type: TypeId, base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.EnumPayloadAddress(result = address, enum_type = enum_type, base = base), span = span))
        return address

    func store_tag(base: RegisterId, tag: i64, span: SourceSpan, body: list[MirInstruction]):
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let value = self.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = value, value = MirConstant.Int(value = tag)), span = span))
        body.append(MirInstruction(form = InstructionForm.Store(value_type = byte_type, address = base, value = value), span = span))

    func load_tag(base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let tag = self.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Load(result = tag, value_type = byte_type, address = base), span = span))
        return tag

    # `tag == 1` as a bool register.
    func load_present(base: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let tag = self.load_tag(base, span, body)
        let one = self.new_register(byte_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.Int(value = 1)), span = span))
        let present = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = present, operation = BinaryOp.eq, left = tag, right = one), span = span))
        return present

    # A `str` or `bytes` literal: its bytes become a data item and the value
    # is a fresh `{pointer, length}` slot.
    func lower_byte_constant(value_type: TypeId, payload: list[u8], span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let data_id = self.add_data("bytes", payload)
        let temp = self.new_temp(value_type, span, body)
        let pointer = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = pointer, data = DataId(value = u32(data_id))), span = span))
        let pointer_field = self.field_address(value_type, temp, 0, span, body)
        body.append(MirInstruction(form = InstructionForm.Store(value_type = builtin_mir_type(BuiltinMirType.pointer), address = pointer_field, value = pointer), span = span))
        let length = self.new_register(builtin_mir_type(BuiltinMirType.unsigned_u64))
        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.Int(value = len(payload))), span = span))
        let length_field = self.field_address(value_type, temp, 1, span, body)
        body.append(MirInstruction(form = InstructionForm.Store(value_type = builtin_mir_type(BuiltinMirType.unsigned_u64), address = length_field, value = length), span = span))
        return temp

    # A sequence index evaluates both operands once, checks its `u64` bound,
    # and exposes only structural MIR addressing. Fixed arrays carry their
    # count in the canonical type; byte strings carry it in the value.
    func lower_sequence_index(module: HirModule, function: HirFunction, span: SourceSpan, value: NodeId, index: NodeId, body: list[MirInstruction]) -> RegisterId!:
        let sequence = try self.lower_expression(module, function, value, body)
        let position = try self.lower_expression(module, function, index, body)
        let hir_sequence_type = node_type(self.program, value)
        match self.program.types.definitions[hir_sequence_type.value].form:
            Array(element, count):
                let element_type = try self.mir_type_of(module, function, span, element)
                let address = self.checked_element_address(element_type, sequence, position, count, span, body)
                return self.load_value(element_type, address, span, body)
            List(element):
                let element_type = try self.mir_type_of(module, function, span, element)
                let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                body.append(MirInstruction(form = InstructionForm.ListElementAddress(result = address, value = sequence, index = position), span = span))
                return self.load_value(element_type, address, span, body)
            else:
                let sequence_type = try self.mir_type_of(module, function, span, hir_sequence_type)
                let length = try self.load_field(sequence_type, sequence, 1, span, body)
                let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
                let byte_data = try self.load_field(sequence_type, sequence, 0, span, body)
                let address = self.checked_element_address_with_length(byte_type, byte_data, position, length, span, body)
                return self.load_value(byte_type, address, span, body)

    func checked_element_address(element_type: TypeId, base: RegisterId, index: RegisterId, count: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let length = self.integer_constant(builtin_mir_type(BuiltinMirType.unsigned_u64), count, span, body)
        return self.checked_element_address_with_length(element_type, base, index, length, span, body)

    func checked_element_address_with_length(element_type: TypeId, base: RegisterId, index: RegisterId, length: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let in_bounds = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Binary(result = in_bounds, operation = BinaryOp.lt, left = index, right = length), span = span))
        let result = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        self.open_if(in_bounds, [result], span, body)
        self.emit_yield(self.element_address(element_type, base, index, span, body), span, body)
        self.emit_else(span, body)
        body.append(MirInstruction(form = InstructionForm.Trap(reason = "index out of bounds"), span = span))
        self.emit_end(span, body)
        return result

    func integer_constant(value_type: TypeId, value: i64, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.new_register(value_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.Int(value = value)), span = span))
        return register

    func bool_constant(value: bool, span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.Bool(value = value)), span = span))
        return register

    func null_constant(span: SourceSpan, body: list[MirInstruction]) -> RegisterId:
        let register = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.Const(result = register, value = MirConstant.Null), span = span))
        return register

    # mark: Aggregate equality ==================================================================
    #
    # Aggregates support `==` and `!=` only. Equality is structural and short-
    # circuits: `If(so_far, then: next test, else: false)`, so an unequal
    # tuple element or length stops the comparison there.

    func lower_aggregate_comparison(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var negate = false
        match operation:
            Equal(item): negate = false
            NotEqual(item): negate = true
            else: try self.fail_unsupported(module, function, span, "operation `" + str(operation) + "` on `" + describe_type(self.program.types, operand_type) + "`")
        let equal = try self.lower_equality(module, function, span, operand_type, left, right, body)
        if not negate: return equal
        let unequal = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        body.append(MirInstruction(form = InstructionForm.Unary(result = unequal, operation = UnaryOp.bool_not, operand = equal), span = span))
        return unequal

    # `left == right` for any HIR type, given registers under the aggregate
    # protocol (addresses for aggregates, values for scalars).
    func lower_equality(module: HirModule, function: HirFunction, span: SourceSpan, value_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let mir_value_type = try self.mir_type_of(module, function, span, value_type)
        if not self.is_aggregate(mir_value_type):
            return try self.lower_binary_operation(module, function, span, BinaryOperation.Equal(operand_type = value_type), mir_value_type, left, right, body)
        match self.program.types.definitions[value_type.value].form:
            Tuple(elements):
                var so_far = self.bool_constant(true, span, body)
                for index in range(0, len(elements)):
                    let left_field = self.field_address(mir_value_type, left, index, span, body)
                    let right_field = self.field_address(mir_value_type, right, index, span, body)
                    let element_type = try self.mir_type_of(module, function, span, elements[index])
                    let left_value = self.load_value(element_type, left_field, span, body)
                    let right_value = self.load_value(element_type, right_field, span, body)
                    so_far = try self.lower_and_then(module, function, span, so_far, elements[index], left_value, right_value, body)
                return so_far
            Array(element, count):
                return try self.lower_array_equality(module, function, span, element, count, left, right, body)
            Range(inner):
                var so_far = self.bool_constant(true, span, body)
                let field_types = [inner, inner, resolve_builtin_type(BuiltinType.boolean)]
                for index in range(0, len(field_types)):
                    let left_field = self.field_address(mir_value_type, left, index, span, body)
                    let right_field = self.field_address(mir_value_type, right, index, span, body)
                    let element_type = try self.mir_type_of(module, function, span, field_types[index])
                    let left_value = self.load_value(element_type, left_field, span, body)
                    let right_value = self.load_value(element_type, right_field, span, body)
                    so_far = try self.lower_and_then(module, function, span, so_far, field_types[index], left_value, right_value, body)
                return so_far
            Struct(index):
                var so_far = self.bool_constant(true, span, body)
                let fields = self.program.structs[index].fields
                for field_index in range(0, len(fields)):
                    let left_field = self.field_address(mir_value_type, left, field_index, span, body)
                    let right_field = self.field_address(mir_value_type, right, field_index, span, body)
                    let element_type = try self.mir_type_of(module, function, span, fields[field_index].value_type)
                    let left_value = self.load_value(element_type, left_field, span, body)
                    let right_value = self.load_value(element_type, right_field, span, body)
                    so_far = try self.lower_and_then(module, function, span, so_far, fields[field_index].value_type, left_value, right_value, body)
                return so_far
            Optional(inner):
                # Tags equal, and when both are present, payloads equal.
                let left_present = self.load_present(left, span, body)
                let right_present = self.load_present(right, span, body)
                let tags_equal = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = tags_equal, operation = BinaryOp.eq, left = left_present, right = right_present), span = span))
                let result = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(tags_equal, [result], span, body)
                let compared = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(left_present, [compared], span, body)
                let inner_type = try self.mir_type_of(module, function, span, inner)
                let left_payload = self.load_value(inner_type, self.payload_address(mir_value_type, left, span, body), span, body)
                let right_payload = self.load_value(inner_type, self.payload_address(mir_value_type, right, span, body), span, body)
                let payloads_equal = try self.lower_equality(module, function, span, inner, left_payload, right_payload, body)
                self.emit_yield(payloads_equal, span, body)
                self.emit_else(span, body)
                let absent = self.bool_constant(true, span, body)
                self.emit_yield(absent, span, body)
                self.emit_end(span, body)
                self.emit_yield(compared, span, body)
                self.emit_else(span, body)
                let no = self.bool_constant(false, span, body)
                self.emit_yield(no, span, body)
                self.emit_end(span, body)
                return result
            String: return try self.lower_bytes_equality(mir_value_type, left, right, span, body)
            Bytes: return try self.lower_bytes_equality(mir_value_type, left, right, span, body)
            ErrorCode:
                let fields = [resolve_builtin_type(BuiltinType.string), resolve_builtin_type(BuiltinType.unsigned_u32)]
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, body)
            Error:
                let fields = [resolve_builtin_type(BuiltinType.error_code), resolve_builtin_type(BuiltinType.string)]
                return try self.lower_structural_fields(module, function, span, mir_value_type, fields, left, right, body)
            Enum(index):
                # Same tag, then the same payload for that case.
                let left_tag = self.load_tag(left, span, body)
                let right_tag = self.load_tag(right, span, body)
                let tags_equal = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                body.append(MirInstruction(form = InstructionForm.Binary(result = tags_equal, operation = BinaryOp.eq, left = left_tag, right = right_tag), span = span))
                let result = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
                self.open_if(tags_equal, [result], span, body)
                let payload_cases = list[i64]()
                for case_index in range(0, len(self.program.enums[index].cases)):
                    if len(self.program.enums[index].cases[case_index].payload) > 0: payload_cases.append(case_index)
                let compared = try self.lower_enum_case_chain(module, function, span, index, mir_value_type, left, right, left_tag, payload_cases, 0, body)
                self.emit_yield(compared, span, body)
                self.emit_else(span, body)
                let different = self.bool_constant(false, span, body)
                self.emit_yield(different, span, body)
                self.emit_end(span, body)
                return result
            else: error(self.unsupported(module, function, span, "equality on `" + describe_type(self.program.types, value_type) + "`"))

    # Compare fixed arrays with one canonical MIR loop, independent of their
    # count. Element equality remains recursive, so floats keep IEEE equality
    # and nested value aggregates retain their language semantics.
    func lower_array_equality(module: HirModule, function: HirFunction, span: SourceSpan, hir_element_type: ir.TypeId, count: i64, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let boolean_type = builtin_mir_type(BuiltinMirType.boolean)
        let element_type = try self.mir_type_of(module, function, span, hir_element_type)
        let counter = self.new_temp(index_type, span, body)
        self.store_value(index_type, counter, self.integer_constant(index_type, 0, span, body), span, body)
        let length = self.integer_constant(index_type, count, span, body)
        let equal_value = self.bool_constant(true, span, body)
        let unequal_value = self.bool_constant(false, span, body)
        let result = self.new_register(boolean_type)

        body.append(MirInstruction(form = InstructionForm.Block(results = self.operands.run([result])), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        let index = self.load_value(index_type, counter, span, body)
        let done = self.new_register(boolean_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = index, right = length), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = self.operands.run([equal_value])), span = span))

        let left_value = self.load_value(element_type, self.element_address(element_type, left, index, span, body), span, body)
        let right_value = self.load_value(element_type, self.element_address(element_type, right, index, span, body), span, body)
        let element_equal = try self.lower_equality(module, function, span, hir_element_type, left_value, right_value, body)
        let differs = self.new_register(boolean_type)
        body.append(MirInstruction(form = InstructionForm.Unary(result = differs, operation = UnaryOp.bool_not, operand = element_equal), span = span))
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = differs, depth = 1, values = self.operands.run([unequal_value])), span = span))

        let next = self.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = index, right = self.integer_constant(index_type, 1, span, body)), span = span))
        self.store_value(index_type, counter, next, span, body)
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.emit_end(span, body)
        self.emit_end(span, body)
        return result

    func lower_structural_fields(module: HirModule, function: HirFunction, span: SourceSpan, mir_value_type: TypeId, fields: list[ir.TypeId], left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var so_far = self.bool_constant(true, span, body)
        for index in range(0, len(fields)):
            let field_type = try self.mir_type_of(module, function, span, fields[index])
            let left_value = self.load_value(field_type, self.field_address(mir_value_type, left, index, span, body), span, body)
            let right_value = self.load_value(field_type, self.field_address(mir_value_type, right, index, span, body), span, body)
            so_far = try self.lower_and_then(module, function, span, so_far, fields[index], left_value, right_value, body)
        return so_far

    # `so_far and left == right`, evaluated only when `so_far` holds.
    func lower_and_then(module: HirModule, function: HirFunction, span: SourceSpan, so_far: RegisterId, value_type: ir.TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        let result = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        self.open_if(so_far, [result], span, body)
        let equal = try self.lower_equality(module, function, span, value_type, left, right, body)
        self.emit_yield(equal, span, body)
        self.emit_else(span, body)
        let no = self.bool_constant(false, span, body)
        self.emit_yield(no, span, body)
        self.emit_end(span, body)
        return result

    # Same length, then the same bytes: a counter in a slot drives a loop
    # that leaves its block with `false` at the first mismatch and `true`
    # when the counter reaches the length.
    func lower_bytes_equality(text_type: TypeId, left: RegisterId, right: RegisterId, span: SourceSpan, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let index_type = builtin_mir_type(BuiltinMirType.unsigned_u64)
        let byte_type = builtin_mir_type(BuiltinMirType.unsigned_u8)
        let left_length = try self.load_field(text_type, left, 1, span, body)
        let right_length = try self.load_field(text_type, right, 1, span, body)
        let same_length = self.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = same_length, operation = BinaryOp.eq, left = left_length, right = right_length), span = span))
        let result = self.new_register(boolean)
        self.open_if(same_length, [result], span, body)
        let left_bytes = try self.load_field(text_type, left, 0, span, body)
        let right_bytes = try self.load_field(text_type, right, 0, span, body)
        let counter = self.new_temp(index_type, span, body)
        let zero = self.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = zero, value = MirConstant.Int(value = 0)), span = span))
        body.append(MirInstruction(form = InstructionForm.Store(value_type = index_type, address = counter, value = zero), span = span))
        let compared = self.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Block(results = self.operands.run([compared])), span = span))
        body.append(MirInstruction(form = InstructionForm.Loop, span = span))
        let index = self.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Load(result = index, value_type = index_type, address = counter), span = span))
        let done = self.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = done, operation = BinaryOp.ge, left = index, right = left_length), span = span))
        let yes = self.bool_constant(true, span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = done, depth = 1, values = self.operands.run([yes])), span = span))
        let left_address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ElementAddress(result = left_address, element_type = byte_type, base = left_bytes, index = index), span = span))
        let right_address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.ElementAddress(result = right_address, element_type = byte_type, base = right_bytes, index = index), span = span))
        let left_byte = self.load_value(byte_type, left_address, span, body)
        let right_byte = self.load_value(byte_type, right_address, span, body)
        let differ = self.new_register(boolean)
        body.append(MirInstruction(form = InstructionForm.Binary(result = differ, operation = BinaryOp.ne, left = left_byte, right = right_byte), span = span))
        let no = self.bool_constant(false, span, body)
        body.append(MirInstruction(form = InstructionForm.BrIf(condition = differ, depth = 1, values = self.operands.run([no])), span = span))
        let one = self.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Const(result = one, value = MirConstant.Int(value = 1)), span = span))
        let next = self.new_register(index_type)
        body.append(MirInstruction(form = InstructionForm.Binary(result = next, operation = BinaryOp.add, left = index, right = one), span = span))
        body.append(MirInstruction(form = InstructionForm.Store(value_type = index_type, address = counter, value = next), span = span))
        body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = no_registers()), span = span))
        self.emit_end(span, body)
        self.emit_end(span, body)
        self.emit_yield(compared, span, body)
        self.emit_else(span, body)
        let shorter = self.bool_constant(false, span, body)
        self.emit_yield(shorter, span, body)
        self.emit_end(span, body)
        return result

    # mark: Tables ==============================================================================

    func new_register(value_type: TypeId) -> RegisterId:
        self.registers.append(value_type)
        return RegisterId(value = u32(len(self.registers) - 1))

    # The HIR function a call symbol names, as its index in `program.functions`.
    func function_index_of(symbol: SymbolId) -> i64:
        for index in range(0, len(self.program.functions)):
            if self.program.functions[index].symbol.value == symbol.value: return index
        return -1

    # The module constant a reference names, if any.
    func constant_of(symbol: SymbolId) -> HirConstant?:
        for constant in self.program.constants:
            if constant.symbol.value == symbol.value: return constant
        return none

    # The slot address of a local the prologue reserved.
    func local_of(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId) -> Local!:
        for local in self.locals:
            if local.symbol == symbol.value: return local
        error(self.unsupported(module, function, span, "a reference to a symbol that is not a local"))

    # Declare a runtime service once, with the signature the runtime table
    # fixes for it. Runtime services and source C declarations share the
    # linker's symbol namespace, but never each other's semantic contract.
    func runtime_extern(name: str) -> ExternId!:
        for index in range(0, len(self.externs)):
            let external = self.externs[index]
            if external.name != name: continue
            if external.convention != CallingConvention.runtime:
                error("lowerer: C symbol `" + name + "` conflicts with runtime service")
            return ExternId(value = u32(index))
        for global in self.external_globals:
            if global.name == name:
                error("lowerer: C symbol `" + name + "` conflicts with runtime service")
        let symbol = find_runtime_symbol(name) else error("lowerer: `" + name + "` is not a runtime service")
        self.externs.append(MirExtern(name = name, convention = CallingConvention.runtime, signature = symbol.signature))
        return ExternId(value = u32(len(self.externs) - 1))

    # Map a scalar HIR type onto its canonical machine type. HIR and MIR each
    # have a `TypeId`; the HIR one is spelled `ir.TypeId` here. `char` is its
    # code point in a `u32`.
    func mir_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: ir.TypeId) -> TypeId!:
        let lowered = self.lower_mir_type(value) catch feature:
            error(self.unsupported(module, function, span, feature))
        return lowered

    # HIR-to-MIR type lowering is program-wide and backend-independent. The
    # function and global wrappers add source context only if this shared
    # conversion fails.
    func lower_mir_type(value: ir.TypeId) -> TypeId!:
        let scalar = self.scalar_mir_type(value)
        if scalar != none: return scalar
        # Composites are interned structurally, so two `(i64, bool)` tuples
        # share one MIR type and the verifier sees each layout once.
        match self.program.types.definitions[value.value].form:
            String: return self.byte_string_type()
            Bytes: return self.byte_string_type()
            ErrorCode:
                let fields = [self.byte_string_type(), builtin_mir_type(BuiltinMirType.unsigned_u32)]
                return self.intern_lowered_type(make_struct_type(fields))
            Error:
                let code = try self.lower_mir_type(resolve_builtin_type(BuiltinType.error_code))
                let fields = [code, self.byte_string_type()]
                return self.intern_lowered_type(make_struct_type(fields))
            Tuple(elements):
                let field_types = list[TypeId]()
                for element in elements:
                    field_types.append(try self.lower_mir_type(element))
                return self.intern_lowered_type(make_struct_type(field_types))
            Array(element, count):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.Array(element = element_type, count = count))
            Range(element):
                let element_type = try self.lower_mir_type(element)
                let field_types = [element_type, element_type, builtin_mir_type(BuiltinMirType.boolean)]
                return self.intern_lowered_type(make_struct_type(field_types))
            Struct(index):
                let existing = self.lowered_struct_types[index]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_struct_types[index] = result.value
                self.types.definitions.append(make_struct_type(list[TypeId]()))
                self.active_nominal_types.append(result.value)
                let field_types = list[TypeId]()
                for field in self.program.structs[index].fields:
                    field_types.append(try self.lower_mir_type(field.value_type))
                self.types.definitions[result.value] = make_struct_type(field_types)
                let completed = self.active_nominal_types.pop()
                if completed != result.value: trap("nominal MIR type reservations are not nested")
                return result
            Enum(index):
                # One payload struct per case, in case order; the tag is a `u8`.
                if len(self.program.enums[index].cases) > 256:
                    error("enums with more than 256 cases")
                let existing = self.lowered_enum_types[index]
                if existing != unlowered_nominal_type: return TypeId(value = existing)
                let result = TypeId(value = u32(len(self.types.definitions)))
                self.lowered_enum_types[index] = result.value
                self.types.definitions.append(MirType.Enum(tag = builtin_mir_type(BuiltinMirType.unsigned_u8), cases = list[TypeId]()))
                self.active_nominal_types.append(result.value)
                let case_types = list[TypeId]()
                for case_value in self.program.enums[index].cases:
                    let field_types = list[TypeId]()
                    for field in case_value.payload:
                        field_types.append(try self.lower_mir_type(field.value_type))
                    case_types.append(self.intern_lowered_type(make_struct_type(field_types)))
                self.types.definitions[result.value] = make_enum_type(builtin_mir_type(BuiltinMirType.unsigned_u8), case_types)
                let completed = self.active_nominal_types.pop()
                if completed != result.value: trap("nominal MIR type reservations are not nested")
                return result
            Optional(inner):
                let absent = self.intern_lowered_type(make_struct_type(list[TypeId]()))
                let present = try self.lower_mir_type(inner)
                return self.intern_lowered_type(make_enum_type(builtin_mir_type(BuiltinMirType.unsigned_u8), [absent, present]))
            Function(parameters, result): return builtin_mir_type(BuiltinMirType.pointer)
            CFunction(parameters, result): return builtin_mir_type(BuiltinMirType.pointer)
            NativePointer(pointee, is_mutable): return builtin_mir_type(BuiltinMirType.pointer)
            List(element):
                let element_type = try self.lower_mir_type(element)
                return self.intern_lowered_type(MirType.List(element = element_type))
            Extern(index):
                # Nominality is a source/HIR rule. Canonical MIR carries the
                # declared target-neutral token representation; ABI placement
                # remains a backend concern.
                match self.program.extern_types[index].representation:
                    Pointer: return builtin_mir_type(BuiltinMirType.pointer)
                    Integer(representation): return try self.lower_mir_type(representation)
            else: error("type `" + describe_type(self.program.types, value) + "`")

    # Nominal aggregates reserve a valid empty definition so collection
    # references can point back to them. Structural interning skips only the
    # active reservations; no malformed sentinel type ever enters the table.
    func intern_lowered_type(value: MirType) -> TypeId:
        for index in range(0, len(self.types.definitions)):
            var active = false
            for reserved in self.active_nominal_types:
                if reserved == u32(index): active = true
            if not active and mir_types_match(self.types.definitions[index], value):
                return TypeId(value = u32(index))
        self.types.definitions.append(value)
        return TypeId(value = u32(len(self.types.definitions) - 1))

    func global_mir_type(global: ir.HirGlobal) -> TypeId!:
        let module = self.program.modules[global.module.value]
        let lowered = self.lower_mir_type(global.value_type) catch feature:
            error(format_diagnostic(
                module.path,
                global.span,
                "lowerer does not support " + feature + " yet in runtime global `" + module.name + "." + global.name + "`",
            ))
        return lowered

    # The one scalar mapping shared by ordinary values and external-global
    # declarations. This is semantic width, not target ABI placement.
    func scalar_mir_type(value: ir.TypeId) -> TypeId?:
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i8)): return builtin_mir_type(BuiltinMirType.signed_i8)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i16)): return builtin_mir_type(BuiltinMirType.signed_i16)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i32)): return builtin_mir_type(BuiltinMirType.signed_i32)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i64)): return builtin_mir_type(BuiltinMirType.signed_i64)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u8)): return builtin_mir_type(BuiltinMirType.unsigned_u8)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u16)): return builtin_mir_type(BuiltinMirType.unsigned_u16)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u32)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u64)): return builtin_mir_type(BuiltinMirType.unsigned_u64)
        if types_match(value, resolve_builtin_type(BuiltinType.float32)): return builtin_mir_type(BuiltinMirType.float32)
        if types_match(value, resolve_builtin_type(BuiltinType.float64)): return builtin_mir_type(BuiltinMirType.float64)
        if types_match(value, resolve_builtin_type(BuiltinType.boolean)): return builtin_mir_type(BuiltinMirType.boolean)
        if types_match(value, resolve_builtin_type(BuiltinType.character)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        return none

    func external_global_type(value: ir.TypeId) -> TypeId:
        let scalar = self.scalar_mir_type(value)
        if scalar != none: return scalar
        match self.program.types.definitions[value.value].form:
            Extern(index):
                match self.program.extern_types[index].representation:
                    Pointer: return builtin_mir_type(BuiltinMirType.pointer)
                    Integer(representation):
                        let lowered = self.scalar_mir_type(representation)
                        if lowered != none: return lowered
            else: pass
        trap("HIR admitted an unsupported external-global type")

    # The raw C slot type differs from the ordinary MIR value type only for a
    # nullable pointer handle: its tagged optional is encoded as one pointer
    # at the call boundary. This is target-independent shape translation, not
    # ABI placement.
    func c_boundary_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: ir.TypeId) -> TypeId!:
        if self.optional_pointer_handle(value) != none: return builtin_mir_type(BuiltinMirType.pointer)
        return try self.mir_type_of(module, function, span, value)

    func is_pointer_handle(value: ir.TypeId) -> bool:
        match self.program.types.definitions[value.value].form:
            Extern(index):
                match self.program.extern_types[index].representation:
                    Pointer: return true
                    Integer(representation): return false
            else: return false

    func optional_pointer_handle(value: ir.TypeId) -> ir.TypeId?:
        match self.program.types.definitions[value.value].form:
            Optional(inner):
                if self.is_pointer_handle(inner): return inner
                return none
            else: return none

    # `str` and `bytes` share one shape: a pointer to the bytes and their count.
    func byte_string_type() -> TypeId:
        let fields = [builtin_mir_type(BuiltinMirType.pointer), builtin_mir_type(BuiltinMirType.unsigned_u64)]
        return self.intern_lowered_type(make_struct_type(fields))

    func fallible_inner(value: ir.TypeId) -> ir.TypeId?:
        if i64(value.value) >= len(self.program.types.definitions): return none
        match self.program.types.definitions[value.value].form:
            Fallible(inner): return inner
            else: return none

    # mark: Diagnostics =========================================================================

    # Fail at the unsupported node while still naming its enclosing function.
    # Example: a binding on line 2 reports line 2, not the function's line 1.
    func fail_unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> !:
        error(self.unsupported(module, function, span, feature))

    func unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> str:
        return format_diagnostic(
            module.path,
            span,
            "lowerer does not support " + feature + " yet in `" + module.name + "." + function.name + "`",
        )
