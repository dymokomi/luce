#==============================================================================================
#
#   lowerer - Typed HIR into canonical MIR
#
#   DESCRIPTION:
#       Coordinates one analyzed program lowering transaction. It declares all
#       callable, C, global, runtime, and generated-helper identities before
#       publishing a MirProgram, while FunctionLowerer owns the mutually
#       recursive walk of each function body.
#
#       Lowering runs once. The resulting canonical MIR is identical for every
#       backend; target layout, ABI, linking, and host-tool concerns begin only
#       behind the backend boundary.
#
#==============================================================================================

from compiler.hir.analyzer import AnalyzedProgram
from compiler.hir.ir import HirFunctionImplementation
from compiler.mir.canonical import FunctionId, MirFunction, MirGlobal, MirProgram
from compiler.mir.function_lowerer import FunctionLowerer
from compiler.mir.lowering_model import CWrapper, LoweredFunction, MirLoweringState, contains_symbol

## Turns one semantically analyzed typed-HIR program into canonical MIR.
pub class Lowerer:
    let state: MirLoweringState
    let functions: FunctionLowerer

    ## Prepare one shared transaction; lower walks it exactly once.
    pub init(program: AnalyzedProgram):
        let state = MirLoweringState(program.hir, program.borrowed_receiver_methods)
        self.state = state
        self.functions = FunctionLowerer(state)

    # mark: Program lowering ====================================================================

    ## Declare every program identity before lowering bodies and publish one
    ## verified-shape canonical program for every backend.
    pub func lower() -> MirProgram!:
        var next_definition: u32 = 0
        let callback_symbols = self.state.c_wrapper_symbols()
        for function in self.state.program.functions:
            match function.implementation:
                ExternalC(contract):
                    let module = self.state.program.modules[function.module.value]
                    let signature = try self.state.lower_external_signature(module, function, contract)
                    let external = try self.state.declare_c_extern(function, contract, signature)
                    self.state.lowered_functions.append(LoweredFunction.External(external = external))
                    self.state.c_wrappers.append(CWrapper.Absent)
                ExportedC(body):
                    self.state.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    self.state.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition + 1)))
                    next_definition += 2
                Defined(body):
                    self.state.lowered_functions.append(LoweredFunction.Defined(function = FunctionId(value = next_definition)))
                    next_definition += 1
                    if contains_symbol(callback_symbols, function.symbol):
                        self.state.c_wrappers.append(CWrapper.Present(function = FunctionId(value = next_definition)))
                        next_definition += 1
                    else:
                        self.state.c_wrappers.append(CWrapper.Absent)

        # Every class owns one exact lifecycle callback. Reserve these after
        # source callables but before lazily discovered structural ownership
        # helpers so all generated FunctionIds remain stable while bodies lower.
        for class_value in self.state.program.classes:
            self.state.class_destroyers.append(FunctionId(value = next_definition))
            next_definition += 1
        self.state.next_generated_function = next_definition
        try self.state.lower_classes()

        # C objects share the linker namespace with C functions. Equal
        # declarations in several raw modules share one canonical identity.
        for variable in self.state.program.extern_variables:
            self.state.lowered_external_globals.append(try self.state.declare_external_global(variable))
        for global in self.state.program.globals:
            self.state.globals.append(MirGlobal(
                name = self.state.program.modules[global.module.value].name + "." + global.name,
                value_type = try self.state.global_mir_type(global),
                initial = none,
                is_mutable = true,
            ))

        let functions = list[MirFunction]()
        for function in self.state.program.functions:
            match function.implementation:
                ExternalC(contract): pass
                ExportedC(body):
                    let module = self.state.program.modules[function.module.value]
                    functions.append(try self.functions.lower_function(module, function))
                    functions.append(try self.functions.lower_c_wrapper(module, function, true))
                Defined(body):
                    let module = self.state.program.modules[function.module.value]
                    functions.append(try self.functions.lower_function(module, function))
                    match self.state.c_wrappers[self.state.function_index_of(function.symbol)]:
                        Present(wrapper): functions.append(try self.functions.lower_c_wrapper(module, function, false))
                        Absent: pass

        for class_index in range(0, len(self.state.program.classes)):
            let destroyer = self.state.class_destroyers[class_index]
            if len(functions) != i64(destroyer.value): trap("class destroyer function identities lost declaration order")
            functions.append(self.functions.lower_class_destroyer(class_index, destroyer))

        # Helper identities are reserved lazily while bodies lower. Generate
        # them in reservation order; recursive value shapes may reserve more
        # helpers while an earlier pair is emitted.
        var helper_index = 0
        while helper_index < len(self.state.ownership_helpers):
            let helper = self.state.ownership_helpers[helper_index]
            if len(functions) != i64(helper.retain.value): trap("ownership helper function identities lost declaration order")
            functions.append(self.functions.lower_ownership_helper(helper.value_type, true, helper.retain))
            functions.append(self.functions.lower_ownership_helper(helper.value_type, false, helper.release))
            helper_index += 1

        return MirProgram(
            types = self.state.types,
            classes = self.state.classes,
            runtime_bindings = self.state.lower_runtime_bindings(),
            externs = self.state.externs,
            external_globals = self.state.external_globals,
            globals = self.state.globals,
            data = self.state.data,
            functions = functions,
            entry = self.state.find_entry(functions),
        )
