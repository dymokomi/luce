from compiler.tokenizer import SourceSpan

# The first semantic representation. Every reference is a symbol identity and
# every expression has a concrete type; source spelling remains in syntax.luc.

struct SymbolId:
    value: i64

struct ValueType:
    name: str

# Values already decoded by semantic lowering. The interpreter never needs to
# understand source spelling.
union Value:
    Unit
    Boolean(value: bool)
    Integer(value: i64)
    Floating(value: f64)

struct TypedArgument:
    parameter_index: i64
    value: TypedExpression

class TypedExpression:
    value_type: ValueType
    form: TypedExpressionForm
    span: SourceSpan

    init(value_type: ValueType, form: TypedExpressionForm, span: SourceSpan):
        self.value_type = value_type
        self.form = form
        self.span = span

union TypedExpressionForm:
    Constant(value: Value)
    Reference(symbol: SymbolId)
    Unary(operator: str, operand: TypedExpression)
    Binary(left: TypedExpression, operator: str, right: TypedExpression)
    Conditional(value: TypedExpression, condition: TypedExpression, alternative: TypedExpression)
    Call(function: SymbolId, arguments: list[TypedArgument])

struct TypedIfBranch:
    condition: TypedExpression
    body: list[TypedStatement]

class TypedStatement:
    form: TypedStatementForm
    span: SourceSpan

    init(form: TypedStatementForm, span: SourceSpan):
        self.form = form
        self.span = span

union TypedStatementForm:
    BreakStatement
    ContinueStatement
    Binding(symbol: SymbolId, name: str, is_mutable: bool, value: TypedExpression)
    Assignment(symbol: SymbolId, operator: str, value: TypedExpression)
    ReturnStatement(value: TypedExpression?)
    ExpressionStatement(value: TypedExpression)
    IfStatement(branches: list[TypedIfBranch], fallback: list[TypedStatement]?)
    WhileStatement(condition: TypedExpression, body: list[TypedStatement])

struct TypedParameter:
    symbol: SymbolId
    name: str
    value_type: ValueType

struct TypedFunction:
    symbol: SymbolId
    name: str
    is_public: bool
    parameters: list[TypedParameter]
    result: ValueType
    body: list[TypedStatement]
    span: SourceSpan

struct TypedModule:
    name: str
    path: str
    functions: list[TypedFunction]

struct TypedProgram:
    modules: list[TypedModule]
