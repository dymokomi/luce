#==============================================================================================
#
#   typed_ir - The first semantic representation
#
#   DESCRIPTION:
#       What the checker proved. Every reference is a symbol identity and every
#       expression carries a concrete type; source spelling stays behind in
#       syntax.luc. Backends read these shapes and never look at source again.
#
#       The file follows the program from broadest piece to smallest:
#
#       program -> modules -> functions -> statements -> expressions -> values
#
#       Like the source tree, the recursive node families are classes holding one
#       tagged `Form` union; leaf records stay plain value structs.
#
#==============================================================================================

from compiler.tokenizer import SourceSpan

# mark: Program shape =========================================================================

## One fully checked program, ready for a backend.
pub struct TypedProgram:
    pub modules: list[TypedModule]

## One checked module and the file it came from; the path feeds diagnostics.
pub struct TypedModule:
    pub name: str
    pub path: str
    pub functions: list[TypedFunction]

## One checked function: resolved signature, effects, and body.
pub struct TypedFunction:
    pub symbol: SymbolId
    pub name: str
    pub is_public: bool
    pub parameters: list[TypedParameter]
    pub result: ValueType
    pub effects: list[str]
    pub body: list[TypedStatement]
    pub span: SourceSpan

# `value: i64` after checking — the name survives only for diagnostics; code
# refers to the parameter by its symbol.
pub struct TypedParameter:
    pub symbol: SymbolId
    pub name: str
    pub value_type: ValueType

# mark: Statements ============================================================================

## One checked statement; the span points back at its source for diagnostics.
pub class TypedStatement:
    pub form: TypedStatementForm
    pub span: SourceSpan

    pub init(form: TypedStatementForm, span: SourceSpan):
        self.form = form
        self.span = span

# The tagged form held by one `TypedStatement` node. `PrintText` is its own
# form because `print` is the first terminal operation in the executable
# slice — the constant bytes are already decoded here.
pub union TypedStatementForm:
    BreakStatement
    ContinueStatement
    Binding(symbol: SymbolId, name: str, is_mutable: bool, value: TypedExpression)
    Assignment(symbol: SymbolId, operator: str, value: TypedExpression)
    PrintText(value: str)
    ReturnStatement(value: TypedExpression?)
    ExpressionStatement(value: TypedExpression)
    IfStatement(branches: list[TypedIfBranch], fallback: list[TypedStatement]?)
    WhileStatement(condition: TypedExpression, body: list[TypedStatement])

# One `if` or `elif` arm: a bool condition and the statements it guards.
pub struct TypedIfBranch:
    pub condition: TypedExpression
    pub body: list[TypedStatement]

# mark: Expressions ===========================================================================

## One checked expression; its type is settled, never inferred again.
pub class TypedExpression:
    pub value_type: ValueType
    pub form: TypedExpressionForm
    pub span: SourceSpan

    pub init(value_type: ValueType, form: TypedExpressionForm, span: SourceSpan):
        self.value_type = value_type
        self.form = form
        self.span = span

# The tagged form held by one `TypedExpression` node.
pub union TypedExpressionForm:
    Constant(value: Value)
    Reference(symbol: SymbolId)
    Unary(operator: str, operand: TypedExpression)
    Binary(left: TypedExpression, operator: str, right: TypedExpression)
    Conditional(value: TypedExpression, condition: TypedExpression, alternative: TypedExpression)
    Call(function: SymbolId, arguments: list[TypedArgument])

# One call argument, already matched to its parameter slot — named and
# positional spelling are indistinguishable after checking.
pub struct TypedArgument:
    pub parameter_index: i64
    pub value: TypedExpression

# mark: Values and symbols ====================================================================

## Values already decoded by semantic checking. The interpreter never needs to
## understand source spelling.
pub union Value:
    Unit
    Boolean(value: bool)
    Integer(value: i64)
    Floating(value: f64)

    # The value as the command line prints it.
    pub func text() -> str:
        match self:
            Unit: return "unit"
            Boolean(item): return str(item)
            Integer(item): return str(item)
            Floating(item): return str(item)

## The identity of one binding or function, unique across the whole program.
pub struct SymbolId:
    pub value: i64

## A concrete type by name, e.g. `i64` or `bool`. Structured types will grow
## richer shapes here; the current slice only needs the name.
pub struct ValueType:
    pub name: str
