from compiler.tokenizer import SourceSpan

# The first semantic representation. Every reference is a symbol identity and
# every expression has a concrete type; source spelling remains in syntax.luc.

pub struct SymbolId:
    pub value: i64

pub struct ValueType:
    pub name: str

# Values already decoded by semantic lowering. The interpreter never needs to
# understand source spelling.
pub union Value:
    Unit
    Boolean(value: bool)
    Integer(value: i64)
    Floating(value: f64)

pub struct TypedArgument:
    pub parameter_index: i64
    pub value: TypedExpression

pub class TypedExpression:
    pub value_type: ValueType
    pub form: TypedExpressionForm
    pub span: SourceSpan

    pub init(value_type: ValueType, form: TypedExpressionForm, span: SourceSpan):
        self.value_type = value_type
        self.form = form
        self.span = span

pub union TypedExpressionForm:
    Constant(value: Value)
    Reference(symbol: SymbolId)
    Unary(operator: str, operand: TypedExpression)
    Binary(left: TypedExpression, operator: str, right: TypedExpression)
    Conditional(value: TypedExpression, condition: TypedExpression, alternative: TypedExpression)
    Call(function: SymbolId, arguments: list[TypedArgument])

pub struct TypedIfBranch:
    pub condition: TypedExpression
    pub body: list[TypedStatement]

pub class TypedStatement:
    pub form: TypedStatementForm
    pub span: SourceSpan

    pub init(form: TypedStatementForm, span: SourceSpan):
        self.form = form
        self.span = span

pub union TypedStatementForm:
    BreakStatement
    ContinueStatement
    Binding(symbol: SymbolId, name: str, is_mutable: bool, value: TypedExpression)
    Assignment(symbol: SymbolId, operator: str, value: TypedExpression)
    PrintText(value: str)
    ReturnStatement(value: TypedExpression?)
    ExpressionStatement(value: TypedExpression)
    IfStatement(branches: list[TypedIfBranch], fallback: list[TypedStatement]?)
    WhileStatement(condition: TypedExpression, body: list[TypedStatement])

pub struct TypedParameter:
    pub symbol: SymbolId
    pub name: str
    pub value_type: ValueType

pub struct TypedFunction:
    pub symbol: SymbolId
    pub name: str
    pub is_public: bool
    pub parameters: list[TypedParameter]
    pub result: ValueType
    pub effects: list[str]
    pub body: list[TypedStatement]
    pub span: SourceSpan

pub struct TypedModule:
    pub name: str
    pub path: str
    pub functions: list[TypedFunction]

pub struct TypedProgram:
    pub modules: list[TypedModule]
