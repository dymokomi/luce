#==============================================================================================
#
#   symbol_attributes - The closed set of words a Base declaration may carry
#
#   DESCRIPTION:
#       Base's declaration attributes (base.md §9.8) are facts about one
#       symbol that only the linker or the code generator can act on:
#       an inlining hint, coldness, a naked body, weak linkage, retention,
#       and a linker section. They are neither a type fact nor a target
#       fact, so the syntax tree, HIR, and MIR carry them in this one shape
#       and each backend reads the ones it can honour.
#
#==============================================================================================

## `inline` and `noinline`; an implementation without an inliner ignores both.
pub enum InlineHint:
    unspecified
    inline
    noinline

pub struct SymbolAttributes:
    pub let inlining: InlineHint = InlineHint.unspecified
    ## `cold`: rarely executed.
    pub let is_cold: bool = false
    ## `naked`: no prologue or epilogue; the body is one `asm` block.
    pub let is_naked: bool = false
    ## `weak`: another definition may override this symbol.
    pub let is_weak: bool = false
    ## `used`: keep the symbol even when nothing references it.
    pub let is_used: bool = false
    ## `section("name")`: the linker section that holds the symbol.
    pub let section: str? = none

    ## True when any word was written.
    pub func is_present() -> bool:
        return self.inlining != InlineHint.unspecified or self.is_cold or self.is_naked or self.is_weak or self.is_used or self.section != none

pub func attributes_match(left: SymbolAttributes, right: SymbolAttributes) -> bool:
    if left.inlining != right.inlining or left.is_cold != right.is_cold or left.is_naked != right.is_naked: return false
    if left.is_weak != right.is_weak or left.is_used != right.is_used: return false
    let left_section = left.section else ""
    let right_section = right.section else ""
    return left_section == right_section and (left.section == none) == (right.section == none)
