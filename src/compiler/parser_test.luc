from compiler.parser import Parser
from compiler.syntax import ExpressionSyntax, FunctionSyntax, ModuleSyntax
from compiler.syntax import StatementSyntax, SuiteStyle, SuiteSyntax
from compiler.tokenizer import Tokenizer

# Stage-0 discovers zero-argument `test_*` functions. Fixtures use epoch-1
# source, so this test-local adapter tokenizes them before exercising the parser.

# mark: Test helpers ---------------------------------------------------------

func parse_source(source: str) -> ModuleSyntax!:
    let tokens = try Tokenizer(source).tokenize()
    return try Parser(tokens).parse()

func parsed(source: str) -> ModuleSyntax:
    let module = parse_source(source) catch reason:
        trap(reason)
    return module

func failure(source: str) -> str:
    let module = parse_source(source) catch reason:
        return reason
    return ""

func parses(source: str) -> bool:
    return len(failure(source)) == 0

func function_body(function_value: FunctionSyntax) -> SuiteSyntax:
    return function_value.body else trap("expected a function body")

func first_function(module: ModuleSyntax) -> FunctionSyntax:
    match module.declarations[0].value:
        function(value): return value
        else: trap("expected the first declaration to be a function")

func binding_expression(statement: StatementSyntax) -> ExpressionSyntax:
    match statement.form:
        binding(is_mutable, pattern, annotation, value, span): return value
        else: trap("expected a binding statement")


# mark: Modules and declarations --------------------------------------------

func test_empty_module_has_an_empty_source_span():
    let module = parsed("")
    assert(len(module.imports) == 0)
    assert(len(module.declarations) == 0)
    assert(module.span.start == 0)
    assert(module.span.end == 0)

func test_imports_precede_declarations_and_preserve_paths():
    let source = "import compiler.syntax\nimport platform.files as files\nlet answer = 42\n"
    let module = parsed(source)
    assert(len(module.imports) == 2)
    assert(len(module.imports[0].path.parts) == 2)
    assert(module.imports[0].path.parts[1] == "syntax")
    assert(module.imports[0].alias_name == none)
    assert((module.imports[1].alias_name else "") == "files")
    assert(len(module.declarations) == 1)
    assert(module.span.end == len(source))

func test_documentation_visibility_and_inline_function_body_are_preserved():
    let source = "## Return the input.\n## This stays Markdown.\npublic func identity(value: i64) -> i64: return value\n"
    let module = parsed(source)
    let declaration = module.declarations[0]
    assert(declaration.is_public)
    assert(len(declaration.documentation) == 2)
    assert(declaration.documentation[0] == "Return the input.")
    assert(declaration.span.line == 3)
    let function_value = first_function(module)
    let body = function_body(function_value)
    assert(function_value.name == "identity")
    assert(len(function_value.parameters) == 1)
    assert(body.style == SuiteStyle.inline_suite)
    assert(str(body.statements[0].form) == "return_statement")

func test_constants_and_type_aliases_have_distinct_declarations():
    let module = parsed("let maximum: u64 = 100\ntype Identifier = u64\n")
    assert(str(module.declarations[0].value) == "constant")
    assert(str(module.declarations[1].value) == "type_alias")
    match module.declarations[0].value:
        constant(value):
            assert(value.name == "maximum")
            assert(value.annotation != none)
            assert(str(value.value.form) == "literal")
        else: assert(false)

func test_struct_and_class_members_keep_generics_fields_and_methods():
    let source = "struct Box[T: Equatable] implements Drawable:\n    ## Stored item.\n    public let value: T\n    mutating func replace(self, next: T): self.value = next\nclass Node:\n    weak var parent: Node? = none\n    func init(self): return\n"
    let module = parsed(source)
    assert(len(module.declarations) == 2)
    match module.declarations[0].value:
        nominal_type(value):
            assert(value.name == "Box")
            assert(len(value.generic_parameters) == 1)
            assert(len(value.generic_parameters[0].constraints) == 1)
            assert(len(value.interfaces) == 1)
            assert(len(value.members) == 2)
            assert(value.members[0].documentation[0] == "Stored item.")
        else: assert(false)
    match module.declarations[1].value:
        nominal_type(value):
            assert(value.name == "Node")
            assert(len(value.members) == 2)
        else: assert(false)

func test_enum_cases_payloads_and_interface_signatures_parse():
    let source = "enum Shape:\n    ## A circle.\n    circle(radius: f64)\n    point\n    func area(self) -> f64: return 0.0\ninterface Reader[T]:\n    ## Read bytes.\n    func read(self, count: u64) -> bytes! uses files\n"
    let module = parsed(source)
    match module.declarations[0].value:
        enumeration(value):
            assert(len(value.cases) == 2)
            assert(value.cases[0].documentation[0] == "A circle.")
            assert(len(value.cases[0].payload) == 1)
            assert(value.cases[0].payload[0].name == "radius")
            assert(len(value.methods) == 1)
        else: assert(false)
    match module.declarations[1].value:
        interface_type(value):
            assert(value.name == "Reader")
            assert(len(value.methods) == 1)
        else: assert(false)

func test_tests_and_all_export_c_forms_parse():
    let source = "test \"round trip\" uses files: return\nexport c struct Pixel:\n    public let red: u8\n    let green: u8\nexport c enum Status as u32:\n    ready = 1\n    stopped = 2\nexport c func add(left: i64, right: i64) -> i64: return left + right\n"
    let module = parsed(source)
    assert(len(module.declarations) == 4)
    assert(str(module.declarations[0].value) == "test_declaration")
    assert(str(module.declarations[1].value) == "export_struct")
    assert(str(module.declarations[2].value) == "export_enum")
    assert(str(module.declarations[3].value) == "export_function")
    match module.declarations[2].value:
        export_enum(value):
            assert(value.representation == "u32")
            assert(len(value.cases) == 2)
        else: assert(false)

func test_exported_functions_keep_the_narrow_c_surface():
    assert(not parses("export c func identity[T](value: T) -> T: return value\n"))
    assert(not parses("export c func load(path: str) -> bytes uses files: return none\n"))


# mark: Statements and suites -----------------------------------------------

func test_indented_function_body_preserves_simple_statement_kinds():
    let source = "func statements(value: i64):\n    let copy = value\n    var current: i64 = copy\n    current += 1\n    defer cleanup()\n    recover current\n    consume(current)\n    return current\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 7)
    assert(str(statements[0].form) == "binding")
    assert(str(statements[1].form) == "binding")
    assert(str(statements[2].form) == "assignment")
    assert(str(statements[3].form) == "defer_statement")
    assert(str(statements[4].form) == "recover_statement")
    assert(str(statements[5].form) == "expression_statement")
    assert(str(statements[6].form) == "return_statement")

func test_control_flow_statements_and_conditional_binding_parse():
    let source = "func control(optional: i64?, items: list[i64]):\n    if let value = optional:\n        return value\n    else: return 0\n    while ready: break\n    for item in items:\n        if item > 5: continue\n    match status:\n        .ready: return 1\n        _: return 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 4)
    assert(str(statements[0].form) == "if_statement")
    assert(str(statements[1].form) == "while_statement")
    assert(str(statements[2].form) == "for_statement")
    assert(str(statements[3].form) == "match_statement")


# mark: Types and expressions ------------------------------------------------

func test_function_tuple_optional_and_fallible_types_parse():
    let source = "type Pair = (i64, str)\ntype Callback = func(i64, list[Point?]) -> bytes! uses files\n"
    let module = parsed(source)
    assert(len(module.declarations) == 2)

func test_binary_operator_precedence_builds_the_expected_tree():
    let module = parsed("let value = 1 + 2 * 3 == 7 and true or false\n")
    match module.declarations[0].value:
        constant(constant_value):
            match constant_value.value.form:
                binary(or_left, or_operator, or_right, or_span):
                    assert(or_operator == "or")
                    match or_left.form:
                        binary(and_left, and_operator, and_right, and_span):
                            assert(and_operator == "and")
                            match and_left.form:
                                binary(compare_left, compare_operator, compare_right, compare_span):
                                    assert(compare_operator == "==")
                                    match compare_left.form:
                                        binary(add_left, add_operator, add_right, add_span):
                                            assert(add_operator == "+")
                                            assert(str(add_right.form) == "binary")
                                        else: assert(false)
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

func test_postfix_calls_distinguish_generic_arguments_from_indexing():
    let source = "func use(callbacks: list[Callback], index: u64):\n    let decoded = decode[Header](callbacks[index])\n    let invoked = callbacks[index](decoded)\n    let range = callbacks[1..<index]\n    let prefix = callbacks[..<index]\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        call(callee, type_arguments, arguments, call_span):
            assert(len(type_arguments) == 1)
            assert(len(arguments) == 1)
        else: assert(false)
    match binding_expression(statements[1]).form:
        call(callee, type_arguments, arguments, call_span):
            assert(len(type_arguments) == 0)
            assert(str(callee.form) == "index")
        else: assert(false)
    assert(str(binding_expression(statements[2]).form) == "slice")
    assert(str(binding_expression(statements[3]).form) == "slice")

func test_index_bounds_accept_full_expressions_and_inclusive_suffixes():
    let source = "func select(items: list[i64], index: u64):\n    let compared = items[index < limit]\n    let chosen = items[index if ready else limit]\n    let suffix = items[index..]\n"
    assert(parses(source))
    assert(not parses("func invalid(items: list[i64]): return items[1..2]\n"))
    assert(not parses("func invalid(items: list[i64]): return items[..]\n"))

func test_lambdas_keep_inferred_and_explicit_parameter_types():
    let source = "func predicates():\n    let inferred = (value) => value > 5\n    let typed = (left: i64, right: i64) => left < right\n    let empty = () => true\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        lambda(parameters, body, lambda_span):
            assert(len(parameters) == 1)
            assert(parameters[0].annotation == none)
        else: assert(false)
    match binding_expression(statements[1]).form:
        lambda(parameters, body, lambda_span):
            assert(len(parameters) == 2)
            assert(parameters[0].annotation != none)
        else: assert(false)
    match binding_expression(statements[2]).form:
        lambda(parameters, body, lambda_span): assert(len(parameters) == 0)
        else: assert(false)

func test_closure_captures_and_catch_handlers_are_source_nodes():
    let source = "func build(count: i64, owner: Owner):\n    let callback = func [copy snapshot = count, weak owner] (value: i64) -> i64:\n        return value + snapshot\n    let loaded = try load() catch failure:\n        recover none\n    return loaded\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        closure(captures, parameters, result, effects, body, closure_span):
            assert(len(captures) == 2)
            assert(captures[0].name == "snapshot")
            assert(captures[1].is_weak)
        else: assert(false)
    assert(str(binding_expression(statements[1]).form) == "catch_value")

func test_match_expression_uses_value_arms_and_match_statement_uses_suites():
    let source = "func digit(c: char) -> i64:\n    let value = match c:\n        '0' => 0\n        _ => 1\n    match value:\n        0: return 0\n        _: return value\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        match_value(subject, arms, match_span): assert(len(arms) == 2)
        else: assert(false)
    assert(str(statements[1].form) == "match_statement")

func test_block_expression_ends_before_a_following_if_statement():
    let source = "func classify(value: i64) -> i64:\n    let result = match value:\n        0 => 0\n        _ => 1\n    if value > 0: return result\n    return -1\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 3)
    assert(str(statements[0].form) == "binding")
    assert(str(statements[1].form) == "if_statement")
    assert(str(statements[2].form) == "return_statement")

func test_primary_and_conditional_expression_families_parse():
    let source = "func values(index: u64):\n    let tuple = (1, 2)\n    let list_value = [1, 2]\n    let map_value = {\"one\": 1}\n    let case_value = .ready(index: index)\n    let object = new Widget(value: index)\n    let task_value = spawn workers.render(index)\n    return -index if index > 0 else 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(str(binding_expression(statements[0]).form) == "tuple_value")
    assert(str(binding_expression(statements[1]).form) == "list_value")
    assert(str(binding_expression(statements[2]).form) == "map_value")
    assert(str(binding_expression(statements[3]).form) == "case_value")
    assert(str(binding_expression(statements[4]).form) == "new_value")
    assert(str(binding_expression(statements[5]).form) == "spawn_value")
    match statements[6].form:
        return_statement(value, span):
            let returned = value else trap("expected a return value")
            assert(str(returned.form) == "conditional")
        else: assert(false)


# mark: Rejected syntax and diagnostics -------------------------------------

func test_imports_must_form_the_leading_module_prefix():
    assert(not parses("let value = 1\nimport later.module\n"))
    assert(not parses("var global = 1\n"))

func test_documentation_must_be_consecutive_and_touch_a_declaration():
    assert(parses("## Summary.\nlet value = 1\n"))
    assert(not parses("## First.\n\n## Second.\nlet value = 1\n"))
    assert(not parses("## Detached.\n\nlet value = 1\n"))
    assert(not parses("func run():\n    ## Not a local declaration.\n    return\n"))

func test_empty_declaration_bodies_and_interface_fields_are_rejected():
    assert(not parses("struct Empty:\n"))
    assert(not parses("enum Empty:\n"))
    assert(not parses("interface Empty:\n"))
    assert(not parses("interface Invalid:\n    let value: i64\n"))
    assert(not parses("interface Invalid:\n    public func value(self) -> i64\n"))

func test_parameter_tuple_and_lambda_shapes_follow_the_grammar():
    assert(not parses("func missing_type(value): return\n"))
    assert(not parses("func invalid(self = other): return\n"))
    assert(not parses("type Empty = list[]\n"))
    assert(not parses("let one = (1,)\n"))
    assert(not parses("let invalid = (value = 5) => value\n"))

func test_conditional_binding_and_same_line_suite_restrictions_are_enforced():
    assert(not parses("func invalid(optional: i64?):\n    if let value = optional: return value\n    elif retry: return 0\n"))
    assert(not parses("func invalid(ready: bool): if ready: return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: let callback = func(): return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: return match value:\n        _ => 0\n"))

func test_match_arrows_distinguish_values_from_statement_suites():
    assert(parses("let value = match c:\n    '0' => 0\n    _ => 1\n"))
    assert(not parses("let value = match c:\n    '0': return 0\n"))
    assert(parses("func run(c: char):\n    match c:\n        '0': return\n"))
    assert(not parses("func run(c: char):\n    match c:\n        '0' => 0\n"))

func test_comparison_and_range_operators_cannot_chain():
    assert(not parses("let value = first < second < third\n"))
    assert(not parses("let value = first ..< second ..= third\n"))
    assert(parses("let value = first is not second\n"))

func test_assignment_requires_a_named_member_or_index_target():
    assert(parses("func set(self, index: u64): self.items[index].ready = true\n"))
    assert(not parses("func invalid(): (left + right) = value\n"))
    assert(not parses("func invalid(): call() = value\n"))
    assert(not parses("func invalid(items: list[i64]): items[..<2] = []\n"))

func test_parser_diagnostics_report_the_first_token_position():
    assert(failure("let value =\n") == "parser:1:12: expected an expression")
    assert(failure("public test \"no\": return\n") == "parser:1:1: a test declaration cannot be public")
