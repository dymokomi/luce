#==============================================================================================
#
#   lowerer - Typed HIR into canonical MIR
#
#   DESCRIPTION:
#       Turns analyzed typed-HIR trees into canonical MIR: every value lands
#       in a fresh write-once register, every local lives in a stack slot
#       reached through `Load`/`Store`, terminal output becomes a data item
#       plus a call to the `luce_rt_write` runtime service, and a function's
#       result is an explicit `Return`. Public use begins at `Lowerer.lower`;
#       the walk goes program -> function -> statement -> expression, and
#       anything outside the executable slice fails with a clear
#       "does not support ... yet".
#
#       The compiled slice today: every scalar type (all integer widths,
#       `f32`/`f64`, `bool`, `char`), `let`/`var` locals with plain and
#       compound assignment, every unary and binary operator including
#       short-circuit `and`/`or` and the conditional expression, `if`/`elif`/
#       `else`, `while` with `break` and `continue`, functions with scalar
#       parameters and direct calls between them across modules, module
#       constants, constant terminal output, and returning. The slice
#       boundary lives here, not in canonical MIR — aggregate types, strings,
#       optionals, and failure all reach the lowerer as HIR and stop with
#       "does not support ... yet" until this file emits the instructions
#       for them. `main(arguments: slice[str])` is the 1.0 entry signature
#       (docs/language/1.0.md §23); its argument is dropped until slices
#       exist, so the MIR entry is `() -> i32`.
#
#       Parameters are the leading registers of a function (`r0..rN-1`), as
#       canonical MIR requires; a parameter is immutable in Luce, so a
#       reference to it is the register itself. A module constant is a scalar
#       literal tree today and is lowered inline at each use; once constants
#       can hold aggregates, a `MirGlobal` becomes the right home.
#
#       Locals take the simple form on purpose: one `Alloca` per binding in
#       the prologue, a `Store` at the binding, a `Load` at every use. An
#       optimizer may promote them to registers later; correctness comes
#       first (docs/compiler/mir.md, "Registers").
#
#       Control flow keeps the source's shape. An `if` chain is nested `If`
#       regions; a `while` is a `Block` around a `Loop`: the loop tests its
#       condition and branches out of the block when it fails, `continue`
#       branches back to the loop, `break` branches out of the block. Branch
#       depths count every region between the branch and its target, so the
#       lowerer keeps a stack of the regions it is inside.
#
#       Lowering happens for one `TargetLayout`: aggregate layouts are fixed
#       here, which is why `build` chooses a target before this stage runs.
#
#==============================================================================================

from compiler.canonical_ir import BinaryOp, BuiltinMirType, CallingConvention, DataId, ExternId, FunctionId
from compiler.canonical_ir import InstructionForm, MirConstant, MirData, MirExtern, MirFunction, MirGlobal, MirInstruction
from compiler.canonical_ir import MirProgram, MirRelocation, MirSignature, MirSlot, MirTypeTable, RegisterId
from compiler.canonical_ir import TargetLayout, TypeId, UnaryOp, builtin_mir_type, create_builtin_mir_types
from compiler.canonical_ir import find_runtime_symbol, size_of
from compiler.hir import BinaryOperation, BuiltinType, HirArgument, HirConstant, HirExpression, HirFunction
from compiler.hir import HirIfBranch, HirModule, HirProgram, HirStatement, SymbolId, describe_type
from compiler.hir import resolve_builtin_type, types_match
import compiler.hir
from compiler.mir_verifier import terminates
from compiler.semantic_analyzer import AnalyzedProgram
from compiler.source import SourceSpan, format_diagnostic
import std.strings

# One local of the function being lowered: its HIR symbol and the register
# holding its slot address.
struct Local:
    symbol: i64
    address: RegisterId

# One MIR region the lowerer is currently inside, innermost last. `break`
# targets the block wrapped around a loop; `continue` targets the loop.
enum Region:
    block
    loop_body
    if_arm

## Turns one semantically analyzed typed-HIR program into canonical MIR.
pub class Lowerer:
    program: HirProgram
    layout: TargetLayout
    # Program-wide tables the lowered functions refer to by identity.
    types: MirTypeTable
    externs: list[MirExtern]
    data: list[MirData]
    # The register table, slots, live locals, and parameter registers of the
    # function being lowered.
    registers: list[TypeId]
    slots: list[MirSlot]
    locals: list[Local]
    parameters: list[Local]
    regions: list[Region]

    ## Prepare to lower one analyzed program for one target; `lower` walks it.
    pub init(program: AnalyzedProgram, layout: TargetLayout):
        self.program = program.hir
        self.layout = layout
        self.types = create_builtin_mir_types()
        self.externs = list[MirExtern]()
        self.data = list[MirData]()
        self.registers = list[TypeId]()
        self.slots = list[MirSlot]()
        self.locals = list[Local]()
        self.parameters = list[Local]()
        self.regions = list[Region]()

    # mark: Lowering ============================================================================

    ## Lower every function in every module, or stop at the first construct
    ## the executable slice cannot express yet.
    pub func lower() -> MirProgram!:
        let functions = list[MirFunction]()
        for function in self.program.functions:
            let module = self.program.modules[function.module.value]
            functions.append(try self.lower_function(module, function))
        # Bound to a local first: Stage-0 0.22 corrupts a sibling list when a
        # call returning `T?` is written directly as a struct-literal field.
        let entry = find_entry(functions)
        return MirProgram(
            layout = self.layout,
            types = self.types,
            externs = self.externs,
            globals = list[MirGlobal](),
            data = self.data,
            functions = functions,
            entry = entry,
        )

    # Lower one function body. The canonical name is `module.function` so
    # artifacts stay unambiguous across modules. `main` keeps the entry
    # signature from the header note above; every other function's parameters
    # become its leading registers.
    func lower_function(module: HirModule, function: HirFunction) -> MirFunction!:
        let string_slice = resolve_builtin_type(BuiltinType.string_slice)
        let is_entry = function.name == "main" and len(function.parameters) == 1 and types_match(function.parameters[0].value_type, string_slice)
        if function.name == "main" and not is_entry:
            try self.fail_unsupported(module, function, function.span, "entry parameters other than `(arguments: slice[str])`")

        self.registers = list[TypeId]()
        self.slots = list[MirSlot]()
        self.locals = list[Local]()
        self.parameters = list[Local]()
        self.regions = list[Region]()
        let parameter_types = list[TypeId]()
        if not is_entry:
            for parameter in function.parameters:
                let parameter_type = try self.mir_type_of(module, function, function.span, parameter.value_type)
                parameter_types.append(parameter_type)
                self.parameters.append(Local(symbol = parameter.symbol.value, address = self.new_register(parameter_type)))
        let results = list[TypeId]()
        let returns_unit = types_match(function.result, resolve_builtin_type(BuiltinType.unit))
        if not returns_unit:
            results.append(try self.mir_type_of(module, function, function.span, function.result))

        let body = list[MirInstruction]()
        try self.lower_prologue(module, function, function.body, body)
        for statement in function.body:
            try self.lower_statement(module, function, statement, body)
        # MIR ends every path with a syntactic terminator. A unit function may
        # simply finish, so it gets `Return []`. A value function whose body
        # does not end in a terminator has already been proved by HirGenerator
        # to return on every path (an `if` chain whose arms all return, say);
        # the trailing `Unreachable` records that proof for the verifier.
        if not terminates(body):
            if returns_unit:
                body.append(MirInstruction(form = InstructionForm.Return(values = list[RegisterId]()), span = function.span))
            else:
                body.append(MirInstruction(form = InstructionForm.Unreachable, span = function.span))
        return MirFunction(
            name = module.name + "." + function.name,
            convention = CallingConvention.luce,
            signature = MirSignature(parameters = parameter_types, results = results, is_fallible = false),
            registers = self.registers,
            slots = self.slots,
            body = body,
            is_public = function.is_public,
            span = function.span,
        )

    # Every binding in the body — at any nesting depth — gets its slot up
    # front, so the address registers exist before any statement runs and a
    # backend can size the frame from `slots` alone.
    func lower_prologue(module: HirModule, function: HirFunction, statements: list[HirStatement], body: list[MirInstruction]) -> !:
        for statement in statements:
            match statement.form:
                Binding(symbol, name, is_mutable, value):
                    let slot_type = try self.mir_type_of(module, function, statement.span, value.value_type)
                    let slot = len(self.slots)
                    self.slots.append(MirSlot(value_type = slot_type, align = size_of(self.types, self.layout, slot_type)))
                    let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
                    body.append(MirInstruction(form = InstructionForm.Alloca(result = address, slot = slot), span = statement.span))
                    self.locals.append(Local(symbol = symbol.value, address = address))
                IfStatement(branches, fallback):
                    for branch in branches:
                        try self.lower_prologue(module, function, branch.body, body)
                    if fallback != none:
                        try self.lower_prologue(module, function, fallback, body)
                WhileStatement(condition, loop_body):
                    try self.lower_prologue(module, function, loop_body, body)
                else: continue

    # Append the instructions for one HIR statement. For example, `return 7`
    # emits a constant into a fresh register and returns that register.
    func lower_statement(module: HirModule, function: HirFunction, statement: HirStatement, body: list[MirInstruction]) -> !:
        match statement.form:
            PrintText(value):
                try self.lower_print(value, statement.span, body)
            ReturnStatement(value):
                if value == none:
                    body.append(MirInstruction(form = InstructionForm.Return(values = list[RegisterId]()), span = statement.span))
                    return
                let returned = value
                let register = try self.lower_expression(module, function, returned, body)
                body.append(MirInstruction(form = InstructionForm.Return(values = [register]), span = statement.span))
            Binding(symbol, name, is_mutable, value):
                let local = try self.local_of(module, function, statement.span, symbol)
                let register = try self.lower_expression(module, function, value, body)
                let value_type = try self.mir_type_of(module, function, statement.span, value.value_type)
                body.append(MirInstruction(form = InstructionForm.Store(value_type = value_type, address = local.address, value = register), span = statement.span))
            Assignment(symbol, operation, value):
                let local = try self.local_of(module, function, statement.span, symbol)
                let value_type = try self.mir_type_of(module, function, statement.span, value.value_type)
                let register = try self.lower_expression(module, function, value, body)
                var stored = register
                match operation:
                    Replace: stored = register
                    Combine(binary):
                        let current = self.new_register(value_type)
                        body.append(MirInstruction(form = InstructionForm.Load(result = current, value_type = value_type, address = local.address), span = statement.span))
                        stored = try self.lower_binary_operation(module, function, statement.span, binary, value_type, current, register, body)
                body.append(MirInstruction(form = InstructionForm.Store(value_type = value_type, address = local.address, value = stored), span = statement.span))
            ExpressionStatement(value):
                let discarded = try self.lower_expression(module, function, value, body)
            IfStatement(branches, fallback):
                try self.lower_if(module, function, statement.span, branches, 0, fallback, body)
            WhileStatement(condition, loop_body):
                try self.lower_while(module, function, statement.span, condition, loop_body, body)
            BreakStatement:
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.loop_depth(module, function, statement.span) + 1, values = list[RegisterId]()), span = statement.span))
            ContinueStatement:
                body.append(MirInstruction(form = InstructionForm.Br(depth = try self.loop_depth(module, function, statement.span), values = list[RegisterId]()), span = statement.span))

    # mark: Control flow =======================================================================

    # `if a: ... elif b: ... else: ...` nests: branch `index` is one `If`
    # whose else-arm holds the next branch, and the last else-arm is the
    # fallback. Each arm is its own region, so registers defined inside stay
    # inside; locals reach across through their slots.
    func lower_if(module: HirModule, function: HirFunction, span: SourceSpan, branches: list[HirIfBranch], index: i64, fallback: list[HirStatement]?, body: list[MirInstruction]) -> !:
        let branch = branches[index]
        let condition = try self.lower_expression(module, function, branch.condition, body)
        let then_body = list[MirInstruction]()
        try self.lower_region(module, function, Region.if_arm, branch.body, then_body)
        let else_body = list[MirInstruction]()
        if index + 1 < len(branches):
            self.regions.append(Region.if_arm)
            try self.lower_if(module, function, span, branches, index + 1, fallback, else_body)
            self.regions.remove(len(self.regions) - 1)
        elif fallback != none:
            try self.lower_region(module, function, Region.if_arm, fallback, else_body)
        body.append(MirInstruction(
            form = InstructionForm.If(condition = condition, results = list[RegisterId](), then_body = then_body, else_body = else_body),
            span = span,
        ))

    # `while c: body` is a block around a loop. The loop re-tests `c` on
    # every pass and leaves the block when it fails; the body's last act is a
    # branch back to the loop. `break` is a branch to the block, `continue`
    # a branch to the loop; both count the regions in between.
    func lower_while(module: HirModule, function: HirFunction, span: SourceSpan, condition: HirExpression, statements: list[HirStatement], body: list[MirInstruction]) -> !:
        let loop_body = list[MirInstruction]()
        self.regions.append(Region.block)
        self.regions.append(Region.loop_body)
        let tested = try self.lower_expression(module, function, condition, loop_body)
        let failed = self.new_register(builtin_mir_type(BuiltinMirType.boolean))
        loop_body.append(MirInstruction(form = InstructionForm.Unary(result = failed, operation = UnaryOp.bool_not, operand = tested), span = condition.span))
        loop_body.append(MirInstruction(form = InstructionForm.BrIf(condition = failed, depth = 1, values = list[RegisterId]()), span = condition.span))
        for statement in statements:
            try self.lower_statement(module, function, statement, loop_body)
        loop_body.append(MirInstruction(form = InstructionForm.Br(depth = 0, values = list[RegisterId]()), span = span))
        self.regions.remove(len(self.regions) - 1)
        self.regions.remove(len(self.regions) - 1)
        let block_body = list[MirInstruction]()
        block_body.append(MirInstruction(form = InstructionForm.Loop(body = loop_body), span = span))
        body.append(MirInstruction(form = InstructionForm.Block(results = list[RegisterId](), body = block_body), span = span))

    # Lower statements inside one new region.
    func lower_region(module: HirModule, function: HirFunction, region: Region, statements: list[HirStatement], body: list[MirInstruction]) -> !:
        self.regions.append(region)
        for statement in statements:
            try self.lower_statement(module, function, statement, body)
        self.regions.remove(len(self.regions) - 1)

    # The branch depth of the innermost enclosing loop: zero when the branch
    # sits directly in the loop body, one more for each `If` arm in between.
    func loop_depth(module: HirModule, function: HirFunction, span: SourceSpan) -> i64!:
        var depth = 0
        var index = len(self.regions) - 1
        while index >= 0:
            if self.regions[index] == Region.loop_body: return depth
            depth += 1
            index -= 1
        error(self.unsupported(module, function, span, "`break`/`continue` outside a loop"))

    # Constant terminal output is a data item holding the bytes plus a
    # newline, then `luce_rt_write(address, length)`.
    func lower_print(text: str, span: SourceSpan, body: list[MirInstruction]) -> !:
        let payload = strings.to_bytes(text + "\n")
        let data_id = DataId(value = len(self.data))
        self.data.append(MirData(
            name = "text" + str(data_id.value),
            bytes = payload,
            align = 1,
            relocations = list[MirRelocation](),
        ))
        let address = self.new_register(builtin_mir_type(BuiltinMirType.pointer))
        body.append(MirInstruction(form = InstructionForm.DataAddress(result = address, data = data_id), span = span))
        let length = self.new_register(builtin_mir_type(BuiltinMirType.signed_i64))
        body.append(MirInstruction(form = InstructionForm.Const(result = length, value = MirConstant.Int(value = len(payload))), span = span))
        let write = try self.runtime_extern("luce_rt_write")
        body.append(MirInstruction(
            form = InstructionForm.CallExtern(results = list[RegisterId](), external = write, arguments = [address, length]),
            span = span,
        ))

    # mark: Expressions =========================================================================

    # Lower one expression and return the register holding its value.
    # Operands are lowered left to right, so `2 + 3` defines the register for
    # 2, then 3, then their sum.
    func lower_expression(module: HirModule, function: HirFunction, expression: HirExpression, body: list[MirInstruction]) -> RegisterId!:
        # A call may produce `unit`, which has no machine type; every other
        # expression form has a scalar type or is refused below.
        match expression.form:
            Call(callee, arguments):
                return try self.lower_call(module, function, expression, callee, arguments, body)
            else: return try self.lower_typed_expression(module, function, expression, body)

    func lower_typed_expression(module: HirModule, function: HirFunction, expression: HirExpression, body: list[MirInstruction]) -> RegisterId!:
        let value_type = try self.mir_type_of(module, function, expression.span, expression.value_type)
        match expression.form:
            Constant(value):
                let register = self.new_register(value_type)
                var constant = MirConstant.Null
                match value:
                    Integer(item): constant = MirConstant.Int(value = item)
                    Floating(item): constant = MirConstant.Float(value = item)
                    Boolean(item): constant = MirConstant.Bool(value = item)
                    Character(item): constant = MirConstant.Int(value = i64(u32(item)))
                    else: try self.fail_unsupported(module, function, expression.span, "constant `" + str(value) + "`")
                body.append(MirInstruction(form = InstructionForm.Const(result = register, value = constant), span = expression.span))
                return register
            Reference(symbol):
                for parameter in self.parameters:
                    if parameter.symbol == symbol.value: return parameter.address
                let constant = self.constant_of(symbol)
                if constant != none:
                    return try self.lower_expression(module, function, constant.value, body)
                let local = try self.local_of(module, function, expression.span, symbol)
                let register = self.new_register(value_type)
                body.append(MirInstruction(form = InstructionForm.Load(result = register, value_type = value_type, address = local.address), span = expression.span))
                return register
            Unary(operation, operand):
                let operand_register = try self.lower_expression(module, function, operand, body)
                let register = self.new_register(value_type)
                match operation:
                    LogicalNot:
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bool_not, operand = operand_register), span = expression.span))
                    NumericNegate(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.neg, operand = operand_register), span = expression.span))
                    IntegerBitwiseNot(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Unary(result = register, operation = UnaryOp.bit_not, operand = operand_register), span = expression.span))
                    NumericIdentity(operand_type):
                        body.append(MirInstruction(form = InstructionForm.Copy(result = register, source = operand_register), span = expression.span))
                return register
            Binary(left, operation, right):
                match operation:
                    LogicalAnd: return try self.lower_short_circuit(module, function, expression, left, right, true, body)
                    LogicalOr: return try self.lower_short_circuit(module, function, expression, left, right, false, body)
                    else:
                        let left_register = try self.lower_expression(module, function, left, body)
                        let right_register = try self.lower_expression(module, function, right, body)
                        let operand_type = try self.mir_type_of(module, function, left.span, left.value_type)
                        return try self.lower_binary_operation(module, function, expression.span, operation, operand_type, left_register, right_register, body)
            Conditional(value, condition, alternative):
                let condition_register = try self.lower_expression(module, function, condition, body)
                let result = self.new_register(value_type)
                let then_body = list[MirInstruction]()
                let chosen = try self.lower_expression(module, function, value, then_body)
                then_body.append(MirInstruction(form = InstructionForm.Yield(values = [chosen]), span = expression.span))
                let else_body = list[MirInstruction]()
                let fallback = try self.lower_expression(module, function, alternative, else_body)
                else_body.append(MirInstruction(form = InstructionForm.Yield(values = [fallback]), span = expression.span))
                body.append(MirInstruction(
                    form = InstructionForm.If(condition = condition_register, results = [result], then_body = then_body, else_body = else_body),
                    span = expression.span,
                ))
                return result
            else:
                error(self.unsupported(module, function, expression.span, "expression `" + str(expression.form) + "`"))

    # Arguments are lowered in the order they were written, then placed by
    # the parameter index HIR resolved for each (named arguments may be
    # written in any order). The callee is a `FunctionId`, its index in
    # `program.functions`, which is the same index in the MIR program.
    func lower_call(module: HirModule, function: HirFunction, expression: HirExpression, callee: SymbolId, arguments: list[HirArgument], body: list[MirInstruction]) -> RegisterId!:
        let target = self.function_index_of(callee)
        if target < 0: try self.fail_unsupported(module, function, expression.span, "a call to a symbol that is not a function")
        let called = self.program.functions[target]
        let placed = list[RegisterId]()
        for parameter in called.parameters: placed.append(RegisterId(value = -1))
        for argument in arguments:
            placed[argument.parameter_index] = try self.lower_expression(module, function, argument.value, body)
        let results = list[RegisterId]()
        if not types_match(called.result, resolve_builtin_type(BuiltinType.unit)):
            results.append(self.new_register(try self.mir_type_of(module, function, expression.span, called.result)))
        body.append(MirInstruction(
            form = InstructionForm.Call(results = results, function = FunctionId(value = target), arguments = placed),
            span = expression.span,
        ))
        if len(results) == 0: return RegisterId(value = -1)
        return results[0]

    # `a and b` evaluates `b` only when `a` is true; `a or b` only when `a`
    # is false. Both are an `If` whose unevaluated arm yields the constant
    # that decided the answer.
    func lower_short_circuit(module: HirModule, function: HirFunction, expression: HirExpression, left: HirExpression, right: HirExpression, is_and: bool, body: list[MirInstruction]) -> RegisterId!:
        let boolean = builtin_mir_type(BuiltinMirType.boolean)
        let left_register = try self.lower_expression(module, function, left, body)
        let result = self.new_register(boolean)
        let evaluated = list[MirInstruction]()
        let right_register = try self.lower_expression(module, function, right, evaluated)
        evaluated.append(MirInstruction(form = InstructionForm.Yield(values = [right_register]), span = expression.span))
        let decided = list[MirInstruction]()
        let constant = self.new_register(boolean)
        decided.append(MirInstruction(form = InstructionForm.Const(result = constant, value = MirConstant.Bool(value = not is_and)), span = expression.span))
        decided.append(MirInstruction(form = InstructionForm.Yield(values = [constant]), span = expression.span))
        if is_and:
            body.append(MirInstruction(form = InstructionForm.If(condition = left_register, results = [result], then_body = evaluated, else_body = decided), span = expression.span))
        else:
            body.append(MirInstruction(form = InstructionForm.If(condition = left_register, results = [result], then_body = decided, else_body = evaluated), span = expression.span))
        return result

    # Emit one `Binary` for a resolved HIR operation on two lowered operands.
    # Comparisons produce a `bool` register; everything else keeps the operand
    # type.
    func lower_binary_operation(module: HirModule, function: HirFunction, span: SourceSpan, operation: BinaryOperation, operand_type: TypeId, left: RegisterId, right: RegisterId, body: list[MirInstruction]) -> RegisterId!:
        var binary_operation = BinaryOp.add
        var is_comparison = false
        match operation:
            Add(item): binary_operation = BinaryOp.add
            Subtract(item): binary_operation = BinaryOp.sub
            Multiply(item): binary_operation = BinaryOp.mul
            Divide(item): binary_operation = BinaryOp.div
            FloorDivide(item): binary_operation = BinaryOp.floor_div
            Remainder(item): binary_operation = BinaryOp.rem
            BitwiseAnd(item): binary_operation = BinaryOp.bit_and
            BitwiseOr(item): binary_operation = BinaryOp.bit_or
            BitwiseXor(item): binary_operation = BinaryOp.bit_xor
            ShiftLeft(item): binary_operation = BinaryOp.shift_left
            ShiftRight(item): binary_operation = BinaryOp.shift_right
            Equal(item):
                binary_operation = BinaryOp.eq
                is_comparison = true
            NotEqual(item):
                binary_operation = BinaryOp.ne
                is_comparison = true
            Less(item):
                binary_operation = BinaryOp.lt
                is_comparison = true
            LessEqual(item):
                binary_operation = BinaryOp.le
                is_comparison = true
            Greater(item):
                binary_operation = BinaryOp.gt
                is_comparison = true
            GreaterEqual(item):
                binary_operation = BinaryOp.ge
                is_comparison = true
            else: try self.fail_unsupported(module, function, span, "operation `" + str(operation) + "`")
        var result_type = operand_type
        if is_comparison: result_type = builtin_mir_type(BuiltinMirType.boolean)
        let register = self.new_register(result_type)
        body.append(MirInstruction(
            form = InstructionForm.Binary(result = register, operation = binary_operation, left = left, right = right),
            span = span,
        ))
        return register

    # mark: Tables ==============================================================================

    func new_register(value_type: TypeId) -> RegisterId:
        self.registers.append(value_type)
        return RegisterId(value = len(self.registers) - 1)

    # The HIR function a call symbol names, as its index in `program.functions`.
    func function_index_of(symbol: SymbolId) -> i64:
        for index in range(0, len(self.program.functions)):
            if self.program.functions[index].symbol.value == symbol.value: return index
        return -1

    # The module constant a reference names, if any.
    func constant_of(symbol: SymbolId) -> HirConstant?:
        for constant in self.program.constants:
            if constant.symbol.value == symbol.value: return constant
        return none

    # The slot address of a local the prologue reserved.
    func local_of(module: HirModule, function: HirFunction, span: SourceSpan, symbol: SymbolId) -> Local!:
        for local in self.locals:
            if local.symbol == symbol.value: return local
        error(self.unsupported(module, function, span, "a reference to a symbol that is not a local"))

    # Declare a runtime service once, with the signature the runtime table
    # fixes for it.
    func runtime_extern(name: str) -> ExternId!:
        for index in range(0, len(self.externs)):
            if self.externs[index].name == name: return ExternId(value = index)
        let symbol = find_runtime_symbol(name) else error("lowerer: `" + name + "` is not a runtime service")
        self.externs.append(MirExtern(name = name, convention = CallingConvention.runtime, signature = symbol.signature))
        return ExternId(value = len(self.externs) - 1)

    # Map a scalar HIR type onto its canonical machine type. HIR and MIR each
    # have a `TypeId`; the HIR one is spelled `hir.TypeId` here. `char` is its
    # code point in a `u32`.
    func mir_type_of(module: HirModule, function: HirFunction, span: SourceSpan, value: hir.TypeId) -> TypeId!:
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i8)): return builtin_mir_type(BuiltinMirType.signed_i8)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i16)): return builtin_mir_type(BuiltinMirType.signed_i16)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i32)): return builtin_mir_type(BuiltinMirType.signed_i32)
        if types_match(value, resolve_builtin_type(BuiltinType.signed_i64)): return builtin_mir_type(BuiltinMirType.signed_i64)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u8)): return builtin_mir_type(BuiltinMirType.unsigned_u8)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u16)): return builtin_mir_type(BuiltinMirType.unsigned_u16)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u32)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        if types_match(value, resolve_builtin_type(BuiltinType.unsigned_u64)): return builtin_mir_type(BuiltinMirType.unsigned_u64)
        if types_match(value, resolve_builtin_type(BuiltinType.float32)): return builtin_mir_type(BuiltinMirType.float32)
        if types_match(value, resolve_builtin_type(BuiltinType.float64)): return builtin_mir_type(BuiltinMirType.float64)
        if types_match(value, resolve_builtin_type(BuiltinType.boolean)): return builtin_mir_type(BuiltinMirType.boolean)
        if types_match(value, resolve_builtin_type(BuiltinType.character)): return builtin_mir_type(BuiltinMirType.unsigned_u32)
        error(self.unsupported(module, function, span, "type `" + describe_type(self.program.types, value) + "`"))

    # mark: Diagnostics =========================================================================

    # Fail at the unsupported node while still naming its enclosing function.
    # Example: a binding on line 2 reports line 2, not the function's line 1.
    func fail_unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> !:
        error(self.unsupported(module, function, span, feature))

    func unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> str:
        return format_diagnostic(
            module.path,
            span,
            "lowerer does not support " + feature + " yet in `" + module.name + "." + function.name + "`",
        )

# A process starts at the one public `main` whose MIR shape is `() -> i32`.
# Anything else leaves `entry` absent; native artifacts then report why.
func find_entry(functions: list[MirFunction]) -> FunctionId?:
    let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
    var found = -1
    for index in range(0, len(functions)):
        let function = functions[index]
        if not function.is_public or not strings.ends_with(function.name, ".main"): continue
        if len(function.signature.parameters) != 0 or len(function.signature.results) != 1: continue
        if function.signature.results[0].value != i32_type.value: continue
        if found >= 0: return none
        found = index
    if found < 0: return none
    return FunctionId(value = found)
