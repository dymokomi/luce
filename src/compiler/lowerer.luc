from compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram
from compiler.typed_ir import TypedExpression, TypedFunction, TypedModule, TypedProgram
from compiler.typed_ir import TypedStatement

# Turns typed trees into an ordered instruction stream. This first vertical
# slice deliberately supports only zero-argument i64 functions, literal values,
# basic arithmetic, and return.
class Lowerer:
    private program: TypedProgram

    init(program: TypedProgram):
        self.program = program

    func lower() -> CanonicalProgram!:
        let functions = list[CanonicalFunction]()
        for module_value in self.program.modules:
            for function in module_value.functions:
                functions.append(try self.lower_function(module_value, function))
        return CanonicalProgram(functions = functions)

    private func lower_function(module_value: TypedModule, function: TypedFunction) -> CanonicalFunction!:
        if len(function.parameters) > 0:
            try self.unsupported(module_value, function, "parameters")
        if function.result.name != "i64":
            try self.unsupported(module_value, function, "result type `" + function.result.name + "`")

        let instructions = list[CanonicalInstruction]()
        for statement in function.body:
            try self.lower_statement(module_value, function, statement, instructions)
        return CanonicalFunction(
            name = module_value.name + "." + function.name,
            is_public = function.is_public,
            instructions = instructions,
        )

    private func lower_statement(module_value: TypedModule, function: TypedFunction, statement: TypedStatement, instructions: list[CanonicalInstruction]) -> !:
        match statement.form:
            ReturnStatement(value):
                if value == none:
                    try self.unsupported(module_value, function, "an empty return")
                    return
                let returned = value
                try self.lower_expression(module_value, function, returned, instructions)
                instructions.append(CanonicalInstruction.Return)
            else:
                try self.unsupported(module_value, function, "statement `" + str(statement.form) + "`")

    private func lower_expression(module_value: TypedModule, function: TypedFunction, expression: TypedExpression, instructions: list[CanonicalInstruction]) -> !:
        match expression.form:
            Constant(value):
                match value:
                    Integer(item): instructions.append(CanonicalInstruction.I64Constant(value = item))
                    else: try self.unsupported(module_value, function, "constant `" + str(value) + "`")
            Binary(left, operator, right):
                try self.lower_expression(module_value, function, left, instructions)
                try self.lower_expression(module_value, function, right, instructions)
                match operator:
                    "+": instructions.append(CanonicalInstruction.I64Add)
                    "-": instructions.append(CanonicalInstruction.I64Subtract)
                    "*": instructions.append(CanonicalInstruction.I64Multiply)
                    else: try self.unsupported(module_value, function, "operator `" + operator + "`")
            else:
                try self.unsupported(module_value, function, "expression `" + str(expression.form) + "`")

    private func unsupported(module_value: TypedModule, function: TypedFunction, feature: str) -> !:
        error(module_value.path + ":" + str(function.span.line) + ":" + str(function.span.column) + ": lowerer does not support " + feature + " yet in `" + module_value.name + "." + function.name + "`")
