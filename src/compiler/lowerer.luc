#==============================================================================================
#
#   lowerer - Typed HIR into canonical MIR
#
#   DESCRIPTION:
#       Flattens analyzed typed-HIR expression trees into the ordered canonical
#       instruction stream, making evaluation order explicit for compiled
#       backends.
#       Public use begins at `Lowerer.lower`; the walk goes program -> function
#       -> statement -> expression, and anything outside the executable slice
#       fails with a clear "does not support ... yet".
#
#       The executable slice today: integer arithmetic plus constant terminal
#       output. Only `main(arguments: slice[str])` carries a parameter, and it
#       remains unavailable until ordinary arguments are lowered.
#
#==============================================================================================

from compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType
from compiler.hir import BinaryOperation, BuiltinType, HirExpression, HirFunction
from compiler.hir import HirModule, HirProgram, HirStatement, TypeId, describe_type
from compiler.hir import resolve_builtin_type, types_match
from compiler.semantic_analyzer import AnalyzedProgram
from compiler.source import SourceSpan, format_diagnostic

## Turns one semantically analyzed typed-HIR program into canonical MIR.
pub class Lowerer:
    program: HirProgram

    ## Prepare to lower one analyzed program; `lower` performs the actual walk.
    pub init(program: AnalyzedProgram):
        self.program = program.hir

    # mark: Lowering ============================================================================

    ## Lower every function in every module, or stop at the first construct
    ## the executable slice cannot express yet.
    pub func lower() -> CanonicalProgram!:
        let functions = list[CanonicalFunction]()
        for function in self.program.functions:
            let module = self.program.modules[function.module.value]
            functions.append(try self.lower_function(module, function))
        return CanonicalProgram(functions = functions)

    # Lower one function body into a flat instruction list. The canonical name
    # is `module.function` so artifacts stay unambiguous across modules.
    func lower_function(module: HirModule, function: HirFunction) -> CanonicalFunction!:
        let string_slice = resolve_builtin_type(BuiltinType.string_slice)
        let is_entry = function.name == "main" and len(function.parameters) == 1 and types_match(function.parameters[0].value_type, string_slice)
        if function.name == "main" and not is_entry:
            try self.fail_unsupported(module, function, function.span, "entry parameters other than `(arguments: slice[str])`")
        if function.name != "main" and len(function.parameters) > 0:
            try self.fail_unsupported(module, function, function.span, "parameters")
        let i32_type = resolve_builtin_type(BuiltinType.signed_i32)
        let i64_type = resolve_builtin_type(BuiltinType.signed_i64)
        if not types_match(function.result, i32_type) and not types_match(function.result, i64_type):
            try self.fail_unsupported(module, function, function.span, "result type `" + describe_type(self.program.types, function.result) + "`")

        let instructions = list[CanonicalInstruction]()
        for statement in function.body:
            try self.lower_statement(module, function, statement, instructions)
        return CanonicalFunction(
            name = module.name + "." + function.name,
            is_public = function.is_public,
            result = canonical_type(function.result, i32_type, i64_type),
            instructions = instructions,
        )

    # Append the canonical instructions for one HIR statement. For example,
    # `return 7` emits its constant followed by `Return`.
    func lower_statement(module: HirModule, function: HirFunction, statement: HirStatement, instructions: list[CanonicalInstruction]) -> !:
        match statement.form:
            PrintText(value): instructions.append(CanonicalInstruction.WriteText(value = value))
            ReturnStatement(value):
                if value == none:
                    try self.fail_unsupported(module, function, statement.span, "an empty return")
                    return
                let returned = value
                try self.lower_expression(module, function, returned, instructions)
                instructions.append(CanonicalInstruction.Return)
            else:
                try self.fail_unsupported(module, function, statement.span, "statement `" + str(statement.form) + "`")

    # Operands first, operator last — the canonical stream is a stack machine,
    # so `2 + 3` lowers to push 2, push 3, add.
    func lower_expression(module: HirModule, function: HirFunction, expression: HirExpression, instructions: list[CanonicalInstruction]) -> !:
        match expression.form:
            Constant(value):
                match value:
                    Integer(item):
                        if types_match(expression.value_type, resolve_builtin_type(BuiltinType.signed_i32)):
                            instructions.append(CanonicalInstruction.I32Constant(value = item))
                        else:
                            instructions.append(CanonicalInstruction.I64Constant(value = item))
                    else: try self.fail_unsupported(module, function, expression.span, "constant `" + str(value) + "`")
            Binary(left, operation, right):
                if types_match(expression.value_type, resolve_builtin_type(BuiltinType.signed_i32)):
                    try self.fail_unsupported(module, function, expression.span, "i32 arithmetic")
                    return
                try self.lower_expression(module, function, left, instructions)
                try self.lower_expression(module, function, right, instructions)
                match operation:
                    Add(operand_type): instructions.append(CanonicalInstruction.I64Add)
                    Subtract(operand_type): instructions.append(CanonicalInstruction.I64Subtract)
                    Multiply(operand_type): instructions.append(CanonicalInstruction.I64Multiply)
                    else: try self.fail_unsupported(module, function, expression.span, "operation `" + str(operation) + "`")
            else:
                try self.fail_unsupported(module, function, expression.span, "expression `" + str(expression.form) + "`")

    # mark: Diagnostics =========================================================================

    # Fail at the unsupported node while still naming its enclosing function.
    # Example: a binding on line 2 reports line 2, not the function's line 1.
    func fail_unsupported(module: HirModule, function: HirFunction, span: SourceSpan, feature: str) -> !:
        error(
            format_diagnostic(
                module.path,
                span,
                "lowerer does not support " + feature + " yet in `"
                + module.name + "." + function.name + "`",
            )
        )

# Map a checked i32/i64 result onto the canonical machine type. Other result
# types are refused before this helper is called.
func canonical_type(result: TypeId, i32_type: TypeId, i64_type: TypeId) -> CanonicalType:
    if types_match(result, i32_type): return CanonicalType.signed_i32
    return CanonicalType.signed_i64
