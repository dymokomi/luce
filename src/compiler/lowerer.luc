#==============================================================================================
#
#   lowerer - Typed trees into canonical instructions
#
#   DESCRIPTION:
#       Flattens checked expression trees into the ordered canonical instruction
#       stream, making evaluation order explicit for the compiled backends.
#       Public use begins at `Lowerer.lower`; the walk goes program -> function
#       -> statement -> expression, and anything outside the executable slice
#       fails with a clear "does not support ... yet".
#
#       The executable slice today: integer arithmetic plus constant terminal
#       output. Only `main(arguments: slice[str])` carries a parameter, and it
#       remains unavailable until ordinary arguments are lowered.
#
#==============================================================================================

from compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram
from compiler.typed_ir import TypedExpression, TypedFunction, TypedModule, TypedProgram
from compiler.typed_ir import TypedStatement

## Turns one typed program into one canonical program.
pub class Lowerer:
    program: TypedProgram

    pub init(program: TypedProgram):
        self.program = program

    # mark: Lowering ============================================================================

    ## Lower every function in every module, or stop at the first construct
    ## the executable slice cannot express yet.
    pub func lower() -> CanonicalProgram!:
        let functions = list[CanonicalFunction]()
        for module in self.program.modules:
            for function in module.functions:
                functions.append(try self.lower_function(module, function))
        return CanonicalProgram(functions = functions)

    # Lower one function body into a flat instruction list. The canonical name
    # is `module.function` so artifacts stay unambiguous across modules.
    func lower_function(module: TypedModule, function: TypedFunction) -> CanonicalFunction!:
        let is_entry = function.name == "main" and len(function.parameters) == 1 and function.parameters[0].value_type.name == "slice[str]"
        if function.name == "main" and not is_entry:
            try self.fail_unsupported(module, function, "entry parameters other than `(arguments: slice[str])`")
        if function.name != "main" and len(function.parameters) > 0:
            try self.fail_unsupported(module, function, "parameters")
        if function.result.name != "i32" and function.result.name != "i64":
            try self.fail_unsupported(module, function, "result type `" + function.result.name + "`")

        let instructions = list[CanonicalInstruction]()
        for statement in function.body:
            try self.lower_statement(module, function, statement, instructions)
        return CanonicalFunction(
            name = module.name + "." + function.name,
            is_public = function.is_public,
            result = function.result.name,
            instructions = instructions,
        )

    func lower_statement(module: TypedModule, function: TypedFunction, statement: TypedStatement, instructions: list[CanonicalInstruction]) -> !:
        match statement.form:
            PrintText(value): instructions.append(CanonicalInstruction.WriteText(value = value))
            ReturnStatement(value):
                if value == none:
                    try self.fail_unsupported(module, function, "an empty return")
                    return
                let returned = value
                try self.lower_expression(module, function, returned, instructions)
                instructions.append(CanonicalInstruction.Return)
            else:
                try self.fail_unsupported(module, function, "statement `" + str(statement.form) + "`")

    # Operands first, operator last — the canonical stream is a stack machine,
    # so `2 + 3` lowers to push 2, push 3, add.
    func lower_expression(module: TypedModule, function: TypedFunction, expression: TypedExpression, instructions: list[CanonicalInstruction]) -> !:
        match expression.form:
            Constant(value):
                match value:
                    Integer(item):
                        if expression.value_type.name == "i32":
                            instructions.append(CanonicalInstruction.I32Constant(value = item))
                        else:
                            instructions.append(CanonicalInstruction.I64Constant(value = item))
                    else: try self.fail_unsupported(module, function, "constant `" + str(value) + "`")
            Binary(left, operator, right):
                if expression.value_type.name == "i32":
                    try self.fail_unsupported(module, function, "i32 arithmetic")
                    return
                try self.lower_expression(module, function, left, instructions)
                try self.lower_expression(module, function, right, instructions)
                match operator:
                    "+": instructions.append(CanonicalInstruction.I64Add)
                    "-": instructions.append(CanonicalInstruction.I64Subtract)
                    "*": instructions.append(CanonicalInstruction.I64Multiply)
                    else: try self.fail_unsupported(module, function, "operator `" + operator + "`")
            else:
                try self.fail_unsupported(module, function, "expression `" + str(expression.form) + "`")

    # mark: Diagnostics =========================================================================

    # Fail with the file, position, and full name of the offending function.
    func fail_unsupported(module: TypedModule, function: TypedFunction, feature: str) -> !:
        error(module.path + ":" + str(function.span.line) + ":" + str(function.span.column) + ": lowerer does not support " + feature + " yet in `" + module.name + "." + function.name + "`")
