#==============================================================================================
#
#   fiir.clang - Strict Clang serialized-AST ingestion
#
#   DESCRIPTION:
#       Decodes Clang's JSON AST into target-neutral FIIR. JSON and Clang's
#       spelling conventions stop here. The decoder accepts scalar typedefs,
#       C enumerations, constant-only anonymous enumerations, header-local
#       integral object constants, external scalar objects, plain records, and
#       functions; every other declaration or type is either outside the
#       requested header or rejected with a stable support diagnostic.
#
#       Clang elides repeated file and line fields in source locations. The
#       top-level cursor below reconstructs only those documented repetitions;
#       an actually absent declaration position is never fabricated.
#
#==============================================================================================

from compiler.fiir.schema import FiirBoundaryValue, FiirCFloatingKind, FiirCIntegerKind, FiirCallingConvention, FiirConstant, FiirConstantSource, FiirConstantValue, FiirEnumCase, FiirFunction, FiirIntegerValue, FiirLanguage, FiirModule, FiirObject, FiirObjectAccess, FiirParameter, FiirRecordField, FiirSourceOrigin, FiirType, FiirTypeForm, FiirTypeId, is_c_identifier, plain_value_boundary, validate_fiir
import std.json
import std.strings

# mark: Target facts ===========================================================================

## Width facts emitted by the same Clang invocation that parsed the header.
## Keeping this as input makes tests independent of the machine running them
## and prevents the decoder from treating the compiler host as the C target.
pub struct ClangScalarFacts:
    pub let char_size_bits: u16
    pub let short_size_bits: u16
    pub let short_value_bits: u16
    pub let int_size_bits: u16
    pub let int_value_bits: u16
    pub let long_size_bits: u16
    pub let long_value_bits: u16
    pub let long_long_size_bits: u16
    pub let long_long_value_bits: u16
    pub let float_storage_bits: u16
    pub let float_radix: u16
    pub let float_significand_bits: u16
    pub let float_maximum_exponent: i32
    pub let double_storage_bits: u16
    pub let double_significand_bits: u16
    pub let double_maximum_exponent: i32
    pub let long_double_storage_bits: u16
    pub let long_double_significand_bits: u16
    pub let long_double_maximum_exponent: i32
    pub let plain_char_is_signed: bool
    pub let bool_size_bits: u16

## `_Float16` facts are queried only when the selected declaration graph uses
## the type because not every C target exposes binary16.
struct ClangFloat16Facts:
    let size_bits: u16
    let radix: u16
    let significand_bits: u16
    let maximum_exponent: i32

## Decode Clang's predefined-macro report (`-dM -E -x c`) into the scalar
## layout facts needed by this FIIR slice.
pub func decode_clang_scalar_facts(macros: str) -> ClangScalarFacts!:
    let char_bits = try required_macro_integer(macros, "__CHAR_BIT__")
    let facts = ClangScalarFacts(
        char_size_bits = try storage_width(macros, "__SIZEOF_CHAR__", char_bits, true),
        short_size_bits = try storage_width(macros, "__SIZEOF_SHORT__", char_bits, false),
        short_value_bits = try positive_u16(macros, "__SHRT_WIDTH__"),
        int_size_bits = try storage_width(macros, "__SIZEOF_INT__", char_bits, false),
        int_value_bits = try positive_u16(macros, "__INT_WIDTH__"),
        long_size_bits = try storage_width(macros, "__SIZEOF_LONG__", char_bits, false),
        long_value_bits = try positive_u16(macros, "__LONG_WIDTH__"),
        long_long_size_bits = try storage_width(macros, "__SIZEOF_LONG_LONG__", char_bits, false),
        long_long_value_bits = try positive_u16(macros, "__LLONG_WIDTH__"),
        float_storage_bits = try storage_width(macros, "__SIZEOF_FLOAT__", char_bits, false),
        float_radix = try positive_u16(macros, "__FLT_RADIX__"),
        float_significand_bits = try positive_u16(macros, "__FLT_MANT_DIG__"),
        float_maximum_exponent = try positive_i32(macros, "__FLT_MAX_EXP__"),
        double_storage_bits = try storage_width(macros, "__SIZEOF_DOUBLE__", char_bits, false),
        double_significand_bits = try positive_u16(macros, "__DBL_MANT_DIG__"),
        double_maximum_exponent = try positive_i32(macros, "__DBL_MAX_EXP__"),
        long_double_storage_bits = try storage_width(macros, "__SIZEOF_LONG_DOUBLE__", char_bits, false),
        long_double_significand_bits = try positive_u16(macros, "__LDBL_MANT_DIG__"),
        long_double_maximum_exponent = try positive_i32(macros, "__LDBL_MAX_EXP__"),
        plain_char_is_signed = not has_macro(macros, "__CHAR_UNSIGNED__"),
        bool_size_bits = try positive_u16(macros, "__BOOL_WIDTH__"),
    )
    return facts

func storage_width(macros: str, name: str, char_bits: i64, optional_one: bool) -> u16!:
    var byte_count = required_macro_integer(macros, name) catch reason:
        if optional_one: return u16(char_bits)
        error(reason)
    let bits = byte_count * char_bits
    if bits <= 0 or bits > 65535: error("Clang target facts: `" + name + "` is outside the supported range")
    return u16(bits)

func positive_u16(macros: str, name: str) -> u16!:
    let value = try required_macro_integer(macros, name)
    if value > 65535: error("Clang target facts: `" + name + "` is outside the supported range")
    return u16(value)

func positive_i32(macros: str, name: str) -> i32!:
    let value = try required_macro_integer(macros, name)
    if value > 2147483647: error("Clang target facts: `" + name + "` is outside the supported range")
    return i32(value)

func required_macro_integer(macros: str, name: str) -> i64!:
    let prefix = "#define " + name + " "
    for line in strings.split(macros, "\n"):
        if strings.starts_with(line, prefix):
            let value = parse_i64(line[len(prefix):]) else error("Clang target facts: `" + name + "` is not an integer")
            if value <= 0: error("Clang target facts: `" + name + "` must be positive")
            return value
    error("Clang target facts: missing `" + name + "`")

func has_macro(macros: str, name: str) -> bool:
    let prefix = "#define " + name
    for line in strings.split(macros, "\n"):
        if line == prefix or strings.starts_with(line, prefix + " "): return true
    return false

# mark: Selected macro inventory ===============================================================

## One explicitly selected object-like macro after preprocessing. Macro
## replacement text is intentionally absent: Clang remains the sole evaluator
## of C preprocessing, typing, and constant-expression semantics.
pub struct ClangMacroDefinition:
    pub let name: str
    pub let origin: FiirSourceOrigin

## The two filtered AST products needed to finish selected macro constants.
## Keeping them together prevents positional document arguments from losing
## their meaning at the pure decoder boundary.
pub struct ClangMacroProducts:
    pub let definitions: list[ClangMacroDefinition]
    pub let type_document: str
    pub let value_document: str

struct ClangMacroState:
    let origin: FiirSourceOrigin
    let function_like: bool

struct ClangLineMarker:
    let path: str
    let line: u32

struct ClangMacroConstant:
    let name: str
    let value_type: FiirTypeId
    let origin: FiirSourceOrigin

## Decode Clang's normalized `-E -dD` stream and retain only explicitly
## requested definitions. The final active definition wins exactly as it does
## for the translation unit; function-like and absent macros fail before any
## generated probe attempts to use them as values.
pub func decode_clang_macro_definitions(document: str, header: str, selected: list[str]) -> list[ClangMacroDefinition]!:
    let requested = map[str, bool]()
    for name in selected:
        if not is_c_identifier(name):
            error("Clang FIIR: selected macro `" + name + "` is not a portable C identifier")
        if requested.has(name): error("Clang FIIR: selected macro `" + name + "` was requested more than once")
        requested[name] = true
    let states = map[str, ClangMacroState]()
    let active = map[str, bool]()
    var path = ""
    var line_number = u32(0)
    for line in strings.split(document, "\n"):
        let marker = try preprocessor_line_marker(line)
        if marker != none:
            path = marker.path
            line_number = marker.line
            continue
        if line_number != u32(0):
            let definition = macro_directive(line, "#define ")
            if definition != none:
                let name = definition.name
                if requested.has(name):
                    states[name] = ClangMacroState(
                        origin = FiirSourceOrigin(path = path, line = line_number, column = u32(1)),
                        function_like = definition.function_like,
                    )
                    active[name] = true
            let undefined = macro_directive(line, "#undef ")
            if undefined != none and requested.has(undefined.name): active[undefined.name] = false
            if line_number < u32(4294967295): line_number += u32(1)
    let definitions = list[ClangMacroDefinition]()
    for name in selected:
        if not states.has(name) or not active.has(name) or not active[name]:
            error("Clang FIIR: selected macro `" + name + "` is not defined after preprocessing `" + header + "`")
        let state = states[name]
        if state.function_like:
            error("Clang FIIR: selected macro `" + name + "` is function-like; only object-like constant macros can be imported")
        definitions.append(ClangMacroDefinition(name = name, origin = state.origin))
    return definitions

struct ClangMacroDirective:
    let name: str
    let function_like: bool

func macro_directive(line: str, prefix: str) -> ClangMacroDirective?:
    if not strings.starts_with(line, prefix): return none
    let start = len(prefix)
    if start >= len(line): return none
    var end = start
    while end < len(line) and is_c_identifier_character(line[end], end == start): end += 1
    if end == start: return none
    return ClangMacroDirective(name = line[start:end], function_like = end < len(line) and line[end] == '(')

func is_c_identifier_character(character: char, first: bool) -> bool:
    if character == '_' or (character >= 'A' and character <= 'Z') or (character >= 'a' and character <= 'z'): return true
    return not first and character >= '0' and character <= '9'

func preprocessor_line_marker(line: str) -> ClangLineMarker?!:
    if not strings.starts_with(line, "# "): return none
    var position = 2
    let line_start = position
    while position < len(line) and line[position] >= '0' and line[position] <= '9': position += 1
    if position == line_start or position >= len(line) or line[position] != ' ': return none
    let parsed_line = parse_i64(line[line_start:position]) else error("Clang FIIR macro inventory: malformed line marker `" + line + "`")
    if parsed_line <= 0 or parsed_line > 4294967295:
        error("Clang FIIR macro inventory: line marker is outside the supported source range")
    while position < len(line) and line[position] == ' ': position += 1
    if position >= len(line) or line[position] != '"': return none
    let path_start = position
    position += 1
    var escaped = false
    while position < len(line):
        let character = line[position]
        if character == '"' and not escaped:
            let encoded = json.parse(line[path_start:position + 1]) catch malformed:
                error("Clang FIIR macro inventory: malformed line-marker path: " + json.describe(malformed))
            let path = encoded.as_text() else error("Clang FIIR macro inventory: line-marker path is not text")
            return ClangLineMarker(path = path, line = u32(parsed_line))
        if character == '\\' and not escaped: escaped = true
        else: escaped = false
        position += 1
    error("Clang FIIR macro inventory: unterminated line-marker path")

# mark: AST document ===========================================================================

class SourceCursor:
    var path: str
    var line: u32

    init(path: str, line: u32):
        self.path = path
        self.line = line

struct ClangTypedef:
    let name: str
    let target_spelling: str
    let target_enum_id: str?
    let target_record_id: str?
    let origin: FiirSourceOrigin

union ClangObjectKind:
    Constant
    External(access: FiirObjectAccess)

struct ClangObject:
    let name: str
    let type_spelling: str
    let kind: ClangObjectKind
    let is_volatile: bool
    let origin: FiirSourceOrigin

struct ClangObjectTypeSpellings:
    let declared: str
    let desugared: str

struct ClangEnumerationConstant:
    let declaration: FiirEnumCase
    let type_spelling: str

class ClangEnumeration:
    let identity: str
    let tag: str?
    let c_spelling: str?
    let constants: list[ClangEnumerationConstant]
    let origin: FiirSourceOrigin
    var raw_name: str

    init(identity: str, tag: str?, c_spelling: str?, constants: list[ClangEnumerationConstant], origin: FiirSourceOrigin, raw_name: str):
        self.identity = identity
        self.tag = tag
        self.c_spelling = c_spelling
        self.constants = constants
        self.origin = origin
        self.raw_name = raw_name

class ClangEnumerationCatalog:
    let by_identity: map[str, ClangEnumeration]
    let identity_by_spelling: map[str, str]

    init():
        self.by_identity = map[str, ClangEnumeration]()
        self.identity_by_spelling = map[str, str]()

struct ClangRecordField:
    let name: str?
    let type_spelling: str
    let is_bitfield: bool
    let origin: FiirSourceOrigin

class ClangRecord:
    let identity: str
    let tag_kind: str
    let c_spelling: str?
    let fields: list[ClangRecordField]
    let origin: FiirSourceOrigin
    var raw_name: str
    var size_bits: u64
    var alignment_bits: u64
    var field_offsets: list[u64]

    init(identity: str, tag_kind: str, c_spelling: str?, fields: list[ClangRecordField], origin: FiirSourceOrigin, raw_name: str):
        self.identity = identity
        self.tag_kind = tag_kind
        self.c_spelling = c_spelling
        self.fields = fields
        self.origin = origin
        self.raw_name = raw_name
        self.size_bits = u64(0)
        self.alignment_bits = u64(0)
        self.field_offsets = list[u64]()

class ClangRecordCatalog:
    let by_identity: map[str, ClangRecord]
    let identity_by_spelling: map[str, str]

    init():
        self.by_identity = map[str, ClangRecord]()
        self.identity_by_spelling = map[str, str]()

## Decode the translation-unit JSON produced for `header`. Declarations owned
## by included headers remain foreign dependencies, except for typedef chains
## needed to express a selected header declaration exactly.
pub func decode_clang_ast(document: str, header: str, target: str, clang_arguments: list[str], facts: ClangScalarFacts, target_fact_document: str = "", macro_products: ClangMacroProducts? = none) -> FiirModule!:
    if header == "": error("Clang FIIR: source header cannot be empty")
    if target == "": error("Clang FIIR: target cannot be empty")
    let root = json.parse(document) catch malformed:
        error("Clang FIIR: " + json.describe(malformed))
    let root_kind = try required_text_member(root, "kind", "translation unit")
    if root_kind != "TranslationUnitDecl":
        error("Clang FIIR: root kind is `" + root_kind + "`, expected `TranslationUnitDecl`")
    let declarations = try required_array_member(root, "inner", "translation unit")
    let enumerations = try collect_enumerations(declarations)
    let records = try collect_records(declarations)
    let typedefs = try collect_typedefs(declarations, enumerations, records)
    let record_identities = try reachable_record_identities(declarations, header, records, typedefs)
    let object_declarations = try collect_objects(declarations, header, typedefs)
    let constant_count = count_object_constants(object_declarations)
    let needs_float16 = try selected_declarations_use_float16(declarations, header, record_identities, records, typedefs)
    let target_facts = try decode_target_fact_values(record_identities, needs_float16, constant_count, target_fact_document)
    try apply_record_layouts(records, record_identities, target_facts)
    let float16_facts = try decode_float16_facts(needs_float16, target_facts)
    let interner = FiirTypeInterner(typedefs, enumerations, records, facts, float16_facts)
    let constants = list[FiirConstant]()
    let objects = list[FiirObject]()
    let functions = list[FiirFunction]()
    let cursor = SourceCursor(path = "", line = u32(0))
    var object_index = 0
    var object_constant_index = 0

    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        if origin == none or cursor.path != header: continue
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        let implicit = try optional_bool_member(declaration, "isImplicit", "declaration") else false
        if implicit: continue
        if kind == "FunctionDecl":
            functions.append(try decode_function(declaration, origin, interner))
        elif kind == "EnumDecl":
            let identity = try required_text_member(declaration, "id", "C enum at " + origin_text(origin))
            if enumerations.by_identity.has(identity):
                let enumeration = enumerations.by_identity[identity]
                if enumeration.raw_name == "":
                    try append_anonymous_enumeration_constants(enumeration, interner, constants)
                else:
                    discard(try interner.intern_enumeration(identity, "C enum at " + origin_text(origin)))
        elif kind == "RecordDecl":
            let identity = try required_text_member(declaration, "id", "C record at " + origin_text(origin))
            if records.by_identity.has(identity):
                let record = records.by_identity[identity]
                if record.tag_kind != "struct":
                    error("Clang FIIR: C `" + record.tag_kind + "` at " + origin_text(origin) + " is not supported by the plain-record importer yet")
                discard(try interner.intern_record(identity, "C record at " + origin_text(origin)))
        elif kind == "TypedefDecl":
            let name = try required_text_member(declaration, "name", "typedef at " + origin_text(origin))
            discard(try interner.intern(name, "typedef `" + name + "`"))
        elif kind == "VarDecl":
            let name = try required_text_member(declaration, "name", "C object at " + origin_text(origin))
            if object_index >= len(object_declarations) or object_declarations[object_index].name != name:
                error("Clang FIIR: object catalog is inconsistent at `" + name + "`")
            let object = object_declarations[object_index]
            match object.kind:
                Constant:
                    try append_object_constant(object, object_constant_index, target_facts, interner, constants)
                    object_constant_index += 1
                External(access): try append_external_object(object, access, interner, objects)
            object_index += 1
        elif kind == "StaticAssertDecl":
            # Clang has already enforced the header assertion. It contributes
            # no declaration to FIIR and must not become generated source.
            pass
        else:
            error("Clang FIIR: declaration kind `" + kind + "` at " + origin_text(origin) + " is not supported")
    if object_index != len(object_declarations): error("Clang FIIR: object catalog was not consumed completely")
    if object_constant_index != constant_count:
        error("Clang FIIR: object constant catalog was not consumed completely")
    if macro_products != none:
        let products = macro_products
        let macro_constants = try decode_macro_constant_types(products.type_document, products.definitions, interner)
        let macro_values = try decode_macro_fact_values(len(macro_constants), products.value_document)
        for index in range(0, len(macro_constants)):
            try append_macro_constant(macro_constants[index], index, macro_values, interner, constants)

    let module = FiirModule(
        format_version = u32(1),
        language = FiirLanguage.c,
        generator_version = "luce-fiir-1",
        header = header,
        target = target,
        clang_arguments = clang_arguments,
        types = interner.types,
        constants = constants,
        objects = objects,
        functions = functions,
    )
    try validate_fiir(module)
    return module

# mark: Declaration catalogs ==================================================================

func collect_typedefs(declarations: list[json.Json], enumerations: ClangEnumerationCatalog, records: ClangRecordCatalog) -> map[str, ClangTypedef]!:
    let typedefs = map[str, ClangTypedef]()
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind != "TypedefDecl": continue
        let implicit = try optional_bool_member(declaration, "isImplicit", "typedef declaration") else false
        if implicit: continue
        if origin == none: continue
        let name = try required_text_member(declaration, "name", "typedef at " + origin_text(origin))
        let target = try required_type_spelling(declaration, "typedef `" + name + "`")
        let target_enum = try typedef_enumeration_identity(declaration, "typedef `" + name + "`")
        let target_record = try typedef_record_identity(declaration, "typedef `" + name + "`")
        if typedefs.has(name):
            if typedefs[name].target_spelling != target or not optional_text_equal(typedefs[name].target_enum_id, target_enum) or not optional_text_equal(typedefs[name].target_record_id, target_record):
                error("Clang FIIR: typedef `" + name + "` has inconsistent accepted declarations")
            continue
        typedefs[name] = ClangTypedef(name = name, target_spelling = target, target_enum_id = target_enum, target_record_id = target_record, origin = origin)
        if target_enum != none:
            if not enumerations.by_identity.has(target_enum):
                error("Clang FIIR: typedef `" + name + "` names an unknown C enum declaration")
            let enumeration = enumerations.by_identity[target_enum]
            if enumeration.raw_name == "": enumeration.raw_name = name
        if target_record != none:
            # Included headers commonly typedef intentionally incomplete
            # opaque records. Keep that edge dormant unless a selected
            # declaration reaches it; only complete by-value records enter
            # this importer slice.
            if records.by_identity.has(target_record):
                let record = records.by_identity[target_record]
                if record.raw_name == "": record.raw_name = name
    return typedefs

func collect_enumerations(declarations: list[json.Json]) -> ClangEnumerationCatalog!:
    let catalog = ClangEnumerationCatalog()
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind != "EnumDecl": continue
        let implicit = try optional_bool_member(declaration, "isImplicit", "C enum declaration") else false
        if implicit or origin == none: continue
        let identity = try required_text_member(declaration, "id", "C enum at " + origin_text(origin))
        let tag = try optional_text_member(declaration, "name", "C enum at " + origin_text(origin))
        let children = try optional_array_member(declaration, "inner", "C enum at " + origin_text(origin)) else list[json.Json]()
        if len(children) == 0: continue
        let constants = try decode_enumeration_constants(children, origin)
        var c_spelling: str? = none
        var raw_name = ""
        if tag != none and tag != "":
            c_spelling = "enum " + tag
            raw_name = tag
        let enumeration = ClangEnumeration(identity, tag, c_spelling, constants, origin, raw_name)
        catalog.by_identity[identity] = enumeration
        if c_spelling != none: catalog.identity_by_spelling[c_spelling] = identity
    return catalog

# mark: Object declarations ===================================================================

## Classify every header-owned object before target-fact probing. Header-local
## immutable integer definitions become values; declaration-only `extern`
## objects remain live storage and cross through generated accessors. Other
## definitions would bind the adapter's private copy or define storage merely
## by including the header, so they fail rather than changing C semantics.
func collect_objects(declarations: list[json.Json], header: str, typedefs: map[str, ClangTypedef]) -> list[ClangObject]!:
    let objects = list[ClangObject]()
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        if origin == none or cursor.path != header: continue
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind != "VarDecl": continue
        let implicit = try optional_bool_member(declaration, "isImplicit", "C object declaration") else false
        if implicit: continue
        let name = try required_text_member(declaration, "name", "C object at " + origin_text(origin))
        let spelling = try required_type_spelling(declaration, "C object `" + name + "`")
        let storage = try optional_text_member(declaration, "storageClass", "C object `" + name + "`") else ""
        let has_initializer = declaration.member("init") != none
        let is_const = try object_type_has_qualifier(declaration, name, "const")
        let is_volatile = try object_type_has_qualifier(declaration, name, "volatile")
        if storage == "static" and has_initializer and is_const:
            if is_volatile:
                error("Clang FIIR: C object `" + name + "` is volatile runtime storage and cannot become a generated constant")
            if not spelling_resolves_to_integer(spelling, typedefs, list[str]()):
                error("Clang FIIR: C object constant `" + name + "` has unsupported non-integer type `" + spelling + "`")
            objects.append(ClangObject(name = name, type_spelling = spelling, kind = ClangObjectKind.Constant, is_volatile = is_volatile, origin = origin))
        elif storage == "extern" and not has_initializer:
            if try object_has_thread_storage(declaration):
                error("Clang FIIR: external C object `" + name + "` uses thread-local storage, which has no generated accessor contract yet")
            if try object_type_is_atomic(declaration, name):
                error("Clang FIIR: external C object `" + name + "` is atomic, which requires an explicit operation recipe")
            var access = FiirObjectAccess.read_write
            if is_const: access = FiirObjectAccess.read_only
            objects.append(ClangObject(name = name, type_spelling = spelling, kind = ClangObjectKind.External(access = access), is_volatile = is_volatile, origin = origin))
        else:
            error("Clang FIIR: C object `" + name + "` must be either a header-local `static const` value or a declaration-only `extern` object")
    return objects

func count_object_constants(objects: list[ClangObject]) -> i64:
    var count = 0
    for object in objects:
        match object.kind:
            Constant: count += 1
            External(access): pass
    return count

func constant_objects(objects: list[ClangObject]) -> list[ClangObject]:
    let constants = list[ClangObject]()
    for object in objects:
        match object.kind:
            Constant: constants.append(object)
            External(access): pass
    return constants

func object_type_has_qualifier(declaration: json.Json, name: str, qualifier: str) -> bool!:
    let spellings = try object_type_spellings(declaration, name)
    return leading_scalar_qualifier(spellings.declared, qualifier) or leading_scalar_qualifier(spellings.desugared, qualifier)

func object_type_is_atomic(declaration: json.Json, name: str) -> bool!:
    let spellings = try object_type_spellings(declaration, name)
    return scalar_spelling_is_atomic(spellings.declared) or scalar_spelling_is_atomic(spellings.desugared)

func object_type_spellings(declaration: json.Json, name: str) -> ClangObjectTypeSpellings!:
    let type_value = declaration.member("type") else error("Clang FIIR: C object `" + name + "` has no type")
    let spelling = try required_text_member(type_value, "qualType", "C object `" + name + "` type")
    let desugared = try optional_text_member(type_value, "desugaredQualType", "C object `" + name + "` type") else spelling
    return ClangObjectTypeSpellings(declared = spelling, desugared = desugared)

func leading_scalar_qualifier(spelling: str, wanted: str) -> bool:
    var remaining = strings.trim(spelling)
    while true:
        if strings.starts_with(remaining, "const "):
            if wanted == "const": return true
            remaining = strings.trim(remaining[6:])
        elif strings.starts_with(remaining, "volatile "):
            if wanted == "volatile": return true
            remaining = strings.trim(remaining[9:])
        else: return false

func scalar_spelling_is_atomic(spelling: str) -> bool:
    var remaining = strings.trim(spelling)
    while true:
        if strings.starts_with(remaining, "const "): remaining = strings.trim(remaining[6:])
        elif strings.starts_with(remaining, "volatile "): remaining = strings.trim(remaining[9:])
        else: return strings.starts_with(remaining, "_Atomic(") or strings.starts_with(remaining, "_Atomic ")

func object_has_thread_storage(declaration: json.Json) -> bool!:
    let tls = try optional_text_member(declaration, "tls", "C object declaration")
    if tls != none and tls != "none": return true
    let tls_kind = try optional_text_member(declaration, "tlsKind", "C object declaration")
    return tls_kind != none and tls_kind != "none"

func spelling_resolves_to_integer(spelling: str, typedefs: map[str, ClangTypedef], active: list[str]) -> bool:
    let canonical = unqualified_scalar_spelling(strings.trim(spelling))
    if fundamental_integer_kind(canonical) != none: return true
    if not typedefs.has(canonical): return false
    for name in active:
        if name == canonical: return false
    active.append(canonical)
    let result = spelling_resolves_to_integer(typedefs[canonical].target_spelling, typedefs, active)
    active.remove(len(active) - 1)
    return result

# mark: Record declarations and target-fact probes =============================================

func collect_records(declarations: list[json.Json]) -> ClangRecordCatalog!:
    let catalog = ClangRecordCatalog()
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind != "RecordDecl": continue
        let implicit = try optional_bool_member(declaration, "isImplicit", "C record declaration") else false
        if implicit or origin == none: continue
        let complete = try optional_bool_member(declaration, "completeDefinition", "C record declaration") else false
        if not complete: continue
        let identity = try required_text_member(declaration, "id", "C record at " + origin_text(origin))
        let tag_kind = try required_text_member(declaration, "tagUsed", "C record at " + origin_text(origin))
        let tag = try optional_text_member(declaration, "name", "C record at " + origin_text(origin))
        let children = try optional_array_member(declaration, "inner", "C record at " + origin_text(origin)) else list[json.Json]()
        let fields = try decode_record_fields(children, origin)
        var c_spelling: str? = none
        var raw_name = ""
        if tag != none and tag != "":
            c_spelling = tag_kind + " " + tag
            raw_name = tag
        let record = ClangRecord(identity, tag_kind, c_spelling, fields, origin, raw_name)
        catalog.by_identity[identity] = record
        if c_spelling != none: catalog.identity_by_spelling[c_spelling] = identity
    return catalog

func decode_record_fields(children: list[json.Json], record_origin: FiirSourceOrigin) -> list[ClangRecordField]!:
    let fields = list[ClangRecordField]()
    for child in children:
        let kind = try optional_text_member(child, "kind", "C record child") else ""
        if kind != "FieldDecl": continue
        let name = try optional_text_member(child, "name", "C record field")
        var context = "C record field"
        if name != none: context = "C record field `" + name + "`"
        fields.append(ClangRecordField(
            name = name,
            type_spelling = try required_type_spelling(child, context),
            is_bitfield = try optional_bool_member(child, "isBitfield", context) else false,
            origin = try child_origin(child, record_origin),
        ))
    return fields

## Render one Clang-evaluated query for the target facts required by declarations
## owned by `header`: layout for reachable plain records, the format of a
## reachable `_Float16`, and values of accepted object constants. Luce never
## calculates or infers these target facts itself.
pub func render_target_fact_probe(document: str, header: str) -> str!:
    let root = json.parse(document) catch malformed:
        error("Clang FIIR: " + json.describe(malformed))
    let root_kind = try required_text_member(root, "kind", "translation unit")
    if root_kind != "TranslationUnitDecl":
        error("Clang FIIR: root kind is `" + root_kind + "`, expected `TranslationUnitDecl`")
    let declarations = try required_array_member(root, "inner", "translation unit")
    let enumerations = try collect_enumerations(declarations)
    let records = try collect_records(declarations)
    let typedefs = try collect_typedefs(declarations, enumerations, records)
    let identities = try reachable_record_identities(declarations, header, records, typedefs)
    let object_constants = constant_objects(try collect_objects(declarations, header, typedefs))
    let needs_float16 = try selected_declarations_use_float16(declarations, header, identities, records, typedefs)
    if len(identities) == 0 and not needs_float16 and len(object_constants) == 0: return ""
    var output = "/* Clang-evaluated FIIR target-fact probe. */\n"
    if len(object_constants) > 0: output += "#include <stdint.h>\n"
    for index in range(0, len(identities)):
        let record = records.by_identity[identities[index]]
        try validate_plain_record_shape(record)
        output += "#undef " + record_probe_name(index, "size_bits") + "\n"
        output += "#undef " + record_probe_name(index, "alignment_bits") + "\n"
        for field_index in range(0, len(record.fields)):
            output += "#undef " + record_probe_name(index, "field_" + str(field_index)) + "\n"
    if needs_float16:
        output += "#ifndef __FLT16_MANT_DIG__\n#error Clang does not expose _Float16 format facts\n#endif\n"
        output += "#ifndef __FLT16_MAX_EXP__\n#error Clang does not expose _Float16 format facts\n#endif\n"
        output += "#undef __luce_fiir_float16_size_bits\n"
        output += "#undef __luce_fiir_float16_radix\n"
        output += "#undef __luce_fiir_float16_significand_bits\n"
        output += "#undef __luce_fiir_float16_maximum_exponent\n"
    for index in range(0, len(object_constants)):
        output += "#undef " + object_constant_probe_name(index, "is_constant") + "\n"
        for word in range(0, 4):
            output += "#undef " + object_constant_probe_name(index, "word_" + str(word)) + "\n"
    output += "enum {\n"
    for index in range(0, len(identities)):
        let record = records.by_identity[identities[index]]
        let spelling = try record_c_reference(record)
        output += "    " + record_probe_name(index, "size_bits") + " = sizeof(" + spelling + ") * __CHAR_BIT__,\n"
        output += "    " + record_probe_name(index, "alignment_bits") + " = __alignof__(" + spelling + ") * __CHAR_BIT__,\n"
        for field_index in range(0, len(record.fields)):
            output += "    " + record_probe_name(index, "field_" + str(field_index)) + " = __builtin_offsetof(" + spelling + ", " + try record_field_name(record.fields[field_index]) + ") * __CHAR_BIT__,\n"
    if needs_float16:
        output += "    __luce_fiir_float16_size_bits = sizeof(_Float16) * __CHAR_BIT__,\n"
        output += "    __luce_fiir_float16_radix = __FLT_RADIX__,\n"
        output += "    __luce_fiir_float16_significand_bits = __FLT16_MANT_DIG__,\n"
        output += "    __luce_fiir_float16_maximum_exponent = __FLT16_MAX_EXP__,\n"
    for index in range(0, len(object_constants)):
        let name = object_constants[index].name
        let constant_check = "__builtin_constant_p(" + name + ")"
        output += "    " + object_constant_probe_name(index, "is_constant") + " = " + constant_check + ",\n"
        for word in range(0, 4):
            let shift = str(word * 16)
            output += "    " + object_constant_probe_name(index, "word_" + str(word)) + " = __builtin_choose_expr(" + constant_check + ", (int)(((uint64_t)(" + name + ") >> " + shift + ") & UINT64_C(65535)), 0),\n"
    return output + "};\n"

## Ask Clang for selected macro types inside one filtered function AST. Local
## `__auto_type` preserves typedef spelling without requiring the macro to be
## a constant expression; the separate value probe establishes that property.
pub func render_macro_type_probe(macro_definitions: list[ClangMacroDefinition]) -> str:
    if len(macro_definitions) == 0: return ""
    var output = "/* Clang-evaluated FIIR macro-type probe. */\n"
    output += "#pragma clang diagnostic push\n"
    output += "#pragma clang diagnostic ignored \"-Wgnu-auto-type\"\n"
    output += "#pragma clang diagnostic ignored \"-Wunused-variable\"\n"
    output += "#pragma clang diagnostic ignored \"-Wunused-function\"\n"
    output += "static void __luce_fiir_macro_type_facts(void) {\n"
    for index in range(0, len(macro_definitions)):
        let probe_name = macro_constant_type_probe_name(index)
        output += "#undef " + probe_name + "\n"
        output += "    __auto_type " + probe_name + " = (" + macro_definitions[index].name + ");\n"
    output += "}\n#pragma clang diagnostic pop\n"
    return output

## After the type-only probe has proved every selected macro is a supported
## fundamental integer, render a second probe for its evaluated value. Keeping
## the casts out of the first pass gives unsupported pointers, strings, and
## aggregates stable FIIR diagnostics instead of incidental C diagnostics.
pub func render_macro_value_probe(document: str, facts: ClangScalarFacts, macro_definitions: list[ClangMacroDefinition], target_fact_document: str) -> str!:
    if len(macro_definitions) == 0: return ""
    let root = json.parse(document) catch malformed:
        error("Clang FIIR: " + json.describe(malformed))
    let root_kind = try required_text_member(root, "kind", "translation unit")
    if root_kind != "TranslationUnitDecl":
        error("Clang FIIR: root kind is `" + root_kind + "`, expected `TranslationUnitDecl`")
    let declarations = try required_array_member(root, "inner", "translation unit")
    let enumerations = try collect_enumerations(declarations)
    let records = try collect_records(declarations)
    let typedefs = try collect_typedefs(declarations, enumerations, records)
    let interner = FiirTypeInterner(typedefs, enumerations, records, facts, none)
    discard(try decode_macro_constant_types(target_fact_document, macro_definitions, interner))
    var output = "/* Clang-evaluated FIIR macro-value probe. */\n#include <stdint.h>\n"
    for index in range(0, len(macro_definitions)):
        output += "#undef " + macro_constant_probe_name(index, "is_constant") + "\n"
        for word in range(0, 4):
            output += "#undef " + macro_constant_probe_name(index, "word_" + str(word)) + "\n"
    output += "enum __luce_fiir_macro_value_facts {\n"
    for index in range(0, len(macro_definitions)):
        let name = macro_definitions[index].name
        let constant_check = "__builtin_constant_p(" + name + ")"
        output += "    " + macro_constant_probe_name(index, "is_constant") + " = " + constant_check + ",\n"
        for word in range(0, 4):
            let shift = str(word * 16)
            output += "    " + macro_constant_probe_name(index, "word_" + str(word)) + " = __builtin_choose_expr(" + constant_check + ", (int)(((uint64_t)(" + name + ") >> " + shift + ") & UINT64_C(65535)), 0),\n"
    return output + "};\n"

func decode_target_fact_values(record_identities: list[str], needs_float16: bool, object_constant_count: i64, document: str) -> map[str, u64]!:
    let values = map[str, u64]()
    if len(record_identities) == 0 and not needs_float16 and object_constant_count == 0: return values
    if document == "":
        if object_constant_count > 0 and len(record_identities) == 0 and not needs_float16:
            error("Clang FIIR: C object constants have no Clang-evaluated target-fact probe")
        if needs_float16 and len(record_identities) > 0:
            error("Clang FIIR: reachable C records and _Float16 have no Clang-evaluated target-fact probe")
        if needs_float16: error("Clang FIIR: reachable C _Float16 has no Clang-evaluated target-fact probe")
        if object_constant_count > 0:
            error("Clang FIIR: selected C declarations have no Clang-evaluated target-fact probe")
        error("Clang FIIR: reachable C records have no Clang-evaluated target-fact probe")
    return try decode_fact_values(document, "target facts")

func decode_macro_fact_values(count: i64, document: str) -> map[str, u64]!:
    if count == 0: return map[str, u64]()
    if document == "": error("Clang FIIR: selected C macros have no Clang-evaluated value probe")
    return try decode_fact_values(document, "macro values")

func decode_fact_values(document: str, product: str) -> map[str, u64]!:
    let values = map[str, u64]()
    let root = json.parse(document) catch malformed:
        error("Clang FIIR " + product + ": " + json.describe(malformed))
    let root_kind = try required_text_member(root, "kind", product + " translation unit")
    let declarations = list[json.Json]()
    if root_kind == "TranslationUnitDecl":
        for declaration in try required_array_member(root, "inner", product + " translation unit"): declarations.append(declaration)
    elif root_kind == "EnumDecl": declarations.append(root)
    else:
        error("Clang FIIR " + product + ": root kind is `" + root_kind + "`, expected `TranslationUnitDecl` or `EnumDecl`")
    for declaration in declarations:
        let kind = try optional_text_member(declaration, "kind", product + " declaration") else ""
        if kind != "EnumDecl": continue
        let children = try optional_array_member(declaration, "inner", product + " enum") else list[json.Json]()
        for child in children:
            let child_kind = try optional_text_member(child, "kind", product + " enum child") else ""
            if child_kind != "EnumConstantDecl": continue
            let name = try required_text_member(child, "name", product + " constant")
            if not strings.starts_with(name, "__luce_fiir_record_") and not strings.starts_with(name, "__luce_fiir_float16_") and not strings.starts_with(name, "__luce_fiir_object_constant_") and not strings.starts_with(name, "__luce_fiir_macro_constant_"): continue
            let value = try explicit_enumeration_value(child, product + " constant `" + name + "`") else error("Clang FIIR " + product + ": `" + name + "` has no evaluated value")
            match value:
                Negative(magnitude): error("Clang FIIR " + product + ": `" + name + "` is negative")
                Nonnegative(integer): values[name] = integer
    return values

func decode_macro_constant_types(document: str, definitions: list[ClangMacroDefinition], interner: FiirTypeInterner) -> list[ClangMacroConstant]!:
    let constants = list[ClangMacroConstant]()
    if len(definitions) == 0: return constants
    if document == "": error("Clang FIIR: selected C macros have no Clang-evaluated type probe")
    let root = json.parse(document) catch malformed:
        error("Clang FIIR macro types: " + json.describe(malformed))
    let root_kind = try required_text_member(root, "kind", "macro-type AST")
    if root_kind != "TranslationUnitDecl" and root_kind != "FunctionDecl":
        error("Clang FIIR macro types: root kind is `" + root_kind + "`, expected `TranslationUnitDecl` or `FunctionDecl`")
    let spellings = map[str, str]()
    try collect_macro_probe_spellings(root, spellings)
    for index in range(0, len(definitions)):
        let probe_name = macro_constant_type_probe_name(index)
        if not spellings.has(probe_name): error("Clang FIIR macro types: missing probe variable `" + probe_name + "`")
        let selected_spelling = spellings[probe_name]
        if not spelling_resolves_to_integer(selected_spelling, interner.typedefs, list[str]()):
            error("Clang FIIR: selected C macro `" + definitions[index].name + "` has unsupported non-integer type `" + selected_spelling + "`")
        let value_type = try interner.intern(selected_spelling, "selected C macro `" + definitions[index].name + "`")
        let resolved = try interner.resolve(value_type)
        match resolved.form:
            Integer(kind, bits, is_signed):
                if bits > u16(64): error("Clang FIIR: selected C macro `" + definitions[index].name + "` exceeds the 64-bit portable integer domain")
            else:
                error("Clang FIIR: selected C macro `" + definitions[index].name + "` has unsupported non-integer type `" + selected_spelling + "`")
        constants.append(ClangMacroConstant(name = definitions[index].name, value_type = value_type, origin = definitions[index].origin))
    return constants

func collect_macro_probe_spellings(value: json.Json, spellings: map[str, str]) -> !:
    let kind = try optional_text_member(value, "kind", "macro-type AST node") else ""
    if kind == "VarDecl":
        let name = try optional_text_member(value, "name", "macro-type variable") else ""
        if strings.starts_with(name, "__luce_fiir_macro_constant_type_"):
            if spellings.has(name): error("Clang FIIR macro types: duplicate probe variable `" + name + "`")
            spellings[name] = try required_type_spelling(value, "macro-type probe variable `" + name + "`")
    let children = try optional_array_member(value, "inner", "macro-type AST node") else list[json.Json]()
    for child in children: try collect_macro_probe_spellings(child, spellings)

func apply_record_layouts(records: ClangRecordCatalog, identities: list[str], values: map[str, u64]) -> !:
    for index in range(0, len(identities)):
        let record = records.by_identity[identities[index]]
        record.size_bits = try required_target_fact_value(values, record_probe_name(index, "size_bits"))
        record.alignment_bits = try required_target_fact_value(values, record_probe_name(index, "alignment_bits"))
        let offsets = list[u64]()
        for field_index in range(0, len(record.fields)):
            offsets.append(try required_target_fact_value(values, record_probe_name(index, "field_" + str(field_index))))
        record.field_offsets = offsets

func decode_float16_facts(required: bool, values: map[str, u64]) -> ClangFloat16Facts?!:
    if not required: return none
    return ClangFloat16Facts(
        size_bits = try required_float16_u16(values, "size_bits"),
        radix = try required_float16_u16(values, "radix"),
        significand_bits = try required_float16_u16(values, "significand_bits"),
        maximum_exponent = i32(try required_float16_u16(values, "maximum_exponent")),
    )

func required_float16_u16(values: map[str, u64], suffix: str) -> u16!:
    let value = try required_target_fact_value(values, "__luce_fiir_float16_" + suffix)
    if value == u64(0) or value > u64(65535):
        error("Clang FIIR target facts: `_Float16` " + suffix + " is outside the supported range")
    return u16(value)

func required_target_fact_value(values: map[str, u64], name: str) -> u64!:
    return try required_fact_value(values, name, "target facts")

func required_fact_value(values: map[str, u64], name: str, product: str) -> u64!:
    if not values.has(name): error("Clang FIIR " + product + ": missing evaluated constant `" + name + "`")
    return values[name]

func record_probe_name(index: i64, suffix: str) -> str:
    return "__luce_fiir_record_" + str(index) + "_" + suffix

func object_constant_probe_name(index: i64, suffix: str) -> str:
    return "__luce_fiir_object_constant_" + str(index) + "_" + suffix

func macro_constant_type_probe_name(index: i64) -> str:
    return "__luce_fiir_macro_constant_type_" + str(index)

func macro_constant_probe_name(index: i64, suffix: str) -> str:
    return "__luce_fiir_macro_constant_" + str(index) + "_" + suffix

func append_object_constant(declaration: ClangObject, index: i64, values: map[str, u64], interner: FiirTypeInterner, constants: list[FiirConstant]) -> !:
    let value_type = try interner.intern(declaration.type_spelling, "C object constant `" + declaration.name + "`")
    let resolved = try interner.resolve(value_type)
    match resolved.form:
        Integer(kind, bits, is_signed):
            constants.append(FiirConstant(
                name = declaration.name,
                source = FiirConstantSource.object,
                value_type = value_type,
                value = FiirConstantValue.Integer(value = try decode_integer_probe_value("C object `" + declaration.name + "`", "C object `" + declaration.name + "`", "target facts", object_constant_probe_name(index, ""), is_signed, values)),
                origin = declaration.origin,
            ))
        else: error("Clang FIIR: C object constant `" + declaration.name + "` does not resolve to an integer type")

func append_external_object(declaration: ClangObject, access: FiirObjectAccess, interner: FiirTypeInterner, objects: list[FiirObject]) -> !:
    let value_type = try interner.intern(declaration.type_spelling, "external C object `" + declaration.name + "`")
    let resolved = try interner.resolve(value_type)
    match resolved.form:
        Boolean, Integer, Floating, Enumeration: pass
        else: error("Clang FIIR: external C object `" + declaration.name + "` has unsupported non-scalar type `" + declaration.type_spelling + "`")
    objects.append(FiirObject(
        name = declaration.name,
        value_type = value_type,
        access = access,
        is_volatile = declaration.is_volatile,
        origin = declaration.origin,
    ))

func append_macro_constant(declaration: ClangMacroConstant, index: i64, values: map[str, u64], interner: FiirTypeInterner, constants: list[FiirConstant]) -> !:
    let resolved = try interner.resolve(declaration.value_type)
    match resolved.form:
        Integer(kind, bits, is_signed):
            constants.append(FiirConstant(
                name = declaration.name,
                source = FiirConstantSource.macro,
                value_type = declaration.value_type,
                value = FiirConstantValue.Integer(value = try decode_integer_probe_value("selected C macro `" + declaration.name + "`", "C macro `" + declaration.name + "`", "macro values", macro_constant_probe_name(index, ""), is_signed, values)),
                origin = declaration.origin,
            ))
        else: error("Clang FIIR: selected C macro `" + declaration.name + "` does not resolve to an integer type")

func decode_integer_probe_value(context: str, fact_context: str, fact_product: str, prefix: str, is_signed: bool, values: map[str, u64]) -> FiirIntegerValue!:
    let is_constant = try required_fact_value(values, prefix + "is_constant", fact_product)
    if is_constant != u64(1):
        error("Clang FIIR: " + context + " does not have a Clang-evaluable constant value")
    var raw = u64(0)
    for word in range(0, 4):
        let part = try required_fact_value(values, prefix + "word_" + str(word), fact_product)
        if part > u64(65535):
            error("Clang FIIR " + fact_product + ": " + fact_context + " word " + str(word) + " exceeds 16 bits")
        raw = raw | (part << u64(word * 16))
    if is_signed and raw > u64(9223372036854775807):
        return FiirIntegerValue.Negative(magnitude = u64(18446744073709551615) - raw + u64(1))
    return FiirIntegerValue.Nonnegative(value = raw)

func record_c_reference(record: ClangRecord) -> str!:
    let spelling = record.c_spelling
    if spelling != none: return spelling
    if record.raw_name != "": return record.raw_name
    error("Clang FIIR: anonymous C record at " + origin_text(record.origin) + " needs a typedef name before it can be imported")

func validate_plain_record_shape(record: ClangRecord) -> !:
    if record.tag_kind != "struct":
        error("Clang FIIR: C `" + record.tag_kind + "` at " + origin_text(record.origin) + " is not supported by the plain-record importer yet")
    for field in record.fields:
        let name = try record_field_name(field)
        if field.is_bitfield:
            error("Clang FIIR: C record field `" + name + "` is a bit-field; generated plain-record adapters do not support bit-fields yet")

func record_field_name(field: ClangRecordField) -> str!:
    return field.name else error("Clang FIIR: generated plain-record adapters do not support unnamed C fields yet")

func reachable_record_identities(declarations: list[json.Json], header: str, records: ClangRecordCatalog, typedefs: map[str, ClangTypedef]) -> list[str]!:
    let identities = list[str]()
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        if origin == none or cursor.path != header: continue
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind == "RecordDecl":
            let identity = try required_text_member(declaration, "id", "C record at " + origin_text(origin))
            try append_reachable_record(identity, identities, records, typedefs)
        elif kind == "TypedefDecl":
            let name = try required_text_member(declaration, "name", "typedef at " + origin_text(origin))
            try append_record_spelling(name, identities, records, typedefs)
        elif kind == "FunctionDecl":
            let signature = try required_type_spelling(declaration, "C function at " + origin_text(origin))
            let delimiter = strings.find(signature, " (")
            if delimiter != none: try append_record_spelling(signature[:delimiter], identities, records, typedefs)
            let children = try optional_array_member(declaration, "inner", "C function at " + origin_text(origin)) else list[json.Json]()
            for child in children:
                let child_kind = try optional_text_member(child, "kind", "C function child") else ""
                if child_kind == "ParmVarDecl":
                    try append_record_spelling(try required_type_spelling(child, "C function parameter"), identities, records, typedefs)
    return identities

## Decide whether the selected declaration graph needs `_Float16` target
## facts. This follows only typedef and record edges already admitted by the
## importer; included-header declarations do not trigger work on their own.
func selected_declarations_use_float16(declarations: list[json.Json], header: str, record_identities: list[str], records: ClangRecordCatalog, typedefs: map[str, ClangTypedef]) -> bool!:
    for identity in record_identities:
        for field in records.by_identity[identity].fields:
            if spelling_resolves_to_float16(field.type_spelling, typedefs, list[str]()): return true
    let cursor = SourceCursor(path = "", line = u32(0))
    for declaration in declarations:
        let location = declaration.member("loc")
        if location == none: continue
        let origin = try update_origin(cursor, location)
        if origin == none or cursor.path != header: continue
        let kind = try optional_text_member(declaration, "kind", "declaration") else ""
        if kind == "TypedefDecl":
            let name = try required_text_member(declaration, "name", "typedef at " + origin_text(origin))
            if spelling_resolves_to_float16(name, typedefs, list[str]()): return true
        elif kind == "VarDecl":
            let name = try required_text_member(declaration, "name", "C object at " + origin_text(origin))
            if spelling_resolves_to_float16(try required_type_spelling(declaration, "C object `" + name + "`"), typedefs, list[str]()): return true
        elif kind == "FunctionDecl":
            let signature = try required_type_spelling(declaration, "C function at " + origin_text(origin))
            let delimiter = strings.find(signature, " (")
            if delimiter != none:
                if spelling_resolves_to_float16(signature[:delimiter], typedefs, list[str]()): return true
            let children = try optional_array_member(declaration, "inner", "C function at " + origin_text(origin)) else list[json.Json]()
            for child in children:
                let child_kind = try optional_text_member(child, "kind", "C function child") else ""
                if child_kind == "ParmVarDecl":
                    if spelling_resolves_to_float16(try required_type_spelling(child, "C function parameter"), typedefs, list[str]()): return true
    return false

func spelling_resolves_to_float16(spelling: str, typedefs: map[str, ClangTypedef], active: list[str]) -> bool:
    let canonical = unqualified_scalar_spelling(strings.trim(spelling))
    if canonical == "_Float16": return true
    if not typedefs.has(canonical): return false
    for name in active:
        if name == canonical: return false
    active.append(canonical)
    let result = spelling_resolves_to_float16(typedefs[canonical].target_spelling, typedefs, active)
    active.remove(len(active) - 1)
    return result

func append_record_spelling(spelling: str, identities: list[str], records: ClangRecordCatalog, typedefs: map[str, ClangTypedef]) -> !:
    let canonical = unqualified_scalar_spelling(strings.trim(spelling))
    if records.identity_by_spelling.has(canonical):
        try append_reachable_record(records.identity_by_spelling[canonical], identities, records, typedefs)
    elif typedefs.has(canonical):
        let target = typedefs[canonical].target_record_id
        if target != none: try append_reachable_record(target, identities, records, typedefs)

func append_reachable_record(identity: str, identities: list[str], records: ClangRecordCatalog, typedefs: map[str, ClangTypedef]) -> !:
    if not records.by_identity.has(identity): return
    let record = records.by_identity[identity]
    if record.tag_kind != "struct": return
    for existing in identities:
        if existing == identity: return
    identities.append(identity)
    for field in record.fields:
        try append_record_spelling(field.type_spelling, identities, records, typedefs)

func decode_enumeration_constants(children: list[json.Json], origin: FiirSourceOrigin) -> list[ClangEnumerationConstant]!:
    let constants = list[ClangEnumerationConstant]()
    var previous: FiirIntegerValue? = none
    for child in children:
        let kind = try optional_text_member(child, "kind", "C enum child") else ""
        if kind != "EnumConstantDecl": continue
        let name = try required_text_member(child, "name", "C enum constant")
        let case_origin = try child_origin(child, origin)
        let explicit = try explicit_enumeration_value(child, "C enum constant `" + name + "`")
        var value = FiirIntegerValue.Nonnegative(value = u64(0))
        if explicit != none: value = explicit
        elif previous != none: value = try increment_integer_value(previous, "C enum constant `" + name + "`")
        constants.append(ClangEnumerationConstant(
            declaration = FiirEnumCase(name = name, value = value, origin = case_origin),
            type_spelling = try required_type_spelling(child, "C enum constant `" + name + "`"),
        ))
        previous = value
    return constants

func explicit_enumeration_value(value: json.Json, context: str) -> FiirIntegerValue?!:
    let direct = try optional_text_member(value, "value", context)
    if direct != none: return try parse_integer_value(direct, context)
    let children = try optional_array_member(value, "inner", context) else list[json.Json]()
    if len(children) == 0: return none
    for child in children:
        let evaluated = try evaluated_integer_value(child, context + " expression")
        if evaluated != none: return evaluated
    error("Clang FIIR: " + context + " has no evaluated integer value")

func evaluated_integer_value(value: json.Json, context: str) -> FiirIntegerValue?!:
    let encoded = try optional_text_member(value, "value", context)
    if encoded != none: return try parse_integer_value(encoded, context)
    let children = try optional_array_member(value, "inner", context) else list[json.Json]()
    for child in children:
        let nested = try evaluated_integer_value(child, context)
        if nested != none: return nested
    return none

func parse_integer_value(encoded: str, context: str) -> FiirIntegerValue!:
    if strings.starts_with(encoded, "-"):
        let magnitude = parse_decimal_u64(encoded[1:]) catch reason:
            error("Clang FIIR: " + context + " value `" + encoded + "` is outside the supported C integer domain")
        if magnitude == u64(0): error("Clang FIIR: " + context + " has a noncanonical negative zero")
        if magnitude > u64(9223372036854775808):
            error("Clang FIIR: " + context + " value `" + encoded + "` is outside the supported C integer domain")
        return FiirIntegerValue.Negative(magnitude = magnitude)
    let value = parse_decimal_u64(encoded) catch reason:
        error("Clang FIIR: " + context + " value `" + encoded + "` is outside the supported C integer domain")
    return FiirIntegerValue.Nonnegative(value = value)

func parse_decimal_u64(encoded: str) -> u64!:
    if encoded == "": error("empty integer")
    var value = u64(0)
    let maximum = u64(18446744073709551615)
    for character in encoded:
        if character < '0' or character > '9': error("invalid decimal integer")
        let digit = u64(u32(character) - u32('0'))
        if value > (maximum - digit) // u64(10): error("decimal integer overflow")
        value = value * u64(10) + digit
    return value

func optional_text_equal(left: str?, right: str?) -> bool:
    let left_value = left
    let right_value = right
    if left_value == none: return right_value == none
    if right_value == none: return false
    return left_value == right_value

func increment_integer_value(value: FiirIntegerValue, context: str) -> FiirIntegerValue!:
    match value:
        Negative(magnitude):
            if magnitude == u64(1): return FiirIntegerValue.Nonnegative(value = u64(0))
            return FiirIntegerValue.Negative(magnitude = magnitude - u64(1))
        Nonnegative(integer):
            if integer == u64(18446744073709551615):
                error("Clang FIIR: " + context + " exceeds the supported C integer domain")
            return FiirIntegerValue.Nonnegative(value = integer + u64(1))

## A truly anonymous enumeration has no C type that clients can spell. Its
## enumerators do, however, have exact Clang-selected integer types and values,
## so preserve those as standalone declarations without fabricating a carrier.
func append_anonymous_enumeration_constants(enumeration: ClangEnumeration, interner: FiirTypeInterner, constants: list[FiirConstant]) -> !:
    for constant in enumeration.constants:
        let enum_case = constant.declaration
        let value_type = try interner.intern(constant.type_spelling, "C constant `" + enum_case.name + "`")
        constants.append(FiirConstant(
            name = enum_case.name,
            source = FiirConstantSource.anonymous_enumeration,
            value_type = value_type,
            value = FiirConstantValue.Integer(value = enum_case.value),
            origin = enum_case.origin,
        ))

func enumeration_cases(constants: list[ClangEnumerationConstant]) -> list[FiirEnumCase]:
    let cases = list[FiirEnumCase]()
    for constant in constants: cases.append(constant.declaration)
    return cases

func typedef_enumeration_identity(value: json.Json, context: str) -> str?!:
    let children = try optional_array_member(value, "inner", context) else list[json.Json]()
    for child in children:
        let nested = try optional_array_member(child, "inner", context + " type") else list[json.Json]()
        for nested_type in nested:
            let nested_kind = try optional_text_member(nested_type, "kind", context + " nested type") else ""
            if nested_kind != "EnumType": continue
            let declaration = nested_type.member("decl")
            if declaration == none: continue
            return try required_text_member(declaration, "id", context + " enum type")
        let owned = child.member("ownedTagDecl")
        if owned == none: continue
        let kind = try optional_text_member(owned, "kind", context + " owned tag") else ""
        if kind == "EnumDecl": return try required_text_member(owned, "id", context + " owned enum")
    return none

func typedef_record_identity(value: json.Json, context: str) -> str?!:
    let children = try optional_array_member(value, "inner", context) else list[json.Json]()
    for child in children:
        let nested = try optional_array_member(child, "inner", context + " type") else list[json.Json]()
        for nested_type in nested:
            let nested_kind = try optional_text_member(nested_type, "kind", context + " nested type") else ""
            if nested_kind != "RecordType": continue
            let declaration = nested_type.member("decl")
            if declaration == none: continue
            return try required_text_member(declaration, "id", context + " record type")
        let owned = child.member("ownedTagDecl")
        if owned == none: continue
        let kind = try optional_text_member(owned, "kind", context + " owned tag") else ""
        if kind == "RecordDecl": return try required_text_member(owned, "id", context + " owned record")
    return none

# mark: Function declarations =================================================================

func decode_function(value: json.Json, origin: FiirSourceOrigin, interner: FiirTypeInterner) -> FiirFunction!:
    let name = try required_text_member(value, "name", "function at " + origin_text(origin))
    let signature = try required_type_spelling(value, "function `" + name + "`")
    let delimiter = strings.find(signature, " (") else error("Clang FIIR: function `" + name + "` has unsupported type spelling `" + signature + "`")
    let result_spelling = signature[:delimiter]
    let result_type = try interner.intern(result_spelling, "function `" + name + "` result")
    let parameters = list[FiirParameter]()
    let children = try optional_array_member(value, "inner", "function `" + name + "`") else list[json.Json]()
    for child in children:
        let kind = try optional_text_member(child, "kind", "function `" + name + "` child") else ""
        if kind != "ParmVarDecl": continue
        let spelling = try required_type_spelling(child, "function `" + name + "` parameter")
        let parameter_type = try interner.intern(spelling, "function `" + name + "` parameter")
        let parameter_origin = try child_origin(child, origin)
        parameters.append(FiirParameter(
            name = try optional_text_member(child, "name", "function `" + name + "` parameter"),
            boundary = plain_value_boundary(parameter_type),
            origin = parameter_origin,
        ))
    let variadic = strings.ends_with(signature, ", ...)") or strings.ends_with(signature, "(...)")
    return FiirFunction(
        name = name,
        convention = FiirCallingConvention.c,
        parameters = parameters,
        result = plain_value_boundary(result_type),
        is_variadic = variadic,
        can_throw = false,
        conditions = list[str](),
        origin = origin,
    )

# mark: C value types ==========================================================================

class FiirTypeInterner:
    pub let types: list[FiirType]
    let type_ids: map[str, FiirTypeId]
    let resolving: list[str]
    let typedefs: map[str, ClangTypedef]
    let enumerations: ClangEnumerationCatalog
    let enumeration_type_ids: map[str, FiirTypeId]
    let records: ClangRecordCatalog
    let record_type_ids: map[str, FiirTypeId]
    let resolving_records: list[str]
    let facts: ClangScalarFacts
    let float16_facts: ClangFloat16Facts?

    init(typedefs: map[str, ClangTypedef], enumerations: ClangEnumerationCatalog, records: ClangRecordCatalog, facts: ClangScalarFacts, float16_facts: ClangFloat16Facts?):
        self.types = list[FiirType]()
        self.type_ids = map[str, FiirTypeId]()
        self.resolving = list[str]()
        self.typedefs = typedefs
        self.enumerations = enumerations
        self.enumeration_type_ids = map[str, FiirTypeId]()
        self.records = records
        self.record_type_ids = map[str, FiirTypeId]()
        self.resolving_records = list[str]()
        self.facts = facts
        self.float16_facts = float16_facts

    ## Resolve an already-interned typedef chain while the FIIR module is still
    ## under construction. The public schema resolver takes over after sealing.
    func resolve(value_type: FiirTypeId) -> FiirType!:
        var current = value_type
        for depth in range(0, len(self.types)):
            if i64(current.value) >= len(self.types): error("Clang FIIR: cannot resolve an unknown interned type")
            let resolved = self.types[current.value]
            match resolved.form:
                Typedef(target, origin): current = target
                else: return resolved
        error("Clang FIIR: interned typedef graph is cyclic")

    func intern(spelling: str, context: str) -> FiirTypeId!:
        var canonical = strings.trim(spelling)
        if not self.typedefs.has(canonical): canonical = unqualified_scalar_spelling(canonical)
        if self.type_ids.has(canonical): return self.type_ids[canonical]

        var value_type = FiirType(spelling = canonical, form = FiirTypeForm.Unit, size_bits = none)
        if self.typedefs.has(canonical):
            for active in self.resolving:
                if active == canonical: error("Clang FIIR: typedef `" + canonical + "` forms a cycle")
            self.resolving.append(canonical)
            let declaration = self.typedefs[canonical]
            let target = self.intern_typedef_target(declaration, "typedef `" + canonical + "` target") catch reason:
                self.resolving.remove(len(self.resolving) - 1)
                error(reason)
            self.resolving.remove(len(self.resolving) - 1)
            let target_type = self.types[target.value]
            value_type = FiirType(
                spelling = canonical,
                form = FiirTypeForm.Typedef(target = target, origin = declaration.origin),
                size_bits = target_type.size_bits,
            )
        elif self.enumerations.identity_by_spelling.has(canonical):
            return try self.intern_enumeration(self.enumerations.identity_by_spelling[canonical], context)
        elif self.records.identity_by_spelling.has(canonical):
            return try self.intern_record(self.records.identity_by_spelling[canonical], context)
        elif canonical == "void":
            pass
        elif canonical == "_Bool" or canonical == "bool":
            value_type = FiirType(spelling = canonical, form = FiirTypeForm.Boolean, size_bits = self.facts.bool_size_bits)
        else:
            let integer_kind = fundamental_integer_kind(canonical)
            if integer_kind != none:
                value_type = integer_type_from_facts(canonical, integer_kind, self.facts)
            elif canonical == "_Float16":
                let float16 = self.float16_facts else error("Clang FIIR: " + context + " uses `_Float16` without evaluated target facts")
                value_type = floating_type(canonical, FiirCFloatingKind.float16, float16.size_bits, float16.radix, float16.significand_bits, float16.maximum_exponent)
            elif canonical == "float":
                value_type = floating_type(canonical, FiirCFloatingKind.single, self.facts.float_storage_bits, self.facts.float_radix, self.facts.float_significand_bits, self.facts.float_maximum_exponent)
            elif canonical == "double":
                value_type = floating_type(canonical, FiirCFloatingKind.double, self.facts.double_storage_bits, self.facts.float_radix, self.facts.double_significand_bits, self.facts.double_maximum_exponent)
            elif canonical == "long double":
                value_type = floating_type(canonical, FiirCFloatingKind.long_double, self.facts.long_double_storage_bits, self.facts.float_radix, self.facts.long_double_significand_bits, self.facts.long_double_maximum_exponent)
            else:
                error("Clang FIIR: " + context + " type `" + canonical + "` is not supported by the value-function importer yet")
        self.types.append(value_type)
        let identity = FiirTypeId(value = u32(len(self.types) - 1))
        self.type_ids[canonical] = identity
        return identity

    func intern_typedef_target(declaration: ClangTypedef, context: str) -> FiirTypeId!:
        let enumeration = declaration.target_enum_id
        if enumeration != none:
            return try self.intern_enumeration(enumeration, context)
        let record = declaration.target_record_id
        if record != none:
            return try self.intern_record(record, context)
        return try self.intern(declaration.target_spelling, context)

    func intern_enumeration(identity: str, context: str) -> FiirTypeId!:
        if self.enumeration_type_ids.has(identity): return self.enumeration_type_ids[identity]
        if not self.enumerations.by_identity.has(identity):
            error("Clang FIIR: " + context + " names an unknown C enum declaration")
        let declaration = self.enumerations.by_identity[identity]
        if declaration.raw_name == "":
            error("Clang FIIR: anonymous C enum at " + origin_text(declaration.origin) + " needs a typedef name before it can be imported as a type")
        var spelling = declaration.c_spelling else "anonymous enum at " + origin_text(declaration.origin)
        let value_type = FiirType(
            spelling = spelling,
            form = FiirTypeForm.Enumeration(
                name = declaration.raw_name,
                c_spelling = declaration.c_spelling,
                cases = enumeration_cases(declaration.constants),
                origin = declaration.origin,
            ),
            size_bits = none,
        )
        self.types.append(value_type)
        let type_id = FiirTypeId(value = u32(len(self.types) - 1))
        self.enumeration_type_ids[identity] = type_id
        let c_spelling = declaration.c_spelling
        if c_spelling != none: self.type_ids[c_spelling] = type_id
        return type_id

    func intern_record(identity: str, context: str) -> FiirTypeId!:
        if self.record_type_ids.has(identity): return self.record_type_ids[identity]
        if not self.records.by_identity.has(identity):
            error("Clang FIIR: " + context + " names an unknown C record declaration")
        for active in self.resolving_records:
            if active == identity: error("Clang FIIR: C record at " + origin_text(self.records.by_identity[identity].origin) + " contains itself by value")
        let declaration = self.records.by_identity[identity]
        try validate_plain_record_shape(declaration)
        if declaration.raw_name == "":
            error("Clang FIIR: anonymous C record at " + origin_text(declaration.origin) + " needs a typedef name before it can be imported")
        if len(declaration.field_offsets) != len(declaration.fields):
            error("Clang FIIR: C record `" + declaration.raw_name + "` has incomplete Clang-evaluated field offsets")
        self.resolving_records.append(identity)
        let fields = list[FiirRecordField]()
        for index in range(0, len(declaration.fields)):
            let field = declaration.fields[index]
            let field_name = try record_field_name(field)
            let value_type = self.intern(field.type_spelling, "C record `" + declaration.raw_name + "` field `" + field_name + "`") catch reason:
                self.resolving_records.remove(len(self.resolving_records) - 1)
                error(reason)
            fields.append(FiirRecordField(name = field_name, value_type = value_type, offset_bits = declaration.field_offsets[index], origin = field.origin))
        self.resolving_records.remove(len(self.resolving_records) - 1)
        var spelling = declaration.c_spelling else "anonymous record at " + origin_text(declaration.origin)
        let value_type = FiirType(
            spelling = spelling,
            form = FiirTypeForm.Record(
                name = declaration.raw_name,
                c_spelling = declaration.c_spelling,
                fields = fields,
                size_bits = declaration.size_bits,
                alignment_bits = declaration.alignment_bits,
                origin = declaration.origin,
            ),
            size_bits = none,
        )
        self.types.append(value_type)
        let type_id = FiirTypeId(value = u32(len(self.types) - 1))
        self.record_type_ids[identity] = type_id
        let c_spelling = declaration.c_spelling
        if c_spelling != none: self.type_ids[c_spelling] = type_id
        return type_id

func unqualified_scalar_spelling(spelling: str) -> str:
    var result = spelling
    while true:
        if strings.starts_with(result, "const "): result = strings.trim(result[6:])
        elif strings.starts_with(result, "volatile "): result = strings.trim(result[9:])
        else: return result

## Classify every spelling Clang may use for a fundamental integer in one
## place. Import admissibility and FIIR interning must never drift apart.
func fundamental_integer_kind(spelling: str) -> FiirCIntegerKind?:
    if spelling == "char": return FiirCIntegerKind.plain_char
    if spelling == "signed char": return FiirCIntegerKind.signed_char
    if spelling == "unsigned char": return FiirCIntegerKind.unsigned_char
    if spelling == "short" or spelling == "short int" or spelling == "signed short" or spelling == "signed short int": return FiirCIntegerKind.signed_short
    if spelling == "unsigned short" or spelling == "unsigned short int": return FiirCIntegerKind.unsigned_short
    if spelling == "int" or spelling == "signed" or spelling == "signed int": return FiirCIntegerKind.signed_int
    if spelling == "unsigned" or spelling == "unsigned int": return FiirCIntegerKind.unsigned_int
    if spelling == "long" or spelling == "long int" or spelling == "signed long" or spelling == "signed long int": return FiirCIntegerKind.signed_long
    if spelling == "unsigned long" or spelling == "unsigned long int": return FiirCIntegerKind.unsigned_long
    if spelling == "long long" or spelling == "long long int" or spelling == "signed long long" or spelling == "signed long long int": return FiirCIntegerKind.signed_long_long
    if spelling == "unsigned long long" or spelling == "unsigned long long int": return FiirCIntegerKind.unsigned_long_long
    return none

func integer_type_from_facts(spelling: str, kind: FiirCIntegerKind, facts: ClangScalarFacts) -> FiirType:
    return match kind:
        plain_char => integer_type(spelling, kind, facts.char_size_bits, facts.char_size_bits, facts.plain_char_is_signed)
        signed_char => integer_type(spelling, kind, facts.char_size_bits, facts.char_size_bits, true)
        unsigned_char => integer_type(spelling, kind, facts.char_size_bits, facts.char_size_bits, false)
        signed_short => integer_type(spelling, kind, facts.short_value_bits, facts.short_size_bits, true)
        unsigned_short => integer_type(spelling, kind, facts.short_value_bits, facts.short_size_bits, false)
        signed_int => integer_type(spelling, kind, facts.int_value_bits, facts.int_size_bits, true)
        unsigned_int => integer_type(spelling, kind, facts.int_value_bits, facts.int_size_bits, false)
        signed_long => integer_type(spelling, kind, facts.long_value_bits, facts.long_size_bits, true)
        unsigned_long => integer_type(spelling, kind, facts.long_value_bits, facts.long_size_bits, false)
        signed_long_long => integer_type(spelling, kind, facts.long_long_value_bits, facts.long_long_size_bits, true)
        unsigned_long_long => integer_type(spelling, kind, facts.long_long_value_bits, facts.long_long_size_bits, false)

func integer_type(spelling: str, kind: FiirCIntegerKind, bits: u16, size_bits: u16, is_signed: bool) -> FiirType:
    return FiirType(spelling = spelling, form = FiirTypeForm.Integer(kind = kind, bits = bits, is_signed = is_signed), size_bits = size_bits)

func floating_type(spelling: str, kind: FiirCFloatingKind, size_bits: u16, radix: u16, significand_bits: u16, maximum_exponent: i32) -> FiirType:
    return FiirType(
        spelling = spelling,
        form = FiirTypeForm.Floating(kind = kind, radix = radix, significand_bits = significand_bits, maximum_exponent = maximum_exponent),
        size_bits = size_bits,
    )

# mark: JSON shape helpers =====================================================================

func required_type_spelling(value: json.Json, context: str) -> str!:
    let type_value = value.member("type") else error("Clang FIIR: " + context + " has no type")
    return try required_text_member(type_value, "qualType", context + " type")

func required_text_member(value: json.Json, name: str, context: str) -> str!:
    return try optional_text_member(value, name, context) else error("Clang FIIR: " + context + " has no `" + name + "`")

func optional_text_member(value: json.Json, name: str, context: str) -> str?!:
    match value:
        object(fields):
            if not fields.has(name): return none
            let text = fields[name].as_text()
            if text == none: error("Clang FIIR: " + context + " member `" + name + "` is not text")
            return text
        else: error("Clang FIIR: " + context + " is not an object")

func optional_bool_member(value: json.Json, name: str, context: str) -> bool?!:
    match value:
        object(fields):
            if not fields.has(name): return none
            let boolean = fields[name].as_bool()
            if boolean == none: error("Clang FIIR: " + context + " member `" + name + "` is not Boolean")
            return boolean
        else: error("Clang FIIR: " + context + " is not an object")

func required_array_member(value: json.Json, name: str, context: str) -> list[json.Json]!:
    return try optional_array_member(value, name, context) else error("Clang FIIR: " + context + " has no `" + name + "`")

func optional_array_member(value: json.Json, name: str, context: str) -> list[json.Json]?!:
    match value:
        object(fields):
            if not fields.has(name): return none
            match fields[name]:
                array(items): return items
                else: error("Clang FIIR: " + context + " member `" + name + "` is not an array")
        else: error("Clang FIIR: " + context + " is not an object")

func update_origin(cursor: SourceCursor, location: json.Json) -> FiirSourceOrigin?!:
    let path = try optional_text_member(location, "file", "source location")
    if path != none:
        cursor.path = path
    let line = try optional_integer_member(location, "line", "source location")
    if line != none:
        if line <= 0 or line > 4294967295: return none
        cursor.line = u32(line)
    let column = try optional_integer_member(location, "col", "source location")
    if column != none:
        if cursor.path == "" or cursor.line == u32(0) or column <= 0 or column > 4294967295: return none
        return FiirSourceOrigin(path = cursor.path, line = cursor.line, column = u32(column))
    return none

func child_origin(value: json.Json, parent: FiirSourceOrigin) -> FiirSourceOrigin!:
    let location = value.member("loc")
    if location != none:
        let line_value = try optional_integer_member(location, "line", "parameter source location") else i64(parent.line)
        let column_value = try optional_integer_member(location, "col", "parameter source location") else i64(parent.column)
        let path = try optional_text_member(location, "file", "parameter source location") else parent.path
        if line_value <= 0 or line_value > 4294967295 or column_value <= 0 or column_value > 4294967295:
            return parent
        return FiirSourceOrigin(path = path, line = u32(line_value), column = u32(column_value))
    return parent

func optional_integer_member(value: json.Json, name: str, context: str) -> i64?!:
    match value:
        object(fields):
            if not fields.has(name): return none
            let integer = fields[name].as_i64()
            if integer == none: error("Clang FIIR: " + context + " member `" + name + "` is not an integer")
            return integer
        else: error("Clang FIIR: " + context + " is not an object")

func origin_text(origin: FiirSourceOrigin) -> str:
    return origin.path + ":" + str(origin.line) + ":" + str(origin.column)
