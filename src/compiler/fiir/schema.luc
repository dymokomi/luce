#==============================================================================================
#
#   fiir.schema - Backend-independent foreign interface facts
#
#   DESCRIPTION:
#       FIIR is the checked boundary between Clang's target-specific view of a
#       C header and generated Luce source. It records facts; it is not HIR,
#       canonical MIR, or an ABI-lowering mechanism. A generator may consume
#       target facts here, but none of them may flow into the shared semantic
#       representations.
#
#       The closed vocabulary covers C scalar typedefs, enumerations, plain
#       records, opaque record handles, scalar and enumeration constants,
#       external scalar objects, and functions.
#       Later C declaration families extend it only when their complete value,
#       layout, and ownership contracts exist.
#
#==============================================================================================

# mark: Identities =============================================================================

## Dense identity into one FIIR module's type table.
pub struct FiirTypeId:
    pub let value: u32

# mark: Source and target facts ================================================================

pub enum FiirLanguage:
    c

pub enum FiirCallingConvention:
    c

## Fundamental C integer identity is distinct from target width. `long` and
## `long long`, for example, remain different FIIR types even on targets where
## Clang reports the same representation for both. Plain `char` keeps its own
## identity because its signedness is a target fact.
pub enum FiirCIntegerKind:
    plain_char
    signed_char
    unsigned_char
    signed_short
    unsigned_short
    signed_int
    unsigned_int
    signed_long
    unsigned_long
    signed_long_long
    unsigned_long_long

## Fundamental C floating identity is separate from its target model. In
## particular, `_Float16`, `float`, `double`, and `long double` remain distinct
## even where one representation can carry another type's complete value set.
pub enum FiirCFloatingKind:
    float16
    single
    double
    long_double

## Exact declaration location reported by the foreign frontend.
pub struct FiirSourceOrigin:
    pub let path: str
    pub let line: u32
    pub let column: u32

## C integer constants use a canonical sign-magnitude form. This represents
## every value in the union of `i64` and `u64` without making the selected
## target's signedness part of generated Luce source.
pub union FiirIntegerValue:
    Negative(magnitude: u64)
    Nonnegative(value: u64)

## Parse the canonical base-ten spelling used by Clang facts and recipe
## integers without narrowing the unsigned half of FIIR's value domain.
pub func parse_fiir_decimal_u64(encoded: str) -> u64!:
    if encoded == "": error("empty integer")
    var value = u64(0)
    let maximum = u64(18446744073709551615)
    for character in encoded:
        if character < '0' or character > '9': error("invalid decimal integer")
        let digit = u64(u32(character) - u32('0'))
        if value > (maximum - digit) // u64(10): error("decimal integer overflow")
        value = value * u64(10) + digit
    return value

pub struct FiirEnumCase:
    pub let name: str
    pub let value: FiirIntegerValue
    pub let origin: FiirSourceOrigin

## One declared field and its exact Clang-selected bit offset. Field types are
## ordinary FIIR identities; a record therefore adds layout facts without
## changing the target-independent value graph generated from those fields.
pub struct FiirRecordField:
    pub let name: str
    pub let value_type: FiirTypeId
    pub let offset_bits: u64
    pub let origin: FiirSourceOrigin

## One type as understood for the selected foreign target. Direct scalar
## widths are Clang facts stored in FIIR; adapter-mediated types deliberately
## carry no physical size because no shared IR or backend calls them directly.
pub union FiirTypeForm:
    Unit
    Boolean
    ## `bits` is Clang's value-representation width. `size_bits` below is the
    ## separate object-representation width and may be larger on a padded C
    ## target.
    Integer(kind: FiirCIntegerKind, bits: u16, is_signed: bool)
    ## These are C's exact floating-model facts, not an inference from
    ## `sizeof`. Together with `size_bits` they distinguish IEEE interchange
    ## formats from extended and padded representations.
    Floating(kind: FiirCFloatingKind, radix: u16, significand_bits: u16, maximum_exponent: i32)
    ## A C enumeration crosses the generated adapter as a sign-magnitude
    ## logical value. `name` is its stable Luce carrier name; `c_spelling` is
    ## present only when the C tag itself can be named independently of a
    ## typedef. No target enum width or ABI placement enters HIR or MIR.
    Enumeration(name: str, c_spelling: str?, cases: list[FiirEnumCase], origin: FiirSourceOrigin)
    ## A plain C struct retains Clang's object-layout facts for audit and future
    ## direct backends. Generated Luce exposes only its declaration-order value
    ## fields; QBE reaches the real C object through a fieldwise C adapter.
    Record(name: str, c_spelling: str?, fields: list[FiirRecordField], size_bits: u64, alignment_bits: u64, origin: FiirSourceOrigin)
    ## A pointer to an incomplete C record is one opaque nominal handle. The
    ## generated C adapter alone sees `c_spelling`; generated Luce, HIR, and
    ## MIR retain only `name` and the boundary facts below. This is deliberately
    ## not a general pointer form: pointee access needs an explicit storage and
    ## lifetime contract before it can enter FIIR.
    OpaqueHandle(name: str, c_spelling: str, origin: FiirSourceOrigin)
    ## A C typedef remains a named boundary identity even though C considers
    ## it compatible with its target. The target precedes the typedef in the
    ## type table, which makes the graph acyclic and deterministic.
    Typedef(target: FiirTypeId, origin: FiirSourceOrigin)

pub struct FiirType:
    ## Clang's canonical spelling remains available in diagnostics and the
    ## serialized FIIR product even when generation selects a Luce scalar.
    pub let spelling: str
    pub let form: FiirTypeForm
    pub let size_bits: u16?

# mark: Boundary contracts ====================================================================

## These are facts available from the foreign declaration itself. Ownership
## and lifetime are intentionally absent: a C pointer spelling cannot prove
## either, and binding recipes live in their own section below.
pub enum FiirNullability:
    not_applicable
    unspecified
    nonnull
    nullable

pub enum FiirMutability:
    not_applicable
    unspecified
    read_only
    mutable

pub struct FiirBoundaryValue:
    pub let value_type: FiirTypeId
    pub let nullability: FiirNullability
    pub let mutability: FiirMutability

pub func plain_value_boundary(value_type: FiirTypeId) -> FiirBoundaryValue:
    return FiirBoundaryValue(
        value_type = value_type,
        nullability = FiirNullability.not_applicable,
        mutability = FiirMutability.not_applicable,
    )

# mark: Binding recipe facts ==================================================================

## A recipe parameter is borrowed only for the duration of its foreign call.
## The safe wrapper accepts a checked borrow capability rather than exposing
## the raw opaque handle.
pub enum FiirRecipeParameterUse:
    borrowed_for_call

pub struct FiirRecipeParameter:
    pub let index: u32
    pub let use: FiirRecipeParameterUse
    pub let origin: FiirSourceOrigin

## Result facts are closed semantic relationships, not free-form annotations.
## An owned handle names its exact disposer. A returned borrow names the input
## whose owner anchors it. A status result names the one successful C integer
## value and the stable Luce failure raised for every other value.
pub union FiirRecipeResult:
    Owned(disposer: str)
    Borrowed(source_parameter: u32)
    Status(success: FiirIntegerValue, error_code: u32, message: str)

pub struct FiirFunctionRecipe:
    pub let name: str
    pub let parameters: list[FiirRecipeParameter]
    pub let result: FiirRecipeResult?
    pub let origin: FiirSourceOrigin

## One reviewed recipe belongs to one generated binding. `path` and every
## entry origin remain durable regeneration evidence alongside Clang's facts.
pub struct FiirBindingRecipe:
    pub let binding: str
    pub let path: str
    pub let functions: list[FiirFunctionRecipe]

# mark: Declarations ===========================================================================

pub struct FiirParameter:
    ## C permits unnamed prototype parameters. Generation supplies a stable
    ## positional name without pretending that it came from the header.
    pub let name: str?
    pub let boundary: FiirBoundaryValue
    pub let origin: FiirSourceOrigin

## Constant values retain their semantic kind instead of being flattened to
## source text. Floating constants keep Clang's exact IEEE encoding; generated
## Luce later maps all NaN payloads to the language's one observable NaN.
pub union FiirConstantValue:
    Integer(value: FiirIntegerValue)
    Boolean(value: bool)
    Floating(bits: u64)
    Enumeration(value: FiirIntegerValue)

## How a standalone FIIR constant entered the foreign declaration graph.
## Keeping this explicit makes regeneration inputs auditable without changing
## the target-independent value representation.
pub enum FiirConstantSource:
    anonymous_enumeration
    object
    macro

pub struct FiirConstant:
    pub let name: str
    pub let source: FiirConstantSource
    pub let value_type: FiirTypeId
    pub let value: FiirConstantValue
    pub let origin: FiirSourceOrigin

## Storage access exposed by one foreign object declaration. Read-only is a
## declaration property, not an ownership or pointer qualifier: generated
## accessors preserve it without placing target object layout in HIR or MIR.
pub enum FiirObjectAccess:
    read_only
    read_write

pub struct FiirObject:
    pub let name: str
    pub let value_type: FiirTypeId
    pub let access: FiirObjectAccess
    ## Volatile access remains a C-backend effect. Recording the qualifier in
    ## FIIR keeps the imported declaration auditable without inventing a
    ## volatile Luce value or MIR operation.
    pub let is_volatile: bool
    pub let origin: FiirSourceOrigin

pub struct FiirFunction:
    pub let name: str
    pub let convention: FiirCallingConvention
    pub let parameters: list[FiirParameter]
    pub let result: FiirBoundaryValue
    pub let is_variadic: bool
    ## C has no exception model. This explicit fact prevents future C++ FIIR
    ## from silently reusing the C contract after that post-1.0 work begins.
    pub let can_throw: bool
    pub let conditions: list[str]
    pub let origin: FiirSourceOrigin

## One deterministic FIIR product for one Clang invocation and one header.
pub struct FiirModule:
    pub let format_version: u32
    pub let language: FiirLanguage
    pub let generator_version: str
    pub let header: str
    pub let target: str
    pub let clang_arguments: list[str]
    pub let types: list[FiirType]
    pub let constants: list[FiirConstant]
    pub let objects: list[FiirObject]
    pub let functions: list[FiirFunction]
    pub let recipe: FiirBindingRecipe?

# mark: Validation =============================================================================

## Reject incomplete or internally inconsistent foreign facts before any raw
## source is generated. This is deliberately independent of Luce HIR.
pub func validate_fiir(module: FiirModule) -> !:
    if module.format_version != u32(2):
        error("FIIR: unsupported format version " + str(module.format_version))
    if module.generator_version == "": error("FIIR: generator version cannot be empty")
    if module.header == "": error("FIIR: source header cannot be empty")
    if module.target == "": error("FIIR: target cannot be empty")

    let type_spellings = map[str, bool]()
    for type_index in range(0, len(module.types)):
        let value_type = module.types[type_index]
        if value_type.spelling == "": error("FIIR: type spelling cannot be empty")
        if type_spellings.has(value_type.spelling):
            error("FIIR: duplicate type spelling `" + value_type.spelling + "`")
        type_spellings[value_type.spelling] = true
        match value_type.form:
            Unit:
                if value_type.size_bits != none: error("FIIR: `void` cannot have a size")
            Boolean:
                discard(try require_positive_size(value_type))
            Integer(kind, bits, is_signed):
                if bits == u16(0): error("FIIR: integer width must be positive")
                let required_sign = c_integer_kind_is_signed(kind)
                if required_sign != none:
                    if required_sign != is_signed:
                        error("FIIR: type `" + value_type.spelling + "` has the wrong signedness for its C integer kind")
                let size = try require_positive_size(value_type)
                if size < bits:
                    error("FIIR: type `" + value_type.spelling + "` value width exceeds its target size")
            Floating(kind, radix, significand_bits, maximum_exponent):
                if radix < u16(2): error("FIIR: floating radix must be at least two")
                if significand_bits == u16(0): error("FIIR: floating significand width must be positive")
                if maximum_exponent <= i32(0): error("FIIR: floating maximum exponent must be positive")
                discard(try require_positive_size(value_type))
            Enumeration(name, c_spelling, cases, origin):
                if value_type.size_bits != none:
                    error("FIIR: adapter-mediated C enum `" + name + "` cannot carry target size")
                if not is_c_identifier(name):
                    error("FIIR: C enum carrier `" + name + "` is not a portable identifier")
                if c_spelling != none and c_spelling != "enum " + name:
                    error("FIIR: C enum `" + name + "` has inconsistent tag spelling")
                try validate_origin(origin, "C enum `" + name + "`")
                if len(cases) == 0: error("FIIR: C enum `" + name + "` has no constants")
                let case_names = map[str, bool]()
                for enum_case in cases:
                    if not is_c_identifier(enum_case.name):
                        error("FIIR: C enum constant `" + enum_case.name + "` is not a portable identifier")
                    if case_names.has(enum_case.name):
                        error("FIIR: C enum `" + name + "` repeats constant `" + enum_case.name + "`")
                    case_names[enum_case.name] = true
                    match enum_case.value:
                        Negative(magnitude):
                            if magnitude == u64(0): error("FIIR: a negative C enum constant must have positive magnitude")
                            if magnitude > u64(9223372036854775808):
                                error("FIIR: a negative C enum constant is outside the supported 64-bit domain")
                        Nonnegative(value): pass
                    try validate_origin(enum_case.origin, "C enum constant `" + enum_case.name + "`")
            Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
                if value_type.size_bits != none:
                    error("FIIR: adapter-mediated C record `" + name + "` cannot use scalar size storage")
                if not is_c_identifier(name):
                    error("FIIR: C record carrier `" + name + "` is not a portable identifier")
                if c_spelling != none and c_spelling != "struct " + name:
                    error("FIIR: C record `" + name + "` has inconsistent tag spelling")
                try validate_origin(origin, "C record `" + name + "`")
                if len(fields) == 0: error("FIIR: C record `" + name + "` has no fields")
                if size_bits == u64(0): error("FIIR: C record `" + name + "` has zero size")
                if alignment_bits == u64(0): error("FIIR: C record `" + name + "` has zero alignment")
                if size_bits % alignment_bits != u64(0):
                    error("FIIR: C record `" + name + "` size is not a multiple of its alignment")
                let field_names = map[str, bool]()
                var previous_offset = u64(0)
                for field_index in range(0, len(fields)):
                    let field = fields[field_index]
                    if not is_c_identifier(field.name):
                        error("FIIR: C record `" + name + "` field `" + field.name + "` is not a portable identifier")
                    if field_names.has(field.name):
                        error("FIIR: C record `" + name + "` repeats field `" + field.name + "`")
                    field_names[field.name] = true
                    try validate_origin(field.origin, "C record `" + name + "` field `" + field.name + "`")
                    if i64(field.value_type.value) >= type_index:
                        error("FIIR: C record `" + name + "` field `" + field.name + "` type must precede it")
                    if field.offset_bits >= size_bits:
                        error("FIIR: C record `" + name + "` field `" + field.name + "` begins outside the record")
                    if field_index > 0 and field.offset_bits <= previous_offset:
                        error("FIIR: C record `" + name + "` field offsets are not in declaration order")
                    previous_offset = field.offset_bits
            OpaqueHandle(name, c_spelling, origin):
                if value_type.size_bits != none:
                    error("FIIR: adapter-mediated opaque C handle `" + name + "` cannot carry target size")
                if not is_c_identifier(name):
                    error("FIIR: opaque C handle `" + name + "` is not a portable identifier")
                if c_spelling != name + " *":
                    error("FIIR: opaque C handle `" + name + "` has inconsistent pointer spelling")
                try validate_origin(origin, "opaque C handle `" + name + "`")
            Typedef(target, origin):
                if not is_c_identifier(value_type.spelling):
                    error("FIIR: typedef `" + value_type.spelling + "` is not a portable C identifier")
                try validate_origin(origin, "typedef `" + value_type.spelling + "`")
                if i64(target.value) >= type_index:
                    error("FIIR: typedef `" + value_type.spelling + "` target must precede it")
                let target_type = module.types[target.value]
                match target_type.form:
                    Unit: error("FIIR: typedef `" + value_type.spelling + "` cannot name `void` in the value vocabulary")
                    else: pass
                let resolved = try resolve_fiir_type(module, target)
                match resolved.form:
                    Enumeration(name, c_spelling, cases, enum_origin):
                        if value_type.size_bits != none or target_type.size_bits != none:
                            error("FIIR: C enum typedef `" + value_type.spelling + "` cannot carry target size")
                    Record(name, c_spelling, fields, size_bits, alignment_bits, record_origin):
                        if value_type.size_bits != none or target_type.size_bits != none:
                            error("FIIR: C record typedef `" + value_type.spelling + "` cannot carry scalar size")
                    OpaqueHandle(name, c_spelling, handle_origin):
                        if value_type.size_bits != none or target_type.size_bits != none:
                            error("FIIR: opaque C handle typedef `" + value_type.spelling + "` cannot carry target size")
                    else:
                        let size = try require_positive_size(value_type)
                        let target_size = try require_positive_size(target_type)
                        if size != target_size:
                            error("FIIR: typedef `" + value_type.spelling + "` size differs from its target")

    for index in range(0, len(module.constants)):
        let constant = module.constants[index]
        if not is_c_identifier(constant.name):
            error("FIIR: constant `" + constant.name + "` is not a portable C identifier")
        try validate_origin(constant.origin, "constant `" + constant.name + "`")
        if i64(constant.value_type.value) >= len(module.types):
            error("FIIR: constant `" + constant.name + "` has an unknown type")
        for earlier in range(0, index):
            if module.constants[earlier].name == constant.name:
                error("FIIR: duplicate constant declaration `" + constant.name + "`")
        match constant.value:
            Integer(value): try validate_integer_constant(module, constant, value)
            Boolean(value): try validate_boolean_constant(module, constant)
            Floating(bits): try validate_floating_constant(module, constant, bits)
            Enumeration(value): try validate_enumeration_constant(module, constant, value)

    for index in range(0, len(module.objects)):
        let object = module.objects[index]
        if not is_c_identifier(object.name):
            error("FIIR: object `" + object.name + "` is not a portable C identifier")
        try validate_origin(object.origin, "object `" + object.name + "`")
        if i64(object.value_type.value) >= len(module.types):
            error("FIIR: object `" + object.name + "` has an unknown type")
        let value_type = try resolve_fiir_type(module, object.value_type)
        match value_type.form:
            Boolean, Integer, Floating, Enumeration: pass
            else: error("FIIR: object `" + object.name + "` has non-scalar C type `" + value_type.spelling + "`")
        for earlier in range(0, index):
            if module.objects[earlier].name == object.name:
                error("FIIR: duplicate object declaration `" + object.name + "`")

    for index in range(0, len(module.functions)):
        let function = module.functions[index]
        if not is_c_identifier(function.name):
            error("FIIR: function `" + function.name + "` is not a portable C identifier")
        if function.can_throw: error("FIIR: C function `" + function.name + "` cannot throw")
        try validate_origin(function.origin, "function `" + function.name + "`")
        try validate_boundary(module, function.result, "function `" + function.name + "` result", true)
        for earlier in range(0, index):
            if module.functions[earlier].name == function.name:
                error("FIIR: duplicate function declaration `" + function.name + "`")
        for parameter_index in range(0, len(function.parameters)):
            let parameter = function.parameters[parameter_index]
            try validate_boundary(module, parameter.boundary, "function `" + function.name + "` parameter " + str(parameter_index), false)
            try validate_origin(parameter.origin, "function `" + function.name + "` parameter " + str(parameter_index))
            if parameter.name != none:
                let name = parameter.name else trap("FIIR parameter name disappeared")
                if not is_c_identifier(name):
                    error("FIIR: function `" + function.name + "` parameter `" + name + "` is not a portable C identifier")
                for earlier in range(0, parameter_index):
                    let earlier_name = function.parameters[earlier].name
                    if earlier_name != none:
                        if earlier_name == name:
                            error("FIIR: function `" + function.name + "` has duplicate parameter `" + name + "`")

func validate_integer_constant(module: FiirModule, constant: FiirConstant, value: FiirIntegerValue) -> !:
    let value_type = try resolve_fiir_type(module, constant.value_type)
    match value_type.form:
        Integer(kind, bits, is_signed):
            if bits > u16(64):
                error("FIIR: integer constant `" + constant.name + "` exceeds the 64-bit portable domain")
            match value:
                Negative(magnitude):
                    if magnitude == u64(0):
                        error("FIIR: integer constant `" + constant.name + "` has noncanonical negative zero")
                    if not is_signed or magnitude > signed_integer_magnitude(bits):
                        error("FIIR: integer constant `" + constant.name + "` is outside C type `" + value_type.spelling + "`")
                Nonnegative(integer):
                    var maximum = unsigned_integer_maximum(bits)
                    if is_signed: maximum = signed_integer_magnitude(bits) - u64(1)
                    if integer > maximum:
                        error("FIIR: integer constant `" + constant.name + "` is outside C type `" + value_type.spelling + "`")
        else:
            error("FIIR: integer constant `" + constant.name + "` has non-integer C type `" + value_type.spelling + "`")

func validate_boolean_constant(module: FiirModule, constant: FiirConstant) -> !:
    let value_type = try resolve_fiir_type(module, constant.value_type)
    match value_type.form:
        Boolean: pass
        else: error("FIIR: Boolean constant `" + constant.name + "` has non-Boolean C type `" + value_type.spelling + "`")

func validate_floating_constant(module: FiirModule, constant: FiirConstant, bits: u64) -> !:
    let value_type = try resolve_fiir_type(module, constant.value_type)
    match value_type.form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            let width = exact_ieee_floating_width(value_type) else error("FIIR: floating constant `" + constant.name + "` has no lossless Luce carrier for C type `" + value_type.spelling + "`")
            if width < u16(64) and bits >> u64(width) != u64(0):
                error("FIIR: floating constant `" + constant.name + "` has bits outside its " + str(width) + "-bit C representation")
        else: error("FIIR: floating constant `" + constant.name + "` has non-floating C type `" + value_type.spelling + "`")

## C enumeration values are open: a constant may hold a value not named by an
## enumerator. Retain the complete portable sign-magnitude domain and leave
## any recipe-level closed-enum or bitmask policy to the safe wrapper.
func validate_enumeration_constant(module: FiirModule, constant: FiirConstant, value: FiirIntegerValue) -> !:
    let value_type = try resolve_fiir_type(module, constant.value_type)
    match value_type.form:
        Enumeration(name, c_spelling, cases, origin):
            match value:
                Negative(magnitude):
                    if magnitude == u64(0): error("FIIR: enumeration constant `" + constant.name + "` has noncanonical negative zero")
                    if magnitude > u64(9223372036854775808): error("FIIR: enumeration constant `" + constant.name + "` is outside the supported 64-bit domain")
                Nonnegative(integer): pass
        else: error("FIIR: enumeration constant `" + constant.name + "` has non-enumeration C type `" + value_type.spelling + "`")

func signed_integer_magnitude(bits: u16) -> u64:
    return u64(1) << u64(bits - u16(1))

func unsigned_integer_maximum(bits: u16) -> u64:
    if bits == u16(64): return u64(18446744073709551615)
    return (u64(1) << u64(bits)) - u64(1)

func validate_boundary(module: FiirModule, boundary: FiirBoundaryValue, what: str, permits_unit: bool) -> !:
    if i64(boundary.value_type.value) >= len(module.types): error("FIIR: " + what + " has an unknown type")
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Unit:
            if not permits_unit: error("FIIR: " + what + " cannot be `void`")
        OpaqueHandle(name, c_spelling, origin):
            if boundary.nullability == FiirNullability.not_applicable:
                error("FIIR: " + what + " omits opaque-handle nullability")
            if boundary.mutability != FiirMutability.read_only and boundary.mutability != FiirMutability.mutable:
                error("FIIR: " + what + " omits opaque-handle pointee mutability")
            return
        else: pass
    if boundary.nullability != FiirNullability.not_applicable or boundary.mutability != FiirMutability.not_applicable:
        error("FIIR: " + what + " gives pointer facts to a plain value")

func validate_origin(origin: FiirSourceOrigin, what: str) -> !:
    if origin.path == "": error("FIIR: " + what + " has no source path")
    if origin.line == u32(0) or origin.column == u32(0):
        error("FIIR: " + what + " has an invalid source position")

func require_positive_size(value_type: FiirType) -> u16!:
    let size = value_type.size_bits else error("FIIR: type `" + value_type.spelling + "` has no target size")
    if size == u16(0): error("FIIR: type `" + value_type.spelling + "` has zero target size")
    return size

## Follow transparent C typedef edges to the non-alias FIIR type whose facts
## define the portable carrier. The typedef itself remains the public boundary
## identity; this helper is only for representation-independent reasoning.
pub func resolve_fiir_type(module: FiirModule, value_type: FiirTypeId) -> FiirType!:
    var current = value_type
    for depth in range(0, len(module.types)):
        if i64(current.value) >= len(module.types): error("FIIR: cannot resolve an unknown type")
        let resolved = module.types[current.value]
        match resolved.form:
            Typedef(target, origin): current = target
            else: return resolved
    error("FIIR: typedef graph is cyclic")

## Return the Luce IEEE width that contains this complete C floating domain.
## `none` is deliberate for extended or otherwise unsupported target models;
## callers must reject those rather than silently narrow them.
pub func exact_ieee_floating_width(value_type: FiirType) -> u16?:
    let size = value_type.size_bits else u16(0)
    if size == u16(0): return none
    match value_type.form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            if radix != u16(2): return none
            if kind == FiirCFloatingKind.float16 and size == u16(16) and significand_bits == u16(11) and maximum_exponent == i32(16): return u16(16)
            if kind == FiirCFloatingKind.single and size == u16(32) and significand_bits == u16(24) and maximum_exponent == i32(128): return u16(32)
            if (kind == FiirCFloatingKind.double or kind == FiirCFloatingKind.long_double) and size == u16(64) and significand_bits == u16(53) and maximum_exponent == i32(1024): return u16(64)
        else: pass
    return none

## Whether the selected fundamental C integer family has a signed value
## domain for this FIIR module. Plain `char` is answered from its decoded form
## by callers because its signedness varies by target.
pub func c_integer_kind_is_signed(kind: FiirCIntegerKind) -> bool?:
    return match kind:
        plain_char => none
        signed_char, signed_short, signed_int, signed_long, signed_long_long => true
        unsigned_char, unsigned_short, unsigned_int, unsigned_long, unsigned_long_long => false

## Whether a name is in the portable ASCII subset shared by C identifiers and
## generated external symbols. Keyword/reserved-name policy is a separate
## generator concern because it depends on where the name is emitted.
pub func is_c_identifier(value: str) -> bool:
    if len(value) == 0: return false
    if value[0] != '_' and not is_ascii_letter(value[0]): return false
    for index in range(1, len(value)):
        let current = value[index]
        if current != '_' and not is_ascii_letter(current) and (current < '0' or current > '9'):
            return false
    return true

func is_ascii_letter(value: char) -> bool:
    return (value >= 'A' and value <= 'Z') or (value >= 'a' and value <= 'z')
