#==============================================================================================
#
#   fiir.binding - C-header binding transaction
#
#   DESCRIPTION:
#       Coordinates the backend-owned Clang inspection, pure FIIR renderers,
#       and atomic text-product installation. It does not parse Luce or touch
#       HIR/MIR. All three candidates are rendered before any destination is
#       changed; the FIIR record is installed last as the durable completion
#       marker for the source pair.
#
#==============================================================================================

from compiler.backends.clang_fiir import ClangFiirToolchain
from compiler.fiir.schema import FiirModule
from compiler.product_io import install_text_atomically
import compiler.fiir.generator as fiir_products
import std.paths
import std.strings

# mark: Product contract =======================================================================

pub struct CBindingRequest:
    pub let name: str
    pub let header: str
    pub let clang_arguments: list[str]

pub struct CBindingOutputs:
    pub let fiir: str
    pub let raw_module: str
    pub let c_adapter: str

## Inspect, validate, render, and install one C binding. The command is an
## explicit dependency for deterministic tests; CLI/product callers use the
## default `clang` resolved from PATH.
pub func bind_c(request: CBindingRequest, outputs: CBindingOutputs, clang_command: str = "clang") -> FiirModule!:
    try validate_outputs(outputs)
    let module = try ClangFiirToolchain(clang_command).inspect(
        request.header,
        request.clang_arguments,
        paths.dir(outputs.fiir),
    )
    let products = try fiir_products.render_binding(module, request.name)
    let encoded = try fiir_products.render_fiir_json(module)

    # Install the fact record last: its presence describes a fully rendered
    # raw-module/adapter pair from the same Clang invocation.
    try install_text_atomically(outputs.raw_module, products.raw_module, "bind: raw module")
    try install_text_atomically(outputs.c_adapter, products.c_adapter, "bind: C adapter")
    try install_text_atomically(outputs.fiir, encoded, "bind: FIIR")
    return module

func validate_outputs(outputs: CBindingOutputs) -> !:
    if outputs.fiir == "": error("bind: FIIR output path cannot be empty")
    if outputs.raw_module == "": error("bind: raw-module output path cannot be empty")
    if outputs.c_adapter == "": error("bind: C-adapter output path cannot be empty")
    if outputs.fiir == outputs.raw_module or outputs.fiir == outputs.c_adapter or outputs.raw_module == outputs.c_adapter:
        error("bind: FIIR, raw-module, and C-adapter outputs must be distinct")
    if not strings.ends_with(outputs.fiir, ".json"):
        error("bind: FIIR output must end in `.json`")
    if not strings.ends_with(outputs.raw_module, ".native.luc"):
        error("bind: raw module output must end in `.native.luc`")
    if not strings.ends_with(outputs.c_adapter, ".c"):
        error("bind: C adapter output must end in `.c`")
