#==============================================================================================
#
#   fiir.safe_generator - Ordinary Luce wrappers from validated binding recipes
#
#   DESCRIPTION:
#       Converts reviewed FIIR ownership/lifetime/status relationships into an
#       ordinary, target-independent Luce module. Raw handles never cross its
#       public API: owned results become idempotently closed classes and call-
#       scoped parameters use borrow capabilities that retain and check their
#       owner. Returned borrows retain the same owner and become unusable after
#       explicit close.
#
#       This layer knows neither pointer layout nor C ABI. It calls the raw
#       `.native.luc` module generated from the same FIIR and therefore lowers
#       through the existing class, optional, failure, HIR, and MIR machinery.
#
#==============================================================================================

import compiler.fiir.generator as fiir_products
from compiler.fiir.recipe import entry_has_parameter, find_function, opaque_handle_name, validate_binding_recipe
from compiler.fiir.schema import FiirBindingRecipe, FiirBoundaryValue, FiirCFloatingKind, FiirCIntegerKind, FiirFunction, FiirFunctionRecipe, FiirIntegerValue, FiirModule, FiirNullability, FiirRecipeResult, FiirTypeForm, resolve_fiir_type

# mark: Safe binding plan ======================================================================

struct SafeOwner:
    let handle: str
    let disposer: str

pub func render_safe_module(module: FiirModule) -> str!:
    try validate_binding_recipe(module)
    let recipe = module.recipe else trap("validated FIIR recipe disappeared")
    let owners = try collect_owners(module, recipe)
    var output = "## Generated by " + module.generator_version + ". Do not edit.\n"
    output += "## C header: " + single_line(module.header) + "\n"
    output += "## Binding recipe: " + single_line(recipe.path) + "\n\n"
    output += "import c\n"
    output += "import " + recipe.binding + ".raw as raw\n"

    if len(owners) > 0:
        output += "\n# mark: Owned C handles " + repeated("=", 62) + "\n\n"
        for owner in owners: output += render_owner(owner)

    var has_status = false
    for entry in recipe.functions:
        let result = entry.result
        if result != none:
            match result:
                Status(success, error_code, message): has_status = true
                else: pass
    if has_status:
        output += "\n# mark: Native failures " + repeated("=", 65) + "\n\n"
        for entry in recipe.functions:
            let result = entry.result
            if result != none:
                match result:
                    Status(success, error_code, message):
                        output += "let " + status_error_name(recipe.binding, entry.name) + ": ErrorCode = ErrorCode.package(" + str(error_code) + "u32)\n"
                    else: pass

    output += "\n# mark: Safe foreign calls " + repeated("=", 61) + "\n\n"
    for entry in recipe.functions:
        if is_disposer(owners, entry.name): continue
        let function = module.functions[find_function(module, entry.name)]
        output += try render_safe_function(module, recipe, function, entry)
    return output

func collect_owners(module: FiirModule, recipe: FiirBindingRecipe) -> list[SafeOwner]!:
    let owners = list[SafeOwner]()
    for entry in recipe.functions:
        let result = entry.result
        if result == none: continue
        match result:
            Owned(disposer):
                let function = module.functions[find_function(module, entry.name)]
                let handle = try opaque_handle_name(module, function.result) else trap("validated owned result lost its opaque handle")
                var exists = false
                for owner in owners:
                    if owner.handle == handle: exists = true
                if not exists: owners.append(SafeOwner(handle = handle, disposer = disposer))
            else: pass
    return owners

# mark: Owner and borrow capabilities ==========================================================

func render_owner(owner: SafeOwner) -> str:
    let borrow = borrow_name(owner.handle)
    let closed_message = luce_string("native resource `" + owner.handle + "` is closed")
    var output = "## Owns one `" + owner.handle + "` and disposes it exactly once.\n"
    output += "pub class " + owner.handle + ":\n"
    output += "    var handle: raw." + owner.handle + "?\n\n"
    output += "    func init(self, handle: raw." + owner.handle + "):\n"
    output += "        self.handle = handle\n\n"
    output += "    func raw_for_call(self) -> raw." + owner.handle + ":\n"
    output += "        match self.handle:\n"
    output += "            .some(handle): return handle\n"
    output += "            .none: trap(" + closed_message + ")\n\n"
    output += "    pub func borrow(self) -> " + borrow + ":\n"
    output += "        return new " + borrow + "(self, self.raw_for_call())\n\n"
    output += "    pub func close(self):\n"
    output += "        match self.handle:\n"
    output += "            .some(handle):\n"
    output += "                self.handle = none\n"
    output += "                raw." + owner.disposer + "(handle)\n"
    output += "            .none: return\n\n"
    output += "    func deinit(self): self.close()\n\n"
    output += "## Call-scoped access that retains its owner and checks explicit close.\n"
    output += "pub class " + borrow + ":\n"
    output += "    let owner: " + owner.handle + "\n"
    output += "    let handle: raw." + owner.handle + "\n\n"
    output += "    func init(self, owner: " + owner.handle + ", handle: raw." + owner.handle + "):\n"
    output += "        self.owner = owner\n"
    output += "        self.handle = handle\n\n"
    output += "    func raw_for_call(self) -> raw." + owner.handle + ":\n"
    output += "        discard(self.owner.raw_for_call())\n"
    output += "        return self.handle\n\n"
    return output

# mark: Safe calls =============================================================================

func render_safe_function(module: FiirModule, recipe: FiirBindingRecipe, function: FiirFunction, entry: FiirFunctionRecipe) -> str!:
    let names = fiir_products.parameter_names(function)
    var output = "pub func " + function.name + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        output += names[index] + ": " + try safe_parameter_type(module, function.parameters[index].boundary, entry, u32(index))
    output += ")"
    let result = entry.result
    if result != none:
        match result:
            Owned(disposer): output += " -> " + try safe_owned_result_type(module, function.result)
            Borrowed(source_parameter): output += " -> " + try safe_borrowed_result_type(module, function.result)
            Status(success, error_code, message): output += " -> unit!"
    else:
        let result_type = try safe_plain_type(module, function.result, true)
        if result_type != "unit": output += " -> " + result_type
    output += ":\n"

    for index in range(0, len(function.parameters)):
        if try opaque_handle_name(module, function.parameters[index].boundary) == none: continue
        if function.parameters[index].boundary.nullability != FiirNullability.nonnull:
            let handle = try opaque_handle_name(module, function.parameters[index].boundary) else trap("opaque parameter disappeared")
            output += "    var " + names[index] + "_raw: raw." + handle + "? = none\n"
            output += "    if let value = " + names[index] + ": " + names[index] + "_raw = value.raw_for_call()\n"

    let call = try safe_call(module, function, names)
    if result == none:
        let result_type = try safe_plain_type(module, function.result, true)
        output += "    "
        if result_type != "unit": output += "return "
        output += call + "\n\n"
        return output

    match result:
        Owned(disposer):
            let handle = try opaque_handle_name(module, function.result) else trap("validated owned result disappeared")
            if function.result.nullability == FiirNullability.nonnull:
                output += "    return new " + handle + "(" + call + ")\n\n"
            else:
                output += "    match " + call + ":\n"
                output += "        .some(handle): return new " + handle + "(handle)\n"
                output += "        .none: return none\n\n"
        Borrowed(source_parameter):
            let handle = try opaque_handle_name(module, function.result) else trap("validated borrowed result disappeared")
            let borrow = borrow_name(handle)
            let anchor = names[source_parameter]
            if function.result.nullability == FiirNullability.nonnull:
                output += "    return new " + borrow + "(" + anchor + ".owner, " + call + ")\n\n"
            else:
                output += "    match " + call + ":\n"
                output += "        .some(handle): return new " + borrow + "(" + anchor + ".owner, handle)\n"
                output += "        .none: return none\n\n"
        Status(success, error_code, message):
            output += "    let status = " + call + ".portable()\n"
            output += "    if status != " + try status_literal(module, function.result, success) + ":\n"
            output += "        error(" + status_error_name(recipe.binding, function.name) + ", " + luce_string(message) + ")\n"
            output += "    return\n\n"
    return output

func safe_call(module: FiirModule, function: FiirFunction, names: list[str]) -> str!:
    var output = "raw." + function.name + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        let boundary = function.parameters[index].boundary
        if try opaque_handle_name(module, boundary) == none: output += names[index]
        elif boundary.nullability == FiirNullability.nonnull: output += names[index] + ".raw_for_call()"
        else: output += names[index] + "_raw"
    return output + ")"

func safe_parameter_type(module: FiirModule, boundary: FiirBoundaryValue, entry: FiirFunctionRecipe, index: u32) -> str!:
    let handle = try opaque_handle_name(module, boundary)
    if handle == none: return try safe_plain_type(module, boundary, false)
    if not entry_has_parameter(entry, index):
        error("FIIR safe generation: opaque parameter " + str(index) + " of `" + entry.name + "` lacks a validated recipe")
    var result = borrow_name(handle)
    if boundary.nullability != FiirNullability.nonnull: result += "?"
    return result

func safe_owned_result_type(module: FiirModule, boundary: FiirBoundaryValue) -> str!:
    let handle = try opaque_handle_name(module, boundary) else error("FIIR safe generation: owned result is not opaque")
    if boundary.nullability == FiirNullability.nonnull: return handle
    return handle + "?"

func safe_borrowed_result_type(module: FiirModule, boundary: FiirBoundaryValue) -> str!:
    let handle = try opaque_handle_name(module, boundary) else error("FIIR safe generation: borrowed result is not opaque")
    let borrow = borrow_name(handle)
    if boundary.nullability == FiirNullability.nonnull: return borrow
    return borrow + "?"

func safe_plain_type(module: FiirModule, boundary: FiirBoundaryValue, permits_unit: bool) -> str!:
    let declared = module.types[boundary.value_type.value]
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match declared.form:
        Typedef(target, origin): return "raw." + declared.spelling
        else: pass
    match resolved.form:
        Unit:
            if not permits_unit: error("FIIR safe generation: parameter cannot be void")
            return "unit"
        Boolean: return "c.boolean"
        Integer(kind, bits, is_signed): return "c." + integer_name(kind)
        Floating(kind, radix, significand_bits, maximum_exponent): return "c." + floating_name(kind)
        Enumeration(name, c_spelling, cases, origin): return "raw." + name
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin): return "raw." + name
        OpaqueHandle(name, c_spelling, origin):
            error("FIIR safe generation: raw opaque handle `" + name + "` escaped recipe lowering")
        Typedef(target, origin): trap("resolved FIIR type remained a typedef")

func status_literal(module: FiirModule, boundary: FiirBoundaryValue, value: FiirIntegerValue) -> str!:
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Integer(kind, bits, is_signed):
            match value:
                Negative(magnitude): return "-" + str(magnitude) + "i64"
                Nonnegative(integer):
                    if kind == FiirCIntegerKind.plain_char or is_signed: return str(integer) + "i64"
                    return str(integer) + "u64"
        else: error("FIIR safe generation: status result is not a C integer")

func integer_name(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "plain_char"
        signed_char => "signed_char"
        unsigned_char => "unsigned_char"
        signed_short => "short"
        unsigned_short => "unsigned_short"
        signed_int => "int"
        unsigned_int => "unsigned_int"
        signed_long => "long"
        unsigned_long => "unsigned_long"
        signed_long_long => "long_long"
        unsigned_long_long => "unsigned_long_long"

func floating_name(kind: FiirCFloatingKind) -> str:
    return match kind:
        float16 => "float16"
        single => "float"
        double => "double"
        long_double => "long_double"

# mark: Generated identifiers and text =========================================================

func borrow_name(handle: str) -> str:
    return handle + "_borrow"

func status_error_name(binding: str, function: str) -> str:
    return "__luce_fiir_" + binding + "_" + function + "_failure"

func is_disposer(owners: list[SafeOwner], function: str) -> bool:
    for owner in owners:
        if owner.disposer == function: return true
    return false

func single_line(value: str) -> str:
    var output = ""
    for character in value:
        if character == '\n' or character == '\r': output += " "
        else: output += str(character)
    return output

func luce_string(value: str) -> str:
    var output = "\""
    for character in value:
        if character == '\"': output += "\\\""
        elif character == '\\': output += "\\\\"
        elif character == '\n': output += "\\n"
        elif character == '\r': output += "\\r"
        elif character == '\t': output += "\\t"
        else: output += str(character)
    return output + "\""

func repeated(value: str, count: i64) -> str:
    var output = ""
    for index in range(0, count): output += value
    return output
