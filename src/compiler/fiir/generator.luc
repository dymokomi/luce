#==============================================================================================
#
#   fiir.generator - Deterministic FIIR and binding products
#
#   DESCRIPTION:
#       Turns validated C FIIR into three inspectable products: a versioned
#       JSON fact record, an audited raw Luce module, and its C adapter. The C
#       adapter terminates target-specific scalar spelling and representation;
#       HIR and MIR see ordinary nominal `c` values plus one proven portable
#       adapter signature.
#
#       C Boolean, exact IEEE binary16/32/64 floating values, all fundamental
#       C integer families, scalar typedef chains, C enumerations, opaque C
#       handles, typed scalar and enumeration constants, external scalar
#       objects, and plain records have complete products. Scalar families and
#       typedefs use nominal universal carriers; enumerations and integer
#       constants use canonical sign-magnitude carriers. External storage
#       crosses through ordinary generated calls. Only the C adapter selects
#       target representation, object access, or record layout. Other extended
#       floating carriers, pointer ownership recipes, unions, and bit-fields
#       extend the boundary later.
#
#==============================================================================================

from compiler.fiir.schema import FiirBoundaryValue, FiirCFloatingKind, FiirCIntegerKind, FiirConstant, FiirConstantSource, FiirConstantValue, FiirEnumCase, FiirFunction, FiirIntegerValue, FiirLanguage, FiirLifetime, FiirModule, FiirMutability, FiirNullability, FiirObject, FiirObjectAccess, FiirOwnership, FiirRecordField, FiirSourceOrigin, FiirType, FiirTypeForm, FiirTypeId, exact_ieee_floating_width, is_c_identifier, plain_value_boundary, resolve_fiir_type, validate_fiir
from compiler.formatting.float_display import display_ieee_float_bits
from compiler.frontend.tokenizer import is_keyword
import std.json

# mark: Binding products =======================================================================

## Render one generated `.native.luc` module whose fixed-width adapter calls
## have the same shape for every target. `binding` is a stable portable
## identifier supplied by the binding declaration or explicit CLI command.
pub func render_raw_module(module: FiirModule, binding: str) -> str!:
    try validate_fiir(module)
    try validate_adapter_symbols(module, binding)
    let exposed_typedefs = collect_exposed_typedefs(module)
    let needs_math = try raw_module_needs_math(module)
    try validate_raw_declaration_names(module, binding, exposed_typedefs, needs_math)
    var output = "## Generated by " + module.generator_version + ". Do not edit.\n"
    output += "## C header: " + single_line(module.header) + "\n"
    output += "## Clang target: " + single_line(module.target) + "\n"
    if len(module.clang_arguments) > 0:
        output += "## Clang arguments:"
        for argument in module.clang_arguments: output += " " + single_line(argument)
        output += "\n"
    var has_macro_constants = false
    for constant in module.constants:
        if constant.source == FiirConstantSource.macro:
            if not has_macro_constants: output += "## Selected C macro constants:"
            output += " " + constant.name
            has_macro_constants = true
    if has_macro_constants: output += "\n"
    output += "\nimport c\n"
    if needs_math: output += "import math\n"
    var rendered_opaque_handle = false
    for value_type in module.types:
        match value_type.form:
            OpaqueHandle(name, c_spelling, origin):
                if not rendered_opaque_handle:
                    output += "\n# mark: Opaque C handles " + repeated("=", 62) + "\n\n"
                    rendered_opaque_handle = true
                output += "## Pointer-shaped handle for incomplete C type `" + value_type.spelling + "`.\n"
                output += "## Raw native identity; ownership and lifetime require a reviewed binding recipe.\n"
                output += "pub extern type " + name + "\n\n"
            else: pass
    var rendered_record = false
    for index in range(0, len(module.types)):
        let value_type = module.types[index]
        match value_type.form:
            Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
                if not rendered_record:
                    output += "\n# mark: C records " + repeated("=", 69) + "\n\n"
                    rendered_record = true
                output += try render_record(module, binding, FiirTypeId(value = u32(index)), value_type)
            else: pass
    var rendered_enumeration = false
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                if not rendered_enumeration:
                    output += "\n# mark: C enumerations " + repeated("=", 64) + "\n\n"
                    rendered_enumeration = true
                output += try render_enumeration(name, value_type.spelling, cases)
            else: pass
    var rendered_typedef = false
    for index in range(0, len(module.types)):
        let value_type = module.types[index]
        match value_type.form:
            Typedef(target, origin):
                if exposed_typedefs[index]:
                    if not rendered_typedef:
                        output += "\n# mark: C typedefs " + repeated("=", 68) + "\n\n"
                        rendered_typedef = true
                    output += try render_typedef(module, FiirTypeId(value = u32(index)), value_type)
            else: pass
    if len(module.constants) > 0:
        output += "\n# mark: C constants " + repeated("=", 67) + "\n\n"
        for constant in module.constants: output += try render_constant(module, constant)
    if len(module.objects) > 0:
        output += "\n# mark: C objects " + repeated("=", 69) + "\n\n"
        for object in module.objects: output += try render_object(module, binding, object)
    output += "\n# mark: Foreign declarations " + repeated("=", 59) + "\n\n"
    for function in module.functions:
        output += try render_function(module, binding, function)
        output += "\n"
    return output

# mark: Raw type declarations =================================================================

func render_record(module: FiirModule, binding: str, type_id: FiirTypeId, value_type: FiirType) -> str!:
    match value_type.form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            var output = "## Target-independent value carrier for C record `" + value_type.spelling + "`.\n"
            output += "pub struct " + name + ":\n"
            for field in fields:
                output += "    pub let " + field.name + ": " + try render_public_type(module, plain_value_boundary(field.value_type), "C record `" + name + "` field `" + field.name + "`", false) + "\n"
            output += "\n## Private fixed-carrier storage passed by pointer to the generated C adapter.\n"
            output += "extern struct " + adapter_record_name(binding, name) + ":\n"
            for index in range(0, len(fields)):
                let field = fields[index]
                let resolved = try resolve_fiir_type(module, field.value_type)
                match resolved.form:
                    Enumeration(enum_name, enum_spelling, cases, enum_origin):
                        output += "    " + adapter_record_negative_field(index) + ": bool\n"
                        output += "    " + adapter_record_magnitude_field(index) + ": u64\n"
                    Record(record_name, record_spelling, record_fields, record_size, record_alignment, record_origin):
                        output += "    " + adapter_record_field(index) + ": " + adapter_record_name(binding, record_name) + "\n"
                    else:
                        output += "    " + adapter_record_field(index) + ": " + try adapter_carrier_type(module, plain_value_boundary(field.value_type), "C record `" + name + "` field `" + field.name + "`", false) + "\n"
            output += "\n"
            output += try render_record_encoder(module, binding, name, fields)
            output += try render_record_decoder(module, binding, name, fields)
            return output
        else: error("FIIR generation: record renderer received non-record `" + value_type.spelling + "`")

func render_record_encoder(module: FiirModule, binding: str, name: str, fields: list[FiirRecordField]) -> str!:
    var output = "func " + record_encode_name(binding, name) + "(value: " + name + ") -> " + adapter_record_name(binding, name) + ":\n"
    for index in range(0, len(fields)):
        let resolved = try resolve_fiir_type(module, fields[index].value_type)
        match resolved.form:
            Enumeration(enum_name, c_spelling, cases, origin):
                output += "    let (" + adapter_record_negative_field(index) + ", " + adapter_record_magnitude_field(index) + ") = value." + fields[index].name + ".portable()\n"
            else: pass
    output += "    return " + adapter_record_name(binding, name) + "("
    var emitted = 0
    for index in range(0, len(fields)):
        let field = fields[index]
        let resolved = try resolve_fiir_type(module, field.value_type)
        match resolved.form:
            Enumeration(enum_name, c_spelling, cases, origin):
                if emitted > 0: output += ", "
                output += adapter_record_negative_field(index) + ", " + adapter_record_magnitude_field(index)
                emitted += 2
            Record(record_name, c_spelling, record_fields, size_bits, alignment_bits, origin):
                if emitted > 0: output += ", "
                output += record_encode_name(binding, record_name) + "(value." + field.name + ")"
                emitted += 1
            else:
                if emitted > 0: output += ", "
                output += try adapter_input_expression(module, plain_value_boundary(field.value_type), "value." + field.name + ".raw")
                emitted += 1
    return output + ")\n\n"

func render_record_decoder(module: FiirModule, binding: str, name: str, fields: list[FiirRecordField]) -> str!:
    var output = "func " + record_decode_name(binding, name) + "(value: " + adapter_record_name(binding, name) + ") -> " + name + ":\n"
    output += "    return " + name + "("
    for index in range(0, len(fields)):
        if index > 0: output += ", "
        let field = fields[index]
        let resolved = try resolve_fiir_type(module, field.value_type)
        match resolved.form:
            Enumeration(enum_name, c_spelling, cases, origin):
                output += enum_name + "(value." + adapter_record_negative_field(index) + ", value." + adapter_record_magnitude_field(index) + ")"
            Record(record_name, c_spelling, record_fields, size_bits, alignment_bits, origin):
                output += record_decode_name(binding, record_name) + "(value." + adapter_record_field(index) + ")"
            else:
                output += try wrap_public_result(module, plain_value_boundary(field.value_type), "value." + adapter_record_field(index))
    return output + ")\n\n"

pub func adapter_record_name(binding: str, record: str) -> str:
    return "__luce_fiir_" + binding + "_record_" + record

func record_encode_name(binding: str, record: str) -> str:
    return "__luce_fiir_" + binding + "_encode_" + record

func record_decode_name(binding: str, record: str) -> str:
    return "__luce_fiir_" + binding + "_decode_" + record

pub func adapter_record_field(index: i64) -> str:
    return "field_" + str(index)

pub func adapter_record_negative_field(index: i64) -> str:
    return "field_" + str(index) + "_is_negative"

pub func adapter_record_magnitude_field(index: i64) -> str:
    return "field_" + str(index) + "_magnitude"

func render_typedef(module: FiirModule, type_id: FiirTypeId, value_type: FiirType) -> str!:
    if is_keyword(value_type.spelling):
        error("FIIR generation: C typedef `" + value_type.spelling + "` needs a name-preserving adapter because it is reserved in Luce")
    if value_type.spelling == "c":
        error("FIIR generation: C typedef `c` collides with the generated C module import")
    let resolved = try resolve_fiir_type(module, type_id)
    match resolved.form:
        Enumeration(name, c_spelling, cases, origin):
            if value_type.spelling == name: return ""
            return (
                "## Transparent C typedef alias for enumeration `" + name + "`.\n"
                + "pub type " + value_type.spelling + " = " + name + "\n\n"
            )
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            if value_type.spelling == name: return ""
            return (
                "## Transparent C typedef alias for record `" + name + "`.\n"
                + "pub type " + value_type.spelling + " = " + name + "\n\n"
            )
        OpaqueHandle(name, c_spelling, origin):
            if value_type.spelling == name: return ""
            return (
                "## Transparent C typedef alias for opaque handle `" + name + "`.\n"
                + "pub type " + value_type.spelling + " = " + name + "\n\n"
            )
        else: pass
    let carrier = try public_scalar_carrier_type(
        module,
        plain_value_boundary(type_id),
        "typedef `" + value_type.spelling + "`",
        false,
    )
    return (
        "## Nominal carrier for C typedef `" + value_type.spelling + "`.\n"
        + "pub struct " + value_type.spelling + ":\n"
        + "    pub let raw: " + carrier + "\n\n"
        + "    pub func portable(self) -> " + carrier + ":\n"
        + "        return self.raw\n\n"
    )

func render_enumeration(name: str, spelling: str, cases: list[FiirEnumCase]) -> str!:
    if is_keyword(name):
        error("FIIR generation: C enum `" + spelling + "` needs a name-preserving adapter because `" + name + "` is reserved in Luce")
    if name == "c": error("FIIR generation: C enum carrier `c` collides with the generated C module import")
    var output = "## Nominal sign-magnitude carrier for C enum `" + spelling + "`.\n"
    output += "pub struct " + name + ":\n"
    output += "    let is_negative: bool\n"
    output += "    let magnitude: u64\n\n"
    output += "    pub func portable(self) -> (bool, u64):\n"
    output += "        return (self.is_negative, self.magnitude)\n\n"
    for enum_case in cases:
        if is_keyword(enum_case.name):
            error("FIIR generation: C enum constant `" + enum_case.name + "` is reserved in Luce")
        output += "pub let " + enum_case.name + ": " + name + " = " + name + "(" + integer_value_arguments(enum_case.value) + ")\n"
    return output + "\n"

func render_constant(module: FiirModule, constant: FiirConstant) -> str!:
    if is_keyword(constant.name):
        error("FIIR generation: C constant `" + constant.name + "` is reserved in Luce")
    match constant.value:
        Integer(value):
            return "pub let " + constant.name + ": c.integer_constant = c.integer_constant(" + integer_value_arguments(value) + ")\n"
        Boolean(value):
            return "pub let " + constant.name + ": c.boolean = c.boolean(" + str(value) + ")\n"
        Floating(bits):
            let resolved = try resolve_fiir_type(module, constant.value_type)
            let width = exact_ieee_floating_width(resolved) else error("FIIR generation: C floating constant `" + constant.name + "` has no lossless Luce carrier")
            let spelling = try display_ieee_float_bits(bits, i64(width))
            let value_expression = floating_luce_expression(spelling, width)
            match resolved.form:
                Floating(kind, radix, significand_bits, maximum_exponent):
                    return "pub let " + constant.name + ": c." + c_floating_luce_name(kind) + " = c." + c_floating_luce_name(kind) + "(" + value_expression + ")\n"
                else: error("FIIR generation: floating constant `" + constant.name + "` resolved to a non-floating type")
        Enumeration(value):
            let resolved = try resolve_fiir_type(module, constant.value_type)
            match resolved.form:
                Enumeration(name, c_spelling, cases, origin):
                    let public_type = try render_public_type(module, plain_value_boundary(constant.value_type), "C enumeration constant `" + constant.name + "`", false)
                    return "pub let " + constant.name + ": " + public_type + " = " + name + "(" + integer_value_arguments(value) + ")\n"
                else: error("FIIR generation: enumeration constant `" + constant.name + "` resolved to a non-enumeration type")

func integer_value_arguments(value: FiirIntegerValue) -> str:
    match value:
        Negative(magnitude): return "true, " + str(magnitude) + "u64"
        Nonnegative(integer): return "false, " + str(integer) + "u64"

func raw_module_needs_math(module: FiirModule) -> bool!:
    for constant in module.constants:
        match constant.value:
            Floating(bits):
                let resolved = try resolve_fiir_type(module, constant.value_type)
                let width = exact_ieee_floating_width(resolved) else error("FIIR generation: C floating constant `" + constant.name + "` has no lossless Luce carrier")
                let spelling = try display_ieee_float_bits(bits, i64(width))
                if spelling == "nan" or spelling == "inf" or spelling == "-inf": return true
            Integer(value): pass
            Boolean(value): pass
            Enumeration(value): pass
    return false

func floating_luce_expression(spelling: str, width: u16) -> str:
    let suffix = "f" + str(width)
    if spelling == "nan": return "math.nan_" + suffix
    if spelling == "inf": return "math.positive_infinity_" + suffix
    if spelling == "-inf": return "math.negative_infinity_" + suffix
    return spelling + suffix

## External C storage stays behind generated accessors so its target-selected
## object representation never becomes an HIR or MIR global layout promise.
func render_object(module: FiirModule, binding: str, object: FiirObject) -> str!:
    let boundary = plain_value_boundary(object.value_type)
    let resolved = try resolve_fiir_type(module, object.value_type)
    match resolved.form:
        Enumeration(name, c_spelling, cases, origin):
            return try render_enumeration_object(module, binding, object, boundary)
        Boolean, Integer, Floating:
            return try render_scalar_object(module, binding, object, boundary)
        else: error("FIIR generation: external C object `" + object.name + "` has no completed value adapter")

func render_scalar_object(module: FiirModule, binding: str, object: FiirObject, boundary: FiirBoundaryValue) -> str!:
    let public_type = try render_public_type(module, boundary, "external C object `" + object.name + "`", false)
    let adapter_type = try adapter_carrier_type(module, boundary, "external C object `" + object.name + "`", false)
    let read_name = object_read_name(object.name)
    let read_adapter = object_reader_adapter_symbol(binding, object.name)
    var output = "extern func " + read_adapter + "() -> " + adapter_type + "\n\n"
    output += "pub func " + read_name + "() -> " + public_type + ":\n"
    output += "    return " + try wrap_public_result(module, boundary, read_adapter + "()") + "\n\n"
    if object.access == FiirObjectAccess.read_write:
        let write_name = object_write_name(object.name)
        let write_adapter = object_writer_adapter_symbol(binding, object.name)
        let resolved = try resolve_fiir_type(module, object.value_type)
        var checked = false
        match resolved.form:
            Integer(kind, bits, is_signed): checked = true
            else: pass
        output += "extern func " + write_adapter + "(value: " + adapter_type + ")"
        if checked: output += " -> i32"
        output += "\n\npub func " + write_name + "(value: " + public_type + "):\n"
        let call = write_adapter + "(" + try adapter_input_expression(module, boundary, "value.raw") + ")"
        if checked:
            output += "    let status = " + call + "\n"
            output += "    if status == " + str(adapter_status_code(FiirAdapterStatus.integer_range)) + "i32: trap(\"native_integer_range: C object `" + object.name + "` received an integer outside its target range\")\n"
            output += "    if status != " + str(adapter_status_code(FiirAdapterStatus.success)) + "i32: trap(\"native_adapter_status: C object `" + object.name + "` adapter returned an unknown status\")\n"
        else: output += "    " + call + "\n"
        output += "\n"
    return output

func render_enumeration_object(module: FiirModule, binding: str, object: FiirObject, boundary: FiirBoundaryValue) -> str!:
    let public_type = try render_public_type(module, boundary, "external C object `" + object.name + "`", false)
    let read_name = object_read_name(object.name)
    let read_adapter = object_reader_adapter_symbol(binding, object.name)
    let result_names = FiirAdapterValueNames.Enumeration(is_negative = "result_is_negative", magnitude = "result_magnitude")
    var output = "extern func " + read_adapter + "(" + try render_adapter_declaration(module, binding, boundary, result_names, "external C object `" + object.name + "` reader", true) + ") -> i32\n\n"
    output += "pub func " + read_name + "() -> " + public_type + ":\n"
    output += "    let (status, result_is_negative, result_magnitude) = " + read_adapter + "()\n"
    output += "    if status == " + str(adapter_status_code(FiirAdapterStatus.enumeration_result)) + "i32: trap(\"native_enum_value: C object `" + object.name + "` contains an undeclared enum value\")\n"
    output += "    if status != " + str(adapter_status_code(FiirAdapterStatus.success)) + "i32: trap(\"native_adapter_status: C object `" + object.name + "` reader returned an unknown status\")\n"
    output += "    return " + try wrap_adapter_result(module, binding, boundary, result_names) + "\n\n"
    if object.access == FiirObjectAccess.read_write:
        let write_name = object_write_name(object.name)
        let write_adapter = object_writer_adapter_symbol(binding, object.name)
        output += "extern func " + write_adapter + "(value_is_negative: bool, value_magnitude: u64) -> i32\n\n"
        output += "pub func " + write_name + "(value: " + public_type + "):\n"
        output += "    let (value_is_negative, value_magnitude) = value.portable()\n"
        output += "    let status = " + write_adapter + "(value_is_negative, value_magnitude)\n"
        output += "    if status == " + str(adapter_status_code(FiirAdapterStatus.enumeration_input)) + "i32: trap(\"native_enum_value: C object `" + object.name + "` received an undeclared enum value\")\n"
        output += "    if status != " + str(adapter_status_code(FiirAdapterStatus.success)) + "i32: trap(\"native_adapter_status: C object `" + object.name + "` writer returned an unknown status\")\n\n"
    return output

func collect_exposed_typedefs(module: FiirModule) -> list[bool]:
    let exposed = list[bool]()
    for value_type in module.types:
        match value_type.form:
            Typedef(target, origin): exposed.append(origin.path == module.header)
            else: exposed.append(false)
    for function in module.functions:
        exposed[function.result.value_type.value] = true
        for parameter in function.parameters:
            exposed[parameter.boundary.value_type.value] = true
    for object in module.objects: exposed[object.value_type.value] = true
    for constant in module.constants:
        match constant.value:
            Enumeration(value): exposed[constant.value_type.value] = true
            else: pass
    for value_type in module.types:
        match value_type.form:
            Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
                for field in fields: exposed[field.value_type.value] = true
            else: pass
    return exposed

## C tags and ordinary declarations occupy separate namespaces, while Luce's
## generated module has one declaration namespace. Reject every collapse here,
## before emitting partial source; a later recipe-aware naming plan can choose
## reviewed aliases without weakening this deterministic baseline.
func validate_raw_declaration_names(module: FiirModule, binding: str, exposed_typedefs: list[bool], needs_math: bool) -> !:
    let names = map[str, str]()
    names["c"] = "the generated C module import"
    if needs_math: names["math"] = "the generated math module import"
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                try reserve_raw_name(names, name, "C enum carrier `" + value_type.spelling + "`")
                for enum_case in cases:
                    try reserve_raw_name(names, enum_case.name, "C enum constant `" + enum_case.name + "`")
            Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
                if is_keyword(name): error("FIIR generation: C record `" + value_type.spelling + "` needs a name-preserving adapter because `" + name + "` is reserved in Luce")
                if name == "c": error("FIIR generation: C record carrier `c` collides with the generated C module import")
                for field in fields:
                    if is_keyword(field.name): error("FIIR generation: C record field `" + field.name + "` is reserved in Luce")
                try reserve_raw_name(names, name, "C record carrier `" + value_type.spelling + "`")
                try reserve_raw_name(names, adapter_record_name(binding, name), "generated adapter record for `" + name + "`")
                try reserve_raw_name(names, record_encode_name(binding, name), "generated record encoder for `" + name + "`")
                try reserve_raw_name(names, record_decode_name(binding, name), "generated record decoder for `" + name + "`")
            OpaqueHandle(name, c_spelling, origin):
                if is_keyword(name): error("FIIR generation: opaque C handle `" + name + "` is reserved in Luce")
                try reserve_raw_name(names, name, "opaque C handle `" + value_type.spelling + "`")
            else: pass
    for index in range(0, len(module.types)):
        let value_type = module.types[index]
        match value_type.form:
            Typedef(target, origin):
                if not exposed_typedefs[index]: continue
                let resolved = try resolve_fiir_type(module, FiirTypeId(value = u32(index)))
                match resolved.form:
                    Enumeration(name, c_spelling, cases, enum_origin):
                        if value_type.spelling == name: continue
                    Record(name, c_spelling, fields, size_bits, alignment_bits, record_origin):
                        if value_type.spelling == name: continue
                    else: pass
                try reserve_raw_name(names, value_type.spelling, "C typedef `" + value_type.spelling + "`")
            else: pass
    for constant in module.constants:
        try reserve_raw_name(names, constant.name, "C constant `" + constant.name + "`")
    for object in module.objects:
        try reserve_raw_name(names, object_read_name(object.name), "generated reader for C object `" + object.name + "`")
        try reserve_raw_name(names, object_reader_adapter_symbol(binding, object.name), "generated reader declaration for C object `" + object.name + "`")
        if object.access == FiirObjectAccess.read_write:
            try reserve_raw_name(names, object_write_name(object.name), "generated writer for C object `" + object.name + "`")
            try reserve_raw_name(names, object_writer_adapter_symbol(binding, object.name), "generated writer declaration for C object `" + object.name + "`")
    for function in module.functions:
        try reserve_raw_name(names, function.name, "C function wrapper `" + function.name + "`")
        let adapter = adapter_symbol(binding, function.name)
        try reserve_raw_name(names, adapter, "generated adapter declaration for `" + function.name + "`")

func reserve_raw_name(names: map[str, str], name: str, owner: str) -> !:
    if names.has(name):
        error("FIIR generation: raw declaration `" + name + "` is required by " + names[name] + " and " + owner)
    names[name] = owner

## Generated C adapter symbols share the header's external C namespace. Keep
## the check beside the one symbol plan consumed by both product renderers.
pub func validate_adapter_symbols(module: FiirModule, binding: str) -> !:
    if not is_c_identifier(binding):
        error("FIIR generation: binding name `" + binding + "` is not a portable identifier")
    let symbols = map[str, str]()
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                for enum_case in cases: symbols[enum_case.name] = "C enum constant `" + enum_case.name + "`"
            else: pass
    for constant in module.constants: symbols[constant.name] = "C constant `" + constant.name + "`"
    for object in module.objects: symbols[object.name] = "C object `" + object.name + "`"
    for function in module.functions:
        symbols[function.name] = "C function `" + function.name + "`"
    for object in module.objects:
        let read_adapter = object_reader_adapter_symbol(binding, object.name)
        if symbols.has(read_adapter):
            error("FIIR generation: adapter symbol `" + read_adapter + "` collides with " + symbols[read_adapter])
        symbols[read_adapter] = "generated reader for C object `" + object.name + "`"
        if object.access == FiirObjectAccess.read_write:
            let write_adapter = object_writer_adapter_symbol(binding, object.name)
            if symbols.has(write_adapter):
                error("FIIR generation: adapter symbol `" + write_adapter + "` collides with " + symbols[write_adapter])
            symbols[write_adapter] = "generated writer for C object `" + object.name + "`"
    for function in module.functions:
        let adapter = adapter_symbol(binding, function.name)
        if symbols.has(adapter):
            error("FIIR generation: adapter symbol `" + adapter + "` collides with " + symbols[adapter])
        symbols[adapter] = "generated adapter for `" + function.name + "`"

# mark: Adapter signature plan ================================================================

pub union FiirAdapterValueNames:
    Unit
    Scalar(name: str)
    Enumeration(is_negative: str, magnitude: str)
    Record(name: str)

## Closed status protocol shared by the generated Luce declaration and its C
## implementation. Success is deliberately nonzero so every early validation
## failure can return a distinct stable reason before touching foreign code.
pub enum FiirAdapterStatus:
    integer_range
    success
    enumeration_input
    enumeration_result

pub func adapter_status_code(status: FiirAdapterStatus) -> i32:
    return match status:
        integer_range => 0
        success => 1
        enumeration_input => 2
        enumeration_result => 3

pub struct FiirAdapterNames:
    pub let source_parameters: list[str]
    pub let parameters: list[FiirAdapterValueNames]
    pub let result: FiirAdapterValueNames
    pub let status: str

pub func adapter_names(module: FiirModule, function: FiirFunction) -> FiirAdapterNames!:
    let source = parameter_names(function)
    let parameters = list[FiirAdapterValueNames]()
    let used = list[str]()
    for index in range(0, len(function.parameters)):
        let name = source[index]
        if try boundary_is_enumeration(module, function.parameters[index].boundary):
            parameters.append(FiirAdapterValueNames.Enumeration(
                is_negative = fresh_name(used, name + "_is_negative"),
                magnitude = fresh_name(used, name + "_magnitude"),
            ))
        elif try boundary_is_record(module, function.parameters[index].boundary):
            parameters.append(FiirAdapterValueNames.Record(name = fresh_name(used, name)))
        else:
            parameters.append(FiirAdapterValueNames.Scalar(name = fresh_name(used, name)))
    for name in source:
        if not contains_name(used, name): used.append(name)
    let result = try adapter_result_names(module, function.result, used)
    let status = fresh_name(used, "status")
    return FiirAdapterNames(source_parameters = source, parameters = parameters, result = result, status = status)

func adapter_result_names(module: FiirModule, boundary: FiirBoundaryValue, used: list[str]) -> FiirAdapterValueNames!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Unit: return FiirAdapterValueNames.Unit
        Enumeration(name, c_spelling, cases, origin):
            return FiirAdapterValueNames.Enumeration(
                is_negative = fresh_name(used, "result_is_negative"),
                magnitude = fresh_name(used, "result_magnitude"),
            )
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            return FiirAdapterValueNames.Record(name = fresh_name(used, "result"))
        else: return FiirAdapterValueNames.Scalar(name = fresh_name(used, "result"))

func fresh_name(used: list[str], candidate: str) -> str:
    var selected = candidate
    while contains_name(used, selected): selected = "_" + selected
    used.append(selected)
    return selected

# mark: Raw function declarations ==============================================================

func render_function(module: FiirModule, binding: str, function: FiirFunction) -> str!:
    if function.is_variadic:
        error("FIIR generation: variadic C function `" + function.name + "` requires a generated typed adapter")
    if is_keyword(function.name):
        error("FIIR generation: C function `" + function.name + "` needs a symbol-preserving adapter because its name is reserved in Luce")
    let names = try adapter_names(module, function)
    let adapter = adapter_symbol(binding, function.name)
    let checked = try function_needs_status(module, function)
    var output = "extern func " + adapter + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        output += try render_adapter_declaration(
            module,
            binding,
            function.parameters[index].boundary,
            names.parameters[index],
            "function `" + function.name + "` parameter `" + names.source_parameters[index] + "`",
            false,
        )
    let adapter_result = try adapter_carrier_type_or_unit(module, binding, function.result, "function `" + function.name + "` result")
    if checked and adapter_result != "unit":
        if len(function.parameters) > 0: output += ", "
        output += try render_adapter_declaration(module, binding, function.result, names.result, "function `" + function.name + "` result", true)
    output += ")"
    if checked: output += " -> i32"
    elif adapter_result != "unit": output += " -> " + adapter_result
    output += "\n\npub func " + function.name + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        output += names.source_parameters[index] + ": " + try render_public_type(module, function.parameters[index].boundary, "function `" + function.name + "` parameter `" + names.source_parameters[index] + "`", false)
    output += ")"
    let public_result = try render_public_type(module, function.result, "function `" + function.name + "` result", true)
    if public_result != "unit": output += " -> " + public_result
    output += ":\n"
    let call = try render_adapter_call(module, binding, function, adapter, names)
    if checked:
        output += "    let " + result_binding(names) + " = " + call + "\n"
        if function_has_integer_input(module, function):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.integer_range)) + "i32: trap(\"native_integer_range: C function `" + function.name + "` received an integer outside its target range\")\n"
        if try function_has_enumeration_input(module, function):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.enumeration_input)) + "i32: trap(\"native_enum_value: C function `" + function.name + "` received an undeclared enum value\")\n"
        if try boundary_contains_enumeration(module, function.result):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.enumeration_result)) + "i32: trap(\"native_enum_value: C function `" + function.name + "` returned an undeclared enum value\")\n"
        output += "    if " + names.status + " != " + str(adapter_status_code(FiirAdapterStatus.success)) + "i32: trap(\"native_adapter_status: C function `" + function.name + "` adapter returned an unknown status\")\n"
        if public_result != "unit": output += "    return " + try wrap_adapter_result(module, binding, function.result, names.result) + "\n"
    else:
        output += "    "
        if public_result != "unit": output += "return " + try wrap_public_result(module, function.result, call)
        else: output += call
        output += "\n"
    return output + "\n"

func render_adapter_declaration(module: FiirModule, binding: str, boundary: FiirBoundaryValue, names: FiirAdapterValueNames, context: str, is_output: bool) -> str!:
    var prefix = ""
    if is_output: prefix = "out "
    match names:
        Unit: return ""
        Scalar(name): return prefix + name + ": " + try adapter_carrier_type(module, boundary, context, false)
        Enumeration(is_negative, magnitude):
            return prefix + is_negative + ": bool, " + prefix + magnitude + ": u64"
        Record(name): return prefix + name + ": " + try adapter_record_type(module, binding, boundary)

func adapter_carrier_type_or_unit(module: FiirModule, binding: str, boundary: FiirBoundaryValue, context: str) -> str!:
    if try boundary_is_enumeration(module, boundary): return "enumeration"
    if try boundary_is_record(module, boundary): return try adapter_record_type(module, binding, boundary)
    return try adapter_carrier_type(module, boundary, context, true)

func result_binding(names: FiirAdapterNames) -> str:
    match names.result:
        Unit: return names.status
        Scalar(name): return "(" + names.status + ", " + name + ")"
        Enumeration(is_negative, magnitude): return "(" + names.status + ", " + is_negative + ", " + magnitude + ")"
        Record(name): return "(" + names.status + ", " + name + ")"

func render_adapter_call(module: FiirModule, binding: str, function: FiirFunction, adapter: str, names: FiirAdapterNames) -> str!:
    var output = adapter + "("
    for index in range(0, len(names.source_parameters)):
        if index > 0: output += ", "
        match names.parameters[index]:
            Scalar(name):
                let source = names.source_parameters[index]
                if try boundary_is_opaque_handle(module, function.parameters[index].boundary): output += source
                else: output += try adapter_input_expression(module, function.parameters[index].boundary, source + ".raw")
            Enumeration(is_negative, magnitude):
                output += names.source_parameters[index] + ".is_negative, " + names.source_parameters[index] + ".magnitude"
            Record(name):
                let record = try resolved_record_name(module, function.parameters[index].boundary)
                output += record_encode_name(binding, record) + "(" + names.source_parameters[index] + ")"
            Unit: error("FIIR generation: a function parameter cannot be void")
    return output + ")"

func wrap_adapter_result(module: FiirModule, binding: str, boundary: FiirBoundaryValue, names: FiirAdapterValueNames) -> str!:
    match names:
        Unit: error("FIIR generation: cannot wrap a void adapter result")
        Scalar(name): return try wrap_public_result(module, boundary, name)
        Enumeration(is_negative, magnitude):
            let value_type = try resolve_fiir_type(module, boundary.value_type)
            match value_type.form:
                Enumeration(name, c_spelling, cases, origin): return name + "(" + is_negative + ", " + magnitude + ")"
                else: trap("FIIR enum adapter result resolved to a non-enumeration")
        Record(name):
            return record_decode_name(binding, try resolved_record_name(module, boundary)) + "(" + name + ")"

pub func function_has_integer_input(module: FiirModule, function: FiirFunction) -> bool:
    for parameter in function.parameters:
        if type_contains_integer(module, parameter.boundary.value_type): return true
    return false

func type_contains_integer(module: FiirModule, type_id: FiirTypeId) -> bool:
    let value_type = resolve_fiir_type(module, type_id) catch reason:
        trap(reason)
    match value_type.form:
        Integer(kind, bits, is_signed): return true
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            for field in fields:
                if type_contains_integer(module, field.value_type): return true
        else: pass
    return false

pub func boundary_is_enumeration(module: FiirModule, boundary: FiirBoundaryValue) -> bool!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Enumeration(name, c_spelling, cases, origin): return true
        else: return false

pub func boundary_is_record(module: FiirModule, boundary: FiirBoundaryValue) -> bool!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin): return true
        else: return false

pub func boundary_is_opaque_handle(module: FiirModule, boundary: FiirBoundaryValue) -> bool!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        OpaqueHandle(name, c_spelling, origin): return true
        else: return false

pub func boundary_contains_enumeration(module: FiirModule, boundary: FiirBoundaryValue) -> bool!:
    return try type_contains_enumeration(module, boundary.value_type)

func type_contains_enumeration(module: FiirModule, type_id: FiirTypeId) -> bool!:
    let value_type = try resolve_fiir_type(module, type_id)
    match value_type.form:
        Enumeration(name, c_spelling, cases, origin): return true
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            for field in fields:
                if try type_contains_enumeration(module, field.value_type): return true
        else: pass
    return false

pub func function_has_enumeration_input(module: FiirModule, function: FiirFunction) -> bool!:
    for parameter in function.parameters:
        if try boundary_contains_enumeration(module, parameter.boundary): return true
    return false

pub func function_needs_status(module: FiirModule, function: FiirFunction) -> bool!:
    return (
        function_has_integer_input(module, function)
        or try function_has_enumeration_input(module, function)
        or try function_has_record_input(module, function)
        or try boundary_contains_enumeration(module, function.result)
        or try boundary_is_record(module, function.result)
    )

func function_has_record_input(module: FiirModule, function: FiirFunction) -> bool!:
    for parameter in function.parameters:
        if try boundary_is_record(module, parameter.boundary): return true
    return false

func adapter_record_type(module: FiirModule, binding: str, boundary: FiirBoundaryValue) -> str!:
    return adapter_record_name(binding, try resolved_record_name(module, boundary))

func resolved_record_name(module: FiirModule, boundary: FiirBoundaryValue) -> str!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin): return name
        else: error("FIIR generation: expected a C record boundary")

pub func parameter_names(function: FiirFunction) -> list[str]:
    let names = list[str]()
    for index in range(0, len(function.parameters)):
        var selected = function.parameters[index].name else "argument_" + str(index)
        if is_keyword(selected): selected = "argument_" + str(index)
        while contains_name(names, selected): selected = "_" + selected
        names.append(selected)
    return names

func contains_name(names: list[str], selected: str) -> bool:
    for name in names:
        if name == selected: return true
    return false

pub func adapter_carrier_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    if i64(boundary.value_type.value) >= len(module.types): error("FIIR generation: " + context + " has an unknown type")
    let named_type = module.types[boundary.value_type.value]
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Unit:
            if not permits_unit: error("FIIR generation: " + context + " cannot be void")
            return "unit"
        Boolean: return "bool"
        Integer(kind, bits, is_signed):
            if kind == FiirCIntegerKind.plain_char or is_signed: return "i64"
            return "u64"
        Floating(kind, radix, significand_bits, maximum_exponent):
            let width = exact_ieee_floating_width(value_type) else error(unsupported_scalar(context, named_type.spelling))
            if width == u16(16) or width == u16(32): return "f32"
            if width == u16(64): return "f64"
            error(unsupported_scalar(context, named_type.spelling))
        Enumeration(name, c_spelling, cases, origin):
            error("FIIR generation: " + context + " C enum `" + name + "` needs its expanded adapter shape")
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            error("FIIR generation: " + context + " C record `" + name + "` needs its expanded adapter shape")
        OpaqueHandle(name, c_spelling, origin): return opaque_handle_type(boundary, name)
        Typedef(target, origin): trap("resolved FIIR type remained a typedef")

func public_scalar_carrier_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            let width = exact_ieee_floating_width(resolved) else u16(0)
            if width == u16(16): return "f16"
        else: pass
    return try adapter_carrier_type(module, boundary, context, permits_unit)

func render_public_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    let value_type = module.types[boundary.value_type.value]
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Enumeration(name, c_spelling, cases, origin):
            match value_type.form:
                Typedef(target, typedef_origin): return value_type.spelling
                else: return name
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            match value_type.form:
                Typedef(target, typedef_origin): return value_type.spelling
                else: return name
        OpaqueHandle(name, c_spelling, origin): return opaque_handle_type(boundary, name)
        else: pass
    let adapter_type = try adapter_carrier_type(module, boundary, context, permits_unit)
    if adapter_type == "unit": return adapter_type
    match value_type.form:
        Typedef(target, origin): return value_type.spelling
        Boolean: return "c.boolean"
        Integer(kind, bits, is_signed): return "c." + c_integer_luce_name(kind)
        Floating(kind, radix, significand_bits, maximum_exponent): return "c." + c_floating_luce_name(kind)
        OpaqueHandle(name, c_spelling, origin): return opaque_handle_type(boundary, name)
        else: error(unsupported_scalar(context, value_type.spelling))

func wrap_public_result(module: FiirModule, boundary: FiirBoundaryValue, expression: str) -> str!:
    let value_type = module.types[boundary.value_type.value]
    let converted = try public_result_expression(module, boundary, expression)
    match value_type.form:
        Typedef(target, origin): return value_type.spelling + "(" + converted + ")"
        Enumeration(name, c_spelling, cases, origin):
            error("FIIR generation: C enum `" + name + "` requires a sign-magnitude adapter result")
        Boolean: return "c.boolean(" + converted + ")"
        Integer(kind, bits, is_signed): return "c." + c_integer_luce_name(kind) + "(" + converted + ")"
        Floating(kind, radix, significand_bits, maximum_exponent): return "c." + c_floating_luce_name(kind) + "(" + converted + ")"
        OpaqueHandle(name, c_spelling, origin): return converted
        else: error("FIIR generation: cannot wrap C type `" + value_type.spelling + "` as a public scalar")

func opaque_handle_type(boundary: FiirBoundaryValue, name: str) -> str:
    if boundary.nullability == FiirNullability.nonnull: return name
    return name + "?"

## `_Float16` remains f16 in generated APIs, while the private C adapter uses
## f32 as a lossless value transport. Every IEEE binary16 value is exactly
## representable in binary32, so these conversions introduce no rounding.
func adapter_input_expression(module: FiirModule, boundary: FiirBoundaryValue, expression: str) -> str!:
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            if kind == FiirCFloatingKind.float16: return "f32(" + expression + ")"
        else: pass
    return expression

func public_result_expression(module: FiirModule, boundary: FiirBoundaryValue, expression: str) -> str!:
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            if kind == FiirCFloatingKind.float16: return "f16(" + expression + ")"
        else: pass
    return expression

func c_integer_luce_name(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "plain_char"
        signed_char => "signed_char"
        unsigned_char => "unsigned_char"
        signed_short => "short"
        unsigned_short => "unsigned_short"
        signed_int => "int"
        unsigned_int => "unsigned_int"
        signed_long => "long"
        unsigned_long => "unsigned_long"
        signed_long_long => "long_long"
        unsigned_long_long => "unsigned_long_long"

func c_floating_luce_name(kind: FiirCFloatingKind) -> str:
    return match kind:
        float16 => "float16"
        single => "float"
        double => "double"
        long_double => "long_double"

func unsupported_scalar(context: str, spelling: str) -> str:
    return "FIIR generation: " + context + " C type `" + spelling + "` has no completed scalar adapter yet"

## Stable external symbol shared by the raw module and backend C adapter.
pub func adapter_symbol(binding: str, function: str) -> str:
    return "luce_fiir_" + binding + "_" + function

pub func object_reader_adapter_symbol(binding: str, object: str) -> str:
    return "luce_fiir_" + binding + "_read_" + object

pub func object_writer_adapter_symbol(binding: str, object: str) -> str:
    return "luce_fiir_" + binding + "_write_" + object

func object_read_name(object: str) -> str:
    return "read_" + object

func object_write_name(object: str) -> str:
    return "write_" + object

func repeated(value: str, count: i64) -> str:
    var output = ""
    for index in range(0, count): output += value
    return output

func single_line(value: str) -> str:
    var output = ""
    for character in value:
        if character == '\n' or character == char(13): output += " "
        else: output += str(character)
    return output

# mark: Serialized FIIR ========================================================================

## Render the versioned, deterministic JSON FIIR product. It remains useful
## after raw-source generation because support diagnostics and regeneration
## can be audited without invoking Clang again.
pub func render_fiir_json(module: FiirModule) -> str!:
    try validate_fiir(module)
    let root = map[str, json.Json]()
    root["format"] = json.Json.text(value = "luce-fiir-" + str(module.format_version))
    root["language"] = json.Json.text(value = language_name(module.language))
    root["generator"] = json.Json.text(value = module.generator_version)
    root["header"] = json.Json.text(value = module.header)
    root["target"] = json.Json.text(value = module.target)
    let arguments = list[json.Json]()
    for argument in module.clang_arguments: arguments.append(json.Json.text(value = argument))
    root["clang_arguments"] = json.Json.array(items = arguments)

    let types = list[json.Json]()
    for value_type in module.types:
        let fields = map[str, json.Json]()
        fields["spelling"] = json.Json.text(value = value_type.spelling)
        match value_type.form:
            Unit: fields["kind"] = json.Json.text(value = "unit")
            Boolean: fields["kind"] = json.Json.text(value = "boolean")
            Integer(kind, bits, is_signed):
                fields["kind"] = json.Json.text(value = "integer")
                fields["c_kind"] = json.Json.text(value = c_integer_kind_name(kind))
                fields["bits"] = json.Json.integer(value = i64(bits))
                fields["signed"] = json.Json.boolean(value = is_signed)
            Floating(kind, radix, significand_bits, maximum_exponent):
                fields["kind"] = json.Json.text(value = "floating")
                fields["c_kind"] = json.Json.text(value = c_floating_kind_name(kind))
                fields["radix"] = json.Json.integer(value = i64(radix))
                fields["significand_bits"] = json.Json.integer(value = i64(significand_bits))
                fields["maximum_exponent"] = json.Json.integer(value = i64(maximum_exponent))
            Enumeration(name, c_spelling, cases, origin):
                fields["kind"] = json.Json.text(value = "enumeration")
                fields["name"] = json.Json.text(value = name)
                if c_spelling == none: fields["c_spelling"] = json.Json.null
                else: fields["c_spelling"] = json.Json.text(value = c_spelling)
                fields["origin"] = origin_json(origin)
                let encoded_cases = list[json.Json]()
                for enum_case in cases:
                    let encoded_case = map[str, json.Json]()
                    encoded_case["name"] = json.Json.text(value = enum_case.name)
                    encoded_case["value"] = json.Json.text(value = integer_value_text(enum_case.value))
                    encoded_case["origin"] = origin_json(enum_case.origin)
                    encoded_cases.append(json.Json.object(fields = encoded_case))
                fields["cases"] = json.Json.array(items = encoded_cases)
            Record(name, c_spelling, record_fields, record_size_bits, alignment_bits, origin):
                fields["kind"] = json.Json.text(value = "record")
                fields["name"] = json.Json.text(value = name)
                if c_spelling == none: fields["c_spelling"] = json.Json.null
                else: fields["c_spelling"] = json.Json.text(value = c_spelling)
                fields["origin"] = origin_json(origin)
                let layout = map[str, json.Json]()
                layout["size_bits"] = json.Json.text(value = str(record_size_bits))
                layout["alignment_bits"] = json.Json.text(value = str(alignment_bits))
                fields["layout"] = json.Json.object(fields = layout)
                let encoded_fields = list[json.Json]()
                for record_field in record_fields:
                    let encoded_field = map[str, json.Json]()
                    encoded_field["name"] = json.Json.text(value = record_field.name)
                    encoded_field["type"] = json.Json.integer(value = i64(record_field.value_type.value))
                    encoded_field["offset_bits"] = json.Json.text(value = str(record_field.offset_bits))
                    encoded_field["origin"] = origin_json(record_field.origin)
                    encoded_fields.append(json.Json.object(fields = encoded_field))
                fields["fields"] = json.Json.array(items = encoded_fields)
            OpaqueHandle(name, c_spelling, origin):
                fields["kind"] = json.Json.text(value = "opaque_handle")
                fields["name"] = json.Json.text(value = name)
                fields["c_spelling"] = json.Json.text(value = c_spelling)
                fields["origin"] = origin_json(origin)
            Typedef(target, origin):
                fields["kind"] = json.Json.text(value = "typedef")
                fields["target"] = json.Json.integer(value = i64(target.value))
                fields["origin"] = origin_json(origin)
        let size = value_type.size_bits else u16(0)
        if size == u16(0):
            fields["size_bits"] = json.Json.null
        else:
            fields["size_bits"] = json.Json.integer(value = i64(size))
        types.append(json.Json.object(fields = fields))
    root["types"] = json.Json.array(items = types)

    let constants = list[json.Json]()
    for constant in module.constants: constants.append(constant_json(constant))
    root["constants"] = json.Json.array(items = constants)

    let objects = list[json.Json]()
    for object in module.objects: objects.append(object_json(object))
    root["objects"] = json.Json.array(items = objects)

    let functions = list[json.Json]()
    for function in module.functions: functions.append(function_json(function))
    root["functions"] = json.Json.array(items = functions)
    return json.Json.object(fields = root).pretty(2) + "\n"

func constant_json(constant: FiirConstant) -> json.Json:
    let fields = map[str, json.Json]()
    fields["name"] = json.Json.text(value = constant.name)
    fields["source"] = json.Json.text(value = constant_source_name(constant.source))
    fields["type"] = json.Json.integer(value = i64(constant.value_type.value))
    match constant.value:
        Integer(value):
            fields["kind"] = json.Json.text(value = "integer")
            fields["value"] = json.Json.text(value = integer_value_text(value))
        Boolean(value):
            fields["kind"] = json.Json.text(value = "boolean")
            fields["value"] = json.Json.boolean(value = value)
        Floating(bits):
            fields["kind"] = json.Json.text(value = "floating")
            fields["ieee_bits"] = json.Json.text(value = str(bits))
        Enumeration(value):
            fields["kind"] = json.Json.text(value = "enumeration")
            fields["value"] = json.Json.text(value = integer_value_text(value))
    fields["origin"] = origin_json(constant.origin)
    return json.Json.object(fields = fields)

func constant_source_name(source: FiirConstantSource) -> str:
    return match source:
        anonymous_enumeration => "anonymous_enumeration"
        object => "object"
        macro => "macro"

func object_json(object: FiirObject) -> json.Json:
    let fields = map[str, json.Json]()
    fields["name"] = json.Json.text(value = object.name)
    fields["type"] = json.Json.integer(value = i64(object.value_type.value))
    fields["access"] = json.Json.text(value = object_access_name(object.access))
    fields["volatile"] = json.Json.boolean(value = object.is_volatile)
    fields["origin"] = origin_json(object.origin)
    return json.Json.object(fields = fields)

func object_access_name(access: FiirObjectAccess) -> str:
    return match access:
        read_only => "read_only"
        read_write => "read_write"

func function_json(function: FiirFunction) -> json.Json:
    let fields = map[str, json.Json]()
    fields["name"] = json.Json.text(value = function.name)
    fields["calling_convention"] = json.Json.text(value = "c")
    fields["variadic"] = json.Json.boolean(value = function.is_variadic)
    fields["can_throw"] = json.Json.boolean(value = function.can_throw)
    fields["origin"] = origin_json(function.origin)
    let conditions = list[json.Json]()
    for condition in function.conditions: conditions.append(json.Json.text(value = condition))
    fields["conditions"] = json.Json.array(items = conditions)
    let parameters = list[json.Json]()
    for parameter in function.parameters:
        let value = map[str, json.Json]()
        let name = parameter.name else ""
        if name == "": value["name"] = json.Json.null
        else: value["name"] = json.Json.text(value = name)
        value["boundary"] = boundary_json(parameter.boundary)
        value["origin"] = origin_json(parameter.origin)
        parameters.append(json.Json.object(fields = value))
    fields["parameters"] = json.Json.array(items = parameters)
    fields["result"] = boundary_json(function.result)
    return json.Json.object(fields = fields)

func boundary_json(boundary: FiirBoundaryValue) -> json.Json:
    let fields = map[str, json.Json]()
    fields["type"] = json.Json.integer(value = i64(boundary.value_type.value))
    fields["nullability"] = json.Json.text(value = nullability_name(boundary.nullability))
    fields["ownership"] = json.Json.text(value = ownership_name(boundary.ownership))
    fields["mutability"] = json.Json.text(value = mutability_name(boundary.mutability))
    fields["lifetime"] = json.Json.text(value = lifetime_name(boundary.lifetime))
    return json.Json.object(fields = fields)

func origin_json(origin: FiirSourceOrigin) -> json.Json:
    let fields = map[str, json.Json]()
    fields["path"] = json.Json.text(value = origin.path)
    fields["line"] = json.Json.integer(value = i64(origin.line))
    fields["column"] = json.Json.integer(value = i64(origin.column))
    return json.Json.object(fields = fields)

pub func integer_value_text(value: FiirIntegerValue) -> str:
    return match value:
        Negative(magnitude) => "-" + str(magnitude)
        Nonnegative(integer) => str(integer)

func language_name(language: FiirLanguage) -> str:
    match language:
        c: return "c"

func c_integer_kind_name(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "plain_char"
        signed_char => "signed_char"
        unsigned_char => "unsigned_char"
        signed_short => "signed_short"
        unsigned_short => "unsigned_short"
        signed_int => "signed_int"
        unsigned_int => "unsigned_int"
        signed_long => "signed_long"
        unsigned_long => "unsigned_long"
        signed_long_long => "signed_long_long"
        unsigned_long_long => "unsigned_long_long"

func c_floating_kind_name(kind: FiirCFloatingKind) -> str:
    return match kind:
        float16 => "float16"
        single => "float"
        double => "double"
        long_double => "long_double"

func nullability_name(value: FiirNullability) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        nonnull: return "nonnull"
        nullable: return "nullable"

func ownership_name(value: FiirOwnership) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        borrowed: return "borrowed"
        owned: return "owned"

func mutability_name(value: FiirMutability) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        read_only: return "read_only"
        mutable: return "mutable"

func lifetime_name(value: FiirLifetime) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        call: return "call"
        returned: return "returned"
        owned: return "owned"
