#==============================================================================================
#
#   fiir.generator - Deterministic FIIR and binding products
#
#   DESCRIPTION:
#       Turns validated C FIIR into three inspectable products: a versioned
#       JSON fact record, an audited raw Luce module, and its C adapter. The C
#       adapter terminates target-specific scalar spelling and representation;
#       HIR and MIR see ordinary nominal `c` values plus one proven portable
#       adapter signature.
#
#       C Boolean, exact IEEE binary32 `float`, exact IEEE binary64 `double`
#       and `long double`, all fundamental C integer families, scalar typedef
#       chains, C enumerations, and typed integer constants have complete
#       products. Scalar families and typedefs use nominal universal carriers;
#       enumerations use a canonical sign-magnitude carrier. Only the generated
#       C adapter selects target representation. Extended floating carriers,
#       pointer ownership recipes, and f16 thunks extend the boundary later.
#
#==============================================================================================

from compiler.fiir.schema import FiirBoundaryValue, FiirCFloatingKind, FiirCIntegerKind, FiirConstant, FiirConstantValue, FiirEnumCase, FiirFunction, FiirIntegerValue, FiirLanguage, FiirLifetime, FiirModule, FiirMutability, FiirNullability, FiirOwnership, FiirSourceOrigin, FiirType, FiirTypeForm, FiirTypeId, is_c_identifier, plain_value_boundary, resolve_fiir_type, validate_fiir
from compiler.frontend.tokenizer import is_keyword
import std.json

# mark: Binding products =======================================================================

## Render one generated `.native.luc` module whose fixed-width adapter calls
## have the same shape for every target. `binding` is a stable portable
## identifier supplied by the binding declaration or explicit CLI command.
pub func render_raw_module(module: FiirModule, binding: str) -> str!:
    try validate_fiir(module)
    try validate_adapter_symbols(module, binding)
    let exposed_typedefs = collect_exposed_typedefs(module)
    try validate_raw_declaration_names(module, binding, exposed_typedefs)
    var output = "## Generated by " + module.generator_version + ". Do not edit.\n"
    output += "## C header: " + single_line(module.header) + "\n"
    output += "## Clang target: " + single_line(module.target) + "\n"
    if len(module.clang_arguments) > 0:
        output += "## Clang arguments:"
        for argument in module.clang_arguments: output += " " + single_line(argument)
        output += "\n"
    output += "\nimport c\n"
    var rendered_enumeration = false
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                if not rendered_enumeration:
                    output += "\n# mark: C enumerations " + repeated("=", 64) + "\n\n"
                    rendered_enumeration = true
                output += try render_enumeration(name, value_type.spelling, cases)
            else: pass
    var rendered_typedef = false
    for index in range(0, len(module.types)):
        let value_type = module.types[index]
        match value_type.form:
            Typedef(target, origin):
                if exposed_typedefs[index]:
                    if not rendered_typedef:
                        output += "\n# mark: C typedefs " + repeated("=", 68) + "\n\n"
                        rendered_typedef = true
                    output += try render_typedef(module, FiirTypeId(value = u32(index)), value_type)
            else: pass
    if len(module.constants) > 0:
        output += "\n# mark: C constants " + repeated("=", 67) + "\n\n"
        for constant in module.constants: output += try render_constant(constant)
    output += "\n# mark: Foreign declarations " + repeated("=", 59) + "\n\n"
    for function in module.functions:
        output += try render_function(module, binding, function)
        output += "\n"
    return output

# mark: Raw type declarations =================================================================

func render_typedef(module: FiirModule, type_id: FiirTypeId, value_type: FiirType) -> str!:
    if is_keyword(value_type.spelling):
        error("FIIR generation: C typedef `" + value_type.spelling + "` needs a name-preserving adapter because it is reserved in Luce")
    if value_type.spelling == "c":
        error("FIIR generation: C typedef `c` collides with the generated C module import")
    let resolved = try resolve_fiir_type(module, type_id)
    match resolved.form:
        Enumeration(name, c_spelling, cases, origin):
            if value_type.spelling == name: return ""
            return (
                "## Transparent C typedef alias for enumeration `" + name + "`.\n"
                + "pub type " + value_type.spelling + " = " + name + "\n\n"
            )
        else: pass
    let carrier = try adapter_carrier_type(
        module,
        plain_value_boundary(type_id),
        "typedef `" + value_type.spelling + "`",
        false,
    )
    return (
        "## Nominal carrier for C typedef `" + value_type.spelling + "`.\n"
        + "pub struct " + value_type.spelling + ":\n"
        + "    pub let raw: " + carrier + "\n\n"
        + "    pub func portable(self) -> " + carrier + ":\n"
        + "        return self.raw\n\n"
    )

func render_enumeration(name: str, spelling: str, cases: list[FiirEnumCase]) -> str!:
    if is_keyword(name):
        error("FIIR generation: C enum `" + spelling + "` needs a name-preserving adapter because `" + name + "` is reserved in Luce")
    if name == "c": error("FIIR generation: C enum carrier `c` collides with the generated C module import")
    var output = "## Nominal sign-magnitude carrier for C enum `" + spelling + "`.\n"
    output += "pub struct " + name + ":\n"
    output += "    let is_negative: bool\n"
    output += "    let magnitude: u64\n\n"
    output += "    pub func portable(self) -> (bool, u64):\n"
    output += "        return (self.is_negative, self.magnitude)\n\n"
    for enum_case in cases:
        if is_keyword(enum_case.name):
            error("FIIR generation: C enum constant `" + enum_case.name + "` is reserved in Luce")
        output += "pub let " + enum_case.name + ": " + name + " = " + name + "("
        match enum_case.value:
            Negative(magnitude): output += "true, " + str(magnitude) + "u64"
            Nonnegative(value): output += "false, " + str(value) + "u64"
        output += ")\n"
    return output + "\n"

func render_constant(constant: FiirConstant) -> str!:
    if is_keyword(constant.name):
        error("FIIR generation: C constant `" + constant.name + "` is reserved in Luce")
    var value_expression = ""
    match constant.value:
        Integer(value):
            match value:
                Negative(magnitude): value_expression = "true, " + str(magnitude) + "u64"
                Nonnegative(integer): value_expression = "false, " + str(integer) + "u64"
    return "pub let " + constant.name + ": c.integer_constant = c.integer_constant(" + value_expression + ")\n"

func collect_exposed_typedefs(module: FiirModule) -> list[bool]:
    let exposed = list[bool]()
    for value_type in module.types:
        match value_type.form:
            Typedef(target, origin): exposed.append(origin.path == module.header)
            else: exposed.append(false)
    for function in module.functions:
        exposed[function.result.value_type.value] = true
        for parameter in function.parameters:
            exposed[parameter.boundary.value_type.value] = true
    return exposed

## C tags and ordinary declarations occupy separate namespaces, while Luce's
## generated module has one declaration namespace. Reject every collapse here,
## before emitting partial source; a later recipe-aware naming plan can choose
## reviewed aliases without weakening this deterministic baseline.
func validate_raw_declaration_names(module: FiirModule, binding: str, exposed_typedefs: list[bool]) -> !:
    let names = map[str, str]()
    names["c"] = "the generated C module import"
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                try reserve_raw_name(names, name, "C enum carrier `" + value_type.spelling + "`")
                for enum_case in cases:
                    try reserve_raw_name(names, enum_case.name, "C enum constant `" + enum_case.name + "`")
            else: pass
    for index in range(0, len(module.types)):
        let value_type = module.types[index]
        match value_type.form:
            Typedef(target, origin):
                if not exposed_typedefs[index]: continue
                let resolved = try resolve_fiir_type(module, FiirTypeId(value = u32(index)))
                match resolved.form:
                    Enumeration(name, c_spelling, cases, enum_origin):
                        if value_type.spelling == name: continue
                    else: pass
                try reserve_raw_name(names, value_type.spelling, "C typedef `" + value_type.spelling + "`")
            else: pass
    for constant in module.constants:
        try reserve_raw_name(names, constant.name, "C constant `" + constant.name + "`")
    for function in module.functions:
        try reserve_raw_name(names, function.name, "C function wrapper `" + function.name + "`")
        let adapter = adapter_symbol(binding, function.name)
        try reserve_raw_name(names, adapter, "generated adapter declaration for `" + function.name + "`")

func reserve_raw_name(names: map[str, str], name: str, owner: str) -> !:
    if names.has(name):
        error("FIIR generation: raw declaration `" + name + "` is required by " + names[name] + " and " + owner)
    names[name] = owner

## Generated C adapter symbols share the header's external C namespace. Keep
## the check beside the one symbol plan consumed by both product renderers.
pub func validate_adapter_symbols(module: FiirModule, binding: str) -> !:
    if not is_c_identifier(binding):
        error("FIIR generation: binding name `" + binding + "` is not a portable identifier")
    let symbols = map[str, str]()
    for value_type in module.types:
        match value_type.form:
            Enumeration(name, c_spelling, cases, origin):
                for enum_case in cases: symbols[enum_case.name] = "C enum constant `" + enum_case.name + "`"
            else: pass
    for constant in module.constants: symbols[constant.name] = "C constant `" + constant.name + "`"
    for function in module.functions:
        symbols[function.name] = "C function `" + function.name + "`"
    for function in module.functions:
        let adapter = adapter_symbol(binding, function.name)
        if symbols.has(adapter):
            error("FIIR generation: adapter symbol `" + adapter + "` collides with " + symbols[adapter])
        symbols[adapter] = "generated adapter for `" + function.name + "`"

# mark: Adapter signature plan ================================================================

pub union FiirAdapterValueNames:
    Unit
    Scalar(name: str)
    Enumeration(is_negative: str, magnitude: str)

## Closed status protocol shared by the generated Luce declaration and its C
## implementation. Success is deliberately nonzero so every early validation
## failure can return a distinct stable reason before touching foreign code.
pub enum FiirAdapterStatus:
    integer_range
    success
    enumeration_input
    enumeration_result

pub func adapter_status_code(status: FiirAdapterStatus) -> i32:
    return match status:
        integer_range => 0
        success => 1
        enumeration_input => 2
        enumeration_result => 3

pub struct FiirAdapterNames:
    pub let source_parameters: list[str]
    pub let parameters: list[FiirAdapterValueNames]
    pub let result: FiirAdapterValueNames
    pub let status: str

pub func adapter_names(module: FiirModule, function: FiirFunction) -> FiirAdapterNames!:
    let source = parameter_names(function)
    let parameters = list[FiirAdapterValueNames]()
    let used = list[str]()
    for index in range(0, len(function.parameters)):
        let name = source[index]
        if try boundary_is_enumeration(module, function.parameters[index].boundary):
            parameters.append(FiirAdapterValueNames.Enumeration(
                is_negative = fresh_name(used, name + "_is_negative"),
                magnitude = fresh_name(used, name + "_magnitude"),
            ))
        else:
            parameters.append(FiirAdapterValueNames.Scalar(name = fresh_name(used, name)))
    for name in source:
        if not contains_name(used, name): used.append(name)
    let result = try adapter_result_names(module, function.result, used)
    let status = fresh_name(used, "status")
    return FiirAdapterNames(source_parameters = source, parameters = parameters, result = result, status = status)

func adapter_result_names(module: FiirModule, boundary: FiirBoundaryValue, used: list[str]) -> FiirAdapterValueNames!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Unit: return FiirAdapterValueNames.Unit
        Enumeration(name, c_spelling, cases, origin):
            return FiirAdapterValueNames.Enumeration(
                is_negative = fresh_name(used, "result_is_negative"),
                magnitude = fresh_name(used, "result_magnitude"),
            )
        else: return FiirAdapterValueNames.Scalar(name = fresh_name(used, "result"))

func fresh_name(used: list[str], candidate: str) -> str:
    var selected = candidate
    while contains_name(used, selected): selected = "_" + selected
    used.append(selected)
    return selected

# mark: Raw function declarations ==============================================================

func render_function(module: FiirModule, binding: str, function: FiirFunction) -> str!:
    if function.is_variadic:
        error("FIIR generation: variadic C function `" + function.name + "` requires a generated typed adapter")
    if is_keyword(function.name):
        error("FIIR generation: C function `" + function.name + "` needs a symbol-preserving adapter because its name is reserved in Luce")
    let names = try adapter_names(module, function)
    let adapter = adapter_symbol(binding, function.name)
    let checked = try function_needs_status(module, function)
    var output = "extern func " + adapter + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        output += try render_adapter_declaration(
            module,
            function.parameters[index].boundary,
            names.parameters[index],
            "function `" + function.name + "` parameter `" + names.source_parameters[index] + "`",
            false,
        )
    let adapter_result = try adapter_carrier_type_or_unit(module, function.result, "function `" + function.name + "` result")
    if checked and adapter_result != "unit":
        if len(function.parameters) > 0: output += ", "
        output += try render_adapter_declaration(module, function.result, names.result, "function `" + function.name + "` result", true)
    output += ")"
    if checked: output += " -> i32"
    elif adapter_result != "unit": output += " -> " + adapter_result
    output += "\n\npub func " + function.name + "("
    for index in range(0, len(function.parameters)):
        if index > 0: output += ", "
        output += names.source_parameters[index] + ": " + try render_public_type(module, function.parameters[index].boundary, "function `" + function.name + "` parameter `" + names.source_parameters[index] + "`", false)
    output += ")"
    let public_result = try render_public_type(module, function.result, "function `" + function.name + "` result", true)
    if public_result != "unit": output += " -> " + public_result
    output += ":\n"
    let call = try render_adapter_call(module, function, adapter, names)
    if checked:
        output += "    let " + result_binding(names) + " = " + call + "\n"
        if function_has_integer_input(module, function):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.integer_range)) + "i32: trap(\"native_integer_range: C function `" + function.name + "` received an integer outside its target range\")\n"
        if try function_has_enumeration_input(module, function):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.enumeration_input)) + "i32: trap(\"native_enum_value: C function `" + function.name + "` received an undeclared enum value\")\n"
        if try boundary_is_enumeration(module, function.result):
            output += "    if " + names.status + " == " + str(adapter_status_code(FiirAdapterStatus.enumeration_result)) + "i32: trap(\"native_enum_value: C function `" + function.name + "` returned an undeclared enum value\")\n"
        output += "    if " + names.status + " != " + str(adapter_status_code(FiirAdapterStatus.success)) + "i32: trap(\"native_adapter_status: C function `" + function.name + "` adapter returned an unknown status\")\n"
        if public_result != "unit": output += "    return " + try wrap_adapter_result(module, function.result, names.result) + "\n"
    else:
        output += "    "
        if public_result != "unit": output += "return " + try wrap_public_result(module, function.result, call)
        else: output += call
        output += "\n"
    return output + "\n"

func render_adapter_declaration(module: FiirModule, boundary: FiirBoundaryValue, names: FiirAdapterValueNames, context: str, is_output: bool) -> str!:
    var prefix = ""
    if is_output: prefix = "out "
    match names:
        Unit: return ""
        Scalar(name): return prefix + name + ": " + try adapter_carrier_type(module, boundary, context, false)
        Enumeration(is_negative, magnitude):
            return prefix + is_negative + ": bool, " + prefix + magnitude + ": u64"

func adapter_carrier_type_or_unit(module: FiirModule, boundary: FiirBoundaryValue, context: str) -> str!:
    if try boundary_is_enumeration(module, boundary): return "enumeration"
    return try adapter_carrier_type(module, boundary, context, true)

func result_binding(names: FiirAdapterNames) -> str:
    match names.result:
        Unit: return names.status
        Scalar(name): return "(" + names.status + ", " + name + ")"
        Enumeration(is_negative, magnitude): return "(" + names.status + ", " + is_negative + ", " + magnitude + ")"

func render_adapter_call(module: FiirModule, function: FiirFunction, adapter: str, names: FiirAdapterNames) -> str!:
    var output = adapter + "("
    for index in range(0, len(names.source_parameters)):
        if index > 0: output += ", "
        match names.parameters[index]:
            Scalar(name): output += names.source_parameters[index] + ".raw"
            Enumeration(is_negative, magnitude):
                output += names.source_parameters[index] + ".is_negative, " + names.source_parameters[index] + ".magnitude"
            Unit: error("FIIR generation: a function parameter cannot be void")
    return output + ")"

func wrap_adapter_result(module: FiirModule, boundary: FiirBoundaryValue, names: FiirAdapterValueNames) -> str!:
    match names:
        Unit: error("FIIR generation: cannot wrap a void adapter result")
        Scalar(name): return try wrap_public_result(module, boundary, name)
        Enumeration(is_negative, magnitude):
            let value_type = try resolve_fiir_type(module, boundary.value_type)
            match value_type.form:
                Enumeration(name, c_spelling, cases, origin): return name + "(" + is_negative + ", " + magnitude + ")"
                else: trap("FIIR enum adapter result resolved to a non-enumeration")

pub func function_has_integer_input(module: FiirModule, function: FiirFunction) -> bool:
    for parameter in function.parameters:
        let value_type = resolve_fiir_type(module, parameter.boundary.value_type) catch reason:
            trap(reason)
        match value_type.form:
            Integer(kind, bits, is_signed): return true
            else: pass
    return false

pub func boundary_is_enumeration(module: FiirModule, boundary: FiirBoundaryValue) -> bool!:
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Enumeration(name, c_spelling, cases, origin): return true
        else: return false

pub func function_has_enumeration_input(module: FiirModule, function: FiirFunction) -> bool!:
    for parameter in function.parameters:
        if try boundary_is_enumeration(module, parameter.boundary): return true
    return false

pub func function_needs_status(module: FiirModule, function: FiirFunction) -> bool!:
    return (
        function_has_integer_input(module, function)
        or try function_has_enumeration_input(module, function)
        or try boundary_is_enumeration(module, function.result)
    )

pub func parameter_names(function: FiirFunction) -> list[str]:
    let names = list[str]()
    for index in range(0, len(function.parameters)):
        var selected = function.parameters[index].name else "argument_" + str(index)
        if is_keyword(selected): selected = "argument_" + str(index)
        while contains_name(names, selected): selected = "_" + selected
        names.append(selected)
    return names

func contains_name(names: list[str], selected: str) -> bool:
    for name in names:
        if name == selected: return true
    return false

pub func adapter_carrier_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    if i64(boundary.value_type.value) >= len(module.types): error("FIIR generation: " + context + " has an unknown type")
    let named_type = module.types[boundary.value_type.value]
    let value_type = try resolve_fiir_type(module, boundary.value_type)
    match value_type.form:
        Unit:
            if not permits_unit: error("FIIR generation: " + context + " cannot be void")
            return "unit"
        Boolean: return "bool"
        Integer(kind, bits, is_signed):
            if kind == FiirCIntegerKind.plain_char or is_signed: return "i64"
            return "u64"
        Floating(kind, radix, significand_bits, maximum_exponent):
            let size = value_type.size_bits else error("FIIR generation: C type `" + named_type.spelling + "` has no target size")
            if kind == FiirCFloatingKind.single and radix == u16(2) and significand_bits == u16(24) and maximum_exponent == i32(128) and size == u16(32): return "f32"
            if kind == FiirCFloatingKind.double and radix == u16(2) and significand_bits == u16(53) and maximum_exponent == i32(1024) and size == u16(64): return "f64"
            if kind == FiirCFloatingKind.long_double and radix == u16(2) and significand_bits == u16(53) and maximum_exponent == i32(1024) and size == u16(64): return "f64"
            error(unsupported_scalar(context, named_type.spelling))
        Enumeration(name, c_spelling, cases, origin):
            error("FIIR generation: " + context + " C enum `" + name + "` needs its expanded adapter shape")
        Typedef(target, origin): trap("resolved FIIR type remained a typedef")

func render_public_type(module: FiirModule, boundary: FiirBoundaryValue, context: str, permits_unit: bool) -> str!:
    let value_type = module.types[boundary.value_type.value]
    let resolved = try resolve_fiir_type(module, boundary.value_type)
    match resolved.form:
        Enumeration(name, c_spelling, cases, origin):
            match value_type.form:
                Typedef(target, typedef_origin): return value_type.spelling
                else: return name
        else: pass
    let adapter_type = try adapter_carrier_type(module, boundary, context, permits_unit)
    if adapter_type == "unit": return adapter_type
    match value_type.form:
        Typedef(target, origin): return value_type.spelling
        Boolean: return "c.boolean"
        Integer(kind, bits, is_signed): return "c." + c_integer_luce_name(kind)
        Floating(kind, radix, significand_bits, maximum_exponent): return "c." + c_floating_luce_name(kind)
        else: error(unsupported_scalar(context, value_type.spelling))

func wrap_public_result(module: FiirModule, boundary: FiirBoundaryValue, expression: str) -> str!:
    let value_type = module.types[boundary.value_type.value]
    match value_type.form:
        Typedef(target, origin): return value_type.spelling + "(" + expression + ")"
        Enumeration(name, c_spelling, cases, origin):
            error("FIIR generation: C enum `" + name + "` requires a sign-magnitude adapter result")
        Boolean: return "c.boolean(" + expression + ")"
        Integer(kind, bits, is_signed): return "c." + c_integer_luce_name(kind) + "(" + expression + ")"
        Floating(kind, radix, significand_bits, maximum_exponent): return "c." + c_floating_luce_name(kind) + "(" + expression + ")"
        else: error("FIIR generation: cannot wrap C type `" + value_type.spelling + "` as a public scalar")

func c_integer_luce_name(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "plain_char"
        signed_char => "signed_char"
        unsigned_char => "unsigned_char"
        signed_short => "short"
        unsigned_short => "unsigned_short"
        signed_int => "int"
        unsigned_int => "unsigned_int"
        signed_long => "long"
        unsigned_long => "unsigned_long"
        signed_long_long => "long_long"
        unsigned_long_long => "unsigned_long_long"

func c_floating_luce_name(kind: FiirCFloatingKind) -> str:
    return match kind:
        single => "float"
        double => "double"
        long_double => "long_double"

func unsupported_scalar(context: str, spelling: str) -> str:
    return "FIIR generation: " + context + " C type `" + spelling + "` has no completed scalar adapter yet"

## Stable external symbol shared by the raw module and backend C adapter.
pub func adapter_symbol(binding: str, function: str) -> str:
    return "luce_fiir_" + binding + "_" + function

func repeated(value: str, count: i64) -> str:
    var output = ""
    for index in range(0, count): output += value
    return output

func single_line(value: str) -> str:
    var output = ""
    for character in value:
        if character == '\n' or character == char(13): output += " "
        else: output += str(character)
    return output

# mark: Serialized FIIR ========================================================================

## Render the versioned, deterministic JSON FIIR product. It remains useful
## after raw-source generation because support diagnostics and regeneration
## can be audited without invoking Clang again.
pub func render_fiir_json(module: FiirModule) -> str!:
    try validate_fiir(module)
    let root = map[str, json.Json]()
    root["format"] = json.Json.text(value = "luce-fiir-" + str(module.format_version))
    root["language"] = json.Json.text(value = language_name(module.language))
    root["generator"] = json.Json.text(value = module.generator_version)
    root["header"] = json.Json.text(value = module.header)
    root["target"] = json.Json.text(value = module.target)
    let arguments = list[json.Json]()
    for argument in module.clang_arguments: arguments.append(json.Json.text(value = argument))
    root["clang_arguments"] = json.Json.array(items = arguments)

    let types = list[json.Json]()
    for value_type in module.types:
        let fields = map[str, json.Json]()
        fields["spelling"] = json.Json.text(value = value_type.spelling)
        match value_type.form:
            Unit: fields["kind"] = json.Json.text(value = "unit")
            Boolean: fields["kind"] = json.Json.text(value = "boolean")
            Integer(kind, bits, is_signed):
                fields["kind"] = json.Json.text(value = "integer")
                fields["c_kind"] = json.Json.text(value = c_integer_kind_name(kind))
                fields["bits"] = json.Json.integer(value = i64(bits))
                fields["signed"] = json.Json.boolean(value = is_signed)
            Floating(kind, radix, significand_bits, maximum_exponent):
                fields["kind"] = json.Json.text(value = "floating")
                fields["c_kind"] = json.Json.text(value = c_floating_kind_name(kind))
                fields["radix"] = json.Json.integer(value = i64(radix))
                fields["significand_bits"] = json.Json.integer(value = i64(significand_bits))
                fields["maximum_exponent"] = json.Json.integer(value = i64(maximum_exponent))
            Enumeration(name, c_spelling, cases, origin):
                fields["kind"] = json.Json.text(value = "enumeration")
                fields["name"] = json.Json.text(value = name)
                if c_spelling == none: fields["c_spelling"] = json.Json.null
                else: fields["c_spelling"] = json.Json.text(value = c_spelling)
                fields["origin"] = origin_json(origin)
                let encoded_cases = list[json.Json]()
                for enum_case in cases:
                    let encoded_case = map[str, json.Json]()
                    encoded_case["name"] = json.Json.text(value = enum_case.name)
                    encoded_case["value"] = json.Json.text(value = integer_value_text(enum_case.value))
                    encoded_case["origin"] = origin_json(enum_case.origin)
                    encoded_cases.append(json.Json.object(fields = encoded_case))
                fields["cases"] = json.Json.array(items = encoded_cases)
            Typedef(target, origin):
                fields["kind"] = json.Json.text(value = "typedef")
                fields["target"] = json.Json.integer(value = i64(target.value))
                fields["origin"] = origin_json(origin)
        let size = value_type.size_bits else u16(0)
        if size == u16(0):
            fields["size_bits"] = json.Json.null
        else:
            fields["size_bits"] = json.Json.integer(value = i64(size))
        types.append(json.Json.object(fields = fields))
    root["types"] = json.Json.array(items = types)

    let constants = list[json.Json]()
    for constant in module.constants: constants.append(constant_json(constant))
    root["constants"] = json.Json.array(items = constants)

    let functions = list[json.Json]()
    for function in module.functions: functions.append(function_json(function))
    root["functions"] = json.Json.array(items = functions)
    return json.Json.object(fields = root).pretty(2) + "\n"

func constant_json(constant: FiirConstant) -> json.Json:
    let fields = map[str, json.Json]()
    fields["name"] = json.Json.text(value = constant.name)
    fields["type"] = json.Json.integer(value = i64(constant.value_type.value))
    match constant.value:
        Integer(value):
            fields["kind"] = json.Json.text(value = "integer")
            fields["value"] = json.Json.text(value = integer_value_text(value))
    fields["origin"] = origin_json(constant.origin)
    return json.Json.object(fields = fields)

func function_json(function: FiirFunction) -> json.Json:
    let fields = map[str, json.Json]()
    fields["name"] = json.Json.text(value = function.name)
    fields["calling_convention"] = json.Json.text(value = "c")
    fields["variadic"] = json.Json.boolean(value = function.is_variadic)
    fields["can_throw"] = json.Json.boolean(value = function.can_throw)
    fields["origin"] = origin_json(function.origin)
    let conditions = list[json.Json]()
    for condition in function.conditions: conditions.append(json.Json.text(value = condition))
    fields["conditions"] = json.Json.array(items = conditions)
    let parameters = list[json.Json]()
    for parameter in function.parameters:
        let value = map[str, json.Json]()
        let name = parameter.name else ""
        if name == "": value["name"] = json.Json.null
        else: value["name"] = json.Json.text(value = name)
        value["boundary"] = boundary_json(parameter.boundary)
        value["origin"] = origin_json(parameter.origin)
        parameters.append(json.Json.object(fields = value))
    fields["parameters"] = json.Json.array(items = parameters)
    fields["result"] = boundary_json(function.result)
    return json.Json.object(fields = fields)

func boundary_json(boundary: FiirBoundaryValue) -> json.Json:
    let fields = map[str, json.Json]()
    fields["type"] = json.Json.integer(value = i64(boundary.value_type.value))
    fields["nullability"] = json.Json.text(value = nullability_name(boundary.nullability))
    fields["ownership"] = json.Json.text(value = ownership_name(boundary.ownership))
    fields["mutability"] = json.Json.text(value = mutability_name(boundary.mutability))
    fields["lifetime"] = json.Json.text(value = lifetime_name(boundary.lifetime))
    return json.Json.object(fields = fields)

func origin_json(origin: FiirSourceOrigin) -> json.Json:
    let fields = map[str, json.Json]()
    fields["path"] = json.Json.text(value = origin.path)
    fields["line"] = json.Json.integer(value = i64(origin.line))
    fields["column"] = json.Json.integer(value = i64(origin.column))
    return json.Json.object(fields = fields)

pub func integer_value_text(value: FiirIntegerValue) -> str:
    return match value:
        Negative(magnitude) => "-" + str(magnitude)
        Nonnegative(integer) => str(integer)

func language_name(language: FiirLanguage) -> str:
    match language:
        c: return "c"

func c_integer_kind_name(kind: FiirCIntegerKind) -> str:
    return match kind:
        plain_char => "plain_char"
        signed_char => "signed_char"
        unsigned_char => "unsigned_char"
        signed_short => "signed_short"
        unsigned_short => "unsigned_short"
        signed_int => "signed_int"
        unsigned_int => "unsigned_int"
        signed_long => "signed_long"
        unsigned_long => "unsigned_long"
        signed_long_long => "signed_long_long"
        unsigned_long_long => "unsigned_long_long"

func c_floating_kind_name(kind: FiirCFloatingKind) -> str:
    return match kind:
        single => "float"
        double => "double"
        long_double => "long_double"

func nullability_name(value: FiirNullability) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        nonnull: return "nonnull"
        nullable: return "nullable"

func ownership_name(value: FiirOwnership) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        borrowed: return "borrowed"
        owned: return "owned"

func mutability_name(value: FiirMutability) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        read_only: return "read_only"
        mutable: return "mutable"

func lifetime_name(value: FiirLifetime) -> str:
    match value:
        not_applicable: return "not_applicable"
        unspecified: return "unspecified"
        call: return "call"
        returned: return "returned"
        owned: return "owned"
