#==============================================================================================
#
#   pipeline - The compiler spine
#
#   DESCRIPTION:
#       Puts the stages together, in order. Each stage owns one transformation,
#       this file only decides how they compose (LUCE_LANGUAGE_DESIGN.md §23):
#
#       source -> Tokenizer -> Parser -> Checker -> typed IR -> ExecutionBackend -> value
#                                                  \-> Lowerer -> canonical IR -> ArtifactBackend -> bytes
#
#   TARGETS:
#       wasm            WebAssembly module
#       arm64-macos     Mach-O executable for Apple silicon
#       x86_64-linux    ELF executable
#
#==============================================================================================

from compiler.backend import ArtifactBackend, ExecutionBackend
from compiler.backends.arm64_macos import Arm64MacosBackend
from compiler.backends.interpreter import Interpreter
from compiler.backends.wasm import WasmBackend
from compiler.backends.x86_64_linux import X86_64LinuxBackend
from compiler.canonical_ir import CanonicalProgram
from compiler.checker import Checker, SourceModule
from compiler.lowerer import Lowerer
from compiler.parser import Parser
from compiler.tokenizer import Tokenizer
from compiler.typed_ir import TypedProgram, Value
import std.files
import std.paths

# mark: Targets ===============================================================================

## Selects the artifact format produced by `build`.
pub enum BuildTarget:
    ## WebAssembly module.
    wasm
    ## Mach-O executable for Apple silicon.
    arm64_macos
    ## ELF executable for x86-64 Linux.
    x86_64_linux

# mark: Load and check ========================================================================

## Read, tokenize, parse, and check source files into one typed program.
pub func check(source_paths: list[str]) -> TypedProgram!:
    let modules = list[SourceModule]()
    for path in source_paths:
        modules.append(try load_module(path))
    return try Checker(modules).check()

# Read, tokenize and parse one file
# NOTE: Tokenizer and parser errors only carry line:column, the path is added
# here so every error reads path:line:column: message
func load_module(path: str) -> SourceModule!:
    let source = try files.read(path)
    let tokens = Tokenizer(source).tokenize() catch reason:
        error(path + ":" + reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        error(path + ":" + reason)
    return SourceModule(name = paths.stem(path), path = path, syntax = syntax_tree)

# mark: Lower and build =======================================================================

## Check and lower source files into canonical IR.
pub func lower(source_paths: list[str]) -> CanonicalProgram!:
    let program = try check(source_paths)
    return try Lowerer(program).lower()

## Compile source files into the artifact bytes for a target.
pub func build(target: BuildTarget, source_paths: list[str]) -> list[u8]!:
    match target:
        wasm:         return try build_with_backend(WasmBackend(), source_paths)
        arm64_macos:  return try build_with_backend(Arm64MacosBackend(), source_paths)
        x86_64_linux: return try build_with_backend(X86_64LinuxBackend(), source_paths)

## Compile source files with an artifact backend.
pub func build_with_backend(backend: ArtifactBackend, source_paths: list[str]) -> list[u8]!:
    let program = try lower(source_paths)
    return try backend.emit(program)

# mark: Run ===================================================================================

## Run one function from source files in the interpreter.
pub func run(source_paths: list[str], module_name: str, function_name: str) -> Value!:
    return try run_with_backend(Interpreter(), source_paths, module_name, function_name)

## Run one function from source files with an execution backend.
pub func run_with_backend(backend: ExecutionBackend, source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let program = try check(source_paths)
    return try backend.run(program, module_name, function_name)
