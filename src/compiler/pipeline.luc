#==============================================================================================
#
#   pipeline - The compiler spine, and the best place to start reading
#
#   DESCRIPTION:
#       Every command the `luce` binary offers is one walk down the stages
#       below: `check` stops after semantic analysis, `run` hands the typed
#       program to the reference interpreter, and `build` continues through
#       canonical MIR to a target backend. Read `build`, `check`, and `run`
#       first; they are three short functions that name every stage in order.
#       Then follow the CODE FLOW diagram into each stage's file, whose header
#       explains its own contract.
#
#       Vocabulary used throughout the compiler:
#         typed HIR       the program after names and types are resolved (hir/ir.luc)
#         canonical MIR   a flat, target-independent instruction stream (mir/canonical.luc)
#         artifact        the file `build` installs: a .wasm module or a native executable
#         slice           the subset of the 1.0 language a stage implements today
#         Stage-0         the frozen seed toolchain that compiles this source
#
#   STAGES:
#
#       -> tokens and layout                 Tokenizer
#       -> source syntax                     Parser
#       -> names, signatures, typed HIR      HirGenerator
#       -> flow, ownership                   SemanticAnalyzer
#       -> canonical MIR                     Lowerer
#       -> sealed runtime composition         Composer, when supplied
#       -> verified canonical MIR            MirVerifier
#       -> optimized canonical MIR           Optimizer
#       -> verified optimized MIR            MirVerifier
#       -> target legalization and selection backend
#       -> installed artifact                backend
#
#   CODE FLOW:
#
#                 ../luce.luc                          check / run / build
#                      |
#                      v
#                pipeline.luc
#                      |  sequence the stages
#                      v
#                frontend/tokenizer.luc  ---------  frontend/source.luc
#                      |  tokenize source
#                      v
#                frontend/parser.luc  ------------  frontend/syntax.luc, core_types.luc
#                      |  parse tokens
#                      v
#                hir/generator.luc  -----------  hir/ir.luc
#                      |  generate typed HIR
#                      v
#                hir/analyzer.luc
#                      |  apply whole-program rules
#                      |
#                      +---- check ----->  typed program, stop
#                      |
#                      +---- run ------->  backends/interpreter.luc
#                      |  execute the typed program
#                      |
#                      +---- build          compile to a file
#                                |
#                                v
#                          mir/lowerer.luc  --  mir/canonical.luc
#                                |  flatten into instructions; optionally
#                                |  compose separately lowered sealed runtime
#                                v
#                          mir/verifier.luc
#                                |  check the instructions
#                                v
#                          mir/optimizer.luc
#                                |  improve the instructions
#                                v
#                          mir/verifier.luc
#                                |  check again
#                                v
#                          built-in backend
#                                |  install the target file
#                                |
#                                +-- backends/wasm.luc
#                                |   write a WebAssembly module
#                                +-- backends/qbe.luc
#                                    translate canonical MIR to QBE IL
#                                      |
#                                      v
#                                    backends/qbe_toolchain.luc
#                                    assemble, link, atomically install
#
#       Two temporary combinations are named in the code as they stand. `HirGenerator`
#       currently owns both name/signature resolution and type checking because
#       no resolved-but-untyped IR exists yet. Each compiled backend currently
#       owns legalization, instruction selection, and container encoding because
#       no target IR exists yet. Those boundaries can split later without
#       changing the permanent path above.
#
#       `run` branches after semantic analysis and interprets typed
#       HIR. Keeping that independent semantic oracle lets it catch mistakes in
#       lowering and compiled backends. `backends/mir_interpreter.luc` executes
#       canonical MIR directly; the differential tests run both interpreters
#       and every encoder over the same programs (docs/compiler/mir.md, "How
#       we know any of this is right"). It does not replace the oracle.
#
#   TARGETS:
#       wasm            WebAssembly module
#       native          host executable through pinned QBE 1.3
#
#==============================================================================================

from compiler.backend import HirExecutionBackend
from compiler.c_api.header import render_c_header
from compiler.c_api.model import CApiInterface, c_api_interface
from compiler.backends.qbe_abi import render_qbe_abi_report
from compiler.mir.canonical import MirProgram
from compiler.mir.composer import compose_runtime
from compiler.mir.freestanding import require_freestanding
from compiler.backends.interpreter import HirInterpreter
from compiler.backends.qbe_toolchain import QbeToolchain
from compiler.backends.wasm import WasmBackend
from compiler.backends.emission import FunctionEmission
from compiler.hir.generator import HirGenerator
from compiler.hir.generation_model import SourceModule
from compiler.reporting.generics import GenericReport, bind_lowered_functions, offset_functions, remap_optimized_functions, report_generics, with_compilation_metrics
from compiler.reporting.interfaces import InterfaceCostReport, report_interface_costs
from compiler.mir.lowerer import Lowerer
from compiler.mir.verifier import MirVerifier
from compiler.mir.optimizer import OptimizationResult, Optimizer
from compiler.frontend.parser import Parser
from compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from compiler.frontend.source import Diagnostic
from compiler.frontend.tokenizer import Token, Tokenizer
from compiler.hir.ir import ModuleAuthority, PackageRole, Value, HirProgram
from compiler.product_io import install_text_atomically
from compiler.profile import profile_of
from compiler.runtime_contract import RuntimeService
from compiler.source_modules import authority_for_path, source_module_name
import std.files
import std.os
import std.paths

# mark: Targets ===============================================================================

## Compiler-supplied standard modules have their own source root. Their names
## therefore remain `c`, `math`, and so on regardless of the application
## layout; the loader also supplies their authority explicitly.
pub struct StandardSourceInput:
    pub let source_root: str
    pub let source_paths: list[str]

## The identity and source files that make one compilation unit. Package
## identity is an explicit input because it is part of `ErrorCode` values;
## deriving it from a path would make moving a checkout change program data.
pub struct PackageInput:
    pub let identity: str
    pub let source_root: str
    pub let source_paths: list[str]
    ## Source supplied by the compiler's standard-library loader. This is
    ## provenance, not a suffix or naming convention visible to source.
    pub let standard_sources: StandardSourceInput? = none

## Operational limits for one package compilation. These are compiler-product
## policy, never source semantics or MIR facts.
pub struct CompilationOptions:
    pub let generic_specialization_budget: i64 = 256

## Optional native C products installed beside (or independently from) the
## primary artifact. Paths are explicit so a build never surprises callers
## with guessed sidecar names.
pub struct BuildOutputOptions:
    pub let c_header: str? = none
    pub let abi_report: str? = none

## What a native build produces: a linked executable, or a library, one
## object file another program links against beside the generated C header
## (`luce build --lib`, base.md §17.6, §19.6). A library needs no `main`.
pub enum NativeEmit:
    executable
    library

## Native-only host-tool inputs. They are consumed after canonical MIR at the
## QBE boundary and cannot influence source typing or lowering.
pub struct NativeBuildOptions:
    pub let c_sources: list[str]? = none
    pub let c_arguments: list[str]? = none
    pub let emit: NativeEmit = NativeEmit.executable

## One semantic service named by a sealed package descriptor. The source
## spelling is resolved once to a HIR identity; it is not a linker convention.
pub struct RuntimeBindingInput:
    pub let service: RuntimeService
    pub let module_name: str
    pub let function_name: str

## The separately compiled, privileged runtime source package and its closed
## semantic-service descriptor.
pub struct RuntimePackageInput:
    pub let identity: str
    pub let source_root: str
    pub let source_paths: list[str]
    pub let bindings: list[RuntimeBindingInput]

## Selects the artifact format produced by `build`.
pub enum BuildTarget:
    wasm
    native

## Result of artifact production. Successful builds can still carry advisory
## diagnostics discovered before lowering.
pub struct BuildResult:
    pub let diagnostics: list[Diagnostic]
    pub let generic_reports: list[GenericReport]

## Result of reference execution plus the analysis reports for that program.
pub struct RunResult:
    pub let value: Value
    pub let diagnostics: list[Diagnostic]

## Source-level specialization report plus every advisory produced while
## analyzing the same program. Explain must not become a warning-suppressing
## alternate frontend path.
pub struct ExplainResult:
    pub let diagnostics: list[Diagnostic]
    pub let generic_report: GenericReport
    pub let interface_report: InterfaceCostReport

## Verified canonical MIR paired with the reports from every analyzed package
## that contributed to it. Backends consume only `program`; callers retain
## the source-level facts.
pub struct CompiledProgram:
    pub let program: MirProgram
    pub let c_api: CApiInterface
    pub let diagnostics: list[Diagnostic]
    pub let generic_reports: list[GenericReport]

# mark: Commands ===============================================================================

## Compile source files through every build stage and install the completed
## artifact at `output`. Native artifacts use the QBE host toolchain; QBE owns
## its scratch and replaces the destination only after linking succeeds.
pub func build(target: BuildTarget, output: str, package: PackageInput, options: CompilationOptions = CompilationOptions(), outputs: BuildOutputOptions = BuildOutputOptions(), native: NativeBuildOptions? = none) -> BuildResult!:
    try validate_build_outputs(target, output, outputs)
    try validate_native_build_options(target, output, outputs, native)
    let compiled = try lower_and_verify(package, options)
    let materialized = try materialize(target, output, compiled.program, native)
    try install_c_products(compiled.c_api, compiled.program, materialized.native_target, outputs)
    return BuildResult(
        diagnostics = compiled.diagnostics,
        generic_reports = with_compilation_metrics(compiled.generic_reports, compiled.program, materialized.emissions),
    )

## Build with an explicitly supplied sealed runtime package. Keeping the
## package input visible makes deployment/package lookup a caller concern,
## while every compiler stage still consumes one composed canonical MIR.
pub func build_with_runtime(target: BuildTarget, output: str, package: PackageInput, runtime: RuntimePackageInput, options: CompilationOptions = CompilationOptions(), outputs: BuildOutputOptions = BuildOutputOptions(), native: NativeBuildOptions? = none) -> BuildResult!:
    try validate_build_outputs(target, output, outputs)
    try validate_native_build_options(target, output, outputs, native)
    let compiled = try compile_with_runtime(package, runtime, options)
    let materialized = try materialize(target, output, compiled.program, native)
    try install_c_products(compiled.c_api, compiled.program, materialized.native_target, outputs)
    return BuildResult(
        diagnostics = compiled.diagnostics,
        generic_reports = with_compilation_metrics(compiled.generic_reports, compiled.program, materialized.emissions),
    )

struct MaterializedArtifact:
    let emissions: list[FunctionEmission]
    let native_target: str?

func materialize(target: BuildTarget, output: str, optimized_program: MirProgram, native: NativeBuildOptions?) -> MaterializedArtifact!:
    match target:
        wasm:
            let emission = try WasmBackend(os.clock_ms).emit_with_report(optimized_program)
            try files.write_bytes(output, emission.bytes)
            return MaterializedArtifact(emissions = emission.functions, native_target = none)
        native:
            var c_sources: list[str]? = none
            var c_arguments: list[str]? = none
            var emit = NativeEmit.executable
            if native != none:
                let options = native
                c_sources = options.c_sources
                c_arguments = options.c_arguments
                emit = options.emit
            match emit:
                library:
                    let emission = try QbeToolchain().materialize_library_with_report(optimized_program, output, c_arguments)
                    return MaterializedArtifact(emissions = emission.functions, native_target = emission.target)
                executable:
                    let emission = try QbeToolchain().materialize_with_report(optimized_program, output, c_sources, c_arguments)
                    return MaterializedArtifact(emissions = emission.functions, native_target = emission.target)

## Run the complete frontend and semantic analysis, returning analyzed typed
## HIR. For example, editor tooling can call this without choosing a target.
pub func check(package: PackageInput, options: CompilationOptions = CompilationOptions()) -> AnalyzedProgram!:
    return try analyze_sources(package, options)

## Analyze source files and run one public, parameterless function through the
## typed-HIR reference interpreter; for example,
## `run(package, "main", "answer")`.
pub func run(package: PackageInput, module_name: str, function_name: str, options: CompilationOptions = CompilationOptions()) -> RunResult!:
    return try run_program(package, module_name, function_name, list[str](), options)

## Run one function in the reference interpreter; when it is the program's
## process entry, run the process with `program_arguments`, as the built
## executable would receive them.
pub func run_program(package: PackageInput, module_name: str, function_name: str, program_arguments: list[str], options: CompilationOptions) -> RunResult!:
    let analyzed = try analyze_sources(package, options)
    if names_process_entry(analyzed.hir, module_name, function_name):
        var arguments = program_arguments
        if base_process_entry(analyzed.hir):
            # A Base `main` receives `argv` as C does, program name first
            # (base.md §9.7); the entry module's path stands in for it here.
            arguments = [process_entry_path(analyzed.hir)]
            for argument in program_arguments: arguments.append(argument)
        let status = try HirInterpreter().run_process(analyzed, arguments)
        return RunResult(value = status, diagnostics = analyzed.diagnostics)
    let value = try HirInterpreter().run(analyzed, module_name, function_name)
    return RunResult(value = value, diagnostics = analyzed.diagnostics)

## Whether the process entry takes a Base span (`str[]`/`cstr[]`) rather than
## full Luce's `slice[str]`.
func base_process_entry(program: HirProgram) -> bool:
    let process_symbol = program.process_entry
    if process_symbol == none: return false
    for function in program.functions:
        if function.symbol.value != process_symbol.value: continue
        if len(function.parameters) == 0: return false
        match program.types.definitions[function.parameters[0].value_type.value].form:
            Span(element, is_const): return true
            else: return false
    return false

func process_entry_path(program: HirProgram) -> str:
    let process_symbol = program.process_entry
    if process_symbol == none: return ""
    for function in program.functions:
        if function.symbol.value == process_symbol.value: return program.modules[function.module.value].path
    return ""

func names_process_entry(program: HirProgram, module_name: str, function_name: str) -> bool:
    let process_symbol = program.process_entry
    if process_symbol == none: return false
    for function in program.functions:
        if function.symbol.value != process_symbol.value: continue
        return function.name == function_name and program.modules[function.module.value].name == module_name
    return false

## Analyze one package and expose the specialization provenance/cost report
## used by `luce explain` without selecting or invoking an artifact backend.
pub func explain(package: PackageInput, options: CompilationOptions = CompilationOptions()) -> ExplainResult!:
    let analyzed = try analyze_sources(package, options)
    return ExplainResult(
        diagnostics = analyzed.diagnostics,
        generic_report = report_generics(analyzed.hir),
        interface_report = report_interface_costs(analyzed.hir),
    )

# mark: Stage values ===========================================================================

# One source file after I/O but before lexical analysis.
struct SourceFile:
    let name: str
    let path: str
    let authority: ModuleAuthority
    let text: str
    ## Provenance: supplied by the compiler's standard-library loader.
    let standard: bool

# One source file after token and layout synthesis but before parsing.
struct TokenizedFile:
    let name: str
    let path: str
    let authority: ModuleAuthority
    let tokens: list[Token]
    let standard: bool

# mark: Custom backends ========================================================================
#
# `build` and `run` above name their concrete backends so the built-in
# commands read as one straight line. HIR execution has one genuinely common
# value contract, so callers can substitute an execution backend here.

## Run the analyzed typed HIR with a caller-provided execution backend. This
## keeps custom interpreters on the same semantic path as the built-in one.
pub func run_with_backend(backend: HirExecutionBackend, package: PackageInput, module_name: str, function_name: str, options: CompilationOptions = CompilationOptions()) -> RunResult!:
    let analyzed = try analyze_sources(package, options)
    let value = try backend.run(analyzed, module_name, function_name)
    return RunResult(value = value, diagnostics = analyzed.diagnostics)

# mark: Sealed runtime =========================================================================

## Compile the sealed runtime source to verified, target-neutral canonical MIR
## and retain its analysis reports. Keeping this entry explicit lets packaging
## choose where the shipped runtime sources live without granting runtime
## authority to ordinary packages.
pub func compile_runtime(package: RuntimePackageInput, options: CompilationOptions = CompilationOptions()) -> CompiledProgram!:
    let analyzed = try analyze_package(
        PackageInput(identity = package.identity, source_root = package.source_root, source_paths = package.source_paths),
        PackageRole.sealed_runtime,
        package.bindings,
        options,
    )
    let program = try Lowerer(analyzed).lower()
    try MirVerifier(program).verify()
    return CompiledProgram(
        program = program,
        c_api = try c_api_interface(analyzed.hir),
        diagnostics = analyzed.diagnostics,
        generic_reports = [bind_lowered_functions(report_generics(analyzed.hir), program)],
    )

## Compile application and sealed runtime sources independently, preserve both
## diagnostic streams, compose their canonical MIR, then verify and optimize
## the one closed program every artifact backend consumes.
pub func compile_with_runtime(application: PackageInput, runtime: RuntimePackageInput, options: CompilationOptions = CompilationOptions()) -> CompiledProgram!:
    let analyzed_application = try analyze_sources(application, options)
    let application_program = try Lowerer(analyzed_application).lower()
    if package_is_base(application): try require_freestanding(application_program)
    let compiled_runtime = try compile_runtime(runtime, options)
    let composed = try compose_runtime(application_program, compiled_runtime.program)
    let optimized = try verify_and_optimize(composed)
    let reports = list[GenericReport]()
    reports.append(bind_lowered_functions(report_generics(analyzed_application.hir), application_program))
    for report in compiled_runtime.generic_reports:
        reports.append(offset_functions(report, len(application_program.functions)))
    return CompiledProgram(
        program = optimized.program,
        c_api = try c_api_interface(analyzed_application.hir),
        diagnostics = combine_diagnostics(analyzed_application.diagnostics, compiled_runtime.diagnostics),
        generic_reports = remap_optimized_functions(reports, optimized.function_remap),
    )

# mark: Shared stages ==========================================================================

# Frontend through semantic analysis. `check`, `run`, and `build` all start here.
func analyze_sources(package: PackageInput, options: CompilationOptions) -> AnalyzedProgram!:
    return try analyze_package(package, PackageRole.ordinary, list[RuntimeBindingInput](), options)

func analyze_package(package: PackageInput, role: PackageRole, bindings: list[RuntimeBindingInput], options: CompilationOptions) -> AnalyzedProgram!:
    if len(package.identity) == 0: error("package identity cannot be empty")
    if options.generic_specialization_budget <= 0: error("generic specialization budget must be positive")
    let sources = try read_sources(package)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let generator = HirGenerator(package.identity, modules, role, options.generic_specialization_budget, os.clock_ms)
    for binding in bindings:
        generator.bind_runtime_service(binding.service, binding.module_name, binding.function_name)
    let hir_program = try generator.generate()
    return try SemanticAnalyzer(hir_program).analyze()

# Analysis through optimized, verified target-neutral MIR.
pub func lower_and_verify(package: PackageInput, options: CompilationOptions = CompilationOptions()) -> CompiledProgram!:
    let analyzed_hir = try analyze_sources(package, options)
    let canonical_program = try Lowerer(analyzed_hir).lower()
    if package_is_base(package): try require_freestanding(canonical_program)
    let report = bind_lowered_functions(report_generics(analyzed_hir.hir), canonical_program)
    let optimized = try verify_and_optimize(canonical_program)
    return CompiledProgram(
        program = optimized.program,
        c_api = try c_api_interface(analyzed_hir.hir),
        diagnostics = analyzed_hir.diagnostics,
        generic_reports = remap_optimized_functions([report], optimized.function_remap),
    )

func combine_diagnostics(first: list[Diagnostic], second: list[Diagnostic]) -> list[Diagnostic]:
    let combined = list[Diagnostic]()
    for diagnostic in first: combined.append(diagnostic)
    for diagnostic in second: combined.append(diagnostic)
    return combined

func verify_and_optimize(canonical_program: MirProgram) -> OptimizationResult!:
    try MirVerifier(canonical_program).verify()
    let optimized = Optimizer(canonical_program).optimize()
    try MirVerifier(optimized.program).verify()
    return optimized

# mark: C product installation ================================================================

func validate_native_build_options(target: BuildTarget, artifact: str, outputs: BuildOutputOptions, native: NativeBuildOptions?) -> !:
    if native == none: return
    let options = native
    if options.emit == NativeEmit.library:
        if target != BuildTarget.native: error("build: --lib requires `--target native`")
        let library_sources = options.c_sources
        if library_sources != none and len(library_sources) > 0: error("build: --lib takes no C sources; link them with the library")
    let sources = options.c_sources
    let arguments = options.c_arguments
    let header = outputs.c_header
    let report = outputs.abi_report
    var has_sources = false
    var has_arguments = false
    if sources != none: has_sources = len(sources) > 0
    if arguments != none: has_arguments = len(arguments) > 0
    if target != BuildTarget.native and (has_sources or has_arguments):
        error("build: C sources and arguments require `--target native`")
    if sources != none:
        for index in range(0, len(sources)):
            let source = sources[index]
            if source == "": error("build: C source path cannot be empty")
            if source == artifact: error("build: C source must differ from the primary artifact")
            if header != none and source == header:
                error("build: C source must differ from the C header output")
            if report != none and source == report:
                error("build: C source must differ from the ABI report output")
            for earlier in range(0, index):
                if sources[earlier] == source:
                    error("build: duplicate C source `" + source + "`")
    if arguments != none:
        for argument in arguments:
            if argument == "": error("build: C compiler argument cannot be empty")

func validate_build_outputs(target: BuildTarget, artifact: str, outputs: BuildOutputOptions) -> !:
    if outputs.c_header == none and outputs.abi_report == none: return
    if target != BuildTarget.native: error("build: C header and ABI report outputs require `--target native`")
    let header = outputs.c_header
    let report = outputs.abi_report
    if header != none:
        if len(header) == 0: error("build: C header output path cannot be empty")
        if header == artifact: error("build: C header output must differ from the primary artifact")
    if report != none:
        if len(report) == 0: error("build: ABI report output path cannot be empty")
        if report == artifact: error("build: ABI report output must differ from the primary artifact")
    if header != none and report != none and header == report:
        error("build: C header and ABI report outputs must differ")

func install_c_products(api: CApiInterface, program: MirProgram, native_target: str?, outputs: BuildOutputOptions) -> !:
    if outputs.c_header != none:
        let path = outputs.c_header else trap("C header path disappeared")
        try install_text_atomically(path, render_c_header(api), "build: C header")
    if outputs.abi_report != none:
        let path = outputs.abi_report else trap("ABI report path disappeared")
        let target = native_target else trap("validated native build produced no target")
        try install_text_atomically(path, try render_qbe_abi_report(api, program, target), "build: C ABI report")

# mark: Source stages =========================================================================

# Read application and compiler-supplied standard roots into one semantic
# package while retaining each written path for diagnostics.
func read_sources(package: PackageInput) -> list[SourceFile]!:
    let sources = list[SourceFile]()
    for path in package.source_paths:
        let authority = application_module_authority(path)
        sources.append(SourceFile(
            name = try source_module_name(package.source_root, path, authority),
            path = path,
            authority = authority,
            text = try files.read(path),
            standard = false,
        ))
    let standard = package.standard_sources
    if standard != none:
        for path in standard.source_paths:
            # A `.lucb` standard module (`memory`, base.md §12) is Base
            # source like any other; only `.luc` standard modules reach
            # the `Builtin` namespace.
            var authority = ModuleAuthority.standard
            if application_module_authority(path) == ModuleAuthority.base: authority = ModuleAuthority.base
            sources.append(SourceFile(
                name = try source_module_name(standard.source_root, path, authority),
                path = path,
                authority = authority,
                text = try files.read(path),
                standard = true,
            ))
    return sources

# Turn source text into tokens, including synthesized indent/dedent layout, and
# prefix lexical diagnostics with the originating path.
func tokenize_sources(sources: list[SourceFile]) -> list[TokenizedFile]!:
    let tokenized_files = list[TokenizedFile]()
    for source in sources:
        let tokens = Tokenizer(source.text, profile_of(source.authority)).tokenize() catch reason:
            error(source.path + ":" + reason)
        tokenized_files.append(TokenizedFile(
            name = source.name,
            path = source.path,
            authority = source.authority,
            tokens = tokens,
            standard = source.standard,
        ))
    return tokenized_files

# Turn each token stream into source syntax and package it with the module name
# and path HirGenerator needs for cross-file resolution and diagnostics.
func parse_modules(tokenized_files: list[TokenizedFile]) -> list[SourceModule]!:
    let modules = list[SourceModule]()
    for file in tokenized_files:
        let syntax_tree = Parser(file.tokens, profile_of(file.authority)).parse() catch reason:
            error(file.path + ":" + reason)
        modules.append(SourceModule(
            name = file.name,
            path = file.path,
            authority = file.authority,
            syntax = syntax_tree,
            standard = file.standard,
        ))
    return modules

# A package is a Base package when every module it supplies is `.lucb`; such a
# package must lower to a freestanding program (base.md §16.2).
func package_is_base(package: PackageInput) -> bool:
    if len(package.source_paths) == 0: return false
    for path in package.source_paths:
        if authority_for_path(path) != ModuleAuthority.base: return false
    return true

# The suffix is package-reader authority, not grammar or a naming convention
# interpreted by HIR. Removing the suffix keeps `arena.lucn` as module
# `arena`, so importing its safe wrappers does not mention the authority bit.
func application_module_authority(path: str) -> ModuleAuthority:
    return authority_for_path(path)
