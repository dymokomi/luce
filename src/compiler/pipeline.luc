from compiler.backend import ArtifactBackend, ExecutionBackend
from compiler.canonical_ir import CanonicalProgram
from compiler.checker import Checker, SourceModule
from compiler.interpreter import Interpreter
from compiler.lowerer import Lowerer
from compiler.parser import Parser
from compiler.tokenizer import Tokenizer
from compiler.typed_ir import TypedProgram, Value
from compiler.wasm_backend import WasmBackend
import std.files
import std.paths

# The compiler's visible spine (LUCE_LANGUAGE_DESIGN.md section 23):
# source -> Tokenizer -> Parser -> Checker -> typed IR -> ExecutionBackend -> result
#                                             \-> Lowerer -> canonical IR -> ArtifactBackend -> bytes
#
# Keep stage order here. Each stage owns one transformation; this module owns
# how those transformations compose. Only the implemented stages appear below.
func check(source_paths: list[str]) -> TypedProgram!:
    let modules = list[SourceModule]()
    for path in source_paths:
        let source = try files.read(path)
        let tokens = try Tokenizer(source).tokenize()
        let syntax_tree = try Parser(tokens).parse()
        modules.append(SourceModule(name = paths.stem(path), path = path, syntax = syntax_tree))
    return try Checker(modules).check()

func lower(source_paths: list[str]) -> CanonicalProgram!:
    let program = try check(source_paths)
    return try Lowerer(program).lower()

func build(source_paths: list[str]) -> list[u8]!:
    return try build_with(WasmBackend(), source_paths)

func build_with(backend: ArtifactBackend, source_paths: list[str]) -> list[u8]!:
    let program = try lower(source_paths)
    return try backend.emit(program)

func run(source_paths: list[str], module_name: str, function_name: str) -> Value!:
    return try run_with(Interpreter(), source_paths, module_name, function_name)

func run_with(backend: ExecutionBackend, source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let program = try check(source_paths)
    return try backend.run(program, module_name, function_name)
