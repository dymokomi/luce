#==============================================================================================
#
#   pipeline - The compiler spine
#
#   DESCRIPTION:
#       The compiler's executable architectural roadmap. Read `build` from top
#       to bottom to see every permanent frontend and middle-end stage in order:
#
#       source files
#       -> tokens and layout                 Tokenizer
#       -> source syntax                     Parser
#       -> names, signatures, typed HIR      Checker
#       -> flow, ownership                   SemanticAnalyzer
#       -> canonical MIR                     Lowerer
#       -> verified canonical MIR            MirVerifier
#       -> optimized canonical MIR           Optimizer
#       -> verified optimized MIR            MirVerifier
#       -> target legalization and selection ArtifactBackend
#       -> artifact bytes                    ArtifactBackend
#
#       Two temporary combinations are named honestly in code. `Checker`
#       currently owns both name/signature resolution and type checking because
#       no resolved-but-untyped IR exists yet. Each compiled backend currently
#       owns legalization, instruction selection, and container encoding because
#       no target IR exists yet. Those boundaries can split later without
#       changing the permanent path above.
#
#       `run` deliberately branches after semantic analysis and interprets typed
#       HIR. Keeping that independent semantic oracle lets it catch mistakes in
#       lowering and compiled backends. A future MIR interpreter may be added as
#       another backend, but should not replace this reference path.
#
#   TARGETS:
#       wasm            WebAssembly module
#       arm64-macos     Mach-O executable for Apple silicon
#       x86_64-linux    ELF executable
#
#==============================================================================================

from compiler.backend import ArtifactBackend, HirExecutionBackend
from compiler.backends.arm64_macos import Arm64MacosBackend
from compiler.backends.interpreter import HirInterpreter
from compiler.backends.wasm import WasmBackend
from compiler.backends.x86_64_linux import X86_64LinuxBackend
from compiler.checker import Checker, SourceModule
from compiler.lowerer import Lowerer
from compiler.mir_verifier import MirVerifier
from compiler.optimizer import Optimizer
from compiler.parser import Parser
from compiler.semantic_analyzer import AnalyzedProgram, SemanticAnalyzer
from compiler.tokenizer import Token, Tokenizer
from compiler.hir import Value
import std.files
import std.paths

# mark: Targets ===============================================================================

## Selects the artifact format produced by `build`.
pub enum BuildTarget:
    wasm
    arm64_macos
    x86_64_linux

# mark: Stage values ===========================================================================

# One source file after I/O but before lexical analysis.
struct SourceFile:
    name: str
    path: str
    text: str

# One source file after token and layout synthesis but before parsing.
struct TokenizedFile:
    name: str
    path: str
    tokens: list[Token]

# mark: Commands ===============================================================================

## Compile source files through every build stage and return target artifact
## bytes. For example, target `wasm` returns a complete WebAssembly module.
pub func build(target: BuildTarget, source_paths: list[str]) -> list[u8]!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let hir_program = try Checker(modules).check()
    let analyzed_hir = try SemanticAnalyzer(hir_program).analyze()
    let canonical_program = try Lowerer(analyzed_hir).lower()
    try MirVerifier(canonical_program).verify()
    let optimized_program = Optimizer(canonical_program).optimize()
    try MirVerifier(optimized_program).verify()

    match target:
        wasm:         return try WasmBackend().emit(optimized_program)
        arm64_macos:  return try Arm64MacosBackend().emit(optimized_program)
        x86_64_linux: return try X86_64LinuxBackend().emit(optimized_program)

## Run the complete frontend and semantic analysis, returning analyzed typed
## HIR. For example, editor tooling can call this without choosing a target.
pub func check(source_paths: list[str]) -> AnalyzedProgram!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let hir_program = try Checker(modules).check()
    let analyzed_hir = try SemanticAnalyzer(hir_program).analyze()
    return analyzed_hir

## Analyze source files and run one public, parameterless function through the
## typed-HIR reference interpreter; for example, `run(paths, "main", "answer")`.
pub func run(source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let hir_program = try Checker(modules).check()
    let analyzed_hir = try SemanticAnalyzer(hir_program).analyze()
    return try HirInterpreter().run(analyzed_hir, module_name, function_name)

# mark: Custom backends ========================================================================

## Run the same verified build pipeline as `build`, then let a caller-provided
## backend legalize, select, and emit the optimized canonical MIR.
pub func build_with_backend(backend: ArtifactBackend, source_paths: list[str]) -> list[u8]!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let hir_program = try Checker(modules).check()
    let analyzed_hir = try SemanticAnalyzer(hir_program).analyze()
    let canonical_program = try Lowerer(analyzed_hir).lower()
    try MirVerifier(canonical_program).verify()
    let optimized_program = Optimizer(canonical_program).optimize()
    try MirVerifier(optimized_program).verify()
    return try backend.emit(optimized_program)

## Run the analyzed typed HIR with a caller-provided execution backend. This
## keeps custom interpreters on the same semantic path as the built-in one.
pub func run_with_backend(backend: HirExecutionBackend, source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let hir_program = try Checker(modules).check()
    let analyzed_hir = try SemanticAnalyzer(hir_program).analyze()
    return try backend.run(analyzed_hir, module_name, function_name)

# mark: Source stages =========================================================================

# Read each requested path into a named source value. For example,
# `examples/math.luc` becomes module candidate `math` while retaining its path
# for later diagnostics.
func read_sources(source_paths: list[str]) -> list[SourceFile]!:
    let sources = list[SourceFile]()
    for path in source_paths:
        sources.append(SourceFile(
            name = paths.stem(path),
            path = path,
            text = try files.read(path),
        ))
    return sources

# Turn source text into tokens, including synthesized indent/dedent layout, and
# prefix lexical diagnostics with the originating path.
func tokenize_sources(sources: list[SourceFile]) -> list[TokenizedFile]!:
    let tokenized_files = list[TokenizedFile]()
    for source in sources:
        let tokens = Tokenizer(source.text).tokenize() catch reason:
            error(source.path + ":" + reason)
        tokenized_files.append(TokenizedFile(
            name = source.name,
            path = source.path,
            tokens = tokens,
        ))
    return tokenized_files

# Turn each token stream into source syntax and package it with the module name
# and path the checker needs for cross-file resolution and diagnostics.
func parse_modules(tokenized_files: list[TokenizedFile]) -> list[SourceModule]!:
    let modules = list[SourceModule]()
    for file in tokenized_files:
        let syntax_tree = Parser(file.tokens).parse() catch reason:
            error(file.path + ":" + reason)
        modules.append(SourceModule(
            name = file.name,
            path = file.path,
            syntax = syntax_tree,
        ))
    return modules
