#==============================================================================================
#
#   pipeline - The compiler spine, and the best place to start reading
#
#   DESCRIPTION:
#       Every command the `luce` binary offers is one walk down the stages
#       below: `check` stops after semantic analysis, `run` hands the typed
#       program to the reference interpreter, and `build` continues through
#       canonical MIR to a target backend. Read `build`, `check`, and `run`
#       first; they are three short functions that name every stage in order.
#       Then follow the CODE FLOW diagram into each stage's file, whose header
#       explains its own contract.
#
#       Vocabulary used throughout the compiler:
#         typed HIR       the program after names and types are resolved (hir/ir.luc)
#         canonical MIR   a flat, target-independent instruction stream (mir/canonical.luc)
#         artifact        the file `build` installs: a .wasm module or a native executable
#         slice           the subset of the 1.0 language a stage implements today
#         Stage-0         the frozen seed toolchain that compiles this source
#
#   STAGES:
#
#       -> tokens and layout                 Tokenizer
#       -> source syntax                     Parser
#       -> names, signatures, typed HIR      HirGenerator
#       -> flow, ownership                   SemanticAnalyzer
#       -> canonical MIR                     Lowerer
#       -> sealed runtime composition         Composer, when supplied
#       -> verified canonical MIR            MirVerifier
#       -> optimized canonical MIR           Optimizer
#       -> verified optimized MIR            MirVerifier
#       -> target legalization and selection backend
#       -> installed artifact                backend
#
#   CODE FLOW:
#
#                 ../luce.luc                          check / run / build
#                      |
#                      v
#                pipeline.luc
#                      |  sequence the stages
#                      v
#                frontend/tokenizer.luc  ---------  frontend/source.luc
#                      |  tokenize source
#                      v
#                frontend/parser.luc  ------------  frontend/syntax.luc, core_types.luc
#                      |  parse tokens
#                      v
#                hir/generator.luc  -----------  hir/ir.luc
#                      |  generate typed HIR
#                      v
#                hir/analyzer.luc
#                      |  apply whole-program rules
#                      |
#                      +---- check ----->  typed program, stop
#                      |
#                      +---- run ------->  backends/interpreter.luc
#                      |  execute the typed program
#                      |
#                      +---- build          compile to a file
#                                |
#                                v
#                          mir/lowerer.luc  --  mir/canonical.luc
#                                |  flatten into instructions; optionally
#                                |  compose separately lowered sealed runtime
#                                v
#                          mir/verifier.luc
#                                |  check the instructions
#                                v
#                          mir/optimizer.luc
#                                |  improve the instructions
#                                v
#                          mir/verifier.luc
#                                |  check again
#                                v
#                          built-in backend
#                                |  install the target file
#                                |
#                                +-- backends/wasm.luc
#                                |   write a WebAssembly module
#                                +-- backends/qbe.luc
#                                    translate canonical MIR to QBE IL
#                                      |
#                                      v
#                                    backends/qbe_toolchain.luc
#                                    assemble, link, atomically install
#
#       Two temporary combinations are named in the code as they stand. `HirGenerator`
#       currently owns both name/signature resolution and type checking because
#       no resolved-but-untyped IR exists yet. Each compiled backend currently
#       owns legalization, instruction selection, and container encoding because
#       no target IR exists yet. Those boundaries can split later without
#       changing the permanent path above.
#
#       `run` branches after semantic analysis and interprets typed
#       HIR. Keeping that independent semantic oracle lets it catch mistakes in
#       lowering and compiled backends. `backends/mir_interpreter.luc` executes
#       canonical MIR directly; the differential tests run both interpreters
#       and every encoder over the same programs (docs/compiler/mir.md, "How
#       we know any of this is right"). It does not replace the oracle.
#
#   TARGETS:
#       wasm            WebAssembly module
#       native          host executable through pinned QBE 1.3
#
#==============================================================================================

from compiler.backend import HirExecutionBackend
from compiler.mir.canonical import MirProgram
from compiler.mir.composer import compose_runtime
from compiler.backends.interpreter import HirInterpreter
from compiler.backends.qbe_toolchain import QbeToolchain
from compiler.backends.wasm import WasmBackend
from compiler.hir.generator import HirGenerator, SourceModule
from compiler.mir.lowerer import Lowerer
from compiler.mir.verifier import MirVerifier
from compiler.mir.optimizer import Optimizer
from compiler.frontend.parser import Parser
from compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from compiler.frontend.tokenizer import Token, Tokenizer
from compiler.hir.ir import ModuleAuthority, PackageRole, Value
from compiler.runtime_contract import RuntimeService
import std.files
import std.paths

# mark: Targets ===============================================================================

## The identity and source files that make one compilation unit. Package
## identity is an explicit input because it is part of `ErrorCode` values;
## deriving it from a path would make moving a checkout change program data.
pub struct PackageInput:
    pub let identity: str
    pub let source_paths: list[str]

## One semantic service named by a sealed package descriptor. The source
## spelling is resolved once to a HIR identity; it is not a linker convention.
pub struct RuntimeBindingInput:
    pub let service: RuntimeService
    pub let module_name: str
    pub let function_name: str

## The separately compiled, privileged runtime source package and its closed
## semantic-service descriptor.
pub struct RuntimePackageInput:
    pub let identity: str
    pub let source_paths: list[str]
    pub let bindings: list[RuntimeBindingInput]

## Selects the artifact format produced by `build`.
pub enum BuildTarget:
    wasm
    native

# mark: Commands ===============================================================================

## Compile source files through every build stage and install the completed
## artifact at `output`. Native artifacts use the QBE host toolchain; QBE owns
## its scratch and replaces the destination only after linking succeeds.
pub func build(target: BuildTarget, output: str, package: PackageInput) -> !:
    let optimized_program = try lower_and_verify(package)
    try materialize(target, output, optimized_program)

## Build with an explicitly supplied sealed runtime package. Keeping the
## package input visible makes deployment/package lookup a caller concern,
## while every compiler stage still consumes one composed canonical MIR.
pub func build_with_runtime(target: BuildTarget, output: str, package: PackageInput, runtime: RuntimePackageInput) -> !:
    let optimized_program = try compile_with_runtime(package, runtime)
    try materialize(target, output, optimized_program)

func materialize(target: BuildTarget, output: str, optimized_program: MirProgram) -> !:
    match target:
        wasm:   try files.write_bytes(output, try WasmBackend().emit(optimized_program))
        native: try QbeToolchain().materialize(optimized_program, output)

## Run the complete frontend and semantic analysis, returning analyzed typed
## HIR. For example, editor tooling can call this without choosing a target.
pub func check(package: PackageInput) -> AnalyzedProgram!:
    return try analyze_sources(package)

## Analyze source files and run one public, parameterless function through the
## typed-HIR reference interpreter; for example,
## `run(package, "main", "answer")`.
pub func run(package: PackageInput, module_name: str, function_name: str) -> Value!:
    return try HirInterpreter().run(try analyze_sources(package), module_name, function_name)

# mark: Stage values ===========================================================================

# One source file after I/O but before lexical analysis.
struct SourceFile:
    let name: str
    let path: str
    let authority: ModuleAuthority
    let text: str

# One source file after token and layout synthesis but before parsing.
struct TokenizedFile:
    let name: str
    let path: str
    let authority: ModuleAuthority
    let tokens: list[Token]

# mark: Custom backends ========================================================================
#
# `build` and `run` above name their concrete backends so the built-in
# commands read as one straight line. HIR execution has one genuinely common
# value contract, so callers can substitute an execution backend here.

## Run the analyzed typed HIR with a caller-provided execution backend. This
## keeps custom interpreters on the same semantic path as the built-in one.
pub func run_with_backend(backend: HirExecutionBackend, package: PackageInput, module_name: str, function_name: str) -> Value!:
    return try backend.run(try analyze_sources(package), module_name, function_name)

# mark: Sealed runtime =========================================================================

## Compile the sealed runtime source to verified, target-neutral canonical MIR.
## Keeping this entry explicit lets packaging choose where the shipped runtime
## sources live without granting runtime authority to ordinary packages.
pub func compile_runtime(package: RuntimePackageInput) -> MirProgram!:
    let analyzed = try analyze_package(
        PackageInput(identity = package.identity, source_paths = package.source_paths),
        PackageRole.sealed_runtime,
        package.bindings,
    )
    let program = try Lowerer(analyzed).lower()
    try MirVerifier(program).verify()
    return program

## Compile application and sealed runtime sources independently, compose their
## canonical MIR, then verify and optimize the one closed program every
## artifact backend consumes.
pub func compile_with_runtime(application: PackageInput, runtime: RuntimePackageInput) -> MirProgram!:
    let application_program = try Lowerer(try analyze_sources(application)).lower()
    let runtime_program = try compile_runtime(runtime)
    return try verify_and_optimize(try compose_runtime(application_program, runtime_program))

# mark: Shared stages ==========================================================================

# Frontend through semantic analysis. `check`, `run`, and `build` all start here.
func analyze_sources(package: PackageInput) -> AnalyzedProgram!:
    return try analyze_package(package, PackageRole.application, list[RuntimeBindingInput]())

func analyze_package(package: PackageInput, role: PackageRole, bindings: list[RuntimeBindingInput]) -> AnalyzedProgram!:
    if len(package.identity) == 0: error("package identity cannot be empty")
    let sources = try read_sources(package.source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let generator = HirGenerator(package.identity, modules, role)
    for binding in bindings:
        generator.bind_runtime_service(binding.service, binding.module_name, binding.function_name)
    let hir_program = try generator.generate()
    return try SemanticAnalyzer(hir_program).analyze()

# Analysis through optimized, verified target-neutral MIR.
func lower_and_verify(package: PackageInput) -> MirProgram!:
    let analyzed_hir = try analyze_sources(package)
    let canonical_program = try Lowerer(analyzed_hir).lower()
    return try verify_and_optimize(canonical_program)

func verify_and_optimize(canonical_program: MirProgram) -> MirProgram!:
    try MirVerifier(canonical_program).verify()
    let optimized_program = Optimizer(canonical_program).optimize()
    try MirVerifier(optimized_program).verify()
    return optimized_program

# mark: Source stages =========================================================================

# Read each requested path into a named source value. For example,
# `examples/math.luc` becomes module candidate `math` while retaining its path
# for later diagnostics.
func read_sources(source_paths: list[str]) -> list[SourceFile]!:
    let sources = list[SourceFile]()
    for path in source_paths:
        let authority = module_authority(path)
        var name = paths.stem(path)
        if authority == ModuleAuthority.native: name = paths.stem(name)
        sources.append(SourceFile(
            name = name,
            path = path,
            authority = authority,
            text = try files.read(path),
        ))
    return sources

# Turn source text into tokens, including synthesized indent/dedent layout, and
# prefix lexical diagnostics with the originating path.
func tokenize_sources(sources: list[SourceFile]) -> list[TokenizedFile]!:
    let tokenized_files = list[TokenizedFile]()
    for source in sources:
        let tokens = Tokenizer(source.text).tokenize() catch reason:
            error(source.path + ":" + reason)
        tokenized_files.append(TokenizedFile(
            name = source.name,
            path = source.path,
            authority = source.authority,
            tokens = tokens,
        ))
    return tokenized_files

# Turn each token stream into source syntax and package it with the module name
# and path HirGenerator needs for cross-file resolution and diagnostics.
func parse_modules(tokenized_files: list[TokenizedFile]) -> list[SourceModule]!:
    let modules = list[SourceModule]()
    for file in tokenized_files:
        let syntax_tree = Parser(file.tokens).parse() catch reason:
            error(file.path + ":" + reason)
        modules.append(SourceModule(
            name = file.name,
            path = file.path,
            authority = file.authority,
            syntax = syntax_tree,
        ))
    return modules

# The suffix is package-reader authority, not grammar or a naming convention
# interpreted by HIR. Removing both suffixes keeps `arena.native.luc` as module
# `arena`, so importing its safe wrappers does not mention the authority bit.
func module_authority(path: str) -> ModuleAuthority:
    let suffix = ".native.luc"
    if len(path) >= len(suffix) and path[len(path) - len(suffix):] == suffix:
        return ModuleAuthority.native
    return ModuleAuthority.safe
