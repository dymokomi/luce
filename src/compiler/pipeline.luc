from compiler.checker import Checker, SourceModule
from compiler.parser import Parser
from compiler.tokenizer import Tokenizer
import std.files
import std.paths

# The compiler's visible spine (LUCE_LANGUAGE_DESIGN.md section 23.1):
# source -> tokens/layout -> syntax tree -> resolved typed IR -> ownership/effects
#        -> canonical Luce IR -> backend IR/machine code -> artifact
#
# Keep stage order here. Each stage owns one transformation; this module owns
# how those transformations compose. Only the implemented stages appear below.
func compile(source_paths: list[str]) -> !:
    let modules = list[SourceModule]()
    for path in source_paths:
        let source = try files.read(path)
        let tokens = try Tokenizer(source).tokenize()
        let syntax_tree = try Parser(tokens).parse()
        modules.append(SourceModule(name = paths.stem(path), path = path, syntax = syntax_tree))
    let typed_program = try Checker(modules).check()
