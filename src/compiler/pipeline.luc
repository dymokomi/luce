#==============================================================================================
#
#   pipeline - The compiler spine
#
#   DESCRIPTION:
#       Runs compiler stages in order. Each public workflow spells out its path;
#       each stage owns one transformation (LUCE_LANGUAGE_DESIGN.md §23):
#
#       source -> Tokenizer -> Parser -> Checker -> typed IR -> ExecutionBackend -> value
#                                                  \-> Lowerer -> canonical IR -> ArtifactBackend -> bytes
#
#   TARGETS:
#       wasm            WebAssembly module
#       arm64-macos     Mach-O executable for Apple silicon
#       x86_64-linux    ELF executable
#
#==============================================================================================

from compiler.backend import ArtifactBackend, ExecutionBackend
from compiler.backends.arm64_macos import Arm64MacosBackend
from compiler.backends.interpreter import Interpreter
from compiler.backends.wasm import WasmBackend
from compiler.backends.x86_64_linux import X86_64LinuxBackend
from compiler.checker import Checker, SourceModule
from compiler.lowerer import Lowerer
from compiler.parser import Parser
from compiler.tokenizer import Token, Tokenizer
from compiler.typed_ir import TypedProgram, Value
import std.files
import std.paths

# mark: Targets ===============================================================================

## Selects the artifact format produced by `build`.
pub enum BuildTarget:
    wasm
    arm64_macos
    x86_64_linux

# mark: Stage values ===========================================================================

struct SourceFile:
    name: str
    path: str
    text: str

struct TokenizedFile:
    name: str
    path: str
    tokens: list[Token]

# mark: Commands ===============================================================================

## Compile source files into the artifact bytes for a target.
pub func build(target: BuildTarget, source_paths: list[str]) -> list[u8]!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let typed_program = try Checker(modules).check()
    let canonical_program = try Lowerer(typed_program).lower()

    match target:
        wasm:         return try WasmBackend().emit(canonical_program)
        arm64_macos:  return try Arm64MacosBackend().emit(canonical_program)
        x86_64_linux: return try X86_64LinuxBackend().emit(canonical_program)

## Read, tokenize, parse, and check source files into one typed program.
pub func check(source_paths: list[str]) -> TypedProgram!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let typed_program = try Checker(modules).check()
    return typed_program

## Run one function from source files in the interpreter.
pub func run(source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let typed_program = try Checker(modules).check()
    return try Interpreter().run(typed_program, module_name, function_name)

# mark: Custom backends ========================================================================

## Compile source files with a caller-provided artifact backend.
pub func build_with_backend(backend: ArtifactBackend, source_paths: list[str]) -> list[u8]!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let typed_program = try Checker(modules).check()
    let canonical_program = try Lowerer(typed_program).lower()
    return try backend.emit(canonical_program)

## Run one function with a caller-provided execution backend.
pub func run_with_backend(backend: ExecutionBackend, source_paths: list[str], module_name: str, function_name: str) -> Value!:
    let sources = try read_sources(source_paths)
    let tokenized_files = try tokenize_sources(sources)
    let modules = try parse_modules(tokenized_files)
    let typed_program = try Checker(modules).check()
    return try backend.run(typed_program, module_name, function_name)

# mark: Source stages =========================================================================

# Read source files from disk.
func read_sources(source_paths: list[str]) -> list[SourceFile]!:
    let sources = list[SourceFile]()
    for path in source_paths:
        sources.append(SourceFile(
            name = paths.stem(path),
            path = path,
            text = try files.read(path),
        ))
    return sources

# Tokenize source files and add their paths to tokenizer errors.
func tokenize_sources(sources: list[SourceFile]) -> list[TokenizedFile]!:
    let tokenized_files = list[TokenizedFile]()
    for source in sources:
        let tokens = Tokenizer(source.text).tokenize() catch reason:
            error(source.path + ":" + reason)
        tokenized_files.append(TokenizedFile(
            name = source.name,
            path = source.path,
            tokens = tokens,
        ))
    return tokenized_files

# Parse tokenized files and add their paths to parser errors.
func parse_modules(tokenized_files: list[TokenizedFile]) -> list[SourceModule]!:
    let modules = list[SourceModule]()
    for file in tokenized_files:
        let syntax_tree = Parser(file.tokens).parse() catch reason:
            error(file.path + ":" + reason)
        modules.append(SourceModule(
            name = file.name,
            path = file.path,
            syntax = syntax_tree,
        ))
    return modules
