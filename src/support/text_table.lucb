#==============================================================================================
#
#   text_table - A growable map from text to text
#
#   DESCRIPTION:
#       What luce keeps for the run of answers the Base compiler gave (module resolutions,
#       descriptions, dependency reports), found by key in constant time however many a
#       program has. Open addressing over a power-of-two table that doubles when half
#       full; keys are never empty, so an empty key marks a free slot. The table holds the
#       texts it is given and never frees them: they belong to the run, like the answers.
#
#==============================================================================================

import memory
import strings

## Text keys to text values by open addressing; see the header.
pub struct TextTable:
    var keys: str[]
    var values: str[]
    var used: usize

    ## The value kept for `key`, if there is one.
    pub func find(key: str) -> str?:
        if self.keys.length == 0:
            return none
        let mask = self.keys.length - 1
        var slot = fnv1a(key) & mask
        while self.keys[slot].length > 0:
            if self.keys[slot] == key:
                return self.values[slot]
            slot = (slot + 1) & mask
        return none

    ## Keep `value` for the non-empty `key` unless one is kept already; whether it was.
    pub mutating func insert(key: str, value: str) -> bool!:
        assert(key.length > 0)
        if (self.used + 1) * 2 > self.keys.length:
            try self.grow()
        let mask = self.keys.length - 1
        var slot = fnv1a(key) & mask
        while self.keys[slot].length > 0:
            if self.keys[slot] == key:
                return false
            slot = (slot + 1) & mask
        self.keys[slot] = key
        self.values[slot] = value
        self.used += 1
        return true

    ## Double the slots (64 to start) and place every entry again.
    mutating func grow() -> !:
        let size: usize = 64 if self.keys.length == 0 else self.keys.length * 2
        with memory.heap:
            var keys = try alloc str[size]
            var values = try alloc str[size]
            for index in 0..<size:
                keys[index] = ""
                values[index] = ""
            let mask = size - 1
            for index in 0..<self.keys.length:
                let key = self.keys[index]
                if key.length == 0:
                    continue
                var slot = fnv1a(key) & mask
                while keys[slot].length > 0:
                    slot = (slot + 1) & mask
                keys[slot] = key
                values[slot] = self.values[index]
            if self.keys.length > 0:
                free(self.keys)
                free(self.values)
            self.keys = keys
            self.values = values

## FNV-1a of `text`'s bytes.
func fnv1a(text: str) -> usize:
    var h: u64 = 14695981039346656037
    for byte in text.bytes:
        h ^= (u64)byte
        h = h *% 1099511628211
    return (usize)h

test "a text table finds what it keeps, through growth":
    var table: TextTable
    with memory.heap:
        var i: usize = 0
        while i < 1000:
            var room: u8[16]
            let key = try strings.copy(try format(room, f"k{i}"))
            assert(try table.insert(key, "v"))
            i += 1
    assert(table.used == 1000)
    assert(table.find("k0") == "v")
    assert(table.find("k999") == "v")
    assert(table.find("k1000") == none)
    assert(not (try table.insert("k5", "w")))
    assert(table.find("k5") == "v")
