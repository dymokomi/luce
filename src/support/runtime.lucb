pub let count: usize = 1
pub let names: str[1] = ["kernel.lucb"]
pub let sources: str[1] = [
    "#==============================================================================================\n#\n#   kernel - The runtime of the value language\n#\n#   DESCRIPTION:\n#       What an emitted Luce program calls that Base does not spell itself: Python's `//`,\n#       `%` and `**`, text made of pieces, the display of scalars, indexes and slices with\n#       Luce's bounds and traps, ranges as values, and the list. Every text lives on the heap\n#       and is never freed in this slice; the reference-counted runtime replaces this module\n#       as a whole. Nothing here fails: an allocation that cannot be met traps, as §12\n#       says it must.\n#\n#==============================================================================================\n\nimport c\nimport io\nimport memory\nimport strings\n\nextern func c_pow as \"pow\"(x: f64, y: f64) -> f64\nextern func c_strtod as \"strtod\"(text: c.str, end: c.str*?) -> f64\n\npub let luce_failure: ErrorCode = ErrorCode.package(65535)\n\n# mark: Arithmetic =============================================================================\n\npub func floor_div(a: i64, b: i64) -> i64:\n    let q = a // b\n    if (a % b != 0) and ((a < 0) != (b < 0)):\n        return q - 1\n    return q\n\npub func floor_mod(a: i64, b: i64) -> i64:\n    let r = a % b\n    if r != 0 and ((r < 0) != (b < 0)):\n        return r + b\n    return r\n\npub func power(base: i64, exponent: i64) -> i64:\n    if exponent < 0:\n        trap(\"a negative exponent needs a float base\")\n    var result: i64 = 1\n    var i: i64 = 0\n    while i < exponent:\n        result = result * base\n        i += 1\n    return result\n\npub func floor_float(x: f64) -> f64:\n    let t = f64(i64(x))\n    return t - 1.0 if t > x else t\n\npub func ffloor_div(a: f64, b: f64) -> f64:\n    return floor_float(a / b)\n\npub func ffloor_mod(a: f64, b: f64) -> f64:\n    return a - floor_float(a / b) * b\n\npub func fpower(base: f64, exponent: f64) -> f64:\n    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:\n        var result = 1.0\n        var i: i64 = 0\n        while i < i64(exponent):\n            result = result * base\n            i += 1\n        return result\n    return c_pow(base, exponent)\n\npub func to_int(f: f64) -> i64:\n    return i64(f)\n\n# mark: Text ===================================================================================\n\n## Room on the heap, or a trap: Luce's out of memory is not recoverable (§12).\npub func room(n: usize) -> u8[]:\n    let out = alloc u8[n if n > 0 else 1] catch failure:\n        trap(\"out of memory\")\n    return out\n\npub func concat(a: str, b: str) -> str:\n    var out = room(a.length + b.length)\n    memory.copy(out, a.bytes, a.length)\n    memory.copy(out[a.length..], b.bytes, b.length)\n    return (str)out[..<a.length + b.length]\n\n## The pieces of a formatted text, joined.\npub func join(pieces: const str[]) -> str:\n    var n: usize = 0\n    for p in pieces:\n        n += p.length\n    var out = room(n)\n    var at: usize = 0\n    for p in pieces:\n        memory.copy(out[at..], p.bytes, p.length)\n        at += p.length\n    return (str)out[..<n]\n\npub func show_int(i: i64) -> str:\n    var buffer: u8[32]\n    let text = format(buffer, f\"{i}\") catch failure:\n        trap(\"out of memory\")\n    return copy_text(text)\n\npub func show_float(f: f64) -> str:\n    var buffer: u8[64]\n    let text = format(buffer, f\"{f}\") catch failure:\n        trap(\"out of memory\")\n    return copy_text(text)\n\npub func show_bool(b: bool) -> str:\n    return \"true\" if b else \"false\"\n\npub func show_bytes(data: const u8[]) -> str:\n    var b = strings.Builder.create(16) catch failure:\n        trap(\"out of memory\")\n    b.put(\"b\\\"\") catch failure:\n        trap(\"out of memory\")\n    var buffer: u8[4]\n    for byte in data:\n        buffer[0] = '\\\\'\n        buffer[1] = 'x'\n        buffer[2] = hex_digit(byte >> 4)\n        buffer[3] = hex_digit(byte & 15)\n        b.put((str)buffer[..<4]) catch failure:\n            trap(\"out of memory\")\n    b.put(\"\\\"\") catch failure:\n        trap(\"out of memory\")\n    let out = copy_text(b.view())\n    b.destroy()\n    return out\n\nfunc hex_digit(n: u8) -> u8:\n    return '0' + n if n < 10 else 'a' + (n - 10)\n\npub func copy_text(text: str) -> str:\n    var out = room(text.length)\n    memory.copy(out, text.bytes, text.length)\n    return (str)out[..<text.length]\n\npub func print_line(text: str):\n    var out = io.stdout()\n    discard(out.write(text.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func compare_text(a: str, b: str) -> i64:\n    var i: usize = 0\n    while i < a.length and i < b.length:\n        if a.bytes[i] != b.bytes[i]:\n            return -1 if a.bytes[i] < b.bytes[i] else 1\n        i += 1\n    if a.length == b.length:\n        return 0\n    return -1 if a.length < b.length else 1\n\npub func compare_bytes(a: const u8[], b: const u8[]) -> i64:\n    return compare_text((str)a, (str)b)\n\npub func contains(text: str, needle: str) -> bool:\n    return strings.contains(text, needle)\n\n## Scalars in a text, and a slice by scalar index (§11.3).\npub func scalar_length(s: str) -> i64:\n    var n: i64 = 0\n    for b in s.bytes:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\npub func slice_text(s: str, low: i64, high: i64, whole: bool) -> str:\n    let n = scalar_length(s)\n    let hi = n if whole else high\n    check_bounds(low, hi, n)\n    let b = s.bytes\n    var start: usize = b.length\n    var end: usize = b.length\n    var scalar: i64 = 0\n    var i: usize = 0\n    if low == 0:\n        start = 0\n    while i < b.length:\n        if (b[i] & 0xC0) != 0x80:\n            if scalar == low:\n                start = i\n            if scalar == hi:\n                end = i\n                break\n            scalar += 1\n        i += 1\n    return (str)b[start..<end]\n\npub func slice_bytes(data: const u8[], low: i64, high: i64, whole: bool) -> const u8[]:\n    let n = (i64)data.length\n    let hi = n if whole else high\n    check_bounds(low, hi, n)\n    return data[(usize)low..<(usize)hi]\n\npub func check_bounds(low: i64, high: i64, n: i64):\n    if low < 0 or high < low or high > n:\n        trap(\"slice out of range\")\n\n## A Luce index into `count` elements: negative counts from the end; out of range traps.\npub func index(i: i64, count: usize) -> usize:\n    var k = i\n    if k < 0:\n        k += (i64)count\n    if k < 0 or k >= (i64)count:\n        trap(\"index out of range\")\n    return (usize)k\n\n## The scalars of a text, one at a time, as texts of one scalar.\npub struct Scalars:\n    var text: str\n    var at: usize\n\n    pub static func over(text: str) -> Scalars:\n        return Scalars(text = text, at = 0)\n\n    pub mutating func next() -> str?:\n        let b = self.text.bytes\n        if self.at >= b.length:\n            return none\n        var n: usize = 1\n        while self.at + n < b.length and (b[self.at + n] & 0xC0) == 0x80:\n            n += 1\n        let out = (str)b[self.at..<self.at + n]\n        self.at += n\n        return out\n\npub func parse_int(text: str) -> i64!:\n    let n = strings.to_i64(strings.trim(text)) else error(luce_failure, \"not an integer\")\n    return n\n\npub func parse_float(text: str) -> f64!:\n    let t = strings.trim(text)\n    if t.length == 0:\n        error(luce_failure, \"not a number\")\n    var buffer = room(t.length + 1)\n    memory.copy(buffer, t.bytes, t.length)\n    buffer[t.length] = 0\n    return c_strtod((c.str)buffer.data, none)\n\npub func parse_bool(text: str) -> bool!:\n    if text == \"true\":\n        return true\n    if text == \"false\":\n        return false\n    error(luce_failure, \"not a boolean\")\n\n# mark: Ranges =================================================================================\n\npub struct Range:\n    pub var low: i64\n    pub var high: i64\n    pub var inclusive: bool\n\npub func range(low: i64, high: i64, inclusive: bool) -> Range:\n    return Range(low = low, high = high, inclusive = inclusive)\n\npub func in_range(i: i64, r: Range) -> bool:\n    return i >= r.low and (i <= r.high if r.inclusive else i < r.high)\n\npub func range_end(r: Range) -> i64:\n    return r.high + 1 if r.inclusive else r.high\n\npub func show_range(r: Range) -> str:\n    return join([show_int(r.low), \"..=\" if r.inclusive else \"..<\", show_int(r.high)])\n\n# mark: Lists ==================================================================================\n\n## A growable list with identity: a pointer to its storage, shared by every binding.\npub struct ListStore[T]:\n    pub var items: T[]\n    pub var count: usize\n\npub func new_list[T](capacity: usize) -> ListStore[T]*:\n    let store = new ListStore[T] catch failure:\n        trap(\"out of memory\")\n    let items = alloc T[capacity if capacity > 0 else 4] catch failure:\n        trap(\"out of memory\")\n    store.items = items\n    store.count = 0\n    return store\n\npub func list_append[T](l: ListStore[T]*, item: T):\n    if l.count == l.items.length:\n        let grown = alloc T[l.items.length * 2] catch failure:\n            trap(\"out of memory\")\n        memory.copy(grown, l.items, l.count)\n        l.items = grown\n    l.items[l.count] = item\n    l.count += 1\n\npub func list_get[T](l: ListStore[T]*, i: i64) -> T:\n    return l.items[index(i, l.count)]\n\npub func list_set[T](l: ListStore[T]*, i: i64, item: T):\n    l.items[index(i, l.count)] = item\n\npub func list_length[T](l: ListStore[T]*) -> i64:\n    return (i64)l.count\n\npub func list_from_args(arguments: str[]) -> ListStore[str]*:\n    let l = new_list[str](arguments.length)\n    for a in arguments:\n        list_append[str](l, a)\n    return l\n\n## A failure leaving `main`: reported the way the interpreter reports it.\npub func print_error(message: str):\n    var err = io.stderr()\n    discard(err.write(\"error: \".bytes) catch failure: recover 0)\n    discard(err.write(message.bytes) catch failure: recover 0)\n    discard(err.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func show_text(s: str) -> str:\n    return s\n"
]
