pub let sources: str[8] = [
    "kernel.lucb\ntext.lucb\nlists.lucb\nlist_methods.lucb\nmaps.lucb\nbuiltins.lucb\n",
    "#==============================================================================================\n#\n#   kernel/builtins - Ranges and the standard modules' functions\n#\n#   DESCRIPTION:\n#       Ranges as values with a step and a direction (§6.6), and what the functions of the\n#       standard modules (§6.8) need beyond Base: `math.abs`, `math.min`, `math.max`,\n#       `math.round`, `text.code_of`, `text.from_code`, `console.read_line`, and the fields of\n#       a formatted string with a specification (§3.3).\n#\n#==============================================================================================\n\n# mark: Ranges =================================================================================\n\n## `a..<b` or `a..=b` (§6.6), with a step: its elements are `low`, `low + |step|`, and so on\n## while they are below `high`, or not above it when `inclusive`; a negative step walks the\n## same elements from the last down. A range written is step 1.\npub struct Range:\n    pub var low: i64\n    pub var high: i64\n    pub var inclusive: bool\n    pub var step: i64\n\npub func range(low: i64, high: i64, inclusive: bool) -> Range:\n    return Range(low = low, high = high, inclusive = inclusive, step = 1)\n\nfunc step_size(r: Range) -> u64:\n    return (u64)r.step if r.step > 0 else (u64)0 -% (u64)r.step\n\n## The greatest element, or none when the range has none; differences are taken as `u64`,\n## which holds any span between two `int`s.\nfunc range_last(r: Range) -> i64?:\n    var top = r.high\n    if not r.inclusive:\n        if r.high == -9223372036854775807 - 1:\n            return none\n        top = r.high - 1\n    if top < r.low:\n        return none\n    let span = (u64)top -% (u64)r.low\n    return (i64)((u64)r.low +% span // step_size(r) * step_size(r))\n\n## `x in r` and `r.contains(x)`.\npub func in_range(i: i64, r: Range) -> bool:\n    let last = range_last(r) else return false\n    return i >= r.low and i <= last and ((u64)i -% (u64)r.low) % step_size(r) == 0\n\n## `r.contains(x)`: the range first, as it is written first.\npub func range_contains(r: Range, i: i64) -> bool:\n    return in_range(i, r)\n\n## `r.is_empty`: whether it has no element.\npub func range_is_empty(r: Range) -> bool:\n    return range_last(r) == none\n\n## `r.length`: how many elements; past the largest `int` traps.\npub func range_length(r: Range) -> i64:\n    let last = range_last(r) else return 0\n    let steps = ((u64)last -% (u64)r.low) // step_size(r)\n    if steps >= 9223372036854775807:\n        heap.stop(\"integer overflow\")\n    return (i64)steps + 1\n\n## `r.step(n)`: every `n`th element, from the first the range walks; `n` above zero.\npub func range_step(r: Range, n: i64) -> Range:\n    if n < 1:\n        heap.stop(\"a range's step is above zero\")\n    let size = (i64)step_size(r) *? n else heap.stop(\"integer overflow\")\n    if r.step > 0:\n        return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = size)\n    # walking down: the elements from the last, every `n`th, as a range of their own\n    let last = range_last(r) else return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = -size)\n    let steps = ((u64)last -% (u64)r.low) // (u64)size\n    let low = (i64)((u64)last -% steps * (u64)size)\n    return Range(low = low, high = last, inclusive = true, step = -size)\n\n## `r.reversed()`: the same elements, the other way.\npub func range_reversed(r: Range) -> Range:\n    return Range(low = r.low, high = r.high, inclusive = r.inclusive, step = -r.step)\n\n## The elements of a range value in the order it walks them, for a `for` over one.\npub struct RangeWalk:\n    var current: i64\n    var left: u64\n    var delta: i64\n    var done: bool\n\n    pub static func over(r: Range) -> RangeWalk:\n        let last = range_last(r) else return RangeWalk(current = 0, left = 0, delta = 0, done = true)\n        let steps = ((u64)last -% (u64)r.low) // step_size(r)\n        if r.step > 0:\n            return RangeWalk(current = r.low, left = steps, delta = r.step, done = false)\n        return RangeWalk(current = last, left = steps, delta = r.step, done = false)\n\n    pub func next() -> i64?:\n        if self.done:\n            return none\n        let out = self.current\n        if self.left == 0:\n            self.done = true\n        else:\n            self.left -= 1\n            self.current = (i64)((u64)self.current +% (u64)self.delta)\n        return out\n\n## A range's display: `a..<b`, and a step or a direction as the calls that made them,\n## `(0..<10).step(2)`, `(0..<10).reversed()`.\npub func show_range(r: Range) -> Text*:\n    let size = (i64)step_size(r)\n    var stepped: u8[48]\n    var step_text = \"\"\n    if size != 1:\n        step_text = strings.format(stepped, f\".step({size})\") catch failure:\n            heap.stop(\"a range that does not format\")\n    let open = \"(\" if r.step != 1 else \"\"\n    let close = \")\" if r.step != 1 else \"\"\n    let dots = \"..=\" if r.inclusive else \"..<\"\n    let turned = \".reversed()\" if r.step < 0 else \"\"\n    var buffer: u8[160]\n    let text = strings.format(buffer, f\"{open}{r.low}{dots}{r.high}{close}{step_text}{turned}\") catch failure:\n        heap.stop(\"a range that does not format\")\n    return text_of(text)\n\n# mark: The standard modules' functions (§6.8) ================================================\n\n## `math.abs(n)` of an `int`; the smallest has no magnitude that fits, and traps.\npub func abs_int(n: i64) -> i64:\n    if n == -9223372036854775807 - 1:\n        heap.stop(\"integer overflow\")\n    return -n if n < 0 else n\n\n## `math.min(a, b)` (`least`) and `math.max(a, b)`: the first of two equals, the second only when it\n## is strictly beyond, as Python's; a copy of its own.\npub func pick[T](a: T, b: T, ops: Ops[T], least: bool) -> T:\n    let compare = ops.compare else heap.stop(\"values without an ordering\")\n    let order = compare(b, a)\n    let chosen = b if (order < 0 if least else order > 0) else a\n    if let copy = ops.copy:\n        return copy(chosen)\n    return chosen\n\n## `math.round(x, digits)`, rounded by the numerals module; past the largest float it traps.\npub func rounded(value: f64?) -> f64:\n    let out = value else heap.stop(\"the rounded value is too large for a float\")\n    return out\n\n## `text.code_of(s)` of a text of one scalar.\npub func code_of(t: Text*) -> i64:\n    if scalar_length(t) != 1:\n        heap.stop(\"text.code_of of a text that is not one scalar\")\n    let b = t.data.bytes\n    let lead = (i64)b[0]\n    if lead < 0x80:\n        return lead\n    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)\n    var i: usize = 1\n    while i < b.length:\n        value = value * 64 + ((i64)b[i] & 0x3F)\n        i += 1\n    return value\n\n## A text the numerals module made, as a `str` of the program's own; none traps with\n## `message` (`text.from_code` of no scalar, a field's `c` of no scalar).\npub func owned_text(text: str?, message: str) -> Text*:\n    let made = text else heap.stop(message)\n    let out = text_of(made)\n    strings.release(made)\n    return out\n\n## `int(text, base)`'s base, 2 to 36, or a trap.\npub func int_base(base: i64) -> i64:\n    if base < 2 or base > 36:\n        heap.stop(\"an integer's base is 2 to 36\")\n    return base\n\n## The integer the numerals module read, or the failure of a text that is not one (§6.5).\npub func parsed_int(value: i64?) -> i64!:\n    let out = value else error(luce_failure, \"not an integer\")\n    return out\n\n## `time.sleep(seconds)`, the seconds as whole milliseconds (`number_text`); a negative\n## count or NaN traps, as Python raises for it.\npub func sleep(milliseconds: u64?):\n    let wait = milliseconds else heap.stop(\"sleep length must be non-negative\")\n    thread.sleep(wait)\n\n## `time.now()`: nanoseconds from an arbitrary origin, never going backwards.\npub func now() -> i64:\n    return (i64)time.now()\n\n## `time.unix()`: seconds since the Unix epoch.\npub func unix() -> i64:\n    return time.unix()\n\n## `console.read_line(prompt)`: the prompt written, then a line of standard input without its\n## line end (and a `\\r` before it), none at the end of the input. Read a byte at a time, as\n## the interpreter reads, so nothing past the line is taken from a stream others may read.\npub func read_line(prompt: Text*) -> Text*?:\n    var out = io.stdout()\n    _ = out.write(prompt.data.bytes) catch failure: recover 0\n    var line = new u8[64] --- catch failure: heap.stop(\"out of memory\")\n    var used: usize = 0\n    defer free(line)\n    var source = io.stdin()\n    var one: u8[1]\n    var read_any = false\n    var ended = false\n    while not ended:\n        let n = source.read(one[..<1]) catch failure: recover 0\n        if n == 0:\n            break\n        read_any = true\n        if one[0] == '\\n':\n            ended = true\n        else:\n            if used == line.length:\n                line = memory.grow(line, line.length * 2) catch failure: heap.stop(\"out of memory\")\n            line[used] = one[0]\n            used += 1\n    if not read_any:\n        return none\n    var text = (str)line[..<used]\n    if ended and text.length > 0 and text.bytes[text.length - 1] == '\\r':\n        text = (str)text.bytes[..<text.length - 1]\n    return text_of(text)\n\n",
    "#==============================================================================================\n#\n#   kernel - The runtime of the value language\n#\n#   DESCRIPTION:\n#       What an emitted Luce program calls that Base does not spell itself: Python's `//`,\n#       `%` and `**`, text made of pieces, the display of scalars, indexes and slices with\n#       Luce's bounds and traps, closures, tests, workers and the Base boundary. Its other\n#       fragments (ORDER) hold the text operations, the list, maps and sets, and ranges with\n#       the built-in functions. Dynamic values use the reference-counted heap. An allocation\n#       that cannot be met traps, as §12 says.\n#\n#==============================================================================================\n\nimport c\nimport core\nimport io\nimport interop\nimport memory\nimport ownership as heap\nimport strings\nimport sync\nimport thread\nimport time\n\nextern func c_pow as \"pow\"(x: f64, y: f64) -> f64\nextern func c_strtod as \"strtod\"(text: c.str, end: c.str*?) -> f64\n\npub let luce_failure: ErrorCode = ErrorCode.package(65535)\n\n# mark: Arithmetic =============================================================================\n\n## `a // b` as Python has it; a zero divisor and the one overflowing quotient stop the\n## program at the Luce statement, not here (§6.2, §12.4).\npub func floor_div(a: i64, b: i64) -> i64:\n    if b == 0:\n        heap.stop(\"division by zero\")\n    if b == -1 and a == -9223372036854775807 - 1:\n        heap.stop(\"integer overflow\")\n    let q = a // b\n    if (a % b != 0) and ((a < 0) != (b < 0)):\n        return q - 1\n    return q\n\n## `a << n` and `a >> n` as Python has them on `int`: a negative count and a result past\n## the range stop the program at the Luce statement; `>>` is arithmetic (§6.2).\npub func shift_left(a: i64, n: i64) -> i64:\n    if n < 0:\n        heap.stop(\"negative shift count\")\n    if a == 0:\n        return 0\n    if n > 62:\n        if n == 63 and a == -1:\n            return a << 63\n        heap.stop(\"integer overflow\")\n    let shifted = a << n\n    if shifted >> n != a:\n        heap.stop(\"integer overflow\")\n    return shifted\n\npub func shift_right(a: i64, n: i64) -> i64:\n    if n < 0:\n        heap.stop(\"negative shift count\")\n    if n > 63:\n        return -1 if a < 0 else 0\n    return a >> n\n\npub func floor_mod(a: i64, b: i64) -> i64:\n    if b == 0:\n        heap.stop(\"division by zero\")\n    if b == -1:\n        return 0\n    let r = a % b\n    if r != 0 and ((r < 0) != (b < 0)):\n        return r + b\n    return r\n\npub func power(base: i64, exponent: i64) -> i64:\n    if exponent < 0:\n        heap.stop(\"a negative exponent needs a float base\")\n    var result: i64 = 1\n    var i: i64 = 0\n    while i < exponent:\n        result = result *? base else heap.stop(\"integer overflow\")\n        i += 1\n    return result\n\npub func floor_float(x: f64) -> f64:\n    let t = f64(i64(x))\n    return t - 1.0 if t > x else t\n\npub func ffloor_div(a: f64, b: f64) -> f64:\n    return floor_float(a / b)\n\npub func ffloor_mod(a: f64, b: f64) -> f64:\n    return a - floor_float(a / b) * b\n\npub func fpower(base: f64, exponent: f64) -> f64:\n    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:\n        var result = 1.0\n        var i: i64 = 0\n        while i < i64(exponent):\n            result = result * base\n            i += 1\n        return result\n    return c_pow(base, exponent)\n\npub func to_int(f: f64) -> i64:\n    return i64(f)\n\n# mark: Text and bytes =========================================================================\n\n## Room on the heap, or a trap: Luce's out of memory is not recoverable (§12).\npub func room(n: usize) -> u8[]:\n    let out = new u8[n if n > 0 else 1] --- catch failure:\n        heap.stop(\"out of memory\")\n    return out\n\n## A `str`: a counted object, its bytes right behind the header (RUNTIME). A literal is an\n## immortal `Text` the program declares, its `data` viewing the literal.\npub struct Text:\n    pub var header: heap.Object\n    pub var data: str\n\npub struct Bytes:\n    pub var header: heap.Object\n    pub var data: const u8[]\n\nfunc text_drop(o: heap.Object*):\n    _ = o\n\nfunc text_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    _ = o\n\n## `size` 0: the block's size is the text's own, the header plus its bytes.\npub var text_info: heap.Info = heap.Info(name = \"str\", size = 0, finish = none, drop = text_drop, trace = text_trace, acyclic = true)\npub var bytes_info: heap.Info = heap.Info(name = \"bytes\", size = 0, finish = none, drop = text_drop, trace = text_trace, acyclic = true)\n\n## Establish this application's managed runtime entry on the current thread.\npub func startup():\n    heap.enter()\n\n## A new text of `n` bytes, to be filled; the block is the header then the bytes.\nfunc text_room(n: usize) -> Text*:\n    let t = (Text*)heap.allocate_sized(&text_info, memory.size_of(Text) + n)\n    t.data = (str)u8[]((u8*)t + memory.size_of(Text), n)\n    return t\n\nfunc text_bytes(t: Text*) -> u8[]:\n    return u8[]((u8*)t + memory.size_of(Text), t.data.length)\n\npub func text_of(view: str) -> Text*:\n    let t = text_room(view.length)\n    memory.copy(text_bytes(t), view.bytes, view.length)\n    return t\n\npub func bytes_of(view: const u8[]) -> Bytes*:\n    let b = (Bytes*)heap.allocate_sized(&bytes_info, memory.size_of(Bytes) + view.length)\n    let store = u8[]((u8*)b + memory.size_of(Bytes), view.length)\n    memory.copy(store, view, view.length)\n    b.data = store\n    return b\n\n## Luce errors own their text, including when saved beyond a catch or sent to a worker.\npub struct Failure:\n    pub var code: ErrorCode\n    pub var message: Text*\n\nstruct RaisedMessage:\n    var text: Text*\n    var next: RaisedMessage*?\n\nlocal var raised_messages: RaisedMessage*?\n\n## Base propagates a borrowed view. Hold a reference until the Luce catch takes it.\n## A chain preserves an outer failure while cleanup catches a nested failure.\npub func message_of(t: Text*) -> str:\n    let entry = (RaisedMessage*)room(memory.size_of(RaisedMessage)).data\n    entry.text = (Text*)heap.retain((heap.Object*)t)\n    entry.next = raised_messages\n    raised_messages = entry\n    return t.data\n\n## Raise an owned Luce message through Base's unchanged borrowed-error ABI.\npub func fail(code: ErrorCode, message: Text*) -> never!:\n    error(code, message_of(message))\n\npub func catch_failure(code: ErrorCode, message: str) -> Failure:\n    var link = &raised_messages\n    while let entry = *link:\n        if entry.text.data.bytes.data == message.bytes.data and entry.text.data.length == message.length:\n            let text = entry.text\n            *link = entry.next\n            free(u8[]((u8*)entry, memory.size_of(RaisedMessage)))\n            return Failure(code, text)\n        link = &entry.next\n    # Base and runtime failures can carry static or borrowed views: own a copy.\n    return Failure(code, text_of(message))\n\n## Transfer managed failure text into an explicit native outcome. Base can handle\n## and release it without returning through a Luce catch or a pending-message cache.\npub func native_failure[T](code: ErrorCode, message: str) -> interop.Outcome[T]:\n    let failure = catch_failure(code, message)\n    return interop.Outcome[T].failure(failure.code,\n        interop.Owned[str](failure.message.data, (heap.Object*)failure.message))\n\npub func copy_failure(v: Failure) -> Failure:\n    return Failure(v.code, (Text*)heap.retain((heap.Object*)v.message))\n\npub func drop_failure(v: Failure):\n    if (usize)v.message != 0:\n        heap.release((heap.Object*)v.message)\n\npub func send_failure(v: Failure) -> Failure:\n    return Failure(v.code, text_of(v.message.data))\n\npub func concat(a: Text*, b: Text*) -> Text*:\n    let t = text_room(a.data.length + b.data.length)\n    let out = text_bytes(t)\n    memory.copy(out, a.data.bytes, a.data.length)\n    memory.copy(out[a.data.length..], b.data.bytes, b.data.length)\n    return t\n\n## The pieces of a formatted text, joined.\npub func join(pieces: const (Text*)[]) -> Text*:\n    var n: usize = 0\n    for p in pieces:\n        n += p.data.length\n    let t = text_room(n)\n    let out = text_bytes(t)\n    var at: usize = 0\n    for p in pieces:\n        memory.copy(out[at..], p.data.bytes, p.data.length)\n        at += p.data.length\n    return t\n\npub func text_equal(a: Text*, b: Text*) -> bool:\n    return a.data == b.data\n\npub func bytes_equal(a: Bytes*, b: Bytes*) -> bool:\n    return compare_bytes(a.data, b.data) == 0\n\npub func show_int(i: i64) -> Text*:\n    var buffer: u8[32]\n    let text = strings.format(buffer, f\"{i}\") catch failure:\n        heap.stop(\"a number that does not format\")\n    return text_of(text)\n\npub func show_float(f: f64) -> Text*:\n    var buffer: u8[64]\n    let text = strings.format(buffer, f\"{f}\") catch failure:\n        heap.stop(\"a number that does not format\")\n    return text_of(text)\n\npub func show_bool(b: bool) -> Text*:\n    return text_of(\"true\" if b else \"false\")\n\n## A text's display is itself, held once more: every display is the caller's own.\npub func show_text(t: Text*) -> Text*:\n    return (Text*)heap.retain((heap.Object*)t)\n\npub func show_bytes(b: Bytes*) -> Text*:\n    let data = b.data\n    let t = text_room(3 + data.length * 4)\n    let out = text_bytes(t)\n    out[0] = 'b'\n    out[1] = '\"'\n    var at: usize = 2\n    for byte in data:\n        out[at] = '\\\\'\n        out[at + 1] = 'x'\n        out[at + 2] = hex_digit(byte >> 4)\n        out[at + 3] = hex_digit(byte & 15)\n        at += 4\n    out[at] = '\"'\n    return t\n\nfunc hex_digit(n: u8) -> u8:\n    return '0' + n if n < 10 else 'a' + (n - 10)\n\npub func print_line(t: Text*):\n    var out = io.stdout()\n    _ = out.write(t.data.bytes) catch failure: recover 0\n    _ = out.write(\"\\n\".bytes) catch failure: recover 0\n\npub func compare_text(a: Text*, b: Text*) -> i64:\n    return compare_bytes(a.data.bytes, b.data.bytes)\n\npub func compare_bytes(a: const u8[], b: const u8[]) -> i64:\n    var i: usize = 0\n    while i < a.length and i < b.length:\n        if a[i] != b[i]:\n            return -1 if a[i] < b[i] else 1\n        i += 1\n    if a.length == b.length:\n        return 0\n    return -1 if a.length < b.length else 1\n\npub func compare_blobs(a: Bytes*, b: Bytes*) -> i64:\n    return compare_bytes(a.data, b.data)\n\npub func contains(text: Text*, needle: Text*) -> bool:\n    return find_bytes(text.data.bytes, needle.data.bytes, 0) != none\n\n## The scalars of a text (§11.3).\npub func scalar_length(t: Text*) -> i64:\n    var n: i64 = 0\n    for b in t.data.bytes:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\n## `text[low..<high]` by scalar index (§11.3), a new text; out of range traps.\npub func slice_text(t: Text*, low: i64, high: i64, whole: bool) -> Text*:\n    let b = t.data.bytes\n    let n = scalar_length(t)\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    var start: usize = b.length\n    var stop: usize = b.length\n    var scalar: i64 = 0\n    var i: usize = 0\n    if low == 0:\n        start = 0\n    while i < b.length:\n        if (b[i] & 0xC0) != 0x80:\n            if scalar == low:\n                start = i\n            if scalar == end:\n                stop = i\n                break\n            scalar += 1\n        i += 1\n    return text_of((str)b[start..<stop])\n\npub func slice_bytes(data: Bytes*, low: i64, high: i64, whole: bool) -> Bytes*:\n    let n = (i64)data.data.length\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    return bytes_of(data.data[(usize)low..<(usize)end])\n\npub func check_bounds(low: i64, high: i64, n: i64):\n    if low < 0 or high < low or high > n:\n        heap.stop(\"slice out of range\")\n\n## A Luce index into `count` elements: negative counts from the end; out of range traps.\npub func index(i: i64, count: usize) -> usize:\n    var k = i\n    if k < 0:\n        k += (i64)count\n    if k < 0 or k >= (i64)count:\n        heap.stop(\"index out of range\")\n    return (usize)k\n\npub func byte_at(data: Bytes*, i: i64) -> i64:\n    return (i64)data.data[index(i, data.data.length)]\n\npub func bytes_length(data: Bytes*) -> i64:\n    return (i64)data.data.length\n\n## The scalars of a text in order, each a new one-scalar text (§11.3).\npub struct Scalars:\n    var bytes: const u8[]\n    var at: usize\n\n    pub static func over(t: Text*) -> Scalars:\n        return Scalars(bytes = t.data.bytes, at = 0)\n\n    pub func next() -> Text*?:\n        if self.at >= self.bytes.length:\n            return none\n        var n: usize = 1\n        while self.at + n < self.bytes.length and (self.bytes[self.at + n] & 0xC0) == 0x80:\n            n += 1\n        let out = text_of((str)self.bytes[self.at..<self.at + n])\n        self.at += n\n        return out\n\n## Whether the text is a decimal number as §6.5 reads one: a sign, digits with an optional\n## fraction, an optional exponent, and nothing else; `strtod` alone reads more than that.\npub func is_decimal(text: str) -> bool:\n    let b = text.bytes\n    var i: usize = 0\n    if i < b.length and (b[i] == '+' or b[i] == '-'):\n        i += 1\n    var digits: usize = 0\n    while i < b.length and b[i] >= '0' and b[i] <= '9':\n        i += 1\n        digits += 1\n    if i < b.length and b[i] == '.':\n        i += 1\n        while i < b.length and b[i] >= '0' and b[i] <= '9':\n            i += 1\n            digits += 1\n    if digits == 0:\n        return false\n    if i < b.length and (b[i] == 'e' or b[i] == 'E'):\n        i += 1\n        if i < b.length and (b[i] == '+' or b[i] == '-'):\n            i += 1\n        var exponent: usize = 0\n        while i < b.length and b[i] >= '0' and b[i] <= '9':\n            i += 1\n            exponent += 1\n        if exponent == 0:\n            return false\n    return i == b.length\n\npub func parse_float(t: Text*) -> f64!:\n    let text = strings.trim(t.data)\n    if not is_decimal(text):\n        error(luce_failure, \"not a number\")\n    var buffer = room(text.length + 1)\n    memory.copy(buffer, text.bytes, text.length)\n    buffer[text.length] = 0\n    let value = c_strtod((c.str)buffer.data, none)\n    free(buffer)\n    return value\n\npub func parse_bool(t: Text*) -> bool!:\n    if t.data == \"true\":\n        return true\n    if t.data == \"false\":\n        return false\n    error(luce_failure, \"not a boolean\")\n\n# mark: Displays of collections =================================================================\n\n## Pieces of a display, each owned by the parts until they are joined and let go.\npub struct Parts:\n    pub var pieces: Text*[]\n    pub var count: usize\n\npub func parts() -> Parts:\n    let pieces = new Text*[8] --- catch failure:\n        heap.stop(\"out of memory\")\n    return Parts(pieces = pieces, count = 0)\n\npub func add_part(p: Parts*, piece: Text*):\n    if p.count == p.pieces.length:\n        let grown = new Text*[p.pieces.length * 2] --- catch failure:\n            heap.stop(\"out of memory\")\n        memory.copy(grown, p.pieces, p.count)\n        free(p.pieces)\n        p.pieces = grown\n    p.pieces[p.count] = piece\n    p.count += 1\n\n## `open`, the parts separated by \", \", `close`; the parts are released.\npub func bracketed(p: Parts, open: str, close: str) -> Text*:\n    var total = open.length + close.length\n    var i: usize = 0\n    while i < p.count:\n        total += p.pieces[i].data.length + (2 if i > 0 else 0)\n        i += 1\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at: usize = 0\n    memory.copy(out, open.bytes, open.length)\n    at += open.length\n    i = 0\n    while i < p.count:\n        if i > 0:\n            out[at] = ','\n            out[at + 1] = ' '\n            at += 2\n        memory.copy(out[at..], p.pieces[i].data.bytes, p.pieces[i].data.length)\n        at += p.pieces[i].data.length\n        heap.release((heap.Object*)p.pieces[i])\n        i += 1\n    memory.copy(out[at..], close.bytes, close.length)\n    free(p.pieces)\n    return t\n\n## `open`, then `key: value` pairs; the four texts of a pair are released.\npub func pair_part(p: Parts*, key: Text*, value: Text*):\n    let t = text_room(key.data.length + 2 + value.data.length)\n    let out = text_bytes(t)\n    memory.copy(out, key.data.bytes, key.data.length)\n    out[key.data.length] = ':'\n    out[key.data.length + 1] = ' '\n    memory.copy(out[key.data.length + 2..], value.data.bytes, value.data.length)\n    heap.release((heap.Object*)key)\n    heap.release((heap.Object*)value)\n    add_part(p, t)\n\n## A failure leaving `main`: reported the way the interpreter reports it.\npub func print_error(message: str):\n    var err = io.stderr()\n    _ = err.write(\"error: \".bytes) catch failure: recover 0\n    _ = err.write(message.bytes) catch failure: recover 0\n    _ = err.write(\"\\n\".bytes) catch failure: recover 0\n\n\n# mark: Hashing =================================================================================\n\n## FNV-1a over 64 bits, the function docs/RUNTIME.md states; the emitted program feeds it\n## a value's canonical bytes through these.\npub let hash_offset: u64 = 14695981039346656037\n\npub func hash_bytes(h: u64, data: const u8[]) -> u64:\n    var out = h\n    for b in data:\n        out = (out ^ (u64)b) *% 1099511628211\n    return out\n\npub func hash_byte(h: u64, b: u8) -> u64:\n    return (h ^ (u64)b) *% 1099511628211\n\npub func hash_int(h: u64, i: i64) -> u64:\n    var out = h\n    var bits = (u64)i\n    var k: u32 = 0\n    while k < 8:\n        out = hash_byte(out, (u8)(bits & 255))\n        bits = bits >> 8\n        k += 1\n    return out\n\npub func hash_float(h: u64, f: f64) -> u64:\n    let normal = 0.0 if f == 0.0 else f\n    return hash_int(h, (i64)normal.bits())\n\npub func hash_bool(h: u64, b: bool) -> u64:\n    return hash_byte(h, 1 if b else 0)\n\n## Text and bytes end in 255, so that neighbouring texts keep their boundary.\npub func hash_text(h: u64, t: Text*) -> u64:\n    return hash_byte(hash_bytes(h, t.data.bytes), 255)\n\npub func hash_blob(h: u64, data: Bytes*) -> u64:\n    return hash_byte(hash_bytes(h, data.data), 255)\n\n## A range's bounds, its inclusion as a byte, and a step other than 1 (RUNTIME, Hashing).\npub func hash_range(h: u64, r: Range) -> u64:\n    let bounds = hash_byte(hash_int(hash_int(h, r.low), r.high), 1 if r.inclusive else 0)\n    return bounds if r.step == 1 else hash_int(bounds, r.step)\n\n# mark: Closures and cells (§7.4) ==============================================================\n\n## A function value: an object whose `code` is a function taking the object first, then\n## the parameters, and returning the result. A lambda's object goes on to hold what it\n## captured; a named function's is an immortal one with nothing more; a bound method's\n## holds its receiver. The emitted program declares those shapes, each with the header\n## and `code` first.\npub struct Closure:\n    pub var header: heap.Object\n    pub var code: void*\n    # Only named functions with crossable signatures have a context-free Base entry.\n    pub var base_code: void*\n\n## A widening adapter owns the original closure. The generated entry calls its\n## nonfallible ABI and returns success through the requested fallible ABI.\npub struct FallibleClosure:\n    pub var header: heap.Object\n    pub var code: void*\n    pub var base_code: void*\n    pub var inner: Closure*\n\nfunc fallible_closure_drop(owner: heap.Object*):\n    heap.release(&((FallibleClosure*)owner).inner.header)\n\nfunc fallible_closure_trace(owner: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    visit(&((FallibleClosure*)owner).inner.header, context)\n\nvar fallible_closure_info: heap.Info = heap.Info(name = \"fallible callback\", size = memory.size_of(FallibleClosure), finish = none, drop = fallible_closure_drop, trace = fallible_closure_trace)\n\n## Takes one owned reference, including when the callback captures a mutable cell.\npub func widen_function(inner: Closure*, code: void*) -> Closure*:\n    let owner = (FallibleClosure*)heap.allocate(&fallible_closure_info)\n    owner.code = code\n    owner.base_code = (void*)0\n    owner.inner = inner\n    return (Closure*)owner\n\npub func callback_code(f: Closure*) -> void*:\n    if (usize)f.base_code == 0:\n        heap.stop(\"a Base callback must be a named function with a crossable signature\")\n    return f.base_code\n\n## A captured `var`: one object holding the value, shared by the scope that declared it\n## and every closure that captured it (RUNTIME).\npub struct Cell[T]:\n    pub var header: heap.Object\n    pub var value: T\n    pub var ops: Ops[T]\n\npub func cell_new[T](info: heap.Info*, ops: Ops[T], value: T) -> Cell[T]*:\n    let cell = (Cell[T]*)heap.allocate(info)\n    cell.value = value\n    cell.ops = ops\n    return cell\n\n## `x = v` on a captured `var`: the cell takes the value and lets the old one go.\npub func cell_set[T](cell: Cell[T]*, value: T):\n    let old = cell.value\n    cell.value = value\n    if let f = cell.ops.drop:\n        f(old)\n\npub func cell_drop[T](o: heap.Object*):\n    let cell = (Cell[T]*)o\n    if let f = cell.ops.drop:\n        f(cell.value)\n\npub func cell_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let cell = (Cell[T]*)o\n    if let f = cell.ops.trace:\n        f(cell.value, visit, context)\n\n# mark: Tests (§17.3) =============================================================================\n\n## A built runner's tests, reported by `core` as a Base runner's are and as the interpreter's\n## are (§17.3): `core` names the running test when a trap ends the run.\npub func test_start(name: str):\n    core.test_start(name)\n\n## Where the `assert` that failed the running test stands; empty when no `assert` failed it.\nvar assert_site: str = \"\"\n\n## A false `assert` in a test's own body: the test fails with `asserted`, `assert failed:`\n## and the condition, then the message when one is given, whose reference it takes, and\n## the run goes on (§17.3). Its statement's site is kept for the report.\npub func test_assert(asserted: str, message: Text*?) -> never!:\n    assert_site = heap.site\n    let given = message else error(luce_failure, asserted)\n    let separator = \": \"\n    let text = text_room(asserted.length + separator.length + given.data.length)\n    let out = text_bytes(text)\n    memory.copy(out, asserted.bytes, asserted.length)\n    memory.copy(out[asserted.length..], separator.bytes, separator.length)\n    memory.copy(out[asserted.length + separator.length..], given.data.bytes, given.data.length)\n    heap.release((heap.Object*)given)\n    # the raised message holds the text from here; the catching test takes it\n    let raised = message_of(text)\n    heap.release((heap.Object*)text)\n    error(luce_failure, raised)\n\n## The running test failed with `message`: reported at its failed `assert`, else at the\n## test, `test_site`.\npub func test_failed(test_site: str, message: str):\n    let site = assert_site if assert_site.length > 0 else test_site\n    assert_site = \"\"\n    core.test_result(true, site, message)\n\n## The running test passed.\npub func test_passed():\n    core.test_result(false, \"\", \"\")\n\n## The tally line or lines, and the status: 1 when any test failed.\npub func test_summary() -> i32:\n    return core.test_summary()\n\n# mark: Workers (§14) ============================================================================\n\n## A task: a worker running one call. The object is the spawner's; the worker only reads\n## it. The protocol (RUNTIME): the worker copies the arguments onto its own heap and\n## signals `copied`, so the spawner goes on; it runs the call, keeps the result, and\n## signals `done`; the waiter copies the result onto its heap and signals `taken`; the\n## worker releases what it holds, proves its heap empty, and ends.\npub struct Task:\n    pub var header: heap.Object\n    pub var handle: thread.Handle\n    pub var copied: sync.Semaphore\n    pub var done: sync.Semaphore\n    pub var taken: sync.Semaphore\n    pub var run: func(Task*) -> unit\n    pub var cleanup: func(Task*) -> unit\n    pub var joined: bool\n    pub var waited: bool\n    pub var failed: bool\n    pub var code: ErrorCode\n    pub var message: Text*\n\n## A task whose call answers an `R`: the result lies after the task, where `wait` reads it.\npub struct TaskOf[R]:\n    pub var task: Task\n    pub var result: R\n\n## Starts the worker and returns once it has copied the arguments.\npub func task_start(t: Task*, run: func(Task*) -> unit, cleanup: func(Task*) -> unit):\n    t.run = run\n    t.cleanup = cleanup\n    t.handle = thread.spawn(worker, (void*?)t) catch failure:\n        heap.stop(\"a worker could not be started\")\n    t.copied.acquire()\n\nfunc worker(context: void*?):\n    let raw = context else heap.stop(\"a worker without its task\")\n    let t = (Task*)raw\n    startup()\n    t.run(t)\n    t.done.release()\n    t.taken.acquire()\n    t.cleanup(t)\n    if t.failed:\n        heap.release((heap.Object*)t.message)\n    heap.finish_task()\n\n## The worker's word that the arguments are its own now.\npub func task_copied(t: Task*):\n    t.copied.release()\n\n## The worker's failure, kept for the waiter.\npub func task_failed(t: Task*, code: ErrorCode, message: str):\n    t.failed = true\n    t.code = code\n    t.message = catch_failure(code, message).message\n\n## Waits for the worker's result; a task is waited once (RUNTIME).\npub func task_join(t: Task*):\n    if t.waited:\n        heap.stop(\"the task was waited already\")\n    t.waited = true\n    if not t.joined:\n        t.done.acquire()\n        t.joined = true\n\n## The waiter has what it needs: the worker may release its own and end.\npub func task_finish(t: Task*):\n    t.taken.release()\n    t.handle.join() catch failure:\n        heap.stop(\"a worker could not be joined\")\n\n## A task let go of without a wait (§14): its result is discarded once the worker is done.\npub func task_abandon(t: Task*):\n    if not t.joined:\n        t.done.acquire()\n        t.joined = true\n        task_finish(t)\n    elif not t.waited:\n        task_finish(t)\n\n# mark: The Base boundary (§16) ================================================================\n\n## A Luce text lent to Base as its view; the text outlives the call.\npub func text_view(t: Text*) -> str:\n    return t.data\n\npub func bytes_view(b: Bytes*) -> const u8[]:\n    return b.data\n\n## A list of crossable values lent to Base as a span over its elements; Base never keeps it.\npub func list_span[T](l: List[T]*) -> const T[]:\n    return l.items[..<l.count]\n\n## Rebase a field in a fresh native value copy. Public immutable fields may hold\n## borrowed projections too; only the emitter's private copy is writable here.\npub func rebase_field[T](destination: const T*, value: T):\n    *(T*)destination = value\n\n## Temporary converted arguments at the Base boundary. Keep the allocator with\n## the buffer, and attach its lifetime to the shim's ordinary temporaries pool.\nstruct BoundaryBuffer:\n    var header: heap.Object\n    var bytes: u8[]\n    var allocator: memory.Allocator\n\nvar boundary_buffer_info: heap.Info = heap.Info(name = \"Base argument buffer\", size = memory.size_of(BoundaryBuffer), finish = none, drop = boundary_buffer_drop, trace = text_trace)\n\nfunc boundary_buffer_drop(object: heap.Object*):\n    let buffer = (BoundaryBuffer*)object\n    buffer.allocator.release(buffer.bytes)\n\n## Call-local carrier storage; the enclosing boundary mark owns its allocation.\npub func boundary_span[T](count: usize) -> T[]:\n    let bytes = boundary_buffer((count if count > 0 else 1) * memory.size_of(T), memory.align_of(T))\n    return T[]((T*)bytes.data, count)\n\npub func boundary_buffer(size: usize, alignment: usize) -> u8[]:\n    let buffer = (BoundaryBuffer*)heap.allocate(&boundary_buffer_info)\n    buffer.allocator = memory.allocator\n    buffer.bytes = buffer.allocator.allocate(size, alignment) else heap.stop(\"out of memory\")\n    _ = heap.pool_object((heap.Object*)buffer)\n    return buffer.bytes\n\n## A list of texts lent to Base as views: an object of the statement holds the views and\n## goes with the statement's temporaries (RUNTIME 5).\npub struct Views:\n    pub var header: heap.Object\n    pub var items: str[]\n\npub var views_info: heap.Info = heap.Info(name = \"views\", size = memory.size_of(Views), finish = none, drop = views_drop, trace = text_trace)\n\nfunc views_drop(o: heap.Object*):\n    let v = (Views*)o\n    if v.items.length > 0:\n        free(v.items)\n\npub func str_views(l: List[Text*]*) -> const str[]:\n    let v = (Views*)heap.allocate(&views_info)\n    v.items = new str[l.count if l.count > 0 else 1] --- catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < l.count:\n        v.items[i] = l.items[i].data\n        i += 1\n    _ = heap.pool_object((heap.Object*)v)\n    return v.items[..<l.count]\n\n## A text lent to a Base `c.str` (§16.2): a copy ending in a zero byte, pooled so that it\n## lives until the end of the statement making the call. A text holding a zero byte has no C\n## spelling and traps.\npub func c_text(t: Text*) -> c.str:\n    let n = t.data.length\n    for byte in t.data.bytes:\n        if byte == 0:\n            heap.stop(\"a text holding a zero byte was given to Base as C text\")\n    let b = (Bytes*)heap.allocate_sized(&bytes_info, memory.size_of(Bytes) + n + 1)\n    let store = u8[]((u8*)b + memory.size_of(Bytes), n + 1)\n    memory.copy(store, t.data.bytes, n)\n    store[n] = 0\n    b.data = store[..<n]\n    _ = heap.pool_object((heap.Object*)b)\n    return (c.str)(str)store\n\n## A Base `c.str` result, copied into a Luce text; C text that is not UTF-8 traps.\npub func text_of_c(s: c.str) -> Text*:\n    let view = str(s) catch failure:\n        heap.stop(\"C text from Base is not UTF-8\")\n    return text_of(view)\n\n## A Base `usize` is an `int` in Luce; a value past `int` traps at the crossing (§16.2).\npub func int_of_usize(n: usize) -> i64:\n    if n > 9223372036854775807:\n        heap.stop(\"a size from Base does not fit an int\")\n    return (i64)n\n\n## An `int` handed to a Base `usize` is not negative (§16.2).\npub func usize_of_int(n: i64) -> usize:\n    if n < 0:\n        heap.stop(\"a negative int was given to Base as a size\")\n    return (usize)n\n\n## An `int` handed to a narrower Base integer is in that type's range (§16.2).\npub func i8_of_int(n: i64) -> i8:\n    if n < -128 or n > 127:\n        heap.stop(\"an int outside i8's range was given to Base\")\n    return (i8)n\n\npub func i16_of_int(n: i64) -> i16:\n    if n < -32768 or n > 32767:\n        heap.stop(\"an int outside i16's range was given to Base\")\n    return (i16)n\n\npub func i32_of_int(n: i64) -> i32:\n    if n < -2147483648 or n > 2147483647:\n        heap.stop(\"an int outside i32's range was given to Base\")\n    return (i32)n\n\npub func isize_of_int(n: i64) -> isize:\n    return (isize)n\n\npub func u8_of_int(n: i64) -> u8:\n    if n < 0 or n > 255:\n        heap.stop(\"an int outside u8's range was given to Base\")\n    return (u8)n\n\npub func u16_of_int(n: i64) -> u16:\n    if n < 0 or n > 65535:\n        heap.stop(\"an int outside u16's range was given to Base\")\n    return (u16)n\n\npub func u32_of_int(n: i64) -> u32:\n    if n < 0 or n > 4294967295:\n        heap.stop(\"an int outside u32's range was given to Base\")\n    return (u32)n\n\npub func u64_of_int(n: i64) -> u64:\n    if n < 0:\n        heap.stop(\"a negative int was given to Base as a u64\")\n    return (u64)n\n\npub func int_of_u64(n: u64) -> i64:\n    if n > 9223372036854775807:\n        heap.stop(\"a u64 from Base does not fit an int\")\n    return (i64)n\n\n## The descriptor of a named function's closure, which holds nothing beyond its code.\npub var closure_info: heap.Info = heap.Info(name = \"func\", size = memory.size_of(Closure), finish = none, drop = text_drop, trace = text_trace)\n\ntest \"raising retains a counted text and catching transfers its reference\":\n    with memory.heap:\n        startup()\n        let text = text_of(\"dynamic error\")\n        let view = message_of(text)\n        assert((text.header.flags & heap.immortal) == 0)\n        assert(text.header.strong == 2)\n        heap.release((heap.Object*)text)\n        let failure = catch_failure(luce_failure, view)\n        assert(raised_messages == none)\n        assert(failure.message.header.strong == 1)\n        let copy = copy_failure(failure)\n        drop_failure(failure)\n        assert(copy.message.data == \"dynamic error\")\n        drop_failure(copy)\n        assert(heap.finish_run(0) == 0)\n\ntest \"a nested catch preserves a message still propagating\":\n    with memory.heap:\n        startup()\n        let outer = text_of(\"outer\")\n        let outer_view = message_of(outer)\n        heap.release((heap.Object*)outer)\n        let inner = text_of(\"inner\")\n        let inner_view = message_of(inner)\n        heap.release((heap.Object*)inner)\n        drop_failure(catch_failure(luce_failure, inner_view))\n        let failure = catch_failure(luce_failure, outer_view)\n        assert(failure.message.data == \"outer\")\n        drop_failure(failure)\n        assert(raised_messages == none)\n        assert(heap.finish_run(0) == 0)\n",
    "#==============================================================================================\n#\n#   kernel/list_methods - The list's searches, sorts and functions (§11.1)\n#\n#   DESCRIPTION:\n#       What a list does with its elements beyond holding them: extending, counting and\n#       removing by equality, sorting stably by the elements or by a key, the least and the\n#       greatest, sums, and the methods taking a function. Each is the algorithm the\n#       interpreter runs, call for call, so a key or a comparison with an effect is seen\n#       alike. A function given an element gets a copy of its own; one that changes the\n#       list's shape meanwhile traps, as a `for` over it does.\n#\n#==============================================================================================\n\n# mark: Searching and changing =================================================================\n\n## `extend(other)`: copies of `other`'s elements at the end, `other` the list itself or not.\npub func list_extend[T](l: List[T]*, other: List[T]*):\n    let n = other.count\n    list_room[T](l, l.count + n)\n    var i: usize = 0\n    while i < n:\n        list_push[T](l, elem_copy[T](other, other.items[i]))\n        i += 1\n    l.version += 1\n\n## `count(x)`: the elements equal to `x`.\npub func list_count[T](l: List[T]*, item: T) -> i64:\n    var n: i64 = 0\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            n += 1\n        i += 1\n    return n\n\n## `remove(x)`: the first element equal to `x` taken out and let go of; whether there was one.\npub func list_remove[T](l: List[T]*, item: T) -> bool:\n    var at: usize = 0\n    while at < l.count and not elem_equal[T](l, l.items[at], item):\n        at += 1\n    if at == l.count:\n        return false\n    let out = l.items[at]\n    var k = at\n    while k + 1 < l.count:\n        l.items[k] = l.items[k + 1]\n        k += 1\n    l.count -= 1\n    l.version += 1\n    elem_drop[T](l, out)\n    return true\n\n# mark: Sorting ================================================================================\n\n## `sort(key, reverse)` by the elements themselves: in place and stable. The elements leave\n## the list while it sorts, as in Python, so a comparison sees it empty, and one that\n## changes it traps.\npub func list_sort[T](l: List[T]*, reverse: bool):\n    let compare = l.ops.compare else heap.stop(\"elements without an ordering\")\n    let (items, n, version) = detach[T](l)\n    let order = sorted_order[T](items[..<n], compare, reverse)\n    attach_ordered[T](l, items, n, order, version)\n\n## `sort(key = f, reverse)`: each element's key made once, in order, then the elements\n## sorted stably by their keys.\npub func list_sort_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], reverse: bool):\n    let compare = key_ops.compare else heap.stop(\"keys without an ordering\")\n    let (items, n, version) = detach[T](l)\n    let keys = new K[n if n > 0 else 1] --- catch failure:\n        heap.stop(\"out of memory\")\n    let code = (func(heap.Object*, T) -> K)key.code\n    var i: usize = 0\n    while i < n:\n        keys[i] = code((heap.Object*)key, items[i])\n        i += 1\n    let order = sorted_order[K](keys[..<n], compare, reverse)\n    if let drop = key_ops.drop:\n        i = 0\n        while i < n:\n            drop(keys[i])\n            i += 1\n    free(keys)\n    attach_ordered[T](l, items, n, order, version)\n\n## `sorted(key, reverse)`: a sorted copy.\npub func list_sorted[T](l: List[T]*, reverse: bool) -> List[T]*:\n    let out = list_copy[T](l)\n    list_sort[T](out, reverse)\n    return out\n\npub func list_sorted_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], reverse: bool) -> List[T]*:\n    let out = list_copy[T](l)\n    list_sort_by[T, K](out, key, key_ops, reverse)\n    return out\n\n## The elements out of the list, which is left empty, and the version it then has.\nfunc detach[T](l: List[T]*) -> (T[], usize, u64):\n    let items = l.items\n    let n = l.count\n    l.items = new T[4] --- catch failure:\n        heap.stop(\"out of memory\")\n    l.count = 0\n    l.version += 1\n    return (items, n, l.version)\n\n## The elements back in the list, in `order`; a list that changed meanwhile traps.\nfunc attach_ordered[T](l: List[T]*, items: T[], n: usize, order: usize[], version: u64):\n    if l.version != version or l.count != 0:\n        heap.stop(\"the list changed while it was sorted\")\n    let sorted = new T[items.length] --- catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < n:\n        sorted[i] = items[order[i]]\n        i += 1\n    free(items)\n    free(order)\n    free(l.items)\n    l.items = sorted\n    l.count = n\n    l.version += 1\n\n## The order that sorts `keys` stably by `compare`; `reverse` sorts the other way and still\n## keeps equal keys in their order, as Python's does. A merge sort, top down, its\n## comparisons in the interpreter's order.\nfunc sorted_order[K](keys: const K[], compare: func(K, K) -> i64, reverse: bool) -> usize[]:\n    let n = keys.length\n    var order = new usize[n if n > 0 else 1] --- catch failure:\n        heap.stop(\"out of memory\")\n    var spare = new usize[n if n > 0 else 1] --- catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < n:\n        order[i] = i\n        i += 1\n    merge_sort[K](keys, compare, reverse, order, spare, 0, n)\n    free(spare)\n    return order\n\nfunc merge_sort[K](keys: const K[], compare: func(K, K) -> i64, reverse: bool, order: usize[], spare: usize[], low: usize, high: usize):\n    if high - low < 2:\n        return\n    let middle = low + (high - low) // 2\n    merge_sort[K](keys, compare, reverse, order, spare, low, middle)\n    merge_sort[K](keys, compare, reverse, order, spare, middle, high)\n    var i = low\n    var j = middle\n    var k = low\n    while i < middle and j < high:\n        # the right one first only when it comes strictly before the left\n        let sign = compare(keys[order[j]], keys[order[i]])\n        if (sign > 0 if reverse else sign < 0):\n            spare[k] = order[j]\n            j += 1\n        else:\n            spare[k] = order[i]\n            i += 1\n        k += 1\n    while i < middle:\n        spare[k] = order[i]\n        i += 1\n        k += 1\n    while j < high:\n        spare[k] = order[j]\n        j += 1\n        k += 1\n    k = low\n    while k < high:\n        order[k] = spare[k]\n        k += 1\n\n# mark: Least and greatest =====================================================================\n\n## `min()` (`least`) and `max()`: a copy of the first least or greatest element, none of an\n## empty list.\npub func list_min[T](l: List[T]*, least: bool) -> T?:\n    if l.count == 0:\n        return none\n    let compare = l.ops.compare else heap.stop(\"elements without an ordering\")\n    let version = l.version\n    var best: usize = 0\n    var i: usize = 1\n    while i < l.count:\n        let sign = compare(l.items[i], l.items[best])\n        list_check[T](l, version)\n        if (sign < 0 if least else sign > 0):\n            best = i\n        i += 1\n    return elem_copy[T](l, l.items[best])\n\n## `min(key = f)` and `max(key = f)`: by each element's key, made once, in order.\npub func list_min_by[T, K](l: List[T]*, key: Closure*, key_ops: Ops[K], least: bool) -> T?:\n    if l.count == 0:\n        return none\n    let compare = key_ops.compare else heap.stop(\"keys without an ordering\")\n    let version = l.version\n    var best: usize = 0\n    var best_key = call_on[T, K](l, key, 0, version)\n    var i: usize = 1\n    while i < l.count:\n        let k = call_on[T, K](l, key, i, version)\n        let sign = compare(k, best_key)\n        if (sign < 0 if least else sign > 0):\n            drop_value[K](key_ops, best_key)\n            best_key = k\n            best = i\n        else:\n            drop_value[K](key_ops, k)\n        i += 1\n    drop_value[K](key_ops, best_key)\n    return elem_copy[T](l, l.items[best])\n\nfunc drop_value[K](ops: Ops[K], v: K):\n    if let drop = ops.drop:\n        drop(v)\n\n## `sum()` of a `list[int]`: overflow traps, as `+` does.\npub func list_sum_int(l: List[i64]*) -> i64:\n    var total: i64 = 0\n    var i: usize = 0\n    while i < l.count:\n        total = total +? l.items[i] else heap.stop(\"integer overflow\")\n        i += 1\n    return total\n\n## `sum()` of a `list[float]`: Neumaier's compensated sum, as Python's `sum` adds floats.\npub func list_sum_float(l: List[f64]*) -> f64:\n    var total = 0.0\n    var compensation = 0.0\n    var i: usize = 0\n    while i < l.count:\n        let x = l.items[i]\n        let t = total + x\n        if magnitude(total) >= magnitude(x):\n            compensation += (total - t) + x\n        else:\n            compensation += (x - t) + total\n        total = t\n        i += 1\n    # the compensation of an infinite or overflowed sum is not added: it would make a NaN\n    if compensation != 0.0 and compensation - compensation == 0.0:\n        total += compensation\n    return total\n\nfunc magnitude(x: f64) -> f64:\n    return -x if x < 0.0 else x\n\n# mark: Functions of the elements ==============================================================\n\n## A closure of one element called on a copy of its own, so the call may change the list\n## and the element still live through it; a change of the list's shape then traps.\nfunc call_on[T, R](l: List[T]*, f: Closure*, i: usize, version: u64) -> R:\n    let item = elem_copy[T](l, l.items[i])\n    let out = ((func(heap.Object*, T) -> R)f.code)((heap.Object*)f, item)\n    elem_drop[T](l, item)\n    list_check[T](l, version)\n    return out\n\n## `map(f)`: a new list of `f` over each element, the results owned by it; `f` is a\n## closure, called by the convention every closure follows: its own object first.\npub func list_map[T, U](l: List[T]*, f: Closure*, info: heap.Info*, ops: Ops[U]) -> List[U]*:\n    let out = list_new[U](info, ops)\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        list_push[U](out, call_on[T, U](l, f, i, version))\n        i += 1\n    return out\n\n## `flat_map(f)`: the elements of every list `f` makes, in order.\npub func list_flat_map[T, U](l: List[T]*, f: Closure*, info: heap.Info*, ops: Ops[U]) -> List[U]*:\n    let out = list_new[U](info, ops)\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        let part = call_on[T, List[U]*](l, f, i, version)\n        var k: usize = 0\n        while k < part.count:\n            list_push[U](out, elem_copy[U](part, part.items[k]))\n            k += 1\n        heap.release((heap.Object*)part)\n        i += 1\n    return out\n\npub func list_filter[T](l: List[T]*, f: Closure*) -> List[T]*:\n    let out = list_new[T](l.header.info, l.ops)\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        if call_on[T, bool](l, f, i, version):\n            list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\n## `any(f)` and `all(f)`: whether `f` holds for one element, or for every one; they stop\n## at the first that decides.\npub func list_any[T](l: List[T]*, f: Closure*) -> bool:\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        if call_on[T, bool](l, f, i, version):\n            return true\n        i += 1\n    return false\n\npub func list_all[T](l: List[T]*, f: Closure*) -> bool:\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        if not call_on[T, bool](l, f, i, version):\n            return false\n        i += 1\n    return true\n\n## `find(f)`: a copy of the first element `f` holds for, or none.\npub func list_find[T](l: List[T]*, f: Closure*) -> T?:\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        if call_on[T, bool](l, f, i, version):\n            return elem_copy[T](l, l.items[i])\n        i += 1\n    return none\n\n## `reduce(f, initial)`: `f(f(initial, first), second)` and so on, left to right.\npub func list_reduce[T, A](l: List[T]*, f: Closure*, initial: A, ops: Ops[A]) -> A:\n    var total = initial\n    if let copy = ops.copy:\n        total = copy(initial)\n    let code = (func(heap.Object*, A, T) -> A)f.code\n    let version = l.version\n    var i: usize = 0\n    while i < l.count:\n        let item = elem_copy[T](l, l.items[i])\n        let next = code((heap.Object*)f, total, item)\n        elem_drop[T](l, item)\n        drop_value[A](ops, total)\n        total = next\n        list_check[T](l, version)\n        i += 1\n    return total\n\n# mark: New lists ===============================================================================\n\n## `zip(other)`: pairs of the elements at each index, as long as the shorter list.\npub func list_zip[T, U](l: List[T]*, other: List[U]*, info: heap.Info*, ops: Ops[(T, U)]) -> List[(T, U)]*:\n    let out = list_new[(T, U)](info, ops)\n    let n = l.count if l.count < other.count else other.count\n    var i: usize = 0\n    while i < n:\n        list_push[(T, U)](out, (elem_copy[T](l, l.items[i]), elem_copy[U](other, other.items[i])))\n        i += 1\n    return out\n\n## `chunks(size)`: the elements in lists of `size`, the last one shorter when they run out.\npub func list_chunks[T](l: List[T]*, size: i64, info: heap.Info*, ops: Ops[List[T]*]) -> List[List[T]*]*:\n    if size < 1:\n        heap.stop(\"chunks of a size below one\")\n    let out = list_new[List[T]*](info, ops)\n    var start: i64 = 0\n    while start < (i64)l.count:\n        let end = start + size if size < (i64)l.count - start else (i64)l.count\n        list_push[List[T]*](out, list_slice[T](l, start, end, false))\n        start = end\n    return out\n\n## `indexed()` as a value: each element with its index.\npub func list_indexed[T](l: List[T]*, info: heap.Info*, ops: Ops[(i64, T)]) -> List[(i64, T)]*:\n    let out = list_new[(i64, T)](info, ops)\n    var i: usize = 0\n    while i < l.count:\n        list_push[(i64, T)](out, ((i64)i, elem_copy[T](l, l.items[i])))\n        i += 1\n    return out\n\n## `distinct()`: the elements without the ones equal to an earlier one, in order, found\n## through a table of their hashes.\npub func list_distinct[T](l: List[T]*) -> List[T]*:\n    let hashed = l.ops.hashed else heap.stop(\"elements without a hash\")\n    let out = list_new[T](l.header.info, l.ops)\n    var size: usize = 8\n    while size < l.count * 2:\n        size *= 2\n    var slots = new usize[size] --- catch failure:\n        heap.stop(\"out of memory\")\n    let empty: usize = 18446744073709551615\n    var i: usize = 0\n    while i < size:\n        slots[i] = empty\n        i += 1\n    i = 0\n    while i < l.count:\n        var at = (usize)hashed(l.items[i]) & (size - 1)\n        var seen = false\n        while slots[at] != empty and not seen:\n            seen = elem_equal[T](l, out.items[slots[at]], l.items[i])\n            if not seen:\n                at = (at + 1) & (size - 1)\n        if not seen:\n            slots[at] = out.count\n            list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    free(slots)\n    return out\n",
    "#==============================================================================================\n#\n#   kernel/lists - The list (§11.1)\n#\n#   DESCRIPTION:\n#       `list[T]`: its storage and every operation of §11.1, its elements' copies, drops and\n#       comparisons through the `Ops` the emitted program hands it.\n#\n#==============================================================================================\n\n# mark: Lists =================================================================================\n\n## What a collection needs of its element type; `none` where the type does not have it.\npub struct Ops[T]:\n    pub var copy: (func(T) -> T)?\n    pub var drop: (func(T) -> unit)?\n    pub var trace: (func(T, func(heap.Object*, void*) -> unit, void*) -> unit)?\n    pub var equal: (func(T, T) -> bool)?\n    pub var compare: (func(T, T) -> i64)?\n    pub var hashed: (func(T) -> u64)?\n\n## `list[T]` (§11.1): an object the collector traces, its elements owned, `version`\n## counting the structural changes a running `for` must not see.\npub struct List[T]:\n    pub var header: heap.Object\n    pub var items: T[]\n    pub var count: usize\n    pub var version: u64\n    pub var ops: Ops[T]\n\npub func list_new[T](info: heap.Info*, ops: Ops[T]) -> List[T]*:\n    let l = (List[T]*)heap.allocate(info)\n    l.items = new T[4] --- catch failure:\n        heap.stop(\"out of memory\")\n    l.count = 0\n    l.version = 0\n    l.ops = ops\n    return l\n\n## A literal: the elements are owned already.\npub func list_of[T](info: heap.Info*, ops: Ops[T], elements: const T[]) -> List[T]*:\n    let l = list_new[T](info, ops)\n    for e in elements:\n        list_push[T](l, e)\n    return l\n\nfunc list_room[T](l: List[T]*, n: usize):\n    if n <= l.items.length:\n        return\n    var size = l.items.length * 2\n    while size < n:\n        size = size * 2\n    let grown = new T[size] --- catch failure:\n        heap.stop(\"out of memory\")\n    memory.copy(grown, l.items, l.count)\n    free(l.items)\n    l.items = grown\n\nfunc list_push[T](l: List[T]*, item: T):\n    list_room[T](l, l.count + 1)\n    l.items[l.count] = item\n    l.count += 1\n\nfunc elem_copy[T](l: List[T]*, v: T) -> T:\n    if let f = l.ops.copy:\n        return f(v)\n    return v\n\nfunc elem_drop[T](l: List[T]*, v: T):\n    if let f = l.ops.drop:\n        f(v)\n\n## `append(x)`: the list takes the value.\npub func list_append[T](l: List[T]*, item: T):\n    list_push[T](l, item)\n    l.version += 1\n\npub func list_insert[T](l: List[T]*, i: i64, item: T):\n    if i < 0 or i > (i64)l.count:\n        heap.stop(\"index out of range\")\n    list_room[T](l, l.count + 1)\n    var k = l.count\n    while k > (usize)i:\n        l.items[k] = l.items[k - 1]\n        k -= 1\n    l.items[(usize)i] = item\n    l.count += 1\n    l.version += 1\n\n## `remove_at(i)`: the element, owned by the caller.\npub func list_remove_at[T](l: List[T]*, i: i64) -> T:\n    let at = index(i, l.count)\n    let out = l.items[at]\n    var k = at\n    while k + 1 < l.count:\n        l.items[k] = l.items[k + 1]\n        k += 1\n    l.count -= 1\n    l.version += 1\n    return out\n\npub func list_pop[T](l: List[T]*) -> T:\n    if l.count == 0:\n        heap.stop(\"pop of an empty list\")\n    l.count -= 1\n    l.version += 1\n    return l.items[l.count]\n\n## `clear()`: the elements are let go of once the list no longer holds them. Letting one go\n## can run the cycle collector, whose walk must not find a released element in the list; a\n## `deinit` that appends to the list meanwhile writes to fresh storage.\npub func list_clear[T](l: List[T]*):\n    let n = l.count\n    l.count = 0\n    l.version += 1\n    let drop = l.ops.drop else return\n    if n == 0:\n        return\n    let items = l.items\n    l.items = new T[items.length] --- catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < n:\n        drop(items[i])\n        i += 1\n    free(items)\n\n## `values[i]`: a copy of the element, the caller's own.\npub func list_get[T](l: List[T]*, i: i64) -> T:\n    return elem_copy[T](l, l.items[index(i, l.count)])\n\n## `values[i].field = x`: the element's own slot, neither copied nor retained, so a store\n## through it changes the element in the list and takes no reference of its own.\npub func list_slot[T](l: List[T]*, i: i64) -> T*:\n    return &l.items[index(i, l.count)]\n\n## `values[i] = x`: the list takes the value and lets the old one go.\npub func list_set[T](l: List[T]*, i: i64, item: T):\n    let at = index(i, l.count)\n    let old = l.items[at]\n    l.items[at] = item\n    elem_drop[T](l, old)\n\npub func list_length[T](l: List[T]*) -> i64:\n    return (i64)l.count\n\npub func list_first[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[0])\n\npub func list_last[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[l.count - 1])\n\n## `values[a..<b]`: a new list of copies; bounds checked.\npub func list_slice[T](l: List[T]*, low: i64, high: i64, whole: bool) -> List[T]*:\n    let n = (i64)l.count\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    let out = list_new[T](l.header.info, l.ops)\n    var i = (usize)low\n    while i < (usize)end:\n        list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\npub func list_copy[T](l: List[T]*) -> List[T]*:\n    return list_slice[T](l, 0, 0, true)\n\n## `a + b`: a new list of both.\npub func list_concat[T](a: List[T]*, b: List[T]*) -> List[T]*:\n    let out = list_copy[T](a)\n    var i: usize = 0\n    while i < b.count:\n        list_push[T](out, elem_copy[T](b, b.items[i]))\n        i += 1\n    return out\n\nfunc elem_equal[T](l: List[T]*, a: T, b: T) -> bool:\n    if let f = l.ops.equal:\n        return f(a, b)\n    heap.stop(\"elements without equality\")\n\npub func list_contains[T](l: List[T]*, item: T) -> bool:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return true\n        i += 1\n    return false\n\npub func list_index_of[T](l: List[T]*, item: T) -> i64?:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return (i64)i\n        i += 1\n    return none\n\n## `==` on lists: the same length and equal elements in order (§4.4).\npub func list_equal[T](a: List[T]*, b: List[T]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if not elem_equal[T](a, a.items[i], b.items[i]):\n            return false\n        i += 1\n    return true\n\npub func list_reverse[T](l: List[T]*):\n    var i: usize = 0\n    while i + 1 < l.count - i:\n        let tmp = l.items[i]\n        l.items[i] = l.items[l.count - 1 - i]\n        l.items[l.count - 1 - i] = tmp\n        i += 1\n    l.version += 1\n\npub func list_reversed[T](l: List[T]*) -> List[T]*:\n    let out = list_copy[T](l)\n    list_reverse[T](out)\n    return out\n\n## `join(separator)` on a `list[str]`.\npub func list_join(l: List[Text*]*, separator: Text*) -> Text*:\n    var total: usize = 0\n    var i: usize = 0\n    while i < l.count:\n        total += l.items[i].data.length\n        if i > 0:\n            total += separator.data.length\n        i += 1\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at: usize = 0\n    i = 0\n    while i < l.count:\n        if i > 0:\n            memory.copy(out[at..], separator.data.bytes, separator.data.length)\n            at += separator.data.length\n        memory.copy(out[at..], l.items[i].data.bytes, l.items[i].data.length)\n        at += l.items[i].data.length\n        i += 1\n    return t\n\n## A `for` over a list checks, at the start of every step, that nothing changed its shape.\npub func list_check[T](l: List[T]*, version: u64):\n    if l.version != version:\n        heap.stop(\"the list changed while it was iterated\")\n\n## The runtime's drop and trace of a list, through its descriptor.\npub func list_drop[T](o: heap.Object*):\n    let l = (List[T]*)o\n    var i: usize = 0\n    while i < l.count:\n        elem_drop[T](l, l.items[i])\n        i += 1\n    l.count = 0\n    free(l.items)\n\npub func list_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let l = (List[T]*)o\n    if let f = l.ops.trace:\n        var i: usize = 0\n        while i < l.count:\n            f(l.items[i], visit, context)\n            i += 1\n\npub func list_from_args(info: heap.Info*, ops: Ops[Text*], arguments: str[]) -> List[Text*]*:\n    let l = list_new[Text*](info, ops)\n    for a in arguments:\n        list_push[Text*](l, text_of(a))\n    return l\n\n",
    "#==============================================================================================\n#\n#   kernel/maps - Maps and sets (§11.2)\n#\n#   DESCRIPTION:\n#       `map[K, V]` and `set[T]`: insertion-ordered tables of entries and an index of their\n#       hashes, and every operation of §11.2.\n#\n#==============================================================================================\n\n# mark: Maps and sets ==========================================================================\n\n## `map[K, V]` and `set[T]` (§11.2): entries in insertion order in `keys` and `values`, an\n## open-addressed index from a key's hash to its entry, a removal closing the gap. A set\n## is a map to a byte.\npub struct Map[K, V]:\n    pub var header: heap.Object\n    pub var keys: K[]\n    pub var values: V[]\n    pub var hashes: u64[]\n    pub var count: usize\n    pub var version: u64\n    ## Entry index + 1 per slot; 0 is empty. Twice the capacity, a power of two.\n    pub var index: u32[]\n    pub var key_ops: Ops[K]\n    pub var value_ops: Ops[V]\n\npub func map_new[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V]) -> Map[K, V]*:\n    let m = (Map[K, V]*)heap.allocate(info)\n    m.keys = new K[4] --- catch failure:\n        heap.stop(\"out of memory\")\n    m.values = new V[4] --- catch failure:\n        heap.stop(\"out of memory\")\n    m.hashes = new u64[4] --- catch failure:\n        heap.stop(\"out of memory\")\n    m.index = new u32[8] --- catch failure:\n        heap.stop(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    m.count = 0\n    m.version = 0\n    m.key_ops = key_ops\n    m.value_ops = value_ops\n    return m\n\n## A literal: the keys and values are owned already; a repeated key keeps the last value.\npub func map_of[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V], keys: const K[], values: const V[]) -> Map[K, V]*:\n    let m = map_new[K, V](info, key_ops, value_ops)\n    var i: usize = 0\n    while i < keys.length:\n        map_set[K, V](m, keys[i], values[i])\n        i += 1\n    return m\n\nfunc key_hash[K, V](m: Map[K, V]*, key: K) -> u64:\n    if let f = m.key_ops.hashed:\n        return f(key)\n    heap.stop(\"keys without a hash\")\n\nfunc key_equal[K, V](m: Map[K, V]*, a: K, b: K) -> bool:\n    if let f = m.key_ops.equal:\n        return f(a, b)\n    heap.stop(\"keys without equality\")\n\nfunc key_copy[K, V](m: Map[K, V]*, k: K) -> K:\n    if let f = m.key_ops.copy:\n        return f(k)\n    return k\n\nfunc key_drop[K, V](m: Map[K, V]*, k: K):\n    if let f = m.key_ops.drop:\n        f(k)\n\nfunc value_copy[K, V](m: Map[K, V]*, v: V) -> V:\n    if let f = m.value_ops.copy:\n        return f(v)\n    return v\n\nfunc value_drop[K, V](m: Map[K, V]*, v: V):\n    if let f = m.value_ops.drop:\n        f(v)\n\n## The entry of `key`, or none.\nfunc map_find[K, V](m: Map[K, V]*, key: K, h: u64) -> usize?:\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        let entry = (usize)m.index[at] - 1\n        if m.hashes[entry] == h and key_equal[K, V](m, m.keys[entry], key):\n            return entry\n        at = (at + 1) & mask\n    return none\n\nfunc map_reindex[K, V](m: Map[K, V]*, slots: usize):\n    if m.index.length != slots:\n        free(m.index)\n        m.index = new u32[slots] --- catch failure:\n            heap.stop(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    let mask = slots - 1\n    var i: usize = 0\n    while i < m.count:\n        var at = (usize)m.hashes[i] & mask\n        while m.index[at] != 0:\n            at = (at + 1) & mask\n        m.index[at] = u32(i + 1)\n        i += 1\n\nfunc map_room[K, V](m: Map[K, V]*, n: usize):\n    if n <= m.keys.length:\n        return\n    var size = m.keys.length * 2\n    while size < n:\n        size = size * 2\n    let keys = new K[size] --- catch failure:\n        heap.stop(\"out of memory\")\n    let values = new V[size] --- catch failure:\n        heap.stop(\"out of memory\")\n    let hashes = new u64[size] --- catch failure:\n        heap.stop(\"out of memory\")\n    memory.copy(keys, m.keys, m.count)\n    memory.copy(values, m.values, m.count)\n    memory.copy(hashes, m.hashes, m.count)\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    m.keys = keys\n    m.values = values\n    m.hashes = hashes\n    map_reindex[K, V](m, size * 2)\n\n## `m[key] = value`: the map takes both; an existing key keeps its place and lets its old\n## value go, and the given key is let go of.\npub func map_set[K, V](m: Map[K, V]*, key: K, value: V):\n    let h = key_hash[K, V](m, key)\n    if let entry = map_find[K, V](m, key, h):\n        let old = m.values[entry]\n        m.values[entry] = value\n        value_drop[K, V](m, old)\n        key_drop[K, V](m, key)\n        return\n    map_room[K, V](m, m.count + 1)\n    m.keys[m.count] = key\n    m.values[m.count] = value\n    m.hashes[m.count] = h\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        at = (at + 1) & mask\n    m.index[at] = u32(m.count + 1)\n    m.count += 1\n    m.version += 1\n\n## `m[key]`: a copy of the value, or none.\npub func map_get[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    return value_copy[K, V](m, m.values[entry])\n\npub func map_contains[K, V](m: Map[K, V]*, key: K) -> bool:\n    return map_find[K, V](m, key, key_hash[K, V](m, key)) != none\n\n## `m.remove(key)`: the value, the caller's own, or none; the rest keep their order. The\n## stored key is let go of once the map no longer holds it (see `map_clear`).\npub func map_remove[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    let out = m.values[entry]\n    let stored = m.keys[entry]\n    var i = entry\n    while i + 1 < m.count:\n        m.keys[i] = m.keys[i + 1]\n        m.values[i] = m.values[i + 1]\n        m.hashes[i] = m.hashes[i + 1]\n        i += 1\n    m.count -= 1\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n    key_drop[K, V](m, stored)\n    return out\n\npub func map_length[K, V](m: Map[K, V]*) -> i64:\n    return (i64)m.count\n\n## `clear()`: the entries are let go of once the map no longer holds them. Letting one go\n## can run the cycle collector, whose walk must not find a released key or value in the\n## map; a `deinit` that sets an entry meanwhile writes to fresh storage.\npub func map_clear[K, V](m: Map[K, V]*):\n    let n = m.count\n    let owned = m.key_ops.drop != none or m.value_ops.drop != none\n    let keys = m.keys\n    let values = m.values\n    if n > 0 and owned:\n        m.keys = new K[keys.length] --- catch failure:\n            heap.stop(\"out of memory\")\n        m.values = new V[values.length] --- catch failure:\n            heap.stop(\"out of memory\")\n    m.count = 0\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n    if n == 0 or not owned:\n        return\n    var i: usize = 0\n    while i < n:\n        key_drop[K, V](m, keys[i])\n        value_drop[K, V](m, values[i])\n        i += 1\n    free(keys)\n    free(values)\n\npub func map_copy[K, V](m: Map[K, V]*) -> Map[K, V]*:\n    let out = map_new[K, V](m.header.info, m.key_ops, m.value_ops)\n    var i: usize = 0\n    while i < m.count:\n        map_set[K, V](out, key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `m.keys()`, `m.values()`: new lists of copies, in entry order.\npub func map_keys[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[K]) -> List[K]*:\n    let out = list_new[K](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[K](out, key_copy[K, V](m, m.keys[i]))\n        i += 1\n    return out\n\npub func map_values[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[V]) -> List[V]*:\n    let out = list_new[V](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[V](out, value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `==` on maps: the same keys, each with an equal value (§4.4).\npub func map_equal[K, V](a: Map[K, V]*, b: Map[K, V]*) -> bool:\n    if a.count != b.count:\n        return false\n    let f = a.value_ops.equal else heap.stop(\"values without equality\")\n    var i: usize = 0\n    while i < a.count:\n        let entry = map_find[K, V](b, a.keys[i], a.hashes[i]) else return false\n        if not f(a.values[i], b.values[entry]):\n            return false\n        i += 1\n    return true\n\npub func map_check[K, V](m: Map[K, V]*, version: u64):\n    if m.version != version:\n        heap.stop(\"the map changed while it was iterated\")\n\npub func map_drop[K, V](o: heap.Object*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        key_drop[K, V](m, m.keys[i])\n        value_drop[K, V](m, m.values[i])\n        i += 1\n    m.count = 0\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    free(m.index)\n\npub func map_trace[K, V](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        if let f = m.key_ops.trace:\n            f(m.keys[i], visit, context)\n        if let g = m.value_ops.trace:\n            g(m.values[i], visit, context)\n        i += 1\n\n## The hash of a map or a set as docs/RUNTIME.md states: entry hashes summed, wrapping.\npub func map_hash[K, V](m: Map[K, V]*) -> u64:\n    let f = m.value_ops.hashed else heap.stop(\"values without a hash\")\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% (m.hashes[i] *% 31 +% f(m.values[i]))\n        i += 1\n    return sum\n\n# -- sets, as maps to a byte -------------------------------------------------------------\n\npub func set_hash[K](m: Map[K, u8]*) -> u64:\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% m.hashes[i]\n        i += 1\n    return sum\n\nfunc byte_ops() -> Ops[u8]:\n    return Ops[u8](copy = none, drop = none, trace = none, equal = none, compare = none, hashed = none)\n\npub func set_of[K](info: heap.Info*, ops: Ops[K], elements: const K[]) -> Map[K, u8]*:\n    let s = map_new[K, u8](info, ops, byte_ops())\n    for e in elements:\n        set_insert[K](s, e)\n    return s\n\n## `s.insert(x)`: the set takes the value, or lets it go when it is there already.\npub func set_insert[K](s: Map[K, u8]*, key: K):\n    map_set[K, u8](s, key, 0)\n\npub func set_remove[K](s: Map[K, u8]*, key: K) -> bool:\n    return map_remove[K, u8](s, key) != none\n\npub func set_union[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_copy[K, u8](a)\n    var i: usize = 0\n    while i < b.count:\n        set_insert[K](out, key_copy[K, u8](b, b.keys[i]))\n        i += 1\n    return out\n\npub func set_intersection[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) != none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\npub func set_difference[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\n## `symmetric_difference(other)`: the elements of either set but not both, `a`'s first.\npub func set_symmetric_difference[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = set_difference[K](a, b)\n    var i: usize = 0\n    while i < b.count:\n        if map_find[K, u8](a, b.keys[i], b.hashes[i]) == none:\n            set_insert[K](out, key_copy[K, u8](b, b.keys[i]))\n        i += 1\n    return out\n\n## `is_subset(other)`: every element of `a` is in `b`.\npub func set_is_subset[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            return false\n        i += 1\n    return true\n\n## `is_superset(other)`: every element of `b` is in `a`.\npub func set_is_superset[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    return set_is_subset[K](b, a)\n\n## `is_disjoint(other)`: no element in both.\npub func set_is_disjoint[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) != none:\n            return false\n        i += 1\n    return true\n\n## `m.get(key, default)`: a copy of the value, or of `default` when the key is absent.\npub func map_get_or[K, V](m: Map[K, V]*, key: K, default: V) -> V:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return value_copy[K, V](m, default)\n    return value_copy[K, V](m, m.values[entry])\n\n## `m.update(other)`: copies of `other`'s entries inserted or replacing, in `other`'s order;\n## `other` may be `m` itself.\npub func map_update[K, V](m: Map[K, V]*, other: Map[K, V]*):\n    let n = other.count\n    var i: usize = 0\n    while i < n:\n        map_set[K, V](m, key_copy[K, V](other, other.keys[i]), value_copy[K, V](other, other.values[i]))\n        i += 1\n\n## `==` on sets: the same elements (§4.4).\npub func set_equal[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            return false\n        i += 1\n    return true\n\npub func set_new[K](info: heap.Info*, ops: Ops[K]) -> Map[K, u8]*:\n    return map_new[K, u8](info, ops, byte_ops())\n\n## `m.items()`: a new list of key, value pairs, copies, in entry order.\npub func map_items[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[(K, V)]) -> List[(K, V)]*:\n    let out = list_new[(K, V)](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[(K, V)](out, (key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i])))\n        i += 1\n    return out\n",
    "#==============================================================================================\n#\n#   kernel/text - Text operations (§11.3)\n#\n#   DESCRIPTION:\n#       The methods of `str` and `bytes`: searching, splitting, trimming, case, padding and\n#       the rest, each answering a text of its own.\n#\n#==============================================================================================\n\n# mark: Text operations (§11.3) ================================================================\n\nfunc find_bytes(haystack: const u8[], needle: const u8[], start: usize) -> usize?:\n    if needle.length == 0:\n        return start\n    var i = start\n    while i + needle.length <= haystack.length:\n        var k: usize = 0\n        while k < needle.length and haystack[i + k] == needle[k]:\n            k += 1\n        if k == needle.length:\n            return i\n        i += 1\n    return none\n\npub func starts_with(text: Text*, prefix: Text*) -> bool:\n    if prefix.data.length > text.data.length:\n        return false\n    return compare_bytes(text.data.bytes[..<prefix.data.length], prefix.data.bytes) == 0\n\npub func ends_with(text: Text*, suffix: Text*) -> bool:\n    if suffix.data.length > text.data.length:\n        return false\n    return compare_bytes(text.data.bytes[text.data.length - suffix.data.length..], suffix.data.bytes) == 0\n\n## The scalar index of the first occurrence, or none.\npub func index_of(text: Text*, needle: Text*) -> i64?:\n    let at = find_bytes(text.data.bytes, needle.data.bytes, 0) else return none\n    var n: i64 = 0\n    for b in text.data.bytes[..<at]:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\npub func split(text: Text*, separator: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    if separator.data.length == 0:\n        heap.stop(\"split needs a separator\")\n    let out = list_new[Text*](info, ops)\n    var start: usize = 0\n    while true:\n        let at = find_bytes(text.data.bytes, separator.data.bytes, start) else break\n        list_push[Text*](out, text_of((str)text.data.bytes[start..<at]))\n        start = at + separator.data.length\n    list_push[Text*](out, text_of((str)text.data.bytes[start..]))\n    return out\n\npub func lines(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    let out = list_new[Text*](info, ops)\n    let b = text.data.bytes\n    var start: usize = 0\n    var i: usize = 0\n    while i < b.length:\n        if b[i] == '\\n':\n            var end = i\n            if end > start and b[end - 1] == '\\r':\n                end -= 1\n            list_push[Text*](out, text_of((str)b[start..<end]))\n            start = i + 1\n        i += 1\n    if start < b.length:\n        list_push[Text*](out, text_of((str)b[start..]))\n    return out\n\n## ASCII white space, as Python's `strip()` and `split()` take it there: a space, a tab, a\n## line feed, a carriage return, a vertical tab, a form feed.\nfunc is_white(byte: u8) -> bool:\n    return byte == ' ' or byte == '\\t' or byte == '\\n' or byte == '\\r' or byte == 11 or byte == 12\n\n## `trim()`, `trim_start()` and `trim_end()`: white space gone from both ends or one.\npub func trim(text: Text*) -> Text*:\n    return trimmed(text, true, true)\n\npub func trim_start(text: Text*) -> Text*:\n    return trimmed(text, true, false)\n\npub func trim_end(text: Text*) -> Text*:\n    return trimmed(text, false, true)\n\nfunc trimmed(text: Text*, start_too: bool, end_too: bool) -> Text*:\n    let b = text.data.bytes\n    var start: usize = 0\n    var end = b.length\n    while start_too and start < end and is_white(b[start]):\n        start += 1\n    while end_too and end > start and is_white(b[end - 1]):\n        end -= 1\n    return text_of((str)b[start..<end])\n\npub func upper(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        out[i] = byte - 32 if byte >= 'a' and byte <= 'z' else byte\n        i += 1\n    return t\n\npub func lower(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        out[i] = byte + 32 if byte >= 'A' and byte <= 'Z' else byte\n        i += 1\n    return t\n\npub func replace(text: Text*, old: Text*, new_text: Text*) -> Text*:\n    if old.data.length == 0:\n        heap.stop(\"replace needs a text to replace\")\n    let source = text.data.bytes\n    var count: usize = 0\n    var start: usize = 0\n    while true:\n        let at = find_bytes(source, old.data.bytes, start) else break\n        count += 1\n        start = at + old.data.length\n    let total = source.length - count * old.data.length + count * new_text.data.length\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at_out: usize = 0\n    start = 0\n    while true:\n        let at = find_bytes(source, old.data.bytes, start) else break\n        memory.copy(out[at_out..], source[start..<at], at - start)\n        at_out += at - start\n        memory.copy(out[at_out..], new_text.data.bytes, new_text.data.length)\n        at_out += new_text.data.length\n        start = at + old.data.length\n    memory.copy(out[at_out..], source[start..], source.length - start)\n    return t\n\npub func repeat(text: Text*, n: i64) -> Text*:\n    if n < 0:\n        heap.stop(\"repeat of a negative count\")\n    let total = text.data.length * (usize)n\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < (usize)n:\n        memory.copy(out[i * text.data.length..], text.data.bytes, text.data.length)\n        i += 1\n    return t\n\n# mark: More text operations (§11.3) ===========================================================\n\n## `split()`: the runs of text between runs of white space, no empty piece (Python's).\npub func split_white(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    let out = list_new[Text*](info, ops)\n    let b = text.data.bytes\n    var i: usize = 0\n    while i < b.length:\n        while i < b.length and is_white(b[i]):\n            i += 1\n        let start = i\n        while i < b.length and not is_white(b[i]):\n            i += 1\n        if i > start:\n            list_push[Text*](out, text_of((str)b[start..<i]))\n    return out\n\n## `count(s)`: the occurrences of `s` that do not overlap, left to right.\npub func count_of(text: Text*, needle: Text*) -> i64:\n    if needle.data.length == 0:\n        heap.stop(\"count needs a text to count\")\n    var n: i64 = 0\n    var start: usize = 0\n    while true:\n        let at = find_bytes(text.data.bytes, needle.data.bytes, start) else break\n        n += 1\n        start = at + needle.data.length\n    return n\n\n## The scalar index of the last occurrence, or none; an empty needle is at the end.\npub func last_index_of(text: Text*, needle: Text*) -> i64?:\n    let b = text.data.bytes\n    let n = needle.data.length\n    if n > b.length:\n        return none\n    var i = b.length - n + 1\n    while i > 0:\n        i -= 1\n        if compare_bytes(b[i..<i + n], needle.data.bytes) == 0:\n            return scalars_before(b, i)\n    return none\n\nfunc scalars_before(b: const u8[], at: usize) -> i64:\n    var n: i64 = 0\n    for byte in b[..<at]:\n        if (byte & 0xC0) != 0x80:\n            n += 1\n    return n\n\n## `remove_prefix(s)` and `remove_suffix(s)`: the text without it when it has it.\npub func remove_prefix(text: Text*, prefix: Text*) -> Text*:\n    if starts_with(text, prefix):\n        return text_of((str)text.data.bytes[prefix.data.length..])\n    return text_of(text.data)\n\npub func remove_suffix(text: Text*, suffix: Text*) -> Text*:\n    if ends_with(text, suffix):\n        return text_of((str)text.data.bytes[..<text.data.length - suffix.data.length])\n    return text_of(text.data)\n\n## `pad_left`, `pad_right` and `center`: `fill`, one scalar, until the text is `width`\n## scalars wide; `center` puts the odd one where Python's `str.center` does.\npub func pad_left(text: Text*, width: i64, fill: Text*) -> Text*:\n    let margin = padding_of(text, width, fill)\n    return padded(text, margin, 0, fill)\n\npub func pad_right(text: Text*, width: i64, fill: Text*) -> Text*:\n    let margin = padding_of(text, width, fill)\n    return padded(text, 0, margin, fill)\n\npub func center(text: Text*, width: i64, fill: Text*) -> Text*:\n    let margin = padding_of(text, width, fill)\n    let left = margin // 2 + (margin & width & 1)\n    return padded(text, left, margin - left, fill)\n\nfunc padding_of(text: Text*, width: i64, fill: Text*) -> i64:\n    if scalar_length(fill) != 1:\n        heap.stop(\"a fill is one scalar\")\n    let n = scalar_length(text)\n    return width - n if width > n else 0\n\nfunc padded(text: Text*, left: i64, right: i64, fill: Text*) -> Text*:\n    let f = fill.data.length\n    let t = text_room((usize)(left + right) * f + text.data.length)\n    let out = text_bytes(t)\n    var at: usize = 0\n    for _ in 0..<left:\n        memory.copy(out[at..], fill.data.bytes, f)\n        at += f\n    memory.copy(out[at..], text.data.bytes, text.data.length)\n    at += text.data.length\n    for _ in 0..<right:\n        memory.copy(out[at..], fill.data.bytes, f)\n        at += f\n    return t\n\nfunc ascii_letter(byte: u8) -> bool:\n    return (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z')\n\nfunc upper_byte(byte: u8) -> u8:\n    return byte - 32 if byte >= 'a' and byte <= 'z' else byte\n\nfunc lower_byte(byte: u8) -> u8:\n    return byte + 32 if byte >= 'A' and byte <= 'Z' else byte\n\n## `capitalize()`: the first scalar upper case, the rest lower (ASCII letters, as `upper`).\npub func capitalize(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        out[i] = upper_byte(byte) if i == 0 else lower_byte(byte)\n        i += 1\n    return t\n\n## `title()`: each word's first letter upper case and the rest lower, a word a run of\n## letters, any scalar past ASCII counting as one (it is left as it is).\npub func title(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var in_word = false\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        if ascii_letter(byte):\n            out[i] = lower_byte(byte) if in_word else upper_byte(byte)\n            in_word = true\n        else:\n            out[i] = byte\n            in_word = byte >= 0x80\n        i += 1\n    return t\n\n## `is_digit()`, `is_alpha()`, `is_alnum()`, `is_space()`: every scalar in the ASCII class,\n## and at least one.\npub func is_digit(text: Text*) -> bool:\n    return every_byte(text, 0)\n\npub func is_alpha(text: Text*) -> bool:\n    return every_byte(text, 1)\n\npub func is_alnum(text: Text*) -> bool:\n    return every_byte(text, 2)\n\npub func is_space(text: Text*) -> bool:\n    return every_byte(text, 3)\n\nfunc every_byte(text: Text*, class: u8) -> bool:\n    if text.data.length == 0:\n        return false\n    for byte in text.data.bytes:\n        let digit = byte >= '0' and byte <= '9'\n        let fits = digit if class == 0 else ascii_letter(byte) if class == 1 else digit or ascii_letter(byte) if class == 2 else is_white(byte)\n        if not fits:\n            return false\n    return true\n\n## `reversed()`: the scalars in reverse order.\npub func reversed(text: Text*) -> Text*:\n    let b = text.data.bytes\n    let t = text_room(b.length)\n    let out = text_bytes(t)\n    var at = b.length\n    var i: usize = 0\n    while i < b.length:\n        var n: usize = 1\n        while i + n < b.length and (b[i + n] & 0xC0) == 0x80:\n            n += 1\n        at -= n\n        memory.copy(out[at..], b[i..<i + n], n)\n        i += n\n    return t\n\n## `characters()`: each scalar as a text of its own, in order.\npub func characters(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    let out = list_new[Text*](info, ops)\n    var scalars = Scalars.over(text)\n    while let one = scalars.next():\n        list_push[Text*](out, one)\n    return out\n\npub func text_to_bytes(t: Text*) -> Bytes*:\n    return bytes_of(t.data.bytes)\n\n## `bytes.text()`: the bytes as text when they are UTF-8 (§11.4).\npub func decode_text(data: Bytes*) -> Text*!:\n    if not valid_utf8(data.data):\n        error(luce_failure, \"invalid UTF-8\")\n    return text_of((str)data.data)\n\nfunc valid_utf8(b: const u8[]) -> bool:\n    var i: usize = 0\n    while i < b.length:\n        let lead = b[i]\n        var n: usize = 0\n        if lead < 0x80:\n            n = 0\n        elif lead >= 0xC2 and lead <= 0xDF:\n            n = 1\n        elif lead >= 0xE0 and lead <= 0xEF:\n            n = 2\n        elif lead >= 0xF0 and lead <= 0xF4:\n            n = 3\n        else:\n            return false\n        var k: usize = 1\n        while k <= n:\n            if i + k >= b.length or (b[i + k] & 0xC0) != 0x80:\n                return false\n            k += 1\n        if n == 2 and lead == 0xE0 and b[i + 1] < 0xA0:\n            return false\n        if n == 2 and lead == 0xED and b[i + 1] >= 0xA0:\n            return false\n        if n == 3 and lead == 0xF0 and b[i + 1] < 0x90:\n            return false\n        if n == 3 and lead == 0xF4 and b[i + 1] >= 0x90:\n            return false\n        i += n + 1\n    return true\n\npub func concat_bytes(a: Bytes*, b: Bytes*) -> Bytes*:\n    let out = (Bytes*)heap.allocate_sized(&bytes_info, memory.size_of(Bytes) + a.data.length + b.data.length)\n    let store = u8[]((u8*)out + memory.size_of(Bytes), a.data.length + b.data.length)\n    memory.copy(store, a.data, a.data.length)\n    memory.copy(store[a.data.length..], b.data, b.data.length)\n    out.data = store\n    return out\n\n## The pieces joined, then each let go of: what a generated display builds from.\npub func join_owned(pieces: const (Text*)[]) -> Text*:\n    let out = join(pieces)\n    for p in pieces:\n        heap.release((heap.Object*)p)\n    return out\n",
    "#==============================================================================================\n#\n#   number_text - Numbers as text: Luce's fields, `math.round`, `int(text, base)`\n#\n#   DESCRIPTION:\n#       What a formatted string's `{value:spec}` field, `math.round(x, digits)` and\n#       `int(text, base)` do (luce.md §3.3, §6.5, §6.8), as Python does them. The format\n#       mini-language and the exact decimal digits of a float are Base's standard\n#       `numerals`, the one implementation, which Luce Base's own fields use too: this\n#       module words a misfit in Luce's terms, lays a field out into a text of its own, and\n#       reads a rounded decimal back as a float. Both executions run it: the interpreter\n#       imports it, and the emitted program carries it beside the kernel\n#       (tools/embed_runtime.py), so a field prints the same bytes in both. Every text it\n#       returns is the caller's, given back with `strings.release`. It traps only when memory\n#       runs out; the rules a Luce program can break, a scalar out of range or a base out of\n#       range, its callers check.\n#\n#==============================================================================================\n\nimport memory\nimport numerals\nimport strings\n\n# mark: Specifications =========================================================================\n\n## What is wrong with `spec` for a value of `category`, in Luce's terms: empty when it fits\n## (§3.3).\npub func misfit(spec: numerals.Spec, category: numerals.Category) -> str:\n    match numerals.misfit_of(spec, category):\n        .fits:\n            return \"\"\n        .float_type_of_integer:\n            return \"its type letter formats a `float`; convert the `int` with `float(...)` first\"\n        .integer_type:\n            return \"an `int` is formatted with `d`, `b`, `o`, `x`, `X` or `c`\"\n        .integer_precision:\n            return \"an `int` takes no precision\"\n        .integer_z, .text_z:\n            return \"`z` belongs to a `float`\"\n        .scalar_sign:\n            return \"`c` takes no sign\"\n        .scalar_alternate:\n            return \"`c` takes no `#`\"\n        .comma_grouping:\n            return \"`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`\"\n        .scalar_grouping:\n            return \"`c` takes no grouping\"\n        .float_type:\n            return \"a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`\"\n        .text_type:\n            return \"this value shows its display, so its only type is `s`\"\n        .text_sign:\n            return \"a sign belongs to a number\"\n        .text_alternate:\n            return \"`#` belongs to a number\"\n        .text_after_sign:\n            return \"`=` aligns a number after its sign\"\n        .text_grouping:\n            return \"grouping belongs to a number\"\n\n# mark: Fields =================================================================================\n\n## Text being made, which `numerals` writes into: memory running out traps. Bytes grown by\n## hand, since the runtime of every Luce program carries this module and no package.\nstruct Out:\n    var data: u8[]\n    var used: usize\n\n    static func make() -> Out:\n        let data = new u8[32] --- catch failure:\n            trap(\"out of memory\")\n        return Out(data = data, used = 0)\n\n    ## Where `numerals` lays a field out: this text.\n    func sink() -> numerals.Sink:\n        return numerals.Sink(context = (void*)&self, write = append)\n\n    func put(text: str):\n        if text.length > self.data.length - self.used:\n            let wanted = self.used + text.length\n            self.data = memory.grow(self.data, wanted if wanted > self.data.length * 2 else self.data.length * 2) catch failure:\n                trap(\"out of memory\")\n        memory.copy(self.data[self.used..], text.bytes, text.length)\n        self.used += text.length\n\n    ## The text made, as an owned copy; the bytes are given back.\n    func finish() -> str:\n        let out = strings.copy((str)self.data[..<self.used]) catch failure:\n            trap(\"out of memory\")\n        free(self.data)\n        return out\n\n## A `numerals.Sink`'s write into the `Out` at `context`.\nfunc append(context: void*, bytes: const u8[]) -> bool:\n    let out = (Out*)context\n    out.put((str)bytes)\n    return true\n\n## An `int` field `{value:spec}`; none when `c` meets a value that is no Unicode scalar.\npub func format_int(value: i64, text: str) -> str?:\n    let negative = value < 0\n    let magnitude = 0 -% (u64)value if negative else (u64)value\n    if numerals.read(text).spec.kind == 'c' and not numerals.is_scalar(negative, magnitude):\n        return none\n    var out = Out.make()\n    _ = numerals.lay_integer(out.sink(), negative, magnitude, text)\n    return out.finish()\n\n## A `float` field `{value:spec}`. With neither a type nor a precision it shows the value's\n## display (§3.3), where Python would show its repr.\npub func format_float(value: f64, text: str) -> str:\n    var out = Out.make()\n    _ = numerals.lay_float(out.sink(), value, false, text)\n    return out.finish()\n\n## A field of any other value, given its display: precision keeps that many scalars, and\n## the width pads it (CPython's format_string_internal).\npub func format_text(shown: str, text: str) -> str:\n    var out = Out.make()\n    _ = numerals.lay_text(out.sink(), shown, text)\n    return out.finish()\n\n# mark: Scalars ================================================================================\n\n## `text.from_code(n)` (§6.8): the text of one scalar, the caller's own; none when `n` is no\n## Unicode scalar, below zero, a surrogate, or past U+10FFFF.\npub func character(code: i64) -> str?:\n    if not numerals.is_scalar(code < 0, 0 -% (u64)code if code < 0 else (u64)code):\n        return none\n    var buffer: u8[4]\n    let text = strings.copy((str)numerals.encode_scalar((u32)code, buffer)) catch failure:\n        trap(\"out of memory\")\n    return text\n\n## `text.code_of(s)` (§6.8) of a text of one scalar: the scalar's value.\npub func scalar_value(text: str) -> i64:\n    let b = text.bytes\n    let lead = (i64)b[0]\n    if lead < 0x80:\n        return lead\n    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)\n    var i: usize = 1\n    while i < b.length:\n        value = value * 64 + ((i64)b[i] & 0x3F)\n        i += 1\n    return value\n\n## `time.sleep(seconds)` as whole milliseconds, rounded up so the sleep is never shorter\n## than asked, for Base's `thread.sleep`; none for a negative count or NaN (§6.8).\npub func sleep_milliseconds(seconds: f64) -> u64?:\n    if not (seconds >= 0.0):\n        return none\n    let wanted = seconds * 1000.0\n    if wanted >= 18446744073709549568.0:\n        return 18446744073709549568\n    let whole = (u64)wanted\n    return whole + 1 if (f64)whole < wanted else whole\n\n## `math.abs(x)` of a `float` (§6.8): its magnitude, `0.0` for either zero, NaN as it is.\npub func absolute(x: f64) -> f64:\n    if x < 0.0:\n        return -x\n    if x == 0.0:\n        return 0.0\n    return x\n\n# mark: Rounding and integers ==================================================================\n\n## `math.round(x, digits)` (§6.8) as CPython's double_round: the correctly rounded decimal with\n## `digits` after the point, half to even, read back as the nearest float. None when it\n## rounds past the largest float.\npub func round(x: f64, digits: i64) -> f64?:\n    if x != x or infinite(x) or digits > 323:\n        return x\n    if digits < -308:\n        return 0.0 * x\n    let d = numerals.decimal_places(x, digits)\n    let negative = x < 0.0 or (x == 0.0 and (x.bits() >> 63) != 0)\n    var out = Out.make()\n    if negative:\n        out.put(\"-\")\n    if d.count == 0:\n        out.put(\"0\")\n    else:\n        out.put((str)d.digits[..<d.count])\n    out.put(\"e\")\n    var buffer: u8[24]\n    out.put(strings.format_i64(d.point - (i64)d.count if d.count > 0 else 0, buffer) catch failure: recover \"0\")\n    let text = out.finish()\n    defer strings.release(text)\n    let rounded = strings.parse_f64(text) catch failure:\n        return none\n    if infinite(rounded):\n        return none\n    return rounded\n\n## Whether `x` is an infinity (a NaN is told apart by `x != x`).\nfunc infinite(x: f64) -> bool:\n    return x == x and ((x.bits() >> 52) & 0x7FF) == 0x7FF\n\nfunc is_white(c: u8) -> bool:\n    return c == ' ' or c == '\\t' or c == '\\n' or c == '\\r' or c == 11 or c == 12\n\nfunc digit_value(c: u8) -> i64:\n    if c >= '0' and c <= '9':\n        return (i64)(c - '0')\n    if c >= 'a' and c <= 'z':\n        return (i64)(c - 'a') + 10\n    if c >= 'A' and c <= 'Z':\n        return (i64)(c - 'A') + 10\n    return 99\n\n## `int(text, base)` (§6.5) as Python reads it, `base` from 2 to 36: white space around,\n## a sign, `0x`, `0o` or `0b` when it matches the base, and digits with single `_` between\n## them. None when the text is not such an integer or does not fit an `int`.\npub func parse_int(text: str, base: i64) -> i64?:\n    let b = text.bytes\n    var start: usize = 0\n    var end = b.length\n    while start < end and is_white(b[start]):\n        start += 1\n    while end > start and is_white(b[end - 1]):\n        end -= 1\n    var at = start\n    var negative = false\n    if at < end and (b[at] == '+' or b[at] == '-'):\n        negative = b[at] == '-'\n        at += 1\n    var underscore_ok = false\n    if at + 1 < end and b[at] == '0':\n        let p = b[at + 1]\n        if ((p == 'x' or p == 'X') and base == 16) or ((p == 'o' or p == 'O') and base == 8) or ((p == 'b' or p == 'B') and base == 2):\n            at += 2\n            underscore_ok = true\n    var value: i64 = 0\n    var digits = 0\n    var after_underscore = false\n    while at < end:\n        let c = b[at]\n        at += 1\n        if c == '_':\n            if after_underscore or not (digits > 0 or underscore_ok):\n                return none\n            after_underscore = true\n            continue\n        let v = digit_value(c)\n        if v >= base:\n            return none\n        after_underscore = false\n        digits += 1\n        let scaled = value *? base else return none\n        value = (scaled -? v if negative else scaled +? v) else return none\n    if digits == 0 or after_underscore:\n        return none\n    return value\n\n# mark: Tests ===================================================================================\n\ntest \"a misfit is worded in Luce's terms\":\n    assert(misfit(numerals.read(\"f\").spec, numerals.Category.integer) == \"its type letter formats a `float`; convert the `int` with `float(...)` first\")\n    assert(misfit(numerals.read(\"x\").spec, numerals.Category.floating) == \"a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`\")\n    assert(misfit(numerals.read(\"d\").spec, numerals.Category.text) == \"this value shows its display, so its only type is `s`\")\n    assert(misfit(numerals.read(\",x\").spec, numerals.Category.integer) == \"`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`\")\n    assert(misfit(numerals.read(\"_x\").spec, numerals.Category.integer) == \"\")\n    assert(misfit(numerals.read(\"+\").spec, numerals.Category.text) == \"a sign belongs to a number\")\n\ntest \"integers lay out as Python's format\":\n    let cases: str[12] = [\"d\", \"+d\", \"#x\", \"#X\", \"08b\", \"_b\", \",\", \"010,\", \"08,\", \"^9\", \"*<6\", \"=+8\"]\n    let wants: str[12] = [\"-1234\", \"-1234\", \"-0x4d2\", \"-0X4D2\", \"-10011010010\", \"-100_1101_0010\", \"-1,234\", \"-0,001,234\", \"-001,234\", \"  -1234  \", \"-1234*\", \"-   1234\"]\n    var i: usize = 0\n    while i < 12:\n        let got = format_int(-1234, cases[i]) else return\n        assert(got == wants[i])\n        strings.release(got)\n        i += 1\n    assert(format_int(0x110000, \"c\") == none)\n\ntest \"floats lay out as Python's format\":\n    let cases: str[14] = [\".2f\", \"e\", \".3g\", \"g\", \"%\", \"10.1f\", \"010.2f\", \",.2f\", \".0f\", \"#.0f\", \".3\", \"+.1E\", \"z.1f\", \"_\"]\n    let values: f64[14] = [3.14159, 12345.678, 0.000012345, 1e20, 0.25, -2.25, -2.25, 1234567.891, 2.5, 2.5, 1234.5, 1e-300, -0.04, 1234567.5]\n    let wants: str[14] = [\"3.14\", \"1.234568e+04\", \"1.23e-05\", \"1e+20\", \"25.000000%\", \"      -2.2\", \"-000002.25\", \"1,234,567.89\", \"2\", \"2.\", \"1.23e+03\", \"+1.0E-300\", \"0.0\", \"1_234_567.5\"]\n    var i: usize = 0\n    while i < 14:\n        let got = format_float(values[i], cases[i])\n        assert(got == wants[i])\n        strings.release(got)\n        i += 1\n\ntest \"round is correctly rounded half to even\":\n    assert(round(2.675, 2) == 2.67)\n    assert(round(0.125, 2) == 0.12)\n    assert(round(0.375, 2) == 0.38)\n    assert(round(2.5, 0) == 2.0)\n    assert(round(1234.5, -2) == 1200.0)\n    assert(round(-0.4, 0) == 0.0)\n    assert(round(1.7976931348623157e308, -308) == none)\n\ntest \"integers parse in a base as Python's int\":\n    assert(parse_int(\" 0x_ff \", 16) == 255)\n    assert(parse_int(\"-1_000\", 10) == -1000)\n    assert(parse_int(\"0b101\", 2) == 5)\n    assert(parse_int(\"0b101\", 16) == 45313)\n    assert(parse_int(\"1__0\", 10) == none)\n    assert(parse_int(\"_1\", 10) == none)\n    assert(parse_int(\"1_\", 10) == none)\n    assert(parse_int(\"z\", 36) == 35)\n    assert(parse_int(\"9223372036854775808\", 10) == none)\n    assert(parse_int(\"-9223372036854775808\", 10) == -9223372036854775807 - 1)\n\ntest \"scalars and magnitudes\":\n    let e = character(0xE9) else return\n    assert(e == \"é\" and scalar_value(e) == 0xE9)\n    strings.release(e)\n    assert(scalar_value(\"😀\") == 0x1F600)\n    assert(character(0xD800) == none)\n    assert(absolute(-0.0) == 0.0 and absolute(-2.5) == 2.5)\n"
]
