## How many runtime sources there are.
pub let count: usize = 7
## Each source's path under the runtime's directory, `kernel/ORDER` and the like.
pub let names: str[7] = ["kernel/ORDER", "kernel/builtins.lucb", "kernel/kernel.lucb", "kernel/lists.lucb", "kernel/maps.lucb", "kernel/text.lucb", "numerals.lucb"]
## Each source's text, in the order of `names`.
pub let sources: str[7] = [
    "kernel.lucb\ntext.lucb\nlists.lucb\nmaps.lucb\nbuiltins.lucb\n",
    "#==============================================================================================\n#\n#   kernel/builtins - Ranges and the built-in functions\n#\n#   DESCRIPTION:\n#       Ranges as values with a step and a direction (§6.6), and what the built-in functions\n#       of §2.4 need beyond Base: `abs`, `min`, `max`, `round`, `ord`, `chr`, `input`, and the\n#       fields of a formatted string with a specification (§3.3).\n#\n#==============================================================================================\n\n# mark: Ranges =================================================================================\n\npub struct Range:\n    pub var low: i64\n    pub var high: i64\n    pub var inclusive: bool\n\npub func range(low: i64, high: i64, inclusive: bool) -> Range:\n    return Range(low = low, high = high, inclusive = inclusive)\n\npub func in_range(i: i64, r: Range) -> bool:\n    return i >= r.low and (i <= r.high if r.inclusive else i < r.high)\n\npub func range_end(r: Range) -> i64:\n    return r.high + 1 if r.inclusive else r.high\n\npub func show_range(r: Range) -> Text*:\n    var buffer: u8[64]\n    let text = format(buffer, f\"{r.low}{\"..=\" if r.inclusive else \"..<\"}{r.high}\") catch failure:\n        heap.stop(\"a range that does not format\")\n    return text_of(text)\n",
    "#==============================================================================================\n#\n#   kernel - The runtime of the value language\n#\n#   DESCRIPTION:\n#       What an emitted Luce program calls that Base does not spell itself: Python's `//`,\n#       `%` and `**`, text made of pieces, the display of scalars, indexes and slices with\n#       Luce's bounds and traps, closures, tests, workers and the Base boundary. Its other\n#       fragments (ORDER) hold the text operations, the list, maps and sets, and ranges with\n#       the built-in functions. Dynamic values use the reference-counted heap. An allocation\n#       that cannot be met traps, as §12 says.\n#\n#==============================================================================================\n\nimport c\nimport io\nimport interop\nimport memory\nimport ownership as heap\nimport strings\nimport sync\nimport thread\n\nextern func c_pow as \"pow\"(x: f64, y: f64) -> f64\nextern func c_strtod as \"strtod\"(text: c.str, end: c.str*?) -> f64\n\npub let luce_failure: ErrorCode = ErrorCode.package(65535)\n\n# mark: Arithmetic =============================================================================\n\n## `a // b` as Python has it; a zero divisor and the one overflowing quotient stop the\n## program at the Luce statement, not here (§6.2, §12.4).\npub func floor_div(a: i64, b: i64) -> i64:\n    if b == 0:\n        heap.stop(\"division by zero\")\n    if b == -1 and a == -9223372036854775807 - 1:\n        heap.stop(\"integer overflow\")\n    let q = a // b\n    if (a % b != 0) and ((a < 0) != (b < 0)):\n        return q - 1\n    return q\n\npub func floor_mod(a: i64, b: i64) -> i64:\n    if b == 0:\n        heap.stop(\"division by zero\")\n    if b == -1:\n        return 0\n    let r = a % b\n    if r != 0 and ((r < 0) != (b < 0)):\n        return r + b\n    return r\n\npub func power(base: i64, exponent: i64) -> i64:\n    if exponent < 0:\n        heap.stop(\"a negative exponent needs a float base\")\n    var result: i64 = 1\n    var i: i64 = 0\n    while i < exponent:\n        result = result *? base else heap.stop(\"integer overflow\")\n        i += 1\n    return result\n\npub func floor_float(x: f64) -> f64:\n    let t = f64(i64(x))\n    return t - 1.0 if t > x else t\n\npub func ffloor_div(a: f64, b: f64) -> f64:\n    return floor_float(a / b)\n\npub func ffloor_mod(a: f64, b: f64) -> f64:\n    return a - floor_float(a / b) * b\n\npub func fpower(base: f64, exponent: f64) -> f64:\n    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:\n        var result = 1.0\n        var i: i64 = 0\n        while i < i64(exponent):\n            result = result * base\n            i += 1\n        return result\n    return c_pow(base, exponent)\n\npub func to_int(f: f64) -> i64:\n    return i64(f)\n\n# mark: Text and bytes =========================================================================\n\n## Room on the heap, or a trap: Luce's out of memory is not recoverable (§12).\npub func room(n: usize) -> u8[]:\n    let out = alloc u8[n if n > 0 else 1] catch failure:\n        heap.stop(\"out of memory\")\n    return out\n\n## A `str`: a counted object, its bytes right behind the header (RUNTIME). A literal is an\n## immortal `Text` the program declares, its `data` viewing the literal.\npub struct Text:\n    pub var header: heap.Object\n    pub var data: str\n\npub struct Bytes:\n    pub var header: heap.Object\n    pub var data: const u8[]\n\nfunc text_drop(o: heap.Object*):\n    discard(o)\n\nfunc text_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    discard(o)\n\n## `size` 0: the block's size is the text's own, the header plus its bytes.\npub var text_info: heap.Info = heap.Info(name = \"str\", size = 0, finish = none, drop = text_drop, trace = text_trace, acyclic = true)\npub var bytes_info: heap.Info = heap.Info(name = \"bytes\", size = 0, finish = none, drop = text_drop, trace = text_trace, acyclic = true)\n\n## Establish this application's managed runtime entry on the current thread.\npub func startup():\n    heap.enter()\n\n## A new text of `n` bytes, to be filled; the block is the header then the bytes.\nfunc text_room(n: usize) -> Text*:\n    let t = (Text*)heap.allocate_sized(&text_info, sizeof(Text) + n)\n    t.data = (str)u8[]((u8*)t + sizeof(Text), n)\n    return t\n\nfunc text_bytes(t: Text*) -> u8[]:\n    return u8[]((u8*)t + sizeof(Text), t.data.length)\n\npub func text_of(view: str) -> Text*:\n    let t = text_room(view.length)\n    memory.copy(text_bytes(t), view.bytes, view.length)\n    return t\n\npub func bytes_of(view: const u8[]) -> Bytes*:\n    let b = (Bytes*)heap.allocate_sized(&bytes_info, sizeof(Bytes) + view.length)\n    let store = u8[]((u8*)b + sizeof(Bytes), view.length)\n    memory.copy(store, view, view.length)\n    b.data = store\n    return b\n\n## Luce errors own their text, including when saved beyond a catch or sent to a worker.\npub struct Failure:\n    pub var code: ErrorCode\n    pub var message: Text*\n\nstruct RaisedMessage:\n    var text: Text*\n    var next: RaisedMessage*?\n\nlocal var raised_messages: RaisedMessage*?\n\n## Base propagates a borrowed view. Hold a reference until the Luce catch takes it.\n## A chain preserves an outer failure while cleanup catches a nested failure.\npub func message_of(t: Text*) -> str:\n    let entry = (RaisedMessage*)room(sizeof(RaisedMessage)).data\n    entry.text = (Text*)heap.retain((heap.Object*)t)\n    entry.next = raised_messages\n    raised_messages = entry\n    return t.data\n\n## Raise an owned Luce message through Base's unchanged borrowed-error ABI.\npub func fail(code: ErrorCode, message: Text*) -> never!:\n    error(code, message_of(message))\n\npub func catch_failure(code: ErrorCode, message: str) -> Failure:\n    var link = &raised_messages\n    while let entry = *link:\n        if entry.text.data.bytes.data == message.bytes.data and entry.text.data.length == message.length:\n            let text = entry.text\n            *link = entry.next\n            free(u8[]((u8*)entry, sizeof(RaisedMessage)))\n            return Failure(code, text)\n        link = &entry.next\n    # Base and runtime failures can carry static or borrowed views: own a copy.\n    return Failure(code, text_of(message))\n\n## Transfer managed failure text into an explicit native outcome. Base can handle\n## and release it without returning through a Luce catch or a pending-message cache.\npub func native_failure[T](code: ErrorCode, message: str) -> interop.Outcome[T]:\n    let failure = catch_failure(code, message)\n    return interop.Outcome[T].failure(failure.code,\n        interop.Owned[str](failure.message.data, (heap.Object*)failure.message))\n\npub func copy_failure(v: Failure) -> Failure:\n    return Failure(v.code, (Text*)heap.retain((heap.Object*)v.message))\n\npub func drop_failure(v: Failure):\n    if (usize)v.message != 0:\n        heap.release((heap.Object*)v.message)\n\npub func send_failure(v: Failure) -> Failure:\n    return Failure(v.code, text_of(v.message.data))\n\npub func concat(a: Text*, b: Text*) -> Text*:\n    let t = text_room(a.data.length + b.data.length)\n    let out = text_bytes(t)\n    memory.copy(out, a.data.bytes, a.data.length)\n    memory.copy(out[a.data.length..], b.data.bytes, b.data.length)\n    return t\n\n## The pieces of a formatted text, joined.\npub func join(pieces: const (Text*)[]) -> Text*:\n    var n: usize = 0\n    for p in pieces:\n        n += p.data.length\n    let t = text_room(n)\n    let out = text_bytes(t)\n    var at: usize = 0\n    for p in pieces:\n        memory.copy(out[at..], p.data.bytes, p.data.length)\n        at += p.data.length\n    return t\n\npub func text_equal(a: Text*, b: Text*) -> bool:\n    return a.data == b.data\n\npub func bytes_equal(a: Bytes*, b: Bytes*) -> bool:\n    return compare_bytes(a.data, b.data) == 0\n\npub func show_int(i: i64) -> Text*:\n    var buffer: u8[32]\n    let text = format(buffer, f\"{i}\") catch failure:\n        heap.stop(\"a number that does not format\")\n    return text_of(text)\n\npub func show_float(f: f64) -> Text*:\n    var buffer: u8[64]\n    let text = format(buffer, f\"{f}\") catch failure:\n        heap.stop(\"a number that does not format\")\n    return text_of(text)\n\npub func show_bool(b: bool) -> Text*:\n    return text_of(\"true\" if b else \"false\")\n\n## A text's display is itself, held once more: every display is the caller's own.\npub func show_text(t: Text*) -> Text*:\n    return (Text*)heap.retain((heap.Object*)t)\n\npub func show_bytes(b: Bytes*) -> Text*:\n    let data = b.data\n    let t = text_room(3 + data.length * 4)\n    let out = text_bytes(t)\n    out[0] = 'b'\n    out[1] = '\"'\n    var at: usize = 2\n    for byte in data:\n        out[at] = '\\\\'\n        out[at + 1] = 'x'\n        out[at + 2] = hex_digit(byte >> 4)\n        out[at + 3] = hex_digit(byte & 15)\n        at += 4\n    out[at] = '\"'\n    return t\n\nfunc hex_digit(n: u8) -> u8:\n    return '0' + n if n < 10 else 'a' + (n - 10)\n\npub func print_line(t: Text*):\n    var out = io.stdout()\n    discard(out.write(t.data.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func compare_text(a: Text*, b: Text*) -> i64:\n    return compare_bytes(a.data.bytes, b.data.bytes)\n\npub func compare_bytes(a: const u8[], b: const u8[]) -> i64:\n    var i: usize = 0\n    while i < a.length and i < b.length:\n        if a[i] != b[i]:\n            return -1 if a[i] < b[i] else 1\n        i += 1\n    if a.length == b.length:\n        return 0\n    return -1 if a.length < b.length else 1\n\npub func compare_blobs(a: Bytes*, b: Bytes*) -> i64:\n    return compare_bytes(a.data, b.data)\n\npub func contains(text: Text*, needle: Text*) -> bool:\n    return find_bytes(text.data.bytes, needle.data.bytes, 0) != none\n\n## The scalars of a text (§11.3).\npub func scalar_length(t: Text*) -> i64:\n    var n: i64 = 0\n    for b in t.data.bytes:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\n## `text[low..<high]` by scalar index (§11.3), a new text; out of range traps.\npub func slice_text(t: Text*, low: i64, high: i64, whole: bool) -> Text*:\n    let b = t.data.bytes\n    let n = scalar_length(t)\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    var start: usize = b.length\n    var stop: usize = b.length\n    var scalar: i64 = 0\n    var i: usize = 0\n    if low == 0:\n        start = 0\n    while i < b.length:\n        if (b[i] & 0xC0) != 0x80:\n            if scalar == low:\n                start = i\n            if scalar == end:\n                stop = i\n                break\n            scalar += 1\n        i += 1\n    return text_of((str)b[start..<stop])\n\npub func slice_bytes(data: Bytes*, low: i64, high: i64, whole: bool) -> Bytes*:\n    let n = (i64)data.data.length\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    return bytes_of(data.data[(usize)low..<(usize)end])\n\npub func check_bounds(low: i64, high: i64, n: i64):\n    if low < 0 or high < low or high > n:\n        heap.stop(\"slice out of range\")\n\n## A Luce index into `count` elements: negative counts from the end; out of range traps.\npub func index(i: i64, count: usize) -> usize:\n    var k = i\n    if k < 0:\n        k += (i64)count\n    if k < 0 or k >= (i64)count:\n        heap.stop(\"index out of range\")\n    return (usize)k\n\npub func byte_at(data: Bytes*, i: i64) -> i64:\n    return (i64)data.data[index(i, data.data.length)]\n\npub func bytes_length(data: Bytes*) -> i64:\n    return (i64)data.data.length\n\n## The scalars of a text in order, each a new one-scalar text (§11.3).\npub struct Scalars:\n    var bytes: const u8[]\n    var at: usize\n\n    pub static func over(t: Text*) -> Scalars:\n        return Scalars(bytes = t.data.bytes, at = 0)\n\n    pub mutating func next() -> Text*?:\n        if self.at >= self.bytes.length:\n            return none\n        var n: usize = 1\n        while self.at + n < self.bytes.length and (self.bytes[self.at + n] & 0xC0) == 0x80:\n            n += 1\n        let out = text_of((str)self.bytes[self.at..<self.at + n])\n        self.at += n\n        return out\n\npub func parse_int(t: Text*) -> i64!:\n    let n = strings.parse_i64(strings.trim(t.data)) else error(luce_failure, \"not an integer\")\n    return n\n\n## Whether the text is a decimal number as §6.5 reads one: a sign, digits with an optional\n## fraction, an optional exponent, and nothing else; `strtod` alone reads more than that.\npub func is_decimal(text: str) -> bool:\n    let b = text.bytes\n    var i: usize = 0\n    if i < b.length and (b[i] == '+' or b[i] == '-'):\n        i += 1\n    var digits: usize = 0\n    while i < b.length and b[i] >= '0' and b[i] <= '9':\n        i += 1\n        digits += 1\n    if i < b.length and b[i] == '.':\n        i += 1\n        while i < b.length and b[i] >= '0' and b[i] <= '9':\n            i += 1\n            digits += 1\n    if digits == 0:\n        return false\n    if i < b.length and (b[i] == 'e' or b[i] == 'E'):\n        i += 1\n        if i < b.length and (b[i] == '+' or b[i] == '-'):\n            i += 1\n        var exponent: usize = 0\n        while i < b.length and b[i] >= '0' and b[i] <= '9':\n            i += 1\n            exponent += 1\n        if exponent == 0:\n            return false\n    return i == b.length\n\npub func parse_float(t: Text*) -> f64!:\n    let text = strings.trim(t.data)\n    if not is_decimal(text):\n        error(luce_failure, \"not a number\")\n    var buffer = room(text.length + 1)\n    memory.copy(buffer, text.bytes, text.length)\n    buffer[text.length] = 0\n    let value = c_strtod((c.str)buffer.data, none)\n    free(buffer)\n    return value\n\npub func parse_bool(t: Text*) -> bool!:\n    if t.data == \"true\":\n        return true\n    if t.data == \"false\":\n        return false\n    error(luce_failure, \"not a boolean\")\n\n# mark: Displays of collections =================================================================\n\n## Pieces of a display, each owned by the parts until they are joined and let go.\npub struct Parts:\n    pub var pieces: Text*[]\n    pub var count: usize\n\npub func parts() -> Parts:\n    let pieces = alloc Text*[8] catch failure:\n        heap.stop(\"out of memory\")\n    return Parts(pieces = pieces, count = 0)\n\npub func add_part(p: Parts*, piece: Text*):\n    if p.count == p.pieces.length:\n        let grown = alloc Text*[p.pieces.length * 2] catch failure:\n            heap.stop(\"out of memory\")\n        memory.copy(grown, p.pieces, p.count)\n        free(p.pieces)\n        p.pieces = grown\n    p.pieces[p.count] = piece\n    p.count += 1\n\n## `open`, the parts separated by \", \", `close`; the parts are released.\npub func bracketed(p: Parts, open: str, close: str) -> Text*:\n    var total = open.length + close.length\n    var i: usize = 0\n    while i < p.count:\n        total += p.pieces[i].data.length + (2 if i > 0 else 0)\n        i += 1\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at: usize = 0\n    memory.copy(out, open.bytes, open.length)\n    at += open.length\n    i = 0\n    while i < p.count:\n        if i > 0:\n            out[at] = ','\n            out[at + 1] = ' '\n            at += 2\n        memory.copy(out[at..], p.pieces[i].data.bytes, p.pieces[i].data.length)\n        at += p.pieces[i].data.length\n        heap.release((heap.Object*)p.pieces[i])\n        i += 1\n    memory.copy(out[at..], close.bytes, close.length)\n    free(p.pieces)\n    return t\n\n## `open`, then `key: value` pairs; the four texts of a pair are released.\npub func pair_part(p: Parts*, key: Text*, value: Text*):\n    let t = text_room(key.data.length + 2 + value.data.length)\n    let out = text_bytes(t)\n    memory.copy(out, key.data.bytes, key.data.length)\n    out[key.data.length] = ':'\n    out[key.data.length + 1] = ' '\n    memory.copy(out[key.data.length + 2..], value.data.bytes, value.data.length)\n    heap.release((heap.Object*)key)\n    heap.release((heap.Object*)value)\n    add_part(p, t)\n\n## A failure leaving `main`: reported the way the interpreter reports it.\npub func print_error(message: str):\n    var err = io.stderr()\n    discard(err.write(\"error: \".bytes) catch failure: recover 0)\n    discard(err.write(message.bytes) catch failure: recover 0)\n    discard(err.write(\"\\n\".bytes) catch failure: recover 0)\n\n\n# mark: Hashing =================================================================================\n\n## FNV-1a over 64 bits, the function docs/RUNTIME.md states; the emitted program feeds it\n## a value's canonical bytes through these.\npub let hash_offset: u64 = 14695981039346656037\n\npub func hash_bytes(h: u64, data: const u8[]) -> u64:\n    var out = h\n    for b in data:\n        out = (out ^ (u64)b) *% 1099511628211\n    return out\n\npub func hash_byte(h: u64, b: u8) -> u64:\n    return (h ^ (u64)b) *% 1099511628211\n\npub func hash_int(h: u64, i: i64) -> u64:\n    var out = h\n    var bits = (u64)i\n    var k: u32 = 0\n    while k < 8:\n        out = hash_byte(out, (u8)(bits & 255))\n        bits = bits >> 8\n        k += 1\n    return out\n\npub func hash_float(h: u64, f: f64) -> u64:\n    let normal = 0.0 if f == 0.0 else f\n    return hash_int(h, (i64)normal.bits())\n\npub func hash_bool(h: u64, b: bool) -> u64:\n    return hash_byte(h, 1 if b else 0)\n\n## Text and bytes end in 255, so that neighbouring texts keep their boundary.\npub func hash_text(h: u64, t: Text*) -> u64:\n    return hash_byte(hash_bytes(h, t.data.bytes), 255)\n\npub func hash_blob(h: u64, data: Bytes*) -> u64:\n    return hash_byte(hash_bytes(h, data.data), 255)\n\npub func hash_range(h: u64, r: Range) -> u64:\n    return hash_byte(hash_int(hash_int(h, r.low), r.high), 1 if r.inclusive else 0)\n\n# mark: Closures and cells (§7.4) ==============================================================\n\n## A function value: an object whose `code` is a function taking the object first, then\n## the parameters, and returning the result. A lambda's object goes on to hold what it\n## captured; a named function's is an immortal one with nothing more; a bound method's\n## holds its receiver. The emitted program declares those shapes, each with the header\n## and `code` first.\npub struct Closure:\n    pub var header: heap.Object\n    pub var code: void*\n    # Only named functions with crossable signatures have a context-free Base entry.\n    pub var base_code: void*\n\n## A widening adapter owns the original closure. The generated entry calls its\n## nonfallible ABI and returns success through the requested fallible ABI.\npub struct FallibleClosure:\n    pub var header: heap.Object\n    pub var code: void*\n    pub var base_code: void*\n    pub var inner: Closure*\n\nfunc fallible_closure_drop(owner: heap.Object*):\n    heap.release(&((FallibleClosure*)owner).inner.header)\n\nfunc fallible_closure_trace(owner: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    visit(&((FallibleClosure*)owner).inner.header, context)\n\nvar fallible_closure_info: heap.Info = heap.Info(name = \"fallible callback\", size = sizeof(FallibleClosure), finish = none, drop = fallible_closure_drop, trace = fallible_closure_trace)\n\n## Takes one owned reference, including when the callback captures a mutable cell.\npub func widen_function(inner: Closure*, code: void*) -> Closure*:\n    let owner = (FallibleClosure*)heap.allocate(&fallible_closure_info)\n    owner.code = code\n    owner.base_code = (void*)0\n    owner.inner = inner\n    return (Closure*)owner\n\npub func callback_code(f: Closure*) -> void*:\n    if (usize)f.base_code == 0:\n        heap.stop(\"a Base callback must be a named function with a crossable signature\")\n    return f.base_code\n\n## A captured `var`: one object holding the value, shared by the scope that declared it\n## and every closure that captured it (RUNTIME).\npub struct Cell[T]:\n    pub var header: heap.Object\n    pub var value: T\n    pub var ops: Ops[T]\n\npub func cell_new[T](info: heap.Info*, ops: Ops[T], value: T) -> Cell[T]*:\n    let cell = (Cell[T]*)heap.allocate(info)\n    cell.value = value\n    cell.ops = ops\n    return cell\n\n## `x = v` on a captured `var`: the cell takes the value and lets the old one go.\npub func cell_set[T](cell: Cell[T]*, value: T):\n    let old = cell.value\n    cell.value = value\n    if let f = cell.ops.drop:\n        f(old)\n\npub func cell_drop[T](o: heap.Object*):\n    let cell = (Cell[T]*)o\n    if let f = cell.ops.drop:\n        f(cell.value)\n\npub func cell_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let cell = (Cell[T]*)o\n    if let f = cell.ops.trace:\n        f(cell.value, visit, context)\n\n# mark: Tests (§17.3) =============================================================================\n\n## `ok    name`, `FAIL  name` with where and why, and the summary, as `luce test` prints them\n## in the interpreter and in a built runner alike.\npub func test_passed(name: str):\n    var out = io.stdout()\n    discard(out.write(\"ok    \".bytes) catch failure: recover 0)\n    discard(out.write(name.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func test_failed(name: str, at: str, message: str):\n    var out = io.stdout()\n    discard(out.write(\"FAIL  \".bytes) catch failure: recover 0)\n    discard(out.write(name.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n      \".bytes) catch failure: recover 0)\n    discard(out.write(at.bytes) catch failure: recover 0)\n    discard(out.write(\": \".bytes) catch failure: recover 0)\n    discard(out.write(message.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n\".bytes) catch failure: recover 0)\n\n## The count line, and the status: 1 when any test failed.\npub func test_summary(total: i64, failures: i64) -> i32:\n    var out = io.stdout()\n    var buffer: u8[64]\n    let count = format(buffer, f\"{total - failures} passed\\n\") catch failure: recover \"passed\\n\"\n    discard(out.write(count.bytes) catch failure: recover 0)\n    if failures > 0:\n        var second: u8[64]\n        let text = format(second, f\"{failures} failed\\n\") catch failure: recover \"failed\\n\"\n        discard(out.write(text.bytes) catch failure: recover 0)\n        return 1\n    return 0\n\n# mark: Workers (§14) ============================================================================\n\n## A task: a worker running one call. The object is the spawner's; the worker only reads\n## it. The protocol (RUNTIME): the worker copies the arguments onto its own heap and\n## signals `copied`, so the spawner goes on; it runs the call, keeps the result, and\n## signals `done`; the waiter copies the result onto its heap and signals `taken`; the\n## worker releases what it holds, proves its heap empty, and ends.\npub struct Task:\n    pub var header: heap.Object\n    pub var handle: thread.Handle\n    pub var copied: sync.Semaphore\n    pub var done: sync.Semaphore\n    pub var taken: sync.Semaphore\n    pub var run: func(Task*) -> unit\n    pub var cleanup: func(Task*) -> unit\n    pub var joined: bool\n    pub var waited: bool\n    pub var failed: bool\n    pub var code: ErrorCode\n    pub var message: Text*\n\n## A task whose call answers an `R`: the result lies after the task, where `wait` reads it.\npub struct TaskOf[R]:\n    pub var task: Task\n    pub var result: R\n\n## Starts the worker and returns once it has copied the arguments.\npub func task_start(t: Task*, run: func(Task*) -> unit, cleanup: func(Task*) -> unit):\n    t.run = run\n    t.cleanup = cleanup\n    t.handle = thread.spawn(worker, (void*?)t) catch failure:\n        heap.stop(\"a worker could not be started\")\n    t.copied.acquire()\n\nfunc worker(context: void*?):\n    let raw = context else heap.stop(\"a worker without its task\")\n    let t = (Task*)raw\n    startup()\n    t.run(t)\n    t.done.release()\n    t.taken.acquire()\n    t.cleanup(t)\n    if t.failed:\n        heap.release((heap.Object*)t.message)\n    heap.finish_task()\n\n## The worker's word that the arguments are its own now.\npub func task_copied(t: Task*):\n    t.copied.release()\n\n## The worker's failure, kept for the waiter.\npub func task_failed(t: Task*, code: ErrorCode, message: str):\n    t.failed = true\n    t.code = code\n    t.message = catch_failure(code, message).message\n\n## Waits for the worker's result; a task is waited once (RUNTIME).\npub func task_join(t: Task*):\n    if t.waited:\n        heap.stop(\"the task was waited already\")\n    t.waited = true\n    if not t.joined:\n        t.done.acquire()\n        t.joined = true\n\n## The waiter has what it needs: the worker may release its own and end.\npub func task_finish(t: Task*):\n    t.taken.release()\n    t.handle.join() catch failure:\n        heap.stop(\"a worker could not be joined\")\n\n## A task let go of without a wait (§14): its result is discarded once the worker is done.\npub func task_abandon(t: Task*):\n    if not t.joined:\n        t.done.acquire()\n        t.joined = true\n        task_finish(t)\n    elif not t.waited:\n        task_finish(t)\n\n# mark: The Base boundary (§16) ================================================================\n\n## A Luce text lent to Base as its view; the text outlives the call.\npub func text_view(t: Text*) -> str:\n    return t.data\n\npub func bytes_view(b: Bytes*) -> const u8[]:\n    return b.data\n\n## A list of crossable values lent to Base as a span over its elements; Base never keeps it.\npub func list_span[T](l: List[T]*) -> const T[]:\n    return l.items[..<l.count]\n\n## Rebase a field in a fresh native value copy. Public immutable fields may hold\n## borrowed projections too; only the emitter's private copy is writable here.\npub func rebase_field[T](destination: const T*, value: T):\n    *(T*)destination = value\n\n## Temporary converted arguments at the Base boundary. Keep the allocator with\n## the buffer, and attach its lifetime to the shim's ordinary temporaries pool.\nstruct BoundaryBuffer:\n    var header: heap.Object\n    var bytes: u8[]\n    var allocator: memory.Allocator\n\nvar boundary_buffer_info: heap.Info = heap.Info(name = \"Base argument buffer\", size = sizeof(BoundaryBuffer), finish = none, drop = boundary_buffer_drop, trace = text_trace)\n\nfunc boundary_buffer_drop(object: heap.Object*):\n    let buffer = (BoundaryBuffer*)object\n    buffer.allocator.release(buffer.bytes)\n\n## Call-local carrier storage; the enclosing boundary mark owns its allocation.\npub func boundary_span[T](count: usize) -> T[]:\n    let bytes = boundary_buffer((count if count > 0 else 1) * sizeof(T), alignof(T))\n    return T[]((T*)bytes.data, count)\n\npub func boundary_buffer(size: usize, alignment: usize) -> u8[]:\n    let buffer = (BoundaryBuffer*)heap.allocate(&boundary_buffer_info)\n    buffer.allocator = memory.allocator\n    buffer.bytes = buffer.allocator.allocate(size, alignment) else heap.stop(\"out of memory\")\n    discard(heap.pool_object((heap.Object*)buffer))\n    return buffer.bytes\n\n## A list of texts lent to Base as views: an object of the statement holds the views and\n## goes with the statement's temporaries (RUNTIME 5).\npub struct Views:\n    pub var header: heap.Object\n    pub var items: str[]\n\npub var views_info: heap.Info = heap.Info(name = \"views\", size = sizeof(Views), finish = none, drop = views_drop, trace = text_trace)\n\nfunc views_drop(o: heap.Object*):\n    let v = (Views*)o\n    if v.items.length > 0:\n        free(v.items)\n\npub func str_views(l: List[Text*]*) -> const str[]:\n    let v = (Views*)heap.allocate(&views_info)\n    v.items = alloc str[l.count if l.count > 0 else 1] catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < l.count:\n        v.items[i] = l.items[i].data\n        i += 1\n    discard(heap.pool_object((heap.Object*)v))\n    return v.items[..<l.count]\n\n## A text lent to a Base `c.str` (§16.2): a copy ending in a zero byte, pooled so that it\n## lives until the end of the statement making the call. A text holding a zero byte has no C\n## spelling and traps.\npub func c_text(t: Text*) -> c.str:\n    let n = t.data.length\n    for byte in t.data.bytes:\n        if byte == 0:\n            heap.stop(\"a text holding a zero byte was given to Base as C text\")\n    let b = (Bytes*)heap.allocate_sized(&bytes_info, sizeof(Bytes) + n + 1)\n    let store = u8[]((u8*)b + sizeof(Bytes), n + 1)\n    memory.copy(store, t.data.bytes, n)\n    store[n] = 0\n    b.data = store[..<n]\n    discard(heap.pool_object((heap.Object*)b))\n    return (c.str)(str)store\n\n## A Base `c.str` result, copied into a Luce text; C text that is not UTF-8 traps.\npub func text_of_c(s: c.str) -> Text*:\n    let view = str(s) catch failure:\n        heap.stop(\"C text from Base is not UTF-8\")\n    return text_of(view)\n\n## A Base `usize` is an `int` in Luce; a value past `int` traps at the crossing (§16.2).\npub func int_of_usize(n: usize) -> i64:\n    if n > 9223372036854775807:\n        heap.stop(\"a size from Base does not fit an int\")\n    return (i64)n\n\n## An `int` handed to a Base `usize` is not negative (§16.2).\npub func usize_of_int(n: i64) -> usize:\n    if n < 0:\n        heap.stop(\"a negative int was given to Base as a size\")\n    return (usize)n\n\n## An `int` handed to a narrower Base integer is in that type's range (§16.2).\npub func i8_of_int(n: i64) -> i8:\n    if n < -128 or n > 127:\n        heap.stop(\"an int outside i8's range was given to Base\")\n    return (i8)n\n\npub func i16_of_int(n: i64) -> i16:\n    if n < -32768 or n > 32767:\n        heap.stop(\"an int outside i16's range was given to Base\")\n    return (i16)n\n\npub func i32_of_int(n: i64) -> i32:\n    if n < -2147483648 or n > 2147483647:\n        heap.stop(\"an int outside i32's range was given to Base\")\n    return (i32)n\n\npub func isize_of_int(n: i64) -> isize:\n    return (isize)n\n\npub func u8_of_int(n: i64) -> u8:\n    if n < 0 or n > 255:\n        heap.stop(\"an int outside u8's range was given to Base\")\n    return (u8)n\n\npub func u16_of_int(n: i64) -> u16:\n    if n < 0 or n > 65535:\n        heap.stop(\"an int outside u16's range was given to Base\")\n    return (u16)n\n\npub func u32_of_int(n: i64) -> u32:\n    if n < 0 or n > 4294967295:\n        heap.stop(\"an int outside u32's range was given to Base\")\n    return (u32)n\n\npub func u64_of_int(n: i64) -> u64:\n    if n < 0:\n        heap.stop(\"a negative int was given to Base as a u64\")\n    return (u64)n\n\npub func int_of_u64(n: u64) -> i64:\n    if n > 9223372036854775807:\n        heap.stop(\"a u64 from Base does not fit an int\")\n    return (i64)n\n\n## The descriptor of a named function's closure, which holds nothing beyond its code.\npub var closure_info: heap.Info = heap.Info(name = \"func\", size = sizeof(Closure), finish = none, drop = text_drop, trace = text_trace)\n\ntest \"raising retains a counted text and catching transfers its reference\":\n    with memory.heap:\n        startup()\n        let text = text_of(\"dynamic error\")\n        let view = message_of(text)\n        assert((text.header.flags & heap.immortal) == 0)\n        assert(text.header.strong == 2)\n        heap.release((heap.Object*)text)\n        let failure = catch_failure(luce_failure, view)\n        assert(raised_messages == none)\n        assert(failure.message.header.strong == 1)\n        let copy = copy_failure(failure)\n        drop_failure(failure)\n        assert(copy.message.data == \"dynamic error\")\n        drop_failure(copy)\n        assert(heap.finish_run(0) == 0)\n\ntest \"a nested catch preserves a message still propagating\":\n    with memory.heap:\n        startup()\n        let outer = text_of(\"outer\")\n        let outer_view = message_of(outer)\n        heap.release((heap.Object*)outer)\n        let inner = text_of(\"inner\")\n        let inner_view = message_of(inner)\n        heap.release((heap.Object*)inner)\n        drop_failure(catch_failure(luce_failure, inner_view))\n        let failure = catch_failure(luce_failure, outer_view)\n        assert(failure.message.data == \"outer\")\n        drop_failure(failure)\n        assert(raised_messages == none)\n        assert(heap.finish_run(0) == 0)\n",
    "#==============================================================================================\n#\n#   kernel/lists - The list (§11.1)\n#\n#   DESCRIPTION:\n#       `list[T]`: its storage and every operation of §11.1, its elements' copies, drops and\n#       comparisons through the `Ops` the emitted program hands it.\n#\n#==============================================================================================\n\n# mark: Lists =================================================================================\n\n## What a collection needs of its element type; `none` where the type does not have it.\npub struct Ops[T]:\n    pub var copy: (func(T) -> T)?\n    pub var drop: (func(T) -> unit)?\n    pub var trace: (func(T, func(heap.Object*, void*) -> unit, void*) -> unit)?\n    pub var equal: (func(T, T) -> bool)?\n    pub var compare: (func(T, T) -> i64)?\n    pub var hashed: (func(T) -> u64)?\n\n## `list[T]` (§11.1): an object the collector traces, its elements owned, `version`\n## counting the structural changes a running `for` must not see.\npub struct List[T]:\n    pub var header: heap.Object\n    pub var items: T[]\n    pub var count: usize\n    pub var version: u64\n    pub var ops: Ops[T]\n\npub func list_new[T](info: heap.Info*, ops: Ops[T]) -> List[T]*:\n    let l = (List[T]*)heap.allocate(info)\n    l.items = alloc T[4] catch failure:\n        heap.stop(\"out of memory\")\n    l.count = 0\n    l.version = 0\n    l.ops = ops\n    return l\n\n## A literal: the elements are owned already.\npub func list_of[T](info: heap.Info*, ops: Ops[T], elements: const T[]) -> List[T]*:\n    let l = list_new[T](info, ops)\n    for e in elements:\n        list_push[T](l, e)\n    return l\n\nfunc list_room[T](l: List[T]*, n: usize):\n    if n <= l.items.length:\n        return\n    var size = l.items.length * 2\n    while size < n:\n        size = size * 2\n    let grown = alloc T[size] catch failure:\n        heap.stop(\"out of memory\")\n    memory.copy(grown, l.items, l.count)\n    free(l.items)\n    l.items = grown\n\nfunc list_push[T](l: List[T]*, item: T):\n    list_room[T](l, l.count + 1)\n    l.items[l.count] = item\n    l.count += 1\n\nfunc elem_copy[T](l: List[T]*, v: T) -> T:\n    if let f = l.ops.copy:\n        return f(v)\n    return v\n\nfunc elem_drop[T](l: List[T]*, v: T):\n    if let f = l.ops.drop:\n        f(v)\n\n## `append(x)`: the list takes the value.\npub func list_append[T](l: List[T]*, item: T):\n    list_push[T](l, item)\n    l.version += 1\n\npub func list_insert[T](l: List[T]*, i: i64, item: T):\n    if i < 0 or i > (i64)l.count:\n        heap.stop(\"index out of range\")\n    list_room[T](l, l.count + 1)\n    var k = l.count\n    while k > (usize)i:\n        l.items[k] = l.items[k - 1]\n        k -= 1\n    l.items[(usize)i] = item\n    l.count += 1\n    l.version += 1\n\n## `remove_at(i)`: the element, owned by the caller.\npub func list_remove_at[T](l: List[T]*, i: i64) -> T:\n    let at = index(i, l.count)\n    let out = l.items[at]\n    var k = at\n    while k + 1 < l.count:\n        l.items[k] = l.items[k + 1]\n        k += 1\n    l.count -= 1\n    l.version += 1\n    return out\n\npub func list_pop[T](l: List[T]*) -> T:\n    if l.count == 0:\n        heap.stop(\"pop of an empty list\")\n    l.count -= 1\n    l.version += 1\n    return l.items[l.count]\n\n## `clear()`: the elements are let go of once the list no longer holds them. Letting one go\n## can run the cycle collector, whose walk must not find a released element in the list; a\n## `deinit` that appends to the list meanwhile writes to fresh storage.\npub func list_clear[T](l: List[T]*):\n    let n = l.count\n    l.count = 0\n    l.version += 1\n    let drop = l.ops.drop else return\n    if n == 0:\n        return\n    let items = l.items\n    l.items = alloc T[items.length] catch failure:\n        heap.stop(\"out of memory\")\n    var i: usize = 0\n    while i < n:\n        drop(items[i])\n        i += 1\n    free(items)\n\n## `values[i]`: a copy of the element, the caller's own.\npub func list_get[T](l: List[T]*, i: i64) -> T:\n    return elem_copy[T](l, l.items[index(i, l.count)])\n\n## `values[i].field = x`: the element's own slot, neither copied nor retained, so a store\n## through it changes the element in the list and takes no reference of its own.\npub func list_slot[T](l: List[T]*, i: i64) -> T*:\n    return &l.items[index(i, l.count)]\n\n## `values[i] = x`: the list takes the value and lets the old one go.\npub func list_set[T](l: List[T]*, i: i64, item: T):\n    let at = index(i, l.count)\n    let old = l.items[at]\n    l.items[at] = item\n    elem_drop[T](l, old)\n\npub func list_length[T](l: List[T]*) -> i64:\n    return (i64)l.count\n\npub func list_first[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[0])\n\npub func list_last[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[l.count - 1])\n\n## `values[a..<b]`: a new list of copies; bounds checked.\npub func list_slice[T](l: List[T]*, low: i64, high: i64, whole: bool) -> List[T]*:\n    let n = (i64)l.count\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    let out = list_new[T](l.header.info, l.ops)\n    var i = (usize)low\n    while i < (usize)end:\n        list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\npub func list_copy[T](l: List[T]*) -> List[T]*:\n    return list_slice[T](l, 0, 0, true)\n\n## `a + b`: a new list of both.\npub func list_concat[T](a: List[T]*, b: List[T]*) -> List[T]*:\n    let out = list_copy[T](a)\n    var i: usize = 0\n    while i < b.count:\n        list_push[T](out, elem_copy[T](b, b.items[i]))\n        i += 1\n    return out\n\nfunc elem_equal[T](l: List[T]*, a: T, b: T) -> bool:\n    if let f = l.ops.equal:\n        return f(a, b)\n    heap.stop(\"elements without equality\")\n\npub func list_contains[T](l: List[T]*, item: T) -> bool:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return true\n        i += 1\n    return false\n\npub func list_index_of[T](l: List[T]*, item: T) -> i64?:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return (i64)i\n        i += 1\n    return none\n\n## `==` on lists: the same length and equal elements in order (§4.4).\npub func list_equal[T](a: List[T]*, b: List[T]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if not elem_equal[T](a, a.items[i], b.items[i]):\n            return false\n        i += 1\n    return true\n\nfunc elem_compare[T](l: List[T]*, a: T, b: T) -> i64:\n    if let f = l.ops.compare:\n        return f(a, b)\n    heap.stop(\"elements without an ordering\")\n\n## `sort()`: in place, stable, by the elements' ordering; the same algorithm as the\n## interpreter's, an insertion sort, so equal elements keep their order in both.\npub func list_sort[T](l: List[T]*):\n    var i: usize = 1\n    while i < l.count:\n        let v = l.items[i]\n        var k = i\n        while k > 0 and elem_compare[T](l, l.items[k - 1], v) > 0:\n            l.items[k] = l.items[k - 1]\n            k -= 1\n        l.items[k] = v\n        i += 1\n    l.version += 1\n\npub func list_sorted[T](l: List[T]*) -> List[T]*:\n    let out = list_copy[T](l)\n    list_sort[T](out)\n    return out\n\npub func list_reverse[T](l: List[T]*):\n    var i: usize = 0\n    while i + 1 < l.count - i:\n        let tmp = l.items[i]\n        l.items[i] = l.items[l.count - 1 - i]\n        l.items[l.count - 1 - i] = tmp\n        i += 1\n    l.version += 1\n\npub func list_reversed[T](l: List[T]*) -> List[T]*:\n    let out = list_copy[T](l)\n    list_reverse[T](out)\n    return out\n\n## `map(f)`: a new list of `f` over each element, the results owned by it; `f` is a\n## closure, called by the convention every closure follows: its own object first.\npub func list_map[T, U](l: List[T]*, f: Closure*, info: heap.Info*, ops: Ops[U]) -> List[U]*:\n    let out = list_new[U](info, ops)\n    let code = (func(heap.Object*, T) -> U)f.code\n    var i: usize = 0\n    while i < l.count:\n        list_push[U](out, code((heap.Object*)f, l.items[i]))\n        i += 1\n    return out\n\npub func list_filter[T](l: List[T]*, f: Closure*) -> List[T]*:\n    let out = list_new[T](l.header.info, l.ops)\n    let code = (func(heap.Object*, T) -> bool)f.code\n    var i: usize = 0\n    while i < l.count:\n        if code((heap.Object*)f, l.items[i]):\n            list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\n## `join(separator)` on a `list[str]`.\npub func list_join(l: List[Text*]*, separator: Text*) -> Text*:\n    var total: usize = 0\n    var i: usize = 0\n    while i < l.count:\n        total += l.items[i].data.length\n        if i > 0:\n            total += separator.data.length\n        i += 1\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at: usize = 0\n    i = 0\n    while i < l.count:\n        if i > 0:\n            memory.copy(out[at..], separator.data.bytes, separator.data.length)\n            at += separator.data.length\n        memory.copy(out[at..], l.items[i].data.bytes, l.items[i].data.length)\n        at += l.items[i].data.length\n        i += 1\n    return t\n\n## A `for` over a list checks, at the start of every step, that nothing changed its shape.\npub func list_check[T](l: List[T]*, version: u64):\n    if l.version != version:\n        heap.stop(\"the list changed while it was iterated\")\n\n## The runtime's drop and trace of a list, through its descriptor.\npub func list_drop[T](o: heap.Object*):\n    let l = (List[T]*)o\n    var i: usize = 0\n    while i < l.count:\n        elem_drop[T](l, l.items[i])\n        i += 1\n    l.count = 0\n    free(l.items)\n\npub func list_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let l = (List[T]*)o\n    if let f = l.ops.trace:\n        var i: usize = 0\n        while i < l.count:\n            f(l.items[i], visit, context)\n            i += 1\n\npub func list_from_args(info: heap.Info*, ops: Ops[Text*], arguments: str[]) -> List[Text*]*:\n    let l = list_new[Text*](info, ops)\n    for a in arguments:\n        list_push[Text*](l, text_of(a))\n    return l\n\n",
    "#==============================================================================================\n#\n#   kernel/maps - Maps and sets (§11.2)\n#\n#   DESCRIPTION:\n#       `map[K, V]` and `set[T]`: insertion-ordered tables of entries and an index of their\n#       hashes, and every operation of §11.2.\n#\n#==============================================================================================\n\n# mark: Maps and sets ==========================================================================\n\n## `map[K, V]` and `set[T]` (§11.2): entries in insertion order in `keys` and `values`, an\n## open-addressed index from a key's hash to its entry, a removal closing the gap. A set\n## is a map to a byte.\npub struct Map[K, V]:\n    pub var header: heap.Object\n    pub var keys: K[]\n    pub var values: V[]\n    pub var hashes: u64[]\n    pub var count: usize\n    pub var version: u64\n    ## Entry index + 1 per slot; 0 is empty. Twice the capacity, a power of two.\n    pub var index: u32[]\n    pub var key_ops: Ops[K]\n    pub var value_ops: Ops[V]\n\npub func map_new[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V]) -> Map[K, V]*:\n    let m = (Map[K, V]*)heap.allocate(info)\n    m.keys = alloc K[4] catch failure:\n        heap.stop(\"out of memory\")\n    m.values = alloc V[4] catch failure:\n        heap.stop(\"out of memory\")\n    m.hashes = alloc u64[4] catch failure:\n        heap.stop(\"out of memory\")\n    m.index = alloc u32[8] catch failure:\n        heap.stop(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    m.count = 0\n    m.version = 0\n    m.key_ops = key_ops\n    m.value_ops = value_ops\n    return m\n\n## A literal: the keys and values are owned already; a repeated key keeps the last value.\npub func map_of[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V], keys: const K[], values: const V[]) -> Map[K, V]*:\n    let m = map_new[K, V](info, key_ops, value_ops)\n    var i: usize = 0\n    while i < keys.length:\n        map_set[K, V](m, keys[i], values[i])\n        i += 1\n    return m\n\nfunc key_hash[K, V](m: Map[K, V]*, key: K) -> u64:\n    if let f = m.key_ops.hashed:\n        return f(key)\n    heap.stop(\"keys without a hash\")\n\nfunc key_equal[K, V](m: Map[K, V]*, a: K, b: K) -> bool:\n    if let f = m.key_ops.equal:\n        return f(a, b)\n    heap.stop(\"keys without equality\")\n\nfunc key_copy[K, V](m: Map[K, V]*, k: K) -> K:\n    if let f = m.key_ops.copy:\n        return f(k)\n    return k\n\nfunc key_drop[K, V](m: Map[K, V]*, k: K):\n    if let f = m.key_ops.drop:\n        f(k)\n\nfunc value_copy[K, V](m: Map[K, V]*, v: V) -> V:\n    if let f = m.value_ops.copy:\n        return f(v)\n    return v\n\nfunc value_drop[K, V](m: Map[K, V]*, v: V):\n    if let f = m.value_ops.drop:\n        f(v)\n\n## The entry of `key`, or none.\nfunc map_find[K, V](m: Map[K, V]*, key: K, h: u64) -> usize?:\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        let entry = (usize)m.index[at] - 1\n        if m.hashes[entry] == h and key_equal[K, V](m, m.keys[entry], key):\n            return entry\n        at = (at + 1) & mask\n    return none\n\nfunc map_reindex[K, V](m: Map[K, V]*, slots: usize):\n    if m.index.length != slots:\n        free(m.index)\n        m.index = alloc u32[slots] catch failure:\n            heap.stop(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    let mask = slots - 1\n    var i: usize = 0\n    while i < m.count:\n        var at = (usize)m.hashes[i] & mask\n        while m.index[at] != 0:\n            at = (at + 1) & mask\n        m.index[at] = u32(i + 1)\n        i += 1\n\nfunc map_room[K, V](m: Map[K, V]*, n: usize):\n    if n <= m.keys.length:\n        return\n    var size = m.keys.length * 2\n    while size < n:\n        size = size * 2\n    let keys = alloc K[size] catch failure:\n        heap.stop(\"out of memory\")\n    let values = alloc V[size] catch failure:\n        heap.stop(\"out of memory\")\n    let hashes = alloc u64[size] catch failure:\n        heap.stop(\"out of memory\")\n    memory.copy(keys, m.keys, m.count)\n    memory.copy(values, m.values, m.count)\n    memory.copy(hashes, m.hashes, m.count)\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    m.keys = keys\n    m.values = values\n    m.hashes = hashes\n    map_reindex[K, V](m, size * 2)\n\n## `m[key] = value`: the map takes both; an existing key keeps its place and lets its old\n## value go, and the given key is let go of.\npub func map_set[K, V](m: Map[K, V]*, key: K, value: V):\n    let h = key_hash[K, V](m, key)\n    if let entry = map_find[K, V](m, key, h):\n        let old = m.values[entry]\n        m.values[entry] = value\n        value_drop[K, V](m, old)\n        key_drop[K, V](m, key)\n        return\n    map_room[K, V](m, m.count + 1)\n    m.keys[m.count] = key\n    m.values[m.count] = value\n    m.hashes[m.count] = h\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        at = (at + 1) & mask\n    m.index[at] = u32(m.count + 1)\n    m.count += 1\n    m.version += 1\n\n## `m[key]`: a copy of the value, or none.\npub func map_get[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    return value_copy[K, V](m, m.values[entry])\n\npub func map_contains[K, V](m: Map[K, V]*, key: K) -> bool:\n    return map_find[K, V](m, key, key_hash[K, V](m, key)) != none\n\n## `m.remove(key)`: the value, the caller's own, or none; the rest keep their order. The\n## stored key is let go of once the map no longer holds it (see `map_clear`).\npub func map_remove[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    let out = m.values[entry]\n    let stored = m.keys[entry]\n    var i = entry\n    while i + 1 < m.count:\n        m.keys[i] = m.keys[i + 1]\n        m.values[i] = m.values[i + 1]\n        m.hashes[i] = m.hashes[i + 1]\n        i += 1\n    m.count -= 1\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n    key_drop[K, V](m, stored)\n    return out\n\npub func map_length[K, V](m: Map[K, V]*) -> i64:\n    return (i64)m.count\n\n## `clear()`: the entries are let go of once the map no longer holds them. Letting one go\n## can run the cycle collector, whose walk must not find a released key or value in the\n## map; a `deinit` that sets an entry meanwhile writes to fresh storage.\npub func map_clear[K, V](m: Map[K, V]*):\n    let n = m.count\n    let owned = m.key_ops.drop != none or m.value_ops.drop != none\n    let keys = m.keys\n    let values = m.values\n    if n > 0 and owned:\n        m.keys = alloc K[keys.length] catch failure:\n            heap.stop(\"out of memory\")\n        m.values = alloc V[values.length] catch failure:\n            heap.stop(\"out of memory\")\n    m.count = 0\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n    if n == 0 or not owned:\n        return\n    var i: usize = 0\n    while i < n:\n        key_drop[K, V](m, keys[i])\n        value_drop[K, V](m, values[i])\n        i += 1\n    free(keys)\n    free(values)\n\npub func map_copy[K, V](m: Map[K, V]*) -> Map[K, V]*:\n    let out = map_new[K, V](m.header.info, m.key_ops, m.value_ops)\n    var i: usize = 0\n    while i < m.count:\n        map_set[K, V](out, key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `m.keys()`, `m.values()`: new lists of copies, in entry order.\npub func map_keys[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[K]) -> List[K]*:\n    let out = list_new[K](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[K](out, key_copy[K, V](m, m.keys[i]))\n        i += 1\n    return out\n\npub func map_values[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[V]) -> List[V]*:\n    let out = list_new[V](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[V](out, value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `==` on maps: the same keys, each with an equal value (§4.4).\npub func map_equal[K, V](a: Map[K, V]*, b: Map[K, V]*) -> bool:\n    if a.count != b.count:\n        return false\n    let f = a.value_ops.equal else heap.stop(\"values without equality\")\n    var i: usize = 0\n    while i < a.count:\n        let entry = map_find[K, V](b, a.keys[i], a.hashes[i]) else return false\n        if not f(a.values[i], b.values[entry]):\n            return false\n        i += 1\n    return true\n\npub func map_check[K, V](m: Map[K, V]*, version: u64):\n    if m.version != version:\n        heap.stop(\"the map changed while it was iterated\")\n\npub func map_drop[K, V](o: heap.Object*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        key_drop[K, V](m, m.keys[i])\n        value_drop[K, V](m, m.values[i])\n        i += 1\n    m.count = 0\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    free(m.index)\n\npub func map_trace[K, V](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        if let f = m.key_ops.trace:\n            f(m.keys[i], visit, context)\n        if let g = m.value_ops.trace:\n            g(m.values[i], visit, context)\n        i += 1\n\n## The hash of a map or a set as docs/RUNTIME.md states: entry hashes summed, wrapping.\npub func map_hash[K, V](m: Map[K, V]*) -> u64:\n    let f = m.value_ops.hashed else heap.stop(\"values without a hash\")\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% (m.hashes[i] *% 31 +% f(m.values[i]))\n        i += 1\n    return sum\n\n# -- sets, as maps to a byte -------------------------------------------------------------\n\npub func set_hash[K](m: Map[K, u8]*) -> u64:\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% m.hashes[i]\n        i += 1\n    return sum\n\nfunc byte_ops() -> Ops[u8]:\n    return Ops[u8](copy = none, drop = none, trace = none, equal = none, compare = none, hashed = none)\n\npub func set_of[K](info: heap.Info*, ops: Ops[K], elements: const K[]) -> Map[K, u8]*:\n    let s = map_new[K, u8](info, ops, byte_ops())\n    for e in elements:\n        set_insert[K](s, e)\n    return s\n\n## `s.insert(x)`: the set takes the value, or lets it go when it is there already.\npub func set_insert[K](s: Map[K, u8]*, key: K):\n    map_set[K, u8](s, key, 0)\n\npub func set_remove[K](s: Map[K, u8]*, key: K) -> bool:\n    return map_remove[K, u8](s, key) != none\n\npub func set_union[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_copy[K, u8](a)\n    var i: usize = 0\n    while i < b.count:\n        set_insert[K](out, key_copy[K, u8](b, b.keys[i]))\n        i += 1\n    return out\n\npub func set_intersection[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) != none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\npub func set_difference[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\n## `==` on sets: the same elements (§4.4).\npub func set_equal[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            return false\n        i += 1\n    return true\n\npub func set_new[K](info: heap.Info*, ops: Ops[K]) -> Map[K, u8]*:\n    return map_new[K, u8](info, ops, byte_ops())\n\n## `m.items()`: a new list of key, value pairs, copies, in entry order.\npub func map_items[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[(K, V)]) -> List[(K, V)]*:\n    let out = list_new[(K, V)](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[(K, V)](out, (key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i])))\n        i += 1\n    return out\n",
    "#==============================================================================================\n#\n#   kernel/text - Text operations (§11.3)\n#\n#   DESCRIPTION:\n#       The methods of `str` and `bytes`: searching, splitting, trimming, case, padding and\n#       the rest, each answering a text of its own.\n#\n#==============================================================================================\n\n# mark: Text operations (§11.3) ================================================================\n\nfunc find_bytes(haystack: const u8[], needle: const u8[], start: usize) -> usize?:\n    if needle.length == 0:\n        return start\n    var i = start\n    while i + needle.length <= haystack.length:\n        var k: usize = 0\n        while k < needle.length and haystack[i + k] == needle[k]:\n            k += 1\n        if k == needle.length:\n            return i\n        i += 1\n    return none\n\npub func starts_with(text: Text*, prefix: Text*) -> bool:\n    if prefix.data.length > text.data.length:\n        return false\n    return compare_bytes(text.data.bytes[..<prefix.data.length], prefix.data.bytes) == 0\n\npub func ends_with(text: Text*, suffix: Text*) -> bool:\n    if suffix.data.length > text.data.length:\n        return false\n    return compare_bytes(text.data.bytes[text.data.length - suffix.data.length..], suffix.data.bytes) == 0\n\n## The scalar index of the first occurrence, or none.\npub func index_of(text: Text*, needle: Text*) -> i64?:\n    let at = find_bytes(text.data.bytes, needle.data.bytes, 0) else return none\n    var n: i64 = 0\n    for b in text.data.bytes[..<at]:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\npub func split(text: Text*, separator: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    if separator.data.length == 0:\n        heap.stop(\"split needs a separator\")\n    let out = list_new[Text*](info, ops)\n    var start: usize = 0\n    while true:\n        let at = find_bytes(text.data.bytes, separator.data.bytes, start) else break\n        list_push[Text*](out, text_of((str)text.data.bytes[start..<at]))\n        start = at + separator.data.length\n    list_push[Text*](out, text_of((str)text.data.bytes[start..]))\n    return out\n\npub func lines(text: Text*, info: heap.Info*, ops: Ops[Text*]) -> List[Text*]*:\n    let out = list_new[Text*](info, ops)\n    let b = text.data.bytes\n    var start: usize = 0\n    var i: usize = 0\n    while i < b.length:\n        if b[i] == '\\n':\n            var end = i\n            if end > start and b[end - 1] == '\\r':\n                end -= 1\n            list_push[Text*](out, text_of((str)b[start..<end]))\n            start = i + 1\n        i += 1\n    if start < b.length:\n        list_push[Text*](out, text_of((str)b[start..]))\n    return out\n\nfunc is_space(byte: u8) -> bool:\n    return byte == ' ' or byte == '\\t' or byte == '\\n' or byte == '\\r'\n\npub func trim(text: Text*) -> Text*:\n    let b = text.data.bytes\n    var start: usize = 0\n    var end = b.length\n    while start < end and is_space(b[start]):\n        start += 1\n    while end > start and is_space(b[end - 1]):\n        end -= 1\n    return text_of((str)b[start..<end])\n\npub func upper(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        out[i] = byte - 32 if byte >= 'a' and byte <= 'z' else byte\n        i += 1\n    return t\n\npub func lower(text: Text*) -> Text*:\n    let t = text_room(text.data.length)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < text.data.length:\n        let byte = text.data.bytes[i]\n        out[i] = byte + 32 if byte >= 'A' and byte <= 'Z' else byte\n        i += 1\n    return t\n\npub func replace(text: Text*, old: Text*, new_text: Text*) -> Text*:\n    if old.data.length == 0:\n        heap.stop(\"replace needs a text to replace\")\n    let source = text.data.bytes\n    var count: usize = 0\n    var start: usize = 0\n    while true:\n        let at = find_bytes(source, old.data.bytes, start) else break\n        count += 1\n        start = at + old.data.length\n    let total = source.length - count * old.data.length + count * new_text.data.length\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var at_out: usize = 0\n    start = 0\n    while true:\n        let at = find_bytes(source, old.data.bytes, start) else break\n        memory.copy(out[at_out..], source[start..<at], at - start)\n        at_out += at - start\n        memory.copy(out[at_out..], new_text.data.bytes, new_text.data.length)\n        at_out += new_text.data.length\n        start = at + old.data.length\n    memory.copy(out[at_out..], source[start..], source.length - start)\n    return t\n\npub func repeat(text: Text*, n: i64) -> Text*:\n    if n < 0:\n        heap.stop(\"repeat of a negative count\")\n    let total = text.data.length * (usize)n\n    let t = text_room(total)\n    let out = text_bytes(t)\n    var i: usize = 0\n    while i < (usize)n:\n        memory.copy(out[i * text.data.length..], text.data.bytes, text.data.length)\n        i += 1\n    return t\n\npub func text_to_bytes(t: Text*) -> Bytes*:\n    return bytes_of(t.data.bytes)\n\n## `bytes.text()`: the bytes as text when they are UTF-8 (§11.4).\npub func decode_text(data: Bytes*) -> Text*!:\n    if not valid_utf8(data.data):\n        error(luce_failure, \"invalid UTF-8\")\n    return text_of((str)data.data)\n\nfunc valid_utf8(b: const u8[]) -> bool:\n    var i: usize = 0\n    while i < b.length:\n        let lead = b[i]\n        var n: usize = 0\n        if lead < 0x80:\n            n = 0\n        elif lead >= 0xC2 and lead <= 0xDF:\n            n = 1\n        elif lead >= 0xE0 and lead <= 0xEF:\n            n = 2\n        elif lead >= 0xF0 and lead <= 0xF4:\n            n = 3\n        else:\n            return false\n        var k: usize = 1\n        while k <= n:\n            if i + k >= b.length or (b[i + k] & 0xC0) != 0x80:\n                return false\n            k += 1\n        if n == 2 and lead == 0xE0 and b[i + 1] < 0xA0:\n            return false\n        if n == 2 and lead == 0xED and b[i + 1] >= 0xA0:\n            return false\n        if n == 3 and lead == 0xF0 and b[i + 1] < 0x90:\n            return false\n        if n == 3 and lead == 0xF4 and b[i + 1] >= 0x90:\n            return false\n        i += n + 1\n    return true\n\npub func concat_bytes(a: Bytes*, b: Bytes*) -> Bytes*:\n    let out = (Bytes*)heap.allocate_sized(&bytes_info, sizeof(Bytes) + a.data.length + b.data.length)\n    let store = u8[]((u8*)out + sizeof(Bytes), a.data.length + b.data.length)\n    memory.copy(store, a.data, a.data.length)\n    memory.copy(store[a.data.length..], b.data, b.data.length)\n    out.data = store\n    return out\n\n## The pieces joined, then each let go of: what a generated display builds from.\npub func join_owned(pieces: const (Text*)[]) -> Text*:\n    let out = join(pieces)\n    for p in pieces:\n        heap.release((heap.Object*)p)\n    return out\n",
    "#==============================================================================================\n#\n#   numerals - Numbers as text: format specifications, decimal rounding, integers in a base\n#\n#   DESCRIPTION:\n#       What a formatted string's `{value:spec}` field, `round(x, digits)` and\n#       `int(text, base)` do (luce.md §3.3, §6.5), as Python does them: the format\n#       mini-language read and laid out as CPython's `format` lays it out, and the decimal\n#       digits of a float made exactly and rounded half to even, as David Gay's dtoa rounds\n#       them. Both executions run this one module: the interpreter imports it, and the\n#       emitted program carries it beside the kernel (tools/embed_runtime.py), so a field\n#       prints the same bytes in both. Every text it returns is the caller's, given back with\n#       `strings.release`. It traps only when memory runs out; the rules a Luce program can\n#       break, a scalar out of range or a base out of range, its callers check.\n#\n#==============================================================================================\n\nimport float_text\nimport strings\n\n# mark: Specifications =========================================================================\n\n## A format specification read: `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`\n## (§3.3). A part not written is `0`, `-1` or empty, so a default can still be told apart.\npub struct Spec:\n    ## The fill scalar, as written; empty when none was.\n    pub var fill: str\n    ## `<`, `>`, `^` or `=`; 0 when none was written.\n    pub var align: u8\n    ## `+`, `-` or a space; 0 when none was written.\n    pub var sign: u8\n    ## `z`: a negative zero, after rounding, shows as zero.\n    pub var no_negative_zero: bool\n    ## `#`: the alternate form, a base's prefix or a point always kept.\n    pub var alternate: bool\n    ## `0` before the width: zeros fill a number after its sign.\n    pub var zero: bool\n    ## The least width in scalars; -1 when none was written.\n    pub var width: i64\n    ## `,` or `_` between groups of digits; 0 when none was written.\n    pub var grouping: u8\n    ## The digits after the point, or the scalars a text keeps; -1 when none was written.\n    pub var precision: i64\n    ## The type letter; 0 when none was written.\n    pub var kind: u8\n\n## A specification read from its text, and what is wrong with it: empty when nothing is.\npub struct Reading:\n    ## The specification, meaningful when `problem` is empty.\n    pub var spec: Spec\n    ## Why the text is not a specification; empty when it is one.\n    pub var problem: str\n\n## What a field shows: an `int`, a `float`, or the display of anything else (§10.5).\npub enum Category:\n    integer\n    floating\n    text\n\nfunc is_align(byte: u8) -> bool:\n    return byte == '<' or byte == '>' or byte == '^' or byte == '='\n\n## The byte length of the UTF-8 scalar starting with `lead`.\nfunc scalar_bytes(lead: u8) -> usize:\n    if lead < 0x80:\n        return 1\n    if lead < 0xE0:\n        return 2\n    if lead < 0xF0:\n        return 3\n    return 4\n\n## The scalars of a UTF-8 text.\npub func scalar_count(text: str) -> i64:\n    var n: i64 = 0\n    for b in text.bytes:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\n## Digits read from `at` as a width or a precision; how many there were, -1 when too many.\nfunc read_count(b: const u8[], at: usize*, value: i64*) -> i64:\n    var n: i64 = 0\n    var total: i64 = 0\n    while *at < b.length and b[*at] >= '0' and b[*at] <= '9':\n        total = total * 10 + (i64)(b[*at] - '0')\n        if total > 1000000000:\n            return -1\n        n += 1\n        *at += 1\n    *value = total\n    return n\n\n## Read `text` as CPython's parse_internal_render_format_spec reads a specification.\npub func read(text: str) -> Reading:\n    var spec = Spec(fill = \"\", align = 0, sign = 0, no_negative_zero = false, alternate = false, zero = false, width = -1, grouping = 0, precision = -1, kind = 0)\n    let b = text.bytes\n    var at: usize = 0\n    var first: usize = 0\n    if b.length > 0:\n        first = scalar_bytes(b[0])\n    if b.length > first and is_align(b[first]):\n        spec.fill = (str)b[..<first]\n        spec.align = b[first]\n        at = first + 1\n    elif b.length > 0 and is_align(b[0]):\n        spec.align = b[0]\n        at = 1\n    if at < b.length and (b[at] == '+' or b[at] == '-' or b[at] == ' '):\n        spec.sign = b[at]\n        at += 1\n    if at < b.length and b[at] == 'z':\n        spec.no_negative_zero = true\n        at += 1\n    if at < b.length and b[at] == '#':\n        spec.alternate = true\n        at += 1\n    if spec.fill.length == 0 and at < b.length and b[at] == '0':\n        spec.zero = true\n        at += 1\n    var width: i64 = 0\n    let digits = read_count(b, &at, &width)\n    if digits < 0:\n        return Reading(spec = spec, problem = \"its width is too large\")\n    if digits > 0:\n        spec.width = width\n    if at < b.length and (b[at] == ',' or b[at] == '_'):\n        spec.grouping = b[at]\n        at += 1\n        if at < b.length and (b[at] == ',' or b[at] == '_'):\n            return Reading(spec = spec, problem = \"it groups digits with both `,` and `_`\")\n    if at < b.length and b[at] == '.':\n        at += 1\n        var precision: i64 = 0\n        let n = read_count(b, &at, &precision)\n        if n < 0:\n            return Reading(spec = spec, problem = \"its precision is too large\")\n        if n == 0:\n            return Reading(spec = spec, problem = \"a `.` is followed by the precision's digits\")\n        spec.precision = precision\n    if b.length - at > 1:\n        return Reading(spec = spec, problem = \"it is not `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`\")\n    if at < b.length:\n        spec.kind = b[at]\n    return Reading(spec = spec, problem = \"\")\n\n## What is wrong with `spec` for a value of `category`: empty when it fits (§3.3).\npub func misfit(spec: Spec, category: Category) -> str:\n    let k = spec.kind\n    match category:\n        .integer:\n            if k == 'e' or k == 'E' or k == 'f' or k == 'F' or k == 'g' or k == 'G' or k == '%':\n                return \"this type formats a `float`; convert the `int` with `float(...)` first\"\n            if k != 0 and k != 'd' and k != 'b' and k != 'o' and k != 'x' and k != 'X' and k != 'c':\n                return \"an `int` is formatted with `d`, `b`, `o`, `x`, `X` or `c`\"\n            if spec.precision >= 0:\n                return \"an `int` takes no precision\"\n            if spec.no_negative_zero:\n                return \"`z` belongs to a `float`\"\n            if k == 'c' and spec.sign != 0:\n                return \"`c` takes no sign\"\n            if k == 'c' and spec.alternate:\n                return \"`c` takes no `#`\"\n            if spec.grouping == ',' and k != 0 and k != 'd':\n                return \"`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`\"\n            if spec.grouping == '_' and k == 'c':\n                return \"`c` takes no grouping\"\n        .floating:\n            if k != 0 and k != 'e' and k != 'E' and k != 'f' and k != 'F' and k != 'g' and k != 'G' and k != '%':\n                return \"a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`\"\n        .text:\n            if k != 0 and k != 's':\n                return \"this value shows its display, so its only type is `s`\"\n            if spec.sign != 0:\n                return \"a sign belongs to a number\"\n            if spec.no_negative_zero:\n                return \"`z` belongs to a `float`\"\n            if spec.alternate:\n                return \"`#` belongs to a number\"\n            if spec.align == '=':\n                return \"`=` aligns a number after its sign\"\n            if spec.grouping != 0:\n                return \"grouping belongs to a number\"\n    return \"\"\n\n## The fill and alignment a field uses: the written ones, else the defaults, a number to\n## the right and a text to the left, and `0` before the width filling with zeros after the\n## sign (CPython's backwards-compatible special case).\nfunc settle(spec: Spec, numeric: bool) -> Spec:\n    var out = spec\n    if spec.zero:\n        out.fill = \"0\"\n        if spec.align == 0 and numeric:\n            out.align = '='\n    if out.fill.length == 0:\n        out.fill = \" \"\n    if out.align == 0:\n        out.align = '>' if numeric else '<'\n    return out\n\n# mark: Output =================================================================================\n\n## Text being made: the builder, with memory running out a trap.\nstruct Out:\n    var b: strings.Builder\n\n    static func make() -> Out:\n        let b = strings.Builder.create(32) catch failure:\n            trap(\"out of memory\")\n        return Out(b = b)\n\n    mutating func put(text: str):\n        self.b.put(text) catch failure:\n            trap(\"out of memory\")\n\n    mutating func byte(c: u8):\n        var one: u8[1]\n        one[0] = c\n        self.put((str)one[..<1])\n\n    mutating func repeat(text: str, n: i64):\n        var i: i64 = 0\n        while i < n:\n            self.put(text)\n            i += 1\n\n    ## The text made, as an owned copy; the builder is given back.\n    mutating func finish() -> str:\n        let out = strings.copy(self.b.view()) catch failure:\n            trap(\"out of memory\")\n        self.b.destroy()\n        return out\n\n## Padding before and after `n` scalars to `width`, by the alignment (CPython's calc_padding).\nfunc padding(n: i64, width: i64, align: u8) -> (i64, i64):\n    let total = width if width > n else n\n    var left: i64 = 0\n    if align == '>':\n        left = total - n\n    elif align == '^':\n        left = (total - n) // 2\n    return (left, total - n - left)\n\n## `digits` in groups of `interval` from the right with `separator` between, none when\n## `interval` is 0, and zeros on the left until it is `least` long: CPython's\n## _PyUnicode_InsertThousandsGrouping, which zero padding runs through too.\nfunc grouped(digits: str, least: i64, interval: i64, separator: u8) -> str:\n    var reversed = Out.make()\n    var remaining = (i64)digits.length\n    var left = least if least > 0 else 0\n    var cursor = digits.length\n    var separate = false\n    var finished = false\n    while interval > 0:\n        let size = smaller(interval, larger(larger(remaining, left), 1))\n        put_group(&reversed, digits, &cursor, size, remaining, separate, separator)\n        separate = true\n        remaining -= larger(0, smaller(remaining, size))\n        left -= size\n        if remaining <= 0 and left <= 0:\n            finished = true\n            break\n        left -= 1\n    if not finished:\n        let size = larger(larger(remaining, left), 1)\n        put_group(&reversed, digits, &cursor, size, remaining, separate, separator)\n    let backwards = reversed.finish()\n    defer strings.release(backwards)\n    var out = Out.make()\n    var i = backwards.length\n    while i > 0:\n        i -= 1\n        out.byte(backwards.bytes[i])\n    return out.finish()\n\n## One group, written backwards: the separator, then its digits from the right, then the\n## zeros that pad it.\nfunc put_group(reversed: Out*, digits: str, cursor: usize*, size: i64, remaining: i64, separate: bool, separator: u8):\n    let zeros = larger(0, size - remaining)\n    let chars = larger(0, smaller(remaining, size))\n    if separate:\n        reversed.byte(separator)\n    var i: i64 = 0\n    while i < chars:\n        *cursor -= 1\n        reversed.byte(digits.bytes[*cursor])\n        i += 1\n    reversed.repeat(\"0\", zeros)\n\nfunc smaller(a: i64, b: i64) -> i64:\n    return a if a < b else b\n\nfunc larger(a: i64, b: i64) -> i64:\n    return a if a > b else b\n\n## A number laid out as CPython's calc_number_widths and fill_number lay it out:\n## `[padding] sign prefix [padding] grouped-digits [point] rest [padding]`. `spec` is settled.\nfunc lay_number(out: Out*, negative: bool, prefix: str, digits: str, point: bool, rest: str, spec: Spec, upper: bool):\n    var sign: u8 = 0\n    if spec.sign == '+':\n        sign = '-' if negative else '+'\n    elif spec.sign == ' ':\n        sign = '-' if negative else ' '\n    elif negative:\n        sign = '-'\n    let fixed = (1 if sign != 0 else 0) + (i64)prefix.length + (1 if point else 0) + scalar_count(rest)\n    let least = spec.width - fixed if spec.fill == \"0\" and spec.align == '=' else 0\n    let interval: i64 = 0 if spec.grouping == 0 else 4 if spec.kind == 'b' or spec.kind == 'o' or spec.kind == 'x' or spec.kind == 'X' else 3\n    var body = \"\"\n    if digits.length > 0:\n        body = grouped(digits, least, interval, spec.grouping)\n    defer:\n        if digits.length > 0:\n            strings.release(body)\n    let spare = spec.width - (fixed + (i64)body.length)\n    var before: i64 = 0\n    var between: i64 = 0\n    var after: i64 = 0\n    if spare > 0:\n        if spec.align == '<':\n            after = spare\n        elif spec.align == '^':\n            before = spare // 2\n            after = spare - before\n        elif spec.align == '=':\n            between = spare\n        else:\n            before = spare\n    out.repeat(spec.fill, before)\n    if sign != 0:\n        out.byte(sign)\n    put_cased(out, prefix, upper)\n    out.repeat(spec.fill, between)\n    put_cased(out, body, upper)\n    if point:\n        out.put(\".\")\n    out.put(rest)\n    out.repeat(spec.fill, after)\n\nfunc put_cased(out: Out*, text: str, upper: bool):\n    if not upper:\n        out.put(text)\n        return\n    for c in text.bytes:\n        out.byte(c - 32 if c >= 'a' and c <= 'z' else c)\n\n# mark: Fields =================================================================================\n\n## An `int` field `{value:spec}`; none when `c` meets a value that is no Unicode scalar.\npub func format_int(value: i64, text: str) -> str?:\n    let spec = settle(read(text).spec, true)\n    var out = Out.make()\n    let negative = value < 0\n    let magnitude = (u64)(-(value + 1)) + 1 if negative else (u64)value\n    if spec.kind == 'c':\n        if negative or value > 0x10FFFF or (value >= 0xD800 and value <= 0xDFFF):\n            out.b.destroy()\n            return none\n        var buffer: u8[4]\n        let scalar = encode_scalar(value, buffer)\n        lay_number(&out, false, \"\", \"\", false, scalar, spec, false)\n        return out.finish()\n    var base: u32 = 10\n    var prefix = \"\"\n    if spec.kind == 'b':\n        base = 2\n        prefix = \"0b\"\n    elif spec.kind == 'o':\n        base = 8\n        prefix = \"0o\"\n    elif spec.kind == 'x' or spec.kind == 'X':\n        base = 16\n        prefix = \"0x\"\n    var buffer: u8[65]\n    let digits = strings.format_u64(magnitude, buffer, base) catch failure:\n        trap(\"a number that does not format\")\n    lay_number(&out, negative, prefix if spec.alternate else \"\", digits, false, \"\", spec, spec.kind == 'X')\n    return out.finish()\n\n## The UTF-8 of a scalar (`chr`), viewing `buffer`.\npub func encode_scalar(value: i64, buffer: u8[]) -> str:\n    let v = (u32)value\n    if v < 0x80:\n        buffer[0] = (u8)v\n        return (str)buffer[..<1]\n    if v < 0x800:\n        buffer[0] = (u8)(0xC0 | (v >> 6))\n        buffer[1] = (u8)(0x80 | (v & 0x3F))\n        return (str)buffer[..<2]\n    if v < 0x10000:\n        buffer[0] = (u8)(0xE0 | (v >> 12))\n        buffer[1] = (u8)(0x80 | ((v >> 6) & 0x3F))\n        buffer[2] = (u8)(0x80 | (v & 0x3F))\n        return (str)buffer[..<3]\n    buffer[0] = (u8)(0xF0 | (v >> 18))\n    buffer[1] = (u8)(0x80 | ((v >> 12) & 0x3F))\n    buffer[2] = (u8)(0x80 | ((v >> 6) & 0x3F))\n    buffer[3] = (u8)(0x80 | (v & 0x3F))\n    return (str)buffer[..<4]\n\n## A `float` field `{value:spec}`. With neither a type nor a precision it shows the value's\n## display (§3.3), where Python would show its repr.\npub func format_float(value: f64, text: str) -> str:\n    let spec = settle(read(text).spec, true)\n    var x = value\n    var kind = spec.kind\n    var percent = false\n    if kind == '%':\n        x = x * 100.0\n        kind = 'f'\n        percent = true\n    var digits = Out.make()\n    if kind == 0 and spec.precision < 0:\n        var buffer: u8[40]\n        let n = float_text.display_f64(x, buffer)\n        var shown = (str)buffer[..<n]\n        if spec.no_negative_zero and x == 0.0 and shown.bytes[0] == '-':\n            shown = (str)shown.bytes[1..]\n        digits.put(shown)\n    else:\n        short_text(&digits, x, kind, spec.precision if spec.precision >= 0 else 6, spec.alternate, spec.no_negative_zero)\n    if percent:\n        digits.put(\"%\")\n    let made = digits.finish()\n    defer strings.release(made)\n    # the sign apart, the leading digits, a point, and the rest as CPython's parse_number\n    var at: usize = 0\n    let negative = made.length > 0 and made.bytes[0] == '-'\n    if negative:\n        at = 1\n    var end = at\n    while end < made.length and made.bytes[end] >= '0' and made.bytes[end] <= '9':\n        end += 1\n    let point = end < made.length and made.bytes[end] == '.'\n    let rest = (str)made.bytes[end + 1 if point else end..]\n    var out = Out.make()\n    lay_number(&out, negative, \"\", (str)made.bytes[at..<end], point, rest, spec, false)\n    return out.finish()\n\n## A field of any other value, given its display: precision keeps that many scalars, and\n## the width pads it (CPython's format_string_internal).\npub func format_text(shown: str, text: str) -> str:\n    let spec = settle(read(text).spec, false)\n    var view = shown\n    var n = scalar_count(shown)\n    if spec.precision >= 0 and n > spec.precision:\n        view = scalar_prefix(shown, spec.precision)\n        n = spec.precision\n    let (before, after) = padding(n, spec.width, spec.align)\n    var out = Out.make()\n    out.repeat(spec.fill, before)\n    out.put(view)\n    out.repeat(spec.fill, after)\n    return out.finish()\n\n## The first `n` scalars of `text`, viewing it.\npub func scalar_prefix(text: str, n: i64) -> str:\n    var seen: i64 = 0\n    var i: usize = 0\n    while i < text.length:\n        if (text.bytes[i] & 0xC0) != 0x80:\n            if seen == n:\n                return (str)text.bytes[..<i]\n            seen += 1\n        i += 1\n    return text\n\n# mark: Exact decimals =========================================================================\n\n## The exact decimal digits of a float's magnitude: `0.d1d2d3... × 10^point`, at most 767\n## significant digits for any finite f64, no trailing zero; `count` 0 is zero.\nstruct Decimal:\n    var digits: u8[800]\n    var count: usize\n    var point: i64\n\n## The digits of |value|, finite: the significand times a power of two, made decimal in\n## limbs of 10^9 exactly (multiplying by 2^k, or by 5^k for a negative exponent).\nfunc exact(value: f64) -> Decimal:\n    var d: Decimal = ---\n    d.count = 0\n    d.point = 0\n    let bits = value.bits()\n    let exponent_bits = (i64)((bits >> 52) & 0x7FF)\n    var significand = bits & 0xFFFFFFFFFFFFF\n    var exponent: i64 = -1074\n    if exponent_bits != 0:\n        significand = significand | 0x10000000000000\n        exponent = exponent_bits - 1075\n    if significand == 0:\n        d.digits[0] = '0'\n        d.count = 1\n        d.point = 1\n        return d\n    var limbs: u64[100] = ---\n    limbs[0] = significand % 1000000000\n    limbs[1] = significand // 1000000000\n    var used: usize = 2 if limbs[1] != 0 else 1\n    if exponent >= 0:\n        var left = exponent\n        while left > 0:\n            let shift = left if left < 30 else 30\n            used = multiply(limbs, used, (u64)1 << (u64)shift)\n            left -= shift\n    else:\n        var left = -exponent\n        while left > 0:\n            let step = left if left < 13 else 13\n            var factor: u64 = 1\n            for _ in 0..<step:\n                factor *= 5\n            used = multiply(limbs, used, factor)\n            left -= step\n    # the top limb without leading zeros, every other one as nine digits\n    var top: u8[9] = ---\n    var n: usize = 0\n    var high = limbs[used - 1]\n    while high > 0:\n        top[n] = '0' + (u8)(high % 10)\n        high //= 10\n        n += 1\n    while n > 0:\n        n -= 1\n        d.digits[d.count] = top[n]\n        d.count += 1\n    var i = used - 1\n    while i > 0:\n        i -= 1\n        var limb = limbs[i]\n        var k: usize = 9\n        while k > 0:\n            k -= 1\n            d.digits[d.count + k] = '0' + (u8)(limb % 10)\n            limb //= 10\n        d.count += 9\n    d.point = (i64)d.count + (exponent if exponent < 0 else 0)\n    trim_zeros(&d)\n    return d\n\n## `limbs[..<used] *= factor`, factor at most 2^30; the limbs now used.\nfunc multiply(limbs: u64[], used: usize, factor: u64) -> usize:\n    var carry: u64 = 0\n    var i: usize = 0\n    while i < used:\n        let product = limbs[i] * factor + carry\n        limbs[i] = product % 1000000000\n        carry = product // 1000000000\n        i += 1\n    var n = used\n    while carry > 0:\n        limbs[n] = carry % 1000000000\n        carry //= 1000000000\n        n += 1\n    return n\n\nfunc trim_zeros(d: Decimal*):\n    while d.count > 1 and d.digits[d.count - 1] == '0':\n        d.count -= 1\n\n## Keep the first `keep` digits, rounding half to even on the exact value; `keep` may be 0\n## or less, which leaves zero (`count` 0) or one digit carried up.\nfunc round_to(d: Decimal*, keep: i64):\n    if keep >= (i64)d.count:\n        return\n    var up = false\n    if keep >= 0:\n        let next = d.digits[(usize)keep]\n        var beyond = false\n        var i = (usize)keep + 1\n        while i < d.count:\n            if d.digits[i] != '0':\n                beyond = true\n            i += 1\n        let odd = keep > 0 and ((d.digits[(usize)keep - 1] - '0') % 2) == 1\n        up = next > '5' or (next == '5' and (beyond or odd))\n    if keep <= 0:\n        d.count = 0\n        if up:\n            d.digits[0] = '1'\n            d.count = 1\n            d.point += 1\n        return\n    d.count = (usize)keep\n    if up:\n        var i = d.count\n        var carried = true\n        while carried and i > 0:\n            i -= 1\n            if d.digits[i] == '9':\n                d.digits[i] = '0'\n            else:\n                d.digits[i] += 1\n                carried = false\n        if carried:\n            # every kept digit was 9: one digit, a 1, a place higher\n            d.digits[0] = '1'\n            d.count = 1\n            d.point += 1\n    trim_zeros(d)\n    if d.count == 1 and d.digits[0] == '0':\n        d.count = 0\n\n## dtoa's mode 2 (`n` significant digits) or mode 3 (`n` digits after the point, any sign)\n## of a finite |value|: rounded half to even, no trailing zero, zero as `0` at point 1, and\n## nothing left at point `-n` when mode 3 rounds it all away.\nfunc digits_of(value: f64, mode: u8, n: i64) -> Decimal:\n    var d = exact(value)\n    if d.count == 1 and d.digits[0] == '0':\n        return d\n    if mode == 2:\n        round_to(&d, n if n > 1 else 1)\n    else:\n        round_to(&d, d.point + n)\n        if d.count == 0:\n            d.point = -n\n    return d\n\n## `e`, `f`, `g` (and the upper ones) of `value` with `precision`, as CPython's\n## PyOS_double_to_string and format_float_short write them: `-` for a negative value,\n## `inf` and `nan` for the specials.\nfunc short_text(out: Out*, value: f64, kind: u8, precision: i64, alternate: bool, no_negative_zero: bool):\n    let upper = kind == 'E' or kind == 'F' or kind == 'G'\n    var code = kind + 32 if upper else kind\n    var add_dot = false\n    var p = precision\n    if code == 0:\n        # a precision without a type: `g`, a point always kept (CPython's 'r' with one)\n        code = 'g'\n        add_dot = true\n    if value != value:\n        out.put(\"NAN\" if upper else \"nan\")\n        return\n    var negative = value < 0.0 or (value == 0.0 and (value.bits() >> 63) != 0)\n    if infinite(value):\n        out.put(\"-\" if negative else \"\")\n        out.put(\"INF\" if upper else \"inf\")\n        return\n    var mode: u8 = 2\n    if code == 'e':\n        p += 1\n    elif code == 'f':\n        mode = 3\n    elif p == 0:\n        p = 1\n    let d = digits_of(value, mode, p)\n    if no_negative_zero and (d.count == 0 or (d.count == 1 and d.digits[0] == '0')):\n        negative = false\n    var point = d.point\n    var end = (i64)d.count\n    var use_exponent = false\n    if code == 'e':\n        use_exponent = true\n        end = p\n    elif code == 'f':\n        end = point + p\n    else:\n        if point <= -4 or point > (p - 1 if add_dot else p):\n            use_exponent = true\n        if alternate:\n            end = p\n    var exponent: i64 = 0\n    if use_exponent:\n        exponent = point - 1\n        point = 1\n    let start = point - 1 if point <= 0 else 0\n    if not use_exponent and add_dot:\n        end = end if end > point else point + 1\n    else:\n        end = end if end > point else point\n    if negative:\n        out.put(\"-\")\n    lay_digits(out, d, point, start, end, alternate)\n    if use_exponent:\n        out.put(\"E\" if upper else \"e\")\n        out.put(\"-\" if exponent < 0 else \"+\")\n        let magnitude = -exponent if exponent < 0 else exponent\n        if magnitude < 10:\n            out.put(\"0\")\n        var buffer: u8[24]\n        out.put(strings.format_i64(magnitude, buffer) catch failure: recover \"0\")\n\n## The virtual digits `[start, end)` of `d` with the point after `point` of them: zeros\n## where `d` has none, and the point dropped at the end unless `alternate` keeps it.\nfunc lay_digits(out: Out*, d: Decimal, point: i64, start: i64, end: i64, alternate: bool):\n    var i = start\n    while i < end:\n        if i == point:\n            out.put(\".\")\n        out.byte(d.digits[(usize)i] if i >= 0 and i < (i64)d.count else '0')\n        i += 1\n    if end == point and alternate:\n        out.put(\".\")\n\n# mark: Rounding and integers ==================================================================\n\n## `round(x, digits)` (§6.5) as CPython's double_round: the correctly rounded decimal with\n## `digits` after the point, half to even, read back as the nearest float. None when it\n## rounds past the largest float.\npub func round(x: f64, digits: i64) -> f64?:\n    if x != x or infinite(x) or digits > 323:\n        return x\n    if digits < -308:\n        return 0.0 * x\n    let d = digits_of(x, 3, digits)\n    let negative = x < 0.0 or (x == 0.0 and (x.bits() >> 63) != 0)\n    var out = Out.make()\n    if negative:\n        out.put(\"-\")\n    if d.count == 0:\n        out.put(\"0\")\n    else:\n        out.put((str)d.digits[..<d.count])\n    out.put(\"e\")\n    var buffer: u8[24]\n    out.put(strings.format_i64(d.point - (i64)d.count if d.count > 0 else 0, buffer) catch failure: recover \"0\")\n    let text = out.finish()\n    defer strings.release(text)\n    let rounded = strings.parse_f64(text) catch failure:\n        return none\n    if infinite(rounded):\n        return none\n    return rounded\n\n## Whether `x` is an infinity (a NaN is told apart by `x != x`).\nfunc infinite(x: f64) -> bool:\n    return x == x and ((x.bits() >> 52) & 0x7FF) == 0x7FF\n\nfunc is_white(c: u8) -> bool:\n    return c == ' ' or c == '\\t' or c == '\\n' or c == '\\r' or c == 11 or c == 12\n\nfunc digit_value(c: u8) -> i64:\n    if c >= '0' and c <= '9':\n        return (i64)(c - '0')\n    if c >= 'a' and c <= 'z':\n        return (i64)(c - 'a') + 10\n    if c >= 'A' and c <= 'Z':\n        return (i64)(c - 'A') + 10\n    return 99\n\n## `int(text, base)` (§6.5) as Python reads it, `base` from 2 to 36: white space around,\n## a sign, `0x`, `0o` or `0b` when it matches the base, and digits with single `_` between\n## them. None when the text is not such an integer or does not fit an `int`.\npub func parse_int(text: str, base: i64) -> i64?:\n    let b = text.bytes\n    var start: usize = 0\n    var end = b.length\n    while start < end and is_white(b[start]):\n        start += 1\n    while end > start and is_white(b[end - 1]):\n        end -= 1\n    var at = start\n    var negative = false\n    if at < end and (b[at] == '+' or b[at] == '-'):\n        negative = b[at] == '-'\n        at += 1\n    var underscore_ok = false\n    if at + 1 < end and b[at] == '0':\n        let p = b[at + 1]\n        if ((p == 'x' or p == 'X') and base == 16) or ((p == 'o' or p == 'O') and base == 8) or ((p == 'b' or p == 'B') and base == 2):\n            at += 2\n            underscore_ok = true\n    var value: i64 = 0\n    var digits = 0\n    var after_underscore = false\n    while at < end:\n        let c = b[at]\n        at += 1\n        if c == '_':\n            if after_underscore or not (digits > 0 or underscore_ok):\n                return none\n            after_underscore = true\n            continue\n        let v = digit_value(c)\n        if v >= base:\n            return none\n        after_underscore = false\n        digits += 1\n        let scaled = value *? base else return none\n        value = (scaled -? v if negative else scaled +? v) else return none\n    if digits == 0 or after_underscore:\n        return none\n    return value\n\n# mark: Tests ===================================================================================\n\ntest \"format specifications read and fit as Python's\":\n    let r = read(\"*^+#012,.3f\")\n    assert(r.problem == \"\")\n    assert(r.spec.fill == \"*\" and r.spec.align == '^' and r.spec.sign == '+' and r.spec.alternate)\n    assert(r.spec.width == 12 and r.spec.grouping == ',' and r.spec.precision == 3 and r.spec.kind == 'f')\n    assert(read(\"·>5\").spec.fill == \"·\")\n    assert(read(\".f\").problem != \"\")\n    assert(read(\"ff\").problem != \"\")\n    assert(read(\",_\").problem != \"\")\n    assert(misfit(read(\"x\").spec, Category.floating) != \"\")\n    assert(misfit(read(\".2\").spec, Category.integer) != \"\")\n    assert(misfit(read(\",x\").spec, Category.integer) != \"\")\n    assert(misfit(read(\"_x\").spec, Category.integer) == \"\")\n    assert(misfit(read(\"+\").spec, Category.text) != \"\")\n\ntest \"integers lay out as Python's format\":\n    let cases: str[12] = [\"d\", \"+d\", \"#x\", \"#X\", \"08b\", \"_b\", \",\", \"010,\", \"08,\", \"^9\", \"*<6\", \"=+8\"]\n    let wants: str[12] = [\"-1234\", \"-1234\", \"-0x4d2\", \"-0X4D2\", \"-10011010010\", \"-100_1101_0010\", \"-1,234\", \"-0,001,234\", \"-001,234\", \"  -1234  \", \"-1234*\", \"-   1234\"]\n    var i: usize = 0\n    while i < 12:\n        let got = format_int(-1234, cases[i]) else return\n        assert(got == wants[i])\n        strings.release(got)\n        i += 1\n    assert(format_int(0x110000, \"c\") == none)\n\ntest \"floats lay out as Python's format\":\n    let cases: str[14] = [\".2f\", \"e\", \".3g\", \"g\", \"%\", \"10.1f\", \"010.2f\", \",.2f\", \".0f\", \"#.0f\", \".3\", \"+.1E\", \"z.1f\", \"_\"]\n    let values: f64[14] = [3.14159, 12345.678, 0.000012345, 1e20, 0.25, -2.25, -2.25, 1234567.891, 2.5, 2.5, 1234.5, 1e-300, -0.04, 1234567.5]\n    let wants: str[14] = [\"3.14\", \"1.234568e+04\", \"1.23e-05\", \"1e+20\", \"25.000000%\", \"      -2.2\", \"-000002.25\", \"1,234,567.89\", \"2\", \"2.\", \"1.23e+03\", \"+1.0E-300\", \"0.0\", \"1_234_567.5\"]\n    var i: usize = 0\n    while i < 14:\n        let got = format_float(values[i], cases[i])\n        assert(got == wants[i])\n        strings.release(got)\n        i += 1\n\ntest \"round is correctly rounded half to even\":\n    assert(round(2.675, 2) == 2.67)\n    assert(round(0.125, 2) == 0.12)\n    assert(round(0.375, 2) == 0.38)\n    assert(round(2.5, 0) == 2.0)\n    assert(round(1234.5, -2) == 1200.0)\n    assert(round(-0.4, 0) == 0.0)\n    assert(round(1.7976931348623157e308, -308) == none)\n\ntest \"integers parse in a base as Python's int\":\n    assert(parse_int(\" 0x_ff \", 16) == 255)\n    assert(parse_int(\"-1_000\", 10) == -1000)\n    assert(parse_int(\"0b101\", 2) == 5)\n    assert(parse_int(\"0b101\", 16) == 45313)\n    assert(parse_int(\"1__0\", 10) == none)\n    assert(parse_int(\"_1\", 10) == none)\n    assert(parse_int(\"1_\", 10) == none)\n    assert(parse_int(\"z\", 36) == 35)\n    assert(parse_int(\"9223372036854775808\", 10) == none)\n    assert(parse_int(\"-9223372036854775808\", 10) == -9223372036854775807 - 1)\n"
]
