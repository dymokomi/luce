pub let count: usize = 2
pub let names: str[2] = ["heap.lucb", "kernel.lucb"]
pub let sources: str[2] = [
    "#==============================================================================================\n#\n#   heap - Objects, their counts, the temporaries pool, the cycle collector\n#\n#   DESCRIPTION:\n#       The runtime of §10 as docs/RUNTIME.md states it. A class instance is a block with an\n#       `Object` header; the emitted program retains and releases through these functions\n#       and never touches a count itself. A release that leaves a count above zero makes the\n#       object a candidate for the cycle collector, which is synchronous trial deletion\n#       (Bacon and Rajan, 2001) run when the candidate buffer is full and after `main`.\n#       Nothing here fails: an allocation that cannot be met traps.\n#\n#==============================================================================================\n\nimport io\nimport memory\n\n# mark: Objects ================================================================================\n\nlet black: u8 = 0\nlet gray: u8 = 1\nlet white: u8 = 2\nlet purple: u8 = 3\nlet color_mask: u8 = 3\nlet buffered: u8 = 4\nlet dead: u8 = 8\nlet collecting: u8 = 16\n\npub struct Object:\n    pub var strong: u32\n    pub var weak: u32\n    pub var flags: u8\n    pub var info: Info*\n\n## What the collector and the destructor need to know about a class.\npub struct Info:\n    pub var name: str\n    pub var size: usize\n    ## `deinit`, when the class declares one.\n    pub var finish: (func(Object*) -> unit)?\n    ## Releases the fields in reverse declaration order, tolerating unassigned ones.\n    pub var drop: func(Object*) -> unit\n    ## Visits every strong reference the object holds, fields in declaration order.\n    pub var trace: func(Object*, func(Object*, void*) -> unit, void*) -> unit\n\n## Objects alive: allocated and not yet destroyed.\nvar live: usize = 0\n\nfunc color_of(o: Object*) -> u8:\n    return o.flags & color_mask\n\nfunc set_color(o: Object*, c: u8):\n    o.flags = (o.flags & ~color_mask) | c\n\nfunc has(o: Object*, flag: u8) -> bool:\n    return (o.flags & flag) != 0\n\npub func allocate(info: Info*) -> Object*:\n    let block = alloc(info.size, 16) catch failure:\n        trap(\"out of memory\")\n    memory.set(block, 0)\n    let o = (Object*)block.data\n    o.strong = 1\n    o.weak = 0\n    o.flags = black\n    o.info = info\n    live += 1\n    return o\n\npub func retain(o: Object*) -> Object*:\n    o.strong += 1\n    set_color(o, black)\n    return o\n\npub func release(o: Object*):\n    if has(o, collecting):\n        # a white object's field, released while the collector drops it: the count is\n        # bookkeeping only, the collector frees the object\n        if o.strong > 0:\n            o.strong -= 1\n        return\n    o.strong -= 1\n    if o.strong == 0:\n        destroy(o)\n    else:\n        possible_root(o)\n\n## `deinit`, then the fields, then the storage unless a weak reference keeps the shell.\nfunc destroy(o: Object*):\n    set_color(o, black)\n    if let f = o.info.finish:\n        o.strong = 1\n        f(o)\n        if o.strong != 1:\n            trap(\"`deinit` published `self`\")\n        o.strong = 0\n    o.info.drop(o)\n    live -= 1\n    o.flags |= dead\n    if not has(o, buffered):\n        release_shell(o)\n\n## The storage goes when nothing, strong or weak or the candidate buffer, refers to it.\nfunc release_shell(o: Object*):\n    if o.weak == 0 and has(o, dead) and not has(o, buffered):\n        free(u8[]((u8*)o, o.info.size))\n\n## An `init` that failed: the fields assigned so far go, no `deinit` runs.\npub func abandon(o: Object*):\n    o.info.drop(o)\n    live -= 1\n    o.strong = 0\n    o.flags |= dead\n    if not has(o, buffered):\n        release_shell(o)\n\n# mark: The temporaries pool ===================================================================\n\nstruct Pending:\n    var object: Object*?\n    var cell: void*?\n    var drop: (func(void*) -> unit)?\n    var size: usize\n\nvar pending: Pending[]\nvar pending_count: usize = 0\n\npub func mark() -> usize:\n    return pending_count\n\nfunc push_pending(p: Pending):\n    if pending_count == pending.length:\n        let grown = alloc Pending[pending.length * 2 if pending.length > 0 else 64] catch failure:\n            trap(\"out of memory\")\n        var i: usize = 0\n        while i < pending_count:\n            grown[i] = pending[i]\n            i += 1\n        if pending.length > 0:\n            free(pending)\n        pending = grown\n    pending[pending_count] = p\n    pending_count += 1\n\n## An owned object handed on as a temporary: released by the next `drain`.\npub func pool_object(o: Object*) -> Object*:\n    push_pending(Pending(object = o, cell = none, drop = none, size = 0))\n    return o\n\n## An owned value of any type handed on as a temporary; `drop` releases what it holds.\npub func pool_value[T](v: T, drop: func(void*) -> unit) -> T:\n    let block = alloc u8[sizeof(T)] catch failure:\n        trap(\"out of memory\")\n    memory.write[T](block.data, v)\n    push_pending(Pending(object = none, cell = block.data, drop = drop, size = sizeof(T)))\n    return v\n\n## Releases every temporary pooled since `mark`, in the order they were pooled.\npub func drain(since: usize):\n    if pending_count <= since:\n        return\n    let count = pending_count\n    var i = since\n    while i < count:\n        let p = pending[i]\n        if let o = p.object:\n            release(o)\n        elif let cell = p.cell:\n            if let d = p.drop:\n                d(cell)\n            free(u8[]((u8*)cell, p.size))\n        i += 1\n    # a release pools nothing of its own, so nothing was added above `count`\n    pending_count = since\n\n# mark: The cycle collector ====================================================================\n\npub let candidate_limit: usize = 1024\n\nvar roots: Object*[]\nvar root_count: usize = 0\nvar whites: Object*[]\nvar white_count: usize = 0\nvar collector_running: bool = false\n\nfunc push_root(o: Object*):\n    if root_count == roots.length:\n        let grown = alloc Object*[roots.length * 2 if roots.length > 0 else candidate_limit] catch failure:\n            trap(\"out of memory\")\n        var i: usize = 0\n        while i < root_count:\n            grown[i] = roots[i]\n            i += 1\n        if roots.length > 0:\n            free(roots)\n        roots = grown\n    roots[root_count] = o\n    root_count += 1\n\nfunc push_white(o: Object*):\n    if white_count == whites.length:\n        let grown = alloc Object*[whites.length * 2 if whites.length > 0 else 256] catch failure:\n            trap(\"out of memory\")\n        var i: usize = 0\n        while i < white_count:\n            grown[i] = whites[i]\n            i += 1\n        if whites.length > 0:\n            free(whites)\n        whites = grown\n    whites[white_count] = o\n    white_count += 1\n\nfunc possible_root(o: Object*):\n    if color_of(o) != purple:\n        set_color(o, purple)\n        if not has(o, buffered):\n            o.flags |= buffered\n            push_root(o)\n            if root_count >= candidate_limit and not collector_running:\n                collect()\n\nfunc visit_mark_gray(child: Object*, context: void*):\n    child.strong -= 1\n    mark_gray(child)\n\nfunc mark_gray(o: Object*):\n    if color_of(o) != gray:\n        set_color(o, gray)\n        o.info.trace(o, visit_mark_gray, (void*)o)\n\nfunc visit_scan(child: Object*, context: void*):\n    scan(child)\n\nfunc visit_scan_black(child: Object*, context: void*):\n    child.strong += 1\n    if color_of(child) != black:\n        scan_black(child)\n\nfunc scan(o: Object*):\n    if color_of(o) == gray:\n        if o.strong > 0:\n            scan_black(o)\n        else:\n            set_color(o, white)\n            o.info.trace(o, visit_scan, (void*)o)\n\nfunc scan_black(o: Object*):\n    set_color(o, black)\n    o.info.trace(o, visit_scan_black, (void*)o)\n\nfunc visit_gather(child: Object*, context: void*):\n    gather(child)\n\n## The white objects in discovery order, each once, flagged as being collected.\nfunc gather(o: Object*):\n    if color_of(o) == white and not has(o, collecting):\n        o.flags |= collecting\n        push_white(o)\n        o.info.trace(o, visit_gather, (void*)o)\n\nfunc visit_restore(child: Object*, context: void*):\n    if has(child, collecting):\n        child.strong += 1\n\n## Free the garbage: deinits first, then every object's fields, then the storage.\npub func collect():\n    if collector_running:\n        return\n    collector_running = true\n    # candidates still purple and alive stay; the rest leave the buffer\n    var kept: usize = 0\n    var i: usize = 0\n    while i < root_count:\n        let o = roots[i]\n        if color_of(o) == purple and o.strong > 0 and not has(o, dead):\n            roots[kept] = o\n            kept += 1\n        else:\n            o.flags &= ~buffered\n            release_shell(o)\n        i += 1\n    root_count = kept\n    i = 0\n    while i < root_count:\n        mark_gray(roots[i])\n        i += 1\n    i = 0\n    while i < root_count:\n        scan(roots[i])\n        i += 1\n    white_count = 0\n    i = 0\n    while i < root_count:\n        gather(roots[i])\n        i += 1\n    i = 0\n    while i < root_count:\n        roots[i].flags &= ~buffered\n        i += 1\n    root_count = 0\n    # the counts among the garbage are restored so that every field release below is an\n    # ordinary one; a release of a white object then only lowers its count\n    i = 0\n    while i < white_count:\n        whites[i].info.trace(whites[i], visit_restore, (void*)whites[i])\n        i += 1\n    i = 0\n    while i < white_count:\n        let o = whites[i]\n        if let f = o.info.finish:\n            let before = o.strong\n            o.strong += 1\n            f(o)\n            if o.strong != before + 1:\n                trap(\"`deinit` published `self`\")\n            o.strong = before\n        i += 1\n    i = 0\n    while i < white_count:\n        whites[i].info.drop(whites[i])\n        i += 1\n    i = 0\n    while i < white_count:\n        let o = whites[i]\n        live -= 1\n        o.strong = 0\n        o.flags = dead\n        release_shell(o)\n        i += 1\n    white_count = 0\n    collector_running = false\n\n# mark: Weak references ========================================================================\n\npub struct Weak:\n    pub var target: Object*?\n\npub func weak_make(o: Object*) -> Weak:\n    o.weak += 1\n    return Weak(target = o)\n\npub func weak_copy(w: Weak) -> Weak:\n    if let o = w.target:\n        o.weak += 1\n    return w\n\npub func weak_drop(w: Weak):\n    if let o = w.target:\n        o.weak -= 1\n        release_shell(o)\n\n## The object with a fresh strong reference, or none once it is dead.\npub func weak_get(w: Weak) -> Object*?:\n    if let o = w.target:\n        if not has(o, dead):\n            return retain(o)\n    return none\n\n# mark: The end of a run =======================================================================\n\n## After `main`: the collector runs, and anything still alive is a defect. The exit status.\npub func finish_run(status: i32) -> i32:\n    drain(0)\n    collect()\n    if live != 0:\n        var room: u8[96]\n        let text = format(room, f\"luce: {live} objects alive at exit\\n\") catch failure:\n            recover \"luce: objects alive at exit\\n\"\n        var e = io.stderr()\n        discard(e.write(text.bytes) catch failure: recover 0)\n        return 3\n    return status\n\n# mark: Evidence ===============================================================================\n\n## A hand-built class, shaped as the emitter shapes one: the header first, then the fields.\nstruct Node:\n    var header: Object\n    var value: i64\n    var next: Node*?\n\nvar log: u8[64]\nvar logged: usize = 0\n\nfunc note(byte: u8):\n    if logged < log.length:\n        log[logged] = byte\n        logged += 1\n\nfunc node_finish(o: Object*):\n    let n = (Node*)o\n    note(u8(48 + n.value))\n\nfunc node_drop(o: Object*):\n    let n = (Node*)o\n    if let next = n.next:\n        n.next = none\n        release((Object*)next)\n\nfunc node_trace(o: Object*, visit: func(Object*, void*) -> unit, context: void*):\n    let n = (Node*)o\n    if let next = n.next:\n        visit((Object*)next, context)\n\nvar node_info: Info = Info(name = \"Node\", size = sizeof(Node), finish = node_finish, drop = node_drop, trace = node_trace)\n\nfunc node(value: i64) -> Node*:\n    let n = (Node*)allocate(&node_info)\n    n.value = value\n    return n\n\n## Each test runs in a fresh arena, so what an earlier test left in the buffers is gone\n## with it: the runtime starts over, without freeing.\nfunc fresh():\n    roots = roots[..<0]\n    root_count = 0\n    whites = whites[..<0]\n    white_count = 0\n    pending = pending[..<0]\n    pending_count = 0\n    live = 0\n    logged = 0\n\ntest \"a release at zero destroys: deinit, then the fields\":\n    fresh()\n    let a = node(1)\n    a.next = node(2)\n    release((Object*)a)\n    assert((str)log[..<logged] == \"12\")\n    assert(live == 0)\n\ntest \"a cycle is collected with its deinits in discovery order\":\n    fresh()\n    let a = node(3)\n    let b = node(4)\n    a.next = (Node*)retain((Object*)b)\n    b.next = (Node*)retain((Object*)a)\n    release((Object*)b)\n    release((Object*)a)\n    assert(live == 2)\n    collect()\n    assert(live == 0)\n    # `b` became a candidate first, so the walk finds it first\n    assert((str)log[..<logged] == \"43\")\n\ntest \"a weak reference outlives its object and answers none\":\n    fresh()\n    let a = node(5)\n    let w = weak_make((Object*)a)\n    assert(weak_get(w) != none)\n    release((Object*)a)   # the get above retained\n    assert(live == 1)\n    release((Object*)a)\n    assert(live == 0)\n    assert(weak_get(w) == none)\n    weak_drop(w)\n    assert((str)log[..<logged] == \"5\")\n\ntest \"temporaries drain in the order they were pooled\":\n    fresh()\n    let m = mark()\n    discard(pool_object((Object*)node(6)))\n    discard(pool_object((Object*)node(7)))\n    assert(logged == 0)\n    drain(m)\n    assert((str)log[..<logged] == \"67\")\n    assert(live == 0)\n\ntest \"the run's end reports what is alive\":\n    fresh()\n    let a = node(8)\n    assert(finish_run(0) == 3)\n    release((Object*)a)\n    assert(finish_run(0) == 0)\n",
    "#==============================================================================================\n#\n#   kernel - The runtime of the value language\n#\n#   DESCRIPTION:\n#       What an emitted Luce program calls that Base does not spell itself: Python's `//`,\n#       `%` and `**`, text made of pieces, the display of scalars, indexes and slices with\n#       Luce's bounds and traps, ranges as values, and the list. Every text lives on the heap\n#       and is never freed in this slice; the reference-counted runtime replaces this module\n#       as a whole. Nothing here fails: an allocation that cannot be met traps, as §12\n#       says it must.\n#\n#==============================================================================================\n\nimport c\nimport io\nimport memory\nimport rt.heap\nimport strings\n\nextern func c_pow as \"pow\"(x: f64, y: f64) -> f64\nextern func c_strtod as \"strtod\"(text: c.str, end: c.str*?) -> f64\n\npub let luce_failure: ErrorCode = ErrorCode.package(65535)\n\n# mark: Arithmetic =============================================================================\n\npub func floor_div(a: i64, b: i64) -> i64:\n    let q = a // b\n    if (a % b != 0) and ((a < 0) != (b < 0)):\n        return q - 1\n    return q\n\npub func floor_mod(a: i64, b: i64) -> i64:\n    let r = a % b\n    if r != 0 and ((r < 0) != (b < 0)):\n        return r + b\n    return r\n\npub func power(base: i64, exponent: i64) -> i64:\n    if exponent < 0:\n        trap(\"a negative exponent needs a float base\")\n    var result: i64 = 1\n    var i: i64 = 0\n    while i < exponent:\n        result = result * base\n        i += 1\n    return result\n\npub func floor_float(x: f64) -> f64:\n    let t = f64(i64(x))\n    return t - 1.0 if t > x else t\n\npub func ffloor_div(a: f64, b: f64) -> f64:\n    return floor_float(a / b)\n\npub func ffloor_mod(a: f64, b: f64) -> f64:\n    return a - floor_float(a / b) * b\n\npub func fpower(base: f64, exponent: f64) -> f64:\n    if exponent == f64(i64(exponent)) and exponent >= 0.0 and exponent < 64.0:\n        var result = 1.0\n        var i: i64 = 0\n        while i < i64(exponent):\n            result = result * base\n            i += 1\n        return result\n    return c_pow(base, exponent)\n\npub func to_int(f: f64) -> i64:\n    return i64(f)\n\n# mark: Text ===================================================================================\n\n## Room on the heap, or a trap: Luce's out of memory is not recoverable (§12).\npub func room(n: usize) -> u8[]:\n    let out = alloc u8[n if n > 0 else 1] catch failure:\n        trap(\"out of memory\")\n    return out\n\npub func concat(a: str, b: str) -> str:\n    var out = room(a.length + b.length)\n    memory.copy(out, a.bytes, a.length)\n    memory.copy(out[a.length..], b.bytes, b.length)\n    return (str)out[..<a.length + b.length]\n\n## The pieces of a formatted text, joined.\npub func join(pieces: const str[]) -> str:\n    var n: usize = 0\n    for p in pieces:\n        n += p.length\n    var out = room(n)\n    var at: usize = 0\n    for p in pieces:\n        memory.copy(out[at..], p.bytes, p.length)\n        at += p.length\n    return (str)out[..<n]\n\npub func show_int(i: i64) -> str:\n    var buffer: u8[32]\n    let text = format(buffer, f\"{i}\") catch failure:\n        trap(\"out of memory\")\n    return copy_text(text)\n\npub func show_float(f: f64) -> str:\n    var buffer: u8[64]\n    let text = format(buffer, f\"{f}\") catch failure:\n        trap(\"out of memory\")\n    return copy_text(text)\n\npub func show_bool(b: bool) -> str:\n    return \"true\" if b else \"false\"\n\npub func show_bytes(data: const u8[]) -> str:\n    var b = strings.Builder.create(16) catch failure:\n        trap(\"out of memory\")\n    b.put(\"b\\\"\") catch failure:\n        trap(\"out of memory\")\n    var buffer: u8[4]\n    for byte in data:\n        buffer[0] = '\\\\'\n        buffer[1] = 'x'\n        buffer[2] = hex_digit(byte >> 4)\n        buffer[3] = hex_digit(byte & 15)\n        b.put((str)buffer[..<4]) catch failure:\n            trap(\"out of memory\")\n    b.put(\"\\\"\") catch failure:\n        trap(\"out of memory\")\n    let out = copy_text(b.view())\n    b.destroy()\n    return out\n\nfunc hex_digit(n: u8) -> u8:\n    return '0' + n if n < 10 else 'a' + (n - 10)\n\npub func copy_text(text: str) -> str:\n    var out = room(text.length)\n    memory.copy(out, text.bytes, text.length)\n    return (str)out[..<text.length]\n\npub func print_line(text: str):\n    var out = io.stdout()\n    discard(out.write(text.bytes) catch failure: recover 0)\n    discard(out.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func compare_text(a: str, b: str) -> i64:\n    var i: usize = 0\n    while i < a.length and i < b.length:\n        if a.bytes[i] != b.bytes[i]:\n            return -1 if a.bytes[i] < b.bytes[i] else 1\n        i += 1\n    if a.length == b.length:\n        return 0\n    return -1 if a.length < b.length else 1\n\npub func compare_bytes(a: const u8[], b: const u8[]) -> i64:\n    return compare_text((str)a, (str)b)\n\npub func contains(text: str, needle: str) -> bool:\n    return strings.contains(text, needle)\n\n## Scalars in a text, and a slice by scalar index (§11.3).\npub func scalar_length(s: str) -> i64:\n    var n: i64 = 0\n    for b in s.bytes:\n        if (b & 0xC0) != 0x80:\n            n += 1\n    return n\n\npub func slice_text(s: str, low: i64, high: i64, whole: bool) -> str:\n    let n = scalar_length(s)\n    let hi = n if whole else high\n    check_bounds(low, hi, n)\n    let b = s.bytes\n    var start: usize = b.length\n    var end: usize = b.length\n    var scalar: i64 = 0\n    var i: usize = 0\n    if low == 0:\n        start = 0\n    while i < b.length:\n        if (b[i] & 0xC0) != 0x80:\n            if scalar == low:\n                start = i\n            if scalar == hi:\n                end = i\n                break\n            scalar += 1\n        i += 1\n    return (str)b[start..<end]\n\npub func slice_bytes(data: const u8[], low: i64, high: i64, whole: bool) -> const u8[]:\n    let n = (i64)data.length\n    let hi = n if whole else high\n    check_bounds(low, hi, n)\n    return data[(usize)low..<(usize)hi]\n\npub func check_bounds(low: i64, high: i64, n: i64):\n    if low < 0 or high < low or high > n:\n        trap(\"slice out of range\")\n\n## A Luce index into `count` elements: negative counts from the end; out of range traps.\npub func index(i: i64, count: usize) -> usize:\n    var k = i\n    if k < 0:\n        k += (i64)count\n    if k < 0 or k >= (i64)count:\n        trap(\"index out of range\")\n    return (usize)k\n\n## The scalars of a text, one at a time, as texts of one scalar.\npub struct Scalars:\n    var text: str\n    var at: usize\n\n    pub static func over(text: str) -> Scalars:\n        return Scalars(text = text, at = 0)\n\n    pub mutating func next() -> str?:\n        let b = self.text.bytes\n        if self.at >= b.length:\n            return none\n        var n: usize = 1\n        while self.at + n < b.length and (b[self.at + n] & 0xC0) == 0x80:\n            n += 1\n        let out = (str)b[self.at..<self.at + n]\n        self.at += n\n        return out\n\npub func parse_int(text: str) -> i64!:\n    let n = strings.to_i64(strings.trim(text)) else error(luce_failure, \"not an integer\")\n    return n\n\npub func parse_float(text: str) -> f64!:\n    let t = strings.trim(text)\n    if t.length == 0:\n        error(luce_failure, \"not a number\")\n    var buffer = room(t.length + 1)\n    memory.copy(buffer, t.bytes, t.length)\n    buffer[t.length] = 0\n    return c_strtod((c.str)buffer.data, none)\n\npub func parse_bool(text: str) -> bool!:\n    if text == \"true\":\n        return true\n    if text == \"false\":\n        return false\n    error(luce_failure, \"not a boolean\")\n\n# mark: Ranges =================================================================================\n\npub struct Range:\n    pub var low: i64\n    pub var high: i64\n    pub var inclusive: bool\n\npub func range(low: i64, high: i64, inclusive: bool) -> Range:\n    return Range(low = low, high = high, inclusive = inclusive)\n\npub func in_range(i: i64, r: Range) -> bool:\n    return i >= r.low and (i <= r.high if r.inclusive else i < r.high)\n\npub func range_end(r: Range) -> i64:\n    return r.high + 1 if r.inclusive else r.high\n\npub func show_range(r: Range) -> str:\n    return join([show_int(r.low), \"..=\" if r.inclusive else \"..<\", show_int(r.high)])\n\n# mark: Lists ==================================================================================\n\n## A growable list with identity: a pointer to its storage, shared by every binding.\n# mark: Lists =================================================================================\n\n## What a collection needs of its element type; `none` where the type does not have it.\npub struct Ops[T]:\n    pub var copy: (func(T) -> T)?\n    pub var drop: (func(T) -> unit)?\n    pub var trace: (func(T, func(heap.Object*, void*) -> unit, void*) -> unit)?\n    pub var equal: (func(T, T) -> bool)?\n    pub var compare: (func(T, T) -> i64)?\n    pub var hashed: (func(T) -> u64)?\n\n## `list[T]` (§11.1): an object the collector traces, its elements owned, `version`\n## counting the structural changes a running `for` must not see.\npub struct List[T]:\n    pub var header: heap.Object\n    pub var items: T[]\n    pub var count: usize\n    pub var version: u64\n    pub var ops: Ops[T]\n\npub func list_new[T](info: heap.Info*, ops: Ops[T]) -> List[T]*:\n    let l = (List[T]*)heap.allocate(info)\n    l.items = alloc T[4] catch failure:\n        trap(\"out of memory\")\n    l.count = 0\n    l.version = 0\n    l.ops = ops\n    return l\n\n## A literal: the elements are owned already.\npub func list_of[T](info: heap.Info*, ops: Ops[T], elements: const T[]) -> List[T]*:\n    let l = list_new[T](info, ops)\n    for e in elements:\n        list_push[T](l, e)\n    return l\n\nfunc list_room[T](l: List[T]*, n: usize):\n    if n <= l.items.length:\n        return\n    var size = l.items.length * 2\n    while size < n:\n        size = size * 2\n    let grown = alloc T[size] catch failure:\n        trap(\"out of memory\")\n    memory.copy(grown, l.items, l.count)\n    free(l.items)\n    l.items = grown\n\nfunc list_push[T](l: List[T]*, item: T):\n    list_room[T](l, l.count + 1)\n    l.items[l.count] = item\n    l.count += 1\n\nfunc elem_copy[T](l: List[T]*, v: T) -> T:\n    if let f = l.ops.copy:\n        return f(v)\n    return v\n\nfunc elem_drop[T](l: List[T]*, v: T):\n    if let f = l.ops.drop:\n        f(v)\n\n## `append(x)`: the list takes the value.\npub func list_append[T](l: List[T]*, item: T):\n    list_push[T](l, item)\n    l.version += 1\n\npub func list_insert[T](l: List[T]*, i: i64, item: T):\n    if i < 0 or i > (i64)l.count:\n        trap(\"index out of range\")\n    list_room[T](l, l.count + 1)\n    var k = l.count\n    while k > (usize)i:\n        l.items[k] = l.items[k - 1]\n        k -= 1\n    l.items[(usize)i] = item\n    l.count += 1\n    l.version += 1\n\n## `remove_at(i)`: the element, owned by the caller.\npub func list_remove_at[T](l: List[T]*, i: i64) -> T:\n    let at = index(i, l.count)\n    let out = l.items[at]\n    var k = at\n    while k + 1 < l.count:\n        l.items[k] = l.items[k + 1]\n        k += 1\n    l.count -= 1\n    l.version += 1\n    return out\n\npub func list_pop[T](l: List[T]*) -> T:\n    if l.count == 0:\n        trap(\"pop of an empty list\")\n    l.count -= 1\n    l.version += 1\n    return l.items[l.count]\n\npub func list_clear[T](l: List[T]*):\n    var i: usize = 0\n    while i < l.count:\n        elem_drop[T](l, l.items[i])\n        i += 1\n    l.count = 0\n    l.version += 1\n\n## `values[i]`: a copy of the element, the caller's own.\npub func list_get[T](l: List[T]*, i: i64) -> T:\n    return elem_copy[T](l, l.items[index(i, l.count)])\n\n## `values[i] = x`: the list takes the value and lets the old one go.\npub func list_set[T](l: List[T]*, i: i64, item: T):\n    let at = index(i, l.count)\n    let old = l.items[at]\n    l.items[at] = item\n    elem_drop[T](l, old)\n\npub func list_length[T](l: List[T]*) -> i64:\n    return (i64)l.count\n\npub func list_first[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[0])\n\npub func list_last[T](l: List[T]*) -> T?:\n    if l.count == 0:\n        return none\n    return elem_copy[T](l, l.items[l.count - 1])\n\n## `values[a..<b]`: a new list of copies; bounds checked.\npub func list_slice[T](l: List[T]*, low: i64, high: i64, whole: bool) -> List[T]*:\n    let n = (i64)l.count\n    let end = n if whole else high\n    check_bounds(low, end, n)\n    let out = list_new[T](l.header.info, l.ops)\n    var i = (usize)low\n    while i < (usize)end:\n        list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\npub func list_copy[T](l: List[T]*) -> List[T]*:\n    return list_slice[T](l, 0, 0, true)\n\n## `a + b`: a new list of both.\npub func list_concat[T](a: List[T]*, b: List[T]*) -> List[T]*:\n    let out = list_copy[T](a)\n    var i: usize = 0\n    while i < b.count:\n        list_push[T](out, elem_copy[T](b, b.items[i]))\n        i += 1\n    return out\n\nfunc elem_equal[T](l: List[T]*, a: T, b: T) -> bool:\n    if let f = l.ops.equal:\n        return f(a, b)\n    trap(\"elements without equality\")\n\npub func list_contains[T](l: List[T]*, item: T) -> bool:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return true\n        i += 1\n    return false\n\npub func list_index_of[T](l: List[T]*, item: T) -> i64?:\n    var i: usize = 0\n    while i < l.count:\n        if elem_equal[T](l, l.items[i], item):\n            return (i64)i\n        i += 1\n    return none\n\n## `==` on lists: the same length and equal elements in order (§4.4).\npub func list_equal[T](a: List[T]*, b: List[T]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if not elem_equal[T](a, a.items[i], b.items[i]):\n            return false\n        i += 1\n    return true\n\nfunc elem_compare[T](l: List[T]*, a: T, b: T) -> i64:\n    if let f = l.ops.compare:\n        return f(a, b)\n    trap(\"elements without an ordering\")\n\n## `sort()`: in place, stable, by the elements' ordering; the same algorithm as the\n## interpreter's, an insertion sort, so equal elements keep their order in both.\npub func list_sort[T](l: List[T]*):\n    var i: usize = 1\n    while i < l.count:\n        let v = l.items[i]\n        var k = i\n        while k > 0 and elem_compare[T](l, l.items[k - 1], v) > 0:\n            l.items[k] = l.items[k - 1]\n            k -= 1\n        l.items[k] = v\n        i += 1\n    l.version += 1\n\npub func list_sorted[T](l: List[T]*) -> List[T]*:\n    let out = list_copy[T](l)\n    list_sort[T](out)\n    return out\n\npub func list_reverse[T](l: List[T]*):\n    var i: usize = 0\n    while i + 1 < l.count - i:\n        let tmp = l.items[i]\n        l.items[i] = l.items[l.count - 1 - i]\n        l.items[l.count - 1 - i] = tmp\n        i += 1\n    l.version += 1\n\npub func list_reversed[T](l: List[T]*) -> List[T]*:\n    let out = list_copy[T](l)\n    list_reverse[T](out)\n    return out\n\n## `map(f)`: a new list of `f` over each element, the results owned by it.\npub func list_map[T, U](l: List[T]*, f: func(T) -> U, info: heap.Info*, ops: Ops[U]) -> List[U]*:\n    let out = list_new[U](info, ops)\n    var i: usize = 0\n    while i < l.count:\n        list_push[U](out, f(l.items[i]))\n        i += 1\n    return out\n\npub func list_filter[T](l: List[T]*, f: func(T) -> bool) -> List[T]*:\n    let out = list_new[T](l.header.info, l.ops)\n    var i: usize = 0\n    while i < l.count:\n        if f(l.items[i]):\n            list_push[T](out, elem_copy[T](l, l.items[i]))\n        i += 1\n    return out\n\n## `join(separator)` on a `list[str]`.\npub func list_join(l: List[str]*, separator: str) -> str:\n    var total: usize = 0\n    var i: usize = 0\n    while i < l.count:\n        total += l.items[i].length\n        if i > 0:\n            total += separator.length\n        i += 1\n    let out = room(total)\n    var at: usize = 0\n    i = 0\n    while i < l.count:\n        if i > 0:\n            memory.copy(out[at..], separator.bytes, separator.length)\n            at += separator.length\n        memory.copy(out[at..], l.items[i].bytes, l.items[i].length)\n        at += l.items[i].length\n        i += 1\n    return (str)out[..<total]\n\n## A `for` over a list checks, at the start of every step, that nothing changed its shape.\npub func list_check[T](l: List[T]*, version: u64):\n    if l.version != version:\n        trap(\"the list changed while it was iterated\")\n\n## The runtime's drop and trace of a list, through its descriptor.\npub func list_drop[T](o: heap.Object*):\n    let l = (List[T]*)o\n    var i: usize = 0\n    while i < l.count:\n        elem_drop[T](l, l.items[i])\n        i += 1\n    l.count = 0\n    free(l.items)\n\npub func list_trace[T](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let l = (List[T]*)o\n    if let f = l.ops.trace:\n        var i: usize = 0\n        while i < l.count:\n            f(l.items[i], visit, context)\n            i += 1\n\npub func list_from_args(info: heap.Info*, ops: Ops[str], arguments: str[]) -> List[str]*:\n    let l = list_new[str](info, ops)\n    for a in arguments:\n        list_push[str](l, a)\n    return l\n\n# mark: Displays of collections =================================================================\n\n## Pieces of a display, joined at the end.\npub struct Parts:\n    pub var pieces: str[]\n    pub var count: usize\n\npub func parts() -> Parts:\n    let pieces = alloc str[8] catch failure:\n        trap(\"out of memory\")\n    return Parts(pieces = pieces, count = 0)\n\npub func add_part(p: Parts*, piece: str):\n    if p.count == p.pieces.length:\n        let grown = alloc str[p.pieces.length * 2] catch failure:\n            trap(\"out of memory\")\n        memory.copy(grown, p.pieces, p.count)\n        free(p.pieces)\n        p.pieces = grown\n    p.pieces[p.count] = piece\n    p.count += 1\n\n## `open`, the parts separated by \", \", `close`.\npub func bracketed(p: Parts, open: str, close: str) -> str:\n    var total = open.length + close.length\n    var i: usize = 0\n    while i < p.count:\n        total += p.pieces[i].length + (2 if i > 0 else 0)\n        i += 1\n    let out = room(total)\n    var at: usize = 0\n    memory.copy(out, open.bytes, open.length)\n    at += open.length\n    i = 0\n    while i < p.count:\n        if i > 0:\n            out[at] = ','\n            out[at + 1] = ' '\n            at += 2\n        memory.copy(out[at..], p.pieces[i].bytes, p.pieces[i].length)\n        at += p.pieces[i].length\n        i += 1\n    memory.copy(out[at..], close.bytes, close.length)\n    free(p.pieces)\n    return (str)out[..<total]\n\n## A failure leaving `main`: reported the way the interpreter reports it.\npub func print_error(message: str):\n    var err = io.stderr()\n    discard(err.write(\"error: \".bytes) catch failure: recover 0)\n    discard(err.write(message.bytes) catch failure: recover 0)\n    discard(err.write(\"\\n\".bytes) catch failure: recover 0)\n\npub func show_text(s: str) -> str:\n    return s\n\n# mark: Hashing =================================================================================\n\n## FNV-1a over 64 bits, the function docs/RUNTIME.md states; the emitted program feeds it\n## a value's canonical bytes through these.\npub let hash_offset: u64 = 14695981039346656037\n\npub func hash_bytes(h: u64, data: const u8[]) -> u64:\n    var out = h\n    for b in data:\n        out = (out ^ (u64)b) *% 1099511628211\n    return out\n\npub func hash_byte(h: u64, b: u8) -> u64:\n    return (h ^ (u64)b) *% 1099511628211\n\npub func hash_int(h: u64, i: i64) -> u64:\n    var out = h\n    var bits = (u64)i\n    var k: u32 = 0\n    while k < 8:\n        out = hash_byte(out, (u8)(bits & 255))\n        bits = bits >> 8\n        k += 1\n    return out\n\npub func hash_float(h: u64, f: f64) -> u64:\n    let normal = 0.0 if f == 0.0 else f\n    return hash_int(h, (i64)normal.bits())\n\npub func hash_bool(h: u64, b: bool) -> u64:\n    return hash_byte(h, 1 if b else 0)\n\n## Text and bytes end in 255, so that neighbouring texts keep their boundary.\npub func hash_text(h: u64, s: str) -> u64:\n    return hash_byte(hash_bytes(h, s.bytes), 255)\n\npub func hash_blob(h: u64, data: const u8[]) -> u64:\n    return hash_byte(hash_bytes(h, data), 255)\n\npub func hash_range(h: u64, r: Range) -> u64:\n    return hash_byte(hash_int(hash_int(h, r.low), r.high), 1 if r.inclusive else 0)\n\n# mark: Maps and sets ==========================================================================\n\n## `map[K, V]` and `set[T]` (§11.2): entries in insertion order in `keys` and `values`, an\n## open-addressed index from a key's hash to its entry, a removal closing the gap. A set\n## is a map to a byte.\npub struct Map[K, V]:\n    pub var header: heap.Object\n    pub var keys: K[]\n    pub var values: V[]\n    pub var hashes: u64[]\n    pub var count: usize\n    pub var version: u64\n    ## Entry index + 1 per slot; 0 is empty. Twice the capacity, a power of two.\n    pub var index: u32[]\n    pub var key_ops: Ops[K]\n    pub var value_ops: Ops[V]\n\npub func map_new[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V]) -> Map[K, V]*:\n    let m = (Map[K, V]*)heap.allocate(info)\n    m.keys = alloc K[4] catch failure:\n        trap(\"out of memory\")\n    m.values = alloc V[4] catch failure:\n        trap(\"out of memory\")\n    m.hashes = alloc u64[4] catch failure:\n        trap(\"out of memory\")\n    m.index = alloc u32[8] catch failure:\n        trap(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    m.count = 0\n    m.version = 0\n    m.key_ops = key_ops\n    m.value_ops = value_ops\n    return m\n\n## A literal: the keys and values are owned already; a repeated key keeps the last value.\npub func map_of[K, V](info: heap.Info*, key_ops: Ops[K], value_ops: Ops[V], keys: const K[], values: const V[]) -> Map[K, V]*:\n    let m = map_new[K, V](info, key_ops, value_ops)\n    var i: usize = 0\n    while i < keys.length:\n        map_set[K, V](m, keys[i], values[i])\n        i += 1\n    return m\n\nfunc key_hash[K, V](m: Map[K, V]*, key: K) -> u64:\n    if let f = m.key_ops.hashed:\n        return f(key)\n    trap(\"keys without a hash\")\n\nfunc key_equal[K, V](m: Map[K, V]*, a: K, b: K) -> bool:\n    if let f = m.key_ops.equal:\n        return f(a, b)\n    trap(\"keys without equality\")\n\nfunc key_copy[K, V](m: Map[K, V]*, k: K) -> K:\n    if let f = m.key_ops.copy:\n        return f(k)\n    return k\n\nfunc key_drop[K, V](m: Map[K, V]*, k: K):\n    if let f = m.key_ops.drop:\n        f(k)\n\nfunc value_copy[K, V](m: Map[K, V]*, v: V) -> V:\n    if let f = m.value_ops.copy:\n        return f(v)\n    return v\n\nfunc value_drop[K, V](m: Map[K, V]*, v: V):\n    if let f = m.value_ops.drop:\n        f(v)\n\n## The entry of `key`, or none.\nfunc map_find[K, V](m: Map[K, V]*, key: K, h: u64) -> usize?:\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        let entry = (usize)m.index[at] - 1\n        if m.hashes[entry] == h and key_equal[K, V](m, m.keys[entry], key):\n            return entry\n        at = (at + 1) & mask\n    return none\n\nfunc map_reindex[K, V](m: Map[K, V]*, slots: usize):\n    if m.index.length != slots:\n        free(m.index)\n        m.index = alloc u32[slots] catch failure:\n            trap(\"out of memory\")\n    memory.set(u8[]((u8*)m.index.data, m.index.length * 4), 0)\n    let mask = slots - 1\n    var i: usize = 0\n    while i < m.count:\n        var at = (usize)m.hashes[i] & mask\n        while m.index[at] != 0:\n            at = (at + 1) & mask\n        m.index[at] = u32(i + 1)\n        i += 1\n\nfunc map_room[K, V](m: Map[K, V]*, n: usize):\n    if n <= m.keys.length:\n        return\n    var size = m.keys.length * 2\n    while size < n:\n        size = size * 2\n    let keys = alloc K[size] catch failure:\n        trap(\"out of memory\")\n    let values = alloc V[size] catch failure:\n        trap(\"out of memory\")\n    let hashes = alloc u64[size] catch failure:\n        trap(\"out of memory\")\n    memory.copy(keys, m.keys, m.count)\n    memory.copy(values, m.values, m.count)\n    memory.copy(hashes, m.hashes, m.count)\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    m.keys = keys\n    m.values = values\n    m.hashes = hashes\n    map_reindex[K, V](m, size * 2)\n\n## `m[key] = value`: the map takes both; an existing key keeps its place and lets its old\n## value go, and the given key is let go of.\npub func map_set[K, V](m: Map[K, V]*, key: K, value: V):\n    let h = key_hash[K, V](m, key)\n    if let entry = map_find[K, V](m, key, h):\n        let old = m.values[entry]\n        m.values[entry] = value\n        value_drop[K, V](m, old)\n        key_drop[K, V](m, key)\n        return\n    map_room[K, V](m, m.count + 1)\n    m.keys[m.count] = key\n    m.values[m.count] = value\n    m.hashes[m.count] = h\n    let mask = m.index.length - 1\n    var at = (usize)h & mask\n    while m.index[at] != 0:\n        at = (at + 1) & mask\n    m.index[at] = u32(m.count + 1)\n    m.count += 1\n    m.version += 1\n\n## `m[key]`: a copy of the value, or none.\npub func map_get[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    return value_copy[K, V](m, m.values[entry])\n\npub func map_contains[K, V](m: Map[K, V]*, key: K) -> bool:\n    return map_find[K, V](m, key, key_hash[K, V](m, key)) != none\n\n## `m.remove(key)`: the value, the caller's own, or none; the rest keep their order.\npub func map_remove[K, V](m: Map[K, V]*, key: K) -> V?:\n    let entry = map_find[K, V](m, key, key_hash[K, V](m, key)) else return none\n    let out = m.values[entry]\n    key_drop[K, V](m, m.keys[entry])\n    var i = entry\n    while i + 1 < m.count:\n        m.keys[i] = m.keys[i + 1]\n        m.values[i] = m.values[i + 1]\n        m.hashes[i] = m.hashes[i + 1]\n        i += 1\n    m.count -= 1\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n    return out\n\npub func map_length[K, V](m: Map[K, V]*) -> i64:\n    return (i64)m.count\n\npub func map_clear[K, V](m: Map[K, V]*):\n    var i: usize = 0\n    while i < m.count:\n        key_drop[K, V](m, m.keys[i])\n        value_drop[K, V](m, m.values[i])\n        i += 1\n    m.count = 0\n    m.version += 1\n    map_reindex[K, V](m, m.index.length)\n\npub func map_copy[K, V](m: Map[K, V]*) -> Map[K, V]*:\n    let out = map_new[K, V](m.header.info, m.key_ops, m.value_ops)\n    var i: usize = 0\n    while i < m.count:\n        map_set[K, V](out, key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `m.keys()`, `m.values()`: new lists of copies, in entry order.\npub func map_keys[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[K]) -> List[K]*:\n    let out = list_new[K](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[K](out, key_copy[K, V](m, m.keys[i]))\n        i += 1\n    return out\n\npub func map_values[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[V]) -> List[V]*:\n    let out = list_new[V](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[V](out, value_copy[K, V](m, m.values[i]))\n        i += 1\n    return out\n\n## `==` on maps: the same keys, each with an equal value (§4.4).\npub func map_equal[K, V](a: Map[K, V]*, b: Map[K, V]*) -> bool:\n    if a.count != b.count:\n        return false\n    let f = a.value_ops.equal else trap(\"values without equality\")\n    var i: usize = 0\n    while i < a.count:\n        let entry = map_find[K, V](b, a.keys[i], a.hashes[i]) else return false\n        if not f(a.values[i], b.values[entry]):\n            return false\n        i += 1\n    return true\n\npub func map_check[K, V](m: Map[K, V]*, version: u64):\n    if m.version != version:\n        trap(\"the map changed while it was iterated\")\n\npub func map_drop[K, V](o: heap.Object*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        key_drop[K, V](m, m.keys[i])\n        value_drop[K, V](m, m.values[i])\n        i += 1\n    m.count = 0\n    free(m.keys)\n    free(m.values)\n    free(m.hashes)\n    free(m.index)\n\npub func map_trace[K, V](o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    let m = (Map[K, V]*)o\n    var i: usize = 0\n    while i < m.count:\n        if let f = m.key_ops.trace:\n            f(m.keys[i], visit, context)\n        if let g = m.value_ops.trace:\n            g(m.values[i], visit, context)\n        i += 1\n\n## The hash of a map or a set as docs/RUNTIME.md states: entry hashes summed, wrapping.\npub func map_hash[K, V](m: Map[K, V]*) -> u64:\n    let f = m.value_ops.hashed else trap(\"values without a hash\")\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% (m.hashes[i] *% 31 +% f(m.values[i]))\n        i += 1\n    return sum\n\n# -- sets, as maps to a byte -------------------------------------------------------------\n\npub func set_hash[K](m: Map[K, u8]*) -> u64:\n    var sum: u64 = 0\n    var i: usize = 0\n    while i < m.count:\n        sum = sum +% m.hashes[i]\n        i += 1\n    return sum\n\nfunc byte_ops() -> Ops[u8]:\n    return Ops[u8](copy = none, drop = none, trace = none, equal = none, compare = none, hashed = none)\n\npub func set_of[K](info: heap.Info*, ops: Ops[K], elements: const K[]) -> Map[K, u8]*:\n    let s = map_new[K, u8](info, ops, byte_ops())\n    for e in elements:\n        set_insert[K](s, e)\n    return s\n\n## `s.insert(x)`: the set takes the value, or lets it go when it is there already.\npub func set_insert[K](s: Map[K, u8]*, key: K):\n    map_set[K, u8](s, key, 0)\n\npub func set_remove[K](s: Map[K, u8]*, key: K) -> bool:\n    return map_remove[K, u8](s, key) != none\n\npub func set_union[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_copy[K, u8](a)\n    var i: usize = 0\n    while i < b.count:\n        set_insert[K](out, key_copy[K, u8](b, b.keys[i]))\n        i += 1\n    return out\n\npub func set_intersection[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) != none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\npub func set_difference[K](a: Map[K, u8]*, b: Map[K, u8]*) -> Map[K, u8]*:\n    let out = map_new[K, u8](a.header.info, a.key_ops, a.value_ops)\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            set_insert[K](out, key_copy[K, u8](a, a.keys[i]))\n        i += 1\n    return out\n\n## `==` on sets: the same elements (§4.4).\npub func set_equal[K](a: Map[K, u8]*, b: Map[K, u8]*) -> bool:\n    if a.count != b.count:\n        return false\n    var i: usize = 0\n    while i < a.count:\n        if map_find[K, u8](b, a.keys[i], a.hashes[i]) == none:\n            return false\n        i += 1\n    return true\n\npub func set_new[K](info: heap.Info*, ops: Ops[K]) -> Map[K, u8]*:\n    return map_new[K, u8](info, ops, byte_ops())\n\n## `m.items()`: a new list of key, value pairs, copies, in entry order.\npub func map_items[K, V](m: Map[K, V]*, info: heap.Info*, ops: Ops[(K, V)]) -> List[(K, V)]*:\n    let out = list_new[(K, V)](info, ops)\n    var i: usize = 0\n    while i < m.count:\n        list_push[(K, V)](out, (key_copy[K, V](m, m.keys[i]), value_copy[K, V](m, m.values[i])))\n        i += 1\n    return out\n\n# mark: Text operations (§11.3) ================================================================\n\nfunc find_bytes(haystack: const u8[], needle: const u8[], start: usize) -> usize?:\n    if needle.length == 0:\n        return start\n    var i = start\n    while i + needle.length <= haystack.length:\n        var k: usize = 0\n        while k < needle.length and haystack[i + k] == needle[k]:\n            k += 1\n        if k == needle.length:\n            return i\n        i += 1\n    return none\n\npub func starts_with(text: str, prefix: str) -> bool:\n    if prefix.length > text.length:\n        return false\n    return compare_bytes(text.bytes[..<prefix.length], prefix.bytes) == 0\n\npub func ends_with(text: str, suffix: str) -> bool:\n    if suffix.length > text.length:\n        return false\n    return compare_bytes(text.bytes[text.length - suffix.length..], suffix.bytes) == 0\n\n## The scalar index of the first occurrence, or none.\npub func index_of(text: str, needle: str) -> i64?:\n    let at = find_bytes(text.bytes, needle.bytes, 0) else return none\n    return scalar_length((str)text.bytes[..<at])\n\npub func split(text: str, separator: str, info: heap.Info*, ops: Ops[str]) -> List[str]*:\n    if separator.length == 0:\n        trap(\"split needs a separator\")\n    let out = list_new[str](info, ops)\n    var start: usize = 0\n    while true:\n        let at = find_bytes(text.bytes, separator.bytes, start) else break\n        list_push[str](out, copy_text((str)text.bytes[start..<at]))\n        start = at + separator.length\n    list_push[str](out, copy_text((str)text.bytes[start..]))\n    return out\n\npub func lines(text: str, info: heap.Info*, ops: Ops[str]) -> List[str]*:\n    let out = list_new[str](info, ops)\n    let b = text.bytes\n    var start: usize = 0\n    var i: usize = 0\n    while i < b.length:\n        if b[i] == '\\n':\n            var end = i\n            if end > start and b[end - 1] == '\\r':\n                end -= 1\n            list_push[str](out, copy_text((str)b[start..<end]))\n            start = i + 1\n        i += 1\n    if start < b.length:\n        list_push[str](out, copy_text((str)b[start..]))\n    return out\n\nfunc is_space(byte: u8) -> bool:\n    return byte == ' ' or byte == '\\t' or byte == '\\n' or byte == '\\r'\n\npub func trim(text: str) -> str:\n    let b = text.bytes\n    var start: usize = 0\n    var end = b.length\n    while start < end and is_space(b[start]):\n        start += 1\n    while end > start and is_space(b[end - 1]):\n        end -= 1\n    return (str)b[start..<end]\n\npub func upper(text: str) -> str:\n    let out = room(text.length)\n    var i: usize = 0\n    while i < text.length:\n        let byte = text.bytes[i]\n        out[i] = byte - 32 if byte >= 'a' and byte <= 'z' else byte\n        i += 1\n    return (str)out[..<text.length]\n\npub func lower(text: str) -> str:\n    let out = room(text.length)\n    var i: usize = 0\n    while i < text.length:\n        let byte = text.bytes[i]\n        out[i] = byte + 32 if byte >= 'A' and byte <= 'Z' else byte\n        i += 1\n    return (str)out[..<text.length]\n\npub func replace(text: str, old: str, new_text: str) -> str:\n    if old.length == 0:\n        trap(\"replace needs a text to replace\")\n    var count: usize = 0\n    var start: usize = 0\n    while true:\n        let at = find_bytes(text.bytes, old.bytes, start) else break\n        count += 1\n        start = at + old.length\n    let total = text.length - count * old.length + count * new_text.length\n    let out = room(total)\n    var at_out: usize = 0\n    start = 0\n    while true:\n        let at = find_bytes(text.bytes, old.bytes, start) else break\n        memory.copy(out[at_out..], text.bytes[start..<at], at - start)\n        at_out += at - start\n        memory.copy(out[at_out..], new_text.bytes, new_text.length)\n        at_out += new_text.length\n        start = at + old.length\n    memory.copy(out[at_out..], text.bytes[start..], text.length - start)\n    at_out += text.length - start\n    return (str)out[..<at_out]\n\npub func repeat(text: str, n: i64) -> str:\n    if n < 0:\n        trap(\"repeat of a negative count\")\n    let total = text.length * (usize)n\n    let out = room(total)\n    var i: usize = 0\n    while i < (usize)n:\n        memory.copy(out[i * text.length..], text.bytes, text.length)\n        i += 1\n    return (str)out[..<total]\n\n## `bytes.text()`: the bytes as text when they are UTF-8 (§11.4).\npub func decode_text(data: const u8[]) -> str!:\n    if not valid_utf8(data):\n        error(luce_failure, \"invalid UTF-8\")\n    return copy_text((str)data)\n\nfunc valid_utf8(b: const u8[]) -> bool:\n    var i: usize = 0\n    while i < b.length:\n        let lead = b[i]\n        var n: usize = 0\n        if lead < 0x80:\n            n = 0\n        elif lead >= 0xC2 and lead <= 0xDF:\n            n = 1\n        elif lead >= 0xE0 and lead <= 0xEF:\n            n = 2\n        elif lead >= 0xF0 and lead <= 0xF4:\n            n = 3\n        else:\n            return false\n        var k: usize = 1\n        while k <= n:\n            if i + k >= b.length or (b[i + k] & 0xC0) != 0x80:\n                return false\n            k += 1\n        if n == 2 and lead == 0xE0 and b[i + 1] < 0xA0:\n            return false\n        if n == 2 and lead == 0xED and b[i + 1] >= 0xA0:\n            return false\n        if n == 3 and lead == 0xF0 and b[i + 1] < 0x90:\n            return false\n        if n == 3 and lead == 0xF4 and b[i + 1] >= 0x90:\n            return false\n        i += n + 1\n    return true\n\npub func concat_bytes(a: const u8[], b: const u8[]) -> const u8[]:\n    let out = room(a.length + b.length)\n    memory.copy(out, a, a.length)\n    memory.copy(out[a.length..], b, b.length)\n    return out[..<a.length + b.length]\n"
]
