pub let names: str[8] = ["kernel/ORDER", "kernel/builtins.lucb", "kernel/kernel.lucb", "kernel/list_methods.lucb", "kernel/lists.lucb", "kernel/maps.lucb", "kernel/text.lucb", "number_text.lucb"]
