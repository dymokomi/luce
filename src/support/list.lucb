#==============================================================================================
#
#   list - A growable span over the current allocator
#
#   DESCRIPTION:
#       Base has no built-in collections (base.md §1.3); this is the one the compiler
#       uses. `List[T]` owns a span it doubles when full, allocated from the allocator
#       current at creation, and gives the old block back to that allocator as it grows,
#       so element pointers taken between pushes are valid only until the next growth.
#
#==============================================================================================

import memory

## A growable array of `T` over the allocator current at creation.
pub struct List[T]:
    ## The storage; `items[..<count]` are the live elements.
    pub var items: T[]
    ## How many of `items` are live.
    pub var count: usize
    var allocator: memory.Allocator

    ## An empty list with room for `capacity` elements (4 when zero).
    pub func create(capacity: usize) -> List[T]!:
        let room = capacity if capacity > 0 else 4
        return List[T](items = try new T[room] ---, count = 0, allocator = memory.allocator)

    ## Appends `item`, doubling the storage when full.
    pub func push(item: T) -> !:
        if self.count == self.items.length:
            let grown = try new T[self.items.length * 2] --- in self.allocator
            memory.copy(grown, self.items, self.count)
            free(self.items) in self.allocator
            self.items = grown
        self.items[self.count] = item
        self.count += 1

    ## The element at `index`, which must be below `count`.
    pub func get(index: usize) -> T:
        return self.items[index]

    ## Replaces the element at `index`, which must be below `count`.
    pub func set(index: usize, item: T):
        self.items[index] = item

    ## The live elements as a span; invalid after the next push.
    pub func span() -> T[]:
        return self.items[..<self.count]

    ## Gives the storage back; the list is not used again.
    pub func destroy():
        free(self.items) in self.allocator

test "a list grows and keeps order":
    var backing: u8[4096]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var xs = try List[i64].create(1)
        var i: i64 = 0
        while i < 20:
            try xs.push(i * 3)
            i += 1
        assert(xs.count == 20)
        assert(xs.get(19) == 57)
        var total: i64 = 0
        for x in xs.span():
            total += x
        assert(total == 570)
