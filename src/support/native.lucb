#==============================================================================================
#
#   native - Native inputs
#
#   DESCRIPTION:
#       Native inputs are resolved by Base, then merged before temporary package
#       emission. Absolute source/search paths preserve the declaring package's root.
#
#==============================================================================================
import c
import io
import os
import luce_std.process
import strings
import support.buffer
import support.list
import support.module_paths
import support.toolchain

## Base reported native inputs this compiler cannot read or did not expect.
pub let invalid: ErrorCode = ErrorCode.package(26)

## One native input a package declares: its kind and its value, both owned.
pub struct Input:
    ## `sources`, `link_search`, `libraries`, `frameworks`, or `pkg_config`.
    pub let kind: str
    ## The path, library, framework, or pkg-config name.
    pub let value: str

## The native inputs of a build, each once, in the order reported.
pub struct Inputs:
    ## The inputs, owned until `destroy`.
    pub var entries: list.List[Input]

    ## An empty set.
    pub static func create() -> Inputs!:
        return Inputs(try list.List[Input].create(8))

    ## Adds an input, copying it; one already present is not added twice.
    pub mutating func add(kind: str, value: str) -> !:
        if kind != "sources" and kind != "link_search" and kind != "libraries" and kind != "frameworks" and kind != "pkg_config":
            error(invalid, "Base reported an unknown native input")
        for entry in self.entries.span():
            if entry.kind == kind and entry.value == value:
                return
        let owned_kind = try strings.copy(kind)
        errdefer strings.release(owned_kind)
        let owned_value = try strings.copy(value)
        errdefer strings.release(owned_value)
        try self.entries.push(Input(owned_kind, owned_value))

    ## The native inputs of the manifests owning `paths`, from one `native-inputs` run.
    pub mutating func collect(paths: const str[]) -> !:
        if paths.length == 0:
            return
        let compiler = try strings.copy((str)(try toolchain.base_compiler()))
        defer strings.release(compiler)
        # each path terminated, as a C argument must be
        var owned = try list.List[str].create(paths.length)
        defer:
            for text in owned.span():
                strings.release(text)
            owned.destroy()
        let arguments = try alloc c.str[paths.length + 1]
        defer free(arguments)
        arguments[0] = "native-inputs"
        for k in 0..<paths.length:
            try owned.push(try strings.copy(paths[k]))
            arguments[k + 1] = (c.str)owned.get(k)
        let ran = try process.run((c.str)compiler, arguments)
        defer ran.release()
        let status = ran.value.exit_code
        let output = ran.value.output
        let diagnostic = ran.value.error_output
        if status == 127 and output.length == 0 and diagnostic.length == 0:
            error(invalid, "the Base compiler cannot be run; LUCE_BASE names it")
        if status != 0:
            discard(try io.stderr().write(diagnostic.bytes))
            error(invalid, "Base could not resolve the package's native inputs")
        let header = module_paths.dependency_header
        if not strings.starts_with(output, header):
            error(invalid, "the Base compiler returned an unsupported dependency format")
        var at = header.length
        while at < output.length:
            let record = try field(output, &at)
            let kind = try field(output, &at)
            let value = try field(output, &at)
            if record != "native":
                error(invalid, "Base reported an unexpected native input record")
            try self.add(kind, value)

    ## Writes the inputs as the generated package manifest's `native "inputs"` block,
    ## one list per kind; nothing when there are none.
    pub func write(out: buffer.Buffer*) -> !:
        if self.entries.count == 0:
            return
        try out.put("    def native \"inputs\" {\n")
        let kinds: str[5] = ["sources", "link_search", "libraries", "frameworks", "pkg_config"]
        for kind in kinds:
            try out.write(f"        str[] {kind} = [")
            var first = true
            for entry in self.entries.span():
                if entry.kind == kind:
                    if not first:
                        try out.put(", ")
                    try quoted(out, entry.value)
                    first = false
            try out.put("]\n")
        try out.put("    }\n")

    ## Releases every input the set owns.
    pub mutating func destroy():
        for entry in self.entries.span():
            strings.release(entry.kind)
            strings.release(entry.value)
        self.entries.destroy()
        self.entries.count = 0

func field(text: str, at: usize*) -> str!:
    return try module_paths.next_field(text, at, invalid, "Base returned a truncated native input record")

func quoted(out: buffer.Buffer*, value: str) -> !:
    try out.put("\"")
    for byte in value.bytes:
        if byte == '"' or byte == '\\':
            try out.put("\\")
        if byte == '\n':
            try out.put("\\n")
        elif byte == '\r':
            try out.put("\\r")
        elif byte == '\t':
            try out.put("\\t")
        else:
            let bytes: u8[1] = [byte]
            try out.put((str)bytes)
    try out.put("\"")
