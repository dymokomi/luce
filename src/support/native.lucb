## Link requirements must survive the temporary Base workspace. Retain the
## project's native link configuration; Base owns parsing and platform policy.
import c
import files
import memory
import strings

pub let unsupported: ErrorCode = ErrorCode.package(26)

pub func read(path: str) -> str!:
    let terminated = try alloc u8[path.length + 1]
    memory.copy(terminated, path.bytes, path.length)
    terminated[path.length] = 0
    let data = try files.read((c.str)terminated.data)
    let output = try alloc u8[data.length + 1]
    var used: usize = 0
    var at: usize = 0
    var active = false
    while at < data.length:
        var end = at
        while end < data.length and data[end] != '\n':
            end += 1
        let raw = (str)data[at..<end]
        let line = strings.trim(raw)
        if line.length > 0 and line.bytes[0] == '[':
            active = line == "[native]"
        if active:
            # Relative native source/search paths need source staging, not a copy
            # into an unrelated temporary directory. Refuse them explicitly until
            # that support exists instead of silently dropping their requirements.
            if let equal = strings.find(line, "="):
                let key = strings.trim((str)line.bytes[..<equal])
                if key == "sources" or key == "link_search":
                    error(unsupported, "Luce native manifests currently support libraries, frameworks, and pkg_config; source/search paths require a Base build")
            memory.copy(output[used..], raw.bytes, raw.length)
            used += raw.length
            output[used] = '\n'
            used += 1
        at = end + 1
    return (str)output[..<used]
