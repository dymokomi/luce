## Native inputs are resolved by Base, then merged before temporary package
## emission. Absolute source/search paths preserve the declaring package's root.
import c
import io
import os
import process
import strings
import support.buffer
import support.list

pub let invalid: ErrorCode = ErrorCode.package(26)

pub struct Input:
    pub let kind: str
    pub let value: str

pub struct Inputs:
    pub var entries: list.List[Input]

    pub static func create() -> Inputs!:
        return Inputs(try list.List[Input].create(8))

    pub mutating func add(kind: str, value: str) -> !:
        if kind != "sources" and kind != "link_search" and kind != "libraries" and kind != "frameworks" and kind != "pkg_config":
            error(invalid, "Base reported an unknown native input")
        for entry in self.entries.span():
            if entry.kind == kind and entry.value == value:
                return
        let owned_kind = try strings.copy(kind)
        errdefer strings.release(owned_kind)
        let owned_value = try strings.copy(value)
        errdefer strings.release(owned_value)
        try self.entries.push(Input(owned_kind, owned_value))

    pub mutating func collect(path: str) -> !:
        let compiler = try strings.copy(os.env("LUCE_BASE") else "luce-base")
        defer strings.release(compiler)
        let source = try strings.copy(path)
        defer strings.release(source)
        let (status, output, diagnostic) = try process.run((c.str)compiler, [(c.str)"native-inputs", (c.str)source])
        defer process.release(output)
        defer process.release(diagnostic)
        if status == 127 and output.length == 0 and diagnostic.length == 0:
            error(invalid, "the Base compiler cannot be run; LUCE_BASE names it")
        if status != 0:
            discard(try io.stderr().write(diagnostic.bytes))
            error(invalid, "Base could not resolve the package's native inputs")
        let header = "luce-base-dependencies-v3\0"
        if not strings.starts_with(output, header):
            error(invalid, "the Base compiler returned an unsupported dependency format")
        var at = header.length
        while at < output.length:
            let record = try field(output, &at)
            let kind = try field(output, &at)
            let value = try field(output, &at)
            if record != "native":
                error(invalid, "Base reported an unexpected native input record")
            try self.add(kind, value)

    pub func write(out: buffer.Buffer*) -> !:
        if self.entries.count == 0:
            return
        try out.put("\n[native]\n")
        let kinds: str[5] = ["sources", "link_search", "libraries", "frameworks", "pkg_config"]
        for kind in kinds:
            try out.write(f"{kind} = [")
            var first = true
            for entry in self.entries.span():
                if entry.kind == kind:
                    if not first:
                        try out.put(", ")
                    try quoted(out, entry.value)
                    first = false
            try out.put("]\n")

    pub mutating func destroy():
        for entry in self.entries.span():
            strings.release(entry.kind)
            strings.release(entry.value)
        self.entries.destroy()
        self.entries.count = 0

func field(text: str, at: usize*) -> str!:
    let end = strings.find_from(text, "\0", *at) else error(invalid, "Base returned a truncated native input record")
    let value = (str)text.bytes[*at..<end]
    *at = end + 1
    return value

func quoted(out: buffer.Buffer*, value: str) -> !:
    try out.put("\"")
    for byte in value.bytes:
        if byte == '"' or byte == '\\':
            try out.put("\\")
        if byte == '\n':
            try out.put("\\n")
        elif byte == '\r':
            try out.put("\\r")
        elif byte == '\t':
            try out.put("\\t")
        else:
            let bytes: u8[1] = [byte]
            try out.put((str)bytes)
    try out.put("\"")
