#==============================================================================================
#
#   copied - Standard-library answers as plain values
#
#   DESCRIPTION:
#       luce-std hands an allocated answer back as an owned result the caller releases. The
#       compiler keeps what it reads and resolves as plain values in the current allocator,
#       which it frees as it frees its own text (`free`, `strings.release`), or never; these
#       ask in the heap, copy the answer into the current allocator and release the result.
#
#==============================================================================================
import c
import luce_std.files
import luce_std.paths
import memory

## The whole file at `path`, in the current allocator.
pub func read(path: c.str) -> u8[]!:
    let caller = memory.allocator
    with memory.heap:
        let whole = try files.read(path)
        defer whole.release()
        let copy = try alloc u8[whole.value.length] in caller
        memory.copy(copy, whole.value, copy.length)
        return copy

## The absolute path of the existing entry at `path`, through symlinks (`files.canonical`),
## NUL-terminated in the current allocator.
pub func canonical(path: c.str) -> str!:
    let caller = memory.allocator
    with memory.heap:
        let resolved = try files.canonical(path)
        defer resolved.release()
        return try terminated(resolved.value, caller)

## `path` without dot components, redundant separators and cancellable parents
## (`paths.normalize`), NUL-terminated in the current allocator.
pub func normalize(path: str) -> str!:
    let caller = memory.allocator
    with memory.heap:
        let normalized = try paths.normalize(path)
        defer normalized.release()
        return try terminated(normalized.value, caller)

## `left` and `right` joined as `paths.join` joins them, NUL-terminated in the current
## allocator.
pub func join(left: str, right: str) -> str!:
    # the separator and the NUL are the most a join adds
    return paths.join_into(try alloc u8[left.length + right.length + 2], left, right)

func terminated(text: str, allocator: memory.Allocator) -> str!:
    let copy = try alloc u8[text.length + 1] in allocator
    memory.copy(copy, text.bytes, text.length)
    copy[text.length] = 0
    return (str)copy[..<text.length]
