#==============================================================================================
#
#   numerals - Numbers as text: format specifications, decimal rounding, integers in a base
#
#   DESCRIPTION:
#       What a formatted string's `{value:spec}` field, `math.round(x, digits)` and
#       `int(text, base)` do (luce.md §3.3, §6.5, §6.8), as Python does them: the format
#       mini-language read and laid out as CPython's `format` lays it out, and the decimal
#       digits of a float made exactly and rounded half to even, as David Gay's dtoa rounds
#       them. Both executions run this one module: the interpreter imports it, and the
#       emitted program carries it beside the kernel (tools/embed_runtime.py), so a field
#       prints the same bytes in both. Every text it returns is the caller's, given back with
#       `strings.release`. It traps only when memory runs out; the rules a Luce program can
#       break, a scalar out of range or a base out of range, its callers check.
#
#==============================================================================================

import float_text
import strings

# mark: Specifications =========================================================================

## A format specification read: `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`
## (§3.3). A part not written is `0`, `-1` or empty, so a default can still be told apart.
pub struct Spec:
    ## The fill scalar, as written; empty when none was.
    pub var fill: str
    ## `<`, `>`, `^` or `=`; 0 when none was written.
    pub var align: u8
    ## `+`, `-` or a space; 0 when none was written.
    pub var sign: u8
    ## `z`: a negative zero, after rounding, shows as zero.
    pub var no_negative_zero: bool
    ## `#`: the alternate form, a base's prefix or a point always kept.
    pub var alternate: bool
    ## `0` before the width: zeros fill a number after its sign.
    pub var zero: bool
    ## The least width in scalars; -1 when none was written.
    pub var width: i64
    ## `,` or `_` between groups of digits; 0 when none was written.
    pub var grouping: u8
    ## The digits after the point, or the scalars a text keeps; -1 when none was written.
    pub var precision: i64
    ## The type letter; 0 when none was written.
    pub var kind: u8

## A specification read from its text, and what is wrong with it: empty when nothing is.
pub struct Reading:
    ## The specification, meaningful when `problem` is empty.
    pub var spec: Spec
    ## Why the text is not a specification; empty when it is one.
    pub var problem: str

## What a field shows: an `int`, a `float`, or the display of anything else (§10.5).
pub enum Category:
    integer
    floating
    text

func is_align(byte: u8) -> bool:
    return byte == '<' or byte == '>' or byte == '^' or byte == '='

## The byte length of the UTF-8 scalar starting with `lead`.
func scalar_bytes(lead: u8) -> usize:
    if lead < 0x80:
        return 1
    if lead < 0xE0:
        return 2
    if lead < 0xF0:
        return 3
    return 4

## The scalars of a UTF-8 text.
pub func scalar_count(text: str) -> i64:
    var n: i64 = 0
    for b in text.bytes:
        if (b & 0xC0) != 0x80:
            n += 1
    return n

## Digits read from `at` as a width or a precision; how many there were, -1 when too many.
func read_count(b: const u8[], at: usize*, value: i64*) -> i64:
    var n: i64 = 0
    var total: i64 = 0
    while *at < b.length and b[*at] >= '0' and b[*at] <= '9':
        total = total * 10 + (i64)(b[*at] - '0')
        if total > 1000000000:
            return -1
        n += 1
        *at += 1
    *value = total
    return n

## Read `text` as CPython's parse_internal_render_format_spec reads a specification.
pub func read(text: str) -> Reading:
    var spec = Spec(fill = "", align = 0, sign = 0, no_negative_zero = false, alternate = false, zero = false, width = -1, grouping = 0, precision = -1, kind = 0)
    let b = text.bytes
    var at: usize = 0
    var first: usize = 0
    if b.length > 0:
        first = scalar_bytes(b[0])
    if b.length > first and is_align(b[first]):
        spec.fill = (str)b[..<first]
        spec.align = b[first]
        at = first + 1
    elif b.length > 0 and is_align(b[0]):
        spec.align = b[0]
        at = 1
    if at < b.length and (b[at] == '+' or b[at] == '-' or b[at] == ' '):
        spec.sign = b[at]
        at += 1
    if at < b.length and b[at] == 'z':
        spec.no_negative_zero = true
        at += 1
    if at < b.length and b[at] == '#':
        spec.alternate = true
        at += 1
    if spec.fill.length == 0 and at < b.length and b[at] == '0':
        spec.zero = true
        at += 1
    var width: i64 = 0
    let digits = read_count(b, &at, &width)
    if digits < 0:
        return Reading(spec = spec, problem = "its width is too large")
    if digits > 0:
        spec.width = width
    if at < b.length and (b[at] == ',' or b[at] == '_'):
        spec.grouping = b[at]
        at += 1
        if at < b.length and (b[at] == ',' or b[at] == '_'):
            return Reading(spec = spec, problem = "it groups digits with both `,` and `_`")
    if at < b.length and b[at] == '.':
        at += 1
        var precision: i64 = 0
        let n = read_count(b, &at, &precision)
        if n < 0:
            return Reading(spec = spec, problem = "its precision is too large")
        if n == 0:
            return Reading(spec = spec, problem = "a `.` is followed by the precision's digits")
        spec.precision = precision
    if b.length - at > 1:
        return Reading(spec = spec, problem = "it is not `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`")
    if at < b.length:
        spec.kind = b[at]
    return Reading(spec = spec, problem = "")

## What is wrong with `spec` for a value of `category`: empty when it fits (§3.3).
pub func misfit(spec: Spec, category: Category) -> str:
    let k = spec.kind
    match category:
        .integer:
            if k == 'e' or k == 'E' or k == 'f' or k == 'F' or k == 'g' or k == 'G' or k == '%':
                return "its type letter formats a `float`; convert the `int` with `float(...)` first"
            if k != 0 and k != 'd' and k != 'b' and k != 'o' and k != 'x' and k != 'X' and k != 'c':
                return "an `int` is formatted with `d`, `b`, `o`, `x`, `X` or `c`"
            if spec.precision >= 0:
                return "an `int` takes no precision"
            if spec.no_negative_zero:
                return "`z` belongs to a `float`"
            if k == 'c' and spec.sign != 0:
                return "`c` takes no sign"
            if k == 'c' and spec.alternate:
                return "`c` takes no `#`"
            if spec.grouping == ',' and k != 0 and k != 'd':
                return "`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`"
            if spec.grouping == '_' and k == 'c':
                return "`c` takes no grouping"
        .floating:
            if k != 0 and k != 'e' and k != 'E' and k != 'f' and k != 'F' and k != 'g' and k != 'G' and k != '%':
                return "a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`"
        .text:
            if k != 0 and k != 's':
                return "this value shows its display, so its only type is `s`"
            if spec.sign != 0:
                return "a sign belongs to a number"
            if spec.no_negative_zero:
                return "`z` belongs to a `float`"
            if spec.alternate:
                return "`#` belongs to a number"
            if spec.align == '=':
                return "`=` aligns a number after its sign"
            if spec.grouping != 0:
                return "grouping belongs to a number"
    return ""

## The fill and alignment a field uses: the written ones, else the defaults, a number to
## the right and a text to the left, and `0` before the width filling with zeros after the
## sign (CPython's backwards-compatible special case).
func settle(spec: Spec, numeric: bool) -> Spec:
    var out = spec
    if spec.zero:
        out.fill = "0"
        if spec.align == 0 and numeric:
            out.align = '='
    if out.fill.length == 0:
        out.fill = " "
    if out.align == 0:
        out.align = '>' if numeric else '<'
    return out

# mark: Output =================================================================================

## Text being made: the builder, with memory running out a trap.
struct Out:
    var b: strings.Builder

    static func make() -> Out:
        let b = strings.Builder.create(32) catch failure:
            trap("out of memory")
        return Out(b = b)

    func put(text: str):
        self.b.put(text) catch failure:
            trap("out of memory")

    func byte(c: u8):
        var one: u8[1]
        one[0] = c
        self.put((str)one[..<1])

    func repeat(text: str, n: i64):
        var i: i64 = 0
        while i < n:
            self.put(text)
            i += 1

    ## The text made, as an owned copy; the builder is given back.
    func finish() -> str:
        let out = strings.copy(self.b.view()) catch failure:
            trap("out of memory")
        self.b.destroy()
        return out

## Padding before and after `n` scalars to `width`, by the alignment (CPython's calc_padding).
func padding(n: i64, width: i64, align: u8) -> (i64, i64):
    let total = width if width > n else n
    var left: i64 = 0
    if align == '>':
        left = total - n
    elif align == '^':
        left = (total - n) // 2
    return (left, total - n - left)

## `digits` in groups of `interval` from the right with `separator` between, none when
## `interval` is 0, and zeros on the left until it is `least` long: CPython's
## _PyUnicode_InsertThousandsGrouping, which zero padding runs through too.
func grouped(digits: str, least: i64, interval: i64, separator: u8) -> str:
    var reversed = Out.make()
    var remaining = (i64)digits.length
    var left = least if least > 0 else 0
    var cursor = digits.length
    var separate = false
    var finished = false
    while interval > 0:
        let size = smaller(interval, larger(larger(remaining, left), 1))
        put_group(&reversed, digits, &cursor, size, remaining, separate, separator)
        separate = true
        remaining -= larger(0, smaller(remaining, size))
        left -= size
        if remaining <= 0 and left <= 0:
            finished = true
            break
        left -= 1
    if not finished:
        let size = larger(larger(remaining, left), 1)
        put_group(&reversed, digits, &cursor, size, remaining, separate, separator)
    let backwards = reversed.finish()
    defer strings.release(backwards)
    var out = Out.make()
    var i = backwards.length
    while i > 0:
        i -= 1
        out.byte(backwards.bytes[i])
    return out.finish()

## One group, written backwards: the separator, then its digits from the right, then the
## zeros that pad it.
func put_group(reversed: Out*, digits: str, cursor: usize*, size: i64, remaining: i64, separate: bool, separator: u8):
    let zeros = larger(0, size - remaining)
    let chars = larger(0, smaller(remaining, size))
    if separate:
        reversed.byte(separator)
    var i: i64 = 0
    while i < chars:
        *cursor -= 1
        reversed.byte(digits.bytes[*cursor])
        i += 1
    reversed.repeat("0", zeros)

func smaller(a: i64, b: i64) -> i64:
    return a if a < b else b

func larger(a: i64, b: i64) -> i64:
    return a if a > b else b

## A number laid out as CPython's calc_number_widths and fill_number lay it out:
## `[padding] sign prefix [padding] grouped-digits [point] rest [padding]`. `spec` is settled.
func lay_number(out: Out*, negative: bool, prefix: str, digits: str, point: bool, rest: str, spec: Spec, upper: bool):
    var sign: u8 = 0
    if spec.sign == '+':
        sign = '-' if negative else '+'
    elif spec.sign == ' ':
        sign = '-' if negative else ' '
    elif negative:
        sign = '-'
    let fixed = (1 if sign != 0 else 0) + (i64)prefix.length + (1 if point else 0) + scalar_count(rest)
    let least = spec.width - fixed if spec.fill == "0" and spec.align == '=' else 0
    let interval: i64 = 0 if spec.grouping == 0 else 4 if spec.kind == 'b' or spec.kind == 'o' or spec.kind == 'x' or spec.kind == 'X' else 3
    var body = ""
    if digits.length > 0:
        body = grouped(digits, least, interval, spec.grouping)
    defer:
        if digits.length > 0:
            strings.release(body)
    let spare = spec.width - (fixed + (i64)body.length)
    var before: i64 = 0
    var between: i64 = 0
    var after: i64 = 0
    if spare > 0:
        if spec.align == '<':
            after = spare
        elif spec.align == '^':
            before = spare // 2
            after = spare - before
        elif spec.align == '=':
            between = spare
        else:
            before = spare
    out.repeat(spec.fill, before)
    if sign != 0:
        out.byte(sign)
    put_cased(out, prefix, upper)
    out.repeat(spec.fill, between)
    put_cased(out, body, upper)
    if point:
        out.put(".")
    out.put(rest)
    out.repeat(spec.fill, after)

func put_cased(out: Out*, text: str, upper: bool):
    if not upper:
        out.put(text)
        return
    for c in text.bytes:
        out.byte(c - 32 if c >= 'a' and c <= 'z' else c)

# mark: Fields =================================================================================

## An `int` field `{value:spec}`; none when `c` meets a value that is no Unicode scalar.
pub func format_int(value: i64, text: str) -> str?:
    let spec = settle(read(text).spec, true)
    var out = Out.make()
    let negative = value < 0
    let magnitude = (u64)(-(value + 1)) + 1 if negative else (u64)value
    if spec.kind == 'c':
        if negative or value > 0x10FFFF or (value >= 0xD800 and value <= 0xDFFF):
            out.b.destroy()
            return none
        var buffer: u8[4]
        let scalar = encode_scalar(value, buffer)
        lay_number(&out, false, "", "", false, scalar, spec, false)
        return out.finish()
    var base: u32 = 10
    var prefix = ""
    if spec.kind == 'b':
        base = 2
        prefix = "0b"
    elif spec.kind == 'o':
        base = 8
        prefix = "0o"
    elif spec.kind == 'x' or spec.kind == 'X':
        base = 16
        prefix = "0x"
    var buffer: u8[65]
    let digits = strings.format_u64(magnitude, buffer, base) catch failure:
        trap("a number that does not format")
    lay_number(&out, negative, prefix if spec.alternate else "", digits, false, "", spec, spec.kind == 'X')
    return out.finish()

## `text.from_code(n)` (§6.8): the text of one scalar, the caller's own; none when `n` is no
## Unicode scalar, below zero, a surrogate, or past U+10FFFF.
pub func character(code: i64) -> str?:
    if code < 0 or code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF):
        return none
    var buffer: u8[4]
    let text = strings.copy(encode_scalar(code, buffer)) catch failure:
        trap("out of memory")
    return text

## `text.code_of(s)` (§6.8) of a text of one scalar: the scalar's value.
pub func scalar_value(text: str) -> i64:
    let b = text.bytes
    let lead = (i64)b[0]
    if lead < 0x80:
        return lead
    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)
    var i: usize = 1
    while i < b.length:
        value = value * 64 + ((i64)b[i] & 0x3F)
        i += 1
    return value

## `math.abs(x)` of a `float` (§6.8): its magnitude, `0.0` for either zero, NaN as it is.
pub func absolute(x: f64) -> f64:
    if x < 0.0:
        return -x
    if x == 0.0:
        return 0.0
    return x

## The UTF-8 of a scalar (`text.from_code`), viewing `buffer`.
pub func encode_scalar(value: i64, buffer: u8[]) -> str:
    let v = (u32)value
    if v < 0x80:
        buffer[0] = (u8)v
        return (str)buffer[..<1]
    if v < 0x800:
        buffer[0] = (u8)(0xC0 | (v >> 6))
        buffer[1] = (u8)(0x80 | (v & 0x3F))
        return (str)buffer[..<2]
    if v < 0x10000:
        buffer[0] = (u8)(0xE0 | (v >> 12))
        buffer[1] = (u8)(0x80 | ((v >> 6) & 0x3F))
        buffer[2] = (u8)(0x80 | (v & 0x3F))
        return (str)buffer[..<3]
    buffer[0] = (u8)(0xF0 | (v >> 18))
    buffer[1] = (u8)(0x80 | ((v >> 12) & 0x3F))
    buffer[2] = (u8)(0x80 | ((v >> 6) & 0x3F))
    buffer[3] = (u8)(0x80 | (v & 0x3F))
    return (str)buffer[..<4]

## A `float` field `{value:spec}`. With neither a type nor a precision it shows the value's
## display (§3.3), where Python would show its repr.
pub func format_float(value: f64, text: str) -> str:
    let spec = settle(read(text).spec, true)
    var x = value
    var kind = spec.kind
    var percent = false
    if kind == '%':
        x = x * 100.0
        kind = 'f'
        percent = true
    var digits = Out.make()
    if kind == 0 and spec.precision < 0:
        var buffer: u8[40]
        let n = float_text.display_f64(x, buffer)
        var shown = (str)buffer[..<n]
        if spec.no_negative_zero and x == 0.0 and shown.bytes[0] == '-':
            shown = (str)shown.bytes[1..]
        digits.put(shown)
    else:
        short_text(&digits, x, kind, spec.precision if spec.precision >= 0 else 6, spec.alternate, spec.no_negative_zero)
    if percent:
        digits.put("%")
    let made = digits.finish()
    defer strings.release(made)
    # the sign apart, the leading digits, a point, and the rest as CPython's parse_number
    var at: usize = 0
    let negative = made.length > 0 and made.bytes[0] == '-'
    if negative:
        at = 1
    var end = at
    while end < made.length and made.bytes[end] >= '0' and made.bytes[end] <= '9':
        end += 1
    let point = end < made.length and made.bytes[end] == '.'
    let rest = (str)made.bytes[end + 1 if point else end..]
    var out = Out.make()
    lay_number(&out, negative, "", (str)made.bytes[at..<end], point, rest, spec, false)
    return out.finish()

## A field of any other value, given its display: precision keeps that many scalars, and
## the width pads it (CPython's format_string_internal).
pub func format_text(shown: str, text: str) -> str:
    let spec = settle(read(text).spec, false)
    var view = shown
    var n = scalar_count(shown)
    if spec.precision >= 0 and n > spec.precision:
        view = scalar_prefix(shown, spec.precision)
        n = spec.precision
    let (before, after) = padding(n, spec.width, spec.align)
    var out = Out.make()
    out.repeat(spec.fill, before)
    out.put(view)
    out.repeat(spec.fill, after)
    return out.finish()

## The first `n` scalars of `text`, viewing it.
pub func scalar_prefix(text: str, n: i64) -> str:
    var seen: i64 = 0
    var i: usize = 0
    while i < text.length:
        if (text.bytes[i] & 0xC0) != 0x80:
            if seen == n:
                return (str)text.bytes[..<i]
            seen += 1
        i += 1
    return text

# mark: Exact decimals =========================================================================

## The exact decimal digits of a float's magnitude: `0.d1d2d3... × 10^point`, at most 767
## significant digits for any finite f64, no trailing zero; `count` 0 is zero.
struct Decimal:
    var digits: u8[800]
    var count: usize
    var point: i64

## The digits of |value|, finite: the significand times a power of two, made decimal in
## limbs of 10^9 exactly (multiplying by 2^k, or by 5^k for a negative exponent).
func exact(value: f64) -> Decimal:
    var d: Decimal = ---
    d.count = 0
    d.point = 0
    let bits = value.bits()
    let exponent_bits = (i64)((bits >> 52) & 0x7FF)
    var significand = bits & 0xFFFFFFFFFFFFF
    var exponent: i64 = -1074
    if exponent_bits != 0:
        significand = significand | 0x10000000000000
        exponent = exponent_bits - 1075
    if significand == 0:
        d.digits[0] = '0'
        d.count = 1
        d.point = 1
        return d
    var limbs: u64[100] = ---
    limbs[0] = significand % 1000000000
    limbs[1] = significand // 1000000000
    var used: usize = 2 if limbs[1] != 0 else 1
    if exponent >= 0:
        var left = exponent
        while left > 0:
            let shift = left if left < 30 else 30
            used = multiply(limbs, used, (u64)1 << (u64)shift)
            left -= shift
    else:
        var left = -exponent
        while left > 0:
            let step = left if left < 13 else 13
            var factor: u64 = 1
            for _ in 0..<step:
                factor *= 5
            used = multiply(limbs, used, factor)
            left -= step
    # the top limb without leading zeros, every other one as nine digits
    var top: u8[9] = ---
    var n: usize = 0
    var high = limbs[used - 1]
    while high > 0:
        top[n] = '0' + (u8)(high % 10)
        high //= 10
        n += 1
    while n > 0:
        n -= 1
        d.digits[d.count] = top[n]
        d.count += 1
    var i = used - 1
    while i > 0:
        i -= 1
        var limb = limbs[i]
        var k: usize = 9
        while k > 0:
            k -= 1
            d.digits[d.count + k] = '0' + (u8)(limb % 10)
            limb //= 10
        d.count += 9
    d.point = (i64)d.count + (exponent if exponent < 0 else 0)
    trim_zeros(&d)
    return d

## `limbs[..<used] *= factor`, factor at most 2^30; the limbs now used.
func multiply(limbs: u64[], used: usize, factor: u64) -> usize:
    var carry: u64 = 0
    var i: usize = 0
    while i < used:
        let product = limbs[i] * factor + carry
        limbs[i] = product % 1000000000
        carry = product // 1000000000
        i += 1
    var n = used
    while carry > 0:
        limbs[n] = carry % 1000000000
        carry //= 1000000000
        n += 1
    return n

func trim_zeros(d: Decimal*):
    while d.count > 1 and d.digits[d.count - 1] == '0':
        d.count -= 1

## Keep the first `keep` digits, rounding half to even on the exact value; `keep` may be 0
## or less, which leaves zero (`count` 0) or one digit carried up.
func round_to(d: Decimal*, keep: i64):
    if keep >= (i64)d.count:
        return
    var up = false
    if keep >= 0:
        let next = d.digits[(usize)keep]
        var beyond = false
        var i = (usize)keep + 1
        while i < d.count:
            if d.digits[i] != '0':
                beyond = true
            i += 1
        let odd = keep > 0 and ((d.digits[(usize)keep - 1] - '0') % 2) == 1
        up = next > '5' or (next == '5' and (beyond or odd))
    if keep <= 0:
        d.count = 0
        if up:
            d.digits[0] = '1'
            d.count = 1
            d.point += 1
        return
    d.count = (usize)keep
    if up:
        var i = d.count
        var carried = true
        while carried and i > 0:
            i -= 1
            if d.digits[i] == '9':
                d.digits[i] = '0'
            else:
                d.digits[i] += 1
                carried = false
        if carried:
            # every kept digit was 9: one digit, a 1, a place higher
            d.digits[0] = '1'
            d.count = 1
            d.point += 1
    trim_zeros(d)
    if d.count == 1 and d.digits[0] == '0':
        d.count = 0

## dtoa's mode 2 (`n` significant digits) or mode 3 (`n` digits after the point, any sign)
## of a finite |value|: rounded half to even, no trailing zero, zero as `0` at point 1, and
## nothing left at point `-n` when mode 3 rounds it all away.
func digits_of(value: f64, mode: u8, n: i64) -> Decimal:
    var d = exact(value)
    if d.count == 1 and d.digits[0] == '0':
        return d
    if mode == 2:
        round_to(&d, n if n > 1 else 1)
    else:
        round_to(&d, d.point + n)
        if d.count == 0:
            d.point = -n
    return d

## `e`, `f`, `g` (and the upper ones) of `value` with `precision`, as CPython's
## PyOS_double_to_string and format_float_short write them: `-` for a negative value,
## `inf` and `nan` for the specials.
func short_text(out: Out*, value: f64, kind: u8, precision: i64, alternate: bool, no_negative_zero: bool):
    let upper = kind == 'E' or kind == 'F' or kind == 'G'
    var code = kind + 32 if upper else kind
    var add_dot = false
    var p = precision
    if code == 0:
        # a precision without a type: `g`, a point always kept (CPython's 'r' with one)
        code = 'g'
        add_dot = true
    if value != value:
        out.put("NAN" if upper else "nan")
        return
    var negative = value < 0.0 or (value == 0.0 and (value.bits() >> 63) != 0)
    if infinite(value):
        out.put("-" if negative else "")
        out.put("INF" if upper else "inf")
        return
    var mode: u8 = 2
    if code == 'e':
        p += 1
    elif code == 'f':
        mode = 3
    elif p == 0:
        p = 1
    let d = digits_of(value, mode, p)
    if no_negative_zero and (d.count == 0 or (d.count == 1 and d.digits[0] == '0')):
        negative = false
    var point = d.point
    var end = (i64)d.count
    var use_exponent = false
    if code == 'e':
        use_exponent = true
        end = p
    elif code == 'f':
        end = point + p
    else:
        if point <= -4 or point > (p - 1 if add_dot else p):
            use_exponent = true
        if alternate:
            end = p
    var exponent: i64 = 0
    if use_exponent:
        exponent = point - 1
        point = 1
    let start = point - 1 if point <= 0 else 0
    if not use_exponent and add_dot:
        end = end if end > point else point + 1
    else:
        end = end if end > point else point
    if negative:
        out.put("-")
    lay_digits(out, d, point, start, end, alternate)
    if use_exponent:
        out.put("E" if upper else "e")
        out.put("-" if exponent < 0 else "+")
        let magnitude = -exponent if exponent < 0 else exponent
        if magnitude < 10:
            out.put("0")
        var buffer: u8[24]
        out.put(strings.format_i64(magnitude, buffer) catch failure: recover "0")

## The virtual digits `[start, end)` of `d` with the point after `point` of them: zeros
## where `d` has none, and the point dropped at the end unless `alternate` keeps it.
func lay_digits(out: Out*, d: Decimal, point: i64, start: i64, end: i64, alternate: bool):
    var i = start
    while i < end:
        if i == point:
            out.put(".")
        out.byte(d.digits[(usize)i] if i >= 0 and i < (i64)d.count else '0')
        i += 1
    if end == point and alternate:
        out.put(".")

# mark: Rounding and integers ==================================================================

## `math.round(x, digits)` (§6.8) as CPython's double_round: the correctly rounded decimal with
## `digits` after the point, half to even, read back as the nearest float. None when it
## rounds past the largest float.
pub func round(x: f64, digits: i64) -> f64?:
    if x != x or infinite(x) or digits > 323:
        return x
    if digits < -308:
        return 0.0 * x
    let d = digits_of(x, 3, digits)
    let negative = x < 0.0 or (x == 0.0 and (x.bits() >> 63) != 0)
    var out = Out.make()
    if negative:
        out.put("-")
    if d.count == 0:
        out.put("0")
    else:
        out.put((str)d.digits[..<d.count])
    out.put("e")
    var buffer: u8[24]
    out.put(strings.format_i64(d.point - (i64)d.count if d.count > 0 else 0, buffer) catch failure: recover "0")
    let text = out.finish()
    defer strings.release(text)
    let rounded = strings.parse_f64(text) catch failure:
        return none
    if infinite(rounded):
        return none
    return rounded

## Whether `x` is an infinity (a NaN is told apart by `x != x`).
func infinite(x: f64) -> bool:
    return x == x and ((x.bits() >> 52) & 0x7FF) == 0x7FF

func is_white(c: u8) -> bool:
    return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

func digit_value(c: u8) -> i64:
    if c >= '0' and c <= '9':
        return (i64)(c - '0')
    if c >= 'a' and c <= 'z':
        return (i64)(c - 'a') + 10
    if c >= 'A' and c <= 'Z':
        return (i64)(c - 'A') + 10
    return 99

## `int(text, base)` (§6.5) as Python reads it, `base` from 2 to 36: white space around,
## a sign, `0x`, `0o` or `0b` when it matches the base, and digits with single `_` between
## them. None when the text is not such an integer or does not fit an `int`.
pub func parse_int(text: str, base: i64) -> i64?:
    let b = text.bytes
    var start: usize = 0
    var end = b.length
    while start < end and is_white(b[start]):
        start += 1
    while end > start and is_white(b[end - 1]):
        end -= 1
    var at = start
    var negative = false
    if at < end and (b[at] == '+' or b[at] == '-'):
        negative = b[at] == '-'
        at += 1
    var underscore_ok = false
    if at + 1 < end and b[at] == '0':
        let p = b[at + 1]
        if ((p == 'x' or p == 'X') and base == 16) or ((p == 'o' or p == 'O') and base == 8) or ((p == 'b' or p == 'B') and base == 2):
            at += 2
            underscore_ok = true
    var value: i64 = 0
    var digits = 0
    var after_underscore = false
    while at < end:
        let c = b[at]
        at += 1
        if c == '_':
            if after_underscore or not (digits > 0 or underscore_ok):
                return none
            after_underscore = true
            continue
        let v = digit_value(c)
        if v >= base:
            return none
        after_underscore = false
        digits += 1
        let scaled = value *? base else return none
        value = (scaled -? v if negative else scaled +? v) else return none
    if digits == 0 or after_underscore:
        return none
    return value

# mark: Tests ===================================================================================

test "format specifications read and fit as Python's":
    let r = read("*^+#012,.3f")
    assert(r.problem == "")
    assert(r.spec.fill == "*" and r.spec.align == '^' and r.spec.sign == '+' and r.spec.alternate)
    assert(r.spec.width == 12 and r.spec.grouping == ',' and r.spec.precision == 3 and r.spec.kind == 'f')
    assert(read("·>5").spec.fill == "·")
    assert(read(".f").problem != "")
    assert(read("ff").problem != "")
    assert(read(",_").problem != "")
    assert(misfit(read("x").spec, Category.floating) != "")
    assert(misfit(read(".2").spec, Category.integer) != "")
    assert(misfit(read(",x").spec, Category.integer) != "")
    assert(misfit(read("_x").spec, Category.integer) == "")
    assert(misfit(read("+").spec, Category.text) != "")

test "integers lay out as Python's format":
    let cases: str[12] = ["d", "+d", "#x", "#X", "08b", "_b", ",", "010,", "08,", "^9", "*<6", "=+8"]
    let wants: str[12] = ["-1234", "-1234", "-0x4d2", "-0X4D2", "-10011010010", "-100_1101_0010", "-1,234", "-0,001,234", "-001,234", "  -1234  ", "-1234*", "-   1234"]
    var i: usize = 0
    while i < 12:
        let got = format_int(-1234, cases[i]) else return
        assert(got == wants[i])
        strings.release(got)
        i += 1
    assert(format_int(0x110000, "c") == none)

test "floats lay out as Python's format":
    let cases: str[14] = [".2f", "e", ".3g", "g", "%", "10.1f", "010.2f", ",.2f", ".0f", "#.0f", ".3", "+.1E", "z.1f", "_"]
    let values: f64[14] = [3.14159, 12345.678, 0.000012345, 1e20, 0.25, -2.25, -2.25, 1234567.891, 2.5, 2.5, 1234.5, 1e-300, -0.04, 1234567.5]
    let wants: str[14] = ["3.14", "1.234568e+04", "1.23e-05", "1e+20", "25.000000%", "      -2.2", "-000002.25", "1,234,567.89", "2", "2.", "1.23e+03", "+1.0E-300", "0.0", "1_234_567.5"]
    var i: usize = 0
    while i < 14:
        let got = format_float(values[i], cases[i])
        assert(got == wants[i])
        strings.release(got)
        i += 1

test "round is correctly rounded half to even":
    assert(round(2.675, 2) == 2.67)
    assert(round(0.125, 2) == 0.12)
    assert(round(0.375, 2) == 0.38)
    assert(round(2.5, 0) == 2.0)
    assert(round(1234.5, -2) == 1200.0)
    assert(round(-0.4, 0) == 0.0)
    assert(round(1.7976931348623157e308, -308) == none)

test "integers parse in a base as Python's int":
    assert(parse_int(" 0x_ff ", 16) == 255)
    assert(parse_int("-1_000", 10) == -1000)
    assert(parse_int("0b101", 2) == 5)
    assert(parse_int("0b101", 16) == 45313)
    assert(parse_int("1__0", 10) == none)
    assert(parse_int("_1", 10) == none)
    assert(parse_int("1_", 10) == none)
    assert(parse_int("z", 36) == 35)
    assert(parse_int("9223372036854775808", 10) == none)
    assert(parse_int("-9223372036854775808", 10) == -9223372036854775807 - 1)

test "scalars and magnitudes":
    let e = character(0xE9) else return
    assert(e == "é" and scalar_value(e) == 0xE9)
    strings.release(e)
    assert(scalar_value("😀") == 0x1F600)
    assert(character(0xD800) == none)
    assert(absolute(-0.0) == 0.0 and absolute(-2.5) == 2.5)
