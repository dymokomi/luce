#==============================================================================================
#
#   number_text - Numbers as text: Luce's fields, `math.round`, `int(text, base)`
#
#   DESCRIPTION:
#       What a formatted string's `{value:spec}` field, `math.round(x, digits)` and
#       `int(text, base)` do (luce.md §3.3, §6.5, §6.8), as Python does them. The format
#       mini-language and the exact decimal digits of a float are Base's standard
#       `numerals`, the one implementation, which Luce Base's own fields use too: this
#       module words a misfit in Luce's terms, lays a field out into a text of its own, and
#       reads a rounded decimal back as a float. Both executions run it: the interpreter
#       imports it, and the emitted program carries it beside the kernel
#       (tools/embed_runtime.py), so a field prints the same bytes in both. Every text it
#       returns is the caller's, given back with `strings.release`. It traps only when memory
#       runs out; the rules a Luce program can break, a scalar out of range or a base out of
#       range, its callers check.
#
#==============================================================================================

import memory
import numerals
import strings

# mark: Specifications =========================================================================

## What is wrong with `spec` for a value of `category`, in Luce's terms: empty when it fits
## (§3.3).
pub func misfit(spec: numerals.Spec, category: numerals.Category) -> str:
    match numerals.misfit_of(spec, category):
        .fits:
            return ""
        .float_type_of_integer:
            return "its type letter formats a `float`; convert the `int` with `float(...)` first"
        .integer_type:
            return "an `int` is formatted with `d`, `b`, `o`, `x`, `X` or `c`"
        .integer_precision:
            return "an `int` takes no precision"
        .integer_z, .text_z:
            return "`z` belongs to a `float`"
        .scalar_sign:
            return "`c` takes no sign"
        .scalar_alternate:
            return "`c` takes no `#`"
        .comma_grouping:
            return "`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`"
        .scalar_grouping:
            return "`c` takes no grouping"
        .float_type:
            return "a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`"
        .text_type:
            return "this value shows its display, so its only type is `s`"
        .text_sign:
            return "a sign belongs to a number"
        .text_alternate:
            return "`#` belongs to a number"
        .text_after_sign:
            return "`=` aligns a number after its sign"
        .text_grouping:
            return "grouping belongs to a number"

# mark: Fields =================================================================================

## Text being made, which `numerals` writes into: memory running out traps. Bytes grown by
## hand, since the runtime of every Luce program carries this module and no package.
struct Out:
    var data: u8[]
    var used: usize

    static func make() -> Out:
        let data = new u8[32] --- catch failure:
            trap("out of memory")
        return Out(data = data, used = 0)

    ## Where `numerals` lays a field out: this text.
    func sink() -> numerals.Sink:
        return numerals.Sink(context = (void*)&self, write = append)

    func put(text: str):
        if text.length > self.data.length - self.used:
            let wanted = self.used + text.length
            self.data = memory.grow(self.data, wanted if wanted > self.data.length * 2 else self.data.length * 2) catch failure:
                trap("out of memory")
        memory.copy(self.data[self.used..], text.bytes, text.length)
        self.used += text.length

    ## The text made, as an owned copy; the bytes are given back.
    func finish() -> str:
        let out = strings.copy((str)self.data[..<self.used]) catch failure:
            trap("out of memory")
        free(self.data)
        return out

## A `numerals.Sink`'s write into the `Out` at `context`.
func append(context: void*, bytes: const u8[]) -> bool:
    let out = (Out*)context
    out.put((str)bytes)
    return true

## An `int` field `{value:spec}`; none when `c` meets a value that is no Unicode scalar.
pub func format_int(value: i64, text: str) -> str?:
    let negative = value < 0
    let magnitude = 0 -% (u64)value if negative else (u64)value
    if numerals.read(text).spec.kind == 'c' and not numerals.is_scalar(negative, magnitude):
        return none
    var out = Out.make()
    _ = numerals.lay_integer(out.sink(), negative, magnitude, text)
    return out.finish()

## A `float` field `{value:spec}`. With neither a type nor a precision it shows the value's
## display (§3.3), where Python would show its repr.
pub func format_float(value: f64, text: str) -> str:
    var out = Out.make()
    _ = numerals.lay_float(out.sink(), value, false, text)
    return out.finish()

## A field of any other value, given its display: precision keeps that many scalars, and
## the width pads it (CPython's format_string_internal).
pub func format_text(shown: str, text: str) -> str:
    var out = Out.make()
    _ = numerals.lay_text(out.sink(), shown, text)
    return out.finish()

# mark: Scalars ================================================================================

## `text.from_code(n)` (§6.8): the text of one scalar, the caller's own; none when `n` is no
## Unicode scalar, below zero, a surrogate, or past U+10FFFF.
pub func character(code: i64) -> str?:
    if not numerals.is_scalar(code < 0, 0 -% (u64)code if code < 0 else (u64)code):
        return none
    var buffer: u8[4]
    let text = strings.copy((str)numerals.encode_scalar((u32)code, buffer)) catch failure:
        trap("out of memory")
    return text

## `text.code_of(s)` (§6.8) of a text of one scalar: the scalar's value.
pub func scalar_value(text: str) -> i64:
    let b = text.bytes
    let lead = (i64)b[0]
    if lead < 0x80:
        return lead
    var value: i64 = lead & (0x1F if lead < 0xE0 else 0x0F if lead < 0xF0 else 0x07)
    var i: usize = 1
    while i < b.length:
        value = value * 64 + ((i64)b[i] & 0x3F)
        i += 1
    return value

## `time.sleep(seconds)` as whole milliseconds, rounded up so the sleep is never shorter
## than asked, for Base's `thread.sleep`; none for a negative count or NaN (§6.8).
pub func sleep_milliseconds(seconds: f64) -> u64?:
    if not (seconds >= 0.0):
        return none
    let wanted = seconds * 1000.0
    if wanted >= 18446744073709549568.0:
        return 18446744073709549568
    let whole = (u64)wanted
    return whole + 1 if (f64)whole < wanted else whole

## `math.abs(x)` of a `float` (§6.8): its magnitude, `0.0` for either zero, NaN as it is.
pub func absolute(x: f64) -> f64:
    if x < 0.0:
        return -x
    if x == 0.0:
        return 0.0
    return x

# mark: Rounding and integers ==================================================================

## `math.round(x, digits)` (§6.8) as CPython's double_round: the correctly rounded decimal with
## `digits` after the point, half to even, read back as the nearest float. None when it
## rounds past the largest float.
pub func round(x: f64, digits: i64) -> f64?:
    if x != x or infinite(x) or digits > 323:
        return x
    if digits < -308:
        return 0.0 * x
    let d = numerals.decimal_places(x, digits)
    let negative = x < 0.0 or (x == 0.0 and (x.bits() >> 63) != 0)
    var out = Out.make()
    if negative:
        out.put("-")
    if d.count == 0:
        out.put("0")
    else:
        out.put((str)d.digits[..<d.count])
    out.put("e")
    var buffer: u8[24]
    out.put(strings.format_i64(d.point - (i64)d.count if d.count > 0 else 0, buffer) catch failure: recover "0")
    let text = out.finish()
    defer strings.release(text)
    let rounded = strings.parse_f64(text) catch failure:
        return none
    if infinite(rounded):
        return none
    return rounded

## Whether `x` is an infinity (a NaN is told apart by `x != x`).
func infinite(x: f64) -> bool:
    return x == x and ((x.bits() >> 52) & 0x7FF) == 0x7FF

func is_white(c: u8) -> bool:
    return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 11 or c == 12

func digit_value(c: u8) -> i64:
    if c >= '0' and c <= '9':
        return (i64)(c - '0')
    if c >= 'a' and c <= 'z':
        return (i64)(c - 'a') + 10
    if c >= 'A' and c <= 'Z':
        return (i64)(c - 'A') + 10
    return 99

## `int(text, base)` (§6.5) as Python reads it, `base` from 2 to 36: white space around,
## a sign, `0x`, `0o` or `0b` when it matches the base, and digits with single `_` between
## them. None when the text is not such an integer or does not fit an `int`.
pub func parse_int(text: str, base: i64) -> i64?:
    let b = text.bytes
    var start: usize = 0
    var end = b.length
    while start < end and is_white(b[start]):
        start += 1
    while end > start and is_white(b[end - 1]):
        end -= 1
    var at = start
    var negative = false
    if at < end and (b[at] == '+' or b[at] == '-'):
        negative = b[at] == '-'
        at += 1
    var underscore_ok = false
    if at + 1 < end and b[at] == '0':
        let p = b[at + 1]
        if ((p == 'x' or p == 'X') and base == 16) or ((p == 'o' or p == 'O') and base == 8) or ((p == 'b' or p == 'B') and base == 2):
            at += 2
            underscore_ok = true
    var value: i64 = 0
    var digits = 0
    var after_underscore = false
    while at < end:
        let c = b[at]
        at += 1
        if c == '_':
            if after_underscore or not (digits > 0 or underscore_ok):
                return none
            after_underscore = true
            continue
        let v = digit_value(c)
        if v >= base:
            return none
        after_underscore = false
        digits += 1
        let scaled = value *? base else return none
        value = (scaled -? v if negative else scaled +? v) else return none
    if digits == 0 or after_underscore:
        return none
    return value

# mark: Tests ===================================================================================

test "a misfit is worded in Luce's terms":
    assert(misfit(numerals.read("f").spec, numerals.Category.integer) == "its type letter formats a `float`; convert the `int` with `float(...)` first")
    assert(misfit(numerals.read("x").spec, numerals.Category.floating) == "a `float` is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`")
    assert(misfit(numerals.read("d").spec, numerals.Category.text) == "this value shows its display, so its only type is `s`")
    assert(misfit(numerals.read(",x").spec, numerals.Category.integer) == "`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`")
    assert(misfit(numerals.read("_x").spec, numerals.Category.integer) == "")
    assert(misfit(numerals.read("+").spec, numerals.Category.text) == "a sign belongs to a number")

test "integers lay out as Python's format":
    let cases: str[12] = ["d", "+d", "#x", "#X", "08b", "_b", ",", "010,", "08,", "^9", "*<6", "=+8"]
    let wants: str[12] = ["-1234", "-1234", "-0x4d2", "-0X4D2", "-10011010010", "-100_1101_0010", "-1,234", "-0,001,234", "-001,234", "  -1234  ", "-1234*", "-   1234"]
    var i: usize = 0
    while i < 12:
        let got = format_int(-1234, cases[i]) else return
        assert(got == wants[i])
        strings.release(got)
        i += 1
    assert(format_int(0x110000, "c") == none)

test "floats lay out as Python's format":
    let cases: str[14] = [".2f", "e", ".3g", "g", "%", "10.1f", "010.2f", ",.2f", ".0f", "#.0f", ".3", "+.1E", "z.1f", "_"]
    let values: f64[14] = [3.14159, 12345.678, 0.000012345, 1e20, 0.25, -2.25, -2.25, 1234567.891, 2.5, 2.5, 1234.5, 1e-300, -0.04, 1234567.5]
    let wants: str[14] = ["3.14", "1.234568e+04", "1.23e-05", "1e+20", "25.000000%", "      -2.2", "-000002.25", "1,234,567.89", "2", "2.", "1.23e+03", "+1.0E-300", "0.0", "1_234_567.5"]
    var i: usize = 0
    while i < 14:
        let got = format_float(values[i], cases[i])
        assert(got == wants[i])
        strings.release(got)
        i += 1

test "round is correctly rounded half to even":
    assert(round(2.675, 2) == 2.67)
    assert(round(0.125, 2) == 0.12)
    assert(round(0.375, 2) == 0.38)
    assert(round(2.5, 0) == 2.0)
    assert(round(1234.5, -2) == 1200.0)
    assert(round(-0.4, 0) == 0.0)
    assert(round(1.7976931348623157e308, -308) == none)

test "integers parse in a base as Python's int":
    assert(parse_int(" 0x_ff ", 16) == 255)
    assert(parse_int("-1_000", 10) == -1000)
    assert(parse_int("0b101", 2) == 5)
    assert(parse_int("0b101", 16) == 45313)
    assert(parse_int("1__0", 10) == none)
    assert(parse_int("_1", 10) == none)
    assert(parse_int("1_", 10) == none)
    assert(parse_int("z", 36) == 35)
    assert(parse_int("9223372036854775808", 10) == none)
    assert(parse_int("-9223372036854775808", 10) == -9223372036854775807 - 1)

test "scalars and magnitudes":
    let e = character(0xE9) else return
    assert(e == "é" and scalar_value(e) == 0xE9)
    strings.release(e)
    assert(scalar_value("😀") == 0x1F600)
    assert(character(0xD800) == none)
    assert(absolute(-0.0) == 0.0 and absolute(-2.5) == 2.5)
