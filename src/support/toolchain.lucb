#==============================================================================================
#
#   toolchain - Where the Base compiler is
#
#   DESCRIPTION:
#       Every Luce program becomes a Base package that luce-base compiles, and the checker
#       asks luce-base to describe the Base modules a program imports (luce.md §16, §17).
#       The compiler used is, in order: the one `LUCE_BASE` names, so a build may pick any;
#       `luce-base` beside this executable, which is how a release is laid out, with the
#       standard library under `lib/` beside it; else `luce-base` on the path.
#
#==============================================================================================

import c
import files
import os
import paths

## The Base compiler's path or name, in storage that lasts the process.
pub func base_compiler() -> c.str:
    if let named = os.env("LUCE_BASE"):
        return (c.str)named
    if let sibling = beside_executable():
        return sibling
    return "luce-base"

## `luce-base` in this executable's directory, when it is there.
func beside_executable() -> c.str?:
    let exe = os.executable() catch failure:
        discard(failure)
        return none
    let home = paths.directory(exe)
    let suffix = "/luce-base.exe" if os.windows else "/luce-base"
    let room = alloc u8[home.length + suffix.length + 1] catch failure:
        discard(failure)
        return none
    var i: usize = 0
    while i < home.length:
        room[i] = home.bytes[i]
        i += 1
    var k: usize = 0
    while k < suffix.length:
        room[home.length + k] = suffix.bytes[k]
        k += 1
    room[home.length + suffix.length] = 0
    let candidate = (c.str)room.data
    # a file, not the `luce-base` checkout directory a development tree keeps beside itself
    let info = files.metadata(candidate) catch failure:
        discard(failure)
        return none
    if info.kind == files.FileKind.regular:
        return candidate
    return none
