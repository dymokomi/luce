#==============================================================================================
#
#   toolchain - Where the Base compiler is, and that it is the one this Luce belongs with
#
#   DESCRIPTION:
#       Every Luce program becomes a Base package that luce-base compiles, and the checker
#       asks luce-base to describe the Base modules a program imports (luce.md §16, §17).
#       The compiler used is, in order: the one `LUCE_BASE` names, so a build may pick any;
#       `luce-base` beside this executable, which is how a release is laid out; the one this
#       Luce was built with, where it was then (`toolchain_build`: the pinned checkout
#       build.sh makes, or the compiler a build names, as every Windows build does); the
#       one a development build keeps beside `build/luce` (`build/luce-base/build/
#       luce-base`), for a build tree moved since; else `luce-base` on the path. Whichever it is must report the version
#       of the compiler Luce was built with: an older luce-base first on the path, from an
#       earlier install, would otherwise compile a newer Luce's output into errors that name
#       neither (a missing field of the runtime), so a mismatch stops the build and says so.
#
#==============================================================================================

import c
import luce_std.files
import memory
import os
import luce_std.paths
import luce_std.process
import strings
import support.toolchain_build

## The user's build cache, `%LOCALAPPDATA%\\luce\\cache` on Windows and `~/.luce/cache`
## elsewhere, whether made yet or not; none when `LUCE_CACHE` names one, which luce-base
## reads itself, or there is no home.
pub func user_cache() -> str?!:
    if let chosen = os.env("LUCE_CACHE"):
        discard(chosen)
        return none
    let home = os.env("LOCALAPPDATA" if os.windows else "HOME") else return none
    if home.length == 0:
        return none
    return try paths.join(home, "luce/cache" if os.windows else ".luce/cache")

## The Base compiler's path or name, in storage that lasts the process, once it reported
## the version this Luce was built with.
pub func base_compiler() -> c.str!:
    if checked.length > 0:
        return (c.str)checked.bytes.data
    let candidate = located()
    let compiler = (str)candidate
    var no_arguments: c.str[1] = ["--version"]
    let (status, output, diagnostic) = process.run(candidate, no_arguments[..<1]) catch failure:
        error(mismatch, try note(f"the Base compiler `{compiler}` cannot be run ({failure.message}); this Luce needs {toolchain_build.base_version}, beside it or named by `LUCE_BASE`"))
    defer process.release(output)
    defer process.release(diagnostic)
    let version = strings.trim(output)
    if status != 0 or version != toolchain_build.base_version:
        if status != 0:
            # `process.run` exits 127 when the program cannot be started
            error(mismatch, try note(f"the Base compiler `{compiler}` cannot be run (`--version` exits {status}); this Luce needs {toolchain_build.base_version}, beside it or named by `LUCE_BASE`"))
        error(mismatch, try note(f"the Base compiler `{compiler}` is {version}, but this Luce was built with {toolchain_build.base_version} and runs only that one: put it beside luce, or name it with `LUCE_BASE`"))
    with memory.heap:
        checked = try strings.copy(compiler)
    return (c.str)checked.bytes.data

## The compiler whose version matched, kept for the process; empty until one has.
var checked: str = ""

## A luce-base that is not the version this Luce was built with, or cannot be run.
pub let mismatch: ErrorCode = ErrorCode.package(31)

## `text` in storage that outlives the caller's arena, for an error's message.
func note(text: fmt) -> str!:
    with memory.heap:
        var room = try alloc u8[1024]
        return try format(room, text)

## The first Base compiler there is, in the order above.
func located() -> c.str:
    if let named = os.env("LUCE_BASE"):
        return (c.str)named
    if let sibling = beside_executable("/luce-base"):
        return sibling
    if regular((c.str)toolchain_build.base_path):
        return (c.str)toolchain_build.base_path
    if let own = beside_executable("/luce-base/build/luce-base"):
        return own
    return "luce-base"

## Whether `path` names a file, not a directory or nothing.
func regular(path: c.str) -> bool:
    let info = files.metadata(path) catch failure:
        discard(failure)
        return false
    return info.kind == files.FileKind.regular

## `relative` (with `.exe` on Windows) under this executable's directory, when it is a file.
func beside_executable(relative: str) -> c.str?:
    let exe = os.executable() catch failure:
        discard(failure)
        return none
    let home = paths.directory(exe)
    let extension = ".exe" if os.windows else ""
    let room = alloc u8[home.length + relative.length + extension.length + 1] catch failure:
        discard(failure)
        return none
    var i: usize = 0
    while i < home.length:
        room[i] = home.bytes[i]
        i += 1
    var k: usize = 0
    while k < relative.length:
        room[home.length + k] = relative.bytes[k]
        k += 1
    var e: usize = 0
    while e < extension.length:
        room[home.length + relative.length + e] = extension.bytes[e]
        e += 1
    room[home.length + relative.length + extension.length] = 0
    let candidate = (c.str)room.data
    # a file, not the `luce-base` checkout directory a development tree keeps beside itself
    if regular(candidate):
        return candidate
    return none
