#==============================================================================================
#
#   literals - Number literals as text
#
#   DESCRIPTION:
#       The spelling of a number literal (luce.md §3.2): whether it is a `float`, its digits
#       in any base with `_` separators, and its value as a `u64`. The checker, the
#       interpreter, and the emitter read literals through this one module, so a literal
#       means the same thing everywhere.
#
#==============================================================================================

pub let bad_literal: ErrorCode = ErrorCode.package(12)

## A literal with a point or an exponent is a `float` (§3.2); a based literal never is.
pub func is_float_text(text: str) -> bool:
    let b = text.bytes
    if b.length > 1 and b[0] == '0' and (b[1] == 'x' or b[1] == 'o' or b[1] == 'b'):
        return false
    for c in b:
        if c == '.' or c == 'e' or c == 'E':
            return true
    return false

func is_hex_digit(b: u8) -> bool:
    return (b >= '0' and b <= '9') or (b >= 'a' and b <= 'f') or (b >= 'A' and b <= 'F')

## Decode an integer literal: decimal, `0x`, `0b`, `0o`, with `_` separators.
pub func decode_integer(text: str) -> u64!:
    let b = text.bytes
    var base: u64 = 10
    var i: usize = 0
    if b.length > 1 and b[0] == '0':
        if b[1] == 'x':
            base = 16
            i = 2
        elif b[1] == 'b':
            base = 2
            i = 2
        elif b[1] == 'o':
            base = 8
            i = 2
    var value: u64 = 0
    while i < b.length:
        let byte = b[i]
        i += 1
        if byte == '_':
            continue
        var digit: u64 = 0
        if byte >= '0' and byte <= '9':
            digit = (u64)(byte - '0')
        elif byte >= 'a' and byte <= 'f':
            digit = (u64)(byte - 'a') + 10
        elif byte >= 'A' and byte <= 'F':
            digit = (u64)(byte - 'A') + 10
        else:
            error(bad_literal, "bad digit in integer literal")
        if digit >= base:
            error(bad_literal, "bad digit in integer literal")
        if value > (18446744073709551615 - digit) // base:
            error(bad_literal, "integer literal does not fit")
        value = value * base + digit
    return value

test "literals decode":
    assert(try decode_integer("42") == 42)
    assert(try decode_integer("0xff") == 255)
    assert(try decode_integer("1_000") == 1000)
    assert(try decode_integer("0b101") == 5)
    assert(is_float_text("1.5"))
    assert(is_float_text("1e3"))
    assert(not is_float_text("0xe"))
    var refused = false
    discard(decode_integer("18446744073709551616") catch failure:
        refused = true
        recover 0)
    assert(refused)

## The text a literal spells: quotes removed, escapes decoded, a raw literal as it is, a
## triple-quoted literal with the common indentation of its lines stripped (§3.3). The
## result is on the heap.
pub func decode_text(spelling: str) -> str!:
    var b = spelling.bytes
    var raw = false
    var is_bytes = false
    if b[0] == 'r':
        raw = true
        b = b[1..]
    elif b[0] == 'b':
        is_bytes = true
        b = b[1..]
    var triple = b.length >= 6 and b[1] == '"' and b[2] == '"'
    var body = b[3..<b.length - 3] if triple else b[1..<b.length - 1]
    var out = try alloc u8[body.length + 1]
    var n: usize = 0
    var i: usize = 0
    while i < body.length:
        let c = body[i]
        if c == '\\' and not raw and i + 1 < body.length:
            let e = body[i + 1]
            i += 2
            if e == 'n':
                out[n] = '\n'
            elif e == 't':
                out[n] = '\t'
            elif e == 'r':
                out[n] = '\r'
            elif e == '0':
                out[n] = 0
            elif e == '\\':
                out[n] = '\\'
            elif e == '"':
                out[n] = '"'
            elif e == 'x' and is_bytes and i + 1 < body.length:
                out[n] = (u8)(hex_value(body[i]) * 16 + hex_value(body[i + 1]))
                i += 2
            elif e == 'u' and i < body.length and body[i] == '{':
                i += 1
                var scalar: u32 = 0
                while i < body.length and body[i] != '}':
                    scalar = scalar * 16 + (u32)hex_value(body[i])
                    i += 1
                i += 1
                n += encode_scalar(out[n..], scalar)
                continue
            else:
                out[n] = e
            n += 1
            continue
        out[n] = c
        n += 1
        i += 1
    if triple:
        return try strip_indentation((str)out[..<n])
    return (str)out[..<n]

func hex_value(c: u8) -> u64:
    if c >= '0' and c <= '9':
        return (u64)(c - '0')
    if c >= 'a' and c <= 'f':
        return (u64)(c - 'a') + 10
    if c >= 'A' and c <= 'F':
        return (u64)(c - 'A') + 10
    return 0

## UTF-8 for one scalar into `out`; the bytes written.
func encode_scalar(out: u8[], scalar: u32) -> usize:
    if scalar < 0x80:
        out[0] = (u8)scalar
        return 1
    if scalar < 0x800:
        out[0] = (u8)(0xC0 | (scalar >> 6))
        out[1] = (u8)(0x80 | (scalar & 0x3F))
        return 2
    if scalar < 0x10000:
        out[0] = (u8)(0xE0 | (scalar >> 12))
        out[1] = (u8)(0x80 | ((scalar >> 6) & 0x3F))
        out[2] = (u8)(0x80 | (scalar & 0x3F))
        return 3
    out[0] = (u8)(0xF0 | (scalar >> 18))
    out[1] = (u8)(0x80 | ((scalar >> 12) & 0x3F))
    out[2] = (u8)(0x80 | ((scalar >> 6) & 0x3F))
    out[3] = (u8)(0x80 | (scalar & 0x3F))
    return 4

## A triple-quoted literal: the first line break after the opening quotes is dropped, the
## smallest indentation of the non-empty lines is removed from each, and a final line of
## only spaces before the closing quotes is dropped.
func strip_indentation(text: str) -> str!:
    var b = text.bytes
    if b.length > 0 and b[0] == '\n':
        b = b[1..]
    # the closing line: spaces after the last newline
    var end = b.length
    while end > 0 and b[end - 1] == ' ':
        end -= 1
    if end > 0 and b[end - 1] == '\n':
        end -= 1
    b = b[..<end]
    var indent: usize = 1000000
    var at_start = true
    var run: usize = 0
    var i: usize = 0
    while i < b.length:
        if at_start:
            if b[i] == ' ':
                run += 1
            elif b[i] == '\n':
                run = 0
            else:
                if run < indent:
                    indent = run
                at_start = false
        elif b[i] == '\n':
            at_start = true
            run = 0
        i += 1
    if indent == 1000000:
        indent = 0
    var out = try alloc u8[b.length + 1]
    var n: usize = 0
    i = 0
    var column: usize = 0
    while i < b.length:
        let c = b[i]
        if c == '\n':
            out[n] = c
            n += 1
            column = 0
        elif column < indent and c == ' ':
            column += 1
        else:
            out[n] = c
            n += 1
            column = indent
        i += 1
    return (str)out[..<n]

test "text decodes":
    assert(try decode_text("\"a\\nb\"") == "a\nb")
    assert(try decode_text("r\"a\\nb\"") == "a\\nb")
    assert(try decode_text("\"\\u{e9}\"") == "é")
    assert(try decode_text("\"\"\"\n    two\n    lines\n    \"\"\"") == "two\nlines")
