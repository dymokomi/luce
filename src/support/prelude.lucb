pub let source: str = "# These declarations are available in every module. Result is an ordinary enum;\n# its payload and error follow the same ownership rules as user-defined values.\ninterface Equatable:\n    func equals(self, other: Self) -> bool\n\ninterface Hashable:\n    func hashed(self) -> int\n\ninterface Ordered:\n    func compare(self, other: Self) -> int\n\ninterface Display:\n    func display(self) -> str\n\ninterface Iterator[T]:\n    func next(self) -> T?\n\ninterface Iterable[T]:\n    func iterator(self) -> Iterator[T]\n\npub enum Result[T]:\n    success(value: T)\n    failure(reason: Error)\n\n    ## Invoke the operation once and retain either its value or its owned error.\n    ## A closure is explicit here: creating it does not execute its body.\n    pub func capture(operation: func() -> T!) -> Result[T]:\n        let value: T = operation() catch failure:\n            return Result[T].failure(failure)\n        return Result[T].success(value)\n\n    ## Read the success value, or propagate the retained failure to this caller.\n    pub func get(self) -> T!:\n        match self:\n            .success(value): return value\n            .failure(failure): error(failure.code, failure.message)\n"
