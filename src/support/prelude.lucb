#==============================================================================================
#
#   prelude - The closed protocols
#
#   DESCRIPTION:
#       The interfaces the compiler knows (luce.md §13.3), as Luce source every program
#       begins with. A type declares one to replace the structural meaning of `==`,
#       `hash`, ordering or display, or, for a class, to have it at all. `Self` is the
#       conforming type.
#
#==============================================================================================

pub let source: str = "interface Equatable:\n    func equals(self, other: Self) -> bool\n\ninterface Hashable:\n    func hashed(self) -> int\n\ninterface Ordered:\n    func compare(self, other: Self) -> int\n\ninterface Display:\n    func display(self) -> str\n"
