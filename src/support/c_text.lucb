#==============================================================================================
#
#   c_text - Text handed to C
#
#   DESCRIPTION:
#       The C functions under `files` and `process` take NUL-terminated text; a `str` is a
#       view with a length. `copy` makes the one from the other, in the current allocator.
#
#==============================================================================================
import c
import strings

## `text` NUL-terminated in the current allocator, as a path or an argument C takes.
pub func copy(text: str) -> c.str!:
    return (c.str)try strings.copy(text)
