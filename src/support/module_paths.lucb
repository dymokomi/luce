## Public module resolution is owned by Base, including package exports and its
## canonical standard modules. This reader validates the compiler's path protocol.
import c
import process
import strings

pub let invalid: ErrorCode = ErrorCode.package(29)

pub struct Resolution:
    pub let name: str
    pub let path: str
    pub let root: str
    pub let base: bool
    pub let standard: bool

func field(text: str, position: usize*) -> str!:
    let end = strings.find_from(text, "\0", *position) else error(invalid, "a truncated Base module resolution")
    let value = try strings.copy((str)text.bytes[*position..<end])
    *position = end + 1
    return value

pub func resolve(compiler: str, importer: str, root: str, name: str, base_only: bool) -> Resolution!:
    let executable = try strings.copy(compiler)
    let source = try strings.copy(importer)
    let directory = try strings.copy(root)
    let module = try strings.copy(name)
    var arguments: c.str[5] = ["resolve", (c.str)source, (c.str)directory, (c.str)module, "--base"]
    let (status, output, diagnostic) = try process.run((c.str)executable, arguments[..<(5 if base_only else 4)])
    defer process.release(output)
    defer process.release(diagnostic)
    if status != 0:
        var message = strings.trim(diagnostic)
        if strings.starts_with(message, "luce-base: "):
            message = (str)message.bytes[11..]
        error(invalid, try strings.copy(message if message.length > 0 else "the Base module resolver could not be run"))
    let header = "luce-base-module-v1\0"
    if not strings.starts_with(output, header):
        error(invalid, "the Base compiler returned an unsupported module resolution format")
    var position = header.length
    let kind = try field(output, &position)
    let canonical = try field(output, &position)
    let path = try field(output, &position)
    let source_root = try field(output, &position)
    if position != output.length or (kind != "base" and kind != "luce" and kind != "standard"):
        error(invalid, "invalid Base module resolution records")
    if canonical.length == 0 or (kind != "standard" and (path.length == 0 or source_root.length == 0)):
        error(invalid, "a Base module resolution has no name or path")
    return Resolution(canonical, path, source_root, kind != "luce", kind == "standard")

## Descriptions name the declaration's canonical module, which may be private to
## a transitive dependency. Base's checked dependency report supplies its origin;
## resolving this name as a public source import would lose re-exported types.
pub func foreign_source(compiler: str, importer: str, name: str) -> str!:
    let executable = try strings.copy(compiler)
    defer strings.release(executable)
    let source = try strings.copy(importer)
    defer strings.release(source)
    let (status, output, diagnostic) = try process.run((c.str)executable, [(c.str)"dependencies", (c.str)source])
    defer process.release(output)
    defer process.release(diagnostic)
    if status != 0:
        error(invalid, try strings.copy(diagnostic if diagnostic.length > 0 else "the Base dependency reporter could not be run"))
    let header = "luce-base-dependencies-v3\0"
    if not strings.starts_with(output, header):
        error(invalid, "the Base compiler returned an unsupported dependency format")
    var position = header.length
    var found: str? = none
    errdefer release_path(found)
    while position < output.length:
        let kind = try field(output, &position)
        defer strings.release(kind)
        let module = try field(output, &position)
        defer strings.release(module)
        let value = try field(output, &position)
        defer strings.release(value)
        if kind != "source" and kind != "alias" and kind != "package" and kind != "native":
            error(invalid, "the Base compiler returned an unknown dependency record")
        if kind == "source" and module == name:
            if value.length == 0 or found != none:
                error(invalid, "a described Base module has an invalid or duplicate origin")
            found = try strings.copy(value)
    return found else error(invalid, "a described Base module is absent from its checked dependencies")

func release_path(value: str?):
    if let path = value:
        strings.release(path)
