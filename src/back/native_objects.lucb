## Canonical native owner declarations. These aliases use Base's existing owner
## header directly; crossing the boundary never allocates another object wrapper.
import io

pub func declaration(out: io.Writer, name: str, module: u32, native: str) -> !:
    try out.write(f"type L_{name} = interop.Owner[__luce_base_{module}.{native}]\n\n")
    try out.write(f"func L_{name}__value(value: L_{name}*) -> interop.Reference[__luce_base_{module}.{native}]:\n")
    try out.write(f"    return interop.Reference[__luce_base_{module}.{native}](value)\n\n")
    try out.write(f"func L_{name}__wrap(value: interop.Reference[__luce_base_{module}.{native}]) -> L_{name}*:\n")
    try out.write("    heap.check_alive(&value.owner.header)\n    return value.owner\n\n")
