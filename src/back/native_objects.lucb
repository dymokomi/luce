## Canonical native owner declarations. These aliases use Base's existing owner
## header directly; crossing the boundary never allocates another object wrapper.
import io

pub func declaration(out: io.Writer, name: str, module: str, native: str, view: bool) -> !:
    let owner = "ViewOwner" if view else "Owner"
    let carrier = "View" if view else "Reference"
    try out.write(f"type L_{name} = interop.{owner}[{module}.{native}]\n\n")
    try out.write(f"func L_{name}__value(value: L_{name}*) -> interop.{carrier}[{module}.{native}]:\n")
    try out.write(f"    return interop.{carrier}[{module}.{native}](value)\n\n")
    try out.write(f"func L_{name}__wrap(value: interop.{carrier}[{module}.{native}]) -> L_{name}*:\n")
    try out.write("    heap.check_alive(&value.owner.header)\n    return value.owner\n\n")
