#==============================================================================================
#
#   base/helpers - Helpers
#
#   DESCRIPTION:
#       Functions of the tree that need no emitter.
#
#==============================================================================================
# mark: Helpers ===============================================================================

## Whether the expression is the literal `none`.
func is_none(e: ast.Node*) -> bool:
    return e.kind == ast.Kind.literal and e.text == "none"

## Whether a pattern binds a name anywhere inside it.
func binds_a_name(p: ast.Node*) -> bool:
    if p.has(ast.flag_wildcard):
        return false
    if p.text == "bind":
        return true
    if p.text == "tuple":
        var cursor = p.body
        while let sub = cursor:
            if binds_a_name(sub):
                return true
            cursor = sub.next
    return false

## Whether every pattern in the list matches anything: `_`, a name, a tuple of those.
func irrefutable(patterns: ast.Node*?) -> bool:
    var cursor = patterns
    while let p = cursor:
        if p.text == "tuple":
            if not irrefutable(p.body):
                return false
        elif not (p.has(ast.flag_wildcard) or p.text == "bind"):
            return false
        cursor = p.next
    return true

## `<` for `<=`, `>` for `>=`: the strict form of an order, for a tuple's earlier members.
func strict(op: str) -> str:
    if op == "<=":
        return "<"
    if op == ">=":
        return ">"
    return op

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

## A specialized native adapter accepts exactly the arguments written at its call.
func supplied(call: ast.Node*?, parameter: ast.Node*) -> bool:
    let site = call else return true
    var cursor = site.body
    while let argument = cursor:
        if argument.resolved == parameter:
            return true
        cursor = argument.next
    return false

## Whether Base folds a constant's value as it is written: not when it builds
## a struct that wraps a Base one (`gpu.Color(...)`), which goes through a
## conversion function.
func folds(e: ast.Node*) -> bool:
    if e.kind == ast.Kind.call:
        if let d = e.resolved:
            if d.kind == ast.Kind.struct_ and d.has(ast.flag_native_value):
                return false
    if let left = e.left:
        if not folds(left):
            return false
    if let right = e.right:
        if not folds(right):
            return false
    var cursor = e.body
    while let m = cursor:
        if not folds(m):
            return false
        cursor = m.next
    return true
