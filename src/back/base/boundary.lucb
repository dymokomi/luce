#==============================================================================================
#
#   base/boundary - The Base boundary
#
#   DESCRIPTION:
#       Luce's view of Base modules: native types, values, objects, interfaces, and the
#       adapters that carry each across (§16).
#
#==============================================================================================
extend Emitter:
    # mark: The Base boundary ==================================================================

    ## The Base module a declaration read from a description belongs to, by its dotted name.
    ## Explicit aliases handle dotted imports and equal leaf names without extra
    ## allocated names. The checker module index is stable throughout emission.
    mutating func write_base_alias(module: u32) -> !:
        try self.writer().write_base_alias(module)

    ## A handle's public destroy function is also a Luce entry to close, not a raw call
    ## that can leave its wrapper open. Base checks the one-handle, unit-return signature.
    func destroyed_handle(d: ast.Node*) -> ast.Node*?:
        let p = d.right else return none
        if p.next != none:
            return none
        let t = self.checker.table.get(p.type_id)
        if t.kind != types.Kind.class_:
            return none
        let handle = t.decl else return none
        if not handle.has(ast.flag_base) or handle.module != d.module:
            return none
        let destroy = handle.left else return none
        return handle if destroy.text == d.text else none

    ## A Base function's shim: a function under the Luce name over Luce types, which lends
    ## or converts every argument as §16.2 says, calls the Base function, and copies or
    ## wraps what it answers. A failure crosses as it is.
    mutating func shim(d: ast.Node*, call: ast.Node*? = none) -> !:
        let ft = self.checker.table.get(d.type_id)
        self.fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        try self.begin("func ")
        if let site = call:
            try self.put(try self.native_call_name(site))
        else:
            try self.put("L_")
            try self.put(try self.decl_name(d))
        try self.put("(")
        var first = true
        var cursor = d.right
        while let p = cursor:
            if not supplied(call, p):
                cursor = p.next
                continue
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(p.text)
            try self.put(": ")
            let t = p.ty else return try self.fail(d, "a Base parameter without a type")
            if (t.has(ast.flag_func_type) and not t.has(ast.flag_native_callback)):
                try self.boundary().base_type(t, d)
            else:
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        if let handle = self.destroyed_handle(d):
            let p = d.right else return try self.fail(d, "a destroy function without its handle")
            try self.begin("L_")
            try self.put(self.type_name(handle))
            try self.put("__L_close(L_")
            try self.put(p.text)
            try self.put(")")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        let outcome = d.left != none and (d.left else return).has(ast.flag_native_outcome)
        try self.line("let mark = heap.mark()")
        try self.line("defer heap.drain(mark)")
        var result = ft.elem
        if self.checker.table.kind(result) == types.Kind.fallible:
            result = self.checker.table.get(result).elem
        if let site = call:
            try self.position_lines(site)
        try self.begin("")
        if outcome:
            try self.put("let outcome = ")
        elif result != types.unit_id:
            try self.put("let answer = ")
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(d.text)
        try self.put("(")
        first = true
        cursor = d.right
        while let p = cursor:
            if not supplied(call, p):
                cursor = p.next
                continue
            if not first:
                try self.put(", ")
            first = false
            try self.put(p.text)
            try self.put(" = ")
            let t = p.ty else break
            let half = self.checker.scratch.length // 2
            let name = try emission.copy_text(try format(self.checker.scratch[half..], f"L_{p.text}"))
            try self.boundary().to_base(t, name, d)
            cursor = p.next
        try self.put(")")
        if self.fallible and not outcome:
            try self.native_failure()
        else:
            try self.end()
        if outcome:
            try self.outcome_return((d.left else return), d)
        elif result != types.unit_id:
            let r = d.left else return try self.fail(d, "a Base result without a type")
            var inner = r
            if r.has(ast.flag_fallible):
                inner = r.left else return try self.fail(d, "a result without a type")
            try self.begin("return ")
            try self.boundary().from_base(inner, "answer", d)
            try self.end()
        self.indent -= 1
        try self.line("")

    ## Only omitted-argument calls need a distinct adapter. Full-arity function
    ## values continue to use the canonical shim over the complete signature.
    mutating func native_call_name(call: ast.Node*) -> str!:
        var i: usize = 0
        while i < self.native_calls.count:
            if self.native_calls.get(i) == call:
                break
            i += 1
        if i == self.native_calls.count:
            try self.native_calls.push(call)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try format(self.checker.scratch[half..], f"L_native_call_{i}"))

    ## Construct the actual Base value; an initializer is never translated into
    ## assignments to a public-field snapshot. Failed construction publishes nothing.
    mutating func native_constructor(call: ast.Node*, declaration: ast.Node*) -> !:
        let owner = (declaration.resolved else return try self.fail(call, "a native initializer has no owner")) if declaration.kind == ast.Kind.func_ else declaration
        try self.begin("func ")
        try self.put(try self.native_call_name(call))
        try self.put("(")
        var cursor = call.body
        var first = true
        while let argument = cursor:
            let parameter = argument.resolved else return
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(parameter.text)
            try self.put(": ")
            let t = parameter.ty else return
            if (t.has(ast.flag_func_type) and not t.has(ast.flag_native_callback)):
                try self.boundary().base_type(t, owner)
            else:
                try self.type_of(parameter.type_id)
            cursor = argument.next
        try self.put(")")
        try self.result_type(call.type_id)
        try self.put(":")
        try self.end()
        self.indent += 1
        self.fallible = self.checker.table.kind(call.type_id) == types.Kind.fallible
        try self.position_lines(call)
        try self.line("let mark = heap.mark()")
        try self.line("defer heap.drain(mark)")
        if let native = owner.native_object:
            try self.begin("var reservation = interop.Reservation[")
            try self.write_base_alias(owner.module)
            try self.put(".")
            try self.put(owner.text)
            try self.put("](")
            try self.write_base_alias(owner.module)
            try self.put(".")
            try self.put(native.descriptor)
            try self.put(") catch failure: trap(failure.message)")
            try self.end()
            try self.line("defer reservation.cancel()")
        try self.begin("let native = ")
        if owner.native_object != none:
            try self.put("new ")
        try self.write_base_alias(owner.module)
        try self.put(".")
        try self.put(owner.text)
        try self.put("(")
        cursor = call.body
        first = true
        while let argument = cursor:
            let parameter = argument.resolved else return
            if not first:
                try self.put(", ")
            first = false
            try self.put(parameter.text)
            try self.put(" = ")
            let t = parameter.ty else return
            let half = self.checker.scratch.length // 2
            let name = try emission.copy_text(try format(self.checker.scratch[half..], f"L_{parameter.text}"))
            try self.boundary().to_base(t, name, owner)
            cursor = argument.next
        try self.put(")")
        if owner.native_object != none:
            try self.put(" in memory.heap")
        if self.fallible:
            try self.native_failure()
        elif owner.native_object != none:
            try self.put(" catch failure: trap(failure.message)")
            try self.end()
        else:
            try self.end()
        if owner.native_object != none:
            try self.line("return reservation.publish(native, memory.heap).owner")
        else:
            let t = try native_types.native_node(owner)
            try self.begin("return ")
            try self.boundary().from_base(t, "native", owner)
            try self.end()
        self.indent -= 1
        try self.line("")

    ## The public projection owns its references. Rebase a fresh native copy on
    ## entry; after mutation convert the complete value before releasing the old
    ## projection. Deferred writeback also preserves mutations made before an error.
    mutating func native_writeback(owner: ast.Node*) -> !:
        let t = try native_types.native_node(owner)
        try self.begin("static func writeback(target: L_")
        try self.put(self.type_name(owner))
        try self.put("*, native: ")
        try self.boundary().base_type(t, owner)
        try self.put("*):")
        try self.end()
        self.indent += 1
        try self.begin("let updated = ")
        try self.boundary().from_base(t, "*native", owner)
        try self.end()
        if self.checker.table.has_references(owner.type_id):
            try self.begin("")
            try self.put(try self.lifetime_name("L_drop_", owner.type_id))
            try self.put("(*target)")
            try self.end()
        try self.line("*target = updated")
        self.indent -= 1
        try self.line("")

    ## A field read copies borrowed text/data, or acquires a native child reference.
    ## Stores are admitted only for scalars whose native and Luce storage agree.
    mutating func native_field(field: ast.Node*, owner: ast.Node*) -> !:
        let t = field.ty else return
        try self.begin("func L_")
        try self.put(self.type_name(owner))
        try self.put("__get_")
        try self.put(field.text)
        try self.put("(L_self: ")
        try self.type_of(owner.type_id)
        try self.put(") -> ")
        try self.type_of(field.type_id)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.begin("let value = L_")
        try self.put(self.type_name(owner))
        try self.put("__value(L_self).value().")
        try self.put(field.text)
        try self.end()
        try self.begin("return ")
        try self.boundary().borrow_from_base(t, "value", owner)
        try self.end()
        self.indent -= 1
        try self.line("")

        if field.has(ast.flag_var_field):
            try self.begin("func L_")
            try self.put(self.type_name(owner))
            try self.put("__set_")
            try self.put(field.text)
            try self.put("(L_self: ")
            try self.type_of(owner.type_id)
            try self.put(", value: ")
            try self.type_of(field.type_id)
            try self.put("):")
            try self.end()
            try self.begin("    L_")
            try self.put(self.type_name(owner))
            let native = owner.native_object else return
            try self.put("__value(L_self).value_mut()." if native.view else "__value(L_self).value().")
            try self.put(field.text)
            try self.put(" = value")
            try self.end()
            try self.line("")

    ## A full method serves bound values and interface dispatch. Direct calls use
    ## their own argument shape so Base, including its initializer scope, owns defaults.
    mutating func native_method(method: ast.Node*, owner: ast.Node*, call: ast.Node*? = none) -> !:
        let instance = check.has_self(method)
        let owned = owner.native_object != none
        let mutates = method.has(ast.flag_mutating) and not owned
        let outcome = method.left != none and (method.left else return).has(ast.flag_native_outcome)
        let ft = self.checker.table.get(method.type_id)
        self.fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        var result = self.checker.table.get(ft.elem).elem if self.fallible else ft.elem
        try self.native_signature(method, owner, call, instance, owned, mutates, ft)
        self.indent += 1
        try self.line("let mark = heap.mark()")
        try self.line("defer heap.drain(mark)")
        if owned and instance:
            try self.begin("let reference = L_")
            try self.put(self.type_name(owner))
            try self.put("__value(L_self)")
            try self.end()
            let native = owner.native_object else return
            let query = "is_valid" if native.view else "is_closed"
            if method.text == query:
                try self.line("return reference.is_valid()" if native.view else "return reference.is_closed()")
                self.indent -= 1
                try self.line("")
                return
            if native.view:
                try self.line("try reference.enter()" if self.fallible else "reference.enter() catch failure: trap(failure.message)")
            else:
                try self.line("reference.enter()")
            try self.line("defer reference.leave()")
            if not native.view and method.text == "close":
                try self.line("reference.close()")
                self.indent -= 1
                try self.line("")
                return
            let mutating_view = native.view and method.has(ast.flag_mutating)
            if self.fallible:
                try self.line("let native = try reference.get_mut()" if mutating_view else "let native = try reference.get()")
            else:
                try self.line("let native = reference.value_mut()" if mutating_view else "let native = reference.value()")
        elif instance:
            let t = try native_types.native_node(owner)
            try self.begin("var native = " if mutates else "let native = ")
            try self.boundary().to_base(t, "self" if call == none else ("*L_self" if mutates else "L_self"), owner)
            try self.end()
            if mutates:
                try self.begin("defer L_")
                try self.put(self.type_name(owner))
                try self.put(".writeback(")
                try self.put("&self" if call == none else "L_self")
                try self.put(", &native)")
                try self.end()
        try self.native_base_call(method, owner, call, instance, outcome, result)
        if outcome:
            try self.outcome_return((method.left else return), owner)
        elif result != types.unit_id:
            let written = method.left else return
            let t = (written.left else return) if written.has(ast.flag_fallible) else written
            try self.begin("return ")
            try self.boundary().from_base(t, "answer", owner)
            try self.end()
        self.indent -= 1
        try self.line("")

    ## A native method's signature: a call site's own function, an owned object's free function
    ## over its handle, or the binding's method, with the supplied parameters in Base types.
    mutating func native_signature(method: ast.Node*, owner: ast.Node*, call: ast.Node*?, instance: bool, owned: bool, mutates: bool, ft: types.Type) -> !:
        if let site = call:
            try self.begin("func ")
            try self.put(try self.native_call_name(site))
        elif owned:
            try self.begin("func L_")
            try self.put(self.type_name(owner))
            try self.put("__L_")
            try self.put(method.text)
        else:
            try self.begin("pub ")
            try self.put("mutating " if mutates else ("" if instance else "static "))
            try self.put("func L_")
            try self.put(method.text)
        try self.put("(")
        var first = true
        if (call != none or owned) and instance:
            try self.put("L_self: ")
            try self.type_of(owner.type_id)
            if mutates:
                try self.put("*")
            first = false
        var cursor = method.right
        while let parameter = cursor:
            if parameter.text != "self" and supplied(call, parameter):
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(parameter.text)
                try self.put(": ")
                let t = parameter.ty else return
                if call != none and (t.has(ast.flag_func_type) and not t.has(ast.flag_native_callback)):
                    try self.boundary().base_type(t, owner)
                else:
                    try self.type_of(parameter.type_id)
            cursor = parameter.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()

    ## The call into Base: each supplied argument converted to its Base form, a Luce callback
    ## passed as its code; the answer or outcome kept for the return, a failure passed on.
    mutating func native_base_call(method: ast.Node*, owner: ast.Node*, call: ast.Node*?, instance: bool, outcome: bool, result: u32) -> !:
        try self.begin("let outcome = " if outcome else ("let answer = " if result != types.unit_id else ""))
        if instance:
            try self.put("native.")
        else:
            try self.write_base_alias(owner.module)
            try self.put(".")
            try self.put(owner.text)
            try self.put(".")
        try self.put(method.text)
        try self.put("(")
        var first = true
        var cursor = method.right
        while let parameter = cursor:
            if parameter.text != "self" and supplied(call, parameter):
                if not first:
                    try self.put(", ")
                first = false
                try self.put(parameter.text)
                try self.put(" = ")
                let t = parameter.ty else return
                let half = self.checker.scratch.length // 2
                let name = try emission.copy_text(try format(self.checker.scratch[half..], f"L_{parameter.text}"))
                if call == none and (t.has(ast.flag_func_type) and not t.has(ast.flag_native_callback)):
                    try self.put("(")
                    try self.boundary().base_type(t, owner)
                    try self.put(")kernel.callback_code(")
                    try self.put(name)
                    try self.put(")")
                else:
                    try self.boundary().to_base(t, name, owner)
            cursor = parameter.next
        try self.put(")")
        if self.fallible and not outcome:
            try self.native_failure()
        else:
            try self.end()

    mutating func outcome_return(written: ast.Node*, owner: ast.Node*) -> !:
        let inner = written.left else return
        try self.line("defer outcome.release()")
        try self.begin("let answer = " if inner.type_id != types.unit_id else "")
        try self.put("outcome.get()")
        try self.native_failure()
        if inner.type_id != types.unit_id:
            try self.begin("return ")
            try self.boundary().borrow_from_base(inner, "answer", owner)
            try self.end()

    ## Native failures may borrow receiver storage. Own the message before any
    ## deferred writeback releases the old projection, then use Luce's error chain.
    mutating func native_failure() -> !:
        try self.put(" catch failure:")
        try self.end()
        try self.line("    let saved = kernel.catch_failure(failure.code, failure.message)")
        try self.line("    defer kernel.drop_failure(saved)")
        try self.line("    error(saved.code, kernel.message_of(saved.message))")

    ## The arguments of a call into Base: a function-typed parameter gets the thunk of the
    ## named function given (§16.2), every other its value as any call would pass it.
    mutating func base_arguments(e: ast.Node*, d: ast.Node*) -> !:
        try self.put("(")
        var first = true
        if d.text != "init" and check.has_self(d):
            let callee = e.left else return
            let receiver = callee.left else return
            try self.put("L_self = ")
            if d.has(ast.flag_mutating) and self.checker.table.is_value(receiver.type_id):
                try self.put("&")
            if d.has(ast.flag_mutating) and self.checker.table.is_value(receiver.type_id):
                try self.use(receiver)
            else:
                try self.borrow_for_call(receiver)
            first = false
        var a = e.body
        while let arg = a:
            if not first:
                try self.put(", ")
            first = false
            let p = arg.resolved else return try self.fail(arg, "an argument without its parameter")
            let v = arg.left else return try self.fail(arg, "empty argument")
            try self.put("L_")
            try self.put(p.text)
            try self.put(" = ")
            if self.checker.table.kind(p.type_id) == types.Kind.func_ and not (p.ty else return).has(ast.flag_native_callback):
                let f = v.resolved else return try self.fail(v, "a callback that is not a named function")
                try self.put(try self.callback_name(f))
            else:
                try self.borrow_for_call(v)
            a = arg.next
        try self.put(")")

    ## A Base constant read: its value converted where it is read; a text copied into a
    ## text of the program's own.
    mutating func base_constant(d: ast.Node*) -> !:
        let t = d.ty else return try self.fail(d, "a Base constant without a type")
        let half = self.checker.scratch.length // 2
        let namespace = try self.writer().module_alias(d.module)
        let spelled = try emission.copy_text(try format(self.checker.scratch[half..], f"{namespace}.{d.text}"))
        try self.boundary().from_base(t, spelled, d)

    ## `L_callback_N`: the thunk over Base's types that calls a named Luce function.
    mutating func callback_name(f: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.callbacks.count
        while i < self.callbacks.count:
            if self.callbacks.get(i) == f:
                at = i
            i += 1
        if at == self.callbacks.count:
            try self.callbacks.push(f)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try format(self.checker.scratch[half..], f"L_callback_{at}"))

    ## The pair of functions for every crossing type, and the thunk for every callback.
    mutating func boundary_support() -> !:
        while self.native_calls_done < self.native_calls.count:
            let call = self.native_calls.get(self.native_calls_done)
            self.native_calls_done += 1
            let declaration = call.resolved else return try self.fail(call, "a native call has no declaration")
            if declaration.kind == ast.Kind.struct_ or declaration.kind == ast.Kind.class_ or declaration.text == "init":
                try self.native_constructor(call, declaration)
            elif let owner = declaration.resolved:
                try self.native_method(declaration, owner, call)
            else:
                try self.shim(declaration, call)
        try self.boundary().emit_pending()
        while self.callbacks_done < self.callbacks.count:
            let f = self.callbacks.get(self.callbacks_done)
            self.callbacks_done += 1
            try self.callback_thunk(f, self.callbacks_done - 1)

    ## Render a small adapter fragment without keeping it in the output stream.
    mutating func take_output(start: usize) -> str!:
        return try self.writer().take_output(start)

    ## A callback's thunk: Base's arguments made into Luce values for the call, released
    ## after it; the answer a scalar (the description admits no other).
    mutating func callback_thunk(f: ast.Node*, index: usize) -> !:
        let ft = self.checker.table.get(f.type_id)
        try self.begin("func L_callback_")
        try self.put_u64((u64)index)
        try self.put("(")
        var first = true
        var i: usize = 0
        var cursor = f.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("a")
            try self.put_u64((u64)i)
            try self.put(": ")
            try self.base_luce_type(p.type_id)
            i += 1
            cursor = p.next
        try self.put(")")
        if ft.elem != types.unit_id:
            try self.put(" -> ")
            try self.base_luce_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("let mark = heap.mark()")
        try self.begin("")
        if ft.elem != types.unit_id:
            try self.put("let answer = ")
        try self.put("L_")
        if f.has(ast.flag_base) and f.resolved != none:
            let owner = f.resolved else return
            try self.put(self.type_name(owner))
            try self.put(".L_")
            try self.put(f.text)
        else:
            try self.put(try self.decl_name(f))
        try self.put("(")
        first = true
        i = 0
        cursor = f.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            let half = self.checker.scratch.length // 2
            let name = try emission.copy_text(try format(self.checker.scratch[half..], f"a{i}"))
            try self.luce_from_base_value(p.type_id, name)
            i += 1
            cursor = p.next
        try self.put(")")
        try self.end()
        try self.line("heap.drain(mark)")
        if ft.elem != types.unit_id:
            try self.line("return answer")
        self.indent -= 1
        try self.line("")

    ## The Base spelling of a Luce type at a callback's edge: scalars, texts and bytes.
    mutating func base_luce_type(id: u32) -> !:
        match self.checker.table.kind(id):
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("str")
            .bytes_: try self.put("const u8[]")
            _: return try self.fail(self.checker.tree(), "a callback parameter Base cannot pass")

    ## A Base argument as a Luce value for a callback, a temporary of the call for texts.
    mutating func luce_from_base_value(id: u32, v: str) -> !:
        match self.checker.table.kind(id):
            .str_:
                try self.put(try self.lifetime_name("L_pool_", id))
                try self.put("(kernel.text_of(")
                try self.put(v)
                try self.put("))")
            .bytes_:
                try self.put(try self.lifetime_name("L_pool_", id))
                try self.put("(kernel.bytes_of(")
                try self.put(v)
                try self.put("))")
            _: try self.put(v)

    ## A handle (§16.4): a class holding the Base value, closed once by `close()` or when
    ## its last reference goes; a closed handle handed to Base traps.
    mutating func handle_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        let destroy = d.left else return try self.fail(d, "a handle without its destroy function")
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.begin("    var value: ")
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(d.text)
        try self.end()
        try self.line("    var closed: bool")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__L_close(L_self: L_")
        try self.put(name)
        try self.put("*):")
        try self.end()
        try self.line("    if not L_self.closed:")
        try self.line("        L_self.closed = true")
        try self.begin("        ")
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(destroy.text)
        try self.put("(L_self.value)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    L_")
        try self.put(name)
        try self.put("__L_close((L_")
        try self.put(name)
        try self.put("*)o)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.line("    discard(o)")
        try self.line("")
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(d.text)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = none, drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__wrap(v: ")
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(d.text)
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*:")
        try self.end()
        try self.begin("    let o = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.line("    o.value = v")
        try self.line("    o.closed = false")
        try self.line("    return o")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__value(h: L_")
        try self.put(name)
        try self.put("*) -> ")
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        try self.line("    if h.closed:")
        try self.line("        trap(\"a closed handle was handed to Base\")")
        try self.line("    return h.value")
        try self.line("")

    ## A class: a Base struct with the runtime's header first, its methods as free functions
    ## over a pointer, the descriptor the runtime destroys and traces it by, and `new`.
    mutating func class_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("var header: heap.Object")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        cursor = d.body
        var init: ast.Node*? = none
        var has_deinit = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, name)
                if m.text == "init":
                    init = m
                if m.text == "deinit":
                    has_deinit = true
            cursor = m.next
        if has_deinit:
            try self.class_finish(name)
        var fields = try list.List[ast.Node*].create(8)
        defer fields.destroy()
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try fields.push(m)
            cursor = m.next
        try self.class_drop(name, &fields)
        try self.class_trace(name, &fields)
        try self.class_info(d, name, has_deinit)
        try self.class_constructor(name, init, &fields)

    ## A class's finish: the descriptor's hook that runs its `deinit` when the object dies.
    mutating func class_finish(name: str) -> !:
        try self.begin("func L_")
        try self.put(name)
        try self.put("__finish(o: heap.Object*):")
        try self.end()
        try self.begin("    L_")
        try self.put(name)
        try self.put("__L_deinit((L_")
        try self.put(name)
        try self.put("*)o)")
        try self.end()
        try self.line("")

    ## A class's drop: the fields go last first; one never assigned (an `init` that failed) is
    ## zero and every drop tolerates that.
    mutating func class_drop(name: str, fields: list.List[ast.Node*]*) -> !:
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        var i = fields.count
        var any = false
        while i > 0:
            i -= 1
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(")")
                try self.end()
                any = true
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")

    ## A class's trace: each field holding references visited, first to last.
    mutating func class_trace(name: str, fields: list.List[ast.Node*]*) -> !:
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        var any = false
        var i: usize = 0
        while i < fields.count:
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(", visit, context)")
                try self.end()
                any = true
            i += 1
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")

    ## A class's descriptor: its finish when it has a `deinit`, its drop and trace, and whether
    ## the collector may skip it as acyclic.
    mutating func class_info(d: ast.Node*, name: str, has_deinit: bool) -> !:
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(name)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = ")
        if has_deinit:
            try self.put("L_")
            try self.put(name)
            try self.put("__finish")
        else:
            try self.put("none")
        try self.put(", drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace")
        if self.checker.table.acyclic(d.type_id):
            try self.put(", acyclic = true")  # the collector never walks it (RUNTIME, Cycles)
        try self.put(")")
        try self.end()
        try self.line("")

    ## A class's constructor (§10): the object allocated, the field defaults, then `init`; a
    ## failing `init` abandons the half-built object and passes its failure on.
    mutating func class_constructor(name: str, init: ast.Node*?, fields: list.List[ast.Node*]*) -> !:
        var fallible = false
        if let f = init:
            let result = self.checker.table.get(f.type_id).elem
            fallible = self.checker.table.kind(result) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(name)
        try self.put("__new(")
        if let f = init:
            try self.init_parameters(f)
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*!:" if fallible else "*:")
        try self.end()
        self.indent += 1
        self.fallible = fallible
        try self.begin("let L_self = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        var i: usize = 0
        while i < fields.count:
            let f = fields.get(i)
            if let default = f.left:
                try self.begin("L_self.L_")
                try self.put(f.text)
                try self.put(" = ")
                try self.owned(default)
                try self.end()
            i += 1
        if let f = init:
            try self.begin("")
            try self.put("L_")
            try self.put(name)
            try self.put("__L_init(L_self")
            try self.init_arguments(f, true)
            try self.put(")")
            if fallible:
                try self.put(" catch failure:")
                try self.end()
                try self.line("    heap.abandon((heap.Object*)L_self)")
                try self.line("    error(failure.code, failure.message)")
            else:
                try self.end()
        try self.line("return L_self")
        self.indent -= 1
        try self.line("")

    ## A struct's constructor through its own `init` (§9.1): the value starts zeroed, which
    ## every drop tolerates, takes the field defaults, then `init` runs over it; a failing
    ## `init` drops what it had assigned and passes its failure on.
    mutating func struct_constructor(d: ast.Node*, init: ast.Node*) -> !:
        let name = self.type_name(d)
        let fallible = self.checker.table.kind(self.checker.table.get(init.type_id).elem) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(name)
        try self.put("__new(")
        try self.init_parameters(init)
        try self.put(") -> L_")
        try self.put(name)
        try self.put("!:" if fallible else ":")
        try self.end()
        self.indent += 1
        self.fallible = fallible
        try self.begin("var L_self: L_")
        try self.put(name)
        try self.end(" = ---")
        try self.begin("memory.set(u8[]((u8*)&L_self, sizeof(L_")
        try self.put(name)
        try self.end(")), 0)")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                if let default = m.left:
                    try self.begin("L_self.L_")
                    try self.put(m.text)
                    try self.put(" = ")
                    try self.owned(default)
                    try self.end()
            cursor = m.next
        let releases = fallible and self.checker.table.has_references(d.type_id)
        try self.begin("try L_self.L_init(" if fallible and not releases else "L_self.L_init(")
        try self.init_arguments(init, false)
        if releases:
            try self.end(") catch failure:")
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", d.type_id))
            try self.end("(L_self)")
            try self.line("    error(failure.code, failure.message)")
        else:
            try self.end(")")
        try self.line("return L_self")
        self.indent -= 1
        try self.line("")

    ## A constructor's parameters: `init`'s, less `self`.
    mutating func init_parameters(init: ast.Node*) -> !:
        var first = true
        var cursor = init.right
        while let param = cursor:
            if param.text != "self":
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(param.text)
                try self.put(": ")
                try self.type_of(param.type_id)
            cursor = param.next

    ## The constructor's parameters passed on to `init`, after a receiver when `follows`.
    mutating func init_arguments(init: ast.Node*, follows: bool) -> !:
        var first = not follows
        var cursor = init.right
        while let param = cursor:
            if param.text != "self":
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(param.text)
            cursor = param.next

    mutating func enum_decl(d: ast.Node*) -> !:
        try self.begin("enum L_")
        try self.put(self.type_name(d))
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin("L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        try self.put(": ")
                        try self.type_of(field.type_id)
                        p = field.next
                    try self.put(")")
                try self.end()
            cursor = m.next
        if d.has(ast.flag_base):
            cursor = d.body
            while let method = cursor:
                if method.kind == ast.Kind.func_:
                    try self.native_method(method, d)
                cursor = method.next
            try self.native_writeback(d)
        self.indent -= 1
        try self.line("")
        # an enum's methods are free functions over it, `self` an ordinary parameter
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_ and not m.has(ast.flag_base):
                try self.function(m, self.type_name(d))
            cursor = m.next

    ## `owner` is "" for a free function, "method" for a struct's, an enum's name for its.
    mutating func function(f: ast.Node*, owner: str) -> !:
        let t = self.checker.table.get(f.type_id)
        self.fallible = self.checker.table.kind(t.elem) == types.Kind.fallible
        var prefix = "func L_"
        if owner == "method":
            if not check.has_self(f):
                prefix = "static func L_"
            elif f.has(ast.flag_mutating):
                prefix = "mutating func L_"
        try self.begin(prefix)
        if owner != "" and owner != "method":
            try self.put(owner)
            try self.put("__L_")
            try self.put(f.text)
        elif owner == "":
            try self.put(try self.decl_name(f))
        else:
            try self.put(f.text)
        try self.put("(")
        var first = true
        var cursor = f.right
        self.self_name = "self"
        while let p = cursor:
            if p.text == "self":
                if owner != "method":
                    try self.put("L_self: L_")
                    try self.put(owner)
                    if self.checker.table.kind(p.type_id) == types.Kind.class_:
                        try self.put("*")
                    first = false
                    self.self_name = "L_self"
            else:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if t.elem != types.unit_id:
            try self.put(" -> ")
            try self.type_of(t.elem)
        elif self.checker.table.kind(t.elem) == types.Kind.fallible:
            try self.put(" -> !")
        try self.put(":")
        try self.end()
        let body = f.body else return
        self.indent += 1
        try self.site_prologue()
        try self.block(body)
        self.indent -= 1
        try self.line("#:")
        try self.line("")
        self.self_name = "self"
