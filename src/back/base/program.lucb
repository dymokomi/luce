#==============================================================================================
#
#   base/program - The program
#
#   DESCRIPTION:
#       The whole emitted Base program: its modules, entry, classes, and declarations in
#       the order Base reads them.
#
#==============================================================================================
extend Emitter:
    # mark: The program ========================================================================

    ## Writes the whole generated module: imports, the text literals, every declaration,
    ## the entry point (or test runner), then the support functions the program needs.
    pub mutating func program() -> !:
        try self.line("## generated by luce; edit the .luc source, not this")
        try self.line("import memory")
        try self.line("import interop")
        try self.line("import ownership as heap")
        try self.begin("import ")
        try self.put(self.runtime_namespace)
        try self.put(".kernel")
        try self.end()
        var k: usize = 0
        while k < self.checker.modules.count:
            let m = self.checker.modules.get(k)
            if m.base and not (m.standard and emission.runtime_alias(m.name) != none):
                try self.begin("import ")
                try self.put(m.name)
                try self.put(" as ")
                try self.write_base_alias((u32)k)
                try self.end()
            k += 1
        try self.line("")
        # the literal objects come before the declarations: a constant of the program
        # holds the address of one, and the C backend defines globals in order
        let start = self.out.used
        k = 0
        while k < self.checker.order.count:
            let tree = self.checker.modules.get((usize)self.checker.order.get(k)).tree
            k += 1
            try self.declarations(tree)
        let body = try self.capture(start)
        try self.text_objects()
        try self.put(body)
        try self.program_tail()

    ## The declarations of one module, in order.
    mutating func declarations(tree: ast.Node*) -> !:
        var cursor = tree.body
        while let d = cursor:
            # a generic declaration is never written, nor an instance over a parameter
            let concrete = d.ty == none or (d.has(ast.flag_instance) and not self.checker.abstract_instance(d))
            if d.has(ast.flag_base):
                # a Base module's declarations (§16): a shim per function, a class per handle,
                # the crossing types as they are; constants are read where they are used
                match d.kind:
                    .func_: try self.shim(d)
                    .class_:
                        if d.native_object != none:
                            try native_objects.declaration(&self.out, self.type_name(d), try self.writer().module_alias(d.module), d.text, (d.native_object else return).view)
                            var member = d.body
                            while let method = member:
                                if method.kind == ast.Kind.func_ and method.text != "init":
                                    try self.native_method(method, d)
                                elif method.kind == ast.Kind.field:
                                    try self.native_field(method, d)
                                member = method.next
                        else:
                            try self.handle_decl(d)
                    .interface_:
                        try self.interface_decl(d)
                        try self.native_interface(d)
                    .struct_: try self.struct_decl(d)
                    .enum_: try self.enum_decl(d)
                    _: discard(0)
                cursor = d.next
                continue
            match d.kind:
                .constant: try self.constant(d)
                .struct_:
                    if concrete:
                        try self.struct_decl(d)
                .enum_:
                    if concrete:
                        try self.enum_decl(d)
                .class_:
                    if concrete:
                        try self.class_decl(d)
                .interface_:
                    if concrete and (not d.has(ast.flag_prelude) or d.has(ast.flag_instance)):
                        try self.interface_decl(d)
                .type_alias: discard(0)
                .func_:
                    if concrete:
                        try self.function(d, "")
                .test_:
                    if self.tests_mode:
                        try self.test_function(d)
                _: discard(0)
            cursor = d.next

    ## A test as a fallible function of nothing (§17.3).
    mutating func test_function(d: ast.Node*) -> !:
        let index = self.test_names.count
        try self.test_names.push(try emission.copy_text(try literals.decode_text(d.text)))
        self.fallible = true
        try self.begin("func L_test_")
        try self.put_u64((u64)index)
        try self.put("() -> !:")
        try self.end()
        let body = d.body else return
        self.indent += 1
        try self.site_prologue()
        try self.block(body)
        self.indent -= 1
        try self.line("#:")
        try self.line("")

    mutating func program_tail() -> !:
        if self.tests_mode:
            try self.test_runner()
            try self.support_functions()
            return
        let args_type = try self.checker.table.list_of(types.str_id)
        let args_info = try self.lifetime_name("L_info_", args_type)
        let args_ops = try self.ops_name(types.str_id)
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    kernel.startup()")
        try self.begin("    let args = kernel.list_from_args(&")
        try self.put(args_info)
        try self.put(", ")
        try self.put(args_ops)
        try self.put(", arguments[1..])")
        try self.end()
        let main = self.checker.find_declaration("main") else error(emission.unsupported, "the entry function is missing")
        try self.begin("    let status = L_")
        try self.put(try self.decl_name(main))
        try self.put("(args) catch failure:")
        try self.end()
        try self.line("        let caught = kernel.catch_failure(failure.code, failure.message)")
        try self.line("        kernel.print_error(caught.message.data)")
        try self.line("        kernel.drop_failure(caught)")
        try self.line("        heap.release((heap.Object*)args)")
        try self.line("        return heap.finish_run(1)")
        try self.line("    heap.release((heap.Object*)args)")
        try self.line("    return heap.finish_run(i32(status))")
        try self.support_functions()

    ## `main` of a test build: every test in order, each reported, then the summary and
    ## the heap's word (§17.3).
    mutating func test_runner() -> !:
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    kernel.startup()")
        try self.line("    discard(arguments)")
        try self.line("    var failures: i64 = 0")
        var i: usize = 0
        while i < self.test_names.count:
            let name = try self.text_ref(self.test_names.get(i), false)
            try self.begin("    let before_")
            try self.put_u64((u64)i)
            try self.put(" = failures")
            try self.end()
            try self.begin("    L_test_")
            try self.put_u64((u64)i)
            try self.put("() catch failure:")
            try self.end()
            try self.line("        let caught = kernel.catch_failure(failure.code, failure.message)")
            try self.line("        defer kernel.drop_failure(caught)")
            try self.line("        failures += 1")
            try self.begin("        kernel.test_failed(kernel.text_view(")
            try self.put(name)
            try self.put("), \"")
            try self.put(try self.test_position(i))
            try self.put("\", caught.message.data)")
            try self.end()
            try self.line("        recover ()")
            try self.begin("    if failures == before_")
            try self.put_u64((u64)i)
            try self.put(":")
            try self.end()
            try self.begin("        kernel.test_passed(kernel.text_view(")
            try self.put(name)
            try self.put("))")
            try self.end()
            try self.line("    heap.drain(0)")
            i += 1
        try self.begin("    let status = kernel.test_summary(")
        try self.put_u64((u64)self.test_names.count)
        try self.put(", failures)")
        try self.end()
        try self.line("    return heap.finish_run(status)")

    ## `file:line:column` of the test at `index`, as the interpreter reports it.
    mutating func test_position(index: usize) -> str!:
        var seen: usize = 0
        var k: usize = 0
        while k < self.checker.order.count:
            let module_index = (usize)self.checker.order.get(k)
            k += 1
            let m = self.checker.modules.get(module_index)
            if module_index == 0 or m.base:
                continue
            var cursor = m.tree.body
            while let d = cursor:
                if d.kind == ast.Kind.test_:
                    if seen == index:
                        let (line, column) = m.src.position(d.start)
                        let half = self.checker.scratch.length // 2
                        return try emission.copy_text(try format(self.checker.scratch[half..], f"{m.src.path}:{line}:{column}"))
                    seen += 1
                cursor = d.next
        return "?"

    mutating func constant(d: ast.Node*) -> !:
        let init = d.left else return
        if not folds(init):
            # A value Base cannot fold (a struct that wraps a Base one is built
            # through its conversion): a function, called where it is read.
            try self.begin("func L_")
            try self.put(try self.decl_name(d))
            try self.put("() -> ")
            try self.type_of(d.type_id)
            try self.put(":")
            try self.end()
            self.indent += 1
            try self.begin("return ")
            try self.expr(init)
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        try self.begin("let L_")
        try self.put(try self.decl_name(d))
        try self.put(": ")
        try self.type_of(d.type_id)
        try self.put(" = ")
        self.in_constant = true
        try self.expr(init)
        self.in_constant = false
        try self.end()
        try self.line("")

    ## A constant emitted as a function is read by calling it.
    mutating func constant_read(d: ast.Node*) -> !:
        let init = d.left else return
        if not folds(init):
            try self.put("()")

    mutating func struct_decl(d: ast.Node*) -> !:
        try self.begin("struct L_")
        try self.put(self.type_name(d))
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        var fields: u32 = 0
        if d.has(ast.flag_native_value):
            try self.begin("pub var native: ")
            try self.write_base_alias(d.module)
            try self.put(".")
            try self.put(d.text)
            try self.end()
            fields += 1
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
                fields += 1
            cursor = m.next
        if fields == 0:
            try self.line("pub var nothing: u8")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                if m.has(ast.flag_base):
                    if m.text != "init":
                        try self.native_method(m, d)
                else:
                    try self.line("")
                    try self.function(m, "method")
            cursor = m.next
        if d.has(ast.flag_native_value):
            try self.native_writeback(d)
        self.indent -= 1
        try self.line("")

    ## An interface (§13.2): its value is a pointer to a box, an object whose header is
    ## followed by the table of the boxed type's methods and then the value itself; each
    ## method becomes a function over the pointer that calls through the table.
    mutating func interface_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    pub var header: heap.Object")
        try self.begin("    pub var table: L_")
        try self.put(name)
        try self.put("__table*")
        try self.end()
        try self.line("")
        try self.begin("struct L_")
        try self.put(name)
        try self.put("__table:")
        try self.end()
        var cursor = d.body
        var any = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.begin("    pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.shim_type(name, m)
                try self.end()
                any = true
            cursor = m.next
        if not any:
            try self.line("    pub var nothing: u8")
        try self.line("")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                let ft = self.checker.table.get(m.type_id)
                try self.begin("func L_")
                try self.put(name)
                try self.put("__L_")
                try self.put(m.text)
                try self.put("(L_self: L_")
                try self.put(name)
                try self.put("*")
                try self.shim_parameters(m, true)
                try self.put(")")
                try self.result_type(ft.elem)
                try self.put(":")
                try self.end()
                try self.begin("    ")
                try self.shim_return(ft.elem)
                try self.put("L_self.table.L_")
                try self.put(m.text)
                try self.put("(L_self")
                try self.shim_parameters(m, false)
                try self.put(")")
                try self.end()
                try self.line("")
            cursor = m.next

    ## Assemble typed conversions; the interface module owns adapter storage/tables.
    mutating func native_interface(d: ast.Node*) -> !:
        var methods = try list.List[native_interfaces.Method].create(8)
        var cursor = d.body
        var reverse = true
        while let method = cursor:
            if method.kind == ast.Kind.func_:
                reverse = reverse and self.checker.native_result_owned(method.left) and self.checker.native_parameters_borrowable(method)
            cursor = method.next
        let start = self.out.used
        try self.write_base_alias(d.module)
        try self.put(".")
        try self.put(d.text)
        let native = try self.take_output(start)
        cursor = d.body
        while let method = cursor:
            cursor = method.next
            if method.kind != ast.Kind.func_:
                continue
            let ft = self.checker.table.get(method.type_id)
            try self.shim_parameters(method, true)
            let luce_parameters = try self.take_output(start)
            var parameters = method.right
            var first = true
            while let parameter = parameters:
                if parameter.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("n_")
                    try self.put(parameter.text)
                    try self.put(": ")
                    try self.boundary().base_type((parameter.ty else return), d)
                parameters = parameter.next
            let native_parameters = try self.take_output(start)
            try self.result_type(ft.elem)
            let luce_result = try self.take_output(start)
            if let result = method.left:
                try self.put(" -> ")
                try self.boundary().base_type(result, d)
            let native_result = try self.take_output(start)
            let saved_indent = self.indent
            self.indent = 1
            try self.interface_from_native(method, d)
            let luce_body = try self.take_output(start)
            self.indent = 2
            if reverse:
                try self.interface_to_native(method, d)
            let native_body = try self.take_output(start)
            self.indent = saved_indent
            try methods.push(native_interfaces.Method(method.text, native_parameters, luce_parameters,
                                                      native_result, luce_result, native_body, luce_body, method.has(ast.flag_mutating)))
        try native_interfaces.declaration(&self.out, self.type_name(d), native, methods.span(), reverse)

    mutating func interface_from_native(method: ast.Node*, owner: ast.Node*) -> !:
        let ft = self.checker.table.get(method.type_id)
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let result = self.checker.table.get(ft.elem).elem if fallible else ft.elem
        let written = method.left
        let outcome = (written else return).has(ast.flag_native_outcome) if fallible else false
        try self.line("try reference.enter()" if fallible else "reference.enter() catch failure: trap(failure.message)")
        try self.line("defer reference.leave()")
        try self.line("var native = reference.value()" if method.has(ast.flag_mutating) else "let native = reference.value()")
        try self.begin("let outcome = " if outcome else ("let answer = " if result != types.unit_id else ""))
        try self.put("native.")
        try self.put(method.text)
        try self.put("(")
        var cursor = method.right
        var first = true
        while let parameter = cursor:
            if parameter.text != "self":
                if not first:
                    try self.put(", ")
                first = false
                let start = self.out.used
                try self.put("L_")
                try self.put(parameter.text)
                let name = try self.take_output(start)
                try self.boundary().to_base((parameter.ty else return), name, owner)
            cursor = parameter.next
        try self.put(")")
        if fallible and not outcome:
            try self.native_failure()
        else:
            try self.end()
        if outcome:
            try self.line("defer outcome.release()")
            try self.begin("let answer = " if result != types.unit_id else "")
            try self.put("outcome.get()")
            try self.native_failure()
        if result != types.unit_id:
            let result_node = written else return
            let inner = (result_node.left else return) if fallible else result_node
            try self.begin("return ")
            if outcome:
                try self.boundary().borrow_from_base(inner, "answer", owner)
            else:
                try self.boundary().from_base(inner, "answer", owner)
            try self.end()

    mutating func interface_to_native(method: ast.Node*, owner: ast.Node*) -> !:
        var cursor = method.right
        while let parameter = cursor:
            if parameter.text != "self":
                let start = self.out.used
                try self.put("n_")
                try self.put(parameter.text)
                let name = try self.take_output(start)
                try self.begin("let L_")
                try self.put(parameter.text)
                try self.put(" = ")
                try self.boundary().borrow_from_base((parameter.ty else return), name, owner)
                try self.end()
                if self.checker.table.has_references(parameter.type_id):
                    try self.begin("defer ")
                    try self.put(try self.lifetime_name("L_drop_", parameter.type_id))
                    try self.put("(L_")
                    try self.put(parameter.text)
                    try self.put(")")
                    try self.end()
            cursor = parameter.next
        let ft = self.checker.table.get(method.type_id)
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let result = self.checker.table.get(ft.elem).elem if fallible else ft.elem
        try self.begin("let answer = " if result != types.unit_id else "")
        try self.put("L_")
        try self.put(self.type_name(owner))
        try self.put("__L_")
        try self.put(method.text)
        try self.put("(self.source")
        try self.shim_parameters(method, false)
        try self.put(")")
        if fallible:
            try self.put(" catch failure:")
            try self.end()
            try self.begin("    return kernel.native_failure[")
            let written = method.left else return
            try self.boundary().base_type((written.left else return), owner)
            try self.put("](failure.code, failure.message)")
            try self.end()
        else:
            try self.end()
        if result != types.unit_id and self.checker.table.has_references(result):
            try self.begin("defer ")
            try self.put(try self.lifetime_name("L_drop_", result))
            try self.put("(answer)")
            try self.end()
        if fallible:
            let written = method.left else return
            let inner = written.left else return
            try self.begin("return interop.Outcome[")
            try self.boundary().base_type(inner, owner)
            try self.put("].success(")
            let owned = try native_types.plain_native_node(inner)
            owned.flags |= ast.flag_native_owned
            try self.boundary().to_base(owned, "()" if result == types.unit_id else "answer", owner)
            try self.put(".clone())")
            try self.end()
        elif result != types.unit_id:
            let written = method.left else return
            try self.begin("return ")
            try self.boundary().owned_to_base(written, "answer", owner)
            try self.end()

    ## What precedes a shim's call of the method: `return` for a value, `return try` for
    ## a fallible value, `try` for a fallible `unit`, nothing for `unit`.
    mutating func shim_return(result: u32) -> !:
        if self.checker.table.kind(result) == types.Kind.fallible:
            if self.checker.table.get(result).elem == types.unit_id:
                try self.put("try ")
            else:
                try self.put("return try ")
        elif result != types.unit_id:
            try self.put("return ")

    ## The type of a table entry: a function over the interface pointer and the method's
    ## other parameters, its result spelled even when `unit`.
    mutating func shim_type(name: str, m: ast.Node*) -> !:
        let ft = self.checker.table.get(m.type_id)
        try self.put("func(L_")
        try self.put(name)
        try self.put("*")
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if ft.elem == types.unit_id:
            try self.put(" -> unit")
        elif self.checker.table.kind(ft.elem) == types.Kind.fallible and self.checker.table.get(ft.elem).elem == types.unit_id:
            # a function type spells a fallible `unit` in full
            try self.put(" -> unit!")
        else:
            try self.result_type(ft.elem)

    ## `, L_p: T` for every parameter but `self`, typed or as arguments passed on.
    mutating func shim_parameters(m: ast.Node*, typed: bool) -> !:
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", L_")
                try self.put(p.text)
                if typed:
                    try self.put(": ")
                    try self.type_of(p.type_id)
            cursor = p.next

    ## `L_I__T__box`: the function making an interface value of a `T`, registered for
    ## `box_support` to write.
    mutating func box_name(iface: u32, concrete: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.box_interfaces.count:
            if self.box_interfaces.get(i) == iface and self.box_types.get(i) == concrete:
                seen = true
            i += 1
        if not seen:
            try self.box_interfaces.push(iface)
            try self.box_types.push(concrete)
        let half = self.checker.scratch.length // 2
        let it = self.checker.table.get(iface)
        let ct = self.checker.table.get(concrete)
        return try emission.copy_text(try format(self.checker.scratch[half..], f"L_{it.name}__{ct.name}__box"))

    ## A Base conformer keeps its actual native witness. This also supports
    ## interfaces whose borrowed result cannot be produced by a managed method.
    mutating func native_conformer_box(iface: ast.Node*, concrete: ast.Node*, name: str) -> !:
        let start = self.out.used
        try self.write_base_alias(iface.module)
        try self.put(".")
        try self.put(iface.text)
        let native_interface = try self.take_output(start)
        try self.type_of(concrete.type_id)
        let luce = try self.take_output(start)
        let iface_name = self.type_name(iface)
        let concrete_name = self.type_name(concrete)
        if concrete.native_object == none:
            try self.write_base_alias(concrete.module)
            try self.put(".")
            try self.put(concrete.text)
            let native_type = try self.take_output(start)
            try self.out.write(f"struct {name}__storage:\n    var header: heap.Object\n    var value: {luce}\n    var native: {native_type}\n")
            try self.out.write(f"func {name}__drop(o: heap.Object*):\n")
            if self.checker.table.has_references(concrete.type_id):
                try self.put("    ")
                try self.put(try self.lifetime_name("L_drop_", concrete.type_id))
                try self.out.write(f"((({name}__storage*)o).value)\n")
            else:
                try self.put("    discard(o)\n")
            try self.out.write(f"func {name}__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n")
            if self.checker.table.has_references(concrete.type_id):
                try self.put("    ")
                try self.put(try self.lifetime_name("L_trace_", concrete.type_id))
                try self.out.write(f"((({name}__storage*)o).value, visit, context)\n")
            else:
                try self.put("    discard(o)\n")
            try self.out.write(f"var {name}__info: heap.Info = heap.Info(name = \"{concrete_name} interface value\", size = sizeof({name}__storage), finish = none, drop = {name}__drop, trace = {name}__trace)\n")
        try self.out.write(f"func {name}__box(value: {luce}) -> L_{iface_name}*:\n")
        if let object = concrete.native_object:
            let access = "value_mut" if object.view and object.mutable else "value"
            try self.out.write(f"    let reference = L_{concrete_name}__value(value)\n    let carried = reference.as_interface[{native_interface}](reference.{access}())\n")
            try self.put("    ")
            try self.put(try self.lifetime_name("L_drop_", concrete.type_id))
            try self.put("(value)\n")
            try self.out.write(f"    return L_{iface_name}__frombase(carried)\n\n")
        else:
            try self.out.write(f"    let storage = ({name}__storage*)heap.allocate(&{name}__info)\n    storage.value = value\n    storage.native = ")
            let t = try native_types.native_node(concrete)
            try self.boundary().to_base(t, "storage.value", concrete)
            try self.out.write(f"\n    return L_{iface_name}__frombase(interop.Interface[{native_interface}](&storage.header, &storage.native))\n\n")

    ## The box of one interface and one conforming type: the object, a shim per method
    ## calling the type's own, the table of shims, the descriptor, and the constructor.
    mutating func box_support() -> !:
        while self.boxes_done < self.box_interfaces.count:
            let iface = self.box_interfaces.get(self.boxes_done)
            let concrete = self.box_types.get(self.boxes_done)
            self.boxes_done += 1
            let it = self.checker.table.get(iface)
            let ct = self.checker.table.get(concrete)
            let d = it.decl else return try self.fail(self.checker.tree(), "an interface without a declaration")
            let half = self.checker.scratch.length // 2
            let name = try emission.copy_text(try format(self.checker.scratch[half..], f"L_{it.name}__{ct.name}"))
            let concrete_decl = ct.decl else return try self.fail(d, "an interface payload has no declaration")
            if d.has(ast.flag_base) and concrete_decl.has(ast.flag_base) and (concrete_decl.native_object != none or concrete_decl.kind == ast.Kind.struct_):
                try self.native_conformer_box(d, concrete_decl, name)
                continue
            try self.begin("struct ")
            try self.put(name)
            try self.put(":")
            try self.end()
            try self.line("    pub var header: heap.Object")
            try self.begin("    pub var table: L_")
            try self.put(it.name)
            try self.put("__table*")
            try self.end()
            try self.begin("    pub var value: ")
            try self.type_of(concrete)
            try self.end()
            try self.line("")
            try self.box_shims(d, name, it, ct, concrete, half)
            try self.box_lifetime(name, concrete)
            try self.box_table(d, name, it, ct)
            try self.box_constructor(name, it, concrete)

    ## A box's shims: each interface method taking the box and calling the conforming type's own
    ## method on the value inside.
    mutating func box_shims(d: ast.Node*, name: str, it: types.Type, ct: types.Type, concrete: u32, half: usize) -> !:
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                let own = self.checker.find_member(ct.decl else return try self.fail(d, "no declaration"), m.text) else return try self.fail(d, "a conformance without the method")
                let ft = self.checker.table.get(own.type_id)
                try self.begin("func ")
                try self.put(name)
                try self.put("__L_")
                try self.put(m.text)
                try self.put("(L_self: L_")
                try self.put(it.name)
                try self.put("*")
                try self.shim_parameters(m, true)
                try self.put(")")
                try self.result_type(ft.elem)
                try self.put(":")
                try self.end()
                try self.begin("    ")
                try self.shim_return(ft.elem)
                let receiver = try emission.copy_text(try format(self.checker.scratch[half..], f"(({name}*)L_self).value"))
                try self.method_on(concrete, own, receiver)
                # a struct's method took the receiver before the parenthesis
                var pc = m.right
                var first_argument = ct.kind == types.Kind.struct_
                while let p = pc:
                    if p.text != "self":
                        if not first_argument:
                            try self.put(", ")
                        first_argument = false
                        try self.put("L_")
                        try self.put(p.text)
                    pc = p.next
                try self.put(")")
                try self.end()
                try self.line("")
            cursor = m.next

    ## A box's drop and trace over the value it owns.
    mutating func box_lifetime(name: str, concrete: u32) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        if self.checker.table.has_references(concrete):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", concrete))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).value)")
            try self.end()
        else:
            try self.line("    discard(o)")
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        if self.checker.table.has_references(concrete):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_trace_", concrete))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).value, visit, context)")
            try self.end()
        else:
            try self.line("    discard(o)")

    ## A box's interface table naming its shims, its identity when the value is an object, and
    ## its descriptor.
    mutating func box_table(d: ast.Node*, name: str, it: types.Type, ct: types.Type) -> !:
        try self.begin("var ")
        try self.put(name)
        try self.put("__table: L_")
        try self.put(it.name)
        try self.put("__table = L_")
        try self.put(it.name)
        try self.put("__table(")
        var cursor = d.body
        var first = true
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(m.text)
                try self.put(" = ")
                try self.put(name)
                try self.put("__L_")
                try self.put(m.text)
            cursor = m.next
        if first:
            try self.put("nothing = 0")
        try self.put(")")
        try self.end()
        if ct.kind == types.Kind.class_ or ct.kind == types.Kind.interface_:
            try self.out.write(f"func {name}__identity(o: heap.Object*) -> u64:\n    return heap.identity((heap.Object*)(({name}*)o).value)\n")
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(it.name)
        try self.put("\", size = sizeof(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace")
        if ct.kind == types.Kind.class_ or ct.kind == types.Kind.interface_:
            try self.out.write(f", identity = {name}__identity")
        try self.put(")")
        try self.end()

    ## A box's constructor: the object allocated with its interface table and the value it owns.
    mutating func box_constructor(name: str, it: types.Type, concrete: u32) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__box(v: ")
        try self.type_of(concrete)
        try self.put(") -> L_")
        try self.put(it.name)
        try self.put("*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.begin("    o.table = &")
        try self.put(name)
        try self.put("__table")
        try self.end()
        try self.line("    o.value = v")
        try self.begin("    return (L_")
        try self.put(it.name)
        try self.put("*)o")
        try self.end()
        try self.line("")
