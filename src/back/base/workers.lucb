#==============================================================================================
#
#   base/workers - Workers
#
#   DESCRIPTION:
#       Worker entry points and the messages that cross to them (§14).
#
#==============================================================================================
extend Emitter:
    # mark: Workers ============================================================================

    ## The type a task's result is kept as (`emission.payload_of_task`).
    func task_payload(task_type: u32) -> u32:
        return emission.payload_of_task(&self.checker.table, task_type)

    func spawn_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.spawns.count
        while i < self.spawns.count:
            if self.spawns.get(i) == e:
                at = i
            i += 1
        if at == self.spawns.count:
            try self.spawns.push(e)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_task_{at}__spawn"))

    func wait_name(task_type: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.waits.count:
            if self.waits.get(i) == task_type:
                seen = true
            i += 1
        if not seen:
            try self.waits.push(task_type)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_wait_{task_type}"))

    ## `L_send_N(v)` for a type whose values are copied to share nothing, or `v` itself for
    ## a scalar, which is its own copy.
    func send_of(t: u32, v: str) -> !:
        let k = self.checker.table.kind(t)
        if k == types.Kind.int_ or k == types.Kind.float_ or k == types.Kind.bool_ or k == types.Kind.unit_ or k == types.Kind.error_code or k == types.Kind.range_:
            try self.put(v)
            return
        var i: usize = 0
        var seen = false
        while i < self.sends.count:
            if self.sends.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.sends.push(t)
        try self.put("L_send_")
        try self.put_u64((u64)t)
        try self.put("(")
        try self.put(v)
        try self.put(")")

    func worker_support() -> !:
        while self.spawns_done < self.spawns.count:
            let e = self.spawns.get(self.spawns_done)
            let index = self.spawns_done
            self.spawns_done += 1
            try self.task_object(e, index)
        while self.waits_done < self.waits.count:
            let t = self.waits.get(self.waits_done)
            self.waits_done += 1
            try self.wait_function(t)
        while self.sends_done < self.sends.count:
            let t = self.sends.get(self.sends_done)
            self.sends_done += 1
            try self.send_function(t)

    ## One spawn's task: the object holding the spawner's arguments, then the worker's own
    ## copies and the result; `run` on the worker, `cleanup` on the worker once the result
    ## was taken, `spawn` on the spawner (RUNTIME).
    func task_object(e: ast.Node*, index: usize) -> !:
        let call = e.left else return
        let d = call.resolved else return try self.fail(e, "an unresolved spawn")
        let ft = self.checker.table.get(d.type_id)
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let payload = self.task_payload(e.type_id)
        let has_result = payload != types.bool_id or (ft.elem != types.unit_id and not (fallible and self.checker.table.get(ft.elem).elem == types.unit_id))
        let half = self.checker.scratch.length // 2
        let name = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_task_{index}"))
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.begin("    var base: kernel.TaskOf[")
        try self.type_of(payload)
        try self.put("]")
        try self.end()
        var cursor = d.right
        while let p = cursor:
            try self.begin("    var L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            try self.end()
            try self.begin("    var W_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            try self.end()
            cursor = p.next
        try self.line("")
        try self.task_run(d, name, half, has_result, fallible)
        try self.task_cleanup(d, name, payload, has_result)
        try self.task_lifetime(name)
        try self.task_spawn(d, name, payload)

    ## A task's `run`, on the worker: the arguments sent into its own copies, then the function
    ## called on them, its result kept or its failure recorded.
    func task_run(d: ast.Node*, name: str, half: usize, has_result: bool, fallible: bool) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__run(t: kernel.Task*):")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)t")
        try self.end()
        var cursor = d.right
        while let p = cursor:
            try self.begin("    o.W_")
            try self.put(p.text)
            try self.put(" = ")
            let source = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"o.L_{p.text}"))
            try self.send_of(p.type_id, source)
            try self.end()
            cursor = p.next
        try self.line("    kernel.task_copied(t)")
        try self.begin("    ")
        if has_result:
            try self.put("o.base.result = ")
        try self.put("L_")
        try self.put(try self.decl_name(d))
        try self.put("(")
        var first = true
        cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("o.W_")
            try self.put(p.text)
            cursor = p.next
        try self.put(")")
        if fallible:
            try self.put(" catch failure:")
            try self.end()
            try self.line("        kernel.task_failed(t, failure.code, failure.message)")
            try self.line("        return")
        else:
            try self.end()
        try self.line("")

    ## A task's `cleanup`, on the worker after the waiter took the result: its copies of the
    ## arguments dropped, and the result too unless the task failed.
    func task_cleanup(d: ast.Node*, name: str, payload: u32, has_result: bool) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__cleanup(t: kernel.Task*):")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)t")
        try self.end()
        var any = false
        var cursor = d.right
        while let p = cursor:
            if self.checker.table.has_references(p.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", p.type_id))
                try self.put("(o.W_")
                try self.put(p.text)
                try self.put(")")
                try self.end()
                any = true
            cursor = p.next
        if has_result and self.checker.table.has_references(payload):
            try self.line("    if not t.failed:")
            try self.begin("        ")
            try self.put(try self.lifetime_name("L_drop_", payload))
            try self.put("(o.base.result)")
            try self.end()
            any = true
        if not any:
            try self.line("    _ = o")
        try self.line("")

    ## A task's drop and trace: the spawner lets the task go; its trace visits nothing.
    func task_lifetime(name: str) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(obj: heap.Object*):")
        try self.end()
        try self.line("    kernel.task_abandon((kernel.Task*)obj)")
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(obj: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.line("    _ = obj")
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"task\", size = memory.size_of(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")

    ## A task's `spawn`, on the spawner: the object allocated with the arguments, the task started
    ## with its run and cleanup, the spawner's references to the arguments let go.
    func task_spawn(d: ast.Node*, name: str, payload: u32) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__spawn(")
        var first = true
        var cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(") -> kernel.TaskOf[")
        try self.type_of(payload)
        try self.put("]*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        cursor = d.right
        while let p = cursor:
            try self.begin("    o.L_")
            try self.put(p.text)
            try self.put(" = L_")
            try self.put(p.text)
            try self.end()
            cursor = p.next
        try self.begin("    kernel.task_start(&o.base.task, ")
        try self.put(name)
        try self.put("__run, ")
        try self.put(name)
        try self.put("__cleanup)")
        try self.end()
        cursor = d.right
        while let p = cursor:
            if self.checker.table.has_references(p.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", p.type_id))
                try self.put("(o.L_")
                try self.put(p.text)
                try self.put(")")
                try self.end()
            cursor = p.next
        try self.line("    return &o.base")
        try self.line("")

    ## `wait` for one task type: the result copied onto the waiter's heap, or the failure.
    func wait_function(task_type: u32) -> !:
        let elem = self.checker.table.get(task_type).elem
        let fallible = self.checker.table.kind(elem) == types.Kind.fallible
        let payload = self.task_payload(task_type)
        var success = elem
        if fallible:
            success = self.checker.table.get(elem).elem
        try self.begin("func L_wait_")
        try self.put_u64((u64)task_type)
        try self.put("(t: ")
        try self.type_of(task_type)
        try self.put(")")
        try self.result_type(elem)
        try self.put(":")
        try self.end()
        try self.line("    kernel.task_join(&t.task)")
        if fallible:
            try self.line("    if t.task.failed:")
            # the raised error copies the message before the task lets it go
            try self.line("        defer kernel.task_finish(&t.task)")
            try self.line("        error(t.task.code, t.task.message.data)")
        if success != types.unit_id:
            try self.begin("    let answer = ")
            try self.send_of(payload, "t.result")
            try self.end()
        try self.line("    kernel.task_finish(&t.task)")
        if success != types.unit_id:
            try self.line("    return answer")
        try self.line("")

    ## A copy of a value that shares nothing with the original (§14): a text and bytes
    ## anew, a collection with its elements sent, a struct, enum, tuple or optional
    ## member by member.
    func send_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func L_send_")
        try self.put_u64((u64)id)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> ")
        try self.type_of(id)
        try self.put(":")
        try self.end()
        self.indent += 1
        let half = self.checker.scratch.length // 2
        match t.kind:
            .error_value: try self.line("return kernel.send_failure(v)")
            .str_: try self.line("return kernel.text_of(kernel.text_view(v))")
            .bytes_: try self.line("return kernel.bytes_of(kernel.bytes_view(v))")
            .list_: try self.send_list(id, t)
            .set_: try self.send_set(id, t)
            .map_: try self.send_map(id, t)
            .optional:
                try self.line("if let x = v:")
                try self.begin("    return ")
                try self.send_of(t.elem, "x")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    let member = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"v.{i}"))
                    try self.send_of(t.args[i], member)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_: try self.send_struct(t, half)
            .enum_: try self.send_enum(t, half)
            _: return try self.fail(self.checker.tree(), "a value that is not sendable reached a worker")
        self.indent -= 1
        try self.line("")

    ## A list sent element by element into a new list of the same type.
    func send_list(id: u32, t: types.Type) -> !:
        try self.begin("let out = kernel.list_new[")
        try self.type_of(t.elem)
        try self.put("](&")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(", ")
        try self.put(try self.ops_name(t.elem))
        try self.put(")")
        try self.end()
        try self.line("var i: usize = 0")
        try self.line("while i < v.count:")
        try self.begin("    kernel.list_append[")
        try self.type_of(t.elem)
        try self.put("](out, ")
        try self.send_of(t.elem, "v.items[i]")
        try self.put(")")
        try self.end()
        try self.line("    i += 1")
        try self.line("return out")

    ## A set sent key by key into a new set of the same type.
    func send_set(id: u32, t: types.Type) -> !:
        try self.begin("let out = kernel.set_new[")
        try self.type_of(t.elem)
        try self.put("](&")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(", ")
        try self.put(try self.ops_name(t.elem))
        try self.put(")")
        try self.end()
        try self.line("var i: usize = 0")
        try self.line("while i < v.count:")
        try self.begin("    kernel.set_insert[")
        try self.type_of(t.elem)
        try self.put("](out, ")
        try self.send_of(t.elem, "v.keys[i]")
        try self.put(")")
        try self.end()
        try self.line("    i += 1")
        try self.line("return out")

    ## A map sent entry by entry, keys and values each sent, into a new map of the same type.
    func send_map(id: u32, t: types.Type) -> !:
        let value_type = self.checker.table.map_value(id)
        try self.begin("let out = kernel.map_new[")
        try self.type_of(t.elem)
        try self.put(", ")
        try self.type_of(value_type)
        try self.put("](&")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(", ")
        try self.put(try self.ops_name(t.elem))
        try self.put(", ")
        try self.put(try self.ops_name(value_type))
        try self.put(")")
        try self.end()
        try self.line("var i: usize = 0")
        try self.line("while i < v.count:")
        try self.begin("    kernel.map_set[")
        try self.type_of(t.elem)
        try self.put(", ")
        try self.type_of(value_type)
        try self.put("](out, ")
        try self.send_of(t.elem, "v.keys[i]")
        try self.put(", ")
        try self.send_of(value_type, "v.values[i]")
        try self.put(")")
        try self.end()
        try self.line("    i += 1")
        try self.line("return out")

    ## A struct sent field by field, a native value's handle carried over as it is.
    func send_struct(t: types.Type, half: usize) -> !:
        let d = t.decl else return try self.fail(self.checker.tree(), "a struct without a declaration")
        try self.begin("return L_")
        try self.put(t.name)
        try self.put("(")
        var first = true
        if d.has(ast.flag_native_value):
            try self.put("native = v.native")
            first = false
        var cursor = d.body
        while let f = cursor:
            if f.kind == ast.Kind.field:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(f.text)
                try self.put(" = ")
                let member = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"v.L_{f.text}"))
                try self.send_of(f.type_id, member)
            cursor = f.next
        try self.put(")")
        try self.end()

    ## An enum sent case by case: each case rebuilt with its fields sent.
    func send_enum(t: types.Type, half: usize) -> !:
        let d = t.decl else return try self.fail(self.checker.tree(), "an enum without a declaration")
        try self.line("match v:")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin("    .L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        p = field.next
                    try self.put(")")
                try self.put(": return L_")
                try self.put(t.name)
                try self.put(".L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        let member = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_{field.text}"))
                        try self.send_of(field.type_id, member)
                        p = field.next
                    try self.put(")")
                try self.end()
            cursor = m.next
