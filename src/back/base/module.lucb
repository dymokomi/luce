#==============================================================================================
#
#   base - The typed tree written out as Base
#
#   DESCRIPTION:
#       Base is the machine form. The translation is close to an isomorphism: a Luce local is
#       a Base local, a struct a struct, an enum an enum, `if`, `while`, `match`, `break` and
#       `continue` are themselves, and checked `int` arithmetic is Base's own, so a trap is
#       the operator. What Base does not spell, Python's `//`, `%` and `**`, text made of
#       pieces, the display of a value, Luce's indexes and slices, is a call into `rt.kernel`.
#       Every name a program wrote is prefixed `L_`, since Base reserves words Luce does not.
#       Objects follow docs/RUNTIME.md: `expr` writes a borrowed value for a read of a
#       binding and an owned one for everything else, `owned` and `use` say which a place
#       needs, a binding drops what it owned when its block ends, and a statement whose
#       expression pooled a temporary is wrapped in a mark and a drain. Nothing here
#       decides a language question: the checker already did.
#
#
#       This fragment holds the `Emitter` and its fields; each concern's methods are in
#       a fragment of their own under `extend Emitter:`, as `ORDER` lists them.
#==============================================================================================

import back.crossings
import back.emission
import back.function_effects
import back.native_types
import back.native_objects
import back.native_interfaces
import front.ast
import sema.check
import sema.bodies
import sema.standard
import sema.types
import support.buffer
import support.list
import support.literals

# mark: The emitter ===========================================================================

## Writes a checked program as one Base module: each declaration as it comes, and
## after the program every support function and table the declarations asked for.
pub struct Emitter:
    ## Chosen after collecting Base sources, to avoid a user module namespace.
    pub var runtime_namespace: str
    var checker: check.Checker*
    var out: buffer.Buffer
    var indent: u32
    var temps: u32
    ## Types whose display function is needed, emitted after the program.
    var shown: list.List[u32]
    ## Types holding references, whose copy, drop, trace and pool functions are emitted
    ## after the program.
    var lifetimes: list.List[u32]
    ## Types whose `==` and ordering need a function of their own (collections, and what
    ## holds them), emitted after the program.
    var equalities: list.List[u32]
    var orderings: list.List[u32]
    ## Types hashed (§4.4) and types that are a collection's elements, each with a
    ## function or an operations table of its own after the program.
    var hashes: list.List[u32]
    var ops_types: list.List[u32]
    ## Text and bytes literals, each an immortal object declared after the program; the
    ## text, and whether it is bytes.
    var texts: list.List[str]
    var texts_are_bytes: list.List[bool]
    var texts_done: usize
    ## Closures (§7.4): lambdas whose object, body and constructor are written after the
    ## program; named functions used as values, each an immortal closure and a thunk;
    ## methods bound as values; function types called through a value; element types
    ## whose captured `var`s need a cell descriptor.
    var lambdas: list.List[ast.Node*]
    var lambdas_done: usize
    var thunks: list.List[ast.Node*]
    var thunks_done: usize
    var bounds: list.List[ast.Node*]
    var bounds_done: usize
    var calls: list.List[u32]
    var calls_done: usize
    var widened: list.List[u32]
    var widened_done: usize
    var cells: list.List[u32]
    var cells_done: usize
    ## Interface values (§13.2): each pair of an interface and a conforming type used as
    ## one gets a box, its table and the shims after the program.
    var box_interfaces: list.List[u32]
    var box_types: list.List[u32]
    var boxes_done: usize
    ## The Base boundary (§16): types converted at a crossing, each with a pair of
    ## functions after the program; named functions handed to Base as callbacks, each
    ## with a thunk over Base's types.
    var crossing_work: crossings.Work
    var callbacks: list.List[ast.Node*]
    var callbacks_done: usize
    ## Used argument shapes leave native defaults to Base, without copying expressions.
    var native_calls: list.List[ast.Node*]
    var native_calls_done: usize
    ## Workers (§14): each `spawn` gets a task object, a run and a cleanup after the
    ## program; each result type a `wait`; each sent type a copy that shares nothing.
    var spawns: list.List[ast.Node*]
    var spawns_done: usize
    var waits: list.List[u32]
    var waits_done: usize
    var sends: list.List[u32]
    var sends_done: usize
    ## The lambda whose body is being written, so its captures read from its object.
    var lambda: ast.Node*?
    ## How many of each list are written out, since writing one set of functions can
    ## register more; `support_functions` runs until nothing new appears.
    var shown_done: usize
    var lifetimes_done: usize
    var equalities_done: usize
    var orderings_done: usize
    var hashes_done: usize
    var ops_done: usize
    ## Operands hoisted before the statement (RUNTIME 5): `let` lines, written ahead of the
    ## statement when it is wrapped.
    var prelude: buffer.Buffer
    ## Nested catch/block statements drain only operands produced in their scope.
    var prelude_floor: usize
    var hoisted_floor: usize
    ## The operands hoisted for the statement being written, and their names: a node
    ## written again in the statement is written by its name, so a call runs once.
    var hoisted_nodes: list.List[ast.Node*]
    var hoisted_names: list.List[str]
    ## `luce test --build`: the tests are written as functions and `main` runs them (§17.3).
    pub var tests_mode: bool
    var test_names: list.List[str]
    ## Whether the statement being written pooled a temporary, so it needs a drain.
    var pooled: bool
    ## The statements being written, outermost first (RUNTIME 5): each one's node, and the
    ## name its mark takes once a `break`, `continue` or `return` inside it drains it.
    var frame_nodes: list.List[ast.Node*]
    var frame_marks: list.List[str]
    ## Whether the function being written can fail, so that a drain on the failing path
    ## (`errdefer`) is possible and needed.
    var fallible: bool
    ## A protected operand stores an owned error and leaves its evaluation scope.
    var failure_label: str = ""
    var failure_name: str = ""
    ## A source recovery assigns its handler's value and leaves that region.
    var recover_label: str = ""
    var recover_name: str = ""
    ## Inside a match statement, where a bound payload is copied at the arm's start and
    ## the pattern writes its raw name; a match expression borrows the payload as is.
    var raw_payloads: bool
    ## Inside an enum's or a class's method, where `self` is an ordinary parameter.
    var self_name: str
    ## Inside a folded top-level constant, whose values are all immortal: nothing is copied.
    var in_constant: bool = false

    ## An emitter for the program `checker` holds, with nothing written yet.
    pub static func over(checker: check.Checker*) -> Emitter!:
        return Emitter(runtime_namespace = "rt", checker = checker, out = try buffer.Buffer.create(65536), indent = 0, temps = 0,
                       shown = try list.List[u32].create(16), lifetimes = try list.List[u32].create(16),
                       equalities = try list.List[u32].create(16), orderings = try list.List[u32].create(16),
                       hashes = try list.List[u32].create(16), ops_types = try list.List[u32].create(16),
                       texts = try list.List[str].create(64), texts_are_bytes = try list.List[bool].create(64), texts_done = 0,
                       lambdas = try list.List[ast.Node*].create(16), lambdas_done = 0, thunks = try list.List[ast.Node*].create(16), thunks_done = 0,
                       bounds = try list.List[ast.Node*].create(16), bounds_done = 0, calls = try list.List[u32].create(16), calls_done = 0,
                       widened = try list.List[u32].create(8), widened_done = 0,
                       cells = try list.List[u32].create(16), cells_done = 0, lambda = none,
                       box_interfaces = try list.List[u32].create(16), box_types = try list.List[u32].create(16), boxes_done = 0,
                       crossing_work = try crossings.Work.create(),
                       spawns = try list.List[ast.Node*].create(8), spawns_done = 0, waits = try list.List[u32].create(8), waits_done = 0, sends = try list.List[u32].create(16), sends_done = 0, callbacks = try list.List[ast.Node*].create(8), callbacks_done = 0, native_calls = try list.List[ast.Node*].create(16), native_calls_done = 0,
                       shown_done = 0, lifetimes_done = 0, equalities_done = 0, orderings_done = 0, hashes_done = 0, ops_done = 0,
                       pooled = false, fallible = false, raw_payloads = false, self_name = "self",
                       tests_mode = false, test_names = try list.List[str].create(8), prelude = try buffer.Buffer.create(1024), prelude_floor = 0, hoisted_floor = 0,
                       hoisted_nodes = try list.List[ast.Node*].create(8), hoisted_names = try list.List[str].create(8),
                       frame_nodes = try list.List[ast.Node*].create(16), frame_marks = try list.List[str].create(16))

    ## Everything written so far.
    pub func text() -> str:
        return self.out.view()

    func writer() -> emission.Writer:
        return emission.Writer(self.checker, &self.out, &self.indent, &self.lifetimes, &self.ops_types)

    func boundary() -> crossings.Emitter:
        return crossings.Emitter(self.writer(), &self.crossing_work)
