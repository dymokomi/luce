#==============================================================================================
#
#   base/expressions - Expressions
#
#   DESCRIPTION:
#       `expr` and the expressions with no family of their own: literals, names, members,
#       and formatted text.
#
#==============================================================================================
extend Emitter:
    # mark: Expressions ========================================================================

    ## Writes the value: borrowed for a read of a binding, owned for everything else.
    pub func expr(e: ast.Node*) -> !:
        if let name = self.hoisted_name(e):
            try self.put(name)
            return
        match e.kind:
            .literal: try self.literal(e)
            .name: try self.name_value(e)
            .self_: try self.put(self.self_name)
            .group:
                let inner = e.left else return
                try self.put("(")
                try self.expr(inner)
                try self.put(")")
            .spawn_:
                # a task object of this spawn's own shape, given the arguments (§14)
                let call = e.left else return
                let function = call.resolved else return
                try self.sequence_arguments(call.body)
                try self.put(try self.spawn_name(e))
                try self.arguments(call, function.right, false, true)
            .wait_:
                let inner = e.left else return
                try self.put(try self.wait_name(inner.type_id))
                try self.put("(")
                try self.use(inner)
                try self.put(")")
            .widen_function:
                let inner = e.left else return
                try remember(&self.widened, inner.type_id)
                try self.put("kernel.widen_function(")
                try self.owned(inner)
                try self.out.write(f", (void*)L_widen_{inner.type_id})")
            .convert:
                # a conforming value boxed as an interface value (§13.2); the box owns a copy
                let inner = e.left else return
                var target = e.type_id
                if self.checker.table.kind(target) == types.Kind.optional:
                    target = self.checker.table.get(target).elem
                try self.put(try self.box_name(target, inner.type_id))
                try self.put("(")
                try self.owned(inner)
                try self.put(")")
            .propagate: try self.propagate(e)
            .unary:
                let inner = e.left else return
                if e.text == "not":
                    try self.put("not ")
                    try self.expr(inner)
                elif e.text == "~":
                    try self.put("(~")
                    try self.expr(inner)
                    try self.put(")")
                else:
                    try self.put("(-")
                    try self.expr(inner)
                    try self.put(")")
            .binary: try self.binary(e)
            .conditional: try self.lazy_expression(e)
            .tuple:
                try self.put("(")
                try self.owned_items(e.body)
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .unit_: try self.put("()")
            .lambda: try self.lambda_value(e)
            .list_lit: try self.list_literal(e)
            .set_lit, .map_lit: try self.set_or_map_literal(e)
            .call: try self.call(e)
            .member: try self.member(e)
            .index: try self.index_value(e)
            .slice: try self.slice_value(e)
            .else_: try self.lazy_expression(e)
            .catch_: try self.handled_expression(e)
            .case_value: try self.case_value(e, e.body)
            .formatted: try self.formatted(e)
            .match_expr: try self.match_expr(e)
            _: return try self.fail(e, "an expression this slice does not compile")

    ## A read of a name: a function as its immortal closure, a constant by its read, a binding
    ## (through its cell when captured as a `var`) by itself.
    func name_value(e: ast.Node*) -> !:
        let d = e.resolved else return try self.fail(e, "an unresolved name")
        if d.kind == ast.Kind.func_:
            # a named function as a value: its immortal closure
            try self.put("&")
            try self.put(try self.thunk_name(d, "L_fn_"))
            return
        if d.kind == ast.Kind.constant:
            if d.has(ast.flag_base):
                try self.base_constant(d)
                return
            try self.put("L_")
            try self.put(try self.decl_name(d))
            try self.constant_read(d)
            return
        try self.captured_name(d, e.text)
        if d.has(ast.flag_captured):
            try self.put(".value")

    ## A lambda as its closure object: a copy of every captured `let` and the retained cell of
    ## every captured `var`.
    func lambda_value(e: ast.Node*) -> !:
        try self.put(try self.lambda_name(e))
        try self.put("__new(")
        var cursor = e.left
        var first = true
        while let capture = cursor:
            let d = capture.resolved else return try self.fail(e, "an unresolved capture")
            if not first:
                try self.put(", ")
            first = false
            if capture.has(ast.flag_var_field):
                try self.put("(kernel.Cell[")
                try self.type_of(capture.type_id)
                try self.put("]*)heap.retain((heap.Object*)")
                try self.captured_name(d, capture.text)
                try self.put(")")
            elif self.checker.table.has_references(capture.type_id):
                try self.put(try self.lifetime_name("L_copy_", capture.type_id))
                try self.put("(")
                try self.captured_source(d, capture.text)
                try self.put(")")
            else:
                try self.captured_source(d, capture.text)
            cursor = capture.next
        try self.put(")")

    ## A list literal (or an empty one) built by the kernel with the type's info and ops.
    func list_literal(e: ast.Node*) -> !:
        let t = self.checker.table.get(e.type_id)
        if e.body == none:
            try self.put("kernel.list_new[")
            try self.type_of(t.elem)
            try self.put("](&")
        else:
            try self.put("kernel.list_of[")
            try self.type_of(t.elem)
            try self.put("](&")
        try self.put(try self.lifetime_name("L_info_", e.type_id))
        try self.put(", ")
        try self.put(try self.ops_name(t.elem))
        if e.body != none:
            try self.put(", [")
            try self.owned_items(e.body)
            try self.put("]")
        try self.put(")")

    ## A set or map literal (or an empty one) built by the kernel with the type's info and ops.
    func set_or_map_literal(e: ast.Node*) -> !:
        let t = self.checker.table.get(e.type_id)
        if t.kind == types.Kind.set_:
            try self.put("kernel.set_of[" if e.body != none else "kernel.set_new[")
            try self.type_of(t.elem)
            try self.put("](&")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(t.elem))
            if e.body != none:
                try self.put(", [")
                try self.owned_items(e.body)
                try self.put("]")
            try self.put(")")
        else:
            let value_type = self.checker.table.map_value(e.type_id)
            try self.put("kernel.map_of[" if e.body != none else "kernel.map_new[")
            try self.type_of(t.elem)
            try self.put(", ")
            try self.type_of(value_type)
            try self.put("](&")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(t.elem))
            try self.put(", ")
            try self.put(try self.ops_name(value_type))
            if e.body != none:
                # keys then values in Base; hoisted in source order when one may fail
                # or call anything, so the entries are evaluated as written
                var risky = false
                var cursor = e.body
                while let entry = cursor:
                    if self.may_fail(entry.left) or self.may_fail(entry.right) or self.has_call(entry.left) or self.has_call(entry.right):
                        risky = true
                    cursor = entry.next
                if risky:
                    cursor = e.body
                    while let entry = cursor:
                        let k = entry.left else return
                        let v = entry.right else return
                        entry.text = try self.hoist(k, true)
                        entry.doc = try self.hoist(v, true)
                        cursor = entry.next
                try self.put(", [")
                cursor = e.body
                var first = true
                while let entry = cursor:
                    let k = entry.left else return
                    if not first:
                        try self.put(", ")
                    first = false
                    if risky:
                        try self.put(entry.text)
                    else:
                        try self.owned(k)
                    cursor = entry.next
                try self.put("], [")
                cursor = e.body
                first = true
                while let entry = cursor:
                    let v = entry.right else return
                    if not first:
                        try self.put(", ")
                    first = false
                    if risky:
                        try self.put(entry.doc)
                    else:
                        try self.owned(v)
                    cursor = entry.next
                try self.put("]")
            try self.put(")")

    ## `receiver[index]` on bytes, a list, or a map, by the kernel's checked read.
    func index_value(e: ast.Node*) -> !:
        let receiver = e.left else return
        let index = e.body else return
        if self.has_call(receiver) or self.has_call(index) or self.may_fail(receiver) or self.may_fail(index):
            try self.hold_operand(receiver)
            try self.hold_operand(index)
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.bytes_:
            try self.put("kernel.byte_at(")
            try self.use(receiver)
            try self.put(", ")
            try self.use(index)
            try self.put(")")
        elif rt.kind == types.Kind.list_:
            try self.put("kernel.list_get[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(receiver)
            try self.put(", ")
            try self.use(index)
            try self.put(")")
        elif rt.kind == types.Kind.map_:
            try self.put("kernel.map_get[")
            try self.map_types(receiver.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(", ")
            try self.use(index)
            try self.put(")")
        else:
            return try self.fail(e, "indexing this compiles in the collections slice")

    ## `receiver[low..high]`: a `str`, `bytes`, or list slice by the kernel, the bounds held first
    ## when evaluating them could call or fail.
    func slice_value(e: ast.Node*) -> !:
        let receiver = e.left else return
        if self.has_call(receiver) or self.has_call(e.body) or self.has_call(e.right) or self.may_fail(e):
            try self.hold_operand(receiver)
            if let low = e.body:
                try self.hold_operand(low)
            if let high = e.right:
                try self.hold_operand(high)
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.str_:
            try self.put("kernel.slice_text(")
        elif rt.kind == types.Kind.bytes_:
            try self.put("kernel.slice_bytes(")
        else:
            try self.put("kernel.list_slice[")
            try self.type_of(rt.elem)
            try self.put("](")
        try self.use(receiver)
        try self.put(", ")
        if let low = e.body:
            try self.expr(low)
        else:
            try self.put("0")
        try self.put(", ")
        if let high = e.right:
            try self.expr(high)
        else:
            try self.put("0")
        try self.put(", ")
        try self.put("true" if e.has(ast.flag_no_high) else "false")
        try self.put(")")

    func literal(e: ast.Node*) -> !:
        let b = e.text.bytes
        if e.text == "true" or e.text == "false" or e.text == "none":
            try self.put(e.text)
            return
        if b[0] == '"' or (b[0] == 'r' and b.length > 1 and b[1] == '"'):
            try self.put(try self.text_ref(try literals.decode_text(e.text), false))
            return
        if b[0] == 'b' and b.length > 1 and b[1] == '"':
            try self.put(try self.text_ref((str)(try literals.decode_text(e.text)).bytes, true))
            return
        if literals.is_float_text(e.text):
            try self.put(e.text)
            return
        let magnitude = try literals.decode_integer(e.text)
        if magnitude == 9223372036854775808:
            try self.put("9223372036854775808")
            return
        try self.put_u64(magnitude)

    ## A Base text literal for `text`: every byte C or Base could misread is escaped.
    func text_literal(text: str, as_bytes: bool) -> !:
        if as_bytes:
            try self.put("b")
        try self.put("\"")
        for c in text.bytes:
            if c == '\\':
                try self.put("\\\\")
            elif c == '"':
                try self.put("\\\"")
            elif c == '\n':
                try self.put("\\n")
            elif c == '\r':
                try self.put("\\r")
            elif c == '\t':
                try self.put("\\t")
            elif c == 0:
                try self.put("\\0")
            elif as_bytes and (c < 32 or c >= 127):
                try self.put("\\x")
                try self.out.put_byte(hex_digit(c >> 4))
                try self.out.put_byte(hex_digit(c & 15))
            elif c < 32:
                # A text literal cannot spell a control byte as \xNN — that form is bytes only.
                # The scalar equals the byte here (c < 128), so \u{NN} round-trips exactly.
                try self.put("\\u{")
                try self.out.put_byte(hex_digit(c >> 4))
                try self.out.put_byte(hex_digit(c & 15))
                try self.put("}")
            else:
                try self.out.put_byte(c)
        try self.put("\"")

    func member(e: ast.Node*) -> !:
        let receiver = e.left else return
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.module:
            try self.module_member(e)
            return
        if rt.kind == types.Kind.type_name:
            try self.type_member(e, rt)
            return
        if rt.kind == types.Kind.tuple:
            let copies = self.checker.table.has_references(e.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", e.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if e.text == "byte_count" and rt.kind == types.Kind.str_:
            try self.put("(i64)(")
            try self.use(receiver)
            try self.put(").data.length")
            return
        if rt.kind == types.Kind.range_ and e.has(ast.flag_builtin):
            try self.put("kernel.range_length(" if e.text == "length" else "kernel.range_is_empty(")
            try self.use(receiver)
            try self.put(")")
            return
        if e.text == "is_empty" and e.has(ast.flag_builtin):
            # a length of none, read once
            try self.put("(")
            if rt.kind == types.Kind.str_:
                try self.put("(")
                try self.use(receiver)
                try self.put(").data.length == 0")
            elif rt.kind == types.Kind.list_:
                try self.length_of(receiver, rt)
                try self.put(" == 0")
            else:
                try self.put("kernel.map_length[")
                try self.map_types(receiver.type_id)
                try self.put("](")
                try self.use(receiver)
                try self.put(") == 0")
            try self.put(")")
            return
        if e.text == "length" and (rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_):
            try self.put("kernel.map_length[")
            try self.map_types(receiver.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if e.text == "length" and (rt.kind == types.Kind.str_ or rt.kind == types.Kind.bytes_ or rt.kind == types.Kind.list_):
            try self.length_of(receiver, rt)
            return
        if rt.kind == types.Kind.list_ and e.has(ast.flag_builtin):
            try self.put("kernel.list_first[" if e.text == "first" else "kernel.list_last[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if rt.kind == types.Kind.error_value:
            if e.text == "message":
                # a text of its own, copied out of the `Error`'s view
                try self.put("kernel.text_of(")
                try self.use(receiver)
                try self.put(".message.data)")
                return
            try self.use(receiver)
            try self.put(".")
            try self.put(e.text)
            return
        let m = e.resolved else return try self.fail(e, "an unresolved member")
        if m.kind == ast.Kind.field:
            try self.field_read(e, receiver, rt, m)
            return
        if m.kind == ast.Kind.func_:
            # a bound method as a value: a closure over its receiver
            try self.put(try self.bound_name(e))
            try self.put("__new(")
            try self.owned(receiver)
            try self.put(")")
            return
        return try self.fail(e, "a member this slice does not compile")

    ## `module.name`: the declaration under its own name (§15), a function as its thunk and a Base
    ## constant by its value.
    func module_member(e: ast.Node*) -> !:
        let d = e.resolved else return
        if d.kind == ast.Kind.func_:
            try self.put("&")
            try self.put(try self.thunk_name(d, "L_fn_"))
            return
        if d.kind == ast.Kind.constant and d.has(ast.flag_base):
            try self.base_constant(d)
            return
        try self.put("L_")
        if d.kind == ast.Kind.constant or d.kind == ast.Kind.func_:
            try self.put(try self.decl_name(d))
            if d.kind == ast.Kind.constant:
                try self.constant_read(d)
        else:
            try self.put(self.type_name(d))

    ## `Type.name`: a Base function as its thunk, an enum case, or a static member by name.
    func type_member(e: ast.Node*, rt: types.Type) -> !:
        let m = e.resolved else return
        let d = rt.decl else return
        if m.kind == ast.Kind.func_ and m.has(ast.flag_base):
            try self.put("&")
            try self.put(try self.thunk_name(m, "L_fn_"))
            return
        if m.kind == ast.Kind.enum_case:
            try self.put("L_")
            try self.put(self.type_name(d))
            try self.put(".L_")
            try self.put(m.text)
            return
        try self.put("L_")
        try self.put(self.type_name(d))
        try self.put(".L_")
        try self.put(m.text)

    ## `length` of a text in scalars, of bytes, or of a list, by the kernel.
    func length_of(receiver: ast.Node*, rt: types.Type) -> !:
        if rt.kind == types.Kind.str_:
            try self.put("kernel.scalar_length(")
            try self.use(receiver)
            try self.put(")")
        elif rt.kind == types.Kind.bytes_:
            try self.put("kernel.bytes_length(")
            try self.use(receiver)
            try self.put(")")
        else:
            try self.put("kernel.list_length[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")

    ## A field read: a native object's through its getter, else a copy of its own (RUNTIME 4).
    func field_read(e: ast.Node*, receiver: ast.Node*, rt: types.Type, m: ast.Node*) -> !:
        if let owner = rt.decl:
            if owner.native_object != none:
                try self.put("L_")
                try self.put(self.type_name(owner))
                try self.put("__get_")
                try self.put(m.text)
                try self.put("(")
                try self.use(receiver)
                try self.put(")")
                return
        # a field read is a copy of its own (RUNTIME 4)
        let copies = self.checker.table.has_references(m.type_id)
        if copies:
            try self.put(try self.lifetime_name("L_copy_", m.type_id))
            try self.put("(")
        try self.use(receiver)
        try self.put(".L_")
        try self.put(e.text)
        if copies:
            try self.put(")")

    ## `&L_text_N`: the immortal object of a literal, one per distinct text (RUNTIME).
    func text_ref(text: str, as_bytes: bool) -> str!:
        var i: usize = 0
        var at = self.texts.count
        while i < self.texts.count:
            if self.texts.get(i) == text and self.texts_are_bytes.get(i) == as_bytes:
                at = i
                break
            i += 1
        if at == self.texts.count:
            try self.texts.push(try emission.copy_text(text))
            try self.texts_are_bytes.push(as_bytes)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"&L_text_{at}"))

    func text_objects() -> !:
        while self.texts_done < self.texts.count:
            let i = self.texts_done
            self.texts_done += 1
            let as_bytes = self.texts_are_bytes.get(i)
            try self.begin("var L_text_")
            try self.put_u64((u64)i)
            try self.put(": kernel.Bytes = kernel.Bytes(" if as_bytes else ": kernel.Text = kernel.Text(")
            try self.put("header = heap.Object(strong = 1073741824, weak = 0, flags = heap.immortal, info = &kernel.")
            try self.put("bytes_info" if as_bytes else "text_info")
            try self.put("), data = ")
            try self.text_literal(self.texts.get(i), as_bytes)
            try self.put(")")
            try self.end()

    ## The pieces of a formatted text, joined.
    func formatted(e: ast.Node*) -> !:
        try self.put("kernel.join([")
        var cursor = e.body
        var first = true
        while let part = cursor:
            if not first:
                try self.put(", ")
            first = false
            if part.kind == ast.Kind.format_text:
                try self.put(try self.text_ref(try literals.unescape_format(part.text), false))
            else:
                let v = part.left else return
                if part.text.length > 0:
                    try self.put(try self.formatted_operand(v, part.text))
                else:
                    try self.put(try self.shown_operand(v))
            cursor = part.next
        if first:
            try self.put(try self.text_ref("", false))
        try self.put("])")
