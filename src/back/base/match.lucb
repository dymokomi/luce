#==============================================================================================
#
#   base/match - Matching
#
#   DESCRIPTION:
#       `match` as a statement and as an expression.
#
#==============================================================================================
extend Emitter:
    # mark: Matching ===========================================================================

    func match_statement(s: ast.Node*, destination: str = "") -> !:
        let subject = s.left else return
        let st = self.checker.table.get(subject.type_id)
        let m = try self.temp("subject")
        try self.region_variable(m, subject.type_id)
        try self.scoped_value(subject, m)
        if self.checker.table.has_references(subject.type_id):
            try self.begin(m)
            try self.put(" = ")
            try self.put(try self.lifetime_name("L_pool_", subject.type_id))
            try self.put("(")
            try self.put(m)
            try self.end(")")
            self.pooled = true
        if st.kind == types.Kind.tuple or st.kind == types.Kind.str_ or st.kind == types.Kind.bytes_:
            return try self.match_by_tests(s, m, subject.type_id, destination)
        # Match one arm at a time so a guard's owned operands are evaluated only
        # after its pattern binds, and a false guard proceeds to the next arm.
        let done = try self.temp("matched")
        try self.begin("var ")
        try self.put(done)
        try self.line(" = false")
        var cursor = s.body
        while let arm = cursor:
            try self.begin("if not ")
            try self.put(done)
            try self.end(":")
            self.indent += 1
            try self.begin("match ")
            try self.put(m)
            try self.end(":")
            self.indent += 1
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            self.raw_payloads = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, m, &bound)
                p = pattern.next
            self.raw_payloads = false
            try self.end(":")
            self.indent += 1
            if let name = bound:
                try self.begin("let L_")
                try self.put(name.text)
                try self.put(" = ")
                let refs = self.checker.table.has_references(name.type_id)
                if refs:
                    try self.put(try self.lifetime_name("L_copy_", name.type_id))
                    try self.put("(")
                try self.put(m)
                if refs:
                    try self.put(")")
                try self.end()
                try self.drop_at_exit(name.text, name.type_id)
            var q = arm.left
            while let pattern = q:
                try self.own_payloads(pattern, st)
                q = pattern.next
            try self.match_arm(arm, done, destination)
            self.indent -= 1
            # An optional name pattern binds only the present payload.
            let first_pattern = arm.left else return
            if not irrefutable(arm.left) or (st.kind == types.Kind.optional and not first_pattern.has(ast.flag_wildcard)):
                try self.line("_: _ = 0")
            self.indent -= 2
            cursor = arm.next
        try self.match_unhandled(s, done, destination)

    func match_arm(arm: ast.Node*, done: str, destination: str) -> !:
        if let guard = arm.right:
            let condition = try self.temp("guard")
            try self.region_variable(condition, types.bool_id)
            try self.scoped_value(guard, condition)
            try self.begin("if ")
            try self.put(condition)
            try self.end(":")
            self.indent += 1
        try self.begin(done)
        try self.end(" = true")
        let body = arm.body else return
        if destination.length > 0:
            try self.scoped_value(body, destination)
        else:
            try self.block(body)
        if arm.right != none:
            self.indent -= 1

    func match_unhandled(s: ast.Node*, done: str, destination: str) -> !:
        if s.has(ast.flag_all_exit):
            try self.line("trap(\"no arm of the match applied\")")
        elif destination.length > 0:
            try self.begin("if not ")
            try self.put(done)
            try self.end(":")
            try self.line("    trap(\"no arm of the match applied\")")

    ## `let L_x = L_copy(L_x__r)` and its drop for every payload name the pattern bound
    ## whose type holds references; `pattern` wrote the raw name.
    func own_payloads(p: ast.Node*, st: types.Type) -> !:
        if p.has(ast.flag_wildcard):
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional and self.checker.table.has_references(name.type_id):
                try self.own_payload(name)
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            var cursor = v.body
            while let name = cursor:
                if not name.has(ast.flag_wildcard) and self.checker.table.has_references(name.type_id):
                    try self.own_payload(name)
                cursor = name.next

    func own_payload(name: ast.Node*) -> !:
        try self.begin("let L_")
        try self.put(name.text)
        try self.put(" = ")
        try self.put(try self.lifetime_name("L_copy_", name.type_id))
        try self.put("(L_")
        try self.put(name.text)
        try self.put("__r)")
        try self.end()
        try self.drop_at_exit(name.text, name.type_id)

    ## A bound payload name in a pattern: raw when the binding will copy it.
    func payload_name(name: ast.Node*) -> !:
        try self.put("L_")
        try self.put(name.text)
        if self.raw_payloads and self.checker.table.has_references(name.type_id):
            try self.put("__r")

    ## One pattern in a Base arm; a name pattern becomes `_` (or `.some(name)`) and is
    ## bound at the arm's start.
    func pattern(p: ast.Node*, st: types.Type, subject: str, bound: ast.Node*?*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional:
                try self.put(".some(")
                try self.payload_name(name)
                try self.put(")")
            else:
                try self.put("_")
                *bound = name
            return
        if p.text == "none":
            try self.put(".none")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            try self.put(".L_")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                var cursor = v.body
                var first = true
                while let name = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    if name.has(ast.flag_wildcard):
                        try self.put("_")
                    else:
                        try self.payload_name(name)
                    cursor = name.next
                try self.put(")")
            return
        if p.text == "..<" or p.text == "..=":
            let hi = p.right else return
            try self.expr(v)
            try self.put(p.text)
            try self.expr(hi)
            return
        if v.kind == ast.Kind.literal and v.type_id == types.str_id:
            try self.text_literal(try literals.decode_text(v.text), false)
            return
        try self.expr(v)

    ## The value a capture takes: `self` from the method, otherwise the binding's value.
    func captured_source(d: ast.Node*, name: str) -> !:
        if name == "self":
            try self.put(self.self_name)
            return
        try self.captured_name(d, name)
        if d.has(ast.flag_captured):
            try self.put(".value")

    ## Whether an expression may be read more than once without a change of meaning.
    func stable(e: ast.Node*) -> bool:
        match e.kind:
            .name, .self_, .literal: return true
            .group:
                let inner = e.left else return false
                return self.stable(inner)
            .tuple:
                var cursor = e.body
                while let m = cursor:
                    if not self.stable(m):
                        return false
                    cursor = m.next
                return true
            _: return false

    ## A match over a tuple: one `if` per arm over member tests, a flag saying an arm
    ## applied so a failed guard falls through to the next, and a trap after the chain when
    ## every arm leaves the function, so Base sees the return the checker proved.
    func match_by_tests(s: ast.Node*, m: str, st: u32, destination: str) -> !:
        let done = try self.temp("matched")
        try self.begin("var ")
        try self.put(done)
        try self.put(" = false")
        try self.end()
        var cursor = s.body
        while let arm = cursor:
            try self.begin("if not ")
            try self.put(done)
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" and (")
                var p = arm.left
                var first = true
                while let pattern = p:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m, st)
                    try self.put(")")
                    p = pattern.next
                try self.put(")")
            try self.put(":")
            try self.end()
            self.indent += 1
            if let pattern = arm.left:
                try self.tuple_bindings(pattern, m)
            try self.match_arm(arm, done, destination)
            self.indent -= 1
            cursor = arm.next
        try self.match_unhandled(s, done, destination)

    func tuple_test(p: ast.Node*, m: str, t: u32) -> !:
        if p.has(ast.flag_wildcard) or p.text == "bind":
            try self.put("true")
            return
        if p.text == "tuple":
            let members = self.checker.table.get(t).args
            var i: usize = 0
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(" and ")
                first = false
                let half = self.checker.scratch.length // 2
                let member = try strings.format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_test_member(sub, try emission.copy_text(member), members[i])
                i += 1
                cursor = sub.next
            if first:
                try self.put("true")
            return
        let v = p.left else return
        if self.needs_equality(t):
            try self.put(try self.equality_name(t))
            try self.put("(")
            try self.put(m)
            try self.put(", ")
            try self.use(v)
            try self.put(")")
            return
        try self.put(m)
        try self.put(" == ")
        try self.expr(v)

    func tuple_test_member(p: ast.Node*, member: str, t: u32) -> !:
        try self.put("(")
        try self.tuple_test(p, member, t)
        try self.put(")")

    func tuple_bindings(p: ast.Node*, m: str) -> !:
        if p.text == "bind":
            let name = p.left else return
            try self.begin("let L_")
            try self.put(name.text)
            try self.put(" = ")
            if self.checker.table.has_references(name.type_id):
                try self.put(try self.lifetime_name("L_copy_", name.type_id))
                try self.put("(")
                try self.put(m)
                try self.put(")")
            else:
                try self.put(m)
            try self.end()
            try self.drop_at_exit(name.text, name.type_id)
            return
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            while let sub = cursor:
                let half = self.checker.scratch.length // 2
                let member = try strings.format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_bindings(sub, try emission.copy_text(member))
                i += 1
                cursor = sub.next

    func match_expr(e: ast.Node*) -> !:
        let result = try self.temp("match_value")
        let start = self.out.used
        try self.region_variable(result, e.type_id)
        try self.line("if true:")
        self.indent += 1
        try self.match_statement(e, result)
        self.indent -= 1
        try self.finish_region(start, result, e.type_id)
