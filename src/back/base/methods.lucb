#==============================================================================================
#
#   base/methods - Methods of the built-in types
#
#   DESCRIPTION:
#       Lists, maps, sets, texts, bytes and ranges: each method one kernel call, its receiver and
#       arguments borrowed, a new collection given its descriptor and element operations.
#
#==============================================================================================
extend Emitter:
    # mark: Methods of the built-in types ======================================================

    ## A list's own method (§11.1), one kernel call each: the list, then the arguments in
    ## their parameters' order; a new list given its descriptor and element operations.
    mutating func list_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let elem = self.checker.table.get(callee.type_id).elem
        let name = callee.text
        if name == "sort" or name == "sorted" or name == "min" or name == "max":
            return try self.ordering_call(e, receiver, elem, name)
        if name == "sum":
            try self.put("kernel.list_sum_float(" if elem == types.float_id else "kernel.list_sum_int(")
            try self.use(receiver)
            try self.put(")")
            return
        if name == "join":
            try self.put("kernel.list_join(")
        else:
            try self.put("kernel.list_")
            try self.put(name)
            try self.put("[")
            try self.type_of(elem)
            if name == "map" or name == "flat_map" or name == "zip":
                # the type the new list's elements come from: the function's, the other list's
                try self.put(", ")
                let result = self.checker.table.get(e.type_id).elem
                try self.type_of(self.checker.table.get(result).args[1] if name == "zip" else result)
            elif name == "reduce":
                try self.put(", ")
                try self.type_of(e.type_id)
            try self.put("]")
            try self.put("(")
        try self.use(receiver)
        if name == "insert":
            try self.put(", ")
            try self.use(ast.argument(e, "index") else return)
            try self.put(", ")
            try self.owned(ast.argument(e, "value") else return)
        elif name == "reduce":
            try self.put(", ")
            try self.use(ast.argument(e, "function") else return)
            try self.put(", ")
            try self.use(ast.argument(e, "initial") else return)
            try self.put(", ")
            try self.put(try self.ops_name(e.type_id))
        elif let first = e.body:
            try self.put(", ")
            # a stored value is the list's own; anything else is borrowed for the call
            if name == "append":
                try self.owned(first.left else return)
            else:
                try self.use(first.left else return)
        if name == "map" or name == "flat_map" or name == "zip" or name == "chunks" or name == "indexed":
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(self.checker.table.get(e.type_id).elem))
        try self.put(")")

    ## `sort`, `sorted`, `min` and `max`: by the elements, or `_by` a key with its type's
    ## operations; `reverse` for a sort, which end for `min` and `max`.
    mutating func ordering_call(e: ast.Node*, receiver: ast.Node*, elem: u32, name: str) -> !:
        let key = ast.argument(e, "key")
        try self.put("kernel.list_")
        try self.put("min" if name == "max" else name)
        try self.put("_by[" if key != none else "[")
        try self.type_of(elem)
        if let k = key:
            try self.put(", ")
            try self.type_of(self.checker.table.get(k.type_id).elem)
        try self.put("](")
        try self.use(receiver)
        if let k = key:
            try self.put(", ")
            try self.use(k)
            try self.put(", ")
            try self.put(try self.ops_name(self.checker.table.get(k.type_id).elem))
        try self.put(", ")
        if name == "min" or name == "max":
            try self.put("true" if name == "min" else "false")
        elif let reverse = ast.argument(e, "reverse"):
            try self.use(reverse)
        else:
            try self.put("false")
        try self.put(")")

    ## `r.step(n)`, `r.reversed()` and `r.contains(x)` (§6.6), by the kernel.
    mutating func range_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        try self.put("kernel.range_")
        try self.put(callee.text)
        try self.put("(")
        try self.use(receiver)
        if let first = e.body:
            try self.put(", ")
            try self.use(first.left else return)
        try self.put(")")

    ## A text's or bytes' own method (§11.3, §11.4), one kernel call each: the receiver, then
    ## the arguments in their parameters' order, a default where none was written.
    mutating func text_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if callee.type_id == types.bytes_id:
            try self.put("kernel.decode_text(")
            try self.use(receiver)
            try self.put(")")
            return
        let lists = name == "split" or name == "lines" or name == "characters"
        try self.put("kernel.")
        if name == "bytes":
            try self.put("text_to_bytes")
        elif name == "count":
            try self.put("count_of")
        elif name == "split" and e.body == none:
            try self.put("split_white")
        else:
            try self.put(name)
        try self.put("(")
        try self.use(receiver)
        if name == "pad_left" or name == "pad_right" or name == "center":
            try self.put(", ")
            try self.use(ast.argument(e, "width") else return)
            try self.put(", ")
            if let fill = ast.argument(e, "fill"):
                try self.use(fill)
            else:
                try self.put(try self.text_ref(" ", false))
        elif name == "replace":
            try self.put(", ")
            try self.use(ast.argument(e, "old") else return)
            try self.put(", ")
            try self.use(ast.argument(e, "new") else return)
        elif let first = e.body:
            try self.put(", ")
            try self.use(first.left else return)
        if lists:
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(types.str_id))
        try self.put(")")

    ## `K, V` of a map, or `T, unit` of a set, as type arguments.
    mutating func map_types(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.type_of(t.elem)
        try self.put(", ")
        if t.kind == types.Kind.map_:
            try self.type_of(self.checker.table.map_value(id))
        else:
            try self.put("u8")

    ## A map's or a set's own method (§11.2), one kernel call each.
    mutating func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if is_map or name == "clear" or name == "copy":
            try self.put("kernel.map_")
            try self.put("get_or" if name == "get" else name)
        else:
            try self.put("kernel.set_")
            try self.put(name)
        try self.put("[")
        if is_map or name == "clear" or name == "copy":
            try self.map_types(callee.type_id)
        else:
            try self.type_of(self.checker.table.get(callee.type_id).elem)
        try self.put("](")
        try self.use(receiver)
        if name == "get":
            try self.put(", ")
            try self.use(ast.argument(e, "key") else return)
            try self.put(", ")
            try self.use(ast.argument(e, "default") else return)
        elif let first = e.body:
            try self.put(", ")
            if name == "insert":
                try self.owned(first.left else return)
            else:
                try self.use(first.left else return)
        if name == "keys" or name == "values" or name == "items":
            # a new list: its descriptor and its element operations
            let result = self.checker.table.get(e.type_id)
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(result.elem))
        try self.put(")")
