#==============================================================================================
#
#   base/equality - Equality and ordering
#
#   DESCRIPTION:
#       The equality and ordering functions of types compared by value.
#
#==============================================================================================
extend Emitter:
    # mark: Equality and ordering ==============================================================

    ## The method a type declares for a closed protocol (§13.3), if it declares one.
    func protocol_method(id: u32, protocol: str, method: str) -> ast.Node*?:
        let t = self.checker.table.get(id)
        if t.kind != types.Kind.struct_ and t.kind != types.Kind.class_ and t.kind != types.Kind.enum_:
            return none
        let d = t.decl else return none
        let iface = self.checker.find_declaration(protocol) else return none
        var cursor = d.right
        while let conformance = cursor:
            if conformance.type_id == iface.type_id:
                return self.checker.find_member(d, method)
            cursor = conformance.next
        return none

    ## The name a type declaration is written under: its type's, qualified by its module
    ## when it is not the entry module's (§15).
    func type_name(d: ast.Node*) -> str:
        return self.checker.table.get(d.type_id).name

    ## Functions and constants share one generated Base module with every source
    ## module's locals. The digit after L_ cannot begin a source identifier, so a
    ## local cannot collide with this namespace. Module IDs also distinguish dotted
    ## module names whose underscore-rendered spellings would otherwise coincide.
    func decl_name(d: ast.Node*) -> str!:
        let name = try self.checker.emitted_name(d)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try format(self.checker.scratch[half..], f"0_{d.module}_{name}"))

    ## The expression written out as a value used and let go of, as text.
    mutating func used(e: ast.Node*) -> str!:
        let start = self.out.used
        try self.use(e)
        let text = try self.capture(start)
        return text

    ## `L_T__L_m(a` for a class or an enum, `a.L_m(` for a struct: the receiver goes
    ## first, and the caller writes the arguments and the closing parenthesis.
    mutating func method_on(id: u32, m: ast.Node*, receiver: str) -> !:
        let t = self.checker.table.get(id)
        if t.kind == types.Kind.class_ or t.kind == types.Kind.enum_ or t.kind == types.Kind.interface_:
            try self.put("L_")
            try self.put(t.name)
            try self.put("__L_")
            try self.put(m.text)
            try self.put("(")
            try self.put(receiver)
            return
        try self.put(receiver)
        try self.put(".L_")
        try self.put(m.text)
        try self.put("(")

    ## Whether `==` on the type is a call: a collection, or a value holding one, since Base's
    ## own `==` on the pointer would compare identity; a declared `equals` too.
    func needs_equality(id: u32) -> bool:
        return self.equality_at(id, 0)

    func equality_at(id: u32, depth: u32) -> bool:
        if depth > 32:
            return true
        let k = self.checker.table.kind(id)
        if k == types.Kind.struct_ or k == types.Kind.enum_:
            let fresh = self.checker.entering(id) catch failure: recover false
            if not fresh:
                return true
            let answer = self.equality_walk(id, depth)
            self.checker.leave_walk()
            return answer
        return self.equality_walk(id, depth)

    func equality_walk(id: u32, depth: u32) -> bool:
        if self.protocol_method(id, "Equatable", "equals") != none:
            return true
        let t = self.checker.table.get(id)
        match t.kind:
            .list_, .map_, .set_, .bytes_, .str_: return true
            .optional: return self.equality_at(t.elem, depth + 1)
            .tuple:
                for m in t.args:
                    if self.equality_at(m, depth + 1):
                        return true
                return false
            .struct_, .enum_:
                let d = t.decl else return false
                if d.has(ast.flag_native_value):
                    return true
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.equality_at(m.type_id, depth + 1):
                        return true
                    if m.kind == ast.Kind.enum_case:
                        var p = m.body
                        while let field = p:
                            if self.equality_at(field.type_id, depth + 1):
                                return true
                            p = field.next
                    cursor = m.next
                return false
            _: return false

    ## The function comparing two values of the type for equality, emitted after the
    ## program.
    mutating func equality_name(t: u32) -> str!:
        try self.remember(&self.equalities, t)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try format(self.checker.scratch[half..], f"L_eq_{t}"))

    ## The function ordering two values of the type: -1, 0, 1.
    mutating func ordering_name(t: u32) -> str!:
        try self.remember(&self.orderings, t)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try format(self.checker.scratch[half..], f"L_cmp_{t}"))

    mutating func remember(where: list.List[u32]*, t: u32) -> !:
        var i: usize = 0
        while i < where.count:
            if where.get(i) == t:
                return
            i += 1
        try where.push(t)

    mutating func comparison_functions() -> !:
        while self.equalities_done < self.equalities.count:
            let t = self.equalities.get(self.equalities_done)
            self.equalities_done += 1
            try self.equality_function(t)
        while self.orderings_done < self.orderings.count:
            let t = self.orderings.get(self.orderings_done)
            self.orderings_done += 1
            try self.ordering_function(t)

    mutating func equality_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.equality_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> bool:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Equatable", "equals"):
            try self.begin("return ")
            try self.method_on(id, m, "a")
            try self.put("b)" if t.kind == types.Kind.struct_ else ", b)")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        if let declaration = t.decl:
            if declaration.has(ast.flag_native_value):
                let native = try native_types.native_node(declaration)
                try self.begin("return ")
                try self.boundary().to_base(native, "a", declaration)
                try self.put(" == ")
                try self.boundary().to_base(native, "b", declaration)
                try self.end()
                self.indent -= 1
                try self.line("")
                return
        match t.kind:
            .list_:
                try self.begin("return kernel.list_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .map_:
                try self.begin("return kernel.map_equal[")
                try self.map_types(id)
                try self.put("](a, b)")
                try self.end()
            .set_:
                try self.begin("return kernel.set_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .bytes_: try self.line("return kernel.bytes_equal(a, b)")
            .str_: try self.line("return kernel.text_equal(a, b)")
            .optional:
                try self.line("if let x = a:")
                try self.line("    if let y = b:")
                try self.begin("        return ")
                try self.put(try self.member_equality(t.elem, "x", "y"))
                try self.end()
                try self.line("    return false")
                try self.line("return b == none")
            .tuple:
                try self.begin("return ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(" and ")
                    let half = self.checker.scratch.length // 2
                    let x = try emission.copy_text(try format(self.checker.scratch[half..], f"a.{i}"))
                    let y = try emission.copy_text(try format(self.checker.scratch[half..], f"b.{i}"))
                    try self.put(try self.member_equality(t.args[i], x, y))
                    i += 1
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.equality_struct(d)
            .enum_:
                let d = t.decl else return
                try self.equality_enum(d)
            _: try self.line("return a == b")
        self.indent -= 1
        try self.line("")

    ## A struct's equality: every field equal, in declaration order; `true` with none.
    mutating func equality_struct(d: ast.Node*) -> !:
        try self.begin("return ")
        var cursor = d.body
        var first = true
        while let m = cursor:
            if m.kind == ast.Kind.field:
                if not first:
                    try self.put(" and ")
                first = false
                let half = self.checker.scratch.length // 2
                let x = try emission.copy_text(try format(self.checker.scratch[half..], f"a.L_{m.text}"))
                let y = try emission.copy_text(try format(self.checker.scratch[half..], f"b.L_{m.text}"))
                try self.put(try self.member_equality(m.type_id, x, y))
            cursor = m.next
        if first:
            try self.put("true")
        try self.end()

    ## An enum's equality: a `match` on `a` whose every arm matches `b` against the same case and
    ## compares the fields; a different case is unequal.
    mutating func equality_enum(d: ast.Node*) -> !:
        try self.line("match a:")
        self.indent += 1
        var cases: i64 = 0
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin(".L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("x_")
                        try self.put(field.text)
                        p = field.next
                    try self.put(")")
                try self.put(":")
                try self.end()
                self.indent += 1
                try self.line("match b:")
                try self.begin("    .L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("y_")
                        try self.put(field.text)
                        p = field.next
                    try self.put("): return ")
                    p = m.body
                    first = true
                    while let field = p:
                        if not first:
                            try self.put(" and ")
                        first = false
                        let half = self.checker.scratch.length // 2
                        let x = try emission.copy_text(try format(self.checker.scratch[half..], f"x_{field.text}"))
                        let y = try emission.copy_text(try format(self.checker.scratch[half..], f"y_{field.text}"))
                        try self.put(try self.member_equality(field.type_id, x, y))
                        p = field.next
                else:
                    try self.put(": return true")
                try self.end()
                try self.line("    _: return false")
                self.indent -= 1
                cases += 1
            cursor = m.next
        # Base asks a match over more than 64 cases for a `_` arm, even an exhaustive one.
        if cases > 64:
            try self.line("_: return false")
        self.indent -= 1

    ## `x == y` as text, through the type's function where it needs one.
    mutating func member_equality(t: u32, x: str, y: str) -> str!:
        let half = self.checker.scratch.length // 2
        if self.needs_equality(t):
            return try emission.copy_text(try format(self.checker.scratch[half..], f"{try self.equality_name(t)}({x}, {y})"))
        return try emission.copy_text(try format(self.checker.scratch[half..], f"({x} == {y})"))

    mutating func ordering_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.ordering_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> i64:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Ordered", "compare"):
            try self.begin("return ")
            try self.method_on(id, m, "a")
            try self.put("b)" if t.kind == types.Kind.struct_ else ", b)")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .int_, .float_, .bool_: try self.line("return -1 if a < b else 1 if a > b else 0")
            .str_: try self.line("return kernel.compare_text(a, b)")
            .bytes_: try self.line("return kernel.compare_blobs(a, b)")
            .tuple:
                var i: usize = 0
                while i < t.args.length:
                    let c = try self.temp("c")
                    try self.begin("let ")
                    try self.put(c)
                    try self.put(" = ")
                    try self.put(try self.ordering_name(t.args[i]))
                    try self.put("(a.")
                    try self.put_u64((u64)i)
                    try self.put(", b.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    try self.end()
                    try self.begin("if ")
                    try self.put(c)
                    try self.put(" != 0:")
                    try self.end()
                    try self.begin("    return ")
                    try self.put(c)
                    try self.end()
                    i += 1
                try self.line("return 0")
            _: return try self.fail(self.checker.tree(), "a type the emitter cannot order")
        self.indent -= 1
        try self.line("")
