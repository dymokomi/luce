#==============================================================================================
#
#   base/lifetimes - Lifetimes and collections
#
#   DESCRIPTION:
#       The generated support functions every object type needs: its lifetime, its
#       references walked, collection support, and the ops tables.
#
#==============================================================================================
extend Emitter:
    # mark: Lifetimes and collections ==========================================================

    ## The name of the copy, drop, trace, pool, identity or weak-get function of a type,
    ## which is emitted after the program.
    func lifetime_name(prefix: str, t: u32) -> str!:
        return try self.writer().lifetime_name(prefix, t)

    ## Every function and table the program's types need, each written once; writing one
    ## can register more, so the sets are walked until nothing new appears.
    func support_functions() -> !:
        while true:
            let before = self.shown.count + self.lifetimes.count + self.equalities.count + self.orderings.count + self.hashes.count + self.ops_types.count + self.texts.count + self.lambdas.count + self.thunks.count + self.bounds.count + self.calls.count + self.cells.count + self.box_interfaces.count + self.crossing_work.types.count + self.callbacks.count + self.spawns.count + self.waits.count + self.sends.count + self.native_calls.count + self.widened.count
            let done = self.shown_done + self.lifetimes_done + self.equalities_done + self.orderings_done + self.hashes_done + self.ops_done + self.texts_done + self.lambdas_done + self.thunks_done + self.bounds_done + self.calls_done + self.cells_done + self.boxes_done + self.crossing_work.done + self.callbacks_done + self.spawns_done + self.waits_done + self.sends_done + self.native_calls_done + self.widened_done
            if before == done:
                return
            try self.show_functions()
            try self.lifetime_functions()
            try self.comparison_functions()
            try self.hash_functions()
            try self.ops_tables()
            try self.text_objects()
            try self.closure_support()
            try self.box_support()
            try self.boundary_support()
            try self.worker_support()

    ## The functions of every type holding references the program used, and of the types
    ## those reach; the list grows while it is walked.
    func lifetime_functions() -> !:
        while self.lifetimes_done < self.lifetimes.count:
            let t = self.lifetimes.get(self.lifetimes_done)
            self.lifetimes_done += 1
            try self.lifetime_function_set(t)

    func lifetime_function_set(id: u32) -> !:
        let t = self.checker.table.get(id)
        # copy: a reference of its own to every object held
        try self.lifetime_head("L_copy_", id, ") -> ", id)
        self.indent += 1
        match t.kind:
            .class_, .interface_, .list_, .map_, .set_, .str_, .bytes_, .func_, .task_:
                try self.begin("return (")
                try self.type_of(id)
                try self.put(")heap.retain((heap.Object*)v)")
                try self.end()
            .error_value: try self.line("return kernel.copy_failure(v)")
            .weak_: try self.line("return heap.weak_copy(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.lifetime_name("L_copy_", t.elem))
                try self.put("(inner)")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.member_copy(t.args[i], "v.", i)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_:
                try self.line("var out = v")
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("out.L_")
                        try self.put(m.text)
                        try self.put(" = ")
                        try self.put(try self.lifetime_name("L_copy_", m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                try self.copy_enum_cases(t, d)
                try self.line("_: return v")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot copy")
        self.indent -= 1
        try self.line("")
        # drop and trace: every object held, a class field of zero (never assigned) skipped
        try self.lifetime_head("L_drop_", id, "):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_drop_", "")
        self.indent -= 1
        try self.line("")
        try self.lifetime_head("L_trace_", id, ", visit: func(heap.Object*, void*) -> unit, context: void*):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_trace_", ", visit, context")
        self.indent -= 1
        try self.line("")
        try self.pool_functions(id, t)
        try self.identity_functions(id, t)
        if t.kind == types.Kind.list_ or t.kind == types.Kind.map_ or t.kind == types.Kind.set_:
            try self.collection_support(id, t)

    ## The arms of an enum's copy: each case with fields rebuilt with copies of those holding
    ## references; the caller's `_` returns the rest as they are.
    func copy_enum_cases(t: types.Type, d: ast.Node*) -> !:
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case and m.body != none:
                try self.begin(".L_")
                try self.put(m.text)
                try self.put("(")
                var p = m.body
                var first = true
                while let field = p:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(field.text)
                    p = field.next
                try self.put("): return L_")
                try self.put(t.name)
                try self.put(".L_")
                try self.put(m.text)
                try self.put("(")
                p = m.body
                first = true
                while let field = p:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(field.text)
                    try self.put(" = ")
                    if self.checker.table.has_references(field.type_id):
                        try self.put(try self.lifetime_name("L_copy_", field.type_id))
                        try self.put("(L_")
                        try self.put(field.text)
                        try self.put(")")
                    else:
                        try self.put("L_")
                        try self.put(field.text)
                    p = field.next
                try self.put(")")
                try self.end()
            cursor = m.next

    ## Pool: a temporary of the statement handed to the pool, and for a value type the drop
    ## through a pointer the pool calls.
    func pool_functions(id: u32, t: types.Type) -> !:
        try self.lifetime_head("L_pool_", id, ") -> ", id)
        self.indent += 1
        if is_object_kind(t.kind):
            try self.begin("return (")
            try self.type_of(id)
            try self.put(")heap.pool_object((heap.Object*)v)")
            try self.end()
        else:
            try self.begin("return heap.pool_value[")
            try self.type_of(id)
            try self.put("](v, ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put(")")
            try self.end()
        self.indent -= 1
        try self.line("")
        if not is_object_kind(t.kind):
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put("(p: void*):")
            try self.end()
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", id))
            try self.put("(memory.read[")
            try self.type_of(id)
            try self.put("](p))")
            try self.end()
            try self.line("")

    ## Identity for a class and its optional, and a weak reference's get for a class.
    func identity_functions(id: u32, t: types.Type) -> !:
        let inner = self.checker.table.kind(t.elem) if t.kind == types.Kind.optional else t.kind
        let identity_kinds = (is_object_kind(t.kind) and t.kind != types.Kind.str_ and t.kind != types.Kind.bytes_ and t.kind != types.Kind.func_) or (t.kind == types.Kind.optional and is_object_kind(inner) and inner != types.Kind.str_ and inner != types.Kind.bytes_ and inner != types.Kind.func_)
        if identity_kinds:
            try self.lifetime_head("L_id_", id, ") -> u64:", types.none_id)
            if t.kind != types.Kind.optional:
                try self.line("    return heap.identity((heap.Object*)v)")
            else:
                try self.line("    if let o = v:")
                try self.line("        return heap.identity((heap.Object*)o)")
                try self.line("    return 0")
            try self.line("")
        if t.kind == types.Kind.class_:
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_weak_get_", id))
            try self.put("(w: heap.Weak) -> ")
            try self.type_of(id)
            try self.put("?:")
            try self.end()
            try self.line("    if let o = heap.weak_get(w):")
            try self.begin("        return (")
            try self.type_of(id)
            try self.put(")o")
            try self.end()
            try self.line("    return none")
            try self.line("")

    ## What a collection needs beside its lifetime functions: the runtime's descriptor and
    ## the drop and trace it calls; the element operations come per element type.
    func collection_support(id: u32, t: types.Type) -> !:
        let drop = try self.lifetime_name("L_colldrop_", id)
        let trace = try self.lifetime_name("L_colltrace_", id)
        let is_list = t.kind == types.Kind.list_
        try self.begin("func ")
        try self.put(drop)
        try self.put("(o: heap.Object*):")
        try self.end()
        try self.begin("    kernel.list_drop[" if is_list else "    kernel.map_drop[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o)")
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(trace)
        try self.put("(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    kernel.list_trace[" if is_list else "    kernel.map_trace[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o, visit, context)")
        try self.end()
        try self.line("")
        try self.begin("var ")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(": heap.Info = heap.Info(name = \"")
        try self.put("list" if is_list else "map" if t.kind == types.Kind.map_ else "set")
        try self.put("\", size = memory.size_of(")
        try self.type_of_object(id)
        try self.put("), finish = none, drop = ")
        try self.put(drop)
        try self.put(", trace = ")
        try self.put(trace)
        if self.checker.table.acyclic(id):
            try self.put(", acyclic = true")  # a list of text never joins a cycle
        try self.put(")")
        try self.end()
        try self.line("")
        _ = try self.ops_name(t.elem)
        if t.kind == types.Kind.map_:
            _ = try self.ops_name(self.checker.table.map_value(id))

    ## The collection's Base struct, `kernel.List[T]` without the star.
    func type_of_object(id: u32) -> !:
        let start = self.out.used
        try self.type_of(id)
        let text = try self.capture(start)
        try self.put((str)text.bytes[..<text.length - 1])

    ## The operations table of an element type, emitted after the program.
    func ops_name(t: u32) -> str!:
        return try self.writer().ops_name(t)

    func ops_tables() -> !:
        while self.ops_done < self.ops_types.count:
            let elem = self.ops_types.get(self.ops_done)
            self.ops_done += 1
            try self.begin("var ")
            try self.put(try self.ops_name(elem))
            try self.put(": kernel.Ops[")
            try self.type_of(elem)
            try self.put("] = kernel.Ops[")
            try self.type_of(elem)
            try self.put("](copy = ")
            let holds = self.checker.table.has_references(elem)
            try self.put(try self.lifetime_name("L_copy_", elem) if holds else "none")
            try self.put(", drop = ")
            try self.put(try self.lifetime_name("L_drop_", elem) if holds else "none")
            try self.put(", trace = ")
            try self.put(try self.lifetime_name("L_trace_", elem) if holds else "none")
            try self.put(", equal = ")
            let equatable = bodies.equatable(self.checker, elem)
            try self.put(try self.equality_name(elem) if equatable else "none")
            try self.put(", compare = ")
            try self.put(try self.ordering_name(elem) if bodies.orderable(self.checker, elem) else "none")
            try self.put(", hashed = ")
            try self.put(try self.hash_name(elem) if bodies.hashable(self.checker, elem) else "none")
            try self.put(")")
            try self.end()

    ## `func NAME(v: T` and what follows; a result type when `result` is given.
    func lifetime_head(prefix: str, id: u32, tail: str, result: u32) -> !:
        try self.begin("func ")
        try self.put(try self.lifetime_name(prefix, id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(tail)
        if result != types.none_id:
            try self.type_of(result)
            try self.put(":")
        try self.end()

    ## One member of a tuple copy: copied when it holds references.
    func member_copy(t: u32, prefix: str, i: usize) -> !:
        if self.checker.table.has_references(t):
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
            try self.put(prefix)
            try self.put_u64((u64)i)
            try self.put(")")
        else:
            try self.put(prefix)
            try self.put_u64((u64)i)

    ## The body of a drop or trace: the call `prefix` on every part holding references,
    ## `extra` appended to the arguments.
    func walk_references(t: types.Type, id: u32, prefix: str, extra: str) -> !:
        match t.kind:
            .error_value:
                try self.line("kernel.drop_failure(v)" if prefix == "L_drop_" else "_ = v")
            .str_, .bytes_:
                # a text holds no references: released, never traced
                if prefix == "L_drop_":
                    try self.line("if (usize)v != 0:")
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("_ = v")
            .class_, .interface_, .list_, .map_, .set_, .func_, .task_:
                try self.line("if (usize)v != 0:")
                if prefix == "L_drop_":
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("    visit((heap.Object*)v, context)")
            .weak_:
                if prefix == "L_drop_":
                    try self.line("heap.weak_drop(v)")
                else:
                    try self.line("_ = v")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    ")
                try self.put(try self.lifetime_name(prefix, t.elem))
                try self.put("(inner")
                try self.put(extra)
                try self.put(")")
                try self.end()
            .tuple:
                var i: usize = 0
                var any = false
                while i < t.args.length:
                    if self.checker.table.has_references(t.args[i]):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, t.args[i]))
                        try self.put("(v.")
                        try self.put_u64((u64)i)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    i += 1
                if not any:
                    try self.line("_ = v")
            .struct_: try self.walk_struct(t, prefix, extra)
            .enum_: try self.walk_enum(t, prefix, extra)
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot walk")

    ## A struct's drop or trace: each field holding references, in declaration order.
    func walk_struct(t: types.Type, prefix: str, extra: str) -> !:
        let d = t.decl else return
        var cursor = d.body
        var any = false
        while let m = cursor:
            if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                try self.begin("")
                try self.put(try self.lifetime_name(prefix, m.type_id))
                try self.put("(v.L_")
                try self.put(m.text)
                try self.put(extra)
                try self.put(")")
                try self.end()
                any = true
            cursor = m.next
        if not any:
            try self.line("_ = v")

    ## An enum's drop or trace: a `match` with an arm for each case holding references, binding
    ## only those fields, and a `_` for the rest.
    func walk_enum(t: types.Type, prefix: str, extra: str) -> !:
        try self.line("match v:")
        self.indent += 1
        let d = t.decl else return
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case and m.body != none:
                var holds = false
                var p = m.body
                while let field = p:
                    if self.checker.table.has_references(field.type_id):
                        holds = true
                    p = field.next
                if holds:
                    try self.begin(".L_")
                    try self.put(m.text)
                    try self.put("(")
                    p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        if self.checker.table.has_references(field.type_id):
                            try self.put("L_")
                            try self.put(field.text)
                        else:
                            try self.put("_")
                        p = field.next
                    try self.put("):")
                    try self.end()
                    self.indent += 1
                    p = m.body
                    while let field = p:
                        if self.checker.table.has_references(field.type_id):
                            try self.begin("")
                            try self.put(try self.lifetime_name(prefix, field.type_id))
                            try self.put("(L_")
                            try self.put(field.text)
                            try self.put(extra)
                            try self.put(")")
                            try self.end()
                        p = field.next
                    self.indent -= 1
            cursor = m.next
        try self.line("_: _ = 0")
        self.indent -= 1


func is_object_kind(k: types.Kind) -> bool:
    return k == types.Kind.class_ or k == types.Kind.interface_ or k == types.Kind.list_ or k == types.Kind.map_ or k == types.Kind.set_ or k == types.Kind.str_ or k == types.Kind.bytes_ or k == types.Kind.func_ or k == types.Kind.task_
