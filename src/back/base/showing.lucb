#==============================================================================================
#
#   base/showing - Showing values
#
#   DESCRIPTION:
#       The functions that turn a value into text for `print` and formatting.
#
#==============================================================================================
extend Emitter:
    # mark: Showing values =====================================================================

    ## Evaluate and render a field before the next field can mutate its source.
    func shown_operand(value: ast.Node*) -> str!:
        let name = try self.temp("shown")
        let start = self.out.used
        try self.shown_value(value)
        let text = try self.capture(start)
        var i: u32 = 0
        while i < self.indent:
            try self.prelude.put("    ")
            i += 1
        try self.prelude.put("let ")
        try self.prelude.put(name)
        try self.prelude.put(" = ")
        try self.prelude.put(try self.lifetime_name("L_pool_", types.str_id))
        try self.prelude.put("(")
        try self.prelude.put(text)
        try self.prelude.put(")\n")
        self.pooled = true
        return name

    ## The display of a value as an owned text: `str(x)`.
    func shown_value(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.owned(v)
            return
        try self.put(try self.show_name(t))
        try self.put("(")
        try self.use(v)
        try self.put(")")

    ## The function that displays a value of type `t`, emitted after the program.
    func show_name(t: u32) -> str!:
        match self.checker.table.kind(t):
            .int_: return "kernel.show_int"
            .str_: return "kernel.show_text"
            .float_: return "kernel.show_float"
            .bool_: return "kernel.show_bool"
            .bytes_: return "kernel.show_bytes"
            .range_: return "kernel.show_range"
            _: _ = 0
        var i: usize = 0
        var seen = false
        while i < self.shown.count:
            if self.shown.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.shown.push(t)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"show_{t}"))

    func show_functions() -> !:
        while self.shown_done < self.shown.count:
            let t = self.shown.get(self.shown_done)
            self.shown_done += 1
            try self.show_function(t)

    func show_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        let name = try self.show_name(id)
        try self.begin("func ")
        try self.put(name)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> kernel.Text*:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Display", "display"):
            try self.begin("return ")
            try self.method_on(id, m, "v")
            try self.put(")")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .list_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.items[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"[\", \"]\")")
            .set_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .map_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.pair_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]), ")
                try self.put(try self.show_name(self.checker.table.map_value(id)))
                try self.put("(v.values[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .unit_:
                try self.begin("return ")
                try self.put(try self.text_ref("()", false))
                try self.end()
            .error_code:
                try self.begin("return kernel.join_owned([")
                try self.put(try self.text_ref("ErrorCode(", false))
                try self.put(", kernel.show_int((i64)v), ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .error_value: try self.line("return kernel.text_of(v.message.data)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.show_name(t.elem))
                try self.put("(inner)")
                try self.end()
                try self.begin("return ")
                try self.put(try self.text_ref("none", false))
                try self.end()
            .tuple: try self.show_tuple(t)
            .struct_:
                let d = t.decl else return
                try self.show_struct(d)
            .enum_:
                let d = t.decl else return
                try self.show_enum(d)
            _: return try self.checker.fail(self.checker.tree(), "a value this slice does not display")
        self.indent -= 1
        try self.line("")

    ## A tuple shown as `(a, b)`, a tuple of one keeping its comma.
    func show_tuple(t: types.Type) -> !:
        try self.begin("return kernel.join_owned([")
        try self.put(try self.text_ref("(", false))
        try self.put(", ")
        var i: usize = 0
        while i < t.args.length:
            if i > 0:
                try self.put(", ")
                try self.put(try self.text_ref(", ", false))
                try self.put(", ")
            try self.put(try self.show_name(t.args[i]))
            try self.put("(v.")
            try self.put_u64((u64)i)
            try self.put(")")
            i += 1
        if t.args.length == 1:
            try self.put(", ")
            try self.put(try self.text_ref(",", false))
        try self.put(", ")
        try self.put(try self.text_ref(")", false))
        try self.put("])")
        try self.end()

    ## A struct shown as written: `Name(field = value, ...)`, each field shown by its own type.
    func show_struct(d: ast.Node*) -> !:
        try self.begin("return kernel.join_owned([")
        let half = self.checker.scratch.length // 2
        try self.put(try self.text_ref(try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{check.display_name(d)}(")), false))
        var cursor = d.body
        var first = true
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.put(", ")
                let label = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{", " if not first else ""}{m.text} = "))
                first = false
                try self.put(try self.text_ref(label, false))
                try self.put(", ")
                try self.put(try self.show_name(m.type_id))
                try self.put("(v.L_")
                try self.put(m.text)
                try self.put(")")
            cursor = m.next
        try self.put(", ")
        try self.put(try self.text_ref(")", false))
        try self.put("])")
        try self.end()

    ## An enum shown case by case, as written: `Name.case` alone, or `Name.case(field = value, ...)`
    ## with each field shown by its own type.
    func show_enum(d: ast.Node*) -> !:
        try self.line("match v:")
        self.indent += 1
        var cases: usize = 0
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                cases += 1
                try self.begin(".L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        p = field.next
                    try self.put(")")
                try self.put(":")
                try self.end()
                let half = self.checker.scratch.length // 2
                try self.begin("    return kernel.join_owned([")
                if m.body != none:
                    try self.put(try self.text_ref(try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{check.display_name(d)}.{m.text}(")), false))
                    var p = m.body
                    var first = true
                    while let field = p:
                        try self.put(", ")
                        let label = try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{", " if not first else ""}{field.text} = "))
                        first = false
                        try self.put(try self.text_ref(label, false))
                        try self.put(", ")
                        try self.put(try self.show_name(field.type_id))
                        try self.put("(L_")
                        try self.put(field.text)
                        try self.put(")")
                        p = field.next
                    try self.put(", ")
                    try self.put(try self.text_ref(")", false))
                    try self.put("])")
                else:
                    try self.put(try self.text_ref(try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{d.text}.{m.text}")), false))
                    try self.put("])")
                try self.end()
            cursor = m.next
        # Base asks a match over more than 64 cases for a `_` arm, even an exhaustive one.
        if cases > 64:
            try self.line("_: trap(\"no such case\")")
        self.indent -= 1
