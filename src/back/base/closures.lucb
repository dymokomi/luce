#==============================================================================================
#
#   base/closures - Closures
#
#   DESCRIPTION:
#       Lambdas and the objects that carry what they capture (§7.4).
#
#==============================================================================================
extend Emitter:
    # mark: Closures ===========================================================================

    func lambda_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.lambdas.count
        while i < self.lambdas.count:
            if self.lambdas.get(i) == e:
                at = i
            i += 1
        if at == self.lambdas.count:
            try self.lambdas.push(e)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_lambda_{at}"))

    func thunk_name(d: ast.Node*, prefix: str) -> str!:
        var i: usize = 0
        var at = self.thunks.count
        while i < self.thunks.count:
            if self.thunks.get(i) == d:
                at = i
            i += 1
        if at == self.thunks.count:
            try self.thunks.push(d)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"{prefix}{at}"))

    func bound_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.bounds.count
        while i < self.bounds.count:
            if self.bounds.get(i) == e:
                at = i
            i += 1
        if at == self.bounds.count:
            try self.bounds.push(e)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_bound_{at}"))

    func call_name(t: u32) -> str!:
        try remember(&self.calls, t)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_call_{t}"))

    func cell_info_name(t: u32) -> str!:
        try remember(&self.cells, t)
        let half = self.checker.scratch.length // 2
        return try emission.copy_text(try strings.format(self.checker.scratch[half..], f"L_cellinfo_{t}"))

    func closure_support() -> !:
        while self.widened_done < self.widened.count:
            let t = self.widened.get(self.widened_done)
            self.widened_done += 1
            let invoke = try self.call_name(t)
            try function_effects.write(self.writer(), t, invoke)
        while self.calls_done < self.calls.count:
            let t = self.calls.get(self.calls_done)
            self.calls_done += 1
            try self.call_helper(t)
        while self.cells_done < self.cells.count:
            let t = self.cells.get(self.cells_done)
            self.cells_done += 1
            try self.cell_support(t)
        while self.thunks_done < self.thunks.count:
            let d = self.thunks.get(self.thunks_done)
            self.thunks_done += 1
            try self.thunk(d)
        while self.bounds_done < self.bounds.count:
            let e = self.bounds.get(self.bounds_done)
            self.bounds_done += 1
            try self.bound_method(e)
        while self.lambdas_done < self.lambdas.count:
            let e = self.lambdas.get(self.lambdas_done)
            self.lambdas_done += 1
            try self.lambda_object(e)

    ## `L_call_N(f, args...)`: the closure's code cast to its shape and called with the
    ## object first.
    func call_helper(t: u32) -> !:
        let ft = self.checker.table.get(t)
        try self.begin("func ")
        try self.put(try self.call_name(t))
        try self.put("(f: kernel.Closure*")
        var i: usize = 0
        while i < ft.args.length:
            try self.put(", a")
            try self.put_u64((u64)i)
            try self.put(": ")
            try self.type_of(ft.args[i])
            i += 1
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.begin("    ")
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let payload = self.checker.table.get(ft.elem).elem if fallible else ft.elem
        if payload != types.unit_id:
            try self.put("return ")
        if fallible:
            try self.put("try ")
        try self.put("((func(heap.Object*")
        i = 0
        while i < ft.args.length:
            try self.put(", ")
            try self.type_of(ft.args[i])
            i += 1
        try self.put(")")
        # a function type spells its result, `unit` included
        if ft.elem == types.unit_id:
            try self.put(" -> unit")
        elif fallible and payload == types.unit_id:
            try self.put(" -> unit!")
        else:
            try self.result_type(ft.elem)
        try self.put(")f.code)((heap.Object*)f")
        i = 0
        while i < ft.args.length:
            try self.put(", a")
            try self.put_u64((u64)i)
            i += 1
        try self.put(")")
        try self.end()
        try self.line("")

    ## ` -> R`, ` -> R!`, ` -> !`, or nothing for `unit`.
    func result_type(r: u32) -> !:
        if r == types.unit_id:
            return
        if self.checker.table.kind(r) == types.Kind.fallible and self.checker.table.get(r).elem == types.unit_id:
            try self.put(" -> !")
            return
        try self.put(" -> ")
        try self.type_of(r)

    ## The descriptor of a cell holding a `T`, and the drop and trace it calls.
    func cell_support(t: u32) -> !:
        let name = try self.cell_info_name(t)
        try self.begin("func ")
        try self.put(name)
        try self.put("_drop(o: heap.Object*):")
        try self.end()
        try self.begin("    kernel.cell_drop[")
        try self.type_of(t)
        try self.put("](o)")
        try self.end()
        try self.begin("func ")
        try self.put(name)
        try self.put("_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    kernel.cell_trace[")
        try self.type_of(t)
        try self.put("](o, visit, context)")
        try self.end()
        try self.begin("var ")
        try self.put(name)
        try self.put(": heap.Info = heap.Info(name = \"cell\", size = memory.size_of(kernel.Cell[")
        try self.type_of(t)
        try self.put("]), finish = none, drop = ")
        try self.put(name)
        try self.put("_drop, trace = ")
        try self.put(name)
        try self.put("_trace)")
        try self.end()
        try self.line("")

    ## A static callback can outlive the call into Base; captured closures cannot.
    func callback_signature(ft: types.Type) -> bool:
        let result = self.checker.table.kind(ft.elem)
        if ft.elem != types.unit_id and result != types.Kind.int_ and result != types.Kind.float_ and result != types.Kind.bool_:
            return false
        for arg in ft.args:
            let k = self.checker.table.kind(arg)
            if k != types.Kind.int_ and k != types.Kind.float_ and k != types.Kind.bool_ and k != types.Kind.str_ and k != types.Kind.bytes_:
                return false
        return true

    ## A named function as a value: a thunk taking the closure first, and an immortal
    ## closure whose code it is.
    func thunk(d: ast.Node*) -> !:
        let ft = self.checker.table.get(d.type_id)
        let name = try self.thunk_name(d, "L_thunk_")
        try self.begin("func ")
        try self.put(name)
        try self.put("(env: heap.Object*")
        var i: usize = 0
        var cursor = d.right
        while let p = cursor:
            try self.put(", L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.line("    _ = env")
        try self.begin("    ")
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let payload = self.checker.table.get(ft.elem).elem if fallible else ft.elem
        if payload != types.unit_id:
            try self.put("return ")
        if fallible:
            try self.put("try ")
        if d.has(ast.flag_base) and d.resolved != none:
            let owner = d.resolved else return
            try self.put("L_")
            try self.put(self.type_name(owner))
            try self.put("__L_" if owner.native_object != none else ".L_")
            try self.put(d.text)
        else:
            try self.put("L_")
            try self.put(try self.decl_name(d))
        try self.put("(")
        cursor = d.right
        var first = true
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            if d.has(ast.flag_base) and d.resolved == none and self.checker.table.kind(p.type_id) == types.Kind.func_ and not (p.ty else return).has(ast.flag_native_callback):
                try self.put("(")
                let callback_type = p.ty else return
                try self.boundary().base_type(callback_type, d)
                try self.put(")kernel.callback_code(L_")
                try self.put(p.text)
                try self.put(")")
            else:
                try self.put("L_")
                try self.put(p.text)
            cursor = p.next
        try self.put(")")
        try self.end()
        try self.begin("var ")
        try self.put(try self.thunk_name(d, "L_fn_"))
        try self.put(": kernel.Closure = kernel.Closure(header = heap.Object(strong = 1073741824, weak = 0, flags = heap.immortal, info = &kernel.closure_info), code = (void*)")
        try self.put(name)
        if self.callback_signature(ft):
            try self.put(", base_code = (void*)")
            try self.put(try self.callback_name(d))
        else:
            try self.put(", base_code = (void*)0")
        try self.put(")")
        try self.end()
        try self.line("")

    ## A method bound to its receiver as a value: an object holding the receiver, a thunk
    ## calling the method on it, and the constructor.
    func bound_method(e: ast.Node*) -> !:
        let receiver = e.left else return
        let m = e.resolved else return
        let name = try self.bound_name(e)
        let rt = receiver.type_id
        let owner = self.checker.table.get(rt)
        let ft = self.checker.table.get(m.type_id)
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.line("    var code: void*")
        try self.line("    var base_code: void*")
        try self.begin("    var L_self: ")
        try self.type_of(rt)
        try self.end()
        try self.line("")
        try self.bound_lifetime(name, rt)
        try self.bound_code(m, name, owner, ft)
        try self.bound_constructor(name, rt)

    ## A bound method object's drop and trace over its receiver, and its descriptor naming them.
    func bound_lifetime(name: str, rt: u32) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        if self.checker.table.has_references(rt):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", rt))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).L_self)")
            try self.end()
        else:
            try self.line("    _ = o")
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        if self.checker.table.has_references(rt):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_trace_", rt))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).L_self, visit, context)")
            try self.end()
        else:
            try self.line("    _ = o")
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"method\", size = memory.size_of(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()

    ## A bound method's code: the method called on the held receiver with the arguments passed
    ## through, by its emitted name on a class, a Luce enum, or an interface, else as a Base method.
    func bound_code(m: ast.Node*, name: str, owner: types.Type, ft: types.Type) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__code(env: heap.Object*")
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.begin("    ")
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let payload = self.checker.table.get(ft.elem).elem if fallible else ft.elem
        if payload != types.unit_id:
            try self.put("return ")
        if fallible:
            try self.put("try ")
        if owner.kind == types.Kind.class_ or (owner.kind == types.Kind.enum_ and not m.has(ast.flag_base)) or owner.kind == types.Kind.interface_:
            try self.put("L_")
            try self.put(owner.name)
            try self.put("__L_")
            try self.put(m.text)
            try self.put("(((")
            try self.put(name)
            try self.put("*)env).L_self")
            cursor = m.right
            while let p = cursor:
                if p.text != "self":
                    try self.put(", L_")
                    try self.put(p.text)
                cursor = p.next
            try self.put(")")
        else:
            try self.put("((")
            try self.put(name)
            try self.put("*)env).L_self.L_")
            try self.put(m.text)
            try self.put("(")
            cursor = m.right
            var first = true
            while let p = cursor:
                if p.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(p.text)
                cursor = p.next
            try self.put(")")
        try self.end()

    ## A bound method's constructor, taking the receiver as the object's own.
    func bound_constructor(name: str, rt: u32) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__new(L_self: ")
        try self.type_of(rt)
        try self.put(") -> kernel.Closure*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.begin("    o.code = (void*)")
        try self.put(name)
        try self.put("__code")
        try self.end()
        try self.line("    o.L_self = L_self")
        try self.line("    return (kernel.Closure*)o")
        try self.line("")

    ## A lambda: its object over its captures, the descriptor, its body as a function
    ## taking the object first, and its constructor taking the captures.
    func lambda_object(e: ast.Node*) -> !:
        let name = try self.lambda_name(e)
        let ft = self.checker.table.get(e.type_id)
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.line("    var code: void*")
        try self.line("    var base_code: void*")
        var cursor = e.left
        while let capture = cursor:
            try self.begin("    var L_")
            try self.put(capture.text)
            try self.put(": ")
            try self.capture_type(capture)
            try self.end()
            cursor = capture.next
        try self.line("")
        try self.lambda_lifetime(e, name)
        # the body, over the object first
        try self.begin("func ")
        try self.put(name)
        try self.put("__code(env: heap.Object*")
        cursor = e.right
        while let p = cursor:
            try self.put(", L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.begin("let L_env = (")
        try self.put(name)
        try self.put("*)env")
        try self.end()
        try self.line("_ = L_env")
        let saved_lambda = self.lambda
        let saved_self = self.self_name
        let saved_fallible = self.fallible
        self.lambda = e
        self.fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        var captures_self = false
        cursor = e.left
        while let capture = cursor:
            if capture.text == "self":
                captures_self = true
            cursor = capture.next
        if captures_self:
            self.self_name = "L_env.L_self"
        let body = e.body else return
        try self.site_prologue()
        if e.has(ast.flag_block_lambda):
            try self.block(body)
        else:
            try self.lambda_expression_body(body)
        try self.line("#:")
        self.lambda = saved_lambda
        self.self_name = saved_self
        self.fallible = saved_fallible
        self.indent -= 1
        try self.lambda_constructor(e, name)

    ## A lambda object's drop and trace over its captures, and its descriptor naming them.
    func lambda_lifetime(e: ast.Node*, name: str) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_env = (")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        try self.line("    _ = L_env")
        var cursor = e.left
        while let capture = cursor:
            if capture.has(ast.flag_var_field):
                try self.begin("    if (usize)L_env.L_")
                try self.put(capture.text)
                try self.put(" != 0:")
                try self.end()
                try self.begin("        heap.release((heap.Object*)L_env.L_")
                try self.put(capture.text)
                try self.put(")")
                try self.end()
            elif self.checker.table.has_references(capture.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", capture.type_id))
                try self.put("(L_env.L_")
                try self.put(capture.text)
                try self.put(")")
                try self.end()
            cursor = capture.next
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_env = (")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        try self.line("    _ = L_env")
        cursor = e.left
        while let capture = cursor:
            if capture.has(ast.flag_var_field):
                try self.begin("    if (usize)L_env.L_")
                try self.put(capture.text)
                try self.put(" != 0:")
                try self.end()
                try self.begin("        visit((heap.Object*)L_env.L_")
                try self.put(capture.text)
                try self.put(", context)")
                try self.end()
            elif self.checker.table.has_references(capture.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", capture.type_id))
                try self.put("(L_env.L_")
                try self.put(capture.text)
                try self.put(", visit, context)")
                try self.end()
            cursor = capture.next
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"closure\", size = memory.size_of(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()

    ## An expression lambda's body: its value returned, its temporaries drained first; the body
    ## is the statement a trap in it names.
    func lambda_expression_body(body: ast.Node*) -> !:
        try self.position_lines(body)
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        try self.owned(body)
        let text = try self.capture(start)
        if self.pooled:
            let r = try self.temp("result")
            try self.begin("let ")
            try self.put(r)
            try self.put(" = ")
            try self.put(text)
            try self.end()
            try self.drained(start, pooled_before)
            self.pooled = false
            try self.begin("return ")
            try self.put(r)
            try self.end()
        else:
            self.pooled = pooled_before
            try self.begin("return ")
            try self.put(text)
            try self.end()

    ## A lambda's constructor, taking every capture as the closure's own.
    func lambda_constructor(e: ast.Node*, name: str) -> !:
        try self.begin("func ")
        try self.put(name)
        try self.put("__new(")
        var cursor = e.left
        var first = true
        while let capture = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(capture.text)
            try self.put(": ")
            try self.capture_type(capture)
            cursor = capture.next
        try self.put(") -> kernel.Closure*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.begin("    o.code = (void*)")
        try self.put(name)
        try self.put("__code")
        try self.end()
        cursor = e.left
        while let capture = cursor:
            try self.begin("    o.L_")
            try self.put(capture.text)
            try self.put(" = L_")
            try self.put(capture.text)
            try self.end()
            cursor = capture.next
        try self.line("    return (kernel.Closure*)o")
        try self.line("")

    ## A captured `let`'s type, or the cell of a captured `var`.
    func capture_type(capture: ast.Node*) -> !:
        if capture.has(ast.flag_var_field):
            try self.put("kernel.Cell[")
            try self.type_of(capture.type_id)
            try self.put("]*")
            _ = try self.cell_info_name(capture.type_id)
            _ = try self.ops_name(capture.type_id)
        else:
            try self.type_of(capture.type_id)
