#==============================================================================================
#
#   base/operators - Operators
#
#   DESCRIPTION:
#       Binary operators: comparison by call, member-wise comparison, and arithmetic.
#
#==============================================================================================
extend Emitter:
    # mark: Operators ==========================================================================

    func binary(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let op = e.text
        if op == "and" or op == "or":
            try self.lazy_expression(e)
            return
        if self.has_call(l) or self.has_call(r) or self.may_fail(l) or self.may_fail(r):
            try self.hold_operand(l)
            try self.hold_operand(r)
        if op == "..<" or op == "..=":
            try self.put("kernel.range(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(", ")
            try self.put("true" if op == "..=" else "false")
            try self.put(")")
            return
        if op == "is" or op == "is not":
            # identity: the objects' addresses, none being zero (§10.2)
            try self.put("(")
            try self.identity(l)
            try self.put(" == " if op == "is" else " != ")
            try self.identity(r)
            try self.put(")")
            return
        if op == "in":
            return try self.membership(e, l, r)
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
            try self.comparison(op, l, r)
            return
        try self.arithmetic(op, e.type_id if op != "/" else l.type_id, l, r)

    ## `x in y`: a substring, a range, a list element, or a map key or set member, by the kernel.
    func membership(e: ast.Node*, l: ast.Node*, r: ast.Node*) -> !:
        let rt = self.checker.table.get(r.type_id)
        if rt.kind == types.Kind.str_:
            try self.put("kernel.contains(")
            try self.use(r)
            try self.put(", ")
            try self.use(l)
            try self.put(")")
            return
        if rt.kind == types.Kind.range_:
            try self.put("kernel.in_range(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        if rt.kind == types.Kind.list_:
            try self.put("kernel.list_contains[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(r)
            try self.put(", ")
            try self.use(l)
            try self.put(")")
            return
        if rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_:
            try self.put("kernel.map_contains[")
            try self.map_types(r.type_id)
            try self.put("](")
            try self.use(r)
            try self.put(", ")
            try self.use(l)
            try self.put(")")
            return
        return try self.fail(e, "`in` over this compiles in a later slice")

    ## `==`, `!=`, and the orderings: a presence test as Base writes it, a collection by its
    ## equality function, an `Ordered` type by `compare`, text, bytes, and tuples by a call,
    ## anything else by Base's own operator.
    func comparison(op: str, l: ast.Node*, r: ast.Node*) -> !:
        let lt = l.type_id
        if (op == "==" or op == "!=") and (is_none(l) or is_none(r)):
            # a presence test (§12.1): Base compares an optional with `none` itself
            try self.put("(")
            try self.use(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.use(r)
            try self.put(")")
            return
        if (op == "==" or op == "!=") and self.needs_equality(lt):
            # a collection compares by contents (§4.4), so does what holds one
            if op == "!=":
                try self.put("not ")
            try self.put(try self.equality_name(lt))
            try self.put("(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if (op != "==" and op != "!=") and self.protocol_method(lt, "Ordered", "compare") != none:
            try self.put("(")
            try self.put(try self.ordering_name(lt))
            try self.put("(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(") ")
            try self.put(op)
            try self.put(" 0)")
            return
        if (op != "==" and op != "!=") and (lt == types.str_id or lt == types.bytes_id or self.checker.table.kind(lt) == types.Kind.tuple):
            try self.compare_by_call(op, l, r)
            return
        try self.put("(")
        try self.expr(l)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(")")

    ## `<` and friends on text, bytes and tuples, which Base does not order itself.
    func compare_by_call(op: str, l: ast.Node*, r: ast.Node*) -> !:
        let lt = self.checker.table.get(l.type_id)
        if lt.kind == types.Kind.tuple:
            # lexicographic over the members, which are ordered scalars
            try self.put("(")
            var i: usize = 0
            while i < lt.args.length:
                if i > 0:
                    try self.put(" or (")
                var k: usize = 0
                while k < i:
                    try self.member_compare("==", l, r, lt.args[k], k)
                    try self.put(" and ")
                    k += 1
                let last = i + 1 == lt.args.length
                try self.member_compare(op if last else strict(op), l, r, lt.args[i], i)
                if i > 0:
                    try self.put(")")
                i += 1
            try self.put(")")
            return
        try self.put("(kernel.compare_blobs(" if lt.kind == types.Kind.bytes_ else "(kernel.compare_text(")
        try self.use(l)
        try self.put(", ")
        try self.use(r)
        try self.put(") ")
        try self.put(op)
        try self.put(" 0)")

    func member_compare(op: str, l: ast.Node*, r: ast.Node*, t: u32, i: usize) -> !:
        if t == types.str_id or t == types.bytes_id:
            try self.put("(kernel.compare_blobs(" if t == types.bytes_id else "(kernel.compare_text(")
            try self.expr(l)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(", ")
            try self.expr(r)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(") ")
            try self.put(op)
            try self.put(" 0)")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(")")

    ## `a op b` for the arithmetic operators (§6.2), with `t` the operands' type.
    func arithmetic(op: str, t: u32, l: ast.Node*, r: ast.Node*) -> !:
        if t == types.str_id and op == "+":
            try self.put("kernel.concat(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.bytes_id and op == "+":
            try self.put("kernel.concat_bytes(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if self.checker.table.kind(t) == types.Kind.list_ and op == "+":
            try self.put("kernel.list_concat[")
            try self.type_of(self.checker.table.get(t).elem)
            try self.put("](")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.int_id:
            if op == "/":
                try self.put("(f64(")
                try self.expr(l)
                try self.put(") / f64(")
                try self.expr(r)
                try self.put("))")
                return
            if op == "<<" or op == ">>":
                try self.put("kernel.shift_left(" if op == "<<" else "kernel.shift_right(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
            if op == "//" or op == "%" or op == "**":
                try self.put("kernel.floor_div(" if op == "//" else "kernel.floor_mod(" if op == "%" else "kernel.power(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
        if t == types.float_id and (op == "//" or op == "%" or op == "**"):
            try self.put("kernel.ffloor_div(" if op == "//" else "kernel.ffloor_mod(" if op == "%" else "kernel.fpower(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(")")
