#==============================================================================================
#
#   base/builtins - The built-in functions and specified fields
#
#   DESCRIPTION:
#       `int(text, base)`, `abs`, `min`, `max`, `round`, `ord`, `chr` and `input` (§2.4,
#       §6.5), and a formatted string's field with a specification (§3.3): a kernel call, or a
#       call of the numerals module the interpreter runs too, whose text the kernel makes a
#       `str` of its own.
#
#==============================================================================================
extend Emitter:
    # mark: Built-in functions =================================================================

    ## `int(x)` of a `float`, or `int(text, base)` read by the numerals module (§6.5).
    mutating func int_call(e: ast.Node*) -> !:
        let arg = ast.argument(e, "value") else return
        if arg.type_id == types.float_id:
            try self.put("kernel.to_int(")
            try self.use(arg)
            try self.put(")")
            return
        try self.put("kernel.parsed_int(numerals.parse_int(kernel.text_view(")
        try self.use(arg)
        try self.put("), ")
        if let base = ast.argument(e, "base"):
            try self.put("kernel.int_base(")
            try self.use(base)
            try self.put(")")
        else:
            try self.put("10")
        try self.put("))")

    ## `abs`, `min`, `max`, `round`, `ord`, `chr` and `input`, each one call.
    mutating func builtin_function(e: ast.Node*, name: str) -> !:
        if name == "min" or name == "max":
            # the first of equals, a copy of its own (kernel.pick)
            try self.put("kernel.pick[")
            try self.type_of(e.type_id)
            try self.put("](")
            try self.use(ast.argument(e, "a") else return)
            try self.put(", ")
            try self.use(ast.argument(e, "b") else return)
            try self.put(", ")
            try self.put(try self.ops_name(e.type_id))
            try self.put(", true)" if name == "min" else ", false)")
            return
        if name == "round":
            try self.put("kernel.rounded(numerals.round(")
            try self.use(ast.argument(e, "x") else return)
            try self.put(", ")
            if let digits = ast.argument(e, "digits"):
                try self.use(digits)
            else:
                try self.put("0")
            try self.put("))")
            return
        if name == "input":
            try self.put("kernel.input(")
            if let prompt = ast.argument(e, "prompt"):
                try self.use(prompt)
            else:
                try self.put(try self.text_ref("", false))
            try self.put(")")
            return
        if name == "abs":
            let x = ast.argument(e, "x") else return
            try self.put("numerals.absolute(" if x.type_id == types.float_id else "kernel.abs_int(")
            try self.use(x)
            try self.put(")")
            return
        if name == "ord":
            try self.put("kernel.ord(")
            try self.use(ast.argument(e, "text") else return)
            try self.put(")")
            return
        try self.put("kernel.owned_text(numerals.character(")
        try self.use(ast.argument(e, "code") else return)
        try self.put("), \"chr of a number that is not a Unicode scalar\")")

    ## A field with a specification (§3.3), laid out by the numerals module into a text of the
    ## statement's: an `int` or a `float` from its value, anything else from its display.
    mutating func formatted_operand(value: ast.Node*, spec: str) -> str!:
        let name = try self.temp("formatted")
        var shown = ""
        if value.type_id != types.int_id and value.type_id != types.float_id:
            shown = try self.shown_operand(value)
        let start = self.out.used
        try self.put("kernel.owned_text(numerals.")
        if value.type_id == types.int_id:
            try self.put("format_int(")
            try self.use(value)
        elif value.type_id == types.float_id:
            try self.put("format_float(")
            try self.use(value)
        else:
            try self.put("format_text(")
            try self.put(shown)
            try self.put(".data")
        try self.put(", ")
        try self.text_literal(spec, false)
        try self.put("), \"`c` formats a number that is not a Unicode scalar\")")
        let text = try self.capture(start)
        var i: u32 = 0
        while i < self.indent:
            try self.prelude.put("    ")
            i += 1
        try self.prelude.put("let ")
        try self.prelude.put(name)
        try self.prelude.put(" = ")
        try self.prelude.put(try self.lifetime_name("L_pool_", types.str_id))
        try self.prelude.put("(")
        try self.prelude.put(text)
        try self.prelude.put(")\n")
        self.pooled = true
        return name
