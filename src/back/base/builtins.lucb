#==============================================================================================
#
#   base/builtins - The standard modules' functions and specified fields
#
#   DESCRIPTION:
#       `int(text, base)` (§6.5), a value's `hash()` (§4.4), the functions of the standard
#       modules (§6.8), and a formatted string's field with a specification (§3.3): a kernel
#       call, or a call of the number_text module the interpreter runs too, whose text the kernel
#       makes a `str` of its own.
#
#==============================================================================================
extend Emitter:
    # mark: Built-in functions =================================================================

    ## `int(x)` of a `float`, or `int(text, base)` read by the number_text module (§6.5).
    func int_call(e: ast.Node*) -> !:
        let arg = ast.argument(e, "value") else return
        if arg.type_id == types.float_id:
            try self.put("kernel.to_int(")
            try self.use(arg)
            try self.put(")")
            return
        try self.put("kernel.parsed_int(number_text.parse_int(kernel.text_view(")
        try self.use(arg)
        try self.put("), ")
        if let base = ast.argument(e, "base"):
            try self.put("kernel.int_base(")
            try self.use(base)
            try self.put(")")
        else:
            try self.put("10")
        try self.put("))")

    ## `value.hash()`: the runtime's hash of the value's type (§4.4).
    func hash_method(callee: ast.Node*) -> !:
        let receiver = callee.left else return
        try self.put("(i64)")
        try self.put(try self.hash_name(receiver.type_id))
        try self.put("(")
        try self.use(receiver)
        try self.put(")")

    ## `math.abs`, `math.min`, `math.max`, `math.round`, `text.code_of`, `text.from_code`,
    ## `console.read_line` and `time`'s functions (§6.8), each one call.
    func standard_function(e: ast.Node*, name: str) -> !:
        if name == "math.min" or name == "math.max":
            # the first of equals, a copy of its own (kernel.pick)
            try self.put("kernel.pick[")
            try self.type_of(e.type_id)
            try self.put("](")
            try self.use(ast.argument(e, "a") else return)
            try self.put(", ")
            try self.use(ast.argument(e, "b") else return)
            try self.put(", ")
            try self.put(try self.ops_name(e.type_id))
            try self.put(", true)" if name == "math.min" else ", false)")
            return
        if name == "math.round":
            try self.put("kernel.rounded(number_text.round(")
            try self.use(ast.argument(e, "x") else return)
            try self.put(", ")
            if let digits = ast.argument(e, "digits"):
                try self.use(digits)
            else:
                try self.put("0")
            try self.put("))")
            return
        if name == "time.sleep":
            let seconds = ast.argument(e, "seconds") else return
            try self.put("kernel.sleep(number_text.sleep_milliseconds(")
            if seconds.type_id == types.int_id:
                try self.put("f64(")
                try self.use(seconds)
                try self.put(")")
            else:
                try self.use(seconds)
            try self.put("))")
            return
        if name == "time.now" or name == "time.unix":
            try self.put("kernel.now()" if name == "time.now" else "kernel.unix()")
            return
        if name == "console.read_line":
            try self.put("kernel.read_line(")
            if let prompt = ast.argument(e, "prompt"):
                try self.use(prompt)
            else:
                try self.put(try self.text_ref("", false))
            try self.put(")")
            return
        if name == "math.abs":
            let x = ast.argument(e, "x") else return
            try self.put("number_text.absolute(" if x.type_id == types.float_id else "kernel.abs_int(")
            try self.use(x)
            try self.put(")")
            return
        if name == "text.code_of":
            try self.put("kernel.code_of(")
            try self.use(ast.argument(e, "s") else return)
            try self.put(")")
            return
        try self.put("kernel.owned_text(number_text.character(")
        try self.use(ast.argument(e, "n") else return)
        try self.put("), \"text.from_code of a number that is not a Unicode scalar\")")

    ## A field with a specification (§3.3), laid out by the number_text module into a text of the
    ## statement's: an `int` or a `float` from its value, anything else from its display.
    func formatted_operand(value: ast.Node*, spec: str) -> str!:
        let name = try self.temp("formatted")
        var shown = ""
        if value.type_id != types.int_id and value.type_id != types.float_id:
            shown = try self.shown_operand(value)
        let start = self.out.used
        try self.put("kernel.owned_text(number_text.")
        if value.type_id == types.int_id:
            try self.put("format_int(")
            try self.use(value)
        elif value.type_id == types.float_id:
            try self.put("format_float(")
            try self.use(value)
        else:
            try self.put("format_text(")
            try self.put(shown)
            try self.put(".data")
        try self.put(", ")
        try self.text_literal(spec, false)
        try self.put("), \"`c` formats a number that is not a Unicode scalar\")")
        let text = try self.capture(start)
        var i: u32 = 0
        while i < self.indent:
            try self.prelude.put("    ")
            i += 1
        try self.prelude.put("let ")
        try self.prelude.put(name)
        try self.prelude.put(" = ")
        try self.prelude.put(try self.lifetime_name("L_pool_", types.str_id))
        try self.prelude.put("(")
        try self.prelude.put(text)
        try self.prelude.put(")\n")
        self.pooled = true
        return name
