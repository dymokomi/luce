#==============================================================================================
#
#   package - The Base package a build hands to luce-base
#
#   DESCRIPTION:
#       A directory with a manifest, the runtime's modules under `rt/`, and the program as
#       `main.lucb`; then luce-base compiles it. The manifest carries the Luce package's
#       name, so `ErrorCode.package(n)` folds to the same value the interpreter computes. The
#       Base compiler is the one `LUCE_BASE` names, or `luce-base` on the path.
#
#==============================================================================================

import c
import files
import io
import memory
import os
import paths
import process
import support.runtime
import support.buffer
import back.sources
import back.workspace

## Room for the message naming a Base compiler that cannot be run.
var scratch: u8[512]

pub let build_failed: ErrorCode = ErrorCode.package(16)

## Write the package under `dir`.
pub func write(dir: str, package_name: str, program: str, entry_name: str = "main", runtime_namespace: str = "rt", native_configuration: str = "") -> !:
    try make_directory(dir)
    let rt_dir = try paths.join(dir, runtime_namespace)
    try make_directory(rt_dir)
    var manifest: u8[256]
    let toml = try format(manifest, f"[package]\nname = \"{package_name}\"\nsource = \".\"\n")
    let configured = try alloc u8[toml.length + native_configuration.length]
    memory.copy(configured, toml.bytes, toml.length)
    memory.copy(configured[toml.length..], native_configuration.bytes, native_configuration.length)
    try files.write(try c_path(try paths.join(dir, "luce.toml")), configured)
    var i: usize = 0
    while i < runtime.count:
        try files.write(try c_path(try paths.join(rt_dir, runtime.names[i])), runtime.sources[i].bytes)
        i += 1
    try files.write(try c_path(try entry_path(dir, entry_name)), program.bytes)

pub func entry_path(dir: str, name: str) -> str!:
    var storage: u8[128]
    return try paths.join(dir, try format(storage, f"{name}.lucb"))

pub func write_sources(dir: str, collected: sources.SourceSet) -> !:
    var index: usize = 0
    while index < collected.entries.count:
        let item = collected.entries.get(index)
        try write_module(dir, item.name, item.data)
        index += 1
    if collected.exports.count > 0 or collected.module_packages.count > 0:
        let path = try paths.join(dir, "luce.toml")
        let manifest = (str)try files.read(try c_path(path))
        var out = try buffer.Buffer.create(manifest.length + collected.exports.count * 64)
        defer out.destroy()
        try out.put(manifest)
        if collected.exports.count > 0:
            try out.put("\n[exports]\n")
            for item in collected.exports.span():
                try out.write(f"{item.name} = \"{item.target}\"\n")
        if collected.module_packages.count > 0:
            try out.put("\n[module_packages]\n")
            for item in collected.module_packages.span():
                try out.write(f"{item.name} = \"{item.target}\"\n")
        try files.write(try c_path(path), out.bytes())


## A Base module the program imports (§16), copied into the package under its dotted
## name, `a.b` as `a/b.lucb`, where the emitted `import a.b` finds it.
pub func write_module(dir: str, name: str, data: const u8[]) -> !:
    var relative = try alloc u8[name.length + 5]
    var i: usize = 0
    while i < name.length:
        relative[i] = '/' if name.bytes[i] == '.' else name.bytes[i]
        i += 1
    memory.copy(relative[name.length..], ".lucb".bytes, 5)
    let target = try paths.join(dir, (str)relative)
    let parent = paths.directory(target)
    if parent.length > 0 and parent != dir:
        try make_directory(parent)
    try files.write(try c_path(target), data)

## Compile the package with luce-base into `output`; `flags` are luce-base's own.
func compile(dir: str, output: str, flags: const str[], entry_name: str = "main") -> !:
    let base = os.env("LUCE_BASE") else "luce-base"
    let entry = try entry_path(dir, entry_name)
    var args = try alloc c.str[6 + flags.length]
    args[0] = "build"
    args[1] = try c_path(entry)
    args[2] = "--native"
    args[3] = "-o"
    args[4] = try c_path(output)
    var n: usize = 5
    for f in flags:
        args[n] = try c_path(f)
        n += 1
    let (status, out, err) = try process.run(try c_path(base), args[..<n])
    defer process.release(out)
    defer process.release(err)
    if status == 127 and out.length == 0 and err.length == 0:
        # `process.run` exits 127 when the program cannot be started
        error(build_failed, try format(scratch, f"the Base compiler `{base}` cannot be run; `LUCE_BASE` names it"))
    if status != 0:
        var e = io.stderr()
        discard(try e.write(out.bytes))
        discard(try e.write(err.bytes))
        error(build_failed, "the Base compiler refused the emitted program; `--emit=base` keeps it to read")

## Generated Base and copied dependencies belong to this build, on both success
## and failure. Only the requested output and Base's explicit outputs persist.
pub func build(output: str, package_name: str, program: str, collected: sources.SourceSet, flags: const str[], entry_name: str, runtime_namespace: str, native_configuration: str = "") -> !:
    try make_directory(paths.directory(output))
    var temporary = try workspace.Workspace.create()
    defer temporary.destroy()
    try write(temporary.path, package_name, program, entry_name, runtime_namespace, native_configuration)
    try write_sources(temporary.path, collected)
    try compile(temporary.path, output, flags, entry_name)
    try temporary.close()

func make_directory(dir: str) -> !:
    let (status, out, err) = try process.run("mkdir", [(c.str)"-p", try c_path(dir)])
    process.release(out)
    process.release(err)
    if status != 0:
        error(build_failed, "cannot create the build directory")

## A NUL-terminated copy of `text` for the C calls.
func c_path(text: str) -> c.str!:
    var out = try alloc u8[text.length + 1]
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    out[text.length] = 0
    return (c.str)out.data
