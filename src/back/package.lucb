#==============================================================================================
#
#   package - The Base package a build hands to luce-base
#
#   DESCRIPTION:
#       A directory with a manifest, the runtime's modules under `rt/`, and the program as
#       `main.lucb`; then luce-base compiles it. The manifest carries the Luce package's
#       name, so `ErrorCode.package(n)` folds to the same value the interpreter computes. The
#       Base compiler is the one `support.toolchain` finds: `LUCE_BASE`, the one beside `luce`, the path.
#
#==============================================================================================

import support.c_text
import c
import luce_std.files
import io
import memory
import os
import luce_std.paths
import luce_std.process
import strings
import support.runtime
import support.toolchain
import support.buffer
import support.list
import back.sources
import back.workspace

## Room for the message naming a Base compiler that cannot be run.
var scratch: u8[512]

pub let build_failed: ErrorCode = ErrorCode.package(16)

## Write the package under `dir`.
pub func write(dir: str, package_name: str, program: str, entry_name: str = "main", runtime_namespace: str = "rt") -> !:
    try make_directory(dir)
    let rt_dir = try paths.join(dir, runtime_namespace)
    try make_directory(rt_dir)
    var manifest: u8[256]
    let definition = try format(manifest, f"#prisma 4.0\ndef package \"{package_name}\" {{\n    str source = \".\"\n}}\n")
    try files.write(try c_text.copy(try paths.join(dir, "package.prisma")), definition.bytes)
    var i: usize = 0
    while i < runtime.count:
        try files.write(try c_text.copy(try paths.join(rt_dir, runtime.names[i])), runtime.sources[i].bytes)
        i += 1
    try files.write(try c_text.copy(try entry_path(dir, entry_name)), program.bytes)

pub func entry_path(dir: str, name: str) -> str!:
    var storage: u8[128]
    return try paths.join(dir, try format(storage, f"{name}.lucb"))

## Each Base module the program reaches, in the package it comes from (base.md §16.3): the
## building package's at the package root under its bare name, every other package's in
## `deps/<identifier>/` with a manifest of its own. The package names each generated one as
## a dependency, and so does every generated one name the others, so every import, the
## emitted program's `import luce_ui.ui` and luce-ui's own `import painter` alike, resolves
## as it does in the packages themselves, and every module keeps its package's error-code
## identity. Every module of a generated package is public there: Base checked what the
## program may import when it resolved the program's imports against the real manifests.
pub func write_sources(dir: str, collected: sources.SourceSet, package_name: str) -> !:
    let building = try identifier(package_name)
    var owners = try list.List[str].create(4)
    defer owners.destroy()
    for item in collected.entries.span():
        let owner = collected.package_of(item.name) else building
        if owner == building or not strings.starts_with(item.name, try strings.join([owner, "."], "")):
            try write_module(dir, item.name, item.data)
            continue
        try write_module(try dependency_root(dir, owner), (str)item.name.bytes[owner.length + 1..], item.data)
        var known = false
        for listed in owners.span():
            known = known or listed == owner
        if not known:
            try owners.push(owner)
    for owner in owners.span():
        var out = try buffer.Buffer.create(1024)
        defer out.destroy()
        try out.write(f"#prisma 4.0\ndef package \"{owner}\" {{\n    str source = \".\"\n    str[] public = [")
        var first = true
        let prefix = try strings.join([owner, "."], "")
        for item in collected.entries.span():
            let module_owner = collected.package_of(item.name) else building
            if module_owner == owner and strings.starts_with(item.name, prefix):
                try out.write(f"{"" if first else ", "}\"{(str)item.name.bytes[prefix.length..]}\"")
                first = false
        try out.put("]\n")
        for other in owners.span():
            if other != owner:
                try out.write(f"    def dependency \"{other}\" {{\n        str path = \"../{other}\"\n    }}\n")
        try out.put("}\n")
        try files.write(try c_text.copy(try paths.join(try dependency_root(dir, owner), "package.prisma")), out.bytes())
    if owners.count > 0 or collected.native_inputs.entries.count > 0:
        # Reopen the package element written by `write` and add the elements the build needs.
        let path = try paths.join(dir, "package.prisma")
        let manifest = (str)try files.read(try c_text.copy(path))
        var out = try buffer.Buffer.create(manifest.length + owners.count * 96 + 1024)
        defer out.destroy()
        var body = manifest
        while body.length > 0 and (body.bytes[body.length - 1] == '\n' or body.bytes[body.length - 1] == '}'):
            body = (str)body.bytes[..<body.length - 1]
        try out.put(body)
        try out.put("\n")
        try collected.native_inputs.write(&out)
        for owner in owners.span():
            try out.write(f"    def dependency \"{owner}\" {{\n        str path = \"deps/{owner}\"\n    }}\n")
        try out.put("}\n")
        try files.write(try c_text.copy(path), out.bytes())

## Where a generated dependency package lives in the package at `dir`.
func dependency_root(dir: str, owner: str) -> str!:
    return try paths.join(try paths.join(dir, "deps"), owner)

## `luce-ui` as the identifier `luce_ui`, which names the package in imports (base.md §16.4).
func identifier(name: str) -> str!:
    let copy = try alloc u8[name.length]
    for k in 0..<name.length:
        copy[k] = '_' if name.bytes[k] == '-' else name.bytes[k]
    return (str)copy

## A Base module the program imports (§16), copied into the package under its dotted
## name, `a.b` as `a/b.lucb`, where the emitted `import a.b` finds it.
pub func write_module(dir: str, name: str, data: const u8[]) -> !:
    var relative = try alloc u8[name.length + 5]
    var i: usize = 0
    while i < name.length:
        relative[i] = '/' if name.bytes[i] == '.' else name.bytes[i]
        i += 1
    memory.copy(relative[name.length..], ".lucb".bytes, 5)
    let target = try paths.join(dir, (str)relative)
    let parent = paths.directory(target)
    if parent.length > 0:
        try make_directory(parent)
    try files.write(try c_text.copy(target), data)

## Compile the package with luce-base into `output`; `flags` are luce-base's own.
##
## luce-base runs inside the package and is given its entry by a relative name, so nothing
## it builds names the workspace, which is new each build: the same program then has the
## same build-cache key every time (base.md §19.7), kept in `build_cache()` rather than
## under the workspace, where it would go with it. The output and any `-L` directory are
## made absolute first, since they were named from where luce was run.
func compile(dir: str, output: str, flags: const str[], entry_name: str = "main") -> !:
    let base = (str)(try toolchain.base_compiler())
    var entry_room: u8[160]
    let entry = try format(entry_room, f"{entry_name}.lucb")
    var args = try alloc c.str[8 + flags.length]
    args[0] = "build"
    args[1] = try c_text.copy(entry)
    args[2] = "--native"
    args[3] = "-o"
    args[4] = try c_text.copy(try absolute(output))
    var n: usize = 5
    let cache = try build_cache(flags)
    if let chosen = cache:
        args[n] = "--cache-dir"
        args[n + 1] = try c_text.copy(chosen)
        n += 2
    for f in flags:
        if f.length > 2 and strings.starts_with(f, "-L") and not paths.is_absolute((str)f.bytes[2..]):
            args[n] = try c_text.copy(try strings.join(["-L", try absolute((str)f.bytes[2..])], ""))
        else:
            args[n] = try c_text.copy(f)
        n += 1
    let (status, out, err) = try process.run(try c_text.copy(base), args[..<n], try c_text.copy(dir))
    defer process.release(out)
    defer process.release(err)
    if status == 127 and out.length == 0 and err.length == 0:
        # `process.run` exits 127 when the program cannot be started
        error(build_failed, try format(scratch, f"the Base compiler `{base}` cannot be run; `LUCE_BASE` names it"))
    if status != 0:
        var e = io.stderr()
        discard(try e.write(out.bytes))
        discard(try e.write(err.bytes))
        error(build_failed, "the Base compiler refused the emitted program; `--emit=base` keeps it to read")
    # the user's cache is shared by every project luce builds: kept within its limit here
    if let chosen = cache:
        trim(chosen) catch ignored:
            discard(ignored)

## Generated Base and copied dependencies belong to this build, on both success
## and failure. Only the requested output and Base's explicit outputs persist.
pub func build(output: str, package_name: str, program: str, collected: sources.SourceSet, flags: const str[], entry_name: str, runtime_namespace: str) -> !:
    try make_directory(paths.directory(output))
    var temporary = try workspace.Workspace()
    defer temporary.destroy()
    try write(temporary.path(), package_name, program, entry_name, runtime_namespace)
    try write_sources(temporary.path(), collected, package_name)
    try compile(temporary.path(), output, flags, entry_name)
    try temporary.close()

## `path` from where luce was run, when it is not absolute already.
func absolute(path: str) -> str!:
    if paths.is_absolute(path):
        return path
    return try paths.join(try os.cwd(), path)

## Where luce-base keeps built objects for Luce builds: none when the build or the
## environment chooses (`--cache-dir`, `LUCE_CACHE`, which luce-base reads itself); else
## the user's: `%LOCALAPPDATA%\luce\cache` on Windows, `~/.luce/cache` elsewhere, made when
## missing. luce-base keeps each object under the hash of everything that made it; luce
## keeps the cache within `LUCE_CACHE_LIMIT` (`trim`).
func build_cache(flags: const str[]) -> str?!:
    for f in flags:
        if f == "--cache-dir":
            return none
    if let chosen = os.env("LUCE_CACHE"):
        discard(chosen)
        return none
    let home = os.env("LOCALAPPDATA" if os.windows else "HOME") else return none
    if home.length == 0:
        return none
    let dir = try paths.join(home, "luce/cache" if os.windows else ".luce/cache")
    try make_directory(dir)
    return dir

## The most the user's build cache may hold, in bytes: `LUCE_CACHE_LIMIT` megabytes, else 4096.
func cache_limit() -> i64:
    if let text = os.env("LUCE_CACHE_LIMIT"):
        var megabytes: i64 = 0
        for byte in text.bytes:
            if byte < '0' or byte > '9':
                return 4096 * 1048576
            megabytes = megabytes *% 10 +% (i64)(byte - '0')
        return megabytes *% 1048576
    return 4096 * 1048576

## Keep the cache at `dir` within `cache_limit()`: past it, remove the objects written
## longest ago until it fits. Only objects count; a build's staging directory and anything
## else there is left alone.
func trim(dir: str) -> !:
    let names = try files.list(try c_text.copy(dir))
    defer files.release_list(names)
    var objects = try alloc str[names.length]
    var sizes = try alloc i64[names.length]
    var times = try alloc i64[names.length]
    var count: usize = 0
    var total: i64 = 0
    for name in names:
        if not strings.ends_with(name, ".o"):
            continue
        let path = try paths.join(dir, name)
        let info = files.metadata(try c_text.copy(path)) catch:
            continue
        if info.kind != files.FileKind.regular:
            continue
        objects[count] = path
        sizes[count] = info.size
        times[count] = info.modified.seconds
        total += info.size
        count += 1
    let most = cache_limit()
    while total > most:
        var oldest: usize = count
        for i in 0..<count:
            if sizes[i] >= 0 and (oldest == count or times[i] < times[oldest]):
                oldest = i
        if oldest == count:
            return
        files.remove_file(try c_text.copy(objects[oldest])) catch ignored:
            discard(ignored)
        total -= sizes[oldest]
        sizes[oldest] = -1

func make_directory(dir: str) -> !:
    if files.exists(try c_text.copy(dir)):
        let info = try files.metadata(try c_text.copy(dir))
        if info.kind != files.FileKind.directory:
            error(build_failed, "the build output directory is not a directory")
        return
    let parent = paths.directory(dir)
    if parent != dir:
        try make_directory(parent)
    files.create_directory(try c_text.copy(dir)) catch failure:
        if failure.code != files.already_exists:
            error(failure.code, failure.message)
