#==============================================================================================
#
#   package - The Base package a build hands to luce-base
#
#   DESCRIPTION:
#       A directory with a manifest, the runtime's modules under `rt/`, and the program as
#       `main.lucb`; then luce-base compiles it. The manifest carries the Luce package's
#       name, so `ErrorCode.package(n)` folds to the same value the interpreter computes. The
#       Base compiler is the one `support.toolchain` finds: `LUCE_BASE`, the one beside `luce`, the path.
#
#==============================================================================================

import c
import files
import io
import memory
import os
import paths
import process
import strings
import support.runtime
import support.toolchain
import support.buffer
import back.sources
import back.workspace

## Room for the message naming a Base compiler that cannot be run.
var scratch: u8[512]

pub let build_failed: ErrorCode = ErrorCode.package(16)

## Write the package under `dir`.
pub func write(dir: str, package_name: str, program: str, entry_name: str = "main", runtime_namespace: str = "rt") -> !:
    try make_directory(dir)
    let rt_dir = try paths.join(dir, runtime_namespace)
    try make_directory(rt_dir)
    var manifest: u8[256]
    let definition = try format(manifest, f"#prisma 4.0\ndef package \"{package_name}\" {{\n    str source = \".\"\n}}\n")
    try files.write(try c_path(try paths.join(dir, "package.prisma")), definition.bytes)
    var i: usize = 0
    while i < runtime.count:
        try files.write(try c_path(try paths.join(rt_dir, runtime.names[i])), runtime.sources[i].bytes)
        i += 1
    try files.write(try c_path(try entry_path(dir, entry_name)), program.bytes)

pub func entry_path(dir: str, name: str) -> str!:
    var storage: u8[128]
    return try paths.join(dir, try format(storage, f"{name}.lucb"))

pub func write_sources(dir: str, collected: sources.SourceSet) -> !:
    var index: usize = 0
    while index < collected.entries.count:
        let item = collected.entries.get(index)
        try write_module(dir, item.name, item.data)
        index += 1
    if collected.exports.count > 0 or collected.module_packages.count > 0 or collected.native_inputs.entries.count > 0:
        # Reopen the package element written by `write` and add the elements the bundle needs.
        let path = try paths.join(dir, "package.prisma")
        let manifest = (str)try files.read(try c_path(path))
        var out = try buffer.Buffer.create(manifest.length + collected.exports.count * 96 + 1024)
        defer out.destroy()
        var body = manifest
        while body.length > 0 and (body.bytes[body.length - 1] == '\n' or body.bytes[body.length - 1] == '}'):
            body = (str)body.bytes[..<body.length - 1]
        try out.put(body)
        try out.put("\n")
        try collected.native_inputs.write(&out)
        for item in collected.exports.span():
            try out.write(f"    def export \"{item.name}\" {{\n        str module = \"{item.target}\"\n    }}\n")
        for item in collected.module_packages.span():
            try out.write(f"    def module_package \"{item.name}\" {{\n        str package = \"{item.target}\"\n    }}\n")
        try out.put("}\n")
        try files.write(try c_path(path), out.bytes())


## A Base module the program imports (§16), copied into the package under its dotted
## name, `a.b` as `a/b.lucb`, where the emitted `import a.b` finds it.
pub func write_module(dir: str, name: str, data: const u8[]) -> !:
    var relative = try alloc u8[name.length + 5]
    var i: usize = 0
    while i < name.length:
        relative[i] = '/' if name.bytes[i] == '.' else name.bytes[i]
        i += 1
    memory.copy(relative[name.length..], ".lucb".bytes, 5)
    let target = try paths.join(dir, (str)relative)
    let parent = paths.directory(target)
    if parent.length > 0 and parent != dir:
        try make_directory(parent)
    try files.write(try c_path(target), data)

## Compile the package with luce-base into `output`; `flags` are luce-base's own.
##
## luce-base runs inside the package and is given its entry by a relative name, so nothing
## it builds names the workspace, which is new each build: the same program then has the
## same build-cache key every time (base.md §19.7), kept in `build_cache()` rather than
## under the workspace, where it would go with it. The output and any `-L` directory are
## made absolute first, since they were named from where luce was run.
func compile(dir: str, output: str, flags: const str[], entry_name: str = "main") -> !:
    let base = (str)(try toolchain.base_compiler())
    var entry_room: u8[160]
    let entry = try format(entry_room, f"{entry_name}.lucb")
    var args = try alloc c.str[8 + flags.length]
    args[0] = "build"
    args[1] = try c_path(entry)
    args[2] = "--native"
    args[3] = "-o"
    args[4] = try c_path(try absolute(output))
    var n: usize = 5
    if let cache = try build_cache(flags):
        args[n] = "--cache-dir"
        args[n + 1] = try c_path(cache)
        n += 2
    for f in flags:
        if f.length > 2 and strings.starts_with(f, "-L") and not paths.is_absolute((str)f.bytes[2..]):
            args[n] = try c_path(try strings.join(["-L", try absolute((str)f.bytes[2..])], ""))
        else:
            args[n] = try c_path(f)
        n += 1
    let (status, out, err) = try process.run(try c_path(base), args[..<n], try c_path(dir))
    defer process.release(out)
    defer process.release(err)
    if status == 127 and out.length == 0 and err.length == 0:
        # `process.run` exits 127 when the program cannot be started
        error(build_failed, try format(scratch, f"the Base compiler `{base}` cannot be run; `LUCE_BASE` names it"))
    if status != 0:
        var e = io.stderr()
        discard(try e.write(out.bytes))
        discard(try e.write(err.bytes))
        error(build_failed, "the Base compiler refused the emitted program; `--emit=base` keeps it to read")

## Generated Base and copied dependencies belong to this build, on both success
## and failure. Only the requested output and Base's explicit outputs persist.
pub func build(output: str, package_name: str, program: str, collected: sources.SourceSet, flags: const str[], entry_name: str, runtime_namespace: str) -> !:
    try make_directory(paths.directory(output))
    var temporary = try workspace.Workspace()
    defer temporary.destroy()
    try write(temporary.path(), package_name, program, entry_name, runtime_namespace)
    try write_sources(temporary.path(), collected)
    try compile(temporary.path(), output, flags, entry_name)
    try temporary.close()

## `path` from where luce was run, when it is not absolute already.
func absolute(path: str) -> str!:
    if paths.is_absolute(path):
        return path
    return try paths.join(try os.cwd(), path)

## Where luce-base keeps built objects for Luce builds: none when the build or the
## environment chooses (`--cache-dir`, `LUCE_CACHE`, which luce-base reads itself); else
## the user's: `%LOCALAPPDATA%\luce\cache` on Windows, `~/.luce/cache` elsewhere, made when
## missing. luce-base keeps each object under the hash of everything that made it and
## trims the oldest past its limit.
func build_cache(flags: const str[]) -> str?!:
    for f in flags:
        if f == "--cache-dir":
            return none
    if let chosen = os.env("LUCE_CACHE"):
        discard(chosen)
        return none
    let home = os.env("LOCALAPPDATA" if os.windows else "HOME") else return none
    if home.length == 0:
        return none
    let dir = try paths.join(home, "luce/cache" if os.windows else ".luce/cache")
    try make_directory(dir)
    return dir

func make_directory(dir: str) -> !:
    if files.exists(try c_path(dir)):
        let info = try files.metadata(try c_path(dir))
        if info.kind != files.FileKind.directory:
            error(build_failed, "the build output directory is not a directory")
        return
    let parent = paths.directory(dir)
    if parent != dir:
        try make_directory(parent)
    files.create_directory(try c_path(dir)) catch failure:
        if failure.code != files.already_exists:
            error(failure.code, failure.message)

## A NUL-terminated copy of `text` for the C calls.
func c_path(text: str) -> c.str!:
    var out = try alloc u8[text.length + 1]
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    out[text.length] = 0
    return (c.str)out.data
