## A build owns one uniquely created temporary directory. Normal compilation
## removes the generated package; explicit source emission bypasses this owner.
import c
import files
import io
import os
import paths
import strings

extern func mkdtemp(pattern: c.str) -> c.str?

pub struct Workspace:
    pub var path: str

    pub static func create() -> Workspace!:
        var parent = os.env("TMPDIR") else "/tmp"
        if parent.length == 0:
            parent = "/tmp"
        let name = try paths.join(parent, "luce-build-XXXXXX")
        errdefer strings.release(name)
        if mkdtemp((c.str)name) == none:
            error(files.failed, "cannot create a temporary build directory")
        return Workspace(path = name)

    ## Report cleanup failures on the successful build path. Only this invocation's
    ## directory is owned; an existing output.base directory is never adopted.
    pub mutating func close() -> !:
        if self.path.length == 0:
            return
        try remove_tree(self.path)
        strings.release(self.path)
        self.path = ""

    ## Preserve a compilation failure while still attempting cleanup and reporting
    ## an OS refusal. Generated files contain no state needed by a later build.
    pub mutating func destroy():
        self.close() catch failure:
            discard(io.stderr().write(f"luce: cannot remove temporary build directory {self.path}: {failure.message}\n") catch:
                recover 0)
            strings.release(self.path)
            self.path = ""

## Walk only real directories. A symlink produced by a tool is an entry to unlink,
## including a dangling link; its target is never part of the workspace's ownership.
func remove_tree(path: str) -> !:
    let names = try files.list((c.str)path)
    defer files.release_list(names)
    for name in names:
        let child = try paths.join(path, name)
        defer strings.release(child)
        let info = try files.metadata((c.str)child, follow_symlinks = false)
        if info.kind == files.FileKind.directory:
            try remove_tree(child)
        else:
            try files.remove_file((c.str)child)
    try files.remove_directory((c.str)path)
