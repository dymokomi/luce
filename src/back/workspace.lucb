## Compiler ownership and cleanup diagnostics; directory mechanics belong to files.
import files
import io

pub struct Workspace:
    var directory: files.TemporaryDirectory

    pub func init() -> !:
        self.directory = try files.TemporaryDirectory()

    pub func path() -> str:
        return self.directory.path()

    ## Successful builds report cleanup failures and retain ownership for retry.
    pub mutating func close() -> !:
        try self.directory.close()

    ## Preserve the original build failure while reporting a refused cleanup.
    pub mutating func destroy():
        self.close() catch failure:
            discard(io.stderr().write(f"luce: cannot remove temporary build directory {self.path()}: {failure.message}\n") catch:
                recover 0)
            self.directory.destroy()
