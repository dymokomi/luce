## Function effect conversion has its own entry point, never a cast between
## incompatible result conventions. The runtime wrapper retains the source closure.
import back.emission
import sema.types

pub func write(out: emission.Writer, source: u32, invoke: str) -> !:
    let signature = out.checker.table.get(source)
    try out.out.write(f"func L_widen_{source}(env: heap.Object*")
    var i: usize = 0
    while i < signature.args.length:
        try out.out.write(f", a{i}: ")
        try out.type_of(signature.args[i])
        i += 1
    try out.put(") -> ")
    try out.type_of(signature.elem)
    try out.put("!:\n    ")
    if signature.elem != types.unit_id:
        try out.put("return ")
    try out.out.write(f"{invoke}(((kernel.FallibleClosure*)env).inner")
    i = 0
    while i < signature.args.length:
        try out.out.write(f", a{i}")
        i += 1
    try out.put(")\n\n")
