#==============================================================================================
#
#   emission - The writer the emitter and native adapters share
#
#   DESCRIPTION:
#       Shared output and type spelling for the program emitter and native adapters.
#       This borrowed writer holds no compilation work beyond the lifetime registrations
#       needed by its callers; it never evaluates an application expression.
#
#==============================================================================================
import front.ast
import sema.check
import sema.types
import support.buffer
import support.list
import strings

## A construct the backend has no lowering for.
pub let unsupported: ErrorCode = ErrorCode.package(15)

# mark: The writer ============================================================================

## A view of an emitter's output and indentation, so the program emitter and the
## native adapters write through one set of spellings.
pub struct Writer:
    ## The checked program, for its types, modules, and scratch space.
    pub let checker: check.Checker*
    ## Where the generated Base source goes.
    pub let out: buffer.Buffer*
    ## The current indentation in levels of four spaces, the emitter's own.
    pub let indent: u32*
    ## The types whose copy, drop, trace or pool functions are emitted after the
    ## program, the emitter's own list.
    pub let lifetimes: list.List[u32]*
    ## The element types whose operations tables are emitted after the program.
    pub let ops_types: list.List[u32]*

    ## Writes `text` as is.
    pub func put(text: str) -> !:
        try self.out.put(text)

    ## Writes `text` as one indented line.
    pub func line(text: str) -> !:
        try self.begin(text)
        try self.end()

    ## Starts an indented line with `text`; `end` finishes it.
    pub func begin(text: str) -> !:
        var i: u32 = 0
        while i < (*self.indent):
            try self.out.put("    ")
            i += 1
        try self.out.put(text)

    ## Finishes the line `begin` started.
    pub func end() -> !:
        try self.out.put("\n")

    ## A diagnostic at `node`, through the checker.
    pub func fail(node: ast.Node*, what: str) -> never!:
        return try self.checker.fail(node, what)

    ## Takes what was written since `start` back out of the output, as a copy.
    pub func take_output(start: usize) -> str!:
        let text = try copy_text((str)self.out.bytes()[start..])
        self.out.used = start
        return text

    ## Writes the Base spelling of a Luce type: scalars directly, the runtime's
    ## kernel types for text, bytes and collections, `L_` names for declared types.
    pub func type_of(id: u32) -> !:
        let t = self.checker.table.get(id)
        match t.kind:
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("kernel.Text*")
            .bytes_: try self.put("kernel.Bytes*")
            .unit_: try self.put("unit")
            .never_: try self.put("never")
            .error_code: try self.put("ErrorCode")
            .error_value: try self.put("kernel.Failure")
            .range_: try self.put("kernel.Range")
            .optional:
                try self.type_of(t.elem)
                try self.put("?")
            .fallible:
                if t.elem == types.unit_id:
                    try self.put("!")
                else:
                    try self.type_of(t.elem)
                    try self.put("!")
            .tuple:
                try self.put("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                if t.args.length == 1:
                    try self.put(",")  # `(T,)`, a tuple of one; `(T)` is `T` grouped
                try self.put(")")
            .func_:
                try self.put("kernel.Closure*")
            .list_:
                try self.put("kernel.List[")
                try self.type_of(t.elem)
                try self.put("]*")
            .map_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", ")
                try self.type_of(self.checker.table.map_value(id))
                try self.put("]*")
            .set_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", u8]*")
            .struct_, .enum_:
                try self.put("L_")
                try self.put(t.name)
            .class_, .interface_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("*")
            .weak_:
                try self.put("heap.Weak")
            .task_:
                try self.put("kernel.TaskOf[")
                try self.type_of(self.task_payload(id))
                try self.put("]*")
            _:
                error(unsupported, "a type this slice does not compile")

    ## The name `prefix` + `t` of a lifetime function of type `t`, registering
    ## `t` so the function is emitted after the program.
    pub func lifetime_name(prefix: str, t: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.lifetimes.count:
            if self.lifetimes.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.lifetimes.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_text(try strings.format(self.checker.scratch[half..], f"{prefix}{t}"))

    ## The operations table of the element type `t`, registering it to be emitted.
    pub func ops_name(t: u32) -> str!:
        var i: usize = 0
        while i < self.ops_types.count and self.ops_types.get(i) != t:
            i += 1
        if i == self.ops_types.count:
            try self.ops_types.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_text(try strings.format(self.checker.scratch[half..], f"L_ops_{t}"))

    ## Writes the alias module `module` is imported under in generated source.
    pub func write_base_alias(module: u32) -> !:
        try self.put(try self.module_alias(module))

    ## The alias a module is imported under in generated source: the runtime's
    ## own name for a standard module every file imports, `__luce_base_N` otherwise.
    pub func module_alias(module: u32) -> str!:
        let source = self.checker.modules.get((usize)module)
        if source.standard:
            if let alias = runtime_alias(source.name):
                return alias
        let half = self.checker.scratch.length // 2
        return try copy_text(try strings.format(self.checker.scratch[half..], f"__luce_base_{module}"))

    ## The emitted name of a declared type, which may be module-qualified (§15).
    pub func type_name(d: ast.Node*) -> str:
        return self.checker.table.get(d.type_id).name

    ## The type a task's result is kept as (`payload_of_task`).
    pub func task_payload(task_type: u32) -> u32:
        return payload_of_task(&self.checker.table, task_type)

    ## Writes `n` in decimal.
    pub func put_u64(n: u64) -> !:
        try self.out.put_u64(n)

## The type the result of a task of type `task_type` is kept as: the success type,
## `bool` for nothing.
pub func payload_of_task(table: types.Table*, task_type: u32) -> u32:
    var r = table.get(task_type).elem
    if table.kind(r) == types.Kind.fallible:
        r = table.get(r).elem
    return types.bool_id if r == types.unit_id else r

# mark: Copies and aliases ====================================================================

## Copy into the compiler arena before the formatting scratch is reused.
pub func copy_text(text: str) -> str!:
    var out = try new u8[text.length] ---
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    return (str)out

## These canonical standard imports are already required by every generated file.
pub func runtime_alias(name: str) -> str?:
    if name == "memory" or name == "interop":
        return name
    if name == "ownership":
        return "heap"
    return none
