#==============================================================================================
#
#   base - The typed tree written out as Base
#
#   DESCRIPTION:
#       Base is the machine form. The translation is close to an isomorphism: a Luce local is
#       a Base local, a struct a struct, an enum an enum, `if`, `while`, `match`, `break` and
#       `continue` are themselves, and checked `int` arithmetic is Base's own, so a trap is
#       the operator. What Base does not spell, Python's `//`, `%` and `**`, text made of
#       pieces, the display of a value, Luce's indexes and slices, is a call into `rt.kernel`.
#       Every name a program wrote is prefixed `L_`, since Base reserves words Luce does not.
#       Objects follow docs/RUNTIME.md: `expr` writes a borrowed value for a read of a
#       binding and an owned one for everything else, `owned` and `use` say which a place
#       needs, a binding drops what it owned when its block ends, and a statement whose
#       expression pooled a temporary is wrapped in a mark and a drain. Nothing here
#       decides a language question: the checker already did.
#
#==============================================================================================

import front.ast
import sema.check
import sema.bodies
import sema.types
import support.buffer
import support.list
import support.literals

pub let unsupported: ErrorCode = ErrorCode.package(15)

pub struct Emitter:
    var checker: check.Checker*
    var out: buffer.Buffer
    var indent: u32
    var temps: u32
    ## Types whose display function is needed, emitted after the program.
    var shown: list.List[u32]
    ## Types holding references, whose copy, drop, trace and pool functions are emitted
    ## after the program.
    var lifetimes: list.List[u32]
    ## Whether the statement being written pooled a temporary, so it needs a drain.
    var pooled: bool
    ## Inside a match statement, where a bound payload is copied at the arm's start and
    ## the pattern writes its raw name; a match expression borrows the payload as is.
    var raw_payloads: bool
    ## Inside an enum's or a class's method, where `self` is an ordinary parameter.
    var self_name: str

    pub static func over(checker: check.Checker*) -> Emitter!:
        return Emitter(checker = checker, out = try buffer.Buffer.create(65536), indent = 0, temps = 0,
                       shown = try list.List[u32].create(16), lifetimes = try list.List[u32].create(16),
                       pooled = false, raw_payloads = false, self_name = "self")

    pub func text() -> str:
        return self.out.view()

    # -- writing --------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        try self.out.put(text)

    mutating func line(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)
        try self.out.put("\n")

    mutating func begin(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)

    mutating func end() -> !:
        try self.out.put("\n")

    func fail(node: ast.Node*, what: str) -> never!:
        return try self.checker.fail(node, what)

    mutating func temp(prefix: str) -> str!:
        self.temps += 1
        let half = self.checker.scratch.length // 2
        let name = try format(self.checker.scratch[half..], f"{prefix}{self.temps}")
        return try copy_name(name)

    ## The text written since `start`, taken back out of the output.
    mutating func capture(start: usize) -> str!:
        let text = try copy_name((str)self.out.bytes()[start..])
        self.out.used = start
        return text

    ## A statement's text wrapped in a mark and a drain when it pooled a temporary.
    mutating func drained(start: usize, pooled_before: bool) -> !:
        if self.pooled:
            let text = try self.capture(start)
            let m = try self.temp("mark")
            try self.begin("let ")
            try self.put(m)
            try self.put(" = heap.mark()")
            try self.end()
            try self.begin("errdefer heap.drain(")
            try self.put(m)
            try self.put(")")
            try self.end()
            try self.put(text)
            try self.begin("heap.drain(")
            try self.put(m)
            try self.put(")")
            try self.end()
        self.pooled = pooled_before

    # -- the program ----------------------------------------------------------------------

    pub mutating func program() -> !:
        let tree = self.checker.tree()
        try self.line("## generated by luce; edit the .luc source, not this")
        try self.line("import memory")
        try self.line("import rt.heap")
        try self.line("import rt.kernel")
        try self.line("")
        var cursor = tree.body
        while let d = cursor:
            match d.kind:
                .constant: try self.constant(d)
                .struct_: try self.struct_decl(d)
                .enum_: try self.enum_decl(d)
                .class_: try self.class_decl(d)
                .interface_: return try self.fail(d, "interfaces compile in the interfaces slice")
                .type_alias: discard(0)
                .func_: try self.function(d, "")
                .test_: discard(0)
                _: discard(0)
            cursor = d.next
        try self.show_functions()
        try self.lifetime_functions()
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    let status = L_main(kernel.list_from_args(arguments)) catch failure:")
        try self.line("        kernel.print_error(failure.message)")
        try self.line("        return 1")
        try self.line("    return heap.finish_run(i32(status))")

    mutating func constant(d: ast.Node*) -> !:
        let init = d.left else return
        try self.begin("let L_")
        try self.put(d.text)
        try self.put(": ")
        try self.type_of(d.type_id)
        try self.put(" = ")
        try self.expr(init)
        try self.end()
        try self.line("")

    mutating func struct_decl(d: ast.Node*) -> !:
        try self.begin("struct L_")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        var fields: u32 = 0
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
                fields += 1
            cursor = m.next
        if fields == 0:
            try self.line("pub var nothing: u8")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.line("")
                try self.function(m, "method")
            cursor = m.next
        self.indent -= 1
        try self.line("")

    ## A class: a Base struct with the runtime's header first, its methods as free functions
    ## over a pointer, the descriptor the runtime destroys and traces it by, and `new`.
    mutating func class_decl(d: ast.Node*) -> !:
        let name = d.text
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("var header: heap.Object")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        cursor = d.body
        var init: ast.Node*? = none
        var has_deinit = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, name)
                if m.text == "init":
                    init = m
                if m.text == "deinit":
                    has_deinit = true
            cursor = m.next
        if has_deinit:
            try self.begin("func L_")
            try self.put(name)
            try self.put("__finish(o: heap.Object*):")
            try self.end()
            try self.begin("    L_")
            try self.put(name)
            try self.put("__L_deinit((L_")
            try self.put(name)
            try self.put("*)o)")
            try self.end()
            try self.line("")
        # the fields go last first; one never assigned (an `init` that failed) is zero and
        # every drop below tolerates that
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        var fields = try list.List[ast.Node*].create(8)
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try fields.push(m)
            cursor = m.next
        var i = fields.count
        var any = false
        while i > 0:
            i -= 1
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(")")
                try self.end()
                any = true
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        any = false
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(", visit, context)")
                try self.end()
                any = true
            i += 1
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(name)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = ")
        if has_deinit:
            try self.put("L_")
            try self.put(name)
            try self.put("__finish")
        else:
            try self.put("none")
        try self.put(", drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        # construction: the block, the defaults, then `init`; a failing `init` abandons it
        var fallible = false
        if let f = init:
            let result = self.checker.table.get(f.type_id).elem
            fallible = self.checker.table.kind(result) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(name)
        try self.put("__new(")
        if let f = init:
            var first = true
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(param.text)
                    try self.put(": ")
                    try self.type_of(param.type_id)
                pc = param.next
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*!:" if fallible else "*:")
        try self.end()
        self.indent += 1
        try self.begin("let L_self = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if let default = f.left:
                try self.begin("L_self.L_")
                try self.put(f.text)
                try self.put(" = ")
                try self.owned(default)
                try self.end()
            i += 1
        if let f = init:
            try self.begin("")
            try self.put("L_")
            try self.put(name)
            try self.put("__L_init(L_self")
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    try self.put(", L_")
                    try self.put(param.text)
                pc = param.next
            try self.put(")")
            if fallible:
                try self.put(" catch failure:")
                try self.end()
                try self.line("    heap.abandon((heap.Object*)L_self)")
                try self.line("    error(failure.code, failure.message)")
            else:
                try self.end()
        try self.line("return L_self")
        self.indent -= 1
        try self.line("")

    mutating func enum_decl(d: ast.Node*) -> !:
        try self.begin("enum L_")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin("L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        try self.put(": ")
                        try self.type_of(field.type_id)
                        p = field.next
                    try self.put(")")
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        # an enum's methods are free functions over it, `self` an ordinary parameter
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, d.text)
            cursor = m.next

    ## `owner` is "" for a free function, "method" for a struct's, an enum's name for its.
    mutating func function(f: ast.Node*, owner: str) -> !:
        let t = self.checker.table.get(f.type_id)
        var prefix = "func L_"
        if owner == "method":
            if not check.has_self(f):
                prefix = "static func L_"
            elif f.has(check.flag_mutating):
                prefix = "mutating func L_"
        try self.begin(prefix)
        if owner != "" and owner != "method":
            try self.put(owner)
            try self.put("__L_")
        try self.put(f.text)
        try self.put("(")
        var first = true
        var cursor = f.right
        self.self_name = "self"
        while let p = cursor:
            if p.text == "self":
                if owner != "method":
                    try self.put("L_self: L_")
                    try self.put(owner)
                    if let od = self.checker.find_declaration(owner):
                        if od.kind == ast.Kind.class_:
                            try self.put("*")
                    first = false
                    self.self_name = "L_self"
            else:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if t.elem != types.unit_id:
            try self.put(" -> ")
            try self.type_of(t.elem)
        elif self.checker.table.kind(t.elem) == types.Kind.fallible:
            try self.put(" -> !")
        try self.put(":")
        try self.end()
        let body = f.body else return
        self.indent += 1
        try self.block(body)
        self.indent -= 1
        try self.line("")
        self.self_name = "self"

    # -- types ----------------------------------------------------------------------------

    pub mutating func type_of(id: u32) -> !:
        let t = self.checker.table.get(id)
        match t.kind:
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("str")
            .bytes_: try self.put("const u8[]")
            .unit_: try self.put("unit")
            .never_: try self.put("never")
            .error_code: try self.put("ErrorCode")
            .error_value: try self.put("Error")
            .range_: try self.put("kernel.Range")
            .optional:
                try self.type_of(t.elem)
                try self.put("?")
            .fallible:
                if t.elem == types.unit_id:
                    try self.put("!")
                else:
                    try self.type_of(t.elem)
                    try self.put("!")
            .tuple:
                try self.put("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                try self.put(")")
            .func_:
                try self.put("func(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                try self.put(")")
                if t.elem != types.unit_id:
                    try self.put(" -> ")
                    try self.type_of(t.elem)
            .list_:
                try self.put("kernel.ListStore[")
                try self.type_of(t.elem)
                try self.put("]*")
            .struct_, .enum_:
                try self.put("L_")
                try self.put(t.name)
            .class_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("*")
            .weak_:
                try self.put("heap.Weak")
            _:
                error(unsupported, "a type this slice does not compile")

    # -- statements -----------------------------------------------------------------------

    mutating func block(b: ast.Node*) -> !:
        if b.body == none:
            try self.line("discard(0)")
            return
        var cursor = b.body
        while let s = cursor:
            try self.statement(s)
            cursor = s.next

    ## One statement; whatever it pooled is drained when it ends (RUNTIME 5).
    mutating func statement(s: ast.Node*) -> !:
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        match s.kind:
            .let_, .var_: try self.binding(s)
            .assign: try self.assign(s)
            .if_: try self.if_statement(s)
            .while_: try self.while_statement(s)
            .for_: try self.for_statement(s)
            .match_: try self.match_statement(s)
            .with_: try self.with_statement(s)
            .return_: try self.return_statement(s)
            .break_, .continue_:
                try self.begin("break" if s.kind == ast.Kind.break_ else "continue")
                if s.text.length > 0:
                    try self.put(" ")
                    try self.put(s.text)
                try self.end()
            .recover_:
                let v = s.left else return
                try self.begin("recover ")
                try self.owned(v)
                try self.end()
            .expr_stmt:
                let e = s.left else return
                try self.begin("")
                if e.type_id != types.unit_id and e.type_id != types.never_id:
                    try self.put("discard(")
                    try self.use(e)
                    try self.put(")")
                else:
                    try self.use(e)
                try self.end()
            _: return try self.fail(s, "a statement this slice does not compile")
        try self.drained(start, pooled_before)

    ## `defer` the drop of a binding that owns references, right after it.
    mutating func drop_at_exit(name: str, t: u32) -> !:
        if not self.checker.table.has_references(t):
            return
        try self.begin("defer ")
        try self.put(try self.lifetime_name("L_drop_", t))
        try self.put("(L_")
        try self.put(name)
        try self.put(")")
        try self.end()

    ## `return e`: the value is owned by the caller; the statement's temporaries die after
    ## it is computed and before the function's bindings (RUNTIME 5).
    mutating func return_statement(s: ast.Node*) -> !:
        let v = s.left else return try self.line("return")
        let start = self.out.used
        try self.owned(v)
        let text = try self.capture(start)
        if self.pooled:
            let r = try self.temp("result")
            try self.begin("let ")
            try self.put(r)
            try self.put(" = ")
            try self.put(text)
            try self.end()
            try self.drained(start, true)
            self.pooled = false
            try self.begin("return ")
            try self.put(r)
            try self.end()
            return
        try self.begin("return ")
        try self.put(text)
        try self.end()

    mutating func binding(s: ast.Node*) -> !:
        let init = s.left else return
        let word = "let " if s.kind == ast.Kind.let_ else "var "
        try self.begin(word)
        if s.body != none:
            try self.put("(")
            var cursor = s.body
            var first = true
            while let part = cursor:
                if not first:
                    try self.put(", ")
                first = false
                if part.has(ast.flag_wildcard):
                    try self.put("_")
                else:
                    try self.put("L_")
                    try self.put(part.text)
                cursor = part.next
            try self.put(")")
        else:
            try self.put("L_")
            try self.put(s.text)
            try self.put(": ")
            try self.type_of(s.type_id)
        try self.put(" = ")
        try self.owned(init)
        try self.end()
        if s.body != none:
            var cursor = s.body
            while let part = cursor:
                if not part.has(ast.flag_wildcard):
                    try self.drop_at_exit(part.text, part.type_id)
                cursor = part.next
        else:
            try self.drop_at_exit(s.text, s.type_id)

    ## The new value is computed and stored, then the old one dropped (RUNTIME 1, 2).
    mutating func assign(s: ast.Node*) -> !:
        let place = s.left else return
        let value = s.right else return
        if place.kind == ast.Kind.tuple:
            let t = try self.temp("tuple")
            try self.begin("let ")
            try self.put(t)
            try self.put(" = ")
            try self.owned(value)
            try self.end()
            var i: usize = 0
            var cursor = place.body
            while let part = cursor:
                let half = self.checker.scratch.length // 2
                let member = try copy_name(try format(self.checker.scratch[half..], f"{t}.{i}"))
                try self.store(part, member)
                i += 1
                cursor = part.next
            return
        if s.text == "=" and self.checker.table.has_references(place.type_id):
            let n = try self.temp("new")
            try self.begin("let ")
            try self.put(n)
            try self.put(": ")
            try self.type_of(place.type_id)
            try self.put(" = ")
            try self.owned(value)
            try self.end()
            try self.store(place, n)
            return
        try self.begin("")
        try self.place_expr(place)
        if s.text == "=" or s.text == "+=" and place.type_id != types.str_id or s.text == "-=" or s.text == "*=" or (s.text == "/=" and place.type_id == types.float_id):
            try self.put(" ")
            try self.put(s.text)
            try self.put(" ")
            try self.expr(value)
            try self.end()
            return
        # `//=`, `%=`, `**=`, and `+=` on text are the operation then the store
        try self.put(" = ")
        let op = (str)s.text.bytes[..<s.text.length - 1]
        try self.arithmetic(op, place.type_id, place, value)
        try self.end()

    ## `place = name`, the old value dropped after the store when it held references.
    mutating func store(place: ast.Node*, name: str) -> !:
        if self.checker.table.has_references(place.type_id):
            let old = try self.temp("old")
            try self.begin("let ")
            try self.put(old)
            try self.put(" = ")
            try self.place_expr(place)
            try self.end()
            try self.begin("")
            try self.place_expr(place)
            try self.put(" = ")
            try self.put(name)
            try self.end()
            try self.begin("")
            try self.put(try self.lifetime_name("L_drop_", place.type_id))
            try self.put("(")
            try self.put(old)
            try self.put(")")
            try self.end()
            return
        try self.begin("")
        try self.place_expr(place)
        try self.put(" = ")
        try self.put(name)
        try self.end()

    ## A place as written: no copy is taken of a field on the way.
    mutating func place_expr(e: ast.Node*) -> !:
        match e.kind:
            .name, .self_, .group, .index: try self.expr(e)
            .member:
                let receiver = e.left else return
                try self.place_expr(receiver)
                try self.put(".L_")
                try self.put(e.text)
            _: return try self.fail(e, "this is not a place the emitter knows")

    mutating func put_u64(n: u64) -> !:
        try self.out.put_u64(n)

    ## The condition of an `if` or `while`, hoisted into a binding when it pooled a
    ## temporary, so that the temporary dies before the body runs (RUNTIME 5). The name
    ## of what to test, or the condition's text.
    mutating func hoisted_condition(s: ast.Node*) -> str!:
        let cond = s.left else return ""
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        if s.has(ast.flag_if_let):
            let init = cond.left else return ""
            try self.owned(init)
        else:
            try self.use(cond)
        let text = try self.capture(start)
        if not self.pooled:
            self.pooled = pooled_before
            return text
        let c = try self.temp("cond")
        try self.begin("let ")
        try self.put(c)
        try self.put(" = ")
        try self.put(text)
        try self.end()
        try self.drained(start, pooled_before)
        return c

    mutating func if_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let value = try self.hoisted_condition(s)
        try self.begin("if ")
        if s.has(ast.flag_if_let):
            try self.put("let L_")
            try self.put(cond.text)
            try self.put(" = ")
        try self.put(value)
        try self.put(":")
        try self.end()
        let body = s.body else return
        self.indent += 1
        if s.has(ast.flag_if_let):
            try self.drop_at_exit(cond.text, cond.type_id)
        try self.block(body)
        self.indent -= 1
        if let rest = s.right:
            try self.line("else:")
            self.indent += 1
            if rest.kind == ast.Kind.if_:
                try self.statement(rest)
            else:
                try self.block(rest)
            self.indent -= 1

    mutating func while_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let body = s.body else return
        # the condition is evaluated inside the loop, so it is written there
        try self.begin("")
        if s.text.length > 0:
            try self.put(s.text)
            try self.put(": ")
        try self.put("while true:")
        try self.end()
        self.indent += 1
        let value = try self.hoisted_condition(s)
        if s.has(ast.flag_if_let):
            try self.begin("if let L_")
            try self.put(cond.text)
            try self.put(" = ")
            try self.put(value)
            try self.put(":")
            try self.end()
            self.indent += 1
            try self.drop_at_exit(cond.text, cond.type_id)
            try self.block(body)
            self.indent -= 1
            try self.line("else:")
            try self.line("    break")
        else:
            try self.begin("if not (")
            try self.put(value)
            try self.put("):")
            try self.end()
            try self.line("    break")
            try self.block(body)
        self.indent -= 1

    ## `with e as x:` is a block that binds, closes on every exit, then drops (§8.5).
    mutating func with_statement(s: ast.Node*) -> !:
        let body = s.body else return
        try self.line("if true:")
        self.indent += 1
        var cursor = s.left
        while let item = cursor:
            let e = item.left else return
            let close = item.resolved else return
            try self.begin("let L_")
            try self.put(item.text)
            try self.put(" = ")
            try self.owned(e)
            try self.end()
            try self.drop_at_exit(item.text, item.type_id)
            let t = self.checker.table.get(item.type_id)
            try self.begin("defer ")
            if t.kind == types.Kind.class_ or t.kind == types.Kind.enum_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("__L_close(L_")
                try self.put(item.text)
                try self.put(")")
            else:
                try self.put("L_")
                try self.put(item.text)
                try self.put(".L_close()")
            try self.end()
            cursor = item.next
        try self.block(body)
        self.indent -= 1



    mutating func for_statement(s: ast.Node*) -> !:
        let binding = s.left else return
        let seq = s.right else return
        let body = s.body else return
        let st = self.checker.table.get(seq.type_id)
        let label = s.text
        match st.kind:
            .range_:
                # a written range iterates directly; a range value through its bounds
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for L_")
                try self.put(binding.text)
                try self.put(" in ")
                if seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..="):
                    let l = seq.left else return
                    let r = seq.right else return
                    try self.expr(l)
                    try self.put(seq.text)
                    try self.expr(r)
                else:
                    let t = try self.temp("range")
                    try self.put(t)
                    try self.put(".low..<kernel.range_end(")
                    try self.put(t)
                    try self.put(")")
                try self.put(":")
                try self.end()
                if not (seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..=")):
                    return try self.fail(seq, "a range value in `for` compiles in the collections slice")
                self.indent += 1
                try self.block(body)
                self.indent -= 1
            .str_:
                let it = try self.temp("scalars")
                try self.begin("var ")
                try self.put(it)
                try self.put(" = kernel.Scalars.over(")
                try self.expr(seq)
                try self.put(")")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while let L_")
                try self.put(binding.text)
                try self.put(" = ")
                try self.put(it)
                try self.put(".next():")
                try self.end()
                self.indent += 1
                try self.block(body)
                self.indent -= 1
            .bytes_:
                let raw = try self.temp("byte")
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for ")
                try self.put(raw)
                try self.put(" in ")
                try self.expr(seq)
                try self.put(":")
                try self.end()
                self.indent += 1
                try self.begin("let L_")
                try self.put(binding.text)
                try self.put(" = (i64)")
                try self.put(raw)
                try self.end()
                try self.block(body)
                self.indent -= 1
            .list_:
                let store = try self.temp("store")
                try self.begin("let ")
                try self.put(store)
                try self.put(" = ")
                try self.expr(seq)
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for L_")
                try self.put(binding.text)
                try self.put(" in ")
                try self.put(store)
                try self.put(".items[..<")
                try self.put(store)
                try self.put(".count]:")
                try self.end()
                self.indent += 1
                try self.block(body)
                self.indent -= 1
            _: return try self.fail(seq, "iterating this compiles in the collections slice")

    # -- match ----------------------------------------------------------------------------

    mutating func match_statement(s: ast.Node*) -> !:
        let subject = s.left else return
        let st = self.checker.table.get(subject.type_id)
        let m = try self.temp("subject")
        try self.begin("let ")
        try self.put(m)
        try self.put(" = ")
        try self.use(subject)
        try self.end()
        if st.kind == types.Kind.tuple:
            return try self.match_by_tests(s, m, false)
        try self.begin("match ")
        try self.put(m)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = s.body
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            self.raw_payloads = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, m, &bound)
                p = pattern.next
            self.raw_payloads = false
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(":")
            try self.end()
            self.indent += 1
            if let name = bound:
                try self.begin("let L_")
                try self.put(name.text)
                try self.put(" = ")
                if self.checker.table.has_references(name.type_id):
                    try self.put(try self.lifetime_name("L_copy_", name.type_id))
                    try self.put("(")
                    try self.put(m)
                    try self.put(")")
                else:
                    try self.put(m)
                try self.end()
                try self.drop_at_exit(name.text, name.type_id)
            # a payload bound by the arm is the subject's; the binding takes its own copy
            var q = arm.left
            while let pattern = q:
                try self.own_payloads(pattern, st)
                q = pattern.next
            let body = arm.body else return
            try self.block(body)
            self.indent -= 1
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(s):
            try self.line("_: discard(0)")
        self.indent -= 1

    ## `let L_x = L_copy(L_x__r)` and its drop for every payload name the pattern bound
    ## whose type holds references; `pattern` wrote the raw name.
    mutating func own_payloads(p: ast.Node*, st: types.Type) -> !:
        if p.has(ast.flag_wildcard):
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional and self.checker.table.has_references(name.type_id):
                try self.own_payload(name)
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            var cursor = v.body
            while let name = cursor:
                if not name.has(ast.flag_wildcard) and self.checker.table.has_references(name.type_id):
                    try self.own_payload(name)
                cursor = name.next

    mutating func own_payload(name: ast.Node*) -> !:
        try self.begin("let L_")
        try self.put(name.text)
        try self.put(" = ")
        try self.put(try self.lifetime_name("L_copy_", name.type_id))
        try self.put("(L_")
        try self.put(name.text)
        try self.put("__r)")
        try self.end()
        try self.drop_at_exit(name.text, name.type_id)

    ## A bound payload name in a pattern: raw when the binding will copy it.
    mutating func payload_name(name: ast.Node*) -> !:
        try self.put("L_")
        try self.put(name.text)
        if self.raw_payloads and self.checker.table.has_references(name.type_id):
            try self.put("__r")

    ## One pattern in a Base arm; a name pattern becomes `_` (or `.some(name)`) and is
    ## bound at the arm's start.
    mutating func pattern(p: ast.Node*, st: types.Type, subject: str, bound: ast.Node*?*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional:
                try self.put(".some(")
                try self.payload_name(name)
                try self.put(")")
            else:
                try self.put("_")
                *bound = name
            return
        if p.text == "none":
            try self.put(".none")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            try self.put(".L_")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                var cursor = v.body
                var first = true
                while let name = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    if name.has(ast.flag_wildcard):
                        try self.put("_")
                    else:
                        try self.payload_name(name)
                    cursor = name.next
                try self.put(")")
            return
        if p.text == "..<" or p.text == "..=":
            let hi = p.right else return
            try self.expr(v)
            try self.put(p.text)
            try self.expr(hi)
            return
        try self.expr(v)

    ## A match over a tuple: one `if` per arm over member tests, a flag saying an arm
    ## applied so a failed guard falls through to the next, and a trap after the chain when
    ## every arm leaves the function, so Base sees the return the checker proved.
    mutating func match_by_tests(s: ast.Node*, m: str, is_expr: bool) -> !:
        let done = try self.temp("matched")
        try self.begin("var ")
        try self.put(done)
        try self.put(" = false")
        try self.end()
        var cursor = s.body
        while let arm = cursor:
            try self.begin("if not ")
            try self.put(done)
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" and (")
                var p = arm.left
                var first = true
                while let pattern = p:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m)
                    try self.put(")")
                    p = pattern.next
                try self.put(")")
            try self.put(":")
            try self.end()
            self.indent += 1
            if let pattern = arm.left:
                try self.tuple_bindings(pattern, m)
            if let guard = arm.right:
                try self.begin("if ")
                try self.expr(guard)
                try self.put(":")
                try self.end()
                self.indent += 1
            try self.begin("")
            try self.put(done)
            try self.put(" = true")
            try self.end()
            let body = arm.body else return
            try self.block(body)
            if arm.right != none:
                self.indent -= 1
            self.indent -= 1
            cursor = arm.next
        if s.has(ast.flag_all_exit):
            try self.line("trap(\"no arm of the match applied\")")

    mutating func tuple_test(p: ast.Node*, m: str) -> !:
        if p.has(ast.flag_wildcard) or p.text == "bind":
            try self.put("true")
            return
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(" and ")
                first = false
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_test_member(sub, try copy_name(member))
                i += 1
                cursor = sub.next
            if first:
                try self.put("true")
            return
        let v = p.left else return
        try self.put(m)
        try self.put(" == ")
        try self.expr(v)

    mutating func tuple_test_member(p: ast.Node*, member: str) -> !:
        try self.put("(")
        try self.tuple_test(p, member)
        try self.put(")")

    mutating func tuple_bindings(p: ast.Node*, m: str) -> !:
        if p.text == "bind":
            let name = p.left else return
            try self.begin("let L_")
            try self.put(name.text)
            try self.put(" = ")
            if self.checker.table.has_references(name.type_id):
                try self.put(try self.lifetime_name("L_copy_", name.type_id))
                try self.put("(")
                try self.put(m)
                try self.put(")")
            else:
                try self.put(m)
            try self.end()
            try self.drop_at_exit(name.text, name.type_id)
            return
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            while let sub = cursor:
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_bindings(sub, try copy_name(member))
                i += 1
                cursor = sub.next

    # -- expressions ----------------------------------------------------------------------

    ## Whether the expression reads a binding, so its value is borrowed (RUNTIME 4).
    func borrowed(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                let d = e.resolved else return false
                return d.kind != ast.Kind.func_ and d.kind != ast.Kind.constant
            .self_: return true
            .group:
                let inner = e.left else return false
                return self.borrowed(inner)
            _: return false

    ## The expression as a value the reader will keep: a borrowed one is copied.
    mutating func owned(e: ast.Node*) -> !:
        if self.checker.table.has_references(e.type_id) and self.borrowed(e):
            try self.put(try self.lifetime_name("L_copy_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            return
        try self.expr(e)

    ## The expression as a value used and let go of: an owned one becomes a temporary of
    ## the statement, pooled until the drain.
    mutating func use(e: ast.Node*) -> !:
        if self.checker.table.has_references(e.type_id) and not self.borrowed(e):
            try self.put(try self.lifetime_name("L_pool_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            self.pooled = true
            return
        try self.expr(e)

    ## Writes the value: borrowed for a read of a binding, owned for everything else.
    pub mutating func expr(e: ast.Node*) -> !:
        match e.kind:
            .literal: try self.literal(e)
            .name:
                let d = e.resolved else return try self.fail(e, "an unresolved name")
                if d.kind == ast.Kind.func_ or d.kind == ast.Kind.constant:
                    try self.put("L_")
                    try self.put(d.text)
                    return
                try self.put("L_")
                try self.put(e.text)
            .self_: try self.put(self.self_name)
            .group:
                let inner = e.left else return
                try self.put("(")
                try self.expr(inner)
                try self.put(")")
            .unary:
                let inner = e.left else return
                if e.text == "try":
                    try self.put("try ")
                    try self.expr(inner)
                elif e.text == "not":
                    try self.put("not ")
                    try self.expr(inner)
                else:
                    try self.put("(-")
                    try self.expr(inner)
                    try self.put(")")
            .binary: try self.binary(e)
            .conditional:
                let cond = e.ty else return
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" if ")
                try self.use(cond)
                try self.put(" else ")
                try self.owned(r)
                try self.put(")")
            .tuple:
                try self.put("(")
                var cursor = e.body
                var first = true
                while let m = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.owned(m)
                    cursor = m.next
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .unit_: try self.put("()")
            .call: try self.call(e)
            .member: try self.member(e)
            .index:
                let receiver = e.left else return
                let index = e.body else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.bytes_:
                    let t = try self.temp_less_receiver(receiver)
                    try self.put("(i64)")
                    try self.put(t)
                    try self.put("[kernel.index(")
                    try self.expr(index)
                    try self.put(", ")
                    try self.put(t)
                    try self.put(".length)]")
                elif rt.kind == types.Kind.list_:
                    try self.put("kernel.list_get[")
                    try self.type_of(rt.elem)
                    try self.put("](")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                else:
                    return try self.fail(e, "indexing this compiles in the collections slice")
            .slice:
                let receiver = e.left else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.str_:
                    try self.put("kernel.slice_text(")
                elif rt.kind == types.Kind.bytes_:
                    try self.put("kernel.slice_bytes(")
                else:
                    return try self.fail(e, "slicing a list compiles in the collections slice")
                try self.expr(receiver)
                try self.put(", ")
                if let low = e.body:
                    try self.expr(low)
                else:
                    try self.put("0")
                try self.put(", ")
                if let high = e.right:
                    try self.expr(high)
                else:
                    try self.put("0")
                try self.put(", ")
                try self.put("true" if e.has(ast.flag_no_high) else "false")
                try self.put(")")
            .else_:
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" else ")
                if r.kind == ast.Kind.return_:
                    try self.put("return")
                    if let v = r.left:
                        try self.put(" ")
                        try self.owned(v)
                elif r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
                    try self.put("break" if r.kind == ast.Kind.break_ else "continue")
                    if r.text.length > 0:
                        try self.put(" ")
                        try self.put(r.text)
                else:
                    try self.owned(r)
                try self.put(")")
            .catch_:
                let l = e.left else return
                let body = e.body else return
                try self.owned(l)
                try self.put(" catch ")
                if e.text.length > 0:
                    try self.put("L_")
                    try self.put(e.text)
                try self.put(":")
                try self.end()
                self.indent += 1
                try self.block(body)
                self.indent -= 1
                # the caller's line is already ended by the suite
                try self.begin("")
            .case_value: try self.case_value(e, e.body)
            .formatted: try self.formatted(e)
            .match_expr: try self.match_expr(e)
            _: return try self.fail(e, "an expression this slice does not compile")

    ## The receiver of an index, named once when it is a call.
    mutating func temp_less_receiver(receiver: ast.Node*) -> str!:
        if receiver.kind == ast.Kind.name or receiver.kind == ast.Kind.self_:
            let half = self.checker.scratch.length // 2
            if receiver.kind == ast.Kind.self_:
                return self.self_name
            return try copy_name(try format(self.checker.scratch[half..], f"L_{receiver.text}"))
        return try self.fail(receiver, "index a bound name; binding the value first")

    mutating func literal(e: ast.Node*) -> !:
        let b = e.text.bytes
        if e.text == "true" or e.text == "false" or e.text == "none":
            try self.put(e.text)
            return
        if b[0] == '"' or (b[0] == 'r' and b.length > 1 and b[1] == '"'):
            try self.text_literal(try literals.decode_text(e.text), false)
            return
        if b[0] == 'b' and b.length > 1 and b[1] == '"':
            try self.text_literal(try literals.decode_text(e.text), true)
            return
        if literals.is_float_text(e.text):
            try self.put(e.text)
            return
        let magnitude = try literals.decode_integer(e.text)
        if magnitude == 9223372036854775808:
            try self.put("9223372036854775808")
            return
        try self.put_u64(magnitude)

    ## A Base text literal for `text`: every byte C or Base could misread is escaped.
    mutating func text_literal(text: str, as_bytes: bool) -> !:
        if as_bytes:
            try self.put("b")
        try self.put("\"")
        for c in text.bytes:
            if c == '\\':
                try self.put("\\\\")
            elif c == '"':
                try self.put("\\\"")
            elif c == '\n':
                try self.put("\\n")
            elif c == '\r':
                try self.put("\\r")
            elif c == '\t':
                try self.put("\\t")
            elif c == 0:
                try self.put("\\0")
            elif c < 32 or (as_bytes and c >= 127):
                try self.put("\\x")
                try self.out.put_byte(hex_digit(c >> 4))
                try self.out.put_byte(hex_digit(c & 15))
            else:
                try self.out.put_byte(c)
        try self.put("\"")

    mutating func binary(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let op = e.text
        if op == "and" or op == "or":
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        if op == "..<" or op == "..=":
            try self.put("kernel.range(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(", ")
            try self.put("true" if op == "..=" else "false")
            try self.put(")")
            return
        if op == "is" or op == "is not":
            # identity: the objects' addresses, none being zero (§10.2)
            try self.put("(")
            try self.identity(l)
            try self.put(" == " if op == "is" else " != ")
            try self.identity(r)
            try self.put(")")
            return
        if op == "in":
            let rt = self.checker.table.get(r.type_id)
            if rt.kind == types.Kind.str_:
                try self.put("kernel.contains(")
                try self.expr(r)
                try self.put(", ")
                try self.expr(l)
                try self.put(")")
                return
            if rt.kind == types.Kind.range_:
                try self.put("kernel.in_range(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
            return try self.fail(e, "`in` over a collection compiles in the collections slice")
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
            let lt = l.type_id
            if (op != "==" and op != "!=") and (lt == types.str_id or lt == types.bytes_id or self.checker.table.kind(lt) == types.Kind.tuple):
                try self.compare_by_call(op, l, r)
                return
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        try self.arithmetic(op, e.type_id if op != "/" else l.type_id, l, r)

    ## `<` and friends on text, bytes and tuples, which Base does not order itself.
    mutating func compare_by_call(op: str, l: ast.Node*, r: ast.Node*) -> !:
        let lt = self.checker.table.get(l.type_id)
        if lt.kind == types.Kind.tuple:
            # lexicographic over the members, which are ordered scalars
            try self.put("(")
            var i: usize = 0
            while i < lt.args.length:
                if i > 0:
                    try self.put(" or (")
                var k: usize = 0
                while k < i:
                    try self.member_compare("==", l, r, lt.args[k], k)
                    try self.put(" and ")
                    k += 1
                let last = i + 1 == lt.args.length
                try self.member_compare(op if last else strict(op), l, r, lt.args[i], i)
                if i > 0:
                    try self.put(")")
                i += 1
            try self.put(")")
            return
        try self.put("(kernel.compare_bytes(" if lt.kind == types.Kind.bytes_ else "(kernel.compare_text(")
        try self.expr(l)
        try self.put(", ")
        try self.expr(r)
        try self.put(") ")
        try self.put(op)
        try self.put(" 0)")

    mutating func member_compare(op: str, l: ast.Node*, r: ast.Node*, t: u32, i: usize) -> !:
        if t == types.str_id:
            try self.put("(kernel.compare_text(")
            try self.expr(l)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(", ")
            try self.expr(r)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(") ")
            try self.put(op)
            try self.put(" 0)")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(")")

    ## `a op b` for the arithmetic operators (§6.2), with `t` the operands' type.
    mutating func arithmetic(op: str, t: u32, l: ast.Node*, r: ast.Node*) -> !:
        if t == types.str_id and op == "+":
            try self.put("kernel.concat(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        if t == types.int_id:
            if op == "/":
                try self.put("(f64(")
                try self.expr(l)
                try self.put(") / f64(")
                try self.expr(r)
                try self.put("))")
                return
            if op == "//" or op == "%" or op == "**":
                try self.put("kernel.floor_div(" if op == "//" else "kernel.floor_mod(" if op == "%" else "kernel.power(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
        if t == types.float_id and (op == "//" or op == "%" or op == "**"):
            try self.put("kernel.ffloor_div(" if op == "//" else "kernel.ffloor_mod(" if op == "%" else "kernel.fpower(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(")")

    mutating func member(e: ast.Node*) -> !:
        let receiver = e.left else return
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.type_name:
            let m = e.resolved else return
            let d = rt.decl else return
            if m.kind == ast.Kind.enum_case:
                try self.put("L_")
                try self.put(d.text)
                try self.put(".L_")
                try self.put(m.text)
                return
            try self.put("L_")
            try self.put(d.text)
            try self.put(".L_")
            try self.put(m.text)
            return
        if rt.kind == types.Kind.tuple:
            let copies = self.checker.table.has_references(e.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", e.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if e.text == "length" and (rt.kind == types.Kind.str_ or rt.kind == types.Kind.bytes_ or rt.kind == types.Kind.list_):
            if rt.kind == types.Kind.str_:
                try self.put("kernel.scalar_length(")
                try self.expr(receiver)
                try self.put(")")
            elif rt.kind == types.Kind.bytes_:
                try self.put("(i64)")
                try self.expr(receiver)
                try self.put(".length")
            else:
                try self.put("kernel.list_length[")
                try self.type_of(rt.elem)
                try self.put("](")
                try self.expr(receiver)
                try self.put(")")
            return
        if rt.kind == types.Kind.error_value:
            try self.expr(receiver)
            try self.put(".")
            try self.put(e.text)
            return
        let m = e.resolved else return try self.fail(e, "an unresolved member")
        if m.kind == ast.Kind.field:
            # a field read is a copy of its own (RUNTIME 4)
            let copies = self.checker.table.has_references(m.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", m.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".L_")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if m.kind == ast.Kind.func_:
            # a bound method as a value: not in this slice
            return try self.fail(e, "a method as a value compiles in the closures slice")
        return try self.fail(e, "a member this slice does not compile")

    mutating func call(e: ast.Node*) -> !:
        let callee = e.left else return
        if callee.kind == ast.Kind.name and callee.resolved == none and self.checker.find_declaration(callee.text) == none:
            try self.core_call(e, callee.text)
            return
        if callee.kind == ast.Kind.member and callee.text == "package":
            let first = e.body else return
            let v = first.left else return
            try self.put("ErrorCode.package(")
            try self.put(v.text)
            try self.put(")")
            return
        if callee.kind == ast.Kind.case_value:
            try self.case_value(callee, e.body)
            return
        if callee.kind == ast.Kind.member and callee.text == "get" and self.checker.table.kind(callee.type_id) == types.Kind.weak_:
            # `weak.get()`: the object with a reference of its own, or none (§10.4)
            let receiver = callee.left else return
            let elem = self.checker.table.get(callee.type_id).elem
            try self.put(try self.lifetime_name("L_weak_get_", elem))
            try self.put("(")
            try self.use(receiver)
            try self.put(")")
            return
        let d = e.resolved else return try self.call_value(e, callee)
        match d.kind:
            .enum_case:
                let owner = callee.left else return
                try self.expr(owner)
                try self.put(".L_")
                try self.put(d.text)
                try self.arguments(e, d.body, false, true)
            .struct_:
                try self.put("L_")
                try self.put(d.text)
                try self.arguments(e, d.body, false, true)
            .class_:
                # a class with defaults for every field and no `init`
                try self.put("L_")
                try self.put(d.text)
                try self.put("__new()")
            .func_:
                if d.text == "init":
                    let owner = callee.resolved else return try self.fail(e, "no class")
                    try self.put("L_")
                    try self.put(owner.text)
                    try self.put("__new")
                    try self.arguments(e, d.right, true, false)
                    return
                if check.has_self(d):
                    let receiver = callee.left else return
                    let owner = self.checker.table.get(receiver.type_id)
                    if owner.kind == types.Kind.enum_ or owner.kind == types.Kind.class_:
                        try self.put("L_")
                        try self.put(owner.name)
                        try self.put("__L_")
                        try self.put(d.text)
                        try self.put("(")
                        try self.use(receiver)
                        if ast.count(d.right) > 1:
                            try self.put(", ")
                        try self.arguments_bare(e, d.right, true, false)
                        try self.put(")")
                        return
                    try self.use(receiver)
                    try self.put(".L_")
                    try self.put(d.text)
                    try self.arguments(e, d.right, true, false)
                    return
                if callee.kind == ast.Kind.member:
                    try self.expr(callee)
                else:
                    try self.put("L_")
                    try self.put(d.text)
                try self.arguments(e, d.right, true, false)
            _: return try self.fail(e, "a call this slice does not compile")

    ## A call through a function value: Base's function pointer, positional arguments.
    mutating func call_value(e: ast.Node*, callee: ast.Node*) -> !:
        try self.expr(callee)
        try self.put("(")
        var cursor = e.body
        var first = true
        while let a = cursor:
            if not first:
                try self.put(", ")
            first = false
            let v = a.left else return
            try self.use(v)
            cursor = a.next
        try self.put(")")

    ## `(a, b, c)` in parameter order, defaults filled in; a call borrows its arguments,
    ## a construction owns them (`own`).
    mutating func arguments(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        try self.put("(")
        try self.arguments_bare(e, params, skip_self, own)
        try self.put(")")

    mutating func arguments_bare(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        var first = true
        var cursor = params
        while let p = cursor:
            if (p.kind == ast.Kind.param or p.kind == ast.Kind.field) and not (skip_self and p.text == "self"):
                if not first:
                    try self.put(", ")
                first = false
                var found = false
                var a = e.body
                while let arg = a:
                    if arg.resolved == p:
                        let v = arg.left else return
                        if own:
                            try self.owned(v)
                        else:
                            try self.use(v)
                        found = true
                    a = arg.next
                if not found:
                    let d = p.left else return try self.fail(e, "a missing argument")
                    if own:
                        try self.owned(d)
                    else:
                        try self.use(d)
            cursor = p.next

    mutating func case_value(e: ast.Node*, args: ast.Node*?) -> !:
        let case_node = e.resolved else return try self.fail(e, "an unresolved case")
        var t = self.checker.table.get(e.type_id)
        if t.kind == types.Kind.optional:
            t = self.checker.table.get(t.elem)
        try self.put("L_")
        try self.put(t.name)
        try self.put(".L_")
        try self.put(case_node.text)
        if case_node.body != none:
            let saved = e.body
            e.body = args
            try self.arguments(e, case_node.body, false, true)
            e.body = saved

    ## The address of an object, or zero, as a `usize`.
    mutating func identity(e: ast.Node*) -> !:
        if e.kind == ast.Kind.literal and e.text == "none":
            try self.put("0")
            return
        try self.put(try self.lifetime_name("L_id_", e.type_id))
        try self.put("(")
        try self.use(e)
        try self.put(")")

    ## `print`, `assert`, `trap`, `error`, `discard`, the conversions.
    mutating func core_call(e: ast.Node*, name: str) -> !:
        if name == "print":
            try self.put("kernel.print_line(")
            let n = ast.count(e.body)
            if n == 1:
                let first = e.body else return
                let v = first.left else return
                try self.show(v)
            else:
                try self.put("kernel.join([")
                var cursor = e.body
                var first = true
                while let a = cursor:
                    if not first:
                        try self.put(", \" \", ")
                    first = false
                    let v = a.left else return
                    try self.show(v)
                    cursor = a.next
                if n == 0:
                    try self.put("\"\"")
                try self.put("])")
            try self.put(")")
            return
        let first = e.body else return
        let arg = first.left else return
        if name == "assert":
            # `if not c: trap("assert failed: m")`, the trap the interpreter reports
            try self.put("if not (")
            try self.expr(arg)
            try self.put("): trap(")
            if let second = first.next:
                let m = second.left else return
                try self.put("kernel.concat(\"assert failed: \", ")
                try self.expr(m)
                try self.put(")")
            else:
                try self.put("\"assert failed\"")
            try self.put(")")
            return
        if name == "trap":
            try self.put("trap(")
            try self.expr(arg)
            try self.put(")")
            return
        if name == "error":
            let second = first.next else return
            let m = second.left else return
            try self.put("error(")
            try self.expr(arg)
            try self.put(", ")
            try self.expr(m)
            try self.put(")")
            return
        if name == "discard":
            try self.put("discard(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "Weak":
            try self.put("heap.weak_make((heap.Object*)")
            try self.use(arg)
            try self.put(")")
            return
        let t = arg.type_id
        if name == "int":
            try self.put("kernel.to_int(" if t == types.float_id else "kernel.parse_int(")
            try self.expr(arg)
            try self.put(")")
            return
        if name == "float":
            try self.put("f64(" if t == types.int_id else "kernel.parse_float(")
            try self.expr(arg)
            try self.put(")")
            return
        if name == "bool":
            try self.put("kernel.parse_bool(")
            try self.expr(arg)
            try self.put(")")
            return
        if name == "str":
            try self.show(arg)
            return
        return try self.fail(e, "a core call this slice does not compile")

    ## The display of a value as an expression of type `str`.
    mutating func show(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.use(v)
            return
        try self.put(try self.show_name(t))
        try self.put("(")
        try self.use(v)
        try self.put(")")

    ## The function that displays a value of type `t`, emitted after the program.
    mutating func show_name(t: u32) -> str!:
        match self.checker.table.kind(t):
            .int_: return "kernel.show_int"
            .str_: return "kernel.show_text"
            .float_: return "kernel.show_float"
            .bool_: return "kernel.show_bool"
            .bytes_: return "kernel.show_bytes"
            .range_: return "kernel.show_range"
            _: discard(0)
        var i: usize = 0
        var seen = false
        while i < self.shown.count:
            if self.shown.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.shown.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"show_{t}"))

    ## The name of the copy, drop, trace, pool, identity or weak-get function of a type,
    ## which is emitted after the program.
    mutating func lifetime_name(prefix: str, t: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.lifetimes.count:
            if self.lifetimes.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.lifetimes.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"{prefix}{t}"))

    ## The functions of every type holding references the program used, and of the types
    ## those reach; the list grows while it is walked.
    mutating func lifetime_functions() -> !:
        var i: usize = 0
        while i < self.lifetimes.count:
            let t = self.lifetimes.get(i)
            try self.lifetime_function_set(t)
            i += 1

    mutating func lifetime_function_set(id: u32) -> !:
        let t = self.checker.table.get(id)
        # copy: a reference of its own to every object held
        try self.lifetime_head("L_copy_", id, ") -> ", id)
        self.indent += 1
        match t.kind:
            .class_:
                try self.begin("return (")
                try self.type_of(id)
                try self.put(")heap.retain((heap.Object*)v)")
                try self.end()
            .weak_: try self.line("return heap.weak_copy(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.lifetime_name("L_copy_", t.elem))
                try self.put("(inner)")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.member_copy(t.args[i], "v.", i)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_:
                try self.line("var out = v")
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("out.L_")
                        try self.put(m.text)
                        try self.put(" = ")
                        try self.put(try self.lifetime_name("L_copy_", m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        try self.begin(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        var p = m.body
                        var first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            p = field.next
                        try self.put("): return L_")
                        try self.put(t.name)
                        try self.put(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        p = m.body
                        first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            try self.put(" = ")
                            if self.checker.table.has_references(field.type_id):
                                try self.put(try self.lifetime_name("L_copy_", field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                            else:
                                try self.put("L_")
                                try self.put(field.text)
                            p = field.next
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("_: return v")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot copy")
        self.indent -= 1
        try self.line("")
        # drop and trace: every object held, a class field of zero (never assigned) skipped
        try self.lifetime_head("L_drop_", id, "):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_drop_", "")
        self.indent -= 1
        try self.line("")
        try self.lifetime_head("L_trace_", id, ", visit: func(heap.Object*, void*) -> unit, context: void*):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_trace_", ", visit, context")
        self.indent -= 1
        try self.line("")
        # pool: a temporary of the statement, and the drop through a pointer it needs
        try self.lifetime_head("L_pool_", id, ") -> ", id)
        self.indent += 1
        if t.kind == types.Kind.class_:
            try self.begin("return (")
            try self.type_of(id)
            try self.put(")heap.pool_object((heap.Object*)v)")
            try self.end()
        else:
            try self.begin("return heap.pool_value[")
            try self.type_of(id)
            try self.put("](v, ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put(")")
            try self.end()
        self.indent -= 1
        try self.line("")
        if t.kind != types.Kind.class_:
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put("(p: void*):")
            try self.end()
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", id))
            try self.put("(memory.read[")
            try self.type_of(id)
            try self.put("](p))")
            try self.end()
            try self.line("")
        # identity, and a weak reference's get, for a class and its optional
        if t.kind == types.Kind.class_ or (t.kind == types.Kind.optional and self.checker.table.kind(t.elem) == types.Kind.class_):
            try self.lifetime_head("L_id_", id, ") -> usize:", types.none_id)
            if t.kind == types.Kind.class_:
                try self.line("    return (usize)v")
            else:
                try self.line("    if let o = v:")
                try self.line("        return (usize)o")
                try self.line("    return 0")
            try self.line("")
        if t.kind == types.Kind.class_:
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_weak_get_", id))
            try self.put("(w: heap.Weak) -> ")
            try self.type_of(id)
            try self.put("?:")
            try self.end()
            try self.line("    if let o = heap.weak_get(w):")
            try self.begin("        return (")
            try self.type_of(id)
            try self.put(")o")
            try self.end()
            try self.line("    return none")
            try self.line("")

    ## `func NAME(v: T` and what follows; a result type when `result` is given.
    mutating func lifetime_head(prefix: str, id: u32, tail: str, result: u32) -> !:
        try self.begin("func ")
        try self.put(try self.lifetime_name(prefix, id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(tail)
        if result != types.none_id:
            try self.type_of(result)
            try self.put(":")
        try self.end()

    ## One member of a tuple copy: copied when it holds references.
    mutating func member_copy(t: u32, prefix: str, i: usize) -> !:
        if self.checker.table.has_references(t):
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
            try self.put(prefix)
            try self.put_u64((u64)i)
            try self.put(")")
        else:
            try self.put(prefix)
            try self.put_u64((u64)i)

    ## The body of a drop or trace: the call `prefix` on every part holding references,
    ## `extra` appended to the arguments.
    mutating func walk_references(t: types.Type, id: u32, prefix: str, extra: str) -> !:
        match t.kind:
            .class_:
                try self.line("if (usize)v != 0:")
                if prefix == "L_drop_":
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("    visit((heap.Object*)v, context)")
            .weak_:
                if prefix == "L_drop_":
                    try self.line("heap.weak_drop(v)")
                else:
                    try self.line("discard(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    ")
                try self.put(try self.lifetime_name(prefix, t.elem))
                try self.put("(inner")
                try self.put(extra)
                try self.put(")")
                try self.end()
            .tuple:
                var i: usize = 0
                var any = false
                while i < t.args.length:
                    if self.checker.table.has_references(t.args[i]):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, t.args[i]))
                        try self.put("(v.")
                        try self.put_u64((u64)i)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    i += 1
                if not any:
                    try self.line("discard(v)")
            .struct_:
                let d = t.decl else return
                var cursor = d.body
                var any = false
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    cursor = m.next
                if not any:
                    try self.line("discard(v)")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        var holds = false
                        var p = m.body
                        while let field = p:
                            if self.checker.table.has_references(field.type_id):
                                holds = true
                            p = field.next
                        if holds:
                            try self.begin(".L_")
                            try self.put(m.text)
                            try self.put("(")
                            p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                if self.checker.table.has_references(field.type_id):
                                    try self.put("L_")
                                    try self.put(field.text)
                                else:
                                    try self.put("_")
                                p = field.next
                            try self.put("):")
                            try self.end()
                            self.indent += 1
                            p = m.body
                            while let field = p:
                                if self.checker.table.has_references(field.type_id):
                                    try self.begin("")
                                    try self.put(try self.lifetime_name(prefix, field.type_id))
                                    try self.put("(L_")
                                    try self.put(field.text)
                                    try self.put(extra)
                                    try self.put(")")
                                    try self.end()
                                p = field.next
                            self.indent -= 1
                    cursor = m.next
                try self.line("_: discard(0)")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot walk")

    mutating func show_functions() -> !:
        var i: usize = 0
        while i < self.shown.count:
            let t = self.shown.get(i)
            try self.show_function(t)
            i += 1

    mutating func show_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        let name = try self.show_name(id)
        try self.begin("func ")
        try self.put(name)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> str:")
        try self.end()
        self.indent += 1
        match t.kind:
            .unit_: try self.line("return \"()\"")
            .error_code: try self.line("return kernel.join([\"ErrorCode(\", kernel.show_int((i64)v), \")\"])")
            .error_value: try self.line("return v.message")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.show_name(t.elem))
                try self.put("(inner)")
                try self.end()
                try self.line("return \"none\"")
            .tuple:
                try self.begin("return kernel.join([\"(\", ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", \", \", ")
                    try self.put(try self.show_name(t.args[i]))
                    try self.put("(v.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    i += 1
                if t.args.length == 1:
                    try self.put(", \",\"")
                try self.put(", \")\"])")
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.begin("return kernel.join([\"")
                try self.put(d.text)
                try self.put("(\"")
                var cursor = d.body
                var first = true
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        try self.put(", \"")
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put(m.text)
                        try self.put(" = \", ")
                        try self.put(try self.show_name(m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                    cursor = m.next
                try self.put(", \")\"])")
                try self.end()
            .enum_:
                let d = t.decl else return
                try self.line("match v:")
                self.indent += 1
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        try self.begin("    return kernel.join([\"")
                        try self.put(d.text)
                        try self.put(".")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(\"")
                            var p = m.body
                            var first = true
                            while let field = p:
                                try self.put(", \"")
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put(field.text)
                                try self.put(" = \", ")
                                try self.put(try self.show_name(field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                                p = field.next
                            try self.put(", \")\"])")
                        else:
                            try self.put("\"])")
                        try self.end()
                    cursor = m.next
                self.indent -= 1
            _: return try self.checker.fail(self.checker.tree(), "a value this slice does not display")
        self.indent -= 1
        try self.line("")

    ## The pieces of a formatted text, joined.
    mutating func formatted(e: ast.Node*) -> !:
        try self.put("kernel.join([")
        var cursor = e.body
        var first = true
        while let part = cursor:
            if not first:
                try self.put(", ")
            first = false
            if part.kind == ast.Kind.format_text:
                try self.text_literal(try unescape_format(part.text), false)
            else:
                let v = part.left else return
                try self.show(v)
            cursor = part.next
        if first:
            try self.put("\"\"")
        try self.put("])")

    mutating func match_expr(e: ast.Node*) -> !:
        let subject = e.left else return
        let st = self.checker.table.get(subject.type_id)
        if st.kind == types.Kind.tuple:
            return try self.fail(e, "a match expression over a tuple compiles in a later slice; use the statement form")
        try self.put("match ")
        try self.use(subject)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = e.body
        var bound_any = false
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, "", &bound)
                p = pattern.next
            if bound != none:
                return try self.fail(arm, "a name pattern in a match expression compiles in a later slice; use the statement form")
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(" => ")
            let body = arm.body else return
            try self.owned(body)
            try self.end()
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(e):
            try self.line("_ => trap(\"no arm applied\")")
        self.indent -= 1
        try self.begin("")

## Whether every pattern in the list matches anything: `_`, a name, a tuple of those.
func irrefutable(patterns: ast.Node*?) -> bool:
    var cursor = patterns
    while let p = cursor:
        if p.text == "tuple":
            if not irrefutable(p.body):
                return false
        elif not (p.has(ast.flag_wildcard) or p.text == "bind"):
            return false
        cursor = p.next
    return true

func has_wildcard_arm(s: ast.Node*) -> bool:
    var cursor = s.body
    while let arm = cursor:
        var p = arm.left
        while let pattern = p:
            if (pattern.has(ast.flag_wildcard) or pattern.text == "bind") and arm.right == none:
                return true
            p = pattern.next
        cursor = arm.next
    return false

## `<` for `<=`, `>` for `>=`: the strict form of an order, for a tuple's earlier members.
func strict(op: str) -> str:
    if op == "<=":
        return "<"
    if op == ">=":
        return ">"
    return op

## `{{` and `}}` in the literal part of a formatted string are one brace each.
func unescape_format(text: str) -> str!:
    let b = text.bytes
    var out = try alloc u8[b.length + 1]
    var n: usize = 0
    var i: usize = 0
    while i < b.length:
        if (b[i] == '{' or b[i] == '}') and i + 1 < b.length and b[i + 1] == b[i]:
            out[n] = b[i]
            n += 1
            i += 2
            continue
        if b[i] == '\\' and i + 1 < b.length:
            let e = b[i + 1]
            out[n] = '\n' if e == 'n' else '\t' if e == 't' else '\r' if e == 'r' else 0 if e == '0' else e
            n += 1
            i += 2
            continue
        out[n] = b[i]
        n += 1
        i += 1
    return (str)out[..<n]

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

## A name kept on the heap, since the scratch it was formatted in is reused.
func copy_name(text: str) -> str!:
    var out = try alloc u8[text.length]
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    return (str)out
