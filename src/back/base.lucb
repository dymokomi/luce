#==============================================================================================
#
#   base - The typed tree written out as Base
#
#   DESCRIPTION:
#       Base is the machine form. The translation is close to an isomorphism: a Luce local is
#       a Base local, a struct a struct, an enum an enum, `if`, `while`, `match`, `break` and
#       `continue` are themselves, and checked `int` arithmetic is Base's own, so a trap is
#       the operator. What Base does not spell, Python's `//`, `%` and `**`, text made of
#       pieces, the display of a value, Luce's indexes and slices, is a call into `rt.kernel`.
#       Every name a program wrote is prefixed `L_`, since Base reserves words Luce does not.
#       Objects follow docs/RUNTIME.md: `expr` writes a borrowed value for a read of a
#       binding and an owned one for everything else, `owned` and `use` say which a place
#       needs, a binding drops what it owned when its block ends, and a statement whose
#       expression pooled a temporary is wrapped in a mark and a drain. Nothing here
#       decides a language question: the checker already did.
#
#==============================================================================================

import front.ast
import sema.check
import sema.bodies
import sema.types
import support.buffer
import support.list
import support.literals

pub let unsupported: ErrorCode = ErrorCode.package(15)

pub struct Emitter:
    var checker: check.Checker*
    var out: buffer.Buffer
    var indent: u32
    var temps: u32
    ## Types whose display function is needed, emitted after the program.
    var shown: list.List[u32]
    ## Types holding references, whose copy, drop, trace and pool functions are emitted
    ## after the program.
    var lifetimes: list.List[u32]
    ## Types whose `==` and ordering need a function of their own (collections, and what
    ## holds them), emitted after the program.
    var equalities: list.List[u32]
    var orderings: list.List[u32]
    ## Types hashed (§4.4) and types that are a collection's elements, each with a
    ## function or an operations table of its own after the program.
    var hashes: list.List[u32]
    var ops_types: list.List[u32]
    ## Text and bytes literals, each an immortal object declared after the program; the
    ## text, and whether it is bytes.
    var texts: list.List[str]
    var texts_are_bytes: list.List[bool]
    var texts_done: usize
    ## How many of each list are written out, since writing one set of functions can
    ## register more; `support_functions` runs until nothing new appears.
    var shown_done: usize
    var lifetimes_done: usize
    var equalities_done: usize
    var orderings_done: usize
    var hashes_done: usize
    var ops_done: usize
    ## Whether the statement being written pooled a temporary, so it needs a drain.
    var pooled: bool
    ## Whether the function being written can fail, so that a drain on the failing path
    ## (`errdefer`) is possible and needed.
    var fallible: bool
    ## Inside a match statement, where a bound payload is copied at the arm's start and
    ## the pattern writes its raw name; a match expression borrows the payload as is.
    var raw_payloads: bool
    ## Inside an enum's or a class's method, where `self` is an ordinary parameter.
    var self_name: str

    pub static func over(checker: check.Checker*) -> Emitter!:
        return Emitter(checker = checker, out = try buffer.Buffer.create(65536), indent = 0, temps = 0,
                       shown = try list.List[u32].create(16), lifetimes = try list.List[u32].create(16),
                       equalities = try list.List[u32].create(16), orderings = try list.List[u32].create(16),
                       hashes = try list.List[u32].create(16), ops_types = try list.List[u32].create(16),
                       texts = try list.List[str].create(64), texts_are_bytes = try list.List[bool].create(64), texts_done = 0,
                       shown_done = 0, lifetimes_done = 0, equalities_done = 0, orderings_done = 0, hashes_done = 0, ops_done = 0,
                       pooled = false, fallible = false, raw_payloads = false, self_name = "self")

    pub func text() -> str:
        return self.out.view()

    # -- writing --------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        try self.out.put(text)

    mutating func line(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)
        try self.out.put("\n")

    mutating func begin(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)

    mutating func end() -> !:
        try self.out.put("\n")

    func fail(node: ast.Node*, what: str) -> never!:
        return try self.checker.fail(node, what)

    mutating func temp(prefix: str) -> str!:
        self.temps += 1
        let half = self.checker.scratch.length // 2
        # an underscore keeps `i16` and the like from becoming Base's type names
        let name = try format(self.checker.scratch[half..], f"{prefix}_{self.temps}")
        return try copy_name(name)

    ## The text written since `start`, taken back out of the output.
    mutating func capture(start: usize) -> str!:
        let text = try copy_name((str)self.out.bytes()[start..])
        self.out.used = start
        return text

    ## A statement's text wrapped in a mark and a drain when it pooled a temporary.
    mutating func drained(start: usize, pooled_before: bool) -> !:
        if self.pooled:
            let text = try self.capture(start)
            let m = try self.temp("mark")
            try self.begin("let ")
            try self.put(m)
            try self.put(" = heap.mark()")
            try self.end()
            if self.fallible:
                try self.begin("errdefer heap.drain(")
                try self.put(m)
                try self.put(")")
                try self.end()
            try self.put(text)
            try self.begin("heap.drain(")
            try self.put(m)
            try self.put(")")
            try self.end()
        self.pooled = pooled_before

    # -- the program ----------------------------------------------------------------------

    pub mutating func program() -> !:
        let tree = self.checker.tree()
        try self.line("## generated by luce; edit the .luc source, not this")
        try self.line("import memory")
        try self.line("import rt.heap")
        try self.line("import rt.kernel")
        try self.line("")
        var cursor = tree.body
        while let d = cursor:
            match d.kind:
                .constant: try self.constant(d)
                .struct_: try self.struct_decl(d)
                .enum_: try self.enum_decl(d)
                .class_: try self.class_decl(d)
                .interface_: return try self.fail(d, "interfaces compile in the interfaces slice")
                .type_alias: discard(0)
                .func_: try self.function(d, "")
                .test_: discard(0)
                _: discard(0)
            cursor = d.next
        let args_type = try self.checker.table.list_of(types.str_id)
        let args_info = try self.lifetime_name("L_info_", args_type)
        let args_ops = try self.ops_name(types.str_id)
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    kernel.startup()")
        try self.begin("    let args = kernel.list_from_args(&")
        try self.put(args_info)
        try self.put(", ")
        try self.put(args_ops)
        try self.put(", arguments[1..])")
        try self.end()
        try self.line("    let status = L_main(args) catch failure:")
        try self.line("        kernel.print_error(failure.message)")
        try self.line("        return 1")
        try self.line("    heap.release((heap.Object*)args)")
        try self.line("    return heap.finish_run(i32(status))")
        try self.support_functions()

    mutating func constant(d: ast.Node*) -> !:
        let init = d.left else return
        try self.begin("let L_")
        try self.put(d.text)
        try self.put(": ")
        try self.type_of(d.type_id)
        try self.put(" = ")
        try self.expr(init)
        try self.end()
        try self.line("")

    mutating func struct_decl(d: ast.Node*) -> !:
        try self.begin("struct L_")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        var fields: u32 = 0
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
                fields += 1
            cursor = m.next
        if fields == 0:
            try self.line("pub var nothing: u8")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.line("")
                try self.function(m, "method")
            cursor = m.next
        self.indent -= 1
        try self.line("")

    ## A class: a Base struct with the runtime's header first, its methods as free functions
    ## over a pointer, the descriptor the runtime destroys and traces it by, and `new`.
    mutating func class_decl(d: ast.Node*) -> !:
        let name = d.text
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("var header: heap.Object")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        cursor = d.body
        var init: ast.Node*? = none
        var has_deinit = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, name)
                if m.text == "init":
                    init = m
                if m.text == "deinit":
                    has_deinit = true
            cursor = m.next
        if has_deinit:
            try self.begin("func L_")
            try self.put(name)
            try self.put("__finish(o: heap.Object*):")
            try self.end()
            try self.begin("    L_")
            try self.put(name)
            try self.put("__L_deinit((L_")
            try self.put(name)
            try self.put("*)o)")
            try self.end()
            try self.line("")
        # the fields go last first; one never assigned (an `init` that failed) is zero and
        # every drop below tolerates that
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        var fields = try list.List[ast.Node*].create(8)
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try fields.push(m)
            cursor = m.next
        var i = fields.count
        var any = false
        while i > 0:
            i -= 1
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(")")
                try self.end()
                any = true
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        any = false
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(", visit, context)")
                try self.end()
                any = true
            i += 1
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(name)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = ")
        if has_deinit:
            try self.put("L_")
            try self.put(name)
            try self.put("__finish")
        else:
            try self.put("none")
        try self.put(", drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        # construction: the block, the defaults, then `init`; a failing `init` abandons it
        var fallible = false
        if let f = init:
            let result = self.checker.table.get(f.type_id).elem
            fallible = self.checker.table.kind(result) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(name)
        try self.put("__new(")
        if let f = init:
            var first = true
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(param.text)
                    try self.put(": ")
                    try self.type_of(param.type_id)
                pc = param.next
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*!:" if fallible else "*:")
        try self.end()
        self.indent += 1
        self.fallible = fallible
        try self.begin("let L_self = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if let default = f.left:
                try self.begin("L_self.L_")
                try self.put(f.text)
                try self.put(" = ")
                try self.owned(default)
                try self.end()
            i += 1
        if let f = init:
            try self.begin("")
            try self.put("L_")
            try self.put(name)
            try self.put("__L_init(L_self")
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    try self.put(", L_")
                    try self.put(param.text)
                pc = param.next
            try self.put(")")
            if fallible:
                try self.put(" catch failure:")
                try self.end()
                try self.line("    heap.abandon((heap.Object*)L_self)")
                try self.line("    error(failure.code, failure.message)")
            else:
                try self.end()
        try self.line("return L_self")
        self.indent -= 1
        try self.line("")

    mutating func enum_decl(d: ast.Node*) -> !:
        try self.begin("enum L_")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin("L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        try self.put(": ")
                        try self.type_of(field.type_id)
                        p = field.next
                    try self.put(")")
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        # an enum's methods are free functions over it, `self` an ordinary parameter
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, d.text)
            cursor = m.next

    ## `owner` is "" for a free function, "method" for a struct's, an enum's name for its.
    mutating func function(f: ast.Node*, owner: str) -> !:
        let t = self.checker.table.get(f.type_id)
        self.fallible = self.checker.table.kind(t.elem) == types.Kind.fallible
        var prefix = "func L_"
        if owner == "method":
            if not check.has_self(f):
                prefix = "static func L_"
            elif f.has(check.flag_mutating):
                prefix = "mutating func L_"
        try self.begin(prefix)
        if owner != "" and owner != "method":
            try self.put(owner)
            try self.put("__L_")
        try self.put(f.text)
        try self.put("(")
        var first = true
        var cursor = f.right
        self.self_name = "self"
        while let p = cursor:
            if p.text == "self":
                if owner != "method":
                    try self.put("L_self: L_")
                    try self.put(owner)
                    if let od = self.checker.find_declaration(owner):
                        if od.kind == ast.Kind.class_:
                            try self.put("*")
                    first = false
                    self.self_name = "L_self"
            else:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if t.elem != types.unit_id:
            try self.put(" -> ")
            try self.type_of(t.elem)
        elif self.checker.table.kind(t.elem) == types.Kind.fallible:
            try self.put(" -> !")
        try self.put(":")
        try self.end()
        let body = f.body else return
        self.indent += 1
        try self.block(body)
        self.indent -= 1
        try self.line("")
        self.self_name = "self"

    # -- types ----------------------------------------------------------------------------

    pub mutating func type_of(id: u32) -> !:
        let t = self.checker.table.get(id)
        match t.kind:
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("kernel.Text*")
            .bytes_: try self.put("kernel.Bytes*")
            .unit_: try self.put("unit")
            .never_: try self.put("never")
            .error_code: try self.put("ErrorCode")
            .error_value: try self.put("Error")
            .range_: try self.put("kernel.Range")
            .optional:
                try self.type_of(t.elem)
                try self.put("?")
            .fallible:
                if t.elem == types.unit_id:
                    try self.put("!")
                else:
                    try self.type_of(t.elem)
                    try self.put("!")
            .tuple:
                try self.put("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                try self.put(")")
            .func_:
                try self.put("func(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                try self.put(")")
                if t.elem != types.unit_id:
                    try self.put(" -> ")
                    try self.type_of(t.elem)
            .list_:
                try self.put("kernel.List[")
                try self.type_of(t.elem)
                try self.put("]*")
            .map_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", ")
                try self.type_of(self.checker.table.map_value(id))
                try self.put("]*")
            .set_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", u8]*")
            .struct_, .enum_:
                try self.put("L_")
                try self.put(t.name)
            .class_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("*")
            .weak_:
                try self.put("heap.Weak")
            _:
                error(unsupported, "a type this slice does not compile")

    # -- statements -----------------------------------------------------------------------

    mutating func block(b: ast.Node*) -> !:
        if b.body == none:
            try self.line("discard(0)")
            return
        var cursor = b.body
        while let s = cursor:
            try self.statement(s)
            cursor = s.next

    ## One statement; whatever it pooled is drained when it ends (RUNTIME 5).
    mutating func statement(s: ast.Node*) -> !:
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        match s.kind:
            .let_, .var_: try self.binding(s)
            .assign: try self.assign(s)
            .if_: try self.if_statement(s)
            .while_: try self.while_statement(s)
            .for_: try self.for_statement(s)
            .match_: try self.match_statement(s)
            .with_: try self.with_statement(s)
            .return_: try self.return_statement(s)
            .break_, .continue_:
                try self.begin("break" if s.kind == ast.Kind.break_ else "continue")
                if s.text.length > 0:
                    try self.put(" ")
                    try self.put(s.text)
                try self.end()
            .recover_:
                let v = s.left else return
                try self.begin("recover ")
                try self.owned(v)
                try self.end()
            .expr_stmt:
                let e = s.left else return
                try self.begin("")
                if e.type_id != types.unit_id and e.type_id != types.never_id:
                    try self.put("discard(")
                    try self.use(e)
                    try self.put(")")
                else:
                    try self.use(e)
                try self.end()
            _: return try self.fail(s, "a statement this slice does not compile")
        try self.drained(start, pooled_before)

    ## `defer` the drop of a binding that owns references, right after it.
    mutating func drop_at_exit(name: str, t: u32) -> !:
        if not self.checker.table.has_references(t):
            return
        try self.begin("defer ")
        try self.put(try self.lifetime_name("L_drop_", t))
        try self.put("(L_")
        try self.put(name)
        try self.put(")")
        try self.end()

    ## `return e`: the value is owned by the caller; the statement's temporaries die after
    ## it is computed and before the function's bindings (RUNTIME 5).
    mutating func return_statement(s: ast.Node*) -> !:
        let v = s.left else return try self.line("return")
        let start = self.out.used
        try self.owned(v)
        let text = try self.capture(start)
        if self.pooled:
            let r = try self.temp("result")
            try self.begin("let ")
            try self.put(r)
            try self.put(" = ")
            try self.put(text)
            try self.end()
            try self.drained(start, true)
            self.pooled = false
            try self.begin("return ")
            try self.put(r)
            try self.end()
            return
        try self.begin("return ")
        try self.put(text)
        try self.end()

    mutating func binding(s: ast.Node*) -> !:
        let init = s.left else return
        let word = "let " if s.kind == ast.Kind.let_ else "var "
        try self.begin(word)
        if s.body != none:
            try self.put("(")
            var cursor = s.body
            var first = true
            while let part = cursor:
                if not first:
                    try self.put(", ")
                first = false
                if part.has(ast.flag_wildcard):
                    try self.put("_")
                else:
                    try self.put("L_")
                    try self.put(part.text)
                cursor = part.next
            try self.put(")")
        else:
            try self.put("L_")
            try self.put(s.text)
            try self.put(": ")
            try self.type_of(s.type_id)
        try self.put(" = ")
        try self.owned(init)
        try self.end()
        if s.body != none:
            var cursor = s.body
            while let part = cursor:
                if not part.has(ast.flag_wildcard):
                    try self.drop_at_exit(part.text, part.type_id)
                cursor = part.next
        else:
            try self.drop_at_exit(s.text, s.type_id)

    ## The new value is computed and stored, then the old one dropped (RUNTIME 1, 2).
    mutating func assign(s: ast.Node*) -> !:
        let place = s.left else return
        let value = s.right else return
        if place.kind == ast.Kind.tuple:
            let t = try self.temp("tuple")
            try self.begin("let ")
            try self.put(t)
            try self.put(" = ")
            try self.owned(value)
            try self.end()
            var i: usize = 0
            var cursor = place.body
            while let part = cursor:
                let half = self.checker.scratch.length // 2
                let member = try copy_name(try format(self.checker.scratch[half..], f"{t}.{i}"))
                try self.store(part, member)
                i += 1
                cursor = part.next
            return
        if place.kind == ast.Kind.index:
            let receiver = place.left else return
            let index = place.body else return
            if self.checker.table.kind(receiver.type_id) == types.Kind.map_:
                # `m[key] = v`: an insertion or a replacement, the map's own key and value
                try self.begin("kernel.map_set[")
                try self.map_types(receiver.type_id)
                try self.put("](")
                try self.use(receiver)
                try self.put(", ")
                try self.owned(index)
                try self.put(", ")
                try self.owned(value)
                try self.put(")")
                try self.end()
                return
            if self.checker.table.kind(receiver.type_id) == types.Kind.list_:
                # `values[i] = x`, or `values[i] op= x` as the operation then the store
                try self.begin("kernel.list_set[")
                try self.type_of(place.type_id)
                try self.put("](")
                try self.use(receiver)
                try self.put(", ")
                try self.use(index)
                try self.put(", ")
                if s.text == "=":
                    try self.owned(value)
                else:
                    let op = (str)s.text.bytes[..<s.text.length - 1]
                    try self.arithmetic(op, place.type_id, place, value)
                try self.put(")")
                try self.end()
                return
        if s.text == "=" and self.checker.table.has_references(place.type_id):
            let n = try self.temp("new")
            try self.begin("let ")
            try self.put(n)
            try self.put(": ")
            try self.type_of(place.type_id)
            try self.put(" = ")
            try self.owned(value)
            try self.end()
            try self.store(place, n)
            return
        try self.begin("")
        try self.place_expr(place)
        if s.text == "=" or s.text == "+=" and place.type_id != types.str_id or s.text == "-=" or s.text == "*=" or (s.text == "/=" and place.type_id == types.float_id):
            try self.put(" ")
            try self.put(s.text)
            try self.put(" ")
            try self.expr(value)
            try self.end()
            return
        # `//=`, `%=`, `**=`, and `+=` on text are the operation then the store
        try self.put(" = ")
        let op = (str)s.text.bytes[..<s.text.length - 1]
        try self.arithmetic(op, place.type_id, place, value)
        try self.end()

    ## `place = name`, the old value dropped after the store when it held references.
    mutating func store(place: ast.Node*, name: str) -> !:
        if place.kind == ast.Kind.index:
            let receiver = place.left else return
            let index = place.body else return
            try self.begin("kernel.list_set[")
            try self.type_of(place.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(", ")
            try self.use(index)
            try self.put(", ")
            try self.put(name)
            try self.put(")")
            try self.end()
            return
        if self.checker.table.has_references(place.type_id):
            let old = try self.temp("old")
            try self.begin("let ")
            try self.put(old)
            try self.put(" = ")
            try self.place_expr(place)
            try self.end()
            try self.begin("")
            try self.place_expr(place)
            try self.put(" = ")
            try self.put(name)
            try self.end()
            try self.begin("")
            try self.put(try self.lifetime_name("L_drop_", place.type_id))
            try self.put("(")
            try self.put(old)
            try self.put(")")
            try self.end()
            return
        try self.begin("")
        try self.place_expr(place)
        try self.put(" = ")
        try self.put(name)
        try self.end()

    ## A place as written: no copy is taken of a field on the way.
    mutating func place_expr(e: ast.Node*) -> !:
        match e.kind:
            .name, .self_, .group, .index: try self.expr(e)
            .member:
                let receiver = e.left else return
                try self.place_expr(receiver)
                try self.put(".L_")
                try self.put(e.text)
            _: return try self.fail(e, "this is not a place the emitter knows")

    mutating func put_u64(n: u64) -> !:
        try self.out.put_u64(n)

    ## The condition of an `if` or `while`, hoisted into a binding when it pooled a
    ## temporary, so that the temporary dies before the body runs (RUNTIME 5). The name
    ## of what to test, or the condition's text.
    mutating func hoisted_condition(s: ast.Node*) -> str!:
        let cond = s.left else return ""
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        if s.has(ast.flag_if_let):
            let init = cond.left else return ""
            try self.owned(init)
        else:
            try self.use(cond)
        let text = try self.capture(start)
        if not self.pooled:
            self.pooled = pooled_before
            return text
        let c = try self.temp("cond")
        try self.begin("let ")
        try self.put(c)
        try self.put(" = ")
        try self.put(text)
        try self.end()
        try self.drained(start, pooled_before)
        return c

    mutating func if_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let value = try self.hoisted_condition(s)
        try self.begin("if ")
        if s.has(ast.flag_if_let):
            try self.put("let L_")
            try self.put(cond.text)
            try self.put(" = ")
        try self.put(value)
        try self.put(":")
        try self.end()
        let body = s.body else return
        self.indent += 1
        if s.has(ast.flag_if_let):
            try self.drop_at_exit(cond.text, cond.type_id)
        try self.block(body)
        self.indent -= 1
        if let rest = s.right:
            try self.line("else:")
            self.indent += 1
            if rest.kind == ast.Kind.if_:
                try self.statement(rest)
            else:
                try self.block(rest)
            self.indent -= 1

    mutating func while_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let body = s.body else return
        # the condition is evaluated inside the loop, so it is written there
        try self.begin("")
        if s.text.length > 0:
            try self.put(s.text)
            try self.put(": ")
        try self.put("while true:")
        try self.end()
        self.indent += 1
        let value = try self.hoisted_condition(s)
        if s.has(ast.flag_if_let):
            try self.begin("if let L_")
            try self.put(cond.text)
            try self.put(" = ")
            try self.put(value)
            try self.put(":")
            try self.end()
            self.indent += 1
            try self.drop_at_exit(cond.text, cond.type_id)
            try self.block(body)
            self.indent -= 1
            try self.line("else:")
            try self.line("    break")
        else:
            try self.begin("if not (")
            try self.put(value)
            try self.put("):")
            try self.end()
            try self.line("    break")
            try self.block(body)
        self.indent -= 1

    ## `with e as x:` is a block that binds, closes on every exit, then drops (§8.5).
    mutating func with_statement(s: ast.Node*) -> !:
        let body = s.body else return
        try self.line("if true:")
        self.indent += 1
        var cursor = s.left
        while let item = cursor:
            let e = item.left else return
            let close = item.resolved else return
            try self.begin("let L_")
            try self.put(item.text)
            try self.put(" = ")
            try self.owned(e)
            try self.end()
            try self.drop_at_exit(item.text, item.type_id)
            let t = self.checker.table.get(item.type_id)
            try self.begin("defer ")
            if t.kind == types.Kind.class_ or t.kind == types.Kind.enum_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("__L_close(L_")
                try self.put(item.text)
                try self.put(")")
            else:
                try self.put("L_")
                try self.put(item.text)
                try self.put(".L_close()")
            try self.end()
            cursor = item.next
        try self.block(body)
        self.indent -= 1



    mutating func for_statement(s: ast.Node*) -> !:
        let binding = s.left else return
        let seq = s.right else return
        let body = s.body else return
        let st = self.checker.table.get(seq.type_id)
        let label = s.text
        match st.kind:
            .range_:
                # a written range iterates directly; a range value through its bounds
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for L_")
                try self.put(binding.text)
                try self.put(" in ")
                if seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..="):
                    let l = seq.left else return
                    let r = seq.right else return
                    try self.expr(l)
                    try self.put(seq.text)
                    try self.expr(r)
                else:
                    let t = try self.temp("range")
                    try self.put(t)
                    try self.put(".low..<kernel.range_end(")
                    try self.put(t)
                    try self.put(")")
                try self.put(":")
                try self.end()
                if not (seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..=")):
                    return try self.fail(seq, "a range value in `for` compiles in the collections slice")
                self.indent += 1
                try self.block(body)
                self.indent -= 1
            .str_:
                let it = try self.temp("scalars")
                try self.begin("var ")
                try self.put(it)
                try self.put(" = kernel.Scalars.over(")
                try self.use(seq)
                try self.put(")")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while let L_")
                try self.put(binding.text)
                try self.put(" = ")
                try self.put(it)
                try self.put(".next():")
                try self.end()
                self.indent += 1
                try self.drop_at_exit(binding.text, types.str_id)
                try self.block(body)
                self.indent -= 1
            .bytes_:
                let raw = try self.temp("byte")
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for ")
                try self.put(raw)
                try self.put(" in (")
                try self.use(seq)
                try self.put(").data:")
                try self.end()
                self.indent += 1
                try self.begin("let L_")
                try self.put(binding.text)
                try self.put(" = (i64)")
                try self.put(raw)
                try self.end()
                try self.block(body)
                self.indent -= 1
            .list_:
                # the runtime's protocol: the check, the bound, the element, the step, the body
                let store = try self.temp("store")
                let version = try self.temp("version")
                let i = try self.temp("i")
                try self.begin("let ")
                try self.put(store)
                try self.put(" = ")
                try self.use(seq)
                try self.end()
                try self.begin("let ")
                try self.put(version)
                try self.put(" = ")
                try self.put(store)
                try self.put(".version")
                try self.end()
                try self.begin("var ")
                try self.put(i)
                try self.put(": usize = 0")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while true:")
                try self.end()
                self.indent += 1
                try self.begin("kernel.list_check[")
                try self.type_of(st.elem)
                try self.put("](")
                try self.put(store)
                try self.put(", ")
                try self.put(version)
                try self.put(")")
                try self.end()
                try self.begin("if ")
                try self.put(i)
                try self.put(" >= ")
                try self.put(store)
                try self.put(".count:")
                try self.end()
                try self.line("    break")
                try self.begin("let L_")
                try self.put(binding.text)
                try self.put(" = ")
                if self.checker.table.has_references(st.elem):
                    try self.put(try self.lifetime_name("L_copy_", st.elem))
                    try self.put("(")
                    try self.put(store)
                    try self.put(".items[")
                    try self.put(i)
                    try self.put("])")
                else:
                    try self.put(store)
                    try self.put(".items[")
                    try self.put(i)
                    try self.put("]")
                try self.end()
                try self.drop_at_exit(binding.text, st.elem)
                try self.begin("")
                try self.put(i)
                try self.put(" += 1")
                try self.end()
                try self.block(body)
                self.indent -= 1
            .map_, .set_:
                let store = try self.temp("store")
                let version = try self.temp("version")
                let i = try self.temp("i")
                let is_map = st.kind == types.Kind.map_
                try self.begin("let ")
                try self.put(store)
                try self.put(" = ")
                try self.use(seq)
                try self.end()
                try self.begin("let ")
                try self.put(version)
                try self.put(" = ")
                try self.put(store)
                try self.put(".version")
                try self.end()
                try self.begin("var ")
                try self.put(i)
                try self.put(": usize = 0")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while true:")
                try self.end()
                self.indent += 1
                try self.begin("kernel.map_check[")
                try self.map_types(seq.type_id)
                try self.put("](")
                try self.put(store)
                try self.put(", ")
                try self.put(version)
                try self.put(")")
                try self.end()
                try self.begin("if ")
                try self.put(i)
                try self.put(" >= ")
                try self.put(store)
                try self.put(".count:")
                try self.end()
                try self.line("    break")
                let value_type = self.checker.table.map_value(seq.type_id) if is_map else types.unit_id
                if is_map and binding.body != none:
                    # `for (k, v) in m`: each its own copy
                    var part = binding.body
                    var which: usize = 0
                    while let name = part:
                        if not name.has(ast.flag_wildcard):
                            try self.begin("let L_")
                            try self.put(name.text)
                            try self.put(" = ")
                            try self.element_copy(st.elem if which == 0 else value_type, store, ".keys[" if which == 0 else ".values[", i)
                            try self.end()
                            try self.drop_at_exit(name.text, name.type_id)
                        which += 1
                        part = name.next
                elif is_map:
                    try self.begin("let L_")
                    try self.put(binding.text)
                    try self.put(" = (")
                    try self.element_copy(st.elem, store, ".keys[", i)
                    try self.put(", ")
                    try self.element_copy(value_type, store, ".values[", i)
                    try self.put(")")
                    try self.end()
                    try self.drop_at_exit(binding.text, binding.type_id)
                else:
                    try self.begin("let L_")
                    try self.put(binding.text)
                    try self.put(" = ")
                    try self.element_copy(st.elem, store, ".keys[", i)
                    try self.end()
                    try self.drop_at_exit(binding.text, st.elem)
                try self.begin("")
                try self.put(i)
                try self.put(" += 1")
                try self.end()
                try self.block(body)
                self.indent -= 1
            _: return try self.fail(seq, "iterating this compiles in a later slice")

    ## `store.keys[i]` or the like, copied when the element holds references.
    mutating func element_copy(t: u32, store: str, member: str, i: str) -> !:
        let holds = self.checker.table.has_references(t)
        if holds:
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
        try self.put(store)
        try self.put(member)
        try self.put(i)
        try self.put("]")
        if holds:
            try self.put(")")

    # -- match ----------------------------------------------------------------------------

    mutating func match_statement(s: ast.Node*) -> !:
        let subject = s.left else return
        let st = self.checker.table.get(subject.type_id)
        let m = try self.temp("subject")
        try self.begin("let ")
        try self.put(m)
        try self.put(" = ")
        try self.use(subject)
        try self.end()
        if st.kind == types.Kind.tuple or st.kind == types.Kind.str_ or st.kind == types.Kind.bytes_:
            return try self.match_by_tests(s, m, subject.type_id)
        try self.begin("match ")
        try self.put(m)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = s.body
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            self.raw_payloads = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, m, &bound)
                p = pattern.next
            self.raw_payloads = false
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(":")
            try self.end()
            self.indent += 1
            if let name = bound:
                try self.begin("let L_")
                try self.put(name.text)
                try self.put(" = ")
                if self.checker.table.has_references(name.type_id):
                    try self.put(try self.lifetime_name("L_copy_", name.type_id))
                    try self.put("(")
                    try self.put(m)
                    try self.put(")")
                else:
                    try self.put(m)
                try self.end()
                try self.drop_at_exit(name.text, name.type_id)
            # a payload bound by the arm is the subject's; the binding takes its own copy
            var q = arm.left
            while let pattern = q:
                try self.own_payloads(pattern, st)
                q = pattern.next
            let body = arm.body else return
            try self.block(body)
            self.indent -= 1
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(s):
            try self.line("_: discard(0)")
        self.indent -= 1

    ## `let L_x = L_copy(L_x__r)` and its drop for every payload name the pattern bound
    ## whose type holds references; `pattern` wrote the raw name.
    mutating func own_payloads(p: ast.Node*, st: types.Type) -> !:
        if p.has(ast.flag_wildcard):
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional and self.checker.table.has_references(name.type_id):
                try self.own_payload(name)
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            var cursor = v.body
            while let name = cursor:
                if not name.has(ast.flag_wildcard) and self.checker.table.has_references(name.type_id):
                    try self.own_payload(name)
                cursor = name.next

    mutating func own_payload(name: ast.Node*) -> !:
        try self.begin("let L_")
        try self.put(name.text)
        try self.put(" = ")
        try self.put(try self.lifetime_name("L_copy_", name.type_id))
        try self.put("(L_")
        try self.put(name.text)
        try self.put("__r)")
        try self.end()
        try self.drop_at_exit(name.text, name.type_id)

    ## A bound payload name in a pattern: raw when the binding will copy it.
    mutating func payload_name(name: ast.Node*) -> !:
        try self.put("L_")
        try self.put(name.text)
        if self.raw_payloads and self.checker.table.has_references(name.type_id):
            try self.put("__r")

    ## One pattern in a Base arm; a name pattern becomes `_` (or `.some(name)`) and is
    ## bound at the arm's start.
    mutating func pattern(p: ast.Node*, st: types.Type, subject: str, bound: ast.Node*?*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional:
                try self.put(".some(")
                try self.payload_name(name)
                try self.put(")")
            else:
                try self.put("_")
                *bound = name
            return
        if p.text == "none":
            try self.put(".none")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            try self.put(".L_")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                var cursor = v.body
                var first = true
                while let name = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    if name.has(ast.flag_wildcard):
                        try self.put("_")
                    else:
                        try self.payload_name(name)
                    cursor = name.next
                try self.put(")")
            return
        if p.text == "..<" or p.text == "..=":
            let hi = p.right else return
            try self.expr(v)
            try self.put(p.text)
            try self.expr(hi)
            return
        if v.kind == ast.Kind.literal and v.type_id == types.str_id:
            try self.text_literal(try literals.decode_text(v.text), false)
            return
        try self.expr(v)

    ## A match expression over a tuple or bytes: `match true:` with one guarded arm per
    ## pattern, the tests over the subject as written, which must be stable (a name, a
    ## literal, a tuple of those), since every arm reads it again; a pattern binding a
    ## name needs the statement form.
    mutating func match_expr_by_tests(e: ast.Node*, subject: ast.Node*, st: types.Type) -> !:
        if not self.stable(subject):
            return try self.fail(subject, "a match expression over a tuple or bytes reads its subject in every arm; bind it to a name first, or use the statement form")
        let start = self.out.used
        try self.expr(subject)
        let m = try self.capture(start)
        try self.put("match true:")
        try self.end()
        self.indent += 1
        var cursor = e.body
        while let arm = cursor:
            var p = arm.left
            while let pattern = p:
                if binds_a_name(pattern):
                    return try self.fail(pattern, "a pattern binding a name in a match expression over a tuple needs the statement form")
                p = pattern.next
            try self.begin("_")
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" if ")
                var q = arm.left
                var first = true
                while let pattern = q:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m, subject.type_id)
                    try self.put(")")
                    q = pattern.next
                if let guard = arm.right:
                    try self.put(" and (")
                    try self.use(guard)
                    try self.put(")")
            try self.put(" => ")
            let body = arm.body else return
            try self.owned(body)
            try self.end()
            cursor = arm.next
        if not has_wildcard_arm(e):
            try self.line("_ => trap(\"no arm applied\")")
        self.indent -= 1
        try self.begin("")

    ## Whether an expression may be read more than once without a change of meaning.
    func stable(e: ast.Node*) -> bool:
        match e.kind:
            .name, .self_, .literal: return true
            .group:
                let inner = e.left else return false
                return self.stable(inner)
            .tuple:
                var cursor = e.body
                while let m = cursor:
                    if not self.stable(m):
                        return false
                    cursor = m.next
                return true
            _: return false

    ## A match over a tuple: one `if` per arm over member tests, a flag saying an arm
    ## applied so a failed guard falls through to the next, and a trap after the chain when
    ## every arm leaves the function, so Base sees the return the checker proved.
    mutating func match_by_tests(s: ast.Node*, m: str, st: u32) -> !:
        let done = try self.temp("matched")
        try self.begin("var ")
        try self.put(done)
        try self.put(" = false")
        try self.end()
        var cursor = s.body
        while let arm = cursor:
            try self.begin("if not ")
            try self.put(done)
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" and (")
                var p = arm.left
                var first = true
                while let pattern = p:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m, st)
                    try self.put(")")
                    p = pattern.next
                try self.put(")")
            try self.put(":")
            try self.end()
            self.indent += 1
            if let pattern = arm.left:
                try self.tuple_bindings(pattern, m)
            if let guard = arm.right:
                try self.begin("if ")
                try self.expr(guard)
                try self.put(":")
                try self.end()
                self.indent += 1
            try self.begin("")
            try self.put(done)
            try self.put(" = true")
            try self.end()
            let body = arm.body else return
            try self.block(body)
            if arm.right != none:
                self.indent -= 1
            self.indent -= 1
            cursor = arm.next
        if s.has(ast.flag_all_exit):
            try self.line("trap(\"no arm of the match applied\")")

    mutating func tuple_test(p: ast.Node*, m: str, t: u32) -> !:
        if p.has(ast.flag_wildcard) or p.text == "bind":
            try self.put("true")
            return
        if p.text == "tuple":
            let members = self.checker.table.get(t).args
            var i: usize = 0
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(" and ")
                first = false
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_test_member(sub, try copy_name(member), members[i])
                i += 1
                cursor = sub.next
            if first:
                try self.put("true")
            return
        let v = p.left else return
        if self.needs_equality(t):
            try self.put(try self.equality_name(t))
            try self.put("(")
            try self.put(m)
            try self.put(", ")
            try self.use(v)
            try self.put(")")
            return
        try self.put(m)
        try self.put(" == ")
        try self.expr(v)

    mutating func tuple_test_member(p: ast.Node*, member: str, t: u32) -> !:
        try self.put("(")
        try self.tuple_test(p, member, t)
        try self.put(")")

    mutating func tuple_bindings(p: ast.Node*, m: str) -> !:
        if p.text == "bind":
            let name = p.left else return
            try self.begin("let L_")
            try self.put(name.text)
            try self.put(" = ")
            if self.checker.table.has_references(name.type_id):
                try self.put(try self.lifetime_name("L_copy_", name.type_id))
                try self.put("(")
                try self.put(m)
                try self.put(")")
            else:
                try self.put(m)
            try self.end()
            try self.drop_at_exit(name.text, name.type_id)
            return
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            while let sub = cursor:
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_bindings(sub, try copy_name(member))
                i += 1
                cursor = sub.next

    # -- expressions ----------------------------------------------------------------------

    ## Whether the expression reads a binding, so its value is borrowed (RUNTIME 4).
    func borrowed(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                let d = e.resolved else return false
                return d.kind != ast.Kind.func_ and d.kind != ast.Kind.constant
            .self_: return true
            .literal:
                # a text literal is an immortal object: read, never released
                let b = e.text.bytes
                return b.length > 0 and (b[0] == '"' or b[0] == 'r' or b[0] == 'b') and e.text != "b" and e.text != "r"
            .group:
                let inner = e.left else return false
                return self.borrowed(inner)
            _: return false

    ## The expression as a value the reader will keep: a borrowed one is copied.
    mutating func owned(e: ast.Node*) -> !:
        if self.checker.table.has_references(e.type_id) and self.borrowed(e):
            try self.put(try self.lifetime_name("L_copy_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            return
        try self.expr(e)

    ## The expression as a value used and let go of: an owned one becomes a temporary of
    ## the statement, pooled until the drain.
    mutating func use(e: ast.Node*) -> !:
        if self.checker.table.has_references(e.type_id) and not self.borrowed(e):
            try self.put(try self.lifetime_name("L_pool_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            self.pooled = true
            return
        try self.expr(e)

    ## Writes the value: borrowed for a read of a binding, owned for everything else.
    pub mutating func expr(e: ast.Node*) -> !:
        match e.kind:
            .literal: try self.literal(e)
            .name:
                let d = e.resolved else return try self.fail(e, "an unresolved name")
                if d.kind == ast.Kind.func_ or d.kind == ast.Kind.constant:
                    try self.put("L_")
                    try self.put(d.text)
                    return
                try self.put("L_")
                try self.put(e.text)
            .self_: try self.put(self.self_name)
            .group:
                let inner = e.left else return
                try self.put("(")
                try self.expr(inner)
                try self.put(")")
            .unary:
                let inner = e.left else return
                if e.text == "try":
                    try self.put("try ")
                    try self.expr(inner)
                elif e.text == "not":
                    try self.put("not ")
                    try self.expr(inner)
                else:
                    try self.put("(-")
                    try self.expr(inner)
                    try self.put(")")
            .binary: try self.binary(e)
            .conditional:
                let cond = e.ty else return
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" if ")
                try self.use(cond)
                try self.put(" else ")
                try self.owned(r)
                try self.put(")")
            .tuple:
                try self.put("(")
                var cursor = e.body
                var first = true
                while let m = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.owned(m)
                    cursor = m.next
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .unit_: try self.put("()")
            .list_lit:
                let t = self.checker.table.get(e.type_id)
                if e.body == none:
                    try self.put("kernel.list_new[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                else:
                    try self.put("kernel.list_of[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                try self.put(try self.lifetime_name("L_info_", e.type_id))
                try self.put(", ")
                try self.put(try self.ops_name(t.elem))
                if e.body != none:
                    try self.put(", [")
                    var cursor = e.body
                    var first = true
                    while let item = cursor:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.owned(item)
                        cursor = item.next
                    try self.put("]")
                try self.put(")")
            .set_lit, .map_lit:
                let t = self.checker.table.get(e.type_id)
                if t.kind == types.Kind.set_:
                    try self.put("kernel.set_of[" if e.body != none else "kernel.set_new[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                    try self.put(try self.lifetime_name("L_info_", e.type_id))
                    try self.put(", ")
                    try self.put(try self.ops_name(t.elem))
                    if e.body != none:
                        try self.put(", [")
                        var cursor = e.body
                        var first = true
                        while let item = cursor:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.owned(item)
                            cursor = item.next
                        try self.put("]")
                    try self.put(")")
                else:
                    let value_type = self.checker.table.map_value(e.type_id)
                    try self.put("kernel.map_of[" if e.body != none else "kernel.map_new[")
                    try self.type_of(t.elem)
                    try self.put(", ")
                    try self.type_of(value_type)
                    try self.put("](&")
                    try self.put(try self.lifetime_name("L_info_", e.type_id))
                    try self.put(", ")
                    try self.put(try self.ops_name(t.elem))
                    try self.put(", ")
                    try self.put(try self.ops_name(value_type))
                    if e.body != none:
                        try self.put(", [")
                        var cursor = e.body
                        var first = true
                        while let entry = cursor:
                            let k = entry.left else return
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.owned(k)
                            cursor = entry.next
                        try self.put("], [")
                        cursor = e.body
                        first = true
                        while let entry = cursor:
                            let v = entry.right else return
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.owned(v)
                            cursor = entry.next
                        try self.put("]")
                    try self.put(")")
            .call: try self.call(e)
            .member: try self.member(e)
            .index:
                let receiver = e.left else return
                let index = e.body else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.bytes_:
                    try self.put("kernel.byte_at(")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                elif rt.kind == types.Kind.list_:
                    try self.put("kernel.list_get[")
                    try self.type_of(rt.elem)
                    try self.put("](")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                elif rt.kind == types.Kind.map_:
                    try self.put("kernel.map_get[")
                    try self.map_types(receiver.type_id)
                    try self.put("](")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                else:
                    return try self.fail(e, "indexing this compiles in the collections slice")
            .slice:
                let receiver = e.left else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.str_:
                    try self.put("kernel.slice_text(")
                elif rt.kind == types.Kind.bytes_:
                    try self.put("kernel.slice_bytes(")
                else:
                    try self.put("kernel.list_slice[")
                    try self.type_of(rt.elem)
                    try self.put("](")
                try self.use(receiver)
                try self.put(", ")
                if let low = e.body:
                    try self.expr(low)
                else:
                    try self.put("0")
                try self.put(", ")
                if let high = e.right:
                    try self.expr(high)
                else:
                    try self.put("0")
                try self.put(", ")
                try self.put("true" if e.has(ast.flag_no_high) else "false")
                try self.put(")")
            .else_:
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" else ")
                if r.kind == ast.Kind.return_:
                    try self.put("return")
                    if let v = r.left:
                        try self.put(" ")
                        try self.owned(v)
                elif r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
                    try self.put("break" if r.kind == ast.Kind.break_ else "continue")
                    if r.text.length > 0:
                        try self.put(" ")
                        try self.put(r.text)
                else:
                    try self.owned(r)
                try self.put(")")
            .catch_:
                let l = e.left else return
                let body = e.body else return
                try self.owned(l)
                try self.put(" catch ")
                if e.text.length > 0:
                    try self.put("L_")
                    try self.put(e.text)
                try self.put(":")
                try self.end()
                self.indent += 1
                try self.block(body)
                self.indent -= 1
                # the caller's line is already ended by the suite
                try self.begin("")
            .case_value: try self.case_value(e, e.body)
            .formatted: try self.formatted(e)
            .match_expr: try self.match_expr(e)
            _: return try self.fail(e, "an expression this slice does not compile")

    ## The receiver of an index, named once when it is a call.
    mutating func temp_less_receiver(receiver: ast.Node*) -> str!:
        if receiver.kind == ast.Kind.name or receiver.kind == ast.Kind.self_:
            let half = self.checker.scratch.length // 2
            if receiver.kind == ast.Kind.self_:
                return self.self_name
            return try copy_name(try format(self.checker.scratch[half..], f"L_{receiver.text}"))
        return try self.fail(receiver, "index a bound name; binding the value first")

    mutating func literal(e: ast.Node*) -> !:
        let b = e.text.bytes
        if e.text == "true" or e.text == "false" or e.text == "none":
            try self.put(e.text)
            return
        if b[0] == '"' or (b[0] == 'r' and b.length > 1 and b[1] == '"'):
            try self.put(try self.text_ref(try literals.decode_text(e.text), false))
            return
        if b[0] == 'b' and b.length > 1 and b[1] == '"':
            try self.put(try self.text_ref((str)(try literals.decode_text(e.text)).bytes, true))
            return
        if literals.is_float_text(e.text):
            try self.put(e.text)
            return
        let magnitude = try literals.decode_integer(e.text)
        if magnitude == 9223372036854775808:
            try self.put("9223372036854775808")
            return
        try self.put_u64(magnitude)

    ## A Base text literal for `text`: every byte C or Base could misread is escaped.
    mutating func text_literal(text: str, as_bytes: bool) -> !:
        if as_bytes:
            try self.put("b")
        try self.put("\"")
        for c in text.bytes:
            if c == '\\':
                try self.put("\\\\")
            elif c == '"':
                try self.put("\\\"")
            elif c == '\n':
                try self.put("\\n")
            elif c == '\r':
                try self.put("\\r")
            elif c == '\t':
                try self.put("\\t")
            elif c == 0:
                try self.put("\\0")
            elif c < 32 or (as_bytes and c >= 127):
                try self.put("\\x")
                try self.out.put_byte(hex_digit(c >> 4))
                try self.out.put_byte(hex_digit(c & 15))
            else:
                try self.out.put_byte(c)
        try self.put("\"")

    mutating func binary(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let op = e.text
        if op == "and" or op == "or":
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        if op == "..<" or op == "..=":
            try self.put("kernel.range(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(", ")
            try self.put("true" if op == "..=" else "false")
            try self.put(")")
            return
        if op == "is" or op == "is not":
            # identity: the objects' addresses, none being zero (§10.2)
            try self.put("(")
            try self.identity(l)
            try self.put(" == " if op == "is" else " != ")
            try self.identity(r)
            try self.put(")")
            return
        if op == "in":
            let rt = self.checker.table.get(r.type_id)
            if rt.kind == types.Kind.str_:
                try self.put("kernel.contains(")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            if rt.kind == types.Kind.range_:
                try self.put("kernel.in_range(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
            if rt.kind == types.Kind.list_:
                try self.put("kernel.list_contains[")
                try self.type_of(rt.elem)
                try self.put("](")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            if rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_:
                try self.put("kernel.map_contains[")
                try self.map_types(r.type_id)
                try self.put("](")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            return try self.fail(e, "`in` over this compiles in a later slice")
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
            let lt = l.type_id
            if (op == "==" or op == "!=") and self.needs_equality(lt):
                # a collection compares by contents (§4.4), so does what holds one
                if op == "!=":
                    try self.put("not ")
                try self.put(try self.equality_name(lt))
                try self.put("(")
                try self.use(l)
                try self.put(", ")
                try self.use(r)
                try self.put(")")
                return
            if (op != "==" and op != "!=") and (lt == types.str_id or lt == types.bytes_id or self.checker.table.kind(lt) == types.Kind.tuple):
                try self.compare_by_call(op, l, r)
                return
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        try self.arithmetic(op, e.type_id if op != "/" else l.type_id, l, r)

    ## `<` and friends on text, bytes and tuples, which Base does not order itself.
    mutating func compare_by_call(op: str, l: ast.Node*, r: ast.Node*) -> !:
        let lt = self.checker.table.get(l.type_id)
        if lt.kind == types.Kind.tuple:
            # lexicographic over the members, which are ordered scalars
            try self.put("(")
            var i: usize = 0
            while i < lt.args.length:
                if i > 0:
                    try self.put(" or (")
                var k: usize = 0
                while k < i:
                    try self.member_compare("==", l, r, lt.args[k], k)
                    try self.put(" and ")
                    k += 1
                let last = i + 1 == lt.args.length
                try self.member_compare(op if last else strict(op), l, r, lt.args[i], i)
                if i > 0:
                    try self.put(")")
                i += 1
            try self.put(")")
            return
        try self.put("(kernel.compare_blobs(" if lt.kind == types.Kind.bytes_ else "(kernel.compare_text(")
        try self.use(l)
        try self.put(", ")
        try self.use(r)
        try self.put(") ")
        try self.put(op)
        try self.put(" 0)")

    mutating func member_compare(op: str, l: ast.Node*, r: ast.Node*, t: u32, i: usize) -> !:
        if t == types.str_id or t == types.bytes_id:
            try self.put("(kernel.compare_blobs(" if t == types.bytes_id else "(kernel.compare_text(")
            try self.expr(l)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(", ")
            try self.expr(r)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(") ")
            try self.put(op)
            try self.put(" 0)")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(")")

    ## `a op b` for the arithmetic operators (§6.2), with `t` the operands' type.
    mutating func arithmetic(op: str, t: u32, l: ast.Node*, r: ast.Node*) -> !:
        if t == types.str_id and op == "+":
            try self.put("kernel.concat(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.bytes_id and op == "+":
            try self.put("kernel.concat_bytes(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if self.checker.table.kind(t) == types.Kind.list_ and op == "+":
            try self.put("kernel.list_concat[")
            try self.type_of(self.checker.table.get(t).elem)
            try self.put("](")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.int_id:
            if op == "/":
                try self.put("(f64(")
                try self.expr(l)
                try self.put(") / f64(")
                try self.expr(r)
                try self.put("))")
                return
            if op == "//" or op == "%" or op == "**":
                try self.put("kernel.floor_div(" if op == "//" else "kernel.floor_mod(" if op == "%" else "kernel.power(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
        if t == types.float_id and (op == "//" or op == "%" or op == "**"):
            try self.put("kernel.ffloor_div(" if op == "//" else "kernel.ffloor_mod(" if op == "%" else "kernel.fpower(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(")")

    mutating func member(e: ast.Node*) -> !:
        let receiver = e.left else return
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.type_name:
            let m = e.resolved else return
            let d = rt.decl else return
            if m.kind == ast.Kind.enum_case:
                try self.put("L_")
                try self.put(d.text)
                try self.put(".L_")
                try self.put(m.text)
                return
            try self.put("L_")
            try self.put(d.text)
            try self.put(".L_")
            try self.put(m.text)
            return
        if rt.kind == types.Kind.tuple:
            let copies = self.checker.table.has_references(e.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", e.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if e.text == "byte_count" and rt.kind == types.Kind.str_:
            try self.put("(i64)(")
            try self.use(receiver)
            try self.put(").data.length")
            return
        if e.text == "length" and (rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_):
            try self.put("kernel.map_length[")
            try self.map_types(receiver.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if e.text == "length" and (rt.kind == types.Kind.str_ or rt.kind == types.Kind.bytes_ or rt.kind == types.Kind.list_):
            if rt.kind == types.Kind.str_:
                try self.put("kernel.scalar_length(")
                try self.use(receiver)
                try self.put(")")
            elif rt.kind == types.Kind.bytes_:
                try self.put("kernel.bytes_length(")
                try self.use(receiver)
                try self.put(")")
            else:
                try self.put("kernel.list_length[")
                try self.type_of(rt.elem)
                try self.put("](")
                try self.use(receiver)
                try self.put(")")
            return
        if rt.kind == types.Kind.list_ and e.has(ast.flag_builtin):
            try self.put("kernel.list_first[" if e.text == "first" else "kernel.list_last[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if rt.kind == types.Kind.error_value:
            if e.text == "message":
                # a text of its own, copied out of the `Error`'s view
                try self.put("kernel.text_of(")
                try self.expr(receiver)
                try self.put(".message)")
                return
            try self.expr(receiver)
            try self.put(".")
            try self.put(e.text)
            return
        let m = e.resolved else return try self.fail(e, "an unresolved member")
        if m.kind == ast.Kind.field:
            # a field read is a copy of its own (RUNTIME 4)
            let copies = self.checker.table.has_references(m.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", m.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".L_")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if m.kind == ast.Kind.func_:
            # a bound method as a value: not in this slice
            return try self.fail(e, "a method as a value compiles in the closures slice")
        return try self.fail(e, "a member this slice does not compile")

    mutating func call(e: ast.Node*) -> !:
        let callee = e.left else return
        if callee.kind == ast.Kind.name and callee.resolved == none and self.checker.find_declaration(callee.text) == none:
            try self.core_call(e, callee.text)
            return
        if callee.kind == ast.Kind.member and callee.text == "package":
            let first = e.body else return
            let v = first.left else return
            try self.put("ErrorCode.package(")
            try self.put(v.text)
            try self.put(")")
            return
        if callee.kind == ast.Kind.case_value:
            try self.case_value(callee, e.body)
            return
        if callee.has(ast.flag_builtin):
            let k = self.checker.table.kind(callee.type_id)
            if k == types.Kind.map_ or k == types.Kind.set_:
                try self.map_method(e, callee, k == types.Kind.map_)
            elif k == types.Kind.str_ or k == types.Kind.bytes_:
                try self.text_method(e, callee)
            else:
                try self.list_method(e, callee)
            return
        if callee.kind == ast.Kind.member and callee.text == "get" and self.checker.table.kind(callee.type_id) == types.Kind.weak_:
            # `weak.get()`: the object with a reference of its own, or none (§10.4)
            let receiver = callee.left else return
            let elem = self.checker.table.get(callee.type_id).elem
            try self.put(try self.lifetime_name("L_weak_get_", elem))
            try self.put("(")
            try self.use(receiver)
            try self.put(")")
            return
        let d = e.resolved else return try self.call_value(e, callee)
        match d.kind:
            .enum_case:
                let owner = callee.left else return
                try self.expr(owner)
                try self.put(".L_")
                try self.put(d.text)
                try self.arguments(e, d.body, false, true)
            .struct_:
                try self.put("L_")
                try self.put(d.text)
                try self.arguments(e, d.body, false, true)
            .class_:
                # a class with defaults for every field and no `init`
                try self.put("L_")
                try self.put(d.text)
                try self.put("__new()")
            .func_:
                if d.text == "init":
                    let owner = callee.resolved else return try self.fail(e, "no class")
                    try self.put("L_")
                    try self.put(owner.text)
                    try self.put("__new")
                    try self.arguments(e, d.right, true, false)
                    return
                if check.has_self(d):
                    let receiver = callee.left else return
                    let owner = self.checker.table.get(receiver.type_id)
                    if owner.kind == types.Kind.enum_ or owner.kind == types.Kind.class_:
                        try self.put("L_")
                        try self.put(owner.name)
                        try self.put("__L_")
                        try self.put(d.text)
                        try self.put("(")
                        try self.use(receiver)
                        if ast.count(d.right) > 1:
                            try self.put(", ")
                        try self.arguments_bare(e, d.right, true, false)
                        try self.put(")")
                        return
                    try self.use(receiver)
                    try self.put(".L_")
                    try self.put(d.text)
                    try self.arguments(e, d.right, true, false)
                    return
                if callee.kind == ast.Kind.member:
                    try self.expr(callee)
                else:
                    try self.put("L_")
                    try self.put(d.text)
                try self.arguments(e, d.right, true, false)
            _: return try self.fail(e, "a call this slice does not compile")

    ## A list's own method (§11.1), one kernel call each.
    mutating func list_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let lt = self.checker.table.get(callee.type_id)
        let name = callee.text
        if name == "join":
            try self.put("kernel.list_join(")
        elif name == "map":
            try self.put("kernel.list_map[")
            try self.type_of(lt.elem)
            try self.put(", ")
            try self.type_of(self.checker.table.get(e.type_id).elem)
            try self.put("](")
        else:
            try self.put("kernel.list_")
            try self.put(name)
            try self.put("[")
            try self.type_of(lt.elem)
            try self.put("](")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            # a stored value is the list's own; anything else is borrowed for the call
            if name == "append" or name == "insert":
                try self.owned(v)
            else:
                try self.use(v)
            cursor = a.next
        if name == "map":
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(self.checker.table.get(e.type_id).elem))
        try self.put(")")

    ## A text's or bytes' own method (§11.3, §11.4), one kernel call each.
    mutating func text_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if callee.type_id == types.bytes_id:
            try self.put("kernel.decode_text(")
            try self.use(receiver)
            try self.put(")")
            return
        if name == "contains":
            try self.put("kernel.contains(")
        elif name == "bytes":
            try self.put("kernel.text_to_bytes(")
            try self.use(receiver)
            try self.put(")")
            return
        else:
            try self.put("kernel.")
            try self.put(name)
            try self.put("(")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            try self.use(v)
            cursor = a.next
        if name == "split" or name == "lines":
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(types.str_id))
        try self.put(")")

    ## `K, V` of a map, or `T, unit` of a set, as type arguments.
    mutating func map_types(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.type_of(t.elem)
        try self.put(", ")
        if t.kind == types.Kind.map_:
            try self.type_of(self.checker.table.map_value(id))
        else:
            try self.put("u8")

    ## A map's or a set's own method (§11.2), one kernel call each.
    mutating func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if is_map or name == "clear" or name == "copy":
            try self.put("kernel.map_")
            try self.put(name)
        else:
            try self.put("kernel.set_")
            try self.put(name)
        try self.put("[")
        if is_map or name == "clear" or name == "copy":
            try self.map_types(callee.type_id)
        else:
            try self.type_of(self.checker.table.get(callee.type_id).elem)
        try self.put("](")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            if name == "insert":
                try self.owned(v)
            else:
                try self.use(v)
            cursor = a.next
        if name == "keys" or name == "values" or name == "items":
            # a new list: its descriptor and its element operations
            let result = self.checker.table.get(e.type_id)
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(result.elem))
        try self.put(")")

    ## A call through a function value: Base's function pointer, positional arguments.
    mutating func call_value(e: ast.Node*, callee: ast.Node*) -> !:
        try self.expr(callee)
        try self.put("(")
        var cursor = e.body
        var first = true
        while let a = cursor:
            if not first:
                try self.put(", ")
            first = false
            let v = a.left else return
            try self.use(v)
            cursor = a.next
        try self.put(")")

    ## `(a, b, c)` in parameter order, defaults filled in; a call borrows its arguments,
    ## a construction owns them (`own`).
    mutating func arguments(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        try self.put("(")
        try self.arguments_bare(e, params, skip_self, own)
        try self.put(")")

    mutating func arguments_bare(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        var first = true
        var cursor = params
        while let p = cursor:
            if (p.kind == ast.Kind.param or p.kind == ast.Kind.field) and not (skip_self and p.text == "self"):
                if not first:
                    try self.put(", ")
                first = false
                var found = false
                var a = e.body
                while let arg = a:
                    if arg.resolved == p:
                        let v = arg.left else return
                        if own:
                            try self.owned(v)
                        else:
                            try self.use(v)
                        found = true
                    a = arg.next
                if not found:
                    let d = p.left else return try self.fail(e, "a missing argument")
                    if own:
                        try self.owned(d)
                    else:
                        try self.use(d)
            cursor = p.next

    mutating func case_value(e: ast.Node*, args: ast.Node*?) -> !:
        let case_node = e.resolved else return try self.fail(e, "an unresolved case")
        var t = self.checker.table.get(e.type_id)
        if t.kind == types.Kind.optional:
            t = self.checker.table.get(t.elem)
        try self.put("L_")
        try self.put(t.name)
        try self.put(".L_")
        try self.put(case_node.text)
        if case_node.body != none:
            let saved = e.body
            e.body = args
            try self.arguments(e, case_node.body, false, true)
            e.body = saved

    ## The address of an object, or zero, as a `usize`.
    mutating func identity(e: ast.Node*) -> !:
        if e.kind == ast.Kind.literal and e.text == "none":
            try self.put("0")
            return
        try self.put(try self.lifetime_name("L_id_", e.type_id))
        try self.put("(")
        try self.use(e)
        try self.put(")")

    ## `print`, `assert`, `trap`, `error`, `discard`, the conversions.
    mutating func core_call(e: ast.Node*, name: str) -> !:
        if name == "print":
            try self.put("kernel.print_line(")
            let n = ast.count(e.body)
            if n == 1:
                let first = e.body else return
                let v = first.left else return
                try self.show(v)
            else:
                # the joined line is a fresh text of the statement's
                try self.put(try self.lifetime_name("L_pool_", types.str_id))
                try self.put("(kernel.join([")
                self.pooled = true
                var cursor = e.body
                var first = true
                while let a = cursor:
                    if not first:
                        try self.put(", ")
                        try self.put(try self.text_ref(" ", false))
                        try self.put(", ")
                    first = false
                    let v = a.left else return
                    try self.show(v)
                    cursor = a.next
                if n == 0:
                    try self.put(try self.text_ref("", false))
                try self.put("]))")
            try self.put(")")
            return
        let first = e.body else return
        let arg = first.left else return
        if name == "assert":
            # `if not c: trap("assert failed: m")`, the trap the interpreter reports
            try self.put("if not (")
            try self.use(arg)
            try self.put("): trap(")
            if let second = first.next:
                let m = second.left else return
                try self.put("kernel.concat(")
                try self.put(try self.text_ref("assert failed: ", false))
                try self.put(", ")
                try self.use(m)
                try self.put(").data")
            else:
                try self.put("\"assert failed\"")
            try self.put(")")
            return
        if name == "trap":
            try self.put("trap((")
            try self.use(arg)
            try self.put(").data)")
            return
        if name == "error":
            # the `Error` views its message: the text lives to the end of the run (RUNTIME)
            let second = first.next else return
            let m = second.left else return
            try self.put("error(")
            try self.use(arg)
            try self.put(", kernel.message_of(")
            try self.use(m)
            try self.put("))")
            return
        if name == "discard":
            try self.put("discard(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "Weak":
            try self.put("heap.weak_make((heap.Object*)")
            try self.use(arg)
            try self.put(")")
            return
        if name == "hash":
            try self.put("(i64)")
            try self.put(try self.hash_name(arg.type_id))
            try self.put("(")
            try self.use(arg)
            try self.put(")")
            return
        let t = arg.type_id
        if name == "int":
            try self.put("kernel.to_int(" if t == types.float_id else "kernel.parse_int(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "float":
            try self.put("f64(" if t == types.int_id else "kernel.parse_float(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "bool":
            try self.put("kernel.parse_bool(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "str":
            try self.shown_value(arg)
            return
        return try self.fail(e, "a core call this slice does not compile")

    ## The display of a value as a piece of a line or a formatted text: a fresh text pooled
    ## until the statement ends, or the value itself when it is one.
    mutating func show(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.use(v)
            return
        try self.put(try self.lifetime_name("L_pool_", types.str_id))
        try self.put("(")
        try self.shown_value(v)
        try self.put(")")
        self.pooled = true

    ## The display of a value as an owned text: `str(x)`.
    mutating func shown_value(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.owned(v)
            return
        try self.put(try self.show_name(t))
        try self.put("(")
        try self.use(v)
        try self.put(")")

    ## The function that displays a value of type `t`, emitted after the program.
    mutating func show_name(t: u32) -> str!:
        match self.checker.table.kind(t):
            .int_: return "kernel.show_int"
            .str_: return "kernel.show_text"
            .float_: return "kernel.show_float"
            .bool_: return "kernel.show_bool"
            .bytes_: return "kernel.show_bytes"
            .range_: return "kernel.show_range"
            _: discard(0)
        var i: usize = 0
        var seen = false
        while i < self.shown.count:
            if self.shown.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.shown.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"show_{t}"))

    ## The name of the copy, drop, trace, pool, identity or weak-get function of a type,
    ## which is emitted after the program.
    mutating func lifetime_name(prefix: str, t: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.lifetimes.count:
            if self.lifetimes.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.lifetimes.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"{prefix}{t}"))

    ## Every function and table the program's types need, each written once; writing one
    ## can register more, so the sets are walked until nothing new appears.
    mutating func support_functions() -> !:
        while true:
            let before = self.shown.count + self.lifetimes.count + self.equalities.count + self.orderings.count + self.hashes.count + self.ops_types.count + self.texts.count
            let done = self.shown_done + self.lifetimes_done + self.equalities_done + self.orderings_done + self.hashes_done + self.ops_done + self.texts_done
            if before == done:
                return
            try self.show_functions()
            try self.lifetime_functions()
            try self.comparison_functions()
            try self.hash_functions()
            try self.ops_tables()
            try self.text_objects()

    ## `&L_text_N`: the immortal object of a literal, one per distinct text (RUNTIME).
    mutating func text_ref(text: str, as_bytes: bool) -> str!:
        var i: usize = 0
        var at = self.texts.count
        while i < self.texts.count:
            if self.texts.get(i) == text and self.texts_are_bytes.get(i) == as_bytes:
                at = i
                break
            i += 1
        if at == self.texts.count:
            try self.texts.push(try copy_name(text))
            try self.texts_are_bytes.push(as_bytes)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"&L_text_{at}"))

    mutating func text_objects() -> !:
        while self.texts_done < self.texts.count:
            let i = self.texts_done
            self.texts_done += 1
            let as_bytes = self.texts_are_bytes.get(i)
            try self.begin("var L_text_")
            try self.put_u64((u64)i)
            try self.put(": kernel.Bytes = kernel.Bytes(" if as_bytes else ": kernel.Text = kernel.Text(")
            try self.put("header = heap.Object(strong = 1073741824, weak = 0, flags = heap.immortal, info = &kernel.")
            try self.put("bytes_info" if as_bytes else "text_info")
            try self.put("), data = ")
            try self.text_literal(self.texts.get(i), as_bytes)
            try self.put(")")
            try self.end()

    ## The functions of every type holding references the program used, and of the types
    ## those reach; the list grows while it is walked.
    mutating func lifetime_functions() -> !:
        while self.lifetimes_done < self.lifetimes.count:
            let t = self.lifetimes.get(self.lifetimes_done)
            self.lifetimes_done += 1
            try self.lifetime_function_set(t)

    mutating func lifetime_function_set(id: u32) -> !:
        let t = self.checker.table.get(id)
        # copy: a reference of its own to every object held
        try self.lifetime_head("L_copy_", id, ") -> ", id)
        self.indent += 1
        match t.kind:
            .class_, .list_, .map_, .set_, .str_, .bytes_:
                try self.begin("return (")
                try self.type_of(id)
                try self.put(")heap.retain((heap.Object*)v)")
                try self.end()
            .weak_: try self.line("return heap.weak_copy(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.lifetime_name("L_copy_", t.elem))
                try self.put("(inner)")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.member_copy(t.args[i], "v.", i)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_:
                try self.line("var out = v")
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("out.L_")
                        try self.put(m.text)
                        try self.put(" = ")
                        try self.put(try self.lifetime_name("L_copy_", m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        try self.begin(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        var p = m.body
                        var first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            p = field.next
                        try self.put("): return L_")
                        try self.put(t.name)
                        try self.put(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        p = m.body
                        first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            try self.put(" = ")
                            if self.checker.table.has_references(field.type_id):
                                try self.put(try self.lifetime_name("L_copy_", field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                            else:
                                try self.put("L_")
                                try self.put(field.text)
                            p = field.next
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("_: return v")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot copy")
        self.indent -= 1
        try self.line("")
        # drop and trace: every object held, a class field of zero (never assigned) skipped
        try self.lifetime_head("L_drop_", id, "):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_drop_", "")
        self.indent -= 1
        try self.line("")
        try self.lifetime_head("L_trace_", id, ", visit: func(heap.Object*, void*) -> unit, context: void*):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_trace_", ", visit, context")
        self.indent -= 1
        try self.line("")
        # pool: a temporary of the statement, and the drop through a pointer it needs
        try self.lifetime_head("L_pool_", id, ") -> ", id)
        self.indent += 1
        if self.is_object_kind(t.kind):
            try self.begin("return (")
            try self.type_of(id)
            try self.put(")heap.pool_object((heap.Object*)v)")
            try self.end()
        else:
            try self.begin("return heap.pool_value[")
            try self.type_of(id)
            try self.put("](v, ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put(")")
            try self.end()
        self.indent -= 1
        try self.line("")
        if not self.is_object_kind(t.kind):
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put("(p: void*):")
            try self.end()
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", id))
            try self.put("(memory.read[")
            try self.type_of(id)
            try self.put("](p))")
            try self.end()
            try self.line("")
        # identity, and a weak reference's get, for a class and its optional
        let inner = self.checker.table.kind(t.elem) if t.kind == types.Kind.optional else t.kind
        let identity_kinds = (self.is_object_kind(t.kind) and t.kind != types.Kind.str_ and t.kind != types.Kind.bytes_) or (t.kind == types.Kind.optional and self.is_object_kind(inner) and inner != types.Kind.str_ and inner != types.Kind.bytes_)
        if identity_kinds:
            try self.lifetime_head("L_id_", id, ") -> usize:", types.none_id)
            if t.kind != types.Kind.optional:
                try self.line("    return (usize)v")
            else:
                try self.line("    if let o = v:")
                try self.line("        return (usize)o")
                try self.line("    return 0")
            try self.line("")
        if t.kind == types.Kind.class_:
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_weak_get_", id))
            try self.put("(w: heap.Weak) -> ")
            try self.type_of(id)
            try self.put("?:")
            try self.end()
            try self.line("    if let o = heap.weak_get(w):")
            try self.begin("        return (")
            try self.type_of(id)
            try self.put(")o")
            try self.end()
            try self.line("    return none")
            try self.line("")
        if t.kind == types.Kind.list_ or t.kind == types.Kind.map_ or t.kind == types.Kind.set_:
            try self.collection_support(id, t)

    func is_object_kind(k: types.Kind) -> bool:
        return k == types.Kind.class_ or k == types.Kind.list_ or k == types.Kind.map_ or k == types.Kind.set_ or k == types.Kind.str_ or k == types.Kind.bytes_

    ## What a collection needs beside its lifetime functions: the runtime's descriptor and
    ## the drop and trace it calls; the element operations come per element type.
    mutating func collection_support(id: u32, t: types.Type) -> !:
        let drop = try self.lifetime_name("L_colldrop_", id)
        let trace = try self.lifetime_name("L_colltrace_", id)
        let is_list = t.kind == types.Kind.list_
        try self.begin("func ")
        try self.put(drop)
        try self.put("(o: heap.Object*):")
        try self.end()
        try self.begin("    kernel.list_drop[" if is_list else "    kernel.map_drop[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o)")
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(trace)
        try self.put("(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    kernel.list_trace[" if is_list else "    kernel.map_trace[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o, visit, context)")
        try self.end()
        try self.line("")
        try self.begin("var ")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(": heap.Info = heap.Info(name = \"")
        try self.put("list" if is_list else "map" if t.kind == types.Kind.map_ else "set")
        try self.put("\", size = sizeof(")
        try self.type_of_object(id)
        try self.put("), finish = none, drop = ")
        try self.put(drop)
        try self.put(", trace = ")
        try self.put(trace)
        try self.put(")")
        try self.end()
        try self.line("")
        discard(try self.ops_name(t.elem))
        if t.kind == types.Kind.map_:
            discard(try self.ops_name(self.checker.table.map_value(id)))

    ## The collection's Base struct, `kernel.List[T]` without the star.
    mutating func type_of_object(id: u32) -> !:
        let start = self.out.used
        try self.type_of(id)
        let text = try self.capture(start)
        try self.put((str)text.bytes[..<text.length - 1])

    ## The operations table of an element type, emitted after the program.
    mutating func ops_name(t: u32) -> str!:
        try self.remember(&self.ops_types, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_ops_{t}"))

    mutating func ops_tables() -> !:
        while self.ops_done < self.ops_types.count:
            let elem = self.ops_types.get(self.ops_done)
            self.ops_done += 1
            try self.begin("var ")
            try self.put(try self.ops_name(elem))
            try self.put(": kernel.Ops[")
            try self.type_of(elem)
            try self.put("] = kernel.Ops[")
            try self.type_of(elem)
            try self.put("](copy = ")
            let holds = self.checker.table.has_references(elem)
            try self.put(try self.lifetime_name("L_copy_", elem) if holds else "none")
            try self.put(", drop = ")
            try self.put(try self.lifetime_name("L_drop_", elem) if holds else "none")
            try self.put(", trace = ")
            try self.put(try self.lifetime_name("L_trace_", elem) if holds else "none")
            try self.put(", equal = ")
            let equatable = bodies.equatable(self.checker, elem)
            try self.put(try self.equality_name(elem) if equatable else "none")
            try self.put(", compare = ")
            try self.put(try self.ordering_name(elem) if bodies.orderable(self.checker, elem) else "none")
            try self.put(", hashed = ")
            try self.put(try self.hash_name(elem) if equatable else "none")
            try self.put(")")
            try self.end()

    # -- hashing ------------------------------------------------------------------------

    ## The function hashing a value of the type from the runtime's offset, and the one
    ## folding it into a hash so far (docs/RUNTIME.md).
    mutating func hash_name(t: u32) -> str!:
        try self.remember(&self.hashes, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_hash_{t}"))

    mutating func hash_in_name(t: u32) -> str!:
        try self.remember(&self.hashes, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_hashin_{t}"))

    mutating func hash_functions() -> !:
        while self.hashes_done < self.hashes.count:
            let t = self.hashes.get(self.hashes_done)
            self.hashes_done += 1
            try self.hash_function(t)

    mutating func hash_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.hash_name(id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> u64:")
        try self.end()
        try self.begin("    return ")
        try self.put(try self.hash_in_name(id))
        try self.put("(kernel.hash_offset, v)")
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(try self.hash_in_name(id))
        try self.put("(h: u64, v: ")
        try self.type_of(id)
        try self.put(") -> u64:")
        try self.end()
        self.indent += 1
        match t.kind:
            .int_: try self.line("return kernel.hash_int(h, v)")
            .float_: try self.line("return kernel.hash_float(h, v)")
            .bool_: try self.line("return kernel.hash_bool(h, v)")
            .str_: try self.line("return kernel.hash_text(h, v)")
            .bytes_: try self.line("return kernel.hash_blob(h, v)")
            .unit_: try self.line("return h")
            .error_code: try self.line("return kernel.hash_int(h, (i64)v)")
            .range_: try self.line("return kernel.hash_range(h, v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.hash_in_name(t.elem))
                try self.put("(kernel.hash_byte(h, 1), inner)")
                try self.end()
                try self.line("return kernel.hash_byte(h, 0)")
            .tuple:
                try self.line("var out = h")
                var i: usize = 0
                while i < t.args.length:
                    try self.begin("out = ")
                    try self.put(try self.hash_in_name(t.args[i]))
                    try self.put("(out, v.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    try self.end()
                    i += 1
                try self.line("return out")
            .struct_:
                let d = t.decl else return
                try self.line("var out = h")
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        try self.begin("out = ")
                        try self.put(try self.hash_in_name(m.type_id))
                        try self.put("(out, v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                let d = t.decl else return
                try self.line("match v:")
                self.indent += 1
                var index: i64 = 0
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        self.indent += 1
                        try self.begin("var out = kernel.hash_int(h, ")
                        try self.put_u64((u64)index)
                        try self.put(")")
                        try self.end()
                        var p = m.body
                        while let field = p:
                            try self.begin("out = ")
                            try self.put(try self.hash_in_name(field.type_id))
                            try self.put("(out, L_")
                            try self.put(field.text)
                            try self.put(")")
                            try self.end()
                            p = field.next
                        try self.line("return out")
                        self.indent -= 1
                        index += 1
                    cursor = m.next
                self.indent -= 1
            .list_:
                try self.line("var out = h")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    out = ")
                try self.put(try self.hash_in_name(t.elem))
                try self.put("(out, v.items[i])")
                try self.end()
                try self.line("    i += 1")
                try self.line("return out")
            .set_:
                try self.begin("return kernel.hash_int(h, (i64)kernel.set_hash[")
                try self.type_of(t.elem)
                try self.put("](v))")
                try self.end()
            .map_:
                try self.begin("return kernel.hash_int(h, (i64)kernel.map_hash[")
                try self.map_types(id)
                try self.put("](v))")
                try self.end()
            _: return try self.fail(t.decl else self.checker.tree(), "a type the emitter cannot hash")
        self.indent -= 1
        try self.line("")

    # -- equality and ordering functions ------------------------------------------------

    ## Whether `==` on the type is a call: a collection, or a value holding one, since Base's
    ## own `==` on the pointer would compare identity.
    func needs_equality(id: u32) -> bool:
        let t = self.checker.table.get(id)
        match t.kind:
            .list_, .map_, .set_, .bytes_, .str_: return true
            .optional: return self.needs_equality(t.elem)
            .tuple:
                for m in t.args:
                    if self.needs_equality(m):
                        return true
                return false
            .struct_, .enum_:
                let d = t.decl else return false
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.needs_equality(m.type_id):
                        return true
                    if m.kind == ast.Kind.enum_case:
                        var p = m.body
                        while let field = p:
                            if self.needs_equality(field.type_id):
                                return true
                            p = field.next
                    cursor = m.next
                return false
            _: return false

    ## The function comparing two values of the type for equality, emitted after the
    ## program.
    mutating func equality_name(t: u32) -> str!:
        try self.remember(&self.equalities, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_eq_{t}"))

    ## The function ordering two values of the type: -1, 0, 1.
    mutating func ordering_name(t: u32) -> str!:
        try self.remember(&self.orderings, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_cmp_{t}"))

    mutating func remember(where: list.List[u32]*, t: u32) -> !:
        var i: usize = 0
        while i < where.count:
            if where.get(i) == t:
                return
            i += 1
        try where.push(t)

    mutating func comparison_functions() -> !:
        while self.equalities_done < self.equalities.count:
            let t = self.equalities.get(self.equalities_done)
            self.equalities_done += 1
            try self.equality_function(t)
        while self.orderings_done < self.orderings.count:
            let t = self.orderings.get(self.orderings_done)
            self.orderings_done += 1
            try self.ordering_function(t)

    mutating func equality_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.equality_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> bool:")
        try self.end()
        self.indent += 1
        match t.kind:
            .list_:
                try self.begin("return kernel.list_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .map_:
                try self.begin("return kernel.map_equal[")
                try self.map_types(id)
                try self.put("](a, b)")
                try self.end()
            .set_:
                try self.begin("return kernel.set_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .bytes_: try self.line("return kernel.bytes_equal(a, b)")
            .str_: try self.line("return kernel.text_equal(a, b)")
            .optional:
                try self.line("if let x = a:")
                try self.line("    if let y = b:")
                try self.begin("        return ")
                try self.put(try self.member_equality(t.elem, "x", "y"))
                try self.end()
                try self.line("    return false")
                try self.line("return b == none")
            .tuple:
                try self.begin("return ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(" and ")
                    let half = self.checker.scratch.length // 2
                    let x = try copy_name(try format(self.checker.scratch[half..], f"a.{i}"))
                    let y = try copy_name(try format(self.checker.scratch[half..], f"b.{i}"))
                    try self.put(try self.member_equality(t.args[i], x, y))
                    i += 1
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.begin("return ")
                var cursor = d.body
                var first = true
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        if not first:
                            try self.put(" and ")
                        first = false
                        let half = self.checker.scratch.length // 2
                        let x = try copy_name(try format(self.checker.scratch[half..], f"a.L_{m.text}"))
                        let y = try copy_name(try format(self.checker.scratch[half..], f"b.L_{m.text}"))
                        try self.put(try self.member_equality(m.type_id, x, y))
                    cursor = m.next
                if first:
                    try self.put("true")
                try self.end()
            .enum_:
                let d = t.decl else return
                try self.line("match a:")
                self.indent += 1
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("x_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        self.indent += 1
                        try self.line("match b:")
                        try self.begin("    .L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("y_")
                                try self.put(field.text)
                                p = field.next
                            try self.put("): return ")
                            p = m.body
                            first = true
                            while let field = p:
                                if not first:
                                    try self.put(" and ")
                                first = false
                                let half = self.checker.scratch.length // 2
                                let x = try copy_name(try format(self.checker.scratch[half..], f"x_{field.text}"))
                                let y = try copy_name(try format(self.checker.scratch[half..], f"y_{field.text}"))
                                try self.put(try self.member_equality(field.type_id, x, y))
                                p = field.next
                        else:
                            try self.put(": return true")
                        try self.end()
                        try self.line("    _: return false")
                        self.indent -= 1
                    cursor = m.next
                self.indent -= 1
            _: try self.line("return a == b")
        self.indent -= 1
        try self.line("")

    ## `x == y` as text, through the type's function where it needs one.
    mutating func member_equality(t: u32, x: str, y: str) -> str!:
        let half = self.checker.scratch.length // 2
        if self.needs_equality(t):
            return try copy_name(try format(self.checker.scratch[half..], f"{try self.equality_name(t)}({x}, {y})"))
        return try copy_name(try format(self.checker.scratch[half..], f"({x} == {y})"))

    mutating func ordering_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.ordering_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> i64:")
        try self.end()
        self.indent += 1
        match t.kind:
            .int_, .float_, .bool_: try self.line("return -1 if a < b else 1 if a > b else 0")
            .str_: try self.line("return kernel.compare_text(a, b)")
            .bytes_: try self.line("return kernel.compare_blobs(a, b)")
            .tuple:
                var i: usize = 0
                while i < t.args.length:
                    let c = try self.temp("c")
                    try self.begin("let ")
                    try self.put(c)
                    try self.put(" = ")
                    try self.put(try self.ordering_name(t.args[i]))
                    try self.put("(a.")
                    try self.put_u64((u64)i)
                    try self.put(", b.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    try self.end()
                    try self.begin("if ")
                    try self.put(c)
                    try self.put(" != 0:")
                    try self.end()
                    try self.begin("    return ")
                    try self.put(c)
                    try self.end()
                    i += 1
                try self.line("return 0")
            _: return try self.fail(self.checker.tree(), "a type the emitter cannot order")
        self.indent -= 1
        try self.line("")

    ## `func NAME(v: T` and what follows; a result type when `result` is given.
    mutating func lifetime_head(prefix: str, id: u32, tail: str, result: u32) -> !:
        try self.begin("func ")
        try self.put(try self.lifetime_name(prefix, id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(tail)
        if result != types.none_id:
            try self.type_of(result)
            try self.put(":")
        try self.end()

    ## One member of a tuple copy: copied when it holds references.
    mutating func member_copy(t: u32, prefix: str, i: usize) -> !:
        if self.checker.table.has_references(t):
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
            try self.put(prefix)
            try self.put_u64((u64)i)
            try self.put(")")
        else:
            try self.put(prefix)
            try self.put_u64((u64)i)

    ## The body of a drop or trace: the call `prefix` on every part holding references,
    ## `extra` appended to the arguments.
    mutating func walk_references(t: types.Type, id: u32, prefix: str, extra: str) -> !:
        match t.kind:
            .str_, .bytes_:
                # a text holds no references: released, never traced
                if prefix == "L_drop_":
                    try self.line("if (usize)v != 0:")
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("discard(v)")
            .class_, .list_, .map_, .set_:
                try self.line("if (usize)v != 0:")
                if prefix == "L_drop_":
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("    visit((heap.Object*)v, context)")
            .weak_:
                if prefix == "L_drop_":
                    try self.line("heap.weak_drop(v)")
                else:
                    try self.line("discard(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    ")
                try self.put(try self.lifetime_name(prefix, t.elem))
                try self.put("(inner")
                try self.put(extra)
                try self.put(")")
                try self.end()
            .tuple:
                var i: usize = 0
                var any = false
                while i < t.args.length:
                    if self.checker.table.has_references(t.args[i]):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, t.args[i]))
                        try self.put("(v.")
                        try self.put_u64((u64)i)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    i += 1
                if not any:
                    try self.line("discard(v)")
            .struct_:
                let d = t.decl else return
                var cursor = d.body
                var any = false
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    cursor = m.next
                if not any:
                    try self.line("discard(v)")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        var holds = false
                        var p = m.body
                        while let field = p:
                            if self.checker.table.has_references(field.type_id):
                                holds = true
                            p = field.next
                        if holds:
                            try self.begin(".L_")
                            try self.put(m.text)
                            try self.put("(")
                            p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                if self.checker.table.has_references(field.type_id):
                                    try self.put("L_")
                                    try self.put(field.text)
                                else:
                                    try self.put("_")
                                p = field.next
                            try self.put("):")
                            try self.end()
                            self.indent += 1
                            p = m.body
                            while let field = p:
                                if self.checker.table.has_references(field.type_id):
                                    try self.begin("")
                                    try self.put(try self.lifetime_name(prefix, field.type_id))
                                    try self.put("(L_")
                                    try self.put(field.text)
                                    try self.put(extra)
                                    try self.put(")")
                                    try self.end()
                                p = field.next
                            self.indent -= 1
                    cursor = m.next
                try self.line("_: discard(0)")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot walk")

    mutating func show_functions() -> !:
        while self.shown_done < self.shown.count:
            let t = self.shown.get(self.shown_done)
            self.shown_done += 1
            try self.show_function(t)

    mutating func show_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        let name = try self.show_name(id)
        try self.begin("func ")
        try self.put(name)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> kernel.Text*:")
        try self.end()
        self.indent += 1
        match t.kind:
            .list_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.items[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"[\", \"]\")")
            .set_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .map_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.pair_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]), ")
                try self.put(try self.show_name(self.checker.table.map_value(id)))
                try self.put("(v.values[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .unit_:
                try self.begin("return ")
                try self.put(try self.text_ref("()", false))
                try self.end()
            .error_code:
                try self.begin("return kernel.join_owned([")
                try self.put(try self.text_ref("ErrorCode(", false))
                try self.put(", kernel.show_int((i64)v), ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .error_value: try self.line("return kernel.text_of(v.message)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.show_name(t.elem))
                try self.put("(inner)")
                try self.end()
                try self.begin("return ")
                try self.put(try self.text_ref("none", false))
                try self.end()
            .tuple:
                try self.begin("return kernel.join_owned([")
                try self.put(try self.text_ref("(", false))
                try self.put(", ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                        try self.put(try self.text_ref(", ", false))
                        try self.put(", ")
                    try self.put(try self.show_name(t.args[i]))
                    try self.put("(v.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    i += 1
                if t.args.length == 1:
                    try self.put(", ")
                    try self.put(try self.text_ref(",", false))
                try self.put(", ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.begin("return kernel.join_owned([")
                let half = self.checker.scratch.length // 2
                try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{d.text}(")), false))
                var cursor = d.body
                var first = true
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        try self.put(", ")
                        let label = try copy_name(try format(self.checker.scratch[half..], f"{", " if not first else ""}{m.text} = "))
                        first = false
                        try self.put(try self.text_ref(label, false))
                        try self.put(", ")
                        try self.put(try self.show_name(m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                    cursor = m.next
                try self.put(", ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .enum_:
                let d = t.decl else return
                try self.line("match v:")
                self.indent += 1
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        let half = self.checker.scratch.length // 2
                        try self.begin("    return kernel.join_owned([")
                        if m.body != none:
                            try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{d.text}.{m.text}(")), false))
                            var p = m.body
                            var first = true
                            while let field = p:
                                try self.put(", ")
                                let label = try copy_name(try format(self.checker.scratch[half..], f"{", " if not first else ""}{field.text} = "))
                                first = false
                                try self.put(try self.text_ref(label, false))
                                try self.put(", ")
                                try self.put(try self.show_name(field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                                p = field.next
                            try self.put(", ")
                            try self.put(try self.text_ref(")", false))
                            try self.put("])")
                        else:
                            try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{d.text}.{m.text}")), false))
                            try self.put("])")
                        try self.end()
                    cursor = m.next
                self.indent -= 1
            _: return try self.checker.fail(self.checker.tree(), "a value this slice does not display")
        self.indent -= 1
        try self.line("")

    ## The pieces of a formatted text, joined.
    mutating func formatted(e: ast.Node*) -> !:
        try self.put("kernel.join([")
        var cursor = e.body
        var first = true
        while let part = cursor:
            if not first:
                try self.put(", ")
            first = false
            if part.kind == ast.Kind.format_text:
                try self.put(try self.text_ref(try unescape_format(part.text), false))
            else:
                let v = part.left else return
                try self.show(v)
            cursor = part.next
        if first:
            try self.put(try self.text_ref("", false))
        try self.put("])")

    mutating func match_expr(e: ast.Node*) -> !:
        let subject = e.left else return
        let st = self.checker.table.get(subject.type_id)
        if st.kind == types.Kind.tuple or st.kind == types.Kind.bytes_:
            try self.match_expr_by_tests(e, subject, st)
            return
        try self.put("match ")
        try self.use(subject)
        if st.kind == types.Kind.str_:
            # Base matches a text's bytes against its literals
            try self.put(".data")
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = e.body
        var bound_any = false
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, "", &bound)
                p = pattern.next
            if bound != none:
                return try self.fail(arm, "a name pattern in a match expression compiles in a later slice; use the statement form")
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(" => ")
            let body = arm.body else return
            try self.owned(body)
            try self.end()
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(e):
            try self.line("_ => trap(\"no arm applied\")")
        self.indent -= 1
        try self.begin("")

## Whether a pattern binds a name anywhere inside it.
func binds_a_name(p: ast.Node*) -> bool:
    if p.has(ast.flag_wildcard):
        return false
    if p.text == "bind":
        return true
    if p.text == "tuple":
        var cursor = p.body
        while let sub = cursor:
            if binds_a_name(sub):
                return true
            cursor = sub.next
    return false

## Whether every pattern in the list matches anything: `_`, a name, a tuple of those.
func irrefutable(patterns: ast.Node*?) -> bool:
    var cursor = patterns
    while let p = cursor:
        if p.text == "tuple":
            if not irrefutable(p.body):
                return false
        elif not (p.has(ast.flag_wildcard) or p.text == "bind"):
            return false
        cursor = p.next
    return true

func has_wildcard_arm(s: ast.Node*) -> bool:
    var cursor = s.body
    while let arm = cursor:
        var p = arm.left
        while let pattern = p:
            if (pattern.has(ast.flag_wildcard) or pattern.text == "bind") and arm.right == none:
                return true
            p = pattern.next
        cursor = arm.next
    return false

## `<` for `<=`, `>` for `>=`: the strict form of an order, for a tuple's earlier members.
func strict(op: str) -> str:
    if op == "<=":
        return "<"
    if op == ">=":
        return ">"
    return op

## `{{` and `}}` in the literal part of a formatted string are one brace each.
func unescape_format(text: str) -> str!:
    let b = text.bytes
    var out = try alloc u8[b.length + 1]
    var n: usize = 0
    var i: usize = 0
    while i < b.length:
        if (b[i] == '{' or b[i] == '}') and i + 1 < b.length and b[i + 1] == b[i]:
            out[n] = b[i]
            n += 1
            i += 2
            continue
        if b[i] == '\\' and i + 1 < b.length:
            let e = b[i + 1]
            out[n] = '\n' if e == 'n' else '\t' if e == 't' else '\r' if e == 'r' else 0 if e == '0' else e
            n += 1
            i += 2
            continue
        out[n] = b[i]
        n += 1
        i += 1
    return (str)out[..<n]

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

## A name kept on the heap, since the scratch it was formatted in is reused.
func copy_name(text: str) -> str!:
    var out = try alloc u8[text.length]
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    return (str)out
