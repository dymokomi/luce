#==============================================================================================
#
#   base - The typed tree written out as Base
#
#   DESCRIPTION:
#       Base is the machine form. The translation is close to an isomorphism: a Luce local is
#       a Base local, a struct a struct, an enum an enum, `if`, `while`, `match`, `break` and
#       `continue` are themselves, and checked `int` arithmetic is Base's own, so a trap is
#       the operator. What Base does not spell, Python's `//`, `%` and `**`, text made of
#       pieces, the display of a value, Luce's indexes and slices, is a call into `rt.kernel`.
#       Every name a program wrote is prefixed `L_`, since Base reserves words Luce does not.
#       Objects follow docs/RUNTIME.md: `expr` writes a borrowed value for a read of a
#       binding and an owned one for everything else, `owned` and `use` say which a place
#       needs, a binding drops what it owned when its block ends, and a statement whose
#       expression pooled a temporary is wrapped in a mark and a drain. Nothing here
#       decides a language question: the checker already did.
#
#==============================================================================================

import front.ast
import sema.check
import sema.bodies
import sema.types
import support.buffer
import support.list
import support.literals

pub let unsupported: ErrorCode = ErrorCode.package(15)

pub struct Emitter:
    var checker: check.Checker*
    var out: buffer.Buffer
    var indent: u32
    var temps: u32
    ## Types whose display function is needed, emitted after the program.
    var shown: list.List[u32]
    ## Types holding references, whose copy, drop, trace and pool functions are emitted
    ## after the program.
    var lifetimes: list.List[u32]
    ## Types whose `==` and ordering need a function of their own (collections, and what
    ## holds them), emitted after the program.
    var equalities: list.List[u32]
    var orderings: list.List[u32]
    ## Types hashed (§4.4) and types that are a collection's elements, each with a
    ## function or an operations table of its own after the program.
    var hashes: list.List[u32]
    var ops_types: list.List[u32]
    ## Text and bytes literals, each an immortal object declared after the program; the
    ## text, and whether it is bytes.
    var texts: list.List[str]
    var texts_are_bytes: list.List[bool]
    var texts_done: usize
    ## Closures (§7.4): lambdas whose object, body and constructor are written after the
    ## program; named functions used as values, each an immortal closure and a thunk;
    ## methods bound as values; function types called through a value; element types
    ## whose captured `var`s need a cell descriptor.
    var lambdas: list.List[ast.Node*]
    var lambdas_done: usize
    var thunks: list.List[ast.Node*]
    var thunks_done: usize
    var bounds: list.List[ast.Node*]
    var bounds_done: usize
    var calls: list.List[u32]
    var calls_done: usize
    var cells: list.List[u32]
    var cells_done: usize
    ## Interface values (§13.2): each pair of an interface and a conforming type used as
    ## one gets a box, its table and the shims after the program.
    var box_interfaces: list.List[u32]
    var box_types: list.List[u32]
    var boxes_done: usize
    ## The Base boundary (§16): types converted at a crossing, each with a pair of
    ## functions after the program; named functions handed to Base as callbacks, each
    ## with a thunk over Base's types.
    var crossings: list.List[ast.Node*]
    var crossing_owners: list.List[ast.Node*]
    var crossings_done: usize
    var callbacks: list.List[ast.Node*]
    var callbacks_done: usize
    ## Workers (§14): each `spawn` gets a task object, a run and a cleanup after the
    ## program; each result type a `wait`; each sent type a copy that shares nothing.
    var spawns: list.List[ast.Node*]
    var spawns_done: usize
    var waits: list.List[u32]
    var waits_done: usize
    var sends: list.List[u32]
    var sends_done: usize
    ## The lambda whose body is being written, so its captures read from its object.
    var lambda: ast.Node*?
    ## How many of each list are written out, since writing one set of functions can
    ## register more; `support_functions` runs until nothing new appears.
    var shown_done: usize
    var lifetimes_done: usize
    var equalities_done: usize
    var orderings_done: usize
    var hashes_done: usize
    var ops_done: usize
    ## Operands hoisted before the statement (RUNTIME 5): `let` lines, written ahead of the
    ## statement when it is wrapped.
    var prelude: buffer.Buffer
    ## The operands hoisted for the statement being written, and their names: a node
    ## written again in the statement is written by its name, so a call runs once.
    var hoisted_nodes: list.List[ast.Node*]
    var hoisted_names: list.List[str]
    ## `luce test --build`: the tests are written as functions and `main` runs them (§17.3).
    pub var tests_mode: bool
    var test_names: list.List[str]
    ## Whether the statement being written pooled a temporary, so it needs a drain.
    var pooled: bool
    ## Whether the function being written can fail, so that a drain on the failing path
    ## (`errdefer`) is possible and needed.
    var fallible: bool
    ## Inside a match statement, where a bound payload is copied at the arm's start and
    ## the pattern writes its raw name; a match expression borrows the payload as is.
    var raw_payloads: bool
    ## Inside an enum's or a class's method, where `self` is an ordinary parameter.
    var self_name: str

    pub static func over(checker: check.Checker*) -> Emitter!:
        return Emitter(checker = checker, out = try buffer.Buffer.create(65536), indent = 0, temps = 0,
                       shown = try list.List[u32].create(16), lifetimes = try list.List[u32].create(16),
                       equalities = try list.List[u32].create(16), orderings = try list.List[u32].create(16),
                       hashes = try list.List[u32].create(16), ops_types = try list.List[u32].create(16),
                       texts = try list.List[str].create(64), texts_are_bytes = try list.List[bool].create(64), texts_done = 0,
                       lambdas = try list.List[ast.Node*].create(16), lambdas_done = 0, thunks = try list.List[ast.Node*].create(16), thunks_done = 0,
                       bounds = try list.List[ast.Node*].create(16), bounds_done = 0, calls = try list.List[u32].create(16), calls_done = 0,
                       cells = try list.List[u32].create(16), cells_done = 0, lambda = none,
                       box_interfaces = try list.List[u32].create(16), box_types = try list.List[u32].create(16), boxes_done = 0,
                       crossings = try list.List[ast.Node*].create(16), crossing_owners = try list.List[ast.Node*].create(16), crossings_done = 0,
                       spawns = try list.List[ast.Node*].create(8), spawns_done = 0, waits = try list.List[u32].create(8), waits_done = 0, sends = try list.List[u32].create(16), sends_done = 0, callbacks = try list.List[ast.Node*].create(8), callbacks_done = 0,
                       shown_done = 0, lifetimes_done = 0, equalities_done = 0, orderings_done = 0, hashes_done = 0, ops_done = 0,
                       pooled = false, fallible = false, raw_payloads = false, self_name = "self",
                       tests_mode = false, test_names = try list.List[str].create(8), prelude = try buffer.Buffer.create(1024),
                       hoisted_nodes = try list.List[ast.Node*].create(8), hoisted_names = try list.List[str].create(8))

    pub func text() -> str:
        return self.out.view()

    # -- writing --------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        try self.out.put(text)

    mutating func line(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)
        try self.out.put("\n")

    mutating func begin(text: str) -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.out.put("    ")
            i += 1
        try self.out.put(text)

    mutating func end() -> !:
        try self.out.put("\n")

    func fail(node: ast.Node*, what: str) -> never!:
        return try self.checker.fail(node, what)

    mutating func temp(prefix: str) -> str!:
        self.temps += 1
        let half = self.checker.scratch.length // 2
        # an underscore keeps `i16` and the like from becoming Base's type names
        let name = try format(self.checker.scratch[half..], f"{prefix}_{self.temps}")
        return try copy_name(name)

    ## The text written since `start`, taken back out of the output.
    mutating func capture(start: usize) -> str!:
        let text = try copy_name((str)self.out.bytes()[start..])
        self.out.used = start
        return text

    ## A statement's text wrapped in a mark and a drain when it pooled a temporary.
    mutating func drained(start: usize, pooled_before: bool) -> !:
        try self.drained_unless(start, pooled_before, false)

    ## `drained`, except that a statement every path of which leaves the function gets no
    ## drain after it: Base would see the function's end reachable through the dead line,
    ## and the caller's next drain releases what such a statement pooled.
    mutating func drained_unless(start: usize, pooled_before: bool, terminal: bool) -> !:
        if self.pooled:
            let text = try self.capture(start)
            let m = try self.temp("mark")
            try self.begin("let ")
            try self.put(m)
            try self.put(" = heap.mark()")
            try self.end()
            if self.fallible:
                try self.begin("errdefer heap.drain(")
                try self.put(m)
                try self.put(")")
                try self.end()
            if self.prelude.used > 0:
                try self.put(self.prelude.view())
                self.prelude.used = 0
            try self.put(text)
            if not terminal:
                try self.begin("heap.drain(")
                try self.put(m)
                try self.put(")")
                try self.end()
        self.hoisted_nodes.count = 0
        self.hoisted_names.count = 0
        self.pooled = pooled_before

    ## Whether every path through the statement leaves the function, as the checker
    ## decided (§7.1): a `return`, a call that never returns, a `match` whose arms all do
    ## (`flag_all_exit`), an `if` whose branches all do, a block whose last statement does.
    func exits(s: ast.Node*) -> bool:
        match s.kind:
            .return_: return true
            .match_: return s.has(ast.flag_all_exit)
            .expr_stmt:
                let e = s.left else return false
                return e.type_id == types.never_id
            .if_:
                let body = s.body else return false
                let rest = s.right else return false
                return self.exits(body) and self.exits(rest)
            .block:
                var last: ast.Node*? = none
                var cursor = s.body
                while let st = cursor:
                    last = st
                    cursor = st.next
                let l = last else return false
                return self.exits(l)
            _: return false

    # -- the program ----------------------------------------------------------------------

    pub mutating func program() -> !:
        try self.line("## generated by luce; edit the .luc source, not this")
        try self.line("import memory")
        try self.line("import rt.heap")
        try self.line("import rt.kernel")
        var k: usize = 0
        while k < self.checker.modules.count:
            let m = self.checker.modules.get(k)
            if m.base:
                try self.begin("import ")
                try self.put(m.name)
                try self.end()
            k += 1
        try self.line("")
        # the literal objects come before the declarations: a constant of the program
        # holds the address of one, and the C backend defines globals in order
        let start = self.out.used
        k = 0
        while k < self.checker.order.count:
            let tree = self.checker.modules.get((usize)self.checker.order.get(k)).tree
            k += 1
            try self.declarations(tree)
        let body = try self.capture(start)
        try self.text_objects()
        try self.put(body)
        try self.program_tail()

    ## The declarations of one module, in order.
    mutating func declarations(tree: ast.Node*) -> !:
        var cursor = tree.body
        while let d = cursor:
            # a generic declaration is never written, nor an instance over a parameter
            let concrete = d.ty == none or (d.has(ast.flag_instance) and not self.checker.abstract_instance(d))
            if d.has(ast.flag_base):
                # a Base module's declarations (§16): a shim per function, a class per handle,
                # the crossing types as they are; constants are read where they are used
                match d.kind:
                    .func_: try self.shim(d)
                    .class_: try self.handle_decl(d)
                    .struct_: try self.struct_decl(d)
                    .enum_: try self.enum_decl(d)
                    _: discard(0)
                cursor = d.next
                continue
            match d.kind:
                .constant: try self.constant(d)
                .struct_:
                    if concrete:
                        try self.struct_decl(d)
                .enum_:
                    if concrete:
                        try self.enum_decl(d)
                .class_:
                    if concrete:
                        try self.class_decl(d)
                .interface_:
                    if concrete and (not d.has(ast.flag_prelude) or d.has(ast.flag_instance)):
                        try self.interface_decl(d)
                .type_alias: discard(0)
                .func_:
                    if concrete:
                        try self.function(d, "")
                .test_:
                    if self.tests_mode:
                        try self.test_function(d)
                _: discard(0)
            cursor = d.next

    ## A test as a fallible function of nothing (§17.3).
    mutating func test_function(d: ast.Node*) -> !:
        let index = self.test_names.count
        try self.test_names.push(try copy_name(try literals.decode_text(d.text)))
        self.fallible = true
        try self.begin("func L_test_")
        try self.put_u64((u64)index)
        try self.put("() -> !:")
        try self.end()
        let body = d.body else return
        self.indent += 1
        try self.site_prologue()
        try self.block(body)
        self.indent -= 1
        try self.line("#:")
        try self.line("")

    mutating func program_tail() -> !:
        if self.tests_mode:
            try self.test_runner()
            try self.support_functions()
            return
        let args_type = try self.checker.table.list_of(types.str_id)
        let args_info = try self.lifetime_name("L_info_", args_type)
        let args_ops = try self.ops_name(types.str_id)
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    kernel.startup()")
        try self.begin("    let args = kernel.list_from_args(&")
        try self.put(args_info)
        try self.put(", ")
        try self.put(args_ops)
        try self.put(", arguments[1..])")
        try self.end()
        try self.line("    let status = L_main(args) catch failure:")
        try self.line("        kernel.print_error(failure.message)")
        try self.line("        return 1")
        try self.line("    heap.release((heap.Object*)args)")
        try self.line("    return heap.finish_run(i32(status))")
        try self.support_functions()

    ## `main` of a test build: every test in order, each reported, then the summary and
    ## the heap's word (§17.3).
    mutating func test_runner() -> !:
        try self.line("pub func main(arguments: str[]) -> i32:")
        try self.line("    kernel.startup()")
        try self.line("    discard(arguments)")
        try self.line("    var failures: i64 = 0")
        var i: usize = 0
        while i < self.test_names.count:
            let name = try self.text_ref(self.test_names.get(i), false)
            try self.begin("    let before_")
            try self.put_u64((u64)i)
            try self.put(" = failures")
            try self.end()
            try self.begin("    L_test_")
            try self.put_u64((u64)i)
            try self.put("() catch failure:")
            try self.end()
            try self.line("        failures += 1")
            try self.begin("        kernel.test_failed(kernel.text_view(")
            try self.put(name)
            try self.put("), \"")
            try self.put(try self.test_position(i))
            try self.put("\", failure.message)")
            try self.end()
            try self.line("        recover ()")
            try self.begin("    if failures == before_")
            try self.put_u64((u64)i)
            try self.put(":")
            try self.end()
            try self.begin("        kernel.test_passed(kernel.text_view(")
            try self.put(name)
            try self.put("))")
            try self.end()
            try self.line("    heap.drain(0)")
            i += 1
        try self.begin("    let status = kernel.test_summary(")
        try self.put_u64((u64)self.test_names.count)
        try self.put(", failures)")
        try self.end()
        try self.line("    return heap.finish_run(status)")

    ## `file:line:column` of the test at `index`, as the interpreter reports it.
    mutating func test_position(index: usize) -> str!:
        var seen: usize = 0
        var k: usize = 0
        while k < self.checker.order.count:
            let module_index = (usize)self.checker.order.get(k)
            k += 1
            let m = self.checker.modules.get(module_index)
            if module_index == 0 or m.base:
                continue
            var cursor = m.tree.body
            while let d = cursor:
                if d.kind == ast.Kind.test_:
                    if seen == index:
                        let (line, column) = m.src.position(d.start)
                        let half = self.checker.scratch.length // 2
                        return try copy_name(try format(self.checker.scratch[half..], f"{m.src.path}:{line}:{column}"))
                    seen += 1
                cursor = d.next
        return "?"

    mutating func constant(d: ast.Node*) -> !:
        let init = d.left else return
        try self.begin("let L_")
        try self.put(try self.decl_name(d))
        try self.put(": ")
        try self.type_of(d.type_id)
        try self.put(" = ")
        try self.expr(init)
        try self.end()
        try self.line("")

    mutating func struct_decl(d: ast.Node*) -> !:
        try self.begin("struct L_")
        try self.put(self.type_name(d))
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        var fields: u32 = 0
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
                fields += 1
            cursor = m.next
        if fields == 0:
            try self.line("pub var nothing: u8")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.line("")
                try self.function(m, "method")
            cursor = m.next
        self.indent -= 1
        try self.line("")

    ## An interface (§13.2): its value is a pointer to a box, an object whose header is
    ## followed by the table of the boxed type's methods and then the value itself; each
    ## method becomes a function over the pointer that calls through the table.
    mutating func interface_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    pub var header: heap.Object")
        try self.begin("    pub var table: L_")
        try self.put(name)
        try self.put("__table*")
        try self.end()
        try self.line("")
        try self.begin("struct L_")
        try self.put(name)
        try self.put("__table:")
        try self.end()
        var cursor = d.body
        var any = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.begin("    pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.shim_type(name, m)
                try self.end()
                any = true
            cursor = m.next
        if not any:
            try self.line("    pub var nothing: u8")
        try self.line("")
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                let ft = self.checker.table.get(m.type_id)
                try self.begin("func L_")
                try self.put(name)
                try self.put("__L_")
                try self.put(m.text)
                try self.put("(L_self: L_")
                try self.put(name)
                try self.put("*")
                try self.shim_parameters(m, true)
                try self.put(")")
                try self.result_type(ft.elem)
                try self.put(":")
                try self.end()
                try self.begin("    ")
                try self.shim_return(ft.elem)
                try self.put("L_self.table.L_")
                try self.put(m.text)
                try self.put("(L_self")
                try self.shim_parameters(m, false)
                try self.put(")")
                try self.end()
                try self.line("")
            cursor = m.next

    ## What precedes a shim's call of the method: `return` for a value, `return try` for
    ## a fallible value, `try` for a fallible `unit`, nothing for `unit`.
    mutating func shim_return(result: u32) -> !:
        if self.checker.table.kind(result) == types.Kind.fallible:
            if self.checker.table.get(result).elem == types.unit_id:
                try self.put("try ")
            else:
                try self.put("return try ")
        elif result != types.unit_id:
            try self.put("return ")

    ## The type of a table entry: a function over the interface pointer and the method's
    ## other parameters, its result spelled even when `unit`.
    mutating func shim_type(name: str, m: ast.Node*) -> !:
        let ft = self.checker.table.get(m.type_id)
        try self.put("func(L_")
        try self.put(name)
        try self.put("*")
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if ft.elem == types.unit_id:
            try self.put(" -> unit")
        elif self.checker.table.kind(ft.elem) == types.Kind.fallible and self.checker.table.get(ft.elem).elem == types.unit_id:
            # a function type spells a fallible `unit` in full
            try self.put(" -> unit!")
        else:
            try self.result_type(ft.elem)

    ## `, L_p: T` for every parameter but `self`, typed or as arguments passed on.
    mutating func shim_parameters(m: ast.Node*, typed: bool) -> !:
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", L_")
                try self.put(p.text)
                if typed:
                    try self.put(": ")
                    try self.type_of(p.type_id)
            cursor = p.next

    ## `L_I__T__box`: the function making an interface value of a `T`, registered for
    ## `box_support` to write.
    mutating func box_name(iface: u32, concrete: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.box_interfaces.count:
            if self.box_interfaces.get(i) == iface and self.box_types.get(i) == concrete:
                seen = true
            i += 1
        if not seen:
            try self.box_interfaces.push(iface)
            try self.box_types.push(concrete)
        let half = self.checker.scratch.length // 2
        let it = self.checker.table.get(iface)
        let ct = self.checker.table.get(concrete)
        return try copy_name(try format(self.checker.scratch[half..], f"L_{it.name}__{ct.name}__box"))

    ## The box of one interface and one conforming type: the object, a shim per method
    ## calling the type's own, the table of shims, the descriptor, and the constructor.
    mutating func box_support() -> !:
        while self.boxes_done < self.box_interfaces.count:
            let iface = self.box_interfaces.get(self.boxes_done)
            let concrete = self.box_types.get(self.boxes_done)
            self.boxes_done += 1
            let it = self.checker.table.get(iface)
            let ct = self.checker.table.get(concrete)
            let d = it.decl else return try self.fail(self.checker.tree(), "an interface without a declaration")
            let half = self.checker.scratch.length // 2
            let name = try copy_name(try format(self.checker.scratch[half..], f"L_{it.name}__{ct.name}"))
            try self.begin("struct ")
            try self.put(name)
            try self.put(":")
            try self.end()
            try self.line("    pub var header: heap.Object")
            try self.begin("    pub var table: L_")
            try self.put(it.name)
            try self.put("__table*")
            try self.end()
            try self.begin("    pub var value: ")
            try self.type_of(concrete)
            try self.end()
            try self.line("")
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.func_:
                    let own = self.checker.find_member(ct.decl else return try self.fail(d, "no declaration"), m.text) else return try self.fail(d, "a conformance without the method")
                    let ft = self.checker.table.get(own.type_id)
                    try self.begin("func ")
                    try self.put(name)
                    try self.put("__L_")
                    try self.put(m.text)
                    try self.put("(L_self: L_")
                    try self.put(it.name)
                    try self.put("*")
                    try self.shim_parameters(m, true)
                    try self.put(")")
                    try self.result_type(ft.elem)
                    try self.put(":")
                    try self.end()
                    try self.begin("    ")
                    try self.shim_return(ft.elem)
                    let receiver = try copy_name(try format(self.checker.scratch[half..], f"(({name}*)L_self).value"))
                    try self.method_on(concrete, own, receiver)
                    # a struct's method took the receiver before the parenthesis
                    var pc = m.right
                    var first_argument = ct.kind == types.Kind.struct_
                    while let p = pc:
                        if p.text != "self":
                            if not first_argument:
                                try self.put(", ")
                            first_argument = false
                            try self.put("L_")
                            try self.put(p.text)
                        pc = p.next
                    try self.put(")")
                    try self.end()
                    try self.line("")
                cursor = m.next
            try self.begin("func ")
            try self.put(name)
            try self.put("__drop(o: heap.Object*):")
            try self.end()
            if self.checker.table.has_references(concrete):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", concrete))
                try self.put("(((")
                try self.put(name)
                try self.put("*)o).value)")
                try self.end()
            else:
                try self.line("    discard(o)")
            try self.begin("func ")
            try self.put(name)
            try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
            try self.end()
            if self.checker.table.has_references(concrete):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", concrete))
                try self.put("(((")
                try self.put(name)
                try self.put("*)o).value, visit, context)")
                try self.end()
            else:
                try self.line("    discard(o)")
            try self.begin("var ")
            try self.put(name)
            try self.put("__table: L_")
            try self.put(it.name)
            try self.put("__table = L_")
            try self.put(it.name)
            try self.put("__table(")
            cursor = d.body
            var first = true
            while let m = cursor:
                if m.kind == ast.Kind.func_:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(m.text)
                    try self.put(" = ")
                    try self.put(name)
                    try self.put("__L_")
                    try self.put(m.text)
                cursor = m.next
            if first:
                try self.put("nothing = 0")
            try self.put(")")
            try self.end()
            try self.begin("var ")
            try self.put(name)
            try self.put("__info: heap.Info = heap.Info(name = \"")
            try self.put(it.name)
            try self.put("\", size = sizeof(")
            try self.put(name)
            try self.put("), finish = none, drop = ")
            try self.put(name)
            try self.put("__drop, trace = ")
            try self.put(name)
            try self.put("__trace)")
            try self.end()
            try self.begin("func ")
            try self.put(name)
            try self.put("__box(v: ")
            try self.type_of(concrete)
            try self.put(") -> L_")
            try self.put(it.name)
            try self.put("*:")
            try self.end()
            try self.begin("    let o = (")
            try self.put(name)
            try self.put("*)heap.allocate(&")
            try self.put(name)
            try self.put("__info)")
            try self.end()
            try self.begin("    o.table = &")
            try self.put(name)
            try self.put("__table")
            try self.end()
            try self.line("    o.value = v")
            try self.begin("    return (L_")
            try self.put(it.name)
            try self.put("*)o")
            try self.end()
            try self.line("")

    # -- workers (§14) ---------------------------------------------------------------------

    ## The type a task's result is kept as: the success type, `u8` for nothing.
    func task_payload(task_type: u32) -> u32:
        var r = self.checker.table.get(task_type).elem
        if self.checker.table.kind(r) == types.Kind.fallible:
            r = self.checker.table.get(r).elem
        return types.bool_id if r == types.unit_id else r

    mutating func spawn_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.spawns.count
        while i < self.spawns.count:
            if self.spawns.get(i) == e:
                at = i
            i += 1
        if at == self.spawns.count:
            try self.spawns.push(e)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_task_{at}__spawn"))

    mutating func wait_name(task_type: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.waits.count:
            if self.waits.get(i) == task_type:
                seen = true
            i += 1
        if not seen:
            try self.waits.push(task_type)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_wait_{task_type}"))

    ## `L_send_N(v)` for a type whose values are copied to share nothing, or `v` itself for
    ## a scalar, which is its own copy.
    mutating func send_of(t: u32, v: str) -> !:
        let k = self.checker.table.kind(t)
        if k == types.Kind.int_ or k == types.Kind.float_ or k == types.Kind.bool_ or k == types.Kind.unit_ or k == types.Kind.error_code or k == types.Kind.range_:
            try self.put(v)
            return
        var i: usize = 0
        var seen = false
        while i < self.sends.count:
            if self.sends.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.sends.push(t)
        try self.put("L_send_")
        try self.put_u64((u64)t)
        try self.put("(")
        try self.put(v)
        try self.put(")")

    mutating func worker_support() -> !:
        while self.spawns_done < self.spawns.count:
            let e = self.spawns.get(self.spawns_done)
            let index = self.spawns_done
            self.spawns_done += 1
            try self.task_object(e, index)
        while self.waits_done < self.waits.count:
            let t = self.waits.get(self.waits_done)
            self.waits_done += 1
            try self.wait_function(t)
        while self.sends_done < self.sends.count:
            let t = self.sends.get(self.sends_done)
            self.sends_done += 1
            try self.send_function(t)

    ## One spawn's task: the object holding the spawner's arguments, then the worker's own
    ## copies and the result; `run` on the worker, `cleanup` on the worker once the result
    ## was taken, `spawn` on the spawner (RUNTIME).
    mutating func task_object(e: ast.Node*, index: usize) -> !:
        let call = e.left else return
        let d = call.resolved else return try self.fail(e, "an unresolved spawn")
        let ft = self.checker.table.get(d.type_id)
        let fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        let payload = self.task_payload(e.type_id)
        let has_result = payload != types.bool_id or (ft.elem != types.unit_id and not (fallible and self.checker.table.get(ft.elem).elem == types.unit_id))
        let half = self.checker.scratch.length // 2
        let name = try copy_name(try format(self.checker.scratch[half..], f"L_task_{index}"))
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.begin("    var base: kernel.TaskOf[")
        try self.type_of(payload)
        try self.put("]")
        try self.end()
        var cursor = d.right
        while let p = cursor:
            try self.begin("    var L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            try self.end()
            try self.begin("    var W_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            try self.end()
            cursor = p.next
        try self.line("")
        # run: on the worker
        try self.begin("func ")
        try self.put(name)
        try self.put("__run(t: kernel.Task*):")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)t")
        try self.end()
        cursor = d.right
        while let p = cursor:
            try self.begin("    o.W_")
            try self.put(p.text)
            try self.put(" = ")
            let source = try copy_name(try format(self.checker.scratch[half..], f"o.L_{p.text}"))
            try self.send_of(p.type_id, source)
            try self.end()
            cursor = p.next
        try self.line("    kernel.task_copied(t)")
        try self.begin("    ")
        if has_result:
            try self.put("o.base.result = ")
        try self.put("L_")
        try self.put(try self.decl_name(d))
        try self.put("(")
        var first = true
        cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("o.W_")
            try self.put(p.text)
            cursor = p.next
        try self.put(")")
        if fallible:
            try self.put(" catch failure:")
            try self.end()
            try self.line("        kernel.task_failed(t, failure.code, failure.message)")
            try self.line("        return")
        else:
            try self.end()
        try self.line("")
        # cleanup: on the worker, after the waiter took the result
        try self.begin("func ")
        try self.put(name)
        try self.put("__cleanup(t: kernel.Task*):")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)t")
        try self.end()
        var any = false
        cursor = d.right
        while let p = cursor:
            if self.checker.table.has_references(p.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", p.type_id))
                try self.put("(o.W_")
                try self.put(p.text)
                try self.put(")")
                try self.end()
                any = true
            cursor = p.next
        if has_result and self.checker.table.has_references(payload):
            try self.line("    if not t.failed:")
            try self.begin("        ")
            try self.put(try self.lifetime_name("L_drop_", payload))
            try self.put("(o.base.result)")
            try self.end()
            any = true
        if not any:
            try self.line("    discard(o)")
        try self.line("")
        # drop and trace: the spawner lets the task go
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(obj: heap.Object*):")
        try self.end()
        try self.line("    kernel.task_abandon((kernel.Task*)obj)")
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(obj: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.line("    discard(obj)")
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"task\", size = sizeof(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        # spawn: on the spawner
        try self.begin("func ")
        try self.put(name)
        try self.put("__spawn(")
        first = true
        cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(") -> kernel.TaskOf[")
        try self.type_of(payload)
        try self.put("]*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        cursor = d.right
        while let p = cursor:
            try self.begin("    o.L_")
            try self.put(p.text)
            try self.put(" = L_")
            try self.put(p.text)
            try self.end()
            cursor = p.next
        try self.begin("    kernel.task_start(&o.base.task, ")
        try self.put(name)
        try self.put("__run, ")
        try self.put(name)
        try self.put("__cleanup)")
        try self.end()
        cursor = d.right
        while let p = cursor:
            if self.checker.table.has_references(p.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", p.type_id))
                try self.put("(o.L_")
                try self.put(p.text)
                try self.put(")")
                try self.end()
            cursor = p.next
        try self.line("    return &o.base")
        try self.line("")

    ## `wait` for one task type: the result copied onto the waiter's heap, or the failure.
    mutating func wait_function(task_type: u32) -> !:
        let elem = self.checker.table.get(task_type).elem
        let fallible = self.checker.table.kind(elem) == types.Kind.fallible
        let payload = self.task_payload(task_type)
        var success = elem
        if fallible:
            success = self.checker.table.get(elem).elem
        try self.begin("func L_wait_")
        try self.put_u64((u64)task_type)
        try self.put("(t: ")
        try self.type_of(task_type)
        try self.put(")")
        try self.result_type(elem)
        try self.put(":")
        try self.end()
        try self.line("    kernel.task_join(&t.task)")
        if fallible:
            try self.line("    if t.task.failed:")
            try self.line("        let code = t.task.code")
            try self.line("        let message = t.task.message")
            try self.line("        kernel.task_finish(&t.task)")
            try self.line("        error(code, message)")
        if success != types.unit_id:
            try self.begin("    let answer = ")
            try self.send_of(payload, "t.result")
            try self.end()
        try self.line("    kernel.task_finish(&t.task)")
        if success != types.unit_id:
            try self.line("    return answer")
        try self.line("")

    ## A copy of a value that shares nothing with the original (§14): a text and bytes
    ## anew, a collection with its elements sent, a struct, enum, tuple or optional
    ## member by member.
    mutating func send_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func L_send_")
        try self.put_u64((u64)id)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> ")
        try self.type_of(id)
        try self.put(":")
        try self.end()
        self.indent += 1
        let half = self.checker.scratch.length // 2
        match t.kind:
            .str_: try self.line("return kernel.text_of(kernel.text_view(v))")
            .bytes_: try self.line("return kernel.bytes_of(kernel.bytes_view(v))")
            .list_:
                try self.begin("let out = kernel.list_new[")
                try self.type_of(t.elem)
                try self.put("](&")
                try self.put(try self.lifetime_name("L_info_", id))
                try self.put(", ")
                try self.put(try self.ops_name(t.elem))
                try self.put(")")
                try self.end()
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.list_append[")
                try self.type_of(t.elem)
                try self.put("](out, ")
                try self.send_of(t.elem, "v.items[i]")
                try self.put(")")
                try self.end()
                try self.line("    i += 1")
                try self.line("return out")
            .set_:
                try self.begin("let out = kernel.set_new[")
                try self.type_of(t.elem)
                try self.put("](&")
                try self.put(try self.lifetime_name("L_info_", id))
                try self.put(", ")
                try self.put(try self.ops_name(t.elem))
                try self.put(")")
                try self.end()
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.set_insert[")
                try self.type_of(t.elem)
                try self.put("](out, ")
                try self.send_of(t.elem, "v.keys[i]")
                try self.put(")")
                try self.end()
                try self.line("    i += 1")
                try self.line("return out")
            .map_:
                let value_type = self.checker.table.map_value(id)
                try self.begin("let out = kernel.map_new[")
                try self.type_of(t.elem)
                try self.put(", ")
                try self.type_of(value_type)
                try self.put("](&")
                try self.put(try self.lifetime_name("L_info_", id))
                try self.put(", ")
                try self.put(try self.ops_name(t.elem))
                try self.put(", ")
                try self.put(try self.ops_name(value_type))
                try self.put(")")
                try self.end()
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.map_set[")
                try self.type_of(t.elem)
                try self.put(", ")
                try self.type_of(value_type)
                try self.put("](out, ")
                try self.send_of(t.elem, "v.keys[i]")
                try self.put(", ")
                try self.send_of(value_type, "v.values[i]")
                try self.put(")")
                try self.end()
                try self.line("    i += 1")
                try self.line("return out")
            .optional:
                try self.line("if let x = v:")
                try self.begin("    return ")
                try self.send_of(t.elem, "x")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    let member = try copy_name(try format(self.checker.scratch[half..], f"v.{i}"))
                    try self.send_of(t.args[i], member)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_:
                let d = t.decl else return try self.fail(self.checker.tree(), "a struct without a declaration")
                try self.begin("return L_")
                try self.put(t.name)
                try self.put("(")
                var first = true
                var cursor = d.body
                while let f = cursor:
                    if f.kind == ast.Kind.field:
                        if not first:
                            try self.put(", ")
                        first = false
                        let member = try copy_name(try format(self.checker.scratch[half..], f"v.L_{f.text}"))
                        try self.send_of(f.type_id, member)
                    cursor = f.next
                try self.put(")")
                try self.end()
            .enum_:
                let d = t.decl else return try self.fail(self.checker.tree(), "an enum without a declaration")
                try self.line("match v:")
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin("    .L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(": return L_")
                        try self.put(t.name)
                        try self.put(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                let member = try copy_name(try format(self.checker.scratch[half..], f"L_{field.text}"))
                                try self.send_of(field.type_id, member)
                                p = field.next
                            try self.put(")")
                        try self.end()
                    cursor = m.next
            _: return try self.fail(self.checker.tree(), "a value that is not sendable reached a worker")
        self.indent -= 1
        try self.line("")

    # -- the Base boundary (§16) -----------------------------------------------------------

    ## The Base module a declaration read from a description belongs to, by its dotted name.
    func base_module(d: ast.Node*) -> str:
        return self.checker.modules.get((usize)d.module).name

    ## A Base function's shim: a function under the Luce name over Luce types, which lends
    ## or converts every argument as §16.2 says, calls the Base function, and copies or
    ## wraps what it answers. A failure crosses as it is.
    mutating func shim(d: ast.Node*) -> !:
        let ft = self.checker.table.get(d.type_id)
        self.fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(try self.decl_name(d))
        try self.put("(")
        var first = true
        var cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(p.text)
            try self.put(": ")
            let t = p.ty else return try self.fail(d, "a Base parameter without a type")
            if t.has(ast.flag_func_type):
                try self.base_type(t, d)
            else:
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        var pools = false
        cursor = d.right
        while let p = cursor:
            let t = p.ty else break
            if t.text == "list" and (t.body else break).text == "str":
                pools = true
            cursor = p.next
        if pools:
            try self.line("let mark = heap.mark()")
            if self.fallible:
                try self.line("errdefer heap.drain(mark)")
        var result = ft.elem
        if self.checker.table.kind(result) == types.Kind.fallible:
            result = self.checker.table.get(result).elem
        try self.begin("")
        if result != types.unit_id:
            try self.put("let answer = ")
        if self.fallible:
            try self.put("try ")
        try self.put(self.base_module(d))
        try self.put(".")
        try self.put(d.text)
        try self.put("(")
        first = true
        cursor = d.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            let t = p.ty else break
            let half = self.checker.scratch.length // 2
            let name = try copy_name(try format(self.checker.scratch[half..], f"L_{p.text}"))
            try self.to_base(t, name, d)
            cursor = p.next
        try self.put(")")
        try self.end()
        if pools:
            try self.line("heap.drain(mark)")
        if result != types.unit_id:
            let r = d.left else return try self.fail(d, "a Base result without a type")
            var inner = r
            if r.has(ast.flag_fallible):
                inner = r.left else return try self.fail(d, "a result without a type")
            try self.begin("return ")
            try self.from_base(inner, "answer", d)
            try self.end()
        self.indent -= 1
        try self.line("")

    ## The arguments of a call into Base: a function-typed parameter gets the thunk of the
    ## named function given (§16.2), every other its value as any call would pass it.
    mutating func base_arguments(e: ast.Node*, d: ast.Node*) -> !:
        try self.put("(")
        var first = true
        var a = e.body
        while let arg = a:
            if not first:
                try self.put(", ")
            first = false
            let p = arg.resolved else return try self.fail(arg, "an argument without its parameter")
            let v = arg.left else return try self.fail(arg, "empty argument")
            if self.checker.table.kind(p.type_id) == types.Kind.func_:
                let f = v.resolved else return try self.fail(v, "a callback that is not a named function")
                try self.put(try self.callback_name(f))
            else:
                try self.use(v)
            a = arg.next
        try self.put(")")

    ## A Base constant read: its value converted where it is read; a text copied into a
    ## text of the program's own.
    mutating func base_constant(d: ast.Node*) -> !:
        let t = d.ty else return try self.fail(d, "a Base constant without a type")
        let half = self.checker.scratch.length // 2
        let spelled = try copy_name(try format(self.checker.scratch[half..], f"{self.base_module(d)}.{d.text}"))
        try self.from_base(t, spelled, d)

    ## The Base spelling of a type read from a description, `mod.Name` for the module's own.
    mutating func base_type(t: ast.Node*, owner: ast.Node*) -> !:
        if t.has(ast.flag_fallible):
            let inner = t.left else return
            if not inner.has(ast.flag_tuple_type):
                try self.base_type(inner, owner)
            try self.put("!")
            return
        if t.has(ast.flag_optional):
            let inner = t.left else return
            try self.base_type(inner, owner)
            try self.put("?")
            return
        if t.has(ast.flag_func_type):
            try self.put("func(")
            var first = true
            var cursor = t.body
            while let a = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.base_type(a, owner)
                cursor = a.next
            try self.put(")")
            if let r = t.right:
                try self.put(" -> ")
                try self.base_type(r, owner)
            else:
                try self.put(" -> unit")
            return
        if t.text == "int":
            try self.put("usize" if t.has(ast.flag_usize) else "i64")
        elif t.text == "float":
            try self.put("f64")
        elif t.text == "bool":
            try self.put("bool")
        elif t.text == "str":
            try self.put("str")
        elif t.text == "bytes":
            try self.put("const u8[]")
        elif t.text == "list":
            try self.put("const ")
            let e = t.body else return
            try self.base_type(e, owner)
            try self.put("[]")
        else:
            try self.put(self.base_module(owner))
            try self.put(".")
            try self.put(t.text)

    ## A Luce value named `v` as Base takes it (§16.2): lent, converted, or unwrapped.
    mutating func to_base(t: ast.Node*, v: str, owner: ast.Node*) -> !:
        if t.has(ast.flag_optional) or t.has(ast.flag_func_type):
            if t.has(ast.flag_func_type):
                try self.put(v)
                return
            try self.put(try self.crossing_name(t, "L_tobase_", owner))
            try self.put("(")
            try self.put(v)
            try self.put(")")
            return
        if t.text == "int":
            if t.has(ast.flag_usize):
                try self.put("kernel.usize_of_int(")
                try self.put(v)
                try self.put(")")
            else:
                try self.put(v)
        elif t.text == "float" or t.text == "bool":
            try self.put(v)
        elif t.text == "str":
            try self.put("kernel.text_view(")
            try self.put(v)
            try self.put(")")
        elif t.text == "bytes":
            try self.put("kernel.bytes_view(")
            try self.put(v)
            try self.put(")")
        elif t.text == "list":
            let e = t.body else return
            if e.text == "str":
                try self.put("kernel.str_views(")
            else:
                try self.put("kernel.list_span[")
                try self.type_of(e.type_id)
                try self.put("](")
            try self.put(v)
            try self.put(")")
        else:
            let kind = self.checker.table.kind(t.type_id)
            if kind == types.Kind.class_:
                try self.put("L_")
                try self.put(self.checker.table.get(t.type_id).name)
                try self.put("__value(")
                try self.put(v)
                try self.put(")")
            else:
                try self.put(try self.crossing_name(t, "L_tobase_", owner))
                try self.put("(")
                try self.put(v)
                try self.put(")")

    ## A Base value named `v` as Luce keeps it: copied, converted, or wrapped.
    mutating func from_base(t: ast.Node*, v: str, owner: ast.Node*) -> !:
        if t.has(ast.flag_optional):
            try self.put(try self.crossing_name(t, "L_frombase_", owner))
            try self.put("(")
            try self.put(v)
            try self.put(")")
            return
        if t.text == "int":
            if t.has(ast.flag_usize):
                try self.put("kernel.int_of_usize(")
                try self.put(v)
                try self.put(")")
            else:
                try self.put(v)
        elif t.text == "float" or t.text == "bool":
            try self.put(v)
        elif t.text == "str":
            try self.put("kernel.text_of(")
            try self.put(v)
            try self.put(")")
        elif t.text == "bytes":
            try self.put("kernel.bytes_of(")
            try self.put(v)
            try self.put(")")
        else:
            let kind = self.checker.table.kind(t.type_id)
            if kind == types.Kind.class_:
                try self.put("L_")
                try self.put(self.checker.table.get(t.type_id).name)
                try self.put("__wrap(")
                try self.put(v)
                try self.put(")")
            else:
                try self.put(try self.crossing_name(t, "L_frombase_", owner))
                try self.put("(")
                try self.put(v)
                try self.put(")")

    ## `L_tobase_N` or `L_frombase_N` for a type node, registered for the support pass.
    mutating func crossing_name(t: ast.Node*, prefix: str, owner: ast.Node*) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.crossings.count:
            if self.crossings.get(i).type_id == t.type_id:
                seen = true
            i += 1
        if not seen:
            try self.crossings.push(t)
            try self.crossing_owners.push(owner)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"{prefix}{t.type_id}"))

    ## `L_callback_N`: the thunk over Base's types that calls a named Luce function.
    mutating func callback_name(f: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.callbacks.count
        while i < self.callbacks.count:
            if self.callbacks.get(i) == f:
                at = i
            i += 1
        if at == self.callbacks.count:
            try self.callbacks.push(f)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_callback_{at}"))

    ## The pair of functions for every crossing type, and the thunk for every callback.
    mutating func boundary_support() -> !:
        while self.crossings_done < self.crossings.count:
            let t = self.crossings.get(self.crossings_done)
            let owner = self.crossing_owners.get(self.crossings_done)
            self.crossings_done += 1
            try self.crossing_functions(t, owner)
        while self.callbacks_done < self.callbacks.count:
            let f = self.callbacks.get(self.callbacks_done)
            self.callbacks_done += 1
            try self.callback_thunk(f, self.callbacks_done - 1)

    mutating func crossing_functions(t: ast.Node*, owner: ast.Node*) -> !:
        # the module's own struct or enum being converted, or the owner for an optional of
        # anything, which only needs the module's name
        var module_decl = owner
        if not t.has(ast.flag_optional):
            module_decl = self.checker.table.get(t.type_id).decl else return try self.fail(t, "a crossing type without a declaration")
        let half = self.checker.scratch.length // 2
        let toward = try copy_name(try format(self.checker.scratch[half..], f"L_tobase_{t.type_id}"))
        let back = try copy_name(try format(self.checker.scratch[half..], f"L_frombase_{t.type_id}"))
        # to Base
        try self.begin("func ")
        try self.put(toward)
        try self.put("(v: ")
        try self.type_of(t.type_id)
        try self.put(") -> ")
        try self.base_type(t, module_decl)
        try self.put(":")
        try self.end()
        self.indent += 1
        if t.has(ast.flag_optional):
            let inner = t.left else return
            try self.line("if let x = v:")
            try self.begin("    return ")
            try self.to_base(inner, "x", module_decl)
            try self.end()
            try self.line("return none")
        elif module_decl.kind == ast.Kind.struct_:
            try self.begin("return ")
            try self.put(self.base_module(module_decl))
            try self.put(".")
            try self.put(module_decl.text)
            try self.put("(")
            var first = true
            var cursor = module_decl.body
            while let f = cursor:
                if f.kind == ast.Kind.field:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put(f.text)
                    try self.put(" = ")
                    let ft = f.ty else return
                    let field = try copy_name(try format(self.checker.scratch[half..], f"v.L_{f.text}"))
                    try self.to_base(ft, field, module_decl)
                cursor = f.next
            try self.put(")")
            try self.end()
        else:
            try self.line("match v:")
            var cursor = module_decl.body
            while let c = cursor:
                if c.kind == ast.Kind.enum_case:
                    try self.begin("    .L_")
                    try self.put(c.text)
                    try self.put(": return ")
                    try self.put(self.base_module(module_decl))
                    try self.put(".")
                    try self.put(module_decl.text)
                    try self.put(".")
                    try self.put(c.text)
                    try self.end()
                cursor = c.next
        self.indent -= 1
        try self.line("")
        # from Base
        try self.begin("func ")
        try self.put(back)
        try self.put("(v: ")
        try self.base_type(t, module_decl)
        try self.put(") -> ")
        try self.type_of(t.type_id)
        try self.put(":")
        try self.end()
        self.indent += 1
        if t.has(ast.flag_optional):
            let inner = t.left else return
            try self.line("if let x = v:")
            try self.begin("    return ")
            try self.from_base(inner, "x", module_decl)
            try self.end()
            try self.line("return none")
        elif module_decl.kind == ast.Kind.struct_:
            try self.begin("return L_")
            try self.put(self.checker.table.get(module_decl.type_id).name)
            try self.put("(")
            var first = true
            var cursor = module_decl.body
            while let f = cursor:
                if f.kind == ast.Kind.field:
                    if not first:
                        try self.put(", ")
                    first = false
                    let ft = f.ty else return
                    let field = try copy_name(try format(self.checker.scratch[half..], f"v.{f.text}"))
                    try self.from_base(ft, field, module_decl)
                cursor = f.next
            try self.put(")")
            try self.end()
        else:
            try self.line("match v:")
            var cursor = module_decl.body
            while let c = cursor:
                if c.kind == ast.Kind.enum_case:
                    try self.begin("    .")
                    try self.put(c.text)
                    try self.put(": return L_")
                    try self.put(self.checker.table.get(module_decl.type_id).name)
                    try self.put(".L_")
                    try self.put(c.text)
                    try self.end()
                cursor = c.next
            # an integer-backed enum from Base may hold a combination no case names
            try self.line("    _: trap(\"a Base enum value that is no declared case crossed into Luce\")")
        self.indent -= 1
        try self.line("")

    ## A callback's thunk: Base's arguments made into Luce values for the call, released
    ## after it; the answer a scalar (the description admits no other).
    mutating func callback_thunk(f: ast.Node*, index: usize) -> !:
        let ft = self.checker.table.get(f.type_id)
        try self.begin("func L_callback_")
        try self.put_u64((u64)index)
        try self.put("(")
        var first = true
        var i: usize = 0
        var cursor = f.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("a")
            try self.put_u64((u64)i)
            try self.put(": ")
            try self.base_luce_type(p.type_id)
            i += 1
            cursor = p.next
        try self.put(")")
        if ft.elem != types.unit_id:
            try self.put(" -> ")
            try self.base_luce_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("let mark = heap.mark()")
        try self.begin("")
        if ft.elem != types.unit_id:
            try self.put("let answer = ")
        try self.put("L_")
        try self.put(try self.decl_name(f))
        try self.put("(")
        first = true
        i = 0
        cursor = f.right
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            let half = self.checker.scratch.length // 2
            let name = try copy_name(try format(self.checker.scratch[half..], f"a{i}"))
            try self.luce_from_base_value(p.type_id, name)
            i += 1
            cursor = p.next
        try self.put(")")
        try self.end()
        try self.line("heap.drain(mark)")
        if ft.elem != types.unit_id:
            try self.line("return answer")
        self.indent -= 1
        try self.line("")

    ## The Base spelling of a Luce type at a callback's edge: scalars, texts and bytes.
    mutating func base_luce_type(id: u32) -> !:
        match self.checker.table.kind(id):
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("str")
            .bytes_: try self.put("const u8[]")
            _: return try self.fail(self.checker.tree(), "a callback parameter Base cannot pass")

    ## A Base argument as a Luce value for a callback, a temporary of the call for texts.
    mutating func luce_from_base_value(id: u32, v: str) -> !:
        match self.checker.table.kind(id):
            .str_:
                try self.put(try self.lifetime_name("L_pool_", id))
                try self.put("(kernel.text_of(")
                try self.put(v)
                try self.put("))")
            .bytes_:
                try self.put(try self.lifetime_name("L_pool_", id))
                try self.put("(kernel.bytes_of(")
                try self.put(v)
                try self.put("))")
            _: try self.put(v)

    ## A handle (§16.4): a class holding the Base value, closed once by `close()` or when
    ## its last reference goes; a closed handle handed to Base traps.
    mutating func handle_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        let destroy = d.left else return try self.fail(d, "a handle without its destroy function")
        let module_name = self.base_module(d)
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.begin("    var value: ")
        try self.put(module_name)
        try self.put(".")
        try self.put(d.text)
        try self.end()
        try self.line("    var closed: bool")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__L_close(L_self: L_")
        try self.put(name)
        try self.put("*):")
        try self.end()
        try self.line("    if not L_self.closed:")
        try self.line("        L_self.closed = true")
        try self.begin("        ")
        try self.put(module_name)
        try self.put(".")
        try self.put(destroy.text)
        try self.put("(L_self.value)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    L_")
        try self.put(name)
        try self.put("__L_close((L_")
        try self.put(name)
        try self.put("*)o)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.line("    discard(o)")
        try self.line("")
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(d.text)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = none, drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__wrap(v: ")
        try self.put(module_name)
        try self.put(".")
        try self.put(d.text)
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*:")
        try self.end()
        try self.begin("    let o = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.line("    o.value = v")
        try self.line("    o.closed = false")
        try self.line("    return o")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__value(h: L_")
        try self.put(name)
        try self.put("*) -> ")
        try self.put(module_name)
        try self.put(".")
        try self.put(d.text)
        try self.put(":")
        try self.end()
        try self.line("    if h.closed:")
        try self.line("        trap(\"a closed handle was handed to Base\")")
        try self.line("    return h.value")
        try self.line("")

    ## A class: a Base struct with the runtime's header first, its methods as free functions
    ## over a pointer, the descriptor the runtime destroys and traces it by, and `new`.
    mutating func class_decl(d: ast.Node*) -> !:
        let name = self.type_name(d)
        try self.begin("struct L_")
        try self.put(name)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.line("var header: heap.Object")
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try self.begin("pub var L_")
                try self.put(m.text)
                try self.put(": ")
                try self.type_of(m.type_id)
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        cursor = d.body
        var init: ast.Node*? = none
        var has_deinit = false
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, name)
                if m.text == "init":
                    init = m
                if m.text == "deinit":
                    has_deinit = true
            cursor = m.next
        if has_deinit:
            try self.begin("func L_")
            try self.put(name)
            try self.put("__finish(o: heap.Object*):")
            try self.end()
            try self.begin("    L_")
            try self.put(name)
            try self.put("__L_deinit((L_")
            try self.put(name)
            try self.put("*)o)")
            try self.end()
            try self.line("")
        # the fields go last first; one never assigned (an `init` that failed) is zero and
        # every drop below tolerates that
        try self.begin("func L_")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        var fields = try list.List[ast.Node*].create(8)
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field:
                try fields.push(m)
            cursor = m.next
        var i = fields.count
        var any = false
        while i > 0:
            i -= 1
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(")")
                try self.end()
                any = true
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("func L_")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_self = (L_")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        any = false
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if self.checker.table.has_references(f.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", f.type_id))
                try self.put("(L_self.L_")
                try self.put(f.text)
                try self.put(", visit, context)")
                try self.end()
                any = true
            i += 1
        if not any:
            try self.line("    discard(L_self)")
        try self.line("")
        try self.begin("var L_")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"")
        try self.put(name)
        try self.put("\", size = sizeof(L_")
        try self.put(name)
        try self.put("), finish = ")
        if has_deinit:
            try self.put("L_")
            try self.put(name)
            try self.put("__finish")
        else:
            try self.put("none")
        try self.put(", drop = L_")
        try self.put(name)
        try self.put("__drop, trace = L_")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.line("")
        # construction: the block, the defaults, then `init`; a failing `init` abandons it
        var fallible = false
        if let f = init:
            let result = self.checker.table.get(f.type_id).elem
            fallible = self.checker.table.kind(result) == types.Kind.fallible
        try self.begin("func L_")
        try self.put(name)
        try self.put("__new(")
        if let f = init:
            var first = true
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(param.text)
                    try self.put(": ")
                    try self.type_of(param.type_id)
                pc = param.next
        try self.put(") -> L_")
        try self.put(name)
        try self.put("*!:" if fallible else "*:")
        try self.end()
        self.indent += 1
        self.fallible = fallible
        try self.begin("let L_self = (L_")
        try self.put(name)
        try self.put("*)heap.allocate(&L_")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        i = 0
        while i < fields.count:
            let f = fields.get(i)
            if let default = f.left:
                try self.begin("L_self.L_")
                try self.put(f.text)
                try self.put(" = ")
                try self.owned(default)
                try self.end()
            i += 1
        if let f = init:
            try self.begin("")
            try self.put("L_")
            try self.put(name)
            try self.put("__L_init(L_self")
            var pc = f.right
            while let param = pc:
                if param.text != "self":
                    try self.put(", L_")
                    try self.put(param.text)
                pc = param.next
            try self.put(")")
            if fallible:
                try self.put(" catch failure:")
                try self.end()
                try self.line("    heap.abandon((heap.Object*)L_self)")
                try self.line("    error(failure.code, failure.message)")
            else:
                try self.end()
        try self.line("return L_self")
        self.indent -= 1
        try self.line("")

    mutating func enum_decl(d: ast.Node*) -> !:
        try self.begin("enum L_")
        try self.put(self.type_name(d))
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.enum_case:
                try self.begin("L_")
                try self.put(m.text)
                if m.body != none:
                    try self.put("(")
                    var p = m.body
                    var first = true
                    while let field = p:
                        if not first:
                            try self.put(", ")
                        first = false
                        try self.put("L_")
                        try self.put(field.text)
                        try self.put(": ")
                        try self.type_of(field.type_id)
                        p = field.next
                    try self.put(")")
                try self.end()
            cursor = m.next
        self.indent -= 1
        try self.line("")
        # an enum's methods are free functions over it, `self` an ordinary parameter
        cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_:
                try self.function(m, self.type_name(d))
            cursor = m.next

    ## `owner` is "" for a free function, "method" for a struct's, an enum's name for its.
    mutating func function(f: ast.Node*, owner: str) -> !:
        let t = self.checker.table.get(f.type_id)
        self.fallible = self.checker.table.kind(t.elem) == types.Kind.fallible
        var prefix = "func L_"
        if owner == "method":
            if not check.has_self(f):
                prefix = "static func L_"
            elif f.has(check.flag_mutating):
                prefix = "mutating func L_"
        try self.begin(prefix)
        if owner != "" and owner != "method":
            try self.put(owner)
            try self.put("__L_")
            try self.put(f.text)
        elif owner == "":
            try self.put(try self.decl_name(f))
        else:
            try self.put(f.text)
        try self.put("(")
        var first = true
        var cursor = f.right
        self.self_name = "self"
        while let p = cursor:
            if p.text == "self":
                if owner != "method":
                    try self.put("L_self: L_")
                    try self.put(owner)
                    if self.checker.table.kind(p.type_id) == types.Kind.class_:
                        try self.put("*")
                    first = false
                    self.self_name = "L_self"
            else:
                if not first:
                    try self.put(", ")
                first = false
                try self.put("L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        if t.elem != types.unit_id:
            try self.put(" -> ")
            try self.type_of(t.elem)
        elif self.checker.table.kind(t.elem) == types.Kind.fallible:
            try self.put(" -> !")
        try self.put(":")
        try self.end()
        let body = f.body else return
        self.indent += 1
        try self.site_prologue()
        try self.block(body)
        self.indent -= 1
        try self.line("#:")
        try self.line("")
        self.self_name = "self"

    # -- types ----------------------------------------------------------------------------

    pub mutating func type_of(id: u32) -> !:
        let t = self.checker.table.get(id)
        match t.kind:
            .int_: try self.put("i64")
            .float_: try self.put("f64")
            .bool_: try self.put("bool")
            .str_: try self.put("kernel.Text*")
            .bytes_: try self.put("kernel.Bytes*")
            .unit_: try self.put("unit")
            .never_: try self.put("never")
            .error_code: try self.put("ErrorCode")
            .error_value: try self.put("Error")
            .range_: try self.put("kernel.Range")
            .optional:
                try self.type_of(t.elem)
                try self.put("?")
            .fallible:
                if t.elem == types.unit_id:
                    try self.put("!")
                else:
                    try self.type_of(t.elem)
                    try self.put("!")
            .tuple:
                try self.put("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.type_of(t.args[i])
                    i += 1
                try self.put(")")
            .func_:
                try self.put("kernel.Closure*")
            .list_:
                try self.put("kernel.List[")
                try self.type_of(t.elem)
                try self.put("]*")
            .map_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", ")
                try self.type_of(self.checker.table.map_value(id))
                try self.put("]*")
            .set_:
                try self.put("kernel.Map[")
                try self.type_of(t.elem)
                try self.put(", u8]*")
            .struct_, .enum_:
                try self.put("L_")
                try self.put(t.name)
            .class_, .interface_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("*")
            .weak_:
                try self.put("heap.Weak")
            .task_:
                try self.put("kernel.TaskOf[")
                try self.type_of(self.task_payload(id))
                try self.put("]*")
            _:
                error(unsupported, "a type this slice does not compile")

    # -- statements -----------------------------------------------------------------------

    mutating func block(b: ast.Node*) -> !:
        if b.body == none:
            try self.line("discard(0)")
            return
        var cursor = b.body
        while let s = cursor:
            try self.statement(s)
            cursor = s.next

    ## One statement; whatever it pooled is drained when it ends (RUNTIME 5).
    ## `#: file:line:column` names what the statement's lines were compiled from (base.md
    ## §3.3), and `heap.site` the same for the kernel's own traps (§12.4).
    mutating func position_lines(s: ast.Node*) -> !:
        let module = self.checker.modules.get((usize)s.module)
        let (line, column) = module.src.position(ast.statement_start(s))
        let room = try alloc u8[module.path.length + 24]
        let where = try format(room, f"{module.path}:{line}:{column}")
        try self.begin("#: ")
        try self.put(where)
        try self.end()
        try self.begin("heap.site = ")
        try self.text_literal(where, false)
        try self.end()

    ## A function's statements name their own positions; the caller's is back on return,
    ## and the lines after the body are the program's own again.
    mutating func site_prologue() -> !:
        let saved = try self.temp("site")
        try self.begin("let ")
        try self.put(saved)
        try self.put(" = heap.site")
        try self.end()
        try self.begin("defer heap.restore_site(")
        try self.put(saved)
        try self.put(")")
        try self.end()

    mutating func statement(s: ast.Node*) -> !:
        try self.position_lines(s)
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        match s.kind:
            .let_, .var_: try self.binding(s)
            .assign: try self.assign(s)
            .if_: try self.if_statement(s)
            .while_: try self.while_statement(s)
            .for_: try self.for_statement(s)
            .match_: try self.match_statement(s)
            .with_: try self.with_statement(s)
            .return_: try self.return_statement(s)
            .break_, .continue_:
                try self.begin("break" if s.kind == ast.Kind.break_ else "continue")
                if s.text.length > 0:
                    try self.put(" ")
                    try self.put(s.text)
                try self.end()
            .recover_:
                let v = s.left else return
                try self.begin("recover ")
                try self.owned(v)
                try self.end()
            .expr_stmt:
                let e = s.left else return
                try self.begin("")
                if e.type_id != types.unit_id and e.type_id != types.never_id:
                    try self.put("discard(")
                    try self.use(e)
                    try self.put(")")
                else:
                    try self.use(e)
                try self.end()
            _: return try self.fail(s, "a statement this slice does not compile")
        try self.drained_unless(start, pooled_before, self.exits(s))

    ## `defer` the drop of a binding that owns references, right after it.
    mutating func drop_at_exit(name: str, t: u32) -> !:
        if not self.checker.table.has_references(t):
            return
        try self.begin("defer ")
        try self.put(try self.lifetime_name("L_drop_", t))
        try self.put("(L_")
        try self.put(name)
        try self.put(")")
        try self.end()

    ## `return e`: the value is owned by the caller; the statement's temporaries die after
    ## it is computed and before the function's bindings (RUNTIME 5).
    mutating func return_statement(s: ast.Node*) -> !:
        let v = s.left else return try self.line("return")
        let start = self.out.used
        try self.owned(v)
        let text = try self.capture(start)
        if self.pooled:
            let r = try self.temp("result")
            try self.begin("let ")
            try self.put(r)
            try self.put(" = ")
            try self.put(text)
            try self.end()
            try self.drained(start, true)
            self.pooled = false
            try self.begin("return ")
            try self.put(r)
            try self.end()
            return
        try self.begin("return ")
        try self.put(text)
        try self.end()

    mutating func binding(s: ast.Node*) -> !:
        let init = s.left else return
        let word = "let " if s.kind == ast.Kind.let_ else "var "
        try self.begin(word)
        if s.body != none:
            try self.put("(")
            var cursor = s.body
            var first = true
            while let part = cursor:
                if not first:
                    try self.put(", ")
                first = false
                if part.has(ast.flag_wildcard):
                    try self.put("_")
                else:
                    try self.put("L_")
                    try self.put(part.text)
                cursor = part.next
            try self.put(")")
        elif s.has(ast.flag_captured):
            # a `var` some closure captures: one cell shared with the closures (§7.4)
            try self.put("L_")
            try self.put(s.text)
            try self.put(" = kernel.cell_new[")
            try self.type_of(s.type_id)
            try self.put("](&")
            try self.put(try self.cell_info_name(s.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(s.type_id))
            try self.put(", ")
            try self.owned(init)
            try self.put(")")
            try self.end()
            try self.begin("defer heap.release((heap.Object*)L_")
            try self.put(s.text)
            try self.put(")")
            try self.end()
            return
        else:
            try self.put("L_")
            try self.put(s.text)
            try self.put(": ")
            try self.type_of(s.type_id)
        try self.put(" = ")
        try self.owned(init)
        try self.end()
        if s.body != none:
            var cursor = s.body
            while let part = cursor:
                if not part.has(ast.flag_wildcard):
                    try self.drop_at_exit(part.text, part.type_id)
                cursor = part.next
        else:
            try self.drop_at_exit(s.text, s.type_id)

    ## The new value is computed and stored, then the old one dropped (RUNTIME 1, 2).
    mutating func assign(s: ast.Node*) -> !:
        let place = s.left else return
        let value = s.right else return
        if place.kind == ast.Kind.tuple:
            # the places' receivers and indexes come first (§5.3), then the tuple, then the stores
            var ahead = place.body
            while let part = ahead:
                try self.place_ahead(part)
                ahead = part.next
            let t = try self.temp("tuple")
            try self.begin("let ")
            try self.put(t)
            try self.put(" = ")
            try self.owned(value)
            try self.end()
            var i: usize = 0
            var cursor = place.body
            while let part = cursor:
                let half = self.checker.scratch.length // 2
                let member = try copy_name(try format(self.checker.scratch[half..], f"{t}.{i}"))
                try self.store(part, member)
                i += 1
                cursor = part.next
            return
        if place.kind == ast.Kind.index:
            let receiver = place.left else return
            let index = place.body else return
            if self.checker.table.kind(receiver.type_id) == types.Kind.map_:
                # `m[key] = v`: an insertion or a replacement, the map's own key and value
                try self.begin("kernel.map_set[")
                try self.map_types(receiver.type_id)
                try self.put("](")
                if self.may_fail(value) or self.may_fail(index) or self.has_call(value):
                    let r = try self.hoist(receiver, false)
                    let k = try self.hoist(index, true)
                    let v = try self.hoist(value, true)
                    try self.put(r)
                    try self.put(", ")
                    try self.put(k)
                    try self.put(", ")
                    try self.put(v)
                else:
                    try self.use(receiver)
                    try self.put(", ")
                    try self.owned(index)
                    try self.put(", ")
                    try self.owned(value)
                try self.put(")")
                try self.end()
                return
            if self.checker.table.kind(receiver.type_id) == types.Kind.list_:
                # `values[i] = x`, or `values[i] op= x` as the operation then the store; the
                # place is computed once, ahead of the value (§5.3)
                if s.text != "=" and (self.has_call(receiver) or self.has_call(index)):
                    discard(try self.hoist(receiver, false))
                    discard(try self.hoist(index, false))
                try self.begin("kernel.list_set[")
                try self.type_of(place.type_id)
                try self.put("](")
                try self.use(receiver)
                try self.put(", ")
                try self.use(index)
                try self.put(", ")
                if s.text == "=":
                    try self.owned(value)
                else:
                    let op = (str)s.text.bytes[..<s.text.length - 1]
                    try self.arithmetic(op, place.type_id, place, value)
                try self.put(")")
                try self.end()
                return
        if place.kind == ast.Kind.name:
            if let d = place.resolved:
                if d.has(ast.flag_captured):
                    # `x = v` or `x op= v` on a captured `var`: the cell takes the value
                    try self.begin("kernel.cell_set[")
                    try self.type_of(place.type_id)
                    try self.put("](")
                    try self.captured_name(d, place.text)
                    try self.put(", ")
                    if s.text == "=":
                        try self.owned(value)
                    else:
                        let op = (str)s.text.bytes[..<s.text.length - 1]
                        try self.arithmetic(op, place.type_id, place, value)
                    try self.put(")")
                    try self.end()
                    return
        if self.checker.table.has_references(place.type_id):
            # `s = v` and `s += v` on a reference: the new value made, stored, the old dropped
            let n = try self.temp("new")
            try self.begin("let ")
            try self.put(n)
            try self.put(": ")
            try self.type_of(place.type_id)
            try self.put(" = ")
            if s.text == "=":
                try self.owned(value)
            else:
                let op = (str)s.text.bytes[..<s.text.length - 1]
                try self.arithmetic(op, place.type_id, place, value)
            try self.end()
            try self.store(place, n)
            return
        try self.begin("")
        try self.place_expr(place)
        if s.text == "=" or s.text == "+=" and place.type_id != types.str_id or s.text == "-=" or s.text == "*=" or (s.text == "/=" and place.type_id == types.float_id):
            try self.put(" ")
            try self.put(s.text)
            try self.put(" ")
            try self.expr(value)
            try self.end()
            return
        # `//=`, `%=`, `**=`, and `+=` on text are the operation then the store
        try self.put(" = ")
        let op = (str)s.text.bytes[..<s.text.length - 1]
        try self.arithmetic(op, place.type_id, place, value)
        try self.end()

    ## What a place reaches through a call, computed ahead of the value it takes (§5.3): a
    ## list's or map's receiver and index, a field's object.
    mutating func place_ahead(place: ast.Node*) -> !:
        if place.kind == ast.Kind.index:
            let receiver = place.left else return
            let index = place.body else return
            if self.has_call(receiver) or self.has_call(index):
                discard(try self.hoist(receiver, false))
                let is_map = self.checker.table.kind(receiver.type_id) == types.Kind.map_
                discard(try self.hoist(index, is_map))
        elif place.kind == ast.Kind.member:
            let receiver = place.left else return
            if self.checker.table.kind(receiver.type_id) == types.Kind.class_ and self.has_call(receiver):
                discard(try self.hoist(receiver, false))

    ## `place = name`, the old value dropped after the store when it held references.
    mutating func store(place: ast.Node*, name: str) -> !:
        if place.kind == ast.Kind.name:
            if let d = place.resolved:
                if d.has(ast.flag_captured):
                    try self.begin("kernel.cell_set[")
                    try self.type_of(place.type_id)
                    try self.put("](")
                    try self.captured_name(d, place.text)
                    try self.put(", ")
                    try self.put(name)
                    try self.put(")")
                    try self.end()
                    return
        if place.kind == ast.Kind.index:
            let receiver = place.left else return
            let index = place.body else return
            try self.begin("kernel.list_set[")
            try self.type_of(place.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(", ")
            try self.use(index)
            try self.put(", ")
            try self.put(name)
            try self.put(")")
            try self.end()
            return
        if self.checker.table.has_references(place.type_id):
            let old = try self.temp("old")
            try self.begin("let ")
            try self.put(old)
            try self.put(" = ")
            try self.place_expr(place)
            try self.end()
            try self.begin("")
            try self.place_expr(place)
            try self.put(" = ")
            try self.put(name)
            try self.end()
            try self.begin("")
            try self.put(try self.lifetime_name("L_drop_", place.type_id))
            try self.put("(")
            try self.put(old)
            try self.put(")")
            try self.end()
            return
        try self.begin("")
        try self.place_expr(place)
        try self.put(" = ")
        try self.put(name)
        try self.end()

    ## A place as written: no copy is taken of a field on the way.
    mutating func place_expr(e: ast.Node*) -> !:
        match e.kind:
            .name, .self_, .group, .index: try self.expr(e)
            .member:
                let receiver = e.left else return
                if self.checker.table.kind(receiver.type_id) == types.Kind.class_ and self.has_call(receiver):
                    # `f().field = v`: the object is computed once, ahead of the value (§5.3)
                    try self.put(try self.hoist(receiver, false))
                else:
                    try self.place_expr(receiver)
                try self.put(".L_")
                try self.put(e.text)
            _: return try self.fail(e, "this is not a place the emitter knows")

    mutating func put_u64(n: u64) -> !:
        try self.out.put_u64(n)

    ## The condition of an `if` or `while`, hoisted into a binding when it pooled a
    ## temporary, so that the temporary dies before the body runs (RUNTIME 5). The name
    ## of what to test, or the condition's text.
    mutating func hoisted_condition(s: ast.Node*) -> str!:
        let cond = s.left else return ""
        let start = self.out.used
        let pooled_before = self.pooled
        self.pooled = false
        if s.has(ast.flag_if_let):
            let init = cond.left else return ""
            try self.owned(init)
        else:
            try self.use(cond)
        let text = try self.capture(start)
        if not self.pooled:
            self.pooled = pooled_before
            return text
        let c = try self.temp("cond")
        try self.begin("let ")
        try self.put(c)
        try self.put(" = ")
        try self.put(text)
        try self.end()
        try self.drained(start, pooled_before)
        return c

    mutating func if_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let value = try self.hoisted_condition(s)
        try self.begin("if ")
        if s.has(ast.flag_if_let):
            try self.put("let L_")
            try self.put(cond.text)
            try self.put(" = ")
        try self.put(value)
        try self.put(":")
        try self.end()
        let body = s.body else return
        self.indent += 1
        if s.has(ast.flag_if_let):
            try self.drop_at_exit(cond.text, cond.type_id)
        try self.block(body)
        self.indent -= 1
        if let rest = s.right:
            try self.line("else:")
            self.indent += 1
            if rest.kind == ast.Kind.if_:
                try self.statement(rest)
            else:
                try self.block(rest)
            self.indent -= 1

    mutating func while_statement(s: ast.Node*) -> !:
        let cond = s.left else return
        let body = s.body else return
        # the condition is evaluated inside the loop, so it is written there
        try self.begin("")
        if s.text.length > 0:
            try self.put(s.text)
            try self.put(": ")
        try self.put("while true:")
        try self.end()
        self.indent += 1
        let value = try self.hoisted_condition(s)
        if s.has(ast.flag_if_let):
            try self.begin("if let L_")
            try self.put(cond.text)
            try self.put(" = ")
            try self.put(value)
            try self.put(":")
            try self.end()
            self.indent += 1
            try self.drop_at_exit(cond.text, cond.type_id)
            try self.block(body)
            self.indent -= 1
            try self.line("else:")
            try self.line("    break")
        else:
            try self.begin("if not (")
            try self.put(value)
            try self.put("):")
            try self.end()
            try self.line("    break")
            try self.block(body)
        self.indent -= 1

    ## `with e as x:` is a block that binds, closes on every exit, then drops (§8.5).
    mutating func with_statement(s: ast.Node*) -> !:
        let body = s.body else return
        try self.line("if true:")
        self.indent += 1
        var cursor = s.left
        while let item = cursor:
            let e = item.left else return
            let close = item.resolved else return
            try self.begin("let L_")
            try self.put(item.text)
            try self.put(" = ")
            try self.owned(e)
            try self.end()
            try self.drop_at_exit(item.text, item.type_id)
            let t = self.checker.table.get(item.type_id)
            try self.begin("defer ")
            if t.kind == types.Kind.class_ or t.kind == types.Kind.enum_:
                try self.put("L_")
                try self.put(t.name)
                try self.put("__L_close(L_")
                try self.put(item.text)
                try self.put(")")
            else:
                try self.put("L_")
                try self.put(item.text)
                try self.put(".L_close()")
            try self.end()
            cursor = item.next
        try self.block(body)
        self.indent -= 1



    mutating func for_statement(s: ast.Node*) -> !:
        let binding = s.left else return
        let seq = s.right else return
        let body = s.body else return
        let st = self.checker.table.get(seq.type_id)
        let label = s.text
        if let iterator_method = s.resolved:
            # `Iterable` (§13.3): the iterator is a temporary of the statement; each element
            # is owned by its pass
            let it = try self.temp("it")
            let iterator_type = self.checker.table.get(iterator_method.type_id).elem
            try self.begin("let ")
            try self.put(it)
            try self.put(" = ")
            try self.put(try self.lifetime_name("L_pool_", iterator_type))
            try self.put("(")
            try self.method_on(seq.type_id, iterator_method, try self.used(seq))
            try self.put("))")
            try self.end()
            self.pooled = true
            let next = self.checker.find_member(self.checker.table.get(iterator_type).decl else return try self.fail(s, "no iterator"), "next") else return try self.fail(s, "no next")
            try self.begin("")
            if label.length > 0:
                try self.put(label)
                try self.put(": ")
            try self.put("while true:")
            try self.end()
            self.indent += 1
            if binding.body != none:
                let elem = try self.temp("elem")
                try self.begin("let ")
                try self.put(elem)
                try self.put(" = ")
                try self.method_on(iterator_type, next, it)
                try self.put(") else break")
                try self.end()
                if self.checker.table.has_references(binding.type_id):
                    try self.begin("defer ")
                    try self.put(try self.lifetime_name("L_drop_", binding.type_id))
                    try self.put("(")
                    try self.put(elem)
                    try self.put(")")
                    try self.end()
                try self.bind_parts(binding, elem)
            else:
                try self.begin("let L_")
                try self.put(binding.text)
                try self.put(" = ")
                try self.method_on(iterator_type, next, it)
                try self.put(") else break")
                try self.end()
                try self.drop_at_exit(binding.text, binding.type_id)
            try self.block(body)
            self.indent -= 1
            return
        match st.kind:
            .range_:
                # a written range iterates directly; a range value through its bounds
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for L_")
                try self.put(binding.text)
                try self.put(" in ")
                if seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..="):
                    let l = seq.left else return
                    let r = seq.right else return
                    try self.expr(l)
                    try self.put(seq.text)
                    try self.expr(r)
                else:
                    let t = try self.temp("range")
                    try self.put(t)
                    try self.put(".low..<kernel.range_end(")
                    try self.put(t)
                    try self.put(")")
                try self.put(":")
                try self.end()
                if not (seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..=")):
                    return try self.fail(seq, "a range value in `for` compiles in the collections slice")
                self.indent += 1
                try self.block(body)
                self.indent -= 1
            .str_:
                let it = try self.temp("scalars")
                try self.begin("var ")
                try self.put(it)
                try self.put(" = kernel.Scalars.over(")
                try self.use(seq)
                try self.put(")")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while let L_")
                try self.put(binding.text)
                try self.put(" = ")
                try self.put(it)
                try self.put(".next():")
                try self.end()
                self.indent += 1
                try self.drop_at_exit(binding.text, types.str_id)
                try self.block(body)
                self.indent -= 1
            .bytes_:
                let raw = try self.temp("byte")
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("for ")
                try self.put(raw)
                try self.put(" in (")
                try self.use(seq)
                try self.put(").data:")
                try self.end()
                self.indent += 1
                try self.begin("let L_")
                try self.put(binding.text)
                try self.put(" = (i64)")
                try self.put(raw)
                try self.end()
                try self.block(body)
                self.indent -= 1
            .list_:
                # the runtime's protocol: the check, the bound, the element, the step, the body
                let store = try self.temp("store")
                let version = try self.temp("version")
                let i = try self.temp("i")
                try self.begin("let ")
                try self.put(store)
                try self.put(" = ")
                try self.use(seq)
                try self.end()
                try self.begin("let ")
                try self.put(version)
                try self.put(" = ")
                try self.put(store)
                try self.put(".version")
                try self.end()
                try self.begin("var ")
                try self.put(i)
                try self.put(": usize = 0")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while true:")
                try self.end()
                self.indent += 1
                try self.begin("kernel.list_check[")
                try self.type_of(st.elem)
                try self.put("](")
                try self.put(store)
                try self.put(", ")
                try self.put(version)
                try self.put(")")
                try self.end()
                try self.begin("if ")
                try self.put(i)
                try self.put(" >= ")
                try self.put(store)
                try self.put(".count:")
                try self.end()
                try self.line("    break")
                if binding.body != none:
                    # `for (a, b) in items`: the parts copied out of the element in place
                    let half = self.checker.scratch.length // 2
                    let element = try copy_name(try format(self.checker.scratch[half..], f"{store}.items[{i}]"))
                    try self.bind_parts(binding, element)
                else:
                    try self.begin("let L_")
                    try self.put(binding.text)
                    try self.put(" = ")
                    if self.checker.table.has_references(st.elem):
                        try self.put(try self.lifetime_name("L_copy_", st.elem))
                        try self.put("(")
                        try self.put(store)
                        try self.put(".items[")
                        try self.put(i)
                        try self.put("])")
                    else:
                        try self.put(store)
                        try self.put(".items[")
                        try self.put(i)
                        try self.put("]")
                    try self.end()
                    try self.drop_at_exit(binding.text, st.elem)
                try self.begin("")
                try self.put(i)
                try self.put(" += 1")
                try self.end()
                try self.block(body)
                self.indent -= 1
            .map_, .set_:
                let store = try self.temp("store")
                let version = try self.temp("version")
                let i = try self.temp("i")
                let is_map = st.kind == types.Kind.map_
                try self.begin("let ")
                try self.put(store)
                try self.put(" = ")
                try self.use(seq)
                try self.end()
                try self.begin("let ")
                try self.put(version)
                try self.put(" = ")
                try self.put(store)
                try self.put(".version")
                try self.end()
                try self.begin("var ")
                try self.put(i)
                try self.put(": usize = 0")
                try self.end()
                try self.begin("")
                if label.length > 0:
                    try self.put(label)
                    try self.put(": ")
                try self.put("while true:")
                try self.end()
                self.indent += 1
                try self.begin("kernel.map_check[")
                try self.map_types(seq.type_id)
                try self.put("](")
                try self.put(store)
                try self.put(", ")
                try self.put(version)
                try self.put(")")
                try self.end()
                try self.begin("if ")
                try self.put(i)
                try self.put(" >= ")
                try self.put(store)
                try self.put(".count:")
                try self.end()
                try self.line("    break")
                let value_type = self.checker.table.map_value(seq.type_id) if is_map else types.unit_id
                if is_map and binding.body != none:
                    # `for (k, v) in m`: each its own copy
                    var part = binding.body
                    var which: usize = 0
                    while let name = part:
                        if not name.has(ast.flag_wildcard):
                            try self.begin("let L_")
                            try self.put(name.text)
                            try self.put(" = ")
                            try self.element_copy(st.elem if which == 0 else value_type, store, ".keys[" if which == 0 else ".values[", i)
                            try self.end()
                            try self.drop_at_exit(name.text, name.type_id)
                        which += 1
                        part = name.next
                elif is_map:
                    try self.begin("let L_")
                    try self.put(binding.text)
                    try self.put(" = (")
                    try self.element_copy(st.elem, store, ".keys[", i)
                    try self.put(", ")
                    try self.element_copy(value_type, store, ".values[", i)
                    try self.put(")")
                    try self.end()
                    try self.drop_at_exit(binding.text, binding.type_id)
                elif binding.body != none:
                    let half = self.checker.scratch.length // 2
                    let element = try copy_name(try format(self.checker.scratch[half..], f"{store}.keys[{i}]"))
                    try self.bind_parts(binding, element)
                else:
                    try self.begin("let L_")
                    try self.put(binding.text)
                    try self.put(" = ")
                    try self.element_copy(st.elem, store, ".keys[", i)
                    try self.end()
                    try self.drop_at_exit(binding.text, st.elem)
                try self.begin("")
                try self.put(i)
                try self.put(" += 1")
                try self.end()
                try self.block(body)
                self.indent -= 1
            _: return try self.fail(seq, "iterating this compiles in a later slice")

    ## `for (a, b) in items` over a tuple element read at `source`: each named part its own
    ## copy, dropped when its pass ends; `_` takes nothing.
    mutating func bind_parts(binding: ast.Node*, source: str) -> !:
        let members = self.checker.table.get(binding.type_id).args
        var part = binding.body
        var which: usize = 0
        while let name = part:
            if not name.has(ast.flag_wildcard) and which < members.length:
                let half = self.checker.scratch.length // 2
                let member = try copy_name(try format(self.checker.scratch[half..], f"{source}.{which}"))
                try self.begin("let L_")
                try self.put(name.text)
                try self.put(" = ")
                if self.checker.table.has_references(members[which]):
                    try self.put(try self.lifetime_name("L_copy_", members[which]))
                    try self.put("(")
                    try self.put(member)
                    try self.put(")")
                else:
                    try self.put(member)
                try self.end()
                try self.drop_at_exit(name.text, members[which])
            which += 1
            part = name.next

    ## `store.keys[i]` or the like, copied when the element holds references.
    mutating func element_copy(t: u32, store: str, member: str, i: str) -> !:
        let holds = self.checker.table.has_references(t)
        if holds:
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
        try self.put(store)
        try self.put(member)
        try self.put(i)
        try self.put("]")
        if holds:
            try self.put(")")

    # -- match ----------------------------------------------------------------------------

    mutating func match_statement(s: ast.Node*) -> !:
        let subject = s.left else return
        let st = self.checker.table.get(subject.type_id)
        let m = try self.temp("subject")
        try self.begin("let ")
        try self.put(m)
        try self.put(" = ")
        try self.use(subject)
        try self.end()
        if st.kind == types.Kind.tuple or st.kind == types.Kind.str_ or st.kind == types.Kind.bytes_:
            return try self.match_by_tests(s, m, subject.type_id)
        try self.begin("match ")
        try self.put(m)
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = s.body
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            self.raw_payloads = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, m, &bound)
                p = pattern.next
            self.raw_payloads = false
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(":")
            try self.end()
            self.indent += 1
            if let name = bound:
                try self.begin("let L_")
                try self.put(name.text)
                try self.put(" = ")
                if self.checker.table.has_references(name.type_id):
                    try self.put(try self.lifetime_name("L_copy_", name.type_id))
                    try self.put("(")
                    try self.put(m)
                    try self.put(")")
                else:
                    try self.put(m)
                try self.end()
                try self.drop_at_exit(name.text, name.type_id)
            # a payload bound by the arm is the subject's; the binding takes its own copy
            var q = arm.left
            while let pattern = q:
                try self.own_payloads(pattern, st)
                q = pattern.next
            let body = arm.body else return
            try self.block(body)
            self.indent -= 1
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(s):
            try self.line("_: discard(0)")
        self.indent -= 1

    ## `let L_x = L_copy(L_x__r)` and its drop for every payload name the pattern bound
    ## whose type holds references; `pattern` wrote the raw name.
    mutating func own_payloads(p: ast.Node*, st: types.Type) -> !:
        if p.has(ast.flag_wildcard):
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional and self.checker.table.has_references(name.type_id):
                try self.own_payload(name)
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            var cursor = v.body
            while let name = cursor:
                if not name.has(ast.flag_wildcard) and self.checker.table.has_references(name.type_id):
                    try self.own_payload(name)
                cursor = name.next

    mutating func own_payload(name: ast.Node*) -> !:
        try self.begin("let L_")
        try self.put(name.text)
        try self.put(" = ")
        try self.put(try self.lifetime_name("L_copy_", name.type_id))
        try self.put("(L_")
        try self.put(name.text)
        try self.put("__r)")
        try self.end()
        try self.drop_at_exit(name.text, name.type_id)

    ## A bound payload name in a pattern: raw when the binding will copy it.
    mutating func payload_name(name: ast.Node*) -> !:
        try self.put("L_")
        try self.put(name.text)
        if self.raw_payloads and self.checker.table.has_references(name.type_id):
            try self.put("__r")

    ## One pattern in a Base arm; a name pattern becomes `_` (or `.some(name)`) and is
    ## bound at the arm's start.
    mutating func pattern(p: ast.Node*, st: types.Type, subject: str, bound: ast.Node*?*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "bind":
            let name = p.left else return
            if st.kind == types.Kind.optional:
                try self.put(".some(")
                try self.payload_name(name)
                try self.put(")")
            else:
                try self.put("_")
                *bound = name
            return
        if p.text == "none":
            try self.put(".none")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            try self.put(".L_")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                var cursor = v.body
                var first = true
                while let name = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    if name.has(ast.flag_wildcard):
                        try self.put("_")
                    else:
                        try self.payload_name(name)
                    cursor = name.next
                try self.put(")")
            return
        if p.text == "..<" or p.text == "..=":
            let hi = p.right else return
            try self.expr(v)
            try self.put(p.text)
            try self.expr(hi)
            return
        if v.kind == ast.Kind.literal and v.type_id == types.str_id:
            try self.text_literal(try literals.decode_text(v.text), false)
            return
        try self.expr(v)

    ## A match expression over a tuple or bytes: `match true:` with one guarded arm per
    ## pattern, the tests over the subject as written, which must be stable (a name, a
    ## literal, a tuple of those), since every arm reads it again; a pattern binding a
    ## name needs the statement form.
    mutating func match_expr_by_tests(e: ast.Node*, subject: ast.Node*, st: types.Type) -> !:
        if not self.stable(subject):
            return try self.fail(subject, "a match expression over a tuple or bytes reads its subject in every arm; bind it to a name first, or use the statement form")
        let start = self.out.used
        try self.expr(subject)
        let m = try self.capture(start)
        try self.put("match true:")
        try self.end()
        self.indent += 1
        var cursor = e.body
        while let arm = cursor:
            var p = arm.left
            while let pattern = p:
                if binds_a_name(pattern):
                    return try self.fail(pattern, "a pattern binding a name in a match expression over a tuple needs the statement form")
                p = pattern.next
            try self.begin("_")
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" if ")
                var q = arm.left
                var first = true
                while let pattern = q:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m, subject.type_id)
                    try self.put(")")
                    q = pattern.next
                if let guard = arm.right:
                    try self.put(" and (")
                    try self.use(guard)
                    try self.put(")")
            try self.put(" => ")
            let body = arm.body else return
            try self.owned(body)
            try self.end()
            cursor = arm.next
        if not has_wildcard_arm(e):
            try self.line("_ => trap(\"no arm applied\")")
        self.indent -= 1
        try self.begin("")

    ## The value a capture takes: `self` from the method, otherwise the binding's value.
    mutating func captured_source(d: ast.Node*, name: str) -> !:
        if name == "self":
            try self.put(self.self_name)
            return
        try self.captured_name(d, name)
        if d.has(ast.flag_captured):
            try self.put(".value")

    ## Whether an expression may be read more than once without a change of meaning.
    func stable(e: ast.Node*) -> bool:
        match e.kind:
            .name, .self_, .literal: return true
            .group:
                let inner = e.left else return false
                return self.stable(inner)
            .tuple:
                var cursor = e.body
                while let m = cursor:
                    if not self.stable(m):
                        return false
                    cursor = m.next
                return true
            _: return false

    ## A match over a tuple: one `if` per arm over member tests, a flag saying an arm
    ## applied so a failed guard falls through to the next, and a trap after the chain when
    ## every arm leaves the function, so Base sees the return the checker proved.
    mutating func match_by_tests(s: ast.Node*, m: str, st: u32) -> !:
        let done = try self.temp("matched")
        try self.begin("var ")
        try self.put(done)
        try self.put(" = false")
        try self.end()
        var cursor = s.body
        while let arm = cursor:
            try self.begin("if not ")
            try self.put(done)
            if not (arm.right == none and irrefutable(arm.left)):
                try self.put(" and (")
                var p = arm.left
                var first = true
                while let pattern = p:
                    if not first:
                        try self.put(" or ")
                    first = false
                    try self.put("(")
                    try self.tuple_test(pattern, m, st)
                    try self.put(")")
                    p = pattern.next
                try self.put(")")
            try self.put(":")
            try self.end()
            self.indent += 1
            if let pattern = arm.left:
                try self.tuple_bindings(pattern, m)
            if let guard = arm.right:
                try self.begin("if ")
                try self.expr(guard)
                try self.put(":")
                try self.end()
                self.indent += 1
            try self.begin("")
            try self.put(done)
            try self.put(" = true")
            try self.end()
            let body = arm.body else return
            try self.block(body)
            if arm.right != none:
                self.indent -= 1
            self.indent -= 1
            cursor = arm.next
        if s.has(ast.flag_all_exit):
            try self.line("trap(\"no arm of the match applied\")")

    mutating func tuple_test(p: ast.Node*, m: str, t: u32) -> !:
        if p.has(ast.flag_wildcard) or p.text == "bind":
            try self.put("true")
            return
        if p.text == "tuple":
            let members = self.checker.table.get(t).args
            var i: usize = 0
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(" and ")
                first = false
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_test_member(sub, try copy_name(member), members[i])
                i += 1
                cursor = sub.next
            if first:
                try self.put("true")
            return
        let v = p.left else return
        if self.needs_equality(t):
            try self.put(try self.equality_name(t))
            try self.put("(")
            try self.put(m)
            try self.put(", ")
            try self.use(v)
            try self.put(")")
            return
        try self.put(m)
        try self.put(" == ")
        try self.expr(v)

    mutating func tuple_test_member(p: ast.Node*, member: str, t: u32) -> !:
        try self.put("(")
        try self.tuple_test(p, member, t)
        try self.put(")")

    mutating func tuple_bindings(p: ast.Node*, m: str) -> !:
        if p.text == "bind":
            let name = p.left else return
            try self.begin("let L_")
            try self.put(name.text)
            try self.put(" = ")
            if self.checker.table.has_references(name.type_id):
                try self.put(try self.lifetime_name("L_copy_", name.type_id))
                try self.put("(")
                try self.put(m)
                try self.put(")")
            else:
                try self.put(m)
            try self.end()
            try self.drop_at_exit(name.text, name.type_id)
            return
        if p.text == "tuple":
            var i: usize = 0
            var cursor = p.body
            while let sub = cursor:
                let half = self.checker.scratch.length // 2
                let member = try format(self.checker.scratch[half..], f"{m}.{i}")
                try self.tuple_bindings(sub, try copy_name(member))
                i += 1
                cursor = sub.next

    # -- expressions ----------------------------------------------------------------------

    ## `L_x`, or `L_env.L_x` inside a lambda that captured `x` (§7.4); a captured `var` is
    ## a cell either way, and the caller adds `.value`.
    mutating func captured_name(d: ast.Node*, name: str) -> !:
        if let lambda = self.lambda:
            var cursor = lambda.left
            while let capture = cursor:
                if capture.resolved == d:
                    try self.put("L_env.L_")
                    try self.put(name)
                    return
                cursor = capture.next
        try self.put("L_")
        try self.put(name)

    ## Whether the expression reads a binding, so its value is borrowed (RUNTIME 4).
    func borrowed(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                let d = e.resolved else return false
                # a named function's closure is immortal: read, never released
                return d.kind != ast.Kind.constant
            .self_: return true
            .literal:
                # a text literal is an immortal object: read, never released
                let b = e.text.bytes
                return b.length > 0 and (b[0] == '"' or b[0] == 'r' or b[0] == 'b') and e.text != "b" and e.text != "r"
            .group:
                let inner = e.left else return false
                return self.borrowed(inner)
            _: return false

    ## The expression as a value the reader will keep: a borrowed one is copied.
    mutating func owned(e: ast.Node*) -> !:
        if self.checker.table.has_references(e.type_id) and (self.borrowed(e) or self.hoisted_name(e) != none):
            # a hoisted operand is the statement's temporary: an owner takes a copy
            try self.put(try self.lifetime_name("L_copy_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            return
        try self.expr(e)

    ## An operand of a construct whose other operand may fail (a `try` beside it): evaluated
    ## ahead of the statement into a temporary of the statement, in source order, so that a
    ## failure drains what was made and nothing is copied for a taker that never took it
    ## (RUNTIME 5). The name to write at the site: a copy of the temporary for an owned
    ## reference, the temporary itself otherwise.
    mutating func hoist(e: ast.Node*, owned: bool) -> str!:
        if let already = self.hoisted_name(e):
            if owned and self.checker.table.has_references(e.type_id):
                let half = self.checker.scratch.length // 2
                return try copy_name(try format(self.checker.scratch[half..], f"{try self.lifetime_name("L_copy_", e.type_id)}({already})"))
            return already
        let name = try self.temp("arg")
        let start = self.out.used
        if owned:
            try self.owned(e)
        else:
            try self.use(e)
        let text = try self.capture(start)
        let refs = self.checker.table.has_references(e.type_id)
        var i: u32 = 0
        while i < self.indent:
            try self.prelude.put("    ")
            i += 1
        try self.prelude.put("let ")
        try self.prelude.put(name)
        try self.prelude.put(" = ")
        if owned and refs:
            try self.prelude.put(try self.lifetime_name("L_pool_", e.type_id))
            try self.prelude.put("(")
            try self.prelude.put(text)
            try self.prelude.put(")")
        else:
            try self.prelude.put(text)
        try self.prelude.put("\n")
        # a hoisted operand is spliced in like a pooled temporary, whatever it holds
        self.pooled = true
        if owned and refs:
            let half = self.checker.scratch.length // 2
            return try copy_name(try format(self.checker.scratch[half..], f"{try self.lifetime_name("L_copy_", e.type_id)}({name})"))
        try self.hoisted_nodes.push(e)
        try self.hoisted_names.push(name)
        return name

    ## The name an operand was hoisted under in this statement, if it was.
    func hoisted_name(e: ast.Node*) -> str?:
        var i: usize = 0
        while i < self.hoisted_nodes.count:
            if self.hoisted_nodes.get(i) == e:
                return self.hoisted_names.get(i)
            i += 1
        return none

    ## Whether a call appears anywhere in the expression: evaluating it may have an effect.
    func has_call(n: ast.Node*?) -> bool:
        let node = n else return false
        if node.kind == ast.Kind.call or node.kind == ast.Kind.spawn_ or node.kind == ast.Kind.wait_:
            return true
        if node.kind == ast.Kind.lambda:
            return false
        return self.has_call(node.left) or self.has_call(node.right) or self.has_call(node.body) or self.has_call(node.ty) or self.has_call(node.next)

    ## Whether `try` appears anywhere in the expression: evaluating it may fail.
    func may_fail(n: ast.Node*?) -> bool:
        let node = n else return false
        if node.kind == ast.Kind.unary and node.text == "try":
            return true
        if node.kind == ast.Kind.lambda:
            return false
        return self.may_fail(node.left) or self.may_fail(node.right) or self.may_fail(node.body) or self.may_fail(node.ty) or self.may_fail(node.next)

    ## The elements of a list, set or tuple literal, each owned; hoisted when one may fail.
    mutating func owned_items(items: ast.Node*?) -> !:
        var risky = false
        var cursor = items
        while let item = cursor:
            if self.may_fail(item):
                risky = true
            cursor = item.next
        var names = try list.List[str].create(8)
        if risky:
            cursor = items
            while let item = cursor:
                try names.push(try self.hoist(item, true))
                cursor = item.next
        cursor = items
        var first = true
        var i: usize = 0
        while let item = cursor:
            if not first:
                try self.put(", ")
            first = false
            if risky:
                try self.put(names.get(i))
            else:
                try self.owned(item)
            i += 1
            cursor = item.next

    ## The expression as a value used and let go of: an owned one becomes a temporary of
    ## the statement, pooled until the drain.
    mutating func use(e: ast.Node*) -> !:
        if let name = self.hoisted_name(e):
            # pooled when it was hoisted
            try self.put(name)
            return
        if self.checker.table.has_references(e.type_id) and not self.borrowed(e):
            try self.put(try self.lifetime_name("L_pool_", e.type_id))
            try self.put("(")
            try self.expr(e)
            try self.put(")")
            self.pooled = true
            return
        try self.expr(e)

    ## Writes the value: borrowed for a read of a binding, owned for everything else.
    pub mutating func expr(e: ast.Node*) -> !:
        if let name = self.hoisted_name(e):
            try self.put(name)
            return
        match e.kind:
            .literal: try self.literal(e)
            .name:
                let d = e.resolved else return try self.fail(e, "an unresolved name")
                if d.kind == ast.Kind.func_:
                    # a named function as a value: its immortal closure
                    try self.put("&")
                    try self.put(try self.thunk_name(d, "L_fn_"))
                    return
                if d.kind == ast.Kind.constant:
                    if d.has(ast.flag_base):
                        try self.base_constant(d)
                        return
                    try self.put("L_")
                    try self.put(try self.decl_name(d))
                    return
                try self.captured_name(d, e.text)
                if d.has(ast.flag_captured):
                    try self.put(".value")
            .self_: try self.put(self.self_name)
            .group:
                let inner = e.left else return
                try self.put("(")
                try self.expr(inner)
                try self.put(")")
            .spawn_:
                # a task object of this spawn's own shape, given the arguments (§14)
                let call = e.left else return
                try self.put(try self.spawn_name(e))
                try self.put("(")
                var first = true
                var a = call.body
                while let arg = a:
                    if not first:
                        try self.put(", ")
                    first = false
                    let v = arg.left else return
                    try self.owned(v)
                    a = arg.next
                try self.put(")")
            .wait_:
                let inner = e.left else return
                try self.put(try self.wait_name(inner.type_id))
                try self.put("(")
                try self.use(inner)
                try self.put(")")
            .convert:
                # a conforming value boxed as an interface value (§13.2); the box owns a copy
                let inner = e.left else return
                var target = e.type_id
                if self.checker.table.kind(target) == types.Kind.optional:
                    target = self.checker.table.get(target).elem
                try self.put(try self.box_name(target, inner.type_id))
                try self.put("(")
                try self.owned(inner)
                try self.put(")")
            .unary:
                let inner = e.left else return
                if e.text == "try":
                    try self.put("try ")
                    try self.expr(inner)
                elif e.text == "not":
                    try self.put("not ")
                    try self.expr(inner)
                else:
                    try self.put("(-")
                    try self.expr(inner)
                    try self.put(")")
            .binary: try self.binary(e)
            .conditional:
                let cond = e.ty else return
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" if ")
                try self.use(cond)
                try self.put(" else ")
                try self.owned(r)
                try self.put(")")
            .tuple:
                try self.put("(")
                try self.owned_items(e.body)
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .unit_: try self.put("()")
            .lambda:
                # the closure: an object holding a copy of every captured `let` and the
                # cell of every captured `var`
                try self.put(try self.lambda_name(e))
                try self.put("__new(")
                var cursor = e.left
                var first = true
                while let capture = cursor:
                    let d = capture.resolved else return try self.fail(e, "an unresolved capture")
                    if not first:
                        try self.put(", ")
                    first = false
                    if capture.has(ast.flag_var_field):
                        try self.put("(kernel.Cell[")
                        try self.type_of(capture.type_id)
                        try self.put("]*)heap.retain((heap.Object*)")
                        try self.captured_name(d, capture.text)
                        try self.put(")")
                    elif self.checker.table.has_references(capture.type_id):
                        try self.put(try self.lifetime_name("L_copy_", capture.type_id))
                        try self.put("(")
                        try self.captured_source(d, capture.text)
                        try self.put(")")
                    else:
                        try self.captured_source(d, capture.text)
                    cursor = capture.next
                try self.put(")")
            .list_lit:
                let t = self.checker.table.get(e.type_id)
                if e.body == none:
                    try self.put("kernel.list_new[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                else:
                    try self.put("kernel.list_of[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                try self.put(try self.lifetime_name("L_info_", e.type_id))
                try self.put(", ")
                try self.put(try self.ops_name(t.elem))
                if e.body != none:
                    try self.put(", [")
                    try self.owned_items(e.body)
                    try self.put("]")
                try self.put(")")
            .set_lit, .map_lit:
                let t = self.checker.table.get(e.type_id)
                if t.kind == types.Kind.set_:
                    try self.put("kernel.set_of[" if e.body != none else "kernel.set_new[")
                    try self.type_of(t.elem)
                    try self.put("](&")
                    try self.put(try self.lifetime_name("L_info_", e.type_id))
                    try self.put(", ")
                    try self.put(try self.ops_name(t.elem))
                    if e.body != none:
                        try self.put(", [")
                        try self.owned_items(e.body)
                        try self.put("]")
                    try self.put(")")
                else:
                    let value_type = self.checker.table.map_value(e.type_id)
                    try self.put("kernel.map_of[" if e.body != none else "kernel.map_new[")
                    try self.type_of(t.elem)
                    try self.put(", ")
                    try self.type_of(value_type)
                    try self.put("](&")
                    try self.put(try self.lifetime_name("L_info_", e.type_id))
                    try self.put(", ")
                    try self.put(try self.ops_name(t.elem))
                    try self.put(", ")
                    try self.put(try self.ops_name(value_type))
                    if e.body != none:
                        # keys then values in Base; hoisted in source order when one may fail
                        # or call anything, so the entries are evaluated as written
                        var risky = false
                        var cursor = e.body
                        while let entry = cursor:
                            if self.may_fail(entry.left) or self.may_fail(entry.right) or self.has_call(entry.left) or self.has_call(entry.right):
                                risky = true
                            cursor = entry.next
                        if risky:
                            cursor = e.body
                            while let entry = cursor:
                                let k = entry.left else return
                                let v = entry.right else return
                                entry.text = try self.hoist(k, true)
                                entry.doc = try self.hoist(v, true)
                                cursor = entry.next
                        try self.put(", [")
                        cursor = e.body
                        var first = true
                        while let entry = cursor:
                            let k = entry.left else return
                            if not first:
                                try self.put(", ")
                            first = false
                            if risky:
                                try self.put(entry.text)
                            else:
                                try self.owned(k)
                            cursor = entry.next
                        try self.put("], [")
                        cursor = e.body
                        first = true
                        while let entry = cursor:
                            let v = entry.right else return
                            if not first:
                                try self.put(", ")
                            first = false
                            if risky:
                                try self.put(entry.doc)
                            else:
                                try self.owned(v)
                            cursor = entry.next
                        try self.put("]")
                    try self.put(")")
            .call: try self.call(e)
            .member: try self.member(e)
            .index:
                let receiver = e.left else return
                let index = e.body else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.bytes_:
                    try self.put("kernel.byte_at(")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                elif rt.kind == types.Kind.list_:
                    try self.put("kernel.list_get[")
                    try self.type_of(rt.elem)
                    try self.put("](")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                elif rt.kind == types.Kind.map_:
                    try self.put("kernel.map_get[")
                    try self.map_types(receiver.type_id)
                    try self.put("](")
                    try self.use(receiver)
                    try self.put(", ")
                    try self.use(index)
                    try self.put(")")
                else:
                    return try self.fail(e, "indexing this compiles in the collections slice")
            .slice:
                let receiver = e.left else return
                let rt = self.checker.table.get(receiver.type_id)
                if rt.kind == types.Kind.str_:
                    try self.put("kernel.slice_text(")
                elif rt.kind == types.Kind.bytes_:
                    try self.put("kernel.slice_bytes(")
                else:
                    try self.put("kernel.list_slice[")
                    try self.type_of(rt.elem)
                    try self.put("](")
                try self.use(receiver)
                try self.put(", ")
                if let low = e.body:
                    try self.expr(low)
                else:
                    try self.put("0")
                try self.put(", ")
                if let high = e.right:
                    try self.expr(high)
                else:
                    try self.put("0")
                try self.put(", ")
                try self.put("true" if e.has(ast.flag_no_high) else "false")
                try self.put(")")
            .else_:
                let l = e.left else return
                let r = e.right else return
                try self.put("(")
                try self.owned(l)
                try self.put(" else ")
                if r.kind == ast.Kind.return_:
                    try self.put("return")
                    if let v = r.left:
                        try self.put(" ")
                        try self.owned(v)
                elif r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
                    try self.put("break" if r.kind == ast.Kind.break_ else "continue")
                    if r.text.length > 0:
                        try self.put(" ")
                        try self.put(r.text)
                else:
                    try self.owned(r)
                try self.put(")")
            .catch_:
                let l = e.left else return
                let body = e.body else return
                try self.owned(l)
                try self.put(" catch ")
                if e.text.length > 0:
                    try self.put("L_")
                    try self.put(e.text)
                try self.put(":")
                try self.end()
                self.indent += 1
                try self.block(body)
                self.indent -= 1
                # the caller's line is already ended by the suite
                try self.begin("")
            .case_value: try self.case_value(e, e.body)
            .formatted: try self.formatted(e)
            .match_expr: try self.match_expr(e)
            _: return try self.fail(e, "an expression this slice does not compile")

    ## The receiver of an index, named once when it is a call.
    mutating func temp_less_receiver(receiver: ast.Node*) -> str!:
        if receiver.kind == ast.Kind.name or receiver.kind == ast.Kind.self_:
            let half = self.checker.scratch.length // 2
            if receiver.kind == ast.Kind.self_:
                return self.self_name
            return try copy_name(try format(self.checker.scratch[half..], f"L_{receiver.text}"))
        return try self.fail(receiver, "index a bound name; binding the value first")

    mutating func literal(e: ast.Node*) -> !:
        let b = e.text.bytes
        if e.text == "true" or e.text == "false" or e.text == "none":
            try self.put(e.text)
            return
        if b[0] == '"' or (b[0] == 'r' and b.length > 1 and b[1] == '"'):
            try self.put(try self.text_ref(try literals.decode_text(e.text), false))
            return
        if b[0] == 'b' and b.length > 1 and b[1] == '"':
            try self.put(try self.text_ref((str)(try literals.decode_text(e.text)).bytes, true))
            return
        if literals.is_float_text(e.text):
            try self.put(e.text)
            return
        let magnitude = try literals.decode_integer(e.text)
        if magnitude == 9223372036854775808:
            try self.put("9223372036854775808")
            return
        try self.put_u64(magnitude)

    ## A Base text literal for `text`: every byte C or Base could misread is escaped.
    mutating func text_literal(text: str, as_bytes: bool) -> !:
        if as_bytes:
            try self.put("b")
        try self.put("\"")
        for c in text.bytes:
            if c == '\\':
                try self.put("\\\\")
            elif c == '"':
                try self.put("\\\"")
            elif c == '\n':
                try self.put("\\n")
            elif c == '\r':
                try self.put("\\r")
            elif c == '\t':
                try self.put("\\t")
            elif c == 0:
                try self.put("\\0")
            elif c < 32 or (as_bytes and c >= 127):
                try self.put("\\x")
                try self.out.put_byte(hex_digit(c >> 4))
                try self.out.put_byte(hex_digit(c & 15))
            else:
                try self.out.put_byte(c)
        try self.put("\"")

    mutating func binary(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let op = e.text
        if op == "and" or op == "or":
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        if op == "..<" or op == "..=":
            try self.put("kernel.range(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(", ")
            try self.put("true" if op == "..=" else "false")
            try self.put(")")
            return
        if op == "is" or op == "is not":
            # identity: the objects' addresses, none being zero (§10.2)
            try self.put("(")
            try self.identity(l)
            try self.put(" == " if op == "is" else " != ")
            try self.identity(r)
            try self.put(")")
            return
        if op == "in":
            let rt = self.checker.table.get(r.type_id)
            if rt.kind == types.Kind.str_:
                try self.put("kernel.contains(")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            if rt.kind == types.Kind.range_:
                try self.put("kernel.in_range(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
            if rt.kind == types.Kind.list_:
                try self.put("kernel.list_contains[")
                try self.type_of(rt.elem)
                try self.put("](")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            if rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_:
                try self.put("kernel.map_contains[")
                try self.map_types(r.type_id)
                try self.put("](")
                try self.use(r)
                try self.put(", ")
                try self.use(l)
                try self.put(")")
                return
            return try self.fail(e, "`in` over this compiles in a later slice")
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
            let lt = l.type_id
            if (op == "==" or op == "!=") and (is_none(l) or is_none(r)):
                # a presence test (§12.1): Base compares an optional with `none` itself
                try self.put("(")
                try self.use(l)
                try self.put(" ")
                try self.put(op)
                try self.put(" ")
                try self.use(r)
                try self.put(")")
                return
            if (op == "==" or op == "!=") and self.needs_equality(lt):
                # a collection compares by contents (§4.4), so does what holds one
                if op == "!=":
                    try self.put("not ")
                try self.put(try self.equality_name(lt))
                try self.put("(")
                try self.use(l)
                try self.put(", ")
                try self.use(r)
                try self.put(")")
                return
            if (op != "==" and op != "!=") and self.protocol_method(lt, "Ordered", "compare") != none:
                try self.put("(")
                try self.put(try self.ordering_name(lt))
                try self.put("(")
                try self.use(l)
                try self.put(", ")
                try self.use(r)
                try self.put(") ")
                try self.put(op)
                try self.put(" 0)")
                return
            if (op != "==" and op != "!=") and (lt == types.str_id or lt == types.bytes_id or self.checker.table.kind(lt) == types.Kind.tuple):
                try self.compare_by_call(op, l, r)
                return
            try self.put("(")
            try self.expr(l)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.expr(r)
            try self.put(")")
            return
        try self.arithmetic(op, e.type_id if op != "/" else l.type_id, l, r)

    ## `<` and friends on text, bytes and tuples, which Base does not order itself.
    mutating func compare_by_call(op: str, l: ast.Node*, r: ast.Node*) -> !:
        let lt = self.checker.table.get(l.type_id)
        if lt.kind == types.Kind.tuple:
            # lexicographic over the members, which are ordered scalars
            try self.put("(")
            var i: usize = 0
            while i < lt.args.length:
                if i > 0:
                    try self.put(" or (")
                var k: usize = 0
                while k < i:
                    try self.member_compare("==", l, r, lt.args[k], k)
                    try self.put(" and ")
                    k += 1
                let last = i + 1 == lt.args.length
                try self.member_compare(op if last else strict(op), l, r, lt.args[i], i)
                if i > 0:
                    try self.put(")")
                i += 1
            try self.put(")")
            return
        try self.put("(kernel.compare_blobs(" if lt.kind == types.Kind.bytes_ else "(kernel.compare_text(")
        try self.use(l)
        try self.put(", ")
        try self.use(r)
        try self.put(") ")
        try self.put(op)
        try self.put(" 0)")

    mutating func member_compare(op: str, l: ast.Node*, r: ast.Node*, t: u32, i: usize) -> !:
        if t == types.str_id or t == types.bytes_id:
            try self.put("(kernel.compare_blobs(" if t == types.bytes_id else "(kernel.compare_text(")
            try self.expr(l)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(", ")
            try self.expr(r)
            try self.put(".")
            try self.put_u64((u64)i)
            try self.put(") ")
            try self.put(op)
            try self.put(" 0)")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(".")
        try self.put_u64((u64)i)
        try self.put(")")

    ## `a op b` for the arithmetic operators (§6.2), with `t` the operands' type.
    mutating func arithmetic(op: str, t: u32, l: ast.Node*, r: ast.Node*) -> !:
        if t == types.str_id and op == "+":
            try self.put("kernel.concat(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.bytes_id and op == "+":
            try self.put("kernel.concat_bytes(")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if self.checker.table.kind(t) == types.Kind.list_ and op == "+":
            try self.put("kernel.list_concat[")
            try self.type_of(self.checker.table.get(t).elem)
            try self.put("](")
            try self.use(l)
            try self.put(", ")
            try self.use(r)
            try self.put(")")
            return
        if t == types.int_id:
            if op == "/":
                try self.put("(f64(")
                try self.expr(l)
                try self.put(") / f64(")
                try self.expr(r)
                try self.put("))")
                return
            if op == "//" or op == "%" or op == "**":
                try self.put("kernel.floor_div(" if op == "//" else "kernel.floor_mod(" if op == "%" else "kernel.power(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(")")
                return
        if t == types.float_id and (op == "//" or op == "%" or op == "**"):
            try self.put("kernel.ffloor_div(" if op == "//" else "kernel.ffloor_mod(" if op == "%" else "kernel.fpower(")
            try self.expr(l)
            try self.put(", ")
            try self.expr(r)
            try self.put(")")
            return
        try self.put("(")
        try self.expr(l)
        try self.put(" ")
        try self.put(op)
        try self.put(" ")
        try self.expr(r)
        try self.put(")")

    mutating func member(e: ast.Node*) -> !:
        let receiver = e.left else return
        let rt = self.checker.table.get(receiver.type_id)
        if rt.kind == types.Kind.module:
            # `module.name`: the declaration under its own name (§15)
            let d = e.resolved else return
            if d.kind == ast.Kind.constant and d.has(ast.flag_base):
                try self.base_constant(d)
                return
            try self.put("L_")
            if d.kind == ast.Kind.constant or d.kind == ast.Kind.func_:
                try self.put(try self.decl_name(d))
            else:
                try self.put(self.type_name(d))
            return
        if rt.kind == types.Kind.type_name:
            let m = e.resolved else return
            let d = rt.decl else return
            if m.kind == ast.Kind.enum_case:
                try self.put("L_")
                try self.put(self.type_name(d))
                try self.put(".L_")
                try self.put(m.text)
                return
            try self.put("L_")
            try self.put(self.type_name(d))
            try self.put(".L_")
            try self.put(m.text)
            return
        if rt.kind == types.Kind.tuple:
            let copies = self.checker.table.has_references(e.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", e.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if e.text == "byte_count" and rt.kind == types.Kind.str_:
            try self.put("(i64)(")
            try self.use(receiver)
            try self.put(").data.length")
            return
        if e.text == "length" and (rt.kind == types.Kind.map_ or rt.kind == types.Kind.set_):
            try self.put("kernel.map_length[")
            try self.map_types(receiver.type_id)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if e.text == "length" and (rt.kind == types.Kind.str_ or rt.kind == types.Kind.bytes_ or rt.kind == types.Kind.list_):
            if rt.kind == types.Kind.str_:
                try self.put("kernel.scalar_length(")
                try self.use(receiver)
                try self.put(")")
            elif rt.kind == types.Kind.bytes_:
                try self.put("kernel.bytes_length(")
                try self.use(receiver)
                try self.put(")")
            else:
                try self.put("kernel.list_length[")
                try self.type_of(rt.elem)
                try self.put("](")
                try self.use(receiver)
                try self.put(")")
            return
        if rt.kind == types.Kind.list_ and e.has(ast.flag_builtin):
            try self.put("kernel.list_first[" if e.text == "first" else "kernel.list_last[")
            try self.type_of(rt.elem)
            try self.put("](")
            try self.use(receiver)
            try self.put(")")
            return
        if rt.kind == types.Kind.error_value:
            if e.text == "message":
                # a text of its own, copied out of the `Error`'s view
                try self.put("kernel.text_of(")
                try self.expr(receiver)
                try self.put(".message)")
                return
            try self.expr(receiver)
            try self.put(".")
            try self.put(e.text)
            return
        let m = e.resolved else return try self.fail(e, "an unresolved member")
        if m.kind == ast.Kind.field:
            # a field read is a copy of its own (RUNTIME 4)
            let copies = self.checker.table.has_references(m.type_id)
            if copies:
                try self.put(try self.lifetime_name("L_copy_", m.type_id))
                try self.put("(")
            try self.use(receiver)
            try self.put(".L_")
            try self.put(e.text)
            if copies:
                try self.put(")")
            return
        if m.kind == ast.Kind.func_:
            # a bound method as a value: a closure over its receiver
            try self.put(try self.bound_name(e))
            try self.put("__new(")
            try self.owned(receiver)
            try self.put(")")
            return
        return try self.fail(e, "a member this slice does not compile")

    mutating func call(e: ast.Node*) -> !:
        let callee = e.left else return
        if callee.kind == ast.Kind.name and callee.resolved == none and self.checker.find_declaration(callee.text) == none:
            try self.core_call(e, callee.text)
            return
        if callee.kind == ast.Kind.member and callee.text == "package":
            let first = e.body else return
            let v = first.left else return
            try self.put("ErrorCode.package(")
            try self.put(v.text)
            try self.put(")")
            return
        if callee.kind == ast.Kind.case_value:
            try self.case_value(callee, e.body)
            return
        if callee.has(ast.flag_builtin):
            let k = self.checker.table.kind(callee.type_id)
            if k == types.Kind.map_ or k == types.Kind.set_:
                try self.map_method(e, callee, k == types.Kind.map_)
            elif k == types.Kind.str_ or k == types.Kind.bytes_:
                try self.text_method(e, callee)
            else:
                try self.list_method(e, callee)
            return
        if callee.kind == ast.Kind.member and callee.text == "get" and self.checker.table.kind(callee.type_id) == types.Kind.weak_:
            # `weak.get()`: the object with a reference of its own, or none (§10.4)
            let receiver = callee.left else return
            let elem = self.checker.table.get(callee.type_id).elem
            try self.put(try self.lifetime_name("L_weak_get_", elem))
            try self.put("(")
            try self.use(receiver)
            try self.put(")")
            return
        let d = e.resolved else return try self.call_value(e, callee)
        match d.kind:
            .enum_case:
                let owner = callee.left else return
                if let od = owner.resolved:
                    # the enum by its declaration: an instance of a generic one has its own name
                    try self.put("L_")
                    try self.put(self.type_name(od))
                else:
                    try self.expr(owner)
                try self.put(".L_")
                try self.put(d.text)
                try self.arguments(e, d.body, false, true)
            .struct_:
                try self.put("L_")
                try self.put(self.type_name(d))
                try self.arguments(e, d.body, false, true)
            .class_:
                # a class with defaults for every field and no `init`
                try self.put("L_")
                try self.put(self.type_name(d))
                try self.put("__new()")
            .func_:
                if d.text == "init":
                    let owner = callee.resolved else return try self.fail(e, "no class")
                    try self.put("L_")
                    try self.put(self.type_name(owner))
                    try self.put("__new")
                    try self.arguments(e, d.right, true, false)
                    return
                if check.has_self(d):
                    let receiver = callee.left else return
                    let owner = self.checker.table.get(receiver.type_id)
                    if owner.kind == types.Kind.enum_ or owner.kind == types.Kind.class_ or owner.kind == types.Kind.interface_:
                        try self.put("L_")
                        try self.put(owner.name)
                        try self.put("__L_")
                        try self.put(d.text)
                        try self.put("(")
                        try self.use(receiver)
                        if ast.count(d.right) > 1:
                            try self.put(", ")
                        try self.arguments_bare(e, d.right, true, false)
                        try self.put(")")
                        return
                    try self.use(receiver)
                    try self.put(".L_")
                    try self.put(d.text)
                    try self.arguments(e, d.right, true, false)
                    return
                if callee.kind == ast.Kind.member and (callee.left else return).type_id != 0 and self.checker.table.kind((callee.left else return).type_id) != types.Kind.module:
                    try self.expr(callee)
                else:
                    try self.put("L_")
                    try self.put(try self.decl_name(d))
                if d.has(ast.flag_base):
                    try self.base_arguments(e, d)
                    return
                try self.arguments(e, d.right, true, false)
            _: return try self.fail(e, "a call this slice does not compile")

    ## A list's own method (§11.1), one kernel call each.
    mutating func list_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let lt = self.checker.table.get(callee.type_id)
        let name = callee.text
        if name == "join":
            try self.put("kernel.list_join(")
        elif name == "map":
            try self.put("kernel.list_map[")
            try self.type_of(lt.elem)
            try self.put(", ")
            try self.type_of(self.checker.table.get(e.type_id).elem)
            try self.put("](")
        else:
            try self.put("kernel.list_")
            try self.put(name)
            try self.put("[")
            try self.type_of(lt.elem)
            try self.put("](")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            # a stored value is the list's own; anything else is borrowed for the call
            if name == "append" or name == "insert":
                try self.owned(v)
            else:
                try self.use(v)
            cursor = a.next
        if name == "map":
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(self.checker.table.get(e.type_id).elem))
        try self.put(")")

    ## A text's or bytes' own method (§11.3, §11.4), one kernel call each.
    mutating func text_method(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if callee.type_id == types.bytes_id:
            try self.put("kernel.decode_text(")
            try self.use(receiver)
            try self.put(")")
            return
        if name == "contains":
            try self.put("kernel.contains(")
        elif name == "bytes":
            try self.put("kernel.text_to_bytes(")
            try self.use(receiver)
            try self.put(")")
            return
        else:
            try self.put("kernel.")
            try self.put(name)
            try self.put("(")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            try self.use(v)
            cursor = a.next
        if name == "split" or name == "lines":
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(types.str_id))
        try self.put(")")

    ## `K, V` of a map, or `T, unit` of a set, as type arguments.
    mutating func map_types(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.type_of(t.elem)
        try self.put(", ")
        if t.kind == types.Kind.map_:
            try self.type_of(self.checker.table.map_value(id))
        else:
            try self.put("u8")

    ## A map's or a set's own method (§11.2), one kernel call each.
    mutating func map_method(e: ast.Node*, callee: ast.Node*, is_map: bool) -> !:
        let receiver = callee.left else return
        let name = callee.text
        if is_map or name == "clear" or name == "copy":
            try self.put("kernel.map_")
            try self.put(name)
        else:
            try self.put("kernel.set_")
            try self.put(name)
        try self.put("[")
        if is_map or name == "clear" or name == "copy":
            try self.map_types(callee.type_id)
        else:
            try self.type_of(self.checker.table.get(callee.type_id).elem)
        try self.put("](")
        try self.use(receiver)
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return
            try self.put(", ")
            if name == "insert":
                try self.owned(v)
            else:
                try self.use(v)
            cursor = a.next
        if name == "keys" or name == "values" or name == "items":
            # a new list: its descriptor and its element operations
            let result = self.checker.table.get(e.type_id)
            try self.put(", &")
            try self.put(try self.lifetime_name("L_info_", e.type_id))
            try self.put(", ")
            try self.put(try self.ops_name(result.elem))
        try self.put(")")

    ## A call through a function value: the closure's code, its object first (§7.4).
    mutating func call_value(e: ast.Node*, callee: ast.Node*) -> !:
        try self.put(try self.call_name(callee.type_id))
        try self.put("(")
        try self.use(callee)
        var cursor = e.body
        while let a = cursor:
            try self.put(", ")
            let v = a.left else return
            try self.use(v)
            cursor = a.next
        try self.put(")")

    ## `(a, b, c)` in parameter order, defaults filled in; a call borrows its arguments,
    ## a construction owns them (`own`).
    mutating func arguments(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        try self.put("(")
        try self.arguments_bare(e, params, skip_self, own)
        try self.put(")")

    mutating func arguments_bare(e: ast.Node*, params: ast.Node*?, skip_self: bool, own: bool) -> !:
        var hoisted = false
        if own:
            var a = e.body
            while let arg = a:
                if self.may_fail(arg.left):
                    hoisted = true
                a = arg.next
        if hoisted:
            # in source order, each argument a temporary; the defaults are constants
            var a = e.body
            while let arg = a:
                let v = arg.left else return
                arg.text = try self.hoist(v, true)
                a = arg.next
        var first = true
        var cursor = params
        while let p = cursor:
            if (p.kind == ast.Kind.param or p.kind == ast.Kind.field) and not (skip_self and p.text == "self"):
                if not first:
                    try self.put(", ")
                first = false
                var found = false
                var a = e.body
                while let arg = a:
                    if arg.resolved == p:
                        let v = arg.left else return
                        if hoisted:
                            try self.put(arg.text)
                        elif own:
                            try self.owned(v)
                        else:
                            try self.use(v)
                        found = true
                    a = arg.next
                if not found:
                    let d = p.left else return try self.fail(e, "a missing argument")
                    if own:
                        try self.owned(d)
                    else:
                        try self.use(d)
            cursor = p.next

    mutating func case_value(e: ast.Node*, args: ast.Node*?) -> !:
        let case_node = e.resolved else return try self.fail(e, "an unresolved case")
        var t = self.checker.table.get(e.type_id)
        if t.kind == types.Kind.optional:
            t = self.checker.table.get(t.elem)
        try self.put("L_")
        try self.put(t.name)
        try self.put(".L_")
        try self.put(case_node.text)
        if case_node.body != none:
            let saved = e.body
            e.body = args
            try self.arguments(e, case_node.body, false, true)
            e.body = saved

    ## The address of an object, or zero, as a `usize`.
    mutating func identity(e: ast.Node*) -> !:
        if e.kind == ast.Kind.literal and e.text == "none":
            try self.put("0")
            return
        try self.put(try self.lifetime_name("L_id_", e.type_id))
        try self.put("(")
        try self.use(e)
        try self.put(")")

    ## `print`, `assert`, `trap`, `error`, `discard`, the conversions.
    mutating func core_call(e: ast.Node*, name: str) -> !:
        if name == "print":
            try self.put("kernel.print_line(")
            let n = ast.count(e.body)
            if n == 1:
                let first = e.body else return
                let v = first.left else return
                try self.show(v)
            else:
                # the joined line is a fresh text of the statement's
                try self.put(try self.lifetime_name("L_pool_", types.str_id))
                try self.put("(kernel.join([")
                self.pooled = true
                var cursor = e.body
                var first = true
                while let a = cursor:
                    if not first:
                        try self.put(", ")
                        try self.put(try self.text_ref(" ", false))
                        try self.put(", ")
                    first = false
                    let v = a.left else return
                    try self.show(v)
                    cursor = a.next
                if n == 0:
                    try self.put(try self.text_ref("", false))
                try self.put("]))")
            try self.put(")")
            return
        let first = e.body else return
        let arg = first.left else return
        if name == "assert":
            # `if not c: trap("assert failed: m")`, the trap the interpreter reports
            try self.put("if not (")
            try self.use(arg)
            try self.put("): trap(")
            if let second = first.next:
                let m = second.left else return
                try self.put("kernel.concat(")
                try self.put(try self.text_ref("assert failed: ", false))
                try self.put(", ")
                try self.use(m)
                try self.put(").data")
            else:
                try self.put("\"assert failed\"")
            try self.put(")")
            return
        if name == "trap":
            try self.put("trap((")
            try self.use(arg)
            try self.put(").data)")
            return
        if name == "error":
            # the `Error` views its message: the text lives to the end of the run (RUNTIME)
            let second = first.next else return
            let m = second.left else return
            try self.put("error(")
            try self.use(arg)
            try self.put(", kernel.message_of(")
            try self.use(m)
            try self.put("))")
            return
        if name == "discard":
            try self.put("discard(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "Weak":
            try self.put("heap.weak_make((heap.Object*)")
            try self.use(arg)
            try self.put(")")
            return
        if name == "hash":
            try self.put("(i64)")
            try self.put(try self.hash_name(arg.type_id))
            try self.put("(")
            try self.use(arg)
            try self.put(")")
            return
        let t = arg.type_id
        if name == "int":
            try self.put("kernel.to_int(" if t == types.float_id else "kernel.parse_int(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "float":
            try self.put("f64(" if t == types.int_id else "kernel.parse_float(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "bool":
            try self.put("kernel.parse_bool(")
            try self.use(arg)
            try self.put(")")
            return
        if name == "str":
            try self.shown_value(arg)
            return
        return try self.fail(e, "a core call this slice does not compile")

    ## The display of a value as a piece of a line or a formatted text: a fresh text pooled
    ## until the statement ends, or the value itself when it is one.
    mutating func show(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.use(v)
            return
        try self.put(try self.lifetime_name("L_pool_", types.str_id))
        try self.put("(")
        try self.shown_value(v)
        try self.put(")")
        self.pooled = true

    ## The display of a value as an owned text: `str(x)`.
    mutating func shown_value(v: ast.Node*) -> !:
        let t = v.type_id
        if t == types.str_id:
            try self.owned(v)
            return
        try self.put(try self.show_name(t))
        try self.put("(")
        try self.use(v)
        try self.put(")")

    ## The function that displays a value of type `t`, emitted after the program.
    mutating func show_name(t: u32) -> str!:
        match self.checker.table.kind(t):
            .int_: return "kernel.show_int"
            .str_: return "kernel.show_text"
            .float_: return "kernel.show_float"
            .bool_: return "kernel.show_bool"
            .bytes_: return "kernel.show_bytes"
            .range_: return "kernel.show_range"
            _: discard(0)
        var i: usize = 0
        var seen = false
        while i < self.shown.count:
            if self.shown.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.shown.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"show_{t}"))

    ## The name of the copy, drop, trace, pool, identity or weak-get function of a type,
    ## which is emitted after the program.
    mutating func lifetime_name(prefix: str, t: u32) -> str!:
        var i: usize = 0
        var seen = false
        while i < self.lifetimes.count:
            if self.lifetimes.get(i) == t:
                seen = true
            i += 1
        if not seen:
            try self.lifetimes.push(t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"{prefix}{t}"))

    ## Every function and table the program's types need, each written once; writing one
    ## can register more, so the sets are walked until nothing new appears.
    mutating func support_functions() -> !:
        while true:
            let before = self.shown.count + self.lifetimes.count + self.equalities.count + self.orderings.count + self.hashes.count + self.ops_types.count + self.texts.count + self.lambdas.count + self.thunks.count + self.bounds.count + self.calls.count + self.cells.count + self.box_interfaces.count + self.crossings.count + self.callbacks.count + self.spawns.count + self.waits.count + self.sends.count
            let done = self.shown_done + self.lifetimes_done + self.equalities_done + self.orderings_done + self.hashes_done + self.ops_done + self.texts_done + self.lambdas_done + self.thunks_done + self.bounds_done + self.calls_done + self.cells_done + self.boxes_done + self.crossings_done + self.callbacks_done + self.spawns_done + self.waits_done + self.sends_done
            if before == done:
                return
            try self.show_functions()
            try self.lifetime_functions()
            try self.comparison_functions()
            try self.hash_functions()
            try self.ops_tables()
            try self.text_objects()
            try self.closure_support()
            try self.box_support()
            try self.boundary_support()
            try self.worker_support()

    ## `&L_text_N`: the immortal object of a literal, one per distinct text (RUNTIME).
    mutating func text_ref(text: str, as_bytes: bool) -> str!:
        var i: usize = 0
        var at = self.texts.count
        while i < self.texts.count:
            if self.texts.get(i) == text and self.texts_are_bytes.get(i) == as_bytes:
                at = i
                break
            i += 1
        if at == self.texts.count:
            try self.texts.push(try copy_name(text))
            try self.texts_are_bytes.push(as_bytes)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"&L_text_{at}"))

    mutating func text_objects() -> !:
        while self.texts_done < self.texts.count:
            let i = self.texts_done
            self.texts_done += 1
            let as_bytes = self.texts_are_bytes.get(i)
            try self.begin("var L_text_")
            try self.put_u64((u64)i)
            try self.put(": kernel.Bytes = kernel.Bytes(" if as_bytes else ": kernel.Text = kernel.Text(")
            try self.put("header = heap.Object(strong = 1073741824, weak = 0, flags = heap.immortal, info = &kernel.")
            try self.put("bytes_info" if as_bytes else "text_info")
            try self.put("), data = ")
            try self.text_literal(self.texts.get(i), as_bytes)
            try self.put(")")
            try self.end()

    ## The functions of every type holding references the program used, and of the types
    ## those reach; the list grows while it is walked.
    mutating func lifetime_functions() -> !:
        while self.lifetimes_done < self.lifetimes.count:
            let t = self.lifetimes.get(self.lifetimes_done)
            self.lifetimes_done += 1
            try self.lifetime_function_set(t)

    mutating func lifetime_function_set(id: u32) -> !:
        let t = self.checker.table.get(id)
        # copy: a reference of its own to every object held
        try self.lifetime_head("L_copy_", id, ") -> ", id)
        self.indent += 1
        match t.kind:
            .class_, .interface_, .list_, .map_, .set_, .str_, .bytes_, .func_, .task_:
                try self.begin("return (")
                try self.type_of(id)
                try self.put(")heap.retain((heap.Object*)v)")
                try self.end()
            .weak_: try self.line("return heap.weak_copy(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.lifetime_name("L_copy_", t.elem))
                try self.put("(inner)")
                try self.end()
                try self.line("return none")
            .tuple:
                try self.begin("return (")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.member_copy(t.args[i], "v.", i)
                    i += 1
                if t.args.length == 1:
                    try self.put(",")
                try self.put(")")
                try self.end()
            .struct_:
                try self.line("var out = v")
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("out.L_")
                        try self.put(m.text)
                        try self.put(" = ")
                        try self.put(try self.lifetime_name("L_copy_", m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        try self.begin(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        var p = m.body
                        var first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            p = field.next
                        try self.put("): return L_")
                        try self.put(t.name)
                        try self.put(".L_")
                        try self.put(m.text)
                        try self.put("(")
                        p = m.body
                        first = true
                        while let field = p:
                            if not first:
                                try self.put(", ")
                            first = false
                            try self.put("L_")
                            try self.put(field.text)
                            try self.put(" = ")
                            if self.checker.table.has_references(field.type_id):
                                try self.put(try self.lifetime_name("L_copy_", field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                            else:
                                try self.put("L_")
                                try self.put(field.text)
                            p = field.next
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("_: return v")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot copy")
        self.indent -= 1
        try self.line("")
        # drop and trace: every object held, a class field of zero (never assigned) skipped
        try self.lifetime_head("L_drop_", id, "):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_drop_", "")
        self.indent -= 1
        try self.line("")
        try self.lifetime_head("L_trace_", id, ", visit: func(heap.Object*, void*) -> unit, context: void*):", types.none_id)
        self.indent += 1
        try self.walk_references(t, id, "L_trace_", ", visit, context")
        self.indent -= 1
        try self.line("")
        # pool: a temporary of the statement, and the drop through a pointer it needs
        try self.lifetime_head("L_pool_", id, ") -> ", id)
        self.indent += 1
        if self.is_object_kind(t.kind):
            try self.begin("return (")
            try self.type_of(id)
            try self.put(")heap.pool_object((heap.Object*)v)")
            try self.end()
        else:
            try self.begin("return heap.pool_value[")
            try self.type_of(id)
            try self.put("](v, ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put(")")
            try self.end()
        self.indent -= 1
        try self.line("")
        if not self.is_object_kind(t.kind):
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_dropp_", id))
            try self.put("(p: void*):")
            try self.end()
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", id))
            try self.put("(memory.read[")
            try self.type_of(id)
            try self.put("](p))")
            try self.end()
            try self.line("")
        # identity, and a weak reference's get, for a class and its optional
        let inner = self.checker.table.kind(t.elem) if t.kind == types.Kind.optional else t.kind
        let identity_kinds = (self.is_object_kind(t.kind) and t.kind != types.Kind.str_ and t.kind != types.Kind.bytes_ and t.kind != types.Kind.func_) or (t.kind == types.Kind.optional and self.is_object_kind(inner) and inner != types.Kind.str_ and inner != types.Kind.bytes_ and inner != types.Kind.func_)
        if identity_kinds:
            try self.lifetime_head("L_id_", id, ") -> usize:", types.none_id)
            if t.kind != types.Kind.optional:
                try self.line("    return (usize)v")
            else:
                try self.line("    if let o = v:")
                try self.line("        return (usize)o")
                try self.line("    return 0")
            try self.line("")
        if t.kind == types.Kind.class_:
            try self.begin("func ")
            try self.put(try self.lifetime_name("L_weak_get_", id))
            try self.put("(w: heap.Weak) -> ")
            try self.type_of(id)
            try self.put("?:")
            try self.end()
            try self.line("    if let o = heap.weak_get(w):")
            try self.begin("        return (")
            try self.type_of(id)
            try self.put(")o")
            try self.end()
            try self.line("    return none")
            try self.line("")
        if t.kind == types.Kind.list_ or t.kind == types.Kind.map_ or t.kind == types.Kind.set_:
            try self.collection_support(id, t)

    func is_object_kind(k: types.Kind) -> bool:
        return k == types.Kind.class_ or k == types.Kind.interface_ or k == types.Kind.list_ or k == types.Kind.map_ or k == types.Kind.set_ or k == types.Kind.str_ or k == types.Kind.bytes_ or k == types.Kind.func_ or k == types.Kind.task_

    ## What a collection needs beside its lifetime functions: the runtime's descriptor and
    ## the drop and trace it calls; the element operations come per element type.
    mutating func collection_support(id: u32, t: types.Type) -> !:
        let drop = try self.lifetime_name("L_colldrop_", id)
        let trace = try self.lifetime_name("L_colltrace_", id)
        let is_list = t.kind == types.Kind.list_
        try self.begin("func ")
        try self.put(drop)
        try self.put("(o: heap.Object*):")
        try self.end()
        try self.begin("    kernel.list_drop[" if is_list else "    kernel.map_drop[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o)")
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(trace)
        try self.put("(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    kernel.list_trace[" if is_list else "    kernel.map_trace[")
        if is_list:
            try self.type_of(t.elem)
        else:
            try self.map_types(id)
        try self.put("](o, visit, context)")
        try self.end()
        try self.line("")
        try self.begin("var ")
        try self.put(try self.lifetime_name("L_info_", id))
        try self.put(": heap.Info = heap.Info(name = \"")
        try self.put("list" if is_list else "map" if t.kind == types.Kind.map_ else "set")
        try self.put("\", size = sizeof(")
        try self.type_of_object(id)
        try self.put("), finish = none, drop = ")
        try self.put(drop)
        try self.put(", trace = ")
        try self.put(trace)
        try self.put(")")
        try self.end()
        try self.line("")
        discard(try self.ops_name(t.elem))
        if t.kind == types.Kind.map_:
            discard(try self.ops_name(self.checker.table.map_value(id)))

    ## The collection's Base struct, `kernel.List[T]` without the star.
    mutating func type_of_object(id: u32) -> !:
        let start = self.out.used
        try self.type_of(id)
        let text = try self.capture(start)
        try self.put((str)text.bytes[..<text.length - 1])

    ## The operations table of an element type, emitted after the program.
    mutating func ops_name(t: u32) -> str!:
        try self.remember(&self.ops_types, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_ops_{t}"))

    mutating func ops_tables() -> !:
        while self.ops_done < self.ops_types.count:
            let elem = self.ops_types.get(self.ops_done)
            self.ops_done += 1
            try self.begin("var ")
            try self.put(try self.ops_name(elem))
            try self.put(": kernel.Ops[")
            try self.type_of(elem)
            try self.put("] = kernel.Ops[")
            try self.type_of(elem)
            try self.put("](copy = ")
            let holds = self.checker.table.has_references(elem)
            try self.put(try self.lifetime_name("L_copy_", elem) if holds else "none")
            try self.put(", drop = ")
            try self.put(try self.lifetime_name("L_drop_", elem) if holds else "none")
            try self.put(", trace = ")
            try self.put(try self.lifetime_name("L_trace_", elem) if holds else "none")
            try self.put(", equal = ")
            let equatable = bodies.equatable(self.checker, elem)
            try self.put(try self.equality_name(elem) if equatable else "none")
            try self.put(", compare = ")
            try self.put(try self.ordering_name(elem) if bodies.orderable(self.checker, elem) else "none")
            try self.put(", hashed = ")
            try self.put(try self.hash_name(elem) if bodies.hashable(self.checker, elem) else "none")
            try self.put(")")
            try self.end()

    # -- closures (§7.4) ------------------------------------------------------------------

    mutating func lambda_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.lambdas.count
        while i < self.lambdas.count:
            if self.lambdas.get(i) == e:
                at = i
            i += 1
        if at == self.lambdas.count:
            try self.lambdas.push(e)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_lambda_{at}"))

    mutating func thunk_name(d: ast.Node*, prefix: str) -> str!:
        var i: usize = 0
        var at = self.thunks.count
        while i < self.thunks.count:
            if self.thunks.get(i) == d:
                at = i
            i += 1
        if at == self.thunks.count:
            try self.thunks.push(d)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"{prefix}{at}"))

    mutating func bound_name(e: ast.Node*) -> str!:
        var i: usize = 0
        var at = self.bounds.count
        while i < self.bounds.count:
            if self.bounds.get(i) == e:
                at = i
            i += 1
        if at == self.bounds.count:
            try self.bounds.push(e)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_bound_{at}"))

    mutating func call_name(t: u32) -> str!:
        try self.remember(&self.calls, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_call_{t}"))

    mutating func cell_info_name(t: u32) -> str!:
        try self.remember(&self.cells, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_cellinfo_{t}"))

    mutating func closure_support() -> !:
        while self.calls_done < self.calls.count:
            let t = self.calls.get(self.calls_done)
            self.calls_done += 1
            try self.call_helper(t)
        while self.cells_done < self.cells.count:
            let t = self.cells.get(self.cells_done)
            self.cells_done += 1
            try self.cell_support(t)
        while self.thunks_done < self.thunks.count:
            let d = self.thunks.get(self.thunks_done)
            self.thunks_done += 1
            try self.thunk(d)
        while self.bounds_done < self.bounds.count:
            let e = self.bounds.get(self.bounds_done)
            self.bounds_done += 1
            try self.bound_method(e)
        while self.lambdas_done < self.lambdas.count:
            let e = self.lambdas.get(self.lambdas_done)
            self.lambdas_done += 1
            try self.lambda_object(e)

    ## `L_call_N(f, args...)`: the closure's code cast to its shape and called with the
    ## object first.
    mutating func call_helper(t: u32) -> !:
        let ft = self.checker.table.get(t)
        try self.begin("func ")
        try self.put(try self.call_name(t))
        try self.put("(f: kernel.Closure*")
        var i: usize = 0
        while i < ft.args.length:
            try self.put(", a")
            try self.put_u64((u64)i)
            try self.put(": ")
            try self.type_of(ft.args[i])
            i += 1
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.begin("    ")
        if ft.elem != types.unit_id:
            try self.put("return ")
        try self.put("((func(heap.Object*")
        i = 0
        while i < ft.args.length:
            try self.put(", ")
            try self.type_of(ft.args[i])
            i += 1
        try self.put(")")
        # a function type spells its result, `unit` included
        if ft.elem == types.unit_id:
            try self.put(" -> unit")
        else:
            try self.result_type(ft.elem)
        try self.put(")f.code)((heap.Object*)f")
        i = 0
        while i < ft.args.length:
            try self.put(", a")
            try self.put_u64((u64)i)
            i += 1
        try self.put(")")
        try self.end()
        try self.line("")

    ## ` -> R`, ` -> R!`, ` -> !`, or nothing for `unit`.
    mutating func result_type(r: u32) -> !:
        if r == types.unit_id:
            return
        if self.checker.table.kind(r) == types.Kind.fallible and self.checker.table.get(r).elem == types.unit_id:
            try self.put(" -> !")
            return
        try self.put(" -> ")
        try self.type_of(r)

    ## The descriptor of a cell holding a `T`, and the drop and trace it calls.
    mutating func cell_support(t: u32) -> !:
        let name = try self.cell_info_name(t)
        try self.begin("func ")
        try self.put(name)
        try self.put("_drop(o: heap.Object*):")
        try self.end()
        try self.begin("    kernel.cell_drop[")
        try self.type_of(t)
        try self.put("](o)")
        try self.end()
        try self.begin("func ")
        try self.put(name)
        try self.put("_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    kernel.cell_trace[")
        try self.type_of(t)
        try self.put("](o, visit, context)")
        try self.end()
        try self.begin("var ")
        try self.put(name)
        try self.put(": heap.Info = heap.Info(name = \"cell\", size = sizeof(kernel.Cell[")
        try self.type_of(t)
        try self.put("]), finish = none, drop = ")
        try self.put(name)
        try self.put("_drop, trace = ")
        try self.put(name)
        try self.put("_trace)")
        try self.end()
        try self.line("")

    ## A named function as a value: a thunk taking the closure first, and an immortal
    ## closure whose code it is.
    mutating func thunk(d: ast.Node*) -> !:
        let ft = self.checker.table.get(d.type_id)
        let name = try self.thunk_name(d, "L_thunk_")
        try self.begin("func ")
        try self.put(name)
        try self.put("(env: heap.Object*")
        var i: usize = 0
        var cursor = d.right
        while let p = cursor:
            try self.put(", L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.line("    discard(env)")
        try self.begin("    ")
        if ft.elem != types.unit_id:
            try self.put("return ")
        try self.put("L_")
        try self.put(try self.decl_name(d))
        try self.put("(")
        cursor = d.right
        var first = true
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(p.text)
            cursor = p.next
        try self.put(")")
        try self.end()
        try self.begin("var ")
        try self.put(try self.thunk_name(d, "L_fn_"))
        try self.put(": kernel.Closure = kernel.Closure(header = heap.Object(strong = 1073741824, weak = 0, flags = heap.immortal, info = &kernel.closure_info), code = (void*)")
        try self.put(name)
        try self.put(")")
        try self.end()
        try self.line("")

    ## A method bound to its receiver as a value: an object holding the receiver, a thunk
    ## calling the method on it, and the constructor.
    mutating func bound_method(e: ast.Node*) -> !:
        let receiver = e.left else return
        let m = e.resolved else return
        let name = try self.bound_name(e)
        let rt = receiver.type_id
        let owner = self.checker.table.get(rt)
        let ft = self.checker.table.get(m.type_id)
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.line("    var code: void*")
        try self.begin("    var L_self: ")
        try self.type_of(rt)
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        if self.checker.table.has_references(rt):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_drop_", rt))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).L_self)")
            try self.end()
        else:
            try self.line("    discard(o)")
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        if self.checker.table.has_references(rt):
            try self.begin("    ")
            try self.put(try self.lifetime_name("L_trace_", rt))
            try self.put("(((")
            try self.put(name)
            try self.put("*)o).L_self, visit, context)")
            try self.end()
        else:
            try self.line("    discard(o)")
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"method\", size = sizeof(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        try self.begin("func ")
        try self.put(name)
        try self.put("__code(env: heap.Object*")
        var cursor = m.right
        while let p = cursor:
            if p.text != "self":
                try self.put(", L_")
                try self.put(p.text)
                try self.put(": ")
                try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        try self.begin("    ")
        if ft.elem != types.unit_id:
            try self.put("return ")
        if owner.kind == types.Kind.class_ or owner.kind == types.Kind.enum_ or owner.kind == types.Kind.interface_:
            try self.put("L_")
            try self.put(owner.name)
            try self.put("__L_")
            try self.put(m.text)
            try self.put("(((")
            try self.put(name)
            try self.put("*)env).L_self")
            cursor = m.right
            while let p = cursor:
                if p.text != "self":
                    try self.put(", L_")
                    try self.put(p.text)
                cursor = p.next
            try self.put(")")
        else:
            try self.put("((")
            try self.put(name)
            try self.put("*)env).L_self.L_")
            try self.put(m.text)
            try self.put("(")
            cursor = m.right
            var first = true
            while let p = cursor:
                if p.text != "self":
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put("L_")
                    try self.put(p.text)
                cursor = p.next
            try self.put(")")
        try self.end()
        try self.begin("func ")
        try self.put(name)
        try self.put("__new(L_self: ")
        try self.type_of(rt)
        try self.put(") -> kernel.Closure*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.begin("    o.code = (void*)")
        try self.put(name)
        try self.put("__code")
        try self.end()
        try self.line("    o.L_self = L_self")
        try self.line("    return (kernel.Closure*)o")
        try self.line("")

    ## A lambda: its object over its captures, the descriptor, its body as a function
    ## taking the object first, and its constructor taking the captures.
    mutating func lambda_object(e: ast.Node*) -> !:
        let name = try self.lambda_name(e)
        let ft = self.checker.table.get(e.type_id)
        try self.begin("struct ")
        try self.put(name)
        try self.put(":")
        try self.end()
        try self.line("    var header: heap.Object")
        try self.line("    var code: void*")
        var cursor = e.left
        while let capture = cursor:
            try self.begin("    var L_")
            try self.put(capture.text)
            try self.put(": ")
            try self.capture_type(capture)
            try self.end()
            cursor = capture.next
        try self.line("")
        # drop and trace over the captures
        try self.begin("func ")
        try self.put(name)
        try self.put("__drop(o: heap.Object*):")
        try self.end()
        try self.begin("    let L_env = (")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        try self.line("    discard(L_env)")
        cursor = e.left
        while let capture = cursor:
            if capture.has(ast.flag_var_field):
                try self.begin("    if (usize)L_env.L_")
                try self.put(capture.text)
                try self.put(" != 0:")
                try self.end()
                try self.begin("        heap.release((heap.Object*)L_env.L_")
                try self.put(capture.text)
                try self.put(")")
                try self.end()
            elif self.checker.table.has_references(capture.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_drop_", capture.type_id))
                try self.put("(L_env.L_")
                try self.put(capture.text)
                try self.put(")")
                try self.end()
            cursor = capture.next
        try self.begin("func ")
        try self.put(name)
        try self.put("__trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):")
        try self.end()
        try self.begin("    let L_env = (")
        try self.put(name)
        try self.put("*)o")
        try self.end()
        try self.line("    discard(L_env)")
        cursor = e.left
        while let capture = cursor:
            if capture.has(ast.flag_var_field):
                try self.begin("    if (usize)L_env.L_")
                try self.put(capture.text)
                try self.put(" != 0:")
                try self.end()
                try self.begin("        visit((heap.Object*)L_env.L_")
                try self.put(capture.text)
                try self.put(", context)")
                try self.end()
            elif self.checker.table.has_references(capture.type_id):
                try self.begin("    ")
                try self.put(try self.lifetime_name("L_trace_", capture.type_id))
                try self.put("(L_env.L_")
                try self.put(capture.text)
                try self.put(", visit, context)")
                try self.end()
            cursor = capture.next
        try self.begin("var ")
        try self.put(name)
        try self.put("__info: heap.Info = heap.Info(name = \"closure\", size = sizeof(")
        try self.put(name)
        try self.put("), finish = none, drop = ")
        try self.put(name)
        try self.put("__drop, trace = ")
        try self.put(name)
        try self.put("__trace)")
        try self.end()
        # the body, over the object first
        try self.begin("func ")
        try self.put(name)
        try self.put("__code(env: heap.Object*")
        cursor = e.right
        while let p = cursor:
            try self.put(", L_")
            try self.put(p.text)
            try self.put(": ")
            try self.type_of(p.type_id)
            cursor = p.next
        try self.put(")")
        try self.result_type(ft.elem)
        try self.put(":")
        try self.end()
        self.indent += 1
        try self.begin("let L_env = (")
        try self.put(name)
        try self.put("*)env")
        try self.end()
        try self.line("discard(L_env)")
        let saved_lambda = self.lambda
        let saved_self = self.self_name
        let saved_fallible = self.fallible
        self.lambda = e
        self.fallible = self.checker.table.kind(ft.elem) == types.Kind.fallible
        var captures_self = false
        cursor = e.left
        while let capture = cursor:
            if capture.text == "self":
                captures_self = true
            cursor = capture.next
        if captures_self:
            self.self_name = "L_env.L_self"
        let body = e.body else return
        try self.site_prologue()
        if e.has(ast.flag_block_lambda):
            try self.block(body)
        else:
            # an expression lambda: its value returned, its temporaries drained first; the
            # body is the statement a trap in it names
            try self.position_lines(body)
            let start = self.out.used
            let pooled_before = self.pooled
            self.pooled = false
            try self.owned(body)
            let text = try self.capture(start)
            if self.pooled:
                let r = try self.temp("result")
                try self.begin("let ")
                try self.put(r)
                try self.put(" = ")
                try self.put(text)
                try self.end()
                try self.drained(start, pooled_before)
                self.pooled = false
                try self.begin("return ")
                try self.put(r)
                try self.end()
            else:
                self.pooled = pooled_before
                try self.begin("return ")
                try self.put(text)
                try self.end()
        try self.line("#:")
        self.lambda = saved_lambda
        self.self_name = saved_self
        self.fallible = saved_fallible
        self.indent -= 1
        # the constructor, taking every capture as the closure's own
        try self.begin("func ")
        try self.put(name)
        try self.put("__new(")
        cursor = e.left
        var first = true
        while let capture = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put("L_")
            try self.put(capture.text)
            try self.put(": ")
            try self.capture_type(capture)
            cursor = capture.next
        try self.put(") -> kernel.Closure*:")
        try self.end()
        try self.begin("    let o = (")
        try self.put(name)
        try self.put("*)heap.allocate(&")
        try self.put(name)
        try self.put("__info)")
        try self.end()
        try self.begin("    o.code = (void*)")
        try self.put(name)
        try self.put("__code")
        try self.end()
        cursor = e.left
        while let capture = cursor:
            try self.begin("    o.L_")
            try self.put(capture.text)
            try self.put(" = L_")
            try self.put(capture.text)
            try self.end()
            cursor = capture.next
        try self.line("    return (kernel.Closure*)o")
        try self.line("")

    ## A captured `let`'s type, or the cell of a captured `var`.
    mutating func capture_type(capture: ast.Node*) -> !:
        if capture.has(ast.flag_var_field):
            try self.put("kernel.Cell[")
            try self.type_of(capture.type_id)
            try self.put("]*")
            discard(try self.cell_info_name(capture.type_id))
            discard(try self.ops_name(capture.type_id))
        else:
            try self.type_of(capture.type_id)

    # -- hashing ------------------------------------------------------------------------

    ## The function hashing a value of the type from the runtime's offset, and the one
    ## folding it into a hash so far (docs/RUNTIME.md).
    mutating func hash_name(t: u32) -> str!:
        try self.remember(&self.hashes, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_hash_{t}"))

    mutating func hash_in_name(t: u32) -> str!:
        try self.remember(&self.hashes, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_hashin_{t}"))

    mutating func hash_functions() -> !:
        while self.hashes_done < self.hashes.count:
            let t = self.hashes.get(self.hashes_done)
            self.hashes_done += 1
            try self.hash_function(t)

    mutating func hash_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.hash_name(id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> u64:")
        try self.end()
        try self.begin("    return ")
        try self.put(try self.hash_in_name(id))
        try self.put("(kernel.hash_offset, v)")
        try self.end()
        try self.line("")
        try self.begin("func ")
        try self.put(try self.hash_in_name(id))
        try self.put("(h: u64, v: ")
        try self.type_of(id)
        try self.put(") -> u64:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Hashable", "hashed"):
            try self.begin("return kernel.hash_int(h, ")
            try self.method_on(id, m, "v")
            try self.put("))")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .int_: try self.line("return kernel.hash_int(h, v)")
            .float_: try self.line("return kernel.hash_float(h, v)")
            .bool_: try self.line("return kernel.hash_bool(h, v)")
            .str_: try self.line("return kernel.hash_text(h, v)")
            .bytes_: try self.line("return kernel.hash_blob(h, v)")
            .unit_: try self.line("return h")
            .error_code: try self.line("return kernel.hash_int(h, (i64)v)")
            .range_: try self.line("return kernel.hash_range(h, v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.hash_in_name(t.elem))
                try self.put("(kernel.hash_byte(h, 1), inner)")
                try self.end()
                try self.line("return kernel.hash_byte(h, 0)")
            .tuple:
                try self.line("var out = h")
                var i: usize = 0
                while i < t.args.length:
                    try self.begin("out = ")
                    try self.put(try self.hash_in_name(t.args[i]))
                    try self.put("(out, v.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    try self.end()
                    i += 1
                try self.line("return out")
            .struct_:
                let d = t.decl else return
                try self.line("var out = h")
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        try self.begin("out = ")
                        try self.put(try self.hash_in_name(m.type_id))
                        try self.put("(out, v.L_")
                        try self.put(m.text)
                        try self.put(")")
                        try self.end()
                    cursor = m.next
                try self.line("return out")
            .enum_:
                let d = t.decl else return
                try self.line("match v:")
                self.indent += 1
                var index: i64 = 0
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        self.indent += 1
                        try self.begin("var out = kernel.hash_int(h, ")
                        try self.put_u64((u64)index)
                        try self.put(")")
                        try self.end()
                        var p = m.body
                        while let field = p:
                            try self.begin("out = ")
                            try self.put(try self.hash_in_name(field.type_id))
                            try self.put("(out, L_")
                            try self.put(field.text)
                            try self.put(")")
                            try self.end()
                            p = field.next
                        try self.line("return out")
                        self.indent -= 1
                        index += 1
                    cursor = m.next
                self.indent -= 1
            .list_:
                try self.line("var out = h")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    out = ")
                try self.put(try self.hash_in_name(t.elem))
                try self.put("(out, v.items[i])")
                try self.end()
                try self.line("    i += 1")
                try self.line("return out")
            .set_:
                try self.begin("return kernel.hash_int(h, (i64)kernel.set_hash[")
                try self.type_of(t.elem)
                try self.put("](v))")
                try self.end()
            .map_:
                try self.begin("return kernel.hash_int(h, (i64)kernel.map_hash[")
                try self.map_types(id)
                try self.put("](v))")
                try self.end()
            _: return try self.fail(t.decl else self.checker.tree(), "a type the emitter cannot hash")
        self.indent -= 1
        try self.line("")

    # -- equality and ordering functions ------------------------------------------------

    ## The method a type declares for a closed protocol (§13.3), if it declares one.
    func protocol_method(id: u32, protocol: str, method: str) -> ast.Node*?:
        let t = self.checker.table.get(id)
        if t.kind != types.Kind.struct_ and t.kind != types.Kind.class_ and t.kind != types.Kind.enum_:
            return none
        let d = t.decl else return none
        let iface = self.checker.find_declaration(protocol) else return none
        var cursor = d.right
        while let conformance = cursor:
            if conformance.type_id == iface.type_id:
                return self.checker.find_member(d, method)
            cursor = conformance.next
        return none

    ## The name a type declaration is written under: its type's, qualified by its module
    ## when it is not the entry module's (§15).
    func type_name(d: ast.Node*) -> str:
        return self.checker.table.get(d.type_id).name

    ## The name a function or constant is written under.
    func decl_name(d: ast.Node*) -> str!:
        return try self.checker.emitted_name(d)

    ## The expression written out as a value used and let go of, as text.
    mutating func used(e: ast.Node*) -> str!:
        let start = self.out.used
        try self.use(e)
        let text = try self.capture(start)
        return text

    ## `L_T__L_m(a` for a class or an enum, `a.L_m(` for a struct: the receiver goes
    ## first, and the caller writes the arguments and the closing parenthesis.
    mutating func method_on(id: u32, m: ast.Node*, receiver: str) -> !:
        let t = self.checker.table.get(id)
        if t.kind == types.Kind.class_ or t.kind == types.Kind.enum_ or t.kind == types.Kind.interface_:
            try self.put("L_")
            try self.put(t.name)
            try self.put("__L_")
            try self.put(m.text)
            try self.put("(")
            try self.put(receiver)
            return
        try self.put(receiver)
        try self.put(".L_")
        try self.put(m.text)
        try self.put("(")

    ## Whether `==` on the type is a call: a collection, or a value holding one, since Base's
    ## own `==` on the pointer would compare identity; a declared `equals` too.
    func needs_equality(id: u32) -> bool:
        return self.equality_at(id, 0)

    func equality_at(id: u32, depth: u32) -> bool:
        if depth > 32:
            return true
        let k = self.checker.table.kind(id)
        if k == types.Kind.struct_ or k == types.Kind.enum_:
            let fresh = self.checker.entering(id) catch failure: recover false
            if not fresh:
                return true
            let answer = self.equality_walk(id, depth)
            self.checker.leave_walk()
            return answer
        return self.equality_walk(id, depth)

    func equality_walk(id: u32, depth: u32) -> bool:
        if self.protocol_method(id, "Equatable", "equals") != none:
            return true
        let t = self.checker.table.get(id)
        match t.kind:
            .list_, .map_, .set_, .bytes_, .str_: return true
            .optional: return self.equality_at(t.elem, depth + 1)
            .tuple:
                for m in t.args:
                    if self.equality_at(m, depth + 1):
                        return true
                return false
            .struct_, .enum_:
                let d = t.decl else return false
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.equality_at(m.type_id, depth + 1):
                        return true
                    if m.kind == ast.Kind.enum_case:
                        var p = m.body
                        while let field = p:
                            if self.equality_at(field.type_id, depth + 1):
                                return true
                            p = field.next
                    cursor = m.next
                return false
            _: return false

    ## The function comparing two values of the type for equality, emitted after the
    ## program.
    mutating func equality_name(t: u32) -> str!:
        try self.remember(&self.equalities, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_eq_{t}"))

    ## The function ordering two values of the type: -1, 0, 1.
    mutating func ordering_name(t: u32) -> str!:
        try self.remember(&self.orderings, t)
        let half = self.checker.scratch.length // 2
        return try copy_name(try format(self.checker.scratch[half..], f"L_cmp_{t}"))

    mutating func remember(where: list.List[u32]*, t: u32) -> !:
        var i: usize = 0
        while i < where.count:
            if where.get(i) == t:
                return
            i += 1
        try where.push(t)

    mutating func comparison_functions() -> !:
        while self.equalities_done < self.equalities.count:
            let t = self.equalities.get(self.equalities_done)
            self.equalities_done += 1
            try self.equality_function(t)
        while self.orderings_done < self.orderings.count:
            let t = self.orderings.get(self.orderings_done)
            self.orderings_done += 1
            try self.ordering_function(t)

    mutating func equality_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.equality_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> bool:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Equatable", "equals"):
            try self.begin("return ")
            try self.method_on(id, m, "a")
            try self.put("b)" if t.kind == types.Kind.struct_ else ", b)")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .list_:
                try self.begin("return kernel.list_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .map_:
                try self.begin("return kernel.map_equal[")
                try self.map_types(id)
                try self.put("](a, b)")
                try self.end()
            .set_:
                try self.begin("return kernel.set_equal[")
                try self.type_of(t.elem)
                try self.put("](a, b)")
                try self.end()
            .bytes_: try self.line("return kernel.bytes_equal(a, b)")
            .str_: try self.line("return kernel.text_equal(a, b)")
            .optional:
                try self.line("if let x = a:")
                try self.line("    if let y = b:")
                try self.begin("        return ")
                try self.put(try self.member_equality(t.elem, "x", "y"))
                try self.end()
                try self.line("    return false")
                try self.line("return b == none")
            .tuple:
                try self.begin("return ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(" and ")
                    let half = self.checker.scratch.length // 2
                    let x = try copy_name(try format(self.checker.scratch[half..], f"a.{i}"))
                    let y = try copy_name(try format(self.checker.scratch[half..], f"b.{i}"))
                    try self.put(try self.member_equality(t.args[i], x, y))
                    i += 1
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.begin("return ")
                var cursor = d.body
                var first = true
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        if not first:
                            try self.put(" and ")
                        first = false
                        let half = self.checker.scratch.length // 2
                        let x = try copy_name(try format(self.checker.scratch[half..], f"a.L_{m.text}"))
                        let y = try copy_name(try format(self.checker.scratch[half..], f"b.L_{m.text}"))
                        try self.put(try self.member_equality(m.type_id, x, y))
                    cursor = m.next
                if first:
                    try self.put("true")
                try self.end()
            .enum_:
                let d = t.decl else return
                try self.line("match a:")
                self.indent += 1
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("x_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        self.indent += 1
                        try self.line("match b:")
                        try self.begin("    .L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("y_")
                                try self.put(field.text)
                                p = field.next
                            try self.put("): return ")
                            p = m.body
                            first = true
                            while let field = p:
                                if not first:
                                    try self.put(" and ")
                                first = false
                                let half = self.checker.scratch.length // 2
                                let x = try copy_name(try format(self.checker.scratch[half..], f"x_{field.text}"))
                                let y = try copy_name(try format(self.checker.scratch[half..], f"y_{field.text}"))
                                try self.put(try self.member_equality(field.type_id, x, y))
                                p = field.next
                        else:
                            try self.put(": return true")
                        try self.end()
                        try self.line("    _: return false")
                        self.indent -= 1
                    cursor = m.next
                self.indent -= 1
            _: try self.line("return a == b")
        self.indent -= 1
        try self.line("")

    ## `x == y` as text, through the type's function where it needs one.
    mutating func member_equality(t: u32, x: str, y: str) -> str!:
        let half = self.checker.scratch.length // 2
        if self.needs_equality(t):
            return try copy_name(try format(self.checker.scratch[half..], f"{try self.equality_name(t)}({x}, {y})"))
        return try copy_name(try format(self.checker.scratch[half..], f"({x} == {y})"))

    mutating func ordering_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        try self.begin("func ")
        try self.put(try self.ordering_name(id))
        try self.put("(a: ")
        try self.type_of(id)
        try self.put(", b: ")
        try self.type_of(id)
        try self.put(") -> i64:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Ordered", "compare"):
            try self.begin("return ")
            try self.method_on(id, m, "a")
            try self.put("b)" if t.kind == types.Kind.struct_ else ", b)")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .int_, .float_, .bool_: try self.line("return -1 if a < b else 1 if a > b else 0")
            .str_: try self.line("return kernel.compare_text(a, b)")
            .bytes_: try self.line("return kernel.compare_blobs(a, b)")
            .tuple:
                var i: usize = 0
                while i < t.args.length:
                    let c = try self.temp("c")
                    try self.begin("let ")
                    try self.put(c)
                    try self.put(" = ")
                    try self.put(try self.ordering_name(t.args[i]))
                    try self.put("(a.")
                    try self.put_u64((u64)i)
                    try self.put(", b.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    try self.end()
                    try self.begin("if ")
                    try self.put(c)
                    try self.put(" != 0:")
                    try self.end()
                    try self.begin("    return ")
                    try self.put(c)
                    try self.end()
                    i += 1
                try self.line("return 0")
            _: return try self.fail(self.checker.tree(), "a type the emitter cannot order")
        self.indent -= 1
        try self.line("")

    ## `func NAME(v: T` and what follows; a result type when `result` is given.
    mutating func lifetime_head(prefix: str, id: u32, tail: str, result: u32) -> !:
        try self.begin("func ")
        try self.put(try self.lifetime_name(prefix, id))
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(tail)
        if result != types.none_id:
            try self.type_of(result)
            try self.put(":")
        try self.end()

    ## One member of a tuple copy: copied when it holds references.
    mutating func member_copy(t: u32, prefix: str, i: usize) -> !:
        if self.checker.table.has_references(t):
            try self.put(try self.lifetime_name("L_copy_", t))
            try self.put("(")
            try self.put(prefix)
            try self.put_u64((u64)i)
            try self.put(")")
        else:
            try self.put(prefix)
            try self.put_u64((u64)i)

    ## The body of a drop or trace: the call `prefix` on every part holding references,
    ## `extra` appended to the arguments.
    mutating func walk_references(t: types.Type, id: u32, prefix: str, extra: str) -> !:
        match t.kind:
            .str_, .bytes_:
                # a text holds no references: released, never traced
                if prefix == "L_drop_":
                    try self.line("if (usize)v != 0:")
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("discard(v)")
            .class_, .interface_, .list_, .map_, .set_, .func_, .task_:
                try self.line("if (usize)v != 0:")
                if prefix == "L_drop_":
                    try self.line("    heap.release((heap.Object*)v)")
                else:
                    try self.line("    visit((heap.Object*)v, context)")
            .weak_:
                if prefix == "L_drop_":
                    try self.line("heap.weak_drop(v)")
                else:
                    try self.line("discard(v)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    ")
                try self.put(try self.lifetime_name(prefix, t.elem))
                try self.put("(inner")
                try self.put(extra)
                try self.put(")")
                try self.end()
            .tuple:
                var i: usize = 0
                var any = false
                while i < t.args.length:
                    if self.checker.table.has_references(t.args[i]):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, t.args[i]))
                        try self.put("(v.")
                        try self.put_u64((u64)i)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    i += 1
                if not any:
                    try self.line("discard(v)")
            .struct_:
                let d = t.decl else return
                var cursor = d.body
                var any = false
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.checker.table.has_references(m.type_id):
                        try self.begin("")
                        try self.put(try self.lifetime_name(prefix, m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(extra)
                        try self.put(")")
                        try self.end()
                        any = true
                    cursor = m.next
                if not any:
                    try self.line("discard(v)")
            .enum_:
                try self.line("match v:")
                self.indent += 1
                let d = t.decl else return
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        var holds = false
                        var p = m.body
                        while let field = p:
                            if self.checker.table.has_references(field.type_id):
                                holds = true
                            p = field.next
                        if holds:
                            try self.begin(".L_")
                            try self.put(m.text)
                            try self.put("(")
                            p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                if self.checker.table.has_references(field.type_id):
                                    try self.put("L_")
                                    try self.put(field.text)
                                else:
                                    try self.put("_")
                                p = field.next
                            try self.put("):")
                            try self.end()
                            self.indent += 1
                            p = m.body
                            while let field = p:
                                if self.checker.table.has_references(field.type_id):
                                    try self.begin("")
                                    try self.put(try self.lifetime_name(prefix, field.type_id))
                                    try self.put("(L_")
                                    try self.put(field.text)
                                    try self.put(extra)
                                    try self.put(")")
                                    try self.end()
                                p = field.next
                            self.indent -= 1
                    cursor = m.next
                try self.line("_: discard(0)")
                self.indent -= 1
            _: return try self.fail(t.decl else self.checker.tree(), "a type whose references the emitter cannot walk")

    mutating func show_functions() -> !:
        while self.shown_done < self.shown.count:
            let t = self.shown.get(self.shown_done)
            self.shown_done += 1
            try self.show_function(t)

    mutating func show_function(id: u32) -> !:
        let t = self.checker.table.get(id)
        let name = try self.show_name(id)
        try self.begin("func ")
        try self.put(name)
        try self.put("(v: ")
        try self.type_of(id)
        try self.put(") -> kernel.Text*:")
        try self.end()
        self.indent += 1
        if let m = self.protocol_method(id, "Display", "display"):
            try self.begin("return ")
            try self.method_on(id, m, "v")
            try self.put(")")
            try self.end()
            self.indent -= 1
            try self.line("")
            return
        match t.kind:
            .list_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.items[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"[\", \"]\")")
            .set_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.add_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .map_:
                try self.line("var parts = kernel.parts()")
                try self.line("var i: usize = 0")
                try self.line("while i < v.count:")
                try self.begin("    kernel.pair_part(&parts, ")
                try self.put(try self.show_name(t.elem))
                try self.put("(v.keys[i]), ")
                try self.put(try self.show_name(self.checker.table.map_value(id)))
                try self.put("(v.values[i]))")
                try self.end()
                try self.line("    i += 1")
                try self.line("return kernel.bracketed(parts, \"{\", \"}\")")
            .unit_:
                try self.begin("return ")
                try self.put(try self.text_ref("()", false))
                try self.end()
            .error_code:
                try self.begin("return kernel.join_owned([")
                try self.put(try self.text_ref("ErrorCode(", false))
                try self.put(", kernel.show_int((i64)v), ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .error_value: try self.line("return kernel.text_of(v.message)")
            .optional:
                try self.line("if let inner = v:")
                try self.begin("    return ")
                try self.put(try self.show_name(t.elem))
                try self.put("(inner)")
                try self.end()
                try self.begin("return ")
                try self.put(try self.text_ref("none", false))
                try self.end()
            .tuple:
                try self.begin("return kernel.join_owned([")
                try self.put(try self.text_ref("(", false))
                try self.put(", ")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                        try self.put(try self.text_ref(", ", false))
                        try self.put(", ")
                    try self.put(try self.show_name(t.args[i]))
                    try self.put("(v.")
                    try self.put_u64((u64)i)
                    try self.put(")")
                    i += 1
                if t.args.length == 1:
                    try self.put(", ")
                    try self.put(try self.text_ref(",", false))
                try self.put(", ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .struct_:
                let d = t.decl else return
                try self.begin("return kernel.join_owned([")
                let half = self.checker.scratch.length // 2
                try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{self.checker.display_name(d)}(")), false))
                var cursor = d.body
                var first = true
                while let m = cursor:
                    if m.kind == ast.Kind.field:
                        try self.put(", ")
                        let label = try copy_name(try format(self.checker.scratch[half..], f"{", " if not first else ""}{m.text} = "))
                        first = false
                        try self.put(try self.text_ref(label, false))
                        try self.put(", ")
                        try self.put(try self.show_name(m.type_id))
                        try self.put("(v.L_")
                        try self.put(m.text)
                        try self.put(")")
                    cursor = m.next
                try self.put(", ")
                try self.put(try self.text_ref(")", false))
                try self.put("])")
                try self.end()
            .enum_:
                let d = t.decl else return
                try self.line("match v:")
                self.indent += 1
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.enum_case:
                        try self.begin(".L_")
                        try self.put(m.text)
                        if m.body != none:
                            try self.put("(")
                            var p = m.body
                            var first = true
                            while let field = p:
                                if not first:
                                    try self.put(", ")
                                first = false
                                try self.put("L_")
                                try self.put(field.text)
                                p = field.next
                            try self.put(")")
                        try self.put(":")
                        try self.end()
                        let half = self.checker.scratch.length // 2
                        try self.begin("    return kernel.join_owned([")
                        if m.body != none:
                            try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{self.checker.display_name(d)}.{m.text}(")), false))
                            var p = m.body
                            var first = true
                            while let field = p:
                                try self.put(", ")
                                let label = try copy_name(try format(self.checker.scratch[half..], f"{", " if not first else ""}{field.text} = "))
                                first = false
                                try self.put(try self.text_ref(label, false))
                                try self.put(", ")
                                try self.put(try self.show_name(field.type_id))
                                try self.put("(L_")
                                try self.put(field.text)
                                try self.put(")")
                                p = field.next
                            try self.put(", ")
                            try self.put(try self.text_ref(")", false))
                            try self.put("])")
                        else:
                            try self.put(try self.text_ref(try copy_name(try format(self.checker.scratch[half..], f"{d.text}.{m.text}")), false))
                            try self.put("])")
                        try self.end()
                    cursor = m.next
                self.indent -= 1
            _: return try self.checker.fail(self.checker.tree(), "a value this slice does not display")
        self.indent -= 1
        try self.line("")

    ## The pieces of a formatted text, joined.
    mutating func formatted(e: ast.Node*) -> !:
        try self.put("kernel.join([")
        var cursor = e.body
        var first = true
        while let part = cursor:
            if not first:
                try self.put(", ")
            first = false
            if part.kind == ast.Kind.format_text:
                try self.put(try self.text_ref(try unescape_format(part.text), false))
            else:
                let v = part.left else return
                try self.show(v)
            cursor = part.next
        if first:
            try self.put(try self.text_ref("", false))
        try self.put("])")

    mutating func match_expr(e: ast.Node*) -> !:
        let subject = e.left else return
        let st = self.checker.table.get(subject.type_id)
        if st.kind == types.Kind.tuple or st.kind == types.Kind.bytes_:
            try self.match_expr_by_tests(e, subject, st)
            return
        try self.put("match ")
        try self.use(subject)
        if st.kind == types.Kind.str_:
            # Base matches a text's bytes against its literals
            try self.put(".data")
        try self.put(":")
        try self.end()
        self.indent += 1
        var cursor = e.body
        var bound_any = false
        while let arm = cursor:
            try self.begin("")
            var p = arm.left
            var first = true
            var bound: ast.Node*? = none
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern, st, "", &bound)
                p = pattern.next
            if bound != none:
                return try self.fail(arm, "a name pattern in a match expression compiles in a later slice; use the statement form")
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            try self.put(" => ")
            let body = arm.body else return
            try self.owned(body)
            try self.end()
            cursor = arm.next
        if st.kind != types.Kind.enum_ and st.kind != types.Kind.optional and st.kind != types.Kind.bool_ and not has_wildcard_arm(e):
            try self.line("_ => trap(\"no arm applied\")")
        self.indent -= 1
        try self.begin("")

## Whether the expression is the literal `none`.
func is_none(e: ast.Node*) -> bool:
    return e.kind == ast.Kind.literal and e.text == "none"

## Whether a pattern binds a name anywhere inside it.
func binds_a_name(p: ast.Node*) -> bool:
    if p.has(ast.flag_wildcard):
        return false
    if p.text == "bind":
        return true
    if p.text == "tuple":
        var cursor = p.body
        while let sub = cursor:
            if binds_a_name(sub):
                return true
            cursor = sub.next
    return false

## Whether every pattern in the list matches anything: `_`, a name, a tuple of those.
func irrefutable(patterns: ast.Node*?) -> bool:
    var cursor = patterns
    while let p = cursor:
        if p.text == "tuple":
            if not irrefutable(p.body):
                return false
        elif not (p.has(ast.flag_wildcard) or p.text == "bind"):
            return false
        cursor = p.next
    return true

func has_wildcard_arm(s: ast.Node*) -> bool:
    var cursor = s.body
    while let arm = cursor:
        var p = arm.left
        while let pattern = p:
            if (pattern.has(ast.flag_wildcard) or pattern.text == "bind") and arm.right == none:
                return true
            p = pattern.next
        cursor = arm.next
    return false

## `<` for `<=`, `>` for `>=`: the strict form of an order, for a tuple's earlier members.
func strict(op: str) -> str:
    if op == "<=":
        return "<"
    if op == ">=":
        return ">"
    return op

## `{{` and `}}` in the literal part of a formatted string are one brace each.
func unescape_format(text: str) -> str!:
    let b = text.bytes
    var out = try alloc u8[b.length + 1]
    var n: usize = 0
    var i: usize = 0
    while i < b.length:
        if (b[i] == '{' or b[i] == '}') and i + 1 < b.length and b[i + 1] == b[i]:
            out[n] = b[i]
            n += 1
            i += 2
            continue
        if b[i] == '\\' and i + 1 < b.length:
            let e = b[i + 1]
            out[n] = '\n' if e == 'n' else '\t' if e == 't' else '\r' if e == 'r' else 0 if e == '0' else e
            n += 1
            i += 2
            continue
        out[n] = b[i]
        n += 1
        i += 1
    return (str)out[..<n]

func hex_digit(n: u8) -> u8:
    return '0' + n if n < 10 else 'a' + (n - 10)

## A name kept on the heap, since the scratch it was formatted in is reused.
func copy_name(text: str) -> str!:
    var out = try alloc u8[text.length]
    var i: usize = 0
    while i < text.length:
        out[i] = text.bytes[i]
        i += 1
    return (str)out
