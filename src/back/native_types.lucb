## Native signature identity and type-node construction.
import front.ast

## Luce maps both i64 and usize to int, but their native adapters differ even
## inside tuples and optionals. Native signature identity includes that spelling.
pub func same_native_type(a: ast.Node*, b: ast.Node*) -> bool:
    let mask = ast.flag_optional | ast.flag_fallible | ast.flag_func_type | ast.flag_tuple_type | ast.flag_usize | ast.flag_native_owned | ast.flag_native_outcome | ast.flag_native_callback | ast.flag_worker_entry
    if a.type_id != b.type_id or (a.flags & mask) != (b.flags & mask):
        return false
    if not same_native_child(a.left, b.left) or not same_native_child(a.right, b.right):
        return false
    var left = a.body
    var right = b.body
    while let member = left:
        let other = right else return false
        if not same_native_type(member, other):
            return false
        left = member.next
        right = other.next
    return right == none

func same_native_child(a: ast.Node*?, b: ast.Node*?) -> bool:
    let left = a else return b == none
    let right = b else return false
    return same_native_type(left, right)

pub func native_node(declaration: ast.Node*) -> ast.Node*!:
    let t = try ast.Node.make(ast.Kind.type_, declaration.text, declaration.start, declaration.line)
    t.type_id = declaration.type_id
    t.module = declaration.module
    return t

## Keep resolved nominal identity while inspecting a carrier's underlying value.
pub func plain_native_node(node: ast.Node*) -> ast.Node*!:
    let result = try ast.Node.make(node.kind, node.text, node.start, node.line)
    *result = *node
    result.flags &= ~ast.flag_native_owned
    return result
