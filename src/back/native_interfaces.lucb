## Interface adapter storage and witness tables. Conversion expressions are checked
## before this module writes them; all owning edges use the shared heap protocol.
import io

pub struct Method:
    pub let name: str
    pub let native_parameters: str
    pub let luce_parameters: str
    pub let native_result: str
    pub let luce_result: str
    pub let native_body: str
    pub let luce_body: str
    pub let receiver_mutates: bool

pub func declaration(out: io.Writer, name: str, native: str, methods: const Method[], reverse: bool) -> !:
    try out.write(f"struct L_{name}__native:\n    var header: heap.Object\n    var table: L_{name}__table*\n    var value: interop.Interface[{native}]\n\n")
    for method in methods:
        try out.write(f"func L_{name}__native__{method.name}(L_self: L_{name}*{method.luce_parameters}){method.luce_result}:\n")
        try out.write("    let mark = heap.mark()\n    defer heap.drain(mark)\n")
        try out.write(f"    let reference = ((L_{name}__native*)L_self).value\n")
        try out.write(method.luce_body)
        try out.write("\n")
    try out.write(f"var L_{name}__native_table: L_{name}__table = L_{name}__table(")
    var first = true
    for method in methods:
        if not first:
            try out.write(", ")
        first = false
        try out.write(f"L_{method.name} = L_{name}__native__{method.name}")
    if first:
        try out.write("nothing = 0")
    try out.write(")\n")
    try out.write(f"func L_{name}__native_drop(o: heap.Object*):\n    ((L_{name}__native*)o).value.release()\n")
    try out.write(f"func L_{name}__native_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    ((L_{name}__native*)o).value.trace(visit, context)\n")
    try out.write(f"func L_{name}__native_identity(o: heap.Object*) -> u64:\n    return heap.identity(((L_{name}__native*)o).value.owner)\n")
    try out.write(f"var L_{name}__native_info: heap.Info = heap.Info(name = \"{name}\", size = sizeof(L_{name}__native), finish = none, drop = L_{name}__native_drop, trace = L_{name}__native_trace, identity = L_{name}__native_identity)\n\n")
    if reverse:
        try out.write(f"struct L_{name}__managed: {native}:\n    var header: heap.Object\n    var source: L_{name}*\n")
        for method in methods:
            let mode = "mutating " if method.receiver_mutates else ""
            try out.write(f"    pub {mode}func {method.name}({method.native_parameters}){method.native_result}:\n")
            try out.write("        heap.require_context()\n        heap.check_alive((heap.Object*)&self.header)\n        let mark = heap.mark()\n        defer heap.drain(mark)\n")
            try out.write(method.native_body)
        try out.write(f"func L_{name}__managed_drop(o: heap.Object*):\n    heap.release((heap.Object*)((L_{name}__managed*)o).source)\n")
        try out.write(f"func L_{name}__managed_trace(o: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    visit((heap.Object*)((L_{name}__managed*)o).source, context)\n")
        try out.write(f"func L_{name}__managed_identity(o: heap.Object*) -> u64:\n    return heap.identity((heap.Object*)((L_{name}__managed*)o).source)\n")
        try out.write(f"var L_{name}__managed_info: heap.Info = heap.Info(name = \"{name} implementation\", size = sizeof(L_{name}__managed), finish = none, drop = L_{name}__managed_drop, trace = L_{name}__managed_trace, identity = L_{name}__managed_identity)\n\n")
    try out.write(f"func L_{name}__frombase(value: interop.Interface[{native}]) -> L_{name}*:\n    heap.check_alive(value.owner)\n")
    if reverse:
        try out.write(f"    if value.owner.info == &L_{name}__managed_info:\n        let source = ((L_{name}__managed*)value.owner).source\n        discard(heap.retain((heap.Object*)source))\n        value.release()\n        return source\n")
    try out.write(f"    let box = (L_{name}__native*)heap.allocate(&L_{name}__native_info)\n    box.table = &L_{name}__native_table\n    box.value = value\n    return (L_{name}*)box\n\n")
    try out.write(f"func L_{name}__tobase(value: L_{name}*) -> interop.Interface[{native}]:\n    heap.check_alive(&value.header)\n    if value.header.info == &L_{name}__native_info:\n        return ((L_{name}__native*)value).value\n")
    if reverse:
        try out.write(f"    let adapter = (L_{name}__managed*)heap.allocate(&L_{name}__managed_info)\n    adapter.source = (L_{name}*)heap.retain(&value.header)\n    discard(heap.pool_object(&adapter.header))\n    return interop.Interface[{native}](&adapter.header, adapter)\n\n")
    else:
        try out.write("    trap(\"an interface without an owned result contract cannot call managed implementations\")\n\n")
