## Retained callable layouts. Conversion expressions are prepared by crossings;
## this module owns the wrapper's storage, tracing and round-trip unwrapping.
import io

pub struct Adapter:
    pub let toward: str
    pub let back: str
    pub let argument: str
    pub let result: str
    pub let parameters: str
    pub let luce_result: str
    pub let invoke_managed: str
    pub let invoke_native: str

pub func write(out: io.Writer, adapter: Adapter) -> !:
    let name = adapter.toward
    let argument = adapter.argument
    let result = adapter.result
    try out.write(f"type {name}__result = {result}\n")
    try out.write(f"struct {name}__storage:\n    var header: heap.Object\n    var code: void*\n    var base_code: void*\n    var native: interop.Callback[{argument}, {result}]\n\n")
    try out.write(f"func {name}__managed(owner: heap.Object*, argument: {argument}) -> interop.Outcome[{result}]:\n")
    try out.write("    heap.require_context()\n    heap.check_alive(owner)\n    let mark = heap.mark()\n    defer heap.drain(mark)\n")
    try out.write(adapter.invoke_managed)
    try out.write(f"\nfunc {name}__native(owner: heap.Object*{adapter.parameters}){adapter.luce_result}:\n")
    try out.write("    let mark = heap.mark()\n    defer heap.drain(mark)\n")
    try out.write(f"    let native = (({name}__storage*)owner).native\n")
    try out.write(adapter.invoke_native)
    try out.write(f"\nfunc {name}__drop(owner: heap.Object*):\n    (({name}__storage*)owner).native.release()\n")
    try out.write(f"func {name}__trace(owner: heap.Object*, visit: func(heap.Object*, void*) -> unit, context: void*):\n    (({name}__storage*)owner).native.trace(visit, context)\n")
    try out.write(f"var {name}__info: heap.Info = heap.Info(name = \"native callback\", size = sizeof({name}__storage), finish = none, drop = {name}__drop, trace = {name}__trace)\n")
    try out.write(f"func {name}(value: kernel.Closure*) -> interop.Callback[{argument}, {result}]:\n    heap.check_alive(&value.header)\n    if value.header.info == &{name}__info:\n        return (({name}__storage*)value).native\n    return interop.Callback[{argument}, {result}](&value.header, {name}__managed)\n")
    try out.write(f"func {adapter.back}(value: interop.Callback[{argument}, {result}]) -> kernel.Closure*:\n    heap.check_alive(value.owner)\n    if (void*)value.entry == (void*){name}__managed:\n        return (kernel.Closure*)value.owner\n    let storage = ({name}__storage*)heap.allocate(&{name}__info)\n    storage.code = (void*){name}__native\n    storage.base_code = (void*)0\n    storage.native = value\n    return (kernel.Closure*)storage\n\n")
