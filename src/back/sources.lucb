#==============================================================================================
#
#   sources - Base source dependencies
#
#   DESCRIPTION:
#       Resolve Base source dependencies through Base's own loader. The set owns source
#       bytes and copied names until destruction; generated paths never depend on
#       the output directory being beneath the original sources.
#
#==============================================================================================
import c
import luce_std.files
import io
import memory
import os
import luce_std.process
import strings
import support.list
import support.native
import support.module_paths
import support.toolchain
import support.copied

## The Base compiler's dependency report could not be read, or contradicted itself.
pub let invalid_bundle: ErrorCode = ErrorCode.package(17)

# mark: Modules and owners ====================================================================

## One Base module of the build, its text read and owned by the set.
pub struct Source:
    ## The module's dotted import name.
    pub var name: str
    ## The file, or `ORDER` directory, it was read from.
    pub var path: str
    ## The module's whole text, fragments joined.
    pub var data: u8[]

## The package a module comes from: `module` as this build names it, `package` the owning
## package's identifier.
pub struct Ownership:
    ## The module's dotted name.
    pub let module: str
    ## The owning package's identifier.
    pub let package: str

# mark: The source set ========================================================================

## Every Base module a build compiles, with the packages that own them and the
## native inputs they bring; it owns all its text until `destroy`.
pub struct SourceSet:
    ## The modules, each once, in the order the reports named them.
    pub var entries: list.List[Source]
    ## Which package each module belongs to, as the reports said.
    pub var module_packages: list.List[Ownership]
    ## The native libraries and objects the modules ask to be linked.
    pub var native_inputs: native.Inputs
    var allocator: memory.Allocator
    var closed: bool

    ## An empty set, owning what it later collects through the current allocator.
    pub static func create() -> SourceSet!:
        return SourceSet(entries = try list.List[Source].create(8), module_packages = try list.List[Ownership].create(8), native_inputs = try native.Inputs.create(), allocator = memory.allocator)

    ## Collect the direct module and the complete resolved private dependency set.
    ## The versioned response uses NUL delimiters; a path may contain whitespace.
    ## `root` is the build's source root: its package's modules keep their bare names, every
    ## other package's carry its identifier (base.md §16.3).
    pub func collect(name: str, path: str, root: str) -> !:
        assert(not self.closed)
        with self.allocator:
            try self.collect_sources(name, path, root)

    func collect_sources(name: str, path: str, root: str) -> !:
        try self.add(name, path)
        let compiler = (str)(try toolchain.base_compiler())
        let output = module_paths.dependency_report(compiler, path, root) catch failure:
            _ = try io.stderr().write(failure.message)
            error(invalid_bundle, "Base dependency reporting failed; use the Base release pinned by this Luce compiler")
        var position = module_paths.dependency_header.length
        while position < output.length:
            let kind = try field(output, &position)
            let module_name = try field(output, &position)
            let value = try field(output, &position)
            if kind == "native":
                try self.native_inputs.add(module_name, value)
            elif kind == "source":
                try self.add(module_name, value)
            elif kind == "package":
                try self.add_package(module_name, value)
            else:
                error(invalid_bundle, "the Base compiler returned an unknown dependency record")

    func add_package(module: str, package: str) -> !:
        if not valid_module_name(module) or package.length == 0:
            error(invalid_bundle, "the Base compiler returned invalid module ownership")
        for byte in package.bytes:
            if byte == '\n' or byte == '\r' or byte == '"' or byte == '\\':
                error(invalid_bundle, "the Base compiler returned an invalid package name")
        for entry in self.module_packages.span():
            if entry.module == module:
                if entry.package != package:
                    error(invalid_bundle, "Base packages disagree on a module's owning package")
                return
        let owned_module = try strings.copy(module)
        errdefer strings.release(owned_module)
        let owned_package = try strings.copy(package)
        errdefer strings.release(owned_package)
        try self.module_packages.push(Ownership(owned_module, owned_package))

    ## The identifier of the package module `module` comes from, when the reports named it.
    pub func package_of(module: str) -> str?:
        for entry in self.module_packages.span():
            if entry.module == module:
                return entry.package
        return none

    func add(name: str, path: str) -> !:
        if not valid_module_name(name) or path.length == 0:
            error(invalid_bundle, "the Base compiler returned an invalid source dependency")
        # every module's report names most of the program's modules again: one already
        # here from the same file is not read again (luced-3d read 30 000 files a build)
        for existing in self.entries.span():
            if existing.name == name and existing.path == path:
                return
        let owned_path = try strings.copy(path)
        # the path and the text go into the set's entry, and are given back otherwise
        var stored = false
        defer:
            if not stored:
                strings.release(owned_path)
        let data = try module_source(owned_path)
        defer:
            if not stored:
                free(data)
        var index: usize = 0
        while index < self.entries.count:
            let existing = self.entries.get(index)
            if existing.name == name:
                if (str)existing.data != (str)data:
                    try io.stderr().write(f"luce: conflicting Base module {name}: {existing.path} and {path}\n")
                    error(invalid_bundle, "Base modules resolve the same import name to different source contents")
                return
            index += 1
        let owned_name = try strings.copy(name)
        errdefer strings.release(owned_name)
        try self.entries.push(Source(name = owned_name, path = owned_path, data = data))
        stored = true

    ## Releases every text the set holds; a second call does nothing.
    pub func destroy():
        if self.closed:
            return
        self.closed = true
        with self.allocator:
            var index: usize = 0
            while index < self.entries.count:
                let item = self.entries.get(index)
                strings.release(item.name)
                strings.release(item.path)
                free(item.data)
                index += 1
            self.native_inputs.destroy()
            self.entries.destroy()
            self.entries.count = 0
            for entry in self.module_packages.span():
                strings.release(entry.module)
                strings.release(entry.package)
            self.module_packages.destroy()
            self.module_packages.count = 0

    ## Whether a module named exactly `name` is in the set.
    pub func contains(name: str) -> bool:
        var index: usize = 0
        while index < self.entries.count:
            if self.entries.get(index).name == name:
                return true
            index += 1
        return false

    func contains_namespace(name: str) -> bool:
        var index: usize = 0
        while index < self.entries.count:
            let candidate = self.entries.get(index).name
            if candidate == name or (strings.starts_with(candidate, name) and candidate.length > name.length and candidate.bytes[name.length] == '.'):
                return true
            index += 1
        return false

    # mark: Generated names ===================================================================

    ## Preserve the familiar generated layout unless a real Base module owns that
    ## name. Generated entry/runtime files must never overwrite imported source.
    ## These two queries return owned text; release it through the current allocator.
    pub func entry_name() -> str!:
        if not self.contains("main"):
            return try strings.copy("main")
        var index: usize = 0
        var storage: u8[64]
        while true:
            let candidate = try strings.format(storage, f"__luce_main_{index}")
            if not self.contains(candidate):
                return try strings.copy(candidate)
            index += 1
        trap("no generated entry name")

    ## The namespace for the generated runtime modules: `rt`, unless a
    ## real module uses it or sits below it.
    pub func runtime_namespace() -> str!:
        if not self.contains_namespace("rt"):
            return try strings.copy("rt")
        var index: usize = 0
        var storage: u8[64]
        while true:
            let candidate = try strings.format(storage, f"__luce_runtime_{index}")
            if not self.contains_namespace(candidate):
                return try strings.copy(candidate)
            index += 1
        trap("no generated runtime namespace")

# mark: Reading reports and modules ===========================================================

func field(text: str, position: usize*) -> str!:
    return try module_paths.next_field(text, position, invalid_bundle, "the Base compiler returned a truncated dependency record")

func valid_module_name(name: str) -> bool:
    var first = true
    for byte in name.bytes:
        if byte == '.':
            if first:
                return false
            first = true
        elif (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z') or byte == '_' or (not first and byte >= '0' and byte <= '9'):
            first = false
        else:
            return false
    return not first

## A Base module's text: its file, or for a directory the fragments its `ORDER` lists,
## joined in order with each ending on a newline, exactly as Base assembles them.
func module_source(path: str) -> u8[]!:
    let order_path = try strings.join([path, "/ORDER"], "")
    defer strings.release(order_path)
    let listed = files.read((c.str)order_path) catch:
        return try copied.read((c.str)path)
    defer listed.release()
    let order = listed.value
    var total: usize = 0
    var texts = try list.List[u8[]].create(8)
    defer texts.destroy()
    errdefer release_texts(&texts)
    var start: usize = 0
    var index: usize = 0
    while index <= order.length:
        let blank = index == order.length or order[index] == '\n' or order[index] == ' ' or order[index] == '\r' or order[index] == '\t'
        if blank and index > start:
            let fragment = try strings.join([path, "/", (str)order[start..<index]], "")
            defer strings.release(fragment)
            let text = try copied.read((c.str)fragment)
            try texts.push(text)
            total += text.length + (0 if text.length > 0 and text[text.length - 1] == '\n' else 1)
        if blank:
            start = index + 1
        index += 1
    if texts.count == 0:
        error(invalid_bundle, "a Base module's `ORDER` names no fragment")
    let data = try new u8[total] ---
    var at: usize = 0
    for text in texts.span():
        memory.copy(data[at..], text, text.length)
        at += text.length
        if text.length == 0 or text[text.length - 1] != '\n':
            data[at] = '\n'
            at += 1
    release_texts(&texts)
    return data

func release_texts(texts: list.List[u8[]]*):
    for text in texts.span():
        free(text)
    texts.count = 0
