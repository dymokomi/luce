## Resolve boundary availability across module descriptions before assigning Luce
## types. An unavailable foreign declaration must not poison unrelated exports.
import front.ast
import sema.boundary
import strings

pub struct Import:
    pub let name: str
    pub let tree: ast.Node*

func declaration(tree: ast.Node*, name: str) -> ast.Node*?:
    var cursor = tree.body
    while let node = cursor:
        if node.text == name and not node.has(boundary.flag_dropped):
            return node
        cursor = node.next
    return none

func named(tree: ast.Node*, imports: const Import[], name: str) -> ast.Node*?:
    if let dot = strings.find(name, "."):
        let prefix = (str)name.bytes[..<dot]
        for item in imports:
            if item.name == prefix:
                return declaration(item.tree, (str)name.bytes[dot + 1..])
        return none
    return declaration(tree, name)

func missing(tree: ast.Node*, imports: const Import[], nodes: ast.Node*?) -> bool:
    var cursor = nodes
    while let node = cursor:
        cursor = node.next
        if node.kind == ast.Kind.type_ and node.left == none and node.body == none and node.right == none:
            if let dot = strings.find(node.text, "."):
                for item in imports:
                    if item.name == (str)node.text.bytes[..<dot] and declaration(item.tree, (str)node.text.bytes[dot + 1..]) == none:
                        return true
            else:
                var candidate = tree.body
                while let known = candidate:
                    if known.text == node.text and known.has(boundary.flag_dropped):
                        return true
                    candidate = known.next
        if missing(tree, imports, node.ty) or missing(tree, imports, node.left) or missing(tree, imports, node.right) or missing(tree, imports, node.body):
            return true
    return false

func mutates(iface: ast.Node*) -> bool:
    var cursor = iface.body
    while let method = cursor:
        if method.has(ast.flag_mutating):
            return true
        cursor = method.next
    return false

## Keep unavailable declarations marked until the whole graph reaches a fixed
## point. Requirements are never removed from an otherwise available interface.
pub func prune(tree: ast.Node*, imports: const Import[]) -> bool:
    var changed = false
    var cursor = tree.body
    while let node = cursor:
        cursor = node.next
        if node.has(boundary.flag_dropped) or node.kind == ast.Kind.import_:
            continue
        if node.kind == ast.Kind.struct_ or node.kind == ast.Kind.class_ or node.kind == ast.Kind.enum_:
            var kept: ast.Node*? = none
            var tail: ast.Node*? = none
            var conformances = node.right
            while let conformance = conformances:
                conformances = conformance.next
                let iface = named(tree, imports, conformance.text)
                # Native values follow Luce's copied, read-only interface contract.
                # Native owners and checked views can supply mutable witnesses.
                if let target = iface:
                    if node.has(ast.flag_native_value) and mutates(target):
                        continue
                    ast.append(&kept, &tail, conformance)
            node.right = kept
        if missing(tree, imports, node.ty) or missing(tree, imports, node.left) or missing(tree, imports, node.right) or missing(tree, imports, node.body):
            node.flags |= boundary.flag_dropped
            changed = true
    return changed

pub func remove_dropped(tree: ast.Node*):
    var kept: ast.Node*? = none
    var tail: ast.Node*? = none
    var cursor = tree.body
    while let node = cursor:
        cursor = node.next
        if not node.has(boundary.flag_dropped):
            ast.append(&kept, &tail, node)
    tree.body = kept

test "foreign availability removes dependent declarations but preserves unrelated exports":
    let foreign = try boundary.read("description 9\nmodule foreign\nstruct Hidden\n    storage unavailable\nenum Mode as u8\n    case ready = 0\n", "foreign")
    let consumer = try boundary.read("description 9\nmodule consumer\nimport foreign as native\nforeign native.Hidden struct\nforeign native.Mode enum\nfunc hidden() -> native.Hidden\nfunc mode() -> native.Mode\n", "consumer")
    let imports = [Import("native", foreign)]
    assert(prune(consumer, imports))
    assert(not prune(consumer, imports))
    remove_dropped(consumer)
    assert(declaration(consumer, "hidden") == none)
    assert(declaration(consumer, "mode") != none)

test "mutable native value conformance does not change Luce value interface semantics":
    let tree = try boundary.read("description 9\nmodule sample\ninterface Writer\n    mutating method write(value: i64)\nstruct Value\n    storage value\n    mutating method write(value: i64)\n    conforms Writer\n", "sample")
    let imports = [Import("sample", tree)]
    discard(prune(tree, imports[..<0]))
    assert((declaration(tree, "Value") else error(boundary.invalid_description, "missing value")).right == none)
    assert((declaration(tree, "Writer") else error(boundary.invalid_description, "missing interface")).body != none)
