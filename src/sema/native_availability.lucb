#==============================================================================================
#
#   native_availability - Boundary availability
#
#   DESCRIPTION:
#       Resolve boundary availability across module descriptions before assigning Luce
#       types. An unavailable foreign declaration must not poison unrelated exports.
#
#==============================================================================================
import front.ast
import sema.boundary
import strings

# mark: Finding declarations ==================================================================

## A module a description imports, as its declarations are found by name.
pub struct Import:
    ## The name the description refers to the module by.
    pub let name: str
    ## The module's declarations, read from its description.
    pub let tree: ast.Node*

func declaration(tree: ast.Node*, name: str) -> ast.Node*?:
    var cursor = tree.body
    while let node = cursor:
        if node.text == name and not node.has(ast.flag_dropped):
            return node
        cursor = node.next
    return none

func named(tree: ast.Node*, imports: const Import[], name: str) -> ast.Node*?:
    if let dot = strings.find(name, "."):
        let prefix = (str)name.bytes[..<dot]
        for item in imports:
            if item.name == prefix:
                return declaration(item.tree, (str)name.bytes[dot + 1..])
        return none
    return declaration(tree, name)

# mark: Pruning unavailable declarations ======================================================

func missing(tree: ast.Node*, imports: const Import[], nodes: ast.Node*?) -> bool:
    var cursor = nodes
    while let node = cursor:
        cursor = node.next
        if node.kind == ast.Kind.type_ and node.left == none and node.body == none and node.right == none:
            if let dot = strings.find(node.text, "."):
                for item in imports:
                    if item.name == (str)node.text.bytes[..<dot] and declaration(item.tree, (str)node.text.bytes[dot + 1..]) == none:
                        return true
            else:
                var candidate = tree.body
                while let known = candidate:
                    if known.text == node.text and known.has(ast.flag_dropped):
                        return true
                    candidate = known.next
        if missing(tree, imports, node.ty) or missing(tree, imports, node.left) or missing(tree, imports, node.right) or missing(tree, imports, node.body):
            return true
    return false

## Whether a method of `node` implementing a requirement of `iface` changes its receiver: a
## requirement has none of its own, its implementation has (base.md §14.2).
func mutates(node: ast.Node*, iface: ast.Node*) -> bool:
    var cursor = node.body
    while let method = cursor:
        if method.has(ast.flag_mutating) and requires(iface, method.text):
            return true
        cursor = method.next
    return false

## Whether an interface declares a requirement named `name`.
func requires(iface: ast.Node*, name: str) -> bool:
    var cursor = iface.body
    while let method = cursor:
        if method.text == name:
            return true
        cursor = method.next
    return false

## A type's methods whose signatures name an unavailable type leave it one by one, as
## the description leaves out a method it cannot describe; a constructor that does makes
## construction unavailable, and a conformance whose requirement left goes with it. The
## type itself stays. Whether any left.
func prune_methods(tree: ast.Node*, imports: const Import[], node: ast.Node*) -> bool:
    var changed = false
    var kept: ast.Node*? = none
    var tail: ast.Node*? = none
    var members = node.body
    while let member = members:
        members = member.next
        member.next = none
        # a method's generic parameters (ty), parameters (right) and result (left)
        if member.kind == ast.Kind.func_ and (missing(tree, imports, member.right) or missing(tree, imports, member.ty) or missing(tree, imports, member.left)):
            changed = true
            if member.text == "init":
                node.flags |= ast.flag_unavailable_init
            var conforming: ast.Node*? = none
            var conforming_tail: ast.Node*? = none
            var conformances = node.right
            while let conformance = conformances:
                conformances = conformance.next
                conformance.next = none
                let iface = named(tree, imports, conformance.text)
                if let target = iface:
                    if requires(target, member.text):
                        continue
                ast.append(&conforming, &conforming_tail, conformance)
            node.right = conforming
            continue
        ast.append(&kept, &tail, member)
    node.body = kept
    return changed

## Keep unavailable declarations marked until the whole graph reaches a fixed
## point. Requirements are never removed from an otherwise available interface; a
## struct's, class's or enum's methods are (`prune_methods`).
pub func prune(tree: ast.Node*, imports: const Import[]) -> bool:
    var changed = false
    var cursor = tree.body
    while let node = cursor:
        cursor = node.next
        if node.has(ast.flag_dropped) or node.kind == ast.Kind.import_:
            continue
        if node.kind == ast.Kind.struct_ or node.kind == ast.Kind.class_ or node.kind == ast.Kind.enum_:
            changed = prune_methods(tree, imports, node) or changed
            var kept: ast.Node*? = none
            var tail: ast.Node*? = none
            var conformances = node.right
            while let conformance = conformances:
                conformances = conformance.next
                let iface = named(tree, imports, conformance.text)
                # Native values follow Luce's copied, read-only interface contract.
                # Native owners and checked views can supply mutable witnesses.
                if let target = iface:
                    if node.has(ast.flag_native_value) and mutates(node, target):
                        continue
                    ast.append(&kept, &tail, conformance)
            node.right = kept
        if missing(tree, imports, node.ty) or missing(tree, imports, node.left) or missing(tree, imports, node.right) or missing(tree, imports, node.body):
            node.flags |= ast.flag_dropped
            changed = true
    return changed

## Why `node` is unavailable: the first field whose type is, or `none` when it is the
## declaration's own signature. A method is never the reason: one whose signature names an
## unavailable type leaves alone (`prune_methods`), and a method naming the type itself is
## unavailable only because the type is.
pub func culprit(tree: ast.Node*, imports: const Import[], node: ast.Node*) -> ast.Node*?:
    var members = node.body
    while let member = members:
        members = member.next
        if member.kind == ast.Kind.func_:
            continue
        if missing(tree, imports, member.ty) or missing(tree, imports, member.left) or missing(tree, imports, member.right):
            return member
    return none

## Takes every declaration `prune` marked dropped out of the module.
pub func remove_dropped(tree: ast.Node*):
    var kept: ast.Node*? = none
    var tail: ast.Node*? = none
    var cursor = tree.body
    while let node = cursor:
        cursor = node.next
        if not node.has(ast.flag_dropped):
            ast.append(&kept, &tail, node)
    tree.body = kept

# mark: Base source lines =====================================================================

## The words before a declaration's kind, `pub inline func` to `func`.
func without_modifiers(line: str) -> str:
    var rest = line
    var stripped = true
    while stripped:
        stripped = false
        for word in ["pub ", "inline ", "noinline ", "extern ", "local "]:
            if strings.starts_with(rest, word):
                rest = (str)rest.bytes[word.length..]
                stripped = true
    return rest

## Whether `line`, its modifiers gone, declares `name` as one of `kinds`.
func declares(line: str, name: str, kinds: const str[]) -> bool:
    let rest = without_modifiers(line)
    for kind in kinds:
        if strings.starts_with(rest, kind) and strings.starts_with((str)rest.bytes[kind.length..], name):
            let after = kind.length + name.length
            if after == rest.length:
                return true
            let next = rest.bytes[after]
            return next == ':' or next == '(' or next == '[' or next == ' ' or next == '='
    return false

## The line, from 1, where the Base source `text` declares `name`, or `member` inside it
## when that is not empty; 0 when it does not. The source is in the canonical layout, so a
## declaration starts its line and a member is indented one level.
pub func base_line(text: str, name: str, member: str) -> u32:
    let kinds = ["struct ", "class ", "enum ", "union ", "interface ", "func ", "let ", "var ", "type ", "handle "]
    let member_kinds = ["func ", "var ", "let "]
    var line: u32 = 0
    var inside = false
    var at: usize = 0
    while at < text.length:
        var end = at
        while end < text.length and text.bytes[end] != u8(10):
            end += 1
        let current = (str)text.bytes[at..<end]
        at = end + 1
        line += 1
        if current.length == 0 or current.bytes[0] == '#':
            continue
        if current.bytes[0] != ' ':
            if inside:
                return 0
            if declares(current, name, kinds):
                if member.length == 0:
                    return line
                inside = true
            continue
        if inside and strings.starts_with(current, "    ") and current.length > 4 and current.bytes[4] != ' ':
            if declares((str)current.bytes[4..], member, member_kinds):
                return line
    return 0

test "foreign availability removes dependent declarations but preserves unrelated exports":
    let foreign = try boundary.read("description 9\nmodule foreign\nstruct Hidden\n    storage unavailable\nenum Mode as u8\n    case ready = 0\n", "foreign")
    let consumer = try boundary.read("description 9\nmodule consumer\nimport foreign as native\nforeign native.Hidden struct\nforeign native.Mode enum\nfunc hidden() -> native.Hidden\nfunc mode() -> native.Mode\n", "consumer")
    let imports = [Import("native", foreign)]
    assert(prune(consumer, imports))
    assert(not prune(consumer, imports))
    remove_dropped(consumer)
    assert(declaration(consumer, "hidden") == none)
    assert(declaration(consumer, "mode") != none)

test "mutable native value conformance does not change Luce value interface semantics":
    let tree = try boundary.read("description 9\nmodule sample\ninterface Writer\n    method write(value: i64)\nstruct Value\n    storage value\n    mutating method write(value: i64)\n    conforms Writer\n", "sample")
    let imports = [Import("sample", tree)]
    _ = prune(tree, imports[..<0])
    assert((declaration(tree, "Value") else error(boundary.invalid_description, "missing value")).right == none)
    assert((declaration(tree, "Writer") else error(boundary.invalid_description, "missing interface")).body != none)

test "a Base declaration and its member are found by line":
    let text = "import geometry\n\n## A mesh.\npub struct Mesh:\n    pub var count: i64\n\n    ## Fill.\n    pub func fill(out: f32[]):\n        _ = out\n\npub func twice(x: i64) -> i64:\n    return x * 2\n"
    assert(base_line(text, "Mesh", "") == 4)
    assert(base_line(text, "Mesh", "count") == 5)
    assert(base_line(text, "Mesh", "fill") == 8)
    assert(base_line(text, "Mesh", "missing") == 0)
    assert(base_line(text, "twice", "") == 11)
    assert(base_line(text, "Mes", "") == 0)
