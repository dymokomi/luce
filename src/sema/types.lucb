#==============================================================================================
#
#   types - Interned types
#
#   DESCRIPTION:
#       Every type the checker names lives once in a `Table` and is referred to by its
#       index, so two equal types have one id and equality is an integer compare. The
#       scalars are pre-seeded at fixed ids. Nominal types (structs, enums, classes,
#       interfaces) are identified by their declaration node and their type arguments;
#       structural ones (tuples, optionals, results, functions, lists, maps, sets, ranges,
#       tasks, weak references) by their parts. There is no layout here: Base lays out what
#       the emitter writes.
#
#==============================================================================================

import front.ast
import io
import support.list

pub enum Kind as u8:
    error_ = 1
    never_ = 2
    unit_ = 3
    bool_ = 4
    int_ = 5
    float_ = 6
    str_ = 7
    bytes_ = 8
    error_code = 9
    error_value = 10
    range_ = 11
    ## a `none` whose optional type is not yet known
    untyped_none = 12
    ## `Self` inside an interface: the conforming type, substituted per conformance (§13.3)
    self_ = 13
    tuple = 20
    optional = 21
    fallible = 22
    func_ = 23
    list_ = 24
    map_ = 25
    set_ = 26
    task_ = 27
    weak_ = 28
    struct_ = 40
    enum_ = 41
    class_ = 42
    interface_ = 43
    param = 44
    module = 45
    type_name = 46

# mark: Fixed ids ==============================================================================

pub let none_id: u32 = 0
pub let error_id: u32 = 1
pub let never_id: u32 = 2
pub let unit_id: u32 = 3
pub let bool_id: u32 = 4
pub let int_id: u32 = 5
pub let float_id: u32 = 6
pub let str_id: u32 = 7
pub let bytes_id: u32 = 8
pub let error_code_id: u32 = 9
pub let error_value_id: u32 = 10
pub let range_id: u32 = 11
pub let untyped_none_id: u32 = 12
pub let self_id: u32 = 13
let seeded: u32 = 14

func zero_index(index: u32[]):
    var i: usize = 0
    while i < index.length:
        index[i] = 0
        i += 1

## A hash of what `same_type` compares: the structure, and the name where it counts.
func structure_hash(t: Type) -> u64:
    var h = mix(0x9e3779b97f4a7c15, (u64)t.kind)
    h = mix(h, (u64)t.elem)
    if let d = t.decl:
        h = mix(h, (u64)(usize)d)
    for arg in t.args:
        h = mix(h, (u64)arg)
    if t.decl == none or t.kind == Kind.param:
        for byte in t.name.bytes:
            h = mix(h, (u64)byte)
    return h

func mix(h: u64, x: u64) -> u64:
    var r = h ^ x
    r = r *% 11400714819323198485
    return r ^ (r >> 29)

# mark: The type record ========================================================================

pub struct Type:
    pub var kind: Kind
    ## The element, payload, key, or result, by id; `none_id` when absent.
    pub var elem: u32
    ## Tuple members, function parameters, a map's value, or a generic instance's arguments.
    pub var args: u32[]
    ## Nominal types: the declaration; generic instances: the same declaration plus `args`.
    pub var decl: ast.Node*?
    pub var name: str

pub func no_args() -> u32[]!:
    return try alloc u32[0]

func types_tuple_kind() -> Kind:
    return Kind.tuple

# mark: The table ==============================================================================

## The struct and enum types a structural walk is inside, kept behind a pointer so a
## walk in a non-mutating method may note where it is.
pub struct Walk:
    pub var ids: u32[]
    pub var count: usize

pub struct Table:
    var types: list.List[Type]
    ## An open-addressing index from a type's structure to its id + 1 (0 marks an empty
    ## bucket), so `intern` is a lookup rather than a scan over every type so far.
    var index: u32[]
    var walk: Walk*

    pub static func create() -> Table!:
        let walk = try new Walk(ids = try alloc u32[64], count = 0)
        var t = Table(types = try list.List[Type].create(256), index = try alloc u32[1024], walk = walk)
        zero_index(t.index)
        let seeds: Kind[14] = [Kind.error_, Kind.error_, Kind.never_, Kind.unit_, Kind.bool_, Kind.int_, Kind.float_, Kind.str_, Kind.bytes_, Kind.error_code, Kind.error_value, Kind.range_, Kind.untyped_none, Kind.self_]
        let names: str[14] = ["", "<error>", "never", "unit", "bool", "int", "float", "str", "bytes", "ErrorCode", "Error", "range", "none", "Self"]
        var i: usize = 0
        while i < (usize)seeded:
            try t.types.push(Type(kind = seeds[i], elem = 0, args = try no_args(), decl = none, name = names[i]))
            i += 1
        i = 0
        while i < t.types.count:
            t.index_add(u32(i))
            i += 1
        return t

    pub func get(id: u32) -> Type:
        return self.types.get((usize)id)

    pub func kind(id: u32) -> Kind:
        return self.types.get((usize)id).kind

    pub func count() -> u32:
        return u32(self.types.count)

    func same_args(a: const u32[], b: const u32[]) -> bool:
        if a.length != b.length:
            return false
        var i: usize = 0
        while i < a.length:
            if a[i] != b[i]:
                return false
            i += 1
        return true

    ## The id of a type equal to `t`, adding it when new.
    pub mutating func intern(t: Type) -> u32!:
        let mask = self.index.length - 1
        var at = (usize)structure_hash(t) & mask
        while self.index[at] != 0:
            let id = self.index[at] - 1
            if id >= seeded and self.same_type(self.types.get((usize)id), t):
                return id
            at = (at + 1) & mask
        let id = u32(self.types.count)
        try self.types.push(t)
        if self.types.count * 2 > self.index.length:
            try self.grow_index()
        else:
            self.index_add(id)
        return id

    func same_type(have: Type, t: Type) -> bool:
        if have.kind != t.kind or have.elem != t.elem or have.decl != t.decl or not self.same_args(have.args, t.args):
            return false
        if t.kind == Kind.param:
            return have.name == t.name
        return have.decl != none or have.name == t.name

    mutating func index_add(id: u32):
        let mask = self.index.length - 1
        var at = (usize)structure_hash(self.types.get((usize)id)) & mask
        while self.index[at] != 0:
            at = (at + 1) & mask
        self.index[at] = id + 1

    mutating func grow_index() -> !:
        let old = self.index
        self.index = try alloc u32[old.length * 2]
        zero_index(self.index)
        var i: usize = 0
        while i < self.types.count:
            self.index_add(u32(i))
            i += 1
        free(old)

    func plain(kind: Kind, elem: u32, name: str) -> Type!:
        return Type(kind = kind, elem = elem, args = try no_args(), decl = none, name = name)

    # -- constructors ---------------------------------------------------------------------

    pub mutating func optional(elem: u32) -> u32!:
        if self.kind(elem) == Kind.optional:
            return elem
        return try self.intern(try self.plain(Kind.optional, elem, ""))

    pub mutating func fallible(elem: u32) -> u32!:
        if self.kind(elem) == Kind.fallible:
            return elem
        return try self.intern(try self.plain(Kind.fallible, elem, ""))

    pub mutating func tuple(members: u32[]) -> u32!:
        var t = try self.plain(Kind.tuple, 0, "")
        t.args = members
        return try self.intern(t)

    pub mutating func function(params: u32[], result: u32) -> u32!:
        var t = try self.plain(Kind.func_, result, "")
        t.args = params
        return try self.intern(t)

    pub mutating func list_of(elem: u32) -> u32!:
        return try self.intern(try self.plain(Kind.list_, elem, ""))

    pub mutating func set_of(elem: u32) -> u32!:
        return try self.intern(try self.plain(Kind.set_, elem, ""))

    pub mutating func map_of(key: u32, value: u32) -> u32!:
        var t = try self.plain(Kind.map_, key, "")
        var args = try alloc u32[1]
        args[0] = value
        t.args = args
        return try self.intern(t)

    pub mutating func task_of(elem: u32) -> u32!:
        return try self.intern(try self.plain(Kind.task_, elem, ""))

    pub mutating func weak_of(elem: u32) -> u32!:
        return try self.intern(try self.plain(Kind.weak_, elem, ""))

    ## A nominal type for a declaration; the same declaration yields the same id.
    pub mutating func nominal(kind: Kind, decl: ast.Node*, args: u32[]) -> u32!:
        return try self.nominal_as(kind, decl, args, decl.text)

    ## The same, under the name the emitter writes (a module-qualified one, §15).
    pub mutating func nominal_as(kind: Kind, decl: ast.Node*, args: u32[], name: str) -> u32!:
        var t = try self.plain(kind, 0, name)
        t.decl = decl
        t.args = args
        return try self.intern(t)

    ## A generic parameter of a declaration.
    pub mutating func parameter(decl: ast.Node*, name: str) -> u32!:
        var t = try self.plain(Kind.param, 0, name)
        t.decl = decl
        return try self.intern(t)

    ## A module, as the type of its name in an expression.
    pub mutating func module(decl: ast.Node*) -> u32!:
        var t = try self.plain(Kind.module, 0, decl.text)
        t.decl = decl
        return try self.intern(t)

    # -- predicates -----------------------------------------------------------------------

    pub func is_numeric(id: u32) -> bool:
        return id == int_id or id == float_id

    pub func is_scalar(id: u32) -> bool:
        return id == int_id or id == float_id or id == bool_id or id == str_id or id == bytes_id or id == unit_id

    ## A value type (§4.4): copied on assignment, compared by structure.
    pub func is_value(id: u32) -> bool:
        let t = self.get(id)
        match t.kind:
            .int_, .float_, .bool_, .str_, .bytes_, .unit_, .error_code, .error_value, .range_, .struct_, .enum_, .tuple: return true
            .optional, .fallible: return self.is_value(t.elem)
            _: return false

    ## A reference type (§10, §11): shared on assignment, compared by identity.
    pub func is_reference(id: u32) -> bool:
        let k = self.kind(id)
        return k == Kind.class_ or k == Kind.list_ or k == Kind.map_ or k == Kind.set_ or k == Kind.task_ or k == Kind.weak_ or k == Kind.func_ or k == Kind.interface_

    ## The type with every `Self` in it replaced by `owner`: what an interface's signature
    ## means for one conforming type (§13.3).
    pub mutating func substitute(id: u32, owner: u32) -> u32!:
        if id == self_id:
            return owner
        let t = self.get(id)
        match t.kind:
            .optional: return try self.optional(try self.substitute(t.elem, owner))
            .fallible: return try self.fallible(try self.substitute(t.elem, owner))
            .list_: return try self.list_of(try self.substitute(t.elem, owner))
            .set_: return try self.set_of(try self.substitute(t.elem, owner))
            .weak_: return try self.weak_of(try self.substitute(t.elem, owner))
            .map_: return try self.map_of(try self.substitute(t.elem, owner), try self.substitute(self.map_value(id), owner))
            .tuple, .func_:
                var args = try alloc u32[t.args.length if t.args.length > 0 else 1]
                var i: usize = 0
                var changed = false
                while i < t.args.length:
                    args[i] = try self.substitute(t.args[i], owner)
                    if args[i] != t.args[i]:
                        changed = true
                    i += 1
                if t.kind == types_tuple_kind():
                    return try self.tuple(args[..<t.args.length]) if changed else id
                let result = try self.substitute(t.elem, owner)
                if not changed and result == t.elem:
                    return id
                return try self.function(args[..<t.args.length], result)
            _: return id

    ## Whether a value of the type can hold a reference the runtime counts (§10): a class,
    ## a weak reference, or a value type with one inside.
    pub func has_references(id: u32) -> bool:
        return self.references_at(id, 0)

    ## The same, bounded: a type holding itself through a payload is taken to hold
    ## references where the walk meets it again.
    func references_at(id: u32, depth: u32) -> bool:
        if depth > 32:
            return true
        let k = self.kind(id)
        if k == Kind.struct_ or k == Kind.enum_:
            # a type holding itself through a payload is walked once, not once per path
            let w = self.walk
            var i: usize = 0
            while i < w.count:
                if w.ids[i] == id:
                    return true
                i += 1
            if w.count >= w.ids.length:
                return true
            w.ids[w.count] = id
            w.count += 1
            let answer = self.references_walk(id, depth)
            w.count -= 1
            return answer
        return self.references_walk(id, depth)

    func references_walk(id: u32, depth: u32) -> bool:
        let t = self.get(id)
        match t.kind:
            # a function value is a closure object (§7.4); an interface value a box (§13.2)
            .class_, .weak_, .list_, .map_, .set_, .task_, .func_, .interface_, .param: return true
            # a compiled text is a counted object of the runtime (RUNTIME)
            .str_, .bytes_, .error_value: return true
            .optional, .fallible: return self.references_at(t.elem, depth + 1)
            .tuple:
                for m in t.args:
                    if self.references_at(m, depth + 1):
                        return true
                return false
            .struct_, .enum_:
                let d = t.decl else return false
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.references_at(m.type_id, depth + 1):
                        return true
                    if m.kind == ast.Kind.enum_case:
                        var p = m.body
                        while let field = p:
                            if self.references_at(field.type_id, depth + 1):
                                return true
                            p = field.next
                    cursor = m.next
                return false
            _: return false

    ## The map's value type.
    pub func map_value(id: u32) -> u32:
        let t = self.get(id)
        if t.args.length == 0:
            return none_id
        return t.args[0]

    # -- spelling -------------------------------------------------------------------------

    ## The type as a programmer would write it, into `out`.
    pub func describe(out: io.Writer, id: u32) -> !:
        let t = self.get(id)
        match t.kind:
            .tuple:
                try out.write("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try out.write(", ")
                    try self.describe(out, t.args[i])
                    i += 1
                if t.args.length == 1:
                    try out.write(",")
                try out.write(")")
            .optional:
                try self.describe(out, t.elem)
                try out.write("?")
            .fallible:
                try self.describe(out, t.elem)
                try out.write("!")
            .func_:
                try out.write("func(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try out.write(", ")
                    try self.describe(out, t.args[i])
                    i += 1
                try out.write(")")
                if t.elem != unit_id:
                    try out.write(" -> ")
                    try self.describe(out, t.elem)
            .list_:
                try out.write("list[")
                try self.describe(out, t.elem)
                try out.write("]")
            .set_:
                try out.write("set[")
                try self.describe(out, t.elem)
                try out.write("]")
            .map_:
                try out.write("map[")
                try self.describe(out, t.elem)
                try out.write(", ")
                try self.describe(out, self.map_value(id))
                try out.write("]")
            .task_:
                try out.write("task[")
                try self.describe(out, t.elem)
                try out.write("]")
            .weak_:
                try out.write("Weak[")
                try self.describe(out, t.elem)
                try out.write("]")
            .struct_, .enum_, .class_, .interface_:
                if let d = t.decl:
                    if d.has(ast.flag_instance):
                        # `Pair[int, str]`: the generic declaration's name and the arguments
                        let generic = d.resolved else return
                        try out.write(generic.text)
                        try out.write("[")
                        var first = true
                        if let params = d.ty:
                            var cursor = params.body
                            while let p = cursor:
                                if not first:
                                    try out.write(", ")
                                first = false
                                try self.describe(out, p.type_id)
                                cursor = p.next
                        try out.write("]")
                        return
                    # the source name; the type's own is what the emitter writes
                    try out.write(d.text)
                    return
                try out.write(t.name)
                if t.args.length > 0:
                    try out.write("[")
                    var i: usize = 0
                    while i < t.args.length:
                        if i > 0:
                            try out.write(", ")
                        try self.describe(out, t.args[i])
                        i += 1
                    try out.write("]")
            .module:
                try out.write("module ")
                try out.write(t.name)
            _:
                try out.write(t.name)

test "scalars are seeded and structural types intern once":
    var table = try Table.create()
    assert(table.kind(int_id) == Kind.int_)
    let a = try table.optional(int_id)
    let b = try table.optional(int_id)
    assert(a == b)
    assert(try table.optional(a) == a)
    let l1 = try table.list_of(str_id)
    let l2 = try table.list_of(str_id)
    assert(l1 == l2)
    assert(try table.list_of(int_id) != l1)
    let m = try table.map_of(str_id, int_id)
    assert(table.map_value(m) == int_id)
    assert(table.is_value(int_id))
    assert(not table.is_value(l1))
    assert(table.is_reference(m))
