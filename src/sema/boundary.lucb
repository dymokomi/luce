## What a Luce module sees of a Base module (§16.1): the description luce-base prints
## for it, read into declarations of Luce's own kinds. A `func` becomes a function without
## a body, a `let` a constant without a value, a `struct` and an integer-backed `enum`
## the same types, a `handle` a class with a `close()`, an alias its type; every one of
## them is `pub`. A declaration whose signature mentions a type of Base's own, a pointer,
## a span of the uncrossable, a `c` type, is left out, as §16.1 says.
import front.ast
import support.list

pub let invalid_description: ErrorCode = ErrorCode.package(27)

## The declarations read from a description, as a module's tree.
pub func read(text: str, name: str) -> ast.Node*!:
    if not starts_with(text, "description 3\nmodule "):
        error(invalid_description, "the Base description format does not match Luce; rebuild both compilers together")
    let tree = try ast.Node.make(ast.Kind.module, name, 0, 1)
    var reader = Reader(text = text, at = 0, line = 0, tree = tree, tail = none, names = try list.List[str].create(16), kinds = try list.List[u8].create(16))
    try reader.read_all()
    # a struct left out for a field of Base's own, and whatever mentions it, leaves the tree
    var changed = true
    while changed:
        changed = false
        var kept: ast.Node*? = none
        var kept_tail: ast.Node*? = none
        var cursor = tree.body
        while let d = cursor:
            let next = d.next
            d.next = none
            if d.has(flag_dropped) or mentions_dropped(&reader, d):
                changed = changed or not d.has(flag_dropped)
                d.flags |= flag_dropped
                reader.drop_name(d.text)
            else:
                ast.append(&kept, &kept_tail, d)
            cursor = next
        tree.body = kept
    return tree

## Whether a declaration's signature names a type that was dropped.
func mentions_dropped(reader: Reader*, d: ast.Node*) -> bool:
    if d.kind == ast.Kind.class_:
        return false
    if type_mentions_dropped(reader, d.ty) or type_mentions_dropped(reader, d.left):
        return d.kind != ast.Kind.constant or type_mentions_dropped(reader, d.ty)
    var cursor = d.right if d.kind == ast.Kind.func_ else d.body
    while let m = cursor:
        if type_mentions_dropped(reader, m.ty):
            return true
        if m.kind == ast.Kind.func_ and mentions_dropped(reader, m):
            return true
        cursor = m.next
    if d.kind == ast.Kind.struct_ or d.kind == ast.Kind.enum_:
        cursor = d.right
        while let conformance = cursor:
            if type_mentions_dropped(reader, conformance):
                return true
            cursor = conformance.next
    return false

func type_mentions_dropped(reader: Reader*, t: ast.Node*?) -> bool:
    let n = t else return false
    if n.kind == ast.Kind.type_ and n.body == none and n.left == none and n.right == none and reader.kind_of(n.text) == kind_opaque and reader.declared(n.text):
        return true
    if type_mentions_dropped(reader, n.left) or type_mentions_dropped(reader, n.right):
        return true
    var cursor = n.body
    while let m = cursor:
        if type_mentions_dropped(reader, m):
            return true
        cursor = m.next
    return false

## A type name the module declares, by what it is: a struct, an enum, a handle, or an
## alias to a type that crosses; anything else is Base's own.
let kind_struct: u8 = 1
let kind_enum: u8 = 2
let kind_handle: u8 = 3
let kind_alias: u8 = 4
let kind_opaque: u8 = 5
let kind_interface: u8 = 6

struct Reader:
    var text: str
    var at: usize
    var line: u32
    var tree: ast.Node*
    var tail: ast.Node*?
    var names: list.List[str]
    var kinds: list.List[u8]

    ## Two passes: the names the module declares, then the declarations, so a struct may
    ## mention one declared after it.
    mutating func read_all() -> !:
        try self.collect_names()
        self.at = 0
        self.line = 0
        var pending: ast.Node*? = none
        while self.at < self.text.length:
            let raw = self.next_line()
            self.line += 1
            if raw.length == 0:
                continue
            if starts_with(raw, "    "):
                # a field or a case of the declaration above
                let d = pending else continue
                try self.member(d, (str)raw.bytes[4..])
                continue
            pending = try self.declaration(raw)

    mutating func collect_names() -> !:
        while self.at < self.text.length:
            let raw = self.next_line()
            if starts_with(raw, "struct "):
                try self.remember((str)raw.bytes[7..], kind_struct)
            elif starts_with(raw, "interface "):
                try self.remember((str)raw.bytes[10..], kind_interface)
            elif starts_with(raw, "unavailable "):
                let rest = (str)raw.bytes[12..]
                let space = index_of(rest, ' ') else continue
                try self.remember((str)rest.bytes[..<space], kind_opaque)
            elif starts_with(raw, "enum "):
                let rest = (str)raw.bytes[5..]
                let space = index_of(rest, ' ') else return
                try self.remember((str)rest.bytes[..<space], kind_enum)
            elif starts_with(raw, "handle "):
                let rest = (str)raw.bytes[7..]
                let space = index_of(rest, ' ') else return
                try self.remember((str)rest.bytes[..<space], kind_handle)
            elif starts_with(raw, "type "):
                let rest = (str)raw.bytes[5..]
                let space = index_of(rest, ' ') else return
                try self.remember((str)rest.bytes[..<space], kind_alias)
            elif starts_with(raw, "foreign "):
                let rest = (str)raw.bytes[8..]
                let space = index_of(rest, ' ') else return
                let name = (str)rest.bytes[..<space]
                let spelling = (str)rest.bytes[space + 1..]
                var kind = kind_opaque
                if spelling == "handle":
                    kind = kind_handle
                elif spelling == "struct":
                    kind = kind_struct
                elif spelling == "enum":
                    kind = kind_enum
                elif spelling == "interface":
                    kind = kind_interface
                if let dot = index_of(name, '.'):
                    if self.declared((str)name.bytes[..<dot]):
                        kind = kind_opaque
                try self.remember(name, kind)
            elif starts_with(raw, "standard "):
                let rest = (str)raw.bytes[9..]
                let space = index_of(rest, ' ') else return
                let after = (str)rest.bytes[space..]
                if starts_with(after, " as "):
                    # Standard type imports need their own module-loading path.
                    # Until I09 supplies it, retain them as explicitly unavailable.
                    try self.remember((str)after.bytes[4..], kind_opaque)

    mutating func remember(name: str, kind: u8) -> !:
        try self.names.push(name)
        try self.kinds.push(kind)

    ## Whether the module declared the name at all (dropped ones are opaque and declared).
    func declared(name: str) -> bool:
        var i: usize = 0
        while i < self.names.count:
            if self.names.get(i) == name:
                return true
            i += 1
        return false

    mutating func drop_name(name: str):
        var i: usize = 0
        while i < self.names.count:
            if self.names.get(i) == name:
                self.kinds.set(i, kind_opaque)
            i += 1

    func kind_of(name: str) -> u8:
        var i: usize = 0
        while i < self.names.count:
            if self.names.get(i) == name:
                return self.kinds.get(i)
            i += 1
        return kind_opaque

    mutating func next_line() -> str:
        let start = self.at
        while self.at < self.text.length and self.text.bytes[self.at] != '\n':
            self.at += 1
        let line = (str)self.text.bytes[start..<self.at]
        if self.at < self.text.length:
            self.at += 1
        return line

    ## One declaration line; `none` when it is Base's own.
    mutating func declaration(raw: str) -> ast.Node*?!:
        if starts_with(raw, "import "):
            let rest = (str)raw.bytes[7..]
            let space = index_of(rest, ' ') else return none
            let after = (str)rest.bytes[space..]
            if not starts_with(after, " as "):
                return none
            let d = try self.node(ast.Kind.import_, (str)rest.bytes[..<space])
            d.left = try self.node(ast.Kind.name, (str)after.bytes[4..])
            try self.append(d)
            return none
        if starts_with(raw, "module "):
            return none
        if raw == "description 3" or starts_with(raw, "foreign ") or starts_with(raw, "standard ") or starts_with(raw, "unavailable "):
            return none
        if starts_with(raw, "func "):
            if let function = try self.function((str)raw.bytes[5..]):
                try self.append(function)
            return none
        if starts_with(raw, "let "):
            let rest = (str)raw.bytes[4..]
            let colon = index_of(rest, ':') else return none
            # Error codes are immutable scalar constants, including package identity.
            # Keep this separate from the broader function/aggregate boundary.
            let spelling = trim((str)rest.bytes[colon + 1..])
            let t = (try self.node(ast.Kind.type_, "ErrorCode")) if spelling == "ErrorCode" else (try self.type_node(spelling) else return none)
            let d = try self.node(ast.Kind.constant, (str)rest.bytes[..<colon])
            d.ty = t
            try self.append(d)
            return none
        if starts_with(raw, "struct "):
            let d = try self.node(ast.Kind.struct_, (str)raw.bytes[7..])
            try self.append(d)
            return d
        if starts_with(raw, "interface "):
            let d = try self.node(ast.Kind.interface_, (str)raw.bytes[10..])
            try self.append(d)
            return d
        if starts_with(raw, "enum "):
            let rest = (str)raw.bytes[5..]
            let space = index_of(rest, ' ') else return none
            let d = try self.node(ast.Kind.enum_, (str)rest.bytes[..<space])
            try self.append(d)
            return d
        if starts_with(raw, "handle "):
            let rest = (str)raw.bytes[7..]
            let space = index_of(rest, ' ') else return none
            let d = try self.node(ast.Kind.class_, (str)rest.bytes[..<space])
            let tail_text = (str)rest.bytes[space + 1..]
            if starts_with(tail_text, "destroy "):
                let destroy = try self.node(ast.Kind.name, (str)tail_text.bytes[8..])
                d.left = destroy
            # `close()`: the method every handle has (§16.4)
            let close = try self.node(ast.Kind.func_, "close")
            let receiver = try self.node(ast.Kind.param, "self")
            close.right = receiver
            close.flags |= ast.flag_pub | ast.flag_base
            d.body = close
            try self.append(d)
            return none
        if starts_with(raw, "type "):
            let rest = (str)raw.bytes[5..]
            let eq = index_of(rest, '=') else return none
            let t = try self.type_node(trim((str)rest.bytes[eq + 1..])) else return none
            let d = try self.node(ast.Kind.type_alias, trim((str)rest.bytes[..<eq]))
            d.ty = t
            try self.append(d)
            return none
        return none

    ## `name(p: T, q: U) -> R`
    mutating func function(rest: str) -> ast.Node*?!:
        let open = index_of(rest, '(') else return none
        let close = closing_paren(rest, open) else return none
        let d = try self.node(ast.Kind.func_, (str)rest.bytes[..<open])
        var params_tail: ast.Node*? = none
        let inside = (str)rest.bytes[open + 1..<close]
        var start: usize = 0
        var depth: u32 = 0
        var i: usize = 0
        while i <= inside.length:
            let end_of_param = i == inside.length or (inside.bytes[i] == ',' and depth == 0)
            if i < inside.length:
                if inside.bytes[i] == '(' or inside.bytes[i] == '[':
                    depth += 1
                elif inside.bytes[i] == ')' or inside.bytes[i] == ']':
                    depth -= 1
            if end_of_param:
                let piece = trim((str)inside.bytes[start..<i])
                if piece.length > 0:
                    let colon = index_of(piece, ':') else return none
                    let p = try self.node(ast.Kind.param, trim((str)piece.bytes[..<colon]))
                    p.ty = try self.declared_type(p, trim((str)piece.bytes[colon + 1..])) else return none
                    ast.append(&d.right, &params_tail, p)
                start = i + 1
            i += 1
        let after = trim((str)rest.bytes[close + 1..])
        if after.length > 0:
            if not starts_with(after, "->"):
                return none
            d.left = try self.type_node(trim((str)after.bytes[2..])) else return none
            if contains_list(d.left):
                return none
        return d

    ## Members use one record per fact: field mutability is part of the field,
    ## while constructors, methods and conformances preserve their own signatures.
    mutating func member(d: ast.Node*, raw: str) -> !:
        if raw == "representation private" or raw == "constructor private":
            # Until the native storage adapter is implemented, this type cannot
            # cross. Dropping it prevents silent loss of its private state.
            try self.drop(d)
            return
        if raw == "representation complete" or raw == "constructor memberwise" or starts_with(raw, "unavailable "):
            return
        if starts_with(raw, "conforms "):
            let conformance = try self.type_node((str)raw.bytes[9..]) else return try self.drop(d)
            append_member(&d.right, conformance)
            return
        let constructor = starts_with(raw, "constructor init(")
        let receiver_mutates = starts_with(raw, "mutating method ")
        let static_method = starts_with(raw, "static method ")
        if constructor or receiver_mutates or static_method or starts_with(raw, "method "):
            let offset: usize = 12 if constructor else (16 if receiver_mutates else (14 if static_method else 7))
            let method = try self.function((str)raw.bytes[offset..]) else return try self.drop(d)
            if not static_method:
                let receiver = try self.node(ast.Kind.param, "self")
                receiver.next = method.right
                method.right = receiver
            if receiver_mutates or constructor:
                method.flags |= ast.flag_mutating
            append_member(&d.body, method)
            return
        if d.kind == ast.Kind.struct_ and starts_with(raw, "field "):
            let mutable = starts_with(raw, "field var ")
            if not mutable and not starts_with(raw, "field let "):
                error(invalid_description, "a Base field description needs `var` or `let`")
            let rest = (str)raw.bytes[10..]
            let colon = index_of(rest, ':') else return
            let f = try self.node(ast.Kind.field, (str)rest.bytes[..<colon])
            let t = try self.declared_type(f, trim((str)rest.bytes[colon + 1..])) else return try self.drop(d)
            if self.contains_handle_list(t):
                return try self.drop(d)
            f.ty = t
            f.flags |= ast.flag_pub
            if mutable:
                f.flags |= ast.flag_var_field
            var tail = d.body
            while let m = tail:
                if m.next == none:
                    break
                tail = m.next
            if let last = tail:
                last.next = f
            else:
                d.body = f
            return
        if d.kind == ast.Kind.enum_ and starts_with(raw, "case "):
            let rest = (str)raw.bytes[5..]
            let space = index_of(rest, ' ') else return
            let c = try self.node(ast.Kind.enum_case, (str)rest.bytes[..<space])
            var tail = d.body
            while let m = tail:
                if m.next == none:
                    break
                tail = m.next
            if let last = tail:
                last.next = c
            else:
                d.body = c

    ## A struct with a field Base's own is Base's own: it leaves the tree.
    mutating func drop(d: ast.Node*) -> !:
        d.flags |= flag_dropped
        var i: usize = 0
        while i < self.names.count:
            if self.names.get(i) == d.text:
                self.kinds.set(i, kind_opaque)
            i += 1

    func contains_handle_list(t: ast.Node*) -> bool:
        if t.text == "list":
            let element = t.body else return false
            return self.kind_of(element.text) == kind_handle
        if let inner = t.left:
            return self.contains_handle_list(inner)
        return false

    mutating func node(kind: ast.Kind, text: str) -> ast.Node*!:
        let n = try ast.Node.make(kind, text, 0, self.line)
        n.flags |= ast.flag_pub | ast.flag_base | ast.flag_checked
        return n

    mutating func append(d: ast.Node*) -> !:
        ast.append(&self.tree.body, &self.tail, d)

    ## Default expressions stay in their checked Base module. Only availability
    ## crosses; call adapters omit these arguments so Base applies its own default.
    mutating func declared_type(declaration: ast.Node*, spelling: str) -> ast.Node*?!:
        if let equal = index_of(spelling, '='):
            let mode = trim((str)spelling.bytes[equal + 1..])
            if mode != "default" and mode != "caller.file" and mode != "caller.function":
                return none
            declaration.left = try self.node(ast.Kind.native_default, mode)
            return try self.type_node(trim((str)spelling.bytes[..<equal]))
        return try self.type_node(spelling)

    ## The Luce type a Base spelling crosses as (§16.2), or none when it does not cross.
    mutating func type_node(spelling: str) -> ast.Node*?!:
        var s = spelling
        if s.length == 0:
            return none
        let last = s.bytes[s.length - 1]
        if starts_with(s, "func("):
            let close = closing_paren(s, 4) else return none
            let t = try self.node(ast.Kind.type_, "func")
            t.flags |= ast.flag_func_type
            let inside = (str)s.bytes[5..<close]
            var tail: ast.Node*? = none
            var start: usize = 0
            var depth: u32 = 0
            var i: usize = 0
            while i <= inside.length:
                let end_of_param = i == inside.length or (inside.bytes[i] == ',' and depth == 0)
                if i < inside.length:
                    if inside.bytes[i] == '(' or inside.bytes[i] == '[':
                        depth += 1
                    elif inside.bytes[i] == ')' or inside.bytes[i] == ']':
                        depth -= 1
                if end_of_param:
                    let piece = trim((str)inside.bytes[start..<i])
                    if piece.length > 0:
                        let a = try self.type_node(piece) else return none
                        if not (a.text == "int" or a.text == "float" or a.text == "bool" or a.text == "str" or a.text == "bytes"):
                            return none
                        ast.append(&t.body, &tail, a)
                    start = i + 1
                i += 1
            let after = trim((str)s.bytes[close + 1..])
            if after.length > 0:
                if not starts_with(after, "->"):
                    return none
                let r = try self.type_node(trim((str)after.bytes[2..])) else return none
                # a callback answers a scalar: a text it answered would have no owner
                if not (r.text == "int" or r.text == "float" or r.text == "bool" or (r.has(ast.flag_tuple_type) and r.body == none)):
                    return none
                t.right = r
            return t
        if last == '!':
            let inner = trim((str)s.bytes[..<s.length - 1])
            let t = try self.node(ast.Kind.type_, "!")
            t.flags |= ast.flag_fallible
            if inner.length == 0:
                let nothing = try self.node(ast.Kind.type_, "()")
                nothing.flags |= ast.flag_tuple_type
                t.left = nothing
            else:
                t.left = try self.type_node(inner) else return none
            return t
        if last == '?':
            let inner = trim((str)s.bytes[..<s.length - 1])
            let t = try self.node(ast.Kind.type_, "?")
            t.flags |= ast.flag_optional
            t.left = try self.type_node(inner) else return none
            return t
        if s.bytes[0] == '(' and last == ')':
            let close = closing_paren(s, 0) else return none
            if close != s.length - 1:
                return none
            let t = try self.node(ast.Kind.type_, "()")
            t.flags |= ast.flag_tuple_type
            var tail: ast.Node*? = none
            var start: usize = 1
            var depth: usize = 0
            var i: usize = 1
            while i <= close:
                if i == close or (s.bytes[i] == ',' and depth == 0):
                    let piece = trim((str)s.bytes[start..<i])
                    if piece.length > 0:
                        let element = try self.type_node(piece) else return none
                        ast.append(&t.body, &tail, element)
                    start = i + 1
                elif s.bytes[i] == '(' or s.bytes[i] == '[':
                    depth += 1
                elif s.bytes[i] == ')' or s.bytes[i] == ']':
                    depth -= 1
                i += 1
            return t
        if starts_with(s, "const ") and s.length > 8 and (str)s.bytes[s.length - 2..] == "[]":
            let elem = trim((str)s.bytes[6..<s.length - 2])
            if elem == "u8":
                return try self.node(ast.Kind.type_, "bytes")
            let t = try self.node(ast.Kind.type_, "list")
            let e = try self.type_node(elem) else return none
            # Handle lists use a temporary array of unwrapped Base handles. As with
            # text spans, the callee must copy/retain anything it keeps after return.
            let plain = (e.text == "int" and not e.has(ast.flag_usize)) or e.text == "float" or e.text == "bool" or e.text == "str" or self.kind_of(e.text) == kind_handle
            if not plain:
                return none
            t.body = e
            return t
        if s == "unit":
            let t = try self.node(ast.Kind.type_, "()")
            t.flags |= ast.flag_tuple_type
            return t
        if s == "i64":
            return try self.node(ast.Kind.type_, "int")
        if s == "usize":
            let t = try self.node(ast.Kind.type_, "int")
            t.flags |= ast.flag_usize
            return t
        if s == "f64":
            return try self.node(ast.Kind.type_, "float")
        if s == "bool":
            return try self.node(ast.Kind.type_, "bool")
        if s == "str":
            return try self.node(ast.Kind.type_, "str")
        # A qualified public type has the identity of its imported declaration;
        # that module's complete description determines whether it can cross.
        let named = self.kind_of(s)
        if named == kind_struct or named == kind_enum or named == kind_handle or named == kind_alias or named == kind_interface:
            return try self.node(ast.Kind.type_, s)
        return none

## A struct left out for a field of Base's own; the checker never sees it.
pub let flag_dropped: u32 = 4194304

func append_member(first: ast.Node*?*, member: ast.Node*):
    var tail = *first
    while let item = tail:
        if item.next == none:
            break
        tail = item.next
    ast.append(first, &tail, member)

func contains_list(t: ast.Node*?) -> bool:
    let node = t else return false
    if node.text == "list" or contains_list(node.left) or contains_list(node.right):
        return true
    var cursor = node.body
    while let child = cursor:
        if contains_list(child):
            return true
        cursor = child.next
    return false

func starts_with(text: str, prefix: str) -> bool:
    if text.length < prefix.length:
        return false
    return (str)text.bytes[..<prefix.length] == prefix

func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    while start < end and text.bytes[start] == ' ':
        start += 1
    while end > start and text.bytes[end - 1] == ' ':
        end -= 1
    return (str)text.bytes[start..<end]

func index_of(text: str, byte: u8) -> usize?:
    var i: usize = 0
    while i < text.length:
        if text.bytes[i] == byte:
            return i
        i += 1
    return none

## Find the close of this parameter list, without consuming a tuple/callback result.
func closing_paren(text: str, open: usize) -> usize?:
    var depth: usize = 0
    var i = open
    while i < text.length:
        if text.bytes[i] == '(':
            depth += 1
        elif text.bytes[i] == ')':
            if depth == 0:
                return none
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return none

test "a description reads into declarations that cross":
    let tree = try read("description 3\nmodule counters\nhandle Counter destroy release\nstruct Counted\n    representation complete\n    constructor memberwise\n    field var count: i64\nenum Mode as u32\n    case read = 0\n    case write = 1\nlet limit: i64\nfunc open(start: i64) -> Counter!\nfunc bump(counter: Counter, by: usize) -> i64\nfunc release(counter: Counter)\nfunc raw(p: i32*) -> i64\nfunc names(items: const str[]) -> str?\n", "counters")
    var count: usize = 0
    var cursor = tree.body
    var last = ""
    while let d = cursor:
        count += 1
        last = d.text
        cursor = d.next
    assert(count == 8)
    assert(last == "names")

test "description format mismatches are rejected before declarations":
    let invalid = ["module old\n", "description 1\nmodule old\n", "description 4\nmodule future\n", "description 3\n"]
    for text in invalid:
        let tree = read(text, "wrong") catch failure:
            assert(failure.code == invalid_description)
            continue
        discard(tree)
        assert(false)

test "described constructors and methods preserve receiver and effect":
    let tree = try read("description 3\nmodule api\ninterface Gauge\n    method value() -> i64\nstruct Counter\n    representation complete\n    constructor init(start: i64) -> !\n    field var count: i64\n    method value() -> i64\n    mutating method increase(amount: i64) -> !\n    static method zero() -> Counter\n    conforms Gauge\n", "api")
    let gauge = tree.body else trap("missing described node")
    assert(gauge.kind == ast.Kind.interface_)
    let requirement = gauge.body else trap("missing described node")
    assert(requirement.text == "value")
    assert((requirement.right else trap("missing described node")).text == "self")
    let counter = gauge.next else trap("missing described node")
    let init = counter.body else trap("missing described node")
    assert(init.text == "init" and init.has(ast.flag_mutating))
    assert((init.left else trap("missing described node")).has(ast.flag_fallible))
    assert(((init.right else trap("missing described node")).next else trap("missing described node")).text == "start")
    let field = init.next else trap("missing described node")
    assert(field.kind == ast.Kind.field and field.has(ast.flag_var_field))
    let value = field.next else trap("missing described node")
    assert(value.text == "value" and not value.has(ast.flag_mutating))
    let increase = value.next else trap("missing described node")
    assert(increase.has(ast.flag_mutating))
    let zero = increase.next else trap("missing described node")
    assert(zero.text == "zero" and zero.right == none)
    assert((counter.right else trap("missing described node")).text == "Gauge")

test "incomplete native storage cannot degrade to public field copies":
    let tree = try read("description 3\nmodule api\nstruct Hidden\n    representation private\n    constructor memberwise\n    field var shown: i64\nfunc roundtrip(value: Hidden) -> Hidden\nstruct Nested\n    representation complete\n    constructor memberwise\n    field var child: Hidden\nfunc nested(value: Nested) -> Nested\nlet visible: i64\n", "api")
    let visible = tree.body else trap("missing described node")
    assert(visible.text == "visible" and visible.next == none)

test "private initializers cannot become public memberwise constructors":
    let tree = try read("description 3\nmodule api\nstruct Locked\n    representation complete\n    constructor private\n    field var marker: i64\nfunc make() -> Locked\n", "api")
    assert(tree.body == none)

test "native defaults and nested results preserve their signature structure":
    let tree = try read("description 3\nmodule api\nfunc sample(value: i64 = default, file: str = caller.file) -> (i64?, (str, bool))!\nfunc borrowed() -> (const str[], bool)\nfunc bad_callback(operation: func(i64) -> i64!)\n", "api")
    let sample = tree.body else trap("missing sample")
    assert(sample.next == none)
    let value = sample.right else trap("missing value")
    assert((value.left else trap("missing default")).kind == ast.Kind.native_default)
    let file = value.next else trap("missing caller")
    assert((file.left else trap("missing caller default")).text == "caller.file")
    let result = sample.left else trap("missing result")
    assert(result.has(ast.flag_fallible))
    let tuple = result.left else trap("missing tuple")
    assert(tuple.has(ast.flag_tuple_type) and ast.count(tuple.body) == 2)
