#==============================================================================================
#
#   standard - Luce's own standard modules
#
#   DESCRIPTION:
#       The modules every Luce program may import by bare name, shipped with the compiler and
#       run the same by the interpreter and a built program (§6.8): `math`, `text`,
#       `console` and `time`. They have no source: an import of one binds its name, and a call of one of
#       its functions is checked and run as the language's own, under its qualified name,
#       `math.abs`. A package module of the same name is never imported (§15.2).
#
#==============================================================================================

## The standard modules' names.
pub let modules: str[4] = ["math", "text", "console", "time"]

## Every function of the standard modules, qualified by its module: the name a call of it
## goes by once checked.
pub let functions: str[10] = [
    "math.abs", "math.min", "math.max", "math.round", "text.code_of", "text.from_code",
    "console.read_line", "time.sleep", "time.now", "time.unix"]

## Whether `name` is one of the standard modules.
pub func is_module(name: str) -> bool:
    for m in modules:
        if m == name:
            return true
    return false

## Whether `name` is a qualified function of a standard module, `math.abs`.
pub func is_function(name: str) -> bool:
    for f in functions:
        if f == name:
            return true
    return false

## The qualified name of `member` of the standard module `module`, `math.abs`; none when the
## module has no such function. The text is the table's own and lives as long as the program.
pub func qualified(module: str, member: str) -> str?:
    for f in functions:
        if f.length == module.length + 1 + member.length and (str)f.bytes[..<module.length] == module and f.bytes[module.length] == '.' and (str)f.bytes[module.length + 1..] == member:
            return f
    return none

test "the standard modules and their functions":
    assert(is_module("math"))
    assert(not is_module("io"))
    assert(is_function("text.code_of"))
    assert(not is_function("abs"))
    let found = qualified("math", "round") else return
    assert(found == "math.round")
    assert(qualified("math", "code_of") == none)
    assert(qualified("console", "read_line") != none)
    assert(qualified("time", "sleep") != none)
