#==============================================================================================
#
#   bodies/builtins - The core functions and the standard modules' functions
#
#   DESCRIPTION:
#       `print`, `assert`, `trap`, `error`, the conversions, `Weak`, a value's `hash()` and
#       the functions of the standard modules (§6.8), typed; and the specification of a
#       formatted string's field checked against the value it formats (§3.3).
#
#==============================================================================================

import numerals
import support.number_text

# mark: Core functions =========================================================================

## The language's own functions (§2.4, §6.5, §12.4).
func core_call(c: check.Checker*, e: ast.Node*, name: str) -> u32!:
    let n = ast.count(e.body)
    if name == "print":
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return try c.fail(a, "empty argument")
            if a.text.length > 0:
                return try c.fail(a, "`print` takes positional arguments")
            let t = try check_expr(c, v, types.none_id)
            try require_display(c, v, t)
            cursor = a.next
        return types.unit_id
    if name == "assert":
        if n < 1 or n > 2:
            return try c.fail(e, "`assert(condition)` or `assert(condition, message)`")
        let first = e.body else return try c.fail(e, "no condition")
        let cond = first.left else return try c.fail(e, "no condition")
        _ = try expect(c, cond, types.bool_id)
        # the condition as written, which a failure names (§17.3)
        let written = c.modules.get(c.current).src.bytes
        e.text = (str)written[first.start..<first.end] if first.end > first.start else ""
        if let second = first.next:
            let m = second.left else return try c.fail(second, "empty argument")
            _ = try expect(c, m, types.str_id)
        # in a test's own body, a lambda's excepted, a false condition fails the test (§17.3)
        if let f = c.current_func:
            if f.kind == ast.Kind.test_:
                e.flags |= ast.flag_test_assert
        return types.unit_id
    if name == "trap":
        if n != 1:
            return try c.fail(e, "`trap(message)` takes one text")
        let first = e.body else return try c.fail(e, "no message")
        let m = first.left else return try c.fail(e, "no message")
        _ = try expect(c, m, types.str_id)
        return types.never_id
    if name == "error":
        if not c.fallible and not c.handled_effect:
            return try c.fail(e, "`error` belongs in a function whose result is `!` (§12.2)")
        if n != 2:
            return try c.fail(e, "`error(code, message)` takes a code and a text")
        let first = e.body else return try c.fail(e, "no code")
        let code = first.left else return try c.fail(e, "no code")
        let second = first.next else return try c.fail(e, "no message")
        let message = second.left else return try c.fail(e, "no message")
        _ = try expect(c, code, types.error_code_id)
        _ = try expect(c, message, types.str_id)
        return try c.table.fallible(types.never_id)
    if name == "int":
        return try int_call_type(c, e)
    if name == "float" or name == "str" or name == "bool":
        if n != 1:
            return try c.fail(e, try c.named("", name, "(value) takes one value"))
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if name == "float":
            if t == types.int_id: return types.float_id
            if t == types.str_id: return try c.table.fallible(types.float_id)
            return try c.fail(v, "`float(...)` converts an `int` or parses a `str` (§6.5)")
        if name == "bool":
            if t == types.str_id: return try c.table.fallible(types.bool_id)
            return try c.fail(v, "`bool(...)` parses a `str` (§6.5)")
        try require_display(c, v, t)
        return types.str_id
    if name == "Weak":
        let first = e.body else return try c.fail(e, "`Weak(object)` takes a class instance (§10.4)")
        let v = first.left else return try c.fail(e, "no value")
        if n != 1 or first.text.length > 0:
            return try c.fail(e, "`Weak(object)` takes one class instance (§10.4)")
        let t = try check_expr(c, v, types.none_id)
        if c.table.kind(t) != types.Kind.class_:
            return try c.fail(v, try c.with_type("`Weak` holds a class instance, not a `", t, "` (§10.4)"))
        return try c.table.weak_of(t)
    if standard.is_function(name):
        return try standard_function_type(c, e, name)
    if let qualified = c.standard_function(name):
        # `from math import abs`: the call goes by the qualified name from here on
        if let callee = e.left:
            callee.text = qualified
        return try standard_function_type(c, e, qualified)
    return try c.fail(e, try c.named("unknown name ", name, ""))

## `value.hash()` (§4.4): every hashable value's hash, the same number in every execution;
## none when the value's type declares a member `hash` of its own, which is then called.
func hash_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*) -> u32?!:
    let owner = callee.left else return none
    c.self_receiver = owner.kind == ast.Kind.self_
    let t = try check_expr(c, owner, types.none_id)
    c.self_receiver = false
    let k = c.table.kind(t)
    if k == types.Kind.module or k == types.Kind.type_name:
        return none
    if k == types.Kind.param and bound_member(c, t, "hash") != none:
        return none
    if let d = c.table.get(t).decl:
        if check.find_member(d, "hash") != none:
            return none
    try no_arguments(c, e, "`value.hash()`")
    if not hashable(c, t):
        if equatable(c, t):
            return try c.fail(owner, try c.with_type("a `", t, "` has no hash: its `Equatable` needs `Hashable` beside it (§13.3)"))
        return try c.fail(owner, try c.with_type("a `", t, "` has no hash; it has no `==` (§4.4)"))
    callee.flags |= ast.flag_builtin
    callee.type_id = t
    return types.int_id

## `int(x)` of a `float`, or `int(text, base = 10)` parsing a `str` (§6.5).
func int_call_type(c: check.Checker*, e: ast.Node*) -> u32!:
    let args = try builtin_arguments(c, e, "`int(value, base = 10)`", ["value", "base"], 1)
    let v = args[0] else return try c.fail(e, "no value")
    let t = try check_expr(c, v, types.none_id)
    if let base = args[1]:
        if t != types.str_id:
            return try c.fail(base, "a base belongs to parsing a `str`, `int(text, base)` (§6.5)")
        _ = try expect(c, base, types.int_id)
    if t == types.float_id: return types.int_id
    if t == types.str_id: return try c.table.fallible(types.int_id)
    if t == types.int_id: return try c.fail(e, "this is already an `int`")
    return try c.fail(v, "`int(...)` converts a `float` or parses a `str` (§6.5)")

## A call of a standard module's function, `math.abs(x)`, by the module's import: the callee
## becomes the qualified name, which the interpreter and the emitter call (§6.8). None when
## the call is not of one.
func standard_call_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*) -> u32?!:
    let owner = callee.left else return none
    if owner.kind != ast.Kind.name or c.lookup(owner.text) != none or c.find_declaration(owner.text) != none:
        return none
    if not c.standard_module(owner.text):
        return none
    let module = c.find_import(owner.text) else return none
    let qualified = standard.qualified(module.standard, callee.text) else return try c.fail(callee, try c.message(["the module `", module.standard, "` has no `", callee.text, "`"]))
    callee.kind = ast.Kind.name
    callee.text = qualified
    # the call still starts where its module is named, where a trap in it points
    callee.start = owner.start
    callee.left = none
    return try standard_function_type(c, e, qualified)

## `math.abs`, `math.min`, `math.max`, `math.round`, `text.code_of`, `text.from_code`,
## `console.read_line`, `time.sleep`, `time.now` and `time.unix` (§6.8).
func standard_function_type(c: check.Checker*, e: ast.Node*, name: str) -> u32!:
    if name == "time.sleep":
        let args = try builtin_arguments(c, e, "`time.sleep(seconds)`", ["seconds"], 1)
        let seconds = args[0] else return try c.fail(e, "no value")
        let t = try check_expr(c, seconds, types.none_id)
        if t != types.int_id and t != types.float_id:
            return try c.fail(seconds, try c.with_type("`time.sleep` takes seconds as an `int` or a `float`, not a `", t, "`"))
        return types.unit_id
    if name == "time.now" or name == "time.unix":
        let no_parameters: str[1] = [""]
        _ = try builtin_arguments(c, e, "`time.now()`" if name == "time.now" else "`time.unix()`", no_parameters[..<0], 0)
        return types.int_id
    if name == "math.min" or name == "math.max":
        let usage = "`math.min(a, b)`" if name == "math.min" else "`math.max(a, b)`"
        if ast.count(e.body) == 1:
            return try c.fail(e, try c.message([usage, " takes two values; a list's own is `values.", "min" if name == "math.min" else "max", "()`"]))
        let args = try builtin_arguments(c, e, usage, ["a", "b"], 2)
        let a = args[0] else return try c.fail(e, "no value")
        let b = args[1] else return try c.fail(e, "no value")
        let t = try check_expr(c, a, types.none_id)
        _ = try expect(c, b, t)
        if not orderable(c, t):
            return try c.fail(e, try c.with_type("`math.min` and `math.max` compare two values of an ordered type; a `", t, "` has no ordering (§4.4)"))
        return t
    if name == "math.abs":
        let args = try builtin_arguments(c, e, "`math.abs(x)`", ["x"], 1)
        let x = args[0] else return try c.fail(e, "no value")
        let t = try check_expr(c, x, types.none_id)
        if t != types.int_id and t != types.float_id:
            return try c.fail(x, try c.with_type("`math.abs` takes an `int` or a `float`, not a `", t, "`"))
        return t
    if name == "math.round":
        let args = try builtin_arguments(c, e, "`math.round(x, digits = 0)`", ["x", "digits"], 1)
        let x = args[0] else return try c.fail(e, "no value")
        let t = try check_expr(c, x, types.none_id)
        if t == types.int_id:
            return try c.fail(x, "`math.round` rounds a `float`; an `int` is whole already, and `float(n)` makes one a `float` (§6.2)")
        if t != types.float_id:
            return try c.fail(x, try c.with_type("`math.round` takes a `float`, not a `", t, "`"))
        if let digits = args[1]:
            _ = try expect(c, digits, types.int_id)
        return types.float_id
    if name == "text.code_of" or name == "text.from_code":
        let reading = name == "text.code_of"
        let args = try builtin_arguments(c, e, "`text.code_of(s)`" if reading else "`text.from_code(n)`", ["s"] if reading else ["n"], 1)
        let v = args[0] else return try c.fail(e, "no value")
        _ = try expect(c, v, types.str_id if reading else types.int_id)
        return types.int_id if reading else types.str_id
    let args = try builtin_arguments(c, e, "`console.read_line(prompt = \"\")`", ["prompt"], 0)
    if let prompt = args[0]:
        _ = try expect(c, prompt, types.str_id)
    return try c.table.optional(types.str_id)

## A field's specification read and fitted to the value it formats (§3.3): an `int`, a
## `float`, or anything else by its display.
func check_format_spec(c: check.Checker*, field: ast.Node*, t: u32) -> !:
    let reading = numerals.read(field.text)
    if reading.problem.length > 0:
        return try c.fail(field, try c.message(["the format specification `", field.text, "` is not one: ", reading.problem, " (§3.3)"]))
    var category = numerals.Category.text
    if t == types.int_id:
        category = numerals.Category.integer
    elif t == types.float_id:
        category = numerals.Category.floating
    let problem = number_text.misfit(reading.spec, category)
    if problem.length > 0:
        return try c.fail(field, try c.message(["the format specification `", field.text, "` does not fit the type `", try c.type_text(t), "`: ", problem, " (§3.3)"]))

## `ErrorCode.package(n)`: a constant of this package, `n` from 1 to 65535, no two alike.
func package_code(c: check.Checker*, e: ast.Node*) -> u32!:
    if not c.at_top_level:
        return try c.fail(e, "`ErrorCode.package(n)` declares a top-level `let` (§12.3)")
    let first = e.body else return try c.fail(e, "`ErrorCode.package(n)` takes a number")
    let v = first.left else return try c.fail(e, "no number")
    if v.kind != ast.Kind.literal or first.next != none:
        return try c.fail(e, "`ErrorCode.package(n)` takes one integer literal")
    let n = literals.decode_integer(v.text) catch failure:
        return try c.fail(v, "an error code is 1 to 65535")
    if n == 0 or n > 65535:
        return try c.fail(v, "an error code is 1 to 65535")
    var i: usize = 0
    while i < c.package_codes.count:
        if c.package_codes.get(i) == n:
            return try c.fail(v, "two constants of one package share this error code (§12.3)")
        i += 1
    try c.package_codes.push(n)
    v.type_id = types.int_id
    return types.error_code_id
