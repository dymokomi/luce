#==============================================================================================
#
#   bodies/builtins - The core functions
#
#   DESCRIPTION:
#       `print`, `assert`, `trap`, `error`, `discard`, the conversions, `hash`, `Weak`, and the
#       built-in functions of §2.4, typed; and the specification of a formatted string's field
#       checked against the value it formats (§3.3).
#
#==============================================================================================

# mark: Core functions =========================================================================

## The language's own functions (§2.4, §6.5, §12.4).
func core_call(c: check.Checker*, e: ast.Node*, name: str) -> u32!:
    let n = ast.count(e.body)
    if name == "print":
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return try c.fail(a, "empty argument")
            if a.text.length > 0:
                return try c.fail(a, "`print` takes positional arguments")
            let t = try check_expr(c, v, types.none_id)
            try require_display(c, v, t)
            cursor = a.next
        return types.unit_id
    if name == "assert":
        if n < 1 or n > 2:
            return try c.fail(e, "`assert(condition)` or `assert(condition, message)`")
        let first = e.body else return try c.fail(e, "no condition")
        let cond = first.left else return try c.fail(e, "no condition")
        discard(try expect(c, cond, types.bool_id))
        if let second = first.next:
            let m = second.left else return try c.fail(second, "empty argument")
            discard(try expect(c, m, types.str_id))
        return types.unit_id
    if name == "trap":
        if n != 1:
            return try c.fail(e, "`trap(message)` takes one text")
        let first = e.body else return try c.fail(e, "no message")
        let m = first.left else return try c.fail(e, "no message")
        discard(try expect(c, m, types.str_id))
        return types.never_id
    if name == "error":
        if not c.fallible and not c.handled_effect:
            return try c.fail(e, "`error` belongs in a function whose result is `!` (§12.2)")
        if n != 2:
            return try c.fail(e, "`error(code, message)` takes a code and a text")
        let first = e.body else return try c.fail(e, "no code")
        let code = first.left else return try c.fail(e, "no code")
        let second = first.next else return try c.fail(e, "no message")
        let message = second.left else return try c.fail(e, "no message")
        discard(try expect(c, code, types.error_code_id))
        discard(try expect(c, message, types.str_id))
        return try c.table.fallible(types.never_id)
    if name == "discard":
        if n != 1:
            return try c.fail(e, "`discard(value)` takes one value")
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if c.table.kind(t) == types.Kind.fallible:
            return try c.fail(v, "a result is handled, not discarded (§12.2)")
        return types.unit_id
    if name == "int" or name == "float" or name == "str" or name == "bool":
        if n != 1:
            return try c.fail(e, try c.named("", name, "(value) takes one value"))
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if name == "int":
            if t == types.float_id: return types.int_id
            if t == types.str_id: return try c.table.fallible(types.int_id)
            if t == types.int_id: return try c.fail(e, "this is already an `int`")
            return try c.fail(v, "`int(...)` converts a `float` or parses a `str` (§6.5)")
        if name == "float":
            if t == types.int_id: return types.float_id
            if t == types.str_id: return try c.table.fallible(types.float_id)
            return try c.fail(v, "`float(...)` converts an `int` or parses a `str` (§6.5)")
        if name == "bool":
            if t == types.str_id: return try c.table.fallible(types.bool_id)
            return try c.fail(v, "`bool(...)` parses a `str` (§6.5)")
        try require_display(c, v, t)
        return types.str_id
    if name == "hash":
        if n != 1:
            return try c.fail(e, "`hash(value)` takes one value")
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if not hashable(c, t):
            if equatable(c, t):
                return try c.fail(v, try c.with_type("a `", t, "` has no hash: its `Equatable` needs `Hashable` beside it (§13.3)"))
            return try c.fail(v, try c.with_type("a `", t, "` has no hash; it has no `==` (§4.4)"))
        return types.int_id
    if name == "Weak":
        let first = e.body else return try c.fail(e, "`Weak(object)` takes a class instance (§10.4)")
        let v = first.left else return try c.fail(e, "no value")
        if n != 1 or first.text.length > 0:
            return try c.fail(e, "`Weak(object)` takes one class instance (§10.4)")
        let t = try check_expr(c, v, types.none_id)
        if c.table.kind(t) != types.Kind.class_:
            return try c.fail(v, try c.with_type("`Weak` holds a class instance, not a `", t, "` (§10.4)"))
        return try c.table.weak_of(t)
    return try c.fail(e, try c.named("unknown name ", name, ""))

## `ErrorCode.package(n)`: a constant of this package, `n` from 1 to 65535, no two alike.
func package_code(c: check.Checker*, e: ast.Node*) -> u32!:
    if not c.at_top_level:
        return try c.fail(e, "`ErrorCode.package(n)` declares a top-level `let` (§12.3)")
    let first = e.body else return try c.fail(e, "`ErrorCode.package(n)` takes a number")
    let v = first.left else return try c.fail(e, "no number")
    if v.kind != ast.Kind.literal or first.next != none:
        return try c.fail(e, "`ErrorCode.package(n)` takes one integer literal")
    let n = literals.decode_integer(v.text) catch failure:
        return try c.fail(v, "an error code is 1 to 65535")
    if n == 0 or n > 65535:
        return try c.fail(v, "an error code is 1 to 65535")
    var i: usize = 0
    while i < c.package_codes.count:
        if c.package_codes.get(i) == n:
            return try c.fail(v, "two constants of one package share this error code (§12.3)")
        i += 1
    try c.package_codes.push(n)
    v.type_id = types.int_id
    return types.error_code_id
