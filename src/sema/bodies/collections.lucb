#==============================================================================================
#
#   bodies/collections - The methods of lists, maps, sets and ranges
#
#   DESCRIPTION:
#       The operations of §6.6 and §11.1 to §11.2 typed: each call marked builtin, its
#       arguments matched to the operation's parameters (`builtin_arguments`), the functions it
#       takes checked with the element known, so a lambda's parameters need no types, and its
#       result type given.
#
#==============================================================================================

# mark: Lists ==================================================================================

## `values.method(args)` for a list (§11.1): the call is marked builtin and typed here.
func list_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = lt
    if name == "append" or name == "contains" or name == "index_of" or name == "count" or name == "remove":
        let args = try builtin_arguments(c, e, try c.message(["`values.", name, "(value)`"]), ["value"], 1)
        _ = try expect(c, args[0] else return types.unit_id, elem)
        if name == "append":
            return types.unit_id
        if not equatable(c, elem):
            return try c.fail(e, try c.with_type("`", lt, "` has no `==` on its elements, so nothing is searched"))
        if name == "index_of":
            return try c.table.optional(types.int_id)
        return types.int_id if name == "count" else types.bool_id
    if name == "insert":
        let args = try builtin_arguments(c, e, "`values.insert(index, value)`", ["index", "value"], 2)
        _ = try expect(c, args[0] else return types.unit_id, types.int_id)
        _ = try expect(c, args[1] else return types.unit_id, elem)
        return types.unit_id
    if name == "remove_at" or name == "chunks":
        let parameter = "index" if name == "remove_at" else "size"
        let args = try builtin_arguments(c, e, try c.message(["`values.", name, "(", parameter, ")`"]), [parameter], 1)
        _ = try expect(c, args[0] else return elem, types.int_id)
        return elem if name == "remove_at" else try c.table.list_of(lt)
    if name == "extend" or name == "zip":
        let args = try builtin_arguments(c, e, try c.message(["`values.", name, "(other)`"]), ["other"], 1)
        let other = args[0] else return types.unit_id
        if name == "extend":
            _ = try expect(c, other, lt)
            return types.unit_id
        let ot = try check_expr(c, other, types.none_id)
        if c.table.kind(ot) != types.Kind.list_:
            return try c.fail(other, try c.with_type("`zip` pairs a list with another list, not a `", ot, "`"))
        var pair = try new u32[2] ---
        pair[0] = elem
        pair[1] = c.table.get(ot).elem
        return try c.table.list_of(try c.table.tuple(pair))
    if name == "join":
        let args = try builtin_arguments(c, e, "`values.join(separator)`", ["separator"], 1)
        _ = try expect(c, args[0] else return types.str_id, types.str_id)
        if elem != types.str_id:
            return try c.fail(e, "`join` belongs to a `list[str]`")
        return types.str_id
    if name == "sort" or name == "sorted" or name == "min" or name == "max":
        return try ordering_method_type(c, e, name, lt)
    if name == "map" or name == "flat_map" or name == "filter" or name == "any" or name == "all" or name == "find" or name == "reduce":
        return try function_method_type(c, e, name, lt)
    return try plain_list_method_type(c, e, callee, lt)

## The list methods of no argument: shape changes, copies, `distinct`, `indexed`, `sum`.
func plain_list_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    let name = callee.text
    let known = name == "pop" or name == "clear" or name == "reverse" or name == "reversed" or name == "copy" or name == "distinct" or name == "indexed" or name == "sum"
    if not known:
        return try c.fail(callee, try c.named("a list has no ", name, "; its operations are those of §11.1"))
    try no_arguments(c, e, try c.message(["`values.", name, "()`"]))
    if name == "pop":
        return elem
    if name == "clear" or name == "reverse":
        return types.unit_id
    if name == "distinct" and not hashable(c, elem):
        return try c.fail(e, try c.with_type("`distinct` finds equal elements by their hash; a `", elem, "` has none (§4.4)"))
    if name == "indexed":
        var pair = try new u32[2] ---
        pair[0] = types.int_id
        pair[1] = elem
        return try c.table.list_of(try c.table.tuple(pair))
    if name == "sum":
        if elem != types.int_id and elem != types.float_id:
            return try c.fail(e, try c.with_type("`sum` adds a `list[int]` or a `list[float]`, not a `", lt, "`"))
        return elem
    return lt

## `sort`, `sorted`, `min` and `max`, by the elements or by a `key` of an ordered type;
## `sort` and `sorted` also `reverse`.
func ordering_method_type(c: check.Checker*, e: ast.Node*, name: str, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    let sorting = name == "sort" or name == "sorted"
    var args = try builtin_arguments(c, e, try c.message(["`values.", name, "(key = f)`"]), ["key"], 0) if not sorting else try builtin_arguments(c, e, try c.message(["`values.", name, "(key = f, reverse = false)`"]), ["key", "reverse"], 0)
    if let key = args[0]:
        let kt = try element_function(c, key, elem, types.none_id, "key")
        if not orderable(c, kt.elem):
            return try c.fail(key, try c.with_type("a key is of an ordered type; a `", kt.elem, "` has no ordering (§4.4)"))
    elif not orderable(c, elem):
        return try c.fail(e, try c.with_type("`", lt, "` has no ordering on its elements; give a `key` (§4.4)"))
    if sorting:
        if let reverse = args[1]:
            _ = try expect(c, reverse, types.bool_id)
    if name == "sort":
        return types.unit_id
    return lt if name == "sorted" else try c.table.optional(elem)

## A function of one element given to a list method as `parameter`: checked with
## `func(T) -> R` expected, `R` left to the function when `result` is none_id. Its type.
func element_function(c: check.Checker*, f: ast.Node*, elem: u32, result: u32, parameter: str) -> types.Type!:
    var one = try new u32[1] ---
    one[0] = elem
    let ft = try check_expr(c, f, try c.table.function(one, result))
    let t = c.table.get(ft)
    if t.kind != types.Kind.func_ or t.args.length != 1 or t.args[0] != elem:
        return try c.fail(f, try c.message(["`", parameter, "` is a function of one element, `func(", try c.type_text(elem), ") -> ...`"]))
    if c.table.kind(t.elem) == types.Kind.fallible:
        return try c.fail(f, try c.message(["`", parameter, "` is a function that cannot fail"]))
    if result != types.none_id and t.elem != result:
        return try c.fail(f, try c.message(["`", parameter, "` returns a `", try c.type_text(result), "`"]))
    return t

## `map`, `flat_map`, `filter`, `any`, `all`, `find` and `reduce`: the list's elements given
## to a function.
func function_method_type(c: check.Checker*, e: ast.Node*, name: str, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    if name == "reduce":
        return try reduce_type(c, e, lt)
    let parameter = "function" if name == "map" or name == "flat_map" else "predicate"
    let args = try builtin_arguments(c, e, try c.message(["`values.", name, "(", parameter, ")`"]), [parameter], 1)
    let f = args[0] else return lt
    if name == "map" or name == "flat_map":
        let t = try element_function(c, f, elem, types.none_id, parameter)
        if t.elem == types.unit_id:
            return try c.fail(f, "`map` takes a function returning a value")
        if name == "map":
            return try c.table.list_of(t.elem)
        if c.table.kind(t.elem) != types.Kind.list_:
            return try c.fail(f, try c.with_type("`flat_map` takes a function returning a list, not a `", t.elem, "`"))
        return t.elem
    _ = try element_function(c, f, elem, types.bool_id, parameter)
    if name == "filter":
        return lt
    if name == "find":
        return try c.table.optional(elem)
    return types.bool_id

## `reduce(function, initial)`: the total's type is the initial value's, and the function
## takes the total and an element, `func(A, T) -> A`.
func reduce_type(c: check.Checker*, e: ast.Node*, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    let args = try builtin_arguments(c, e, "`values.reduce(function, initial)`", ["function", "initial"], 2)
    let f = args[0] else return types.unit_id
    let initial = args[1] else return types.unit_id
    let total = try check_expr(c, initial, types.none_id)
    if total == types.untyped_none_id:
        return try c.fail(initial, "`none` needs a type here; bind the initial value with its type first")
    try not_held(c, initial, total)
    var two = try new u32[2] ---
    two[0] = total
    two[1] = elem
    let ft = try check_expr(c, f, try c.table.function(two, total))
    let t = c.table.get(ft)
    if t.kind != types.Kind.func_ or t.args.length != 2 or t.args[0] != total or t.args[1] != elem or t.elem != total:
        return try c.fail(f, try c.message(["`reduce` takes a function of the total and an element, `func(", try c.type_text(total), ", ", try c.type_text(elem), ") -> ", try c.type_text(total), "`"]))
    return total

# mark: Maps and sets ==========================================================================

## `m.method(args)` for a map or a set (§11.2).
func map_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, mt: u32) -> u32!:
    let t = c.table.get(mt)
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = mt
    if name == "clear" or name == "copy":
        try no_arguments(c, e, try c.message(["`", name, "()`"]))
        return types.unit_id if name == "clear" else mt
    if t.kind == types.Kind.map_:
        return try map_only_method_type(c, e, callee, mt)
    if name == "insert" or name == "remove":
        let args = try builtin_arguments(c, e, try c.message(["`items.", name, "(value)`"]), ["value"], 1)
        _ = try expect(c, args[0] else return types.unit_id, t.elem)
        return types.unit_id if name == "insert" else types.bool_id
    let returns_set = name == "union" or name == "intersection" or name == "difference" or name == "symmetric_difference"
    let tests = name == "is_subset" or name == "is_superset" or name == "is_disjoint"
    if not returns_set and not tests:
        return try c.fail(callee, try c.named("a set has no ", name, "; its operations are those of §11.2"))
    let args = try builtin_arguments(c, e, try c.message(["`items.", name, "(other)`"]), ["other"], 1)
    _ = try expect(c, args[0] else return mt, mt)
    return mt if returns_set else types.bool_id

func map_only_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, mt: u32) -> u32!:
    let name = callee.text
    let key = c.table.get(mt).elem
    let value = c.table.map_value(mt)
    if name == "remove":
        let args = try builtin_arguments(c, e, "`m.remove(key)`", ["key"], 1)
        _ = try expect(c, args[0] else return types.unit_id, key)
        return try c.table.optional(value)
    if name == "get":
        let args = try builtin_arguments(c, e, "`m.get(key, default)`", ["key", "default"], 2)
        _ = try expect(c, args[0] else return value, key)
        _ = try expect(c, args[1] else return value, value)
        return value
    if name == "update":
        let args = try builtin_arguments(c, e, "`m.update(other)`", ["other"], 1)
        _ = try expect(c, args[0] else return types.unit_id, mt)
        return types.unit_id
    if name == "keys" or name == "values" or name == "items":
        try no_arguments(c, e, try c.message(["`m.", name, "()`"]))
        if name == "keys":
            return try c.table.list_of(key)
        if name == "values":
            return try c.table.list_of(value)
        var pair = try new u32[2] ---
        pair[0] = key
        pair[1] = value
        return try c.table.list_of(try c.table.tuple(pair))
    return try c.fail(callee, try c.named("a map has no ", name, "; its operations are those of §11.2"))

# mark: Ranges =================================================================================

## `r.step(n)`, `r.reversed()` and `r.contains(x)` (§6.6).
func range_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*) -> u32!:
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = types.range_id
    if name == "reversed":
        try no_arguments(c, e, "`r.reversed()`")
        return types.range_id
    if name == "step" or name == "contains":
        let parameter = "size" if name == "step" else "value"
        let args = try builtin_arguments(c, e, try c.message(["`r.", name, "(", parameter, ")`"]), [parameter], 1)
        _ = try expect(c, args[0] else return types.range_id, types.int_id)
        return types.range_id if name == "step" else types.bool_id
    return try c.fail(callee, try c.named("a range has no ", name, "; its operations are those of §6.6"))
