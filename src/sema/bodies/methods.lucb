#==============================================================================================
#
#   bodies/methods - The arguments of built-ins, and the methods of texts
#
#   DESCRIPTION:
#       The arguments of a built-in function or method matched to its parameters, named or
#       positional, as any call's are (§7.2); and the methods of `str` and `bytes` (§11.3,
#       §11.4) typed, each call marked builtin. Collections and ranges are in collections.lucb.
#
#==============================================================================================

# mark: Arguments ==============================================================================

## The arguments of a built-in function or method by parameter, as §7.2 has them for any
## call: positional ones in order, then named ones, each naming a parameter once. A slot is
## none where nothing was written for it; the first `required` must be written. Each
## argument's text becomes its parameter's name, so the interpreter and the emitter find
## it by name (`ast.argument`). `usage` names the call in a diagnostic, `` `round(x, digits = 0)` ``.
func builtin_arguments(c: check.Checker*, e: ast.Node*, usage: str, params: const str[], required: usize) -> (ast.Node*?)[]!:
    var slots = try alloc (ast.Node*?)[params.length if params.length > 0 else 1]
    var i: usize = 0
    while i < slots.length:
        slots[i] = none
        i += 1
    var position: usize = 0
    var cursor = e.body
    while let a = cursor:
        let v = a.left else return try c.fail(a, "empty argument")
        var at = params.length
        if a.text.length == 0:
            at = position
            position += 1
            if at >= params.length:
                return try c.fail(v, try c.message([usage, " takes ", "no argument" if params.length == 0 else "fewer arguments"]))
        else:
            var k: usize = 0
            while k < params.length:
                if params[k] == a.text:
                    at = k
                k += 1
            if at == params.length:
                return try c.fail(a, try c.message([usage, " has no parameter `", a.text, "`"]))
        if slots[at] != none:
            return try c.fail(a, try c.message([usage, " is given `", params[at], "` twice"]))
        slots[at] = v
        a.text = params[at]
        cursor = a.next
    i = 0
    while i < required:
        if slots[i] == none:
            return try c.fail(e, try c.message([usage, " needs `", params[i], "`"]))
        i += 1
    return slots

## A built-in method that takes no argument: one written is an error naming `usage`.
func no_arguments(c: check.Checker*, e: ast.Node*, usage: str) -> !:
    if let a = e.body:
        return try c.fail(a, try c.message([usage, " takes no argument"]))

# mark: Methods of the built-in types ==========================================================

## `text.method(args)` for a `str` (§11.3) or `bytes` (§11.4).
func text_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, t: u32) -> u32!:
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = t
    if t == types.bytes_id:
        if name == "text":
            try no_arguments(c, e, "`data.text()`")
            return try c.table.fallible(types.str_id)
        return try c.fail(callee, try c.named("`bytes` has no ", name, "; its operations are those of §11.4"))
    if name == "trim" or name == "trim_start" or name == "trim_end" or name == "upper" or name == "lower" or name == "capitalize" or name == "title" or name == "reversed":
        try no_arguments(c, e, try c.message(["`text.", name, "()`"]))
        return types.str_id
    if name == "is_digit" or name == "is_alpha" or name == "is_alnum" or name == "is_space":
        try no_arguments(c, e, try c.message(["`text.", name, "()`"]))
        return types.bool_id
    if name == "lines" or name == "characters" or name == "bytes":
        try no_arguments(c, e, try c.message(["`text.", name, "()`"]))
        return types.bytes_id if name == "bytes" else try c.table.list_of(types.str_id)
    if name == "split":
        let args = try builtin_arguments(c, e, "`text.split(separator)`", ["separator"], 0)
        if let separator = args[0]:
            discard(try expect(c, separator, types.str_id))
        return try c.table.list_of(types.str_id)
    if name == "replace":
        let args = try builtin_arguments(c, e, "`text.replace(old, new)`", ["old", "new"], 2)
        discard(try expect(c, args[0] else return types.str_id, types.str_id))
        discard(try expect(c, args[1] else return types.str_id, types.str_id))
        return types.str_id
    if name == "repeat":
        let args = try builtin_arguments(c, e, "`text.repeat(count)`", ["count"], 1)
        discard(try expect(c, args[0] else return types.str_id, types.int_id))
        return types.str_id
    if name == "pad_left" or name == "pad_right" or name == "center":
        let args = try builtin_arguments(c, e, try c.message(["`text.", name, "(width, fill = \" \")`"]), ["width", "fill"], 1)
        discard(try expect(c, args[0] else return types.str_id, types.int_id))
        if let fill = args[1]:
            discard(try expect(c, fill, types.str_id))
        return types.str_id
    let parameter = text_parameter(name) else return try c.fail(callee, try c.named("a `str` has no ", name, "; its operations are those of §11.3"))
    let args = try builtin_arguments(c, e, try c.message(["`text.", name, "(", parameter, ")`"]), [parameter], 1)
    discard(try expect(c, args[0] else return types.str_id, types.str_id))
    if name == "index_of" or name == "last_index_of":
        return try c.table.optional(types.int_id)
    if name == "count":
        return types.int_id
    if name == "remove_prefix" or name == "remove_suffix":
        return types.str_id
    return types.bool_id

## The parameter of a `str` method taking one text, by its name; none for any other.
func text_parameter(name: str) -> str?:
    if name == "contains" or name == "index_of" or name == "last_index_of" or name == "count":
        return "text"
    if name == "starts_with" or name == "remove_prefix":
        return "prefix"
    if name == "ends_with" or name == "remove_suffix":
        return "suffix"
    return none
