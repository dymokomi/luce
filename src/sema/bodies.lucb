#==============================================================================================
#
#   bodies - Every statement and expression typed
#
#   DESCRIPTION:
#       The rules of luce.md §5 to §9, §12 and §13 applied to the bodies of a module, over
#       the state `sema.check` prepared: bindings and their mutability, evaluation and
#       arithmetic, calls with named and default arguments, construction, methods and their
#       receivers, control flow with definite return, patterns and exhaustiveness, optionals
#       and results, traps. Every node leaves with its `type_id`, and every name, member,
#       case and call with its `resolved` declaration, so the interpreter and the emitter
#       never look a name up again.
#
#==============================================================================================

import front.ast
import sema.check
import sema.types
import support.list
import support.literals

# mark: Entry ==================================================================================

## Type every body of the module the checker holds current.
## The bodies of every module, imports first (§15); an instance a body makes is appended
## to its generic's module and checked in turn, until none is left.
pub func check_module(c: check.Checker*) -> !:
    c.satisfies_hook = satisfies
    var i: usize = 0
    while i < c.order.count:
        c.current = (usize)c.order.get(i)
        try check_declarations(c, c.tree())
        try imports_used(c)
        i += 1
    var progressed = true
    while progressed:
        progressed = false
        i = 0
        while i < c.order.count:
            c.current = (usize)c.order.get(i)
            if try check_declarations(c, c.tree()):
                progressed = true
            i += 1
    c.current = (usize)c.entry
    if c.errors.count > 0:
        error(check.type_error, c.errors.get(0))
    if not c.main_seen:
        var has_test = false
        var cursor = c.tree().body
        while let d = cursor:
            if d.kind == ast.Kind.test_:
                has_test = true
            cursor = d.next
        if not has_test:
            return try c.fail(c.tree(), "a program declares `pub func main(arguments: list[str]) -> int!` (§15.4)")

## The bodies of one module's declarations not checked yet; whether any was.
func check_declarations(c: check.Checker*, tree: ast.Node*) -> bool!:
    var any = false
    var cursor = tree.body
    while let d = cursor:
        if d.has(ast.flag_checked) or (d.has(ast.flag_prelude) and not d.has(ast.flag_instance)):
            cursor = d.next
            continue
        d.flags |= ast.flag_checked
        any = true
        # a declaration that does not check is recorded; the next is checked all the same
        check_one(c, d) catch failure:
            if failure.code != check.type_error:
                error(failure.code, failure.message)
            try c.record(failure.message)
            c.reset_after_failure()
        cursor = d.next
    return any

func check_one(c: check.Checker*, d: ast.Node*) -> !:
    match d.kind:
        .constant: try check_constant(c, d)
        .func_: try check_function(c, d, types.none_id)
        .struct_, .class_, .enum_:
            try c.enter_type_params(d)
            defer c.leave_type_params(d)
            var m = d.body
            while let member = m:
                if member.kind == ast.Kind.field:
                    if let default = member.left:
                        c.at_top_level = true
                        try expect(c, default, member.type_id)
                        c.at_top_level = false
                        if not is_constant(default):
                            return try c.fail(default, "a field default is a constant expression")
                elif member.kind == ast.Kind.func_:
                    try check_function(c, member, d.type_id)
                m = member.next
        .test_: try check_test(c, d)
        _: discard(0)

## Every import of the current module is used (§15.2).
func imports_used(c: check.Checker*) -> !:
    let m = c.modules.get(c.current)
    var i: usize = 0
    while i < m.imports.count:
        let imp = m.imports.get(i)
        if not imp.used:
            return try c.fail(imp.node, try c.named("the import ", imp.name, " is unused (§15.2)"))
        i += 1

func check_constant(c: check.Checker*, d: ast.Node*) -> !:
    let init = d.left else return try c.fail(d, "a constant needs a value")
    c.at_top_level = true
    var got = types.none_id
    if d.type_id != types.none_id:
        got = try expect(c, init, d.type_id)
    else:
        got = try check_expr(c, init, types.none_id)
        if got == types.untyped_none_id:
            return try c.fail(init, "`none` needs a written optional type")
        d.type_id = got
    c.at_top_level = false
    if not is_constant(init):
        return try c.fail(init, "a top-level `let` is a constant expression (§15.3)")

## A test is a function of no parameters that may fail.
func check_test(c: check.Checker*, d: ast.Node*) -> !:
    let body = d.body else return try c.fail(d, "a test needs a body")
    c.current_func = d
    c.result_type = types.unit_id
    c.fallible = true
    c.self_type = types.none_id
    c.push_scope()
    discard(try check_block(c, body))
    c.pop_scope()
    c.current_func = none

## A function or method: parameters bound, the body checked, a value on every path.
func check_function(c: check.Checker*, f: ast.Node*, owner: u32) -> !:
    let body = f.body else return try c.fail(f, "a function needs a body")
    let t = c.table.get(f.type_id)
    try c.enter_type_params(f)
    defer c.leave_type_params(f)
    c.current_func = f
    c.self_type = owner
    c.self_mutable = f.has(ast.flag_mutating) or c.table.kind(owner) == types.Kind.class_
    c.in_init = f.text == "init" and owner != types.none_id
    c.in_deinit = f.text == "deinit" and owner != types.none_id
    var result = t.elem
    c.fallible = false
    if c.table.kind(result) == types.Kind.fallible:
        c.fallible = true
        result = c.table.get(result).elem
    c.result_type = result
    c.loop_depth = 0
    c.label_count = 0
    c.push_scope()
    var cursor = f.right
    while let p = cursor:
        if p.text == "self":
            try c.bind(p, "self", owner, p, false)
        else:
            if let default = p.left:
                c.at_top_level = true
                try expect(c, default, p.type_id)
                c.at_top_level = false
                if not is_constant(default):
                    return try c.fail(default, "a parameter default is a constant expression (§7.1)")
            try c.bind(p, p.text, p.type_id, p, false)
        cursor = p.next
    if c.in_init:
        try check_init(c, f, body)
    else:
        let exits = try check_block(c, body)
        if result != types.unit_id and not exits:
            return try c.fail(f, "not every path returns a value (§7.1)")
    c.pop_scope()
    c.current_func = none
    c.self_type = types.none_id
    c.in_init = false
    c.in_deinit = false

## `init` assigns every field without a default exactly once before it ends, reads none
## before, and does not hand `self` out first (§10.1). The walk is over the statements in
## order; a branch must assign the same fields on each side.
func check_init(c: check.Checker*, f: ast.Node*, body: ast.Node*) -> !:
    let owner = c.table.get(c.self_type).decl else return try c.fail(f, "no owner")
    var assigned = try list.List[str].create(16)
    discard(try check_block(c, body))
    # a simple rule that is right for the common shape: every statement of the body that
    # is `self.field = ...` at the top level counts; a field assigned only under a branch
    # is reported as unassigned
    var cursor = body.body
    while let s = cursor:
        if s.kind == ast.Kind.assign and s.text == "=":
            if let place = s.left:
                if place.kind == ast.Kind.member:
                    if let receiver = place.left:
                        if receiver.kind == ast.Kind.self_:
                            try assigned.push(place.text)
        cursor = s.next
    var m = owner.body
    while let member = m:
        if member.kind == ast.Kind.field and member.left == none:
            var found = false
            var i: usize = 0
            while i < assigned.count:
                if assigned.get(i) == member.text:
                    found = true
                i += 1
            if not found:
                return try c.fail(f, try c.named("`init` does not assign the field ", member.text, " on every path (§10.1)"))
        m = member.next

# mark: Statements =============================================================================

## Check a block; whether it exits on every path (§7.1).
pub func check_block(c: check.Checker*, block: ast.Node*) -> bool!:
    c.push_scope()
    var exits = false
    var cursor = block.body
    while let s = cursor:
        if exits:
            return try c.fail(s, "this statement is never reached")
        exits = try check_statement(c, s)
        cursor = s.next
    c.pop_scope()
    return exits

func check_statement(c: check.Checker*, s: ast.Node*) -> bool!:
    match s.kind:
        .let_, .var_: try check_binding(c, s)
        .assign: try check_assign(c, s)
        .if_: return try check_if(c, s)
        .while_: try check_while(c, s)
        .for_: try check_for(c, s)
        .match_: return try check_match_statement(c, s)
        .with_: return try check_with(c, s)
        .return_: return try check_return(c, s)
        .break_, .continue_:
            if c.loop_depth == 0:
                return try c.fail(s, "`break` and `continue` belong inside a loop")
            if s.text.length > 0 and not has_label(c, s.text):
                return try c.fail(s, try c.named("no enclosing loop is labelled ", s.text, ""))
            return true
        .recover_:
            if not c.in_catch:
                return try c.fail(s, "`recover` belongs in a `catch` suite (§12.2)")
            let v = s.left else return try c.fail(s, "`recover` needs a value")
            discard(try expect(c, v, c.catch_result))
            return true
        .expr_stmt:
            let e = s.left else return try c.fail(s, "empty statement")
            let t = try check_expr(c, e, types.none_id)
            if t == types.never_id:
                return true
            if t != types.unit_id and not (e.kind == ast.Kind.catch_):
                if c.table.kind(t) == types.Kind.fallible:
                    return try c.fail(e, "a result is handled: `try`, `catch`, or bind it (§12.2)")
                return try c.fail(e, "this value is unused; `discard(...)` it or bind it")
            if e.kind == ast.Kind.catch_ and t != types.unit_id and t != types.never_id:
                return try c.fail(e, "this value is unused; bind it")
            return false
        _: return try c.fail(s, "unexpected statement")
    return false

func has_label(c: check.Checker*, name: str) -> bool:
    var i: usize = 0
    while i < c.label_count:
        if c.labels[i] == name:
            return true
        i += 1
    return false

func check_binding(c: check.Checker*, s: ast.Node*) -> !:
    let init = s.left else return try c.fail(s, "a binding needs a value")
    let mutable = s.kind == ast.Kind.var_
    var declared = types.none_id
    if let t = s.ty:
        declared = try c.resolve_type(t)
    var got = types.none_id
    if declared != types.none_id:
        got = try expect(c, init, declared)
        got = declared
    else:
        got = try check_expr(c, init, types.none_id)
        if got == types.untyped_none_id:
            return try c.fail(init, "`none` needs a written optional type: `var x: T? = none` (§5.1)")
        if got == types.unit_id:
            return try c.fail(init, "this expression has no value")
        if got == types.never_id:
            return try c.fail(init, "this expression never yields a value")
        if c.table.kind(got) == types.Kind.fallible:
            return try c.fail(init, "a result is handled: `try`, `catch`, or `else` (§12.2)")
        if c.table.kind(got) == types.Kind.type_name:
            return try c.fail(init, "a type is not a value")
    s.type_id = got
    if s.body != none:
        # `let (a, b) = pair`
        if c.table.kind(got) != types.Kind.tuple:
            return try c.fail(init, "only a tuple destructures")
        let members = c.table.get(got).args
        if ast.count(s.body) != members.length:
            return try c.fail(s, "the binding names as many parts as the tuple has members")
        var i: usize = 0
        var cursor = s.body
        while let part = cursor:
            part.type_id = members[i]
            try c.bind(part, part.text, members[i], part, mutable)
            i += 1
            cursor = part.next
        return
    try c.bind(s, s.text, got, s, mutable)

## `place = value`, `place += value`: the place is a `var`, and the value its type.
func check_assign(c: check.Checker*, s: ast.Node*) -> !:
    let place = s.left else return try c.fail(s, "nothing to assign to")
    let value = s.right else return try c.fail(s, "nothing to assign")
    if place.kind == ast.Kind.tuple and s.text == "=":
        # `(a, b) = pair`
        var members = try alloc u32[ast.count(place.body)]
        var i: usize = 0
        var cursor = place.body
        while let part = cursor:
            members[i] = try check_place(c, part)
            i += 1
            cursor = part.next
        let t = try c.table.tuple(members)
        discard(try expect(c, value, t))
        place.type_id = t
        return
    let pt = try check_place(c, place)
    if s.text == "=":
        discard(try expect(c, value, pt))
        return
    # a compound assignment is the binary operation, then the store
    let vt = try check_expr(c, value, pt)
    let op = (str)s.text.bytes[..<s.text.length - 1]
    let rt = try arithmetic_type(c, s, op, pt, vt)
    if rt != pt:
        return try c.mismatch(s, pt, rt)

## The type of a place, which must be assignable: a `var` local, a `var` field reached
## through a path, an element of a list or map, or a `let` field of `self` inside `init`.
func check_place(c: check.Checker*, place: ast.Node*) -> u32!:
    match place.kind:
        .name:
            let b = c.lookup(place.text) else return try c.fail(place, try c.named("unknown name ", place.text, ""))
            if not b.mutable:
                return try c.fail(place, try c.named("", place.text, " is a `let` and cannot be assigned; declare it `var`"))
            c.mark_used(place.text)
            place.type_id = b.type_id
            place.resolved = b.decl
            try note_capture(c, b)
            return b.type_id
        .member:
            let receiver = place.left else return try c.fail(place, "no receiver")
            let rt = try check_expr(c, receiver, types.none_id)
            let t = try check_expr(c, place, types.none_id)
            let field = place.resolved else return try c.fail(place, "only a field is assigned")
            if field.kind != ast.Kind.field:
                return try c.fail(place, "only a field is assigned")
            let receiver_is_var = try place_is_mutable(c, receiver)
            if not field.has(ast.flag_var_field):
                let self_in_init = receiver.kind == ast.Kind.self_ and c.in_init
                if not self_in_init:
                    return try c.fail(place, try c.named("the field ", place.text, " is a `let`; it is assigned once, in `init`"))
                return t
            if c.table.is_value(rt) and not receiver_is_var:
                return try c.fail(place, "a field of a `let` value cannot change; the binding is `var` or the type is a class (§5.1)")
            return t
        .index:
            let receiver = place.left else return try c.fail(place, "no receiver")
            let t = try check_expr(c, place, types.none_id)
            let rt = receiver.type_id
            let k = c.table.kind(rt)
            if k != types.Kind.list_ and k != types.Kind.map_:
                return try c.fail(place, "only an element of a list or a map is assigned")
            if k == types.Kind.map_:
                # `m[key] = v` inserts or replaces a `V` (§11.2); reading `m[key]` is a `V?`
                return c.table.map_value(rt)
            return t
        .self_:
            return try c.fail(place, "`self` is not assigned")
        _:
            return try c.fail(place, "this is not a place that can be assigned")

## Whether an expression is a `var` place, or a class value (whose fields always change).
func place_is_mutable(c: check.Checker*, e: ast.Node*) -> bool!:
    if c.table.kind(e.type_id) == types.Kind.class_:
        return true
    match e.kind:
        .name:
            let b = c.lookup(e.text) else return false
            return b.mutable
        .self_:
            return c.self_mutable
        .member:
            let inner = e.left else return false
            let field = e.resolved else return false
            if field.kind != ast.Kind.field:
                return false
            if not field.has(ast.flag_var_field) and not (inner.kind == ast.Kind.self_ and c.in_init):
                return false
            return try place_is_mutable(c, inner)
        .index:
            let inner = e.left else return false
            return c.table.is_reference(inner.type_id) or try place_is_mutable(c, inner)
        _: return false

func check_condition(c: check.Checker*, s: ast.Node*) -> !:
    let cond = s.left else return try c.fail(s, "a condition is missing")
    if s.has(ast.flag_if_let):
        let init = cond.left else return try c.fail(cond, "`if let` needs a value")
        let t = try check_expr(c, init, types.none_id)
        if c.table.kind(t) != types.Kind.optional:
            return try c.fail(init, "`if let` binds the payload of an optional (§8.2)")
        cond.type_id = c.table.get(t).elem
        try c.bind(cond, cond.text, cond.type_id, cond, false)
        return
    discard(try expect(c, cond, types.bool_id))

func check_if(c: check.Checker*, s: ast.Node*) -> bool!:
    c.push_scope()
    try check_condition(c, s)
    let body = s.body else return try c.fail(s, "an `if` needs a body")
    let then_exits = try check_block(c, body)
    c.pop_scope()
    var else_exits = false
    if let rest = s.right:
        if rest.kind == ast.Kind.if_:
            else_exits = try check_if(c, rest)
        else:
            else_exits = try check_block(c, rest)
        return then_exits and else_exits
    return false

func check_while(c: check.Checker*, s: ast.Node*) -> !:
    c.push_scope()
    try check_condition(c, s)
    try enter_loop(c, s)
    let body = s.body else return try c.fail(s, "a loop needs a body")
    discard(try check_block(c, body))
    leave_loop(c, s)
    c.pop_scope()

func enter_loop(c: check.Checker*, s: ast.Node*) -> !:
    c.loop_depth += 1
    if s.text.length > 0:
        if has_label(c, s.text):
            return try c.fail(s, "this label is already in use")
        if c.label_count >= c.labels.length:
            return try c.fail(s, "loops nest too deeply to label")
        c.labels[c.label_count] = s.text
        c.label_count += 1

func leave_loop(c: check.Checker*, s: ast.Node*):
    c.loop_depth -= 1
    if s.text.length > 0:
        c.label_count -= 1

## `for x in e`: `e` is a range, a list, a set, a map, a `str`, or `bytes` (§8.3).
func check_for(c: check.Checker*, s: ast.Node*) -> !:
    let binding = s.left else return try c.fail(s, "a `for` binds a name")
    let seq = s.right else return try c.fail(s, "a `for` needs something to iterate")
    let st = try check_expr(c, seq, types.none_id)
    var elem = types.none_id
    let t = c.table.get(st)
    match t.kind:
        .range_: elem = types.int_id
        .list_, .set_: elem = t.elem
        .str_: elem = types.str_id
        .bytes_: elem = types.int_id
        .map_:
            var pair = try alloc u32[2]
            pair[0] = t.elem
            pair[1] = c.table.map_value(st)
            elem = try c.table.tuple(pair)
        .struct_, .class_, .enum_, .param:
            # a value declaring `Iterable[T]` (§13.3): `iterator()` once, then `next()` until none
            let iterable = try iterable_element(c, st) else return try c.fail(seq, try c.with_type("cannot iterate a `", st, "`; it does not declare `Iterable` (§8.3)"))
            elem = iterable
            if t.kind == types.Kind.param:
                s.resolved = bound_member(c, st, "iterator") else return try c.fail(seq, "no iterator")
            else:
                let d = t.decl else return try c.fail(seq, "no declaration")
                s.resolved = c.find_member(d, "iterator") else return try c.fail(seq, "no iterator")
        _: return try c.fail(seq, try c.with_type("cannot iterate a `", st, "` (§8.3)"))
    c.push_scope()
    binding.type_id = elem
    if binding.body != none:
        if c.table.kind(elem) != types.Kind.tuple:
            return try c.fail(binding, "only a tuple element destructures")
        let members = c.table.get(elem).args
        if ast.count(binding.body) != members.length:
            return try c.fail(binding, "the binding names as many parts as the tuple has members")
        var i: usize = 0
        var cursor = binding.body
        while let part = cursor:
            part.type_id = members[i]
            try c.bind(part, part.text, members[i], part, false)
            i += 1
            cursor = part.next
    else:
        try c.bind(binding, binding.text, elem, binding, false)
    try enter_loop(c, s)
    let body = s.body else return try c.fail(s, "a loop needs a body")
    discard(try check_block(c, body))
    leave_loop(c, s)
    c.pop_scope()

## `with e as name:` closes `name` when the suite ends (§8.5).
func check_with(c: check.Checker*, s: ast.Node*) -> bool!:
    c.push_scope()
    var cursor = s.left
    while let item = cursor:
        let e = item.left else return try c.fail(item, "`with` needs a value")
        let t = try check_expr(c, e, types.none_id)
        let d = c.table.get(t).decl else return try c.fail(e, "`with` takes a value whose type has a `close()` method")
        let close = c.find_member(d, "close") else return try c.fail(e, "`with` takes a value whose type has a `close()` method")
        if close.kind != ast.Kind.func_ or not check.has_self(close) or c.table.get(close.type_id).args.length != 0 or c.table.get(close.type_id).elem != types.unit_id:
            return try c.fail(e, "`close(self)` takes nothing and returns nothing")
        item.type_id = t
        item.resolved = close
        try c.bind(item, item.text, t, item, false)
        cursor = item.next
    let body = s.body else return try c.fail(s, "`with` needs a body")
    let exits = try check_block(c, body)
    c.pop_scope()
    return exits

func check_return(c: check.Checker*, s: ast.Node*) -> bool!:
    if c.in_init:
        if s.left != none:
            return try c.fail(s, "`init` returns nothing")
        return true
    if let v = s.left:
        if c.result_type == types.unit_id:
            return try c.fail(v, "this function returns nothing")
        discard(try expect(c, v, c.result_type))
    elif c.result_type != types.unit_id:
        return try c.fail(s, try c.with_type("`return` needs a value of type `", c.result_type, "`"))
    return true

# mark: Match ==================================================================================

func check_match_statement(c: check.Checker*, s: ast.Node*) -> bool!:
    let subject = s.left else return try c.fail(s, "`match` needs a value")
    let st = try check_expr(c, subject, types.none_id)
    var all_exit = true
    var covered = try list.List[str].create(8)
    var has_wildcard = false
    var cursor = s.body
    while let arm = cursor:
        c.push_scope()
        var p = arm.left
        var binds = 0
        while let pattern = p:
            let w = try check_pattern(c, pattern, st)
            if w:
                has_wildcard = true
            if let case_node = pattern.left:
                if pattern.left != none and case_node.kind == ast.Kind.case_value:
                    try covered.push(case_node.text)
            p = pattern.next
            binds += 1
        if binds > 1 and arm_binds_names(arm.left):
            return try c.fail(arm, "an arm with several patterns binds no names")
        if let guard = arm.right:
            discard(try expect(c, guard, types.bool_id))
            if single_wildcard(arm):
                has_wildcard = false    # `_ if cond` covers nothing for sure
        let body = arm.body else return try c.fail(arm, "an arm needs a body")
        let exits = try check_block(c, body)
        if not exits:
            all_exit = false
        c.pop_scope()
        cursor = arm.next
    try check_exhaustive(c, s, st, covered, has_wildcard)
    if all_exit:
        s.flags |= ast.flag_all_exit
    return all_exit

## Whether the arm's one pattern is `_`.
func single_wildcard(arm: ast.Node*) -> bool:
    let first = arm.left else return false
    return first.next == none and first.has(ast.flag_wildcard)

func arm_binds_names(patterns: ast.Node*?) -> bool:
    var cursor = patterns
    while let p = cursor:
        if p.text == "bind":
            return true
        if let v = p.left:
            if v.kind == ast.Kind.case_value and v.body != none:
                return true
        cursor = p.next
    return false

## Every case of an enum, or `_`, or a name that binds everything (§8.4).
func check_exhaustive(c: check.Checker*, s: ast.Node*, st: u32, covered: list.List[str], has_wildcard: bool) -> !:
    if has_wildcard:
        return
    if c.table.kind(st) == types.Kind.enum_:
        let d = c.table.get(st).decl else return
        var m = d.body
        while let member = m:
            if member.kind == ast.Kind.enum_case:
                var found = false
                var i: usize = 0
                while i < covered.count:
                    if covered.get(i) == member.text:
                        found = true
                    i += 1
                if not found:
                    return try c.fail(s, try c.named("this match does not cover the case ", member.text, ""))
            m = member.next
        return
    if c.table.kind(st) == types.Kind.optional:
        var some = false
        var absent = false
        var i: usize = 0
        while i < covered.count:
            if covered.get(i) == "none":
                absent = true
            else:
                some = true
            i += 1
        if some and absent:
            return
    if st == types.bool_id:
        var t = false
        var f = false
        var i: usize = 0
        while i < covered.count:
            if covered.get(i) == "true":
                t = true
            if covered.get(i) == "false":
                f = true
            i += 1
        if t and f:
            return
    return try c.fail(s, "this match needs a `_` arm: not every value is covered")

## A pattern against a value of type `st`; whether it matches everything.
func check_pattern(c: check.Checker*, p: ast.Node*, st: u32) -> bool!:
    p.type_id = st
    if p.has(ast.flag_wildcard):
        return true
    if p.text == "bind":
        # a name binds the whole value, or the payload of an optional that is present
        let name = p.left else return true
        var bound = st
        if c.table.kind(st) == types.Kind.optional:
            bound = c.table.get(st).elem
        try c.bind(name, name.text, bound, name, false)
        name.type_id = bound
        return true
    if p.text == "tuple":
        if c.table.kind(st) != types.Kind.tuple:
            return try c.fail(p, "a tuple pattern matches a tuple")
        let members = c.table.get(st).args
        if ast.count(p.body) != members.length:
            return try c.fail(p, "the pattern has as many parts as the tuple has members")
        var all = true
        var i: usize = 0
        var cursor = p.body
        while let sub = cursor:
            if not try check_pattern(c, sub, members[i]):
                all = false
            i += 1
            cursor = sub.next
        return all
    let v = p.left else return try c.fail(p, "empty pattern")
    if v.kind == ast.Kind.case_value:
        var enum_type = st
        if c.table.kind(st) == types.Kind.optional and v.text == "none" and v.body == none:
            p.text = "none"
            return false
        if c.table.kind(enum_type) != types.Kind.enum_:
            return try c.fail(p, "a case pattern matches an enum")
        let d = c.table.get(enum_type).decl else return try c.fail(p, "no declaration")
        if let owner = v.left:
            if owner.text != c.display_name(d):
                return try c.fail(owner, try c.named("the pattern names the type ", owner.text, ", which is not the enum being matched"))
        let case_node = c.find_member(d, v.text) else return try c.fail(v, try c.named("no case ", v.text, ""))
        if case_node.kind != ast.Kind.enum_case:
            return try c.fail(v, try c.named("", v.text, " is not a case"))
        v.resolved = case_node
        v.type_id = enum_type
        let arity = ast.count(case_node.body)
        let given = ast.count(v.body)
        if given != arity:
            return try c.fail(v, try c.named("the case ", v.text, " binds as many names as it has payload fields"))
        var b = v.body
        var f = case_node.body
        while let name = b:
            let field = f else return false
            name.type_id = field.type_id
            if not name.has(ast.flag_wildcard):
                try c.bind(name, name.text, field.type_id, name, false)
            b = name.next
            f = field.next
        return false
    # a literal, or a range of two literals
    if p.text == "..<" or p.text == "..=":
        let hi = p.right else return try c.fail(p, "a range pattern needs both ends")
        discard(try expect(c, v, st))
        discard(try expect(c, hi, st))
        if st != types.int_id:
            return try c.fail(p, "a range pattern matches an `int`")
        return false
    if v.kind == ast.Kind.literal and v.text == "none":
        if c.table.kind(st) != types.Kind.optional:
            return try c.fail(v, "`none` matches an optional")
        p.text = "none"
        v.type_id = st
        return false
    discard(try expect(c, v, st))
    if not c.table.is_value(st):
        return try c.fail(v, "a literal pattern matches a value")
    return false

# mark: Expressions ============================================================================

## Check `e` against `target`, then require assignability. `none` takes the optional.
pub func expect(c: check.Checker*, e: ast.Node*, target: u32) -> u32!:
    let got = try check_expr(c, e, target)
    return try coerce(c, e, got, target)

## Whether a value of `got` may stand where `target` is expected: the same type, a `T`
## where `T?` is wanted, `none` where any optional is, `never` anywhere, a conforming
## value where an interface is wanted.
pub func coerce(c: check.Checker*, e: ast.Node*, got: u32, target: u32) -> u32!:
    if target == types.none_id or got == target or got == types.never_id:
        return target if target != types.none_id else got
    if c.table.kind(got) == types.Kind.fallible and c.table.kind(target) != types.Kind.fallible:
        return try c.fail(e, "a result is handled: `try`, `catch`, or `else` (§12.2)")
    if got == types.untyped_none_id:
        if c.table.kind(target) != types.Kind.optional:
            return try c.fail(e, try c.with_type("`none` needs an optional type; expected `", target, "`"))
        e.type_id = target
        return target
    let t = c.table.get(target)
    if t.kind == types.Kind.optional and got == t.elem:
        return target
    if t.kind == types.Kind.optional and c.table.kind(got) == types.Kind.optional:
        return try c.mismatch(e, target, got)
    if t.kind == types.Kind.interface_:
        if conforms(c, got, target):
            try convert(e, got, target)
            return target
        return try c.fail(e, try c.with_type("this value does not conform to `", target, "`"))
    if t.kind == types.Kind.optional and c.table.kind(t.elem) == types.Kind.interface_ and conforms(c, got, t.elem):
        try convert(e, got, target)
        return target
    return try c.mismatch(e, target, got)

## The expression becomes a `convert` node over a copy of itself: an interface value made
## of a conforming one (§13.2). The emitter boxes it; the interpreter, whose values know
## their type, passes it through.
func convert(e: ast.Node*, got: u32, target: u32) -> !:
    let inner = try ast.Node.make(e.kind, e.text, e.start, e.line)
    *inner = *e
    inner.next = none
    inner.type_id = got
    e.kind = ast.Kind.convert
    e.left = inner
    e.right = none
    e.body = none
    e.ty = none
    e.resolved = none
    e.type_id = target

## Whether a type declares conformance to an interface (§13.1).
pub func conforms(c: check.Checker*, id: u32, iface: u32) -> bool:
    if c.table.kind(id) == types.Kind.param:
        # a type parameter has what its bounds promise (§13.2)
        let p = c.param_node(id) else return false
        var b = p.body
        while let bound = b:
            if bound.type_id == iface:
                return true
            b = bound.next
        return false
    let d = c.table.get(id).decl else return false
    var cursor = d.right
    while let t = cursor:
        if t.type_id == iface:
            return true
        cursor = t.next
    return false

## The element type of a type declaring `Iterable[T]`, or none.
func iterable_element(c: check.Checker*, id: u32) -> u32?!:
    let iterable = c.find_declaration("Iterable") else return none
    var conformances: ast.Node*? = none
    if c.table.kind(id) == types.Kind.param:
        let p = c.param_node(id) else return none
        conformances = p.body
    else:
        let d = c.table.get(id).decl else return none
        conformances = d.right
    var cursor = conformances
    while let t = cursor:
        if let iface = c.table.get(t.type_id).decl:
            if iface.has(ast.flag_instance) and iface.resolved == iterable:
                let params = iface.ty else return none
                let first = params.body else return none
                return first.type_id
        cursor = t.next
    return none

## Whether a type may stand for a parameter bounded by the interface (§13.2): a closed
## protocol is had structurally or by declaration (§13.3), any other by declaration.
pub func satisfies(c: check.Checker*, id: u32, iface: u32) -> bool:
    if let d = c.table.get(iface).decl:
        if d.has(ast.flag_prelude):
            if d.text == "Equatable":
                return equatable(c, id)
            if d.text == "Hashable":
                return hashable(c, id)
            if d.text == "Ordered":
                return orderable(c, id)
            if d.text == "Display":
                return displayable(c, id)
    return conforms(c, id, iface)

## The requirement named `name` among a type parameter's bounds (§13.2).
func bound_member(c: check.Checker*, id: u32, name: str) -> ast.Node*?:
    let p = c.param_node(id) else return none
    var b = p.body
    while let bound = b:
        if let iface = c.table.get(bound.type_id).decl:
            if let m = c.find_member(iface, name):
                return m
        b = bound.next
    return none

pub func check_expr(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let id = try expr_type(c, e, hint)
    e.type_id = id
    return id

func expr_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    match e.kind:
        .literal: return try literal_type(c, e, hint)
        .name: return try name_type(c, e)
        .self_:
            if c.self_type == types.none_id:
                return try c.fail(e, "`self` belongs inside a method")
            let as_receiver = c.self_receiver
            c.self_receiver = false
            if c.in_deinit and not as_receiver:
                return try c.fail(e, "`deinit` does not publish `self`; it reads and calls its own members (§10.3)")
            if let b = c.lookup("self"):
                try note_capture(c, b)
            return c.self_type
        .group:
            let inner = e.left else return try c.fail(e, "empty group")
            return try check_expr(c, inner, hint)
        .convert: return e.type_id
        .unary: return try unary_type(c, e, hint)
        .binary: return try binary_type(c, e, hint)
        .conditional:
            let cond = e.ty else return try c.fail(e, "a conditional needs a condition")
            discard(try expect(c, cond, types.bool_id))
            let l = e.left else return try c.fail(e, "a conditional needs a value")
            let r = e.right else return try c.fail(e, "a conditional needs an alternative")
            let lt = try check_expr(c, l, hint)
            let rt = try check_expr(c, r, hint if hint != types.none_id else lt)
            return try unify(c, l, lt, r, rt)
        .call: return try call_type(c, e, hint)
        .member: return try member_type(c, e, hint)
        .index: return try index_type(c, e)
        .slice: return try slice_type(c, e)
        .tuple:
            let n = ast.count(e.body)
            var members = try alloc u32[n]
            var i: usize = 0
            var cursor = e.body
            var hints = c.table.get(hint).args if c.table.kind(hint) == types.Kind.tuple else try types.no_args()
            while let m = cursor:
                let mh = hints[i] if i < hints.length else types.none_id
                members[i] = try check_expr(c, m, mh)
                if members[i] == types.untyped_none_id:
                    return try c.fail(m, "`none` needs a type here")
                i += 1
                cursor = m.next
            return try c.table.tuple(members)
        .unit_: return types.unit_id
        .list_lit: return try list_literal_type(c, e, hint)
        .set_lit: return try set_literal_type(c, e, hint)
        .map_lit: return try map_literal_type(c, e, hint)
        .map_entry: return try c.fail(e, "an entry belongs in a map literal")
        .lambda: return try lambda_type(c, e, hint)
        .else_: return try else_type(c, e, hint)
        .catch_: return try catch_type(c, e, hint)
        .case_value: return try case_type(c, e, hint)
        .formatted:
            var cursor = e.body
            while let part = cursor:
                if part.kind == ast.Kind.format_field:
                    let v = part.left else return try c.fail(part, "empty field")
                    let vt = try check_expr(c, v, types.none_id)
                    if not displayable(c, vt):
                        return try c.fail(v, try c.with_type("a `", vt, "` has no display (§10.5)"))
                cursor = part.next
            return types.str_id
        .match_expr: return try match_expr_type(c, e, hint)
        .spawn_: return try spawn_type(c, e)
        .wait_:
            let inner = e.left else return try c.fail(e, "`wait` needs a task")
            let t = try check_expr(c, inner, types.none_id)
            if c.table.kind(t) != types.Kind.task_:
                return try c.fail(e, try c.with_type("`wait` takes a task, not a `", t, "` (§14)"))
            return c.table.get(t).elem
        _: return try c.fail(e, "expected an expression")

func literal_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let b = e.text.bytes
    if e.text == "true" or e.text == "false":
        return types.bool_id
    if e.text == "none":
        if c.table.kind(hint) == types.Kind.optional:
            return hint
        return types.untyped_none_id
    let first = b[0]
    if first == '"' or (first == 'r' and b.length > 1 and b[1] == '"'):
        return types.str_id
    if first == 'b' and b.length > 1 and b[1] == '"':
        return types.bytes_id
    if literals.is_float_text(e.text):
        return types.float_id
    let value = literals.decode_integer(e.text) catch failure:
        return try c.fail(e, "integer literal does not fit an `int`")
    if value > 9223372036854775807:
        # the one value that fits only under a leading `-`
        if value != 9223372036854775808 or not e.has(flag_negated):
            return try c.fail(e, "integer literal does not fit an `int` (§3.2)")
    return types.int_id

## Marked on a literal directly under unary `-`, so `-9223372036854775808` fits.
pub let flag_negated: u32 = 8192

func name_type(c: check.Checker*, e: ast.Node*) -> u32!:
    if let b = c.lookup(e.text):
        c.mark_used(e.text)
        e.resolved = b.decl
        try note_capture(c, b)
        return b.type_id
    if let d = c.find_declaration(e.text):
        e.resolved = d
        discard(c.find_import(e.text))
        if d.kind == ast.Kind.constant and d.type_id == types.none_id:
            return try c.fail(e, try c.named("the constant ", e.text, " depends on itself"))
        if d.kind == ast.Kind.func_ and d.ty != none:
            return try c.fail(e, try c.named("", e.text, " is generic: it is called with its type arguments known, not read as a value (§13.2)"))
        if let written = e.ty:
            if d.ty == none or d.kind == ast.Kind.func_:
                return try c.fail(e, try c.named("", e.text, " takes no type arguments"))
            let inst = try instance_for(c, e, d, written)
            e.resolved = inst
            return try c.type_of_declaration(inst)
        return try c.type_of_declaration(d)
    if let module = c.find_module(e.text):
        # an imported module, read only to reach a member (§15.2)
        let imp = c.find_import(e.text) else return try c.fail(e, "no import")
        e.resolved = imp.node
        discard(module)
        return try c.table.module(imp.node)
    if e.text == "print" or e.text == "assert" or e.text == "trap" or e.text == "error" or e.text == "discard" or e.text == "int" or e.text == "float" or e.text == "str" or e.text == "bool" or e.text == "ErrorCode":
        return try c.fail(e, try c.named("", e.text, " is called, not read"))
    return try c.fail(e, try c.named("unknown name ", e.text, ""))

## A name read inside a lambda but bound outside it is captured by that lambda and by
## every lambda between (§7.4): each records the declaration once; a `var` captured is
## flagged, since it becomes a cell.
func note_capture(c: check.Checker*, b: check.Binding) -> !:
    let decl = b.decl else return
    var i = c.lambdas.count
    while i > 0:
        i -= 1
        if b.depth > c.lambda_bases.get(i):
            return
        if c.table.kind(b.type_id) == types.Kind.task_:
            return try c.fail(decl, "a task is waited by the function that spawned it; a closure does not capture it (§14)")
        let lambda = c.lambdas.get(i)
        var seen = false
        var cursor = lambda.left
        while let capture = cursor:
            if capture.resolved == decl:
                seen = true
            cursor = capture.next
        if not seen:
            let capture = try ast.Node.make(ast.Kind.name, b.name, lambda.start, lambda.line)
            capture.resolved = decl
            capture.type_id = b.type_id
            if b.mutable:
                capture.flags |= ast.flag_var_field
                decl.flags |= ast.flag_captured
            var tail = lambda.left
            if let first = tail:
                var last = first
                while let n = last.next:
                    last = n
                last.next = capture
            else:
                lambda.left = capture

## `(params) => e` takes its parameter types from the function type expected of it;
## `func (params) -> R:` writes everything. Either is a closure over what it reads.
func lambda_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let expected = c.table.get(hint)
    let from_context = expected.kind == types.Kind.func_
    let block = e.has(ast.flag_block_lambda)
    if from_context and ast.count(e.right) != expected.args.length:
        return try c.fail(e, try c.with_type("the lambda is used as a `", hint, "`, which takes another number of parameters"))
    var params = try alloc u32[ast.count(e.right)]
    var i: usize = 0
    var cursor = e.right
    while let p = cursor:
        if let t = p.ty:
            p.type_id = try c.resolve_type(t)
            if from_context and i < expected.args.length and p.type_id != expected.args[i]:
                return try c.fail(p, try c.with_type("this parameter is a `", expected.args[i], "` where the lambda is used"))
        elif from_context and i < expected.args.length:
            p.type_id = expected.args[i]
        elif p.type_id != types.none_id:
            discard(0)   # checked before, from a context that gave the type
        else:
            return try c.fail(p, "a parameter's type is written here, or comes from the function type the lambda is used as")
        params[i] = p.type_id
        i += 1
        cursor = p.next
    if from_context and i != expected.args.length:
        return try c.fail(e, try c.with_type("the lambda is used as a `", hint, "`, which takes another number of parameters"))
    var result = types.unit_id
    if block:
        if let t = e.ty:
            result = try c.resolve_type(t)
    elif from_context and expected.elem != types.none_id:
        result = expected.elem
    # the body: a fresh function context over the enclosing one, the outer names visible
    # but captured (RUNTIME)
    let saved_result = c.result_type
    let saved_fallible = c.fallible
    let saved_loops = c.loop_depth
    let saved_labels = c.label_count
    let saved_func = c.current_func
    var bare = result
    c.fallible = false
    if c.table.kind(result) == types.Kind.fallible:
        c.fallible = true
        bare = c.table.get(result).elem
    c.result_type = bare
    c.loop_depth = 0
    c.label_count = 0
    c.current_func = e
    try c.lambdas.push(e)
    try c.lambda_bases.push(c.depth)
    c.push_scope()
    cursor = e.right
    while let p = cursor:
        try c.bind(p, p.text, p.type_id, p, false)
        cursor = p.next
    let body = e.body else return try c.fail(e, "a lambda needs a body")
    if block:
        let exits = try check_block(c, body)
        if bare != types.unit_id and not exits:
            return try c.fail(e, "not every path returns a value (§7.1)")
    else:
        if from_context and expected.elem != types.none_id:
            let got = try expect(c, body, bare)
            discard(got)
        else:
            result = try check_expr(c, body, types.none_id)
            if result == types.untyped_none_id:
                return try c.fail(body, "a lambda's `none` needs the function type from the context")
    c.pop_scope()
    c.lambdas.count -= 1
    c.lambda_bases.count -= 1
    c.result_type = saved_result
    c.fallible = saved_fallible
    c.loop_depth = saved_loops
    c.label_count = saved_labels
    c.current_func = saved_func
    return try c.table.function(params, result)

func unary_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let inner = e.left else return try c.fail(e, "missing operand")
    if e.text == "try":
        if not c.fallible:
            return try c.fail(e, "`try` belongs in a function whose result is `!` (§12.2)")
        let it = try check_expr(c, inner, try c.table.fallible(hint) if hint != types.none_id else types.none_id)
        if c.table.kind(it) != types.Kind.fallible:
            return try c.fail(e, "`try` takes a result, `T!`")
        return c.table.get(it).elem
    if e.text == "not":
        discard(try expect(c, inner, types.bool_id))
        return types.bool_id
    if inner.kind == ast.Kind.literal:
        inner.flags |= flag_negated
    let it = try check_expr(c, inner, hint)
    if it != types.int_id and it != types.float_id:
        return try c.fail(e, "`-` takes an `int` or a `float`")
    return it

func binary_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let l = e.left else return try c.fail(e, "missing operand")
    let r = e.right else return try c.fail(e, "missing operand")
    let op = e.text
    if op == "and" or op == "or":
        discard(try expect(c, l, types.bool_id))
        discard(try expect(c, r, types.bool_id))
        return types.bool_id
    if op == "..<" or op == "..=":
        discard(try expect(c, l, types.int_id))
        discard(try expect(c, r, types.int_id))
        return types.range_id
    if op == "in":
        let rt = try check_expr(c, r, types.none_id)
        let t = c.table.get(rt)
        match t.kind:
            .str_: discard(try expect(c, l, types.str_id))
            .list_, .set_: discard(try expect(c, l, t.elem))
            .map_: discard(try expect(c, l, t.elem))
            .range_: discard(try expect(c, l, types.int_id))
            _: return try c.fail(r, "`in` looks in a `str`, a range, a list, a set, or a map's keys (§6.3)")
        if t.kind != types.Kind.str_ and t.kind != types.Kind.range_ and not equatable(c, t.elem):
            return try c.fail(r, "`in` needs equatable elements")
        return types.bool_id
    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
        let lt = try check_expr(c, l, types.none_id)
        var rt = try check_expr(c, r, lt if lt != types.untyped_none_id else types.none_id)
        var t = lt
        if lt == types.untyped_none_id and rt != types.untyped_none_id:
            t = try coerce(c, l, lt, rt)
        elif rt == types.untyped_none_id:
            t = try coerce(c, r, rt, lt)
        else:
            t = try unify(c, l, lt, r, rt)
        if op == "==" or op == "!=":
            if is_none(l) or is_none(r):
                # a presence test, which every optional has (§12.1)
                return types.bool_id
            if c.table.kind(t) == types.Kind.class_:
                if not conforms(c, t, try equatable_interface(c)):
                    return try c.fail(e, "a class has identity, not equality: compare with `is`, or declare `Equatable` (§4.4)")
            elif not equatable(c, t):
                return try c.fail(e, try c.with_type("a `", t, "` has no `==` (§4.4)"))
        elif not orderable(c, t):
            return try c.fail(e, try c.with_type("a `", t, "` has no ordering (§4.4)"))
        return types.bool_id
    if op == "is" or op == "is not":
        let lt = try check_expr(c, l, types.none_id)
        let rt = try check_expr(c, r, types.none_id)
        var t = lt
        if rt == types.untyped_none_id or lt == types.untyped_none_id:
            let other = lt if rt == types.untyped_none_id else rt
            if c.table.kind(other) != types.Kind.optional:
                return try c.fail(e, try c.with_type("a `", other, "` is never `none`; only an optional is compared with `none`"))
            t = other
        else:
            t = try unify(c, l, lt, r, rt)
        var bare = t
        if c.table.kind(bare) == types.Kind.optional:
            bare = c.table.get(bare).elem
        if not c.table.is_reference(bare) or c.table.kind(bare) == types.Kind.func_:
            return try c.fail(e, "`is` compares the identity of two objects or collections (§10.2)")
        return types.bool_id
    let lt = try check_expr(c, l, hint)
    let rt = try check_expr(c, r, lt)
    return try arithmetic_type(c, e, op, lt, rt)

## The result of `l op r` for the arithmetic operators (§6.2); `+` also joins texts.
func arithmetic_type(c: check.Checker*, e: ast.Node*, op: str, lt: u32, rt: u32) -> u32!:
    if op == "+" and lt == types.str_id and rt == types.str_id:
        return types.str_id
    if op == "+" and lt == types.bytes_id and rt == types.bytes_id:
        return types.bytes_id
    if op == "+" and c.table.kind(lt) == types.Kind.list_ and lt == rt:
        return lt
    if (lt == types.int_id or lt == types.float_id) and lt != rt:
        return try c.fail(e, "`int` and `float` do not mix; convert one with `int(...)` or `float(...)` (§6.2)")
    if lt != types.int_id and lt != types.float_id:
        return try c.fail(e, try c.with_type("arithmetic takes an `int` or a `float`, not a `", lt, "`"))
    if op == "/":
        return types.float_id
    if op == "**" and lt == types.int_id:
        return types.int_id
    if op == "+" or op == "-" or op == "*" or op == "//" or op == "%" or op == "**":
        return lt
    return try c.fail(e, "unknown operator")

## Two operand types made one; `none` follows the other side.
func unify(c: check.Checker*, l: ast.Node*, lt: u32, r: ast.Node*, rt: u32) -> u32!:
    if lt == rt:
        return lt
    if lt == types.never_id:
        return rt
    if rt == types.never_id:
        return lt
    if lt == types.untyped_none_id:
        # `none if c else 3` is an `int?`
        let target = rt if c.table.kind(rt) == types.Kind.optional else try c.table.optional(rt)
        return try coerce(c, l, lt, target)
    if rt == types.untyped_none_id:
        let target = lt if c.table.kind(lt) == types.Kind.optional else try c.table.optional(lt)
        return try coerce(c, r, rt, target)
    if c.table.kind(lt) == types.Kind.optional and c.table.get(lt).elem == rt:
        return lt
    if c.table.kind(rt) == types.Kind.optional and c.table.get(rt).elem == lt:
        return rt
    return try c.mismatch(r, lt, rt)

# mark: Members, calls, construction ==========================================================

func member_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let receiver = e.left else return try c.fail(e, "no receiver")
    c.self_receiver = receiver.kind == ast.Kind.self_
    let rt = try check_expr(c, receiver, types.none_id)
    c.self_receiver = false
    let t = c.table.get(rt)
    if t.kind == types.Kind.module:
        # `module.name`: a public declaration of an imported module (§15.2)
        let node = t.decl else return try c.fail(e, "no import")
        let d = try c.public_declaration(node.module, e.text, e)
        e.resolved = d
        if d.kind == ast.Kind.func_ and d.ty != none:
            return try c.fail(e, try c.named("", e.text, " is generic: it is called with its type arguments known, not read as a value (§13.2)"))
        if let written = e.ty:
            if d.ty == none or d.kind == ast.Kind.func_:
                return try c.fail(e, try c.named("", e.text, " takes no type arguments"))
            let inst = try instance_for(c, e, d, written)
            e.resolved = inst
            return try c.type_of_declaration(inst)
        return try c.type_of_declaration(d)
    if t.kind == types.Kind.type_name:
        # `Type.member`: a type function, a case, or a constant of the type
        var d = t.decl else return try c.fail(e, "no declaration")
        var named = t
        if d.ty != none and not d.has(ast.flag_instance):
            # a generic type's case or function: the expected type says which instance
            let args = try infer_type_arguments(c, e, d, none, false, hint)
            let id = try c.instantiate_type(e, d, args)
            d = c.table.get(id).decl else return try c.fail(e, "no declaration")
            receiver.resolved = d
            receiver.type_id = try c.type_of_declaration(d)
            named = c.table.get(receiver.type_id)
        let inner = c.table.get(named.elem)
        let m = c.find_member(d, e.text) else return try c.fail(e, try c.named("", d.text, " has no member ") if false else try c.named("no member ", e.text, ""))
        e.resolved = m
        if m.kind == ast.Kind.enum_case:
            if m.body != none:
                return try c.fail(e, try c.named("the case ", e.text, " carries a payload; construct it with arguments"))
            return named.elem
        if m.kind == ast.Kind.func_:
            if check.has_self(m):
                return try c.fail(e, try c.named("the method ", e.text, " is called on a value, not through its type"))
            try check_visible(c, e, d, m)
            return m.type_id
        return try c.fail(e, try c.named("", e.text, " is not a member reached through the type"))
    if t.kind == types.Kind.tuple:
        let index = literals.decode_integer(e.text) catch failure:
            return try c.fail(e, "a tuple has no named members; use `.0`, `.1` or destructure")
        if index >= (u64)t.args.length:
            return try c.fail(e, "no such tuple member")
        return t.args[(usize)index]
    if t.kind == types.Kind.optional:
        return try c.fail(e, "an optional is read with `if let`, `else`, or `match` first (§12.1)")
    if t.kind == types.Kind.weak_:
        return try c.fail(e, "a `Weak` has `get()` and nothing else (§10.4)")
    if e.text == "length" and (t.kind == types.Kind.str_ or t.kind == types.Kind.bytes_ or t.kind == types.Kind.list_ or t.kind == types.Kind.map_ or t.kind == types.Kind.set_):
        return types.int_id
    if t.kind == types.Kind.list_ and (e.text == "first" or e.text == "last"):
        e.flags |= ast.flag_builtin
        return try c.table.optional(t.elem)
    if t.kind == types.Kind.list_:
        return try c.fail(e, try c.named("a list has no ", e.text, "; its operations are those of §11.1"))
    if t.kind == types.Kind.map_ or t.kind == types.Kind.set_:
        return try c.fail(e, try c.named("a map or a set has no ", e.text, "; their operations are those of §11.2"))
    if t.kind == types.Kind.error_value:
        if e.text == "code":
            return types.error_code_id
        if e.text == "message":
            return types.str_id
        return try c.fail(e, "an `Error` has `code` and `message`")
    if t.kind == types.Kind.str_ and e.text == "byte_count":
        e.flags |= ast.flag_builtin
        return types.int_id
    if t.kind == types.Kind.str_:
        return try c.fail(e, try c.named("a `str` has no ", e.text, "; its operations are those of §11.3"))
    if t.kind == types.Kind.bytes_:
        return try c.fail(e, try c.named("`bytes` has no ", e.text, "; its operations are those of §11.4"))
    if t.kind == types.Kind.param:
        let m = bound_member(c, rt, e.text) else return try c.fail(e, try c.message(["a `", try c.type_text(rt), "` has only what its bounds require; no `", e.text, "`"]))
        e.resolved = m
        return try c.table.substitute(m.type_id, rt)
    let d = t.decl else return try c.fail(e, "this value has no members")
    let m = c.find_member(d, e.text) else return try c.fail(e, try c.named("no member ", e.text, ""))
    e.resolved = m
    if m.kind == ast.Kind.field:
        try check_visible(c, e, d, m)
        return m.type_id
    if m.kind == ast.Kind.func_:
        if not check.has_self(m):
            return try c.fail(e, try c.named("", e.text, " is a type function; call it through the type"))
        try check_visible(c, e, d, m)
        return m.type_id
    if m.kind == ast.Kind.enum_case:
        return try c.fail(e, "a case is reached through the type, `Shape.empty`")
    return try c.fail(e, "unknown member")

## A member of another module's type must be `pub` (§15.2); one file is one module now.
func check_visible(c: check.Checker*, e: ast.Node*, d: ast.Node*, m: ast.Node*) -> !:
    # an interface's requirements are as visible as the interface itself
    if (usize)d.module == c.current or d.module == 0 or m.has(ast.flag_pub) or d.kind == ast.Kind.interface_:
        return
    let home = c.modules.get((usize)d.module)
    return try c.fail(e, try c.message(["`", m.text, "` of `", c.display_name(d), "` is private to the module `", home.name, "` (§15.2)"]))

## `[a, b, c]`: the element type from the context, or from the elements, which agree.
func list_literal_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    var elem = types.none_id
    if c.table.kind(hint) == types.Kind.list_:
        elem = c.table.get(hint).elem
    var cursor = e.body
    while let item = cursor:
        if elem == types.none_id:
            elem = try check_expr(c, item, types.none_id)
            if elem == types.untyped_none_id:
                return try c.fail(item, "a `none` in a list literal needs the list's type written")
        else:
            discard(try expect(c, item, elem))
        cursor = item.next
    if elem == types.none_id:
        return try c.fail(e, "an empty list needs a written type, `let names: list[str] = []`")
    return try c.table.list_of(elem)

## `{a, b}`: a set; `{}` is an empty map, or an empty set when a set is expected.
func set_literal_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    var elem = types.none_id
    if c.table.kind(hint) == types.Kind.set_:
        elem = c.table.get(hint).elem
    var cursor = e.body
    while let item = cursor:
        if elem == types.none_id:
            elem = try check_expr(c, item, types.none_id)
            if elem == types.untyped_none_id:
                return try c.fail(item, "a `none` in a set literal needs the set's type written")
        else:
            discard(try expect(c, item, elem))
        cursor = item.next
    if elem == types.none_id:
        return try c.fail(e, "an empty set needs a written type, `let seen: set[int] = {}`")
    if not hashable(c, elem):
        return try c.fail(e, try c.with_type("a set's elements are equatable and hashable, which a `", elem, "` is not (§11.2)"))
    return try c.table.set_of(elem)

## `{k: v, ...}`: a map; `{}` is an empty map, its types from the context.
func map_literal_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    var key = types.none_id
    var value = types.none_id
    let hk = c.table.kind(hint)
    if hk == types.Kind.map_:
        key = c.table.get(hint).elem
        value = c.table.map_value(hint)
    elif hk == types.Kind.set_ and e.body == none:
        return hint
    var cursor = e.body
    while let entry = cursor:
        let k = entry.left else return try c.fail(entry, "an entry needs a key")
        let v = entry.right else return try c.fail(entry, "an entry needs a value")
        if key == types.none_id:
            key = try check_expr(c, k, types.none_id)
            value = try check_expr(c, v, types.none_id)
            if key == types.untyped_none_id or value == types.untyped_none_id:
                return try c.fail(entry, "a `none` in a map literal needs the map's type written")
        else:
            discard(try expect(c, k, key))
            discard(try expect(c, v, value))
        cursor = entry.next
    if key == types.none_id:
        return try c.fail(e, "an empty map needs a written type, `let ages: map[str, int] = {}`")
    if not hashable(c, key):
        return try c.fail(e, try c.with_type("a map's keys are equatable and hashable, which a `", key, "` is not (§11.2)"))
    return try c.table.map_of(key, value)

## `m.method(args)` for a map or a set (§11.2).
func map_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, mt: u32) -> u32!:
    let t = c.table.get(mt)
    let is_map = t.kind == types.Kind.map_
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = mt
    var n: usize = 0
    var cursor = e.body
    while let a = cursor:
        if a.text.length > 0:
            return try c.fail(a, "a map's or a set's method takes positional arguments")
        n += 1
        cursor = a.next
    if name == "clear" or name == "copy":
        if n != 0:
            return try c.fail(e, try c.named("`", name, "()` takes no arguments"))
        return types.unit_id if name == "clear" else mt
    if is_map:
        if name == "remove":
            try one_argument(c, e, n, t.elem)
            return try c.table.optional(c.table.map_value(mt))
        if name == "keys" or name == "values" or name == "items":
            if n != 0:
                return try c.fail(e, try c.named("`", name, "()` takes no arguments"))
            if name == "keys":
                return try c.table.list_of(t.elem)
            if name == "values":
                return try c.table.list_of(c.table.map_value(mt))
            var pair = try alloc u32[2]
            pair[0] = t.elem
            pair[1] = c.table.map_value(mt)
            return try c.table.list_of(try c.table.tuple(pair))
        return try c.fail(callee, try c.named("a map has no ", name, "; its operations are those of §11.2"))
    if name == "insert":
        try one_argument(c, e, n, t.elem)
        return types.unit_id
    if name == "remove":
        try one_argument(c, e, n, t.elem)
        return types.bool_id
    if name == "union" or name == "intersection" or name == "difference":
        try one_argument(c, e, n, mt)
        return mt
    return try c.fail(callee, try c.named("a set has no ", name, "; its operations are those of §11.2"))

## `text.method(args)` for a `str` (§11.3) or `bytes` (§11.4).
func text_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, t: u32) -> u32!:
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = t
    var n: usize = 0
    var cursor = e.body
    while let a = cursor:
        if a.text.length > 0:
            return try c.fail(a, "a text's method takes positional arguments")
        n += 1
        cursor = a.next
    if t == types.bytes_id:
        if name == "text":
            if n != 0:
                return try c.fail(e, "`text()` takes no arguments")
            return try c.table.fallible(types.str_id)
        return try c.fail(callee, try c.named("`bytes` has no ", name, "; its operations are those of §11.4"))
    if name == "contains" or name == "starts_with" or name == "ends_with" or name == "index_of" or name == "split":
        try one_argument(c, e, n, types.str_id)
        if name == "index_of":
            return try c.table.optional(types.int_id)
        if name == "split":
            return try c.table.list_of(types.str_id)
        return types.bool_id
    if name == "lines" or name == "trim" or name == "upper" or name == "lower" or name == "bytes":
        if n != 0:
            return try c.fail(e, try c.named("`", name, "()` takes no arguments"))
        if name == "lines":
            return try c.table.list_of(types.str_id)
        if name == "bytes":
            return types.bytes_id
        return types.str_id
    if name == "replace":
        if n != 2:
            return try c.fail(e, "`replace(old, new)` takes two texts")
        let first = e.body else return try c.fail(e, "no argument")
        let second = first.next else return try c.fail(e, "no argument")
        discard(try expect(c, first.left else return try c.fail(e, "no argument"), types.str_id))
        discard(try expect(c, second.left else return try c.fail(e, "no argument"), types.str_id))
        return types.str_id
    if name == "repeat":
        try one_argument(c, e, n, types.int_id)
        return types.str_id
    return try c.fail(callee, try c.named("a `str` has no ", name, "; its operations are those of §11.3"))

## Whether a value of the type may key a map or sit in a set (§4.4, §11.2): equatable, and
## its hash consistent with its equality, so a type that declares `Equatable` declares
## `Hashable` beside it, and a class hashes only as declared (§13.3).
pub func hashable(c: check.Checker*, id: u32) -> bool:
    return hashable_at(c, id, 0)

## The same, bounded: a type that holds itself through a list, a map or a payload is
## taken as having the property where the walk meets it again.
func hashable_at(c: check.Checker*, id: u32, depth: u32) -> bool:
    if depth > 32:
        return true
    let t_kind = c.table.kind(id)
    if t_kind == types.Kind.struct_ or t_kind == types.Kind.enum_:
        let fresh = c.entering(id) catch failure: recover false
        if not fresh:
            return true
        let answer = hashable_walk(c, id, depth)
        c.leave_walk()
        return answer
    return hashable_walk(c, id, depth)

func hashable_walk(c: check.Checker*, id: u32, depth: u32) -> bool:
    if not equatable(c, id):
        return false
    let t = c.table.get(id)
    match t.kind:
        .optional: return hashable_at(c, t.elem, depth + 1)
        .tuple:
            for m in t.args:
                if not hashable_at(c, m, depth + 1):
                    return false
            return true
        .list_, .set_: return hashable_at(c, t.elem, depth + 1)
        .map_: return hashable_at(c, t.elem, depth + 1) and hashable_at(c, c.table.map_value(id), depth + 1)
        .class_, .param: return conforms(c, id, hashable_interface(c) catch failure: recover types.none_id)
        .struct_, .enum_:
            if conforms(c, id, equatable_interface(c) catch failure: recover types.none_id):
                return conforms(c, id, hashable_interface(c) catch failure: recover types.none_id)
            let d = t.decl else return false
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.field and not hashable_at(c, m.type_id, depth + 1):
                    return false
                if m.kind == ast.Kind.enum_case:
                    var p = m.body
                    while let field = p:
                        if not hashable_at(c, field.type_id, depth + 1):
                            return false
                        p = field.next
                cursor = m.next
            return true
        _: return true

## `values.method(args)` for a list (§11.1): the call is marked builtin and typed here.
func list_method_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, lt: u32) -> u32!:
    let elem = c.table.get(lt).elem
    let name = callee.text
    callee.flags |= ast.flag_builtin
    callee.type_id = lt
    var n: usize = 0
    var cursor = e.body
    while let a = cursor:
        if a.text.length > 0:
            return try c.fail(a, "a list's method takes positional arguments")
        n += 1
        cursor = a.next
    if name == "append" or name == "contains" or name == "index_of":
        try one_argument(c, e, n, elem)
        if name != "append" and not equatable(c, elem):
            return try c.fail(e, try c.with_type("`", lt, "` has no `==` on its elements, so nothing is searched"))
        if name == "append":
            return types.unit_id
        return types.bool_id if name == "contains" else try c.table.optional(types.int_id)
    if name == "insert":
        if n != 2:
            return try c.fail(e, "`insert(index, value)` takes two arguments")
        let first = e.body else return try c.fail(e, "no argument")
        let second = first.next else return try c.fail(e, "no argument")
        discard(try expect(c, first.left else return try c.fail(e, "no argument"), types.int_id))
        discard(try expect(c, second.left else return try c.fail(e, "no argument"), elem))
        return types.unit_id
    if name == "remove_at":
        try one_argument(c, e, n, types.int_id)
        return elem
    if name == "pop" or name == "clear" or name == "sort" or name == "reverse" or name == "sorted" or name == "reversed" or name == "copy":
        if n != 0:
            return try c.fail(e, try c.named("`", name, "()` takes no arguments"))
        if (name == "sort" or name == "sorted") and not orderable(c, elem):
            return try c.fail(e, try c.with_type("`", lt, "` has no ordering on its elements (§4.4)"))
        if name == "pop":
            return elem
        if name == "sorted" or name == "reversed" or name == "copy":
            return lt
        return types.unit_id
    if name == "join":
        try one_argument(c, e, n, types.str_id)
        if elem != types.str_id:
            return try c.fail(e, "`join` belongs to a `list[str]`")
        return types.str_id
    if name == "map" or name == "filter":
        if n != 1:
            return try c.fail(e, try c.named("`", name, "(f)` takes one function"))
        let first = e.body else return try c.fail(e, "no argument")
        let f = first.left else return try c.fail(e, "no argument")
        # a lambda written here takes the element as its parameter; `map`'s result comes
        # from the lambda's body, so its hint leaves the result open
        var one = try alloc u32[1]
        one[0] = elem
        let hint = try c.table.function(one, types.bool_id if name == "filter" else types.none_id)
        let ft = try check_expr(c, f, hint)
        let t = c.table.get(ft)
        if t.kind != types.Kind.func_ or t.args.length != 1 or t.args[0] != elem:
            return try c.fail(f, try c.with_type("`", lt, "`'s `map` and `filter` take a function of one element"))
        if name == "filter":
            if t.elem != types.bool_id:
                return try c.fail(f, "`filter` takes a function returning `bool`")
            return lt
        if t.elem == types.unit_id or c.table.kind(t.elem) == types.Kind.fallible:
            return try c.fail(f, "`map` takes a function returning a value")
        return try c.table.list_of(t.elem)
    return try c.fail(callee, try c.named("a list has no ", name, "; its operations are those of §11.1"))

func one_argument(c: check.Checker*, e: ast.Node*, n: usize, t: u32) -> !:
    if n != 1:
        return try c.fail(e, "this method takes one argument")
    let first = e.body else return try c.fail(e, "no argument")
    let v = first.left else return try c.fail(e, "no argument")
    discard(try expect(c, v, t))

func index_type(c: check.Checker*, e: ast.Node*) -> u32!:
    let receiver = e.left else return try c.fail(e, "no receiver")
    let index = e.body else return try c.fail(e, "no index")
    let rt = try check_expr(c, receiver, types.none_id)
    let t = c.table.get(rt)
    match t.kind:
        .list_:
            discard(try expect(c, index, types.int_id))
            return t.elem
        .bytes_:
            discard(try expect(c, index, types.int_id))
            return types.int_id
        .map_:
            discard(try expect(c, index, t.elem))
            return try c.table.optional(c.table.map_value(rt))
        .str_:
            return try c.fail(e, "a `str` is not indexed; slice it, iterate it, or use its bytes (§11.3)")
        _: return try c.fail(e, try c.with_type("a `", rt, "` is not indexed"))

func slice_type(c: check.Checker*, e: ast.Node*) -> u32!:
    let receiver = e.left else return try c.fail(e, "no receiver")
    let rt = try check_expr(c, receiver, types.none_id)
    let k = c.table.kind(rt)
    if k != types.Kind.list_ and k != types.Kind.str_ and k != types.Kind.bytes_:
        return try c.fail(e, try c.with_type("a `", rt, "` is not sliced"))
    if let low = e.body:
        discard(try expect(c, low, types.int_id))
    if let high = e.right:
        discard(try expect(c, high, types.int_id))
    return rt

## `.case` or `.case(args)` where the enum is known from context.
func case_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    var target = hint
    if c.table.kind(target) == types.Kind.optional:
        target = c.table.get(target).elem
    if c.table.kind(target) != types.Kind.enum_:
        return try c.fail(e, "a leading `.` needs an enum known from context; write `Type.case`")
    let d = c.table.get(target).decl else return try c.fail(e, "no declaration")
    let m = c.find_member(d, e.text) else return try c.fail(e, try c.named("no case ", e.text, ""))
    if m.kind != ast.Kind.enum_case:
        return try c.fail(e, try c.named("", e.text, " is not a case"))
    e.resolved = m
    if m.body != none or e.body != none:
        try check_arguments(c, e, e.body, m.body, false, types.none_id)
    return target

func call_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let callee = e.left else return try c.fail(e, "nothing to call")
    if callee.kind == ast.Kind.name and c.lookup(callee.text) == none:
        if let d = c.find_declaration(callee.text):
            if d.kind == ast.Kind.func_ and d.ty != none:
                discard(c.find_import(callee.text))
                return try generic_call(c, e, callee, d)
    if callee.kind == ast.Kind.member:
        # `module.f(...)`: a generic function of an imported module is called the same way
        if let owner = callee.left:
            if owner.kind == ast.Kind.name and c.lookup(owner.text) == none and c.find_declaration(owner.text) == none:
                if let module = c.find_module(owner.text):
                    let d = try c.public_declaration(module, callee.text, callee)
                    if d.kind == ast.Kind.func_ and d.ty != none:
                        let imp = c.find_import(owner.text) else return try c.fail(owner, "no import")
                        owner.resolved = imp.node
                        owner.type_id = try c.table.module(imp.node)
                        return try generic_call(c, e, callee, d)
    if e.ty != none and callee.kind != ast.Kind.name and callee.kind != ast.Kind.member:
        return try c.fail(e, "only a generic function or type takes type arguments (§13.2)")
    if callee.kind == ast.Kind.name and c.lookup(callee.text) == none and c.find_declaration(callee.text) == none and c.find_module(callee.text) == none:
        return try core_call(c, e, callee.text)
    if callee.kind == ast.Kind.member and callee.text == "package":
        if let owner = callee.left:
            if owner.kind == ast.Kind.name and owner.text == "ErrorCode" and c.lookup("ErrorCode") == none:
                return try package_code(c, e)
    if callee.kind == ast.Kind.case_value:
        callee.body = e.body
        e.body = none
        let t = try check_expr(c, callee, hint)
        e.resolved = callee.resolved
        e.body = callee.body
        callee.body = none
        return t
    if callee.kind == ast.Kind.member:
        # `Shape.circle(radius = 2.0)`: a case with a payload, through its enum
        if let owner = callee.left:
            let ot = try check_expr(c, owner, types.none_id)
            let o = c.table.get(ot)
            if o.kind == types.Kind.type_name:
                if let d = o.decl:
                    if d.kind == ast.Kind.enum_:
                        var owner_decl = d
                        var enum_type = o.elem
                        let m = c.find_member(d, callee.text) else return try c.fail(callee, try c.named("no case ", callee.text, ""))
                        if m.kind == ast.Kind.enum_case and d.ty != none and not d.has(ast.flag_instance):
                            let args = try infer_type_arguments(c, e, d, m.body, false, hint)
                            enum_type = try c.instantiate_type(e, d, args)
                            owner_decl = c.table.get(enum_type).decl else return try c.fail(e, "no declaration")
                            owner.resolved = owner_decl
                            owner.type_id = try c.type_of_declaration(owner_decl)
                        let case_node = c.find_member(owner_decl, callee.text) else return try c.fail(callee, try c.named("no case ", callee.text, ""))
                        if case_node.kind == ast.Kind.enum_case:
                            callee.resolved = case_node
                            callee.type_id = enum_type
                            e.resolved = case_node
                            try check_arguments(c, e, e.body, case_node.body, false, types.none_id)
                            return enum_type
    if callee.kind == ast.Kind.member:
        # a list's own methods (§11.1): no declaration resolves them
        if let owner = callee.left:
            if owner.kind != ast.Kind.self_:
                let ot = try check_expr(c, owner, types.none_id)
                if c.table.kind(ot) == types.Kind.list_:
                    return try list_method_type(c, e, callee, ot)
                if c.table.kind(ot) == types.Kind.map_ or c.table.kind(ot) == types.Kind.set_:
                    return try map_method_type(c, e, callee, ot)
                if ot == types.str_id or ot == types.bytes_id:
                    return try text_method_type(c, e, callee, ot)
    if callee.kind == ast.Kind.member and callee.text == "get":
        # `weak.get()`: the object, or none once it is gone (§10.4)
        if let owner = callee.left:
            if owner.kind != ast.Kind.self_:
                let ot = try check_expr(c, owner, types.none_id)
                if c.table.kind(ot) == types.Kind.weak_:
                    if e.body != none:
                        return try c.fail(e, "`get()` takes no arguments")
                    callee.type_id = ot
                    return try c.table.optional(c.table.get(ot).elem)
    let ct = try check_expr(c, callee, types.none_id)
    let t = c.table.get(ct)
    if t.kind == types.Kind.type_name:
        var named = t
        if let d = t.decl:
            if let written = e.ty:
                if d.ty == none or d.has(ast.flag_instance):
                    return try c.fail(e, try c.named("", c.display_name(d), " takes no type arguments"))
                let inst = try instance_for(c, e, d, written)
                callee.resolved = inst
                named = c.table.get(try c.type_of_declaration(inst))
            elif d.ty != none and not d.has(ast.flag_instance) and d.kind != ast.Kind.enum_:
                var params = d.body
                var skip = false
                if let init = c.find_member(d, "init"):
                    params = init.right
                    skip = true
                let args = try infer_type_arguments(c, e, d, params, skip, hint)
                let id = try c.instantiate_type(e, d, args)
                let inst = c.table.get(id).decl else return try c.fail(e, "no declaration")
                callee.resolved = inst
                named = c.table.get(try c.type_of_declaration(inst))
        return try construction_type(c, e, callee, named)
    if t.kind == types.Kind.func_:
        # a name or a member naming a function is called directly; anything else, a call
        # returning a function among them, is a value called through its type
        if callee.kind == ast.Kind.name or callee.kind == ast.Kind.member:
            if let d = callee.resolved:
                if d.kind == ast.Kind.func_:
                    e.resolved = d
                    var owner = types.none_id
                    if check.has_self(d):
                        try check_receiver(c, e, callee, d)
                        if d.body == none:
                            # a requirement: `Self` is the receiver's type, which an interface
                            # value does not know (§13.3)
                            if let receiver = callee.left:
                                if c.table.kind(receiver.type_id) == types.Kind.param:
                                    owner = receiver.type_id
                                elif mentions_self(c, d.type_id):
                                    return try c.fail(e, try c.named("", d.text, " mentions `Self`; it is called on a value of the conforming type, not through an interface value (§13.3)"))
                    try check_arguments(c, e, e.body, d.right, true, owner)
                    if d.has(ast.flag_base):
                        try base_arguments(c, e, d)
                    return t.elem
        # a function value: positional arguments only
        var n: usize = 0
        var cursor = e.body
        while let a = cursor:
            if a.text.length > 0:
                return try c.fail(a, "a function value takes positional arguments")
            if n >= t.args.length:
                return try c.fail(a, "too many arguments")
            let v = a.left else return try c.fail(a, "empty argument")
            discard(try expect(c, v, t.args[n]))
            n += 1
            cursor = a.next
        if n < t.args.length:
            return try c.fail(e, "too few arguments")
        return t.elem
    return try c.fail(callee, try c.with_type("a `", ct, "` is not called"))

## `Name(args)`: a struct memberwise or through `init`, a class through `init`.
func construction_type(c: check.Checker*, e: ast.Node*, callee: ast.Node*, t: types.Type) -> u32!:
    let d = t.decl else return try c.fail(e, "no declaration")
    let target = t.elem
    if d.kind == ast.Kind.type_alias:
        return try c.fail(e, "an alias is not constructed; name the type")
    if d.kind == ast.Kind.enum_:
        return try c.fail(e, "an enum is constructed by case: `Shape.circle(radius = 2.0)`")
    if d.kind == ast.Kind.interface_:
        return try c.fail(e, "an interface is not constructed")
    if d.kind == ast.Kind.class_ and d.has(ast.flag_base):
        return try c.fail(e, "a handle is made by the Base module's functions, never constructed (§16.4)")
    e.resolved = d
    if let init = c.find_member(d, "init"):
        e.resolved = init
        try check_arguments(c, e, e.body, init.right, true, types.none_id)
        let result = c.table.get(init.type_id).elem
        if c.table.kind(result) == types.Kind.fallible:
            return try c.table.fallible(target)
        return target
    if d.kind == ast.Kind.class_:
        if e.body != none:
            return try c.fail(e, "this class has no `init`; it is constructed with no arguments")
        return target
    # memberwise: every field once, defaults may be omitted
    try check_arguments(c, e, e.body, d.body, false, types.none_id)
    return target

## A method's receiver: a mutating method on a struct needs a `var` (§7.3).
func check_receiver(c: check.Checker*, e: ast.Node*, callee: ast.Node*, d: ast.Node*) -> !:
    let receiver = callee.left else return
    if d.has(ast.flag_mutating) and c.table.is_value(receiver.type_id):
        if not try place_is_mutable(c, receiver):
            return try c.fail(callee, try c.named("the method ", d.text, " changes its receiver, which must be a `var` (§7.3)"))

## Arguments against parameters or fields: positional then named, each once, defaults for
## the rest. `params` are `param` nodes (with `self` skipped) or `field` nodes.
## `spawn f(args)` (§14): a call of a named function of the program, its arguments and its
## result sendable; a task of the result.
func spawn_type(c: check.Checker*, e: ast.Node*) -> u32!:
    let call = e.left else return try c.fail(e, "`spawn` starts a call")
    if call.kind != ast.Kind.call:
        return try c.fail(e, "`spawn` starts a call of a named function (§14)")
    let callee = call.left else return try c.fail(e, "nothing to call")
    var named = callee.kind == ast.Kind.name
    if callee.kind == ast.Kind.member:
        if let owner = callee.left:
            named = owner.kind == ast.Kind.name and c.lookup(owner.text) == none and c.find_module(owner.text) != none
    if not named:
        return try c.fail(callee, "`spawn` starts a call of a named function: a method or a closure would share what a worker may not (§14)")
    let result = try check_expr(c, call, types.none_id)
    let d = call.resolved else return try c.fail(callee, "`spawn` starts a call of a named function (§14)")
    if d.kind != ast.Kind.func_ or check.has_self(d) or d.has(ast.flag_base) or d.module == 0:
        return try c.fail(callee, "`spawn` starts a call of a named function of the program (§14)")
    var a = call.body
    while let arg = a:
        let v = arg.left else return try c.fail(arg, "empty argument")
        if not sendable(c, v.type_id):
            return try c.fail(v, try c.with_type("a `", v.type_id, "` is not sendable: a worker takes scalars, texts, tuples, structs, enums and copies of collections of those (§14)"))
        a = arg.next
    var answer = result
    if c.table.kind(answer) == types.Kind.fallible:
        answer = c.table.get(answer).elem
    if answer != types.unit_id and not sendable(c, answer):
        return try c.fail(callee, try c.with_type("the task's result, a `", answer, "`, is not sendable (§14)"))
    return try c.table.task_of(result)

## Whether values of the type cross to a worker (§14): by copy, sharing nothing.
pub func sendable(c: check.Checker*, id: u32) -> bool:
    return sendable_at(c, id, 0)

## The same, bounded: a type that holds itself through a list, a map or a payload is
## taken as having the property where the walk meets it again.
func sendable_at(c: check.Checker*, id: u32, depth: u32) -> bool:
    if depth > 32:
        return true
    let t_kind = c.table.kind(id)
    if t_kind == types.Kind.struct_ or t_kind == types.Kind.enum_:
        let fresh = c.entering(id) catch failure: recover false
        if not fresh:
            return true
        let answer = sendable_walk(c, id, depth)
        c.leave_walk()
        return answer
    return sendable_walk(c, id, depth)

func sendable_walk(c: check.Checker*, id: u32, depth: u32) -> bool:
    let t = c.table.get(id)
    match t.kind:
        .int_, .float_, .bool_, .str_, .bytes_, .unit_, .error_code, .error_value, .range_: return true
        .optional, .fallible: return sendable_at(c, t.elem, depth + 1)
        .tuple:
            for m in t.args:
                if not sendable_at(c, m, depth + 1):
                    return false
            return true
        .struct_, .enum_:
            let d = t.decl else return false
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.field and not sendable_at(c, m.type_id, depth + 1):
                    return false
                if m.kind == ast.Kind.enum_case:
                    var p = m.body
                    while let field = p:
                        if not sendable_at(c, field.type_id, depth + 1):
                            return false
                        p = field.next
                cursor = m.next
            return true
        .list_, .set_: return sendable_at(c, t.elem, depth + 1)
        .map_: return sendable_at(c, t.elem, depth + 1) and sendable_at(c, c.table.map_value(id), depth + 1)
        _: return false

## A Base function's function-typed parameter takes a named function, never a closure
## (§16.2): Base has no closures, and a named function is capture-free by construction.
func base_arguments(c: check.Checker*, e: ast.Node*, d: ast.Node*) -> !:
    var a = e.body
    while let arg = a:
        if let p = arg.resolved:
            if c.table.kind(p.type_id) == types.Kind.func_:
                let v = arg.left else return try c.fail(arg, "empty argument")
                var named = false
                if v.kind == ast.Kind.name:
                    if let f = v.resolved:
                        named = f.kind == ast.Kind.func_ and f.module != 0 and not f.has(ast.flag_base)
                if not named:
                    return try c.fail(v, "a Base function takes a named function here, not a closure (§16.2)")
        a = arg.next

## arguments whose parameter types mention a type parameter; each must satisfy its bounds;
## the instance for them is then called like any function.
## A generic function called (§13.2): the type arguments are written, or found from the
## arguments whose parameter types mention a type parameter; each must satisfy its bounds;
## the instance for them is then called like any function.
func generic_call(c: check.Checker*, e: ast.Node*, callee: ast.Node*, d: ast.Node*) -> u32!:
    let params = d.ty else return try c.fail(e, "not generic")
    let n = ast.count(params.body)
    var bound = try alloc u32[n]
    var i: usize = 0
    while i < n:
        bound[i] = types.none_id
        i += 1
    if let written = e.ty:
        if ast.count(written.body) != n:
            return try c.fail(e, try type_argument_count(c, d, n))
        var cursor = written.body
        i = 0
        while let t = cursor:
            bound[i] = try c.resolve_type(t)
            i += 1
            cursor = t.next
    else:
        try infer_from_arguments(c, e, d, d.right, true, bound)
    i = 0
    var cursor = params.body
    while let p = cursor:
        if bound[i] == types.none_id or bound[i] == types.untyped_none_id:
            return try c.fail(e, try c.message(["the type parameter `", p.text, "` of `", d.text, "` is not fixed by the arguments; write the type arguments, `name[int](...)`"]))
        var b = p.body
        while let requirement = b:
            if not satisfies(c, bound[i], requirement.type_id):
                return try c.fail(e, try c.message(["`", try c.type_text(bound[i]), "` does not have `", try c.type_text(requirement.type_id), "`, which `", p.text, "` requires (§13.2)"]))
            b = requirement.next
        i += 1
        cursor = p.next
    let inst = try c.instantiate(e, d, bound)
    callee.resolved = inst
    callee.type_id = inst.type_id
    e.resolved = inst
    try check_arguments(c, e, e.body, inst.right, true, types.none_id)
    return c.table.get(inst.type_id).elem

## The instance declaration of a generic type for written type arguments.
func instance_for(c: check.Checker*, e: ast.Node*, d: ast.Node*, written: ast.Node*) -> ast.Node*!:
    let params = d.ty else return try c.fail(e, "not generic")
    let n = ast.count(params.body)
    if ast.count(written.body) != n:
        return try c.fail(e, try type_argument_count(c, d, n))
    var ids = try alloc u32[n if n > 0 else 1]
    var i: usize = 0
    var cursor = written.body
    while let t = cursor:
        ids[i] = try c.resolve_type(t)
        i += 1
        cursor = t.next
    let id = try c.instantiate_type(e, d, ids[..<n])
    return c.table.get(id).decl else return try c.fail(e, "no declaration")

## The type arguments of a generic type for a construction (§13.2): from the expected
## type when it is an instance of the type, else from the arguments given to its fields,
## `init` parameters or case payload, as for a generic function's parameters.
func infer_type_arguments(c: check.Checker*, e: ast.Node*, d: ast.Node*, params: ast.Node*?, skip_self: bool, hint: u32) -> u32[]!:
    let generic = d.ty else return try c.fail(e, "not generic")
    let n = ast.count(generic.body)
    var bound = try alloc u32[n if n > 0 else 1]
    var i: usize = 0
    while i < n:
        bound[i] = types.none_id
        i += 1
    var expected = hint
    if c.table.kind(expected) == types.Kind.optional:
        expected = c.table.get(expected).elem
    if let ed = c.table.get(expected).decl:
        if ed.has(ast.flag_instance) and ed.resolved == d:
            if let ep = ed.ty:
                var cursor = ep.body
                i = 0
                while let p = cursor:
                    bound[i] = p.type_id
                    i += 1
                    cursor = p.next
    try infer_from_arguments(c, e, d, params, skip_self, bound)
    i = 0
    var cursor = generic.body
    while let p = cursor:
        if bound[i] == types.none_id or bound[i] == types.untyped_none_id:
            return try c.fail(e, try c.message(["the type parameter `", p.text, "` of `", d.text, "` is not fixed here; write the type arguments, `", d.text, "[int]`"]))
        i += 1
        cursor = p.next
    return bound[..<n]

## Fixes the parameters of `d` from the arguments of `e` given to `params`: those of a
## bare parameter type first, so the rest are checked with what is known as their hint.
func infer_from_arguments(c: check.Checker*, e: ast.Node*, d: ast.Node*, params: ast.Node*?, skip_self: bool, bound: u32[]) -> !:
    var pass: u32 = 0
    while pass < 2:
        var position: usize = 0
        var a = e.body
        while let arg = a:
            let p = try parameter_of(c, arg, position, params)
            if arg.text.length == 0:
                position += 1
            let bare = c.table.kind(p.type_id) == types.Kind.param
            if c.mentions_param(p.type_id) and ((pass == 0) == bare):
                let v = arg.left else return try c.fail(arg, "empty argument")
                var hint = types.none_id
                if pass == 1:
                    let known = try c.bind_params(d, p.type_id, bound)
                    if not c.mentions_param(known):
                        hint = known
                let got = try check_expr(c, v, hint)
                try unify_param(c, d, p.type_id, got, bound)
            a = arg.next
        pass += 1

func type_argument_count(c: check.Checker*, d: ast.Node*, n: usize) -> str!:
    let half = c.scratch.length // 2
    if n == 1:
        return try format(c.scratch[half..], f"`{d.text}` takes one type argument")
    return try format(c.scratch[half..], f"`{d.text}` takes {n} type arguments")

## The parameter an argument is given to: by name, or by position among the unnamed.
func parameter_of(c: check.Checker*, arg: ast.Node*, position: usize, params: ast.Node*?) -> ast.Node*!:
    var k: usize = 0
    var cursor = params
    while let p = cursor:
        if p.text != "self":
            if arg.text.length > 0:
                if p.text == arg.text:
                    return p
            elif k == position:
                return p
            k += 1
        cursor = p.next
    if arg.text.length > 0:
        return try c.fail(arg, try c.named("no parameter named ", arg.text, ""))
    return try c.fail(arg, "too many arguments")

## Whether a type mentions `Self`.
func mentions_self(c: check.Checker*, id: u32) -> bool:
    if id == types.self_id:
        return true
    let t = c.table.get(id)
    match t.kind:
        .optional, .fallible, .list_, .set_, .weak_, .task_: return mentions_self(c, t.elem)
        .map_: return mentions_self(c, t.elem) or mentions_self(c, c.table.map_value(id))
        .tuple, .func_:
            for m in t.args:
                if mentions_self(c, m):
                    return true
            return mentions_self(c, t.elem) if t.kind == types.Kind.func_ else false
        _: return false

## Matches a parameter type against an argument's type, fixing the type parameters it
## mentions; a parameter fixed twice must be fixed the same.
func unify_param(c: check.Checker*, d: ast.Node*, pattern: u32, actual: u32, bound: u32[]) -> !:
    let p = c.table.get(pattern)
    if p.kind == types.Kind.param:
        if p.decl != d:
            return
        var i: usize = 0
        let params = d.ty else return
        var cursor = params.body
        while let tp = cursor:
            if tp.text == p.name:
                if bound[i] == types.none_id or bound[i] == types.untyped_none_id:
                    bound[i] = actual
                elif bound[i] != actual and actual != types.untyped_none_id and actual != types.never_id:
                    return try c.fail(d, try c.message(["the type parameter `", p.name, "` is `", try c.type_text(bound[i]), "` from one argument and `", try c.type_text(actual), "` from another"]))
                return
            i += 1
            cursor = tp.next
        return
    let a = c.table.get(actual)
    if a.kind != p.kind:
        return
    match p.kind:
        .struct_, .enum_, .class_, .interface_:
            # the same generic type on both sides: its arguments match pairwise
            let pd = p.decl else return
            let ad = a.decl else return
            let pattern_args = pd.ty else return
            let actual_args = ad.ty else return
            let pg = pd.resolved if pd.has(ast.flag_instance) else pd
            let ag = ad.resolved if ad.has(ast.flag_instance) else ad
            if pg != ag:
                return
            var x = pattern_args.body
            var y = actual_args.body
            while let px = x:
                let py = y else return
                try unify_param(c, d, px.type_id, py.type_id, bound)
                x = px.next
                y = py.next
        .optional, .fallible, .list_, .set_, .weak_, .task_: try unify_param(c, d, p.elem, a.elem, bound)
        .map_:
            try unify_param(c, d, p.elem, a.elem, bound)
            try unify_param(c, d, c.table.map_value(pattern), c.table.map_value(actual), bound)
        .tuple, .func_:
            if p.args.length == a.args.length:
                var i: usize = 0
                while i < p.args.length:
                    try unify_param(c, d, p.args[i], a.args[i], bound)
                    i += 1
                if p.kind == types.Kind.func_:
                    try unify_param(c, d, p.elem, a.elem, bound)
        _: discard(0)

func check_arguments(c: check.Checker*, e: ast.Node*, args: ast.Node*?, params: ast.Node*?, skip_self: bool, owner: u32) -> !:
    var n: usize = 0
    var cursor = params
    while let p = cursor:
        if not (skip_self and p.text == "self") and (p.kind == ast.Kind.param or p.kind == ast.Kind.field):
            n += 1
        cursor = p.next
    var given = try alloc bool[n if n > 0 else 1]
    var i: usize = 0
    while i < n:
        given[i] = false
        i += 1
    var position: usize = 0
    var a = args
    while let arg = a:
        var target: ast.Node*? = none
        var slot: usize = 0
        if arg.text.length > 0:
            var k: usize = 0
            var pc = params
            while let p = pc:
                if not (skip_self and p.text == "self") and (p.kind == ast.Kind.param or p.kind == ast.Kind.field):
                    if p.text == arg.text:
                        target = p
                        slot = k
                    k += 1
                pc = p.next
            if target == none:
                return try c.fail(arg, try c.named("no parameter or field named ", arg.text, ""))
        else:
            var k: usize = 0
            var pc = params
            while let p = pc:
                if not (skip_self and p.text == "self") and (p.kind == ast.Kind.param or p.kind == ast.Kind.field):
                    if k == position:
                        target = p
                        slot = k
                    k += 1
                pc = p.next
            if target == none:
                return try c.fail(arg, "too many arguments")
            position += 1
        let p = target else return try c.fail(arg, "no parameter")
        if given[slot]:
            return try c.fail(arg, try c.named("the argument ", p.text, " is given twice"))
        given[slot] = true
        let v = arg.left else return try c.fail(arg, "empty argument")
        discard(try expect(c, v, p.type_id if owner == types.none_id else try c.table.substitute(p.type_id, owner)))
        arg.resolved = p
        a = arg.next
    var k: usize = 0
    var pc = params
    while let p = pc:
        if not (skip_self and p.text == "self") and (p.kind == ast.Kind.param or p.kind == ast.Kind.field):
            if not given[k] and p.left == none:
                return try c.fail(e, try c.named("the argument ", p.text, " is missing"))
            if not given[k]:
                if let value = p.left:
                    if value.kind == ast.Kind.native_default and value.text != "default":
                        try native_caller_argument(c, e, p, value)
            k += 1
        pc = p.next

## Caller-sensitive native defaults name the Luce source, not the generated shim.
func native_caller_argument(c: check.Checker*, call: ast.Node*, parameter: ast.Node*, value: ast.Node*) -> !:
    var text = c.modules.get(c.current).path
    if value.text == "caller.function":
        let function = c.current_func else return try c.fail(call, "a caller function default needs an enclosing function")
        text = function.text
    let literal = try ast.Node.make(ast.Kind.literal, try literals.quote_text(text), call.start, call.line)
    literal.type_id = types.str_id
    literal.module = call.module
    let argument = try ast.Node.make(ast.Kind.argument, parameter.text, call.start, call.line)
    argument.left = literal
    argument.resolved = parameter
    var tail = call.body
    while let item = tail:
        if item.next == none:
            break
        tail = item.next
    ast.append(&call.body, &tail, argument)

## The language's own functions (§2.4, §6.5, §12.4).
func core_call(c: check.Checker*, e: ast.Node*, name: str) -> u32!:
    let n = ast.count(e.body)
    if name == "print":
        var cursor = e.body
        while let a = cursor:
            let v = a.left else return try c.fail(a, "empty argument")
            if a.text.length > 0:
                return try c.fail(a, "`print` takes positional arguments")
            let t = try check_expr(c, v, types.none_id)
            if not displayable(c, t):
                return try c.fail(v, try c.with_type("a `", t, "` has no display (§10.5)"))
            cursor = a.next
        return types.unit_id
    if name == "assert":
        if n < 1 or n > 2:
            return try c.fail(e, "`assert(condition)` or `assert(condition, message)`")
        let first = e.body else return try c.fail(e, "no condition")
        let cond = first.left else return try c.fail(e, "no condition")
        discard(try expect(c, cond, types.bool_id))
        if let second = first.next:
            let m = second.left else return try c.fail(second, "empty argument")
            discard(try expect(c, m, types.str_id))
        return types.unit_id
    if name == "trap":
        if n != 1:
            return try c.fail(e, "`trap(message)` takes one text")
        let first = e.body else return try c.fail(e, "no message")
        let m = first.left else return try c.fail(e, "no message")
        discard(try expect(c, m, types.str_id))
        return types.never_id
    if name == "error":
        if not c.fallible:
            return try c.fail(e, "`error` belongs in a function whose result is `!` (§12.2)")
        if n != 2:
            return try c.fail(e, "`error(code, message)` takes a code and a text")
        let first = e.body else return try c.fail(e, "no code")
        let code = first.left else return try c.fail(e, "no code")
        let second = first.next else return try c.fail(e, "no message")
        let message = second.left else return try c.fail(e, "no message")
        discard(try expect(c, code, types.error_code_id))
        discard(try expect(c, message, types.str_id))
        return types.never_id
    if name == "discard":
        if n != 1:
            return try c.fail(e, "`discard(value)` takes one value")
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if c.table.kind(t) == types.Kind.fallible:
            return try c.fail(v, "a result is handled, not discarded (§12.2)")
        return types.unit_id
    if name == "int" or name == "float" or name == "str" or name == "bool":
        if n != 1:
            return try c.fail(e, try c.named("", name, "(value) takes one value"))
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if name == "int":
            if t == types.float_id: return types.int_id
            if t == types.str_id: return try c.table.fallible(types.int_id)
            if t == types.int_id: return try c.fail(e, "this is already an `int`")
            return try c.fail(v, "`int(...)` converts a `float` or parses a `str` (§6.5)")
        if name == "float":
            if t == types.int_id: return types.float_id
            if t == types.str_id: return try c.table.fallible(types.float_id)
            return try c.fail(v, "`float(...)` converts an `int` or parses a `str` (§6.5)")
        if name == "bool":
            if t == types.str_id: return try c.table.fallible(types.bool_id)
            return try c.fail(v, "`bool(...)` parses a `str` (§6.5)")
        if not displayable(c, t):
            return try c.fail(v, try c.with_type("a `", t, "` has no display (§10.5)"))
        return types.str_id
    if name == "hash":
        if n != 1:
            return try c.fail(e, "`hash(value)` takes one value")
        let first = e.body else return try c.fail(e, "no value")
        let v = first.left else return try c.fail(e, "no value")
        let t = try check_expr(c, v, types.none_id)
        if not hashable(c, t):
            if equatable(c, t):
                return try c.fail(v, try c.with_type("a `", t, "` has no hash: its `Equatable` needs `Hashable` beside it (§13.3)"))
            return try c.fail(v, try c.with_type("a `", t, "` has no hash; it has no `==` (§4.4)"))
        return types.int_id
    if name == "Weak":
        let first = e.body else return try c.fail(e, "`Weak(object)` takes a class instance (§10.4)")
        let v = first.left else return try c.fail(e, "no value")
        if n != 1 or first.text.length > 0:
            return try c.fail(e, "`Weak(object)` takes one class instance (§10.4)")
        let t = try check_expr(c, v, types.none_id)
        if c.table.kind(t) != types.Kind.class_:
            return try c.fail(v, try c.with_type("`Weak` holds a class instance, not a `", t, "` (§10.4)"))
        return try c.table.weak_of(t)
    return try c.fail(e, try c.named("unknown name ", name, ""))

## `ErrorCode.package(n)`: a constant of this package, `n` from 1 to 65535, no two alike.
func package_code(c: check.Checker*, e: ast.Node*) -> u32!:
    if not c.at_top_level:
        return try c.fail(e, "`ErrorCode.package(n)` declares a top-level `let` (§12.3)")
    let first = e.body else return try c.fail(e, "`ErrorCode.package(n)` takes a number")
    let v = first.left else return try c.fail(e, "no number")
    if v.kind != ast.Kind.literal or first.next != none:
        return try c.fail(e, "`ErrorCode.package(n)` takes one integer literal")
    let n = literals.decode_integer(v.text) catch failure:
        return try c.fail(v, "an error code is 1 to 65535")
    if n == 0 or n > 65535:
        return try c.fail(v, "an error code is 1 to 65535")
    var i: usize = 0
    while i < c.package_codes.count:
        if c.package_codes.get(i) == n:
            return try c.fail(v, "two constants of one package share this error code (§12.3)")
        i += 1
    try c.package_codes.push(n)
    v.type_id = types.int_id
    return types.error_code_id

# mark: Optionals, results, match expressions =================================================

func else_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let l = e.left else return try c.fail(e, "`else` needs a value on its left")
    let r = e.right else return try c.fail(e, "`else` needs a fallback")
    let lt = try check_expr(c, l, try c.table.optional(hint) if hint != types.none_id and c.table.kind(hint) != types.Kind.optional else types.none_id)
    if c.table.kind(lt) != types.Kind.optional:
        if c.table.kind(lt) == types.Kind.fallible:
            return try c.fail(l, "a result is handled with `try` or `catch`; `else` reads an optional (§12.1)")
        return try c.fail(l, "`else` reads an optional (§12.1)")
    let payload = c.table.get(lt).elem
    if r.kind == ast.Kind.return_:
        discard(try check_return(c, r))
        return payload
    if r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
        if c.loop_depth == 0:
            return try c.fail(r, "`break` and `continue` belong inside a loop")
        return payload
    if r.kind == ast.Kind.call:
        if let callee = r.left:
            if callee.kind == ast.Kind.name and (callee.text == "error" or callee.text == "trap") and c.lookup(callee.text) == none:
                discard(try check_expr(c, r, types.none_id))
                return payload
    discard(try expect(c, r, payload))
    return payload

## `e catch failure:` suite: the suite ends in `recover`, `return`, or `error`.
func catch_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let l = e.left else return try c.fail(e, "`catch` needs an expression")
    let body = e.body else return try c.fail(e, "`catch` needs a suite")
    let lt = try check_expr(c, l, try c.table.fallible(hint) if hint != types.none_id else types.none_id)
    if c.table.kind(lt) != types.Kind.fallible:
        return try c.fail(l, "`catch` handles a result, `T!`")
    var payload = c.table.get(lt).elem
    # `let x: T? = f() catch: recover none`: the expression takes the optional it is
    # expected to be, and the suite recovers with it
    if hint != types.none_id and c.table.kind(hint) == types.Kind.optional and c.table.get(hint).elem == payload:
        payload = hint
    c.push_scope()
    if e.text.length > 0:
        try c.bind(e, e.text, types.error_value_id, e, false)
    let saved_in = c.in_catch
    let saved_result = c.catch_result
    c.in_catch = true
    c.catch_result = payload
    let exits = try check_block(c, body)
    c.in_catch = saved_in
    c.catch_result = saved_result
    c.pop_scope()
    if payload != types.unit_id and not exits:
        return try c.fail(e, "a `catch` suite ends in `recover`, `return`, or `error` (§12.2)")
    return payload

func match_expr_type(c: check.Checker*, e: ast.Node*, hint: u32) -> u32!:
    let subject = e.left else return try c.fail(e, "`match` needs a value")
    let st = try check_expr(c, subject, types.none_id)
    var result = hint
    var covered = try list.List[str].create(8)
    var has_wildcard = false
    var cursor = e.body
    while let arm = cursor:
        c.push_scope()
        var p = arm.left
        while let pattern = p:
            if try check_pattern(c, pattern, st):
                has_wildcard = true
            if let case_node = pattern.left:
                if case_node.kind == ast.Kind.case_value:
                    try covered.push(case_node.text)
                elif case_node.kind == ast.Kind.literal:
                    try covered.push(case_node.text)
            p = pattern.next
        if let guard = arm.right:
            discard(try expect(c, guard, types.bool_id))
            if single_wildcard(arm):
                has_wildcard = false
        let body = arm.body else return try c.fail(arm, "an arm needs a value")
        let bt = try check_expr(c, body, result)
        if result == types.none_id:
            if bt == types.untyped_none_id:
                return try c.fail(body, "`none` needs a type here")
            result = bt
        elif bt != types.never_id:
            result = try unify(c, body, result, body, bt) if bt != result else result
            discard(try coerce(c, body, bt, result))
        c.pop_scope()
        cursor = arm.next
    try check_exhaustive(c, e, st, covered, has_wildcard)
    return result

# mark: Properties of types ====================================================================

## A display for `print`, `str(x)` and f-strings (§10.5).
pub func displayable(c: check.Checker*, id: u32) -> bool:
    return displayable_at(c, id, 0)

## The same, bounded: a type that holds itself through a list, a map or a payload is
## taken as having the property where the walk meets it again.
func displayable_at(c: check.Checker*, id: u32, depth: u32) -> bool:
    if depth > 32:
        return true
    let t_kind = c.table.kind(id)
    if t_kind == types.Kind.struct_ or t_kind == types.Kind.enum_:
        let fresh = c.entering(id) catch failure: recover false
        if not fresh:
            return true
        let answer = displayable_walk(c, id, depth)
        c.leave_walk()
        return answer
    return displayable_walk(c, id, depth)

func displayable_walk(c: check.Checker*, id: u32, depth: u32) -> bool:
    let t = c.table.get(id)
    match t.kind:
        .int_, .float_, .bool_, .str_, .bytes_, .unit_, .error_code, .error_value, .range_: return true
        .optional: return displayable_at(c, t.elem, depth + 1)
        .tuple:
            for m in t.args:
                if not displayable_at(c, m, depth + 1):
                    return false
            return true
        .struct_, .enum_:
            let d = t.decl else return false
            if conforms(c, id, display_interface(c) catch failure: recover types.none_id):
                return true
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.field and not displayable_at(c, m.type_id, depth + 1):
                    return false
                if m.kind == ast.Kind.enum_case:
                    var p = m.body
                    while let field = p:
                        if not displayable_at(c, field.type_id, depth + 1):
                            return false
                        p = field.next
                cursor = m.next
            return true
        .class_, .param:
            return conforms(c, id, display_interface(c) catch failure: recover types.none_id)
        .list_, .set_: return displayable_at(c, t.elem, depth + 1)
        .map_: return displayable_at(c, t.elem, depth + 1) and displayable_at(c, c.table.map_value(id), depth + 1)
        _: return false

## Whether the expression is the literal `none`.
func is_none(e: ast.Node*) -> bool:
    return e.kind == ast.Kind.literal and e.text == "none"

pub func equatable(c: check.Checker*, id: u32) -> bool:
    return equatable_at(c, id, 0)

## The same, bounded: a type that holds itself through a list, a map or a payload is
## taken as having the property where the walk meets it again.
func equatable_at(c: check.Checker*, id: u32, depth: u32) -> bool:
    if depth > 32:
        return true
    let t_kind = c.table.kind(id)
    if t_kind == types.Kind.struct_ or t_kind == types.Kind.enum_:
        let fresh = c.entering(id) catch failure: recover false
        if not fresh:
            return true
        let answer = equatable_walk(c, id, depth)
        c.leave_walk()
        return answer
    return equatable_walk(c, id, depth)

func equatable_walk(c: check.Checker*, id: u32, depth: u32) -> bool:
    let t = c.table.get(id)
    match t.kind:
        .int_, .float_, .bool_, .str_, .bytes_, .unit_, .error_code, .range_: return true
        .optional: return equatable_at(c, t.elem, depth + 1)
        .tuple:
            for m in t.args:
                if not equatable_at(c, m, depth + 1):
                    return false
            return true
        .struct_, .enum_:
            let d = t.decl else return false
            var cursor = d.body
            while let m = cursor:
                if m.kind == ast.Kind.field and not equatable_at(c, m.type_id, depth + 1):
                    return false
                if m.kind == ast.Kind.enum_case:
                    var p = m.body
                    while let field = p:
                        if not equatable_at(c, field.type_id, depth + 1):
                            return false
                        p = field.next
                cursor = m.next
            return true
        .list_, .set_: return equatable_at(c, t.elem, depth + 1)
        .map_: return equatable_at(c, t.elem, depth + 1) and equatable_at(c, c.table.map_value(id), depth + 1)
        .class_, .param: return conforms(c, id, equatable_interface(c) catch failure: recover types.none_id)
        _: return false

## Ordering (§4.4).
pub func orderable(c: check.Checker*, id: u32) -> bool:
    let t = c.table.get(id)
    match t.kind:
        .int_, .float_, .str_, .bytes_: return true
        .tuple:
            for m in t.args:
                if not orderable(c, m):
                    return false
            return true
        .struct_, .class_, .enum_, .param: return conforms(c, id, ordered_interface(c) catch failure: recover types.none_id)
        _: return false

pub func hashable_interface(c: check.Checker*) -> u32!:
    return try closed_interface(c, "Hashable")

## The closed protocols a program may declare (§13.3): looked up by name in the module.
func closed_interface(c: check.Checker*, name: str) -> u32!:
    let d = c.find_declaration(name) else return types.none_id
    if d.kind != ast.Kind.interface_:
        return types.none_id
    return d.type_id

pub func equatable_interface(c: check.Checker*) -> u32!:
    return try closed_interface(c, "Equatable")

pub func display_interface(c: check.Checker*) -> u32!:
    return try closed_interface(c, "Display")

pub func ordered_interface(c: check.Checker*) -> u32!:
    return try closed_interface(c, "Ordered")

## A constant expression (§15.3): literals, arithmetic on them, tuples, cases, and
## constructions of structs from those.
pub func is_constant(e: ast.Node*) -> bool:
    match e.kind:
        .literal, .unit_: return true
        .name:
            let d = e.resolved else return false
            return d.kind == ast.Kind.constant
        .unary, .group:
            let inner = e.left else return false
            return is_constant(inner)
        .binary:
            let l = e.left else return false
            let r = e.right else return false
            return e.text != "in" and is_constant(l) and is_constant(r)
        .tuple, .case_value:
            var cursor = e.body
            while let m = cursor:
                if not is_constant(m):
                    return false
                cursor = m.next
            return true
        .argument:
            let inner = e.left else return false
            return is_constant(inner)
        .member:
            let d = e.resolved else return false
            return d.kind == ast.Kind.enum_case and d.body == none
        .call:
            if let callee = e.left:
                if callee.kind == ast.Kind.member and callee.text == "package":
                    return true
            let d = e.resolved else return false
            if d.kind == ast.Kind.enum_case or d.kind == ast.Kind.struct_:
                var cursor = e.body
                while let a = cursor:
                    if not is_constant(a):
                        return false
                    cursor = a.next
                return true
            return false
        .conditional:
            let cond = e.ty else return false
            let l = e.left else return false
            let r = e.right else return false
            return is_constant(cond) and is_constant(l) and is_constant(r)
        _: return false
