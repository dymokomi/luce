#==============================================================================================
#
#   main - The `luce` command
#
#   DESCRIPTION:
#       The entry point of the Luce compiler. Each command takes a program through the
#       stages that exist: `--version` today, `lex`, `parse`, `check`, `run` and `build` as
#       the slices of docs/PLAN.md land. Every diagnostic is `file:line:column: message` and
#       a rejection exits with 1.
#
#==============================================================================================

import io
import support.version

func usage(out: io.Writer*) -> !:
    try out.write("usage: luce --version\n")

pub func main(arguments: str[]) -> i32!:
    var out = io.stdout()
    if arguments.length < 2:
        try usage(&out)
        return 2
    let command = arguments[1]
    if command == "--version":
        try out.write(f"luce {version.text}\n")
        return 0
    try usage(&out)
    return 2
