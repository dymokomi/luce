#==============================================================================================
#
#   token - Tokens, reserved words, and operator spellings
#
#   DESCRIPTION:
#       The token kinds the lexer produces, the reserved words of luce.md §2.5, the core
#       names of §2.4, and the operator spellings of §6.7 ordered longest first so `**=`
#       wins over `**` and `*`. Tokens are spans into the source; nothing here decodes a
#       literal.
#
#==============================================================================================

pub enum Kind as u8:
    name = 1
    keyword = 2
    integer = 3
    float = 4
    text = 5
    bytes = 6
    raw = 7
    format_start = 8
    format_text = 9
    format_end = 10
    operator = 11
    newline = 12
    indent = 13
    dedent = 14
    doc_comment = 15
    eof = 16

pub struct Token:
    pub var kind: Kind
    pub var start: usize
    pub var end: usize
    pub var line: u32
    pub var column: u32

    pub func label() -> str:
        match self.kind:
            .name: return "name"
            .keyword: return "keyword"
            .integer: return "integer"
            .float: return "float"
            .text: return "text"
            .bytes: return "bytes"
            .raw: return "raw"
            .format_start: return "format_start"
            .format_text: return "format_text"
            .format_end: return "format_end"
            .operator: return "operator"
            .newline: return "newline"
            .indent: return "indent"
            .dedent: return "dedent"
            .doc_comment: return "doc_comment"
            _: return "eof"

# mark: Reserved words ========================================================================

pub let keywords: str[37] = [
    "and", "as", "break", "catch", "class", "continue", "elif", "else", "enum", "false",
    "for", "from", "func", "if", "import", "in", "interface", "is", "let", "match", "none",
    "not", "or", "pub", "recover", "return", "self", "spawn", "struct", "test", "true",
    "try", "type", "var", "wait", "while", "with"]

## The core names of §2.4: the language's own functions and types. No declaration of any
## kind may take one.
pub let core_names: str[20] = [
    "assert", "discard", "error", "hash", "print", "trap", "int", "float", "bool", "str",
    "bytes", "unit", "never", "list", "map", "set", "Error", "ErrorCode", "Weak", "task"]

pub func is_core_name(word: str) -> bool:
    for name in core_names:
        if name == word:
            return true
    return false

pub func is_keyword(word: str) -> bool:
    for k in keywords:
        if k == word:
            return true
    return false

# mark: Operators =============================================================================

## Operators, longest first. The lexer takes the first entry that matches.
pub let operators: str[28] = [
    "**=", "//=", "..<", "..=", "->", "=>", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=",
    "%=", "**", "//", "..", "+", "-", "*", "/", "%", "<", ">", "=", "(", "&"]

## The one-character operators that are not a prefix of any longer one.
pub let singles: str[10] = [")", "[", "]", "{", "}", ",", ":", ".", "?", "!"]

test "keywords and core names are recognised":
    assert(is_keyword("func"))
    assert(is_keyword("with"))
    assert(not is_keyword("defer"))
    assert(is_core_name("list"))
    assert(not is_core_name("i64"))
