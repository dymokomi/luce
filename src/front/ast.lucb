#==============================================================================================
#
#   ast - The untyped syntax tree
#
#   DESCRIPTION:
#       One `Node` shape for every construct of luce.md §19: a kind, a spelling, a span,
#       four child slots, and a sibling link for lists. Nodes come from the current allocator
#       and are never freed individually; a compilation's arena owns them. The checker writes
#       what it learns onto the same nodes, so there is one tree from parsing to emission.
#
#==============================================================================================

import io
import memory

pub enum Kind as u8:
    module = 1
    import_ = 2
    from_import = 3
    func_ = 4
    struct_ = 5
    enum_ = 6
    class_ = 7
    interface_ = 8
    type_alias = 9
    constant = 10
    test_ = 11
    field = 12
    enum_case = 13
    param = 14
    generic_param = 15
    block = 30
    let_ = 31
    var_ = 32
    assign = 33
    if_ = 34
    while_ = 35
    for_ = 36
    match_ = 37
    match_arm = 38
    return_ = 39
    break_ = 40
    continue_ = 41
    recover_ = 42
    with_ = 43
    with_item = 44
    expr_stmt = 45
    name = 60
    self_ = 61
    literal = 62
    unary = 63
    binary = 64
    call = 65
    member = 66
    index = 67
    slice = 68
    tuple = 69
    list_lit = 70
    map_lit = 71
    set_lit = 72
    map_entry = 73
    group = 74
    lambda = 75
    conditional = 76
    else_ = 77
    catch_ = 78
    case_value = 79
    formatted = 80
    format_text = 81
    format_field = 82
    match_expr = 83
    unit_ = 84
    spawn_ = 85
    wait_ = 86
    type_ = 90
    pattern = 91
    ## A conforming value where an interface value is wanted (§13.2): `left` is the value.
    convert = 93
    argument = 92
    ## A default evaluated by Base at the native call site, never as a Luce expression.
    native_default = 94

# mark: Flags =================================================================================

## Flags on a node; which ones apply depends on the kind.
pub let flag_pub: u32 = 1
## A type node: `T?`, `T!`, a tuple type, a function type.
pub let flag_optional: u32 = 2
pub let flag_fallible: u32 = 4
pub let flag_tuple_type: u32 = 8
pub let flag_func_type: u32 = 16
## `if let` and `while let`: the condition binds a payload.
pub let flag_if_let: u32 = 32
## A pattern that matches anything.
pub let flag_wildcard: u32 = 64
## A lambda written as `func (...) -> R:` with a suite rather than `=> expression`.
pub let flag_block_lambda: u32 = 128
## An import that some name resolved through; an import without it is unused (§15.2).
pub let flag_referenced: u32 = 256
## A slice whose lower or upper bound was left out.
pub let flag_no_low: u32 = 512
pub let flag_no_high: u32 = 1024
## A field declared with `var`; a field without this flag is `let`.
pub let flag_var_field: u32 = 2048
## A method changes its value receiver, inferred in Luce or described by Base.
pub let flag_mutating: u32 = 4096
## Set by the checker on a `match` statement every arm of which leaves the function.
pub let flag_all_exit: u32 = 16384
## A call of a collection's or a text's own method, which no declaration resolves.
pub let flag_builtin: u32 = 32768
## A `var` local some closure captures: one cell shared by the scope and the closures (§7.4).
pub let flag_captured: u32 = 65536
## A declaration of the prelude: a closed protocol (§13.3).
pub let flag_prelude: u32 = 131072
## A generic declaration instantiated for one set of type arguments (§13.2): `resolved`
## is the generic declaration, the type parameters carry the arguments.
pub let flag_instance: u32 = 262144
## A declaration whose bodies the checker has been through (§15: modules are checked in
## turn, and instances appear while they are).
pub let flag_checked: u32 = 524288
## A declaration read from a Base module's description (§16): no body, called through
## the boundary; on a class, a handle (§16.4).
pub let flag_base: u32 = 1048576
## A type node standing for a Base `usize`, an `int` in Luce that traps when negative or
## oversized at the crossing (§16.2).
pub let flag_usize: u32 = 2097152
## An imported value keeps its full native representation behind its public fields.
pub let flag_native_value: u32 = 8388608
## The native type can be returned and used, but cannot be constructed publicly.
pub let flag_private_init: u32 = 16777216
## A public native initializer exists, but its signature cannot cross.
pub let flag_unavailable_init: u32 = 33554432
## A native borrowed field is readable; only its package can replace its storage.
pub let flag_native_readonly: u32 = 67108864

## Validated package ownership metadata attached to an imported native class.
pub struct NativeObject:
    pub let descriptor: str
    pub let close: str

# mark: Nodes and lists =======================================================================

pub struct Node:
    pub var kind: Kind
    ## The spelling that matters: a name, a literal, an operator, a label.
    pub var text: str
    pub var start: usize
    pub var end: usize
    pub var line: u32
    pub var flags: u32
    pub var left: Node*?
    pub var right: Node*?
    pub var body: Node*?
    pub var ty: Node*?
    pub var next: Node*?
    ## Written by the checker: the interned type id of this node (0 = none)
    ## and the declaration a name, call, or member resolved to.
    pub var type_id: u32
    pub var resolved: Node*?
    ## The module a top-level declaration belongs to, and the module an import names,
    ## by the checker's index (§15).
    pub var module: u32
    ## The doc comment lines above a declaration or a member, as written (§3.3, §17.4).
    pub var doc: str
    pub var native_object: NativeObject*?

    pub static func make(kind: Kind, text: str, start: usize, line: u32) -> Node*!:
        return try new Node(kind = kind, text = text, start = start, end = start, line = line,
                            flags = 0, left = none, right = none, body = none, ty = none, next = none,
                            type_id = 0, resolved = none, module = 0, doc = "", native_object = none)

    pub func has(flag: u32) -> bool:
        return (self.flags & flag) != 0

## A deep copy of a node and its siblings, as the parser made them: what the checker wrote
## (types, resolutions) is left out, so the copy can be checked afresh.
pub func clone(n: Node*?) -> Node*?!:
    let node = n else return none
    let out = try Node.make(node.kind, node.text, node.start, node.line)
    out.end = node.end
    out.flags = node.flags
    out.module = node.module
    out.doc = node.doc
    out.native_object = node.native_object
    out.left = try clone(node.left)
    out.right = try clone(node.right)
    out.body = try clone(node.body)
    out.ty = try clone(node.ty)
    out.next = try clone(node.next)
    return out

## Append `item` to the sibling list at `list`, keeping `tail` current so a
## long list costs nothing per append.
pub func append(list: Node*?*, tail: Node*?*, item: Node*):
    item.next = none
    if let last = *tail:
        last.next = item
    else:
        *list = item
    *tail = item

pub func count(list: Node*?) -> usize:
    var n: usize = 0
    var cursor = list
    while let node = cursor:
        n += 1
        cursor = node.next
    return n

# mark: Dumping ===============================================================================

## The kind as it prints in a dump.
pub func kind_name(kind: Kind) -> str:
    match kind:
        .module: return "module"
        .import_: return "import"
        .from_import: return "from_import"
        .func_: return "func"
        .struct_: return "struct"
        .enum_: return "enum"
        .class_: return "class"
        .interface_: return "interface"
        .type_alias: return "type_alias"
        .constant: return "constant"
        .test_: return "test"
        .field: return "field"
        .enum_case: return "enum_case"
        .param: return "param"
        .generic_param: return "generic_param"
        .block: return "block"
        .let_: return "let"
        .var_: return "var"
        .assign: return "assign"
        .if_: return "if"
        .while_: return "while"
        .for_: return "for"
        .match_: return "match"
        .match_arm: return "arm"
        .return_: return "return"
        .break_: return "break"
        .continue_: return "continue"
        .recover_: return "recover"
        .with_: return "with"
        .with_item: return "with_item"
        .expr_stmt: return "expr"
        .name: return "name"
        .self_: return "self"
        .literal: return "literal"
        .unary: return "unary"
        .binary: return "binary"
        .call: return "call"
        .member: return "member"
        .index: return "index"
        .slice: return "slice"
        .tuple: return "tuple"
        .list_lit: return "list"
        .map_lit: return "map"
        .set_lit: return "set"
        .map_entry: return "entry"
        .group: return "group"
        .lambda: return "lambda"
        .conditional: return "conditional"
        .else_: return "else"
        .catch_: return "catch"
        .case_value: return "case"
        .formatted: return "formatted"
        .format_text: return "format_text"
        .format_field: return "format_field"
        .match_expr: return "match_expr"
        .unit_: return "unit"
        .spawn_: return "spawn"
        .wait_: return "wait"
        .type_: return "type"
        .pattern: return "pattern"
        _: return "argument"

## The tree from `node` on, one node per line, children indented.
pub func dump(out: io.Writer, node: Node*?, depth: u32) -> !:
    var cursor = node
    while let n = cursor:
        var i: u32 = 0
        while i < depth:
            try out.write("  ")
            i += 1
        try out.write("(")
        try out.write(kind_name(n.kind))
        if n.text.length > 0:
            try out.write(f" {n.text}")
        if n.flags != 0:
            try out.write(f" #{n.flags}")
        try out.write(f" @{n.start}")
        let children = n.left != none or n.right != none or n.body != none or n.ty != none
        if children:
            try out.write("\n")
            try dump(out, n.ty, depth + 1)
            try dump(out, n.left, depth + 1)
            try dump(out, n.right, depth + 1)
            try dump(out, n.body, depth + 1)
            i = 0
            while i < depth:
                try out.write("  ")
                i += 1
        try out.write(")\n")
        cursor = n.next

## The offset a statement begins at, for the position a trap names (§12.4): its first
## token's, which is the least offset in its tree, a node's own sitting at the token that
## made it (an operator, a bracket).
pub func statement_start(s: Node*) -> usize:
    return first_offset(s, s.start)

func first_offset(n: Node*?, least: usize) -> usize:
    let node = n else return least
    var best = least
    if node.start < best:
        best = node.start
    best = first_offset(node.left, best)
    best = first_offset(node.right, best)
    best = first_offset(node.body, best)
    best = first_offset(node.ty, best)
    if node.kind != Kind.block and node.kind != Kind.match_arm:
        best = first_offset(node.next, best)
    return best

test "append keeps order and count":
    var backing: u8[1024]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var list: Node*? = none
        var tail: Node*? = none
        let a = try Node.make(Kind.name, "a", 0, 1)
        append(&list, &tail, a)
        let b = try Node.make(Kind.name, "b", 1, 1)
        append(&list, &tail, b)
        assert(count(list) == 2)
        assert(a.next != none)
        assert(b.next == none)
