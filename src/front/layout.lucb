## `luce fmt` (§17.6): a module written back in the canonical layout from its tree. Four
## spaces per block, one statement per line, one space around a binary operator and after a
## comma, no space inside brackets, a blank line between declarations, one blank line at
## most between statements where the source had one, comments kept: one standing on its own
## line stays on its own line before what follows it, one after code stays after that
## line. The layout is what the parser reads back into the same tree, and formatting the
## result again changes nothing.
import front.ast
import front.source
import front.token
import support.buffer

pub struct Formatter:
    var src: source.Source
    var tokens: const token.Token[]
    var out: buffer.Buffer
    var indent: u32
    ## Comments as ranges of the source, in order, and how many were written.
    var comments: usize[]
    var comment_count: usize
    var written: usize
    ## The line the last statement or declaration started on, for blank lines.
    var last_line: u32
    var at_line_start: bool

    pub static func over(src: source.Source, tokens: const token.Token[]) -> Formatter!:
        var f = Formatter(src = src, tokens = tokens, out = try buffer.Buffer.create(4096), indent = 0,
                          comments = try alloc usize[2], comment_count = 0, written = 0, last_line = 0, at_line_start = true)
        try f.find_comments()
        return f

    pub func text() -> str:
        return self.out.view()

    ## Every `#` outside a token is a comment to the end of its line: `[start, end)` pairs.
    mutating func find_comments() -> !:
        var count: usize = 0
        var room = try alloc usize[64]
        var i: usize = 0
        var t: usize = 0
        let bytes = self.src.bytes
        while i < bytes.length:
            while t < self.tokens.length and self.tokens[t].end <= i:
                t += 1
            if t < self.tokens.length and self.tokens[t].start <= i and i < self.tokens[t].end and self.tokens[t].end > self.tokens[t].start:
                i = self.tokens[t].end
                continue
            if bytes[i] == '#':
                let start = i
                while i < bytes.length and bytes[i] != '\n':
                    i += 1
                if count + 2 > room.length:
                    let grown = try alloc usize[room.length * 2]
                    var k: usize = 0
                    while k < count:
                        grown[k] = room[k]
                        k += 1
                    room = grown
                room[count] = start
                room[count + 1] = i
                count += 2
                continue
            i += 1
        self.comments = room
        self.comment_count = count // 2

    # -- output ---------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        if self.at_line_start:
            var i: u32 = 0
            while i < self.indent:
                try self.out.put("    ")
                i += 1
            self.at_line_start = false
        try self.out.put(text)

    mutating func newline() -> !:
        try self.out.put("\n")
        self.at_line_start = true

    mutating func blank() -> !:
        if not self.at_line_start:
            try self.newline()
        try self.out.put("\n")

    ## Comments standing before `offset` on lines of their own, each on its own line.
    mutating func comments_before(offset: usize) -> !:
        while self.written < self.comment_count:
            let start = self.comments[self.written * 2]
            let end = self.comments[self.written * 2 + 1]
            if start >= offset:
                return
            self.written += 1
            if not self.at_line_start:
                try self.newline()
            try self.put(self.src.text(start, end))
            try self.newline()

    ## A comment on the same line after code: written after the line, two spaces before.
    mutating func trailing_comment(line: u32) -> !:
        if self.written < self.comment_count:
            let start = self.comments[self.written * 2]
            let end = self.comments[self.written * 2 + 1]
            let (l, c) = self.src.position(start)
            if l == line and not self.first_on_line(start):
                self.written += 1
                try self.out.put("  ")
                try self.out.put(self.src.text(start, end))
                discard(c)

    func first_on_line(offset: usize) -> bool:
        var i = offset
        while i > 0:
            i -= 1
            let b = self.src.bytes[i]
            if b == '\n':
                return true
            if b != ' ':
                return false
        return true

    ## Whether a comment lies between two offsets.
    func comment_between(a: usize, b: usize) -> bool:
        var i = self.written
        while i < self.comment_count:
            let start = self.comments[i * 2]
            if start >= b:
                return false
            if start >= a:
                return true
            i += 1
        return false

    # -- the module -----------------------------------------------------------------------

    pub mutating func module(m: ast.Node*) -> !:
        var cursor = m.body
        var previous_import = false
        var first = true
        while let d = cursor:
            let is_import = d.kind == ast.Kind.import_ or d.kind == ast.Kind.from_import
            try self.comments_before(d.start)
            if not first:
                if not (is_import and previous_import):
                    try self.blank()
            first = false
            previous_import = is_import
            try self.declaration(d)
            cursor = d.next
        try self.comments_before(self.src.bytes.length + 1)

    mutating func declaration(d: ast.Node*) -> !:
        if d.doc.length > 0:
            try self.doc(d.doc)
        match d.kind:
            .import_:
                try self.put("import ")
                try self.put(d.text)
                if let alias = d.left:
                    try self.put(" as ")
                    try self.put(alias.text)
                try self.end_line(d)
            .from_import:
                try self.put("from ")
                try self.put(d.text)
                try self.put(" import ")
                try self.names(d.body)
                try self.end_line(d)
            .func_: try self.function(d)
            .struct_, .class_:
                try self.pub_mark(d)
                try self.put("struct " if d.kind == ast.Kind.struct_ else "class ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.conformances(d.right)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .enum_:
                try self.pub_mark(d)
                try self.put("enum ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.conformances(d.right)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .interface_:
                try self.pub_mark(d)
                try self.put("interface ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .type_alias:
                try self.pub_mark(d)
                try self.put("type ")
                try self.put(d.text)
                try self.put(" = ")
                try self.type_node(d.ty else return)
                try self.end_line(d)
            .constant:
                try self.pub_mark(d)
                try self.put("let ")
                try self.put(d.text)
                if let t = d.ty:
                    try self.put(": ")
                    try self.type_node(t)
                try self.put(" = ")
                try self.expr(d.left else return)
                try self.end_line(d)
            .test_:
                try self.put("test ")
                try self.put(d.text)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.block(d.body else return)
            _: discard(0)

    mutating func doc(text: str) -> !:
        var start: usize = 0
        var i: usize = 0
        while i <= text.length:
            if i == text.length or text.bytes[i] == '\n':
                var line = (str)text.bytes[start..<i]
                var skip: usize = 0
                while skip < line.length and line.bytes[skip] == ' ':
                    skip += 1
                line = (str)line.bytes[skip..]
                if line.length > 0:
                    try self.put(line)
                    try self.newline()
                start = i + 1
            i += 1

    mutating func pub_mark(d: ast.Node*) -> !:
        if d.has(ast.flag_pub):
            try self.put("pub ")

    ## `[T, U: A & B]`
    mutating func generics(g: ast.Node*?) -> !:
        let list = g else return
        try self.put("[")
        var cursor = list.body
        var first = true
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(p.text)
            var b = p.body
            var first_bound = true
            while let bound = b:
                try self.put(": " if first_bound else " & ")
                first_bound = false
                try self.type_node(bound)
                b = bound.next
            cursor = p.next
        try self.put("]")

    mutating func conformances(c: ast.Node*?) -> !:
        var cursor = c
        var first = true
        while let t = cursor:
            try self.put(": " if first else ", ")
            first = false
            try self.type_node(t)
            cursor = t.next

    mutating func names(n: ast.Node*?) -> !:
        var cursor = n
        var first = true
        while let name = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(name.text)
            cursor = name.next

    ## A type's members: fields, then cases, then methods, each method after a blank line.
    mutating func members(m: ast.Node*?) -> !:
        self.indent += 1
        var cursor = m
        var previous_kind = ast.Kind.field
        var first = true
        if m == none:
            try self.put("discard(0)")
            try self.newline()
        while let member = cursor:
            try self.comments_before(member.start)
            if not first and (member.kind == ast.Kind.func_ or previous_kind == ast.Kind.func_):
                try self.blank()
            first = false
            previous_kind = member.kind
            if member.doc.length > 0:
                try self.doc(member.doc)
            match member.kind:
                .field:
                    try self.pub_mark(member)
                    try self.put("var " if member.has(ast.flag_var_field) else "let ")
                    try self.put(member.text)
                    try self.put(": ")
                    try self.type_node(member.ty else return)
                    if let default = member.left:
                        try self.put(" = ")
                        try self.expr(default)
                    try self.end_line(member)
                .enum_case:
                    try self.put(member.text)
                    if member.body != none:
                        try self.put("(")
                        try self.params(member.body)
                        try self.put(")")
                    try self.end_line(member)
                .func_: try self.function(member)
                _: discard(0)
            cursor = member.next
        self.indent -= 1

    mutating func function(f: ast.Node*) -> !:
        try self.pub_mark(f)
        try self.put("func ")
        try self.put(f.text)
        try self.generics(f.ty)
        try self.put("(")
        try self.params(f.right)
        try self.put(")")
        if let r = f.left:
            try self.put(" -> ")
            try self.type_node(r)
        if let body = f.body:
            try self.put(":")
            try self.trailing_comment(f.line)
            try self.newline()
            try self.block(body)
        else:
            try self.end_line(f)

    mutating func params(p: ast.Node*?) -> !:
        var cursor = p
        var first = true
        while let param = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(param.text)
            if let t = param.ty:
                try self.put(": ")
                try self.type_node(t)
            if let default = param.left:
                try self.put(" = ")
                try self.expr(default)
            cursor = param.next

    # -- statements -----------------------------------------------------------------------

    mutating func block(b: ast.Node*) -> !:
        self.indent += 1
        var cursor = b.body
        var previous: ast.Node*? = none
        while let s = cursor:
            try self.comments_before(s.start)
            if let p = previous:
                let (pl, pc) = self.src.position(p.start)
                let (sl, sc) = self.src.position(s.start)
                discard(pc)
                discard(sc)
                if sl > pl + 1 and self.blank_line_between(p, s):
                    try self.blank()
            previous = s
            try self.statement(s)
            cursor = s.next
        self.indent -= 1

    ## Whether the source holds an empty line between the end of `a` and the start of `b`.
    func blank_line_between(a: ast.Node*, b: ast.Node*) -> bool:
        var i = b.start
        var newlines: u32 = 0
        var only_spaces = true
        while i > a.start:
            i -= 1
            let c = self.src.bytes[i]
            if c == '\n':
                if only_spaces and newlines > 0:
                    return true
                newlines += 1
                only_spaces = true
            elif c != ' ':
                only_spaces = false
                if c == '#':
                    only_spaces = true
        return false

    mutating func end_line(n: ast.Node*) -> !:
        try self.trailing_comment(self.last_line_of(n))
        try self.newline()

    ## The line a statement's last token lies on, for the trailing comment.
    func last_line_of(n: ast.Node*) -> u32:
        let (l, c) = self.src.position(n.start)
        discard(c)
        return l

    mutating func statement(s: ast.Node*) -> !:
        match s.kind:
            .let_, .var_:
                try self.put("let " if s.kind == ast.Kind.let_ else "var ")
                try self.binding_target(s)
                if let t = s.ty:
                    try self.put(": ")
                    try self.type_node(t)
                try self.put(" = ")
                let value = s.left else return
                try self.expr_or_catch(value, s)
            .assign:
                try self.expr(s.left else return)
                try self.put(" ")
                try self.put(s.text)
                try self.put(" ")
                try self.expr(s.right else return)
                try self.end_line(s)
            .expr_stmt:
                let inner = s.left else return
                try self.expr_or_catch(inner, s)
            .return_:
                try self.put("return")
                if let v = s.left:
                    try self.put(" ")
                    try self.expr(v)
                try self.end_line(s)
            .break_, .continue_:
                try self.put("break" if s.kind == ast.Kind.break_ else "continue")
                if s.text.length > 0:
                    try self.put(" ")
                    try self.put(s.text)
                try self.end_line(s)
            .recover_:
                try self.put("recover ")
                try self.expr(s.left else return)
                try self.end_line(s)
            .if_: try self.if_statement(s, "if ")
            .while_:
                if s.text.length > 0:
                    try self.put(s.text)
                    try self.put(": ")
                try self.put("while ")
                try self.condition(s)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            .for_:
                if s.text.length > 0:
                    try self.put(s.text)
                    try self.put(": ")
                try self.put("for ")
                try self.binding_target(s.left else return)
                try self.put(" in ")
                try self.expr(s.right else return)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            .match_:
                try self.put("match ")
                try self.expr(s.left else return)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.arms(s.body, false)
            .with_:
                try self.put("with ")
                var cursor = s.left
                var first = true
                while let item = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.expr(item.left else return)
                    try self.put(" as ")
                    try self.put(item.text)
                    cursor = item.next
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            _:
                try self.expr(s)
                try self.end_line(s)

    ## `x` or `(a, b)` of a binding or a `for`.
    mutating func binding_target(b: ast.Node*) -> !:
        if b.body != none:
            try self.put("(")
            try self.names(b.body)
            try self.put(")")
        else:
            try self.put(b.text)

    ## A statement's expression, which may end in a `catch` suite.
    mutating func expr_or_catch(e: ast.Node*, s: ast.Node*) -> !:
        if e.kind == ast.Kind.catch_:
            try self.expr(e.left else return)
            try self.put(" catch")
            if e.text.length > 0:
                try self.put(" ")
                try self.put(e.text)
            try self.put(":")
            try self.trailing_comment(s.line)
            try self.newline()
            try self.block(e.body else return)
            return
        try self.expr(e)
        try self.end_line(s)

    mutating func condition(s: ast.Node*) -> !:
        let c = s.left else return
        if s.has(ast.flag_if_let):
            try self.put("let ")
            try self.put(c.text)
            try self.put(" = ")
            try self.expr(c.left else return)
        else:
            try self.expr(c)

    mutating func if_statement(s: ast.Node*, word: str) -> !:
        try self.put(word)
        try self.condition(s)
        try self.put(":")
        try self.trailing_comment(s.line)
        try self.newline()
        try self.block(s.body else return)
        if let rest = s.right:
            try self.comments_before(rest.start)
            if rest.kind == ast.Kind.if_:
                try self.if_statement(rest, "elif ")
            else:
                try self.put("else:")
                try self.trailing_comment(self.last_line_of(rest))
                try self.newline()
                try self.block(rest)

    mutating func arms(a: ast.Node*?, expression: bool) -> !:
        self.indent += 1
        var cursor = a
        while let arm = cursor:
            try self.comments_before(arm.start)
            var p = arm.left
            var first = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern)
                p = pattern.next
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            if expression:
                try self.put(" => ")
                try self.expr(arm.body else return)
                try self.end_line(arm)
            else:
                try self.put(":")
                try self.trailing_comment(arm.line)
                try self.newline()
                try self.block(arm.body else return)
            cursor = arm.next
        self.indent -= 1

    mutating func pattern(p: ast.Node*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "tuple":
            try self.put("(")
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(sub)
                cursor = sub.next
            try self.put(")")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            if let owner = v.left:
                try self.put(owner.text)
            try self.put(".")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                try self.names(v.body)
                try self.put(")")
            return
        try self.expr(v)
        if let high = p.right:
            try self.put(p.text)
            try self.expr(high)

    # -- expressions ----------------------------------------------------------------------

    mutating func expr(e: ast.Node*) -> !:
        match e.kind:
            .literal: try self.put(e.text)
            .name:
                try self.put(e.text)
                if let args = e.ty:
                    try self.type_args(args)
            .self_: try self.put("self")
            .unit_: try self.put("()")
            .unary:
                try self.put(e.text)
                if e.text == "-":
                    try self.expr(e.left else return)
                else:
                    try self.put(" ")
                    try self.expr(e.left else return)
            .binary:
                try self.expr(e.left else return)
                try self.put(" ")
                try self.put(e.text)
                try self.put(" ")
                try self.expr(e.right else return)
            .group:
                try self.put("(")
                try self.expr(e.left else return)
                try self.put(")")
            .member:
                try self.expr(e.left else return)
                try self.put(".")
                try self.put(e.text)
                if let args = e.ty:
                    try self.type_args(args)
            .call:
                try self.expr(e.left else return)
                if let args = e.ty:
                    try self.type_args(args)
                try self.put("(")
                try self.arguments(e.body)
                try self.put(")")
            .case_value:
                try self.put(".")
                try self.put(e.text)
                if e.body != none:
                    try self.put("(")
                    try self.arguments(e.body)
                    try self.put(")")
            .index:
                try self.expr(e.left else return)
                try self.put("[")
                try self.expr(e.body else return)
                try self.put("]")
            .slice:
                try self.expr(e.left else return)
                try self.put("[")
                if not e.has(ast.flag_no_low):
                    try self.expr(e.body else return)
                if e.has(ast.flag_no_high):
                    try self.put("..")
                else:
                    try self.put("..<")
                    try self.expr(e.right else return)
                try self.put("]")
            .tuple:
                try self.put("(")
                try self.list(e.body)
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .list_lit:
                try self.put("[")
                try self.list(e.body)
                try self.put("]")
            .set_lit:
                try self.put("{")
                try self.list(e.body)
                try self.put("}")
            .map_lit:
                try self.put("{")
                var cursor = e.body
                var first = true
                while let entry = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.expr(entry.left else return)
                    try self.put(": ")
                    try self.expr(entry.right else return)
                    cursor = entry.next
                try self.put("}")
            .lambda:
                if e.has(ast.flag_block_lambda):
                    try self.put("func (")
                    try self.params(e.right)
                    try self.put(")")
                    if let r = e.ty:
                        try self.put(" -> ")
                        try self.type_node(r)
                    try self.put(":")
                    try self.newline()
                    try self.block(e.body else return)
                    # the suite ended the line; what follows the lambda continues after it
                    self.at_line_start = false
                    self.out.used -= 1
                else:
                    try self.put("(")
                    try self.params(e.right)
                    try self.put(") => ")
                    try self.expr(e.body else return)
            .conditional:
                try self.expr(e.left else return)
                try self.put(" if ")
                try self.expr(e.ty else return)
                try self.put(" else ")
                try self.expr(e.right else return)
            .else_:
                try self.expr(e.left else return)
                try self.put(" else ")
                let fallback = e.right else return
                match fallback.kind:
                    .return_:
                        try self.put("return")
                        if let v = fallback.left:
                            try self.put(" ")
                            try self.expr(v)
                    .break_, .continue_:
                        try self.put("break" if fallback.kind == ast.Kind.break_ else "continue")
                        if fallback.text.length > 0:
                            try self.put(" ")
                            try self.put(fallback.text)
                    _: try self.expr(fallback)
            .catch_:
                # a `catch` outside a statement's end: spelled with its suite in place
                try self.expr(e.left else return)
                try self.put(" catch")
                if e.text.length > 0:
                    try self.put(" ")
                    try self.put(e.text)
                try self.put(":")
                try self.newline()
                try self.block(e.body else return)
                self.at_line_start = false
                self.out.used -= 1
            .formatted:
                try self.put(e.text)
                var cursor = e.body
                while let part = cursor:
                    if part.kind == ast.Kind.format_text:
                        try self.put(part.text)
                    else:
                        try self.put("{")
                        try self.expr(part.left else return)
                        try self.put("}")
                    cursor = part.next
                try self.put((str)e.text.bytes[1..])
            .match_expr:
                try self.put("match ")
                try self.expr(e.left else return)
                try self.put(":")
                try self.newline()
                try self.arms(e.body, true)
                self.at_line_start = false
                self.out.used -= 1
            .spawn_:
                try self.put("spawn ")
                try self.expr(e.left else return)
            .wait_:
                try self.put("wait ")
                try self.expr(e.left else return)
            .convert: try self.expr(e.left else return)
            _: try self.put(e.text)

    mutating func list(items: ast.Node*?) -> !:
        var cursor = items
        var first = true
        while let item = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.expr(item)
            cursor = item.next

    mutating func arguments(a: ast.Node*?) -> !:
        var cursor = a
        var first = true
        while let arg = cursor:
            if not first:
                try self.put(", ")
            first = false
            if arg.text.length > 0:
                try self.put(arg.text)
                try self.put(" = ")
            try self.expr(arg.left else return)
            cursor = arg.next

    mutating func type_args(args: ast.Node*) -> !:
        try self.put("[")
        var cursor = args.body
        var first = true
        while let t = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.type_node(t)
            cursor = t.next
        try self.put("]")

    mutating func type_node(t: ast.Node*) -> !:
        if t.has(ast.flag_optional):
            try self.type_node(t.left else return)
            try self.put("?")
            return
        if t.has(ast.flag_fallible):
            try self.type_node(t.left else return)
            try self.put("!")
            return
        if t.has(ast.flag_tuple_type):
            try self.put("(")
            var cursor = t.body
            var first = true
            while let m = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.type_node(m)
                cursor = m.next
            try self.put(")")
            return
        if t.has(ast.flag_func_type):
            try self.put("func(")
            var cursor = t.body
            var first = true
            while let m = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.type_node(m)
                cursor = m.next
            try self.put(")")
            if let r = t.right:
                try self.put(" -> ")
                try self.type_node(r)
            return
        try self.put(t.text)
        if t.body != none:
            try self.type_args(t)
