#==============================================================================================
#
#   layout - The canonical layout
#
#   DESCRIPTION:
#       `luce fmt` (§17.6): a module written back in the canonical layout from its tree. Four
#       spaces per block, one statement per line, one space around a binary operator and after a
#       comma, no space inside brackets, a blank line between declarations, one blank line at
#       most between statements where the source had one, comments kept: one standing on its own
#       line stays on its own line right above what follows it, a blank line the source had
#       above it staying above it; one after a block's last statement, as deep as it, stays in
#       the block; one after code stays after that line. The layout is what the parser reads
#       back into the same tree, and formatting the result again changes nothing.
#
#==============================================================================================
import front.ast
import front.source
import front.token
import support.buffer

# mark: The formatter =========================================================================

## Writes one module's tree back as text in the canonical layout, with the
## source's comments where they stood.
pub struct Formatter:
    var src: source.Source
    var tokens: const token.Token[]
    var out: buffer.Buffer
    var indent: u32
    ## Comments as ranges of the source, in order, and how many were written.
    var comments: usize[]
    var comment_count: usize
    var written: usize
    ## The line the last statement or declaration started on, for blank lines.
    var last_line: u32
    var at_line_start: bool

    ## A formatter for `src`, whose comments are found from `tokens` up front.
    pub static func over(src: source.Source, tokens: const token.Token[]) -> Formatter!:
        var f = Formatter(src = src, tokens = tokens, out = try buffer.Buffer.create(4096), indent = 0,
                          comments = try new usize[2] ---, comment_count = 0, written = 0, last_line = 0, at_line_start = true)
        try f.find_comments()
        return f

    ## The formatted text so far.
    pub func text() -> str:
        return self.out.view()

    ## Every `#` outside a token is a comment to the end of its line: `[start, end)` pairs.
    func find_comments() -> !:
        var count: usize = 0
        var room = try new usize[64] ---
        var i: usize = 0
        var t: usize = 0
        let bytes = self.src.bytes
        while i < bytes.length:
            while t < self.tokens.length and self.tokens[t].end <= i:
                t += 1
            if t < self.tokens.length and self.tokens[t].start <= i and i < self.tokens[t].end and self.tokens[t].end > self.tokens[t].start:
                i = self.tokens[t].end
                continue
            if bytes[i] == '#':
                let start = i
                while i < bytes.length and bytes[i] != '\n':
                    i += 1
                if count + 2 > room.length:
                    let grown = try new usize[room.length * 2] ---
                    var k: usize = 0
                    while k < count:
                        grown[k] = room[k]
                        k += 1
                    room = grown
                room[count] = start
                room[count + 1] = i
                count += 2
                continue
            i += 1
        self.comments = room
        self.comment_count = count // 2

    # mark: Output ============================================================================

    func put(text: str) -> !:
        if self.at_line_start:
            var i: u32 = 0
            while i < self.indent:
                try self.out.put("    ")
                i += 1
            self.at_line_start = false
        try self.out.put(text)

    func newline() -> !:
        try self.out.put("\n")
        self.at_line_start = true

    ## An empty line, unless the output already ends with one.
    func blank() -> !:
        if not self.at_line_start:
            try self.newline()
        if not self.ends_blank():
            try self.out.put("\n")

    ## Whether the output already ends with an empty line.
    func ends_blank() -> bool:
        let text = self.out.view()
        return text.length >= 2 and text.bytes[text.length - 1] == '\n' and text.bytes[text.length - 2] == '\n'

    ## Comments standing before `offset` on lines of their own, each on its own line, with
    ## an empty line before one where the source had it; whether there were any.
    func comments_before(offset: usize) -> bool!:
        var wrote = false
        while self.written < self.comment_count:
            let start = self.comments[self.written * 2]
            let end = self.comments[self.written * 2 + 1]
            if start >= offset:
                return wrote
            self.written += 1
            wrote = true
            if not self.at_line_start:
                try self.newline()
            elif self.out.used > 0 and self.blank_before(start) and not self.ends_blank():
                try self.blank()
            try self.put(self.src.text(start, end))
            try self.newline()
        return wrote

    ## Where the next thing after the previous item begins: its comment, or the item.
    func next_break(item_start: usize) -> usize:
        if self.written < self.comment_count and self.comments[self.written * 2] < item_start:
            return self.comments[self.written * 2]
        return item_start

    ## Between two items: a blank line the source had, kept as one, or a forced one, before
    ## the comments standing before the item, so a comment stays with what it describes;
    ## then those comments; then a blank line the source kept between the last of them and
    ## the item.
    func separate(previous: ast.Node*?, item: ast.Node*, forced: bool) -> !:
        let at = statement_start(item)
        if previous != none and (forced or self.blank_before(self.next_break(at))):
            try self.blank()
        let wrote = try self.comments_before(at)
        if wrote and self.blank_before(at):
            try self.blank()

    ## Whether the line before the one holding `offset` is empty in the source (`offset`
    ## is the first thing on its line).
    func blank_before(offset: usize) -> bool:
        var i = offset
        var newlines: u32 = 0
        while i > 0:
            i -= 1
            let b = self.src.bytes[i]
            if b == '\n':
                newlines += 1
                if newlines >= 2:
                    return true
            elif b != ' ' and b != '\r':
                return false
        return false

    ## A comment on the same line after code: written after the line, two spaces before.
    func trailing_comment(line: u32) -> !:
        if self.written < self.comment_count:
            let start = self.comments[self.written * 2]
            let end = self.comments[self.written * 2 + 1]
            let (l, c) = self.src.position(start)
            if l == line and not self.first_on_line(start):
                self.written += 1
                try self.out.put("  ")
                try self.out.put(self.src.text(start, end))
                _ = c

    func first_on_line(offset: usize) -> bool:
        var i = offset
        while i > 0:
            i -= 1
            let b = self.src.bytes[i]
            if b == '\n':
                return true
            if b != ' ':
                return false
        return true

    # mark: The module ========================================================================

    ## Writes the whole module, its doc comment first, each item after the comments before
    ## it: imports together, every other item after a blank line, and the comments at the
    ## end last.
    pub func module(m: ast.Node*) -> !:
        var cursor = m.body
        var previous_import = false
        var previous: ast.Node*? = none
        var after_doc = false
        if m.doc.length > 0:
            _ = try self.comments_before(self.first_doc())
            try self.doc(m.doc)
            after_doc = true
        while let d = cursor:
            let is_import = d.kind == ast.Kind.import_ or d.kind == ast.Kind.from_import
            if previous == none and after_doc:
                # the module's doc comment, then a blank line, then the first item's comments
                try self.blank()
            try self.separate(previous, d, previous != none and not (is_import and previous_import))
            previous = d
            previous_import = is_import
            try self.declaration(d)
            cursor = d.next
        if self.written < self.comment_count and self.blank_before(self.comments[self.written * 2]):
            try self.blank()
        _ = try self.comments_before(self.src.bytes.length + 1)

    ## Where the first doc comment starts: the module's, when the module has one.
    func first_doc() -> usize:
        for t in self.tokens:
            if t.kind == token.Kind.doc_comment:
                return t.start
        return self.src.bytes.length

    func declaration(d: ast.Node*) -> !:
        if d.doc.length > 0:
            try self.doc(d.doc)
        match d.kind:
            .import_:
                try self.put("import ")
                try self.put(d.text)
                if let alias = d.left:
                    try self.put(" as ")
                    try self.put(alias.text)
                try self.end_line(d)
            .from_import:
                try self.put("from ")
                try self.put(d.text)
                try self.put(" import ")
                try self.imported_names(d.body)
                try self.end_line(d)
            .func_: try self.function(d)
            .struct_, .class_:
                try self.pub_mark(d)
                try self.put("struct " if d.kind == ast.Kind.struct_ else "class ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.conformances(d.right)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .enum_:
                try self.pub_mark(d)
                try self.put("enum ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.conformances(d.right)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .interface_:
                try self.pub_mark(d)
                try self.put("interface ")
                try self.put(d.text)
                try self.generics(d.ty)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.members(d.body)
            .type_alias:
                try self.pub_mark(d)
                try self.put("type ")
                try self.put(d.text)
                try self.put(" = ")
                try self.type_node(d.ty else return)
                try self.end_line(d)
            .constant:
                try self.pub_mark(d)
                try self.put("let ")
                try self.put(d.text)
                if let t = d.ty:
                    try self.put(": ")
                    try self.type_node(t)
                try self.put(" = ")
                try self.expr(d.left else return)
                try self.end_line(d)
            .test_:
                try self.put("test ")
                try self.put(d.text)
                try self.put(":")
                try self.trailing_comment(d.line)
                try self.newline()
                try self.block(d.body else return)
            _: _ = 0

    func doc(text: str) -> !:
        var start: usize = 0
        var i: usize = 0
        while i <= text.length:
            if i == text.length or text.bytes[i] == '\n':
                var line = (str)text.bytes[start..<i]
                if line.length > 0 and line.bytes[line.length - 1] == '\r':
                    line = (str)line.bytes[..<line.length - 1]
                var skip: usize = 0
                while skip < line.length and line.bytes[skip] == ' ':
                    skip += 1
                line = (str)line.bytes[skip..]
                if line.length > 0:
                    try self.put(line)
                    try self.newline()
                start = i + 1
            i += 1

    func pub_mark(d: ast.Node*) -> !:
        if d.has(ast.flag_pub):
            try self.put("pub ")

    ## `[T, U: A & B]`
    func generics(g: ast.Node*?) -> !:
        let list = g else return
        try self.put("[")
        var cursor = list.body
        var first = true
        while let p = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(p.text)
            var b = p.body
            var first_bound = true
            while let bound = b:
                try self.put(": " if first_bound else " & ")
                first_bound = false
                try self.type_node(bound)
                b = bound.next
            cursor = p.next
        try self.put("]")

    func conformances(c: ast.Node*?) -> !:
        var cursor = c
        var first = true
        while let t = cursor:
            try self.put(": " if first else ", ")
            first = false
            try self.type_node(t)
            cursor = t.next

    func names(n: ast.Node*?) -> !:
        var cursor = n
        var first = true
        while let name = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(name.text)
            cursor = name.next

    ## The names a `from` import brings, each with its `as` alias.
    func imported_names(n: ast.Node*?) -> !:
        var cursor = n
        var first = true
        while let name = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(name.text)
            if let alias = name.left:
                try self.put(" as ")
                try self.put(alias.text)
            cursor = name.next

    ## A type's members: fields, then cases, then methods, each method after a blank line.
    func members(m: ast.Node*?) -> !:
        self.indent += 1
        var cursor = m
        var previous: ast.Node*? = none
        if m == none:
            try self.put("discard(0)")
            try self.newline()
        while let member = cursor:
            var forced = false
            if let p = previous:
                forced = member.kind == ast.Kind.func_ or p.kind == ast.Kind.func_
            try self.separate(previous, member, forced)
            previous = member
            if member.doc.length > 0:
                try self.doc(member.doc)
            match member.kind:
                .field:
                    try self.pub_mark(member)
                    try self.put("var " if member.has(ast.flag_var_field) else "let ")
                    try self.put(member.text)
                    try self.put(": ")
                    try self.type_node(member.ty else return)
                    if let default = member.left:
                        try self.put(" = ")
                        try self.expr(default)
                    try self.end_line(member)
                .enum_case:
                    try self.put(member.text)
                    if member.body != none:
                        try self.put("(")
                        try self.params(member.body)
                        try self.put(")")
                    try self.end_line(member)
                .func_: try self.function(member)
                _: _ = 0
            cursor = member.next
        self.indent -= 1

    func function(f: ast.Node*) -> !:
        try self.pub_mark(f)
        try self.put("func ")
        try self.put(f.text)
        try self.generics(f.ty)
        try self.put("(")
        try self.params(f.right)
        try self.put(")")
        if let r = f.left:
            try self.put(" -> ")
            try self.type_node(r)
        if let body = f.body:
            try self.put(":")
            try self.trailing_comment(f.line)
            try self.newline()
            try self.block(body)
        else:
            try self.end_line(f)

    func params(p: ast.Node*?) -> !:
        var cursor = p
        var first = true
        while let param = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.put(param.text)
            if let t = param.ty:
                try self.put(": ")
                try self.type_node(t)
            if let default = param.left:
                try self.put(" = ")
                try self.expr(default)
            cursor = param.next

    # mark: Statements ========================================================================

    func block(b: ast.Node*) -> !:
        self.indent += 1
        var cursor = b.body
        var previous: ast.Node*? = none
        while let s = cursor:
            try self.separate(previous, s, false)
            previous = s
            try self.statement(s)
            cursor = s.next
        if let last = previous:
            if let first = b.body:
                try self.block_end_comments(last, self.indent_of(statement_start(first)))
        self.indent -= 1

    ## Comments on lines of their own right after a block's last statement, at least as deep
    ## as its statements, end the block: they are written in it, not before what follows.
    func block_end_comments(last: ast.Node*, depth: usize) -> !:
        while self.written < self.comment_count:
            let start = self.comments[self.written * 2]
            if self.indent_of(start) < depth or not self.only_deeper(statement_start(last), start, depth):
                return
            _ = try self.comments_before(start + 1)

    ## How far into its line `offset` stands.
    func indent_of(offset: usize) -> usize:
        var i = offset
        while i > 0 and self.src.bytes[i - 1] != '\n':
            i -= 1
        return offset - i

    ## Whether every line of code after the one holding `after`, up to the line holding
    ## `until`, is at least `depth` deep: nothing shallower ends the block before `until`.
    func only_deeper(after: usize, until: usize, depth: usize) -> bool:
        let bytes = self.src.bytes
        var i = after
        while i < until:
            if bytes[i] != '\n':
                i += 1
                continue
            var j = i + 1
            while j < until and bytes[j] == ' ':
                j += 1
            if j < until and bytes[j] != '\n' and bytes[j] != '\r' and bytes[j] != '#' and j - (i + 1) < depth:
                return false
            i = j
        return true

    func end_line(n: ast.Node*) -> !:
        try self.trailing_comment(self.last_line_of(n))
        try self.newline()

    ## The line a statement's last token lies on, for the trailing comment.
    func last_line_of(n: ast.Node*) -> u32:
        let (l, c) = self.src.position(n.start)
        _ = c
        return l

    func statement(s: ast.Node*) -> !:
        match s.kind:
            .let_, .var_:
                try self.put("let " if s.kind == ast.Kind.let_ else "var ")
                try self.binding_target(s)
                if let t = s.ty:
                    try self.put(": ")
                    try self.type_node(t)
                try self.put(" = ")
                let value = s.left else return
                try self.expr_or_catch(value, s)
            .assign:
                try self.expr(s.left else return)
                try self.put(" ")
                try self.put(s.text)
                try self.put(" ")
                try self.expr(s.right else return)
                try self.end_line(s)
            .expr_stmt:
                let inner = s.left else return
                try self.expr_or_catch(inner, s)
            .return_:
                try self.put("return")
                if let v = s.left:
                    try self.put(" ")
                    try self.expr(v)
                try self.end_line(s)
            .break_, .continue_:
                try self.put("break" if s.kind == ast.Kind.break_ else "continue")
                if s.text.length > 0:
                    try self.put(" ")
                    try self.put(s.text)
                try self.end_line(s)
            .recover_:
                try self.put("recover ")
                try self.expr(s.left else return)
                try self.end_line(s)
            .if_: try self.if_statement(s, "if ")
            .while_:
                if s.text.length > 0:
                    try self.put(s.text)
                    try self.put(": ")
                try self.put("while ")
                try self.condition(s)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            .for_:
                if s.text.length > 0:
                    try self.put(s.text)
                    try self.put(": ")
                try self.put("for ")
                try self.binding_target(s.left else return)
                try self.put(" in ")
                try self.expr(s.right else return)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            .match_:
                try self.put("match ")
                try self.expr(s.left else return)
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.arms(s.body, false)
            .with_:
                try self.put("with ")
                var cursor = s.left
                var first = true
                while let item = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.expr(item.left else return)
                    try self.put(" as ")
                    try self.put(item.text)
                    cursor = item.next
                try self.put(":")
                try self.trailing_comment(s.line)
                try self.newline()
                try self.block(s.body else return)
            _:
                try self.expr(s)
                try self.end_line(s)

    ## `x` or `(a, b)` of a binding or a `for`.
    func binding_target(b: ast.Node*) -> !:
        if b.body != none:
            try self.put("(")
            try self.names(b.body)
            if ast.count(b.body) == 1:
                try self.put(",")
            try self.put(")")
        else:
            try self.put(b.text)

    ## A statement's expression, which may end in a `catch` suite.
    func expr_or_catch(e: ast.Node*, s: ast.Node*) -> !:
        if e.kind == ast.Kind.catch_:
            try self.expr(e.left else return)
            try self.put(" catch")
            if e.text.length > 0:
                try self.put(" ")
                try self.put(e.text)
            try self.put(":")
            try self.trailing_comment(s.line)
            try self.newline()
            try self.block(e.body else return)
            return
        try self.expr(e)
        try self.end_line(s)

    func condition(s: ast.Node*) -> !:
        let c = s.left else return
        if s.has(ast.flag_if_let):
            try self.put("let ")
            try self.put(c.text)
            try self.put(" = ")
            try self.expr(c.left else return)
        else:
            try self.expr(c)

    func if_statement(s: ast.Node*, word: str) -> !:
        try self.put(word)
        try self.condition(s)
        try self.put(":")
        try self.trailing_comment(s.line)
        try self.newline()
        try self.block(s.body else return)
        if let rest = s.right:
            _ = try self.comments_before(rest.start)
            if rest.kind == ast.Kind.if_:
                try self.if_statement(rest, "elif ")
            else:
                try self.put("else:")
                try self.trailing_comment(self.last_line_of(rest))
                try self.newline()
                try self.block(rest)

    func arms(a: ast.Node*?, expression: bool) -> !:
        self.indent += 1
        var cursor = a
        var previous: ast.Node*? = none
        while let arm = cursor:
            try self.separate(previous, arm, false)
            previous = arm
            var p = arm.left
            var first = true
            while let pattern = p:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(pattern)
                p = pattern.next
            if let guard = arm.right:
                try self.put(" if ")
                try self.expr(guard)
            if expression:
                try self.put(" => ")
                try self.expr(arm.body else return)
                try self.end_line(arm)
            else:
                try self.put(":")
                try self.trailing_comment(arm.line)
                try self.newline()
                try self.block(arm.body else return)
            cursor = arm.next
        self.indent -= 1

    func pattern(p: ast.Node*) -> !:
        if p.has(ast.flag_wildcard):
            try self.put("_")
            return
        if p.text == "tuple":
            try self.put("(")
            var cursor = p.body
            var first = true
            while let sub = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.pattern(sub)
                cursor = sub.next
            if ast.count(p.body) == 1:
                try self.put(",")
            try self.put(")")
            return
        let v = p.left else return
        if v.kind == ast.Kind.case_value:
            if let owner = v.left:
                try self.put(owner.text)
            try self.put(".")
            try self.put(v.text)
            if v.body != none:
                try self.put("(")
                try self.names(v.body)
                try self.put(")")
            return
        try self.expr(v)
        if let high = p.right:
            try self.put(p.text)
            try self.expr(high)

    # mark: Expressions =======================================================================

    func expr(e: ast.Node*) -> !:
        match e.kind:
            .literal: try self.put(e.text)
            .name:
                try self.put(e.text)
                if let args = e.ty:
                    try self.type_args(args)
            .self_: try self.put("self")
            .unit_: try self.put("()")
            .unary:
                try self.put(e.text)
                if e.text == "-" or e.text == "~":
                    try self.expr(e.left else return)
                else:
                    try self.put(" ")
                    try self.expr(e.left else return)
            .binary:
                try self.expr(e.left else return)
                try self.put(" ")
                try self.put(e.text)
                try self.put(" ")
                try self.expr(e.right else return)
            .group:
                try self.put("(")
                try self.expr(e.left else return)
                try self.put(")")
            .member:
                try self.expr(e.left else return)
                try self.put(".")
                try self.put(e.text)
                if let args = e.ty:
                    try self.type_args(args)
            .call:
                try self.expr(e.left else return)
                if let args = e.ty:
                    try self.type_args(args)
                try self.put("(")
                try self.arguments(e.body)
                try self.put(")")
            .case_value:
                try self.put(".")
                try self.put(e.text)
                if e.body != none:
                    try self.put("(")
                    try self.arguments(e.body)
                    try self.put(")")
            .index:
                try self.expr(e.left else return)
                try self.put("[")
                try self.expr(e.body else return)
                try self.put("]")
            .slice: try self.slice_expr(e)
            .tuple:
                try self.put("(")
                try self.list(e.body)
                if ast.count(e.body) == 1:
                    try self.put(",")
                try self.put(")")
            .list_lit:
                try self.put("[")
                try self.list(e.body)
                try self.put("]")
            .set_lit:
                try self.put("{")
                try self.list(e.body)
                try self.put("}")
            .map_lit: try self.map_literal(e)
            .lambda: try self.lambda_expr(e)
            .conditional:
                try self.expr(e.left else return)
                try self.put(" if ")
                try self.expr(e.ty else return)
                try self.put(" else ")
                try self.expr(e.right else return)
            .else_: try self.else_expr(e)
            .catch_: try self.catch_expr(e)
            .formatted: try self.formatted(e)
            .match_expr:
                try self.put("match ")
                try self.expr(e.left else return)
                try self.put(":")
                try self.newline()
                try self.arms(e.body, true)
                self.at_line_start = false
                self.out.used -= 1
            .spawn_:
                try self.put("spawn ")
                try self.expr(e.left else return)
            .wait_:
                try self.put("wait ")
                try self.expr(e.left else return)
            .convert: try self.expr(e.left else return)
            _: try self.put(e.text)

    ## A slice: `receiver[low..<high]`, either bound left out as written, `..` when open.
    func slice_expr(e: ast.Node*) -> !:
        try self.expr(e.left else return)
        try self.put("[")
        if not e.has(ast.flag_no_low):
            try self.expr(e.body else return)
        if e.has(ast.flag_no_high):
            try self.put("..")
        else:
            try self.put("..<")
            try self.expr(e.right else return)
        try self.put("]")

    ## A map literal: `{key: value, ...}`.
    func map_literal(e: ast.Node*) -> !:
        try self.put("{")
        var cursor = e.body
        var first = true
        while let entry = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.expr(entry.left else return)
            try self.put(": ")
            try self.expr(entry.right else return)
            cursor = entry.next
        try self.put("}")

    ## A lambda: a block lambda with its suite, the line it ends taken back so what follows
    ## continues after it, or an expression lambda with `=>`.
    func lambda_expr(e: ast.Node*) -> !:
        if e.has(ast.flag_block_lambda):
            try self.put("func (")
            try self.params(e.right)
            try self.put(")")
            if let r = e.ty:
                try self.put(" -> ")
                try self.type_node(r)
            try self.put(":")
            try self.newline()
            try self.block(e.body else return)
            # the suite ended the line; what follows the lambda continues after it
            self.at_line_start = false
            self.out.used -= 1
        else:
            try self.put("(")
            try self.params(e.right)
            try self.put(") => ")
            try self.expr(e.body else return)

    ## `value else fallback`, the fallback a `return`, `break`, or `continue` spelled as one.
    func else_expr(e: ast.Node*) -> !:
        try self.expr(e.left else return)
        try self.put(" else ")
        let fallback = e.right else return
        match fallback.kind:
            .return_:
                try self.put("return")
                if let v = fallback.left:
                    try self.put(" ")
                    try self.expr(v)
            .break_, .continue_:
                try self.put("break" if fallback.kind == ast.Kind.break_ else "continue")
                if fallback.text.length > 0:
                    try self.put(" ")
                    try self.put(fallback.text)
            _: try self.expr(fallback)

    ## A `catch` outside a statement's end, spelled with its suite in place.
    func catch_expr(e: ast.Node*) -> !:
        try self.expr(e.left else return)
        try self.put(" catch")
        if e.text.length > 0:
            try self.put(" ")
            try self.put(e.text)
        try self.put(":")
        try self.newline()
        try self.block(e.body else return)
        self.at_line_start = false
        self.out.used -= 1

    ## A formatted string: its text parts as written, each field's expression and its
    ## specification in braces, the closing quote copied from the opening.
    func formatted(e: ast.Node*) -> !:
        try self.put(e.text)
        var cursor = e.body
        while let part = cursor:
            if part.kind == ast.Kind.format_text:
                try self.put(part.text)
            else:
                try self.put("{")
                try self.expr(part.left else return)
                if part.text.length > 0:
                    try self.put(":")
                    try self.put(part.text)
                try self.put("}")
            cursor = part.next
        try self.put((str)e.text.bytes[1..])

    func list(items: ast.Node*?) -> !:
        var cursor = items
        var first = true
        while let item = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.expr(item)
            cursor = item.next

    func arguments(a: ast.Node*?) -> !:
        var cursor = a
        var first = true
        while let arg = cursor:
            if not first:
                try self.put(", ")
            first = false
            if arg.text.length > 0:
                try self.put(arg.text)
                try self.put(" = ")
            try self.expr(arg.left else return)
            cursor = arg.next

    func type_args(args: ast.Node*) -> !:
        try self.put("[")
        var cursor = args.body
        var first = true
        while let t = cursor:
            if not first:
                try self.put(", ")
            first = false
            try self.type_node(t)
            cursor = t.next
        try self.put("]")

    func type_node(t: ast.Node*) -> !:
        if t.has(ast.flag_optional) or t.has(ast.flag_fallible):
            let inner = t.left else return
            # `?` or `!` after a function type belongs to its result: the function itself is
            # optional or fallible only in parentheses, `(func() -> int)?` (§4.2)
            let grouped = inner.has(ast.flag_func_type)
            if grouped:
                try self.put("(")
            try self.type_node(inner)
            if grouped:
                try self.put(")")
            try self.put("?" if t.has(ast.flag_optional) else "!")
            return
        if t.has(ast.flag_tuple_type):
            try self.put("(")
            var cursor = t.body
            var first = true
            while let m = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.type_node(m)
                cursor = m.next
            if ast.count(t.body) == 1:
                try self.put(",")  # `(T)` is `T` grouped; a tuple of one keeps its comma
            try self.put(")")
            return
        if t.has(ast.flag_func_type):
            try self.put("func(")
            var cursor = t.body
            var first = true
            while let m = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.type_node(m)
                cursor = m.next
            try self.put(")")
            if let r = t.right:
                try self.put(" -> ")
                try self.type_node(r)
            return
        try self.put(t.text)
        if t.body != none:
            try self.type_args(t)

## Where an expression begins: its leftmost operand's start, since a binary, member, call
## or index node stands at its operator.
func first_offset(e: ast.Node*) -> usize:
    var n = e
    while true:
        match n.kind:
            .binary, .member, .call, .index, .slice, .conditional, .else_, .catch_:
                n = n.left else return n.start
            _: return n.start

## Where a statement's text begins: an expression statement's node comes after its
## expression, an assignment's at its operator.
func statement_start(s: ast.Node*) -> usize:
    if s.kind == ast.Kind.expr_stmt or s.kind == ast.Kind.assign:
        if let inner = s.left:
            return first_offset(inner)
    return s.start
