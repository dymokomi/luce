# Command-line argument parser.
#
# A parser is configured with the flags and value-taking options a command
# accepts, then `parse` turns a raw `args` list into a `ParsedArgs`.
#
#     var parser = CmdParser(prog = "luce")
#     parser.flag("--release")        # boolean switch, absent unless given
#     parser.option("-o")             # takes a value: `-o out` or `-o=out`
#     parser.synonym("-h", "--help")  # -h resolves to --help
#     let parsed = try parser.parse(args)
#     if parsed.has("--release"): ...
#     let out = parsed.value("-o")    # str? — none when the option is absent
#
# Recognised forms: `--name`, `--name=value`, `--name value`, the short
# equivalents `-n`, `-n=value`, `-n value`, and a bare `--` that forces every
# following token to be positional. `-` on its own stays positional (it names
# standard input), and `-3` stays positional (a negative number).

import std.strings

# The outcome of a successful parse: which flags were seen, the value each
# option carried, and the positional arguments in order.
class ParsedArgs:
    flags: map[str, bool]
    values: map[str, str]
    positionals: list[str]

    init():
        self.flags = map[str, bool]()
        self.values = map[str, str]()
        self.positionals = list[str]()

    # Was this flag present?
    func has(name: str) -> bool:
        return self.flags.has(name)

    # The value given for an option, or none if it was absent.
    func value(name: str) -> str?:
        return self.values.get(name)

    # The value given for an option, or `fallback` if it was absent.
    func value_or(name: str, fallback: str) -> str:
        return self.values.get(name) else fallback

    # How many positional arguments were collected.
    func count() -> i64:
        return len(self.positionals)

    # The positional at `index`, or none when out of range.
    func positional(index: i64) -> str?:
        if index < 0 or index >= len(self.positionals):
            return none
        return self.positionals[index]


class CmdParser:
    prog: str
    flag_names: map[str, bool]
    value_names: map[str, bool]
    aliases: map[str, str]

    init(prog: str = ""):
        self.prog = prog
        self.flag_names = map[str, bool]()
        self.value_names = map[str, bool]()
        self.aliases = map[str, str]()

    # Declare a boolean switch, e.g. "--release".
    func flag(name: str):
        self.flag_names[name] = true

    # Declare an option that consumes a value, e.g. "-o" or "--emit".
    func option(name: str):
        self.value_names[name] = true

    # Make `name` resolve to `target`, e.g. synonym("-h", "--help").
    func synonym(name: str, target: str):
        self.aliases[name] = target

    func parse(args: list[str]) -> ParsedArgs!:
        var result = ParsedArgs()
        var only_positional = false
        var i = 0
        while i < len(args):
            let arg = args[i]

            if not only_positional and arg == "--":
                only_positional = true
                i += 1
                continue

            if only_positional or not self.looks_like_option(arg):
                result.positionals.append(arg)
                i += 1
                continue

            # An option token, possibly carrying an inline "=value".
            var name = arg
            var inline = ""
            var has_inline = false
            let eq = strings.find(arg, "=")
            if eq != none:
                name = arg[0:eq]
                inline = arg[eq + 1:len(arg)]
                has_inline = true

            let canon = self.canonical(name)
            if self.value_names.has(canon):
                if has_inline:
                    result.values[canon] = inline
                elif i + 1 < len(args):
                    result.values[canon] = args[i + 1]
                    i += 1
                else:
                    error(self.prog + ": option " + name + " needs a value")
            elif self.flag_names.has(canon):
                if has_inline:
                    error(self.prog + ": flag " + name + " takes no value")
                result.flags[canon] = true
            else:
                error(self.prog + ": unknown option " + name)

            i += 1
        return result

    private func canonical(name: str) -> str:
        return self.aliases.get(name) else name

    # True for tokens that should be read as options rather than positionals.
    # "-" alone (standard input) and "-3" (a negative number) stay positional.
    private func looks_like_option(arg: str) -> bool:
        if not strings.starts_with(arg, "-"):
            return false
        if len(arg) == 1:
            return false
        let second = arg[1]
        if second >= '0' and second <= '9':
            return false
        return true
