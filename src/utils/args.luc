import std.strings

class ParsedArgs:
    flags: map[str, bool]
    values: map[str, str]
    positionals: list[str]

    init():
        self.flags = map[str, bool]()
        self.values = map[str, str]()
        self.positionals = list[str]()

    func has(name: str) -> bool:
        return self.flags.has(name)

    func value(name: str) -> str?:
        return self.values.get(name)

    func value_or(name: str, fallback: str) -> str:
        return self.values.get(name) else fallback

    func count() -> i64:
        return len(self.positionals)

    func positional(index: i64) -> str?:
        if index < 0 or index >= len(self.positionals):
            return none
        return self.positionals[index]


class CmdParser:
    prog: str
    flag_names: map[str, bool]
    value_names: map[str, bool]
    aliases: map[str, str]

    init(prog: str = ""):
        self.prog = prog
        self.flag_names = map[str, bool]()
        self.value_names = map[str, bool]()
        self.aliases = map[str, str]()

    func flag(name: str):
        self.flag_names[name] = true

    func option(name: str):
        self.value_names[name] = true

    func synonym(name: str, target: str):
        self.aliases[name] = target

    func parse(args: list[str]) -> ParsedArgs!:
        var result = ParsedArgs()
        var only_positional = false
        var i = 0
        while i < len(args):
            let arg = args[i]

            if not only_positional and arg == "--":
                only_positional = true
                i += 1
                continue

            if only_positional or not self.looks_like_option(arg):
                result.positionals.append(arg)
                i += 1
                continue

            var name = arg
            var inline = ""
            var has_inline = false
            let eq = strings.find(arg, "=")
            if eq != none:
                name = arg[0:eq]
                inline = arg[eq + 1:len(arg)]
                has_inline = true

            let canon = self.canonical(name)
            if self.value_names.has(canon):
                if has_inline:
                    result.values[canon] = inline
                elif i + 1 < len(args):
                    result.values[canon] = args[i + 1]
                    i += 1
                else:
                    error(self.prog + ": option " + name + " needs a value")
            elif self.flag_names.has(canon):
                if has_inline:
                    error(self.prog + ": flag " + name + " takes no value")
                result.flags[canon] = true
            else:
                error(self.prog + ": unknown option " + name)

            i += 1
        return result

    private func canonical(name: str) -> str:
        return self.aliases.get(name) else name

    private func looks_like_option(arg: str) -> bool:
        if not strings.starts_with(arg, "-"):
            return false
        if len(arg) == 1:
            return false
        let second = arg[1]
        if second >= '0' and second <= '9':
            return false
        return true
