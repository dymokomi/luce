import std.strings

# A command line is COMMAND [options] [inputs]. Every command owns its own
# options, so parsing needs the command before it can judge the rest. Options
# given before any command belong to root(), and run.command is then "".
#
#     var cli = Cli(name = "luce")
#     cli.root().flag("--version").synonym("-v", "--version")
#     cli.command("build").flag("--release").option("-o").option("--emit")
#     let run = try cli.parse(args)
#     if run.command == "" and run.has("--version"):
#         ...
#     if run.command == "build":
#         for path in run.inputs:
#             ...

class Command:
    private flags: map[str, bool]
    private values: map[str, bool]
    private synonyms: map[str, str]

    init():
        self.flags = map[str, bool]()
        self.values = map[str, bool]()
        self.synonyms = map[str, str]()

    func flag(name: str) -> Command:
        self.flags[name] = true
        return self

    func option(name: str) -> Command:
        self.values[name] = true
        return self

    func synonym(name: str, target: str) -> Command:
        self.synonyms[name] = target
        return self

    private func canonical(name: str) -> str:
        return self.synonyms.get(name) else name

    private func takes_value(name: str) -> bool:
        return self.values.has(name)

    private func is_flag(name: str) -> bool:
        return self.flags.has(name)


class Invocation:
    command: str
    inputs: list[str]
    private switches: map[str, bool]
    private chosen: map[str, str]

    init(command: str, inputs: list[str], switches: map[str, bool], chosen: map[str, str]):
        self.command = command
        self.inputs = inputs
        self.switches = switches
        self.chosen = chosen

    func has(name: str) -> bool:
        return self.switches.has(name)

    func value(name: str) -> str?:
        return self.chosen.get(name)

    func value_or(name: str, fallback: str) -> str:
        return self.chosen.get(name) else fallback


class Cli:
    name: str
    private commands: map[str, Command]
    private root_options: Command

    init(name: str = ""):
        self.name = name
        self.commands = map[str, Command]()
        self.root_options = Command()

    func command(name: str) -> Command:
        let defined = Command()
        self.commands[name] = defined
        return defined

    func root() -> Command:
        return self.root_options

    func parse(args: list[str]) -> Invocation!:
        var command = ""
        var spec = self.root_options
        var start = 0
        if len(args) > 0 and not looks_like_option(args[0]):
            command = args[0]
            if not self.commands.has(command):
                error(self.name + ": unknown command " + command)
            spec = self.commands[command]
            start = 1

        var scope = self.name
        if command != "":
            scope = scope + " " + command

        var switches = map[str, bool]()
        var chosen = map[str, str]()
        var inputs = list[str]()
        var only_inputs = false
        var i = start
        while i < len(args):
            let arg = args[i]

            if not only_inputs and arg == "--":
                only_inputs = true
                i += 1
                continue

            if only_inputs or not looks_like_option(arg):
                inputs.append(arg)
                i += 1
                continue

            var name = arg
            var inline = ""
            var has_inline = false
            let eq = strings.find(arg, "=")
            if eq != none:
                name = arg[0:eq]
                inline = arg[eq + 1:len(arg)]
                has_inline = true

            let canon = spec.canonical(name)
            if spec.takes_value(canon):
                if has_inline:
                    chosen[canon] = inline
                elif i + 1 < len(args):
                    chosen[canon] = args[i + 1]
                    i += 1
                else:
                    error(scope + ": option " + name + " needs a value")
            elif spec.is_flag(canon):
                if has_inline:
                    error(scope + ": option " + name + " takes no value")
                switches[canon] = true
            else:
                error(scope + ": unknown option " + name)

            i += 1

        return Invocation(command, inputs, switches, chosen)


# A leading "-" marks an option, except for "-" alone (standard input) and
# negatives like "-3".
private func looks_like_option(arg: str) -> bool:
    if not strings.starts_with(arg, "-"):
        return false
    if len(arg) == 1:
        return false
    let second = arg[1]
    if second >= '0' and second <= '9':
        return false
    return true
