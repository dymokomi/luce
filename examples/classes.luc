## Managed class identities keep nominal payloads behind one target-neutral
## handle. This example proves shared mutation, weak promotion and zeroing,
## deinitialization order, and cleanup of partially initialized instances.

# mark: Class shapes ==========================================================================

let invalid: ErrorCode = ErrorCode.package(1)

class Node:
    var value: i64
    weak var parent: Node?

    func init(self, value: i64, parent: Node?):
        self.value = value
        self.parent = parent

    func increment(self): self.value += 1
    func deinit(self): return

class Trace:
    let events: list[i64]
    let value: i64

    func init(self, events: list[i64], value: i64):
        self.events = events
        self.value = value

    func record(self): self.events.append(self.value)
    func deinit(self): self.record()

class Pair:
    let events: list[i64]
    let first: Trace
    let second: Trace

    func init(self, events: list[i64]):
        self.events = events
        self.first = new Trace(events, 1)
        self.second = new Trace(events, 2)

    func deinit(self): self.events.append(0)

class Failing:
    let events: list[i64]
    let child: Trace

    func init(self, events: list[i64]) -> unit!:
        self.events = events
        self.child = new Trace(events, 7)
        error(invalid, "expected initializer failure")

    func deinit(self): self.events.append(9)

class Observer:
    weak var target: Target?

    func init(self): self.target = none

class Target:
    let observer: Observer
    let replacement: Target?

    func init(self, observer: Observer, replacement: Target?):
        self.observer = observer
        self.replacement = replacement

    func deinit(self):
        self.observer.target = self
        self.observer.target = self.observer.target else (self.replacement else self)

# mark: Lifetime behavior =====================================================================

func identity_and_weak_lifetime() -> i64:
    let observer = new Node(1, none)
    if true:
        let temporary = new Node(40, none)
        let alias = temporary
        alias.increment()
        if not (alias is temporary): return 0
        observer.parent = temporary
        if let live = observer.parent:
            if live.value != 41: return 0
        else:
            return 0
    if let dead = observer.parent: return dead.value
    return 42

func destruction_order() -> i64:
    let events = list[i64]()
    if true:
        let pair = new Pair(events)
    if events.length != 3u64: return 0
    return events[0u64] * 100 + events[1u64] * 10 + events[2u64]

func attempt(events: list[i64]) -> i64!:
    let value = try new Failing(events)
    return value.child.value

func failed_initialization() -> i64:
    let events = list[i64]()
    let ignored = attempt(events) catch failure: recover 0
    if ignored != 0 or events.length != 1u64: return 0
    return 42 if events[0u64] == 7 else 0

func dying_weak_sink() -> i64:
    let observer = new Observer()
    let survivor = new Target(observer, none)
    if true:
        let target = new Target(observer, survivor)
    if let live = observer.target:
        return 42 if live is survivor else 0
    return 0

# mark: Product entry =========================================================================

pub func answer() -> i64:
    if identity_and_weak_lifetime() != 42: return 0
    if destruction_order() != 21: return 0
    if failed_initialization() != 42: return 0
    return dying_weak_sink()

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
