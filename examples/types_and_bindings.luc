## Type aliases, local inference, value copying, shared identity, tuple binding,
## recursive indirection, and generic mutable places retain one meaning through
## both semantic oracles and every current artifact backend.

# mark: Public and inferred types ==============================================================

pub type Count = i64
pub let expected: Count = 42

enum Choice[T]:
    empty
    one(value: T)

# mark: Value and reference shapes =============================================================

struct Slot[T]:
    var value: T

struct Bundle[T]:
    var direct: Slot[T]
    let shared: list[Slot[T]]

class Cell[T]:
    var value: T

    func init(self, value: T):
        self.value = value

class Node:
    let value: Count
    var next: Node?

    func init(self, value: Count):
        self.value = value
        self.next = none

# mark: Ordered binding ========================================================================

func next_pair(counter: list[Count]) -> (Count, Count):
    counter[0u64] += 1
    let first = counter[0u64]
    counter[0u64] += 1
    return (first, counter[0u64])

func advance_shared(bundle: Bundle[Count]):
    bundle.shared[0u64].value += 1

# mark: Executable proof =======================================================================

pub func answer() -> Count:
    let counter = [0]
    let (first, second) = next_pair(counter)
    if first != 1 or second != 2 or counter[0u64] != 2:
        return 0

    # A generic struct copies by value. Its list field retains shared list
    # identity, so the direct and indexed mutations deliberately diverge.
    var original = Bundle(direct = Slot(value = 1), shared = [Slot(value = 2)])
    var copied = original
    advance_shared(original)
    copied.direct.value = 20
    copied.shared[0u64].value = 21
    if original.direct.value != 1 or original.shared[0u64].value != 21:
        return 0

    # A class alias shares identity, while optional class recursion provides
    # indirection instead of a recursive value layout.
    let cell = new Cell(1)
    let cell_alias = cell
    cell_alias.value = expected
    if cell.value != expected:
        return 0
    let head = new Node(40)
    let tail = new Node(2)
    head.next = tail
    let linked = head.next else tail
    if linked.value != 2:
        return 0

    # Context supplies the generic enum application and its shorthand case.
    let selected: Choice[Count] = .one(copied.direct.value + original.direct.value + original.shared[0u64].value)
    return match selected:
        .empty => 0
        .one(value) => value

pub func main(arguments: slice[str]) -> i32:
    if answer() == expected:
        return 0
    return 1
