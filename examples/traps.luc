## A trap evaluates one ordinary string message, reports it, and terminates
## without running deferred cleanup. The message may own dynamic storage.

# mark: Dynamic diagnostic ====================================================================

func invariant_message() -> str:
    return "broken " + "invariant"

# mark: Product entry =========================================================================

pub func main(arguments: slice[str]) -> i32:
    defer print("must not run")
    trap(invariant_message())
