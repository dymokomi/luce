# A Comparable conformance defines one exact same-type, three-way ordering.
# Generic code consumes that contract through ordinary static specialization.

struct Score implements Comparable:
    let value: i64

    pub func compare(self, other: Score) -> i64:
        if self.value < other.value: return -1
        if self.value > other.value: return 1
        return 0

struct Ranked[T: Comparable] implements Comparable:
    let value: T

    pub func compare(self, other: Ranked[T]) -> i64:
        return self.value.compare(other = other.value)

func maximum[T: Comparable](left: T, right: T) -> T:
    return left if left.compare(other = right) >= 0 else right

pub func answer() -> i64:
    let lower = Ranked(value = Score(value = 40))
    let higher = Ranked(value = Score(value = 42))
    return maximum(lower, higher).value.value

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
