# Executable §§15–16 slice: an interface describes behavior, a nominal type
# opts in explicitly, and a constrained generic call specializes to the
# concrete method before canonical MIR.

# mark: Contract ============================================================================

interface Scorer:
    func score(self, bonus: i64) -> i64!

# mark: Explicit conformance ================================================================

struct Reading implements Scorer:
    let value: i64

    pub func score(self, bonus: i64) -> i64:
        return self.value + bonus

# mark: Static generic use ==================================================================

func adjusted[T: Scorer](value: T, bonus: i64) -> i64!:
    return try value.score(bonus)

pub func answer() -> i64:
    return adjusted(Reading(value = 40), 2) catch failure: recover 0

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42:
        return 0
    return 1
