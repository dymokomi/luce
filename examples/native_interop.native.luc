# Parser-conformance example for the raw native declaration surface. These
# declarations deliberately have no Luce bodies: a generated binding module
# obtains their values from the C linker boundary.
extern type NativeHandle = u64

extern blocking func read_count(handle: NativeHandle, out count: u64) -> i32
extern var native_status: i32

extern struct NativeTime:
    seconds: i64
    nanoseconds: i64
