## Runtime-backed lists keep reference identity while their element layout and
## growth policy remain invisible to source and canonical MIR.

struct Holder:
    let values: list[i64]

struct Cell:
    var value: i64

    mutating func add(self, amount: i64):
        self.value += amount

struct Node:
    let value: i64
    let children: list[Node]

func same_list(values: list[i64]) -> list[i64]:
    return values

func record(order: list[i64], value: i64) -> i64:
    order.append(value)
    return value

func literal_order() -> i64:
    let order: list[i64] = []
    let values: list[i64] = [record(order, 4), record(order, 2)]
    return order[0u64] * 10 + order[1u64] if values.length == 2u64 else 0

func recursive_answer() -> i64:
    let children: list[Node] = []
    children.append(Node(value = 42, children = []))
    let root = Node(value = 0, children = children)
    return root.children[0u64].value

func aggregate_answer() -> i64:
    let cells: list[Cell] = [Cell(value = 1)]
    cells.append(Cell(value = 2))
    cells.append(Cell(value = 3))
    cells.append(Cell(value = 4))
    cells.append(Cell(value = 5))
    cells.append(Cell(value = 6))
    cells[5u64].add(36)
    return cells[5u64].value

pub func answer() -> i64:
    let values: list[i64] = [1]
    let alias = same_list(values)
    alias.append(1)
    let holder = Holder(values = values)
    holder.values[0u64] += 40
    let scalar = alias[0u64] + values[1u64] if holder.values.length == 2u64 else 0
    return scalar if aggregate_answer() == 42 and literal_order() == 42 and recursive_answer() == 42 else 0

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
