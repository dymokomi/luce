## Immutable byte values concatenate into owned storage, while slices retain
## that hidden owner and may safely outlive the source expression.

func payload_window(value: bytes) -> slice[u8]:
    return value[1u64..<4u64]

pub func answer() -> i64:
    let payload = b"a" + b"bcde"
    let window = payload_window(payload)
    if payload != b"abcde" or not (b"ab" < b"ac"): return 0
    if window.length != 3u64: return 0
    if window[0u64] != 98u8 or window[1u64] != 99u8 or window[2u64] != 100u8: return 0
    return 42

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42: return 0
    return 1
