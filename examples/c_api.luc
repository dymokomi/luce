# Exported records are ordinary Luce values internally. Their declaration-order
# structural shape becomes C layout only when a native backend classifies an
# explicit extern, cfunc, or export edge.

export c enum Status as i32:
    ready = -2
    done = 42

export c struct Pair:
    let left: i32
    let right: i32

export c struct Envelope:
    let pair: Pair
    let status: Status
    let weight: f64

extern func c_adjust(value: Envelope) -> Envelope

export c func luce_adjust(value: Envelope) -> Envelope:
    return c_adjust(value)
