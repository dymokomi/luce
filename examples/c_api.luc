# The narrow C export surface (`export c`): parser coverage only, nothing in
# this file is generated or linked yet.

## A stable value exported through the C ABI.
export c struct Pixel:
    let red: u8
    let green: u8
    let blue: u8
    let alpha: u8

## Numeric values are explicit at a native boundary.
export c enum BlendMode as u32:
    source_over = 0
    multiply = 1
    screen = 2

## Pack one pixel into a native integer without exposing ordinary Luce layout.
export c func pack_pixel(pixel: Pixel) -> u32:
    return (u32(pixel.red) << 24) | (u32(pixel.green) << 16) | (u32(pixel.blue) << 8) | u32(pixel.alpha)
