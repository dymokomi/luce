## The first Luce Base module: the shared scalar subset in a `.lucb` file.
## It checks, runs through the reference interpreter, and lowers to a
## freestanding program; the Base process entry arrives with spans (B2).

struct Counter:
    var count: i64

    mutating func bump(self, by: i64):
        self.count += by

pub func answer() -> i64:
    var counter = Counter(count = 40)
    counter.bump(by = 2)
    return counter.count
