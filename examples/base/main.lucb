## A Base program with an entry point (base.md §9.7): `main` takes the
## command line as a span of text views that the startup shim builds from
## `argc` and `argv`, returns the exit status, and calls C directly for
## its output because the standard `io` module waits for the library port.

extern func printf(format: cstr, ...) -> i32

pub func main(arguments: str[]) -> i32:
    discard(printf("hello from luce base: %d argument(s)\n", (i32)arguments.length - 1))
    for argument in arguments[1..<arguments.length]:
        discard(printf("  %.*s\n", (i32)argument.length, (cstr)argument))
    return 0
