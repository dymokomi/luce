## Control flow in a Base module (base.md §8.4, §8.5): a label names a loop,
## so `break rows` and `continue rows` leave the inner loop and act on the
## outer one, and a match arm may carry a guard, `pattern if condition:`,
## asked after the pattern binds. A guarded arm never counts toward
## exhaustiveness, which is why `classify` keeps an unguarded `.line` arm.

enum Shape:
    dot
    line(length: i64)

func first_pair(limit: i64) -> i64:
    var found = 0
    rows: for y in 1..<limit:
        for x in 1..<limit:
            if x * y == 12:
                found = x * 10 + y
                break rows
    return found

func classify(shape: Shape) -> i64:
    match shape:
        .dot: return 1
        .line(length) if length > 10: return 20
        .line(length): return length

pub func answer() -> i64:
    var total = first_pair(5)
    total += classify(Shape.dot) + classify(Shape.line(length = 30)) + classify(Shape.line(length = 4))
    var kept = 0
    outer: for i in 0..<4:
        for j in 0..<4:
            if j == 2: continue outer
            kept += 1
    return total + kept - 34
