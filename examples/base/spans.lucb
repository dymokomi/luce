## Arrays and spans in a Base module (base.md §5.4, §8.3): `i64[4]` is a
## value array with C's layout, `i64[]` a span, a pointer and a length that
## views it. Indexing and slicing are checked in every build; `for` walks
## either by value, and a span from its parts starts wherever a pointer does.

func sum(items: const i64[]) -> i64:
    var total = 0
    for item in items: total += item
    return total

pub func answer() -> i64:
    var values: i64[4] = [10, 20, 30, 40]
    let all: i64[] = values
    all[3] = 2
    let middle = all[1..<3]
    let pair = i64[](middle.data, middle.length)
    var total = 0
    for value in values: total += value
    return total - sum(pair) + sum(all[0..<1]) + (i64)all.length * 5
