## Layout words in a Base module (base.md §5.11): every struct has C's
## layout, `packed struct` removes the padding, `align(N) struct` raises a
## record's alignment to `N`, and `align(N)` before a field raises that
## field's, which is how two hot values are kept on separate cache lines.
## `sizeof`, `alignof`, and `offsetof` answer under the target's rules.

packed struct Header:
    var tag: u8
    var length: u32

align(32) struct Slot:
    var value: u8

struct Counters:
    var hits: u8
    align(16) var misses: u8

pub func answer() -> i64:
    var total = (i64)sizeof(Header) + (i64)offsetof(Header, length)
    total += (i64)alignof(Slot) + (i64)sizeof(Slot)
    total += (i64)offsetof(Counters, misses) + (i64)sizeof(Counters)
    var header: Header = Header(tag = 7, length = 9)
    return total + (i64)header.tag + (i64)header.length - 92
