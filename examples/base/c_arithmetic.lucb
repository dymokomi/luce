## C's arithmetic in a Base module: `//` and `%` truncate toward zero with
## the dividend's sign (base.md §7.2), and an integer widens implicitly to a
## wider integer of the same signedness (base.md §7.5). The operator family
## `+% +| +?` wraps, saturates, or answers `none` on overflow instead of
## trapping (base.md §7.2). Full Luce floors, spells every conversion, and has
## none of these operators, and `(T)x` is C's cast: low bits, saturation from a
## float, no trap (base.md §7.5); this file would not check as a `.luc` module.

func quotient_and_remainder(dividend: i64, divisor: i64) -> i64:
    return (dividend // divisor) * 10 + dividend % divisor

pub func answer() -> i64:
    let byte: u8 = 40
    let count: u32 = 2
    let total: u64 = byte + count
    let wrapped = byte +% 250
    let saturated = byte +| 250
    let checked = byte +? 250
    var overflowed = 0
    if checked == none: overflowed = 1
    let low_byte = (u8)298
    let clipped = (i32)1e12
    return quotient_and_remainder(-7, 2) + i64(total) + 31 + i64(wrapped) - 34 + i64(saturated) - 255 + overflowed - 1 + i64(low_byte) - 42 + i64(clipped) - 2147483647
