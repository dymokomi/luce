## Pointer-width integers in a Base module: `usize` and `isize` take the
## target's pointer width, so this source is 64-bit on the native targets and
## 32-bit on WebAssembly (base.md §5.1). Arithmetic is checked at that width,
## and `sizeof`, `alignof`, and `offsetof` are `usize` constants the backend
## folds (base.md §5.11): the answer below is 42 at either width.

struct Span:
    let start: usize
    let length: usize

func end_of(span: Span) -> usize:
    return span.start + span.length

pub func answer() -> usize:
    let span = Span(start = 40, length = 2)
    return end_of(span) + sizeof(Span) - 2 * sizeof(usize) + offsetof(Span, start)
