## Atomics in a Base module (base.md §15.1): `@T` marks a location whose
## every access is one atomic instruction. A plain read is a sequentially
## consistent load, `=` a store, `+=` the read-modify-write instruction,
## and the methods name their memory order; `cas` answers whether it
## exchanged and the value it observed.

struct Stats:
    var hits: @u64
    var misses: @u64

var ready: @bool

func record(stats: Stats*, hit: bool) -> u64:
    if hit: return stats.hits.add(1, .relaxed)
    stats.misses += 1
    return stats.misses

pub func answer() -> i64:
    var stats = Stats(hits = 0, misses = 0)
    var total = 0
    for step in 0..<5: total += (i64)record(&stats, step != 2)
    total += (i64)stats.hits * 10
    ready.store(true, .release)
    if ready.load(.acquire): total += 1
    let (exchanged, observed) = stats.misses.cas(1, 7)
    if exchanged: total += (i64)stats.misses - (i64)observed
    return total - 12
