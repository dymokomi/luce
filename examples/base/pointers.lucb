## Pointers in a Base module (base.md §5.3, §6.6, §7.7): `&place` takes an
## address whose qualifier comes from the path's root, `*p` loads and stores,
## `.` dereferences automatically, `const T*` reads only, and a `T*` is never
## null. The reference interpreter models addresses as places in call frames.

struct Point:
    var x: i64
    var y: i64

func bump(point: Point*, by: i64):
    point.x += by
    point.y += by

func total(point: const Point*) -> i64:
    return point.x + point.y

pub func answer() -> i64:
    var point = Point(x = 10, y = 20)
    var count: i64 = 5
    let counter: i64* = &count
    *counter += 1
    bump(&point, 3)
    return total(&point) + *counter
