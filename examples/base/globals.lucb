## Module globals in a Base module (base.md §6.3): a top-level `var` is zero
## before `main` runs or holds the constant its initialiser names, so there
## is no initialisation order. `thread_local var` is one cell per thread. A
## constant expression (base.md §6.4) may build a struct, an array, or take
## the address of another global; `pub let` at top level is a constant.

struct Bounds:
    var low: i64
    var high: i64

var calls: i64
var seed: u32 = 2654435769
thread_local var depth: i64 = 2
var window: Bounds = Bounds(low = 3, high = 9)
var weights: i64[3] = [1, 2, 3]
var current: i64* = &calls
pub let scale: i64 = 4 * 5

func record() -> i64:
    calls += 1
    return calls

pub func answer() -> i64:
    var total = record() + record()
    total += (i64)(seed % 100)
    total += depth + window.high - window.low
    total += weights[0] + weights[1] + weights[2]
    *current += 5
    return total + calls + scale - 71
