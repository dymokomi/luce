## Failure in a Base module (base.md §11.2–11.4, §8.8): a fallible function
## returns `T!`, `error(code, "text")` raises with a `str` view message that
## costs nothing, `try` propagates, `catch failure:` reads `code` and
## `message`, and `recover` gives the expression a value. `errdefer` runs
## only when an error leaves the scope; `defer` runs either way.

let empty_input: ErrorCode = ErrorCode.package(1)
let too_long: ErrorCode = ErrorCode.package(2)

func note(log: i64*, amount: i64):
    *log += amount

func measure(text: str, log: i64*) -> i64!:
    errdefer note(log, 100)
    defer note(log, 1)
    if text.length == 0: error(empty_input, "empty input")
    if text.length > 8: error(too_long, "too long")
    return (i64)text.length

func measure_twice(text: str, log: i64*) -> i64!:
    let first = try measure(text, log)
    return first * 2

pub func answer() -> i64:
    var log = 0
    var total = measure_twice("hello", &log) catch failure:
        recover -100
    total += measure_twice("", &log) catch failure:
        if failure.code == empty_input: recover (i64)failure.message.length
        recover -100
    total += measure_twice("far too long", &log) catch failure:
        if failure.code == too_long and failure.message.length == 8: recover 7
        recover -100
    return total + log - 189
