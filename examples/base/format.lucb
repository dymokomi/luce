#==============================================================================================
#
#   format - Formatted output without a string value
#
#   DESCRIPTION:
#       `print(f"...")` writes each piece straight to standard output through
#       the standard `io` module (base.md §5.5, §14.4): integers, `bool`,
#       `char`, `str`, and pointers each have a display the compiler calls.
#       Nothing is allocated; no string exists between the pieces.
#
#==============================================================================================

pub func main(arguments: str[]) -> i32:
    let count: i32 = -7
    let flag = true
    let letter = 'é'
    let word = "hello"
    print(f"count {count} flag {flag} letter {letter} word {word}")
    print(f"arguments {arguments.length} code {u32(letter)}")
    return 0
