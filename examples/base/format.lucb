#==============================================================================================
#
#   format - Formatted output without a string value
#
#   DESCRIPTION:
#       A formatted string is consumed, never held (base.md §5.5): `print`
#       writes it to standard output, `writer.write` to any `Writer`, and
#       `format` into the caller's buffer, answering a view of the text.
#       Integers, `bool`, `char`, `str`, and pointers each have a display the
#       compiler calls in the standard `io` module. Nothing is allocated.
#
#==============================================================================================

import io

## A `fmt` parameter carries the caller's formatted string without forming a
## string: pieces on the caller's stack, written where the callee decides.
func log(message: fmt, at: Location = location()):
    io.stderr().write(f"{at.line}: ") catch reason:
        return
    io.stderr().write(message) catch reason:
        return
    io.stderr().write(f"\n") catch reason:
        return

pub func main(arguments: str[]) -> i32:
    let count: i32 = -7
    let flag = true
    let letter = 'é'
    let word = "hello"
    print(f"count {count} flag {flag} letter {letter} word {word}")
    print(f"arguments {arguments.length} code {u32(letter)}")
    var buffer: u8[32]
    let label = format(buffer, f"count={count}") catch reason:
        return 2
    print(f"[{label}] {label.length}")
    io.stderr().write(f"to stderr {count}\n") catch reason:
        return 3
    log(f"logged {count} {flag}")
    log("plain")
    return 0
