## Allocation in a Base module (base.md §12): only `new` and `alloc`
## allocate, every allocation is fallible, `free` returns storage, and the
## current allocator is a thread-local view that `with` sets for a suite
## and restores on every exit. `FixedBuffer` bumps through a caller's
## bytes and answers `none` when they run out, which `new` reports as
## `memory.exhausted`.

import memory

struct Node:
    var value: i64
    var next: Node*?

func push(head: Node*?, value: i64) -> Node*?!:
    let node = try new Node(value = value, next = head)
    return node

func total(head: Node*?) -> i64:
    var sum = 0
    var current = head
    while current != none:
        if let node = current:
            sum += node.value
            current = node.next
    return sum

func build(count: i64) -> i64!:
    var head: Node*? = none
    for index in 0..<count: head = try push(head, index + 1)
    let numbers = try new i64[3]
    numbers[0] = 5
    numbers[2] = 7
    let scratch = try alloc u8[16]
    scratch[0] = 3
    let raw = try alloc(8, 8)
    raw[1] = 1
    let sum = total(head) + numbers[0] + numbers[1] + numbers[2] + (i64)scratch[0] + (i64)raw[1]
    free(numbers)
    free(scratch)
    free(raw)
    return sum

pub func answer() -> i64:
    var backing: u8[512]
    var buffer = memory.FixedBuffer.over(backing)
    var total = 0
    with buffer:
        total += build(4) catch failure:
            return -1
    var small: u8[32]
    var tiny = memory.FixedBuffer.over(small)
    with tiny:
        let refused = build(4) catch failure:
            if failure.code == memory.exhausted: total += 16
            recover 0
        total += refused
    return total
