## Interface views in a Base module (base.md §14.3): `let shape: Shape =
## &square` is a two-word value, the conformer's address and its witness
## table's, that borrows the object. A call dispatches through the table
## in one indirect call, a `mutating` requirement changes the object the
## view names, and views copy freely into arrays and spans.

interface Shape:
    func area(self) -> i64
    mutating func grow(self, by: i64)

struct Square implements Shape:
    var side: i64

    pub func area(self) -> i64: return self.side * self.side
    pub mutating func grow(self, by: i64): self.side += by

struct Rect implements Shape:
    var width: i64
    var height: i64

    pub func area(self) -> i64: return self.width * self.height
    pub mutating func grow(self, by: i64): self.width += by

func total_area(shapes: Shape[]) -> i64:
    var total = 0
    for shape in shapes: total += shape.area()
    return total

pub func answer() -> i64:
    var square = Square(side = 2)
    var rect = Rect(width = 3, height = 4)
    let first: Shape = &square
    let second: Shape = &rect
    first.grow(1)
    let shapes: Shape[2] = [first, second]
    return total_area(shapes) + square.side * 7
