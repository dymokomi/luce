## Exports in a Base module (base.md §17.6): `export func` gives a function
## C linkage under its own name, and the header a build writes carries every
## Base struct, pointer, and integer-backed enum the signatures name, each
## spelled in standard C. A bare pointer arriving from C is checked once
## for null; a `T*?` parameter admits `NULL`.

pub struct Point:
    pub var x: i32
    pub var y: i32

pub enum Access as u32:
    read = 1
    write = 2

export func shift(point: Point*, by: Point, flags: Access) -> Point:
    if flags == Access.write: point.x += by.x
    return *point

export func first(points: const Point*?, count: usize) -> i32:
    if let found = points:
        if count > 0: return found.x
    return -1

pub func answer() -> i64:
    var point = Point(x = 1, y = 2)
    let moved = shift(&point, Point(x = 40, y = 0), Access.write)
    let unchanged = shift(&point, Point(x = 5, y = 0), Access.read)
    let view: const Point* = &point
    return (i64)moved.x + (i64)first(view, 1) - (i64)unchanged.x + (i64)first(none, 0) + 2
