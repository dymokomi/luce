## An integer-backed enum in a Base module (base.md §10.3): `enum Access as
## u32` is a `u32` whose cases are declared values. `|`, `&`, `^`, and `~`
## combine flags as the same enum, `(u32)mode` reads the bits, `Access(n)` is
## the checked conversion that traps on an undeclared value, `(Access)n` is
## C's unchecked cast, and a `match` needs `_` because a flag set may hold a
## value no case declares.

enum Access as u32:
    empty = 0
    read = 1
    write = 2
    execute = 4

func weight(mode: Access) -> i64:
    match mode:
        .empty: return 0
        .read: return 1
        .write: return 2
        .execute: return 4
        _: return 10

pub func answer() -> i64:
    let mode = Access.read | Access.write
    var total = weight(mode)
    if (mode & Access.write) != Access.empty: total += 10
    total += weight(mode & ~Access.read)
    total += weight(Access(4))
    total += (i64)(u32)(mode ^ Access.write)
    total += weight((Access)8) + 5
    return total
