## A union in a Base module (base.md §10.4): every member starts at the same
## address, so writing one and reading another reinterprets the bytes, as C
## defines it. The union's size is its largest member's rounded up to the
## strictest alignment, it is zeroed as bytes, and it may declare methods.

struct Halves:
    var low: u32
    var high: u32

union Word:
    integer: i64
    real: f64
    bytes: u8[8]
    halves: Halves

    func low_byte(self) -> i64: return (i64)self.bytes[0]

pub func answer() -> i64:
    var word = Word(integer = 300)
    var total = word.low_byte() + (i64)word.bytes[1]
    word.halves = Halves(low = 7, high = 0)
    total += word.integer
    word.real = 1.0
    if word.halves.high == 1072693248: total += 3
    var blank: Word
    total += blank.integer + (i64)sizeof(Word)
    return total - 21
