## `volatile` in a Base module (base.md §15.2): a load or store through
## `volatile T*` is an observable effect that no backend elides, merges,
## reorders with another volatile access, or widens. Hardware registers
## are read this way; the qualifier lives on the pointer, so every access
## through it, the pointee or one of its fields, is volatile.

struct Timer:
    var control: u32
    var count: u32

func start(timer: volatile Timer*):
    timer.control = 1
    timer.count = 0

func tick(timer: volatile Timer*, times: i64):
    for step in 0..<times: timer.count += 1

pub func answer() -> i64:
    var timer: Timer = Timer(control = 0, count = 0)
    var flag: u8 = 0
    let ready: volatile u8* = &flag
    start(&timer)
    tick(&timer, 40)
    *ready = 1
    return (i64)timer.count + (i64)timer.control + (i64)*ready
