# An allocation-free adaptation of the Stage-0 sorting example. The original
# uses a growable `list[i64]`; this version makes the input size explicit and
# exercises fixed-array value copies, checked reads and writes, and aggregate
# function results through the Stage-1 QBE pipeline.
#
# Source lineage:
# https://github.com/dymokomi/luce-stage-0/blob/d5b458355179c059ce9c506c37990612c2c8f68f/examples/sort/sort.luc

pub type Values = array[i64, 10]

pub func sorted(input: Values) -> Values:
    var values = input
    var upper = values.length
    while upper > 1u64:
        var index = 1u64
        while index < upper:
            let left = index - 1u64
            if values[left] > values[index]:
                let saved = values[left]
                values[left] = values[index]
                values[index] = saved
            index += 1u64
        upper -= 1u64
    return values

pub func main(arguments: slice[str]) -> i32:
    let values = sorted([42, 7, -3, 99, 0, 13, -40, 8, 77, 1])
    let expected: Values = [-40, -3, 0, 1, 7, 8, 13, 42, 77, 99]
    return 0 if values == expected else 1
