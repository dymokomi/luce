## Checked numeric construction uses one source spelling and one semantic
## policy across integer domains and IEEE floating-point widths.

# mark: Numeric construction ==================================================================

func narrow(value: f64) -> f32:
    return f32(value)

func widen(value: f32) -> f64:
    return f64(value)

func truncate(value: f64) -> i64:
    return i64(value)

pub func answer() -> i64:
    # Context and explicit construction produce the same binary32 value.
    let contextual: f32 = 0.1
    let rounded = narrow(0.1)
    if widen(contextual) != widen(rounded): return 0

    # Integer conversion and arithmetic round at the binary32 operation.
    let large = f32(16777217u32)
    let sum: f32 = 16777216.0 + 1.0
    if widen(large) != 16777216.0 or widen(sum) != 16777216.0: return 0

    # Existing IEEE non-finite values survive floating-width conversion.
    let infinity = 1.0 / 0.0
    if widen(narrow(infinity)) != infinity: return 0
    let not_a_number = narrow(0.0 / 0.0)
    if not_a_number == not_a_number: return 0

    # Float-to-integer construction truncates toward zero after its range check.
    if truncate(-42.75) != -42: return 0
    return 42

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42: return 0
    return 1
