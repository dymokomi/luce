# Independently generic methods combine their own type parameters with an
# already-applied receiver without exposing either abstraction to MIR.

# mark: Owner-dependent constraints =========================================================

interface Combines[T]:
    func combine(self, other: T) -> i64

struct Offset implements Combines[i64]:
    let value: i64

    pub func combine(self, other: i64) -> i64:
        return self.value + other

# mark: Generic value receiver ===============================================================

struct Box[T]:
    var value: T

    func select[U](self, primary: U, fallback: U? = none) -> U:
        return fallback else primary

    func combined[U: Combines[T]](self, value: U) -> i64:
        return value.combine(self.value)

    mutating func replace[Marker](self, marker: Marker, value: T):
        self.value = value

    func repeat[U](self, value: U, remaining: i64) -> U:
        if remaining == 0:
            return value
        return self.repeat(value, remaining - 1)

# mark: Concrete, class, and enum receivers ==================================================

struct MethodHost:
    func identity[T](self, value: T) -> T:
        return value

class Cell[T]:
    let value: T

    func init(self, value: T):
        self.value = value

    func project[U](self, value: U) -> U:
        return value

enum Choice[T]:
    empty
    one(value: T)

    func project[U](self, value: U) -> U:
        return value

# mark: Concrete specializations =============================================================

pub func answer() -> i64:
    var box = Box(20)
    box.replace("marker", 40)
    let explicit = box.select[str]("luce")
    if explicit != "luce" or box.select(0, fallback = 1) != 1:
        return 0
    if box.repeat(false, 2) or MethodHost().identity(false):
        return 0
    let cell = new Cell(0)
    let choice = Choice.one(0)
    if cell.project(false) or choice.project(false):
        return 0
    return box.combined(Offset(value = 2))

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42:
        return 0
    return 1
