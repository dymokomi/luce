import checkout.catalog

pub enum Discount:
    full_price
    percent(rate: u8)
    fixed(value: catalog.Cents)

# Percentage rounding is an implementation detail, so this stays private.
func percentage_price(amount: catalog.Cents, rate: u8) -> catalog.Cents:
    let reduction = amount * catalog.Cents(rate) / 100
    return 0 if reduction > amount else amount - reduction

pub func apply_discount(amount: catalog.Cents, discount: Discount) -> catalog.Cents:
    return match discount:
        .full_price => amount
        .percent(rate) => percentage_price(amount, rate)
        .fixed(value) => 0 if value > amount else amount - value

pub func describe(discount: Discount) -> str:
    match discount:
        .full_price: return "full price"
        .percent(rate): return f"{rate}% off"
        .fixed(value): return f"{value} cents off"

test "fixed discounts do not underflow":
    assert(apply_discount(500, Discount.fixed(value: 800)) == 0)
