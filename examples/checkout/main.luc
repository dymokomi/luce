from checkout.catalog import Product, find_product, sample_catalog
import checkout.pricing as prices

# Entry-point support code is private unless another module truly needs it.
func print_product(product: Product):
    print(f"{product.name}: {product.price_cents} cents")

pub func main(arguments: slice[str]) -> i32 uses terminal:
    let products = sample_catalog()
    let sku = arguments[0] if len(arguments) > 0 else "keyboard"
    let selected = find_product(products, sku)
    if let product = selected:
        print_product(product)
        let discount = prices.Discount.percent(rate: 10)
        let total = prices.apply_discount(product.price_cents, discount)
        print(f"after {prices.describe(discount)}: {total} cents")
    else:
        print("product not found")
    return 0
