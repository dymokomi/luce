## The generated safe binding owns the native sensor, lends checked call-only
## borrows, anchors a returned borrow to that owner, and converts the C status
## result into ordinary Luce failure.

import temperature.raw as raw_temperature
import temperature.safe as safe_temperature

pub func safe_sensor_lifecycle(value: i64) -> i64!:
    let sensor = safe_temperature.luce_temperature_sensor_open(raw_temperature.luce_degrees(value))
    let borrowed = sensor.borrow()
    let reading = safe_temperature.luce_temperature_sensor_value(borrowed).portable()
    let echoed_reading = match safe_temperature.luce_temperature_sensor_echo(borrowed):
        .some(echoed) => safe_temperature.luce_temperature_sensor_value(echoed).portable()
        .none => -1
    if safe_temperature.luce_temperature_sensor_present(none).portable(): return -2
    try safe_temperature.luce_temperature_sensor_validate(borrowed)
    sensor.close()
    sensor.close()
    return reading if echoed_reading == reading else -3
