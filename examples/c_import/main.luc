from c_import.temperature import boiling_celsius, celsius_to_fahrenheit, scale_round_trips, shifted_range, shifted_reading

pub func main(arguments: slice[str]) -> i32!:
    if not scale_round_trips():
        return 1
    if boiling_celsius() != 100:
        return 2
    let (minimum, maximum) = shifted_range(-10.0, 10.0, 5.0)
    if minimum != -5.0 or maximum != 15.0:
        return 3
    let (reading_minimum, reading_maximum, current, is_celsius) = shifted_reading(5)
    if reading_minimum != -5.0 or reading_maximum != 15.0 or current != 5 or not is_celsius:
        return 4
    let freezing = celsius_to_fahrenheit(0.0)
    print(f"water freezes at {freezing} degrees Fahrenheit")
    return 0
