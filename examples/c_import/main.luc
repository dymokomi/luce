from c_import.temperature import absent_sensor_round_trips, adjusted_half, boiling_celsius, celsius_to_fahrenheit, constant_extrema, enumeration_constants, external_objects, macro_constants, optional_sensor_value, scalar_constants, scalar_macro_constants, scale_round_trips, sensor_value, shifted_range, shifted_reading

pub func main(arguments: slice[str]) -> i32!:
    if not scale_round_trips():
        return 1
    if boiling_celsius() != 100:
        return 2
    if adjusted_half(1.0f16, 0.5f16) != 1.5f16:
        return 3
    let (minimum_negative, minimum_magnitude, maximum_negative, maximum_magnitude) = constant_extrema()
    if not minimum_negative or minimum_magnitude != 9223372036854775808u64 or maximum_negative or maximum_magnitude != 18446744073709551615u64:
        return 4
    let (default_negative, default_magnitude, open_negative, open_magnitude) = enumeration_constants()
    if not default_negative or default_magnitude != 2u64 or open_negative or open_magnitude != 7u64:
        return 10
    let (zero_negative, zero_magnitude, limit_negative, limit_magnitude) = macro_constants()
    if not zero_negative or zero_magnitude != 273u64 or limit_negative or limit_magnitude != 4095u64:
        return 7
    let (constant_enabled, constant_half, constant_zero, constant_ratio, constant_infinity, constant_nan) = scalar_constants()
    if not constant_enabled or constant_half != 0.5f16 or 1.0f32 / constant_zero >= 0.0f32 or constant_ratio != 1.5 or not constant_infinity or not constant_nan:
        return 9
    let (macro_enabled, macro_half, macro_zero, macro_ratio, macro_infinity, macro_nan, macro_scale_negative, macro_scale_magnitude) = scalar_macro_constants()
    if not macro_enabled or macro_half != 0.25f16 or 1.0f32 / macro_zero >= 0.0f32 or macro_ratio != 1.25 or not macro_infinity or not macro_nan or macro_scale_negative or macro_scale_magnitude != 7u64:
        return 11
    let (offset, sensor_capacity, enabled, ratio, uses_fahrenheit) = external_objects(42)
    if offset != 42 or sensor_capacity != 4095u64 or not enabled or ratio != 1.5 or not uses_fahrenheit:
        return 8
    let (minimum, maximum) = shifted_range(-10.0, 10.0, 5.0)
    if minimum != -5.0 or maximum != 15.0:
        return 5
    let (reading_minimum, reading_maximum, current, is_celsius, fraction) = shifted_reading(5)
    if reading_minimum != -5.0 or reading_maximum != 15.0 or current != 5 or not is_celsius or fraction != 1.0f16:
        return 6
    if sensor_value(42) != 42 or optional_sensor_value(-1) != none or optional_sensor_value(7) != 7 or not absent_sensor_round_trips():
        return 12
    let freezing = celsius_to_fahrenheit(0.0)
    print(f"water freezes at {freezing} degrees Fahrenheit")
    return 0
