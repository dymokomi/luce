import c
import temperature.raw as c_temperature

# The manifest-generated raw module preserves C types and spelling. This small
# boundary makes both conversions and native trust visible to its callers.
pub func celsius_to_fahrenheit(value: f64) -> f64:
    let native_value = c.double(value)
    return c_temperature.luce_celsius_to_fahrenheit(native_value).portable()

pub func adjust_celsius(value: i64, delta: i64) -> i64:
    let native_value = c.int(value)
    let native_delta = c.int(delta)
    return c_temperature.luce_adjust_celsius(native_value, native_delta).portable()
