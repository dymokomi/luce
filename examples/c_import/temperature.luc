import c
import temperature.raw as c_temperature

# The manifest-generated raw module preserves C types and spelling. This small
# boundary makes both conversions and native trust visible to its callers.
pub func celsius_to_fahrenheit(value: f64) -> f64:
    let native_value = c.double(value)
    return c_temperature.luce_celsius_to_fahrenheit(native_value).portable()

pub func half_celsius(value: f32) -> f32:
    return c_temperature.luce_half_celsius(c.float(value)).portable()

pub func adjusted_half(value: f16, delta: f16) -> f16:
    return c_temperature.luce_adjust_half(
        c_temperature.luce_half_value(value),
        c_temperature.luce_half_value(delta),
    ).portable()

pub func constant_extrema() -> (bool, u64, bool, u64):
    let (minimum_negative, minimum_magnitude) = c_temperature.LUCE_TEMPERATURE_SIGNED_MINIMUM.portable()
    let (maximum_negative, maximum_magnitude) = c_temperature.LUCE_TEMPERATURE_UNSIGNED_MAXIMUM.portable()
    return (minimum_negative, minimum_magnitude, maximum_negative, maximum_magnitude)

## C enumeration object constants retain the declaration's nominal carrier
## and its complete open value domain, including values without an enumerator.
pub func enumeration_constants() -> (bool, u64, bool, u64):
    let (default_negative, default_magnitude) = c_temperature.LUCE_TEMPERATURE_DEFAULT_SCALE.portable()
    let (open_negative, open_magnitude) = c_temperature.LUCE_TEMPERATURE_OPEN_SCALE.portable()
    return (default_negative, default_magnitude, open_negative, open_magnitude)

## Boolean and floating object constants retain their semantic values without
## carrying C storage widths or layouts into generated Luce.
pub func scalar_constants() -> (bool, f16, f32, f64, bool, bool):
    let enabled = c_temperature.LUCE_TEMPERATURE_DEFAULT_ENABLED.portable()
    let half_step = c_temperature.LUCE_TEMPERATURE_HALF_STEP.portable()
    let negative_zero = c_temperature.LUCE_TEMPERATURE_NEGATIVE_ZERO.portable()
    let ratio = c_temperature.LUCE_TEMPERATURE_REFERENCE_RATIO.portable()
    let infinity = c_temperature.LUCE_TEMPERATURE_POSITIVE_INFINITY.portable()
    let undefined = c_temperature.LUCE_TEMPERATURE_UNDEFINED.portable()
    return (
        enabled,
        half_step,
        negative_zero,
        ratio,
        infinity > 1.7976931348623157e308,
        undefined != undefined,
    )

pub func macro_constants() -> (bool, u64, bool, u64):
    let (zero_negative, zero_magnitude) = c_temperature.LUCE_TEMPERATURE_ABSOLUTE_ZERO.portable()
    let (limit_negative, limit_magnitude) = c_temperature.LUCE_TEMPERATURE_SENSOR_LIMIT.portable()
    return (zero_negative, zero_magnitude, limit_negative, limit_magnitude)

## External C storage remains live: reads observe the linked object and writes
## pass through generated checked adapters rather than copying target-sized
## integer or enumeration representations into Luce.
pub func external_objects(value: i64) -> (i64, u64, bool, f64, bool):
    c_temperature.write_luce_temperature_offset(c_temperature.luce_degrees(value))
    c_temperature.write_luce_temperature_enabled(c.boolean(true))
    c_temperature.write_luce_temperature_ratio(c.double(1.5))
    c_temperature.write_luce_temperature_unit(c_temperature.LUCE_SCALE_FAHRENHEIT)
    return (
        c_temperature.read_luce_temperature_offset().portable(),
        c_temperature.read_luce_temperature_sensor_capacity().portable(),
        c_temperature.read_luce_temperature_enabled().portable(),
        c_temperature.read_luce_temperature_ratio().portable(),
        c_temperature.read_luce_temperature_unit() == c_temperature.LUCE_SCALE_FAHRENHEIT,
    )

pub func adjust_celsius(value: i64, delta: i64) -> i64:
    let native_value = c.int(value)
    let native_delta = c.int(delta)
    return c_temperature.luce_adjust_celsius(native_value, native_delta).portable()

pub func echo_degrees(value: i64) -> i64:
    return c_temperature.luce_echo_degrees(c_temperature.luce_degrees(value)).portable()

pub func scale_round_trips() -> bool:
    let scale = c_temperature.luce_echo_scale(c_temperature.LUCE_SCALE_CELSIUS)
    return scale == c_temperature.LUCE_SCALE_CELSIUS

pub func boiling_celsius() -> i64:
    let (is_negative, magnitude) = c_temperature.LUCE_WATER_BOILING_CELSIUS.portable()
    return -i64(magnitude) if is_negative else i64(magnitude)

pub func is_freezing(value: f64) -> bool:
    return c_temperature.luce_is_freezing(c.boolean(true), c.double(value)).portable()

pub func shifted_range(minimum: f64, maximum: f64, delta: f64) -> (f64, f64):
    let value = c_temperature.luce_temperature_range(c.double(minimum), c.double(maximum))
    let shifted = c_temperature.luce_shift_range(value, c.double(delta))
    return (shifted.minimum.portable(), shifted.maximum.portable())

pub func shifted_reading(delta: i64) -> (f64, f64, i64, bool, f16):
    let bounds = c_temperature.luce_temperature_range(c.double(-10.0), c.double(10.0))
    let reading = c_temperature.luce_temperature_reading(
        bounds,
        c_temperature.luce_degrees(0),
        c_temperature.LUCE_SCALE_CELSIUS,
        c_temperature.luce_half_value(0.5f16),
    )
    let shifted = c_temperature.luce_shift_reading(reading, c_temperature.luce_degrees(delta))
    return (
        shifted.range.minimum.portable(),
        shifted.range.maximum.portable(),
        shifted.current.portable(),
        shifted.scale == c_temperature.LUCE_SCALE_CELSIUS,
        shifted.fraction.portable(),
    )
