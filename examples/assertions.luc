## Assertions evaluate one Boolean condition and an optional ordinary string
## message. Success continues as unit; failure reports the message and traps
## without running deferred cleanup.

# mark: Successful assertion =================================================================

pub func answer() -> i64:
    assert(40 + 2 == 42)
    return 42

# mark: Product failure =======================================================================

pub func main(arguments: slice[str]) -> i32!:
    defer print("must not run")
    # Potentially terminating work happens before the condition. Removing a
    # diagnostic-only assertion must never remove another trap with it.
    let actual = answer()
    assert(actual == 41, "broken " + "assertion")
    return 0
