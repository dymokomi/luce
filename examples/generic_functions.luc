# Executable §15 slice: unconstrained generic functions are checked once with
# abstract types, then memoized as ordinary concrete HIR functions.

func identity[T](value: T) -> T:
    return value

func apply[T](value: T, operation: func(T) -> T = identity) -> T:
    return operation(value)

func choose[T](value: T, fallback: T? = none) -> T:
    return fallback else value

func descend[T](value: T, remaining: i64) -> T:
    if remaining == 0:
        return value
    return descend(value, remaining - 1)

pub func answer() -> i64:
    let copied: func(i64) -> i64 = identity
    return descend(choose(apply(copied(42))), 3)

pub func main(arguments: slice[str]) -> i32!:
    if answer() == 42:
        return 0
    return 1

# Checked and specialized like every source body, then deliberately removed
# by closed-world reachability so accounting can distinguish checked work from
# emitted code.
func unused_specialization() -> bool:
    return identity(true)
