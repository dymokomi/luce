# Focused reference for literals, composite values, and every operator family.

type ByteQuad = array[u8, 4]
type Pair = (i64, str)
type OptionalResult = i64?!

## One value containing every literal family.
struct LiteralSample:
    let boolean: bool
    let integer: i64
    let fraction: f64
    let character: char
    let text: str
    let data: bytes
    let missing: i64?
    let magic: ByteQuad

class Marker:
    func init(self): return

func literal_sample(frame: u64) -> LiteralSample:
    let integer = 42 + 1_000_000 + 0xff + 0o755 + 0b1010_1100 + i64(255u8)
    let fraction = 1.0 + 6.022e23 + f64(0.5f32)
    let text = "hello\n" + r"C:\studio\shots" + f" frame {frame}" + """
        multiline text
        """
    return LiteralSample(
        boolean: true and not false,
        integer: integer,
        fraction: fraction,
        character: '\u{1f600}',
        text: text,
        data: b"\x89PNG",
        missing: none,
        magic: [0x4c, 0x55, 0x43, 0x45],
    )

func collections() -> (list[i64], map[str, i64], set[str]):
    let numbers = [1, 2, 3]
    let counts = {"one": 1, "two": 2}
    let labels = set[str]()
    labels.insert("example")
    return (numbers, counts, labels)

func slices(values: list[i64]) -> (list[i64], list[i64], list[i64]):
    return (values[..<2], values[1..<3], values[2..])

func update_first(values: list[i64], value: i64):
    values[0] = value

func integer_operators(seed: i64) -> i64:
    let arithmetic = ((seed + 4) - 2) * 3 // 2 % 11
    var bits = u32(arithmetic)
    bits = bits & 0xff
    bits += 1
    bits -= 1
    bits *= 2
    bits //= 2
    bits %= 11
    bits &= 0xff
    bits |= 0x10
    bits ^= 0x03
    bits <<= 1
    bits >>= 1
    let combined = (~bits & 0xff) | ((bits ^ 1) << 2) | (bits >> 1)
    return i64(combined)

func floating_operators(value: f64) -> f64:
    var result = +value
    result /= 2.0
    return -result + value / 4.0

func relationships(left: i64, right: i64, first: Marker, second: Marker) -> bool:
    let ascending = left < right and left <= right
    let descending = left > right and left >= right
    let equal = left == right
    let different = left != right
    let same_object = first is second
    let different_object = first is not second
    return (ascending or descending or equal or different) and (same_object or different_object)

func range_total(limit: i64) -> i64:
    var total = 0
    for value in 0..<limit:
        total += value
    for value in 0..=limit:
        total += value
    return total

func unit_value() -> unit:
    return ()

func impossible(message: str) -> never:
    trap(message)

test "operator examples agree":
    assert(integer_operators(4) >= 0)
