# Managed closures preserve explicit value snapshots, shared mutable locals,
# fallibility, nested environments, collection ownership, and weak class
# captures after their defining calls return. The same source executes through
# the HIR and MIR oracles, Wasm, and native QBE.

type Counter = func() -> i64
let invalid: ErrorCode = ErrorCode.package(1)

func identity(value: i64) -> i64:
    return value

func apply(operation: func(i64) -> i64!, value: i64) -> i64:
    return operation(value) catch failure: recover 0

func offsetter(offset: i64) -> func(i64) -> i64:
    return func [copy amount = offset] (value: i64) -> i64:
        return value + amount

func counter(start: i64) -> Counter:
    var current = start
    return func () -> i64:
        current += 1
        return current

func nested(value: i64) -> func() -> func() -> i64:
    return () => () => value

func checked_offsetter(offset: i64) -> func(i64) -> i64!:
    return func (value: i64) -> i64!:
        if value < 0: error(invalid, "negative input")
        return value + offset

class Owner:
    var value: i64

    func init(self, value: i64):
        self.value = value

class Controller:
    var value: i64
    var callback: (func() -> i64?)?

    func init(self, value: i64):
        self.value = value
        self.callback = none

    func install(self):
        self.callback = func [weak self] () -> i64?:
            if let live = self: return live.value
            return none

    func read(self) -> i64:
        if let callback = self.callback: return callback() else 0
        return 0

func expired_reader() -> func() -> i64?:
    let owner = new Owner(7)
    return func [weak owner] () -> i64?:
        if let live = owner: return live.value
        return none

pub func answer() -> i64:
    let add = offsetter(10)
    let next = counter(2)
    let outer = nested(5)
    let inner = outer()
    let callbacks: list[func() -> i64] = [inner]
    let checked = checked_offsetter(0)
    let controller = new Controller(5)
    controller.install()
    let expired = expired_reader()
    let gone = expired() else 0
    return add(5) + next() + next() + callbacks[0u64]() + controller.read() + apply(identity, 5) + apply(checked, 5) + gone

pub func main(arguments: slice[str]) -> i32!:
    return 0 if answer() == 42 else 1
