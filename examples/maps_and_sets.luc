# Focused end-to-end reference for insertion-ordered maps and sets.

# mark: Recursive and managed values ----------------------------------------------------------

struct Node:
    let value: i64
    let edges: map[str, Node]

class Token:
    let events: list[i64]
    let value: i64

    func init(self, events: list[i64], value: i64):
        self.events = events
        self.value = value

    func deinit(self): self.events.append(self.value)

# A collection supplies the indirection that makes the recursive value finite.
func self_cycle(value: i64) -> map[str, Node]:
    let root = map[str, Node]()
    root["self"] = Node(value = value, edges = root)
    return root

func sever(root: map[str, Node]): root.clear()

# mark: Collection behavior ------------------------------------------------------------------

pub func answer() -> i64:
    let counts = {"beta": 2, "alpha": 1}
    counts.reserve(16u64)
    counts["gamma"] = 3
    counts["alpha"] = 4

    var order = ""
    var total = 0
    for key in counts:
        order = order + key
        # Replacing a value is not a shape change, so it remains valid while
        # an alias is iterating over the map.
        counts[key] = (counts[key] else 0) + 1
        total += counts[key] else 0
    if order != "betaalphagamma" or total != 12: return 1
    if counts["missing"] != none: return 2

    let copied = counts.copy()
    if copied is counts or copied != counts: return 3
    if (counts.remove("beta") else 0) != 3: return 4
    if counts.length != 2u64 or copied.length != 3u64: return 5

    let tags = set[str]("red", "green", "red")
    tags.reserve(16u64)
    if tags.length != 2u64 or not tags.contains("red"): return 6
    if not tags.insert("blue") or tags.insert("blue"): return 7
    if not tags.remove("red") or tags.remove("missing"): return 8
    let tag_copy = tags.copy()
    if tag_copy is tags or tag_copy != set[str]("green", "blue"): return 9
    tag_copy.clear()
    if tag_copy.length != 0u64 or tags.length != 2u64: return 10

    # Equality ignores insertion order and terminates over recursive graphs.
    let left = self_cycle(1)
    let right = self_cycle(1)
    let mismatch = self_cycle(2)
    let recursive_result = left == right and left != mismatch
    sever(left)
    sever(right)
    sever(mismatch)
    if not recursive_result: return 11

    # Replacement and clear each release their owned value exactly once.
    let events = list[i64]()
    let owned = map[str, Token]()
    owned["key"] = new Token(events, 1)
    owned["key"] = new Token(events, 2)
    if events != [1]: return 12
    owned.clear()
    if events != [1, 2]: return 13

    return 42

# mark: Product and trap entries --------------------------------------------------------------

# Structural mutation through any alias traps while iteration is active.
pub func mutation_trap() -> i64:
    let values = {"first": 1}
    let alias = values
    for key in values: alias["second"] = 2
    return 0

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
