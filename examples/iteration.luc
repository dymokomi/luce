## Standard iteration protocols use one source loop across concrete,
## constrained-generic, and existential values. `try for` selects the
## fallible protocol explicitly and propagates failure from `next()`.

let stopped: ErrorCode = ErrorCode.package(1)

# mark: Infallible protocols ================================================================

struct CountIterator implements Iterator[i64]:
    var current: i64
    let end: i64

    pub mutating func next(self) -> i64?:
        if self.current >= self.end: return none
        let value = self.current
        self.current += 1
        return value

struct Count implements Iterable[i64]:
    let end: i64

    pub func iterator(self) -> Iterator[i64]:
        return CountIterator(current = 0, end = self.end)

# mark: Fallible protocols ==================================================================

struct CheckedCountIterator implements FallibleIterator[i64]:
    var current: i64
    let end: i64
    let fail_at: i64

    pub mutating func next(self) -> i64?!:
        if self.current == self.fail_at: error(stopped, "iteration stopped")
        if self.current >= self.end: return none
        let value = self.current
        self.current += 1
        return value

struct CheckedCount implements FallibleIterable[i64]:
    let end: i64
    let fail_at: i64

    pub func iterator(self) -> FallibleIterator[i64]:
        return CheckedCountIterator(current = 0, end = self.end, fail_at = self.fail_at)

# mark: Iterator lifetime ===================================================================

# Class-backed iterators make the private iterator lifetime observable. The
# loop must release it at exhaustion, break, return, and propagated failure.
class TrackingIterator implements Iterator[i64]:
    let events: list[i64]
    let marker: i64
    var current: i64
    let end: i64

    func init(self, events: list[i64], marker: i64, end: i64):
        self.events = events
        self.marker = marker
        self.current = 0
        self.end = end

    pub func next(self) -> i64?:
        if self.current >= self.end: return none
        let value = self.current
        self.current += 1
        return value

    func deinit(self): self.events.append(self.marker)

struct Tracking implements Iterable[i64]:
    let events: list[i64]
    let marker: i64
    let end: i64

    pub func iterator(self) -> Iterator[i64]:
        return new TrackingIterator(self.events, self.marker, self.end)

class Token:
    let value: i64

    func init(self, value: i64): self.value = value

struct TokenIterator implements Iterator[Token]:
    let values: list[Token]
    var index: u64

    pub mutating func next(self) -> Token?:
        if self.index >= self.values.length: return none
        let value = self.values[self.index]
        self.index += 1u64
        return value

struct Tokens implements Iterable[Token]:
    let values: list[Token]

    pub func iterator(self) -> Iterator[Token]:
        return TokenIterator(values = self.values, index = 0u64)

class FailingTrackingIterator implements FallibleIterator[i64]:
    let events: list[i64]
    var current: i64

    func init(self, events: list[i64]):
        self.events = events
        self.current = 0

    pub func next(self) -> i64?!:
        if self.current == 1: error(stopped, "iteration stopped")
        self.current += 1
        return self.current

    func deinit(self): self.events.append(4)

struct FailingTracking implements FallibleIterable[i64]:
    let events: list[i64]

    pub func iterator(self) -> FallibleIterator[i64]:
        return new FailingTrackingIterator(self.events)

# mark: Use sites ============================================================================

func generic_sum[T: Iterable[i64]](values: T) -> i64:
    var total = 0
    for value in values:
        if value == 1: continue
        total += value
        if value == 3: break
    return total

func existential_sum(values: Iterable[i64]) -> i64:
    var total = 0
    for value in values: total += value
    return total

func checked_sum(values: CheckedCount) -> i64!:
    var total = 0
    try for value in values: total += value
    return total

func checked_generic_sum[T: FallibleIterable[i64]](values: T) -> i64!:
    var total = 0
    try for value in values: total += value
    return total

func checked_existential_sum(values: FallibleIterable[i64]) -> i64!:
    var total = 0
    try for value in values: total += value
    return total

func exhausts(events: list[i64]):
    for value in Tracking(events = events, marker = 1, end = 2): discard(value)

func breaks(events: list[i64]):
    for value in Tracking(events = events, marker = 2, end = 2): break

func returns(events: list[i64]) -> i64:
    for value in Tracking(events = events, marker = 3, end = 2): return 7
    return 0

func fails(events: list[i64]) -> unit!:
    try for value in FailingTracking(events = events): discard(value)

func no_value(): return

func managed_element_sum() -> i64:
    let values = list[Token]()
    values.append(new Token(20))
    values.append(new Token(22))
    var total = 0
    for value in Tokens(values = values): total += value.value
    return total

func lifetimes_are_lexical() -> bool:
    let events = list[i64]()
    exhausts(events)
    if events.length != 1u64 or events[0u64] != 1: return false
    breaks(events)
    if events.length != 2u64 or events[1u64] != 2: return false
    if returns(events) != 7: return false
    if events.length != 3u64 or events[2u64] != 3: return false
    var expected_failure = false
    fails(events) catch failure:
        expected_failure = failure.code == stopped and failure.message == "iteration stopped"
        recover no_value()
    return expected_failure and events.length == 4u64 and events[3u64] == 4 and managed_element_sum() == 42

pub func answer() -> i64:
    let generic = generic_sum(Count(end = 5))
    let existential = existential_sum(Count(end = 4))
    let successful = checked_sum(CheckedCount(end = 4, fail_at = 9)) catch failure: recover 0
    let fallible_generic = checked_generic_sum(CheckedCount(end = 4, fail_at = 9)) catch failure: recover 0
    let fallible_existential = checked_existential_sum(CheckedCount(end = 4, fail_at = 9)) catch failure: recover 0
    let recovered = checked_sum(CheckedCount(end = 4, fail_at = 2)) catch failure: recover 25
    let result = generic + existential + successful + recovered
    let all_dispatch = fallible_generic == 6 and fallible_existential == 6
    return result if all_dispatch and lifetimes_are_lexical() else 0

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
