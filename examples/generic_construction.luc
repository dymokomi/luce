# Generic nominal construction specializes custom initializers and type
# functions before canonical MIR, exactly like every other generic callable.

# mark: Constrained value construction ========================================================

interface Scored:
    func score(self) -> i64

struct Score implements Scored:
    let value: i64

    pub func score(self) -> i64:
        return self.value

struct Box[T: Scored]:
    let value: T

    func init(self, primary: T, fallback: T? = none):
        self.value = fallback else primary

    func make(value: T) -> Box[T]:
        return Box(value)

# mark: Contextual and explicit owner arguments ===============================================

struct Slot[T]:
    let value: T?

    func empty() -> Slot[T]:
        return Slot(value = none)

# mark: Reference and sum construction =========================================================

class Cell[T]:
    let value: T

    func init(self, value: T):
        self.value = value

    func make(value: T) -> Cell[T]:
        return new Cell(value)

enum Choice[T]:
    empty
    one(value: T)

    func make(value: T) -> Choice[T]:
        return .one(value)

# mark: Concrete specializations ===============================================================

pub func answer() -> i64:
    let inferred = Box.make(Score(value = 40))
    let overridden = Box(Score(value = 0), fallback = Score(value = 1))
    let contextual: Slot[i64] = Slot.empty()
    let explicit = Slot.empty[str]()
    let cell = Cell.make(1)
    let choice = Choice.make(0)
    let selected = match choice:
        .empty => 1
        .one(value) => value
    if contextual.value != none or explicit.value != none:
        return 0
    return inferred.value.score() + overridden.value.score() + cell.value + selected

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42:
        return 0
    return 1
