## Conditional binding evaluates one optional expression and introduces its
## immutable payload name only in the successful branch. Conditional
## expressions choose the same common type regardless of arm order.

# mark: Optional selection ==================================================================

func lookup(enabled: bool) -> i64?:
    if enabled: return 21
    return none

func selected(enabled: bool) -> i64:
    if let value = lookup(enabled):
        return value * 2
    else:
        return 7

# mark: Product entry ========================================================================

pub func answer() -> i64:
    let present = selected(true)
    let absent = selected(false)
    let missing: i64? = none
    let promoted = 40 if true else missing
    let inferred = none if false else 2
    if absent != 7 or present != 42: return 0
    return (promoted else 0) + (inferred else 0)

pub func main(arguments: slice[str]) -> i32:
    if answer() == 42: return 0
    return 1
