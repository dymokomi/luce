## Immutable strings own dynamic UTF-8 storage while exposing Unicode scalar
## length and iteration. Byte count remains a separate O(1) property.

# mark: Construction ===========================================================================

struct Label:
    let value: str

func assembled() -> str:
    return "aλ" + "😀z"

# mark: Unicode semantics ======================================================================

pub func answer() -> i64:
    let label = Label(value = assembled())
    let text = label.value
    if text != "aλ😀z": return 0
    if text.length() != 4u64 or text.byte_count != 8u64: return 0
    if not ("a" < "λ" and "λ" < "😀" and "λ" < "λa"): return 0

    var score = 0
    for character in text:
        if character == 'λ':
            score += 10
            continue
        if character == '😀': score += 30
        if character == 'z': break
        score += 1
    return score

# mark: Product entry ===========================================================================

pub func main(arguments: slice[str]) -> i32:
    return 0i32 if answer() == 42 else 1i32
