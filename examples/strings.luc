## Immutable strings own dynamic UTF-8 storage while exposing Unicode scalar
## length and iteration. Byte count remains a separate O(1) property.

# mark: Construction ===========================================================================

struct Label:
    let value: str

func assembled() -> str:
    return "aλ" + "😀z"

# mark: Literal spellings ======================================================================

func literal_forms_are_exact() -> bool:
    let path = r"C:\studio\shots\n"
    if path != "C:\\studio\\shots\\n": return false
    if "\u{3bb}\u{1f600}" != "λ😀": return false

    let payload = b"\x00\xff\u{3bb}\u{1f600}"
    if payload.length != 8u64: return false
    if payload[0u64] != 0u8 or payload[1u64] != 255u8: return false
    return payload[2u64] == 206u8 and payload[3u64] == 187u8

func triple_forms_are_exact() -> bool:
    let text = """
        alpha
          beta
        """
    if text != "alpha\n  beta": return false

    let path = r"""
        C:\studio\n
        """
    if path != r"C:\studio\n": return false

    let payload = b"""
        A\x00\u{3bb}
        """
    return payload.length == 4u64 and payload[0u64] == 65u8 and payload[1u64] == 0u8

func discard_owned_temporary():
    discard(assembled())

# mark: Unicode semantics ======================================================================

pub func answer() -> i64:
    if not literal_forms_are_exact(): return 0
    if not triple_forms_are_exact(): return 0
    discard_owned_temporary()
    let label = Label(value = assembled())
    let text = label.value
    if text != "aλ😀z": return 0
    if text.length() != 4u64 or text.byte_count != 8u64: return 0
    if not ("a" < "λ" and "λ" < "😀" and "λ" < "λa"): return 0

    var score = 0
    for character in text:
        if character == 'λ':
            score += 10
            continue
        if character == '😀': score += 30
        if character == 'z': break
        score += 1
    return score

# mark: Product entry ===========================================================================

pub func main(arguments: slice[str]) -> i32:
    return 0i32 if answer() == 42 else 1i32
