# Expressions and calls retain source order in resolved HIR and canonical MIR.
# This example keeps the observations in language data so both semantic
# oracles and every artifact backend can prove the same contract.

# mark: Observable evaluation order ==========================================================

class Trace:
    var digits: i64

    func init(self):
        self.digits = 0

    func mark(self, digit: i64) -> i64:
        self.digits = self.digits * 10 + digit
        return digit

    func clear(self):
        self.digits = 0

    func combine(self, left: i64, right: i64 = 3) -> i64:
        return left * 10 + right

func selected(trace: Trace) -> Trace:
    discard(trace.mark(1))
    return trace

struct Pair:
    let left: i64
    let right: i64

func order_is_preserved() -> bool:
    let trace = new Trace()

    let call = selected(trace).combine(right = trace.mark(2), left = trace.mark(3))
    if trace.digits != 123 or call != 32: return false

    trace.clear()
    let values: list[i64] = [trace.mark(4), trace.mark(5)]
    if trace.digits != 45 or values[0u64] != 4 or values[1u64] != 5: return false

    trace.clear()
    let text = f"{trace.mark(6)}{trace.mark(7)}"
    if trace.digits != 67 or text != "67": return false

    trace.clear()
    let total = trace.mark(8) + trace.mark(9)
    if trace.digits != 89 or total != 17: return false

    trace.clear()
    let pair = Pair(right = trace.mark(1), left = trace.mark(2))
    if trace.digits != 12 or pair.left != 2 or pair.right != 1: return false

    # The complete right-hand side observes and mutates the old destination
    # before the final assignment changes it.
    trace.digits = trace.digits * 10 + trace.mark(3)
    return trace.digits == 123

# mark: Functions, defaults, and tuples ======================================================

let standard: i64 = 40

func choose(value: i64 = standard, offset: i64 = 2) -> i64:
    return value + offset

func split(value: i64) -> (i64, i64):
    return (value // 2, value % 2)

func add(left: i64, right: i64) -> i64:
    return left + right

func sum_to(value: i64) -> i64:
    if value == 0: return 0
    return value + sum_to(value - 1)

struct Cursor:
    var position: i64

    mutating func replace(self, value: i64 = 42):
        self = Cursor(position = value)

# mark: Executable proof =====================================================================

pub func answer() -> i64:
    if not order_is_preserved(): return 0
    if choose() != 42 or choose(offset = 1, value = 41) != 42: return 0

    let (half, remainder) = split(85)
    if half != 42 or remainder != 1: return 0

    let operation: func(i64, i64) -> i64 = add
    if operation(20, 22) != 42 or sum_to(6) * 2 != 42: return 0

    var cursor = Cursor(position = 0)
    cursor.replace()
    return cursor.position

pub func main(arguments: slice[str]) -> i32!:
    return 0i32 if answer() == 42 else 1i32
