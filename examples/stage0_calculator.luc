# A compact recursive-descent calculator adapted from luce-stage-0 to the
# current 1.0 surface: type functions have no `static` keyword, tuple bindings
# and values use parentheses, and the executable entry has the native
# `slice[str] -> i32` contract. It is self-contained so compiler progress is
# measured before standard-library availability.
#
# Source lineage:
# https://github.com/dymokomi/luce-stage-0/blob/d5b458355179c059ce9c506c37990612c2c8f68f/examples/calc/calc.luc

pub struct Scan:
    pub func skip_spaces(text: str, at: i64) -> i64:
        var here = at
        while here < len(text) and text[here] == ' ':
            here += 1
        return here

    pub func number(text: str, at: i64) -> (f64, i64)!:
        var stop = at
        while stop < len(text) and text[stop] >= '0' and text[stop] <= '9':
            stop += 1
        if stop == at:
            error("expected a number at position " + str(at))
        let digits = text[at..<stop]
        let parsed = parse_i64(digits) else error("not a number: " + digits)
        return (f64(parsed), stop)

pub struct Parse:
    # expression = term (("+" | "-") term)*
    pub func expression(text: str, at: i64) -> (f64, i64)!:
        var (value, stopped) = try Parse.term(text, at)
        var here = Scan.skip_spaces(text, stopped)
        while here < len(text) and (text[here] == '+' or text[here] == '-'):
            let operation = text[here]
            let (right, right_at) = try Parse.term(text, here + 1)
            match operation:
                '+': value += right
                _: value -= right
            stopped = right_at
            here = Scan.skip_spaces(text, stopped)
        return (value, stopped)

    # term = factor (("*" | "/") factor)*
    pub func term(text: str, at: i64) -> (f64, i64)!:
        var (value, stopped) = try Parse.factor(text, at)
        var here = Scan.skip_spaces(text, stopped)
        while here < len(text) and (text[here] == '*' or text[here] == '/'):
            let operation = text[here]
            let (right, right_at) = try Parse.factor(text, here + 1)
            match operation:
                '*': value *= right
                _: value /= right
            stopped = right_at
            here = Scan.skip_spaces(text, stopped)
        return (value, stopped)

    # factor = number | "(" expression ")" | "-" factor
    pub func factor(text: str, at: i64) -> (f64, i64)!:
        let here = Scan.skip_spaces(text, at)
        if here < len(text) and text[here] == '-':
            let (inner, stopped) = try Parse.factor(text, here + 1)
            return (-inner, stopped)
        if here < len(text) and text[here] == '(':
            let (inner, stopped) = try Parse.expression(text, here + 1)
            let close = Scan.skip_spaces(text, stopped)
            if close >= len(text) or text[close] != ')':
                error("expected ) at position " + str(close))
            return (inner, close + 1)
        return try Scan.number(text, here)

pub func evaluate(text: str) -> f64!:
    let (value, stopped) = try Parse.expression(text, 0)
    let rest = Scan.skip_spaces(text, stopped)
    if rest != len(text):
        error("unexpected character at position " + str(rest))
    return value

pub func answer() -> f64!: return try evaluate("2 + 3 * (10 - 4)")

pub func main(arguments: slice[str]) -> i32:
    let value = answer() catch failure: return 1
    return 0 if value == 20.0 else 2
