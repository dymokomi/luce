# A compact recursive-descent calculator adapted from luce-stage-0 to the
# current 1.0 surface: it scans explicit UTF-8 bytes rather than indexing a
# `str`, uses `u64` sequence indices, type functions have no `static` keyword,
# tuple bindings and values use parentheses, and the executable entry has the
# native `slice[str] -> i32` contract. It is self-contained so compiler
# progress is measured before standard-library availability.
#
# Source lineage:
# https://github.com/dymokomi/luce-stage-0/blob/d5b458355179c059ce9c506c37990612c2c8f68f/examples/calc/calc.luc

let parse_error: ErrorCode = ErrorCode.package(1)

pub struct Scan:
    pub func skip_spaces(text: bytes, at: u64) -> u64:
        var here = at
        while here < text.length and text[here] == 32u8:
            here += 1u64
        return here

    # `number` calls this only after proving the byte is an ASCII digit.
    func digit_value(value: u8) -> i64:
        match value:
            48u8: return 0
            49u8: return 1
            50u8: return 2
            51u8: return 3
            52u8: return 4
            53u8: return 5
            54u8: return 6
            55u8: return 7
            56u8: return 8
            _: return 9

    pub func number(text: bytes, at: u64) -> (i64, u64)!:
        var stop = at
        var value = 0
        while stop < text.length and text[stop] >= 48u8 and text[stop] <= 57u8:
            value = value * 10 + Scan.digit_value(text[stop])
            stop += 1u64
        if stop == at:
            error(parse_error, "expected a number")
        return (value, stop)

pub struct Parse:
    # expression = term (("+" | "-") term)*
    pub func expression(text: bytes, at: u64) -> (i64, u64)!:
        var (value, stopped) = try Parse.term(text, at)
        var here = Scan.skip_spaces(text, stopped)
        while here < text.length and (text[here] == 43u8 or text[here] == 45u8):
            let operation = text[here]
            let (right, right_at) = try Parse.term(text, here + 1u64)
            match operation:
                43u8: value += right
                _: value -= right
            stopped = right_at
            here = Scan.skip_spaces(text, stopped)
        return (value, stopped)

    # term = factor (("*" | "/") factor)*
    pub func term(text: bytes, at: u64) -> (i64, u64)!:
        var (value, stopped) = try Parse.factor(text, at)
        var here = Scan.skip_spaces(text, stopped)
        while here < text.length and (text[here] == 42u8 or text[here] == 47u8):
            let operation = text[here]
            let (right, right_at) = try Parse.factor(text, here + 1u64)
            match operation:
                42u8: value *= right
                _: value //= right
            stopped = right_at
            here = Scan.skip_spaces(text, stopped)
        return (value, stopped)

    # factor = number | "(" expression ")" | "-" factor
    pub func factor(text: bytes, at: u64) -> (i64, u64)!:
        let here = Scan.skip_spaces(text, at)
        if here < text.length and text[here] == 45u8:
            let (inner, stopped) = try Parse.factor(text, here + 1u64)
            return (-inner, stopped)
        if here < text.length and text[here] == 40u8:
            let (inner, stopped) = try Parse.expression(text, here + 1u64)
            let close = Scan.skip_spaces(text, stopped)
            if close >= text.length or text[close] != 41u8:
                error(parse_error, "expected closing parenthesis")
            return (inner, close + 1u64)
        return try Scan.number(text, here)

pub func evaluate(text: bytes) -> i64!:
    let (value, stopped) = try Parse.expression(text, 0u64)
    let rest = Scan.skip_spaces(text, stopped)
    if rest != text.length:
        error(parse_error, "unexpected character")
    return value

pub func answer() -> i64!: return try evaluate(b"2 + 3 * (10 - 4)")

pub func main(arguments: slice[str]) -> i32:
    let value = answer() catch failure: return 1
    return 0 if value == 20 else 2
