# A guided tour of Luce declarations, control flow, closures, and effects.

# mark: Data modeling --------------------------------------------------------

## The upper bound used by the examples below.
let default_limit: i64 = 100

let invalid_value: ErrorCode = ErrorCode.package(1)

type Predicate = func(i64) -> bool
type FileLoader = func(str) -> bytes! uses files

interface Transform[T]:
    func transform(self, value: T) -> T

interface Named:
    func name(self) -> str

## A value type that satisfies two explicit interfaces.
struct Offset implements Transform[i64], Named:
    let amount: i64

    func transform(self, value: i64) -> i64:
        return value + self.amount

    func name(self) -> str:
        return f"offset by {self.amount}"

## A value type whose method mutates its receiver.
struct Cursor:
    var position: u64

    mutating func advance(self, amount: u64 = 1):
        self.position += amount

## A payload enum is Luce's tagged-union form.
enum Decision[T]:
    accepted(value: T)
    rejected(reason: str)

    func value_or(self, fallback: T) -> T:
        match self:
            .accepted(value): return value
            .rejected(reason): return fallback

## A reference type with shared identity.
class Counter:
    var value: i64

    func init(self, start: i64 = 0):
        self.value = start

    func increment(self):
        self.value += 1

## A weak parent edge prevents an ownership cycle.
class TreeNode:
    var name: str
    let children: list[TreeNode]
    weak var parent: TreeNode? = none

    func init(self, name: str):
        self.name = name
        self.children = []

    func add(self, child: TreeNode):
        self.children.append(child)
        child.parent = self

    func deinit(self):
        self.children.clear()

# mark: Functions and control flow ------------------------------------------

# No modifier is needed for implementation that stays inside this module.
func within_limit(value: i64, limit: i64) -> bool:
    return value <= limit

func first[T](values: list[T]) -> T?:
    if len(values) == 0: return none
    return values[0]

func apply_twice[T: Transform[i64] & Named](transformer: T, value: i64) -> i64:
    return transformer.transform(transformer.transform(value))

func display_name(value: Named) -> str:
    return value.name()

func factorial(value: u64) -> u64:
    if value <= 1: return 1
    return value * factorial(value - 1)

func partition(values: list[i64], predicate: Predicate = (value: i64) => value >= 0) -> (list[i64], list[i64]):
    let accepted: list[i64] = []
    let rejected: list[i64] = []
    for value in values:
        if predicate(value):
            accepted.append(value)
        else:
            rejected.append(value)
    return (accepted, rejected)

func classify(value: i64) -> str:
    if value < 0: return "negative"
    elif value == 0: return "zero"
    else: return "positive"

func first_even(values: list[i64]) -> i64?:
    var index: u64 = 0
    while index < len(values):
        let value = values[index]
        index += 1
        if value < 0: continue
        if value % 2 == 0: return value
        if value > default_limit: break
    return none

func digit_value(c: char) -> u8?:
    match c:
        '0': return 0
        '1': return 1
        _: return none

func decide(value: i64) -> Decision[i64]:
    return .accepted(value: value) if value >= 0 else .rejected(reason: "negative")

func severity(score: i64) -> str:
    return match score:
        0 => "none"
        1 => "low"
        _ => "high"

func collection_example(values: list[i64]) -> (list[i64], map[str, i64]):
    let labels = {"first": values[0], "last": values[len(values) - 1]}
    let middle = values[1..<len(values) - 1]
    return (middle, labels)

func require_positive(value: i64) -> i64!:
    if value <= 0:
        error(invalid_value, "expected a positive integer")
    return value

# mark: Closures, workers, and effects --------------------------------------

func offsetter(offset: i64) -> func(i64) -> i64:
    return func [copy amount = offset] (value: i64) -> i64:
        return value + amount

func counter(start: i64) -> func() -> i64:
    var current = start
    return func () -> i64:
        current += 1
        return current

func renamer(owner: TreeNode) -> func(str) -> unit:
    return func [weak owner] (name: str):
        if let node = owner:
            node.name = name

func process(value: i64) -> i64:
    return value * 2

func process_now(value: i64) -> i64!:
    let work: task[i64] = spawn process(value)
    defer work.cancel()
    return try work.wait()

func read_text(path: str) -> str! uses files:
    return try files.read_text(path)

func load_or(path: str, fallback: str) -> str uses files:
    return read_text(path) catch failure:
        recover fallback

# mark: Tests and entry point ------------------------------------------------

test "binary digits are recognized":
    assert(digit_value('0') != none)
    assert(first([1, 2, 3]) != none)
    assert(severity(2) == "high")

pub func main(arguments: slice[str]) -> i32 uses terminal:
    let (accepted, rejected) = partition(
        [-2, 3, 5],
        predicate: (value) => value >= 0 and within_limit(value, default_limit),
    )
    let offset = Offset(amount: 10)
    let transformed = apply_twice[Offset](offset, accepted[0])
    let first_value = first[i64](accepted)
    let result = decide(transformed)
    let object = new Counter(start: result.value_or(fallback: 0))
    object.increment()

    let root = new TreeNode(name: "root")
    let rename = renamer(root)
    rename("renamed")

    let next = counter(0)
    print(f"{display_name(offset)}: {object.value}; next {next()}")
    print(f"accepted {len(accepted)}, rejected {len(rejected)}, first {first_value}")
    return 0
