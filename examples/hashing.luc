## Equality and hashing are compiler-derived structural protocols. A hash is
## useful only during one execution: programs compare equal values, never pin
## or persist the numeric code chosen by a compiler or backend.

# mark: Structural keys ========================================================================

struct Key:
    let namespace: str
    let number: i64
    let coordinates: array[i32, 2]

enum Selection:
    empty
    key(value: Key)

let invalid: ErrorCode = ErrorCode.package(7)

func same_hash[T: Equatable & Hashable](left: T, right: T) -> bool:
    return left == right and hash(left) == hash(right)

func fail() -> unit!:
    error(invalid, "invalid key")

func no_value(): return

func error_hashes_match() -> bool:
    var first = 0u64
    fail() catch failure:
        first = hash(failure)
        recover no_value()
    var second = 0u64
    fail() catch failure:
        second = hash(failure)
        recover no_value()
    return first == second and same_hash(invalid, invalid)

# mark: Executable contract ====================================================================

pub func answer() -> i64:
    let first = Key(namespace = "luce", number = 42, coordinates = [4i32, 2i32])
    let second = Key(namespace = "luce", number = 42, coordinates = [4i32, 2i32])
    if not same_hash(first, second): return 0
    if not same_hash(Selection.key(value = first), Selection.key(value = second)): return 0
    if not same_hash(Selection.empty, Selection.empty): return 0

    let present: Key? = first
    let also_present: Key? = second
    if not same_hash(present, also_present): return 0
    if not same_hash((first, 7u16), (second, 7u16)): return 0
    if not same_hash(1..<4, 1..<4): return 0
    if not same_hash(b"luce", b"luce"): return 0
    if not error_hashes_match(): return 0

    # IEEE equality makes signed zero equal, so their hashes must agree too.
    if not same_hash(0.0, -0.0): return 0
    return 42

pub func main(arguments: slice[str]) -> i32!:
    return 0 if answer() == 42 else 1
