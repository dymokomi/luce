# Executable raw-native boundary example. Declarations obtain their values
# from the C linker while ordinary Luce code observes value structs, not ABI
# byte layouts.
extern type NativeHandle = u64

extern blocking func read_count(handle: NativeHandle, out count: u64) -> i32
extern var native_status: i32

extern struct NativeTime:
    seconds: i64
    nanoseconds: i64

extern func clock_gettime(clock: i32, out value: NativeTime) -> i32
type NativeSignalHandler = cfunc(i32) -> unit
extern func signal(number: i32, handler: NativeSignalHandler?) -> NativeSignalHandler?

# Anonymous raw data pointers share the same nullable boundary adapter as
# named pointer handles while remaining a distinct HIR type.
extern struct NativeBuffer:
    base: foreign
    length: u64

extern func malloc(size: u64) -> foreign?
extern func free(value: foreign)
extern func writev(fd: i32, value: NativeBuffer, count: i32) -> i64
extern func strchr(value: str, character: i32) -> str
extern func memcmp(left: list[u8], right: list[u8], count: u64) -> i32

func receive_signal(number: i32):
    if number != 42i32: trap("wrong signal value")

pub func main(arguments: slice[str]) -> i32!:
    let (status, value) = clock_gettime(0i32)
    if status != 0: return 1
    if value.seconds <= 0: return 2
    if let memory = malloc(1u64):
        # A zero-length POSIX iovec does not dereference its base. The call
        # still proves `foreign?` narrowing, a bare input, and extern-struct
        # field packing against the host libc.
        let written = writev(1i32, NativeBuffer(memory, 0u64), 1i32)
        free(memory)
        if written != 0: return 3
    else: return 3
    # Lists lend their existing dense storage; the explicit count remains a
    # separate C argument, and no element packing or copy is involved.
    if memcmp([1u8, 2u8, 3u8], [1u8, 2u8, 4u8], 3u64) >= 0i32: return 4
    # `strchr` returns a borrowed pointer into its input. The C adapter keeps
    # the temporary NUL-terminated copy alive until the suffix has been
    # validated and copied into an independently owned Luce string.
    if strchr("alpha", 112i32) != "pha": return 5
    let handler: NativeSignalHandler = receive_signal
    # The second libc call returns the code pointer installed by the first.
    # Calling it proves an incoming cfunc remains opaque and callable.
    let initial = signal(1i32, handler)
    let previous = signal(1i32, handler)
    # Restore the inherited disposition before invoking our returned adapter.
    discard(signal(1i32, initial))
    if let returned = previous:
        returned(42i32)
        return 0
    return 6

# Context supplies the audited destination pointee; no target layout fact is
# asserted by this conversion.
func words(pointer: native_mut_ptr[u8]) -> native_mut_ptr[u64]:
    return native.rebind(pointer)

# Counts stay in elements and overlapping ranges have move semantics. The
# backend is solely responsible for turning this into a byte count.
func move_bytes(destination: native_mut_ptr[u8], source: native_ptr[u8], count: u64):
    native.move(destination, source, count)
