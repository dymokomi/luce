# Executable §§15–16 slice: an interface describes behavior, a nominal type
# opts in explicitly, and a constrained generic call specializes to the
# concrete method before canonical MIR.

# mark: Contract ============================================================================

interface Scorer:
    func score(self, bonus: i64) -> i64!

interface Value[T]:
    func get(self) -> T

# mark: Explicit conformance ================================================================

struct Reading implements Scorer:
    let value: i64

    pub func score(self, bonus: i64) -> i64:
        return self.value + bonus

# mark: Static generic use ==================================================================

func adjusted[T: Scorer](value: T, bonus: i64) -> i64!:
    return try value.score(bonus)

# mark: Generic nominal method ===============================================================

struct Scored[T: Scorer] implements Value[T]:
    let value: T

    pub func get(self) -> T:
        return self.value

    func adjusted(self, bonus: i64) -> i64!:
        return try adjusted(self.value, bonus)

# mark: Concrete generic conformance ========================================================

func erase(value: Scored[Reading]) -> Value[Reading]:
    return value

func read(value: Value[Reading]) -> i64:
    return value.get().value

pub func answer() -> i64:
    let scored = Scored(Reading(value = 40))
    let adjusted = scored.adjusted(2) catch failure: recover 0
    return adjusted if read(erase(scored)) == 40 else 0

pub func main(arguments: slice[str]) -> i32!:
    if answer() == 42:
        return 0
    return 1
