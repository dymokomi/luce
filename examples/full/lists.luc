## Runtime-backed lists keep reference identity while their element layout and
## growth policy remain invisible to source and canonical MIR.

# mark: Types ==============================================================================

struct Holder:
    let values: list[i64]

struct Snapshot:
    let values: slice[i64]

struct Cell:
    var value: i64

    mutating func add(self, amount: i64):
        self.value += amount

struct Node:
    let value: i64
    let children: list[Node]

enum OwnedPayload:
    values(items: list[i64])
    empty

struct InitializedLists:
    let values: list[i64]

    func init(self, fail: bool) -> unit!:
        self.values = [20, 22]
        if fail: error(iteration_failure, "initializer failed")

let iteration_failure: ErrorCode = ErrorCode.package(1)

# mark: Evaluation helpers =================================================================

func same_list(values: list[i64]) -> list[i64]:
    return values

func record(order: list[i64], value: i64) -> i64:
    order.append(value)
    return value

func select_list(order: list[i64], values: list[i64]) -> list[i64]:
    order.append(1)
    return values

func select_concat(order: list[i64], marker: i64, values: list[i64]) -> list[i64]:
    order.append(marker)
    return values

func select_index(order: list[i64]) -> u64:
    order.append(2)
    return 0u64

func select_end(order: list[i64]) -> u64:
    order.append(3)
    return 2u64

func select_value(order: list[i64]) -> i64:
    order.append(3)
    return 9

func keep_snapshot(values: slice[i64]) -> slice[i64]:
    return values

func make_escaping_slice() -> slice[i64]:
    let values: list[i64] = [20, 22]
    return values[0u64..]

func escaping_slice_answer() -> i64:
    let values = make_escaping_slice()
    return values[0u64] + values[1u64]

# A copied outer list must retain every managed element before the original
# owner is destroyed. This crosses a function boundary so a missing structural
# callback becomes an observable dangling inner handle.
func make_nested_copy() -> list[list[i64]]:
    let values: list[list[i64]] = [[20, 22]]
    return values.copy()

func nested_copy_answer() -> i64:
    let values = make_nested_copy()
    return values[0u64][0u64] + values[0u64][1u64]

func take_payload(value: OwnedPayload) -> list[i64]:
    return match value:
        .values(items) => items
        .empty => []

func payload_answer() -> i64:
    let values = take_payload(OwnedPayload.values(items = [20, 22]))
    return values[0u64] + values[1u64]

func initializer_failed() -> bool:
    let value = InitializedLists(true) catch failure: return true
    return false

func initializer_answer() -> i64:
    let value = InitializedLists(false) catch failure: return 0
    return value.values[0u64] + value.values[1u64] if initializer_failed() else 0

func fallible_identity(values: list[i64], fail: bool) -> list[i64]!:
    if fail: error(iteration_failure, "selection failed")
    return values

func fallible_selection(flag: bool) -> list[i64]!:
    return try (fallible_identity([20, 22], false) if flag else fallible_identity([1], false))

func fallible_answer() -> i64:
    let values = fallible_selection(true) catch failure: return 0
    return values[0u64] + values[1u64]

func first(values: list[i64]) -> i64:
    for value in values: return value
    return 0

func fail_iteration() -> unit!:
    error(iteration_failure, "iteration failed")

func propagate_iteration_failure(values: list[i64]) -> unit!:
    for value in values: try fail_iteration()

func ignore_failure():
    return

func append_deferred(values: list[i64], value: i64):
    values.append(value)

# mark: List behavior =======================================================================

func literal_order() -> i64:
    let order: list[i64] = []
    let values: list[i64] = [record(order, 4), record(order, 2)]
    return order[0u64] * 10 + order[1u64] if values.length == 2u64 else 0

func recursive_answer() -> i64:
    let children: list[Node] = []
    children.append(Node(value = 42, children = []))
    let root = Node(value = 0, children = children)
    return root.children[0u64].value

func aggregate_answer() -> i64:
    let cells: list[Cell] = [Cell(value = 1)]
    cells.append(Cell(value = 2))
    cells.append(Cell(value = 3))
    cells.append(Cell(value = 4))
    cells.append(Cell(value = 5))
    cells.append(Cell(value = 6))
    cells[5u64].add(36)
    return cells[5u64].value

func shape_answer() -> i64:
    let values: list[i64] = [2, 4]
    values.insert(0u64, 1)
    values.insert(2u64, 3)
    values.insert(values.length, 5)
    let removed = values.remove_at(1u64)
    values.reserve(32u64)
    let preserved = values.length == 4u64 and values[0u64] == 1 and values[1u64] == 3 and values[3u64] == 5
    values.clear()
    values.append(40)
    return removed + values[0u64] if preserved and values.length == 1u64 else 0

func aggregate_removal() -> i64:
    let values: list[Cell] = [Cell(value = 20), Cell(value = 22)]
    let removed = values.remove_at(0u64)
    return removed.value + values[0u64].value

func insertion_order() -> i64:
    let order: list[i64] = []
    let values: list[i64] = []
    select_list(order, values).insert(select_index(order), select_value(order))
    let sequence = order[0u64] * 100 + order[1u64] * 10 + order[2u64]
    return values[0u64] + 33 if sequence == 123 else 0

func copy_answer() -> i64:
    let source: list[Cell] = [Cell(value = 20)]
    let copied = source.copy()
    copied[0u64].add(2)
    copied.append(Cell(value = 1))

    # Collection storage is independent, while nested reference elements
    # retain their ordinary shared identity in a shallow copy.
    let nested: list[list[i64]] = [[20]]
    let nested_copy = nested.copy()
    nested_copy[0u64].append(22)
    let independent = source.length == 1u64 and copied.length == 2u64 and source is not copied
    let shallow = nested[0u64].length == 2u64
    return source[0u64].value + copied[0u64].value if independent and shallow else 0

func concat_answer() -> i64:
    let order: list[i64] = []
    let left: list[i64] = [20]
    let right: list[i64] = [22]
    let joined = select_concat(order, 1, left) + select_concat(order, 2, right)
    joined[0u64] = 1
    joined.append(19)

    # The result has fresh shape and value slots, in left-then-right order.
    let ordered = order[0u64] * 10 + order[1u64] == 12 and joined[1u64] == 22
    let independent = joined is not left and joined is not right and left[0u64] == 20 and right[0u64] == 22
    let scalar_copy = joined.length == 3u64 and left.length == 1u64 and right.length == 1u64

    let left_cells: list[Cell] = [Cell(value = 20)]
    let right_cells: list[Cell] = [Cell(value = 1)]
    let joined_cells = left_cells + right_cells
    joined_cells[0u64].add(2)
    let value_copy = left_cells[0u64].value == 20 and joined_cells[0u64].value == 22

    # Concatenation is shallow for reference elements: the outer slots are
    # independent, while the nested list retains its identity.
    let inner: list[i64] = [20]
    let nested_left: list[list[i64]] = [inner]
    let nested_right: list[list[i64]] = []
    let nested = nested_left + nested_right
    nested[0u64].append(22)
    let shallow = nested[0u64] is inner and inner[1u64] == 22

    let empty: list[i64] = []
    let prefixed = empty + right
    let empty_edge = prefixed.length == 1u64 and prefixed[0u64] == 22 and prefixed is not right
    let repeated = left + left
    let aliased_operands = repeated.length == 2u64 and repeated[0u64] == 20 and repeated[1u64] == 20 and repeated is not left
    return 42 if ordered and independent and scalar_copy and value_copy and shallow and empty_edge and aliased_operands else 0

func snapshot_answer() -> i64:
    let order: list[i64] = []
    let slots: list[i64] = [20, 22]
    let selected = select_list(order, slots)[select_index(order)..<select_end(order)]
    let slot_view = Snapshot(values = keep_snapshot(selected)).values
    slots[0u64] = 1

    let shape: list[i64] = [20, 22]
    let shape_view: slice[i64] = shape[0u64..]
    shape.clear()
    shape.append(1)

    let cells: list[Cell] = [Cell(value = 20)]
    let cell_view: slice[Cell] = cells[0u64..]
    cells[0u64].add(22)

    # Slicing is shallow: the outer list storage is frozen, while its nested
    # reference element continues to identify the same inner list.
    let nested: list[list[i64]] = [[20]]
    let nested_view = nested[0u64..]
    nested[0u64].append(22)
    let shared = nested_view[0u64]

    # The upper-only form also permits an empty snapshot at either boundary.
    let empty = slots[..<0u64]

    let slot_value = slot_view[0u64] + slot_view[1u64]
    let shape_value = shape_view[0u64] + shape_view[1u64]
    let evaluated_once = order[0u64] * 100 + order[1u64] * 10 + order[2u64] == 123
    let detached = slots[0u64] == 1 and shape.length == 1u64
    let aggregate_detached = cell_view[0u64].value == 20 and cells[0u64].value == 42
    let shallow = shared.length == 2u64 and shared[1u64] == 22
    return 42 if slot_value == 42 and shape_value == 42 and evaluated_once and detached and aggregate_detached and shallow and empty.length == 0u64 else 0

func iteration_answer() -> i64:
    let order: list[i64] = []
    let values: list[i64] = [20, 1]
    var total = 0
    var index = 0u64
    for value in select_list(order, values):
        # Capacity may change, but shape may not. The next slot is addressed
        # through the list identity again and therefore sees replacement.
        values.reserve(32u64)
        if index == 0u64: values[1u64] = 22
        total += value
        index += 1u64

    var nested_visits = 0
    for left in values:
        for right in values: nested_visits += 1

    let deferred: list[i64] = []
    for value in values:
        defer append_deferred(deferred, value)
        if value == 20: continue
        break

    # Mutating a referenced element does not alter the iterated outer shape.
    let inner: list[i64] = [20]
    let outer: list[list[i64]] = [inner]
    for item in outer: item.append(22)

    # Both structured exits release active traversal before later mutation.
    let broken: list[i64] = [20]
    for value in broken: break
    broken.append(22)
    let returned: list[i64] = [20]
    let early = first(returned)
    returned.append(22)

    let failed: list[i64] = [20]
    propagate_iteration_failure(failed) catch failure: recover ignore_failure()
    failed.append(22)

    let once = order.length == 1u64 and order[0u64] == 1
    let complete = total == 42 and nested_visits == 4 and inner.length == 2u64 and deferred[0u64] + deferred[1u64] == 42
    let released = broken.length == 2u64 and early + returned[1u64] == 42 and failed.length == 2u64
    return 42 if once and complete and released else 0

# mark: Structural equality ===================================================================

func self_cycle(value: i64) -> list[Node]:
    let root: list[Node] = []
    root.append(Node(value = value, children = root))
    return root

func two_cycle(first: i64, second: i64) -> list[Node]:
    let root: list[Node] = []
    let child: list[Node] = []
    root.append(Node(value = first, children = child))
    child.append(Node(value = second, children = root))
    return root

func chain(depth: i64) -> list[Node]:
    let root: list[Node] = []
    if depth > 0: root.append(Node(value = depth, children = chain(depth - 1)))
    return root

# Equality observes but never changes ownership. Tests that deliberately
# construct strong cycles sever them explicitly so ordinary ARC can reclaim
# every list afterward.
func sever_cycle(root: list[Node]):
    let child = root[0u64].children
    root.clear()
    child.clear()

func equality_answer() -> i64:
    let identity = self_cycle(1)
    let identity_equal = identity == identity
    sever_cycle(identity)

    let self_left = self_cycle(1)
    let self_right = self_cycle(1)
    let self_equal = self_left == self_right
    sever_cycle(self_left)
    sever_cycle(self_right)

    let different_left = self_cycle(1)
    let different_right = self_cycle(2)
    let different = different_left != different_right
    sever_cycle(different_left)
    sever_cycle(different_right)

    let deep_left = two_cycle(1, 2)
    let deep_right = two_cycle(1, 2)
    let deep_equal = deep_left == deep_right
    sever_cycle(deep_left)
    sever_cycle(deep_right)

    let deep_mismatch_left = two_cycle(1, 2)
    let deep_mismatch_right = two_cycle(1, 3)
    let deep_mismatch = deep_mismatch_left != deep_mismatch_right
    sever_cycle(deep_mismatch_left)
    sever_cycle(deep_mismatch_right)

    # Equality observes contents, not the alias topology used to reach equal
    # contents. One shared child and two independently equal children are
    # therefore structurally equal.
    let shared_child: list[Node] = [Node(value = 2, children = [])]
    let shared: list[Node] = [
        Node(value = 1, children = shared_child),
        Node(value = 1, children = shared_child),
    ]
    let copied: list[Node] = [
        Node(value = 1, children = [Node(value = 2, children = [])]),
        Node(value = 1, children = [Node(value = 2, children = [])]),
    ]
    let topology_independent = shared == copied
    let finite = [1, 2, 3] == [1, 2, 3] and [1, 2] != [1, 2, 3]
    # Six distinct list pairs force the opaque transaction beyond its initial
    # storage while remaining an ordinary acyclic ownership graph.
    let grown = chain(6) == chain(6) and chain(6) != chain(5)
    return 42 if identity_equal and self_equal and different and deep_equal and deep_mismatch and topology_independent and finite and grown else 0

# mark: Public entry points =================================================================

pub func answer() -> i64:
    let values: list[i64] = [1]
    let alias = same_list(values)
    alias.append(1)
    let holder = Holder(values = values)
    holder.values[0u64] += 40
    let scalar = alias[0u64] + values[1u64] if holder.values.length == 2u64 and alias is values else 0
    let complete = aggregate_answer() == 42 and literal_order() == 42 and recursive_answer() == 42 and payload_answer() == 42 and initializer_answer() == 42 and fallible_answer() == 42
    let shaped = shape_answer() == 42 and aggregate_removal() == 42 and insertion_order() == 42
    let copied = copy_answer() == 42 and nested_copy_answer() == 42
    let concatenated = concat_answer() == 42
    let snapshotted = snapshot_answer() == 42 and escaping_slice_answer() == 42
    let iterated = iteration_answer() == 42
    let compared = equality_answer() == 42
    return scalar if complete and shaped and copied and concatenated and snapshotted and iterated and compared else 0

pub func main(arguments: slice[str]) -> i32!:
    return 0 if answer() == 42 else 1
