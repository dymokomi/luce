# Synchronous C-callable values keep the same source-level indirect-call
# shape as ordinary functions. Conversion of a capture-free Luce function
# selects one generated C adapter; storage, selection, parameters and results
# remain ordinary typed values. No closure environment or dynamic foreign
# pointer is involved in this example.

type CBinary = cfunc(i32, i32) -> i32

struct CCalculator:
    let operation: CBinary

func add(left: i32, right: i32) -> i32: return left + right
func subtract(left: i32, right: i32) -> i32: return left - right

func choose(addition: bool) -> CBinary:
    return add if addition else subtract

func apply(operation: CBinary, left: i32, right: i32) -> i32:
    return operation(left, right)

pub func answer() -> i32:
    let calculator = CCalculator(operation = choose(false))
    let selected = calculator.operation(50i32, 8i32)
    return selected if apply(add, 20i32, 22i32) == 42i32 else 0i32

pub func main(arguments: slice[str]) -> i32!:
    return 0i32 if answer() == 42i32 else 1i32
