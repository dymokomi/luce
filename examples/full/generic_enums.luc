# Generic enums retain one declaration while every concrete application owns
# a fully substituted payload contract through HIR and canonical MIR.

# mark: Contract ============================================================================

interface Value[T]:
    func get(self, fallback: T) -> T

# mark: Generic sum type ====================================================================

enum Choice[T] implements Value[T]:
    empty
    one(value: T)
    pair(left: T, right: T)

    pub func get(self, fallback: T) -> T:
        match self:
            .empty: return fallback
            .one(value): return value
            .pair(left, right): return left

    mutating func replace(self, value: T):
        self = .one(value)

# mark: Concrete applications and existential dispatch =====================================

func erase(value: Choice[i64]) -> Value[i64]:
    return value

func right_first() -> i64:
    print("right")
    return 2

func left_second() -> i64:
    print("left")
    return 40

pub func answer() -> i64:
    # Named payloads evaluate in source order even though storage follows the
    # declaration order `left, right`.
    var number = Choice.pair(right = right_first(), left = left_second())
    let word = Choice.one("luce")
    let empty = Choice.empty[i64]()
    let selected = erase(number).get(0)
    number.replace(selected + empty.get(2))
    if word.get("") != "luce":
        return 0
    return number.get(0)

pub func main(arguments: slice[str]) -> i32!:
    if answer() == 42:
        return 0
    return 1
