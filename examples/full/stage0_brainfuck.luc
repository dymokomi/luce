# An allocation-free adaptation of the Stage-0 Brainfuck interpreter. The
# original uses runtime-sized arrays and a string builder; this version makes
# the program's fixed tape and expected output capacities explicit while
# preserving the interpreter loop, bracket search and wrapping u8 cells.
#
# Source lineage:
# https://github.com/dymokomi/luce-stage-0/blob/d5b458355179c059ce9c506c37990612c2c8f68f/examples/bf/bf.luc

pub type Tape = array[u8, 30]
pub type Output = array[u8, 13]

pub struct Execution:
    pub let output: Output
    pub let length: u64

func matching_forward(code: bytes, instruction: u64) -> u64:
    var depth = 1u64
    var at = instruction
    while depth > 0u64:
        at += 1u64
        if code[at] == 91u8:
            depth += 1u64
        elif code[at] == 93u8:
            depth -= 1u64
    return at

func matching_backward(code: bytes, instruction: u64) -> u64:
    var depth = 1u64
    var at = instruction
    while depth > 0u64:
        at -= 1u64
        if code[at] == 93u8:
            depth += 1u64
        elif code[at] == 91u8:
            depth -= 1u64
    return at

pub func interpret(code: bytes) -> Execution:
    var tape: Tape = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var output: Output = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    var pointer = 0u64
    var instruction = 0u64
    var written = 0u64
    while instruction < code.length:
        let here = instruction
        instruction += 1u64
        match code[here]:
            62u8: pointer += 1u64
            60u8: pointer -= 1u64
            43u8:
                if tape[pointer] == 255u8:
                    tape[pointer] = 0u8
                else:
                    tape[pointer] += 1u8
            45u8:
                if tape[pointer] == 0u8:
                    tape[pointer] = 255u8
                else:
                    tape[pointer] -= 1u8
            46u8:
                output[written] = tape[pointer]
                written += 1u64
            91u8:
                if tape[pointer] == 0u8:
                    instruction = matching_forward(code, here) + 1u64
            93u8:
                if tape[pointer] != 0u8:
                    instruction = matching_backward(code, here) + 1u64
            _: continue
    return Execution(output = output, length = written)

pub func answer() -> i64:
    let program = b"++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."
    let expected: Output = [72u8, 101u8, 108u8, 108u8, 111u8, 32u8, 87u8,
        111u8, 114u8, 108u8, 100u8, 33u8, 10u8]
    let execution = interpret(program)
    return 42 if execution.length == expected.length and execution.output == expected else 0

pub func main(arguments: slice[str]) -> i32!:
    return 0 if answer() == 42 else 1
