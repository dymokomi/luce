## Checked numeric construction uses one source spelling and one semantic
## policy across integer domains and IEEE floating-point widths.

import src.standard.math as math

# mark: Numeric construction ==================================================================

func narrow(value: f64) -> f32:
    return f32(value)

func half(value: f64) -> f16:
    return f16(value)

func widen(value: f32) -> f64:
    return f64(value)

func truncate(value: f64) -> i64:
    return i64(value)

pub func answer() -> i64:
    # Context and explicit construction produce the same binary32 value.
    let contextual: f32 = 0.1
    let rounded = narrow(0.1)
    if widen(contextual) != widen(rounded): return 0

    # Integer conversion and arithmetic round at the binary32 operation.
    let large = f32(16777217u32)
    let sum: f32 = 16777216.0 + 1.0
    if widen(large) != 16777216.0 or widen(sum) != 16777216.0: return 0

    # Named IEEE values live in ordinary width-explicit standard-library
    # constants, and survive every floating-width conversion.
    let infinity = math.positive_infinity_f64
    if widen(narrow(infinity)) != infinity: return 0
    if f64(math.positive_infinity_f16) != infinity: return 0
    if f64(math.positive_infinity_f32) != infinity: return 0
    if f64(math.negative_infinity_f16) != math.negative_infinity_f64: return 0
    if f64(math.negative_infinity_f32) != math.negative_infinity_f64: return 0
    if math.nan_f16 == math.nan_f16: return 0
    if math.nan_f32 == math.nan_f32: return 0
    if math.nan_f64 == math.nan_f64: return 0
    let not_a_number = narrow(math.nan_f64)
    if not_a_number == not_a_number: return 0

    # Binary16 is a semantic width even though the artifact backends carry it
    # in wider registers. Literals, construction, arithmetic, and two-byte
    # aggregate storage all round to IEEE binary16.
    let tenth: f16 = 0.1
    let fifth = half(0.2)
    let half_sum: f16 = tenth + fifth
    if f32(tenth) != 0.0999755859375f32: return 0
    if f32(half_sum) != 0.2998046875f32: return 0
    if f32(half(65519.0)) != 65504.0f32: return 0
    # Demoting this binary64 value through binary32 would choose the lower
    # neighbor; direct binary16 rounding must choose the upper neighbor.
    if f32(half(1.0004883110523224)) != 1.0009765625f32: return 0
    let halves: array[f16, 3] = [1.0, 2.0, 39.0]
    if i64(halves[0u64] + halves[1u64] + halves[2u64]) != 42: return 0

    # Float-to-integer construction truncates toward zero after its range check.
    if truncate(-42.75) != -42: return 0
    return 42

pub func main(arguments: slice[str]) -> i32!:
    if answer() == 42: return 0
    return 1
