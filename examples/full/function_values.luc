# Exact ordinary function values: named functions become values, retain their
# static parameter/result contract through aliases, fields, arguments and
# results, and call positionally. Managed anonymous functions and their
# environments have their own end-to-end example in `closures.luc`.

type Binary = func(i64, i64) -> i64

struct Calculator:
    let operation: Binary

func add(left: i64, right: i64) -> i64: return left + right
func subtract(left: i64, right: i64) -> i64: return left - right

func choose(addition: bool) -> Binary:
    return add if addition else subtract

func apply(operation: Binary, left: i64, right: i64) -> i64:
    return operation(left, right)

let invalid: ErrorCode = ErrorCode.package(1)

func checked(value: i64) -> i64!:
    if value < 0: error(invalid, "negative value")
    return value

pub func answer() -> i64:
    let default_operation: Binary = add
    let calculator = Calculator(operation = choose(false))
    let selected = calculator.operation(50, 8)
    let applied = apply(default_operation, 20, 22)
    let fallible: func(i64) -> i64! = checked
    let validated = fallible(42) catch failure: return 0
    return selected if applied == validated else 0

pub func main(arguments: slice[str]) -> i32!:
    return 0 if answer() == 42 else 1
