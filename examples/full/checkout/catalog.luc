pub type Cents = u64

## One product exposed by the catalog module.
pub struct Product:
    pub let sku: str
    pub let name: str
    pub let price_cents: Cents

# Constructor policy stays private to this module.
pub func product(sku: str, name: str, price_cents: Cents) -> Product:
    return Product(sku = sku, name = name, price_cents = price_cents)

pub func sample_catalog() -> list[Product]:
    return [
        product("keyboard", "Mechanical keyboard", 12900),
        product("display", "Studio display", 79900),
        product("cable", "USB-C cable", 1900),
    ]

pub func find_product(products: list[Product], sku: str) -> Product?:
    for candidate in products:
        if candidate.sku == sku: return candidate
    return none
