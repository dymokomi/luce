# Formatted strings are one target-neutral Display protocol. Builtin values,
# concrete conformers, constrained generics, and existential values all append
# into the same linear owned builder before QBE or Wasm chooses a layout.

# mark: Display model ========================================================================

struct Point implements Display:
    let x: i64
    let y: i64

    pub func display(self) -> str:
        return f"({self.x}, {self.y})"

func decorated[T: Display](value: T) -> str:
    return f"<{value}>"

func erased(value: Display) -> str:
    return f"[{value}]"

# mark: Executable proof =====================================================================

pub func answer() -> i64:
    let point = Point(20, 22)
    let tenth32: f32 = 0.1
    let line = f"point={point}, generic={decorated(point)}, dynamic={erased(point)}"
    let scalars = f"{-9223372036854775807 - 1}|{18446744073709551615u64}|{true}|{'λ'}|{0.1}|{tenth32}"
    let block = f"""
        value {point}
          {{nested}}
        """
    if line != "point=(20, 22), generic=<(20, 22)>, dynamic=[(20, 22)]": return 0
    if scalars != "-9223372036854775808|18446744073709551615|true|λ|0.1|0.1": return 0
    if block != "value (20, 22)\n  {nested}": return 0
    return point.x + point.y

pub func main(arguments: slice[str]) -> i32!:
    if answer() != 42: return 1i32
    print(f"Luce: {Point(20, 22)}")
    return 0i32
