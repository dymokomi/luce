# Generic classes retain one declaration while each concrete application owns
# its substituted payload, specialized lifecycle, and nominal MIR identity.

# mark: Contract ============================================================================

interface Value[T]:
    func get(self) -> T

let invalid: ErrorCode = ErrorCode.package(1)

# mark: Generic shared identity ==============================================================

class Box[T] implements Value[T]:
    var value: T
    weak var peer: Box[T]?

    func init(self, value: T):
        self.value = value
        self.peer = none

    pub func get(self) -> T:
        return self.value

    func set(self, value: T):
        self.value = value

    func observe(self, peer: Box[T]):
        self.peer = peer

    func observed(self) -> T?:
        if let live = self.peer:
            return live.get()
        return none

    func deinit(self):
        return

class Checked[T]:
    let value: T

    func init(self, value: T, fail: bool) -> unit!:
        self.value = value
        if fail:
            error(invalid, "expected generic initializer failure")

    func get(self) -> T:
        return self.value

    func deinit(self):
        return

# mark: Concrete applications and existential dispatch =====================================

func erase(value: Box[i64]) -> Value[i64]:
    return value

func weak_lifetime() -> i64:
    let observer = new Box(2)
    if true:
        let temporary = new Box(40)
        observer.observe(temporary)
        let observed = observer.observed() else 0
        if observed != 40:
            return 0
    if let stale = observer.observed():
        return 0
    return observer.get()

func checked_construction() -> i64:
    let successful = new Checked(2, false) catch failure:
        return 0
    let unexpected = new Checked(99, true) catch failure:
        return successful.get()
    return unexpected.get()

pub func answer() -> i64:
    let number = new Box(20)
    number.set(40)
    let word = new Box[str]("luce")
    let contextual: Box[i64] = new Box(2)
    if word.get() != "luce":
        return 0
    if weak_lifetime() != 2 or checked_construction() != 2:
        return 0
    return erase(number).get() + contextual.get()

pub func main(arguments: slice[str]) -> i32!:
    if answer() == 42:
        return 0
    return 1
