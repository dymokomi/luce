## Fixed arrays convert explicitly to safe immutable slices. Because arrays
## live inline, the slice captures an owned value snapshot rather than a
## pointer into a local frame.

# mark: Scalar snapshot =======================================================================

func scalar_snapshot() -> slice[i64]:
    var values: array[i64, 4] = [1, 40, 2, 4]
    let view = values[1u64..<3u64]
    values[1u64] = 99
    return view

# mark: Managed-element snapshot ===============================================================

func managed_snapshot() -> slice[list[i64]]:
    let left: list[i64] = [20]
    let right: list[i64] = [22]
    let values: array[list[i64], 2] = [left, right]
    return values[0u64..<2u64]

pub func answer() -> i64:
    let scalars = scalar_snapshot()
    if scalars.length != 2u64 or scalars[0u64] + scalars[1u64] != 42: return 0

    # Reference elements remain shallow values, but the slice retains both
    # identities after the source array and its local bindings disappear.
    let managed = managed_snapshot()
    if managed.length != 2u64: return 0
    return managed[0u64][0u64] + managed[1u64][0u64]

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
