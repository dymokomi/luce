# Structured tasks preserve one target-independent source, HIR, and MIR shape.
# The native QBE backend realizes each task as an isolated process.

# mark: Sendable worker boundary -------------------------------------------------------------

func inspect(
    values: frozen_list[i32],
    table: frozen_map[str, i32],
    tags: frozen_set[str],
) -> frozen_list[i32]:
    if values.length != 2u64: return [0i32].snapshot()
    if not tags.contains("ready") or tags.contains("changed"): return [0i32].snapshot()
    let total = values[0u64] + values[1u64]
    if total != (table["answer"] else 0i32): return [0i32].snapshot()
    return [total].snapshot()

func identity(value: i32) -> i32: return value

# mark: Supervised lifetime and observation -------------------------------------------------

func compute() -> i32!:
    let source_values = [20i32, 22i32]
    let source_table = {"answer": 42i32}
    let source_tags = set[str]("ready")

    # Only immutable graphs cross a task boundary. Later mutation of the
    # mutable sources cannot alter the transferred snapshots.
    let inspection = spawn inspect(
        source_values.snapshot(),
        source_table.snapshot(),
        source_tags.snapshot(),
    )
    source_values[0u64] = 0i32
    source_table["answer"] = 0i32
    discard(source_tags.remove("ready"))
    discard(source_tags.insert("changed"))

    # `wait_all` preserves input order and observes every child. Waiting for
    # an already observed task reads the same cached result.
    let first = spawn identity(20i32)
    let second = spawn identity(22i32)
    let ordered = try wait_all([first, second])
    let repeated = try second.wait()
    let result = try inspection.wait()
    if ordered != [20i32, 22i32] or repeated != 22i32: return 0i32
    return result[0u64]

# mark: Product entries ---------------------------------------------------------------------

pub func answer() -> i32:
    return compute() catch failure: recover 0i32

pub func main(arguments: slice[str]) -> i32!:
    return 0i32 if answer() == 42 else 1i32
