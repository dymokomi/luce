# Existential interface values preserve value-copy semantics while class
# payloads retain shared identity. The fallible requirement is implemented by
# infallible methods, exercising the compiler-generated adaptation thunks.

interface Counter:
    mutating func increment(self) -> unit!
    func value(self) -> i32

let limit_reached: ErrorCode = ErrorCode.package(1)

interface Readable[T]:
    func read(self) -> T

interface Combiner:
    func combine(self, left: i32, right: i32) -> i32

struct Count implements Counter:
    var amount: i32

    pub mutating func increment(self):
        self.amount += 1

    pub func value(self) -> i32:
        return self.amount

class Shared implements Counter:
    var amount: i32

    pub func init(self, amount: i32):
        self.amount = amount

    pub func increment(self):
        self.amount += 1

    pub func value(self) -> i32:
        return self.amount

struct Limited implements Counter:
    var amount: i32

    pub mutating func increment(self) -> unit!:
        if self.amount == 4:
            error(limit_reached, "counter limit reached")
        self.amount += 1

    pub func value(self) -> i32:
        return self.amount

enum Choice implements Readable[i32]:
    selected

    pub func read(self) -> i32:
        return 6

struct Pair implements Combiner:
    pub func combine(self, left: i32, right: i32) -> i32:
        return left * 10i32 + right

func boxed_count() -> Counter:
    return Count(amount = 4)

func bumped_pair(value: Counter) -> i32!:
    let original = value
    var changed = original
    try changed.increment()
    return original.value() * 10 + changed.value()

pub func answer() -> i32:
    let counters: list[Counter] = [boxed_count()]
    let copied = bumped_pair(counters[0]) catch failure:
        recover 0
    let shared: Counter = new Shared(4)
    let aliased = bumped_pair(shared) catch failure:
        recover 0
    let rejected = bumped_pair(Limited(amount = 4)) catch failure:
        recover 42
    let readable: Readable[i32] = Choice.selected
    let combined: Combiner = Pair()
    return copied - aliased + rejected + readable.read() + combined.combine(right = 2i32, left = 4i32) - 38

pub func main(arguments: slice[str]) -> i32:
    return 0 if answer() == 42 else 1
