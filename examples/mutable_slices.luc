## A list can lend temporary mutable element access to one synchronous
## callback without exposing its storage layout or a general lifetime type.

# mark: Scoped algorithms =====================================================================

func fill[T](view: mutable_slice[T], replacement: T):
    var index = 0u64
    while index < view.length:
        view[index] = replacement
        index += 1u64

# mark: Snapshot and alias behavior ============================================================

pub func answer() -> i64:
    let values: list[i64] = [1, 2, 3]
    let alias = values
    let before: slice[i64] = values[0u64..]
    let during: list[slice[i64]] = []

    values.with_mutable_slice(func (view: mutable_slice[i64]):
        fill(view, 10)
        during.append(values[0u64..])
        view[1u64] = 20
    )

    let old_snapshot = before[0u64] == 1 and before[1u64] == 2 and before[2u64] == 3
    let callback_snapshot = during[0u64][0u64] == 10 and during[0u64][1u64] == 10 and during[0u64][2u64] == 10
    let shared_identity = alias[0u64] == 10 and alias[1u64] == 20 and alias[2u64] == 10
    return 42 if old_snapshot and callback_snapshot and shared_identity else 0

pub func main(arguments: slice[str]) -> i32:
    return 0i32 if answer() == 42 else 1i32
