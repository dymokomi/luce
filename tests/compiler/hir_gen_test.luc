#==============================================================================================
#
#   hir_gen_test - What HirGenerator accepts and rejects
#
#   DESCRIPTION:
#       Parsed fixtures in, typed programs (or stable diagnostics) out. The
#       helpers below run source through the tokenizer and parser so each test
#       reads as: modules in, expectation out.
#
#==============================================================================================

from luce.compiler.hir_gen import HirGenerator, SourceModule
from luce.compiler.parser import Parser
from luce.compiler.tokenizer import Tokenizer
from luce.compiler.hir import AssignmentOperation, BinaryOperation, BuiltinType, HirProgram, HirStatement
from luce.compiler.hir import SymbolKind, describe_type, resolve_builtin_type, types_match

# mark: Test helpers ========================================================================

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> HirProgram:
    let program = HirGenerator(sources).generate() catch reason:
        trap(reason)
    return program

pub func semantic_failure(sources: list[SourceModule]) -> str:
    let program = HirGenerator(sources).generate() catch reason:
        return reason
    return ""

# Require one return statement containing a binary expression whose operands
# are both canonical i32 values. Example: this accepts `return 5 * value` when
# `value` is i32, regardless of which side supplied the literal's context.
pub func assert_i32_binary_operands(statement: HirStatement):
    match statement.form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            match returned.form:
                Binary(left, operation, right):
                    assert(types_match(left.value_type, resolve_builtin_type(BuiltinType.signed_i32)))
                    assert(types_match(right.value_type, resolve_builtin_type(BuiltinType.signed_i32)))
                    return
                else: assert(false)
        else: assert(false)


# mark: Resolved typed HIR ==================================================================

pub func test_selective_imports_resolve_to_stable_function_symbols():
    let sources = [
        source_module("math", "pub func double(value: i64) -> i64: return value * 2\n"),
        source_module("main", "from math import double\nfunc answer() -> i64:\n    let value = double(21)\n    return value\n"),
    ]
    let program = checked(sources)
    assert(len(program.modules) == 2)
    assert(len(program.functions) == 2)
    assert(describe_type(program.types, program.functions[0].result) == "i64")
    let double_symbol = program.functions[0].symbol.value
    let answer = program.functions[1]
    assert(answer.module.value == program.modules[1].id.value)
    assert(len(answer.body) == 2)
    match answer.body[0].form:
        Binding(symbol, name, is_mutable, value):
            assert(name == "value")
            assert(not is_mutable)
            assert(types_match(value.value_type, resolve_builtin_type(BuiltinType.signed_i64)))
            match value.form:
                Call(function, arguments):
                    assert(function.value == double_symbol)
                    assert(arguments[0].parameter_index == 0)
                else: assert(false)
        else: assert(false)

pub func test_qualified_calls_resolve_public_members_and_named_arguments():
    let sources = [
        source_module("math", "pub func subtract(left: i64, right: i64) -> i64: return left - right\n"),
        source_module("main", "import math as arithmetic\nfunc answer() -> i64: return arithmetic.subtract(right: 1, left: 3)\n"),
    ]
    let program = checked(sources)
    match program.functions[1].body[0].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            match returned.form:
                Call(function, arguments):
                    assert(arguments[0].parameter_index == 1)
                    assert(arguments[1].parameter_index == 0)
                else: assert(false)
        else: assert(false)

pub func test_bindings_assignment_and_control_flow_are_typed():
    let source = "func update():\n    var value: i64 = 0\n    while value < 2:\n        value += 1\n        if value == 1: continue\n        break\n"
    let program = checked([source_module("main", source)])
    let body = program.functions[0].body
    assert(len(body) == 2)
    assert(str(body[0].form) == "Binding")
    match body[1].form:
        WhileStatement(condition, loop_body):
            assert(types_match(condition.value_type, resolve_builtin_type(BuiltinType.boolean)))
            match condition.form:
                Binary(left, operation, right):
                    match operation:
                        Less(operand_type): assert(types_match(operand_type, resolve_builtin_type(BuiltinType.signed_i64)))
                        else: assert(false)
                else: assert(false)
            match loop_body[0].form:
                Assignment(symbol, operation, value):
                    match operation:
                        Combine(binary):
                            match binary:
                                Add(operand_type): assert(types_match(operand_type, resolve_builtin_type(BuiltinType.signed_i64)))
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
            assert(str(loop_body[1].form) == "IfStatement")
            assert(str(loop_body[2].form) == "BreakStatement")
        else: assert(false)

pub func test_unsuffixed_integer_literals_receive_context_from_either_operand():
    let source = "func scale(value: (i32)) -> (i32): return 5 * value\nfunc equals(value: i32) -> bool: return 5 == value\n"
    let program = checked([source_module("main", source)])
    assert(len(program.functions) == 2)
    assert_i32_binary_operands(program.functions[0].body[0])
    assert_i32_binary_operands(program.functions[1].body[0])

pub func test_native_entry_print_is_typed_with_its_i32_result():
    let source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"Hello, world!\")\n    return 0\n"
    let program = checked([source_module("hello", source)])
    let function = program.functions[0]
    assert(describe_type(program.types, function.parameters[0].value_type) == "slice[str]")
    assert(types_match(function.result, resolve_builtin_type(BuiltinType.signed_i32)))
    match function.body[0].form:
        PrintText(value): assert(value == "Hello, world!")
        else: assert(false)
    match function.body[1].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            assert(types_match(returned.value_type, resolve_builtin_type(BuiltinType.signed_i32)))
        else: assert(false)

pub func test_hir_owns_canonical_type_and_symbol_tables():
    let source = "func identity(value: i64) -> i64:\n    let copy = value\n    return copy\n"
    let program = checked([source_module("main", source)])

    assert(len(program.types.definitions) == 16)
    match program.types.definitions[6].form:
        Slice(element): assert(types_match(element, resolve_builtin_type(BuiltinType.string)))
        else: assert(false)

    # Signature collection creates the parameter and function; body checking
    # then adds the local. Each resolved reference uses these identities.
    assert(len(program.symbols) == 3)
    assert(program.symbols[0].kind == SymbolKind.parameter)
    assert(program.symbols[1].kind == SymbolKind.function)
    assert(program.symbols[2].kind == SymbolKind.local)
    assert(program.functions[0].symbol.value == program.symbols[1].id.value)
    match program.functions[0].body[0].form:
        Binding(symbol, name, is_mutable, value):
            assert(symbol.value == program.symbols[2].id.value)
            match value.form:
                Reference(reference): assert(reference.value == program.symbols[0].id.value)
                else: assert(false)
        else: assert(false)

# mark: Module and name diagnostics =========================================================

pub func test_private_and_missing_imports_are_rejected():
    let private_sources = [
        source_module("math", "func hidden() -> i64: return 1\n"),
        source_module("main", "from math import hidden\nfunc answer() -> i64: return hidden()\n"),
    ]
    assert(semantic_failure(private_sources) == "main.luc:1:18: `hidden` is private to module `math`")
    assert(semantic_failure([source_module("main", "import missing\nfunc answer() -> i64: return 0\n")]) == "main.luc:1:8: unknown module `missing`")

pub func test_duplicate_modules_declarations_and_parameters_are_rejected():
    let empty = ""
    assert(semantic_failure([source_module("same", empty), source_module("same", empty)]) == "same.luc:1:1: duplicate module `same`")
    assert(semantic_failure([source_module("main", "func value(): return\nfunc value(): return\n")]) == "main.luc:2:1: duplicate declaration `value`")
    assert(semantic_failure([source_module("main", "func value(item: i64, item: i64): return\n")]) == "main.luc:1:23: duplicate parameter `item`")

# A module-level `mutating func` never reaches HirGenerator: the parser rejects
# it (see parser_test), so only the class-method case is semantic.
pub func test_mutating_is_restricted_to_value_type_methods_and_requirements():
    let class_method = "class Counter:\n    mutating func increment(self): return\n"
    assert(
        semantic_failure([source_module("main", class_method)])
        == "main.luc:2:5: class methods do not use `mutating`; class identity already permits field mutation"
    )

pub func test_unknown_names_and_import_collisions_are_rejected():
    assert(semantic_failure([source_module("main", "func answer() -> i64: return missing\n")]) == "main.luc:1:30: unknown name `missing`")
    let sources = [
        source_module("math", "pub func answer() -> i64: return 42\n"),
        source_module("main", "from math import answer\nfunc answer() -> i64: return 0\n"),
    ]
    assert(semantic_failure(sources) == "main.luc:1:18: imported name `answer` conflicts with a declaration")


# mark: Type and control-flow diagnostics ===================================================

pub func test_call_and_return_types_are_checked():
    let call_sources = [
        source_module("logic", "pub func choose(value: bool) -> bool: return value\n"),
        source_module("main", "from logic import choose\nfunc answer() -> bool: return choose(1)\n"),
    ]
    assert(semantic_failure(call_sources) == "main.luc:2:38: expected `bool`, found `i64`")
    assert(semantic_failure([source_module("main", "func answer() -> bool: return 1\n")]) == "main.luc:1:31: expected `bool`, found `i64`")

pub func test_immutable_assignment_and_non_boolean_conditions_are_rejected():
    let immutable = "func update():\n    let value = 1\n    value = 2\n"
    assert(semantic_failure([source_module("main", immutable)]) == "main.luc:3:5: cannot assign to immutable binding `value`; declare it with `var`")
    let condition = "func choose() -> i64:\n    if 1: return 1\n    return 0\n"
    assert(semantic_failure([source_module("main", condition)]) == "main.luc:2:8: expected `bool`, found `i64`")

pub func test_non_unit_functions_must_return_on_every_path():
    let source = "func choose(flag: bool) -> i64:\n    if flag: return 1\n"
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:1: function `choose` may finish without returning `i64`")
    let complete = "func choose(flag: bool) -> i64:\n    if flag: return 1\n    else: return 0\n"
    assert(semantic_failure([source_module("main", complete)]) == "")

pub func test_literals_are_decoded_and_range_checked():
    let program = checked([source_module("main", "func value() -> i64: return -9223372036854775808\n")])
    match program.functions[0].body[0].form:
        ReturnStatement(value):
            let returned = value else trap("expected a value")
            match returned.form:
                Constant(constant):
                    match constant:
                        Integer(item): assert(item == -9223372036854775807 - 1)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    let outside = "func value() -> i64: return 9223372036854775808\n"
    assert(semantic_failure([source_module("main", outside)]) == "main.luc:1:29: integer literal is outside the representable integer range")

pub func test_extern_declarations_are_refused_explicitly():
    let extern_source = "extern var version: i32\n"
    assert(semantic_failure([source_module("main", extern_source)]) == "main.luc:1:1: extern variable declarations are not implemented yet")
    let extern_function = "extern func probe() -> i32\n"
    assert(semantic_failure([source_module("main", extern_function)]) == "main.luc:1:1: extern function declarations are not implemented yet")
    let else_source = "func value(input: i64) -> i64: return input else 0\n"
    assert(semantic_failure([source_module("main", else_source)]) == "main.luc:1:39: `else` requires an optional value, found `i64`")

# mark: Types and literals ==================================================================

pub func test_scalar_types_and_literal_suffixes_are_typed():
    let source = "func value() -> u8: return 7u8\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "u8")
    assert(semantic_failure([source_module("main", "func value() -> u8: return 300u8\n")]) == "main.luc:1:28: integer literal is outside `u8` range")
    assert(semantic_failure([source_module("main", "func value() -> f16: return 1.0\n")]) == "main.luc:1:17: type `f16` is not implemented yet")
    assert(semantic_failure([source_module("main", "func value() -> never: return\n")]) == "main.luc:1:17: type `never` is not implemented yet")
    assert(semantic_failure([source_module("main", "func value() -> u64: return 18446744073709551615u64\n")]) == "main.luc:1:29: integer literal is outside the representable integer range")

pub func test_string_char_and_none_literals_are_typed():
    let source = "func label() -> str: return \"ok\"\nfunc mark() -> char: return 'A'\nfunc missing() -> i64?: return none\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "str")
    assert(describe_type(program.types, program.functions[1].result) == "char")
    assert(describe_type(program.types, program.functions[2].result) == "i64?")

pub func test_optional_and_unsigned_rules_are_enforced():
    let bare_none = "func value() -> i64:\n    let missing = none\n    return 1\n"
    assert(semantic_failure([source_module("main", bare_none)]) == "main.luc:2:19: `none` needs an optional type from context")
    let wrong_none = "func value() -> i64: return none\n"
    assert(semantic_failure([source_module("main", wrong_none)]) == "main.luc:1:29: expected `i64`, found `none`")
    let negate_unsigned = "func value() -> u8:\n    let v: u8 = 3\n    return -v\n"
    assert(semantic_failure([source_module("main", negate_unsigned)]) == "main.luc:3:12: `-` is invalid for `u8`")
    let negative_literal = "func value() -> u8: return -1\n"
    assert(semantic_failure([source_module("main", negative_literal)]) == "main.luc:1:28: `-` is invalid for `u8`")
    let implicit_wrap = "func value() -> i64?: return 4\n"
    assert(describe_type(checked([source_module("main", implicit_wrap)]).types, checked([source_module("main", implicit_wrap)]).functions[0].result) == "i64?")

# mark: Aliases, constants, tuples, and optionals ===========================================

pub func test_type_aliases_and_constants_are_module_names():
    let source = "type Count = i64\nlet answer: Count = 42\nfunc value() -> Count: return answer\n"
    let program = checked([source_module("main", source)])
    assert(len(program.constants) == 1)
    assert(program.constants[0].name == "answer")
    assert(describe_type(program.types, program.functions[0].result) == "i64")
    assert(semantic_failure([source_module("main", "type Count = Count\nfunc value() -> Count: return 1\n")]) == "main.luc:1:1: type alias `Count` is recursive")
    assert(semantic_failure([source_module("main", "let a = b\nlet b = 1\nfunc value() -> i64: return a\n")]) == "")
    let forward = checked([source_module("main", "let a = b\nlet b = 1\nfunc value() -> i64: return a\n")])
    assert(forward.constants[0].name == "a")
    assert(semantic_failure([source_module("main", "let a = a\nfunc value() -> i64: return a\n")]) == "main.luc:1:1: constant `a` is recursive")
    let imported = [
        source_module("lib", "pub func value() -> i64: return 7\n"),
        source_module("main", "import lib\nlet a = lib.value()\nfunc use() -> i64: return a\n"),
    ]
    assert(semantic_failure(imported) == "")
    assert(checked(imported).constants[0].name == "a")

pub func test_tuples_and_optional_else_are_typed():
    let source = "func pair() -> (i64, bool): return (1, true)\nfunc split() -> i64:\n    let (left, right) = pair()\n    return left\nfunc pick(flag: bool) -> i64:\n    var value: i64? = none\n    if flag: value = 3\n    return value else 0\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "(i64, bool)")
    assert(len(program.functions[1].body) == 4)

pub func test_tuple_bindings_point_diagnostics_at_the_offending_name():
    let duplicate = "func value() -> i64:\n    let (x, x) = (1, 2)\n    return x\n"
    assert(semantic_failure([source_module("main", duplicate)]) == "main.luc:2:13: `x` is already bound in this scope")
    let arity = "func value() -> i64:\n    let (a, b, c) = (1, 2)\n    return a\n"
    assert(semantic_failure([source_module("main", arity)]) == "main.luc:2:5: tuple binding has 3 name(s), value has 2")
    let not_tuple = "func value() -> i64:\n    let (a, b) = 1\n    return a\n"
    assert(semantic_failure([source_module("main", not_tuple)]) == "main.luc:2:5: tuple binding requires a tuple value, found `i64`")

pub func test_locals_cannot_shadow_imports():
    let sources = [
        source_module("lib", "pub func value() -> i64: return 1\n"),
        source_module("main", "from lib import value\nfunc use() -> i64:\n    let value = 2\n    return value\n"),
    ]
    assert(semantic_failure(sources) == "main.luc:3:9: local `value` cannot shadow an imported name")

# mark: Unimplemented forms =================================================================

pub func test_unimplemented_declarations_fail_by_name():
    assert(semantic_failure([source_module("main", "struct Point:\n    let x: i64\n")]) == "main.luc:1:1: struct types are not implemented yet")
    assert(semantic_failure([source_module("main", "class Counter:\n    pub func init(self):\n        return\n")]) == "main.luc:1:1: class types are not implemented yet")
    assert(semantic_failure([source_module("main", "enum Color:\n    red\n")]) == "main.luc:1:1: enum types are not implemented yet")
    assert(semantic_failure([source_module("main", "interface Named:\n    func name(self) -> str\n")]) == "main.luc:1:1: interfaces are not implemented yet")
    assert(semantic_failure([source_module("main", "test \"ok\":\n    return\n")]) == "main.luc:1:1: test declarations are not implemented yet")

pub func test_unimplemented_statements_and_expressions_fail_by_name():
    assert(semantic_failure([source_module("main", "func walk():\n    for item in items: return\n")]) == "main.luc:2:5: `for` is not implemented yet")
    assert(semantic_failure([source_module("main", "func choose(value: i64) -> i64:\n    match value:\n        1: return 1\n        _: return 0\n")]) == "main.luc:2:5: `match` is not implemented yet")
    assert(semantic_failure([source_module("main", "func work():\n    defer cleanup()\n    return\n")]) == "main.luc:2:5: `defer` is not implemented yet")
    assert(semantic_failure([source_module("main", "func value() -> i64: return [1, 2]\n")]) == "main.luc:1:29: list literals are not implemented yet")
    assert(semantic_failure([source_module("main", "func value() -> i64: return item.field\n")]) == "main.luc:1:29: field access is not implemented yet")
