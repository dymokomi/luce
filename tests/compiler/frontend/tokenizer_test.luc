#==============================================================================================
#
#   tokenizer_test - What the tokenizer accepts and rejects
#
#   DESCRIPTION:
#       Small source fixtures in, token streams (or stable diagnostics) out.
#       The sections mirror the tokenizer's own: layout, comments, numbers,
#       symbols, strings, and completion.
#
#==============================================================================================

from luce.compiler.frontend.tokenizer import Tokenizer, Token, TokenKind

# mark: Test helpers ========================================================================

# Tokenize successful fixtures. Returning an empty list makes an unexpected
# tokenizer failure turn into an ordinary assertion/index failure in the test.
pub func lex(source: str) -> list[Token]:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return list[Token]()
    return tokens

# Return the stable diagnostic for a rejected fixture, or an empty string when
# the fixture unexpectedly succeeds.
pub func failure(source: str) -> str:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return reason
    return ""

pub func fails(source: str) -> bool:
    return len(failure(source)) > 0

pub func count_kind(tokens: list[Token], kind: TokenKind) -> i64:
    var count = 0
    for token in tokens:
        if token.kind == kind:
            count += 1
    return count

pub func assert_token(token: Token, kind: TokenKind, text: str, line: i64, column: i64):
    assert(token.kind == kind)
    assert(token.text == text)
    assert(i64(token.span.line) == line)
    assert(i64(token.span.column) == column)


# mark: Basic tokens and names ==============================================================

pub func test_empty_source_emits_only_eof():
    let tokens = lex("")
    assert(len(tokens) == 1)
    assert_token(tokens[0], TokenKind.eof, "", 1, 1)

pub func test_token_positions_and_synthetic_newline():
    let tokens = lex("alpha + 20")
    assert_token(tokens[0], TokenKind.name, "alpha", 1, 1)
    assert(tokens[0].span.start == 0)
    assert(tokens[0].span.end == 5)
    assert_token(tokens[1], TokenKind.symbol, "+", 1, 7)
    assert_token(tokens[2], TokenKind.int_lit, "20", 1, 9)
    assert_token(tokens[3], TokenKind.newline, "", 1, 11)
    assert_token(tokens[4], TokenKind.eof, "", 1, 11)

pub func test_all_reserved_words_are_keywords():
    let source = "and as break catch class continue defer elif else enum export extern false for from func if implements import in interface is let match mutating new none not or pub recover return self spawn struct test true try type var weak while"
    let tokens = lex(source)
    assert(len(tokens) == 44)
    var i = 0
    while i < 42:
        assert(tokens[i].kind == TokenKind.keyword)
        i += 1
    assert(tokens[0].text == "and")
    assert(tokens[11].text == "extern")
    assert(tokens[41].text == "while")

# `extern` left this list when section 21.16 made it head declarations; the
# words that support it (`blocking`, `out`, `cfunc`) stay contextual.
pub func test_contextual_and_removed_words_remain_names():
    let tokens = lex("c cpp copy init deinit blocking out cfunc bool files private public static const alias union f r b uses")
    var i = 0
    while i < 20:
        assert(tokens[i].kind == TokenKind.name)
        i += 1

pub func test_names_allow_digits_and_leading_underscores():
    let tokens = lex("snake_case2 HttpClient _unused __private _1 _")
    assert_token(tokens[0], TokenKind.name, "snake_case2", 1, 1)
    assert_token(tokens[1], TokenKind.name, "HttpClient", 1, 13)
    assert_token(tokens[2], TokenKind.name, "_unused", 1, 24)
    assert_token(tokens[3], TokenKind.name, "__private", 1, 32)
    assert_token(tokens[4], TokenKind.name, "_1", 1, 42)
    assert_token(tokens[5], TokenKind.symbol, "_", 1, 45)

# mark: Layout and line handling ============================================================

pub func test_layout_opens_and_closes_nested_blocks():
    let tokens = lex("if a:\n    if b:\n        c\nd")
    assert(count_kind(tokens, TokenKind.indent) == 2)
    assert(count_kind(tokens, TokenKind.dedent) == 2)
    assert(count_kind(tokens, TokenKind.newline) == 4)
    assert(tokens[len(tokens) - 1].kind == TokenKind.eof)

pub func test_inline_suites_do_not_create_layout_tokens():
    let tokens = lex("if ready: return value\nelse: return none\n")
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 2)
    assert_token(tokens[2], TokenKind.symbol, ":", 1, 9)
    assert_token(tokens[3], TokenKind.keyword, "return", 1, 11)

pub func test_blank_and_comment_only_lines_do_not_affect_layout():
    let source = "if ready:\n    first\n      \n    # ordinary\n\n    ## documentation\n    second\nafter\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)
    assert_token(tokens[8], TokenKind.name, "second", 7, 5)
    assert_token(tokens[10], TokenKind.dedent, "", 8, 1)

pub func test_invalid_indentation_transitions_are_rejected():
    assert(fails("if a:\n  b\n"))
    assert(fails("if a:\n    b\n      c\n"))
    assert(fails("if a:\n    if b:\n        c\n  d\n"))

pub func test_raw_tabs_are_rejected_everywhere():
    assert(fails("if a:\n\tb\n"))
    assert(fails("left\tright"))
    assert(fails("# comment\ttext"))
    assert(fails("\"text\ttext\""))
    assert(not fails("\"text\\ttext\""))

pub func test_crlf_is_normalized_for_tokenization():
    let tokens = lex("first\r\nsecond\r\n")
    assert_token(tokens[0], TokenKind.name, "first", 1, 1)
    assert_token(tokens[1], TokenKind.newline, "", 1, 6)
    assert_token(tokens[2], TokenKind.name, "second", 2, 1)
    assert_token(tokens[3], TokenKind.newline, "", 2, 7)
    assert_token(tokens[4], TokenKind.eof, "", 3, 1)
    assert(fails("first\rsecond"))

# mark: Source text and comments ============================================================

pub func test_bom_is_allowed_only_at_source_start():
    let bom = str('\u{feff}')
    let tokens = lex(bom + "name")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(fails("name" + bom))

pub func test_nul_and_bidirectional_controls_are_rejected():
    assert(fails("left" + str('\u{0}') + "right"))
    assert(fails("# hidden " + str('\u{202e}')))
    assert(fails("\"hidden " + str('\u{2066}') + "\""))

pub func test_unicode_is_allowed_in_text_and_comments():
    let accent = str('\u{e9}')
    let tokens = lex("\"caf" + accent + "\" # caf" + accent + "\n")
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].text == "\"caf" + accent + "\"")
    let character_tokens = lex("'" + accent + "'")
    assert(character_tokens[0].kind == TokenKind.char_lit)

pub func test_comments_and_hash_characters_in_strings_are_distinct():
    let tokens = lex("name # mark: Scanner --------------------------------\n\"# text\"\n")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.str_lit, "\"# text\"", 2, 1)
    assert(tokens[3].kind == TokenKind.newline)

pub func test_documentation_comments_are_preserved_with_layout():
    let tokens = lex("struct Item:\n    ## Stored value.\n    let value: i64\n")
    assert(tokens[4].kind == TokenKind.indent)
    assert_token(tokens[5], TokenKind.doc_comment, "## Stored value.", 2, 5)
    assert(tokens[5].span.start == 17)
    assert(tokens[5].span.end == 33)
    assert_token(tokens[6], TokenKind.keyword, "let", 3, 5)

# mark: Numbers =============================================================================

pub func test_integer_literal_families_are_tokenized_whole():
    let tokens = lex("42 1_000_000 0xff 0o755 0b1010_1100 255u8 20i32")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.int_lit)
        i += 1
    assert(tokens[1].text == "1_000_000")
    assert(tokens[4].text == "0b1010_1100")
    assert(tokens[6].text == "20i32")
    assert(tokens[0].suffix == "")
    assert(tokens[5].suffix == "u8")
    assert(tokens[6].suffix == "i32")

pub func test_based_integer_prefixes_use_canonical_lowercase_spelling():
    assert(failure("0Xff") == "1:1: based integer prefixes must use lowercase `0x`, `0o`, or `0b`")
    assert(fails("0O77"))
    assert(fails("0B10"))

pub func test_float_literal_families_are_classified_as_float():
    let tokens = lex("1.0 6.022e23 1e-3 0.5f32 1_000.25 2f16 3f64")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.float_lit)
        i += 1
    assert(tokens[1].text == "6.022e23")
    assert(tokens[2].text == "1e-3")
    assert(tokens[5].text == "2f16")
    assert(tokens[0].suffix == "")
    assert(tokens[3].suffix == "f32")
    assert(tokens[5].suffix == "f16")

pub func test_malformed_numeric_spellings_are_rejected():
    assert(fails("1_"))
    assert(fails("1__0"))
    assert(fails("0x_ff"))
    assert(fails("0b102"))
    assert(fails("0o8"))
    assert(fails("0x"))
    assert(fails("1e+"))
    assert(fails("42u7"))
    assert(fails("1.0i32"))
    assert(not fails("0xffu8 1_000 1e1_0 2f16"))

pub func test_numbers_do_not_consume_member_or_range_dots():
    let tokens = lex("1.member 0..<10 1..=2 3..")
    assert(tokens[0].kind == TokenKind.int_lit)
    assert(tokens[1].text == ".")
    assert(tokens[2].text == "member")
    assert(tokens[4].text == "..<")
    assert(tokens[7].text == "..=")
    assert(tokens[10].text == "..")

# mark: Symbols and delimiters ==============================================================

pub func test_complete_symbol_surface_uses_longest_match():
    let source = "//= <<= >>= ..< ..= -> => == != <= >= // << >> += -= *= /= %= &= |= ^= .. + - * / % & | ^ ~ < > = : , . ? ! ( ) [ ] { } _"
    let expected: list[str] = ["//=", "<<=", ">>=", "..<", "..=", "->", "=>", "==", "!=", "<=", ">=", "//", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "..", "+", "-", "*", "/", "%", "&", "|", "^", "~", "<", ">", "=", ":", ",", ".", "?", "!", "(", ")", "[", "]", "{", "}", "_"]
    let tokens = lex(source)
    var i = 0
    while i < len(expected):
        assert(tokens[i].kind == TokenKind.symbol)
        assert(tokens[i].text == expected[i])
        i += 1

pub func test_match_ranges_and_alternatives_keep_distinct_tokens():
    let tokens = lex("'0'..='9', 'a'..<'z'\n")
    assert(tokens[0].kind == TokenKind.char_lit)
    assert(tokens[1].text == "..=")
    assert(tokens[2].kind == TokenKind.char_lit)
    assert(tokens[3].text == ",")
    assert(tokens[4].kind == TokenKind.char_lit)
    assert(tokens[5].text == "..<")
    assert(tokens[6].kind == TokenKind.char_lit)

pub func test_value_arrow_tokens_lambda_and_match_expressions():
    let source = "let above = (x) => x > 5\nlet digit = match c:\n    '0' => 0\n    _ => 1\n"
    let tokens = lex(source)
    var arrows = 0
    for token in tokens:
        if token.text == "=>": arrows += 1
    assert(arrows == 3)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)

pub func test_nested_delimiters_suspend_layout():
    let source = "value = (\n    [\n        {\"x\": 1}\n    ]\n)\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 1)

pub func test_unbalanced_delimiters_are_rejected():
    assert(fails(")"))
    assert(fails("(]"))
    assert(fails("([)]"))
    assert(fails("("))

# mark: String and character literals =======================================================

pub func test_string_and_character_literals_preserve_spelling():
    let tokens = lex("\"hello\\n\" 'A' '\\n' '\\u{1f600}'")
    assert_token(tokens[0], TokenKind.str_lit, "\"hello\\n\"", 1, 1)
    assert(tokens[1].kind == TokenKind.char_lit)
    assert(tokens[2].kind == TokenKind.char_lit)
    assert(tokens[3].kind == TokenKind.char_lit)
    assert(tokens[3].text == "'\\u{1f600}'")

pub func test_prefixed_literal_families_have_the_right_token_kind():
    let source = "\"hello\" r\"C:\\studio\\shots\" b\"\\x89PNG\" f\"x\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[1].kind == TokenKind.str_lit)
    assert(tokens[1].text == "r\"C:\\studio\\shots\"")
    assert(tokens[2].kind == TokenKind.byte_lit)
    assert(tokens[2].text == "b\"\\x89PNG\"")
    assert(tokens[3].kind == TokenKind.format_start)
    assert(tokens[4].kind == TokenKind.format_text)
    assert(tokens[5].kind == TokenKind.format_end)

# mark: Formatted strings ===================================================================

pub func test_formatted_strings_split_into_text_fields_and_delimiters():
    let tokens = lex("f\"frame {frame}: {status.name()}\"")
    assert_token(tokens[0], TokenKind.format_start, "f\"", 1, 1)
    assert_token(tokens[1], TokenKind.format_text, "frame ", 1, 3)
    assert_token(tokens[2], TokenKind.symbol, "{", 1, 9)
    assert_token(tokens[3], TokenKind.name, "frame", 1, 10)
    assert_token(tokens[4], TokenKind.symbol, "}", 1, 15)
    assert_token(tokens[5], TokenKind.format_text, ": ", 1, 16)
    assert_token(tokens[6], TokenKind.symbol, "{", 1, 18)
    assert_token(tokens[7], TokenKind.name, "status", 1, 19)
    assert_token(tokens[8], TokenKind.symbol, ".", 1, 25)
    assert_token(tokens[9], TokenKind.name, "name", 1, 26)
    assert_token(tokens[10], TokenKind.symbol, "(", 1, 30)
    assert_token(tokens[11], TokenKind.symbol, ")", 1, 31)
    assert_token(tokens[12], TokenKind.symbol, "}", 1, 32)
    assert_token(tokens[13], TokenKind.format_end, "\"", 1, 33)
    assert(tokens[14].kind == TokenKind.newline)
    assert(tokens[0].span.start == 0)
    assert(tokens[13].span.end == 33)

pub func test_formatted_strings_keep_brace_escapes_and_skip_empty_text():
    let tokens = lex("f\"{{value}} {a}{b}\" f\"\"")
    assert(tokens[1].text == "{{value}} ")
    assert(tokens[2].text == "{")
    assert(tokens[4].text == "}")
    assert(tokens[5].text == "{")
    assert(tokens[7].text == "}")
    assert(tokens[8].kind == TokenKind.format_end)
    assert(tokens[9].kind == TokenKind.format_start)
    assert(tokens[10].kind == TokenKind.format_end)
    assert(count_kind(tokens, TokenKind.format_text) == 1)

pub func test_formatted_strings_balance_fields_and_nested_literals():
    let tokens = lex("f\"{format(\"x\", {\"k\": 1})} {'}'} {f\"{inner}\"}\"")
    assert(count_kind(tokens, TokenKind.format_start) == 2)
    assert(count_kind(tokens, TokenKind.format_end) == 2)
    assert(count_kind(tokens, TokenKind.str_lit) == 2)
    assert(count_kind(tokens, TokenKind.char_lit) == 1)
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(fails("f\"{value\""))
    assert(failure("f\"{value") == "1:1: unterminated formatted string interpolation")
    assert(failure("f\"value }\"") == "1:1: unescaped '}' in formatted string")
    assert(fails("f\"{value))\""))
    assert(fails("f\"{(value}\""))

pub func test_triple_formatted_string_comments_need_a_later_field_close():
    let commented_close = "f\"\"\"{value # }\"\"\""
    assert(
        failure(commented_close)
        == "1:14: formatted string interpolation cannot close inside a comment; put `}` on a later line"
    )

    let close_after_comment = "f\"\"\"{value # note\n}\"\"\""
    assert(not fails(close_after_comment))

pub func test_triple_quoted_strings_span_physical_lines():
    let source = "\"\"\"first\nsecond\"\"\"\nafter"
    let tokens = lex(source)
    assert_token(tokens[0], TokenKind.str_lit, "\"\"\"first\nsecond\"\"\"", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.name, "after", 3, 1)

pub func test_prefixed_triple_strings_are_supported():
    let source = "r\"\"\"C:\\one\nC:\\two\"\"\" b\"\"\"PNG\"\"\" f\"\"\"value\n{x}\n\"\"\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].span.line == 1)
    assert(tokens[1].kind == TokenKind.byte_lit)
    assert(tokens[1].span.line == 2)
    assert_token(tokens[2], TokenKind.format_start, "f\"\"\"", 2, 22)
    assert_token(tokens[3], TokenKind.format_text, "value\n", 2, 26)
    assert_token(tokens[4], TokenKind.symbol, "{", 3, 1)
    assert_token(tokens[7], TokenKind.format_text, "\n", 3, 4)
    assert_token(tokens[8], TokenKind.format_end, "\"\"\"", 4, 1)
    assert(count_kind(tokens, TokenKind.newline) == 1)

pub func test_malformed_literal_boundaries_are_rejected():
    assert(fails("\"line\nnext\""))
    assert(fails("\"unterminated"))
    assert(fails("\"\"\"unterminated"))
    assert(fails("r\"unterminated"))
    assert(fails("''"))
    assert(fails("'ab'"))

pub func test_invalid_escapes_and_byte_source_are_rejected():
    assert(fails("\"\\q\""))
    assert(fails("\"\\x41\""))
    assert(fails("'\\u{110000}'"))
    assert(fails("'\\u{D800}'"))
    assert(fails("b\"\\x8\""))
    assert(fails("b\"" + str('\u{e9}') + "\""))
    assert(not fails("r\"\\q\""))

# mark: Completion and diagnostics ==========================================================

pub func test_eof_balances_layout_without_inventing_comment_lines():
    let comment_tokens = lex("# comment without newline")
    assert(len(comment_tokens) == 1)
    assert(comment_tokens[0].kind == TokenKind.eof)

    let block_tokens = lex("if ready:\n    run()")
    let n = len(block_tokens)
    assert(block_tokens[n - 3].kind == TokenKind.newline)
    assert(block_tokens[n - 2].kind == TokenKind.dedent)
    assert(block_tokens[n - 1].kind == TokenKind.eof)

pub func test_excluded_source_forms_are_rejected():
    assert(fails("left; right"))
    assert(fails("left \\\nright"))
    assert(fails("caf" + str('\u{e9}')))
    assert(fails(str('\u{0661}')))
    assert(fails("left" + str('\u{ff1b}') + "right"))

pub func test_diagnostic_reports_first_offending_position():
    assert(failure("first\n@") == "2:1: unexpected character")

# mark: Spec-rule edge cases ================================================================

pub func test_keywords_are_case_sensitive_and_whole_words():
    let tokens = lex("If IF while_ ifx _if")
    var i = 0
    while i < 5:
        assert(tokens[i].kind == TokenKind.name)
        i += 1

pub func test_whitespace_only_and_trailing_space_sources():
    let blank = lex("   \n\n  \n")
    assert(len(blank) == 1)
    assert(blank[0].kind == TokenKind.eof)
    let trailing = lex("name   \nnext")
    assert_token(trailing[1], TokenKind.newline, "", 1, 8)
    assert_token(trailing[2], TokenKind.name, "next", 2, 1)

pub func test_first_line_indentation_still_emits_indent_for_the_parser():
    let tokens = lex("    value\n")
    assert(tokens[0].kind == TokenKind.indent)
    assert(fails("  value\n"))

pub func test_documentation_comments_obey_indentation_rules():
    assert(fails("if a:\n      ## misaligned\n    b\n"))
    assert(not fails("if a:\n    b\n## top level\nc\n"))
    let tokens = lex("if a:\n    b\n## top level\nc\n")
    assert(tokens[7].kind == TokenKind.dedent)
    assert_token(tokens[8], TokenKind.doc_comment, "## top level", 3, 1)

pub func test_every_bidirectional_control_range_is_rejected():
    assert(fails("a" + str('\u{061c}')))
    assert(fails("a" + str('\u{200e}')))
    assert(fails("a" + str('\u{200f}')))
    assert(fails("a" + str('\u{202a}')))
    assert(fails("a" + str('\u{2069}')))
    assert(not fails("\"" + str('\u{2070}') + "\""))

pub func test_numeric_suffix_rules_cover_bases_floats_and_junk():
    assert(fails("42abc"))
    assert(fails("42u8x"))
    assert(fails("0o7f32"))
    assert(fails("0b1i7"))
    assert(fails("1e5f8"))
    let tokens = lex("1E5 0x1f32 7f32")
    assert(tokens[0].kind == TokenKind.float_lit)
    assert(tokens[1].kind == TokenKind.int_lit)
    assert(tokens[1].suffix == "")
    assert(tokens[2].kind == TokenKind.float_lit)
    assert(tokens[2].suffix == "f32")

pub func test_underscore_rules_apply_to_fraction_exponent_and_bases():
    assert(not fails("1.2_5"))
    assert(not fails("0b1_0 0o7_7 0xf_f"))
    assert(fails("1.5_"))
    assert(fails("1e_5"))
    assert(fails("0b_1"))

pub func test_all_simple_escapes_are_accepted_in_text_and_characters():
    assert(not fails("\"\\\\ \\\" \\' \\n \\r \\t \\0 \\u{41}\""))
    assert(not fails("'\\\\' '\\\"' '\\'' '\\0' '\\u{7f}'"))
    assert(fails("\"\\u{}\""))
    assert(fails("\"\\u{1234567}\""))
    assert(fails("\"\\u{41\""))
    assert(fails("\"\\u41\""))
    assert(fails("'\\x41'"))
    assert(fails("\"abc\\"))
    assert(fails("\"abc\\\nabc\""))

pub func test_byte_literals_take_two_digit_hex_escapes_only():
    assert(not fails("b\"\\x00\\xff\\xAb\""))
    assert(fails("b\"\\xfg\""))
    assert(fails("b\"\\x\""))
    assert(fails("b\"\\q\""))

pub func test_single_line_formatted_fields_stay_on_their_line():
    assert(failure("f\"{value\nmore}\"") == "1:1: formatted string interpolation cannot cross a line")
    assert(failure("f\"{value # }\"") == "1:1: formatted string interpolation cannot cross a line")
    assert(fails("f\"{{\"}}"))
    assert(fails("f\"{}\"") == false)
    assert(not fails("f\"\"\"{value # note\n+ 1}\"\"\""))
    assert(not fails("f\"\"\"{call(\n    1,\n)}\"\"\""))

pub func test_field_braces_nest_with_map_literals_and_report_mismatches():
    let tokens = lex("f\"{ {\"k\": v}[k] }\"")
    assert(tokens[1].text == "{")
    assert(tokens[2].text == "{")
    assert(tokens[6].text == "}")
    assert(tokens[10].text == "}")
    assert(tokens[11].kind == TokenKind.format_end)
    assert(fails("f\"{a]}\""))
    assert(fails("f\"{(a}\""))
    assert(fails("f\"{a}}\""))

pub func test_raw_strings_keep_backslashes_but_still_end_at_a_quote():
    let tokens = lex("r\"a\\\" b")
    assert(tokens[0].text == "r\"a\\\"")
    assert_token(tokens[1], TokenKind.name, "b", 1, 7)
    assert(fails("r\"\n\""))

pub func test_triple_quoted_strings_contain_lone_quotes_and_keep_columns():
    let source = "\"\"\"a\"b\"\"c\"\"\"\nnext"
    let tokens = lex(source)
    assert(tokens[0].text == "\"\"\"a\"b\"\"c\"\"\"")
    assert_token(tokens[2], TokenKind.name, "next", 2, 1)
    let multi = lex("x = \"\"\"one\ntwo\nthree\"\"\" + y\n")
    assert(multi[2].span.line == 1)
    assert_token(multi[3], TokenKind.symbol, "+", 3, 10)

pub func test_prefix_letters_without_a_quote_are_ordinary_names():
    let tokens = lex("f r b fr\"x\"")
    assert_token(tokens[0], TokenKind.name, "f", 1, 1)
    assert_token(tokens[1], TokenKind.name, "r", 1, 3)
    assert_token(tokens[2], TokenKind.name, "b", 1, 5)
    assert_token(tokens[3], TokenKind.name, "fr", 1, 7)
    assert(tokens[4].kind == TokenKind.str_lit)

pub func test_newlines_inside_delimiters_keep_line_numbers_for_spans():
    let tokens = lex("call(\n    first,\n    second)\nafter\n")
    assert_token(tokens[2], TokenKind.name, "first", 2, 5)
    assert_token(tokens[4], TokenKind.name, "second", 3, 5)
    assert_token(tokens[6], TokenKind.newline, "", 3, 12)
    assert_token(tokens[7], TokenKind.name, "after", 4, 1)

pub func test_comments_inside_delimiters_do_not_end_the_expression():
    let tokens = lex("call( # note\n    value)\n")
    assert(count_kind(tokens, TokenKind.newline) == 1)
    assert_token(tokens[2], TokenKind.name, "value", 2, 5)

pub func test_unexpected_characters_report_their_column():
    assert(failure("value $") == "1:7: unexpected character")
    assert(failure("a `b`") == "1:3: unexpected character")
    assert(fails("value\\"))

pub func test_spans_cover_exact_byte_ranges():
    let tokens = lex("ab 'c' \"de\" 0x1f")
    assert(tokens[1].span.start == 3)
    assert(tokens[1].span.end == 6)
    assert(tokens[2].span.start == 7)
    assert(tokens[2].span.end == 11)
    assert(tokens[3].span.start == 12)
    assert(tokens[3].span.end == 16)

# mark: Suites inside delimiters ============================================================

pub func test_colon_ending_a_line_inside_delimiters_opens_a_suite():
    let source = "run(func (view: Slice):\n    fill(view, 0)\n)\nafter\n"
    let tokens = lex(source)
    assert_token(tokens[9], TokenKind.newline, "", 1, 24)
    assert_token(tokens[10], TokenKind.indent, "", 2, 5)
    assert_token(tokens[11], TokenKind.name, "fill", 2, 5)
    assert_token(tokens[17], TokenKind.newline, "", 2, 18)
    assert_token(tokens[18], TokenKind.dedent, "", 3, 1)
    assert_token(tokens[19], TokenKind.symbol, ")", 3, 1)
    assert_token(tokens[20], TokenKind.newline, "", 3, 2)
    assert_token(tokens[21], TokenKind.name, "after", 4, 1)

pub func test_a_closing_delimiter_ends_the_suite_it_holds():
    let tokens = lex("run(func ():\n    return 1)\n")
    assert_token(tokens[10], TokenKind.newline, "", 2, 13)
    assert_token(tokens[11], TokenKind.dedent, "", 2, 13)
    assert_token(tokens[12], TokenKind.symbol, ")", 2, 13)
    assert(count_kind(tokens, TokenKind.newline) == 3)
    # Dedenting back to the opening line closes the suite; what follows up to
    # the delimiter is ordinary spacing-only source again.
    let trailing = lex("call(load() catch e:\n    recover 0\n, 2\n, 3)\n")
    assert(count_kind(trailing, TokenKind.newline) == 3)
    assert(count_kind(trailing, TokenKind.dedent) == 1)
    let nested = lex("func f():\n    run(func ():\n        g(\n1)\n        return 2\n    )\n    done()\n")
    assert(count_kind(nested, TokenKind.indent) == 2)
    assert(count_kind(nested, TokenKind.dedent) == 2)
    assert(count_kind(nested, TokenKind.newline) == 6)

pub func test_delimiter_suites_reject_bad_indentation():
    assert(fails("run(func ():\n  return 1\n)\n"))
    assert(fails("func f():\n    run(func ():\n        return 1\n)\n"))

pub func test_colons_not_ending_a_line_do_not_open_suites():
    let call = lex("run(label = 1, other = {\"k\": v})\n")
    assert(count_kind(call, TokenKind.indent) == 0)
    assert(count_kind(call, TokenKind.newline) == 1)
    let comment = lex("run(func (): # note\n    return 1\n)\n")
    assert(count_kind(comment, TokenKind.indent) == 1)
    let inline = lex("run(func (): return 1)\n")
    assert(count_kind(inline, TokenKind.indent) == 0)
    assert(count_kind(inline, TokenKind.newline) == 1)


# mark: Spec-rule remainder =================================================================

pub func test_a_trailing_dot_does_not_start_a_float():
    let dotted = lex("1.member")
    assert(dotted[0].kind == TokenKind.int_lit)
    assert(dotted[0].text == "1")
    assert(dotted[1].text == ".")
    assert(dotted[2].kind == TokenKind.name)
    let exponent = lex("1.e2")
    assert(exponent[0].kind == TokenKind.int_lit)
    assert(exponent[1].text == ".")
    assert(exponent[2].kind == TokenKind.name)
    assert(exponent[2].text == "e2")
    let leading = lex(".5")
    assert(leading[0].text == ".")
    assert(leading[1].kind == TokenKind.int_lit)
    assert(leading[1].text == "5")

pub func test_leading_zeros_are_decimal_unless_a_base_prefix_follows():
    let tokens = lex("0 00 08 0x0 0o0 0b0 0xffu32")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.int_lit)
        i += 1
    assert(tokens[2].text == "08")
    assert(tokens[3].text == "0x0")
    assert(tokens[6].text == "0xffu32")
    assert(tokens[6].suffix == "u32")
    assert(fails("1e"))
    assert(fails("1e+"))
    assert(fails("0x"))

pub func test_is_not_is_two_keywords_and_isnot_is_a_name():
    let tokens = lex("a is not b isnot c")
    assert_token(tokens[1], TokenKind.keyword, "is", 1, 3)
    assert_token(tokens[2], TokenKind.keyword, "not", 1, 6)
    assert_token(tokens[4], TokenKind.name, "isnot", 1, 12)

pub func test_floor_divide_is_not_a_comment():
    let tokens = lex("a // b # note\n")
    assert_token(tokens[1], TokenKind.symbol, "//", 1, 3)
    assert_token(tokens[2], TokenKind.name, "b", 1, 6)
    assert(tokens[3].kind == TokenKind.newline)

pub func test_hash_hash_is_documentation_only_at_line_start():
    let docs = lex("### extra\nlet x = 1 ## trailing\n")
    assert(docs[0].kind == TokenKind.doc_comment)
    assert(docs[0].text == "### extra")
    assert_token(docs[1], TokenKind.keyword, "let", 2, 1)
    assert(count_kind(docs, TokenKind.doc_comment) == 1)
    let eof_comment = lex("#")
    assert(len(eof_comment) == 1)
    assert(eof_comment[0].kind == TokenKind.eof)

pub func test_empty_string_families_are_tokens():
    let tokens = lex("\"\" b\"\" f\"\" \"\"\"\"\"\"\n")
    assert_token(tokens[0], TokenKind.str_lit, "\"\"", 1, 1)
    assert(tokens[1].kind == TokenKind.byte_lit)
    assert(tokens[1].text == "b\"\"")
    assert(tokens[2].kind == TokenKind.format_start)
    assert(tokens[3].kind == TokenKind.format_end)
    assert(tokens[4].kind == TokenKind.str_lit)
    assert(tokens[4].text == "\"\"\"\"\"\"")

pub func test_formatted_brace_escapes_stay_in_text():
    let tokens = lex("f\"{{x}} {y}\"")
    assert(tokens[0].kind == TokenKind.format_start)
    assert(tokens[1].kind == TokenKind.format_text)
    assert(tokens[1].text == "{{x}} ")
    assert(tokens[2].text == "{")
    assert(tokens[3].kind == TokenKind.name)
    assert(tokens[4].text == "}")
    assert(tokens[5].kind == TokenKind.format_end)
    assert(failure("f\"{a}\"") == "")
    assert(failure("f\"a}\"") == "1:1: unescaped '}' in formatted string")

pub func test_nested_formatted_strings_tokenize_as_ordinary_fields():
    let tokens = lex("f\"outer {f\"{inner}\"} end\"")
    assert(tokens[0].kind == TokenKind.format_start)
    assert(tokens[2].text == "{")
    assert(tokens[3].kind == TokenKind.format_start)
    assert(tokens[4].text == "{")
    assert_token(tokens[5], TokenKind.name, "inner", 1, 13)
    assert(tokens[6].text == "}")
    assert(tokens[7].kind == TokenKind.format_end)
    assert(tokens[8].text == "}")
    assert(tokens[10].kind == TokenKind.format_end)

pub func test_a_prefix_separated_from_its_quote_is_a_name():
    let tokens = lex("f \"x\" r \"y\" b \"z\"")
    assert(tokens[0].kind == TokenKind.name)
    assert(tokens[1].kind == TokenKind.str_lit)
    assert(tokens[2].kind == TokenKind.name)
    assert(tokens[4].kind == TokenKind.name)
    assert(tokens[5].kind == TokenKind.str_lit)

pub func test_adjacent_number_and_delimiter_stay_two_tokens():
    let tokens = lex("f(1)[2]{3}")
    assert(tokens[0].kind == TokenKind.name)
    assert(tokens[2].kind == TokenKind.int_lit)
    assert(tokens[2].text == "1")
    assert(tokens[5].kind == TokenKind.int_lit)
    assert(tokens[5].text == "2")
    assert(tokens[8].kind == TokenKind.int_lit)
    assert(tokens[8].text == "3")

pub func test_nested_blocks_dedent_more_than_one_level():
    let tokens = lex("if a:\n    if b:\n        c\nd\n")
    assert(count_kind(tokens, TokenKind.indent) == 2)
    assert(count_kind(tokens, TokenKind.dedent) == 2)
    assert_token(tokens[len(tokens) - 3], TokenKind.name, "d", 4, 1)

pub func test_nul_escape_is_source_text_not_a_nul_character():
    let tokens = lex("\"\\0\" '\\0'\n")
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].text == "\"\\0\"")
    assert(tokens[1].kind == TokenKind.char_lit)
    assert(not fails("\"\\0\""))
    assert(fails("\"" + str('\u{0}') + "\""))

pub func test_unclosed_character_and_quote_lookalikes_are_rejected():
    assert(failure("'a") == "1:1: unterminated character literal")
    assert(fails("'\n'"))
    assert(fails("left" + str('\u{2013}') + "right"))
    assert(fails("left" + str('\u{2212}') + "right"))
