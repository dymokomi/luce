#==============================================================================================
#
#   tokenizer_test - What the tokenizer accepts and rejects
#
#   DESCRIPTION:
#       Small source fixtures in, token streams (or stable diagnostics) out.
#       The sections mirror the tokenizer's own: layout, comments, numbers,
#       symbols, strings, and completion.
#
#       NOTE: Stage-0 discovers zero-argument `test_*` functions. Epoch 1
#       replaces this bootstrap convention with `test "description":`
#       declarations.
#
#==============================================================================================

from luce.compiler.tokenizer import Tokenizer, Token, TokenKind

# mark: Test helpers =========================================================================

# Tokenize successful fixtures. Returning an empty list makes an unexpected
# tokenizer failure turn into an ordinary assertion/index failure in the test.
pub func lex(source: str) -> list[Token]:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return list[Token]()
    return tokens

# Return the stable diagnostic for a rejected fixture, or an empty string when
# the fixture unexpectedly succeeds.
pub func failure(source: str) -> str:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return reason
    return ""

pub func fails(source: str) -> bool:
    return len(failure(source)) > 0

pub func count_kind(tokens: list[Token], kind: TokenKind) -> i64:
    var count = 0
    for token in tokens:
        if token.kind == kind:
            count += 1
    return count

pub func assert_token(token: Token, kind: TokenKind, text: str, line: i64, column: i64):
    assert(token.kind == kind)
    assert(token.text == text)
    assert(token.span.line == line)
    assert(token.span.column == column)


# mark: Basic tokens and names ===============================================================

pub func test_empty_source_emits_only_eof():
    let tokens = lex("")
    assert(len(tokens) == 1)
    assert_token(tokens[0], TokenKind.eof, "", 1, 1)

pub func test_token_positions_and_synthetic_newline():
    let tokens = lex("alpha + 20")
    assert_token(tokens[0], TokenKind.name, "alpha", 1, 1)
    assert(tokens[0].span.start == 0)
    assert(tokens[0].span.end == 5)
    assert_token(tokens[1], TokenKind.symbol, "+", 1, 7)
    assert_token(tokens[2], TokenKind.int_lit, "20", 1, 9)
    assert_token(tokens[3], TokenKind.newline, "", 1, 11)
    assert_token(tokens[4], TokenKind.eof, "", 1, 11)

pub func test_all_epoch_one_reserved_words_are_keywords():
    let source = "and as break catch class continue defer elif else enum export extern false for from func if implements import in interface is let match mutating new none not or pub recover return self spawn struct test true try type uses var weak while"
    let tokens = lex(source)
    assert(len(tokens) == 45)
    var i = 0
    while i < 43:
        assert(tokens[i].kind == TokenKind.keyword)
        i += 1
    assert(tokens[0].text == "and")
    assert(tokens[11].text == "extern")
    assert(tokens[42].text == "while")

# `extern` left this list when section 21.16 made it head declarations; the
# words that support it (`blocking`, `out`, `cfunc`) stay contextual.
pub func test_contextual_and_removed_words_remain_names():
    let tokens = lex("c cpp copy init deinit blocking out cfunc bool files private public static const alias union f r b")
    var i = 0
    while i < 19:
        assert(tokens[i].kind == TokenKind.name)
        i += 1

pub func test_names_allow_digits_and_leading_underscores():
    let tokens = lex("snake_case2 HttpClient _unused __private _1 _")
    assert_token(tokens[0], TokenKind.name, "snake_case2", 1, 1)
    assert_token(tokens[1], TokenKind.name, "HttpClient", 1, 13)
    assert_token(tokens[2], TokenKind.name, "_unused", 1, 24)
    assert_token(tokens[3], TokenKind.name, "__private", 1, 32)
    assert_token(tokens[4], TokenKind.name, "_1", 1, 42)
    assert_token(tokens[5], TokenKind.symbol, "_", 1, 45)

# mark: Layout and line handling =============================================================

pub func test_layout_opens_and_closes_nested_blocks():
    let tokens = lex("if a:\n    if b:\n        c\nd")
    assert(count_kind(tokens, TokenKind.indent) == 2)
    assert(count_kind(tokens, TokenKind.dedent) == 2)
    assert(count_kind(tokens, TokenKind.newline) == 4)
    assert(tokens[len(tokens) - 1].kind == TokenKind.eof)

pub func test_inline_suites_do_not_create_layout_tokens():
    let tokens = lex("if ready: return value\nelse: return none\n")
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 2)
    assert_token(tokens[2], TokenKind.symbol, ":", 1, 9)
    assert_token(tokens[3], TokenKind.keyword, "return", 1, 11)

pub func test_blank_and_comment_only_lines_do_not_affect_layout():
    let source = "if ready:\n    first\n      \n    # ordinary\n\n    ## documentation\n    second\nafter\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)
    assert_token(tokens[8], TokenKind.name, "second", 7, 5)
    assert_token(tokens[10], TokenKind.dedent, "", 8, 1)

pub func test_invalid_indentation_transitions_are_rejected():
    assert(fails("if a:\n  b\n"))
    assert(fails("if a:\n    b\n      c\n"))
    assert(fails("if a:\n    if b:\n        c\n  d\n"))

pub func test_raw_tabs_are_rejected_everywhere():
    assert(fails("if a:\n\tb\n"))
    assert(fails("left\tright"))
    assert(fails("# comment\ttext"))
    assert(fails("\"text\ttext\""))
    assert(not fails("\"text\\ttext\""))

pub func test_crlf_is_normalized_for_tokenization():
    let tokens = lex("first\r\nsecond\r\n")
    assert_token(tokens[0], TokenKind.name, "first", 1, 1)
    assert_token(tokens[1], TokenKind.newline, "", 1, 6)
    assert_token(tokens[2], TokenKind.name, "second", 2, 1)
    assert_token(tokens[3], TokenKind.newline, "", 2, 7)
    assert_token(tokens[4], TokenKind.eof, "", 3, 1)
    assert(fails("first\rsecond"))

# mark: Source text and comments =============================================================

pub func test_bom_is_allowed_only_at_source_start():
    let bom = str('\u{feff}')
    let tokens = lex(bom + "name")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(fails("name" + bom))

pub func test_nul_and_bidirectional_controls_are_rejected():
    assert(fails("left" + str('\u{0}') + "right"))
    assert(fails("# hidden " + str('\u{202e}')))
    assert(fails("\"hidden " + str('\u{2066}') + "\""))

pub func test_unicode_is_allowed_in_text_and_comments():
    let accent = str('\u{e9}')
    let tokens = lex("\"caf" + accent + "\" # caf" + accent + "\n")
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].text == "\"caf" + accent + "\"")
    let character_tokens = lex("'" + accent + "'")
    assert(character_tokens[0].kind == TokenKind.char_lit)

pub func test_comments_and_hash_characters_in_strings_are_distinct():
    let tokens = lex("name # mark: Scanner --------------------------------\n\"# text\"\n")
    assert_token(tokens[0], TokenKind.name, "name", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.str_lit, "\"# text\"", 2, 1)
    assert(tokens[3].kind == TokenKind.newline)

pub func test_documentation_comments_are_preserved_with_layout():
    let tokens = lex("struct Item:\n    ## Stored value.\n    let value: i64\n")
    assert(tokens[4].kind == TokenKind.indent)
    assert_token(tokens[5], TokenKind.doc_comment, "## Stored value.", 2, 5)
    assert(tokens[5].span.start == 17)
    assert(tokens[5].span.end == 33)
    assert_token(tokens[6], TokenKind.keyword, "let", 3, 5)

# mark: Numbers ==============================================================================

pub func test_integer_literal_families_are_tokenized_whole():
    let tokens = lex("42 1_000_000 0xff 0o755 0b1010_1100 255u8 20i32")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.int_lit)
        i += 1
    assert(tokens[1].text == "1_000_000")
    assert(tokens[4].text == "0b1010_1100")
    assert(tokens[6].text == "20i32")
    assert(tokens[0].suffix == "")
    assert(tokens[5].suffix == "u8")
    assert(tokens[6].suffix == "i32")

pub func test_based_integer_prefixes_use_canonical_lowercase_spelling():
    assert(failure("0Xff") == "1:1: based integer prefixes must use lowercase `0x`, `0o`, or `0b`")
    assert(fails("0O77"))
    assert(fails("0B10"))

pub func test_float_literal_families_are_classified_as_float():
    let tokens = lex("1.0 6.022e23 1e-3 0.5f32 1_000.25 2f16 3f64")
    var i = 0
    while i < 7:
        assert(tokens[i].kind == TokenKind.float_lit)
        i += 1
    assert(tokens[1].text == "6.022e23")
    assert(tokens[2].text == "1e-3")
    assert(tokens[5].text == "2f16")
    assert(tokens[0].suffix == "")
    assert(tokens[3].suffix == "f32")
    assert(tokens[5].suffix == "f16")

pub func test_malformed_numeric_spellings_are_rejected():
    assert(fails("1_"))
    assert(fails("1__0"))
    assert(fails("0x_ff"))
    assert(fails("0b102"))
    assert(fails("0o8"))
    assert(fails("0x"))
    assert(fails("1e+"))
    assert(fails("42u7"))
    assert(fails("1.0i32"))
    assert(not fails("0xffu8 1_000 1e1_0 2f16"))

pub func test_numbers_do_not_consume_member_or_range_dots():
    let tokens = lex("1.member 0..<10 1..=2 3..")
    assert(tokens[0].kind == TokenKind.int_lit)
    assert(tokens[1].text == ".")
    assert(tokens[2].text == "member")
    assert(tokens[4].text == "..<")
    assert(tokens[7].text == "..=")
    assert(tokens[10].text == "..")

# mark: Symbols and delimiters ===============================================================

pub func test_complete_symbol_surface_uses_longest_match():
    let source = "//= <<= >>= ..< ..= -> => == != <= >= // << >> += -= *= /= %= &= |= ^= .. + - * / % & | ^ ~ < > = : , . ? ! ( ) [ ] { } _"
    let expected: list[str] = ["//=", "<<=", ">>=", "..<", "..=", "->", "=>", "==", "!=", "<=", ">=", "//", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "..", "+", "-", "*", "/", "%", "&", "|", "^", "~", "<", ">", "=", ":", ",", ".", "?", "!", "(", ")", "[", "]", "{", "}", "_"]
    let tokens = lex(source)
    var i = 0
    while i < len(expected):
        assert(tokens[i].kind == TokenKind.symbol)
        assert(tokens[i].text == expected[i])
        i += 1

pub func test_match_ranges_and_alternatives_keep_distinct_tokens():
    let tokens = lex("'0'..='9', 'a'..<'z'\n")
    assert(tokens[0].kind == TokenKind.char_lit)
    assert(tokens[1].text == "..=")
    assert(tokens[2].kind == TokenKind.char_lit)
    assert(tokens[3].text == ",")
    assert(tokens[4].kind == TokenKind.char_lit)
    assert(tokens[5].text == "..<")
    assert(tokens[6].kind == TokenKind.char_lit)

pub func test_value_arrow_tokens_lambda_and_match_expressions():
    let source = "let above = (x) => x > 5\nlet digit = match c:\n    '0' => 0\n    _ => 1\n"
    let tokens = lex(source)
    var arrows = 0
    for token in tokens:
        if token.text == "=>": arrows += 1
    assert(arrows == 3)
    assert(count_kind(tokens, TokenKind.indent) == 1)
    assert(count_kind(tokens, TokenKind.dedent) == 1)

pub func test_nested_delimiters_suspend_layout():
    let source = "value = (\n    [\n        {\"x\": 1}\n    ]\n)\n"
    let tokens = lex(source)
    assert(count_kind(tokens, TokenKind.indent) == 0)
    assert(count_kind(tokens, TokenKind.dedent) == 0)
    assert(count_kind(tokens, TokenKind.newline) == 1)

pub func test_unbalanced_delimiters_are_rejected():
    assert(fails(")"))
    assert(fails("(]"))
    assert(fails("([)]"))
    assert(fails("("))

# mark: String and character literals ========================================================

pub func test_string_and_character_literals_preserve_spelling():
    let tokens = lex("\"hello\\n\" 'A' '\\n' '\\u{1f600}'")
    assert_token(tokens[0], TokenKind.str_lit, "\"hello\\n\"", 1, 1)
    assert(tokens[1].kind == TokenKind.char_lit)
    assert(tokens[2].kind == TokenKind.char_lit)
    assert(tokens[3].kind == TokenKind.char_lit)
    assert(tokens[3].text == "'\\u{1f600}'")

pub func test_prefixed_literal_families_have_the_right_token_kind():
    let source = "\"hello\" r\"C:\\studio\\shots\" f\"frame {frame}\" b\"\\x89PNG\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[1].kind == TokenKind.str_lit)
    assert(tokens[1].text == "r\"C:\\studio\\shots\"")
    assert(tokens[2].kind == TokenKind.str_lit)
    assert(tokens[3].kind == TokenKind.byte_lit)
    assert(tokens[3].text == "b\"\\x89PNG\"")

pub func test_formatted_strings_balance_fields_and_nested_literals():
    let source = "f\"{{value}} {format(\"x\")}\""
    let tokens = lex(source)
    assert_token(tokens[0], TokenKind.str_lit, source, 1, 1)
    assert(fails("f\"{value\""))
    assert(fails("f\"value }\""))

pub func test_triple_formatted_string_comments_need_a_later_field_close():
    let commented_close = "f\"\"\"{value # }\"\"\""
    assert(
        failure(commented_close)
        == "1:14: formatted string interpolation cannot close inside a comment; put `}` on a later line"
    )

    let close_after_comment = "f\"\"\"{value # note\n}\"\"\""
    assert(not fails(close_after_comment))

pub func test_triple_quoted_strings_span_physical_lines():
    let source = "\"\"\"first\nsecond\"\"\"\nafter"
    let tokens = lex(source)
    assert_token(tokens[0], TokenKind.str_lit, "\"\"\"first\nsecond\"\"\"", 1, 1)
    assert(tokens[1].kind == TokenKind.newline)
    assert_token(tokens[2], TokenKind.name, "after", 3, 1)

pub func test_prefixed_triple_strings_are_supported():
    let source = "r\"\"\"C:\\one\nC:\\two\"\"\" b\"\"\"PNG\"\"\" f\"\"\"value {x}\"\"\""
    let tokens = lex(source)
    assert(tokens[0].kind == TokenKind.str_lit)
    assert(tokens[0].span.line == 1)
    assert(tokens[1].kind == TokenKind.byte_lit)
    assert(tokens[1].span.line == 2)
    assert(tokens[2].kind == TokenKind.str_lit)
    assert(tokens[2].span.line == 2)

pub func test_malformed_literal_boundaries_are_rejected():
    assert(fails("\"line\nnext\""))
    assert(fails("\"unterminated"))
    assert(fails("\"\"\"unterminated"))
    assert(fails("r\"unterminated"))
    assert(fails("''"))
    assert(fails("'ab'"))

pub func test_invalid_escapes_and_byte_source_are_rejected():
    assert(fails("\"\\q\""))
    assert(fails("\"\\x41\""))
    assert(fails("'\\u{110000}'"))
    assert(fails("'\\u{D800}'"))
    assert(fails("b\"\\x8\""))
    assert(fails("b\"" + str('\u{e9}') + "\""))
    assert(not fails("r\"\\q\""))

# mark: Completion and diagnostics ===========================================================

pub func test_eof_balances_layout_without_inventing_comment_lines():
    let comment_tokens = lex("# comment without newline")
    assert(len(comment_tokens) == 1)
    assert(comment_tokens[0].kind == TokenKind.eof)

    let block_tokens = lex("if ready:\n    run()")
    let n = len(block_tokens)
    assert(block_tokens[n - 3].kind == TokenKind.newline)
    assert(block_tokens[n - 2].kind == TokenKind.dedent)
    assert(block_tokens[n - 1].kind == TokenKind.eof)

pub func test_excluded_source_forms_are_rejected():
    assert(fails("left; right"))
    assert(fails("left \\\nright"))
    assert(fails("caf" + str('\u{e9}')))
    assert(fails(str('\u{0661}')))
    assert(fails("left" + str('\u{ff1b}') + "right"))

pub func test_diagnostic_reports_first_offending_position():
    assert(failure("first\n@") == "2:1: unexpected character")
