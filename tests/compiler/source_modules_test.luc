#==============================================================================================
#
#   source_modules_test - Package-relative module identity regression tests
#
#==============================================================================================

from luce.compiler.hir.ir import ModuleAuthority
from luce.compiler.source_modules import authority_for_path, module_suffix, source_module_name

# mark: Module paths ===========================================================================

func failure(root: str, path: str, authority: ModuleAuthority) -> str:
    discard(source_module_name(root, path, authority)) catch reason:
        return reason
    return ""

func module_name(root: str, path: str, authority: ModuleAuthority) -> str:
    let result = source_module_name(root, path, authority) catch reason:
        trap(reason)
    return result

pub func test_source_paths_become_package_relative_dotted_modules():
    assert(module_name("src", "src/image/color.luc", ModuleAuthority.safe) == "image.color")
    assert(module_name("src", "src/platform/raw.lucn", ModuleAuthority.native) == "platform.raw")
    assert(module_name("src", "src/runtime/heap.lucb", ModuleAuthority.base) == "runtime.heap")
    assert(authority_for_path("src/main.luc") == ModuleAuthority.safe)
    assert(authority_for_path("src/platform/raw.lucn") == ModuleAuthority.native)
    assert(authority_for_path("src/runtime/heap.lucb") == ModuleAuthority.base)
    assert(module_suffix(ModuleAuthority.base) == ".lucb")
    assert(module_name(".", "./examples/checkout/catalog.luc", ModuleAuthority.safe) == "examples.checkout.catalog")

pub func test_source_roots_and_module_components_are_validated():
    assert(failure("src", "examples/color.luc", ModuleAuthority.safe) == "source path `examples/color.luc` is outside package source root `src`")
    assert(failure("src/", "src/color.luc", ModuleAuthority.safe) == "package source root must not end in `/`")
    assert(failure("src", "src/image/color-test.luc", ModuleAuthority.safe) == "source path `src/image/color-test.luc` has invalid module component `color-test`")
    assert(failure(".", "src/../color.luc", ModuleAuthority.safe) == "source path `src/../color.luc` is not a canonical package-relative path")
