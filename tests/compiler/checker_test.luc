#==============================================================================================
#
#   checker_test - What the checker accepts and rejects
#
#   DESCRIPTION:
#       Parsed fixtures in, typed programs (or stable diagnostics) out. The
#       helpers below run source through the tokenizer and parser so each test
#       reads as: modules in, expectation out.
#
#==============================================================================================

from luce.compiler.checker import Checker, SourceModule
from luce.compiler.parser import Parser
from luce.compiler.tokenizer import Tokenizer
from luce.compiler.typed_ir import TypedProgram

# mark: Test helpers =========================================================================

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> TypedProgram:
    let program = Checker(sources).check() catch reason:
        trap(reason)
    return program

pub func semantic_failure(sources: list[SourceModule]) -> str:
    let program = Checker(sources).check() catch reason:
        return reason
    return ""


# mark: Resolved typed IR ====================================================================

pub func test_selective_imports_resolve_to_stable_function_symbols():
    let sources = [
        source_module("math", "pub func double(value: i64) -> i64: return value * 2\n"),
        source_module("main", "from math import double\nfunc answer() -> i64:\n    let value = double(21)\n    return value\n"),
    ]
    let program = checked(sources)
    assert(len(program.modules) == 2)
    assert(program.modules[0].functions[0].result.name == "i64")
    let double_symbol = program.modules[0].functions[0].symbol.value
    let answer = program.modules[1].functions[0]
    assert(len(answer.body) == 2)
    match answer.body[0].form:
        Binding(symbol, name, is_mutable, value):
            assert(name == "value")
            assert(not is_mutable)
            assert(value.value_type.name == "i64")
            match value.form:
                Call(function, arguments):
                    assert(function.value == double_symbol)
                    assert(arguments[0].parameter_index == 0)
                else: assert(false)
        else: assert(false)

pub func test_qualified_calls_resolve_public_members_and_named_arguments():
    let sources = [
        source_module("math", "pub func subtract(left: i64, right: i64) -> i64: return left - right\n"),
        source_module("main", "import math as arithmetic\nfunc answer() -> i64: return arithmetic.subtract(right: 1, left: 3)\n"),
    ]
    let program = checked(sources)
    match program.modules[1].functions[0].body[0].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            match returned.form:
                Call(function, arguments):
                    assert(arguments[0].parameter_index == 1)
                    assert(arguments[1].parameter_index == 0)
                else: assert(false)
        else: assert(false)

pub func test_bindings_assignment_and_control_flow_are_typed():
    let source = "func update():\n    var value: i64 = 0\n    while value < 2:\n        value += 1\n        if value == 1: continue\n        break\n"
    let program = checked([source_module("main", source)])
    let body = program.modules[0].functions[0].body
    assert(len(body) == 2)
    assert(str(body[0].form) == "Binding")
    match body[1].form:
        WhileStatement(condition, loop_body):
            assert(condition.value_type.name == "bool")
            assert(str(loop_body[0].form) == "Assignment")
            assert(str(loop_body[1].form) == "IfStatement")
            assert(str(loop_body[2].form) == "BreakStatement")
        else: assert(false)

pub func test_native_entry_print_is_typed_with_its_effect_and_i32_result():
    let source = "pub func main(arguments: slice[str]) -> i32 uses terminal:\n    print(\"Hello, world!\")\n    return 0\n"
    let function = checked([source_module("hello", source)]).modules[0].functions[0]
    assert(function.parameters[0].value_type.name == "slice[str]")
    assert(function.result.name == "i32")
    assert(function.effects[0] == "terminal")
    match function.body[0].form:
        PrintText(value): assert(value == "Hello, world!")
        else: assert(false)
    match function.body[1].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            assert(returned.value_type.name == "i32")
        else: assert(false)

pub func test_terminal_operations_and_calls_require_the_effect():
    let direct = "func greet(): print(\"hello\")\n"
    assert(semantic_failure([source_module("main", direct)]) == "main.luc:1:15: `print` requires the `terminal` effect")

    let indirect = "func write() uses terminal: print(\"hello\")\nfunc caller(): write()\n"
    assert(semantic_failure([source_module("main", indirect)]) == "main.luc:2:16: call to `write` requires the `terminal` effect")


# mark: Module and name diagnostics ==========================================================

pub func test_private_and_missing_imports_are_rejected():
    let private_sources = [
        source_module("math", "func hidden() -> i64: return 1\n"),
        source_module("main", "from math import hidden\nfunc answer() -> i64: return hidden()\n"),
    ]
    assert(semantic_failure(private_sources) == "main.luc:1:18: `hidden` is private to module `math`")
    assert(semantic_failure([source_module("main", "import missing\nfunc answer() -> i64: return 0\n")]) == "main.luc:1:8: unknown module `missing`")

pub func test_duplicate_modules_declarations_and_parameters_are_rejected():
    let empty = ""
    assert(semantic_failure([source_module("same", empty), source_module("same", empty)]) == "same.luc:1:1: duplicate module `same`")
    assert(semantic_failure([source_module("main", "func value(): return\nfunc value(): return\n")]) == "main.luc:2:1: duplicate declaration `value`")
    assert(semantic_failure([source_module("main", "func value(item: i64, item: i64): return\n")]) == "main.luc:1:23: duplicate parameter `item`")

pub func test_unknown_names_and_import_collisions_are_rejected():
    assert(semantic_failure([source_module("main", "func answer() -> i64: return missing\n")]) == "main.luc:1:30: unknown name `missing`")
    let sources = [
        source_module("math", "pub func answer() -> i64: return 42\n"),
        source_module("main", "from math import answer\nfunc answer() -> i64: return 0\n"),
    ]
    assert(semantic_failure(sources) == "main.luc:1:18: imported name `answer` conflicts with a declaration")


# mark: Type and control-flow diagnostics ====================================================

pub func test_call_and_return_types_are_checked():
    let call_sources = [
        source_module("logic", "pub func choose(value: bool) -> bool: return value\n"),
        source_module("main", "from logic import choose\nfunc answer() -> bool: return choose(1)\n"),
    ]
    assert(semantic_failure(call_sources) == "main.luc:2:38: expected `bool`, found `i64`")
    assert(semantic_failure([source_module("main", "func answer() -> bool: return 1\n")]) == "main.luc:1:31: expected `bool`, found `i64`")

pub func test_immutable_assignment_and_non_boolean_conditions_are_rejected():
    let immutable = "func update():\n    let value = 1\n    value = 2\n"
    assert(semantic_failure([source_module("main", immutable)]) == "main.luc:3:5: cannot assign to immutable binding `value`; declare it with `var`")
    let condition = "func choose() -> i64:\n    if 1: return 1\n    return 0\n"
    assert(semantic_failure([source_module("main", condition)]) == "main.luc:2:8: expected `bool`, found `i64`")

pub func test_non_unit_functions_must_return_on_every_path():
    let source = "func choose(flag: bool) -> i64:\n    if flag: return 1\n"
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:1: function `choose` may finish without returning `i64`")
    let complete = "func choose(flag: bool) -> i64:\n    if flag: return 1\n    else: return 0\n"
    assert(semantic_failure([source_module("main", complete)]) == "")

pub func test_literals_are_decoded_and_range_checked_during_lowering():
    let program = checked([source_module("main", "func value() -> i64: return -9223372036854775808\n")])
    match program.modules[0].functions[0].body[0].form:
        ReturnStatement(value):
            let returned = value else trap("expected a value")
            match returned.form:
                Constant(constant):
                    match constant:
                        Integer(item): assert(item == -9223372036854775807 - 1)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    let outside = "func value() -> i64: return 9223372036854775808\n"
    assert(semantic_failure([source_module("main", outside)]) == "main.luc:1:29: integer literal is outside `i64` range")

pub func test_unimplemented_scalar_types_are_rejected_explicitly():
    let source = "func value() -> u8: return 1\n"
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:17: type `u8` is not implemented by the semantic checker yet")

pub func test_unsupported_semantic_forms_fail_explicitly():
    let source = "struct Point:\n    let x: i64\n"
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:1: semantic checking for `NominalType` is not implemented yet")

pub func test_extern_declarations_and_else_fallback_are_refused_explicitly():
    let extern_source = "extern var version: i32\n"
    assert(semantic_failure([source_module("main", extern_source)]) == "main.luc:1:1: extern variable declarations are not implemented by the semantic checker yet")
    let extern_function = "extern func probe() -> i32\n"
    assert(semantic_failure([source_module("main", extern_function)]) == "main.luc:1:1: extern function declarations are not implemented by the semantic checker yet")
    let else_source = "func value(input: i64) -> i64: return input else 0\n"
    assert(semantic_failure([source_module("main", else_source)]) == "main.luc:1:39: the `else` fallback expression is not implemented by the semantic checker yet")
