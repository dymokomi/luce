#==============================================================================================
#
#   package_artifact_test - Canonical typed-package envelope
#
#   DESCRIPTION:
#       Proves exact framing, detached payload ownership, and rejection of
#       truncated, corrupt, unsupported, empty-identity, and trailing input.
#
#==============================================================================================

from luce.compiler.packages.artifact import TypedPackageEnvelope, decode_typed_package, encode_typed_package

# mark: Helpers ================================================================================

func encoded(identity: str, payload: list[u8]) -> list[u8]:
    let result = encode_typed_package(identity, payload) catch reason:
        trap(reason)
    return result

func decoded(input: list[u8]) -> TypedPackageEnvelope:
    let result = decode_typed_package(input) catch reason:
        trap(reason)
    return result

func decoding_failure(input: list[u8]) -> str:
    var reported = ""
    discard(decode_typed_package(input)) catch reason:
        reported = reason
    return reported

func encoding_failure(identity: str) -> str:
    var reported = ""
    discard(encode_typed_package(identity, list[u8]())) catch reason:
        reported = reason
    return reported

func assert_bytes(actual: list[u8], expected: list[u8]):
    assert(len(actual) == len(expected))
    for index in range(0, len(expected)):
        assert(actual[index] == expected[index])

# mark: Canonical round trip ===================================================================

pub func test_typed_package_envelope_has_one_exact_target_neutral_spelling():
    let artifact = encoded("org.luce.math", [1, 2, 3])
    assert_bytes(artifact, [
        0x4C, 0x55, 0x43, 0x45, 0x50, 0x4B, 0x47, 0x00,
        0x03, 0x00, 0x00, 0x00,
        0x0D, 0x00, 0x00, 0x00,
        0x6F, 0x72, 0x67, 0x2E, 0x6C, 0x75, 0x63, 0x65, 0x2E, 0x6D, 0x61, 0x74, 0x68,
        0x03, 0x00, 0x00, 0x00, 0x01, 0x02, 0x03,
    ])
    let package = decoded(artifact)
    assert(package.identity == "org.luce.math")
    assert(len(package.payload) == 3)
    assert(package.payload[0] == 1 and package.payload[1] == 2 and package.payload[2] == 3)

pub func test_typed_package_envelope_returns_detached_payload_bytes():
    let payload: list[u8] = [7]
    let artifact = encoded("org.luce.detached", payload)
    payload.append(9)
    let package = decoded(artifact)
    assert(len(package.payload) == 1 and package.payload[0] == 7)

# mark: Malformed envelopes ====================================================================

pub func test_typed_package_envelope_rejects_every_invalid_boundary():
    assert(encoding_failure("") == "typed package artifact: identity must not be empty")
    assert(decoding_failure([0x4C]) == "typed package artifact: truncated magic")

    let wrong_magic = encoded("x", list[u8]())
    wrong_magic[3] = 0x00
    assert(decoding_failure(wrong_magic) == "typed package artifact: invalid magic")

    let wrong_version = encoded("x", list[u8]())
    wrong_version[8] = 0x04
    assert(decoding_failure(wrong_version) == "typed package artifact: unsupported format version 4")

    let empty_identity = encoded("x", list[u8]())
    empty_identity[12] = 0x00
    assert(decoding_failure(empty_identity) == "typed package artifact: identity must not be empty")

    let truncated_payload = encoded("x", [1, 2])
    truncated_payload.remove(len(truncated_payload) - 1)
    assert(decoding_failure(truncated_payload) == "package artifact: truncated byte field")

    let trailing = encoded("x", list[u8]())
    trailing.append(0)
    assert(decoding_failure(trailing) == "package artifact: trailing bytes after the final section")
