#==============================================================================================
#
#   package_importer_test - Atomic package-local HIR identity remapping
#
#   DESCRIPTION:
#       Imports a separately encoded dependency into an independently checked
#       root graph, then proves canonical validation, structural type and
#       standard-interface interning, executable behavior, and input isolation.
#
#==============================================================================================

from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirFunction, HirInterfaceOrigin, HirProgram, ModuleAuthority, SymbolId
from luce.compiler.packages.importer import import_typed_hir_package
from luce.compiler.packages.program_codec import decode_typed_hir_package, encode_typed_hir_package, validate_typed_hir_package

# mark: Fixtures ===============================================================================

func generated(identity: str, module: str, source: str) -> HirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let program = HirGenerator(identity, [SourceModule(
        name = module, path = module + ".luc",
        authority = ModuleAuthority.safe, syntax = syntax,
    )]).generate() catch reason:
        trap(reason)
    return program

func standard_interface_count(program: HirProgram) -> i64:
    var count = 0
    for value in program.interfaces:
        match value.origin:
            Source(module): pass
            Standard(identity): count += 1
    return count

func bytes_match(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

func function_with_symbol(function: HirFunction, symbol: SymbolId) -> HirFunction:
    return HirFunction(
        symbol = symbol, module = function.module, name = function.name,
        is_public = function.is_public, documentation = function.documentation,
        receiver = function.receiver, closure = function.closure,
        parameters = function.parameters, result = function.result,
        implementation = function.implementation, span = function.span,
    )

# mark: Complete import transaction ============================================================

pub func test_typed_hir_import_remaps_the_complete_dependency_without_mutating_inputs():
    let root = generated(
        "org.luce.root", "app",
        "func same[T: Equatable](left: T, right: T) -> bool: return left == right\n"
        + "pub func root() -> i64: return 7\n"
        + "pub func main(arguments: slice[str]) -> i32!: return 0\n",
    )
    let dependency = generated(
        "org.luce.math", "math",
        "pub interface Scored:\n"
        + "    func score(self, left: i64, right: i64) -> i64\n"
        + "struct Number implements Scored:\n"
        + "    let value: i64\n"
        + "    pub func score(self, left: i64, right: i64) -> i64: return self.value + left * 10 + right\n"
        + "func same[T: Equatable](left: T, right: T) -> bool: return left == right\n"
        + "pub func choose[T: Scored](value: T) -> T:\n"
        + "    let read: func() -> T = () => value\n"
        + "    return read()\n"
        + "func erased(value: Scored) -> i64: return value.score(right = 2, left = 4)\n"
        + "pub func answer() -> i64:\n"
        + "    let values = [1, 2, 3]\n"
        + "    return erased(choose(Number(value = 0))) if same(values, values) else 0\n"
        + "pub func main(arguments: slice[str]) -> i32!: return 0\n",
    )
    let root_entry = root.process_entry else trap("root process entry was not selected")
    let root_types = len(root.types.definitions)
    let root_nodes = len(root.nodes)
    let dependency_artifact = encode_typed_hir_package(dependency) catch reason:
        trap(reason)
    let imported = import_typed_hir_package(root, dependency_artifact) catch reason:
        trap(reason)

    assert(len(root.packages) == 1)
    assert(len(root.types.definitions) == root_types)
    assert(len(root.nodes) == root_nodes)
    assert(len(imported.packages) == 2)
    assert(imported.packages[imported.root_package.value].identity == "org.luce.root")
    assert(imported.modules[1].package.value == 1)
    let imported_entry = imported.process_entry else trap("root process entry was not preserved")
    assert(imported_entry.value == root_entry.value)
    var root_entry_index = -1
    var dependency_entry_index = -1
    for index in range(0, len(imported.functions)):
        let function = imported.functions[index]
        if function.symbol.value == imported_entry.value: root_entry_index = index
        if function.module.value == 1 and function.name == "main":
            dependency_entry_index = index
            assert(function.symbol.value != imported_entry.value)
    assert(root_entry_index >= 0 and dependency_entry_index >= 0)
    assert(standard_interface_count(imported) == 1)
    assert(len(imported.types.definitions) < root_types + len(dependency.types.definitions) - 21)

    let first = encode_typed_hir_package(imported) catch reason:
        trap(reason)
    let restored = decode_typed_hir_package(first) catch reason:
        trap(reason)
    let restored_entry = restored.process_entry else trap("encoded root process entry disappeared")
    assert(restored_entry.value == root_entry.value)
    let second = encode_typed_hir_package(restored) catch reason:
        trap(reason)
    assert(bytes_match(first, second))

    let analyzed = SemanticAnalyzer(restored).analyze() catch reason:
        trap(reason)
    let root_value = HirInterpreter().run(analyzed, "app", "root") catch reason:
        trap(reason)
    match root_value:
        SignedInteger(value): assert(value == 7)
        else: assert(false)
    let dependency_value = HirInterpreter().run(analyzed, "math", "answer") catch reason:
        trap(reason)
    match dependency_value:
        SignedInteger(value): assert(value == 42)
        else: assert(false)

    # Artifact validation independently proves that entry metadata still
    # names the root package, even if a corrupt graph swaps function symbols.
    let root_function = imported.functions[root_entry_index]
    let dependency_function = imported.functions[dependency_entry_index]
    imported.functions[root_entry_index] = function_with_symbol(root_function, dependency_function.symbol)
    imported.functions[dependency_entry_index] = function_with_symbol(dependency_function, root_function.symbol)
    var reported = ""
    validate_typed_hir_package(imported) catch reason:
        reported = reason
    assert(reported == "typed package artifact: process entry does not belong to the root package")

pub func test_typed_hir_import_rejects_duplicate_package_identity_before_composition():
    let root = generated("org.luce.same", "app", "pub func value() -> i64: return 1\n")
    let dependency = generated("org.luce.same", "dep", "pub func value() -> i64: return 2\n")
    let artifact = encode_typed_hir_package(dependency) catch reason:
        trap(reason)
    var reported = ""
    discard(import_typed_hir_package(root, artifact)) catch reason:
        reported = reason
    assert(reported == "typed package import: duplicate package identity `org.luce.same`")
    assert(len(root.packages) == 1)
    assert(len(root.modules) == 1)

# mark: Source generation from typed dependencies =============================================

pub func test_source_generation_consumes_aliases_generics_and_conformances_without_dependency_source():
    let dependency = generated(
        "org.luce.math", "math",
        "pub type Count = i64\n"
        + "pub interface Readable[T]:\n"
        + "    func read(self) -> T\n"
        + "pub struct Box[T] implements Readable[T]:\n"
        + "    pub let value: T\n"
        + "    pub func read(self) -> T: return self.value\n"
        + "pub struct Pair[T]:\n"
        + "    pub let value: T\n"
        + "    pub let score: i64 = 3\n"
        + "pub struct Score implements Comparable:\n"
        + "    pub let value: i64\n"
        + "    pub func compare(self, other: Score) -> i64:\n"
        + "        if self.value < other.value: return -1\n"
        + "        if self.value > other.value: return 1\n"
        + "        return 0\n"
        + "pub func choose[T](value: T) -> T:\n"
        + "    let load: func() -> T = () => value\n"
        + "    return load()\n"
        + "pub func defaulted[T](value: T, score: i64 = 2) -> i64: return score\n",
    )
    let artifact = encode_typed_hir_package(dependency) catch reason:
        trap(reason)
    let tokens = Tokenizer(
        "import math\n"
        + "func read[T: math.Readable[i64]](value: T) -> i64: return value.read()\n"
        + "func maximum[T: Comparable](left: T, right: T) -> T: return left if left.compare(other = right) >= 0 else right\n"
        + "pub func answer() -> math.Count:\n"
        + "    let pair = math.Pair(value = math.choose(40))\n"
        + "    let highest = maximum(math.Score(value = 40), math.Score(value = 42))\n"
        + "    return read(math.Box(value = pair.value)) + pair.score + math.defaulted(0) + highest.value\n"
    ).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let generator = HirGenerator("org.luce.app", [SourceModule(
        name = "app", path = "app.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )])
    generator.add_dependency(artifact)
    let program = generator.generate() catch reason:
        trap(reason)
    let complete_artifact = encode_typed_hir_package(program) catch reason:
        trap(reason)
    let restored = decode_typed_hir_package(complete_artifact) catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(restored).analyze() catch reason:
        trap(reason)
    let value = HirInterpreter().run(analyzed, "app", "answer") catch reason:
        trap(reason)
    match value:
        SignedInteger(result): assert(result == 87)
        else: assert(false)

pub func test_source_generation_enforces_visibility_from_dependency_metadata():
    let dependency = generated(
        "org.luce.math", "math",
        "pub struct Secret:\n"
        + "    let value: i64\n"
        + "pub func secret() -> Secret: return Secret(value = 42)\n",
    )
    let artifact = encode_typed_hir_package(dependency) catch reason:
        trap(reason)
    let tokens = Tokenizer(
        "import math\n"
        + "pub func answer() -> i64: return math.secret().value\n"
    ).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let generator = HirGenerator("org.luce.app", [SourceModule(
        name = "app", path = "app.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )])
    generator.add_dependency(artifact)
    var reported = ""
    discard(generator.generate()) catch reason:
        reported = reason
    assert(reported == "app.luc:2:34: field `value` is private to module `math`")
