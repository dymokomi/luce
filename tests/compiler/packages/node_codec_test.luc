#==============================================================================================
#
#   package_node_codec_test - Closed retained-HIR wire vocabulary
#
#   DESCRIPTION:
#       Exercises every `HirNodeForm` and every resolved unary/binary operation
#       through one byte-stable encode/decode cycle. Unknown nested tags fail
#       before consuming payload that belongs to another node.
#
#==============================================================================================

from luce.compiler.hir.ir import AssignmentOperation, BinaryOperation, HirGenericCallKind, HirIteration
from luce.compiler.hir.ir import HirNode, HirNodeForm, NodeId, Operands, PackageId, SymbolId, TypeId, UnaryOperation, no_node
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.node_codec import read_hir_node, write_hir_node

# mark: Helpers ================================================================================

func append(nodes: list[HirNode], form: HirNodeForm):
    nodes.append(HirNode(form = form))

func bytes_match(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

func encoded(nodes: list[HirNode]) -> list[u8]:
    let writer = PackageWriter()
    for node in nodes:
        write_hir_node(writer, node) catch reason:
            trap(reason)
    return writer.finish()

# mark: Closed node vocabulary =================================================================

pub func test_package_node_codec_round_trips_every_hir_form_and_operation_tag():
    let nodes = list[HirNode]()
    let n = NodeId(value = 0)
    let missing = NodeId(value = no_node)
    let run = Operands(start = 0, count = 0)
    let symbol = SymbolId(value = 0)
    let value_type = TypeId(value = 5)

    append(nodes, HirNodeForm.BreakStatement)
    append(nodes, HirNodeForm.ContinueStatement)
    append(nodes, HirNodeForm.Binding(symbol = symbol, is_mutable = true, value = n))
    append(nodes, HirNodeForm.Assignment(symbol = symbol, operation = AssignmentOperation.Replace, value = n))
    append(nodes, HirNodeForm.ExternStore(variable = 0, operation = AssignmentOperation.Combine(operation = BinaryOperation.Add(operand_type = value_type)), value = n))
    append(nodes, HirNodeForm.GlobalStore(global = 0, operation = AssignmentOperation.Replace, value = n))
    append(nodes, HirNodeForm.PlaceAssignment(symbol = symbol, steps = run, operation = AssignmentOperation.Replace, value = n))
    append(nodes, HirNodeForm.GlobalPlaceAssignment(global = 0, steps = run, operation = AssignmentOperation.Replace, value = n))
    append(nodes, HirNodeForm.PrintText(value = "text"))
    append(nodes, HirNodeForm.PrintValue(value = n))
    append(nodes, HirNodeForm.ReturnStatement(value = missing))
    append(nodes, HirNodeForm.RecoverStatement(value = missing))
    append(nodes, HirNodeForm.DeferStatement(action = n))
    append(nodes, HirNodeForm.ExpressionStatement(value = n))
    append(nodes, HirNodeForm.IfStatement(branches = run, has_fallback = false, fallback = run))
    append(nodes, HirNodeForm.WhileStatement(condition = n, body = run))
    append(nodes, HirNodeForm.ForStatement(symbol = symbol, iteration = HirIteration.Builtin(value = n), body = run))
    append(nodes, HirNodeForm.ForStatement(symbol = symbol, iteration = HirIteration.Protocol(iterator_symbol = symbol, iterator = n, next = n), body = run))
    append(nodes, HirNodeForm.Constant(value = 0))
    append(nodes, HirNodeForm.Reference(symbol = symbol))
    append(nodes, HirNodeForm.ExternLoad(variable = 0))
    append(nodes, HirNodeForm.GlobalLoad(global = 0))
    append(nodes, HirNodeForm.NativeLoad(pointer = n))
    append(nodes, HirNodeForm.NativeStore(pointer = n, value = n))
    append(nodes, HirNodeForm.NativeAdvance(pointer = n, count = n))
    append(nodes, HirNodeForm.NativeRebind(pointer = n))
    append(nodes, HirNodeForm.NativeMove(destination = n, source = n, count = n))
    append(nodes, HirNodeForm.NativeAllocate(element_type = value_type, count = n))
    append(nodes, HirNodeForm.NativeDeallocate(pointer = n, element_type = value_type, count = n))
    append(nodes, HirNodeForm.NativeIsNull(pointer = n))
    append(nodes, HirNodeForm.NativeIsSame(left = n, right = n))
    append(nodes, HirNodeForm.NativeAddressHash(pointer = n))
    append(nodes, HirNodeForm.NativeFloatBits(value = n))
    append(nodes, HirNodeForm.NativeArena(end = n))
    append(nodes, HirNodeForm.NumericConvert(value = n))
    append(nodes, HirNodeForm.Discard(value = n))
    append(nodes, HirNodeForm.NeverCoercion(value = n))
    append(nodes, HirNodeForm.DivergingSequence(values = run))
    append(nodes, HirNodeForm.StringScalarCount(value = n))
    append(nodes, HirNodeForm.ForeignBytesCopy(pointer = n, count = n))
    append(nodes, HirNodeForm.ForeignCStringCopy(pointer = n))
    append(nodes, HirNodeForm.BuiltinDisplay(value = n))
    append(nodes, HirNodeForm.FormattedString(parts = run))
    append(nodes, HirNodeForm.Hash(value = n))
    append(nodes, HirNodeForm.SequenceLength(value = n))
    append(nodes, HirNodeForm.SequenceIndex(value = n, index = n))

    let unary = [
        UnaryOperation.LogicalNot,
        UnaryOperation.NumericIdentity(operand_type = value_type),
        UnaryOperation.NumericNegate(operand_type = value_type),
        UnaryOperation.IntegerBitwiseNot(operand_type = value_type),
    ]
    for operation in unary: append(nodes, HirNodeForm.Unary(operation = operation, operand = n))
    let binary = [
        BinaryOperation.LogicalAnd, BinaryOperation.LogicalOr,
        BinaryOperation.Equal(operand_type = value_type), BinaryOperation.NotEqual(operand_type = value_type),
        BinaryOperation.Identity(operand_type = value_type), BinaryOperation.NotIdentity(operand_type = value_type),
        BinaryOperation.Less(operand_type = value_type), BinaryOperation.LessEqual(operand_type = value_type),
        BinaryOperation.Greater(operand_type = value_type), BinaryOperation.GreaterEqual(operand_type = value_type),
        BinaryOperation.Add(operand_type = value_type), BinaryOperation.Subtract(operand_type = value_type),
        BinaryOperation.Multiply(operand_type = value_type), BinaryOperation.Divide(operand_type = value_type),
        BinaryOperation.FloorDivide(operand_type = value_type), BinaryOperation.Remainder(operand_type = value_type),
        BinaryOperation.BitwiseAnd(operand_type = value_type), BinaryOperation.BitwiseOr(operand_type = value_type),
        BinaryOperation.BitwiseXor(operand_type = value_type), BinaryOperation.ShiftLeft(operand_type = value_type),
        BinaryOperation.ShiftRight(operand_type = value_type),
    ]
    for operation in binary: append(nodes, HirNodeForm.Binary(left = n, operation = operation, right = n))

    append(nodes, HirNodeForm.Conditional(value = n, condition = n, alternative = n))
    append(nodes, HirNodeForm.Range(lower = n, upper = n, inclusive = true))
    append(nodes, HirNodeForm.Call(function = symbol, arguments = run))
    append(nodes, HirNodeForm.GenericCall(generic = 0, type_arguments = run, arguments = run, kind = HirGenericCallKind.function))
    append(nodes, HirNodeForm.GenericCall(generic = 0, type_arguments = run, arguments = run, kind = HirGenericCallKind.initializer))
    append(nodes, HirNodeForm.GenericFunctionAddress(generic = 0, type_arguments = run))
    append(nodes, HirNodeForm.GenericDefaultArgument(generic = 0, parameter = 0, type_arguments = run))
    append(nodes, HirNodeForm.GenericRequirementCall(interface_type = value_type, requirement = 0, arguments = run))
    append(nodes, HirNodeForm.GenericInterfaceValue(value = n))
    append(nodes, HirNodeForm.InterfaceValue(value = n, conformance = 0))
    append(nodes, HirNodeForm.InterfaceCall(receiver = n, interface_type = value_type, requirement = 0, arguments = run))
    append(nodes, HirNodeForm.FunctionAddress(function = symbol))
    append(nodes, HirNodeForm.ClosureValue(closure = 0, initializers = run))
    append(nodes, HirNodeForm.WeakCaptureReference(symbol = symbol))
    append(nodes, HirNodeForm.IndirectCall(callee = n, arguments = run))
    append(nodes, HirNodeForm.Initialize(function = symbol, arguments = run))
    append(nodes, HirNodeForm.ErrorCodeLiteral(package = PackageId(value = 0), value = 7))
    append(nodes, HirNodeForm.Raise(code = n, message = n))
    append(nodes, HirNodeForm.Trap(message = n))
    append(nodes, HirNodeForm.Assert(condition = n, message = n))
    append(nodes, HirNodeForm.Try(value = n))
    append(nodes, HirNodeForm.Catch(value = n, failure = symbol, body = run))
    append(nodes, HirNodeForm.Tuple(elements = run))
    append(nodes, HirNodeForm.Array(elements = run))
    append(nodes, HirNodeForm.List(elements = run))
    append(nodes, HirNodeForm.ListCopy(value = n))
    append(nodes, HirNodeForm.ListWithMutableSlice(value = n, callback = n))
    append(nodes, HirNodeForm.SequenceSlice(value = n, start = missing, end = missing))
    append(nodes, HirNodeForm.ListAppend(value = n, element = n))
    append(nodes, HirNodeForm.ListInsert(value = n, index = n, element = n))
    append(nodes, HirNodeForm.ListRemoveAt(value = n, index = n))
    append(nodes, HirNodeForm.ListClear(value = n))
    append(nodes, HirNodeForm.ListReserve(value = n, minimum_capacity = n))
    append(nodes, HirNodeForm.Map(entries = run))
    append(nodes, HirNodeForm.Set(elements = run))
    append(nodes, HirNodeForm.MapLookup(value = n, key = n))
    append(nodes, HirNodeForm.MapRemove(value = n, key = n))
    append(nodes, HirNodeForm.MapClear(value = n))
    append(nodes, HirNodeForm.MapReserve(value = n, minimum_capacity = n))
    append(nodes, HirNodeForm.MapCopy(value = n))
    append(nodes, HirNodeForm.SetContains(value = n, element = n))
    append(nodes, HirNodeForm.SetInsert(value = n, element = n))
    append(nodes, HirNodeForm.SetRemove(value = n, element = n))
    append(nodes, HirNodeForm.SetClear(value = n))
    append(nodes, HirNodeForm.SetReserve(value = n, minimum_capacity = n))
    append(nodes, HirNodeForm.SetCopy(value = n))
    append(nodes, HirNodeForm.WeakCreate(value = n))
    append(nodes, HirNodeForm.WeakGet(value = n))
    append(nodes, HirNodeForm.Element(value = n, index = 3))
    append(nodes, HirNodeForm.StructValue(struct_index = 0, fields = run))
    append(nodes, HirNodeForm.FieldAccess(value = n, field = 0))
    append(nodes, HirNodeForm.NoneLiteral)
    append(nodes, HirNodeForm.Some(value = n))
    append(nodes, HirNodeForm.ElseFallback(value = n, arm = n))
    append(nodes, HirNodeForm.EnumValue(enum_index = 0, case_index = 0, payload = run))
    append(nodes, HirNodeForm.Match(subject = n, arms = run, has_result = true))
    append(nodes, HirNodeForm.MatchArm(patterns = run, statements = run, value = missing))
    append(nodes, HirNodeForm.PatternWildcard)
    append(nodes, HirNodeForm.PatternLiteral(value = 0))
    append(nodes, HirNodeForm.PatternRange(lower = 0, upper = 1, inclusive = true))
    append(nodes, HirNodeForm.PatternCase(case_index = 0, bindings = run))

    let first = encoded(nodes)
    let reader = PackageReader(first)
    let restored = list[HirNode]()
    for index in range(0, len(nodes)):
        let node = read_hir_node(reader) catch reason:
            trap(reason)
        restored.append(node)
    reader.finish() catch reason:
        trap(reason)
    assert(bytes_match(first, encoded(restored)))

pub func test_package_node_codec_rejects_unknown_nested_operation_tags():
    let unary = PackageReader([u8(43), u8(255)])
    var unary_failure = ""
    discard(read_hir_node(unary)) catch reason:
        unary_failure = reason
    assert(unary_failure == "typed package artifact: unknown retained HIR unary-operation tag 255")

    let binary = PackageReader([u8(44), u8(0), u8(0), u8(0), u8(0), u8(255)])
    var binary_failure = ""
    discard(read_hir_node(binary)) catch reason:
        binary_failure = reason
    assert(binary_failure == "typed package artifact: unknown retained HIR binary-operation tag 255")
