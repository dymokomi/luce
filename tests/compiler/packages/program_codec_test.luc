#==============================================================================================
#
#   package_program_codec_test - One complete typed HIR package transaction
#
#   DESCRIPTION:
#       Round-trips a generator-produced package with nominal defaults,
#       interfaces, retained generics, concrete specializations, closures,
#       and executable bodies through the canonical envelope. The restored
#       graph is re-analyzed and executed, not merely compared as bytes.
#
#==============================================================================================

from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirNode, HirNodeForm, HirProgram, HirTypeAlias, ModuleAuthority, Operands
from luce.compiler.packages.program_codec import decode_typed_hir_package, encode_typed_hir_package
from luce.compiler.packages.program_codec import validate_typed_hir_package
import std.files

# mark: Fixtures ===============================================================================

func generated() -> HirProgram:
    var source = "pub type Count = i64\n"
    source += "interface Scored:\n"
    source += "    func score(self) -> i64\n"
    source += "struct Item implements Scored:\n"
    source += "    let value: i64\n"
    source += "    pub func score(self) -> i64: return self.value\n"
    source += "struct Box[T]:\n"
    source += "    let value: T\n"
    source += "    let fallback: T? = none\n"
    source += "pub extern type Handle = i32\n"
    source += "pub extern var native_count: i32\n"
    source += "extern blocking func split(value: i32, out rest: i32) -> i32\n"
    source += "export c func twice(value: i32) -> i32: return value * 2i32\n"
    source += "func relay[T: Scored](value: T) -> Box[T]:\n"
    source += "    var current = value\n"
    source += "    let read: func() -> T = () => current\n"
    source += "    return Box(read())\n"
    source += "pub func answer() -> i64: return relay(Item(value = 42)).value.score()\n"
    return generated_source(source)

func generated_source(source: str) -> HirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let program = HirGenerator("org.luce.program-codec", [SourceModule(
        name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )]).generate() catch reason:
        trap(reason)
    return program

func bytes_match(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

# mark: Complete package transaction ===========================================================

pub func test_typed_hir_package_round_trip_is_byte_stable_and_executable():
    let first = encode_typed_hir_package(generated()) catch reason:
        trap(reason)
    let restored = decode_typed_hir_package(first) catch reason:
        trap(reason)
    let second = encode_typed_hir_package(restored) catch reason:
        trap(reason)
    assert(bytes_match(first, second))
    assert(len(restored.generic_functions) == 1)
    assert(len(restored.generic_instances) == 1)
    assert(len(restored.closures) == 1)
    assert(len(restored.shared_cells) == 1)

    let analyzed = SemanticAnalyzer(restored).analyze() catch reason:
        trap(reason)
    let value = HirInterpreter().run(analyzed, "main", "answer") catch reason:
        trap(reason)
    match value:
        SignedInteger(answer): assert(answer == 42)
        else: assert(false)

pub func test_every_executable_generic_example_round_trips_as_a_complete_typed_package():
    let paths = [
        "examples/generic_functions.luc",
        "examples/generic_methods.luc",
        "examples/generic_construction.luc",
        "examples/constrained_generics.luc",
        "examples/generic_enums.luc",
        "examples/generic_classes.luc",
    ]
    for path in paths:
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source).tokenize() catch reason:
            trap(reason)
        let syntax = Parser(tokens).parse() catch reason:
            trap(reason)
        let program = HirGenerator("org.luce.example-package", [SourceModule(
            name = "example", path = path, authority = ModuleAuthority.safe, syntax = syntax,
        )]).generate() catch reason:
            trap(reason)
        let first = encode_typed_hir_package(program) catch reason:
            trap(path + ": " + reason)
        let restored = decode_typed_hir_package(first) catch reason:
            trap(path + ": " + reason)
        let second = encode_typed_hir_package(restored) catch reason:
            trap(path + ": " + reason)
        assert(bytes_match(first, second))

pub func test_complete_typed_package_codec_accepts_the_standalone_language_corpus():
    let paths = [
        "examples/hello.luc",
        "examples/compiled_core/main.luc",
        "examples/native_interop.native.luc",
        "examples/stage0_calculator.luc",
        "examples/stage0_sort.luc",
        "examples/stage0_brainfuck.luc",
        "examples/function_values.luc",
        "examples/interfaces.luc",
        "examples/iteration.luc",
        "examples/hashing.luc",
        "examples/closures.luc",
        "examples/cfunc_values.luc",
        "examples/conditional_binding.luc",
        "examples/types_and_bindings.luc",
        "examples/expressions_and_calls.luc",
        "examples/array_slices.luc",
        "examples/classes.luc",
        "examples/lists.luc",
        "examples/mutable_slices.luc",
        "examples/maps_and_sets.luc",
        "examples/bytes.luc",
        "examples/strings.luc",
        "examples/formatted_strings.luc",
        "examples/traps.luc",
        "examples/assertions.luc",
    ]
    for path in paths:
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source).tokenize() catch reason:
            trap(path + ": " + reason)
        let syntax = Parser(tokens).parse() catch reason:
            trap(path + ": " + reason)
        var authority = ModuleAuthority.safe
        if path == "examples/native_interop.native.luc": authority = ModuleAuthority.native
        let program = HirGenerator("org.luce.corpus-package", [SourceModule(
            name = "example", path = path, authority = authority, syntax = syntax,
        )]).generate() catch reason:
            trap(path + ": " + reason)
        let first = encode_typed_hir_package(program) catch reason:
            trap(path + ": " + reason)
        let restored = decode_typed_hir_package(first) catch reason:
            trap(path + ": " + reason)
        let second = encode_typed_hir_package(restored) catch reason:
            trap(path + ": " + reason)
        assert(bytes_match(first, second))

pub func test_typed_hir_package_rejects_envelope_mismatch_and_template_nodes_in_execution():
    let encoded = encode_typed_hir_package(generated()) catch reason:
        trap(reason)
    # Envelope bytes 12...15 are the identity length and byte 16 begins the
    # UTF-8 identity. Keep it valid text while changing only transport identity.
    encoded[16] = 0x78
    var mismatch = ""
    discard(decode_typed_hir_package(encoded)) catch reason:
        mismatch = reason
    assert(mismatch == "typed package artifact: envelope identity does not match the root HIR package")

    let invalid = generated()
    invalid.nodes.append(HirNode(form = HirNodeForm.GenericFunctionAddress(
        generic = 0, type_arguments = Operands(start = 0, count = 0),
    )))
    invalid.node_types.append(invalid.generic_functions[0].body.arena.node_types[0])
    invalid.node_modules.append(invalid.generic_functions[0].body.arena.node_modules[0])
    invalid.node_spans.append(invalid.generic_functions[0].body.arena.node_spans[0])
    var reported = ""
    validate_typed_hir_package(invalid) catch reason:
        reported = reason
    assert(reported == "typed package artifact: template-only node appears in executable HIR")

    let wrong_call = generated_source(
        "struct Point:\n"
        + "    let value: i64\n"
        + "    func init(self, value: i64): self.value = value\n"
        + "func make() -> Point: return Point(42)\n"
    )
    var replaced = false
    for index in range(0, len(wrong_call.nodes)):
        match wrong_call.nodes[index].form:
            Initialize(function, arguments):
                wrong_call.nodes[index] = HirNode(form = HirNodeForm.Call(
                    function = function, arguments = arguments,
                ))
                replaced = true
            else: pass
    assert(replaced)
    reported = ""
    validate_typed_hir_package(wrong_call) catch reason:
        reported = reason
    assert(reported == "typed package artifact: HIR call target is an initializer")

    let duplicate = generated()
    let type_alias = duplicate.aliases[0]
    duplicate.aliases[0] = HirTypeAlias(
        module = type_alias.module,
        name = "Item",
        is_public = type_alias.is_public,
        documentation = type_alias.documentation,
        value_type = type_alias.value_type,
        span = type_alias.span,
    )
    reported = ""
    validate_typed_hir_package(duplicate) catch reason:
        reported = reason
    assert(reported == "typed package artifact: duplicate module declaration `Item`")
