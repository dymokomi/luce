#==============================================================================================
#
#   package_nominal_codec_test - Serialized nominal declarations and applications
#
#   DESCRIPTION:
#       Round-trips generic and concrete struct/class/enum schemas, including
#       an extern boundary struct, and proves malformed declaration identities,
#       references, concrete views, and wire tags fail closed.
#
#==============================================================================================

from luce.compiler.frontend.source import SourceSpan
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirClass, HirClassApplication, HirEnum, HirEnumCase, HirField
from luce.compiler.hir.ir import HirNominalApplication, HirNominalField, HirPayloadField, HirStruct
from luce.compiler.hir.ir import HirProgram, HirTypeParameter, ModuleAuthority, ModuleId, NodeId, SymbolId
from luce.compiler.hir.ir import TypeDefinition, TypeForm, TypeId
from luce.compiler.hir.ir import TypeTable, create_builtin_type_table, no_node
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.nominal_codec import HirNominalTables, read_nominal_tables, write_nominal_tables

# mark: Fixtures ===============================================================================

func span() -> SourceSpan:
    return SourceSpan(start = 4, end = 12, line = 2, column = 5)

func append_type(types: TypeTable, name: str, form: TypeForm) -> TypeId:
    let identity = TypeId(value = u32(len(types.definitions)))
    types.definitions.append(TypeDefinition(id = identity, name = name, form = form))
    return identity

func nominal_fixture() -> (TypeTable, HirNominalTables):
    let types = create_builtin_type_table()
    let parameter = append_type(types, "T", TypeForm.TypeParameter(generic = 10, position = 0))
    discard(append_type(types, "Pair[T]", TypeForm.Struct(index = 0, arguments = [parameter])))
    discard(append_type(types, "Owner", TypeForm.Class(index = 0, arguments = list[TypeId]())))
    let choice_parameter = append_type(types, "U", TypeForm.TypeParameter(generic = 11, position = 0))
    discard(append_type(types, "Choice[U]", TypeForm.Enum(index = 0, arguments = [choice_parameter])))
    discard(append_type(types, "NativePair", TypeForm.Struct(index = 1, arguments = list[TypeId]())))

    let pair_fields = [HirField(
        name = "value", value_type = parameter,
        is_mutable = true, is_weak = false, is_public = true,
        documentation = ["Stored value."], default_value = NodeId(value = no_node),
    )]
    let owner_fields = [HirField(
        name = "label", value_type = TypeId(value = 14),
        is_mutable = false, is_weak = false, is_public = false,
        documentation = list[str](), default_value = NodeId(value = no_node),
    )]
    let choice_cases = [
        HirEnumCase(name = "none", documentation = list[str](), payload = list[HirPayloadField]()),
        HirEnumCase(
            name = "some", documentation = ["A present value."],
            payload = [HirPayloadField(name = "value", value_type = choice_parameter)],
        ),
    ]
    let native_fields = [HirField(
        name = "code", value_type = TypeId(value = 4),
        is_mutable = false, is_weak = false, is_public = true,
        documentation = list[str](), default_value = NodeId(value = no_node),
    )]

    let applications = list[HirNominalApplication?]()
    for index in range(0, len(types.definitions)): applications.append(none)
    applications[22] = HirNominalApplication.StructApplication(fields = [HirNominalField(
        name = "value", value_type = parameter,
        is_mutable = true, is_weak = false, is_public = true,
        documentation = ["Stored value."],
    )])
    applications[23] = HirNominalApplication.ClassApplication(application = HirClassApplication(
        fields = [HirNominalField(
            name = "label", value_type = TypeId(value = 14),
            is_mutable = false, is_weak = false, is_public = false,
            documentation = list[str](),
        )],
        deinitializer = SymbolId(value = 1),
    ))
    applications[25] = HirNominalApplication.EnumApplication(cases = choice_cases)
    applications[26] = HirNominalApplication.StructApplication(fields = [HirNominalField(
        name = "code", value_type = TypeId(value = 4),
        is_mutable = false, is_weak = false, is_public = true,
        documentation = list[str](),
    )])

    return types, HirNominalTables(
        structs = [
            HirStruct(
                module = ModuleId(value = 0), name = "Pair", is_public = true,
                documentation = ["Generic pair."], generic_id = 10,
                type_parameters = [HirTypeParameter(
                    name = "T", value_type = parameter, constraints = list[TypeId](),
                )],
                is_extern = false, fields = pair_fields, initializer = none, span = span(),
            ),
            HirStruct(
                module = ModuleId(value = 0), name = "NativePair", is_public = true,
                documentation = list[str](), generic_id = 0,
                type_parameters = list[HirTypeParameter](), is_extern = true,
                fields = native_fields, initializer = none, span = span(),
            ),
        ],
        classes = [HirClass(
            module = ModuleId(value = 0), name = "Owner", is_public = true,
            documentation = list[str](), generic_id = 0,
            type_parameters = list[HirTypeParameter](), fields = owner_fields,
            initializer = SymbolId(value = 0), deinitializer = SymbolId(value = 1), span = span(),
        )],
        enums = [HirEnum(
            module = ModuleId(value = 0), name = "Choice", is_public = true,
            documentation = list[str](), generic_id = 11,
            type_parameters = [HirTypeParameter(
                name = "U", value_type = choice_parameter, constraints = list[TypeId](),
            )],
            cases = choice_cases, span = span(),
        )],
        applications = applications,
    )

func encoded(types: TypeTable, tables: HirNominalTables) -> list[u8]:
    let writer = PackageWriter()
    write_nominal_tables(writer, tables, types, 1, 2, 0) catch reason:
        trap(reason)
    return writer.finish()

func decoded(input: list[u8], types: TypeTable) -> HirNominalTables:
    let reader = PackageReader(input)
    let tables = read_nominal_tables(reader, types, 1, 2, 0) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    return tables

func encoding_failure(
    types: TypeTable,
    tables: HirNominalTables,
    symbols: i64 = 2,
    nodes: i64 = 0,
) -> str:
    let writer = PackageWriter()
    var reported = ""
    write_nominal_tables(writer, tables, types, 1, symbols, nodes) catch reason:
        reported = reason
    return reported

func decoding_failure(input: list[u8], types: TypeTable) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_nominal_tables(reader, types, 1, 2, 0)) catch reason:
        reported = reason
    return reported

func generated_program(source: str) -> HirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let module = SourceModule(
        name = "model", path = "model.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )
    let program = HirGenerator("org.luce.nominal-codec", [module]).generate() catch reason:
        trap(reason)
    return program

# mark: Round trip =============================================================================

pub func test_package_nominal_codec_round_trips_declarations_and_applied_schemas():
    let types, tables = nominal_fixture()
    let restored = decoded(encoded(types, tables), types)
    assert(len(restored.structs) == 2)
    assert(restored.structs[0].name == "Pair")
    assert(restored.structs[0].type_parameters[0].value_type.value == 21)
    assert(restored.structs[1].is_extern)
    assert(restored.classes[0].initializer.value == 0)
    let deinitializer = restored.classes[0].deinitializer else trap("class deinitializer disappeared")
    assert(deinitializer.value == 1)
    assert(restored.enums[0].cases[1].payload[0].value_type.value == 24)
    let struct_application = restored.applications[22] else trap("struct application disappeared")
    match struct_application:
        StructApplication(fields): assert(fields[0].name == "value")
        else: assert(false)
    let class_application = restored.applications[23] else trap("class application disappeared")
    match class_application:
        ClassApplication(value):
            let concrete_deinitializer = value.deinitializer else trap("application deinitializer disappeared")
            assert(concrete_deinitializer.value == 1)
        else: assert(false)
    let enum_application = restored.applications[25] else trap("enum application disappeared")
    match enum_application:
        EnumApplication(cases): assert(cases[1].payload[0].name == "value")
        else: assert(false)

pub func test_package_nominal_codec_accepts_the_generators_exact_generic_and_weak_shapes():
    var source = "struct Pair[T]:\n"
    source += "    let value: T\n"
    source += "class Box[T]:\n"
    source += "    var value: T\n"
    source += "    weak var peer: Box[T]?\n"
    source += "    func init(self, value: T):\n"
    source += "        self.value = value\n"
    source += "        self.peer = none\n"
    source += "    func deinit(self):\n"
    source += "        return\n"
    source += "enum Choice[T]:\n"
    source += "    empty\n"
    source += "    some(value: T)\n"
    source += "pub func answer() -> i64:\n"
    source += "    let pair = Pair(value = 40)\n"
    source += "    let box = new Box(2)\n"
    source += "    let choice = Choice.some(0)\n"
    source += "    return pair.value + box.value\n"
    let program = generated_program(source)
    let tables = HirNominalTables(
        structs = program.structs,
        classes = program.classes,
        enums = program.enums,
        applications = program.nominal_applications,
    )
    let writer = PackageWriter()
    write_nominal_tables(
        writer, tables, program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    ) catch reason:
        trap(reason)
    let reader = PackageReader(writer.finish())
    let restored = read_nominal_tables(
        reader, program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    ) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    assert(len(restored.structs) == 1)
    assert(len(restored.classes) == 1)
    assert(restored.classes[0].fields[1].is_weak)
    assert(len(restored.enums) == 1)

# mark: Malformed graphs =======================================================================

pub func test_package_nominal_codec_rejects_bad_alignment_and_declaration_references():
    let types, tables = nominal_fixture()
    tables.applications.remove(len(tables.applications) - 1)
    assert(encoding_failure(types, tables) ==
        "typed package artifact: nominal application table must align with HIR TypeIds")

    let dangling_types, dangling_tables = nominal_fixture()
    dangling_types.definitions[22] = TypeDefinition(
        id = TypeId(value = 22), name = "Pair[T]",
        form = TypeForm.Struct(index = 7, arguments = [TypeId(value = 21)]),
    )
    assert(encoding_failure(dangling_types, dangling_tables) ==
        "typed package artifact: HIR struct type references a missing declaration")

    let parameter_types, parameter_tables = nominal_fixture()
    let item = parameter_tables.structs[0]
    parameter_tables.structs[0] = HirStruct(
        module = item.module, name = item.name, is_public = item.is_public,
        documentation = item.documentation, generic_id = item.generic_id,
        type_parameters = [HirTypeParameter(
            name = "T", value_type = TypeId(value = 5), constraints = list[TypeId](),
        )],
        is_extern = item.is_extern, fields = item.fields,
        initializer = item.initializer, span = item.span,
    )
    assert(encoding_failure(parameter_types, parameter_tables) ==
        "typed package artifact: generic parameter does not reference a TypeParameter")

    let duplicate_types, duplicate_tables = nominal_fixture()
    let choice = duplicate_tables.enums[0]
    duplicate_tables.enums[0] = HirEnum(
        module = choice.module, name = choice.name, is_public = choice.is_public,
        documentation = choice.documentation, generic_id = 10,
        type_parameters = choice.type_parameters, cases = choice.cases, span = choice.span,
    )
    assert(encoding_failure(duplicate_types, duplicate_tables) ==
        "typed package artifact: generic declaration identity is not unique")

pub func test_package_nominal_codec_rejects_bad_applied_metadata_and_symbols():
    let types, tables = nominal_fixture()
    tables.applications[22] = HirNominalApplication.StructApplication(fields = list[HirNominalField]())
    assert(encoding_failure(types, tables) ==
        "typed package artifact: nominal application field count does not match its declaration")

    let symbol_types, symbol_tables = nominal_fixture()
    let owner = symbol_tables.classes[0]
    symbol_tables.classes[0] = HirClass(
        module = owner.module, name = owner.name, is_public = owner.is_public,
        documentation = owner.documentation, generic_id = owner.generic_id,
        type_parameters = owner.type_parameters, fields = owner.fields,
        initializer = SymbolId(value = 9), deinitializer = owner.deinitializer, span = owner.span,
    )
    assert(encoding_failure(symbol_types, symbol_tables) ==
        "typed package artifact: HIR SymbolId references a missing table entry")

pub func test_package_nominal_codec_rejects_unknown_application_tags():
    let types = create_builtin_type_table()
    let applications = list[HirNominalApplication?]()
    for index in range(0, len(types.definitions)): applications.append(none)
    let empty = HirNominalTables(
        structs = list[HirStruct](), classes = list[HirClass](),
        enums = list[HirEnum](), applications = applications,
    )
    let input = encoded(types, empty)
    # Three empty declaration counts and the application count occupy 16 bytes.
    input[16] = 255
    assert(decoding_failure(input, types) ==
        "typed package artifact: unknown HIR nominal application tag 255")
