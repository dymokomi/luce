#==============================================================================================
#
#   package_identity_codec_test - Serialized HIR provenance and symbol identity
#
#   DESCRIPTION:
#       Round-trips every closed identity tag and rejects malformed package,
#       module, symbol, ownership, and type-reference graphs on both sides of
#       the artifact boundary.
#
#==============================================================================================

from luce.compiler.hir.ir import HirModule, HirPackage, HirSymbol, ModuleAuthority, ModuleId
from luce.compiler.hir.ir import PackageId, PackageRole, SymbolId, SymbolKind, TypeId
from luce.compiler.hir.ir import create_builtin_type_table
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.identity_codec import HirIdentityGraph, read_identity_graph, write_identity_graph

# mark: Fixtures ===============================================================================

func graph_with_all_tags() -> HirIdentityGraph:
    return HirIdentityGraph(
        packages = [
            HirPackage(id = PackageId(value = 0), identity = "org.luce.app", role = PackageRole.ordinary),
            HirPackage(id = PackageId(value = 1), identity = "org.luce.runtime", role = PackageRole.sealed_runtime),
        ],
        root_package = PackageId(value = 0),
        modules = [
            HirModule(
                id = ModuleId(value = 0),
                package = PackageId(value = 0),
                name = "main",
                path = "src/main.luc",
                authority = ModuleAuthority.safe,
                documentation = ["Application entry."],
            ),
            HirModule(
                id = ModuleId(value = 1),
                package = PackageId(value = 1),
                name = "arena",
                path = "src/arena.lucn",
                authority = ModuleAuthority.native,
                documentation = list[str](),
            ),
            HirModule(
                id = ModuleId(value = 2),
                package = PackageId(value = 0),
                name = "c",
                path = "src/standard/c.luc",
                authority = ModuleAuthority.standard,
                documentation = list[str](),
            ),
        ],
        symbols = [
            HirSymbol(
                id = SymbolId(value = 0), name = "run",
                kind = SymbolKind.function, value_type = TypeId(value = 0),
            ),
            HirSymbol(
                id = SymbolId(value = 1), name = "value",
                kind = SymbolKind.parameter, value_type = TypeId(value = 5),
            ),
            HirSymbol(
                id = SymbolId(value = 2), name = "temporary",
                kind = SymbolKind.local, value_type = TypeId(value = 14),
            ),
            HirSymbol(
                id = SymbolId(value = 3), name = "answer",
                kind = SymbolKind.constant, value_type = TypeId(value = 5),
            ),
            HirSymbol(
                id = SymbolId(value = 4), name = "arena_end",
                kind = SymbolKind.global, value_type = TypeId(value = 7),
            ),
        ],
    )

func type_count() -> i64:
    return len(create_builtin_type_table().definitions)

func encoded(graph: HirIdentityGraph) -> list[u8]:
    let writer = PackageWriter()
    write_identity_graph(writer, graph, type_count()) catch reason:
        trap(reason)
    return writer.finish()

func decoded(input: list[u8]) -> HirIdentityGraph:
    let reader = PackageReader(input)
    let graph = read_identity_graph(reader, type_count()) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    return graph

func encoding_failure(graph: HirIdentityGraph, available_types: i64 = -1) -> str:
    var count = available_types
    if count < 0: count = type_count()
    let writer = PackageWriter()
    var reported = ""
    write_identity_graph(writer, graph, count) catch reason:
        reported = reason
    return reported

func decoding_failure(input: list[u8]) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_identity_graph(reader, type_count())) catch reason:
        reported = reason
    return reported

# mark: Round trip =============================================================================

pub func test_package_identity_codec_round_trips_every_identity_tag():
    let original = graph_with_all_tags()
    let restored = decoded(encoded(original))
    assert(len(restored.packages) == 2)
    assert(restored.root_package.value == 0)
    assert(restored.packages[0].identity == "org.luce.app")
    assert(restored.packages[0].role == PackageRole.ordinary)
    assert(restored.packages[1].role == PackageRole.sealed_runtime)
    assert(restored.modules[0].authority == ModuleAuthority.safe)
    assert(len(restored.modules[0].documentation) == 1)
    assert(restored.modules[0].documentation[0] == "Application entry.")
    assert(restored.modules[1].authority == ModuleAuthority.native)
    assert(restored.modules[2].authority == ModuleAuthority.standard)
    assert(restored.symbols[0].kind == SymbolKind.function)
    assert(restored.symbols[1].kind == SymbolKind.parameter)
    assert(restored.symbols[2].kind == SymbolKind.local)
    assert(restored.symbols[3].kind == SymbolKind.constant)
    assert(restored.symbols[4].kind == SymbolKind.global)

# mark: Malformed graphs =======================================================================

pub func test_package_identity_codec_rejects_invalid_package_and_module_graphs():
    let valid = graph_with_all_tags()
    let empty = HirIdentityGraph(
        packages = list[HirPackage](),
        root_package = PackageId(value = 0),
        modules = valid.modules,
        symbols = valid.symbols,
    )
    assert(encoding_failure(empty) == "typed package artifact: HIR identity graph must contain a package")
    assert(encoding_failure(valid, 0) == "typed package artifact: HIR identity graph requires a type table")

    let wrong_package_id = graph_with_all_tags()
    wrong_package_id.packages[0] = HirPackage(
        id = PackageId(value = 7), identity = "org.luce.app", role = PackageRole.ordinary,
    )
    assert(encoding_failure(wrong_package_id) ==
        "typed package artifact: HIR PackageId does not match its table position")

    let duplicate_package = graph_with_all_tags()
    duplicate_package.packages[1] = HirPackage(
        id = PackageId(value = 1), identity = "org.luce.app", role = PackageRole.sealed_runtime,
    )
    assert(encoding_failure(duplicate_package) ==
        "typed package artifact: duplicate HIR package identity `org.luce.app`")

    let missing_root = graph_with_all_tags()
    let bad_root = HirIdentityGraph(
        packages = missing_root.packages,
        root_package = PackageId(value = 9),
        modules = missing_root.modules,
        symbols = missing_root.symbols,
    )
    assert(encoding_failure(bad_root) == "typed package artifact: HIR PackageId references a missing table entry")

    let wrong_module_id = graph_with_all_tags()
    let module = wrong_module_id.modules[0]
    wrong_module_id.modules[0] = HirModule(
        id = ModuleId(value = 2), package = module.package,
        name = module.name, path = module.path,
        authority = module.authority, documentation = module.documentation,
    )
    assert(encoding_failure(wrong_module_id) ==
        "typed package artifact: HIR ModuleId does not match its table position")

    let duplicate_module = graph_with_all_tags()
    duplicate_module.modules[1] = HirModule(
        id = ModuleId(value = 1), package = PackageId(value = 0),
        name = "main", path = "other/main.luc",
        authority = ModuleAuthority.safe, documentation = list[str](),
    )
    assert(encoding_failure(duplicate_module) == "typed package artifact: duplicate HIR module `main` in one package")

pub func test_package_identity_codec_rejects_invalid_symbol_graphs():
    let wrong_symbol_id = graph_with_all_tags()
    let symbol = wrong_symbol_id.symbols[0]
    wrong_symbol_id.symbols[0] = HirSymbol(
        id = SymbolId(value = 9), name = symbol.name,
        kind = symbol.kind, value_type = symbol.value_type,
    )
    assert(encoding_failure(wrong_symbol_id) ==
        "typed package artifact: HIR SymbolId does not match its table position")

    let empty_name = graph_with_all_tags()
    empty_name.symbols[0] = HirSymbol(
        id = SymbolId(value = 0), name = "",
        kind = SymbolKind.function, value_type = TypeId(value = 0),
    )
    assert(encoding_failure(empty_name) == "typed package artifact: HIR symbol name must not be empty")

    let dangling_type = graph_with_all_tags()
    dangling_type.symbols[0] = HirSymbol(
        id = SymbolId(value = 0), name = "run",
        kind = SymbolKind.function, value_type = TypeId(value = 999),
    )
    assert(encoding_failure(dangling_type) == "typed package artifact: HIR TypeId references a missing table entry")

pub func test_package_identity_codec_rejects_unknown_closed_tags():
    # One minimal graph has fixed offsets documented by its explicit fields.
    let minimal = HirIdentityGraph(
        packages = [HirPackage(id = PackageId(value = 0), identity = "app", role = PackageRole.ordinary)],
        root_package = PackageId(value = 0),
        modules = [HirModule(
            id = ModuleId(value = 0), package = PackageId(value = 0),
            name = "main", path = "main.luc",
            authority = ModuleAuthority.safe, documentation = list[str](),
        )],
        symbols = [HirSymbol(
            id = SymbolId(value = 0), name = "work",
            kind = SymbolKind.function, value_type = TypeId(value = 0),
        )],
    )

    let bad_role = encoded(minimal)
    bad_role[15] = 255
    assert(decoding_failure(bad_role) == "typed package artifact: unknown package role tag 255")

    let bad_authority = encoded(minimal)
    bad_authority[52] = 255
    assert(decoding_failure(bad_authority) == "typed package artifact: unknown module authority tag 255")

    let bad_kind = encoded(minimal)
    bad_kind[73] = 255
    assert(decoding_failure(bad_kind) == "typed package artifact: unknown HIR symbol kind tag 255")
