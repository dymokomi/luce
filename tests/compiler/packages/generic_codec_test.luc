#==============================================================================================
#
#   package_generic_codec_test - Retained typed generic declarations and bodies
#
#   DESCRIPTION:
#       Round-trips generator-produced abstract bodies, including deferred
#       calls, requirements, existential conversion, defaults, closures, and
#       local symbol metadata. The second encoding must be byte-identical.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirGenericFunction, HirNode, HirNodeForm, HirProgram, ModuleAuthority
from luce.compiler.hir.ir import BoxedValue, ListStorage, NodeId, Operands, SymbolId, Value, no_node
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.generic_codec import read_generic_functions, write_generic_functions
from luce.compiler.packages.generic_validation import HirGenericValidationContext
from luce.compiler.packages.literal_codec import read_literal, write_literal
from luce.compiler.packages.node_codec import read_hir_node
import std.files

# mark: Helpers ================================================================================

func generated(source: str) -> HirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let module = SourceModule(
        name = "model", path = "model.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )
    let program = HirGenerator("org.luce.generic-codec", [module]).generate() catch reason:
        trap(reason)
    return program

func validation_context(program: HirProgram) -> HirGenericValidationContext:
    return HirGenericValidationContext(
        types = program.types,
        package_count = len(program.packages),
        module_count = len(program.modules),
        symbol_count = len(program.symbols),
        extern_variable_count = len(program.extern_variables),
        global_count = len(program.globals),
        struct_count = len(program.structs),
        enum_count = len(program.enums),
        interfaces = program.interfaces,
        functions = program.functions,
        nominal_applications = program.nominal_applications,
    )

func encode(values: list[HirGenericFunction], context: HirGenericValidationContext) -> list[u8]:
    let writer = PackageWriter()
    write_generic_functions(writer, values, context) catch reason:
        trap(reason)
    return writer.finish()

func decode(input: list[u8], context: HirGenericValidationContext) -> list[HirGenericFunction]:
    let reader = PackageReader(input)
    let values = read_generic_functions(reader, context) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    return values

func decoding_failure(input: list[u8], context: HirGenericValidationContext) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_generic_functions(reader, context)) catch reason:
        reported = reason
    return reported

func bytes_match(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

func validation_failure(program: HirProgram) -> str:
    let writer = PackageWriter()
    var reported = ""
    write_generic_functions(writer, program.generic_functions, validation_context(program)) catch reason:
        reported = reason
    return reported

# mark: Generator round trip ===================================================================

pub func test_package_generic_codec_round_trips_retained_typed_bodies_canonically():
    var source = "interface Scored:\n"
    source += "    func score(self) -> i64\n"
    source += "interface Erased:\n"
    source += "    func erase(self) -> Erased\n"
    source += "struct Item implements Scored:\n"
    source += "    let value: i64\n"
    source += "    pub func score(self) -> i64: return self.value\n"
    source += "struct Box[T] implements Erased:\n"
    source += "    let value: T\n"
    source += "    func init(self, value: T): self.value = value\n"
    source += "    pub func erase(self) -> Erased: return self\n"
    source += "func identity[T](value: T) -> T: return value\n"
    source += "func constant[T](value: T) -> func() -> i64: return () => 1\n"
    source += "func apply[T](value: T, operation: func(T) -> T = identity) -> T:\n"
    source += "    return operation(value)\n"
    source += "func relay[T: Scored](value: T) -> Box[T]:\n"
    source += "    var current = value\n"
    source += "    let read: func() -> T = () => current\n"
    source += "    if value.score() > 0:\n"
    source += "        current = apply(value)\n"
    source += "    return Box(read())\n"
    source += "pub func answer() -> i64: return relay(Item(value = 42)).value.score()\n"
    let program = generated(source)
    let context = validation_context(program)
    let first = encode(program.generic_functions, context)
    let restored = decode(first, context)
    let second = encode(restored, context)
    assert(bytes_match(first, second))
    assert(len(restored) == 6)

    var saw_deferred_call = false
    var saw_requirement = false
    var saw_generic_interface = false
    var saw_default = false
    var saw_closure = false
    var saw_capture_free = false
    for generic in restored:
        if generic.name == "apply" and len(generic.body.defaults) == 2: saw_default = true
        if generic.name == "relay" and len(generic.body.closures) == 1 and len(generic.body.generated_functions) == 1: saw_closure = true
        if generic.name == "constant" and len(generic.body.closures) == 1 and len(generic.body.generated_functions) == 1 and generic.body.generated_functions[0].closure == none: saw_capture_free = true
        for node in generic.body.arena.nodes:
            match node.form:
                GenericCall(generic_index, type_arguments, arguments, kind): saw_deferred_call = true
                GenericRequirementCall(interface_type, requirement, arguments): saw_requirement = true
                GenericInterfaceValue(value): saw_generic_interface = true
                else: pass
    assert(saw_deferred_call)
    assert(saw_requirement)
    assert(saw_generic_interface)
    assert(saw_default)
    assert(saw_closure)
    assert(saw_capture_free)

pub func test_every_executable_generic_example_satisfies_the_package_body_contract():
    let paths = [
        "examples/generic_functions.luc",
        "examples/generic_methods.luc",
        "examples/generic_construction.luc",
        "examples/constrained_generics.luc",
        "examples/generic_enums.luc",
        "examples/generic_classes.luc",
    ]
    for path in paths:
        let source = files.read(path) catch reason:
            trap(reason)
        let program = generated(source)
        let context = validation_context(program)
        let first = encode(program.generic_functions, context)
        assert(bytes_match(first, encode(decode(first, context), context)))

# mark: Malformed bodies =======================================================================

pub func test_package_generic_codec_rejects_invalid_arena_and_semantic_references():
    let parallel = generated("func identity[T](value: T) -> T: return value\n")
    parallel.generic_functions[0].body.arena.node_types.remove(0)
    assert(validation_failure(parallel) ==
        "typed package artifact: HIR arena parallel tables have different lengths")

    let dangling = generated("func identity[T](value: T) -> T: return value\n")
    let arena = dangling.generic_functions[0].body.arena
    arena.nodes.append(HirNode(form = HirNodeForm.GenericFunctionAddress(
        generic = 99, type_arguments = Operands(start = 0, count = 0),
    )))
    arena.node_types.append(arena.node_types[0])
    arena.node_modules.append(arena.node_modules[0])
    arena.node_spans.append(arena.node_spans[0])
    assert(validation_failure(dangling) ==
        "typed package artifact: HIR generic function references a missing table entry")

    let cyclic = generated("func identity[T](value: T) -> T: return value\n")
    let cyclic_arena = cyclic.generic_functions[0].body.arena
    let owner = u32(len(cyclic_arena.nodes))
    cyclic_arena.nodes.append(HirNode(form = HirNodeForm.PrintValue(value = NodeId(value = owner))))
    cyclic_arena.node_types.append(cyclic_arena.node_types[0])
    cyclic_arena.node_modules.append(cyclic_arena.node_modules[0])
    cyclic_arena.node_spans.append(cyclic_arena.node_spans[0])
    assert(validation_failure(cyclic) ==
        "typed package artifact: retained HIR child does not precede its owner")

    let decoded = generated("func identity[T](value: T) -> T: return value\n")
    let context = validation_context(decoded)
    let artifact_bytes = encode(decoded.generic_functions, context)
    # The table count occupies bytes 0...3; the first declaration symbol is
    # the following u32. Forge a missing semantic identity after encoding to
    # prove the read path performs the same closed validation transaction.
    for index in range(4, 8): artifact_bytes[index] = u8(255)
    assert(decoding_failure(artifact_bytes, context) ==
        "typed package artifact: HIR SymbolId references a missing table entry")

pub func test_package_generic_codec_rejects_inconsistent_defaults_and_closure_ownership():
    let defaults = generated("func choose[T](value: T, fallback: T? = none) -> T: return fallback else value\n")
    defaults.generic_functions[0].body.defaults[1] = NodeId(value = no_node)
    assert(validation_failure(defaults) ==
        "typed package artifact: generic signature default does not match its retained body")

    let closures = generated("func capture[T](value: T) -> func() -> T: return () => value\n")
    closures.generic_functions[0].body.shared_cells.append(SymbolId(value = 0xFFFFFFFF))
    assert(validation_failure(closures) ==
        "typed package artifact: HIR SymbolId references a missing table entry")

pub func test_package_body_wire_tags_and_literals_fail_closed():
    let node_reader = PackageReader([u8(255)])
    var node_failure = ""
    discard(read_hir_node(node_reader)) catch reason:
        node_failure = reason
    assert(node_failure == "typed package artifact: unknown retained HIR node tag 255")

    let literal_reader = PackageReader([u8(255)])
    var literal_failure = ""
    discard(read_literal(literal_reader)) catch reason:
        literal_failure = reason
    assert(literal_failure == "typed package artifact: unknown retained HIR literal tag 255")

    let scalar_reader = PackageReader([u8(5), u8(0), u8(216), u8(0), u8(0)])
    var scalar_failure = ""
    discard(read_literal(scalar_reader)) catch reason:
        scalar_failure = reason
    assert(scalar_failure == "typed package artifact: character literal is not a Unicode scalar")

    let writer = PackageWriter()
    var runtime_failure = ""
    write_literal(writer, Value.List(storage = ListStorage(list[BoxedValue]()))) catch reason:
        runtime_failure = reason
    assert(runtime_failure == "typed package artifact: retained HIR value is not a serializable literal")
