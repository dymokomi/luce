#==============================================================================================
#
#   package_executable_codec_test - Complete program-owned HIR table contract
#
#   DESCRIPTION:
#       Uses one real generated package to round-trip constants, externs,
#       globals, closures/cells, concrete generic provenance, and every
#       function implementation. All runtime-service wire tags are exercised
#       as one closed vocabulary, and malformed tags fail immediately.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirGenericInstance, HirProgram, HirRuntimeBinding, ModuleAuthority, PackageRole
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.executable_codec import HirExecutableTables, HirExecutableValidationContext
from luce.compiler.packages.executable_codec import read_executable_tables, validate_executable_tables
from luce.compiler.packages.executable_codec import write_executable_tables
from luce.compiler.runtime_contract import RuntimeService

# mark: Fixtures ===============================================================================

func generated() -> HirProgram:
    var source = "pub let base: i64 = 21\n"
    source += "var state: i64\n"
    source += "pub extern type Handle = i32\n"
    source += "pub extern var native_count: i32\n"
    source += "extern blocking func split(value: i32, out rest: i32) -> i32\n"
    source += "export c func twice(value: i32) -> i32: return value * 2i32\n"
    source += "func identity[T](value: T) -> T: return value\n"
    source += "func answer() -> i64:\n"
    source += "    var value = base\n"
    source += "    let read: func() -> i64 = () => value\n"
    source += "    return identity(read())\n"
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let program = HirGenerator(
        "org.luce.executable-codec",
        [SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax)],
        PackageRole.sealed_runtime,
    ).generate() catch reason:
        trap(reason)
    return program

func all_services() -> list[RuntimeService]:
    return [
        RuntimeService.storage_allocator, RuntimeService.storage_deallocator,
        RuntimeService.equality_context_create, RuntimeService.equality_context_release,
        RuntimeService.equality_context_visit, RuntimeService.hash_create,
        RuntimeService.hash_retain, RuntimeService.hash_release, RuntimeService.hash_copy,
        RuntimeService.hash_length, RuntimeService.hash_iteration_begin,
        RuntimeService.hash_iteration_end, RuntimeService.hash_find_first,
        RuntimeService.hash_find_next, RuntimeService.hash_key_address,
        RuntimeService.hash_value_address, RuntimeService.hash_insert_entry,
        RuntimeService.hash_remove_entry, RuntimeService.hash_clear, RuntimeService.hash_reserve,
        RuntimeService.list_create, RuntimeService.list_retain, RuntimeService.list_release,
        RuntimeService.list_copy, RuntimeService.list_concat, RuntimeService.list_length,
        RuntimeService.list_iteration_begin, RuntimeService.list_iteration_end,
        RuntimeService.list_mutable_slice_begin, RuntimeService.list_iteration_active,
        RuntimeService.list_append_slot, RuntimeService.list_insert_slot,
        RuntimeService.list_remove_at, RuntimeService.list_clear, RuntimeService.list_reserve,
        RuntimeService.list_element_address, RuntimeService.list_mutable_element_address,
        RuntimeService.list_slice, RuntimeService.buffer_retain, RuntimeService.buffer_release,
        RuntimeService.buffer_concat, RuntimeService.buffer_data, RuntimeService.buffer_length,
        RuntimeService.buffer_builder_create, RuntimeService.buffer_builder_append,
        RuntimeService.buffer_builder_finish, RuntimeService.c_string_copy,
        RuntimeService.display_signed, RuntimeService.display_unsigned,
        RuntimeService.display_float32, RuntimeService.display_float64,
        RuntimeService.display_character, RuntimeService.display_boolean,
        RuntimeService.string_scalar_count, RuntimeService.string_decode,
        RuntimeService.bytes_slice, RuntimeService.slice_retain, RuntimeService.slice_release,
        RuntimeService.slice_length, RuntimeService.slice_element_address,
        RuntimeService.class_create, RuntimeService.class_mark_initialized,
        RuntimeService.class_retain, RuntimeService.class_release, RuntimeService.class_payload,
        RuntimeService.weak_class_create, RuntimeService.weak_class_retain,
        RuntimeService.weak_class_release, RuntimeService.weak_class_promote,
        RuntimeService.interface_create, RuntimeService.interface_retain,
        RuntimeService.interface_release, RuntimeService.interface_detach,
        RuntimeService.interface_payload, RuntimeService.interface_witness,
        RuntimeService.hash_entry_hash,
    ]

func tables(program: HirProgram) -> HirExecutableTables:
    let bindings = list[HirRuntimeBinding]()
    for service in all_services():
        bindings.append(HirRuntimeBinding(service = service, function = program.functions[1].symbol))
    return HirExecutableTables(
        runtime_bindings = bindings,
        constants = program.constants,
        extern_types = program.extern_types,
        extern_variables = program.extern_variables,
        globals = program.globals,
        closures = program.closures,
        shared_cells = program.shared_cells,
        generic_instances = program.generic_instances,
        generic_specialization_budget = program.generic_specialization_budget,
        functions = program.functions,
    )

func context(program: HirProgram) -> HirExecutableValidationContext:
    return HirExecutableValidationContext(
        types = program.types,
        symbols = program.symbols,
        module_count = len(program.modules),
        node_count = len(program.nodes),
        extra_count = len(program.extra),
        generic_count = len(program.generic_functions),
    )

func bytes_match(left: list[u8], right: list[u8]) -> bool:
    if len(left) != len(right): return false
    for index in range(0, len(left)):
        if left[index] != right[index]: return false
    return true

# mark: Canonical round trip ===================================================================

pub func test_package_executable_codec_round_trips_every_owned_table_and_runtime_tag():
    let program = generated()
    let original = tables(program)
    validate_executable_tables(original, context(program)) catch reason:
        trap(reason)
    let writer = PackageWriter()
    write_executable_tables(writer, original) catch reason:
        trap(reason)
    let first = writer.finish()

    let reader = PackageReader(first)
    let restored = read_executable_tables(reader) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    validate_executable_tables(restored, context(program)) catch reason:
        trap(reason)
    assert(len(restored.runtime_bindings) == 76)
    assert(len(restored.constants) == 1)
    assert(len(restored.extern_types) == 1)
    assert(len(restored.extern_variables) == 1)
    assert(len(restored.globals) == 1)
    assert(len(restored.closures) == 1)
    assert(len(restored.shared_cells) == 1)
    assert(len(restored.generic_instances) == 1)

    let second_writer = PackageWriter()
    write_executable_tables(second_writer, restored) catch reason:
        trap(reason)
    assert(bytes_match(first, second_writer.finish()))

# mark: Malformed tables =======================================================================

pub func test_package_executable_codec_rejects_unknown_runtime_tags_and_bad_provenance():
    var unknown = ""
    discard(read_executable_tables(PackageReader([1, 0, 0, 0, 255]))) catch reason:
        unknown = reason
    assert(unknown == "typed package artifact: unknown HIR runtime service tag 255")

    let program = generated()
    let invalid = tables(program)
    let instance = invalid.generic_instances[0]
    invalid.generic_instances[0] = HirGenericInstance(
        generic = instance.generic, function = instance.function, arguments = instance.arguments,
        origin_module = instance.origin_module, origin_span = instance.origin_span,
        parent = u32(0), checked_nodes = instance.checked_nodes,
        check_time_ms = instance.check_time_ms,
    )
    var reported = ""
    validate_executable_tables(invalid, context(program)) catch reason:
        reported = reason
    assert(reported == "typed package artifact: concrete generic instance parent does not precede it")
