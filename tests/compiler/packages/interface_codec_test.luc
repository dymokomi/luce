#==============================================================================================
#
#   package_interface_codec_test - Serialized contracts and conformances
#
#   DESCRIPTION:
#       Uses the real HIR generator to round-trip generic interface schemas,
#       concrete applications, and explicit implementations, then corrupts
#       each identity edge and closed tag to prove strict rejection.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import HirInterface, HirInterfaceOrigin, HirProgram, ModuleAuthority, ModuleId
from luce.compiler.hir.ir import create_builtin_type_table
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.interface_codec import HirInterfaceTables
from luce.compiler.packages.interface_codec import read_interface_tables, write_interface_tables

# mark: Fixtures ===============================================================================

func generated_program() -> HirProgram:
    var source = "## A value-producing contract.\n\n"
    source += "pub interface Value[T]:\n"
    source += "    ## Return this value or its fallback.\n"
    source += "    func get(self, fallback: T) -> T\n"
    source += "pub struct Score implements Value[i64]:\n"
    source += "    let value: i64\n"
    source += "    pub func get(self, fallback: i64) -> i64:\n"
    source += "        return self.value\n"
    source += "pub struct Label implements Value[str]:\n"
    source += "    let value: str\n"
    source += "    pub func get(self, fallback: str) -> str:\n"
    source += "        return self.value\n"
    source += "pub func answer() -> i64:\n"
    source += "    let score = Score(value = 42)\n"
    source += "    return score.get(0)\n"
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let module = SourceModule(
        name = "values", path = "values.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )
    let program = HirGenerator("org.luce.interface-codec", [module]).generate() catch reason:
        trap(reason)
    return program

func tables_of(program: HirProgram) -> HirInterfaceTables:
    return HirInterfaceTables(
        interfaces = program.interfaces,
        applications = program.interface_applications,
        conformances = program.conformances,
    )

func encoded(program: HirProgram, tables: HirInterfaceTables) -> list[u8]:
    let writer = PackageWriter()
    write_interface_tables(
        writer, tables, program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    ) catch reason:
        trap(reason)
    return writer.finish()

func decoded(input: list[u8], program: HirProgram) -> HirInterfaceTables:
    let reader = PackageReader(input)
    let tables = read_interface_tables(
        reader, program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    ) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    return tables

func encoding_failure(program: HirProgram, tables: HirInterfaceTables) -> str:
    let writer = PackageWriter()
    var reported = ""
    write_interface_tables(
        writer, tables, program.types,
        len(program.modules), len(program.symbols), len(program.nodes),
    ) catch reason:
        reported = reason
    return reported

func decoding_failure(input: list[u8]) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_interface_tables(reader, create_builtin_type_table(), 1, 1, 0)) catch reason:
        reported = reason
    return reported

# mark: Round trip =============================================================================

pub func test_package_interface_codec_round_trips_generated_generic_contracts():
    let program = generated_program()
    let restored = decoded(encoded(program, tables_of(program)), program)
    assert(len(restored.interfaces) == 1)
    assert(restored.interfaces[0].name == "Value")
    assert(restored.interfaces[0].is_public)
    assert(len(restored.interfaces[0].type_parameters) == 1)
    assert(restored.interfaces[0].requirements[0].name == "get")
    assert(restored.interfaces[0].requirements[0].parameters[0].name == "fallback")
    assert(len(restored.applications) == 2)
    assert(len(restored.conformances) == 2)
    assert(len(restored.conformances[0].implementations) == 1)

# mark: Malformed graphs =======================================================================

pub func test_package_interface_codec_rejects_bad_origins_and_applications():
    let program = generated_program()
    let bad_origin = tables_of(program)
    let contract = bad_origin.interfaces[0]
    bad_origin.interfaces[0] = HirInterface(
        origin = HirInterfaceOrigin.Source(module = ModuleId(value = 9)),
        name = contract.name, is_public = contract.is_public,
        documentation = contract.documentation, generic_id = contract.generic_id,
        type_parameters = contract.type_parameters,
        requirements = contract.requirements, span = contract.span,
    )
    assert(encoding_failure(program, bad_origin) ==
        "typed package artifact: HIR ModuleId references a missing table entry")

    let duplicate_program = generated_program()
    let duplicate = tables_of(duplicate_program)
    duplicate.applications[1] = duplicate.applications[0]
    assert(encoding_failure(duplicate_program, duplicate) ==
        "typed package artifact: duplicate interface application TypeId")

pub func test_package_interface_codec_rejects_bad_conformance_implementation_counts():
    let program = generated_program()
    let tables = tables_of(program)
    tables.conformances[0].implementations.remove(0)
    assert(encoding_failure(program, tables) ==
        "typed package artifact: conformance implementation count does not match its interface")

pub func test_package_interface_codec_rejects_unknown_closed_origin_tags():
    # A one-entry interface table reaches its origin immediately after count.
    assert(decoding_failure([1, 0, 0, 0, 255]) ==
        "typed package artifact: unknown HIR interface origin tag 255")
    assert(decoding_failure([1, 0, 0, 0, 1, 255]) ==
        "typed package artifact: unknown standard interface tag 255")
