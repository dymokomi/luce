pub func test_string_operations_keep_owned_bytes_and_unicode_semantics_explicit():
    let source = "func joined(left: str, right: str) -> str: return left + right\npub func answer() -> u64:\n    let text = joined(\"a\", \"λ😀\")\n    var count = text.length()\n    for character in text:\n        if character == 'λ': count += 10u64\n    return count\n"
    let program = lowered(source)
    var saw_concat = false
    var saw_count = false
    var saw_decode = false
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                BufferConcat(result, left_data, left_length, right_data, right_length): saw_concat = true
                StringScalarCount(result, data, length): saw_count = true
                StringDecode(character, width, data, length, offset): saw_decode = true
                else: pass
    assert(saw_concat and saw_count and saw_decode)
    assert(agree(source) == "13")

pub func test_bytes_index_lowers_to_structural_bounds_check_and_element_address():
    # Runtime composition happens after application lowering. Inspect this
    # pre-composition program directly; bytes ownership bindings are supplied
    # by the sealed runtime before the verifier/backend boundary.
    let program = Lowerer(checked("pub func answer() -> u8: return b\"abc\"[1u64]\n")).lower() catch reason:
        trap(reason)
    let function_index = find_mir_function(program, "main.answer")
    assert(function_index >= 0)
    let function = program.functions[function_index]
    var compared = false
    var addressed = false
    var trapped = false
    for instruction in function.body:
        match instruction.form:
            Binary(result, operation, left, right):
                if operation == BinaryOp.lt: compared = true
            ElementAddress(result, element_type, base, index):
                assert(is_type(element_type, BuiltinMirType.unsigned_u8))
                addressed = true
            Trap(reason):
                assert(reason == "index out of bounds")
                trapped = true
            else: pass
    assert(compared and addressed and trapped)

pub func test_fixed_arrays_lower_once_to_canonical_array_layout_and_checked_elements():
    let source = "pub func answer() -> i64:\n    var values: array[i64, 2] = [4, 2]\n    values[1u64] += 5\n    return values[0u64] * 10 + values[1u64]\n"
    let program = lowered(source)
    let function = only_function(program)
    match program.types.definitions[function.slots[0].value_type.value]:
        Array(element, count):
            assert(is_type(element, BuiltinMirType.signed_i64))
            assert(count == 2)
        else: assert(false)
    var addressed = 0
    var trapped = 0
    for instruction in function.body:
        match instruction.form:
            ElementAddress(result, element_type, base, index):
                assert(is_type(element_type, BuiltinMirType.signed_i64))
                addressed += 1
            Trap(reason):
                if reason == "index out of bounds": trapped += 1
            else: pass
    assert(addressed >= 5)
    assert(trapped == 3)
    assert(agree(source) == "47")

    let nested = "type Row = array[i64, 2]\nstruct Grid:\n    var rows: array[Row, 2]\npub func answer() -> i64:\n    var grid = Grid(rows = [[1, 2], [3, 4]])\n    var copy = grid\n    copy.rows[1u64][0u64] += 5\n    if grid == copy: return 0\n    return grid.rows[1u64][0u64] * 10 + copy.rows[1u64][0u64]\n"
    assert(agree(nested) == "38")
    assert(agree("pub func answer() -> u64:\n    let values: array[i64, 0] = []\n    return values.length\n") == "0")

    # The type count drives a runtime loop; it must not multiply MIR size.
    let scalable = only_function(lowered("pub func same(left: array[i64, 1000000], right: array[i64, 1000000]) -> bool: return left == right\n"))
    var equality_addresses = 0
    var equality_loops = 0
    for instruction in scalable.body:
        match instruction.form:
            ElementAddress(result, element_type, base, index): equality_addresses += 1
            Loop: equality_loops += 1
            else: pass
    assert(equality_addresses == 2)
    assert(equality_loops == 1)
    assert(len(scalable.body) < 30)

pub func test_fixed_array_loads_and_stores_trap_on_out_of_bounds_indices():
    both_trap("pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    return values[2u64]\n")
    both_trap("pub func answer() -> i64:\n    var values: array[i64, 2] = [1, 2]\n    values[2u64] = 3\n    return 0\n")

pub func test_fixed_array_slices_copy_into_the_shared_immutable_snapshot_protocol():
    let source = "func view() -> slice[list[i64]]:\n    let left: list[i64] = [20]\n    let right: list[i64] = [22]\n    let values: array[list[i64], 2] = [left, right]\n    return values[0u64..<2u64]\npub func answer() -> i64:\n    let values = view()\n    return values[0u64][0u64] + values[1u64][0u64]\n"
    assert(agree(source) == "42")
    let program = lowered(source)
    var created = 0
    var appended = 0
    var reserved = 0
    var sliced = 0
    var released = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                ListCreate(result): created += 1
                ListAppendSlot(result, value, element_retain): appended += 1
                ListReserve(value, minimum_capacity, element_retain): reserved += 1
                ListSlice(result, value, start, end): sliced += 1
                ListRelease(value, element_release): released += 1
                else: pass
    # Two source list literals plus one private snapshot builder.
    assert(created == 3)
    # The selected range is copied by one runtime loop, so its source length
    # never duplicates append instructions in MIR.
    assert(appended == 3)
    assert(reserved == 1)
    assert(sliced == 1)
    assert(released >= 1)

    both_trap("pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    let view = values[1u64..<3u64]\n    return view[0u64]\n")
    both_trap("pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    let view = values[2u64..<1u64]\n    return view[0u64]\n")

# mark: Structs, classes, and methods ==========================================================

pub func test_classes_lower_to_nominal_handles_payload_operations_and_exact_lifecycle():
    let source = "class Node:\n    let name: str\n    var value: i64\n    weak var parent: Node?\n\n    func init(self, name: str, value: i64, parent: Node?):\n        self.name = name\n        self.value = value\n        self.parent = parent\n\n    func increment(self): self.value += 1\n    func deinit(self): return\n\npub func answer() -> i64:\n    let parent = new Node(\"parent\", 40, none)\n    let child = new Node(\"child\", 1, parent)\n    let alias = child\n    alias.increment()\n    if not (alias is child): return 0\n    if let live = child.parent:\n        return live.value + child.value\n    return 0\n"
    let program = lowered(source)
    assert(len(program.classes) == 1)
    assert(len(program.classes[0].fields) == 3)
    match mir_type(program.types, program.classes[0].fields[2].storage_type):
        WeakClass(identity): assert(identity.value == 0)
        else: assert(false)

    var created = 0
    var initialized = 0
    var class_fields = 0
    var weak_created = 0
    var promoted = 0
    var retained = 0
    var released = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                ClassCreate(result, identity):
                    assert(identity.value == 0)
                    created += 1
                ClassMarkInitialized(value): initialized += 1
                ClassFieldAddress(result, value, field): class_fields += 1
                WeakClassCreate(result, value): weak_created += 1
                WeakClassPromote(destination, value, optional_type): promoted += 1
                ClassRetain(value): retained += 1
                ClassRelease(value): released += 1
                else: pass
    assert(created == 2 and initialized == 2)
    assert(class_fields > 0 and weak_created == 1 and promoted == 1)
    assert(retained > 0 and released > 0)

    let destroyer = program.functions[program.classes[0].destroyer.value]
    assert(len(destroyer.signature.parameters) == 2)
    match mir_type(program.types, destroyer.signature.parameters[0]):
        Class(identity): assert(identity.value == 0)
        else: assert(false)
    assert(is_type(destroyer.signature.parameters[1], BuiltinMirType.boolean))
    var calls_deinit = false
    for instruction in destroyer.body:
        match instruction.form:
            Call(results, function, arguments): calls_deinit = true
            else: pass
    assert(calls_deinit)
    assert(agree(source) == "42")

pub func test_class_destruction_and_failed_initialization_agree_between_both_oracles():
    let destruction = "class Child:\n    let events: list[i64]\n    let value: i64\n\n    func init(self, events: list[i64], value: i64):\n        self.events = events\n        self.value = value\n\n    func deinit(self): self.events.append(self.value)\n\nclass Parent:\n    let events: list[i64]\n    let first: Child\n    let second: Child\n\n    func init(self, events: list[i64]):\n        self.events = events\n        self.first = new Child(events, 1)\n        self.second = new Child(events, 2)\n\n    func deinit(self): self.events.append(0)\n\npub func answer() -> i64:\n    let events = list[i64]()\n    if true:\n        let parent = new Parent(events)\n    if events.length != 3u64: return 0\n    return events[0u64] * 100 + events[1u64] * 10 + events[2u64]\n"
    assert(agree(destruction) == "21")

    let failure = "let invalid: ErrorCode = ErrorCode.package(1)\nclass Child:\n    let events: list[i64]\n    func init(self, events: list[i64]): self.events = events\n    func deinit(self): self.events.append(1)\n\nclass Parent:\n    let events: list[i64]\n    let child: Child\n    func init(self, events: list[i64]) -> unit!:\n        self.events = events\n        self.child = new Child(events)\n        error(invalid, \"failed\")\n    func deinit(self): self.events.append(9)\n\nfunc attempt(events: list[i64]) -> i64!:\n    let parent = try new Parent(events)\n    return 0\n\npub func answer() -> i64:\n    let events = list[i64]()\n    let ignored = attempt(events) catch failure: recover 0\n    if events.length != 1u64: return 0\n    return 42 if events[0u64] == 1 else 0\n"
    assert(agree(failure) == "42")

pub func test_deinitializer_helper_methods_keep_the_dying_receiver_borrowed():
    let source = "class Resource:\n    let events: list[i64]\n    var closed: bool\n\n    func init(self, events: list[i64]):\n        self.events = events\n        self.closed = false\n\n    func close(self):\n        if not self.closed:\n            self.events.append(42)\n            self.closed = true\n\n    func deinit(self): self.close()\n\npub func answer() -> i64:\n    let events = list[i64]()\n    if true:\n        let resource = new Resource(events)\n    return events[0u64]\n"
    let analyzed = checked(source)
    assert(len(analyzed.borrowed_receiver_methods) == 2)
    let program = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    verify_application(program)

    let close = program.functions[find_mir_function(program, "main.Resource.close")]
    for instruction in close.body:
        match instruction.form:
            ClassRetain(value): assert(false)
            ClassRelease(value): assert(false)
            else: pass
    assert(agree(source) == "42")

pub func test_deinitializer_converts_borrowed_self_directly_at_weak_sinks():
    let source = "class Observer:\n    weak var target: Target?\n\n    func init(self): self.target = none\n\nclass Target:\n    let observer: Observer\n\n    func init(self, observer: Observer): self.observer = observer\n    func deinit(self):\n        self.observer.target = self if true else none\n        self.observer.target = self.observer.target else self\n\npub func answer() -> i64:\n    let observer = new Observer()\n    if true:\n        let target = new Target(observer)\n    if let live = observer.target: return 0\n    return 42\n"
    let program = lowered(source)
    let destroy = program.functions[find_mir_function(program, "main.Target.deinit")]
    var created_weak = 0
    for instruction in destroy.body:
        match instruction.form:
            WeakClassCreate(result, value): created_weak += 1
            ClassRetain(value):
                match mir_type(program.types, destroy.registers[value.value]):
                    Class(identity): assert(identity.value != 1)
                    else: assert(false)
            ClassRelease(value):
                match mir_type(program.types, destroy.registers[value.value]):
                    Class(identity): assert(identity.value != 1)
                    else: assert(false)
            else: pass
    # One conditional source and both structural `else` paths are explicit in
    # MIR; only the selected path executes.
    assert(created_weak == 3)
    assert(agree(source) == "42")

pub func test_weak_promotion_observes_death_before_deinitializer_fallbacks():
    let source = "class Observer:\n    weak var target: Target?\n\n    func init(self): self.target = none\n\nclass Target:\n    let observer: Observer\n    let replacement: Target?\n\n    func init(self, observer: Observer, replacement: Target?):\n        self.observer = observer\n        self.replacement = replacement\n\n    func deinit(self):\n        self.observer.target = self\n        self.observer.target = self.observer.target else (self.replacement else self)\n\npub func answer() -> i64:\n    let observer = new Observer()\n    let survivor = new Target(observer, none)\n    if true:\n        let dying = new Target(observer, survivor)\n    if let live = observer.target:\n        return 42 if live is survivor else 0\n    return 0\n"
    assert(agree(source) == "42")

pub func test_first_class_weak_values_compose_with_reference_collections():
    let source = "class Observer:\n    let events: list[i64]\n    let value: i64\n\n    func init(self, events: list[i64], value: i64):\n        self.events = events\n        self.value = value\n\n    func deinit(self): self.events.append(self.value)\n\npub func answer() -> i64:\n    let events = list[i64]()\n    let observers = list[Weak[Observer]]()\n    if true:\n        let observer = new Observer(events, 42)\n        observers.append(Weak(observer))\n        let copied = observers[0u64]\n        if let live = copied.get():\n            if live.value != 42: return 0\n        else: return 0\n    if events.length != 1u64 or events[0u64] != 42: return 0\n    for entry in observers:\n        if let live = entry.get(): return 0\n    return 42\n"
    let program = lowered(source)
    var created = 0
    var promoted = 0
    var retained = 0
    var released = 0
    for definition in program.types.definitions:
        match definition:
            WeakClass(identity): assert(identity.value == 0)
            else: pass
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                WeakClassCreate(result, value): created += 1
                WeakClassPromote(destination, value, optional_type): promoted += 1
                WeakClassRetain(value): retained += 1
                WeakClassRelease(value): released += 1
                else: pass
    assert(created == 1 and promoted == 2)
    assert(retained > 0 and released > 0)
    assert(agree(source) == "42")

    let dying = "class Registry:\n    let targets: list[Weak[Target]]\n    func init(self): self.targets = list[Weak[Target]]()\n\nclass Target:\n    let registry: Registry\n    func init(self, registry: Registry): self.registry = registry\n    func deinit(self): self.registry.targets.append(Weak(self))\n\npub func answer() -> i64:\n    let registry = new Registry()\n    if true:\n        let target = new Target(registry)\n    if registry.targets.length != 1u64: return 0\n    if let live = registry.targets[0u64].get(): return 0\n    return 42\n"
    let dying_program = lowered(dying)
    let deinitializer = dying_program.functions[find_mir_function(dying_program, "main.Target.deinit")]
    var dying_weak = 0
    for instruction in deinitializer.body:
        match instruction.form:
            WeakClassCreate(result, value): dying_weak += 1
            ClassRetain(value):
                match mir_type(dying_program.types, deinitializer.registers[value.value]):
                    Class(identity): assert(identity.value != 1)
                    else: assert(false)
            ClassRelease(value):
                match mir_type(dying_program.types, deinitializer.registers[value.value]):
                    Class(identity): assert(identity.value != 1)
                    else: assert(false)
            else: pass
    assert(dying_weak == 1)
    assert(agree(dying) == "42")

pub func test_first_class_weak_values_are_storable_class_fields():
    let source = "class Target:\n    let value: i64\n    func init(self, value: i64): self.value = value\n\nclass Holder:\n    let target: Weak[Target]\n    func init(self, target: Target): self.target = Weak(target)\n\npub func answer() -> i64:\n    let holders = list[Holder]()\n    if true:\n        let target = new Target(42)\n        holders.append(new Holder(target))\n        if let live = holders[0u64].target.get():\n            if live.value != 42: return 0\n        else: return 0\n    if let live = holders[0u64].target.get(): return 0\n    return 42\n"
    let program = lowered(source)
    match mir_type(program.types, program.classes[1].fields[0].storage_type):
        WeakClass(identity): assert(identity.value == 0)
        else: assert(false)
    assert(agree(source) == "42")

pub func test_custom_initializers_receive_fresh_storage_before_source_arguments():
    let ordinary_source = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self, left: i64, right: i64):\n        self.left = left\n        self.right = right\npub func answer() -> i64:\n    let pair = Pair(4, 2)\n    return pair.left * 10 + pair.right\n"
    let ordinary = lowered(ordinary_source)
    let initializer = ordinary.functions[0]
    assert(len(initializer.signature.parameters) == 3)
    assert(is_type(initializer.signature.parameters[0], BuiltinMirType.pointer))
    assert(len(initializer.signature.results) == 0)
    var saw_constructor = false
    for instruction in ordinary.functions[1].body:
        match instruction.form:
            Call(results, function, arguments):
                if function.value == 0:
                    assert(i64(results.count) == 0)
                    assert(i64(arguments.count) == 3)
                    assert(is_type(ordinary.functions[1].registers[register_at(ordinary.functions[1], arguments, 0).value], BuiltinMirType.pointer))
                    saw_constructor = true
            else: pass
    assert(saw_constructor)
    assert(agree(ordinary_source) == "42")

    let fallible_source = "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Positive:\n    let value: i64\n    func init(self, value: i64) -> unit!:\n        if value < 0: error(invalid, \"negative\")\n        self.value = value\nfunc checked(value: i64) -> i64:\n    let positive = Positive(value) catch failure: return -1\n    return positive.value\npub func answer() -> i64: return checked(43) + checked(-1)\n"
    let fallible = lowered(fallible_source)
    let fallible_initializer = fallible.functions[0]
    assert(fallible_initializer.signature.is_fallible)
    assert(len(fallible_initializer.signature.parameters) == 3)
    assert(is_type(fallible_initializer.signature.parameters[0], BuiltinMirType.pointer))
    assert(is_type(fallible_initializer.signature.parameters[1], BuiltinMirType.pointer))
    assert(len(fallible_initializer.signature.results) == 1)
    assert(is_type(fallible_initializer.signature.results[0], BuiltinMirType.pointer))
    assert(agree(fallible_source) == "42")

pub func test_methods_are_named_by_struct_and_self_arrives_as_a_pointer():
    let program = lowered("struct C:\n    var n: i64\n    mutating func bump(self): self.n += 1\n    func origin() -> C: return C(n = 0)\n")
    assert(program.functions[0].name == "main.C.bump")
    assert(program.functions[1].name == "main.C.origin")
    let bump = program.functions[0]
    assert(len(bump.signature.parameters) == 1)
    assert(is_type(bump.signature.parameters[0], BuiltinMirType.pointer))
    # `self.n += 1` is a FieldAddress off r0, a Load, an add, and a Store — no copy of `self`.
    var stores = 0
    var copies = 0
    for instruction in bump.body:
        match instruction.form:
            Store(value_type, address, value): stores += 1
            Memcpy(destination, source, value_type): copies += 1
            else: pass
    assert(stores == 1 and copies == 0)

pub func test_field_assignment_walks_the_path_from_the_root_slot():
    let program = lowered("struct Inner:\n    var value: i64\nstruct Outer:\n    var inner: Inner\npub func answer() -> i64:\n    var o = Outer(inner = Inner(value = 1))\n    o.inner.value = 20\n    return o.inner.value\n")
    let function = only_function(program)
    var addresses = 0
    for instruction in function.body:
        match instruction.form:
            FieldAddress(result, struct_type, base, field): addresses += 1
            else: pass
    # Construction: 1 (inner.value) + 1 (outer.inner); assignment: 2; read: 2.
    assert(addresses == 6)
