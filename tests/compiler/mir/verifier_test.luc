#==============================================================================================
#
#   mir_verifier_test - One test per rule a backend may assume
#
#   DESCRIPTION:
#       Each test builds the smallest program that breaks exactly one rule
#       from docs/compiler/mir.md and pins the diagnostic. The MIR interpreter
#       tests cover the accepting side: every program there is verified first.
#
#==============================================================================================

from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ClassId, ClosureId, ConformanceId, ConvertOp, DataId
from luce.compiler.mir.canonical import ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData, OperandBuilder, no_registers
from luce.compiler.mir.canonical import InterfaceId, MirClass, MirClassField, MirClosure, MirConformance, MirExtern, MirExternalGlobal, MirField, MirFunction, MirGlobal, MirInstruction, MirInterface, MirInterfaceRequirement, MirProgram
from luce.compiler.mir.canonical import MirRuntimeBinding, MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.runtime_contract import RuntimeService
from luce.compiler.mir.canonical import TypeId, UnaryOp, builtin_mir_type
from luce.compiler.mir.canonical import create_empty_mir_program, describe_mir_type, find_runtime_symbol, intern_mir_type
from luce.compiler.mir.canonical import make_struct_type
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = u32(index))

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func u32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u32)
pub func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)
pub func buffer_owner_t() -> TypeId: return builtin_mir_type(BuiltinMirType.buffer_owner)

pub func custom_t(offset: i64 = 0) -> TypeId:
    return TypeId(value = u32(len(create_empty_mir_program().types.definitions) + offset))

pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.SignedInt(value = value)))

pub func const_uint(result: i64, value: u64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.UnsignedInt(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func ret(ops: OperandBuilder, values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = ops.run(regs(values))))

# Helpers take parameter and result lists rather than a `MirSignature`, because
# Stage-0 frees the lists of a struct returned by one call and passed straight
# into another.
pub func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func c_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], is_fallible: bool, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.c,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = is_fallible, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = false,
        is_exported = false,
        span = at(),
    )

# A one-function program `f` with the given registers and body.
pub func program_with(ops: OperandBuilder, results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirProgram:
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", list[TypeId](), results, registers, body))
    return program

# Statement-form `catch reason: return reason` does not return under Stage-0
# 0.22; assigning through a `var` does.
pub func failure(program: MirProgram) -> str:
    var reported = ""
    MirVerifier(program).verify() catch reason:
        reported = reason
    return reported

pub func accepted(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func no_values() -> list[RegisterId]:
    return list[RegisterId]()

pub func none_types() -> list[TypeId]:
    return list[TypeId]()

func class_program(body: list[MirInstruction], registers: list[TypeId], operands: list[u32]) -> MirProgram:
    let program = create_empty_mir_program()
    let class_type = intern_mir_type(program.types, MirType.Class(identity = ClassId(value = 0)))
    discard(intern_mir_type(program.types, MirType.WeakClass(identity = ClassId(value = 0))))
    let destroyer_ops = OperandBuilder()
    program.functions.append(private_function(
        destroyer_ops,
        "destroy",
        [class_type, bool_t()],
        none_types(),
        [class_type, bool_t()],
        [ret(destroyer_ops, list[i64]())],
    ))
    program.classes.append(MirClass(fields = [MirClassField(storage_type = i64_t())], destroyer = FunctionId(value = 0)))
    program.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    bind_class_services(program)
    return program

func bind_class_services(program: MirProgram):
    let unit_services = [
        RuntimeService.class_mark_initialized,
        RuntimeService.class_retain,
        RuntimeService.class_release,
        RuntimeService.weak_class_retain,
        RuntimeService.weak_class_release,
    ]
    let create_ops = OperandBuilder()
    let create_id = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(create_ops, "runtime.class_create", [u64_t(), u64_t(), ptr_t()], [ptr_t()], [u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(3), value = MirConstant.Null)),
        ret(create_ops, [3]),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.class_create, function = create_id))
    for service in unit_services:
        let ops = OperandBuilder()
        let identity = FunctionId(value = u32(len(program.functions)))
        program.functions.append(private_function(ops, "runtime." + str(service), [ptr_t()], none_types(), [ptr_t()], [ret(ops, list[i64]())]))
        program.runtime_bindings.append(MirRuntimeBinding(service = service, function = identity))
    let pointer_services = [RuntimeService.class_payload, RuntimeService.weak_class_create, RuntimeService.weak_class_promote]
    for service in pointer_services:
        let ops = OperandBuilder()
        let identity = FunctionId(value = u32(len(program.functions)))
        program.functions.append(private_function(ops, "runtime." + str(service), [ptr_t()], [ptr_t()], [ptr_t()], [ret(ops, [0])]))
        program.runtime_bindings.append(MirRuntimeBinding(service = service, function = identity))

func bind_equality_services(program: MirProgram):
    let create_ops = OperandBuilder()
    let create = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(create_ops, "runtime.equality_create", none_types(), [ptr_t()], [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ret(create_ops, [0]),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.equality_context_create, function = create))

    let release_ops = OperandBuilder()
    let release = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(release_ops, "runtime.equality_release", [ptr_t()], none_types(), [ptr_t()], [
        ret(release_ops, list[i64]()),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.equality_context_release, function = release))

    let visit_ops = OperandBuilder()
    let visit = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(visit_ops, "runtime.equality_visit", [ptr_t(), ptr_t(), ptr_t()], [bool_t()], [ptr_t(), ptr_t(), ptr_t(), bool_t()], [
        const_bool(3, false),
        ret(visit_ops, [3]),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.equality_context_visit, function = visit))

# Hash-service fixtures use the exact sealed-runtime signatures. Keeping this
# constructor centralized makes malformed instruction tests break one MIR rule
# at a time rather than accidentally testing a wrong runtime declaration.
func append_hash_service(program: MirProgram, service: RuntimeService, parameters: list[TypeId], result_kind: i64):
    let ops = OperandBuilder()
    let registers = list[TypeId]()
    for parameter in parameters: registers.append(parameter)
    let results = list[TypeId]()
    let body = list[MirInstruction]()
    if result_kind == 1:
        results.append(ptr_t())
        registers.append(ptr_t())
        body.append(ins(InstructionForm.Const(result = r(len(parameters)), value = MirConstant.Null)))
        body.append(ret(ops, [len(parameters)]))
    elif result_kind == 2:
        results.append(u64_t())
        registers.append(u64_t())
        body.append(const_uint(len(parameters), u64(0)))
        body.append(ret(ops, [len(parameters)]))
    elif result_kind == 3:
        results.append(bool_t())
        registers.append(bool_t())
        body.append(const_bool(len(parameters), false))
        body.append(ret(ops, [len(parameters)]))
    else:
        body.append(ret(ops, list[i64]()))
    let identity = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(ops, "runtime." + str(service), parameters, results, registers, body))
    program.runtime_bindings.append(MirRuntimeBinding(service = service, function = identity))

func bind_hash_services(program: MirProgram) -> FunctionId:
    let action_ops = OperandBuilder()
    let action = FunctionId(value = u32(len(program.functions)))
    program.functions.append(private_function(action_ops, "hash.element_action", [ptr_t()], none_types(), [ptr_t()], [ret(action_ops, list[i64]())]))
    append_hash_service(program, RuntimeService.hash_create, none_types(), 1)
    append_hash_service(program, RuntimeService.hash_retain, [ptr_t()], 0)
    append_hash_service(program, RuntimeService.hash_release, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], 0)
    append_hash_service(program, RuntimeService.hash_copy, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], 1)
    append_hash_service(program, RuntimeService.hash_length, [ptr_t()], 2)
    append_hash_service(program, RuntimeService.hash_iteration_begin, [ptr_t()], 2)
    append_hash_service(program, RuntimeService.hash_iteration_end, [ptr_t()], 0)
    append_hash_service(program, RuntimeService.hash_find_first, [ptr_t(), u64_t()], 2)
    append_hash_service(program, RuntimeService.hash_find_next, [ptr_t(), u64_t()], 2)
    append_hash_service(program, RuntimeService.hash_key_address, [ptr_t(), u64_t(), u64_t()], 1)
    append_hash_service(program, RuntimeService.hash_value_address, [ptr_t(), u64_t(), u64_t()], 1)
    append_hash_service(program, RuntimeService.hash_insert_entry, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), u64_t()], 2)
    append_hash_service(program, RuntimeService.hash_remove_entry, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), u64_t()], 0)
    append_hash_service(program, RuntimeService.hash_clear, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], 0)
    append_hash_service(program, RuntimeService.hash_reserve, [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t(), u64_t()], 0)
    return action

## Add one fully valid closure contract and a capture-free target with the
## same source-visible signature. Tests can then break one descriptor rule
## without duplicating unrelated metadata and runtime-service scaffolding.
pub func append_valid_closure(program: MirProgram) -> TypeId:
    let signature = MirSignature(parameters = none_types(), results = [i64_t()], is_fallible = false, returns_never = false)
    let function_type = intern_mir_type(program.types, MirType.Func(signature = signature))
    let body_ops = OperandBuilder()
    program.functions.append(private_function(body_ops, "closure.body", [ptr_t()], [i64_t()], [ptr_t(), i64_t()], [
        const_int(1, 42),
        ret(body_ops, [1]),
    ]))
    let destroy_ops = OperandBuilder()
    program.functions.append(private_function(destroy_ops, "closure.destroy", [ptr_t(), bool_t()], none_types(), [ptr_t(), bool_t()], [
        ret(destroy_ops, list[i64]()),
    ]))
    let target_ops = OperandBuilder()
    program.functions.append(private_function(target_ops, "capture_free", none_types(), [i64_t()], [i64_t()], [
        const_int(0, 42),
        ret(target_ops, [0]),
    ]))
    program.closures.append(MirClosure(
        function = FunctionId(value = 0),
        signature = signature,
        captures = [MirField(value_type = i64_t())],
        destroyer = FunctionId(value = 1),
    ))
    return function_type

## Add one complete erased interface contract. Instruction tests can then
## violate a single identity or runtime-binding rule without malformed witness
## metadata hiding the intended diagnostic.
func append_valid_interface(program: MirProgram) -> TypeId:
    let signature = MirSignature(parameters = [ptr_t()], results = [i64_t()], is_fallible = false, returns_never = false)
    let witness_ops = OperandBuilder()
    program.functions.append(private_function(witness_ops, "interface.witness", [ptr_t()], [i64_t()], [ptr_t(), i64_t()], [
        const_int(1, 42),
        ret(witness_ops, [1]),
    ]))
    let retain_ops = OperandBuilder()
    program.functions.append(private_function(retain_ops, "interface.retain", [ptr_t()], none_types(), [ptr_t()], [ret(retain_ops, list[i64]())]))
    let release_ops = OperandBuilder()
    program.functions.append(private_function(release_ops, "interface.release", [ptr_t()], none_types(), [ptr_t()], [ret(release_ops, list[i64]())]))
    program.interfaces.append(MirInterface(requirements = [MirInterfaceRequirement(signature = signature, is_mutating = false)]))
    program.conformances.append(MirConformance(
        interface_id = InterfaceId(value = 0),
        value_type = i64_t(),
        implementations = [FunctionId(value = 0)],
        retain = FunctionId(value = 1),
        release = FunctionId(value = 2),
    ))
    return intern_mir_type(program.types, MirType.Interface(identity = InterfaceId(value = 0)))

# Private stubs give hand-built list instructions their exact semantic
# service contract. The MIR oracle never executes these policy bodies.
pub func bind_list_services(program: MirProgram):
    let action_ops = OperandBuilder()
    program.functions.append(private_function(action_ops, "element.action", [ptr_t()], none_types(), [ptr_t()], [ret(action_ops, list[i64]())]))
    let create_ops = OperandBuilder()
    program.functions.append(private_function(create_ops, "runtime.list_create", none_types(), [ptr_t()], [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ret(create_ops, [0]),
    ]))
    let length_ops = OperandBuilder()
    program.functions.append(private_function(length_ops, "runtime.list_length", [ptr_t()], [u64_t()], [ptr_t(), u64_t()], [
        const_uint(1, u64(0)),
        ret(length_ops, [1]),
    ]))
    let append_ops = OperandBuilder()
    program.functions.append(private_function(append_ops, "runtime.list_append_slot", [ptr_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(4), value = MirConstant.Null)),
        ret(append_ops, [4]),
    ]))
    let insert_ops = OperandBuilder()
    program.functions.append(private_function(insert_ops, "runtime.list_insert_slot", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(5), value = MirConstant.Null)),
        ret(insert_ops, [5]),
    ]))
    let remove_ops = OperandBuilder()
    program.functions.append(private_function(remove_ops, "runtime.list_remove_at", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ret(remove_ops, list[i64]())]))
    let clear_ops = OperandBuilder()
    program.functions.append(private_function(clear_ops, "runtime.list_clear", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(clear_ops, list[i64]())]))
    let reserve_ops = OperandBuilder()
    program.functions.append(private_function(reserve_ops, "runtime.list_reserve", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ret(reserve_ops, list[i64]())]))
    let address_ops = OperandBuilder()
    program.functions.append(private_function(address_ops, "runtime.list_element_address", [ptr_t(), u64_t(), u64_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(3), value = MirConstant.Null)),
        ret(address_ops, [3]),
    ]))
    let copy_ops = OperandBuilder()
    program.functions.append(private_function(copy_ops, "runtime.list_copy", [ptr_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(copy_ops, [4]),
    ]))
    let mutable_ops = OperandBuilder()
    program.functions.append(private_function(mutable_ops, "runtime.list_mutable_element_address", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(5), source = r(0))),
        ret(mutable_ops, [5]),
    ]))
    let slice_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_ops,
        "runtime.list_slice",
        [ptr_t(), u64_t(), u64_t(), u64_t()],
        [ptr_t()],
        [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(4), source = r(0))),
            ret(slice_ops, [4]),
        ],
    ))
    let slice_length_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_length_ops,
        "runtime.slice_length",
        [ptr_t()],
        [u64_t()],
        [ptr_t(), u64_t()],
        [
            const_uint(1, u64(0)),
            ret(slice_length_ops, [1]),
        ],
    ))
    let slice_address_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_address_ops,
        "runtime.slice_element_address",
        [ptr_t(), u64_t(), u64_t()],
        [ptr_t()],
        [ptr_t(), u64_t(), u64_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(3), source = r(0))),
            ret(slice_address_ops, [3]),
        ],
    ))
    let concat_ops = OperandBuilder()
    program.functions.append(private_function(
        concat_ops,
        "runtime.list_concat",
        [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t()],
        [ptr_t()],
        [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(5), source = r(0))),
            ret(concat_ops, [5]),
        ],
    ))
    let iteration_begin_ops = OperandBuilder()
    program.functions.append(private_function(iteration_begin_ops, "runtime.list_iteration_begin", [ptr_t()], [u64_t()], [ptr_t(), u64_t()], [
        const_uint(1, u64(0)),
        ret(iteration_begin_ops, [1]),
    ]))
    let iteration_end_ops = OperandBuilder()
    program.functions.append(private_function(iteration_end_ops, "runtime.list_iteration_end", [ptr_t()], none_types(), [ptr_t()], [ret(iteration_end_ops, list[i64]())]))
    let iteration_active_ops = OperandBuilder()
    program.functions.append(private_function(iteration_active_ops, "runtime.list_iteration_active", [ptr_t()], [bool_t()], [ptr_t(), bool_t()], [
        const_bool(1, false),
        ret(iteration_active_ops, [1]),
    ]))
    let list_retain_ops = OperandBuilder()
    program.functions.append(private_function(list_retain_ops, "runtime.list_retain", [ptr_t()], none_types(), [ptr_t()], [ret(list_retain_ops, list[i64]())]))
    let list_release_ops = OperandBuilder()
    program.functions.append(private_function(list_release_ops, "runtime.list_release", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(list_release_ops, list[i64]())]))
    let slice_retain_ops = OperandBuilder()
    program.functions.append(private_function(slice_retain_ops, "runtime.slice_retain", [ptr_t()], none_types(), [ptr_t()], [ret(slice_retain_ops, list[i64]())]))
    let slice_release_ops = OperandBuilder()
    program.functions.append(private_function(slice_release_ops, "runtime.slice_release", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(slice_release_ops, list[i64]())]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_create, function = FunctionId(value = 1)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_length, function = FunctionId(value = 2)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_append_slot, function = FunctionId(value = 3)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_insert_slot, function = FunctionId(value = 4)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_remove_at, function = FunctionId(value = 5)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_clear, function = FunctionId(value = 6)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_reserve, function = FunctionId(value = 7)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_element_address, function = FunctionId(value = 8)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_copy, function = FunctionId(value = 9)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_mutable_element_address, function = FunctionId(value = 10)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_slice, function = FunctionId(value = 11)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_length, function = FunctionId(value = 12)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_element_address, function = FunctionId(value = 13)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_concat, function = FunctionId(value = 14)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_begin, function = FunctionId(value = 15)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_end, function = FunctionId(value = 16)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_active, function = FunctionId(value = 17)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_retain, function = FunctionId(value = 18)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_release, function = FunctionId(value = 19)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_retain, function = FunctionId(value = 20)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_release, function = FunctionId(value = 21)))

pub func bind_buffer_services(program: MirProgram):
    let retain_ops = OperandBuilder()
    program.functions.append(private_function(retain_ops, "runtime.buffer_retain", [ptr_t()], none_types(), [ptr_t()], [ret(retain_ops, list[i64]())]))
    let release_ops = OperandBuilder()
    program.functions.append(private_function(release_ops, "runtime.buffer_release", [ptr_t()], none_types(), [ptr_t()], [ret(release_ops, list[i64]())]))
    let concat_ops = OperandBuilder()
    program.functions.append(private_function(concat_ops, "runtime.buffer_concat", [ptr_t(), u64_t(), ptr_t(), u64_t()], [ptr_t()], [ptr_t(), u64_t(), ptr_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(concat_ops, [4]),
    ]))
    let data_ops = OperandBuilder()
    program.functions.append(private_function(data_ops, "runtime.buffer_data", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(data_ops, [1]),
    ]))
    let slice_ops = OperandBuilder()
    program.functions.append(private_function(slice_ops, "runtime.bytes_slice", [ptr_t(), ptr_t(), u64_t(), u64_t()], [ptr_t()], [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(slice_ops, [4]),
    ]))
    let count_ops = OperandBuilder()
    program.functions.append(private_function(count_ops, "runtime.string_scalar_count", [ptr_t(), u64_t()], [u64_t()], [ptr_t(), u64_t(), u64_t()], [
        const_uint(2, u64(0)),
        ret(count_ops, [2]),
    ]))
    let decode_ops = OperandBuilder()
    program.functions.append(private_function(decode_ops, "runtime.string_decode", [ptr_t(), u64_t(), u64_t()], [u64_t()], [ptr_t(), u64_t(), u64_t(), u64_t()], [
        const_uint(3, u64(0)),
        ret(decode_ops, [3]),
    ]))
    let builder_create_ops = OperandBuilder()
    program.functions.append(private_function(builder_create_ops, "runtime.buffer_builder_create", none_types(), [ptr_t()], [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ret(builder_create_ops, [0]),
    ]))
    let builder_append_ops = OperandBuilder()
    program.functions.append(private_function(builder_append_ops, "runtime.buffer_builder_append", [ptr_t(), ptr_t(), u64_t()], none_types(), [ptr_t(), ptr_t(), u64_t()], [
        ret(builder_append_ops, list[i64]()),
    ]))
    let builder_finish_ops = OperandBuilder()
    program.functions.append(private_function(builder_finish_ops, "runtime.buffer_builder_finish", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(builder_finish_ops, [1]),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_retain, function = FunctionId(value = 0)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_release, function = FunctionId(value = 1)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_concat, function = FunctionId(value = 2)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_data, function = FunctionId(value = 3)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_slice, function = FunctionId(value = 4)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.string_scalar_count, function = FunctionId(value = 5)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.string_decode, function = FunctionId(value = 6)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_builder_create, function = FunctionId(value = 7)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_builder_append, function = FunctionId(value = 8)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.buffer_builder_finish, function = FunctionId(value = 9)))

# mark: Registers ============================================================================

pub func test_registers_are_used_only_after_definition():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_registers_are_defined_once():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(0, 1), const_int(0, 2), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r0 twice")

pub func test_undeclared_registers_are_rejected():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(3, 1), ret(ops, [3])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r3, which is not declared")

pub func test_definitions_inside_a_region_stay_inside_it():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        const_int(0, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_parameters_occupy_the_leading_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [bool_t()], [ret(ops, [0])]))
    assert(failure(program) == "MIR verifier: `f` register r0 must have its parameter's type")
    let short = create_empty_mir_program()
    short.functions.append(function(ops, "f", [i64_t()], [i64_t()], none_types(), [ret(ops, [0])]))
    assert(failure(short) == "MIR verifier: `f` declares fewer registers than parameters")

# mark: Operand types ========================================================================

pub func test_constants_must_fit_their_register():
    let ops = OperandBuilder()
    let maximum = u64(18446744073709551615)
    accepted(program_with(ops, [u64_t()], [u64_t()], [const_uint(0, maximum), ret(ops, [0])]))
    let outside: list[MirInstruction] = [const_int(0, 128), ret(ops, [0])]
    assert(failure(program_with(ops, [i8_t()], [i8_t()], outside)) == "MIR verifier: `f` at 1:1: constant 128 is outside `i8`")
    let unsigned_outside: list[MirInstruction] = [const_uint(0, u64(4294967296)), ret(ops, [0])]
    assert(failure(program_with(ops, [u32_t()], [u32_t()], unsigned_outside)) == "MIR verifier: `f` at 1:1: constant 4294967296 is outside `u32`")
    let signed_into_unsigned: list[MirInstruction] = [const_int(0, 1), ret(ops, [0])]
    assert(failure(program_with(ops, [u64_t()], [u64_t()], signed_into_unsigned)) == "MIR verifier: `f` at 1:1: signed integer constant into `u64` register")
    let unsigned_into_signed: list[MirInstruction] = [const_uint(0, u64(1)), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], unsigned_into_signed)) == "MIR verifier: `f` at 1:1: unsigned integer constant into `i64` register")
    let wrong_kind: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_kind)) == "MIR verifier: `f` at 1:1: bool constant into `i64` register")
    let null_into_int: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], null_into_int)) == "MIR verifier: `f` at 1:1: null into `i64` register")

pub func test_binary_operands_must_share_a_type_the_operation_accepts():
    let ops = OperandBuilder()
    let mixed: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.add, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i32_t(), i64_t(), i64_t()], mixed)) == "MIR verifier: `f` at 1:1: `add` operands has `i32`, expected `i64`")
    let int_div: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.div, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], int_div)) == "MIR verifier: `f` at 1:1: `div` needs float operands; integers use `floor_div`")
    let bool_result: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.lt, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], bool_result)) == "MIR verifier: `f` at 1:1: `lt` result has `i64`, expected `bool`")
    let bool_shift: list[MirInstruction] = [const_bool(0, true), const_bool(1, true), binary(2, BinaryOp.shift_left, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t(), bool_t()], bool_shift)) == "MIR verifier: `f` at 1:1: `shift_left` needs integer operands, found `bool`")

pub func test_reference_handles_support_identity_but_not_value_ordering():
    let equal_ops = OperandBuilder()
    let unequal_ops = OperandBuilder()
    let identity = create_empty_mir_program()
    let list_i64 = intern_mir_type(identity.types, MirType.List(element = i64_t()))
    identity.functions.append(function(equal_ops, "same", [list_i64, list_i64], [bool_t()], [list_i64, list_i64, bool_t()], [
        binary(2, BinaryOp.eq, 0, 1),
        ret(equal_ops, [2]),
    ]))
    identity.functions.append(function(unequal_ops, "different", [list_i64, list_i64], [bool_t()], [list_i64, list_i64, bool_t()], [
        binary(2, BinaryOp.ne, 0, 1),
        ret(unequal_ops, [2]),
    ]))
    accepted(identity)

    let view_ops = OperandBuilder()
    let views = create_empty_mir_program()
    let slice_i64 = intern_mir_type(views.types, MirType.Slice(element = i64_t()))
    views.functions.append(function(view_ops, "same_view", [slice_i64, slice_i64], [bool_t()], [slice_i64, slice_i64, bool_t()], [
        binary(2, BinaryOp.eq, 0, 1),
        ret(view_ops, [2]),
    ]))
    assert(failure(views) == "MIR verifier: `same_view` at 1:1: `eq` cannot compare `slice[i64]`")

    let ordered_ops = OperandBuilder()
    let ordered = create_empty_mir_program()
    let ordered_list = intern_mir_type(ordered.types, MirType.List(element = i64_t()))
    ordered.functions.append(function(ordered_ops, "ordered", [ordered_list, ordered_list], [bool_t()], [ordered_list, ordered_list, bool_t()], [
        binary(2, BinaryOp.lt, 0, 1),
        ret(ordered_ops, [2]),
    ]))
    assert(failure(ordered) == "MIR verifier: `ordered` at 1:1: `lt` needs numeric operands, found `list[i64]`")

pub func test_recursive_equality_contexts_require_exact_types_and_runtime_bindings():
    let valid_ops = OperandBuilder()
    let valid = create_empty_mir_program()
    let list_i64 = intern_mir_type(valid.types, MirType.List(element = i64_t()))
    valid.functions.append(function(valid_ops, "same", [list_i64, list_i64], [bool_t()], [list_i64, list_i64, ptr_t(), bool_t()], [
        ins(InstructionForm.EqualityContextCreate(result = r(2))),
        ins(InstructionForm.EqualityContextVisit(result = r(3), context = r(2), left = r(0), right = r(1))),
        ins(InstructionForm.EqualityContextRelease(value = r(2))),
        ret(valid_ops, [3]),
    ]))
    bind_equality_services(valid)
    accepted(valid)

    let missing_ops = OperandBuilder()
    let missing = program_with(missing_ops, [ptr_t()], [ptr_t()], [
        ins(InstructionForm.EqualityContextCreate(result = r(0))),
        ret(missing_ops, [0]),
    ])
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `EqualityContextCreate` requires the `equality_context_create` runtime binding")

    let wrong_ops = OperandBuilder()
    let wrong = create_empty_mir_program()
    let wrong_list = intern_mir_type(wrong.types, MirType.List(element = i64_t()))
    wrong.functions.append(function(wrong_ops, "wrong", [i64_t(), wrong_list], [bool_t()], [i64_t(), wrong_list, ptr_t(), bool_t()], [
        ins(InstructionForm.EqualityContextCreate(result = r(2))),
        ins(InstructionForm.EqualityContextVisit(result = r(3), context = r(2), left = r(0), right = r(1))),
        ret(wrong_ops, [3]),
    ]))
    bind_equality_services(wrong)
    assert(failure(wrong) == "MIR verifier: `wrong` at 1:1: `EqualityContextVisit` left value must be a recursive collection, found `i64`")

pub func test_unary_and_convert_check_their_directions():
    let ops = OperandBuilder()
    let neg_bool: list[MirInstruction] = [const_bool(0, true), ins(InstructionForm.Unary(result = r(1), operation = UnaryOp.neg, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t()], neg_bool)) == "MIR verifier: `f` at 1:1: `neg` needs a signed integer or float, found `bool`")
    let narrow_extend: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.extend, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i8_t()], [i64_t(), i8_t()], narrow_extend)) == "MIR verifier: `f` at 1:1: `extend` must widen an integer, found `i64` to `i8`")
    let widen_wrap: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.wrap, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i8_t(), i64_t()], widen_wrap)) == "MIR verifier: `f` at 1:1: `wrap` must narrow an integer, found `i8` to `i64`")
    let bad_float: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.float_to_int, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], bad_float)) == "MIR verifier: `f` at 1:1: `float_to_int` needs a float operand and an integer result")
    let wrong_reinterpret: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.int_reinterpret, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i8_t(), i64_t()], wrong_reinterpret)) == "MIR verifier: `f` at 1:1: `int_reinterpret` needs equal-width integers")
    let same_float_width: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Float(value = 1.0))), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.float_resize, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [f64_t()], [f64_t(), f64_t()], same_float_width)) == "MIR verifier: `f` at 1:1: `float_resize` needs floats of different widths")

pub func test_float_types_are_closed_to_the_three_language_widths():
    let program = create_empty_mir_program()
    program.types.definitions.append(MirType.Float(bits = 24))
    assert(failure(program) == "MIR verifier: float type " + str(custom_t().value) + " has unsupported width 24")

pub func test_float_bits_is_the_closed_ieee_encoding_primitive():
    let valid_ops = OperandBuilder()
    let valid: list[MirInstruction] = [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Float(value = 2.5))),
        ins(InstructionForm.FloatBits(result = r(1), operand = r(0))),
        ret(valid_ops, [1]),
    ]
    accepted(program_with(valid_ops, [u64_t()], [f64_t(), u64_t()], valid))

    let operand_ops = OperandBuilder()
    let wrong_operand: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.FloatBits(result = r(1), operand = r(0))),
        ret(operand_ops, [1]),
    ]
    assert(failure(program_with(operand_ops, [u64_t()], [i64_t(), u64_t()], wrong_operand)) == "MIR verifier: `f` at 1:1: `FloatBits` needs a float operand, found `i64`")

    let result_ops = OperandBuilder()
    let wrong_result: list[MirInstruction] = [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Float(value = 2.5))),
        ins(InstructionForm.FloatBits(result = r(1), operand = r(0))),
        ret(result_ops, [1]),
    ]
    assert(failure(program_with(result_ops, [i64_t()], [f64_t(), i64_t()], wrong_result)) == "MIR verifier: `f` at 1:1: `FloatBits` result has `i64`, expected `u64`")

pub func test_pointer_hash_keeps_runtime_identity_hashing_typed():
    let valid_ops = OperandBuilder()
    let valid: list[MirInstruction] = [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.PointerHash(result = r(1), operand = r(0))),
        ret(valid_ops, [1]),
    ]
    accepted(program_with(valid_ops, [u64_t()], [ptr_t(), u64_t()], valid))

    let operand_ops = OperandBuilder()
    let wrong_operand: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.PointerHash(result = r(1), operand = r(0))),
        ret(operand_ops, [1]),
    ]
    assert(failure(program_with(operand_ops, [u64_t()], [i64_t(), u64_t()], wrong_operand)) == "MIR verifier: `f` at 1:1: `PointerHash` operand must be `ptr`, found `i64`")

    let result_ops = OperandBuilder()
    let wrong_result: list[MirInstruction] = [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.PointerHash(result = r(1), operand = r(0))),
        ret(result_ops, [1]),
    ]
    assert(failure(program_with(result_ops, [i64_t()], [ptr_t(), i64_t()], wrong_result)) == "MIR verifier: `f` at 1:1: `PointerHash` result has `i64`, expected `u64`")

pub func test_hash_collection_instructions_require_exact_shapes_callbacks_and_services():
    let valid = create_empty_mir_program()
    let map_type = intern_mir_type(valid.types, MirType.Map(key = i64_t(), value = bool_t()))
    let set_type = intern_mir_type(valid.types, MirType.Set(element = i64_t()))
    let action = bind_hash_services(valid)
    let valid_ops = OperandBuilder()
    valid.functions.append(function(valid_ops, "collections", [map_type, set_type, u64_t()], none_types(), [map_type, set_type, u64_t(), map_type, u64_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t(), u64_t(), map_type, set_type], [
        ins(InstructionForm.HashRetain(value = r(0))),
        ins(InstructionForm.HashCopy(result = r(3), value = r(0), key_retain = action, value_retain = action)),
        ins(InstructionForm.HashLength(result = r(4), value = r(3))),
        ins(InstructionForm.HashIterationBegin(result = r(5), value = r(3))),
        ins(InstructionForm.HashIterationEnd(value = r(3))),
        ins(InstructionForm.HashFindFirst(result = r(6), value = r(3), hash = r(2))),
        ins(InstructionForm.HashFindNext(result = r(7), value = r(3), current = r(6))),
        ins(InstructionForm.HashKeyAddress(result = r(8), value = r(3), index = r(6))),
        ins(InstructionForm.HashValueAddress(result = r(9), value = r(3), index = r(6))),
        ins(InstructionForm.HashInsertEntry(result = r(10), value = r(1), hash = r(2))),
        ins(InstructionForm.HashRemoveEntry(value = r(1), index = r(10))),
        ins(InstructionForm.HashReserve(value = r(3), minimum_capacity = r(2))),
        ins(InstructionForm.HashClear(value = r(3), key_release = action, value_release = action)),
        ins(InstructionForm.HashCreate(result = r(11))),
        ins(InstructionForm.HashCreate(result = r(12))),
        ins(InstructionForm.HashRelease(value = r(3), key_release = action, value_release = action)),
        ins(InstructionForm.HashRelease(value = r(11), key_release = action, value_release = action)),
        ins(InstructionForm.HashRelease(value = r(12), key_release = action, value_release = action)),
        ret(valid_ops, list[i64]()),
    ]))
    accepted(valid)

    let wrong_handle = create_empty_mir_program()
    discard(bind_hash_services(wrong_handle))
    let handle_ops = OperandBuilder()
    wrong_handle.functions.append(function(handle_ops, "wrong_handle", [i64_t()], none_types(), [i64_t()], [
        ins(InstructionForm.HashRetain(value = r(0))),
        ret(handle_ops, list[i64]()),
    ]))
    assert(failure(wrong_handle) == "MIR verifier: `wrong_handle` at 1:1: `HashRetain` value must be a typed map or set handle, found `i64`")

    let set_value = create_empty_mir_program()
    let set_value_type = intern_mir_type(set_value.types, MirType.Set(element = i64_t()))
    discard(bind_hash_services(set_value))
    let set_ops = OperandBuilder()
    set_value.functions.append(function(set_ops, "set_value", [set_value_type, u64_t()], [ptr_t()], [set_value_type, u64_t(), ptr_t()], [
        ins(InstructionForm.HashValueAddress(result = r(2), value = r(0), index = r(1))),
        ret(set_ops, [2]),
    ]))
    assert(failure(set_value) == "MIR verifier: `set_value` at 1:1: `HashValueAddress` requires a map handle")

    let wrong_copy = create_empty_mir_program()
    let wrong_map = intern_mir_type(wrong_copy.types, MirType.Map(key = i64_t(), value = bool_t()))
    let wrong_set = intern_mir_type(wrong_copy.types, MirType.Set(element = i64_t()))
    let copy_action = bind_hash_services(wrong_copy)
    let copy_ops = OperandBuilder()
    wrong_copy.functions.append(function(copy_ops, "wrong_copy", [wrong_map], [wrong_set], [wrong_map, wrong_set], [
        ins(InstructionForm.HashCopy(result = r(1), value = r(0), key_retain = copy_action, value_retain = copy_action)),
        ret(copy_ops, [1]),
    ]))
    assert(failure(wrong_copy) == "MIR verifier: `wrong_copy` at 1:1: `HashCopy` result has `set[i64]`, expected `map[i64, bool]`")

    let wrong_callback = create_empty_mir_program()
    let callback_map = intern_mir_type(wrong_callback.types, MirType.Map(key = i64_t(), value = bool_t()))
    discard(bind_hash_services(wrong_callback))
    let callback_ops = OperandBuilder()
    wrong_callback.functions.append(function(callback_ops, "wrong_callback", [callback_map], none_types(), [callback_map], [
        ins(InstructionForm.HashClear(value = r(0), key_release = FunctionId(value = 1), value_release = FunctionId(value = 1))),
        ret(callback_ops, list[i64]()),
    ]))
    assert(failure(wrong_callback) == "MIR verifier: `wrong_callback` at 1:1: `HashClear` key release has signature () -> (ptr), expected (ptr) -> ()")

    let missing_ops = OperandBuilder()
    let missing = create_empty_mir_program()
    let missing_map = intern_mir_type(missing.types, MirType.Map(key = i64_t(), value = bool_t()))
    missing.functions.append(function(missing_ops, "missing", none_types(), [missing_map], [missing_map], [
        ins(InstructionForm.HashCreate(result = r(0))),
        ret(missing_ops, [0]),
    ]))
    assert(failure(missing) == "MIR verifier: `missing` at 1:1: `HashCreate` requires the `hash_create` runtime binding")

# mark: Memory ===============================================================================

pub func test_class_lifecycle_instructions_preserve_nominal_identity_and_payload_bounds():
    let class_type = custom_t()
    let weak_type = custom_t(1)
    let valid = class_program([
        ins(InstructionForm.ClassCreate(result = r(0), identity = ClassId(value = 0))),
        ins(InstructionForm.ClassMarkInitialized(value = r(0))),
        ins(InstructionForm.ClassFieldAddress(result = r(1), value = r(0), field = 0)),
        ins(InstructionForm.WeakClassCreate(result = r(2), value = r(0))),
        ins(InstructionForm.WeakClassRetain(value = r(2))),
        ins(InstructionForm.WeakClassRelease(value = r(2))),
        ins(InstructionForm.WeakClassRelease(value = r(2))),
        ins(InstructionForm.ClassRetain(value = r(0))),
        ins(InstructionForm.ClassRelease(value = r(0))),
        ins(InstructionForm.ClassRelease(value = r(0))),
        ins(InstructionForm.Return(values = no_registers())),
    ], [class_type, ptr_t(), weak_type], list[u32]())
    accepted(valid)

    let missing = create_empty_mir_program()
    missing.types.definitions.append(MirType.Class(identity = ClassId(value = 0)))
    assert(failure(missing) == "MIR verifier: type " + str(class_type.value) + " names class 0, which does not exist")

    let wrong_result = class_program([
        ins(InstructionForm.ClassCreate(result = r(0), identity = ClassId(value = 0))),
        ins(InstructionForm.Return(values = no_registers())),
    ], [weak_type], list[u32]())
    assert(failure(wrong_result) == "MIR verifier: `f` at 1:1: `ClassCreate` result must be a class handle, found `weak-class#0`")

    let wrong_field = class_program([
        ins(InstructionForm.ClassCreate(result = r(0), identity = ClassId(value = 0))),
        ins(InstructionForm.ClassFieldAddress(result = r(1), value = r(0), field = 1)),
        ins(InstructionForm.Return(values = no_registers())),
    ], [class_type, ptr_t()], list[u32]())
    assert(failure(wrong_field) == "MIR verifier: `f` at 1:1: `ClassFieldAddress` names field 1 of a class with 1 field(s)")

    let promoted = class_program([
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        ins(InstructionForm.WeakClassPromote(destination = r(0), value = r(1), optional_type = custom_t(3))),
        ins(InstructionForm.Return(values = no_registers())),
    ], [ptr_t(), weak_type], list[u32]())
    let absent = intern_mir_type(promoted.types, make_struct_type(none_types()))
    assert(absent.value == custom_t(2).value)
    discard(intern_mir_type(promoted.types, MirType.Enum(tag = builtin_mir_type(BuiltinMirType.unsigned_u8), cases = [absent, class_type])))
    accepted(promoted)

    let wrong_tag = class_program([
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        ins(InstructionForm.WeakClassPromote(destination = r(0), value = r(1), optional_type = custom_t(3))),
        ins(InstructionForm.Return(values = no_registers())),
    ], [ptr_t(), weak_type], list[u32]())
    let wrong_tag_absent = intern_mir_type(wrong_tag.types, make_struct_type(none_types()))
    discard(intern_mir_type(wrong_tag.types, MirType.Enum(tag = i64_t(), cases = [wrong_tag_absent, class_type])))
    assert(failure(wrong_tag) == "MIR verifier: `f` at 1:1: `WeakClassPromote` optional tag must be `u8`")

    let wrong_absent = class_program([
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        ins(InstructionForm.WeakClassPromote(destination = r(0), value = r(1), optional_type = custom_t(3))),
        ins(InstructionForm.Return(values = no_registers())),
    ], [ptr_t(), weak_type], list[u32]())
    let payload_absent = intern_mir_type(wrong_absent.types, make_struct_type([i64_t()]))
    discard(intern_mir_type(wrong_absent.types, MirType.Enum(tag = builtin_mir_type(BuiltinMirType.unsigned_u8), cases = [payload_absent, class_type])))
    assert(failure(wrong_absent) == "MIR verifier: `f` at 1:1: `WeakClassPromote` absent case must be empty")

pub func test_aggregates_never_travel_through_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let pair = intern_mir_type(program.types, make_struct_type([i32_t(), i32_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Load(result = r(1), value_type = pair, address = r(0))),
        ret(ops, list[i64]()),
    ]
    let function_value = MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = false),
        registers = [ptr_t(), pair],
        slots = [MirSlot(value_type = pair)],
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )
    program.functions.append(function_value)
    assert(failure(program) == "MIR verifier: `f` at 1:1: `Load` of a struct; aggregates move with `Memcpy`")

pub func test_addresses_must_be_pointers_and_slots_must_exist():
    let ops = OperandBuilder()
    let not_pointer: list[MirInstruction] = [const_int(0, 4), ins(InstructionForm.Load(result = r(1), value_type = i64_t(), address = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], not_pointer)) == "MIR verifier: `f` at 1:1: `Load` address must be `ptr`, found `i64`")
    let missing_slot: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_slot)) == "MIR verifier: `f` at 1:1: `Alloca` names slot 0, which does not exist")
    let missing_field: list[MirInstruction] = [ins(InstructionForm.FieldAddress(result = r(0), struct_type = i64_t(), base = r(0), field = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_field)) == "MIR verifier: `f` at 1:1: `FieldAddress` needs a struct type, found `i64`")

pub func test_typed_element_moves_require_pointers_and_an_unsigned_count():
    let wrong_count_ops = OperandBuilder()
    let wrong_count = create_empty_mir_program()
    wrong_count.functions.append(function(wrong_count_ops, "f", [ptr_t(), ptr_t(), i64_t()], none_types(), [ptr_t(), ptr_t(), i64_t()], [
        ins(InstructionForm.MoveElements(destination = r(0), source = r(1), element_type = i64_t(), count = r(2))),
