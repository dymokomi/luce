#==============================================================================================
#
#   mir_verifier_test - One test per rule a backend may assume
#
#   DESCRIPTION:
#       Each test builds the smallest program that breaks exactly one rule
#       from docs/compiler/mir.md and pins the diagnostic. The MIR interpreter
#       tests cover the accepting side: every program there is verified first.
#
#==============================================================================================

from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from luce.compiler.mir.canonical import ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData, OperandBuilder, no_registers
from luce.compiler.mir.canonical import MirExtern, MirExternalGlobal, MirField, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.mir.canonical import MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.mir.canonical import TypeId, UnaryOp, builtin_mir_type
from luce.compiler.mir.canonical import create_empty_mir_program, find_runtime_symbol, intern_mir_type
from luce.compiler.mir.canonical import make_struct_type
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = u32(index))

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Int(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func ret(ops: OperandBuilder, values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = ops.run(regs(values))))

# Helpers take parameter and result lists rather than a `MirSignature`, because
# Stage-0 frees the lists of a struct returned by one call and passed straight
# into another.
pub func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        span = at(),
    )

pub func c_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], is_fallible: bool, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.c,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = is_fallible),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        span = at(),
    )

# A one-function program `f` with the given registers and body.
pub func program_with(ops: OperandBuilder, results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirProgram:
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", list[TypeId](), results, registers, body))
    return program

# Statement-form `catch reason: return reason` does not return under Stage-0
# 0.22; assigning through a `var` does.
pub func failure(program: MirProgram) -> str:
    var reported = ""
    MirVerifier(program).verify() catch reason:
        reported = reason
    return reported

pub func accepted(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func no_values() -> list[RegisterId]:
    return list[RegisterId]()

pub func none_types() -> list[TypeId]:
    return list[TypeId]()

# mark: Registers ============================================================================

pub func test_registers_are_used_only_after_definition():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_registers_are_defined_once():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(0, 1), const_int(0, 2), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r0 twice")

pub func test_undeclared_registers_are_rejected():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(3, 1), ret(ops, [3])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r3, which is not declared")

pub func test_definitions_inside_a_region_stay_inside_it():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        const_int(0, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_parameters_occupy_the_leading_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [bool_t()], [ret(ops, [0])]))
    assert(failure(program) == "MIR verifier: `f` register r0 must have its parameter's type")
    let short = create_empty_mir_program()
    short.functions.append(function(ops, "f", [i64_t()], [i64_t()], none_types(), [ret(ops, [0])]))
    assert(failure(short) == "MIR verifier: `f` declares fewer registers than parameters")

# mark: Operand types ========================================================================

pub func test_constants_must_fit_their_register():
    let ops = OperandBuilder()
    let outside: list[MirInstruction] = [const_int(0, 128), ret(ops, [0])]
    assert(failure(program_with(ops, [i8_t()], [i8_t()], outside)) == "MIR verifier: `f` at 1:1: constant 128 is outside `i8`")
    let wrong_kind: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_kind)) == "MIR verifier: `f` at 1:1: bool constant into `i64` register")
    let null_into_int: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], null_into_int)) == "MIR verifier: `f` at 1:1: null into `i64` register")

pub func test_binary_operands_must_share_a_type_the_operation_accepts():
    let ops = OperandBuilder()
    let mixed: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.add, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i32_t(), i64_t(), i64_t()], mixed)) == "MIR verifier: `f` at 1:1: `add` operands has `i32`, expected `i64`")
    let int_div: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.div, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], int_div)) == "MIR verifier: `f` at 1:1: `div` needs float operands; integers use `floor_div`")
    let bool_result: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.lt, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], bool_result)) == "MIR verifier: `f` at 1:1: `lt` result has `i64`, expected `bool`")
    let bool_shift: list[MirInstruction] = [const_bool(0, true), const_bool(1, true), binary(2, BinaryOp.shift_left, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t(), bool_t()], bool_shift)) == "MIR verifier: `f` at 1:1: `shift_left` needs integer operands, found `bool`")

pub func test_unary_and_convert_check_their_directions():
    let ops = OperandBuilder()
    let neg_bool: list[MirInstruction] = [const_bool(0, true), ins(InstructionForm.Unary(result = r(1), operation = UnaryOp.neg, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t()], neg_bool)) == "MIR verifier: `f` at 1:1: `neg` needs a signed integer or float, found `bool`")
    let narrow_extend: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.extend, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i8_t()], [i64_t(), i8_t()], narrow_extend)) == "MIR verifier: `f` at 1:1: `extend` must widen an integer, found `i64` to `i8`")
    let widen_wrap: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.wrap, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i8_t(), i64_t()], widen_wrap)) == "MIR verifier: `f` at 1:1: `wrap` must narrow an integer, found `i8` to `i64`")
    let bad_float: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.float_to_int, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], bad_float)) == "MIR verifier: `f` at 1:1: `float_to_int` needs a float operand and an integer result")

# mark: Memory ===============================================================================

pub func test_aggregates_never_travel_through_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let pair = intern_mir_type(program.types, make_struct_type([i32_t(), i32_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Load(result = r(1), value_type = pair, address = r(0))),
        ret(ops, list[i64]()),
    ]
    let function_value = MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false),
        registers = [ptr_t(), pair],
        slots = [MirSlot(value_type = pair)],
        body = body,
        operands = ops.operands,
        is_public = true,
        span = at(),
    )
    program.functions.append(function_value)
    assert(failure(program) == "MIR verifier: `f` at 1:1: `Load` of a struct; aggregates move with `Memcpy`")

pub func test_addresses_must_be_pointers_and_slots_must_exist():
    let ops = OperandBuilder()
    let not_pointer: list[MirInstruction] = [const_int(0, 4), ins(InstructionForm.Load(result = r(1), value_type = i64_t(), address = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], not_pointer)) == "MIR verifier: `f` at 1:1: `Load` address must be `ptr`, found `i64`")
    let missing_slot: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_slot)) == "MIR verifier: `f` at 1:1: `Alloca` names slot 0, which does not exist")
    let missing_field: list[MirInstruction] = [ins(InstructionForm.FieldAddress(result = r(0), struct_type = i64_t(), base = r(0), field = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_field)) == "MIR verifier: `f` at 1:1: `FieldAddress` needs a struct type, found `i64`")

pub func test_aggregate_types_are_structural_and_references_point_backward():
    let program = create_empty_mir_program()
    program.types.definitions.append(MirType.Struct(fields = [MirField(value_type = i32_t()), MirField(value_type = i64_t())]))
    accepted(program)

    let recursive = create_empty_mir_program()
    recursive.types.definitions.append(MirType.Struct(fields = [MirField(value_type = TypeId(value = 12))]))
    assert(failure(recursive) == "MIR verifier: type 12 refers to a type defined at or after it")

pub func test_data_alignment_and_global_initializers_are_validated():
    let program = create_empty_mir_program()
    program.data.append(MirData(name = "table", bytes = [0], align = 0))
    assert(failure(program) == "MIR verifier: data `table` has alignment 0")
    let uneven = create_empty_mir_program()
    uneven.data.append(MirData(name = "table", bytes = [0], align = 3))
    assert(failure(uneven) == "MIR verifier: data `table` has non-power-of-two alignment 3")
    let global_program = create_empty_mir_program()
    global_program.globals.append(MirGlobal(name = "g", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    assert(failure(global_program) == "MIR verifier: global `g` is initialised from data item 0, which does not exist")

pub func test_external_globals_are_unique_scalar_symbols_with_typed_accesses():
    let ops = OperandBuilder()
    let accepted_program = create_empty_mir_program()
    accepted_program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_t()))
    accepted_program.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 0))),
        ins(InstructionForm.StoreExternalGlobal(global = ExternalGlobalId(value = 0), value = r(0))),
        ret(ops, [0]),
    ]))
    accepted(accepted_program)

    let missing = create_empty_mir_program()
    missing.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 1))),
        ret(ops, [0]),
    ]))
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `LoadExternalGlobal` names external global 1, which does not exist")

    let aggregate = create_empty_mir_program()
    let pair = intern_mir_type(aggregate.types, make_struct_type([i32_t(), i32_t()]))
    aggregate.external_globals.append(MirExternalGlobal(name = "pair", value_type = pair))
    assert(failure(aggregate) == "MIR verifier: external global `pair` has non-scalar type `{i32, i32}`")

    let duplicate = create_empty_mir_program()
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(duplicate) == "MIR verifier: duplicate external global `state`")

    let kind_conflict = create_empty_mir_program()
    kind_conflict.externs.append(MirExtern(name = "state", convention = CallingConvention.c, signature = MirSignature(parameters = none_types(), results = [i32_t()], is_fallible = false)))
    kind_conflict.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(kind_conflict) == "MIR verifier: external symbol `state` is both a function and a global")

# mark: Control flow =========================================================================

pub func test_branch_depths_stay_within_enclosing_regions():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.Br(depth = 1, values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), none_types(), body)) == "MIR verifier: `f` at 1:1: branch depth 1 with 1 enclosing region(s)")

pub func test_a_block_with_results_must_supply_them():
    let ops = OperandBuilder()
    let falls_through: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        const_int(1, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], falls_through)) == "MIR verifier: `f` at 1:1: `Block` with results can fall off its end; supply them with `Yield` or `Br`")
    let wrong_count: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        ins(InstructionForm.Yield(values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_count)) == "MIR verifier: `f` at 1:1: `Yield` supplies 0 value(s), expected 1")
    let one_arm: list[MirInstruction] = [
        const_bool(0, true),
        ins(InstructionForm.If(condition = r(0), results = ops.run(regs([2])))),
        const_int(1, 1),
        ins(InstructionForm.Yield(values = ops.run(regs([1])))),
        ins(InstructionForm.End),
        ret(ops, [2]),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t(), i64_t()], one_arm)) == "MIR verifier: `f` at 1:1: `If` with results must supply them on both arms with `Yield` or `Br`")

pub func test_loops_take_no_values_on_a_branch():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Br(depth = 0, values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: a branch to a `Loop` restarts it and carries no values")
    let yield_values: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Yield(values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], yield_values)) == "MIR verifier: `f` at 1:1: `Yield` inside a `Loop`; a loop has no results, leave it with `Br`")

pub func test_conditions_and_tags_have_their_types():
    let ops = OperandBuilder()
    let int_condition: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], int_condition)) == "MIR verifier: `f` at 1:1: `If` condition must be `bool`, found `i64`")
    let repeated: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Default),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], repeated)) == "MIR verifier: `f` at 1:1: `Switch` repeats case 1")
    let no_default: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], no_default)) == "MIR verifier: `f` at 1:1: `Switch` needs a `Default` arm")
    let unclosed: list[MirInstruction] = [ins(InstructionForm.Block(results = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), unclosed)) == "MIR verifier: `f` has 1 region(s) without an `End`")
    let stray_else: list[MirInstruction] = [ins(InstructionForm.Else), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), stray_else)) == "MIR verifier: `f` at 1:1: `Else` outside an `If`, or a second `Else`")
    let yield_at_top: list[MirInstruction] = [ins(InstructionForm.Yield(values = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), yield_at_top)) == "MIR verifier: `f` at 1:1: `Yield` outside any region; use `Return`")

pub func test_functions_end_every_path():
    let ops = OperandBuilder()
    let falls_off: list[MirInstruction] = [const_int(0, 1)]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], falls_off)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")
    # Both arms of an `If` returning is a complete body.
    let both_arms: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.Else),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    accepted(program_with(ops, [i64_t()], [bool_t(), i64_t()], both_arms))
    # Without an else-arm the If can fall through, so the body needs more.
    let one_arm_only: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t()], one_arm_only)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")

# mark: Returns and failure ==================================================================

pub func test_returns_match_the_signature():
    let ops = OperandBuilder()
    let too_few: list[MirInstruction] = [ret(ops, list[i64]())]
    assert(failure(program_with(ops, [i64_t()], none_types(), too_few)) == "MIR verifier: `f` at 1:1: `Return` supplies 0 value(s), expected 1")
    let wrong_type: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [bool_t()], wrong_type)) == "MIR verifier: `f` at 1:1: `Return` value 0 has `bool`, expected `i64`")

pub func test_raise_needs_a_fallible_function():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(0)))]
    assert(failure(program_with(ops, none_types(), [ptr_t()], body)) == "MIR verifier: `f` at 1:1: `Raise` in a function that cannot fail")
    let program = create_empty_mir_program()
    program.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = [ptr_t()], is_fallible = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        span = at(),
    ))
    assert(failure(program) == "MIR verifier: function `f` is fallible but parameter 0 is not the caller-owned `ptr` error slot")

    let bad_result = create_empty_mir_program()
    bad_result.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [i64_t()], is_fallible = true),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        span = at(),
    ))
    assert(failure(bad_result) == "MIR verifier: function `f` is fallible but its last result is not the `ptr` error pointer")

    let wrong_slot = create_empty_mir_program()
    wrong_slot.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true),
        registers = [ptr_t(), ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(1)))],
        operands = ops.operands,
        is_public = true,
        span = at(),
    ))
    assert(failure(wrong_slot) == "MIR verifier: `f` at 1:1: `Raise` must return the caller-owned error slot in r0")

    let nonnull_return = create_empty_mir_program()
    nonnull_return.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Return(values = ops.run([r(0)])))],
        operands = ops.operands,
        is_public = true,
        span = at(),
    ))
    assert(failure(nonnull_return) == "MIR verifier: `f` at 1:1: `Return` from a fallible function must report success with a null error pointer; use `Raise r0` for failure")

pub func test_calls_match_their_target():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 0), arguments = no_registers())),
        ret(ops, [0]),
    ]
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [i64_t()], body))
    assert(failure(program) == "MIR verifier: `f` at 1:1: call passes 0 argument(s) to a signature with 1")
    let missing: list[MirInstruction] = [ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 7), arguments = no_registers())), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], missing)) == "MIR verifier: `f` at 1:1: `Call` names function 7, which does not exist")

# mark: Program-level rules ==================================================================

pub func test_runtime_externs_are_known_services_with_known_signatures():
    let ops = OperandBuilder()
    let unknown = create_empty_mir_program()
    unknown.externs.append(MirExtern(name = "luce_rt_teleport", convention = CallingConvention.runtime, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(unknown) == "MIR verifier: extern `luce_rt_teleport` is not a runtime service")
    let wrong = create_empty_mir_program()
    wrong.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = none_types(), is_fallible = false)))
    assert(failure(wrong) == "MIR verifier: runtime extern `luce_rt_write` has signature (ptr) -> (), expected (ptr, u64) -> ()")
    let luce_extern = create_empty_mir_program()
    luce_extern.externs.append(MirExtern(name = "helper", convention = CallingConvention.luce, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(luce_extern) == "MIR verifier: extern `helper` uses the `luce` convention; externs are C or runtime symbols")

pub func test_the_c_boundary_admits_only_c_representable_shapes():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let option = intern_mir_type(program.types, MirType.Enum(tag = i8_t(), cases = [i64_t()]))
    program.functions.append(c_function(ops, "exported", [option], none_types(), false, [option], [ret(ops, list[i64]())]))
    assert(failure(program) == "MIR verifier: function `exported` passes `enum(i8 | i64)` across the C boundary")
    let fallible = create_empty_mir_program()
    fallible.functions.append(c_function(ops, "exported", [ptr_t()], [i64_t(), ptr_t()], true, [ptr_t()], [ins(InstructionForm.Trap(reason = "never"))]))
    assert(failure(fallible) == "MIR verifier: function `exported` uses the `c` convention and cannot be fallible")

pub func test_entry_and_function_names_are_program_wide_facts():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(function(ops, "main", none_types(), [i64_t()], [i64_t()], [const_int(0, 0), ret(ops, [0])]))
    program.entry = FunctionId(value = 0)
    assert(failure(program) == "MIR verifier: entry `main` must be `() -> i32`, found () -> (i64)")
    let duplicate = create_empty_mir_program()
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    assert(failure(duplicate) == "MIR verifier: duplicate function `twice`")
    var good = create_empty_mir_program()
    good.functions.append(function(ops, "main", none_types(), [i32_t()], [i32_t()], [const_int(0, 0), ret(ops, [0])]))
    good.entry = FunctionId(value = 0)
    accepted(good)
