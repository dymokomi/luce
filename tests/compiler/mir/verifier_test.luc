    wrong_finish.functions.append(function(wrong_finish_ops, "f", [ptr_t()], none_types(), [ptr_t(), buffer_owner_t()], [
        ins(InstructionForm.BufferBuilderFinish(result = r(1), builder = r(0))),
        ret(wrong_finish_ops, list[i64]()),
    ]))
    assert(failure(wrong_finish) == "MIR verifier: `f` at 1:1: `BufferBuilderFinish` builder must be `buffer-builder`, found `ptr`")

    let wrong_display_value_ops = OperandBuilder()
    let wrong_display_value = create_empty_mir_program()
    wrong_display_value.functions.append(function(wrong_display_value_ops, "f", [u64_t()], none_types(), [u64_t(), buffer_owner_t()], [
        ins(InstructionForm.DisplaySigned(result = r(1), value = r(0))),
        ret(wrong_display_value_ops, list[i64]()),
    ]))
    assert(failure(wrong_display_value) == "MIR verifier: `f` at 1:1: `DisplaySigned` value has `u64`, expected `i64`")

    let wrong_display_result_ops = OperandBuilder()
    let wrong_display_result = create_empty_mir_program()
    wrong_display_result.functions.append(function(wrong_display_result_ops, "f", [i64_t()], none_types(), [i64_t(), ptr_t()], [
        ins(InstructionForm.DisplaySigned(result = r(1), value = r(0))),
        ret(wrong_display_result_ops, list[i64]()),
    ]))
    assert(failure(wrong_display_result) == "MIR verifier: `f` at 1:1: `DisplaySigned` result must be `buffer-owner`, found `ptr`")

    let missing_ops = OperandBuilder()
    let missing = create_empty_mir_program()
    let builder = intern_mir_type(missing.types, MirType.BufferBuilder)
    missing.functions.append(function(missing_ops, "f", none_types(), none_types(), [builder], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ret(missing_ops, list[i64]()),
    ]))
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `BufferBuilderCreate` requires the `buffer_builder_create` runtime binding")

pub func test_buffer_builders_are_affine_and_lexically_scoped():
    let valid_ops = OperandBuilder()
    let valid = create_empty_mir_program()
    bind_buffer_services(valid)
    let valid_builder = intern_mir_type(valid.types, MirType.BufferBuilder)
    valid.functions.append(function(valid_ops, "f", none_types(), none_types(), [valid_builder, ptr_t(), u64_t(), buffer_owner_t()], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        const_uint(2, u64(0)),
        ins(InstructionForm.BufferBuilderAppend(builder = r(0), data = r(1), length = r(2))),
        ins(InstructionForm.BufferBuilderFinish(result = r(3), builder = r(0))),
        ins(InstructionForm.BufferRelease(value = r(3))),
        ret(valid_ops, list[i64]()),
    ]))
    accepted(valid)

    let forged_ops = OperandBuilder()
    let forged = create_empty_mir_program()
    bind_buffer_services(forged)
    let forged_builder = intern_mir_type(forged.types, MirType.BufferBuilder)
    forged.functions.append(function(forged_ops, "f", none_types(), none_types(), [forged_builder, ptr_t(), u64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        const_uint(2, u64(0)),
        ins(InstructionForm.BufferBuilderAppend(builder = r(0), data = r(1), length = r(2))),
        ret(forged_ops, list[i64]()),
    ]))
    assert(failure(forged) == "MIR verifier: `f` at 1:1: `BufferBuilderAppend` uses a builder not produced by `BufferBuilderCreate`")

    let stored_ops = OperandBuilder()
    let stored = create_empty_mir_program()
    bind_buffer_services(stored)
    let stored_builder = intern_mir_type(stored.types, MirType.BufferBuilder)
    stored.functions.append(function(stored_ops, "f", none_types(), none_types(), [stored_builder, ptr_t(), buffer_owner_t()], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)),
        ins(InstructionForm.Store(value_type = stored_builder, address = r(1), value = r(0))),
        ins(InstructionForm.BufferBuilderFinish(result = r(2), builder = r(0))),
        ins(InstructionForm.BufferRelease(value = r(2))),
        ret(stored_ops, list[i64]()),
    ]))
    assert(failure(stored) == "MIR verifier: `f` at 1:1: `Store` cannot store transient `buffer-builder`")

    let signature_ops = OperandBuilder()
    let signature = create_empty_mir_program()
    let signature_builder = intern_mir_type(signature.types, MirType.BufferBuilder)
    signature.functions.append(function(signature_ops, "f", [signature_builder], none_types(), [signature_builder], [
        ins(InstructionForm.Trap(reason = "stop")),
    ]))
    assert(failure(signature) == "MIR verifier: function `f` parameter cannot store transient `buffer-builder`")

    let unfinished_ops = OperandBuilder()
    let unfinished = create_empty_mir_program()
    bind_buffer_services(unfinished)
    let unfinished_builder = intern_mir_type(unfinished.types, MirType.BufferBuilder)
    unfinished.functions.append(function(unfinished_ops, "f", none_types(), none_types(), [unfinished_builder], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ret(unfinished_ops, list[i64]()),
    ]))
    assert(failure(unfinished) == "MIR verifier: `f` at 1:1: `Return` bypasses `BufferBuilderFinish` for r0")

    let reused_ops = OperandBuilder()
    let reused = create_empty_mir_program()
    bind_buffer_services(reused)
    let reused_builder = intern_mir_type(reused.types, MirType.BufferBuilder)
    reused.functions.append(function(reused_ops, "f", none_types(), none_types(), [reused_builder, buffer_owner_t(), ptr_t(), u64_t()], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.BufferBuilderFinish(result = r(1), builder = r(0))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Null)),
        const_uint(3, u64(0)),
        ins(InstructionForm.BufferBuilderAppend(builder = r(0), data = r(2), length = r(3))),
        ret(reused_ops, list[i64]()),
    ]))
    assert(failure(reused) == "MIR verifier: `f` at 1:1: `BufferBuilderAppend` uses a builder after `BufferBuilderFinish`")

    let twice_ops = OperandBuilder()
    let twice = create_empty_mir_program()
    bind_buffer_services(twice)
    let twice_builder = intern_mir_type(twice.types, MirType.BufferBuilder)
    twice.functions.append(function(twice_ops, "f", none_types(), none_types(), [twice_builder, buffer_owner_t(), buffer_owner_t()], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.BufferBuilderFinish(result = r(1), builder = r(0))),
        ins(InstructionForm.BufferBuilderFinish(result = r(2), builder = r(0))),
        ret(twice_ops, list[i64]()),
    ]))
    assert(failure(twice) == "MIR verifier: `f` at 1:1: `BufferBuilderFinish` uses a builder after `BufferBuilderFinish`")

    let escaped_ops = OperandBuilder()
    let escaped = create_empty_mir_program()
    bind_buffer_services(escaped)
    let escaped_builder = intern_mir_type(escaped.types, MirType.BufferBuilder)
    escaped.functions.append(function(escaped_ops, "f", none_types(), none_types(), [escaped_builder], [
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.Br(depth = 0, values = escaped_ops.run(no_values()))),
        ins(InstructionForm.End),
        ret(escaped_ops, list[i64]()),
    ]))
    assert(failure(escaped) == "MIR verifier: `f` at 1:1: `Br` bypasses `BufferBuilderFinish` for r0")

    let crossed_ops = OperandBuilder()
    let crossed = create_empty_mir_program()
    bind_buffer_services(crossed)
    let crossed_builder = intern_mir_type(crossed.types, MirType.BufferBuilder)
    crossed.functions.append(function(crossed_ops, "f", none_types(), none_types(), [crossed_builder, bool_t(), buffer_owner_t()], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        const_bool(1, true),
        ins(InstructionForm.If(condition = r(1), results = no_registers())),
        ins(InstructionForm.BufferBuilderFinish(result = r(2), builder = r(0))),
        ins(InstructionForm.End),
        ret(crossed_ops, list[i64]()),
    ]))
    assert(failure(crossed) == "MIR verifier: `f` at 1:1: `BufferBuilderFinish` must stay in its builder's lexical region path")

    let trapping_ops = OperandBuilder()
    let trapping = create_empty_mir_program()
    bind_buffer_services(trapping)
    let trapping_builder = intern_mir_type(trapping.types, MirType.BufferBuilder)
    trapping.functions.append(function(trapping_ops, "f", none_types(), none_types(), [trapping_builder], [
        ins(InstructionForm.BufferBuilderCreate(result = r(0))),
        ins(InstructionForm.Trap(reason = "stop")),
    ]))
    accepted(trapping)

pub func test_string_operations_require_exact_scalar_results_and_runtime_services():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    bind_buffer_services(program)
    program.functions.append(function(ops, "f", [ptr_t(), u64_t(), u64_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u32_t(), u64_t(), u64_t()], [
        ins(InstructionForm.StringScalarCount(result = r(5), data = r(0), length = r(1))),
        ins(InstructionForm.StringDecode(character = r(3), width = r(4), data = r(0), length = r(1), offset = r(2))),
        ret(ops, list[i64]()),
    ]))
    accepted(program)

    let missing_ops = OperandBuilder()
    let missing = program_with(missing_ops, none_types(), [ptr_t(), u64_t(), u64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        const_uint(1, u64(0)),
        ins(InstructionForm.StringScalarCount(result = r(2), data = r(0), length = r(1))),
        ret(missing_ops, list[i64]()),
    ])
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `StringScalarCount` requires the `string_scalar_count` runtime binding")

    let wrong_ops = OperandBuilder()
    let wrong = create_empty_mir_program()
    bind_buffer_services(wrong)
    wrong.functions.append(function(wrong_ops, "f", [ptr_t(), u64_t(), u64_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u64_t(), u64_t()], [
        ins(InstructionForm.StringDecode(character = r(3), width = r(4), data = r(0), length = r(1), offset = r(2))),
        ret(wrong_ops, list[i64]()),
    ]))
    assert(failure(wrong) == "MIR verifier: `f` at 1:1: `StringDecode` character result has `u64`, expected `u32`")

pub func test_list_operations_retain_and_require_one_canonical_element_type():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let list_i64 = intern_mir_type(program.types, MirType.List(element = i64_t()))
    let slice_i64 = intern_mir_type(program.types, MirType.Slice(element = i64_t()))
    bind_list_services(program)
    program.functions.append(function(ops, "f", none_types(), [u64_t()], [list_i64, u64_t(), ptr_t(), u64_t(), ptr_t(), u64_t(), ptr_t(), u64_t(), list_i64, ptr_t(), slice_i64, u64_t(), ptr_t(), list_i64, u64_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListRetain(value = r(0))),
        ins(InstructionForm.ListRelease(value = r(0), element_release = FunctionId(value = 0))),
        ins(InstructionForm.ListCopy(result = r(8), value = r(0), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListConcat(result = r(13), left = r(0), right = r(8), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListLength(result = r(1), value = r(0))),
        ins(InstructionForm.ListIterationBegin(result = r(14), value = r(0))),
        ins(InstructionForm.ListIterationEnd(value = r(0))),
        ins(InstructionForm.ListAppendSlot(result = r(2), value = r(0), element_retain = FunctionId(value = 0))),
        const_uint(3, u64(0)),
        ins(InstructionForm.ListElementAddress(result = r(4), value = r(0), index = r(3))),
        ins(InstructionForm.ListMutableElementAddress(result = r(9), value = r(0), index = r(3), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListSlice(result = r(10), value = r(0), start = r(3), end = r(1))),
        ins(InstructionForm.SliceRetain(value = r(10))),
        ins(InstructionForm.SliceRelease(value = r(10), element_release = FunctionId(value = 0))),
        ins(InstructionForm.SliceLength(result = r(11), value = r(10))),
        ins(InstructionForm.SliceElementAddress(result = r(12), value = r(10), index = r(3))),
        const_uint(5, u64(1)),
        ins(InstructionForm.ListInsertSlot(result = r(6), value = r(0), index = r(5), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListRemoveAt(value = r(0), index = r(3), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListReserve(value = r(0), minimum_capacity = r(5), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListClear(value = r(0), element_release = FunctionId(value = 0))),
        ret(ops, [1]),
    ]))
    accepted(program)

    let wrong_index_ops = OperandBuilder()
    let wrong_index = create_empty_mir_program()
    let wrong_list_type = intern_mir_type(wrong_index.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_index)
    wrong_index.functions.append(function(wrong_index_ops, "f", none_types(), none_types(), [wrong_list_type, i64_t(), ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        ins(InstructionForm.ListInsertSlot(result = r(2), value = r(0), index = r(1), element_retain = FunctionId(value = 0))),
        ret(wrong_index_ops, list[i64]()),
    ]))
    assert(failure(wrong_index) == "MIR verifier: `f` at 1:1: `ListInsertSlot` index has `i64`, expected `u64`")

    let forged_ops = OperandBuilder()
    let forged = create_empty_mir_program()
    discard(intern_mir_type(forged.types, MirType.List(element = i64_t())))
    bind_list_services(forged)
    forged.functions.append(function(forged_ops, "f", none_types(), none_types(), [ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ret(forged_ops, list[i64]()),
    ]))
    assert(failure(forged) == "MIR verifier: `f` at 1:1: `ListCreate` result must be a typed list handle, found `ptr`")

    let wrong_value_ops = OperandBuilder()
    let wrong_value = create_empty_mir_program()
    bind_list_services(wrong_value)
    wrong_value.functions.append(function(wrong_value_ops, "f", none_types(), [u64_t()], [ptr_t(), u64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.ListLength(result = r(1), value = r(0))),
        ret(wrong_value_ops, [1]),
    ]))
    assert(failure(wrong_value) == "MIR verifier: `f` at 1:1: `ListLength` value must be a typed list handle, found `ptr`")

    let wrong_iteration_ops = OperandBuilder()
    let wrong_iteration = create_empty_mir_program()
    let iterated_list = intern_mir_type(wrong_iteration.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_iteration)
    wrong_iteration.functions.append(function(wrong_iteration_ops, "f", none_types(), none_types(), [iterated_list, i64_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListIterationBegin(result = r(1), value = r(0))),
        ret(wrong_iteration_ops, list[i64]()),
    ]))
    assert(failure(wrong_iteration) == "MIR verifier: `f` at 1:1: `ListIterationBegin` result has `i64`, expected `u64`")

    let missing_active_ops = OperandBuilder()
    let missing_active = create_empty_mir_program()
    let active_list = intern_mir_type(missing_active.types, MirType.List(element = i64_t()))
    bind_list_services(missing_active)
    missing_active.runtime_bindings.remove(16)
    missing_active.functions.append(function(missing_active_ops, "f", none_types(), none_types(), [active_list, ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListAppendSlot(result = r(1), value = r(0), element_retain = FunctionId(value = 0))),
        ret(missing_active_ops, list[i64]()),
    ]))
    assert(failure(missing_active) == "MIR verifier: `f` at 1:1: `ListAppendSlot` requires the `list_iteration_active` and `list_append_slot` runtime bindings")

    let wrong_copy_ops = OperandBuilder()
    let wrong_copy = create_empty_mir_program()
    let source_list = intern_mir_type(wrong_copy.types, MirType.List(element = i64_t()))
    let result_list = intern_mir_type(wrong_copy.types, MirType.List(element = i8_t()))
    bind_list_services(wrong_copy)
    wrong_copy.functions.append(function(wrong_copy_ops, "f", none_types(), none_types(), [source_list, result_list], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCopy(result = r(1), value = r(0), element_retain = FunctionId(value = 0))),
        ret(wrong_copy_ops, list[i64]()),
    ]))
    assert(failure(wrong_copy) == "MIR verifier: `f` at 1:1: `ListCopy` result element has `i8`, expected `i64`")

    let wrong_action_ops = OperandBuilder()
    let wrong_action = create_empty_mir_program()
    let action_list = intern_mir_type(wrong_action.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_action)
    wrong_action.functions.append(function(wrong_action_ops, "f", none_types(), none_types(), [action_list, action_list], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCopy(result = r(1), value = r(0), element_retain = FunctionId(value = 1))),
        ret(wrong_action_ops, list[i64]()),
    ]))
    assert(failure(wrong_action) == "MIR verifier: `f` at 1:1: `ListCopy` element retain has signature () -> (ptr), expected (ptr) -> ()")

    let wrong_concat_ops = OperandBuilder()
    let wrong_concat = create_empty_mir_program()
    let concat_left = intern_mir_type(wrong_concat.types, MirType.List(element = i64_t()))
    let concat_right = intern_mir_type(wrong_concat.types, MirType.List(element = i8_t()))
    bind_list_services(wrong_concat)
    wrong_concat.functions.append(function(wrong_concat_ops, "f", none_types(), none_types(), [concat_left, concat_right, concat_left], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCreate(result = r(1))),
        ins(InstructionForm.ListConcat(result = r(2), left = r(0), right = r(1), element_retain = FunctionId(value = 0))),
        ret(wrong_concat_ops, list[i64]()),
    ]))
    assert(failure(wrong_concat) == "MIR verifier: `f` at 1:1: `ListConcat` right element has `i8`, expected `i64`")

    let wrong_slice_ops = OperandBuilder()
    let wrong_slice = create_empty_mir_program()
    let sliced_list = intern_mir_type(wrong_slice.types, MirType.List(element = i64_t()))
    let wrong_slice_result = intern_mir_type(wrong_slice.types, MirType.Slice(element = i8_t()))
    bind_list_services(wrong_slice)
    wrong_slice.functions.append(function(wrong_slice_ops, "f", none_types(), none_types(), [sliced_list, u64_t(), wrong_slice_result], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_uint(1, u64(0)),
        ins(InstructionForm.ListSlice(result = r(2), value = r(0), start = r(1), end = r(1))),
        ret(wrong_slice_ops, list[i64]()),
    ]))
    assert(failure(wrong_slice) == "MIR verifier: `f` at 1:1: `ListSlice` result element has `i8`, expected `i64`")

    let wrong_bound_ops = OperandBuilder()
    let wrong_bound = create_empty_mir_program()
    let bound_list = intern_mir_type(wrong_bound.types, MirType.List(element = i64_t()))
    let bound_slice = intern_mir_type(wrong_bound.types, MirType.Slice(element = i64_t()))
    bind_list_services(wrong_bound)
    wrong_bound.functions.append(function(wrong_bound_ops, "f", none_types(), none_types(), [bound_list, i64_t(), u64_t(), bound_slice], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        const_uint(2, u64(0)),
        ins(InstructionForm.ListSlice(result = r(3), value = r(0), start = r(1), end = r(2))),
        ret(wrong_bound_ops, list[i64]()),
    ]))
    assert(failure(wrong_bound) == "MIR verifier: `f` at 1:1: `ListSlice` start has `i64`, expected `u64`")

    let forged_slice_ops = OperandBuilder()
    let forged_slice = create_empty_mir_program()
    let forged_list = intern_mir_type(forged_slice.types, MirType.List(element = i64_t()))
    bind_list_services(forged_slice)
    forged_slice.functions.append(function(forged_slice_ops, "f", none_types(), none_types(), [forged_list, u64_t(), ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_uint(1, u64(0)),
        ins(InstructionForm.SliceElementAddress(result = r(2), value = r(0), index = r(1))),
        ret(forged_slice_ops, list[i64]()),
    ]))
    assert(failure(forged_slice) == "MIR verifier: `f` at 1:1: `SliceElementAddress` value must be a typed slice handle, found `list[i64]`")

    let wrong_service_ops = OperandBuilder()
    let wrong_service = create_empty_mir_program()
    wrong_service.functions.append(private_function(wrong_service_ops, "runtime.list_copy", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(wrong_service_ops, [1]),
    ]))
    wrong_service.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_copy, function = FunctionId(value = 0)))
    assert(failure(wrong_service) == "MIR verifier: runtime binding `list_copy` has signature (ptr) -> (ptr), expected (ptr, u64, u64, ptr) -> (ptr)")

    let wrong_concat_service_ops = OperandBuilder()
    let wrong_concat_service = create_empty_mir_program()
    wrong_concat_service.functions.append(private_function(wrong_concat_service_ops, "runtime.list_concat", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(wrong_concat_service_ops, [1]),
    ]))
    wrong_concat_service.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_concat, function = FunctionId(value = 0)))
    assert(failure(wrong_concat_service) == "MIR verifier: runtime binding `list_concat` has signature (ptr) -> (ptr), expected (ptr, ptr, u64, u64, ptr) -> (ptr)")

    let recursive = create_empty_mir_program()
    recursive.types.definitions.append(MirType.List(element = custom_t()))
    accepted(recursive)

    let missing = create_empty_mir_program()
    missing.types.definitions.append(MirType.List(element = custom_t(1)))
    assert(failure(missing) == "MIR verifier: list type " + str(custom_t().value) + " names type " + str(custom_t(1).value) + ", which does not exist")

pub func test_aggregate_types_are_structural_and_only_by_value_cycles_fail():
    let program = create_empty_mir_program()
    program.types.definitions.append(MirType.Struct(fields = [MirField(value_type = i32_t()), MirField(value_type = i64_t())]))
    accepted(program)

    let recursive = create_empty_mir_program()
    recursive.types.definitions.append(MirType.Struct(fields = [MirField(value_type = custom_t())]))
    assert(failure(recursive) == "MIR verifier: type " + str(custom_t().value) + " contains itself by value")

    let through_list = create_empty_mir_program()
    through_list.types.definitions.append(MirType.Struct(fields = [MirField(value_type = custom_t(1))]))
    through_list.types.definitions.append(MirType.List(element = custom_t()))
    accepted(through_list)
    assert(describe_mir_type(through_list.types, custom_t()) == "{list[type#" + str(custom_t().value) + "]}")

pub func test_data_alignment_and_global_initializers_are_validated():
    let program = create_empty_mir_program()
    program.data.append(MirData(name = "table", bytes = [0], align = 0))
    assert(failure(program) == "MIR verifier: data `table` has alignment 0")
    let uneven = create_empty_mir_program()
    uneven.data.append(MirData(name = "table", bytes = [0], align = 3))
    assert(failure(uneven) == "MIR verifier: data `table` has non-power-of-two alignment 3")
    let global_program = create_empty_mir_program()
    global_program.globals.append(MirGlobal(name = "g", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    assert(failure(global_program) == "MIR verifier: global `g` is initialised from data item 0, which does not exist")

pub func test_external_globals_are_unique_scalar_symbols_with_typed_accesses():
    let ops = OperandBuilder()
    let accepted_program = create_empty_mir_program()
    accepted_program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_t()))
    accepted_program.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 0))),
        ins(InstructionForm.StoreExternalGlobal(global = ExternalGlobalId(value = 0), value = r(0))),
        ret(ops, [0]),
    ]))
    accepted(accepted_program)

    let missing = create_empty_mir_program()
    missing.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 1))),
        ret(ops, [0]),
    ]))
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `LoadExternalGlobal` names external global 1, which does not exist")

    let aggregate = create_empty_mir_program()
    let pair = intern_mir_type(aggregate.types, make_struct_type([i32_t(), i32_t()]))
    aggregate.external_globals.append(MirExternalGlobal(name = "pair", value_type = pair))
    assert(failure(aggregate) == "MIR verifier: external global `pair` has non-scalar type `{i32, i32}`")

    let half = create_empty_mir_program()
    half.external_globals.append(MirExternalGlobal(name = "half", value_type = builtin_mir_type(BuiltinMirType.float16)))
    assert(failure(half) == "MIR verifier: external global `half` has non-C-ABI type `f16`")

    let duplicate = create_empty_mir_program()
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(duplicate) == "MIR verifier: duplicate external global `state`")

    let kind_conflict = create_empty_mir_program()
    kind_conflict.externs.append(MirExtern(name = "state", convention = CallingConvention.c, signature = MirSignature(parameters = none_types(), results = [i32_t()], is_fallible = false, returns_never = false)))
    kind_conflict.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(kind_conflict) == "MIR verifier: external symbol `state` is both a function and a global")

# mark: Function descriptors =================================================================

pub func test_closure_metadata_fully_describes_its_hidden_body_and_destroyer():
    let wrong_body = create_empty_mir_program()
    discard(append_valid_closure(wrong_body))
    let metadata = wrong_body.closures[0]
    wrong_body.closures[0] = MirClosure(
        function = FunctionId(value = 2),
        signature = metadata.signature,
        captures = metadata.captures,
        destroyer = metadata.destroyer,
    )
    assert(failure(wrong_body) == "MIR verifier: closure 0 body has signature () -> (i64), expected (ptr) -> (i64)")

    let wrong_destroyer = create_empty_mir_program()
    discard(append_valid_closure(wrong_destroyer))
    let destroy_metadata = wrong_destroyer.closures[0]
    wrong_destroyer.closures[0] = MirClosure(
        function = destroy_metadata.function,
        signature = destroy_metadata.signature,
        captures = destroy_metadata.captures,
        destroyer = FunctionId(value = 2),
    )
    assert(failure(wrong_destroyer) == "MIR verifier: closure 0 destroyer has signature () -> (i64), expected (ptr, bool) -> ()")

pub func test_function_descriptor_initializers_require_exact_func_signatures():
    let accepted_program = create_empty_mir_program()
    let function_type = append_valid_closure(accepted_program)
    let signature = accepted_program.closures[0].signature
    let ops = OperandBuilder()
    accepted_program.functions.append(function(ops, "main", none_types(), none_types(), [ptr_t(), ptr_t(), ptr_t(), i64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.FunctionNull(destination = r(0), function_type = function_type)),
        ins(InstructionForm.FunctionValue(destination = r(0), function_type = function_type, function = FunctionId(value = 2))),
        ins(InstructionForm.ClosureCreate(environment = r(1), destination = r(0), function_type = function_type, closure = ClosureId(value = 0))),
        ins(InstructionForm.ClosureMarkInitialized(environment = r(1))),
        ins(InstructionForm.ClosureCaptureAddress(result = r(2), environment = r(1), closure = ClosureId(value = 0), capture = 0)),
        ins(InstructionForm.FunctionRetain(value = r(0))),
        ins(InstructionForm.CallClosure(results = ops.run(regs([3])), signature = signature, target = r(0), arguments = no_registers())),
        ins(InstructionForm.FunctionRelease(value = r(0))),
        ret(ops, list[i64]()),
    ]))
    bind_class_services(accepted_program)
    accepted(accepted_program)

    let non_function_ops = OperandBuilder()
    let non_function = program_with(non_function_ops, none_types(), [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.FunctionNull(destination = r(0), function_type = i64_t())),
        ret(non_function_ops, list[i64]()),
    ])
    assert(failure(non_function) == "MIR verifier: `f` at 1:1: `FunctionNull` type must be `func`, found `i64`")

    let wrong_target = create_empty_mir_program()
    discard(append_valid_closure(wrong_target))
    let bool_signature = MirSignature(parameters = none_types(), results = [bool_t()], is_fallible = false, returns_never = false)
    let bool_function = intern_mir_type(wrong_target.types, MirType.Func(signature = bool_signature))
    let target_ops = OperandBuilder()
    wrong_target.functions.append(function(target_ops, "main", none_types(), none_types(), [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.FunctionValue(destination = r(0), function_type = bool_function, function = FunctionId(value = 2))),
        ret(target_ops, list[i64]()),
    ]))
    assert(failure(wrong_target) == "MIR verifier: `main` at 1:1: `FunctionValue` target has signature () -> (i64), expected () -> (bool)")

    let wrong_closure = create_empty_mir_program()
    discard(append_valid_closure(wrong_closure))
    let wrong_closure_type = intern_mir_type(wrong_closure.types, MirType.Func(signature = bool_signature))
    let closure_ops = OperandBuilder()
    wrong_closure.functions.append(function(closure_ops, "main", none_types(), none_types(), [ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.ClosureCreate(environment = r(1), destination = r(0), function_type = wrong_closure_type, closure = ClosureId(value = 0))),
        ret(closure_ops, list[i64]()),
    ]))
    bind_class_services(wrong_closure)
    assert(failure(wrong_closure) == "MIR verifier: `main` at 1:1: `ClosureCreate` metadata has signature () -> (i64), expected () -> (bool)")

pub func test_closure_payload_operations_require_valid_metadata_and_services():
    let out_of_bounds = create_empty_mir_program()
    discard(append_valid_closure(out_of_bounds))
    let ops = OperandBuilder()
    out_of_bounds.functions.append(function(ops, "main", none_types(), none_types(), [ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.ClosureCaptureAddress(result = r(1), environment = r(0), closure = ClosureId(value = 0), capture = 1)),
        ret(ops, list[i64]()),
    ]))
    bind_class_services(out_of_bounds)
    assert(failure(out_of_bounds) == "MIR verifier: `main` at 1:1: `ClosureCaptureAddress` names a missing capture")

    let no_create_service = create_empty_mir_program()
    let function_type = append_valid_closure(no_create_service)
    let create_ops = OperandBuilder()
    no_create_service.functions.append(function(create_ops, "main", none_types(), none_types(), [ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.ClosureCreate(environment = r(1), destination = r(0), function_type = function_type, closure = ClosureId(value = 0))),
        ret(create_ops, list[i64]()),
    ]))
    assert(failure(no_create_service) == "MIR verifier: `main` at 1:1: `ClosureCreate` requires the `class_create` runtime binding")

# mark: Interface witnesses ==================================================================

pub func test_interface_metadata_requires_exact_private_witnesses_and_ownership_helpers():
    let valid = create_empty_mir_program()
    discard(append_valid_interface(valid))
    accepted(valid)

    let missing_witness = create_empty_mir_program()
    discard(append_valid_interface(missing_witness))
    let metadata = missing_witness.conformances[0]
    missing_witness.conformances[0] = MirConformance(
        interface_id = metadata.interface_id,
        value_type = metadata.value_type,
        implementations = list[FunctionId](),
        retain = metadata.retain,
        release = metadata.release,
    )
    assert(failure(missing_witness) == "MIR verifier: conformance 0 has 0 witness(es), expected 1")

    let public_witness = create_empty_mir_program()
    discard(append_valid_interface(public_witness))
    let witness = public_witness.functions[0]
    public_witness.functions[0] = MirFunction(
        name = witness.name,
        convention = witness.convention,
        signature = witness.signature,
        registers = witness.registers,
        slots = witness.slots,
        body = witness.body,
        operands = witness.operands,
        is_public = true,
        is_exported = witness.is_exported,
        span = witness.span,
    )
    assert(failure(public_witness) == "MIR verifier: conformance 0 witness 0 does not match its requirement")

pub func test_interface_operations_require_nominal_handles_and_runtime_services():
    let create_ops = OperandBuilder()
    let missing_create = create_empty_mir_program()
    let interface_type = append_valid_interface(missing_create)
    missing_create.functions.append(function(create_ops, "main", [ptr_t()], [interface_type], [ptr_t(), interface_type], [
        ins(InstructionForm.InterfaceCreate(result = r(1), source = r(0), conformance = ConformanceId(value = 0))),
        ret(create_ops, [1]),
    ]))
    assert(failure(missing_create) == "MIR verifier: `main` at 1:1: `InterfaceCreate` requires the `interface_create` runtime binding")

    let forged_ops = OperandBuilder()
    let forged = create_empty_mir_program()
    discard(append_valid_interface(forged))
    forged.functions.append(function(forged_ops, "main", [ptr_t()], none_types(), [ptr_t()], [
        ins(InstructionForm.InterfaceRetain(value = r(0))),
        ret(forged_ops, list[i64]()),
    ]))
    assert(failure(forged) == "MIR verifier: `main` at 1:1: `InterfaceRetain` value must be an interface handle, found `ptr`")

    let call_ops = OperandBuilder()
    let missing_dispatch = create_empty_mir_program()
    let called_interface = append_valid_interface(missing_dispatch)
    missing_dispatch.functions.append(function(call_ops, "main", [called_interface, ptr_t()], [i64_t()], [called_interface, ptr_t(), i64_t()], [
        ins(InstructionForm.CallInterface(
            results = call_ops.run([r(2)]),
            interface_id = InterfaceId(value = 0),
            requirement = 0,
            target = r(0),
            arguments = call_ops.run([r(1)]),
        )),
        ret(call_ops, [2]),
    ]))
    assert(failure(missing_dispatch) == "MIR verifier: `main` at 1:1: `CallInterface` requires the `interface_witness` runtime binding")

# mark: Control flow =========================================================================

pub func test_branch_depths_stay_within_enclosing_regions():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.Br(depth = 1, values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), none_types(), body)) == "MIR verifier: `f` at 1:1: branch depth 1 with 1 enclosing region(s)")

pub func test_a_block_with_results_must_supply_them():
    let ops = OperandBuilder()
    let falls_through: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        const_int(1, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], falls_through)) == "MIR verifier: `f` at 1:1: `Block` with results can fall off its end; supply them with `Yield` or `Br`")
    let wrong_count: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        ins(InstructionForm.Yield(values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_count)) == "MIR verifier: `f` at 1:1: `Yield` supplies 0 value(s), expected 1")
    let one_arm: list[MirInstruction] = [
        const_bool(0, true),
        ins(InstructionForm.If(condition = r(0), results = ops.run(regs([2])))),
        const_int(1, 1),
        ins(InstructionForm.Yield(values = ops.run(regs([1])))),
        ins(InstructionForm.End),
        ret(ops, [2]),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t(), i64_t()], one_arm)) == "MIR verifier: `f` at 1:1: `If` with results must supply them on both arms with `Yield` or `Br`")

pub func test_loops_take_no_values_on_a_branch():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Br(depth = 0, values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: a branch to a `Loop` restarts it and carries no values")
    let yield_values: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Yield(values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], yield_values)) == "MIR verifier: `f` at 1:1: `Yield` inside a `Loop`; a loop has no results, leave it with `Br`")

pub func test_conditions_and_tags_have_their_types():
    let ops = OperandBuilder()
    let int_condition: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], int_condition)) == "MIR verifier: `f` at 1:1: `If` condition must be `bool`, found `i64`")
    let repeated: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Default),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], repeated)) == "MIR verifier: `f` at 1:1: `Switch` repeats case 1")
    let no_default: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], no_default)) == "MIR verifier: `f` at 1:1: `Switch` needs a `Default` arm")
    let unclosed: list[MirInstruction] = [ins(InstructionForm.Block(results = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), unclosed)) == "MIR verifier: `f` has 1 region(s) without an `End`")
    let stray_else: list[MirInstruction] = [ins(InstructionForm.Else), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), stray_else)) == "MIR verifier: `f` at 1:1: `Else` outside an `If`, or a second `Else`")
    let yield_at_top: list[MirInstruction] = [ins(InstructionForm.Yield(values = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), yield_at_top)) == "MIR verifier: `f` at 1:1: `Yield` outside any region; use `Return`")

pub func test_functions_end_every_path():
    let ops = OperandBuilder()
    let falls_off: list[MirInstruction] = [const_int(0, 1)]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], falls_off)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")
    # Both arms of an `If` returning is a complete body.
    let both_arms: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.Else),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    accepted(program_with(ops, [i64_t()], [bool_t(), i64_t()], both_arms))
    # Without an else-arm the If can fall through, so the body needs more.
    let one_arm_only: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t()], one_arm_only)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")

# mark: Returns and failure ==================================================================

pub func test_returns_match_the_signature():
    let ops = OperandBuilder()
    let too_few: list[MirInstruction] = [ret(ops, list[i64]())]
    assert(failure(program_with(ops, [i64_t()], none_types(), too_few)) == "MIR verifier: `f` at 1:1: `Return` supplies 0 value(s), expected 1")
    let wrong_type: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [bool_t()], wrong_type)) == "MIR verifier: `f` at 1:1: `Return` value 0 has `bool`, expected `i64`")

pub func test_never_signatures_have_no_success_value_or_return_path():
    let ops = OperandBuilder()
    let malformed = create_empty_mir_program()
    malformed.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = [i64_t()], is_fallible = false, returns_never = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(malformed) == "MIR verifier: function `f` returns `never` but has a successful value result")

    let returning = create_empty_mir_program()
    returning.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ret(ops, list[i64]())],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(returning) == "MIR verifier: `f` at 1:1: `Return` in a function whose successful result is `never`")

    let diverging = create_empty_mir_program()
    diverging.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Unreachable)],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    accepted(diverging)

    let fallible = create_empty_mir_program()
    fallible.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true, returns_never = true),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Raise(failure = r(0)))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    accepted(fallible)

pub func test_raise_needs_a_fallible_function():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(0)))]
    assert(failure(program_with(ops, none_types(), [ptr_t()], body)) == "MIR verifier: `f` at 1:1: `Raise` in a function that cannot fail")
    let program = create_empty_mir_program()
    program.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = [ptr_t()], is_fallible = true, returns_never = false),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(program) == "MIR verifier: function `f` is fallible but parameter 0 is not the caller-owned `ptr` error slot")

    let bad_result = create_empty_mir_program()
    bad_result.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [i64_t()], is_fallible = true, returns_never = false),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(bad_result) == "MIR verifier: function `f` is fallible but its last result is not the `ptr` error pointer")

    let wrong_slot = create_empty_mir_program()
    wrong_slot.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true, returns_never = false),
        registers = [ptr_t(), ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(1)))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(wrong_slot) == "MIR verifier: `f` at 1:1: `Raise` must return the caller-owned error slot in r0")

    let nonnull_return = create_empty_mir_program()
    nonnull_return.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true, returns_never = false),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Return(values = ops.run([r(0)])))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(nonnull_return) == "MIR verifier: `f` at 1:1: `Return` from a fallible function must report success with a null error pointer; use `Raise r0` for failure")

pub func test_calls_match_their_target():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 0), arguments = no_registers())),
        ret(ops, [0]),
    ]
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [i64_t()], body))
    assert(failure(program) == "MIR verifier: `f` at 1:1: call passes 0 argument(s) to a signature with 1")
    let missing: list[MirInstruction] = [ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 7), arguments = no_registers())), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], missing)) == "MIR verifier: `f` at 1:1: `Call` names function 7, which does not exist")

pub func test_indirect_calls_retain_their_convention_and_external_identity():
    let ops = OperandBuilder()
    let signature = MirSignature(parameters = none_types(), results = [i64_t()], is_fallible = false, returns_never = false)
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "answer", convention = CallingConvention.c, signature = signature))
    program.functions.append(function(ops, "f", none_types(), [i64_t()], [ptr_t(), i64_t()], [
        ins(InstructionForm.ExternAddress(result = r(0), external = ExternId(value = 0))),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([1])), signature = signature, convention = CallingConvention.c, target = r(0), arguments = no_registers())),
        ret(ops, [1]),
    ]))
    accepted(program)

    let missing = program_with(ops, none_types(), [ptr_t()], [
        ins(InstructionForm.ExternAddress(result = r(0), external = ExternId(value = 7))),
        ret(ops, list[i64]()),
    ])
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `ExternAddress` names extern 7, which does not exist")

    let runtime_indirect = program_with(ops, none_types(), [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = no_registers(), signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = false), convention = CallingConvention.runtime, target = r(0), arguments = no_registers())),
        ret(ops, list[i64]()),
    ])
    assert(failure(runtime_indirect) == "MIR verifier: `f` at 1:1: `CallIndirect` cannot use the runtime calling convention")

    let fallible_c = program_with(ops, none_types(), [ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([1])), signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true, returns_never = false), convention = CallingConvention.c, target = r(0), arguments = ops.run(regs([0])))),
        ret(ops, list[i64]()),
    ])
    assert(failure(fallible_c) == "MIR verifier: `f` at 1:1: a C-convention `CallIndirect` cannot be fallible")

    let aggregate_ops = OperandBuilder()
    let aggregate_c = create_empty_mir_program()
    let aggregate = intern_mir_type(aggregate_c.types, MirType.Enum(tag = i8_t(), cases = [i64_t()]))
    aggregate_c.functions.append(function(aggregate_ops, "f", none_types(), none_types(), [ptr_t(), aggregate], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = no_registers(), signature = MirSignature(parameters = [aggregate], results = none_types(), is_fallible = false, returns_never = false), convention = CallingConvention.c, target = r(0), arguments = aggregate_ops.run(regs([1])))),
        ret(aggregate_ops, list[i64]()),
    ]))
    assert(failure(aggregate_c) == "MIR verifier: `f` at 1:1: C-convention `CallIndirect` passes `enum(i8 | i64)` across the C boundary")

# mark: Program-level rules ==================================================================

pub func test_runtime_externs_are_known_services_with_known_signatures():
    let ops = OperandBuilder()
    let unknown = create_empty_mir_program()
    unknown.externs.append(MirExtern(name = "luce_rt_teleport", convention = CallingConvention.runtime, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = false)))
    assert(failure(unknown) == "MIR verifier: extern `luce_rt_teleport` is not a runtime service")
    let wrong = create_empty_mir_program()
    wrong.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = none_types(), is_fallible = false, returns_never = false)))
    assert(failure(wrong) == "MIR verifier: runtime extern `luce_rt_write` has signature (ptr) -> (), expected (ptr, u64) -> ()")
    let wrong_trap = create_empty_mir_program()
    wrong_trap.externs.append(MirExtern(name = "luce_rt_trap", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = none_types(), is_fallible = false, returns_never = false)))
    assert(failure(wrong_trap) == "MIR verifier: runtime extern `luce_rt_trap` has signature (ptr) -> (), expected (ptr, u64) -> () never")
    let wrong_arena = create_empty_mir_program()
    wrong_arena.externs.append(MirExtern(name = "luce_rt_arena", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = false, returns_never = false)))
    assert(failure(wrong_arena) == "MIR verifier: runtime extern `luce_rt_arena` has signature (ptr) -> (ptr), expected (u64) -> (ptr)")
    let luce_extern = create_empty_mir_program()
    luce_extern.externs.append(MirExtern(name = "helper", convention = CallingConvention.luce, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false, returns_never = false)))
    assert(failure(luce_extern) == "MIR verifier: extern `helper` uses the `luce` convention; externs are C or runtime symbols")

pub func test_the_c_boundary_admits_only_c_representable_shapes():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let option = intern_mir_type(program.types, MirType.Enum(tag = i8_t(), cases = [i64_t()]))
    program.functions.append(c_function(ops, "exported", [option], none_types(), false, [option], [ret(ops, list[i64]())]))
    assert(failure(program) == "MIR verifier: function `exported` passes `enum(i8 | i64)` across the C boundary")
    let fallible = create_empty_mir_program()
    fallible.functions.append(c_function(ops, "exported", [ptr_t()], [i64_t(), ptr_t()], true, [ptr_t()], [ins(InstructionForm.Trap(reason = "never"))]))
    assert(failure(fallible) == "MIR verifier: function `exported` uses the `c` convention and cannot be fallible")
    let half = create_empty_mir_program()
    half.functions.append(c_function(ops, "exported", [builtin_mir_type(BuiltinMirType.float16)], none_types(), false, [builtin_mir_type(BuiltinMirType.float16)], [ret(ops, list[i64]())]))
    assert(failure(half) == "MIR verifier: function `exported` passes `f16` across the C boundary")

pub func test_entry_and_function_names_are_program_wide_facts():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(function(ops, "main", none_types(), [i64_t()], [i64_t()], [const_int(0, 0), ret(ops, [0])]))
    program.entry = FunctionId(value = 0)
    assert(failure(program) == "MIR verifier: entry `main` must be `() -> i32`, found () -> (i64)")
    let duplicate = create_empty_mir_program()
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    assert(failure(duplicate) == "MIR verifier: duplicate function `twice`")
    var good = create_empty_mir_program()
    good.functions.append(function(ops, "main", none_types(), [i32_t()], [i32_t()], [const_int(0, 0), ret(ops, [0])]))
    good.entry = FunctionId(value = 0)
    accepted(good)
