#==============================================================================================
#
#   mir_verifier_test - One test per rule a backend may assume
#
#   DESCRIPTION:
#       Each test builds the smallest program that breaks exactly one rule
#       from docs/compiler/mir.md and pins the diagnostic. The MIR interpreter
#       tests cover the accepting side: every program there is verified first.
#
#==============================================================================================

from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from luce.compiler.mir.canonical import ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData, OperandBuilder, no_registers
from luce.compiler.mir.canonical import MirExtern, MirExternalGlobal, MirField, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.mir.canonical import MirRuntimeBinding, MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.runtime_contract import RuntimeService
from luce.compiler.mir.canonical import TypeId, UnaryOp, builtin_mir_type
from luce.compiler.mir.canonical import create_empty_mir_program, describe_mir_type, find_runtime_symbol, intern_mir_type
from luce.compiler.mir.canonical import make_struct_type
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = u32(index))

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)
pub func byte_owner_t() -> TypeId: return builtin_mir_type(BuiltinMirType.byte_owner)

pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Int(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func ret(ops: OperandBuilder, values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = ops.run(regs(values))))

# Helpers take parameter and result lists rather than a `MirSignature`, because
# Stage-0 frees the lists of a struct returned by one call and passed straight
# into another.
pub func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func c_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], is_fallible: bool, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.c,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = is_fallible),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = false,
        is_exported = false,
        span = at(),
    )

# A one-function program `f` with the given registers and body.
pub func program_with(ops: OperandBuilder, results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirProgram:
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", list[TypeId](), results, registers, body))
    return program

# Statement-form `catch reason: return reason` does not return under Stage-0
# 0.22; assigning through a `var` does.
pub func failure(program: MirProgram) -> str:
    var reported = ""
    MirVerifier(program).verify() catch reason:
        reported = reason
    return reported

pub func accepted(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func no_values() -> list[RegisterId]:
    return list[RegisterId]()

pub func none_types() -> list[TypeId]:
    return list[TypeId]()

# Private stubs give hand-built list instructions their exact semantic
# service contract. The MIR oracle never executes these policy bodies.
pub func bind_list_services(program: MirProgram):
    let action_ops = OperandBuilder()
    program.functions.append(private_function(action_ops, "element.action", [ptr_t()], none_types(), [ptr_t()], [ret(action_ops, list[i64]())]))
    let create_ops = OperandBuilder()
    program.functions.append(private_function(create_ops, "runtime.list_create", none_types(), [ptr_t()], [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ret(create_ops, [0]),
    ]))
    let length_ops = OperandBuilder()
    program.functions.append(private_function(length_ops, "runtime.list_length", [ptr_t()], [u64_t()], [ptr_t(), u64_t()], [
        const_int(1, 0),
        ret(length_ops, [1]),
    ]))
    let append_ops = OperandBuilder()
    program.functions.append(private_function(append_ops, "runtime.list_append_slot", [ptr_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(4), value = MirConstant.Null)),
        ret(append_ops, [4]),
    ]))
    let insert_ops = OperandBuilder()
    program.functions.append(private_function(insert_ops, "runtime.list_insert_slot", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(5), value = MirConstant.Null)),
        ret(insert_ops, [5]),
    ]))
    let remove_ops = OperandBuilder()
    program.functions.append(private_function(remove_ops, "runtime.list_remove_at", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ret(remove_ops, list[i64]())]))
    let clear_ops = OperandBuilder()
    program.functions.append(private_function(clear_ops, "runtime.list_clear", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(clear_ops, list[i64]())]))
    let reserve_ops = OperandBuilder()
    program.functions.append(private_function(reserve_ops, "runtime.list_reserve", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ret(reserve_ops, list[i64]())]))
    let address_ops = OperandBuilder()
    program.functions.append(private_function(address_ops, "runtime.list_element_address", [ptr_t(), u64_t(), u64_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(3), value = MirConstant.Null)),
        ret(address_ops, [3]),
    ]))
    let copy_ops = OperandBuilder()
    program.functions.append(private_function(copy_ops, "runtime.list_copy", [ptr_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(copy_ops, [4]),
    ]))
    let mutable_ops = OperandBuilder()
    program.functions.append(private_function(mutable_ops, "runtime.list_mutable_element_address", [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()], [ptr_t()], [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(5), source = r(0))),
        ret(mutable_ops, [5]),
    ]))
    let slice_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_ops,
        "runtime.list_slice",
        [ptr_t(), u64_t(), u64_t(), u64_t()],
        [ptr_t()],
        [ptr_t(), u64_t(), u64_t(), u64_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(4), source = r(0))),
            ret(slice_ops, [4]),
        ],
    ))
    let slice_length_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_length_ops,
        "runtime.slice_length",
        [ptr_t()],
        [u64_t()],
        [ptr_t(), u64_t()],
        [
            const_int(1, 0),
            ret(slice_length_ops, [1]),
        ],
    ))
    let slice_address_ops = OperandBuilder()
    program.functions.append(private_function(
        slice_address_ops,
        "runtime.slice_element_address",
        [ptr_t(), u64_t(), u64_t()],
        [ptr_t()],
        [ptr_t(), u64_t(), u64_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(3), source = r(0))),
            ret(slice_address_ops, [3]),
        ],
    ))
    let concat_ops = OperandBuilder()
    program.functions.append(private_function(
        concat_ops,
        "runtime.list_concat",
        [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t()],
        [ptr_t()],
        [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t(), ptr_t()],
        [
            ins(InstructionForm.Copy(result = r(5), source = r(0))),
            ret(concat_ops, [5]),
        ],
    ))
    let iteration_begin_ops = OperandBuilder()
    program.functions.append(private_function(iteration_begin_ops, "runtime.list_iteration_begin", [ptr_t()], [u64_t()], [ptr_t(), u64_t()], [
        const_int(1, 0),
        ret(iteration_begin_ops, [1]),
    ]))
    let iteration_end_ops = OperandBuilder()
    program.functions.append(private_function(iteration_end_ops, "runtime.list_iteration_end", [ptr_t()], none_types(), [ptr_t()], [ret(iteration_end_ops, list[i64]())]))
    let iteration_active_ops = OperandBuilder()
    program.functions.append(private_function(iteration_active_ops, "runtime.list_iteration_active", [ptr_t()], [bool_t()], [ptr_t(), bool_t()], [
        const_bool(1, false),
        ret(iteration_active_ops, [1]),
    ]))
    let list_retain_ops = OperandBuilder()
    program.functions.append(private_function(list_retain_ops, "runtime.list_retain", [ptr_t()], none_types(), [ptr_t()], [ret(list_retain_ops, list[i64]())]))
    let list_release_ops = OperandBuilder()
    program.functions.append(private_function(list_release_ops, "runtime.list_release", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(list_release_ops, list[i64]())]))
    let slice_retain_ops = OperandBuilder()
    program.functions.append(private_function(slice_retain_ops, "runtime.slice_retain", [ptr_t()], none_types(), [ptr_t()], [ret(slice_retain_ops, list[i64]())]))
    let slice_release_ops = OperandBuilder()
    program.functions.append(private_function(slice_release_ops, "runtime.slice_release", [ptr_t(), u64_t(), u64_t(), ptr_t()], none_types(), [ptr_t(), u64_t(), u64_t(), ptr_t()], [ret(slice_release_ops, list[i64]())]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_create, function = FunctionId(value = 1)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_length, function = FunctionId(value = 2)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_append_slot, function = FunctionId(value = 3)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_insert_slot, function = FunctionId(value = 4)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_remove_at, function = FunctionId(value = 5)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_clear, function = FunctionId(value = 6)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_reserve, function = FunctionId(value = 7)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_element_address, function = FunctionId(value = 8)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_copy, function = FunctionId(value = 9)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_mutable_element_address, function = FunctionId(value = 10)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_slice, function = FunctionId(value = 11)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_length, function = FunctionId(value = 12)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_element_address, function = FunctionId(value = 13)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_concat, function = FunctionId(value = 14)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_begin, function = FunctionId(value = 15)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_end, function = FunctionId(value = 16)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_active, function = FunctionId(value = 17)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_retain, function = FunctionId(value = 18)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_release, function = FunctionId(value = 19)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_retain, function = FunctionId(value = 20)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_release, function = FunctionId(value = 21)))

pub func bind_bytes_services(program: MirProgram):
    let retain_ops = OperandBuilder()
    program.functions.append(private_function(retain_ops, "runtime.bytes_retain", [ptr_t()], none_types(), [ptr_t()], [ret(retain_ops, list[i64]())]))
    let release_ops = OperandBuilder()
    program.functions.append(private_function(release_ops, "runtime.bytes_release", [ptr_t()], none_types(), [ptr_t()], [ret(release_ops, list[i64]())]))
    let concat_ops = OperandBuilder()
    program.functions.append(private_function(concat_ops, "runtime.bytes_concat", [ptr_t(), u64_t(), ptr_t(), u64_t()], [ptr_t()], [ptr_t(), u64_t(), ptr_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(concat_ops, [4]),
    ]))
    let data_ops = OperandBuilder()
    program.functions.append(private_function(data_ops, "runtime.bytes_data", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(data_ops, [1]),
    ]))
    let slice_ops = OperandBuilder()
    program.functions.append(private_function(slice_ops, "runtime.bytes_slice", [ptr_t(), ptr_t(), u64_t(), u64_t()], [ptr_t()], [ptr_t(), ptr_t(), u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(4), source = r(0))),
        ret(slice_ops, [4]),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_retain, function = FunctionId(value = 0)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_release, function = FunctionId(value = 1)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_concat, function = FunctionId(value = 2)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_data, function = FunctionId(value = 3)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.bytes_slice, function = FunctionId(value = 4)))

# mark: Registers ============================================================================

pub func test_registers_are_used_only_after_definition():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_registers_are_defined_once():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(0, 1), const_int(0, 2), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r0 twice")

pub func test_undeclared_registers_are_rejected():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [const_int(3, 1), ret(ops, [3])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r3, which is not declared")

pub func test_definitions_inside_a_region_stay_inside_it():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        const_int(0, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_parameters_occupy_the_leading_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [bool_t()], [ret(ops, [0])]))
    assert(failure(program) == "MIR verifier: `f` register r0 must have its parameter's type")
    let short = create_empty_mir_program()
    short.functions.append(function(ops, "f", [i64_t()], [i64_t()], none_types(), [ret(ops, [0])]))
    assert(failure(short) == "MIR verifier: `f` declares fewer registers than parameters")

# mark: Operand types ========================================================================

pub func test_constants_must_fit_their_register():
    let ops = OperandBuilder()
    let outside: list[MirInstruction] = [const_int(0, 128), ret(ops, [0])]
    assert(failure(program_with(ops, [i8_t()], [i8_t()], outside)) == "MIR verifier: `f` at 1:1: constant 128 is outside `i8`")
    let wrong_kind: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_kind)) == "MIR verifier: `f` at 1:1: bool constant into `i64` register")
    let null_into_int: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], null_into_int)) == "MIR verifier: `f` at 1:1: null into `i64` register")

pub func test_binary_operands_must_share_a_type_the_operation_accepts():
    let ops = OperandBuilder()
    let mixed: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.add, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i32_t(), i64_t(), i64_t()], mixed)) == "MIR verifier: `f` at 1:1: `add` operands has `i32`, expected `i64`")
    let int_div: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.div, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], int_div)) == "MIR verifier: `f` at 1:1: `div` needs float operands; integers use `floor_div`")
    let bool_result: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.lt, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t(), i64_t()], bool_result)) == "MIR verifier: `f` at 1:1: `lt` result has `i64`, expected `bool`")
    let bool_shift: list[MirInstruction] = [const_bool(0, true), const_bool(1, true), binary(2, BinaryOp.shift_left, 0, 1), ret(ops, [2])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t(), bool_t()], bool_shift)) == "MIR verifier: `f` at 1:1: `shift_left` needs integer operands, found `bool`")

pub func test_reference_handles_support_identity_but_not_value_ordering():
    let equal_ops = OperandBuilder()
    let unequal_ops = OperandBuilder()
    let identity = create_empty_mir_program()
    let list_i64 = intern_mir_type(identity.types, MirType.List(element = i64_t()))
    identity.functions.append(function(equal_ops, "same", [list_i64, list_i64], [bool_t()], [list_i64, list_i64, bool_t()], [
        binary(2, BinaryOp.eq, 0, 1),
        ret(equal_ops, [2]),
    ]))
    identity.functions.append(function(unequal_ops, "different", [list_i64, list_i64], [bool_t()], [list_i64, list_i64, bool_t()], [
        binary(2, BinaryOp.ne, 0, 1),
        ret(unequal_ops, [2]),
    ]))
    accepted(identity)

    let view_ops = OperandBuilder()
    let views = create_empty_mir_program()
    let slice_i64 = intern_mir_type(views.types, MirType.Slice(element = i64_t()))
    views.functions.append(function(view_ops, "same_view", [slice_i64, slice_i64], [bool_t()], [slice_i64, slice_i64, bool_t()], [
        binary(2, BinaryOp.eq, 0, 1),
        ret(view_ops, [2]),
    ]))
    assert(failure(views) == "MIR verifier: `same_view` at 1:1: `eq` cannot compare `slice[i64]`")

    let ordered_ops = OperandBuilder()
    let ordered = create_empty_mir_program()
    let ordered_list = intern_mir_type(ordered.types, MirType.List(element = i64_t()))
    ordered.functions.append(function(ordered_ops, "ordered", [ordered_list, ordered_list], [bool_t()], [ordered_list, ordered_list, bool_t()], [
        binary(2, BinaryOp.lt, 0, 1),
        ret(ordered_ops, [2]),
    ]))
    assert(failure(ordered) == "MIR verifier: `ordered` at 1:1: `lt` needs numeric operands, found `list[i64]`")

pub func test_unary_and_convert_check_their_directions():
    let ops = OperandBuilder()
    let neg_bool: list[MirInstruction] = [const_bool(0, true), ins(InstructionForm.Unary(result = r(1), operation = UnaryOp.neg, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [bool_t()], [bool_t(), bool_t()], neg_bool)) == "MIR verifier: `f` at 1:1: `neg` needs a signed integer or float, found `bool`")
    let narrow_extend: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.extend, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i8_t()], [i64_t(), i8_t()], narrow_extend)) == "MIR verifier: `f` at 1:1: `extend` must widen an integer, found `i64` to `i8`")
    let widen_wrap: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.wrap, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i8_t(), i64_t()], widen_wrap)) == "MIR verifier: `f` at 1:1: `wrap` must narrow an integer, found `i8` to `i64`")
    let bad_float: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.float_to_int, operand = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], bad_float)) == "MIR verifier: `f` at 1:1: `float_to_int` needs a float operand and an integer result")

# mark: Memory ===============================================================================

pub func test_aggregates_never_travel_through_registers():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let pair = intern_mir_type(program.types, make_struct_type([i32_t(), i32_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Load(result = r(1), value_type = pair, address = r(0))),
        ret(ops, list[i64]()),
    ]
    let function_value = MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false),
        registers = [ptr_t(), pair],
        slots = [MirSlot(value_type = pair)],
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )
    program.functions.append(function_value)
    assert(failure(program) == "MIR verifier: `f` at 1:1: `Load` of a struct; aggregates move with `Memcpy`")

pub func test_addresses_must_be_pointers_and_slots_must_exist():
    let ops = OperandBuilder()
    let not_pointer: list[MirInstruction] = [const_int(0, 4), ins(InstructionForm.Load(result = r(1), value_type = i64_t(), address = r(0))), ret(ops, [1])]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], not_pointer)) == "MIR verifier: `f` at 1:1: `Load` address must be `ptr`, found `i64`")
    let missing_slot: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_slot)) == "MIR verifier: `f` at 1:1: `Alloca` names slot 0, which does not exist")
    let missing_field: list[MirInstruction] = [ins(InstructionForm.FieldAddress(result = r(0), struct_type = i64_t(), base = r(0), field = 0)), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), [ptr_t()], missing_field)) == "MIR verifier: `f` at 1:1: `FieldAddress` needs a struct type, found `i64`")

pub func test_typed_element_moves_require_pointers_and_an_unsigned_count():
    let wrong_count_ops = OperandBuilder()
    let wrong_count = create_empty_mir_program()
    wrong_count.functions.append(function(wrong_count_ops, "f", [ptr_t(), ptr_t(), i64_t()], none_types(), [ptr_t(), ptr_t(), i64_t()], [
        ins(InstructionForm.MoveElements(destination = r(0), source = r(1), element_type = i64_t(), count = r(2))),
        ret(wrong_count_ops, list[i64]()),
    ]))
    assert(failure(wrong_count) == "MIR verifier: `f` at 1:1: `MoveElements` count has `i64`, expected `u64`")

    let wrong_destination_ops = OperandBuilder()
    let wrong_destination = create_empty_mir_program()
    wrong_destination.functions.append(function(wrong_destination_ops, "f", [i64_t(), ptr_t(), u64_t()], none_types(), [i64_t(), ptr_t(), u64_t()], [
        ins(InstructionForm.MoveElements(destination = r(0), source = r(1), element_type = i64_t(), count = r(2))),
        ret(wrong_destination_ops, list[i64]()),
    ]))
    assert(failure(wrong_destination) == "MIR verifier: `f` at 1:1: `MoveElements` destination must be `ptr`, found `i64`")

pub func test_storage_allocation_requires_one_typed_private_runtime_binding():
    let missing_ops = OperandBuilder()
    let missing = program_with(missing_ops, [ptr_t()], [u64_t(), ptr_t()], [
        const_int(0, 1),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i64_t(), count = r(0))),
        ret(missing_ops, [1]),
    ])
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `AllocateStorage` requires the `storage_allocator` runtime binding")

    let allocator_ops = OperandBuilder()
    let client_ops = OperandBuilder()
    let accepted_program = create_empty_mir_program()
    accepted_program.functions.append(private_function(
        allocator_ops,
        "runtime.allocate",
        [u64_t(), u64_t()],
        [ptr_t()],
        [u64_t(), u64_t(), ptr_t()],
        [ins(InstructionForm.Const(result = r(2), value = MirConstant.Null)), ret(allocator_ops, [2])],
    ))
    accepted_program.functions.append(function(client_ops, "f", none_types(), [ptr_t()], [u64_t(), ptr_t()], [
        const_int(0, 1),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i64_t(), count = r(0))),
        ret(client_ops, [1]),
    ]))
    accepted_program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    accepted(accepted_program)

    accepted_program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    assert(failure(accepted_program) == "MIR verifier: duplicate runtime binding for `storage_allocator`")

    let wrong_count_ops = OperandBuilder()
    let wrong_count = create_empty_mir_program()
    wrong_count.functions.append(private_function(allocator_ops, "runtime.allocate", [u64_t(), u64_t()], [ptr_t()], [u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Null)), ret(allocator_ops, [2]),
    ]))
    wrong_count.functions.append(function(wrong_count_ops, "f", none_types(), [ptr_t()], [i64_t(), ptr_t()], [
        const_int(0, 1),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i64_t(), count = r(0))),
        ret(wrong_count_ops, [1]),
    ]))
    wrong_count.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    assert(failure(wrong_count) == "MIR verifier: `f` at 1:1: `AllocateStorage` count has `i64`, expected `u64`")

    let signature_ops = OperandBuilder()
    let wrong_signature = create_empty_mir_program()
    wrong_signature.functions.append(private_function(signature_ops, "runtime.allocate", none_types(), none_types(), none_types(), [ret(signature_ops, list[i64]())]))
    wrong_signature.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    assert(failure(wrong_signature) == "MIR verifier: runtime binding `storage_allocator` has signature () -> (), expected (u64, u64) -> (ptr)")

    let exposed_ops = OperandBuilder()
    let exposed = create_empty_mir_program()
    exposed.functions.append(function(exposed_ops, "runtime.allocate", [u64_t(), u64_t()], [ptr_t()], [u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Null)), ret(exposed_ops, [2]),
    ]))
    exposed.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    assert(failure(exposed) == "MIR verifier: runtime binding `storage_allocator` must name a private Luce function")

    let deallocator_ops = OperandBuilder()
    let release_ops = OperandBuilder()
    let released = create_empty_mir_program()
    released.functions.append(private_function(deallocator_ops, "runtime.deallocate", [ptr_t(), u64_t(), u64_t()], none_types(), [ptr_t(), u64_t(), u64_t()], [
        ret(deallocator_ops, list[i64]()),
    ]))
    released.functions.append(function(release_ops, "release", [ptr_t(), u64_t()], none_types(), [ptr_t(), u64_t()], [
        ins(InstructionForm.DeallocateStorage(address = r(0), element_type = i64_t(), count = r(1))),
        ret(release_ops, list[i64]()),
    ]))
    assert(failure(released) == "MIR verifier: `release` at 1:1: `DeallocateStorage` requires the `storage_deallocator` runtime binding")
    released.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_deallocator, function = FunctionId(value = 0)))
    accepted(released)

    let wrong_release_ops = OperandBuilder()
    let wrong_release = create_empty_mir_program()
    wrong_release.functions.append(private_function(deallocator_ops, "runtime.deallocate", [ptr_t(), u64_t(), u64_t()], none_types(), [ptr_t(), u64_t(), u64_t()], [
        ret(deallocator_ops, list[i64]()),
    ]))
    wrong_release.functions.append(function(wrong_release_ops, "release", [i64_t(), i64_t()], none_types(), [i64_t(), i64_t()], [
        ins(InstructionForm.DeallocateStorage(address = r(0), element_type = i64_t(), count = r(1))),
        ret(wrong_release_ops, list[i64]()),
    ]))
    wrong_release.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_deallocator, function = FunctionId(value = 0)))
    assert(failure(wrong_release) == "MIR verifier: `release` at 1:1: `DeallocateStorage` address has `i64`, expected `ptr`")

pub func test_owned_byte_operations_keep_owner_data_and_slice_types_distinct():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let byte_slice = intern_mir_type(program.types, MirType.Slice(element = builtin_mir_type(BuiltinMirType.unsigned_u8)))
    bind_bytes_services(program)
    program.functions.append(function(ops, "f", none_types(), none_types(), [ptr_t(), u64_t(), ptr_t(), u64_t(), byte_owner_t(), ptr_t(), byte_slice], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        const_int(1, 1),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Null)),
        const_int(3, 2),
        ins(InstructionForm.BytesConcat(result = r(4), left_data = r(0), left_length = r(1), right_data = r(2), right_length = r(3))),
        ins(InstructionForm.BytesRetain(value = r(4))),
        ins(InstructionForm.BytesData(result = r(5), owner = r(4))),
        ins(InstructionForm.BytesSlice(result = r(6), owner = r(4), data = r(5), length = r(3), start = r(1), end = r(3))),
        ins(InstructionForm.BytesRelease(value = r(4))),
        ret(ops, list[i64]()),
    ]))
    accepted(program)

    let missing_ops = OperandBuilder()
    let missing = create_empty_mir_program()
    missing.functions.append(function(missing_ops, "f", [byte_owner_t()], none_types(), [byte_owner_t()], [
        ins(InstructionForm.BytesRelease(value = r(0))),
        ret(missing_ops, list[i64]()),
    ]))
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `BytesRelease` requires the `bytes_release` runtime binding")

    let forged_ops = OperandBuilder()
    let forged = create_empty_mir_program()
    bind_bytes_services(forged)
    forged.functions.append(function(forged_ops, "f", [ptr_t()], none_types(), [ptr_t()], [
        ins(InstructionForm.BytesRetain(value = r(0))),
        ret(forged_ops, list[i64]()),
    ]))
    assert(failure(forged) == "MIR verifier: `f` at 1:1: `BytesRetain` value must be `byte-owner`, found `ptr`")

    let wrong_result_ops = OperandBuilder()
    let wrong_result = create_empty_mir_program()
    bind_bytes_services(wrong_result)
    wrong_result.functions.append(function(wrong_result_ops, "f", [ptr_t(), u64_t()], none_types(), [ptr_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.BytesConcat(result = r(2), left_data = r(0), left_length = r(1), right_data = r(0), right_length = r(1))),
        ret(wrong_result_ops, list[i64]()),
    ]))
    assert(failure(wrong_result) == "MIR verifier: `f` at 1:1: `BytesConcat` result must be `byte-owner`, found `ptr`")

    let wrong_data_ops = OperandBuilder()
    let wrong_data = create_empty_mir_program()
    bind_bytes_services(wrong_data)
    wrong_data.functions.append(function(wrong_data_ops, "f", [byte_owner_t(), u64_t()], none_types(), [byte_owner_t(), u64_t(), byte_owner_t()], [
        ins(InstructionForm.BytesSlice(result = r(2), owner = r(0), data = r(0), length = r(1), start = r(1), end = r(1))),
        ret(wrong_data_ops, list[i64]()),
    ]))
    assert(failure(wrong_data) == "MIR verifier: `f` at 1:1: `BytesSlice` data must be `ptr`, found `byte-owner`")

pub func test_list_operations_retain_and_require_one_canonical_element_type():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let list_i64 = intern_mir_type(program.types, MirType.List(element = i64_t()))
    let slice_i64 = intern_mir_type(program.types, MirType.Slice(element = i64_t()))
    bind_list_services(program)
    program.functions.append(function(ops, "f", none_types(), [u64_t()], [list_i64, u64_t(), ptr_t(), u64_t(), ptr_t(), u64_t(), ptr_t(), u64_t(), list_i64, ptr_t(), slice_i64, u64_t(), ptr_t(), list_i64, u64_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListRetain(value = r(0))),
        ins(InstructionForm.ListRelease(value = r(0), element_release = FunctionId(value = 0))),
        ins(InstructionForm.ListCopy(result = r(8), value = r(0), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListConcat(result = r(13), left = r(0), right = r(8), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListLength(result = r(1), value = r(0))),
        ins(InstructionForm.ListIterationBegin(result = r(14), value = r(0))),
        ins(InstructionForm.ListIterationEnd(value = r(0))),
        ins(InstructionForm.ListAppendSlot(result = r(2), value = r(0), element_retain = FunctionId(value = 0))),
        const_int(3, 0),
        ins(InstructionForm.ListElementAddress(result = r(4), value = r(0), index = r(3))),
        ins(InstructionForm.ListMutableElementAddress(result = r(9), value = r(0), index = r(3), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListSlice(result = r(10), value = r(0), start = r(3), end = r(1))),
        ins(InstructionForm.SliceRetain(value = r(10))),
        ins(InstructionForm.SliceRelease(value = r(10), element_release = FunctionId(value = 0))),
        ins(InstructionForm.SliceLength(result = r(11), value = r(10))),
        ins(InstructionForm.SliceElementAddress(result = r(12), value = r(10), index = r(3))),
        const_int(5, 1),
        ins(InstructionForm.ListInsertSlot(result = r(6), value = r(0), index = r(5), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListRemoveAt(value = r(0), index = r(3), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListReserve(value = r(0), minimum_capacity = r(5), element_retain = FunctionId(value = 0))),
        ins(InstructionForm.ListClear(value = r(0), element_release = FunctionId(value = 0))),
        ret(ops, [1]),
    ]))
    accepted(program)

    let wrong_index_ops = OperandBuilder()
    let wrong_index = create_empty_mir_program()
    let wrong_list_type = intern_mir_type(wrong_index.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_index)
    wrong_index.functions.append(function(wrong_index_ops, "f", none_types(), none_types(), [wrong_list_type, i64_t(), ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        ins(InstructionForm.ListInsertSlot(result = r(2), value = r(0), index = r(1), element_retain = FunctionId(value = 0))),
        ret(wrong_index_ops, list[i64]()),
    ]))
    assert(failure(wrong_index) == "MIR verifier: `f` at 1:1: `ListInsertSlot` index has `i64`, expected `u64`")

    let forged_ops = OperandBuilder()
    let forged = create_empty_mir_program()
    discard(intern_mir_type(forged.types, MirType.List(element = i64_t())))
    bind_list_services(forged)
    forged.functions.append(function(forged_ops, "f", none_types(), none_types(), [ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ret(forged_ops, list[i64]()),
    ]))
    assert(failure(forged) == "MIR verifier: `f` at 1:1: `ListCreate` result must be a typed list handle, found `ptr`")

    let wrong_value_ops = OperandBuilder()
    let wrong_value = create_empty_mir_program()
    bind_list_services(wrong_value)
    wrong_value.functions.append(function(wrong_value_ops, "f", none_types(), [u64_t()], [ptr_t(), u64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.ListLength(result = r(1), value = r(0))),
        ret(wrong_value_ops, [1]),
    ]))
    assert(failure(wrong_value) == "MIR verifier: `f` at 1:1: `ListLength` value must be a typed list handle, found `ptr`")

    let wrong_iteration_ops = OperandBuilder()
    let wrong_iteration = create_empty_mir_program()
    let iterated_list = intern_mir_type(wrong_iteration.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_iteration)
    wrong_iteration.functions.append(function(wrong_iteration_ops, "f", none_types(), none_types(), [iterated_list, i64_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListIterationBegin(result = r(1), value = r(0))),
        ret(wrong_iteration_ops, list[i64]()),
    ]))
    assert(failure(wrong_iteration) == "MIR verifier: `f` at 1:1: `ListIterationBegin` result has `i64`, expected `u64`")

    let missing_active_ops = OperandBuilder()
    let missing_active = create_empty_mir_program()
    let active_list = intern_mir_type(missing_active.types, MirType.List(element = i64_t()))
    bind_list_services(missing_active)
    missing_active.runtime_bindings.remove(16)
    missing_active.functions.append(function(missing_active_ops, "f", none_types(), none_types(), [active_list, ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListAppendSlot(result = r(1), value = r(0), element_retain = FunctionId(value = 0))),
        ret(missing_active_ops, list[i64]()),
    ]))
    assert(failure(missing_active) == "MIR verifier: `f` at 1:1: `ListAppendSlot` requires the `list_iteration_active` and `list_append_slot` runtime bindings")

    let wrong_copy_ops = OperandBuilder()
    let wrong_copy = create_empty_mir_program()
    let source_list = intern_mir_type(wrong_copy.types, MirType.List(element = i64_t()))
    let result_list = intern_mir_type(wrong_copy.types, MirType.List(element = i8_t()))
    bind_list_services(wrong_copy)
    wrong_copy.functions.append(function(wrong_copy_ops, "f", none_types(), none_types(), [source_list, result_list], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCopy(result = r(1), value = r(0), element_retain = FunctionId(value = 0))),
        ret(wrong_copy_ops, list[i64]()),
    ]))
    assert(failure(wrong_copy) == "MIR verifier: `f` at 1:1: `ListCopy` result element has `i8`, expected `i64`")

    let wrong_action_ops = OperandBuilder()
    let wrong_action = create_empty_mir_program()
    let action_list = intern_mir_type(wrong_action.types, MirType.List(element = i64_t()))
    bind_list_services(wrong_action)
    wrong_action.functions.append(function(wrong_action_ops, "f", none_types(), none_types(), [action_list, action_list], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCopy(result = r(1), value = r(0), element_retain = FunctionId(value = 1))),
        ret(wrong_action_ops, list[i64]()),
    ]))
    assert(failure(wrong_action) == "MIR verifier: `f` at 1:1: `ListCopy` element retain has signature () -> (ptr), expected (ptr) -> ()")

    let wrong_concat_ops = OperandBuilder()
    let wrong_concat = create_empty_mir_program()
    let concat_left = intern_mir_type(wrong_concat.types, MirType.List(element = i64_t()))
    let concat_right = intern_mir_type(wrong_concat.types, MirType.List(element = i8_t()))
    bind_list_services(wrong_concat)
    wrong_concat.functions.append(function(wrong_concat_ops, "f", none_types(), none_types(), [concat_left, concat_right, concat_left], [
        ins(InstructionForm.ListCreate(result = r(0))),
        ins(InstructionForm.ListCreate(result = r(1))),
        ins(InstructionForm.ListConcat(result = r(2), left = r(0), right = r(1), element_retain = FunctionId(value = 0))),
        ret(wrong_concat_ops, list[i64]()),
    ]))
    assert(failure(wrong_concat) == "MIR verifier: `f` at 1:1: `ListConcat` right element has `i8`, expected `i64`")

    let wrong_slice_ops = OperandBuilder()
    let wrong_slice = create_empty_mir_program()
    let sliced_list = intern_mir_type(wrong_slice.types, MirType.List(element = i64_t()))
    let wrong_slice_result = intern_mir_type(wrong_slice.types, MirType.Slice(element = i8_t()))
    bind_list_services(wrong_slice)
    wrong_slice.functions.append(function(wrong_slice_ops, "f", none_types(), none_types(), [sliced_list, u64_t(), wrong_slice_result], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        ins(InstructionForm.ListSlice(result = r(2), value = r(0), start = r(1), end = r(1))),
        ret(wrong_slice_ops, list[i64]()),
    ]))
    assert(failure(wrong_slice) == "MIR verifier: `f` at 1:1: `ListSlice` result element has `i8`, expected `i64`")

    let wrong_bound_ops = OperandBuilder()
    let wrong_bound = create_empty_mir_program()
    let bound_list = intern_mir_type(wrong_bound.types, MirType.List(element = i64_t()))
    let bound_slice = intern_mir_type(wrong_bound.types, MirType.Slice(element = i64_t()))
    bind_list_services(wrong_bound)
    wrong_bound.functions.append(function(wrong_bound_ops, "f", none_types(), none_types(), [bound_list, i64_t(), u64_t(), bound_slice], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        const_int(2, 0),
        ins(InstructionForm.ListSlice(result = r(3), value = r(0), start = r(1), end = r(2))),
        ret(wrong_bound_ops, list[i64]()),
    ]))
    assert(failure(wrong_bound) == "MIR verifier: `f` at 1:1: `ListSlice` start has `i64`, expected `u64`")

    let forged_slice_ops = OperandBuilder()
    let forged_slice = create_empty_mir_program()
    let forged_list = intern_mir_type(forged_slice.types, MirType.List(element = i64_t()))
    bind_list_services(forged_slice)
    forged_slice.functions.append(function(forged_slice_ops, "f", none_types(), none_types(), [forged_list, u64_t(), ptr_t()], [
        ins(InstructionForm.ListCreate(result = r(0))),
        const_int(1, 0),
        ins(InstructionForm.SliceElementAddress(result = r(2), value = r(0), index = r(1))),
        ret(forged_slice_ops, list[i64]()),
    ]))
    assert(failure(forged_slice) == "MIR verifier: `f` at 1:1: `SliceElementAddress` value must be a typed slice handle, found `list[i64]`")

    let wrong_service_ops = OperandBuilder()
    let wrong_service = create_empty_mir_program()
    wrong_service.functions.append(private_function(wrong_service_ops, "runtime.list_copy", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(wrong_service_ops, [1]),
    ]))
    wrong_service.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_copy, function = FunctionId(value = 0)))
    assert(failure(wrong_service) == "MIR verifier: runtime binding `list_copy` has signature (ptr) -> (ptr), expected (ptr, u64, u64, ptr) -> (ptr)")

    let wrong_concat_service_ops = OperandBuilder()
    let wrong_concat_service = create_empty_mir_program()
    wrong_concat_service.functions.append(private_function(wrong_concat_service_ops, "runtime.list_concat", [ptr_t()], [ptr_t()], [ptr_t(), ptr_t()], [
        ins(InstructionForm.Copy(result = r(1), source = r(0))),
        ret(wrong_concat_service_ops, [1]),
    ]))
    wrong_concat_service.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_concat, function = FunctionId(value = 0)))
    assert(failure(wrong_concat_service) == "MIR verifier: runtime binding `list_concat` has signature (ptr) -> (ptr), expected (ptr, ptr, u64, u64, ptr) -> (ptr)")

    let recursive = create_empty_mir_program()
    recursive.types.definitions.append(MirType.List(element = TypeId(value = 13)))
    accepted(recursive)

    let missing = create_empty_mir_program()
    missing.types.definitions.append(MirType.List(element = TypeId(value = 14)))
    assert(failure(missing) == "MIR verifier: list type 13 names type 14, which does not exist")

pub func test_aggregate_types_are_structural_and_only_by_value_cycles_fail():
    let program = create_empty_mir_program()
    program.types.definitions.append(MirType.Struct(fields = [MirField(value_type = i32_t()), MirField(value_type = i64_t())]))
    accepted(program)

    let recursive = create_empty_mir_program()
    recursive.types.definitions.append(MirType.Struct(fields = [MirField(value_type = TypeId(value = 13))]))
    assert(failure(recursive) == "MIR verifier: type 13 contains itself by value")

    let through_list = create_empty_mir_program()
    through_list.types.definitions.append(MirType.Struct(fields = [MirField(value_type = TypeId(value = 14))]))
    through_list.types.definitions.append(MirType.List(element = TypeId(value = 13)))
    accepted(through_list)
    assert(describe_mir_type(through_list.types, TypeId(value = 13)) == "{list[type#13]}")

pub func test_data_alignment_and_global_initializers_are_validated():
    let program = create_empty_mir_program()
    program.data.append(MirData(name = "table", bytes = [0], align = 0))
    assert(failure(program) == "MIR verifier: data `table` has alignment 0")
    let uneven = create_empty_mir_program()
    uneven.data.append(MirData(name = "table", bytes = [0], align = 3))
    assert(failure(uneven) == "MIR verifier: data `table` has non-power-of-two alignment 3")
    let global_program = create_empty_mir_program()
    global_program.globals.append(MirGlobal(name = "g", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    assert(failure(global_program) == "MIR verifier: global `g` is initialised from data item 0, which does not exist")

pub func test_external_globals_are_unique_scalar_symbols_with_typed_accesses():
    let ops = OperandBuilder()
    let accepted_program = create_empty_mir_program()
    accepted_program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_t()))
    accepted_program.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 0))),
        ins(InstructionForm.StoreExternalGlobal(global = ExternalGlobalId(value = 0), value = r(0))),
        ret(ops, [0]),
    ]))
    accepted(accepted_program)

    let missing = create_empty_mir_program()
    missing.functions.append(function(ops, "f", none_types(), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 1))),
        ret(ops, [0]),
    ]))
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `LoadExternalGlobal` names external global 1, which does not exist")

    let aggregate = create_empty_mir_program()
    let pair = intern_mir_type(aggregate.types, make_struct_type([i32_t(), i32_t()]))
    aggregate.external_globals.append(MirExternalGlobal(name = "pair", value_type = pair))
    assert(failure(aggregate) == "MIR verifier: external global `pair` has non-scalar type `{i32, i32}`")

    let duplicate = create_empty_mir_program()
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    duplicate.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(duplicate) == "MIR verifier: duplicate external global `state`")

    let kind_conflict = create_empty_mir_program()
    kind_conflict.externs.append(MirExtern(name = "state", convention = CallingConvention.c, signature = MirSignature(parameters = none_types(), results = [i32_t()], is_fallible = false)))
    kind_conflict.external_globals.append(MirExternalGlobal(name = "state", value_type = i32_t()))
    assert(failure(kind_conflict) == "MIR verifier: external symbol `state` is both a function and a global")

# mark: Control flow =========================================================================

pub func test_branch_depths_stay_within_enclosing_regions():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.Br(depth = 1, values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), none_types(), body)) == "MIR verifier: `f` at 1:1: branch depth 1 with 1 enclosing region(s)")

pub func test_a_block_with_results_must_supply_them():
    let ops = OperandBuilder()
    let falls_through: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        const_int(1, 1),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t(), i64_t()], falls_through)) == "MIR verifier: `f` at 1:1: `Block` with results can fall off its end; supply them with `Yield` or `Br`")
    let wrong_count: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([0])))),
        ins(InstructionForm.Yield(values = no_registers())),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], wrong_count)) == "MIR verifier: `f` at 1:1: `Yield` supplies 0 value(s), expected 1")
    let one_arm: list[MirInstruction] = [
        const_bool(0, true),
        ins(InstructionForm.If(condition = r(0), results = ops.run(regs([2])))),
        const_int(1, 1),
        ins(InstructionForm.Yield(values = ops.run(regs([1])))),
        ins(InstructionForm.End),
        ret(ops, [2]),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t(), i64_t()], one_arm)) == "MIR verifier: `f` at 1:1: `If` with results must supply them on both arms with `Yield` or `Br`")

pub func test_loops_take_no_values_on_a_branch():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Br(depth = 0, values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: a branch to a `Loop` restarts it and carries no values")
    let yield_values: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop),
        ins(InstructionForm.Yield(values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [0]),
    ]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], yield_values)) == "MIR verifier: `f` at 1:1: `Yield` inside a `Loop`; a loop has no results, leave it with `Br`")

pub func test_conditions_and_tags_have_their_types():
    let ops = OperandBuilder()
    let int_condition: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], int_condition)) == "MIR verifier: `f` at 1:1: `If` condition must be `bool`, found `i64`")
    let repeated: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.Default),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], repeated)) == "MIR verifier: `f` at 1:1: `Switch` repeats case 1")
    let no_default: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        ins(InstructionForm.End),
        ret(ops, list[i64]()),
    ]
    assert(failure(program_with(ops, none_types(), [i64_t()], no_default)) == "MIR verifier: `f` at 1:1: `Switch` needs a `Default` arm")
    let unclosed: list[MirInstruction] = [ins(InstructionForm.Block(results = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), unclosed)) == "MIR verifier: `f` has 1 region(s) without an `End`")
    let stray_else: list[MirInstruction] = [ins(InstructionForm.Else), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), stray_else)) == "MIR verifier: `f` at 1:1: `Else` outside an `If`, or a second `Else`")
    let yield_at_top: list[MirInstruction] = [ins(InstructionForm.Yield(values = no_registers())), ret(ops, list[i64]())]
    assert(failure(program_with(ops, none_types(), none_types(), yield_at_top)) == "MIR verifier: `f` at 1:1: `Yield` outside any region; use `Return`")

pub func test_functions_end_every_path():
    let ops = OperandBuilder()
    let falls_off: list[MirInstruction] = [const_int(0, 1)]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], falls_off)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")
    # Both arms of an `If` returning is a complete body.
    let both_arms: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.Else),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    accepted(program_with(ops, [i64_t()], [bool_t(), i64_t()], both_arms))
    # Without an else-arm the If can fall through, so the body needs more.
    let one_arm_only: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        ret(ops, [1]),
        ins(InstructionForm.End),
    ]
    assert(failure(program_with(ops, [i64_t()], [bool_t(), i64_t()], one_arm_only)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")

# mark: Returns and failure ==================================================================

pub func test_returns_match_the_signature():
    let ops = OperandBuilder()
    let too_few: list[MirInstruction] = [ret(ops, list[i64]())]
    assert(failure(program_with(ops, [i64_t()], none_types(), too_few)) == "MIR verifier: `f` at 1:1: `Return` supplies 0 value(s), expected 1")
    let wrong_type: list[MirInstruction] = [const_bool(0, true), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [bool_t()], wrong_type)) == "MIR verifier: `f` at 1:1: `Return` value 0 has `bool`, expected `i64`")

pub func test_raise_needs_a_fallible_function():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(0)))]
    assert(failure(program_with(ops, none_types(), [ptr_t()], body)) == "MIR verifier: `f` at 1:1: `Raise` in a function that cannot fail")
    let program = create_empty_mir_program()
    program.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = [ptr_t()], is_fallible = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(program) == "MIR verifier: function `f` is fallible but parameter 0 is not the caller-owned `ptr` error slot")

    let bad_result = create_empty_mir_program()
    bad_result.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [i64_t()], is_fallible = true),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(bad_result) == "MIR verifier: function `f` is fallible but its last result is not the `ptr` error pointer")

    let wrong_slot = create_empty_mir_program()
    wrong_slot.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true),
        registers = [ptr_t(), ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Const(result = r(1), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(1)))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(wrong_slot) == "MIR verifier: `f` at 1:1: `Raise` must return the caller-owned error slot in r0")

    let nonnull_return = create_empty_mir_program()
    nonnull_return.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true),
        registers = [ptr_t()],
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Return(values = ops.run([r(0)])))],
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    ))
    assert(failure(nonnull_return) == "MIR verifier: `f` at 1:1: `Return` from a fallible function must report success with a null error pointer; use `Raise r0` for failure")

pub func test_calls_match_their_target():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 0), arguments = no_registers())),
        ret(ops, [0]),
    ]
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "f", [i64_t()], [i64_t()], [i64_t()], body))
    assert(failure(program) == "MIR verifier: `f` at 1:1: call passes 0 argument(s) to a signature with 1")
    let missing: list[MirInstruction] = [ins(InstructionForm.Call(results = ops.run(regs([0])), function = FunctionId(value = 7), arguments = no_registers())), ret(ops, [0])]
    assert(failure(program_with(ops, [i64_t()], [i64_t()], missing)) == "MIR verifier: `f` at 1:1: `Call` names function 7, which does not exist")

pub func test_indirect_calls_retain_their_convention_and_external_identity():
    let ops = OperandBuilder()
    let signature = MirSignature(parameters = none_types(), results = [i64_t()], is_fallible = false)
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "answer", convention = CallingConvention.c, signature = signature))
    program.functions.append(function(ops, "f", none_types(), [i64_t()], [ptr_t(), i64_t()], [
        ins(InstructionForm.ExternAddress(result = r(0), external = ExternId(value = 0))),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([1])), signature = signature, convention = CallingConvention.c, target = r(0), arguments = no_registers())),
        ret(ops, [1]),
    ]))
    accepted(program)

    let missing = program_with(ops, none_types(), [ptr_t()], [
        ins(InstructionForm.ExternAddress(result = r(0), external = ExternId(value = 7))),
        ret(ops, list[i64]()),
    ])
    assert(failure(missing) == "MIR verifier: `f` at 1:1: `ExternAddress` names extern 7, which does not exist")

    let runtime_indirect = program_with(ops, none_types(), [ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = no_registers(), signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false), convention = CallingConvention.runtime, target = r(0), arguments = no_registers())),
        ret(ops, list[i64]()),
    ])
    assert(failure(runtime_indirect) == "MIR verifier: `f` at 1:1: `CallIndirect` cannot use the runtime calling convention")

    let fallible_c = program_with(ops, none_types(), [ptr_t(), ptr_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([1])), signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = true), convention = CallingConvention.c, target = r(0), arguments = ops.run(regs([0])))),
        ret(ops, list[i64]()),
    ])
    assert(failure(fallible_c) == "MIR verifier: `f` at 1:1: a C-convention `CallIndirect` cannot be fallible")

    let aggregate_ops = OperandBuilder()
    let aggregate_c = create_empty_mir_program()
    let aggregate = intern_mir_type(aggregate_c.types, MirType.Enum(tag = i8_t(), cases = [i64_t()]))
    aggregate_c.functions.append(function(aggregate_ops, "f", none_types(), none_types(), [ptr_t(), aggregate], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)),
        ins(InstructionForm.CallIndirect(results = no_registers(), signature = MirSignature(parameters = [aggregate], results = none_types(), is_fallible = false), convention = CallingConvention.c, target = r(0), arguments = aggregate_ops.run(regs([1])))),
        ret(aggregate_ops, list[i64]()),
    ]))
    assert(failure(aggregate_c) == "MIR verifier: `f` at 1:1: C-convention `CallIndirect` passes `enum(i8 | i64)` across the C boundary")

# mark: Program-level rules ==================================================================

pub func test_runtime_externs_are_known_services_with_known_signatures():
    let ops = OperandBuilder()
    let unknown = create_empty_mir_program()
    unknown.externs.append(MirExtern(name = "luce_rt_teleport", convention = CallingConvention.runtime, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(unknown) == "MIR verifier: extern `luce_rt_teleport` is not a runtime service")
    let wrong = create_empty_mir_program()
    wrong.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = none_types(), is_fallible = false)))
    assert(failure(wrong) == "MIR verifier: runtime extern `luce_rt_write` has signature (ptr) -> (), expected (ptr, u64) -> ()")
    let wrong_arena = create_empty_mir_program()
    wrong_arena.externs.append(MirExtern(name = "luce_rt_arena", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = [ptr_t()], is_fallible = false)))
    assert(failure(wrong_arena) == "MIR verifier: runtime extern `luce_rt_arena` has signature (ptr) -> (ptr), expected (u64) -> (ptr)")
    let luce_extern = create_empty_mir_program()
    luce_extern.externs.append(MirExtern(name = "helper", convention = CallingConvention.luce, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(luce_extern) == "MIR verifier: extern `helper` uses the `luce` convention; externs are C or runtime symbols")

pub func test_the_c_boundary_admits_only_c_representable_shapes():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let option = intern_mir_type(program.types, MirType.Enum(tag = i8_t(), cases = [i64_t()]))
    program.functions.append(c_function(ops, "exported", [option], none_types(), false, [option], [ret(ops, list[i64]())]))
    assert(failure(program) == "MIR verifier: function `exported` passes `enum(i8 | i64)` across the C boundary")
    let fallible = create_empty_mir_program()
    fallible.functions.append(c_function(ops, "exported", [ptr_t()], [i64_t(), ptr_t()], true, [ptr_t()], [ins(InstructionForm.Trap(reason = "never"))]))
    assert(failure(fallible) == "MIR verifier: function `exported` uses the `c` convention and cannot be fallible")

pub func test_entry_and_function_names_are_program_wide_facts():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(function(ops, "main", none_types(), [i64_t()], [i64_t()], [const_int(0, 0), ret(ops, [0])]))
    program.entry = FunctionId(value = 0)
    assert(failure(program) == "MIR verifier: entry `main` must be `() -> i32`, found () -> (i64)")
    let duplicate = create_empty_mir_program()
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    duplicate.functions.append(function(ops, "twice", none_types(), none_types(), none_types(), [ret(ops, list[i64]())]))
    assert(failure(duplicate) == "MIR verifier: duplicate function `twice`")
    var good = create_empty_mir_program()
    good.functions.append(function(ops, "main", none_types(), [i32_t()], [i32_t()], [const_int(0, 0), ret(ops, [0])]))
    good.entry = FunctionId(value = 0)
    accepted(good)
