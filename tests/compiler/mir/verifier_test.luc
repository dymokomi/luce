    wrong_append.functions.append(function(wrong_append_ops, "f", [ptr_t(), ptr_t(), u64_t()], none_types(), [ptr_t(), ptr_t(), u64_t()], [
        ins(InstructionForm.BufferBuilderAppend(builder = r(0), data = r(1), length = r(2))),
        ret(wrong_append_ops, list[i64]()),
