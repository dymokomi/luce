#==============================================================================================
#
#   lowering_support - Shared fixtures for lowering tests
#
#   DESCRIPTION:
#       Checking, lowering, verification, and HIR/MIR agreement helpers used by the
#       lowering tests and by the profile tests that mirror them.
#
#==============================================================================================

from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.backends.mir_interpreter import MirInterpreter
from luce.compiler.backends.mir_execution_model import MirValue
from luce.compiler.backends.layout import LayoutRules
from luce.compiler.mir.canonical import BuiltinMirType, MirFunction, MirProgram, TypeId
from luce.compiler.mir.canonical import builtin_mir_type
from luce.compiler.hir.ir import ModuleAuthority, PackageRole
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.mir.lowerer import Lowerer
from luce.compiler.mir.composer import compose_runtime
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.pipeline import compile_runtime
from luce.compiler.runtime_package import sealed_runtime_package
from luce.compiler.frontend.parser import Parser
from luce.compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.frontend.tokenizer import Tokenizer
import std.strings

pub func interpreter_layout() -> LayoutRules:
    return LayoutRules(pointer_size = 4, pointer_align = 4)

# Run one fixture through tokenizer, parser, and HirGenerator; a broken fixture
# traps loudly.
pub func checked(source: str) -> AnalyzedProgram:
    return checked_modules([source_module("main", source)])

pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax_tree)

pub func native_source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".native.luc", authority = ModuleAuthority.native, syntax = syntax_tree)

pub func checked_modules(modules: list[SourceModule]) -> AnalyzedProgram:
    let hir = HirGenerator("test.luce", modules).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return analyzed

pub func checked_runtime_modules(modules: list[SourceModule]) -> AnalyzedProgram:
    let hir = HirGenerator("org.luce.runtime", modules, PackageRole.sealed_runtime).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return analyzed

# Lower one fixture once and prove the verifier accepts the result.
pub func lowered(source: str) -> MirProgram:
    let program = Lowerer(checked(source)).lower() catch reason:
        trap(reason)
    verify_application(program)
    return program

# Application MIR intentionally precedes sealed-runtime composition. Verify
# its original inspectable shape directly when self-contained, or verify the
# composed product when semantic collection operations need runtime identities.
pub func verify_application(program: MirProgram):
    var needs_runtime = false
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                AllocateStorage(result, element_type, count): needs_runtime = true
                DeallocateStorage(address, element_type, count): needs_runtime = true
                BufferRetain(value): needs_runtime = true
                BufferRelease(value): needs_runtime = true
                BufferConcat(result, left_data, left_length, right_data, right_length): needs_runtime = true
                BufferData(result, owner): needs_runtime = true
                BufferLength(result, owner): needs_runtime = true
                CStringCopy(result, source): needs_runtime = true
                StringScalarCount(result, data, length): needs_runtime = true
                StringDecode(character, width, data, length, offset): needs_runtime = true
                BytesSlice(result, owner, data, length, start, end): needs_runtime = true
                ListCreate(result): needs_runtime = true
                ListLength(result, value): needs_runtime = true
                ListElementAddress(result, value, position): needs_runtime = true
                ListMutableSliceBegin(result, value, element_retain): needs_runtime = true
                ListAppendSlot(result, value, element_retain): needs_runtime = true
                ListReserve(value, minimum_capacity, element_retain): needs_runtime = true
                ListSlice(result, value, start, end): needs_runtime = true
                ListRelease(value, element_release): needs_runtime = true
                ClassCreate(result, identity): needs_runtime = true
                ClassMarkInitialized(value): needs_runtime = true
                ClassRetain(value): needs_runtime = true
                ClassRelease(value): needs_runtime = true
                ClassFieldAddress(result, value, field): needs_runtime = true
                WeakClassCreate(result, value): needs_runtime = true
                WeakClassRetain(value): needs_runtime = true
                WeakClassRelease(value): needs_runtime = true
                WeakClassPromote(destination, value, optional_type): needs_runtime = true
                InterfaceCreate(result, source_address, conformance): needs_runtime = true
                InterfaceRetain(value): needs_runtime = true
                InterfaceRelease(value): needs_runtime = true
                InterfaceDetach(result, value): needs_runtime = true
                InterfacePayload(result, value): needs_runtime = true
                CellCreate(result, element_type, destroyer): needs_runtime = true
                CellMarkInitialized(value): needs_runtime = true
                CellRetain(value): needs_runtime = true
                CellRelease(value): needs_runtime = true
                CellValueAddress(result, value, element_type): needs_runtime = true
                ClosureCreate(environment, destination, function_type, closure): needs_runtime = true
                ClosureMarkInitialized(environment): needs_runtime = true
                ClosureCaptureAddress(result, environment, closure, capture): needs_runtime = true
                FunctionRetain(value): needs_runtime = true
                FunctionRelease(value): needs_runtime = true
                CallInterface(results, interface_id, requirement, target, arguments): needs_runtime = true
                EqualityContextCreate(result): needs_runtime = true
                EqualityContextRelease(value): needs_runtime = true
                EqualityContextVisit(result, context, left, right): needs_runtime = true
                HashCreate(result): needs_runtime = true
                HashRetain(value): needs_runtime = true
                HashRelease(value, key_release, value_release): needs_runtime = true
                HashCopy(result, value, key_retain, value_retain): needs_runtime = true
                HashLength(result, value): needs_runtime = true
                HashIterationBegin(result, value): needs_runtime = true
                HashIterationEnd(value): needs_runtime = true
                HashFindFirst(result, value, key_hash): needs_runtime = true
                HashFindNext(result, value, current): needs_runtime = true
                HashKeyAddress(result, value, index): needs_runtime = true
                HashValueAddress(result, value, index): needs_runtime = true
                HashInsertEntry(result, value, key_hash): needs_runtime = true
                HashRemoveEntry(value, index): needs_runtime = true
                HashClear(value, key_release, value_release): needs_runtime = true
                HashReserve(value, minimum_capacity): needs_runtime = true
                else: pass
    if not needs_runtime:
        MirVerifier(program).verify() catch reason:
            trap(reason)
        return
    let runtime = compile_runtime(sealed_runtime_package("src/runtime", ["src/runtime/allocator.native.luc"])) catch reason:
        trap(reason)
    let product = compose_runtime(program, runtime.program) catch reason:
        trap(reason)
    MirVerifier(product).verify() catch reason:
        trap(reason)

# Return one lowering diagnostic, or an empty string when the fixture lowers.
pub func lowering_failure(source: str) -> str:
    return module_lowering_failure([source_module("main", source)])

pub func module_lowering_failure(modules: list[SourceModule]) -> str:
    let program = Lowerer(checked_modules(modules)).lower() catch reason:
        return reason
    return ""

pub func is_type(id: TypeId, expected: BuiltinMirType) -> bool:
    return id.value == builtin_mir_type(expected).value

pub func only_function(program: MirProgram) -> MirFunction:
    assert(len(program.functions) == 1)
    return program.functions[0]

# Render a MIR result the way the HIR interpreter renders its value, so the
# two executions compare as text.
pub func render_mir(values: list[MirValue]) -> str:
    if len(values) == 0: return "unit"
    match values[0]:
        SignedInt(item): return str(item)
        UnsignedInt(item): return str(item)
        Float(item): return str(item)
        Bool(item): return str(item)
        Ptr(item): return "ptr " + str(item)

# The decisive check: the oracle and the MIR interpreter agree on `answer`.
pub func agree(source: str) -> str:
    return agree_modules([source_module("main", source)])

pub func agree_modules(modules: list[SourceModule]) -> str:
    let program = checked_modules(modules)
    let oracle = HirInterpreter().run(program, "main", "answer") catch reason:
        trap(reason)
    let mir = Lowerer(program).lower() catch reason:
        trap(reason)
    verify_application(mir)
    let results = MirInterpreter(mir, interpreter_layout()).run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(oracle.render() == render_mir(results))
    return oracle.render()

pub func oracle_failure(source: str) -> str:
    let oracle = HirInterpreter().run(checked(source), "main", "answer") catch reason:
        return reason
    return ""

pub func mir_failure(source: str) -> str:
    let results = MirInterpreter(lowered(source), interpreter_layout()).run("main.answer", list[MirValue]()) catch reason:
        return reason
    return ""

# Both executions must refuse the program at run time.
pub func both_trap(source: str):
    assert(oracle_failure(source) != "")
    assert(mir_failure(source) != "")

