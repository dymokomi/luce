#==============================================================================================
#
#   pipeline_stages_test - Architectural stage boundaries remain executable
#
#   DESCRIPTION:
#       The early no-op stages are still real contracts: semantic analysis
#       preserves typed HIR and optimization preserves valid canonical MIR.
#       These tests make intentional identity behavior visible and temporary.
#
#==============================================================================================

from luce.compiler.mir.canonical import BuiltinMirType, CallingConvention, InstructionForm, MirConstant, MirFunction, OperandBuilder
from luce.compiler.mir.canonical import MirInstruction, MirSignature, MirSlot, RegisterId, TypeId
from luce.compiler.mir.canonical import builtin_mir_type, create_empty_mir_program
from luce.compiler.mir.optimizer import Optimizer
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.frontend.source import SourceSpan
from luce.compiler.hir.ir import create_empty_hir_program

pub func test_semantic_analyzer_preserves_the_current_typed_hir():
    let ops = OperandBuilder()
    let program = create_empty_hir_program()
    let analyzed = SemanticAnalyzer(program).analyze() catch reason:
        trap(reason)
    assert(len(analyzed.hir.modules) == 0)

pub func test_optimizer_preserves_the_current_canonical_mir():
    let ops = OperandBuilder()
    let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
    let i64_type = builtin_mir_type(BuiltinMirType.signed_i64)
    let body: list[MirInstruction] = [
        MirInstruction(form = InstructionForm.Const(result = RegisterId(value = 0), value = MirConstant.Int(value = 7)), span = span),
        MirInstruction(form = InstructionForm.Return(values = ops.run([RegisterId(value = 0)])), span = span),
    ]
    let program = create_empty_mir_program()
    program.functions.append(MirFunction(
        name = "main.answer",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [i64_type], is_fallible = false),
        registers = [i64_type],
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        span = span,
    ))
    let optimized = Optimizer(program).optimize()
    assert(len(optimized.functions) == 1)
    assert(len(optimized.functions[0].body) == 2)
    match optimized.functions[0].body[0].form:
        Const(result, value):
            assert(result.value == 0)
            match value:
                Int(item): assert(item == 7)
                else: assert(false)
        else: assert(false)
    match optimized.functions[0].body[1].form:
        Return(values): assert(i64(values.count) == 1)
        else: assert(false)
