#==============================================================================================
#
#   pipeline_stages_test - Architectural stage boundaries remain executable
#
#   DESCRIPTION:
#       Semantic analysis preserves typed HIR. Target-independent optimization
#       preserves canonical MIR while removing definitions no artifact root can
#       reach and remapping every surviving function identity.
#
#==============================================================================================

from luce.compiler.mir.canonical import BuiltinMirType, CallingConvention, DataId, ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm, MirConstant, MirFunction, OperandBuilder
from luce.compiler.mir.canonical import MirData, MirExtern, MirExternalGlobal, MirGlobal, MirInstruction, MirSignature, MirSlot, RegisterId, TypeId, no_registers
from luce.compiler.mir.canonical import builtin_mir_type, create_empty_mir_program
from luce.compiler.mir.optimizer import Optimizer
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.frontend.source import SourceSpan
from luce.compiler.hir.ir import create_empty_hir_program

pub func test_semantic_analyzer_preserves_the_current_typed_hir():
    let ops = OperandBuilder()
    let program = create_empty_hir_program()
    let analyzed = SemanticAnalyzer(program).analyze() catch reason:
        trap(reason)
    assert(len(analyzed.hir.modules) == 0)

pub func test_optimizer_preserves_the_current_canonical_mir():
    let ops = OperandBuilder()
    let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
    let i64_type = builtin_mir_type(BuiltinMirType.signed_i64)
    let body: list[MirInstruction] = [
        MirInstruction(form = InstructionForm.Const(result = RegisterId(value = 0), value = MirConstant.Int(value = 7)), span = span),
        MirInstruction(form = InstructionForm.Return(values = ops.run([RegisterId(value = 0)])), span = span),
    ]
    let program = create_empty_mir_program()
    program.functions.append(MirFunction(
        name = "main.answer",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [i64_type], is_fallible = false),
        registers = [i64_type],
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = false,
        is_exported = true,
        span = span,
    ))
    let optimized = Optimizer(program).optimize()
    assert(len(optimized.functions) == 1)
    assert(len(optimized.functions[0].body) == 2)
    match optimized.functions[0].body[0].form:
        Const(result, value):
            assert(result.value == 0)
            match value:
                Int(item): assert(item == 7)
                else: assert(false)
        else: assert(false)
    match optimized.functions[0].body[1].form:
        Return(values): assert(i64(values.count) == 1)
        else: assert(false)

func unit_function(name: str, body: list[MirInstruction], operands: list[u32], registers: list[TypeId], is_exported: bool) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = list[TypeId](), is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = operands,
        is_public = false,
        is_exported = is_exported,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

func return_unit(ops: OperandBuilder) -> MirInstruction:
    return MirInstruction(
        form = InstructionForm.Return(values = ops.run(list[RegisterId]())),
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

pub func test_function_reachability_keeps_entry_exports_and_transitive_edges():
    let span = SourceSpan(start = 0, end = 0, line = 1, column = 1)
    var program = create_empty_mir_program()
    let unit_signature = MirSignature(parameters = list[TypeId](), results = list[TypeId](), is_fallible = false)
    program.externs.append(MirExtern(name = "dead_extern", convention = CallingConvention.c, signature = unit_signature))
    program.externs.append(MirExtern(name = "kept_extern", convention = CallingConvention.c, signature = unit_signature))
    let i32_type = builtin_mir_type(BuiltinMirType.signed_i32)
    program.external_globals.append(MirExternalGlobal(name = "dead_external_global", value_type = i32_type))
    program.external_globals.append(MirExternalGlobal(name = "kept_external_global", value_type = i32_type))
    program.data.append(MirData(name = "dead_data", bytes = [1, 0, 0, 0], align = 4))
    program.data.append(MirData(name = "kept_data", bytes = [2, 0, 0, 0], align = 4))
    program.globals.append(MirGlobal(name = "dead_global", value_type = i32_type, initial = DataId(value = 0), is_mutable = false))
    program.globals.append(MirGlobal(name = "kept_global", value_type = i32_type, initial = DataId(value = 1), is_mutable = false))

    let dead_before_ops = OperandBuilder()
    program.functions.append(unit_function("dead.before", [return_unit(dead_before_ops)], dead_before_ops.operands, list[TypeId](), false))

    let entry_ops = OperandBuilder()
    let entry_body = [
        MirInstruction(form = InstructionForm.DataAddress(result = RegisterId(value = 0), data = DataId(value = 1)), span = span),
        MirInstruction(form = InstructionForm.GlobalAddress(result = RegisterId(value = 1), global = GlobalId(value = 1)), span = span),
        MirInstruction(form = InstructionForm.LoadExternalGlobal(result = RegisterId(value = 2), global = ExternalGlobalId(value = 1)), span = span),
        MirInstruction(form = InstructionForm.Call(results = no_registers(), function = FunctionId(value = 2), arguments = no_registers()), span = span),
        MirInstruction(form = InstructionForm.Const(result = RegisterId(value = 3), value = MirConstant.Int(value = 0)), span = span),
        MirInstruction(form = InstructionForm.Return(values = entry_ops.run([RegisterId(value = 3)])), span = span),
    ]
    program.functions.append(MirFunction(
        name = "main.main",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [i32_type], is_fallible = false),
        registers = [builtin_mir_type(BuiltinMirType.pointer), builtin_mir_type(BuiltinMirType.pointer), i32_type, i32_type],
        slots = list[MirSlot](),
        body = entry_body,
        operands = entry_ops.operands,
        is_public = false,
        is_exported = false,
        span = span,
    ))

    let helper_ops = OperandBuilder()
    let helper_body = [
        MirInstruction(form = InstructionForm.ExternAddress(result = RegisterId(value = 0), external = ExternId(value = 1)), span = span),
        MirInstruction(form = InstructionForm.Call(results = no_registers(), function = FunctionId(value = 4), arguments = no_registers()), span = span),
        return_unit(helper_ops),
    ]
    program.functions.append(unit_function("main.helper", helper_body, helper_ops.operands, [builtin_mir_type(BuiltinMirType.pointer)], false))

    let export_ops = OperandBuilder()
    let export_body = [
        MirInstruction(form = InstructionForm.FunctionAddress(result = RegisterId(value = 0), function = FunctionId(value = 5)), span = span),
        return_unit(export_ops),
    ]
    program.functions.append(unit_function("library.callback", export_body, export_ops.operands, [builtin_mir_type(BuiltinMirType.pointer)], true))

    let leaf_ops = OperandBuilder()
    program.functions.append(unit_function("main.leaf", [return_unit(leaf_ops)], leaf_ops.operands, list[TypeId](), false))
    let callback_ops = OperandBuilder()
    program.functions.append(unit_function("main.callback_body", [return_unit(callback_ops)], callback_ops.operands, list[TypeId](), false))
    let dead_after_ops = OperandBuilder()
    program.functions.append(unit_function("dead.after", [return_unit(dead_after_ops)], dead_after_ops.operands, list[TypeId](), false))
    program.entry = FunctionId(value = 1)

    MirVerifier(program).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(program).optimize()
    MirVerifier(optimized).verify() catch reason:
        trap(reason)

    assert(len(optimized.functions) == 5)
    assert(optimized.functions[0].name == "main.main")
    assert(optimized.functions[1].name == "main.helper")
    assert(optimized.functions[2].name == "library.callback")
    assert(optimized.functions[3].name == "main.leaf")
    assert(optimized.functions[4].name == "main.callback_body")
    assert(len(optimized.externs) == 1 and optimized.externs[0].name == "kept_extern")
    assert(len(optimized.external_globals) == 1 and optimized.external_globals[0].name == "kept_external_global")
    assert(len(optimized.globals) == 1 and optimized.globals[0].name == "kept_global")
    assert(len(optimized.data) == 1 and optimized.data[0].name == "kept_data")
    let initial = optimized.globals[0].initial else trap("expected remapped global initializer")
    assert(initial.value == 0)
    let entry = optimized.entry else trap("expected remapped entry")
    assert(entry.value == 0)
    match optimized.functions[0].body[0].form:
        DataAddress(result, data): assert(data.value == 0)
        else: assert(false)
    match optimized.functions[0].body[1].form:
        GlobalAddress(result, global): assert(global.value == 0)
        else: assert(false)
    match optimized.functions[0].body[2].form:
        LoadExternalGlobal(result, global): assert(global.value == 0)
        else: assert(false)
    match optimized.functions[0].body[3].form:
        Call(results, target, arguments): assert(target.value == 1)
        else: assert(false)
    match optimized.functions[1].body[0].form:
        ExternAddress(result, external): assert(external.value == 0)
        else: assert(false)
    match optimized.functions[1].body[1].form:
        Call(results, target, arguments): assert(target.value == 3)
        else: assert(false)
    match optimized.functions[2].body[0].form:
        FunctionAddress(result, target): assert(target.value == 4)
        else: assert(false)

    # Optimization returns a new function table; it never corrupts the valid
    # canonical input retained by callers or diagnostic tooling.
    assert(len(program.functions) == 7)
    let original_entry = program.entry else trap("expected original entry")
    assert(original_entry.value == 1)

pub func test_function_reachability_preserves_a_library_without_artifact_roots():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(unit_function("private.helper", [return_unit(ops)], ops.operands, list[TypeId](), false))
    let optimized = Optimizer(program).optimize()
    assert(len(optimized.functions) == 1)
    assert(optimized.functions[0].name == "private.helper")
    assert(optimized.entry == none)
