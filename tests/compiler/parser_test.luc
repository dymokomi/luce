#==============================================================================================
#
#   parser_test - What the parser accepts and rejects
#
#   DESCRIPTION:
#       Epoch-1 source fixtures in, syntax trees (or stable diagnostics) out.
#       Fixtures are tokenized by the test-local helpers below before they reach
#       the parser, and the sections walk the grammar the same way the parser
#       does: declarations, statements, types and expressions, then rejects.
#
#       NOTE: Stage-0 discovers zero-argument `test_*` functions. Epoch 1
#       replaces this bootstrap convention with `test "description":`
#       declarations.
#
#==============================================================================================

from luce.compiler.parser import Parser
from luce.compiler.syntax import ExpressionForm, ExpressionSyntax, FunctionSyntax, ModuleSyntax
from luce.compiler.syntax import StatementSyntax, SuiteStyle, SuiteSyntax
from luce.compiler.tokenizer import Tokenizer

# mark: Test helpers =========================================================================

pub func parse_source(source: str) -> ModuleSyntax!:
    let tokens = try Tokenizer(source).tokenize()
    return try Parser(tokens).parse()

pub func parsed(source: str) -> ModuleSyntax:
    let module = parse_source(source) catch reason:
        trap(reason)
    return module

pub func failure(source: str) -> str:
    let module = parse_source(source) catch reason:
        return reason
    return ""

pub func parses(source: str) -> bool:
    return len(failure(source)) == 0

pub func function_body(function_value: FunctionSyntax) -> SuiteSyntax:
    return function_value.body else trap("expected a function body")

pub func first_function(module: ModuleSyntax) -> FunctionSyntax:
    match module.declarations[0].value:
        Function(value): return value
        else: trap("expected the first declaration to be a function")

pub func binding_expression(statement: StatementSyntax) -> ExpressionSyntax:
    match statement.form:
        Binding(is_mutable, pattern, annotation, value, span): return value
        else: trap("expected a binding statement")

pub func binding_of(module: ModuleSyntax, index: i64) -> ExpressionForm:
    match module.declarations[index].value:
        Constant(value): return value.value.form
        else: trap("expected a constant declaration")


# mark: Modules and declarations =============================================================

pub func test_empty_module_has_an_empty_source_span():
    let module = parsed("")
    assert(len(module.imports) == 0)
    assert(len(module.declarations) == 0)
    assert(module.span.start == 0)
    assert(module.span.end == 0)

pub func test_imports_precede_declarations_and_preserve_paths():
    let source = "import compiler.syntax\nimport platform.files as files\nfrom compiler.tokenizer import Token, TokenKind\nlet answer = 42\n"
    let module = parsed(source)
    assert(len(module.imports) == 3)
    assert(len(module.imports[0].path.parts) == 2)
    assert(module.imports[0].path.parts[1] == "syntax")
    assert(len(module.imports[0].names) == 0)
    assert(module.imports[0].alias_name == none)
    assert((module.imports[1].alias_name else "") == "files")
    assert(len(module.imports[2].names) == 2)
    assert(module.imports[2].names[0].name == "Token")
    assert(module.imports[2].names[1].name == "TokenKind")
    assert(module.imports[2].alias_name == none)
    assert(len(module.declarations) == 1)
    assert(module.span.end == len(source))

pub func test_documentation_visibility_and_inline_function_body_are_preserved():
    let source = "## Return the input.\n## This stays Markdown.\npub func identity(value: i64) -> i64: return value\n"
    let module = parsed(source)
    let declaration = module.declarations[0]
    assert(declaration.is_public)
    assert(len(declaration.documentation) == 2)
    assert(declaration.documentation[0] == "Return the input.")
    assert(declaration.span.line == 3)
    let function_value = first_function(module)
    let body = function_body(function_value)
    assert(function_value.name == "identity")
    assert(len(function_value.parameters) == 1)
    assert(body.style == SuiteStyle.inline_suite)
    assert(str(body.statements[0].form) == "ReturnStatement")

pub func test_declarations_and_fields_are_private_by_default():
    let source = "func helper(): return\npub func api(): return\nstruct Settings:\n    let secret: str\n    pub let label: str\n"
    let module = parsed(source)
    assert(not module.declarations[0].is_public)
    assert(module.declarations[1].is_public)
    assert(not module.declarations[2].is_public)
    match module.declarations[2].value:
        NominalType(value):
            assert(not value.members[0].is_public)
            assert(value.members[1].is_public)
        else: assert(false)

pub func test_constants_and_type_aliases_have_distinct_declarations():
    let module = parsed("let maximum: u64 = 100\ntype Identifier = u64\n")
    assert(str(module.declarations[0].value) == "Constant")
    assert(str(module.declarations[1].value) == "TypeAlias")
    match module.declarations[0].value:
        Constant(value):
            assert(value.name == "maximum")
            assert(value.annotation != none)
            assert(str(value.value.form) == "Literal")
        else: assert(false)

pub func test_underscore_prefixed_names_are_identifiers_not_wildcards():
    let module = parsed("func use(_value: i64): return\nlet _unused = 1\n")
    assert(len(module.declarations) == 2)
    assert(first_function(module).parameters[0].name == "_value")
    match module.declarations[1].value:
        Constant(value): assert(value.name == "_unused")
        else: assert(false)

pub func test_struct_and_class_members_keep_generics_fields_and_methods():
    let source = "struct Box[T: Equatable] implements Drawable:\n    ## Stored item.\n    pub let value: T\n    mutating func replace(self, next: T): self.value = next\nclass Node:\n    weak var parent: Node? = none\n    func init(self): return\n"
    let module = parsed(source)
    assert(len(module.declarations) == 2)
    match module.declarations[0].value:
        NominalType(value):
            assert(value.name == "Box")
            assert(len(value.generic_parameters) == 1)
            assert(len(value.generic_parameters[0].constraints) == 1)
            assert(len(value.interfaces) == 1)
            assert(len(value.members) == 2)
            assert(value.members[0].documentation[0] == "Stored item.")
        else: assert(false)
    match module.declarations[1].value:
        NominalType(value):
            assert(value.name == "Node")
            assert(len(value.members) == 2)
        else: assert(false)

pub func test_enum_cases_payloads_and_interface_signatures_parse():
    let source = "enum Shape:\n    ## A circle.\n    circle(radius: f64)\n    point\n    mutating func reset(self): return\ninterface Reader[T]:\n    ## Read bytes.\n    mutating func read(self, count: u64) -> bytes! uses files\n"
    let module = parsed(source)
    match module.declarations[0].value:
        Enumeration(value):
            assert(len(value.cases) == 2)
            assert(value.cases[0].documentation[0] == "A circle.")
            assert(len(value.cases[0].payload) == 1)
            assert(value.cases[0].payload[0].name == "radius")
            assert(len(value.methods) == 1)
            match value.methods[0].value:
                Function(method): assert(method.is_mutating)
                else: assert(false)
        else: assert(false)
    match module.declarations[1].value:
        InterfaceType(value):
            assert(value.name == "Reader")
            assert(len(value.methods) == 1)
            match value.methods[0].value:
                Function(method): assert(method.is_mutating)
                else: assert(false)
        else: assert(false)

pub func test_tests_and_all_export_c_forms_parse():
    let source = "test \"round trip\" uses files: return\nexport c struct Pixel:\n    ## Red channel.\n    let red: u8\n    let green: u8\nexport c enum Status as u32:\n    ready = 1\n    stopped = 2\nexport c func add(left: i64, right: i64) -> i64: return left + right\n"
    let module = parsed(source)
    assert(len(module.declarations) == 4)
    assert(str(module.declarations[0].value) == "TestDeclaration")
    assert(str(module.declarations[1].value) == "ExportStruct")
    assert(str(module.declarations[2].value) == "ExportEnum")
    assert(str(module.declarations[3].value) == "ExportFunction")
    match module.declarations[1].value:
        ExportStruct(value):
            assert(len(value.fields) == 2)
            assert(value.fields[0].name == "red")
            assert(value.fields[0].documentation[0] == "Red channel.")
        else: assert(false)
    match module.declarations[2].value:
        ExportEnum(value):
            assert(value.representation == "u32")
            assert(len(value.cases) == 2)
        else: assert(false)

pub func test_exported_functions_keep_the_narrow_c_surface():
    assert(not parses("export c func identity[T](value: T) -> T: return value\n"))
    assert(not parses("export c func load(path: str) -> bytes uses files: return none\n"))
    assert(not parses("export c struct Pixel:\n    pub let red: u8\n"))

pub func test_extern_declarations_parse_the_boundary_surface():
    let source = "extern type Window\nextern type Device = i32\nextern func SDL_GetError() -> str\nextern func SDL_CreateWindow(title: str, w: i32, h: i32, flags: u64) -> Window?\nextern func SDL_GetWindowSize(window: Window, out w: i32, out h: i32) -> bool\nextern blocking func SDL_Delay(ms: u32)\nextern var SDL_version_number: i32\nextern struct Rect:\n    x: i32\n    y: i32\n    w: i32\n    h: i32\n"
    let module = parsed(source)
    assert(len(module.declarations) == 8)
    match module.declarations[0].value:
        ExternType(value):
            assert(value.name == "Window")
            assert(value.representation == none)
        else: assert(false)
    match module.declarations[1].value:
        ExternType(value):
            assert(value.name == "Device")
            assert((value.representation else "") == "i32")
        else: assert(false)
    match module.declarations[2].value:
        ExternFunction(value):
            assert(len(value.parameters) == 0)
            assert(value.result != none)
        else: assert(false)
    match module.declarations[4].value:
        ExternFunction(value):
            assert(value.name == "SDL_GetWindowSize")
            assert(not value.is_blocking)
            assert(len(value.parameters) == 3)
            assert(not value.parameters[0].is_out)
            assert(value.parameters[1].is_out)
            assert(value.parameters[1].name == "w")
            assert(value.parameters[2].is_out)
        else: assert(false)
    match module.declarations[5].value:
        ExternFunction(value):
            assert(value.is_blocking)
            assert(value.result == none)
        else: assert(false)
    match module.declarations[6].value:
        ExternVariable(value): assert(value.name == "SDL_version_number")
        else: assert(false)
    match module.declarations[7].value:
        ExternStruct(value):
            assert(value.name == "Rect")
            assert(len(value.fields) == 4)
            assert(value.fields[0].name == "x")
        else: assert(false)

pub func test_cfunc_is_a_type_form_usable_anywhere_a_type_is():
    let source = "extern struct Callbacks:\n    on_event: cfunc(Event, i32) -> i32\ntype Handler = cfunc() -> unit\nextern func register(callback: cfunc(i32) -> i32) -> bool\nstruct Hooks:\n    let on_tick: cfunc(u64) -> unit\n"
    let module = parsed(source)
    assert(len(module.declarations) == 4)
    match module.declarations[0].value:
        ExternStruct(value):
            match value.fields[0].value_type.form:
                CFunctionType(parameters, result, span): assert(len(parameters) == 2)
                else: assert(false)
        else: assert(false)
    match module.declarations[1].value:
        TypeAlias(value):
            match value.value.form:
                CFunctionType(parameters, result, span): assert(len(parameters) == 0)
                else: assert(false)
        else: assert(false)
    # A bare `cfunc` without a parameter list stays an ordinary type name.
    let named = parsed("type Odd = cfunc\n")
    match named.declarations[0].value:
        TypeAlias(value): assert(str(value.value.form) == "Named")
        else: assert(false)


# mark: Statements and suites ================================================================

pub func test_indented_function_body_preserves_simple_statement_kinds():
    let source = "func statements(value: i64):\n    let copy = value\n    var current: i64 = copy\n    current += 1\n    defer cleanup()\n    recover current\n    consume(current)\n    return current\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 7)
    assert(str(statements[0].form) == "Binding")
    assert(str(statements[1].form) == "Binding")
    assert(str(statements[2].form) == "Assignment")
    assert(str(statements[3].form) == "DeferStatement")
    assert(str(statements[4].form) == "RecoverStatement")
    assert(str(statements[5].form) == "ExpressionStatement")
    assert(str(statements[6].form) == "ReturnStatement")

pub func test_control_flow_statements_and_conditional_binding_parse():
    let source = "func control(optional: i64?, items: list[i64]):\n    if let value = optional:\n        return value\n    else: return 0\n    while ready: break\n    for item in items:\n        if item > 5: continue\n    match status:\n        .ready: return 1\n        _: return 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 4)
    assert(str(statements[0].form) == "IfStatement")
    assert(str(statements[1].form) == "WhileStatement")
    assert(str(statements[2].form) == "ForStatement")
    assert(str(statements[3].form) == "MatchStatement")


# mark: Types and expressions ================================================================

pub func test_function_tuple_optional_and_fallible_types_parse():
    let source = "type Pair = (i64, str)\ntype Callback = func(i64, list[Point?]) -> bytes! uses files\ntype OptionalCallback = (func() -> unit)?\n"
    let module = parsed(source)
    assert(len(module.declarations) == 3)
    match module.declarations[2].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                OptionalType(optional_value, optional_span):
                    match optional_value.form:
                        GroupedType(grouped, group_span): assert(str(grouped.form) == "FunctionType")
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_binary_operator_precedence_builds_the_expected_tree():
    let module = parsed("let value = 1 + 2 * 3 == 7 and true or false\n")
    match module.declarations[0].value:
        Constant(constant_value):
            match constant_value.value.form:
                Binary(or_left, or_operator, or_right, or_span):
                    assert(or_operator == "or")
                    match or_left.form:
                        Binary(and_left, and_operator, and_right, and_span):
                            assert(and_operator == "and")
                            match and_left.form:
                                Binary(compare_left, compare_operator, compare_right, compare_span):
                                    assert(compare_operator == "==")
                                    match compare_left.form:
                                        Binary(add_left, add_operator, add_right, add_span):
                                            assert(add_operator == "+")
                                            assert(str(add_right.form) == "Binary")
                                        else: assert(false)
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_postfix_calls_distinguish_generic_arguments_from_indexing():
    let source = "func use(callbacks: list[Callback], index: u64):\n    let decoded = decode[Header](callbacks[index])\n    let invoked = callbacks[index](decoded)\n    let first = callbacks[0](decoded)\n    let range = callbacks[1..<index]\n    let prefix = callbacks[..<index]\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Call(callee, type_arguments, arguments, call_span):
            assert(len(type_arguments) == 1)
            assert(len(arguments) == 1)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Call(callee, type_arguments, arguments, call_span):
            assert(len(type_arguments) == 0)
            assert(str(callee.form) == "Index")
        else: assert(false)
    match binding_expression(statements[2]).form:
        Call(callee, type_arguments, arguments, call_span):
            assert(len(type_arguments) == 0)
            assert(str(callee.form) == "Index")
        else: assert(false)
    assert(str(binding_expression(statements[3]).form) == "Slice")
    assert(str(binding_expression(statements[4]).form) == "Slice")

pub func test_index_bounds_accept_full_expressions_and_inclusive_suffixes():
    let source = "func select(items: list[i64], index: u64):\n    let compared = items[index < limit]\n    let chosen = items[index if ready else limit]\n    let suffix = items[index..]\n"
    assert(parses(source))
    assert(not parses("func invalid(items: list[i64]): return items[1..2]\n"))
    assert(not parses("func invalid(items: list[i64]): return items[..]\n"))

pub func test_lambdas_keep_inferred_and_explicit_parameter_types():
    let source = "func predicates():\n    let inferred = (value) => value > 5\n    let typed = (left: i64, right: i64) => left < right\n    let empty = () => true\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Lambda(parameters, body, lambda_span):
            assert(len(parameters) == 1)
            assert(parameters[0].annotation == none)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Lambda(parameters, body, lambda_span):
            assert(len(parameters) == 2)
            assert(parameters[0].annotation != none)
        else: assert(false)
    match binding_expression(statements[2]).form:
        Lambda(parameters, body, lambda_span): assert(len(parameters) == 0)
        else: assert(false)

pub func test_closure_captures_and_catch_handlers_are_source_nodes():
    let source = "func build(count: i64, owner: Owner):\n    let callback = func [copy snapshot = count, weak owner, weak self] (value: i64) -> i64:\n        return value + snapshot\n    let loaded = try load() catch failure:\n        recover none\n    return loaded\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Closure(captures, parameters, result, effects, body, closure_span):
            assert(len(captures) == 3)
            assert(captures[0].name == "snapshot")
            assert(captures[1].is_weak)
            assert(captures[2].name == "self")
            assert(captures[2].is_weak)
        else: assert(false)
    assert(str(binding_expression(statements[1]).form) == "CatchValue")

pub func test_match_expression_uses_value_arms_and_match_statement_uses_suites():
    let source = "func digit(c: char) -> i64:\n    let value = match c:\n        '0' => 0\n        _ => 1\n    match value:\n        0: return 0\n        _: return value\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        MatchValue(subject, arms, match_span): assert(len(arms) == 2)
        else: assert(false)
    assert(str(statements[1].form) == "MatchStatement")

pub func test_match_patterns_preserve_ranges_and_comma_separated_alternatives():
    let source = "func classify(c: char):\n    let kind: str = match c:\n        '0'..='9' => \"digit\"\n        'a'..='z', 'A'..='Z' => \"letter\"\n        _ => \"other\"\n    match kind:\n        \"digit\", \"letter\": return true\n        _: return false\n"
    let statements = function_body(first_function(parsed(source))).statements
    match binding_expression(statements[0]).form:
        MatchValue(subject, arms, match_span):
            assert(len(arms) == 3)
            assert(len(arms[0].patterns) == 1)
            match arms[0].patterns[0]:
                RangePattern(lower, operator, upper, span):
                    assert(lower.token.text == "'0'")
                    assert(not lower.is_negative)
                    assert(operator == "..=")
                    assert(upper.token.text == "'9'")
                else: assert(false)
            assert(len(arms[1].patterns) == 2)
            match arms[1].patterns[0]:
                RangePattern(lower, operator, upper, span): assert(operator == "..=")
                else: assert(false)
        else: assert(false)
    match statements[1].form:
        MatchStatement(subject, arms, match_span):
            assert(len(arms) == 2)
            assert(len(arms[0].patterns) == 2)
            assert(str(arms[0].patterns[0]) == "Literal")
            assert(str(arms[0].patterns[1]) == "Literal")
        else: assert(false)

pub func test_negative_numeric_patterns_preserve_their_signs():
    let source = "func classify(value: i64):\n    match value:\n        -10..=-1, -20: return true\n        _: return false\n"
    let statements = function_body(first_function(parsed(source))).statements
    match statements[0].form:
        MatchStatement(subject, arms, match_span):
            match arms[0].patterns[0]:
                RangePattern(lower, operator, upper, span):
                    assert(lower.is_negative)
                    assert(lower.token.text == "10")
                    assert(upper.is_negative)
                    assert(upper.token.text == "1")
                else: assert(false)
            match arms[0].patterns[1]:
                Literal(value):
                    assert(value.is_negative)
                    assert(value.token.text == "20")
                else: assert(false)
        else: assert(false)

    assert(
        failure("func invalid(value: char):\n    match value:\n        -'a': return\n")
        == "3:10: expected a numeric literal after `-` in a pattern"
    )

pub func test_case_payload_commas_remain_distinct_from_arm_alternatives():
    let source = "func handle(command: Command):\n    match command:\n        .resize(width, height), .move(width, height): return width + height\n        .quit: return 0\n"
    let statements = function_body(first_function(parsed(source))).statements
    match statements[0].form:
        MatchStatement(subject, arms, match_span):
            assert(len(arms[0].patterns) == 2)
            match arms[0].patterns[0]:
                CasePattern(name, bindings, span):
                    assert(name == "resize")
                    assert(len(bindings) == 2)
                else: assert(false)
            match arms[0].patterns[1]:
                CasePattern(name, bindings, span): assert(name == "move")
                else: assert(false)
        else: assert(false)

pub func test_block_expression_ends_before_a_following_if_statement():
    let source = "func classify(value: i64) -> i64:\n    let result = match value:\n        0 => 0\n        _ => 1\n    if value > 0: return result\n    return -1\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 3)
    assert(str(statements[0].form) == "Binding")
    assert(str(statements[1].form) == "IfStatement")
    assert(str(statements[2].form) == "ReturnStatement")

pub func test_else_fallback_binds_below_or_and_takes_expression_arms():
    let module = parsed("let count = parse_i64(text) else 0\nlet ready = a or b else c\nlet w = create_window() else error(\"no window\")\nlet n = parse_i64(text) else trap(\"not a number\")\n")
    match binding_of(module, 0):
        ElseValue(value, arm, span):
            assert(str(value.form) == "Call")
            assert(str(arm.form) == "Literal")
        else: assert(false)
    match binding_of(module, 1):
        ElseValue(value, arm, span):
            match value.form:
                Binary(left, operator, right, binary_span): assert(operator == "or")
                else: assert(false)
        else: assert(false)
    match binding_of(module, 2):
        ElseValue(value, arm, span): assert(str(arm.form) == "Call")
        else: assert(false)
    match binding_of(module, 3):
        ElseValue(value, arm, span): assert(str(arm.form) == "Call")
        else: assert(false)

pub func test_else_fallback_chains_and_stays_distinct_from_the_conditional():
    let module = parsed("let value = first() else second() else 0\nlet chosen = value if ready else other else fallback\n")
    match binding_of(module, 0):
        ElseValue(value, arm, span):
            assert(str(value.form) == "Call")
            match arm.form:
                ElseValue(inner_value, inner_arm, inner_span): assert(str(inner_arm.form) == "Literal")
                else: assert(false)
        else: assert(false)
    match binding_of(module, 1):
        ElseValue(value, arm, span):
            assert(str(value.form) == "Conditional")
            assert(str(arm.form) == "Name")
        else: assert(false)

pub func test_primary_and_conditional_expression_families_parse():
    let source = "func values(index: u64):\n    let tuple = (1, 2)\n    let list_value = [1, 2]\n    let map_value = {\"one\": 1}\n    let case_value = .ready(index: index)\n    let object = new Widget(value: index)\n    let task_value = spawn workers.render(index)\n    return -index if index > 0 else 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(str(binding_expression(statements[0]).form) == "TupleValue")
    assert(str(binding_expression(statements[1]).form) == "ListValue")
    assert(str(binding_expression(statements[2]).form) == "MapValue")
    assert(str(binding_expression(statements[3]).form) == "CaseValue")
    assert(str(binding_expression(statements[4]).form) == "NewValue")
    assert(str(binding_expression(statements[5]).form) == "SpawnValue")
    match statements[6].form:
        ReturnStatement(value, span):
            let returned = value else trap("expected a return value")
            assert(str(returned.form) == "Conditional")
        else: assert(false)


# mark: Rejected syntax and diagnostics ======================================================

pub func test_imports_must_form_the_leading_module_prefix():
    assert(not parses("let value = 1\nimport later.module\n"))
    assert(not parses("let value = 1\nfrom later.module import value\n"))
    assert(not parses("from later.module import _\n"))
    assert(not parses("from later.module import value as alias\n"))
    assert(not parses("var global = 1\n"))

pub func test_documentation_must_be_consecutive_and_touch_a_declaration():
    assert(parses("## Summary.\nlet value = 1\n"))
    assert(not parses("## First.\n\n## Second.\nlet value = 1\n"))
    assert(not parses("## Detached.\n\nlet value = 1\n"))
    assert(not parses("func run():\n    ## Not a local declaration.\n    return\n"))

pub func test_empty_declaration_bodies_and_interface_fields_are_rejected():
    assert(not parses("struct Empty:\n"))
    assert(not parses("enum Empty:\n"))
    assert(not parses("interface Empty:\n"))
    assert(not parses("interface Invalid:\n    let value: i64\n"))
    assert(not parses("interface Invalid:\n    pub func value(self) -> i64\n"))

pub func test_parameter_tuple_and_lambda_shapes_follow_the_grammar():
    assert(not parses("func missing_type(value): return\n"))
    assert(not parses("func invalid(self = other): return\n"))
    assert(not parses("type Empty = list[]\n"))
    assert(not parses("let one = (1,)\n"))
    assert(not parses("let invalid = (value = 5) => value\n"))

pub func test_conditional_binding_and_same_line_suite_restrictions_are_enforced():
    assert(not parses("func invalid(optional: i64?):\n    if let value = optional: return value\n    elif retry: return 0\n"))
    assert(not parses("func invalid(ready: bool): if ready: return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: let callback = func(): return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: return match value:\n        _ => 0\n"))

pub func test_match_arrows_distinguish_values_from_statement_suites():
    assert(parses("let value = match c:\n    '0' => 0\n    _ => 1\n"))
    assert(not parses("let value = match c:\n    '0': return 0\n"))
    assert(parses("func run(c: char):\n    match c:\n        '0': return\n"))
    assert(not parses("func run(c: char):\n    match c:\n        '0' => 0\n"))

pub func test_match_patterns_reject_incomplete_alternatives_and_ranges():
    assert(not parses("let value = match c:\n    '0', => 0\n"))
    assert(not parses("let value = match c:\n    '0'..= => 0\n"))
    assert(not parses("let value = match c:\n    '0'..'9' => 0\n"))
    assert(not parses("let value = match c:\n    ..<'9' => 0\n"))

pub func test_comparison_and_range_operators_cannot_chain():
    assert(not parses("let value = first < second < third\n"))
    assert(not parses("let value = first ..< second ..= third\n"))
    assert(parses("let value = first is not second\n"))

pub func test_not_before_comparison_requires_explicit_grouping():
    assert(
        failure("let value = not a == b\n")
        == "1:19: ambiguous `not` before comparison; write `not (a == b)` or `(not a) == b`"
    )
    assert(parses("let value = not (a == b)\n"))
    assert(parses("let value = (not a) == b\n"))

pub func test_assignment_requires_a_named_member_or_index_target():
    assert(parses("func set(self, index: u64): self.items[index].ready = true\n"))
    assert(not parses("func invalid(): (left + right) = value\n"))
    assert(not parses("func invalid(): call() = value\n"))
    assert(not parses("func invalid(items: list[i64]): items[..<2] = []\n"))

pub func test_extern_declarations_keep_the_c_shape():
    assert(failure("extern func f(x: i32 = 1) -> i32\n") == "1:15: an extern parameter takes no default; the C shape is the whole truth")
    assert(failure("extern func g() -> i32!\n") == "1:23: an extern is not fallible; C reports failure in its return value, and the wrapper is where `!` lives")
    assert(failure("extern type Handle = f64\n") == "1:22: an extern type representation must be `u32`, `i32`, `u64`, or `i64`")
    assert(not parses("extern type Handle = u8\n"))
    assert(parses("extern type Handle = u64\n"))
    # `out` is contextual, so a parameter simply named `out` keeps its C shape.
    assert(parses("extern func f(out: i32) -> bool\n"))
    assert(not parses("extern func f(self) -> bool\n"))
    assert(not parses("extern func f() -> i32:\n    return 1\n"))
    assert(not parses("extern func f[T](value: T) -> T\n"))
    assert(not parses("extern struct Empty:\n"))
    assert(not parses("extern struct Bad:\n    let x: i32\n"))
    assert(not parses("extern struct Bad:\n    x: i32 = 0\n"))
    assert(not parses("extern let value: i32\n"))

pub func test_parser_diagnostics_report_the_first_token_position():
    assert(failure("let value =\n") == "1:12: expected an expression")
    assert(failure("pub test \"no\": return\n") == "1:1: a test declaration cannot use `pub`")
