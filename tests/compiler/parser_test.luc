#==============================================================================================
#
#   parser_test - What the parser accepts and rejects
#
#   DESCRIPTION:
#       1.0 source fixtures in, syntax trees (or stable diagnostics) out.
#       Fixtures are tokenized by the test-local helpers below before they reach
#       the parser, and the sections walk the grammar the same way the parser
#       does: declarations, statements, types and expressions, then rejects.
#
#==============================================================================================

from luce.compiler.parser import Parser
from luce.compiler.syntax import ExpressionForm, ExpressionSyntax, FunctionSyntax, ModuleSyntax
from luce.compiler.syntax import NominalTypeKind, StatementSyntax, SuiteStyle, SuiteSyntax
from luce.compiler.tokenizer import Tokenizer

# mark: Test helpers ========================================================================

pub func parse_source(source: str) -> ModuleSyntax!:
    let tokens = try Tokenizer(source).tokenize()
    return try Parser(tokens).parse()

pub func parsed(source: str) -> ModuleSyntax:
    let module = parse_source(source) catch reason:
        trap(reason)
    return module

pub func failure(source: str) -> str:
    let module = parse_source(source) catch reason:
        return reason
    return ""

pub func parses(source: str) -> bool:
    return len(failure(source)) == 0

pub func function_body(function_value: FunctionSyntax) -> SuiteSyntax:
    return function_value.body else trap("expected a function body")

pub func first_function(module: ModuleSyntax) -> FunctionSyntax:
    match module.declarations[0].value:
        Function(value): return value
        else: trap("expected the first declaration to be a function")

pub func binding_expression(statement: StatementSyntax) -> ExpressionSyntax:
    match statement.form:
        Binding(is_mutable, pattern, annotation, value): return value
        else: trap("expected a binding statement")

# A binding pattern's source text, whichever shape it takes.
pub func binding_pattern_text(source: str, statement: StatementSyntax) -> str:
    match statement.form:
        Binding(is_mutable, pattern, annotation, value):
            match pattern:
                TupleNames(values, pattern_span): return source[i64(pattern_span.start):i64(pattern_span.end)]
                Name(name, pattern_span): return source[i64(pattern_span.start):i64(pattern_span.end)]
        else: trap("expected a binding statement")

pub func binding_syntax(module: ModuleSyntax, index: i64) -> ExpressionSyntax:
    match module.declarations[index].value:
        Constant(value): return value.value
        else: trap("expected a constant declaration")

pub func binding_of(module: ModuleSyntax, index: i64) -> ExpressionForm:
    return binding_syntax(module, index).form


# mark: Modules and declarations ============================================================

pub func test_empty_module_has_an_empty_source_span():
    let module = parsed("")
    assert(len(module.imports) == 0)
    assert(len(module.declarations) == 0)
    assert(module.span.start == 0)
    assert(module.span.end == 0)

pub func test_imports_precede_declarations_and_preserve_paths():
    let source = "import compiler.syntax\nimport platform.files as files\nfrom compiler.tokenizer import Token, TokenKind\nlet answer = 42\n"
    let module = parsed(source)
    assert(len(module.imports) == 3)
    assert(len(module.imports[0].path.parts) == 2)
    assert(module.imports[0].path.parts[1] == "syntax")
    assert(len(module.imports[0].names) == 0)
    assert(module.imports[0].alias_name == none)
    assert((module.imports[1].alias_name else "") == "files")
    assert(len(module.imports[2].names) == 2)
    assert(module.imports[2].names[0].name == "Token")
    assert(module.imports[2].names[1].name == "TokenKind")
    assert(module.imports[2].alias_name == none)
    assert(len(module.declarations) == 1)
    assert(i64(module.span.end) == len(source))

pub func test_documentation_visibility_and_inline_function_body_are_preserved():
    let source = "## Return the input.\n## This stays Markdown.\npub func identity(value: i64) -> i64: return value\n"
    let module = parsed(source)
    let declaration = module.declarations[0]
    assert(declaration.is_public)
    assert(len(declaration.documentation) == 2)
    assert(declaration.documentation[0] == "Return the input.")
    assert(declaration.span.line == 3)
    let function_value = first_function(module)
    let body = function_body(function_value)
    assert(function_value.name == "identity")
    assert(len(function_value.parameters) == 1)
    assert(body.style == SuiteStyle.inline_suite)
    assert(str(body.statements[0].form) == "ReturnStatement")

pub func test_declarations_and_fields_are_private_by_default():
    let source = "func helper(): return\npub func api(): return\nstruct Settings:\n    let secret: str\n    pub let label: str\n"
    let module = parsed(source)
    assert(not module.declarations[0].is_public)
    assert(module.declarations[1].is_public)
    assert(not module.declarations[2].is_public)
    match module.declarations[2].value:
        NominalType(value):
            assert(not value.members[0].is_public)
            assert(value.members[1].is_public)
        else: assert(false)

pub func test_constants_and_type_aliases_have_distinct_declarations():
    let module = parsed("let maximum: u64 = 100\ntype Identifier = u64\n")
    assert(str(module.declarations[0].value) == "Constant")
    assert(str(module.declarations[1].value) == "TypeAlias")
    match module.declarations[0].value:
        Constant(value):
            assert(value.name == "maximum")
            assert(value.annotation != none)
            assert(str(value.value.form) == "Literal")
        else: assert(false)

pub func test_underscore_prefixed_names_are_identifiers_not_wildcards():
    let module = parsed("func use(_value: i64): return\nlet _unused = 1\n")
    assert(len(module.declarations) == 2)
    assert(first_function(module).parameters[0].name == "_value")
    match module.declarations[1].value:
        Constant(value): assert(value.name == "_unused")
        else: assert(false)

pub func test_struct_and_class_members_keep_generics_fields_and_methods():
    let source = "struct Box[T: Equatable] implements Drawable:\n    ## Stored item.\n    pub let value: T\n    mutating func replace(self, next: T): self.value = next\nclass Node:\n    weak var parent: Node? = none\n    func init(self): return\n"
    let module = parsed(source)
    assert(len(module.declarations) == 2)
    match module.declarations[0].value:
        NominalType(value):
            assert(value.name == "Box")
            assert(len(value.generic_parameters) == 1)
            assert(len(value.generic_parameters[0].constraints) == 1)
            assert(len(value.interfaces) == 1)
            assert(len(value.members) == 2)
            assert(value.members[0].documentation[0] == "Stored item.")
        else: assert(false)
    match module.declarations[1].value:
        NominalType(value):
            assert(value.name == "Node")
            assert(len(value.members) == 2)
        else: assert(false)

pub func test_enum_cases_payloads_and_interface_signatures_parse():
    let source = "enum Shape:\n    ## A circle.\n    circle(radius: f64)\n    point\n    mutating func reset(self): return\ninterface Reader[T]:\n    ## Read bytes.\n    mutating func read(self, count: u64) -> bytes!\n"
    let module = parsed(source)
    match module.declarations[0].value:
        Enumeration(value):
            assert(len(value.cases) == 2)
            assert(value.cases[0].documentation[0] == "A circle.")
            assert(len(value.cases[0].payload) == 1)
            assert(value.cases[0].payload[0].name == "radius")
            assert(len(value.methods) == 1)
            match value.methods[0].value:
                Function(method): assert(method.is_mutating)
                else: assert(false)
        else: assert(false)
    match module.declarations[1].value:
        InterfaceType(value):
            assert(value.name == "Reader")
            assert(len(value.methods) == 1)
            match value.methods[0].value:
                Function(method): assert(method.is_mutating)
                else: assert(false)
        else: assert(false)

pub func test_tests_and_all_export_c_forms_parse():
    let source = "test \"round trip\": return\nexport c struct Pixel:\n    ## Red channel.\n    let red: u8\n    let green: u8\nexport c enum Status as u32:\n    ready = 1\n    stopped = 2\nexport c func add(left: i64, right: i64) -> i64: return left + right\n"
    let module = parsed(source)
    assert(len(module.declarations) == 4)
    assert(str(module.declarations[0].value) == "TestDeclaration")
    assert(str(module.declarations[1].value) == "ExportStruct")
    assert(str(module.declarations[2].value) == "ExportEnum")
    assert(str(module.declarations[3].value) == "ExportFunction")
    match module.declarations[1].value:
        ExportStruct(value):
            assert(len(value.fields) == 2)
            assert(value.fields[0].name == "red")
            assert(value.fields[0].documentation[0] == "Red channel.")
        else: assert(false)
    match module.declarations[2].value:
        ExportEnum(value):
            assert(value.representation == "u32")
            assert(len(value.cases) == 2)
        else: assert(false)

pub func test_exported_functions_keep_the_narrow_c_surface():
    assert(not parses("export c func identity[T](value: T) -> T: return value\n"))
    assert(not parses("export c struct Pixel:\n    pub let red: u8\n"))

pub func test_extern_declarations_parse_the_boundary_surface():
    let source = "extern type Window\nextern type Device = i32\nextern func SDL_GetError() -> str\nextern func SDL_CreateWindow(title: str, w: i32, h: i32, flags: u64) -> Window?\nextern func SDL_GetWindowSize(window: Window, out w: i32, out h: i32) -> bool\nextern blocking func SDL_Delay(ms: u32)\nextern var SDL_version_number: i32\nextern struct Rect:\n    x: i32\n    y: i32\n    w: i32\n    h: i32\n"
    let module = parsed(source)
    assert(len(module.declarations) == 8)
    match module.declarations[0].value:
        ExternType(value):
            assert(value.name == "Window")
            assert(value.representation == none)
        else: assert(false)
    match module.declarations[1].value:
        ExternType(value):
            assert(value.name == "Device")
            assert((value.representation else "") == "i32")
        else: assert(false)
    match module.declarations[2].value:
        ExternFunction(value):
            assert(len(value.parameters) == 0)
            assert(value.result != none)
        else: assert(false)
    match module.declarations[4].value:
        ExternFunction(value):
            assert(value.name == "SDL_GetWindowSize")
            assert(not value.is_blocking)
            assert(len(value.parameters) == 3)
            assert(not value.parameters[0].is_out)
            assert(value.parameters[1].is_out)
            assert(value.parameters[1].name == "w")
            assert(value.parameters[2].is_out)
        else: assert(false)
    match module.declarations[5].value:
        ExternFunction(value):
            assert(value.is_blocking)
            assert(value.result == none)
        else: assert(false)
    match module.declarations[6].value:
        ExternVariable(value): assert(value.name == "SDL_version_number")
        else: assert(false)
    match module.declarations[7].value:
        ExternStruct(value):
            assert(value.name == "Rect")
            assert(len(value.fields) == 4)
            assert(value.fields[0].name == "x")
        else: assert(false)

pub func test_cfunc_is_a_type_form_usable_anywhere_a_type_is():
    let source = "extern struct Callbacks:\n    on_event: cfunc(Event, i32) -> i32\ntype Handler = cfunc() -> unit\nextern func register(callback: cfunc(i32) -> i32) -> bool\nstruct Hooks:\n    let on_tick: cfunc(u64) -> unit\n"
    let module = parsed(source)
    assert(len(module.declarations) == 4)
    match module.declarations[0].value:
        ExternStruct(value):
            match value.fields[0].value_type.form:
                CFunctionType(parameters, result): assert(len(parameters) == 2)
                else: assert(false)
        else: assert(false)
    match module.declarations[1].value:
        TypeAlias(value):
            match value.value.form:
                CFunctionType(parameters, result): assert(len(parameters) == 0)
                else: assert(false)
        else: assert(false)
    # A bare `cfunc` without a parameter list stays an ordinary type name.
    let named = parsed("type Odd = cfunc\n")
    match named.declarations[0].value:
        TypeAlias(value): assert(str(value.value.form) == "Named")
        else: assert(false)


# mark: Statements and suites ===============================================================

pub func test_indented_function_body_preserves_simple_statement_kinds():
    let source = "func statements(value: i64):\n    let copy = value\n    var current: i64 = copy\n    current += 1\n    defer cleanup()\n    recover current\n    consume(current)\n    return current\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 7)
    assert(str(statements[0].form) == "Binding")
    assert(str(statements[1].form) == "Binding")
    assert(str(statements[2].form) == "Assignment")
    assert(str(statements[3].form) == "DeferStatement")
    assert(str(statements[4].form) == "RecoverStatement")
    assert(str(statements[5].form) == "ExpressionStatement")
    assert(str(statements[6].form) == "ReturnStatement")

pub func test_control_flow_statements_and_conditional_binding_parse():
    let source = "func control(optional: i64?, items: list[i64]):\n    if let value = optional:\n        return value\n    else: return 0\n    while ready: break\n    for item in items:\n        if item > 5: continue\n    match status:\n        .ready: return 1\n        _: return 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 4)
    assert(str(statements[0].form) == "IfStatement")
    assert(str(statements[1].form) == "WhileStatement")
    assert(str(statements[2].form) == "ForStatement")
    assert(str(statements[3].form) == "MatchStatement")


# mark: Types and expressions ===============================================================

pub func test_function_tuple_optional_and_fallible_types_parse():
    let source = "type Pair = (i64, str)\ntype Callback = func(i64, list[Point?]) -> bytes!\ntype OptionalCallback = (func() -> unit)?\n"
    let module = parsed(source)
    assert(len(module.declarations) == 3)
    match module.declarations[2].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                OptionalType(optional_value):
                    match optional_value.form:
                        GroupedType(grouped): assert(str(grouped.form) == "FunctionType")
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_binary_operator_precedence_builds_the_expected_tree():
    let module = parsed("let value = 1 + 2 * 3 == 7 and true or false\n")
    match module.declarations[0].value:
        Constant(constant_value):
            match constant_value.value.form:
                Binary(or_left, or_operator, or_right):
                    assert(or_operator == "or")
                    match or_left.form:
                        Binary(and_left, and_operator, and_right):
                            assert(and_operator == "and")
                            match and_left.form:
                                Binary(compare_left, compare_operator, compare_right):
                                    assert(compare_operator == "==")
                                    match compare_left.form:
                                        Binary(add_left, add_operator, add_right):
                                            assert(add_operator == "+")
                                            assert(str(add_right.form) == "Binary")
                                        else: assert(false)
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_postfix_calls_distinguish_generic_arguments_from_indexing():
    let source = "func use(callbacks: list[Callback], index: u64):\n    let decoded = decode[Header](callbacks[index])\n    let invoked = callbacks[index](decoded)\n    let first = callbacks[0](decoded)\n    let range = callbacks[1..<index]\n    let prefix = callbacks[..<index]\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Call(callee, type_arguments, arguments):
            assert(len(type_arguments) == 1)
            assert(len(arguments) == 1)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Call(callee, type_arguments, arguments):
            assert(len(type_arguments) == 0)
            assert(str(callee.form) == "Index")
        else: assert(false)
    match binding_expression(statements[2]).form:
        Call(callee, type_arguments, arguments):
            assert(len(type_arguments) == 0)
            assert(str(callee.form) == "Index")
        else: assert(false)
    assert(str(binding_expression(statements[3]).form) == "Slice")
    assert(str(binding_expression(statements[4]).form) == "Slice")

pub func test_index_bounds_accept_full_expressions_and_inclusive_suffixes():
    let source = "func select(items: list[i64], index: u64):\n    let compared = items[index < limit]\n    let chosen = items[index if ready else limit]\n    let suffix = items[index..]\n"
    assert(parses(source))
    assert(not parses("func invalid(items: list[i64]): return items[1..2]\n"))
    assert(not parses("func invalid(items: list[i64]): return items[..]\n"))

pub func test_lambdas_keep_inferred_and_explicit_parameter_types():
    let source = "func predicates():\n    let inferred = (value) => value > 5\n    let typed = (left: i64, right: i64) => left < right\n    let empty = () => true\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Lambda(parameters, body):
            assert(len(parameters) == 1)
            assert(parameters[0].annotation == none)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Lambda(parameters, body):
            assert(len(parameters) == 2)
            assert(parameters[0].annotation != none)
        else: assert(false)
    match binding_expression(statements[2]).form:
        Lambda(parameters, body): assert(len(parameters) == 0)
        else: assert(false)

pub func test_closure_captures_and_catch_handlers_are_source_nodes():
    let source = "func build(count: i64, owner: Owner):\n    let callback = func [copy snapshot = count, weak owner, weak self] (value: i64) -> i64:\n        return value + snapshot\n    let loaded = try load() catch failure:\n        recover none\n    return loaded\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Closure(captures, parameters, result, body):
            assert(len(captures) == 3)
            assert(captures[0].name == "snapshot")
            assert(captures[1].is_weak)
            assert(captures[2].name == "self")
            assert(captures[2].is_weak)
        else: assert(false)
    assert(str(binding_expression(statements[1]).form) == "CatchValue")

pub func test_match_expression_uses_value_arms_and_match_statement_uses_suites():
    let source = "func digit(c: char) -> i64:\n    let value = match c:\n        '0' => 0\n        _ => 1\n    match value:\n        0: return 0\n        _: return value\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        MatchValue(subject, arms): assert(len(arms) == 2)
        else: assert(false)
    assert(str(statements[1].form) == "MatchStatement")

pub func test_match_patterns_preserve_ranges_and_comma_separated_alternatives():
    let source = "func classify(c: char):\n    let kind: str = match c:\n        '0'..='9' => \"digit\"\n        'a'..='z', 'A'..='Z' => \"letter\"\n        _ => \"other\"\n    match kind:\n        \"digit\", \"letter\": return true\n        _: return false\n"
    let statements = function_body(first_function(parsed(source))).statements
    match binding_expression(statements[0]).form:
        MatchValue(subject, arms):
            assert(len(arms) == 3)
            assert(len(arms[0].patterns) == 1)
            match arms[0].patterns[0]:
                RangePattern(lower, operator, upper, span):
                    assert(lower.token.text == "'0'")
                    assert(not lower.is_negative)
                    assert(operator == "..=")
                    assert(upper.token.text == "'9'")
                else: assert(false)
            assert(len(arms[1].patterns) == 2)
            match arms[1].patterns[0]:
                RangePattern(lower, operator, upper, span): assert(operator == "..=")
                else: assert(false)
        else: assert(false)
    match statements[1].form:
        MatchStatement(subject, arms):
            assert(len(arms) == 2)
            assert(len(arms[0].patterns) == 2)
            assert(str(arms[0].patterns[0]) == "Literal")
            assert(str(arms[0].patterns[1]) == "Literal")
        else: assert(false)

pub func test_negative_numeric_patterns_preserve_their_signs():
    let source = "func classify(value: i64):\n    match value:\n        -10..=-1, -20: return true\n        _: return false\n"
    let statements = function_body(first_function(parsed(source))).statements
    match statements[0].form:
        MatchStatement(subject, arms):
            match arms[0].patterns[0]:
                RangePattern(lower, operator, upper, span):
                    assert(lower.is_negative)
                    assert(lower.token.text == "10")
                    assert(upper.is_negative)
                    assert(upper.token.text == "1")
                else: assert(false)
            match arms[0].patterns[1]:
                Literal(value):
                    assert(value.is_negative)
                    assert(value.token.text == "20")
                else: assert(false)
        else: assert(false)

    assert(
        failure("func invalid(value: char):\n    match value:\n        -'a': return\n")
        == "3:10: expected a numeric literal after `-` in a pattern"
    )

pub func test_case_payload_commas_remain_distinct_from_arm_alternatives():
    let source = "func handle(command: Command):\n    match command:\n        .resize(width, height), .move(width, height): return width + height\n        .quit: return 0\n"
    let statements = function_body(first_function(parsed(source))).statements
    match statements[0].form:
        MatchStatement(subject, arms):
            assert(len(arms[0].patterns) == 2)
            match arms[0].patterns[0]:
                CasePattern(name, bindings, span):
                    assert(name == "resize")
                    assert(len(bindings) == 2)
                else: assert(false)
            match arms[0].patterns[1]:
                CasePattern(name, bindings, span): assert(name == "move")
                else: assert(false)
        else: assert(false)

pub func test_block_expression_ends_before_a_following_if_statement():
    let source = "func classify(value: i64) -> i64:\n    let result = match value:\n        0 => 0\n        _ => 1\n    if value > 0: return result\n    return -1\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(len(statements) == 3)
    assert(str(statements[0].form) == "Binding")
    assert(str(statements[1].form) == "IfStatement")
    assert(str(statements[2].form) == "ReturnStatement")

pub func test_else_fallback_binds_below_or_and_takes_expression_arms():
    let module = parsed("let count = parse_i64(text) else 0\nlet ready = a or b else c\nlet w = create_window() else error(\"no window\")\nlet n = parse_i64(text) else trap(\"not a number\")\n")
    match binding_of(module, 0):
        ElseValue(value, arm):
            assert(str(value.form) == "Call")
            assert(str(arm.form) == "Literal")
        else: assert(false)
    match binding_of(module, 1):
        ElseValue(value, arm):
            match value.form:
                Binary(left, operator, right): assert(operator == "or")
                else: assert(false)
        else: assert(false)
    match binding_of(module, 2):
        ElseValue(value, arm): assert(str(arm.form) == "Call")
        else: assert(false)
    match binding_of(module, 3):
        ElseValue(value, arm): assert(str(arm.form) == "Call")
        else: assert(false)

pub func test_else_fallback_chains_and_stays_distinct_from_the_conditional():
    let module = parsed("let value = first() else second() else 0\nlet chosen = value if ready else other else fallback\n")
    match binding_of(module, 0):
        ElseValue(value, arm):
            assert(str(value.form) == "Call")
            match arm.form:
                ElseValue(inner_value, inner_arm): assert(str(inner_arm.form) == "Literal")
                else: assert(false)
        else: assert(false)
    match binding_of(module, 1):
        ElseValue(value, arm):
            assert(str(value.form) == "Conditional")
            assert(str(arm.form) == "Name")
        else: assert(false)

pub func test_primary_and_conditional_expression_families_parse():
    let source = "func values(index: u64):\n    let tuple = (1, 2)\n    let list_value = [1, 2]\n    let map_value = {\"one\": 1}\n    let case_value = .ready(index: index)\n    let object = new Widget(value: index)\n    let task_value = spawn workers.render(index)\n    return -index if index > 0 else 0\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    assert(str(binding_expression(statements[0]).form) == "TupleValue")
    assert(str(binding_expression(statements[1]).form) == "ListValue")
    assert(str(binding_expression(statements[2]).form) == "MapValue")
    assert(str(binding_expression(statements[3]).form) == "CaseValue")
    assert(str(binding_expression(statements[4]).form) == "NewValue")
    assert(str(binding_expression(statements[5]).form) == "SpawnValue")
    match statements[6].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            assert(str(returned.form) == "Conditional")
        else: assert(false)


# mark: Rejected syntax and diagnostics =====================================================

pub func test_imports_must_form_the_leading_module_prefix():
    assert(not parses("let value = 1\nimport later.module\n"))
    assert(not parses("let value = 1\nfrom later.module import value\n"))
    assert(not parses("from later.module import _\n"))
    assert(not parses("from later.module import value as alias\n"))
    assert(not parses("var global = 1\n"))

pub func test_documentation_must_be_consecutive_and_touch_a_declaration():
    assert(parses("## Summary.\nlet value = 1\n"))
    assert(not parses("## First.\n\n## Second.\n\nlet value = 1\n"))
    assert(not parses("let a = 1\n## Detached.\n\nlet value = 1\n"))
    assert(not parses("func run():\n    ## Not a local declaration.\n    return\n"))

pub func test_module_documentation_stands_apart_from_declarations():
    let detached = parsed("## Module summary.\n## More.\n\nlet value = 1\n")
    assert(len(detached.documentation) == 2)
    assert(detached.documentation[0] == "Module summary.")
    assert(len(detached.declarations[0].documentation) == 0)
    let before_import = parsed("## Module.\nimport std.strings\n## Constant.\nlet value = 1\n")
    assert(len(before_import.documentation) == 1)
    assert(before_import.declarations[0].documentation[0] == "Constant.")
    let alone = parsed("## Only docs.\n")
    assert(alone.documentation[0] == "Only docs.")
    let touching = parsed("## Constant.\nlet value = 1\n")
    assert(len(touching.documentation) == 0)
    assert(touching.declarations[0].documentation[0] == "Constant.")
    assert(not parses("## Module.\n\n## Not module.\n\nimport a\n"))
    assert(not parses("## Module.\n\n## Constant.\n\nlet value = 1\n"))
    assert(not parses("import a\n## Doc.\n"))

pub func test_empty_declaration_bodies_and_interface_fields_are_rejected():
    assert(not parses("struct Empty:\n"))
    assert(not parses("enum Empty:\n"))
    assert(not parses("interface Empty:\n"))
    assert(not parses("interface Invalid:\n    let value: i64\n"))
    assert(not parses("interface Invalid:\n    pub func value(self) -> i64\n"))

pub func test_parameter_tuple_and_lambda_shapes_follow_the_grammar():
    assert(not parses("func missing_type(value): return\n"))
    assert(not parses("func invalid(self = other): return\n"))
    assert(not parses("type Empty = list[]\n"))
    assert(not parses("let one = (1,)\n"))
    assert(not parses("let invalid = (value = 5) => value\n"))

pub func test_conditional_binding_and_same_line_suite_restrictions_are_enforced():
    assert(not parses("func invalid(optional: i64?):\n    if let value = optional: return value\n    elif retry: return 0\n"))
    assert(not parses("func invalid(ready: bool): if ready: return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: let callback = func(): return\n"))
    assert(not parses("func invalid(ready: bool):\n    if ready: return match value:\n        _ => 0\n"))

pub func test_match_arrows_distinguish_values_from_statement_suites():
    assert(parses("let value = match c:\n    '0' => 0\n    _ => 1\n"))
    assert(not parses("let value = match c:\n    '0': return 0\n"))
    assert(parses("func run(c: char):\n    match c:\n        '0': return\n"))
    assert(not parses("func run(c: char):\n    match c:\n        '0' => 0\n"))

pub func test_match_patterns_reject_incomplete_alternatives_and_ranges():
    assert(not parses("let value = match c:\n    '0', => 0\n"))
    assert(not parses("let value = match c:\n    '0'..= => 0\n"))
    assert(not parses("let value = match c:\n    '0'..'9' => 0\n"))
    assert(not parses("let value = match c:\n    ..<'9' => 0\n"))

pub func test_comparison_and_range_operators_cannot_chain():
    assert(not parses("let value = first < second < third\n"))
    assert(not parses("let value = first ..< second ..= third\n"))
    assert(parses("let value = first is not second\n"))

pub func test_not_before_comparison_requires_explicit_grouping():
    assert(
        failure("let value = not a == b\n")
        == "1:19: ambiguous `not` before comparison; write `not (a == b)` or `(not a) == b`"
    )
    assert(parses("let value = not (a == b)\n"))
    assert(parses("let value = (not a) == b\n"))

pub func test_assignment_requires_a_named_member_or_index_target():
    assert(parses("struct S:\n    func set(self, index: u64): self.items[index].ready = true\n"))
    assert(not parses("func invalid(): (left + right) = value\n"))
    assert(not parses("func invalid(): call() = value\n"))
    assert(not parses("func invalid(items: list[i64]): items[..<2] = []\n"))

pub func test_extern_declarations_keep_the_c_shape():
    assert(failure("extern func f(x: i32 = 1) -> i32\n") == "1:15: an extern parameter takes no default; the C shape is the whole truth")
    assert(failure("extern func g() -> i32!\n") == "1:23: an extern is not fallible; C reports failure in its return value, and the wrapper is where `!` lives")
    assert(failure("extern type Handle = f64\n") == "1:22: an extern type representation must be `u32`, `i32`, `u64`, or `i64`")
    assert(not parses("extern type Handle = u8\n"))
    assert(parses("extern type Handle = u64\n"))
    # `out` is contextual, so a parameter simply named `out` keeps its C shape.
    assert(parses("extern func f(out: i32) -> bool\n"))
    assert(not parses("extern func f(self) -> bool\n"))
    assert(not parses("extern func f() -> i32:\n    return 1\n"))
    assert(not parses("extern func f[T](value: T) -> T\n"))
    assert(not parses("extern struct Empty:\n"))
    assert(not parses("extern struct Bad:\n    let x: i32\n"))
    assert(not parses("extern struct Bad:\n    x: i32 = 0\n"))
    assert(not parses("extern let value: i32\n"))

pub func test_parser_diagnostics_report_the_first_token_position():
    assert(failure("let value =\n") == "1:12: expected an expression")
    assert(failure("pub test \"no\": return\n") == "1:1: a test declaration cannot use `pub`")


# mark: Spec-rule coverage: declarations ====================================================

pub func test_imports_reject_malformed_shapes():
    assert(parses("import a.b.c\nfrom a import x\n"))
    assert(not parses("import a as\n"))
    assert(not parses("import\n"))
    assert(not parses("from a.b import\n"))
    assert(not parses("from a.b import x,\n"))
    assert(not parses("import a.\n"))
    assert(not parses("import a b\n"))

pub func test_top_level_forms_reject_locals_nesting_and_generic_aliases():
    assert(not parses("let (a, b) = pair()\n"))
    assert(not parses("let value\n"))
    assert(not parses("type Pair[T] = (T, T)\n"))
    assert(not parses("    let value = 1\n"))
    assert(not parses("run()\n"))
    assert(not parses("if ready: run()\n"))
    assert(not parses("func outer():\n    func inner(): return\n"))
    assert(not parses("func outer():\n    struct Inner:\n        let x: i64\n"))
    assert(not parses("mutating struct Bad:\n    let x: i64\n"))
    assert(not parses("pub export c func f(): return\n"))
    assert(not parses("export cpp func f(): return\n"))
    assert(not parses("export c type X = i64\n"))
    assert(not parses("let value = 1 trailing\n"))

pub func test_function_signature_details_parse():
    let source = "pub func render[T: Drawable & Hashable, U](scene: T, samples: u32 = 64, flags: list[U] = [],) -> Image?!:\n    return none\n"
    let function_value = first_function(parsed(source))
    assert(len(function_value.generic_parameters) == 2)
    assert(len(function_value.generic_parameters[0].constraints) == 2)
    assert(len(function_value.generic_parameters[1].constraints) == 0)
    assert(len(function_value.parameters) == 3)
    assert(function_value.parameters[0].default_value == none)
    assert(function_value.parameters[1].default_value != none)
    match (function_value.result else trap("expected a result")).form:
        FallibleType(inner): assert(str(inner.form) == "OptionalType")
        else: assert(false)

pub func test_function_signature_rejections():
    assert(not parses("func f[](): return\n"))
    assert(not parses("func f[T: A &](): return\n"))
    assert(not parses("func f(self: Type): return\n"))
    assert(failure("func f(self): return\n") == "1:8: `self` is the receiver of a method; only a type member declares it")
    assert(failure("mutating func f(): return\n") == "1:1: `mutating` marks a value method; a module function has no receiver")
    assert(not parses("let v = func (self): return\n"))
    assert(parses("struct S:\n    mutating func f(self): return\nenum E:\n    a\n    func f(self): return\ninterface I:\n    func f(self)\n"))
    assert(not parses("func f() uses files: return\n"))
    assert(not parses("func f() -> : return\n"))
    assert(not parses("func f():\n"))
    assert(not parses("func f()\n"))
    assert(not parses("func f(a: i64 b: i64): return\n"))
    assert(not parses("func (): return\n"))
    assert(not parses("mutating let value = 1\n"))

pub func test_struct_and_class_member_rejections():
    assert(parses("struct S:\n    weak let owner: Node?\n    var count: i64 = 0\n    pub func f(self): return\n"))
    assert(not parses("struct S:\n    weak func f(self): return\n"))
    assert(not parses("struct S:\n    value: i64\n"))
    assert(not parses("struct S:\n    let value\n"))
    assert(not parses("struct S:\n    let value: i64\n    run()\n"))
    assert(not parses("struct S: let value: i64\n"))
    assert(not parses("struct S implements:\n    let value: i64\n"))
    assert(not parses("struct S implements A,:\n    let value: i64\n"))
    assert(parses("class C implements std.Hashable, Equatable[C]:\n    let value: i64\n"))

pub func test_enum_shape_rules():
    let source = "pub enum Shape[T] implements Drawable:\n    circle(radius: f64, center: T,)\n    empty()\n    point\n    pub func area(self) -> f64: return 0.0\n    mutating func grow(self): return\n"
    match parsed(source).declarations[0].value:
        Enumeration(value):
            assert(len(value.generic_parameters) == 1)
            assert(len(value.interfaces) == 1)
            assert(len(value.cases) == 3)
            assert(len(value.cases[0].payload) == 2)
            assert(len(value.cases[1].payload) == 0)
            assert(len(value.methods) == 2)
            assert(value.methods[0].is_public)
        else: assert(false)
    assert(failure("enum E:\n    pub ready\n") == "2:5: enum cases inherit visibility; remove `pub`")
    assert(failure("enum E:\n    func f(self): return\n    ready\n") == "3:5: enum cases must precede enum methods")
    assert(not parses("enum E:\n    func f(self): return\n"))
    assert(not parses("enum E:\n    let value: i64\n"))
    assert(not parses("enum E:\n    ready(radius)\n"))
    assert(not parses("enum E:\n    ready = 1\n"))

pub func test_interface_shape_rules():
    let source = "interface Reader[T]:\n    func read(self, count: u64) -> bytes!\n    mutating func reset(self)\n"
    match parsed(source).declarations[0].value:
        InterfaceType(value):
            assert(len(value.methods) == 2)
            match value.methods[0].value:
                Function(method):
                    assert(method.body == none)
                else: assert(false)
        else: assert(false)
    assert(not parses("interface I:\n    func f(self): return\n"))
    assert(not parses("interface I implements J:\n    func f(self)\n"))
    assert(not parses("interface I:\n    weak var x: i64\n"))

pub func test_test_declaration_rules():
    let source = "test \"reads\":\n    let text = try files.read_text(\"settings.luce\")\n    assert(text == \"theme = dark\")\n"
    match parsed(source).declarations[0].value:
        TestDeclaration(value):
            assert(value.description.text == "\"reads\"")
            assert(len(value.body.statements) == 2)
        else: assert(false)
    assert(not parses("test: return\n"))
    assert(not parses("test \"x\" uses files: return\n"))
    assert(not parses("test name: return\n"))
    assert(not parses("test \"x\" [T]: return\n"))
    assert(not parses("test \"x\"(): return\n"))
    assert(not parses("test \"x\":\n"))

pub func test_export_c_rejections():
    assert(not parses("export c struct P:\n    var red: u8\n"))
    assert(not parses("export c struct P:\n    let red: u8 = 0\n"))
    assert(not parses("export c struct P:\n    red: u8\n"))
    assert(not parses("export c struct P:\n"))
    assert(not parses("export c enum S as u32:\n"))
    assert(not parses("export c enum S as u32:\n    ready\n"))
    assert(not parses("export c enum S as u32:\n    ready = \"1\"\n"))
    assert(not parses("export c enum S:\n    ready = 1\n"))
    assert(not parses("export c func f(self): return\n"))
    assert(not parses("export c func f() -> i64\n"))
    assert(parses("export c func f(a: i64 = 1): return\n"))

pub func test_extern_declarations_compose_with_visibility_and_reject_bodies():
    let module = parsed("pub extern type Window\npub extern func f() -> i32\npub extern var g: i32\npub extern struct R:\n    x: i32\n")
    assert(len(module.declarations) == 4)
    assert(module.declarations[0].is_public)
    assert(module.declarations[1].is_public)
    assert(module.declarations[2].is_public)
    assert(module.declarations[3].is_public)
    assert(not parses("extern blocking var g: i32\n"))
    assert(not parses("extern blocking type W\n"))
    assert(not parses("extern var g: i32 = 1\n"))
    assert(not parses("extern var g\n"))
    assert(not parses("extern type W = \n"))
    assert(not parses("extern struct R:\n    x: i32\n    func f(self): return\n"))
    assert(not parses("extern func f(out w)\n"))
    assert(parses("extern func f(out out: i32)\n"))
    assert(parses("extern func f(out out: i32)\n"))

pub func test_documentation_attaches_to_members_and_rejects_stray_placement():
    let module = parsed("## Type.\npub struct S:\n    ## Field.\n    pub let x: i64\n    ## Method.\n    func f(self): return\n")
    match module.declarations[0].value:
        NominalType(value):
            assert(value.members[0].documentation[0] == "Field.")
            assert(value.members[1].documentation[0] == "Method.")
        else: assert(false)
    assert(parses("##No space.\nlet v = 1\n"))
    assert(parsed("##No space.\nlet v = 1\n").declarations[0].documentation[0] == "No space.")
    assert(parses("## Trailing module doc.\n"))
    assert(not parses("import a\n## Doc.\n"))
    assert(not parses("enum E:\n    ready\n    ## Lost.\n"))


# mark: Spec-rule coverage: statements ======================================================

pub func test_every_assignment_operator_is_a_statement():
    let operators: list[str] = ["=", "+=", "-=", "*=", "/=", "//=", "%=", "&=", "|=", "^=", "<<=", ">>="]
    for operator in operators:
        let module = parsed("func f():\n    x " + operator + " 1\n")
        match function_body(first_function(module)).statements[0].form:
            Assignment(target, found, value): assert(found == operator)
            else: assert(false)
    assert(not parses("func f(): x == 1 = 2\n"))
    assert(not parses("func f(): x = \n"))
    assert(not parses("func f(): x += y += 1\n"))
    assert(not parses("func f(): (a, b) = pair()\n"))

pub func test_tuple_bindings_follow_the_grammar():
    let source = "func f():\n    let (q, r) = divide(17, 5)\n    var (a, b, c,): (i64, i64, i64) = triple()\n    let single = 1\n"
    let module = parsed(source)
    let statements = function_body(first_function(module)).statements
    match statements[0].form:
        Binding(is_mutable, pattern, annotation, value):
            assert(not is_mutable)
            assert(str(pattern) == "TupleNames")
        else: assert(false)
    assert(binding_pattern_text(source, statements[0]) == "(q, r)")
    match statements[1].form:
        Binding(is_mutable, pattern, annotation, value):
            assert(is_mutable)
            assert(annotation != none)
            assert(str(pattern) == "TupleNames")
        else: assert(false)
    assert(binding_pattern_text(source, statements[1]) == "(a, b, c,)")
    assert(binding_pattern_text(source, statements[2]) == "single")
    assert(not parses("func f():\n    let (a) = x\n"))
    assert(not parses("func f():\n    let (a, 1) = x\n"))
    assert(not parses("func f():\n    let (a, b) = \n"))
    assert(not parses("func f():\n    let a: = 1\n"))
    assert(not parses("func f():\n    let a\n"))

pub func test_branching_and_loops_reject_malformed_headers():
    assert(parses("func f():\n    if a: return\n    elif b: return\n    elif c:\n        return\n    else:\n        return\n"))
    assert(not parses("func f():\n    if a: return\n    else if b: return\n"))
    assert(not parses("func f():\n    else: return\n"))
    assert(not parses("func f():\n    elif a: return\n"))
    assert(not parses("func f():\n    if a return\n"))
    assert(not parses("func f():\n    if: return\n"))
    assert(not parses("func f():\n    if let a: return\n"))
    assert(not parses("func f():\n    if let a = : return\n"))
    assert(not parses("func f():\n    while let a = b: return\n"))
    assert(not parses("func f():\n    for a b: return\n"))
    assert(not parses("func f():\n    for (a, b) in c: return\n"))
    assert(not parses("func f():\n    for a in : return\n"))
    assert(not parses("func f():\n    for in c: return\n"))
    assert(not parses("func f():\n    break 1\n"))
    assert(not parses("func f():\n    continue now\n"))
    assert(not parses("func f():\n    defer\n"))
    assert(not parses("func f():\n    recover\n"))

pub func test_suites_reject_empty_and_misindented_bodies():
    assert(not parses("func f():\n    if a:\n    return\n"))
    assert(not parses("func f():\n    if a:\n\n    return\n"))
    assert(not parses("func f():\n    while a:\n"))
    assert(not parses("func f():\n    return\n  return\n"))
    assert(failure("func f():\n") == "2:1: expected indented suite")

pub func test_inline_suites_hold_one_simple_statement():
    assert(parses("func f():\n    if a: x = 1\n    for i in xs: total += i\n    while a: break\n    match a:\n        _: continue\n"))
    assert(not parses("func f():\n    if a: return; b\n"))
    assert(not parses("func f():\n    if a: let v = load() catch e:\n        recover 0\n"))
    assert(not parses("func f():\n    match a:\n        _: if b: return\n"))
    assert(not parses("func f():\n    match a:\n        _: while b: return\n"))
    assert(not parses("func f():\n    match a:\n        _: for b in c: return\n"))
    assert(not parses("func f():\n    match a:\n        _: match b:\n            _: return\n"))

pub func test_match_statement_arms_take_full_suites():
    let source = "func f(command: Command):\n    match command:\n        .open(path): open_document(path)\n        .save(path):\n            validate_destination(path)\n            if dirty:\n                save_document(path)\n        .quit: return\n"
    match function_body(first_function(parsed(source))).statements[0].form:
        MatchStatement(subject, arms):
            assert(len(arms) == 3)
            assert(arms[0].body.style == SuiteStyle.inline_suite)
            assert(arms[1].body.style == SuiteStyle.indented_suite)
            assert(len(arms[1].body.statements) == 2)
            match arms[0].patterns[0]:
                CasePattern(name, bindings, pattern_span): assert(bindings[0] == "path")
                else: assert(false)
            match arms[2].patterns[0]:
                CasePattern(name, bindings, pattern_span): assert(len(bindings) == 0)
                else: assert(false)
        else: assert(false)
    assert(not parses("func f():\n    match a:\n"))
    assert(not parses("func f():\n    match a: _: return\n"))
    assert(not parses("func f():\n    match a:\n        _: return\n        _\n"))
    assert(not parses("func f():\n    match a:\n        .case(a, 1): return\n"))
    assert(parses("func f():\n    match a:\n        .case(): return\n"))
    assert(not parses("func f():\n    match a:\n        name: return\n"))
    assert(not parses("func f():\n    match a:\n        .a.b: return\n"))
    assert(not parses("func f():\n    match a:\n        (1, 2): return\n"))
    assert(not parses("func f():\n    match a:\n        1 if a: return\n"))

pub func test_literal_patterns_cover_every_literal_family():
    let source = "func f(v: Any):\n    match v:\n        true, false, none: return\n        \"text\", 'c', 1.5, 0xff, b\"bytes\": return\n        -1.5..<2.5: return\n        _: return\n"
    match function_body(first_function(parsed(source))).statements[0].form:
        MatchStatement(subject, arms):
            assert(len(arms[0].patterns) == 3)
            assert(len(arms[1].patterns) == 5)
            match arms[2].patterns[0]:
                RangePattern(lower, operator, upper, range_span):
                    assert(lower.is_negative)
                    assert(operator == "..<")
                else: assert(false)
        else: assert(false)
    assert(not parses("func f():\n    match a:\n        -true: return\n"))
    assert(not parses("func f():\n    match a:\n        --1: return\n"))
    assert(not parses("func f():\n    match a:\n        _..<1: return\n"))
    assert(not parses("func f():\n    match a:\n        1..<_: return\n"))
    assert(not parses("func f():\n    match a:\n        1..<2..<3: return\n"))


# mark: Spec-rule coverage: types ===========================================================

pub func test_type_forms_compose_and_nest():
    let source = "type A = map[str, list[Point?]]\ntype B = array[u8, 4]\ntype C = native.file_handle\ntype D = func(func(i64) -> bool, (i64, str)) -> unit\ntype E = ((i64))\ntype F = list[i64]!\ntype G = (i64, str, bool,)\ntype H = func() -> i64?\ntype I = Box[array[u8, 16]]\n"
    let module = parsed(source)
    assert(len(module.declarations) == 9)
    match module.declarations[1].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                Applied(path, arguments):
                    assert(str(arguments[0]) == "TypeArgument")
                    assert(str(arguments[1]) == "IntegerArgument")
                else: assert(false)
        else: assert(false)
    match module.declarations[2].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                Named(path): assert(path.dotted() == "native.file_handle")
                else: assert(false)
        else: assert(false)
    match module.declarations[6].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                TupleType(elements): assert(len(elements) == 3)
                else: assert(false)
        else: assert(false)
    match module.declarations[7].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                FunctionType(parameters, result):
                    assert(str(result.form) == "OptionalType")
                else: assert(false)
        else: assert(false)

pub func test_type_form_rejections():
    assert(not parses("type T = i64!?\n"))
    assert(not parses("type T = i64??\n"))
    assert(not parses("type T = (i64,)\n"))
    assert(not parses("type T = ()\n"))
    assert(not parses("type T = list[i64\n"))
    assert(not parses("type T = list[,]\n"))
    assert(not parses("type T = array[u8, -1]\n"))
    assert(not parses("type T = array[u8, 1.5]\n"))
    assert(not parses("type T = func(i64)\n"))
    assert(not parses("type T = func -> i64\n"))
    assert(not parses("type T = func() -> i64 uses files\n"))
    assert(not parses("type T = 1\n"))
    assert(not parses("type T = i64.\n"))
    assert(not parses("type T = weak Node\n"))
    assert(not parses("type T = list[func]\n"))


# mark: Spec-rule coverage: expressions =====================================================

pub func operator_of(module: ModuleSyntax, index: i64) -> str:
    match binding_of(module, index):
        Binary(left, operator, right): return operator
        Unary(operator, operand): return operator
        else: return ""

pub func test_full_precedence_ladder_from_loosest_to_tightest():
    let module = parsed("let v = a or b and c == d ..< e | f ^ g & h << i + j * k\n")
    match binding_of(module, 0):
        Binary(l1, o1, r1):
            assert(o1 == "or")
            match r1.form:
                Binary(l2, o2, r2):
                    assert(o2 == "and")
                    match r2.form:
                        Binary(l3, o3, r3):
                            assert(o3 == "==")
                            match r3.form:
                                Binary(l4, o4, r4):
                                    assert(o4 == "..<")
                                    match r4.form:
                                        Binary(l5, o5, r5):
                                            assert(o5 == "|")
                                            match r5.form:
                                                Binary(l6, o6, r6):
                                                    assert(o6 == "^")
                                                    match r6.form:
                                                        Binary(l7, o7, r7):
                                                            assert(o7 == "&")
                                                            match r7.form:
                                                                Binary(l8, o8, r8):
                                                                    assert(o8 == "<<")
                                                                    match r8.form:
                                                                        Binary(l9, o9, r9):
                                                                            assert(o9 == "+")
                                                                            assert(str(r9.form) == "Binary")
                                                                        else: assert(false)
                                                                else: assert(false)
                                                        else: assert(false)
                                                else: assert(false)
                                        else: assert(false)
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_same_level_operators_associate_left():
    let module = parsed("let v = a - b - c\nlet w = a / b * c % d\nlet x = a << b >> c\n")
    match binding_of(module, 0):
        Binary(left, operator, right):
            assert(operator == "-")
            assert(str(left.form) == "Binary")
            assert(str(right.form) == "Name")
        else: assert(false)
    match binding_of(module, 1):
        Binary(left, operator, right):
            assert(operator == "%")
            assert(str(left.form) == "Binary")
        else: assert(false)
    match binding_of(module, 2):
        Binary(left, operator, right): assert(operator == ">>")
        else: assert(false)

pub func test_unary_operators_bind_tighter_than_binary_and_stack():
    let module = parsed("let a = try f() + 1\nlet b = not x and y\nlet c = - -x\nlet d = ~x | +y\nlet e = -x.y[0]\n")
    match binding_of(module, 0):
        Binary(left, operator, right):
            assert(operator == "+")
            match left.form:
                Unary(unary_operator, operand):
                    assert(unary_operator == "try")
                    assert(str(operand.form) == "Call")
                else: assert(false)
        else: assert(false)
    assert(operator_of(module, 1) == "and")
    match binding_of(module, 2):
        Unary(operator, operand): assert(str(operand.form) == "Unary")
        else: assert(false)
    assert(operator_of(module, 3) == "|")
    match binding_of(module, 4):
        Unary(operator, operand): assert(str(operand.form) == "Index")
        else: assert(false)
    assert(not parses("let v = a + \n"))
    assert(not parses("let v = * a\n"))
    assert(not parses("let v = a b\n"))
    assert(not parses("let v = a is\n"))
    assert(not parses("let v = a not b\n"))
    assert(not parses("let v = a == b is c\n"))
    assert(parses("let v = a ..< b < c ..< d\n"))

pub func test_conditional_expression_is_right_associative_and_needs_else():
    let module = parsed("let v = a if b else c if d else e\n")
    match binding_of(module, 0):
        Conditional(value, condition, alternative):
            assert(str(value.form) == "Name")
            assert(str(alternative.form) == "Conditional")
        else: assert(false)
    assert(not parses("let v = a if b\n"))
    assert(not parses("let v = a if b else\n"))
    assert(not parses("let v = if b else c\n"))
    assert(not parses("let v = a if b if c else d else e\n"))

pub func test_catch_and_else_are_the_loosest_layers():
    let module = parsed("func f():\n    let v = a or b else c catch failure:\n        recover 0\n    return try g() catch e: recover none\n")
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        CatchValue(value, failure_name, body):
            assert(failure_name == "failure")
            assert(str(value.form) == "ElseValue")
            assert(body.style == SuiteStyle.indented_suite)
        else: assert(false)
    match statements[1].form:
        ReturnStatement(value):
            let returned = value else trap("expected a value")
            match returned.form:
                CatchValue(inner, failure_name, body): assert(body.style == SuiteStyle.inline_suite)
                else: assert(false)
        else: assert(false)
    assert(not parses("func f():\n    let v = g() catch:\n        recover 0\n"))
    assert(not parses("func f():\n    let v = g() catch e\n"))
    assert(not parses("func f():\n    let v = g() catch e:\n"))
    assert(not parses("func f():\n    let v = g() catch e: recover 0 catch e2: recover 1\n"))
    assert(not parses("let v = a else\n"))

pub func test_postfix_chains_and_argument_shapes():
    let module = parsed("func f():\n    let v = self.items[0].render(scene, samples: 256,)(x)[1..<2]\n    let w = std.decode[Header](data)\n    let x = array[u8, 4]()\n    let y = .none\n    let z = new Box[i64](1)\n    let empty = ()\n")
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Slice(value, start, operator, end):
            match value.form:
                Call(callee, type_arguments, arguments):
                    assert(len(arguments) == 1)
                    match callee.form:
                        Call(inner_callee, inner_types, inner_arguments):
                            assert(len(inner_arguments) == 2)
                            assert(inner_arguments[0].label == none)
                            assert((inner_arguments[1].label else "") == "samples")
                            assert(str(inner_callee.form) == "Member")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Call(callee, type_arguments, arguments):
            assert(len(type_arguments) == 1)
            match callee.form:
                Member(value, name): assert(name == "decode")
                else: assert(false)
        else: assert(false)
    match binding_expression(statements[2]).form:
        Call(callee, type_arguments, arguments): assert(len(type_arguments) == 2)
        else: assert(false)
    match binding_expression(statements[3]).form:
        CaseValue(name, arguments): assert(len(arguments) == 0)
        else: assert(false)
    match binding_expression(statements[4]).form:
        NewValue(value_type, arguments): assert(str(value_type.form) == "Applied")
        else: assert(false)
    match binding_expression(statements[5]).form:
        TupleValue(elements): assert(len(elements) == 0)
        else: assert(false)
    assert(not parses("let v = f(,)\n"))
    assert(not parses("let v = f(a:)\n"))
    assert(not parses("let v = f(a: b: c)\n"))
    assert(not parses("let v = a.\n"))
    assert(not parses("let v = a.1\n"))
    assert(not parses("let v = a[]\n"))
    assert(not parses("let v = a[1, 2]\n"))
    assert(not parses("let v = new\n"))
    assert(not parses("let v = new Box\n"))
    assert(not parses("let v = spawn (f)(1)\n"))
    assert(not parses("let v = spawn f\n"))
    assert(not parses("let v = spawn f.g[T](1)\n"))
    assert(not parses("let v = .\n"))
    assert(parses("let v = .case.member\n"))

pub func test_collection_literals_and_their_rejections():
    let module = parsed("let a = [1, 2,]\nlet b = []\nlet c = {\"k\": 1, \"j\": 2,}\nlet d = (1, 2,)\nlet e = ((1))\n")
    match binding_of(module, 0):
        ListValue(elements): assert(len(elements) == 2)
        else: assert(false)
    match binding_of(module, 1):
        ListValue(elements): assert(len(elements) == 0)
        else: assert(false)
    match binding_of(module, 2):
        MapValue(entries): assert(len(entries) == 2)
        else: assert(false)
    match binding_of(module, 3):
        TupleValue(elements): assert(len(elements) == 2)
        else: assert(false)
    match binding_of(module, 4):
        Group(value): assert(str(value.form) == "Group")
        else: assert(false)
    assert(failure("let v = {}\n") == "1:10: an empty map uses `map[K, V]()`")
    assert(not parses("let v = {1}\n"))
    assert(not parses("let v = {1: }\n"))
    assert(not parses("let v = {1: 2 3: 4}\n"))
    assert(not parses("let v = [1 2]\n"))
    assert(not parses("let v = [,]\n"))
    assert(not parses("let v = (,)\n"))
    assert(not parses("let v = (1 2)\n"))

pub func test_lambda_and_closure_shapes_and_rejections():
    let module = parsed("func f():\n    let curried = (x) => (y) => x + y\n    let picked = (a, b,) => a if a > b else b\n    let pair = (a, b)\n    let block = func (): return\n    let typed = func (x: i64) -> i64!:\n        return x\n")
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Lambda(parameters, body): assert(str(body.form) == "Lambda")
        else: assert(false)
    match binding_expression(statements[1]).form:
        Lambda(parameters, body):
            assert(len(parameters) == 2)
            assert(str(body.form) == "Conditional")
        else: assert(false)
    assert(str(binding_expression(statements[2]).form) == "TupleValue")
    match binding_expression(statements[3]).form:
        Closure(captures, parameters, result, body):
            assert(len(captures) == 0)
            assert(len(parameters) == 0)
            assert(result == none)
        else: assert(false)
    match binding_expression(statements[4]).form:
        Closure(captures, parameters, result, body):
            assert(result != none)
        else: assert(false)
    assert(not parses("let v = (x) =>\n"))
    assert(not parses("let v = (1) => 1\n"))
    assert(not parses("let v = (x: ) => 1\n"))
    assert(not parses("let v = x => x\n"))
    assert(not parses("let v = (x) => y = 1\n"))
    assert(not parses("let v = func\n"))
    assert(not parses("let v = func (x) : return\n"))
    assert(not parses("let v = func []() : return\n"))
    assert(not parses("let v = func [copy x]() : return\n"))
    assert(not parses("let v = func [weak x = y]() : return\n"))
    assert(not parses("let v = func [move x]() : return\n"))
    assert(not parses("let v = func [x]() : return\n"))
    assert(not parses("let v = func [copy self = self]() : return\n"))
    assert(not parses("let v = func () -> : return\n"))
    assert(not parses("let v = func ():\n"))

pub func test_match_expression_shapes_and_rejections():
    let source = "func f(c: char) -> str:\n    return match c:\n        '0'..='9', '_' => \"digit\"\n        'a' => \"a\" if lower else \"A\"\n        _ => other() else \"?\"\n"
    match function_body(first_function(parsed(source))).statements[0].form:
        ReturnStatement(value):
            let returned = value else trap("expected a value")
            match returned.form:
                MatchValue(subject, arms):
                    assert(len(arms) == 3)
                    assert(str(arms[1].value.form) == "Conditional")
                    assert(str(arms[2].value.form) == "ElseValue")
                else: assert(false)
        else: assert(false)
    assert(not parses("let v = match c:\n"))
    assert(not parses("let v = match c: _ => 0\n"))
    assert(not parses("let v = match c:\n    _ =>\n"))
    assert(not parses("let v = match c:\n    _ => 0\n    '0' : 1\n"))
    assert(not parses("let v = match c:\n    _ => 0 _ => 1\n"))
    assert(not parses("let v = match:\n    _ => 0\n"))
    assert(not parses("let v = match c\n    _ => 0\n"))

pub func test_slices_accept_both_bounds_forms_and_reject_others():
    let module = parsed("func f():\n    let a = items[..<n]\n    let b = items[i + 1..<n - 1]\n    let c = items[i..]\n    let d = items[(i..<n)]\n    let e = items[f(i..<n)]\n")
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Slice(value, start, operator, end):
            assert(start == none)
            assert(end != none)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Slice(value, start, operator, end):
            assert(str((start else trap("start")).form) == "Binary")
            assert(str((end else trap("end")).form) == "Binary")
        else: assert(false)
    match binding_expression(statements[2]).form:
        Slice(value, start, operator, end):
            assert(operator == "..")
            assert(end == none)
        else: assert(false)
    assert(str(binding_expression(statements[3]).form) == "Index")
    assert(str(binding_expression(statements[4]).form) == "Index")
    assert(failure("func f(): return items[..<]\n") == "1:24: a slice requires at least one bound")
    assert(not parses("func f(): return items[..<n..<m]\n"))
    assert(not parses("func f(): return items[..n]\n"))
    assert(parses("func f(): return items[i.. ]\n"))

pub func test_self_and_keywords_as_expressions():
    assert(parses("struct S:\n    func f(self): return self\n    func g(self): self.x = self.y\n"))
    assert(not parses("func f(): return if\n"))
    assert(not parses("func f(): return let\n"))
    assert(not parses("func f(): return self.self\n"))
    assert(not parses("func f(): let self = 1\n"))
    assert(not parses("func f(): let if = 1\n"))
    assert(not parses("func f(): return f(if: 1)\n"))
    assert(not parses("func f(): return .if\n"))
    assert(not parses("let v = _\n"))

pub func test_optional_cases_spell_none_after_a_dot():
    let module = parsed("func f(v: i64?) -> i64?:\n    match v:\n        .some(inner): return .some(inner + 1)\n        .none: return .none\n")
    let statements = function_body(first_function(module)).statements
    match statements[0].form:
        MatchStatement(subject, arms):
            match arms[1].patterns[0]:
                CasePattern(name, bindings, pattern_span): assert(name == "none")
                else: assert(false)
            match arms[1].body.statements[0].form:
                ReturnStatement(value):
                    match (value else trap("expected a value")).form:
                        CaseValue(name, arguments): assert(name == "none")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    assert(not parses("let v = .true\n"))
    assert(not parses("let v = .self\n"))
    assert(not parses("func f():\n    match a:\n        .true: return\n"))

pub func test_formatted_strings_parse_their_fields_as_expressions():
    let module = parsed("let v = f\"frame {frame}: {status.name()} {{literal}} {a if b else c}\"\nlet w = f\"\"\"multi\n{x +\n    1}\"\"\"\nlet x = f\"\"\nlet y = r\"C:\\x\"\n")
    let formatted = binding_syntax(module, 0)
    match formatted.form:
        FormattedString(start, parts):
            assert(start.text == "f\"")
            assert(len(parts) == 6)
            match parts[0]:
                Text(token): assert(token.text == "frame ")
                else: assert(false)
            match parts[1]:
                Field(value, field_span): assert(str(value.form) == "Name")
                else: assert(false)
            match parts[3]:
                Field(value, field_span): assert(str(value.form) == "Call")
                else: assert(false)
            match parts[4]:
                Text(token): assert(token.text == " {{literal}} ")
                else: assert(false)
            match parts[5]:
                Field(value, field_span):
                    assert(str(value.form) == "Conditional")
                    assert(field_span.column == 54)
                else: assert(false)
            assert(formatted.span.line == 1)
            assert(formatted.span.column == 9)
        else: assert(false)
    match binding_of(module, 1):
        FormattedString(start, parts):
            assert(start.text == "f\"\"\"")
            assert(len(parts) == 2)
            match parts[1]:
                Field(value, field_span): assert(str(value.form) == "Binary")
                else: assert(false)
        else: assert(false)
    match binding_of(module, 2):
        FormattedString(start, parts): assert(len(parts) == 0)
        else: assert(false)
    assert(str(binding_of(module, 3)) == "Literal")
    assert(failure("let v = f\"{}\"\n") == "1:12: a formatted string field requires an expression")
    assert(not parses("let v = f\"{a: 1}\"\n"))
    assert(not parses("let v = f\"{a b}\"\n"))
    assert(not parses("let v = f\"{let a = 1}\"\n"))
    assert(not parses("func f():\n    match v:\n        f\"x\": return\n"))
    assert(not parses("let v = f\"{a}\".x(\n"))

pub func test_suites_may_be_written_inside_delimiters():
    let source = "func f(buffer: Buffer):\n    buffer.with_mutable_slice(func (view: mutable_slice[u8]):\n        fill(view, 0)\n    )\n    run(func (x: i64) -> i64: return x)\n    let v = call(load() catch failure:\n        recover 0\n    , 2)\n    let w = pick(match c:\n        'a' => 1\n        _ => 2\n    )\n    let items = [1, func ():\n        return 2\n    ]\n"
    let statements = function_body(first_function(parsed(source))).statements
    assert(len(statements) == 5)
    match statements[0].form:
        ExpressionStatement(value):
            match value.form:
                Call(callee, type_arguments, arguments):
                    match arguments[0].value.form:
                        Closure(captures, parameters, result, body):
                            assert(body.style == SuiteStyle.indented_suite)
                            assert(len(body.statements) == 1)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statements[1].form:
        ExpressionStatement(value):
            match value.form:
                Call(callee, type_arguments, arguments):
                    match arguments[0].value.form:
                        Closure(captures, parameters, result, body):
                            assert(body.style == SuiteStyle.inline_suite)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match binding_expression(statements[2]).form:
        Call(callee, type_arguments, arguments):
            assert(len(arguments) == 2)
            assert(str(arguments[0].value.form) == "CatchValue")
        else: assert(false)
    match binding_expression(statements[3]).form:
        Call(callee, type_arguments, arguments): assert(str(arguments[0].value.form) == "MatchValue")
        else: assert(false)
    match binding_expression(statements[4]).form:
        ListValue(elements): assert(len(elements) == 2)
        else: assert(false)
    assert(not parses("func f():\n    run(func (): return 1, 2)\n"))
    assert(not parses("func f():\n    run(func ():\n        return 1\n    , func (): return 2\n"))
    assert(not parses("func f():\n    if a: run(func ():\n        return 1\n    )\n"))
    assert(not parses("func f():\n    run(func ():\n    )\n"))
    assert(not parses("func f():\n    run(label:\n        1)\n"))


# mark: Spec-rule coverage: spans and syntax accessors ======================================

pub func test_spans_locate_declarations_statements_and_expressions():
    let source = "let a = 1\n\nfunc f(x: i64):\n    if x > 1:\n        return x + 2\n    return 0\n"
    let module = parsed(source)
    let declaration = module.declarations[1]
    assert(declaration.span.line == 3)
    assert(declaration.span.column == 1)
    assert(declaration.span.start == 11)
    assert(i64(declaration.span.end) == len(source))
    var statements = list[StatementSyntax]()
    match declaration.value:
        Function(value): statements = function_body(value).statements
        else: assert(false)
    let if_span = statements[0].span
    assert(if_span.line == 4)
    assert(if_span.column == 5)
    match statements[0].form:
        IfStatement(branches, fallback):
            assert(branches[0].body.span.line == 4)
            let returned_statement = branches[0].body.statements[0]
            match returned_statement.form:
                ReturnStatement(value):
                    assert(returned_statement.span.line == 5)
                    assert(returned_statement.span.column == 9)
                    let returned = value else trap("expected a value")
                    let expression_span = returned.span
                    assert(expression_span.line == 5)
                    assert(expression_span.column == 16)
                    assert(source[i64(expression_span.start):i64(expression_span.end)] == "x + 2")
                else: assert(false)
        else: assert(false)
    let return_span = statements[1].span
    assert(return_span.line == 6)
    assert(source[i64(return_span.start):i64(return_span.end)] == "return 0")

pub func test_path_syntax_accessors_and_multiline_expression_spans():
    let module = parsed("import compiler.frontend.parser\nlet v = call(\n    1,\n    2,\n)\n")
    assert(module.imports[0].path.dotted() == "compiler.frontend.parser")
    assert(module.imports[0].path.last() == "parser")
    let call = binding_syntax(module, 0)
    match call.form:
        Call(callee, type_arguments, arguments):
            assert(call.span.line == 2)
            assert(arguments[1].span.line == 4)
            assert(arguments[1].span.column == 5)
        else: assert(false)

pub func test_stable_diagnostics_for_common_mistakes():
    assert(failure("struct S:\n    let x: i64\n    pub\n") == "3:8: expected `func`")
    assert(failure("func f(): return items[1..2]\n") == "1:27: an inclusive slice ends at `..`")
    assert(failure("func f(): return items[..]\n") == "1:24: a slice requires at least one bound")
    assert(failure("let v = (1,)\n") == "1:12: a tuple requires at least two elements")
    assert(failure("func f[](): return\n") == "1:8: generic parameter list cannot be empty")
    assert(failure("let v = func []() : return\n") == "1:15: capture list cannot be empty")
    assert(failure("type T = list[]\n") == "1:15: type argument list cannot be empty")
    assert(failure("type T = (i64,)\n") == "1:15: a tuple type requires at least two elements")
    assert(failure("interface I:\n    let x: i64\n") == "2:5: an interface member must be a function signature")
    assert(failure("struct S:\n    weak func f(self): return\n") == "2:10: `weak` must modify a field")
    assert(failure("mutating let v = 1\n") == "1:10: `mutating` must modify a function declaration")
    assert(failure("export c func f(): return\nexport d func g(): return\n") == "2:8: expected `c` after `export`")
    assert(failure("func f():\n    return\n    ## Lost.\n    return\n") == "3:5: documentation comments must precede declarations")
    assert(failure("func f(a: i64):\n    if a: let cb = func (): return\n") == "2:29: a same-line suite cannot contain another suite")


# mark: Spec-rule remainder =================================================================

pub func test_try_is_and_identity_operators_are_expression_forms():
    let module = parsed("func f(a: i64, b: i64, optional: i64?):\n    let loaded = try load()\n    let same = a is b\n    let different = a is not b\n    let ok = +a + -b + ~a\n    return optional else 0\n")
    let statements = function_body(first_function(module)).statements
    match binding_expression(statements[0]).form:
        Unary(operator, operand): assert(operator == "try")
        else: assert(false)
    match binding_expression(statements[1]).form:
        Binary(left, operator, right): assert(operator == "is")
        else: assert(false)
    match binding_expression(statements[2]).form:
        Binary(left, operator, right): assert(operator == "is not")
        else: assert(false)
    match binding_expression(statements[3]).form:
        Binary(left, operator, right): assert(operator == "+")
        else: assert(false)

pub func test_for_elif_empty_return_and_member_chains_parse():
    let source = "func walk(items: list[i64], node: Node):\n    for item in items:\n        if item < 0: continue\n        elif item == 0: break\n        elif item == 1: return\n        else: consume(item)\n    let value = node.child.ready\n    let cell = items[0][1]\n    return\n"
    let statements = function_body(first_function(parsed(source))).statements
    match statements[0].form:
        ForStatement(name, iterable, body):
            assert(name == "item")
            assert(len(body.statements) == 1)
            match body.statements[0].form:
                IfStatement(branches, fallback):
                    assert(len(branches) == 3)
                    assert(fallback != none)
                else: assert(false)
        else: assert(false)
    match binding_expression(statements[1]).form:
        Member(value, name):
            assert(name == "ready")
            match value.form:
                Member(inner, inner_name): assert(inner_name == "child")
                else: assert(false)
        else: assert(false)
    match binding_expression(statements[2]).form:
        Index(value, subscript):
            match value.form:
                Index(inner, inner_subscript): assert(str(inner.form) == "Name")
                else: assert(false)
        else: assert(false)
    match statements[3].form:
        ReturnStatement(value): assert(value == none)
        else: assert(false)

pub func test_optional_then_fallible_is_the_only_postfix_type_order():
    let module = parsed("type A = i64?!\ntype B = list[i64]?\ntype C = func() -> unit\ntype D = never\n")
    match module.declarations[0].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                FallibleType(inner): assert(str(inner.form) == "OptionalType")
                else: assert(false)
        else: assert(false)
    match module.declarations[2].value:
        TypeAlias(type_alias):
            match type_alias.value.form:
                FunctionType(parameters, result):
                    assert(len(parameters) == 0)
                    match result.form:
                        Named(path): assert(path.dotted() == "unit")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    assert(not parses("type T = i64!?\n"))
    assert(not parses("type T = ()\n"))

pub func test_labeled_arguments_trailing_commas_and_generic_lists():
    let module = parsed("func render[T,](scene: T, samples: u32 = 64,):\n    draw(scene, samples: 8, denoise: true,)\n    return\n")
    let function_value = first_function(module)
    assert(len(function_value.generic_parameters) == 1)
    assert(function_value.parameters[1].default_value != none)
    match function_body(function_value).statements[0].form:
        ExpressionStatement(value):
            match value.form:
                Call(callee, type_arguments, arguments):
                    assert(len(arguments) == 3)
                    assert(arguments[0].label == none)
                    assert((arguments[1].label else "") == "samples")
                    assert((arguments[2].label else "") == "denoise")
                else: assert(false)
        else: assert(false)
    assert(parses("let v = call(\n    1,\n    2,\n)\n"))
    assert(not parses("func f(a: i64 = 1 b: i64): return\n"))

pub func test_class_init_deinit_and_enum_case_documentation_parse():
    let source = "class Node:\n    func init(self): return\n    func deinit(self): return\nenum Kind:\n    ## A file.\n    file\n    directory\n"
    let module = parsed(source)
    match module.declarations[0].value:
        NominalType(nominal):
            assert(nominal.kind == NominalTypeKind.class_type)
            assert(len(nominal.members) == 2)
            match nominal.members[0].value:
                Function(function): assert(function.name == "init")
                else: assert(false)
            match nominal.members[1].value:
                Function(function): assert(function.name == "deinit")
                else: assert(false)
        else: assert(false)
    match module.declarations[1].value:
        Enumeration(enumeration):
            assert(enumeration.cases[0].documentation[0] == "A file.")
            assert(len(enumeration.cases[1].documentation) == 0)
        else: assert(false)

pub func test_wait_and_cancel_are_ordinary_calls():
    let module = parsed("func f(work: task[i64]) -> i64!:\n    defer work.cancel()\n    return try work.wait()\n")
    let statements = function_body(first_function(module)).statements
    match statements[0].form:
        DeferStatement(value):
            match value.form:
                Call(callee, type_arguments, arguments):
                    match callee.form:
                        Member(owner, name): assert(name == "cancel")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statements[1].form:
        ReturnStatement(value):
            let returned = value else trap("expected a return value")
            match returned.form:
                Unary(operator, operand):
                    assert(operator == "try")
                    match operand.form:
                        Call(callee, type_arguments, arguments):
                            match callee.form:
                                Member(owner, name): assert(name == "wait")
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_excluded_and_malformed_module_forms_are_rejected():
    assert(not parses("from module import *\n"))
    assert(not parses("pub import module\n"))
    assert(not parses("import module as path.alias\n"))
    assert(not parses("defer cleanup()\n"))
    assert(not parses("recover value\n"))
    assert(not parses("union Value:\n    a\n"))
    assert(not parses("goto done\n"))
    assert(not parses("async func f(): return\n"))
    assert(not parses("throw error\n"))
    assert(not parses("func f():\n    for (a, b) in pairs:\n        return\n"))
    assert(not parses("func f():\n    while let value = optional:\n        return\n"))
    assert(not parses("test 1: return\n"))
    assert(not parses("test: return\n"))
    assert(not parses("from module import x as y\n"))
    assert(parses("import a\nimport b as c\nfrom d import e, f\n"))
    assert(parses("func f(optional: i64?):\n    if let value = optional:\n        return value\n    return 0\n"))
