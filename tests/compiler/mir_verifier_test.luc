#==============================================================================================
#
#   mir_verifier_test - One test per rule a backend may assume
#
#   DESCRIPTION:
#       Each test builds the smallest program that breaks exactly one rule
#       from docs/compiler/mir.md and pins the diagnostic. The MIR interpreter
#       tests cover the accepting side: every program there is verified first.
#
#==============================================================================================

from luce.compiler.canonical_ir import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from luce.compiler.canonical_ir import ExternId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData
from luce.compiler.canonical_ir import MirExtern, MirField, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.canonical_ir import MirRelocation, MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.canonical_ir import RelocationTarget, SwitchCase, TypeId, UnaryOp, builtin_mir_type
from luce.compiler.canonical_ir import create_empty_mir_program, find_runtime_symbol, intern_mir_type
from luce.compiler.canonical_ir import make_struct_type, wasm32_layout
from luce.compiler.mir_verifier import MirVerifier
from luce.compiler.source import SourceSpan

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = index)

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Int(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func ret(values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = regs(values)))

# Helpers take parameter and result lists rather than a `MirSignature`, because
# Stage-0 frees the lists of a struct returned by one call and passed straight
# into another.
pub func function(name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        is_public = true,
        span = at(),
    )

pub func c_function(name: str, parameters: list[TypeId], results: list[TypeId], is_fallible: bool, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.c,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = is_fallible),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        is_public = true,
        span = at(),
    )

# A one-function program `f` with the given registers and body.
pub func program_with(results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirProgram:
    let program = create_empty_mir_program(wasm32_layout())
    program.functions.append(function("f", list[TypeId](), results, registers, body))
    return program

# Statement-form `catch reason: return reason` does not return under Stage-0
# 0.22; assigning through a `var` does.
pub func failure(program: MirProgram) -> str:
    var reported = ""
    MirVerifier(program).verify() catch reason:
        reported = reason
    return reported

pub func accepted(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func no_values() -> list[RegisterId]:
    return list[RegisterId]()

pub func none_types() -> list[TypeId]:
    return list[TypeId]()

# mark: Registers ============================================================================

pub func test_registers_are_used_only_after_definition():
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret([1])]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_registers_are_defined_once():
    let body: list[MirInstruction] = [const_int(0, 1), const_int(0, 2), ret([0])]
    assert(failure(program_with([i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r0 twice")

pub func test_undeclared_registers_are_rejected():
    let body: list[MirInstruction] = [const_int(3, 1), ret([3])]
    assert(failure(program_with([i64_t()], [i64_t()], body)) == "MIR verifier: `f` defines r3, which is not declared")

pub func test_definitions_inside_a_region_stay_inside_it():
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_values(), body = [const_int(0, 1)])),
        ret([0]),
    ]
    assert(failure(program_with([i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: uses r0 before it is defined")

pub func test_parameters_occupy_the_leading_registers():
    let program = create_empty_mir_program(wasm32_layout())
    program.functions.append(function("f", [i64_t()], [i64_t()], [bool_t()], [ret([0])]))
    assert(failure(program) == "MIR verifier: `f` register r0 must have its parameter's type")
    let short = create_empty_mir_program(wasm32_layout())
    short.functions.append(function("f", [i64_t()], [i64_t()], none_types(), [ret([0])]))
    assert(failure(short) == "MIR verifier: `f` declares fewer registers than parameters")

# mark: Operand types ========================================================================

pub func test_constants_must_fit_their_register():
    let outside: list[MirInstruction] = [const_int(0, 128), ret([0])]
    assert(failure(program_with([i8_t()], [i8_t()], outside)) == "MIR verifier: `f` at 1:1: constant 128 is outside `i8`")
    let wrong_kind: list[MirInstruction] = [const_bool(0, true), ret([0])]
    assert(failure(program_with([i64_t()], [i64_t()], wrong_kind)) == "MIR verifier: `f` at 1:1: bool constant into `i64` register")
    let null_into_int: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ret([0])]
    assert(failure(program_with([i64_t()], [i64_t()], null_into_int)) == "MIR verifier: `f` at 1:1: null into `i64` register")

pub func test_binary_operands_must_share_a_type_the_operation_accepts():
    let mixed: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.add, 0, 1), ret([2])]
    assert(failure(program_with([i64_t()], [i32_t(), i64_t(), i64_t()], mixed)) == "MIR verifier: `f` at 1:1: `add` operands has `i32`, expected `i64`")
    let int_div: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.div, 0, 1), ret([2])]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t(), i64_t()], int_div)) == "MIR verifier: `f` at 1:1: `div` needs float operands; integers use `floor_div`")
    let bool_result: list[MirInstruction] = [const_int(0, 1), const_int(1, 1), binary(2, BinaryOp.lt, 0, 1), ret([2])]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t(), i64_t()], bool_result)) == "MIR verifier: `f` at 1:1: `lt` result has `i64`, expected `bool`")
    let bool_shift: list[MirInstruction] = [const_bool(0, true), const_bool(1, true), binary(2, BinaryOp.shift_left, 0, 1), ret([2])]
    assert(failure(program_with([bool_t()], [bool_t(), bool_t(), bool_t()], bool_shift)) == "MIR verifier: `f` at 1:1: `shift_left` needs integer operands, found `bool`")

pub func test_unary_and_convert_check_their_directions():
    let neg_bool: list[MirInstruction] = [const_bool(0, true), ins(InstructionForm.Unary(result = r(1), operation = UnaryOp.neg, operand = r(0))), ret([1])]
    assert(failure(program_with([bool_t()], [bool_t(), bool_t()], neg_bool)) == "MIR verifier: `f` at 1:1: `neg` needs a signed integer or float, found `bool`")
    let narrow_extend: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.extend, operand = r(0))), ret([1])]
    assert(failure(program_with([i8_t()], [i64_t(), i8_t()], narrow_extend)) == "MIR verifier: `f` at 1:1: `extend` must widen an integer, found `i64` to `i8`")
    let widen_wrap: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.wrap, operand = r(0))), ret([1])]
    assert(failure(program_with([i64_t()], [i8_t(), i64_t()], widen_wrap)) == "MIR verifier: `f` at 1:1: `wrap` must narrow an integer, found `i8` to `i64`")
    let bad_float: list[MirInstruction] = [const_int(0, 1), ins(InstructionForm.Convert(result = r(1), operation = ConvertOp.float_to_int, operand = r(0))), ret([1])]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t()], bad_float)) == "MIR verifier: `f` at 1:1: `float_to_int` needs a float operand and an integer result")

# mark: Memory ===============================================================================

pub func test_aggregates_never_travel_through_registers():
    let program = create_empty_mir_program(wasm32_layout())
    let pair = intern_mir_type(program.types, make_struct_type(program.types, program.layout, [i32_t(), i32_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Load(result = r(1), value_type = pair, address = r(0))),
        ret(list[i64]()),
    ]
    let function_value = MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false),
        registers = [ptr_t(), pair],
        slots = [MirSlot(value_type = pair, align = 4)],
        body = body,
        is_public = true,
        span = at(),
    )
    program.functions.append(function_value)
    assert(failure(program) == "MIR verifier: `f` at 1:1: `Load` of a struct; aggregates move with `Memcpy`")

pub func test_addresses_must_be_pointers_and_slots_must_exist():
    let not_pointer: list[MirInstruction] = [const_int(0, 4), ins(InstructionForm.Load(result = r(1), value_type = i64_t(), address = r(0))), ret([1])]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t()], not_pointer)) == "MIR verifier: `f` at 1:1: `Load` address must be `ptr`, found `i64`")
    let missing_slot: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ret(list[i64]())]
    assert(failure(program_with(none_types(), [ptr_t()], missing_slot)) == "MIR verifier: `f` at 1:1: `Alloca` names slot 0, which does not exist")
    let missing_field: list[MirInstruction] = [ins(InstructionForm.FieldAddress(result = r(0), struct_type = i64_t(), base = r(0), field = 0)), ret(list[i64]())]
    assert(failure(program_with(none_types(), [ptr_t()], missing_field)) == "MIR verifier: `f` at 1:1: `FieldAddress` needs a struct type, found `i64`")

pub func test_struct_layouts_must_match_the_target():
    let program = create_empty_mir_program(wasm32_layout())
    # `{i32 @0, i64 @4}` claims a 4-byte offset for an 8-aligned field.
    let fields = [MirField(value_type = i32_t(), offset = 0), MirField(value_type = i64_t(), offset = 4)]
    program.types.definitions.append(MirType.Struct(fields = fields, size = 16, align = 8))
    assert(failure(program) == "MIR verifier: struct type 12 has a layout other than the target's: {i32 @0, i64 @4}")

pub func test_data_relocations_stay_inside_their_bytes():
    let program = create_empty_mir_program(wasm32_layout())
    program.data.append(MirData(name = "table", bytes = [0, 0], align = 1, relocations = [MirRelocation(offset = 0, target = RelocationTarget.Data(id = DataId(value = 0)))]))
    assert(failure(program) == "MIR verifier: data `table` has a relocation outside its bytes at offset 0")
    let dangling = create_empty_mir_program(wasm32_layout())
    dangling.data.append(MirData(name = "table", bytes = [0, 0, 0, 0], align = 1, relocations = [MirRelocation(offset = 0, target = RelocationTarget.Function(id = FunctionId(value = 3)))]))
    assert(failure(dangling) == "MIR verifier: data `table` relocates to function 3, which does not exist")
    let global_program = create_empty_mir_program(wasm32_layout())
    global_program.globals.append(MirGlobal(name = "g", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    assert(failure(global_program) == "MIR verifier: global `g` is initialised from data item 0, which does not exist")

# mark: Control flow =========================================================================

pub func test_branch_depths_stay_within_enclosing_regions():
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_values(), body = [ins(InstructionForm.Br(depth = 1, values = no_values()))])),
        ret(list[i64]()),
    ]
    assert(failure(program_with(none_types(), none_types(), body)) == "MIR verifier: `f` at 1:1: branch depth 1 with 1 enclosing region(s)")

pub func test_a_block_with_results_must_supply_them():
    let falls_through: list[MirInstruction] = [
        ins(InstructionForm.Block(results = regs([0]), body = [const_int(1, 1)])),
        ret([0]),
    ]
    assert(failure(program_with([i64_t()], [i64_t(), i64_t()], falls_through)) == "MIR verifier: `f` at 1:1: `Block` with results can fall off its end; supply them with `Yield` or `Br`")
    let wrong_count: list[MirInstruction] = [
        ins(InstructionForm.Block(results = regs([0]), body = [ins(InstructionForm.Yield(values = no_values()))])),
        ret([0]),
    ]
    assert(failure(program_with([i64_t()], [i64_t()], wrong_count)) == "MIR verifier: `f` at 1:1: `Yield` supplies 0 value(s), expected 1")
    let one_arm: list[MirInstruction] = [
        const_bool(0, true),
        ins(InstructionForm.If(condition = r(0), results = regs([2]), then_body = [const_int(1, 1), ins(InstructionForm.Yield(values = regs([1])))], else_body = list[MirInstruction]())),
        ret([2]),
    ]
    assert(failure(program_with([i64_t()], [bool_t(), i64_t(), i64_t()], one_arm)) == "MIR verifier: `f` at 1:1: `If` with results must supply them on both arms with `Yield` or `Br`")

pub func test_loops_take_no_values_on_a_branch():
    let body: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop(body = [ins(InstructionForm.Br(depth = 0, values = regs([0])))])),
        ret([0]),
    ]
    assert(failure(program_with([i64_t()], [i64_t()], body)) == "MIR verifier: `f` at 1:1: a branch to a `Loop` restarts it and carries no values")
    let yield_values: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Loop(body = [ins(InstructionForm.Yield(values = regs([0])))])),
        ret([0]),
    ]
    assert(failure(program_with([i64_t()], [i64_t()], yield_values)) == "MIR verifier: `f` at 1:1: `Yield` cannot carry values out of a `Loop`")

pub func test_conditions_and_tags_have_their_types():
    let int_condition: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.If(condition = r(0), results = no_values(), then_body = list[MirInstruction](), else_body = list[MirInstruction]())),
        ret(list[i64]()),
    ]
    assert(failure(program_with(none_types(), [i64_t()], int_condition)) == "MIR verifier: `f` at 1:1: `If` condition must be `bool`, found `i64`")
    let repeated: list[MirInstruction] = [
        const_int(0, 1),
        ins(InstructionForm.Switch(tag = r(0), cases = [SwitchCase(value = 1, body = list[MirInstruction]()), SwitchCase(value = 1, body = list[MirInstruction]())], default_body = list[MirInstruction]())),
        ret(list[i64]()),
    ]
    assert(failure(program_with(none_types(), [i64_t()], repeated)) == "MIR verifier: `f` at 1:1: `Switch` repeats case 1")
    let yield_at_top: list[MirInstruction] = [ins(InstructionForm.Yield(values = no_values())), ret(list[i64]())]
    assert(failure(program_with(none_types(), none_types(), yield_at_top)) == "MIR verifier: `f` at 1:1: `Yield` outside any region; use `Return`")

pub func test_functions_end_every_path():
    let falls_off: list[MirInstruction] = [const_int(0, 1)]
    assert(failure(program_with([i64_t()], [i64_t()], falls_off)) == "MIR verifier: `f` can fall off the end of its body; end every path with `Return`, `Raise`, `Trap`, or `Unreachable`")
    # Both arms of an `If` returning is a complete body.
    let both_arms: list[MirInstruction] = [
        const_bool(0, true),
        const_int(1, 1),
        ins(InstructionForm.If(condition = r(0), results = no_values(), then_body = [ret([1])], else_body = [ret([1])])),
    ]
    accepted(program_with([i64_t()], [bool_t(), i64_t()], both_arms))

# mark: Returns and failure ==================================================================

pub func test_returns_match_the_signature():
    let too_few: list[MirInstruction] = [ret(list[i64]())]
    assert(failure(program_with([i64_t()], none_types(), too_few)) == "MIR verifier: `f` at 1:1: `Return` supplies 0 value(s), expected 1")
    let wrong_type: list[MirInstruction] = [const_bool(0, true), ret([0])]
    assert(failure(program_with([i64_t()], [bool_t()], wrong_type)) == "MIR verifier: `f` at 1:1: `Return` value 0 has `bool`, expected `i64`")

pub func test_raise_needs_a_fallible_function():
    let body: list[MirInstruction] = [ins(InstructionForm.Const(result = r(0), value = MirConstant.Null)), ins(InstructionForm.Raise(failure = r(0)))]
    assert(failure(program_with(none_types(), [ptr_t()], body)) == "MIR verifier: `f` at 1:1: `Raise` in a function that cannot fail")
    let program = create_empty_mir_program(wasm32_layout())
    program.functions.append(MirFunction(
        name = "f",
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = none_types(), results = [i64_t()], is_fallible = true),
        registers = none_types(),
        slots = list[MirSlot](),
        body = [ins(InstructionForm.Trap(reason = "never"))],
        is_public = true,
        span = at(),
    ))
    assert(failure(program) == "MIR verifier: function `f` is fallible but its last result is not the `ptr` error slot")

pub func test_calls_match_their_target():
    let body: list[MirInstruction] = [
        ins(InstructionForm.Call(results = regs([0]), function = FunctionId(value = 0), arguments = no_values())),
        ret([0]),
    ]
    let program = create_empty_mir_program(wasm32_layout())
    program.functions.append(function("f", [i64_t()], [i64_t()], [i64_t()], body))
    assert(failure(program) == "MIR verifier: `f` at 1:1: call passes 0 argument(s) to a signature with 1")
    let missing: list[MirInstruction] = [ins(InstructionForm.Call(results = regs([0]), function = FunctionId(value = 7), arguments = no_values())), ret([0])]
    assert(failure(program_with([i64_t()], [i64_t()], missing)) == "MIR verifier: `f` at 1:1: `Call` names function 7, which does not exist")

# mark: Program-level rules ==================================================================

pub func test_runtime_externs_are_known_services_with_known_signatures():
    let unknown = create_empty_mir_program(wasm32_layout())
    unknown.externs.append(MirExtern(name = "luce_rt_teleport", convention = CallingConvention.runtime, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(unknown) == "MIR verifier: extern `luce_rt_teleport` is not a runtime service")
    let wrong = create_empty_mir_program(wasm32_layout())
    wrong.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = MirSignature(parameters = [ptr_t()], results = none_types(), is_fallible = false)))
    assert(failure(wrong) == "MIR verifier: runtime extern `luce_rt_write` has signature (ptr) -> (), expected (ptr, i64) -> ()")
    let luce_extern = create_empty_mir_program(wasm32_layout())
    luce_extern.externs.append(MirExtern(name = "helper", convention = CallingConvention.luce, signature = MirSignature(parameters = none_types(), results = none_types(), is_fallible = false)))
    assert(failure(luce_extern) == "MIR verifier: extern `helper` uses the `luce` convention; externs are C or runtime symbols")

pub func test_the_c_boundary_admits_only_c_representable_shapes():
    let program = create_empty_mir_program(wasm32_layout())
    let option = intern_mir_type(program.types, MirType.Enum(tag = i8_t(), cases = [i64_t()], size = 16, align = 8))
    program.functions.append(c_function("exported", [option], none_types(), false, [option], [ret(list[i64]())]))
    assert(failure(program) == "MIR verifier: function `exported` passes `enum(i8 | i64)` across the C boundary")
    let fallible = create_empty_mir_program(wasm32_layout())
    fallible.functions.append(c_function("exported", none_types(), [i64_t(), ptr_t()], true, none_types(), [ins(InstructionForm.Trap(reason = "never"))]))
    assert(failure(fallible) == "MIR verifier: function `exported` uses the `c` convention and cannot be fallible")

pub func test_entry_and_function_names_are_program_wide_facts():
    var program = create_empty_mir_program(wasm32_layout())
    program.functions.append(function("main", none_types(), [i64_t()], [i64_t()], [const_int(0, 0), ret([0])]))
    program.entry = FunctionId(value = 0)
    assert(failure(program) == "MIR verifier: entry `main` must be `() -> i32`, found () -> (i64)")
    let duplicate = create_empty_mir_program(wasm32_layout())
    duplicate.functions.append(function("twice", none_types(), none_types(), none_types(), [ret(list[i64]())]))
    duplicate.functions.append(function("twice", none_types(), none_types(), none_types(), [ret(list[i64]())]))
    assert(failure(duplicate) == "MIR verifier: duplicate function `twice`")
    var good = create_empty_mir_program(wasm32_layout())
    good.functions.append(function("main", none_types(), [i32_t()], [i32_t()], [const_int(0, 0), ret([0])]))
    good.entry = FunctionId(value = 0)
    accepted(good)
