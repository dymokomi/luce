#==============================================================================================
#
#   mir_verifier_test - Canonical MIR invariants are target-independent
#
#   DESCRIPTION:
#       Hand-built canonical programs exercise the checks every optimizer and
#       compiled backend may rely on. Invalid MIR must fail here with the same
#       diagnostic regardless of the eventual artifact target.
#
#==============================================================================================

from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram
from luce.compiler.mir_verifier import MirVerifier

# Wrap one instruction stream in a public `main.answer` function so each test
# changes only the invariant it intends to exercise.
func program_with(result: str, instructions: list[CanonicalInstruction]) -> CanonicalProgram:
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = result, instructions = instructions)
    return CanonicalProgram(functions = [function])

pub func test_verifier_accepts_well_typed_stack_mir():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 2),
        CanonicalInstruction.I64Constant(value = 3),
        CanonicalInstruction.I64Add,
        CanonicalInstruction.Return,
    ]
    MirVerifier(program_with("i64", instructions)).verify() catch reason:
        trap(reason)

pub func test_verifier_rejects_wrong_binary_operand_types():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I32Constant(value = 2),
        CanonicalInstruction.I64Constant(value = 3),
        CanonicalInstruction.I64Add,
        CanonicalInstruction.Return,
    ]
    MirVerifier(program_with("i64", instructions)).verify() catch reason:
        assert(reason == "MIR verifier: `main.answer`: `I64Add` needs two `i64` operands, found `i32` and `i64`")
        return
    assert(false)

pub func test_verifier_rejects_a_return_of_the_wrong_type():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 0),
        CanonicalInstruction.Return,
    ]
    MirVerifier(program_with("i32", instructions)).verify() catch reason:
        assert(reason == "MIR verifier: `main.answer`: `Return` has `i64`, expected `i32`")
        return
    assert(false)

pub func test_verifier_rejects_instructions_after_return():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 0),
        CanonicalInstruction.Return,
        CanonicalInstruction.WriteText(value = "unreachable"),
    ]
    MirVerifier(program_with("i64", instructions)).verify() catch reason:
        assert(reason == "MIR verifier: `main.answer`: instruction follows `Return`")
        return
    assert(false)

pub func test_verifier_rejects_duplicate_canonical_function_names():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 0),
        CanonicalInstruction.Return,
    ]
    let first = CanonicalFunction(name = "main.answer", is_public = true, result = "i64", instructions = instructions)
    let second = CanonicalFunction(name = "main.answer", is_public = false, result = "i64", instructions = instructions)
    MirVerifier(CanonicalProgram(functions = [first, second])).verify() catch reason:
        assert(reason == "MIR verifier: duplicate function `main.answer`")
        return
    assert(false)
