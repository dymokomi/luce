#==============================================================================================
#
#   collections_test - Runtime collections lower to canonical MIR
#
#   DESCRIPTION:
#       Maps and sets through one target-neutral hash protocol
#       (profiles/full/mir/lowering.luc).
#
#==============================================================================================

from luce.compiler.mir.canonical import mir_type
import std.strings
from compiler.mir.lowering_support import agree, lowered


pub func test_maps_and_sets_lower_through_one_target_neutral_hash_protocol():
    let source = (
        "pub func answer() -> i64:\n"
        + "    let counts = {\"b\": 2, \"a\": 1}\n"
        + "    counts[\"c\"] = 3\n"
        + "    counts[\"a\"] = 4\n"
        + "    var sum = 0\n"
        + "    var order = \"\"\n"
        + "    for key in counts:\n"
        + "        order = order + key\n"
        + "        sum += counts[key] else 0\n"
        + "    if order != \"bac\" or sum != 9: return 0\n"
        + "    let copied = counts.copy()\n"
        + "    if copied is counts or copied != counts: return 0\n"
        + "    let removed = counts.remove(\"b\") else 0\n"
        + "    if removed != 2 or counts.length != 2u64 or copied.length != 3u64: return 0\n"
        + "    let tags = set[str](\"x\", \"y\", \"x\")\n"
        + "    if tags.length != 2u64 or not tags.contains(\"x\"): return 0\n"
        + "    if not tags.insert(\"z\") or tags.insert(\"z\"): return 0\n"
        + "    if not tags.remove(\"x\") or tags.remove(\"missing\"): return 0\n"
        + "    let reordered = set[str](\"z\", \"y\")\n"
        + "    if tags != reordered or tags is reordered: return 0\n"
        + "    var redirected = {\"old\": 1}\n"
        + "    let replace_root: func() -> i64 = func () -> i64:\n"
        + "        redirected = {\"fresh\": 2}\n"
        + "        return 40\n"
        + "    redirected[\"answer\"] = replace_root()\n"
        + "    if redirected.length != 2u64 or (redirected[\"fresh\"] else 0) != 2 or (redirected[\"answer\"] else 0) != 40: return 0\n"
        + "    return 42\n"
    )
    let program = lowered(source)
    var creates = 0
    var probes = 0
    var inserts = 0
    var key_addresses = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                HashCreate(result): creates += 1
                HashFindFirst(result, value, key_hash): probes += 1
                HashInsertEntry(result, value, key_hash): inserts += 1
                HashKeyAddress(result, value, index): key_addresses += 1
                else: pass
    assert(creates == 5)
    assert(probes > 0 and inserts > 0 and key_addresses > 0)
    assert(agree(source) == "42")

pub func test_recursive_map_equality_reuses_the_opaque_collection_pair_context():
    let source = (
        "struct Node:\n    let value: i64\n    let edges: map[str, Node]\n"
        + "func self_cycle(value: i64) -> map[str, Node]:\n    let root = map[str, Node]()\n    root[\"self\"] = Node(value = value, edges = root)\n    return root\n"
        + "func sever(root: map[str, Node]): root.clear()\n"
        + "pub func answer() -> i64:\n"
        + "    let left = self_cycle(1)\n"
        + "    let right = self_cycle(1)\n"
        + "    let equal = left == right\n"
        + "    sever(left)\n"
        + "    sever(right)\n"
        + "    if not equal: return 0\n"
        + "    let mismatch_left = self_cycle(1)\n"
        + "    let mismatch_right = self_cycle(2)\n"
        + "    let unequal = mismatch_left != mismatch_right\n"
        + "    sever(mismatch_left)\n"
        + "    sever(mismatch_right)\n"
        + "    return 42 if unequal else 0\n"
    )
    let program = lowered(source)
    var visits = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                EqualityContextVisit(result, context, left, right):
                    match mir_type(program.types, function.registers[left.value]):
                        Map(key, value): visits += 1
                        else: pass
                else: pass
    assert(visits > 0)
    assert(agree(source) == "42")
