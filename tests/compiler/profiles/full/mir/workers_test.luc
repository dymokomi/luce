#==============================================================================================
#
#   workers_test - Structured workers lower to canonical MIR
#
#   DESCRIPTION:
#       Task groups, spawn, wait, `wait_all`, cancellation, and transfer
#       (profiles/full/mir/lowering.luc).
#
#==============================================================================================

from luce.compiler.backends.mir_interpreter import MirInterpreter
from luce.compiler.backends.mir_execution_model import MirValue
from luce.compiler.mir.canonical import BuiltinMirType
from luce.compiler.mir.canonical import builtin_mir_type, find_mir_function, mir_type, transfer_at
from luce.compiler.mir.composer import compose_runtime
from luce.compiler.mir.optimizer import Optimizer
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.pipeline import compile_runtime
from luce.compiler.runtime_package import sealed_runtime_package
import std.strings
from compiler.mir.lowering_support import agree, interpreter_layout, lowered, render_mir


pub func test_tasks_lower_to_one_group_and_typed_worker_transfers():
    let source = (
        "func increment(value: i64) -> i64: return value + 1\n"
        + "pub func run() -> i64!:\n"
        + "    let work = spawn increment(41)\n"
        + "    defer work.cancel()\n"
        + "    return try work.wait()\n"
    )
    let program = lowered(source)
    let index = find_mir_function(program, "main.run")
    assert(index >= 0)
    let function = program.functions[index]
    var creates = 0
    var spawns = 0
    var waits = 0
    var cancels = 0
    var finishes = 0
    for instruction in function.body:
        match instruction.form:
            TaskGroupCreate(result): creates += 1
            TaskSpawn(result, group, target, arguments):
                spawns += 1
                assert(arguments.count == 1)
                let transfer = transfer_at(function, arguments, 0)
                assert(transfer.value_type.value == builtin_mir_type(BuiltinMirType.signed_i64).value)
                assert(target.value == 0)
            TaskWait(result, destination, failure, error_destination, task): waits += 1
            TaskCancel(task): cancels += 1
            TaskGroupFinish(group): finishes += 1
            else: pass
    assert(creates == 1 and spawns == 1 and waits == 1)
    # `try` has a failure propagation exit and the explicit success return;
    # each ordinary path owns the same defer suffix and group finish.
    assert(cancels == 2 and finishes == 2)
    let optimized = Optimizer(program).optimize().program
    let optimized_run = find_mir_function(optimized, "main.run")
    let optimized_worker = find_mir_function(optimized, "main.increment")
    assert(optimized_run >= 0 and optimized_worker >= 0)
    var optimized_spawn = false
    for instruction in optimized.functions[optimized_run].body:
        match instruction.form:
            TaskSpawn(result, group, target, arguments):
                optimized_spawn = true
                assert(i64(target.value) == optimized_worker)
                assert(transfer_at(optimized.functions[optimized_run], arguments, 0).value_type.value == builtin_mir_type(BuiltinMirType.signed_i64).value)
            else: pass
    assert(optimized_spawn)
    assert(agree(source + "pub func answer() -> i64:\n    return run() catch failure: recover 0\n") == "42")

pub func test_task_results_are_cached_and_wait_all_preserves_order():
    let source = (
        "func double(value: i64) -> i64: return value * 2\n"
        + "func identity[T](value: T) -> T: return value\n"
        + "func join(work: task[i64]) -> i64!: return try work.wait()\n"
        + "func run() -> i64!:\n"
        + "    let first = spawn double(21)\n"
        + "    let direct = try join(first)\n"
        + "    let repeated = try wait_all([first, first])\n"
        + "    let generic = spawn identity(42)\n"
        + "    let generic_value = try generic.wait()\n"
        + "    let empty: list[task[i64]] = []\n"
        + "    let empty_values = try wait_all(empty)\n"
        + "    if repeated.length != 2u64 or repeated[0u64] != 42 or repeated[1u64] != 42: return 0\n"
        + "    if empty_values.length != 0u64 or generic_value != 42: return 0\n"
        + "    return direct\n"
        + "pub func answer() -> i64:\n"
        + "    return run() catch failure: recover 0\n"
    )
    assert(agree(source) == "42")

pub func test_empty_wait_all_preserves_the_uninhabited_never_element():
    let source = (
        "func stop() -> never: trap(\"not started\")\n"
        + "func run() -> i64!:\n"
        + "    let empty: list[task[never]] = []\n"
        + "    let values = try wait_all(empty)\n"
        + "    return 42 if values.length == 0u64 else 0\n"
        + "pub func answer() -> i64:\n"
        + "    return run() catch failure: recover 0\n"
    )
    let program = lowered(source)
    var found = false
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                TaskWaitAll(result, failure, error_destination, tasks):
                    match mir_type(program.types, function.registers[result.value]):
                        List(element):
                            match mir_type(program.types, element):
                                Uninhabited: found = true
                                else: pass
                        else: pass
                else: pass
    assert(found)
    assert(agree(source) == "42")

pub func test_task_failures_and_cancellation_cross_as_owned_errors():
    let source = (
        "let invalid: ErrorCode = ErrorCode.package(7)\n"
        + "func fail() -> i64!: error(invalid, \"remote failure\")\n"
        + "func pending() -> i64: return 1\n"
        + "func recover_failure() -> i64:\n"
        + "    let work = spawn fail()\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.code == invalid and failure.message == \"remote failure\": recover 21\n"
        + "        recover 0\n"
        + "func recover_cancel(work: task[i64]) -> i64:\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.message == \"task cancelled\": recover 7\n"
        + "        recover 0\n"
        + "pub func answer() -> i64:\n"
        + "    let work = spawn pending()\n"
        + "    work.cancel()\n"
        + "    work.cancel()\n"
        + "    return recover_failure() + recover_cancel(work) * 3\n"
    )
    assert(agree(source) == "42")

pub func test_worker_traps_map_to_the_same_task_error_in_both_oracles():
    let source = (
        "func stop() -> i64: trap(\"remote trap\")\n"
        + "pub func answer() -> i64:\n"
        + "    let work = spawn stop()\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.message == \"interpreter: trap: remote trap\": recover 42\n"
        + "        recover 0\n"
    )
    assert(agree(source) == "42")

pub func test_frozen_collection_graphs_cross_both_task_boundaries_by_value():
    let source = (
        "func inspect(values: frozen_list[i64], table: frozen_map[str, i64], tags: frozen_set[str]) -> frozen_list[i64]:\n"
        + "    if values.length != 2u64 or values[0u64] != 20 or values[1u64] != 22: return [0].snapshot()\n"
        + "    if (table[\"left\"] else 0) != 20 or (table[\"right\"] else 0) != 22: return [0].snapshot()\n"
        + "    if not tags.contains(\"ready\") or tags.contains(\"changed\"): return [0].snapshot()\n"
        + "    return [values[0u64] + values[1u64]].snapshot()\n"
        + "func run() -> i64!:\n"
        + "    let source_values = [20, 22]\n"
        + "    let source_table = {\"left\": 20, \"right\": 22}\n"
        + "    let source_tags = set[str](\"ready\")\n"
        + "    let work = spawn inspect(source_values.snapshot(), source_table.snapshot(), source_tags.snapshot())\n"
        + "    source_values[0u64] = 0\n"
        + "    source_table[\"left\"] = 0\n"
        + "    discard(source_tags.remove(\"ready\"))\n"
        + "    discard(source_tags.insert(\"changed\"))\n"
        + "    let returned = try work.wait()\n"
        + "    return returned[0u64]\n"
        + "pub func answer() -> i64:\n"
        + "    return run() catch failure: recover 0\n"
    )
    assert(agree(source) == "42")

pub func test_struct_enum_array_optional_slice_and_buffers_cross_task_domains():
    let source = (
        "enum Choice:\n"
        + "    empty\n"
        + "    answer(value: i64)\n"
        + "struct Parcel:\n"
        + "    let numbers: array[i64, 2]\n"
        + "    let label: str\n"
        + "    let payload: bytes\n"
        + "    let selected: i64?\n"
        + "    let choice: Choice\n"
        + "    let view: slice[i64]\n"
        + "func echo(value: Parcel) -> Parcel: return value\n"
        + "func run() -> i64!:\n"
        + "    var numbers: array[i64, 2] = [20, 22]\n"
        + "    let value = Parcel(numbers = numbers, label = \"lu\" + \"ce\", payload = b\"a\" + b\"bc\", selected = 7, choice = Choice.answer(value = 5), view = numbers[0u64..<2u64])\n"
        + "    let work = spawn echo(value)\n"
        + "    numbers[0u64] = 0\n"
        + "    let copied = try work.wait()\n"
        + "    if copied.label != \"luce\" or copied.payload != b\"abc\": return 0\n"
        + "    if (copied.selected else 0) != 7 or copied.numbers[0u64] + copied.numbers[1u64] != 42: return 0\n"
        + "    if copied.view[0u64] + copied.view[1u64] != 42: return 0\n"
        + "    return match copied.choice:\n"
        + "        .answer(answer_value) => answer_value + 37\n"
        + "        .empty => 0\n"
        + "pub func answer() -> i64:\n"
        + "    return run() catch failure: recover 0\n"
    )
    assert(agree(source) == "42")

pub func test_frozen_snapshots_lower_and_execute_through_the_mir_oracle():
    let source = (
        "pub func answer() -> i64:\n"
        + "    let values = [1, 2].snapshot()\n"
        + "    let table = {\"answer\": 40}.snapshot()\n"
        + "    let tags = set[str](\"ready\").snapshot()\n"
        + "    return values[1u64] + (table[\"answer\"] else 0) if tags.contains(\"ready\") else 0\n"
    )
    let program = lowered(source)
    var list_snapshots = 0
    var hash_snapshots = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                ListSnapshot(result, value, element_retain): list_snapshots += 1
                HashSnapshot(result, value, key_retain, value_retain): hash_snapshots += 1
                else: pass
    assert(list_snapshots == 1 and hash_snapshots == 2)
    let runtime = compile_runtime(sealed_runtime_package("src/runtime", ["src/runtime/allocator.native.luc"])) catch reason:
        trap(reason)
    let product = compose_runtime(program, runtime.program) catch reason:
        trap(reason)
    let optimized = Optimizer(product).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    let values = MirInterpreter(optimized, interpreter_layout()).run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(render_mir(values) == "42")
    assert(agree(source) == "42")
