#==============================================================================================
#
#   classes_test - Classes execute in the reference interpreter
#
#   DESCRIPTION:
#       Identity, ARC finalization order, and weak references
#       (profiles/full/backends/hir_execution.luc).
#
#==============================================================================================

from compiler.backends.interpreter_support import execute, integer, source_module


pub func test_classes_share_identity_mutation_and_weak_slots():
    let source = "class Node:\n    pub var value: i64\n    pub weak var parent: Node?\n\n    func init(self, value: i64):\n        self.value = value\n        self.parent = none\n\n    func increment(self): self.value += 1\n\npub func answer() -> i64:\n    let child = new Node(1)\n    let alias = child\n    alias.increment()\n    if not (alias is child) or child.value != 2: return 0\n    if true:\n        let parent = new Node(40)\n        child.parent = parent\n        if let live = child.parent:\n            if not (live is parent): return 0\n        else: return 0\n    if let escaped = child.parent: return 0\n    return child.value + 40\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_class_deinit_precedes_reverse_field_destruction():
    let source = "class Child:\n    let events: list[i64]\n    let value: i64\n\n    func init(self, events: list[i64], value: i64):\n        self.events = events\n        self.value = value\n\n    func deinit(self): self.events.append(self.value)\n\nclass Parent:\n    let events: list[i64]\n    let first: Child\n    let second: Child\n\n    func init(self, events: list[i64]):\n        self.events = events\n        self.first = new Child(events, 1)\n        self.second = new Child(events, 2)\n\n    func deinit(self): self.events.append(0)\n\npub func answer() -> i64:\n    let events = list[i64]()\n    if true:\n        let parent = new Parent(events)\n    if events.length != 3u64: return 0\n    return events[0u64] * 100 + events[1u64] * 10 + events[2u64]\n"
    assert(integer(execute([source_module("main", source)])) == 21)

pub func test_failed_class_initialization_cleans_fields_without_running_deinit():
    let source = "let invalid: ErrorCode = ErrorCode.package(1)\nclass Child:\n    let events: list[i64]\n    func init(self, events: list[i64]): self.events = events\n    func deinit(self): self.events.append(1)\n\nclass Parent:\n    let events: list[i64]\n    let child: Child\n    func init(self, events: list[i64]) -> unit!:\n        self.events = events\n        self.child = new Child(events)\n        error(invalid, \"failed\")\n    func deinit(self): self.events.append(9)\n\nfunc attempt(events: list[i64]) -> i64!:\n    let parent = try new Parent(events)\n    return 0\n\npub func answer() -> i64:\n    let events = list[i64]()\n    let ignored = attempt(events) catch failure: recover 0\n    if events.length != 1u64: return 0\n    return 42 if events[0u64] == 1 else 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)
