#==============================================================================================
#
#   closures_test - Closures and captures resolve into typed HIR
#
#   DESCRIPTION:
#       Capture discovery, shared cells, weak captures, and the closure diagnostics
#       the full profile owns (profiles/full/hir/checker.luc).
#
#==============================================================================================

from luce.compiler.hir.ir import HirCaptureKind
from luce.compiler.hir.ir import describe_type, entry_at, no_node
from compiler.hir.generator_support import checked, expect_failure, form, source_module, statement


pub func test_anonymous_functions_have_one_explicit_capture_model():
    let source = "class Owner:\n    var value: i64\n    func init(self, value: i64): self.value = value\nfunc build(offset: i64, owner: Owner) -> (func(i64) -> i64, func() -> i64, func() -> i64, func() -> i64?):\n    let copied = func [copy amount = offset] (value: i64) -> i64:\n        return value + amount\n    var current = offset\n    let next = func () -> i64:\n        current += 1\n        return current\n    let read: func() -> i64 = () => offset\n    let weak_read = func [weak owner] () -> i64?:\n        if let live = owner: return live.value\n        return none\n    return (copied, next, read, weak_read)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.closures) == 4)
    assert(len(program.functions) == 6)
    assert(len(program.shared_cells) == 1)

    let build = program.functions[1]
    match statement(program, build, 0):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ClosureValue(closure, initializers):
                    assert(initializers.count == 1)
                    assert(program.closures[closure].captures[0].kind == HirCaptureKind.value)
                else: assert(false)
        else: assert(false)
    match statement(program, build, 2):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ClosureValue(closure, initializers):
                    assert(initializers.count == 1)
                    assert(entry_at(program, initializers, 0) == i64(no_node))
                    assert(program.closures[closure].captures[0].kind == HirCaptureKind.shared_cell)
                else: assert(false)
        else: assert(false)
    match statement(program, build, 3):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ClosureValue(closure, initializers): assert(initializers.count == 1)
                else: assert(false)
        else: assert(false)
    match statement(program, build, 4):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ClosureValue(closure, initializers):
                    assert(initializers.count == 1)
                    assert(program.closures[closure].captures[0].kind == HirCaptureKind.weak_capture)
                    assert(describe_type(program.types, program.closures[closure].captures[0].value_type) == "Owner?")
                else: assert(false)
        else: assert(false)

pub func test_capture_free_lambdas_are_allocation_free_function_values():
    let source = "func choose() -> func(i64) -> bool:\n    return (value) => value > 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.closures) == 1)
    assert(len(program.closures[0].captures) == 0)
    assert(program.functions[1].closure == none)
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                FunctionAddress(function): assert(function.value == program.functions[1].symbol.value)
                else: assert(false)
        else: assert(false)

pub func test_closure_signatures_and_capture_policies_are_diagnosed():
    expect_failure(
        [source_module("main", "func bad():\n    let value = (item) => item\n")],
        "main.luc:2:17: an expression lambda requires an expected function type",
    )
    expect_failure(
        [source_module("main", "func bad(value: i64):\n    let callback = func [weak value] ():\n        return\n")],
        "main.luc:2:26: weak capture `value` requires a class value, found `i64`",
    )
    expect_failure(
        [source_module("main", "func bad(value: i64):\n    let callback: cfunc() -> i64 = () => value\n")],
        "main.luc:2:36: a capturing closure cannot become a `cfunc` value",
    )

pub func test_direct_stored_closure_cycles_require_a_weak_capture():
    expect_failure(
        [source_module("main", "class Controller:\n    var callback: (func() -> unit)?\n    func init(self): self.callback = none\n    func tick(self): return\n    func install(self):\n        self.callback = () => self.tick()\n")],
        "main.luc:6:9: storing this closure on `self` creates a strong reference cycle; capture it with `weak self`",
    )
    expect_failure(
        [source_module("main", "class Controller:\n    var callback: (func() -> unit)?\n    func init(self): self.callback = none\n    func tick(self): return\n    func install(self):\n        let callback: func() -> unit = () => self.tick()\n        self.callback = callback\n")],
        "main.luc:7:9: storing this closure on `self` creates a strong reference cycle; capture it with `weak self`",
    )
    let accepted = checked([source_module("main", "class Controller:\n    var callback: (func() -> unit)?\n    func init(self): self.callback = none\n    func tick(self): return\n    func install(self):\n        self.callback = func [weak self] ():\n            if let live = self: live.tick()\n")])
    assert(len(accepted.closures) == 1)
    assert(accepted.closures[0].captures[0].kind == HirCaptureKind.weak_capture)
    var found_install = false
    for function in accepted.functions:
        if function.name != "install": continue
        found_install = true
        match statement(accepted, function, 0):
            PlaceAssignment(symbol, steps, operation, value):
                match form(accepted, value):
                    Some(inner): pass
                    else: assert(false)
            else: assert(false)
    assert(found_install)
    expect_failure(
        [source_module("main", "class Node:\n    var peer: Node?\n    func init(self): self.peer = none\n    func connect(self): self.peer = self\n")],
        "main.luc:4:25: storing `self` through its own strong field creates a reference cycle; declare the back edge with `weak var`",
    )
    expect_failure(
        [source_module("main", "class Node:\n    var peer: Node?\n    func init(self): self.peer = none\n    func connect(self):\n        let alias = self\n        self.peer = alias\n")],
        "main.luc:6:9: storing `self` through its own strong field creates a reference cycle; declare the back edge with `weak var`",
    )
    expect_failure(
        [source_module("main", "class Node:\n    let children: list[Node]\n    func init(self): self.children = []\n    func connect(self): self.children.append(self)\n")],
        "main.luc:4:25: inserting `self` into a collection it owns creates a strong reference cycle; store `Weak[Node]` for the back edge",
    )
    let weak_edge = checked([source_module("main", "class Node:\n    weak var peer: Node?\n    func init(self): self.peer = none\n    func connect(self): self.peer = self\n")])
    assert(len(weak_edge.classes) == 1)
    let extracted_value = checked([source_module("main", "class Trace:\n    let events: list[i64]\n    let value: i64\n    func init(self, events: list[i64], value: i64):\n        self.events = events\n        self.value = value\n    func record(self): self.events.append(self.value)\n")])
    assert(len(extracted_value.classes) == 1)
    let copied_field = checked([source_module("main", "class Controller:\n    var callback: (func() -> i64)?\n    let value: i64\n    func init(self, value: i64):\n        self.callback = none\n        self.value = value\n    func install(self):\n        self.callback = func [copy value = self.value] () -> i64:\n            return value\n")])
    assert(len(copied_field.closures) == 1)
