#==============================================================================================
#
#   classes_test - Classes and weak references resolve into typed HIR
#
#   DESCRIPTION:
#       Construction with `new`, field access through identities, weak fields and
#       first-class `Weak[T]` values, and their diagnostics (profiles/full/hir/checker.luc).
#
#==============================================================================================

from luce.compiler.hir.ir import BuiltinType, HirReceiverKind
from luce.compiler.hir.ir import Value, describe_type, node_type
from luce.compiler.hir.ir import nominal_fields, resolve_builtin_type, types_match
from compiler.hir.generator_support import checked, expect_failure, form, source_module, statement


pub func test_classes_resolve_fields_lifecycle_and_construction_without_layout():
    let source = "## Shared counter.\npub class Counter:\n    ## Stable name.\n    pub let name: str\n    pub var value: i64\n    weak var peer: Counter?\n\n    pub func init(self, name: str, value: i64 = 0):\n        self.name = name\n        self.value = value\n        self.peer = none\n\n    pub func increment(self): self.value += 1\n    pub func make(name: str) -> Counter: return new Counter(name)\n    func deinit(self): return\n\npub func answer() -> bool:\n    let first = new Counter(\"one\")\n    let second = first\n    second.increment()\n    return first is second\n"
    let program = checked([source_module("main", source)])
    assert(len(program.classes) == 1)
    let counter = program.classes[0]
    assert(counter.name == "Counter" and counter.is_public)
    assert(counter.documentation[0] == "Shared counter.")
    assert(len(counter.fields) == 3)
    assert(counter.fields[0].documentation[0] == "Stable name.")
    assert(not counter.fields[0].is_mutable and not counter.fields[0].is_weak)
    assert(counter.fields[1].is_mutable and not counter.fields[1].is_weak)
    assert(counter.fields[2].is_mutable and counter.fields[2].is_weak)

    let initializer = program.functions[0]
    assert(counter.initializer.value == initializer.symbol.value)
    let init_receiver = initializer.receiver else trap("class initializer has no receiver")
    assert(init_receiver.kind == HirReceiverKind.initializer)
    assert(describe_type(program.types, init_receiver.owner) == "Counter")
    let method = program.functions[1].receiver else trap("class method has no receiver")
    assert(method.kind == HirReceiverKind.value_method)
    let factory = program.functions[2].receiver else trap("class type function has no receiver")
    assert(factory.kind == HirReceiverKind.type_function)
    let deinitializer = program.functions[3].receiver else trap("class deinitializer has no receiver")
    assert(deinitializer.kind == HirReceiverKind.deinitializer)
    let deinitializer_symbol = counter.deinitializer else trap("class lost its deinitializer")
    assert(deinitializer_symbol.value == program.functions[3].symbol.value)

    match statement(program, program.functions[4], 0):
        Binding(symbol, is_mutable, value):
            assert(describe_type(program.types, node_type(program, value)) == "Counter")
            match form(program, value):
                Initialize(function, arguments): assert(function.value == initializer.symbol.value)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[4], 3):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    match operation:
                        Identity(operand_type): assert(describe_type(program.types, operand_type) == "Counter")
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_generic_classes_infer_concrete_lifecycle_methods_and_fields():
    let source = "class Box[T]:\n    var value: T\n    func init(self, value: T): self.value = value\n    func get(self) -> T: return self.value\n    func set(self, value: T): self.value = value\n    func deinit(self): return\nfunc answer() -> i64:\n    let inferred = new Box(20)\n    inferred.set(42)\n    let explicit = new Box[str](\"luce\")\n    let contextual: Box[i64] = new Box(1)\n    return inferred.get() if explicit.get() == \"luce\" and contextual.get() == 1 else 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.classes) == 1)
    assert(len(program.classes[0].type_parameters) == 1)
    assert(len(program.generic_functions) == 4)
    var integer_fields = 0
    var string_fields = 0
    for definition in program.types.definitions:
        if definition.name == "Box[i64]":
            let fields = nominal_fields(program, definition.id)
            assert(types_match(fields[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
            integer_fields += 1
        if definition.name == "Box[str]":
            let fields = nominal_fields(program, definition.id)
            assert(types_match(fields[0].value_type, resolve_builtin_type(BuiltinType.string)))
            string_fields += 1
    assert(integer_fields == 1 and string_fields == 1)
    var integer_methods = 0
    var string_methods = 0
    for function in program.functions:
        let receiver = function.receiver
        if receiver == none: continue
        if describe_type(program.types, receiver.owner) == "Box[i64]": integer_methods += 1
        if describe_type(program.types, receiver.owner) == "Box[str]": string_methods += 1
    assert(integer_methods == 4)
    assert(string_methods == 3)

pub func test_generic_class_bounds_conformances_visibility_and_weak_fields():
    let contract = "pub interface Cell[T]:\n    func read(self) -> T\n"
    let model = "import contract\npub class Box[T] implements contract.Cell[T]:\n    pub var value: T\n    weak var peer: Box[T]?\n    pub func init(self, value: T):\n        self.value = value\n        self.peer = none\n    pub func read(self) -> T: return self.value\n"
    let client = "import contract\nimport model\nfunc erase(value: model.Box[i64]) -> contract.Cell[i64]: return value\nfunc answer() -> i64:\n    let box = new model.Box(42)\n    return erase(box).read()\n"
    let program = checked([
        source_module("contract", contract),
        source_module("model", model),
        source_module("main", client),
    ])
    assert(len(program.conformances) == 1)
    assert(describe_type(program.types, program.conformances[0].value_type) == "Box[i64]")
    let application = program.nominal_applications[program.conformances[0].value_type.value] else trap("generic class application is missing")
    match application:
        ClassApplication(class_value):
            assert(types_match(class_value.fields[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
            assert(class_value.fields[1].is_weak)
            assert(describe_type(program.types, class_value.fields[1].value_type) == "Box[i64]?")
        else: assert(false)

    let constrained = "interface Scored:\n    func score(self) -> i64\nclass Box[T: Scored]:\n    let value: T\n    func init(self, value: T): self.value = value\nfunc bad(value: Box[i64]): return\n"
    expect_failure([source_module("main", constrained)], "main.luc:6:17: type argument `i64` does not conform to `Scored` required by `T`")
    discard(checked([source_module("main", "class Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n    func make(value: T) -> Box[T]: return new Box(value)\nfunc answer() -> i64: return Box.make(42).value\n")]))
    discard(checked([source_module("main", "class Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n    func convert[U](self, value: U) -> U: return value\nfunc answer() -> i64: return (new Box(0)).convert(42)\n")]))
    expect_failure(
        [source_module("main", "class Marker[T]:\n    func init(self): return\nfunc bad(): discard(new Marker())\n")],
        "main.luc:3:21: cannot infer generic parameter `T` of `Marker`; supply explicit type arguments",
    )
    expect_failure(
        [source_module("main", "class Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\nfunc bad(): discard(new Box[i64, str](1))\n")],
        "main.luc:4:21: type `Box` needs 1 type argument(s), got 2",
    )
    expect_failure(
        [
            source_module("model", "pub class Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n"),
            source_module("main", "import model\nfunc bad(): discard(new model.Box(1))\n"),
        ],
        "main.luc:2:21: initializer `init` is private to module `model`",
    )

pub func test_weak_values_are_typed_as_nominal_nonowning_handles():
    let source = "class Observer:\n    let value: i64\n    func init(self, value: i64): self.value = value\n\nfunc observe(value: Observer) -> i64:\n    let handle: Weak[Observer] = Weak(value)\n    let copy = handle\n    if let live = copy.get(): return live.value\n    return 0\n"
    let program = checked([source_module("main", source)])
    var saw_weak_type = false
    var saw_create = false
    var saw_get = false
    for definition in program.types.definitions:
        match definition.form:
            Weak(referent):
                assert(describe_type(program.types, referent) == "Observer")
                assert(definition.name == "Weak[Observer]")
                saw_weak_type = true
            else: pass
    for node in program.nodes:
        match node.form:
            WeakCreate(value):
                saw_create = true
            WeakGet(value):
                saw_get = true
            else: pass
    assert(saw_weak_type and saw_create and saw_get)

pub func test_class_rules_reject_invalid_construction_storage_and_lifecycle():
    expect_failure([source_module("main", "class Missing:\n    let value: i64\n")], "main.luc:1:1: class `Missing` must declare exactly one `init(self, ...)`")
    expect_failure([source_module("main", "class Counter:\n    var value: i64 = 0\n    func init(self): self.value = 0\n")], "main.luc:2:5: class field `value` is initialized exactly once in `init`, not by a declaration default")
    expect_failure([source_module("main", "class Node:\n    weak let parent: Node?\n    func init(self): self.parent = none\n")], "main.luc:2:10: a weak field must use `weak var` because object destruction writes `none`")
    expect_failure([source_module("main", "class Node:\n    weak var parent: Node\n    func init(self, parent: Node): self.parent = parent\n")], "main.luc:2:10: a weak field must have optional class type `T?`")
    expect_failure([source_module("main", "class Counter:\n    var value: i64\n    func init(self): self.value = 0\nfunc make() -> Counter: return Counter()\n")], "main.luc:4:32: class `Counter` construction requires `new Counter(...)`")
    expect_failure([source_module("main", "struct Value:\n    let number: i64\nfunc make() -> Value: return new Value(number = 1)\n")], "main.luc:3:34: `new` requires a class type, found `Value`")
    expect_failure([source_module("main", "class Counter:\n    var value: i64\n    func init(self): self.value = 0\n    func deinit(self, reason: str): return\n")], "main.luc:4:5: deinitializer `deinit` takes no arguments")
    expect_failure([source_module("main", "class Counter:\n    var value: i64\n    func init(self): self.value = 0\n    func deinit(self) -> unit!: return\n")], "main.luc:4:5: deinitializer `deinit` must return `unit` and cannot fail")
    expect_failure([source_module("main", "class Counter:\n    var value: i64\n    func init(self): self.value = 0\n    func deinit(self): return\nfunc use(value: Counter): value.deinit()\n")], "main.luc:5:27: deinitializer `deinit` runs automatically at the final strong release and cannot be called directly")
    expect_failure([source_module("main", "class Counter:\n    var value: i64\n    func init(self): self.value = 0\nfunc equal(left: Counter, right: Counter) -> bool: return left == right\n")], "main.luc:4:59: `==` cannot compare `Counter`")

pub func test_weak_values_require_exact_class_construction_and_promotion():
    let observer = "class Observer:\n    let value: i64\n    func init(self): self.value = 1\n"
    expect_failure([source_module("main", "func bad(value: Weak): return\n")], "main.luc:1:17: `Weak` needs exactly one class type")
    expect_failure([source_module("main", "func bad(value: Weak[i64]): return\n")], "main.luc:1:22: `Weak[T]` requires a class type, found `i64`")
    expect_failure([source_module("main", observer + "func bad(value: Weak[Observer?]): return\n")], "main.luc:4:22: `Weak[T]` requires a class type, found `Observer?`")
    expect_failure([source_module("main", observer + "func bad(value: Weak[Observer, Observer]): return\n")], "main.luc:4:17: `Weak` needs exactly one class type")
    expect_failure([source_module("main", "func bad(): discard(Weak())\n")], "main.luc:1:21: `Weak` takes exactly one positional class value")
    expect_failure([source_module("main", "func bad(): discard(Weak(1, 2))\n")], "main.luc:1:21: `Weak` takes exactly one positional class value")
    expect_failure([source_module("main", "func bad(): discard(Weak(value = 1))\n")], "main.luc:1:21: `Weak` takes exactly one positional class value")
    expect_failure([source_module("main", "func bad(): discard(Weak(1))\n")], "main.luc:1:26: `Weak` requires a class value, found `i64`")
    expect_failure([source_module("main", observer + "func bad(value: Observer): discard(Weak[Observer](value))\n")], "main.luc:4:36: `Weak` infers its class type and takes no type arguments")
    expect_failure([source_module("main", observer + "func bad(value: Observer): discard(Weak(value).get(1))\n")], "main.luc:4:36: `Weak.get` takes no arguments")
    expect_failure([source_module("main", observer + "func bad(value: Observer): discard(Weak(value).missing())\n")], "main.luc:4:36: `Weak[Observer]` has no method `missing`")
    expect_failure([source_module("main", observer + "extern func accept(value: Weak[Observer])\n")], "main.luc:4:20: extern function `accept` parameter `value` has unsupported boundary type `Weak[Observer]`")
