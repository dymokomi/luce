#==============================================================================================
#
#   collections_test - Runtime collections resolve into typed HIR
#
#   DESCRIPTION:
#       Scoped mutable slices and the list operations that admit them
#       (profiles/full/hir/checker.luc).
#
#==============================================================================================

from luce.compiler.hir.ir import describe_type, entry_at, no_node, node_type
from luce.compiler.hir.ir import types_match
from luce.compiler.hir.ir import place_map_element_step
from compiler.hir.generator_support import checked, expect_failure, form, source_module, statement


pub func test_mutable_slices_are_explicit_scoped_parameters_and_resolved_operations():
    let source = (
        "func fill[T](view: mutable_slice[T], replacement: T):\n"
        + "    var index = 0u64\n"
        + "    while index < view.length:\n"
        + "        view[index] = replacement\n"
        + "        index += 1u64\n"
        + "func answer() -> i64:\n"
        + "    let values: list[i64] = [1, 2]\n"
        + "    values.with_mutable_slice(func (view: mutable_slice[i64]):\n"
        + "        fill(view, 21)\n"
        + "    )\n"
        + "    return values[0u64] + values[1u64]\n"
    )
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[1].parameters[0].value_type) == "mutable_slice[i64]")
    match statement(program, program.functions[0], 1):
        ExpressionStatement(value):
            match form(program, value):
                ListWithMutableSlice(receiver, callback):
                    assert(describe_type(program.types, node_type(program, receiver)) == "list[i64]")
                    assert(describe_type(program.types, node_type(program, callback)) == "func(mutable_slice[i64]) -> unit")
                else: assert(false)
        else: assert(false)

pub func test_mutable_slice_storage_escape_capture_and_native_boundaries_are_rejected():
    expect_failure([source_module("main", "func bad(view: mutable_slice[u8]):\n    let stored = view\n")], "main.luc:2:5: binding `stored` cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "func bad(view: mutable_slice[u8]) -> mutable_slice[u8]: return view\n")], "main.luc:1:1: a function cannot return callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "struct Bad:\n    let view: mutable_slice[u8]\n")], "main.luc:2:5: field `view` cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "enum Bad:\n    value(view: mutable_slice[u8])\n")], "main.luc:2:5: case payload `view` cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "func bad(view: mutable_slice[u8]):\n    let callback = func ():\n        discard(view.length)\n")], "main.luc:3:17: callback-scoped `mutable_slice` cannot be captured")
    expect_failure([source_module("main", "func bad(view: mutable_slice[u8]):\n    let callback = func [copy saved = view] ():\n        return\n")], "main.luc:2:26: closure capture `saved` cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "func consume(view: mutable_slice[u8]): return\nfunc bad(view: mutable_slice[u8]):\n    defer consume(view)\n")], "main.luc:3:19: a deferred value cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "func hide[T](value: T):\n    let stored = value\nfunc bad(view: mutable_slice[u8]): hide(view)\n")], "main.luc:3:36: parameter `value` cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "extern func bad(view: mutable_slice[u8])\n")], "main.luc:1:17: extern function `bad` parameter `view` has unsupported boundary type `mutable_slice[u8]`")
    expect_failure([source_module("main", "export c func bad(view: mutable_slice[u8]): return\n")], "main.luc:1:1: exported C function `bad` parameter `view` has unsupported boundary type `mutable_slice[u8]`")
    expect_failure([source_module("main", "func bad(callback: cfunc(mutable_slice[u8]) -> unit): return\n")], "main.luc:1:26: a `cfunc` parameter has unsupported C boundary type `mutable_slice[u8]`")
    expect_failure([source_module("main", "func bad(view: mutable_slice[u8]?): return\n")], "main.luc:1:16: an optional payload cannot store callback-scoped `mutable_slice`")
    expect_failure([source_module("main", "func bad(view: list[mutable_slice[u8]]): return\n")], "main.luc:1:21: a list element cannot store callback-scoped `mutable_slice`")

pub func test_collection_literals_honor_every_context_without_hidden_union_types():
    let source = (
        "func list_value() -> list[u8]: return [1, 2]\n"
        + "func empty_list() -> list[u8]: return []\n"
        + "func array_value() -> array[u8, 2]: return [1, 2]\n"
        + "func empty_array() -> array[u8, 0]: return []\n"
        + "func slice_value() -> slice[u8]: return [1, 2]\n"
        + "func empty_slice() -> slice[u8]: return []\n"
        + "func map_value() -> map[u8, str]: return {1: \"one\", 2: \"two\"}\n"
        + "func set_value() -> set[u8]: return set[u8](1, 2)\n"
        + "func nested() -> list[array[u8, 2]]: return [[1, 2]]\n"
    )
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[4], 0):
        ReturnStatement(value):
            assert(describe_type(program.types, node_type(program, value)) == "slice[u8]")
            match form(program, value):
                SequenceSlice(inner, start, end):
                    assert(start.value == no_node and end.value == no_node)
                    match form(program, inner):
                        List(elements): assert(elements.count == 2)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[5], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceSlice(inner, start, end):
                    match form(program, inner):
                        List(elements): assert(elements.count == 0)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[6], 0):
        ReturnStatement(value): assert(describe_type(program.types, node_type(program, value)) == "map[u8, str]")
        else: assert(false)
    match statement(program, program.functions[7], 0):
        ReturnStatement(value): assert(describe_type(program.types, node_type(program, value)) == "set[u8]")
        else: assert(false)

    expect_failure([source_module("main", "func f() -> slice[u8]: return [1, 300]\n")], "main.luc:1:35: integer literal is outside `u8` range")
    expect_failure([source_module("main", "func f(): let values = [1u8, 2u16]\n")], "main.luc:1:30: expected `u8`, found `u16`")
    expect_failure([source_module("main", "func f(): let values = {\"one\": 1, 2: 2}\n")], "main.luc:1:35: expected `str`, found `i64`")
    expect_failure([source_module("main", "func f(): let values = set[u8](1, 300)\n")], "main.luc:1:35: integer literal is outside `u8` range")

pub func test_maps_and_sets_have_resolved_hash_collection_operations_and_diagnostics():
    let source = (
        "func answer() -> i64:\n"
        + "    let counts = {\"one\": 1}\n"
        + "    counts[\"two\"] = 2\n"
        + "    let selected = counts[\"one\"]\n"
        + "    discard(counts.remove(\"missing\"))\n"
        + "    counts.reserve(8u64)\n"
        + "    let copied = counts.copy()\n"
        + "    counts.clear()\n"
        + "    let tags = set[str](\"a\", \"b\")\n"
        + "    discard(tags.contains(\"a\"))\n"
        + "    discard(tags.insert(\"c\"))\n"
        + "    discard(tags.remove(\"b\"))\n"
        + "    tags.reserve(8u64)\n"
        + "    let tag_copy = tags.copy()\n"
        + "    tags.clear()\n"
        + "    return selected else copied[\"one\"] else 0\n"
    )
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        Binding(symbol, is_mutable, value):
            assert(describe_type(program.types, node_type(program, value)) == "map[str, i64]")
            match form(program, value):
                Map(entries): assert(entries.count == 2)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 1):
        PlaceAssignment(symbol, steps, operation, value):
            assert(steps.count == 2)
            assert(u32(entry_at(program, steps, 0)) == place_map_element_step)
            match operation:
                Replace: pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 2):
        Binding(symbol, is_mutable, value):
            assert(describe_type(program.types, node_type(program, value)) == "i64?")
            match form(program, value):
                MapLookup(receiver, key): assert(describe_type(program.types, node_type(program, key)) == "str")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 7):
        Binding(symbol, is_mutable, value):
            assert(describe_type(program.types, node_type(program, value)) == "set[str]")
            match form(program, value):
                Set(elements): assert(elements.count == 2)
                else: assert(false)
        else: assert(false)

    let recursive = checked([source_module("main", "struct Node:\n    let label: str\n    let children: map[str, Node]\nfunc same(left: Node, right: Node) -> bool: return left == right\n")])
    assert(describe_type(recursive.types, recursive.structs[0].fields[1].value_type) == "map[str, Node]")

    expect_failure([source_module("main", "func f(): let values = map[str]()\n")], "main.luc:1:24: `map[K, V]()` needs exactly two type arguments")
    expect_failure([source_module("main", "func f(): let values = map[str, i64](1)\n")], "main.luc:1:24: `map[K, V]()` takes no arguments")
    expect_failure([source_module("main", "func f(): let values = map[list[i64], i64]()\n")], "main.luc:1:24: map key type `list[i64]` must satisfy `Equatable & Hashable`")
    expect_failure([source_module("main", "func f(): let values = {\"same\": 1, \"same\": 2}\n")], "main.luc:1:36: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[f64, i64]: return {0.0: 1, -0.0: 2}\n")], "main.luc:1:44: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[bytes, i64]: return {b\"x\": 1, b\"x\": 2}\n")], "main.luc:1:47: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[i64?, i64]: return {none: 1, none: 2}\n")], "main.luc:1:46: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[i64?, i64]: return {1: 1, 1: 2}\n")], "main.luc:1:43: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[(i64, str), i64]: return {(1, \"x\"): 1, (1, \"x\"): 2}\n")], "main.luc:1:56: duplicate statically equal map key")
    expect_failure([source_module("main", "func f() -> map[array[u8, 2], i64]: return {[1, 2]: 1, [1, 2]: 2}\n")], "main.luc:1:56: duplicate statically equal map key")
    expect_failure([source_module("main", "func f(): let values = {\"one\": 1, \"two\": true}\n")], "main.luc:1:42: expected `i64`, found `bool`")
    expect_failure([source_module("main", "func f(values: map[str, i64]): discard(values[1])\n")], "main.luc:1:47: expected `str`, found `i64`")
    expect_failure([source_module("main", "func f(values: map[str, i64]): values[\"one\"] += 1\n")], "main.luc:1:32: map indexed assignment supports only `=`; lookup returns an optional value")
    expect_failure([source_module("main", "func f(): let values = set[list[i64]]()\n")], "main.luc:1:24: set element type `list[i64]` must satisfy `Equatable & Hashable`")
    expect_failure([source_module("main", "func f[T: Hashable](key: T): let values = map[T, i64]()\n")], "main.luc:1:43: map key type `T` must satisfy `Equatable & Hashable`")
    expect_failure([source_module("main", "func f[T: Equatable](key: T): let values = set[T]()\n")], "main.luc:1:44: set element type `T` must satisfy `Equatable & Hashable`")
    expect_failure([source_module("main", "func f(): let values = set[str](value = \"x\")\n")], "main.luc:1:33: `set[T](...)` uses positional elements")
    expect_failure([source_module("main", "func f():\n    let values = set[str]()\n    values.insert(1)\n")], "main.luc:3:19: expected `str`, found `i64`")
    expect_failure([source_module("main", "func f(values: map[str, i64]): values.append(1)\n")], "main.luc:1:32: `map[str, i64]` has no method `append`")

    let recursive_list = "struct Node:\n    let value: i64\n    let children: list[Node]\nfunc f() -> i64:\n    let children: list[Node] = []\n    children.append(Node(value = 42, children = []))\n    return children[0u64].value\n"
    assert(len(checked([source_module("main", recursive_list)]).structs) == 1)

pub func test_optional_and_unsigned_rules_are_enforced():
    let bare_none = "func value() -> i64:\n    let missing = none\n    return 1\n"
    expect_failure([source_module("main", bare_none)], "main.luc:2:19: `none` needs an optional type from context")
    let wrong_none = "func value() -> i64: return none\n"
    expect_failure([source_module("main", wrong_none)], "main.luc:1:29: expected `i64`, found `none`")
    let negate_unsigned = "func value() -> u8:\n    let v: u8 = 3\n    return -v\n"
    expect_failure([source_module("main", negate_unsigned)], "main.luc:3:12: `-` is invalid for `u8`")
    let negative_literal = "func value() -> u8: return -1\n"
    expect_failure([source_module("main", negative_literal)], "main.luc:1:28: `-` is invalid for `u8`")
    let implicit_wrap = "func value() -> i64?: return 4\n"
    assert(describe_type(checked([source_module("main", implicit_wrap)]).types, checked([source_module("main", implicit_wrap)]).functions[0].result) == "i64?")
    let operator_wraps = checked([source_module("main", "func data() -> bytes?: return b\"a\" + b\"b\"\nfunc signed() -> i64?: return -1\nfunc span() -> range[u8]?: return 1u8..<3u8\n")])
    for function in operator_wraps.functions:
        match statement(operator_wraps, function, 0):
            ReturnStatement(value):
                match form(operator_wraps, value):
                    Some(inner): assert(not types_match(node_type(operator_wraps, inner), function.result))
                    else: assert(false)
            else: assert(false)
