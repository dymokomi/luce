#==============================================================================================
#
#   tier_test - A Base module refuses what only full Luce has
#
#   DESCRIPTION:
#       Every runtime-backed spelling is rejected in a `.lucb` module with a
#       diagnostic that names the construct and the tier it belongs to, while
#       the same spelling stays accepted in a `.luc` module (base.md §23). The
#       shared subset checks identically in both profiles.
#
#==============================================================================================

from compiler.hir.generator_support import base_source_module, checked, semantic_failure, source_module
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.ir import HirRecordLayout, ModuleAuthority, no_node
from luce.compiler.profile import Profile
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
import std.files
import std.strings

# mark: Shared subset ========================================================================

pub func test_scalar_code_checks_in_a_base_module():
    let program = checked([base_source_module("main", "pub func answer() -> i64:\n    var total = 0\n    for index in 0..<4: total += index\n    return total\n")])
    assert(len(program.functions) == 1)
    assert(program.modules[0].authority == ModuleAuthority.base)

pub func test_structs_enums_and_capture_free_lambdas_check_in_a_base_module():
    let source = "struct Point:\n    let x: i64\n    let y: i64\n\nenum Kind:\n    dot\n    line\n\npub func answer() -> i64:\n    let point = Point(x = 1, y = 2)\n    let double: func(i64) -> i64 = (value) => value * 2\n    return double(point.x + point.y)\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 2)

# mark: Tier rejections ======================================================================

pub func test_classes_belong_to_full_luce():
    let source = "class Counter:\n    var count: i64\n    func init(self): self.count = 0\n"
    assert(semantic_failure([base_source_module("main", source)]) == "main.lucb:1:1: `class` belongs to full Luce; a Luce Base module has no classes; use a struct, and a pointer where identity is needed (base.md §23)")
    assert(len(checked([source_module("main", source)]).classes) == 1)

pub func test_collection_types_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `list` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: map[str, i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `map` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: slice[u8]) -> i64: return 0\n")]) == "main.lucb:1:19: `slice` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(work: task[i64]) -> i64: return 0\n")]) == "main.lucb:1:18: `task` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(len(checked([source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]).functions) == 1)

pub func test_collection_literals_and_constructors_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = [1, 2, 3]\n    return 0\n")]) == "main.lucb:2:17: a list literal belongs to full Luce; a Luce Base module has no built-in collections; a Base `[...]` is a fixed array and needs its array type from context (base.md §4.5)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = {1: 2}\n    return 0\n")]) == "main.lucb:2:17: a map literal belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = list[i64]()\n    return 0\n")]) == "main.lucb:2:17: `list` belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    let array = checked([base_source_module("main", "pub func f() -> i64:\n    let items: array[i64, 3] = [1, 2, 3]\n    return items[1]\n")])
    assert(len(array.functions) == 1)

pub func test_closures_new_and_spawn_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    var count = 1\n    let read: func() -> i64 = () => count\n    return read()\n")]) == "main.lucb:3:31: a lambda that captures a local belongs to full Luce; a Luce Base module converts only capture-free lambdas to function pointers (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let read: func() -> i64 = func() -> i64:\n        return 1\n    return read()\n")]) == "main.lucb:2:31: a block closure belongs to full Luce; a Luce Base module has no closures (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "struct Box:\n    let value: i64\n\npub func f() -> i64:\n    let box = new Box(value = 1)\n    return 0\n")]) == "main.lucb:5:15: `new`, `alloc`, `free`, and `with` need the standard `memory` module in the package (base.md §12)")
    assert(semantic_failure([base_source_module("main", "func work() -> i64: return 1\n\npub func f() -> i64:\n    let child = spawn work()\n    return 0\n")]) == "main.lucb:4:17: `spawn` belongs to full Luce; a Luce Base module has no workers; threads are the `thread` module (base.md §15.3)")

# mark: Allocation ===========================================================================

func memory_module() -> SourceModule:
    let text = files.read("src/standard/memory.lucb") catch reason:
        trap(reason)
    return base_source_module("memory", text)

func atomic_module() -> SourceModule:
    let text = files.read("src/standard/atomic.lucb") catch reason:
        trap(reason)
    return base_source_module("atomic", text)

pub func test_fences_are_the_instruction_behind_the_atomic_module():
    assert(semantic_failure([atomic_module(), base_source_module("main", "import atomic\n\npub func f():\n    atomic.fence(.release)\n    atomic.fence(.signal)\n")]) == "")
    assert(semantic_failure([atomic_module(), base_source_module("main", "import atomic\n\npub func f():\n    atomic.fence(.strong)\n")]) == "main.lucb:4:18: `.strong` is not a memory order; the orders are `.relaxed`, `.acquire`, `.release`, `.acq_rel`, and `.seq_cst` (base.md §15.1)")
    assert(semantic_failure([atomic_module(), base_source_module("main", "import atomic\n\npub func f():\n    atomic.fence()\n")]) == "main.lucb:4:5: `atomic.fence` takes one memory order (base.md §15.1)")
    assert(semantic_failure([atomic_module(), base_source_module("main", "import atomic\n\npub func f():\n    let order = 1\n    atomic.fence(order)\n")]) == "main.lucb:5:18: `atomic.fence` takes its order as a case: `.relaxed`, `.acquire`, `.release`, `.acq_rel`, `.seq_cst`, or `.signal` (base.md §15.1)")

pub func test_allocation_forms_are_checked_against_the_memory_module():
    let prelude = "struct Box:\n    var value: i64\n\nstruct Holder:\n    var box: Box*\n\n"
    assert(semantic_failure([memory_module(), base_source_module("main", prelude + "pub func f() -> i64!:\n    let box = try new Box(value = 1) in 5\n    return 0\n")]) == "main.lucb:8:41: `i64` is not an allocator; name a `var` that implements `Allocator`, a pointer to one, or an `Allocator` view (base.md §12.2)")
    assert(semantic_failure([memory_module(), base_source_module("main", prelude + "pub func f() -> i64!:\n    let holder = try new Holder\n    return 0\n")]) == "main.lucb:8:22: `new Holder` needs a zero value, and `Holder` holds `Box*`; construct it instead (base.md §6.1, §12.2)")
    assert(semantic_failure([memory_module(), base_source_module("main", prelude + "pub func f() -> i64:\n    free(1)\n    return 0\n")]) == "main.lucb:8:5: `free` takes a `T*`, a `T[]`, or a `u8[]`, found `i64` (base.md §12.2)")
    assert(semantic_failure([memory_module(), base_source_module("main", prelude + "pub func f() -> i64!:\n    let box = try new Box(value = 1)\n    free(box)\n    return box.value\n")]) == "")

# `free` and `with` are Base words; full Luce reads `free` as a call name and
# has no `with` statement at all.
pub func test_free_and_with_belong_to_luce_base():
    assert(semantic_failure([source_module("main", "pub func f() -> i64:\n    let value = 1\n    free(value)\n    return 0\n")]) == "main.luc:3:5: unknown function `free`")
    let tokens = Tokenizer("pub func f() -> i64:\n    let value = 1\n    with value:\n        return 1\n    return 0\n", Profile.full).tokenize() catch reason:
        trap(reason)
    discard(Parser(tokens, Profile.full).parse()) catch reason:
        assert(reason == "3:10: expected newline after statement")
        return
    trap("full Luce parsed a `with` statement")

# mark: Attributes ===========================================================================

pub func test_naked_and_weak_need_what_is_not_there_yet():
    assert(semantic_failure([base_source_module("main", "naked func f() -> i64:\n    return 1\n")]) == "main.lucb:1:1: `naked` needs a body that is one `asm` block (base.md §8.9, §9.8); `asm` is not implemented yet")
    assert(semantic_failure([base_source_module("main", "weak func f() -> i64:\n    return 1\n")]) == "main.lucb:1:1: `weak` marks a symbol another definition may override, which only an exported function has (base.md §9.8, §17.6)")
    assert(semantic_failure([base_source_module("main", "weak var seed: i64 = 1\n")]) == "main.lucb:1:1: `weak var` waits for exported globals; only an exported symbol can be overridden (base.md §9.8, §17.6)")
    assert(semantic_failure([base_source_module("main", "used cold func f() -> i64:\n    return 1\n\nweak export c func g() -> i64:\n    return 2\n")]) == "")

# mark: Imports ==============================================================================

pub func test_a_base_module_imports_only_base_modules():
    let helper = source_module("helper", "pub func one() -> i64: return 1\n")
    let user = base_source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(semantic_failure([helper, user]) == "main.lucb:1:6: a Luce Base module imports only Base modules and C; `helper` is full Luce (base.md §16.2)")
    let base_helper = base_source_module("helper", "pub func one() -> i64: return 1\n")
    assert(len(checked([base_helper, user]).functions) == 2)
    let full_user = source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(len(checked([base_helper, full_user]).functions) == 2)

# mark: Pointer-width integers ===============================================================

pub func test_pointer_width_integers_resolve_only_in_a_base_module():
    let source = "pub func answer(count: usize, delta: isize) -> usize:\n    var total: usize = 40\n    total += count\n    return total\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 1)
    assert(program.types.definitions[21].name == "usize")
    assert(program.types.definitions[22].name == "isize")
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:24: `usize` belongs to Luce Base; a `.luc` module spells the integer width, and a `.lucb` module's `usize` is the target's pointer width (base.md §5.1)")

pub func test_pointer_width_literals_follow_unsigned_and_signed_rules():
    assert(len(checked([base_source_module("main", "pub func answer() -> isize:\n    let delta: isize = -1\n    return delta\n")]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    let count: usize = -1\n    return count\n")]) != "")

# mark: Layout questions =====================================================================

pub func test_layout_questions_check_as_usize_in_a_base_module():
    let source = "struct Pair:\n    let first: i64\n    let second: u8\n\npub func answer() -> usize:\n    let pair = Pair(first = 1, second = 2)\n    return sizeof(Pair) + alignof(Pair) + offsetof(Pair, second) + sizeof(pair.first) + sizeof(usize)\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 1)

pub func test_layout_questions_name_their_mistakes():
    let pair = "struct Pair:\n    let first: i64\n    let second: u8\n\n"
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(Pair, third)\n")]) == "main.lucb:6:27: `Pair` has no field `third`")
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(i64, first)\n")]) == "main.lucb:6:21: `offsetof` needs a struct type; `i64` is not a struct")
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(Pair)\n")]) == "main.lucb:6:12: `offsetof` takes a type and a field name: `offsetof(Point, x)`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    let value = 1\n    return alignof(value)\n")]) == "main.lucb:3:20: `alignof` takes a type only, as in C (base.md §5.11)")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    return sizeof(Missing)\n")]) == "main.lucb:2:19: unknown type `Missing`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> i64:\n    return sizeof(i64)\n")]) != "")

pub func test_layout_questions_are_ordinary_names_in_full_luce():
    let failure = semantic_failure([source_module("main", "pub func answer() -> u64:\n    return sizeof(i64)\n")])
    assert(strings.contains(failure, "sizeof"))

# mark: Implicit widening ====================================================================

pub func test_only_a_base_module_widens_integers_implicitly():
    let source = "pub func answer(small: u8, count: u32) -> u64:\n    let total: u64 = small + count\n    return total\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([source_module("main", source)]) == "main.luc:2:22: expected `u64`, found `u8`")
    assert(len(checked([base_source_module("main", "pub func answer(count: u32) -> usize:\n    return count\n")]).functions) == 1)
    assert(len(checked([base_source_module("main", "pub func answer(count: isize) -> i64:\n    return count\n")]).functions) == 1)

pub func test_widening_never_narrows_or_changes_signedness():
    assert(semantic_failure([base_source_module("main", "pub func answer(count: u64) -> usize:\n    return count\n")]) == "main.lucb:2:12: expected `usize`, found `u64`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: usize) -> u32:\n    return count\n")]) == "main.lucb:2:12: expected `u32`, found `usize`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: i32) -> u64:\n    return count\n")]) == "main.lucb:2:12: expected `u64`, found `i32`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: u64) -> u32:\n    return count\n")]) == "main.lucb:2:12: expected `u32`, found `u64`")


# mark: Overflow operators ===================================================================

pub func test_the_overflow_operator_family_types_in_a_base_module():
    let source = "pub func answer(a: u8, b: u8) -> u8:\n    var total = a +% b\n    total +|= b\n    total *%= 2\n    let checked: u8? = a +? b\n    let negated = -%a\n    return total -| negated +% (checked else 0)\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(a: f64, b: f64) -> f64:\n    return a +% b\n")]) == "main.lucb:2:12: `+%` requires integer operands")
    assert(semantic_failure([base_source_module("main", "pub func answer(a: i64, b: i64) -> i64:\n    return a +? b\n")]) == "main.lucb:2:12: expected `i64`, found `i64?`")
    assert(semantic_failure([base_source_module("main", "pub func answer(a: f64) -> f64:\n    return -%a\n")]) == "main.lucb:2:12: `-%` requires an integer, found `f64`")


# mark: C casts ==============================================================================

pub func test_the_c_cast_types_only_numbers_in_a_base_module():
    let source = "pub func answer(value: i64, ratio: f64) -> u8:\n    let low = (u8)value\n    let count = (i32)ratio\n    let size = (usize)value\n    return low +% (u8)count +% (u8)size\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(flag: bool) -> u8:\n    return (u8)flag\n")]) == "main.lucb:2:12: `(u8)` casts a number or a pointer; `bool` to `u8` is not one of C's casts (base.md §7.5)")
    # The cast is Base grammar: a `.luc` module never parses it.
    assert(full_parse_failure("pub func answer(value: i64) -> u8:\n    return (u8)value\n") == "2:16: expected newline after statement")


# mark: Pointers =============================================================================

pub func test_pointer_types_and_operations_check_in_a_base_module():
    let source = "struct Point:\n    var x: i64\n    let y: i64\n\npub func answer(point: Point*, count: i64*) -> i64:\n    point.x = *count\n    *count += 1\n    let view: const Point* = point\n    var local = 3\n    let address: i64* = &local\n    let field: const i64* = &view.y\n    return view.x + *address + *field\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)

pub func test_pointer_rules_name_their_violations():
    assert(semantic_failure([base_source_module("main", "pub func answer(point: const i64*):\n    *point = 1\n")]) == "main.lucb:2:5: cannot store through `const i64*`; a store needs `i64*`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> i64*:\n    let value = 1\n    return &value\n")]) == "main.lucb:3:12: expected `i64*`, found `const i64*`")
    assert(semantic_failure([base_source_module("main", "pub func answer(value: i64) -> i64:\n    return *value\n")]) == "main.lucb:2:12: `*` dereferences a pointer, found `i64`")
    assert(semantic_failure([source_module("main", "pub func answer(point: i64*) -> i64:\n    return *point\n")]) == "main.luc:1:24: `T*` belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)")
    assert(semantic_failure([source_module("main", "pub func answer(value: i64) -> i64:\n    let address = &value\n    return value\n")]) == "main.luc:2:19: `&` on a value belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)")


# mark: Nullable pointers ====================================================================

pub func test_nullable_pointers_are_ordinary_optionals_in_a_base_module():
    let source = "struct Node:\n    var value: i64\n    var next: Node*?\n\npub func answer(node: Node*?) -> i64:\n    if let here = node: return here.value\n    let fallback: Node*? = none\n    if fallback != none: return 1\n    return 0\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(node: i64*?) -> i64:\n    return *node\n")]) == "main.lucb:2:12: `*` dereferences a pointer, found `i64*?`")


# mark: Pointer arithmetic and casts =========================================================

pub func test_pointer_arithmetic_and_casts_check_in_a_base_module():
    let source = "pub func answer(first: i64*, count: usize) -> isize:\n    let last = first + count\n    let back = last - 1\n    last[0] = back[0]\n    let raw: void* = first\n    let address = (usize)first\n    let restored = (i64*?)address\n    let typed = (i64*)raw\n    if restored == none or typed < first: return 0\n    return last - first\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)

pub func test_void_pointers_have_no_element_and_no_value():
    assert(semantic_failure([base_source_module("main", "pub func answer(raw: void*) -> i64:\n    return *raw\n")]) == "main.lucb:2:12: `void*` cannot be dereferenced; cast it to a typed pointer (base.md §5.3)")
    assert(semantic_failure([base_source_module("main", "pub func answer(raw: void*) -> void*:\n    return raw + 1\n")]) == "main.lucb:2:12: `void*` has no element size; cast it to a typed pointer before arithmetic (base.md §7.7)")
    assert(semantic_failure([base_source_module("main", "pub func answer(first: i64*, second: u8*) -> isize:\n    return first - second\n")]) == "main.lucb:2:12: `-` needs pointers to one type, found `i64*` and `u8*`")
    assert(semantic_failure([base_source_module("main", "pub func answer(first: i64*, flag: bool) -> i64:\n    return (i64)first + (i64)flag\n")]) == "main.lucb:2:12: `(i64)` casts a number or a pointer; `i64*` to `i64` is not one of C's casts (base.md §7.5)")


# mark: Arrays and spans =====================================================================

pub func test_spans_check_in_a_base_module():
    let source = "pub func answer(items: u8[], fixed: u8[4]) -> usize:\n    let view: const u8[] = fixed\n    let head = items[0..<2]\n    items[1] = view[0]\n    let raw: const u8* = view.data\n    var count: usize = 0\n    for byte in fixed: count += 1\n    for byte in head: count += 1\n    return count + items.length + head.length + u8[](raw, 1).length\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)

pub func test_span_rules_name_their_violations():
    assert(semantic_failure([base_source_module("main", "pub func answer(items: const u8[]) -> u8:\n    items[0] = 1\n    return 0\n")]) == "main.lucb:2:5: cannot store through `const u8*`; a store needs `u8*`")
    assert(semantic_failure([base_source_module("main", "pub func answer(items: u8[]) -> u8:\n    return items.count\n")]) == "main.lucb:2:12: `u8[]` has `length` and `data`, not `count`")
    assert(semantic_failure([base_source_module("main", "pub func answer(first: i64*) -> u8[]:\n    return u8[](first, 1)\n")]) == "main.lucb:2:17: a span of `u8` needs a `u8*`, found `i64*`")
    # The suffix is Base grammar: a `.luc` module reads `u8[]` as an empty argument list.
    assert(full_parse_failure("pub func answer(items: u8[]) -> u8: return 0\n") == "1:27: type argument list cannot be empty")

# What a `.luc` module's parser says about a Base spelling.
# mark: Integer-backed enums ===================================================================

## `enum Access as u32:` is a Base declaration (base.md §10.3): full Luce reads
## the head as an ordinary enum and stops at `as`; Base checks that the
## representation is an integer and the values unique, as `export c enum` does.
pub func test_integer_backed_enums_belong_to_base():
    assert(full_parse_failure("enum Access as u32:\n    read = 1\n") == "1:13: expected `:`")
    assert(semantic_failure([base_source_module("main", "enum Access as f32:\n    read = 1\n")]) == "main.lucb:1:1: integer-backed enum `Access` representation must be an integer type")
    assert(semantic_failure([base_source_module("main", "enum Access as u32:\n    read = 1\n    write = 1\n")]) == "main.lucb:3:5: integer-backed enum `Access` values must be unique")
    let program = checked([base_source_module("main", "pub enum Access as u32:\n    read = 1\n    write = 2\n\npub func both() -> Access: return Access.read | Access.write\n")])
    assert(program.enums[0].is_integer_backed)
    assert(len(program.enums[0].cases) == 2)

## A tagged enum, exported to C or not, keeps its case identity: the flag
## operators belong to integer-backed enums alone.
pub func test_flag_operators_need_an_integer_backed_enum():
    assert(semantic_failure([source_module("main", "export c enum Access as u32:\n    read = 1\n\npub func f() -> Access:\n    return Access.read | Access.read\n")]) == "main.luc:5:12: `|` requires integer operands")
    assert(semantic_failure([base_source_module("main", "enum Kind:\n    dot\n    line\n\nfunc f() -> Kind:\n    return ~Kind.dot\n")]) == "main.lucb:6:12: `~` requires an integer, found `Kind`")

## Flags may hold values no case declares, so `match` needs `_`, and the
## checked conversion takes exactly one value of the representation.
pub func test_integer_backed_enum_match_and_conversion_rules():
    assert(semantic_failure([base_source_module("main", "pub enum Access as u32:\n    read = 1\n    write = 2\n\npub func f(mode: Access) -> i64:\n    match mode:\n        .read: return 1\n        .write: return 2\n")]) == "main.lucb:6:5: `match` on integer-backed enum `Access` needs a `_` arm; its operators produce values that are not declared cases (base.md §10.3)")
    assert(semantic_failure([base_source_module("main", "pub enum Access as u32:\n    read = 1\n\npub func f() -> Access:\n    return Access(1, 2)\n")]) == "main.lucb:5:12: `Access(value)` converts exactly one `u32` (base.md §10.3)")
    assert(semantic_failure([base_source_module("main", "pub enum Access as u32:\n    read = 1\n\npub func f(value: i64) -> Access:\n    return Access(value)\n")]) == "main.lucb:5:19: expected `u32`, found `i64`")

# mark: Module globals ========================================================================

## A Base module may declare `var` and `thread_local var` at top level
## (base.md §6.3); full Luce keeps mutable globals for the sealed runtime,
## and has no `thread_local` word at all.
pub func test_module_globals_belong_to_base():
    assert(semantic_failure([source_module("main", "var count: i64 = 1\n")]) == "main.luc:1:1: mutable module globals are reserved for the sealed runtime package")
    assert(full_parse_failure("thread_local var count: i64\n") == "1:1: expected a module declaration")
    let program = checked([base_source_module("main", "pub var shared: i64 = 5\nthread_local var depth: i64\n")])
    assert(len(program.globals) == 2)
    assert(not program.globals[0].is_thread_local and program.globals[0].initializer.value != no_node)
    assert(program.globals[1].is_thread_local and program.globals[1].initializer.value == no_node)

## A global is zero or holds the constant its initialiser names: the
## initialiser must be a constant expression (base.md §6.4), and a type with
## no zero value needs one.
pub func test_module_global_initialisers_are_constant_or_zero():
    assert(semantic_failure([base_source_module("main", "func f() -> i64: return 1\nvar count: i64 = f()\n")]) == "main.lucb:2:18: initialiser of global `count` must be a constant expression")
    assert(semantic_failure([base_source_module("main", "var count: i64\nvar other: i64 = count\n")]) == "main.lucb:2:18: initialiser of global `other` must be a constant expression")
    assert(semantic_failure([base_source_module("main", "var cursor: i64*\n")]) == "main.lucb:1:13: global `cursor` has no zero value because `i64*` holds `i64*`; write a constant initialiser (base.md §6.1, §6.3)")

# mark: Control flow ==========================================================================

## Labels, guarded arms, and `errdefer` are Base grammar (base.md §8.4, §8.5,
## §8.8); full Luce stops at each spelling.
pub func test_labels_guards_and_errdefer_belong_to_base():
    assert(full_parse_failure("func f() -> i64:\n    rows: for y in 0..<3:\n        break rows\n    return 0\n") == "2:9: expected newline after statement")
    assert(full_parse_failure("func f(x: i64) -> i64:\n    match x:\n        _ if x > 0: return 1\n        _: return 0\n") == "3:11: expected `:`")
    assert(full_parse_failure("func f() -> i64!:\n    errdefer g()\n    return 0\n") == "2:14: expected newline after statement")

## A label names one enclosing loop, and `break`/`continue` may name only a
## loop that encloses them (base.md §8.5).
pub func test_loop_labels_resolve_to_enclosing_loops():
    assert(semantic_failure([base_source_module("main", "func f() -> i64:\n    for y in 0..<3:\n        break rows\n    return 0\n")]) == "main.lucb:3:9: `break rows` names no enclosing loop labeled `rows` (base.md §8.5)")
    assert(semantic_failure([base_source_module("main", "func f() -> i64:\n    rows: for y in 0..<3:\n        rows: for x in 0..<3:\n            break rows\n    return 0\n")]) == "main.lucb:3:15: label `rows` already names an enclosing loop")
    let program = checked([base_source_module("main", "pub func f() -> i64:\n    var count = 0\n    rows: for y in 0..<3:\n        for x in 0..<3:\n            if x == 1: continue rows\n            count += 1\n    return count\n")])
    assert(len(program.functions) == 1)

## A guarded arm does not count toward exhaustiveness, and an arm after an
## unguarded `_` is still unreachable (base.md §8.4).
pub func test_guarded_arms_do_not_cover():
    assert(semantic_failure([base_source_module("main", "func f(x: i64) -> i64:\n    match x:\n        _ if x > 0: return 1\n")]) == "main.lucb:2:5: `match` on `i64` needs a `_` arm")
    assert(semantic_failure([base_source_module("main", "func f(x: i64) -> i64:\n    match x:\n        _: return 1\n        _ if x > 0: return 2\n")]) == "main.lucb:4:9: this arm is unreachable; an earlier `_` matches everything")

## `errdefer` needs a fallible function to leave by error (base.md §8.8).
pub func test_errdefer_needs_a_fallible_function():
    assert(semantic_failure([base_source_module("main", "func g(): return\n\nfunc f() -> i64:\n    errdefer g()\n    return 0\n")]) == "main.lucb:4:5: `errdefer` needs a fallible function; no error can leave this one (base.md §8.8)")
    let program = checked([base_source_module("main", "func g(): return\n\nfunc f(fail: bool) -> i64!:\n    errdefer g()\n    defer g()\n    return 0\n")])
    assert(len(program.functions) == 2)

# mark: Atomics ===============================================================================

## `@T` takes an integer, `bool`, `usize`/`isize`, or a pointer; a plain read
## is a load and `=` a store, so `let now = hits` binds the inner type
## (base.md §5.9, §15.1).
pub func test_atomic_types_and_plain_accesses():
    assert(semantic_failure([base_source_module("main", "var ratio: @f64\n")]) == "main.lucb:1:12: `@f64` is not atomic; `@T` takes an integer, `bool`, `usize`/`isize`, a pointer, or a nullable pointer (base.md §5.9)")
    let program = checked([base_source_module("main", "var hits: @u64\n\npub func f() -> u64:\n    let now = hits\n    hits = now + 1\n    return hits.load(.acquire) + hits\n")])
    assert(len(program.functions) == 1)

## The compound operators are the integer read-modify-write instructions,
## the methods name a memory order, and `cas` refuses a failure order that
## releases (base.md §15.1).
pub func test_atomic_operations_are_checked():
    assert(semantic_failure([base_source_module("main", "var ready: @bool\n\npub func f():\n    ready += 1\n")]) == "main.lucb:4:5: `+=` needs an atomic integer, found `@bool` (base.md §15.1)")
    assert(semantic_failure([base_source_module("main", "var hits: @u64\n\npub func f() -> u64:\n    return hits.add(1, .sometime)\n")]) == "main.lucb:4:24: `.sometime` is not a memory order; the orders are `.relaxed`, `.acquire`, `.release`, `.acq_rel`, and `.seq_cst` (base.md §15.1)")
    assert(semantic_failure([base_source_module("main", "var hits: @u64\n\npub func f() -> u64:\n    return hits.max(1) + hits.min(2, .relaxed)\n")]) == "")
    assert(semantic_failure([base_source_module("main", "var hits: @u64\n\npub func f() -> u64:\n    return hits.wait(1)\n")]) == "main.lucb:4:12: `wait` on an atomic waits for the runtime's futex (base.md §15.1)")
    assert(semantic_failure([base_source_module("main", "var hits: @u64\n\npub func f() -> i64:\n    let pair = hits.cas(1, 2, .seq_cst, .release)\n    return 0\n")]) == "main.lucb:4:16: a `cas` failure order may not be `release` or `acq_rel` (base.md §15.1)")

# mark: Interface views =======================================================================

## A Base interface value is a view formed from `T*`, or from `const T*` when
## no requirement mutates; a value or a non-conformer is refused (base.md §14.3).
pub func test_interface_views_form_from_pointers():
    let head = "interface Shape:\n    func area(self) -> i64\n    mutating func grow(self, by: i64)\n\nstruct Square implements Shape:\n    var side: i64\n\n    pub func area(self) -> i64: return self.side * self.side\n    pub mutating func grow(self, by: i64): self.side += by\n\n"
    assert(semantic_failure([base_source_module("main", head + "pub func f() -> i64:\n    var square = Square(side = 3)\n    let view: Shape = square\n    return view.area()\n")]) == "main.lucb:13:23: a Base interface value is a view of a conformer: form it from `&value` or a `Square*` (base.md §14.3)")
    assert(semantic_failure([base_source_module("main", head + "pub func f() -> i64:\n    var square = Square(side = 3)\n    let pointer: const Square* = &square\n    let view: Shape = pointer\n    return view.area()\n")]) == "main.lucb:14:23: a view through `const Square*` cannot satisfy the `mutating` requirement `grow` of `Shape`; form it from `Square*` (base.md §14.3)")
    assert(semantic_failure([base_source_module("main", head + "pub func f() -> i64:\n    var count = 3\n    let view: Shape = &count\n    return view.area()\n")]) == "main.lucb:13:23: type `i64` does not conform to `Shape`")
    let program = checked([base_source_module("main", "interface Show:\n    func show(self) -> i64\n\nstruct Dot implements Show:\n    pub func show(self) -> i64: return 1\n\npub func f() -> i64:\n    var dot = Dot()\n    let pointer: const Dot* = &dot\n    let view: Show = pointer\n    return view.show()\n")])
    assert(len(program.conformances) == 1)

# mark: Layout words ==========================================================================

## `packed struct` and `align(N)` are Base grammar (base.md §5.11): full Luce
## has no such words, `N` is a power of two, and `align(N)` precedes a field.
pub func test_layout_words_belong_to_base():
    assert(full_parse_failure("packed struct Header:\n    var tag: u8\n") == "1:1: expected a module declaration")
    assert(base_parse_failure("align(3) struct Line:\n    var first: u8\n") == "1:7: `align(N)` takes a power of two, found 3")
    assert(base_parse_failure("struct Line:\n    align(4) func f(self): return\n") == "2:14: `align(N)` precedes a field")
    let program = checked([base_source_module("main", "packed struct Header:\n    var tag: u8\n    var length: u32\n\nalign(16) struct Line:\n    var first: u8\n    align(8) var second: u8\n")])
    assert(program.structs[0].is_packed and program.structs[0].alignment == 0)
    assert(not program.structs[1].is_packed and program.structs[1].alignment == 16)
    assert(program.structs[1].fields[1].alignment == 8)

## A field of a packed struct has an address only when its alignment is one,
## through any place that reaches it (base.md §5.11).
pub func test_packed_fields_are_addressable_only_at_byte_alignment():
    assert(semantic_failure([base_source_module("main", "packed struct Header:\n    var tag: u8\n    var length: u32\n\npub func f() -> u32:\n    var header: Header = Header(tag = 1, length = 2)\n    let pointer: u32* = &header.length\n    return *pointer\n")]) == "main.lucb:7:25: cannot take the address of field `length` of packed struct `Header`; its alignment is not one (base.md §5.11)")
    assert(semantic_failure([base_source_module("main", "packed struct Header:\n    var tag: u8\n    var length: u32\n\nstruct Outer:\n    var header: Header\n\npub func f(outer: Outer*) -> u32:\n    let pointer: u32* = &outer.header.length\n    return *pointer\n")]) == "main.lucb:9:25: cannot take the address of field `length` of packed struct `Header`; its alignment is not one (base.md §5.11)")
    let program = checked([base_source_module("main", "packed struct Header:\n    var tag: u8\n    var length: u32\n\nstruct Outer:\n    var header: Header\n\npub func f(outer: Outer*) -> u8:\n    let pointer: Header* = &outer.header\n    return pointer.tag\n")])
    assert(len(program.functions) == 1)

# mark: Failure ===============================================================================

## In Base an error's message is a `str` view (base.md §11.3): `error` takes
## one, `failure.message` is one, and a full Luce module keeps its owned
## string.
pub func test_base_errors_carry_text_views():
    assert(semantic_failure([base_source_module("main", "let boom: ErrorCode = ErrorCode.package(1)\n\nfunc f() -> i64!:\n    error(boom, 3)\n")]) == "main.lucb:4:17: expected `str`, found `i64`")
    let program = checked([base_source_module("main", "let boom: ErrorCode = ErrorCode.package(1)\n\nfunc f() -> i64!:\n    error(boom, \"boom\")\n\npub func g() -> usize:\n    let value = f() catch failure:\n        let text: str = failure.message\n        return text.length\n    return 0\n")])
    assert(len(program.functions) == 2)
    assert(semantic_failure([source_module("main", "let boom: ErrorCode = ErrorCode.package(1)\n\nfunc f() -> i64!:\n    error(boom, 3)\n")]) == "main.luc:4:17: expected `str`, found `i64`")

# mark: Unions ===============================================================================

## `union Name:` is a Base declaration (base.md §10.4) whose members are
## `name: type`; full Luce has no such keyword, and a union promises no
## interface over its overlapping members.
pub func test_unions_belong_to_base():
    assert(full_parse_failure("union Value:\n    integer: i64\n") == "1:1: expected a module declaration")
    assert(base_parse_failure("union Value:\n    var integer: i64\n") == "2:5: a union member is spelled `name: type`; every member is writable (base.md §10.4)")
    assert(base_parse_failure("union Value:\n    integer: i64 = 3\n") == "2:18: expected newline after statement")
    assert(semantic_failure([base_source_module("main", "interface Show:\n    func show(self) -> i64\n\nunion Value implements Show:\n    integer: i64\n    func show(self) -> i64: return 1\n")]) == "main.lucb:4:1: a union cannot implement interfaces (base.md §10.4)")
    let program = checked([base_source_module("main", "union Slot:\n    pointer: i64*\n    word: usize\n\npub func f() -> usize:\n    var slot: Slot\n    return slot.word\n")])
    assert(len(program.structs) == 1)
    assert(program.structs[0].layout == HirRecordLayout.overlapping)

## A union stores one member at one address: construction writes exactly one,
## and the type has no equality because its members overlap (base.md §12).
pub func test_union_construction_and_equality_rules():
    assert(semantic_failure([base_source_module("main", "union Value:\n    integer: i64\n    real: f64\n\npub func f() -> i64:\n    let value = Value(integer = 1, real = 2.0)\n    return value.integer\n")]) == "main.lucb:6:17: construction of union `Value` writes exactly one member (base.md §10.4)")
    assert(semantic_failure([base_source_module("main", "union Value:\n    integer: i64\n\npub func f() -> i64:\n    let value = Value()\n    return value.integer\n")]) == "main.lucb:5:17: construction of union `Value` writes exactly one member (base.md §10.4)")
    assert(semantic_failure([base_source_module("main", "union Value:\n    integer: i64\n    real: f64\n\npub func f() -> bool:\n    let left = Value(integer = 1)\n    return left == Value(real = 2.0)\n")]) == "main.lucb:7:12: `==` cannot compare `Value`")

func base_parse_failure(source: str) -> str:
    let tokens = Tokenizer(source, Profile.base).tokenize() catch reason:
        return reason
    discard(Parser(tokens, Profile.base).parse()) catch reason:
        return reason
    return ""

func full_parse_failure(source: str) -> str:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return reason
    discard(Parser(tokens).parse()) catch reason:
        return reason
    return ""


# mark: Text views ===========================================================================

pub func test_text_is_a_view_in_a_base_module():
    let source = "pub func answer(text: str, other: str) -> usize:\n    let raw: const u8[] = text.bytes\n    let again = (str)raw\n    if text == other or again < other: return raw.length\n    return text.length\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(text: str) -> u8:\n    return text[0]\n")]) == "main.lucb:2:12: `str` does not support integer indexing; slice `text.bytes` or iterate (base.md §5.5)")
    assert(semantic_failure([base_source_module("main", "pub func answer(text: str) -> str:\n    return text + text\n")]) != "")
    assert(semantic_failure([base_source_module("main", "pub func answer(text: str) -> usize:\n    return text.count\n")]) == "main.lucb:2:12: `str` has `length` and `bytes`, not `count`; index its bytes or iterate (base.md §5.5)")


# mark: Zero values ==========================================================================

pub func test_a_typed_var_without_an_initialiser_is_zero_in_a_base_module():
    let source = "pub func answer() -> i64:\n    var count: i64\n    var next: i64*?\n    var raw: u8[8] = ---\n    raw[0] = 1\n    if next == none: count += (i64)raw[0]\n    return count\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)

pub func test_zero_values_name_their_limits():
    assert(semantic_failure([base_source_module("main", "pub func answer() -> i64:\n    let count: i64\n    return count\n")]) == "main.lucb:2:5: a `let` requires an initialiser; only a `var` with a written type holds its zero (base.md §6.1)")
    assert(semantic_failure([base_source_module("main", "pub func answer(value: i64*) -> i64:\n    var pointer: i64*\n    return *value\n")]) == "main.lucb:2:5: `i64*` has no zero value because it holds `i64*`; write an initialiser or `= ---` (base.md §6.1)")
    assert(semantic_failure([base_source_module("main", "struct Holder:\n    var slot: i64*\n\npub func answer() -> i64:\n    var holder: Holder\n    return 0\n")]) == "main.lucb:5:5: `Holder` has no zero value because it holds `i64*`; write an initialiser or `= ---` (base.md §6.1)")
    assert(full_parse_failure("pub func answer() -> i64:\n    var count: i64\n    return count\n") == "2:19: expected `=`")
