#==============================================================================================
#
#   tier_test - A Base module refuses what only full Luce has
#
#   DESCRIPTION:
#       Every runtime-backed spelling is rejected in a `.lucb` module with a
#       diagnostic that names the construct and the tier it belongs to, while
#       the same spelling stays accepted in a `.luc` module (base.md §23). The
#       shared subset checks identically in both profiles.
#
#==============================================================================================

from compiler.hir.generator_support import base_source_module, checked, semantic_failure, source_module
from luce.compiler.hir.ir import ModuleAuthority
import std.strings

# mark: Shared subset ========================================================================

pub func test_scalar_code_checks_in_a_base_module():
    let program = checked([base_source_module("main", "pub func answer() -> i64:\n    var total = 0\n    for index in 0..<4: total += index\n    return total\n")])
    assert(len(program.functions) == 1)
    assert(program.modules[0].authority == ModuleAuthority.base)

pub func test_structs_enums_and_capture_free_lambdas_check_in_a_base_module():
    let source = "struct Point:\n    let x: i64\n    let y: i64\n\nenum Kind:\n    dot\n    line\n\npub func answer() -> i64:\n    let point = Point(x = 1, y = 2)\n    let double: func(i64) -> i64 = (value) => value * 2\n    return double(point.x + point.y)\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 2)

# mark: Tier rejections ======================================================================

pub func test_classes_belong_to_full_luce():
    let source = "class Counter:\n    var count: i64\n    func init(self): self.count = 0\n"
    assert(semantic_failure([base_source_module("main", source)]) == "main.lucb:1:1: `class` belongs to full Luce; a Luce Base module has no classes; use a struct, and a pointer where identity is needed (base.md §23)")
    assert(len(checked([source_module("main", source)]).classes) == 1)

pub func test_collection_types_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `list` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: map[str, i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `map` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: slice[u8]) -> i64: return 0\n")]) == "main.lucb:1:19: `slice` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(work: task[i64]) -> i64: return 0\n")]) == "main.lucb:1:18: `task` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(len(checked([source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]).functions) == 1)

pub func test_collection_literals_and_constructors_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = [1, 2, 3]\n    return 0\n")]) == "main.lucb:2:17: a list literal belongs to full Luce; a Luce Base module has no built-in collections; a Base `[...]` is a fixed array and needs its array type from context (base.md §4.5)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = {1: 2}\n    return 0\n")]) == "main.lucb:2:17: a map literal belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = list[i64]()\n    return 0\n")]) == "main.lucb:2:17: `list` belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    let array = checked([base_source_module("main", "pub func f() -> i64:\n    let items: array[i64, 3] = [1, 2, 3]\n    return items[1]\n")])
    assert(len(array.functions) == 1)

pub func test_closures_new_and_spawn_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    var count = 1\n    let read: func() -> i64 = () => count\n    return read()\n")]) == "main.lucb:3:31: a lambda that captures a local belongs to full Luce; a Luce Base module converts only capture-free lambdas to function pointers (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let read: func() -> i64 = func() -> i64:\n        return 1\n    return read()\n")]) == "main.lucb:2:31: a block closure belongs to full Luce; a Luce Base module has no closures (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "struct Box:\n    let value: i64\n\npub func f() -> i64:\n    let box = new Box(value = 1)\n    return 0\n")]) == "main.lucb:5:15: `new` of a class belongs to full Luce; a Luce Base module has no classes; Base `new` allocates from an allocator and lands with B3")
    assert(semantic_failure([base_source_module("main", "func work() -> i64: return 1\n\npub func f() -> i64:\n    let child = spawn work()\n    return 0\n")]) == "main.lucb:4:17: `spawn` belongs to full Luce; a Luce Base module has no workers; threads are the `thread` module (base.md §15.3)")

# mark: Imports ==============================================================================

pub func test_a_base_module_imports_only_base_modules():
    let helper = source_module("helper", "pub func one() -> i64: return 1\n")
    let user = base_source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(semantic_failure([helper, user]) == "main.lucb:1:6: a Luce Base module imports only Base modules and C; `helper` is full Luce (base.md §16.2)")
    let base_helper = base_source_module("helper", "pub func one() -> i64: return 1\n")
    assert(len(checked([base_helper, user]).functions) == 2)
    let full_user = source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(len(checked([base_helper, full_user]).functions) == 2)

# mark: Pointer-width integers ===============================================================

pub func test_pointer_width_integers_resolve_only_in_a_base_module():
    let source = "pub func answer(count: usize, delta: isize) -> usize:\n    var total: usize = 40\n    total += count\n    return total\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 1)
    assert(program.types.definitions[21].name == "usize")
    assert(program.types.definitions[22].name == "isize")
    assert(semantic_failure([source_module("main", source)]) == "main.luc:1:24: `usize` belongs to Luce Base; a `.luc` module spells the integer width, and a `.lucb` module's `usize` is the target's pointer width (base.md §5.1)")

pub func test_pointer_width_literals_follow_unsigned_and_signed_rules():
    assert(len(checked([base_source_module("main", "pub func answer() -> isize:\n    let delta: isize = -1\n    return delta\n")]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    let count: usize = -1\n    return count\n")]) != "")

# mark: Layout questions =====================================================================

pub func test_layout_questions_check_as_usize_in_a_base_module():
    let source = "struct Pair:\n    let first: i64\n    let second: u8\n\npub func answer() -> usize:\n    let pair = Pair(first = 1, second = 2)\n    return sizeof(Pair) + alignof(Pair) + offsetof(Pair, second) + sizeof(pair.first) + sizeof(usize)\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 1)

pub func test_layout_questions_name_their_mistakes():
    let pair = "struct Pair:\n    let first: i64\n    let second: u8\n\n"
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(Pair, third)\n")]) == "main.lucb:6:27: `Pair` has no field `third`")
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(i64, first)\n")]) == "main.lucb:6:21: `offsetof` needs a struct type; `i64` is not a struct")
    assert(semantic_failure([base_source_module("main", pair + "pub func answer() -> usize:\n    return offsetof(Pair)\n")]) == "main.lucb:6:12: `offsetof` takes a type and a field name: `offsetof(Point, x)`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    let value = 1\n    return alignof(value)\n")]) == "main.lucb:3:20: `alignof` takes a type only, as in C (base.md §5.11)")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> usize:\n    return sizeof(Missing)\n")]) == "main.lucb:2:19: unknown type `Missing`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> i64:\n    return sizeof(i64)\n")]) != "")

pub func test_layout_questions_are_ordinary_names_in_full_luce():
    let failure = semantic_failure([source_module("main", "pub func answer() -> u64:\n    return sizeof(i64)\n")])
    assert(strings.contains(failure, "sizeof"))

# mark: Implicit widening ====================================================================

pub func test_only_a_base_module_widens_integers_implicitly():
    let source = "pub func answer(small: u8, count: u32) -> u64:\n    let total: u64 = small + count\n    return total\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([source_module("main", source)]) == "main.luc:2:22: expected `u64`, found `u8`")
    assert(len(checked([base_source_module("main", "pub func answer(count: u32) -> usize:\n    return count\n")]).functions) == 1)
    assert(len(checked([base_source_module("main", "pub func answer(count: isize) -> i64:\n    return count\n")]).functions) == 1)

pub func test_widening_never_narrows_or_changes_signedness():
    assert(semantic_failure([base_source_module("main", "pub func answer(count: u64) -> usize:\n    return count\n")]) == "main.lucb:2:12: expected `usize`, found `u64`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: usize) -> u32:\n    return count\n")]) == "main.lucb:2:12: expected `u32`, found `usize`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: i32) -> u64:\n    return count\n")]) == "main.lucb:2:12: expected `u64`, found `i32`")
    assert(semantic_failure([base_source_module("main", "pub func answer(count: u64) -> u32:\n    return count\n")]) == "main.lucb:2:12: expected `u32`, found `u64`")


# mark: Overflow operators ===================================================================

pub func test_the_overflow_operator_family_types_in_a_base_module():
    let source = "pub func answer(a: u8, b: u8) -> u8:\n    var total = a +% b\n    total +|= b\n    total *%= 2\n    let checked: u8? = a +? b\n    let negated = -%a\n    return total -| negated +% (checked else 0)\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(a: f64, b: f64) -> f64:\n    return a +% b\n")]) == "main.lucb:2:12: `+%` requires integer operands")
    assert(semantic_failure([base_source_module("main", "pub func answer(a: i64, b: i64) -> i64:\n    return a +? b\n")]) == "main.lucb:2:12: expected `i64`, found `i64?`")
    assert(semantic_failure([base_source_module("main", "pub func answer(a: f64) -> f64:\n    return -%a\n")]) == "main.lucb:2:12: `-%` requires an integer, found `f64`")


# mark: C casts ==============================================================================

pub func test_the_c_cast_types_only_numbers_in_a_base_module():
    let source = "pub func answer(value: i64, ratio: f64) -> u8:\n    let low = (u8)value\n    let count = (i32)ratio\n    let size = (usize)value\n    return low +% (u8)count +% (u8)size\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(flag: bool) -> u8:\n    return (u8)flag\n")]) == "main.lucb:2:12: `(u8)` casts a number; `bool` to `u8` is not a numeric cast (base.md §7.5)")
    assert(semantic_failure([source_module("main", "pub func answer(value: i64) -> u8:\n    return (u8)value\n")]) == "main.luc:2:12: a `(T)x` cast belongs to Luce Base; a `.luc` module spells the checked conversion `T(x)` (base.md §7.5)")


# mark: Pointers =============================================================================

pub func test_pointer_types_and_operations_check_in_a_base_module():
    let source = "struct Point:\n    var x: i64\n    let y: i64\n\npub func answer(point: Point*, count: i64*) -> i64:\n    point.x = *count\n    *count += 1\n    let view: const Point* = point\n    var local = 3\n    let address: i64* = &local\n    let field: const i64* = &view.y\n    return view.x + *address + *field\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)

pub func test_pointer_rules_name_their_violations():
    assert(semantic_failure([base_source_module("main", "pub func answer(point: const i64*):\n    *point = 1\n")]) == "main.lucb:2:5: cannot store through `const i64*`; a store needs `i64*`")
    assert(semantic_failure([base_source_module("main", "pub func answer() -> i64*:\n    let value = 1\n    return &value\n")]) == "main.lucb:3:12: expected `i64*`, found `const i64*`")
    assert(semantic_failure([base_source_module("main", "pub func answer(value: i64) -> i64:\n    return *value\n")]) == "main.lucb:2:12: `*` dereferences a pointer, found `i64`")
    assert(semantic_failure([source_module("main", "pub func answer(point: i64*) -> i64:\n    return *point\n")]) == "main.luc:1:24: `T*` belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)")
    assert(semantic_failure([source_module("main", "pub func answer(value: i64) -> i64:\n    let address = &value\n    return value\n")]) == "main.luc:2:19: `&` on a value belongs to Luce Base; a `.luc` module has no raw pointers (base.md §5.3)")


# mark: Nullable pointers ====================================================================

pub func test_nullable_pointers_are_ordinary_optionals_in_a_base_module():
    let source = "struct Node:\n    var value: i64\n    var next: Node*?\n\npub func answer(node: Node*?) -> i64:\n    if let here = node: return here.value\n    let fallback: Node*? = none\n    if fallback != none: return 1\n    return 0\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    assert(semantic_failure([base_source_module("main", "pub func answer(node: i64*?) -> i64:\n    return *node\n")]) == "main.lucb:2:12: `*` dereferences a pointer, found `i64*?`")
