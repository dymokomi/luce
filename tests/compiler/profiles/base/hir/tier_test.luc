#==============================================================================================
#
#   tier_test - A Base module refuses what only full Luce has
#
#   DESCRIPTION:
#       Every runtime-backed spelling is rejected in a `.lucb` module with a
#       diagnostic that names the construct and the tier it belongs to, while
#       the same spelling stays accepted in a `.luc` module (base.md §23). The
#       shared subset checks identically in both profiles.
#
#==============================================================================================

from compiler.hir.generator_support import base_source_module, checked, semantic_failure, source_module
from luce.compiler.hir.ir import ModuleAuthority

# mark: Shared subset ========================================================================

pub func test_scalar_code_checks_in_a_base_module():
    let program = checked([base_source_module("main", "pub func answer() -> i64:\n    var total = 0\n    for index in 0..<4: total += index\n    return total\n")])
    assert(len(program.functions) == 1)
    assert(program.modules[0].authority == ModuleAuthority.base)

pub func test_structs_enums_and_capture_free_lambdas_check_in_a_base_module():
    let source = "struct Point:\n    let x: i64\n    let y: i64\n\nenum Kind:\n    dot\n    line\n\npub func answer() -> i64:\n    let point = Point(x = 1, y = 2)\n    let double: func(i64) -> i64 = (value) => value * 2\n    return double(point.x + point.y)\n"
    let program = checked([base_source_module("main", source)])
    assert(len(program.functions) == 2)

# mark: Tier rejections ======================================================================

pub func test_classes_belong_to_full_luce():
    let source = "class Counter:\n    var count: i64\n    func init(self): self.count = 0\n"
    assert(semantic_failure([base_source_module("main", source)]) == "main.lucb:1:1: `class` belongs to full Luce; a Luce Base module has no classes; use a struct, and a pointer where identity is needed (base.md §23)")
    assert(len(checked([source_module("main", source)]).classes) == 1)

pub func test_collection_types_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `list` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: map[str, i64]) -> i64: return 0\n")]) == "main.lucb:1:19: `map` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(items: slice[u8]) -> i64: return 0\n")]) == "main.lucb:1:19: `slice` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(semantic_failure([base_source_module("main", "pub func f(work: task[i64]) -> i64: return 0\n")]) == "main.lucb:1:18: `task` belongs to full Luce; a Luce Base module has no built-in collections, workers, or reference counting (base.md §23)")
    assert(len(checked([source_module("main", "pub func f(items: list[i64]) -> i64: return 0\n")]).functions) == 1)

pub func test_collection_literals_and_constructors_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = [1, 2, 3]\n    return 0\n")]) == "main.lucb:2:17: a list literal belongs to full Luce; a Luce Base module has no built-in collections; a Base `[...]` is a fixed array and needs its array type from context (base.md §4.5)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = {1: 2}\n    return 0\n")]) == "main.lucb:2:17: a map literal belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let items = list[i64]()\n    return 0\n")]) == "main.lucb:2:17: `list` belongs to full Luce; a Luce Base module has no built-in collections (base.md §12.1)")
    let array = checked([base_source_module("main", "pub func f() -> i64:\n    let items: array[i64, 3] = [1, 2, 3]\n    return items[1]\n")])
    assert(len(array.functions) == 1)

pub func test_closures_new_and_spawn_belong_to_full_luce():
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    var count = 1\n    let read: func() -> i64 = () => count\n    return read()\n")]) == "main.lucb:3:31: a lambda that captures a local belongs to full Luce; a Luce Base module converts only capture-free lambdas to function pointers (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "pub func f() -> i64:\n    let read: func() -> i64 = func() -> i64:\n        return 1\n    return read()\n")]) == "main.lucb:2:31: a block closure belongs to full Luce; a Luce Base module has no closures (base.md §9.6)")
    assert(semantic_failure([base_source_module("main", "struct Box:\n    let value: i64\n\npub func f() -> i64:\n    let box = new Box(value = 1)\n    return 0\n")]) == "main.lucb:5:15: `new` of a class belongs to full Luce; a Luce Base module has no classes; Base `new` allocates from an allocator and lands with B3")
    assert(semantic_failure([base_source_module("main", "func work() -> i64: return 1\n\npub func f() -> i64:\n    let child = spawn work()\n    return 0\n")]) == "main.lucb:4:17: `spawn` belongs to full Luce; a Luce Base module has no workers; threads are the `thread` module (base.md §15.3)")

# mark: Imports ==============================================================================

pub func test_a_base_module_imports_only_base_modules():
    let helper = source_module("helper", "pub func one() -> i64: return 1\n")
    let user = base_source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(semantic_failure([helper, user]) == "main.lucb:1:6: a Luce Base module imports only Base modules and C; `helper` is full Luce (base.md §16.2)")
    let base_helper = base_source_module("helper", "pub func one() -> i64: return 1\n")
    assert(len(checked([base_helper, user]).functions) == 2)
    let full_user = source_module("main", "from helper import one\n\npub func answer() -> i64: return one()\n")
    assert(len(checked([base_helper, full_user]).functions) == 2)
