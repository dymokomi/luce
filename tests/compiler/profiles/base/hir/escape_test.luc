#==============================================================================================
#
#   escape_test - The address of a local is passed down, never up
#
#   DESCRIPTION:
#       base.md §6.6 names four uses of a pointer or span to a local that the
#       compiler rejects, following `let` aliases within one function and
#       stopping at calls. Each is pinned by name; the allowed shapes check.
#
#==============================================================================================

from compiler.hir.generator_support import base_source_module
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator

func analysis_failure(source: str) -> str:
    let hir = HirGenerator("test.luce", [base_source_module("main", source)]).generate() catch reason:
        return "generate: " + reason
    discard(SemanticAnalyzer(hir).analyze()) catch reason:
        return reason
    return ""

pub func test_addresses_of_locals_pass_down_and_stay_in_the_frame():
    let source = "struct Pair:\n    var first: i64*\n    var second: i64*\n\nfunc read(value: const i64*) -> i64:\n    return *value\n\npub func answer() -> i64:\n    var count = 41\n    let address = &count\n    let pair = Pair(first = address, second = &count)\n    var values: i64[2] = [1, 2]\n    let view: i64[] = values\n    return read(address) + read(pair.second) + read(&view[0])\n"
    assert(analysis_failure(source) == "")

pub func test_returning_the_address_of_a_local_is_refused():
    assert(analysis_failure("pub func answer() -> i64*:\n    var count = 1\n    return &count\n") == "main.lucb:3:5: `answer` returns the address of a local; it may be passed down but not up (base.md §6.6)")
    assert(analysis_failure("pub func answer() -> const i64*:\n    var count = 1\n    let alias = &count\n    let again = alias\n    return again\n") == "main.lucb:5:5: `answer` returns the address of a local; it may be passed down but not up (base.md §6.6)")
    assert(analysis_failure("pub struct Holder:\n    var slot: i64*\n\npub func answer() -> Holder:\n    var count = 1\n    var holder = Holder(slot = &count)\n    return holder\n") == "main.lucb:7:5: `answer` returns the address of a local; it may be passed down but not up (base.md §6.6)")
    assert(analysis_failure("pub func answer() -> i64[]:\n    var values: i64[2] = [1, 2]\n    return values\n") == "main.lucb:3:5: `answer` returns the address of a local; it may be passed down but not up (base.md §6.6)")

pub func test_storing_the_address_of_a_local_where_it_outlives_the_frame_is_refused():
    assert(analysis_failure("struct Holder:\n    var slot: i64*\n\npub func fill(holder: Holder*):\n    var count = 1\n    holder.slot = &count\n") == "main.lucb:6:5: `fill` stores the address of a local through a pointer parameter (base.md §6.6)")
    assert(analysis_failure("pub func fill(slot: i64**):\n    var count = 1\n    *slot = &count\n") == "main.lucb:3:5: `fill` stores the address of a local through a pointer parameter (base.md §6.6)")
