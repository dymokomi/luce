#==============================================================================================
#
#   fixtures - Luce Base sources every backend must answer alike
#
#   DESCRIPTION:
#       Each fixture exports `answer` with the C convention so the oracles
#       call it by name and a native test links a C driver against it. The
#       expected value is part of the fixture: one source, one number, every
#       backend.
#
#==============================================================================================

pub struct BaseFixture:
    pub let name: str
    pub let source: str
    pub let expected: i64

## C's `//` and `%` truncate toward zero (base.md §7.2).
pub func c_division_fixture() -> BaseFixture:
    return BaseFixture(name = "c_division", expected = -312, source = "export c func answer() -> i64:\n    let a = -7\n    let b = 2\n    return (a // b) * 100 + (a % b) * 10 + (7 // -2) - (-7 % -2)\n")

## Same-signedness widening without a spelling (base.md §7.5).
pub func widening_fixture() -> BaseFixture:
    return BaseFixture(name = "widening", expected = 1250, source = "export c func answer() -> i64:\n    let small: u8 = 250\n    let count: u32 = 1000\n    let total: u64 = small + count\n    let index: usize = count\n    var extra = 1\n    if index == 1000: extra = 0\n    return i64(total) + extra\n")

## `+% -% *%` and unary `-%` wrap in two's complement (base.md §7.2).
pub func wrapping_fixture() -> BaseFixture:
    return BaseFixture(name = "wrapping", expected = 3750, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let wrapped = byte +% 10\n    let product: i32 = 65536 *% 65536\n    let negated: u8 = -%byte\n    let big: i64 = 9223372036854775807 +% 1\n    let signed: i8 = -128\n    return i64(wrapped) * 1000 + i64(product) + i64(negated) + (big -% big) + i64(-%signed) + i64(signed *% 3)\n")

## `+| -| *|` saturate at the type's bounds (base.md §7.2).
pub func saturating_fixture() -> BaseFixture:
    return BaseFixture(name = "saturating", expected = 508, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let high = byte +| 10\n    let low = byte -| 255\n    let signed: i8 = -100\n    let floor = signed -| 100\n    let ceil = signed *| -2\n    let wide: i64 = 9223372036854775807 *| 2\n    let mul_low: i64 = -9223372036854775807 *| 2\n    let product = byte *| byte\n    return i64(high) + i64(low) + i64(floor) + i64(ceil) + (wide - 9223372036854775807) + (mul_low + 9223372036854775807) + i64(product)\n")

## `+? -? *?` answer `none` on overflow (base.md §7.2).
pub func checked_fixture() -> BaseFixture:
    return BaseFixture(name = "checked", expected = 1383, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let none_value = byte +? 10\n    let some_value = byte -? 10\n    let big = 9223372036854775807 -? -1\n    let product = 3037000500 *? 3037000500\n    let fine = 6 *? 7\n    var total = 0\n    if none_value == none: total += 1\n    total += i64(some_value else 0)\n    if big == none: total += 100\n    if product == none: total += 1000\n    total += fine else 0\n    return total\n")

## Layout questions fold to the target's C layout (base.md §5.11); the
## pointer-width terms cancel so the answer is one number on every target.
pub func layout_fixture() -> BaseFixture:
    return BaseFixture(name = "layout", expected = 42, source = "struct Span:\n    let start: usize\n    let length: usize\n\nstruct Pair:\n    let first: i64\n    let second: u8\n\nexport c func answer() -> i64:\n    let span = Span(start = 40, length = 2)\n    var total = 0\n    if span.start + span.length == 42: total += 10\n    if sizeof(Span) == 2 * sizeof(usize): total += 10\n    if offsetof(Span, start) == 0 and offsetof(Span, length) == sizeof(usize): total += 10\n    if sizeof(Pair) == 16 and offsetof(Pair, second) == 8: total += 10\n    if alignof(Pair) == 8: total += 2\n    return total\n")

pub func base_fixtures() -> list[BaseFixture]:
    return [c_division_fixture(), widening_fixture(), wrapping_fixture(), saturating_fixture(), checked_fixture(), layout_fixture()]
