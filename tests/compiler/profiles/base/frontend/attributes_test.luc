#==============================================================================================
#
#   attributes_test - Base's declaration words parse only in a Base module
#
#   DESCRIPTION:
#       `inline`, `noinline`, `cold`, `naked`, `weak`, `used`, and
#       `section("name")` precede `func` or a top-level `var` in a `.lucb`
#       module (base.md §9.8), combine, and are refused when they repeat,
#       conflict, or precede any other declaration. In full Luce they are
#       ordinary names, and inside a body they stay ordinary names in Base.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.syntax import FunctionSyntax, ModuleSyntax, RuntimeGlobalSyntax
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.profile import Profile
from luce.compiler.symbol_attributes import InlineHint
import std.strings

func parse_base(source: str) -> ModuleSyntax:
    let tokens = Tokenizer(source, Profile.base).tokenize() catch reason:
        trap(reason)
    let module = Parser(tokens, Profile.base).parse() catch reason:
        trap(reason)
    return module

func base_failure(source: str) -> str:
    let tokens = Tokenizer(source, Profile.base).tokenize() catch reason:
        return reason
    discard(Parser(tokens, Profile.base).parse()) catch reason:
        return reason
    trap("the Base parser accepted the declaration")

func full_failure(source: str) -> str:
    let tokens = Tokenizer(source).tokenize() catch reason:
        return reason
    discard(Parser(tokens).parse()) catch reason:
        return reason
    trap("the full-Luce parser accepted a Base attribute")

func function_at(module: ModuleSyntax, index: i64) -> FunctionSyntax:
    match module.declarations[index].value:
        Function(value): return value
        ExportFunction(value): return value
        else: trap("expected a function declaration")

func global_at(module: ModuleSyntax, index: i64) -> RuntimeGlobalSyntax:
    match module.declarations[index].value:
        RuntimeGlobal(value): return value
        else: trap("expected a global declaration")

# mark: Accepted forms =======================================================================

pub func test_attribute_words_precede_func_and_var():
    let source = "pub inline func fast() -> i64:\n    return 1\n\ncold noinline func slow() -> i64:\n    return 2\n\nused section(\".isr_vector\") var vectors: u64 = 0\n\nweak export c func handler() -> i64:\n    return 3\n\nused thread_local var seed: u32 = 7\n\nfunc plain() -> i64:\n    return 4\n"
    let module = parse_base(source)
    let fast = function_at(module, 0)
    assert(fast.attributes.inlining == InlineHint.inline and not fast.attributes.is_cold)
    assert(module.declarations[0].is_public)
    let slow = function_at(module, 1)
    assert(slow.attributes.inlining == InlineHint.noinline and slow.attributes.is_cold)
    let vectors = global_at(module, 2)
    assert(vectors.attributes.is_used and not vectors.attributes.is_weak)
    assert((vectors.attributes.section else "") == ".isr_vector")
    let handler = function_at(module, 3)
    assert(handler.attributes.is_weak and handler.attributes.section == none)
    let seed = global_at(module, 4)
    assert(seed.is_thread_local and seed.attributes.is_used)
    let plain = function_at(module, 5)
    assert(not plain.attributes.is_present())

pub func test_attribute_words_stay_ordinary_names_elsewhere():
    let module = parse_base("func f() -> i64:\n    let inline = 1\n    let used = 2\n    return inline + used\n")
    assert(not function_at(module, 0).attributes.is_present())
    assert(strings.contains(full_failure("inline func fast() -> i64:\n    return 1\n"), "expected a module declaration"))

# mark: Refused forms ========================================================================

pub func test_attribute_conflicts_and_misplacements_are_diagnosed():
    assert(strings.contains(base_failure("inline noinline func f() -> i64:\n    return 1\n"), "`inline` and `noinline` exclude each other, and neither repeats (base.md §9.8)"))
    assert(strings.contains(base_failure("used used var x: i64 = 0\n"), "`used` repeats (base.md §9.8)"))
    assert(strings.contains(base_failure("cold var x: i64 = 0\n"), "`cold` marks a function, not a global (base.md §9.8)"))
    assert(strings.contains(base_failure("naked thread_local var x: i64 = 0\n"), "`naked` marks a function, not a global (base.md §9.8)"))
    assert(strings.contains(base_failure("inline struct P:\n    let x: i64\n"), "a declaration attribute precedes `func`, `var`, or `thread_local var` (base.md §9.8)"))
    assert(strings.contains(base_failure("section(name) var x: i64 = 0\n"), "`section` names its linker section with a string literal (base.md §9.8)"))
