#==============================================================================================
#
#   tokens_test - The Base spellings lex only in a Base module
#
#   DESCRIPTION:
#       The wrapping, saturating, and checked operators, `---`, `...`, and
#       `@` are tokens in a `.lucb` module and a diagnostic naming Luce Base in
#       a `.luc` module; the Base reserved words are keywords only in Base and
#       ordinary names elsewhere (base.md §§3.6, 21). One lexer serves both.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Token, TokenKind, Tokenizer, is_base_keyword, is_keyword
from luce.compiler.profile import Profile, base_only_reserved_words, base_only_symbols

func lex_base(source: str) -> list[Token]:
    let tokens = Tokenizer(source, Profile.base).tokenize() catch reason:
        trap(reason)
    return tokens

func full_failure(source: str) -> str:
    discard(Tokenizer(source).tokenize()) catch reason:
        return reason
    trap("full-Luce lexing accepted a Base spelling")

func symbol_texts(tokens: list[Token]) -> list[str]:
    let texts = list[str]()
    for token in tokens:
        if token.kind == TokenKind.symbol: texts.append(token.text)
    return texts

# mark: Base operators =======================================================================

pub func test_base_operators_lex_longest_first_in_a_base_module():
    let texts = symbol_texts(lex_base("a +% b -| c *? d\n"))
    assert(len(texts) == 3)
    assert(texts[0] == "+%")
    assert(texts[1] == "-|")
    assert(texts[2] == "*?")
    let augmented = symbol_texts(lex_base("x +%= 1\ny *|= 2\n"))
    assert(augmented[0] == "+%=")
    assert(augmented[1] == "*|=")
    let markers = symbol_texts(lex_base("var b: u8[4] = ---\nextern func p(f: cstr, ...) -> i32\nvar n: @u32\n"))
    var has_dashes = false
    var has_dots = false
    var has_at = false
    for text in markers:
        if text == "---": has_dashes = true
        if text == "...": has_dots = true
        if text == "@": has_at = true
    assert(has_dashes and has_dots and has_at)

pub func test_every_base_symbol_is_one_token_in_a_base_module():
    for symbol in base_only_symbols():
        let texts = symbol_texts(lex_base("a " + symbol + " b\n"))
        assert(len(texts) == 1)
        assert(texts[0] == symbol)

pub func test_base_operators_are_named_in_a_full_luce_module():
    assert(full_failure("a +% b\n") == "1:3: `+%` is a Luce Base spelling; a `.luc` module does not use it (base.md §21)")
    assert(full_failure("var n: @u32\n") == "1:8: `@` is a Luce Base spelling; a `.luc` module does not use it (base.md §21)")
    assert(full_failure("x = ---\n") == "1:5: `---` is a Luce Base spelling; a `.luc` module does not use it (base.md §21)")

pub func test_shared_operators_still_lex_in_both_profiles():
    let shared = symbol_texts(lex_base("a += b\nc..<d\ne // f\n"))
    assert(shared[0] == "+=")
    assert(shared[1] == "..<")
    assert(shared[2] == "//")
    let full = Tokenizer("a += b\n").tokenize() catch reason:
        trap(reason)
    assert(symbol_texts(full)[0] == "+=")

# mark: Base reserved words ==================================================================

pub func test_base_reserved_words_are_keywords_only_in_base():
    for word in base_only_reserved_words():
        assert(is_base_keyword(word))
        assert(not is_keyword(word))
    let base = lex_base("with arena:\n    free(p)\n")
    assert(base[0].kind == TokenKind.keyword)
    assert(base[0].text == "with")
    let full = Tokenizer("with arena:\n    free(p)\n").tokenize() catch reason:
        trap(reason)
    assert(full[0].kind == TokenKind.name)

pub func test_full_only_reserved_words_stay_keywords_in_base():
    let tokens = lex_base("class spawn weak\n")
    assert(tokens[0].kind == TokenKind.keyword)
    assert(tokens[1].kind == TokenKind.keyword)
    assert(tokens[2].kind == TokenKind.keyword)

# mark: Parser boundary ======================================================================

## The operator family parses at its checked spelling's precedence, with the
## augmented and unary forms (base.md §7.2); `@` waits for atomics, so a
## Base module that spells it gets a parse diagnostic, never a trap.
pub func test_the_overflow_operator_family_and_atomic_types_parse():
    let parsed = Parser(lex_base("pub func f(a: i64, b: i64) -> i64:\n    var n = a +% b *| 2\n    n -|= -%a\n    return n\n"), Profile.base).parse() catch reason:
        trap(reason)
    assert(len(parsed.declarations) == 1)
    # `@T` heads the whole type that follows (base.md §5.9).
    let atomic = Parser(lex_base("var n: @u32\nvar head: @Node*?\n"), Profile.base).parse() catch reason:
        trap(reason)
    assert(len(atomic.declarations) == 2)


# mark: Casts ================================================================================

## `(u8)value` is a cast, `(value)` a group, and `(Point)(x)` a call of a
## grouped name (base.md §7.5).
pub func test_a_parenthesised_scalar_type_reads_as_a_cast():
    let parsed = Parser(lex_base("pub func f(value: i64) -> u8:\n    let low = (u8)value\n    let same = (value)\n    let point = (Point)(value)\n    return low\n"), Profile.base).parse() catch reason:
        trap(reason)
    assert(len(parsed.declarations) == 1)


# mark: Pointer types ========================================================================

## `T*`, `const T*`, and `T*?*` are type suffixes; `a * b` stays multiplication.
pub func test_pointer_types_parse_as_type_suffixes():
    let parsed = Parser(lex_base("pub func f(a: i64*, b: const u8*, c: Node*?*, d: i64) -> i64:\n    let e: volatile u32* = a\n    return d * d + *a\n"), Profile.base).parse() catch reason:
        trap(reason)
    assert(len(parsed.declarations) == 1)
    var failure = ""
    discard(Parser(lex_base("pub func f(a: const i64) -> i64: return a\n"), Profile.base).parse()) catch reason:
        failure = reason
    assert(failure == "1:15: `const` and `volatile` qualify a pointee: write `const T*`")


# mark: Array and span suffixes ==============================================================

## `T[N]` and `T[]` are type suffixes after a complete type; a bracket that
## starts with a type stays a generic argument list (base.md §5.4).
pub func test_array_and_span_suffixes_parse_as_types():
    let parsed = Parser(lex_base("pub func f(a: u8[4], b: const u8[], c: u8[4][2], d: Node*[]) -> usize:\n    let view = u8[](b.data, 2)\n    return view.length\n"), Profile.base).parse() catch reason:
        trap(reason)
    assert(len(parsed.declarations) == 1)
