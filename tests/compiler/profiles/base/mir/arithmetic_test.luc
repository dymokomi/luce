#==============================================================================================
#
#   arithmetic_test - C's division and implicit widening in a Base module
#
#   DESCRIPTION:
#       A Base module's `//` and `%` truncate toward zero with the dividend's
#       sign (base.md §7.2), while the same source in full Luce floors; both
#       oracles and both backends agree. An integer widens implicitly to a
#       wider integer of the same signedness (base.md §7.5), including to and
#       from the pointer width, where the backend chooses between an
#       extension and a copy.
#
#==============================================================================================

from compiler.mir.lowering_support import base_lowered, base_source_module, checked_modules, lowered, only_function, source_module
from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.backends.layout import LayoutRules
from luce.compiler.backends.mir_execution_model import MirValue
from luce.compiler.backends.mir_interpreter import MirInterpreter
from luce.compiler.backends.qbe import QbeBackend
from luce.compiler.backends.wasm import WasmBackend
from luce.compiler.mir.canonical import MirProgram
from compiler.profiles.base.fixtures import BaseFixture, base_fixtures
import std.strings

func narrow() -> LayoutRules:
    return LayoutRules(pointer_size = 4, pointer_align = 4)

func wide() -> LayoutRules:
    return LayoutRules(pointer_size = 8, pointer_align = 8)

func run(program: MirProgram, rules: LayoutRules, arguments: list[MirValue]) -> MirValue:
    let results = MirInterpreter(program, rules).run("main.answer", arguments) catch reason:
        trap(reason)
    return results[0]

func signed(value: MirValue) -> i64:
    match value:
        SignedInt(item): return item
        else: trap("expected a signed integer")

func unsigned(value: MirValue) -> u64:
    match value:
        UnsignedInt(item): return item
        else: trap("expected an unsigned integer")

func failure(program: MirProgram, arguments: list[MirValue]) -> str:
    discard(MirInterpreter(program, narrow()).run("main.answer", arguments)) catch reason:
        return reason
    return ""

func hir_answer(source: str) -> str:
    let value = HirInterpreter().run(checked_modules([base_source_module("main", source)]), "main", "answer") catch reason:
        trap(reason)
    return value.render()

# mark: Division ==============================================================================

pub func test_base_division_truncates_toward_zero_and_full_luce_floors():
    let source = "pub func answer() -> i64:\n    let a = -7\n    let b = 2\n    return (a // b) * 100 + (a % b) * 10 + (7 // -2) - (-7 % -2)\n"
    assert(hir_answer(source) == "-312")
    let base = base_lowered(source)
    assert(signed(run(base, narrow(), list[MirValue]())) == -312)
    let full = lowered(source)
    assert(signed(run(full, narrow(), list[MirValue]())) == -393)
    let il = QbeBackend().emit_il(base) catch reason:
        trap(reason)
    assert(strings.contains(il, " div "))
    # The floor adjustment computes a `rem`; C's division has none to make.
    assert(not strings.contains(il, " rem "))
    let full_il = QbeBackend().emit_il(full) catch reason:
        trap(reason)
    assert(strings.contains(full_il, " rem "))
    discard(WasmBackend().emit(base)) catch reason:
        trap(reason)

pub func test_c_division_keeps_the_division_traps():
    let program = base_lowered("pub func answer(a: i64, b: i64) -> i64:\n    return a // b + a % b\n")
    assert(strings.contains(failure(program, [MirValue.SignedInt(value = 1), MirValue.SignedInt(value = 0)]), "division by zero"))
    assert(strings.contains(failure(program, [MirValue.SignedInt(value = -9223372036854775807 - 1), MirValue.SignedInt(value = -1)]), "overflow"))
    let remainder = base_lowered("pub func answer(a: i64, b: i64) -> i64:\n    return a % b\n")
    assert(signed(run(remainder, narrow(), [MirValue.SignedInt(value = -9223372036854775807 - 1), MirValue.SignedInt(value = -1)])) == 0)
    assert(signed(run(remainder, narrow(), [MirValue.SignedInt(value = -7), MirValue.SignedInt(value = 3)])) == -1)
    let unsigned_program = base_lowered("pub func answer(a: u32, b: u32) -> u32:\n    return a // b * 10 + a % b\n")
    assert(unsigned(run(unsigned_program, narrow(), [MirValue.UnsignedInt(value = u64(7)), MirValue.UnsignedInt(value = u64(2))])) == u64(31))

# mark: Widening ==============================================================================

pub func test_fixed_widths_widen_implicitly_in_a_base_module():
    let source = "pub func answer(small: u8, count: u32) -> u64:\n    let total: u64 = small + count\n    return total\n"
    let program = base_lowered(source)
    assert(unsigned(run(program, narrow(), [MirValue.UnsignedInt(value = u64(250)), MirValue.UnsignedInt(value = u64(1000))])) == u64(1250))
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "extub"))
    assert(strings.contains(il, "extuw"))

pub func test_the_pointer_width_widens_by_backend_choice():
    let into = base_lowered("pub func answer(count: u32) -> usize:\n    return count\n")
    assert(unsigned(run(into, narrow(), [MirValue.UnsignedInt(value = u64(4294967295))])) == u64(4294967295))
    assert(unsigned(run(into, wide(), [MirValue.UnsignedInt(value = u64(4294967295))])) == u64(4294967295))
    let il = QbeBackend().emit_il(into) catch reason:
        trap(reason)
    assert(strings.contains(il, "extuw"))
    discard(WasmBackend().emit(into)) catch reason:
        trap(reason)
    let out_of = base_lowered("pub func answer(count: isize) -> i64:\n    return count - 1\n")
    assert(signed(run(out_of, narrow(), [MirValue.SignedInt(value = -2147483647 - 1)])) == -2147483649)
    let wide_il = QbeBackend().emit_il(out_of) catch reason:
        trap(reason)
    assert(strings.contains(wide_il, "=l copy"))
    discard(WasmBackend().emit(out_of)) catch reason:
        trap(reason)


# mark: Every fixture, every backend =========================================================

func agree_everywhere(fixture: BaseFixture):
    assert(hir_answer(fixture.source) == str(fixture.expected))
    let program = base_lowered(fixture.source)
    assert(signed(run(program, narrow(), list[MirValue]())) == fixture.expected)
    assert(signed(run(program, wide(), list[MirValue]())) == fixture.expected)
    discard(QbeBackend().emit_il(program)) catch reason:
        trap(reason)
    discard(WasmBackend().emit(program)) catch reason:
        trap(reason)

## The shared Base fixtures answer one number through the reference
## interpreter, the MIR oracle at both pointer widths, and both encoders; the
## QBE test executes the same fixtures natively.
pub func test_every_base_fixture_agrees_across_the_oracles_and_encoders():
    for fixture in base_fixtures(): agree_everywhere(fixture)
