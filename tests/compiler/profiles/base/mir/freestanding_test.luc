#==============================================================================================
#
#   freestanding_test - A Base package lowers to a runtime-free program
#
#   DESCRIPTION:
#       The structural guard behind base.md §1.3: a lowered program that
#       holds a runtime-owned value is refused by name, while scalar and
#       aggregate programs pass. The guard reads canonical MIR types only.
#
#==============================================================================================

from compiler.mir.lowering_support import lowered
from luce.compiler.mir.freestanding import require_freestanding

pub func test_scalar_and_aggregate_programs_are_freestanding():
    let program = lowered("struct Point:\n    let x: i64\n    let y: i64\n\npub func answer() -> i64:\n    let point = Point(x = 1, y = 2)\n    var total = point.x\n    for index in 0..<3: total += point.y\n    return total\n")
    require_freestanding(program) catch reason:
        trap(reason)

pub func test_a_runtime_owned_value_is_named_and_refused():
    let program = lowered("pub func answer() -> i64:\n    let items = [1, 2, 3]\n    return items[1]\n")
    var failure = ""
    require_freestanding(program) catch reason:
        failure = reason
    assert(failure == "freestanding: `main.answer` needs the Luce runtime for its `list[i64]` value; a Luce Base artifact links none (base.md §1.3)")
