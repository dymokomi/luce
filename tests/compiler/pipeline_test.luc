#==============================================================================================
#
#   pipeline_test - Caller-provided backends plug in
#
#   DESCRIPTION:
#       Two toy backends prove the pipeline's backend contracts: anything
#       implementing HirExecutionBackend or ArtifactBackend can ride the same
#       stages the built-in backends do.
#
#==============================================================================================

from luce.compiler.backend import ArtifactBackend, HirExecutionBackend
from luce.compiler.canonical_ir import MirProgram, wasm32_layout
from luce.compiler.pipeline import PackageInput, build_with_backend, check, run_with_backend
from luce.compiler.semantic_analyzer import AnalyzedProgram
from luce.compiler.hir import Value

func package(paths: list[str]) -> PackageInput:
    return PackageInput(identity = "org.luce.pipeline-tests", source_paths = paths)

pub func test_package_identity_is_an_explicit_pipeline_input():
    let analyzed = check(package(["examples/compiled_core/main.luc"])) catch reason:
        trap(reason)
    assert(analyzed.hir.package_identity == "org.luce.pipeline-tests")

    let invalid = PackageInput(identity = "", source_paths = ["examples/compiled_core/main.luc"])
    discard(check(invalid)) catch reason:
        assert(reason == "package identity cannot be empty")
        return
    trap("expected an empty package identity to fail")

# Counts modules.
pub class ModuleCountBackend: HirExecutionBackend:
    pub init():
        return

    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        return Value.Integer(value = len(program.hir.modules))

# Emits a one-byte artifact: the number of lowered functions.
pub class FunctionCountBackend: ArtifactBackend:
    pub init():
        return

    pub func emit(program: MirProgram) -> list[u8]!:
        return [u8(len(program.functions))]

pub func test_pipeline_accepts_an_execution_backend():
    let value = run_with_backend(
        ModuleCountBackend(),
        package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]),
        "main",
        "answer",
    ) catch reason:
        trap(reason)
    match value:
        Integer(module_count): assert(module_count == 2)
        else: assert(false)

pub func test_pipeline_accepts_an_artifact_backend():
    let artifact = build_with_backend(FunctionCountBackend(), package(["examples/compiled_core/main.luc"]), wasm32_layout()) catch reason:
        trap(reason)
    assert(len(artifact) == 1)
    assert(artifact[0] == 1)

# Always fails, in both roles.
pub class RefusingBackend: HirExecutionBackend, ArtifactBackend:
    pub init():
        return

    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        error("refusing backend: cannot run `" + module_name + "." + function_name + "`")

    pub func emit(program: MirProgram) -> list[u8]!:
        error("refusing backend: cannot emit " + str(len(program.functions)) + " function(s)")

# An error raised behind the backend interfaces must reach the caller as a
# diagnostic. Stage-0 0.20 turned this into a silent trap; 0.22 fixed it.
pub func test_backend_errors_cross_the_interface_boundary():
    let paths = ["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]
    var reported = ""
    discard(run_with_backend(RefusingBackend(), package(paths), "main", "answer")) catch reason:
        reported = reason
    assert(reported == "refusing backend: cannot run `main.answer`")

    reported = ""
    discard(build_with_backend(RefusingBackend(), package(["examples/compiled_core/main.luc"]), wasm32_layout())) catch reason:
        reported = reason
    assert(reported == "refusing backend: cannot emit 1 function(s)")
