#==============================================================================================
#
#   pipeline_test - Caller-provided backends plug in
#
#   DESCRIPTION:
#       Two toy backends prove the pipeline's backend contracts: anything
#       implementing ExecutionBackend or ArtifactBackend can ride the same
#       stages the built-in backends do.
#
#==============================================================================================

from luce.compiler.backend import ArtifactBackend, ExecutionBackend
from luce.compiler.canonical_ir import CanonicalProgram
from luce.compiler.pipeline import build_with_backend, run_with_backend
from luce.compiler.typed_ir import TypedProgram, Value

# Counts modules instead of executing anything.
pub class ModuleCountBackend: ExecutionBackend:
    pub init():
        return

    pub func run(program: TypedProgram, module_name: str, function_name: str) -> Value!:
        return Value.Integer(value = len(program.modules))

# Emits a one-byte artifact: the number of lowered functions.
pub class FunctionCountBackend: ArtifactBackend:
    pub init():
        return

    pub func emit(program: CanonicalProgram) -> list[u8]!:
        return [u8(len(program.functions))]

pub func test_pipeline_accepts_an_execution_backend():
    let value = run_with_backend(
        ModuleCountBackend(),
        ["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"],
        "main",
        "answer",
    ) catch reason:
        trap(reason)
    match value:
        Integer(module_count): assert(module_count == 2)
        else: assert(false)

pub func test_pipeline_accepts_an_artifact_backend():
    let artifact = build_with_backend(FunctionCountBackend(), ["examples/compiled_core/main.luc"]) catch reason:
        trap(reason)
    assert(len(artifact) == 1)
    assert(artifact[0] == 1)
