#==============================================================================================
#
#   pipeline_test - Caller-provided HIR execution backends plug in
#
#   DESCRIPTION:
#       A toy backend proves anything implementing HirExecutionBackend can ride
#       the same analyzed-HIR path as the built-in interpreter. Artifact
#       backends instead share verified canonical MIR; their output forms are
#       intentionally different and are selected explicitly by the pipeline.
#
#==============================================================================================

from luce.compiler.backend import HirExecutionBackend
from luce.compiler.pipeline import PackageInput, RuntimeBindingInput, RuntimePackageInput, check, compile_runtime, compile_with_runtime, run_with_backend
from luce.compiler.hir.analyzer import AnalyzedProgram
from luce.compiler.hir.ir import ModuleAuthority, Value
from luce.compiler.mir.canonical import CallingConvention, find_mir_extern, mir_type
from luce.compiler.backends.layout import LayoutRules
from luce.compiler.backends.mir_interpreter import MirInterpreter, MirValue
from luce.compiler.runtime_contract import RuntimeService
import std.files
import std.paths

func package(paths: list[str]) -> PackageInput:
    return PackageInput(identity = "org.luce.pipeline-tests", source_paths = paths)

func runtime_package() -> RuntimePackageInput:
    return RuntimePackageInput(
        identity = "org.luce.runtime",
        source_paths = ["src/runtime/allocator.native.luc"],
        bindings = [
            RuntimeBindingInput(service = RuntimeService.storage_allocator, module_name = "allocator", function_name = "allocate_storage"),
            RuntimeBindingInput(service = RuntimeService.list_create, module_name = "allocator", function_name = "list_create"),
            RuntimeBindingInput(service = RuntimeService.list_copy, module_name = "allocator", function_name = "list_copy"),
            RuntimeBindingInput(service = RuntimeService.list_length, module_name = "allocator", function_name = "list_length"),
            RuntimeBindingInput(service = RuntimeService.list_append_slot, module_name = "allocator", function_name = "list_append_slot"),
            RuntimeBindingInput(service = RuntimeService.list_insert_slot, module_name = "allocator", function_name = "list_insert_slot"),
            RuntimeBindingInput(service = RuntimeService.list_remove_at, module_name = "allocator", function_name = "list_remove_at"),
            RuntimeBindingInput(service = RuntimeService.list_clear, module_name = "allocator", function_name = "list_clear"),
            RuntimeBindingInput(service = RuntimeService.list_reserve, module_name = "allocator", function_name = "list_reserve"),
            RuntimeBindingInput(service = RuntimeService.list_element_address, module_name = "allocator", function_name = "list_element_address"),
        ],
    )

pub func test_package_identity_is_an_explicit_pipeline_input():
    let analyzed = check(package(["examples/compiled_core/main.luc"])) catch reason:
        trap(reason)
    assert(analyzed.hir.package_identity == "org.luce.pipeline-tests")

    let invalid = PackageInput(identity = "", source_paths = ["examples/compiled_core/main.luc"])
    discard(check(invalid)) catch reason:
        assert(reason == "package identity cannot be empty")
        return
    trap("expected an empty package identity to fail")

pub func test_native_suffix_is_package_reader_authority_not_a_module_name():
    let scratch = files.make_temporary_directory(".", ".luce-native-authority-") catch reason:
        trap(reason)
    let source = paths.join(scratch, "raw.native.luc")
    files.write(source, "func keep(value: native_ptr[u8]) -> native_ptr[u8]: return value\n") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let analyzed = check(package([source])) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    assert(analyzed.hir.modules[0].name == "raw")
    assert(analyzed.hir.modules[0].authority == ModuleAuthority.native)

pub func test_pipeline_compiles_and_composes_the_explicit_sealed_runtime_package():
    let runtime = compile_runtime(runtime_package()) catch reason:
        trap(reason)
    assert(len(runtime.runtime_bindings) == 10)
    assert(runtime.runtime_bindings[0].service == RuntimeService.storage_allocator)
    let allocator = runtime.runtime_bindings[0].function
    assert(runtime.functions[allocator.value].name == "allocator.allocate_storage")
    assert(runtime.globals[0].name == "allocator.next_offset")
    let arena = find_mir_extern(runtime, "luce_rt_arena")
    assert(arena >= 0)
    assert(runtime.externs[arena].convention == CallingConvention.runtime)

    let combined = compile_with_runtime(package(["examples/compiled_core/main.luc"]), runtime_package()) catch reason:
        trap(reason)
    # No application operation allocates yet, so closed-world reachability
    # removes the runtime implementation and its provider as one dead unit.
    assert(len(combined.runtime_bindings) == 0)
    assert(find_mir_extern(combined, "luce_rt_arena") < 0)

pub func test_pipeline_composes_every_list_service_before_backend_selection():
    let combined = compile_with_runtime(package(["examples/lists.luc"]), runtime_package()) catch reason:
        trap(reason)
    assert(len(combined.runtime_bindings) == 10)
    assert(find_mir_extern(combined, "luce_rt_arena") >= 0)
    var creates = 0
    var copies = 0
    var appends = 0
    var inserts = 0
    var removals = 0
    var clears = 0
    var reserves = 0
    var indexes = 0
    var aggregate_remove_copied_first = false
    for function in combined.functions:
        var previous_was_copy = false
        for instruction in function.body:
            match instruction.form:
                ListCreate(result):
                    match mir_type(combined.types, function.registers[result.value]):
                        List(element): creates += 1
                        else: trap("list creation lost its canonical element type")
                ListCopy(result, value): copies += 1
                ListAppendSlot(result, value): appends += 1
                ListInsertSlot(result, value, index): inserts += 1
                ListRemoveAt(value, index):
                    removals += 1
                    if function.name == "lists.aggregate_removal" and previous_was_copy:
                        aggregate_remove_copied_first = true
                ListClear(value): clears += 1
                ListReserve(value, minimum_capacity): reserves += 1
                ListElementAddress(result, value, index): indexes += 1
                else: pass
            match instruction.form:
                Memcpy(destination, source, value_type): previous_was_copy = true
                else: previous_was_copy = false
    assert(creates >= 2 and appends >= 7 and indexes >= 5)
    assert(copies == 2 and inserts == 4 and removals == 2 and clears == 1 and reserves == 1)
    assert(aggregate_remove_copied_first)
    let values = MirInterpreter(combined, LayoutRules(pointer_size = 8, pointer_align = 8)).run("lists.main", list[MirValue]()) catch reason:
        trap(reason)
    match values[0]:
        Int(status): assert(status == 0)
        else: assert(false)

# Counts modules.
pub class ModuleCountBackend: HirExecutionBackend:
    pub init():
        return

    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        return Value.Integer(value = len(program.hir.modules))

pub func test_pipeline_accepts_an_execution_backend():
    let value = run_with_backend(
        ModuleCountBackend(),
        package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]),
        "main",
        "answer",
    ) catch reason:
        trap(reason)
    match value:
        Integer(module_count): assert(module_count == 2)
        else: assert(false)

# Always fails behind the execution interface.
pub class RefusingBackend: HirExecutionBackend:
    pub init():
        return

    pub func run(program: AnalyzedProgram, module_name: str, function_name: str) -> Value!:
        error("refusing backend: cannot run `" + module_name + "." + function_name + "`")

# An error raised behind the backend interfaces must reach the caller as a
# diagnostic. Stage-0 0.20 turned this into a silent trap; 0.22 fixed it.
pub func test_backend_errors_cross_the_interface_boundary():
    let paths = ["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]
    var reported = ""
    discard(run_with_backend(RefusingBackend(), package(paths), "main", "answer")) catch reason:
        reported = reason
    assert(reported == "refusing backend: cannot run `main.answer`")
