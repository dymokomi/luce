from luce.compiler.backend import ArtifactBackend, ExecutionBackend
from luce.compiler.canonical_ir import CanonicalProgram
from luce.compiler.pipeline import build_with, run_with
from luce.compiler.typed_ir import TypedProgram, Value

class ModuleCountBackend: ExecutionBackend:
    init():
        return

    func run(program: TypedProgram, module_name: str, function_name: str) -> Value!:
        return Value.Integer(value = len(program.modules))

class FunctionCountBackend: ArtifactBackend:
    init():
        return

    func emit(program: CanonicalProgram) -> list[u8]!:
        return [u8(len(program.functions))]

func test_pipeline_accepts_an_execution_backend():
    let value = run_with(
        ModuleCountBackend(),
        ["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"],
        "main",
        "answer",
    ) catch reason:
        trap(reason)
    match value:
        Integer(module_count): assert(module_count == 2)
        else: assert(false)

func test_pipeline_accepts_an_artifact_backend():
    let artifact = build_with(FunctionCountBackend(), ["examples/compiled_core/main.luc"]) catch reason:
        trap(reason)
    assert(len(artifact) == 1)
    assert(artifact[0] == 1)
