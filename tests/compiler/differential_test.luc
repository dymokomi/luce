    answer(items, "let invalid: ErrorCode = ErrorCode.package(1)\nfunc plain(value: i64) -> i64: return value\nfunc checked(value: i64) -> i64!: error(invalid, \"unselected\")\npub func answer() -> i64:\n    let operation = plain if true else checked\n    return operation(42) catch failure: recover 0\n", 42)
    answer(items, "interface Scored:\n    func score(self) -> i64\nstruct Number implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nfunc erase(value: Number) -> Scored: return value\npub func answer() -> i64:\n    let dynamic = erase(Number(value = 20))\n    let selected = Number(value = 0) if false else dynamic\n    let reversed = dynamic if false else Number(value = 22)\n    let maybe: Scored? = dynamic\n    let optional = Number(value = 0) if true else maybe\n    if let present = optional: return selected.score() + reversed.score() + present.score()\n    return 0\n", 42)
