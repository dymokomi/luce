func interpreter_layout() -> LayoutRules:
    return LayoutRules(pointer_size = 4, pointer_align = 4)

func runtime_package() -> RuntimePackageInput:
    return sealed_runtime_package(["src/runtime/allocator.native.luc"])

# mark: Fixtures ===============================================================================

# One program, the function to run, and what the oracle must say.
struct Fixture:
    let source: str
    let function_name: str
    let expected_value: i64
    let expected_output: str

func fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(source = "pub func answer() -> i64: return 42\n", function_name = "answer", expected_value = 42, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return 2 + 3 * 4\n", function_name = "answer", expected_value = 14, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return (2 + 3) * 4 - 6\n", function_name = "answer", expected_value = 14, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return -9223372036854775807 - 1 + 1\n", function_name = "answer", expected_value = -9223372036854775807, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i32: return 2147483646i32 + 1i32\n", function_name = "answer", expected_value = 2147483647, expected_output = ""))
    items.append(Fixture(source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"Hello, world!\")\n    return 0\n", function_name = "main", expected_value = 0, expected_output = "Hello, world!\n"))
    items.append(Fixture(source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"one\")\n    print(\"two\")\n    return 3 * 2\n", function_name = "main", expected_value = 6, expected_output = "one\ntwo\n"))
    for item in scalar_fixtures(): items.append(item)
    for item in literal_fixtures(): items.append(item)
    for item in control_flow_fixtures(): items.append(item)
    for item in call_fixtures(): items.append(item)
    for item in generic_function_fixtures(): items.append(item)
    for item in generic_method_fixtures(): items.append(item)
    for item in generic_nominal_construction_fixtures(): items.append(item)
    for item in constrained_generic_fixtures(): items.append(item)
    for item in function_value_fixtures(): items.append(item)
    for item in composite_fixtures(): items.append(item)
    for item in array_fixtures(): items.append(item)
    for item in struct_fixtures(): items.append(item)
    for item in enum_fixtures(): items.append(item)
    for item in range_fixtures(): items.append(item)
    for item in recursive_equality_fixtures(): items.append(item)
    for item in structural_hash_fixtures(): items.append(item)
    for item in formatting_fixtures(): items.append(item)
    for item in mutable_slice_fixtures(): items.append(item)
    for item in defer_fixtures(): items.append(item)
    for item in failure_fixtures(): items.append(item)
    for item in never_fixtures(): items.append(item)
    return items

# `never` is bottom at expression joins, but eager source order and conditional
# evaluation remain observable. These successful programs prove that an
# unselected divergent arm and a skipped short-circuit operand stay dormant.
func never_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "func stop() -> never: trap(\"unselected\")\npub func answer() -> i64: return 42 if true else stop()\n", 42)
    answer(items, "func stop() -> never: trap(\"short circuit\")\npub func answer() -> i64: return 42 if (false and stop()) or (true or stop()) else 0\n", 42)
    return items

# A mutable view is usable only during its synchronous callback. Existing and
# callback-created immutable slices keep their captured buffers when a later
# view write detaches the list, while ordinary aliases observe the mutations.
func mutable_slice_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, (
        "func fill[T](view: mutable_slice[T], replacement: T):\n"
        + "    var index = 0u64\n"
        + "    while index < view.length:\n"
        + "        view[index] = replacement\n"
        + "        index += 1u64\n"
        + "pub func answer() -> i64:\n"
        + "    let values: list[i64] = [1, 2, 3]\n"
        + "    let alias = values\n"
        + "    let before: slice[i64] = values[0u64..]\n"
        + "    let snapshots: list[slice[i64]] = []\n"
        + "    values.with_mutable_slice(func (view: mutable_slice[i64]):\n"
        + "        fill(view, 10)\n"
        + "        snapshots.append(values[0u64..])\n"
        + "        view[1u64] = 20\n"
        + "    )\n"
        + "    return before[0u64] + before[1u64] + before[2u64] + snapshots[0u64][0u64] + snapshots[0u64][1u64] + snapshots[0u64][2u64] + alias[0u64] + alias[1u64] + alias[2u64]\n"
    ), 76)
    items.append(Fixture(
        source = (
            "func make_values() -> list[i64]:\n    print(\"receiver\")\n    return [0]\n"
            + "func make_callback() -> func(mutable_slice[i64]) -> unit:\n"
            + "    print(\"callback\")\n"
            + "    return func (view: mutable_slice[i64]): view[0u64] = 42\n"
            + "pub func answer() -> i64:\n"
            + "    let values = make_values()\n"
            + "    values.with_mutable_slice(make_callback())\n"
            + "    return values[0u64]\n"
        ),
        function_name = "answer",
        expected_value = 42,
        expected_output = "receiver\ncallback\n",
    ))
    return items

# Formatting is one source-level protocol over a linear owned buffer builder.
# This fixture deliberately combines builtin, concrete, constrained-generic,
# and existential dispatch; nested builders; field evaluation order; Unicode;
# triple normalization; integer extrema; and the binary32/binary64 cases most
# likely to expose a width or shortest-decimal error in a backend runtime.
func formatting_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(
        source = (
            "struct Label implements Display:\n    let value: str\n    pub func display(self) -> str: return f\"<{self.value}>\"\n"
            + "func generic[T: Display](value: T) -> str: return f\"G:{value}\"\n"
            + "func dynamic(value: Display) -> str: return f\"D:{value}\"\n"
            + "func left() -> str:\n    print(\"left\")\n    return \"A\"\n"
            + "func right() -> str:\n    print(\"right\")\n    return \"B\"\n"
            + "pub func main(arguments: slice[str]) -> i32:\n"
            + "    let label = Label(\"luce\")\n"
            + "    let tenth32: f32 = 0.1\n"
            + "    let tenth16: f16 = 0.1\n"
            + "    let maximum32: f32 = 3.4028234663852886e38\n"
            + "    let minimum32: f32 = 1e-45\n"
            + "    let zero = 0.0\n"
            + "    let infinity = 1.0 / zero\n"
            + "    let not_a_number = zero / zero\n"
            + "    let negative16: f16 = -0.0\n"
            + "    let infinity16 = f16(infinity)\n"
            + "    let not_a_number16 = f16(not_a_number)\n"
            + "    print(f\"{left()}|{right()}|{label}|{generic(label)}|{dynamic(label)}|{-9223372036854775807 - 1}|{18446744073709551615u64}|{true}|{'λ'}\")\n"
            + "    print(f\"{0.1}|{1.0}|{-0.0}|{0.00001}|{0.000001}|{1e15}|{1e16}|{1.7976931348623157e308}|{5e-324}|{infinity}|{-infinity}|{not_a_number}|{negative16}|{infinity16}|{not_a_number16}|{tenth16}|{tenth32}|{maximum32}|{minimum32}\")\n"
            + "    let block = f\"\"\"\n        triple {label}\n          {{brace}}\n        \"\"\"\n"
            + "    print(block)\n"
            + "    return 0i32\n"
        ),
        function_name = "main",
        expected_value = 0,
        expected_output = (
            "left\nright\nA|B|<luce>|G:<luce>|D:<luce>|-9223372036854775808|18446744073709551615|true|λ\n"
            + "0.1|1.0|-0.0|0.00001|1e-6|1000000000000000.0|1e16|1.7976931348623157e308|5e-324|inf|-inf|nan|-0.0|inf|nan|0.099975586|0.1|3.4028235e38|1e-45\n"
            + "triple <luce>\n  {brace}\n"
        ),
    ))
    # Representative boundary, rounding, trailing-zero, and regression vectors
    # from https://github.com/ulfjack/ryu/tree/master/ryu/tests. Expected
    # spellings apply Luce's documented fixed/scientific windows to the same
    # shortest pair.
    items.append(Fixture(
        source = (
            "pub func main(arguments: slice[str]) -> i32:\n"
            + "    print(f\"{2.2250738585072014e-308}|{2.98023223876953125e-8}|{-2.109808898695963e16}|{4.940656e-318}|{1.18575755e-316}|{2.989102097996e-312}|{9.0608011534336e15}|{4.708356024711512e18}|{9.409340012568248e18}|{1.2345678}|{9007199254740991.0}|{9007199254740992.0}\")\n"
            + "    let a: f32 = 1.1754944e-38\n"
            + "    let b: f32 = 3.355445e7\n"
            + "    let c: f32 = 8.999999e9\n"
            + "    let d: f32 = 3.4366717e10\n"
            + "    let e: f32 = 3.0540412e5\n"
            + "    let g: f32 = 8.0990312e3\n"
            + "    let h: f32 = 2.4414062e-4\n"
            + "    let i: f32 = 4.3945312e-3\n"
            + "    let j: f32 = 6.3476562e-3\n"
            + "    let k: f32 = 4.7223665e21\n"
            + "    let l: f32 = 8388608.0\n"
            + "    let m: f32 = 1.6777216e7\n"
            + "    let n: f32 = -2.47e-43\n"
            + "    let o: f32 = 4103.9003\n"
            + "    let p: f32 = 5.3399997e9\n"
            + "    print(f\"{a}|{b}|{c}|{d}|{e}|{g}|{h}|{i}|{j}|{k}|{l}|{m}|{n}|{o}|{p}\")\n"
            + "    return 0i32\n"
        ),
        function_name = "main",
        expected_value = 0,
        expected_output = (
            "2.2250738585072014e-308|2.9802322387695312e-8|-2.109808898695963e16|4.940656e-318|1.18575755e-316|2.989102097996e-312|9060801153433600.0|4.708356024711512e18|9.409340012568248e18|1.2345678|9007199254740991.0|9007199254740992.0\n"
            + "1.1754944e-38|33554450.0|9000000000.0|34366720000.0|305404.12|8099.0312|0.00024414062|0.0043945312|0.0063476562|4.7223665e21|8388608.0|16777216.0|-2.47e-43|4103.9004|5339999700.0\n"
        ),
    ))
    return items

# Triple literal normalization is a source/formatter concern. Once decoded,
# HIR and MIR deliberately see the same ordinary immutable text/bytes values
# as every other spelling, and every backend consumes that canonical value.
func literal_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, (
        "pub func answer() -> i64:\n"
        + "    let text = \"\"\"\n        alpha\n          beta\n        \"\"\"\n"
        + "    let raw = r\"\"\"\n        C:\\studio\\n\n        \"\"\"\n"
        + "    let payload = b\"\"\"\n        A\\x00\\u{3bb}\n        \"\"\"\n"
        + "    if text != \"alpha\\n  beta\" or raw != r\"C:\\studio\\n\": return 0\n"
        + "    if payload.length != 4u64 or payload[1u64] != 0u8: return 0\n"
        + "    return 42\n"
    ), 42)
    answer(items, (
        "pub func answer() -> i64:\n"
        + "    let value = -1.5\n"
        + "    match value:\n"
        + "        -1.5: return 42\n"
        + "        _: return 0\n"
    ), 42)
    items.append(Fixture(
        source = (
            "func marked(label: str, value: i64) -> i64:\n    print(label)\n    return value\n"
            + "pub func answer() -> i64:\n"
            + "    let values = [marked(\"list 1\", 1), marked(\"list 2\", 2)]\n"
            + "    let fixed: array[i64, 2] = [marked(\"array 1\", 3), marked(\"array 2\", 4)]\n"
            + "    let view: slice[i64] = [marked(\"slice 1\", 5), marked(\"slice 2\", 6)]\n"
            + "    let table = {marked(\"key 1\", 7): marked(\"value 1\", 10), marked(\"key 2\", 7): marked(\"value 2\", 20)}\n"
            + "    let unique = set[i64](marked(\"set 1\", 8), marked(\"set 2\", 8))\n"
            + "    return values[0u64] + values[1u64] + fixed[0u64] + fixed[1u64] + view[0u64] + view[1u64] + (table[7] else 0) + i64(unique.length)\n"
        ),
        function_name = "answer",
        expected_value = 42,
        expected_output = "list 1\nlist 2\narray 1\narray 2\nslice 1\nslice 2\nkey 1\nvalue 1\nkey 2\nvalue 2\nset 1\nset 2\n",
    ))
    return items

# Mutable collection graphs need one coinductive transaction across every
# semantic implementation. The fixture severs its strong cycles explicitly;
# equality does not change ARC ownership or pretend to collect cycles.
func recursive_equality_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, (
        "struct Node:\n    let value: i64\n    let children: list[Node]\n"
        + "func cycle(value: i64) -> list[Node]:\n    let root: list[Node] = []\n    root.append(Node(value = value, children = root))\n    return root\n"
        + "func sever(root: list[Node]): root.clear()\n"
        + "pub func answer() -> i64:\n    let left = cycle(1)\n    let right = cycle(1)\n    let different = cycle(2)\n    let same = left == right\n    let mismatch = left == different\n    sever(left)\n    sever(right)\n    sever(different)\n    return 42 if same and not mismatch else 0\n"
    ), 42)
    return items

# The numeric hash code is deliberately private to one execution. These
# fixtures therefore prove the semantic contract—equal values hash equally,
# every admitted structural family is traversed, and the operand is evaluated
# once—without pinning a backend's mixing result.
func structural_hash_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(
        source = "let code: ErrorCode = ErrorCode.package(7)\nstruct Pair:\n    let number: i64\n    let text: str\nenum Choice:\n    empty\n    pair(value: Pair)\nfunc same[T: Equatable & Hashable](left: T, right: T) -> bool:\n    return left == right and hash(left) == hash(right)\nfunc empty_value(): return\nfunc produced() -> Pair:\n    print(\"value\")\n    return Pair(number = 42, text = \"luce\")\npub func answer() -> i64:\n    let value = produced()\n    if not same(value, Pair(number = 42, text = \"luce\")): return 0\n    if not same(Choice.pair(value = value), Choice.pair(value = value)): return 0\n    if not same(Choice.empty, Choice.empty): return 0\n    if not same((value, 7u16), (value, 7u16)): return 0\n    let present: Pair? = value\n    let also_present: Pair? = value\n    let absent: Pair? = none\n    let also_absent: Pair? = none\n    if not same(present, also_present) or not same(absent, also_absent): return 0\n    let numbers: array[i32, 3] = [1i32, 2i32, 3i32]\n    if not same(numbers, [1i32, 2i32, 3i32]): return 0\n    if not same(1..<4, 1..<4): return 0\n    if not same(\"λuce\", \"λuce\") or not same(b\"\\x00luce\", b\"\\x00luce\"): return 0\n    if not same('λ', 'λ') or not same(true, true): return 0\n    if not same(-7i8, -7i8) or not same(9u64, 9u64): return 0\n    let half: f16 = 0.1\n    if not same(0.0, -0.0) or not same(half, f16(0.1)) or not same(2.5f32, 2.5f32): return 0\n    if not same(code, code) or hash(empty_value()) != hash(empty_value()): return 0\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "value\n",
    ))
    return items

# Fixed arrays are inline values: literal evaluation, checked reads/writes,
# aggregate calls/copies, nested places, equality, and zero length all cross
# the same HIR and canonical MIR used by every backend.
func array_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "type Row = array[i64, 2]\nfunc reverse(value: Row) -> Row: return [value[1u64], value[0u64]]\npub func answer() -> i64:\n    let row: Row = [4, 2]\n    let reversed = reverse(row)\n    return reversed[0u64] * 10 + reversed[1u64]\n", 24)
    answer(items, "type Row = array[i64, 2]\nstruct Grid:\n    var rows: array[Row, 2]\npub func answer() -> i64:\n    var grid = Grid(rows = [[1, 2], [3, 4]])\n    var copy = grid\n    copy.rows[1u64][0u64] += 5\n    if grid == copy: return 0\n    return grid.rows[1u64][0u64] * 10 + copy.rows[1u64][0u64]\n", 38)
    answer(items, "pub func answer() -> u64:\n    let empty: array[i64, 0] = []\n    return empty.length\n", 0)
    items.append(Fixture(
        source = "func produced() -> array[i64, 0]:\n    print(\"length receiver\")\n    return []\npub func answer() -> u64: return produced().length\n",
        function_name = "answer",
        expected_value = 0,
        expected_output = "length receiver\n",
    ))
    answer(items, "let magic: array[i64, 2] = [4, 2]\npub func answer() -> i64: return magic[0u64] * 10 + magic[1u64]\n", 42)
    items.append(Fixture(
        source = "func selected() -> u64:\n    print(\"index\")\n    return 0u64\nfunc replacement() -> i64:\n    print(\"value\")\n    return 42\npub func answer() -> i64:\n    var values: array[i64, 1] = [1]\n    values[selected()] = replacement()\n    return values[0u64]\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "index\nvalue\n",
    ))
    items.append(Fixture(
        source = "struct Cell:\n    var value: i64\n    mutating func bump(self, by: i64): self.value += by\nfunc selected() -> u64:\n    print(\"receiver index\")\n    return 1u64\npub func answer() -> i64:\n    var cells: array[Cell, 2] = [Cell(value = 1), Cell(value = 2)]\n    cells[selected()].bump(5)\n    return cells[1u64].value\n",
        function_name = "answer",
        expected_value = 7,
        expected_output = "receiver index\n",
    ))
    answer(items, "struct Cell:\n    var value: i64\n    mutating func bump(self) -> i64:\n        self.value += 1\n        return 2\npub func answer() -> i64:\n    var cells: array[Cell, 1] = [Cell(value = 1)]\n    cells[0u64].value += cells[0u64].bump()\n    return cells[0u64].value\n", 4)
    answer(items, "struct Cell:\n    var value: i64\n    mutating func add(self, by: i64): self.value += by\n    mutating func replace(self) -> i64:\n        self.value = 40\n        return 2\npub func answer() -> i64:\n    var cells: array[Cell, 1] = [Cell(value = 1)]\n    cells[0u64].add(cells[0u64].replace())\n    return cells[0u64].value\n", 42)
    answer(items, "func snapshot() -> slice[i64]:\n    var values: array[i64, 4] = [1, 40, 2, 4]\n    let view = values[1u64..<3u64]\n    values[1u64] = 99\n    return view\npub func answer() -> i64:\n    let view = snapshot()\n    return view[0u64] + view[1u64]\n", 42)
    answer(items, "pub func answer() -> i64:\n    let values: array[i64, 2] = [20, 22]\n    let whole = values[0u64..]\n    let empty = values[1u64..<1u64]\n    return whole[0u64] + whole[1u64] if empty.length == 0u64 else 0\n", 42)
    items.append(Fixture(
        source = "func values() -> array[i64, 3]:\n    print(\"source\")\n    return [10, 20, 22]\nfunc lower() -> u64:\n    print(\"lower\")\n    return 1u64\nfunc upper() -> u64:\n    print(\"upper\")\n    return 3u64\npub func answer() -> i64:\n    let view = values()[lower()..<upper()]\n    return view[0u64] + view[1u64]\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "source\nlower\nupper\n",
    ))
    return items

# Slice 3a: locals, every operator family, every integer width, conditionals.
func answer(items: list[Fixture], source: str, expected: i64):
    items.append(Fixture(source = source, function_name = "answer", expected_value = expected, expected_output = ""))

func trapping(items: list[Fixture], source: str):
    items.append(Fixture(source = source, function_name = "answer", expected_value = 0, expected_output = ""))

func scalar_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "pub func answer() -> i64:\n    let a = 40\n    var b = 1\n    b += 1\n    return a + b\n", 42)
    answer(items, "pub func answer() -> i64:\n    var v = 100\n    v -= 58\n    v *= 3\n    v //= 2\n    v %= 50\n    return v\n", 13)
    answer(items, "pub func answer() -> i64:\n    var v = 0b1100\n    v &= 0b1010\n    v |= 1\n    v ^= 0b1000\n    v <<= 2\n    v >>= 1\n    return v\n", 2)
    answer(items, "pub func answer() -> i64: return 7 // -2\n", -4)
    answer(items, "pub func answer() -> i64: return 7 % -2\n", -1)
    answer(items, "pub func answer() -> i64: return -7 // 2\n", -4)
    answer(items, "pub func answer() -> i64: return -7 % 2\n", 1)
    answer(items, "pub func answer() -> i64: return (-9223372036854775807 - 1) % -1\n", 0)
    answer(items, "pub func answer() -> i64: return 1 << 62\n", 4611686018427387904)
    answer(items, "pub func answer() -> i64: return -16 >> 2\n", -4)
    answer(items, "pub func answer() -> i64: return ~5\n", -6)
    answer(items, "pub func answer() -> i64: return -(-3)\n", 3)
    answer(items, "pub func answer() -> i64: return +9\n", 9)
    answer(items, "pub func answer() -> i8:\n    let v: i8 = -128\n    return v + 127\n", -1)
    answer(items, "pub func answer() -> i16:\n    var v: i16 = 32767\n    v -= 1\n    return v\n", 32766)
