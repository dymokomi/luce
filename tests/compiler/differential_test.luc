pub func test_c_export_wrappers_agree_with_the_hir_boundary_oracle():
    let source = "extern type Window\nexport c func echo(window: Window?) -> Window?: return window\nexport c func accepts(window: Window) -> bool: return window == window\n"
    let program = analyzed(source)
    let hir_none = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    let hir_some = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 42)]) catch reason:
        trap(reason)
    match hir_none:
        Foreign(token): assert(token == 0)
        else: assert(false)
    match hir_some:
        Foreign(token): assert(token == 42)
        else: assert(false)

    let mir = lowered(program)
    let interpreter = MirInterpreter(mir, interpreter_layout())
    let mir_none = interpreter.run("echo", [MirValue.Ptr(value = 0)]) catch reason:
        trap(reason)
    let mir_some = interpreter.run("echo", [MirValue.Ptr(value = 42)]) catch reason:
        trap(reason)
    assert(mir_pointer(mir_none) == 0)
    assert(mir_pointer(mir_some) == 42)
    assert(strings.contains(mir_export_failure(mir, "accepts", [MirValue.Ptr(value = 0)]), "null_foreign"))

pub func test_hir_and_mir_interpreters_trap_on_the_same_programs():
    for fixture in trapping_fixtures():
        let program = analyzed(fixture.source)
        if oracle_failure(program, fixture.function_name) == "":
            trap("HIR oracle did not trap:\n" + fixture.source)
        if mir_failure(lowered(program), "main." + fixture.function_name) == "":
            trap("MIR oracle did not trap:\n" + fixture.source)

# Calls and transparent public aliases cross modules before both oracles and
# artifact backends receive the same resolved program.
pub func test_every_current_execution_path_agrees_across_modules():
    let math = "pub type Count = i64\npub let scale: Count = 3\npub func double(x: Count = scale) -> Count: return x * 2\nfunc hidden(x: Count) -> Count: return x + 1\npub func nudge(x: Count) -> Count: return hidden(x)\npub struct Pair:\n    pub let a: Count\n    pub let b: Count\n    pub func sum(self) -> Count: return self.a + self.b\n    pub func unit() -> Pair: return Pair(a = 1, b = 1)\n"
    let policy = "import math\nfrom math import scale\npub func defaults(first: math.Count = scale, second: math.Count = math.scale) -> math.Count: return first + second\n"
    let main = "import math\nimport policy\nfrom math import nudge\npub func answer() -> i64:\n    let p = math.Pair(a = 1, b = 2)\n    let q: math.Pair = math.Pair.unit()\n    let operation: func(math.Count) -> math.Count = math.double\n    let result: math.Count = operation(14) + math.double() + policy.defaults() + nudge(1) + p.sum() + q.sum()\n    return result\npub func main(arguments: slice[str]) -> i32: return 0i32 if answer() == 47 else 1i32\n"
    let program = analyzed_modules([source_module("math", math), source_module("policy", policy), source_module("main", main)])
    let oracle = HirInterpreter().run(program, "main", "answer") catch reason:
        trap(reason)
    assert(hir_integer(oracle) == 47)
    let mir = lowered(program)
    let results = MirInterpreter(mir, interpreter_layout()).run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(mir_integer(results) == 47)
    let wasm = WasmBackend().emit(mir) catch reason:
        trap(reason)
    assert(len(wasm) > 8)
    if has_qbe(): assert(execute_with_qbe(mir).status == 0)

# Every compiled backend encodes every fixture without error from the same
# target-neutral MIR.
pub func test_every_backend_encodes_every_fixture_it_can_express():
    for fixture in fixtures():
        let program = analyzed(fixture.source)
        let mir = lowered(program)
        let wasm = WasmBackend().emit(mir) catch reason:
            trap(reason)
        assert(len(wasm) > 8)
        let qbe = QbeBackend().emit_il(mir) catch reason:
            trap(reason + "\n" + fixture.source)
        assert(len(qbe) > 0)

# QBE is the native oracle, not merely a syntax producer. When the pinned QBE
# toolchain is available, compile and execute the complete non-trapping corpus.
# A process status retains the low eight bits of the scalar result; output is
# checked independently, so observable behavior still has two assertions.
pub func test_qbe_executes_every_non_trapping_fixture_when_available():
    if not has_qbe(): return
    for fixture in fixtures():
        let program = lowered(analyzed(with_qbe_entry(fixture, true)))
        let result = execute_with_qbe(program)
        let expected_status = fixture.expected_value % 256
        if result.status != expected_status:
            trap("QBE returned " + str(result.status) + ", expected " + str(expected_status) + "; stderr: `" + result.diagnostic + "`:\n" + fixture.source)
        if result.output != fixture.expected_output:
            trap("QBE printed `" + result.output + "`, expected `" + fixture.expected_output + "`:\n" + fixture.source)

pub func test_qbe_traps_on_every_trapping_fixture_when_available():
    if not has_qbe(): return
    for fixture in trapping_fixtures():
        let program = lowered(analyzed(with_qbe_entry(fixture, false)))
        let result = execute_with_qbe(program)
        if result.status == 0: trap("QBE did not trap:\n" + fixture.source)
        if result.output != fixture.expected_output:
            trap("QBE printed `" + result.output + "`, expected `" + fixture.expected_output + "` before trapping:\n" + fixture.source)

# Lowering is target-independent; the resulting program can be passed to any
# backend without being rebuilt for that backend.
pub func test_one_mir_program_feeds_every_backend():
    let program = analyzed("pub func main(arguments: slice[str]) -> i32:\n    print(\"hi\")\n    return 1 + 2\n")
    let mir = lowered(program)
    let wasm = WasmBackend().emit(mir) catch reason:
        trap(reason)
    let qbe = QbeBackend().emit_il(mir) catch reason:
        trap(reason)
    assert(len(wasm) > 8)
    assert(len(qbe) > 0)
