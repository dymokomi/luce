    interpreter.bind_externs(MirForeignPointerHost())
    let results = interpreter.run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(mir_integer(results) == 0)
    let wasm = WasmBackend().emit(mir) catch reason:
        trap(reason)
    assert(len(wasm) > 8)

    assert(strings.contains(oracle_host_failure(program, "fail", HirForeignPointerHost()), "null_foreign"))
    assert(strings.contains(mir_host_failure(mir, "main.fail", MirForeignPointerHost()), "null_foreign"))

