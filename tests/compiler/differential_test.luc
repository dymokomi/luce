#==============================================================================================
#
#   differential_test - The three executions agree
#
#   DESCRIPTION:
#       Every fixture here runs through the HIR interpreter (the semantic
#       oracle) and the MIR interpreter (the lowerer's first consumer), and is
#       encoded by every artifact backend that can express it. The oracle and
#       the MIR interpreter must produce the same value and the same output;
#       when they disagree, the stage between them — the lowerer — is wrong.
#       See docs/compiler/mir.md, "How we know any of this is right".
#
#==============================================================================================

from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.backends.mir_interpreter import MirInterpreter, MirValue
from luce.compiler.backends.wasm import WasmBackend
from luce.compiler.canonical_ir import MirProgram, TargetLayout, arm64_macos_layout, wasm32_layout, x86_64_linux_layout
from luce.compiler.backends.arm64_macos import Arm64MacosBackend
from luce.compiler.backends.x86_64_linux import X86_64LinuxBackend
from luce.compiler.hir import Value
from luce.compiler.hir_gen import HirGenerator, SourceModule
from luce.compiler.lowerer import Lowerer
from luce.compiler.mir_verifier import MirVerifier
from luce.compiler.parser import Parser
from luce.compiler.semantic_analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.tokenizer import Tokenizer

# mark: Fixtures ===============================================================================

# One program, the function to run, and what the oracle must say.
struct Fixture:
    source: str
    function_name: str
    expected_value: i64
    expected_output: str

func fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(source = "pub func answer() -> i64: return 42\n", function_name = "answer", expected_value = 42, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return 2 + 3 * 4\n", function_name = "answer", expected_value = 14, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return (2 + 3) * 4 - 6\n", function_name = "answer", expected_value = 14, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return -9223372036854775807 - 1 + 1\n", function_name = "answer", expected_value = -9223372036854775807, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i32: return 2147483646i32 + 1i32\n", function_name = "answer", expected_value = 2147483647, expected_output = ""))
    items.append(Fixture(source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"Hello, world!\")\n    return 0\n", function_name = "main", expected_value = 0, expected_output = "Hello, world!\n"))
    items.append(Fixture(source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"one\")\n    print(\"two\")\n    return 3 * 2\n", function_name = "main", expected_value = 6, expected_output = "one\ntwo\n"))
    return items

# Programs the oracle must reject at run time, and the MIR path must reject
# identically: checked arithmetic is a language rule, not a backend choice.
func trapping_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(source = "pub func answer() -> i32: return 2147483647i32 + 1i32\n", function_name = "answer", expected_value = 0, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return 9223372036854775807 * 2\n", function_name = "answer", expected_value = 0, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return -9223372036854775807 - 1 - 1\n", function_name = "answer", expected_value = 0, expected_output = ""))
    return items

# mark: Stages =================================================================================

func analyzed(source: str) -> AnalyzedProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    let module_value = SourceModule(name = "main", path = "main.luc", syntax = syntax_tree)
    let hir = HirGenerator([module_value]).generate() catch reason:
        trap(reason)
    let program = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return program

func lowered(program: AnalyzedProgram, layout: TargetLayout) -> MirProgram:
    let mir = Lowerer(program, layout).lower() catch reason:
        trap(reason)
    MirVerifier(mir).verify() catch reason:
        trap(reason)
    return mir

func hir_integer(value: Value) -> i64:
    match value:
        Integer(item): return item
        else: trap("oracle produced a non-integer value")

func mir_integer(values: list[MirValue]) -> i64:
    if len(values) != 1: trap("MIR interpreter produced " + str(len(values)) + " result(s)")
    match values[0]:
        Int(item): return item
        else: trap("MIR interpreter produced a non-integer value")

func oracle_failure(program: AnalyzedProgram, function_name: str) -> str:
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

func mir_failure(program: MirProgram, function_name: str) -> str:
    let results = MirInterpreter(program).run(function_name, list[MirValue]()) catch reason:
        return reason
    return ""

# mark: Agreement ==============================================================================

pub func test_hir_and_mir_interpreters_agree_on_every_fixture():
    for fixture in fixtures():
        let program = analyzed(fixture.source)
        let oracle = HirInterpreter().run(program, "main", fixture.function_name) catch reason:
            trap(reason)
        assert(hir_integer(oracle) == fixture.expected_value)

        let mir = lowered(program, wasm32_layout())
        let interpreter = MirInterpreter(mir)
        let results = interpreter.run("main." + fixture.function_name, list[MirValue]()) catch reason:
            trap(reason)
        assert(mir_integer(results) == fixture.expected_value)
        assert(interpreter.output == fixture.expected_output)

pub func test_hir_and_mir_interpreters_trap_on_the_same_programs():
    for fixture in trapping_fixtures():
        let program = analyzed(fixture.source)
        assert(oracle_failure(program, fixture.function_name) != "")
        assert(mir_failure(lowered(program, wasm32_layout()), "main." + fixture.function_name) != "")

# Every backend encodes every fixture it can express without error, from
# the MIR lowered for its own layout. Native targets need a `main`.
pub func test_every_backend_encodes_every_fixture_it_can_express():
    for fixture in fixtures():
        let program = analyzed(fixture.source)
        let wasm = WasmBackend().emit(lowered(program, wasm32_layout())) catch reason:
            trap(reason)
        assert(len(wasm) > 8)
        if fixture.function_name == "main":
            let arm64 = Arm64MacosBackend().emit(lowered(program, arm64_macos_layout())) catch reason:
                trap(reason)
            assert(len(arm64) > 0)
            let x86 = X86_64LinuxBackend().emit(lowered(program, x86_64_linux_layout())) catch reason:
                trap(reason)
            assert(len(x86) > 0)

# The same source lowered for two layouts differs only where the layout
# says it should; with no aggregates in the slice, the instruction streams
# are identical.
pub func test_layout_only_changes_what_layout_owns():
    let program = analyzed("pub func main(arguments: slice[str]) -> i32:\n    print(\"hi\")\n    return 1 + 2\n")
    let wasm = lowered(program, wasm32_layout())
    let native = lowered(program, arm64_macos_layout())
    assert(len(wasm.functions) == len(native.functions))
    assert(len(wasm.functions[0].body) == len(native.functions[0].body))
    assert(len(wasm.data) == len(native.data))
    assert(wasm.layout.pointer_size == 4)
    assert(native.layout.pointer_size == 8)
