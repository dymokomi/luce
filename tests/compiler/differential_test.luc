pub func test_pointer_handle_boundaries_agree_through_hir_mir_and_wasm():
    let source = "extern type Window\nextern func create() -> Window?\nextern func broken() -> Window\nextern func show(window: Window) -> bool\npub func answer() -> i32:\n    match create():\n        .some(window): return 0 if show(window) else 2\n        .none: return 1\npub func fail() -> Window: return broken()\n"
    let program = analyzed(source)
    let live_hir = HirInterpreter().run_with_host(program, "main", "answer", HirLiveWindowHost()) catch reason:
        trap(reason)
    let null_hir = HirInterpreter().run_with_host(program, "main", "answer", HirNullWindowHost()) catch reason:
        trap(reason)
    assert(hir_integer(live_hir) == 0)
    assert(hir_integer(null_hir) == 1)

    let mir = lowered(program)
    let live_mir = MirInterpreter(mir, interpreter_layout())
    live_mir.bind_externs(MirLiveWindowHost())
    let live_results = live_mir.run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    let null_mir = MirInterpreter(mir, interpreter_layout())
    null_mir.bind_externs(MirNullWindowHost())
    let null_results = null_mir.run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(mir_integer(live_results) == 0)
    assert(mir_integer(null_results) == 1)
    let wasm = WasmBackend().emit(mir) catch reason:
        trap(reason)
    assert(len(wasm) > 8)

    assert(strings.contains(oracle_host_failure(program, "fail", HirLiveWindowHost()), "null_foreign"))
    assert(strings.contains(mir_host_failure(mir, "main.fail", MirLiveWindowHost()), "null_foreign"))

pub func test_foreign_pointer_boundaries_agree_through_hir_mir_and_wasm():
    let source = "extern func acquire() -> foreign?\nextern func absent() -> foreign?\nextern func broken() -> foreign\nextern func fill(out value: foreign?)\nextern func consume(value: foreign) -> bool\nfunc release(pointer: foreign): discard(consume(pointer))\npub func answer() -> i32:\n    if let pointer = acquire():\n        let disposer: cfunc(foreign) -> unit = release\n        disposer(pointer)\n        if let output = fill(): return 0 if consume(output) and absent() == none else 2\n    return 1\npub func fail() -> foreign: return broken()\n"
    let program = analyzed(source)
    let oracle = HirInterpreter().run_with_host(program, "main", "answer", HirForeignPointerHost()) catch reason:
        trap(reason)
