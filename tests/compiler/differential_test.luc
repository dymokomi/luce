# Slice 3b: `if`/`elif`/`else`, `while`, `break`, `continue`, early returns.
func control_flow_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    var i = 1\n    while i <= 10:\n        total += i\n        i += 1\n    return total\n", 55)
    answer(items, "pub func answer() -> i64:\n    var n = 10\n    var steps = 0\n    while n > 0:\n        n -= 3\n        steps += 1\n    return steps * 100 + n\n", 398)
    answer(items, "pub func answer() -> i64:\n    var i = 0\n    var hits = 0\n    while true:\n        i += 1\n        if i > 100: break\n        if i % 2 == 0: continue\n        hits += 1\n    return hits\n", 50)
    answer(items, "pub func answer() -> i64:\n    var outer = 0\n    var count = 0\n    while outer < 5:\n        outer += 1\n        var inner = 0\n        while inner < 5:\n            inner += 1\n            if inner == 3: break\n            if outer == 2: continue\n            count += 1\n    return count\n", 8)
    answer(items, "pub func answer() -> i64:\n    let x = 7\n    if x < 3:\n        return 1\n    elif x < 6:\n        return 2\n    elif x < 9:\n        return 3\n    else:\n        return 4\n", 3)
    answer(items, "pub func answer() -> i64:\n    let x = 20\n    var r = 0\n    if x < 3: r = 1\n    elif x < 6: r = 2\n    else: r = 9\n    return r\n", 9)
    answer(items, "pub func answer() -> i64:\n    var i = 0\n    while i < 1000:\n        if i * i > 300:\n            if i % 2 == 1:\n                return i\n        i += 1\n    return -1\n", 19)
    answer(items, "pub func answer() -> i64:\n    var a = 0\n    var b = 1\n    var n = 0\n    while n < 30:\n        let next = a + b\n        a = b\n        b = next\n        n += 1\n    return a\n", 832040)
    answer(items, "pub func answer() -> i64:\n    var n = 27\n    var steps = 0\n    while n != 1:\n        if n % 2 == 0:\n            n //= 2\n        else:\n            n = 3 * n + 1\n        steps += 1\n    return steps\n", 111)
    answer(items, "pub func answer() -> i64:\n    var i = 0\n    while i < 3:\n        i += 1\n    if i == 3:\n        var j = 0\n        while j < 4:\n            j += 1\n            if j == 2: continue\n            i += 10\n        return i\n    return 0\n", 33)
    items.append(Fixture(source = "func maybe(flag: bool) -> i64?:\n    print(\"source\")\n    if flag: return 21\n    return none\nfunc read(flag: bool) -> i64:\n    if let value = maybe(flag):\n        return value * 2\n    else:\n        return 7\npub func answer() -> i64: return read(true) + read(false)\n", function_name = "answer", expected_value = 49, expected_output = "source\nsource\n"))
    answer(items, "func read(value: i64?) -> i64:\n    var result = 5\n    if let present = value: result = present\n    return result\npub func answer() -> i64: return read(37) + read(none)\n", 42)
    answer(items, "func payload(flag: bool) -> bytes?:\n    if flag: return b\"a\" + b\"bcde\"\n    return none\nfunc read(flag: bool) -> i64:\n    if let value = payload(flag):\n        let view = value[1u64..<4u64]\n        return 42 if view.length == 3u64 and view[0u64] == 98u8 else 0\n    return 0\npub func answer() -> i64: return read(true) + read(false)\n", 42)
    answer(items, "pub func answer() -> u8:\n    var v: u8 = 0\n    var i = 0\n    while i < 255:\n        v += 1\n        i += 1\n    return v\n", 255)
    return items

# Built-in range values and infallible `for`: boundaries, loop control,
# aggregate passing/returning, nesting, and early function exit.
func range_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    for i in 0..<5: total += i\n    return total\n", 10)
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    for i in 1..=5: total += i\n    return total\n", 15)
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    for i in 5..<3: total += 1\n    for i in 5..=3: total += 10\n    return total\n", 0)
    answer(items, "pub func answer() -> u8:\n    var last: u8 = 0\n    for i in 253u8..=255u8: last = i\n    return last\n", 255)
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    for i in 1..=5:\n        if i == 2: continue\n        if i == 5: break\n        total += i\n    return total\n", 8)
    answer(items, "func span() -> range[i64]: return 2..=4\nfunc sum(values: range[i64]) -> i64:\n    var total = 0\n    for value in values: total += value\n    return total\npub func answer() -> i64:\n    let values = span()\n    return sum(values) + (10 if values == 2..=4 else 0)\n", 19)
    answer(items, "pub func answer() -> i64:\n    var total = 0\n    for outer in 1..=3:\n        for inner in 1..<4:\n            if inner == 2: continue\n            if outer == 3: break\n            total += outer * 10 + inner\n    return total\n", 68)
    answer(items, "pub func answer() -> i64:\n    for value in 10..<20:\n        if value == 13: return value\n    return -1\n", 13)
    return items

# Lexical cleanup: registration-time captures, LIFO ordering, every ordinary
# scope exit, and evaluation of a return value before cleanup begins.
func defer_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(
        source = "struct Label:\n    let text: str\n    func show(self): print(self.text)\nfunc captured() -> str:\n    print(\"capture\")\n    return \"saved\"\nfunc show(value: str): print(value)\npub func answer() -> i64:\n    var label = Label(text = \"before\")\n    defer label.show()\n    defer show(captured())\n    defer print(\"last\")\n    label = Label(text = \"after\")\n    print(\"body\")\n    return 7\n",
        function_name = "answer",
        expected_value = 7,
        expected_output = "capture\nbody\nlast\nsaved\nbefore\n",
    ))
    items.append(Fixture(
        source = "func value() -> i64:\n    print(\"value\")\n    return 9\npub func answer() -> i64:\n    defer print(\"cleanup\")\n    return value()\n",
        function_name = "answer",
        expected_value = 9,
        expected_output = "value\ncleanup\n",
    ))
    items.append(Fixture(
        source = "enum Choice:\n    yes\n    no\nfunc inner():\n    defer print(\"fallthrough\")\nfunc explicit():\n    defer print(\"unit\")\n    return\npub func answer() -> i64:\n    inner()\n    explicit()\n    defer print(\"outer\")\n    if true:\n        defer print(\"inner\")\n        print(\"body\")\n    match Choice.yes:\n        .yes:\n            defer print(\"arm\")\n            print(\"match\")\n        .no: print(\"wrong\")\n    return 1\n",
        function_name = "answer",
        expected_value = 1,
        expected_output = "fallthrough\nunit\nbody\ninner\nmatch\narm\nouter\n",
    ))
    items.append(Fixture(
        source = "pub func answer() -> i64:\n    defer print(\"function\")\n    var visits = 0\n    for i in 0..<4:\n        defer print(\"iteration\")\n        visits += 1\n        if i == 0: continue\n        if i == 2: break\n    return visits\n",
        function_name = "answer",
        expected_value = 3,
        expected_output = "iteration\niteration\niteration\nfunction\n",
    ))
    items.append(Fixture(
        source = "pub func answer() -> i64:\n    var visits = 0\n    while visits < 4:\n        defer print(\"while\")\n        visits += 1\n        if visits == 1: continue\n        if visits == 3: break\n    return visits\n",
        function_name = "answer",
        expected_value = 3,
        expected_output = "while\nwhile\nwhile\n",
    ))
    items.append(Fixture(
        source = "func pair() -> (i64, i64):\n    defer print(\"aggregate\")\n    return (4, 2)\npub func answer() -> i64:\n    let (a, b) = pair()\n    return a * 10 + b\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "aggregate\n",
    ))
    return items

# Recoverable failure is explicit data at calls and explicit transfer inside
# a function. This fixture also proves defer ordering on success, propagation,
# and recovery through both interpreters and the wasm encoder.
func failure_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked(fail: bool) -> i64!:\n    defer print(\"checked\")\n    if fail: error(invalid, \"invalid value\")\n    return 21\nfunc propagated(fail: bool) -> i64!:\n    defer print(\"propagated\")\n    return try checked(fail)\npub func answer() -> i64:\n    let success = checked(false) catch failure: recover 0\n    let recovered = propagated(true) catch failure:\n        defer print(\"handler\")\n        if failure.code == invalid and failure.message == \"invalid value\": recover 7\n        recover 0\n    return success + recovered * 3\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "checked\nchecked\npropagated\nhandler\n",
    ))
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc pair(fail: bool) -> (i64, i64)!:\n    if fail: error(invalid, \"pair failed\")\n    return (20, 22)\nfunc recovered(fail: bool) -> (i64, i64):\n    return pair(fail) catch failure: recover (19, 23)\npub func answer() -> i64:\n    let (a, b) = recovered(false)\n    let (c, d) = recovered(true)\n    return a + b + c + d\n",
        function_name = "answer",
        expected_value = 84,
        expected_output = "",
    ))
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc noop(): return\nfunc action(fail: bool) -> unit!:\n    if fail: error(invalid, \"action failed\")\nfunc handled(fail: bool):\n    action(fail) catch failure: recover noop()\npub func answer() -> i64:\n    handled(false)\n    handled(true)\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "",
    ))
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked(fail: bool) -> i64!:\n    if fail: error(invalid, \"discarded failure\")\n    return 9\nfunc consume(fail: bool) -> unit!:\n    discard(try checked(fail))\nfunc noop(): return\nfunc handled(fail: bool):\n    consume(fail) catch failure: recover noop()\npub func answer() -> i64:\n    handled(false)\n    handled(true)\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "",
    ))
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked(fail: bool) -> i64!:\n    if fail: error(invalid, \"checked failed\")\n    return 21\nfunc selected(flag: bool) -> i64!:\n    return try match flag:\n        true => checked(false)\n        false => checked(true)\npub func answer() -> i64:\n    let success = selected(true) catch failure: recover 0\n    let recovered = selected(false) catch failure: recover 7\n    return success + recovered * 3\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "",
    ))
    items.append(Fixture(
        source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked() -> i64!: error(invalid, \"base\")\nfunc returned() -> i64:\n    return checked() catch failure:\n        defer print(\"return handler\")\n        return 20\nfunc contextual() -> i64!:\n    return checked() catch failure:\n        defer print(\"error handler\")\n        error(failure.code, \"context\")\npub func answer() -> i64:\n    let recovered = contextual() catch failure:\n        if failure.code == invalid and failure.message == \"context\": recover 22\n        recover 0\n    return returned() + recovered\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "error handler\nreturn handler\n",
    ))
    return items

# Slice 3c: parameters, calls, recursion, module constants.
func call_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "func factorial(n: i64) -> i64:\n    if n <= 1: return 1\n    return n * factorial(n - 1)\npub func answer() -> i64: return factorial(15)\n", 1307674368000)
    answer(items, "func fib(n: i64) -> i64:\n    if n < 2: return n\n    return fib(n - 1) + fib(n - 2)\npub func answer() -> i64: return fib(20)\n", 6765)
    answer(items, "func is_even(n: i64) -> bool:\n    if n == 0: return true\n    return is_odd(n - 1)\nfunc is_odd(n: i64) -> bool:\n    if n == 0: return false\n    return is_even(n - 1)\npub func answer() -> i64: return 1 if is_even(10) and is_odd(7) else 0\n", 1)
    answer(items, "func mix(a: i8, b: u16, c: i64, d: bool) -> i64:\n    var total = c\n    if d: total += 1\n    if a < 0: total -= 3\n    if b == 65535: total += 65535\n    return total\npub func answer() -> i64: return mix(-3, 65535, 1000, true) + mix(5, 1, 0, false)\n", 66533)
    answer(items, "func square(x: i64) -> i64: return x * x\npub func answer() -> i64:\n    var i = 0\n    var total = 0\n    while square(i) < 100:\n        total += square(i)\n        i += 1\n    return total\n", 285)
    answer(items, "let base = 40\nlet extra: i64 = base + 1\npub func answer() -> i64: return extra + 1\n", 42)
    answer(items, "func pick(first: i64, second: i64, third: i64) -> i64: return first * 100 + second * 10 + third\npub func answer() -> i64: return pick(third = 3, first = 1, second = 2)\n", 123)
    answer(items, "func gcd(a: i64, b: i64) -> i64:\n    var x = a\n    var y = b\n    while y != 0:\n        let t = y\n        y = x % y\n        x = t\n    return x\npub func answer() -> i64: return gcd(1071, 462)\n", 21)
    answer(items, "func ackermann(m: i64, n: i64) -> i64:\n    if m == 0: return n + 1\n    if n == 0: return ackermann(m - 1, 1)\n    return ackermann(m - 1, ackermann(m, n - 1))\npub func answer() -> i64: return ackermann(2, 3)\n", 9)
    answer(items, "func bump(x: u8) -> u8: return x + 1\npub func answer() -> u8: return bump(bump(253))\n", 255)
    answer(items, "func down(n: i64) -> i64:\n    if n == 0: return 0\n    return down(n - 1) + 1\npub func answer() -> i64: return down(1500)\n", 1500)
    return items

# Generic declarations disappear before canonical MIR. This fixture proves
# inference, a concrete default, recursion, and specialization calls through
# both semantic oracles and the QBE artifact corpus.
func generic_function_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "func choose[T](value: T, fallback: T? = none) -> T:\n    return fallback else value\nfunc descend[T](value: T, remaining: i64) -> T:\n    if remaining == 0: return value\n    return descend(value, remaining - 1)\npub func answer() -> i64: return descend(choose(42), 3)\n", 42)
    return items

# A method's receiver fixes its generic-owner prefix; source arguments infer
# only the independently declared suffix. Every resulting call is an ordinary
# concrete function before canonical MIR is built.
func generic_method_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "struct Box[T]:\n    let value: T\n    func select[U](self, value: U, fallback: U? = none) -> U: return fallback else value\n    func repeat[U](self, value: U, remaining: i64) -> U:\n        if remaining == 0: return value\n        return self.repeat(value, remaining - 1)\npub func answer() -> i64:\n    let box = Box(42)\n    let word = box.select[str](\"luce\")\n    return box.repeat(box.select(42), 2) if word == \"luce\" else 0\n", 42)
    items.append(Fixture(
        source = "struct Box:\n    func selected[T](self, value: T) -> T: return value\nfunc receiver() -> Box:\n    print(\"receiver\")\n    return Box()\nfunc argument() -> i64:\n    print(\"argument\")\n    return 42\npub func answer() -> i64: return receiver().selected(argument())\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "receiver\nargument\n",
    ))
    return items

# Custom initialization and type-level construction specialize through the
# same generic callable transaction as free functions and methods. HIR and
# canonical MIR therefore execute only concrete nominal identities.
func generic_nominal_construction_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "struct Box[T]:\n    let value: T\n    func init(self, value: T, fallback: T? = none): self.value = fallback else value\n    func make(value: T) -> Box[T]: return Box(value)\nstruct Slot[T]:\n    let value: T?\n    func empty() -> Slot[T]: return Slot(value = none)\nclass Cell[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n    func make(value: T) -> Cell[T]: return new Cell(value)\nenum Choice[T]:\n    empty\n    one(value: T)\n    func make(value: T) -> Choice[T]: return .one(value)\npub func answer() -> i64:\n    let box = Box.make(40)\n    let explicit = Box.make[i64](1)\n    let slot: Slot[i64] = Slot.empty()\n    let cell = Cell.make(1)\n    let choice = Choice.make(0)\n    let selected = match choice:\n        .empty => 0\n        .one(value) => value\n    return box.value + explicit.value + cell.value + selected if slot.value == none else 0\n", 42)
    return items

# Interface constraints are resolved statically: canonical MIR sees only the
# concrete method selected by the specialized generic body.
func constrained_generic_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "interface Scorer:\n    func score(self, bonus: i64) -> i64!\nstruct Reading implements Scorer:\n    let value: i64\n    pub func score(self, bonus: i64) -> i64: return self.value + bonus\nfunc adjusted[T: Scorer](value: T, bonus: i64) -> i64!: return try value.score(bonus)\npub func answer() -> i64:\n    return adjusted(Reading(value = 40), 2) catch failure: recover 0\n", 42)
    return items

# Exact ordinary function values retain one semantic shape through both
# interpreters and every artifact backend: named addresses, selection,
# parameters/results, aggregate signatures, fields, constants, fallibility,
# defer capture, and source evaluation order.
func function_value_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "pub func answer() -> i64:\n    let double: func(i64) -> i64 = (value) => value * 2\n    return double(21)\n", 42)
    answer(items, "pub func answer() -> i64:\n    let offset = 2\n    let add: func(i64) -> i64 = func [copy amount = offset] (value: i64) -> i64: return value + amount\n    return add(40)\n", 42)
    answer(items, "func make(start: i64) -> func() -> i64:\n    var value = start\n    return func () -> i64:\n        value += 1\n        return value\npub func answer() -> i64:\n    let next = make(40)\n    return next() + next() - 41\n", 42)
    answer(items, "func make(value: i64) -> func() -> func() -> i64:\n    return () => () => value\npub func answer() -> i64:\n    let outer = make(42)\n    let inner = outer()\n    return inner()\n", 42)
    answer(items, "pub let invalid: ErrorCode = ErrorCode.package(1)\nfunc make(offset: i64) -> func(i64) -> i64!:\n    return func (value: i64) -> i64!:\n        if value < 0: error(invalid, \"negative\")\n        return value + offset\npub func answer() -> i64:\n    let checked = make(2)\n    let success = checked(40) catch failure: recover 0\n    let recovered = checked(-1) catch failure: recover 0\n    return success + recovered\n", 42)
    answer(items, "func plain(value: i64) -> i64: return value\nfunc make(offset: i64) -> func(i64) -> i64: return (value) => value + offset\nfunc apply(operation: func(i64) -> i64!, value: i64) -> i64:\n    return operation(value) catch failure: recover 0\npub func answer() -> i64:\n    return apply(plain, 20) + apply(make(1), 21)\n", 42)
    answer(items, "class Owner:\n    var value: i64\n    func init(self, value: i64): self.value = value\n    func reader(self) -> func() -> i64?:\n        return func [weak self] () -> i64?:\n            if let live = self: return live.value\n            return none\nfunc expired() -> func() -> i64?:\n    let owner = new Owner(7)\n    return owner.reader()\npub func answer() -> i64:\n    let read = expired()\n    return read() else 42\n", 42)
    answer(items, "class Owner:\n    var value: i64\n    func init(self, value: i64): self.value = value\n    func reader(self) -> func() -> i64?:\n        return func [weak self] () -> i64?:\n            if let live = self: return live.value\n            return none\npub func answer() -> i64:\n    let owner = new Owner(42)\n    let read = owner.reader()\n    return read() else 0\n", 42)
    answer(items, "class Owner:\n    var callback: (func() -> i64)?\n    func init(self): self.callback = none\n    func install(self): self.callback = () => 42\n    func read(self) -> i64:\n        if let callback = self.callback: return callback()\n        return 0\npub func answer() -> i64:\n    let owner = new Owner()\n    owner.install()\n    return owner.read()\n", 42)
    answer(items, "func make(value: i64) -> func() -> i64: return () => value\nstruct Holder:\n    let operation: func() -> i64\npub func answer() -> i64:\n    let callbacks: list[func() -> i64] = []\n    callbacks.append(make(20))\n    callbacks.append(make(22))\n    let copied = callbacks.copy()\n    callbacks.clear()\n    let holder = Holder(operation = copied[0u64])\n    return holder.operation() + copied[1u64]()\n", 42)
    answer(items, "func add(left: i64, right: i64) -> i64: return left + right\nfunc subtract(left: i64, right: i64) -> i64: return left - right\nfunc choose(addition: bool) -> func(i64, i64) -> i64: return add if addition else subtract\npub func answer() -> i64:\n    let operation = choose(false)\n    return operation(50, 8)\n", 42)
    answer(items, "func add(left: i64, right: i64) -> i64: return left + right\nfunc apply(operation: func(i64, i64) -> i64, left: i64, right: i64) -> i64: return operation(left, right)\nfunc identity(operation: func(i64, i64) -> i64) -> func(i64, i64) -> i64: return operation\npub func answer() -> i64: return apply(identity(add), 20, 22)\n", 42)
    answer(items, "type Pair = (i64, i64)\nfunc reversed(value: Pair) -> Pair:\n    let (left, right) = value\n    return (right, left)\npub func answer() -> i64:\n    let operation: func(Pair) -> Pair = reversed\n    let (left, right) = operation((2, 4))\n    return left * 10 + right\n", 42)
    answer(items, "func add(left: i64, right: i64) -> i64: return left + right\nstruct Calculator:\n    let operation: func(i64, i64) -> i64\npub func answer() -> i64:\n    let calculator = Calculator(operation = add)\n    return calculator.operation(20, 22)\n", 42)
    answer(items, "func doubled(value: i64) -> i64: return value * 2\nlet operation: func(i64) -> i64 = doubled\npub func answer() -> i64: return operation(21)\n", 42)
    items.append(Fixture(
        source = "func selected() -> func(i64, i64) -> i64:\n    print(\"callee\")\n    return add\nfunc add(left: i64, right: i64) -> i64: return left + right\nfunc left() -> i64:\n    print(\"left\")\n    return 20\nfunc right() -> i64:\n    print(\"right\")\n    return 22\npub func answer() -> i64:\n    let operation = selected()\n    return operation(left(), right())\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "callee\nleft\nright\n",
    ))
    items.append(Fixture(
        source = "func show(value: str): print(value)\npub func answer() -> i64:\n    let action: func(str) -> unit = show\n    defer action(\"later\")\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "later\n",
    ))
    answer(items, "let invalid: ErrorCode = ErrorCode.package(1)\nfunc checked(value: i64) -> i64!:\n    if value < 0: error(invalid, \"negative\")\n    return value\npub func answer() -> i64:\n    let operation: func(i64) -> i64! = checked\n    let success = operation(42) catch failure: return 0\n    let failure = operation(-1) catch failure: recover 0\n    return success + failure\n", 42)
    answer(items, "func add(left: i32, right: i32) -> i32: return left + right\nfunc apply(operation: cfunc(i32, i32) -> i32, left: i32, right: i32) -> i32: return operation(left, right)\nfunc identity(operation: cfunc(i32, i32) -> i32) -> cfunc(i32, i32) -> i32: return operation\npub func answer() -> i32:\n    let callback: cfunc(i32, i32) -> i32 = add\n    return apply(identity(callback), 20i32, 22i32)\n", 42)
    answer(items, "func add(left: i32, right: i32) -> i32: return left + right\nstruct CCalculator:\n    let operation: cfunc(i32, i32) -> i32\npub func answer() -> i32:\n    let calculator = CCalculator(operation = add)\n    return calculator.operation(20i32, 22i32)\n", 42)
    answer(items, "extern type Handle\nfunc identity(value: Handle?) -> Handle?: return value\npub func answer() -> i64:\n    let callback: cfunc(Handle?) -> Handle? = identity\n    return 42 if callback(none) == none else 0\n", 42)
    answer(items, "pub func answer() -> i32:\n    let callback: cfunc(i32) -> i32 = (value) => value + 1i32\n    return callback(41i32)\n", 42)
    return items

# Milestone 4: tuples, optionals, `str`/`bytes` values, `print` of a value.
func composite_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "func pair() -> (i64, i64): return (3, 4)\npub func answer() -> i64:\n    let (a, b) = pair()\n    return a * 10 + b\n", 34)
    answer(items, "pub func answer() -> i64:\n    let t = ((1, 2), (3, (4, 5)))\n    let (x, y) = t\n    let (p, q) = y\n    let (r, s) = q\n    let (m, n) = x\n    return m + n + p + r + s\n", 15)
    answer(items, "pub func answer() -> i64:\n    let a = (1, true, 2.5)\n    let b = (1, true, 2.5)\n    let c = (1, false, 2.5)\n    var n = 0\n    if a == b: n += 1\n    if a != c: n += 10\n    if a == c: n += 100\n    return n\n", 11)
    answer(items, "func sum(p: (i64, i64)) -> i64:\n    let (a, b) = p\n    return a + b\npub func answer() -> i64: return sum((20, 22))\n", 42)
    answer(items, "pub func answer() -> i64:\n    var t = (1, 2)\n    let (a, b) = t\n    t = (b, a)\n    let (c, d) = t\n    return c * 10 + d\n", 21)
    answer(items, "func choose(flag: bool) -> (i64, i64): return (1, 2) if flag else (3, 4)\npub func answer() -> i64:\n    let (a, b) = choose(false)\n    return a * 10 + b\n", 34)
    answer(items, "func maybe(flag: bool) -> i64?:\n    if flag: return 7\n    return none\npub func answer() -> i64: return (maybe(true) else 0) * 10 + (maybe(false) else 3)\n", 73)
    answer(items, "pub func answer() -> i64:\n    let a: i64? = 5\n    let b: i64? = 5\n    let c: i64? = none\n    let d: i64? = none\n    var n = 0\n    if a == b: n += 1\n    if a != c: n += 10\n    if c == d: n += 100\n    return n\n", 111)
    answer(items, "func find(flag: bool) -> (i64, i64)?:\n    if flag: return (1, 2)\n    return none\npub func answer() -> i64:\n    let (a, b) = find(true) else (9, 9)\n    let (c, d) = find(false) else (9, 9)\n    return a + b + c + d\n", 21)
    answer(items, "pub func answer() -> i64:\n    var best: i64? = none\n    var i = 0\n    while i < 5:\n        if i == 3: best = i\n        i += 1\n    return best else -1\n", 3)
    answer(items, "pub func answer() -> i64:\n    let a = \"hello\"\n    let b = \"hello\"\n    let c = \"help\"\n    let d = \"hell\"\n    var n = 0\n    if a == b: n += 1\n    if a != c: n += 10\n    if a == d: n += 100\n    if \"\" == \"\": n += 1000\n    return n\n", 1011)
    answer(items, "func pick(flag: bool) -> str:\n    if flag: return \"yes\"\n    return \"no\"\nfunc is_yes(s: str) -> bool: return s == \"yes\"\npub func answer() -> i64: return (1 if is_yes(pick(true)) else 0) + (2 if is_yes(pick(false)) else 0)\n", 1)
    answer(items, "pub func answer() -> i64:\n    let a = b\"ab\"\n    let c = b\"ab\"\n    let d = b\"ac\"\n    return (1 if a == c else 0) + (2 if a == d else 0)\n", 1)
    answer(items, "pub func answer() -> u64: return b\"abc\".length\n", 3)
    answer(items, "pub func answer() -> u8: return b\"abc\"[1u64]\n", 98)
    answer(items, "pub func answer() -> i64:\n    let joined = b\"ab\" + b\"cde\"\n    return 42 if joined == b\"abcde\" and joined.length == 5u64 else 0\n", 42)
    answer(items, "pub func answer() -> i64:\n    if not (b\"ab\" < b\"ac\"): return 0\n    if not (b\"ab\" < b\"aba\"): return 0\n    if not (b\"ac\" > b\"ab\"): return 0\n    if not (b\"ab\" <= b\"ab\" and b\"ab\" >= b\"ab\"): return 0\n    return 42\n", 42)
    answer(items, "func middle(value: bytes) -> slice[u8]: return value[1u64..<4u64]\npub func answer() -> i64:\n    let view = middle(b\"a\" + b\"bcde\")\n    return 42 if view.length == 3u64 and view[0u64] == 98u8 and view[1u64] == 99u8 and view[2u64] == 100u8 else 0\n", 42)
    answer(items, "pub func answer() -> i64:\n    let view = b\"abc\"[1u64..<]\n    return 42 if view.length == 2u64 and view[0u64] == 98u8 else 0\n", 42)
    answer(items, "pub func answer() -> u64: return \"λ\".byte_count\n", 2)
    answer(items, "pub func answer() -> u64: return \"aλ😀\".length() * 10u64 + \"aλ😀\".byte_count\n", 37)
    answer(items, "func joined(left: str, right: str) -> str: return left + right\npub func answer() -> i64:\n    let value = joined(\"aλ\", \"😀z\")\n    return 42 if value == \"aλ😀z\" and value.length() == 4u64 and value.byte_count == 8u64 else 0\n", 42)
    answer(items, "pub func answer() -> i64:\n    var score = 0\n    for character in \"aλ😀z\":\n        if character == 'λ':\n            score += 10\n            continue\n        if character == '😀': score += 30\n        if character == 'z': break\n        score += 1\n    return score\n", 42)
    answer(items, "pub func answer() -> i64:\n    if not (\"a\" < \"λ\"): return 0\n    if not (\"λ\" < \"😀\"): return 0\n    if not (\"λ\" < \"λa\"): return 0\n    if not (\"😀\" >= \"😀\" and \"λ\" <= \"λ\"): return 0\n    return 42\n", 42)
    answer(items, "pub func answer() -> i64:\n    let path = r\"C:\\studio\\shots\\n\"\n    return 42 if path == \"C:\\\\studio\\\\shots\\\\n\" else 0\n", 42)
    answer(items, "pub func answer() -> i64:\n    let text = \"\\u{3bb}\\u{1f600}\"\n    var score = i64(text.byte_count)\n    for character in text:\n        if character == '\\u{3bb}': score += 10\n        if character == '\\u{1f600}': score += 26\n    return score\n", 42)
    answer(items, "pub func answer() -> i64:\n    let data = b\"\\x00\\xff\\u{3bb}\\u{1f600}\"\n    if data.length != 8u64: return 0\n    if data[0u64] != 0u8 or data[1u64] != 255u8: return 0\n    if data[2u64] != 206u8 or data[3u64] != 187u8: return 0\n    return 42\n", 42)
    items.append(Fixture(
        source = "pub func answer() -> i64:\n    print(r\"literal\\n\")\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "literal\\n\n",
    ))
    answer(items, "pub func answer() -> u64:\n    let small: u8 = 42u8\n    return u64(small)\n", 42)
    answer(items, "let name = \"luce\"\npub func answer() -> i64: return 1 if name == \"luce\" else 0\n", 1)
    answer(items, "pub func answer() -> i64:\n    let a = (\"x\", 1)\n    let b = (\"x\", 1)\n    let c = (\"y\", 1)\n    return (1 if a == b else 0) + (2 if a == c else 0)\n", 1)
    answer(items, "func wrap(value: i64) -> (i64, str)?: return (value, \"n\")\npub func answer() -> i64:\n    let (v, label) = wrap(5) else (0, \"\")\n    return v + (10 if label == \"n\" else 0)\n", 15)
    items.append(Fixture(source = "func pick() -> str: return \"yes\"\npub func answer() -> i64:\n    let greeting = \"hi there\"\n    print(greeting)\n    print(pick())\n    print(\"done\")\n    return 1\n", function_name = "answer", expected_value = 1, expected_output = "hi there\nyes\ndone\n"))
    items.append(Fixture(
        source = "func produced() -> str:\n    print(\"produced\")\n    return \"owned \" + \"value\"\npub func answer() -> i64:\n    discard(produced())\n    print(\"continued\")\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "produced\ncontinued\n",
    ))
    items.append(Fixture(
        source = "func condition() -> bool: return 6 * 7 == 42\nfunc message() -> str:\n    print(\"message\")\n    return \"owned \" + \"diagnostic\"\npub func answer() -> i64:\n    assert(condition(), message())\n    print(\"continued\")\n    return 42\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "message\ncontinued\n",
    ))
    return items

# Structs and methods: construction with defaults, field places, `mutating`
# through the caller's slot, type functions, structs inside tuples and
# optionals, parameter defaults.
func struct_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self, value: i64, swap: bool = false):\n        if swap:\n            self.left = value + 1\n            self.right = value\n        else:\n            self.left = value\n            self.right = value + 1\npub func answer() -> i64:\n    let normal = Pair(3)\n    let swapped = Pair(value = 8, swap = true)\n    return normal.left * 1000 + normal.right * 100 + swapped.left * 10 + swapped.right\n", 3498)
    answer(items, "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Positive:\n    let value: i64\n    func init(self, value: i64) -> unit!:\n        if value < 0: error(invalid, \"negative\")\n        self.value = value\nfunc checked(value: i64) -> i64:\n    let positive = Positive(value) catch failure: return -1\n    return positive.value\npub func answer() -> i64: return checked(43) + checked(-1)\n", 42)
    answer(items, "struct Point:\n    let x: i64\n    let y: i64\npub func answer() -> i64:\n    let p = Point(x = 3, y = 4)\n    return p.x * 10 + p.y\n", 34)
    answer(items, "struct Style:\n    let width: i64 = 7\n    let depth: i64\npub func answer() -> i64:\n    let s = Style(depth = 2)\n    let t = Style(1, 2)\n    return s.width * 10 + s.depth + t.width * 100\n", 172)
    answer(items, "struct Cursor:\n    var position: i64\npub func answer() -> i64:\n    var c = Cursor(position = 1)\n    c.position = 5\n    c.position += 10\n    return c.position\n", 15)
    answer(items, "struct Counter:\n    var count: i64\n    func origin() -> Counter: return Counter(count = 100)\n    func doubled(self) -> i64: return self.count * 2\n    mutating func bump(self, by: i64): self.count += by\npub func answer() -> i64:\n    var c = Counter.origin()\n    c.bump(by = 5)\n    c.bump(1)\n    return c.doubled()\n", 212)
    answer(items, "struct Inner:\n    var value: i64\n    mutating func set(self, v: i64): self.value = v\nstruct Outer:\n    var inner: Inner\n    let tag: i64\npub func answer() -> i64:\n    var o = Outer(inner = Inner(value = 1), tag = 3)\n    o.inner.value = 20\n    o.inner.set(o.inner.value + 1)\n    return o.inner.value + o.tag\n", 24)
    answer(items, "struct P:\n    let x: i64\n    let y: i64\nfunc find(flag: bool) -> P?:\n    if flag: return P(x = 1, y = 2)\n    return none\npub func answer() -> i64:\n    let a = P(x = 1, y = 2)\n    let b = find(true) else P(x = 0, y = 0)\n    let c = find(false) else P(x = 0, y = 0)\n    var n = 0\n    if a == b: n += 1\n    if a != c: n += 10\n    let (p, q) = (a, c)\n    if p == a and q == c: n += 100\n    return n\n", 111)
    answer(items, "struct V:\n    var x: i64\n    var y: i64\n    func sum(self) -> i64: return self.x + self.y\n    func plus(self, other: V) -> V: return V(x = self.x + other.x, y = self.y + other.y)\n    mutating func reset(self): self = V(x = 0, y = 0)\n    mutating func add(self, other: V): self = self.plus(other)\nfunc total(v: V) -> i64: return v.sum()\npub func answer() -> i64:\n    var v = V(x = 1, y = 2)\n    v.add(V(x = 10, y = 20))\n    let t = total(v)\n    v.reset()\n    return t * 10 + v.sum()\n", 330)
    answer(items, "func scale(value: i64, factor: i64 = 3, offset: i64 = -1) -> i64: return value * factor + offset\npub func answer() -> i64: return scale(2) + scale(2, 10) + scale(2, offset = 5)\n", 35)
    answer(items, "struct Box:\n    let inner: (i64, bool)\n    var label: i64?\npub func answer() -> i64:\n    var b = Box(inner = (4, true), label = none)\n    b.label = 7\n    let (n, flag) = b.inner\n    return n * 100 + (b.label else 0) + (1 if flag else 0)\n", 408)
    answer(items, "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T: Scored]:\n    let value: T\n    let fallback: T? = none\nfunc wrap[T: Scored](value: T) -> Box[T]: return Box(value)\nfunc read[T: Scored](box: Box[T]) -> i64:\n    if let fallback = box.fallback: return fallback.score()\n    return box.value.score()\npub func answer() -> i64: return read(wrap(Score(value = 42)))\n", 42)
    answer(items, "struct Box[T]:\n    var value: T\n    func get(self) -> T: return self.value\n    mutating func set(self, next: T): self.value = next\n    func copied(self) -> Box[T]: return Box(self.get())\n    func selected(self, fallback: T? = none) -> T: return fallback else self.value\n    func repeated(self, count: i64) -> T:\n        if count == 0: return self.value\n        return self.repeated(count - 1)\npub func answer() -> i64:\n    var number = Box(20)\n    number.set(42)\n    let word = Box(\"luce\")\n    let copied = word.copied()\n    return number.repeated(2) if copied.selected() == \"luce\" else 0\n", 42)
    answer(items, "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T: Scored]:\n    let value: T\n    func score(self) -> i64: return self.value.score()\npub func answer() -> i64: return Box(Score(value = 42)).score()\n", 42)
    answer(items, "interface Cell[T]:\n    mutating func write(self, value: T)\n    func read(self) -> T!\nstruct Box[T] implements Cell[T]:\n    var value: T\n    pub mutating func write(self, value: T): self.value = value\n    pub func read(self) -> T: return self.value\nfunc erase(value: Box[i64]) -> Cell[i64]: return value\nfunc update(value: Cell[i64]) -> i64!:\n    var current = value\n    current.write(42)\n    return try current.read()\npub func answer() -> i64:\n    return update(erase(Box(value = 1))) catch failure: recover 0\n", 42)
    items.append(Fixture(source = "struct Named:\n    let name: str\n    var count: i64\npub func answer() -> i64:\n    var n = Named(name = \"luce\", count = 1)\n    print(n.name)\n    n.count += 1\n    return n.count\n", function_name = "answer", expected_value = 2, expected_output = "luce\n"))
    items.append(Fixture(
        source = "struct Pair:\n    let left: i64\n    let right: i64\nfunc right_first() -> i64:\n    print(\"right\")\n    return 2\nfunc left_second() -> i64:\n    print(\"left\")\n    return 40\npub func answer() -> i64:\n    let pair = Pair(right = right_first(), left = left_second())\n    return pair.left + pair.right\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "right\nleft\n",
    ))
    return items

# Build the boundary fixture instead of checking in 257 repetitive lines. Its
# final case proves that ordinary enum identity is not capped by a `u8` MIR
# representation; selection, matching, equality, and hashing all consume it.
func wide_enum_source() -> str:
    var source = "enum Wide:\n"
    for index in range(0, 257): source = source + "    c" + str(index) + "\n"
    return source + (
        "pub func answer() -> i64:\n"
        + "    let selected = Wide.c256\n"
        + "    if selected != Wide.c256 or hash(selected) != hash(Wide.c256): return 0\n"
        + "    return match selected:\n"
        + "        .c256 => 42\n"
        + "        _ => 0\n"
    )

# Enums and `match`: cases with and without payloads, alternatives sharing
# bindings, equality, optionals and scalars as subjects, ranges and strings,
# loops and mutating methods, aggregate results from an expression match.
func enum_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    answer(items, wide_enum_source(), 42)
    answer(items, "enum Direction:\n    north\n    east\n    south\n    west\nfunc turn(d: Direction) -> i64:\n    match d:\n        .north: return 1\n        .east: return 2\n        .south, .west: return 3\npub func answer() -> i64: return turn(Direction.north) * 100 + turn(.east) * 10 + turn(Direction.west)\n", 123)
    answer(items, "enum Command:\n    open(path: i64)\n    resize(width: i64, height: i64)\n    quit\nfunc size(c: Command) -> i64:\n    return match c:\n        .open(path) => path\n        .resize(width, height) => width * height\n        .quit => -1\npub func answer() -> i64: return size(Command.open(path = 7)) + size(Command.resize(3, 4)) + size(.quit)\n", 18)
    answer(items, "enum Move:\n    left(steps: i64)\n    right(steps: i64)\n    stop\nfunc amount(m: Move) -> i64:\n    match m:\n        .left(steps), .right(steps): return steps\n        .stop: return 0\npub func answer() -> i64: return amount(.left(5)) + amount(Move.right(steps = 6)) + amount(.stop)\n", 11)
    answer(items, "enum Shape:\n    circle(radius: i64)\n    square(side: i64)\n    dot\nfunc find(flag: bool) -> Shape?:\n    if flag: return .circle(3)\n    return none\npub func answer() -> i64:\n    let a = Shape.circle(3)\n    let b = find(true) else .dot\n    let c = find(false) else .dot\n    var n = 0\n    if a == b: n += 1\n    if a != c: n += 10\n    if c == Shape.dot: n += 100\n    if Shape.square(2) != Shape.square(3): n += 1000\n    return n\n", 1111)
    answer(items, "func classify(v: i64) -> i64:\n    match v:\n        0: return 0\n        1, 2: return 1\n        3..<10: return 2\n        10..=20: return 3\n        -5..=-1: return 4\n        _: return 5\nfunc opt(v: i64?) -> i64:\n    match v:\n        .some(x): return x * 2\n        .none: return -1\nfunc flag(b: bool) -> i64:\n    match b:\n        true: return 1\n        false: return 0\nfunc letter(c: char) -> i64:\n    return match c:\n        'a'..='z' => 1\n        '0'..='9' => 2\n        _ => 3\nfunc word(s: str) -> i64:\n    return match s:\n        \"yes\" => 1\n        \"no\" => 0\n        _ => -1\npub func answer() -> i64:\n    return classify(0) + classify(2) * 10 + classify(7) * 100 + classify(15) * 1000 + classify(-3) * 10000 + classify(99) * 100000 + opt(4) + opt(none) + flag(true) + letter('q') + letter('5') + letter('!') + word(\"yes\") + word(\"maybe\")\n", 543224)
    items.append(Fixture(
        source = "func produced() -> u8:\n    print(\"subject\")\n    return 42u8\nfunc classify(v: u8) -> i64:\n    match v:\n        0..<42: return 1\n        42: return 40\n        43..=255: return 0\npub func answer() -> i64: return classify(0u8) + classify(produced()) + classify(255u8)\n",
        function_name = "answer",
        expected_value = 41,
        expected_output = "subject\n",
    ))
    answer(items, "func classify(v: char) -> i64:\n    match v:\n        '\\u{0}'..='\\u{10FFFF}': return 42\npub func answer() -> i64: return classify('λ')\n", 42)
    answer(items, "enum Light:\n    red\n    green\n    func next(self) -> Light:\n        match self:\n            .red: return .green\n            .green: return .red\n    func start() -> Light: return .red\npub func answer() -> i64:\n    var l = Light.start()\n    var i = 0\n    var greens = 0\n    while i < 7:\n        i += 1\n        l = l.next()\n        match l:\n            .green:\n                greens += 1\n                continue\n            .red:\n                if i == 6: break\n    return greens * 10 + i\n", 36)
    answer(items, "enum Light:\n    red\n    green\n    mutating func toggle(self):\n        match self:\n            .red: self = .green\n            .green: self = .red\npub func answer() -> i64:\n    var l = Light.red\n    l.toggle()\n    l.toggle()\n    l.toggle()\n    return match l:\n        .red => 0\n        .green => 1\n", 1)
    answer(items, "enum Pair:\n    two(a: i64, b: i64)\n    one(a: i64)\nfunc split(p: Pair) -> (i64, i64):\n    return match p:\n        .two(a, b) => (a, b)\n        .one(a) => (a, 0)\npub func answer() -> i64:\n    let (x, y) = split(.two(4, 5))\n    let (z, w) = split(Pair.one(9))\n    return x * 1000 + y * 100 + z * 10 + w\n", 4590)
    answer(items, "struct Box:\n    var state: i64?\npub func answer() -> i64:\n    var b = Box(state = none)\n    var total = 0\n    var i = 0\n    while i < 4:\n        let bonus = match b.state:\n            .some(v) => v\n            .none => 100\n        total += bonus\n        b.state = i\n        i += 1\n    return total\n", 103)
    items.append(Fixture(
        source = "interface Value[T]:\n    func get(self, fallback: T) -> T\nenum Choice[T] implements Value[T]:\n    empty\n    one(value: T)\n    pair(left: T, right: T)\n    pub func get(self, fallback: T) -> T:\n        match self:\n            .empty: return fallback\n            .one(value): return value\n            .pair(left, right): return left\n    mutating func replace(self, value: T): self = .one(value)\nfunc erase(value: Choice[i64]) -> Value[i64]: return value\nfunc right_first() -> i64:\n    print(\"right\")\n    return 2\nfunc left_second() -> i64:\n    print(\"left\")\n    return 40\npub func answer() -> i64:\n    var number = Choice.pair(right = right_first(), left = left_second())\n    let word = Choice.one(\"luce\")\n    let empty = Choice.empty[i64]()\n    let selected = erase(number).get(0)\n    number.replace(selected + empty.get(2))\n    return number.get(0) if word.get(\"\") == \"luce\" else 0\n",
        function_name = "answer",
        expected_value = 42,
        expected_output = "right\nleft\n",
    ))
    return items

func call_trapping_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    trapping(items, "func bump(x: u8) -> u8: return x + 1\npub func answer() -> u8: return bump(bump(254))\n")
    trapping(items, "func forever(n: i64) -> i64: return forever(n + 1) + 1\npub func answer() -> i64: return forever(0)\n")
    return items

# Control-flow programs whose loop body eventually overflows.
func control_flow_trapping_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    trapping(items, "pub func answer() -> u8:\n    var v: u8 = 0\n    while true:\n        v += 1\n    return v\n")
    trapping(items, "pub func answer() -> i64:\n    var v = 1\n    var i = 0\n    while i < 70:\n        v *= 2\n        i += 1\n    return v\n")
    return items

# Slice 3a programs the oracle rejects at run time; the MIR path must too.
func scalar_trapping_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    trapping(items, "pub func answer() -> i8:\n    let v: i8 = 127\n    return v + 1\n")
    trapping(items, "pub func answer() -> u8:\n    let v: u8 = 0\n    return v - 1\n")
    trapping(items, "pub func answer() -> u32:\n    let v: u32 = 4294967295\n    return v + 1\n")
    trapping(items, "pub func answer() -> i16:\n    let v: i16 = -32768\n    return -v\n")
    trapping(items, "pub func answer() -> i64: return 7 // 0\n")
    trapping(items, "pub func answer() -> i64: return 7 % 0\n")
    trapping(items, "pub func answer() -> i64: return (-9223372036854775807 - 1) // -1\n")
    trapping(items, "pub func answer() -> i64: return 1 << 64\n")
    trapping(items, "pub func answer() -> i32:\n    let v: i32 = 1\n    return v << 32i32\n")
    trapping(items, "pub func answer() -> i64: return 1 >> -1\n")
    trapping(items, "pub func answer() -> u64:\n    let v = 18446744073709551615u64\n    return v + 1u64\n")
    trapping(items, "func maximum() -> u64: return 18446744073709551615u64\npub func answer() -> i64: return i64(maximum())\n")
    trapping(items, "pub func answer() -> u8:\n    let value: u16 = 256u16\n    return u8(value)\n")
    trapping(items, "pub func answer() -> u8:\n    let value: i8 = -1i8\n    return u8(value)\n")
    trapping(items, "pub func answer() -> i8:\n    let value: u8 = 200u8\n    return i8(value)\n")
    trapping(items, "func convert(value: f64) -> i8: return i8(value)\npub func answer() -> i8: return convert(128.0)\n")
    trapping(items, "func convert(value: f64) -> u8: return u8(value)\npub func answer() -> u8: return convert(-1.0)\n")
    trapping(items, "func convert(value: f64) -> i64: return i64(value)\npub func answer() -> i64: return convert(1.0 / 0.0)\n")
    trapping(items, "func convert(value: f64) -> i64: return i64(value)\npub func answer() -> i64: return convert(0.0 / 0.0)\n")
    trapping(items, "func convert(value: f64) -> f32: return f32(value)\npub func answer() -> f32: return convert(3.5e38)\n")
    trapping(items, "func convert(value: f64) -> f16: return f16(value)\npub func answer() -> f16: return convert(65520.0)\n")
    trapping(items, "pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    let view = values[0u64..<3u64]\n    return view[0u64]\n")
    trapping(items, "pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    let view = values[2u64..<1u64]\n    return view[0u64]\n")
    # Traps are not recoverable scope exits and therefore skip `defer`.
    trapping(items, "pub func answer() -> i64:\n    defer print(\"must not run\")\n    return 1 // 0\n")
    return items

# Programs the oracle must reject at run time, and the MIR path must reject
# identically: checked arithmetic is a language rule, not a backend choice.
func trapping_fixtures() -> list[Fixture]:
    let items = list[Fixture]()
    items.append(Fixture(source = "pub func answer() -> i32: return 2147483647i32 + 1i32\n", function_name = "answer", expected_value = 0, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return 9223372036854775807 * 2\n", function_name = "answer", expected_value = 0, expected_output = ""))
    items.append(Fixture(source = "pub func answer() -> i64: return -9223372036854775807 - 1 - 1\n", function_name = "answer", expected_value = 0, expected_output = ""))
    trapping(items, "pub func answer() -> u8: return b\"abc\"[3u64]\n")
    trapping(items, "pub func answer() -> u8: return b\"abc\"[2u64..<1u64][0u64]\n")
    trapping(items, "pub func answer() -> u8: return b\"abc\"[..<4u64][0u64]\n")
    trapping(items, "pub func answer() -> i64:\n    defer print(\"must not run\")\n    trap(\"dynamic \" + \"trap\")\n")
    trapping(items, "pub func answer() -> i64:\n    defer print(\"must not run\")\n    assert(false, \"dynamic \" + \"assertion\")\n    return 0\n")
    trapping(items, "pub func answer() -> i64:\n    let values: array[i64, 2] = [1, 2]\n    return values[2u64]\n")
    trapping(items, "pub func answer() -> i64:\n    var values: array[i64, 2] = [1, 2]\n    values[2u64] = 3\n    return 0\n")
    trapping(items, "pub func answer() -> i64:\n    let values: list[i64] = [1]\n    values.with_mutable_slice(func (view: mutable_slice[i64]): discard(view[1u64]))\n    return 0\n")
    trapping(items, "pub func answer() -> i64:\n    let values: list[i64] = [1]\n    values.with_mutable_slice(func (view: mutable_slice[i64]): values.append(2))\n    return 0\n")
    trapping(items, "func replacement() -> i64:\n    print(\"must not run\")\n    return 3\npub func answer() -> i64:\n    var values: array[i64, 2] = [1, 2]\n    values[2u64] = replacement()\n    return 0\n")
    items.append(Fixture(
        source = "func first() -> i64:\n    print(\"before\")\n    return 1\nfunc stop() -> never: trap(\"nested\")\nfunc consume(first: i64, second: i64) -> i64: return first + second\npub func answer() -> i64:\n    defer print(\"must not run\")\n    return consume(first(), stop())\n",
        function_name = "answer",
        expected_value = 0,
        expected_output = "before\n",
    ))
    trapping(items, "func stop() -> never: trap(\"selected and\")\npub func answer() -> i64: return 42 if true and stop() else 0\n")
    trapping(items, "func stop() -> never: trap(\"selected or\")\npub func answer() -> i64: return 42 if false or stop() else 0\n")
    for item in scalar_trapping_fixtures(): items.append(item)
    for item in control_flow_trapping_fixtures(): items.append(item)
    for item in call_trapping_fixtures(): items.append(item)
    return items

# mark: Stages =================================================================================

func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax_tree)

func analyzed_modules(modules: list[SourceModule]) -> AnalyzedProgram:
    let hir = HirGenerator("test.luce", modules).generate() catch reason:
        trap(reason)
    let program = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return program

func analyzed(source: str) -> AnalyzedProgram:
    return analyzed_modules([source_module("main", source)])

func analyzed_runtime(source: str) -> AnalyzedProgram:
    let hir = HirGenerator(
        "org.luce.runtime-test",
        [source_module("runtime", source)],
        PackageRole.sealed_runtime,
    ).generate() catch reason:
        trap(reason)
    let program = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return program

func lowered(program: AnalyzedProgram) -> MirProgram:
    let application = Lowerer(program).lower() catch reason:
        trap(reason)
    var mir = application
    if uses_runtime(application):
        let runtime = compile_runtime(runtime_package()) catch reason:
            trap(reason)
        mir = compose_runtime(application, runtime.program) catch reason:
            trap(reason)
    MirVerifier(mir).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(mir).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    return optimized

func uses_runtime(program: MirProgram) -> bool:
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                AllocateStorage(result, element_type, count): return true
                DeallocateStorage(address, element_type, count): return true
                BufferRetain(value): return true
                BufferRelease(value): return true
                BufferConcat(result, left_data, left_length, right_data, right_length): return true
                BufferData(result, owner): return true
                BufferLength(result, owner): return true
                BufferBuilderCreate(result): return true
                BufferBuilderAppend(builder, data, length): return true
                BufferBuilderFinish(result, builder): return true
                CStringCopy(result, source): return true
                DisplaySigned(result, value): return true
                DisplayUnsigned(result, value): return true
                DisplayFloat(result, value): return true
                DisplayCharacter(result, value): return true
                DisplayBoolean(result, value): return true
                StringScalarCount(result, data, length): return true
                StringDecode(character, width, data, length, offset): return true
                BytesSlice(result, owner, data, length, start, end): return true
                ListCreate(result): return true
                ListMutableSliceBegin(result, value, element_retain): return true
                ListAppendSlot(result, value, element_retain): return true
                ListReserve(value, minimum_capacity, element_retain): return true
                ListSlice(result, value, start, end): return true
                ListRelease(value, element_release): return true
                ClassCreate(result, identity): return true
                ClassMarkInitialized(value): return true
                ClassRetain(value): return true
                ClassRelease(value): return true
                ClassFieldAddress(result, value, field): return true
                WeakClassCreate(result, value): return true
                WeakClassRetain(value): return true
                WeakClassRelease(value): return true
                WeakClassPromote(destination, value, optional_type): return true
                CellCreate(result, element_type, destroyer): return true
                CellMarkInitialized(value): return true
                CellRetain(value): return true
                CellRelease(value): return true
                CellValueAddress(result, value, element_type): return true
                ClosureCreate(environment, destination, function_type, closure): return true
                ClosureMarkInitialized(environment): return true
                ClosureCaptureAddress(result, environment, closure, capture): return true
                FunctionRetain(value): return true
                FunctionRelease(value): return true
                InterfaceCreate(result, source, conformance): return true
                InterfaceRetain(value): return true
                InterfaceRelease(value): return true
                InterfaceDetach(result, value): return true
                InterfacePayload(result, value): return true
                CallInterface(results, interface_id, requirement, target, arguments): return true
                EqualityContextCreate(result): return true
                EqualityContextRelease(value): return true
                EqualityContextVisit(result, context, left, right): return true
                else: pass
    return false

func hir_integer(value: Value) -> i64:
    match value:
        SignedInteger(item): return item
        UnsignedInteger(item): return i64(item)
        else: trap("oracle produced a non-integer value")

func mir_integer(values: list[MirValue]) -> i64:
    if len(values) != 1: trap("MIR interpreter produced " + str(len(values)) + " result(s)")
    match values[0]:
        SignedInt(item): return item
        UnsignedInt(item): return i64(item)
        else: trap("MIR interpreter produced a non-integer value")

func mir_pointer(values: list[MirValue]) -> i64:
    if len(values) != 1: trap("MIR interpreter produced " + str(len(values)) + " result(s)")
    match values[0]:
        Ptr(item): return item
        else: trap("MIR interpreter produced a non-pointer value")

class HirAbsoluteHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        let value = hir_integer(arguments[0])
        if value < 0: return HirExternResult(result = Value.SignedInteger(value = -value), outputs = list[Value]())
        return HirExternResult(result = Value.SignedInteger(value = value), outputs = list[Value]())

class MirAbsoluteHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        let value = mir_integer(arguments)
        if value < 0: return [MirValue.SignedInt(value = -value)]
        return [MirValue.SignedInt(value = value)]

class HirPidHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return HirExternResult(result = Value.Foreign(token = 42), outputs = list[Value]())

class MirPidHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        return [MirValue.SignedInt(value = 42)]

class HirLiveWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create": return HirExternResult(result = Value.Foreign(token = 42), outputs = list[Value]())
        if function.name == "show": return HirExternResult(result = Value.Boolean(value = true), outputs = list[Value]())
        if function.name == "broken": return HirExternResult(result = Value.Foreign(token = 0), outputs = list[Value]())
        error("unexpected extern")

class HirNullWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create" or function.name == "broken": return HirExternResult(result = Value.Foreign(token = 0), outputs = list[Value]())
        error("unexpected extern")

class MirLiveWindowHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name == "create": return [MirValue.Ptr(value = 42)]
        if external.name == "show": return [MirValue.Bool(value = true)]
        if external.name == "broken": return [MirValue.Ptr(value = 0)]
        error("unexpected extern")

class MirNullWindowHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name == "create" or external.name == "broken": return [MirValue.Ptr(value = 0)]
        error("unexpected extern")

class HirForeignPointerHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "acquire": return HirExternResult(result = Value.Foreign(token = 42), outputs = list[Value]())
        if function.name == "absent": return HirExternResult(result = Value.Foreign(token = 0), outputs = list[Value]())
        if function.name == "broken": return HirExternResult(result = Value.Foreign(token = 0), outputs = list[Value]())
        if function.name == "fill": return HirExternResult(result = Value.Unit, outputs = [Value.Foreign(token = 43)])
        if function.name == "consume":
            match arguments[0]:
                Foreign(token): return HirExternResult(result = Value.Boolean(value = token >= 42), outputs = list[Value]())
                else: error("foreign input was not a pointer token")
        error("unexpected foreign-pointer extern")

class MirForeignPointerHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name == "acquire": return [MirValue.Ptr(value = 42)]
        if external.name == "absent": return [MirValue.Ptr(value = 0)]
        if external.name == "broken": return [MirValue.Ptr(value = 0)]
        if external.name == "fill":
            try memory.store_external(arguments[0], builtin_mir_type(BuiltinMirType.pointer), MirValue.Ptr(value = 43))
            return list[MirValue]()
        if external.name == "consume":
            match arguments[0]:
                Ptr(token): return [MirValue.Bool(value = token >= 42)]
                else: error("foreign input was not a MIR pointer")
        error("unexpected foreign-pointer extern")

class HirSplitHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "split" or hir_integer(arguments[0]) != 41: error("unexpected extern")
        return HirExternResult(
            result = Value.SignedInteger(value = 1),
            outputs = [Value.SignedInteger(value = 42), Value.Foreign(token = 99)],
        )

class MirSplitHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name != "split" or len(arguments) != 3 or signed_int_of(arguments[0]) != 41: error("unexpected extern")
        try memory.store_external(arguments[1], builtin_mir_type(BuiltinMirType.signed_i32), MirValue.SignedInt(value = 42))
        try memory.store_external(arguments[2], builtin_mir_type(BuiltinMirType.pointer), MirValue.Ptr(value = 99))
        return [MirValue.SignedInt(value = 1)]

class HirCStringHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        match arguments[0]:
            Bytes(raw):
                if len(raw) != 4 or raw[0] != u8(104) or raw[1] != u8(195) or raw[2] != u8(169) or raw[3] != u8(0):
                    error("unexpected HIR C string input")
            else: error("HIR C string input was not raw bytes")
        return HirExternResult(result = Value.Bytes(value = [u8(111), u8(107), u8(0)]), outputs = list[Value]())

class MirCStringHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        let input = try memory.load_external_c_string(arguments[0])
        if len(input) != 3 or input[0] != u8(104) or input[1] != u8(195) or input[2] != u8(169):
            error("unexpected MIR C string input")
        return [memory.allocate_external_bytes([u8(111), u8(107), u8(0)])]

class HirBorrowedListHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        var count = u64(0)
        match arguments[1]:
            UnsignedInteger(value): count = value
            else: error("HIR borrowed-list count was not u64")
        match arguments[0]:
            Array(elements):
                if count > u64(len(elements)): error("HIR borrowed-list host read beyond storage")
                var total = 0
                for index in range(0, i64(count)): total += hir_integer(elements[index].value)
                return HirExternResult(result = Value.SignedInteger(value = total), outputs = list[Value]())
            else: error("HIR borrowed list was not a C-shaped sequence")

class MirBorrowedListHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        var count = u64(0)
        match arguments[1]:
            UnsignedInt(value): count = value
            else: error("MIR borrowed-list count was not u64")
        let values = try memory.load_external_list(arguments[0], builtin_mir_type(BuiltinMirType.signed_i32), count)
        var total = 0
        for value in values: total += signed_int_of(value)
        return [MirValue.SignedInt(value = total)]

class HirGlobalHost: HirExternVariableHost:
    pub var counter: i64
    pub var current: i64

    pub init():
        self.counter = 40
        self.current = 0

    pub func load(variable: HirExternVariable) -> Value!:
        if variable.name == "counter": return Value.SignedInteger(value = self.counter)
        if variable.name == "current": return Value.Foreign(token = self.current)
        error("unexpected external global")

    pub func store(variable: HirExternVariable, value: Value) -> !:
        if variable.name == "counter":
            self.counter = hir_integer(value)
            return
        if variable.name == "current":
            match value:
                Foreign(token): self.current = token
                else: error("unexpected handle value")
            return
        error("unexpected external global")

class MirGlobalHost: MirExternalGlobalHost:
    pub var counter: i64
    pub var current: i64

    pub init():
        self.counter = 40
        self.current = 0

    pub func load(global: MirExternalGlobal) -> MirValue!:
        if global.name == "counter": return MirValue.SignedInt(value = self.counter)
        if global.name == "current": return MirValue.Ptr(value = self.current)
        error("unexpected external global")

    pub func store(global: MirExternalGlobal, value: MirValue) -> !:
        if global.name == "counter":
            self.counter = signed_int_of(value)
            return
        if global.name == "current":
            match value:
                Ptr(token): self.current = token
                else: error("unexpected handle value")
            return
        error("unexpected external global")

func oracle_failure(program: AnalyzedProgram, function_name: str) -> str:
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

func oracle_host_failure(program: AnalyzedProgram, function_name: str, host: HirExternHost) -> str:
    let value = HirInterpreter().run_with_host(program, "main", function_name, host) catch reason:
        return reason
    return ""

func mir_failure(program: MirProgram, function_name: str) -> str:
    let results = MirInterpreter(program, interpreter_layout()).run(function_name, list[MirValue]()) catch reason:
        return reason
    return ""

func mir_host_failure(program: MirProgram, function_name: str, host: MirExternHost) -> str:
    let interpreter = MirInterpreter(program, interpreter_layout())
    interpreter.bind_externs(host)
    let results = interpreter.run(function_name, list[MirValue]()) catch reason:
        return reason
    return ""

func mir_export_failure(program: MirProgram, function_name: str, arguments: list[MirValue]) -> str:
    let results = MirInterpreter(program, interpreter_layout()).run(function_name, arguments) catch reason:
        return reason
    return ""

func has_qbe() -> bool:
    let probe = os.Process("command -v qbe >/dev/null 2>&1") catch reason:
        return false
    let status = probe.wait() catch reason:
        return false
    return status == 0

struct QbeResult:
    let status: i64
    let output: str
    let diagnostic: str

func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

func execute_with_qbe(program: MirProgram) -> QbeResult:
    let scratch = files.make_temporary_directory(".", ".luce-qbe-corpus-") catch reason:
        trap(reason)
    let executable = paths.join(scratch, "program")
    let output_path = paths.join(scratch, "stdout")
    let diagnostic_path = paths.join(scratch, "stderr")
    QbeToolchain().materialize(program, executable) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let process = os.Process("{ " + quote_shell_argument(executable) + " > " + quote_shell_argument(output_path) + " 2> " + quote_shell_argument(diagnostic_path) + "; } 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let diagnostic = files.read(diagnostic_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return QbeResult(status = status, output = output, diagnostic = diagnostic)

# Most semantic fixtures expose `answer` so the HIR and MIR interpreters can
# call them directly. The product native path needs the language's real process
# entry shape; add that wrapper in source so it passes through every stage
# instead of mutating verified MIR into a C-incompatible `main`.
func with_qbe_entry(fixture: Fixture, check_value: bool) -> str:
    if fixture.function_name == "main": return fixture.source
    if not check_value:
        return fixture.source + "\npub func main(arguments: slice[str]) -> i32:\n    " + fixture.function_name + "()\n    return 0i32\n"
    let status = fixture.expected_value % 256
    let wrong_status = (status + 1) % 256
    return fixture.source + "\npub func main(arguments: slice[str]) -> i32:\n    let result = " + fixture.function_name + "()\n    if result != " + str(fixture.expected_value) + ": return " + str(wrong_status) + "i32\n    return " + str(status) + "i32\n"

# mark: Agreement ==============================================================================

pub func test_hir_and_mir_interpreters_agree_on_every_fixture():
    for fixture in fixtures():
        let program = analyzed(fixture.source)
        let oracle = HirInterpreter().run(program, "main", fixture.function_name) catch reason:
            trap(reason + "\n" + fixture.source)
        if hir_integer(oracle) != fixture.expected_value:
            trap("oracle produced " + str(hir_integer(oracle)) + ", expected " + str(fixture.expected_value) + ":\n" + fixture.source)

        let mir = lowered(program)
        let interpreter = MirInterpreter(mir, interpreter_layout())
        let results = interpreter.run("main." + fixture.function_name, list[MirValue]()) catch reason:
            trap(reason + "\n" + fixture.source)
        if mir_integer(results) != fixture.expected_value:
            trap("MIR interpreter produced " + str(mir_integer(results)) + ", expected " + str(fixture.expected_value) + ":\n" + fixture.source)
        if interpreter.output != fixture.expected_output:
            trap("MIR interpreter printed `" + interpreter.output + "`:\n" + fixture.source)

pub func test_sealed_runtime_state_agrees_through_hir_mir_and_qbe():
    let source = "var cursor: i32\nfunc bump(delta: i32) -> i32:\n    cursor += delta\n    return cursor\npub func main(arguments: slice[str]) -> i32:\n    let first = bump(2i32)\n    return first * 10i32 + bump(3i32)\n"
    let program = analyzed_runtime(source)
    let oracle = HirInterpreter().run(program, "runtime", "main") catch reason:
        trap(reason)
    assert(hir_integer(oracle) == 25)

    let mir = lowered(program)
    assert(len(mir.globals) == 1)
    let interpreted = MirInterpreter(mir, interpreter_layout()).run("runtime.main", list[MirValue]()) catch reason:
        trap(reason)
    assert(mir_integer(interpreted) == 25)
    let qbe = QbeBackend().emit_il(mir) catch reason:
        trap(reason)
    assert(strings.contains(qbe, "data $g0"))
    if has_qbe(): assert(execute_with_qbe(mir).status == 25)

pub func test_standard_math_special_values_agree_through_every_current_path():
    let math_source = files.read("src/standard/math.luc") catch reason:
        trap(reason)
    let example_source = files.read("examples/numeric_conversions.luc") catch reason:
        trap(reason)
    let program = analyzed_modules([
        source_module("math", math_source),
        source_module("numeric_conversions", example_source),
    ])
    let oracle = HirInterpreter().run(program, "numeric_conversions", "answer") catch reason:
        trap(reason)
    assert(hir_integer(oracle) == 42)

    let mir = lowered(program)
    let interpreted = MirInterpreter(mir, interpreter_layout()).run("numeric_conversions.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(mir_integer(interpreted) == 42)
    let wasm = WasmBackend().emit(mir) catch reason:
        trap(reason)
    assert(len(wasm) > 8)
    if has_qbe():
        let native = execute_with_qbe(mir)
        if native.status != 0:
            trap("QBE standard-math example exited with " + str(native.status) + "; output: `" + native.output + "`")

