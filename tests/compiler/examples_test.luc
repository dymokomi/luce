#==============================================================================================
#
#   examples_test - The examples keep working
#
#   DESCRIPTION:
#       Every example in examples/ must keep parsing, and the core examples
#       must keep checking, running, and building through the real pipeline —
#       the same paths the `luce` command line takes.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.pipeline import BuildTarget, PackageInput, RuntimeBindingInput, RuntimePackageInput, build, build_with_runtime, check, run
from luce.compiler.runtime_contract import RuntimeService
from luce.compiler.frontend.tokenizer import Tokenizer
import std.files
import std.os
import std.paths
import std.strings

# mark: Product helpers ========================================================================

func package(paths: list[str]) -> PackageInput:
    return PackageInput(identity = "org.luce.examples", source_paths = paths)

func example_paths() -> list[str]:
    return [
        "examples/hello.luc",
        "examples/compiled_core/main.luc",
        "examples/semantic_core/math.luc",
        "examples/semantic_core/main.luc",
        "examples/language_tour.luc",
        "examples/operators_and_literals.luc",
        "examples/c_api.luc",
        "examples/checkout/catalog.luc",
        "examples/checkout/pricing.luc",
        "examples/checkout/main.luc",
        "examples/c_import/temperature.luc",
        "examples/c_import/main.luc",
        "examples/native_interop.native.luc",
        "examples/stage0_calculator.luc",
        "examples/stage0_sort.luc",
        "examples/stage0_brainfuck.luc",
        "examples/function_values.luc",
        "examples/cfunc_values.luc",
        "examples/lists.luc",
    ]

func runtime_package() -> RuntimePackageInput:
    return RuntimePackageInput(
        identity = "org.luce.runtime",
        source_paths = ["src/runtime/allocator.native.luc"],
        bindings = [
            RuntimeBindingInput(service = RuntimeService.storage_allocator, module_name = "allocator", function_name = "allocate_storage"),
            RuntimeBindingInput(service = RuntimeService.list_create, module_name = "allocator", function_name = "list_create"),
            RuntimeBindingInput(service = RuntimeService.list_copy, module_name = "allocator", function_name = "list_copy"),
            RuntimeBindingInput(service = RuntimeService.list_concat, module_name = "allocator", function_name = "list_concat"),
            RuntimeBindingInput(service = RuntimeService.list_length, module_name = "allocator", function_name = "list_length"),
            RuntimeBindingInput(service = RuntimeService.list_append_slot, module_name = "allocator", function_name = "list_append_slot"),
            RuntimeBindingInput(service = RuntimeService.list_insert_slot, module_name = "allocator", function_name = "list_insert_slot"),
            RuntimeBindingInput(service = RuntimeService.list_remove_at, module_name = "allocator", function_name = "list_remove_at"),
            RuntimeBindingInput(service = RuntimeService.list_clear, module_name = "allocator", function_name = "list_clear"),
            RuntimeBindingInput(service = RuntimeService.list_reserve, module_name = "allocator", function_name = "list_reserve"),
            RuntimeBindingInput(service = RuntimeService.list_element_address, module_name = "allocator", function_name = "list_element_address"),
            RuntimeBindingInput(service = RuntimeService.list_mutable_element_address, module_name = "allocator", function_name = "list_mutable_element_address"),
            RuntimeBindingInput(service = RuntimeService.list_slice, module_name = "allocator", function_name = "list_slice"),
            RuntimeBindingInput(service = RuntimeService.slice_length, module_name = "allocator", function_name = "slice_length"),
            RuntimeBindingInput(service = RuntimeService.slice_element_address, module_name = "allocator", function_name = "slice_element_address"),
        ],
    )

func build_bytes(target: BuildTarget, sources: list[str]) -> list[u8]:
    let scratch = files.make_temporary_directory(".", ".luce-examples-") catch reason:
        trap(reason)
    let output = paths.join(scratch, "artifact")
    build(target, output, package(sources)) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let artifact = files.read_bytes(output) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return artifact

func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

# Build one real native example through the product QBE toolchain, execute the
# installed artifact, and remove the owned directory on every path.
func materialize_native(output: str, sources: list[str], include_runtime: bool) -> !:
    if include_runtime:
        try build_with_runtime(BuildTarget.native, output, package(sources), runtime_package())
    else:
        try build(BuildTarget.native, output, package(sources))

func native_status(sources: list[str], include_runtime: bool = false) -> i64!:
    let scratch = try files.make_temporary_directory(".", ".luce-example-native-")
    let output = paths.join(scratch, "program")
    materialize_native(output, sources, include_runtime) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let process = os.Process(quote_shell_argument(output)) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    files.remove_all(scratch) catch reason:
        error(reason)
    return status

# Compile one generated source through the product path. This keeps deliberate
# runtime-failure fixtures focused without adding parser-only example files.
func native_source_status(source: str, include_runtime: bool = false) -> i64!:
    let scratch = try files.make_temporary_directory(".", ".luce-example-source-")
    let source_path = paths.join(scratch, "main.luc")
    files.write(source_path, source) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let status = native_status([source_path], include_runtime) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    files.remove_all(scratch) catch reason:
        error(reason)
    return status

# The full language surface remains parser coverage while HIR generation is
# implemented in vertical slices.
# mark: Parser conformance =====================================================================

pub func test_all_examples_parse():
    for path in example_paths():
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source).tokenize() catch reason:
            trap(reason)
        let syntax_tree = Parser(tokens).parse() catch reason:
            trap(reason)

# The parser-valid examples collectively exercise every reserved word and
# every contextual word with grammatical meaning. This is stronger than a
# text search: comments disappear and the complete containing module parses.
pub func test_examples_cover_every_reserved_and_contextual_word():
    let expected = [
        "and", "as", "break", "catch", "class", "continue", "defer", "elif", "else", "enum", "export", "extern", "false",
        "for", "from", "func", "if", "implements", "import", "in", "interface", "is", "let", "match", "mutating", "new",
        "none", "not", "or", "pub", "recover", "return", "self", "spawn", "struct", "test", "true", "try", "type", "var",
        "weak", "while", "c", "copy", "blocking", "out", "cfunc", "init", "deinit",
    ]
    let found = list[bool]()
    for word in expected: found.append(false)
    for path in example_paths():
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source).tokenize() catch reason:
            trap(reason)
        discard(Parser(tokens).parse()) catch reason:
            trap(reason)
        for token in tokens:
            for index in range(0, len(expected)):
                if token.text == expected[index]: found[index] = true
    for index in range(0, len(expected)):
        if not found[index]: trap("examples do not exercise grammar word `" + expected[index] + "`")

# mark: Executable examples ====================================================================

pub func test_semantic_core_reaches_hir_generation_through_the_pipeline():
    discard(check(package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]))) catch reason:
        trap(reason)

pub func test_semantic_core_executes_through_the_pipeline():
    let value = run(package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]), "main", "answer") catch reason:
        trap(reason)
    match value:
        Integer(result): assert(result == 42)
        else: assert(false)

pub func test_compiled_core_builds_webassembly_through_the_pipeline():
    let artifact = build_bytes(BuildTarget.wasm, ["examples/compiled_core/main.luc"])
    assert(len(artifact) > 8)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact[2] == 0x73)
    assert(artifact[3] == 0x6D)

pub func test_hello_builds_webassembly_through_the_pipeline():
    let artifact = build_bytes(BuildTarget.wasm, ["examples/hello.luc"])
    assert(len(artifact) > 8)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact[2] == 0x73)
    assert(artifact[3] == 0x6D)

pub func test_adopted_stage0_calculator_checks_and_runs_through_native_qbe():
    discard(check(package(["examples/stage0_calculator.luc"]))) catch reason:
        trap(reason)
    let status = native_status(["examples/stage0_calculator.luc"]) catch reason:
        trap(reason)
    assert(status == 0)

pub func test_adopted_stage0_sort_checks_and_runs_through_native_qbe():
    discard(check(package(["examples/stage0_sort.luc"]))) catch reason:
        trap(reason)
    let status = native_status(["examples/stage0_sort.luc"]) catch reason:
        trap(reason)
    assert(status == 0)

pub func test_adopted_stage0_brainfuck_runs_through_every_current_product_path():
    let sources = ["examples/stage0_brainfuck.luc"]
    discard(check(package(sources))) catch reason:
        trap(reason)
    let value = run(package(sources), "stage0_brainfuck", "answer") catch reason:
        trap(reason)
    match value:
        Integer(result): assert(result == 42)
        else: assert(false)
    assert(len(build_bytes(BuildTarget.wasm, sources)) > 8)
    let status = native_status(sources) catch reason:
        trap(reason)
    assert(status == 0)

