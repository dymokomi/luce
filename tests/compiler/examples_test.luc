    assert(len(analyzed.hir.functions) == 2)
    let result = run(package(sources), "pointer_width", "answer") catch reason:
        trap(reason)
    match result.value:
        UnsignedInteger(value): assert(value == u64(42))
        else: trap("base pointer_width answered a non-integer")
    let artifact = build_bytes(BuildTarget.wasm, sources)
    assert(len(artifact) > 8)
    assert(artifact[0] == 0)

