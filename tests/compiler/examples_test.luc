pub func test_base_exports_check_run_and_build_through_the_pipeline():
    let sources = ["examples/base/exports.lucb"]
    let analyzed = check(package(sources)) catch reason:
        trap(reason)
    assert(len(analyzed.hir.functions) == 3)
    let result = run(package(sources), "exports", "answer") catch reason:
        trap(reason)
    match result.value:
        SignedInteger(value): assert(value == 42)
        else: trap("base exports answered a non-integer")
    # A struct crossing a C export by value has no Wasm C ABI yet; the
    # build says so instead of trapping (base.md §17.6, §19.3).
    let scratch = files.make_temporary_directory(".", ".luce-examples-") catch reason:
        trap(reason)
    let output = paths.join(scratch, "artifact")
    var refused = ""
    discard(build(BuildTarget.wasm, output, package(sources))) catch reason:
        refused = reason
    files.remove_all(scratch) catch reason:
        trap(reason)
    assert(strings.contains(refused, "wasm backend cannot place `{i32, i32}` in a register"))

