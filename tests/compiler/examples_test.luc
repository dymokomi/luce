func runtime_package() -> RuntimePackageInput:
    return sealed_runtime_package("src/runtime", ["src/runtime/allocator.lucn"])

func build_bytes(target: BuildTarget, sources: list[str]) -> list[u8]:
    let scratch = files.make_temporary_directory(".", ".luce-examples-") catch reason:
        trap(reason)
    let output = paths.join(scratch, "artifact")
    discard(build(target, output, package(sources))) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let artifact = files.read_bytes(output) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return artifact

func build_runtime_bytes(target: BuildTarget, sources: list[str], source_root: str? = none) -> list[u8]:
    let scratch = files.make_temporary_directory(".", ".luce-runtime-example-") catch reason:
        trap(reason)
    let output = paths.join(scratch, "artifact")
    discard(build_with_runtime(target, output, package(sources, source_root), runtime_package())) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let artifact = files.read_bytes(output) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return artifact

func quote_shell_argument(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

# Build one real native example through the product QBE toolchain, execute the
# installed artifact, and remove the owned directory on every path.
func materialize_native(output: str, sources: list[str], include_runtime: bool, source_root: str? = none) -> !:
    if include_runtime:
        discard(try build_with_runtime(BuildTarget.native, output, package(sources, source_root), runtime_package()))
    else:
        discard(try build(BuildTarget.native, output, package(sources, source_root)))

struct ExecutionResult:
    let status: i64
    let diagnostic: str

func native_result(sources: list[str], include_runtime: bool = false, source_root: str? = none) -> ExecutionResult!:
    let scratch = try files.make_temporary_directory(".", ".luce-example-native-")
    let output = paths.join(scratch, "program")
    let diagnostic_path = paths.join(scratch, "stderr")
    materialize_native(output, sources, include_runtime, source_root) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let process = os.Process(quote_shell_argument(output) + " 2> " + quote_shell_argument(diagnostic_path)) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let diagnostic = files.read(diagnostic_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    files.remove_all(scratch) catch reason:
        error(reason)
    return ExecutionResult(status = status, diagnostic = diagnostic)

func native_status(sources: list[str], include_runtime: bool = false, source_root: str? = none) -> i64!:
    return (try native_result(sources, include_runtime, source_root)).status

func wasmtime_available() -> bool:
    let process = os.Process("sh -c 'command -v wasmtime >/dev/null 2>&1'") catch reason:
        return false
    let status = process.wait() catch reason:
        return false
    return status == 0

func runtime_wasm_result(sources: list[str], source_root: str? = none) -> ExecutionResult!:
    let scratch = try files.make_temporary_directory(".", ".luce-example-wasm-")
    let output = paths.join(scratch, "program.wasm")
    let diagnostic_path = paths.join(scratch, "stderr")
    discard(build_with_runtime(BuildTarget.wasm, output, package(sources, source_root), runtime_package())) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let process = os.Process("wasmtime run " + quote_shell_argument(output) + " 2> " + quote_shell_argument(diagnostic_path)) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let diagnostic = files.read(diagnostic_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    files.remove_all(scratch) catch reason:
        error(reason)
    return ExecutionResult(status = status, diagnostic = diagnostic)

func runtime_wasm_status(sources: list[str], source_root: str? = none) -> i64!:
    return (try runtime_wasm_result(sources, source_root)).status

# Compile one generated source through the product path. This keeps deliberate
# runtime-failure fixtures focused without adding parser-only example files.
func native_source_status(source: str, include_runtime: bool = false) -> i64!:
    let scratch = try files.make_temporary_directory(".", ".luce-example-source-")
    let source_path = paths.join(scratch, "main.luc")
    files.write(source_path, source) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    let status = native_status([source_path], include_runtime) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            error(reason + "; cleanup failed: " + cleanup_reason)
        error(reason)
    files.remove_all(scratch) catch reason:
        error(reason)
    return status

# The full language surface remains parser coverage while HIR generation is
# implemented in vertical slices.
# mark: Parser conformance =====================================================================

pub func test_all_examples_parse():
    for path in example_paths():
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source, profile_for_path(path)).tokenize() catch reason:
            trap(reason)
        let syntax_tree = Parser(tokens, profile_for_path(path)).parse() catch reason:
            trap(reason)

# The parser-valid examples collectively exercise every reserved word and
# every contextual word with grammatical meaning. This is stronger than a
# text search: comments disappear and the complete containing module parses.
pub func test_examples_cover_every_reserved_and_contextual_word():
    let expected = [
        "and", "as", "break", "catch", "class", "continue", "defer", "elif", "else", "enum", "export", "extern", "false",
        "for", "from", "func", "if", "implements", "import", "in", "interface", "is", "let", "match", "mutating", "new",
        "none", "not", "or", "pub", "recover", "return", "self", "spawn", "struct", "test", "true", "try", "type", "var",
        "weak", "while", "c", "copy", "blocking", "out", "cfunc", "init", "deinit",
    ]
    let found = list[bool]()
    for word in expected: found.append(false)
    for path in example_paths():
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source, profile_for_path(path)).tokenize() catch reason:
            trap(reason)
        discard(Parser(tokens, profile_for_path(path)).parse()) catch reason:
            trap(reason)
        for token in tokens:
            for index in range(0, len(expected)):
                if token.text == expected[index]: found[index] = true
    for index in range(0, len(expected)):
        if not found[index]: trap("examples do not exercise grammar word `" + expected[index] + "`")

# mark: Executable examples ====================================================================

pub func test_semantic_core_reaches_hir_generation_through_the_pipeline():
    discard(check(package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]))) catch reason:
        trap(reason)

pub func test_semantic_core_executes_through_the_pipeline():
    let value = run(package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]), "main", "answer") catch reason:
        trap(reason)
    match value.value:
        SignedInteger(result): assert(result == 42)
        else: assert(false)

pub func test_base_hello_checks_runs_and_builds_freestanding_through_the_pipeline():
    let sources = ["examples/base/hello.lucb"]
    let analyzed = check(package(sources)) catch reason:
        trap(reason)
    assert(len(analyzed.hir.functions) == 2)
    let result = run(package(sources), "hello", "answer") catch reason:
        trap(reason)
    match result.value:
        SignedInteger(value): assert(value == 42)
        else: trap("base hello answered a non-integer")
    let artifact = build_bytes(BuildTarget.wasm, sources)
    assert(len(artifact) > 8)
    assert(artifact[0] == 0)

pub func test_base_pointer_width_checks_runs_and_builds_through_the_pipeline():
    let sources = ["examples/base/pointer_width.lucb"]
