#==============================================================================================
#
#   examples_test - The examples keep working
#
#   DESCRIPTION:
#       Every example in examples/ must keep parsing, and the core examples
#       must keep checking, running, and building through the real pipeline —
#       the same paths the `luce` command line takes.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.pipeline import BuildTarget, PackageInput, RuntimePackageInput, StandardSourceInput, build, build_with_runtime, check, run
from luce.compiler.runtime_package import sealed_runtime_package
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.profile import profile_for_path
import std.files
import std.os
import std.paths
import std.strings

# mark: Product helpers ========================================================================

func package(source_paths: list[str], source_root: str? = none) -> PackageInput:
    let root = source_root else paths.dir(source_paths[0])
    return PackageInput(identity = "org.luce.examples", source_root = root, source_paths = source_paths)

# A Base package beside the compiler-supplied `memory` module (base.md §12).
func base_package(source_paths: list[str]) -> PackageInput:
    let standard = StandardSourceInput(source_root = "src/standard", source_paths = ["src/standard/memory.lucb", "src/standard/atomic.lucb"])
    return PackageInput(identity = "org.luce.examples", source_root = paths.dir(source_paths[0]), source_paths = source_paths, standard_sources = standard)

