#==============================================================================================
#
#   examples_test - The examples keep working
#
#   DESCRIPTION:
#       Every example in examples/ must keep parsing, and the core examples
#       must keep checking, running, and building through the real pipeline —
#       the same paths the `luce` command line takes.
#
#==============================================================================================

from luce.compiler.parser import Parser
from luce.compiler.pipeline import BuildTarget, build, check, run
from luce.compiler.tokenizer import Tokenizer
import std.files

# The full language surface remains parser coverage while HIR generation is
# implemented in vertical slices.
pub func test_all_examples_parse():
    let paths: list[str] = [
        "examples/hello.luc",
        "examples/compiled_core/main.luc",
        "examples/semantic_core/math.luc",
        "examples/semantic_core/main.luc",
        "examples/language_tour.luc",
        "examples/operators_and_literals.luc",
        "examples/c_api.luc",
        "examples/checkout/catalog.luc",
        "examples/checkout/pricing.luc",
        "examples/checkout/main.luc",
        "examples/c_import/temperature.luc",
        "examples/c_import/main.luc",
    ]
    for path in paths:
        let source = files.read(path) catch reason:
            trap(reason)
        let tokens = Tokenizer(source).tokenize() catch reason:
            trap(reason)
        let syntax_tree = Parser(tokens).parse() catch reason:
            trap(reason)

pub func test_semantic_core_reaches_hir_generation_through_the_pipeline():
    discard(check(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"])) catch reason:
        trap(reason)

pub func test_semantic_core_executes_through_the_pipeline():
    let value = run(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"], "main", "answer") catch reason:
        trap(reason)
    match value:
        Integer(result): assert(result == 42)
        else: assert(false)

pub func test_compiled_core_builds_webassembly_through_the_pipeline():
    let artifact = build(BuildTarget.wasm, ["examples/compiled_core/main.luc"]) catch reason:
        trap(reason)
    assert(len(artifact) > 8)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact[2] == 0x73)
    assert(artifact[3] == 0x6D)

pub func test_hello_builds_webassembly_through_the_pipeline():
    let artifact = build(BuildTarget.wasm, ["examples/hello.luc"]) catch reason:
        trap(reason)
    assert(len(artifact) > 8)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact[2] == 0x73)
    assert(artifact[3] == 0x6D)

pub func test_hello_builds_arm64_macos_through_the_pipeline():
    let artifact = build(BuildTarget.arm64_macos, ["examples/hello.luc"]) catch reason:
        trap(reason)
    assert(len(artifact) == 0x4000)
    assert(artifact[0] == 0xCF)
    assert(artifact[1] == 0xFA)
    assert(artifact[2] == 0xED)
    assert(artifact[3] == 0xFE)

# Failures inside a backend must surface as diagnostics through the
# command-level entry points, never as traps.
pub func test_pipeline_reports_backend_failures_as_diagnostics():
    let missing = run(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"], "main", "missing") catch reason:
        assert(reason == "interpreter: module `main` has no function `missing`")
        return
    trap("expected the interpreter to reject a missing function")

pub func test_pipeline_reports_native_entry_failures_as_diagnostics():
    let artifact = build(BuildTarget.arm64_macos, ["examples/compiled_core/main.luc"]) catch reason:
        assert(reason == "executable: needs one public `main`")
        return
    trap("expected the native backend to require `main`")
