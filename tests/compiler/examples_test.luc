pub func test_adopted_stage0_brainfuck_runs_through_every_current_product_path():
    let sources = ["examples/stage0_brainfuck.luc"]
    discard(check(package(sources))) catch reason:
        trap(reason)
    let value = run(package(sources), "stage0_brainfuck", "answer") catch reason:
        trap(reason)
    match value.value:
        SignedInteger(result): assert(result == 42)
        else: assert(false)
    assert(len(build_runtime_bytes(BuildTarget.wasm, sources)) > 8)
    let status = native_status(sources, true) catch reason:
        trap(reason)
    assert(status == 0)

