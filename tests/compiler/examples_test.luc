pub func test_runtime_backed_list_and_slice_bounds_trap_through_native_qbe():
    let indexing = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = []\n    return 0 if values[0u64] == 0 else 1\n"
    let index_status = native_source_status(indexing, true) catch reason:
        trap(reason)
    assert(index_status != 0)
    let insertion = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    values.insert(2u64, 2)\n    return 0\n"
    let insert_status = native_source_status(insertion, true) catch reason:
        trap(reason)
    assert(insert_status != 0)
    let removal = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    let removed = values.remove_at(1u64)\n    return 0\n"
    let remove_status = native_source_status(removal, true) catch reason:
        trap(reason)
    assert(remove_status != 0)
    let reversed_slice = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    return 0 if values[1u64..<0u64].length == 0u64 else 1\n"
    let reversed_status = native_source_status(reversed_slice, true) catch reason:
        trap(reason)
    assert(reversed_status != 0)
    let past_end_slice = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    return 0 if values[..<2u64].length == 0u64 else 1\n"
    let past_end_status = native_source_status(past_end_slice, true) catch reason:
        trap(reason)
    assert(past_end_status != 0)
    let slice_index = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    let view = values[..<1u64]\n    return 0 if view[1u64] == 0 else 1\n"
    let slice_index_status = native_source_status(slice_index, true) catch reason:
        trap(reason)
    assert(slice_index_status != 0)

pub func test_active_list_iteration_rejects_shape_mutation_through_native_qbe():
    let append = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1, 2]\n    let alias = values\n    var first = true\n    for value in values:\n        if first:\n            first = false\n            continue\n        alias.append(2)\n    return 0\n"
    let append_status = native_source_status(append, true) catch reason:
        trap(reason)
    assert(append_status != 0)
    let insert = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    for value in values: values.insert(0u64, 2)\n    return 0\n"
    let insert_status = native_source_status(insert, true) catch reason:
        trap(reason)
    assert(insert_status != 0)
    let remove = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    for value in values: values.remove_at(0u64)\n    return 0\n"
    let remove_status = native_source_status(remove, true) catch reason:
        trap(reason)
    assert(remove_status != 0)
    let clear = "pub func main(arguments: slice[str]) -> i32!:\n    let values: list[i64] = [1]\n    for value in values: values.clear()\n    return 0\n"
    let clear_status = native_source_status(clear, true) catch reason:
        trap(reason)
    assert(clear_status != 0)

# mark: Pipeline diagnostics ===================================================================

# Failures inside a backend must surface as diagnostics through the
# command-level entry points, never as traps.
pub func test_pipeline_reports_backend_failures_as_diagnostics():
    let missing = run(package(["examples/semantic_core/math.luc", "examples/semantic_core/main.luc"]), "main", "missing") catch reason:
        assert(reason == "interpreter: module `main` has no function `missing`")
        return
    trap("expected the interpreter to reject a missing function")

pub func test_pipeline_reports_native_entry_failures_as_diagnostics():
    let scratch = files.make_temporary_directory(".", ".luce-examples-") catch reason:
        trap(reason)
    discard(build(BuildTarget.native, paths.join(scratch, "artifact"), package(["examples/compiled_core/main.luc"]))) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        assert(reason == "executable: needs one public `main`")
        return
    files.remove_all(scratch) catch reason:
        trap(reason)
    trap("expected the native backend to require `main`")
