pub func test_dynamic_source_trap_terminates_every_execution_path():
    let sources = ["examples/traps.luc"]
    discard(check(package(sources))) catch reason:
        trap(reason)
    var oracle_trapped = false
    discard(run(package(sources), "traps", "main")) catch reason:
        assert(strings.contains(reason, "interpreter: trap: broken invariant"))
        oracle_trapped = true
    assert(oracle_trapped)
    let native = native_result(sources, true) catch reason:
        trap(reason)
    assert(native.status != 0)
    assert(native.diagnostic == "broken invariant\n")
    assert(len(build_runtime_bytes(BuildTarget.wasm, sources)) > 8)
    if wasmtime_available():
        let wasm = runtime_wasm_result(sources) catch reason:
            trap(reason)
        assert(wasm.status != 0)
        assert(strings.contains(wasm.diagnostic, "broken invariant\n"))

