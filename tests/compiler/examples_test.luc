    let result = run(base_package(sources), "atomics", "answer") catch reason:
        trap(reason)
    match result.value:
        SignedInteger(value): assert(value == 42)
        else: trap("base atomics answered a non-integer")
    let scratch = files.make_temporary_directory(".", ".luce-examples-") catch reason:
        trap(reason)
    let output = paths.join(scratch, "artifact")
    discard(build(BuildTarget.wasm, output, base_package(sources))) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
