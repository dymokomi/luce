#==============================================================================================
#
#   pipeline_stages_test - Architectural stage boundaries remain executable
#
#   DESCRIPTION:
#       The early no-op stages are still real contracts: semantic analysis
#       preserves typed HIR and optimization preserves valid canonical MIR.
#       These tests make intentional identity behavior visible and temporary.
#
#==============================================================================================

from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType
from luce.compiler.optimizer import Optimizer
from luce.compiler.semantic_analyzer import SemanticAnalyzer
from luce.compiler.hir import create_empty_hir_program

pub func test_semantic_analyzer_preserves_the_current_typed_hir():
    let program = create_empty_hir_program()
    let analyzed = SemanticAnalyzer(program).analyze() catch reason:
        trap(reason)
    assert(len(analyzed.hir.modules) == 0)

pub func test_optimizer_preserves_the_current_canonical_mir():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 7),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = CanonicalType.signed_i64, instructions = instructions)
    let optimized = Optimizer(CanonicalProgram(functions = [function])).optimize()
    assert(len(optimized.functions) == 1)
    assert(len(optimized.functions[0].instructions) == 2)
    match optimized.functions[0].instructions[0]:
        I64Constant(value): assert(value == 7)
        else: assert(false)
    assert(str(optimized.functions[0].instructions[1]) == "Return")
