#==============================================================================================
#
#   language_profile_test - Profile selection and admission
#
#   DESCRIPTION:
#       The profile is selected by suffix alone, its full-only reserved words
#       are exactly the tokenizer's, and admission is answered over the
#       existing structural type keys rather than a second vocabulary.
#
#       The file is not named `profile_test`: under Stage-0 0.30 that exact
#       test module name beside source module `compiler.profile` fails three
#       of these assertions, while the same file under any other name passes
#       (docs/compiler/stage0-0.30.md, "Open observation").
#
#==============================================================================================

from luce.compiler.frontend.tokenizer import is_keyword
from luce.compiler.hir.ir import BuiltinType, TypeForm, TypeId, resolve_builtin_type, type_form_key
from luce.compiler.mir.canonical import MirType, mir_type_key
from luce.compiler.hir.ir import ModuleAuthority
from luce.compiler.profile import Profile, admits_mir_type, admits_type_form, full_only_reserved_words, profile_for_path, profile_name, profile_of

# mark: Selection ============================================================================

pub func test_profile_is_selected_by_suffix_alone():
    assert(profile_for_path("src/main.luc") == Profile.full)
    assert(profile_for_path("src/arena.lucn") == Profile.full)
    assert(profile_for_path("src/runtime/heap.lucb") == Profile.base)
    assert(profile_for_path("src/runtime/heap.lucb") == Profile.base)
    assert(profile_for_path("lucb") == Profile.full)
    assert(profile_name(Profile.full) == "full Luce")
    assert(profile_name(Profile.base) == "Luce Base")
    assert(profile_of(ModuleAuthority.safe) == Profile.full)
    assert(profile_of(ModuleAuthority.native) == Profile.full)
    assert(profile_of(ModuleAuthority.standard) == Profile.full)
    assert(profile_of(ModuleAuthority.base) == Profile.base)

pub func test_full_only_reserved_words_are_tokenizer_keywords():
    let words = full_only_reserved_words()
    assert(len(words) == 3)
    for word in words: assert(is_keyword(word))

# mark: Admission ============================================================================

pub func test_type_admission_follows_the_structural_key():
    let element = resolve_builtin_type(BuiltinType.unsigned_u8)
    let list_key = type_form_key(TypeForm.List(element = element))
    let scalar_key = type_form_key(TypeForm.Integer(bits = 64, is_signed = true))
    assert(admits_type_form(Profile.full, list_key))
    assert(not admits_type_form(Profile.base, list_key))
    assert(admits_type_form(Profile.base, scalar_key))
    assert(admits_type_form(Profile.base, type_form_key(TypeForm.Struct(index = 0, arguments = list[TypeId]()))))
    assert(not admits_type_form(Profile.base, type_form_key(TypeForm.Class(index = 0, arguments = list[TypeId]()))))

pub func test_mir_type_admission_follows_the_structural_key():
    let scalar = mir_type_key(MirType.Int(bits = 32, is_signed = false))
    assert(admits_mir_type(Profile.base, scalar))
    assert(admits_mir_type(Profile.base, mir_type_key(MirType.Ptr)))
    assert(not admits_mir_type(Profile.base, mir_type_key(MirType.TaskGroup)))
    assert(admits_mir_type(Profile.full, mir_type_key(MirType.TaskGroup)))
