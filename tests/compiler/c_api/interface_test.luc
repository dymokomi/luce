#==============================================================================================
#
#   c_api_interface_test - The target-neutral exported C source graph
#
#   DESCRIPTION:
#       Builds real checked HIR and proves that C API projection preserves
#       declaration identities, documentation, nullability, exact enum values,
#       and root-package ownership without introducing target layout.
#
#==============================================================================================

from luce.compiler.c_api.model import c_api_declaration_name, c_api_interface
from luce.compiler.c_api.header import render_c_header
from luce.compiler.backends.qbe_abi import render_qbe_abi_report
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.ir import HirProgram, ModuleAuthority
from luce.compiler.mir.lowerer import Lowerer
from luce.compiler.packages.program_codec import encode_typed_hir_package
import std.files
import std.os
import std.paths
import std.strings

# mark: Fixtures ===============================================================================

func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax)

func generated(identity: str, modules: list[SourceModule]) -> HirProgram:
    let program = HirGenerator(identity, modules).generate() catch reason:
        trap(reason)
    return program

func generation_failure(modules: list[SourceModule]) -> str:
    let program = HirGenerator("org.luce.c-api-test", modules).generate() catch reason:
        return reason
    return ""

# mark: Interface projection ==================================================================

pub func test_c_api_interface_preserves_one_named_target_neutral_graph():
    let source = (
        "## An opaque window.\npub extern type Window\n"
        + "## A device number.\npub extern type Device = i32\n"
        + "## Operation status.\nexport c enum Status as i32:\n"
        + "    ## Work remains.\n    pending = -2\n    complete = 42\n"
        + "## A point.\nexport c struct Point:\n    let x: i32\n    let y: i32\n"
        + "## One response.\nexport c struct Response:\n    let point: Point\n    let status: Status\n    let weight: f64\n"
        + "## Transform a response.\nexport c func transform(window: Window?, device: Device, value: Response) -> Response: return value\n"
    )
    let api = c_api_interface(generated("org.luce.graphics", [source_module("main", source)])) catch reason:
        trap(reason)
    assert(api.package_identity == "org.luce.graphics")
    assert(len(api.declarations) == 5 and len(api.functions) == 1)
    assert(c_api_declaration_name(api.declarations[0]) == "Window")
    assert(c_api_declaration_name(api.declarations[1]) == "Device")
    assert(c_api_declaration_name(api.declarations[2]) == "Status")
    assert(c_api_declaration_name(api.declarations[3]) == "Point")
    assert(c_api_declaration_name(api.declarations[4]) == "Response")

    match api.declarations[0]:
        OpaqueHandle(name, documentation): assert(documentation[0] == "An opaque window.")
        else: assert(false)
    match api.declarations[1]:
        IntegerHandle(name, documentation, representation):
            match representation.value:
                Integer(bits, is_signed): assert(bits == 32 and is_signed)
                else: assert(false)
        else: assert(false)
    match api.declarations[2]:
        FixedEnum(name, documentation, representation, cases):
            assert(documentation[0] == "Operation status." and len(cases) == 2)
            assert(cases[0].documentation[0] == "Work remains.")
            match cases[0].value:
                Signed(value): assert(value == -2)
                else: assert(false)
        else: assert(false)
    match api.declarations[4]:
        Record(name, documentation, fields):
            assert(len(fields) == 3 and fields[0].name == "point" and fields[1].name == "status")
            match fields[0].value_type.value:
                Named(declaration): assert(declaration == u32(3))
                else: assert(false)
        else: assert(false)

    let function = api.functions[0]
    assert(function.name == "transform" and function.documentation[0] == "Transform a response.")
    assert(len(function.parameters) == 3 and function.parameters[0].value_type.is_nullable)
    match function.parameters[0].value_type.value:
        Named(declaration): assert(declaration == u32(0))
        else: assert(false)
    match function.result.value:
        Named(declaration): assert(declaration == u32(4))
        else: assert(false)

pub func test_generated_header_is_standalone_exact_and_c11_valid():
    let source = (
        "pub extern type Window\n"
        + "pub extern type Device = i32\n"
        + "export c struct Outer:\n    let inner: Inner\n    let window_count: u64\n"
        + "export c struct Inner:\n    let status: Status\n    let enabled: bool\n"
        + "export c enum Status as i32:\n    pending = -2\n    complete = 42\n"
        + "export c func inspect(window: Window?, device: Device, value: Outer) -> Status: return value.inner.status\n"
    )
    let api = c_api_interface(generated("org.test", [source_module("main", source)])) catch reason:
        trap(reason)
    let header = render_c_header(api)
    let expected = (
        "/* Generated by Luce 1.0. Do not edit. */\n"
        + "#ifndef LUCE_C_API_6F72672E74657374_H\n#define LUCE_C_API_6F72672E74657374_H\n\n"
        + "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n"
        + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
        + "typedef struct Window Window;\n\ntypedef int32_t Device;\n\ntypedef int32_t Status;\n\n"
        + "typedef struct Outer Outer;\ntypedef struct Inner Inner;\n\n"
        + "#define Status_pending ((Status)(-INT64_C(2)))\n"
        + "#define Status_complete ((Status)(INT64_C(42)))\n\n"
        + "struct Inner {\n    Status status;\n    bool enabled;\n};\n\n"
        + "struct Outer {\n    Inner inner;\n    uint64_t window_count;\n};\n\n"
        + "Status inspect(Window * window, Device device, Outer value);\n\n"
        + "#ifdef __cplusplus\n}\n#endif\n\n#endif /* LUCE_C_API_6F72672E74657374_H */\n"
    )
    if header != expected: trap("unexpected generated header:\n" + header)

    let scratch = files.make_temporary_directory(".", ".luce-c-header-test-") catch reason:
        trap(reason)
    let header_path = paths.join(scratch, "api.h")
    let source_path = paths.join(scratch, "consumer.c")
    let object_path = paths.join(scratch, "consumer.o")
    files.write(header_path, header) catch reason:
        trap(reason)
    files.write(source_path, "#include \"api.h\"\nint use_api(Window *window, Device device, Outer value) { return inspect(window, device, value) == Status_complete; }\n") catch reason:
        trap(reason)
    let process = os.Process("cc -std=c11 -Wall -Werror -c " + quote(source_path) + " -o " + quote(object_path)) catch reason:
        trap(reason)
    let status = process.wait() catch reason:
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    assert(status == 0)

pub func test_qbe_abi_report_attaches_only_backend_owned_layout_facts():
    let source = (
        "pub extern type Window\n"
        + "export c enum Status as i16:\n    pending = -2\n    complete = 42\n"
        + "export c struct Packet:\n    let tag: u8\n    let status: Status\n    let weight: f64\n"
        + "export c func send(window: Window?, packet: Packet) -> Status: return packet.status\n"
    )
    let hir = generated("org.luce.net", [source_module("main", source)])
    let api = c_api_interface(hir) catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let mir = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    let report = render_qbe_abi_report(api, mir, "arm64-apple-darwin") catch reason:
        trap(reason)
    let expected = (
        "{\n"
        + "  \"format\": \"luce-c-abi-1\",\n"
        + "  \"package\": \"org.luce.net\",\n"
        + "  \"target\": \"arm64-apple-darwin\",\n"
        + "  \"types\": [\n"
        + "    {\"kind\": \"opaque_handle\", \"name\": \"Window\", \"size\": 8, \"alignment\": 8},\n"
        + "    {\"kind\": \"fixed_enum\", \"name\": \"Status\", \"size\": 2, \"alignment\": 2, \"representation\": \"int16_t\", \"values\": [{\"name\": \"pending\", \"value\": \"-2\"}, {\"name\": \"complete\", \"value\": \"42\"}]},\n"
        + "    {\"kind\": \"record\", \"name\": \"Packet\", \"size\": 16, \"alignment\": 8, \"fields\": [{\"name\": \"tag\", \"type\": \"uint8_t\", \"offset\": 0, \"size\": 1, \"alignment\": 1}, {\"name\": \"status\", \"type\": \"Status\", \"offset\": 2, \"size\": 2, \"alignment\": 2}, {\"name\": \"weight\", \"type\": \"double\", \"offset\": 8, \"size\": 8, \"alignment\": 8}]}\n"
        + "  ],\n"
        + "  \"symbols\": [\n"
        + "    {\"name\": \"send\", \"calling_convention\": \"c\", \"parameters\": [{\"name\": \"window\", \"type\": \"Window *\", \"nullable\": true}, {\"name\": \"packet\", \"type\": \"Packet\", \"nullable\": false}], \"result\": {\"type\": \"Status\", \"nullable\": false}}\n"
        + "  ]\n}\n"
    )
    if report != expected: trap("unexpected ABI report:\n" + report)

# mark: Closed C namespace ====================================================================

pub func test_c_exports_require_portable_collision_free_exact_names():
    assert(generation_failure([source_module("main", "export c func long() -> i32: return 0i32\n")]) == "main.luc:1:1: exported C function `long` is a reserved C or C++ word")
    assert(generation_failure([source_module("main", "export c func template() -> i32: return 0i32\n")]) == "main.luc:1:1: exported C function `template` is a reserved C or C++ word")
    assert(generation_failure([source_module("main", "export c func _hidden() -> i32: return 0i32\n")]) == "main.luc:1:1: exported C function `_hidden` is not a portable C identifier")
    assert(generation_failure([source_module("main", "export c func api__run() -> i32: return 0i32\n")]) == "main.luc:1:1: exported C function `api__run` is not a portable C identifier")
    assert(generation_failure([source_module("main", "export c func INT64_C() -> i32: return 0i32\n")]) == "main.luc:1:1: exported C function `INT64_C` conflicts with the generated header's standard C names")
    assert(generation_failure([source_module("main", "export c enum INT8 as i32:\n    MAX = 1\n")]) == "main.luc:1:1: generated C identifier `INT8_MAX` conflicts with the generated header's standard C names")
    assert(generation_failure([source_module("main", "export c func run(long: i32) -> i32: return long\n")]) == "main.luc:1:1: exported C parameter `long` is a reserved C or C++ word")
    assert(generation_failure([source_module("main", "export c struct Point:\n    let long: i32\n")]) == "main.luc:1:1: exported C field `long` is a reserved C or C++ word")
    assert(generation_failure([
        source_module("first", "export c struct Point:\n    let x: i32\n"),
        source_module("second", "export c struct Point:\n    let y: i32\n"),
    ]) == "second.luc:1:1: generated C identifier `Point` collides with another exported declaration")
    assert(generation_failure([source_module("main", "export c enum Status as i32:\n    ready = 1\nexport c func Status_ready() -> i32: return 0i32\n")]) == "main.luc:3:1: generated C identifier `Status_ready` collides with another exported declaration")

pub func test_c_exports_cannot_publish_dependency_owned_native_types():
    let dependency = generated("org.luce.dependency", [source_module("dep", "export c struct Point:\n    let x: i32\n")])
    let artifact = encode_typed_hir_package(dependency) catch reason:
        trap(reason)
    let root = source_module("main", "from dep import Point\nexport c struct Wrapper:\n    let value: Point\n")
    let generator = HirGenerator("org.luce.root", [root])
    generator.add_dependency(artifact)
    let program = generator.generate() catch reason:
        assert(strings.contains(reason, "C export references dependency-owned native type `Point`; declare a root-package wrapper type"))
        return
    assert(false)

func quote(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"
