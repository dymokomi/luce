#==============================================================================================
#
#   hir_test - Semantic identities and tables
#
#   DESCRIPTION:
#       Direct HIR tests establish the representation contract independently of
#       parsing and checking: built-in types have canonical identities and
#       structural forms, diagnostic names do not drive semantics, and effects
#       are queried as tags rather than strings.
#
#==============================================================================================

from luce.compiler.hir import BuiltinType, Effect, TypeId, contains_effect
from luce.compiler.hir import create_builtin_type_table, create_empty_effect_set
from luce.compiler.hir import describe_type, is_floating_type, is_integer_type
from luce.compiler.hir import is_numeric_type, resolve_builtin_type, types_match

pub func test_builtin_types_have_canonical_identities_and_structural_forms():
    let types = create_builtin_type_table()
    let i32_type = resolve_builtin_type(BuiltinType.signed_i32)
    let i64_type = resolve_builtin_type(BuiltinType.signed_i64)
    let f64_type = resolve_builtin_type(BuiltinType.float64)

    assert(len(types.definitions) == 7)
    assert(not types_match(i32_type, i64_type))
    assert(is_integer_type(i32_type))
    assert(is_integer_type(i64_type))
    assert(is_floating_type(f64_type))
    assert(is_numeric_type(f64_type))
    assert(describe_type(types, i64_type) == "i64")

    match types.definitions[i32_type.value].form:
        Integer(bits, is_signed):
            assert(bits == 32)
            assert(is_signed)
        else: assert(false)
    match types.definitions[resolve_builtin_type(BuiltinType.string_slice).value].form:
        Slice(element): assert(types_match(element, resolve_builtin_type(BuiltinType.string)))
        else: assert(false)

pub func test_type_names_are_diagnostics_not_semantic_identity():
    let types = create_builtin_type_table()
    let invalid = TypeId(value = 999)
    assert(not types_match(invalid, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(describe_type(types, invalid) == "<invalid type 999>")

pub func test_effect_sets_use_semantic_effect_tags():
    let effects = create_empty_effect_set()
    assert(not contains_effect(effects, Effect.terminal))
    effects.values.append(Effect.terminal)
    assert(contains_effect(effects, Effect.terminal))
