pub func test_borrowed_c_lists_expose_ordered_elements_and_keep_the_count_explicit():
    let source = "extern func sum(values: list[i32], count: u64) -> i32\npub func answer() -> i32:\n    return sum([20i32, 99i32], 1u64) + sum([22i32], 1u64) + sum([], 0u64)\n"
