        else: assert(false)
    let failed = HirInterpreter().run_with_hosts(handle_program, "main", "null_element", BorrowedHandleListHost(), ZeroWindowVariableHost()) catch reason:
        assert(reason == "interpreter: null_foreign crossing extern `main.consume` parameter `values` element 0")
        return
    trap("expected a null borrowed handle element to trap before C")

