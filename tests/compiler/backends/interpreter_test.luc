pub func test_raw_cfunc_results_outputs_and_fields_remain_callable_opaque_tokens():
    let declarations = "type Callback = cfunc(i32) -> i32\nextern struct Hooks:\n    callback: Callback\nextern func acquire() -> Callback\nextern func maybe_acquire() -> Callback?\nextern func read(out callback: Callback)\nextern func read_hooks(out hooks: Hooks)\nextern func missing() -> Callback\n"
    let source = declarations + "pub func answer() -> i32:\n    let direct = acquire()\n    let optional = maybe_acquire()\n    if let unexpected = optional: return unexpected(0i32)\n    let output = read()\n    let hooks = read_hooks()\n    return direct(10i32) + output(10i32) + hooks.callback(10i32)\npub func invoke_null() -> i32: return missing()(0i32)\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_c_function_pointers(program, "main", "answer", DynamicCFunctionSourceHost(), DynamicCFunctionPointerHost()) catch reason:
        trap(reason)
    assert(integer(answer) == 33)
    assert(host_execution_failure(program, "invoke_null", DynamicCFunctionSourceHost()) == "interpreter: null_foreign invoking cfunc")

pub func test_external_variables_use_explicit_mutable_storage_and_keep_zero_handles_bare():
