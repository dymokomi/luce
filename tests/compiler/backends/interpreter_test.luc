#==============================================================================================
#
#   interpreter_test - The semantic oracle behaves
#
#   DESCRIPTION:
#       Source fixtures in, values (or stable diagnostics) out, through the
#       full front end and the interpreter. What passes here is the behavior
#       every compiled backend must reproduce.
#
#==============================================================================================

from luce.compiler.hir.generator import HirGenerator, SourceModule
from luce.compiler.backends.interpreter import HirExternHost, HirExternResult, HirExternVariableHost, HirInterpreter
from luce.compiler.frontend.parser import Parser
from luce.compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.ir import HirExternVariable, HirFunction, HirProgram, ModuleAuthority, Value

# mark: Test helpers ========================================================================

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> HirProgram:
    let program = HirGenerator("test.luce", sources).generate() catch reason:
        trap(reason)
    return program

# Cross the semantic-analysis boundary required by every HIR execution backend.
pub func analyzed(sources: list[SourceModule]) -> AnalyzedProgram:
    let program = SemanticAnalyzer(checked(sources)).analyze() catch reason:
        trap(reason)
    return program

pub func execute(sources: list[SourceModule], module_name: str = "main", function_name: str = "answer") -> Value:
    let value = HirInterpreter().run(analyzed(sources), module_name, function_name) catch reason:
        trap(reason)
    return value

pub func execution_failure(source: str, function_name: str) -> str:
    let program = analyzed([source_module("main", source)])
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

pub func execution_failure_for(program: AnalyzedProgram, function_name: str) -> str:
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

pub func integer(value: Value) -> i64:
    match value:
        Integer(item): return item
        else: trap("expected an integer")

pub func foreign_token(value: Value) -> i64:
    match value:
        Foreign(token): return token
        else: trap("expected a foreign handle")

pub func host_execution_failure(program: AnalyzedProgram, function_name: str, host: HirExternHost) -> str:
    let value = HirInterpreter().run_with_host(program, "main", function_name, host) catch reason:
        return reason
    return ""

pub func export_call_failure(program: AnalyzedProgram, function_name: str, arguments: list[Value]) -> str:
    let value = HirInterpreter().call_c_export(program, function_name, arguments) catch reason:
        return reason
    return ""

func extern_result(value: Value) -> HirExternResult:
    return HirExternResult(result = value, outputs = list[Value]())

class AbsoluteHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "abs": error("unexpected extern")
        let value = integer(arguments[0])
        if value < 0: return extern_result(Value.Integer(value = -value))
        return extern_result(Value.Integer(value = value))

class CallbackHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "register" or len(arguments) != 1: error("unexpected extern")
        match arguments[0]:
            CFunction(symbol): return extern_result(Value.Integer(value = 0))
            else: error("callback did not cross as a cfunc value")

class WrongExternHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return extern_result(Value.Boolean(value = true))

class PidHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "getpid": error("unexpected extern")
        return extern_result(Value.Foreign(token = 42))

class OutOfRangePidHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return extern_result(Value.Foreign(token = 2147483648))

class NullWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create" or function.name == "broken": return extern_result(Value.Foreign(token = 0))
        error("unexpected extern")

class LiveWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create": return extern_result(Value.Foreign(token = 42))
        if function.name == "show": return extern_result(Value.Boolean(value = foreign_token(arguments[0]) == 42))
        error("unexpected extern")

class SplitHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "split" or len(arguments) != 1 or integer(arguments[0]) != 41: error("unexpected extern call")
        return HirExternResult(
            result = Value.Integer(value = 1),
            outputs = [Value.Integer(value = 42), Value.Foreign(token = 99)],
        )

class MissingOutHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return HirExternResult(result = Value.Integer(value = 1), outputs = [Value.Integer(value = 42)])

class GlobalHost: HirExternVariableHost:
    pub var counter: i64
    pub var current: i64

    pub init():
        self.counter = 40
        self.current = 0

    pub func load(variable: HirExternVariable) -> Value!:
        if variable.name == "counter": return Value.Integer(value = self.counter)
        if variable.name == "current": return Value.Foreign(token = self.current)
        error("unexpected external global")

    pub func store(variable: HirExternVariable, value: Value) -> !:
        if variable.name == "counter":
            self.counter = integer(value)
            return
        if variable.name == "current":
            self.current = foreign_token(value)
            return
        error("unexpected external global")


# mark: Calls and control flow ==============================================================

pub func test_cfunc_values_call_defined_adapters_and_extern_bindings_semantically():
    let source = "extern func abs(value: i32) -> i32\nfunc negate(value: i32) -> i32: return -value\npub func local_answer() -> i32:\n    let callback: cfunc(i32) -> i32 = negate\n    return callback(-42i32)\npub func answer() -> i32:\n    let callback: cfunc(i32) -> i32 = abs\n    return callback(-42i32)\n"
    let program = analyzed([source_module("main", source)])
    let local = HirInterpreter().run(program, "main", "local_answer") catch reason:
        trap(reason)
    assert(integer(local) == 42)
    let external = HirInterpreter().run_with_host(program, "main", "answer", AbsoluteHost()) catch reason:
        trap(reason)
    assert(integer(external) == 42)

    let registration = analyzed([source_module("main", "extern func register(callback: cfunc() -> unit) -> i32\nfunc goodbye(): return\npub func answer() -> i32:\n    let callback: cfunc() -> unit = goodbye\n    return register(callback)\n")])
    let registered = HirInterpreter().run_with_host(registration, "main", "answer", CallbackHost()) catch reason:
        trap(reason)
    assert(integer(registered) == 0)

pub func test_bytes_length_index_and_string_byte_count_execute_with_checked_bounds():
    let source = "pub func size() -> u64: return b\"abc\".length\npub func byte_at() -> u8: return b\"abc\"[1u64]\npub func text_bytes() -> u64: return \"λ\".byte_count\npub func missing() -> u8: return b\"abc\"[3u64]\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "size")) == 3)
    assert(integer(execute(modules, function_name = "byte_at")) == 98)
    assert(integer(execute(modules, function_name = "text_bytes")) == 2)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")

pub func test_fixed_arrays_are_checked_structural_values_with_nested_mutation():
    let source = "type Row = array[i64, 2]\nstruct Grid:\n    var rows: array[Row, 2]\nstruct Cell:\n    var value: i64\n    mutating func bump(self, by: i64): self.value += by\npub func read() -> i64:\n    let row: Row = [4, 2]\n    return row[0u64] * 10 + row[1u64]\npub func copied() -> i64:\n    var original: Row = [1, 2]\n    var changed = original\n    changed[0u64] = 9\n    return original[0u64] * 10 + changed[0u64]\npub func nested() -> i64:\n    var grid = Grid(rows = [[1, 2], [3, 4]])\n    grid.rows[1u64][0u64] += 5\n    return grid.rows[1u64][0u64]\npub func method() -> i64:\n    var cells: array[Cell, 2] = [Cell(value = 1), Cell(value = 2)]\n    cells[1u64].bump(5)\n    return cells[1u64].value\npub func equal() -> bool:\n    let left: Row = [1, 2]\n    let right: Row = [1, 2]\n    return left == right\npub func empty() -> u64:\n    let values: array[i64, 0] = []\n    return values.length\npub func missing() -> i64:\n    let values: Row = [1, 2]\n    return values[2u64]\npub func missing_store() -> i64:\n    var values: Row = [1, 2]\n    values[2u64] = 3\n    return 0\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "read")) == 42)
    assert(integer(execute(modules, function_name = "copied")) == 19)
    assert(integer(execute(modules, function_name = "nested")) == 8)
    assert(integer(execute(modules, function_name = "method")) == 7)
    assert(execute(modules, function_name = "equal").render() == "true")
    assert(integer(execute(modules, function_name = "empty")) == 0)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")
    assert(execution_failure(source, "missing_store") == "interpreter: index out of bounds")

pub func test_lists_share_identity_and_mutate_through_immutable_bindings():
    let source = "struct Holder:\n    let values: list[i64]\nstruct Cell:\n    var value: i64\n    mutating func bump(self, by: i64): self.value += by\npub func answer() -> i64:\n    let values: list[i64] = [1]\n    let alias = values\n    alias.append(1)\n    let holder = Holder(values = values)\n    holder.values[0u64] += 40\n    return alias[0u64] + values[1u64] if holder.values.length == 2u64 else 0\npub func method() -> i64:\n    let cells: list[Cell] = [Cell(value = 2)]\n    cells[0u64].bump(40)\n    return cells[0u64].value\npub func missing() -> i64:\n    let values: list[i64] = []\n    return values[0u64]\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "answer")) == 42)
    assert(integer(execute(modules, function_name = "method")) == 42)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")

pub func test_extern_calls_use_an_explicit_semantic_host():
    let source = "extern func abs(value: i32) -> i32\npub func answer() -> i32: return abs(-42i32)\n"
    let program = analyzed([source_module("main", source)])
    assert(execution_failure_for(program, "answer") == "interpreter: extern `main.abs` has no host binding")
    let answer = HirInterpreter().run_with_host(program, "main", "answer", AbsoluteHost()) catch reason:
        trap(reason)
    assert(integer(answer) == 42)
    let wrong = HirInterpreter().run_with_host(program, "main", "answer", WrongExternHost()) catch reason:
        assert(reason == "interpreter: extern `main.abs` returned result incompatible with `i32`")
        return
    trap("expected the host result type to be checked")

pub func test_integer_extern_handles_are_opaque_values_with_checked_representations():
    let source = "extern type Pid = i32\nextern func getpid() -> Pid\npub func answer() -> bool:\n    let pid = getpid()\n    return pid == pid\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_host(program, "main", "answer", PidHost()) catch reason:
        trap(reason)
    match answer:
        Boolean(value): assert(value)
        else: assert(false)
    let invalid = HirInterpreter().run_with_host(program, "main", "answer", OutOfRangePidHost()) catch reason:
        assert(reason == "interpreter: extern `main.getpid` returned result incompatible with `Pid`")
        return
    trap("expected the handle representation range to be checked")

pub func test_pointer_handles_encode_null_only_at_c_boundaries():
    let source = "extern type Window\nextern func create() -> Window?\npub extern func broken() -> Window\nextern func show(window: Window) -> bool\npub func absent() -> bool: return create() == none\npub func use() -> bool:\n    match create():\n        .some(window): return show(window)\n        .none: return false\nexport c func accepts(window: Window) -> bool: return window == window\nexport c func optional(window: Window?) -> bool: return window == none\nexport c func echo(window: Window?) -> Window?: return window\n"
    let program = analyzed([source_module("main", source)])

    let absent = HirInterpreter().run_with_host(program, "main", "absent", NullWindowHost()) catch reason:
        trap(reason)
    match absent:
        Boolean(value): assert(value)
        else: assert(false)

    let used = HirInterpreter().run_with_host(program, "main", "use", LiveWindowHost()) catch reason:
        trap(reason)
    match used:
        Boolean(value): assert(value)
        else: assert(false)

    assert(host_execution_failure(program, "broken", NullWindowHost()) == "interpreter: null_foreign crossing extern `main.broken` result")
    assert(export_call_failure(program, "accepts", [Value.Foreign(token = 0)]) == "interpreter: null_foreign crossing C export `accepts` parameter `window`")

    let none_value = HirInterpreter().call_c_export(program, "optional", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    match none_value:
        Boolean(value): assert(value)
        else: assert(false)
    let echoed = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 42)]) catch reason:
        trap(reason)
    assert(foreign_token(echoed) == 42)
    let echoed_none = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    assert(foreign_token(echoed_none) == 0)

pub func test_c_out_parameters_are_returned_in_source_declaration_order():
    let source = "extern type Window\nextern func split(value: i32, out rest: i32, out window: Window?) -> i32\npub func answer() -> bool:\n    let (result, rest, window) = split(41)\n    return result == 1 and rest == 42 and window != none\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_host(program, "main", "answer", SplitHost()) catch reason:
        trap(reason)
    match answer:
        Boolean(value): assert(value)
        else: assert(false)
    assert(host_execution_failure(program, "answer", MissingOutHost()) == "interpreter: extern `main.split` returned 1 out value(s), expected 2")

pub func test_external_variables_use_explicit_mutable_storage_and_keep_zero_handles_bare():
    let source = "extern type Window\nextern var counter: i32\nextern var current: Window\npub func answer() -> i32:\n    counter += 2i32\n    current = current\n    return counter\n"
    let program = analyzed([source_module("main", source)])
    assert(execution_failure_for(program, "answer") == "interpreter: extern variable `counter` has no host binding")
    let host = GlobalHost()
    let answer = HirInterpreter().run_with_globals(program, "main", "answer", host) catch reason:
        trap(reason)
    assert(integer(answer) == 42)
    assert(host.counter == 42 and host.current == 0)

pub func test_calls_use_symbols_and_parameter_positions():
    let sources = [
        source_module("math", "pub func subtract(left: i64, right: i64) -> i64: return left - right\n"),
        source_module("main", "import math\npub func answer() -> i64: return math.subtract(right = 2, left = 9)\n"),
    ]
    assert(integer(execute(sources)) == 7)

pub func test_recursive_calls_get_independent_frames():
    let source = "pub func factorial(value: i64) -> i64:\n    if value <= 1: return 1\n    return value * factorial(value - 1)\n\npub func answer() -> i64: return factorial(6)\n"
    assert(integer(execute([source_module("main", source)])) == 720)

pub func test_failure_is_data_across_try_catch_and_recovery():
    let source = "pub let invalid: ErrorCode = ErrorCode.package(7)\npub let missing: ErrorCode = ErrorCode.package(8)\nfunc checked(fail: bool) -> i64!:\n    if fail: error(invalid, \"invalid value\")\n    return 21\nfunc propagated(fail: bool) -> i64!:\n    return try checked(fail)\nfunc recover_checked(fail: bool) -> i64:\n    return checked(fail) catch failure:\n        if failure.code == invalid and failure.message == \"invalid value\": recover 7\n        recover 8\npub func answer() -> i64:\n    let success = recover_checked(false)\n    let local = recover_checked(true)\n    let propagated_value = propagated(true) catch failure:\n        if failure.code == missing: recover 100\n        recover 14\n    return success + local + propagated_value\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_unhandled_failure_becomes_a_host_boundary_diagnostic():
    let entries = "pub let invalid: ErrorCode = ErrorCode.package(7)\npub func succeeds() -> i64!: return 21\npub func fails() -> i64!: error(invalid, \"invalid value\")\n"
    let checked_program = analyzed([source_module("main", entries)])
    let success = HirInterpreter().run(checked_program, "main", "succeeds") catch reason:
        trap(reason)
    assert(integer(success) == 21)
    let failed = HirInterpreter().run(checked_program, "main", "fails") catch reason:
        assert(reason == "interpreter: unhandled failure from `main.fails`: test.luce:7: invalid value")
        return
    trap("expected an unhandled source failure")

pub func test_loops_apply_assignment_break_and_continue():
    let source = "pub func answer() -> i64:\n    var index = 0\n    var total = 0\n    while index < 6:\n        index += 1\n        if index == 2: continue\n        if index == 5: break\n        let doubled = index * 2\n        total = total + doubled\n    return total\n"
    assert(integer(execute([source_module("main", source)])) == 16)

pub func test_boolean_and_conditional_expressions_are_lazy():
    let source = "pub func answer() -> i64:\n    if false and 1 // 0 == 0: return 0\n    if false: return 0\n    else: return 42 if true or 1 // 0 == 0 else 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)

# mark: Integer widths and shifts ===========================================================

pub func test_numeric_literals_are_lowered_once_and_executed():
    let integer_source = "pub func answer() -> i64: return 0xff + 1_000i64\n"
    assert(integer(execute([source_module("main", integer_source)])) == 1255)

    let float_source = "pub func answer() -> f64: return -(1.5 + 2.5f64) / 2.0\n"
    match execute([source_module("main", float_source)]):
        Floating(value): assert(value == -2.0)
        else: assert(false)

    let division_source = "pub func answer() -> i64: return (-7 // 3) * 10 + (-7 % 3)\n"
    assert(integer(execute([source_module("main", division_source)])) == -28)

    let minimum_source = "pub func answer() -> i64: return -9223372036854775808\n"
    assert(integer(execute([source_module("main", minimum_source)])) == -9223372036854775807 - 1)

    let bits_source = "pub func answer() -> i64: return (5 & 3) | (1 << 3)\n"
    assert(integer(execute([source_module("main", bits_source)])) == 9)

pub func test_resolved_operation_tags_cover_unary_comparison_and_bitwise_semantics():
    let source = "pub func answer() -> i64:\n    if not false and ~0 == -1 and 16 >> 2 == 4 and 5 ^ 3 == 6 and 4 >= 4:\n        return +42\n    return 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)

    let float_source = "pub func answer() -> bool: return 1.5 < 2.0 and 2.0 != 3.0\n"
    assert(execute([source_module("main", float_source)]).render() == "true")

pub func test_i32_arithmetic_uses_its_resolved_width():
    let addition = "pub func answer() -> i32: return 2147483647i32 + 1i32\n"
    assert(execution_failure(addition, "answer") == "interpreter: integer arithmetic overflow")

    let negation = "pub func answer() -> i32: return -(-2147483648i32)\n"
    assert(execution_failure(negation, "answer") == "interpreter: integer arithmetic overflow")

    let division = "pub func answer() -> i32: return -2147483648i32 // -1i32\n"
    assert(execution_failure(division, "answer") == "interpreter: integer arithmetic overflow")

    let valid = "pub func answer() -> i32: return 2147483646i32 + 1i32\n"
    assert(integer(execute([source_module("main", valid)])) == 2147483647)

pub func test_i32_shifts_use_i32_range_and_result_bits():
    let invalid = "pub func answer() -> i32: return 1i32 << 32i32\n"
    assert(execution_failure(invalid, "answer") == "interpreter: shift count is outside integer width")

    let sign_bit = "pub func answer() -> i32: return 1i32 << 31i32\n"
    assert(integer(execute([source_module("main", sign_bit)])) == -2147483647 - 1)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return 1 << 63\n")])) == -9223372036854775807 - 1)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return 3 << 62\n")])) == -4611686018427387904)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return -1 << 1\n")])) == -2)

pub func test_every_integer_width_enforces_its_range():
    let u8_overflow = "pub func answer() -> u8:\n    let v: u8 = 250\n    return v + 10\n"
    assert(execution_failure(u8_overflow, "answer") == "interpreter: integer arithmetic overflow")
    let i8_overflow = "pub func answer() -> i8:\n    var v: i8 = 127\n    v += 1\n    return v\n"
    assert(execution_failure(i8_overflow, "answer") == "interpreter: integer arithmetic overflow")
    let u16_valid = "pub func answer() -> u16:\n    let v: u16 = 65535\n    return v - 1\n"
    assert(integer(execute([source_module("main", u16_valid)])) == 65534)
    assert(integer(execute([source_module("main", "pub func answer() -> u8:\n    let v: u8 = 0\n    return ~v\n")])) == 255)
    assert(integer(execute([source_module("main", "pub func answer() -> u32:\n    let v: u32 = 1\n    return ~v\n")])) == 4294967294)
    assert(integer(execute([source_module("main", "pub func answer() -> i8:\n    let v: i8 = 0\n    return ~v\n")])) == -1)

pub func test_narrow_shifts_keep_their_width_and_sign():
    let unsigned = "pub func answer() -> u8:\n    let v: u8 = 1\n    return v << 7\n"
    assert(integer(execute([source_module("main", unsigned)])) == 128)
    let signed = "pub func answer() -> i8:\n    let v: i8 = 1\n    return v << 7\n"
    assert(integer(execute([source_module("main", signed)])) == -128)
    let too_far = "pub func answer() -> u8:\n    let v: u8 = 1\n    return v << 8\n"
    assert(execution_failure(too_far, "answer") == "interpreter: shift count is outside integer width")

# mark: Value families and equality =========================================================

pub func test_unit_and_boolean_values_have_canonical_text():
    let unit_source = "func noop(): return\npub func answer(): noop()\n"
    assert(execute([source_module("main", unit_source)]).render() == "unit")
    assert(execute([source_module("main", "pub func answer() -> bool: return true\n")]).render() == "true")

pub func test_constants_tuples_and_optional_else_execute():
    let constants = "let base: i64 = 40\npub func answer() -> i64: return base + 2\n"
    assert(integer(execute([source_module("main", constants)])) == 42)
    let tuples = "pub func answer() -> i64:\n    let (left, right) = (3, 7)\n    return left + right\n"
    assert(integer(execute([source_module("main", tuples)])) == 10)
    let optional = "pub func answer() -> i64:\n    var value: i64? = none\n    value = 9\n    return value else 0\n"
    assert(integer(execute([source_module("main", optional)])) == 9)

pub func test_equality_covers_every_value_family():
    let source = (
        "pub func chars() -> bool: return 'a' < 'b' and 'a' == 'a'\n"
        + "pub func texts() -> bool: return \"a\" == \"a\" and \"a\" != \"b\"\n"
        + "pub func bytes() -> bool: return b\"ab\" == b\"ab\" and b\"ab\" != b\"abc\"\n"
        + "pub func tuples() -> bool: return (1, true) == (1, true) and (1, true) != (2, true)\n"
        + "pub func optionals() -> bool:\n    var v: i64? = none\n    let absent = v == none\n    v = 3\n    return absent and v == 3 and v != none\n"
        + "pub func floats() -> bool: return 1.5f32 * 2.0f32 == 3.0f32\n"
    )
    let sources = [source_module("main", source)]
    for name in ["chars", "texts", "bytes", "tuples", "optionals", "floats"]:
        assert(execute(sources, "main", name).render() == "true")

pub func test_composite_values_render_for_the_command_line():
    let tuple = "pub func answer() -> (i64, bool): return (1, true)\n"
    assert(execute([source_module("main", tuple)]).render() == "(1, true)")
    let text = "pub func answer() -> str: return \"hi\"\n"
    assert(execute([source_module("main", text)]).render() == "hi")
    let absent = "pub func answer() -> i64?: return none\n"
    assert(execute([source_module("main", absent)]).render() == "none")
    let present = "pub func answer() -> i64?: return 7\n"
    assert(execute([source_module("main", present)]).render() == "7")
    let byte_string = "pub func answer() -> bytes: return b\"ab\"\n"
    assert(execute([source_module("main", byte_string)]).render() == "2 bytes")

# mark: Entry selection =====================================================================

pub func test_entry_selection_rejects_invalid_targets():
    let source = "func hidden(): return\npub func needs(value: i64): return\n"
    assert(execution_failure(source, "hidden") == "interpreter: `main.hidden` is private")
    assert(execution_failure(source, "needs") == "interpreter: entry function `main.needs` must take no arguments")
    let entry = "pub func main(arguments: slice[str]) -> i32:\n    print(\"hi\")\n    return 3\n"
    assert(integer(execute([source_module("main", entry)], "main", "main")) == 3)
    assert(execution_failure(source, "missing") == "interpreter: module `main` has no function `missing`")

# The oracle computes in host `i64`s; every 64-bit overflow must be reported,
# never left for Stage-0 to trap on.
pub func test_i64_arithmetic_reports_overflow_at_the_host_boundary():
    let cases = [
        "pub func answer() -> i64: return 9223372036854775807 + 1\n",
        "pub func answer() -> i64: return -9223372036854775807 - 1 - 1\n",
        "pub func answer() -> i64: return 9223372036854775807 * 2\n",
        "pub func answer() -> i64: return -(-9223372036854775807 - 1)\n",
        "pub func answer() -> i64: return (-9223372036854775807 - 1) // -1\n",
    ]
    for source in cases:
        assert(execution_failure(source, "answer") == "interpreter: integer arithmetic overflow")
    assert(execution_failure("pub func answer() -> i64: return 7 // 0\n", "answer") == "interpreter: division by zero")
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return (-9223372036854775807 - 1) % -1\n")])) == 0)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return -4611686018427387904 * 2\n")])) == -9223372036854775807 - 1)
