pub func test_failure_is_data_across_try_catch_and_recovery():
    let source = "pub let invalid: ErrorCode = ErrorCode.package(7)\npub let missing: ErrorCode = ErrorCode.package(8)\nfunc checked(fail: bool) -> i64!:\n    if fail: error(invalid, \"invalid value\")\n    return 21\nfunc propagated(fail: bool) -> i64!:\n    return try checked(fail)\nfunc recover_checked(fail: bool) -> i64:\n    return checked(fail) catch failure:\n        if failure.code == invalid and failure.message == \"invalid value\": recover 7\n        recover 8\npub func answer() -> i64:\n    let success = recover_checked(false)\n    let local = recover_checked(true)\n    let propagated_value = propagated(true) catch failure:\n        if failure.code == missing: recover 100\n        recover 14\n    return success + local + propagated_value\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_unhandled_failure_becomes_a_host_boundary_diagnostic():
    let entries = "pub let invalid: ErrorCode = ErrorCode.package(7)\npub func succeeds() -> i64!: return 21\npub func fails() -> i64!: error(invalid, \"invalid value\")\n"
