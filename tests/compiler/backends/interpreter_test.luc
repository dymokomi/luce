# mark: Structured task lifetimes =============================================================

pub func test_tasks_copy_values_cache_results_and_cross_direct_luce_calls():
    let source = "func double(value: i64) -> i64: return value * 2\nfunc identity[T](value: T) -> T: return value\nfunc join(work: task[i64]) -> i64!: return try work.wait()\npub func answer() -> i64!:\n    let first = spawn double(21)\n    let direct = try join(first)\n    let repeated = try wait_all([first, first])\n    let generic = spawn identity(42)\n    let generic_value = try generic.wait()\n    let empty: list[task[i64]] = []\n    let empty_values = try wait_all(empty)\n    if repeated.length != 2u64 or repeated[0u64] != 42 or repeated[1u64] != 42: return 0\n    if empty_values.length != 0u64 or generic_value != 42: return 0\n    return direct\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_task_wait_preserves_worker_failure_and_maps_traps():
    let source = "let invalid: ErrorCode = ErrorCode.package(7)\nfunc fail() -> i64!: error(invalid, \"remote failure\")\nfunc stop() -> i64: trap(\"remote trap\")\nfunc recover_failure() -> i64:\n    let work = spawn fail()\n    return work.wait() catch failure:\n        if failure.code == invalid and failure.message == \"remote failure\": recover 20\n        recover 0\nfunc recover_trap() -> i64:\n    let work = spawn stop()\n    return work.wait() catch failure:\n        if failure.message == \"interpreter: trap: remote trap\": recover 22\n        recover 0\npub func answer() -> i64: return recover_failure() + recover_trap()\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_task_cancellation_is_idempotent_and_cached_for_repeated_waits():
    let source = "func pending() -> i64: return 1\nfunc recover_cancel(work: task[i64]) -> i64:\n    return work.wait() catch failure:\n        if failure.message == \"task cancelled\": recover 21\n        recover 0\npub func answer() -> i64:\n    let work = spawn pending()\n    work.cancel()\n    work.cancel()\n    return recover_cancel(work) + recover_cancel(work)\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_frozen_collection_snapshots_detach_and_transfer_by_value():
    let source = (
        "func inspect(values: frozen_list[i64], table: frozen_map[str, i64], tags: frozen_set[str]) -> frozen_list[i64]:\n"
        + "    if values.length != 2u64 or values[0u64] != 20 or values[1u64] != 22: return [0].snapshot()\n"
        + "    if (table[\"left\"] else 0) != 20 or (table[\"right\"] else 0) != 22: return [0].snapshot()\n"
        + "    if not tags.contains(\"ready\") or tags.contains(\"changed\"): return [0].snapshot()\n"
        + "    var order = \"\"\n"
        + "    for key in table: order = order + key\n"
        + "    if order != \"leftright\": return [0].snapshot()\n"
        + "    return [values[0u64] + values[1u64]].snapshot()\n"
        + "pub func answer() -> i64!:\n"
        + "    let source_values = [20, 22]\n"
        + "    let source_table = {\"left\": 20, \"right\": 22}\n"
        + "    let source_tags = set[str](\"ready\")\n"
        + "    let values = source_values.snapshot()\n"
        + "    let table = source_table.snapshot()\n"
        + "    let tags = source_tags.snapshot()\n"
        + "    let reordered_table = {\"right\": 22, \"left\": 20}.snapshot()\n"
        + "    let reordered_tags = set[str](\"changed\", \"ready\").snapshot()\n"
        + "    let equal_tags = set[str](\"ready\").snapshot()\n"
        + "    if table != reordered_table or hash(table) != hash(reordered_table): return 0\n"
        + "    if tags != equal_tags or hash(tags) != hash(equal_tags): return 0\n"
        + "    if tags == reordered_tags: return 0\n"
        + "    let work = spawn inspect(values, table, tags)\n"
        + "    source_values[0u64] = 0\n"
        + "    source_table[\"left\"] = 0\n"
        + "    discard(source_tags.remove(\"ready\"))\n"
        + "    discard(source_tags.insert(\"changed\"))\n"
        + "    let returned = try work.wait()\n"
        + "    return returned[0u64]\n"
    )
    assert(integer(execute([source_module("main", source)])) == 42)

# mark: Classes and lifetime =================================================================

pub func test_classes_share_identity_mutation_and_weak_slots():
    let source = "class Node:\n    pub var value: i64\n    pub weak var parent: Node?\n\n    func init(self, value: i64):\n        self.value = value\n        self.parent = none\n\n    func increment(self): self.value += 1\n\npub func answer() -> i64:\n    let child = new Node(1)\n    let alias = child\n    alias.increment()\n    if not (alias is child) or child.value != 2: return 0\n    if true:\n        let parent = new Node(40)\n        child.parent = parent\n        if let live = child.parent:\n            if not (live is parent): return 0\n        else: return 0\n    if let escaped = child.parent: return 0\n    return child.value + 40\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_class_deinit_precedes_reverse_field_destruction():
    let source = "class Child:\n    let events: list[i64]\n    let value: i64\n\n    func init(self, events: list[i64], value: i64):\n        self.events = events\n        self.value = value\n\n    func deinit(self): self.events.append(self.value)\n\nclass Parent:\n    let events: list[i64]\n    let first: Child\n    let second: Child\n\n    func init(self, events: list[i64]):\n        self.events = events\n        self.first = new Child(events, 1)\n        self.second = new Child(events, 2)\n\n    func deinit(self): self.events.append(0)\n\npub func answer() -> i64:\n    let events = list[i64]()\n    if true:\n        let parent = new Parent(events)\n    if events.length != 3u64: return 0\n    return events[0u64] * 100 + events[1u64] * 10 + events[2u64]\n"
    assert(integer(execute([source_module("main", source)])) == 21)

pub func test_failed_class_initialization_cleans_fields_without_running_deinit():
    let source = "let invalid: ErrorCode = ErrorCode.package(1)\nclass Child:\n    let events: list[i64]\n    func init(self, events: list[i64]): self.events = events\n    func deinit(self): self.events.append(1)\n\nclass Parent:\n    let events: list[i64]\n    let child: Child\n    func init(self, events: list[i64]) -> unit!:\n        self.events = events\n        self.child = new Child(events)\n        error(invalid, \"failed\")\n    func deinit(self): self.events.append(9)\n\nfunc attempt(events: list[i64]) -> i64!:\n    let parent = try new Parent(events)\n    return 0\n\npub func answer() -> i64:\n    let events = list[i64]()\n    let ignored = attempt(events) catch failure: recover 0\n    if events.length != 1u64: return 0\n    return 42 if events[0u64] == 1 else 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)

# mark: Numeric semantics ==================================================================

pub func test_f32_values_are_canonicalized_at_the_semantic_host_boundary():
    let program = analyzed([source_module("main", "export c func widen(value: f32) -> f64: return f64(value)\n")])
    let result = HirInterpreter().call_c_export(program, "widen", [Value.Floating(value = 0.1)]) catch reason:
        trap(reason)
    match result:
        Floating(item): assert(item == f64(f32(0.1)))
        else: assert(false)

pub func test_f16_values_round_after_literals_construction_and_arithmetic():
    let source = "func add(left: f16, right: f16) -> f16: return left + right\npub func answer() -> f64: return f64(add(0.1, 0.2))\n"
    match execute([source_module("main", source)]):
        Floating(item): assert(item == 0.2998046875)
        else: assert(false)
    let overflow = "func half(value: f64) -> f16: return f16(value)\npub func answer() -> f16: return half(65520.0)\n"
    assert(execution_failure(overflow, "answer") == "interpreter: trap: floating-point conversion out of range")

pub func test_numeric_literals_are_lowered_once_and_executed():
    let integer_source = "pub func answer() -> i64: return 0xff + 1_000i64\n"
    assert(integer(execute([source_module("main", integer_source)])) == 1255)

    let float_source = "pub func answer() -> f64: return -(1.5 + 2.5f64) / 2.0\n"
    match execute([source_module("main", float_source)]):
        Floating(value): assert(value == -2.0)
        else: assert(false)

    let division_source = "pub func answer() -> i64: return (-7 // 3) * 10 + (-7 % 3)\n"
    assert(integer(execute([source_module("main", division_source)])) == -28)

    let minimum_source = "pub func answer() -> i64: return -9223372036854775808\n"
    assert(integer(execute([source_module("main", minimum_source)])) == -9223372036854775807 - 1)

    let bits_source = "pub func answer() -> i64: return (5 & 3) | (1 << 3)\n"
    assert(integer(execute([source_module("main", bits_source)])) == 9)

pub func test_u64_uses_its_complete_semantic_domain():
    let source = "pub func maximum() -> u64: return 18446744073709551615u64\npub func operations() -> i64:\n    let maximum = 18446744073709551615u64\n    let above_signed = maximum > 9223372036854775807u64\n    let arithmetic = maximum - 1u64 == 18446744073709551614u64\n    let multiplied = maximum * 1u64 == maximum\n    let shifted = maximum << 1u64 == 18446744073709551614u64\n    let constructed = u64(9223372036854775807i64) + 1u64 == 9223372036854775808u64\n    return 42 if above_signed and arithmetic and multiplied and shifted and constructed else 0\npub func endpoint() -> u64:\n    var last = 0u64\n    for value in 18446744073709551614u64..=18446744073709551615u64: last = value\n    return last\npub func overflow() -> u64:\n    let maximum = 18446744073709551615u64\n    return maximum + 1u64\npub func conversion_overflow() -> i64: return i64(maximum())\n"
    let modules = [source_module("main", source)]
    assert(unsigned_integer(execute(modules, function_name = "maximum")) == u64(18446744073709551615))
    assert(integer(execute(modules, function_name = "operations")) == 42)
    assert(unsigned_integer(execute(modules, function_name = "endpoint")) == u64(18446744073709551615))
    assert(execution_failure(source, "overflow") == "interpreter: integer arithmetic overflow")
    assert(execution_failure(source, "conversion_overflow") == "interpreter: trap: integer conversion out of range")

pub func test_resolved_operation_tags_cover_unary_comparison_and_bitwise_semantics():
    let source = "pub func answer() -> i64:\n    if not false and ~0 == -1 and 16 >> 2 == 4 and 5 ^ 3 == 6 and 4 >= 4:\n        return +42\n    return 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)

    let float_source = "pub func answer() -> bool: return 1.5 < 2.0 and 2.0 != 3.0\n"
    assert(execute([source_module("main", float_source)]).render() == "true")

pub func test_i32_arithmetic_uses_its_resolved_width():
    let addition = "pub func answer() -> i32: return 2147483647i32 + 1i32\n"
    assert(execution_failure(addition, "answer") == "interpreter: integer arithmetic overflow")

    let negation = "pub func answer() -> i32: return -(-2147483648i32)\n"
    assert(execution_failure(negation, "answer") == "interpreter: integer arithmetic overflow")

    let division = "pub func answer() -> i32: return -2147483648i32 // -1i32\n"
    assert(execution_failure(division, "answer") == "interpreter: integer arithmetic overflow")

    let valid = "pub func answer() -> i32: return 2147483646i32 + 1i32\n"
    assert(integer(execute([source_module("main", valid)])) == 2147483647)

pub func test_i32_shifts_use_i32_range_and_result_bits():
    let invalid = "pub func answer() -> i32: return 1i32 << 32i32\n"
    assert(execution_failure(invalid, "answer") == "interpreter: shift count is outside integer width")

    let sign_bit = "pub func answer() -> i32: return 1i32 << 31i32\n"
    assert(integer(execute([source_module("main", sign_bit)])) == -2147483647 - 1)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return 1 << 63\n")])) == -9223372036854775807 - 1)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return 3 << 62\n")])) == -4611686018427387904)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return -1 << 1\n")])) == -2)

pub func test_every_integer_width_enforces_its_range():
    let u8_overflow = "pub func answer() -> u8:\n    let v: u8 = 250\n    return v + 10\n"
    assert(execution_failure(u8_overflow, "answer") == "interpreter: integer arithmetic overflow")
    let i8_overflow = "pub func answer() -> i8:\n    var v: i8 = 127\n    v += 1\n    return v\n"
    assert(execution_failure(i8_overflow, "answer") == "interpreter: integer arithmetic overflow")
    let u16_valid = "pub func answer() -> u16:\n    let v: u16 = 65535\n    return v - 1\n"
    assert(unsigned_integer(execute([source_module("main", u16_valid)])) == 65534)
    assert(unsigned_integer(execute([source_module("main", "pub func answer() -> u8:\n    let v: u8 = 0\n    return ~v\n")])) == 255)
    assert(unsigned_integer(execute([source_module("main", "pub func answer() -> u32:\n    let v: u32 = 1\n    return ~v\n")])) == 4294967294)
    assert(integer(execute([source_module("main", "pub func answer() -> i8:\n    let v: i8 = 0\n    return ~v\n")])) == -1)

pub func test_narrow_shifts_keep_their_width_and_sign():
    let unsigned = "pub func answer() -> u8:\n    let v: u8 = 1\n    return v << 7\n"
    assert(unsigned_integer(execute([source_module("main", unsigned)])) == 128)
    let signed = "pub func answer() -> i8:\n    let v: i8 = 1\n    return v << 7\n"
    assert(integer(execute([source_module("main", signed)])) == -128)
    let too_far = "pub func answer() -> u8:\n    let v: u8 = 1\n    return v << 8\n"
    assert(execution_failure(too_far, "answer") == "interpreter: shift count is outside integer width")

# mark: Value families and equality =========================================================

pub func test_interface_values_dispatch_and_preserve_value_or_class_mutation_semantics():
    let source = (
        "interface Counter:\n    mutating func increment(self) -> unit!\n    func value(self) -> i64\n"
        + "struct Count implements Counter:\n    var amount: i64\n    pub mutating func increment(self): self.amount += 1\n    pub func value(self) -> i64: return self.amount\n"
        + "class Shared implements Counter:\n    var amount: i64\n    pub func init(self, amount: i64): self.amount = amount\n    pub func increment(self): self.amount += 1\n    pub func value(self) -> i64: return self.amount\n"
        + "func bumped_pair(value: Counter) -> i64!:\n    let original = value\n    var changed = original\n    try changed.increment()\n    return original.value() * 10 + changed.value()\n"
        + "pub func answer() -> i64:\n    let copied = bumped_pair(Count(amount = 4)) catch failure: recover 0\n    let shared: Counter = new Shared(4)\n    let aliased = bumped_pair(shared) catch failure: recover 0\n    return copied * 100 + aliased\n"
    )
    assert(integer(execute([source_module("main", source)])) == 4555)

pub func test_unit_and_boolean_values_have_canonical_text():
    let unit_source = "func noop(): return\npub func answer(): noop()\n"
    assert(execute([source_module("main", unit_source)]).render() == "unit")
    assert(execute([source_module("main", "pub func answer() -> bool: return true\n")]).render() == "true")

pub func test_constants_tuples_and_optional_else_execute():
    let constants = "let base: i64 = 40\npub func answer() -> i64: return base + 2\n"
    assert(integer(execute([source_module("main", constants)])) == 42)
    let tuples = "pub func answer() -> i64:\n    let (left, right) = (3, 7)\n    return left + right\n"
    assert(integer(execute([source_module("main", tuples)])) == 10)
    let optional = "pub func answer() -> i64:\n    var value: i64? = none\n    value = 9\n    return value else 0\n"
    assert(integer(execute([source_module("main", optional)])) == 9)

pub func test_equality_covers_every_value_family():
    let source = (
        "pub func chars() -> bool: return 'a' < 'b' and 'a' == 'a'\n"
        + "pub func texts() -> bool: return \"a\" == \"a\" and \"a\" != \"b\"\n"
        + "pub func byte_values() -> bool: return b\"ab\" == b\"ab\" and b\"ab\" != b\"abc\"\n"
        + "pub func tuples() -> bool: return (1, true) == (1, true) and (1, true) != (2, true)\n"
        + "pub func optionals() -> bool:\n    var v: i64? = none\n    let absent = v == none\n    v = 3\n    return absent and v == 3 and v != none\n"
        + "pub func floats() -> bool: return 1.5f32 * 2.0f32 == 3.0f32\n"
    )
    let sources = [source_module("main", source)]
    for name in ["chars", "texts", "byte_values", "tuples", "optionals", "floats"]:
        assert(execute(sources, "main", name).render() == "true")

pub func test_list_equality_is_structural_and_cycle_aware():
    let source = (
        "struct Node:\n    let value: i64\n    let children: list[Node]\n"
        + "func self_cycle(value: i64) -> list[Node]:\n    let root: list[Node] = []\n    root.append(Node(value = value, children = root))\n    return root\n"
        + "func two_cycle(first: i64, second: i64) -> list[Node]:\n    let root: list[Node] = []\n    let child: list[Node] = []\n    root.append(Node(value = first, children = child))\n    child.append(Node(value = second, children = root))\n    return root\n"
        + "func sever(root: list[Node]):\n    let child = root[0u64].children\n    root.clear()\n    child.clear()\n"
        + "pub func answer() -> i64:\n    let identity = self_cycle(1)\n    let identity_equal = identity == identity\n    sever(identity)\n    if not identity_equal: return 0\n    let self_left = self_cycle(1)\n    let self_right = self_cycle(1)\n    let self_equal = self_left == self_right\n    sever(self_left)\n    sever(self_right)\n    if not self_equal: return 0\n    let mismatch_left = self_cycle(1)\n    let mismatch_right = self_cycle(2)\n    let mismatch_equal = mismatch_left == mismatch_right\n    sever(mismatch_left)\n    sever(mismatch_right)\n    if mismatch_equal: return 0\n    let deep_left = two_cycle(1, 2)\n    let deep_right = two_cycle(1, 2)\n    let deep_equal = deep_left == deep_right\n    sever(deep_left)\n    sever(deep_right)\n    if not deep_equal: return 0\n    let deep_mismatch_left = two_cycle(1, 2)\n    let deep_mismatch_right = two_cycle(1, 3)\n    let deep_mismatch_equal = deep_mismatch_left == deep_mismatch_right\n    sever(deep_mismatch_left)\n    sever(deep_mismatch_right)\n    if deep_mismatch_equal: return 0\n    if [1, 2, 3] != [1, 2, 3] or [1, 2] == [1, 2, 3]: return 0\n    return 42\n"
    )
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_maps_and_sets_are_ordered_reference_hash_collections():
    let source = (
        "pub func answer() -> i64:\n"
        + "    let counts = {\"b\": 2, \"a\": 1}\n"
        + "    counts[\"c\"] = 3\n"
        + "    counts[\"a\"] = 4\n"
        + "    var sum = 0\n"
        + "    var order = \"\"\n"
        + "    for key in counts:\n"
        + "        order = order + key\n"
        + "        sum += counts[key] else 0\n"
        + "    if order != \"bac\" or sum != 9: return 0\n"
        + "    let copied = counts.copy()\n"
        + "    if copied is counts or copied != counts: return 0\n"
        + "    let removed = counts.remove(\"b\") else 0\n"
        + "    if removed != 2 or counts.length != 2u64 or copied.length != 3u64: return 0\n"
        + "    let tags = set[str](\"x\", \"y\", \"x\")\n"
        + "    if tags.length != 2u64 or not tags.contains(\"x\"): return 0\n"
        + "    if not tags.insert(\"z\") or tags.insert(\"z\"): return 0\n"
        + "    if not tags.remove(\"x\") or tags.remove(\"missing\"): return 0\n"
        + "    let reordered = set[str](\"z\", \"y\")\n"
        + "    if tags != reordered or tags is reordered: return 0\n"
        + "    return 42\n"
    )
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_map_equality_is_unordered_and_cycle_aware():
    let source = (
        "struct Node:\n    let value: i64\n    let edges: map[str, Node]\n"
        + "func self_cycle(value: i64) -> map[str, Node]:\n    let root = map[str, Node]()\n    root[\"self\"] = Node(value = value, edges = root)\n    return root\n"
        + "func sever(root: map[str, Node]): root.clear()\n"
        + "pub func answer() -> i64:\n"
        + "    let identity = self_cycle(1)\n"
        + "    if identity != identity: return 0\n"
        + "    let left = self_cycle(1)\n"
        + "    let right = self_cycle(1)\n"
        + "    let equal = left == right\n"
        + "    sever(left)\n"
        + "    sever(right)\n"
        + "    if not equal: return 0\n"
        + "    let mismatch_left = self_cycle(1)\n"
        + "    let mismatch_right = self_cycle(2)\n"
        + "    let unequal = mismatch_left != mismatch_right\n"
        + "    sever(mismatch_left)\n"
        + "    sever(mismatch_right)\n"
        + "    sever(identity)\n"
        + "    return 42 if unequal else 0\n"
    )
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_composite_values_render_for_the_command_line():
    let tuple = "pub func answer() -> (i64, bool): return (1, true)\n"
    assert(execute([source_module("main", tuple)]).render() == "(1, true)")
    let text = "pub func answer() -> str: return \"hi\"\n"
    assert(execute([source_module("main", text)]).render() == "hi")
    let absent = "pub func answer() -> i64?: return none\n"
    assert(execute([source_module("main", absent)]).render() == "none")
    let present = "pub func answer() -> i64?: return 7\n"
    assert(execute([source_module("main", present)]).render() == "7")
    let byte_string = "pub func answer() -> bytes: return b\"ab\"\n"
    assert(execute([source_module("main", byte_string)]).render() == "2 bytes")

pub func test_source_trap_evaluates_and_reports_a_dynamic_string():
    let source = "func stop(prefix: str) -> i64: trap(prefix + \" invariant\")\npub func answer() -> i64: return stop(\"broken\")\n"
    assert(execution_failure(source, "answer") == "interpreter: trap: broken invariant")

pub func test_assert_evaluates_its_message_eagerly_and_traps_only_when_false():
    let success = "pub func answer() -> i64:\n    assert(true)\n    return 42\n"
    assert(integer(execute([source_module("main", success)])) == 42)
    assert(execution_failure("pub func answer() -> i64:\n    assert(false)\n    return 0\n", "answer") == "interpreter: trap: assertion failed")
    let failure = "func reason() -> str: return \"broken \" + \"invariant\"\npub func answer() -> i64:\n    assert(false, reason())\n    return 0\n"
    assert(execution_failure(failure, "answer") == "interpreter: trap: broken invariant")
    let eager = "func reason() -> str: trap(\"message evaluated\")\npub func answer() -> i64:\n    assert(true, reason())\n    return 0\n"
    assert(execution_failure(eager, "answer") == "interpreter: trap: message evaluated")

# mark: Entry selection =====================================================================

pub func test_entry_selection_rejects_invalid_targets():
    let source = "func hidden(): return\npub func needs(value: i64): return\n"
    assert(execution_failure(source, "hidden") == "interpreter: `main.hidden` is private")
    assert(execution_failure(source, "needs") == "interpreter: entry function `main.needs` must take no arguments")
    let entry = "pub func main(arguments: slice[str]) -> i32:\n    print(\"hi\")\n    return 3\n"
    assert(integer(execute([source_module("main", entry)], "main", "main")) == 3)
    assert(execution_failure(source, "missing") == "interpreter: module `main` has no function `missing`")

# The oracle computes in host `i64`s; every 64-bit overflow must be reported,
# never left for Stage-0 to trap on.
pub func test_i64_arithmetic_reports_overflow_at_the_host_boundary():
    let cases = [
        "pub func answer() -> i64: return 9223372036854775807 + 1\n",
        "pub func answer() -> i64: return -9223372036854775807 - 1 - 1\n",
        "pub func answer() -> i64: return 9223372036854775807 * 2\n",
        "pub func answer() -> i64: return -(-9223372036854775807 - 1)\n",
        "pub func answer() -> i64: return (-9223372036854775807 - 1) // -1\n",
    ]
    for source in cases:
        assert(execution_failure(source, "answer") == "interpreter: integer arithmetic overflow")
    assert(execution_failure("pub func answer() -> i64: return 7 // 0\n", "answer") == "interpreter: division by zero")
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return (-9223372036854775807 - 1) % -1\n")])) == 0)
    assert(integer(execute([source_module("main", "pub func answer() -> i64: return -4611686018427387904 * 2\n")])) == -9223372036854775807 - 1)

# mark: Formatted strings =====================================================================

pub func test_formatted_strings_evaluate_fields_left_to_right_and_normalize_triples():
    let source = "class Counter:\n    var order: i64\n    func init(self): self.order = 0\n    func field(self, value: str, expected: i64) -> str:\n        assert(self.order == expected, \"field order\")\n        self.order += 1\n        return value\nstruct Label implements Display:\n    let value: str\n    let counter: Counter\n    pub func display(self) -> str: return self.counter.field(self.value, 2)\npub func answer() -> str:\n    let counter = new Counter()\n    let label = Label(\"three\", counter)\n    return f\"{counter.field(\"one\", 0)} {counter.field(\"two\", 1)} {label} {42} {true} {'λ'} {1.5} {{done}}\"\n"
    assert(text_value(execute([source_module("main", source)])) == "one two three 42 true λ 1.5 {done}")

    let triple = "pub func answer() -> str:\n    let name = \"Luce\"\n    return f\"\"\"\n        hello {name}\n          nested {{brace}}\n        \"\"\"\n"
    assert(text_value(execute([source_module("main", triple)])) == "hello Luce\n  nested {brace}")
