#==============================================================================================
#
#   interpreter_test - The semantic oracle behaves
#
#   DESCRIPTION:
#       Source fixtures in, values (or stable diagnostics) out, through the
#       full front end and the interpreter. What passes here is the behavior
#       every compiled backend must reproduce.
#
#==============================================================================================

from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.backends.interpreter import HirCFunctionPointerHost, HirExternHost, HirExternResult, HirExternVariableHost, HirInterpreter
from luce.compiler.frontend.parser import Parser
from luce.compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.ir import BoxedValue, HirCFunctionIdentity, HirExternVariable, HirFunction, HirProgram, ModuleAuthority, Value

# mark: Test helpers ========================================================================

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> HirProgram:
    let program = HirGenerator("test.luce", sources).generate() catch reason:
        trap(reason)
    return program

# Cross the semantic-analysis boundary required by every HIR execution backend.
pub func analyzed(sources: list[SourceModule]) -> AnalyzedProgram:
    let program = SemanticAnalyzer(checked(sources)).analyze() catch reason:
        trap(reason)
    return program

pub func execute(sources: list[SourceModule], module_name: str = "main", function_name: str = "answer") -> Value:
    let value = HirInterpreter().run(analyzed(sources), module_name, function_name) catch reason:
        trap(reason)
    return value

pub func execution_failure(source: str, function_name: str) -> str:
    let program = analyzed([source_module("main", source)])
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

pub func execution_failure_for(program: AnalyzedProgram, function_name: str) -> str:
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

pub func integer(value: Value) -> i64:
    match value:
        SignedInteger(item): return item
        else: trap("expected an integer")

pub func unsigned_integer(value: Value) -> u64:
    match value:
        UnsignedInteger(item): return item
        else: trap("expected an unsigned integer")

pub func text_value(value: Value) -> str:
    match value:
        Text(item): return item
        else: trap("expected text")

pub func foreign_token(value: Value) -> i64:
    match value:
        Foreign(token): return token
        else: trap("expected a foreign handle")

pub func host_execution_failure(program: AnalyzedProgram, function_name: str, host: HirExternHost) -> str:
    let value = HirInterpreter().run_with_host(program, "main", function_name, host) catch reason:
        return reason
    return ""

pub func export_call_failure(program: AnalyzedProgram, function_name: str, arguments: list[Value]) -> str:
    let value = HirInterpreter().call_c_export(program, function_name, arguments) catch reason:
        return reason
    return ""

func extern_result(value: Value) -> HirExternResult:
    return HirExternResult(result = value, outputs = list[Value]())

class AbsoluteHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "abs": error("unexpected extern")
        let value = integer(arguments[0])
        if value < 0: return extern_result(Value.SignedInteger(value = -value))
        return extern_result(Value.SignedInteger(value = value))

class CallbackHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "register" or len(arguments) != 1: error("unexpected extern")
        match arguments[0]:
            CFunction(identity):
                match identity:
                    Declared(symbol): return extern_result(Value.SignedInteger(value = 0))
                    ForeignPointer(token): error("callback crossed as an arbitrary pointer")
            else: error("callback did not cross as a cfunc value")

class WrongExternHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return extern_result(Value.Boolean(value = true))

class CStringHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "inspect":
            if len(arguments) != 1: error("unexpected C string argument count")
            match arguments[0]:
                Bytes(raw):
                    if len(raw) != 4 or raw[0] != u8(104) or raw[1] != u8(195) or raw[2] != u8(169) or raw[3] != u8(0):
                        error("string input was not exact NUL-terminated UTF-8")
                else: error("string input did not cross as raw C bytes")
            return HirExternResult(
                result = Value.Bytes(value = [u8(111), u8(107), u8(0), u8(255)]),
                outputs = [Value.Bytes(value = [u8(99), u8(111), u8(112), u8(105), u8(101), u8(100), u8(0)])],
            )
        if function.name == "null_text": return extern_result(Value.Foreign(token = 0))
        if function.name == "invalid_text": return extern_result(Value.Bytes(value = [u8(255), u8(0)]))
        if function.name == "unterminated_text": return extern_result(Value.Bytes(value = [u8(120)]))
        error("unexpected C string extern")

class BorrowedListHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "sum" or len(arguments) != 2: error("unexpected borrowed-list extern")
        let count = unsigned_integer(arguments[1])
        match arguments[0]:
            Array(elements):
                if count > u64(len(elements)): error("borrowed-list fixture reads beyond storage")
                var total = 0
                for index in range(0, i64(count)): total += integer(elements[index].value)
                return extern_result(Value.SignedInteger(value = total))
            else: error("borrowed list did not cross as a read-only C sequence")

class BorrowedHandleListHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create": return extern_result(Value.Foreign(token = 42))
        if function.name != "consume": error("unexpected borrowed-handle extern")
        match arguments[0]:
            Array(elements):
                if len(elements) != 1 or foreign_token(elements[0].value) != 42:
                    error("borrowed handle list changed its element representation")
                return extern_result(Value.Boolean(value = true))
            else: error("borrowed handles did not cross as a C sequence")

class ZeroWindowVariableHost: HirExternVariableHost:
    pub init(): return

    pub func load(variable: HirExternVariable) -> Value!:
        if variable.name == "current": return Value.Foreign(token = 0)
        error("unexpected external variable")

    pub func store(variable: HirExternVariable, value: Value) -> !:
        error("unexpected external-variable store")

class PidHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "getpid": error("unexpected extern")
        return extern_result(Value.Foreign(token = 42))

class OutOfRangePidHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return extern_result(Value.Foreign(token = 2147483648))

class NullWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create" or function.name == "broken": return extern_result(Value.Foreign(token = 0))
        error("unexpected extern")

class LiveWindowHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "create": return extern_result(Value.Foreign(token = 42))
        if function.name == "show": return extern_result(Value.Boolean(value = foreign_token(arguments[0]) == 42))
        error("unexpected extern")

class SplitHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "split" or len(arguments) != 1 or integer(arguments[0]) != 41: error("unexpected extern call")
        return HirExternResult(
            result = Value.SignedInteger(value = 1),
            outputs = [Value.SignedInteger(value = 42), Value.Foreign(token = 99)],
        )

class MissingOutHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        return HirExternResult(result = Value.SignedInteger(value = 1), outputs = [Value.SignedInteger(value = 42)])

class ExternStructHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "exchange" or len(arguments) != 1: error("unexpected extern")
        match arguments[0]:
            Record(fields):
                assert(integer(fields[0].value) == 20)
                assert(integer(fields[1].value) == 22)
            else: error("extern struct input was not a semantic record")
        let changed = Value.Record(fields = [
            BoxedValue(value = Value.SignedInteger(value = 40)),
            BoxedValue(value = Value.SignedInteger(value = 2)),
        ])
        return HirExternResult(result = Value.SignedInteger(value = 0), outputs = [changed])

class NullExternStructHandleHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name != "read": error("extern struct with a null handle crossed back into C")
        let holder = Value.Record(fields = [BoxedValue(value = Value.Foreign(token = 0))])
        return HirExternResult(result = Value.Unit, outputs = [holder])

class ForeignPointerHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "acquire": return extern_result(Value.Foreign(token = 700))
        if function.name == "absent": return extern_result(Value.Foreign(token = 0))
        if function.name == "broken": return extern_result(Value.Foreign(token = 0))
        if function.name == "fill": return HirExternResult(result = Value.Unit, outputs = [Value.Foreign(token = 701)])
        if function.name == "consume":
            if len(arguments) != 1 or foreign_token(arguments[0]) < 700: error("unexpected foreign pointer")
            return extern_result(Value.Boolean(value = true))
        if function.name == "read_holder":
            let holder = Value.Record(fields = [BoxedValue(value = Value.Foreign(token = 0))])
            return HirExternResult(result = Value.Unit, outputs = [holder])
        if function.name == "consume_holder": error("extern struct with a null foreign pointer crossed back into C")
        error("unexpected foreign-pointer extern")

func raw_cfunc(token: i64) -> Value:
    return Value.CFunction(identity = HirCFunctionIdentity.ForeignPointer(token = token))

class DynamicCFunctionSourceHost: HirExternHost:
    pub init(): return

    pub func call(function: HirFunction, arguments: list[Value]) -> HirExternResult!:
        if function.name == "acquire": return HirExternResult(result = raw_cfunc(700), outputs = list[Value]())
        if function.name == "maybe_acquire": return HirExternResult(result = raw_cfunc(0), outputs = list[Value]())
        if function.name == "read": return HirExternResult(result = Value.Unit, outputs = [raw_cfunc(701)])
        if function.name == "read_hooks":
            let hooks = Value.Record(fields = [BoxedValue(value = raw_cfunc(702))])
            return HirExternResult(result = Value.Unit, outputs = [hooks])
        if function.name == "missing": return HirExternResult(result = raw_cfunc(0), outputs = list[Value]())
        error("unexpected dynamic-cfunc extern")

class DynamicCFunctionPointerHost: HirCFunctionPointerHost:
    pub init(): return

    pub func call(pointer: i64, arguments: list[Value]) -> Value!:
        if pointer < 700 or pointer > 702 or len(arguments) != 1: error("unexpected C function pointer")
        return Value.SignedInteger(value = integer(arguments[0]) + pointer - 700)

class GlobalHost: HirExternVariableHost:
    pub var counter: i64
    pub var current: i64

    pub init():
        self.counter = 40
        self.current = 0

    pub func load(variable: HirExternVariable) -> Value!:
        if variable.name == "counter": return Value.SignedInteger(value = self.counter)
        if variable.name == "current": return Value.Foreign(token = self.current)
        error("unexpected external global")

    pub func store(variable: HirExternVariable, value: Value) -> !:
        if variable.name == "counter":
            self.counter = integer(value)
            return
        if variable.name == "current":
            self.current = foreign_token(value)
            return
        error("unexpected external global")


# mark: Calls and control flow ==============================================================

pub func test_escaping_closures_preserve_snapshots_and_shared_mutation():
    let source = "func offsetter(offset: i64) -> func(i64) -> i64:\n    return func [copy amount = offset] (value: i64) -> i64:\n        return value + amount\nfunc counter(start: i64) -> func() -> i64:\n    var current = start\n    return func () -> i64:\n        current += 1\n        return current\npub func answer() -> i64:\n    let add = offsetter(10)\n    let next = counter(2)\n    return add(5) * 100 + next() * 10 + next()\n"
    assert(integer(execute([source_module("main", source)])) == 1534)

pub func test_nested_closures_capture_the_enclosing_environment_representation():
    let source = "func nested(base: i64) -> func() -> func() -> i64:\n    return func () -> func() -> i64:\n        return func () -> i64:\n            return base\npub func answer() -> i64:\n    let middle = nested(42)\n    let inner = middle()\n    return inner()\n"
    assert(integer(execute([source_module("main", source)])) == 42)

pub func test_weak_closure_capture_does_not_keep_the_owner_alive():
    let source = "class Owner:\n    var value: i64\n    func init(self, value: i64): self.value = value\nfunc weak_reader() -> func() -> i64?:\n    let owner = new Owner(42)\n    return func [weak owner] () -> i64?:\n        if let live = owner: return live.value\n        return none\nfunc strong_reader() -> func() -> i64:\n    let owner = new Owner(7)\n    return func () -> i64: return owner.value\npub func answer() -> i64:\n    let weak_callback = weak_reader()\n    let strong = strong_reader()\n    let gone = weak_callback() else 0\n    return gone + strong()\n"
    assert(integer(execute([source_module("main", source)])) == 7)

pub func test_cfunc_values_call_defined_adapters_and_extern_bindings_semantically():
    let source = "extern func abs(value: i32) -> i32\nfunc negate(value: i32) -> i32: return -value\npub func local_answer() -> i32:\n    let callback: cfunc(i32) -> i32 = negate\n    return callback(-42i32)\npub func answer() -> i32:\n    let callback: cfunc(i32) -> i32 = abs\n    return callback(-42i32)\n"
    let program = analyzed([source_module("main", source)])
    let local = HirInterpreter().run(program, "main", "local_answer") catch reason:
        trap(reason)
    assert(integer(local) == 42)
    let external = HirInterpreter().run_with_host(program, "main", "answer", AbsoluteHost()) catch reason:
        trap(reason)
    assert(integer(external) == 42)

    let registration = analyzed([source_module("main", "extern func register(callback: cfunc() -> unit) -> i32\nfunc goodbye(): return\npub func answer() -> i32:\n    let callback: cfunc() -> unit = goodbye\n    return register(callback)\n")])
    let registered = HirInterpreter().run_with_host(registration, "main", "answer", CallbackHost()) catch reason:
        trap(reason)
    assert(integer(registered) == 0)

pub func test_bytes_length_index_and_string_byte_count_execute_with_checked_bounds():
    let source = "pub func size() -> u64: return b\"abc\".length\npub func byte_at() -> u8: return b\"abc\"[1u64]\npub func text_bytes() -> u64: return \"λ\".byte_count\npub func missing() -> u8: return b\"abc\"[3u64]\n"
    let modules = [source_module("main", source)]
    assert(unsigned_integer(execute(modules, function_name = "size")) == 3)
    assert(unsigned_integer(execute(modules, function_name = "byte_at")) == 98)
    assert(unsigned_integer(execute(modules, function_name = "text_bytes")) == 2)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")

pub func test_fixed_arrays_are_checked_structural_values_with_nested_mutation():
    let source = "type Row = array[i64, 2]\nstruct Grid:\n    var rows: array[Row, 2]\nstruct Cell:\n    var value: i64\n    mutating func bump(self, by: i64): self.value += by\npub func read() -> i64:\n    let row: Row = [4, 2]\n    return row[0u64] * 10 + row[1u64]\npub func copied() -> i64:\n    var original: Row = [1, 2]\n    var changed = original\n    changed[0u64] = 9\n    return original[0u64] * 10 + changed[0u64]\npub func nested() -> i64:\n    var grid = Grid(rows = [[1, 2], [3, 4]])\n    grid.rows[1u64][0u64] += 5\n    return grid.rows[1u64][0u64]\npub func method() -> i64:\n    var cells: array[Cell, 2] = [Cell(value = 1), Cell(value = 2)]\n    cells[1u64].bump(5)\n    return cells[1u64].value\npub func equal() -> bool:\n    let left: Row = [1, 2]\n    let right: Row = [1, 2]\n    return left == right\npub func empty() -> u64:\n    let values: array[i64, 0] = []\n    return values.length\npub func missing() -> i64:\n    let values: Row = [1, 2]\n    return values[2u64]\npub func missing_store() -> i64:\n    var values: Row = [1, 2]\n    values[2u64] = 3\n    return 0\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "read")) == 42)
    assert(integer(execute(modules, function_name = "copied")) == 19)
    assert(integer(execute(modules, function_name = "nested")) == 8)
    assert(integer(execute(modules, function_name = "method")) == 7)
    assert(execute(modules, function_name = "equal").render() == "true")
    assert(unsigned_integer(execute(modules, function_name = "empty")) == 0)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")
    assert(execution_failure(source, "missing_store") == "interpreter: index out of bounds")

pub func test_lists_share_identity_and_copy_into_independent_shallow_storage():
    let source = "struct Holder:\n    let values: list[i64]\nstruct Cell:\n    var value: i64\n    mutating func bump(self, by: i64): self.value += by\npub func answer() -> i64:\n    let values: list[i64] = [1]\n    let alias = values\n    alias.append(1)\n    let holder = Holder(values = values)\n    holder.values[0u64] += 40\n    return alias[0u64] + values[1u64] if holder.values.length == 2u64 else 0\npub func identity() -> bool:\n    let values: list[i64] = [1]\n    let alias = values\n    let copied = values.copy()\n    return alias is values and copied is not values\npub func method() -> i64:\n    let cells: list[Cell] = [Cell(value = 2)]\n    cells[0u64].bump(40)\n    return cells[0u64].value\npub func copied_value() -> i64:\n    let source: list[Cell] = [Cell(value = 20)]\n    let copied = source.copy()\n    copied[0u64].bump(2)\n    copied.append(Cell(value = 1))\n    return source[0u64].value + copied[0u64].value if source.length == 1u64 and copied.length == 2u64 else 0\npub func copied_reference() -> i64:\n    let source: list[list[i64]] = [[20]]\n    let copied = source.copy()\n    copied[0u64].append(22)\n    return source[0u64][0u64] + source[0u64][1u64]\npub func missing() -> i64:\n    let values: list[i64] = []\n    return values[0u64]\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "answer")) == 42)
    assert(execute(modules, function_name = "identity").render() == "true")
    assert(integer(execute(modules, function_name = "method")) == 42)
    assert(integer(execute(modules, function_name = "copied_value")) == 42)
    assert(integer(execute(modules, function_name = "copied_reference")) == 42)
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")

pub func test_list_concatenation_is_ordered_shallow_and_independent():
    let source = "struct Cell:\n    var value: i64\n    mutating func add(self, amount: i64): self.value += amount\nfunc select(order: list[i64], marker: i64, values: list[i64]) -> list[i64]:\n    order.append(marker)\n    return values\npub func scalars() -> i64:\n    let order: list[i64] = []\n    let left: list[i64] = [20]\n    let right: list[i64] = [22]\n    let joined = select(order, 1, left) + select(order, 2, right)\n    joined[0u64] = 1\n    joined.append(19)\n    let ordered = order[0u64] * 10 + order[1u64] == 12\n    let independent = joined is not left and joined is not right and left[0u64] == 20 and right[0u64] == 22\n    return joined[1u64] + 20 if ordered and independent and joined.length == 3u64 else 0\npub func values() -> i64:\n    let left: list[Cell] = [Cell(value = 20)]\n    let right: list[Cell] = [Cell(value = 1)]\n    let joined = left + right\n    joined[0u64].add(2)\n    return left[0u64].value + joined[0u64].value\npub func references() -> i64:\n    let inner: list[i64] = [20]\n    let left: list[list[i64]] = [inner]\n    let empty: list[list[i64]] = []\n    let joined = left + empty\n    joined[0u64].append(22)\n    return inner[0u64] + inner[1u64] if joined[0u64] is inner else 0\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "scalars")) == 42)
    assert(integer(execute(modules, function_name = "values")) == 42)
    assert(integer(execute(modules, function_name = "references")) == 42)

pub func test_list_shape_operations_preserve_values_order_and_checked_bounds():
    let source = "struct Cell:\n    var value: i64\nfunc receiver(log: list[i64], values: list[i64]) -> list[i64]:\n    log.append(1)\n    return values\nfunc position(log: list[i64]) -> u64:\n    log.append(2)\n    return 0u64\nfunc element(log: list[i64]) -> i64:\n    log.append(3)\n    return 9\nfunc overflowing_element() -> i64: return 9223372036854775807 + 1\npub func shapes() -> i64:\n    let values: list[i64] = [2, 4]\n    values.insert(0u64, 1)\n    values.insert(2u64, 3)\n    values.insert(values.length, 5)\n    let removed = values.remove_at(1u64)\n    values.reserve(32u64)\n    let preserved = values.length == 4u64 and values[0u64] == 1 and values[1u64] == 3 and values[3u64] == 5\n    values.clear()\n    values.append(40)\n    return removed + values[0u64] if preserved and values.length == 1u64 else 0\npub func aggregate() -> i64:\n    let values: list[Cell] = [Cell(value = 20), Cell(value = 22)]\n    let removed = values.remove_at(0u64)\n    return removed.value + values[0u64].value\npub func order() -> i64:\n    let log: list[i64] = []\n    let values: list[i64] = []\n    receiver(log, values).insert(position(log), element(log))\n    return log[0u64] * 100 + log[1u64] * 10 + log[2u64] if values[0u64] == 9 else 0\npub func bad_insert() -> i64:\n    let values: list[i64] = [1]\n    values.insert(2u64, 2)\n    return 0\npub func bad_insert_order() -> i64:\n    let values: list[i64] = [1]\n    values.insert(2u64, overflowing_element())\n    return 0\npub func bad_remove() -> i64:\n    let values: list[i64] = [1]\n    return values.remove_at(1u64)\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "shapes")) == 42)
    assert(integer(execute(modules, function_name = "aggregate")) == 42)
    assert(integer(execute(modules, function_name = "order")) == 123)
    assert(execution_failure(source, "bad_insert") == "interpreter: index out of bounds")
    assert(execution_failure(source, "bad_insert_order") == "interpreter: integer arithmetic overflow")
    assert(execution_failure(source, "bad_remove") == "interpreter: index out of bounds")

pub func test_list_iteration_is_ordered_and_invalidates_shape_mutation_through_aliases():
    let source = "func first(values: list[i64]) -> i64:\n    for value in values: return value\n    return 0\nfunc overflow() -> i64: return 9223372036854775807 + 1\npub func allowed() -> i64:\n    let values: list[i64] = [20, 1]\n    var total = 0\n    var index = 0u64\n    for value in values:\n        values.reserve(32u64)\n        if index == 0u64: values[1u64] = 22\n        total += value\n        index += 1u64\n    var visits = 0\n    for left in values:\n        for right in values: visits += 1\n    let inner: list[i64] = [20]\n    let outer: list[list[i64]] = [inner]\n    for item in outer: item.append(22)\n    let broken: list[i64] = [20]\n    for value in broken: break\n    broken.append(22)\n    let returned: list[i64] = [20]\n    let early = first(returned)\n    returned.append(22)\n    return 42 if total == 42 and visits == 4 and inner.length == 2u64 and broken.length == 2u64 and early + returned[1u64] == 42 else 0\npub func bad_append():\n    let values: list[i64] = [1]\n    let alias = values\n    for value in values: alias.append(2)\npub func bad_insert():\n    let values: list[i64] = [1]\n    let alias = values\n    for value in values: alias.insert(0u64, 2)\npub func bad_remove():\n    let values: list[i64] = [1]\n    let alias = values\n    for value in values: alias.remove_at(0u64)\npub func bad_clear():\n    let values: list[i64] = [1]\n    let alias = values\n    for value in values: alias.clear()\npub func operand_order():\n    let values: list[i64] = [1]\n    for value in values: values.append(overflow())\npub func bounds_first():\n    let values: list[i64] = [1]\n    for value in values: values.insert(2u64, 2)\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "allowed")) == 42)
    let invalid = "interpreter: list structurally modified during active iteration"
    assert(execution_failure(source, "bad_append") == invalid)
    assert(execution_failure(source, "bad_insert") == invalid)
    assert(execution_failure(source, "bad_remove") == invalid)
    assert(execution_failure(source, "bad_clear") == invalid)
    assert(execution_failure(source, "operand_order") == "interpreter: integer arithmetic overflow")
    assert(execution_failure(source, "bounds_first") == "interpreter: index out of bounds")

pub func test_list_slices_capture_immutable_snapshots_in_source_order():
    let source = "func receiver(log: list[i64], values: list[i64]) -> list[i64]:\n    log.append(1)\n    return values\nfunc start(log: list[i64]) -> u64:\n    log.append(2)\n    return 0u64\nfunc end(log: list[i64]) -> u64:\n    log.append(3)\n    return 2u64\npub func answer() -> i64:\n    let log: list[i64] = []\n    let values: list[i64] = [20, 22]\n    let view = receiver(log, values)[start(log)..<end(log)]\n    values[0u64] = 1\n    values.append(2)\n    let order = log[0u64] * 100 + log[1u64] * 10 + log[2u64]\n    return view[0u64] + view[1u64] if order == 123 and view.length == 2u64 and values.length == 3u64 else 0\npub func cleared() -> i64:\n    let values: list[i64] = [20, 22]\n    let view = values[0u64..]\n    values.clear()\n    values.append(1)\n    return view[0u64] + view[1u64]\npub func reversed() -> u64:\n    let values: list[i64] = [1, 2]\n    return values[2u64..<1u64].length\npub func past_end() -> u64:\n    let values: list[i64] = [1, 2]\n    return values[..<3u64].length\npub func missing() -> i64:\n    let values: list[i64] = [1, 2]\n    let view = values[..<1u64]\n    return view[1u64]\n"
    let modules = [source_module("main", source)]
    assert(integer(execute(modules, function_name = "answer")) == 42)
    assert(integer(execute(modules, function_name = "cleared")) == 42)
    assert(execution_failure(source, "reversed") == "interpreter: slice bounds out of range")
    assert(execution_failure(source, "past_end") == "interpreter: slice bounds out of range")
    assert(execution_failure(source, "missing") == "interpreter: index out of bounds")

pub func test_extern_calls_use_an_explicit_semantic_host():
    let source = "extern func abs(value: i32) -> i32\npub func answer() -> i32: return abs(-42i32)\n"
    let program = analyzed([source_module("main", source)])
    assert(execution_failure_for(program, "answer") == "interpreter: extern `main.abs` has no host binding")
    let answer = HirInterpreter().run_with_host(program, "main", "answer", AbsoluteHost()) catch reason:
        trap(reason)
    assert(integer(answer) == 42)
