#==============================================================================================
#
#   interpreter_test - The semantic oracle behaves
#
#   DESCRIPTION:
#       Source fixtures in, values (or stable diagnostics) out, through the
#       full front end and the interpreter. What passes here is the behavior
#       every compiled backend must reproduce.
#
#==============================================================================================

from luce.compiler.checker import Checker, SourceModule
from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.parser import Parser
from luce.compiler.semantic_analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.tokenizer import Tokenizer
from luce.compiler.hir import HirProgram, Value

# mark: Test helpers =========================================================================

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> HirProgram:
    let program = Checker(sources).check() catch reason:
        trap(reason)
    return program

# Cross the semantic-analysis boundary required by every HIR execution backend.
pub func analyzed(sources: list[SourceModule]) -> AnalyzedProgram:
    let program = SemanticAnalyzer(checked(sources)).analyze() catch reason:
        trap(reason)
    return program

pub func execute(sources: list[SourceModule], module_name: str = "main", function_name: str = "answer") -> Value:
    let value = HirInterpreter().run(analyzed(sources), module_name, function_name) catch reason:
        trap(reason)
    return value

pub func execution_failure(source: str, function_name: str) -> str:
    let program = analyzed([source_module("main", source)])
    let value = HirInterpreter().run(program, "main", function_name) catch reason:
        return reason
    return ""

pub func integer(value: Value) -> i64:
    match value:
        Integer(item): return item
        else: trap("expected an integer")


# mark: Calls and control flow ===============================================================

pub func test_calls_use_symbols_and_parameter_positions():
    let sources = [
        source_module("math", "pub func subtract(left: i64, right: i64) -> i64: return left - right\n"),
        source_module("main", "import math\npub func answer() -> i64: return math.subtract(right: 2, left: 9)\n"),
    ]
    assert(integer(execute(sources)) == 7)

pub func test_recursive_calls_get_independent_frames():
    let source = "pub func factorial(value: i64) -> i64:\n    if value <= 1: return 1\n    return value * factorial(value - 1)\n\npub func answer() -> i64: return factorial(6)\n"
    assert(integer(execute([source_module("main", source)])) == 720)

pub func test_loops_apply_assignment_break_and_continue():
    let source = "pub func answer() -> i64:\n    var index = 0\n    var total = 0\n    while index < 6:\n        index += 1\n        if index == 2: continue\n        if index == 5: break\n        let doubled = index * 2\n        total = total + doubled\n    return total\n"
    assert(integer(execute([source_module("main", source)])) == 16)

pub func test_boolean_and_conditional_expressions_are_lazy():
    let source = "pub func answer() -> i64:\n    if false and 1 // 0 == 0: return 0\n    if false: return 0\n    else: return 42 if true or 1 // 0 == 0 else 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)


# mark: Values and diagnostics ===============================================================

pub func test_numeric_literals_are_lowered_once_and_executed():
    let integer_source = "pub func answer() -> i64: return 0xff + 1_000i64\n"
    assert(integer(execute([source_module("main", integer_source)])) == 1255)

    let float_source = "pub func answer() -> f64: return -(1.5 + 2.5f64) / 2.0\n"
    match execute([source_module("main", float_source)]):
        Floating(value): assert(value == -2.0)
        else: assert(false)

    let division_source = "pub func answer() -> i64: return (-7 // 3) * 10 + (-7 % 3)\n"
    assert(integer(execute([source_module("main", division_source)])) == -28)

    let minimum_source = "pub func answer() -> i64: return -9223372036854775808\n"
    assert(integer(execute([source_module("main", minimum_source)])) == -9223372036854775807 - 1)

    let bits_source = "pub func answer() -> i64: return (5 & 3) | (1 << 3)\n"
    assert(integer(execute([source_module("main", bits_source)])) == 9)

pub func test_resolved_operation_tags_cover_unary_comparison_and_bitwise_semantics():
    let source = "pub func answer() -> i64:\n    if not false and ~0 == -1 and 16 >> 2 == 4 and 5 ^ 3 == 6 and 4 >= 4:\n        return +42\n    return 0\n"
    assert(integer(execute([source_module("main", source)])) == 42)

    let float_source = "pub func answer() -> bool: return 1.5 < 2.0 and 2.0 != 3.0\n"
    assert(execute([source_module("main", float_source)]).render() == "true")

pub func test_i32_arithmetic_uses_its_resolved_width():
    let addition = "pub func answer() -> i32: return 2147483647i32 + 1i32\n"
    assert(execution_failure(addition, "answer") == "interpreter: i32 arithmetic overflow")

    let negation = "pub func answer() -> i32: return -(-2147483648i32)\n"
    assert(execution_failure(negation, "answer") == "interpreter: i32 arithmetic overflow")

    let division = "pub func answer() -> i32: return -2147483648i32 // -1i32\n"
    assert(execution_failure(division, "answer") == "interpreter: i32 arithmetic overflow")

    let valid = "pub func answer() -> i32: return 2147483646i32 + 1i32\n"
    assert(integer(execute([source_module("main", valid)])) == 2147483647)

pub func test_i32_shifts_use_i32_range_and_result_bits():
    let invalid = "pub func answer() -> i32: return 1i32 << 32i32\n"
    assert(execution_failure(invalid, "answer") == "interpreter: shift count is outside integer width")

    let sign_bit = "pub func answer() -> i32: return 1i32 << 31i32\n"
    assert(integer(execute([source_module("main", sign_bit)])) == -2147483647 - 1)

pub func test_unit_and_boolean_values_have_canonical_text():
    let unit_source = "func noop(): return\npub func answer(): noop()\n"
    assert(execute([source_module("main", unit_source)]).render() == "unit")
    assert(execute([source_module("main", "pub func answer() -> bool: return true\n")]).render() == "true")

pub func test_entry_selection_rejects_invalid_targets():
    let source = "func hidden(): return\npub func needs(value: i64): return\n"
    assert(execution_failure(source, "hidden") == "interpreter: `main.hidden` is private")
    assert(execution_failure(source, "needs") == "interpreter: entry function `main.needs` must take no arguments")
    assert(execution_failure(source, "missing") == "interpreter: module `main` has no function `missing`")
