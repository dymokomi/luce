#==============================================================================================
#
#   x86_64_linux_test - The ELF bytes come out exactly right
#
#   DESCRIPTION:
#       A hand-built canonical program in, a complete static ELF executable
#       out, probed at the offsets that matter: magic, machine, entry point,
#       first code byte, and the inline print payload.
#
#==============================================================================================

from luce.compiler.backends.x86_64_linux import X86_64LinuxBackend
from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType

pub func test_x86_64_linux_backend_encodes_a_complete_static_executable():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.WriteText(value = "Hello, world!"),
        CanonicalInstruction.Constant(value = 0, value_type = CanonicalType.signed_i32),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "hello.main", is_public = true, result = CanonicalType.signed_i32, instructions = instructions)
    let artifact = X86_64LinuxBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)

    # 64-byte ELF header + 56-byte program header + 82 bytes of code.
    assert(len(artifact) == 202)
    # ELF magic, then a 64-bit little-endian class.
    assert(artifact[0] == 0x7F)
    assert(artifact[1] == u8('E'))
    assert(artifact[2] == u8('L'))
    assert(artifact[3] == u8('F'))
    assert(artifact[4] == 0x02)
    assert(artifact[5] == 0x01)
    # e_type ET_EXEC and e_machine EM_X86_64, both little-endian.
    assert(artifact[16] == 0x02)
    assert(artifact[17] == 0x00)
    assert(artifact[18] == 0x3E)
    assert(artifact[19] == 0x00)
    # e_entry points at the first code byte: 0x400000 + 0x78.
    assert(artifact[24] == 0x78)
    assert(artifact[25] == 0x00)
    assert(artifact[26] == 0x40)
    assert(artifact[27] == 0x00)
    # Code begins at file offset 0x78 with `mov rax, 1` for the write syscall.
    assert(artifact[0x78] == 0x48)
    assert(artifact[0x79] == 0xB8)
    assert(artifact[0x7A] == 0x01)
    # The constant print payload follows its setup instructions inline.
    assert(artifact[0xA4] == u8('H'))
    assert(artifact[0xB1] == u8('\n'))

pub func test_x86_64_linux_backend_requires_one_public_i32_main():
    let function = CanonicalFunction(name = "hello.answer", is_public = true, result = CanonicalType.signed_i32, instructions = list[CanonicalInstruction]())
    let artifact = X86_64LinuxBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        assert(reason == "executable needs one public `main`")
        return
    assert(false)
