#==============================================================================================
#
#   arm64_macos_test - The Mach-O bytes come out exactly right
#
#   DESCRIPTION:
#       A hand-built canonical program in, a complete unsigned Mach-O image
#       out, probed at the offsets that matter: magic, CPU type, entry code,
#       and the inline print payload.
#
#==============================================================================================

from luce.compiler.backends.arm64_macos import Arm64MacosBackend
from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType

pub func test_arm64_macos_backend_encodes_a_complete_unsigned_executable():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.WriteText(value = "Hello, world!"),
        CanonicalInstruction.I32Constant(value = 0),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "hello.main", is_public = true, result = CanonicalType.signed_i32, instructions = instructions)
    let artifact = Arm64MacosBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)

    assert(len(artifact) == 0x4000)
    # MH_MAGIC_64 and CPU_TYPE_ARM64, both little-endian.
    assert(artifact[0] == 0xCF)
    assert(artifact[1] == 0xFA)
    assert(artifact[2] == 0xED)
    assert(artifact[3] == 0xFE)
    assert(artifact[4] == 0x0C)
    assert(artifact[7] == 0x01)
    # LC_MAIN points at the first instruction on the 4 KiB code page.
    assert(artifact[0x1000] == 0x20)
    assert(artifact[0x1001] == 0x00)
    assert(artifact[0x1002] == 0x80)
    assert(artifact[0x1003] == 0xD2)
    # The constant print payload follows its six instructions inline.
    assert(artifact[0x1018] == u8('H'))
    assert(artifact[0x1025] == u8('\n'))

pub func test_arm64_macos_backend_requires_one_public_i32_main():
    let function = CanonicalFunction(name = "hello.answer", is_public = true, result = CanonicalType.signed_i32, instructions = list[CanonicalInstruction]())
    let artifact = Arm64MacosBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        assert(reason == "arm64-macos backend: executable needs one public `main`")
        return
    assert(false)
