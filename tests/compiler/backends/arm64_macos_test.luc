#==============================================================================================
#
#   arm64_macos_test - The Mach-O encoder writes the expected image
#
#   DESCRIPTION:
#       Hand-built canonical MIR in, a complete unsigned Mach-O image out,
#       probed at the offsets that matter: magic, CPU type, entry offset, the
#       data page, and the first instruction. On an Apple-silicon host the
#       images are also signed and executed, so exit status, output, and the
#       overflow trap are checked for real.
#
#==============================================================================================

from luce.compiler.backends.arm64_macos import Arm64MacosBackend
from luce.compiler.canonical_ir import BinaryOp, BuiltinMirType, CallingConvention, DataId, ExternId
from luce.compiler.canonical_ir import InstructionForm, MirConstant, MirData, MirExtern, MirFunction
from luce.compiler.canonical_ir import MirInstruction, MirProgram, MirRelocation, MirSignature, MirSlot
from luce.compiler.canonical_ir import RegisterId, TypeId, arm64_macos_layout, builtin_mir_type
from luce.compiler.canonical_ir import create_empty_mir_program
from luce.compiler.mir_verifier import MirVerifier
from luce.compiler.source import SourceSpan
import std.files
import std.os
import std.strings

# mark: Fixtures =============================================================================

pub func span() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func instruction(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = span())

pub func reg(value: i64) -> RegisterId:
    return RegisterId(value = u32(value))

pub func i32_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.signed_i32)

pub func i64_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.signed_i64)

pub func ptr_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.pointer)

pub func write_extern() -> MirExtern:
    return MirExtern(
        name = "luce_rt_write",
        convention = CallingConvention.runtime,
        signature = MirSignature(parameters = [ptr_type(), i64_type()], results = list[TypeId](), is_fallible = false),
    )

pub func main_function(name: str, is_public: bool, result: TypeId, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [result], is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        is_public = is_public,
        span = span(),
    )

# `print("Hello, world!")` then `return 0`, exactly as the lowerer spells it.
pub func hello_program() -> MirProgram:
    let program = create_empty_mir_program(arm64_macos_layout())
    program.externs.append(write_extern())
    program.data.append(MirData(name = "hello.text0", bytes = strings.to_bytes("Hello, world!\n"), align = 1, relocations = list[MirRelocation]()))
    let body: list[MirInstruction] = [
        instruction(InstructionForm.DataAddress(result = reg(0), data = DataId(value = 0))),
        instruction(InstructionForm.Const(result = reg(1), value = MirConstant.Int(value = 14))),
        instruction(InstructionForm.CallExtern(results = list[RegisterId](), external = ExternId(value = 0), arguments = [reg(0), reg(1)])),
        instruction(InstructionForm.Const(result = reg(2), value = MirConstant.Int(value = 0))),
        instruction(InstructionForm.Return(values = [reg(2)])),
    ]
    program.functions.append(main_function("hello.main", true, i32_type(), [ptr_type(), i64_type(), i32_type()], body))
    return program

# `return left OP right` with both operands of `operand_type`. `main` is
# always typed `i32`, so only the i32 variant passes the verifier; the i64
# variant is an encoder-only fixture whose result feeds `exit` unchanged.
pub func arithmetic_program(operation: BinaryOp, left: i64, right: i64, operand_type: TypeId) -> MirProgram:
    let program = create_empty_mir_program(arm64_macos_layout())
    let body: list[MirInstruction] = [
        instruction(InstructionForm.Const(result = reg(0), value = MirConstant.Int(value = left))),
        instruction(InstructionForm.Const(result = reg(1), value = MirConstant.Int(value = right))),
        instruction(InstructionForm.Binary(result = reg(2), operation = operation, left = reg(0), right = reg(1))),
        instruction(InstructionForm.Return(values = [reg(2)])),
    ]
    program.functions.append(main_function("main.main", true, i32_type(), [operand_type, operand_type, operand_type], body))
    return program

pub func verified(program: MirProgram) -> MirProgram:
    MirVerifier(program).verify() catch reason:
        trap(reason)
    return program

pub func emitted(program: MirProgram) -> list[u8]:
    let artifact = Arm64MacosBackend().emit(program) catch reason:
        trap(reason)
    return artifact

pub func emission_failure(program: MirProgram) -> str:
    let artifact = Arm64MacosBackend().emit(program) catch reason:
        return reason
    return ""

# mark: Image layout =========================================================================

pub func test_arm64_macos_backend_encodes_a_complete_unsigned_executable():
    let artifact = emitted(verified(hello_program()))

    assert(len(artifact) == 0x4000)
    # MH_MAGIC_64 and CPU_TYPE_ARM64, both little-endian.
    assert(artifact[0] == 0xCF)
    assert(artifact[1] == 0xFA)
    assert(artifact[2] == 0xED)
    assert(artifact[3] == 0xFE)
    assert(artifact[4] == 0x0C)
    assert(artifact[7] == 0x01)
    # The data item sits at the start of the code page; 14 bytes pad to 16.
    assert(artifact[0x1000] == u8('H'))
    assert(artifact[0x100D] == u8('\n'))
    # LC_MAIN (header 32 + 3 segments 216 + dyld-info 48 + dylinker 32 +
    # build-version 24 = offset 352) points its entryoff past the data.
    assert(artifact[352] == 0x28)
    assert(artifact[355] == 0x80)
    assert(artifact[360] == 0x10)
    assert(artifact[361] == 0x10)
    # The first instruction reserves three 16-byte slots: `sub sp, sp, #48`.
    assert(artifact[0x1010] == 0xFF)
    assert(artifact[0x1011] == 0xC3)
    assert(artifact[0x1012] == 0x00)
    assert(artifact[0x1013] == 0xD1)

pub func test_arm64_macos_backend_encodes_checked_arithmetic():
    let i64_add = emitted(arithmetic_program(BinaryOp.add, 40, 2, i64_type()))
    let i32_mul = emitted(verified(arithmetic_program(BinaryOp.mul, 6, 7, i32_type())))
    let i64_mul = emitted(arithmetic_program(BinaryOp.mul, 6, 7, i64_type()))
    assert(len(i64_add) == 0x4000 and len(i32_mul) == 0x4000 and len(i64_mul) == 0x4000)
    # No data, so code starts at the page: `sub sp, sp, #48` again.
    assert(i64_add[0x1000] == 0xFF)
    assert(i64_add[0x1003] == 0xD1)

# mark: Diagnostics ==========================================================================

pub func test_arm64_macos_backend_requires_one_public_i32_main():
    let none_program = create_empty_mir_program(arm64_macos_layout())
    none_program.functions.append(main_function("hello.answer", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(none_program) == "executable: needs one public `main`")

    let two = create_empty_mir_program(arm64_macos_layout())
    two.functions.append(main_function("a.main", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    two.functions.append(main_function("b.main", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(two) == "executable: more than one public `main`")

    let wide = create_empty_mir_program(arm64_macos_layout())
    wide.functions.append(main_function("main.main", true, i64_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(wide) == "executable: `main.main` must return `i32`")

    let private = create_empty_mir_program(arm64_macos_layout())
    private.functions.append(main_function("hello.main", false, i32_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(private) == "executable: needs one public `main`")

pub func test_arm64_macos_backend_names_unsupported_externs_and_forms():
    let program = hello_program()
    program.externs[0] = MirExtern(
        name = "luce_rt_alloc",
        convention = CallingConvention.runtime,
        signature = MirSignature(parameters = [i64_type(), i64_type()], results = [ptr_type()], is_fallible = false),
    )
    assert(emission_failure(program) == "arm64-macos backend does not support extern `luce_rt_alloc` yet")

    let looping = create_empty_mir_program(arm64_macos_layout())
    let body: list[MirInstruction] = [
        instruction(InstructionForm.Loop),
        instruction(InstructionForm.Const(result = reg(0), value = MirConstant.Int(value = 0))),
        instruction(InstructionForm.Return(values = [reg(0)])),
    ]
    looping.functions.append(main_function("main.main", true, i32_type(), [i32_type()], body))
    assert(emission_failure(looping) == "arm64-macos backend does not support `Loop` yet in `main.main`")

# mark: Execution on an Apple-silicon host =====================================================

# The host is detected through `uname`; anywhere else these checks are skipped.
pub func is_apple_silicon_host(scratch: str) -> bool:
    let probe = os.Process("uname -sm > '" + scratch + "/uname.txt'") catch reason:
        return false
    let status = probe.wait() catch reason:
        return false
    if status != 0: return false
    let text = files.read(scratch + "/uname.txt") catch reason:
        return false
    return strings.starts_with(text, "Darwin arm64")

# Sign, run through the shell, and return the exit status; stdout lands in
# `output_path`.
pub func run_image(scratch: str, name: str, artifact: list[u8]) -> i64:
    let path = scratch + "/" + name
    files.write_bytes(path, artifact) catch reason:
        trap(reason)
    let signer = os.Process("/bin/chmod +x '" + path + "' && /usr/bin/codesign --force --sign - -- '" + path + "'") catch reason:
        trap(reason)
    let signed = signer.wait() catch reason:
        trap(reason)
    assert(signed == 0)
    # The outer braces redirect the shell's own stderr, silencing its
    # "Trace/BPT trap" report when an image dies by signal on purpose.
    let runner = os.Process("{ '" + path + "' > '" + path + ".out' 2>/dev/null; echo $? > '" + path + ".status'; } 2>/dev/null") catch reason:
        trap(reason)
    let ran = runner.wait() catch reason:
        trap(reason)
    let status_text = files.read(path + ".status") catch reason:
        trap(reason)
    return parse_status(status_text)

pub func parse_status(text: str) -> i64:
    var value = 0
    for c in text:
        if c >= '0' and c <= '9': value = value * 10 + i64(u32(c) - u32('0'))
    return value

pub func output_of(scratch: str, name: str) -> str:
    let text = files.read(scratch + "/" + name + ".out") catch reason:
        trap(reason)
    return text

pub func test_arm64_macos_images_run_on_an_apple_silicon_host():
    let scratch = "/private/tmp/claude-501/-Users-sedov-dev-luce/0beb9289-2e49-4d85-a565-3d192b851d5e/scratchpad"
    let maker = os.Process("mkdir -p '" + scratch + "'") catch reason:
        return
    let made = maker.wait() catch reason:
        return
    if made != 0 or not is_apple_silicon_host(scratch): return

    assert(run_image(scratch, "arm64_hello", emitted(hello_program())) == 0)
    assert(output_of(scratch, "arm64_hello") == "Hello, world!\n")

    # `return 3 + 4`: the exit status carries the i32 result.
    assert(run_image(scratch, "arm64_add", emitted(arithmetic_program(BinaryOp.add, 3, 4, i32_type()))) == 7)
    assert(run_image(scratch, "arm64_sub", emitted(arithmetic_program(BinaryOp.sub, 10, 4, i32_type()))) == 6)
    assert(run_image(scratch, "arm64_mul", emitted(arithmetic_program(BinaryOp.mul, 6, 7, i32_type()))) == 42)

    # Overflow traps: `brk #0` raises SIGTRAP, which the shell reports as 133.
    assert(run_image(scratch, "arm64_add_overflow", emitted(arithmetic_program(BinaryOp.add, 2147483647, 1, i32_type()))) == 133)
    assert(run_image(scratch, "arm64_mul_overflow", emitted(arithmetic_program(BinaryOp.mul, 65536, 65536, i32_type()))) == 133)
    # i64 arithmetic cannot be returned as an exit status directly, so the
    # trap alone is observed: `main` is typed i32 while the operands are i64.
    assert(run_image(scratch, "arm64_i64_mul_overflow", emitted(arithmetic_program(BinaryOp.mul, 4294967296, 4294967296, i64_type()))) == 133)
    assert(run_image(scratch, "arm64_i64_add_overflow", emitted(arithmetic_program(BinaryOp.add, 9223372036854775807, 1, i64_type()))) == 133)
    assert(run_image(scratch, "arm64_i64_mul", emitted(arithmetic_program(BinaryOp.mul, 3, 5, i64_type()))) == 15)
    assert(run_image(scratch, "arm64_i64_sub", emitted(arithmetic_program(BinaryOp.sub, 2, 5, i64_type()))) == 253)
