    let source_text = "func make(start: i32) -> func() -> i32:\n    var value = start\n    return func () -> i32:\n        value += 1\n        return value\npub func main(arguments: slice[str]) -> i32!:\n    let identity: func(i32) -> i32 = (value) => value\n    let next = make(identity(40))\n    return next() + next()\n"
