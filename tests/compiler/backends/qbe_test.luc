    assert(qbe_run(lower_source(source)).status == 1)

pub func test_qbe_arithmetic_agrees_with_lowered_luce_when_available():
    if not has_qbe(): return
    let arithmetic = "func value() -> i64: return 6 * 7 + 7 // -2 + 7 % -2\npub func main(arguments: slice[str]) -> i32!: return 0 if value() == 37 else 1\n"
    let minimum_remainder = "func value() -> i64: return (-9223372036854775807 - 1) % -1\npub func main(arguments: slice[str]) -> i32!: return 0 if value() == 0 else 1\n"
    let bits = "func value() -> i64: return ((0b1100 & 0b1010) | 1) << 2 >> 1\npub func main(arguments: slice[str]) -> i32!: return 0 if value() == 18 else 1\n"
    let floats = "func value() -> bool: return 1.5 * 2.0 == 3.0 and -1.5 < 0.0\npub func main(arguments: slice[str]) -> i32!: return 0 if value() else 1\n"
    let float_conversions = "func narrow(value: f64) -> f32: return f32(value)\nfunc widen(value: f32) -> f64: return f64(value)\nfunc truncate(value: f64) -> i64: return i64(value)\npub func main(arguments: slice[str]) -> i32!:\n    let rounded = narrow(0.1)\n    let large = f32(16777217u32)\n    let sum: f32 = 16777216.0 + 1.0\n    return 0 if widen(rounded) == f64(f32(0.1)) and widen(large) == 16777216.0 and widen(sum) == 16777216.0 and truncate(-3.7) == -3 else 1\n"
    let narrow = "func byte() -> u8: return 200u8 + 55u8\nfunc sign() -> i8: return 1i8 << 7i8\nfunc word() -> u32: return 4294967295u32 - 4294967000u32\npub func main(arguments: slice[str]) -> i32!: return 0 if byte() == 255u8 and sign() == -128i8 and word() == 295u32 else 1\n"
    let overflow = "func value() -> i8: return 127i8 + 1i8\npub func main(arguments: slice[str]) -> i32!:\n    value()\n    return 0\n"
    let division_by_zero = "func value() -> i64: return 7 // 0\npub func main(arguments: slice[str]) -> i32!:\n    value()\n    return 0\n"
    let division_overflow = "func value() -> i64: return (-9223372036854775807 - 1) // -1\npub func main(arguments: slice[str]) -> i32!:\n    value()\n    return 0\n"
    let float_to_integer_overflow = "func convert(value: f64) -> i8: return i8(value)\npub func main(arguments: slice[str]) -> i32!:\n    convert(128.0)\n    return 0\n"
    let float_narrowing_overflow = "func convert(value: f64) -> f32: return f32(value)\npub func main(arguments: slice[str]) -> i32!:\n    convert(3.5e38)\n    return 0\n"
    assert(qbe_run(lower_source(arithmetic)).status == 0)
    assert(qbe_run(lower_source(minimum_remainder)).status == 0)
    assert(qbe_run(lower_source(bits)).status == 0)
    assert(qbe_run(lower_source(floats)).status == 0)
    let float_program = lower_source(float_conversions)
    let float_il = emit(float_program)
    assert(strings.contains(float_il, "truncd"))
    assert(strings.contains(float_il, "exts"))
    assert(qbe_run(float_program).status == 0)
    assert(qbe_run(lower_source(narrow)).status == 0)
    assert(qbe_run(lower_source(overflow)).status != 0)
    assert(qbe_run(lower_source(division_by_zero)).status != 0)
    assert(qbe_run(lower_source(division_overflow)).status != 0)
    assert(qbe_run(lower_source(float_to_integer_overflow)).status != 0)
    assert(qbe_run(lower_source(float_narrowing_overflow)).status != 0)

pub func test_qbe_executes_backend_laid_out_aggregates_when_available():
    if not has_qbe(): return
    let structure = "struct Point:\n    let x: i32\n    let y: i32\npub func main(arguments: slice[str]) -> i32!:\n    let point = Point(x = 3, y = 4)\n    return point.x * 10 + point.y\n"
    let optional = "func maybe(flag: bool) -> i32?:\n    if flag: return 7i32\n    return none\npub func main(arguments: slice[str]) -> i32!: return (maybe(true) else 0i32) * 10i32 + (maybe(false) else 3i32)\n"
    let range_loop = "pub func main(arguments: slice[str]) -> i32!:\n    var total: i32 = 0\n    for i in 1i32..=5i32: total += i\n    return total\n"
    assert(qbe_run(lower_source(structure)).status == 34)
    assert(qbe_run(lower_source(optional)).status == 73)
    assert(qbe_run(lower_source(range_loop)).status == 15)

pub func test_qbe_executes_target_neutral_maps_and_sets_when_available():
    if not has_qbe(): return
    let source_text = (
        "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let counts = {\"b\": 2i32, \"a\": 1i32}\n"
        + "    counts[\"c\"] = 3i32\n"
        + "    counts[\"a\"] = 4i32\n"
        + "    var sum: i32 = 0\n"
        + "    var order = \"\"\n"
        + "    for key in counts:\n"
        + "        order = order + key\n"
        + "        sum += counts[key] else 0i32\n"
        + "    if order != \"bac\" or sum != 9i32: return 1\n"
        + "    let copied = counts.copy()\n"
        + "    if copied is counts or copied != counts: return 2\n"
        + "    let removed = counts.remove(\"b\") else 0i32\n"
        + "    if removed != 2i32 or counts.length != 2u64 or copied.length != 3u64: return 3\n"
        + "    let tags = set[str](\"x\", \"y\", \"x\")\n"
        + "    if tags.length != 2u64 or not tags.contains(\"x\"): return 4\n"
        + "    if not tags.insert(\"z\") or tags.insert(\"z\"): return 5\n"
        + "    if not tags.remove(\"x\") or tags.remove(\"missing\"): return 6\n"
        + "    let reordered = set[str](\"z\", \"y\")\n"
        + "    if tags != reordered or tags is reordered: return 7\n"
        + "    var redirected = {\"old\": 1i32}\n"
        + "    let replace_root: func() -> i32 = func () -> i32:\n"
        + "        redirected = {\"fresh\": 2i32}\n"
        + "        return 40i32\n"
        + "    redirected[\"answer\"] = replace_root()\n"
        + "    if redirected.length != 2u64 or (redirected[\"fresh\"] else 0i32) != 2i32 or (redirected[\"answer\"] else 0i32) != 40i32: return 8\n"
        + "    return 42\n"
    )
    let program = lower_source_with_runtime(source_text)
    qbe_accepts("maps and sets", emit(program))
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_immutable_collection_snapshots_when_available():
    if not has_qbe(): return
    let source_text = (
        "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let source_values = [20i32, 22i32]\n"
        + "    let source_table = {\"left\": 20i32, \"right\": 22i32}\n"
        + "    let source_tags = set[str](\"ready\")\n"
        + "    let values = source_values.snapshot()\n"
        + "    let table = source_table.snapshot()\n"
        + "    let tags = source_tags.snapshot()\n"
        + "    source_values[0u64] = 1i32\n"
        + "    source_table[\"left\"] = 1i32\n"
        + "    discard(source_tags.insert(\"changed\"))\n"
        + "    if values.length != 2u64 or values[0u64] + values[1u64] != 42i32: return 1\n"
        + "    if (table[\"left\"] else 0i32) + (table[\"right\"] else 0i32) != 42i32: return 2\n"
        + "    if not tags.contains(\"ready\") or tags.contains(\"changed\"): return 3\n"
        + "    return 42\n"
    )
    let program = lower_source_with_runtime(source_text)
    qbe_accepts("immutable collection snapshots", emit(program))
    assert(qbe_run(program).status == 42)

