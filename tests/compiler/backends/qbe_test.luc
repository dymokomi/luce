#==============================================================================================
#
#   qbe_test - Canonical MIR translates to compact, valid QBE IL
#
#==============================================================================================

from luce.compiler.backends.qbe import QbeBackend
from luce.compiler.backends.qbe_toolchain import QbeToolchain
from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, DataId, FunctionId, GlobalId, InstructionForm
from luce.compiler.mir.canonical import MirConstant, MirData, MirFunction, MirGlobal, MirInstruction, MirProgram, MirRuntimeBinding, MirRuntimeService, MirSignature, MirSlot, MirType, OperandBuilder, RegisterId, TypeId
from luce.compiler.mir.canonical import builtin_mir_type, create_empty_mir_program, intern_mir_type, make_struct_type
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.generator import HirGenerator, SourceModule
from luce.compiler.hir.ir import ModuleAuthority
from luce.compiler.mir.lowerer import Lowerer
import std.files
import std.os
import std.paths
import std.strings

func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

func r(value: i64) -> RegisterId:
    return RegisterId(value = u32(value))

func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = false,
        is_exported = false,
        span = at(),
    )

# A tiny composed-runtime fixture. Its allocator owns a fixed data buffer;
# the compiler merely calls the bound function after backend layout.
func storage_program(count: i64, zero_sized: bool, uses_storage: bool) -> MirProgram:
    let allocator_ops = OperandBuilder()
    let entry_ops = OperandBuilder()
    var program = create_empty_mir_program()
    var element_type = i32_t()
    if zero_sized: element_type = intern_mir_type(program.types, make_struct_type(list[TypeId]()))
    program.data.append(MirData(name = "runtime.arena", bytes = [0, 0, 0, 0, 0, 0, 0, 0], align = 8))
    program.functions.append(private_function(allocator_ops, "runtime.allocate", [u64_t(), u64_t()], [ptr_t()], [u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.DataAddress(result = r(2), data = DataId(value = 0))),
        ins(InstructionForm.Return(values = allocator_ops.run([r(2)]))),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = MirRuntimeService.storage_allocator, function = FunctionId(value = 0)))
    if uses_storage:
        program.functions.append(function(entry_ops, "main.main", [], [i32_t()], [u64_t(), ptr_t(), u64_t(), ptr_t(), i32_t(), i32_t()], [
            ins(InstructionForm.Const(result = r(0), value = MirConstant.Int(value = count))),
            ins(InstructionForm.AllocateStorage(result = r(1), element_type = element_type, count = r(0))),
            ins(InstructionForm.Const(result = r(2), value = MirConstant.Int(value = 1))),
            ins(InstructionForm.ElementAddress(result = r(3), element_type = element_type, base = r(1), index = r(2))),
            ins(InstructionForm.Const(result = r(4), value = MirConstant.Int(value = 42))),
            ins(InstructionForm.Store(value_type = i32_t(), address = r(3), value = r(4))),
            ins(InstructionForm.Load(result = r(5), value_type = i32_t(), address = r(3))),
            ins(InstructionForm.Return(values = entry_ops.run([r(5)]))),
        ]))
    else:
        program.functions.append(function(entry_ops, "main.main", [], [i32_t()], [u64_t(), ptr_t(), i32_t()], [
            ins(InstructionForm.Const(result = r(0), value = MirConstant.Int(value = count))),
            ins(InstructionForm.AllocateStorage(result = r(1), element_type = element_type, count = r(0))),
            ins(InstructionForm.Const(result = r(2), value = MirConstant.Int(value = 0))),
            ins(InstructionForm.Return(values = entry_ops.run([r(2)]))),
        ]))
    program.entry = FunctionId(value = 1)
    return program

func emit(program: MirProgram) -> str:
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let text = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    return text

func has_qbe() -> bool:
    let probe = os.Process("command -v qbe >/dev/null 2>&1") catch reason:
        return false
    let status = probe.wait() catch reason:
        return false
    return status == 0

func qbe_accepts(name: str, text: str):
    if not has_qbe(): return
    let process = os.Process("qbe - >/dev/null") catch reason:
        trap(reason)
    process.feed(text) catch reason:
        trap(reason)
    process.finish_input() catch reason:
        trap(reason)
    let status = process.wait() catch reason:
        trap(reason)
    assert(status == 0)

struct RunResult:
    let status: i64
    let output: str

func quoted(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

func qbe_run(program: MirProgram) -> RunResult:
    let scratch = files.make_temporary_directory(".", ".luce-qbe-test-") catch reason:
        trap(reason)
    let executable = paths.join(scratch, "program")
    let output_path = paths.join(scratch, "stdout")
    QbeToolchain().materialize(program, executable) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let process = os.Process("{ " + quoted(executable) + " > " + quoted(output_path) + " 2>/dev/null; } 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return RunResult(status = status, output = output)

func lower_source(source: str) -> MirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let hir = HirGenerator("org.luce.qbe-test", [SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax)]).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let mir = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    MirVerifier(mir).verify() catch reason:
        trap(reason)
    return mir

pub func test_empty_qbe_module_is_empty():
    assert(emit(create_empty_mir_program()) == "")

pub func test_qbe_emits_a_complete_scalar_entry():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(function(ops, "main.main", [], [i32_t()], [i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Int(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    program.entry = FunctionId(value = 0)
    assert(emit(program) == "export function w $main() {\n@start\n\t%r0 =w copy 42\n\tret %r0\n}\n\n")

pub func test_qbe_flattens_region_results_without_a_second_ir():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    let yes = ops.run([r(1)])
    let no = ops.run([r(2)])
    let result = ops.run([r(3)])
    let returned = ops.run([r(3)])
    program.functions.append(function(ops, "main.choose", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t(), i64_t()], [
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Int(value = 10))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Int(value = 20))),
        ins(InstructionForm.If(condition = r(0), results = result)),
        ins(InstructionForm.Yield(values = yes)),
        ins(InstructionForm.Else),
        ins(InstructionForm.Yield(values = no)),
        ins(InstructionForm.End),
        ins(InstructionForm.Return(values = returned)),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "jnz %r0, @if_yes0, @if_no1"))
    assert(strings.contains(text, "%r3 =l copy %r1"))
    assert(strings.contains(text, "%r3 =l copy %r2"))
    assert(strings.contains(text, "@if_end2\n\tret %r3"))
    qbe_accepts("regions", text)

pub func test_qbe_legalizes_checked_integer_arithmetic_to_a_trap_edge():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "main.add", [i64_t(), i64_t()], [i64_t()], [i64_t(), i64_t(), i64_t()], [
        ins(InstructionForm.Binary(result = r(2), operation = BinaryOp.add, left = r(0), right = r(1))),
        ins(InstructionForm.Return(values = ops.run([r(2)]))),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "%r2 =l add %r0, %r1"))
    assert(strings.contains(text, "csltl"))
    assert(strings.contains(text, "hlt"))
    qbe_accepts("checked-add", text)

pub func test_qbe_legalizes_typed_storage_at_its_layout_boundary():
    let ordinary = storage_program(2, false, true)
    let text = emit(ordinary)
    assert(strings.contains(text, "mul %r0, 4"))
    assert(strings.contains(text, "udiv"))
    assert(strings.contains(text, "call $luce_f0(l "))
    assert(strings.contains(text, ", l 4)"))
    assert(strings.contains(text, "@allocation_empty"))
    qbe_accepts("typed-storage", text)

    let zero_sized = emit(storage_program(1, true, false))
    assert(strings.contains(zero_sized, "call $luce_f0(l 1, l 1)"))
    if not has_qbe(): return
    assert(qbe_run(ordinary).status == 42)
    assert(qbe_run(storage_program(0, false, false)).status == 0)
    assert(qbe_run(storage_program(9223372036854775807, false, false)).status != 0)

pub func test_qbe_executes_internal_global_storage_when_available():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.data.append(MirData(name = "seed", bytes = [7, 0, 0, 0], align = 4))
    program.globals.append(MirGlobal(name = "runtime.cursor", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    program.functions.append(function(ops, "main.main", [], [i32_t()], [ptr_t(), i32_t(), i32_t(), i32_t(), i32_t()], [
        ins(InstructionForm.GlobalAddress(result = r(0), global = GlobalId(value = 0))),
        ins(InstructionForm.Load(result = r(1), value_type = i32_t(), address = r(0))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.Int(value = 35))),
        ins(InstructionForm.Binary(result = r(3), operation = BinaryOp.add, left = r(1), right = r(2))),
        ins(InstructionForm.Store(value_type = i32_t(), address = r(0), value = r(3))),
        ins(InstructionForm.Load(result = r(4), value_type = i32_t(), address = r(0))),
        ins(InstructionForm.Return(values = ops.run([r(4)]))),
    ]))
    program.entry = FunctionId(value = 0)
    let text = emit(program)
    assert(strings.contains(text, "data $g0 = align 4 { b 7 0 0 0 }"))
    assert(strings.contains(text, "copy $g0"))
    if has_qbe(): assert(qbe_run(program).status == 42)

pub func test_qbe_labels_unreachable_structural_tail_before_its_terminator():
    let source_text = "pub func main(arguments: slice[str]) -> i32:\n    while true:\n        if true: break\n        else: continue\n    return 0\n"
    let text = emit(lower_source(source_text))
    assert(not strings.contains(text, "\thlt\n\tjmp"))
    qbe_accepts("unreachable-tail", text)

pub func test_qbe_preserves_a_then_fallthrough_when_else_returns():
    if not has_qbe(): return
    let source_text = "pub func main(arguments: slice[str]) -> i32:\n    var result: i32 = 0\n    if true: result = 42\n    else: return 1\n    return result\n"
    assert(qbe_run(lower_source(source_text)).status == 42)

# When QBE is on PATH, validate the emitted entry with the real parser,
# assembler, linker, and process exit status. A checkout without QBE still
# runs all deterministic emitter assertions above.
pub func test_qbe_toolchain_executes_the_emitted_entry_when_available():
    if not has_qbe(): return

    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(function(ops, "main.main", [], [i32_t()], [i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.Int(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    program.entry = FunctionId(value = 0)
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_real_lowered_control_flow_when_available():
    if not has_qbe(): return
    let source_text = "pub func main(arguments: slice[str]) -> i32:\n    var total: i32 = 0\n    var i: i32 = 1\n    while i <= 6:\n        total += i\n        i += 1\n    print(\"qbe\")\n    return total\n"
    let result = qbe_run(lower_source(source_text))
    assert(result.status == 21)
    assert(result.output == "qbe\n")

pub func test_qbe_arithmetic_agrees_with_lowered_luce_when_available():
    if not has_qbe(): return
    let arithmetic = "func value() -> i64: return 6 * 7 + 7 // -2 + 7 % -2\npub func main(arguments: slice[str]) -> i32: return 0 if value() == 37 else 1\n"
    let minimum_remainder = "func value() -> i64: return (-9223372036854775807 - 1) % -1\npub func main(arguments: slice[str]) -> i32: return 0 if value() == 0 else 1\n"
    let bits = "func value() -> i64: return ((0b1100 & 0b1010) | 1) << 2 >> 1\npub func main(arguments: slice[str]) -> i32: return 0 if value() == 18 else 1\n"
    let floats = "func value() -> bool: return 1.5 * 2.0 == 3.0 and -1.5 < 0.0\npub func main(arguments: slice[str]) -> i32: return 0 if value() else 1\n"
    let narrow = "func byte() -> u8: return 200u8 + 55u8\nfunc sign() -> i8: return 1i8 << 7i8\nfunc word() -> u32: return 4294967295u32 - 4294967000u32\npub func main(arguments: slice[str]) -> i32: return 0 if byte() == 255u8 and sign() == -128i8 and word() == 295u32 else 1\n"
    let overflow = "func value() -> i8: return 127i8 + 1i8\npub func main(arguments: slice[str]) -> i32:\n    value()\n    return 0\n"
    let division_by_zero = "func value() -> i64: return 7 // 0\npub func main(arguments: slice[str]) -> i32:\n    value()\n    return 0\n"
    let division_overflow = "func value() -> i64: return (-9223372036854775807 - 1) // -1\npub func main(arguments: slice[str]) -> i32:\n    value()\n    return 0\n"
    assert(qbe_run(lower_source(arithmetic)).status == 0)
    assert(qbe_run(lower_source(minimum_remainder)).status == 0)
    assert(qbe_run(lower_source(bits)).status == 0)
    assert(qbe_run(lower_source(floats)).status == 0)
    assert(qbe_run(lower_source(narrow)).status == 0)
    assert(qbe_run(lower_source(overflow)).status != 0)
    assert(qbe_run(lower_source(division_by_zero)).status != 0)
    assert(qbe_run(lower_source(division_overflow)).status != 0)

pub func test_qbe_executes_backend_laid_out_aggregates_when_available():
    if not has_qbe(): return
    let structure = "struct Point:\n    let x: i32\n    let y: i32\npub func main(arguments: slice[str]) -> i32:\n    let point = Point(x = 3, y = 4)\n    return point.x * 10 + point.y\n"
    let optional = "func maybe(flag: bool) -> i32?:\n    if flag: return 7i32\n    return none\npub func main(arguments: slice[str]) -> i32: return (maybe(true) else 0i32) * 10i32 + (maybe(false) else 3i32)\n"
    let range_loop = "pub func main(arguments: slice[str]) -> i32:\n    var total: i32 = 0\n    for i in 1i32..=5i32: total += i\n    return total\n"
    assert(qbe_run(lower_source(structure)).status == 34)
    assert(qbe_run(lower_source(optional)).status == 73)
    assert(qbe_run(lower_source(range_loop)).status == 15)

pub func test_qbe_executes_caller_owned_failure_data_when_available():
    if not has_qbe(): return
    let source_text = "let invalid: ErrorCode = ErrorCode.package(1)\nfunc checked(value: i32) -> i32!:\n    if value < 0: error(invalid, \"negative\")\n    return value + 1\npub func main(arguments: slice[str]) -> i32:\n    let good = checked(40) catch failure: return 2\n    let recovered = checked(-1) catch failure: recover 1i32\n    return good + recovered\n"
    assert(qbe_run(lower_source(source_text)).status == 42)

pub func test_qbe_links_c_imports_and_preserves_exported_symbols():
    if not has_qbe(): return
    let source_text = "extern func abs(value: i32) -> i32\nexport c func luce_twice(value: i32) -> i32: return value * 2\npub func main(arguments: slice[str]) -> i32: return luce_twice(abs(-21i32))\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "export function w $luce_twice(w %r0)"))
    assert(strings.contains(il, "call $abs(w"))
    assert(qbe_run(program).status == 42)

    let narrow = emit(lower_source("export c func luce_byte(value: u8) -> u8: return value\n"))
    assert(strings.contains(narrow, "export function ub $luce_byte(ub %r0)"))
    qbe_accepts("c ABI extension types", narrow)

    # `Pid` remains nominal in HIR but reaches QBE as its declared i32 C
    # representation. Real libc supplies the symbol, making this an ABI and
    # linker proof rather than only an IL spelling assertion.
    let handle_source = "extern type Pid = i32\nextern func getpid() -> Pid\npub func main(arguments: slice[str]) -> i32:\n    let pid = getpid()\n    return 0 if pid == pid else 1\n"
    let handle_program = lower_source(handle_source)
    assert(strings.contains(emit(handle_program), "call $getpid()"))
    assert(qbe_run(handle_program).status == 0)

    let exported_handle = emit(lower_source("extern type Handle = u64\nexport c func echo_handle(value: Handle) -> Handle: return value\n"))
    assert(strings.contains(exported_handle, "export function l $echo_handle(l %r0)"))
    qbe_accepts("integer extern handle ABI", exported_handle)

pub func test_qbe_executes_cfunc_adapters_and_extern_addresses_when_available():
    if not has_qbe(): return
    let local_source = "func negate(value: i32) -> i32: return -value\npub func main(arguments: slice[str]) -> i32:\n    let callback: cfunc(i32) -> i32 = negate\n    return callback(-42i32)\n"
    let local = lower_source(local_source)
    let local_il = emit(local)
    assert(strings.contains(local_il, "function w $.luce_cfunc_"))
    assert(strings.contains(local_il, "call %r"))
    assert(qbe_run(local).status == 42)

    let extern_source = "extern func abs(value: i32) -> i32\npub func main(arguments: slice[str]) -> i32:\n    let callback: cfunc(i32) -> i32 = abs\n    return callback(-42i32)\n"
    let external = lower_source(extern_source)
    let external_il = emit(external)
    assert(strings.contains(external_il, "copy extern $abs"))
    assert(strings.contains(external_il, "call %r"))
    assert(qbe_run(external).status == 42)

    # libc invokes the generated adapter after `main` returns, proving the
    # pointer passed out of Luce obeys the real host C calling convention.
    let callback_source = "extern func atexit(callback: cfunc() -> unit) -> i32\nfunc goodbye(): print(\"callback\")\npub func main(arguments: slice[str]) -> i32:\n    let callback: cfunc() -> unit = goodbye\n    return atexit(callback)\n"
    let callback = qbe_run(lower_source(callback_source))
    assert(callback.status == 0)
    assert(callback.output == "callback\n")

pub func test_qbe_links_and_mutates_real_c_globals_when_available():
    if not has_qbe(): return
    # `optind` is mutable process state owned by libc. Its dynamic-library
    # definition requires QBE's explicit GOT/PIC `extern $symbol` address,
    # proving the product toolchain can bind more than same-link objects.
    let source_text = "extern var optind: i32\npub func main(arguments: slice[str]) -> i32:\n    optind = 40i32\n    optind += 2i32\n    return optind\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "storew"))
    assert(strings.contains(il, "extern $optind"))
    assert(strings.contains(il, "loadw extern $optind"))
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_pointer_handle_boundaries_when_available():
    if not has_qbe(): return
    let live = "extern type Allocation\nextern func malloc(size: u64) -> Allocation?\nextern func free(value: Allocation)\npub func main(arguments: slice[str]) -> i32:\n    match malloc(16u64):\n        .some(memory):\n            free(memory)\n            return 0\n        .none: return 1\n"
    let live_program = lower_source(live)
    let live_il = emit(live_program)
    assert(strings.contains(live_il, "call $malloc(l"))
    assert(strings.contains(live_il, "call $free(l"))
    assert(qbe_run(live_program).status == 0)

    # This request exceeds PTRDIFF_MAX on the supported 64-bit oracle hosts,
    # so libc must report allocation failure with null.
    let nullable = "extern type Allocation\nextern func malloc(size: u64) -> Allocation?\nextern func free(value: Allocation)\npub func main(arguments: slice[str]) -> i32:\n    match malloc(9223372036854775807u64):\n        .some(memory):\n            free(memory)\n            return 1\n        .none: return 0\n"
    assert(qbe_run(lower_source(nullable)).status == 0)

    let bare = "extern type Allocation\nextern func malloc(size: u64) -> Allocation\npub func main(arguments: slice[str]) -> i32:\n    malloc(9223372036854775807u64)\n    return 0\n"
    assert(qbe_run(lower_source(bare)).status != 0)

    let exported = emit(lower_source("extern type Allocation\nexport c func echo_allocation(value: Allocation?) -> Allocation?: return value\n"))
    assert(strings.contains(exported, "export function l $echo_allocation(l %r0)"))
    qbe_accepts("pointer handle export adapter", exported)

pub func test_qbe_executes_real_c_output_parameters_when_available():
    if not has_qbe(): return
    # `posix_memalign` puts the allocated pointer through its first C
    # argument. Luce callers pass only the two inputs and receive the declared
    # status followed by the nullable output in an ordinary tuple.
    let source_text = "extern type Allocation\nextern func posix_memalign(out memory: Allocation?, alignment: u64, size: u64) -> i32\nextern func free(memory: Allocation)\npub func main(arguments: slice[str]) -> i32:\n    let (status, memory) = posix_memalign(16u64, 16u64)\n    if status != 0: return 1\n    match memory:\n        .some(value):\n            free(value)\n            return 0\n        .none: return 2\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $posix_memalign(l"))
    assert(strings.contains(il, "call $free(l"))
    assert(qbe_run(program).status == 0)

pub func test_qbe_toolchain_preserves_output_and_cleans_scratch_when_qbe_fails():
    let parent = files.make_temporary_directory(".", ".luce-qbe-failure-") catch reason:
        trap(reason)
    let output = paths.join(parent, "program")
    files.write(output, "previous artifact") catch reason:
        trap(reason)

    let program = lower_source("pub func main(arguments: slice[str]) -> i32: return 0\n")
    QbeToolchain("/luce-test/missing-qbe", "cc").materialize(program, output) catch reason:
        assert(strings.contains(reason, "qbe toolchain: qbe exited with status"))
        assert(strings.contains(reason, "/luce-test/missing-qbe"))
        let previous = files.read(output) catch read_reason:
            trap(read_reason)
        assert(previous == "previous artifact")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 1)
        assert(entries[0].name == "program")
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return

    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected a missing QBE executable to fail")

pub func test_qbe_toolchain_preserves_output_and_reports_linker_failure():
    if not has_qbe(): return
    let parent = files.make_temporary_directory(".", ".luce-qbe-failure-") catch reason:
        trap(reason)
    let output = paths.join(parent, "program")
    files.write(output, "previous artifact") catch reason:
        trap(reason)

    let program = lower_source("pub func main(arguments: slice[str]) -> i32: return 0\n")
    QbeToolchain("qbe", "/luce-test/missing-cc").materialize(program, output) catch reason:
        assert(strings.contains(reason, "qbe toolchain: host compiler exited with status"))
        assert(strings.contains(reason, "/luce-test/missing-cc"))
        let previous = files.read(output) catch read_reason:
            trap(read_reason)
        assert(previous == "previous artifact")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 1)
        assert(entries[0].name == "program")
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return

    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected a missing host compiler to fail")
