    let source = "pub func main(arguments: slice[str]) -> i32!:\n    if arguments.length != 3u64: return 1\n    if arguments[1u64] != \"alpha\": return 2\n    if arguments[2u64] != \"two words\": return 3\n    print(arguments[2u64])\n    return 0\n"
    let result = qbe_run_with_arguments(lower_source(source), ["alpha", "two words"])
