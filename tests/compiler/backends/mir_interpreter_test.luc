#==============================================================================================
#
#   mir_interpreter_test - Every MIR instruction, executed
#
#   DESCRIPTION:
#       Hand-built MIR programs run through the MIR interpreter. Each test
#       program is verified first, so this file also proves that the verifier
#       accepts the shapes the lowerer will produce. The arithmetic tests pin
#       the language's trap semantics (section 7) at every integer width.
#
#==============================================================================================

from luce.compiler.canonical_ir import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from luce.compiler.canonical_ir import ExternId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData
from luce.compiler.canonical_ir import MirExtern, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.canonical_ir import MirRelocation, MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.canonical_ir import RelocationTarget, SwitchCase, TypeId, UnaryOp, builtin_mir_type
from luce.compiler.canonical_ir import create_empty_mir_program, find_runtime_symbol, intern_mir_type
from luce.compiler.canonical_ir import make_struct_type, wasm32_layout
from luce.compiler.mir_verifier import MirVerifier
from luce.compiler.backends.mir_interpreter import MirInterpreter, MirValue, function_address_base
from luce.compiler.backends.mir_interpreter import bool_of, float_of, int_of, ptr_of
from luce.compiler.source import SourceSpan
import std.strings

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = index)

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i16_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i16)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func u8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u8)
pub func u16_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u16)
pub func u32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u32)
pub func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
pub func f32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float32)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

pub func sig(parameters: list[TypeId], results: list[TypeId]) -> MirSignature:
    return MirSignature(parameters = parameters, results = results, is_fallible = false)

pub func fallible_function(name: str, parameters: list[TypeId], value: TypeId, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = [value, ptr_t()], is_fallible = true),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        is_public = true,
        span = at(),
    )

# Helpers take parameter and result lists, not a `MirSignature`: Stage-0 frees
# the lists of a struct returned by one call and passed straight into another.
pub func function(name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        is_public = true,
        span = at(),
    )

pub func function_with_slots(name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], slots: list[MirSlot], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = slots,
        body = body,
        is_public = true,
        span = at(),
    )

pub func program_of(functions: list[MirFunction]) -> MirProgram:
    let program = create_empty_mir_program(wasm32_layout())
    for item in functions: program.functions.append(item)
    return program

pub func runtime_extern(name: str) -> MirExtern:
    let symbol = find_runtime_symbol(name) else trap("unknown runtime symbol in test")
    return MirExtern(name = name, convention = CallingConvention.runtime, signature = symbol.signature)

# Short instruction spellings.
pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Int(value = value)))

pub func const_float(result: i64, value: f64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Float(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func const_null(result: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Null))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func unary(result: i64, operation: UnaryOp, operand: i64) -> MirInstruction:
    return ins(InstructionForm.Unary(result = r(result), operation = operation, operand = r(operand)))

pub func convert(result: i64, operation: ConvertOp, operand: i64) -> MirInstruction:
    return ins(InstructionForm.Convert(result = r(result), operation = operation, operand = r(operand)))

pub func ret(values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = regs(values)))

pub func load(result: i64, value_type: TypeId, address: i64) -> MirInstruction:
    return ins(InstructionForm.Load(result = r(result), value_type = value_type, address = r(address)))

pub func store(value_type: TypeId, address: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Store(value_type = value_type, address = r(address), value = r(value)))

# mark: Running ==============================================================================

pub func verified(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func run(program: MirProgram, name: str, arguments: list[MirValue]) -> list[MirValue]:
    verified(program)
    let results = MirInterpreter(program).run(name, arguments) catch reason:
        trap(reason)
    return results

pub func run_failure(program: MirProgram, name: str, arguments: list[MirValue]) -> str:
    verified(program)
    let results = MirInterpreter(program).run(name, arguments) catch reason:
        return reason
    return ""

pub func no_arguments() -> list[MirValue]:
    return list[MirValue]()

pub func first_int(program: MirProgram, name: str) -> i64:
    return int_of(run(program, name, no_arguments())[0])

# A one-function program computing `left OP right` at one integer type.
pub func binary_program(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> MirProgram:
    var result_type = operand_type
    if operation == BinaryOp.eq or operation == BinaryOp.ne or operation == BinaryOp.lt or operation == BinaryOp.le or operation == BinaryOp.gt or operation == BinaryOp.ge:
        result_type = bool_t()
    let body: list[MirInstruction] = [const_int(0, left), const_int(1, right), binary(2, operation, 0, 1), ret([2])]
    return program_of([function("compute", list[TypeId](), [result_type], [operand_type, operand_type, result_type], body)])

pub func compute(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> i64:
    return first_int(binary_program(operand_type, operation, left, right), "compute")

pub func compute_bool(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> bool:
    return bool_of(run(binary_program(operand_type, operation, left, right), "compute", no_arguments())[0])

pub func compute_failure(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> str:
    return run_failure(binary_program(operand_type, operation, left, right), "compute", no_arguments())

const overflow: str = "mir interpreter: trap: integer overflow"

# mark: Constants and registers ==============================================================

pub func test_constants_of_every_scalar_return_unchanged():
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let values = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 255, 65535, 4294967295, 9223372036854775807]
    for index in range(0, len(widths)):
        let program = program_of([function("value", list[TypeId](), [widths[index]], [widths[index]], [const_int(0, values[index]), ret([0])])])
        assert(first_int(program, "value") == values[index])

    let floats = program_of([function("value", list[TypeId](), [f32_t()], [f32_t(), f64_t()], [const_float(0, 1.5), const_float(1, 2.5), ret([0])])])
    assert(float_of(run(floats, "value", no_arguments())[0]) == 1.5)
    let booleans = program_of([function("value", list[TypeId](), [bool_t()], [bool_t()], [const_bool(0, true), ret([0])])])
    assert(bool_of(run(booleans, "value", no_arguments())[0]))
    let null = program_of([function("value", list[TypeId](), [ptr_t()], [ptr_t()], [const_null(0), ret([0])])])
    assert(ptr_of(run(null, "value", no_arguments())[0]) == 0)

pub func test_copy_and_parameters_flow_through_registers():
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret([1])]
    let program = program_of([function("same", [i64_t()], [i64_t()], [i64_t(), i64_t()], body)])
    assert(int_of(run(program, "same", [MirValue.Int(value = 42)])[0]) == 42)

# mark: Checked integer arithmetic ===========================================================

pub func test_add_sub_mul_trap_at_every_width_boundary():
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let maxima = [127, 32767, 2147483647, 9223372036854775807, 255, 65535, 4294967295, 9223372036854775807]
    let minima = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 0, 0, 0, 0]
    for index in range(0, len(widths)):
        let width = widths[index]
        assert(compute(width, BinaryOp.add, maxima[index] - 1, 1) == maxima[index])
        assert(compute_failure(width, BinaryOp.add, maxima[index], 1) == overflow)
        assert(compute(width, BinaryOp.sub, minima[index] + 1, 1) == minima[index])
        assert(compute_failure(width, BinaryOp.sub, minima[index], 1) == overflow)
        assert(compute(width, BinaryOp.mul, maxima[index], 1) == maxima[index])
        assert(compute_failure(width, BinaryOp.mul, maxima[index], 2) == overflow)
    # Signed corners that a naive check gets wrong.
    assert(compute(i64_t(), BinaryOp.mul, -4611686018427387904, 2) == -9223372036854775807 - 1)
    assert(compute_failure(i64_t(), BinaryOp.mul, -4611686018427387904, -2) == overflow)
    assert(compute_failure(i64_t(), BinaryOp.mul, -9223372036854775807 - 1, -1) == overflow)
    assert(compute(i8_t(), BinaryOp.mul, -64, 2) == -128)
    assert(compute_failure(i8_t(), BinaryOp.mul, -64, -2) == overflow)
    assert(compute(i64_t(), BinaryOp.add, -9223372036854775807 - 1, 9223372036854775807) == -1)

pub func test_floor_division_and_remainder_follow_the_language():
    assert(compute(i64_t(), BinaryOp.floor_div, 7, 2) == 3)
    assert(compute(i64_t(), BinaryOp.floor_div, 7, -2) == -4)
    assert(compute(i64_t(), BinaryOp.floor_div, -7, 2) == -4)
    assert(compute(i64_t(), BinaryOp.rem, 7, -2) == -1)
    assert(compute(i64_t(), BinaryOp.rem, -7, 2) == 1)
    assert(compute(u8_t(), BinaryOp.rem, 255, 16) == 15)
    assert(compute_failure(i64_t(), BinaryOp.floor_div, 1, 0) == "mir interpreter: trap: division by zero")
    assert(compute_failure(i32_t(), BinaryOp.rem, 1, 0) == "mir interpreter: trap: division by zero")
    assert(compute_failure(i8_t(), BinaryOp.floor_div, -128, -1) == overflow)
    assert(compute_failure(i64_t(), BinaryOp.floor_div, -9223372036854775807 - 1, -1) == overflow)
    assert(compute(i8_t(), BinaryOp.floor_div, -127, -1) == 127)
    assert(compute(i8_t(), BinaryOp.rem, -128, -1) == 0)
    assert(compute(i64_t(), BinaryOp.rem, -9223372036854775807 - 1, -1) == 0)

pub func test_shifts_respect_width_and_sign():
    assert(compute(u8_t(), BinaryOp.shift_left, 1, 7) == 128)
    # Only the count is checked; bits shifted out are dropped (section 7).
    assert(compute(i8_t(), BinaryOp.shift_left, 1, 7) == -128)
    assert(compute(i8_t(), BinaryOp.shift_left, 1, 8 - 1) == -128)
    assert(compute(u8_t(), BinaryOp.shift_left, 255, 1) == 254)
    assert(compute(i16_t(), BinaryOp.shift_left, 3, 15) == -32768)
    assert(compute(i8_t(), BinaryOp.shift_left, -1, 7) == -128)
    assert(compute_failure(u8_t(), BinaryOp.shift_left, 1, 8) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute_failure(i64_t(), BinaryOp.shift_left, 1, 64) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute_failure(i64_t(), BinaryOp.shift_right, 1, -1) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute(i64_t(), BinaryOp.shift_left, 1, 62) == 4611686018427387904)
    assert(compute(i64_t(), BinaryOp.shift_left, 1, 63) == -9223372036854775807 - 1)
    assert(compute(i32_t(), BinaryOp.shift_left, 1, 31) == -2147483647 - 1)
    assert(compute(u32_t(), BinaryOp.shift_left, 1, 31) == 2147483648)
    assert(compute(i64_t(), BinaryOp.shift_left, -1, 63) == -9223372036854775807 - 1)
    assert(compute(i64_t(), BinaryOp.shift_right, -8, 1) == -4)
    assert(compute(u32_t(), BinaryOp.shift_right, 4294967295, 31) == 1)
    assert(compute(i32_t(), BinaryOp.shift_right, -2147483647 - 1, 31) == -1)

pub func test_bitwise_operations_stay_inside_their_width():
    assert(compute(i64_t(), BinaryOp.bit_and, 12, 10) == 8)
    assert(compute(i64_t(), BinaryOp.bit_or, 12, 10) == 14)
    assert(compute(i64_t(), BinaryOp.bit_xor, 12, 10) == 6)
    assert(compute(u8_t(), BinaryOp.bit_xor, 255, 15) == 240)
    let not_signed = program_of([function("value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], [const_int(0, 5), unary(1, UnaryOp.bit_not, 0), ret([1])])])
    assert(first_int(not_signed, "value") == -6)
    let not_unsigned = program_of([function("value", list[TypeId](), [u8_t()], [u8_t(), u8_t()], [const_int(0, 5), unary(1, UnaryOp.bit_not, 0), ret([1])])])
    assert(first_int(not_unsigned, "value") == 250)

pub func test_comparisons_cover_every_operand_family():
    assert(compute_bool(i64_t(), BinaryOp.lt, -1, 1))
    assert(not compute_bool(u8_t(), BinaryOp.gt, 1, 2))
    assert(compute_bool(i32_t(), BinaryOp.le, 3, 3))
    assert(compute_bool(i32_t(), BinaryOp.ge, 3, 3))
    assert(compute_bool(i16_t(), BinaryOp.eq, -7, -7))
    assert(compute_bool(i16_t(), BinaryOp.ne, -7, 7))

    let floats: list[MirInstruction] = [const_float(0, 1.5), const_float(1, 2.0), binary(2, BinaryOp.lt, 0, 1), binary(3, BinaryOp.eq, 0, 0), binary(4, BinaryOp.div, 1, 0), ret([4])]
    let float_program = program_of([function("value", list[TypeId](), [f64_t()], [f64_t(), f64_t(), bool_t(), bool_t(), f64_t()], floats)])
    assert(float_of(run(float_program, "value", no_arguments())[0]) == 2.0 / 1.5)

    let booleans: list[MirInstruction] = [const_bool(0, true), const_bool(1, false), binary(2, BinaryOp.ne, 0, 1), ret([2])]
    assert(bool_of(run(program_of([function("value", list[TypeId](), [bool_t()], [bool_t(), bool_t(), bool_t()], booleans)]), "value", no_arguments())[0]))

    let pointers: list[MirInstruction] = [const_null(0), ins(InstructionForm.Alloca(result = r(1), slot = 0)), binary(2, BinaryOp.eq, 0, 1), binary(3, BinaryOp.ne, 0, 0), ret([2])]
    let pointer_function = function_with_slots("value", list[TypeId](), [bool_t()], [ptr_t(), ptr_t(), bool_t(), bool_t()], [MirSlot(value_type = i64_t(), align = 8)], pointers)
    assert(not bool_of(run(program_of([pointer_function]), "value", no_arguments())[0]))

pub func test_negation_and_boolean_not():
    let negate: list[MirInstruction] = [const_int(0, -128), unary(1, UnaryOp.neg, 0), ret([1])]
    assert(run_failure(program_of([function("value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], negate)]), "value", no_arguments()) == overflow)
    let negate_ok: list[MirInstruction] = [const_int(0, -127), unary(1, UnaryOp.neg, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], negate_ok)]), "value") == 127)
    let negate_float: list[MirInstruction] = [const_float(0, 2.5), unary(1, UnaryOp.neg, 0), ret([1])]
    assert(float_of(run(program_of([function("value", list[TypeId](), [f64_t()], [f64_t(), f64_t()], negate_float)]), "value", no_arguments())[0]) == -2.5)
    let not_bool: list[MirInstruction] = [const_bool(0, true), unary(1, UnaryOp.bool_not, 0), ret([1])]
    assert(not bool_of(run(program_of([function("value", list[TypeId](), [bool_t()], [bool_t(), bool_t()], not_bool)]), "value", no_arguments())[0]))

pub func test_conversions_extend_wrap_and_cross_to_floats():
    let extend: list[MirInstruction] = [const_int(0, -5), convert(1, ConvertOp.extend, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [i64_t()], [i8_t(), i64_t()], extend)]), "value") == -5)
    let wrap_signed: list[MirInstruction] = [const_int(0, 200), convert(1, ConvertOp.wrap, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [i8_t()], [i64_t(), i8_t()], wrap_signed)]), "value") == -56)
    let wrap_unsigned: list[MirInstruction] = [const_int(0, -1), convert(1, ConvertOp.wrap, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [u8_t()], [i64_t(), u8_t()], wrap_unsigned)]), "value") == 255)
    let wrap_wide: list[MirInstruction] = [const_int(0, 4294967296 + 7), convert(1, ConvertOp.wrap, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [u32_t()], [i64_t(), u32_t()], wrap_wide)]), "value") == 7)
    let to_float: list[MirInstruction] = [const_int(0, -3), convert(1, ConvertOp.int_to_float, 0), ret([1])]
    assert(float_of(run(program_of([function("value", list[TypeId](), [f64_t()], [i32_t(), f64_t()], to_float)]), "value", no_arguments())[0]) == -3.0)
    let to_int: list[MirInstruction] = [const_float(0, -3.7), convert(1, ConvertOp.float_to_int, 0), ret([1])]
    assert(first_int(program_of([function("value", list[TypeId](), [i64_t()], [f64_t(), i64_t()], to_int)]), "value") == -3)
    let too_big: list[MirInstruction] = [const_float(0, 300.0), convert(1, ConvertOp.float_to_int, 0), ret([1])]
    assert(run_failure(program_of([function("value", list[TypeId](), [u8_t()], [f64_t(), u8_t()], too_big)]), "value", no_arguments()) == "mir interpreter: trap: float to integer conversion is outside the integer range")
    let huge: list[MirInstruction] = [const_float(0, 1e19), convert(1, ConvertOp.float_to_int, 0), ret([1])]
    assert(run_failure(program_of([function("value", list[TypeId](), [i64_t()], [f64_t(), i64_t()], huge)]), "value", no_arguments()) == "mir interpreter: trap: float to integer conversion is outside the integer range")

# mark: Memory ===============================================================================

pub func test_every_scalar_round_trips_through_a_slot():
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let values = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 255, 65535, 4294967295, 9223372036854775807]
    for index in range(0, len(widths)):
        let width = widths[index]
        let body: list[MirInstruction] = [
            ins(InstructionForm.Alloca(result = r(0), slot = 0)),
            const_int(1, values[index]),
            store(width, 0, 1),
            load(2, width, 0),
            ret([2]),
        ]
        let program = program_of([function_with_slots("value", list[TypeId](), [width], [ptr_t(), width, width], [MirSlot(value_type = width, align = 8)], body)])
        assert(first_int(program, "value") == values[index])

    let float_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), const_float(1, 6.25), store(f32_t(), 0, 1), load(2, f32_t(), 0), ret([2])]
    let float_program = program_of([function_with_slots("value", list[TypeId](), [f32_t()], [ptr_t(), f32_t(), f32_t()], [MirSlot(value_type = f32_t(), align = 4)], float_body)])
    assert(float_of(run(float_program, "value", no_arguments())[0]) == 6.25)

    let bool_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), const_bool(1, true), store(bool_t(), 0, 1), load(2, bool_t(), 0), ret([2])]
    let bool_program = program_of([function_with_slots("value", list[TypeId](), [bool_t()], [ptr_t(), bool_t(), bool_t()], [MirSlot(value_type = bool_t(), align = 1)], bool_body)])
    assert(bool_of(run(bool_program, "value", no_arguments())[0]))

    let ptr_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ins(InstructionForm.Alloca(result = r(1), slot = 1)), store(ptr_t(), 0, 1), load(2, ptr_t(), 0), binary(3, BinaryOp.eq, 1, 2), ret([3])]
    let ptr_program = program_of([function_with_slots("value", list[TypeId](), [bool_t()], [ptr_t(), ptr_t(), ptr_t(), bool_t()], [MirSlot(value_type = ptr_t(), align = 4), MirSlot(value_type = i64_t(), align = 8)], ptr_body)])
    assert(bool_of(run(ptr_program, "value", no_arguments())[0]))

pub func test_struct_fields_and_array_elements_are_addressed_by_layout():
    let program = create_empty_mir_program(wasm32_layout())
    let point = intern_mir_type(program.types, make_struct_type(program.types, program.layout, [i8_t(), i64_t(), i32_t()]))
    match program.types.definitions[point.value]:
        Struct(fields, size, align):
            assert(fields[0].offset == 0 and fields[1].offset == 8 and fields[2].offset == 16)
            assert(size == 24 and align == 8)
        else: assert(false)
    let array = intern_mir_type(program.types, MirType.Array(element = i16_t(), count = 4))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        const_int(1, -9),
        ins(InstructionForm.FieldAddress(result = r(2), struct_type = point, base = r(0), field = 2)),
        store(i32_t(), 2, 1),
        ins(InstructionForm.FieldAddress(result = r(3), struct_type = point, base = r(0), field = 1)),
        const_int(4, 1000000000000),
        store(i64_t(), 3, 4),
        load(5, i32_t(), 2),
        load(6, i64_t(), 3),
        convert(7, ConvertOp.extend, 5),
        binary(8, BinaryOp.add, 6, 7),
        ins(InstructionForm.Alloca(result = r(9), slot = 1)),
        const_int(10, 3),
        ins(InstructionForm.ElementAddress(result = r(11), element_type = i16_t(), base = r(9), index = r(10))),
        const_int(12, -300),
        store(i16_t(), 11, 12),
        load(13, i16_t(), 11),
        convert(14, ConvertOp.extend, 13),
        binary(15, BinaryOp.add, 8, 14),
        ret([15]),
    ]
    let registers = [ptr_t(), i32_t(), ptr_t(), ptr_t(), i64_t(), i32_t(), i64_t(), i64_t(), i64_t(), ptr_t(), i64_t(), ptr_t(), i16_t(), i16_t(), i64_t(), i64_t()]
    let slots = [MirSlot(value_type = point, align = 8), MirSlot(value_type = array, align = 2)]
    program.functions.append(function_with_slots("value", list[TypeId](), [i64_t()], registers, slots, body))
    assert(first_int(program, "value") == 1000000000000 - 9 - 300)

pub func test_memcpy_copies_a_whole_struct():
    let program = create_empty_mir_program(wasm32_layout())
    let pair = intern_mir_type(program.types, make_struct_type(program.types, program.layout, [i32_t(), f64_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Alloca(result = r(1), slot = 1)),
        const_int(2, 41),
        store(i32_t(), 0, 2),
        ins(InstructionForm.FieldAddress(result = r(3), struct_type = pair, base = r(0), field = 1)),
        const_float(4, 0.5),
        store(f64_t(), 3, 4),
        ins(InstructionForm.Memcpy(destination = r(1), source = r(0), value_type = pair)),
        load(5, i32_t(), 1),
        ins(InstructionForm.FieldAddress(result = r(6), struct_type = pair, base = r(1), field = 1)),
        load(7, f64_t(), 6),
        convert(8, ConvertOp.int_to_float, 5),
        binary(9, BinaryOp.add, 8, 7),
        ret([9]),
    ]
    let registers = [ptr_t(), ptr_t(), i32_t(), ptr_t(), f64_t(), i32_t(), ptr_t(), f64_t(), f64_t(), f64_t()]
    let slots = [MirSlot(value_type = pair, align = 8), MirSlot(value_type = pair, align = 8)]
    program.functions.append(function_with_slots("value", list[TypeId](), [f64_t()], registers, slots, body))
    assert(float_of(run(program, "value", no_arguments())[0]) == 41.5)

pub func test_data_reaches_the_runtime_write_service():
    let program = create_empty_mir_program(wasm32_layout())
    program.externs.append(runtime_extern("luce_rt_write"))
    program.data.append(MirData(name = "greeting", bytes = strings.to_bytes("hi\n"), align = 1, relocations = list[MirRelocation]()))
    let body: list[MirInstruction] = [
        ins(InstructionForm.DataAddress(result = r(0), data = DataId(value = 0))),
        const_int(1, 3),
        ins(InstructionForm.CallExtern(results = list[RegisterId](), external = ExternId(value = 0), arguments = regs([0, 1]))),
        ins(InstructionForm.CallExtern(results = list[RegisterId](), external = ExternId(value = 0), arguments = regs([0, 1]))),
        ret(list[i64]()),
    ]
    program.functions.append(function("say", list[TypeId](), list[TypeId](), [ptr_t(), i64_t()], body))
    verified(program)
    let interpreter = MirInterpreter(program)
    let results = interpreter.run("say", no_arguments()) catch reason:
        trap(reason)
    assert(len(results) == 0)
    assert(interpreter.output == "hi\nhi\n")

pub func test_globals_start_from_their_data_and_keep_stores():
    let program = create_empty_mir_program(wasm32_layout())
    program.data.append(MirData(name = "seed", bytes = [7, 0, 0, 0], align = 4, relocations = list[MirRelocation]()))
    program.globals.append(MirGlobal(name = "counter", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    let bump: list[MirInstruction] = [
        ins(InstructionForm.GlobalAddress(result = r(0), global = GlobalId(value = 0))),
        load(1, i32_t(), 0),
        const_int(2, 1),
        binary(3, BinaryOp.add, 1, 2),
        store(i32_t(), 0, 3),
        ret([3]),
    ]
    program.functions.append(function("bump", list[TypeId](), [i32_t()], [ptr_t(), i32_t(), i32_t(), i32_t()], bump))
    verified(program)
    let interpreter = MirInterpreter(program)
    let first = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    let second = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(first[0]) == 8)
    assert(int_of(second[0]) == 9)

# mark: Calls ================================================================================

pub func test_calls_pass_parameters_and_recurse():
    # factorial(n) = n == 0 ? 1 : n * factorial(n - 1)
    let body: list[MirInstruction] = [
        const_int(1, 0),
        binary(2, BinaryOp.eq, 0, 1),
        ins(InstructionForm.If(condition = r(2), results = regs([6]), then_body = [const_int(3, 1), ins(InstructionForm.Yield(values = regs([3])))], else_body = [
            const_int(4, 1),
            binary(5, BinaryOp.sub, 0, 4),
            ins(InstructionForm.Call(results = regs([7]), function = FunctionId(value = 0), arguments = regs([5]))),
            binary(8, BinaryOp.mul, 0, 7),
            ins(InstructionForm.Yield(values = regs([8]))),
        ])),
        ret([6]),
    ]
    let registers = [i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let program = program_of([function("factorial", [i64_t()], [i64_t()], registers, body)])
    assert(int_of(run(program, "factorial", [MirValue.Int(value = 10)])[0]) == 3628800)
    assert(int_of(run(program, "factorial", [MirValue.Int(value = 0)])[0]) == 1)

pub func test_function_addresses_call_indirectly():
    let double: list[MirInstruction] = [const_int(1, 2), binary(2, BinaryOp.mul, 0, 1), ret([2])]
    let call_body: list[MirInstruction] = [
        ins(InstructionForm.FunctionAddress(result = r(0), function = FunctionId(value = 0))),
        const_int(1, 21),
        ins(InstructionForm.CallIndirect(results = regs([2]), signature = sig([i64_t()], [i64_t()]), target = r(0), arguments = regs([1]))),
        ret([2]),
    ]
    let program = program_of([
        function("double", [i64_t()], [i64_t()], [i64_t(), i64_t(), i64_t()], double),
        function("call", list[TypeId](), [i64_t()], [ptr_t(), i64_t(), i64_t()], call_body),
    ])
    assert(first_int(program, "call") == 42)

    let bad_target: list[MirInstruction] = [const_null(0), ins(InstructionForm.CallIndirect(results = regs([1]), signature = sig(list[TypeId](), [i64_t()]), target = r(0), arguments = list[RegisterId]())), ret([1])]
    let bad = program_of([function("call", list[TypeId](), [i64_t()], [ptr_t(), i64_t()], bad_target)])
    assert(run_failure(bad, "call", no_arguments()) == "mir interpreter: trap: indirect call through 0, which is not a function address")

pub func test_failure_is_data_in_the_error_slot():
    # checked_sum(limit): raise when limit < 0, else limit * 2; see docs/compiler/mir.md.
    let program = create_empty_mir_program(wasm32_layout())
    program.externs.append(runtime_extern("luce_rt_error_make"))
    program.externs.append(runtime_extern("luce_rt_error_code"))
    program.data.append(MirData(name = "message", bytes = strings.to_bytes("limit must not be negative"), align = 1, relocations = list[MirRelocation]()))
    let checked: list[MirInstruction] = [
        const_int(1, 0),
        binary(2, BinaryOp.lt, 0, 1),
        ins(InstructionForm.If(condition = r(2), results = list[RegisterId](), then_body = [
            const_int(3, 7),
            ins(InstructionForm.DataAddress(result = r(4), data = DataId(value = 0))),
            const_int(5, 26),
            ins(InstructionForm.CallExtern(results = regs([6]), external = ExternId(value = 0), arguments = regs([3, 4, 5]))),
            ins(InstructionForm.Raise(failure = r(6))),
        ], else_body = list[MirInstruction]())),
        const_int(7, 2),
        binary(8, BinaryOp.mul, 0, 7),
        const_null(9),
        ret([8, 9]),
    ]
    program.functions.append(fallible_function("checked_sum", [i64_t()], i64_t(), [i64_t(), i64_t(), bool_t(), i64_t(), ptr_t(), i64_t(), ptr_t(), i64_t(), i64_t(), ptr_t()], checked))
    # catcher(limit): checked_sum(limit) catch code -> -code
    let catcher: list[MirInstruction] = [
        ins(InstructionForm.Call(results = regs([1, 2]), function = FunctionId(value = 0), arguments = regs([0]))),
        const_null(3),
        binary(4, BinaryOp.ne, 2, 3),
        ins(InstructionForm.If(condition = r(4), results = regs([7]), then_body = [
            ins(InstructionForm.CallExtern(results = regs([5]), external = ExternId(value = 1), arguments = regs([2]))),
            unary(6, UnaryOp.neg, 5),
            ins(InstructionForm.Yield(values = regs([6]))),
        ], else_body = [ins(InstructionForm.Yield(values = regs([1])))])),
        ret([7]),
    ]
    program.functions.append(function("catcher", [i64_t()], [i64_t()], [i64_t(), i64_t(), ptr_t(), ptr_t(), bool_t(), i64_t(), i64_t(), i64_t()], catcher))
    verified(program)
    assert(int_of(run(program, "catcher", [MirValue.Int(value = 21)])[0]) == 42)
    assert(int_of(run(program, "catcher", [MirValue.Int(value = -1)])[0]) == -7)

    let interpreter = MirInterpreter(program)
    let raised = interpreter.run("checked_sum", [MirValue.Int(value = -5)]) catch reason:
        trap(reason)
    assert(len(raised) == 2)
    assert(int_of(raised[0]) == 0)
    assert(ptr_of(raised[1]) != 0)
    assert(interpreter.error_message(ptr_of(raised[1])) == "limit must not be negative")
    let fine = interpreter.run("checked_sum", [MirValue.Int(value = 5)]) catch reason:
        trap(reason)
    assert(int_of(fine[0]) == 10 and ptr_of(fine[1]) == 0)

# mark: Control flow =========================================================================

pub func test_blocks_yield_and_branch_with_values():
    let via_yield: list[MirInstruction] = [
        ins(InstructionForm.Block(results = regs([1]), body = [const_int(0, 5), ins(InstructionForm.Yield(values = regs([0])))])),
        ret([1]),
    ]
    assert(first_int(program_of([function("value", list[TypeId](), [i64_t()], [i64_t(), i64_t()], via_yield)]), "value") == 5)

    # An outer block receives values from a `Br 1` inside an inner block; the
    # inner block's own results are never bound.
    let via_branch: list[MirInstruction] = [
        ins(InstructionForm.Block(results = regs([2]), body = [
            const_int(0, 9),
            ins(InstructionForm.Block(results = regs([1]), body = [
                ins(InstructionForm.Br(depth = 1, values = regs([0]))),
            ])),
            ins(InstructionForm.Trap(reason = "unreachable after inner block")),
        ])),
        ret([2]),
    ]
    assert(first_int(program_of([function("value", list[TypeId](), [i64_t()], [i64_t(), i64_t(), i64_t()], via_branch)]), "value") == 9)

pub func test_sum_to_loop_matches_the_design_document():
    # The `sum_to` listing in docs/compiler/mir.md, instruction for instruction.
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(1), slot = 0)),
        ins(InstructionForm.Alloca(result = r(2), slot = 1)),
        const_int(3, 0),
        store(i64_t(), 1, 3),
        const_int(4, 1),
        store(i64_t(), 2, 4),
        ins(InstructionForm.Block(results = list[RegisterId](), body = [
            ins(InstructionForm.Loop(body = [
                load(5, i64_t(), 2),
                binary(6, BinaryOp.le, 5, 0),
                unary(7, UnaryOp.bool_not, 6),
                ins(InstructionForm.BrIf(condition = r(7), depth = 1, values = list[RegisterId]())),
                load(8, i64_t(), 1),
                binary(9, BinaryOp.add, 8, 5),
                store(i64_t(), 1, 9),
                const_int(10, 1),
                binary(11, BinaryOp.add, 5, 10),
                store(i64_t(), 2, 11),
                ins(InstructionForm.Br(depth = 0, values = list[RegisterId]())),
            ])),
        ])),
        load(12, i64_t(), 1),
        ret([12]),
    ]
    let registers = [i64_t(), ptr_t(), ptr_t(), i64_t(), i64_t(), i64_t(), bool_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let slots = [MirSlot(value_type = i64_t(), align = 8), MirSlot(value_type = i64_t(), align = 8)]
    let program = program_of([function_with_slots("sum_to", [i64_t()], [i64_t()], registers, slots, body)])
    assert(int_of(run(program, "sum_to", [MirValue.Int(value = 100)])[0]) == 5050)
    assert(int_of(run(program, "sum_to", [MirValue.Int(value = 0)])[0]) == 0)

pub func test_if_with_results_is_the_conditional_expression():
    let body: list[MirInstruction] = [
        ins(InstructionForm.If(condition = r(0), results = regs([3]), then_body = [const_int(1, 1), ins(InstructionForm.Yield(values = regs([1])))], else_body = [const_int(2, 2), ins(InstructionForm.Yield(values = regs([2])))])),
        ret([3]),
    ]
    let program = program_of([function("pick", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "pick", [MirValue.Bool(value = true)])[0]) == 1)
    assert(int_of(run(program, "pick", [MirValue.Bool(value = false)])[0]) == 2)

pub func test_switch_selects_a_case_or_the_default():
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = regs([4]), body = [
            ins(InstructionForm.Switch(tag = r(0), cases = [
                SwitchCase(value = 1, body = [const_int(1, 10), ins(InstructionForm.Br(depth = 1, values = regs([1])))]),
                SwitchCase(value = 2, body = [const_int(2, 20), ins(InstructionForm.Br(depth = 1, values = regs([2])))]),
            ], default_body = [const_int(3, -1), ins(InstructionForm.Br(depth = 1, values = regs([3])))])),
            ins(InstructionForm.Trap(reason = "switch fell through")),
        ])),
        ret([4]),
    ]
    let program = program_of([function("choose", [i32_t()], [i64_t()], [i32_t(), i64_t(), i64_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "choose", [MirValue.Int(value = 1)])[0]) == 10)
    assert(int_of(run(program, "choose", [MirValue.Int(value = 2)])[0]) == 20)
    assert(int_of(run(program, "choose", [MirValue.Int(value = 3)])[0]) == -1)

pub func test_return_leaves_nested_regions_immediately():
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = list[RegisterId](), body = [
            ins(InstructionForm.Loop(body = [
                ins(InstructionForm.If(condition = r(0), results = list[RegisterId](), then_body = [const_int(1, 7), ret([1])], else_body = list[MirInstruction]())),
                ins(InstructionForm.Br(depth = 1, values = list[RegisterId]())),
            ])),
        ])),
        const_int(2, 0),
        ret([2]),
    ]
    let program = program_of([function("early", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "early", [MirValue.Bool(value = true)])[0]) == 7)
    assert(int_of(run(program, "early", [MirValue.Bool(value = false)])[0]) == 0)

# mark: Traps and the runtime ================================================================

pub func test_traps_report_their_reason():
    let body: list[MirInstruction] = [ins(InstructionForm.Trap(reason = "unwrapped none"))]
    assert(run_failure(program_of([function("boom", list[TypeId](), list[TypeId](), list[TypeId](), body)]), "boom", no_arguments()) == "mir interpreter: trap: unwrapped none")

    let program = create_empty_mir_program(wasm32_layout())
    program.externs.append(runtime_extern("luce_rt_trap"))
    program.data.append(MirData(name = "why", bytes = strings.to_bytes("index 9 is out of range"), align = 1, relocations = list[MirRelocation]()))
    let via_runtime: list[MirInstruction] = [
        ins(InstructionForm.DataAddress(result = r(0), data = DataId(value = 0))),
        const_int(1, 23),
        ins(InstructionForm.CallExtern(results = list[RegisterId](), external = ExternId(value = 0), arguments = regs([0, 1]))),
        ins(InstructionForm.Unreachable),
    ]
    program.functions.append(function("boom", list[TypeId](), list[TypeId](), [ptr_t(), i64_t()], via_runtime))
    assert(run_failure(program, "boom", no_arguments()) == "mir interpreter: trap: index 9 is out of range")

pub func test_allocation_and_relocated_data_are_addressable():
    let program = create_empty_mir_program(wasm32_layout())
    program.externs.append(runtime_extern("luce_rt_alloc"))
    program.externs.append(runtime_extern("luce_rt_retain"))
    # A four-byte data item holding the address of `target` (data 1).
    program.data.append(MirData(name = "table", bytes = [0, 0, 0, 0], align = 4, relocations = [MirRelocation(offset = 0, target = RelocationTarget.Data(id = DataId(value = 1)))]))
    program.data.append(MirData(name = "target", bytes = [99], align = 1, relocations = list[MirRelocation]()))
    let body: list[MirInstruction] = [
        const_int(0, 16),
        const_int(1, 8),
        ins(InstructionForm.CallExtern(results = regs([2]), external = ExternId(value = 0), arguments = regs([0, 1]))),
        ins(InstructionForm.CallExtern(results = list[RegisterId](), external = ExternId(value = 1), arguments = regs([2]))),
        const_int(3, 5),
        store(i64_t(), 2, 3),
        load(4, i64_t(), 2),
        ins(InstructionForm.DataAddress(result = r(5), data = DataId(value = 0))),
        load(6, ptr_t(), 5),
        load(7, u8_t(), 6),
        convert(8, ConvertOp.extend, 7),
        binary(9, BinaryOp.add, 4, 8),
        ret([9]),
    ]
    let registers = [i64_t(), i64_t(), ptr_t(), i64_t(), i64_t(), ptr_t(), ptr_t(), u8_t(), i64_t(), i64_t()]
    program.functions.append(function("value", list[TypeId](), [i64_t()], registers, body))
    assert(first_int(program, "value") == 104)

pub func test_unknown_functions_and_externs_are_reported():
    let program = create_empty_mir_program(wasm32_layout())
    let i64_only = list[TypeId]()
    i64_only.append(i64_t())
    program.externs.append(MirExtern(name = "c_helper", convention = CallingConvention.c, signature = MirSignature(parameters = list[TypeId](), results = i64_only, is_fallible = false)))
    let body: list[MirInstruction] = [ins(InstructionForm.CallExtern(results = regs([0]), external = ExternId(value = 0), arguments = list[RegisterId]())), ret([0])]
    program.functions.append(function("value", list[TypeId](), i64_only, [i64_t()], body))
    assert(run_failure(program, "value", no_arguments()) == "mir interpreter: extern `c_helper` is not available")
    assert(run_failure(program, "missing", no_arguments()) == "mir interpreter: unknown function `missing`")

# A branch out of a loop that carries values must reach the enclosing block;
# `Loop` consumes exactly one depth level. (Found by the string-equality
# fixtures: the loop's result was dropped and the block fell through.)
pub func test_branch_out_of_a_loop_delivers_its_values_to_the_block():
    let loop_body: list[MirInstruction] = [
        const_int(0, 7),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Bool(value = true))),
        ins(InstructionForm.BrIf(condition = r(1), depth = 1, values = [r(0)])),
        ins(InstructionForm.Br(depth = 0, values = list[RegisterId]())),
    ]
    let block_body: list[MirInstruction] = [ins(InstructionForm.Loop(body = loop_body))]
    let body: list[MirInstruction] = [ins(InstructionForm.Block(results = [r(2)], body = block_body)), ret([2])]
    let program = program_of([function("escape", list[TypeId](), [i64_t()], [i64_t(), bool_t(), i64_t()], body)])
    assert(first_int(program, "escape") == 7)
