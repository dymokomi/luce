#==============================================================================================
#
#   mir_interpreter_test - Every MIR instruction, executed
#
#   DESCRIPTION:
#       Hand-built MIR programs run through the MIR interpreter. Each test
#       program is verified first, so this file also proves that the verifier
#       accepts the shapes the lowerer will produce. The arithmetic tests pin
#       the language's trap semantics (section 7) at every integer width.
#
#==============================================================================================

from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId
from luce.compiler.mir.canonical import ExternId, ExternalGlobalId, FunctionId, GlobalId, InstructionForm, MirConstant, MirData, OperandBuilder, no_registers
from luce.compiler.mir.canonical import MirExtern, MirExternalGlobal, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.mir.canonical import MirRuntimeBinding, MirSignature, MirSlot, MirType, RegisterId
from luce.compiler.runtime_contract import RuntimeService
from luce.compiler.mir.canonical import TypeId, UnaryOp, builtin_mir_type
from luce.compiler.mir.canonical import create_empty_mir_program, find_runtime_symbol, intern_mir_type
from luce.compiler.mir.canonical import make_struct_type
from luce.compiler.backends.layout import LayoutRules, TypeLayout
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.backends.mir_interpreter import MirExternHost, MirExternMemory, MirExternalGlobalHost, MirInterpreter, MirValue, function_address_base
from luce.compiler.backends.mir_interpreter import bool_of, float_of, int_of, ptr_of
from luce.compiler.frontend.source import SourceSpan
import std.strings

func layout32() -> LayoutRules:
    return LayoutRules(pointer_size = 4, pointer_align = 4)

func layout64() -> LayoutRules:
    return LayoutRules(pointer_size = 8, pointer_align = 8)

# mark: Builders =============================================================================

pub func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

pub func r(index: i64) -> RegisterId:
    return RegisterId(value = u32(index))

pub func regs(indices: list[i64]) -> list[RegisterId]:
    let registers = list[RegisterId]()
    for index in indices: registers.append(r(index))
    return registers

pub func i8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i8)
pub func i16_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i16)
pub func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
pub func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
pub func u8_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u8)
pub func u16_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u16)
pub func u32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u32)
pub func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
pub func f32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float32)
pub func f64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.float64)
pub func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
pub func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

class AddOneHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name != "add_one": error("unexpected extern")
        return [MirValue.Int(value = int_of(arguments[0]) + 1)]

class WrongResultCountHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        return list[MirValue]()

class WriteOutputHost: MirExternHost:
    pub init(): return

    pub func call(external: MirExtern, arguments: list[MirValue], memory: MirExternMemory) -> list[MirValue]!:
        if external.name != "write_answer" or len(arguments) != 1: error("unexpected extern")
        try memory.store_external(arguments[0], i32_t(), MirValue.Int(value = 42))
        return list[MirValue]()

class CounterGlobalHost: MirExternalGlobalHost:
    pub var value: i64

    pub init(value: i64): self.value = value

    pub func load(global: MirExternalGlobal) -> MirValue!:
        if global.name != "counter": error("unexpected external global")
        return MirValue.Int(value = self.value)

    pub func store(global: MirExternalGlobal, value: MirValue) -> !:
        if global.name != "counter": error("unexpected external global")
        self.value = int_of(value)

class WrongGlobalHost: MirExternalGlobalHost:
    pub init(): return

    pub func load(global: MirExternalGlobal) -> MirValue!: return MirValue.Float(value = 1.0)
    pub func store(global: MirExternalGlobal, value: MirValue) -> !: return

pub func sig(parameters: list[TypeId], results: list[TypeId]) -> MirSignature:
    return MirSignature(parameters = parameters, results = results, is_fallible = false)

pub func fallible_function(ops: OperandBuilder, name: str, parameters: list[TypeId], value: TypeId, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = [value, ptr_t()], is_fallible = true),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

# Helpers take parameter and result lists, not a `MirSignature`: Stage-0 frees
# the lists of a struct returned by one call and passed straight into another.
pub func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func function_with_slots(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], slots: list[MirSlot], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = slots,
        body = body,
        operands = ops.operands,
        is_public = true,
        is_exported = true,
        span = at(),
    )

pub func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = false,
        is_exported = false,
        span = at(),
    )

pub func program_of(functions: list[MirFunction]) -> MirProgram:
    let program = create_empty_mir_program()
    for item in functions: program.functions.append(item)
    return program

pub func runtime_extern(name: str) -> MirExtern:
    let symbol = find_runtime_symbol(name) else trap("unknown runtime symbol in test")
    return MirExtern(name = name, convention = CallingConvention.runtime, signature = symbol.signature)

# Short instruction spellings.
pub func const_int(result: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Int(value = value)))

pub func const_float(result: i64, value: f64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Float(value = value)))

pub func const_bool(result: i64, value: bool) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Bool(value = value)))

pub func const_null(result: i64) -> MirInstruction:
    return ins(InstructionForm.Const(result = r(result), value = MirConstant.Null))

pub func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return ins(InstructionForm.Binary(result = r(result), operation = operation, left = r(left), right = r(right)))

pub func unary(result: i64, operation: UnaryOp, operand: i64) -> MirInstruction:
    return ins(InstructionForm.Unary(result = r(result), operation = operation, operand = r(operand)))

pub func convert(result: i64, operation: ConvertOp, operand: i64) -> MirInstruction:
    return ins(InstructionForm.Convert(result = r(result), operation = operation, operand = r(operand)))

pub func ret(ops: OperandBuilder, values: list[i64]) -> MirInstruction:
    return ins(InstructionForm.Return(values = ops.run(regs(values))))

pub func load(result: i64, value_type: TypeId, address: i64) -> MirInstruction:
    return ins(InstructionForm.Load(result = r(result), value_type = value_type, address = r(address)))

pub func store(value_type: TypeId, address: i64, value: i64) -> MirInstruction:
    return ins(InstructionForm.Store(value_type = value_type, address = r(address), value = r(value)))

# mark: Running ==============================================================================

pub func verified(program: MirProgram):
    MirVerifier(program).verify() catch reason:
        trap(reason)

pub func run(program: MirProgram, name: str, arguments: list[MirValue]) -> list[MirValue]:
    verified(program)
    let results = MirInterpreter(program, layout32()).run(name, arguments) catch reason:
        trap(reason)
    return results

pub func run_failure(program: MirProgram, name: str, arguments: list[MirValue]) -> str:
    verified(program)
    let results = MirInterpreter(program, layout32()).run(name, arguments) catch reason:
        return reason
    return ""

pub func no_arguments() -> list[MirValue]:
    return list[MirValue]()

pub func first_int(program: MirProgram, name: str) -> i64:
    return int_of(run(program, name, no_arguments())[0])

# A one-function program computing `left OP right` at one integer type.
pub func binary_program(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> MirProgram:
    let ops = OperandBuilder()
    var result_type = operand_type
    if operation == BinaryOp.eq or operation == BinaryOp.ne or operation == BinaryOp.lt or operation == BinaryOp.le or operation == BinaryOp.gt or operation == BinaryOp.ge:
        result_type = bool_t()
    let body: list[MirInstruction] = [const_int(0, left), const_int(1, right), binary(2, operation, 0, 1), ret(ops, [2])]
    return program_of([function(ops, "compute", list[TypeId](), [result_type], [operand_type, operand_type, result_type], body)])

pub func compute(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> i64:
    return first_int(binary_program(operand_type, operation, left, right), "compute")

pub func compute_bool(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> bool:
    return bool_of(run(binary_program(operand_type, operation, left, right), "compute", no_arguments())[0])

pub func compute_failure(operand_type: TypeId, operation: BinaryOp, left: i64, right: i64) -> str:
    return run_failure(binary_program(operand_type, operation, left, right), "compute", no_arguments())

let overflow: str = "mir interpreter: trap: integer overflow"

# mark: Constants and registers ==============================================================

pub func test_constants_of_every_scalar_return_unchanged():
    let ops = OperandBuilder()
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let values = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 255, 65535, 4294967295, 9223372036854775807]
    for index in range(0, len(widths)):
        let program = program_of([function(ops, "value", list[TypeId](), [widths[index]], [widths[index]], [const_int(0, values[index]), ret(ops, [0])])])
        assert(first_int(program, "value") == values[index])

    let floats = program_of([function(ops, "value", list[TypeId](), [f32_t()], [f32_t(), f64_t()], [const_float(0, 1.5), const_float(1, 2.5), ret(ops, [0])])])
    assert(float_of(run(floats, "value", no_arguments())[0]) == 1.5)
    let booleans = program_of([function(ops, "value", list[TypeId](), [bool_t()], [bool_t()], [const_bool(0, true), ret(ops, [0])])])
    assert(bool_of(run(booleans, "value", no_arguments())[0]))
    let null = program_of([function(ops, "value", list[TypeId](), [ptr_t()], [ptr_t()], [const_null(0), ret(ops, [0])])])
    assert(ptr_of(run(null, "value", no_arguments())[0]) == 0)

pub func test_copy_and_parameters_flow_through_registers():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Copy(result = r(1), source = r(0))), ret(ops, [1])]
    let program = program_of([function(ops, "same", [i64_t()], [i64_t()], [i64_t(), i64_t()], body)])
    assert(int_of(run(program, "same", [MirValue.Int(value = 42)])[0]) == 42)

# mark: Checked integer arithmetic ===========================================================

pub func test_add_sub_mul_trap_at_every_width_boundary():
    let ops = OperandBuilder()
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let maxima = [127, 32767, 2147483647, 9223372036854775807, 255, 65535, 4294967295, 9223372036854775807]
    let minima = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 0, 0, 0, 0]
    for index in range(0, len(widths)):
        let width = widths[index]
        assert(compute(width, BinaryOp.add, maxima[index] - 1, 1) == maxima[index])
        assert(compute_failure(width, BinaryOp.add, maxima[index], 1) == overflow)
        assert(compute(width, BinaryOp.sub, minima[index] + 1, 1) == minima[index])
        assert(compute_failure(width, BinaryOp.sub, minima[index], 1) == overflow)
        assert(compute(width, BinaryOp.mul, maxima[index], 1) == maxima[index])
        assert(compute_failure(width, BinaryOp.mul, maxima[index], 2) == overflow)
    # Signed corners that a naive check gets wrong.
    assert(compute(i64_t(), BinaryOp.mul, -4611686018427387904, 2) == -9223372036854775807 - 1)
    assert(compute_failure(i64_t(), BinaryOp.mul, -4611686018427387904, -2) == overflow)
    assert(compute_failure(i64_t(), BinaryOp.mul, -9223372036854775807 - 1, -1) == overflow)
    assert(compute(i8_t(), BinaryOp.mul, -64, 2) == -128)
    assert(compute_failure(i8_t(), BinaryOp.mul, -64, -2) == overflow)
    assert(compute(i64_t(), BinaryOp.add, -9223372036854775807 - 1, 9223372036854775807) == -1)

pub func test_floor_division_and_remainder_follow_the_language():
    let ops = OperandBuilder()
    assert(compute(i64_t(), BinaryOp.floor_div, 7, 2) == 3)
    assert(compute(i64_t(), BinaryOp.floor_div, 7, -2) == -4)
    assert(compute(i64_t(), BinaryOp.floor_div, -7, 2) == -4)
    assert(compute(i64_t(), BinaryOp.rem, 7, -2) == -1)
    assert(compute(i64_t(), BinaryOp.rem, -7, 2) == 1)
    assert(compute(u8_t(), BinaryOp.rem, 255, 16) == 15)
    assert(compute_failure(i64_t(), BinaryOp.floor_div, 1, 0) == "mir interpreter: trap: division by zero")
    assert(compute_failure(i32_t(), BinaryOp.rem, 1, 0) == "mir interpreter: trap: division by zero")
    assert(compute_failure(i8_t(), BinaryOp.floor_div, -128, -1) == overflow)
    assert(compute_failure(i64_t(), BinaryOp.floor_div, -9223372036854775807 - 1, -1) == overflow)
    assert(compute(i8_t(), BinaryOp.floor_div, -127, -1) == 127)
    assert(compute(i8_t(), BinaryOp.rem, -128, -1) == 0)
    assert(compute(i64_t(), BinaryOp.rem, -9223372036854775807 - 1, -1) == 0)

pub func test_shifts_respect_width_and_sign():
    let ops = OperandBuilder()
    assert(compute(u8_t(), BinaryOp.shift_left, 1, 7) == 128)
    # Only the count is checked; bits shifted out are dropped (section 7).
    assert(compute(i8_t(), BinaryOp.shift_left, 1, 7) == -128)
    assert(compute(i8_t(), BinaryOp.shift_left, 1, 8 - 1) == -128)
    assert(compute(u8_t(), BinaryOp.shift_left, 255, 1) == 254)
    assert(compute(i16_t(), BinaryOp.shift_left, 3, 15) == -32768)
    assert(compute(i8_t(), BinaryOp.shift_left, -1, 7) == -128)
    assert(compute_failure(u8_t(), BinaryOp.shift_left, 1, 8) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute_failure(i64_t(), BinaryOp.shift_left, 1, 64) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute_failure(i64_t(), BinaryOp.shift_right, 1, -1) == "mir interpreter: trap: shift count is outside integer width")
    assert(compute(i64_t(), BinaryOp.shift_left, 1, 62) == 4611686018427387904)
    assert(compute(i64_t(), BinaryOp.shift_left, 1, 63) == -9223372036854775807 - 1)
    assert(compute(i32_t(), BinaryOp.shift_left, 1, 31) == -2147483647 - 1)
    assert(compute(u32_t(), BinaryOp.shift_left, 1, 31) == 2147483648)
    assert(compute(i64_t(), BinaryOp.shift_left, -1, 63) == -9223372036854775807 - 1)
    assert(compute(i64_t(), BinaryOp.shift_right, -8, 1) == -4)
    assert(compute(u32_t(), BinaryOp.shift_right, 4294967295, 31) == 1)
    assert(compute(i32_t(), BinaryOp.shift_right, -2147483647 - 1, 31) == -1)

pub func test_bitwise_operations_stay_inside_their_width():
    let ops = OperandBuilder()
    assert(compute(i64_t(), BinaryOp.bit_and, 12, 10) == 8)
    assert(compute(i64_t(), BinaryOp.bit_or, 12, 10) == 14)
    assert(compute(i64_t(), BinaryOp.bit_xor, 12, 10) == 6)
    assert(compute(u8_t(), BinaryOp.bit_xor, 255, 15) == 240)
    let not_signed = program_of([function(ops, "value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], [const_int(0, 5), unary(1, UnaryOp.bit_not, 0), ret(ops, [1])])])
    assert(first_int(not_signed, "value") == -6)
    let not_unsigned = program_of([function(ops, "value", list[TypeId](), [u8_t()], [u8_t(), u8_t()], [const_int(0, 5), unary(1, UnaryOp.bit_not, 0), ret(ops, [1])])])
    assert(first_int(not_unsigned, "value") == 250)

pub func test_comparisons_cover_every_operand_family():
    let ops = OperandBuilder()
    assert(compute_bool(i64_t(), BinaryOp.lt, -1, 1))
    assert(not compute_bool(u8_t(), BinaryOp.gt, 1, 2))
    assert(compute_bool(i32_t(), BinaryOp.le, 3, 3))
    assert(compute_bool(i32_t(), BinaryOp.ge, 3, 3))
    assert(compute_bool(i16_t(), BinaryOp.eq, -7, -7))
    assert(compute_bool(i16_t(), BinaryOp.ne, -7, 7))

    let floats: list[MirInstruction] = [const_float(0, 1.5), const_float(1, 2.0), binary(2, BinaryOp.lt, 0, 1), binary(3, BinaryOp.eq, 0, 0), binary(4, BinaryOp.div, 1, 0), ret(ops, [4])]
    let float_program = program_of([function(ops, "value", list[TypeId](), [f64_t()], [f64_t(), f64_t(), bool_t(), bool_t(), f64_t()], floats)])
    assert(float_of(run(float_program, "value", no_arguments())[0]) == 2.0 / 1.5)

    let booleans: list[MirInstruction] = [const_bool(0, true), const_bool(1, false), binary(2, BinaryOp.ne, 0, 1), ret(ops, [2])]
    assert(bool_of(run(program_of([function(ops, "value", list[TypeId](), [bool_t()], [bool_t(), bool_t(), bool_t()], booleans)]), "value", no_arguments())[0]))

    let pointers: list[MirInstruction] = [const_null(0), ins(InstructionForm.Alloca(result = r(1), slot = 0)), binary(2, BinaryOp.eq, 0, 1), binary(3, BinaryOp.ne, 0, 0), ret(ops, [2])]
    let pointer_function = function_with_slots(ops, "value", list[TypeId](), [bool_t()], [ptr_t(), ptr_t(), bool_t(), bool_t()], [MirSlot(value_type = i64_t())], pointers)
    assert(not bool_of(run(program_of([pointer_function]), "value", no_arguments())[0]))

pub func test_negation_and_boolean_not():
    let ops = OperandBuilder()
    let negate: list[MirInstruction] = [const_int(0, -128), unary(1, UnaryOp.neg, 0), ret(ops, [1])]
    assert(run_failure(program_of([function(ops, "value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], negate)]), "value", no_arguments()) == overflow)
    let negate_ok: list[MirInstruction] = [const_int(0, -127), unary(1, UnaryOp.neg, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i8_t()], [i8_t(), i8_t()], negate_ok)]), "value") == 127)
    let negate_float: list[MirInstruction] = [const_float(0, 2.5), unary(1, UnaryOp.neg, 0), ret(ops, [1])]
    assert(float_of(run(program_of([function(ops, "value", list[TypeId](), [f64_t()], [f64_t(), f64_t()], negate_float)]), "value", no_arguments())[0]) == -2.5)
    let not_bool: list[MirInstruction] = [const_bool(0, true), unary(1, UnaryOp.bool_not, 0), ret(ops, [1])]
    assert(not bool_of(run(program_of([function(ops, "value", list[TypeId](), [bool_t()], [bool_t(), bool_t()], not_bool)]), "value", no_arguments())[0]))

pub func test_conversions_extend_wrap_and_cross_to_floats():
    let ops = OperandBuilder()
    let extend: list[MirInstruction] = [const_int(0, -5), convert(1, ConvertOp.extend, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i64_t()], [i8_t(), i64_t()], extend)]), "value") == -5)
    let wrap_signed: list[MirInstruction] = [const_int(0, 200), convert(1, ConvertOp.wrap, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i8_t()], [i64_t(), i8_t()], wrap_signed)]), "value") == -56)
    let wrap_unsigned: list[MirInstruction] = [const_int(0, -1), convert(1, ConvertOp.wrap, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [u8_t()], [i64_t(), u8_t()], wrap_unsigned)]), "value") == 255)
    let wrap_wide: list[MirInstruction] = [const_int(0, 4294967296 + 7), convert(1, ConvertOp.wrap, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [u32_t()], [i64_t(), u32_t()], wrap_wide)]), "value") == 7)
    let to_float: list[MirInstruction] = [const_int(0, -3), convert(1, ConvertOp.int_to_float, 0), ret(ops, [1])]
    assert(float_of(run(program_of([function(ops, "value", list[TypeId](), [f64_t()], [i32_t(), f64_t()], to_float)]), "value", no_arguments())[0]) == -3.0)
    let to_int: list[MirInstruction] = [const_float(0, -3.7), convert(1, ConvertOp.float_to_int, 0), ret(ops, [1])]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i64_t()], [f64_t(), i64_t()], to_int)]), "value") == -3)
    let too_big: list[MirInstruction] = [const_float(0, 300.0), convert(1, ConvertOp.float_to_int, 0), ret(ops, [1])]
    assert(run_failure(program_of([function(ops, "value", list[TypeId](), [u8_t()], [f64_t(), u8_t()], too_big)]), "value", no_arguments()) == "mir interpreter: trap: float to integer conversion is outside the integer range")
    let huge: list[MirInstruction] = [const_float(0, 1e19), convert(1, ConvertOp.float_to_int, 0), ret(ops, [1])]
    assert(run_failure(program_of([function(ops, "value", list[TypeId](), [i64_t()], [f64_t(), i64_t()], huge)]), "value", no_arguments()) == "mir interpreter: trap: float to integer conversion is outside the integer range")

# mark: Memory ===============================================================================

pub func test_every_scalar_round_trips_through_a_slot():
    let ops = OperandBuilder()
    let widths = [i8_t(), i16_t(), i32_t(), i64_t(), u8_t(), u16_t(), u32_t(), u64_t()]
    let values = [-128, -32768, -2147483647 - 1, -9223372036854775807 - 1, 255, 65535, 4294967295, 9223372036854775807]
    for index in range(0, len(widths)):
        let width = widths[index]
        let body: list[MirInstruction] = [
            ins(InstructionForm.Alloca(result = r(0), slot = 0)),
            const_int(1, values[index]),
            store(width, 0, 1),
            load(2, width, 0),
            ret(ops, [2]),
        ]
        let program = program_of([function_with_slots(ops, "value", list[TypeId](), [width], [ptr_t(), width, width], [MirSlot(value_type = width)], body)])
        assert(first_int(program, "value") == values[index])

    let float_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), const_float(1, 6.25), store(f32_t(), 0, 1), load(2, f32_t(), 0), ret(ops, [2])]
    let float_program = program_of([function_with_slots(ops, "value", list[TypeId](), [f32_t()], [ptr_t(), f32_t(), f32_t()], [MirSlot(value_type = f32_t())], float_body)])
    assert(float_of(run(float_program, "value", no_arguments())[0]) == 6.25)

    let bool_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), const_bool(1, true), store(bool_t(), 0, 1), load(2, bool_t(), 0), ret(ops, [2])]
    let bool_program = program_of([function_with_slots(ops, "value", list[TypeId](), [bool_t()], [ptr_t(), bool_t(), bool_t()], [MirSlot(value_type = bool_t())], bool_body)])
    assert(bool_of(run(bool_program, "value", no_arguments())[0]))

    let ptr_body: list[MirInstruction] = [ins(InstructionForm.Alloca(result = r(0), slot = 0)), ins(InstructionForm.Alloca(result = r(1), slot = 1)), store(ptr_t(), 0, 1), load(2, ptr_t(), 0), binary(3, BinaryOp.eq, 1, 2), ret(ops, [3])]
    let ptr_program = program_of([function_with_slots(ops, "value", list[TypeId](), [bool_t()], [ptr_t(), ptr_t(), ptr_t(), bool_t()], [MirSlot(value_type = ptr_t()), MirSlot(value_type = i64_t())], ptr_body)])
    assert(bool_of(run(ptr_program, "value", no_arguments())[0]))

pub func test_struct_fields_and_array_elements_are_addressed_by_layout():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let point = intern_mir_type(program.types, make_struct_type([i8_t(), i64_t(), i32_t()]))
    match program.types.definitions[i64(point.value)]:
        Struct(fields): assert(len(fields) == 3)
        else: assert(false)
    let pointer_pair = intern_mir_type(program.types, make_struct_type([ptr_t(), ptr_t()]))
    let compact_layout = TypeLayout(program.types, layout32())
    let wide_layout = TypeLayout(program.types, layout64())
    assert(compact_layout.field_offset(point, 2) == 16)
    assert(wide_layout.field_offset(point, 2) == 16)
    assert(compact_layout.size_of(point) == 24)
    assert(wide_layout.size_of(point) == 24)
    assert(compact_layout.field_offset(pointer_pair, 1) == 4)
    assert(wide_layout.field_offset(pointer_pair, 1) == 8)
    assert(compact_layout.size_of(pointer_pair) == 8)
    assert(wide_layout.size_of(pointer_pair) == 16)
    let array = intern_mir_type(program.types, MirType.Array(element = i16_t(), count = 4))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        const_int(1, -9),
        ins(InstructionForm.FieldAddress(result = r(2), struct_type = point, base = r(0), field = 2)),
        store(i32_t(), 2, 1),
        ins(InstructionForm.FieldAddress(result = r(3), struct_type = point, base = r(0), field = 1)),
        const_int(4, 1000000000000),
        store(i64_t(), 3, 4),
        load(5, i32_t(), 2),
        load(6, i64_t(), 3),
        convert(7, ConvertOp.extend, 5),
        binary(8, BinaryOp.add, 6, 7),
        ins(InstructionForm.Alloca(result = r(9), slot = 1)),
        const_int(10, 3),
        ins(InstructionForm.ElementAddress(result = r(11), element_type = i16_t(), base = r(9), index = r(10))),
        const_int(12, -300),
        store(i16_t(), 11, 12),
        load(13, i16_t(), 11),
        convert(14, ConvertOp.extend, 13),
        binary(15, BinaryOp.add, 8, 14),
        ret(ops, [15]),
    ]
    let registers = [ptr_t(), i32_t(), ptr_t(), ptr_t(), i64_t(), i32_t(), i64_t(), i64_t(), i64_t(), ptr_t(), i64_t(), ptr_t(), i16_t(), i16_t(), i64_t(), i64_t()]
    let slots = [MirSlot(value_type = point), MirSlot(value_type = array)]
    program.functions.append(function_with_slots(ops, "value", list[TypeId](), [i64_t()], registers, slots, body))
    assert(first_int(program, "value") == 1000000000000 - 9 - 300)

pub func test_memcpy_copies_a_whole_struct():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let pair = intern_mir_type(program.types, make_struct_type([i32_t(), f64_t()]))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.Alloca(result = r(1), slot = 1)),
        const_int(2, 41),
        store(i32_t(), 0, 2),
        ins(InstructionForm.FieldAddress(result = r(3), struct_type = pair, base = r(0), field = 1)),
        const_float(4, 0.5),
        store(f64_t(), 3, 4),
        ins(InstructionForm.Memcpy(destination = r(1), source = r(0), value_type = pair)),
        load(5, i32_t(), 1),
        ins(InstructionForm.FieldAddress(result = r(6), struct_type = pair, base = r(1), field = 1)),
        load(7, f64_t(), 6),
        convert(8, ConvertOp.int_to_float, 5),
        binary(9, BinaryOp.add, 8, 7),
        ret(ops, [9]),
    ]
    let registers = [ptr_t(), ptr_t(), i32_t(), ptr_t(), f64_t(), i32_t(), ptr_t(), f64_t(), f64_t(), f64_t()]
    let slots = [MirSlot(value_type = pair), MirSlot(value_type = pair)]
    program.functions.append(function_with_slots(ops, "value", list[TypeId](), [f64_t()], registers, slots, body))
    assert(float_of(run(program, "value", no_arguments())[0]) == 41.5)

pub func test_data_reaches_the_runtime_write_service():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.externs.append(runtime_extern("luce_rt_write"))
    program.data.append(MirData(name = "greeting", bytes = strings.to_bytes("hi\n"), align = 1))
    let body: list[MirInstruction] = [
        ins(InstructionForm.DataAddress(result = r(0), data = DataId(value = 0))),
        const_int(1, 3),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run(regs([0, 1])))),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run(regs([0, 1])))),
        ret(ops, list[i64]()),
    ]
    program.functions.append(function(ops, "say", list[TypeId](), list[TypeId](), [ptr_t(), u64_t()], body))
    verified(program)
    let interpreter = MirInterpreter(program, layout32())
    let results = interpreter.run("say", no_arguments()) catch reason:
        trap(reason)
    assert(len(results) == 0)
    assert(interpreter.output == "hi\nhi\n")

pub func test_globals_start_from_their_data_and_keep_stores():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.data.append(MirData(name = "seed", bytes = [7, 0, 0, 0], align = 4))
    program.globals.append(MirGlobal(name = "counter", value_type = i32_t(), initial = DataId(value = 0), is_mutable = true))
    let bump: list[MirInstruction] = [
        ins(InstructionForm.GlobalAddress(result = r(0), global = GlobalId(value = 0))),
        load(1, i32_t(), 0),
        const_int(2, 1),
        binary(3, BinaryOp.add, 1, 2),
        store(i32_t(), 0, 3),
        ret(ops, [3]),
    ]
    program.functions.append(function(ops, "bump", list[TypeId](), [i32_t()], [ptr_t(), i32_t(), i32_t(), i32_t()], bump))
    verified(program)
    let interpreter = MirInterpreter(program, layout32())
    let first = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    let second = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(first[0]) == 8)
    assert(int_of(second[0]) == 9)

pub func test_external_globals_use_explicit_host_storage_on_every_access():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_t()))
    let bump: list[MirInstruction] = [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 0))),
        const_int(1, 1),
        binary(2, BinaryOp.add, 0, 1),
        ins(InstructionForm.StoreExternalGlobal(global = ExternalGlobalId(value = 0), value = r(2))),
        ins(InstructionForm.LoadExternalGlobal(result = r(3), global = ExternalGlobalId(value = 0))),
        ret(ops, [3]),
    ]
    program.functions.append(function(ops, "bump", list[TypeId](), [i32_t()], [i32_t(), i32_t(), i32_t(), i32_t()], bump))
    verified(program)
    let host = CounterGlobalHost(40)
    let interpreter = MirInterpreter(program, layout32())
    interpreter.bind_external_globals(host)
    let first = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    let second = interpreter.run("bump", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(first[0]) == 41 and int_of(second[0]) == 42 and host.value == 42)

    let unbound = MirInterpreter(program, layout32())
    let missing = unbound.run("bump", no_arguments()) catch reason:
        assert(reason == "mir interpreter: external global `counter` is not available")
        return

pub func test_external_global_hosts_must_return_the_declared_type():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_t()))
    program.functions.append(function(ops, "read", list[TypeId](), [i32_t()], [i32_t()], [
        ins(InstructionForm.LoadExternalGlobal(result = r(0), global = ExternalGlobalId(value = 0))),
        ret(ops, [0]),
    ]))
    verified(program)
    let wrong = MirInterpreter(program, layout32())
    wrong.bind_external_globals(WrongGlobalHost())
    let invalid = wrong.run("read", no_arguments()) catch reason:
        assert(reason == "mir interpreter: external global `counter` has an incompatible host value")
        return
    trap("expected an incompatible external-global value")

# mark: Calls ================================================================================

pub func test_calls_pass_parameters_and_recurse():
    let ops = OperandBuilder()
    # factorial(n) = n == 0 ? 1 : n * factorial(n - 1)
    let body: list[MirInstruction] = [
        const_int(1, 0),
        binary(2, BinaryOp.eq, 0, 1),
        ins(InstructionForm.If(condition = r(2), results = ops.run(regs([6])))),
        const_int(3, 1),
        ins(InstructionForm.Yield(values = ops.run(regs([3])))),
        ins(InstructionForm.Else),
        const_int(4, 1),
        binary(5, BinaryOp.sub, 0, 4),
        ins(InstructionForm.Call(results = ops.run(regs([7])), function = FunctionId(value = 0), arguments = ops.run(regs([5])))),
        binary(8, BinaryOp.mul, 0, 7),
        ins(InstructionForm.Yield(values = ops.run(regs([8])))),
        ins(InstructionForm.End),
        ret(ops, [6]),
    ]
    let registers = [i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let program = program_of([function(ops, "factorial", [i64_t()], [i64_t()], registers, body)])
    assert(int_of(run(program, "factorial", [MirValue.Int(value = 10)])[0]) == 3628800)
    assert(int_of(run(program, "factorial", [MirValue.Int(value = 0)])[0]) == 1)

pub func test_function_addresses_call_indirectly():
    let ops = OperandBuilder()
    let double: list[MirInstruction] = [const_int(1, 2), binary(2, BinaryOp.mul, 0, 1), ret(ops, [2])]
    let call_body: list[MirInstruction] = [
        ins(InstructionForm.FunctionAddress(result = r(0), function = FunctionId(value = 0))),
        const_int(1, 21),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([2])), signature = sig([i64_t()], [i64_t()]), convention = CallingConvention.luce, target = r(0), arguments = ops.run(regs([1])))),
        ret(ops, [2]),
    ]
    let program = program_of([
        function(ops, "double", [i64_t()], [i64_t()], [i64_t(), i64_t(), i64_t()], double),
        function(ops, "call", list[TypeId](), [i64_t()], [ptr_t(), i64_t(), i64_t()], call_body),
    ])
    assert(first_int(program, "call") == 42)

    let bad_target: list[MirInstruction] = [const_null(0), ins(InstructionForm.CallIndirect(results = ops.run(regs([1])), signature = sig(list[TypeId](), [i64_t()]), convention = CallingConvention.luce, target = r(0), arguments = no_registers())), ret(ops, [1])]
    let bad = program_of([function(ops, "call", list[TypeId](), [i64_t()], [ptr_t(), i64_t()], bad_target)])
    assert(run_failure(bad, "call", no_arguments()) == "mir interpreter: trap: indirect call through 0, which is not a compatible function address")

pub func test_c_extern_addresses_call_indirectly_through_the_explicit_host():
    let ops = OperandBuilder()
    let signature = sig([i32_t()], [i32_t()])
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "add_one", convention = CallingConvention.c, signature = signature))
    let body: list[MirInstruction] = [
        ins(InstructionForm.ExternAddress(result = r(0), external = ExternId(value = 0))),
        const_int(1, 41),
        ins(InstructionForm.CallIndirect(results = ops.run(regs([2])), signature = signature, convention = CallingConvention.c, target = r(0), arguments = ops.run(regs([1])))),
        ret(ops, [2]),
    ]
    program.functions.append(function(ops, "answer", list[TypeId](), [i32_t()], [ptr_t(), i32_t(), i32_t()], body))
    verified(program)
    let interpreter = MirInterpreter(program, layout32())
    interpreter.bind_externs(AddOneHost())
    let result = interpreter.run("answer", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(result[0]) == 42)

pub func test_failure_is_data_in_the_error_slot():
    let ops = OperandBuilder()
    # checked_sum(error_out, limit): fill the caller's slot and raise when
    # limit < 0, else return limit * 2 and a null error pointer.
    let program = create_empty_mir_program()
    let checked: list[MirInstruction] = [
        const_int(2, 0),
        binary(3, BinaryOp.lt, 1, 2),
        ins(InstructionForm.If(condition = r(3), results = no_registers())),
        const_int(4, 7),
        ins(InstructionForm.Store(value_type = i64_t(), address = r(0), value = r(4))),
        ins(InstructionForm.Raise(failure = r(0))),
        ins(InstructionForm.End),
        const_int(5, 2),
        binary(6, BinaryOp.mul, 1, 5),
        const_null(7),
        ret(ops, [6, 7]),
    ]
    program.functions.append(fallible_function(ops, "checked_sum", [ptr_t(), i64_t()], i64_t(), [ptr_t(), i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t(), ptr_t()], checked))
    # catcher(limit): allocate the error slot, then recover as `-code`.
    let catcher: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(1), slot = 0)),
        ins(InstructionForm.Call(results = ops.run(regs([2, 3])), function = FunctionId(value = 0), arguments = ops.run(regs([1, 0])))),
        const_null(4),
        binary(5, BinaryOp.ne, 3, 4),
        ins(InstructionForm.If(condition = r(5), results = ops.run(regs([8])))),
        ins(InstructionForm.Load(result = r(6), value_type = i64_t(), address = r(3))),
        unary(7, UnaryOp.neg, 6),
        ins(InstructionForm.Yield(values = ops.run(regs([7])))),
        ins(InstructionForm.Else),
        ins(InstructionForm.Yield(values = ops.run(regs([2])))),
        ins(InstructionForm.End),
        ret(ops, [8]),
    ]
    program.functions.append(function_with_slots(ops, "catcher", [i64_t()], [i64_t()], [i64_t(), ptr_t(), i64_t(), ptr_t(), ptr_t(), bool_t(), i64_t(), i64_t(), i64_t()], [MirSlot(value_type = i64_t())], catcher))
    verified(program)
    assert(int_of(run(program, "catcher", [MirValue.Int(value = 21)])[0]) == 42)
    assert(int_of(run(program, "catcher", [MirValue.Int(value = -1)])[0]) == -7)

# mark: Control flow =========================================================================

pub func test_blocks_yield_and_branch_with_values():
    let ops = OperandBuilder()
    let via_yield: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([1])))),
        const_int(0, 5),
        ins(InstructionForm.Yield(values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ret(ops, [1]),
    ]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i64_t()], [i64_t(), i64_t()], via_yield)]), "value") == 5)

    # An outer block receives values from a `Br 1` inside an inner block; the
    # inner block's own results are never bound.
    let via_branch: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([2])))),
        const_int(0, 9),
        ins(InstructionForm.Block(results = ops.run(regs([1])))),
        ins(InstructionForm.Br(depth = 1, values = ops.run(regs([0])))),
        ins(InstructionForm.End),
        ins(InstructionForm.Trap(reason = "unreachable after inner block")),
        ins(InstructionForm.End),
        ret(ops, [2]),
    ]
    assert(first_int(program_of([function(ops, "value", list[TypeId](), [i64_t()], [i64_t(), i64_t(), i64_t()], via_branch)]), "value") == 9)

pub func test_sum_to_loop_matches_the_design_document():
    let ops = OperandBuilder()
    # The `sum_to` listing in docs/compiler/mir.md, instruction for instruction.
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(1), slot = 0)),
        ins(InstructionForm.Alloca(result = r(2), slot = 1)),
        const_int(3, 0),
        store(i64_t(), 1, 3),
        const_int(4, 1),
        store(i64_t(), 2, 4),
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.Loop),
        load(5, i64_t(), 2),
        binary(6, BinaryOp.le, 5, 0),
        unary(7, UnaryOp.bool_not, 6),
        ins(InstructionForm.BrIf(condition = r(7), depth = 1, values = no_registers())),
        load(8, i64_t(), 1),
        binary(9, BinaryOp.add, 8, 5),
        store(i64_t(), 1, 9),
        const_int(10, 1),
        binary(11, BinaryOp.add, 5, 10),
        store(i64_t(), 2, 11),
        ins(InstructionForm.Br(depth = 0, values = no_registers())),
        ins(InstructionForm.End),
        ins(InstructionForm.End),
        load(12, i64_t(), 1),
        ret(ops, [12]),
    ]
    let registers = [i64_t(), ptr_t(), ptr_t(), i64_t(), i64_t(), i64_t(), bool_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let slots = [MirSlot(value_type = i64_t()), MirSlot(value_type = i64_t())]
    let program = program_of([function_with_slots(ops, "sum_to", [i64_t()], [i64_t()], registers, slots, body)])
    assert(int_of(run(program, "sum_to", [MirValue.Int(value = 100)])[0]) == 5050)
    assert(int_of(run(program, "sum_to", [MirValue.Int(value = 0)])[0]) == 0)

pub func test_if_with_results_is_the_conditional_expression():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.If(condition = r(0), results = ops.run(regs([3])))),
        const_int(1, 1),
        ins(InstructionForm.Yield(values = ops.run(regs([1])))),
        ins(InstructionForm.Else),
        const_int(2, 2),
        ins(InstructionForm.Yield(values = ops.run(regs([2])))),
        ins(InstructionForm.End),
        ret(ops, [3]),
    ]
    let program = program_of([function(ops, "pick", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "pick", [MirValue.Bool(value = true)])[0]) == 1)
    assert(int_of(run(program, "pick", [MirValue.Bool(value = false)])[0]) == 2)

pub func test_switch_selects_a_case_or_the_default():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run(regs([4])))),
        ins(InstructionForm.Switch(tag = r(0))),
        ins(InstructionForm.Case(value = 1)),
        const_int(1, 10),
        ins(InstructionForm.Br(depth = 1, values = ops.run(regs([1])))),
        ins(InstructionForm.Case(value = 2)),
        const_int(2, 20),
        ins(InstructionForm.Br(depth = 1, values = ops.run(regs([2])))),
        ins(InstructionForm.Default),
        const_int(3, -1),
        ins(InstructionForm.Br(depth = 1, values = ops.run(regs([3])))),
        ins(InstructionForm.End),
        ins(InstructionForm.Trap(reason = "switch fell through")),
        ins(InstructionForm.End),
        ret(ops, [4]),
    ]
    let program = program_of([function(ops, "choose", [i32_t()], [i64_t()], [i32_t(), i64_t(), i64_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "choose", [MirValue.Int(value = 1)])[0]) == 10)
    assert(int_of(run(program, "choose", [MirValue.Int(value = 2)])[0]) == 20)
    assert(int_of(run(program, "choose", [MirValue.Int(value = 3)])[0]) == -1)

pub func test_return_leaves_nested_regions_immediately():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = no_registers())),
        ins(InstructionForm.Loop),
        ins(InstructionForm.If(condition = r(0), results = no_registers())),
        const_int(1, 7),
        ret(ops, [1]),
        ins(InstructionForm.End),
        ins(InstructionForm.Br(depth = 1, values = no_registers())),
        ins(InstructionForm.End),
        ins(InstructionForm.End),
        const_int(2, 0),
        ret(ops, [2]),
    ]
    let program = program_of([function(ops, "early", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t()], body)])
    assert(int_of(run(program, "early", [MirValue.Bool(value = true)])[0]) == 7)
    assert(int_of(run(program, "early", [MirValue.Bool(value = false)])[0]) == 0)

# mark: Traps and the runtime ================================================================

pub func test_traps_report_their_reason():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [ins(InstructionForm.Trap(reason = "unwrapped none"))]
    assert(run_failure(program_of([function(ops, "boom", list[TypeId](), list[TypeId](), list[TypeId](), body)]), "boom", no_arguments()) == "mir interpreter: trap: unwrapped none")

    let program = create_empty_mir_program()
    program.externs.append(runtime_extern("luce_rt_trap"))
    program.data.append(MirData(name = "why", bytes = strings.to_bytes("index 9 is out of range"), align = 1))
    let via_runtime: list[MirInstruction] = [
        ins(InstructionForm.DataAddress(result = r(0), data = DataId(value = 0))),
        const_int(1, 23),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run(regs([0, 1])))),
        ins(InstructionForm.Unreachable),
    ]
    program.functions.append(function(ops, "boom", list[TypeId](), list[TypeId](), [ptr_t(), u64_t()], via_runtime))
    assert(run_failure(program, "boom", no_arguments()) == "mir interpreter: trap: index 9 is out of range")

pub func test_typed_storage_allocation_and_data_are_addressable():
    let allocator_ops = OperandBuilder()
    let ops = OperandBuilder()
    let empty_ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.externs.append(runtime_extern("luce_rt_retain"))
    program.data.append(MirData(name = "target", bytes = [99], align = 1))
    program.functions.append(private_function(
        allocator_ops,
        "runtime.allocate",
        [u64_t(), u64_t()],
        [ptr_t()],
        [u64_t(), u64_t()],
        [ins(InstructionForm.Trap(reason = "the semantic oracle does not execute allocator policy"))],
    ))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    let body: list[MirInstruction] = [
        const_int(0, 2),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i64_t(), count = r(0))),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run(regs([1])))),
        const_int(2, 1),
        ins(InstructionForm.ElementAddress(result = r(3), element_type = i64_t(), base = r(1), index = r(2))),
        const_int(4, 5),
        store(i64_t(), 3, 4),
        load(5, i64_t(), 3),
        ins(InstructionForm.DataAddress(result = r(6), data = DataId(value = 0))),
        load(7, u8_t(), 6),
        convert(8, ConvertOp.extend, 7),
        binary(9, BinaryOp.add, 5, 8),
        ret(ops, [9]),
    ]
    let registers = [u64_t(), ptr_t(), u64_t(), ptr_t(), i64_t(), i64_t(), ptr_t(), u8_t(), i64_t(), i64_t()]
    program.functions.append(function(ops, "value", list[TypeId](), [i64_t()], registers, body))
    program.functions.append(function(empty_ops, "empty", list[TypeId](), [ptr_t()], [u64_t(), ptr_t()], [
        const_int(0, 0),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i64_t(), count = r(0))),
        ret(empty_ops, [1]),
    ]))
    assert(first_int(program, "value") == 104)
    assert(ptr_of(run(program, "empty", no_arguments())[0]) == 0)

pub func test_unknown_functions_and_externs_are_reported():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let i64_only = list[TypeId]()
    i64_only.append(i64_t())
    program.externs.append(MirExtern(name = "c_helper", convention = CallingConvention.c, signature = MirSignature(parameters = list[TypeId](), results = i64_only, is_fallible = false)))
    let body: list[MirInstruction] = [ins(InstructionForm.CallExtern(results = ops.run(regs([0])), external = ExternId(value = 0), arguments = no_registers())), ret(ops, [0])]
    program.functions.append(function(ops, "value", list[TypeId](), i64_only, [i64_t()], body))
    assert(run_failure(program, "value", no_arguments()) == "mir interpreter: extern `c_helper` is not available")
    assert(run_failure(program, "missing", no_arguments()) == "mir interpreter: unknown function `missing`")

pub func test_c_externs_use_explicit_bindings_and_validate_results():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "add_one", convention = CallingConvention.c, signature = sig([i32_t()], [i32_t()])))
    let body: list[MirInstruction] = [
        const_int(0, 41),
        ins(InstructionForm.CallExtern(results = ops.run([r(1)]), external = ExternId(value = 0), arguments = ops.run([r(0)]))),
        ret(ops, [1]),
    ]
    program.functions.append(function(ops, "answer", list[TypeId](), [i32_t()], [i32_t(), i32_t()], body))
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let interpreter = MirInterpreter(program, layout32())
    interpreter.bind_externs(AddOneHost())
    let result = interpreter.run("answer", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(result[0]) == 42)
    let wrong = MirInterpreter(program, layout32())
    wrong.bind_externs(WrongResultCountHost())
    let values = wrong.run("answer", no_arguments()) catch reason:
        assert(reason == "mir interpreter: extern `add_one` returned 0 value(s), expected 1")
        return
    trap("expected the host result count to be checked")

pub func test_c_extern_hosts_write_output_slots_through_the_narrow_memory_view():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "write_answer", convention = CallingConvention.c, signature = sig([ptr_t()], list[TypeId]())))
    let body: list[MirInstruction] = [
        ins(InstructionForm.Alloca(result = r(0), slot = 0)),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run([r(0)]))),
        load(1, i32_t(), 0),
        ret(ops, [1]),
    ]
    program.functions.append(function_with_slots(ops, "answer", list[TypeId](), [i32_t()], [ptr_t(), i32_t()], [MirSlot(value_type = i32_t())], body))
    verified(program)
    let interpreter = MirInterpreter(program, layout32())
    interpreter.bind_externs(WriteOutputHost())
    let result = interpreter.run("answer", no_arguments()) catch reason:
        trap(reason)
    assert(int_of(result[0]) == 42)

# A branch out of a loop that carries values must reach the enclosing block;
# `Loop` consumes exactly one depth level. (Found by the string-equality
# fixtures: the loop's result was dropped and the block fell through.)
pub func test_branch_out_of_a_loop_delivers_its_values_to_the_block():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        ins(InstructionForm.Block(results = ops.run([r(2)]))),
        ins(InstructionForm.Loop),
        const_int(0, 7),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.Bool(value = true))),
        ins(InstructionForm.BrIf(condition = r(1), depth = 1, values = ops.run([r(0)]))),
        ins(InstructionForm.Br(depth = 0, values = no_registers())),
        ins(InstructionForm.End),
        ins(InstructionForm.End),
        ret(ops, [2]),
    ]
    let program = program_of([function(ops, "escape", list[TypeId](), [i64_t()], [i64_t(), bool_t(), i64_t()], body)])
    assert(first_int(program, "escape") == 7)
