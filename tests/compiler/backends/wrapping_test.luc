#==============================================================================================
#
#   wrapping_test - Modulo-2^64 arithmetic without host overflow
#
#   DESCRIPTION:
#       The oracles' wrapping helpers must agree with two's-complement at
#       every edge Stage-0 would otherwise trap on: the extremes of `i64`,
#       the full range of `u64`, and reduction to narrower widths.
#
#==============================================================================================

from luce.compiler.backends.wrapping import bits_of_signed, signed_of_bits, wrap_add_i64, wrap_add_u64, wrap_mul_i64, wrap_mul_u64
from luce.compiler.backends.wrapping import wrap_negate_i64, wrap_negate_u64, wrap_signed, wrap_sub_i64, wrap_sub_u64, wrap_unsigned

let minimum: i64 = -9223372036854775807 - 1
let maximum: i64 = 9223372036854775807

pub func test_signed_addition_and_subtraction_wrap_at_the_extremes():
    assert(wrap_add_i64(maximum, 1) == minimum)
    assert(wrap_add_i64(maximum, maximum) == -2)
    assert(wrap_add_i64(minimum, -1) == maximum)
    assert(wrap_add_i64(minimum, minimum) == 0)
    assert(wrap_add_i64(40, 2) == 42)
    assert(wrap_sub_i64(minimum, 1) == maximum)
    assert(wrap_sub_i64(maximum, -1) == minimum)
    assert(wrap_sub_i64(0, minimum) == minimum)
    assert(wrap_sub_i64(-1, minimum) == maximum)
    assert(wrap_negate_i64(minimum) == minimum)
    assert(wrap_negate_i64(42) == -42)

pub func test_signed_multiplication_wraps():
    assert(wrap_mul_i64(minimum, -1) == minimum)
    assert(wrap_mul_i64(maximum, 2) == -2)
    assert(wrap_mul_i64(4294967296, 4294967296) == 0)
    assert(wrap_mul_i64(-3, 7) == -21)
    assert(wrap_mul_i64(3037000500, 3037000500) == -9223372036709301616)

pub func test_unsigned_arithmetic_wraps():
    let top = u64(18446744073709551615)
    assert(wrap_add_u64(top, u64(1)) == u64(0))
    assert(wrap_add_u64(top, top) == top - u64(1))
    assert(wrap_sub_u64(u64(0), u64(1)) == top)
    assert(wrap_sub_u64(u64(5), u64(7)) == top - u64(1))
    assert(wrap_negate_u64(u64(1)) == top)
    assert(wrap_mul_u64(top, top) == u64(1))
    assert(wrap_mul_u64(u64(4294967296), u64(4294967296)) == u64(0))
    assert(wrap_mul_u64(u64(6), u64(7)) == u64(42))

pub func test_widths_and_bit_patterns_round_trip():
    assert(wrap_signed(255, 8) == -1)
    assert(wrap_signed(128, 8) == -128)
    assert(wrap_signed(-129, 8) == 127)
    assert(wrap_unsigned(u64(256), 8) == u64(0))
    assert(wrap_unsigned(u64(4294967296) + u64(5), 32) == u64(5))
    assert(bits_of_signed(-1) == u64(18446744073709551615))
    assert(signed_of_bits(u64(18446744073709551615)) == -1)
    assert(signed_of_bits(bits_of_signed(minimum)) == minimum)
    assert(signed_of_bits(bits_of_signed(maximum)) == maximum)
