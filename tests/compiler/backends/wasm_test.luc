#==============================================================================================
#
#   wasm_test - The WebAssembly bytes come out exactly right
#
#   DESCRIPTION:
#       Hand-built canonical programs in, byte-for-byte expected modules out.
#       Encoders earn trust by exact bytes, not by "looks like WASM".
#
#==============================================================================================

from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram, CanonicalType
from luce.compiler.backends.wasm import WasmBackend
import std.strings

pub func test_wasm_backend_writes_the_binary_format_directly():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.Constant(value = 6, value_type = CanonicalType.signed_i64),
        CanonicalInstruction.Constant(value = 1, value_type = CanonicalType.signed_i64),
        CanonicalInstruction.Add(operand_type = CanonicalType.signed_i64),
        CanonicalInstruction.Constant(value = 8, value_type = CanonicalType.signed_i64),
        CanonicalInstruction.Constant(value = 2, value_type = CanonicalType.signed_i64),
        CanonicalInstruction.Subtract(operand_type = CanonicalType.signed_i64),
        CanonicalInstruction.Multiply(operand_type = CanonicalType.signed_i64),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = CanonicalType.signed_i64, instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    let expected: list[u8] = [
        0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
        0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7E,
        0x03, 0x02, 0x01, 0x00,
        0x07, 0x0F, 0x01, 0x0B,
        0x6D, 0x61, 0x69, 0x6E, 0x2E, 0x61, 0x6E, 0x73, 0x77, 0x65, 0x72,
        0x00, 0x00,
        0x0A, 0x10, 0x01, 0x0E, 0x00,
        0x42, 0x06, 0x42, 0x01, 0x7C, 0x42, 0x08, 0x42, 0x02, 0x7D, 0x7E, 0x0F, 0x0B,
    ]
    assert(len(artifact) == len(expected))
    var index = 0
    while index < len(expected):
        assert(artifact[index] == expected[index])
        index += 1

pub func test_wasm_backend_uses_signed_leb128_for_i64_constants():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.Constant(value = -1, value_type = CanonicalType.signed_i64),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = CanonicalType.signed_i64, instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    assert(artifact[len(artifact) - 3] == 0x7F)

pub func test_wasm_backend_encodes_i32_arithmetic():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.Constant(value = 1, value_type = CanonicalType.signed_i32),
        CanonicalInstruction.Constant(value = 2, value_type = CanonicalType.signed_i32),
        CanonicalInstruction.Add(operand_type = CanonicalType.signed_i32),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "hello.main", is_public = true, result = CanonicalType.signed_i32, instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact[2] == 0x73)
    assert(artifact[3] == 0x6D)
    var saw_i32_type = false
    var saw_i32_add = false
    var index = 0
    while index < len(artifact):
        if artifact[index] == 0x7F: saw_i32_type = true
        if artifact[index] == 0x6A: saw_i32_add = true
        index += 1
    assert(saw_i32_type)
    assert(saw_i32_add)

pub func test_wasm_backend_legalizes_write_text_to_an_import():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.WriteText(value = "Hi"),
        CanonicalInstruction.Constant(value = 0, value_type = CanonicalType.signed_i32),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "hello.main", is_public = true, result = CanonicalType.signed_i32, instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    assert(artifact[0] == 0x00)
    assert(artifact[1] == 0x61)
    assert(artifact_contains(artifact, "luce"))
    assert(artifact_contains(artifact, "write"))
    assert(artifact_contains(artifact, "Hi\n"))

func artifact_contains(artifact: list[u8], text: str) -> bool:
    let needle = strings.to_bytes(text)
    if len(needle) == 0 or len(needle) > len(artifact): return false
    var start = 0
    while start + len(needle) <= len(artifact):
        var matched = true
        var index = 0
        while index < len(needle):
            if artifact[start + index] != needle[index]: matched = false
            index += 1
        if matched: return true
        start += 1
    return false
