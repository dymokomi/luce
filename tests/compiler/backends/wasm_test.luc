from luce.compiler.canonical_ir import CanonicalFunction, CanonicalInstruction, CanonicalProgram
from luce.compiler.backends.wasm import WasmBackend

pub func test_wasm_backend_writes_the_binary_format_directly():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = 6),
        CanonicalInstruction.I64Constant(value = 1),
        CanonicalInstruction.I64Add,
        CanonicalInstruction.I64Constant(value = 8),
        CanonicalInstruction.I64Constant(value = 2),
        CanonicalInstruction.I64Subtract,
        CanonicalInstruction.I64Multiply,
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = "i64", instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    let expected: list[u8] = [
        0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
        0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7E,
        0x03, 0x02, 0x01, 0x00,
        0x07, 0x0F, 0x01, 0x0B,
        0x6D, 0x61, 0x69, 0x6E, 0x2E, 0x61, 0x6E, 0x73, 0x77, 0x65, 0x72,
        0x00, 0x00,
        0x0A, 0x10, 0x01, 0x0E, 0x00,
        0x42, 0x06, 0x42, 0x01, 0x7C, 0x42, 0x08, 0x42, 0x02, 0x7D, 0x7E, 0x0F, 0x0B,
    ]
    assert(len(artifact) == len(expected))
    var index = 0
    while index < len(expected):
        assert(artifact[index] == expected[index])
        index += 1

pub func test_wasm_backend_uses_signed_leb128_for_i64_constants():
    let instructions: list[CanonicalInstruction] = [
        CanonicalInstruction.I64Constant(value = -1),
        CanonicalInstruction.Return,
    ]
    let function = CanonicalFunction(name = "main.answer", is_public = true, result = "i64", instructions = instructions)
    let artifact = WasmBackend().emit(CanonicalProgram(functions = [function])) catch reason:
        trap(reason)
    assert(artifact[len(artifact) - 3] == 0x7F)
