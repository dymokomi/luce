#==============================================================================================
#
#   wasm_test - The WebAssembly encoder writes the expected module
#
#   DESCRIPTION:
#       Hand-built canonical MIR in, expected module bytes out. The encoder
#       earns trust by matching the expected module exactly for a minimal
#       program, and by emitting the exact legalization sequences and the
#       WASI import/memory/data layout for the rest. When wasmtime is
#       installed the modules also run, and the language's semantics —
#       trapping overflow, floor division, canonical narrow values — are
#       observed rather than assumed.
#
#==============================================================================================

from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, ConvertOp, DataId, ExternId, ExternalGlobalId, GlobalId, InstructionForm, OperandBuilder, no_registers
from luce.compiler.mir.canonical import FunctionId, MirConstant, MirData, MirExtern, MirExternalGlobal, MirFunction, MirGlobal, MirInstruction, MirProgram
from luce.compiler.mir.canonical import MirRuntimeBinding, MirSignature, MirSlot, MirType, RegisterId, TypeId, UnaryOp
from luce.compiler.runtime_contract import RuntimeService
from luce.compiler.mir.canonical import builtin_mir_type, create_empty_mir_program, find_runtime_symbol, intern_mir_type, make_struct_type
from luce.compiler.backends.wasm import WasmBackend
from luce.compiler.backends.wasm_plan import plan_module
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.analyzer import SemanticAnalyzer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import ModuleAuthority
from luce.compiler.mir.composer import compose_runtime
from luce.compiler.mir.lowerer import Lowerer
from luce.compiler.mir.optimizer import Optimizer
from luce.compiler.pipeline import compile_runtime
from luce.compiler.runtime_package import sealed_runtime_package
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan
import std.files
import std.os
import std.strings

# mark: Fixtures ============================================================================

pub func at(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = SourceSpan(start = 0, end = 0, line = 1, column = 1))

pub func register(index: i64) -> RegisterId:
    return RegisterId(value = u32(index))

pub func scalar(value: BuiltinMirType) -> TypeId:
    return builtin_mir_type(value)

func lower_executable(source: str) -> MirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let hir = HirGenerator("org.luce.wasm-test", [
        SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax),
    ]).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let application = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    let runtime = compile_runtime(sealed_runtime_package("src/runtime", ["src/runtime/allocator.native.luc"])) catch reason:
        trap(reason)
    let composed = compose_runtime(application, runtime.program) catch reason:
        trap(reason)
    MirVerifier(composed).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(composed).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    return optimized

# One public function with no parameters and one result.
pub func function(ops: OperandBuilder, name: str, result: BuiltinMirType, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [scalar(result)], is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = false,
        is_exported = false,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

func storage_program(count: i64, zero_sized: bool, uses_storage: bool) -> MirProgram:
    let allocator_ops = OperandBuilder()
    let deallocator_ops = OperandBuilder()
    let answer_ops = OperandBuilder()
    let program = create_empty_mir_program()
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let pointer_type = scalar(BuiltinMirType.pointer)
    let i32_type = scalar(BuiltinMirType.signed_i32)
    var element_type = i32_type
    if zero_sized: element_type = intern_mir_type(program.types, make_struct_type(list[TypeId]()))
    program.data.append(MirData(name = "runtime.arena", bytes = [0, 0, 0, 0, 0, 0, 0, 0], align = 8))
    program.functions.append(private_function(allocator_ops, "runtime.allocate", [u64_type, u64_type], [pointer_type], [u64_type, u64_type, pointer_type], [
        at(InstructionForm.DataAddress(result = register(2), data = DataId(value = 0))),
        at(InstructionForm.Return(values = allocator_ops.run([register(2)]))),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    program.functions.append(private_function(deallocator_ops, "runtime.deallocate", [pointer_type, u64_type, u64_type], list[TypeId](), [pointer_type, u64_type, u64_type], [
        at(InstructionForm.Return(values = deallocator_ops.run(list[RegisterId]()))),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_deallocator, function = FunctionId(value = 1)))
    if uses_storage:
        program.functions.append(function(answer_ops, "main.answer", BuiltinMirType.signed_i32, [u64_type, pointer_type, u64_type, pointer_type, i32_type, i32_type], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = u64(count)))),
            at(InstructionForm.AllocateStorage(result = register(1), element_type = element_type, count = register(0))),
            at(InstructionForm.Const(result = register(2), value = MirConstant.UnsignedInt(value = 1))),
            at(InstructionForm.ElementAddress(result = register(3), element_type = element_type, base = register(1), index = register(2))),
            at(InstructionForm.Const(result = register(4), value = MirConstant.SignedInt(value = 42))),
            at(InstructionForm.Store(value_type = i32_type, address = register(3), value = register(4))),
            at(InstructionForm.Load(result = register(5), value_type = i32_type, address = register(3))),
            at(InstructionForm.DeallocateStorage(address = register(1), element_type = element_type, count = register(0))),
            at(InstructionForm.Return(values = answer_ops.run([register(5)]))),
        ]))
    else:
        program.functions.append(function(answer_ops, "main.answer", BuiltinMirType.signed_i32, [u64_type, pointer_type, i32_type], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = u64(count)))),
            at(InstructionForm.AllocateStorage(result = register(1), element_type = element_type, count = register(0))),
            at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 0))),
            at(InstructionForm.Return(values = answer_ops.run([register(2)]))),
        ]))
    return verified(program)

func typed_move_program(count: i64) -> MirProgram:
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let u8_type = scalar(BuiltinMirType.unsigned_u8)
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let pointer_type = scalar(BuiltinMirType.pointer)
    program.data.append(MirData(name = "values", bytes = [40, 1, 2, 3], align = 1))
    program.functions.append(function(ops, "main.answer", BuiltinMirType.unsigned_u8, [pointer_type, u64_type, pointer_type, u64_type, u64_type, pointer_type, u8_type], [
        at(InstructionForm.DataAddress(result = register(0), data = DataId(value = 0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 1))),
        at(InstructionForm.ElementAddress(result = register(2), element_type = u8_type, base = register(0), index = register(1))),
        at(InstructionForm.Const(result = register(3), value = MirConstant.UnsignedInt(value = u64(count)))),
        at(InstructionForm.MoveElements(destination = register(2), source = register(0), element_type = u8_type, count = register(3))),
        at(InstructionForm.Const(result = register(4), value = MirConstant.UnsignedInt(value = 3))),
        at(InstructionForm.ElementAddress(result = register(5), element_type = u8_type, base = register(0), index = register(4))),
        at(InstructionForm.Load(result = register(6), value_type = u8_type, address = register(5))),
        at(InstructionForm.Return(values = ops.run([register(6)]))),
    ]))
    return verified(program)

func arena_program(requested_end: i64) -> MirProgram:
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let pointer_type = scalar(BuiltinMirType.pointer)
    program.externs.append(MirExtern(
        name = "luce_rt_arena",
        convention = CallingConvention.runtime,
        signature = MirSignature(parameters = [u64_type], results = [pointer_type], is_fallible = false, returns_never = false),
    ))
    program.functions.append(function(ops, "main.answer", BuiltinMirType.signed_i32, [u64_type, pointer_type, scalar(BuiltinMirType.signed_i32)], [
        at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = u64(requested_end)))),
        at(InstructionForm.CallExtern(results = ops.run([register(1)]), external = ExternId(value = 0), arguments = ops.run([register(0)]))),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 42))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]))
    return verified(program)

func list_program() -> MirProgram:
    let create_ops = OperandBuilder()
    let length_ops = OperandBuilder()
    let append_ops = OperandBuilder()
    let insert_ops = OperandBuilder()
    let remove_ops = OperandBuilder()
    let clear_ops = OperandBuilder()
    let reserve_ops = OperandBuilder()
    let address_ops = OperandBuilder()
    let copy_ops = OperandBuilder()
    let mutable_ops = OperandBuilder()
    let slice_ops = OperandBuilder()
    let slice_length_ops = OperandBuilder()
    let slice_address_ops = OperandBuilder()
    let concat_ops = OperandBuilder()
    let iteration_begin_ops = OperandBuilder()
    let iteration_end_ops = OperandBuilder()
    let iteration_active_ops = OperandBuilder()
    let list_retain_ops = OperandBuilder()
    let list_release_ops = OperandBuilder()
    let slice_retain_ops = OperandBuilder()
    let slice_release_ops = OperandBuilder()
    let element_action_ops = OperandBuilder()
    let answer_ops = OperandBuilder()
    let program = create_empty_mir_program()
    let pointer_type = scalar(BuiltinMirType.pointer)
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let i32_type = scalar(BuiltinMirType.signed_i32)
    let bool_type = scalar(BuiltinMirType.boolean)
    let list_type = intern_mir_type(program.types, MirType.List(element = i32_type))
    let frozen_list_type = intern_mir_type(program.types, MirType.FrozenList(element = i32_type))
    let slice_type = intern_mir_type(program.types, MirType.Slice(element = i32_type))

    program.functions.append(private_function(create_ops, "runtime.list_create", list[TypeId](), [pointer_type], [pointer_type], [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Null)),
        at(InstructionForm.Return(values = create_ops.run([register(0)]))),
    ]))
    program.functions.append(private_function(length_ops, "runtime.list_length", [pointer_type], [u64_type], [pointer_type, u64_type], [
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 1))),
        at(InstructionForm.Return(values = length_ops.run([register(1)]))),
    ]))
    program.functions.append(private_function(append_ops, "runtime.list_append", [pointer_type, u64_type, u64_type, pointer_type], [pointer_type], [pointer_type, u64_type, u64_type, pointer_type, pointer_type], [
        at(InstructionForm.Const(result = register(4), value = MirConstant.Null)),
        at(InstructionForm.Return(values = append_ops.run([register(4)]))),
    ]))
    program.functions.append(private_function(insert_ops, "runtime.list_insert", [pointer_type, u64_type, u64_type, u64_type, pointer_type], [pointer_type], [pointer_type, u64_type, u64_type, u64_type, pointer_type, pointer_type], [
        at(InstructionForm.Const(result = register(5), value = MirConstant.Null)),
        at(InstructionForm.Return(values = insert_ops.run([register(5)]))),
    ]))
    program.functions.append(private_function(remove_ops, "runtime.list_remove", [pointer_type, u64_type, u64_type, u64_type, pointer_type], list[TypeId](), [pointer_type, u64_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Return(values = remove_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(clear_ops, "runtime.list_clear", [pointer_type, u64_type, u64_type, pointer_type], list[TypeId](), [pointer_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Return(values = clear_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(reserve_ops, "runtime.list_reserve", [pointer_type, u64_type, u64_type, u64_type, pointer_type], list[TypeId](), [pointer_type, u64_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Return(values = reserve_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(address_ops, "runtime.list_address", [pointer_type, u64_type, u64_type], [pointer_type], [pointer_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Const(result = register(3), value = MirConstant.Null)),
        at(InstructionForm.Return(values = address_ops.run([register(3)]))),
    ]))
    program.functions.append(private_function(copy_ops, "runtime.list_copy", [pointer_type, u64_type, u64_type, pointer_type], [pointer_type], [pointer_type, u64_type, u64_type, pointer_type, pointer_type], [
        at(InstructionForm.Copy(result = register(4), source = register(0))),
        at(InstructionForm.Return(values = copy_ops.run([register(4)]))),
    ]))
    program.functions.append(private_function(mutable_ops, "runtime.list_mutable_element_address", [pointer_type, u64_type, u64_type, u64_type, pointer_type], [pointer_type], [pointer_type, u64_type, u64_type, u64_type, pointer_type, pointer_type], [
        at(InstructionForm.Copy(result = register(5), source = register(0))),
        at(InstructionForm.Return(values = mutable_ops.run([register(5)]))),
    ]))
    program.functions.append(private_function(slice_ops, "runtime.list_slice", [pointer_type, u64_type, u64_type, u64_type], [pointer_type], [pointer_type, u64_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Copy(result = register(4), source = register(0))),
        at(InstructionForm.Return(values = slice_ops.run([register(4)]))),
    ]))
    program.functions.append(private_function(slice_length_ops, "runtime.slice_length", [pointer_type], [u64_type], [pointer_type, u64_type], [
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 0))),
        at(InstructionForm.Return(values = slice_length_ops.run([register(1)]))),
    ]))
    program.functions.append(private_function(slice_address_ops, "runtime.slice_element_address", [pointer_type, u64_type, u64_type], [pointer_type], [pointer_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Copy(result = register(3), source = register(0))),
        at(InstructionForm.Return(values = slice_address_ops.run([register(3)]))),
    ]))
    program.functions.append(private_function(concat_ops, "runtime.list_concat", [pointer_type, pointer_type, u64_type, u64_type, pointer_type], [pointer_type], [pointer_type, pointer_type, u64_type, u64_type, pointer_type, pointer_type], [
        at(InstructionForm.Copy(result = register(5), source = register(0))),
        at(InstructionForm.Return(values = concat_ops.run([register(5)]))),
    ]))
    program.functions.append(private_function(iteration_begin_ops, "runtime.list_iteration_begin", [pointer_type], [u64_type], [pointer_type, u64_type], [
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 0))),
        at(InstructionForm.Return(values = iteration_begin_ops.run([register(1)]))),
    ]))
    program.functions.append(private_function(iteration_end_ops, "runtime.list_iteration_end", [pointer_type], list[TypeId](), [pointer_type], [
        at(InstructionForm.Return(values = iteration_end_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(iteration_active_ops, "runtime.list_iteration_active", [pointer_type], [bool_type], [pointer_type, bool_type], [
        at(InstructionForm.Const(result = register(1), value = MirConstant.Bool(value = false))),
        at(InstructionForm.Return(values = iteration_active_ops.run([register(1)]))),
    ]))
    program.functions.append(private_function(list_retain_ops, "runtime.list_retain", [pointer_type], list[TypeId](), [pointer_type], [
        at(InstructionForm.Return(values = list_retain_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(list_release_ops, "runtime.list_release", [pointer_type, u64_type, u64_type, pointer_type], list[TypeId](), [pointer_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Return(values = list_release_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(slice_retain_ops, "runtime.slice_retain", [pointer_type], list[TypeId](), [pointer_type], [
        at(InstructionForm.Return(values = slice_retain_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(slice_release_ops, "runtime.slice_release", [pointer_type, u64_type, u64_type, pointer_type], list[TypeId](), [pointer_type, u64_type, u64_type, pointer_type], [
        at(InstructionForm.Return(values = slice_release_ops.run(list[RegisterId]()))),
    ]))
    program.functions.append(private_function(element_action_ops, "element.action", [pointer_type], list[TypeId](), [pointer_type], [
        at(InstructionForm.Return(values = element_action_ops.run(list[RegisterId]()))),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_create, function = FunctionId(value = 0)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_length, function = FunctionId(value = 1)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_append_slot, function = FunctionId(value = 2)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_insert_slot, function = FunctionId(value = 3)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_remove_at, function = FunctionId(value = 4)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_clear, function = FunctionId(value = 5)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_reserve, function = FunctionId(value = 6)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_element_address, function = FunctionId(value = 7)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_copy, function = FunctionId(value = 8)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_mutable_element_address, function = FunctionId(value = 9)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_slice, function = FunctionId(value = 10)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_length, function = FunctionId(value = 11)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_element_address, function = FunctionId(value = 12)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_concat, function = FunctionId(value = 13)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_begin, function = FunctionId(value = 14)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_end, function = FunctionId(value = 15)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_iteration_active, function = FunctionId(value = 16)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_retain, function = FunctionId(value = 17)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.list_release, function = FunctionId(value = 18)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_retain, function = FunctionId(value = 19)))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.slice_release, function = FunctionId(value = 20)))
    program.functions.append(function(answer_ops, "main.answer", BuiltinMirType.signed_i32, [list_type, u64_type, pointer_type, pointer_type, u64_type, i32_type, pointer_type, u64_type, list_type, pointer_type, slice_type, u64_type, pointer_type, scalar(BuiltinMirType.boolean), list_type, u64_type, frozen_list_type], [
        at(InstructionForm.ListCreate(result = register(0))),
        at(InstructionForm.ListCopy(result = register(8), value = register(0), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListSnapshot(result = register(16), value = register(0), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListConcat(result = register(14), left = register(0), right = register(8), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListLength(result = register(4), value = register(0))),
        at(InstructionForm.ListIterationBegin(result = register(15), value = register(0))),
        at(InstructionForm.ListIterationEnd(value = register(0))),
        at(InstructionForm.ListAppendSlot(result = register(2), value = register(0), element_retain = FunctionId(value = 21))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 0))),
        at(InstructionForm.ListMutableElementAddress(result = register(9), value = register(0), index = register(1), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListSlice(result = register(10), value = register(0), start = register(1), end = register(1))),
        at(InstructionForm.SliceLength(result = register(11), value = register(10))),
        at(InstructionForm.SliceElementAddress(result = register(12), value = register(10), index = register(1))),
        at(InstructionForm.ListInsertSlot(result = register(6), value = register(0), index = register(1), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListRemoveAt(value = register(0), index = register(1), element_retain = FunctionId(value = 21))),
        at(InstructionForm.Const(result = register(7), value = MirConstant.UnsignedInt(value = 16))),
        at(InstructionForm.ListReserve(value = register(0), minimum_capacity = register(7), element_retain = FunctionId(value = 21))),
        at(InstructionForm.ListClear(value = register(0), element_release = FunctionId(value = 21))),
        at(InstructionForm.ListElementAddress(result = register(3), value = register(0), index = register(1))),
        at(InstructionForm.Binary(result = register(13), operation = BinaryOp.ne, left = register(0), right = register(8))),
        at(InstructionForm.Const(result = register(5), value = MirConstant.SignedInt(value = 0))),
        at(InstructionForm.Return(values = answer_ops.run([register(5)]))),
    ]))
    return verified(program)

pub func program_with(functions: list[MirFunction]) -> MirProgram:
    let program = create_empty_mir_program()
    for item in functions:
        program.functions.append(item)
    return program

pub func encoded(program: MirProgram) -> list[u8]:
    let artifact = WasmBackend().emit(program) catch reason:
        trap(reason)
    return artifact

pub func assert_bytes(artifact: list[u8], expected: list[u8]):
    assert(len(artifact) == len(expected))
    var index = 0
    while index < len(expected):
        assert(artifact[index] == expected[index])
        index += 1

pub func contains_bytes(artifact: list[u8], needle: list[u8]) -> bool:
    if len(needle) == 0 or len(needle) > len(artifact): return false
    var start = 0
    while start + len(needle) <= len(artifact):
        var matched = true
        var index = 0
        while index < len(needle):
            if artifact[start + index] != needle[index]: matched = false
            index += 1
        if matched: return true
        start += 1
    return false

pub func contains_text(artifact: list[u8], text: str) -> bool:
    return contains_bytes(artifact, strings.to_bytes(text))

# Two i64 constants combined by one operation and returned.
pub func binary_program(operation: BinaryOp, operand: BuiltinMirType) -> MirProgram:
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = 6))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 1))),
        at(InstructionForm.Binary(result = register(2), operation = operation, left = register(0), right = register(1))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    return program_with([function(ops, "main.answer", operand, [scalar(operand), scalar(operand), scalar(operand)], body)])

# mark: Module planning =====================================================================

pub func test_wasm_module_plan_owns_indices_layout_and_static_addresses():
    let program = create_empty_mir_program()
    let i32_type = scalar(BuiltinMirType.signed_i32)
    program.data.append(MirData(name = "first", bytes = [1, 2, 3], align = 1))
    program.data.append(MirData(name = "second", bytes = [4, 5], align = 8))
    program.globals.append(MirGlobal(name = "state", value_type = i32_type, initial = none, is_mutable = true))

    let plan = plan_module(program) catch reason:
        trap(reason)
    assert(plan.layout.pointer_size() == 4)
    assert(len(plan.signatures) == 0 and len(plan.imports) == 0)
    assert(plan.data_offsets[0] == 16 and plan.data_offsets[1] == 24)
    assert(plan.global_offsets[0] == 28 and plan.data_end == 32)
    assert(plan.has_memory and not plan.has_stack and not plan.has_function_table)

pub func test_wasm_plan_rejects_isolated_tasks_at_the_backend_boundary():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let group_type = intern_mir_type(program.types, MirType.TaskGroup)
    program.functions.append(function(ops, "main.answer", BuiltinMirType.signed_i32, [group_type, scalar(BuiltinMirType.signed_i32)], [
        at(InstructionForm.TaskGroupCreate(result = register(0))),
        at(InstructionForm.TaskGroupFinish(group = register(0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 0))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]))
    discard(plan_module(program)) catch reason:
        assert(reason == "wasm backend: isolated tasks are unsupported on WASI preview 1")
        return
    trap("expected WASI task planning to fail")

# mark: Encoding ============================================================================

pub func test_wasm_backend_writes_the_binary_format_directly():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = 7))),
        at(InstructionForm.Return(values = ops.run([register(0)]))),
    ]
    let artifact = encoded(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [scalar(BuiltinMirType.signed_i64)], body)]))
    let expected: list[u8] = [
        0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,     # magic, version 1
        0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7E,           # type: one `() -> i64`
        0x03, 0x02, 0x01, 0x00,                             # function: one function of type 0
        0x07, 0x0F, 0x01, 0x0B,                             # export: one entry, name length 11
        0x6D, 0x61, 0x69, 0x6E, 0x2E, 0x61, 0x6E, 0x73, 0x77, 0x65, 0x72,
        0x00, 0x00,                                         # function kind, index 0
        0x0A, 0x0D, 0x01, 0x0B,                             # code: one body of 11 bytes
        0x01, 0x01, 0x7E,                                   # one run of one i64 local
        0x42, 0x07, 0x21, 0x00,                             # i64.const 7; local.set 0
        0x20, 0x00, 0x0F, 0x0B,                             # local.get 0; return; end
    ]
    assert_bytes(artifact, expected)

pub func test_wasm_backend_reports_exact_encoded_function_body_sizes():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = 7))),
        at(InstructionForm.Return(values = ops.run([register(0)]))),
    ]
    let emission = WasmBackend().emit_with_report(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [scalar(BuiltinMirType.signed_i64)], body)])) catch reason:
        trap(reason)
    assert(len(emission.functions) == 1)
    assert(emission.functions[0].function.value == 0)
    assert(emission.functions[0].code_bytes == 11)
    assert(emission.functions[0].codegen_time_ms == 0)

pub func test_wasm_backend_uses_signed_leb128_for_constants():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = -1))),
        at(InstructionForm.Return(values = ops.run([register(0)]))),
    ]
    let artifact = encoded(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [scalar(BuiltinMirType.signed_i64)], body)]))
    assert(contains_bytes(artifact, [0x42, 0x7F, 0x21, 0x00]))

    let unsigned_body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = u64(18446744073709551615)))),
        at(InstructionForm.Return(values = ops.run([register(0)]))),
    ]
    let unsigned = encoded(program_with([function(ops, "main.maximum", BuiltinMirType.unsigned_u64, [scalar(BuiltinMirType.unsigned_u64)], unsigned_body)]))
    assert(contains_bytes(unsigned, [0x42, 0x7F, 0x21, 0x00]))

pub func test_wasm_backend_declares_locals_as_runs_per_value_type():
    let ops = OperandBuilder()
    let registers = [scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i32), scalar(BuiltinMirType.pointer)]
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 3))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    let artifact = encoded(program_with([function(ops, "main.answer", BuiltinMirType.signed_i32, registers, body)]))
    # Two runs: two i64 locals, then two i32 locals (i32 and ptr share a type).
    assert(contains_bytes(artifact, [0x02, 0x02, 0x7E, 0x02, 0x7F]))

# mark: Checked arithmetic ==================================================================

pub func test_wasm_backend_checks_i64_add_for_overflow():
    let ops = OperandBuilder()
    let artifact = encoded(binary_program(BinaryOp.add, BuiltinMirType.signed_i64))
    let expected: list[u8] = [
        0x20, 0x00, 0x20, 0x01, 0x7C, 0x21, 0x02,           # r2 = a + b
        0x20, 0x00, 0x20, 0x02, 0x85,                       # a ^ r
        0x20, 0x01, 0x20, 0x02, 0x85,                       # b ^ r
        0x83, 0x42, 0x00, 0x53,                             # and; < 0
        0x04, 0x40, 0x00, 0x0B,                             # if unreachable end
    ]
    assert(contains_bytes(artifact, expected))

pub func test_wasm_backend_checks_i64_sub_for_overflow():
    let ops = OperandBuilder()
    let artifact = encoded(binary_program(BinaryOp.sub, BuiltinMirType.signed_i64))
    let expected: list[u8] = [
        0x20, 0x00, 0x20, 0x01, 0x7D, 0x21, 0x02,           # r2 = a - b
        0x20, 0x00, 0x20, 0x01, 0x85,                       # a ^ b
        0x20, 0x00, 0x20, 0x02, 0x85,                       # a ^ r
        0x83, 0x42, 0x00, 0x53,                             # and; < 0
        0x04, 0x40, 0x00, 0x0B,                             # if unreachable end
    ]
    assert(contains_bytes(artifact, expected))

pub func test_wasm_backend_checks_i32_mul_for_overflow():
    let ops = OperandBuilder()
    let artifact = encoded(binary_program(BinaryOp.mul, BuiltinMirType.signed_i32))
    let expected: list[u8] = [
        0x20, 0x00, 0x20, 0x01, 0x6C, 0x21, 0x02,           # r2 = a * b
        0x02, 0x40,                                         # block
        0x20, 0x01, 0x45, 0x0D, 0x00,                       # b == 0 -> skip the checks
        0x20, 0x02, 0x20, 0x01, 0x6D, 0x20, 0x00, 0x47,     # r / b != a
        0x04, 0x40, 0x00, 0x0B,                             # if unreachable end
        0x20, 0x00, 0x41, 0x7F, 0x46,                       # a == -1
        0x20, 0x01, 0x41, 0x80, 0x80, 0x80, 0x80, 0x78, 0x46,   # b == i32 minimum
        0x71, 0x04, 0x40, 0x00, 0x0B,                       # and; if unreachable end
        0x0B,                                               # end block
    ]
    assert(contains_bytes(artifact, expected))
    # The i32 signature and i32 locals come through as well.
    assert(contains_bytes(artifact, [0x60, 0x00, 0x01, 0x7F]))

pub func test_wasm_backend_checks_i64_mul_with_the_i64_minimum():
    let ops = OperandBuilder()
    let artifact = encoded(binary_program(BinaryOp.mul, BuiltinMirType.signed_i64))
    assert(contains_bytes(artifact, [0x7E, 0x21, 0x02, 0x02, 0x40, 0x20, 0x01, 0x50, 0x0D, 0x00]))
    # -9223372036854775808 in signed LEB128 is nine 0x80 bytes then 0x7F.
    assert(contains_bytes(artifact, [0x42, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7F, 0x51]))

# mark: Legalization ========================================================================

pub func test_wasm_backend_legalizes_write_to_wasi_fd_write():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let write = find_runtime_symbol("luce_rt_write") else trap("no write symbol")
    program.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = write.signature))
    program.data.append(MirData(name = "text0", bytes = strings.to_bytes("Hi\n"), align = 1))
    let body: list[MirInstruction] = [
        at(InstructionForm.DataAddress(result = register(0), data = DataId(value = 0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 3))),
        at(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run([register(0), register(1)]))),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 0))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    let registers = [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i32)]
    program.functions.append(function(ops, "hello.main", BuiltinMirType.signed_i32, registers, body))
    let artifact = encoded(program)

    # Type 0 is fd_write `(i32, i32, i32, i32) -> i32`, type 1 is `() -> i32`.
    assert(contains_bytes(artifact, [0x01, 0x0D, 0x02, 0x60, 0x04, 0x7F, 0x7F, 0x7F, 0x7F, 0x01, 0x7F, 0x60, 0x00, 0x01, 0x7F]))
    # import: module "wasi_snapshot_preview1", field "fd_write", function of type 0
    assert(contains_text(artifact, "wasi_snapshot_preview1"))
    assert(contains_bytes(artifact, [0x08, 0x66, 0x64, 0x5F, 0x77, 0x72, 0x69, 0x74, 0x65, 0x00, 0x00]))
    # function section: one defined function of type 1; memory: one page
    assert(contains_bytes(artifact, [0x03, 0x02, 0x01, 0x01, 0x05, 0x03, 0x01, 0x00, 0x01]))
    # exports: the function at index 1 (the import is index 0) and `memory`
    assert(contains_text(artifact, "hello.main"))
    assert(contains_bytes(artifact, [0x6E, 0x00, 0x01]))
    assert(contains_bytes(artifact, [0x06, 0x6D, 0x65, 0x6D, 0x6F, 0x72, 0x79, 0x02, 0x00]))
    # data lands after the 16-byte scratch: i32.const 16 -> r0; i64.const 3 -> r1
    assert(contains_bytes(artifact, [0x41, 0x10, 0x21, 0x00, 0x42, 0x03, 0x21, 0x01]))
    # the write: store ptr at 0, store wrapped len at 4, fd_write(1, 0, 1, 8), drop
    let write_sequence: list[u8] = [
        0x41, 0x00, 0x20, 0x00, 0x36, 0x02, 0x00,           # i32.const 0; local.get 0; i32.store
        0x41, 0x04, 0x20, 0x01, 0xA7, 0x36, 0x02, 0x00,     # i32.const 4; local.get 1; wrap; i32.store
        0x41, 0x01, 0x41, 0x00, 0x41, 0x01, 0x41, 0x08,     # fd 1, iovs 0, iovs_len 1, nwritten 8
        0x10, 0x00, 0x1A,                                   # call 0; drop
    ]
    assert(contains_bytes(artifact, write_sequence))
    # data: one active segment at offset 16 holding "Hi\n"
    assert(contains_bytes(artifact, [0x0B, 0x09, 0x01, 0x00, 0x41, 0x10, 0x0B, 0x03, 0x48, 0x69, 0x0A]))

pub func test_wasm_backend_reports_dynamic_traps_to_stderr_then_unreachable():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let runtime_write = find_runtime_symbol("luce_rt_write") else trap("no write symbol")
    let runtime_trap = find_runtime_symbol("luce_rt_trap") else trap("no trap symbol")
    program.externs.append(MirExtern(name = "luce_rt_write", convention = CallingConvention.runtime, signature = runtime_write.signature))
    program.externs.append(MirExtern(name = "luce_rt_trap", convention = CallingConvention.runtime, signature = runtime_trap.signature))
    program.data.append(MirData(name = "reason", bytes = strings.to_bytes("broken"), align = 1))
    let body: list[MirInstruction] = [
        at(InstructionForm.DataAddress(result = register(0), data = DataId(value = 0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 6))),
        at(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 1), arguments = ops.run([register(0), register(1)]))),
        at(InstructionForm.Unreachable),
    ]
    program.functions.append(function(ops, "main.fail", BuiltinMirType.signed_i32, [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.unsigned_u64)], body))
    let plan = plan_module(program) catch reason:
        trap(reason)
    assert(len(plan.imports) == 1)
    assert(plan.external_imports[0] == 0 and plan.external_imports[1] == 0)
    let artifact = encoded(program)
    let trap_sequence: list[u8] = [
        0x41, 0x00, 0x20, 0x00, 0x36, 0x02, 0x00,
        0x41, 0x04, 0x20, 0x01, 0xA7, 0x36, 0x02, 0x00,
        0x41, 0x02, 0x41, 0x00, 0x41, 0x01, 0x41, 0x08,
        0x10, 0x00, 0x1A,
    ]
    assert(contains_bytes(artifact, trap_sequence))
    let newline_sequence: list[u8] = [
        0x41, 0x0C, 0x41, 0x0A, 0x3A, 0x00, 0x00,
        0x41, 0x00, 0x41, 0x0C, 0x36, 0x02, 0x00,
        0x41, 0x04, 0x41, 0x01, 0x36, 0x02, 0x00,
        0x41, 0x02, 0x41, 0x00, 0x41, 0x01, 0x41, 0x08,
        0x10, 0x00, 0x1A, 0x00,
    ]
    assert(contains_bytes(artifact, newline_sequence))

pub func test_wasm_backend_materializes_process_arguments_before_start():
    let program = lower_executable("pub func main(arguments: slice[str]) -> i32!: return i32(arguments.length)\n")
    let plan = plan_module(program) catch reason:
        trap(reason)
    assert(plan.args_sizes_get_import >= 0)
    assert(plan.args_get_import == plan.args_sizes_get_import + 1)
    assert(plan.proc_exit_import == plan.args_get_import + 1)
    assert(plan.imports[plan.args_sizes_get_import].field_name == "args_sizes_get")
    assert(plan.imports[plan.args_get_import].field_name == "args_get")
    assert(plan.imports[plan.proc_exit_import].field_name == "proc_exit")
    assert(plan.has_memory and plan.has_stack and plan.has_function_table)
    let artifact = encoded(program)
    assert(contains_text(artifact, "args_sizes_get"))
    assert(contains_text(artifact, "args_get"))
    assert(contains_text(artifact, "proc_exit"))
    assert(contains_text(artifact, "_start"))

pub func test_wasm_backend_packs_data_items_at_their_alignment():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.data.append(MirData(name = "a", bytes = [0x01, 0x02, 0x03], align = 1))
    program.data.append(MirData(name = "b", bytes = [0x04], align = 8))
    let body: list[MirInstruction] = [
        at(InstructionForm.DataAddress(result = register(0), data = DataId(value = 1))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 0))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]
    program.functions.append(function(ops, "main.answer", BuiltinMirType.signed_i32, [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.signed_i32)], body))
    let artifact = encoded(program)
    # After the 16-byte scratch, "a" sits at 16 and "b" rounds up to 24, both
    # at the address and in its segment.
    assert(contains_bytes(artifact, [0x41, 0x18, 0x21, 0x00]))
    assert(contains_bytes(artifact, [0x00, 0x41, 0x18, 0x0B, 0x01, 0x04]))

pub func test_wasm_backend_lays_out_and_executes_internal_globals():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let value_type = scalar(BuiltinMirType.unsigned_u64)
    program.data.append(MirData(name = "seed", bytes = [7, 0, 0, 0, 0, 0, 0, 0], align = 8))
    program.globals.append(MirGlobal(name = "runtime.cursor", value_type = value_type, initial = DataId(value = 0), is_mutable = true))
    program.functions.append(function(ops, "main.answer", BuiltinMirType.unsigned_u64, [
        scalar(BuiltinMirType.pointer), value_type, value_type, value_type, value_type,
    ], [
        at(InstructionForm.GlobalAddress(result = register(0), global = GlobalId(value = 0))),
        at(InstructionForm.Load(result = register(1), value_type = value_type, address = register(0))),
        at(InstructionForm.Const(result = register(2), value = MirConstant.UnsignedInt(value = 35))),
        at(InstructionForm.Binary(result = register(3), operation = BinaryOp.add, left = register(1), right = register(2))),
        at(InstructionForm.Store(value_type = value_type, address = register(0), value = register(3))),
        at(InstructionForm.Load(result = register(4), value_type = value_type, address = register(0))),
        at(InstructionForm.Return(values = ops.run([register(4)]))),
    ]))
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let artifact = encoded(program)
    # The seed occupies 16..23; the aligned global follows at address 24.
    # Its initialization is a distinct active segment, preserving value-copy
    # semantics rather than aliasing the immutable seed data.
    assert(contains_bytes(artifact, [0x41, 0x18, 0x21, 0x00]))
    assert(contains_bytes(artifact, [0x00, 0x41, 0x18, 0x0B, 0x08, 7, 0, 0, 0, 0, 0, 0, 0]))
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x03, 0x37, 0x03, 0x00]))
    if wasmtime_available(): assert(run_module(program, "internal_global", "main.answer").output == "42")

pub func test_wasm_backend_refuses_what_it_cannot_encode_yet():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let retain = find_runtime_symbol("luce_rt_retain") else trap("no retain symbol")
    program.externs.append(MirExtern(name = "luce_rt_retain", convention = CallingConvention.runtime, signature = retain.signature))
    let reason = WasmBackend().emit(program) catch failure:
        assert(failure == "wasm backend does not support runtime extern `luce_rt_retain` yet")
        return
    trap("expected the backend to refuse an unsupported extern")

pub func test_wasm_legalizes_typed_storage_at_its_layout_boundary():
    let ordinary = storage_program(2, false, true)
    let artifact = encoded(ordinary)
    # count == 0 selects null; otherwise count is bounded, multiplied by the
    # wasm layout's four-byte i32 stride, and passed with four-byte alignment.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x50, 0x04, 0x40, 0x41, 0x00, 0x21, 0x01, 0x05]))
    assert(contains_bytes(artifact, [0x42, 0x04, 0x7E]))
    assert(contains_bytes(artifact, [0x42, 0x04, 0x10, 0x00, 0x21, 0x01, 0x0B]))
    # The matching positive count reaches the exact bound deallocator.
    assert(contains_bytes(artifact, [0x10, 0x01]))

    let zero_sized = encoded(storage_program(1, true, false))
    assert(contains_bytes(zero_sized, [0x42, 0x01, 0x42, 0x04, 0x10, 0x00]))
    if not wasmtime_available(): return
    assert(run_module(ordinary, "typed_storage", "main.answer").output == "42")
    assert(run_module(storage_program(0, false, false), "empty_storage", "main.answer").output == "0")
    assert(run_module(storage_program(9223372036854775807, false, false), "overflow_storage", "main.answer").status != 0)

pub func test_wasm_legalizes_binary16_values_and_two_byte_storage_at_its_boundary():
    let ops = OperandBuilder()
    let f16_type = scalar(BuiltinMirType.float16)
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let i32_type = scalar(BuiltinMirType.signed_i32)
    let pointer_type = scalar(BuiltinMirType.pointer)
    let slots = [MirSlot(value_type = f16_type)]
    let registers = [pointer_type, f16_type, f16_type, u64_type, i32_type]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        at(InstructionForm.Const(result = register(1), value = MirConstant.Float(value = 0.1))),
        at(InstructionForm.Store(value_type = f16_type, address = register(0), value = register(1))),
        at(InstructionForm.Load(result = register(2), value_type = f16_type, address = register(0))),
        at(InstructionForm.FloatBits(result = register(3), operand = register(2))),
        at(InstructionForm.Convert(result = register(4), operation = ConvertOp.wrap, operand = register(3))),
        at(InstructionForm.Return(values = ops.run([register(4)]))),
    ]
    let function_value = function_with_slots(ops, "main.answer", BuiltinMirType.signed_i32, registers, slots, body)
    let program = verified(program_with([function_value]))
    let artifact = encoded(program)
    assert(contains_bytes(artifact, [0x3B, 0x01, 0x00])) # i32.store16
    assert(contains_bytes(artifact, [0x2F, 0x01, 0x00])) # i32.load16_u
    assert(contains_bytes(artifact, [0xBC]))             # i32.reinterpret_f32
    assert(contains_bytes(artifact, [0xBE]))             # f32.reinterpret_i32
    if wasmtime_available(): assert(run_module(program, "binary16_storage", "main.answer").output == "11878")

    let arithmetic_ops = OperandBuilder()
    let arithmetic_registers = [f16_type, f16_type, f16_type, u64_type, i32_type]
    let arithmetic_body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 0.1))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.Float(value = 0.2))),
        at(InstructionForm.Binary(result = register(2), operation = BinaryOp.add, left = register(0), right = register(1))),
        at(InstructionForm.FloatBits(result = register(3), operand = register(2))),
        at(InstructionForm.Convert(result = register(4), operation = ConvertOp.wrap, operand = register(3))),
        at(InstructionForm.Return(values = arithmetic_ops.run([register(4)]))),
    ]
    let arithmetic = verified(program_with([function(arithmetic_ops, "main.answer", BuiltinMirType.signed_i32, arithmetic_registers, arithmetic_body)]))
    if wasmtime_available(): assert(run_module(arithmetic, "binary16_arithmetic", "main.answer").output == "13516")

    # Direct binary64 narrowing must not demote through binary32. This value
    # sits just above a binary16 midpoint but rounds to the midpoint as f32;
    # a two-step conversion would therefore choose 0x3c00 instead of 0x3c01.
    let direct_ops = OperandBuilder()
    let f64_type = scalar(BuiltinMirType.float64)
    let direct_registers = [f64_type, f16_type, u64_type, i32_type]
    let direct_body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1.0004883110523224))),
        at(InstructionForm.Convert(result = register(1), operation = ConvertOp.float_resize, operand = register(0))),
        at(InstructionForm.FloatBits(result = register(2), operand = register(1))),
        at(InstructionForm.Convert(result = register(3), operation = ConvertOp.wrap, operand = register(2))),
        at(InstructionForm.Return(values = direct_ops.run([register(3)]))),
    ]
    let direct = verified(program_with([function(direct_ops, "main.answer", BuiltinMirType.signed_i32, direct_registers, direct_body)]))
    let direct_artifact = encoded(direct)
    assert(contains_bytes(direct_artifact, [0xBD])) # i64.reinterpret_f64
    if wasmtime_available(): assert(run_module(direct, "binary16_direct_f64", "main.answer").output == "15361")

pub func test_wasm_legalizes_typed_overlapping_moves_at_its_layout_boundary():
    let ordinary = typed_move_program(3)
    let artifact = encoded(ordinary)
    assert(contains_bytes(artifact, [0xFC, 0x0A, 0x00, 0x00]))
    if not wasmtime_available(): return
    assert(run_module(ordinary, "typed_move", "main.answer").output == "2")
    assert(run_module(typed_move_program(4294967296), "overflow_move", "main.answer").status != 0)

pub func test_wasm_interprets_c_symbols_as_env_imports_and_exact_exports():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let i32_type = scalar(BuiltinMirType.signed_i32)
    program.externs.append(MirExtern(
        name = "abs",
        convention = CallingConvention.c,
        signature = MirSignature(parameters = [i32_type], results = [i32_type], is_fallible = false, returns_never = false),
    ))
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = 42))),
        at(InstructionForm.CallExtern(results = ops.run([register(1)]), external = ExternId(value = 0), arguments = ops.run([register(0)]))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]
    program.functions.append(MirFunction(
        name = "luce_answer",
        convention = CallingConvention.c,
        signature = MirSignature(parameters = list[TypeId](), results = [i32_type], is_fallible = false, returns_never = false),
        registers = [i32_type, i32_type],
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    ))
    let artifact = encoded(program)
    assert(contains_text(artifact, "env"))
    assert(contains_text(artifact, "abs"))
    assert(contains_text(artifact, "luce_answer"))

pub func test_wasm_encodes_fixed_c_enum_wrappers_from_shared_canonical_mir():
    let program = lower_executable(
        "export c enum Status as i32:\n"
        + "    running = -2\n"
        + "    complete = 42\n"
        + "export c func echo_status(value: Status) -> Status: return value\n"
        + "pub func main(arguments: slice[str]) -> i32!: return 0i32\n",
    )
    let artifact = encoded(program)
    assert(contains_text(artifact, "echo_status"))

pub func test_wasm_imports_external_globals_as_mutable_typed_env_state():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let i32_type = scalar(BuiltinMirType.signed_i32)
    program.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_type))
    program.functions.append(function(ops, "main.answer", BuiltinMirType.signed_i32, [i32_type, i32_type, i32_type], [
        at(InstructionForm.LoadExternalGlobal(result = register(0), global = ExternalGlobalId(value = 0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 1))),
        at(InstructionForm.Binary(result = register(2), operation = BinaryOp.add, left = register(0), right = register(1))),
        at(InstructionForm.StoreExternalGlobal(global = ExternalGlobalId(value = 0), value = register(2))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]))
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let artifact = encoded(program)
    assert(contains_text(artifact, "env"))
    # name "counter"; global import kind; i32; mutable
    assert(contains_bytes(artifact, [0x07, 0x63, 0x6F, 0x75, 0x6E, 0x74, 0x65, 0x72, 0x03, 0x7F, 0x01]))
    assert(contains_bytes(artifact, [0x23, 0x00, 0x21, 0x00])) # global.get 0; local.set r0
    assert(contains_bytes(artifact, [0x20, 0x02, 0x24, 0x00])) # local.get r2; global.set 0

    # An internal shadow-stack pointer follows imported globals in the
    # independent global index space; it must not alias `counter` at index 0.
    let stacked_ops = OperandBuilder()
    let stacked = create_empty_mir_program()
    stacked.external_globals.append(MirExternalGlobal(name = "counter", value_type = i32_type))
    stacked.functions.append(function_with_slots(stacked_ops, "main.stacked", BuiltinMirType.signed_i32, [scalar(BuiltinMirType.pointer), i32_type], [MirSlot(value_type = i32_type)], [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        at(InstructionForm.LoadExternalGlobal(result = register(1), global = ExternalGlobalId(value = 0))),
        at(InstructionForm.Return(values = stacked_ops.run([register(1)]))),
    ]))
    MirVerifier(stacked).verify() catch reason:
        trap(reason)
    let stacked_artifact = encoded(stacked)
    assert(contains_bytes(stacked_artifact, [0x23, 0x01])) # stack pointer is global 1

# mark: Slice 3a fixtures ===================================================================

# A function with slots as well as registers.
pub func function_with_slots(ops: OperandBuilder, name: str, result: BuiltinMirType, registers: list[TypeId], slots: list[MirSlot], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [scalar(result)], is_fallible = false, returns_never = false),
        registers = registers,
        slots = slots,
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

pub func unit_function(ops: OperandBuilder, name: str, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = list[TypeId](), is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

# Two constants of one type combined by one operation and returned; the
# program is verified so the fixture cannot drift from MIR's rules.
func integer_constant(operand: BuiltinMirType, value: i64) -> MirConstant:
    if operand == BuiltinMirType.unsigned_u8 or operand == BuiltinMirType.unsigned_u16 or operand == BuiltinMirType.unsigned_u32 or operand == BuiltinMirType.unsigned_u64:
        return MirConstant.UnsignedInt(value = u64(value))
    return MirConstant.SignedInt(value = value)

pub func binary_of(operation: BinaryOp, operand: BuiltinMirType, left: i64, right: i64) -> MirProgram:
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = integer_constant(operand, left))),
        at(InstructionForm.Const(result = register(1), value = integer_constant(operand, right))),
        at(InstructionForm.Binary(result = register(2), operation = operation, left = register(0), right = register(1))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    return verified(program_with([function(ops, "main.answer", operand, [scalar(operand), scalar(operand), scalar(operand)], body)]))

# Two constants compared; the result register is `bool`.
pub func comparison_of(operation: BinaryOp, operand: BuiltinMirType, left: i64, right: i64) -> MirProgram:
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = integer_constant(operand, left))),
        at(InstructionForm.Const(result = register(1), value = integer_constant(operand, right))),
        at(InstructionForm.Binary(result = register(2), operation = operation, left = register(0), right = register(1))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    return verified(program_with([function(ops, "main.answer", BuiltinMirType.boolean, [scalar(operand), scalar(operand), scalar(BuiltinMirType.boolean)], body)]))

func checked_full_u64(operation: BinaryOp, left: u64, right: u64, expected: u64) -> MirProgram:
    let ops = OperandBuilder()
    let u64_type = scalar(BuiltinMirType.unsigned_u64)
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = left))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = right))),
        at(InstructionForm.Binary(result = register(2), operation = operation, left = register(0), right = register(1))),
        at(InstructionForm.Const(result = register(3), value = MirConstant.UnsignedInt(value = expected))),
        at(InstructionForm.Binary(result = register(4), operation = BinaryOp.eq, left = register(2), right = register(3))),
        at(InstructionForm.Return(values = ops.run([register(4)]))),
    ]
    return verified(program_with([function(ops, "main.answer", BuiltinMirType.boolean, [u64_type, u64_type, u64_type, u64_type, scalar(BuiltinMirType.boolean)], body)]))

pub func verified(program: MirProgram) -> MirProgram:
    MirVerifier(program).verify() catch reason:
        trap(reason)
    return program

# mark: Slice 3a encoding ===================================================================

pub func test_wasm_backend_range_checks_narrow_arithmetic():
    let ops = OperandBuilder()
    let artifact = encoded(binary_of(BinaryOp.add, BuiltinMirType.signed_i8, 100, 27))
    let expected: list[u8] = [
        0x20, 0x00, 0x20, 0x01, 0x6A, 0x21, 0x02,           # r2 = a + b in i32
        0x20, 0x02, 0x41, 0x80, 0x7F, 0x48,                 # r2 < -128
        0x04, 0x40, 0x00, 0x0B,                             # if unreachable end
        0x20, 0x02, 0x41, 0xFF, 0x00, 0x4A,                 # r2 > 127
        0x04, 0x40, 0x00, 0x0B,
    ]
    assert(contains_bytes(artifact, expected))
    # u16 bounds are 0 and 65535.
    let unsigned = encoded(binary_of(BinaryOp.mul, BuiltinMirType.unsigned_u16, 3, 4))
    assert(contains_bytes(unsigned, [0x6C, 0x21, 0x02, 0x20, 0x02, 0x41, 0x00, 0x48]))
    assert(contains_bytes(unsigned, [0x20, 0x02, 0x41, 0xFF, 0xFF, 0x03, 0x4A]))

pub func test_wasm_backend_computes_u32_arithmetic_in_i64():
    let ops = OperandBuilder()
    let artifact = encoded(binary_of(BinaryOp.add, BuiltinMirType.unsigned_u32, 1, 2))
    let expected: list[u8] = [
        0x20, 0x00, 0xAD, 0x20, 0x01, 0xAD, 0x7C,           # extend_u both; i64.add
        0xA7, 0x21, 0x02,                                   # wrap; r2
        0x20, 0x00, 0xAD, 0x20, 0x01, 0xAD, 0x7C,           # the i64 sum again
        0x42, 0xFF, 0xFF, 0xFF, 0xFF, 0x0F, 0x56,           # > 0xFFFFFFFF (unsigned)
        0x04, 0x40, 0x00, 0x0B,
    ]
    assert(contains_bytes(artifact, expected))
    # A u32 constant above the i32 maximum is written as its 32-bit pattern.
    let high = encoded(binary_of(BinaryOp.sub, BuiltinMirType.unsigned_u32, 4294967295, 1))
    assert(contains_bytes(high, [0x41, 0x7F, 0x21, 0x00]))

pub func test_wasm_backend_checks_full_width_unsigned_borrow():
    let ops = OperandBuilder()
    let artifact = encoded(binary_of(BinaryOp.sub, BuiltinMirType.unsigned_u64, 1, 2))
    # `left <_u right` detects borrow; the result's sign bit is irrelevant.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x01, 0x54, 0x04, 0x40, 0x00, 0x0B]))

pub func test_wasm_backend_floors_signed_division():
    let ops = OperandBuilder()
    let artifact = encoded(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i64, 7, -2))
    let expected: list[u8] = [
        0x20, 0x00, 0x20, 0x01, 0x7F,                       # a / b (div_s)
        0x20, 0x00, 0x20, 0x01, 0x81, 0x42, 0x00, 0x52,     # (a % b) != 0
        0x20, 0x00, 0x20, 0x01, 0x85, 0x42, 0x00, 0x53,     # (a ^ b) < 0
        0x71, 0xAD, 0x7D, 0x21, 0x02,                       # and; extend; q - adjust
    ]
    assert(contains_bytes(artifact, expected))
    let remainder = encoded(binary_of(BinaryOp.rem, BuiltinMirType.signed_i32, 7, -2))
    # r = a rem_s b; r + (b & (0 - adjust))
    assert(contains_bytes(remainder, [0x20, 0x00, 0x20, 0x01, 0x6F, 0x21, 0x02, 0x20, 0x02, 0x20, 0x01, 0x41, 0x00]))
    assert(contains_bytes(remainder, [0x71, 0x6B, 0x71, 0x6A, 0x21, 0x02]))
    # Unsigned division needs no adjustment.
    let unsigned = encoded(binary_of(BinaryOp.floor_div, BuiltinMirType.unsigned_u8, 7, 2))
    assert(contains_bytes(unsigned, [0x20, 0x00, 0x20, 0x01, 0x6E, 0x21, 0x02, 0x20, 0x02, 0x0F]))

pub func test_wasm_backend_traps_shift_counts_and_recanonicalises():
    let ops = OperandBuilder()
    let artifact = encoded(binary_of(BinaryOp.shift_left, BuiltinMirType.signed_i16, 1, 3))
    let expected: list[u8] = [
        0x20, 0x01, 0x41, 0x10, 0x4F, 0x04, 0x40, 0x00, 0x0B,   # count >= 16 (unsigned) -> trap
        0x20, 0x00, 0x20, 0x01, 0x74, 0xC1, 0x21, 0x02,         # shl; extend16_s; r2
    ]
    assert(contains_bytes(artifact, expected))
    let unsigned = encoded(binary_of(BinaryOp.shift_left, BuiltinMirType.unsigned_u8, 1, 3))
    assert(contains_bytes(unsigned, [0x74, 0x41, 0xFF, 0x01, 0x71, 0x21, 0x02]))
    let logical = encoded(binary_of(BinaryOp.shift_right, BuiltinMirType.unsigned_u64, 8, 1))
    assert(contains_bytes(logical, [0x20, 0x01, 0x42, 0xC0, 0x00, 0x5A, 0x04, 0x40, 0x00, 0x0B, 0x20, 0x00, 0x20, 0x01, 0x88]))
    let arithmetic = encoded(binary_of(BinaryOp.shift_right, BuiltinMirType.signed_i32, -8, 1))
    assert(contains_bytes(arithmetic, [0x20, 0x00, 0x20, 0x01, 0x75, 0x21, 0x02]))

pub func test_wasm_backend_picks_comparison_signedness_and_float_opcodes():
    let ops = OperandBuilder()
    assert(contains_bytes(encoded(comparison_of(BinaryOp.lt, BuiltinMirType.unsigned_u32, 1, 2)), [0x20, 0x00, 0x20, 0x01, 0x49, 0x21, 0x02]))
    assert(contains_bytes(encoded(comparison_of(BinaryOp.ge, BuiltinMirType.signed_i64, 1, 2)), [0x20, 0x00, 0x20, 0x01, 0x59, 0x21, 0x02]))
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1.75))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.Float(value = -0.5))),
        at(InstructionForm.Binary(result = register(2), operation = BinaryOp.div, left = register(0), right = register(1))),
        at(InstructionForm.Binary(result = register(3), operation = BinaryOp.lt, left = register(2), right = register(0))),
        at(InstructionForm.Return(values = ops.run([register(3)]))),
    ]
    let registers = [scalar(BuiltinMirType.float64), scalar(BuiltinMirType.float64), scalar(BuiltinMirType.float64), scalar(BuiltinMirType.boolean)]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.boolean, registers, body)])))
    # 1.75 is 0x3FFC000000000000; -0.5 is 0xBFE0000000000000.
    assert(contains_bytes(artifact, [0x44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFC, 0x3F, 0x21, 0x00]))
    assert(contains_bytes(artifact, [0x44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xE0, 0xBF, 0x21, 0x01]))
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x01, 0xA3, 0x21, 0x02, 0x20, 0x02, 0x20, 0x00, 0x63, 0x21, 0x03]))
    # f32 1.5 is 0x3FC00000; 0.1 rounds to 0x3DCCCCCD.
    let narrow: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1.5))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.Float(value = 0.1))),
        at(InstructionForm.Binary(result = register(2), operation = BinaryOp.mul, left = register(0), right = register(1))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    let single = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.float32, [scalar(BuiltinMirType.float32), scalar(BuiltinMirType.float32), scalar(BuiltinMirType.float32)], narrow)])))
    assert(contains_bytes(single, [0x43, 0x00, 0x00, 0xC0, 0x3F, 0x21, 0x00, 0x43, 0xCD, 0xCC, 0xCC, 0x3D, 0x21, 0x01, 0x20, 0x00, 0x20, 0x01, 0x94]))

pub func test_wasm_float_constants_cover_zero_subnormal_and_finite_boundaries():
    let negative64_ops = OperandBuilder()
    let minimum64_ops = OperandBuilder()
    let maximum64_ops = OperandBuilder()
    let negative32_ops = OperandBuilder()
    let minimum32_ops = OperandBuilder()
    let maximum32_ops = OperandBuilder()
    let functions = [
        function(negative64_ops, "negative64", BuiltinMirType.float64, [scalar(BuiltinMirType.float64)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = -0.0))),
            at(InstructionForm.Return(values = negative64_ops.run([register(0)]))),
        ]),
        function(minimum64_ops, "minimum64", BuiltinMirType.float64, [scalar(BuiltinMirType.float64)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 5e-324))),
            at(InstructionForm.Return(values = minimum64_ops.run([register(0)]))),
        ]),
        function(maximum64_ops, "maximum64", BuiltinMirType.float64, [scalar(BuiltinMirType.float64)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1.7976931348623157e308))),
            at(InstructionForm.Return(values = maximum64_ops.run([register(0)]))),
        ]),
        function(negative32_ops, "negative32", BuiltinMirType.float32, [scalar(BuiltinMirType.float32)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = -0.0))),
            at(InstructionForm.Return(values = negative32_ops.run([register(0)]))),
        ]),
        function(minimum32_ops, "minimum32", BuiltinMirType.float32, [scalar(BuiltinMirType.float32)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1e-45))),
            at(InstructionForm.Return(values = minimum32_ops.run([register(0)]))),
        ]),
        function(maximum32_ops, "maximum32", BuiltinMirType.float32, [scalar(BuiltinMirType.float32)], [
            at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 3.4028234663852886e38))),
            at(InstructionForm.Return(values = maximum32_ops.run([register(0)]))),
        ]),
    ]
    let artifact = encoded(verified(program_with(functions)))
    assert(contains_bytes(artifact, [0x44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80]))
    assert(contains_bytes(artifact, [0x44, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]))
    assert(contains_bytes(artifact, [0x44, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xEF, 0x7F]))
    assert(contains_bytes(artifact, [0x43, 0x00, 0x00, 0x00, 0x80]))
    assert(contains_bytes(artifact, [0x43, 0x01, 0x00, 0x00, 0x00]))
    assert(contains_bytes(artifact, [0x43, 0xFF, 0xFF, 0x7F, 0x7F]))

pub func test_wasm_backend_encodes_unary_operations():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = 5))),
        at(InstructionForm.Unary(result = register(1), operation = UnaryOp.neg, operand = register(0))),
        at(InstructionForm.Unary(result = register(2), operation = UnaryOp.bit_not, operand = register(1))),
        at(InstructionForm.Const(result = register(3), value = MirConstant.Bool(value = true))),
        at(InstructionForm.Unary(result = register(4), operation = UnaryOp.bool_not, operand = register(3))),
        at(InstructionForm.Return(values = ops.run([register(2)]))),
    ]
    let registers = [scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.boolean), scalar(BuiltinMirType.boolean)]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, registers, body)])))
    # neg: trap on the minimum, then 0 - x
    assert(contains_bytes(artifact, [0x20, 0x00, 0x42, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7F, 0x51, 0x04, 0x40, 0x00, 0x0B, 0x42, 0x00, 0x20, 0x00, 0x7D, 0x21, 0x01]))
    assert(contains_bytes(artifact, [0x20, 0x01, 0x42, 0x7F, 0x85, 0x21, 0x02]))        # bit_not: x ^ -1
    assert(contains_bytes(artifact, [0x20, 0x03, 0x45, 0x21, 0x04]))                    # bool_not: eqz
    # A narrow unsigned bit_not flips only its own bits.
    let narrow: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.UnsignedInt(value = 5))),
        at(InstructionForm.Unary(result = register(1), operation = UnaryOp.bit_not, operand = register(0))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]
    let unsigned = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.unsigned_u8, [scalar(BuiltinMirType.unsigned_u8), scalar(BuiltinMirType.unsigned_u8)], narrow)])))
    assert(contains_bytes(unsigned, [0x20, 0x00, 0x41, 0xFF, 0x01, 0x73, 0x21, 0x01]))

pub func test_wasm_backend_encodes_conversions():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = -3))),
        at(InstructionForm.Convert(result = register(1), operation = ConvertOp.extend, operand = register(0))),
        at(InstructionForm.Convert(result = register(2), operation = ConvertOp.wrap, operand = register(1))),
        at(InstructionForm.Convert(result = register(3), operation = ConvertOp.int_to_float, operand = register(1))),
        at(InstructionForm.Convert(result = register(4), operation = ConvertOp.float_to_int, operand = register(3))),
        at(InstructionForm.Return(values = ops.run([register(4)]))),
    ]
    let registers = [scalar(BuiltinMirType.signed_i8), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i16), scalar(BuiltinMirType.float64), scalar(BuiltinMirType.signed_i8)]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i8, registers, body)])))
    assert(contains_bytes(artifact, [0x20, 0x00, 0xAC, 0x21, 0x01]))                    # extend i8 -> i64: extend_i32_s
    assert(contains_bytes(artifact, [0x20, 0x01, 0xA7, 0xC1, 0x21, 0x02]))              # wrap i64 -> i16: wrap; extend16_s
    assert(contains_bytes(artifact, [0x20, 0x01, 0xB9, 0x21, 0x03]))                    # i64 -> f64: convert_i64_s
    assert(contains_bytes(artifact, [0x20, 0x03, 0xAA, 0x21, 0x04, 0x20, 0x04, 0x41, 0x80, 0x7F, 0x48]))   # trunc_f64_s then i8 range test

    let resize_ops = OperandBuilder()
    let resize_body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 0.1))),
        at(InstructionForm.Convert(result = register(1), operation = ConvertOp.float_resize, operand = register(0))),
        at(InstructionForm.Convert(result = register(2), operation = ConvertOp.float_resize, operand = register(1))),
        at(InstructionForm.Return(values = resize_ops.run([register(2)]))),
    ]
    let resize_registers = [scalar(BuiltinMirType.float64), scalar(BuiltinMirType.float32), scalar(BuiltinMirType.float64)]
    let resized = encoded(verified(program_with([function(resize_ops, "main.resize", BuiltinMirType.float64, resize_registers, resize_body)])))
    assert(contains_bytes(resized, [0x20, 0x00, 0xB6, 0x21, 0x01])) # f32.demote_f64
    assert(contains_bytes(resized, [0x20, 0x01, 0xBB, 0x21, 0x02])) # f64.promote_f32

pub func test_wasm_backend_gives_slots_a_shadow_stack_frame():
    let ops = OperandBuilder()
    let slots = [MirSlot(value_type = scalar(BuiltinMirType.signed_i8)), MirSlot(value_type = scalar(BuiltinMirType.signed_i64))]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        at(InstructionForm.Alloca(result = register(1), slot = 1)),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = -3))),
        at(InstructionForm.Store(value_type = scalar(BuiltinMirType.signed_i8), address = register(0), value = register(2))),
        at(InstructionForm.Const(result = register(3), value = MirConstant.SignedInt(value = 70000))),
        at(InstructionForm.Store(value_type = scalar(BuiltinMirType.signed_i64), address = register(1), value = register(3))),
        at(InstructionForm.Load(result = register(4), value_type = scalar(BuiltinMirType.signed_i8), address = register(0))),
        at(InstructionForm.Return(values = ops.run([register(4)]))),
    ]
    let registers = [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.signed_i8), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i8)]
    let artifact = encoded(verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i8, registers, slots, body)])))
    # A global section: one mutable i32 initialised to the top of sixteen
    # pages (1048576); the memory declares those pages; memory exported.
    assert(contains_bytes(artifact, [0x06, 0x09, 0x01, 0x7F, 0x01, 0x41, 0x80, 0x80, 0xC0, 0x00, 0x0B]))
    assert(contains_bytes(artifact, [0x05, 0x03, 0x01, 0x00, 0x10]))
    assert(contains_bytes(artifact, [0x06, 0x6D, 0x65, 0x6D, 0x6F, 0x72, 0x79, 0x02, 0x00]))
    # Locals: i32 x3 (r0, r1, r2), i64 (r3), i32 x2 (r4 and the frame pointer r5).
    assert(contains_bytes(artifact, [0x03, 0x03, 0x7F, 0x01, 0x7E, 0x02, 0x7F]))
    # Prologue: the i64 slot sits at offset 8, so the frame is 16 bytes.
    assert(contains_bytes(artifact, [0x23, 0x00, 0x41, 0x10, 0x6B, 0x22, 0x05, 0x24, 0x00]))
    assert(contains_bytes(artifact, [0x20, 0x05, 0x41, 0x00, 0x6A, 0x21, 0x00, 0x20, 0x05, 0x41, 0x08, 0x6A, 0x21, 0x01]))
    # store8 / store i64 / load8_s, and the epilogue before `return`.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x02, 0x3A, 0x00, 0x00]))
    assert(contains_bytes(artifact, [0x20, 0x01, 0x20, 0x03, 0x37, 0x03, 0x00]))
    assert(contains_bytes(artifact, [0x20, 0x00, 0x2C, 0x00, 0x00, 0x21, 0x04]))
    assert(contains_bytes(artifact, [0x20, 0x05, 0x41, 0x10, 0x6A, 0x24, 0x00, 0x20, 0x04, 0x0F, 0x0B]))

pub func test_wasm_backend_gives_zero_size_slots_an_address_local():
    let program = create_empty_mir_program()
    let array_type = intern_mir_type(program.types, MirType.Array(element = scalar(BuiltinMirType.signed_i64), count = 0))
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 0))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]
    program.functions.append(function_with_slots(
        ops,
        "main.empty",
        BuiltinMirType.unsigned_u64,
        [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.unsigned_u64)],
        [MirSlot(value_type = array_type)],
        body,
    ))
    let artifact = encoded(verified(program))
    # r0, r1, then the frame pointer r2. A zero-size frame aliases the
    # current stack pointer but still initializes the local used by Alloca.
    assert(contains_bytes(artifact, [0x03, 0x01, 0x7F, 0x01, 0x7E, 0x01, 0x7F]))
    assert(contains_bytes(artifact, [0x23, 0x00, 0x21, 0x02]))

pub func test_wasm_backend_supplies_the_stable_arena_without_a_host_import():
    let program = arena_program(1048577)
    let plan = plan_module(program) catch reason:
        trap(reason)
    assert(plan.has_runtime_arena)
    assert(plan.has_memory)
    assert(not plan.has_stack)
    assert(len(plan.imports) == 0)
    let artifact = encoded(program)
    assert(not contains_text(artifact, "luce_rt_arena"))
    assert(contains_bytes(artifact, [0x3F, 0x00])) # memory.size 0
    assert(contains_bytes(artifact, [0x40, 0x00])) # memory.grow 0

pub func test_wasm_backend_legalizes_typed_list_handles_only_at_encoding():
    let artifact = encoded(list_program())
    # Every canonical list operation calls its exact composed runtime identity;
    # checked insert/remove/index additionally call length before mutation.
    assert(contains_bytes(artifact, [0x10, 0x00]))
    assert(contains_bytes(artifact, [0x10, 0x01]))
    assert(contains_bytes(artifact, [0x10, 0x02]))
    assert(contains_bytes(artifact, [0x10, 0x03]))
    assert(contains_bytes(artifact, [0x10, 0x04]))
    assert(contains_bytes(artifact, [0x10, 0x05]))
    assert(contains_bytes(artifact, [0x10, 0x06]))
    assert(contains_bytes(artifact, [0x10, 0x07]))
    assert(contains_bytes(artifact, [0x10, 0x08]))
    assert(contains_bytes(artifact, [0x10, 0x09]))
    assert(contains_bytes(artifact, [0x10, 0x0A]))
    assert(contains_bytes(artifact, [0x10, 0x0B]))
    assert(contains_bytes(artifact, [0x10, 0x0C]))
    assert(contains_bytes(artifact, [0x10, 0x0D]))
    # Concatenation passes two handles, backend-local layout, and the exact
    # compiler-generated element-retain function descriptor.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x08, 0x42, 0x04, 0x42, 0x04, 0x41, 0x10, 0x10, 0x0D, 0x21, 0x0E]))
    # Canonical typed handles become i32 locals only inside this backend.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x08, 0x47, 0x21, 0x0D]))

pub func test_wasm_backend_encodes_if_with_results_and_unit_returns():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = true))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 5))),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 7))),
        at(InstructionForm.If(condition = register(0), results = ops.run([register(3)]))),
        at(InstructionForm.Yield(values = ops.run([register(1)]))),
        at(InstructionForm.Else),
        at(InstructionForm.Yield(values = ops.run([register(2)]))),
        at(InstructionForm.End),
        at(InstructionForm.Return(values = ops.run([register(3)]))),
    ]
    let registers = [scalar(BuiltinMirType.boolean), scalar(BuiltinMirType.signed_i32), scalar(BuiltinMirType.signed_i32), scalar(BuiltinMirType.signed_i32)]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i32, registers, body)])))
    assert(contains_bytes(artifact, [0x20, 0x00, 0x04, 0x40, 0x20, 0x01, 0x21, 0x03, 0x05, 0x20, 0x02, 0x21, 0x03, 0x0B, 0x20, 0x03, 0x0F]))
    let unit = encoded(verified(program_with([unit_function(ops, "main.noop", list[TypeId](), [at(InstructionForm.Return(values = no_registers()))])])))
    assert(contains_bytes(unit, [0x60, 0x00, 0x00]))
    assert(contains_bytes(unit, [0x03, 0x00, 0x0F, 0x0B]))

pub func test_wasm_backend_output_for_the_first_slice_is_unchanged():
    let ops = OperandBuilder()
    # No slots, no floats, no narrow types: the same bytes as before this
    # slice, so the earlier exact-module test above still passes.
    let artifact = encoded(binary_program(BinaryOp.add, BuiltinMirType.signed_i64))
    assert(not contains_bytes(artifact, [0x06, 0x08, 0x01, 0x7F, 0x01]))
    assert(not contains_text(artifact, "memory"))

# mark: Execution under wasmtime ============================================================
#
# Host-gated: when `wasmtime` is on the PATH, modules are written to the
# scratch directory and run. The exit status and stdout are read back.

pub struct RunResult:
    pub let status: i64
    pub let output: str

pub func wasmtime_available() -> bool:
    let process = os.Process("sh -c 'command -v wasmtime >/dev/null 2>&1'") catch reason:
        return false
    let status = process.wait() catch reason:
        return false
    return status == 0

pub func run_module(program: MirProgram, name: str, invoke: str) -> RunResult:
    let scratch = files.make_temporary_directory(".", ".luce-wasm-test-") catch reason:
        trap(reason)
    let module_path = scratch + "/" + name + ".wasm"
    let output_path = scratch + "/" + name + ".out"
    let status_path = scratch + "/" + name + ".status"
    files.write_bytes(module_path, encoded(program)) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let command = "sh -c 'wasmtime run --invoke " + invoke + " " + module_path + " > " + output_path + " 2>/dev/null; echo $? > " + status_path + "'"
    let process = os.Process(command) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let ignored = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status_text = files.read(status_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let result = RunResult(status = parse_status(status_text), output = strings.trim(output))
    files.remove_all(scratch) catch reason:
        trap(reason)
    return result

func parse_status(text: str) -> i64:
    var value = 0
    for c in text:
        if c >= '0' and c <= '9': value = value * 10 + i64(u32(c) - u32('0'))
    return value

pub func test_wasm_modules_trap_on_narrow_and_unsigned_overflow():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    assert(run_module(binary_of(BinaryOp.add, BuiltinMirType.signed_i8, 127, 1), "i8_overflow", "main.answer").status != 0)
    assert(run_module(binary_of(BinaryOp.add, BuiltinMirType.signed_i8, 100, 27), "i8_fits", "main.answer").output == "127")
    assert(run_module(binary_of(BinaryOp.add, BuiltinMirType.unsigned_u32, 4294967295, 1), "u32_overflow", "main.answer").status != 0)
    assert(run_module(binary_of(BinaryOp.add, BuiltinMirType.unsigned_u32, 4294967294, 1), "u32_fits", "main.answer").output == "-1")
    assert(run_module(binary_of(BinaryOp.sub, BuiltinMirType.unsigned_u8, 0, 1), "u8_negative", "main.answer").status != 0)
    assert(run_module(binary_of(BinaryOp.mul, BuiltinMirType.unsigned_u16, 65535, 65535), "u16_wide_product", "main.answer").status != 0)
    let maximum = u64(18446744073709551615)
    assert(run_module(checked_full_u64(BinaryOp.add, maximum, u64(1), u64(0)), "u64_add_overflow", "main.answer").status != 0)
    assert(run_module(checked_full_u64(BinaryOp.sub, u64(0), u64(1), maximum), "u64_sub_overflow", "main.answer").status != 0)
    assert(run_module(checked_full_u64(BinaryOp.mul, maximum, u64(1), maximum), "u64_mul_fits", "main.answer").output == "1")
    assert(run_module(checked_full_u64(BinaryOp.mul, maximum, u64(2), maximum - u64(1)), "u64_mul_overflow", "main.answer").status != 0)

pub func test_wasm_modules_grow_the_backend_owned_runtime_arena():
    if not wasmtime_available(): return
    let result = run_module(arena_program(1048577), "runtime_arena", "main.answer")
    assert(result.status == 0)
    assert(result.output == "42")

pub func test_wasm_modules_floor_divide_like_the_language():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    assert(run_module(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i64, 7, -2), "floor_div", "main.answer").output == "-4")
    assert(run_module(binary_of(BinaryOp.rem, BuiltinMirType.signed_i64, 7, -2), "rem", "main.answer").output == "-1")
    assert(run_module(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i32, -7, 2), "floor_div_negative", "main.answer").output == "-4")
    assert(run_module(binary_of(BinaryOp.rem, BuiltinMirType.signed_i32, -7, 2), "rem_negative", "main.answer").output == "1")
    assert(run_module(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i32, 8, 2), "floor_div_exact", "main.answer").output == "4")
    assert(run_module(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i64, 1, 0), "div_zero", "main.answer").status != 0)
    assert(run_module(binary_of(BinaryOp.floor_div, BuiltinMirType.signed_i8, -128, -1), "narrow_min_div", "main.answer").status != 0)

pub func test_wasm_modules_shift_and_compare_like_the_language():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    assert(run_module(binary_of(BinaryOp.shift_left, BuiltinMirType.signed_i16, 16384, 1), "i16_shl", "main.answer").output == "-32768")
    assert(run_module(binary_of(BinaryOp.shift_left, BuiltinMirType.unsigned_u8, 255, 1), "u8_shl", "main.answer").output == "254")
    assert(run_module(binary_of(BinaryOp.shift_right, BuiltinMirType.signed_i32, -8, 1), "i32_shr", "main.answer").output == "-4")
    assert(run_module(binary_of(BinaryOp.shift_left, BuiltinMirType.signed_i32, 1, 32), "shift_too_far", "main.answer").status != 0)
    assert(run_module(comparison_of(BinaryOp.lt, BuiltinMirType.unsigned_u32, 4294967295, 1), "u32_lt", "main.answer").output == "0")
    assert(run_module(comparison_of(BinaryOp.gt, BuiltinMirType.unsigned_u32, 4294967295, 1), "u32_gt", "main.answer").output == "1")

pub func test_wasm_modules_run_slots_and_conditionals():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = scalar(BuiltinMirType.signed_i8)), MirSlot(value_type = scalar(BuiltinMirType.signed_i64))]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        at(InstructionForm.Alloca(result = register(1), slot = 1)),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = -3))),
        at(InstructionForm.Store(value_type = scalar(BuiltinMirType.signed_i8), address = register(0), value = register(2))),
        at(InstructionForm.Const(result = register(3), value = MirConstant.SignedInt(value = 70000))),
        at(InstructionForm.Store(value_type = scalar(BuiltinMirType.signed_i64), address = register(1), value = register(3))),
        at(InstructionForm.Load(result = register(4), value_type = scalar(BuiltinMirType.signed_i8), address = register(0))),
        at(InstructionForm.Load(result = register(5), value_type = scalar(BuiltinMirType.signed_i64), address = register(1))),
        at(InstructionForm.Convert(result = register(6), operation = ConvertOp.extend, operand = register(4))),
        at(InstructionForm.Binary(result = register(7), operation = BinaryOp.add, left = register(5), right = register(6))),
        at(InstructionForm.Return(values = ops.run([register(7)]))),
    ]
    let registers = [scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.pointer), scalar(BuiltinMirType.signed_i8), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i8), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i64), scalar(BuiltinMirType.signed_i64)]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, registers, slots, body)]))
    assert(run_module(program, "slots", "main.answer").output == "69997")

    let conditional: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = false))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = 5))),
        at(InstructionForm.Const(result = register(2), value = MirConstant.SignedInt(value = 7))),
        at(InstructionForm.If(condition = register(0), results = ops.run([register(3)]))),
        at(InstructionForm.Yield(values = ops.run([register(1)]))),
        at(InstructionForm.Else),
        at(InstructionForm.Yield(values = ops.run([register(2)]))),
        at(InstructionForm.End),
        at(InstructionForm.Return(values = ops.run([register(3)]))),
    ]
    let choice = verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i32, [scalar(BuiltinMirType.boolean), scalar(BuiltinMirType.signed_i32), scalar(BuiltinMirType.signed_i32), scalar(BuiltinMirType.signed_i32)], conditional)]))
    assert(run_module(choice, "conditional", "main.answer").output == "7")

pub func test_wasm_modules_compute_floats_and_conversions():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 1.75))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.Float(value = -0.5))),
        at(InstructionForm.Binary(result = register(2), operation = BinaryOp.div, left = register(0), right = register(1))),
        at(InstructionForm.Convert(result = register(3), operation = ConvertOp.float_to_int, operand = register(2))),
        at(InstructionForm.Return(values = ops.run([register(3)]))),
    ]
    let registers = [scalar(BuiltinMirType.float64), scalar(BuiltinMirType.float64), scalar(BuiltinMirType.float64), scalar(BuiltinMirType.signed_i64)]
    let program = verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, registers, body)]))
    assert(run_module(program, "floats", "main.answer").output == "-3")
    let big: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Float(value = 300.0))),
        at(InstructionForm.Convert(result = register(1), operation = ConvertOp.float_to_int, operand = register(0))),
        at(InstructionForm.Return(values = ops.run([register(1)]))),
    ]
    let narrow = verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i8, [scalar(BuiltinMirType.float64), scalar(BuiltinMirType.signed_i8)], big)]))
    assert(run_module(narrow, "float_to_i8_overflow", "main.answer").status != 0)

# mark: Slice 3b control flow ===============================================================

func i64_t() -> TypeId:
    return scalar(BuiltinMirType.signed_i64)

func bool_t() -> TypeId:
    return scalar(BuiltinMirType.boolean)

func ptr_t() -> TypeId:
    return scalar(BuiltinMirType.pointer)

func i64_const(result: i64, value: i64) -> MirInstruction:
    return at(InstructionForm.Const(result = register(result), value = MirConstant.SignedInt(value = value)))

func i64_load(result: i64, address: i64) -> MirInstruction:
    return at(InstructionForm.Load(result = register(result), value_type = i64_t(), address = register(address)))

func i64_store(address: i64, value: i64) -> MirInstruction:
    return at(InstructionForm.Store(value_type = i64_t(), address = register(address), value = register(value)))

func binary(result: i64, operation: BinaryOp, left: i64, right: i64) -> MirInstruction:
    return at(InstructionForm.Binary(result = register(result), operation = operation, left = register(left), right = register(right)))

func br(ops: OperandBuilder, depth: i64) -> MirInstruction:
    return at(InstructionForm.Br(depth = depth, values = no_registers()))

func br_if(ops: OperandBuilder, condition: i64, depth: i64) -> MirInstruction:
    return at(InstructionForm.BrIf(condition = register(condition), depth = depth, values = no_registers()))

func block(ops: OperandBuilder) -> MirInstruction:
    return at(InstructionForm.Block(results = no_registers()))

func loop_of() -> MirInstruction:
    return at(InstructionForm.Loop)

func if_then(ops: OperandBuilder, condition: i64) -> MirInstruction:
    return at(InstructionForm.If(condition = register(condition), results = no_registers()))

func else_arm() -> MirInstruction:
    return at(InstructionForm.Else)

func end() -> MirInstruction:
    return at(InstructionForm.End)

func returning(ops: OperandBuilder, value: i64) -> MirInstruction:
    return at(InstructionForm.Return(values = ops.run([register(value)])))

pub func test_wasm_backend_encodes_a_while_as_block_around_loop():
    let ops = OperandBuilder()
    # while true: pass  — `Block Loop cond not BrIf 1 Br 0 End End`
    let body: list[MirInstruction] = [
        block(ops), loop_of(),
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = true))),
        at(InstructionForm.Unary(result = register(1), operation = UnaryOp.bool_not, operand = register(0))),
        br_if(ops, 1, 1),
        br(ops, 0),
        end(), end(),
        i64_const(2, 0),
        returning(ops, 2),
    ]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [bool_t(), bool_t(), i64_t()], body)])))
    assert(contains_bytes(artifact, [
        0x02, 0x40,                         # block
        0x03, 0x40,                         # loop
        0x41, 0x01, 0x21, 0x00,             # r0 = true
        0x20, 0x00, 0x45, 0x21, 0x01,       # r1 = not r0
        0x20, 0x01, 0x0D, 0x01,             # br_if 1 (leave the block)
        0x0C, 0x00,                         # br 0 (restart the loop)
        0x0B, 0x0B,                         # end loop, end block
    ]))

pub func test_wasm_backend_branch_depths_count_if_regions():
    let ops = OperandBuilder()
    # break and continue from inside `if`s: `Br 2` leaves the block through
    # the if and the loop, `Br 1` restarts the loop through the if.
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = true))),
        block(ops), loop_of(),
        if_then(ops, 0), br(ops, 2), end(),
        if_then(ops, 0), br(ops, 1), end(),
        br(ops, 0),
        end(), end(),
        i64_const(1, 0),
        returning(ops, 1),
    ]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [bool_t(), i64_t()], body)])))
    assert(contains_bytes(artifact, [0x20, 0x00, 0x04, 0x40, 0x0C, 0x02, 0x0B]))   # if without else: no 0x05
    assert(contains_bytes(artifact, [0x20, 0x00, 0x04, 0x40, 0x0C, 0x01, 0x0B, 0x0C, 0x00, 0x0B, 0x0B]))

pub func test_wasm_backend_conditional_branch_with_values_sets_then_branches():
    let ops = OperandBuilder()
    # `BrIf(c, 0, [v])` out of a block with a result: the sets happen only
    # when taken, so they sit in an `if`, and the branch depth grows by one.
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = true))),
        i64_const(1, 9),
        i64_const(2, 4),
        at(InstructionForm.Block(results = ops.run([register(3)]))),
        at(InstructionForm.BrIf(condition = register(0), depth = 0, values = ops.run([register(1)]))),
        at(InstructionForm.Yield(values = ops.run([register(2)]))),
        end(),
        returning(ops, 3),
    ]
    let artifact = encoded(verified(program_with([function(ops, "main.answer", BuiltinMirType.signed_i64, [bool_t(), i64_t(), i64_t(), i64_t()], body)])))
    assert(contains_bytes(artifact, [0x02, 0x40, 0x20, 0x00, 0x04, 0x40, 0x20, 0x01, 0x21, 0x03, 0x0C, 0x01, 0x0B, 0x20, 0x02, 0x21, 0x03, 0x0B]))

pub func test_wasm_backend_returns_from_nested_regions_after_restoring_the_frame():
    let ops = OperandBuilder()
    let slots = [MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 11),
        i64_store(0, 1),
        block(ops), loop_of(), block(ops),
        i64_load(2, 0),
        returning(ops, 2),
        end(), end(), end(),
        i64_const(3, 0),
        returning(ops, 3),
    ]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, [ptr_t(), i64_t(), i64_t(), i64_t()], slots, body)]))
    let artifact = encoded(program)
    # epilogue (sp = fp + 16) then `return`, still inside three regions
    assert(contains_bytes(artifact, [0x24, 0x00, 0x20, 0x02, 0x0F, 0x0B, 0x0B, 0x0B]))
    if wasmtime_available():
        assert(run_module(program, "return_nested", "main.answer").output == "11")

# A body whose last instruction is an `If` with returning arms terminates
# for MIR, but wasm needs a value on the stack at the final `end`; the
# backend closes such a body with `unreachable`.
pub func test_wasm_backend_closes_returning_if_arms_with_unreachable():
    let ops = OperandBuilder()
    let body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.Bool(value = true))),
        if_then(ops, 0),
        i64_const(1, 3), returning(ops, 1),
        else_arm(),
        i64_const(2, 4), returning(ops, 2),
        end(),
    ]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, [bool_t(), i64_t(), i64_t()], list[MirSlot](), body)]))
    let artifact = encoded(program)
    # `… return end(else) … return end(if) unreachable end(function)`
    assert(contains_bytes(artifact, [0x0F, 0x0B, 0x00, 0x0B]))
    if wasmtime_available():
        assert(run_module(program, "returning_arms", "main.answer").output == "3")

# sum 1..10 through a hand-built while: `total`, `i` in slots.
pub func test_wasm_modules_run_a_while_loop():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = i64_t()), MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),    # total
        at(InstructionForm.Alloca(result = register(1), slot = 1)),    # i
        i64_const(2, 0), i64_store(0, 2),
        i64_const(3, 1), i64_store(1, 3),
        block(ops), loop_of(),
        i64_load(4, 1), i64_const(5, 10),
        binary(6, BinaryOp.le, 4, 5),
        at(InstructionForm.Unary(result = register(7), operation = UnaryOp.bool_not, operand = register(6))),
        br_if(ops, 7, 1),
        i64_load(8, 0), i64_load(9, 1), binary(10, BinaryOp.add, 8, 9), i64_store(0, 10),
        i64_load(11, 1), i64_const(12, 1), binary(13, BinaryOp.add, 11, 12), i64_store(1, 13),
        br(ops, 0),
        end(), end(),
        i64_load(14, 0),
        returning(ops, 14),
    ]
    let registers = [ptr_t(), ptr_t(), i64_t(), i64_t(), i64_t(), i64_t(), bool_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, registers, slots, body)]))
    assert(run_module(program, "while_sum", "main.answer").output == "55")

# for i in 1..3: for j in 1..3: if j == 2: continue; if j == 3: break; count += 1  -> 3
pub func test_wasm_modules_run_nested_loops_with_break_and_continue():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = i64_t()), MirSlot(value_type = i64_t()), MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),    # i
        at(InstructionForm.Alloca(result = register(1), slot = 1)),    # j
        at(InstructionForm.Alloca(result = register(2), slot = 2)),    # count
        i64_const(27, 0), i64_store(0, 27), i64_store(2, 27),
        block(ops), loop_of(),                                                                     # outer
        i64_load(3, 0), i64_const(4, 3), binary(5, BinaryOp.lt, 3, 4),
        at(InstructionForm.Unary(result = register(6), operation = UnaryOp.bool_not, operand = register(5))),
        br_if(ops, 6, 1),
        i64_const(7, 0), i64_store(1, 7),                                                       # j = 0
        block(ops), loop_of(),                                                                     # inner
        i64_load(8, 1), i64_const(9, 3), binary(10, BinaryOp.le, 8, 9),
        at(InstructionForm.Unary(result = register(11), operation = UnaryOp.bool_not, operand = register(10))),
        br_if(ops, 11, 1),
        i64_load(12, 1), i64_const(13, 1), binary(14, BinaryOp.add, 12, 13), i64_store(1, 14),   # j += 1 first
        i64_load(15, 1), i64_const(16, 2), binary(17, BinaryOp.eq, 15, 16),
        if_then(ops, 17), br(ops, 1), end(),                                                              # continue inner
        i64_load(18, 1), i64_const(19, 3), binary(20, BinaryOp.eq, 18, 19),
        if_then(ops, 20), br(ops, 2), end(),                                                              # break inner
        i64_load(21, 2), i64_const(22, 1), binary(23, BinaryOp.add, 21, 22), i64_store(2, 23),  # count += 1
        br(ops, 0),
        end(), end(),
        i64_load(24, 0), i64_const(25, 1), binary(26, BinaryOp.add, 24, 25), i64_store(0, 26),  # i += 1
        br(ops, 0),
        end(), end(),
        i64_load(28, 2),
        returning(ops, 28),
    ]
    let registers = list[TypeId]()
    for index in range(0, 29): registers.append(i64_t())
    registers[0] = ptr_t()
    registers[1] = ptr_t()
    registers[2] = ptr_t()
    registers[5] = bool_t()
    registers[6] = bool_t()
    registers[10] = bool_t()
    registers[11] = bool_t()
    registers[17] = bool_t()
    registers[20] = bool_t()
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, registers, slots, body)]))
    assert(run_module(program, "nested_loops", "main.answer").output == "3")

# x = 5: if x < 3: 1 elif x < 10: 2 else: 3  -> 2, written with nested Ifs into a slot
pub func test_wasm_modules_run_an_if_elif_else_chain():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 5),
        i64_const(2, 3), binary(3, BinaryOp.lt, 1, 2),
        if_then(ops, 3),
        i64_const(4, 1), i64_store(0, 4),
        else_arm(),
        i64_const(5, 10), binary(6, BinaryOp.lt, 1, 5),
        if_then(ops, 6),
        i64_const(7, 2), i64_store(0, 7),
        else_arm(),
        i64_const(8, 3), i64_store(0, 8),
        end(),
        end(),
        i64_load(9, 0),
        returning(ops, 9),
    ]
    let registers = [ptr_t(), i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t()]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, registers, slots, body)]))
    assert(run_module(program, "if_chain", "main.answer").output == "2")

# while true: i += 1; if i == 7: return i
pub func test_wasm_modules_return_from_inside_a_loop():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 0), i64_store(0, 1),
        block(ops), loop_of(),
        i64_load(2, 0), i64_const(3, 1), binary(4, BinaryOp.add, 2, 3), i64_store(0, 4),
        i64_const(5, 7), binary(6, BinaryOp.eq, 4, 5),
        if_then(ops, 6), returning(ops, 4), end(),
        br(ops, 0),
        end(), end(),
        at(InstructionForm.Unreachable),
    ]
    let registers = [ptr_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), bool_t()]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, registers, slots, body)]))
    assert(run_module(program, "return_in_loop", "main.answer").output == "7")

# mark: Slice 3c calls ======================================================================

func i32_t() -> TypeId:
    return scalar(BuiltinMirType.signed_i32)

# A function with parameters: the parameter registers come first.
pub func function_with_parameters(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], slots: list[MirSlot], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = slots,
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

# A fallible function uses r0 for its caller-owned error slot and returns the
# same pointer after the ordinary value results. Keeping this fixture explicit
# makes tests exercise the calling convention rather than a runtime shortcut.
pub func fallible_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = true, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = SourceSpan(start = 0, end = 0, line = 1, column = 1),
    )

func call(ops: OperandBuilder, results: list[i64], target: i64, arguments: list[i64]) -> MirInstruction:
    let result_registers = list[RegisterId]()
    for item in results: result_registers.append(register(item))
    let argument_registers = list[RegisterId]()
    for item in arguments: argument_registers.append(register(item))
    return at(InstructionForm.Call(results = ops.run(result_registers), function = FunctionId(value = u32(target)), arguments = ops.run(argument_registers)))

# `main.answer() = add(40, 2)` with `add(a: i64, b: i64) -> i64`.
func two_function_program() -> MirProgram:
    let ops = OperandBuilder()
    let add_body: list[MirInstruction] = [
        binary(2, BinaryOp.add, 0, 1),
        returning(ops, 2),
    ]
    let add = function_with_parameters(ops, "main.add", [i64_t(), i64_t()], [i64_t()], [i64_t(), i64_t(), i64_t()], list[MirSlot](), add_body)
    let answer_body: list[MirInstruction] = [
        i64_const(0, 40),
        i64_const(1, 2),
        call(ops, [2], 0, [0, 1]),
        returning(ops, 2),
    ]
    let answer = function(ops, "main.answer", BuiltinMirType.signed_i64, [i64_t(), i64_t(), i64_t()], answer_body)
    return verified(program_with([add, answer]))

pub func test_wasm_backend_encodes_typed_parameters_and_direct_calls():
    let ops = OperandBuilder()
    let artifact = encoded(two_function_program())
    # Two signatures: (i64, i64) -> i64 for `add`, () -> i64 for `answer`.
    assert(contains_bytes(artifact, [0x01, 0x0B, 0x02, 0x60, 0x02, 0x7E, 0x7E, 0x01, 0x7E, 0x60, 0x00, 0x01, 0x7E]))
    # Function section: add is type 0, answer type 1.
    assert(contains_bytes(artifact, [0x03, 0x03, 0x02, 0x00, 0x01]))
    # `add` declares one i64 local (r2); r0 and r1 are its parameters.
    assert(contains_bytes(artifact, [0x01, 0x01, 0x7E, 0x20, 0x00, 0x20, 0x01, 0x7C, 0x21, 0x02]))
    # `answer` pushes r0, r1 and calls function 0 (no imports), then sets r2.
    assert(contains_bytes(artifact, [0x20, 0x00, 0x20, 0x01, 0x10, 0x00, 0x21, 0x02, 0x20, 0x02, 0x0F]))
    if wasmtime_available():
        assert(run_module(two_function_program(), "direct_call", "main.answer").output == "42")

pub func test_wasm_backend_encodes_and_executes_exact_indirect_calls():
    let ops = OperandBuilder()
    let signature = MirSignature(parameters = [i64_t(), i64_t()], results = [i64_t()], is_fallible = false, returns_never = false)
    let callee = function_with_parameters(
        ops,
        "main.add",
        signature.parameters,
        signature.results,
        [i64_t(), i64_t(), i64_t()],
        list[MirSlot](),
        [binary(2, BinaryOp.add, 0, 1), returning(ops, 2)],
    )
    let caller = function(ops, "main.answer", BuiltinMirType.signed_i64, [ptr_t(), i64_t(), i64_t(), i64_t()], [
        at(InstructionForm.FunctionAddress(result = register(0), function = FunctionId(value = 0))),
        i64_const(1, 20),
        i64_const(2, 22),
        at(InstructionForm.CallIndirect(
            results = ops.run([register(3)]),
            signature = signature,
            convention = CallingConvention.luce,
            target = register(0),
            arguments = ops.run([register(1), register(2)]),
        )),
        returning(ops, 3),
    ])
    let program = verified(program_with([callee, caller]))
    let artifact = encoded(program)

    # One two-slot funcref table, initialized in exact FunctionId order.
    assert(contains_bytes(artifact, [0x04, 0x04, 0x01, 0x70, 0x00, 0x02]))
    assert(contains_bytes(artifact, [0x09, 0x08, 0x01, 0x00, 0x41, 0x00, 0x0B, 0x02, 0x00, 0x01]))
    # args, table slot, call_indirect(type 0, table 0), reverse result store.
    assert(contains_bytes(artifact, [0x20, 0x01, 0x20, 0x02, 0x20, 0x00, 0x11, 0x00, 0x00, 0x21, 0x03]))
    if wasmtime_available():
        assert(run_module(program, "indirect_call", "main.answer").output == "42")

pub func test_wasm_backend_maps_c_extern_addresses_after_defined_slots():
    let ops = OperandBuilder()
    let signature = MirSignature(parameters = [i32_t()], results = [i32_t()], is_fallible = false, returns_never = false)
    let program = create_empty_mir_program()
    program.externs.append(MirExtern(name = "abs", convention = CallingConvention.c, signature = signature))
    program.functions.append(function(ops, "main.answer", BuiltinMirType.signed_i32, [ptr_t(), i32_t(), i32_t()], [
        at(InstructionForm.ExternAddress(result = register(0), external = ExternId(value = 0))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.SignedInt(value = -42))),
        at(InstructionForm.CallIndirect(
            results = ops.run([register(2)]),
            signature = signature,
            convention = CallingConvention.c,
            target = register(0),
            arguments = ops.run([register(1)]),
        )),
        returning(ops, 2),
    ]))
    let artifact = encoded(verified(program))

    # Slot 0 is the sole definition and slot 1 is the imported `abs`.
    assert(contains_bytes(artifact, [0x04, 0x04, 0x01, 0x70, 0x00, 0x02]))
    # Function indices are import 0 then definition 1, while table slots are
    # definitions then imports: element vector [1, 0].
    assert(contains_bytes(artifact, [0x09, 0x08, 0x01, 0x00, 0x41, 0x00, 0x0B, 0x02, 0x01, 0x00]))
    assert(contains_bytes(artifact, [0x41, 0x01, 0x21, 0x00]))

func fallible_call_program() -> MirProgram:
    let ops = OperandBuilder()
    # checked(error_out, value): raise code 7 for a negative value, otherwise
    # return twice the value and a null error pointer.
    let checked_body: list[MirInstruction] = [
        i64_const(2, 0),
        binary(3, BinaryOp.lt, 1, 2),
        if_then(ops, 3),
        i64_const(4, 7),
        i64_store(0, 4),
        at(InstructionForm.Raise(failure = register(0))),
        end(),
        i64_const(5, 2),
        binary(6, BinaryOp.mul, 1, 5),
        at(InstructionForm.Const(result = register(7), value = MirConstant.Null)),
        at(InstructionForm.Return(values = ops.run([register(6), register(7)]))),
    ]
    let checked = fallible_function(ops, "main.checked", [ptr_t(), i64_t()], [i64_t(), ptr_t()], [ptr_t(), i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t(), ptr_t()], checked_body)

    # Allocate the error in the caller. The call's value and error results have
    # different wasm types, so assigning the multi-value stack in the wrong
    # order makes the module invalid rather than silently weakening this test.
    let failure_body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, -1),
        call(ops, [2, 3], 0, [0, 1]),
        at(InstructionForm.Const(result = register(4), value = MirConstant.Null)),
        binary(5, BinaryOp.ne, 3, 4),
        at(InstructionForm.If(condition = register(5), results = ops.run([register(7)]))),
        i64_load(6, 3),
        at(InstructionForm.Yield(values = ops.run([register(6)]))),
        else_arm(),
        at(InstructionForm.Yield(values = ops.run([register(2)]))),
        end(),
        returning(ops, 7),
    ]
    let error_slot = [MirSlot(value_type = i64_t())]
    let failure = function_with_parameters(ops, "main.failure", list[TypeId](), [i64_t()], [ptr_t(), i64_t(), i64_t(), ptr_t(), ptr_t(), bool_t(), i64_t(), i64_t()], error_slot, failure_body)

    let success_body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 21),
        call(ops, [2, 3], 0, [0, 1]),
        returning(ops, 2),
    ]
    let success = function_with_parameters(ops, "main.success", list[TypeId](), [i64_t()], [ptr_t(), i64_t(), i64_t(), ptr_t()], error_slot, success_body)
    return verified(program_with([checked, failure, success]))

pub func test_wasm_modules_return_caller_owned_errors_as_data():
    let program = fallible_call_program()
    # Encoding always runs, even on hosts without wasmtime, so unsupported MIR
    # and malformed multi-result code cannot hide behind the host gate.
    let artifact = encoded(program)
    assert(len(artifact) > 0)
    if not wasmtime_available(): return
    assert(run_module(program, "fallible_failure", "main.failure").output == "7")
    assert(run_module(program, "fallible_success", "main.success").output == "42")

pub func test_wasm_backend_guards_the_shadow_stack_against_overflow():
    let ops = OperandBuilder()
    let slots = [MirSlot(value_type = i64_t())]
    let body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 9),
        returning(ops, 1),
    ]
    let program = verified(program_with([function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, [ptr_t(), i64_t()], slots, body)]))
    let artifact = encoded(program)
    # Prologue, then `local.get fp; i32.const 16 (data_end); i32.lt_u; if unreachable end`.
    assert(contains_bytes(artifact, [0x23, 0x00, 0x41, 0x10, 0x6B, 0x22, 0x02, 0x24, 0x00, 0x20, 0x02, 0x41, 0x10, 0x49, 0x04, 0x40, 0x00, 0x0B]))
    # Sixteen pages of memory.
    assert(contains_bytes(artifact, [0x05, 0x03, 0x01, 0x00, 0x10]))

# factorial(n) = n * factorial(n - 1), 1 below 2; answer = factorial(10).
func factorial_program() -> MirProgram:
    let ops = OperandBuilder()
    let factorial_body: list[MirInstruction] = [
        i64_const(1, 2),
        binary(2, BinaryOp.lt, 0, 1),
        if_then(ops, 2),
        i64_const(3, 1), returning(ops, 3),
        end(),
        i64_const(4, 1),
        binary(5, BinaryOp.sub, 0, 4),
        call(ops, [6], 0, [5]),
        binary(7, BinaryOp.mul, 0, 6),
        returning(ops, 7),
    ]
    let registers = [i64_t(), i64_t(), bool_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let factorial = function_with_parameters(ops, "main.factorial", [i64_t()], [i64_t()], registers, list[MirSlot](), factorial_body)
    let answer_body: list[MirInstruction] = [i64_const(0, 10), call(ops, [1], 0, [0]), returning(ops, 1)]
    let answer = function(ops, "main.answer", BuiltinMirType.signed_i64, [i64_t(), i64_t()], answer_body)
    return verified(program_with([factorial, answer]))

pub func test_wasm_modules_recurse():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    assert(run_module(factorial_program(), "factorial", "main.answer").output == "3628800")

# mix(a: i8, b: u16, c: i64, d: f64) -> i64 = a + b + c + trunc(d)
pub func test_wasm_modules_pass_mixed_width_parameters():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let i8_t = scalar(BuiltinMirType.signed_i8)
    let u16_t = scalar(BuiltinMirType.unsigned_u16)
    let f64_t = scalar(BuiltinMirType.float64)
    let mix_body: list[MirInstruction] = [
        at(InstructionForm.Convert(result = register(4), operation = ConvertOp.extend, operand = register(0))),
        at(InstructionForm.Convert(result = register(5), operation = ConvertOp.extend, operand = register(1))),
        at(InstructionForm.Convert(result = register(6), operation = ConvertOp.float_to_int, operand = register(3))),
        binary(7, BinaryOp.add, 4, 5),
        binary(8, BinaryOp.add, 7, 2),
        binary(9, BinaryOp.add, 8, 6),
        returning(ops, 9),
    ]
    let mix_registers = [i8_t, u16_t, i64_t(), f64_t, i64_t(), i64_t(), i64_t(), i64_t(), i64_t(), i64_t()]
    let mix = function_with_parameters(ops, "main.mix", [i8_t, u16_t, i64_t(), f64_t], [i64_t()], mix_registers, list[MirSlot](), mix_body)
    let answer_body: list[MirInstruction] = [
        at(InstructionForm.Const(result = register(0), value = MirConstant.SignedInt(value = -3))),
        at(InstructionForm.Const(result = register(1), value = MirConstant.UnsignedInt(value = 65535))),
        i64_const(2, 1000000),
        at(InstructionForm.Const(result = register(3), value = MirConstant.Float(value = 2.75))),
        call(ops, [4], 0, [0, 1, 2, 3]),
        returning(ops, 4),
    ]
    let answer = function(ops, "main.answer", BuiltinMirType.signed_i64, [i8_t, u16_t, i64_t(), f64_t, i64_t()], answer_body)
    let program = verified(program_with([mix, answer]))
    assert(run_module(program, "mixed_parameters", "main.answer").output == "1065534")

# A unit callee writes into a slot through a pointer parameter; the caller
# reads the effect back.
pub func test_wasm_modules_call_unit_functions_for_effect():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let poke_body: list[MirInstruction] = [
        i64_const(1, 77),
        i64_store(0, 1),
        at(InstructionForm.Return(values = no_registers())),
    ]
    let poke = function_with_parameters(ops, "main.poke", [ptr_t()], list[TypeId](), [ptr_t(), i64_t()], list[MirSlot](), poke_body)
    let slots = [MirSlot(value_type = i64_t())]
    let answer_body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(0), slot = 0)),
        i64_const(1, 0), i64_store(0, 1),
        call(ops, list[i64](), 0, [0]),
        i64_load(2, 0),
        returning(ops, 2),
    ]
    let answer = function_with_slots(ops, "main.answer", BuiltinMirType.signed_i64, [ptr_t(), i64_t(), i64_t()], slots, answer_body)
    let program = verified(program_with([poke, answer]))
    assert(run_module(program, "unit_call", "main.answer").output == "77")

# forever(n) = forever(n + 1) with a frame: the shadow stack runs into the
# guard and traps instead of overwriting the data area.
pub func test_wasm_modules_trap_on_stack_overflow():
    let ops = OperandBuilder()
    if not wasmtime_available(): return
    let slots = [MirSlot(value_type = i64_t())]
    let forever_body: list[MirInstruction] = [
        at(InstructionForm.Alloca(result = register(1), slot = 0)),
        i64_store(1, 0),
        i64_const(2, 1),
        binary(3, BinaryOp.add, 0, 2),
        call(ops, [4], 0, [3]),
        returning(ops, 4),
    ]
    let forever = function_with_parameters(ops, "main.forever", [i64_t()], [i64_t()], [i64_t(), ptr_t(), i64_t(), i64_t(), i64_t()], slots, forever_body)
    let answer_body: list[MirInstruction] = [i64_const(0, 0), call(ops, [1], 0, [0]), returning(ops, 1)]
    let answer = function(ops, "main.answer", BuiltinMirType.signed_i64, [i64_t(), i64_t()], answer_body)
    let program = verified(program_with([forever, answer]))
    assert(run_module(program, "stack_overflow", "main.answer").status != 0)
