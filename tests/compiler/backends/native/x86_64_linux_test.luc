#==============================================================================================
#
#   x86_64_linux_test - The ELF encoder writes the expected image
#
#   DESCRIPTION:
#       Hand-built canonical MIR in, a complete static ELF executable out,
#       probed at the offsets that matter: magic, machine, entry point, the
#       data bytes after the headers, and the first code bytes.
#
#==============================================================================================

from luce.compiler.backends.native.x86_64_linux import X86_64LinuxBackend
from luce.compiler.mir.canonical import BinaryOp, BuiltinMirType, CallingConvention, DataId, ExternId
from luce.compiler.mir.canonical import InstructionForm, MirConstant, MirData, MirExtern, MirFunction, OperandBuilder, no_registers
from luce.compiler.mir.canonical import MirInstruction, MirProgram, MirSignature, MirSlot
from luce.compiler.mir.canonical import RegisterId, TypeId, builtin_mir_type, create_empty_mir_program
from luce.compiler.mir.verifier import MirVerifier
from luce.compiler.frontend.source import SourceSpan
import std.strings

# mark: Fixtures =============================================================================

pub func span() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

pub func instruction(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = span())

pub func reg(value: i64) -> RegisterId:
    return RegisterId(value = u32(value))

pub func i32_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.signed_i32)

pub func i64_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.signed_i64)

pub func ptr_type() -> TypeId:
    return builtin_mir_type(BuiltinMirType.pointer)

pub func write_extern() -> MirExtern:
    return MirExtern(
        name = "luce_rt_write",
        convention = CallingConvention.runtime,
        signature = MirSignature(parameters = [ptr_type(), i64_type()], results = list[TypeId](), is_fallible = false),
    )

pub func main_function(ops: OperandBuilder, name: str, is_public: bool, result: TypeId, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = list[TypeId](), results = [result], is_fallible = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        is_public = is_public,
        span = span(),
    )

# `print("Hello, world!")` then `return 0`, exactly as the lowerer spells it.
pub func hello_program() -> MirProgram:
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.externs.append(write_extern())
    program.data.append(MirData(name = "hello.text0", bytes = strings.to_bytes("Hello, world!\n"), align = 1))
    let body: list[MirInstruction] = [
        instruction(InstructionForm.DataAddress(result = reg(0), data = DataId(value = 0))),
        instruction(InstructionForm.Const(result = reg(1), value = MirConstant.Int(value = 14))),
        instruction(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run([reg(0), reg(1)]))),
        instruction(InstructionForm.Const(result = reg(2), value = MirConstant.Int(value = 0))),
        instruction(InstructionForm.Return(values = ops.run([reg(2)]))),
    ]
    program.functions.append(main_function(ops, "hello.main", true, i32_type(), [ptr_type(), i64_type(), i32_type()], body))
    return program

# `return left OP right`; `main` is always `i32`, so only the i32 variant
# passes the verifier and the i64 one is an encoder-only fixture.
pub func arithmetic_program(operation: BinaryOp, left: i64, right: i64, operand_type: TypeId) -> MirProgram:
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let body: list[MirInstruction] = [
        instruction(InstructionForm.Const(result = reg(0), value = MirConstant.Int(value = left))),
        instruction(InstructionForm.Const(result = reg(1), value = MirConstant.Int(value = right))),
        instruction(InstructionForm.Binary(result = reg(2), operation = operation, left = reg(0), right = reg(1))),
        instruction(InstructionForm.Return(values = ops.run([reg(2)]))),
    ]
    program.functions.append(main_function(ops, "main.main", true, i32_type(), [operand_type, operand_type, operand_type], body))
    return program

pub func verified(program: MirProgram) -> MirProgram:
    MirVerifier(program).verify() catch reason:
        trap(reason)
    return program

pub func emitted(program: MirProgram) -> list[u8]:
    let artifact = X86_64LinuxBackend().emit(program) catch reason:
        trap(reason)
    return artifact

pub func emission_failure(program: MirProgram) -> str:
    let artifact = X86_64LinuxBackend().emit(program) catch reason:
        return reason
    return ""

# mark: Image layout =========================================================================

pub func test_x86_64_linux_backend_encodes_a_complete_static_executable():
    let ops = OperandBuilder()
    let artifact = emitted(verified(hello_program()))

    # ELF magic, then a 64-bit little-endian class.
    assert(artifact[0] == 0x7F)
    assert(artifact[1] == u8('E'))
    assert(artifact[2] == u8('L'))
    assert(artifact[3] == u8('F'))
    assert(artifact[4] == 0x02)
    assert(artifact[5] == 0x01)
    # e_type ET_EXEC and e_machine EM_X86_64, both little-endian.
    assert(artifact[16] == 0x02)
    assert(artifact[17] == 0x00)
    assert(artifact[18] == 0x3E)
    assert(artifact[19] == 0x00)
    # The 14 data bytes follow the 120 bytes of headers at 0x78.
    assert(artifact[0x78] == u8('H'))
    assert(artifact[0x85] == u8('\n'))
    # e_entry points past them at the first code byte: 0x400000 + 0x86.
    assert(artifact[24] == 0x86)
    assert(artifact[25] == 0x00)
    assert(artifact[26] == 0x40)
    assert(artifact[27] == 0x00)
    # Code begins with `sub rsp, 32` (three 8-byte slots rounded to 16).
    assert(artifact[0x86] == 0x48)
    assert(artifact[0x87] == 0x81)
    assert(artifact[0x88] == 0xEC)
    assert(artifact[0x89] == 0x20)
    # The image ends after the `exit` syscall; p_filesz covers every byte.
    let file_size = len(artifact)
    assert(artifact[96] == u8(file_size & 0xFF))
    assert(artifact[97] == u8(file_size >> 8 & 0xFF))

pub func test_x86_64_linux_backend_encodes_checked_arithmetic():
    let ops = OperandBuilder()
    let i64_add = emitted(arithmetic_program(BinaryOp.add, 40, 2, i64_type()))
    let i32_mul = emitted(verified(arithmetic_program(BinaryOp.mul, 6, 7, i32_type())))
    # After `sub rsp, 32`, two immediates and their stores, the add reads
    # both slots then runs `add rax, rcx` / `jno +2` / `ud2`.
    let code = 0x78 + 7
    let add_at = code + 2 * (10 + 8) + 2 * 8
    assert(i64_add[add_at] == 0x48)
    assert(i64_add[add_at + 1] == 0x01)
    assert(i64_add[add_at + 2] == 0xC8)
    assert(i64_add[add_at + 3] == 0x71)
    assert(i64_add[add_at + 4] == 0x02)
    assert(i64_add[add_at + 5] == 0x0F)
    assert(i64_add[add_at + 6] == 0x0B)
    # The i32 multiply drops REX.W: `imul eax, ecx` is 0F AF C1.
    assert(i32_mul[add_at] == 0x0F)
    assert(i32_mul[add_at + 1] == 0xAF)
    assert(i32_mul[add_at + 2] == 0xC1)
    assert(i32_mul[add_at + 3] == 0x71)

# mark: Diagnostics ==========================================================================

pub func test_x86_64_linux_backend_requires_one_public_i32_main():
    let ops = OperandBuilder()
    let none_program = create_empty_mir_program()
    none_program.functions.append(main_function(ops, "hello.answer", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(none_program) == "executable: needs one public `main`")

    let two = create_empty_mir_program()
    two.functions.append(main_function(ops, "a.main", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    two.functions.append(main_function(ops, "b.main", true, i32_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(two) == "executable: more than one public `main`")

    let wide = create_empty_mir_program()
    wide.functions.append(main_function(ops, "main.main", true, i64_type(), list[TypeId](), list[MirInstruction]()))
    assert(emission_failure(wide) == "executable: `main.main` must return `i32`")

pub func test_x86_64_linux_backend_names_unsupported_externs_and_forms():
    let ops = OperandBuilder()
    let program = hello_program()
    program.externs[0] = MirExtern(
        name = "luce_rt_alloc",
        convention = CallingConvention.runtime,
        signature = MirSignature(parameters = [i64_type(), i64_type()], results = [ptr_type()], is_fallible = false),
    )
    assert(emission_failure(program) == "x86_64-linux backend does not support extern `luce_rt_alloc` yet")

    let looping = create_empty_mir_program()
    let body: list[MirInstruction] = [
        instruction(InstructionForm.Loop),
        instruction(InstructionForm.Const(result = reg(0), value = MirConstant.Int(value = 0))),
        instruction(InstructionForm.Return(values = ops.run([reg(0)]))),
    ]
    looping.functions.append(main_function(ops, "main.main", true, i32_type(), [i32_type()], body))
    assert(emission_failure(looping) == "x86_64-linux backend does not support `Loop` yet in `main.main`")
