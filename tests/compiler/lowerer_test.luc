#==============================================================================================
#
#   lowerer_test - Typed trees into the expected instruction stream
#
#   DESCRIPTION:
#       Checked fixtures in, canonical instructions out — asserting the exact
#       evaluation order the lowerer promises, and the diagnostics it raises
#       for anything outside the executable slice.
#
#==============================================================================================

from luce.compiler.checker import Checker, SourceModule
from luce.compiler.lowerer import Lowerer
from luce.compiler.parser import Parser
from luce.compiler.semantic_analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.tokenizer import Tokenizer

# Run one fixture through tokenizer, parser, and checker; a broken fixture
# traps loudly.
pub func checked(source: str) -> AnalyzedProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    let module_value = SourceModule(name = "main", path = "main.luc", syntax = syntax_tree)
    let hir = Checker([module_value]).check() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return analyzed

# Return one lowering diagnostic, or an empty string when the fixture lowers.
pub func lowering_failure(source: str) -> str:
    let program = Lowerer(checked(source)).lower() catch reason:
        return reason
    return ""

pub func test_arithmetic_lowers_in_evaluation_order():
    let program = Lowerer(checked("pub func answer() -> i64: return (6 + 1) * (8 - 2)\n")).lower() catch reason:
        trap(reason)
    assert(len(program.functions) == 1)
    let function = program.functions[0]
    assert(function.name == "main.answer")
    assert(function.is_public)
    assert(function.result == "i64")
    assert(len(function.instructions) == 8)
    match function.instructions[0]:
        I64Constant(value): assert(value == 6)
        else: assert(false)
    match function.instructions[1]:
        I64Constant(value): assert(value == 1)
        else: assert(false)
    assert(str(function.instructions[2]) == "I64Add")
    match function.instructions[3]:
        I64Constant(value): assert(value == 8)
        else: assert(false)
    match function.instructions[4]:
        I64Constant(value): assert(value == 2)
        else: assert(false)
    assert(str(function.instructions[5]) == "I64Subtract")
    assert(str(function.instructions[6]) == "I64Multiply")
    assert(str(function.instructions[7]) == "Return")

pub func test_unsupported_lowering_names_the_function_and_feature():
    let reason = lowering_failure("func identity(value: i64) -> i64: return value\n")
    assert(reason == "main.luc:1:1: lowerer does not support parameters yet in `main.identity`")

pub func test_unsupported_lowering_reports_the_offending_node_span():
    let statement_source = "pub func answer() -> i64:\n    let value = 1\n    return value\n"
    let statement_reason = lowering_failure(statement_source)
    assert(statement_reason == "main.luc:2:5: lowerer does not support statement `Binding` yet in `main.answer`")

    let expression_source = "pub func answer() -> i64:\n    return +1\n"
    let expression_reason = lowering_failure(expression_source)
    assert(expression_reason == "main.luc:2:12: lowerer does not support expression `Unary` yet in `main.answer`")

pub func test_native_entry_lowers_terminal_output_and_i32_return():
    let source = "pub func main(arguments: slice[str]) -> i32 uses terminal:\n    print(\"Hello, world!\")\n    return 0\n"
    let program = Lowerer(checked(source)).lower() catch reason:
        trap(reason)
    let function = program.functions[0]
    assert(function.result == "i32")
    assert(len(function.instructions) == 3)
    match function.instructions[0]:
        WriteText(value): assert(value == "Hello, world!")
        else: assert(false)
    match function.instructions[1]:
        I32Constant(value): assert(value == 0)
        else: assert(false)
    assert(str(function.instructions[2]) == "Return")
