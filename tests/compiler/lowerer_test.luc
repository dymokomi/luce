#==============================================================================================
#
#   lowerer_test - Typed trees into the expected canonical MIR
#
#   DESCRIPTION:
#       Checked fixtures in, canonical MIR out — asserting the registers and
#       instructions the lowerer promises, that every lowered program passes
#       the MIR verifier, that the MIR interpreter computes what the HIR
#       interpreter computes for the same source, and the diagnostics raised
#       for anything outside the executable slice.
#
#==============================================================================================

from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.backends.mir_interpreter import MirInterpreter, MirValue
from luce.compiler.canonical_ir import BinaryOp, BuiltinMirType, CallingConvention, MirFunction, MirInstruction, MirProgram, TargetLayout, TypeId, UnaryOp, register_at
from luce.compiler.canonical_ir import builtin_mir_type, wasm32_layout, arm64_macos_layout
from luce.compiler.hir import Value
from luce.compiler.hir_gen import HirGenerator, SourceModule
from luce.compiler.lowerer import Lowerer
from luce.compiler.mir_verifier import MirVerifier
from luce.compiler.parser import Parser
from luce.compiler.semantic_analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.tokenizer import Tokenizer
import std.strings

# Run one fixture through tokenizer, parser, and HirGenerator; a broken fixture
# traps loudly.
pub func checked(source: str) -> AnalyzedProgram:
    return checked_modules([source_module("main", source)])

pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", syntax = syntax_tree)

pub func checked_modules(modules: list[SourceModule]) -> AnalyzedProgram:
    let hir = HirGenerator(modules).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return analyzed

# Lower one fixture for wasm32 and prove the verifier accepts the result.
pub func lowered(source: str) -> MirProgram:
    return lowered_for(source, wasm32_layout())

pub func lowered_for(source: str, layout: TargetLayout) -> MirProgram:
    let program = Lowerer(checked(source), layout).lower() catch reason:
        trap(reason)
    MirVerifier(program).verify() catch reason:
        trap(reason)
    return program

# Return one lowering diagnostic, or an empty string when the fixture lowers.
pub func lowering_failure(source: str) -> str:
    let program = Lowerer(checked(source), wasm32_layout()).lower() catch reason:
        return reason
    return ""

pub func is_type(id: TypeId, expected: BuiltinMirType) -> bool:
    return id.value == builtin_mir_type(expected).value

pub func only_function(program: MirProgram) -> MirFunction:
    assert(len(program.functions) == 1)
    return program.functions[0]

# Render a MIR result the way the HIR interpreter renders its value, so the
# two executions compare as text.
pub func render_mir(values: list[MirValue]) -> str:
    if len(values) == 0: return "unit"
    match values[0]:
        Int(item): return str(item)
        Float(item): return str(item)
        Bool(item): return str(item)
        Ptr(item): return "ptr " + str(item)

# The decisive check: the oracle and the MIR interpreter agree on `answer`.
pub func agree(source: str) -> str:
    return agree_modules([source_module("main", source)])

pub func agree_modules(modules: list[SourceModule]) -> str:
    let program = checked_modules(modules)
    let oracle = HirInterpreter().run(program, "main", "answer") catch reason:
        trap(reason)
    let mir = Lowerer(program, wasm32_layout()).lower() catch reason:
        trap(reason)
    MirVerifier(mir).verify() catch reason:
        trap(reason)
    let results = MirInterpreter(mir).run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(oracle.render() == render_mir(results))
    return oracle.render()

pub func oracle_failure(source: str) -> str:
    let oracle = HirInterpreter().run(checked(source), "main", "answer") catch reason:
        return reason
    return ""

pub func mir_failure(source: str) -> str:
    let results = MirInterpreter(lowered(source)).run("main.answer", list[MirValue]()) catch reason:
        return reason
    return ""

# Both executions must refuse the program at run time.
pub func both_trap(source: str):
    assert(oracle_failure(source) != "")
    assert(mir_failure(source) != "")

# mark: Evaluation order ====================================================================

pub func test_arithmetic_lowers_into_write_once_registers():
    let program = lowered("pub func answer() -> i64: return (6 + 1) * (8 - 2)\n")
    assert(len(program.externs) == 0)
    assert(len(program.data) == 0)
    assert(program.entry == none)
    let function = only_function(program)
    assert(function.name == "main.answer")
    assert(function.is_public)
    assert(function.convention == CallingConvention.luce)
    assert(len(function.signature.parameters) == 0)
    assert(len(function.signature.results) == 1)
    assert(is_type(function.signature.results[0], BuiltinMirType.signed_i64))
    assert(not function.signature.is_fallible)
    assert(len(function.slots) == 0)

    # One register per constant and per operation, all i64, defined in
    # source order: 6, 1, 6+1, 8, 2, 8-2, product.
    assert(len(function.registers) == 7)
    for register_type in function.registers:
        assert(is_type(register_type, BuiltinMirType.signed_i64))
    assert(len(function.body) == 8)
    match function.body[0].form:
        Const(result, value):
            assert(result.value == 0)
            match value:
                Int(item): assert(item == 6)
                else: assert(false)
        else: assert(false)
    match function.body[2].form:
        Binary(result, operation, left, right):
            assert(result.value == 2)
            assert(operation == BinaryOp.add)
            assert(left.value == 0)
            assert(right.value == 1)
        else: assert(false)
    match function.body[5].form:
        Binary(result, operation, left, right):
            assert(result.value == 5)
            assert(operation == BinaryOp.sub)
        else: assert(false)
    match function.body[6].form:
        Binary(result, operation, left, right):
            assert(result.value == 6)
            assert(operation == BinaryOp.mul)
            assert(left.value == 2)
            assert(right.value == 5)
        else: assert(false)
    match function.body[7].form:
        Return(values):
            assert(i64(values.count) == 1)
            assert(register_at(function, values, 0).value == 6)
        else: assert(false)

pub func test_native_entry_lowers_terminal_output_and_i32_return():
    let source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"Hello, world!\")\n    return 0\n"
    let program = lowered(source)
    let function = only_function(program)
    assert(is_type(function.signature.results[0], BuiltinMirType.signed_i32))

    # `print` becomes a data item, its address, its length, and one runtime
    # call; the entry is the public `() -> i32` main.
    assert(len(program.data) == 1)
    let text = strings.from_bytes(program.data[0].bytes) else trap("payload is not text")
    assert(text == "Hello, world!\n")
    assert(len(program.externs) == 1)
    assert(program.externs[0].name == "luce_rt_write")
    assert(program.externs[0].convention == CallingConvention.runtime)
    let entry = program.entry else trap("expected an entry")
    assert(entry.value == 0)

    assert(len(function.registers) == 3)
    assert(is_type(function.registers[0], BuiltinMirType.pointer))
    assert(is_type(function.registers[1], BuiltinMirType.signed_i64))
    assert(is_type(function.registers[2], BuiltinMirType.signed_i32))
    assert(len(function.body) == 5)
    match function.body[0].form:
        DataAddress(result, data):
            assert(result.value == 0)
            assert(data.value == 0)
        else: assert(false)
    match function.body[2].form:
        CallExtern(results, external, arguments):
            assert(i64(results.count) == 0)
            assert(external.value == 0)
            assert(register_at(function, arguments, 0).value == 0)
            assert(register_at(function, arguments, 1).value == 1)
        else: assert(false)
    match function.body[4].form:
        Return(values): assert(register_at(function, values, 0).value == 2)
        else: assert(false)

pub func test_one_runtime_extern_serves_every_print():
    let source = "pub func main(arguments: slice[str]) -> i32:\n    print(\"one\")\n    print(\"two\")\n    return 0\n"
    let program = lowered(source)
    assert(len(program.externs) == 1)
    assert(len(program.data) == 2)
    let text = strings.from_bytes(program.data[1].bytes) else trap("payload is not text")
    assert(text == "two\n")

pub func test_entry_requires_exactly_one_public_i32_main():
    assert(lowered("pub func answer() -> i64: return 1\n").entry == none)
    assert(lowered("func main(arguments: slice[str]) -> i32: return 0\n").entry == none)
    let program = Lowerer(checked("pub func main(arguments: slice[str]) -> i32: return 0\n"), arm64_macos_layout()).lower() catch reason:
        trap(reason)
    assert(program.layout.name == "arm64-macos")
    assert(program.entry != none)

# mark: Locals ==============================================================================

pub func test_locals_get_slots_in_the_prologue_and_load_store_pairs():
    let source = "pub func answer() -> i64:\n    let base = 40\n    var total = base\n    total += 2\n    return total\n"
    let program = lowered(source)
    let function = only_function(program)
    # Two slots, both i64, naturally aligned; two Allocas first, into ptr registers.
    assert(len(function.slots) == 2)
    assert(is_type(function.slots[0].value_type, BuiltinMirType.signed_i64))
    assert(function.slots[0].align == 8)
    assert(is_type(function.registers[0], BuiltinMirType.pointer))
    assert(is_type(function.registers[1], BuiltinMirType.pointer))
    match function.body[0].form:
        Alloca(result, slot):
            assert(result.value == 0)
            assert(slot == 0)
        else: assert(false)
    match function.body[1].form:
        Alloca(result, slot):
            assert(result.value == 1)
            assert(slot == 1)
        else: assert(false)
    # `let base = 40`: Const, Store to slot 0.
    match function.body[2].form:
        Const(result, value): assert(result.value == 2)
        else: assert(false)
    match function.body[3].form:
        Store(value_type, address, value):
            assert(is_type(value_type, BuiltinMirType.signed_i64))
            assert(address.value == 0)
            assert(value.value == 2)
        else: assert(false)
    # `var total = base`: Load slot 0, Store slot 1.
    match function.body[4].form:
        Load(result, value_type, address):
            assert(address.value == 0)
        else: assert(false)
    match function.body[5].form:
        Store(value_type, address, value): assert(address.value == 1)
        else: assert(false)
    # `total += 2`: Const 2, Load total, Binary add, Store.
    match function.body[6].form:
        Const(result, value): assert(true)
        else: assert(false)
    match function.body[7].form:
        Load(result, value_type, address): assert(address.value == 1)
        else: assert(false)
    match function.body[8].form:
        Binary(result, operation, left, right):
            assert(operation == BinaryOp.add)
            assert(left.value == 5)
            assert(right.value == 4)
        else: assert(false)
    match function.body[9].form:
        Store(value_type, address, value): assert(address.value == 1)
        else: assert(false)
    assert(agree(source) == "42")

pub func test_unit_functions_end_in_an_empty_return():
    let program = lowered("pub func answer():\n    let value = 1\n")
    let function = only_function(program)
    assert(len(function.signature.results) == 0)
    match function.body[len(function.body) - 1].form:
        Return(values): assert(i64(values.count) == 0)
        else: assert(false)
    let explicit = lowered("pub func answer():\n    return\n")
    assert(len(only_function(explicit).body) == 1)

pub func test_every_scalar_type_lowers_to_its_machine_type():
    let program = lowered("pub func answer() -> bool:\n    let a: i8 = 1\n    let b: i16 = 2\n    let c: u8 = 3\n    let d: u16 = 4\n    let e: u32 = 5\n    let f: u64 = 6\n    let g: f32 = 1.5f32\n    let h: f64 = 2.5\n    let i = 'x'\n    let j = true\n    return j\n")
    let slots = only_function(program).slots
    assert(is_type(slots[0].value_type, BuiltinMirType.signed_i8))
    assert(slots[0].align == 1)
    assert(is_type(slots[1].value_type, BuiltinMirType.signed_i16))
    assert(is_type(slots[2].value_type, BuiltinMirType.unsigned_u8))
    assert(is_type(slots[3].value_type, BuiltinMirType.unsigned_u16))
    assert(is_type(slots[4].value_type, BuiltinMirType.unsigned_u32))
    assert(is_type(slots[5].value_type, BuiltinMirType.unsigned_u64))
    assert(is_type(slots[6].value_type, BuiltinMirType.float32))
    assert(is_type(slots[7].value_type, BuiltinMirType.float64))
    assert(slots[7].align == 8)
    assert(is_type(slots[8].value_type, BuiltinMirType.unsigned_u32))
    assert(is_type(slots[9].value_type, BuiltinMirType.boolean))

# mark: Operators ===========================================================================

pub func test_unary_operators_map_onto_mir():
    let program = lowered("pub func answer() -> i64:\n    let value = 5\n    return -value + ~value + +value\n")
    var negations = 0
    var inversions = 0
    var copies = 0
    for instruction in only_function(program).body:
        match instruction.form:
            Unary(result, operation, operand):
                if operation == UnaryOp.neg: negations += 1
                if operation == UnaryOp.bit_not: inversions += 1
            Copy(result, source): copies += 1
            else: pass
    assert(negations == 1)
    assert(inversions == 1)
    assert(copies == 1)
    assert(agree("pub func answer() -> i64:\n    let value = 5\n    return -value + ~value + +value\n") == "-6")
    assert(agree("pub func answer() -> bool: return not false\n") == "true")

pub func test_comparisons_produce_bool_registers():
    let program = lowered("pub func answer() -> bool:\n    let a = 3\n    let b = 4\n    return a < b\n")
    let function = only_function(program)
    match function.body[len(function.body) - 2].form:
        Binary(result, operation, left, right):
            assert(operation == BinaryOp.lt)
            assert(is_type(function.registers[i64(result.value)], BuiltinMirType.boolean))
        else: assert(false)
    assert(agree("pub func answer() -> bool: return 3 < 4 and 4 <= 4 and 5 > 4 and 4 >= 4 and 1 == 1 and 1 != 2\n") == "true")
    assert(agree("pub func answer() -> bool: return 'a' < 'b' and 'a' == 'a'\n") == "true")
    assert(agree("pub func answer() -> bool: return 1.5 < 2.5 and 2.5 != 3.5\n") == "true")
    assert(agree("pub func answer() -> bool: return true == true and false != true\n") == "true")

pub func test_integer_operators_agree_with_the_oracle_at_every_width():
    assert(agree("pub func answer() -> i8:\n    let v: i8 = 100\n    return v + 27\n") == "127")
    assert(agree("pub func answer() -> i16:\n    let v: i16 = -32000\n    return v - 768\n") == "-32768")
    assert(agree("pub func answer() -> u8:\n    let v: u8 = 200\n    return v + 55\n") == "255")
    assert(agree("pub func answer() -> u16:\n    let v: u16 = 65535\n    return v - 1\n") == "65534")
    assert(agree("pub func answer() -> u32:\n    let v: u32 = 4294967295\n    return v - 4294967000\n") == "295")
    assert(agree("pub func answer() -> u64:\n    let v: u64 = 9223372036854775807\n    return v - 7\n") == "9223372036854775800")
    assert(agree("pub func answer() -> i64: return 7 // -2\n") == "-4")
    assert(agree("pub func answer() -> i64: return 7 % -2\n") == "-1")
    assert(agree("pub func answer() -> i64: return -7 // 2\n") == "-4")
    assert(agree("pub func answer() -> i64: return -7 % 2\n") == "1")
    assert(agree("pub func answer() -> u8:\n    let v: u8 = 1\n    return v << 7\n") == "128")
    assert(agree("pub func answer() -> i64: return -16 >> 2\n") == "-4")
    assert(agree("pub func answer() -> i64: return (12 & 10) + (12 | 10) + (12 ^ 10)\n") == "28")

pub func test_float_operators_agree_with_the_oracle():
    assert(agree("pub func answer() -> f64: return 1.5 * 2.0 + 0.5\n") == "3.5")
    assert(agree("pub func answer() -> f64: return 7.0 / 2.0\n") == "3.5")
    assert(agree("pub func answer() -> f32: return 1.5f32 * 2.0f32\n") == "3")
    assert(agree("pub func answer() -> f64:\n    var v = 1.0\n    v -= 0.25\n    v *= 4.0\n    v /= 2.0\n    return -v\n") == "-1.5")

pub func test_compound_assignment_covers_every_operator():
    let source = "pub func answer() -> i64:\n    var v = 100\n    v += 5\n    v -= 3\n    v *= 2\n    v //= 3\n    v %= 50\n    v &= 63\n    v |= 64\n    v ^= 1\n    v <<= 1\n    v >>= 2\n    return v\n"
    assert(agree(source) == "41")

pub func test_short_circuit_and_or_lower_to_if_with_results():
    let program = lowered("pub func answer() -> bool:\n    let a = true\n    let b = false\n    return a and b\n")
    let function = only_function(program)
    let opener = find_form(function.body, "If", 0)
    assert(opener >= 0)
    match function.body[opener].form:
        If(condition, results):
            assert(i64(results.count) == 1)
            assert(is_type(function.registers[i64(register_at(function, results, 0).value)], BuiltinMirType.boolean))
        else: assert(false)
    # The right operand is evaluated only in the then-arm (Load, Yield);
    # the else-arm yields the constant `false`.
    let else_at = find_form(function.body, "Else", opener)
    assert(else_at == opener + 3)
    match function.body[else_at + 1].form:
        Const(result, value):
            match value:
                Bool(item): assert(not item)
                else: assert(false)
        else: assert(false)
    match function.body[else_at + 2].form:
        Yield(values): assert(i64(values.count) == 1)
        else: assert(false)
    assert(str(function.body[else_at + 3].form) == "End")
    # The unevaluated side would trap; it must not run.
    assert(agree("pub func answer() -> bool:\n    let zero = 0\n    return false and 1 // zero == 0\n") == "false")
    assert(agree("pub func answer() -> bool:\n    let zero = 0\n    return true or 1 // zero == 0\n") == "true")
    assert(agree("pub func answer() -> bool: return (true and true) or false\n") == "true")
    assert(agree("pub func answer() -> bool: return (false or false) and true\n") == "false")

pub func test_conditional_expression_lowers_to_if_with_results():
    let source = "pub func answer() -> i64:\n    let flag = true\n    return 10 if flag else 20\n"
    let function = only_function(lowered(source))
    let opener = find_form(function.body, "If", 0)
    assert(opener >= 0)
    match function.body[opener].form:
        If(condition, results): assert(is_type(function.registers[i64(register_at(function, results, 0).value)], BuiltinMirType.signed_i64))
        else: assert(false)
    let else_at = find_form(function.body, "Else", opener)
    match function.body[else_at - 1].form:
        Yield(values): assert(i64(values.count) == 1)
        else: assert(false)
    assert(agree(source) == "10")
    assert(agree("pub func answer() -> i64:\n    let a = 1\n    let b = 2\n    return (a if a > b else b) if a != b else 0\n") == "2")
    assert(agree("pub func answer() -> i64: return (1 if false else 2) * (3 if true else 4)\n") == "6")

pub func test_expression_statements_lower_and_discard():
    let source = "pub func answer() -> i64:\n    let v = 1\n    v + 1\n    return v\n"
    assert(agree(source) == "1")

pub func test_overflow_traps_on_both_executions():
    both_trap("pub func answer() -> i8:\n    let v: i8 = 127\n    return v + 1\n")
    both_trap("pub func answer() -> u8:\n    let v: u8 = 0\n    return v - 1\n")
    both_trap("pub func answer() -> i64:\n    let zero = 0\n    return 1 // zero\n")
    both_trap("pub func answer() -> i32:\n    let v: i32 = 1\n    return v << 32\n")

# mark: Control flow ========================================================================

pub func test_if_chains_lower_to_nested_if_regions():
    let source = "pub func answer() -> i64:\n    let v = 2\n    var r = 0\n    if v == 1:\n        r = 10\n    elif v == 2:\n        r = 20\n    else:\n        r = 30\n    return r\n"
    let function = only_function(lowered(source))
    let opener = find_form(function.body, "If", 0)
    assert(opener >= 0)
    match function.body[opener].form:
        If(condition, results): assert(i64(results.count) == 0)
        else: assert(false)
    # then: Const 10, Store; Else; the `elif` condition (Load, Const,
    # Binary eq); the nested If; its then (2), Else, else (2), End; End.
    let else_at = find_form(function.body, "Else", opener)
    assert(else_at == opener + 3)
    let inner = find_form(function.body, "If", else_at)
    assert(inner == else_at + 4)
    let inner_else = find_form(function.body, "Else", inner)
    assert(inner_else == inner + 3)
    assert(str(function.body[inner_else + 3].form) == "End")
    assert(str(function.body[inner_else + 4].form) == "End")
    assert(agree(source) == "20")
    assert(agree("pub func answer() -> i64:\n    let v = 1\n    var r = 0\n    if v == 1:\n        r = 10\n    elif v == 2:\n        r = 20\n    else:\n        r = 30\n    return r\n") == "10")
    assert(agree("pub func answer() -> i64:\n    let v = 3\n    var r = 0\n    if v == 1:\n        r = 10\n    elif v == 2:\n        r = 20\n    else:\n        r = 30\n    return r\n") == "30")
    assert(agree("pub func answer() -> i64:\n    var r = 5\n    if false:\n        r = 1\n    return r\n") == "5")

pub func test_bindings_inside_arms_get_prologue_slots():
    let source = "pub func answer() -> i64:\n    var r = 0\n    if true:\n        let inner = 7\n        r = inner\n    while r < 10:\n        let step = 1\n        r += step\n    return r\n"
    let function = only_function(lowered(source))
    assert(len(function.slots) == 3)
    match function.body[0].form:
        Alloca(result, slot): assert(slot == 0)
        else: assert(false)
    match function.body[2].form:
        Alloca(result, slot): assert(slot == 2)
        else: assert(false)
    assert(agree(source) == "10")

pub func test_while_lowers_to_a_block_around_a_loop():
    let source = "pub func answer() -> i64:\n    var i = 0\n    while i < 3:\n        i += 1\n    return i\n"
    let function = only_function(lowered(source))
    let block = find_form(function.body, "Block", 0)
    assert(block >= 0)
    assert(str(function.body[block + 1].form) == "Loop")
    # condition (Load, Const, Binary), bool_not, BrIf 1, body, Br 0, End, End
    match function.body[block + 5].form:
        Unary(result, operation, operand): assert(operation == UnaryOp.bool_not)
        else: assert(false)
    match function.body[block + 6].form:
        BrIf(condition, depth, values):
            assert(depth == 1)
            assert(i64(values.count) == 0)
        else: assert(false)
    let ends = find_form(function.body, "End", block)
    match function.body[ends - 1].form:
        Br(depth, values): assert(depth == 0)
        else: assert(false)
    assert(str(function.body[ends + 1].form) == "End")
    assert(agree(source) == "3")

pub func test_break_and_continue_count_every_region_between():
    # `continue` directly in the loop body branches to the Loop (0); `break`
    # to the Block (1). Inside one If arm both are one deeper.
    let source = "pub func answer() -> i64:\n    var i = 0\n    var sum = 0\n    while true:\n        i += 1\n        if i > 10:\n            break\n        if i % 2 == 0:\n            continue\n        sum += i\n    return sum\n"
    let function = only_function(lowered(source))
    var break_depth = -1
    var continue_depth = -1
    for index in range(0, len(function.body)):
        match function.body[index].form:
            If(condition, if_results):
                match function.body[index + 1].form:
                    Br(depth, values):
                        if break_depth < 0: break_depth = depth
                        else: continue_depth = depth
                    else: pass
            else: pass
    assert(break_depth == 2)
    assert(continue_depth == 1)
    assert(agree(source) == "25")
    # Nested loops: break inside an if inside the inner loop leaves only the
    # inner loop; the outer loop keeps going.
    let nested = "pub func answer() -> i64:\n    var outer = 0\n    var count = 0\n    while outer < 3:\n        outer += 1\n        var inner = 0\n        while true:\n            inner += 1\n            if inner == 2:\n                if true:\n                    break\n            count += 1\n    return count\n"
    assert(deepest_break(only_function(lowered(nested)).body) == 3)
    assert(agree(nested) == "3")

pub func test_loops_agree_with_the_oracle():
    assert(agree("pub func answer() -> i64:\n    var n = 10\n    var sum = 0\n    var i = 1\n    while i <= n:\n        sum += i\n        i += 1\n    return sum\n") == "55")
    assert(agree("pub func answer() -> i64:\n    var n = 5\n    while n > 0:\n        n -= 1\n    return n\n") == "0")
    assert(agree("pub func answer() -> i64:\n    var i = 0\n    var hits = 0\n    while i < 20:\n        i += 1\n        if i % 3 != 0:\n            continue\n        if i > 15:\n            break\n        hits += 1\n    return hits\n") == "5")
    assert(agree("pub func answer() -> i64:\n    var limit = 1\n    var steps = 0\n    while steps < limit:\n        steps += 1\n        if limit < 8:\n            limit *= 2\n    return steps\n") == "8")
    assert(agree("pub func answer() -> i64:\n    var a = 0\n    var b = 1\n    var i = 0\n    while i < 10:\n        let next = a + b\n        a = b\n        b = next\n        i += 1\n    return a\n") == "55")
    assert(agree("pub func answer() -> i64:\n    var i = 0\n    var total = 0\n    while i < 3:\n        var j = 0\n        while j < 4:\n            total += i * j\n            j += 1\n        i += 1\n    return total\n") == "18")
    assert(agree("pub func answer() -> bool:\n    var i = 0\n    while i < 100:\n        i += 7\n    return i == 105\n") == "true")

pub func test_early_return_from_inside_a_loop_inside_an_if():
    let source = "pub func answer() -> i64:\n    let flag = true\n    if flag:\n        var i = 0\n        while true:\n            i += 1\n            if i == 4:\n                return i * 10\n    return -1\n"
    assert(agree(source) == "40")
    assert(agree("pub func answer() -> i64:\n    var i = 0\n    while i < 5:\n        if i == 3:\n            return i\n        i += 1\n    return 99\n") == "3")

pub func test_function_ends_get_the_terminator_the_verifier_needs():
    # Every arm returns: the verifier's `terminates` sees through the If
    # chain, so nothing is appended and the If is the last instruction.
    let all_arms = "pub func answer() -> i64:\n    let v = 1\n    if v == 1:\n        return 10\n    else:\n        return 20\n"
    let function = only_function(lowered(all_arms))
    assert(str(function.body[len(function.body) - 1].form) == "End")
    match function.body[len(function.body) - 2].form:
        Return(values): assert(true)
        else: assert(false)
    assert(agree(all_arms) == "10")
    # A trailing return needs nothing appended.
    let trailing = only_function(lowered("pub func answer() -> i64:\n    if true:\n        return 1\n    return 2\n"))
    match trailing.body[len(trailing.body) - 1].form:
        Return(values): assert(true)
        else: assert(false)
    # A unit function ending in a loop gets `Return []`.
    let unit = only_function(lowered("pub func answer():\n    var i = 0\n    while i < 2:\n        i += 1\n"))
    match unit.body[len(unit.body) - 1].form:
        Return(values): assert(i64(values.count) == 0)
        else: assert(false)
    assert(agree("pub func answer():\n    var i = 0\n    while i < 2:\n        i += 1\n") == "unit")

pub func test_loops_trap_on_both_executions_when_arithmetic_overflows():
    both_trap("pub func answer() -> i8:\n    var v: i8 = 0\n    while true:\n        v += 1\n    return v\n")

# The greatest `Br` depth anywhere in a body, for nested-loop checks.
pub func deepest_break(body: list[MirInstruction]) -> i64:
    var deepest = -1
    for instruction in body:
        match instruction.form:
            Br(depth, values):
                if depth > deepest: deepest = depth
            else: pass
    return deepest

# The first instruction at or after `start` whose form is named `name`.
pub func find_form(body: list[MirInstruction], name: str, start: i64) -> i64:
    for index in range(start, len(body)):
        if str(body[index].form) == name: return index
    return -1

pub func larger(a: i64, b: i64) -> i64:
    if a > b: return a
    return b

# mark: Diagnostics =========================================================================

pub func test_unsupported_lowering_names_the_function_and_feature():
    let reason = lowering_failure("func count(items: slice[str]) -> i64: return 1\n")
    assert(reason == "main.luc:1:1: lowerer does not support type `slice[str]` yet in `main.count`")

pub func test_unsupported_lowering_reports_the_offending_node_span():
    let expression_source = "pub func main(arguments: slice[str]) -> i32:\n    let items = arguments\n    return 0\n"
    assert(lowering_failure(expression_source) == "main.luc:2:5: lowerer does not support type `slice[str]` yet in `main.main`")

pub func test_unsupported_types_stop_at_the_lowerer():
    let reason = lowering_failure("func first(items: slice[str]) -> slice[str]: return items\n")
    assert(reason == "main.luc:1:1: lowerer does not support type `slice[str]` yet in `main.first`")

# mark: Calls, parameters, and constants ===================================================

pub func test_parameters_are_the_leading_typed_registers():
    let program = lowered("func add(left: i64, right: i32, flag: bool) -> i64: return left\n")
    let function = only_function(program)
    assert(len(function.signature.parameters) == 3)
    assert(is_type(function.signature.parameters[0], BuiltinMirType.signed_i64))
    assert(is_type(function.signature.parameters[1], BuiltinMirType.signed_i32))
    assert(is_type(function.signature.parameters[2], BuiltinMirType.boolean))
    assert(is_type(function.registers[0], BuiltinMirType.signed_i64))
    assert(is_type(function.registers[1], BuiltinMirType.signed_i32))
    assert(is_type(function.registers[2], BuiltinMirType.boolean))
    assert(len(function.slots) == 0)
    # `return left` is the parameter register itself: no Load, no Copy.
    assert(len(function.body) == 1)
    match function.body[0].form:
        Return(values): assert(register_at(function, values, 0).value == 0)
        else: assert(false)

pub func test_entry_keeps_its_signature_without_parameters():
    let program = lowered("pub func main(arguments: slice[str]) -> i32: return 0\n")
    let function = only_function(program)
    assert(len(function.signature.parameters) == 0)
    assert(len(function.registers) == 1)

pub func test_calls_place_arguments_by_parameter_index_in_source_order():
    let source = "func pair(first: i64, second: i64) -> i64: return first * 10 + second\npub func answer() -> i64: return pair(second: 2, first: 1)\n"
    let program = lowered(source)
    assert(len(program.functions) == 2)
    let caller = program.functions[1]
    # Registers: r0 = 2 (written first), r1 = 1, r2 = call result.
    match caller.body[0].form:
        Const(result, value):
            assert(result.value == 0)
            match value:
                Int(item): assert(item == 2)
                else: assert(false)
        else: assert(false)
    match caller.body[2].form:
        Call(results, function, arguments):
            assert(function.value == 0)
            assert(i64(arguments.count) == 2)
            assert(register_at(caller, arguments, 0).value == 1)
            assert(register_at(caller, arguments, 1).value == 0)
            assert(i64(results.count) == 1)
            assert(is_type(caller.registers[i64(register_at(caller, results, 0).value)], BuiltinMirType.signed_i64))
        else: assert(false)
    assert(agree(source) == "12")

pub func test_unit_callees_are_called_without_results():
    let source = "func work(): return\npub func answer() -> i64:\n    work()\n    return 4\n"
    let program = lowered(source)
    match program.functions[1].body[0].form:
        Call(results, function, arguments):
            assert(i64(results.count) == 0)
            assert(i64(arguments.count) == 0)
        else: assert(false)
    assert(agree(source) == "4")

pub func test_module_constants_are_inlined_at_each_use():
    let source = "let base: i64 = 40\nlet extra = 2\npub func answer() -> i64: return base + extra + base\n"
    let program = lowered(source)
    let function = only_function(program)
    var constants = 0
    for instruction in function.body:
        match instruction.form:
            Const(result, value): constants += 1
            else: pass
    assert(constants == 3)
    assert(len(function.slots) == 0)
    assert(agree(source) == "82")

pub func test_forward_and_cross_module_calls_map_to_function_ids():
    let modules = [
        source_module("math", "pub func double(value: i64) -> i64: return value * 2\npub func square(value: i64) -> i64: return value * value\n"),
        source_module("main", "import math\nfrom math import square\npub func answer() -> i64: return math.double(later(3)) + square(4)\nfunc later(value: i64) -> i64: return value + 1\n"),
    ]
    let program = Lowerer(checked_modules(modules), wasm32_layout()).lower() catch reason:
        trap(reason)
    MirVerifier(program).verify() catch reason:
        trap(reason)
    assert(program.functions[0].name == "math.double")
    assert(program.functions[1].name == "math.square")
    assert(program.functions[2].name == "main.answer")
    assert(program.functions[3].name == "main.later")
    var targets = list[i64]()
    for instruction in program.functions[2].body:
        match instruction.form:
            Call(results, function, arguments): targets.append(i64(function.value))
            else: pass
    assert(len(targets) == 3)
    assert(targets[0] == 3)
    assert(targets[1] == 0)
    assert(targets[2] == 1)
    assert(agree_modules(modules) == "24")

pub func test_recursion_agrees_with_the_oracle():
    let factorial = "func factorial(n: i64) -> i64:\n    if n <= 1: return 1\n    return n * factorial(n - 1)\npub func answer() -> i64: return factorial(15)\n"
    assert(agree(factorial) == "1307674368000")
    let fibonacci = "func fib(n: i64) -> i64:\n    if n < 2: return n\n    return fib(n - 1) + fib(n - 2)\npub func answer() -> i64: return fib(20)\n"
    assert(agree(fibonacci) == "6765")
    let mutual = "func is_even(n: i64) -> bool:\n    if n == 0: return true\n    return is_odd(n - 1)\nfunc is_odd(n: i64) -> bool:\n    if n == 0: return false\n    return is_even(n - 1)\npub func answer() -> i64: return (1 if is_even(10) else 0) + (10 if is_odd(7) else 0)\n"
    assert(agree(mutual) == "11")

pub func test_mixed_width_parameters_and_calls_in_conditions_agree():
    let mixed = "func mix(a: i8, b: u16, c: i64, d: f64) -> i64:\n    return c + (1 if a < 0 else 0) + (10 if b > 100 else 0) + (100 if d > 0.5 else 0)\npub func answer() -> i64: return mix(-3, 500, 1000, 0.75)\n"
    assert(agree(mixed) == "1111")
    let condition = "func limit(n: i64) -> i64: return n * 3\npub func answer() -> i64:\n    var i = 0\n    var total = 0\n    while i < limit(4):\n        total += i\n        i += 1\n    return total\n"
    assert(agree(condition) == "66")

pub func test_unit_calls_for_effect_write_output_through_mir():
    let source = "func greet():\n    print(\"hi\")\nfunc twice():\n    greet()\n    greet()\npub func answer() -> i64:\n    twice()\n    return 1\n"
    assert(agree(source) == "1")
    let interpreter = MirInterpreter(lowered(source))
    let results = interpreter.run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    assert(interpreter.output == "hi\nhi\n")

pub func test_overflow_inside_a_callee_traps_on_both_executions():
    both_trap("func bump(v: i8) -> i8: return v + 1\npub func answer() -> i8: return bump(127)\n")

# mark: Aggregates ==========================================================================

pub func test_aggregate_results_use_a_hidden_pointer_parameter():
    let program = lowered("func pair() -> (i64, i64): return (3, 4)\n")
    let function = only_function(program)
    assert(len(function.signature.parameters) == 1)
    assert(is_type(function.signature.parameters[0], BuiltinMirType.pointer))
    assert(len(function.signature.results) == 0)
    # The body ends by copying the tuple into the caller's slot and returning nothing.
    let last = function.body[len(function.body) - 1]
    match last.form:
        Return(values): assert(i64(values.count) == 0)
        else: assert(false)
    match function.body[len(function.body) - 2].form:
        Memcpy(destination, source, value_type):
            assert(destination.value == 0)
            match program.types.definitions[i64(value_type.value)]:
                Struct(fields, size, align):
                    assert(len(fields) == 2)
                    assert(size == 16)
                else: assert(false)
        else: assert(false)

pub func test_aggregate_callers_pass_their_slot_first():
    let program = lowered("func pair() -> (i64, i64): return (3, 4)\npub func answer() -> i64:\n    let (a, b) = pair()\n    return a + b\n")
    let caller = program.functions[1]
    var calls = 0
    for instruction in caller.body:
        match instruction.form:
            Call(results, function, arguments):
                calls += 1
                assert(i64(results.count) == 0)
                assert(i64(arguments.count) == 1)
                assert(is_type(caller.registers[i64(register_at(caller, arguments, 0).value)], BuiltinMirType.pointer))
            else: pass
    assert(calls == 1)

pub func test_optionals_are_tagged_enums_with_the_payload_after_the_tag():
    let program = lowered("func maybe() -> i64?: return none\n")
    let function = only_function(program)
    # A hidden pointer parameter, since an optional is an aggregate.
    assert(is_type(function.signature.parameters[0], BuiltinMirType.pointer))
    let slot_type = function.slots[0].value_type
    match program.types.definitions[i64(slot_type.value)]:
        Enum(tag, cases, size, align):
            assert(is_type(tag, BuiltinMirType.unsigned_u8))
            assert(len(cases) == 2)
            assert(align == 8)
            assert(size == 16)
        else: assert(false)

pub func test_strings_are_pointer_and_length_from_a_data_item():
    let program = lowered("pub func answer() -> i64:\n    let s = \"abc\"\n    print(s)\n    return 0\n")
    let function = only_function(program)
    assert(len(program.data) == 2)
    assert(len(program.data[0].bytes) == 3)
    assert(len(program.data[1].bytes) == 1)
    var writes = 0
    for instruction in function.body:
        match instruction.form:
            CallExtern(results, external, arguments): writes += 1
            else: pass
    assert(writes == 2)
    match program.types.definitions[i64(function.slots[0].value_type.value)]:
        Struct(fields, size, align):
            assert(len(fields) == 2)
            assert(is_type(fields[0].value_type, BuiltinMirType.pointer))
            assert(is_type(fields[1].value_type, BuiltinMirType.signed_i64))
        else: assert(false)

pub func test_string_layout_follows_the_target():
    let source = "pub func answer() -> i64:\n    let s = \"abc\"\n    return 0\n"
    let wasm = lowered_for(source, wasm32_layout())
    let native = lowered_for(source, arm64_macos_layout())
    match wasm.types.definitions[i64(only_function(wasm).slots[0].value_type.value)]:
        Struct(fields, size, align): assert(fields[1].offset == 8 and size == 16)
        else: assert(false)
    match native.types.definitions[i64(only_function(native).slots[0].value_type.value)]:
        Struct(fields, size, align): assert(fields[1].offset == 8 and size == 16)
        else: assert(false)

# mark: Structs and methods =================================================================

pub func test_methods_are_named_by_struct_and_self_arrives_as_a_pointer():
    let program = lowered("struct C:\n    var n: i64\n    mutating func bump(self): self.n += 1\n    func origin() -> C: return C(n: 0)\n")
    assert(program.functions[0].name == "main.C.bump")
    assert(program.functions[1].name == "main.C.origin")
    let bump = program.functions[0]
    assert(len(bump.signature.parameters) == 1)
    assert(is_type(bump.signature.parameters[0], BuiltinMirType.pointer))
    # `self.n += 1` is a FieldAddress off r0, a Load, an add, and a Store — no copy of `self`.
    var stores = 0
    var copies = 0
    for instruction in bump.body:
        match instruction.form:
            Store(value_type, address, value): stores += 1
            Memcpy(destination, source, value_type): copies += 1
            else: pass
    assert(stores == 1 and copies == 0)

pub func test_field_assignment_walks_the_path_from_the_root_slot():
    let program = lowered("struct Inner:\n    var value: i64\nstruct Outer:\n    var inner: Inner\npub func answer() -> i64:\n    var o = Outer(inner: Inner(value: 1))\n    o.inner.value = 20\n    return o.inner.value\n")
    let function = only_function(program)
    var addresses = 0
    for instruction in function.body:
        match instruction.form:
            FieldAddress(result, struct_type, base, field): addresses += 1
            else: pass
    # Construction: 1 (inner.value) + 1 (outer.inner); assignment: 2; read: 2.
    assert(addresses == 6)
