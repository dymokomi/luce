#==============================================================================================
#
#   generator_support - Shared fixtures for HIR generation tests
#
#   DESCRIPTION:
#       Source-module builders, checking entry points, and node accessors used by
#       the HIR generation tests and by the profile tests that mirror them.
#
#==============================================================================================

from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.ir import BuiltinType, HirFunction, HirNodeForm, HirProgram, ModuleAuthority, PackageRole
from luce.compiler.hir.ir import NodeId, Operands, entry_at, function_body, node_at, node_form, node_type
from luce.compiler.hir.ir import resolve_builtin_type, types_match
from luce.compiler.runtime_contract import RuntimeService

# Parse one fixture into a named module; a broken fixture traps loudly.
pub func source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.safe, syntax = syntax_tree)

pub func native_source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".lucn", authority = ModuleAuthority.native, syntax = syntax_tree)

pub func base_source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".lucb", authority = ModuleAuthority.base, syntax = syntax_tree)

pub func standard_source_module(name: str, source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax_tree = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = name, path = name + ".luc", authority = ModuleAuthority.standard, syntax = syntax_tree)

pub func checked(sources: list[SourceModule]) -> HirProgram:
    let program = HirGenerator("test.luce", sources).generate() catch reason:
        trap(reason)
    return program

pub func checked_runtime(sources: list[SourceModule]) -> HirProgram:
    let program = HirGenerator("org.luce.runtime", sources, PackageRole.sealed_runtime).generate() catch reason:
        trap(reason)
    return program

pub func semantic_failure(sources: list[SourceModule]) -> str:
    let program = HirGenerator("test.luce", sources).generate() catch reason:
        return reason
    return ""

pub func generic_budget_failure(sources: list[SourceModule], budget: i64) -> str:
    let program = HirGenerator("test.luce", sources, PackageRole.ordinary, budget).generate() catch reason:
        return reason
    return ""

pub func runtime_failure(sources: list[SourceModule]) -> str:
    let program = HirGenerator("org.luce.runtime", sources, PackageRole.sealed_runtime).generate() catch reason:
        return reason
    return ""

pub func runtime_binding_failure(sources: list[SourceModule], module_name: str, function_name: str) -> str:
    return selected_runtime_binding_failure(RuntimeService.storage_allocator, sources, module_name, function_name)

pub func selected_runtime_binding_failure(service: RuntimeService, sources: list[SourceModule], module_name: str, function_name: str) -> str:
    let generator = HirGenerator("org.luce.runtime", sources, PackageRole.sealed_runtime)
    generator.bind_runtime_service(service, module_name, function_name)
    let program = generator.generate() catch reason:
        return reason
    return ""

# Assert one diagnostic, naming the actual one when it differs.
pub func expect_failure(sources: list[SourceModule], expected: str):
    let actual = semantic_failure(sources)
    if actual != expected: trap("expected `" + expected + "`, got `" + actual + "`")

# Statement `index` of a function's body, and the node behind an id.
pub func statement(program: HirProgram, function: HirFunction, index: i64) -> HirNodeForm:
    return node_form(program, node_at(program, function_body(function), index))

pub func form(program: HirProgram, id: NodeId) -> HirNodeForm:
    return node_form(program, id)

# Argument `index` of a call: its parameter index and its node.
pub func argument_parameter(program: HirProgram, arguments: Operands, index: i64) -> i64:
    return entry_at(program, arguments, index * 2)

pub func argument_node(program: HirProgram, arguments: Operands, index: i64) -> NodeId:
    return NodeId(value = u32(entry_at(program, arguments, index * 2 + 1)))

# Require one return statement containing a binary expression whose operands
# are both canonical i32 values. Example: this accepts `return 5 * value` when
# `value` is i32, regardless of which side supplied the literal's context.
pub func assert_i32_binary_operands(program: HirProgram, function: HirFunction):
    match statement(program, function, 0):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    assert(types_match(node_type(program, left), resolve_builtin_type(BuiltinType.signed_i32)))
                    assert(types_match(node_type(program, right), resolve_builtin_type(BuiltinType.signed_i32)))
                    return
                else: assert(false)
        else: assert(false)

