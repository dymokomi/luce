#==============================================================================================
#
#   literal_decoder_test - Exact source spellings become exact semantic values
#
#==============================================================================================

from luce.compiler.hir.literal_decoder import decode_byte_literal, decode_character_literal, decode_text_literal
import std.strings

# mark: Helpers ================================================================================

func text_failure(spelling: str) -> str:
    let value = decode_text_literal(spelling) catch reason:
        return reason
    return ""

func character_failure(spelling: str) -> str:
    let value = decode_character_literal(spelling) catch reason:
        return reason
    return ""

func byte_failure(spelling: str) -> str:
    let value = decode_byte_literal(spelling) catch reason:
        return reason
    return ""

func text_value(spelling: str) -> str:
    let value = decode_text_literal(spelling) catch reason:
        trap(reason)
    return value

func character_value(spelling: str) -> char:
    let value = decode_character_literal(spelling) catch reason:
        trap(reason)
    return value

func byte_value(spelling: str) -> list[u8]:
    let value = decode_byte_literal(spelling) catch reason:
        trap(reason)
    return value

# mark: Text and characters ====================================================================

pub func test_text_decoding_is_linear_utf8_and_covers_the_complete_escape_set():
    let text = text_value("\"A\\\\\\\"\\'\\n\\r\\t\\0\\u{3bb}\\u{1f600}\"")
    let encoded = strings.to_bytes(text)
    assert(encoded[0] == u8(65))
    assert(encoded[1] == u8(92))
    assert(encoded[2] == u8(34))
    assert(encoded[3] == u8(39))
    assert(encoded[4] == u8(10))
    assert(encoded[5] == u8(13))
    assert(encoded[6] == u8(9))
    assert(encoded[7] == u8(0))
    assert(encoded[8] == u8(206) and encoded[9] == u8(187))
    assert(encoded[10] == u8(240) and encoded[11] == u8(159) and encoded[12] == u8(152) and encoded[13] == u8(128))

pub func test_raw_text_preserves_backslashes_and_never_interpolates():
    let text = text_value("r\"C:\\studio\\{shot}\\n\"")
    assert(text == "C:\\studio\\{shot}\\n")

pub func test_character_decoding_covers_direct_simple_and_unicode_scalars():
    assert(character_value("'λ'") == 'λ')
    assert(character_value("'\\0'") == char(0))
    assert(character_value("'\\u{1f600}'") == '😀')
    assert(character_failure("'ab'") == "character literal must contain one character")

# mark: Bytes ==================================================================================

pub func test_byte_decoding_distinguishes_exact_bytes_from_utf8_scalars():
    let value = byte_value("b\"A\\x00\\xff\\u{3bb}\\u{1f600}\"")
    assert(len(value) == 9)
    assert(value[0] == u8(65) and value[1] == u8(0) and value[2] == u8(255))
    assert(value[3] == u8(206) and value[4] == u8(187))
    assert(value[5] == u8(240) and value[6] == u8(159) and value[7] == u8(152) and value[8] == u8(128))

# mark: Deferred triple-string semantics =======================================================

pub func test_triple_literals_fail_until_the_formatter_owns_indentation_trimming():
    assert(text_failure("\"\"\"text\"\"\"") == "triple-quoted string indentation trimming is not implemented yet")
    assert(byte_failure("b\"\"\"bytes\"\"\"") == "triple-quoted byte literal indentation trimming is not implemented yet")
