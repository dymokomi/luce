#==============================================================================================
#
#   semantic_analyzer_test - Whole-program flow proofs
#
#   DESCRIPTION:
#       Typed HIR in, control-flow-sensitive semantic acceptance or one stable
#       diagnostic out. Custom initializers are the first rule owned here.
#
#==============================================================================================

from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.frontend.parser import Parser
from luce.compiler.hir.analyzer import AnalyzedProgram, SemanticAnalyzer
from luce.compiler.frontend.source import DiagnosticSeverity
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.ir import ModuleAuthority

# mark: Test helpers ===========================================================================

func source_module(source: str) -> SourceModule:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    return SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax)

func analysis_failure(source: str) -> str:
    let hir = HirGenerator("test.luce", [source_module(source)]).generate() catch reason:
        return reason
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        return reason
    return ""

func analyze_source(source: str) -> AnalyzedProgram:
    let hir = HirGenerator("test.luce", [source_module(source)]).generate() catch reason:
        trap(reason)
    let program = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    return program

func expect_failure(source: str, expected: str):
    let actual = analysis_failure(source)
    if actual != expected: trap("expected `" + expected + "`, got `" + actual + "`")

# mark: Advisories =============================================================================

pub func test_shared_cell_advisory_is_structured_deduplicated_and_actionable():
    let source = "func make(value: i64):\n    var count = value\n    let first: func() -> i64 = () => count\n    let second: func() -> i64 = () => count\n"
    let program = analyze_source(source)
    assert(len(program.hir.shared_cells) == 1)
    assert(len(program.diagnostics) == 1)
    let diagnostic = program.diagnostics[0]
    assert(diagnostic.severity == DiagnosticSeverity.warning)
    assert(diagnostic.code == "L1401")
    assert(diagnostic.message == "mutable binding `count` is shared with this closure")
    assert(diagnostic.primary.path == "main.luc")
    assert(diagnostic.primary.span.line == 3 and diagnostic.primary.span.column == 38)
    assert(diagnostic.primary.message == "this capture promotes `count` to an ARC-managed shared cell, which may allocate")
    assert(len(diagnostic.secondary) == 0)
    assert(diagnostic.help == "use `copy count = count` when the closure should capture a value snapshot")
    assert(diagnostic.render() == "warning[L1401]: mutable binding `count` is shared with this closure\n  --> main.luc:3:38\n   = this capture promotes `count` to an ARC-managed shared cell, which may allocate\n   = help: use `copy count = count` when the closure should capture a value snapshot")

    let nested = analyze_source("func make(value: i64) -> func() -> func() -> i64:\n    var count = value\n    return () => () => count\n")
    assert(len(nested.hir.shared_cells) == 2)
    assert(len(nested.diagnostics) == 1)
    assert(nested.diagnostics[0].message == diagnostic.message)

pub func test_explicit_value_snapshot_does_not_create_a_shared_cell_advisory():
    let source = "func make(value: i64):\n    var count = value\n    let read = func [copy count = count] () -> i64:\n        return count\n"
    let program = analyze_source(source)
    assert(len(program.hir.shared_cells) == 0)
    assert(len(program.diagnostics) == 0)

# mark: Initialization ========================================================================

pub func test_initializer_flow_accepts_complete_sequential_and_branching_paths():
    let sequential = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self, left: i64, right: i64):\n        self.left = left\n        self.right = right\n"
    assert(analysis_failure(sequential) == "")

    let branching = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self, swap: bool):\n        if swap:\n            self.left = 2\n            self.right = 1\n        else:\n            self.left = 1\n            self.right = 2\n"
    assert(analysis_failure(branching) == "")

    let fallible = "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Positive:\n    let value: i64\n    func init(self, value: i64) -> unit!:\n        if value < 0: error(invalid, \"negative\")\n        self.value = value\n"
    assert(analysis_failure(fallible) == "")

    let terminal_elif = "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Box:\n    let value: i64\n    func init(self, available: bool) -> unit!:\n        if available:\n            self.value = 1\n        elif error(invalid, \"unavailable\"):\n            self.value = 2\n"
    assert(analysis_failure(terminal_elif) == "")

    let terminal_loop = "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Box:\n    let value: i64\n    func init(self) -> unit!:\n        while error(invalid, \"stopped\"):\n            self.value = 1\n"
    assert(analysis_failure(terminal_loop) == "")

    let class_identity = "class Pair:\n    let left: i64\n    let right: i64\n    weak var peer: Pair?\n    func init(self, left: i64, right: i64):\n        self.left = left\n        self.right = right\n        self.peer = none\n"
    assert(analysis_failure(class_identity) == "")

pub func test_initializer_flow_rejects_missing_and_repeated_fields():
    let missing = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self, left: i64):\n        self.left = left\n"
    expect_failure(missing, "main.luc:4:5: initializer may finish before field `right` is initialized")

    let repeated = "struct Box:\n    let value: i64\n    func init(self, value: i64):\n        self.value = value\n        self.value = value + 1\n"
    expect_failure(repeated, "main.luc:5:9: field `value` may be initialized only once")

    let partial_branch = "struct Box:\n    let value: i64\n    func init(self, flag: bool):\n        if flag:\n            self.value = 1\n        self.value = 2\n"
    expect_failure(partial_branch, "main.luc:6:9: field `value` may be initialized only once")

    let missing_class_field = "class Node:\n    let value: i64\n    weak var parent: Node?\n    func init(self, value: i64):\n        self.value = value\n"
    expect_failure(missing_class_field, "main.luc:4:5: initializer may finish before field `parent` is initialized")

pub func test_initializer_flow_rejects_partial_self_reads_and_escape():
    let read = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self):\n        self.left = self.right\n        self.right = 2\n"
    expect_failure(read, "main.luc:5:21: field `right` is read before it is initialized")

    let escape = "func consume(value: Pair): return\nstruct Pair:\n    let left: i64\n    let right: i64\n    func init(self):\n        self.left = 1\n        consume(self)\n        self.right = 2\n"
    expect_failure(escape, "main.luc:7:17: initializer may finish before field `right` is initialized")

    let method = "struct Pair:\n    let left: i64\n    let right: i64\n    func sum(self) -> i64: return self.left + self.right\n    func init(self):\n        self.left = 1\n        let total = self.sum()\n        self.right = total\n"
    expect_failure(method, "main.luc:7:21: initializer may finish before field `right` is initialized")

    let list_index = "struct Bucket:\n    let index: u64\n    var values: list[i64]\n    func init(self):\n        self.values = [1]\n        self.values[self.index] = 2\n        self.index = 0u64\n"
    expect_failure(list_index, "main.luc:6:21: field `index` is read before it is initialized")

    let class_escape = "func consume(value: Node): return\nclass Node:\n    let value: i64\n    weak var parent: Node?\n    func init(self):\n        self.value = 1\n        consume(self)\n        self.parent = none\n"
    expect_failure(class_escape, "main.luc:7:17: initializer may finish before field `parent` is initialized")

pub func test_initializer_flow_rejects_early_success_and_loop_initialization():
    let early_return = "struct Pair:\n    let left: i64\n    let right: i64\n    func init(self):\n        self.left = 1\n        return\n"
    expect_failure(early_return, "main.luc:6:9: initializer may finish before field `right` is initialized")

    let loop = "struct Box:\n    let value: i64\n    func init(self):\n        for item in 0..<1:\n            self.value = item\n"
    expect_failure(loop, "main.luc:5:13: field `value` cannot be initialized inside a loop")

# mark: Deinitialization =======================================================================

pub func test_deinitializer_allows_borrowed_self_uses_but_rejects_resurrection():
    let allowed = "class Node:\n    var value: i64\n    weak var parent: Node?\n    func init(self):\n        self.value = 1\n        self.parent = none\n    func clear(self): self.value = 0\n    func deinit(self):\n        let observed = self.value\n        self.clear()\n        self.parent = self\n"
    assert(analysis_failure(allowed) == "")

    let binding = "class Node:\n    let value: i64\n    func init(self): self.value = 1\n    func deinit(self):\n        let resurrected = self\n"
    expect_failure(binding, "main.luc:5:27: deinitializer may use `self` only to access its fields, call one of its methods, or store a weak reference; a new strong reference would resurrect the class")

    let argument = "func publish(value: Node): return\nclass Node:\n    let value: i64\n    func init(self): self.value = 1\n    func deinit(self): publish(self)\n"
    expect_failure(argument, "main.luc:5:32: deinitializer may use `self` only to access its fields, call one of its methods, or store a weak reference; a new strong reference would resurrect the class")

    let collection = "class Node:\n    let children: list[Node]\n    func init(self): self.children = []\n    func deinit(self): self.children.append(self)\n"
    expect_failure(collection, "main.luc:4:45: deinitializer may use `self` only to access its fields, call one of its methods, or store a weak reference; a new strong reference would resurrect the class")

    let transitive = "class Node:\n    let children: list[Node]\n    func init(self): self.children = []\n    func publish(self): self.children.append(self)\n    func deinit(self): self.publish()\n"
    expect_failure(transitive, "main.luc:4:25: inserting `self` into a collection it owns creates a strong reference cycle; store `Weak[Node]` for the back edge")

    let returned = "class Node:\n    let value: i64\n    func init(self): self.value = 1\n    func expose(self) -> Node: return self\n    func deinit(self): discard(self.expose())\n"
    expect_failure(returned, "main.luc:4:39: deinitializer may use `self` only to access its fields, call one of its methods, or store a weak reference; a new strong reference would resurrect the class")

pub func test_deinitializer_reentrancy_advisory_follows_known_same_class_cleanup():
    let safe = analyze_source("class Resource:\n    var closed: bool\n    func init(self): self.closed = false\n    func close(self): self.closed = true\n    func deinit(self): self.close()\n")
    assert(len(safe.diagnostics) == 0)

    let direct = analyze_source("func notify(): return\nclass Resource:\n    var closed: bool\n    func init(self): self.closed = false\n    func deinit(self): notify()\n")
    assert(len(direct.diagnostics) == 1)
    let diagnostic = direct.diagnostics[0]
    assert(diagnostic.severity == DiagnosticSeverity.warning)
    assert(diagnostic.code == "L1101")
    assert(diagnostic.message == "call to `notify` from `deinit` may reenter arbitrary user code")
    assert(diagnostic.primary.path == "main.luc")
    assert(diagnostic.primary.span.line == 5 and diagnostic.primary.span.column == 24)
    assert(diagnostic.help == "perform callbacks during explicit shutdown and keep `deinit` limited to same-class cleanup")

    let transitive = analyze_source("func notify(): return\nclass Resource:\n    var closed: bool\n    func init(self): self.closed = false\n    func close(self):\n        notify()\n        self.closed = true\n    func deinit(self): self.close()\n")
    assert(len(transitive.diagnostics) == 1)
    assert(transitive.diagnostics[0].primary.span.line == 6)

    let indirect = analyze_source("func noop(): return\nclass Resource:\n    let callback: func() -> unit\n    func init(self): self.callback = noop\n    func deinit(self): self.callback()\n")
    assert(len(indirect.diagnostics) == 1)
    assert(indirect.diagnostics[0].message == "indirect call from `deinit` may reenter arbitrary user code")

    let external = analyze_source("extern func release(value: i64)\nclass Resource:\n    let handle: i64\n    func init(self, handle: i64): self.handle = handle\n    func deinit(self): release(self.handle)\n")
    assert(len(external.diagnostics) == 0)
