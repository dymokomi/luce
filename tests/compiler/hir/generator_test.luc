#==============================================================================================
#
#   hir_gen_test - What HirGenerator accepts and rejects
#
#   DESCRIPTION:
#       Parsed fixtures in, typed programs (or stable diagnostics) out. The
#       helpers below run source through the tokenizer and parser so each test
#       reads as: modules in, expectation out.
#
#==============================================================================================

from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import BuiltinType, HirCStructKind, HirGenericCallKind, HirReceiverKind, ModuleAuthority, PackageRole
from luce.compiler.hir.ir import NodeId, StandardInterface, SymbolKind, Value, arena_node_at, arena_node_form, describe_type, entry_at, function_body, no_node, node_at, node_diverges, node_form, node_type
from luce.compiler.hir.ir import is_integer_type, is_numeric_type, nominal_fields, resolve_builtin_type, type_contains_parameter, types_match
from luce.compiler.hir.ir import place_element_step, place_field_step
from luce.compiler.runtime_contract import RuntimeService
from compiler.hir.generator_support import argument_node, argument_parameter, assert_i32_binary_operands, checked, checked_runtime, expect_failure, form, generic_budget_failure, native_source_module, runtime_binding_failure, runtime_failure, selected_runtime_binding_failure, semantic_failure, source_module, standard_source_module, statement

# mark: Test helpers ========================================================================

# mark: Resolved typed HIR ==================================================================

pub func test_standard_intrinsics_require_compiler_supplied_source_provenance():
    let program = checked([standard_source_module(
        "c",
        "pub func bytes_at(pointer: foreign, count: u64) -> bytes: return Builtin.bytes_at(pointer, count)\npub func cstring_at(pointer: foreign) -> str: return Builtin.cstring_at(pointer)\n",
    )])
    assert(program.modules[0].authority == ModuleAuthority.standard)
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                ForeignBytesCopy(pointer, count): pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                ForeignCStringCopy(pointer): pass
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func bad(pointer: foreign) -> str: return Builtin.cstring_at(pointer)\n")],
        "main.luc:1:43: unknown name `Builtin`",
    )

pub func test_native_module_authority_is_explicit_nontransitive_and_nonexportable():
    let program = checked([
        native_source_module("raw", "func keep(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]: return value\nfunc read(value: native_ptr[u32]) -> u32: return native.load(value)\nfunc write(pointer: native_mut_ptr[u32], value: u32): native.store(pointer, value)\nfunc step(pointer: native_mut_ptr[u32], count: u64) -> native_mut_ptr[u32]: return native.advance(pointer, count)\npub func answer() -> i32: return 42\n"),
        source_module("main", "from raw import answer\nfunc use() -> i32: return answer()\n"),
    ])
    assert(program.modules[0].authority == ModuleAuthority.native)
    assert(program.modules[1].authority == ModuleAuthority.safe)
    assert(describe_type(program.types, program.functions[0].parameters[0].value_type) == "native_mut_ptr[u8]")
    match program.types.definitions[program.functions[0].result.value].form:
        NativePointer(pointee, is_mutable):
            assert(is_mutable)
            assert(types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8)))
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeLoad(pointer): assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.unsigned_u32)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[2], 0):
        ExpressionStatement(value):
            match form(program, value):
                NativeStore(pointer, stored): assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.unit)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeAdvance(pointer, count): assert(types_match(node_type(program, value), program.functions[3].result))
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func keep(value: native_ptr[u8]): return\n")],
        "main.luc:1:18: native pointer types require a `.lucn` module",
    )
    expect_failure(
        [native_source_module("raw", "pub func leak(value: native_ptr[u8]): return\n")],
        "raw.lucn:1:1: public function `leak` cannot expose native pointers",
    )
    expect_failure(
        [native_source_module("raw", "pub type Raw = native_ptr[u8]\n")],
        "raw.lucn:1:1: public type alias `Raw` cannot expose native pointers",
    )
    expect_failure(
        [source_module("main", "func bad(): native.load(1u64)\n")],
        "main.luc:1:13: native operations require a `.lucn` module",
    )
    expect_failure(
        [native_source_module("raw", "func bad(pointer: native_ptr[u8]): native.store(pointer, 1u8)\n")],
        "raw.lucn:1:49: `native.store` needs `native_mut_ptr`, found `native_ptr[u8]`",
    )

pub func test_native_rebinding_and_overlap_safe_moves_keep_typed_authority():
    let program = checked([native_source_module(
        "raw",
        "func words(pointer: native_mut_ptr[u8]) -> native_mut_ptr[u64]: return native.rebind(pointer)\nfunc move(destination: native_mut_ptr[u64], source: native_ptr[u64], count: u64): native.move(destination, source, count)\n",
    )])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeRebind(pointer): assert(types_match(node_type(program, value), program.functions[0].result))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ExpressionStatement(value):
            match form(program, value):
                NativeMove(destination, source, count): assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.unit)))
                else: assert(false)
        else: assert(false)

    let escalation = semantic_failure([native_source_module("raw", "func words(pointer: native_ptr[u8]) -> native_mut_ptr[u64]: return native.rebind(pointer)\n")])
    if escalation != "raw.lucn:1:82: `native.rebind` cannot add pointer mutability": trap(escalation)
    let mismatch = semantic_failure([native_source_module("raw", "func move(destination: native_mut_ptr[u64], source: native_ptr[u8]): native.move(destination, source, 1u64)\n")])
    if mismatch != "raw.lucn:1:70: `native.move` has `u64` destination elements and `u8` source elements": trap(mismatch)
    let missing_context = semantic_failure([native_source_module("raw", "func inspect(pointer: native_ptr[u8]): native.rebind(pointer)\n")])
    if missing_context != "raw.lucn:1:40: `native.rebind` needs a contextual native pointer result type": trap(missing_context)

pub func test_the_stable_arena_capability_requires_native_runtime_authority():
    let application_failure = semantic_failure([native_source_module(
        "raw",
        "func acquire(end: u64) -> native_mut_ptr[u8]: return native.arena(end)\n",
    )])
    if application_failure != "raw.lucn:1:54: `native.arena` is reserved for the sealed runtime package": trap(application_failure)
    let safe_failure = runtime_failure([source_module(
        "runtime",
        "func acquire(end: u64) -> u64:\n    native.arena(end)\n    return end\n",
    )])
    if safe_failure != "runtime.luc:2:5: native operations require a `.lucn` module": trap(safe_failure)

    let program = checked_runtime([native_source_module(
        "arena",
        "func acquire(end: u64) -> native_mut_ptr[u8]: return native.arena(end)\n",
    )])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeArena(end):
                    assert(types_match(node_type(program, end), resolve_builtin_type(BuiltinType.unsigned_u64)))
                    match program.types.definitions[node_type(program, value).value].form:
                        NativePointer(pointee, is_mutable):
                            assert(is_mutable)
                            assert(types_match(pointee, resolve_builtin_type(BuiltinType.unsigned_u8)))
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_float_bits_is_a_sealed_width_preserving_runtime_capability():
    let program = checked_runtime([native_source_module(
        "numbers",
        "func bits32(value: f32) -> u64: return native.float_bits(value)\nfunc bits64(value: f64) -> u64: return native.float_bits(value)\n",
    )])
    for function in program.functions:
        match statement(program, function, 0):
            ReturnStatement(result):
                match form(program, result):
                    NativeFloatBits(value):
                        assert(types_match(node_type(program, result), resolve_builtin_type(BuiltinType.unsigned_u64)))
                        assert(types_match(node_type(program, value), function.parameters[0].value_type))
                    else: assert(false)
            else: assert(false)

    let application_failure = semantic_failure([native_source_module(
        "numbers",
        "func bits(value: f64) -> u64: return native.float_bits(value)\n",
    )])
    if application_failure != "numbers.lucn:1:38: `native.float_bits` is reserved for the sealed runtime package": trap(application_failure)
    let safe_failure = runtime_failure([source_module(
        "numbers",
        "func bits(value: f64) -> u64: return native.float_bits(value)\n",
    )])
    if safe_failure != "numbers.luc:1:38: native operations require a `.lucn` module": trap(safe_failure)
    let wrong_value = runtime_failure([native_source_module(
        "numbers",
        "func bits(value: i64) -> u64: return native.float_bits(value)\n",
    )])
    if wrong_value != "numbers.lucn:1:56: `native.float_bits` needs `f32` or `f64`, found `i64`": trap(wrong_value)
    let wrong_arity = runtime_failure([native_source_module(
        "numbers",
        "func bits() -> u64: return native.float_bits()\n",
    )])
    if wrong_arity != "numbers.lucn:1:28: `native.float_bits` takes one `f32` or `f64` value": trap(wrong_arity)

pub func test_typed_storage_requests_are_structural_and_sealed_to_the_runtime():
    let program = checked_runtime([native_source_module(
        "storage",
        "struct Header:\n    var data: native_mut_ptr[u8]\n    var length: u64\nfunc acquire(count: u64) -> native_mut_ptr[Header]: return native.allocate[Header](count)\nfunc release(value: native_mut_ptr[Header], count: u64): native.deallocate(value, count)\nfunc empty(value: native_mut_ptr[Header]) -> bool: return native.is_null(value)\nfunc same(left: native_mut_ptr[Header], right: native_mut_ptr[Header]) -> bool: return native.is_same(left, right)\n",
    )])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeAllocate(element_type, count):
                    assert(types_match(node_type(program, count), resolve_builtin_type(BuiltinType.unsigned_u64)))
                    match program.types.definitions[node_type(program, value).value].form:
                        NativePointer(pointee, is_mutable):
                            assert(is_mutable)
                            assert(types_match(pointee, element_type))
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    match statement(program, program.functions[1], 0):
        ExpressionStatement(value):
            match form(program, value):
                NativeDeallocate(pointer, element_type, count):
                    match program.types.definitions[element_type.value].form:
                        Struct(index, arguments):
                            assert(index == 0)
                            assert(len(arguments) == 0)
                        else: assert(false)
                    assert(types_match(node_type(program, count), resolve_builtin_type(BuiltinType.unsigned_u64)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[2], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeIsNull(pointer): assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.boolean)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        ReturnStatement(value):
            match form(program, value):
                NativeIsSame(left, right): assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.boolean)))
                else: assert(false)
        else: assert(false)

    let application_failure = semantic_failure([native_source_module(
        "raw",
        "func acquire(count: u64) -> native_mut_ptr[u8]: return native.allocate[u8](count)\n",
    )])
    if application_failure != "raw.lucn:1:56: `native.allocate` is reserved for the sealed runtime package": trap(application_failure)
    let deallocation_failure = semantic_failure([native_source_module(
        "raw",
        "func release(value: native_mut_ptr[u8]): native.deallocate(value, 1u64)\n",
    )])
    if deallocation_failure != "raw.lucn:1:42: `native.deallocate` is reserved for the sealed runtime package": trap(deallocation_failure)
    let missing_type = runtime_failure([native_source_module(
        "storage",
        "func acquire(count: u64) -> native_mut_ptr[u8]: return native.allocate(count)\n",
    )])
    if missing_type != "storage.lucn:1:56: `native.allocate[T]` needs exactly one stored type": trap(missing_type)
    let unrelated_type_arguments = runtime_failure([native_source_module(
        "storage",
        "func read(pointer: native_ptr[u8]) -> u8: return native.load[u8](pointer)\n",
    )])
    if unrelated_type_arguments != "storage.lucn:1:50: `native.load` does not take type arguments": trap(unrelated_type_arguments)

pub func test_runtime_services_resolve_once_to_private_native_function_identities():
    let source = native_source_module(
        "allocator",
        "func allocate(byte_count: u64, byte_alignment: u64) -> native_mut_ptr[u8]: return native.arena(byte_count)\n",
    )
    let generator = HirGenerator("org.luce.runtime", [source], PackageRole.sealed_runtime)
    generator.bind_runtime_service(RuntimeService.storage_allocator, "allocator", "allocate")
    let program = generator.generate() catch reason:
        trap(reason)
    assert(len(program.runtime_bindings) == 1)
    assert(program.runtime_bindings[0].service == RuntimeService.storage_allocator)
    assert(program.runtime_bindings[0].function.value == program.functions[0].symbol.value)

    let application = HirGenerator("org.luce.application", [source])
    application.bind_runtime_service(RuntimeService.storage_allocator, "allocator", "allocate")
    var application_rejected = false
    discard(application.generate()) catch reason:
        assert(reason == "runtime service bindings require the sealed runtime package role")
        application_rejected = true
    assert(application_rejected)

    assert(runtime_binding_failure([source], "missing", "allocate") == "runtime binding `storage_allocator` names missing module `missing`")
    assert(runtime_binding_failure([source], "allocator", "missing") == "runtime binding `storage_allocator` names missing function `allocator.missing`")
    let wrong_source = native_source_module("allocator", "func allocate(byte_count: u64) -> u64: return byte_count\n")
    assert(runtime_binding_failure([wrong_source], "allocator", "allocate") == "allocator.lucn:1:1: runtime binding `storage_allocator` must have signature `(u64, u64) -> native_mut_ptr[u8]`")

    let wrong_list_source = native_source_module("allocator", "func service(value: native_mut_ptr[u8]) -> native_mut_ptr[u8]: return value\n")
    assert(selected_runtime_binding_failure(RuntimeService.equality_context_create, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `equality_context_create` must have signature `() -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.equality_context_release, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `equality_context_release` must have signature `(native_mut_ptr[u8]) -> unit`")
    assert(selected_runtime_binding_failure(RuntimeService.equality_context_visit, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `equality_context_visit` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], native_mut_ptr[u8]) -> bool`")
    assert(selected_runtime_binding_failure(RuntimeService.list_copy, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_copy` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.list_mutable_slice_begin, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_mutable_slice_begin` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.storage_deallocator, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `storage_deallocator` must have signature `(native_mut_ptr[u8], u64, u64) -> unit`")
    assert(selected_runtime_binding_failure(RuntimeService.list_concat, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_concat` must have signature `(native_mut_ptr[u8], native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.list_insert_slot, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_insert_slot` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.list_remove_at, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_remove_at` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
    assert(selected_runtime_binding_failure(RuntimeService.list_mutable_element_address, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_mutable_element_address` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.list_slice, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_slice` must have signature `(native_mut_ptr[u8], u64, u64, u64) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.slice_length, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `slice_length` must have signature `(native_mut_ptr[u8]) -> u64`")
    assert(selected_runtime_binding_failure(RuntimeService.list_iteration_begin, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_iteration_begin` must have signature `(native_mut_ptr[u8]) -> u64`")
    assert(selected_runtime_binding_failure(RuntimeService.list_iteration_end, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_iteration_end` must have signature `(native_mut_ptr[u8]) -> unit`")
    assert(selected_runtime_binding_failure(RuntimeService.list_iteration_active, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_iteration_active` must have signature `(native_mut_ptr[u8]) -> bool`")
    assert(selected_runtime_binding_failure(RuntimeService.slice_element_address, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `slice_element_address` must have signature `(native_mut_ptr[u8], u64, u64) -> native_mut_ptr[u8]`")
    assert(selected_runtime_binding_failure(RuntimeService.list_clear, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_clear` must have signature `(native_mut_ptr[u8], u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")
    assert(selected_runtime_binding_failure(RuntimeService.list_reserve, [wrong_list_source], "allocator", "service") == "allocator.lucn:1:1: runtime binding `list_reserve` must have signature `(native_mut_ptr[u8], u64, u64, u64, func(native_mut_ptr[u8]) -> unit) -> unit`")

    let duplicate = HirGenerator("org.luce.runtime", [source], PackageRole.sealed_runtime)
    duplicate.bind_runtime_service(RuntimeService.storage_allocator, "allocator", "allocate")
    duplicate.bind_runtime_service(RuntimeService.storage_allocator, "allocator", "allocate")
    discard(duplicate.generate()) catch reason:
        assert(reason == "duplicate runtime binding for `storage_allocator`")
        return
    trap("expected duplicate runtime service bindings to fail")

pub func test_mutable_module_state_is_private_to_the_explicit_runtime_role():
    expect_failure(
        [source_module("main", "var cursor: u64\n")],
        "main.luc:1:1: mutable module globals are reserved for the sealed runtime package",
    )
    let public_failure = runtime_failure([source_module("state", "pub var cursor: u64\n")])
    assert(public_failure == "state.luc:1:1: a sealed runtime global must be module-private")
    let unit_failure = runtime_failure([source_module("state", "var token: unit\n")])
    if unit_failure != "state.luc:1:12: runtime global `token` needs a structurally zero-initializable value type": trap(unit_failure)

    let program = checked_runtime([source_module(
        "state",
        "var cursor: u64\nfunc bump(delta: u64) -> u64:\n    cursor += delta\n    return cursor\n",
    )])
    assert(program.packages[program.root_package.value].role == PackageRole.sealed_runtime)
    assert(len(program.globals) == 1)
    assert(program.globals[0].name == "cursor")
    assert(types_match(program.globals[0].value_type, resolve_builtin_type(BuiltinType.unsigned_u64)))
    match statement(program, program.functions[0], 0):
        GlobalStore(global, operation, value): assert(global == 0)
        else: assert(false)

    let pointer_state = checked_runtime([native_source_module(
        "roots",
        "var heads: array[native_mut_ptr[u8], 8]\nfunc write_head(index: u64, value: native_mut_ptr[u8]): heads[index] = value\n",
    )])
    match statement(pointer_state, pointer_state.functions[0], 0):
        GlobalPlaceAssignment(global, steps, operation, value):
            assert(global == 0)
            assert(steps.count == 2)
            assert(u32(entry_at(pointer_state, steps, 0)) == place_element_step)
        else: assert(false)
    match statement(program, program.functions[0], 1):
        ReturnStatement(value):
            match form(program, value):
                GlobalLoad(global): assert(global == 0)
                else: assert(false)
        else: assert(false)

    let import_failure = runtime_failure([
        source_module("state", "var cursor: u64\n"),
        source_module("other", "from state import cursor\nfunc read() -> u64: return cursor\n"),
    ])
    assert(import_failure == "other.luc:1:19: module `state` has no declaration `cursor`")
    let default_failure = runtime_failure([source_module(
        "state",
        "var cursor: u64\nfunc read(value: u64 = cursor) -> u64: return value\n",
    )])
    assert(default_failure == "state.luc:2:24: default of parameter `value` must be a constant expression")

pub func test_c_imports_and_exports_share_the_function_and_call_model():
    let sources = [
        source_module("ffi", "pub extern func abs(value: i32) -> i32\n"),
        source_module("main", "from ffi import abs\nexport c func luce_twice(value: i32) -> i32: return value * 2\nfunc answer() -> i32: return luce_twice(abs(-21i32))\n"),
    ]
    let program = checked(sources)
    assert(len(program.functions) == 3)
    match program.functions[0].implementation:
        ExternalC(contract): assert(not contract.is_blocking)
        else: assert(false)
    match program.functions[1].implementation:
        ExportedC(body): assert(i64(body.count) == 1)
        else: assert(false)
    match program.functions[2].implementation:
        Defined(body): pass
        else: assert(false)
    match statement(program, program.functions[2], 0):
        ReturnStatement(value):
            match form(program, value):
                Call(function, arguments):
                    assert(function.value == program.functions[1].symbol.value)
                    match form(program, argument_node(program, arguments, 0)):
                        Call(external, external_arguments): assert(external.value == program.functions[0].symbol.value)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_direct_c_functions_admit_borrowed_strings_and_lists_but_reject_unsupported_boundary_shapes():
    let borrowed = checked([source_module("main", "extern type Window\nextern func inspect(text: str, values: list[i32], handles: list[Window], pointers: list[foreign], out copy: str) -> str\n")])
    assert(describe_type(borrowed.types, borrowed.functions[0].parameters[0].value_type) == "str")
    assert(describe_type(borrowed.types, borrowed.functions[0].parameters[1].value_type) == "list[i32]")
    assert(describe_type(borrowed.types, borrowed.functions[0].parameters[2].value_type) == "list[Window]")
    assert(describe_type(borrowed.types, borrowed.functions[0].parameters[3].value_type) == "list[foreign]")
    assert(describe_type(borrowed.types, borrowed.functions[0].result) == "(str, str)")
    expect_failure(
        [source_module("main", "export c func defaulted(value: i32 = 1) -> i32: return value\n")],
        "main.luc:1:25: an exported C parameter takes no default",
    )
    expect_failure(
        [source_module("main", "extern func half(value: f16) -> f16\n")],
        "main.luc:1:18: extern function `half` parameter `value` has unsupported boundary type `f16`",
    )
    expect_failure(
        [source_module("main", "extern var half: f16\n")],
        "main.luc:1:18: extern variable `half` has unsupported boundary type `f16`",
    )
    expect_failure(
        [source_module("main", "extern func fill(out values: list[i32])\n")],
        "main.luc:1:18: extern function `fill` out parameter `values` cannot be a list; writable C arrays require a generated shim",
    )
    expect_failure(
        [source_module("main", "extern func read() -> list[i32]\n")],
        "main.luc:1:1: extern function `read` cannot return a list; copy C-owned arrays through the explicit inbound-memory API",
    )
    expect_failure(
        [source_module("main", "extern func text(values: list[str])\n")],
        "main.luc:1:18: extern function `text` borrowed list parameter `values` has unsupported element type `str`; use a boundary scalar, named handle, or `foreign`",
    )
    expect_failure(
        [source_module("main", "extern func nested(values: list[list[i32]])\n")],
        "main.luc:1:20: extern function `nested` borrowed list parameter `values` has unsupported element type `list[i32]`; use a boundary scalar, named handle, or `foreign`",
    )

pub func test_c_out_parameters_are_results_but_retain_declaration_order():
    let program = checked([source_module("main", "extern type Window\nextern func split(value: i32, out rest: i32, out window: Window?) -> i32\nextern func read(out value: i32)\n")])
    let function = program.functions[0]
    assert(len(function.parameters) == 1)
    assert(function.parameters[0].name == "value")
    assert(describe_type(program.types, function.result) == "(i32, i32, Window?)")
    match function.implementation:
        ExternalC(contract):
            assert(len(contract.slots) == 3)
            assert(describe_type(program.types, contract.declared_result) == "i32")
            match contract.slots[0]:
                Input(parameter): assert(parameter == 0)
                else: assert(false)
            match contract.slots[1]:
                Output(name, value_type): assert(name == "rest" and describe_type(program.types, value_type) == "i32")
                else: assert(false)
            match contract.slots[2]:
                Output(name, value_type): assert(name == "window" and describe_type(program.types, value_type) == "Window?")
                else: assert(false)
        else: assert(false)
    # Void contributes no component, so a single output is returned directly
    # instead of being wrapped in a one-element tuple.
    assert(len(program.functions[1].parameters) == 0)
    assert(describe_type(program.types, program.functions[1].result) == "i32")

pub func test_extern_structs_are_ordinary_nominal_values_with_one_boundary_capability():
    let source = "pub extern type Window\npub extern struct Pair:\n    window: Window\n    count: i32\npub extern struct Nested:\n    pair: Pair\n    scale: f64\nextern func inspect(value: Nested, out changed: Nested) -> i32\npub func build(window: Window) -> Nested:\n    return Nested(Pair(window, 41i32), 2.0)\npub func same(left: Pair, right: Pair) -> bool: return left == right\n"
    let program = checked([source_module("main", source)])
    assert(len(program.structs) == 2)
    let first_kind = program.structs[0].c_kind else trap("missing external struct role")
    let second_kind = program.structs[1].c_kind else trap("missing external struct role")
    assert(first_kind == HirCStructKind.external)
    assert(second_kind == HirCStructKind.external)
    assert(program.structs[0].fields[0].is_public)
    assert(not program.structs[0].fields[0].is_mutable)
    assert(describe_type(program.types, program.structs[1].fields[0].value_type) == "Pair")
    let inspect = program.functions[0]
    assert(describe_type(program.types, inspect.parameters[0].value_type) == "Nested")
    assert(describe_type(program.types, inspect.result) == "(i32, Nested)")
    match inspect.implementation:
        ExternalC(contract):
            match contract.slots[0]:
                Input(parameter): assert(parameter == 0)
                else: assert(false)
            match contract.slots[1]:
                Output(name, value_type): assert(name == "changed" and describe_type(program.types, value_type) == "Nested")
                else: assert(false)
        else: assert(false)

pub func test_extern_structs_share_defaults_methods_initializers_and_conformances():
    let source = "interface Measured:\n    func total(self) -> i64\npub extern struct Pair implements Measured:\n    ## Left component.\n    left: i64 = 20\n    right: i64 = 22\n    pub func total(self) -> i64: return self.left + self.right\nextern struct Frame:\n    value: i64\n    func init(self, value: i64): self.value = value\nfunc measure(value: Measured) -> i64: return value.total()\nfunc answer() -> i64: return measure(Pair()) + Frame(1).value\n"
    let program = checked([source_module("main", source)])
    assert(len(program.structs) == 2)
    let pair = program.structs[0]
    let pair_kind = pair.c_kind else trap("missing external struct role")
    assert(pair_kind == HirCStructKind.external)
    assert(pair.fields[0].is_public and not pair.fields[0].is_mutable)
    assert(pair.fields[0].documentation[0] == "Left component.")
    assert(pair.fields[0].default_value.value != no_node)
    assert(pair.fields[1].default_value.value != no_node)
    assert(pair.initializer == none)
    let nested_kind = program.structs[1].c_kind else trap("missing external struct role")
    assert(nested_kind == HirCStructKind.external)
    assert(program.structs[1].initializer != none)
    assert(len(program.conformances) == 1)
    assert(describe_type(program.types, program.conformances[0].value_type) == "Pair")
    assert(describe_type(program.types, program.conformances[0].interface_type) == "Measured")

pub func test_extern_structs_enforce_the_closed_pointer_crossing_surface():
    expect_failure(
        [source_module("main", "extern struct Text:\n    value: str\n")],
        "main.luc:2:5: extern struct `Text` field `value` has unsupported C layout type `str`",
    )
    expect_failure(
        [source_module("main", "struct Local:\n    let value: i32\nextern struct Bad:\n    value: Local\n")],
        "main.luc:4:5: extern struct `Bad` field `value` has unsupported C layout type `Local`",
    )
    expect_failure(
        [source_module("main", "extern struct Rect:\n    x: i32\nfunc bad(value: Rect?): return\n")],
        "main.luc:3:17: extern struct `Rect` is a value, not a nullable C pointer",
    )
    expect_failure(
        [source_module("main", "extern struct Rect:\n    x: i32\nextern func bad() -> Rect\n")],
        "main.luc:3:1: extern function `bad` cannot return extern struct `Rect` by value; declare it as an `out` parameter or use a generated C shim",
    )
    expect_failure(
        [source_module("main", "extern struct Recursive:\n    value: Recursive\n")],
        "main.luc:1:1: extern struct `Recursive` contains itself through field `value`",
    )

pub func test_integer_extern_types_are_nominal_and_resolve_across_modules():
    let sources = [
        source_module("ffi", "pub extern type Pid = i32\npub extern func echo_pid(value: Pid) -> Pid\n"),
        source_module("main", "import ffi\npub func same(value: ffi.Pid) -> bool: return ffi.echo_pid(value) == value\n"),
    ]
    let program = checked(sources)
    assert(len(program.extern_types) == 1)
    let handle = program.extern_types[0]
    assert(handle.name == "Pid")
    assert(handle.module.value == 0)
    assert(handle.is_public)
    var representation = resolve_builtin_type(BuiltinType.unit)
    match handle.representation:
        Integer(value_type): representation = value_type
        else: assert(false)
    assert(types_match(representation, resolve_builtin_type(BuiltinType.signed_i32)))
    let handle_type = program.functions[0].parameters[0].value_type
    assert(types_match(handle_type, program.functions[0].result))
    assert(not types_match(handle_type, representation))
    match program.types.definitions[handle_type.value].form:
        Extern(index): assert(index == 0)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    match operation:
                        Equal(operand_type): assert(types_match(operand_type, handle_type))
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_pointer_extern_types_are_nominal_and_nullable_only_at_the_boundary():
    let program = checked([source_module("main", "extern type Window\nextern func create() -> Window?\nextern func show(window: Window)\n")])
    assert(len(program.extern_types) == 1)
    match program.extern_types[0].representation:
        Pointer: pass
        else: assert(false)
    let handle_type = program.functions[1].parameters[0].value_type
    match program.types.definitions[handle_type.value].form:
        Extern(index): assert(index == 0)
        else: assert(false)
    match program.types.definitions[program.functions[0].result.value].form:
        Optional(inner): assert(types_match(inner, handle_type))
        else: assert(false)

