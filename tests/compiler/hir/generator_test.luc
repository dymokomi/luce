            source_module("ffi", "extern type Private = i32\n"),
            source_module("main", "import ffi\nfunc use(value: ffi.Private) -> bool: return value == value\n"),
        ],
        "main.luc:2:17: `Private` is private to module `ffi`",
    )

pub func test_extern_handles_cannot_be_forged_or_used_as_integers():
    expect_failure(
        [source_module("main", "extern type Pid = i32\nfunc forge() -> Pid: return 1\n")],
        "main.luc:2:29: expected `Pid`, found `i64`",
    )
    expect_failure(
        [source_module("main", "extern type Pid = i32\nfunc add(value: Pid) -> Pid: return value + value\n")],
        "main.luc:2:37: `+` requires numeric operands",
