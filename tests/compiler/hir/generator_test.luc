    expect_failure(
        [source_module("main", "extern type First = i32\nextern type Second = i32\nextern func consume(value: First)\nfunc wrong(value: Second): consume(value)\n")],
        "main.luc:4:36: expected `First`, found `Second`",
    )

pub func test_selective_imports_resolve_to_stable_function_symbols():
    let sources = [
        source_module("math", "pub func double(value: i64) -> i64: return value * 2\n"),
        source_module("main", "from math import double\nfunc answer() -> i64:\n    let value = double(21)\n    return value\n"),
    ]
    let program = checked(sources)
    assert(len(program.modules) == 2)
    assert(len(program.functions) == 2)
    assert(describe_type(program.types, program.functions[0].result) == "i64")
    let double_symbol = program.functions[0].symbol.value
    let answer = program.functions[1]
    assert(answer.module.value == program.modules[1].id.value)
    assert(i64(function_body(answer).count) == 2)
    match statement(program, answer, 0):
        Binding(symbol, is_mutable, value):
            assert(program.symbols[i64(symbol.value)].name == "value")
            assert(not is_mutable)
            assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.signed_i64)))
            match form(program, value):
                Call(function, arguments):
                    assert(function.value == double_symbol)
                    assert(argument_parameter(program, arguments, 0) == 0)
                else: assert(false)
        else: assert(false)

pub func test_qualified_calls_resolve_public_members_and_named_arguments():
    let sources = [
        source_module("math", "pub func subtract(left: i64, right: i64) -> i64: return left - right\n"),
        source_module("main", "import math as arithmetic\nfunc answer() -> i64: return arithmetic.subtract(right = 1, left = 3)\n"),
    ]
    let program = checked(sources)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                Call(function, arguments):
                    assert(argument_parameter(program, arguments, 0) == 1)
                    assert(argument_parameter(program, arguments, 1) == 0)
                else: assert(false)
        else: assert(false)

pub func test_call_defaults_resolve_imported_constants_and_enforce_the_exact_argument_contract():
    let settings = source_module("settings", "pub let standard: i64 = 40\n")
    let qualified = source_module(
        "qualified",
        "import settings\npub func choose(value: i64 = settings.standard) -> i64: return value\n",
    )
    let selective = source_module(
        "selective",
        "from settings import standard\npub func choose(value: i64 = standard) -> i64: return value\n",
    )
    let client = source_module(
        "main",
        "import qualified\nimport selective\nfunc answer() -> i64: return qualified.choose() + selective.choose() - 38\n",
    )
    let program = checked([settings, qualified, selective, client])
    assert(program.functions[0].parameters[0].default_value.value != no_node)
    assert(program.functions[1].parameters[0].default_value.value != no_node)

    let target = "func target(first: i64, second: i64 = 2, third: i64 = 3): return\n"
    expect_failure(
        [source_module("main", target + "func bad(): target(second = 2, 1)\n")],
        "main.luc:2:32: positional arguments must precede named arguments",
    )
    expect_failure(
        [source_module("main", target + "func bad(): target(1, first = 2)\n")],
        "main.luc:2:23: parameter `first` is supplied more than once",
    )
    expect_failure(
        [source_module("main", target + "func bad(): target(unknown = 1)\n")],
        "main.luc:2:20: function `target` has no parameter `unknown`",
    )
    expect_failure(
        [source_module("main", target + "func bad(): target()\n")],
        "main.luc:2:13: call to `target` is missing argument `first`",
    )
    expect_failure(
        [source_module("main", target + "func bad(): target(1, 2, 3, 4)\n")],
        "main.luc:2:29: function `target` accepts 3 argument(s)",
    )
    expect_failure(
        [source_module("main", "func runtime() -> i64: return 1\nfunc target(value: i64 = runtime()): return\n")],
        "main.luc:2:26: default of parameter `value` must be a constant expression",
    )
    expect_failure(
        [source_module("main", "func target(first: i64, second: i64 = first): return\n")],
        "main.luc:1:39: unknown name `first`",
    )

pub func test_bindings_assignment_and_control_flow_are_typed():
    let source = "func update():\n    var value: i64 = 0\n    while value < 2:\n        value += 1\n        if value == 1: continue\n        break\n"
    let program = checked([source_module("main", source)])
    let update = program.functions[0]
    assert(i64(function_body(update).count) == 2)
    assert(str(statement(program, update, 0)) == "Binding")
    match statement(program, update, 1):
        WhileStatement(condition, loop_body):
            assert(types_match(node_type(program, condition), resolve_builtin_type(BuiltinType.boolean)))
            match form(program, condition):
                Binary(left, operation, right):
                    match operation:
                        Less(operand_type): assert(types_match(operand_type, resolve_builtin_type(BuiltinType.signed_i64)))
                        else: assert(false)
                else: assert(false)
            match node_form(program, node_at(program, loop_body, 0)):
                Assignment(symbol, operation, value):
                    match operation:
                        Combine(binary):
                            match binary:
                                Add(operand_type): assert(types_match(operand_type, resolve_builtin_type(BuiltinType.signed_i64)))
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
            assert(str(node_form(program, node_at(program, loop_body, 1))) == "IfStatement")
            assert(str(node_form(program, node_at(program, loop_body, 2))) == "BreakStatement")
        else: assert(false)

pub func test_control_flow_scopes_exits_and_returns_have_exact_boundaries():
    expect_failure(
        [source_module("main", "func bad():\n    break\n")],
        "main.luc:2:5: `break` is only valid inside a loop",
    )
    expect_failure(
        [source_module("main", "func bad():\n    continue\n")],
        "main.luc:2:5: `continue` is only valid inside a loop",
    )
    expect_failure(
        [source_module("main", "func bad():\n    for value in 0..<2:\n        value = 3\n")],
        "main.luc:3:9: cannot assign to immutable binding `value`; declare it with `var`",
    )
    expect_failure(
        [source_module("main", "func bad(flag: bool) -> i64:\n    if flag:\n        let scoped = 1\n    return scoped\n")],
        "main.luc:4:12: unknown name `scoped`",
    )
    expect_failure(
        [source_module("main", "func bad(): return 1\n")],
        "main.luc:1:13: a `unit` function cannot return a value",
    )
    expect_failure(
        [source_module("main", "func bad() -> i64: return\n")],
        "main.luc:1:20: return requires a `i64` value",
    )

pub func test_conditional_binding_is_one_resolved_optional_match():
    let source = "func choose(value: i64?) -> i64:\n    if let selected = value:\n        return selected * 2\n    else:\n        return 7\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        Match(subject, arms, has_result):
            assert(not has_result)
            assert(types_match(node_type(program, subject), program.functions[0].parameters[0].value_type))
            assert(arms.count == 2)
            match node_form(program, node_at(program, arms, 0)):
                MatchArm(patterns, statements, value):
                    assert(value.value == no_node and patterns.count == 1 and statements.count == 1)
                    match node_form(program, node_at(program, patterns, 0)):
                        PatternCase(case_index, bindings):
                            assert(case_index == 1 and bindings.count == 1)
                            let symbol = u32(entry_at(program, bindings, 0))
                            assert(program.symbols[symbol].name == "selected")
                            assert(describe_type(program.types, program.symbols[symbol].value_type) == "i64")
                        else: assert(false)
                else: assert(false)
            match node_form(program, node_at(program, arms, 1)):
                MatchArm(patterns, statements, value):
                    assert(value.value == no_node and patterns.count == 1 and statements.count == 1)
                    match node_form(program, node_at(program, patterns, 0)):
                        PatternCase(case_index, bindings): assert(case_index == 0 and bindings.count == 0)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func bad(value: i64):\n    if let selected = value: return\n")],
        "main.luc:2:8: `if let` requires an optional value, found `i64`",
    )
    expect_failure(
        [source_module("main", "func leaked(value: i64?) -> i64:\n    if let selected = value: return selected\n    return selected\n")],
        "main.luc:3:12: unknown name `selected`",
    )
    expect_failure(
        [source_module("main", "func duplicate(value: i64?):\n    let selected = 0\n    if let selected = value: return\n")],
        "main.luc:3:8: `selected` is already bound in this scope",
    )

pub func test_integer_ranges_and_for_bindings_are_typed():
    let source = "func total(values: range[u8]) -> i64:\n    var result = 0\n    for value in values:\n        if value == 2u8: continue\n        result += 1\n    return result\nfunc use() -> i64: return total(0u8..=3u8)\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].parameters[0].value_type) == "range[u8]")
    match statement(program, program.functions[0], 1):
        ForStatement(symbol, iteration, body):
            assert(program.symbols[symbol.value].name == "value")
            assert(describe_type(program.types, program.symbols[symbol.value].value_type) == "u8")
            match iteration:
                Builtin(iterable): assert(describe_type(program.types, node_type(program, iterable)) == "range[u8]")
                Protocol(iterator_symbol, iterator, next): assert(false)
            assert(i64(body.count) == 2)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                Call(function, arguments):
                    match form(program, argument_node(program, arguments, 0)):
                        Range(lower, upper, inclusive):
                            assert(inclusive)
                            assert(describe_type(program.types, node_type(program, lower)) == "u8")
                            assert(describe_type(program.types, node_type(program, upper)) == "u8")
                        else: assert(false)
                else: assert(false)
        else: assert(false)

pub func test_list_iteration_uses_the_common_typed_for_shape():
    let source = "func total(values: list[i64]) -> i64:\n    var result = 0\n    for value in values:\n        result += value\n    return result\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 1):
        ForStatement(symbol, iteration, body):
            assert(program.symbols[symbol.value].name == "value")
            assert(describe_type(program.types, program.symbols[symbol.value].value_type) == "i64")
            match iteration:
                Builtin(iterable): assert(describe_type(program.types, node_type(program, iterable)) == "list[i64]")
                Protocol(iterator_symbol, iterator, next): assert(false)
            assert(i64(body.count) == 1)
        else: assert(false)

pub func test_conditional_expressions_choose_one_symmetric_common_type():
    let source = "func stop() -> never: trap(\"stop\")\nfunc inspect(flag: bool):\n    let optional: i64? = none\n    let promoted = 42 if flag else optional\n    let reversed = optional if flag else 42\n    let absent = none if flag else 42\n    let surviving = stop() if false else 42\n"
    let program = checked([source_module("main", source)])
    let inspect = program.functions[1]
    for index in range(1, 5):
        match statement(program, inspect, index):
            Binding(symbol, is_mutable, value):
                if index < 4: assert(describe_type(program.types, node_type(program, value)) == "i64?")
                else: assert(describe_type(program.types, node_type(program, value)) == "i64")
                match form(program, value):
                    Conditional(selected, condition, alternative):
                        if index == 1: assert(str(form(program, selected)) == "Some")
                        elif index == 2: assert(str(form(program, alternative)) == "Some")
                        elif index == 3:
                            assert(str(form(program, selected)) == "NoneLiteral")
                            assert(str(form(program, alternative)) == "Some")
                        else: assert(str(form(program, selected)) == "NeverCoercion")
                    else: assert(false)
            else: assert(false)

    expect_failure(
        [source_module("main", "func bad(): let value = 1 if true else false\n")],
        "main.luc:1:25: conditional expression arms have no common type (`i64` and `bool`)",
    )
    expect_failure(
        [source_module("main", "func bad(): let value = none if true else none\n")],
        "main.luc:1:25: conditional expression arms need a type from context",
    )

pub func test_unsuffixed_integer_literals_receive_context_from_either_operand():
    let source = "func scale(value: (i32)) -> (i32): return 5 * value\nfunc equals(value: i32) -> bool: return 5 == value\n"
    let program = checked([source_module("main", source)])
    assert(len(program.functions) == 2)
    assert_i32_binary_operands(program, program.functions[0])
    assert_i32_binary_operands(program, program.functions[1])

pub func test_native_entry_print_is_typed_with_its_i32_result():
    let source = "pub func main(arguments: slice[str]) -> i32!:\n    print(\"Hello, world!\")\n    return 0\n"
    let program = checked([source_module("hello", source)])
    let function = program.functions[0]
    let entry = program.process_entry else trap("valid process entry was not selected")
    assert(entry.value == function.symbol.value)
    assert(describe_type(program.types, function.parameters[0].value_type) == "slice[str]")
    match program.types.definitions[function.result.value].form:
        Fallible(success): assert(types_match(success, resolve_builtin_type(BuiltinType.signed_i32)))
        else: assert(false)
    match statement(program, function, 0):
        PrintText(value): assert(value == "Hello, world!")
        else: assert(false)
    match statement(program, function, 1):
        ReturnStatement(value):
            assert(value.value != no_node)
            assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.signed_i32)))
        else: assert(false)

pub func test_process_entry_is_an_optional_exact_root_package_identity():
    let no_entry = checked([
        source_module("ordinary", "pub func answer() -> i32: return 42\n"),
        source_module("types", "struct Runner:\n    pub func main(self) -> i32: return 0\nfunc main(arguments: slice[str]) -> i32!: return 0\n"),
    ])
    assert(no_entry.process_entry == none)

    let program = checked([
        source_module("helper", "pub func answer() -> i32: return 42\n"),
        source_module("command", "pub func main(arguments: slice[str]) -> i32!: return 0\n"),
    ])
    let entry = program.process_entry else trap("root package entry was not selected")
    assert(entry.value == program.functions[1].symbol.value)

pub func test_process_entry_contract_has_stable_diagnostics():
    expect_failure(
        [source_module("main", "pub func main() -> i32!: return 0\n")],
        "main.luc:1:1: invalid process entry `main`: must declare exactly one `arguments: slice[str]` parameter; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [source_module("main", "pub func main(args: slice[str]) -> i32!: return 0\n")],
        "main.luc:1:1: invalid process entry `main`: parameter must be named `arguments`; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [source_module("main", "pub func main(arguments: list[str]) -> i32!: return 0\n")],
        "main.luc:1:1: invalid process entry `main`: parameter `arguments` must have type `slice[str]`; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [source_module("main", "pub func main(arguments: slice[str] = []) -> i32!: return 0\n")],
        "main.luc:1:1: invalid process entry `main`: parameter `arguments` cannot have a default; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [source_module("main", "pub func main(arguments: slice[str]) -> i32: return 0\n")],
        "main.luc:1:1: invalid process entry `main`: result must be `i32!`; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [source_module("main", "pub func main[T](arguments: slice[str]) -> i32!: return 0\n")],
        "main.luc:1:1: process entry `main` cannot be generic; expected `pub func main(arguments: slice[str]) -> i32!`",
    )
    expect_failure(
        [
            source_module("first", "pub func main(arguments: slice[str]) -> i32!: return 0\n"),
            source_module("second", "pub func main(arguments: slice[str]) -> i32!: return 0\n"),
        ],
        "second.luc:1:1: package defines more than one public process entry `main`",
    )
pub func test_print_of_a_string_value_is_print_value():
    let source = "func label() -> str: return \"ok\"\npub func answer() -> i64:\n    let name = \"luce\"\n    print(name)\n    print(label())\n    return 0\n"
    let program = checked([source_module("main", source)])
    let function = program.functions[1]
    match statement(program, function, 1):
        PrintValue(value):
            assert(types_match(node_type(program, value), resolve_builtin_type(BuiltinType.string)))
            assert(str(form(program, value)) == "Reference")
        else: assert(false)
    match statement(program, function, 2):
        PrintValue(value): assert(str(form(program, value)) == "Call")
        else: assert(false)
    let wrong = "pub func answer() -> i64:\n    print(5)\n    return 0\n"
    expect_failure([source_module("main", wrong)], "main.luc:2:11: expected `str`, found `i64`")

pub func test_defer_captures_calls_in_hidden_bindings():
    let source = "func show(value: str): print(value)\nfunc work():\n    let text = \"before\"\n    defer show(text)\n    defer print(\"last\")\n"
    let program = checked([source_module("main", source)])
    let work = program.functions[1]
    # `show(text)` becomes a hidden capture binding and a marker. A literal
    # print needs no binding because its value is already fixed in HIR.
    assert(i64(function_body(work).count) == 4)
    var capture_symbol = u32(0)
    match statement(program, work, 1):
        Binding(symbol, is_mutable, value):
            capture_symbol = symbol.value
            assert(is_mutable)
            assert(program.symbols[symbol.value].name[0] == '$')
            assert(str(form(program, value)) == "Reference")
        else: assert(false)
    match statement(program, work, 2):
        DeferStatement(action):
            match form(program, action):
                ExpressionStatement(value):
                    match form(program, value):
                        Call(function, arguments):
                            assert(argument_parameter(program, arguments, 0) == 0)
                            match form(program, argument_node(program, arguments, 0)):
                                Reference(symbol): assert(symbol.value == capture_symbol)
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, work, 3):
        DeferStatement(action):
            match form(program, action):
                PrintText(value): assert(value == "last")
                else: assert(false)
        else: assert(false)

pub func test_defer_requires_a_unit_producing_call():
    expect_failure([source_module("main", "func work():\n    defer 1\n")], "main.luc:2:5: `defer` requires a call")
    expect_failure([source_module("main", "func value() -> i64: return 1\nfunc work():\n    defer value()\n")], "main.luc:3:5: `defer` requires a unit-producing call")
    expect_failure([source_module("main", "let failed: ErrorCode = ErrorCode.package(1)\nfunc cleanup() -> unit!: error(failed, \"cleanup\")\nfunc work():\n    defer cleanup()\n")], "main.luc:4:5: `defer` requires a unit-producing call")
    discard(checked([source_module("main", "let failed: ErrorCode = ErrorCode.package(1)\nfunc noop(): return\nfunc cleanup() -> unit!: error(failed, \"cleanup\")\nfunc safe_cleanup():\n    cleanup() catch failure: recover noop()\nfunc work(): defer safe_cleanup()\n")]))

pub func test_exact_function_values_have_explicit_addresses_and_indirect_calls():
    let source = "func add(left: i64, right: i64) -> i64: return left + right\npub func answer() -> i64:\n    let operation: func(i64, i64) -> i64 = add\n    return operation(20, 22)\n"
    let program = checked([source_module("main", source)])
    let answer = program.functions[1]
    var operation_symbol = u32(0)
    match statement(program, answer, 0):
        Binding(symbol, is_mutable, value):
            operation_symbol = symbol.value
            assert(not is_mutable)
            assert(describe_type(program.types, node_type(program, value)) == "func(i64, i64) -> i64")
            match form(program, value):
                FunctionAddress(function): assert(function.value == program.functions[0].symbol.value)
                else: assert(false)
        else: assert(false)
    match statement(program, answer, 1):
        ReturnStatement(value):
            match form(program, value):
                IndirectCall(callee, arguments):
                    match form(program, callee):
                        Reference(symbol): assert(symbol.value == operation_symbol)
                        else: assert(false)
                    assert(arguments.count == 2)
                else: assert(false)
        else: assert(false)

pub func test_function_value_calls_are_positional_exact_and_separate_from_methods():
    let field = "func add(left: i64, right: i64) -> i64: return left + right\nstruct Calculator:\n    let operation: func(i64, i64) -> i64\npub func answer() -> i64:\n    let calculator = Calculator(operation = add)\n    return calculator.operation(20, 22)\n"
    let program = checked([source_module("main", field)])
    match statement(program, program.functions[1], 1):
        ReturnStatement(value):
            match form(program, value):
                IndirectCall(callee, arguments):
                    match form(program, callee):
                        FieldAccess(owner, field_index): assert(field_index == 0)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func add(left: i64, right: i64) -> i64: return left + right\nfunc answer() -> i64:\n    let operation: func(i64, i64) -> i64 = add\n    return operation(left = 20, right = 22)\n")],
        "main.luc:4:22: function-value calls use positional arguments because labels are not part of the type",
    )
    expect_failure(
        [source_module("main", "extern func abs(value: i32) -> i32\nfunc answer():\n    let operation: func(i32) -> i32 = abs\n")],
        "main.luc:3:39: expected `func(i32) -> i32`, found `cfunc(i32) -> i32`",
    )
    let lifted = checked([source_module("main", "func plain(value: i64) -> i64: return value\nfunc answer():\n    let operation: func(i64) -> i64! = plain\n")])
    assert(len(lifted.closures) == 1)
    assert(len(lifted.closures[0].captures) == 1)
    assert(describe_type(lifted.types, lifted.closures[0].captures[0].value_type) == "func(i64) -> i64")
    match statement(lifted, lifted.functions[1], 0):
        Binding(symbol, is_mutable, value):
            match form(lifted, value):
                ClosureValue(closure, initializers): assert(initializers.count == 1)
                else: assert(false)
        else: assert(false)

pub func test_cfunc_values_share_indirect_calls_but_retain_the_c_convention():
    let source = "extern func abs(value: i32) -> i32\nfunc negate(value: i32) -> i32: return -value\nfunc apply(operation: cfunc(i32) -> i32, value: i32) -> i32:\n    return operation(value)\nfunc answer() -> i32:\n    let local: cfunc(i32) -> i32 = negate\n    let imported: cfunc(i32) -> i32 = abs\n    return apply(local, -20i32) + apply(imported, -22i32)\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[2].parameters[0].value_type) == "cfunc(i32) -> i32")
    match statement(program, program.functions[2], 0):
        ReturnStatement(value):
            match form(program, value):
                IndirectCall(callee, arguments):
                    assert(describe_type(program.types, node_type(program, callee)) == "cfunc(i32) -> i32")
                    assert(arguments.count == 1)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                FunctionAddress(function):
                    assert(function.value == program.functions[1].symbol.value)
                    assert(describe_type(program.types, node_type(program, value)) == "cfunc(i32) -> i32")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 1):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                FunctionAddress(function): assert(function.value == program.functions[0].symbol.value)
                else: assert(false)
        else: assert(false)

pub func test_cfunc_signatures_and_conversions_enforce_the_closed_c_surface():
    expect_failure(
        [source_module("main", "func bad(value: cfunc(str) -> i32): return\n")],
        "main.luc:1:23: a `cfunc` parameter has unsupported C boundary type `str`",
    )
    expect_failure(
        [source_module("main", "func may_fail(value: i32) -> i32!: return value\nfunc use():\n    let callback: cfunc(i32) -> i32 = may_fail\n")],
        "main.luc:3:39: fallible function `may_fail` cannot become a `cfunc` value",
    )
    expect_failure(
        [source_module("main", "extern func split(value: i32, out rest: i32) -> i32\nfunc use():\n    let callback: cfunc(i32) -> i32 = split\n")],
        "main.luc:3:39: extern function `split` has `out` slots and cannot become a `cfunc` value",
    )
    expect_failure(
        [source_module("main", "export c func invoke(callback: cfunc(i32) -> i32, value: i32) -> i32: return callback(value)\n")],
        "main.luc:1:1: exported C function `invoke` parameter `callback` has unsupported boundary type `cfunc(i32) -> i32`",
    )

pub func test_cfunc_pointers_may_arrive_in_results_outputs_optionals_and_extern_structs():
    let source = "type Callback = cfunc(i32) -> i32\nextern struct Hooks:\n    callback: Callback\nextern func acquire() -> Callback\nextern func maybe_acquire() -> Callback?\nextern func read(out callback: Callback, out optional_callback: Callback?)\nextern func read_hooks(out hooks: Hooks)\nfunc invoke(callback: Callback, value: i32) -> i32: return callback(value)\n"
    let program = checked([source_module("main", source)])
    let hooks_kind = program.structs[0].c_kind else trap("missing external struct role")
    assert(hooks_kind == HirCStructKind.external)
    assert(describe_type(program.types, program.structs[0].fields[0].value_type) == "cfunc(i32) -> i32")
    assert(describe_type(program.types, program.functions[0].result) == "cfunc(i32) -> i32")
    assert(describe_type(program.types, program.functions[1].result) == "cfunc(i32) -> i32?")
    assert(describe_type(program.types, program.functions[2].result) == "(cfunc(i32) -> i32, cfunc(i32) -> i32?)")
    assert(describe_type(program.types, program.functions[3].result) == "Hooks")

pub func test_foreign_is_the_anonymous_raw_data_pointer_boundary_type():
    let source = "extern struct NativeBuffer:\n    base: foreign\n    length: u64\ntype Disposer = cfunc(foreign) -> unit\nextern func allocate(size: u64) -> foreign?\nextern func required() -> foreign\nextern func fill(out value: foreign?)\nextern func consume(value: foreign)\nfunc same(left: foreign, right: foreign) -> bool: return left == right\n"
    let program = checked([source_module("main", source)])
    assert(types_match(program.structs[0].fields[0].value_type, resolve_builtin_type(BuiltinType.foreign)))
    assert(describe_type(program.types, program.structs[0].fields[0].value_type) == "foreign")
    assert(describe_type(program.types, program.functions[0].result) == "foreign?")
    assert(types_match(program.functions[1].result, resolve_builtin_type(BuiltinType.foreign)))
    assert(describe_type(program.types, program.functions[2].result) == "foreign?")
    assert(types_match(program.functions[3].parameters[0].value_type, resolve_builtin_type(BuiltinType.foreign)))

    expect_failure(
        [source_module("main", "extern var raw: foreign\n")],
        "main.luc:1:17: extern variable `raw` has unsupported boundary type `foreign`",
    )
    expect_failure(
        [source_module("main", "func bad(value: foreign) -> u64: return hash(value)\n")],
        "main.luc:1:46: `hash` requires a `Hashable` value, found `foreign`",
    )

# mark: Structs and methods =================================================================

pub func test_structs_retain_documentation_defaults_and_receivers():
    let documented_module = checked([source_module("main", "## The module.\n\nlet value = 1\n")])
    assert(documented_module.modules[0].documentation[0] == "The module.")
    let source = "## A point.\npub struct Point:\n    ## Horizontal.\n    pub let x: i64 = 0\n    pub var y: i64\n    ## Sum of both.\n    pub func total(self, extra: i64 = 1) -> i64: return self.x + self.y + extra\n    mutating func shift(self, by: i64): self.y += by\n    func origin() -> Point: return Point(y = 0)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.structs) == 1)
    let point = program.structs[0]
    assert(point.name == "Point" and point.is_public)
    assert(point.initializer == none)
    assert(point.documentation[0] == "A point.")
    assert(len(point.fields) == 2)
    assert(point.fields[0].documentation[0] == "Horizontal.")
    assert(point.fields[0].default_value.value != no_node)
    assert(point.fields[1].default_value.value == no_node)
    assert(point.fields[1].is_mutable and not point.fields[0].is_mutable)
    assert(len(program.functions) == 3)
    let total = program.functions[0]
    assert(total.documentation[0] == "Sum of both.")
    let receiver = total.receiver else trap("method has no receiver")
    assert(describe_type(program.types, receiver.owner) == "Point" and receiver.kind == HirReceiverKind.value_method)
    assert(total.parameters[0].name == "self")
    assert(types_match(total.parameters[0].value_type, point.fields[0].value_type) == false)
    assert(describe_type(program.types, total.parameters[0].value_type) == "Point")
    assert(total.parameters[1].default_value.value != no_node)
    let shift = program.functions[1].receiver else trap("method has no receiver")
    assert(shift.kind == HirReceiverKind.mutating_method)
    let origin = program.functions[2].receiver else trap("type function has no receiver")
    assert(origin.kind == HirReceiverKind.type_function)

pub func test_struct_construction_and_calls_are_resolved_positionally():
    let source = "struct Point:\n    let x: i64 = 0\n    let y: i64\n    func total(self, extra: i64 = 1) -> i64: return self.x + self.y + extra\npub func answer() -> i64:\n    let p = Point(y = 5)\n    return p.total()\n"
    let program = checked([source_module("main", source)])
    let answer = program.functions[1]
    match statement(program, answer, 0):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                StructValue(struct_index, fields):
                    assert(struct_index == 0)
                    assert(i64(fields.count) == 4)
                    # Explicit `y` precedes the defaulted `x` in evaluation
                    # order while each pair retains its declaration slot.
                    assert(entry_at(program, fields, 0) == 1)
                    assert(entry_at(program, fields, 2) == 0)
                    assert(str(node_form(program, NodeId(value = u32(entry_at(program, fields, 3))))) == "Constant")
                else: assert(false)
        else: assert(false)
    match statement(program, answer, 1):
        ReturnStatement(value):
            match form(program, value):
                Call(function, arguments):
                    # The receiver is argument 0; the default fills argument 1.
                    assert(i64(arguments.count) == 4)
                    assert(argument_parameter(program, arguments, 0) == 0)
                    assert(str(form(program, argument_node(program, arguments, 0))) == "Reference")
                    assert(argument_parameter(program, arguments, 1) == 1)
                    assert(str(form(program, argument_node(program, arguments, 1))) == "Constant")
                else: assert(false)
        else: assert(false)

pub func test_custom_initializers_are_explicit_construction_nodes():
    let source = "struct Point:\n    let x: i64\n    let y: i64\n    func init(self, x: i64, y: i64 = 2):\n        self.x = x\n        self.y = y\npub func answer() -> i64:\n    let p = Point(y = 4, x = 3)\n    return p.x + p.y\n"
    let program = checked([source_module("main", source)])
    let initializer = program.functions[0]
    let initializer_symbol = program.structs[0].initializer else trap("struct lost its initializer")
    assert(initializer_symbol.value == initializer.symbol.value)
    let receiver = initializer.receiver else trap("initializer has no receiver")
    assert(receiver.kind == HirReceiverKind.initializer)
    assert(describe_type(program.types, initializer.result) == "unit")
    match statement(program, program.functions[1], 0):
        Binding(symbol, is_mutable, value):
            assert(describe_type(program.types, node_type(program, value)) == "Point")
            match form(program, value):
                Initialize(function, arguments):
                    assert(function.value == initializer.symbol.value)
                    assert(i64(arguments.count) == 4)
                    assert(argument_parameter(program, arguments, 0) == 2)
                    assert(argument_parameter(program, arguments, 1) == 1)
                else: assert(false)
        else: assert(false)

    let fallible_source = "let invalid: ErrorCode = ErrorCode.package(1)\nstruct Checked:\n    let value: i64\n    func init(self, value: i64) -> unit!:\n        if value < 0: error(invalid, \"negative\")\n        self.value = value\nfunc make() -> Checked!: return try Checked(1)\n"
    let fallible = checked([source_module("main", fallible_source)])
    match statement(fallible, fallible.functions[1], 0):
        ReturnStatement(value):
            match form(fallible, value):
                Try(initialized):
                    assert(describe_type(fallible.types, node_type(fallible, initialized)) == "Checked!")
                    assert(str(form(fallible, initialized)) == "Initialize")
                else: assert(false)
        else: assert(false)

pub func test_struct_rules_are_enforced():
    let point = "struct Point:\n    let x: i64\n    var y: i64\n    func total(self) -> i64: return self.x + self.y\n    mutating func shift(self): self.y += 1\n    func origin() -> Point: return Point(x = 0, y = 0)\n"
    expect_failure([source_module("main", point + "func f():\n    var p = Point(x = 1, y = 2)\n    p.x = 3\n")], "main.luc:9:5: cannot assign to `let` field `x`; declare it with `var`")
    expect_failure([source_module("main", point + "func f():\n    let p = Point(x = 1, y = 2)\n    p.y = 3\n")], "main.luc:9:5: cannot assign through immutable binding `p`; declare it with `var`")
    expect_failure([source_module("main", point + "func f():\n    let p = Point(x = 1, y = 2)\n    p.shift()\n")], "main.luc:9:5: mutating method needs a `var` receiver; `p` is immutable")
    expect_failure([source_module("main", point + "func f():\n    Point(x = 1, y = 2).shift()\n")], "main.luc:8:5: mutating method needs a `var` receiver, not a temporary value")
    expect_failure([source_module("main", "struct C:\n    var n: i64\n    func grow(self): self.n = 1\n")], "main.luc:3:22: cannot assign to a field of `self` in a non-mutating method; declare the method `mutating`")
    expect_failure([source_module("main", "struct C:\n    var n: i64\n    func grow(self): self = C(n = 1)\n")], "main.luc:3:22: cannot assign to `self` in a non-mutating method; declare the method `mutating`")
    expect_failure([source_module("main", point + "func f() -> Point: return Point(x = 1)\n")], "main.luc:7:27: construction of `Point` is missing field `y`")
    expect_failure([source_module("main", point + "func f() -> Point: return Point(x = 1, y = 2, z = 3)\n")], "main.luc:7:47: struct `Point` has no field `z`")
    expect_failure([source_module("main", point + "func f() -> i64: return Point(x = 1, y = 2).z\n")], "main.luc:7:25: struct `Point` has no field `z`")
    expect_failure([source_module("main", point + "func f() -> i64: return Point(x = 1, y = 2).total\n")], "main.luc:7:25: `total` is a method of `Point`; call it with `(...)`")
    expect_failure([source_module("main", point + "func f() -> i64: return Point.total()\n")], "main.luc:7:25: `total` takes `self`; call it through a `Point` value")
    expect_failure([source_module("main", point + "func f() -> Point: return Point(x = 1, y = 2).origin()\n")], "main.luc:7:27: `origin` is a type function; call it as `Point.origin(...)`")
    expect_failure([source_module("main", "struct Node:\n    let next: Node?\n")], "main.luc:1:1: struct `Node` contains itself through field `next`; use a class or a collection for recursive data")
    expect_failure([source_module("main", "struct A:\n    let b: B\nstruct B:\n    let a: (i64, A)\n")], "main.luc:3:1: struct `B` contains itself through field `a`; use a class or a collection for recursive data")
    expect_failure([source_module("main", "func base() -> i64: return 1\nstruct S:\n    let n: i64 = base()\n")], "main.luc:3:18: default of field `n` must be a constant expression")
    expect_failure([source_module("main", "func f(a: i64 = 1, b: i64) -> i64: return a + b\n")], "main.luc:1:20: parameter `b` follows a parameter with a default and needs one too")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    func n(self) -> i64: return 1\n")], "main.luc:3:5: `n` is both a field and a method of `S`")
    expect_failure([source_module("main", "struct S:\n    func n(self) -> i64: return 1\n    let n: i64\n")], "main.luc:3:5: `n` is both a field and a method of `S`")
    expect_failure([source_module("main", "struct S:\n    let n: i64\nfunc f() -> i64: return S\n")], "main.luc:3:25: `S` is a type; construct a value with `S(...)` or call a type function with `S.name(...)`")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    func init(n: i64): return\n")], "main.luc:3:5: initializer `init` requires `self` as its first parameter")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    func init(self, n: i64) -> i64: return n\n")], "main.luc:3:5: initializer `init` must return `unit` or `unit!`")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    mutating func init(self, n: i64): self.n = n\n")], "main.luc:3:5: an initializer does not use `mutating`; initialization already writes `self`")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    func init(self, value: i64): self.n = value\nfunc make() -> S: return S(n = 1)\n")], "main.luc:4:28: initializer for `S` has no parameter `n`")
    expect_failure([source_module("main", "struct S:\n    let n: i64\n    func init(self, value: i64): self.n = value\nfunc reset(value: S): value.init(1)\n")], "main.luc:4:23: initializer `init` is called by constructing a `S` value")

pub func test_struct_visibility_crosses_modules_explicitly():
    let shapes = "pub struct Point:\n    pub let x: i64\n    let y: i64 = 0\n    pub func sum(self) -> i64: return self.x + self.y\n    func secret(self) -> i64: return self.y\nstruct Hidden:\n    pub let n: i64\n"
    let ok = "import shapes\nfunc f() -> i64:\n    let p = shapes.Point(x = 1)\n    return p.sum() + p.x\n"
    expect_failure([source_module("shapes", shapes), source_module("main", ok)], "")
    let required_private = "import shapes\nfunc f() -> i64: return shapes.Sealed(n = 1).n\n"
    expect_failure([source_module("shapes", shapes + "pub struct Sealed:\n    pub let n: i64\n    let key: i64\n"), source_module("main", required_private)], "main.luc:2:25: construction of `Sealed` is missing field `key`")
    let private_field = "import shapes\nfunc f() -> i64: return shapes.Point(x = 1).y\n"
    expect_failure([source_module("shapes", shapes), source_module("main", private_field)], "main.luc:2:25: field `y` is private to module `shapes`")
    let private_method = "import shapes\nfunc f() -> i64: return shapes.Point(x = 1).secret()\n"
    expect_failure([source_module("shapes", shapes), source_module("main", private_method)], "main.luc:2:25: `secret` is private to module `shapes`")
    let private_struct = "import shapes\nfunc f() -> i64: return shapes.Hidden(n = 1).n\n"
    expect_failure([source_module("shapes", shapes), source_module("main", private_struct)], "main.luc:2:25: `Hidden` is private to module `shapes`")
    let explicit_private_field = "import shapes\nfunc f() -> i64: return shapes.Point(x = 1, y = 2).x\n"
    expect_failure([source_module("shapes", shapes), source_module("main", explicit_private_field)], "main.luc:2:45: field `y` is private to module `shapes`")
    let custom = "pub struct Opened:\n    pub let value: i64\n    pub func init(self, value: i64): self.value = value\npub struct Closed:\n    let value: i64\n    func init(self, value: i64): self.value = value\n"
    let public_custom = "import shapes\nfunc f() -> i64: return shapes.Opened(7).value\n"
    expect_failure([source_module("shapes", custom), source_module("main", public_custom)], "")
    let private_custom = "import shapes\nfunc f() -> shapes.Closed: return shapes.Closed(7)\n"
    expect_failure([source_module("shapes", custom), source_module("main", private_custom)], "main.luc:2:35: initializer `init` is private to module `shapes`")

pub func test_generic_struct_applications_infer_and_materialize_concrete_fields():
    let source = "struct Pair[T]:\n    let first: T\n    let second: T\nstruct Marker[T]:\n    let value: i64\nfunc sum() -> i64:\n    let inferred = Pair(20, 22)\n    let explicit: Pair[str] = Pair[str](\"left\", \"right\")\n    let contextual: Marker[str] = Marker(42)\n    return inferred.first + inferred.second + contextual.value - 42\n"
    let program = checked([source_module("main", source)])
    assert(len(program.structs) == 2)
    assert(len(program.structs[0].type_parameters) == 1)
    var integer_pair = resolve_builtin_type(BuiltinType.unit)
    var string_pair = resolve_builtin_type(BuiltinType.unit)
    for definition in program.types.definitions:
        if definition.name == "Pair[i64]": integer_pair = definition.id
        if definition.name == "Pair[str]": string_pair = definition.id
    assert(describe_type(program.types, integer_pair) == "Pair[i64]")
    assert(describe_type(program.types, string_pair) == "Pair[str]")
    assert(len(program.nominal_applications) == len(program.types.definitions))
    let integer_fields = nominal_fields(program, integer_pair)
    let string_fields = nominal_fields(program, string_pair)
    assert(types_match(integer_fields[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(types_match(integer_fields[1].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(types_match(string_fields[0].value_type, resolve_builtin_type(BuiltinType.string)))
    assert(types_match(string_fields[1].value_type, resolve_builtin_type(BuiltinType.string)))

    let model = "pub struct Box[T]:\n    pub let value: T\n"
    let client = "import model\nfunc answer(value: model.Box[i64]) -> i64:\n    let inferred = model.Box(42)\n    return value.value + inferred.value\n"
    let imported = checked([source_module("model", model), source_module("main", client)])
    assert(len(imported.structs[0].type_parameters) == 1)

    let nested_default = "struct Empty[T]:\n    let value: T? = none\nstruct Holder[T]:\n    let inner: Empty[T] = Empty[T]()\nfunc make() -> Holder[i64]: return Holder[i64]()\n"
    let defaulted = checked([source_module("main", nested_default)])
    assert(len(defaulted.nominal_applications) == len(defaulted.types.definitions))

pub func test_generic_struct_applications_have_stable_diagnostics():
    let pair = "struct Pair[T]:\n    let first: T\n    let second: T\n"
    expect_failure([source_module("main", pair + "func bad(value: Pair): return\n")], "main.luc:4:17: type `Pair` needs 1 type argument(s)")
    expect_failure([source_module("main", pair + "func bad(): discard(Pair[i64, str](1, 2))\n")], "main.luc:4:21: type `Pair` needs 1 type argument(s), got 2")
    expect_failure([source_module("main", pair + "func bad(): discard(Pair(1, \"two\"))\n")], "main.luc:4:29: expected `i64`, found `str`")
    let marker = "struct Marker[T]:\n    let value: i64\n"
    expect_failure([source_module("main", marker + "func bad(): discard(Marker(1))\n")], "main.luc:3:21: cannot infer generic parameter `T` of `Marker`; supply explicit type arguments")
    expect_failure([source_module("main", "struct Node[T]:\n    let next: Node[list[T]]\n")], "main.luc:1:1: struct `Node` contains itself through field `next`; use a class or a collection for recursive data")
    expect_failure([source_module("main", "interface Marker:\n    func marker(self)\nstruct Box[T] implements Marker:\n    let value: T\n")], "main.luc:3:26: type `Box` does not implement requirement `marker` of `Marker`")

pub func test_generic_struct_bounds_and_nested_generic_inference_share_one_proof():
    let source = "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T: Scored]:\n    let value: T\n    let fallback: T? = none\nfunc wrap[T: Scored](value: T) -> Box[T]: return Box(value)\nfunc read[T: Scored](box: Box[T]) -> i64:\n    if let fallback = box.fallback: return fallback.score()\n    return box.value.score()\nfunc answer() -> i64: return read(wrap(Score(value = 42)))\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 2)
    assert(len(program.nominal_applications) == len(program.types.definitions))
    var boxed_score = resolve_builtin_type(BuiltinType.unit)
    for definition in program.types.definitions:
        if definition.name == "Box[Score]": boxed_score = definition.id
    assert(describe_type(program.types, boxed_score) == "Box[Score]")

    let invalid = "interface Scored:\n    func score(self) -> i64\nstruct Box[T: Scored]:\n    let value: T\nfunc bad(value: Box[i64]): return\n"
    expect_failure([source_module("main", invalid)], "main.luc:5:17: type argument `i64` does not conform to `Scored` required by `T`")

pub func test_generic_struct_methods_become_distinct_concrete_functions():
    let source = "struct Box[T]:\n    var value: T\n    func get(self) -> T: return self.value\n    mutating func set(self, next: T): self.value = next\n    func copied(self) -> Box[T]: return Box(self.get())\n    func selected(self, fallback: T? = none) -> T: return fallback else self.value\n    func repeated(self, count: i64) -> T:\n        if count == 0: return self.value\n        return self.repeated(count - 1)\npub func answer() -> i64:\n    var number = Box(20)\n    number.set(42)\n    let word = Box(\"luce\")\n    let copied = word.copied()\n    return number.repeated(2) if copied.selected() == \"luce\" else 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 5)
    for generic in program.generic_functions:
        assert(generic.receiver != none)
        assert(len(generic.type_parameters) == 1)
    var integer_methods = 0
    var string_methods = 0
    for function in program.functions:
        let receiver = function.receiver
        if receiver == none: continue
        if describe_type(program.types, receiver.owner) == "Box[i64]": integer_methods += 1
        if describe_type(program.types, receiver.owner) == "Box[str]": string_methods += 1
    assert(integer_methods == 2)
    assert(string_methods == 3)

pub func test_generic_struct_method_rules_and_visibility_have_stable_diagnostics():
    let public_model = "pub struct Box[T]:\n    pub let value: T\n    pub func get(self) -> T: return self.value\n    func secret(self) -> T: return self.value\n"
    let public_client = "import model\nfunc read(box: model.Box[i64]) -> i64: return box.get()\n"
    discard(checked([source_module("model", public_model), source_module("main", public_client)]))
    let private_client = "import model\nfunc read(box: model.Box[i64]) -> i64: return box.secret()\n"
    expect_failure(
        [source_module("model", public_model), source_module("main", private_client)],
        "main.luc:2:47: `secret` is private to module `model`",
    )
    discard(checked([source_module("main", "struct Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n    func make(value: T) -> Box[T]: return Box(value)\nfunc answer() -> i64: return Box.make(42).value\n")]))
    discard(checked([source_module("main", "struct Box[T]:\n    let value: T\n    func convert[U](self, value: U) -> U: return value\nfunc answer() -> i64: return Box(0).convert(42)\n")]))
    expect_failure(
        [source_module("main", "struct Box[T]:\n    let value: T\n    func doubled(self) -> T: return self.value + self.value\n")],
        "main.luc:3:37: `+` requires numeric operands",
    )
    expect_failure(
        [source_module("main", "struct Box[T]:\n    func value(self) -> T: trap(\"empty\")\n    let value: T\n")],
        "main.luc:3:5: `value` is both a field and a method of `Box`",
    )

pub func test_generic_struct_methods_inherit_owner_constraints():
    let source = "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T: Scored]:\n    let value: T\n    func score(self) -> i64: return self.value.score()\nfunc answer() -> i64: return Box(Score(value = 42)).score()\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(len(program.generic_functions[0].type_parameters[0].constraints) == 1)

pub func test_independently_generic_methods_keep_owner_and_method_scopes_distinct():
    let source = "interface Combines[T]:\n    func combine(self, other: T) -> i64\nstruct Number implements Combines[i64]:\n    let offset: i64\n    pub func combine(self, other: i64) -> i64: return self.offset + other\nstruct Box[T]:\n    let value: T\n    func convert[U](self, value: U, fallback: U? = none) -> U: return fallback else value\n    func combine[U: Combines[T]](self, value: U) -> i64: return value.combine(self.value)\nstruct Plain:\n    func identity[T](self, value: T) -> T: return value\nclass Cell[T]:\n    var value: T\n    func init(self, value: T): self.value = value\n    func convert[U](self, value: U) -> U: return value\nenum Choice[T]:\n    empty\n    one(value: T)\n    func convert[U](self, value: U) -> U: return value\nfunc answer() -> i64:\n    let box = Box(40)\n    let plain = Plain()\n    let cell = new Cell(0)\n    let choice = Choice.one(1)\n    let word = box.convert[str](\"luce\")\n    return box.combine(Number(offset = 2)) + plain.identity(0) + cell.convert(0) + choice.convert(0) if word == \"luce\" else 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 6)
    var owner_only = 0
    var combined = 0
    var method_only = 0
    for generic in program.generic_functions:
        assert(generic.receiver != none)
        if generic.owner_parameter_count == len(generic.type_parameters): owner_only += 1
        elif generic.owner_parameter_count == 0: method_only += 1
        else: combined += 1
    assert(owner_only == 1)
    assert(method_only == 1)
    assert(combined == 4)
    for function in program.functions:
        let receiver = function.receiver
        if receiver != none: assert(not type_contains_parameter(program.types, receiver.owner))

pub func test_generic_nominal_initializers_and_type_functions_specialize_from_calls_and_context():
    let source = "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T: Scored]:\n    let value: T\n    func init(self, primary: T, fallback: T? = none): self.value = fallback else primary\n    pub func make(value: T) -> Box[T]: return Box(value)\nstruct Slot[T]:\n    let value: T?\n    pub func empty() -> Slot[T]: return Slot(value = none)\nclass Cell[T]:\n    let value: T\n    func init(self, value: T): self.value = value\n    pub func make(value: T) -> Cell[T]: return new Cell(value)\nenum Choice[T]:\n    empty\n    one(value: T)\n    pub func make(value: T) -> Choice[T]: return .one(value)\nfunc answer() -> i64:\n    let inferred = Box.make(Score(value = 40))\n    let explicit = Box.make[Score](Score(value = 1))\n    let contextual: Slot[i64] = Slot.empty()\n    let optional_context: Slot[i64]? = Slot.empty()\n    let text = Slot.empty[str]()\n    let cell = Cell.make(1)\n    let choice = Choice.make(0)\n    let selected = match choice:\n        .empty => 0\n        .one(value) => value\n    return inferred.value.score() + explicit.value.score() + cell.value + selected if contextual.value == none and optional_context != none and text.value == none else 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 6)
    let initializer = program.structs[1].initializer else trap("generic struct lost its custom initializer")
    var concrete_initializer = false
    var concrete_type_functions = 0
    for function in program.functions:
        let receiver = function.receiver
        if receiver == none: continue
        assert(not type_contains_parameter(program.types, receiver.owner))
        if receiver.kind == HirReceiverKind.initializer and function.symbol.value != initializer.value:
            concrete_initializer = true
        if receiver.kind == HirReceiverKind.type_function: concrete_type_functions += 1
    assert(concrete_initializer)
    assert(concrete_type_functions == 5)

pub func test_generic_nominal_type_function_visibility_and_abstract_bodies_are_checked():
    let model = "pub struct Box[T]:\n    pub let value: T\n    pub func make(value: T) -> Box[T]: return Box(value)\n    func secret(value: T) -> Box[T]: return Box(value)\n"
    let client = "import model\nfunc answer() -> i64: return model.Box.make(42).value\n"
    discard(checked([source_module("model", model), source_module("main", client)]))
    expect_failure(
        [source_module("model", model), source_module("main", "import model\nfunc bad() -> i64: return model.Box.secret(1).value\n")],
        "main.luc:2:27: `secret` is private to module `model`",
    )
    let private_initializer = "pub struct Box[T]:\n    pub let value: T\n    func init(self, value: T): self.value = value\n"
    expect_failure(
        [source_module("model", private_initializer), source_module("main", "import model\nfunc bad(): discard(model.Box(1))\n")],
        "main.luc:2:21: initializer `init` is private to module `model`",
    )
    expect_failure(
        [source_module("main", "struct Box[T]:\n    func invalid(value: T) -> T: return value + value\n")],
        "main.luc:2:41: `+` requires numeric operands",
    )
    let slot = "struct Slot[T]:\n    let value: T?\n    func empty() -> Slot[T]: return Slot(value = none)\n"
    expect_failure(
        [source_module("main", slot + "func bad(): discard(Slot.empty())\n")],
        "main.luc:4:21: cannot infer generic parameter `T` of `empty`; supply explicit type arguments",
    )
    expect_failure(
        [source_module("main", slot + "func bad(): discard(Slot.empty[i64, str]())\n")],
        "main.luc:4:21: generic type function `empty` needs 1 type argument(s), got 2",
    )
    expect_failure(
        [source_module("main", "class Box[T]:\n    func init(self): return\n    func make[U](value: U) -> Box[T]: return new Box[T]()\n")],
        "main.luc:3:5: a type function cannot declare independent generic parameters; declare them on the class",
    )
    expect_failure(
        [source_module("main", "enum Choice[T]:\n    empty\n    func make[U](value: U) -> Choice[T]: return .empty\n")],
        "main.luc:3:5: a type function cannot declare independent generic parameters; declare them on the enum",
    )
    let constrained = "interface Scored:\n    func score(self) -> i64\nstruct Box[T: Scored]:\n    let value: T\n    func make(value: T) -> Box[T]: return Box(value)\nfunc bad(): discard(Box.make(1))\n"
    expect_failure(
        [source_module("main", constrained)],
        "main.luc:6:21: type `i64` does not conform to `Scored` required by `T`",
    )

pub func test_independently_generic_method_diagnostics_are_stable():
    expect_failure(
        [source_module("main", "struct Box[T]:\n    func make[U](self) -> U: trap(\"missing\")\nfunc bad(value: Box[i64]) -> i64: return value.make()\n")],
        "main.luc:3:42: cannot infer generic parameter `U` of `make`; supply explicit type arguments",
    )
    expect_failure(
        [source_module("main", "struct Box[T]:\n    func identity[U](self, value: U) -> U: return value\nfunc bad(value: Box[i64]) -> i64: return value.identity[i64, str](1)\n")],
        "main.luc:3:42: generic method `identity` needs 1 type argument(s), got 2",
    )
    expect_failure(
        [source_module("main", "struct Box[T]:\n    func identity[T](self, value: T) -> T: return value\n")],
        "main.luc:2:19: duplicate generic parameter `T`",
    )
    expect_failure(
        [source_module("main", "interface Scored:\n    func score(self) -> i64\nstruct Box:\n    func score[T: Scored](self, value: T) -> i64: return value.score()\nfunc bad(value: Box) -> i64: return value.score(1)\n")],
        "main.luc:5:37: type `i64` does not conform to `Scored` required by `T`",
    )
    expect_failure(
        [source_module("main", "struct Box:\n    func invalid[T](self, value: T) -> T: return value + value\n")],
        "main.luc:2:50: `+` requires numeric operands",
    )
    expect_failure(
        [source_module("model", "pub struct Box:\n    pub func visible[T](self, value: T) -> T: return value\n    func secret[T](self, value: T) -> T: return value\n"), source_module("main", "import model\nfunc bad(value: model.Box) -> i64: return value.secret(1)\n")],
        "main.luc:2:43: `secret` is private to module `model`",
    )
    expect_failure(
        [source_module("main", "struct Box:\n    var value: i64\n    mutating func replace[T](self, marker: T, value: i64): self.value = value\nfunc bad(box: Box): box.replace(\"marker\", 1)\n")],
        "main.luc:4:21: mutating method needs a `var` receiver; `box` is immutable",
    )
    expect_failure(
        [source_module("main", "struct Box:\n    func init[T](self, value: T): return\n")],
        "main.luc:2:5: an initializer cannot declare independent generic parameters; declare them on the struct",
    )
    expect_failure(
        [source_module("main", "struct Box:\n    func make[T](value: T) -> Box: return Box()\n")],
        "main.luc:2:5: a type function cannot declare independent generic parameters; declare them on the struct",
    )
    expect_failure(
        [source_module("main", "struct Box:\n    func value(self) -> i64: return 0\nfunc bad(box: Box) -> i64: return box.value[i64]()\n")],
        "main.luc:3:35: type arguments require a generic method",
    )
    expect_failure(
        [source_module("main", "interface Value:\n    func read(self) -> i64\nstruct Box[T] implements Value:\n    pub func read[U](self) -> i64: return 0\n")],
        "main.luc:3:26: independently generic method `Box.read` cannot satisfy a non-generic interface requirement",
    )

pub func test_generic_struct_conformances_publish_only_concrete_witnesses():
    let source = "interface Value[T]:\n    func read(self) -> T\nstruct Box[T] implements Value[T]:\n    let value: T\n    pub func read(self) -> T: return self.value\nfunc static[V: Value[i64]](value: V) -> i64: return value.read()\nfunc dynamic(value: Value[i64]) -> i64: return value.read()\nfunc erase(value: Box[i64]) -> Value[i64]: return value\nfunc text(value: Box[str]) -> str: return value.read()\nfunc answer() -> i64:\n    let number = Box(40)\n    let word = Box(\"luce\")\n    return static(number) + dynamic(erase(number)) + 2 if text(word) == \"luce\" else 0\n"
    let program = checked([source_module("main", source)])
    assert(len(program.conformances) == 2)
    for conformance in program.conformances:
        assert(program.types.definitions[conformance.value_type.value].name != "Box[T]")
        assert(len(conformance.implementations) == 1)
        var found = false
        for function in program.functions:
            if function.symbol.value != conformance.implementations[0].value: continue
            let receiver = function.receiver
            let checked_receiver = receiver else trap("conformance implementation lost its receiver")
            assert(types_match(checked_receiver.owner, conformance.value_type))
            found = true
        assert(found)

pub func test_generic_struct_conformances_validate_abstract_methods_and_visibility():
    let missing = "interface Marker:\n    func marker(self)\nstruct Box[T] implements Marker:\n    let value: T\n"
    expect_failure([source_module("main", missing)], "main.luc:3:26: type `Box` does not implement requirement `marker` of `Marker`")
    let private_method = "interface Value[T]:\n    func read(self) -> T\nstruct Box[T] implements Value[T]:\n    let value: T\n    func read(self) -> T: return self.value\n"
    expect_failure([source_module("main", private_method)], "main.luc:3:26: method `Box.read` must be public to satisfy an interface")
    let wrong_result = "interface Value[T]:\n    func read(self) -> T\nstruct Box[T] implements Value[T]:\n    let value: T\n    pub func read(self) -> i64: return 0\n"
    expect_failure([source_module("main", wrong_result)], "main.luc:3:26: method `Box.read` returns `i64`, but the interface requires `T`")
    let duplicate = "interface Value[T]:\n    func read(self) -> T\nstruct Box[T] implements Value[T], Value[T]:\n    let value: T\n    pub func read(self) -> T: return self.value\n"
    expect_failure([source_module("main", duplicate)], "main.luc:3:36: duplicate conformance of `Box` to `Value[T]`")

pub func test_generic_struct_conformances_compose_with_modules_mutation_and_lifting():
    let contract = "pub interface Cell[T]:\n    mutating func write(self, value: T)\n    func read(self) -> T!\n"
    let model = "import contract\npub struct Box[T] implements contract.Cell[T]:\n    pub var value: T\n    pub mutating func write(self, value: T): self.value = value\n    pub func read(self) -> T: return self.value\n"
    let client = "import contract\nimport model\nfunc erase(value: model.Box[i64]) -> contract.Cell[i64]: return value\nfunc update(value: contract.Cell[i64]) -> i64!:\n    var current = value\n    current.write(42)\n    return try current.read()\nfunc answer() -> i64:\n    return update(erase(model.Box(value = 1))) catch failure: recover 0\n"
    let program = checked([
        source_module("contract", contract),
        source_module("model", model),
        source_module("main", client),
    ])
    assert(len(program.conformances) == 1)
    assert(describe_type(program.types, program.conformances[0].value_type) == "Box[i64]")
    assert(len(program.conformances[0].implementations) == 2)

pub func test_generic_conformance_methods_may_return_their_own_interface():
    let source = "interface Erased:\n    func erase(self) -> Erased\nstruct Box[T] implements Erased:\n    let value: T\n    pub func erase(self) -> Erased: return self\nfunc erase(value: Box[i64]) -> Erased: return value.erase()\n"
    let program = checked([source_module("main", source)])
    assert(len(program.conformances) == 1)
    assert(describe_type(program.types, program.conformances[0].value_type) == "Box[i64]")
    var abstract_conformances = 0
    for conformance in program.conformances:
        if describe_type(program.types, conformance.value_type) == "Box[T]": abstract_conformances += 1
    assert(abstract_conformances == 0)
    var saw_existential = false
    for node in program.nodes:
        match node.form:
            InterfaceValue(value, conformance):
                assert(i64(conformance) < len(program.conformances))
                assert(describe_type(program.types, program.conformances[conformance].value_type) == "Box[i64]")
                saw_existential = true
            else: pass
    assert(saw_existential)

# mark: Enums and match ======================================================================

pub func test_exported_c_structs_are_ordinary_values_with_one_owned_boundary_shape():
    let source = "## One pixel.\nexport c struct Pixel:\n    ## Red channel.\n    let red: u8\n    let alpha: u8\nexport c struct Sample:\n    let pixel: Pixel\n    let status: Status\nexport c enum Status as i32:\n    ready = -2\n    done = 42\nextern func reflect(value: Sample) -> Sample\ntype Transform = cfunc(Sample) -> Sample\nexport c func blend(value: Sample) -> Sample: return reflect(value)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.structs) == 2)
    let pixel = program.structs[0]
    let sample = program.structs[1]
    let pixel_kind = pixel.c_kind else trap("exported C struct lost its role")
    let sample_kind = sample.c_kind else trap("exported C struct lost its role")
    assert(pixel_kind == HirCStructKind.exported and sample_kind == HirCStructKind.exported)
    assert(pixel.is_public and pixel.documentation[0] == "One pixel.")
    assert(len(pixel.fields) == 2 and pixel.fields[0].name == "red")
    assert(pixel.fields[0].is_public and not pixel.fields[0].is_mutable)
    assert(pixel.fields[0].documentation[0] == "Red channel.")
    assert(len(sample.fields) == 2 and sample.fields[0].name == "pixel" and sample.fields[1].name == "status")
    assert(len(program.functions) == 2)

pub func test_exported_c_struct_fields_fail_closed_before_lowering():
    expect_failure(
        [source_module("main", "export c struct Bad:\n    let text: str\n")],
        "main.luc:2:5: exported C struct `Bad` field `text` has unsupported C layout type `str`",
    )
    expect_failure(
        [source_module("main", "export c struct Bad:\n    let half: f16\n")],
        "main.luc:2:5: exported C struct `Bad` field `half` has unsupported C layout type `f16`",
    )
    expect_failure(
        [source_module("main", "struct Local:\n    let value: i32\nexport c struct Bad:\n    let value: Local\n")],
        "main.luc:4:5: exported C struct `Bad` field `value` has unsupported C layout type `Local`",
    )
    expect_failure(
        [source_module("main", "export c struct Recursive:\n    let value: Recursive\n")],
        "main.luc:1:1: exported C struct `Recursive` contains itself through field `value`",
    )

pub func test_exported_c_enums_are_ordinary_enums_with_an_exact_boundary_map():
    # Callable signatures deliberately precede the enum: declaration order
    # cannot decide whether its fixed boundary identity is visible.
    let source = "extern func inspect(value: Status) -> Status\nexport c func echo(value: Status) -> Status: return value\n## Process state.\nexport c enum Status as i32:\n    ## Still running.\n    running = -2\n    complete = 42\nfunc classify(value: Status) -> i32:\n    match value:\n        .running: return 1i32\n        .complete: return 2i32\n"
    let program = checked([source_module("main", source)])
    assert(len(program.enums) == 1)
    let status = program.enums[0]
    assert(status.is_public and status.name == "Status")
    assert(status.documentation[0] == "Process state.")
    assert(status.cases[0].documentation[0] == "Still running.")
    assert(len(status.cases[0].payload) == 0 and len(status.cases[1].payload) == 0)
    let shape = status.c_shape else trap("exported C enum lost its boundary shape")
    assert(types_match(shape.representation, resolve_builtin_type(BuiltinType.signed_i32)))
    match shape.values[0]:
        SignedInteger(value): assert(value == -2)
        else: assert(false)
    match shape.values[1]:
        SignedInteger(value): assert(value == 42)
        else: assert(false)
    assert(len(program.functions) == 3)

pub func test_exported_c_enum_representations_and_values_fail_closed():
    discard(checked([source_module(
        "main",
        "export c enum SignedLimit as i64:\n    minimum = -9223372036854775808i64\n    maximum = 9223372036854775807i64\nexport c enum UnsignedLimit as u64:\n    minimum = 0u64\n    maximum = 18446744073709551615u64\n",
    )]))
    expect_failure(
        [source_module("main", "export c enum Status as f32:\n    ready = 1\n")],
        "main.luc:1:1: exported C enum `Status` representation must be an integer type",
    )
    expect_failure(
        [source_module("main", "export c enum Status as Word:\n    ready = 1\n")],
        "main.luc:1:1: exported C enum `Status` representation must be an integer type",
    )
    expect_failure(
        [source_module("main", "export c enum Status as u8:\n    ready = -1\n")],
        "main.luc:2:5: exported C enum `Status` value is outside `u8` range",
    )
    expect_failure(
        [source_module("main", "export c enum Status as i8:\n    ready = -129\n")],
        "main.luc:2:5: exported C enum `Status` value is outside `i8` range",
    )
    expect_failure(
        [source_module("main", "export c enum Status as u8:\n    ready = 256\n")],
        "main.luc:2:5: exported C enum `Status` value is outside `u8` range",
    )
    expect_failure(
        [source_module("main", "export c enum Status as u32:\n    ready = 1u16\n")],
        "main.luc:2:13: exported C enum value suffix must match representation `u32`",
    )
    expect_failure(
        [source_module("main", "export c enum Status as i32:\n    ready = 1\n    done = 1\n")],
        "main.luc:3:5: exported C enum `Status` values must be unique",
    )
    expect_failure(
        [source_module("main", "export c enum Status as i32:\n    ready = 1\nextern var current: Status\n")],
        "main.luc:3:21: extern variable `current` has unsupported boundary type `Status`",
    )
pub func test_enums_retain_cases_payloads_documentation_and_methods():
    let source = "## A command.\npub enum Command:\n    ## Open a path.\n    open(path: str)\n    resize(width: u32, height: u32)\n    quit\n    pub func is_quit(self) -> bool:\n        match self:\n            .quit: return true\n            _: return false\n    func default() -> Command: return .quit\n"
    let program = checked([source_module("main", source)])
    assert(len(program.enums) == 1)
    let command = program.enums[0]
    assert(command.name == "Command" and command.is_public)
    assert(command.documentation[0] == "A command.")
    assert(len(command.cases) == 3)
    assert(command.cases[0].documentation[0] == "Open a path.")
    assert(command.cases[1].payload[1].name == "height")
    assert(describe_type(program.types, command.cases[1].payload[1].value_type) == "u32")
    assert(len(command.cases[2].payload) == 0)
    let receiver = program.functions[0].receiver else trap("method has no receiver")
    assert(describe_type(program.types, receiver.owner) == "Command" and receiver.kind == HirReceiverKind.value_method)
    let factory = program.functions[1].receiver else trap("type function has no receiver")
    assert(factory.kind == HirReceiverKind.type_function)

pub func test_generic_enum_applications_infer_payloads_methods_and_conformances():
    let source = "interface Readable[T]:\n    func read(self, fallback: T) -> T\nenum Choice[T] implements Readable[T]:\n    empty\n    one(value: T)\n    pair(left: T, right: T)\n    pub func read(self, fallback: T) -> T:\n        match self:\n            .empty: return fallback\n            .one(value): return value\n            .pair(left, right): return left\n    mutating func replace(self, value: T): self = .one(value)\npub func answer() -> i64:\n    let inferred = Choice.one(20)\n    let explicit = Choice.empty[i64]()\n    var contextual: Choice[i64] = .pair(right = 2, left = 40)\n    contextual.replace(inferred.read(0) + contextual.read(0))\n    return contextual.read(0) + explicit.read(2)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.enums) == 1)
    assert(len(program.enums[0].type_parameters) == 1)
    assert(len(program.generic_functions) == 2)
    var choice = resolve_builtin_type(BuiltinType.unit)
    for definition in program.types.definitions:
        if definition.name == "Choice[i64]": choice = definition.id
    assert(describe_type(program.types, choice) == "Choice[i64]")
    let application = program.nominal_applications[choice.value] else trap("generic enum application is missing")
    match application:
        EnumApplication(cases):
            assert(types_match(cases[1].payload[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
            assert(types_match(cases[2].payload[1].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
        else: assert(false)
    assert(len(program.conformances) == 1)
    assert(types_match(program.conformances[0].value_type, choice))

pub func test_generic_enum_applications_have_stable_diagnostics():
    let choice = "enum Choice[T]:\n    empty\n    one(value: T)\n    pair(left: T, right: T)\n"
    expect_failure([source_module("main", choice + "func bad(): discard(Choice.empty)\n")], "main.luc:5:21: cannot infer generic parameter `T` of `Choice`; supply explicit type arguments")
    expect_failure([source_module("main", choice + "func bad(): discard(Choice.one[i64, str](1))\n")], "main.luc:5:21: type `Choice` needs 1 type argument(s), got 2")
    expect_failure([source_module("main", choice + "func bad(): discard(Choice.pair(1, \"two\"))\n")], "main.luc:5:36: expected `i64`, found `str`")
    discard(checked([source_module("main", "enum Choice[T]:\n    empty\n    one(value: T)\n    func make(value: T) -> Choice[T]: return .one(value)\nfunc answer() -> i64:\n    let choice = Choice.make(42)\n    return match choice:\n        .empty => 0\n        .one(value) => value\n")]))
    discard(checked([source_module("main", "enum Choice[T]:\n    empty\n    func convert[U](self, value: U) -> U: return value\nfunc answer(value: Choice[i64]) -> i64: return value.convert(42)\n")]))
    expect_failure([source_module("main", "enum Tree[T]:\n    branch(child: Tree[T])\n")], "main.luc:1:1: enum `Tree` contains itself through case `branch`; use a class or a collection for recursive data")

pub func test_generic_enum_bounds_and_visibility_use_the_shared_nominal_rules():
    let bounded = "interface Scored:\n    func score(self) -> i64\nstruct Score implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nenum Choice[T: Scored]:\n    empty\n    one(value: T)\nfunc answer() -> i64:\n    let value = Choice.one(Score(value = 42))\n    return match value:\n        .empty => 0\n        .one(score) => score.score()\n"
    let program = checked([source_module("main", bounded)])
    assert(len(program.enums[0].type_parameters[0].constraints) == 1)
    let invalid = "interface Scored:\n    func score(self) -> i64\nenum Choice[T: Scored]:\n    empty\nfunc bad(value: Choice[i64]): return\n"
    expect_failure([source_module("main", invalid)], "main.luc:5:17: type argument `i64` does not conform to `Scored` required by `T`")

    let library = "pub enum Choice[T]:\n    empty\n    one(value: T)\n    pub func get(self, fallback: T) -> T:\n        match self:\n            .empty: return fallback\n            .one(value): return value\n"
    let client = "import model\nfunc answer() -> i64:\n    let inferred = model.Choice.one(40)\n    let empty = model.Choice.empty[i64]()\n    return inferred.get(0) + empty.get(2)\n"
    discard(checked([source_module("model", library), source_module("main", client)]))
    let private_library = "enum Hidden[T]:\n    empty\n"
    let private_client = "import model\nfunc bad() -> model.Hidden[i64]: return model.Hidden.empty[i64]()\n"
    expect_failure([source_module("model", private_library), source_module("main", private_client)], "main.luc:2:15: `Hidden` is private to module `model`")

pub func test_match_rules_are_enforced():
    let colors = "enum Color:\n    red\n    green\n    blue(level: i64)\n"
    discard(checked([source_module("main", "func f(v: u8) -> i64:\n    match v:\n        0..<128: return 1\n        128..=255: return 2\n")]))
    discard(checked([source_module("main", "func f(v: i8) -> i64:\n    match v:\n        -128..<0: return 1\n        0..=127: return 2\n")]))
    discard(checked([source_module("main", "func f(v: char) -> i64:\n    match v:\n        '\\u{0}'..<'\\u{E000}': return 1\n        '\\u{E000}'..='\\u{10FFFF}': return 2\n")]))
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        .red: return 1\n        .green: return 2\n")], "main.luc:6:5: `match` does not cover `.blue`")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        .red: return 1\n        .red: return 2\n        _: return 0\n")], "main.luc:8:9: duplicate case pattern `.red`")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        _: return 0\n        .red: return 1\n")], "main.luc:8:9: this arm is unreachable; an earlier `_` matches everything")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        .blue: return 1\n        _: return 0\n")], "main.luc:7:9: `.blue` carries 1 value(s), the pattern binds 0")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        .blue(level), .red: return 1\n        _: return 0\n")], "main.luc:7:9: every alternative of an arm must bind the same names")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        .purple: return 1\n        _: return 0\n")], "main.luc:7:9: enum `Color` has no case `purple`")
    expect_failure([source_module("main", colors + "func f(c: Color) -> i64:\n    match c:\n        1: return 1\n        _: return 0\n")], "main.luc:7:9: literal patterns need a scalar or string subject, found `Color`")
    expect_failure([source_module("main", "func f(v: i64) -> i64:\n    match v:\n        1: return 1\n")], "main.luc:2:5: `match` on `i64` needs a `_` arm")
    expect_failure([source_module("main", "func f(v: u8) -> i64:\n    match v:\n        0..<255: return 1\n")], "main.luc:2:5: `match` on `u8` needs a `_` arm")
    expect_failure([source_module("main", "func f(v: i64) -> i64:\n    match v:\n        1: return 1\n        1: return 2\n        _: return 0\n")], "main.luc:4:9: duplicate pattern")
    expect_failure([source_module("main", "func f(v: i64) -> i64:\n    match v:\n        1..=5: return 1\n        3: return 2\n        _: return 0\n")], "main.luc:4:9: pattern is already covered by an earlier range")
    expect_failure([source_module("main", "func f(v: i64) -> i64:\n    match v:\n        1..=5: return 1\n        4..<9: return 2\n        _: return 0\n")], "main.luc:4:9: range overlaps an earlier pattern")
    expect_failure([source_module("main", "func f(v: i64) -> i64:\n    match v:\n        5..<5: return 1\n        _: return 0\n")], "main.luc:3:9: range pattern needs its lower bound below its upper bound")
    expect_failure([source_module("main", "func f(v: i64?) -> i64:\n    match v:\n        .some(x): return x\n")], "main.luc:2:5: `match` does not cover `.none`")
    expect_failure([source_module("main", "func f(v: bool) -> i64:\n    match v:\n        true: return 1\n")], "main.luc:2:5: `match` does not cover `false`")
    expect_failure([source_module("main", "func f(v: bool) -> i64:\n    match v:\n        true: return 1\n        false: return 0\n        _: return 2\n")], "main.luc:5:9: this arm is unreachable; earlier patterns cover every value")
    expect_failure([source_module("main", "func f(v: u8) -> i64:\n    match v:\n        0..<128: return 1\n        128..=255: return 0\n        42: return 2\n")], "main.luc:5:9: this arm is unreachable; earlier patterns cover every value")
    expect_failure([source_module("main", "func f(v: str) -> i64:\n    match v:\n        'a'..='z': return 1\n        _: return 0\n")], "main.luc:3:9: range patterns need an integer or `char` subject, found `str`")
    discard(checked([source_module("main", "func f(v: f64) -> i64:\n    match v:\n        -1.5: return 1\n        _: return 0\n")]))
    expect_failure([source_module("main", "func f(v: f64) -> i64:\n    match v:\n        0.0: return 1\n        -0.0: return 2\n        _: return 0\n")], "main.luc:4:9: duplicate pattern")
    expect_failure([source_module("main", "func f(v: bytes) -> i64:\n    match v:\n        b\"x\": return 1\n        _: return 0\n")], "main.luc:3:9: literal patterns need a scalar or string subject, found `bytes`")
    expect_failure([source_module("main", colors + "func f() -> Color: return .blue\n")], "main.luc:5:27: case `blue` is missing payload field `level`")
    expect_failure([source_module("main", colors + "func f() -> Color: return Color.red(1)\n")], "main.luc:5:37: case `red` carries 0 value(s)")
    expect_failure([source_module("main", colors + "func f() -> i64: return .red\n")], "main.luc:5:25: expected `i64`, found the case spelling `.red`")
    expect_failure([source_module("main", "enum Node:\n    leaf\n    pair(left: Node, right: Node)\n")], "main.luc:1:1: enum `Node` contains itself through case `pair`; use a class or a collection for recursive data")
    let shapes = "enum Shape:\n    dot\npub enum Color:\n    red\n"
    expect_failure([source_module("shapes", shapes), source_module("main", "import shapes\nfunc f() -> shapes.Color: return shapes.Color.red\n")], "")
    expect_failure([source_module("shapes", shapes), source_module("main", "import shapes\nfunc f() -> shapes.Shape: return shapes.Shape.dot\n")], "main.luc:2:13: `Shape` is private to module `shapes`")

pub func test_hir_owns_canonical_type_and_symbol_tables():
    let source = "func identity(value: i64) -> i64:\n    let copy = value\n    return copy\n"
    let program = checked([source_module("main", source)])

    assert(len(program.types.definitions) == 21)
    match program.types.definitions[resolve_builtin_type(BuiltinType.string_slice).value].form:
        Slice(element): assert(types_match(element, resolve_builtin_type(BuiltinType.string)))
        else: assert(false)

    # Signature collection creates the parameter and function; body checking
    # then adds the local. Each resolved reference uses these identities.
    assert(len(program.symbols) == 3)
    assert(program.symbols[0].kind == SymbolKind.parameter)
    assert(program.symbols[1].kind == SymbolKind.function)
    assert(program.symbols[2].kind == SymbolKind.local)
    assert(program.functions[0].symbol.value == program.symbols[1].id.value)
    match statement(program, program.functions[0], 0):
        Binding(symbol, is_mutable, value):
            assert(symbol.value == program.symbols[2].id.value)
            match form(program, value):
                Reference(reference): assert(reference.value == program.symbols[0].id.value)
                else: assert(false)
        else: assert(false)

# mark: Generic functions ===================================================================

pub func test_generic_function_signatures_and_instances_have_separate_hir_identities():
    let source = "func identity[T](value: T) -> T: return value\nfunc use() -> i64: return identity(42)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(program.generic_functions[0].name == "identity")
    assert(len(program.generic_functions[0].type_parameters) == 1)
    match program.types.definitions[program.generic_functions[0].type_parameters[0].value_type.value].form:
        TypeParameter(generic, position):
            assert(generic == 0)
            assert(position == 0)
        else: assert(false)
    assert(len(program.functions) == 2)
    assert(program.functions[1].name == "identity[i64]")
    assert(types_match(program.functions[1].parameters[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(types_match(program.functions[1].result, resolve_builtin_type(BuiltinType.signed_i64)))
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                Call(function, arguments): assert(function.value == program.functions[1].symbol.value)
                else: assert(false)
        else: assert(false)

pub func test_generic_calls_infer_nested_types_accept_explicit_types_and_memoize_instances():
    let source = "func first[T](values: list[T]) -> T?:\n    if values.length == 0: return none\n    return values[0]\nfunc use() -> i64?:\n    let a = first([1, 2])\n    let b = first[i64]([3])\n    return a\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(len(program.functions) == 2)
    assert(program.functions[1].name == "first[i64]")
    assert(describe_type(program.types, program.functions[1].parameters[0].value_type) == "list[i64]")
    assert(describe_type(program.types, program.functions[1].result) == "i64?")

pub func test_public_generic_functions_resolve_through_both_import_forms():
    let modules = [
        source_module("lib", "pub func identity[T](value: T) -> T: return value\n"),
        source_module("main", "import lib\nfrom lib import identity\nfunc use() -> i64: return lib.identity(identity(7))\n"),
    ]
    let program = checked(modules)
    assert(len(program.generic_functions) == 1)
    assert(len(program.functions) == 2)
    assert(program.functions[1].module.value == 0)

pub func test_generic_bodies_are_checked_abstractly_even_when_unused():
    let source = "func invalid[T](value: T) -> T: return value + value\nfunc main(): return\n"
    expect_failure([source_module("main", source)], "main.luc:1:40: `+` requires numeric operands")

pub func test_abstract_generic_checks_do_not_publish_probe_arena_nodes():
    let source = "func unused[T](value: T) -> list[T]:\n    let copy = value\n    return [copy]\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(len(program.functions) == 1)
    assert(len(program.nodes) == 1)
    let generic = program.generic_functions[0]
    assert(len(generic.body.arena.nodes) > 1)
    assert(len(generic.body.local_symbols) == 1)
    let local = generic.body.local_symbols[0]
    assert(i64(local.value) < len(program.symbols))
    assert(program.symbols[local.value].name == "copy")
    match arena_node_form(generic.body.arena, arena_node_at(generic.body.arena, generic.body.body, 0)):
        Binding(symbol, is_mutable, value): assert(symbol.value == local.value)
        else: assert(false)
    match statement(program, program.functions[0], 0):
        ReturnStatement(value): assert(value.value == no_node)
        else: assert(false)

pub func test_retained_generic_bodies_defer_calls_defaults_and_function_addresses():
    let source = "func choose[T](value: T, fallback: T? = none) -> T: return fallback else value\nfunc relay[T](value: T) -> T:\n    let operation: func(T, T?) -> T = choose\n    discard(operation)\n    return choose(value)\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 2)
    let choice = program.generic_functions[0]
    assert(len(choice.body.defaults) == 2)
    assert(choice.body.defaults[0].value == no_node)
    assert(choice.body.defaults[1].value != no_node)
    assert(i64(choice.body.defaults[1].value) < len(choice.body.arena.nodes))

    let relay = program.generic_functions[1]
    var saw_address = false
    var saw_default = false
    var saw_call = false
    for node in relay.body.arena.nodes:
        match node.form:
            GenericFunctionAddress(generic, type_arguments):
                assert(generic == 0)
                assert(type_arguments.count == 1)
                saw_address = true
            GenericDefaultArgument(generic, parameter, type_arguments):
                assert(generic == 0)
                assert(parameter == 1)
                assert(type_arguments.count == 1)
                saw_default = true
            GenericCall(generic, type_arguments, arguments, kind):
                assert(generic == 0)
                assert(type_arguments.count == 1)
                assert(arguments.count == 4)
                assert(kind == HirGenericCallKind.function)
                saw_call = true
            else: pass
    assert(saw_address and saw_default and saw_call)

pub func test_retained_generic_bodies_defer_requirements_and_initializers():
    let source = "interface Scored:\n    func score(self) -> i64\nstruct Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\nfunc wrap[T: Scored](value: T) -> Box[T]:\n    discard(value.score())\n    return Box(value)\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    var wrap_index = -1
    for index in range(0, len(program.generic_functions)):
        if program.generic_functions[index].name == "wrap": wrap_index = index
    assert(wrap_index >= 0)
    let body = program.generic_functions[wrap_index].body
    var saw_requirement = false
    var saw_initializer = false
    for node in body.arena.nodes:
        match node.form:
            GenericRequirementCall(interface_type, requirement, arguments):
                assert(requirement == 0)
                assert(arguments.count == 2)
                saw_requirement = true
            GenericCall(generic, type_arguments, arguments, kind):
                if kind == HirGenericCallKind.initializer:
                    assert(type_arguments.count == 1)
                    assert(arguments.count == 2)
                    saw_initializer = true
            else: pass
    assert(saw_requirement and saw_initializer)

pub func test_retained_generic_closures_are_template_local_but_keep_semantic_symbols():
    let source = "interface Writer:\n    func write(self) -> unit!\nstruct Sink implements Writer:\n    pub func write(self): return\nfunc capture[T](value: T) -> func() -> T:\n    var current = value\n    return func () -> T:\n        current = value\n        return current\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    let body = program.generic_functions[0].body
    assert(len(body.closures) == 1)
    assert(len(body.generated_functions) == 1)
    assert(len(body.shared_cells) == 1)
    let closure = body.generated_functions[0].closure else trap("retained closure function lost its environment")
    assert(closure == 0)
    assert(body.closures[0].function.value == body.generated_functions[0].symbol.value)
    # The infallible Writer implementation creates an executable fallibility
    # adapter before templates are checked. That generated function survives
    # while the retained closure still starts from local index zero.
    assert(len(program.closures) == 0)
    assert(len(program.shared_cells) == 0)
    assert(len(program.functions) == 3)
    for symbol in body.local_symbols:
        assert(i64(symbol.value) < len(program.symbols))

pub func test_abstract_generic_arenas_resolve_package_constant_types_from_symbols():
    let source = "let invalid: ErrorCode = ErrorCode.package(1)\nfunc fail[T](value: T) -> T!:\n    error(invalid, \"failure\")\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(types_match(program.symbols[program.constants[0].symbol.value].value_type, resolve_builtin_type(BuiltinType.error_code)))

pub func test_abstract_generic_arenas_accept_declaration_owned_defaults():
    let source = "func cleanup(message: str = \"done\"): return\nstruct Defaulted:\n    let value: i64 = 42\nfunc inspect[T](value: T) -> i64:\n    defer cleanup()\n    return Defaulted().value\nfunc main(): return\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 1)
    assert(len(program.functions) == 2)

pub func test_contextual_generic_function_values_use_concrete_specializations():
    let source = "func identity[T](value: T) -> T: return value\nfunc use() -> i64:\n    let function: func(i64) -> i64 = identity\n    return function(7)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.functions) == 2)
    assert(program.functions[1].name == "identity[i64]")
    match statement(program, program.functions[0], 0):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                FunctionAddress(function): assert(function.value == program.functions[1].symbol.value)
                else: assert(false)
        else: assert(false)

pub func test_generic_defaults_and_recursion_are_specialized_once():
    let source = "func choose[T](value: T, fallback: T? = none) -> T:\n    return fallback else value\nfunc recurse[T](value: T, count: i64) -> T:\n    if count == 0: return value\n    return recurse(value, count - 1)\nfunc use() -> i64: return recurse(choose(7), 2)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_functions) == 2)
    assert(len(program.functions) == 3)
    assert(program.functions[1].name == "choose[i64]")
    assert(program.functions[2].name == "recurse[i64]")

pub func test_specialized_generic_hir_contains_no_template_only_nodes():
    let source = "interface Scored:\n    func score(self) -> i64\nstruct Item implements Scored:\n    let value: i64\n    pub func score(self) -> i64: return self.value\nstruct Box[T]:\n    let value: T\n    func init(self, value: T): self.value = value\nfunc choose[T](value: T, fallback: T? = none) -> T: return fallback else value\nfunc relay[T: Scored](value: T) -> Box[T]:\n    let operation: func(T, T?) -> T = choose\n    discard(operation)\n    discard(value.score())\n    return Box(choose(value))\nfunc use() -> Box[Item]: return relay(Item(value = 42))\n"
    let program = checked([source_module("main", source)])
    for node in program.nodes:
        match node.form:
            GenericCall(generic, type_arguments, arguments, kind): assert(false)
            GenericFunctionAddress(generic, type_arguments): assert(false)
            GenericDefaultArgument(generic, parameter, type_arguments): assert(false)
            GenericRequirementCall(interface_type, requirement, arguments): assert(false)
            GenericInterfaceValue(value): assert(false)
            else: pass

pub func test_generic_function_value_defaults_specialize_from_retained_hir():
    let source = "func identity[T](value: T) -> T: return value\nfunc apply[T](value: T, operation: func(T) -> T = identity) -> T: return operation(value)\nfunc use() -> i64: return apply(42)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.functions) == 3)
    var apply_index = -1
    var identity_index = -1
    for index in range(0, len(program.functions)):
        if program.functions[index].name == "apply[i64]": apply_index = index
        if program.functions[index].name == "identity[i64]": identity_index = index
    assert(apply_index >= 0 and identity_index >= 0)
    let default_value = program.functions[apply_index].parameters[1].default_value
    match form(program, default_value):
        FunctionAddress(function): assert(function.value == program.functions[identity_index].symbol.value)
        else: assert(false)

pub func test_each_generic_closure_specialization_owns_distinct_runtime_metadata():
    let source = "func capture[T](value: T) -> func() -> T:\n    var current = value\n    return func () -> T:\n        current = value\n        return current\nfunc use():\n    discard(capture(1))\n    discard(capture(\"text\"))\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_instances) == 2)
    assert(len(program.closures) == 2)
    assert(len(program.shared_cells) == 2)
    assert(program.closures[0].function.value != program.closures[1].function.value)
    assert(program.closures[0].captures[0].symbol.value != program.closures[1].captures[0].symbol.value)
    let first_name = program.symbols[program.closures[0].function.value].name
    let second_name = program.symbols[program.closures[1].function.value].name
    assert(first_name != second_name)
    assert(types_match(program.closures[0].captures[0].value_type, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(types_match(program.closures[1].captures[0].value_type, resolve_builtin_type(BuiltinType.string)))

pub func test_generic_declarations_and_calls_have_stable_negative_diagnostics():
    expect_failure(
        [source_module("main", "func duplicate[T, T](value: T) -> T: return value\n")],
        "main.luc:1:19: duplicate generic parameter `T`",
    )
    expect_failure(
        [source_module("main", "func constrained[T: Missing](value: T) -> T: return value\n")],
        "main.luc:1:21: unknown interface `Missing`",
    )
    expect_failure(
        [source_module("main", "func make[T]() -> T: trap(\"no value\")\nfunc use() -> i64: return make()\n")],
        "main.luc:2:27: cannot infer generic parameter `T` of `make`; supply explicit type arguments",
    )
    expect_failure(
        [source_module("main", "func identity[T](value: T) -> T: return value\nfunc use() -> i64: return identity[i64, bool](1)\n")],
        "main.luc:2:27: generic function `identity` needs 1 type argument(s), got 2",
    )
    expect_failure(
        [source_module("main", "struct Box[T]:\n    let value: T\nfunc use(value: Box[3]): return\n")],
        "main.luc:3:21: generic nominal arguments must be types",
    )
    discard(checked([source_module("main", "struct Box:\n    func identity[T](self, value: T) -> T: return value\nfunc answer(value: Box) -> i64: return value.identity(42)\n")]))

pub func test_generic_specialization_provenance_tracks_checked_bodies_and_parent_paths():
    let source = "func inner[T](value: T) -> T: return value\nfunc outer[T](value: T) -> list[T]: return inner([value])\nfunc start() -> list[i64]: return outer(1)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.generic_instances) == 2)
    let outer = program.generic_instances[0]
    let inner = program.generic_instances[1]
    assert(program.symbols[outer.function.value].name == "outer[i64]")
    assert(program.symbols[inner.function.value].name == "inner[list[i64]]")
    assert(outer.parent == none)
    let inner_parent = inner.parent else trap("nested specialization lost its parent")
    assert(inner_parent == 0)
    assert(outer.checked_nodes > 0 and inner.checked_nodes > 0)
    assert(outer.check_time_ms >= 0 and inner.check_time_ms >= 0)
    assert(program.generic_specialization_budget == 256)

pub func test_generic_specialization_budget_and_recursive_expansion_report_paths():
    let source = "func expand[T](value: T):\n    expand([value])\nfunc start(): expand(1)\n"
    let failure = generic_budget_failure([source_module("main", source)], 2)
    assert(failure == "main.luc:2:5: infinite generic expansion while creating `expand[list[i64]]`\n  expansion path:\n    main.luc:3:15: expand[i64]\n    main.luc:2:5: expand[list[i64]]")

    let bounded = "func identity[T](value: T) -> T: return value\nfunc start():\n    discard(identity(1))\n    discard(identity(true))\n    discard(identity(\"third\"))\n"
    let bounded_failure = generic_budget_failure([source_module("main", bounded)], 2)
    assert(bounded_failure == "main.luc:5:13: generic specialization budget of 2 was exceeded while creating `identity[str]`\n  expansion path:\n    main.luc:5:13: identity[str]")

# mark: Interfaces and constrained generics ================================================

pub func test_interfaces_retain_requirements_conformances_and_static_generic_dispatch():
    let source = "interface Scorer:\n    func score(self, bonus: i64) -> i64\nstruct Item implements Scorer:\n    let value: i64\n    pub func score(self, bonus: i64) -> i64: return self.value + bonus\nfunc evaluate[T: Scorer](value: T) -> i64: return value.score(bonus = 2)\nfunc use() -> i64: return evaluate(Item(value = 40))\n"
    let program = checked([source_module("main", source)])
    assert(len(program.interfaces) == 1)
    assert(program.interfaces[0].name == "Scorer")
    assert(len(program.interfaces[0].requirements) == 1)
    assert(program.interfaces[0].requirements[0].name == "score")
    assert(len(program.conformances) == 1)
    assert(program.conformances[0].implementations[0].value == program.functions[0].symbol.value)
    assert(len(program.generic_functions) == 1)
    assert(len(program.generic_functions[0].type_parameters[0].constraints) == 1)
    assert(len(program.functions) == 3)
    assert(program.functions[2].name == "evaluate[Item]")

pub func test_generic_interfaces_substitute_arguments_in_requirements_and_constraints():
    let source = "interface Combiner[T]:\n    func combine(self, other: T) -> T\nstruct Sum implements Combiner[i64]:\n    pub func combine(self, other: i64) -> i64: return other + 1\nfunc apply[C: Combiner[i64]](value: C, other: i64) -> i64: return value.combine(other)\nfunc use() -> i64: return apply(Sum(), 41)\n"
    let program = checked([source_module("main", source)])
    assert(len(program.interfaces[0].type_parameters) == 1)
    assert(describe_type(program.types, program.conformances[0].interface_type) == "Combiner[i64]")
    assert(program.functions[2].name == "apply[Sum]")

pub func test_standard_iteration_interfaces_are_compiler_owned_resolved_hir():
    let source = "struct CountIterator implements Iterator[i64]:\n    var current: i64\n    let end: i64\n    pub mutating func next(self) -> i64?:\n        if self.current >= self.end: return none\n        let value = self.current\n        self.current += 1\n        return value\nstruct Count implements Iterable[i64]:\n    let end: i64\n    pub func iterator(self) -> Iterator[i64]: return CountIterator(current = 0, end = self.end)\nfunc sum(values: Count) -> i64:\n    var total = 0\n    for value in values: total += value\n    return total\n"
    let program = checked([source_module("main", source)])
    assert(len(program.interfaces) == 2)
    match program.interfaces[0].origin:
        Standard(identity): assert(identity == StandardInterface.iterator)
        Source(module): assert(false)
    match program.interfaces[1].origin:
        Standard(identity): assert(identity == StandardInterface.iterable)
        Source(module): assert(false)
    assert(program.interfaces[0].name == "Iterator")
    assert(program.interfaces[0].requirements[0].name == "next")
    assert(program.interfaces[0].requirements[0].is_mutating)
    assert(program.interfaces[1].name == "Iterable")
    assert(program.interfaces[1].requirements[0].name == "iterator")
    assert(not program.interfaces[1].requirements[0].is_mutating)
    assert(len(program.conformances) == 2)
    match statement(program, program.functions[2], 1):
        ForStatement(symbol, iteration, body):
            assert(describe_type(program.types, program.symbols[symbol.value].value_type) == "i64")
            match iteration:
                Protocol(iterator_symbol, iterator, next):
                    assert(program.symbols[iterator_symbol.value].name == ".luce_iterator")
                    assert(describe_type(program.types, program.symbols[iterator_symbol.value].value_type) == "Iterator[i64]")
                    match form(program, iterator):
                        Call(function, arguments): assert(i64(arguments.count) == 2)
                        else: assert(false)
                    match form(program, next):
                        InterfaceCall(receiver, interface_type, requirement, arguments):
                            assert(describe_type(program.types, node_type(program, next)) == "i64?")
                            assert(requirement == 0)
                        else: assert(false)
                Builtin(iterable): assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "interface Iterator[T]:\n    mutating func next(self) -> T?\n")],
        "main.luc:1:1: `Iterator` belongs to the compiler-known core namespace",
    )

    let fallible_source = "let stopped: ErrorCode = ErrorCode.package(1)\nstruct CheckedIterator implements FallibleIterator[i64]:\n    pub mutating func next(self) -> i64?!: error(stopped, \"stopped\")\nstruct Checked implements FallibleIterable[i64]:\n    pub func iterator(self) -> FallibleIterator[i64]: return CheckedIterator()\nfunc sum[T: FallibleIterable[i64]](values: T) -> i64!:\n    try for value in values: return value\n    return 0\nfunc use() -> i64!: return try sum(Checked())\n"
    let fallible_program = checked([source_module("main", fallible_source)])
    var sum_index = -1
    for index in range(0, len(fallible_program.functions)):
        if fallible_program.functions[index].name == "sum[Checked]": sum_index = index
    assert(sum_index >= 0)
    match statement(fallible_program, fallible_program.functions[sum_index], 0):
        ForStatement(symbol, iteration, body):
            match iteration:
                Protocol(iterator_symbol, iterator, next):
                    match form(fallible_program, next):
                        Try(call):
                            assert(describe_type(fallible_program.types, node_type(fallible_program, call)) == "i64?!")
                            assert(describe_type(fallible_program.types, node_type(fallible_program, next)) == "i64?")
                        else: assert(false)
                Builtin(iterable): assert(false)
        else: assert(false)

pub func test_standard_iteration_protocols_reject_ambiguous_and_mismatched_use():
    let fallible = "let stopped: ErrorCode = ErrorCode.package(1)\nstruct CheckedIterator implements FallibleIterator[i64]:\n    pub mutating func next(self) -> i64?!: error(stopped, \"stopped\")\nstruct Checked implements FallibleIterable[i64]:\n    pub func iterator(self) -> FallibleIterator[i64]: return CheckedIterator()\nfunc ordinary(value: Checked):\n    for item in value: discard(item)\n"
    expect_failure(
        [source_module("main", fallible)],
        "main.luc:7:5: `for` requires `Iterable[T]`; use `try for` for `Checked`",
    )

    let infallible = "struct ValuesIterator implements Iterator[i64]:\n    pub mutating func next(self) -> i64?: return none\nstruct Values implements Iterable[i64]:\n    pub func iterator(self) -> Iterator[i64]: return ValuesIterator()\nfunc fallible(value: Values) -> unit!:\n    try for item in value: discard(item)\n"
    expect_failure(
        [source_module("main", infallible)],
        "main.luc:6:5: `try for` requires `FallibleIterable[T]`; `Values` provides only infallible iteration",
    )

    let propagation = "let stopped: ErrorCode = ErrorCode.package(1)\nstruct CheckedIterator implements FallibleIterator[i64]:\n    pub mutating func next(self) -> i64?!: error(stopped, \"stopped\")\nstruct Checked implements FallibleIterable[i64]:\n    pub func iterator(self) -> FallibleIterator[i64]: return CheckedIterator()\nfunc consume(value: Checked):\n    try for item in value: discard(item)\n"
    expect_failure(
        [source_module("main", propagation)],
        "main.luc:7:5: `try for` can propagate failure only from a fallible function",
    )

    let ambiguous = "struct NumberIterator implements Iterator[i64]:\n    pub mutating func next(self) -> i64?: return none\nstruct Ambiguous implements Iterable[i64], Iterable[str]:\n    pub func iterator(self) -> Iterator[i64]: return NumberIterator()\n"
    expect_failure(
        [source_module("main", ambiguous)],
        "main.luc:3:44: type `Ambiguous` cannot use more than one element type across standard iteration protocols",
    )

    let generic_ambiguous = "struct EmptyIterator[T] implements Iterator[T]:\n    pub mutating func next(self) -> T?: return none\nstruct Ambiguous[T] implements Iterable[T], Iterable[i64]:\n    pub func iterator(self) -> Iterator[T]: return EmptyIterator[T]()\n"
    expect_failure(
        [source_module("main", generic_ambiguous)],
        "main.luc:3:45: type `Ambiguous` cannot use more than one element type across standard iteration protocols",
    )

    let cross_protocol = "struct NumberIterator implements Iterator[i64]:\n    pub mutating func next(self) -> i64?: return none\nstruct CrossProtocol implements Iterable[i64], FallibleIterable[str]:\n    pub func iterator(self) -> Iterator[i64]: return NumberIterator()\n"
    expect_failure(
        [source_module("main", cross_protocol)],
        "main.luc:3:48: type `CrossProtocol` cannot use more than one element type across standard iteration protocols",
    )

    expect_failure(
        [source_module("main", "func consume[T: Iterable[i64] & FallibleIterable[str]](value: T): return\n")],
        "main.luc:1:33: generic parameter `T` cannot use more than one element type across standard iteration constraints",
    )

    # Iterator and Iterable are distinct roles: one value may itself produce
    # numbers while creating a separate string iterator for source `for`.
    discard(checked([source_module("main", "func valid[T: Iterator[i64] & Iterable[str]](value: T): return\n")]))

pub func test_structural_markers_are_derived_and_hash_is_one_resolved_hir_operation():
    let source = "struct Pair:\n    let number: i64\n    let text: str\nenum Choice:\n    empty\n    pair(value: Pair)\nfunc same[T: Equatable](left: T, right: T) -> bool: return left == right\nfunc code[T: Hashable](value: T) -> u64: return hash(value)\npub func answer() -> u64:\n    let value = Pair(number = 42, text = \"luce\")\n    let selected = Choice.pair(value = value)\n    return code(selected) if same(selected, selected) else 0u64\n"
    let program = checked([source_module("main", source)])
    var saw_equatable = false
    var saw_hashable = false
    for item in program.interfaces:
        match item.origin:
            Standard(identity):
                if identity == StandardInterface.equatable: saw_equatable = true
                if identity == StandardInterface.hashable: saw_hashable = true
            Source(module): pass
    assert(saw_equatable and saw_hashable)
    # Marker proofs vanish with generic checking; they never become runtime
    # existential witnesses or backend-visible conformances.
    assert(len(program.conformances) == 0)

    # Collection indirection may close a recursive value graph. The proof is
    # coinductive for that repeated type, but every other outgoing component
    # must still satisfy `Equatable`.
    let recursive = "struct Node:\n    let value: i64\n    let children: list[Node]\nfunc same[T: Equatable](left: T, right: T) -> bool: return left == right\nfunc compare(left: Node, right: Node) -> bool: return same(left, right)\n"
    discard(checked([source_module("main", recursive)]))
    expect_failure(
        [source_module("main", "class Token:\n    func init(self): return\nstruct Bad:\n    let children: list[Bad]\n    let token: Token\nfunc compare(left: Bad, right: Bad) -> bool: return left == right\n")],
        "main.luc:6:53: `==` cannot compare `Bad`",
    )
    # Hashing uses the same coinductive proof through immutable collection
    # indirection; a repeated type on the path is neither an error nor an
    # infinite descent, while an unhashable component still fails.
    let frozen = "struct Tree:\n    let value: i64\n    let children: frozen_list[Tree]\nfunc code[T: Hashable](value: T) -> u64: return hash(value)\nfunc keyed(tree: Tree) -> u64:\n    let counts = map[Tree, i64]()\n    return code(tree) + u64(counts.length)\n"
    discard(checked([source_module("main", frozen)]))
    expect_failure(
        [source_module("main", "class Token:\n    func init(self): return\nstruct Tree:\n    let children: frozen_list[Tree]\n    let token: Token\nfunc keyed(tree: Tree) -> u64:\n    let counts = map[Tree, i64]()\n    return u64(counts.length)\n")],
        "main.luc:7:18: map key type `Tree` must satisfy `Equatable & Hashable`",
    )

    var saw_hash = false
    for function in program.functions:
        for position in range(0, i64(function_body(function).count)):
            match node_form(program, node_at(program, function_body(function), position)):
                ReturnStatement(value):
                    match node_form(program, value):
                        Hash(inner):
                            saw_hash = true
                            assert(describe_type(program.types, node_type(program, value)) == "u64")
                        else: pass
                else: pass
    assert(saw_hash)

    expect_failure(
        [source_module("main", "func bad(value: list[i64]) -> u64: return hash(value)\n")],
        "main.luc:1:48: `hash` requires a `Hashable` value, found `list[i64]`",
    )
    expect_failure(
        [source_module("main", "class Box:\n    func init(self): return\nfunc bad(value: Box) -> u64: return hash(value)\n")],
        "main.luc:3:42: `hash` requires a `Hashable` value, found `Box`",
    )
    expect_failure(
        [source_module("main", "struct Bad:\n    let items: list[i64]\nfunc bad(value: Bad) -> u64: return hash(value)\n")],
        "main.luc:3:42: `hash` requires a `Hashable` value, found `Bad`",
    )
    expect_failure(
        [source_module("main", "func bad[T](value: T) -> u64: return hash(value)\n")],
        "main.luc:1:43: `hash` requires a `Hashable` value, found `T`",
    )
    expect_failure(
        [source_module("main", "func bad() -> u64: return hash()\n")],
        "main.luc:1:27: `hash` takes exactly one positional value",
    )
    expect_failure(
        [source_module("main", "func bad() -> u64: return hash(value = 1)\n")],
        "main.luc:1:32: `hash` uses one positional value",
    )
    expect_failure(
        [source_module("main", "func bad() -> u64: return hash[i64](1)\n")],
        "main.luc:1:27: `hash` infers its value type and takes no type arguments",
    )
    expect_failure(
        [source_module("main", "struct Bad implements Hashable:\n    let value: i64\n")],
        "main.luc:1:23: `Hashable` conformance is derived by the compiler and cannot appear in `implements`",
    )
    expect_failure(
        [source_module("main", "func bad(value: Equatable): return\n")],
        "main.luc:1:17: `Equatable` may appear only in a generic constraint",
    )
    expect_failure(
        [source_module("main", "func bad[T: Hashable](left: T, right: T) -> bool: return left == right\n")],
        "main.luc:1:58: `==` cannot compare `T`",
    )

pub func test_comparable_is_an_explicit_same_type_standard_contract():
    let source = "struct Score implements Comparable:\n    let value: i64\n    pub func compare(self, other: Score) -> i64:\n        if self.value < other.value: return -1\n        if self.value > other.value: return 1\n        return 0\nfunc maximum[T: Comparable](left: T, right: T) -> T:\n    return left if left.compare(other = right) >= 0 else right\nfunc use() -> i64: return maximum(Score(value = 40), Score(value = 42)).value\n"
    let program = checked([source_module("main", source)])
    assert(len(program.interfaces) == 1)
    match program.interfaces[0].origin:
        Standard(identity): assert(identity == StandardInterface.comparable)
        Source(module): assert(false)
    assert(program.interfaces[0].name == "Comparable")
    assert(len(program.interfaces[0].requirements) == 1)
    assert(program.interfaces[0].requirements[0].name == "compare")
    assert(program.interfaces[0].requirements[0].parameters[0].name == "other")
    assert(describe_type(program.types, program.interfaces[0].requirements[0].result) == "i64")
    assert(len(program.conformances) == 1)
    assert(describe_type(program.types, program.conformances[0].interface_type) == "Comparable")
    assert(program.functions[len(program.functions) - 1].name == "maximum[Score]")

    expect_failure(
        [source_module("main", "struct Missing implements Comparable:\n    let value: i64\n")],
        "main.luc:1:27: type `Missing` does not implement requirement `compare` of `Comparable`",
    )
    expect_failure(
        [source_module("main", "struct Wrong implements Comparable:\n    pub func compare(self, other: i64) -> i64: return 0\n")],
        "main.luc:1:25: method `Wrong.compare` does not match parameter `other` of the interface",
    )
    expect_failure(
        [source_module("main", "struct Wrong implements Comparable:\n    pub func compare(self, other: Wrong) -> i32: return 0i32\n")],
        "main.luc:1:25: method `Wrong.compare` returns `i32`, but the interface requires `i64`",
    )
    expect_failure(
        [source_module("main", "func bad(value: Comparable): return\n")],
        "main.luc:1:17: `Comparable` has an implicit same-type operand and may appear only as a generic constraint or explicit conformance",
    )
    expect_failure(
        [source_module("main", "func bad[T: Comparable[i64]](value: T): return\n")],
        "main.luc:1:13: `Comparable` has an implicit same-type operand and may appear only as a generic constraint or explicit conformance",
    )
    expect_failure(
        [source_module("main", "interface Comparable:\n    func compare(self, other: i64) -> i64\n")],
        "main.luc:1:1: `Comparable` belongs to the compiler-known core namespace",
    )

pub func test_constraint_resolution_preserves_fallible_lifts_and_parameter_identity():
    let source = "interface Writer:\n    func write(self) -> unit!\ninterface Left:\n    func left(self) -> i64\ninterface Right:\n    func right(self) -> i64\nstruct Both implements Writer, Left, Right:\n    pub func write(self): return\n    pub func left(self) -> i64: return 20\n    pub func right(self) -> i64: return 22\nfunc emit[T: Writer](value: T) -> unit!:\n    try value.write()\nfunc combine[A: Left, B: Right](left: A, right: B) -> i64:\n    return left.left() + right.right()\nfunc use() -> i64!:\n    try emit(Both())\n    return combine(Both(), Both())\n"
    let program = checked([source_module("main", source)])
    assert(len(program.conformances) == 3)
    assert(len(program.functions) == 7)
    assert(program.functions[4].name == "emit[Both]")
    assert(program.functions[5].name == "combine[Both, Both]")
    assert(program.functions[6].name == ".luce_interface_lift_0")

pub func test_interface_parameter_constraints_and_compatible_intersections_are_checked():
    let source = "interface Labelled:\n    func label(self) -> i64\ninterface Source[T: Labelled]:\n    func item(self) -> T\ninterface First:\n    func value(self) -> i64\ninterface Second:\n    func value(self) -> i64\nstruct Token implements Labelled:\n    pub func label(self) -> i64: return 40\nstruct TokenSource implements Source[Token]:\n    pub func item(self) -> Token: return Token()\nstruct Both implements First, Second:\n    pub func value(self) -> i64: return 2\nfunc read[S: Source[Token], B: First & Second](source: S, both: B) -> i64:\n    return source.item().label() + both.value()\nfunc use() -> i64: return read(TokenSource(), Both())\n"
    let program = checked([source_module("main", source)])
    assert(len(program.interfaces) == 4)
    assert(len(program.conformances) == 4)
    assert(program.functions[len(program.functions) - 1].name == "read[TokenSource, Both]")

pub func test_public_interfaces_and_conformances_resolve_across_modules():
    let modules = [
        source_module("model", "pub interface Valued:\n    func value(self) -> i64\npub struct Item implements Valued:\n    pub func value(self) -> i64: return 42\n"),
        source_module("main", "import model\nfunc read[T: model.Valued](value: T) -> i64: return value.value()\nfunc use() -> i64: return read(model.Item())\n"),
    ]
    let program = checked(modules)
    assert(len(program.interfaces) == 1)
    assert(len(program.conformances) == 1)
    assert(program.functions[len(program.functions) - 1].name == "read[Item]")

pub func test_struct_class_and_enum_conformances_follow_the_same_contract():
    let source = "interface Identified:\n    func identifier(self) -> i64\ninterface Adjustable:\n    mutating func adjust(self)\nstruct Record implements Identified:\n    pub func identifier(self) -> i64: return 40\nclass Counter implements Identified, Adjustable:\n    var value: i64\n    pub func init(self): self.value = 1\n    pub func identifier(self) -> i64: return self.value\n    pub func adjust(self): self.value += 1\nenum Flag implements Identified:\n    enabled\n    pub func identifier(self) -> i64: return 2\n"
    let program = checked([source_module("main", source)])
    assert(len(program.conformances) == 4)
    assert(describe_type(program.types, program.conformances[0].value_type) == "Record")
    assert(describe_type(program.types, program.conformances[1].value_type) == "Counter")
    assert(describe_type(program.types, program.conformances[2].value_type) == "Counter")
    assert(describe_type(program.types, program.conformances[3].value_type) == "Flag")

pub func test_interface_values_retain_dynamic_calls_and_mutating_value_semantics():
    let source = "interface Counter:\n    mutating func increment(self)\n    func value(self) -> i64\nstruct Count implements Counter:\n    var amount: i64\n    pub mutating func increment(self): self.amount += 1\n    pub func value(self) -> i64: return self.amount\nfunc changed(value: Counter) -> i64:\n    var current: Counter = value\n    current.increment()\n    return current.value()\nfunc use() -> i64: return changed(Count(amount = 41))\n"
    let program = checked([source_module("main", source)])
    var conversions = 0
    var calls = 0
    for node in program.nodes:
        match node.form:
            InterfaceValue(value, conformance): conversions += 1
            InterfaceCall(receiver, interface_type, requirement, arguments): calls += 1
            else: pass
    assert(conversions == 1)
    assert(calls == 2)

pub func test_interface_calls_share_declaration_argument_placement_and_diagnostics():
    let source = "interface Combiner:\n    func combine(self, left: i64, right: i64) -> i64\nstruct Pair implements Combiner:\n    pub func combine(self, left: i64, right: i64) -> i64: return left * 10 + right\nfunc use(value: Combiner) -> i64: return value.combine(right = 2, left = 4)\n"
    let program = checked([source_module("main", source)])
    var found = false
    for node in program.nodes:
        match node.form:
            InterfaceCall(receiver, interface_type, requirement, arguments):
                found = true
                assert(arguments.count == 4)
                assert(argument_parameter(program, arguments, 0) == 1)
                assert(argument_parameter(program, arguments, 1) == 0)
            else: pass
    assert(found)

    let prefix = "interface Combiner:\n    func combine(self, left: i64, right: i64) -> i64\nfunc use(value: Combiner) -> i64: return "
    expect_failure(
        [source_module("main", prefix + "value.combine(left = 1, 2)\n")],
        "main.luc:3:66: positional arguments must precede named arguments",
    )
    expect_failure(
        [source_module("main", prefix + "value.combine(left = 1, left = 2)\n")],
        "main.luc:3:66: parameter `left` is supplied more than once",
    )
    expect_failure(
        [source_module("main", prefix + "value.combine(other = 1, right = 2)\n")],
        "main.luc:3:56: interface method `combine` has no parameter `other`",
    )
    expect_failure(
        [source_module("main", prefix + "value.combine(left = 1)\n")],
        "main.luc:3:42: call to interface method `combine` is missing argument `right`",
    )

pub func test_interface_and_constrained_generic_rules_have_stable_diagnostics():
    expect_failure(
        [source_module("main", "interface Factory:\n    func make() -> i64\n")],
        "main.luc:2:5: interface requirement `make` must declare `self` first",
    )
    expect_failure(
        [source_module("main", "interface Defaulted:\n    func value(self, fallback: i64 = 0) -> i64\n")],
        "main.luc:2:22: interface requirements cannot declare parameter defaults",
    )
    expect_failure(
        [source_module("main", "interface Generic:\n    func value[T](self, item: T) -> T\n")],
        "main.luc:2:5: interface requirements cannot be generic",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Empty implements Named:\n    let value: i64\n")],
        "main.luc:3:25: type `Empty` does not implement requirement `name` of `Named`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Wrong implements Named:\n    pub func name(self) -> i64: return 0\n")],
        "main.luc:3:25: method `Wrong.name` returns `i64`, but the interface requires `str`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Hidden implements Named:\n    func name(self) -> str: return \"x\"\n")],
        "main.luc:3:26: method `Hidden.name` must be public to satisfy an interface",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Item:\n    pub func name(self) -> str: return \"x\"\nfunc read[T: Named](value: T) -> str: return value.name()\nfunc use() -> str: return read(Item())\n")],
        "main.luc:6:27: type `Item` does not conform to `Named` required by `T`",
    )
    expect_failure(
        [source_module("main", "interface Labelled:\n    func label(self) -> i64\ninterface Source[T: Labelled]:\n    func item(self) -> T\nstruct Plain:\n    let value: i64\nstruct Bad implements Source[Plain]:\n    pub func item(self) -> Plain: return Plain(value = 0)\n")],
        "main.luc:7:23: interface argument `Plain` does not conform to `Labelled` required by `T`",
    )
    expect_failure(
        [source_module("main", "interface First:\n    func value(self) -> i64\ninterface Second:\n    func value(self) -> bool\nfunc read[T: First & Second](value: T) -> i64: return value.value()\n")],
        "main.luc:5:55: method `value` is ambiguous across generic constraints",
    )
    expect_failure(
        [source_module("main", "interface Counter:\n    mutating func increment(self)\nstruct Value implements Counter:\n    var count: i64\n    pub mutating func increment(self): self.count += 1\nfunc advance[T: Counter](value: T): value.increment()\n")],
        "main.luc:6:37: mutating method needs a `var` receiver; `value` is immutable",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> i64\nstruct Item:\n    pub func name(self) -> i64: return 1\nfunc store():\n    let value: Named = Item()\n")],
        "main.luc:6:24: type `Item` does not conform to `Named`",
    )
    expect_failure(
        [source_module("main", "interface Counter:\n    mutating func increment(self)\nstruct Count implements Counter:\n    var value: i64\n    pub mutating func increment(self): self.value += 1\nfunc change(value: Counter): value.increment()\n")],
        "main.luc:6:30: mutating method needs a `var` receiver; `value` is immutable",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> i64\nfunc same(left: Named, right: Named) -> bool: return left is right\n")],
        "main.luc:3:54: `is` requires shared reference operands, found `Named`",
    )
    expect_failure(
        [source_module("main", "interface Duplicate:\n    func value(self) -> i64\n    func value(self) -> i64\n")],
        "main.luc:3:5: duplicate interface requirement `value`",
    )
    expect_failure(
        [source_module("main", "interface Constructible:\n    func init(self)\n")],
        "main.luc:2:5: an interface cannot require `init`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nfunc read[T: Named & Named](value: T) -> str: return value.name()\n")],
        "main.luc:3:22: duplicate constraint `Named` on `T`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Twice implements Named, Named:\n    pub func name(self) -> str: return \"x\"\n")],
        "main.luc:3:32: duplicate conformance of `Twice` to `Named`",
    )
    expect_failure(
        [source_module("main", "interface Mapper[T]:\n    func map(self, value: T) -> T\nstruct Wrong implements Mapper:\n    pub func map(self, value: i64) -> i64: return value\n")],
        "main.luc:3:25: interface `Mapper` needs 1 type argument(s)",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self, prefix: str) -> str\nstruct Wrong implements Named:\n    pub func name(self, value: str) -> str: return value\n")],
        "main.luc:3:25: method `Wrong.name` does not match parameter `prefix` of the interface",
    )
    expect_failure(
        [source_module("main", "interface Action:\n    func run(self, value: i64)\nstruct Wrong implements Action:\n    pub func run(self): return\n")],
        "main.luc:3:25: method `Wrong.run` has the wrong number of parameters for the interface",
    )
    expect_failure(
        [source_module("main", "interface Action:\n    mutating func run(self)\nstruct Wrong implements Action:\n    pub func run(self): return\n")],
        "main.luc:3:25: method `Wrong.run` must be `mutating` to satisfy the interface",
    )
    expect_failure(
        [source_module("main", "interface Action:\n    func run(self)\nstruct Wrong implements Action:\n    pub mutating func run(self): return\n")],
        "main.luc:3:25: mutating method `Wrong.run` cannot satisfy a non-mutating interface requirement",
    )
    expect_failure(
        [source_module("main", "interface Action:\n    func run(self)\nstruct Wrong implements Action:\n    pub func run(): return\n")],
        "main.luc:3:25: method `Wrong.run` is not an instance method required by the interface",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nstruct Wrong implements Named:\n    pub func name(self) -> str!: return \"x\"\n")],
        "main.luc:3:25: method `Wrong.name` returns `str!`, but the interface requires `str`",
    )
    expect_failure(
        [source_module("main", "interface First:\n    func value(self) -> i64\ninterface Second:\n    func value(self) -> i64\nfunc convert(value: First) -> Second: return value\n")],
        "main.luc:5:46: expected `Second`, found `First`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nfunc same(left: Named, right: Named) -> bool: return left == right\n")],
        "main.luc:3:54: `==` cannot compare `Named`",
    )
    expect_failure(
        [source_module("main", "interface Named:\n    func name(self) -> str\nfunc code(value: Named) -> u64: return hash(value)\n")],
        "main.luc:3:45: `hash` requires a `Hashable` value, found `Named`",
    )
    expect_failure(
        [source_module("contract", "interface Hidden:\n    func value(self) -> i64\n"), source_module("main", "import contract\nfunc read[T: contract.Hidden](value: T) -> i64: return value.value()\n")],
        "main.luc:2:14: `Hidden` is private to module `contract`",
    )

# mark: Module and name diagnostics =========================================================

pub func test_private_and_missing_imports_are_rejected():
    let private_sources = [
        source_module("math", "func hidden() -> i64: return 1\n"),
        source_module("main", "from math import hidden\nfunc answer() -> i64: return hidden()\n"),
    ]
    expect_failure(private_sources, "main.luc:1:18: `hidden` is private to module `math`")
    expect_failure([source_module("main", "import missing\nfunc answer() -> i64: return 0\n")], "main.luc:1:8: unknown module `missing`")

pub func test_public_constants_share_qualified_and_selective_import_resolution():
    let library = source_module("constants", "pub let answer: i64 = 40 + 2\nlet hidden: i64 = 0\n")
    let program = checked([
        library,
        source_module("qualified", "import constants\nfunc value() -> i64: return constants.answer\n"),
        source_module("selective", "from constants import answer\nfunc value() -> i64: return answer\n"),
    ])
    assert(len(program.constants) == 2)
    let answer_symbol = program.constants[0].symbol
    for function in program.functions:
        match statement(program, function, 0):
            ReturnStatement(value):
                match form(program, value):
                    Reference(symbol): assert(symbol.value == answer_symbol.value)
                    else: assert(false)
            else: assert(false)

    expect_failure(
        [library, source_module("main", "import constants\nfunc value() -> i64: return constants.hidden\n")],
        "main.luc:2:29: `hidden` is private to module `constants`",
    )
    expect_failure(
        [library, source_module("main", "from constants import hidden\nfunc value() -> i64: return hidden\n")],
        "main.luc:1:23: `hidden` is private to module `constants`",
    )
    expect_failure(
        [library, source_module("main", "from constants import missing\nfunc value() -> i64: return 0\n")],
        "main.luc:1:23: module `constants` has no declaration `missing`",
    )
    expect_failure(
        [library, source_module("main", "from constants import answer\nfunc value() -> i64:\n    let answer = 0\n    return answer\n")],
        "main.luc:3:9: local `answer` cannot shadow an imported name",
    )

pub func test_selective_imports_share_one_declaration_namespace_for_values_and_types():
    let model = "pub type Count = i64\npub struct Point:\n    pub let value: Count\npub class Box:\n    pub func init(self): return\npub enum Choice:\n    empty\npub interface Readable:\n    func read(self) -> Count\npub extern type Handle = i64\n"
    discard(checked([
        source_module("model", model),
        source_module(
            "main",
            "from model import Count, Point, Box, Choice, Readable, Handle\nfunc preserve(count: Count, point: Point, box: Box, choice: Choice, readable: Readable, handle: Handle) -> Count: return count\n",
        ),
    ]))

pub func test_unused_imports_and_shortest_module_cycles_are_rejected():
    let library = source_module("library", "pub func first() -> i64: return 1\npub func second() -> i64: return 2\n")
    expect_failure(
        [library, source_module("main", "import library\nfunc answer() -> i64: return 0\n")],
        "main.luc:1:1: unused import `library`; remove this import",
    )
    expect_failure(
        [library, source_module("main", "from library import first, second\nfunc answer() -> i64: return first()\n")],
        "main.luc:1:28: unused import `second` from module `library`; remove this import",
    )
    expect_failure(
        [
            source_module("a", "import b\npub func from_a() -> i64: return b.from_b()\n"),
            source_module("b", "import a\npub func from_b() -> i64: return a.from_a()\n"),
        ],
        "b.luc:1:1: module dependency cycle: `a -> b -> a`; move declaration `from_a` into a lower-level module",
    )

pub func test_public_apis_cannot_expose_private_types():
    let hidden = "struct Hidden:\n    let value: i64\n"
    expect_failure(
        [source_module("main", hidden + "pub func leak(value: list[Hidden]) -> i64: return 0\n")],
        "main.luc:3:1: public function `leak` exposes private type `Hidden` through parameter `value`",
    )
    expect_failure(
        [source_module("main", hidden + "pub type Revealed = list[Hidden]\n")],
        "main.luc:3:1: public type alias `Revealed` exposes private type `Hidden` through aliased type",
    )
    expect_failure(
        [source_module("main", hidden + "pub let revealed: Hidden = Hidden(0)\n")],
        "main.luc:3:1: public constant `revealed` exposes private type `Hidden` through declared type",
    )
    expect_failure(
        [source_module("main", hidden + "pub struct Revealed:\n    pub let hidden: Hidden\n")],
        "main.luc:3:1: public struct `Revealed` exposes private type `Hidden` through field `hidden`",
    )
    expect_failure(
        [source_module("main", hidden + "pub class Revealed:\n    pub let hidden: Hidden\n    func init(self, hidden: Hidden): self.hidden = hidden\n")],
        "main.luc:3:1: public class `Revealed` exposes private type `Hidden` through field `hidden`",
    )
    expect_failure(
        [source_module("main", hidden + "pub enum Revealed:\n    item(hidden: Hidden)\n")],
        "main.luc:3:1: public enum `Revealed` exposes private type `Hidden` through case `item` payload `hidden`",
    )
    expect_failure(
        [source_module("main", hidden + "pub interface Revealed:\n    func read(self, hidden: Hidden) -> i64\n")],
        "main.luc:4:5: public interface `Revealed` exposes private type `Hidden` through requirement `read` parameter `hidden`",
    )
    expect_failure(
        [source_module("main", "interface Secret:\n    func read(self) -> i64\npub func reveal[T: Secret](value: T) -> T: return value\n")],
        "main.luc:3:1: public function `reveal` exposes private type `Secret` through type parameter `T` constraint",
    )
    expect_failure(
        [source_module("main", hidden + "pub func generic_leak[T](value: Hidden) -> T: trap(\"unreachable\")\n")],
        "main.luc:3:1: public function `generic_leak` exposes private type `Hidden` through parameter `value`",
    )
    discard(checked([source_module(
        "main",
        hidden + "pub struct Opaque:\n    let hidden: Hidden\n",
    )]))

pub func test_duplicate_modules_declarations_and_parameters_are_rejected():
    let empty = ""
    expect_failure([source_module("same", empty), source_module("same", empty)], "same.luc:1:1: duplicate module `same`")
    expect_failure([source_module("main", "func value(): return\nfunc value(): return\n")], "main.luc:2:1: duplicate declaration `value`")
    expect_failure([source_module("main", "func value(item: i64, item: i64): return\n")], "main.luc:1:23: duplicate parameter `item`")

# A module-level `mutating func` never reaches HirGenerator: the parser rejects
# it (see parser_test), so only the class-method case is semantic.
pub func test_mutating_is_restricted_to_value_type_methods_and_requirements():
    let class_method = "class Counter:\n    mutating func increment(self): return\n"
    assert(
        semantic_failure([source_module("main", class_method)])
        == "main.luc:2:5: class methods do not use `mutating`; class identity already permits field mutation"
    )

pub func test_unknown_names_and_import_collisions_are_rejected():
    expect_failure([source_module("main", "func answer() -> i64: return missing\n")], "main.luc:1:30: unknown name `missing`")
    let sources = [
        source_module("math", "pub func answer() -> i64: return 42\n"),
        source_module("main", "from math import answer\nfunc answer() -> i64: return 0\n"),
    ]
    expect_failure(sources, "main.luc:1:18: imported name `answer` conflicts with a declaration")
    expect_failure(
        [source_module("lib", ""), source_module("main", "import lib as Handle\nextern type Handle = i32\n")],
        "main.luc:1:1: imported name `Handle` conflicts with a declaration",
    )
    expect_failure(
        [source_module("lib", ""), source_module("main", "import lib as Item\nstruct Item:\n    let value: i32\n")],
        "main.luc:1:1: imported name `Item` conflicts with a declaration",
    )
    expect_failure(
        [source_module("lib", ""), source_module("main", "import lib as State\nenum State:\n    ready\n")],
        "main.luc:1:1: imported name `State` conflicts with a declaration",
    )


# mark: Type and control-flow diagnostics ===================================================

pub func test_call_and_return_types_are_checked():
    let call_sources = [
        source_module("logic", "pub func choose(value: bool) -> bool: return value\n"),
        source_module("main", "from logic import choose\nfunc answer() -> bool: return choose(1)\n"),
    ]
    expect_failure(call_sources, "main.luc:2:38: expected `bool`, found `i64`")
    expect_failure([source_module("main", "func answer() -> bool: return 1\n")], "main.luc:1:31: expected `bool`, found `i64`")

pub func test_immutable_assignment_and_non_boolean_conditions_are_rejected():
    let immutable = "func update():\n    let value = 1\n    value = 2\n"
    expect_failure([source_module("main", immutable)], "main.luc:3:5: cannot assign to immutable binding `value`; declare it with `var`")
    let condition = "func choose() -> i64:\n    if 1: return 1\n    return 0\n"
    expect_failure([source_module("main", condition)], "main.luc:2:8: expected `bool`, found `i64`")

pub func test_errors_try_and_catch_are_typed_as_data_and_transfer():
    let source = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked(flag: bool) -> i64!:\n    if flag: error(invalid, \"invalid\")\n    return 21\nfunc handled(flag: bool) -> i64:\n    return checked(flag) catch failure:\n        if failure.code == invalid: recover 7\n        recover 8\nfunc propagated(flag: bool) -> i64!:\n    return try checked(flag)\n"
    let program = checked([source_module("main", source)])
    assert(program.packages[program.root_package.value].identity == "test.luce")
    var saw_code = false
    var saw_raise = false
    var saw_try = false
    var saw_catch = false
    var recoveries = 0
    for node in program.nodes:
        match node.form:
            ErrorCodeLiteral(package, value):
                assert(program.packages[package.value].identity == "test.luce")
                assert(value == 7)
                saw_code = true
            Raise(code, message):
                assert(types_match(node_type(program, code), resolve_builtin_type(BuiltinType.error_code)))
                assert(types_match(node_type(program, message), resolve_builtin_type(BuiltinType.string)))
                saw_raise = true
            Try(value): saw_try = true
            Catch(value, failure, body):
                assert(program.symbols[failure.value].name == "failure")
                assert(types_match(program.symbols[failure.value].value_type, resolve_builtin_type(BuiltinType.error_value)))
                saw_catch = true
            RecoverStatement(value): recoveries += 1
            else: pass
    assert(saw_code and saw_raise and saw_try and saw_catch)
    assert(recoveries == 2)
    expect_failure(
        [source_module("main", "pub let invalid: ErrorCode = ErrorCode.package(1)\nfunc bad() -> unit!: error[i64](invalid, \"no\")\n")],
        "main.luc:2:22: `error` takes no type arguments",
    )

pub func test_trap_is_a_dynamic_nonrecoverable_terminator():
    let source = "func stop(prefix: str) -> i64:\n    trap(prefix + \" now\")\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ExpressionStatement(value):
            match form(program, value):
                Trap(message):
                    assert(describe_type(program.types, node_type(program, value)) == "never")
                    assert(describe_type(program.types, node_type(program, message)) == "str")
                else: assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "func bad(): trap()\n")],
        "main.luc:1:13: `trap` takes one positional `str` message",
    )
    expect_failure(
        [source_module("main", "func bad(): trap(message = \"no\")\n")],
        "main.luc:1:13: `trap` takes one positional `str` message",
    )
    expect_failure(
        [source_module("main", "func bad(): trap[i64](\"no\")\n")],
        "main.luc:1:13: `trap` takes no type arguments",
    )
    expect_failure(
        [source_module("main", "func bad(): trap(1)\n")],
        "main.luc:1:18: expected `str`, found `i64`",
    )

pub func test_assert_is_an_eager_unit_valued_core_call():
    let source = "func check(condition: bool, message: str) -> unit:\n    assert(condition, message + \" now\")\nfunc default_message(): assert(true)\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ExpressionStatement(value):
            match form(program, value):
                Assert(condition, message):
                    assert(describe_type(program.types, node_type(program, value)) == "unit")
                    assert(describe_type(program.types, node_type(program, condition)) == "bool")
                    assert(describe_type(program.types, node_type(program, message)) == "str")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ExpressionStatement(value):
            match form(program, value):
                Assert(condition, message):
                    match form(program, message):
                        Constant(constant):
                            match program.values[i64(constant)]:
                                Text(text): assert(text == "assertion failed")
                                else: assert(false)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "func bad(): assert()\n")],
        "main.luc:1:13: `assert` takes a positional `bool` condition and an optional positional `str` message",
    )
    expect_failure(
        [source_module("main", "func bad(): assert(condition = true, message = \"no\")\n")],
        "main.luc:1:13: `assert` takes a positional `bool` condition and an optional positional `str` message",
    )
    expect_failure(
        [source_module("main", "func bad(): assert(true, \"no\", \"extra\")\n")],
        "main.luc:1:13: `assert` takes a positional `bool` condition and an optional positional `str` message",
    )
    expect_failure(
        [source_module("main", "func bad(): assert[i64](true, \"no\")\n")],
        "main.luc:1:13: `assert` takes no type arguments",
    )
    expect_failure(
        [source_module("main", "func bad(): assert(1, \"no\")\n")],
        "main.luc:1:20: expected `bool`, found `i64`",
    )
    expect_failure(
        [source_module("main", "func bad(): assert(true, 1)\n")],
        "main.luc:1:26: expected `str`, found `i64`",
    )

pub func test_error_codes_use_restricted_constants_and_are_package_unique():
    let source = "let base: u32 = 3\npub let arithmetic: ErrorCode = (ErrorCode.package((base + 1) * 2 - 1))\npub let conditional: ErrorCode = ErrorCode.package(9 if true else 10)\n"
    let program = checked([source_module("main", source)])
    assert(program.packages[program.root_package.value].identity == "test.luce")
    var saw_seven = false
    var saw_nine = false
    for node in program.nodes:
        match node.form:
            ErrorCodeLiteral(package, value):
                assert(program.packages[package.value].identity == "test.luce")
                if value == 7: saw_seven = true
                if value == 9: saw_nine = true
            else: pass
    assert(saw_seven and saw_nine)

    let duplicate = "pub let first: ErrorCode = ErrorCode.package(7)\npub let second: ErrorCode = ErrorCode.package(3 + 4)\n"
    assert(semantic_failure([source_module("main", duplicate)]) != "")
    let runtime_value = "func code() -> ErrorCode: return ErrorCode.package(7)\n"
    assert(semantic_failure([source_module("main", runtime_value)]) != "")

pub func test_fallibility_is_an_outer_function_result_effect_only():
    let parameter = "func consume(value: i64!): return\n"
    assert(semantic_failure([source_module("main", parameter)]) != "")
    let field = "struct Stored:\n    let value: i64!\n"
    assert(semantic_failure([source_module("main", field)]) != "")
    let binding = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked() -> i64!: error(invalid, \"invalid\")\nfunc use():\n    let pending = checked()\n"
    assert(semantic_failure([source_module("main", binding)]) != "")
    let nested = "func invalid() -> (i64!, i64): return (1, 2)\n"
    assert(semantic_failure([source_module("main", nested)]) != "")

pub func test_failure_transfer_requires_a_valid_lexical_destination():
    let unhandled = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked() -> i64!: error(invalid, \"invalid\")\nfunc use(): checked()\n"
    assert(semantic_failure([source_module("main", unhandled)]) != "")
    let illegal_try = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked() -> i64!: error(invalid, \"invalid\")\nfunc use() -> i64: return try checked()\n"
    assert(semantic_failure([source_module("main", illegal_try)]) != "")
    let illegal_recover = "func use() -> i64:\n    recover 7\n"
    assert(semantic_failure([source_module("main", illegal_recover)]) != "")
    let falling_handler = "pub let invalid: ErrorCode = ErrorCode.package(7)\nfunc checked() -> i64!: error(invalid, \"invalid\")\nfunc use() -> i64:\n    return checked() catch failure:\n        let fallback = 7\n"
    assert(semantic_failure([source_module("main", falling_handler)]) != "")

pub func test_non_unit_functions_must_return_on_every_path():
    let source = "func choose(flag: bool) -> i64:\n    if flag: return 1\n"
    expect_failure([source_module("main", source)], "main.luc:1:1: function `choose` may finish without returning `i64`")
    let complete = "func choose(flag: bool) -> i64:\n    if flag: return 1\n    else: return 0\n"
    expect_failure([source_module("main", complete)], "")

pub func test_literals_are_decoded_and_range_checked():
    let program = checked([source_module("main", "func value() -> i64: return -9223372036854775808\n")])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[i64(constant)]:
                        SignedInteger(item): assert(item == -9223372036854775807 - 1)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    let outside = "func value() -> i64: return 9223372036854775808\n"
    expect_failure([source_module("main", outside)], "main.luc:1:29: integer literal is outside the representable integer range")

pub func test_extern_variables_are_mutable_observable_values_with_a_closed_boundary_vocabulary():
    let ffi = "pub extern type Handle\npub extern var counter: i32\npub extern var current: Handle\n"
    let main = "import ffi\nfrom ffi import counter\nfunc answer() -> i32:\n    counter += 2i32\n    ffi.current = ffi.current\n    return counter\n"
    let program = checked([source_module("ffi", ffi), source_module("main", main)])
    assert(len(program.extern_variables) == 2)
    assert(program.extern_variables[0].name == "counter")
    assert(types_match(program.extern_variables[0].value_type, resolve_builtin_type(BuiltinType.signed_i32)))
    match statement(program, program.functions[0], 0):
        ExternStore(variable, operation, value):
            assert(variable == 0)
            match operation:
                Combine(binary): pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 1):
        ExternStore(variable, operation, value):
            assert(variable == 1)
            match form(program, value):
                ExternLoad(loaded): assert(loaded == 1)
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "extern var text: str\n")],
        "main.luc:1:18: extern variable `text` has unsupported boundary type `str`",
    )
    expect_failure(
        [source_module("main", "extern type Handle\nextern var maybe: Handle?\n")],
        "main.luc:2:19: extern variable `maybe` has unsupported boundary type `Handle?`",
    )
    let else_source = "func value(input: i64) -> i64: return input else 0\n"
    expect_failure([source_module("main", else_source)], "main.luc:1:39: `else` requires an optional value, found `i64`")

# mark: Types and literals ==================================================================

pub func test_scalar_types_and_literal_suffixes_are_typed():
    let source = "func value() -> u8: return 7u8\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "u8")
    expect_failure([source_module("main", "func value() -> u8: return 300u8\n")], "main.luc:1:28: integer literal is outside `u8` range")
    let half = checked([source_module("main", "func value() -> f16: return 0.1f16\n")])
    assert(describe_type(half.types, half.functions[0].result) == "f16")
    let divergence = checked([source_module("main", "pub let stopped: ErrorCode = ErrorCode.package(1)\nfunc stop(message: str) -> never: trap(message)\nfunc fail() -> never!: error(stopped, \"failed\")\nfunc forward(callback: func(str) -> never) -> never: callback(\"forwarded\")\nfunc choose(flag: bool) -> i64: return 42 if flag else stop(\"stopped\")\nfunc propagate() -> never!: try fail()\n")])
    assert(describe_type(divergence.types, divergence.functions[0].result) == "never")
    assert(describe_type(divergence.types, divergence.functions[1].result) == "never!")
    assert(describe_type(divergence.types, divergence.functions[2].result) == "never")
    assert(describe_type(divergence.types, divergence.functions[4].result) == "never!")
    expect_failure([source_module("main", "func value() -> never: return\n")], "main.luc:1:24: return requires a `never` value")
    let maximum = checked([source_module("main", "func value() -> u64: return 18446744073709551615u64\n")])
    match statement(maximum, maximum.functions[0], 0):
        ReturnStatement(value):
            match form(maximum, value):
                Constant(constant):
                    match maximum.values[i64(constant)]:
                        UnsignedInteger(item): assert(item == u64(18446744073709551615))
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    expect_failure([source_module("main", "func value() -> u64: return 18446744073709551616u64\n")], "main.luc:1:29: integer literal is outside the representable integer range")

pub func test_never_is_a_callable_result_not_a_storable_value():
    discard(checked([source_module("main", "func bad(callback: func() -> never) -> never: callback()\n")]))
    discard(checked([source_module("main", "func stop[T]() -> T: trap(\"generic\")\nfunc end() -> never: stop[never]()\n")]))
    let nested = checked([source_module("main", "func stop() -> never: trap(\"nested\")\nfunc consume(first: i64, second: i64) -> i64: return first + second\nfunc nested() -> i64: return consume(1, stop())\n")])
    match statement(nested, nested.functions[2], 0):
        ReturnStatement(value):
            assert(node_diverges(nested, value))
            assert(describe_type(nested.types, node_type(nested, value)) == "i64")
            match node_form(nested, value):
                NeverCoercion(inner):
                    match node_form(nested, inner):
                        DivergingSequence(values): assert(values.count == 2)
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "func bad(value: never): return\n")],
        "main.luc:1:10: parameter `value` cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "struct Bad:\n    let value: never\n")],
        "main.luc:2:5: field `value` cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "func bad(): let value = trap(\"x\")\n")],
        "main.luc:1:13: binding `value` cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "func bad() -> never?: trap(\"x\")\n")],
        "main.luc:1:15: an optional payload cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "func bad(value: list[never]): return\n")],
        "main.luc:1:22: a list element cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [native_source_module("raw", "func bad(value: native_ptr[never]): return\n")],
        "raw.lucn:1:28: a native pointer pointee cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "func sink[T](value: T): return\nfunc stop() -> never: trap(\"generic\")\nfunc bad() -> never: sink[never](stop())\n")],
        "main.luc:3:22: parameter `value` cannot store `never`; it is permitted only as a function's complete successful result",
    )
    expect_failure(
        [source_module("main", "interface Sink[T]:\n    func put(self, value: T)\nfunc bad(value: Sink[never]): return\n")],
        "main.luc:3:17: parameter `value` cannot store `never`; it is permitted only as a function's complete successful result",
    )

pub func test_string_char_and_none_literals_are_typed():
    let source = "func label() -> str: return \"ok\"\nfunc mark() -> char: return 'A'\nfunc missing() -> i64?: return none\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "str")
    assert(describe_type(program.types, program.functions[1].result) == "char")
    assert(describe_type(program.types, program.functions[2].result) == "i64?")

pub func test_literal_spellings_are_decoded_once_before_entering_hir():
    let source = "func raw() -> str: return r\"C:\\studio\\n\"\nfunc escaped() -> str: return \"\\0\\u{3bb}\\u{1f600}\"\nfunc mark() -> char: return '\\u{1f600}'\nfunc payload() -> bytes: return b\"\\x00\\xff\\u{3bb}\"\nfunc show(): print(r\"literal\\n\")\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[i64(constant)]:
                        Text(text): assert(text == "C:\\studio\\n")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[i64(constant)]:
                        Text(text):
                            assert(len(text) == 3)
                            assert(text[0] == char(0) and text[1] == 'λ' and text[2] == '😀')
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[2], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[i64(constant)]:
                        Character(character): assert(character == '😀')
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[i64(constant)]:
                        Bytes(payload):
                            assert(len(payload) == 4)
                            assert(payload[0] == u8(0) and payload[1] == u8(255))
                            assert(payload[2] == u8(206) and payload[3] == u8(187))
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[4], 0):
        PrintText(text): assert(text == "literal\\n")
        else: assert(false)

    let triple_source = "func text() -> str:\n    return \"\"\"\n        alpha\n          beta\n        \"\"\"\nfunc data() -> bytes: return b\"\"\"A\\x00\"\"\"\n"
    let triples = checked([source_module("main", triple_source)])
    match statement(triples, triples.functions[0], 0):
        ReturnStatement(value):
            match form(triples, value):
                Constant(constant):
                    match triples.values[i64(constant)]:
                        Text(text): assert(text == "alpha\n  beta")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(triples, triples.functions[1], 0):
        ReturnStatement(value):
            match form(triples, value):
                Constant(constant):
                    match triples.values[i64(constant)]:
                        Bytes(payload): assert(len(payload) == 2 and payload[0] == u8(65) and payload[1] == u8(0))
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "func text() -> str:\n    return \"\"\"\n  too shallow\n        \"\"\"\n")],
        "main.luc:2:12: triple-quoted string line is indented less than its closing delimiter",
    )

pub func test_integer_construction_is_one_checked_conversion_node():
    let source = "func widen(value: u8) -> u64: return u64(value)\nfunc narrow(value: u16) -> u8: return u8(value)\n"
    let program = checked([source_module("main", source)])
    for function in program.functions:
        match statement(program, function, 0):
            ReturnStatement(value):
                match form(program, value):
                    NumericConvert(operand):
                        assert(is_integer_type(program.types, node_type(program, operand)))
                        assert(types_match(node_type(program, value), function.result))
                    else: assert(false)
            else: assert(false)
    assert(semantic_failure([source_module("main", "func bad(value: bool) -> u8: return u8(value)\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad(value: u8) -> u16: return u16(label = value)\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad() -> u8: return u8()\n")]) != "")
    expect_failure(
        [source_module("main", "func bad() -> u8: return u8(300u16)\n")],
        "main.luc:1:29: constant 300 is outside `u8` range",
    )

pub func test_floating_construction_is_typed_rounded_and_checked():
    let source = "func narrow(value: f64) -> f32: return f32(value)\nfunc half(value: f64) -> f16: return f16(value)\nfunc widen(value: f16) -> f64: return f64(value)\nfunc from_integer(value: u64) -> f16: return f16(value)\nfunc to_integer(value: f16) -> i32: return i32(value)\nfunc contextual32() -> f32: return 0.1\nfunc contextual16() -> f16: return 0.1\n"
    let program = checked([source_module("main", source)])
    for index in range(0, 5):
        match statement(program, program.functions[index], 0):
            ReturnStatement(value):
                match form(program, value):
                    NumericConvert(operand):
                        assert(is_numeric_type(program.types, node_type(program, operand)))
                        assert(types_match(node_type(program, value), program.functions[index].result))
                    else: assert(false)
            else: assert(false)
    match statement(program, program.functions[5], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[constant]:
                        Floating(item): assert(item == f64(f32(0.1)))
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[6], 0):
        ReturnStatement(value):
            match form(program, value):
                Constant(constant):
                    match program.values[constant]:
                        Floating(item): assert(item == 0.0999755859375)
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func bad(value: bool) -> f32: return f32(value)\n")],
        "main.luc:1:42: cannot convert `bool` to `f32`",
    )
    assert(semantic_failure([source_module("main", "func bad() -> f32: return f32(3.5e38)\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad() -> f16: return f16(65520.0)\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad() -> i8: return i8(128.0)\n")]) != "")

pub func test_discard_is_explicit_unit_hir_and_cannot_hide_failure():
    let source = "func consume():\n    discard(42)\n    discard(\"left\" + \"right\")\n"
    let program = checked([source_module("main", source)])
    assert(i64(function_body(program.functions[0]).count) == 2)
    for position in range(0, 2):
        match statement(program, program.functions[0], position):
            ExpressionStatement(value):
                match form(program, value):
                    Discard(discarded):
                        assert(describe_type(program.types, node_type(program, value)) == "unit")
                    else: assert(false)
            else: assert(false)

    expect_failure(
        [source_module("main", "func bad(): discard()\n")],
        "main.luc:1:13: `discard` takes exactly one positional value",
    )
    expect_failure(
        [source_module("main", "func bad(): discard(value = 1)\n")],
        "main.luc:1:21: `discard` uses one positional value",
    )
    expect_failure(
        [source_module("main", "func bad(): discard[i64](1)\n")],
        "main.luc:1:13: `discard` infers its value type and takes no type arguments",
    )
    for reserved in ["assert", "discard", "error", "hash", "trap", "i64", "f16", "map", "Error"]:
        expect_failure(
            [source_module("main", "func " + reserved + "(): return\n")],
            "main.luc:1:1: `" + reserved + "` belongs to the compiler-known core namespace",
        )
    expect_failure(
        [source_module("main", "func bad(discard: i64): return\n")],
        "main.luc:1:1: `discard` belongs to the compiler-known core namespace",
    )
    expect_failure(
        [source_module("support", "func work(): return\n"), source_module("main", "import support as discard\n")],
        "main.luc:1:1: `discard` belongs to the compiler-known core namespace",
    )
    let fallible = "pub let invalid: ErrorCode = ErrorCode.package(1)\nfunc checked() -> i64!: error(invalid, \"no\")\nfunc bad(): discard(checked())\n"
    expect_failure(
        [source_module("main", fallible)],
        "main.luc:3:21: a fallible value must be handled with `try` or `catch` before it can be discarded",
    )
    let terminating = "pub let invalid: ErrorCode = ErrorCode.package(1)\nfunc stop() -> i64!:\n    discard(error(invalid, \"stop\"))\n"
    assert(len(checked([source_module("main", terminating)]).functions) == 1)

pub func test_strings_resolve_scalar_length_iteration_concatenation_and_ordering():
    let source = "func size(value: str) -> u64: return value.length()\nfunc joined(left: str, right: str) -> str: return left + right\nfunc ordered(left: str, right: str) -> bool: return left < right\nfunc visit(value: str):\n    for character in value:\n        if character == 'λ': continue\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                StringScalarCount(inner): assert(describe_type(program.types, node_type(program, value)) == "u64")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    match operation:
                        Add(operand_type): assert(describe_type(program.types, operand_type) == "str")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        ForStatement(symbol, iteration, body):
            assert(describe_type(program.types, program.symbols[symbol.value].value_type) == "char")
            match iteration:
                Builtin(iterable): assert(describe_type(program.types, node_type(program, iterable)) == "str")
                Protocol(iterator_symbol, iterator, next): assert(false)
        else: assert(false)
    assert(semantic_failure([source_module("main", "func bad(value: str) -> u64: return value.length(1)\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad(value: str) -> u64: return value.unknown()\n")]) != "")
    assert(semantic_failure([source_module("main", "func bad(value: str) -> char: return value[0u64]\n")]) != "")

pub func test_bytes_length_and_index_are_typed_core_sequence_operations():
    let source = "func size(value: bytes) -> u64: return value.length\nfunc byte_at(value: bytes, at: u64) -> u8: return value[at]\nfunc text_bytes(value: str) -> u64: return value.byte_count\nfunc joined(left: bytes, right: bytes) -> bytes: return left + right\nfunc ordered(left: bytes, right: bytes) -> bool: return left < right\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceLength(inner): assert(types_match(program.node_types[value.value], resolve_builtin_type(BuiltinType.unsigned_u64)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceIndex(inner, index):
                    assert(types_match(program.node_types[value.value], resolve_builtin_type(BuiltinType.unsigned_u8)))
                    assert(types_match(program.node_types[index.value], resolve_builtin_type(BuiltinType.unsigned_u64)))
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[2], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceLength(inner): pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[3], 0):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    match operation:
                        Add(operand_type): assert(describe_type(program.types, operand_type) == "bytes")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[4], 0):
        ReturnStatement(value):
            match form(program, value):
                Binary(left, operation, right):
                    match operation:
                        Less(operand_type): assert(describe_type(program.types, operand_type) == "bytes")
                        else: assert(false)
                else: assert(false)
        else: assert(false)

    assert(semantic_failure([source_module("main", "func invalid(value: str) -> char: return value[0u64]\n")]) != "")
    assert(semantic_failure([source_module("main", "func invalid(value: bytes, at: i64) -> u8: return value[at]\n")]) != "")

pub func test_fixed_arrays_have_canonical_types_literals_and_resolved_places():
    let source = "type Row = array[u8, 2]\nstruct Grid:\n    var rows: array[Row, 2]\nfunc first(value: Row) -> u8: return value[0u64]\nfunc width(value: Row) -> u64: return value.length\nfunc update() -> u8:\n    var grid = Grid(rows = [[1, 2], [3, 4]])\n    grid.rows[1u64][0u64] += 5\n    return grid.rows[1u64][0u64]\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].parameters[0].value_type) == "array[u8, 2]")
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceIndex(inner, index): assert(describe_type(program.types, node_type(program, value)) == "u8")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[1], 0):
        ReturnStatement(value):
            match form(program, value):
                SequenceLength(inner): assert(describe_type(program.types, node_type(program, value)) == "u64")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[2], 1):
        PlaceAssignment(symbol, steps, operation, value):
            assert(steps.count == 6)
            assert(u32(entry_at(program, steps, 0)) == place_field_step)
            assert(u32(entry_at(program, steps, 2)) == place_element_step)
            assert(u32(entry_at(program, steps, 4)) == place_element_step)
            match operation:
                Combine(binary): pass
                else: assert(false)
        else: assert(false)

    expect_failure([source_module("main", "func f() -> array[u8, 2]: return [1]\n")], "main.luc:1:34: fixed-array literal has 1 element(s), expected `array[u8, 2]`")
    expect_failure([source_module("main", "func f() -> array[u8, 2]: return [1, 300]\n")], "main.luc:1:38: integer literal is outside `u8` range")
    expect_failure([source_module("main", "func f() -> u8:\n    let values: array[u8, 1] = [1]\n    values[0u64] = 2\n    return values[0u64]\n")], "main.luc:3:5: cannot assign through immutable binding `values`; declare it with `var`")
    expect_failure([source_module("main", "type Bad = array[u8]\n")], "main.luc:1:12: `array` needs an element type followed by a nonnegative integer length")
    let mutating_source = "struct Cell:\n    var value: i64\n    mutating func bump(self): self.value += 1\nfunc f() -> i64:\n    var cells: array[Cell, 1] = [Cell(value = 1)]\n    cells[0u64].bump()\n    return cells[0u64].value\n"
    assert(len(checked([source_module("main", mutating_source)]).functions) == 2)
    let immutable = "struct Cell:\n    var value: i64\n    mutating func bump(self): self.value += 1\nfunc f():\n    let cells: array[Cell, 1] = [Cell(value = 1)]\n    cells[0u64].bump()\n"
    expect_failure([source_module("main", immutable)], "main.luc:6:5: mutating method needs a `var` receiver; `cells` is immutable")

pub func test_fixed_array_slicing_produces_an_immutable_owned_snapshot():
    let source = "func middle(values: array[i64, 4], lower: u64, upper: u64) -> slice[i64]: return values[lower..<upper]\n"
    let program = checked([source_module("main", source)])
    match statement(program, program.functions[0], 0):
        ReturnStatement(value):
            assert(describe_type(program.types, node_type(program, value)) == "slice[i64]")
            match form(program, value):
                SequenceSlice(receiver, start, end):
                    assert(describe_type(program.types, node_type(program, receiver)) == "array[i64, 4]")
                    assert(start.value != no_node and end.value != no_node)
                else: assert(false)
        else: assert(false)

    expect_failure(
        [source_module("main", "func bad(values: array[i64, 1]) -> slice[u8]: return values[0u64..<]\n")],
        "main.luc:1:54: expected `slice[u8]`, found `slice[i64]`",
    )

pub func test_value_data_exposes_neither_implicit_views_nor_internal_projections():
    expect_failure(
        [source_module("main", "struct Buffer[N]:\n    let values: array[u8, N]\n")],
        "main.luc:2:17: `array` needs an element type followed by a nonnegative integer length",
    )
    expect_failure(
        [source_module("main", "func bad(value: array[i64, 2]) -> slice[i64]: return value\n")],
        "main.luc:1:54: expected `slice[i64]`, found `array[i64, 2]`",
    )
    expect_failure(
        [source_module("main", "func bad(value: (i64, i64)) -> i64: return value.first\n")],
        "main.luc:1:44: `(i64, i64)` has no field `first`",
    )
    let choice = "enum Choice:\n    empty\n    one(value: i64)\n"
    expect_failure(
        [source_module("main", choice + "func bad(value: Choice) -> i64: return value.tag\n")],
        "main.luc:4:40: `Choice` has no field `tag`",
    )
    expect_failure(
        [source_module("main", choice + "func bad(value: Choice) -> i64: return value.value\n")],
        "main.luc:4:40: `Choice` has no field `value`",
    )

pub func test_lists_have_reference_identity_and_structural_element_operations():
    let source = "struct Holder:\n    let values: list[i64]\nfunc answer() -> i64:\n    let values: list[i64] = [1]\n    let alias = values\n    alias.append(1)\n    alias.insert(1u64, 2)\n    let removed = alias.remove_at(0u64)\n    alias.reserve(16u64)\n    alias.clear()\n    let copied = alias.copy()\n    let holder = Holder(values = values)\n    holder.values.append(42)\n    return removed\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.structs[0].fields[0].value_type) == "list[i64]")
    match statement(program, program.functions[0], 0):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                List(elements): assert(elements.count == 1)
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 2):
        ExpressionStatement(value):
            match form(program, value):
                ListAppend(receiver, element): assert(describe_type(program.types, node_type(program, receiver)) == "list[i64]")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 3):
        ExpressionStatement(value):
            match form(program, value):
                ListInsert(receiver, index, element): assert(describe_type(program.types, node_type(program, index)) == "u64")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 4):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ListRemoveAt(receiver, index): assert(describe_type(program.types, node_type(program, value)) == "i64")
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 5):
        ExpressionStatement(value):
            match form(program, value):
                ListReserve(receiver, minimum_capacity): pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 6):
        ExpressionStatement(value):
            match form(program, value):
                ListClear(receiver): pass
                else: assert(false)
        else: assert(false)
    match statement(program, program.functions[0], 7):
        Binding(symbol, is_mutable, value):
            match form(program, value):
                ListCopy(receiver): assert(describe_type(program.types, node_type(program, value)) == "list[i64]")
                else: assert(false)
        else: assert(false)

    expect_failure([source_module("main", "func f(): let values = []\n")], "main.luc:1:24: an empty list literal needs a `list[T]` context")
    expect_failure([source_module("main", "func f(): let values = list[i64](1)\n")], "main.luc:1:24: `list[T]()` takes no arguments")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.append(true)\n")], "main.luc:3:19: expected `i64`, found `bool`")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.insert(0u64, true)\n")], "main.luc:3:25: expected `i64`, found `bool`")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.insert(0i64, 1)\n")], "main.luc:3:19: expected `u64`, found `i64`")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.remove_at(index = 0u64)\n")], "main.luc:3:22: `list.remove_at` uses positional arguments")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.clear(1)\n")], "main.luc:3:5: `list.clear` takes no arguments")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    let copied = values.copy(1)\n")], "main.luc:3:18: `list.copy` takes no arguments")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = []\n    values.reserve(-1)\n")], "main.luc:3:20: `-` is invalid for `u64`")
    expect_failure([source_module("main", "func f(): let values = [1, true]\n")], "main.luc:1:28: expected `i64`, found `bool`")
    let identity = checked([source_module("main", "func same(left: list[i64], right: list[i64]) -> bool: return left is right\nfunc different(left: list[i64], right: list[i64]) -> bool: return left is not right\n")])
    match statement(identity, identity.functions[0], 0):
        ReturnStatement(value):
            match form(identity, value):
                Binary(left, operation, right):
                    match operation:
                        Identity(operand_type): assert(describe_type(identity.types, operand_type) == "list[i64]")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    match statement(identity, identity.functions[1], 0):
        ReturnStatement(value):
            match form(identity, value):
                Binary(left, operation, right):
                    match operation:
                        NotIdentity(operand_type): assert(describe_type(identity.types, operand_type) == "list[i64]")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    let concatenation = checked([source_module("main", "func joined(left: list[i64], right: list[i64]) -> list[i64]: return left + right\n")])
    match statement(concatenation, concatenation.functions[0], 0):
        ReturnStatement(value):
            match form(concatenation, value):
                Binary(left, operation, right):
                    match operation:
                        Add(operand_type): assert(describe_type(concatenation.types, operand_type) == "list[i64]")
                        else: assert(false)
                else: assert(false)
        else: assert(false)
    expect_failure(
        [source_module("main", "func f(left: list[i64], right: list[i64]) -> list[i64]:\n    return left - right\n")],
        "main.luc:2:12: `-` requires numeric operands",
    )
    expect_failure(
        [source_module("main", "func f(left: list[i64], right: list[u8]) -> list[i64]:\n    return left + right\n")],
        "main.luc:2:19: expected `list[i64]`, found `list[u8]`",
    )
    expect_failure([source_module("main", "func f() -> bool: return 1 is 1\n")], "main.luc:1:26: `is` requires shared reference operands, found `i64`")
    expect_failure([source_module("main", "func f(values: list[i64]) -> bool:\n    let view = values[0u64..]\n    return view is view\n")], "main.luc:3:12: `is` requires shared reference operands, found `slice[i64]`")

    let mutating_element = "struct Cell:\n    var value: i64\n    mutating func bump(self): self.value += 1\nstruct Holder:\n    let cells: list[Cell]\nfunc f() -> i64:\n    let holder = Holder(cells = [Cell(value = 1)])\n    holder.cells[0u64].bump()\n    return holder.cells[0u64].value\n"
    assert(len(checked([source_module("main", mutating_element)]).functions) == 2)

    let slicing = checked([source_module("main", "func answer() -> i64:\n    let values: list[i64] = [1, 2]\n    let view: slice[i64] = values[..<values.length]\n    return view[0u64]\n")])
    match statement(slicing, slicing.functions[0], 1):
        Binding(symbol, is_mutable, value):
            assert(describe_type(slicing.types, node_type(slicing, value)) == "slice[i64]")
            match form(slicing, value):
                SequenceSlice(receiver, start, end):
                    assert(start.value == no_node)
                    assert(end.value != no_node)
                else: assert(false)
        else: assert(false)
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = [1]\n    let view = values[0i64..<1u64]\n")], "main.luc:3:23: expected `u64`, found `i64`")
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = [1]\n    let view = values[0u64..<1i64]\n")], "main.luc:3:30: expected `u64`, found `i64`")
    let byte_slicing = checked([source_module("main", "func f() -> u8:\n    let data = b\"abc\"\n    let view: slice[u8] = data[1u64..<]\n    return view[0u64]\n")])
    match statement(byte_slicing, byte_slicing.functions[0], 1):
        Binding(symbol, is_mutable, value):
            assert(describe_type(byte_slicing.types, node_type(byte_slicing, value)) == "slice[u8]")
            match form(byte_slicing, value):
                SequenceSlice(receiver, start, end):
                    assert(start.value != no_node)
                    assert(end.value == no_node)
                else: assert(false)
        else: assert(false)
    expect_failure([source_module("main", "func f():\n    let values: list[i64] = [1]\n    let view = values[..<1u64]\n    view[0u64] = 2\n")], "main.luc:4:5: `slice[i64]` does not support mutable indexing")

# mark: Aliases, constants, tuples, and optionals ===========================================

pub func test_type_aliases_and_constants_are_module_names():
    let source = "type Count = i64\nlet answer: Count = 42\nfunc value() -> Count: return answer\n"
    let program = checked([source_module("main", source)])
    assert(len(program.constants) == 1)
    assert(program.constants[0].name == "answer")
    assert(describe_type(program.types, program.functions[0].result) == "i64")
    expect_failure([source_module("main", "type Count = Count\nfunc value() -> Count: return 1\n")], "main.luc:1:1: type alias `Count` is recursive")
    expect_failure([source_module("main", "let a = b\nlet b = 1\nfunc value() -> i64: return a\n")], "")
    let forward = checked([source_module("main", "let a = b\nlet b = 1\nfunc value() -> i64: return a\n")])
    assert(forward.constants[0].name == "a")
    expect_failure([source_module("main", "let a = a\nfunc value() -> i64: return a\n")], "main.luc:1:1: constant `a` is recursive")
    let imported = [
        source_module("lib", "pub func value() -> i64: return 7\n"),
        source_module("main", "import lib\nlet a = lib.value()\nfunc use() -> i64: return a\n"),
    ]
    assert(semantic_failure(imported) != "")
    expect_failure(
        [source_module("main", "func answer() -> i64: return 42\nlet callback: func() -> i64 = answer\n")],
        "main.luc:2:31: initializer of constant `callback` must be a constant expression",
    )
    expect_failure(
        [source_module("main", "func identity[T](value: T) -> T: return value\nlet callback: func(i64) -> i64 = identity\n")],
        "main.luc:2:34: initializer of constant `callback` must be a constant expression",
    )
    expect_failure(
        [source_module("main", "let values: list[i64] = [1, 2]\n")],
        "main.luc:1:25: initializer of constant `values` must be a constant expression",
    )

pub func test_aliases_are_order_independent_transparent_and_visible_only_when_public():
    let ordered = "func identity(value: First) -> Second: return value\ninterface Reads:\n    func read(self) -> First\nstruct Box implements Reads:\n    let value: Second\n    pub func read(self) -> First: return self.value\ntype First = Second\ntype Second = i64\n"
    let program = checked([source_module("main", ordered)])
    assert(describe_type(program.types, program.functions[0].parameters[0].value_type) == "i64")
    assert(types_match(program.functions[0].parameters[0].value_type, program.functions[0].result))

    let model = "pub type Count = i64\ntype Hidden = i64\npub let answer: Count = 42\n"
    let client = "import model\nfunc read(value: model.Count) -> model.Count: return value\n"
    let imported = checked([source_module("main", client), source_module("model", model)])
    assert(describe_type(imported.types, imported.functions[0].parameters[0].value_type) == "i64")
    assert(types_match(imported.functions[0].parameters[0].value_type, node_type(imported, imported.constants[0].value)))

    expect_failure(
        [source_module("main", "import model\nfunc read(value: model.Hidden) -> i64: return value\n"), source_module("model", model)],
        "main.luc:2:18: `Hidden` is private to module `model`",
    )
    expect_failure(
        [source_module("main", "type Left = Right\ntype Right = Left\n")],
        "main.luc:1:1: type alias `Left` is recursive",
    )

pub func test_public_constants_require_an_explicit_api_type():
    expect_failure(
        [source_module("main", "pub let answer = 42\n")],
        "main.luc:1:1: public constant `answer` requires an explicit type",
    )
    let private_inference = checked([source_module("main", "let answer = 42\nfunc read() -> i64: return answer\n")])
    assert(describe_type(private_inference.types, node_type(private_inference, private_inference.constants[0].value)) == "i64")

pub func test_tuples_and_optional_else_are_typed():
    let source = "func pair() -> (i64, bool): return (1, true)\nfunc split() -> i64:\n    let (left, right) = pair()\n    return left\nfunc pick(flag: bool) -> i64:\n    var value: i64? = none\n    if flag: value = 3\n    return value else 0\n"
    let program = checked([source_module("main", source)])
    assert(describe_type(program.types, program.functions[0].result) == "(i64, bool)")
    assert(i64(function_body(program.functions[1]).count) == 4)

pub func test_tuple_bindings_point_diagnostics_at_the_offending_name():
    let duplicate = "func value() -> i64:\n    let (x, x) = (1, 2)\n    return x\n"
    expect_failure([source_module("main", duplicate)], "main.luc:2:13: `x` is already bound in this scope")
    let arity = "func value() -> i64:\n    let (a, b, c) = (1, 2)\n    return a\n"
    expect_failure([source_module("main", arity)], "main.luc:2:5: tuple binding has 3 name(s), value has 2")
    let not_tuple = "func value() -> i64:\n    let (a, b) = 1\n    return a\n"
    expect_failure([source_module("main", not_tuple)], "main.luc:2:5: tuple binding requires a tuple value, found `i64`")

pub func test_locals_cannot_shadow_imports():
    let sources = [
        source_module("lib", "pub func value() -> i64: return 1\n"),
        source_module("main", "from lib import value\nfunc use() -> i64:\n    let value = 2\n    return value\n"),
    ]
    expect_failure(sources, "main.luc:3:9: local `value` cannot shadow an imported name")

# mark: Remaining unimplemented forms =======================================================

pub func test_unimplemented_declarations_fail_by_name():
    expect_failure([source_module("main", "test \"ok\":\n    return\n")], "main.luc:1:1: test declarations are not implemented yet")

pub func test_unimplemented_statements_and_expressions_fail_by_name():
    expect_failure([source_module("main", "func walk():\n    for item in 1: return\n")], "main.luc:2:5: `for` needs a value conforming to `Iterable[T]`, found `i64`")
    expect_failure([source_module("main", "func walk():\n    try for item in 0..<1: return\n")], "main.luc:2:5: `try for` needs a value conforming to `FallibleIterable[T]`, found `range[i64]`")
    expect_failure([source_module("main", "func work():\n    recover none\n")], "main.luc:2:5: `recover` is only valid inside a `catch` handler")
    expect_failure([source_module("main", "func value() -> i64: return [1, 2]\n")], "main.luc:1:29: expected `i64`, found `list[i64]`")
    expect_failure([source_module("main", "func value() -> i64: return item.field\n")], "main.luc:1:29: unknown name `item`")

pub func test_range_bounds_and_iteration_bindings_are_checked():
    expect_failure([source_module("main", "func f(): let r = 0u8..<3u16\n")], "main.luc:1:25: expected `u8`, found `u16`")
    expect_failure([source_module("main", "func f(): let r = 0.0..<3.0\n")], "main.luc:1:19: range bounds need integers, found `f64`")
    expect_failure([source_module("main", "func f() -> i64:\n    for value in 0..<2:\n        if value == 0: continue\n    return value\n")], "main.luc:4:12: unknown name `value`")

# mark: Formatted strings =====================================================================

pub func test_formatted_strings_are_canonical_hir_with_closed_display_dispatch():
    let source = "struct Label implements Display:\n    let value: str\n    pub func display(self) -> str: return self.value\nfunc generic[T: Display](value: T) -> str: return f\"<{value}>\"\nfunc dynamic(value: Display) -> str: return f\"[{value}]\"\npub func answer() -> str:\n    let label = Label(\"luce\")\n    return f\"n={42}, ok={true}, c={'λ'}, x={1.5}, {generic(label)}, {dynamic(label)}, {{done}}\"\n"
    let program = checked([source_module("main", source)])
    var saw_display = false
    for item in program.interfaces:
        match item.origin:
            Standard(identity):
                if identity == StandardInterface.display:
                    saw_display = true
                    assert(item.name == "Display")
                    assert(len(item.requirements) == 1)
                    assert(item.requirements[0].name == "display")
                    assert(describe_type(program.types, item.requirements[0].result) == "str")
            Source(module): pass
    assert(saw_display)

    var saw_builtin = false
    var saw_formatted = false
    var saw_dynamic_call = false
    for node in program.nodes:
        match node.form:
            BuiltinDisplay(value): saw_builtin = true
            FormattedString(parts): saw_formatted = true
            InterfaceCall(receiver, interface_type, requirement, arguments): saw_dynamic_call = true
            else: pass
    assert(saw_builtin and saw_formatted and saw_dynamic_call)
    assert(len(program.conformances) >= 1)

    expect_failure(
        [source_module("main", "struct Hidden:\n    let value: i64\nfunc bad(value: Hidden) -> str: return f\"{value}\"\n")],
        "main.luc:3:42: formatted string field of type `Hidden` does not conform to `Display`",
    )
    expect_failure(
        [source_module("main", "interface Display:\n    func display(self) -> str\n")],
        "main.luc:1:1: `Display` belongs to the compiler-known core namespace",
    )
