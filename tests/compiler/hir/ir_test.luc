#==============================================================================================
#
#   hir_test - Semantic identities and tables
#
#   DESCRIPTION:
#       Direct HIR tests establish the representation contract independently of
#       parsing and checking: built-in types have canonical identities and
#       structural forms, and diagnostic names do not drive semantics.
#
#==============================================================================================

from luce.compiler.frontend.source import SourceSpan
from luce.compiler.hir.ir import BuiltinType, HirNode, HirNodeForm, ModuleId, PackageRole, TypeForm, TypeId, Value
from luce.compiler.hir.ir import create_builtin_type_table, create_empty_hir_program, create_hir_body_arena
from luce.compiler.hir.ir import describe_type, is_floating_type, is_integer_type
from luce.compiler.hir.ir import is_numeric_type, resolve_builtin_type, root_package, type_forms_match, types_match

pub func test_hir_body_arenas_own_every_flat_table_independently():
    let first = create_hir_body_arena()
    let second = create_hir_body_arena()

    first.nodes.append(HirNode(form = HirNodeForm.Constant(value = 0)))
    first.node_types.append(TypeId(value = 1))
    first.node_modules.append(ModuleId(value = 2))
    first.node_spans.append(SourceSpan(start = 3, end = 4, line = 5, column = 6))
    first.extra.append(7)
    first.values.append(Value.Boolean(value = true))

    assert(len(first.nodes) == 1)
    assert(len(first.node_types) == 1)
    assert(len(first.node_modules) == 1)
    assert(len(first.node_spans) == 1)
    assert(len(first.extra) == 1)
    assert(len(first.values) == 1)
    assert(len(second.nodes) == 0)
    assert(len(second.node_types) == 0)
    assert(len(second.node_modules) == 0)
    assert(len(second.node_spans) == 0)
    assert(len(second.extra) == 0)
    assert(len(second.values) == 0)

pub func test_empty_hir_has_one_explicit_root_package():
    let program = create_empty_hir_program()
    assert(len(program.packages) == 1)
    assert(program.root_package.value == 0)
    assert(root_package(program).id == program.root_package)
    assert(root_package(program).identity == "")
    assert(root_package(program).role == PackageRole.ordinary)

pub func test_builtin_types_have_canonical_identities_and_structural_forms():
    let types = create_builtin_type_table()
    let i32_type = resolve_builtin_type(BuiltinType.signed_i32)
    let i64_type = resolve_builtin_type(BuiltinType.signed_i64)
    let f64_type = resolve_builtin_type(BuiltinType.float64)
    let never_type = resolve_builtin_type(BuiltinType.never_type)
    let foreign_type = resolve_builtin_type(BuiltinType.foreign)

    assert(len(types.definitions) == 21)
    assert(not types_match(i32_type, i64_type))
    assert(is_integer_type(types, i32_type))
    assert(is_integer_type(types, i64_type))
    assert(is_floating_type(types, f64_type))
    assert(is_numeric_type(types, f64_type))
    assert(describe_type(types, i64_type) == "i64")
    assert(describe_type(types, never_type) == "never")
    assert(describe_type(types, foreign_type) == "foreign")

    match types.definitions[i64(i32_type.value)].form:
        Integer(bits, is_signed):
            assert(bits == 32)
            assert(is_signed)
        else: assert(false)
    match types.definitions[i64(resolve_builtin_type(BuiltinType.string_slice).value)].form:
        Slice(element): assert(types_match(element, resolve_builtin_type(BuiltinType.string)))
        else: assert(false)
    match types.definitions[i64(resolve_builtin_type(BuiltinType.error_code).value)].form:
        ErrorCode: pass
        else: assert(false)
    match types.definitions[i64(resolve_builtin_type(BuiltinType.error_value).value)].form:
        Error: pass
        else: assert(false)
    match types.definitions[i64(never_type.value)].form:
        Never: pass
        else: assert(false)
    match types.definitions[i64(foreign_type.value)].form:
        Foreign: pass
        else: assert(false)

pub func test_type_names_are_diagnostics_not_semantic_identity():
    let types = create_builtin_type_table()
    let invalid = TypeId(value = 999)
    assert(not types_match(invalid, resolve_builtin_type(BuiltinType.signed_i64)))
    assert(describe_type(types, invalid) == "<invalid type 999>")

pub func test_structural_type_matching_checks_nominal_extern_identity():
    let i32_type = resolve_builtin_type(BuiltinType.signed_i32)
    let i64_type = resolve_builtin_type(BuiltinType.signed_i64)
    assert(type_forms_match(TypeForm.Tuple(elements = [i32_type, i64_type]), TypeForm.Tuple(elements = [i32_type, i64_type])))
    assert(not type_forms_match(TypeForm.Tuple(elements = [i32_type, i64_type]), TypeForm.Tuple(elements = [i32_type, i32_type])))
    assert(type_forms_match(TypeForm.Extern(index = 3), TypeForm.Extern(index = 3)))
    assert(not type_forms_match(TypeForm.Extern(index = 3), TypeForm.Extern(index = 4)))
    assert(type_forms_match(TypeForm.CFunction(parameters = [i32_type], result = i64_type), TypeForm.CFunction(parameters = [i32_type], result = i64_type)))
    assert(not type_forms_match(TypeForm.CFunction(parameters = [i32_type], result = i64_type), TypeForm.Function(parameters = [i32_type], result = i64_type)))
    assert(type_forms_match(TypeForm.Foreign, TypeForm.Foreign))
