pub func test_constant_only_anonymous_enumeration_becomes_typed_fiir_constants():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(constant_only_enumeration_ast(), "limits.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.constants) == 4 and len(module.functions) == 0)
    assert(module.constants[0].name == "LUCE_BELOW")
    assert(module.types[module.constants[0].value_type.value].spelling == "int")
    match module.constants[0].value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(2))
                else: trap("expected a negative anonymous-enum constant")
        else: trap("expected an integer anonymous-enum constant")
    match module.constants[1].value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(1))
                else: trap("expected the implicit anonymous-enum successor")
        else: trap("expected an integer anonymous-enum successor")
    assert(module.types[module.constants[2].value_type.value].spelling == "unsigned long long")
    match module.constants[3].value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(9223372036854775808))
                else: trap("expected the minimum signed anonymous-enum constant")
        else: trap("expected an integer anonymous-enum minimum")

    let products = render_binding_products(module, "limits") catch reason:
        trap(reason)
    assert(not strings.contains(products.raw_module, "pub struct limits"))
    assert(strings.contains(products.raw_module, "# mark: C constants"))
    assert(strings.contains(products.raw_module, "pub let LUCE_BELOW: c.integer_constant = c.integer_constant(true, 2u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_NEXT: c.integer_constant = c.integer_constant(true, 1u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_MAX: c.integer_constant = c.integer_constant(false, 18446744073709551615u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_MIN: c.integer_constant = c.integer_constant(true, 9223372036854775808u64)"))
    assert(strings.contains(products.c_adapter, "_Static_assert(_Generic((LUCE_BELOW), int: 1, default: 0), \"FIIR C constant LUCE_BELOW type changed\")"))
    assert(strings.contains(products.c_adapter, "_Static_assert(LUCE_BELOW == -INT64_C(2), \"FIIR C constant LUCE_BELOW value changed\")"))
    assert(strings.contains(products.c_adapter, "_Static_assert(LUCE_MAX == UINT64_C(18446744073709551615), \"FIIR C constant LUCE_MAX value changed\")"))
    assert(strings.contains(products.c_adapter, "_Static_assert(LUCE_MIN == INT64_MIN, \"FIIR C constant LUCE_MIN value changed\")"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"constants\": ["))
    assert(strings.contains(encoded, "\"name\": \"LUCE_MAX\""))
    assert(strings.contains(encoded, "\"value\": \"18446744073709551615\""))

pub func test_integer_constant_validation_rejects_values_outside_their_declared_c_type():
