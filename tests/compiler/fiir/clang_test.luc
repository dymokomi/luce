pub func test_typedef_target_family_and_width_change_fiir_and_c_but_not_generated_luce():
    let wide = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let narrow = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let wide_module = decode_clang_ast(typedef_ast(), "aliases.h", "wide-target", list[str](), wide) catch reason:
        trap(reason)
    let narrow_ast = strings.replace(typedef_ast(), "unsigned long", "unsigned int")
    let narrow_module = decode_clang_ast(narrow_ast, "aliases.h", "narrow-target", list[str](), narrow) catch reason:
        trap(reason)
    let wide_products = render_binding_products(wide_module, "aliases") catch reason:
        trap(reason)
    let narrow_products = render_binding_products(narrow_module, "aliases") catch reason:
        trap(reason)
    assert(wide_products.raw_module != narrow_products.raw_module)
    let normalized_wide = strings.replace(wide_products.raw_module, "wide-target", "one-target")
    let normalized_narrow = strings.replace(narrow_products.raw_module, "narrow-target", "one-target")
    assert(normalized_wide == normalized_narrow)
    assert(wide_products.c_adapter != narrow_products.c_adapter)
    assert(strings.contains(narrow_products.c_adapter, "value > UINT64_C(4294967295)"))

# mark: Enumeration declarations ===============================================================

pub func test_c_enumerations_keep_declared_values_and_use_one_target_neutral_carrier():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(enumeration_ast(), "colors.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.types) == 2 and len(module.constants) == 0 and len(module.functions) == 2)
    match module.types[0].form:
        Enumeration(name, c_spelling, cases, origin):
            assert(name == "Color" and (c_spelling else "") == "enum Color" and len(cases) == 5)
            match cases[0].value:
                Negative(magnitude): assert(magnitude == u64(2))
                else: trap("expected a negative C enum value")
            match cases[3].value:
                Nonnegative(value): assert(value == u64(43))
                else: trap("expected the implicit C enum successor")
            match cases[4].value:
                Nonnegative(value): assert(value == u64(18446744073709551615))
                else: trap("expected the full unsigned C enum domain")
        else: trap("expected a C enumeration in FIIR")
    match module.types[1].form:
        Typedef(target, origin): assert(target.value == u32(0))
        else: trap("expected the C enum typedef identity")
    assert(fiir_products.boundary_is_enumeration(module, module.functions[0].parameters[0].boundary) catch false)
    assert(fiir_products.boundary_is_enumeration(module, module.functions[0].result) catch false)

    let products = render_binding_products(module, "colors") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub struct Color:"))
    assert(strings.contains(products.raw_module, "let is_negative: bool"))
    assert(strings.contains(products.raw_module, "pub let COLOR_RED: Color = Color(true, 2u64)"))
    assert(strings.contains(products.raw_module, "pub let COLOR_NEXT: Color = Color(false, 43u64)"))
    assert(strings.contains(products.raw_module, "pub let COLOR_MAX: Color = Color(false, 18446744073709551615u64)"))
    assert(strings.contains(products.raw_module, "extern func luce_fiir_colors_echo_color(value_is_negative: bool, value_magnitude: u64, out result_is_negative: bool, out result_magnitude: u64) -> i32"))
    assert(strings.contains(products.raw_module, "pub func echo_color(value: Color) -> Color:"))
    assert(strings.contains(products.raw_module, "native_enum_value: C function `echo_color` returned an undeclared enum value"))
    assert(strings.contains(products.raw_module, "native_adapter_status: C function `echo_color` adapter returned an unknown status"))
    assert(strings.contains(products.c_adapter, "Color luce_native_0;"))
    assert(strings.contains(products.c_adapter, "*result_is_negative = 0;\n    *result_magnitude = UINT64_C(0);"))
    assert(strings.contains(products.c_adapter, "if (value_is_negative && value_magnitude == UINT64_C(2)) luce_native_0 = COLOR_RED;"))
    assert(strings.contains(products.c_adapter, "Color luce_result = echo_color((Color)luce_native_0);"))
    assert(strings.contains(products.c_adapter, "enum Color luce_result = echo_tagged(luce_native_0);"))
    assert(strings.contains(products.c_adapter, "else return INT32_C(3);"))
    assert(not strings.contains(products.c_adapter, "luce_result == COLOR_ALIAS"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"kind\": \"enumeration\""))
    assert(strings.contains(encoded, "\"value\": \"-2\""))
    assert(strings.contains(encoded, "\"value\": \"43\""))

pub func test_c_tag_and_ordinary_name_collisions_fail_before_raw_source_generation():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let colliding = strings.replace(enumeration_ast(), "\"name\":\"COLOR_RED\"", "\"name\":\"Color\"")
    let module = decode_clang_ast(colliding, "colors.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    var rejected_raw_name = false
    discard(render_binding_products(module, "colors")) catch reason:
        assert(reason == "FIIR generation: raw declaration `Color` is required by C enum carrier `enum Color` and C enum constant `Color`")
        rejected_raw_name = true
    assert(rejected_raw_name)

    let colliding_symbol = strings.replace(enumeration_ast(), "\"name\":\"echo_tagged\"", "\"name\":\"luce_fiir_colors_echo_color\"")
    let symbol_module = decode_clang_ast(colliding_symbol, "colors.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    var rejected_adapter_symbol = false
    discard(render_binding_products(symbol_module, "colors")) catch reason:
        assert(reason == "FIIR generation: adapter symbol `luce_fiir_colors_echo_color` collides with C function `luce_fiir_colors_echo_color`")
        rejected_adapter_symbol = true
    assert(rejected_adapter_symbol)

pub func test_c_enumeration_values_reject_both_sides_of_the_supported_integer_domain():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let below_i64 = strings.replace(enumeration_ast(), "\"value\":\"-2\"", "\"value\":\"-9223372036854775809\"")
    var rejected_negative = false
    discard(decode_clang_ast(below_i64, "colors.h", "test-target", list[str](), facts)) catch reason:
        assert(strings.contains(reason, "value `-9223372036854775809` is outside the supported C integer domain"))
        rejected_negative = true
    assert(rejected_negative)

    let above_u64 = strings.replace(enumeration_ast(), "\"value\":\"18446744073709551615\"", "\"value\":\"18446744073709551616\"")
    var rejected_positive = false
    discard(decode_clang_ast(above_u64, "colors.h", "test-target", list[str](), facts)) catch reason:
        assert(strings.contains(reason, "value `18446744073709551616` is outside the supported C integer domain"))
        rejected_positive = true
    assert(rejected_positive)

