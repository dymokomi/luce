func macro_type_ast(first: str = "long long", second: str = "unsigned long long") -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"VarDecl\",\"name\":\"__luce_fiir_macro_constant_type_0\",\"type\":{\"qualType\":\"" + first + "\"}},"
        + "{\"kind\":\"VarDecl\",\"name\":\"__luce_fiir_macro_constant_type_1\",\"type\":{\"qualType\":\"" + second + "\"}}"
        + "]}"
    )

func macro_value_facts(first_constant: str = "1", first_word: str = "0") -> str:
    let values = [
        first_constant, first_word, "0", "0", "32768",
        "1", "65535", "65535", "65535", "65535",
    ]
    var output = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[{\"kind\":\"EnumDecl\",\"inner\":["
    var item = 0
    for index in range(0, 2):
        let suffixes = ["is_constant", "word_0", "word_1", "word_2", "word_3"]
        for suffix in suffixes:
            if item > 0: output += ","
            output += layout_constant_json("__luce_fiir_macro_constant_" + str(index) + "_" + suffix, values[item])
            item += 1
    return output + "]}]}"

