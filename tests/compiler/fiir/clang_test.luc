func enum_constant_json(name: str, line: i64, value: str) -> str:
    return (
        "{\"kind\":\"EnumConstantDecl\",\"loc\":{\"line\":" + str(line) + ",\"col\":5},\"name\":\"" + name + "\","
        + "\"type\":{\"qualType\":\"int\"},\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"" + value + "\"}]}"
    )

# mark: Target facts ===========================================================================

pub func test_clang_predefined_macros_supply_target_widths_without_host_assumptions():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    assert(facts.char_size_bits == u16(8))
    assert(facts.short_size_bits == u16(16))
    assert(facts.short_value_bits == u16(16))
    assert(facts.int_size_bits == u16(32))
    assert(facts.int_value_bits == u16(32))
    assert(facts.long_size_bits == u16(64))
    assert(facts.long_value_bits == u16(64))
    assert(facts.long_long_size_bits == u16(64))
    assert(facts.long_long_value_bits == u16(64))
    assert(facts.float_storage_bits == u16(32))
    assert(facts.double_storage_bits == u16(64))
    assert(facts.long_double_storage_bits == u16(128))
    assert(facts.long_double_significand_bits == u16(64))
    assert(facts.plain_char_is_signed)
    assert(facts.bool_size_bits == u16(8))

    discard(decode_clang_scalar_facts("#define __CHAR_BIT__ 8\n")) catch reason:
        assert(reason == "Clang target facts: missing `__SIZEOF_SHORT__`")
        return
    trap("expected incomplete Clang target facts to fail")

# mark: Value declarations =====================================================================

pub func test_clang_scalar_functions_decode_into_interned_validated_fiir():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "arm64-test-none", ["-std=c11"], facts) catch reason:
        trap(reason)

    assert(module.header == "temperature.h")
    assert(module.target == "arm64-test-none")
    assert(len(module.types) == 2)
    assert(len(module.functions) == 2)
    assert(module.functions[0].name == "luce_celsius_to_fahrenheit")
    assert(module.functions[0].origin.line == u32(8))
    assert(module.functions[0].parameters[0].origin.line == u32(8))
    assert(module.functions[0].parameters[0].origin.column == u32(42))
    assert(module.functions[0].result.value_type.value == module.functions[0].parameters[0].boundary.value_type.value)
    assert(module.functions[1].origin.path == "temperature.h")
    assert(module.functions[1].origin.line == u32(9))
    assert(module.functions[1].is_variadic)
    match module.types[0].form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            assert(kind == FiirCFloatingKind.double)
            assert(radix == u16(2))
            assert(significand_bits == u16(53))
            assert(maximum_exponent == i32(1024))
        else: trap("expected Clang double to remain a floating FIIR type")
    match module.types[1].form:
        Integer(kind, bits, is_signed):
            assert(kind == FiirCIntegerKind.signed_int)
            assert(bits == u16(32))
            assert(is_signed)
        else: trap("expected Clang int to remain a signed FIIR type")

pub func test_clang_decoder_ignores_included_declarations_and_rejects_unsupported_main_header_shapes():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let with_include = (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"dependency.h\",\"line\":1,\"col\":5},\"name\":\"dependency\",\"type\":{\"qualType\":\"int (int)\"}},"
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"main.h\",\"line\":3,\"col\":8},\"name\":\"answer\",\"type\":{\"qualType\":\"double (double)\"}}"
        + "]}"
    )
    let module = decode_clang_ast(with_include, "main.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.functions) == 1)
    assert(module.functions[0].name == "answer")

    let pointer_result = (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"main.h\",\"line\":1,\"col\":6},\"name\":\"allocate\",\"type\":{\"qualType\":\"void *(int)\"},\"inner\":["
        + "{\"kind\":\"ParmVarDecl\",\"loc\":{\"col\":19},\"name\":\"count\",\"type\":{\"qualType\":\"int\"}}]}"
        + "]}"
    )
    discard(decode_clang_ast(pointer_result, "main.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: function `allocate` has unsupported type spelling `void *(int)`")
        return
    trap("expected the value importer to reject a pointer result")

pub func test_fiir_validation_rejects_duplicate_foreign_declarations():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    var module = decode_clang_ast(two_function_ast(), "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.append(module.functions[0])
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: duplicate function declaration `luce_celsius_to_fahrenheit`")
        return
    trap("expected malformed FIIR to fail before generation")

pub func test_fiir_validation_rejects_noncanonical_typedef_edges():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(typedef_ast(), "aliases.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    match module.types[1].form:
        Typedef(target, origin):
            module.types[1] = FiirType(
                spelling = "luce_size",
                form = FiirTypeForm.Typedef(target = FiirTypeId(value = u32(1)), origin = origin),
                size_bits = u16(64),
            )
        else: trap("expected typedef fixture")
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: typedef `luce_size` target must precede it")
        return
    trap("expected a cyclic or forward typedef edge to fail validation")

pub func test_fiir_validation_rejects_target_layout_on_adapter_mediated_enums():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(enumeration_ast(), "colors.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    match module.types[0].form:
        Enumeration(name, c_spelling, cases, origin):
            module.types[0] = FiirType(
                spelling = module.types[0].spelling,
                form = FiirTypeForm.Enumeration(name = name, c_spelling = c_spelling, cases = cases, origin = origin),
                size_bits = u16(32),
            )
        else: trap("expected an enumeration fixture")
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: adapter-mediated C enum `Color` cannot carry target size")
        return
    trap("expected target enum layout to fail before source generation")

# mark: Generated products =====================================================================

pub func test_scalar_fiir_renders_auditable_json_and_raw_luce_source():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "arm64-test-none", ["-std=c11"], facts) catch reason:
        trap(reason)
    module.functions.remove(1)

    let products = render_binding_products(module, "temperature") catch reason:
        trap(reason)
    let raw = products.raw_module
    assert(strings.starts_with(raw, "## Generated by luce-fiir-1. Do not edit.\n"))
    assert(strings.contains(raw, "## C header: temperature.h\n"))
    assert(strings.contains(raw, "## Clang target: arm64-test-none\n"))
    assert(strings.contains(raw, "import c\n"))
    assert(strings.contains(raw, "extern func luce_fiir_temperature_luce_celsius_to_fahrenheit(celsius: f64) -> f64\n"))
    assert(strings.contains(raw, "pub func luce_celsius_to_fahrenheit(celsius: c.double) -> c.double:"))
    assert(strings.contains(raw, "return c.double(luce_fiir_temperature_luce_celsius_to_fahrenheit(celsius.raw))"))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_BIT * sizeof(double) == 64"))
    assert(strings.contains(products.c_adapter, "double luce_fiir_temperature_luce_celsius_to_fahrenheit(double celsius)"))
    assert(strings.contains(products.c_adapter, "return luce_celsius_to_fahrenheit(celsius);"))

    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    let repeated = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(encoded == repeated)
    let document = json.parse(encoded) catch malformed:
        trap(json.describe(malformed))
    let format = document.member("format") else json.Json.null
    let header = document.member("header") else json.Json.null
    let target = document.member("target") else json.Json.null
    let types = document.member("types") else json.Json.null
    let functions = document.member("functions") else json.Json.null
    assert((format.as_text() else "") == "luce-fiir-1")
    assert((header.as_text() else "") == "temperature.h")
    assert((target.as_text() else "") == "arm64-test-none")
    # FIIR is an auditable Clang fact product, so removing a declaration from
    # this test fixture does not rewrite the original interned type table.
    assert(types.count() == 2)
    assert(functions.count() == 1)

pub func test_raw_generation_refuses_variadics_until_a_typed_adapter_exists():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.remove(0)
    discard(render_binding_products(module, "temperature")) catch reason:
        assert(reason == "FIIR generation: variadic C function `adjust` requires a generated typed adapter")
        return
    trap("expected raw generation to refuse an unadapted variadic")

pub func test_target_sized_integers_use_nominal_carriers_and_checked_c_adapters():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let document = strings.replace(two_function_ast(), "int (int, ...)", "int (int)")
    let module = decode_clang_ast(document, "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.remove(0)
    let products = render_binding_products(module, "temperature") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "extern func luce_fiir_temperature_adjust(value: i64, out result: i64) -> i32"))
    assert(strings.contains(products.raw_module, "pub func adjust(value: c.int) -> c.int:"))
    assert(strings.contains(products.raw_module, "let (status, result) = luce_fiir_temperature_adjust(value.raw)"))
    assert(strings.contains(products.raw_module, "native_integer_range: C function `adjust` received an integer outside its target range"))
    assert(strings.contains(products.raw_module, "return c.int(result)"))
    assert(strings.contains(products.c_adapter, "_Static_assert(INT_MIN == -INT64_C(2147483648) && INT_MAX == INT64_C(2147483647)"))
    assert(strings.contains(products.c_adapter, "int32_t luce_fiir_temperature_adjust(int64_t value, int64_t *result)"))
    assert(strings.contains(products.c_adapter, "if (value < -INT64_C(2147483648) || value > INT64_C(2147483647)) return INT32_C(0);"))
    assert(strings.contains(products.c_adapter, "*result = (int64_t)(adjust((int)value));"))

pub func test_c_boolean_uses_one_nominal_target_independent_carrier():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(boolean_ast(), "boolean.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    match module.types[0].form:
        Boolean: pass
        else: trap("expected Clang _Bool to remain a Boolean FIIR type")
    let products = render_binding_products(module, "boolean") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "extern func luce_fiir_boolean_negate(value: bool) -> bool"))
    assert(strings.contains(products.raw_module, "pub func negate(value: c.boolean) -> c.boolean:"))
    assert(strings.contains(products.raw_module, "return c.boolean(luce_fiir_boolean_negate(value.raw))"))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_BIT * sizeof(_Bool) == 8"))
    assert(strings.contains(products.c_adapter, "_Bool luce_fiir_boolean_negate(_Bool value)"))
    assert(strings.contains(products.c_adapter, "return negate(value);"))

pub func test_c_boolean_target_size_changes_only_fiir_and_the_c_adapter():
    let facts_8 = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let facts_16 = decode_clang_scalar_facts(
        strings.replace(target_macros(), "#define __BOOL_WIDTH__ 8", "#define __BOOL_WIDTH__ 16"),
    ) catch reason:
        trap(reason)
    let module_8 = decode_clang_ast(boolean_ast(), "boolean.h", "same-target-name", list[str](), facts_8) catch reason:
        trap(reason)
    let module_16 = decode_clang_ast(boolean_ast(), "boolean.h", "same-target-name", list[str](), facts_16) catch reason:
        trap(reason)
    let products_8 = render_binding_products(module_8, "boolean") catch reason:
        trap(reason)
    let products_16 = render_binding_products(module_16, "boolean") catch reason:
        trap(reason)
    assert(products_8.raw_module == products_16.raw_module)
    assert(products_8.c_adapter != products_16.c_adapter)
    assert(strings.contains(products_8.c_adapter, "sizeof(_Bool) == 8"))
    assert(strings.contains(products_16.c_adapter, "sizeof(_Bool) == 16"))
    let fiir_8 = fiir_products.render_fiir_json(module_8) catch reason:
        trap(reason)
    let fiir_16 = fiir_products.render_fiir_json(module_16) catch reason:
        trap(reason)
    assert(fiir_8 != fiir_16)

pub func test_fundamental_c_floats_keep_distinct_nominal_identities():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(floating_family_ast(), "floats.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.types) == 2)
    match module.types[0].form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            assert(kind == FiirCFloatingKind.single)
        else: trap("expected C float to retain its fundamental identity")
    match module.types[1].form:
        Floating(kind, radix, significand_bits, maximum_exponent):
            assert(kind == FiirCFloatingKind.long_double)
        else: trap("expected C long double to retain its fundamental identity")

    module.functions.remove(1)
    let products = render_binding_products(module, "floats") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "extern func luce_fiir_floats_echo_float(value: f32) -> f32"))
    assert(strings.contains(products.raw_module, "pub func echo_float(value: c.float) -> c.float:"))
    assert(strings.contains(products.raw_module, "return c.float(luce_fiir_floats_echo_float(value.raw))"))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_BIT * sizeof(float) == 32"))
    assert(strings.contains(products.c_adapter, "FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128"))
    assert(strings.contains(products.c_adapter, "float luce_fiir_floats_echo_float(float value)"))

pub func test_long_double_uses_f64_only_when_fiir_proves_exact_binary64():
    let exact_macros = strings.replace(
        strings.replace(
            strings.replace(target_macros(), "#define __SIZEOF_LONG_DOUBLE__ 16", "#define __SIZEOF_LONG_DOUBLE__ 8"),
            "#define __LDBL_MANT_DIG__ 64",
            "#define __LDBL_MANT_DIG__ 53",
        ),
        "#define __LDBL_MAX_EXP__ 16384",
        "#define __LDBL_MAX_EXP__ 1024",
    )
    let exact_facts = decode_clang_scalar_facts(exact_macros) catch reason:
        trap(reason)
    let exact = decode_clang_ast(floating_family_ast(), "floats.h", "binary64-target", list[str](), exact_facts) catch reason:
        trap(reason)
    exact.functions.remove(0)
    let products = render_binding_products(exact, "floats") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "extern func luce_fiir_floats_echo_long_double(value: f64) -> f64"))
    assert(strings.contains(products.raw_module, "pub func echo_long_double(value: c.long_double) -> c.long_double:"))
    assert(strings.contains(products.c_adapter, "LDBL_MANT_DIG == 53 && LDBL_MAX_EXP == 1024"))
    assert(strings.contains(products.c_adapter, "double luce_fiir_floats_echo_long_double(double value)"))
    assert(strings.contains(products.c_adapter, "return (double)(echo_long_double((long double)value));"))

    let extended_facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let extended = decode_clang_ast(floating_family_ast(), "floats.h", "extended-target", list[str](), extended_facts) catch reason:
        trap(reason)
    extended.functions.remove(0)
    discard(render_binding_products(extended, "floats")) catch reason:
        assert(strings.contains(reason, "C type `long double` has no completed scalar adapter yet"))
        return
    trap("expected an extended long double to fail instead of narrowing to f64")

pub func test_scalar_typedefs_keep_names_and_resolve_nested_targets_once():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(typedef_ast(), "aliases.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.types) == 3)
    match module.types[1].form:
        Typedef(target, origin):
            assert(module.types[target.value].spelling == "unsigned long")
            assert(origin.line == u32(1))
        else: trap("expected the first C typedef identity")
    match module.types[2].form:
        Typedef(target, origin):
            assert(module.types[target.value].spelling == "luce_size")
            assert(origin.line == u32(2))
        else: trap("expected the nested C typedef identity")

    let products = render_binding_products(module, "aliases") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub struct luce_size:"))
    assert(strings.contains(products.raw_module, "pub struct luce_count:"))
    assert(strings.contains(products.raw_module, "pub let raw: u64"))
    assert(strings.contains(products.raw_module, "pub func echo_count(value: luce_count) -> luce_count:"))
    assert(strings.contains(products.c_adapter, "_Generic(((luce_size)0), unsigned long: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "_Generic(((luce_count)0), luce_size: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "echo_count((luce_count)value)"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"kind\": \"typedef\""))
    assert(strings.contains(encoded, "\"target\": 1"))
    assert(strings.contains(encoded, "\"path\": \"aliases.h\""))

pub func test_scalar_typedef_import_rejects_non_scalar_targets_and_luce_keywords_explicitly():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let pointer_alias = (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"TypedefDecl\",\"loc\":{\"file\":\"aliases.h\",\"line\":1,\"col\":14},"
        + "\"name\":\"handle\",\"type\":{\"qualType\":\"void *\"}}]}"
    )
    var pointer_failed = false
    discard(decode_clang_ast(pointer_alias, "aliases.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: typedef `handle` target type `void *` is not supported by the value-function importer yet")
        pointer_failed = true
    assert(pointer_failed)

    let keyword_alias = strings.replace(strings.replace(typedef_ast(), "luce_size", "type"), "luce_count", "count")
    let module = decode_clang_ast(keyword_alias, "aliases.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    discard(render_binding_products(module, "aliases")) catch reason:
        assert(reason == "FIIR generation: C typedef `type` needs a name-preserving adapter because it is reserved in Luce")
        return
    trap("expected a Luce keyword typedef to fail before source generation")

