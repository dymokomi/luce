#==============================================================================================
#
#   fiir.clang_test - Clang facts become validated backend-independent FIIR
#
#==============================================================================================

from luce.compiler.backends.clang_fiir import ClangFiirToolchain
from luce.compiler.fiir.binding import CBindingOutputs, CBindingRequest, bind_c
from luce.compiler.fiir.clang import ClangScalarFacts, decode_clang_ast, decode_clang_scalar_facts
import luce.compiler.fiir.generator as fiir_products
from luce.compiler.fiir.schema import FiirTypeForm, validate_fiir
import std.files
import std.json
import std.paths
import std.strings

# mark: Fixtures ===============================================================================

func target_macros() -> str:
    return (
        "#define __CHAR_BIT__ 8\n"
        + "#define __BOOL_WIDTH__ 8\n"
        + "#define __SHRT_WIDTH__ 16\n"
        + "#define __INT_WIDTH__ 32\n"
        + "#define __LONG_WIDTH__ 64\n"
        + "#define __LLONG_WIDTH__ 64\n"
        + "#define __SIZEOF_SHORT__ 2\n"
        + "#define __SIZEOF_INT__ 4\n"
        + "#define __SIZEOF_LONG__ 8\n"
        + "#define __SIZEOF_LONG_LONG__ 8\n"
        + "#define __SIZEOF_FLOAT__ 4\n"
        + "#define __SIZEOF_DOUBLE__ 8\n"
        + "#define __SIZEOF_LONG_DOUBLE__ 16\n"
        + "#define __FLT_RADIX__ 2\n"
        + "#define __FLT_MANT_DIG__ 24\n"
        + "#define __FLT_MAX_EXP__ 128\n"
        + "#define __DBL_MANT_DIG__ 53\n"
        + "#define __DBL_MAX_EXP__ 1024\n"
        + "#define __LDBL_MANT_DIG__ 64\n"
        + "#define __LDBL_MAX_EXP__ 16384\n"
    )

func two_function_ast() -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"TypedefDecl\",\"loc\":{},\"isImplicit\":true,\"name\":\"__builtin\"},"
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"temperature.h\",\"line\":8,\"col\":8},"
        + "\"name\":\"luce_celsius_to_fahrenheit\",\"type\":{\"qualType\":\"double (double)\"},\"inner\":["
        + "{\"kind\":\"ParmVarDecl\",\"loc\":{\"col\":42},\"name\":\"celsius\",\"type\":{\"qualType\":\"double\"}}]},"
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"line\":9,\"col\":5},"
        + "\"name\":\"adjust\",\"type\":{\"qualType\":\"int (int, ...)\"},\"inner\":["
        + "{\"kind\":\"ParmVarDecl\",\"loc\":{\"col\":16},\"name\":\"value\",\"type\":{\"qualType\":\"int\"}}]}"
        + "]}"
    )

# mark: Target facts ===========================================================================

pub func test_clang_predefined_macros_supply_target_widths_without_host_assumptions():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    assert(facts.char_size_bits == u16(8))
    assert(facts.short_size_bits == u16(16))
    assert(facts.short_value_bits == u16(16))
    assert(facts.int_size_bits == u16(32))
    assert(facts.int_value_bits == u16(32))
    assert(facts.long_size_bits == u16(64))
    assert(facts.long_value_bits == u16(64))
    assert(facts.long_long_size_bits == u16(64))
    assert(facts.long_long_value_bits == u16(64))
    assert(facts.float_storage_bits == u16(32))
    assert(facts.double_storage_bits == u16(64))
    assert(facts.long_double_storage_bits == u16(128))
    assert(facts.long_double_significand_bits == u16(64))
    assert(facts.plain_char_is_signed)
    assert(facts.bool_bits == u16(8))

    discard(decode_clang_scalar_facts("#define __CHAR_BIT__ 8\n")) catch reason:
        assert(reason == "Clang target facts: missing `__SIZEOF_SHORT__`")
        return
    trap("expected incomplete Clang target facts to fail")

# mark: Scalar declarations ====================================================================

pub func test_clang_scalar_functions_decode_into_interned_validated_fiir():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "arm64-test-none", ["-std=c11"], facts) catch reason:
        trap(reason)

    assert(module.header == "temperature.h")
    assert(module.target == "arm64-test-none")
    assert(len(module.types) == 2)
    assert(len(module.functions) == 2)
    assert(module.functions[0].name == "luce_celsius_to_fahrenheit")
    assert(module.functions[0].origin.line == u32(8))
    assert(module.functions[0].parameters[0].origin.line == u32(8))
    assert(module.functions[0].parameters[0].origin.column == u32(42))
    assert(module.functions[0].result.value_type.value == module.functions[0].parameters[0].boundary.value_type.value)
    assert(module.functions[1].origin.path == "temperature.h")
    assert(module.functions[1].origin.line == u32(9))
    assert(module.functions[1].is_variadic)
    match module.types[0].form:
        Floating(radix, significand_bits, maximum_exponent):
            assert(radix == u16(2))
            assert(significand_bits == u16(53))
            assert(maximum_exponent == i32(1024))
        else: trap("expected Clang double to remain a floating FIIR type")
    match module.types[1].form:
        Integer(bits, is_signed):
            assert(bits == u16(32))
            assert(is_signed)
        else: trap("expected Clang int to remain a signed FIIR type")

pub func test_clang_decoder_ignores_included_declarations_and_rejects_unsupported_main_header_shapes():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let with_include = (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"dependency.h\",\"line\":1,\"col\":5},\"name\":\"dependency\",\"type\":{\"qualType\":\"int (int)\"}},"
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"main.h\",\"line\":3,\"col\":8},\"name\":\"answer\",\"type\":{\"qualType\":\"double (double)\"}}"
        + "]}"
    )
    let module = decode_clang_ast(with_include, "main.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.functions) == 1)
    assert(module.functions[0].name == "answer")

    let pointer_result = (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"FunctionDecl\",\"loc\":{\"file\":\"main.h\",\"line\":1,\"col\":6},\"name\":\"allocate\",\"type\":{\"qualType\":\"void *(int)\"},\"inner\":["
        + "{\"kind\":\"ParmVarDecl\",\"loc\":{\"col\":19},\"name\":\"count\",\"type\":{\"qualType\":\"int\"}}]}"
        + "]}"
    )
    discard(decode_clang_ast(pointer_result, "main.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: function `allocate` has unsupported type spelling `void *(int)`")
        return
    trap("expected the scalar importer to reject a pointer result")

pub func test_fiir_validation_rejects_duplicate_foreign_declarations():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    var module = decode_clang_ast(two_function_ast(), "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.append(module.functions[0])
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: duplicate function declaration `luce_celsius_to_fahrenheit`")
        return
    trap("expected malformed FIIR to fail before generation")

# mark: Generated products =====================================================================

pub func test_scalar_fiir_renders_auditable_json_and_raw_luce_source():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "arm64-test-none", ["-std=c11"], facts) catch reason:
        trap(reason)
    module.functions.remove(1)

    let products = fiir_products.render_binding(module, "temperature") catch reason:
        trap(reason)
    let raw = products.raw_module
    assert(strings.starts_with(raw, "## Generated by luce-fiir-1. Do not edit.\n"))
    assert(strings.contains(raw, "## C header: temperature.h\n"))
    assert(strings.contains(raw, "## Clang target: arm64-test-none\n"))
    assert(strings.contains(raw, "import c\n"))
    assert(strings.contains(raw, "extern func luce_fiir_temperature_luce_celsius_to_fahrenheit(celsius: f64) -> f64\n"))
    assert(strings.contains(raw, "pub func luce_celsius_to_fahrenheit(celsius: c.double) -> c.double:"))
    assert(strings.contains(raw, "return c.double(luce_fiir_temperature_luce_celsius_to_fahrenheit(celsius.raw))"))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_BIT * sizeof(double) == 64"))
    assert(strings.contains(products.c_adapter, "double luce_fiir_temperature_luce_celsius_to_fahrenheit(double celsius)"))
    assert(strings.contains(products.c_adapter, "return luce_celsius_to_fahrenheit(celsius);"))

    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    let repeated = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(encoded == repeated)
    let document = json.parse(encoded) catch malformed:
        trap(json.describe(malformed))
    let format = document.member("format") else json.Json.null
    let header = document.member("header") else json.Json.null
    let target = document.member("target") else json.Json.null
    let types = document.member("types") else json.Json.null
    let functions = document.member("functions") else json.Json.null
    assert((format.as_text() else "") == "luce-fiir-1")
    assert((header.as_text() else "") == "temperature.h")
    assert((target.as_text() else "") == "arm64-test-none")
    # FIIR is an auditable Clang fact product, so removing a declaration from
    # this test fixture does not rewrite the original interned type table.
    assert(types.count() == 2)
    assert(functions.count() == 1)

pub func test_raw_generation_refuses_variadics_until_a_typed_adapter_exists():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(two_function_ast(), "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.remove(0)
    discard(fiir_products.render_binding(module, "temperature")) catch reason:
        assert(reason == "FIIR generation: variadic C function `adjust` requires a generated typed adapter")
        return
    trap("expected raw generation to refuse an unadapted variadic")

pub func test_raw_generation_refuses_target_sized_integers_until_their_checked_adapter_exists():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let document = strings.replace(two_function_ast(), "int (int, ...)", "int (int)")
    let module = decode_clang_ast(document, "temperature.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    module.functions.remove(0)
    discard(fiir_products.render_binding(module, "temperature")) catch reason:
        assert(reason == "FIIR generation: function `adjust` parameter `value` C type `int` has no completed scalar adapter yet")
        return
    trap("expected raw generation to refuse a target-sized integer")

# mark: Real Clang boundary ====================================================================

pub func test_clang_toolchain_inspects_the_example_header_and_cleans_its_scratch():
    let parent = files.make_temporary_directory(".", ".luce-clang-fiir-test-") catch reason:
        trap(reason)
    let module = ClangFiirToolchain().inspect(
        "examples/c_import/temperature.h",
        ["-std=c11", "-Wall", "-Wextra", "-Werror"],
        parent,
    ) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    assert(module.header == "examples/c_import/temperature.h")
    assert(module.target != "")
    assert(len(module.functions) == 1)
    assert(module.functions[0].name == "luce_celsius_to_fahrenheit")
    assert(module.functions[0].origin.line == u32(8))
    let entries = files.entries(parent) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    assert(len(entries) == 0)
    files.remove_all(parent) catch reason:
        trap(reason)

pub func test_clang_toolchain_reports_a_missing_tool_and_cleans_its_scratch():
    let parent = files.make_temporary_directory(".", ".luce-clang-fiir-test-") catch reason:
        trap(reason)
    discard(ClangFiirToolchain("/luce-test/missing-clang").inspect("examples/c_import/temperature.h", list[str](), parent)) catch reason:
        assert(strings.contains(reason, "Clang FIIR toolchain: target query exited with status"))
        assert(strings.contains(reason, "/luce-test/missing-clang"))
        let entries = files.entries(parent) catch read_reason:
            files.remove_all(parent) catch cleanup_reason:
                trap(cleanup_reason)
            trap(read_reason)
        assert(len(entries) == 0)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return
    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected the missing Clang command to fail")

# mark: Installed products =====================================================================

pub func test_binding_transaction_installs_all_three_auditable_products():
    let parent = files.make_temporary_directory(".", ".luce-binding-test-") catch reason:
        trap(reason)
    let outputs = CBindingOutputs(
        fiir = paths.join(parent, "temperature.fiir.json"),
        raw_module = paths.join(parent, "temperature.raw.native.luc"),
        c_adapter = paths.join(parent, "temperature.adapter.c"),
    )
    discard(bind_c(CBindingRequest(
        name = "temperature",
        header = "examples/c_import/temperature.h",
        clang_arguments = ["-std=c11", "-Wall", "-Wextra", "-Werror"],
    ), outputs)) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    let fiir = files.read(outputs.fiir) catch reason:
        trap(reason)
    let raw = files.read(outputs.raw_module) catch reason:
        trap(reason)
    let adapter = files.read(outputs.c_adapter) catch reason:
        trap(reason)
    assert(strings.contains(fiir, "\"format\": \"luce-fiir-1\""))
    assert(strings.contains(raw, "pub func luce_celsius_to_fahrenheit"))
    assert(strings.contains(adapter, "return luce_celsius_to_fahrenheit(celsius);"))
    let entries = files.entries(parent) catch reason:
        trap(reason)
    assert(len(entries) == 3)
    files.remove_all(parent) catch reason:
        trap(reason)

pub func test_binding_transaction_preserves_outputs_when_clang_fails():
    let parent = files.make_temporary_directory(".", ".luce-binding-test-") catch reason:
        trap(reason)
    let outputs = CBindingOutputs(
        fiir = paths.join(parent, "temperature.fiir.json"),
        raw_module = paths.join(parent, "temperature.raw.native.luc"),
        c_adapter = paths.join(parent, "temperature.adapter.c"),
    )
    files.write(outputs.fiir, "previous fiir") catch reason:
        trap(reason)
    files.write(outputs.raw_module, "previous raw") catch reason:
        trap(reason)
    files.write(outputs.c_adapter, "previous adapter") catch reason:
        trap(reason)
    discard(bind_c(CBindingRequest(
        name = "temperature",
        header = "examples/c_import/temperature.h",
        clang_arguments = list[str](),
    ), outputs, "/luce-test/missing-clang")) catch reason:
        assert(strings.contains(reason, "Clang FIIR toolchain: target query exited with status"))
        let previous_fiir = files.read(outputs.fiir) catch read_reason:
            trap(read_reason)
        let previous_raw = files.read(outputs.raw_module) catch read_reason:
            trap(read_reason)
        let previous_adapter = files.read(outputs.c_adapter) catch read_reason:
            trap(read_reason)
        assert(previous_fiir == "previous fiir")
        assert(previous_raw == "previous raw")
        assert(previous_adapter == "previous adapter")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 3)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return
    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected binding generation to fail with missing Clang")
