        + enum_constant_json("COLOR_MAX", 5, "18446744073709551615") + "]},"
        + "{\"id\":\"typedef-color\",\"kind\":\"TypedefDecl\",\"loc\":{\"line\":5,\"col\":3},"
        + "\"name\":\"Color\",\"type\":{\"qualType\":\"enum Color\"},\"inner\":["
