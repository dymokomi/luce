pub func test_external_objects_reject_definitions_atomic_thread_local_and_nonscalar_storage():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let definition = strings.replace(external_object_ast(), "\"storageClass\":\"extern\"}", "\"storageClass\":\"extern\",\"init\":\"c\"}")
    var definition_failed = false
    discard(decode_clang_ast(definition, "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(strings.contains(reason, "must be either a header-local `static const` value or a declaration-only `extern` object"))
        definition_failed = true
    assert(definition_failed)

    let atomic = strings.replace(external_object_ast(), "\"qualType\":\"_Bool\"", "\"qualType\":\"_Atomic(_Bool)\"")
    var atomic_failed = false
    discard(decode_clang_ast(atomic, "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: external C object `luce_enabled` is atomic, which requires an explicit operation recipe")
        atomic_failed = true
    assert(atomic_failed)

    let atomic_typedef = strings.replace(external_object_ast(), "\"qualType\":\"_Bool\"", "\"qualType\":\"atomic_flag\",\"desugaredQualType\":\"_Atomic(_Bool)\"")
    var atomic_typedef_failed = false
    discard(decode_clang_ast(atomic_typedef, "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: external C object `luce_enabled` is atomic, which requires an explicit operation recipe")
        atomic_typedef_failed = true
    assert(atomic_typedef_failed)

    let thread_local = strings.replace(external_object_ast(), "\"name\":\"luce_ratio\",\"type\"", "\"name\":\"luce_ratio\",\"tls\":\"static\",\"type\"")
    var thread_failed = false
    discard(decode_clang_ast(thread_local, "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: external C object `luce_ratio` uses thread-local storage, which has no generated accessor contract yet")
        thread_failed = true
    assert(thread_failed)

    let array = strings.replace(external_object_ast(), "\"qualType\":\"double\"", "\"qualType\":\"double[4]\"")
    var array_failed = false
    discard(decode_clang_ast(array, "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: external C object `luce_ratio` type `double[4]` is not supported by the value-function importer yet")
        array_failed = true
    assert(array_failed)

    let wrapper_collision = decode_clang_ast(external_object_collision_ast("read_luce_current"), "objects.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    var wrapper_collision_failed = false
    discard(render_binding_products(wrapper_collision, "objects")) catch reason:
        assert(reason == "FIIR generation: adapter symbol `luce_fiir_objects_read_luce_current` collides with generated reader for C object `luce_current`")
        wrapper_collision_failed = true
    assert(wrapper_collision_failed)

    let adapter_collision = decode_clang_ast(external_object_collision_ast("luce_fiir_objects_read_luce_current"), "objects.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    discard(render_binding_products(adapter_collision, "objects")) catch reason:
        assert(reason == "FIIR generation: adapter symbol `luce_fiir_objects_read_luce_current` collides with C function `luce_fiir_objects_read_luce_current`")
        return
    trap("expected an external object adapter symbol collision to fail")

# mark: Selected macro constants ===============================================================

pub func test_selected_macro_inventory_preserves_request_order_and_final_preprocessor_state():
    let definitions = decode_clang_macro_definitions(
        macro_inventory(),
        "macros.h",
        ["LUCE_UNSIGNED_LIMIT", "LUCE_DEPENDENCY_LIMIT"],
    ) catch reason:
        trap(reason)
    assert(len(definitions) == 2)
    assert(definitions[0].name == "LUCE_UNSIGNED_LIMIT")
    assert(definitions[0].origin.path == "macros.h" and definitions[0].origin.line == u32(11))
    assert(definitions[1].name == "LUCE_DEPENDENCY_LIMIT")
    assert(definitions[1].origin.path == "dependency.h" and definitions[1].origin.line == u32(1))

    var function_like_failed = false
    discard(decode_clang_macro_definitions(macro_inventory(), "macros.h", ["LUCE_CALL"])) catch reason:
        assert(reason == "Clang FIIR: selected macro `LUCE_CALL` is function-like; only object-like constant macros can be imported")
        function_like_failed = true
    assert(function_like_failed)
    var undefined_failed = false
    discard(decode_clang_macro_definitions(macro_inventory(), "macros.h", ["LUCE_REMOVED"])) catch reason:
        assert(reason == "Clang FIIR: selected macro `LUCE_REMOVED` is not defined after preprocessing `macros.h`")
        undefined_failed = true
    assert(undefined_failed)
    var duplicate_failed = false
    discard(decode_clang_macro_definitions(macro_inventory(), "macros.h", ["LUCE_SIGNED_LIMIT", "LUCE_SIGNED_LIMIT"])) catch reason:
        assert(reason == "Clang FIIR: selected macro `LUCE_SIGNED_LIMIT` was requested more than once")
        duplicate_failed = true
    assert(duplicate_failed)
    var invalid_name_failed = false
    discard(decode_clang_macro_definitions(macro_inventory(), "macros.h", ["NOT-A-C-NAME"])) catch reason:
        assert(reason == "Clang FIIR: selected macro `NOT-A-C-NAME` is not a portable C identifier")
        invalid_name_failed = true
    assert(invalid_name_failed)

pub func test_selected_integer_macros_use_separate_clang_type_and_value_probes():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let definitions = decode_clang_macro_definitions(
        macro_inventory(),
        "macros.h",
        ["LUCE_SIGNED_LIMIT", "LUCE_UNSIGNED_LIMIT"],
    ) catch reason:
        trap(reason)
    let document = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[]}"
    let type_probe = render_macro_type_probe(definitions)
    assert(strings.contains(type_probe, "#pragma clang diagnostic ignored \"-Wgnu-auto-type\""))
    assert(strings.contains(type_probe, "__auto_type __luce_fiir_macro_constant_type_0 = (LUCE_SIGNED_LIMIT);"))
    assert(not strings.contains(type_probe, "__builtin_constant_p"))
    let value_probe = render_macro_value_probe(document, facts, definitions, macro_type_ast()) catch reason:
        trap(reason)
    assert(strings.contains(value_probe, "__builtin_constant_p(LUCE_SIGNED_LIMIT)"))
    assert(strings.contains(value_probe, "__luce_fiir_macro_constant_1_word_3"))

    let module = decode_clang_ast(
        document,
        "macros.h",
        "test-target",
        list[str](),
        facts,
        "",
        ClangMacroProducts(definitions = definitions, type_document = macro_type_ast(), value_document = macro_value_facts()),
    ) catch reason:
        trap(reason)
    assert(len(module.constants) == 2 and len(module.types) == 2)
    assert(module.constants[0].source == FiirConstantSource.macro)
    assert(module.constants[0].origin.path == "macros.h" and module.constants[0].origin.line == u32(8))
    assert(module.types[module.constants[0].value_type.value].spelling == "long long")
    match module.constants[0].value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(9223372036854775808))
                else: trap("expected a signed macro minimum")
        else: trap("expected an integer macro minimum")
    assert(module.constants[1].source == FiirConstantSource.macro)
    match module.constants[1].value:
        Integer(value):
            match value:
                Nonnegative(integer): assert(integer == u64(18446744073709551615))
                else: trap("expected an unsigned macro maximum")
        else: trap("expected an integer macro maximum")

    let products = render_binding_products(module, "macros") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "## Selected C macro constants: LUCE_SIGNED_LIMIT LUCE_UNSIGNED_LIMIT"))
    assert(strings.contains(products.raw_module, "pub let LUCE_SIGNED_LIMIT: c.integer_constant = c.integer_constant(true, 9223372036854775808u64)"))
    assert(strings.contains(products.c_adapter, "_Generic((LUCE_SIGNED_LIMIT), long long: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "LUCE_UNSIGNED_LIMIT == UINT64_C(18446744073709551615)"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"source\": \"macro\""))
    let alternate = decode_clang_ast(
        document,
        "macros.h",
        "test-target",
        list[str](),
        facts,
        "",
        ClangMacroProducts(definitions = definitions, type_document = macro_type_ast("long", "unsigned long"), value_document = macro_value_facts()),
    ) catch reason:
        trap(reason)
    let alternate_products = render_binding_products(alternate, "macros") catch reason:
        trap(reason)
    let alternate_encoded = fiir_products.render_fiir_json(alternate) catch reason:
        trap(reason)
    assert(products.raw_module == alternate_products.raw_module)
    assert(products.c_adapter != alternate_products.c_adapter)
    assert(encoded != alternate_encoded)

pub func test_selected_macros_reject_unsupported_types_and_unevaluated_values_before_fiir():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let definitions = decode_clang_macro_definitions(
        macro_inventory(),
        "macros.h",
        ["LUCE_SIGNED_LIMIT", "LUCE_UNSIGNED_LIMIT"],
    ) catch reason:
        trap(reason)
    let document = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[]}"
    var type_failed = false
    discard(render_macro_value_probe(document, facts, definitions, macro_type_ast("const char *"))) catch reason:
        assert(reason == "Clang FIIR: selected C macro `LUCE_SIGNED_LIMIT` has unsupported non-integer type `const char *`")
        type_failed = true
    assert(type_failed)
    var value_failed = false
    discard(decode_clang_ast(
        document,
        "macros.h",
        "test-target",
        list[str](),
        facts,
        "",
        ClangMacroProducts(definitions = definitions, type_document = macro_type_ast(), value_document = macro_value_facts(first_constant = "0")),
    )) catch reason:
        assert(reason == "Clang FIIR: selected C macro `LUCE_SIGNED_LIMIT` does not have a Clang-evaluable constant value")
        value_failed = true
    assert(value_failed)

# mark: Plain record declarations ==============================================================

pub func test_plain_c_records_keep_clang_layout_only_in_fiir_and_the_c_adapter():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let probe = render_target_fact_probe(record_ast(), "pairs.h") catch reason:
        trap(reason)
    assert(strings.contains(probe, "sizeof(struct Pair) * __CHAR_BIT__"))
    assert(strings.contains(probe, "__builtin_offsetof(struct Pair, right) * __CHAR_BIT__"))
    let module = decode_clang_ast(record_ast(), "pairs.h", "test-target", list[str](), facts, record_layout_ast()) catch reason:
        trap(reason)
    assert(len(module.types) == 4 and len(module.functions) == 1)
    match module.types[2].form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            assert(name == "Pair" and (c_spelling else "") == "struct Pair")
            assert(size_bits == u64(128) and alignment_bits == u64(64))
            assert(len(fields) == 2)
            assert(fields[0].name == "left" and fields[0].offset_bits == u64(0))
            assert(fields[1].name == "right" and fields[1].offset_bits == u64(64))
        else: trap("expected a plain C record")
    let products = render_binding_products(module, "pairs") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub struct Pair:\n    pub let left: c.int\n    pub let right: c.double"))
    assert(strings.contains(products.raw_module, "extern struct __luce_fiir_pairs_record_Pair:\n    field_0: i64\n    field_1: f64"))
    assert(strings.contains(products.raw_module, "pub func echo_pair(value: Pair) -> Pair:"))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_BIT * sizeof(struct Pair) == 128"))
    assert(strings.contains(products.c_adapter, "offsetof(struct Pair, right) == 64"))
    assert(strings.contains(products.c_adapter, "Pair luce_result = echo_pair(luce_native_0);"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"kind\": \"record\""))
    assert(strings.contains(encoded, "\"offset_bits\": \"64\""))

pub func test_record_layout_changes_fiir_and_c_but_not_generated_luce():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let compact = decode_clang_ast(record_ast(), "pairs.h", "same-target", list[str](), facts, record_layout_ast()) catch reason:
        trap(reason)
    let padded = decode_clang_ast(record_ast(), "pairs.h", "same-target", list[str](), facts, record_layout_ast("192", "128")) catch reason:
        trap(reason)
    let compact_products = render_binding_products(compact, "pairs") catch reason:
        trap(reason)
    let padded_products = render_binding_products(padded, "pairs") catch reason:
        trap(reason)
    assert(compact_products.raw_module == padded_products.raw_module)
    assert(compact_products.c_adapter != padded_products.c_adapter)
    let compact_fiir = fiir_products.render_fiir_json(compact) catch reason:
        trap(reason)
    let padded_fiir = fiir_products.render_fiir_json(padded) catch reason:
        trap(reason)
    assert(compact_fiir != padded_fiir)

pub func test_record_validation_rejects_missing_and_nonmonotonic_layout_facts():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
