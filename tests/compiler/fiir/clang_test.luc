# mark: External C objects ====================================================================

pub func test_external_scalar_objects_generate_target_neutral_read_and_write_accessors():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(external_object_ast(), "objects.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.objects) == 4 and len(module.constants) == 0 and len(module.functions) == 0)
    assert(module.objects[0].name == "luce_current")
    assert(module.objects[0].access == FiirObjectAccess.read_write and module.objects[0].is_volatile)
    assert(module.types[module.objects[0].value_type.value].spelling == "luce_count")
    assert(module.objects[1].name == "luce_capacity")
    assert(module.objects[1].access == FiirObjectAccess.read_only and module.objects[1].is_volatile)
    assert(module.objects[2].access == FiirObjectAccess.read_write and not module.objects[2].is_volatile)

    let products = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "# mark: C objects"))
    assert(strings.contains(products.raw_module, "pub func read_luce_current() -> luce_count:"))
    assert(strings.contains(products.raw_module, "pub func write_luce_current(value: luce_count):"))
    assert(strings.contains(products.raw_module, "let status = luce_fiir_objects_write_luce_current(value.raw)"))
    assert(strings.contains(products.raw_module, "pub func read_luce_capacity() -> c.unsigned_long_long:"))
    assert(not strings.contains(products.raw_module, "write_luce_capacity"))
    assert(strings.contains(products.raw_module, "pub func write_luce_enabled(value: c.boolean):"))
    assert(strings.contains(products.raw_module, "pub func write_luce_ratio(value: c.double):"))
    assert(strings.contains(products.c_adapter, "_Generic(&(luce_current), volatile luce_count *: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "_Generic(&(luce_capacity), const volatile unsigned long long *: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "int32_t luce_fiir_objects_write_luce_current(int64_t value)"))
    assert(strings.contains(products.c_adapter, "luce_current = (luce_count)value;"))
    assert(strings.contains(products.c_adapter, "void luce_fiir_objects_write_luce_enabled(_Bool value)"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"objects\": ["))
    assert(strings.contains(encoded, "\"access\": \"read_only\""))
    assert(strings.contains(encoded, "\"volatile\": true"))

    let alternate = decode_clang_ast(strings.replace(external_object_ast(), "\"qualType\":\"int\"", "\"qualType\":\"long\""), "objects.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    let alternate_products = render_binding_products(alternate, "objects") catch reason:
        trap(reason)
    let alternate_encoded = fiir_products.render_fiir_json(alternate) catch reason:
        trap(reason)
    assert(alternate_products.raw_module == products.raw_module)
    assert(alternate_products.c_adapter != products.c_adapter)
    assert(alternate_encoded != encoded)

    let half = decode_clang_ast(external_float16_object_ast(), "objects.h", "test-target", list[str](), facts, float16_layout_ast()) catch reason:
        trap(reason)
    let half_products = render_binding_products(half, "objects") catch reason:
        trap(reason)
    assert(strings.contains(half_products.raw_module, "extern func luce_fiir_objects_read_luce_half() -> f32"))
    assert(strings.contains(half_products.raw_module, "pub func read_luce_half() -> c.float16:"))
    assert(strings.contains(half_products.raw_module, "extern func luce_fiir_objects_write_luce_half(value: f32)"))
    assert(strings.contains(half_products.c_adapter, "float luce_fiir_objects_read_luce_half(void)"))
    assert(strings.contains(half_products.c_adapter, "luce_half = (_Float16)value;"))

pub func test_external_enumeration_objects_reuse_the_checked_sign_magnitude_boundary():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(external_enumeration_object_ast(), "objects.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.objects) == 2)
    assert(module.objects[0].access == FiirObjectAccess.read_write)
    assert(module.objects[1].access == FiirObjectAccess.read_only)

    let products = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "extern func luce_fiir_objects_read_current_color(out result_is_negative: bool, out result_magnitude: u64) -> i32"))
    assert(strings.contains(products.raw_module, "pub func read_current_color() -> Color:"))
    assert(strings.contains(products.raw_module, "native_enum_value: C object `current_color` contains an undeclared enum value"))
    assert(strings.contains(products.raw_module, "extern func luce_fiir_objects_write_current_color(value_is_negative: bool, value_magnitude: u64) -> i32"))
    assert(strings.contains(products.raw_module, "let (value_is_negative, value_magnitude) = value.portable()"))
    assert(strings.contains(products.raw_module, "native_enum_value: C object `current_color` received an undeclared enum value"))
    assert(strings.contains(products.raw_module, "pub func read_default_color() -> Color:"))
    assert(not strings.contains(products.raw_module, "write_default_color"))
    assert(strings.contains(products.c_adapter, "_Generic(&(current_color), Color *: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "Color luce_result = current_color;"))
    assert(strings.contains(products.c_adapter, "if (luce_result == COLOR_RED)"))
    assert(strings.contains(products.c_adapter, "if (value_is_negative && value_magnitude == UINT64_C(2)) luce_native_value = COLOR_RED;"))
    assert(strings.contains(products.c_adapter, "current_color = luce_native_value;"))
    assert(strings.contains(products.c_adapter, "_Generic(&(default_color), const enum Color *: 1, default: 0)"))

