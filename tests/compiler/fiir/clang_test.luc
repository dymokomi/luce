func enum_constant_json(name: str, line: i64, value: str) -> str:
    return (
        "{\"kind\":\"EnumConstantDecl\",\"loc\":{\"line\":" + str(line) + ",\"col\":5},\"name\":\"" + name + "\","
        + "\"type\":{\"qualType\":\"int\"},\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"" + value + "\"}]}"
    )

