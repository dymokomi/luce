pub func test_nested_dependency_records_are_imported_only_when_the_main_header_reaches_them():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let document = included_record_ast()
    let probe = render_target_fact_probe(document, "main.h") catch reason:
        trap(reason)
    assert(strings.contains(probe, "sizeof(struct Outer)"))
    assert(strings.contains(probe, "sizeof(struct Inner)"))
    let module = decode_clang_ast(document, "main.h", "test-target", list[str](), facts, included_record_layout_ast()) catch reason:
        trap(reason)
    assert(len(module.types) == 3)
    match module.types[1].form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin): assert(name == "Inner" and len(fields) == 1)
        else: trap("expected the reached dependency record")
    match module.types[2].form:
        Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
            assert(name == "Outer" and len(fields) == 1 and fields[0].value_type.value == u32(1))
        else: trap("expected the main-header record")

