pub func test_forward_declared_c_enumeration_resolves_to_its_later_definition():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(forward_enumeration_ast(), "forward.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    assert(len(module.types) == 2 and len(module.functions) == 1)
    match module.types[0].form:
        Enumeration(name, c_spelling, cases, origin):
            assert(name == "State" and len(cases) == 1 and cases[0].name == "STATE_READY")
        else: trap("expected the completed forward C enumeration")
    match module.types[1].form:
        Typedef(target, origin): assert(target.value == u32(0))
        else: trap("expected the forward enum typedef")

pub func test_c_enumeration_adapter_shape_is_independent_of_target_enum_flags():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let ordinary = decode_clang_ast(enumeration_ast(), "colors.h", "same-target", list[str](), facts) catch reason:
        trap(reason)
    let shortened = decode_clang_ast(enumeration_ast(), "colors.h", "same-target", ["-fshort-enums"], facts) catch reason:
        trap(reason)
    let ordinary_products = render_binding_products(ordinary, "colors") catch reason:
        trap(reason)
    let shortened_products = render_binding_products(shortened, "colors") catch reason:
        trap(reason)
    let normalized = strings.replace(shortened_products.raw_module, "## Clang arguments: -fshort-enums\n", "")
    assert(ordinary_products.raw_module == normalized)
    assert(ordinary_products.c_adapter == shortened_products.c_adapter)

pub func test_every_fundamental_c_integer_family_has_a_stable_nominal_mapping():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let module = decode_clang_ast(integer_family_ast(), "integers.h", "test-target", list[str](), facts) catch reason:
        trap(reason)
    let products = render_binding_products(module, "integers") catch reason:
        trap(reason)
    let public_names = [
        "plain_char", "signed_char", "unsigned_char", "short", "unsigned_short", "int",
        "unsigned_int", "long", "unsigned_long", "long_long", "unsigned_long_long",
    ]
    assert(len(module.types) == len(public_names))
    assert(len(module.functions) == len(public_names))
    for index in range(0, len(public_names)):
        let signature = "pub func echo_" + str(index) + "(value: c." + public_names[index] + ") -> c." + public_names[index]
        assert(strings.contains(products.raw_module, signature))
    assert(strings.contains(products.c_adapter, "_Static_assert(CHAR_MIN == -INT64_C(128) && CHAR_MAX == INT64_C(127)"))
    assert(strings.contains(products.c_adapter, "_Static_assert(ULONG_MAX == UINT64_MAX"))
    assert(strings.contains(products.c_adapter, "int32_t luce_fiir_integers_echo_10(uint64_t value, uint64_t *result)"))
    assert(strings.contains(products.c_adapter, "*result = (uint64_t)(echo_10((unsigned long long)value));"))

pub func test_integer_target_width_changes_only_fiir_and_the_c_adapter():
    let document = strings.replace(two_function_ast(), "int (int, ...)", "int (int)")
    let facts_32 = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let narrow_macros = strings.replace(
        strings.replace(target_macros(), "#define __INT_WIDTH__ 32", "#define __INT_WIDTH__ 16"),
        "#define __SIZEOF_INT__ 4",
        "#define __SIZEOF_INT__ 2",
    )
    let facts_16 = decode_clang_scalar_facts(narrow_macros) catch reason:
        trap(reason)
    let module_32 = decode_clang_ast(document, "temperature.h", "same-target-name", list[str](), facts_32) catch reason:
        trap(reason)
    let module_16 = decode_clang_ast(document, "temperature.h", "same-target-name", list[str](), facts_16) catch reason:
        trap(reason)
    module_32.functions.remove(0)
    module_16.functions.remove(0)
    let products_32 = render_binding_products(module_32, "temperature") catch reason:
        trap(reason)
    let products_16 = render_binding_products(module_16, "temperature") catch reason:
        trap(reason)
    assert(products_32.raw_module == products_16.raw_module)
    assert(products_32.c_adapter != products_16.c_adapter)
    assert(strings.contains(products_32.c_adapter, "value > INT64_C(2147483647)"))
    assert(strings.contains(products_16.c_adapter, "value > INT64_C(32767)"))
    let fiir_32 = fiir_products.render_fiir_json(module_32) catch reason:
        trap(reason)
    let fiir_16 = fiir_products.render_fiir_json(module_16) catch reason:
        trap(reason)
    assert(fiir_32 != fiir_16)
