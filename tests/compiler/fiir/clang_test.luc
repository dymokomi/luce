    discard(decode_clang_ast(record_ast(), "pairs.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: reachable C records have no Clang-evaluated target-fact probe")
        missing_failed = true
    assert(missing_failed)
    discard(decode_clang_ast(record_ast(), "pairs.h", "test-target", list[str](), facts, record_layout_ast("128", "0"))) catch reason:
        assert(reason == "FIIR: C record `Pair` field offsets are not in declaration order")
        return
    trap("expected nonmonotonic C record offsets to fail validation")

