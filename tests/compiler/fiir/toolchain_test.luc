#==============================================================================================
#
#   fiir.toolchain_test - Real Clang inspection and atomic binding installation
#
#==============================================================================================

from luce.compiler.backends.clang_fiir import CBindingOutputs, CBindingRequest, ClangFiirToolchain, bind_c, render_binding_products
from luce.compiler.fiir.schema import FiirConstantSource, FiirObjectAccess, FiirTypeForm
import std.files
import std.paths
import std.strings

# mark: Real Clang boundary ====================================================================

pub func test_clang_toolchain_inspects_the_example_header_and_cleans_its_scratch():
    let parent = files.make_temporary_directory(".", ".luce-clang-fiir-test-") catch reason:
        trap(reason)
    let module = ClangFiirToolchain().inspect(
        "examples/c_import/temperature.h",
        ["-std=c11", "-Wall", "-Wextra", "-Werror"],
        parent,
        ["LUCE_TEMPERATURE_ABSOLUTE_ZERO", "LUCE_TEMPERATURE_SENSOR_LIMIT"],
    ) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    assert(module.header == "examples/c_import/temperature.h")
    assert(module.target != "")
    assert(len(module.functions) == 10)
    assert(module.functions[0].name == "luce_celsius_to_fahrenheit")
    assert(module.functions[0].origin.line == u32(67))
    assert(module.functions[1].name == "luce_half_celsius")
    assert(module.functions[2].name == "luce_adjust_half")
    assert(module.functions[4].name == "luce_echo_degrees")
    assert(module.functions[5].name == "luce_echo_scale")
    assert(module.functions[6].name == "luce_invalid_scale")
    assert(module.functions[7].name == "luce_is_freezing")
    assert(module.functions[8].name == "luce_shift_range")
    assert(module.functions[9].name == "luce_shift_reading")
    var records = 0
    var anonymous_range = false
    var tagged_reading = false
    for value_type in module.types:
        match value_type.form:
            Record(name, c_spelling, fields, size_bits, alignment_bits, origin):
                records += 1
                if name == "luce_temperature_range": anonymous_range = c_spelling == none
                if name == "luce_temperature_reading": tagged_reading = (c_spelling else "") == "struct luce_temperature_reading"
            else: pass
    assert(records == 2)
    assert(anonymous_range and tagged_reading)
    let products = render_binding_products(module, "temperature") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub let fraction: luce_half_value"))
    assert(strings.contains(products.raw_module, "field_3: f32"))
    assert(strings.contains(products.c_adapter, "destination->fraction = (luce_half_value)source->field_3;"))
    assert(len(module.constants) == 14)
    assert(module.constants[0].name == "LUCE_WATER_FREEZING_CELSIUS")
    assert(module.constants[1].name == "LUCE_WATER_BOILING_CELSIUS")
    assert(module.constants[2].name == "LUCE_TEMPERATURE_DEFAULT_SCALE")
    assert(module.constants[3].name == "LUCE_TEMPERATURE_OPEN_SCALE")
    assert(module.constants[4].name == "LUCE_TEMPERATURE_SIGNED_MINIMUM")
    assert(module.constants[5].name == "LUCE_TEMPERATURE_UNSIGNED_MAXIMUM")
    assert(module.constants[6].name == "LUCE_TEMPERATURE_DEFAULT_ENABLED")
    assert(module.constants[7].name == "LUCE_TEMPERATURE_HALF_STEP")
    assert(module.constants[8].name == "LUCE_TEMPERATURE_NEGATIVE_ZERO")
    assert(module.constants[9].name == "LUCE_TEMPERATURE_REFERENCE_RATIO")
    assert(module.constants[10].name == "LUCE_TEMPERATURE_POSITIVE_INFINITY")
    assert(module.constants[11].name == "LUCE_TEMPERATURE_UNDEFINED")
    assert(module.constants[12].name == "LUCE_TEMPERATURE_ABSOLUTE_ZERO")
    assert(module.constants[12].source == FiirConstantSource.macro)
    assert(module.constants[12].origin.line == u32(54) and module.constants[12].origin.column == u32(1))
    assert(module.types[module.constants[12].value_type.value].spelling == "luce_degrees")
    assert(module.constants[13].name == "LUCE_TEMPERATURE_SENSOR_LIMIT")
    assert(len(module.objects) == 5)
    assert(module.objects[0].name == "luce_temperature_offset")
    assert(module.objects[0].access == FiirObjectAccess.read_write and module.objects[0].is_volatile and module.objects[0].origin.line == u32(61))
    assert(module.objects[1].name == "luce_temperature_sensor_capacity")
    assert(module.objects[1].access == FiirObjectAccess.read_only and module.objects[1].origin.line == u32(62))
    assert(module.objects[2].name == "luce_temperature_enabled")
    assert(module.objects[2].access == FiirObjectAccess.read_write and module.objects[2].origin.line == u32(63))
    assert(module.objects[3].name == "luce_temperature_ratio")
    assert(module.objects[3].access == FiirObjectAccess.read_write and module.objects[3].origin.line == u32(64))
    assert(module.objects[4].name == "luce_temperature_unit")
    assert(module.objects[4].access == FiirObjectAccess.read_write and module.objects[4].origin.line == u32(65))
    assert(strings.contains(products.raw_module, "pub func read_luce_temperature_offset() -> luce_degrees:"))
    assert(strings.contains(products.raw_module, "pub func write_luce_temperature_offset(value: luce_degrees):"))
    assert(strings.contains(products.raw_module, "pub func read_luce_temperature_sensor_capacity() -> c.unsigned_long_long:"))
    assert(not strings.contains(products.raw_module, "write_luce_temperature_sensor_capacity"))
    assert(strings.contains(products.raw_module, "pub func write_luce_temperature_enabled(value: c.boolean):"))
    assert(strings.contains(products.raw_module, "pub func write_luce_temperature_ratio(value: c.double):"))
    assert(strings.contains(products.raw_module, "pub func read_luce_temperature_unit() -> luce_temperature_scale:"))
    assert(strings.contains(products.raw_module, "pub func write_luce_temperature_unit(value: luce_temperature_scale):"))
    assert(strings.contains(products.c_adapter, "luce_fiir_temperature_read_luce_temperature_offset"))
    assert(strings.contains(products.c_adapter, "luce_fiir_temperature_write_luce_temperature_offset"))
    assert(strings.contains(products.c_adapter, "luce_fiir_temperature_read_luce_temperature_unit"))
    assert(strings.contains(products.c_adapter, "luce_fiir_temperature_write_luce_temperature_unit"))
    assert(strings.contains(products.raw_module, "c.integer_constant(true, 9223372036854775808u64)"))
    assert(strings.contains(products.raw_module, "c.integer_constant(false, 18446744073709551615u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_TEMPERATURE_DEFAULT_SCALE: luce_temperature_scale = luce_temperature_scale(true, 2u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_TEMPERATURE_OPEN_SCALE: luce_temperature_scale = luce_temperature_scale(false, 7u64)"))
    assert(strings.contains(products.raw_module, "c.float(-0.0f32)"))
    assert(strings.contains(products.raw_module, "c.double(math.nan_f64)"))
    let entries = files.entries(parent) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    assert(len(entries) == 0)
    files.remove_all(parent) catch reason:
        trap(reason)

pub func test_clang_toolchain_reports_a_missing_tool_and_cleans_its_scratch():
    let parent = files.make_temporary_directory(".", ".luce-clang-fiir-test-") catch reason:
        trap(reason)
    discard(ClangFiirToolchain("/luce-test/missing-clang").inspect("examples/c_import/temperature.h", list[str](), parent)) catch reason:
        assert(strings.contains(reason, "Clang FIIR toolchain: target query exited with status"))
        assert(strings.contains(reason, "/luce-test/missing-clang"))
        let entries = files.entries(parent) catch read_reason:
            files.remove_all(parent) catch cleanup_reason:
                trap(cleanup_reason)
            trap(read_reason)
        assert(len(entries) == 0)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return
    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected the missing Clang command to fail")

# mark: Installed products =====================================================================

pub func test_binding_transaction_installs_all_three_auditable_products():
    let parent = files.make_temporary_directory(".", ".luce-binding-test-") catch reason:
        trap(reason)
    let outputs = CBindingOutputs(
        fiir = paths.join(parent, "temperature.fiir.json"),
        raw_module = paths.join(parent, "temperature.raw.native.luc"),
        c_adapter = paths.join(parent, "temperature.adapter.c"),
    )
    discard(bind_c(CBindingRequest(
        name = "temperature",
        header = "examples/c_import/temperature.h",
        clang_arguments = ["-std=c11", "-Wall", "-Wextra", "-Werror"],
        macro_constants = ["LUCE_TEMPERATURE_ABSOLUTE_ZERO", "LUCE_TEMPERATURE_SENSOR_LIMIT"],
    ), outputs)) catch reason:
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    let fiir = files.read(outputs.fiir) catch reason:
        trap(reason)
    let raw = files.read(outputs.raw_module) catch reason:
        trap(reason)
    let adapter = files.read(outputs.c_adapter) catch reason:
        trap(reason)
    assert(strings.contains(fiir, "\"format\": \"luce-fiir-1\""))
    assert(strings.contains(raw, "pub func luce_celsius_to_fahrenheit"))
    assert(strings.contains(adapter, "return luce_celsius_to_fahrenheit(celsius);"))
    let entries = files.entries(parent) catch reason:
        trap(reason)
    assert(len(entries) == 3)
    files.remove_all(parent) catch reason:
        trap(reason)

pub func test_binding_transaction_preserves_outputs_when_clang_fails():
    let parent = files.make_temporary_directory(".", ".luce-binding-test-") catch reason:
        trap(reason)
    let outputs = CBindingOutputs(
        fiir = paths.join(parent, "temperature.fiir.json"),
        raw_module = paths.join(parent, "temperature.raw.native.luc"),
        c_adapter = paths.join(parent, "temperature.adapter.c"),
    )
    files.write(outputs.fiir, "previous fiir") catch reason:
        trap(reason)
    files.write(outputs.raw_module, "previous raw") catch reason:
        trap(reason)
    files.write(outputs.c_adapter, "previous adapter") catch reason:
        trap(reason)
    discard(bind_c(CBindingRequest(
        name = "temperature",
        header = "examples/c_import/temperature.h",
        clang_arguments = list[str](),
        macro_constants = list[str](),
    ), outputs, "/luce-test/missing-clang")) catch reason:
        assert(strings.contains(reason, "Clang FIIR toolchain: target query exited with status"))
        let previous_fiir = files.read(outputs.fiir) catch read_reason:
            trap(read_reason)
        let previous_raw = files.read(outputs.raw_module) catch read_reason:
            trap(read_reason)
        let previous_adapter = files.read(outputs.c_adapter) catch read_reason:
            trap(read_reason)
        assert(previous_fiir == "previous fiir")
        assert(previous_raw == "previous raw")
        assert(previous_adapter == "previous adapter")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 3)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return
    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected binding generation to fail with missing Clang")
