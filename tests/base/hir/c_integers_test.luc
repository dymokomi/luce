#==============================================================================================
#
#   c_integers_test - C's target-dependent integers are distinct types
#
#   DESCRIPTION:
#       `c.char`, `c.long`, `c.ulong`, and `c.wchar` (base.md §5.2) are
#       neither aliases nor fixed widths: a constant must fit them on every
#       supported target, they widen implicitly only where no target loses a
#       value, and the standard `c` module is the only place that names the
#       identities behind them.
#
#==============================================================================================

from common.hir.generator_support import base_source_module, checked, semantic_failure
from common.mir.lowering_support import base_modules
import std.strings

pub func test_c_integers_are_distinct_and_widen_conservatively():
    let source = "import c\n\npub func widen(a: i32, b: u16, w: i16, ch: c.char, l: c.long, u: c.ulong, wc: c.wchar) -> i64:\n    let long_from_i32: c.long = a\n    let ulong_from_u16: c.ulong = b\n    let wchar_from_i16: c.wchar = w\n    let wide: i64 = l\n    let wide_unsigned: u64 = u\n    let from_char: i32 = ch\n    let from_wchar: i64 = wc\n    return wide + (i64)wide_unsigned + from_char + from_wchar\n"
    assert(len(checked(base_modules(source)).functions) >= 1)

pub func test_a_narrowing_or_target_unsafe_widening_is_refused():
    let to_long = semantic_failure(base_modules("import c\n\npub func f(value: i64) -> c.long:\n    return value\n"))
    assert(strings.contains(to_long, "`i64`"))
    assert(strings.contains(to_long, "`c.long`"))
    let from_long = semantic_failure(base_modules("import c\n\npub func f(value: c.long) -> i32:\n    return value\n"))
    assert(strings.contains(from_long, "`c.long`"))
    let usize_to_long = semantic_failure(base_modules("import c\n\npub func f(value: usize) -> c.ulong:\n    return value\n"))
    assert(strings.contains(usize_to_long, "`c.ulong`"))
    let to_char = semantic_failure(base_modules("import c\n\npub func f(value: i8) -> c.char:\n    return value\n"))
    assert(strings.contains(to_char, "`c.char`"))

pub func test_a_constant_must_fit_every_target():
    let too_wide = semantic_failure(base_modules("import c\n\npub func f() -> c.long:\n    return 5000000000\n"))
    assert(strings.contains(too_wide, "outside `c.long` range"))
    let fits = "import c\n\npub func f() -> c.long:\n    return -2147483647 - 1\n"
    assert(len(checked(base_modules(fits)).functions) >= 1)
    let negative_char = semantic_failure(base_modules("import c\n\npub func f() -> c.char:\n    return -1\n"))
    assert(strings.contains(negative_char, "outside `c.char` range"))

pub func test_only_the_standard_c_module_names_the_identities():
    let failure = semantic_failure([base_source_module("main", "pub func f(value: c_long) -> i64:\n    return value\n")])
    assert(len(failure) > 0)
