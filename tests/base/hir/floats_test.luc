#==============================================================================================
#
#   floats_test - Float bits and display in a Base module
#
#   DESCRIPTION:
#       `value.bits()` reads an `f64` as `u64` and an `f32` as `u32` (base.md
#       §7.5), and a float field in a formatted string calls the standard
#       `io` module's shortest-round-trip printer (§14.4).
#
#==============================================================================================

from common.hir.generator_support import base_source_module, checked, semantic_failure
from common.mir.lowering_support import base_modules
import std.strings

pub func test_bits_reads_the_ieee_pattern_at_the_floats_width():
    let source = "pub func patterns(wide: f64, narrow: f32) -> u64:\n    let high: u64 = wide.bits()\n    let low: u32 = narrow.bits()\n    return high + u64(low)\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    let arity = semantic_failure([base_source_module("main", "pub func f(wide: f64) -> u64:\n    return wide.bits(1)\n")])
    assert(strings.contains(arity, "`bits()` takes no arguments"))

pub func test_float_fields_display_through_io():
    let source = "pub func show(ratio: f64, small: f32):\n    print(f\"{ratio} {small}\")\n"
    let program = checked(base_modules(source))
    var float_calls = 0
    for function in program.functions:
        if function.name == "write_float64" or function.name == "write_float32": float_calls += 1
    assert(float_calls == 2)

pub func test_float_from_bits_and_char_take_their_patterns():
    let source = "pub func build(wide: u64, narrow: u32, code: u32) -> f64:\n    let a = f64.bits(wide)\n    let b = f32.bits(narrow)\n    let c = char(code)\n    return a + f64(b) + f64(u32(c))\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 1)
    let wrong_width = semantic_failure([base_source_module("main", "pub func f(bits: u64) -> f32:\n    return f32.bits(bits)\n")])
    assert(strings.contains(wrong_width, "`u64`") and strings.contains(wrong_width, "`u32`"))
    let not_integer = semantic_failure([base_source_module("main", "pub func f(value: f64) -> char:\n    return char(value)\n")])
    assert(strings.contains(not_integer, "`char(...)` converts an integer; `f64` is not one"))
