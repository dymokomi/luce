#==============================================================================================
#
#   location_test - `location()` is evaluated where the call is written
#
#   DESCRIPTION:
#       `Location` is the standard `io` module's struct, spelled bare in a
#       Base module, and `location()` answers the caller's file, line, and
#       function (base.md §9.1). As a parameter default it stays a marker
#       until each call site embeds its own location; anywhere else it is a
#       constant of the place it was written.
#
#==============================================================================================

from common.hir.generator_support import base_source_module, semantic_failure, checked
from common.mir.lowering_support import base_modules
from luce.compiler.hir.ir import HirNodeForm, Value
import std.strings

pub func test_a_location_default_is_replaced_at_each_call_site():
    let source = "func log(message: str, at: Location = location()):\n    print(f\"{at.line}\")\n\npub func run():\n    log(\"a\")\n    log(\"b\")\n"
    let program = checked(base_modules(source))
    var markers = 0
    var lines = list[u64]()
    for index in range(0, len(program.nodes)):
        match program.nodes[index].form:
            CallSiteLocation: markers += 1
            Constant(value_index):
                match program.values[value_index]:
                    UnsignedInteger(item): lines.append(item)
                    else: pass
            else: pass
    # The default keeps its marker; the two call sites carry lines 5 and 6.
    assert(markers == 1)
    var saw_five = false
    var saw_six = false
    for line in lines:
        if line == u64(5): saw_five = true
        if line == u64(6): saw_six = true
    assert(saw_five and saw_six)

pub func test_location_takes_no_arguments_and_needs_the_io_module():
    let arity = semantic_failure(base_modules("pub func here() -> u32:\n    return location(1).line\n"))
    assert(strings.contains(arity, "`location()` takes no arguments"))
    let alone = semantic_failure([base_source_module("main", "pub func here() -> u32:\n    return location().line\n")])
    assert(strings.contains(alone, "`location()` needs the standard `io` module"))
