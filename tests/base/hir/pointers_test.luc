#==============================================================================================
#
#   pointers_test - Methods called through a Base pointer
#
#   DESCRIPTION:
#       `p.method(...)` reaches the pointee as `p.field` does (base.md §7.7):
#       a mutating method needs a mutable pointee, so `const T*` is refused
#       with the pointer type named, and a reading method works through both.
#
#==============================================================================================

from common.hir.generator_support import base_source_module, checked, semantic_failure
import std.strings

pub func test_methods_are_called_through_pointers():
    let source = "pub struct Counter:\n    pub var count: i32\n\n    pub mutating func bump(self):\n        self.count += 1\n\n    pub func total(self) -> i32:\n        return self.count\n\npub func drive(counter: Counter*, seen: const Counter*) -> i32:\n    counter.bump()\n    return seen.total() + counter.total()\n"
    assert(len(checked([base_source_module("main", source)]).functions) == 3)

pub func test_a_mutating_method_through_a_const_pointer_is_refused():
    let source = "pub struct Counter:\n    pub var count: i32\n\n    pub mutating func bump(self):\n        self.count += 1\n\npub func drive(counter: const Counter*):\n    counter.bump()\n"
    let failure = semantic_failure([base_source_module("main", source)])
    assert(strings.contains(failure, "mutating method needs a mutable pointee; `const Counter*` is `const`"))
