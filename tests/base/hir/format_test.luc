#==============================================================================================
#
#   format_test - Formatted output in a Base module goes to a sink, never a value
#
#   DESCRIPTION:
#       `print(f"...")` becomes calls on the standard `io` module's display
#       functions with the sink held once and every failure ignored (base.md
#       §5.5, §14.4); a formatted string anywhere else, a field with no
#       display, and a program without the `io` module are each refused with
#       a diagnostic that says what Base offers instead. `u32(c)` reads a
#       `char` as its scalar value in both profiles.
#
#==============================================================================================

from common.hir.generator_support import base_source_module, checked, semantic_failure, source_module, standard_base_source_module
from common.mir.lowering_support import base_modules
from luce.compiler.hir.ir import HirNodeForm, node_form
import std.strings

# mark: Desugaring ============================================================================

pub func test_formatted_print_calls_the_io_display_functions():
    let source = "pub func main(arguments: str[]) -> i32:\n    let count: i32 = 3\n    let word = \"hello\"\n    print(f\"count {count} word {word} at {&count}\")\n    return 0\n"
    let program = checked(base_modules(source))
    var calls = 0
    var catches = 0
    var writes = 0
    for index in range(0, len(program.nodes)):
        match program.nodes[index].form:
            Call(function, arguments): calls += 1
            Catch(value, failure, body): catches += 1
            WriteBytes(data, stream): writes += 1
            else: pass
    # `stdout()`, then one guarded call per piece: "count ", 3, " word ",
    # "hello", " at ", the address, and the newline.
    assert(calls >= 8)
    assert(catches == 7)
    # The intrinsics appear only inside the standard `io` module.
    assert(writes == 2)

pub func test_a_char_reads_as_its_scalar_value_in_both_profiles():
    let base = "pub func code(letter: char) -> u32:\n    return u32(letter)\n"
    assert(len(checked([base_source_module("main", base)]).functions) == 1)
    let full = "pub func code(letter: char) -> u32:\n    return u32(letter)\n"
    assert(len(checked([source_module("main", full)]).functions) == 1)

# mark: Refusals ==============================================================================

pub func test_a_formatted_string_has_no_value_in_base():
    let source = "pub func label(count: i32) -> str:\n    let text = f\"count {count}\"\n    return text\n"
    let failure = semantic_failure(base_modules(source))
    assert(strings.contains(failure, "a formatted string has no value in Luce Base; `print` it, or write it to a `Writer` (base.md §5.5)"))

pub func test_a_float_field_names_the_missing_printer():
    let source = "pub func show(ratio: f64):\n    print(f\"ratio {ratio}\")\n"
    let failure = semantic_failure(base_modules(source))
    assert(strings.contains(failure, "a floating-point field in a formatted string waits for Luce Base's shortest-round-trip printer"))

pub func test_a_struct_field_has_no_display():
    let source = "pub struct Point:\n    pub var x: i32\n\npub func show(point: Point):\n    print(f\"point {point}\")\n"
    let failure = semantic_failure(base_modules(source))
    assert(strings.contains(failure, "`Point` has no display in a formatted string; integers, `bool`, `char`, `str`, and pointers do"))

pub func test_formatted_print_needs_the_standard_io_module():
    let source = "pub func show(count: i32):\n    print(f\"count {count}\")\n"
    let failure = semantic_failure([base_source_module("main", source)])
    assert(strings.contains(failure, "`print` with a formatted string needs the standard `io` module"))

pub func test_the_write_intrinsics_belong_to_standard_modules():
    let source = "pub func show(data: const u8[]):\n    Builtin.write_output(data)\n"
    let failure = semantic_failure([base_source_module("main", source)])
    assert(len(failure) > 0)
    assert(not strings.contains(failure, "WriteBytes"))
    let standard = "pub func show(data: const u8[]):\n    Builtin.write_output(data)\n    Builtin.write_error(data)\n"
    assert(len(checked([standard_base_source_module("io", standard)]).functions) == 1)
    let unknown = semantic_failure([standard_base_source_module("io", "pub func show(data: const u8[]):\n    Builtin.write_all(data)\n")])
    assert(strings.contains(unknown, "unknown Luce Base intrinsic `Builtin.write_all`"))
