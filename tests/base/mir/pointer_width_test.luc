#==============================================================================================
#
#   pointer_width_test - `usize`/`isize` stay target-neutral until a backend folds them
#
#   DESCRIPTION:
#       A Base module's pointer-width integers lower to `PointerInt`, a
#       canonical MIR type with no width of its own (base.md §5.1). The
#       layout supplies the width, so the same program checks its arithmetic
#       at 32 bits under the oracle's 4-byte rules and at 64 bits under QBE's,
#       and a constant that fits only the wider target is refused by name
#       where the width is known. Conversions wait for the Base cast family.
#
#==============================================================================================

from base.fixtures import volatile_fixture
from common.mir.lowering_support import base_lowered, base_source_module, checked_modules, module_lowering_failure, only_function
from luce.compiler.backends.interpreter import HirInterpreter
from luce.compiler.mir.lowerer import Lowerer
from luce.compiler.backends.layout import LayoutRules, TypeLayout
from luce.compiler.backends.mir_execution_model import MirValue
from luce.compiler.backends.mir_interpreter import MirInterpreter
from luce.compiler.backends.qbe import QbeBackend
from luce.compiler.backends.wasm import WasmBackend
from luce.compiler.mir.canonical import MirProgram, TypeId, bits_of, describe_mir_type, is_int_type, is_pointer_int_type, mir_type, mir_type_key
from luce.compiler.mir.freestanding import require_freestanding
import std.strings

func usize_of(program: MirProgram) -> TypeId:
    let function = only_function(program)
    for register in function.registers:
        if is_pointer_int_type(program.types, register): return register
    trap("the fixture lowered no pointer-width register")

# mark: Canonical shape ======================================================================

pub func test_usize_lowers_to_a_pointer_width_register_without_a_width():
    let program = base_lowered("pub func answer(count: usize) -> usize:\n    return count + 2\n")
    let usize = usize_of(program)
    assert(mir_type_key(mir_type(program.types, usize)) == "usize")
    assert(describe_mir_type(program.types, usize) == "usize")
    assert(is_int_type(program.types, usize))
    assert(bits_of(program.types, usize) == 0)
    require_freestanding(program) catch reason:
        trap(reason)

pub func test_isize_is_the_signed_pointer_width_integer():
    let program = base_lowered("pub func answer(delta: isize) -> isize:\n    return delta - 1\n")
    assert(describe_mir_type(program.types, usize_of(program)) == "isize")

pub func test_the_layout_gives_a_pointer_width_integer_its_width():
    let program = base_lowered("pub func answer(count: usize) -> usize:\n    return count\n")
    let usize = usize_of(program)
    let narrow = TypeLayout(program.types, LayoutRules(pointer_size = 4, pointer_align = 4))
    assert(narrow.size_of(usize) == 4)
    assert(narrow.align_of(usize) == 4)
    assert(narrow.integer_bits(usize) == 32)
    assert(narrow.uint_maximum(usize) == u64(4294967295))
    let wide = TypeLayout(program.types, LayoutRules(pointer_size = 8, pointer_align = 8))
    assert(wide.size_of(usize) == 8)
    assert(wide.integer_bits(usize) == 64)
    assert(wide.uint_maximum(usize) == u64(18446744073709551615))

# mark: Width-dependent execution ============================================================

pub func test_the_oracle_checks_usize_arithmetic_at_its_pointer_width():
    let program = base_lowered("pub func answer(count: usize) -> usize:\n    return count + 1\n")
    let arguments = [MirValue.UnsignedInt(value = u64(4294967295))]
    var narrow_failure = ""
    discard(MirInterpreter(program, LayoutRules(pointer_size = 4, pointer_align = 4)).run("main.answer", arguments)) catch reason:
        narrow_failure = reason
    assert(strings.contains(narrow_failure, "overflow"))
    let wide = MirInterpreter(program, LayoutRules(pointer_size = 8, pointer_align = 8)).run("main.answer", arguments) catch reason:
        trap(reason)
    match wide[0]:
        UnsignedInt(value): assert(value == u64(4294967296))
        else: trap("usize arithmetic answered a non-integer")

pub func test_a_constant_beyond_the_pointer_width_is_refused_where_the_width_is_known():
    let program = base_lowered("pub func answer() -> usize:\n    return 4294967296\n")
    var oracle_failure = ""
    discard(MirInterpreter(program, LayoutRules(pointer_size = 4, pointer_align = 4)).run("main.answer", list[MirValue]())) catch reason:
        oracle_failure = reason
    assert(oracle_failure == "mir interpreter: constant 4294967296 does not fit `usize` at pointer width 32")
    var wasm_failure = ""
    discard(WasmBackend().emit(program)) catch reason:
        wasm_failure = reason
    assert(wasm_failure == "wasm backend: constant 4294967296 does not fit `usize`, which is 32 bits wide on wasm32 (base.md §5.1)")
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "=l copy 4294967296"))

pub func test_backends_fold_the_pointer_width():
    let program = base_lowered("pub func answer(count: usize) -> usize:\n    return count + 2\n")
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "function l $luce_f0(l %r0)"))
    assert(strings.contains(il, "=l add %r0, %r1"))
    assert(strings.contains(il, "cultl %r2, %r0"))
    let module = WasmBackend().emit(program) catch reason:
        trap(reason)
    assert(len(module) > 8)

# mark: Deferred rules =======================================================================

pub func test_conversions_with_a_pointer_width_integer_wait_for_base_casts():
    let failure = module_lowering_failure([base_source_module("main", "pub func answer(count: u64) -> usize:\n    return usize(count)\n")])
    assert(failure == "main.lucb:2:12: lowerer does not support a numeric conversion to or from a pointer-width integer (the Base cast family, B1d) yet in `main.answer`")

# mark: Layout questions =====================================================================

func pair_source(expression: str) -> str:
    return "struct Pair:\n    let first: i64\n    let second: u8\n\npub func answer() -> usize:\n    return " + expression + "\n"

func folded(program: MirProgram, rules: LayoutRules) -> u64:
    let results = MirInterpreter(program, rules).run("main.answer", list[MirValue]()) catch reason:
        trap(reason)
    match results[0]:
        UnsignedInt(value): return value
        else: trap("a layout question answered a non-integer")

pub func test_layout_questions_stay_symbolic_until_a_backend_folds_them():
    let program = base_lowered(pair_source("sizeof(Pair) + offsetof(Pair, second) + alignof(Pair)"))
    var carries_answer = false
    for instruction in only_function(program).body:
        match instruction.form:
            LayoutConstant(result, query, subject, field): carries_answer = true
            else: pass
    assert(carries_answer)
    assert(folded(program, LayoutRules(pointer_size = 4, pointer_align = 4)) == u64(32))
    assert(folded(program, LayoutRules(pointer_size = 8, pointer_align = 8)) == u64(32))
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "=l copy 16"))
    assert(strings.contains(il, "=l copy 8"))
    discard(WasmBackend().emit(program)) catch reason:
        trap(reason)

pub func test_the_pointer_width_answers_follow_each_backend():
    let program = base_lowered(pair_source("sizeof(usize) + alignof(isize)"))
    assert(folded(program, LayoutRules(pointer_size = 4, pointer_align = 4)) == u64(8))
    assert(folded(program, LayoutRules(pointer_size = 8, pointer_align = 8)) == u64(16))
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "=l copy 8"))

pub func test_the_reference_interpreter_answers_under_its_own_rules():
    let source = pair_source("sizeof(Pair) + offsetof(Pair, second) + sizeof(usize)")
    let analyzed = checked_modules([base_source_module("main", source)])
    let narrow = HirInterpreter(LayoutRules(pointer_size = 4, pointer_align = 4)).run(analyzed, "main", "answer") catch reason:
        trap(reason)
    let wide = HirInterpreter().run(analyzed, "main", "answer") catch reason:
        trap(reason)
    assert(narrow.render() == "28")
    assert(wide.render() == "32")
    let program = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    assert(folded(program, LayoutRules(pointer_size = 4, pointer_align = 4)) == u64(28))


# mark: The nullable pointer niche ===========================================================

## `T*?` lowers to one canonical `ptr?` word, the size of a pointer, so a
## struct holding one has its C layout (base.md §5.3).
pub func test_a_nullable_pointer_is_one_word():
    let program = base_lowered("struct Node:\n    var value: i64\n    var next: Node*?\n\npub func answer(node: Node*?) -> i64:\n    if let here = node: return here.value\n    return 0\n")
    let function = only_function(program)
    var nullable: TypeId? = none
    for register in function.registers:
        if mir_type_key(mir_type(program.types, register)) == "nullable_ptr": nullable = register
    let word = nullable else trap("the parameter did not lower to a nullable pointer")
    assert(describe_mir_type(program.types, word) == "ptr?")
    let layout = TypeLayout(program.types, LayoutRules(pointer_size = 4, pointer_align = 4))
    assert(layout.size_of(word) == 4)
    # `Node` is an `i64` and one nullable word: 16 bytes under either rule set.
    var node_size = 0
    for index in range(0, len(program.types.definitions)):
        match program.types.definitions[index]:
            Struct(fields):
                if len(fields) == 2 and mir_type_key(mir_type(program.types, fields[1].value_type)) == "nullable_ptr":
                    node_size = layout.size_of(TypeId(value = u32(index)))
            else: pass
    assert(node_size == 16)
    assert(TypeLayout(program.types, LayoutRules(pointer_size = 8, pointer_align = 8)).size_of(word) == 8)


# mark: Address casts ========================================================================

## `(usize)p` and `(T*?)n` are the pointer word read as an integer and back;
## the MIR oracle, QBE, and Wasm all agree, and the reference interpreter
## refuses them by name because its addresses are places (base.md §19.3).
pub func test_address_casts_round_trip_through_the_oracle_and_backends():
    let program = base_lowered("pub func answer(first: i64*) -> usize:\n    let address = (usize)first\n    let back = (i64*?)address\n    let missing = (i64*?)0\n    if back == none or missing != none: return 0\n    return address\n")
    let results = MirInterpreter(program, LayoutRules(pointer_size = 4, pointer_align = 4)).run("main.answer", [MirValue.Ptr(value = 4096)]) catch reason:
        trap(reason)
    match results[0]:
        UnsignedInt(value): assert(value == u64(4096))
        else: trap("the address cast answered a non-integer")
    let il = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    assert(strings.contains(il, "=l copy %r0"))
    discard(WasmBackend().emit(program)) catch reason:
        trap(reason)

# mark: Volatile accesses ====================================================================

## A `volatile T*` access is a `VolatileLoad`/`VolatileStore`, never a plain
## one, and the qualifier reaches fields of the pointee (base.md §15.2).
pub func test_volatile_accesses_are_their_own_instructions():
    let program = base_lowered(volatile_fixture().source)
    var volatile_loads = 0
    var volatile_stores = 0
    for function in program.functions:
        for instruction in function.body:
            match instruction.form:
                VolatileLoad(result, value_type, address): volatile_loads += 1
                VolatileStore(value_type, address, value): volatile_stores += 1
                else: pass
    assert(volatile_loads == 5)
    assert(volatile_stores == 6)
