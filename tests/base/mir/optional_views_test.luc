#==============================================================================================
#
#   optional_views_test - `Writer?` is the view on the null-data niche
#
#   DESCRIPTION:
#       An optional interface view in a Base module lowers to the two-word
#       view itself (base.md §5.6): `none` is a null data word, so a struct
#       or global holding one keeps the layout its C definition has.
#
#==============================================================================================

from common.mir.lowering_support import base_lowered
from luce.compiler.mir.canonical import MirProgram, is_ptr_type, mir_type

pub func test_optional_view_is_two_pointer_words():
    let program = base_lowered("interface Shape:\n    func area(self) -> i64\n\nvar current: Shape? = none\n\npub func absent() -> bool:\n    return current == none\n")
    var checked = false
    for global in program.globals:
        if global.name != "main.current": continue
        match mir_type(program.types, global.value_type):
            Struct(fields):
                assert(len(fields) == 2)
                assert(is_ptr_type(program.types, fields[0].value_type) and is_ptr_type(program.types, fields[1].value_type))
            else: trap("an optional view lowered to something other than the view struct")
        checked = true
    assert(checked)
