#==============================================================================================
#
#   attributes_test - Declaration attributes reach MIR and `used` keeps a symbol
#
#   DESCRIPTION:
#       The words of base.md §9.8 ride on `MirFunction` and `MirGlobal`
#       unchanged, and the optimizer's pruning treats a `used` function or
#       global as a root while an unreferenced plain global disappears.
#
#==============================================================================================

from common.mir.lowering_support import base_lowered
from luce.compiler.mir.canonical import MirProgram
from luce.compiler.mir.optimizer import Optimizer
from luce.compiler.symbol_attributes import InlineHint

func has_global(program: MirProgram, name: str) -> bool:
    for global in program.globals:
        if global.name == name: return true
    return false

func has_function(program: MirProgram, name: str) -> bool:
    for function in program.functions:
        if function.name == name: return true
    return false

pub func test_attributes_reach_mir_and_used_survives_pruning():
    let program = base_lowered("used var kept: i64 = 3\n\nvar dropped: i64 = 4\n\nused func retained() -> i64:\n    return 5\n\nfunc forgotten() -> i64:\n    return 6\n\npub cold noinline func answer() -> i64:\n    return 1\n")
    var checked = 0
    for function in program.functions:
        if function.name == "main.answer":
            assert(function.attributes.is_cold and function.attributes.inlining == InlineHint.noinline)
            checked += 1
        if function.name == "main.retained":
            assert(function.attributes.is_used and not function.attributes.is_cold)
            checked += 1
    assert(checked == 2)
    for global in program.globals:
        if global.name == "main.kept": assert(global.attributes.is_used)
        if global.name == "main.dropped": assert(not global.attributes.is_present())
    let optimized = Optimizer(program).optimize().program
    assert(has_global(optimized, "main.kept") and not has_global(optimized, "main.dropped"))
    assert(has_function(optimized, "main.retained") and not has_function(optimized, "main.forgotten"))
    assert(has_function(optimized, "main.answer"))
