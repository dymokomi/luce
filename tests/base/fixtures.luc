#==============================================================================================
#
#   fixtures - Luce Base sources every backend must answer alike
#
#   DESCRIPTION:
#       Each fixture exports `answer` with the C convention so the oracles
#       call it by name and a native test links a C driver against it. The
#       expected value is part of the fixture: one source, one number, every
#       backend.
#
#==============================================================================================

pub struct BaseFixture:
    pub let name: str
    pub let source: str
    pub let expected: i64
    ## What the fixture prints before its answer is read.
    pub let expected_output: str = ""

## C's `//` and `%` truncate toward zero (base.md §7.2).
pub func c_division_fixture() -> BaseFixture:
    return BaseFixture(name = "c_division", expected = -312, source = "export c func answer() -> i64:\n    let a = -7\n    let b = 2\n    return (a // b) * 100 + (a % b) * 10 + (7 // -2) - (-7 % -2)\n")

## Same-signedness widening without a spelling (base.md §7.5).
pub func widening_fixture() -> BaseFixture:
    return BaseFixture(name = "widening", expected = 1250, source = "export c func answer() -> i64:\n    let small: u8 = 250\n    let count: u32 = 1000\n    let total: u64 = small + count\n    let index: usize = count\n    var extra = 1\n    if index == 1000: extra = 0\n    return i64(total) + extra\n")

## `+% -% *%` and unary `-%` wrap in two's complement (base.md §7.2).
pub func wrapping_fixture() -> BaseFixture:
    return BaseFixture(name = "wrapping", expected = 3750, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let wrapped = byte +% 10\n    let product: i32 = 65536 *% 65536\n    let negated: u8 = -%byte\n    let big: i64 = 9223372036854775807 +% 1\n    let signed: i8 = -128\n    return i64(wrapped) * 1000 + i64(product) + i64(negated) + (big -% big) + i64(-%signed) + i64(signed *% 3)\n")

## `+| -| *|` saturate at the type's bounds (base.md §7.2).
pub func saturating_fixture() -> BaseFixture:
    return BaseFixture(name = "saturating", expected = 508, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let high = byte +| 10\n    let low = byte -| 255\n    let signed: i8 = -100\n    let floor = signed -| 100\n    let ceil = signed *| -2\n    let wide: i64 = 9223372036854775807 *| 2\n    let mul_low: i64 = -9223372036854775807 *| 2\n    let product = byte *| byte\n    return i64(high) + i64(low) + i64(floor) + i64(ceil) + (wide - 9223372036854775807) + (mul_low + 9223372036854775807) + i64(product)\n")

## `+? -? *?` answer `none` on overflow (base.md §7.2).
pub func checked_fixture() -> BaseFixture:
    return BaseFixture(name = "checked", expected = 1383, source = "export c func answer() -> i64:\n    let byte: u8 = 250\n    let none_value = byte +? 10\n    let some_value = byte -? 10\n    let big = 9223372036854775807 -? -1\n    let product = 3037000500 *? 3037000500\n    let fine = 6 *? 7\n    var total = 0\n    if none_value == none: total += 1\n    total += i64(some_value else 0)\n    if big == none: total += 100\n    if product == none: total += 1000\n    total += fine else 0\n    return total\n")

## Layout questions fold to the target's C layout (base.md §5.11); the
## pointer-width terms cancel so the answer is one number on every target.
pub func layout_fixture() -> BaseFixture:
    return BaseFixture(name = "layout", expected = 42, source = "struct Span:\n    let start: usize\n    let length: usize\n\nstruct Pair:\n    let first: i64\n    let second: u8\n\nexport c func answer() -> i64:\n    let span = Span(start = 40, length = 2)\n    var total = 0\n    if span.start + span.length == 42: total += 10\n    if sizeof(Span) == 2 * sizeof(usize): total += 10\n    if offsetof(Span, start) == 0 and offsetof(Span, length) == sizeof(usize): total += 10\n    if sizeof(Pair) == 16 and offsetof(Pair, second) == 8: total += 10\n    if alignof(Pair) == 8: total += 2\n    return total\n")

## `(T)x` is C's cast with every numeric case defined (base.md §7.5).
pub func cast_fixture() -> BaseFixture:
    return BaseFixture(name = "cast", expected = 536, source = "export c func answer() -> i64:\n    let wide: i64 = 300\n    let byte = (u8)wide\n    let negative = (i8)(u8)200\n    let reinterpreted = (u32)-1\n    let truncated = (i32)-7.9\n    let saturated = (u8)300.0\n    let widened = (i64)(u32)4294967295\n    let float_value = (f64)wide\n    let narrowed_float = (f32)1.5\n    let big_sat = (i32)1e12\n    let low_sat = (i16)-1e12\n    let size = (usize)-1\n    var pointer_wide = 0\n    if size > 4294967294: pointer_wide = 1\n    return i64(byte) + i64(negative) + i64(reinterpreted) - 4294967295 + i64(truncated) + i64(saturated) + widened - 4294967295 + i64(big_sat) - 2147483647 + i64(low_sat) + 32768 + i64(float_value) + i64(narrowed_float) - 1 + pointer_wide - 1\n")

## Pointers: `&place`, `*p`, auto-dereferencing `.`, stores through `T*`, reads
## through `const T*`, and address equality (base.md §5.3, §6.6, §7.7).
pub func pointer_fixture() -> BaseFixture:
    return BaseFixture(name = "pointer", expected = 42, source = "struct Point:\n    var x: i64\n    var y: i64\n\nfunc bump(point: Point*, by: i64):\n    point.x += by\n    (*point).y = point.y + by\n\nfunc read(point: const Point*) -> i64:\n    return point.x + (*point).y\n\nexport c func answer() -> i64:\n    var point = Point(x = 1, y = 2)\n    var count: i64 = 10\n    let counter: i64* = &count\n    *counter += 5\n    bump(&point, 3)\n    let view: const Point* = &point\n    var same = 0\n    if view == &point: same = 1\n    if counter != &count: same = 100\n    return read(view) + *counter + same + count + 2\n")

## `T*?` is the null niche: one word, `none` is address zero, unwrapped like
## any optional (base.md §5.3); a linked list walked through it.
pub func nullable_fixture() -> BaseFixture:
    return BaseFixture(name = "nullable", expected = 42, source = "struct Node:\n    var value: i64\n    var next: Node*?\n\nfunc find(first: Node*?, wanted: i64) -> Node*?:\n    var current = first\n    var found: Node*? = none\n    while current != none:\n        if let here = current:\n            if here.value == wanted:\n                found = here\n                current = none\n            else: current = here.next\n    return found\n\nexport c func answer() -> i64:\n    var third = Node(value = 30, next = none)\n    var second = Node(value = 20, next = &third)\n    var first = Node(value = 10, next = &second)\n    var total = 0\n    if let hit = find(&first, 20): total += hit.value\n    if find(&first, 99) == none: total += 1\n    let missing: Node*? = none\n    if missing == none: total += 1\n    total += (find(&first, 30) else &first).value\n    return total - 10\n")

## Pointer arithmetic inside one array, `p[i]`, `p - q`, address ordering,
## and `void*` round trips (base.md §5.3, §7.7).
pub func pointer_arithmetic_fixture() -> BaseFixture:
    return BaseFixture(name = "pointer_arithmetic", expected = 42, source = "export c func answer() -> i64:\n    var values: array[i64, 4] = [1, 2, 3, 4]\n    let first: i64* = &values[0]\n    let third = first + 2\n    let back = third - 1\n    var total = *third + *back\n    total += first[3]\n    first[1] = 10\n    total += values[1]\n    let gap: i64 = third - first\n    total += gap\n    if third > first: total += 1\n    if first < third and first <= first and third >= back: total += 20\n    let untyped: void* = first\n    let again = (i64*)untyped\n    if again != first: total += 100\n    return total\n")

## Arrays as values, spans over them, checked indexing and slicing, `.length`,
## `.data`, a span from its parts, and `for` over both (base.md §5.4, §8.3).
pub func span_fixture() -> BaseFixture:
    return BaseFixture(name = "span", expected = 42, source = "func sum(items: const i64[]) -> i64:\n    var total = 0\n    for item in items: total += item\n    return total\n\nexport c func answer() -> i64:\n    var values: i64[4] = [1, 2, 3, 4]\n    let all: i64[] = values\n    all[0] = 10\n    let tail = all[1..<4]\n    let last = all[2..=3]\n    var total = sum(all)\n    total += sum(tail)\n    total += (i64)last.length\n    let view = i64[](last.data, 1)\n    total += view[0]\n    for item in values: total += item\n    for slot in &values: *slot += 1\n    for slot in &tail: *slot -= 1\n    return total - 10 + values[0] + values[1] + values[2] + values[3] - 20\n")

## `str` is a view: literals in program data, `length`, `bytes`, comparison
## by bytes, and `(str)bytes` (base.md §5.5).
pub func text_fixture() -> BaseFixture:
    return BaseFixture(name = "text", expected = 42, source = "func longer(first: str, second: str) -> str:\n    if second.length > first.length: return second\n    return first\n\nexport c func answer() -> i64:\n    let greeting = \"hello\"\n    let other = \"help\"\n    var total = 0\n    if greeting == \"hello\": total += 10\n    if greeting != other: total += 10\n    if greeting < other and other >= greeting: total += 10\n    total += (i64)longer(greeting, other).length\n    let raw: const u8[] = greeting.bytes\n    total += (i64)raw[0] - 104 + 6\n    let again = (str)raw\n    if again != greeting: total += 100\n    let accent = \"héllo\"\n    var scalars = 0\n    for character in accent: scalars += 1\n    total += (i64)accent.length - scalars\n    return total\n")

## A `var` with a written type and no initialiser is zero; `= ---` allocates
## without writing (base.md §6.1, §6.2).
pub func zero_fixture() -> BaseFixture:
    return BaseFixture(name = "zero", expected = 42, source = "struct Point:\n    var x: i64\n    var y: i64\n    var next: Point*?\n\nexport c func answer() -> i64:\n    var count: u32\n    var flag: bool\n    var buffer: u8[4]\n    var origin: Point\n    var view: i64[]\n    var scratch: i64[2] = ---\n    scratch[0] = 40\n    scratch[1] = 2\n    var total = scratch[0] + scratch[1]\n    if count == 0 and not flag: total += (i64)buffer[3]\n    if origin.next == none: total += origin.x + origin.y\n    total += (i64)view.length\n    return total\n")

## An integer-backed enum is its representation: cases are declared values,
## `|` `&` `^` `~` combine flags, `(u32)e` reads the bits, `Access(n)` checks,
## `(Access)n` does not, and `match` needs `_` (base.md §10.3).
pub func enum_fixture() -> BaseFixture:
    return BaseFixture(name = "enum", expected = 42, source = "enum Access as u32:\n    empty = 0\n    read = 1\n    write = 2\n    execute = 4\n\nfunc describe(mode: Access) -> i64:\n    match mode:\n        .empty: return 0\n        .read: return 1\n        .write: return 2\n        _: return 3\n\nexport c func answer() -> i64:\n    let mode = Access.read | Access.write\n    var total = 0\n    if (mode & Access.write) != Access.empty: total += 10\n    if (mode & Access.execute) == Access.empty: total += 10\n    let bits = (u32)mode\n    total += (i64)bits\n    let checked = Access(4)\n    if checked == Access.execute: total += 5\n    let raw = (Access)7\n    total += describe(raw)\n    total += describe(Access.read)\n    let cleared = mode & ~Access.read\n    total += describe(cleared)\n    let toggled = mode ^ Access.read\n    if toggled == cleared: total += 8\n    return total\n")

## A union stores one member at one address: writing one member and reading
## another reinterprets the bytes, through a pointer or a nested array element
## alike, and a union is zeroed as bytes (base.md §10.4).
pub func union_fixture() -> BaseFixture:
    return BaseFixture(name = "union", expected = 42, source = "struct Halves:\n    var low: u32\n    var high: u32\n\nunion Value:\n    integer: i64\n    real: f64\n    bytes: u8[8]\n    halves: Halves\n\nfunc low_byte(value: const Value*) -> i64:\n    return (i64)value.bytes[0]\n\nexport c func answer() -> i64:\n    var value = Value(integer = 258)\n    var total = low_byte(&value)\n    total += (i64)value.bytes[1]\n    value.bytes[0] = 4\n    total += value.integer - 256\n    value.real = 1.0\n    if value.halves.low == 0 and value.halves.high == 1072693248: total += 10\n    total += value.integer // 4607182418800017408\n    let pointer: Value* = &value\n    pointer.halves = Halves(low = 7, high = 0)\n    total += pointer.integer\n    var zeroed: Value\n    total += zeroed.integer + (i64)zeroed.bytes[7]\n    total += (i64)sizeof(Value) + (i64)alignof(Value)\n    (*pointer).bytes[7] = 0\n    return total + (i64)value.bytes[7] + 1\n")

## Module globals: zero without an initialiser, otherwise the constant the
## initialiser names, including a struct, an array, a union member, and the
## address of another global; `thread_local` is one cell per thread
## (base.md §6.3, §6.4).
pub func globals_fixture() -> BaseFixture:
    return BaseFixture(name = "globals", expected = 42, source = "struct Point:\n    var x: i64\n    var y: i64\n\nunion Slot:\n    integer: i64\n    bytes: u8[8]\n\nvar counter: i64\nvar seed: u32 = 2654435769\nthread_local var depth: i64 = 3\npub let limit: usize = 16 * 4\nvar origin: Point = Point(x = 1, y = 2)\nvar table: i64[3] = [4, 5, 6]\nvar cursor: i64* = &counter\nvar slot: Slot = Slot(integer = 258)\nvar flag: bool = true\nvar ratio: f64 = 0.5\nvar word: usize = sizeof(i64)\n\nfunc bump() -> i64:\n    counter += 1\n    return counter\n\nexport c func answer() -> i64:\n    var total = bump() + bump()\n    total += (i64)(seed % 10)\n    total += depth\n    total += origin.x + origin.y\n    total += table[0] + table[2]\n    *cursor += 10\n    total += counter\n    total += (i64)limit // 32\n    total += (i64)slot.bytes[1]\n    if flag and ratio == 0.5: total += 1\n    total += (i64)word - 8\n    return total - 2\n")

## Labeled `break`/`continue` leave nested loops and a guarded match arm
## asks its condition after the pattern binds (base.md §8.4, §8.5).
pub func control_fixture() -> BaseFixture:
    return BaseFixture(name = "control", expected = 42, source = "func find(limit: i64) -> i64:\n    var found = -1\n    rows: for y in 0..<limit:\n        for x in 0..<limit:\n            if x * y == 6:\n                found = x * 10 + y\n                break rows\n    return found\n\nfunc classify(value: i64) -> i64:\n    match value:\n        _ if value < 0: return 0\n        0: return 1\n        _ if value % 2 == 0: return 2\n        _: return 3\n\nexport c func answer() -> i64:\n    var total = find(4)\n    total += classify(-5) + classify(0) + classify(4) + classify(7) + classify(10)\n    var skipped = 0\n    outer: for i in 0..<3:\n        for j in 0..<3:\n            if j == 1: continue outer\n            skipped += 1\n    return total + skipped - 1\n")

## Failure in Base (base.md §11.2–11.4, §8.8): `error(code, "text")` with a
## view message, `try` propagation, `catch` reading the code and the
## message, `recover`, `else error(...)`, and `errdefer` beside `defer`.
pub func failure_fixture() -> BaseFixture:
    return BaseFixture(name = "failure", expected = 42, source = "let boom: ErrorCode = ErrorCode.package(1)\nlet other: ErrorCode = ErrorCode.package(2)\n\nfunc note(log: i64*, amount: i64):\n    *log += amount\n\nfunc risky(fail: bool, log: i64*) -> i64!:\n    errdefer note(log, 100)\n    defer note(log, 1)\n    if fail: error(boom, \"boom\")\n    return 5\n\nfunc relay(fail: bool, log: i64*) -> i64!:\n    let value = try risky(fail, log)\n    return value + 1\n\nfunc attempt(fail: bool, log: i64*) -> i64:\n    let value = relay(fail, log) catch failure:\n        if failure.code == boom and failure.message.length == 4: return -1\n        return -50\n    return value\n\nfunc pick(value: i64?) -> i64!:\n    return value else error(other, \"missing\")\n\nexport c func answer() -> i64:\n    var log = 0\n    var total = attempt(false, &log)\n    total += attempt(true, &log)\n    total += log - 102\n    let present: i64? = 30\n    let picked = pick(present) catch failure:\n        return 0\n    total += picked\n    let missing: i64? = none\n    let fallback = pick(missing) catch failure:\n        if failure.code == other and failure.code != boom: total += 7\n        recover 0\n    return total + fallback\n")

## `packed struct` removes padding, `align(N) struct` raises a record's
## alignment, and `align(N)` before a field raises that field's; a packed
## field of alignment one may still be addressed (base.md §5.11).
pub func layout_words_fixture() -> BaseFixture:
    return BaseFixture(name = "layout_words", expected = 42, source = "packed struct Header:\n    var tag: u8\n    var length: u32\n    var flag: u8\n\nalign(16) struct Line:\n    var first: u8\n    var second: u8\n\nstruct Mixed:\n    var a: u8\n    align(8) var b: u8\n    var c: u8\n\nexport c func answer() -> i64:\n    var total = (i64)sizeof(Header)\n    total += (i64)offsetof(Header, length)\n    total += (i64)offsetof(Header, flag)\n    total += (i64)alignof(Line) + (i64)sizeof(Line)\n    total += (i64)offsetof(Mixed, b)\n    total += (i64)sizeof(Mixed)\n    var header: Header = Header(tag = 1, length = 300, flag = 2)\n    total += (i64)header.length - 300 + (i64)header.flag\n    let flag_pointer: u8* = &header.flag\n    total += (i64)*flag_pointer\n    return total - 30\n")

## An interface value is a two-word view of a conformer formed from `T*`:
## calls dispatch through a static witness table, a `mutating` requirement
## writes the conformer back, and views copy freely (base.md §14.3).
pub func views_fixture() -> BaseFixture:
    return BaseFixture(name = "views", expected = 42, source = "interface Shape:\n    func area(self) -> i64\n    mutating func grow(self, by: i64)\n\nstruct Square implements Shape:\n    var side: i64\n\n    pub func area(self) -> i64: return self.side * self.side\n    pub mutating func grow(self, by: i64): self.side += by\n\nstruct Rect implements Shape:\n    var width: i64\n    var height: i64\n\n    pub func area(self) -> i64: return self.width * self.height\n    pub mutating func grow(self, by: i64): self.width += by\n\nfunc total_area(shapes: Shape[]) -> i64:\n    var total = 0\n    for shape in shapes: total += shape.area()\n    return total\n\nexport c func answer() -> i64:\n    var square = Square(side = 3)\n    var rect = Rect(width = 2, height = 4)\n    let first: Shape = &square\n    let second: Shape = &rect\n    first.grow(1)\n    second.grow(2)\n    var total = first.area() + second.area()\n    total += square.side + rect.width\n    let views: Shape[2] = [first, second]\n    total += total_area(views) - 32 + 2\n    return total\n")

## Every scalar access through `volatile T*` is an observable load or store,
## whether the pointee itself or a field of it (base.md §15.2).
pub func volatile_fixture() -> BaseFixture:
    return BaseFixture(name = "volatile", expected = 42, source = "struct Device:\n    var control: u32\n    var status: u8\n    var reading: f64\n\nfunc poke(device: volatile Device*) -> i64:\n    device.control = 5\n    device.control += 2\n    device.status = 9\n    device.reading = 1.5\n    return (i64)device.control + (i64)device.status\n\nexport c func answer() -> i64:\n    var cell: u32 = 3\n    let register: volatile u32* = &cell\n    *register = 10\n    *register += 4\n    var total = (i64)*register\n    var device: Device = Device(control = 0, status = 0, reading = 0.0)\n    total += poke(&device)\n    if device.reading == 1.5: total += 12\n    return total\n")

## An `@T` location: plain reads and `=` are sequentially consistent, the
## compound operators are the read-modify-write instructions, and the
## methods name their order; `cas` answers whether it exchanged and what it
## saw (base.md §15.1).
pub func atomics_fixture() -> BaseFixture:
    return BaseFixture(name = "atomics", expected = 42, source = "struct Counter:\n    var hits: @u64\n\nvar ready: @bool\nvar seen: @i64 = 5\n\nfunc bump(counter: Counter*) -> i64:\n    counter.hits += 3\n    let previous = counter.hits.add(2, .relaxed)\n    counter.hits.set(8)\n    return (i64)previous\n\nexport c func answer() -> i64:\n    var counter = Counter(hits = 1)\n    var total = bump(&counter)\n    total += (i64)counter.hits\n    ready = true\n    if ready: total += 1\n    ready.store(false, .release)\n    if not ready.load(.acquire): total += 1\n    seen -= 2\n    total += seen\n    let swapped = seen.swap(10)\n    total += swapped\n    let (exchanged, observed) = seen.cas(10, 20, .acq_rel, .acquire)\n    if exchanged: total += observed\n    let (failed, seen_now) = seen.cas(99, 1)\n    if not failed: total += seen_now - 14\n    return total\n")

## `new`, `alloc`, and `free` through the current allocator that `with` sets,
## with `memory.exhausted` when a `FixedBuffer` runs out (base.md §12.2, §12.3).
pub func allocation_fixture() -> BaseFixture:
    return BaseFixture(name = "allocation", expected = 42, source = "import memory\n\nstruct Node:\n    var value: i64\n    var next: Node*?\n\nfunc push(head: Node*?, value: i64) -> Node*?!:\n    let node = try new Node(value = value, next = head)\n    return node\n\nfunc total(head: Node*?) -> i64:\n    var sum = 0\n    var current = head\n    while current != none:\n        if let node = current:\n            sum += node.value\n            current = node.next\n    return sum\n\nfunc build(count: i64) -> i64!:\n    var head: Node*? = none\n    for index in 0..<count: head = try push(head, index + 1)\n    let numbers = try new i64[3]\n    numbers[0] = 5\n    numbers[2] = 7\n    let scratch = try alloc u8[16]\n    scratch[0] = 3\n    let raw = try alloc(8, 8)\n    raw[1] = 1\n    let sum = total(head) + numbers[0] + numbers[1] + numbers[2] + (i64)scratch[0] + (i64)raw[1]\n    free(numbers)\n    free(scratch)\n    free(raw)\n    return sum\n\nexport c func answer() -> i64:\n    var backing: u8[512]\n    var buffer = memory.FixedBuffer.over(backing)\n    var total = 0\n    with buffer:\n        total += build(4) catch failure:\n            return -1\n    var small: u8[32]\n    var tiny = memory.FixedBuffer.over(small)\n    with tiny:\n        let refused = build(4) catch failure:\n            if failure.code == memory.exhausted: total += 16\n            recover 0\n        total += refused\n    return total\n")

pub func atomic_extremes_fixture() -> BaseFixture:
    return BaseFixture(name = "atomic_extremes", expected = 42, source = "import atomic\n\nvar high: @i64 = 5\nvar low: @u32 = 9\nvar depth: @i64 = -3\nvar wide: @u32 = 4000000000\n\nexport c func answer() -> i64:\n    atomic.fence(.seq_cst)\n    let before = high.max(10)\n    atomic.fence(.signal)\n    let unchanged = high.max(3)\n    let small = low.min(4, .relaxed)\n    let kept = low.min(7)\n    let negative = depth.max(-8)\n    let big = wide.max(1)\n    var total = before + unchanged + high + (i64)small + (i64)kept + (i64)low + negative - depth\n    total += (i64)wide - 4000000000 + (i64)big - 4000000000\n    return total\n")

pub func volatile_array_fixture() -> BaseFixture:
    return BaseFixture(name = "volatile_array", expected = 42, source = "struct Regs:\n    var slots: u32[4]\n    var mode: u8\n\nfunc fill(regs: volatile Regs*) -> i64:\n    regs.slots[0] = 10\n    regs.slots[1] = 20\n    regs.slots[1] += 5\n    regs.mode = 7\n    return (i64)regs.slots[0] + (i64)regs.slots[1] + (i64)regs.mode\n\nexport c func answer() -> i64:\n    var regs = Regs(slots = [0, 0, 0, 0], mode = 0)\n    return fill(&regs)\n")

pub func optional_views_fixture() -> BaseFixture:
