    return BaseFixture(name = "formatting", expected = 42, expected_output = "n -7 u 300 flag true letter é word hello\nbytes 5 code 233\n[n=-7] 4\ndirect -7\nfull\n", source = "import io\n\nexport c func answer() -> i64:\n    let n: i32 = -7\n    let u: u16 = 300\n    let flag = true\n    let letter = 'é'\n    let word = \"hello\"\n    print(f\"n {n} u {u} flag {flag} letter {letter} word {word}\")\n    print(f\"bytes {word.length} code {u32(letter)}\")\n    var buffer: u8[16]\n    let text = format(buffer, f\"n={n}\") catch reason:\n        return 1\n    print(f\"[{text}] {text.length}\")\n    io.stdout().write(f\"direct {n}\\n\") catch reason:\n        return 2\n    var small: u8[3]\n    let overflow = format(small, f\"n={n}\") catch reason:\n        print(f\"full\")\n        return 42\n    print(f\"unexpected {overflow}\")\n    return 3\n")

