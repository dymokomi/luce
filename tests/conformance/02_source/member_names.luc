## §2.4: a member, a field, a method or a case, may take any name but a reserved word, a
## core name too, since it is always reached through its value or its type.
enum Token:
    int(value: int)
    str(text: str)
    list

struct Report:
    var print: str
    var error: int = 0
    let list: list[int] = []

    func str(self) -> str:
        return f"{self.print}: {self.error} errors"

    func hash(self) -> int:
        return self.error

class Log:
    var lines: list[str] = []

    func print(self, line: str):
        self.lines.append(line)

func describe(t: Token) -> str:
    match t:
        .int(value): return f"int {value}"
        .str(text): return f"str {text}"
        .list: return "list"

pub func main(arguments: list[str]) -> int!:
    var r = Report(print = "build")
    r.error = 2
    print(r.str(), r.list, r.hash())
    let log = Log()
    log.print("one")
    log.print("two")
    print(log.lines)
    print(describe(Token.int(value = 3)), describe(Token.str(text = "a")), describe(Token.list))
    return 0
