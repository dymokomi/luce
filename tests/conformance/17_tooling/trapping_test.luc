# §17.3: a trap in a test, here an index out of range in a function it calls, ends the run:
# the test is reported as failed, the trap follows, then the tally of the tests run so far;
# the tests after it do not run, in the interpreter and in a built runner alike.
func third(items: list[int]) -> int:
    return items[2]

test "two and two":
    assert(2 + 2 == 4)

test "a false assert names its condition":
    assert(1 + 1 == 3, "arithmetic")

test "reads past the end":
    _ = third([1, 2])

test "never reached":
    assert(true)
