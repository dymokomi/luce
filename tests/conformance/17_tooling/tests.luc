# §17.3: `luce test` runs every `test` and reports each with its name, a failing one with
# its position and message, then the counts; the report is the same from the interpreter
# and from a built runner.
let bad = ErrorCode.package(1)

func parse(text: str) -> int!:
    if text.length == 0:
        error(bad, "empty")
    return text.length

test "a text parses to its length":
    assert(try parse("abc") == 3)

test "an empty text fails":
    let n = parse("") catch failure:
        assert(failure.message == "empty")
        recover -1
    assert(n == -1)

test "a failing test is reported":
    discard(try parse(""))

test "lists work":
    let xs = [1, 2, 3]
    assert(xs.length == 3, "three")
