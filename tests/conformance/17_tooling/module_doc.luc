# §17.4: the `##` lines opening a file with a blank line after them document the module;
# the next run documents the declaration below it.
## Shapes and their areas.

## A rectangle.
pub struct Rect:
    pub let width: float
    pub let height: float

## The area of `r`.
pub func area(r: Rect) -> float:
    return r.width * r.height

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    print(area(Rect(width = 2.0, height = 3.0)))
    return 0
