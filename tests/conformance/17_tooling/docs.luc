# §17.4: `luce doc` prints the public declarations with their doc comments, the `##` lines
# directly above each, members included; what is not `pub` is left out.
## A point on the plane.
## Two integers.
pub struct Point:
    ## Across.
    pub var x: int
    pub var y: int

    ## The point moved along x.
    pub func moved(self, dx: int) -> Point:
        return Point(x = self.x + dx, y = self.y)

## The sides of a coin.
pub enum Side:
    ## Heads up.
    heads
    tails

## What a shape can say of itself.
pub interface Shape:
    ## Its area.
    func area(self) -> float

## The origin.
pub let origin: Point = Point(x = 0, y = 0)

## Adds one.
pub func inc(n: int) -> int:
    return n + 1

func hidden() -> int:
    return 0

pub func main(arguments: list[str]) -> int!:
    return 0
