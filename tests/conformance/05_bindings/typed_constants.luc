# A top-level `let` may name its type, with type arguments too: that type is not a list
# of type parameters. Text inside a constant tuple or struct is immortal, as it stands.
struct Point:
    var x: int
    var y: int

struct Label:
    var text: str
    var at: Point

let count: int = 5
let maybe: int? = none
let pair: (int, str) = (2, "b")
let origin: Point = Point(x = 1, y = 2)
let label = Label(text = "home", at = Point(x = 3, y = 4))

pub func main(arguments: list[str]) -> int!:
    print(f"{count} {maybe == none} {pair.1} {origin.y}")
    let copy = label
    print(f"{copy.text} {label.text} {label.at.x}")
    return 0
