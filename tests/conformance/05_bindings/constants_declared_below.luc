# a function may read a module constant declared below it, and one constant another below
# it (§15.3); only a constant that reaches itself is refused
func check(condition: bool, what: str) -> unit!:
    if not condition:
        error(failed, what)

let failed = ErrorCode.package(90)
let total = base + 1
let base = 41

pub func main(arguments: list[str]) -> int!:
    check(true, "ok")
    print(f"{total}")
    return 0
