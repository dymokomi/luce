# §5.3: the place is evaluated before the value, so a store lands in the object the place
# named even when the value's own code replaces it, and that object lives to the end of the
# statement. (Compiled programs once wrote the field of a freed object, and put a reference
# into the new object where the interpreter put it into the old.)
class Child:
    let id: int
    var mark: int = 0
    var peer: Child? = none

    func init(self, id: int):
        self.id = id

    func deinit(self):
        var peer = 0
        if let p = self.peer:
            peer = p.id
        print(f"gone child {self.id} mark {self.mark} peer {peer}")

class Holder:
    var child: Child
    var items: list[Child] = []
    var table: map[str, Child] = {}
    var next_id: int = 1

    func init(self):
        self.child = Child(0)

    func fresh(self) -> Child:
        self.next_id += 1
        return Child(self.next_id * 10)

    func replace(self) -> int:
        self.child = self.fresh()
        return 7

    func replace_peer(self) -> Child:
        self.child = self.fresh()
        return Child(99)

    func refill(self) -> Child:
        self.items = [self.fresh()]
        return self.fresh()

    func retable(self) -> Child:
        self.table = {"a": self.fresh()}
        return self.fresh()

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let h = Holder()
    print("- a number into the replaced object")
    h.child.mark = h.replace()
    print("now", h.child.id, h.child.mark)
    print("- a reference into the replaced object")
    h.child.peer = h.replace_peer()
    print("now", h.child.id, h.child.peer == none)
    print("- an element of the replaced list")
    h.items = [h.fresh(), h.fresh()]
    h.items[1] = h.refill()
    print("now", h.items.length, h.items[0].id)
    print("- an entry of the replaced map")
    h.table["b"] = h.retable()
    print("now", h.table.length)
    print("- end")
    return 0
