## §5.3, §6.1: the place is evaluated before the value, once; a counter read from both
## sides shows the order in every execution, for elements, keys, fields and tuples.
class Counter:
    var n: int = 0

    func init(self):
        discard(0)

    func next(self) -> int:
        self.n += 1
        return self.n

    func name(self) -> str:
        return f"n{self.next()}"

class Holder:
    var n: int = 0
    var text: str = ""

    func init(self):
        discard(0)

func pick(c: Counter, h: Holder) -> Holder:
    discard(c.next())
    return h

pub func main(arguments: list[str]) -> int!:
    let c = Counter()
    var nums = [0, 0, 0]
    nums[c.next() % 3] = c.next()
    nums[c.next() % 3] = c.next()
    print(nums)
    var words = ["a", "b", "c"]
    words[c.next() % 3] = c.name()
    words[c.next() % 3] = c.name() + "!"
    print(words)
    var ages: map[str, int] = {}
    ages[c.name()] = c.next()
    ages[c.name()] = c.next()
    print(ages)
    var texts: map[int, str] = {}
    texts[c.next()] = c.name()
    print(texts)
    let h = Holder()
    pick(c, h).n = c.next()
    pick(c, h).text = c.name()
    print(h.n, h.text)
    nums[c.next() % 3] += c.next()
    words[c.next() % 3] += c.name()
    print(nums, words)
    var a = 0
    var b = 0
    (a, nums[c.next() % 3]) = (c.next(), c.next())
    (b, words[c.next() % 3]) = (c.next(), c.name())
    print(a, b, nums, words)
    print(c.n)
    return 0
