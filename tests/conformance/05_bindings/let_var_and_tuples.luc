## §5: `let` binds once, `var` again with the same type; a `let` struct is immutable through
## and through, a `var` struct's fields change; tuples destructure; compound assignment.
struct Point:
    var x: int
    var y: int

pub func main(arguments: list[str]) -> int!:
    let limit = 10
    var count = 0
    count += 3
    count *= 2
    count -= 1
    count //= 2
    count **= 3
    var p = Point(x = 1, y = 2)
    p.x = 5
    let q = p
    p.y = 9
    let (quotient, remainder) = (17 // 5, 17 % 5)
    var (a, b) = (1, 2)
    (a, b) = (b, a)
    print(limit, count, p.x, p.y, q.x, q.y, quotient, remainder, a, b)
    return 0
