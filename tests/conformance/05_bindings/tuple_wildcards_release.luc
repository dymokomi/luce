# A `_` in a tuple pattern lets its part go: an object there is released, on any thread,
# whether the pattern is a `let` or a `for`, and in any position.
class Box:
    let value: int
    func init(self, value: int):
        self.value = value

func work(rounds: int) -> int:
    let entries: list[(Box, int)] = []
    for round in 0..<rounds:
        entries.append((Box(round), round))
    var total = 0
    for entry in entries:
        let (_, key) = entry
        total += key
    for (_, key) in entries:
        total += key
    let (box, _) = entries[0]
    total += box.value
    return total

pub func main(arguments: list[str]) -> int!:
    let job = spawn work(3)
    print(f"total {wait job}")
    print(f"again {work(4)}")
    return 0
