## §6.5: `int(s)` and `float(s)` read a decimal with spaces around it and nothing else; any
## other text fails, with the message the same in every execution. `int(s, base)` reads as
## Python's int: a prefix matching the base, and `_` between digits.
func show(text: str):
    let f = float(text) catch failure:
        print(f"[{text}] float fails: {failure.message}")
        return
    print(f"[{text}] float {f}")

func show_int(text: str):
    let i = int(text) catch failure:
        print(f"[{text}] int fails: {failure.message}")
        return
    print(f"[{text}] int {i}")

func show_base(text: str, base: int):
    let i = int(text, base) catch failure:
        print(f"[{text}] base {base} fails: {failure.message}")
        return
    print(f"[{text}] base {base}: {i}")

pub func main(arguments: list[str]) -> int!:
    for text in ["1.5", "-0.25", " 2.5 ", "1e3", "2.5E-2", ".5", "5.", "7", "+3", "1.2.3", "abc", "", " ", "1e", "e5", "-", ".", "1,5", "inf", "nan", "0x10", "1 2"]:
        show(text)
    for text in ["42", "-7", " 3 ", "+3", "12x", "", "1.0", "1e3", "-", "0x10", "1 2"]:
        show_int(text)
    for text in ["1_000", "1__0", "_1", "1_", "007", "9223372036854775807", "9223372036854775808", "-9223372036854775808"]:
        show_int(text)
    for (text, base) in [("ff", 16), ("0xFF", 16), (" 0x_ff ", 16), ("0b101", 2), ("0b101", 16), ("0o17", 8), ("17", 8), ("18", 8), ("z", 36), ("Zz", 36), ("0x10", 10), ("-101", 2), ("", 2)]:
        show_base(text, base)
    print(int("ff", base = 16))
    return 0
