## §4.4: structural equality on values, ordering on numbers, texts, bytes and tuples.
struct Point:
    var x: int
    var y: int

enum Kind:
    plain
    tagged(label: str)

pub func main(arguments: list[str]) -> int!:
    let a = Point(x = 1, y = 2)
    let b = Point(x = 1, y = 2)
    let c = Point(x = 2, y = 1)
    print(a == b, a != c, (1, "a") == (1, "a"), (1, "a") < (1, "b"))
    print(Kind.tagged(label = "x") == Kind.tagged(label = "x"), Kind.plain == Kind.tagged(label = "x"))
    print("abc" < "abd", "b" > "abc", b"\x01" < b"\x02", 2.5 >= 2.5)
    let o: int? = 3
    let p: int? = none
    print(o == 3, p == none, o != none, o == p)
    return 0
