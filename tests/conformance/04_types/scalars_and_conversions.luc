## §4.1, §6.5: the scalars never convert implicitly; `int`, `float`, `str` and `bool` convert
## explicitly, and the parsing ones can fail.
pub func main(arguments: list[str]) -> int!:
    let i = 7
    let f = float(i) / 2.0
    let back = int(3.99)
    let neg = int(-3.99)
    let parsed = try int(" 42 ")
    let real = try float("2.5")
    let flag = try bool("true")
    let shown = str(i) + str(f) + str(flag)
    let missing = int("x") catch failure:
        recover -1
    print(f, back, neg, parsed, real, flag, shown, missing)
    return 0
