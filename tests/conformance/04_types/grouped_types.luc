# §4.2: parentheses group a type, so an optional function whose result is neither optional
# nor fallible is `(func() -> int)?`, where `func() -> int?` is a function answering `int?`;
# `(T)` alone is `T`, and a tuple keeps its comma.
class Node:
    var hook: (func() -> int)? = none
    var pair: ((int, str))? = none

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let n = Node()
    let answer: func() -> int? = func () -> int?:
        return none
    print(n.hook == none, n.pair == none, answer() == none)
    n.hook = func () -> int:
        return 3
    n.pair = (1, "one")
    if let h = n.hook:
        print(h())
    if let p = n.pair:
        print(p.1)
    let grouped: (int) = 4
    let hooks: list[(func(int) -> int)?] = [none, func (x: int) -> int:
        return x * 2]
    for hook in hooks:
        if let f = hook:
            print(f(grouped))
        else:
            print("no hook")
    return 0
