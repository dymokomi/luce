# §6.7: a bracket after a name holds type arguments only when it holds types; one holding a
# value, parenthesised or not, is an index, also when a member or a call follows it, and
# also as a call's argument.
class V:
    pub var x: float

    pub func init(self, x: float):
        self.x = x

    pub func scaled(self, k: float) -> V:
        return V(self.x * k)

func g(v: V) -> float:
    return v.x

func f(x: float) -> float:
    return x

pub func main(arguments: list[str]) -> int!:
    let a = [V(1.0), V(2.0), V(3.0)]
    let k = 0
    print(g(a[(k + 1) % 3].scaled(2.0)), f(a[(k + 2)].x), f(a[(k)].x), f(a[k].scaled(3.0).x))
    return 0
