## §6.2, §6.7: `& | ^ ~ << >>` on `int` as Python has them: two's complement for negative
## values, `>>` arithmetic (it floors, so a negative value ends at -1), `<<` checked like
## `*`; their precedence is Python's, below `+ -` and above the comparisons.
pub func main(arguments: list[str]) -> int!:
    print(6 & 3, 6 | 3, 6 ^ 3, ~5, ~-1)
    print(-6 & 3, -6 | 3, -6 ^ 3)
    print(1 << 10, -3 << 2, 1 << 62, -1 << 63)
    print(1024 >> 3, -1024 >> 3, -1 >> 70, 5 >> 64, -7 >> 1)
    print(1 + 2 << 3, 1 << 2 + 3, 6 & 3 | 8, 1 | 6 & 3, 5 ^ 1 | 2, 2 * 3 & 7)
    print(1 < 2 | 0)
    var x = 12
    x &= 10
    x |= 1
    x ^= 3
    x <<= 2
    x >>= 1
    print(x)
    return 0
