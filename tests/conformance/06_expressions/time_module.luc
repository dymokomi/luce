## §6.8: `time.sleep` waits at least the seconds it is given, an `int` or a `float`, through
## Base's thread sleep; `time.now` counts nanoseconds that never go backwards, and
## `time.unix` whole seconds since the epoch.
import time
from time import sleep

pub func main(arguments: list[str]) -> int!:
    let start = time.now()
    time.sleep(0.02)
    sleep(0)
    let elapsed = time.now() - start
    print(elapsed >= 20000000, time.now() >= start, time.unix() > 1600000000)
    return 0
