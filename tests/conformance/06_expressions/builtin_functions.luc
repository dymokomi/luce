## §2.4: the built-in functions, as Python's: `abs`, `min` and `max` of two ordered values,
## `round` half to even on the exact decimal, `ord` and `chr` of one scalar.
struct Version: Equatable, Ordered:
    let major: int
    let minor: int

    func compare(self, other: Version) -> int:
        if self.major != other.major:
            return self.major - other.major
        return self.minor - other.minor

    func equals(self, other: Version) -> bool:
        return self.compare(other) == 0

pub func main(arguments: list[str]) -> int!:
    print(abs(-5), abs(5), abs(0), abs(-2.5), abs(-0.0), abs(9223372036854775807))
    print(min(3, 1), max(3, 1), min(2.5, -1.0), max("pear", "apple"), min((1, "b"), (1, "a")))
    let a = Version(major = 1, minor = 2)
    let b = Version(major = 1, minor = 10)
    print(max(a, b).minor, min(a, b).minor, max(a, Version(major = 1, minor = 2)) == a)
    print(round(2.5), round(3.5), round(-2.5), round(2.675, 2), round(0.125, 2), round(0.375, 2))
    print(round(1234.5678, 1), round(1234.5678, -2), round(-0.4), round(1e300, 2), round(5e-324, 400))
    print(round(0.5, digits = 0), round(1.0 / 3.0, 5))
    print(ord("a"), ord("é"), ord("😀"), chr(97), chr(233), chr(128512), chr(0x1F600) == "😀")
    var text = ""
    for code in 72..=76:
        text = text + chr(code)
    print(text)
    return 0
