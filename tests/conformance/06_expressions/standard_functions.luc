import math
import text

## §6.8: the standard modules' functions, as Python's built-ins: `math.abs`, `math.min` and
## `math.max` of two ordered values, `math.round` half to even on the exact decimal,
## `text.code_of` and `text.from_code` of one scalar.
struct Version: Equatable, Ordered:
    let major: int
    let minor: int

    func compare(self, other: Version) -> int:
        if self.major != other.major:
            return self.major - other.major
        return self.minor - other.minor

    func equals(self, other: Version) -> bool:
        return self.compare(other) == 0

pub func main(arguments: list[str]) -> int!:
    print(math.abs(-5), math.abs(5), math.abs(0), math.abs(-2.5), math.abs(-0.0), math.abs(9223372036854775807))
    print(math.min(3, 1), math.max(3, 1), math.min(2.5, -1.0), math.max("pear", "apple"), math.min((1, "b"), (1, "a")))
    let a = Version(major = 1, minor = 2)
    let b = Version(major = 1, minor = 10)
    print(math.max(a, b).minor, math.min(a, b).minor, math.max(a, Version(major = 1, minor = 2)) == a)
    print(math.round(2.5), math.round(3.5), math.round(-2.5), math.round(2.675, 2), math.round(0.125, 2), math.round(0.375, 2))
    print(math.round(1234.5678, 1), math.round(1234.5678, -2), math.round(-0.4), math.round(1e300, 2), math.round(5e-324, 400))
    print(math.round(0.5, digits = 0), math.round(1.0 / 3.0, 5))
    print(text.code_of("a"), text.code_of("é"), text.code_of("😀"), text.from_code(97), text.from_code(233), text.from_code(128512), text.from_code(0x1F600) == "😀")
    var word = ""
    for code in 72..=76:
        word = word + text.from_code(code)
    print(word)
    return 0
