## §6.2, §6.3, §6.7: checked `int` arithmetic, Python's `/`, `//`, `%` and `**`, `float`
## arithmetic, precedence, `and`/`or`/`not`, `in`, the conditional expression.
pub func main(arguments: list[str]) -> int!:
    print(7 + 2 * 3, (7 + 2) * 3, 7 / 2, 7 // 2, -7 // 2, 7 % 3, -7 % 3, 7 % -3, 2 ** 10, -2 ** 2)
    print(7.0 / 2.0, 7.5 // 2.0, 7.5 % 2.0, 2.0 ** 0.5 > 1.41, 1e300 * 10.0 > 1e300)
    print(not 1 == 2, 1 < 2 and 2 < 3, false or 3 > 2, "ell" in "hello", 3 in 0..<5, 5 in 0..<5, 5 in 0..=5)
    let sign = -1 if -5 < 0 else 1
    print(sign, "yes" if sign < 0 else "no")
    var text = "a"
    text += "b"
    print(text + "c", text == "ab")
    return 0
