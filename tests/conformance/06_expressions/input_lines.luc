import console

## §6.8: `console.read_line(prompt)` writes the prompt, reads a line of standard input
## without its line end (and a `\r` before it), and answers `none` at the end of the input.
pub func main(arguments: list[str]) -> int!:
    var count = 0
    while let line = console.read_line(f"{count + 1}> "):
        count += 1
        print(f"[{line}] {line.length}")
    print("")
    print(console.read_line() == none, count)
    return 0
