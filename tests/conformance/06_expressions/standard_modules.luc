## §6.8: Luce's own modules are imported by name, whole or a function at a time, and their
## functions are called; the names they took from the core are ordinary names again.
import console
import math
from math import round as rounded
from text import code_of

## A function of the program may be called `abs`: `math.abs` is the module's.
func abs(n: int) -> str:
    return f"|{n}|"

func parse(s: str) -> int!:
    return int(s)

## `_ = value` computes a value and drops it; a failure propagates as a binding's would.
func check(s: str) -> int!:
    _ = parse(s)
    return 1

pub func main(arguments: list[str]) -> int!:
    let min = math.min(4, 9)
    let max = math.max(2.5, -1.0)
    print(min, max, math.abs(-7), abs(-7), rounded(2.675, 2), code_of("A"))
    let attempt = check("x") catch failure:
        recover 0
    print(check("12"), attempt)
    _ = [1, 2, 3]
    let name = console.read_line("name? ") else "nobody"
    print(f"hello {name}")
    return 0
