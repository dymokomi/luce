# Widening changes the calling convention through a retained adapter. Exercise
# scalar, unit and aggregate returns, captured cells and bound receiver lifetime.
class Label:
    let text: str

    func init(self, text: str):
        self.text = text

    func read(self) -> str:
        return self.text

    func deinit(self):
        print("drop", self.text)

func greeting() -> str:
    return "hello"

func done():
    print("done")

func pair(a: int, b: str) -> (int, str):
    return (a + 1, b + "!")

func bound() -> func() -> str!:
    let label = Label("retained")
    return label.read

func run() -> unit!:
    let named: func() -> str! = greeting
    let notify: func() -> unit! = done
    let aggregate: func(int, str) -> (int, str)! = pair
    let read = bound()
    var count = 0
    let increment: func(int) -> int = (amount) => count + amount
    let widened: func(int) -> int! = increment
    count = 4
    let copies = [widened, widened]
    print(try named(), try read(), try aggregate(2, "tuple"))
    print(try copies[0](3), try copies[1](5))
    try notify()

pub func main(arguments: list[str]) -> int!:
    try run()
    print(try Result[str].capture(greeting).get())
    return 0
