# §7.1, §10.1: a parameter or a field may default to an empty `[]` or `{}`; each call or
# construction that omits it gets its own, so what one call appends another never sees.
class Document:
    let title: str
    var pages: list[str] = []
    var tags: map[str, int] = {}

    func init(self, title: str):
        self.title = title

func collect(item: str, into: list[str] = [], counts: map[str, int] = {}) -> list[str]:
    into.append(item)
    counts[item] = into.length
    return into

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let first = Document("a")
    let second = Document("b")
    first.pages.append("intro")
    first.tags["draft"] = 1
    print(first.pages, second.pages, first.tags.length, second.tags.length)
    print(collect("x"), collect("y"))
    let kept = ["w"]
    print(collect("z", kept), kept)
    return 0
