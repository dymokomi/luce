# §7.4: a named function, a bound method and a lambda are function values. An expression
# lambda takes its types from the context; a block lambda writes them. A lambda captures
# what it reads: a `let` by copy, an object shared, a `var` as one cell shared with its
# scope, so a captured counter counts.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

    pub func greet(self, who: str) -> str:
        return f"{self.name} greets {who}"

func apply(f: func(int) -> int, x: int) -> int:
    return f(x)

func twice(n: int) -> int:
    return n * 2

func make_counter() -> func() -> int:
    var count = 0
    return func () -> int:
        count += 1
        return count

func adder(n: int) -> func(int) -> int:
    return (x) => x + n

pub func main(arguments: list[str]) -> int!:
    print(apply(twice, 21), apply((n) => n + 1, 41))
    let positive: func(int) -> bool = (n) => n > 0
    print(positive(3), positive(-3))
    print([3, 1, 2].map((n) => n * n), [1, 2, 3, 4].filter((n) => n % 2 == 0))
    let counter = make_counter()
    print(counter(), counter(), counter())
    let other = make_counter()
    print(other(), counter())
    let add5 = adder(5)
    print(add5(1), adder(10)(1))
    var total = 0
    let bump = func (by: int):
        total += by
    bump(3)
    bump(4)
    total += 100
    print(total)
    let t = Tracer("t")
    let hello = t.greet
    print(hello("you"))
    if true:
        let inner = Tracer("inner")
        let show = func () -> str:
            return inner.name
        print(show())
        print("leaving")
    print("- end")
    return 0
