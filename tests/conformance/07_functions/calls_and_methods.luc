## §7: defaults, named arguments, tuples as results, methods on structs and enums, a
## mutating method needs a `var`, type functions, function values, recursion.
struct Counter:
    var value: int = 0

    func bump(self, by: int = 1):
        self.value = self.value + by

    func doubled(self) -> int:
        return self.value * 2

    func zero() -> Counter:
        return Counter()

enum Op:
    add
    mul

    func apply(self, a: int, b: int) -> int:
        match self:
            .add: return a + b
            .mul: return a * b

func area(width: float, height: float = 1.0) -> float:
    return width * height

func divmod(a: int, b: int) -> (int, int):
    return (a // b, a % b)

func fact(n: int) -> int:
    return 1 if n <= 1 else n * fact(n - 1)

func twice(f: func(int) -> int, x: int) -> int:
    return f(f(x))

func inc(x: int) -> int:
    return x + 1

pub func main(arguments: list[str]) -> int!:
    var c = Counter.zero()
    c.bump()
    c.bump(by = 5)
    let (q, r) = divmod(17, 5)
    print(area(2.0), area(2.0, 3.0), area(height = 4.0, width = 2.0), c.value, c.doubled(), q, r)
    print(Op.add.apply(2, 3), Op.mul.apply(2, 3), fact(10), twice(inc, 5))
    let f = inc
    print(f(1), twice(f, 0))
    return 0
