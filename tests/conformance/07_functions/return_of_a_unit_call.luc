# §7.1: `return f(...)` of a function returning `unit` (here `unit!`) whose arguments
# made temporaries (a chosen text, an object) runs the call, lets the temporaries go,
# and returns: there is no value to keep.
class Noisy:
    pub let name: str
    pub func init(self, name: str):
        self.name = name
    func deinit(self):
        print(f"deinit {self.name}")

func shown(name: str) -> unit!:
    print(name)

func shown_with(n: Noisy, name: str) -> unit!:
    print(f"{n.name} {name}")

func setup(scene: str) -> unit!:
    if scene in ["a", "b"]:
        return shown("x" if scene == "a" else "y")
    if scene == "c":
        return shown_with(Noisy("temp"), f"scene {scene}")
    print("other")

pub func main(arguments: list[str]) -> int!:
    setup("a")
    setup("b")
    setup("c")
    setup("d")
    return 0
