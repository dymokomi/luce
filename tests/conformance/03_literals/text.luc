## §3.3: escapes, raw text, formatted text with braces, triple-quoted text, bytes; a text
## of one scalar is a `str`, and a formatted text takes any displayable value.
pub func main(arguments: list[str]) -> int!:
    let name = "Ada"
    let path = r"C:\temp\new"
    let age = 36
    let greeting = f"hello {name}, you are {age + 1} {{braces}}"
    let block = """
        two lines
          of text
        """
    let data = b"\x00\x01ab"
    let scalar = "é"
    print(greeting)
    print(block)
    print(path, "tab\there", "quote\"", scalar.length, data.length, data[1], data[2])
    print(f"{1.5} {true} {none if false else 3} {(1, "x")}")
    return 0
