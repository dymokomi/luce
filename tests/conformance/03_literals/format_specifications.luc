# A field's specification after `:` (§3.3), as Python's format mini-language lays it out.
struct Point:
    var x: int
    var y: int

pub func main(arguments: list[str]) -> int!:
    let pi = 3.14159
    let n = -1234
    let big = 1234567
    # integers: alignment, sign, base, grouping, zero padding
    print(f"[{n}] [{n:8}] [{n:<8}] [{n:^8}] [{n:=8}] [{n:08}] [{n:+}] [{42:+}] [{42: }]")
    print(f"[{big:,}] [{big:_}] [{big:012,}] [{255:x}] [{255:X}] [{255:#x}] [{255:#X}] [{5:b}] [{5:#010b}]")
    print(f"[{8:o}] [{8:#o}] [{65535:_x}] [{65:c}] [{233:^5c}] [{0:d}] [{n:*>10,}]")
    # floats: fixed, exponent, general, percent; the display with neither type nor precision
    print(f"[{pi:.2f}] [{pi:08.3f}] [{pi:e}] [{pi:.3E}] [{pi:g}] [{pi:.3}] [{0.25:%}] [{0.25:.1%}]")
    print(f"[{pi}] [{pi:10}] [{pi:<10}] [{-pi:+}] [{1e20:,.1f}] [{1e16:g}] [{1e-5:g}] [{-0.001:.2f}] [{-0.001:z.2f}]")
    print(f"[{2.5:.0f}] [{3.5:.0f}] [{2.675:.2f}] [{0.125:.2f}] [{1.0:#.0f}] [{12.0:#g}] [{1234.5678:_.2f}]")
    let inf = 1e308 * 10.0
    print(f"[{inf:f}] [{-inf:F}] [{inf - inf:+.3f}] [{inf:010}]")
    # anything else by its display: width and fill in scalars, precision keeps that many
    let name = "héllo"
    print(f"[{name:10}] [{name:>10}] [{name:·^11}] [{name:.2}] [{name:*<7.3s}] [{name:010}]")
    let missing: int? = none
    print(f"[{[1, 2]:>8}] [{true:6}] [{Point(x = 1, y = 2):>20}] [{missing:^6}]")
    # a `:` inside the field's own brackets or strings belongs to its expression
    let m = {"a": 1}
    print(f"[{m["a"] else 0:>3}] [{"x:y":>5}]")
    return 0
