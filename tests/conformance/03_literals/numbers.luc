## §3.2: integer and float literals, separators and bases, the extremes of `int`.
pub func main(arguments: list[str]) -> int!:
    let count = 42
    let big = 1_000_000
    let hex = 0xFF
    let bits = 0b1010
    let oct = 0o17
    let ratio = 0.5
    let large = 6.022e23
    let small = 1e-3
    let most = 9223372036854775807
    let least = -9223372036854775808
    print(count, big, hex, bits, oct, ratio, large, small)
    print(most, least, -most == least + 1)
    return 0
