## §16.1: an object's `close()` is its close policy, whatever Base names it; a Base method
## that is called `close` but is not the policy stays Base's own.
import interop

pub struct Stream:
    var open: bool

    pub func init() -> !:
        self.open = true

    pub func is_open() -> bool:
        return self.open

    ## Base's own close, which can fail; Luce closes through the policy.
    pub func close() -> !:
        self.open = false

    pub func destroy():
        print("destroyed")
        self.open = false

pub let stream_type: interop.Type[Stream] = interop.Type[Stream]("Stream", Stream.destroy, closeable = true)
