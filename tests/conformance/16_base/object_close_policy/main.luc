# §16.1: `with` and `close()` close an object through its close policy, here Base's
# `destroy`. The interpreter does not run it.
import stream

pub func main(arguments: list[str]) -> int!:
    with stream.Stream() as opened:
        print(opened.is_open())
    let other = stream.Stream()
    other.close()
    print(other.is_closed())
    return 0
