# §16: a Base method over `u32`, `u64`, and `usize` is visible, takes ints, and answers
# ints. The interpreter does not run it.
import sizes

pub func main(arguments: list[str]) -> int!:
    print(sizes.widen(1, 2), sizes.total([1, 2, 3], [10, 20]))
    print(sizes.widen(4294967295, 0))
    return 0
