## §16: Base's `u32`, `u64`, and `usize` cross as Luce's `int`, checked at the crossing, and
## lists of them arrive as converted arrays.
pub func widen(small: u32, wide: u64) -> u64:
    return (u64)small + wide

pub func total(shape: const u32[], sizes: const usize[]) -> u64:
    var sum: u64 = 0
    for s in shape:
        sum += (u64)s
    for n in sizes:
        sum += (u64)n
    return sum

