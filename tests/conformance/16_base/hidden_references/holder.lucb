import interop
import ownership

## A Base object whose one field Luce never sees: a callback it keeps.
pub struct Holder:
    var kept: interop.Callback[unit, unit]?

    pub func init() -> !:
        self.kept = none

    pub mutating func keep(callback: interop.Callback[unit, unit]):
        let held = callback.clone()
        if let previous = self.kept:
            previous.release()
        self.kept = held

    mutating func dispose():
        if let kept = self.kept:
            self.kept = none
            kept.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let kept = self.kept:
            kept.trace(visit, context)

pub let holder_type: interop.Type[Holder] = interop.Type[Holder](name = "Holder",
                                                                 dispose = Holder.dispose, trace = Holder.trace)
