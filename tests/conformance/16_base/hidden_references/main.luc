# A class holding a Base object is never taken to be acyclic: Base describes only the
# fields that cross, and a callback kept in a hidden one can hold the class again (a
# widget and the handler that captures it). The cycle is collected before the run ends.
import holder

class Owner:
    pub let holder: holder.Holder
    pub let name: str

    func init(self, name: str) -> unit!:
        self.holder = holder.Holder()
        self.name = name

    func deinit(self):
        print(f"deinit {self.name}")

func make(name: str) -> unit!:
    let owner = Owner(name)
    owner.holder.keep(func ():
        _ = owner.name)

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    make("first")
    make("second")
    print("made")
    return 0
