# §16: what a Luce program sees of a Base module through luce-base's description: its
# `pub` functions and constants, its crossable structs and enums, and its handles as classes
# with `close()`, closed at the last reference otherwise. The interpreter does not run it.
import counters

func double(n: int) -> int:
    return n * 2

pub func main(arguments: list[str]) -> int!:
    let c = try counters.open(5)
    print(counters.bump(c, 2), counters.bump(c, 3), counters.alive())
    c.close()
    print(counters.alive(), counters.limit)
    let failed = counters.open(-1) catch failure:
        print("refused:", failure.message)
        assert(failure.code == counters.negative_start)
        recover c
    discard(failed)
    with try counters.open(1) as h:
        print(counters.bump(h, 1))
    print(counters.alive())
    print(counters.each(4, double), counters.greet("hello"), counters.total_length(["ab", "cde"]))
    print(counters.first_of([7, 8]) else -1, counters.first_of([]) else -1)
    let p = counters.Counted(count = 3)
    print(counters.shift(p, 4).count, counters.flip(counters.Mode.read), counters.label(counters.Mode.write, "w"))
    # A direct call of the declared destroy function shares close's bookkeeping.

    if true:
        let direct = try counters.open(9)
        let alias = direct
        counters.release(direct)
        counters.release(alias)
        alias.close()
        print("direct", counters.alive())
    if true:
        let closed = try counters.open(10)
        closed.close()
        counters.release(closed)
    with try counters.open(11) as scoped:
        counters.release(scoped)
    print("after cleanup", counters.alive())
    # Imported functions keep the same adapters when called through Luce closures.

    let remember = counters.remember
    if true:
        let callback = double
        remember(callback)
    print("retained callback", counters.invoke_stored(5))
    let positive = counters.positive
    try positive(1)
    positive(-1) catch failure:
        print("indirect unit:", failure.message)
        recover ()
    let each = counters.each
    print("indirect callback", each(4, double))
    let alive = counters.alive
    let open = counters.open
    let bump = counters.bump
    let release = counters.release
    let greet = counters.greet
    let total = counters.total_length
    let first = counters.first_of
    let shift = counters.shift
    let callbacks = [alive, counters.alive]
    let indirect = try open(20)
    print("indirect", bump(indirect, 2), greet("hello"), total(["ab", "c"]))
    print(first([7]) else -1, shift(p, 2).count, callbacks[0]())
    release(indirect)
    release(indirect)
    print("indirect closed", alive())
    discard(open(-1) catch failure:
        print("indirect refused:", failure.message)
        recover indirect)
    return 0
