# §16: what a Luce program sees of a Base module through luce-base's description: its
# `pub` functions and constants, its crossable structs and enums, and its handles as classes
# with `close()`, closed at the last reference otherwise. The interpreter does not run it.
import counters

func double(n: int) -> int:
    return n * 2

pub func main(arguments: list[str]) -> int!:
    let c = try counters.open(5)
    print(counters.bump(c, 2), counters.bump(c, 3), counters.alive())
    c.close()
    print(counters.alive(), counters.limit)
    let failed = counters.open(-1) catch failure:
        print("refused:", failure.message)
        recover c
    discard(failed)
    with try counters.open(1) as h:
        print(counters.bump(h, 1))
    print(counters.alive())
    print(counters.each(4, double), counters.greet("hello"), counters.total_length(["ab", "cde"]))
    print(counters.first_of([7, 8]) else -1, counters.first_of([]) else -1)
    let p = counters.Counted(count = 3)
    print(counters.shift(p, 4).count, counters.flip(counters.Mode.read), counters.label(counters.Mode.write, "w"))
    return 0
