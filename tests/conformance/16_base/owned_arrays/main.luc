# §16.2: owned arrays from Base arrive as lists of their own, which the program may change;
# a failing answer crosses as a failure. The interpreter does not run it.
import arrays

pub func main(arguments: list[str]) -> int!:
    let names = arrays.names()
    names.append("linus")
    print(names, names.length, arrays.countdown(3), arrays.countdown(0))
    let failed = arrays.countdown(-1) catch failure:
        print(failure.message, failure.code == arrays.negative)
        recover []
    print(failed)
    return 0
