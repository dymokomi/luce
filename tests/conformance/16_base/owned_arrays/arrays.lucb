## §16.2: an owned array a Base function answers crosses as a new Luce list, its elements
## converted; the owner is released once the list is made.
import interop
import ownership

struct Storage:
    var header: ownership.Object
    var names: str[]
    var numbers: i32[]

func storage_drop(o: ownership.Object*):
    let s = (Storage*)o
    free(s.names)
    free(s.numbers)

func storage_trace(o: ownership.Object*, visit: func(ownership.Object*, void*) -> unit, context: void*):
    discard(0)

var storage_info: ownership.Info = ownership.Info(name = "storage", size = sizeof(Storage), finish = none, drop = storage_drop, trace = storage_trace)

func storage(name_count: usize, number_count: usize) -> Storage*:
    let s = (Storage*)ownership.allocate(&storage_info)
    s.names = alloc str[name_count] catch failure: trap("out of memory")
    s.numbers = alloc i32[number_count] catch failure: trap("out of memory")
    return s

pub let negative: ErrorCode = ErrorCode.package(1)

pub func names() -> interop.Owned[const str[]]:
    let s = storage(2, 1)
    s.names[0] = "ada"
    s.names[1] = "grace"
    return interop.Owned[const str[]](s.names, &s.header)

pub func countdown(n: i32) -> interop.Owned[const i32[]]!:
    if n < 0:
        error(negative, "a countdown starts at zero or above")
    let s = storage(1, (usize)n)
    var i: usize = 0
    while i < (usize)n:
        s.numbers[i] = n - (i32)i
        i += 1
    return interop.Owned[const i32[]](s.numbers, &s.header)
