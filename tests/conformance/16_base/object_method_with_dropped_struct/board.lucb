import interop
from lists import List

## A Base object with a method returning a Cloud: that method stays in Base, the object
## and its other methods cross.
pub struct Board:
    var size: i64

    pub func init(size: i64) -> !:
        self.size = size

    ## What Luce cannot take.
    pub func cloud() -> Cloud!:
        return Cloud(points = List[f64](items = none), count = self.size)

    ## Fills `out` with the board's points: a parameter Luce cannot take.
    pub func fill(out: Cloud*):
        out.count = self.size

    ## The squares on the board.
    pub func area() -> i64:
        return self.size * self.size

    func dispose():
        self.size = 0

pub let board_type: interop.Type[Board] = interop.Type[Board](name = "Board", dispose = Board.dispose)

## Points in a list Luce cannot hold: the struct stays in Base. Declared after the object,
## as luce-cad's FaceSupport is after BrepModel, so the object's methods are read first.
pub struct Cloud:
    pub var points: List[f64]
    pub var count: i64
