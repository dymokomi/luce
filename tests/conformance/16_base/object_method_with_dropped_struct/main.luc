# §16.1: a Base object is seen without the methods whose signatures name a struct that
# cannot cross (a result, a parameter); the object and its other methods cross, as a
# plain Base struct's do (method_with_unavailable_type).
import board

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let b = board.Board(3)
    print(b.area())
    return 0
