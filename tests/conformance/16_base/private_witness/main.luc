# §16: a Base type that conforms through a method that is not `pub` imports, and the method is
# called through the interface (§16); by its own name it is private (errors/base_witness_by_name.luc).
import marker

pub func main(arguments: list[str]) -> int!:
    let p: marker.Precision = marker.make()
    print(marker.answer() + p.precision())
    return 0
