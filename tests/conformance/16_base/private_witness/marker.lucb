## A conformance's method needs no `pub` (base.md §14.1): `precision` is the public surface
## through `Precision` alone, a witness the description names (base.md §16).
pub interface Precision:
    func precision() -> usize

pub struct Precision4: Precision:
    var empty_: u8

    func precision() -> usize:
        return 4

## A `Precision4`, its storage private.
pub func make() -> Precision4:
    return Precision4(empty_ = 0)

pub func answer() -> i64:
    return 40
