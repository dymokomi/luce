## §16.1: an object whose type is disposed by another function, with a `close` of its own
## that takes nothing and cannot fail: Luce's `close()` is that method, and the object stays
## usable after it, as luce-ui's Application does when a callback closes it.
import interop
import memory

pub struct Session:
    var open: bool = true

    ## End the session; the object answers questions afterwards.
    pub func close():
        self.open = false

    ## Whether `close` has not been called.
    pub func is_open() -> bool:
        return self.open

    func dispose():
        self.open = false

pub let session_type: interop.Type[Session] = interop.Type[Session]("Session", Session.dispose)

## A new session for Luce.
pub func start() -> interop.Reference[Session]!:
    var reservation = try interop.Reservation[Session](session_type)
    errdefer reservation.cancel()
    let native = try new Session() in memory.heap
    return reservation.publish(native)
