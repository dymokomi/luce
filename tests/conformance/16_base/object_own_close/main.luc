# §16.1: a Base `close()` that takes nothing and cannot fail is the object's `close()`, even
# when its type is disposed by another function; the object answers after it. The
# interpreter does not run it.
import session

pub func main(arguments: list[str]) -> int!:
    let current = session.start()
    print(current.is_open())
    current.close()
    print(current.is_open())
    return 0
