# §16.1: a function a Base module re-exports, `pub let add = numbers.add`, crosses as the
# function under that name, its defaults and named arguments included, qualified or
# imported by name.
import kernel
from kernel import doubled

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    print(kernel.add(2), kernel.add(2, 5), kernel.add(y = 10, x = 1))
    print(doubled(4), doubled(4, by = 3))
    return 0
