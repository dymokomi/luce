# §16.1: a Base type is seen without the methods whose signatures name a type that cannot
# cross (here a span of a Base struct holding a fixed array, from another module, as a parameter or as
# the result); the type and its other methods cross, a method returning the type itself too.
from mesh import Mesh

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let m = Mesh(3)
    print(m.size(), m.count, Mesh(8).quarter().size())
    return 0
