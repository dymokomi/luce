# §16.1: a Base type is seen without the methods whose signatures name a type that cannot
# cross (here a span of a Base struct of `f32`s, from another module); the type and its
# other methods cross.
from mesh import Mesh

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let m = Mesh(3)
    print(m.size(), m.count)
    return 0
