import geometry

## A mesh whose one method takes points Luce cannot hold: the method is left out of what
## Luce sees, the rest of the type is not.
pub struct Mesh:
    pub var count: i64

    ## Make one.
    pub func init(count: i64):
        self.count = count

    ## How many of the points lie above the plane z = 0.
    pub func above(points: const geometry.Vec3[]) -> i64:
        var n: i64 = 0
        for p in points:
            if p.z > 0.0:
                n += 1
        return n

    ## How many.
    pub func size() -> i64:
        return self.count
