import geometry

## A mesh whose methods take or return points Luce cannot hold: those methods are left out
## of what Luce sees, the rest of the type is not, including a method naming the type itself.
pub struct Mesh:
    pub var count: i64

    ## Make one.
    pub func init(count: i64):
        self.count = count

    ## How many of the points lie above the plane z = 0.
    pub func above(points: const geometry.Vec3[]) -> i64:
        var n: i64 = 0
        for p in points:
            if p.z > 0.0:
                n += 1
        return n

    ## A mesh of a quarter the size: its type names the type itself.
    pub func quarter() -> Mesh:
        return Mesh(self.count // 4)

    ## The centre, returned: a result type Luce cannot take.
    pub func centre() -> geometry.Vec3:
        return geometry.Vec3(x = 0.0, y = 0.0, z = 0.0)

    ## How many.
    pub func size() -> i64:
        return self.count
