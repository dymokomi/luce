## §16.2: every Base integer width crosses as Luce's `int`, checked on the way in, and `f32`
## as `float`; C text crosses as `str`, lent as a zero-terminated copy for the call.
import c

pub func narrow(a: i8, b: i16, d: i32, e: u8, f: u16, g: isize) -> i32:
    return (i32)a + (i32)b + d + (i32)e + (i32)f + (i32)g

pub func smallest() -> i8:
    return -128

pub func half(x: f32) -> f32:
    return x / 2.0

pub func ports(values: const u16[]) -> i32:
    var sum: i32 = 0
    for v in values:
        sum += (i32)v
    return sum

pub func measure(text: c.str) -> i32:
    let view = str(text) catch failure: trap("C text that is not UTF-8")
    return (i32)view.length

pub func joined(parts: const c.str[]) -> i32:
    var total: i32 = 0
    for part in parts:
        total += measure(part)
    return total
