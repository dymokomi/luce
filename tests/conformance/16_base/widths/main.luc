# §16.2: Base's narrow integers and `f32` take and answer ints and floats, and C text takes
# Luce text. The interpreter does not run it.
import numbers

pub func main(arguments: list[str]) -> int!:
    print(numbers.narrow(-128, 1000, -70000, 255, 65535, 1), numbers.smallest())
    print(numbers.half(3.0), numbers.ports([80, 443, 8080]))
    print(numbers.measure("héllo"), numbers.joined(["a", "bc", ""]))
    return 0
