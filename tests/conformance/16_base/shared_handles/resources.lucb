import memory
import gpu

pub handle Item:
    destroy close

struct Value:
    var number: i64

pub func open(initial: i64) -> Item!:
    return (Item)(void*)(try new Value(number = initial) in memory.heap)

pub func value(item: Item) -> i64:
    return ((Value*)(void*)item).number

pub func close(item: Item):
    free((Value*)(void*)item) in memory.heap

pub func total(items: const Item[]) -> i64:
    var result: i64 = 0
    for item in items:
        result += value(item)
    return result

# A standard type with the same short name as a local handle stays distinct.
pub handle RenderTarget:
    destroy close_target

pub func close_target(target: RenderTarget):
    discard(target)

pub func native_target(target: gpu.RenderTarget) -> gpu.RenderTarget:
    return target

pub func borrowed(items: const Item[]) -> const Item[]:
    return items
