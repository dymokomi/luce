import resources
let empty_input: ErrorCode = ErrorCode.package(1)

pub type Item = resources.Item

pub func open(initial: i64) -> resources.Item!:
    return try resources.open(initial)

pub func value(item: resources.Item) -> i64:
    return resources.value(item)

pub func total(items: const resources.Item[]) -> i64!:
    if items.length == 0:
        error(empty_input, "empty input")
    return resources.total(items)
