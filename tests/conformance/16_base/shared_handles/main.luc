import consumer
import resources

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let first = try consumer.open(17)
    let second = try resources.open(25)
    let alias: consumer.Item = second
    assert(consumer.value(first) == 17)
    assert(resources.value(first) == 17)
    assert(resources.total([first, alias]) == 42)
    assert(try consumer.total([first, second]) == 42)
    assert(resources.total([]) == 0)
    let refused = consumer.total([]) catch failure:
        assert(failure.message == "empty input")
        recover 0
    assert(refused == 0)
    let total = resources.total
    assert(total([try consumer.open(3), try resources.open(4)]) == 7)
    first.close()
    second.close()
    print("shared handle identity and borrowed lists")
    return 0
