import standard_text

pub func main(arguments: list[str]) -> int!:
    let create = standard_text.create
    let value = standard_text.value
    if true:
        let result = create("Straße É")
        let copied = value(result)
        print("live", standard_text.live())
        result.close()
        print(copied)
        print("closed", standard_text.live())
    print(standard_text.graphemes("á👩‍👩‍👧‍👦"))
    print(standard_text.number("12.5"))
    _ = standard_text.number("1,5") catch failure:
        print(failure.message)
        recover 0.0
    var copied = ""
    if true:
        let result = create("Å")
        copied = value(result)
    print(copied)
    print("after", standard_text.live())
    return 0
