## Owned Base text stays behind a handle; Luce copies a borrowed result before
## that handle closes. The fixture deliberately uses Base's persistent heap.
import memory
import strings
import unicode

pub handle Text:
    destroy dispose

struct TextData:
    var text: str

var active: i64 = 0

pub func create(input: str) -> Text!:
    with memory.heap:
        let normalized = try unicode.normalize(input)
        defer unicode.release(normalized)
        let folded = try unicode.case_fold(normalized)
        errdefer unicode.release(folded)
        let data = try new TextData(text = folded)
        active += 1
        return (Text)(void*)data

pub func value(text: Text) -> str:
    return ((TextData*)(void*)text).text

pub func dispose(text: Text):
    with memory.heap:
        let data = (TextData*)(void*)text
        unicode.release(data.text)
        free(data)
        active -= 1

pub func live() -> i64:
    return active

pub func graphemes(text: str) -> usize!:
    var iterator = try unicode.GraphemeIterator.over(text)
    var count: usize = 0
    while let cluster = iterator.next():
        discard(cluster)
        count += 1
    return count

pub func number(text: str) -> f64!:
    return try strings.parse_f64(text)
