## §16: a Base module a Luce program imports: a handle over the module's own memory,
## functions over it, constants, a struct and an integer-backed enum that cross, a callback,
## texts and lists lent, a result copied, a failure crossing as it is.
import c

pub handle Counter:
    destroy release

pub struct Counted:
    pub var count: i64

# The handle owns private native state; Counted is a complete copied record.
struct NativeCounter:
    var count: i64
    var secret: u8

pub enum Mode as u32:
    read = 0
    write = 1

pub let limit: i64 = 3
pub let negative_start: ErrorCode = ErrorCode.package(1)

var opened: i64 = 0

pub func open(start: i64) -> Counter!:
    if start < 0:
        error(negative_start, "negative start")
    opened += 1
    let p = new NativeCounter(count = start, secret = 0) catch failure: trap("out of memory")
    return (Counter)(void*)p

pub func bump(counter: Counter, by: i64) -> i64:
    let p = (NativeCounter*)(void*)counter
    p.count += by
    return p.count

pub func release(counter: Counter):
    free((NativeCounter*)(void*)counter)
    opened -= 1

pub func alive() -> i64:
    return opened

pub func label(mode: Mode, text: str) -> str:
    return text

func hidden() -> i64:
    return 0

extern func puts(s: c.str) -> i32

pub func each(count: i64, f: func(i64) -> i64) -> i64:
    var total: i64 = 0
    var i: i64 = 0
    while i < count:
        total += f(i)
        i += 1
    return total

pub func greet(name: str) -> str:
    return name

pub func total_length(names: const str[]) -> usize:
    var n: usize = 0
    for name in names:
        n += name.length
    return n

pub func first_of(values: const i64[]) -> i64?:
    if values.length == 0:
        return none
    return values[0]

pub func shift(p: Counted, by: i64) -> Counted:
    return Counted(count = p.count + by)

pub func flip(m: Mode) -> Mode:
    return Mode.write if m == Mode.read else Mode.read

## Base's own: a pointer in the signature keeps it from a Luce program (§16.1).
pub func raw(p: i64*) -> i64:
    return *p
