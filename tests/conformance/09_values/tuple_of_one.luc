# §9.3: a tuple of one member is written with its comma, `(1,)`, and is a tuple: it has a
# member `.0`, equality, ordering, a display that keeps the comma, and destructures.
pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let t = (1,)
    print(t, t.0)
    let s = ("one",)
    print(s, s == ("one",), s < ("two",))
    let (inner,) = s
    print(inner)
    match t:
        (1,):
            print("matched one")
        _:
            print("other")
    let nested = ((2,), [s])
    print(nested)
    return 0
