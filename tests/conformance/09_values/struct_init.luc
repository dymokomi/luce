# §9.1: a struct with its own `init` is constructed through it: the defaulted fields hold
# their defaults when the body starts, a bare `return` ends it, and an `init` that fails
# releases what it had assigned before the failure reaches the caller.
let bad = ErrorCode.package(1)

class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

struct Celsius:
    let degrees: float

    func init(self, fahrenheit: float):
        self.degrees = (fahrenheit - 32.0) * 5.0 / 9.0

struct Card:
    var name: str = "blank"
    var tags: list[str] = []
    var count: int = 0

    func init(self, name: str):
        print(f"default {self.name} {self.tags.length}")
        self.name = name
        self.tags.append(name)
        if name == "short":
            return
        self.count = 2

struct Account:
    let owner: str
    var history: list[int] = []
    let tag: Tracer

    func init(self, owner: str, balance: int) -> unit!:
        self.tag = Tracer(owner)
        self.history.append(balance)
        if balance < 0:
            error(bad, "negative balance")
        self.owner = owner

struct Reading:
    let value: int

    func init(self, value: int) -> unit!:
        if value > 100:
            error(bad, "out of range")
        self.value = value

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    print(Celsius(212.0).degrees, Celsius(fahrenheit = 32.0).degrees)
    let card = Card("ace")
    var copy = card
    copy.name = "copy"
    print(card.name, card.tags, card.count, copy.name)
    print(Card("short").count)
    let ok = Account("ann", 10)
    print(ok.owner, ok.history, ok.tag.name)
    let failed: Account? = Account("bob", -1) catch failure:
        print("failed:", failure.message)
        recover none
    print(failed == none)
    print((Reading(7)).value)
    let missing: Reading? = Reading(700) catch failure:
        print("failed:", failure.message)
        recover none
    print(missing == none)
    print("- end")
    return 0
