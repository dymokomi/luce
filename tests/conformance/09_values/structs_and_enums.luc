## §9: a struct copies, its `var` fields change through a `var`; memberwise construction
## with defaults; enums with payloads and methods; tuples; display of each.
struct Config:
    var width: int = 80
    var depth: int
    var name: str = "default"

struct Point:
    var x: float
    var y: float

    func moved(self, dx: float, dy: float) -> Point:
        return Point(x = self.x + dx, y = self.y + dy)

enum Command:
    quit
    open(path: str)
    resize(width: int, height: int)

    func name(self) -> str:
        match self:
            .quit: return "quit"
            .open(path): return "open " + path
            .resize(width, height): return f"resize {width}x{height}"

pub func main(arguments: list[str]) -> int!:
    let c = Config(depth = 3)
    let d = Config(10, 1, "wide")
    let p = Point(x = 1.0, y = 2.0)
    let q = p.moved(1.0, 1.0)
    let commands = (Command.quit, Command.open(path = "a.txt"), Command.resize(width = 8, height = 6))
    print(c.width, c.depth, c.name, d.width, d.name)
    print(p, q)
    print(commands.0.name(), commands.1.name(), commands.2.name())
    print(c, commands.1, (1, "two", 3.0))
    return 0
