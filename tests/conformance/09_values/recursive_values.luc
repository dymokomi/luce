# §4.5, §4.4: an enum holds values of its own type through a list or a map, which refer;
# equality, hashing and display walk the whole value.
enum Tree:
    leaf(n: int)
    node(kids: list[Tree])
    named(kids: map[str, Tree])

func sum(t: Tree) -> int:
    match t:
        .leaf(n): return n
        .node(kids):
            var s = 0
            for k in kids:
                s += sum(k)
            return s
        .named(kids):
            var s = 0
            for (name, k) in kids:
                discard(name)
                s += sum(k)
            return s

pub func main(arguments: list[str]) -> int!:
    let a = Tree.node(kids = [Tree.leaf(n = 1), Tree.named(kids = {"two": Tree.leaf(n = 2)})])
    let b = Tree.node(kids = [Tree.leaf(n = 1), Tree.named(kids = {"two": Tree.leaf(n = 2)})])
    let c = Tree.node(kids = [Tree.leaf(n = 1)])
    print(a == b, a == c, sum(a), sum(c))
    print(hash(a) == hash(b), hash(a) == hash(c))
    print(a)
    let seen = {a, b, c}
    print(seen.length, c in seen)
    return 0
