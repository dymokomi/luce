# §13.2, §13.3: a generic struct, enum, class or interface is instantiated per type
# arguments, written or inferred from a construction's arguments or the expected type;
# `for` iterates a value of a type declaring `Iterable[T]`, through `iterator()` and
# `next()`, and a generic bound may name an instance.
struct Pair[A, B]:
    var first: A
    var second: B

    func swapped(self) -> Pair[B, A]:
        return Pair(first = self.second, second = self.first)

enum Option[T]:
    some(value: T)
    empty

    func or_else(self, fallback: T) -> T:
        match self:
            .some(v): return v
            .empty: return fallback

class Stack[T]:
    var items: list[T]

    func init(self):
        self.items = []

    func push(self, x: T):
        self.items.append(x)

    func pop(self) -> T?:
        return self.items.pop() if self.items.length > 0 else none

    func size(self) -> int:
        return self.items.length

interface Container[T]:
    func get(self) -> T

struct Box: Container[int]:
    var value: int

    func get(self) -> int:
        return self.value

class Countdown: Iterable[int]:
    let start: int

    func init(self, start: int):
        self.start = start

    func iterator(self) -> Iterator[int]:
        return CountdownIterator(self.start)

class CountdownIterator: Iterator[int]:
    var current: int

    func init(self, current: int):
        self.current = current

    func next(self) -> int?:
        if self.current <= 0:
            return none
        self.current -= 1
        return self.current + 1

func sum_all[I: Iterable[int]](values: I) -> int:
    var total = 0
    for v in values:
        total += v
    return total

func firsts[A, B](pairs: list[Pair[A, B]]) -> list[A]:
    return pairs.map((p) => p.first)

pub func main(arguments: list[str]) -> int!:
    let p = Pair(first = 1, second = "one")
    print(p, p.swapped(), p.first, p.swapped().first)
    let q: Pair[bool, float] = Pair(first = true, second = 2.5)
    print(q, firsts([p, Pair(first = 2, second = "two")]))
    let o = Option.some(3)
    let e: Option[int] = Option.empty
    print(o.or_else(0), e.or_else(9), Option[str].empty.or_else("z"))
    match o:
        .some(v): print("some", v)
        .empty: print("empty")
    let s = Stack[int]()
    s.push(1)
    s.push(2)
    print(s.size(), s.pop() else -1, s.pop() else -1, s.pop() else -1)
    let words = Stack[str]()
    words.push("w")
    print(words.pop() else "-", words.size())
    let c: Container[int] = Box(value = 7)
    print(c.get(), sum_all(Countdown(4)))
    for n in Countdown(3):
        print(n)
    let it = Countdown(2).iterator()
    while let x = it.next():
        print("x", x)
    outer: for a in Countdown(2):
        for b in Countdown(2):
            if b == 1:
                continue outer
            print(a, b)
    return 0
