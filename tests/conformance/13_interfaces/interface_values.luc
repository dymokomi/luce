# §13.2: an interface value is a copy of a conforming value behind the interface. It is
# passed, kept in bindings, collections and optionals, bound as a method value, and let
# go of like any value; a class behind it stays alive while any copy of the value does,
# and a cycle through interface values is a cycle the collector reclaims.
interface Greeter:
    func greet(self, name: str) -> str
    func count(self) -> int

struct Formal: Greeter:
    var title: str

    func greet(self, name: str) -> str:
        return f"good day, {self.title} {name}"

    func count(self) -> int:
        return self.title.length

class Counter: Greeter:
    var seen: int = 0

    func greet(self, name: str) -> str:
        self.seen += 1
        return f"hi {name} #{self.seen}"

    func count(self) -> int:
        return self.seen

    func deinit(self):
        print(f"counter gone after {self.seen}")

enum Mood: Greeter:
    happy
    grumpy

    func greet(self, name: str) -> str:
        match self:
            .happy: return f"hello {name}!"
            .grumpy: return f"what, {name}"

    func count(self) -> int:
        return 0

class Node: Greeter:
    let name: str
    var peer: Greeter? = none

    func init(self, name: str):
        self.name = name

    func greet(self, name: str) -> str:
        return f"{self.name} greets {name}"

    func count(self) -> int:
        return 1

    func deinit(self):
        print(f"node {self.name} gone")

func twice(g: Greeter, name: str) -> str:
    return g.greet(name) + " / " + g.greet(name)

func session() -> int:
    let g: Greeter = Counter()
    print(g.greet("solo"))
    let same = g
    print(same.count())
    return g.count() + same.count()

func tie() -> unit:
    let a = Node("a")
    let first: Greeter = a
    let again: Greeter = a
    let maybe: Greeter? = a
    assert(first is again and first is a and a is first)
    assert(maybe is a and a is maybe)
    let b = Node("b")
    a.peer = b
    b.peer = a
    print(a.greet("b"))

pub func main(arguments: list[str]) -> int!:
    let formal = Formal(title = "dr")
    let greeters: list[Greeter] = [formal, Counter(), Mood.grumpy]
    for g in greeters:
        print(g.greet("ana"))
    print(twice(greeters[1], "bo"))
    print(greeters.map((g) => g.count()))
    print("- session")
    print(session())
    print("- optional and map")
    var maybe: Greeter? = none
    maybe = Mood.happy
    if let g = maybe:
        print(g.greet("cy"))
    var by_name: map[str, Greeter] = {"f": formal, "m": Mood.grumpy}
    by_name["c"] = Counter()
    if let c = by_name["c"]:
        print(c.greet("di"), c.count())
    let hello = formal.greet
    let cheer = maybe else formal
    print(hello("ed"), cheer.greet("fay"))
    print("- a cycle through interface values")
    tie()
    print("tied")
    discard(by_name.remove("c"))
    print(by_name.length)
    return 0
