# error: 12:20: `Square` does not have `Ordered`, which `T` requires (§13.2)
struct Square:
    var side: float

func largest[T: Ordered](values: list[T]) -> T?:
    var best: T? = none
    for v in values:
        best = v
    return best

pub func main(arguments: list[str]) -> int!:
    let s = largest([Square(side = 1.0)])
    return 0
