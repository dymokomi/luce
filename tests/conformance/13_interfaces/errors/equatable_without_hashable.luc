# error: 10:18: a `Version` has no hash: its `Equatable` needs `Hashable` beside it (§13.3)
struct Version: Equatable:
    var major: int
    var label: str

    func equals(self, other: Version) -> bool:
        return self.major == other.major

pub func main(arguments: list[str]) -> int!:
    print(Version(major = 1, label = "a").hash())
    return 0
