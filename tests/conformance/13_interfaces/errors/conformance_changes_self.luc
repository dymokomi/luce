# error: 8:5: the method `bump` changes `self`, which a method an interface requires may not (§13.1)
interface Bumper:
    func bump(self) -> int

struct Tally: Bumper:
    var n: int

    func bump(self) -> int:
        self.n += 1
        return self.n

pub func main(arguments: list[str]) -> int!:
    return 0
