# §13.1, §13.2: an interface is a set of method signatures; a struct, an enum or a class
# declares its conformance and provides every method; a conforming value converts to an
# interface value where one is expected, and a call dispatches to the value's own method.
interface Shape:
    func area(self) -> float
    func name(self) -> str

struct Circle: Shape:
    var radius: float

    func area(self) -> float:
        return 3.0 * self.radius * self.radius

    func name(self) -> str:
        return "circle"

struct Square: Shape:
    var side: float

    func area(self) -> float:
        return self.side * self.side

    func name(self) -> str:
        return "square"

class Canvas: Shape:
    var width: float = 2.0
    var height: float = 3.0

    func area(self) -> float:
        return self.width * self.height

    func name(self) -> str:
        return "canvas"

enum Unit: Shape:
    point
    line

    func area(self) -> float:
        return 0.0

    func name(self) -> str:
        match self:
            .point: return "point"
            .line: return "line"

func describe(shape: Shape) -> str:
    return f"{shape.name()} {shape.area()}"

func total(shapes: list[Shape]) -> float:
    var sum = 0.0
    for shape in shapes:
        sum += shape.area()
    return sum

pub func main(arguments: list[str]) -> int!:
    let circle = Circle(radius = 1.0)
    print(describe(circle), describe(Square(side = 2.0)), describe(Canvas()), describe(Unit.line))
    let shapes: list[Shape] = [circle, Square(side = 3.0), Canvas()]
    print(total(shapes), shapes.length)
    let held: Shape = Square(side = 4.0)
    print(held.name(), held.area())
    var maybe: Shape? = none
    print(maybe == none)
    maybe = circle
    if let s = maybe:
        print(s.name())
    return 0
