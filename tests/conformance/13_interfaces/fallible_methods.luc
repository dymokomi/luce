## §13.1, §12.2: an interface method may fail or return nothing; a call through the
## interface carries the failure, and a method whose every `match` arm returns over a
## subject made for the statement needs no code after it.
let bad = ErrorCode.package(1)

interface Source:
    func next(self) -> int!
    func reset(self) -> unit!
    func label(self) -> str

class Counter: Source:
    var at: int = 0
    let limit: int

    func init(self, limit: int):
        self.limit = limit

    func next(self) -> int!:
        if self.at >= self.limit:
            error(bad, f"{self.label()} is exhausted")
        self.at += 1
        return self.at

    func reset(self) -> unit!:
        if self.limit < 0:
            error(bad, "no limit")
        self.at = 0

    func label(self) -> str:
        return f"counter to {self.limit}"

enum Fixed: Source:
    one
    many(values: list[int])

    func next(self) -> int!:
        match self:
            .one: return 1
            .many(values):
                let first = values.first else error(bad, "nothing left")
                return first

    func reset(self) -> unit!:
        match self:
            .one: return
            .many(values):
                if values.length == 0:
                    error(bad, "nothing to reset")

    func label(self) -> str:
        match self.pair():
            (n, text): return f"{text}/{n}"

    func pair(self) -> (int, str):
        match self:
            .one: return (1, "one")
            .many(values): return (values.length, "many")

func drain(source: Source) -> int!:
    var total = 0
    while true:
        let n = source.next() catch failure:
            print("stopped:", failure.message)
            break
        total += n
        if total > 100:
            error(bad, "too much")
    return total

func kind(source: Source) -> str:
    match source.label():
        "one/1": return "single"
        _: return "several"

pub func main(arguments: list[str]) -> int!:
    let sources: list[Source] = [Counter(3), Fixed.one, Fixed.many(values = [4, 5]), Counter(0)]
    for source in sources:
        print(source.label(), kind(source))
        let total = drain(source) catch failure:
            print("failed:", failure.message)
            continue
        print("total", total)
        try source.reset()
        let again = source.next() catch failure:
            print("again:", failure.message)
            continue
        print("again", again)
    let empty: Source = Fixed.many(values = [])
    empty.reset() catch failure:
        print("reset:", failure.message)
    print(drain(empty) catch failure: recover -1)
    return 0
