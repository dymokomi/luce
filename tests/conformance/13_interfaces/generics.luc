# §13.2: a generic function takes type parameters, each bounded by interfaces joined with
# `&`; its body is checked once against the bounds, and the program gets one instance per
# distinct type arguments, inferred from the arguments or written.
interface Shape:
    func area(self) -> float

struct Square: Shape:
    var side: float

    func area(self) -> float:
        return self.side * self.side

struct Version: Equatable, Hashable, Ordered, Display:
    var major: int
    var minor: int

    func equals(self, other: Version) -> bool:
        return self.major == other.major and self.minor == other.minor

    func hashed(self) -> int:
        return self.major * 100 + self.minor

    func compare(self, other: Version) -> int:
        if self.major != other.major:
            return self.major - other.major
        return self.minor - other.minor

    func display(self) -> str:
        return f"v{self.major}.{self.minor}"

func largest[T: Ordered](values: list[T]) -> T?:
    var best: T? = none
    for v in values:
        if let b = best:
            if v > b:
                best = v
        else:
            best = v
    return best

func swap[A, B](pair: (A, B)) -> (B, A):
    let (a, b) = pair
    return (b, a)

func identity[T](x: T) -> T:
    return x

func count_equal[T: Equatable](values: list[T], target: T) -> int:
    var n = 0
    for v in values:
        if v == target:
            n += 1
    return n

func show_sorted[T: Ordered & Display](values: list[T]) -> str:
    return values.sorted().map((v) => str(v)).join(" < ")

func total_area[S: Shape](shapes: list[S]) -> float:
    var sum = 0.0
    for s in shapes:
        sum += s.area()
    return sum

func first_or[T](values: list[T], fallback: T) -> T:
    return values.first else fallback

func apply_twice[T](f: func(T) -> T, x: T) -> T:
    return f(f(x))

func pairs_of[K: Equatable & Hashable, V](m: map[K, V]) -> list[(K, V)]:
    var out: list[(K, V)] = []
    for (k, v) in m:
        out.append((k, v))
    return out

func lengths[T: Display](values: list[T]) -> list[int]:
    return values.map((v) => str(v).length)

func nested[T: Display](x: T) -> str:
    return identity(str(x)) + "!"

pub func main(arguments: list[str]) -> int!:
    print(largest([3, 1, 2]) else 0, largest(["b", "a"]) else "-", largest[float]([]) else -1.0)
    let versions = [Version(major = 1, minor = 2), Version(major = 2, minor = 0), Version(major = 1, minor = 9)]
    print(largest(versions) else Version(major = 0, minor = 0), count_equal(versions, Version(major = 1, minor = 2)))
    print(swap((1, "one")), identity(true), identity("x"), count_equal([1, 2, 1], 1))
    print(show_sorted(versions), show_sorted([3, 1, 2]))
    print(total_area([Square(side = 2.0), Square(side = 3.0)]))
    print(first_or([], 7), first_or(["a"], "z"), apply_twice((n) => n * 2, 5), apply_twice((s) => s + "!", "hey"))
    print(pairs_of({"a": 1, "b": 2}), lengths(["one", "three"]), nested(42), nested(Version(major = 3, minor = 1)))
    return 0
