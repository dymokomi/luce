# §13.3: the compiler knows Equatable, Hashable, Ordered and Display; a value type declares
# one to replace the structural meaning, a class to have it at all. `==`, `in`, map keys,
# `<`, `sort`, `print` and f-strings use the declared methods.
struct Version: Equatable, Hashable, Ordered, Display:
    var major: int
    var minor: int
    var label: str

    func equals(self, other: Version) -> bool:
        return self.major == other.major and self.minor == other.minor

    func hashed(self) -> int:
        return self.major * 1000 + self.minor

    func compare(self, other: Version) -> int:
        if self.major != other.major:
            return self.major - other.major
        return self.minor - other.minor

    func display(self) -> str:
        return f"v{self.major}.{self.minor}"

class Account: Equatable, Display:
    let id: int
    var balance: int = 0

    func init(self, id: int):
        self.id = id

    func equals(self, other: Account) -> bool:
        return self.id == other.id

    func display(self) -> str:
        return f"account {self.id}"

pub func main(arguments: list[str]) -> int!:
    let a = Version(major = 1, minor = 2, label = "a")
    let b = Version(major = 1, minor = 2, label = "b")
    let c = Version(major = 2, minor = 0, label = "c")
    print(a == b, a != c, a < c, c > b, a <= b, hash(a) == hash(b))
    print(a, [c, a, b].sorted(), (a, 1))
    print(b in [a], c in [a], [a] == [b], {a: "x"}[b] else "?")
    var seen = {a}
    seen.insert(b)
    print(seen.length, seen)
    let x = Account(7)
    let y = Account(7)
    let z = Account(8)
    print(x == y, x == z, x is y, x, [x, z], hash(a))
    return 0
