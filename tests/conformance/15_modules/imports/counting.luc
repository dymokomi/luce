import geometry.shapes

pub class Countdown: Iterable[int]:
    let start: int

    pub func init(self, start: int):
        self.start = start

    pub func iterator(self) -> Iterator[int]:
        return Steps(self.start)

class Steps: Iterator[int]:
    var left: int

    func init(self, left: int):
        self.left = left

    func next(self) -> int?:
        if self.left <= 0:
            return none
        self.left -= 1
        return self.left + 1

pub struct Label: shapes.Named:
    pub var text: str

    pub func name(self) -> str:
        return self.text

pub func span(points: list[shapes.Point]) -> int:
    var total = 0
    for p in points:
        total += shapes.distance(p, shapes.origin)
    return total
