# §15.2: `import` keeps a module qualified, with an alias when asked; `from ... import`
# brings names in; every module sees the closed protocols; a type of one module conforms to
# an interface of another, and generic functions are instantiated wherever they are called.
import geometry.shapes
import counting as count
from geometry.shapes import Point, distance

pub func main(arguments: list[str]) -> int!:
    let p = Point(x = 3, y = 4)
    print(p, distance(p, shapes.origin), p.moved(2))
    let c = shapes.Canvas()
    c.add(p)
    c.add(shapes.origin)
    print(c.count(), shapes.Side.left, shapes.largest([1, 5, 2]) else 0, shapes.largest(["b", "a"]) else "-")
    let q: shapes.Point = Point(x = 1, y = 1)
    print(q, count.span([p, q]))
    for n in count.Countdown(3):
        print(n)
    let named: shapes.Named = count.Label(text = "tag")
    print(named.name())
    return 0
