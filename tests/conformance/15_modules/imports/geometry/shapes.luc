# §15: a module under the source root, `geometry/shapes.luc`, is `geometry.shapes`; what it
# does not mark `pub` stays its own.
pub struct Point:
    pub var x: int
    pub var y: int

    pub func moved(self, dx: int) -> Point:
        return Point(x = self.x + dx, y = self.y)

pub let origin: Point = Point(x = 0, y = 0)

pub func distance(a: Point, b: Point) -> int:
    return abs_of(a.x - b.x) + abs_of(a.y - b.y)

func abs_of(n: int) -> int:
    return n if n >= 0 else -n

pub class Canvas:
    var points: list[Point]

    pub func init(self):
        self.points = []

    pub func add(self, p: Point):
        self.points.append(p)

    pub func count(self) -> int:
        return self.points.length

pub enum Side:
    left
    right

pub interface Named:
    func name(self) -> str

pub func largest[T: Ordered](values: list[T]) -> T?:
    var best: T? = none
    for v in values:
        if let b = best:
            if v > b:
                best = v
        else:
            best = v
    return best
