# §15.2: another module constructs `Point` from its public fields, compares and hashes it
# structurally, and has it displayed only by the module that declares it; `Label` declares
# `Display`, so it prints anywhere, alone or in a collection.
import geometry.shapes
from geometry.shapes import Point, Label

pub func main(arguments: list[str]) -> int!:
    let p = Point(x = 1, y = 2)
    let q = Point(1, 2)
    print(p.x, p.y, p == q, hash(p) == hash(q))
    print(shapes.describe(p))
    print(shapes.wrapped(q).show())
    print(Label.make("door"), [Label.make("gate")], f"<{Label.make("x")}>")
    print(shapes.Ledger("main").name)
    return 0
