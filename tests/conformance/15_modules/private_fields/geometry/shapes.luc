# §15.2, §10.5: a struct with a private field shows every field in its own module, through
# `print`, `str`, f-strings, collections and a generic `Display` bound alike.
pub struct Point:
    pub let x: int
    pub let y: int
    let cache: int = 0

pub struct Label: Display:
    pub let text: str
    let width: int

    pub func make(text: str) -> Label:
        return Label(text = text, width = text.length)

    pub func display(self) -> str:
        return f"{self.text}/{self.width}"

pub class Ledger:
    pub let name: str

    pub func init(self, name: str):
        self.name = name

pub struct Wrapped[T: Display]:
    pub let item: T

    pub func show(self) -> str:
        return f"[{self.item}]"

pub func describe(p: Point) -> str:
    return f"{p} {str([p])} {listed([p, Point(x = 5, y = 6, cache = 7)])}"

pub func wrapped(p: Point) -> Wrapped[Point]:
    return Wrapped[Point](item = p)

func listed[T: Display](items: list[T]) -> str:
    var text = ""
    for item in items:
        text += str(item)
    return text
