# error: cannot resolve module `panel`
# §15.2: a package's private module shares its name with the program's own `theme`; each
# stays its own module, so a mistaken bare import of the package's module is reported as
# that, and the program's `theme` is never taken for the package's.
import other
from panel import width

pub func main(arguments: list[str]) -> int!:
    print(other.size(), width())
    return 0
