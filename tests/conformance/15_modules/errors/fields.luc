pub struct Point:
    pub let x: int
    let cache: int = 0

pub struct Token:
    pub let name: str
    let key: int

    pub func make(name: str) -> Token:
        return Token(name = name, key = 7)

pub struct Frame:
    pub let origin: Point

pub class Vault:
    pub let name: str

    func init(self, name: str):
        self.name = name

pub func show_all[T: Display](items: list[T]) -> str:
    var text = ""
    for item in items:
        text += str(item)
    return text
