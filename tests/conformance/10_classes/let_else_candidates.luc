# §8, RUNTIME (Cycles): `let x = optional else ...` binds one reference and lets it go when
# the scope ends, in a compiled program as in the interpreter; a compiled program once
# copied the optional, let the copy go at once and pooled the result, so objects became
# collector candidates the interpreter never made, and a cycle's deinits ran in another
# order.
class Node:
    let id: int
    var next: Node? = none
    var items: list[Node] = []

    func init(self, id: int):
        self.id = id

    func deinit(self):
        print(f"gone {self.id} {self.items.length}")

func walk(n: Node?) -> int:
    let node = n else return 0
    for item in node.items:
        discard(item)
    return node.id

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    var first: Node? = Node(3)
    var second: Node? = Node(4)
    print("walk", walk(second), walk(none))
    if let a = second:
        a.next = a
    if let a = second:
        if let b = first:
            a.items.append(b)
    return 0
