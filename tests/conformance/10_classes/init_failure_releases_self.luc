# §10.1, §10.3, RUNTIME: an `init` that fails after storing references back to `self` in
# its own fields (a closure over `self`, a child that holds its parent) lets them go with
# the fields, so the object never existed and nothing is left alive at the end.
let bad = ErrorCode.package(1)

class Child:
    let name: str
    var parent: Panel? = none

    func init(self, name: str):
        self.name = name

    func deinit(self):
        print(f"gone {self.name}")

class Panel:
    let title: str
    var refresh: func() -> str
    let child: Child

    func init(self, title: str, fail: bool) -> unit!:
        self.title = title
        self.refresh = func () -> str:
            return self.title
        self.child = Child("child of " + title)
        self.child.parent = self
        if fail:
            error(bad, "no room")

    func deinit(self):
        print(f"gone panel {self.title}")

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    for n in 0..<3:
        let failed: Panel? = Panel(f"p{n}", true) catch failure:
            print("failed:", failure.message)
            recover none
        print(failed is none)
    let kept = try Panel("kept", false)
    print(kept.refresh())
    # the kept panel's own references back to it go, so it ends with its binding
    kept.child.parent = none
    kept.refresh = func () -> str:
        return "done"
    print("- end")
    return 0
