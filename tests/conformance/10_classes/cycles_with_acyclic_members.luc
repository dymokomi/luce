# A cycle whose objects hold acyclic values (text, lists of text and numbers, a class of
# plain fields) is still collected: the collector skips those values, never the cycle.
class Plain:
    pub let label: str
    pub let values: list[int]

    func init(self, label: str):
        self.label = label
        self.values = [1, 2, 3]

class Link:
    pub let name: str
    pub var words: list[str]
    pub var plain: Plain
    pub var other: Link? = none

    func init(self, name: str):
        self.name = name
        self.words = ["a", "b"]
        self.plain = Plain(name)

    func deinit(self):
        print(f"deinit {self.name} {self.words.length} {self.plain.values.length}")

func make():
    let a = Link("a")
    let b = Link("b")
    a.other = b
    b.other = a
    a.words.append("c")

pub func main(arguments: list[str]) -> int!:
    make()
    var kept: list[str] = []
    for i in 0..<3000:
        kept.append(f"{i}")
    print(f"built {kept.length}")
    return 0
