# §9, §10.3: a struct, an enum payload, a tuple or an optional that holds an object copies
# the reference when it is copied and lets go of it when it goes; a function may hand
# such a value back; `match` binds copies of a payload; a conditional or `else`
# produces an owned value whichever side it takes.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

struct Slot:
    var item: Tracer?
    var count: int

enum Box:
    empty
    filled(item: Tracer)

func fill(name: str) -> Box:
    return Box.filled(item = Tracer(name))

func pair(name: str) -> (Tracer, int):
    return (Tracer(name), 1)

func choose(first: bool) -> Tracer:
    return Tracer("yes") if first else Tracer("no")

pub func main(arguments: list[str]) -> int!:
    print("- struct")
    if true:
        var slot = Slot(item = Tracer("s1"), count = 1)
        let copy = slot
        slot.item = none
        print("s1 still held by the copy")
    print("- enum")
    if true:
        let box = fill("e1")
        match box:
            .filled(item):
                print("bound", item.name)
            .empty:
                print("empty")
        print("arm left")
    print("- match expression")
    let described = match fill("e2"):
        .filled(item) => item.name
        .empty => "nothing"
    print(described)
    print("- tuple")
    if true:
        let (t, n) = pair("t1")
        print(t.name, n)
    print("- conditional and else")
    let chosen = choose(false)
    print(chosen.name)
    let fallback: Tracer? = none
    let picked = fallback else Tracer("fb")
    print(picked.name)
    print("- end")
    return 0
