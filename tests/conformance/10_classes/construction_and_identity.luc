# §10.1, §10.2: a class is constructed like a struct and shared like nothing else. `let`
# fields are set in `init` and never again; `var` fields change through any binding;
# `is` compares identity. A class with defaults for every field needs no `init`.
class Document:
    let title: str
    var dirty: bool = false
    var pages: int = 0

    func init(self, title: str):
        self.title = title

    pub func append(self):
        self.pages += 1
        self.dirty = true

    pub func describe(self) -> str:
        return f"{self.title}: {self.pages} pages, {"dirty" if self.dirty else "clean"}"

class Counter:
    var n: int = 0

    pub func bump(self) -> int:
        self.n += 1
        return self.n

func fill(document: Document, count: int):
    for i in 0..<count:
        document.append()

pub func main(arguments: list[str]) -> int!:
    let first = Document("Draft")
    let second = first
    second.dirty = true
    print(first.describe())
    print(first is second, first is not second)
    let third = Document("Draft")
    print(first is third)
    fill(third, 3)
    print(third.describe())
    let counter = Counter()
    discard(counter.bump())
    print(counter.bump(), counter.n)
    var current = first
    current = third
    print(current is third, current.title)
    let maybe: Document? = none
    print(maybe is none, maybe is not none)
    return 0
