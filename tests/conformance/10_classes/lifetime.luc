# §10.3: an object goes when its last reference does, deterministically. A binding lets go
# when it leaves its scope (later bindings first) or is reassigned; a field when it is
# reassigned or its owner is destroyed (`deinit` first, then the fields, last first); a
# temporary at the end of its statement. A struct copies its references; `with` closes.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

class Holder:
    let name: str
    var item: Tracer?

    func init(self, name: str, item: Tracer?):
        self.name = name
        self.item = item

    func deinit(self):
        print(f"gone {self.name}")

class Resource:
    let name: str
    var open: bool = true

    func init(self, name: str):
        self.name = name
        print(f"open {name}")

    pub func close(self):
        if self.open:
            self.open = false
            print(f"close {self.name}")

    func deinit(self):
        print(f"gone {self.name}")

struct Pair:
    var left: Tracer
    var right: Tracer

func make(name: str) -> Tracer:
    return Tracer(name)

func describe(t: Tracer) -> str:
    return t.name

pub func main(arguments: list[str]) -> int!:
    print("- scope")
    if true:
        let a = Tracer("a")
        let b = Tracer("b")
        print("end of scope")
    print("- reassignment")
    var current = Tracer("c1")
    current = Tracer("c2")
    print("- temporary")
    print(describe(Tracer("t")))
    print(make("u").name)
    print("- fields")
    if true:
        let h = Holder("h", Tracer("i"))
        print("holder built")
    print("- field reassignment")
    let h2 = Holder("h2", Tracer("f1"))
    h2.item = Tracer("f2")
    h2.item = none
    print("- struct")
    if true:
        let p = Pair(left = Tracer("l"), right = Tracer("r"))
        let q = p
        print(q.left.name)
    print("- return")
    let kept = make("k")
    print(kept.name)
    print("- with")
    with Resource("w") as r:
        print("using", r.name)
    print("- end")
    return 0
