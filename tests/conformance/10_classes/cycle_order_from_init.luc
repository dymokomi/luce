# §10.3, RUNTIME (Cycles): an `init` that makes a child refer back to the object makes no
# candidate of the child, in the interpreter as in a compiled program, so the end of the run
# discovers the cycle from the object and runs its deinit first, then the child's.
class Child:
    let id: int
    var owner: Panel? = none

    func init(self, id: int):
        self.id = id

    func deinit(self):
        print(f"gone child {self.id}")

class Panel:
    let id: int
    let child: Child

    func init(self, id: int):
        self.id = id
        self.child = Child(id + 100)
        self.child.owner = self

    func deinit(self):
        print(f"gone panel {self.id}")

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    let first = Panel(1)
    let second = Panel(2)
    print("made", first.id, second.id)
    return 0
