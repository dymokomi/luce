# §10.1, §10.3: an `init` may fail; the object then never existed: the fields assigned so
# far are released, no `deinit` runs, and the failure reaches the caller.
let bad = ErrorCode.package(1)

class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

class Account:
    let owner: str
    var balance: int
    let tag: Tracer

    func init(self, owner: str, balance: int) -> unit!:
        self.tag = Tracer("tag")
        if balance < 0:
            error(bad, "negative balance")
        self.owner = owner
        self.balance = balance

    func deinit(self):
        print("gone account")

pub func main(arguments: list[str]) -> int!:
    let ok = try Account("ann", 10)
    print(ok.owner, ok.balance)
    let failed: Account? = Account("bob", -1) catch failure:
        print("failed:", failure.message)
        recover none
    print(failed is none)
    print("- end")
    return 0
