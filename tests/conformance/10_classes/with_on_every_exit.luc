# §8.5: `with` closes its value however the suite ends: a failure passing through, a
# `return`, a `break` out of a loop around it, and the ordinary end; several values are
# nested: the last is closed and let go of, then the one before it.
let bad = ErrorCode.package(1)

class Resource:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"open {name}")

    pub func close(self):
        print(f"close {self.name}")

    func deinit(self):
        print(f"gone {self.name}")

func fail_inside() -> unit!:
    with Resource("f") as r:
        print("about to fail with", r.name)
        error(bad, "boom")

func return_inside() -> int:
    with Resource("r") as r:
        if r.name == "r":
            return 1
    return 0

pub func main(arguments: list[str]) -> int!:
    fail_inside() catch failure:
        print("caught", failure.message)
    print(return_inside())
    for i in 0..<3:
        with Resource("b") as r:
            if i == 1:
                break
            print("loop", i)
    with Resource("x") as x, Resource("y") as y:
        print("using", x.name, y.name)
    print("- end")
    return 0
