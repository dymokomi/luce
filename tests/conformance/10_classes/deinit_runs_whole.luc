# §10.3: a `deinit` runs every statement, whatever let its object go: the end of a scope, a
# `return` carrying a value, a `break` or `continue`, or a failure on its way out. (The
# interpreter once stopped a deinit after its first statement when a jump was in flight.)
let bad = ErrorCode.package(1)

class Guard:
    let name: str

    func init(self, name: str):
        self.name = name

    func deinit(self):
        let size = self.name.length
        if size > 0:
            print("closing", self.name)
        print(f"closed {self.name} {size}")

func returns(n: int) -> int:
    let g = Guard("return")
    return n * 2

func fails() -> int!:
    let g = Guard("failure")
    error(bad, "no")

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    print(returns(4))
    for i in 0..<3:
        let g = Guard(f"loop {i}")
        if i == 0:
            continue
        if i == 1:
            break
    let n = fails() catch failure:
        print("caught", failure.message)
        recover 0
    print(n)
    let last = Guard("main")
    print("end")
    return 0
