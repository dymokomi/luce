# §10.3, RUNTIME (Cycles): a collection during the run frees a garbage cycle that refers to an
# object still in use, and that object loses exactly the reference the garbage held. (The
# collector once took two, so the live object went early and was released again at the end.)
class Node:
    let id: int
    var next: Node? = none
    var items: list[Node] = []

    func init(self, id: int):
        self.id = id

    func deinit(self):
        if self.id < 10:
            print(f"gone {self.id}")

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let live = Node(0)
    if true:
        let a = Node(1)
        let b = Node(2)
        a.next = b
        b.next = a
        a.items = [live, live]
        b.items = [live]
    print("the cycle is garbage")
    # more than 1024 possible roots: the collector runs now, mid-run, and frees the cycle
    let many: list[Node] = []
    for i in 0..<1100:
        many.append(Node(100 + i))
    for n in many:
        let held = n
        _ = held
    print("still here", live.id, live.items.length)
    many.clear()
    print("end")
    return 0
