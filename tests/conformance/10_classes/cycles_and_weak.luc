# §10.3, §10.4: a cycle nothing refers to is reclaimed by the collector, at the end of the
# run here, its deinits in discovery order; a `Weak` back edge makes no cycle and answers
# `none` once its object is gone.
class Node:
    let name: str
    var next: Node? = none
    var parent: Weak[Node]? = none

    func init(self, name: str):
        self.name = name

    func deinit(self):
        print(f"gone {self.name}")

pub func main(arguments: list[str]) -> int!:
    print("- a cycle, collected at the end of the run")
    if true:
        let a = Node("a")
        let b = Node("b")
        a.next = b
        b.next = a
    print("cycle dropped")
    print("- a weak back edge is no cycle")
    if true:
        let parent = Node("p")
        let child = Node("c")
        parent.next = child
        child.parent = Weak(parent)
        if let link = child.parent:
            if let p = link.get():
                print("parent of c is", p.name)
        print("dropping")
    print("- weak answers none after the object is gone")
    var holder: Node? = Node("n")
    let w = Weak(holder else return 1)
    print(w.get() is not none)
    holder = none
    print(w.get() is none)
    print("- end")
    return 0
