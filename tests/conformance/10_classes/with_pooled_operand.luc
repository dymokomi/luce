## §8.5: a `with` whose resource is built from operands that pool a temporary — a text
## joined at run time, and a value chosen by `else` — writes that operand's prelude at the
## statement's own indent, not the body's, so the Base it emits is well-formed.
class Resource:
    let name: str
    let size: int

    func init(self, name: str, size: int):
        self.name = name
        self.size = size

    pub func close(self):
        print(f"close {self.name} {self.size}")

func maybe(n: int) -> int?:
    return n if n > 0 else none

pub func main(arguments: list[str]) -> int!:
    let base = "res"
    let count = arguments.length
    with Resource(base + "-tag", (maybe(count) else 7)) as r:
        print(r.name, r.size)
    return 0
