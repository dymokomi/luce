# §10.1, RUNTIME: an `init` that hands `self` to something outside its own fields and then
# fails would leave that holder pointing at an object that never existed; the program
# stops instead.
let bad = ErrorCode.package(1)

class Registry:
    var callbacks: list[func() -> str]

    func init(self):
        self.callbacks = []

class Widget:
    let name: str

    func init(self, name: str, registry: Registry) -> unit!:
        self.name = name
        registry.callbacks.append(self.describe)
        error(bad, "no room")

    func describe(self) -> str:
        return self.name

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let registry = Registry()
    let widget: Widget? = Widget("w", registry) catch failure:
        recover none
    print(widget is none)
    print(registry.callbacks[0]())
    return 0
