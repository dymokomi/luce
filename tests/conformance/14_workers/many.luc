# §14: tasks spawned in a loop, each waited in turn; nested structures cross by copy, and a
# worker's own temporaries are released when its task ends.
struct Point:
    var x: int
    var y: int

enum Shape:
    dot(pos: Point)
    line(start: Point, stop: Point)

func length(shape: Shape) -> int:
    match shape:
        .dot(pos): return pos.x + pos.y
        .line(start, stop): return (stop.x - start.x) + (stop.y - start.y)

func describe(names: map[str, int], key: str) -> str?:
    if let n = names[key]:
        return f"{key}={n}"
    return none

pub func main(arguments: list[str]) -> int!:
    var total = 0
    for i in 0..<8:
        let t = spawn length(Shape.line(start = Point(x = 0, y = 0), stop = Point(x = i, y = i)))
        total += wait t
    print(total)
    let names = {"a": 1, "b": 2}
    let found = spawn describe(names, "b")
    let missing = spawn describe(names, "c")
    print(wait found else "-", wait missing else "-")
    let s = spawn length(Shape.dot(pos = Point(x = 3, y = 4)))
    print(wait s)
    return 0
