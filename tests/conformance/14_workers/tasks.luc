# §14: `spawn f(args)` runs a named function on a worker with copies of sendable arguments
# and answers a task; `wait` gives the result or the failure. A collection sent is a copy: a
# change after the spawn is not seen. A task never waited is waited when it is let go of.
let bad = ErrorCode.package(3)

struct Job:
    var name: str
    var weights: list[int]

func total(job: Job) -> int:
    var sum = 0
    for w in job.weights:
        sum += w
    return sum

func shout(text: str, times: int) -> str:
    return text.repeat(times)

func risky(n: int) -> int!:
    if n < 0:
        error(bad, "negative")
    return n * 2

func nothing(n: int):
    discard(n)

func pairs(items: list[str]) -> list[(str, int)]:
    var out: list[(str, int)] = []
    for item in items:
        out.append((item, item.length))
    return out

pub func main(arguments: list[str]) -> int!:
    let a = spawn total(Job(name = "a", weights = [1, 2, 3]))
    let b = spawn shout("ab", 3)
    let (x, y) = (wait a, wait b)
    print(x, y)
    let ok = spawn risky(21)
    let failing = spawn risky(-1)
    print(try wait ok)
    let recovered = wait failing catch failure:
        print("caught", failure.message)
        recover 0
    print(recovered)
    let quiet = spawn nothing(1)
    wait quiet
    let words = ["x", "yy"]
    let p = spawn pairs(words)
    words.append("zzz")
    print(wait p, words)
    let dropped = spawn total(Job(name = "d", weights = [5]))
    discard(dropped)
    return 0
