# error: is not sendable: a worker takes scalars, texts, tuples, structs, enums and copies of collections of those
class Owner:
    let value: int = 1

func read(result: Result[Owner]) -> int:
    match result:
        .success(owner): return owner.value
        .failure(failure): return 0

pub func main(arguments: list[str]) -> int!:
    let worker = spawn read(Result[Owner].success(Owner()))
    return wait worker
