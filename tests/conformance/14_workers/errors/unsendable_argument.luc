# error: 9:31: a `Counter` is not sendable: a worker takes scalars, texts, tuples, structs, enums and copies of collections of those (§14)
class Counter:
    var n: int = 0

func read(c: Counter) -> int:
    return c.n

pub func main(arguments: list[str]) -> int!:
    let t = spawn read(Counter())
    return wait t
