# §11.3, §11.4: the operations of `str`, all by content: search, split and lines, trim,
# ASCII case, replace and repeat, the bytes behind a text and a text from bytes.
pub func main(arguments: list[str]) -> int!:
    let text = "  Hello, héllo world  "
    let t = text.trim()
    print(t, t.length, t.byte_count)
    print(t.contains("héllo"), t.contains("bye"), t.starts_with("Hello"), t.ends_with("world"), t.ends_with("World"))
    print(t.index_of("héllo"), t.index_of("world"), t.index_of("zzz"), t.index_of(""))
    print("a,b,,c".split(","), "abc".split(","), "".split(","), "a--b--c".split("--"))
    print("one\ntwo\r\nthree\n".lines(), "single".lines(), "".lines(), "\n\n".lines())
    print(t.upper(), t.lower(), "MiXed 123".upper())
    print("banana".replace("an", "AN"), "aaa".replace("a", "bb"), "abc".replace("x", "y"))
    print("ab".repeat(3), "x".repeat(0), "".repeat(5) == "")
    let raw = "hé".bytes()
    print(raw, raw.length, raw[0], raw[1..])
    print(try raw.text(), try (b"ab" + b"c").text(), b"ab" + b"c" == b"abc")
    let bad = b"\xff".text() catch failure:
        print("caught", failure.message)
        recover "?"
    print(bad)
    for c in "héy":
        print(c, c.byte_count)
    return 0
