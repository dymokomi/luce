# A field of a list's element is a place: a store through `items[i]` changes the element
# in the list, whether it is an object or a struct, and takes no reference of its own.
class Item:
    pub var value: int = 0

struct Point:
    pub var x: int = 0

class Holder:
    pub var items: list[Item]
    pub var points: list[Point]

    func init(self):
        self.items = [Item(), Item()]
        self.points = [Point()]

pub func main(arguments: list[str]) -> int!:
    var items: list[Item] = [Item(), Item()]
    items[0].value = 1
    items[1].value += 2
    items[-1].value *= 5
    var points: list[Point] = [Point(), Point()]
    points[1].x = 4
    var grid: list[list[Point]] = [[Point()], [Point(), Point()]]
    grid[1][0].x = 9
    let holder = Holder()
    holder.items[1].value = 6
    holder.points[0].x = 8
    print(f"{items[0].value} {items[1].value} {points[0].x} {points[1].x} {grid[1][0].x}")
    print(f"{holder.items[1].value} {holder.points[0].x}")
    return 0
