## §5.3, §11.3: `+=` on a text makes a new text and lets the old one go, wherever the text
## lives: a local, a field, a captured variable, a list element; nothing is left alive.
class Buffer:
    var text: str = ""
    var lines: int = 0

    func init(self):
        discard(0)

    func add(self, piece: str):
        self.text += piece
        self.text += "\n"
        self.lines += 1

func build(n: int) -> str:
    var out = ""
    var i = 0
    while i < n:
        out += str(i)
        out += ","
        i += 1
    return out

func collector() -> func(str) -> str:
    var seen = ""
    return func (piece: str) -> str:
        seen += piece
        return seen

pub func main(arguments: list[str]) -> int!:
    var s = "a"
    let t = "b"
    s += t
    s += "c" + "d"
    s += s
    print(s, build(5))
    for c in "xyz":
        s += c.upper()
    print(s)
    let buffer = Buffer()
    buffer.add("one")
    buffer.add("two")
    print(buffer.text.lines(), buffer.lines)
    let collect = collector()
    discard(collect("p"))
    print(collect("q"), collect("r"))
    var words = ["k", "l"]
    words[0] += "!"
    words[-1] += "?"
    print(words)
    var pairs = [("m", 1)]
    var (first, n) = pairs[0]
    first += "n"
    n += 1
    print(first, n, pairs)
    return 0
