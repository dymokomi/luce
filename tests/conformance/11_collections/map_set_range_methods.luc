## §11.2 and §6.6: `get` with a default, `update`, the set tests, `is_empty`, and ranges with
## a step and a direction, as values and in `for`.
pub func main(arguments: list[str]) -> int!:
    let ages = {"Ada": 36, "Grace": 45}
    print(ages.get("Ada", 0), ages.get("Alan", -1), ages.is_empty)
    ages.update({"Grace": 46, "Alan": 41})
    ages.update(ages)
    print(ages)
    let names: map[str, list[str]] = {}
    let missing = names.get("x", ["none"])
    missing.append("still a copy")
    print(missing, names.length)
    let a = {1, 2, 3}
    let b = {2, 3, 4}
    print(a.symmetric_difference(b), a.is_subset({1, 2, 3, 4}), a.is_superset({1, 2}), a.is_disjoint({7, 8}), a.is_disjoint(b))
    let empty: set[int] = {}
    print(empty.is_empty, empty.is_subset(a), a.is_superset(empty))
    let evens = (0..<10).step(2)
    print(evens, evens.length, evens.contains(4), evens.contains(5), 6 in evens, (0..<10).reversed())
    for i in (0..<10).step(3):
        print(i, terminator_free(i))
    var down: list[int] = []
    for i in (1..=10).step(3).reversed():
        down.append(i)
    print(down, (1..=10).step(3).reversed().step(2), (10..<0).is_empty, (0..=0).length)
    var walked: list[int] = []
    let r = (5..=1).reversed()
    for i in r:
        walked.append(i)
    for i in (1..=5).reversed().step(2):
        walked.append(i)
    print(walked, r.length, (0..<10).step(4) == (0..<10).step(4), (0..<10).step(4) == (0..<11).step(4))
    let big = -9223372036854775807 - 1
    print((big..=9223372036854775807).step(4611686018427387904).length, (big..<big).length)
    return 0

func terminator_free(i: int) -> str:
    return "even" if i % 2 == 0 else "odd"
