# §11: an enum of more than 64 cases compares inside a list and keys a map; the
# equality and hashing emitted for it must stay valid Base, which asks a match over
# that many cases for a `_` arm.
enum Wide:
    c0
    c1
    c2
    c3
    c4
    c5
    c6
    c7
    c8
    c9
    c10
    c11
    c12
    c13
    c14
    c15
    c16
    c17
    c18
    c19
    c20
    c21
    c22
    c23
    c24
    c25
    c26
    c27
    c28
    c29
    c30
    c31
    c32
    c33
    c34
    c35
    c36
    c37
    c38
    c39
    c40
    c41
    c42
    c43
    c44
    c45
    c46
    c47
    c48
    c49
    c50
    c51
    c52
    c53
    c54
    c55
    c56
    c57
    c58
    c59
    c60
    c61
    c62
    c63
    c64
    c65
    c66
    c67
    c68
    c69

pub func main(arguments: list[str]) -> int!:
    let keys = [Wide.c3, Wide.c66, Wide.c69]
    print(keys == [Wide.c3, Wide.c66, Wide.c69])
    print(keys == [Wide.c3, Wide.c66, Wide.c68])
    var counts: map[Wide, int] = {}
    counts[Wide.c67] = 2
    print(counts[Wide.c67] else 0)
    print(counts[Wide.c1] else 0)
    return 0
