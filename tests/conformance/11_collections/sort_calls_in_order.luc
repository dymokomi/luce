## §11.1: a sort, a key and a comparison are called in one order in every execution, and
## the sort is stable, by the elements or by a key, either way round.
class Log:
    var lines: list[str] = []

struct Card: Equatable, Ordered:
    let rank: int
    let suit: str
    let log: Log

    func equals(self, other: Card) -> bool:
        return self.rank == other.rank

    func compare(self, other: Card) -> int:
        self.log.lines.append(f"{self.rank}{self.suit}?{other.rank}{other.suit}")
        return self.rank - other.rank

pub func main(arguments: list[str]) -> int!:
    let log = Log()
    var cards: list[Card] = []
    for (rank, suit) in [(3, "h"), (1, "s"), (3, "s"), (2, "d"), (1, "h")]:
        cards.append(Card(rank = rank, suit = suit, log = log))
    cards.sort()
    print(cards.map((c) => f"{c.rank}{c.suit}"))
    print(log.lines)
    log.lines.clear()
    let keyed = cards.sorted(key = (c) => c.suit, reverse = true)
    print(keyed.map((c) => f"{c.rank}{c.suit}"))
    print((cards.max() else cards[0]).suit, (cards.min() else cards[0]).suit, log.lines.length)
    return 0
