# §10.3, §11.1: a list owns its elements: appending takes a reference, an element read is
# a copy of its own (`first` keeps `a` alive past its replacement), removing hands the
# element back, and a list lets its elements go, in order, when it goes; a list of lists
# likewise.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

func names(items: list[Tracer]) -> list[str]:
    var out: list[str] = []
    for item in items:
        out.append(item.name)
    return out

pub func main(arguments: list[str]) -> int!:
    print("- appending and reading")
    var items: list[Tracer] = []
    items.append(Tracer("a"))
    items.append(Tracer("b"))
    let first = items[0]
    print(first.name, names(items))
    print("- removing")
    let taken = items.remove_at(1)
    print(taken.name, items.length)
    items[0] = Tracer("c")
    print("replaced")
    print("- clearing")
    items.clear()
    print("cleared")
    print("- a list going away")
    if true:
        let inner = [Tracer("d"), Tracer("e")]
        let outer = [inner, [Tracer("f")]]
        print(outer.length, outer[0].length)
    print("- end")
    return 0
