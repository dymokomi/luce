# Clearing a map or a list lets its entries go only once it no longer holds them. Each
# entry here points at a shared object still held elsewhere, so letting an entry go makes
# that object a collector candidate; thousands of them fill the candidate buffer and run
# the collector in the middle of `clear()`, and its walk reaches the collection through
# `owner`, itself a candidate. A walk that still found the entries already let go of would
# visit freed objects.
class Item:
    pub let n: int
    pub var other: Item? = none

    func init(self, n: int):
        self.n = n

class Owner:
    pub let items: map[int, Item]
    pub let rows: list[Item]

    func init(self):
        self.items = {}
        self.rows = []

func fill(owner: Owner, shared: list[Item], count: int):
    for i in 0..<count:
        let s = Item(-i)
        shared.append(s)
        let item = Item(i)
        item.other = s
        owner.items[i] = item
        let row = Item(i)
        row.other = s
        owner.rows.append(row)

func size(owner: Owner) -> int:
    return owner.items.length + owner.rows.length

pub func main(arguments: list[str]) -> int!:
    let owner = Owner()
    let shared: list[Item] = []
    fill(owner, shared, 3000)
    let alias = [owner]
    print(size(alias[0]))
    owner.items.clear()
    print(size(alias[0]))
    owner.rows.clear()
    print(size(alias[0]))
    fill(owner, shared, 3000)
    for i in 0..<3000:
        _ = owner.items.remove(i)
    owner.items[7] = Item(7)
    owner.rows.append(Item(8))
    print(size(alias[0]), shared.length)
    return 0
