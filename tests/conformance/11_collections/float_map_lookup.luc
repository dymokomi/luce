class Values:
    var entries: map[str, float]

    pub func init(self):
        self.entries = {}

    func put(self, key: str, value: float):
        self.entries[key] = value

    func get(self, key: str) -> float?:
        return self.entries[key]

pub func main(arguments: list[str]) -> int!:
    let values = Values()
    values.put("zero", 0.0)
    values.put("positive", 7.0)
    values.put("negative", -2.5)
    for key in ["zero", "positive", "negative"]:
        let value = values.get(key) else trap("lost float entry")
        print(key, value)
    print(values.get("missing") == none)
    return 0
