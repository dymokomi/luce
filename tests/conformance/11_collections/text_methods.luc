## §11.3: the conveniences of `str`, as Python's where Python has them, ASCII where case and
## classes are concerned, and every width counted in scalars.
pub func main(arguments: list[str]) -> int!:
    let padded = " \t pad me \n"
    print(f"[{padded.trim()}] [{padded.trim_start()}] [{padded.trim_end()}]")
    print("  a  b\tc\n d  ".split(), "".split(), "a,,b".split(","), "a,,b".split(separator = ","))
    print("banana".count("an"), "aaaa".count("aa"), "banana".count("x"))
    print("banana".last_index_of("an"), "héllo".last_index_of("l"), "abc".last_index_of("z"), "abc".last_index_of(""))
    print("unhappy".remove_prefix("un"), "unhappy".remove_prefix("x"), "file.txt".remove_suffix(".txt"), "a".remove_suffix("abc"))
    print(f"[{"7".pad_left(3, "0")}] [{"ab".pad_right(5)}] [{"ab".center(5)}] [{"abc".center(6, fill = "*")}] [{"héllo".center(9, "·")}] [{"long".pad_left(2)}]")
    print("hELLO wORLD".capitalize(), "hello wORLD's élan, 3rd-place".title(), "".capitalize())
    print("123".is_digit(), "12a".is_digit(), "".is_digit(), "abC".is_alpha(), "ab1".is_alnum(), " \t\n".is_space(), "é".is_alpha())
    print("héllo".reversed(), "".reversed(), "héllo".characters(), "".is_empty, "x".is_empty)
    let words: list[str] = []
    let ages = {"Ada": 36}
    let seen: set[int] = {}
    print(words.is_empty, [1].is_empty, ages.is_empty, seen.is_empty)
    return 0
