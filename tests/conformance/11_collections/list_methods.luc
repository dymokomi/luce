## §11.1: the conveniences of `list`, as Python's built-ins and list methods do them.
struct Person:
    let name: str
    let age: int

class Tag:
    let label: str

    func init(self, label: str):
        self.label = label

pub func main(arguments: list[str]) -> int!:
    var values = [5, 3, 8, 1, 9, 2]
    values.extend([7, 3])
    values.extend(values)
    print(values, values.count(3), values.remove(8), values.remove(42), values.length)
    print(values.is_empty, [0][..<0].is_empty, values.min(), values.max(), values.sum())
    let empty: list[int] = []
    print(empty.min(), empty.max(), empty.sum(), [0.1, 0.2, 0.3].sum(), [1e100, 1.0, -1e100].sum())
    values.sort(reverse = true)
    print(values)
    let people = [Person(name = "Ada", age = 36), Person(name = "Grace", age = 45), Person(name = "Alan", age = 36), Person(name = "Edsger", age = 72)]
    let by_age = people.sorted(key = (p) => p.age)
    print(by_age.map((p) => p.name))
    print(people.sorted(key = (p) => p.age, reverse = true).map((p) => p.name))
    print(people.sorted(key = (p) => (-p.age, p.name)).map((p) => p.name))
    print((people.min(key = (p) => p.age) else people[0]).name, (people.max(key = (p) => p.name.length) else people[0]).name)
    print(values.any((n) => n > 8), values.all((n) => n > 0), values.find((n) => n % 2 == 0), values.find((n) => n > 100))
    print(values.reduce((total, n) => total + n, 0), ["a", "b", "c"].reduce((text, s) => s + text, ""))
    print([1, 2, 3].zip(["one", "two"]), [1, 2, 3, 4, 5].chunks(2), [3, 1, 3, 2, 1].distinct())
    print(["x", "y"].indexed(), [[1, 2], [3]].flat_map((part) => part.reversed()))
    let words = ["pear", "fig", "apple", "fig"]
    print(words.sorted(key = (w) => w.length), words.distinct().sorted())
    let tags = [Tag("b"), Tag("a")]
    tags.sort(key = (t) => t.label)
    print(tags.map((t) => t.label), tags.find((t) => t.label == "b") != none)
    return 0
