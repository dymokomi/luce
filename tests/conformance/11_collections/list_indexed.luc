# `for (index, value) in values.indexed()` (§8.3, §11.1): each element with its index
pub func main(arguments: list[str]) -> int!:
    let names = ["ada", "bo", "cy"]
    for (index, name) in names.indexed():
        print(f"{index}: {name}")
    for pair in names.indexed():
        print(f"{pair.0} {pair.1}")
    var total = 0
    for (i, _) in [5, 6, 7].indexed():
        total += i
    print(f"{total}")
    return 0
