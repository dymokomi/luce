# §11.1, §12.1: a collection of optionals takes `none` anywhere in its literal, first
# included, for any element type: numbers, text, objects and functions.
class Tag:
    let name: str

    func init(self, name: str):
        self.name = name

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let numbers: list[int?] = [none, 2, none]
    let names: list[str?] = [none, "a"]
    let tags: list[Tag?] = [none, Tag("t")]
    let table: map[str, int?] = {"x": none, "y": 3}
    var total = 0
    for n in numbers:
        total += n else 10
    print(total, names.length, table.length)
    if let t = tags[1]:
        print(t.name)
    print(names[0] == none, table["x"] == none)
    return 0
