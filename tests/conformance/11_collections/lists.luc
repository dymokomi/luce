# §11.1: a list is a growable ordered collection with identity. Its operations, its
# indexing from either end, its slices as copies, `+`, `==` by contents, `in`, and
# iteration in order.
func double(n: int) -> int:
    return n * 2

func odd(n: int) -> bool:
    return n % 2 == 1

func total(values: list[int]) -> int:
    var sum = 0
    for v in values:
        sum += v
    return sum

pub func main(arguments: list[str]) -> int!:
    var primes = [2, 3, 5, 7]
    print(primes, primes.length, primes[0], primes[-1])
    primes.append(11)
    primes[1] = 33
    print(primes, primes[1..<3], primes[3..], primes[..<2])
    primes.insert(0, 1)
    print(primes.remove_at(2), primes.pop(), primes)
    print(primes.first else -1, primes.last else -1, primes.contains(5), 5 in primes, primes.index_of(5), primes.index_of(99))
    let same = primes
    let copy = primes.copy()
    same.append(100)
    print(primes is same, primes is copy, primes == copy, primes, copy)
    var words = ["pear", "apple", "fig"]
    words.sort()
    print(words, words.sorted(), words.reversed(), words.join(", "))
    words.reverse()
    print(words)
    print([3, 1, 2].sorted(), [1, 2] + [3], [1, 2] == [1, 2], [1, 2] == [2, 1])
    print(primes.map(double), primes.filter(odd), total(primes))
    let nested = [[1, 2], [3]]
    print(nested, nested[1][0], nested.length)
    var empty: list[str] = []
    print(empty, empty.length, empty.first == none)
    empty.clear()
    var count = 0
    for w in words:
        for c in w:
            count += 1
    print(count)
    let names: list[str] = arguments
    print(names.length)
    return 0
