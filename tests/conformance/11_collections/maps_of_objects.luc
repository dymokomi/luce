# §10.3, §11.2: a map owns its keys and values: a replacement lets the old value go at
# once, a removal hands the value back, and the map lets everything go, in entry order,
# when it goes. Keys are equatable and hashable values; objects are values in a map only
# as values.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print(f"make {name}")

    func deinit(self):
        print(f"gone {self.name}")

pub func main(arguments: list[str]) -> int!:
    print("- inserting and replacing")
    var owners: map[str, Tracer] = {}
    owners["a"] = Tracer("a1")
    owners["b"] = Tracer("b1")
    owners["a"] = Tracer("a2")
    print(owners.length)
    print("- removing")
    let taken = owners.remove("b") else return 1
    print(taken.name, owners.length, "b" in owners)
    print("- reading")
    if let found = owners["a"]:
        print(found.name)
    print("- a map going away")
    if true:
        let inner = {"x": Tracer("x"), "y": Tracer("y")}
        print(inner.keys())
    print("- end")
    return 0
