# §11.2: maps and sets have identity, keep insertion order, and need hashable keys.
# `m[key]` is `V?`, `m[key] = v` inserts or replaces in place, `remove` hands the value
# back, `in` looks at keys; a set's operations; `==` by contents; `hash` agrees everywhere.
struct Point:
    var x: int
    var y: int

pub func main(arguments: list[str]) -> int!:
    var ages = {"Ada": 36, "Grace": 45}
    ages["Linus"] = 28
    ages["Ada"] = 37
    print(ages, ages.length, ages["Ada"] else 0, ages["Nobody"] else -1, "Grace" in ages, "Nobody" in ages)
    print(ages.remove("Grace") else -1, ages.remove("Grace") else -1, ages)
    print(ages.keys(), ages.values(), ages.items())
    for (name, age) in ages:
        print(name, age)
    let same = ages
    let copy = ages.copy()
    same["Ken"] = 60
    print(ages is same, ages is copy, ages == copy, copy == {"Ada": 37, "Linus": 28}, {"a": 1} == {"a": 2})
    var empty: map[str, int] = {}
    print(empty, empty.length)
    empty.clear()
    var seen = {3, 1, 2}
    seen.insert(2)
    seen.insert(5)
    print(seen, seen.length, 5 in seen, 4 in seen, seen.remove(1), seen.remove(1), seen)
    let other = {5, 7, 3}
    print(seen.union(other), seen.intersection(other), seen.difference(other), seen == {5, 2, 3}, seen == other)
    var points = {Point(x = 1, y = 2): "a"}
    points[Point(x = 1, y = 2)] = "b"
    points[Point(x = 0, y = 0)] = "origin"
    print(points, points[Point(x = 0, y = 0)] else "?", (1, 2) in {(1, 2), (3, 4)})
    var total = 0
    for p in {1, 2, 3}:
        total += p
    print(total)
    print(hash(1) == hash(1), hash(1) == hash(2), hash("ab") == hash("ab"), hash((1, "x")) == hash((1, "x")), hash([1, 2]) == hash([1, 2]))
    print(hash(0), hash(true), hash("a"), hash((1, 2)), hash({1, 2}) == hash({2, 1}))
    return 0
