## §11.1: the elements leave a list while it sorts, as in Python; a key that changes the
## list traps.
pub func main(arguments: list[str]) -> int!:
    let values = [3, 1, 2]
    values.sort(key = (n) => -n)
    print(values)
    values.sort(key = func (n: int) -> int:
        values.append(n)
        return n
    )
    print(values)
    return 0
