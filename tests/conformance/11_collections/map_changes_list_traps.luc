## §11.1: a function given a list's elements that changes its shape traps, as a `for` does.
pub func main(arguments: list[str]) -> int!:
    let values = [1, 2, 3]
    print(values.map((n) => n * 2))
    let grown = values.map(func (n: int) -> int:
        values.append(n)
        return n
    )
    print(grown)
    return 0
