## §8.1 to §8.3: `if`/`elif`/`else`, `if let`, `while`, `while let`, `for` over ranges,
## text and bytes, labelled `break` and `continue`.
func classify(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    else:
        return "positive"

func find(limit: int) -> int?:
    var i = 0
    while i < limit:
        if i * i > 20:
            return i
        i += 1
    return none

pub func main(arguments: list[str]) -> int!:
    print(classify(-2), classify(0), classify(9))
    if let n = find(100):
        print("found", n)
    if let m = find(3):
        print("found", m)
    else:
        print("none below 3")
    var total = 0
    outer: for i in 0..<10:
        for j in 0..<10:
            if j > i:
                continue outer
            if i == 7:
                break outer
            total += 1
    var letters = ""
    for ch in "héllo":
        letters = ch + letters
    var sum = 0
    for b in b"\x01\x02\x03":
        sum += b
    var count = 0
    var cursor: int? = 3
    while let c = cursor:
        count += c
        cursor = c - 1 if c > 1 else none
    print(total, letters, sum, count)
    return 0
