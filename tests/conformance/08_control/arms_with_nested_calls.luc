# A match arm whose value is another match over a call whose arguments are calls: every
# frame the interpreter opens on the way is closed again, and the empty member list of a
# fresh value is a real (if empty) view. Reduced from a generated program.
struct Point:
    var x: int
    var f: float
    var name: str

struct Counter:
    var n: int

enum Shape:
    circle(radius: float)
    rect(w: int, h: int)
    empty

func shape(x: int) -> Shape:
    match x % 4:
        0: return Shape.empty
        1: return Shape.circle(radius = float(x % 256))
        _: return Shape.rect(w = 1, h = 2)

func len(text: str) -> int:
    return text.length

func mix_of(a: int, b: int, c: int, d: float, e: float, s: str, t: str, flag: bool, o: int?, p: Point, q: Counter) -> int:
    return (a + b + c + int(d * 4.0) + int(e) + s.length + t.length + (1 if flag else 0) + (o else -1) + p.x + q.n) % 1000000007

func g1(n0: int, n1: int, n2: int) -> int:
    return (((((n2 % 1024) % ((-249 % 64) + 1)) % 4096) % 8) ** 2)

pub func main(arguments: list[str]) -> int!:
    var a = -16
    var b = -9
    var c = 41
    var d = 0.0
    var e = 3.0
    var s = "abc"
    var t = "de"
    var flag = false
    var o: int? = none
    var p = Point(x = 1, f = 0.5, name = "pt")
    var q = Counter(n = 3)
    var sum = 0
    for i in 0..<3:
        sum = (sum * 31 + mix_of(a, b, c, d, e, s, t, flag, o, p, q)) % 1000000007
        match shape(i + 1):
            .circle(radius):
                var k1 = int(radius)
                a = k1 + 1
            .rect(w, h):
                a = match (((g1(len(s), a, 249) % 8) ** 3) % 16):
                    1 => p.x + w + h
                    _ => p.x
            .empty:
                sum = (sum * 31 + mix_of(a, b, c, d, e, s, t, flag, o, p, q)) % 1000000007
        print(f"{i} {a} {sum}")
    return 0
