## §8.4: a match expression ends with its arms; the statement on the next line, whether it
## opens with `if`, `else`-less `(`, or an operator's spelling, is its own.
let three = ErrorCode.package(1)

func word(n: int) -> str:
    let w = match n:
        0 => "zero"
        1..<10 => "digit"
        _ => "many"
    if w == "zero":
        return w.upper()
    return w

func total(n: int) -> int:
    var (a, b) = (0, 0)
    let base = match n:
        0 => 1
        _ => n
    (a, b) = (base, base * 2)
    let fallback: int? = match n:
        5 => none
        _ => n
    if let v = fallback:
        return a + b + v
    return a + b

func risky(n: int) -> int!:
    let picked: int? = match n:
        3 => none
        _ => n
    let v = picked else error(three, "three")
    return v * 2

pub func main(arguments: list[str]) -> int!:
    print(word(0), word(4), word(12))
    print(total(0), total(2), total(5))
    print(try risky(1))
    let caught = risky(3) catch failure:
        recover -1
    print(caught)
    return 0
