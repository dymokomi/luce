# RUNTIME 5: a statement's temporaries die when the statement ends, and a `continue`,
# `break` or `return` inside it ends it too. Each jump below leaves a statement that had
# already pooled a text (the f-string argument), so a jump that skipped the drain would
# leave one temporary behind per pass.
import probe

func pick(a: str, b: str) -> int:
    return a.length + b.length

func early(names: map[int, str], k: int) -> int:
    let total = pick(f"k{k}", names[k] else return 0)
    return total

pub func main(arguments: list[str]) -> int!:
    _ = arguments
    let names = {1: "one", 3: "three"}
    let base = probe.pooled()
    var peak = 0
    var total = 0
    for k in 0..<1000:
        peak = peak if peak > probe.pooled() - base else probe.pooled() - base
        total += pick(f"k{k}", names[k] else continue)
    print(f"continue: {total} {peak}")
    var passes = 0
    while true:
        passes += 1
        total += pick(f"k{passes}", names[passes + 1] else break)
    let after_break = probe.pooled() - base
    print(f"break: {passes} {after_break}")
    var seen = 0
    for k in 0..<1000:
        let now = early(names, k) * 0 + probe.pooled() - base
        seen = seen if seen > now else now
    print(f"return: {seen}")
    outer: for k in 0..<10:
        for j in 0..<100:
            total += pick(f"k{j}", names[j] else continue outer)
    let after_outer = probe.pooled() - base
    print(f"outer: {after_outer}")
    return 0
