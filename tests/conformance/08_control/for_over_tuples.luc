## §8.3, §5.2: `for (a, b) in items` destructures a tuple element of a list, a set, a map's
## pairs and an `Iterable`; a part may be `_`, and an object in a part lives for its pass.
class Tracer:
    let name: str

    func init(self, name: str):
        self.name = name
        print("make", name)

    func deinit(self):
        print("gone", self.name)

class Pairs: Iterable[(int, str)]:
    let items: list[(int, str)]

    func init(self, items: list[(int, str)]):
        self.items = items

    func iterator(self) -> Iterator[(int, str)]:
        return PairsIterator(self.items)

class PairsIterator: Iterator[(int, str)]:
    let items: list[(int, str)]
    var at: int = 0

    func init(self, items: list[(int, str)]):
        self.items = items

    func next(self) -> (int, str)?:
        if self.at >= self.items.length:
            return none
        self.at += 1
        return self.items[self.at - 1]

pub func main(arguments: list[str]) -> int!:
    let pairs = [(1, "one"), (2, "two"), (3, "three")]
    var total = 0
    for (n, name) in pairs:
        total += n
        print(n, name)
    for (_, name) in pairs:
        print(name.upper())
    for (n, _) in pairs:
        total += n
    print(total)
    let unique: set[(str, int)] = {("a", 1), ("b", 2), ("a", 1)}
    var joined: list[str] = []
    for (letter, n) in unique:
        joined.append(f"{letter}{n}")
    print(joined.sorted(), unique.length)
    let ages = {"ada": 36, "grace": 45}
    for (name, age) in ages:
        print(name, age + 1)
    for (n, name) in Pairs([(10, "ten"), (20, "twenty")]):
        print(name, n * 2)
    let tracked = [(Tracer("x"), 1), (Tracer("y"), 2)]
    for (tracer, n) in tracked:
        print(tracer.name, n)
    print("after the loop")
    return 0
