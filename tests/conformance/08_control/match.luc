## §8.4: `match` over enums with payloads, literals, ranges, tuples, guards, `_`, and the
## expression form.
enum Shape:
    circle(radius: float)
    rect(width: float, height: float)
    empty

func area(s: Shape) -> float:
    match s:
        .circle(radius):
            return 3.0 * radius ** 2.0
        .rect(width, height):
            return width * height
        .empty:
            return 0.0

func describe(n: int) -> str:
    return match n:
        0 => "zero"
        1..<10 => "digit"
        10..=99 => "two"
        _ if n < 0 => "negative"
        _ => "many"

func corner(p: (int, int)) -> str:
    match p:
        (0, 0):
            return "origin"
        (0, y):
            return f"y axis at {y}"
        (x, _) if x > 100:
            return "far"
        _:
            return "elsewhere"

func maybe(o: int?) -> int:
    match o:
        none:
            return -1
        v:
            return v

pub func main(arguments: list[str]) -> int!:
    print(area(Shape.circle(radius = 2.0)), area(Shape.rect(width = 2.0, height = 3.0)), area(.empty))
    print(describe(0), describe(7), describe(42), describe(-3), describe(1000))
    print(corner((0, 0)), corner((0, 5)), corner((200, 1)), corner((3, 4)))
    print(maybe(none), maybe(9))
    return 0
