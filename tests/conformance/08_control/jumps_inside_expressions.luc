# §12.1: `x else return`, `else break` and `else continue` inside a larger expression end the
# statement there: nothing around the jump runs on, as a member of the optional would,
# and the temporaries made before it go when the statement does, in the same order in
# the interpreter as in a built program.
class Point:
    pub let x: float
    pub func init(self, x: float):
        self.x = x
    pub func doubled(self) -> float:
        return self.x * 2.0

class Noisy:
    pub let name: str
    pub func init(self, name: str):
        self.name = name
    func deinit(self):
        print(f"deinit {self.name}")

func found(want: bool) -> Point?:
    return Point(1.0) if want else none

func pair(a: Noisy, b: float) -> float:
    return b

func nested(want: bool) -> float:
    let total = 10.0 + pair(Noisy("temp"), (found(want) else return -1.0).doubled())
    return total

pub func main(arguments: list[str]) -> int!:
    print(nested(true))
    print(nested(false))
    var sum = 0.0
    for i in 0..<5:
        sum += (found(i % 2 == 0) else continue).x
    print(sum)
    var seen = 0
    while true:
        seen += 1
        let y = (found(seen < 3) else break).doubled()
        print(y)
    print(seen)
    return 0
