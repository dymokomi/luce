# §8.4: a match expression over a text, a tuple, or bytes: literal patterns, alternatives,
# guards, and the value of the arm taken. A tuple subject is read as written by every arm.
func number(word: str) -> int:
    return match word:
        "one" => 1
        "two", "deux" => 2
        _ if word.length > 4 => 100
        _ => 0

func quadrant(p: (int, int)) -> str:
    return match p:
        (0, 0) => "origin"
        (0, _) => "y axis"
        (_, 0) => "x axis"
        _ if p.0 > 0 and p.1 > 0 => "first"
        _ => "elsewhere"

func kind(data: bytes) -> str:
    return match data:
        b"\x00" => "nul"
        b"ab" => "ab"
        _ => "other"

pub func main(arguments: list[str]) -> int!:
    print(number("one"), number("deux"), number("three"), number("x"))
    print(quadrant((0, 0)), quadrant((0, 3)), quadrant((2, 0)), quadrant((1, 1)), quadrant((-1, 1)))
    let a = 4
    let b = 4
    let same = match (a, b):
        (4, 4) => "both four"
        _ => "not both"
    print(same, kind(b"\x00"), kind(b"ab"), kind(b"zz"))
    return 0
