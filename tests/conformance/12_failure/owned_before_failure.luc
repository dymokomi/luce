# RUNTIME 5: an owned value made for a construction, a literal or a map store beside a
# `try` that fails after it is released, in every execution, so a failing statement leaves
# nothing behind.
let bad = ErrorCode.package(1)

struct Pair:
    var name: str
    var items: list[int]

func risky(n: int) -> list[int]!:
    if n < 0:
        error(bad, "negative")
    return [n, n]

func build(label: str, n: int) -> Pair!:
    return Pair(name = label + "!", items = try risky(n))

func store(m: map[str, list[int]], key: str, n: int) -> unit!:
    m[key + "?"] = try risky(n)

func gather(n: int) -> list[list[int]]!:
    return [[n], try risky(n), [n + 1]]

func single(n: int) -> int!:
    if n < 0:
        error(bad, "negative")
    return n * 10

## Scalars beside a failing `try` are evaluated ahead too, in source order.
func ints(n: int) -> list[int]!:
    return [n, try single(n), n + 1]

func entries(n: int) -> map[str, list[int]]!:
    return {"a" + str(n): [n], "b": try risky(n)}

func tag(n: int) -> str!:
    if n < 0:
        error(bad, "negative")
    return "l" + str(n)

func labels(n: int) -> set[str]!:
    return {"a" + str(n), try tag(n)}

enum Shape:
    box(name: str, items: list[int])
    dot

func shape(n: int) -> Shape!:
    return Shape.box(name = "b" + str(n), items = try risky(n))

func pair(n: int) -> (str, list[int])!:
    return ("t" + str(n), try risky(n))

pub func main(arguments: list[str]) -> int!:
    print(try build("p", 1))
    let failed = build("q", -1) catch failure:
        print("build:", failure.message)
        recover Pair(name = "none", items = [])
    print(failed)
    var m: map[str, list[int]] = {}
    try store(m, "k", 2)
    store(m, "j", -2) catch failure:
        print("store:", failure.message)
    print(m)
    print(try gather(3))
    let none_gathered = gather(-3) catch failure:
        print("gather:", failure.message)
        recover []
    print(none_gathered)
    print(try ints(8))
    let no_ints = ints(-8) catch failure:
        print("ints:", failure.message)
        recover []
    print(no_ints)
    print(try entries(4))
    let none_entries = entries(-4) catch failure:
        print("entries:", failure.message)
        recover {}
    print(none_entries)
    print(try labels(5))
    let no_labels = labels(-5) catch failure:
        print("labels:", failure.message)
        recover {}
    print(no_labels)
    print(try shape(6))
    let no_shape = shape(-6) catch failure:
        print("shape:", failure.message)
        recover .dot
    print(no_shape)
    print(try pair(7))
    let no_pair = pair(-7) catch failure:
        print("pair:", failure.message)
        recover ("", [])
    print(no_pair)
    return 0
