## §12.4: once a called function returns, the caller's statement is the one a trap names,
## even when the overflow happens right after the call in the same statement.
func half(n: int) -> int:
    let quotient = n // 2
    return quotient

func nearly(n: int) -> int:
    return 9223372036854775807 - n

pub func main(arguments: list[str]) -> int!:
    let n = arguments.length + 1
    var total = nearly(0)
    total = total + half(n) + half(n + 2)
    print(total)
    return 0
