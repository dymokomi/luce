## §12: optionals read with `if let`, `else` and `match`; results with `try`, `catch`,
## `recover`, `error`; `Error` has a code and a message; a `catch` may `return` or `error`.
let bad_input = ErrorCode.package(1)
let too_big = ErrorCode.package(2)

func parse(text: str) -> int!:
    if text == "":
        error(bad_input, "empty")
    let n = try int(text)
    if n > 999:
        error(too_big, f"over 999: {n}")
    return n

func twice(text: str) -> int!:
    let n = try parse(text)
    return n * 2

func safe(text: str) -> int:
    return parse(text) catch failure:
        if failure.code == bad_input:
            recover -1
        recover -2

func lookup(key: int) -> str?:
    if key == 1:
        return "one"
    return none

func first_or(o: int?, fallback: int) -> int:
    return o else fallback

pub func main(arguments: list[str]) -> int!:
    print(try twice("21"), safe(""), safe("5000"), safe("x"), safe("7"))
    var reason = "ok"
    discard(twice("") catch failure:
        reason = failure.message
        recover 0)
    let described = parse("1000") catch failure:
        recover -1
    print(reason, described, first_or(none, 9), first_or(4, 9), lookup(1) else "?", lookup(2) else "?")
    print(handled())
    return 0

func handled() -> int:
    let n = parse("") catch failure:
        print("caught", failure.code == bad_input, failure.message)
        return 3
    return n
