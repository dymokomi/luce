## §5.3, §12.2: `_ = value` drops a value on purpose. A failure in it propagates, as in a
## binding, or a `catch` handles it; the handled value is dropped too, so the handler may end
## without `recover`.
let empty = ErrorCode.package(1)

class Resource:
    let name: str

    func init(self, name: str):
        self.name = name

    func deinit(self):
        print(f"released {self.name}")

func parse(s: str) -> int!:
    return int(s)

func label(s: str) -> str!:
    if s == "":
        error(empty, "empty label")
    return f"<{s}>"

func open(name: str) -> Resource!:
    if name == "":
        error(empty, "no name")
    return Resource(name)

func checked(s: str) -> int!:
    _ = parse(s)
    return 1

pub func main(arguments: list[str]) -> int!:
    var failed = 0
    _ = parse("x") catch failure:
        failed += 1
    _ = label("") catch failure:
        print(failure.message)
    _ = label("") catch failure:
        recover "none"
    _ = label("a") catch failure:
        failed += 10
    for s in ["1", "y"]: _ = parse(s) catch failure: failed += 100
    _ = open("first")
    _ = open("") catch failure:
        print(failure.message)
    _ = open("second") catch failure:
        failed += 1000
    let outcome = checked("z") catch failure:
        recover -1
    print(failed, outcome, checked("4"))
    return 0
