## §12.4: a trap names the statement the program was running, the innermost one: a
## method's statement, reached through a lambda called by a function.
class Counter:
    var total: int = 0

    func init(self):
        discard(0)

    func add(self, n: int):
        self.total = self.total + n

    func bump(self, n: int) -> int:
        let big = 9223372036854775807
        self.total = big + n
        return self.total

func through(f: func(int) -> int, n: int) -> int:
    let step = n + 1
    return f(step)

pub func main(arguments: list[str]) -> int!:
    let counter = Counter()
    counter.add(arguments.length)
    let result = through((k) => counter.bump(k), counter.total)
    print(result)
    return 0
