# Error edges are checked before lowering. Partial owned values must be gone
# when their handler starts, and lazy branches must never construct them.
let rejected = ErrorCode.package(812)

class State:
    var trace: int = 0
    var dropped: int = 0

class Item:
    let state: State
    let number: int

    func init(self, state: State, number: int):
        self.state = state
        self.number = number

    func deinit(self):
        self.state.dropped += 1

func item(state: State, number: int, fail_at: int) -> Item!:
    state.trace = state.trace * 10 + number
    if number == fail_at:
        error(rejected, "failed " + str(number))
    return Item(state, number)

func total(items: list[Item]) -> int!:
    var result = 0
    for entry in items:
        result += entry.number
    return result

func handled(state: State) -> int:
    return total([item(state, 1, 2), item(state, 2, 2)]) catch failure:
        assert(state.dropped == 1)
        assert(failure.message == "failed 2")
        recover 7

func branch(state: State) -> int!:
    let skipped = false and total([item(state, 3, 3), item(state, 4, 4)]) > 0
    let selected = total([item(state, 5, 0)]) if skipped else total([item(state, 6, 0)])
    return selected

func rethrow(state: State) -> int:
    return (item(state, 1, 1) catch inner:
        error(inner.code, inner.message + " again")
    ).number catch outer:
        assert(outer.message == "failed 1 again")
        recover 9

func stop_loop(state: State):
    for index in 0..<3:
        discard(item(state, index + 1, 1) catch failure:
            assert(failure.code == rejected)
            break
        )

func choose(state: State, number: int) -> int!:
    return match number:
        1 => total([item(state, 1, 1), item(state, 2, 2)])
        2 if total([item(state, 3, 0)]) == 3 => total([item(state, 4, 0)])
        _ => total([item(state, 5, 0)])

func fallback(state: State, present: int?) -> int!:
    return present else total([item(state, 8, 8), item(state, 9, 9)])

func record(state: State, value: int) -> int!:
    state.trace = state.trace * 10 + value
    return value

func numbers(state: State) -> list[int]!:
    discard(record(state, 1))
    return [10, 20, 30]

func digits(first: int, second: int) -> int:
    return first * 10 + second

func eager_order(state: State) -> unit!:
    state.trace = 0
    let sum = record(state, 1) + (record(state, 2) if true else 0)
    assert(sum == 3 and state.trace == 12)
    state.trace = 0
    let named = digits(second = record(state, 2), first = record(state, 3) if true else 0)
    assert(named == 32 and state.trace == 23)
    state.trace = 0
    let entry = numbers(state)[record(state, 2) if true else 0]
    assert(entry == 30 and state.trace == 12)
    state.trace = 0
    let sliced = numbers(state)[record(state, 0)..<(record(state, 2) if true else 3)]
    assert(sliced == [10, 20] and state.trace == 102)
    state.trace = 0
    let text = f"{state.trace} {record(state, 2) if true else 0}"
    assert(text == "0 2" and state.trace == 2)
    assert(true, f"unreached {record(state, 3) if true else 0}")
    assert(state.trace == 2)
    let job = spawn digits(second = record(state, 3), first = record(state, 4) if true else 0)
    assert(wait job == 43 and state.trace == 234)

pub func main(arguments: list[str]) -> int!:
    let state = State()
    assert(handled(state) == 7 and state.trace == 12 and state.dropped == 1)
    state.trace = 0
    assert(branch(state) == 6 and state.trace == 6 and state.dropped == 2)
    state.trace = 0
    assert(rethrow(state) == 9 and state.trace == 1)
    state.trace = 0
    stop_loop(state)
    assert(state.trace == 1)
    let result = Result[int].capture(() => total([item(state, 7, 0)]))
    assert(result.get() == 7 and state.dropped == 3)
    state.trace = 0
    assert(choose(state, 2) == 4 and state.trace == 34 and state.dropped == 5)
    assert(fallback(state, 42) == 42 and state.trace == 34)
    state.trace = 0
    let failed_choice = choose(state, 1) catch failure:
        assert(failure.message == "failed 1")
        recover 11
    assert(failed_choice == 11 and state.trace == 1 and state.dropped == 5)
    let immediate = error(rejected, "direct failure") catch failure:
        assert(failure.message == "direct failure")
        recover 12
    assert(immediate == 12)
    eager_order(state)
    print("ok automatic propagation")
    return 0
