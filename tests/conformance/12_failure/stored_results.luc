# A Result owns its active payload, survives its capture scope, and transfers by
# the ordinary enum rules. Retrieving it does not consume or erase the outcome.
let failed = ErrorCode.package(810)

class Payload:
    let text: str

    func init(self, text: str):
        self.text = text

    func deinit(self):
        print("drop", self.text)

func message() -> str!:
    error(failed, "dynamic " + "message")

func value() -> Payload!:
    return Payload("owned")

func absent() -> int?!:
    return none

func finish() -> unit!:
    print("finished")

func stored() -> Result[str]:
    return Result[str].capture(message)

func inspect(result: Result[str]) -> str:
    match result:
        .success(text): return text
        .failure(failure): return failure.message

func owned():
    let result = Result[Payload].capture(value)
    let values = [result, result]
    match values[0]:
        .success(payload): print(payload.text)
        .failure(failure): print(failure.message)

pub func main(arguments: list[str]) -> int!:
    owned()
    let result = stored()
    print(inspect(result))
    let worker = spawn inspect(result)
    print(wait worker)
    let text = result.get() catch failure:
        print(failure.code == failed, failure.message)
        recover "fallback"
    print(text, inspect(result), try Result[int].success(7).get())
    print(try Result[int?].capture(absent).get() == none)
    try Result[unit].capture(finish).get()
    return 0
