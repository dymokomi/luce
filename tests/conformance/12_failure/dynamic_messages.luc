# Dynamic errors remain valid after catch, through collections and workers, and are reclaimed.
let bad = ErrorCode.package(9)

func fail(n: int) -> int!:
    error(bad, f"failure {n}")

func saved(n: int) -> Error:
    discard(fail(n) catch failure:
        return failure)
    trap("expected failure")

func forward(n: int) -> int!:
    return try fail(n)

func rethrow(n: int) -> int!:
    return fail(n) catch failure:
        error(failure.code, failure.message + " again")

func describe(failure: Error) -> str:
    return failure.message

func worker_saved(n: int) -> Error:
    return saved(n)

pub func main(arguments: list[str]) -> int!:
    var errors: list[Error] = []
    var i = 0
    while i < 2000:
        discard(forward(i) catch failure:
            assert(failure.message == f"failure {i}")
            recover 0)
        i += 1
    errors.append(saved(1))
    errors.append(saved(2))
    discard(fail(3) catch outer:
        discard(fail(4) catch inner:
            assert(inner.message == "failure 4")
            recover 0)
        assert(outer.message == "failure 3")
        recover 0)
    discard(rethrow(5) catch failure:
        print(failure.message)
        recover 0)
    let sent = spawn describe(errors[0])
    print(wait sent)
    let received = spawn worker_saved(6)
    let result = wait received
    print(result.message, errors[1].message)
    let failing = spawn fail(7)
    discard(wait failing catch failure:
        print(failure.message)
        recover 0)
    let abandoned = spawn fail(8)
    discard(abandoned)
    let static = int("bad") catch failure:
        assert(failure.message == "not an integer")
        recover 0
    print("ok")
    return 0
