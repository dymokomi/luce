from json import Value

pub func main(arguments: list[str]) -> int!:
    let object = try Value()
    try object.set_text("message", "Hello, café!\n")
    try object.set_integer("count", 42)
    let items = try Value.array()
    try items.append(try Value.boolean(true))
    try items.append(try Value.null())
    try object.set("items", items)
    print(object.encode())
    return 0
