import interop
import memory
import ownership
import thread

pub let invalid: ErrorCode = ErrorCode.package(1)
var disposed: i64 = 0

pub struct Emitter:
    var signal: interop.Signal[str]
    pub var handler: interop.Callback[str, unit]?
    var total: i64

    pub func init() -> !:
        self.signal = try interop.Signal[str]()
        self.handler = none
        self.total = 0

    pub func connect(callback: interop.Callback[str, unit]) -> interop.Reference[interop.Connection]!:
        return try self.signal.connect(callback)

    pub func emit(text: str) -> interop.Outcome[unit]:
        return self.signal.emit(text)

    pub func stop():
        self.signal.close()

    pub mutating func remember(text: str) -> interop.Outcome[unit]:
        self.total += (i64)text.length
        return interop.Outcome[unit].success(interop.Owned[unit](()))

    pub func count() -> i64:
        return self.total

    pub func answer(value: i64) -> interop.Outcome[str]:
        var buffer: u8[64]
        let text = format(buffer, f"native {value}") catch failure: trap(failure.message)
        return interop.Outcome[str].success(interop.copy_text(text) catch failure: trap(failure.message))

    pub mutating func set_handler(callback: interop.Callback[str, unit]):
        let held = callback.clone()
        if let previous = self.handler:
            previous.release()
        self.handler = held

    pub mutating func close():
        disposed += 1
        self.signal.close()
        self.signal.release()
        if let handler = self.handler:
            self.handler = none
            handler.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.signal.trace(visit, context)
        if let handler = self.handler:
            handler.trace(visit, context)

pub let emitter_type: interop.Type[Emitter] = interop.Type[Emitter](name = "Emitter",
    dispose = Emitter.close, trace = Emitter.trace, closeable = true)

pub func echo(callback: interop.Callback[str, unit]) -> interop.Callback[str, unit]:
    return callback.clone()

pub func native_callback(source: interop.Reference[Emitter]) -> interop.Callback[str, unit]!:
    return try interop.Callback[str, unit].bind_mutating(source, Emitter.remember)

pub func native_answer(source: interop.Reference[Emitter]) -> interop.Callback[i64, str]!:
    return try interop.Callback[i64, str].bind(source, Emitter.answer)

pub func ready(callback: interop.Callback[unit, unit]) -> interop.Outcome[unit]:
    return callback.invoke(())

pub func format_reply(callback: interop.Callback[(str, i64?), str], text: str, number: i64?) -> interop.Outcome[str]:
    return callback.invoke((text, number))

pub func relay_bytes(callback: interop.Callback[const u8[], const u8[]], data: const u8[]) -> interop.Outcome[const u8[]]:
    return callback.invoke(data)

pub func handles_failure(source: interop.Reference[Emitter]) -> bool:
    let result = source.value().emit("failure")
    defer result.release()
    result.get() catch failure:
        return failure.code == invalid and failure.message == "managed failure failure"
    return false

pub struct Frame:
    var text: str
    pub func read() -> str!:
        return self.text

pub let frame_type: interop.ViewType[Frame] = interop.ViewType[Frame](name = "Frame")

pub func with_frame(source: interop.Reference[Emitter], text: str,
                    callback: interop.Callback[interop.View[Frame], unit]) -> interop.Outcome[unit]:
    let lease = source.lease() catch failure: trap(failure.message)
    defer lease.release()
    defer lease.invalidate()
    let frame = interop.View[Frame].make(Frame(text), frame_type, lease) catch failure: trap(failure.message)
    defer frame.release()
    return callback.invoke(frame)

func foreign_thread(context: void*?):
    let callback = (interop.Callback[str, unit]*)(context else trap("missing callback"))
    let result = callback.invoke("wrong thread")
    result.release()

pub func wrong_thread(callback: interop.Callback[str, unit]) -> !:
    let worker = try thread.spawn(foreign_thread, (void*)&callback)
    try worker.join()

pub func dispose_count() -> i64:
    return disposed

pub func collect():
    ownership.collect()
