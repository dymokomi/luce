import events
from interop import Connection

class Observer:
    var text: str = ""
    pub func receive(self, text: str) -> unit!:
        self.text += text

func captures() -> unit!:
    let source = try events.Emitter()
    var text = ""
    let callback = func (value: str) -> unit!:
        text += value
    let connection = try source.connect(callback)
    try source.emit("first")
    let echoed = events.echo(callback)
    try echoed(" second")
    source.set_handler(callback)
    let field = source.handler else trap("missing callback")
    try field(" third")
    assert(text == "first second third")
    connection.disconnect()
    connection.disconnect()
    try source.emit("ignored")
    assert(text == "first second third" and not connection.is_connected())
    let observer = Observer()
    let bound = try source.connect(observer.receive)
    try source.emit("bound")
    assert(observer.text == "bound" and bound.is_connected())
    let native = try events.native_callback(source)
    try native("hello")
    assert(source.count() == 5)
    let answer = try events.native_answer(source)
    assert((try answer(42)) == "native 42")
    source.close()
    native("closed") catch failure:
        assert(failure.message == "a native object is closed")

func results() -> unit!:
    var called = 0
    try events.ready(func () -> unit!:
        called += 1
    )
    assert(called == 1)
    let prefix = "owned "
    let reply = func (input: (str, int?)) -> str!:
        return prefix + input.0 + str(input.1 else 0)
    assert((try events.format_reply(reply, "answer ", 42)) == "owned answer 42")
    let bytes_reply = func (data: bytes) -> bytes!:
        return data
    assert((try events.relay_bytes(bytes_reply, b"payload")) == b"payload")
    let source = try events.Emitter()
    let connection = try source.connect(func (text: str) -> unit!:
        error(events.invalid, "managed failure " + text)
    )
    assert(events.handles_failure(source))
    source.emit("again") catch failure:
        assert(failure.message == "managed failure again")
    assert(connection.is_connected())
    source.close()

func delivery() -> unit!:
    let source = try events.Emitter()
    var calls: list[str] = []
    var first: Connection? = none
    var second: Connection? = none
    var added: Connection? = none
    first = try source.connect(func (value: str) -> unit!:
        calls.append("first " + value)
        if value == "outer":
            (second else trap("missing second")).disconnect()
            added = try source.connect(func (inner: str) -> unit!:
                calls.append("added " + inner)
                if inner == "close":
                    source.stop()
            )
            try source.emit("nested")
        elif value == "disconnect":
            (first else trap("missing first")).disconnect()
    )
    second = try source.connect(func (value: str) -> unit!:
        calls.append("second " + value)
    )
    try source.emit("outer")
    assert(calls == ["first outer", "first nested", "added nested"])
    try source.emit("disconnect")
    assert(calls == ["first outer", "first nested", "added nested", "first disconnect", "added disconnect"])
    let observer = Observer()
    let last = try source.connect(observer.receive)
    try source.emit("close")
    assert(calls[-1] == "added close" and observer.text == "")
    assert(not last.is_connected() and not (added else trap("missing added")).is_connected())
    source.close()

func borrowed_frame() -> unit!:
    let source = try events.Emitter()
    var saved: events.Frame? = none
    try events.with_frame(source, "body", func (frame: events.Frame) -> unit!:
        assert((try frame.read()) == "body")
        saved = frame
    )
    let frame = saved else trap("missing frame")
    assert(not frame.is_valid())
    let result = frame.read() catch failure:
        assert(failure.message == "a native view has expired")
        recover "expired"
    assert(result == "expired")
    source.close()

func mixed_cycle() -> unit!:
    let source = try events.Emitter()
    var connection: Connection? = none
    connection = try source.connect(func (text: str) -> unit!:
        discard(source.count())
        discard(connection)
    )

pub func main(arguments: list[str]) -> int!:
    try captures()
    try results()
    try delivery()
    try borrowed_frame()
    let before = events.dispose_count()
    try mixed_cycle()
    events.collect()
    assert(events.dispose_count() == before + 1)
    return 0
