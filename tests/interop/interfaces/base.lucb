import widgets
import interop
import memory
import ownership

pub func main(arguments: str[]) -> i32!:
    var reservation = try interop.Reservation[widgets.Counter](widgets.counter_type)
    errdefer reservation.cancel()
    let counter = reservation.publish(try new widgets.Counter("base") in memory.heap, memory.heap)
    let widget = widgets.as_widget(counter)
    try widget.enter()
    var native = widget.value()
    let title = native.title()
    assert(title.value == "base")
    title.release()
    let added = native.increase(3)
    assert(try added.get() == 5)
    added.release()
    widget.leave()
    widget.release()
    counter.release()
    assert(widgets.dispose_count() == 1)
    return ownership.finish_run(0)
