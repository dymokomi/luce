import interop
import memory
import ownership

pub let invalid: ErrorCode = ErrorCode.package(1)
var disposed: i64 = 0

pub interface Widget:
    func value() -> i64
    func title() -> interop.Owned[str]
    mutating func increase(amount: i64) -> interop.Outcome[i64]

pub struct Counter: Widget:
    var count: i64
    var text: u8[]

    pub func init(title: str, start: i64 = 2) -> !:
        let text = try alloc u8[title.length] in memory.heap
        memory.copy(text, title.bytes, title.length)
        self.count = start
        self.text = text

    pub func value() -> i64:
        return self.count

    pub func title() -> interop.Owned[str]:
        return interop.copy_text((str)self.text) catch failure: trap(failure.message)

    pub mutating func increase(amount: i64) -> interop.Outcome[i64]:
        if amount < 0:
            return interop.Outcome[i64].failure(invalid,
                interop.copy_text((str)self.text) catch failure: trap(failure.message))
        self.count += amount
        return interop.Outcome[i64].success(interop.Owned[i64](self.count))

    pub mutating func close():
        disposed += 1
        free(self.text) in memory.heap

pub let counter_type: interop.Type[Counter] = interop.Type[Counter](name = "Counter",
    dispose = Counter.close, closeable = true)

pub struct Container:
    pub var child: interop.Interface[Widget]?

    pub func init():
        self.child = none

    pub mutating func set(child: interop.Interface[Widget]):
        let held = child.clone()
        if let previous = self.child:
            previous.release()
        self.child = held

    pub func get() -> interop.Interface[Widget]?:
        let child = self.child else return none
        return child.clone()

    pub func increase(amount: i64) -> interop.Outcome[i64]:
        let child = self.child else return interop.Outcome[i64].failure(invalid, interop.Owned[str]("no widget"))
        child.enter() catch failure:
            return interop.Outcome[i64].failure(failure.code,
                interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
        defer child.leave()
        var native = child.value()
        return native.increase(amount)

    pub mutating func close():
        disposed += 1
        if let child = self.child:
            self.child = none
            child.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let child = self.child:
            child.trace(visit, context)

pub let container_type: interop.Type[Container] = interop.Type[Container](name = "Container",
    dispose = Container.close, trace = Container.trace, closeable = true)

pub func as_widget(counter: interop.Reference[Counter]) -> interop.Interface[Widget]:
    return counter.as_interface[Widget](counter.value())

pub func echo(value: interop.Interface[Widget]) -> interop.Interface[Widget]:
    return value.clone()

pub func increase(value: interop.Interface[Widget], amount: i64) -> interop.Outcome[i64]:
    value.enter() catch failure:
        return interop.Outcome[i64].failure(failure.code,
            interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
    defer value.leave()
    var native = value.value()
    return native.increase(amount)

pub func dispose_count() -> i64:
    return disposed

pub func collect():
    ownership.collect()

pub func first(values: const interop.Interface[Widget][]) -> interop.Interface[Widget]:
    return values[0].clone()

pub interface Action:
    mutating func reset() -> interop.Outcome[unit]

pub func reset(action: interop.Interface[Action]) -> interop.Outcome[unit]:
    action.enter() catch failure:
        return interop.Outcome[unit].failure(failure.code,
            interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
    defer action.leave()
    var native = action.value()
    return native.reset()

## A native borrowed return is safe to copy into Luce, but a managed implementer
## must use the explicit Owned/Outcome contract instead of returning borrowed text.
pub interface NativeLabel:
    func label() -> str

pub struct ValueLabel: NativeLabel:
    pub let text: str
    pub func label() -> str:
        return self.text

pub func native_label(value: interop.Interface[NativeLabel]) -> str:
    let native = value.value()
    return native.label()

pub struct Frame: Widget:
    var count: i64*
    var text: str
    pub func value() -> i64:
        return *self.count
    pub func title() -> interop.Owned[str]:
        return interop.copy_text(self.text) catch failure: trap(failure.message)
    pub mutating func increase(amount: i64) -> interop.Outcome[i64]:
        *self.count += amount
        return interop.Outcome[i64].success(interop.Owned[i64](*self.count))

pub let frame_type: interop.ViewType[Frame] = interop.ViewType[Frame](name = "Frame", mutable = true)

pub func frame(counter: interop.Reference[Counter]) -> interop.View[Frame]!:
    let lease = try counter.lease()
    defer lease.release()
    let native = counter.value()
    return try interop.View[Frame].make(Frame(&native.count, (str)native.text), frame_type, lease)

pub func frame_widget(view: interop.View[Frame]) -> interop.Interface[Widget]:
    return view.as_interface[Widget](view.value_mut())

## Handle a managed failure entirely in Base. No Luce catch is required for cleanup.
pub func handles_failure(widget: interop.Interface[Widget]) -> bool:
    let result = increase(widget, -1)
    defer result.release()
    discard(result.get() catch failure: recover -1)
    return not result.is_success()

pub func raw(value: Widget) -> Widget:
    return value

pub type WidgetAlias = Widget

pub func alias_echo(value: interop.Interface[WidgetAlias]) -> interop.Interface[WidgetAlias]:
    return value.clone()

pub interface Family:
    func children() -> (interop.Reference[Counter], interop.Interface[Widget]?)

pub func children(family: interop.Interface[Family]) -> (interop.Reference[Counter], interop.Interface[Widget]?):
    return family.value().children()
