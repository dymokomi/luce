from widgets import Widget, Counter, Container
import widgets
import exported

class Label: Widget:
    var count: int = 10
    let name: str
    var parent: Container? = none
    var close_on_call: bool = false

    pub func init(self, name: str):
        self.name = name

    pub func value(self) -> int:
        return self.count

    pub func title(self) -> str:
        return "managed " + self.name

    pub func increase(self, amount: int) -> int!:
        if amount < 0:
            error(widgets.invalid, "managed failure " + self.name)
        self.count += amount
        if self.close_on_call:
            let parent = self.parent else trap("missing parent")
            parent.close()
            assert(parent.is_closed())
        return self.count

class Reset: widgets.Action:
    var calls: int = 0
    pub func reset(self) -> unit!:
        self.calls += 1

func edge_cases() -> unit!:
    let action = Reset()
    try widgets.reset(action)
    assert(action.calls == 1)
    let native_value = widgets.ValueLabel("owned " + str(2))
    let native_label: widgets.NativeLabel = native_value
    assert(native_label.label() == "owned 2")
    assert(widgets.native_label(native_label) == "owned 2")
    let resource = try Counter("frame")
    let frame = try widgets.frame(resource)
    let direct: Widget = frame
    let via_native = widgets.frame_widget(frame)
    assert(direct is via_native)
    let read = via_native.title
    let add = via_native.increase
    let snapshot = via_native.title()
    resource.close()
    let failed = add(1) catch failure:
        assert(failure.message == "a native view has expired")
        recover -1
    assert(failed == -1 and not frame.is_valid() and snapshot == "frame")

class Family: widgets.Family:
    let child: Counter
    let widget: Widget
    pub func init(self, child: Counter, widget: Widget):
        self.child = child
        self.widget = widget
    pub func children(self) -> (Counter, Widget?):
        let widget: Widget? = self.widget
        return (self.child, widget)

func reentrant_close() -> unit!:
    let parent = Container()
    let child = Label("closing")
    child.parent = parent
    child.close_on_call = true
    parent.set(child)
    let before = widgets.dispose_count()
    assert((try parent.increase(1)) == 11)
    assert(parent.is_closed() and widgets.dispose_count() == before + 1)

func mixed_cycle() -> unit!:
    let container = Container()
    let child = Label("cycle")
    child.parent = container
    container.set(child)

pub func main(arguments: list[str]) -> int!:
    try edge_cases()
    try reentrant_close()
    let counter = try Counter("native")
    let native: Widget = widgets.as_widget(counter)
    assert(native.value() == 2 and native.title() == "native")
    assert((try native.increase(3)) == 5 and counter.value() == 5)
    assert(native is widgets.as_widget(counter))
    assert(counter is native and native is counter)
    let local = Label("label")
    let managed: Widget = local
    assert(managed is widgets.echo(managed))
    assert(managed is widgets.first([managed]))
    assert(widgets.handles_failure(managed))
    let pair = widgets.children(Family(counter, managed))
    assert(pair.0 is counter and (pair.1 else trap("missing child")) is managed)
    let second: Widget = local
    assert(managed is second)
    assert(managed is widgets.alias_echo(managed))
    assert(managed is exported.echo(managed))
    let mixed: list[Widget] = [counter, local]
    assert(mixed[0].title() == "native" and mixed[1].title() == "managed label")
    assert((try widgets.increase(managed, 4)) == 14 and local.value() == 14)
    let container = Container()
    container.set(local)
    let retained = container.get() else trap("missing widget")
    assert(retained is managed and retained is local)
    assert(retained is (container.child else trap("missing field")))
    assert((try container.increase(2)) == 16 and retained.value() == 16)
    let failed = container.increase(-1) catch failure:
        assert(failure.code == widgets.invalid and failure.message == "managed failure label")
        recover -1
    assert(failed == -1)
    let read = retained.title
    assert(read() == "managed label")
    let before = widgets.dispose_count()
    try mixed_cycle()
    widgets.collect()
    assert(widgets.dispose_count() == before + 1)
    counter.close()
    let closed = native.increase(1) catch failure:
        assert(failure.message == "a native object is closed")
        recover -1
    assert(closed == -1)
    return 0
