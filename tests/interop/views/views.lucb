import interop
import memory
import ownership

pub struct Resource:
    var bytes: u8[]
    var count: i64
    var current: interop.Lease?

    pub func init(text: str) -> !:
        let bytes = try alloc u8[text.length] in memory.heap
        memory.copy(bytes, text.bytes, text.length)
        self.bytes = bytes
        self.count = 0
        self.current = none

    pub mutating func end():
        if let lease = self.current:
            self.current = none
            lease.invalidate()
            lease.release()

    pub mutating func close():
        self.end()
        free(self.bytes) in memory.heap

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let lease = self.current:
            lease.trace(visit, context)

pub let resource_type: interop.Type[Resource] = interop.Type[Resource](
    name = "Resource", dispose = Resource.close, trace = Resource.trace, closeable = true)

pub struct Frame:
    var text: str
    var count: i64*

    pub func read() -> str:
        return self.text

    pub mutating func increase(amount: i64 = 1) -> i64!:
        *self.count += amount
        return *self.count

pub let frame_type: interop.ViewType[Frame] = interop.ViewType[Frame](name = "Frame", mutable = true)

pub func begin(resource: interop.Reference[Resource]) -> interop.View[Frame]!:
    let native = try resource.get()
    native.end()
    let lease = try resource.lease()
    defer lease.release()
    native.current = lease.clone()
    return try interop.View[Frame].make(Frame((str)native.bytes, &native.count), frame_type, lease)

pub func echo(frame: interop.View[Frame]) -> interop.View[Frame]:
    return frame.clone()

pub type BorrowedFrame = Frame
