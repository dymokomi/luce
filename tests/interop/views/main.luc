from views import Resource
import views

pub func main(arguments: list[str]) -> int!:
    let owner = try Resource("borrowed " + str(1))
    let frame = try views.begin(owner)
    let alias = frame
    let reader = frame.read
    let update = frame.increase
    assert(frame.is_valid() and frame is views.echo(frame))
    let snapshot = reader()
    assert(snapshot == "borrowed 1")
    assert((try update(3)) == 3 and (try frame.increase()) == 4)
    owner.end()
    assert(not frame.is_valid() and not alias.is_valid())
    assert(snapshot == "borrowed 1")
    let failed = update(1) catch failure:
        assert(failure.message == "a native view has expired")
        recover -1
    assert(failed == -1)
    let next = try views.begin(owner)
    assert(next.is_valid() and not frame.is_valid())
    owner.close()
    assert(not next.is_valid())
    return 0
