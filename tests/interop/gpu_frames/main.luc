from luce_gpu.gpu import Frame, Rect
from luce_window.window import Size
from luce_window.input import Key
import events

pub func main(arguments: list[str]) -> int!:
    assert(events.key(Key.right_super) == Key.right_super)
    assert(events.key(Key.unknown) == Key.unknown)
    let frame = Frame(Size(width = 80.0, height = 60.0, pixel_width = 160.0, pixel_height = 120.0, scale = 2.0))
    let target = frame.target()
    let child = target.region(Rect(x = 10.0, y = 5.0, width = 30.0, height = 20.0))
    let extent = child.size()
    assert(extent.width == 30.0 and extent.pixel_width == 60.0)
    let saved = child.size
    frame.close()
    var expired = false
    _ = saved() catch failure:
        expired = true
        recover Size()
    assert(expired)
    print("ok scoped GPU frames")
    return 0
