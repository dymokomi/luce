from gpu import Frame, Rect
from window import Size

pub func main(arguments: list[str]) -> int!:
    let frame = try Frame(Size(width = 80.0, height = 60.0, pixel_width = 160.0, pixel_height = 120.0, scale = 2.0))
    let target = try frame.target()
    let child = try target.region(Rect(x = 10.0, y = 5.0, width = 30.0, height = 20.0))
    let extent = try child.size()
    assert(extent.width == 30.0 and extent.pixel_width == 60.0)
    let saved = child.size
    frame.close()
    var expired = false
    discard(saved() catch failure:
        expired = true
        recover Size())
    assert(expired)
    print("ok scoped GPU frames")
    return 0
