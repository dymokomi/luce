## The same public Service used by Luce, with a native per-worker application.
import interop
import ownership
import workers

struct Application:
    var prefix: interop.Owned[str]
    var count: i64

    mutating func answer(message: str) -> interop.Outcome[str]:
        self.count += 1
        var buffer: u8[128]
        let text = format(buffer, f"{self.prefix.value}:{message}:{self.count}") catch failure: trap(failure.message)
        return interop.Outcome[str].success(interop.copy_text(text) catch failure: trap(failure.message))

    mutating func close():
        self.prefix.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.prefix.trace(visit, context)

let application_type: interop.Type[Application] = interop.Type[Application]("worker application", Application.close, Application.trace)

func factory(prefix: str) -> interop.Outcome[workers.Handler]:
    let text = interop.copy_text(prefix) catch failure: trap(failure.message)
    let native = new Application(text, 0) catch failure: trap(failure.message)
    let owner = interop.Reference[Application].adopt(native, application_type) catch failure: trap(failure.message)
    defer owner.release()
    let handler = interop.Callback[str, str].bind_mutating(owner, Application.answer) catch failure: trap(failure.message)
    return interop.Outcome[workers.Handler].success(interop.Owned[workers.Handler](handler, handler.owner))

func exercise() -> !:
    var service = try workers.Service(interop.WorkerEntry[str, str, str].native(factory), "base")
    defer service.close()
    try service.send("first")
    let first = service.receive()
    assert((try first.get()) == "base:first:1")
    first.release()
    try service.send("second")
    let second = service.receive()
    assert((try second.get()) == "base:second:2")
    second.release()
    service.cancel()
    let cancelled = service.receive()
    assert(not cancelled.is_success())
    cancelled.release()

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    try exercise()
    return ownership.finish_run(0)
