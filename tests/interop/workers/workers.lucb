## An application-specific Base owner over the standard persistent worker bridge.
import interop
import ownership

pub let invalid: ErrorCode = ErrorCode.package(1)
pub type Handler = interop.Callback[str, str]

pub struct Service:
    var worker: interop.Worker[str, str, str]

    pub func init(factory: interop.WorkerEntry[str, str, str], prefix: str, capacity: usize = 2) -> !:
        self.worker = try interop.Worker[str, str, str](factory, prefix,
            interop.text_transfer, interop.text_transfer, interop.text_transfer, capacity)

    pub func send(message: str) -> !:
        try self.worker.send(message)

    pub func receive() -> interop.Outcome[str]:
        let reply = self.worker.receive() catch failure:
            return interop.Outcome[str].failure(failure.code, interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
        defer reply.release()
        let text = reply.get() catch failure:
            return interop.Outcome[str].failure(failure.code, interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
        return interop.Outcome[str].success(interop.copy_text(text) catch exhausted: trap(exhausted.message))

    pub func cancel():
        self.worker.cancel()

    pub mutating func close():
        self.worker.close()

pub let service_type: interop.Type[Service] = interop.Type[Service]("Service", Service.close, closeable = true)

pub struct Settings:
    pub let start: i64
    pub let enabled: bool

pub type CounterHandler = interop.Callback[i64, i64]
pub struct Counter:
    var worker: interop.Worker[Settings, i64, i64]

    pub func init(factory: interop.WorkerEntry[Settings, i64, i64], settings: Settings) -> !:
        self.worker = try interop.Worker[Settings, i64, i64](factory, settings,
            interop.Transfer[Settings].plain(), interop.Transfer[i64].plain(), interop.Transfer[i64].plain())

    pub func add(value: i64) -> interop.Outcome[i64]:
        self.worker.send(value) catch failure:
            return interop.Outcome[i64].failure(failure.code, interop.Owned[str](failure.message))
        let reply = self.worker.receive() catch failure:
            return interop.Outcome[i64].failure(failure.code, interop.Owned[str](failure.message))
        defer reply.release()
        let result = reply.get() catch failure:
            return interop.Outcome[i64].failure(failure.code, interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
        return interop.Outcome[i64].success(interop.Owned[i64](result))

    pub mutating func close():
        self.worker.close()

pub let counter_type: interop.Type[Counter] = interop.Type[Counter]("Counter", Counter.close, closeable = true)

pub type TickHandler = interop.Callback[unit, i64]
pub func tick(factory: interop.WorkerEntry[unit, unit, i64]) -> interop.Outcome[i64]:
    var worker = interop.Worker[unit, unit, i64](factory, (), interop.Transfer[unit].plain(),
        interop.Transfer[unit].plain(), interop.Transfer[i64].plain()) catch failure:
        return interop.Outcome[i64].failure(failure.code, interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
    defer worker.close()
    worker.send(()) catch failure: trap(failure.message)
    let reply = worker.receive() catch failure: trap(failure.message)
    defer reply.release()
    let result = reply.get() catch failure:
        return interop.Outcome[i64].failure(failure.code, interop.copy_text(failure.message) catch exhausted: trap(exhausted.message))
    return interop.Outcome[i64].success(interop.Owned[i64](result))

pub func create_service(factory: interop.WorkerEntry[str, str, str]) -> interop.Reference[Service]!:
    let native = try new Service(factory, "from function")
    return try interop.Reference[Service].adopt(native, service_type)
