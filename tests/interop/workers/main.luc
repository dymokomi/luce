from workers import Service, Handler, Settings, Counter, CounterHandler, TickHandler
import workers

class Application:
    var prefix: str = ""
    var count: int = 0
    var cycle: Application? = none

    pub func answer(self, message: str) -> str!:
        self.count += 1
        if message == "failure":
            error(workers.invalid, self.prefix + " dynamic failure")
        return self.prefix + ":" + message + ":" + str(self.count)

func factory(prefix: str) -> Handler!:
    if prefix == "reject":
        error(workers.invalid, prefix + " startup")
    let state = Application()
    state.prefix = prefix
    state.cycle = state
    return state.answer

func counter_factory(settings: Settings) -> CounterHandler!:
    var total = settings.start
    return func (value: int) -> int!:
        if settings.enabled:
            total += value
        return total

func tick_factory() -> TickHandler!:
    var count = 40
    return func () -> int!:
        count += 2
        return count

pub func main(arguments: list[str]) -> int!:
    let first = Service(factory, "one")
    let second = Service(factory, "two")
    for index in 0..<64:
        first.send("hello")
        second.send("world")
        assert((first.receive()) == "one:hello:" + str(index + 1))
        assert((second.receive()) == "two:world:" + str(index + 1))
    first.send("failure")
    let handled = first.receive() catch failure:
        assert(failure.code == workers.invalid and failure.message == "one dynamic failure")
        recover "handled"
    assert(handled == "handled")
    first.send("after")
    assert((first.receive()) == "one:after:66")
    # a poll never waits, and a timed receive gives up with none
    assert(first.receive_within(20) == none)
    first.send("polled")
    var polled: str? = none
    while polled == none:
        polled = first.try_receive()
    assert(polled == "one:polled:67")
    first.cancel()
    first.send("late") catch failure:
        assert(failure.message == "the worker no longer accepts messages")
    let cancelled = first.receive() catch failure:
        assert(failure.message == "the worker no longer produces replies")
        recover "cancelled"
    assert(cancelled == "cancelled")
    first.close()
    second.close()
    let rejected: Service? = Service(factory, "reject") catch failure:
        assert(failure.code == workers.invalid and failure.message == "reject startup")
        recover none
    assert(rejected == none)
    let counter = Counter(counter_factory, Settings(10, true))
    assert((counter.add(3)) == 13)
    assert((counter.add(5)) == 18)
    counter.close()
    assert((workers.tick(tick_factory)) == 42)
    # Function-value adapters keep the native worker descriptor and its guard.
    let create = workers.create_service
    let indirect = create(factory)
    indirect.send("ok")
    assert((indirect.receive()) == "from function:ok:1")
    indirect.close()
    return 0
