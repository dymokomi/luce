import interop
import memory
import ownership

pub let invalid: ErrorCode = ErrorCode.package(1)
var finalized: i64 = 0

pub struct Counter:
    pub var count: i64
    var label: u8[]
    pub let title: str
    pub var child: interop.Reference[Counter]?

    pub func init(label: str, count: i64 = 7) -> !:
        if count < 0:
            error(invalid, "invalid count")
        let copy = try alloc u8[label.length] in memory.heap
        errdefer free(copy) in memory.heap
        if count == 99:
            error(invalid, "failed after allocating label")
        memory.copy(copy, label.bytes, label.length)
        self.count = count
        self.label = copy
        self.title = (str)copy
        self.child = none

    pub func value() -> i64:
        return self.count

    pub func name() -> str:
        return (str)self.label

    pub mutating func increase(amount: i64 = 2) -> i64!:
        self.count += amount
        if amount < 0:
            error(invalid, (str)self.label)
        return self.count

    pub mutating func attach(child: interop.Reference[Counter]):
        let held = child.clone()
        if let previous = self.child:
            previous.release()
        self.child = held

    pub func retained_child() -> interop.Reference[Counter]?:
        let child = self.child else return none
        return child.clone()

    pub mutating func close():
        finalized += 1
        free(self.label) in memory.heap
        if let child = self.child:
            self.child = none
            child.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let child = self.child:
            child.trace(visit, context)

    pub static func make(label: str = "static", count: i64 = 7) -> interop.Reference[Counter]!:
        var reservation = try interop.Reservation[Counter](counter_type)
        errdefer reservation.cancel()
        let native = try new Counter(label, count) in memory.heap
        return reservation.publish(native, memory.heap)

pub let counter_type: interop.Type[Counter] = interop.Type[Counter](
    name = "Counter", dispose = Counter.close, trace = Counter.trace, closeable = true)

pub type Count = Counter

pub func echo(value: interop.Reference[Counter]) -> interop.Reference[Counter]:
    return value.clone()

pub func first(values: const interop.Reference[Counter][]) -> interop.Reference[Counter]:
    return values[0].clone()

pub func disposal_count() -> i64:
    return finalized

pub func collect():
    ownership.collect()


pub struct Simple:
    pub var count: i64 = 17
    mutating func dispose():
        finalized += 1

pub let simple_type: interop.Type[Simple] = interop.Type[Simple](name = "Simple", dispose = Simple.dispose)
