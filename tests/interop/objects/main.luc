from objects import Counter
import objects
import exported

func retain_child(parent: Counter) -> unit!:
    let child = try Counter("child", 11)
    parent.attach(child)

func bound() -> func() -> int:
    let value = Counter("bound", 13) catch failure: trap(failure.message)
    return value.value

func lifetime() -> unit!:
    let value = try Counter("last")
    assert(value.value() == 7)

func cycles() -> unit!:
    let left = try Counter("left")
    let right = try Counter("right")
    left.attach(right)
    right.attach(left)
    let self_cycle = try Counter("self")
    self_cycle.attach(self_cycle)

pub func main(arguments: list[str]) -> int!:
    let cycle_count = objects.disposal_count()
    try cycles()
    objects.collect()
    assert(objects.disposal_count() == cycle_count + 3)
    let failed_init: Counter? = Counter("partial", 99) catch failure:
        assert(failure.code == objects.invalid and failure.message == "failed after allocating label")
        recover none
    assert(failed_init == none)
    assert(objects.disposal_count() == cycle_count + 3)
    let value = try Counter(count = 7, label = "owned " + str(1))
    assert(value.title == "owned 1" and value.count == 7)
    value.count = 8
    value.count -= 1
    let alias = value
    assert(value is alias and not value.is_closed())
    assert(value is objects.echo(value))
    assert(value is exported.echo(value))
    assert(value is objects.first([value]))
    assert((try alias.increase()) == 9 and value.value() == 9)
    let read = value.value
    let increase = value.increase
    assert((try increase(3)) == 12 and read() == 12)
    try retain_child(value)
    let child = value.retained_child() else trap("missing child")
    assert(child is (value.child else trap("missing child field")))
    assert(child.name() == "child" and child.value() == 11)
    assert(child is (value.retained_child() else trap("missing child")))
    assert(bound()() == 13)
    let before = objects.disposal_count()
    try lifetime()
    assert(objects.disposal_count() == before + 1)
    let same_type = try exported.Count("export", 4)
    assert(same_type.value() == 4)
    let simple = objects.Simple()
    assert(simple.count == 17)
    let factory = Counter.make
    assert((try factory("factory", 15)).value() == 15)
    let failed = alias.increase(-1) catch failure:
        assert(failure.code == objects.invalid and failure.message == "owned 1")
        assert(value.value() == 11)
        recover 0
    assert(failed == 0)
    let closed = objects.disposal_count()
    alias.close()
    assert(value.is_closed())
    value.close()
    let after_close = value.increase() catch failure:
        assert(failure.message == "a native object is closed")
        recover -1
    assert(after_close == -1)
    assert(objects.disposal_count() == closed + 1)
    let weak = Weak(child)
    assert((weak.get() else trap("expired child")) is child)
    return 0
