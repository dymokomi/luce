#==============================================================================================
#
#   package_type_codec_test - Canonical serialized HIR type graphs
#
#   DESCRIPTION:
#       Round-trips every TypeForm and proves that malformed identities,
#       builtin prefixes, widths, references, tags, and truncation fail closed.
#
#==============================================================================================

from luce.compiler.hir.ir import TypeDefinition, TypeForm, TypeId, TypeTable
from luce.compiler.hir.ir import create_builtin_type_table, type_forms_match
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.type_codec import read_type_table, write_type_table

# mark: Fixtures ===============================================================================

func append_type(types: TypeTable, name: str, form: TypeForm) -> TypeId:
    let identity = TypeId(value = u32(len(types.definitions)))
    types.definitions.append(TypeDefinition(id = identity, name = name, form = form))
    return identity

func every_type_form() -> TypeTable:
    let types = create_builtin_type_table()
    let i64_type = TypeId(value = 5)
    let u8_type = TypeId(value = 6)
    let string_type = TypeId(value = 14)
    discard(append_type(types, "mutable_slice[i64]", TypeForm.MutableSlice(element = i64_type)))
    discard(append_type(types, "list[str]", TypeForm.List(element = string_type)))
    discard(append_type(types, "map[str, i64]", TypeForm.Map(key = string_type, value = i64_type)))
    discard(append_type(types, "set[str]", TypeForm.Set(element = string_type)))
    discard(append_type(types, "Weak[Owner]", TypeForm.Weak(value = i64_type)))
    discard(append_type(types, "range[i64]", TypeForm.Range(element = i64_type)))
    discard(append_type(types, "array[u8, 12]", TypeForm.Array(element = u8_type, count = 12)))
    discard(append_type(types, "i64?", TypeForm.Optional(value = i64_type)))
    discard(append_type(types, "i64!", TypeForm.Fallible(value = i64_type)))
    discard(append_type(types, "(i64, str)", TypeForm.Tuple(elements = [i64_type, string_type])))
    discard(append_type(types, "func(i64, str) -> i64", TypeForm.Function(parameters = [i64_type, string_type], result = i64_type)))
    discard(append_type(types, "cfunc(i64) -> u8", TypeForm.CFunction(parameters = [i64_type], result = u8_type)))
    discard(append_type(types, "native_ptr[u8]", TypeForm.NativePointer(pointee = u8_type, is_mutable = false)))
    discard(append_type(types, "native_mut_ptr[u8]", TypeForm.NativePointer(pointee = u8_type, is_mutable = true)))
    let parameter = append_type(types, "T", TypeForm.TypeParameter(generic = 7, position = 1))
    discard(append_type(types, "Comparable[T]", TypeForm.Interface(index = 0, arguments = [parameter])))
    discard(append_type(types, "Box[T]", TypeForm.Struct(index = 0, arguments = [parameter])))
    discard(append_type(types, "Cell[T]", TypeForm.Class(index = 0, arguments = [parameter])))
    discard(append_type(types, "Choice[T]", TypeForm.Enum(index = 0, arguments = [parameter])))
    discard(append_type(types, "Handle", TypeForm.Extern(index = 0)))
    return types

func encoded(types: TypeTable) -> list[u8]:
    let writer = PackageWriter()
    write_type_table(writer, types) catch reason:
        trap(reason)
    return writer.finish()

func decoded(input: list[u8]) -> TypeTable:
    let reader = PackageReader(input)
    let types = read_type_table(reader) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    return types

func encoding_failure(types: TypeTable) -> str:
    let writer = PackageWriter()
    var reported = ""
    write_type_table(writer, types) catch reason:
        reported = reason
    return reported

func decoding_failure(input: list[u8]) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_type_table(reader)) catch reason:
        reported = reason
    return reported

# mark: Round trip =============================================================================

pub func test_package_type_codec_round_trips_every_target_neutral_hir_form():
    let original = every_type_form()
    let encoded_types = encoded(original)
    let restored = decoded(encoded_types)
    assert(len(restored.definitions) == len(original.definitions))
    for index in range(0, len(original.definitions)):
        assert(restored.definitions[index].id.value == u32(index))
        assert(restored.definitions[index].name == original.definitions[index].name)
        assert(type_forms_match(restored.definitions[index].form, original.definitions[index].form))
    assert(len(encoded_types) > 200)

# mark: Malformed graphs =======================================================================

pub func test_package_type_codec_rejects_noncanonical_graphs_before_encoding():
    let wrong_identity = create_builtin_type_table()
    wrong_identity.definitions[0] = TypeDefinition(id = TypeId(value = 1), name = "unit", form = TypeForm.Unit)
    assert(encoding_failure(wrong_identity) == "typed package artifact: HIR TypeId does not match its table position")

    let wrong_builtin = create_builtin_type_table()
    wrong_builtin.definitions[0] = TypeDefinition(id = TypeId(value = 0), name = "void", form = TypeForm.Unit)
    assert(encoding_failure(wrong_builtin) == "typed package artifact: canonical builtin HIR type prefix does not match this compiler")

    let wrong_width = create_builtin_type_table()
    discard(append_type(wrong_width, "i24", TypeForm.Integer(bits = 24, is_signed = true)))
    assert(encoding_failure(wrong_width) == "typed package artifact: invalid integer width 24")

    let dangling = create_builtin_type_table()
    discard(append_type(dangling, "missing", TypeForm.Slice(element = TypeId(value = 500))))
    assert(encoding_failure(dangling) == "typed package artifact: HIR type references a missing TypeId")

    let duplicate = create_builtin_type_table()
    discard(append_type(duplicate, "another i64", TypeForm.Integer(bits = 64, is_signed = true)))
    assert(encoding_failure(duplicate) == "typed package artifact: HIR type table contains a duplicate structural type")

    let negative_array = create_builtin_type_table()
    discard(append_type(negative_array, "array[u8, -1]", TypeForm.Array(element = TypeId(value = 6), count = -1)))
    assert(encoding_failure(negative_array) == "typed package artifact: array count must not be negative")

pub func test_package_type_codec_rejects_unknown_tags_and_truncated_tables():
    let encoded_types = encoded(create_builtin_type_table())
    # count:u32, id:u32, text length:u32, and `unit` precede this tag.
    encoded_types[16] = 0xFF
    assert(decoding_failure(encoded_types) == "typed package artifact: unknown HIR type tag 255")

    let truncated = encoded(create_builtin_type_table())
    truncated.remove(len(truncated) - 1)
    assert(decoding_failure(truncated) == "package artifact: truncated u8")
