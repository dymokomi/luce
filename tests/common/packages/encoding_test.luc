#==============================================================================================
#
#   package_encoding_test - Canonical typed-package byte primitives
#
#   DESCRIPTION:
#       Proves exact wire bytes, full integer boundaries, detached ownership,
#       and strict rejection of truncation, invalid UTF-8/tags/counts, and
#       trailing input before declaration codecs build on these primitives.
#
#==============================================================================================

from luce.compiler.packages.encoding import PackageReader, PackageWriter

# mark: Helpers ===============================================================================

func encoded_scalars() -> list[u8]!:
    let writer = PackageWriter()
    writer.write_u8(0xA5)
    writer.write_bool(false)
    writer.write_bool(true)
    writer.write_u32(0x78563412)
    writer.write_u64(0x0807060504030201)
    writer.write_i64(-9223372036854775807 - 1)
    writer.write_i64(9223372036854775807)
    try writer.write_count(3)
    try writer.write_bytes([0, 255, 7])
    try writer.write_text("λuce")
    return writer.finish()

func decode_failure(input: list[u8], operation: str) -> str:
    let reader = PackageReader(input)
    var reported = ""
    if operation == "bool":
        discard(reader.read_bool()) catch reason:
            reported = reason
        return reported
    if operation == "u32":
        discard(reader.read_u32()) catch reason:
            reported = reason
        return reported
    if operation == "u64":
        discard(reader.read_u64()) catch reason:
            reported = reason
        return reported
    if operation == "count":
        discard(reader.read_count()) catch reason:
            reported = reason
        return reported
    if operation == "bytes":
        discard(reader.read_bytes()) catch reason:
            reported = reason
        return reported
    if operation == "text":
        discard(reader.read_text()) catch reason:
            reported = reason
        return reported
    if operation == "finish":
        reader.finish() catch reason:
            reported = reason
        return reported
    trap("unknown decoding operation")

func count_encoding_failure(value: i64) -> str:
    let writer = PackageWriter()
    var reported = ""
    writer.write_count(value) catch reason:
        reported = reason
    return reported

func assert_bytes(actual: list[u8], expected: list[u8]):
    assert(len(actual) == len(expected))
    for index in range(0, len(expected)):
        assert(actual[index] == expected[index])

# mark: Round trips ===========================================================================

pub func test_package_encoding_is_fixed_canonical_and_round_trips_boundaries():
    let encoded = encoded_scalars() catch reason:
        trap(reason)
    assert_bytes(encoded, [
        0xA5, 0x00, 0x01,
        0x12, 0x34, 0x56, 0x78,
        0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
        0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
        0xFE, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
        0x03, 0x00, 0x00, 0x00,
        0x03, 0x00, 0x00, 0x00, 0x00, 0xFF, 0x07,
        0x05, 0x00, 0x00, 0x00, 0xCE, 0xBB, 0x75, 0x63, 0x65,
    ])

    let reader = PackageReader(encoded)
    let marker = reader.read_u8() catch reason:
        trap(reason)
    let disabled = reader.read_bool() catch reason:
        trap(reason)
    let enabled = reader.read_bool() catch reason:
        trap(reason)
    let word = reader.read_u32() catch reason:
        trap(reason)
    let double_word = reader.read_u64() catch reason:
        trap(reason)
    let minimum = reader.read_i64() catch reason:
        trap(reason)
    let maximum = reader.read_i64() catch reason:
        trap(reason)
    let count = reader.read_count() catch reason:
        trap(reason)
    assert(marker == 0xA5)
    assert(not disabled and enabled)
    assert(word == 0x78563412)
    assert(double_word == 0x0807060504030201)
    assert(minimum == -9223372036854775807 - 1)
    assert(maximum == 9223372036854775807)
    assert(count == 3)
    let payload = reader.read_bytes() catch reason:
        trap(reason)
    assert(len(payload) == 3)
    assert(payload[0] == 0 and payload[1] == 255 and payload[2] == 7)
    let text = reader.read_text() catch reason:
        trap(reason)
    assert(text == "λuce")
    reader.finish() catch reason:
        trap(reason)

pub func test_package_writer_returns_detached_bytes():
    let writer = PackageWriter()
    writer.write_u8(1)
    let first = writer.finish()
    writer.write_u8(2)
    let second = writer.finish()
    assert(len(first) == 1 and first[0] == 1)
    assert(len(second) == 2 and second[0] == 1 and second[1] == 2)

# mark: Malformed input =======================================================================

pub func test_package_reader_rejects_every_noncanonical_or_truncated_primitive():
    assert(decode_failure([2], "bool") == "package artifact: Boolean tag must be 0 or 1")
    assert(decode_failure([1, 2, 3], "u32") == "package artifact: truncated u32")
    assert(decode_failure([1, 2, 3, 4, 5, 6, 7], "u64") == "package artifact: truncated u64")
    assert(decode_failure([65, 66, 15, 0], "count") == "package artifact: table count exceeds 1000000 entries")
    assert(decode_failure([3, 0, 0, 0, 1, 2], "bytes") == "package artifact: truncated byte field")
    assert(decode_failure([2, 0, 0, 0, 0xC3, 0x28], "text") == "package artifact: text field is not valid UTF-8")
    assert(decode_failure([1], "finish") == "package artifact: trailing bytes after the final section")

pub func test_package_writer_rejects_counts_outside_the_canonical_table_domain():
    assert(count_encoding_failure(-1) == "package artifact: table count is outside the supported range")
    assert(count_encoding_failure(1000001) == "package artifact: table count is outside the supported range")
