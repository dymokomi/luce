#==============================================================================================
#
#   package_signature_codec_test - Shared declaration signature records
#
#   DESCRIPTION:
#       Proves the one receiver/parameter spelling reused by nominal,
#       interface, and function sections, including every closed receiver tag
#       and malformed symbol, type, node, and duplicate-name edge.
#
#==============================================================================================

from luce.compiler.hir.ir import HirParameter, HirReceiver, HirReceiverKind, NodeId
from luce.compiler.hir.ir import SymbolId, TypeDefinition, TypeForm, TypeId, TypeTable
from luce.compiler.hir.ir import create_builtin_type_table, no_node
from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.signature_codec import read_optional_receiver, read_parameters
from luce.compiler.packages.signature_codec import validate_optional_receiver, validate_parameters
from luce.compiler.packages.signature_codec import write_optional_receiver, write_parameters

# mark: Fixtures ===============================================================================

func types_with_owner() -> TypeTable:
    let types = create_builtin_type_table()
    types.definitions.append(TypeDefinition(
        id = TypeId(value = 23), name = "Owner",
        form = TypeForm.Struct(index = 0, arguments = list[TypeId]()),
    ))
    return types

func receiver_failure(input: list[u8]) -> str:
    let reader = PackageReader(input)
    var reported = ""
    discard(read_optional_receiver(reader)) catch reason:
        reported = reason
    return reported

# mark: Canonical records ======================================================================

pub func test_package_signature_codec_round_trips_every_receiver_protocol():
    let receivers = [
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.type_function),
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.value_method),
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.mutating_method),
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.initializer),
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.deinitializer),
    ]
    let writer = PackageWriter()
    write_optional_receiver(writer, none)
    for receiver in receivers: write_optional_receiver(writer, receiver)
    let reader = PackageReader(writer.finish())
    assert(try_read_absent_receiver(reader))
    for expected in receivers:
        let restored = read_optional_receiver(reader) catch reason:
            trap(reason)
        let present = restored else trap("receiver disappeared")
        assert(present.owner.value == expected.owner.value)
        assert(present.kind == expected.kind)
    reader.finish() catch reason:
        trap(reason)

pub func test_package_signature_codec_round_trips_parameters_and_defaults():
    let parameters = [
        HirParameter(
            symbol = SymbolId(value = 0), name = "required",
            value_type = TypeId(value = 5), default_value = NodeId(value = no_node),
        ),
        HirParameter(
            symbol = SymbolId(value = 1), name = "defaulted",
            value_type = TypeId(value = 14), default_value = NodeId(value = 0),
        ),
    ]
    let writer = PackageWriter()
    write_parameters(writer, parameters) catch reason:
        trap(reason)
    let reader = PackageReader(writer.finish())
    let restored = read_parameters(reader) catch reason:
        trap(reason)
    reader.finish() catch reason:
        trap(reason)
    validate_parameters(restored, create_builtin_type_table(), 2, 1) catch reason:
        trap(reason)
    assert(restored[0].default_value.value == no_node)
    assert(restored[1].default_value.value == 0)

func try_read_absent_receiver(reader: PackageReader) -> bool:
    let restored = read_optional_receiver(reader) catch reason:
        trap(reason)
    return restored == none

# mark: Malformed records ======================================================================

pub func test_package_signature_codec_rejects_invalid_receiver_and_parameter_edges():
    let types = types_with_owner()
    validate_optional_receiver(
        HirReceiver(owner = TypeId(value = 23), kind = HirReceiverKind.value_method), types,
    ) catch reason:
        trap(reason)
    var reported = ""
    validate_optional_receiver(
        HirReceiver(owner = TypeId(value = 5), kind = HirReceiverKind.value_method), types,
    ) catch reason:
        reported = reason
    assert(reported == "typed package artifact: callable receiver owner is not a nominal type")

    let duplicate = [
        HirParameter(
            symbol = SymbolId(value = 0), name = "value",
            value_type = TypeId(value = 5), default_value = NodeId(value = no_node),
        ),
        HirParameter(
            symbol = SymbolId(value = 1), name = "value",
            value_type = TypeId(value = 5), default_value = NodeId(value = no_node),
        ),
    ]
    reported = ""
    validate_parameters(duplicate, create_builtin_type_table(), 2, 0) catch reason:
        reported = reason
    assert(reported == "typed package artifact: duplicate callable parameter `value`")

pub func test_package_signature_codec_rejects_unknown_receiver_tags():
    # present=true, owner TypeId=21, then the closed receiver-kind byte.
    assert(receiver_failure([1, 21, 0, 0, 0, 255]) ==
        "typed package artifact: unknown HIR receiver kind tag 255")
