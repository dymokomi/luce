#==============================================================================================
#
#   attributes_codec_test - Declaration attributes survive the package codec
#
#==============================================================================================

from luce.compiler.packages.encoding import PackageReader, PackageWriter
from luce.compiler.packages.hir_fields import read_attributes, write_attributes
from luce.compiler.symbol_attributes import InlineHint, SymbolAttributes, attributes_match

pub func test_every_attribute_combination_round_trips():
    let samples = [
        SymbolAttributes(),
        SymbolAttributes(inlining = InlineHint.inline, is_cold = true),
        SymbolAttributes(inlining = InlineHint.noinline, is_naked = true, is_weak = true, is_used = true, section = ".isr_vector"),
        SymbolAttributes(section = "__DATA,__luce"),
    ]
    for sample in samples:
        let writer = PackageWriter()
        write_attributes(writer, sample) catch reason:
            trap(reason)
        let reader = PackageReader(writer.finish())
        let restored = read_attributes(reader) catch reason:
            trap(reason)
        reader.finish() catch reason:
            trap(reason)
        assert(attributes_match(sample, restored))
    assert(not attributes_match(samples[1], samples[2]))
