#==============================================================================================
#
#   fiir.recipe_test - Parsed ownership facts and generated safe C wrappers
#
#==============================================================================================

import luce.compiler.fiir.generator as fiir_products
from luce.compiler.fiir.recipe import attach_binding_recipe, parse_binding_recipe
from luce.compiler.fiir.safe_generator import render_safe_module
from luce.compiler.fiir.schema import FiirBoundaryValue, FiirCallingConvention, FiirCIntegerKind, FiirFunction, FiirLanguage, FiirModule, FiirMutability, FiirNullability, FiirParameter, FiirRecipeResult, FiirSourceOrigin, FiirType, FiirTypeForm, FiirTypeId, plain_value_boundary
import std.files
import std.strings

# mark: Fixtures ===============================================================================

func fixture_origin(line: u32) -> FiirSourceOrigin:
    return FiirSourceOrigin(path = "temperature.h", line = line, column = u32(1))

func handle_boundary(nullability: FiirNullability, mutability: FiirMutability) -> FiirBoundaryValue:
    return FiirBoundaryValue(
        value_type = FiirTypeId(value = u32(3)),
        nullability = nullability,
        mutability = mutability,
    )

func fixture_parameter(name: str, boundary: FiirBoundaryValue, line: u32) -> FiirParameter:
    return FiirParameter(name = name, boundary = boundary, origin = fixture_origin(line))

func fixture_function(name: str, parameters: list[FiirParameter], result: FiirBoundaryValue, line: u32) -> FiirFunction:
    return FiirFunction(
        name = name,
        convention = FiirCallingConvention.c,
        parameters = parameters,
        result = result,
        is_variadic = false,
        can_throw = false,
        conditions = list[str](),
        origin = fixture_origin(line),
    )

## The recipe unit tests use an already-decoded FIIR graph. Real Clang import
## remains covered at the toolchain, CLI, QBE, and differential boundaries.
func imported_temperature() -> FiirModule:
    let degrees = plain_value_boundary(FiirTypeId(value = u32(4)))
    let signed_int = plain_value_boundary(FiirTypeId(value = u32(2)))
    return FiirModule(
        format_version = u32(2),
        language = FiirLanguage.c,
        generator_version = "luce-fiir-2",
        header = "temperature.h",
        target = "test-target",
        clang_arguments = list[str](),
        types = [
            FiirType(spelling = "void", form = FiirTypeForm.Unit, size_bits = none),
            FiirType(spelling = "_Bool", form = FiirTypeForm.Boolean, size_bits = u16(8)),
            FiirType(
                spelling = "int",
                form = FiirTypeForm.Integer(kind = FiirCIntegerKind.signed_int, bits = u16(32), is_signed = true),
                size_bits = u16(32),
            ),
            FiirType(
                spelling = "luce_temperature_sensor *",
                form = FiirTypeForm.OpaqueHandle(
                    name = "luce_temperature_sensor",
                    c_spelling = "luce_temperature_sensor *",
                    origin = fixture_origin(u32(8)),
                ),
                size_bits = none,
            ),
            FiirType(
                spelling = "luce_degrees",
                form = FiirTypeForm.Typedef(target = FiirTypeId(value = u32(2)), origin = fixture_origin(u32(7))),
                size_bits = u16(32),
            ),
        ],
        constants = [],
        objects = [],
        functions = [
            fixture_function(
                "luce_temperature_sensor_open",
                [fixture_parameter("value", degrees, u32(10))],
                handle_boundary(FiirNullability.nonnull, FiirMutability.mutable),
                u32(10),
            ),
            fixture_function(
                "luce_temperature_sensor_find",
                [fixture_parameter("value", degrees, u32(11))],
                handle_boundary(FiirNullability.nullable, FiirMutability.mutable),
                u32(11),
            ),
            fixture_function(
                "luce_temperature_sensor_value",
                [fixture_parameter("sensor", handle_boundary(FiirNullability.nonnull, FiirMutability.read_only), u32(12))],
                degrees,
                u32(12),
            ),
            fixture_function(
                "luce_temperature_sensor_echo",
                [fixture_parameter("sensor", handle_boundary(FiirNullability.nonnull, FiirMutability.read_only), u32(13))],
                handle_boundary(FiirNullability.nullable, FiirMutability.mutable),
                u32(13),
            ),
            fixture_function(
                "luce_temperature_sensor_present",
                [fixture_parameter("sensor", handle_boundary(FiirNullability.nullable, FiirMutability.read_only), u32(14))],
                plain_value_boundary(FiirTypeId(value = u32(1))),
                u32(14),
            ),
            fixture_function(
                "luce_temperature_sensor_validate",
                [fixture_parameter("sensor", handle_boundary(FiirNullability.nonnull, FiirMutability.read_only), u32(15))],
                signed_int,
                u32(15),
            ),
            fixture_function(
                "luce_temperature_sensor_close",
                [fixture_parameter("sensor", handle_boundary(FiirNullability.nonnull, FiirMutability.mutable), u32(16))],
                plain_value_boundary(FiirTypeId(value = u32(0))),
                u32(16),
            ),
        ],
        recipe = none,
    )

func temperature_recipe() -> str:
    let document = files.read("examples/full/c_import/temperature.recipe.toml") catch reason:
        trap(reason)
    return document

func attached_temperature() -> FiirModule:
    let recipe = parse_binding_recipe(temperature_recipe(), "examples/full/c_import/temperature.recipe.toml", "temperature") catch reason:
        trap(reason)
    let module = attach_binding_recipe(imported_temperature(), recipe) catch reason:
        trap(reason)
    return module

func validation_failure(module: FiirModule, document: str) -> str:
    let recipe = parse_binding_recipe(document, "recipe.toml", "temperature") catch reason:
        return reason
    discard(attach_binding_recipe(module, recipe)) catch reason:
        return reason
    return ""

# mark: Parsing and durable facts ==============================================================

pub func test_recipe_keeps_reviewed_facts_separate_from_clang_boundaries():
    let module = attached_temperature()
    let recipe = module.recipe else trap("attached recipe disappeared")
    assert(recipe.binding == "temperature")
    assert(recipe.path == "examples/full/c_import/temperature.recipe.toml")
    assert(len(recipe.functions) == 6)
    let owned_result = recipe.functions[0].result else trap("expected owned result recipe")
    match owned_result:
        Owned(disposer): assert(disposer == "luce_temperature_sensor_close")
        else: trap("expected an owned result recipe")
    let borrowed_result = recipe.functions[3].result else trap("expected borrowed result recipe")
    match borrowed_result:
        Borrowed(source_parameter): assert(source_parameter == u32(0))
        else: trap("expected a returned-borrow recipe")
    let status_result = recipe.functions[5].result else trap("expected status result recipe")
    match status_result:
        Status(success, error_code, message):
            assert(error_code == u32(31))
            assert(message == "temperature sensor is invalid")
        else: trap("expected a status recipe")

    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"format\": \"luce-fiir-2\""))
    assert(strings.contains(encoded, "\"recipe\": {"))
    assert(strings.contains(encoded, "\"kind\": \"owned\""))
    assert(strings.contains(encoded, "\"kind\": \"borrowed\""))
    assert(strings.contains(encoded, "\"kind\": \"status\""))
    assert(not strings.contains(encoded, "\"ownership\": \"unspecified\""))
    assert(not strings.contains(encoded, "\"lifetime\": \"unspecified\""))

pub func test_recipe_parser_accepts_comments_and_rejects_unclosed_vocabulary():
    let source = (
        "# leading comment\n"
        + "[[native.temperature.function]] # table comment\n"
        + "name = \"luce_temperature_sensor_open\"\n"
        + "result = \"owned via luce_temperature_sensor_close\" # fact\n"
    )
    let parsed = parse_binding_recipe(source, "recipe.toml", "temperature") catch reason:
        trap(reason)
    assert(len(parsed.functions) == 1)

    var failed = false
    discard(parse_binding_recipe("name = \"f\"\n", "recipe.toml", "temperature")) catch reason:
        assert(reason == "recipe.toml:1:1: FIIR recipe: property appears before `[[native.temperature.function]]`")
        failed = true
    assert(failed)
    failed = false
    discard(parse_binding_recipe("[[native.other.function]]\nname = \"f\"\n", "recipe.toml", "temperature")) catch reason:
        assert(strings.contains(reason, "expected table `[[native.temperature.function]]`"))
        failed = true
    assert(failed)
    failed = false
    discard(parse_binding_recipe("[[native.temperature.function]]\nname = \"f\"\nunknown = \"x\"\n", "recipe.toml", "temperature")) catch reason:
        assert(reason == "recipe.toml:3:1: FIIR recipe: unknown property `unknown`")
        failed = true
    assert(failed)

    let unsigned = parse_binding_recipe(
        "[[native.temperature.function]]\nname = \"f\"\nresult = \"status\"\nsuccess = 18446744073709551615\nerror-code = 1\nmessage = \"failed\"\n",
        "recipe.toml",
        "temperature",
    ) catch reason:
        trap(reason)
    let unsigned_result = unsigned.functions[0].result else trap("status result disappeared")
    match unsigned_result:
        Status(success, error_code, message):
            match success:
                Nonnegative(value): assert(value == u64(18446744073709551615))
                else: trap("unsigned recipe status became negative")
        else: trap("expected status result")

# mark: Relationship validation ================================================================

pub func test_recipe_validation_rejects_missing_and_inconsistent_ownership_facts():
    let module = imported_temperature()
    let missing = validation_failure(module,
        "[[native.temperature.function]]\n"
        + "name = \"luce_temperature_sensor_open\"\n"
        + "result = \"owned via luce_temperature_sensor_close\"\n"
    )
    assert(missing == "FIIR recipe: opaque result of `luce_temperature_sensor_find` has no ownership fact")

    let wrong_disposer = strings.replace(
        temperature_recipe(),
        "owned via luce_temperature_sensor_close",
        "owned via missing_close",
    )
    assert(strings.contains(validation_failure(module, wrong_disposer), "disposer `missing_close` does not exist"))

    let wrong_borrow = strings.replace(
        temperature_recipe(),
        "borrowed from parameter.0",
        "borrowed from parameter.1",
    )
    assert(strings.contains(validation_failure(module, wrong_borrow), "borrowed result names missing parameter 1"))

    let missing_parameter_fact = strings.replace(
        temperature_recipe(),
        "name = \"luce_temperature_sensor_value\"\nparameter.0 = \"borrowed for call\"\n",
        "name = \"luce_temperature_sensor_value\"\nresult = \"status\"\nsuccess = 0\nerror-code = 32\nmessage = \"wrong\"\n",
    )
    assert(validation_failure(module, missing_parameter_fact) == "FIIR recipe: opaque parameter 0 of `luce_temperature_sensor_value` has no `borrowed for call` fact")

    let disposer_fact = (
        temperature_recipe()
        + "\n[[native.temperature.function]]\n"
        + "name = \"luce_temperature_sensor_close\"\n"
        + "parameter.0 = \"borrowed for call\"\n"
    )
    assert(strings.contains(validation_failure(module, disposer_fact), "disposer `luce_temperature_sensor_close` is implied by its owned result and cannot have a separate recipe"))

    let borrowed_only = FiirModule(
        format_version = module.format_version,
        language = module.language,
        generator_version = module.generator_version,
        header = module.header,
        target = module.target,
        clang_arguments = module.clang_arguments,
        types = module.types,
        constants = module.constants,
        objects = module.objects,
        functions = [module.functions[2]],
        recipe = none,
    )
    let borrowed_only_recipe = (
        "[[native.temperature.function]]\n"
        + "name = \"luce_temperature_sensor_value\"\n"
        + "parameter.0 = \"borrowed for call\"\n"
    )
    assert(validation_failure(borrowed_only, borrowed_only_recipe) == "FIIR recipe: borrowed opaque handle `luce_temperature_sensor` has no owned acquisition")

# mark: Safe source generation =================================================================

pub func test_safe_generator_emits_owner_borrow_returned_borrow_and_status_wrappers():
    let safe = render_safe_module(attached_temperature()) catch reason:
        trap(reason)
    assert(strings.contains(safe, "import temperature.raw as raw"))
    assert(strings.contains(safe, "pub class luce_temperature_sensor:"))
    assert(strings.contains(safe, "var handle: raw.luce_temperature_sensor?"))
    assert(strings.contains(safe, "pub func close(self):"))
    assert(strings.contains(safe, "self.handle = none\n                raw.luce_temperature_sensor_close(handle)"))
    assert(strings.contains(safe, "func deinit(self): self.close()"))
    assert(strings.contains(safe, "pub class luce_temperature_sensor_borrow:"))
    assert(strings.contains(safe, "discard(self.owner.raw_for_call())"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_open(value: raw.luce_degrees) -> luce_temperature_sensor:"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_find(value: raw.luce_degrees) -> luce_temperature_sensor?:"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_value(sensor: luce_temperature_sensor_borrow) -> raw.luce_degrees:"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_echo(sensor: luce_temperature_sensor_borrow) -> luce_temperature_sensor_borrow?:"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_present(sensor: luce_temperature_sensor_borrow?) -> c.boolean:"))
    assert(strings.contains(safe, "pub func luce_temperature_sensor_validate(sensor: luce_temperature_sensor_borrow) -> unit!:"))
    assert(strings.contains(safe, "if status != 0i64:"))
    assert(strings.contains(safe, "error(__luce_fiir_temperature_luce_temperature_sensor_validate_failure, \"temperature sensor is invalid\")"))
