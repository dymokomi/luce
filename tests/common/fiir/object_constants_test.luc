#==============================================================================================
#
#   fiir.object_constants_test - Header-local C objects become typed FIIR constants
#
#==============================================================================================

from luce.compiler.backends.clang_fiir import render_binding_products
from luce.compiler.fiir.clang import decode_clang_ast, decode_clang_scalar_facts, render_target_fact_probe
import luce.compiler.fiir.generator as fiir_products
from luce.compiler.fiir.schema import FiirConstant, FiirConstantValue, FiirIntegerValue, validate_fiir
import std.strings

# mark: Fixtures ===============================================================================

func target_macros() -> str:
    return (
        "#define __CHAR_BIT__ 8\n"
        + "#define __BOOL_WIDTH__ 8\n"
        + "#define __SHRT_WIDTH__ 16\n"
        + "#define __INT_WIDTH__ 32\n"
        + "#define __LONG_WIDTH__ 64\n"
        + "#define __LLONG_WIDTH__ 64\n"
        + "#define __SIZEOF_SHORT__ 2\n"
        + "#define __SIZEOF_INT__ 4\n"
        + "#define __SIZEOF_LONG__ 8\n"
        + "#define __SIZEOF_LONG_LONG__ 8\n"
        + "#define __SIZEOF_FLOAT__ 4\n"
        + "#define __SIZEOF_DOUBLE__ 8\n"
        + "#define __SIZEOF_LONG_DOUBLE__ 16\n"
        + "#define __FLT_RADIX__ 2\n"
        + "#define __FLT_MANT_DIG__ 24\n"
        + "#define __FLT_MAX_EXP__ 128\n"
        + "#define __DBL_MANT_DIG__ 53\n"
        + "#define __DBL_MAX_EXP__ 1024\n"
        + "#define __LDBL_MANT_DIG__ 64\n"
        + "#define __LDBL_MAX_EXP__ 16384\n"
        + "#define __FLT16_MANT_DIG__ 11\n"
        + "#define __FLT16_MAX_EXP__ 16\n"
    )

func object_constant_ast() -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"VarDecl\",\"loc\":{\"file\":\"objects.h\",\"line\":1,\"col\":24},"
        + "\"name\":\"LUCE_SIGNED_MINIMUM\",\"type\":{\"qualType\":\"const long long\"},\"storageClass\":\"static\",\"init\":\"c\"},"
        + "{\"kind\":\"VarDecl\",\"loc\":{\"line\":2,\"col\":33},"
        + "\"name\":\"LUCE_UNSIGNED_MAXIMUM\",\"type\":{\"qualType\":\"const unsigned long long\"},\"storageClass\":\"static\",\"init\":\"c\"},"
        + "{\"kind\":\"StaticAssertDecl\",\"loc\":{\"line\":3,\"col\":1}}"
        + "]}"
    )

func typedef_object_constant_ast() -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"TypedefDecl\",\"loc\":{\"file\":\"objects.h\",\"line\":1,\"col\":28},"
        + "\"name\":\"luce_object_count\",\"type\":{\"qualType\":\"long long\"}},"
        + "{\"kind\":\"VarDecl\",\"loc\":{\"line\":2,\"col\":32},"
        + "\"name\":\"LUCE_OBJECT_COUNT\",\"type\":{\"qualType\":\"const luce_object_count\","
        + "\"desugaredQualType\":\"const long long\"},\"storageClass\":\"static\",\"init\":\"c\"}"
        + "]}"
    )

func scalar_object_constant_ast() -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"kind\":\"TypedefDecl\",\"loc\":{\"file\":\"objects.h\",\"line\":1,\"col\":15},"
        + "\"name\":\"luce_flag\",\"type\":{\"qualType\":\"_Bool\"}},"
        + object_constant_declaration("LUCE_ENABLED", "const luce_flag", "const _Bool", 2) + ","
        + object_constant_declaration("LUCE_HALF", "const _Float16", "", 3) + ","
        + object_constant_declaration("LUCE_NEGATIVE_ZERO", "const float", "", 4) + ","
        + object_constant_declaration("LUCE_RATIO", "const double", "", 5) + ","
        + object_constant_declaration("LUCE_NAN", "const double", "", 6) + ","
        + object_constant_declaration("LUCE_INFINITY", "const double", "", 7)
        + "]}"
    )

func enumeration_object_constant_ast() -> str:
    return (
        "{\"kind\":\"TranslationUnitDecl\",\"inner\":["
        + "{\"id\":\"enum-color\",\"kind\":\"EnumDecl\",\"loc\":{\"file\":\"objects.h\",\"line\":1,\"col\":14},"
        + "\"name\":\"Color\",\"inner\":[" + enum_constant_json("COLOR_NEGATIVE", 1, "-2") + "," + enum_constant_json("COLOR_DECLARED", 2, "42") + "]},"
        + "{\"id\":\"typedef-color\",\"kind\":\"TypedefDecl\",\"loc\":{\"line\":4,\"col\":3},"
        + "\"name\":\"Color\",\"type\":{\"qualType\":\"enum Color\"},\"inner\":["
        + "{\"kind\":\"ElaboratedType\",\"ownedTagDecl\":{\"id\":\"enum-color\",\"kind\":\"EnumDecl\",\"name\":\"Color\"}}]},"
        + "{\"kind\":\"TypedefDecl\",\"loc\":{\"line\":5,\"col\":15},\"name\":\"ColorAlias\",\"type\":{\"qualType\":\"Color\",\"desugaredQualType\":\"enum Color\"}},"
        + object_constant_declaration("LUCE_NEGATIVE", "const enum Color", "", 6) + ","
        + object_constant_declaration("LUCE_DECLARED", "const Color", "const enum Color", 7) + ","
        + object_constant_declaration("LUCE_OPEN", "const ColorAlias", "const enum Color", 8)
        + "]}"
    )

func object_constant_declaration(name: str, spelling: str, desugared: str, line: i64) -> str:
    var type = "{\"qualType\":\"" + spelling + "\""
    if desugared != "": type += ",\"desugaredQualType\":\"" + desugared + "\""
    type += "}"
    return "{\"kind\":\"VarDecl\",\"loc\":{\"line\":" + str(line) + ",\"col\":20},\"name\":\"" + name + "\",\"type\":" + type + ",\"storageClass\":\"static\",\"init\":\"c\"}"

func object_constant_target_facts(count: i64 = 2, is_constant: str = "1", first_word: str = "0") -> str:
    let values = [
        is_constant, first_word, "0", "0", "32768",
        "1", "65535", "65535", "65535", "65535",
    ]
    var output = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[{\"kind\":\"EnumDecl\",\"inner\":["
    var item = 0
    for index in range(0, count):
        let suffixes = ["is_constant", "word_0", "word_1", "word_2", "word_3"]
        for suffix in suffixes:
            if item > 0: output += ","
            output += layout_constant_json("__luce_fiir_object_constant_" + str(index) + "_" + suffix, values[item])
            item += 1
    return output + "]}]}"

func scalar_object_constant_target_facts(nan_low_word: str = "4660") -> str:
    let facts = [
        ["1", "1", "0", "0", "0"],
        ["1", "13653", "0", "0", "0"],
        ["1", "0", "32768", "0", "0"],
        ["1", "0", "0", "0", "16376"],
        ["1", nan_low_word, "0", "0", "32760"],
        ["1", "0", "0", "0", "32752"],
    ]
    var output = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[{\"kind\":\"EnumDecl\",\"inner\":["
    output += layout_constant_json("__luce_fiir_float16_size_bits", "16") + ","
    output += layout_constant_json("__luce_fiir_float16_radix", "2") + ","
    output += layout_constant_json("__luce_fiir_float16_significand_bits", "11") + ","
    output += layout_constant_json("__luce_fiir_float16_maximum_exponent", "16")
    for index in range(0, len(facts)):
        let suffixes = ["is_constant", "word_0", "word_1", "word_2", "word_3"]
        for item in range(0, len(suffixes)):
            output += "," + layout_constant_json("__luce_fiir_object_constant_" + str(index) + "_" + suffixes[item], facts[index][item])
    return output + "]}]}"

func enumeration_object_constant_target_facts(first_sign: str = "1") -> str:
    let facts = [
        ["1", first_sign, "65534", "65535", "65535", "65535"],
        ["1", "0", "42", "0", "0", "0"],
        ["1", "0", "7", "0", "0", "0"],
    ]
    var output = "{\"kind\":\"TranslationUnitDecl\",\"inner\":[{\"kind\":\"EnumDecl\",\"inner\":["
    var emitted = 0
    for index in range(0, len(facts)):
        let suffixes = ["is_constant", "is_negative", "word_0", "word_1", "word_2", "word_3"]
        for item in range(0, len(suffixes)):
            if emitted > 0: output += ","
            output += layout_constant_json("__luce_fiir_object_constant_" + str(index) + "_" + suffixes[item], facts[index][item])
            emitted += 1
    return output + "]}]}"

func enum_constant_json(name: str, line: i64, value: str) -> str:
    return (
        "{\"kind\":\"EnumConstantDecl\",\"loc\":{\"line\":" + str(line) + ",\"col\":5},\"name\":\"" + name + "\","
        + "\"type\":{\"qualType\":\"int\"},\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"" + value + "\"}]}"
    )

func layout_constant_json(name: str, value: str) -> str:
    return (
        "{\"kind\":\"EnumConstantDecl\",\"name\":\"" + name + "\",\"type\":{\"qualType\":\"unsigned long\"},"
        + "\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"" + value + "\"}]}"
    )


# mark: Object constants ======================================================================

pub func test_header_local_fundamental_integer_objects_become_lossless_typed_constants():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let probe = render_target_fact_probe(object_constant_ast(), "objects.h") catch reason:
        trap(reason)
    assert(strings.contains(probe, "#include <stdint.h>"))
    assert(strings.contains(probe, "__builtin_constant_p(LUCE_SIGNED_MINIMUM)"))
    assert(strings.contains(probe, "__luce_fiir_object_constant_0_bits = __builtin_choose_expr"))
    assert(strings.contains(probe, "(uint64_t)__luce_fiir_object_constant_0_bits >> 48"))
    assert(strings.contains(probe, "__luce_fiir_object_constant_1_word_3"))
    assert(strings.contains(probe, ">> 48") and strings.contains(probe, "UINT64_C(65535)"))

    let module = decode_clang_ast(object_constant_ast(), "objects.h", "test-target", list[str](), facts, object_constant_target_facts()) catch reason:
        trap(reason)
    assert(len(module.constants) == 2 and len(module.functions) == 0)
    assert(module.constants[0].name == "LUCE_SIGNED_MINIMUM")
    assert(module.types[module.constants[0].value_type.value].spelling == "long long")
    match module.constants[0].value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(9223372036854775808))
                else: trap("expected a signed object minimum")
        else: trap("expected an integer object minimum")
    assert(module.constants[1].name == "LUCE_UNSIGNED_MAXIMUM")
    assert(module.types[module.constants[1].value_type.value].spelling == "unsigned long long")
    match module.constants[1].value:
        Integer(value):
            match value:
                Nonnegative(integer): assert(integer == u64(18446744073709551615))
                else: trap("expected an unsigned object maximum")
        else: trap("expected an integer object maximum")

    let products = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub let LUCE_SIGNED_MINIMUM: c.integer_constant = c.integer_constant(true, 9223372036854775808u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_UNSIGNED_MAXIMUM: c.integer_constant = c.integer_constant(false, 18446744073709551615u64)"))
    assert(strings.contains(products.c_adapter, "_Generic((LUCE_SIGNED_MINIMUM), long long: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "LUCE_SIGNED_MINIMUM == INT64_MIN"))
    assert(strings.contains(products.c_adapter, "LUCE_UNSIGNED_MAXIMUM == UINT64_C(18446744073709551615)"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"name\": \"LUCE_SIGNED_MINIMUM\""))
    assert(strings.contains(encoded, "\"value\": \"-9223372036854775808\""))

    let alternate_ast = strings.replace(
        strings.replace(object_constant_ast(), "const long long", "const long"),
        "const unsigned long long",
        "const unsigned long",
    )
    let alternate = decode_clang_ast(alternate_ast, "objects.h", "test-target", list[str](), facts, object_constant_target_facts()) catch reason:
        trap(reason)
    let alternate_products = render_binding_products(alternate, "objects") catch reason:
        trap(reason)
    let alternate_encoded = fiir_products.render_fiir_json(alternate) catch reason:
        trap(reason)
    assert(alternate_products.raw_module == products.raw_module)
    assert(alternate_products.c_adapter != products.c_adapter)
    assert(alternate_encoded != encoded)

    let typedef_module = decode_clang_ast(
        typedef_object_constant_ast(),
        "objects.h",
        "test-target",
        list[str](),
        facts,
        object_constant_target_facts(count = 1),
    ) catch reason:
        trap(reason)
    assert(len(typedef_module.constants) == 1)
    let typedef_constant = typedef_module.constants[0]
    assert(typedef_module.types[typedef_constant.value_type.value].spelling == "luce_object_count")
    match typedef_constant.value:
        Integer(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(9223372036854775808))
                else: trap("expected a const-qualified typedef object minimum")
        else: trap("expected an integer typedef object minimum")

pub func test_header_local_boolean_and_ieee_objects_keep_exact_semantic_values():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let probe = render_target_fact_probe(scalar_object_constant_ast(), "objects.h") catch reason:
        trap(reason)
    assert(strings.contains(probe, "__builtin_constant_p(LUCE_ENABLED)"))
    assert(strings.contains(probe, "__builtin_bit_cast(uint16_t, LUCE_HALF)"))
    assert(strings.contains(probe, "__builtin_bit_cast(uint32_t, LUCE_NEGATIVE_ZERO)"))
    assert(strings.contains(probe, "__builtin_bit_cast(uint64_t, LUCE_RATIO)"))
    assert(strings.contains(probe, "#if __SIZEOF_FLOAT__ == 4"))
    assert(strings.contains(probe, "#if __SIZEOF_DOUBLE__ == 8"))

    let module = decode_clang_ast(
        scalar_object_constant_ast(),
        "objects.h",
        "test-target",
        list[str](),
        facts,
        scalar_object_constant_target_facts(),
    ) catch reason:
        trap(reason)
    assert(len(module.constants) == 6)
    match module.constants[0].value:
        Boolean(value): assert(value)
        else: trap("expected a Boolean object constant")
    match module.constants[1].value:
        Floating(bits): assert(bits == u64(0x3555))
        else: trap("expected a binary16 object constant")
    match module.constants[2].value:
        Floating(bits): assert(bits == u64(0x80000000))
        else: trap("expected a binary32 negative-zero object constant")
    match module.constants[3].value:
        Floating(bits): assert(bits == u64(0x3FF8000000000000))
        else: trap("expected a binary64 finite object constant")
    match module.constants[4].value:
        Floating(bits): assert(bits == u64(0x7FF8000000001234))
        else: trap("expected a binary64 NaN object constant")
    match module.constants[5].value:
        Floating(bits): assert(bits == u64(0x7FF0000000000000))
        else: trap("expected a binary64 infinity object constant")

    let products = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "import c\nimport math\n"))
    assert(strings.contains(products.raw_module, "pub let LUCE_ENABLED: c.boolean = c.boolean(true)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_HALF: c.float16 = c.float16(0.333251953125f16)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_NEGATIVE_ZERO: c.float = c.float(-0.0f32)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_RATIO: c.double = c.double(1.5f64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_NAN: c.double = c.double(math.nan_f64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_INFINITY: c.double = c.double(math.positive_infinity_f64)"))
    assert(strings.contains(products.c_adapter, "_Generic((LUCE_ENABLED), luce_flag: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "LUCE_NEGATIVE_ZERO == 0.0L && 1.0L / LUCE_NEGATIVE_ZERO < 0.0L"))
    assert(strings.contains(products.c_adapter, "LUCE_RATIO == 1.5"))
    assert(strings.contains(products.c_adapter, "__builtin_isnan(LUCE_NAN)"))
    assert(strings.contains(products.c_adapter, "__builtin_isinf(LUCE_INFINITY) && LUCE_INFINITY > 0.0L"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"kind\": \"boolean\""))
    assert(strings.contains(encoded, "\"ieee_bits\": \"9221120237041095220\""))

    # Exercise the remaining rendering branches without widening the fixture:
    # these are semantic-class checks, not additional Clang AST shapes.
    let original_zero = module.constants[2]
    module.constants[2] = FiirConstant(
        name = original_zero.name,
        source = original_zero.source,
        value_type = original_zero.value_type,
        value = FiirConstantValue.Floating(bits = u64(0x3FC00000)),
        origin = original_zero.origin,
    )
    let finite_single = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(finite_single.raw_module, "c.float(1.5f32)"))
    assert(strings.contains(finite_single.c_adapter, "LUCE_NEGATIVE_ZERO == 1.5f"))
    module.constants[2] = FiirConstant(
        name = original_zero.name,
        source = original_zero.source,
        value_type = original_zero.value_type,
        value = FiirConstantValue.Floating(bits = u64(0)),
        origin = original_zero.origin,
    )
    let positive_zero = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(positive_zero.c_adapter, "LUCE_NEGATIVE_ZERO == 0.0L && 1.0L / LUCE_NEGATIVE_ZERO > 0.0L"))
    module.constants[2] = original_zero

    let original_infinity = module.constants[5]
    module.constants[5] = FiirConstant(
        name = original_infinity.name,
        source = original_infinity.source,
        value_type = original_infinity.value_type,
        value = FiirConstantValue.Floating(bits = u64(0xFFF0000000000000)),
        origin = original_infinity.origin,
    )
    let negative_infinity = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(negative_infinity.raw_module, "c.double(math.negative_infinity_f64)"))
    assert(strings.contains(negative_infinity.c_adapter, "__builtin_isinf(LUCE_INFINITY) && LUCE_INFINITY < 0.0L"))
    module.constants[5] = original_infinity

    let original_half = module.constants[1]
    module.constants[1] = FiirConstant(
        name = original_half.name,
        source = original_half.source,
        value_type = original_half.value_type,
        value = FiirConstantValue.Boolean(value = true),
        origin = original_half.origin,
    )
    var wrong_kind_failed = false
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: Boolean constant `LUCE_HALF` has non-Boolean C type `_Float16`")
        wrong_kind_failed = true
    assert(wrong_kind_failed)
    module.constants[1] = FiirConstant(
        name = original_half.name,
        source = original_half.source,
        value_type = original_half.value_type,
        value = FiirConstantValue.Floating(bits = u64(0x10000)),
        origin = original_half.origin,
    )
    var wide_bits_failed = false
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: floating constant `LUCE_HALF` has bits outside its 16-bit C representation")
        wide_bits_failed = true
    assert(wide_bits_failed)
    module.constants[1] = original_half

    let alternate = decode_clang_ast(
        scalar_object_constant_ast(),
        "objects.h",
        "test-target",
        list[str](),
        facts,
        scalar_object_constant_target_facts(nan_low_word = "22136"),
    ) catch reason:
        trap(reason)
    let alternate_products = render_binding_products(alternate, "objects") catch reason:
        trap(reason)
    assert(alternate_products.raw_module == products.raw_module)
    assert(alternate_products.c_adapter == products.c_adapter)
    let alternate_encoded = fiir_products.render_fiir_json(alternate) catch reason:
        trap(reason)
    assert(alternate_encoded != encoded)

    let original_nan = module.constants[4]
    module.constants[4] = FiirConstant(
        name = "math",
        source = original_nan.source,
        value_type = original_nan.value_type,
        value = original_nan.value,
        origin = original_nan.origin,
    )
    discard(render_binding_products(module, "objects")) catch reason:
        assert(reason == "FIIR generation: raw declaration `math` is required by the generated math module import and C constant `math`")
        return
    trap("expected a special C floating constant to reserve its generated math import")

pub func test_header_local_enumeration_objects_keep_open_sign_magnitude_values():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let ast = enumeration_object_constant_ast()
    let probe = render_target_fact_probe(ast, "objects.h") catch reason:
        trap(reason)
    assert(strings.contains(probe, "__luce_fiir_object_constant_0_is_negative = __builtin_choose_expr(__builtin_constant_p(LUCE_NEGATIVE), LUCE_NEGATIVE < 0, 0)"))
    assert(strings.contains(probe, "((uint64_t)(LUCE_OPEN))"))

    let module = decode_clang_ast(ast, "objects.h", "test-target", list[str](), facts, enumeration_object_constant_target_facts()) catch reason:
        trap(reason)
    assert(len(module.constants) == 3)
    match module.constants[0].value:
        Enumeration(value):
            match value:
                Negative(magnitude): assert(magnitude == u64(2))
                else: trap("expected a negative enum object constant")
        else: trap("expected an enumeration object constant")
    match module.constants[1].value:
        Enumeration(value):
            match value:
                Nonnegative(integer): assert(integer == u64(42))
                else: trap("expected a declared positive enum object constant")
        else: trap("expected an enumeration object constant")
    match module.constants[2].value:
        Enumeration(value):
            match value:
                Nonnegative(integer): assert(integer == u64(7))
                else: trap("expected an open positive enum object constant")
        else: trap("expected an enumeration object constant")

    let products = render_binding_products(module, "objects") catch reason:
        trap(reason)
    assert(strings.contains(products.raw_module, "pub type ColorAlias = Color"))
    assert(strings.contains(products.raw_module, "pub let LUCE_NEGATIVE: Color = Color(true, 2u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_DECLARED: Color = Color(false, 42u64)"))
    assert(strings.contains(products.raw_module, "pub let LUCE_OPEN: ColorAlias = Color(false, 7u64)"))
    assert(strings.contains(products.c_adapter, "_Generic((LUCE_OPEN), ColorAlias: 1, default: 0)"))
    assert(strings.contains(products.c_adapter, "LUCE_NEGATIVE == -INT64_C(2)"))
    assert(strings.contains(products.c_adapter, "LUCE_OPEN == UINT64_C(7)"))
    let encoded = fiir_products.render_fiir_json(module) catch reason:
        trap(reason)
    assert(strings.contains(encoded, "\"kind\": \"enumeration\""))
    assert(strings.contains(encoded, "\"value\": \"-2\""))

    let original = module.constants[0]
    module.constants[0] = FiirConstant(
        name = original.name,
        source = original.source,
        value_type = original.value_type,
        value = FiirConstantValue.Enumeration(value = FiirIntegerValue.Negative(magnitude = u64(0))),
        origin = original.origin,
    )
    var negative_zero_failed = false
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: enumeration constant `LUCE_NEGATIVE` has noncanonical negative zero")
        negative_zero_failed = true
    assert(negative_zero_failed)

    module.constants[0] = FiirConstant(
        name = original.name,
        source = original.source,
        value_type = original.value_type,
        value = FiirConstantValue.Enumeration(value = FiirIntegerValue.Negative(magnitude = u64(9223372036854775809))),
        origin = original.origin,
    )
    var outside_domain_failed = false
    validate_fiir(module) catch reason:
        assert(reason == "FIIR: enumeration constant `LUCE_NEGATIVE` is outside the supported 64-bit domain")
        outside_domain_failed = true
    assert(outside_domain_failed)
    module.constants[0] = original

    var invalid_sign_failed = false
    discard(decode_clang_ast(ast, "objects.h", "test-target", list[str](), facts, enumeration_object_constant_target_facts(first_sign = "2"))) catch reason:
        assert(reason == "Clang FIIR target facts: C object `LUCE_NEGATIVE` has invalid enumeration sign 2")
        invalid_sign_failed = true
    assert(invalid_sign_failed)

pub func test_non_integer_object_constants_reject_malformed_bits_and_lossy_formats():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    let malformed = scalar_object_constant_target_facts()
    # Construct the malformed high word directly: replacing the evaluated
    # value avoids coupling this test to JSON field order.
    let high_half = strings.replace(
        malformed,
        "__luce_fiir_object_constant_1_word_1\",\"type\":{\"qualType\":\"unsigned long\"},\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"0\"",
        "__luce_fiir_object_constant_1_word_1\",\"type\":{\"qualType\":\"unsigned long\"},\"inner\":[{\"kind\":\"ConstantExpr\",\"value\":\"1\"",
    )
    var malformed_failed = false
    discard(decode_clang_ast(scalar_object_constant_ast(), "objects.h", "test-target", list[str](), facts, high_half)) catch reason:
        assert(reason == "Clang FIIR target facts: C object `LUCE_HALF` has bits outside its 16-bit representation")
        malformed_failed = true
    assert(malformed_failed)

    let extended_ast = strings.replace(scalar_object_constant_ast(), "const luce_flag", "const long double")
    discard(decode_clang_ast(extended_ast, "objects.h", "test-target", list[str](), facts, scalar_object_constant_target_facts())) catch reason:
        assert(reason == "Clang FIIR: C object constant `LUCE_ENABLED` has no lossless Luce carrier for type `long double`")
        return
    trap("expected an extended C floating constant to fail rather than narrow")

pub func test_object_constants_require_header_local_const_clang_values():
    let facts = decode_clang_scalar_facts(target_macros()) catch reason:
        trap(reason)
    var missing_failed = false
    discard(decode_clang_ast(object_constant_ast(), "objects.h", "test-target", list[str](), facts)) catch reason:
        assert(reason == "Clang FIIR: C object constants have no Clang-evaluated target-fact probe")
        missing_failed = true
    assert(missing_failed)

    let external_definition = strings.replace(object_constant_ast(), "\"storageClass\":\"static\"", "\"storageClass\":\"extern\"")
    var external_definition_failed = false
    discard(render_target_fact_probe(external_definition, "objects.h")) catch reason:
        assert(strings.contains(reason, "must be either a header-local `static const` value or a declaration-only `extern` object"))
        external_definition_failed = true
    assert(external_definition_failed)

    let mutable_document = strings.replace(object_constant_ast(), "const long long", "long long")
    var mutable_failed = false
    discard(render_target_fact_probe(mutable_document, "objects.h")) catch reason:
        assert(strings.contains(reason, "must be either a header-local `static const` value or a declaration-only `extern` object"))
        mutable_failed = true
    assert(mutable_failed)

    let volatile_document = strings.replace(object_constant_ast(), "const long long", "const volatile long long")
    var volatile_failed = false
    discard(render_target_fact_probe(volatile_document, "objects.h")) catch reason:
        assert(reason == "Clang FIIR: C object `LUCE_SIGNED_MINIMUM` is volatile runtime storage and cannot become a generated constant")
        volatile_failed = true
    assert(volatile_failed)

    let unsupported_document = strings.replace(object_constant_ast(), "const long long", "const _Complex double")
    var unsupported_failed = false
    discard(render_target_fact_probe(unsupported_document, "objects.h")) catch reason:
        assert(reason == "Clang FIIR: C object constant `LUCE_SIGNED_MINIMUM` has unsupported type `const _Complex double`")
        unsupported_failed = true
    assert(unsupported_failed)

    var nonconstant_failed = false
    discard(decode_clang_ast(object_constant_ast(), "objects.h", "test-target", list[str](), facts, object_constant_target_facts(is_constant = "0"))) catch reason:
        assert(reason == "Clang FIIR: C object `LUCE_SIGNED_MINIMUM` does not have a Clang-evaluable constant value")
        nonconstant_failed = true
    assert(nonconstant_failed)

    var malformed_failed = false
    discard(decode_clang_ast(object_constant_ast(), "objects.h", "test-target", list[str](), facts, object_constant_target_facts(first_word = "65536"))) catch reason:
        assert(reason == "Clang FIIR target facts: C object `LUCE_SIGNED_MINIMUM` word 0 exceeds 16 bits")
        malformed_failed = true
    assert(malformed_failed)
