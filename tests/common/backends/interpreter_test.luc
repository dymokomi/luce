pub func test_pointer_handles_encode_null_only_at_c_boundaries():
    let source = "pub extern type Window\nextern func create() -> Window?\npub extern func broken() -> Window\nextern func show(window: Window) -> bool\npub func absent() -> bool: return create() == none\npub func use() -> bool:\n    match create():\n        .some(window): return show(window)\n        .none: return false\nexport c func accepts(window: Window) -> bool: return window == window\nexport c func optional(window: Window?) -> bool: return window == none\nexport c func echo(window: Window?) -> Window?: return window\n"
    let program = analyzed([source_module("main", source)])

    let absent = HirInterpreter().run_with_host(program, "main", "absent", NullWindowHost()) catch reason:
        trap(reason)
    match absent:
        Boolean(value): assert(value)
        else: assert(false)

    let used = HirInterpreter().run_with_host(program, "main", "use", LiveWindowHost()) catch reason:
        trap(reason)
    match used:
        Boolean(value): assert(value)
        else: assert(false)

    assert(host_execution_failure(program, "broken", NullWindowHost()) == "interpreter: null_foreign crossing extern `main.broken` result")
    assert(export_call_failure(program, "accepts", [Value.Foreign(token = 0)]) == "interpreter: null_foreign crossing C export `accepts` parameter `window`")

    let none_value = HirInterpreter().call_c_export(program, "optional", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    match none_value:
        Boolean(value): assert(value)
        else: assert(false)
    let echoed = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 42)]) catch reason:
        trap(reason)
    assert(foreign_token(echoed) == 42)
    let echoed_none = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    assert(foreign_token(echoed_none) == 0)

pub func test_foreign_pointers_share_one_raw_boundary_protocol():
    let source = "extern struct Holder:\n    pointer: foreign\nextern func acquire() -> foreign?\nextern func absent() -> foreign?\npub extern func broken() -> foreign\nextern func fill(out value: foreign?)\nextern func consume(value: foreign) -> bool\nextern func read_holder(out value: Holder)\nextern func consume_holder(value: Holder)\npub func answer() -> bool:\n    if let pointer = acquire():\n        if let output = fill(): return consume(pointer) and consume(output) and absent() == none\n    return false\npub func observe() -> bool:\n    let holder = read_holder()\n    return holder.pointer == holder.pointer\npub func cross_again(): consume_holder(read_holder())\nexport c func accepts(pointer: foreign) -> bool: return pointer == pointer\nexport c func optional(pointer: foreign?) -> bool: return pointer == none\nexport c func echo(pointer: foreign?) -> foreign?: return pointer\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_host(program, "main", "answer", ForeignPointerHost()) catch reason:
        trap(reason)
    match answer:
        Boolean(value): assert(value)
        else: assert(false)

    assert(host_execution_failure(program, "broken", ForeignPointerHost()) == "interpreter: null_foreign crossing extern `main.broken` result")
    assert(export_call_failure(program, "accepts", [Value.Foreign(token = 0)]) == "interpreter: null_foreign crossing C export `accepts` parameter `pointer`")
    let optional = HirInterpreter().call_c_export(program, "optional", [Value.Foreign(token = 0)]) catch reason:
        trap(reason)
    match optional:
        Boolean(value): assert(value)
        else: assert(false)
    let echoed = HirInterpreter().call_c_export(program, "echo", [Value.Foreign(token = 702)]) catch reason:
        trap(reason)
    assert(foreign_token(echoed) == 702)

    let observed = HirInterpreter().run_with_host(program, "main", "observe", ForeignPointerHost()) catch reason:
        trap(reason)
    match observed:
        Boolean(value): assert(value)
        else: assert(false)
    assert(host_execution_failure(program, "cross_again", ForeignPointerHost()) == "interpreter: null_foreign crossing extern `main.consume_holder` parameter `value`.pointer")

pub func test_c_out_parameters_are_returned_in_source_declaration_order():
    let source = "extern type Window\nextern func split(value: i32, out rest: i32, out window: Window?) -> i32\npub func answer() -> bool:\n    let (result, rest, window) = split(41)\n    return result == 1 and rest == 42 and window != none\n"
