pub func test_extern_structs_cross_the_semantic_oracle_as_fresh_records():
    let source = "extern struct Pair:\n    left: i32 = 20i32\n    right: i32 = 22i32\n    func total(self) -> i32: return self.left + self.right\nextern func exchange(value: Pair, out changed: Pair) -> i32\npub func answer() -> i32:\n    let (status, changed) = exchange(Pair())\n    return status + changed.total()\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_host(program, "main", "answer", ExternStructHost()) catch reason:
        trap(reason)
    assert(integer(answer) == 42)

pub func test_exported_c_structs_translate_nested_records_and_enum_fields_at_each_edge():
    let source = "export c enum Status as i32:\n    ready = -2\n    done = 42\nexport c struct Pair:\n    let left: i32\n    let right: i32\nexport c struct Envelope:\n    let pair: Pair\n    let status: Status\nextern func adjust(value: Envelope) -> Envelope\nexport c func echo(value: Envelope) -> Envelope: return value\npub func answer() -> i32:\n    let changed = adjust(Envelope(pair = Pair(left = 20i32, right = 22i32), status = .ready))\n    match changed.status:\n        .ready: return 0i32\n        .done: return changed.pair.left + changed.pair.right\n"
    let program = analyzed([source_module("main", source)])
    let answer = HirInterpreter().run_with_host(program, "main", "answer", ExportedCStructHost()) catch reason:
        trap(reason)
    assert(integer(answer) == 42)

    let raw = Value.Record(fields = [
        BoxedValue(value = Value.Record(fields = [
            BoxedValue(value = Value.SignedInteger(value = 20)),
            BoxedValue(value = Value.SignedInteger(value = 22)),
        ])),
        BoxedValue(value = Value.SignedInteger(value = -2)),
    ])
    let echoed = HirInterpreter().call_c_export(program, "echo", [raw]) catch reason:
        trap(reason)
    match echoed:
        Record(fields):
            assert(integer(fields[1].value) == -2)
            match fields[0].value:
                Record(pair): assert(integer(pair[0].value) + integer(pair[1].value) == 42)
                else: assert(false)
        else: assert(false)

    let invalid = Value.Record(fields = [
        BoxedValue(value = Value.Record(fields = [
            BoxedValue(value = Value.SignedInteger(value = 20)),
            BoxedValue(value = Value.SignedInteger(value = 22)),
        ])),
        BoxedValue(value = Value.SignedInteger(value = 7)),
    ])
    assert(export_call_failure(program, "echo", [invalid]) ==
        "interpreter: C export `echo` received parameter `value`.status incompatible with `Status`")

pub func test_extern_struct_handle_fields_stay_bare_until_the_next_input_crossing():
    let source = "extern type Handle\nextern struct Holder:\n    handle: Handle\nextern func read(out value: Holder)\nextern func consume(value: Holder)\npub func observe() -> bool:\n    let value = read()\n    return value.handle == value.handle\npub func cross_again(): consume(read())\n"
    let program = analyzed([source_module("main", source)])
    let observed = HirInterpreter().run_with_host(program, "main", "observe", NullExternStructHandleHost()) catch reason:
