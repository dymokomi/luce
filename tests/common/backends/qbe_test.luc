pub func test_qbe_caches_tasks_and_wait_all_preserves_order_when_available():
    if not has_qbe(): return
    let source_text = (
        "func double(value: i32) -> i32: return value * 2i32\n"
        + "func identity[T](value: T) -> T: return value\n"
        + "func run() -> i32!:\n"
        + "    let first = spawn double(21i32)\n"
        + "    let direct = try first.wait()\n"
        + "    let repeated = try wait_all([first, first])\n"
        + "    let generic = spawn identity(42i32)\n"
        + "    let generic_value = try generic.wait()\n"
        + "    let empty: list[task[i32]] = []\n"
        + "    let empty_values = try wait_all(empty)\n"
        + "    if repeated.length != 2u64 or repeated[0u64] != 42i32 or repeated[1u64] != 42i32: return 1i32\n"
        + "    if empty_values.length != 0u64 or generic_value != 42i32: return 2i32\n"
        + "    return direct\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure: recover 3i32\n"
    )
    assert(qbe_run(lower_source_with_runtime(source_text)).status == 42)

pub func test_qbe_supports_nested_workers_and_closes_unobserved_groups_when_available():
    if not has_qbe(): return
    let nested_source = (
        "func answer() -> i32: return 42i32\n"
        + "func nested() -> i32!:\n"
        + "    let inner = spawn answer()\n"
        + "    return try inner.wait()\n"
        + "func run() -> i32!:\n"
        + "    let outer = spawn nested()\n"
        + "    return try outer.wait()\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure: recover 1i32\n"
    )
    expect_qbe_status("nested isolated workers", qbe_run(lower_source_with_runtime(nested_source)), 42)

    # Returning without observing a divergent worker exercises lexical group
    # finish and destruction. The generated function must cancel and reap the
    # child before its task storage or runtime domain is released.
    let unfinished_source = (
        "func pending() -> i32:\n"
        + "    var value = 0i32\n"
        + "    while true: value += 1i32\n"
        + "    return value\n"
        + "func leave() -> i32:\n"
        + "    let unfinished = spawn pending()\n"
        + "    return 42i32\n"
        + "pub func main(arguments: slice[str]) -> i32!: return leave()\n"
    )
    expect_qbe_status("unfinished task-group cleanup", qbe_run(lower_source_with_runtime(unfinished_source)), 42)

pub func test_qbe_wait_all_reports_the_first_input_failure_and_accepts_never_empty_when_available():
    if not has_qbe(): return
    let failure_source = (
        "let first_code: ErrorCode = ErrorCode.package(7)\n"
        + "let second_code: ErrorCode = ErrorCode.package(8)\n"
        + "func fail_first() -> i32!:\n"
        + "    var value = 0i32\n"
        + "    while value < 100000i32: value += 1i32\n"
        + "    error(first_code, \"first\")\n"
        + "func fail_second() -> i32!: error(second_code, \"second\")\n"
        + "func run() -> i32!:\n"
        + "    let first = spawn fail_first()\n"
        + "    let second = spawn fail_second()\n"
        + "    discard(try wait_all([first, second]))\n"
        + "    return 1i32\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure:\n"
        + "        if failure.code == first_code and failure.message == \"first\": recover 42i32\n"
        + "        recover 2i32\n"
    )
    expect_qbe_status("wait_all input-order failure", qbe_run(lower_source_with_runtime(failure_source)), 42)

    let empty_source = (
        "func run() -> i32!:\n"
        + "    let empty: list[task[never]] = []\n"
        + "    let values = try wait_all(empty)\n"
        + "    return 42i32 if values.length == 0u64 else 2i32\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure: recover 1i32\n"
    )
    expect_qbe_status("empty wait_all of never", qbe_run(lower_source_with_runtime(empty_source)), 42)

pub func test_qbe_transfers_worker_failures_traps_and_cancellation_when_available():
    if not has_qbe(): return
    let failure_source = (
        "let invalid: ErrorCode = ErrorCode.package(7)\n"
        + "func fail() -> i32!: error(invalid, \"remote failure\")\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let work = spawn fail()\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.message != \"remote failure\": recover 2i32\n"
        + "        if failure.code != invalid: recover 3i32\n"
        + "        recover 42i32\n"
    )
    let trap_source = (
        "func stop() -> i32: trap(\"remote trap\")\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let work = spawn stop()\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.message == \"remote trap\": recover 42i32\n"
        + "        recover 1i32\n"
    )
    let cancellation_source = (
        "func pending() -> i32:\n"
        + "    var value = 0i32\n"
        + "    while true: value += 1i32\n"
        + "    return value\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let work = spawn pending()\n"
        + "    work.cancel()\n"
        + "    work.cancel()\n"
        + "    return work.wait() catch failure:\n"
        + "        if failure.message == \"task cancelled\": recover 42i32\n"
        + "        recover 1i32\n"
    )
    expect_qbe_status("worker failure", qbe_run(lower_source_with_runtime(failure_source)), 42)
    expect_qbe_status("worker trap", qbe_run(lower_source_with_runtime(trap_source)), 42)
    expect_qbe_status("worker cancellation", qbe_run(lower_source_with_runtime(cancellation_source)), 42)

pub func test_qbe_copies_frozen_graphs_across_both_task_boundaries_when_available():
    if not has_qbe(): return
    let source_text = (
        "func inspect(values: frozen_list[i32], table: frozen_map[str, i32], tags: frozen_set[str]) -> frozen_list[i32]:\n"
        + "    if values.length != 2u64 or values[0u64] != 20i32 or values[1u64] != 22i32: return [0i32].snapshot()\n"
        + "    if (table[\"left\"] else 0i32) != 20i32 or (table[\"right\"] else 0i32) != 22i32: return [0i32].snapshot()\n"
        + "    if not tags.contains(\"ready\") or tags.contains(\"changed\"): return [0i32].snapshot()\n"
        + "    return [values[0u64] + values[1u64]].snapshot()\n"
        + "func run() -> i32!:\n"
        + "    let source_values = [20i32, 22i32]\n"
        + "    let source_table = {\"left\": 20i32, \"right\": 22i32}\n"
        + "    let source_tags = set[str](\"ready\")\n"
        + "    let work = spawn inspect(source_values.snapshot(), source_table.snapshot(), source_tags.snapshot())\n"
        + "    source_values[0u64] = 0i32\n"
        + "    source_table[\"left\"] = 0i32\n"
        + "    discard(source_tags.remove(\"ready\"))\n"
        + "    discard(source_tags.insert(\"changed\"))\n"
        + "    let returned = try work.wait()\n"
        + "    return returned[0u64]\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure: recover 1i32\n"
    )
    expect_qbe_status("frozen worker transfer", qbe_run(lower_source_with_runtime(source_text)), 42)

pub func test_qbe_copies_structural_and_buffer_values_across_tasks_when_available():
    if not has_qbe(): return
    let source_text = (
        "enum Choice:\n"
        + "    empty\n"
        + "    answer(value: i32)\n"
        + "struct Parcel:\n"
        + "    let numbers: array[i32, 2]\n"
        + "    let label: str\n"
        + "    let payload: bytes\n"
        + "    let selected: i32?\n"
        + "    let choice: Choice\n"
        + "    let view: slice[i32]\n"
        + "func echo(value: Parcel) -> Parcel: return value\n"
        + "func run() -> i32!:\n"
        + "    var numbers: array[i32, 2] = [20i32, 22i32]\n"
        + "    let value = Parcel(numbers = numbers, label = \"lu\" + \"ce\", payload = b\"a\" + b\"bc\", selected = 7i32, choice = Choice.answer(value = 5i32), view = numbers[0u64..<2u64])\n"
        + "    let work = spawn echo(value)\n"
        + "    numbers[0u64] = 0i32\n"
        + "    let copied = try work.wait()\n"
        + "    if copied.label != \"luce\" or copied.payload != b\"abc\": return 1i32\n"
        + "    if (copied.selected else 0i32) != 7i32 or copied.numbers[0u64] + copied.numbers[1u64] != 42i32: return 2i32\n"
        + "    if copied.view[0u64] + copied.view[1u64] != 42i32: return 3i32\n"
        + "    return match copied.choice:\n"
        + "        .answer(answer_value) => answer_value + 37i32\n"
        + "        .empty => 4i32\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    return run() catch failure: recover 5i32\n"
    )
    expect_qbe_status("structural worker transfer", qbe_run(lower_source_with_runtime(source_text)), 42)

pub func test_qbe_preserves_hash_collision_chains_across_growth_and_removal_when_available():
    if not has_qbe(): return
    let source_text = (
        "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let values = map[i64, i64]()\n"
        + "    for key in 0..<300: values[key] = key * 2\n"
        + "    for key in 0..<300:\n"
        + "        if (values[key] else -1) != key * 2: return 1\n"
        + "    for key in 0..<300:\n"
        + "        if key % 3 == 0 and (values.remove(key) else -1) != key * 2: return 2\n"
        + "    for key in 0..<300:\n"
        + "        if key % 3 == 0:\n"
        + "            if values[key] != none: return 3\n"
        + "        elif (values[key] else -1) != key * 2: return 4\n"
        + "    return 42\n"
    )
    assert(qbe_run(lower_source_with_runtime(source_text)).status == 42)

pub func test_qbe_executes_recursive_map_equality_when_available():
    if not has_qbe(): return
    let source_text = (
        "struct Node:\n    let value: i32\n    let edges: map[str, Node]\n"
        + "func self_cycle(value: i32) -> map[str, Node]:\n    let root = map[str, Node]()\n    root[\"self\"] = Node(value = value, edges = root)\n    return root\n"
        + "func sever(root: map[str, Node]): root.clear()\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let left = self_cycle(1i32)\n"
        + "    let right = self_cycle(1i32)\n"
        + "    let equal = left == right\n"
        + "    sever(left)\n"
        + "    sever(right)\n"
        + "    if not equal: return 1\n"
        + "    let mismatch_left = self_cycle(1i32)\n"
        + "    let mismatch_right = self_cycle(2i32)\n"
        + "    let unequal = mismatch_left != mismatch_right\n"
        + "    sever(mismatch_left)\n"
        + "    sever(mismatch_right)\n"
        + "    return 42 if unequal else 2\n"
    )
    assert(qbe_run(lower_source_with_runtime(source_text)).status == 42)

pub func test_qbe_releases_managed_map_values_exactly_once_across_every_lifecycle_path_when_available():
    if not has_qbe(): return
    let source_text = (
        "class Token:\n    let events: list[i32]\n    let value: i32\n"
        + "    func init(self, events: list[i32], value: i32):\n        self.events = events\n        self.value = value\n"
        + "    func deinit(self): self.events.append(self.value)\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let events = list[i32]()\n"
        + "    let values = map[str, Token]()\n"
        + "    values[\"key\"] = new Token(events, 1i32)\n"
        + "    values[\"key\"] = new Token(events, 2i32)\n"
        + "    if events.length != 1u64 or events[0u64] != 1i32: return 1\n"
        + "    values.clear()\n"
        + "    if events.length != 2u64 or events[1u64] != 2i32: return 2\n"
        + "    if true:\n"
        + "        let source = map[str, Token]()\n"
        + "        source[\"key\"] = new Token(events, 3i32)\n"
        + "        let copied = source.copy()\n"
        + "        if let removed = source.remove(\"key\"):\n"
        + "            if removed.value != 3i32 or copied.length != 1u64: return 4\n"
        + "        else: return 3\n"
        + "    if events.length != 3u64 or events[2u64] != 3i32: return 5\n"
        + "    if true:\n"
        + "        let final_release = {\"key\": new Token(events, 4i32)}\n"
        + "        if final_release.length != 1u64: return 6\n"
        + "    if events.length != 4u64 or events[3u64] != 4i32: return 7\n"
        + "    return 42\n"
    )
    assert(qbe_run(lower_source_with_runtime(source_text)).status == 42)

