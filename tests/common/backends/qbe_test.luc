# mark: Builders and toolchain helpers =========================================================

func at() -> SourceSpan:
    return SourceSpan(start = 0, end = 0, line = 1, column = 1)

func ins(form: InstructionForm) -> MirInstruction:
    return MirInstruction(form = form, span = at())

func r(value: i64) -> RegisterId:
    return RegisterId(value = u32(value))

func i32_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i32)
func i64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.signed_i64)
func u64_t() -> TypeId: return builtin_mir_type(BuiltinMirType.unsigned_u64)
func bool_t() -> TypeId: return builtin_mir_type(BuiltinMirType.boolean)
func ptr_t() -> TypeId: return builtin_mir_type(BuiltinMirType.pointer)

func temperature_macro_constants() -> list[str]:
    return [
        "LUCE_TEMPERATURE_ABSOLUTE_ZERO",
        "LUCE_TEMPERATURE_SENSOR_LIMIT",
        "LUCE_TEMPERATURE_MACRO_ENABLED",
        "LUCE_TEMPERATURE_MACRO_HALF_STEP",
        "LUCE_TEMPERATURE_MACRO_NEGATIVE_ZERO",
        "LUCE_TEMPERATURE_MACRO_REFERENCE_RATIO",
        "LUCE_TEMPERATURE_MACRO_POSITIVE_INFINITY",
        "LUCE_TEMPERATURE_MACRO_UNDEFINED",
        "LUCE_TEMPERATURE_MACRO_OPEN_SCALE",
    ]

func function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = at(),
    )

func private_function(ops: OperandBuilder, name: str, parameters: list[TypeId], results: list[TypeId], registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = name,
        convention = CallingConvention.luce,
        signature = MirSignature(parameters = parameters, results = results, is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = false,
        is_exported = false,
        span = at(),
    )

# Low-level MIR execution fixtures use an explicit C entry. Language process
# entry adaptation is exercised separately from these instruction tests.
func c_main_function(ops: OperandBuilder, registers: list[TypeId], body: list[MirInstruction]) -> MirFunction:
    return MirFunction(
        name = "main",
        convention = CallingConvention.c,
        signature = MirSignature(parameters = list[TypeId](), results = [i32_t()], is_fallible = false, returns_never = false),
        registers = registers,
        slots = list[MirSlot](),
        body = body,
        operands = ops.operands,
        transfers = ops.transfers,
        is_public = true,
        is_exported = true,
        span = at(),
    )

# A tiny composed-runtime fixture. Its allocator owns a fixed data buffer;
# the compiler merely calls the bound function after backend layout.
func storage_program(count: i64, zero_sized: bool, uses_storage: bool) -> MirProgram:
    let allocator_ops = OperandBuilder()
    let entry_ops = OperandBuilder()
    var program = create_empty_mir_program()
    var element_type = i32_t()
    if zero_sized: element_type = intern_mir_type(program.types, make_struct_type(list[TypeId]()))
    program.data.append(MirData(name = "runtime.arena", bytes = [0, 0, 0, 0, 0, 0, 0, 0], align = 8))
    program.functions.append(private_function(allocator_ops, "runtime.allocate", [u64_t(), u64_t()], [ptr_t()], [u64_t(), u64_t(), ptr_t()], [
        ins(InstructionForm.DataAddress(result = r(2), data = DataId(value = 0))),
        ins(InstructionForm.Return(values = allocator_ops.run([r(2)]))),
    ]))
    program.runtime_bindings.append(MirRuntimeBinding(service = RuntimeService.storage_allocator, function = FunctionId(value = 0)))
    if uses_storage:
        program.functions.append(c_main_function(entry_ops, [u64_t(), ptr_t(), u64_t(), ptr_t(), i32_t(), i32_t()], [
            ins(InstructionForm.Const(result = r(0), value = MirConstant.UnsignedInt(value = u64(count)))),
            ins(InstructionForm.AllocateStorage(result = r(1), element_type = element_type, count = r(0))),
            ins(InstructionForm.Const(result = r(2), value = MirConstant.UnsignedInt(value = u64(1)))),
            ins(InstructionForm.ElementAddress(result = r(3), element_type = element_type, base = r(1), index = r(2))),
            ins(InstructionForm.Const(result = r(4), value = MirConstant.SignedInt(value = 42))),
            ins(InstructionForm.Store(value_type = i32_t(), address = r(3), value = r(4))),
            ins(InstructionForm.Load(result = r(5), value_type = i32_t(), address = r(3))),
            ins(InstructionForm.Return(values = entry_ops.run([r(5)]))),
        ]))
    else:
        program.functions.append(c_main_function(entry_ops, [u64_t(), ptr_t(), i32_t()], [
            ins(InstructionForm.Const(result = r(0), value = MirConstant.UnsignedInt(value = u64(count)))),
            ins(InstructionForm.AllocateStorage(result = r(1), element_type = element_type, count = r(0))),
            ins(InstructionForm.Const(result = r(2), value = MirConstant.SignedInt(value = 0))),
            ins(InstructionForm.Return(values = entry_ops.run([r(2)]))),
        ]))
    return program

# Compile the real sealed runtime source and compose it with the smallest
# target-neutral application that makes two typed storage requests.
func allocator_runtime_bindings() -> list[RuntimeBindingInput]:
    return [
        RuntimeBindingInput(service = RuntimeService.storage_allocator, module_name = "allocator", function_name = "allocate_storage"),
        RuntimeBindingInput(service = RuntimeService.storage_deallocator, module_name = "allocator", function_name = "deallocate_storage"),
        RuntimeBindingInput(service = RuntimeService.class_retain, module_name = "allocator", function_name = "class_retain"),
        RuntimeBindingInput(service = RuntimeService.class_release, module_name = "allocator", function_name = "class_release"),
        # The runtime's own mutation diagnostic is an owned string even when
        # this fixture reaches only allocator services before optimization.
        RuntimeBindingInput(service = RuntimeService.buffer_retain, module_name = "allocator", function_name = "buffer_retain"),
        RuntimeBindingInput(service = RuntimeService.buffer_release, module_name = "allocator", function_name = "buffer_release"),
    ]

func runtime_storage_program(first_count: i64) -> MirProgram:
    let ops = OperandBuilder()
    var application = create_empty_mir_program()
    application.functions.append(c_main_function(ops, [
        u64_t(), ptr_t(), i32_t(), u64_t(), ptr_t(), i32_t(), i32_t(), i32_t(), i32_t(),
    ], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.UnsignedInt(value = u64(first_count)))),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i32_t(), count = r(0))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.SignedInt(value = 40))),
        ins(InstructionForm.Store(value_type = i32_t(), address = r(1), value = r(2))),
        ins(InstructionForm.Const(result = r(3), value = MirConstant.UnsignedInt(value = u64(1)))),
        ins(InstructionForm.AllocateStorage(result = r(4), element_type = i32_t(), count = r(3))),
        ins(InstructionForm.Const(result = r(5), value = MirConstant.SignedInt(value = 2))),
        ins(InstructionForm.Store(value_type = i32_t(), address = r(4), value = r(5))),
        ins(InstructionForm.Load(result = r(6), value_type = i32_t(), address = r(1))),
        ins(InstructionForm.Load(result = r(7), value_type = i32_t(), address = r(4))),
        ins(InstructionForm.Binary(result = r(8), operation = BinaryOp.add, left = r(6), right = r(7))),
        ins(InstructionForm.Return(values = ops.run([r(8)]))),
    ]))

    let runtime = compile_runtime(RuntimePackageInput(
        identity = "org.luce.runtime",
        source_root = "src/runtime",
        source_paths = ["src/runtime/allocator.lucn"],
        bindings = allocator_runtime_bindings(),
    )) catch reason:
        trap(reason)
    let combined = compose_runtime(application, runtime.program) catch reason:
        trap(reason)
    MirVerifier(combined).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(combined).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    return optimized

func runtime_reuse_program() -> MirProgram:
    let ops = OperandBuilder()
    var application = create_empty_mir_program()
    application.functions.append(c_main_function(ops, [u64_t(), ptr_t(), ptr_t(), i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.UnsignedInt(value = u64(8388608)))),
        ins(InstructionForm.AllocateStorage(result = r(1), element_type = i32_t(), count = r(0))),
        ins(InstructionForm.DeallocateStorage(address = r(1), element_type = i32_t(), count = r(0))),
        ins(InstructionForm.AllocateStorage(result = r(2), element_type = i32_t(), count = r(0))),
        ins(InstructionForm.Const(result = r(3), value = MirConstant.SignedInt(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(3)]))),
    ]))
    let runtime = compile_runtime(RuntimePackageInput(
        identity = "org.luce.runtime",
        source_root = "src/runtime",
        source_paths = ["src/runtime/allocator.lucn"],
        bindings = allocator_runtime_bindings(),
    )) catch reason:
        trap(reason)
    let combined = compose_runtime(application, runtime.program) catch reason:
        trap(reason)
    MirVerifier(combined).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(combined).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    return optimized

func emit(program: MirProgram) -> str:
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let text = QbeBackend().emit_il(program) catch reason:
        trap(reason)
    return text

pub func test_base_attributes_become_qbe_linkage_and_assembler_directives():
    let program = base_lowered("used section(\"__DATA,__luce\") var table: u64 = 1\n\npub section(\"__TEXT,__hot\") func hot() -> i64:\n    return 1\n\nweak export c func handler() -> i64:\n    return 2\n")
    let text = emit(program)
    assert(strings.contains(text, "section \"__DATA,__luce\" data $g0 ="))
    assert(strings.contains(text, "section \"__TEXT,__hot\" function"))
    let mach_o = qbe_symbol_directives(program, "arm64-apple-darwin24.6.0")
    assert(strings.contains(mach_o, ".weak_definition _handler\n"))
    assert(strings.contains(mach_o, ".no_dead_strip _g0\n"))
    let elf = qbe_symbol_directives(program, "x86_64-pc-linux-gnu")
    assert(strings.contains(elf, ".weak handler\n"))
    assert(not strings.contains(elf, "no_dead_strip"))

pub func test_qbe_calls_c_from_base_when_available():
    let program = base_lowered("extern func abs(value: i32) -> i32\nextern func strlen(text: cstr) -> usize\n\nexport c func answer() -> i64:\n    let text: str = \"luce base\"\n    return (i64)abs(-30) + (i64)strlen(\"luce\") + (i64)strlen((cstr)text) - 1\n")
    let il = emit(program)
    assert(strings.contains(il, "call $strlen(l "))
    assert(strings.contains(il, "call $abs(w "))
    if not has_qbe(): return
    let driver = "#include <stdio.h>\n#include <stdint.h>\nint64_t answer(void);\nint main(void) { printf(\"%lld\\n\", (long long) answer()); return 0; }\n"
    let result = qbe_run_with_c_source(program, driver)
    assert(result.status == 0)
    assert(result.output == "42\n")

pub func test_qbe_runs_a_base_main_with_its_arguments_when_available():
    let program = base_lowered("extern func puts(text: cstr) -> i32\nextern func strlen(text: cstr) -> usize\n\npub func main(arguments: str[]) -> i32:\n    discard(puts(\"hello from luce base\"))\n    var total: i32 = 0\n    for argument in arguments[1..<arguments.length]: total += (i32)argument.length\n    return (i32)(arguments.length - 1) * 10 + total\n")
    let il = emit(program)
    assert(strings.contains(il, "export function w $main(w %argc, l %argv)"))
    assert(strings.contains(il, "call $strlen(l %entry_c_string)"))
    if not has_qbe(): return
    let result = qbe_run_with_arguments(program, ["ab", "cde"])
    assert(result.output == "hello from luce base\n")
    # Two arguments after the program name, five bytes between them.
    assert(result.status == 25)

pub func test_qbe_calls_variadic_and_renamed_c_functions_when_available():
    let program = base_fixture_lowered("import c\n\nextern func snprintf(buffer: u8*, size: usize, format: cstr, ...) -> c.int\nextern func atoi(text: cstr) -> c.int\nextern func absolute as \"abs\"(value: c.int) -> c.int\n\nexport c func answer() -> i64:\n    var buffer: u8[8]\n    let written = snprintf(&buffer[0], 8, \"%d%s\", 1, \"x\")\n    return (i64)atoi(\"40\") + (i64)written + (i64)absolute(-1) - 1\n")
    let il = emit(program)
    assert(strings.contains(il, "call $snprintf(l "))
    assert(strings.contains(il, ", ..., w "))
    assert(strings.contains(il, "call $abs(w "))
    if not has_qbe(): return
    let driver = "#include <stdio.h>\n#include <stdint.h>\nint64_t answer(void);\nint main(void) { printf(\"%lld\\n\", (long long) answer()); return 0; }\n"
    let result = qbe_run_with_c_source(program, driver)
    assert(result.status == 0)
    assert(result.output == "42\n")

pub func test_qbe_runs_base_span_callback_and_status_exports_from_c_when_available():
    let program = base_lowered("let zero_division: ErrorCode = ErrorCode.package(7)\nlet negative: ErrorCode = ErrorCode.package(8)\n\nexport func sum(values: const i32[]) -> i32:\n    var total: i32 = 0\n    for value in values: total += value\n    return total\n\nexport func apply(step: func(i32) -> i32, value: i32) -> i32:\n    return step(value)\n\nexport func divide(left: i32, right: i32) -> i32!:\n    if right == 0: error(zero_division, \"division by zero\")\n    return left // right\n\nexport func check(value: i32) -> unit!:\n    if value < 0: error(negative, \"negative\")\n")
    let il = emit(program)
    assert(strings.contains(il, "export function w $sum(l "))
    assert(strings.contains(il, "export function w $divide(w "))
    if not has_qbe(): return
    let c_source = "#include <stddef.h>\n#include <stdint.h>\nextern int32_t sum(const int32_t *values, size_t count);\nextern int32_t apply(int32_t (*step)(int32_t), int32_t value);\nextern int32_t divide(int32_t left, int32_t right, int32_t *out);\nextern int32_t check(int32_t value);\nstatic int32_t twice(int32_t value) { return value * 2; }\nint main(void) {\n    int32_t values[3] = {10, 20, 12};\n    if (sum(values, 3) != 42) return 1;\n    if (sum(NULL, 0) != 0) return 2;\n    if (apply(twice, 21) != 42) return 3;\n    int32_t out = 0;\n    if (divide(84, 2, &out) != 0 || out != 42) return 4;\n    if (divide(1, 0, &out) != 1) return 5;\n    if (check(1) != 0 || check(-1) != 1) return 6;\n    return 0;\n}\n"
    expect_qbe_status("base spans, callbacks, and status exports", qbe_run_with_c_source(program, c_source), 0)

pub func test_qbe_runs_exported_base_methods_from_c_when_available():
    let program = base_lowered("pub struct Cursor:\n    pub var offset: usize\n\n    export mutating func advance(self, count: usize):\n        self.offset += count\n\n    export func position(self) -> usize:\n        return self.offset\n")
    let il = emit(program)
    assert(strings.contains(il, "export function $Cursor_advance(l "))
    assert(strings.contains(il, "export function l $Cursor_position(l "))
    if not has_qbe(): return
    let c_source = "#include <stddef.h>\n#include <stdint.h>\ntypedef struct { size_t offset; } Cursor;\nextern void Cursor_advance(Cursor *self, size_t count);\nextern size_t Cursor_position(const Cursor *self);\nint main(void) {\n    Cursor cursor = {40};\n    Cursor_advance(&cursor, 2);\n    return Cursor_position(&cursor) == 42 && cursor.offset == 42 ? 0 : 1;\n}\n"
    expect_qbe_status("exported base methods", qbe_run_with_c_source(program, c_source), 0)

pub func test_qbe_runs_base_exports_from_c_when_available():
    let program = base_lowered("pub struct Point:\n    pub var x: i32\n    pub var y: i32\n\npub enum Access as u32:\n    read = 1\n    write = 2\n\nexport func shift(point: Point*, by: Point, flags: Access) -> Point:\n    point.x += by.x\n    return *point\n\nexport func first(points: const Point*?, count: usize) -> i32:\n    if let found = points: return found.x\n    return -1\n")
    let il = emit(program)
    assert(strings.contains(il, "export function :luce_t"))
    assert(strings.contains(il, "export function w $first(l "))
    if not has_qbe(): return
    let c_source = "#include <stddef.h>\n#include <stdint.h>\ntypedef struct { int32_t x; int32_t y; } Point;\nextern Point shift(Point *point, Point by, uint32_t flags);\nextern int32_t first(const Point *points, size_t count);\nint main(void) {\n    Point p = {1, 2};\n    Point by = {10, 0};\n    Point moved = shift(&p, by, 1);\n    if (moved.x != 11 || p.x != 11 || moved.y != 2) return 1;\n    if (first(&p, 1) != 11) return 2;\n    if (first(NULL, 0) != -1) return 3;\n    return 0;\n}\n"
    expect_qbe_status("base exports", qbe_run_with_c_source(program, c_source), 0)

pub func test_atomic_extremes_loop_and_volatile_indexing_reach_qbe():
    let program = base_fixture_lowered("import atomic\n\nvar high: @i64 = 5\n\nstruct Regs:\n    var slots: u32[4]\n\npub func f(regs: volatile Regs*) -> i64:\n    regs.slots[1] = 3\n    atomic.fence(.release)\n    atomic.fence(.signal)\n    return high.max(1) + (i64)regs.slots[1]\n")
    let text = emit(program)
    assert(strings.contains(text, "call $luce_atomic_thread_fence(w 3)"))
    assert(strings.contains(text, "call $luce_atomic_signal_fence(w 5)"))
    assert(qbe_program_uses_fences(program))
    assert(strings.contains(qbe_fence_support_source(), "__atomic_thread_fence(order)"))
    assert(strings.contains(text, "csgtl"))
    assert(strings.contains(text, "__atomic_compare_exchange_8"))
    assert(strings.contains(text, "__atomic_load_4"))
    assert(strings.contains(text, "__atomic_store_4"))

## A Base package without `main` becomes a library, one relocatable object
## that a C program links against beside the generated header (`luce build
## --lib`, base.md §17.6, §19.6).
pub func test_qbe_links_a_c_program_against_a_base_library_when_available():
    let program = base_lowered("pub struct Point:\n    pub var x: i32\n    pub var y: i32\n\npub enum Access as u32:\n    read = 1\n    write = 2\n\nexport func shift(point: Point*, by: Point, flags: Access) -> Point:\n    point.x += by.x\n    return *point\n\nexport func first(points: const Point*?, count: usize) -> i32:\n    if let found = points: return found.x\n    return -1\n")
    if not has_qbe(): return
    let c_source = "#include <stddef.h>\n#include <stdint.h>\ntypedef struct { int32_t x; int32_t y; } Point;\nextern Point shift(Point *point, Point by, uint32_t flags);\nextern int32_t first(const Point *points, size_t count);\nint main(void) {\n    Point p = {1, 2};\n    Point by = {10, 0};\n    Point moved = shift(&p, by, 1);\n    if (moved.x != 11 || p.x != 11 || moved.y != 2) return 1;\n    if (first(&p, 1) != 11) return 2;\n    if (first(NULL, 0) != -1) return 3;\n    return 0;\n}\n"
    expect_qbe_status("c program linked against a base library", qbe_link_library_with_c_source(program, c_source), 0)

pub func test_qbe_merges_the_fence_shims_into_a_library():
    let program = base_fixture_lowered("import atomic\n\nvar high: @i64 = 5\n\nstruct Regs:\n    var slots: u32[4]\n\npub func f(regs: volatile Regs*) -> i64:\n    regs.slots[1] = 3\n    atomic.fence(.release)\n    atomic.fence(.signal)\n    return high.max(1) + (i64)regs.slots[1]\n")
    assert(qbe_program_uses_fences(program))
    if not has_qbe(): return
    let scratch = files.make_temporary_directory(".", ".luce-qbe-object-test-") catch reason:
        trap(reason)
    let object = paths.join(scratch, "fences.o")
    let made = QbeToolchain().materialize_library_with_report(program, object) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    assert(len(made.functions) > 0)
    let contents = files.read_bytes(object) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch cleanup_reason:
        trap(cleanup_reason)
    assert(len(contents) > 0)

## `str(text)` from a `cstr` scans to the NUL and validates (base.md §5.5);
## the C string comes from C, which the oracles cannot model.
pub func test_qbe_converts_c_text_to_str_when_available():
    let program = base_fixture_lowered("export c func answer(text: cstr) -> i64:\n    let converted = str(text) catch reason:\n        return -1\n    print(f\"{converted} {converted.length}\")\n    return (i64)converted.length\n")
    if not has_qbe(): return
    let driver = "#include <stdio.h>\n#include <stdint.h>\nint64_t answer(const char *text);\nint main(void) { printf(\"%lld %lld\\n\", (long long) answer(\"from c\"), (long long) answer(\"\\xff\\xfe\")); return 0; }\n"
    let result = qbe_run_with_c_source(program, driver)
    assert(result.status == 0)
    assert(result.output == "from c 6\n6 -1\n")

func has_qbe() -> bool:
    let probe = os.Process("command -v qbe >/dev/null 2>&1") catch reason:
        return false
    let status = probe.wait() catch reason:
        return false
    return status == 0

func qbe_accepts(name: str, text: str):
    if not has_qbe(): return
    let process = os.Process("qbe - >/dev/null") catch reason:
        trap(reason)
    process.feed(text) catch reason:
        trap(reason)
    process.finish_input() catch reason:
        trap(reason)
    let status = process.wait() catch reason:
        trap(reason)
    assert(status == 0)

struct RunResult:
    let status: i64
    let output: str

func quoted(value: str) -> str:
    return "'" + strings.replace(value, "'", "'\"'\"'") + "'"

func qbe_run(program: MirProgram) -> RunResult:
    return qbe_run_with_arguments(program, list[str]())

func qbe_run_with_c_source(program: MirProgram, c_source: str) -> RunResult:
    return qbe_run_with_c_source_arguments(program, c_source, list[str]())

func qbe_run_with_c_source_arguments(program: MirProgram, c_source: str, c_arguments: list[str]) -> RunResult:
    let scratch = files.make_temporary_directory(".", ".luce-qbe-c-test-") catch reason:
        trap(reason)
    let executable = paths.join(scratch, "program")
    let output_path = paths.join(scratch, "stdout")
    materialize_c_source_fixture(program, c_source, c_arguments, executable) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let process = os.Process("{ " + quoted(executable) + " > " + quoted(output_path) + " 2>/dev/null; } 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return RunResult(status = status, output = output)

## Build `program` as a library, link a C driver against it, and run the
## result; the driver never sees a `main` from the Luce side.
func qbe_link_library_with_c_source(program: MirProgram, c_source: str) -> RunResult:
    let scratch = files.make_temporary_directory(".", ".luce-qbe-object-test-") catch reason:
        trap(reason)
    let object = paths.join(scratch, "package.o")
    let driver = paths.join(scratch, "driver.c")
    let executable = paths.join(scratch, "program")
    let output_path = paths.join(scratch, "stdout")
    let materialized = QbeToolchain().materialize_library_with_report(program, object) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(len(materialized.functions) > 0)
    files.write(driver, c_source) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let compile = os.Process("cc -o " + quoted(executable) + " " + quoted(driver) + " " + quoted(object) + " 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let compile_status = compile.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    if compile_status != 0:
        files.remove_all(scratch) catch cleanup_reason:
            trap("the c driver did not link against the base library; cleanup failed: " + cleanup_reason)
        trap("the c driver did not link against the base library")
    let process = os.Process("{ " + quoted(executable) + " > " + quoted(output_path) + " 2>/dev/null; } 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return RunResult(status = status, output = output)

func qbe_run_with_arguments(program: MirProgram, arguments: list[str]) -> RunResult:
    let scratch = files.make_temporary_directory(".", ".luce-qbe-test-") catch reason:
        trap(reason)
    let executable = paths.join(scratch, "program")
    let output_path = paths.join(scratch, "stdout")
    if program.process_entry == none:
        materialize_c_fixture(program, executable) catch reason:
            files.remove_all(scratch) catch cleanup_reason:
                trap(reason + "; cleanup failed: " + cleanup_reason)
            trap(reason)
    else:
        QbeToolchain().materialize(program, executable) catch reason:
            files.remove_all(scratch) catch cleanup_reason:
                trap(reason + "; cleanup failed: " + cleanup_reason)
            trap(reason)
    var command = quoted(executable)
    for argument in arguments: command += " " + quoted(argument)
    let process = os.Process("{ " + command + " > " + quoted(output_path) + " 2>/dev/null; } 2>/dev/null") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let status = process.wait() catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let output = files.read(output_path) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.remove_all(scratch) catch reason:
        trap(reason)
    return RunResult(status = status, output = output)

func run_capturing_stderr(executable: str, diagnostic_path: str) -> RunResult!:
    let command = "{ " + quoted(executable) + " 2> " + quoted(diagnostic_path) + "; } 2>/dev/null"
    let process = try os.Process(command)
    let status = try process.wait()
    return RunResult(status = status, output = try files.read(diagnostic_path))

# Instruction-level fixtures deliberately carry an explicit exported C main
# rather than pretending to satisfy the language process-entry contract.
func materialize_c_fixture(program: MirProgram, executable: str) -> !:
    let directory = paths.dir(executable)
    let il_path = paths.join(directory, "fixture.ssa")
    let assembly_path = paths.join(directory, "fixture.s")
    try files.write(il_path, try QbeBackend().emit_il(program))
    let assemble = try os.Process("qbe -o " + quoted(assembly_path) + " " + quoted(il_path) + " 2>/dev/null")
    if try assemble.wait() != 0: error("QBE rejected the C-entry fixture")
    var support = ""
    if qbe_program_uses_fences(program):
        let support_path = paths.join(directory, "fence_support.c")
        try files.write(support_path, qbe_fence_support_source())
        support = " -x c " + quoted(support_path)
    let link = try os.Process("cc -o " + quoted(executable) + " -x assembler " + quoted(assembly_path) + support + " 2>/dev/null")
    if try link.wait() != 0: error("the host compiler rejected the C-entry fixture")

func materialize_c_source_fixture(program: MirProgram, c_source: str, c_arguments: list[str], executable: str) -> !:
    let directory = paths.dir(executable)
    let il_path = paths.join(directory, "fixture.ssa")
    let assembly_path = paths.join(directory, "fixture.s")
    let c_path = paths.join(directory, "fixture.c")
    let diagnostic_path = paths.join(directory, "fixture.stderr")
    try files.write(il_path, try QbeBackend().emit_il(program))
    var companion = c_source
    if qbe_program_uses_fences(program): companion = c_source + "\n" + qbe_fence_support_source()
    try files.write(c_path, companion)
    let assemble = try os.Process("qbe -o " + quoted(assembly_path) + " " + quoted(il_path) + " 2> " + quoted(diagnostic_path))
    if try assemble.wait() != 0: error("QBE rejected the C-source fixture: " + (try files.read(diagnostic_path)))
    var command = "cc -o " + quoted(executable) + " -x assembler " + quoted(assembly_path) + " -x c"
    for argument in c_arguments: command += " " + quoted(argument)
    command += " " + quoted(c_path) + " 2> " + quoted(diagnostic_path)
    let link = try os.Process(command)
    if try link.wait() != 0: error("the host compiler rejected the C-source fixture: " + (try files.read(diagnostic_path)))

func expect_qbe_status(name: str, result: RunResult, expected: i64):
    if result.status != expected:
        trap(name + " exited with " + str(result.status) + "; output: " + result.output)

func lower_unverified_source(source: str) -> MirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let hir = HirGenerator("org.luce.qbe-test", [SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax)]).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let mir = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    return mir

func lower_c_helpers_source(source: str) -> MirProgram:
    let standard_text = files.read("src/standard/c.luc") catch reason:
        trap(reason)
    let standard_tokens = Tokenizer(standard_text).tokenize() catch reason:
        trap(reason)
    let standard_syntax = Parser(standard_tokens).parse() catch reason:
        trap(reason)
    let source_tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let source_syntax = Parser(source_tokens).parse() catch reason:
        trap(reason)
    let hir = HirGenerator("org.luce.qbe-test", [
        SourceModule(name = "c", path = "c.luc", authority = ModuleAuthority.standard, syntax = standard_syntax),
        SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = source_syntax),
    ]).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let application = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    return compose_with_runtime(application)

func lower_generated_c_binding(raw_source: str, main_source: str) -> MirProgram:
    return lower_generated_c_modules(raw_source, none, main_source)

func lower_generated_safe_c_binding(raw_source: str, safe_source: str, main_source: str) -> MirProgram:
    return lower_generated_c_modules(raw_source, safe_source, main_source)

func lower_generated_c_modules(raw_source: str, safe_source: str?, main_source: str) -> MirProgram:
    let standard_text = files.read("src/standard/c.luc") catch reason:
        trap(reason)
    let standard_tokens = Tokenizer(standard_text).tokenize() catch reason:
        trap(reason)
    let standard_syntax = Parser(standard_tokens).parse() catch reason:
        trap(reason)
    let math_text = files.read("src/standard/math.luc") catch reason:
        trap(reason)
    let math_tokens = Tokenizer(math_text).tokenize() catch reason:
        trap(reason)
    let math_syntax = Parser(math_tokens).parse() catch reason:
        trap(reason)
    let raw_tokens = Tokenizer(raw_source).tokenize() catch reason:
        trap(reason)
    let raw_syntax = Parser(raw_tokens).parse() catch reason:
        trap(reason)
    let modules = [
        SourceModule(name = "c", path = "c.luc", authority = ModuleAuthority.standard, syntax = standard_syntax),
        SourceModule(name = "math", path = "math.luc", authority = ModuleAuthority.standard, syntax = math_syntax),
        SourceModule(name = "temperature.raw", path = "temperature/raw.lucn", authority = ModuleAuthority.native, syntax = raw_syntax),
    ]
    if safe_source != none:
        let safe_tokens = Tokenizer(safe_source).tokenize() catch reason:
            trap(reason)
        let safe_syntax = Parser(safe_tokens).parse() catch reason:
            trap(reason)
        modules.append(SourceModule(name = "temperature.safe", path = "temperature/safe.luc", authority = ModuleAuthority.safe, syntax = safe_syntax))
    let main_tokens = Tokenizer(main_source).tokenize() catch reason:
        trap(reason)
    let main_syntax = Parser(main_tokens).parse() catch reason:
        trap(reason)
    modules.append(SourceModule(name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = main_syntax))
    let hir = HirGenerator("org.luce.qbe-fiir-test", modules).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let application = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    return compose_with_runtime(application)

func lower_source(source: str) -> MirProgram:
    let application = lower_unverified_source(source)
    if application.process_entry == none:
        MirVerifier(application).verify() catch reason:
            trap(reason)
        return application
    return compose_with_runtime(application)

# Owned language values deliberately name semantic runtime services in MIR.
# Compose the real sealed runtime for source fixtures that exercise them; a
# backend test must not replace those services with test-only no-ops.
func lower_source_with_runtime(source: str) -> MirProgram:
    let application = lower_unverified_source(source)
    return compose_with_runtime(application)

func compose_with_runtime(application: MirProgram) -> MirProgram:
    let runtime = compile_runtime(sealed_runtime_package("src/runtime", ["src/runtime/allocator.lucn"])) catch reason:
        trap(reason)
    var program = compose_runtime(application, runtime.program) catch reason:
        trap(reason)
    MirVerifier(program).verify() catch reason:
        trap(reason)
    let optimized = Optimizer(program).optimize().program
    MirVerifier(optimized).verify() catch reason:
        trap(reason)
    return optimized

func lower_runtime_native_source(source: str) -> MirProgram:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let module = SourceModule(name = "runtime", path = "runtime.lucn", authority = ModuleAuthority.native, syntax = syntax)
    let hir = HirGenerator("org.luce.runtime-test", [module], PackageRole.sealed_runtime).generate() catch reason:
        trap(reason)
    let analyzed = SemanticAnalyzer(hir).analyze() catch reason:
        trap(reason)
    let mir = Lowerer(analyzed).lower() catch reason:
        trap(reason)
    MirVerifier(mir).verify() catch reason:
        trap(reason)
    return mir

# mark: QBE encoding ===========================================================================

pub func test_empty_qbe_module_is_empty():
    assert(emit(create_empty_mir_program()) == "")

pub func test_qbe_emits_a_complete_c_entry():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(c_main_function(ops, [i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.SignedInt(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    assert(emit(program) == "export function w $main() {\n@start\n\t%r0 =w copy 42\n\tret %r0\n}\n\n")

pub func test_qbe_reports_per_function_translation_cost_without_source_concepts():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "main.answer", [], [i32_t()], [i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.SignedInt(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    let emission = QbeBackend().emit_il_with_report(program) catch reason:
        trap(reason)
    assert(len(emission.functions) == 1)
    assert(emission.functions[0].function.value == 0)
    assert(emission.functions[0].code_bytes == u64(len(emission.text)))
    assert(emission.functions[0].codegen_time_ms == 0)

pub func test_qbe_materializes_full_u64_constants_as_exact_bits():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "main.maximum", [], [u64_t()], [u64_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.UnsignedInt(value = u64(18446744073709551615)))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "%r0 =l copy -1"))
    qbe_accepts("u64_maximum", text)

pub func test_qbe_emits_descriptor_backed_interface_dispatch():
    let source = files.read("examples/full/interfaces.luc") catch reason:
        trap(reason)
    let text = emit(lower_source_with_runtime(source))
    assert(strings.contains(text, "data $luce_wt0 = align 8 { l $luce_fd"))
    assert(strings.contains(text, "=l loadl %q"))
    assert(strings.contains(text, "call %q"))
    qbe_accepts("interface dispatch", text)

pub func test_qbe_flattens_region_results_without_a_second_ir():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    let yes = ops.run([r(1)])
    let no = ops.run([r(2)])
    let result = ops.run([r(3)])
    let returned = ops.run([r(3)])
    program.functions.append(function(ops, "main.choose", [bool_t()], [i64_t()], [bool_t(), i64_t(), i64_t(), i64_t()], [
        ins(InstructionForm.Const(result = r(1), value = MirConstant.SignedInt(value = 10))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.SignedInt(value = 20))),
        ins(InstructionForm.If(condition = r(0), results = result)),
        ins(InstructionForm.Yield(values = yes)),
        ins(InstructionForm.Else),
        ins(InstructionForm.Yield(values = no)),
        ins(InstructionForm.End),
        ins(InstructionForm.Return(values = returned)),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "jnz %r0, @if_yes0, @if_no1"))
    assert(strings.contains(text, "%r3 =l copy %r1"))
    assert(strings.contains(text, "%r3 =l copy %r2"))
    assert(strings.contains(text, "@if_end2\n\tret %r3"))
    qbe_accepts("regions", text)

pub func test_qbe_legalizes_checked_integer_arithmetic_to_a_trap_edge():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    program.functions.append(function(ops, "main.add", [i64_t(), i64_t()], [i64_t()], [i64_t(), i64_t(), i64_t()], [
        ins(InstructionForm.Binary(result = r(2), operation = BinaryOp.add, left = r(0), right = r(1))),
        ins(InstructionForm.Return(values = ops.run([r(2)]))),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "%r2 =l add %r0, %r1"))
    assert(strings.contains(text, "csltl"))
    assert(strings.contains(text, "hlt"))
    qbe_accepts("checked-add", text)

pub func test_qbe_reports_dynamic_source_traps_to_stderr_then_halts():
    let ops = OperandBuilder()
    let program = create_empty_mir_program()
    let runtime_trap = find_runtime_symbol("luce_rt_trap") else trap("no trap symbol")
    program.externs.append(MirExtern(name = "luce_rt_trap", convention = CallingConvention.runtime, signature = runtime_trap.signature))
    program.data.append(MirData(name = "reason", bytes = strings.to_bytes("broken"), align = 1))
    program.functions.append(function(ops, "main.fail", [], [i32_t()], [ptr_t(), u64_t()], [
        ins(InstructionForm.DataAddress(result = r(0), data = DataId(value = 0))),
        ins(InstructionForm.Const(result = r(1), value = MirConstant.UnsignedInt(value = u64(6)))),
        ins(InstructionForm.CallExtern(results = no_registers(), external = ExternId(value = 0), arguments = ops.run([r(0), r(1)]))),
        ins(InstructionForm.Unreachable),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "call $write(w 2, l %r0, l %r1)"))
    assert(strings.contains(text, "call $write(w 2, l $luce_rt_trap_newline, l 1)"))
    assert(strings.contains(text, "data $luce_rt_trap_newline = align 1 { b 10 }"))
    assert(strings.contains(text, "\thlt\n"))
    assert(not strings.contains(text, "call $luce_rt_trap("))
    qbe_accepts("source-trap", text)

pub func test_qbe_legalizes_typed_storage_at_its_layout_boundary():
    let ordinary = storage_program(2, false, true)
    let text = emit(ordinary)
    assert(strings.contains(text, "mul %r0, 4"))
    assert(strings.contains(text, "udiv"))
    assert(strings.contains(text, "call $luce_f0(l "))
    assert(strings.contains(text, ", l 8)"))
    assert(strings.contains(text, "@allocation_empty"))
    qbe_accepts("typed-storage", text)

    let zero_sized = emit(storage_program(1, true, false))
    assert(strings.contains(zero_sized, "call $luce_f0(l 1, l 8)"))
    if not has_qbe(): return
    assert(qbe_run(ordinary).status == 42)
    assert(qbe_run(storage_program(0, false, false)).status == 0)
    assert(qbe_run(storage_program(9223372036854775807, false, false)).status != 0)

pub func test_qbe_legalizes_binary16_values_and_two_byte_storage_at_its_boundary():
    let source = (
        "func half(value: f64) -> f16: return f16(value)\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let tenth: f16 = 0.1\n"
        + "    let fifth: f16 = 0.2\n"
        + "    let rounded: f16 = tenth + fifth\n"
        + "    if f32(tenth) != 0.0999755859375f32: return 1\n"
        + "    if f32(rounded) != 0.2998046875f32: return 2\n"
        + "    if f32(half(1.0004883110523224)) != 1.0009765625f32: return 3\n"
        + "    let values: array[f16, 3] = [1.0, 2.0, 39.0]\n"
        + "    return i32(values[0u64] + values[1u64] + values[2u64])\n"
    )
    let program = lower_source(source)
    let text = emit(program)
    assert(strings.contains(text, "call $luce.f16.to_bits"))
    assert(strings.contains(text, "call $luce.f16.from_bits"))
    assert(strings.contains(text, "storeh"))
    assert(strings.contains(text, "loaduh"))
    assert(strings.contains(text, "call $luce.f16.double_to_bits"))
    assert(strings.contains(text, "function w $luce.f16.double_to_bits"))
    assert(strings.contains(text, "function w $luce.f16.to_bits"))
    assert(strings.contains(text, "function s $luce.f16.from_bits"))
    qbe_accepts("binary16 legalization", text)
    if has_qbe():
        let result = qbe_run(program)
        if result.status != 42: trap("binary16 QBE product returned " + str(result.status))

pub func test_qbe_executes_internal_global_storage_when_available():
    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.data.append(MirData(name = "seed", bytes = [7, 0, 0, 0], align = 4))
    program.globals.append(MirGlobal(name = "runtime.cursor", value_type = i32_t(), initial = MirInitializer.Constant(value = MirConstant.SignedInt(value = 7), value_type = i32_t()), is_thread_local = false, is_mutable = true))
    program.functions.append(c_main_function(ops, [ptr_t(), i32_t(), i32_t(), i32_t(), i32_t()], [
        ins(InstructionForm.GlobalAddress(result = r(0), global = GlobalId(value = 0))),
        ins(InstructionForm.Load(result = r(1), value_type = i32_t(), address = r(0))),
        ins(InstructionForm.Const(result = r(2), value = MirConstant.SignedInt(value = 35))),
        ins(InstructionForm.Binary(result = r(3), operation = BinaryOp.add, left = r(1), right = r(2))),
        ins(InstructionForm.Store(value_type = i32_t(), address = r(0), value = r(3))),
        ins(InstructionForm.Load(result = r(4), value_type = i32_t(), address = r(0))),
        ins(InstructionForm.Return(values = ops.run([r(4)]))),
    ]))
    let text = emit(program)
    assert(strings.contains(text, "data $g0 = align 4 { w 7 }"))
    assert(strings.contains(text, "copy $g0"))
    if has_qbe(): assert(qbe_run(program).status == 42)

pub func test_qbe_supplies_the_sealed_stable_arena_without_a_mir_target_fact():
    let source = "export c func main() -> i32:\n    let first = native.arena(2u64)\n    let second = native.arena(64u64)\n    native.store(native.advance(first, 1u64), 42u8)\n    return 42 if native.load(native.advance(second, 1u64)) == 42u8 else 1\n"
    let program = lower_runtime_native_source(source)
    let text = emit(program)
    assert(strings.contains(text, "data $luce_rt_arena_storage = align 16 { z 67108864 }"))
    assert(strings.contains(text, "cugtl"))
    assert(strings.contains(text, "copy $luce_rt_arena_storage"))
    assert(not strings.contains(text, "call $luce_rt_arena"))
    qbe_accepts("sealed arena", text)
    if not has_qbe(): return
    assert(qbe_run(program).status == 42)

    let overflow = lower_runtime_native_source("export c func main() -> i32:\n    let base = native.arena(67108865u64)\n    return 0 if native.load(base) == 0u8 else 1\n")
    assert(qbe_run(overflow).status != 0)

pub func test_qbe_legalizes_typed_overlapping_moves_only_at_the_backend():
    let source = "export c func main() -> i32:\n    let base = native.arena(4u64)\n    native.store(base, 40u8)\n    native.store(native.advance(base, 1u64), 1u8)\n    native.store(native.advance(base, 2u64), 2u8)\n    native.store(native.advance(base, 3u64), 3u8)\n    native.move(native.advance(base, 1u64), base, 3u64)\n    return 42 if native.load(native.advance(base, 3u64)) == 2u8 else 1\n"
    let program = lower_runtime_native_source(source)
    let text = emit(program)
    assert(strings.contains(text, "call $memmove"))
    qbe_accepts("typed overlapping move", text)
    if has_qbe(): assert(qbe_run(program).status == 42)

pub func test_qbe_executes_the_compiled_freestanding_luce_allocator():
    let program = runtime_storage_program(1)
    let text = emit(program)
    assert(strings.contains(text, "$luce_rt_arena_storage"))
    let allocator = program.runtime_bindings[0].function
    assert(program.functions[allocator.value].name == "allocator.allocate_storage")
    qbe_accepts("compiled Luce allocator", text)
    if not has_qbe(): return
    # Distinct aligned allocations retain both stores; aliasing would return 4.
    assert(qbe_run(program).status == 42)

    # 16,777,217 i32 values exceed the QBE provider's 64 MiB arena after
    # checked byte legalization and the allocator's byte-zero reservation.
    assert(qbe_run(runtime_storage_program(16777217)).status != 0)

    let reused = runtime_reuse_program()
    assert(reused.runtime_bindings[1].service == RuntimeService.storage_deallocator)
    assert(reused.functions[reused.runtime_bindings[1].function.value].name == "allocator.deallocate_storage")
    assert(qbe_run(reused).status == 42)

pub func test_qbe_executes_the_dynamic_class_graph_observed_by_resource_census():
    let source = (
        "class Node:\n    var next: Node?\n    func init(self): self.next = none\n    func link(self, other: Node): self.next = other\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n    let first = new Node()\n    let second = new Node()\n    first.link(second)\n    second.link(first)\n    return 42\n"
    )
    let program = lower_source_with_runtime(source)
    qbe_accepts("dynamic class ownership graph", emit(program))
    if has_qbe(): assert(qbe_run(program).status == 42)

pub func test_qbe_executes_width_specific_shortest_float_display():
    if not has_qbe(): return
    let source = "pub func main(arguments: slice[str]) -> i32!:\n    let tenth32: f32 = 0.1\n    let maximum32: f32 = 3.4028234663852886e38\n    let minimum32: f32 = 1e-45\n    let zero = 0.0\n    let infinity = 1.0 / zero\n    let not_a_number = zero / zero\n    print(f\"{0.1}|{1.0}|{-0.0}|{0.00001}|{0.000001}|{1e15}|{1e16}|{1.7976931348623157e308}|{5e-324}|{infinity}|{-infinity}|{not_a_number}|{tenth32}|{maximum32}|{minimum32}\")\n    return 0i32\n"
    let result = qbe_run(lower_source_with_runtime(source))
    assert(result.status == 0)
    let expected = "0.1|1.0|-0.0|0.00001|1e-6|1000000000000000.0|1e16|1.7976931348623157e308|5e-324|inf|-inf|nan|0.1|3.4028235e38|1e-45\n"
    if result.output != expected: trap("shortest float display produced `" + result.output + "`")

pub func test_qbe_executes_static_generic_and_dynamic_display_dispatch():
    if not has_qbe(): return
    let source = "struct Label implements Display:\n    let value: str\n    pub func display(self) -> str: return f\"<{self.value}>\"\nfunc generic[T: Display](value: T) -> str: return f\"G:{value}\"\nfunc dynamic(value: Display) -> str: return f\"D:{value}\"\npub func main(arguments: slice[str]) -> i32!:\n    let label = Label(\"luce\")\n    print(f\"{label}|{generic(label)}|{dynamic(label)}\")\n    return 0i32\n"
    let result = qbe_run(lower_source_with_runtime(source))
    if result.status != 0: trap("Display dispatch exited with " + str(result.status))
    if result.output != "<luce>|G:<luce>|D:<luce>\n": trap("Display dispatch produced `" + result.output + "`")

pub func test_qbe_formats_signed_and_unsigned_integer_extrema():
    if not has_qbe(): return
    let source = "pub func main(arguments: slice[str]) -> i32!:\n    print(f\"{-1}|{-9223372036854775807 - 1}|{18446744073709551615u64}\")\n    return 0i32\n"
    let result = qbe_run(lower_source_with_runtime(source))
    if result.status != 0: trap("integer display exited with " + str(result.status))
    let expected = "-1|-9223372036854775808|18446744073709551615\n"
    if result.output != expected: trap("integer display produced `" + result.output + "`")

pub func test_qbe_runtime_services_do_not_capture_c_symbols_with_the_same_spelling():
    let source = "extern func luce_rt_arena(end: u64) -> u64\nextern func luce_rt_write(value: i32) -> i32\npub func probe() -> u64: return luce_rt_arena(1u64)\npub func invoke() -> i32: return luce_rt_write(1i32)\n"
    let text = emit(lower_source(source))
    assert(not strings.contains(text, "$luce_rt_arena_storage"))
    assert(strings.contains(text, "call $luce_rt_arena"))
    assert(strings.contains(text, "call $luce_rt_write"))
    assert(not strings.contains(text, "call $write"))

pub func test_qbe_labels_unreachable_structural_tail_before_its_terminator():
