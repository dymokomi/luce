pub func test_qbe_links_c_imports_and_preserves_exported_symbols():
    if not has_qbe(): return
    let source_text = "extern func abs(value: i32) -> i32\nexport c func luce_twice(value: i32) -> i32: return value * 2\npub func main(arguments: slice[str]) -> i32!: return luce_twice(abs(-21i32))\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "export function w $luce_twice(w %r0)"))
    assert(strings.contains(il, "call $abs(w"))
    assert(qbe_run(program).status == 42)

    let narrow = emit(lower_source("export c func luce_byte(value: u8) -> u8: return value\n"))
    assert(strings.contains(narrow, "export function ub $luce_byte(ub %r0)"))
    qbe_accepts("c ABI extension types", narrow)

    # `Pid` remains nominal in HIR but reaches QBE as its declared i32 C
    # representation. Real libc supplies the symbol, making this an ABI and
    # linker proof rather than only an IL spelling assertion.
    let handle_source = "extern type Pid = i32\nextern func getpid() -> Pid\npub func main(arguments: slice[str]) -> i32!:\n    let pid = getpid()\n    return 0 if pid == pid else 1\n"
    let handle_program = lower_source(handle_source)
    assert(strings.contains(emit(handle_program), "call $getpid()"))
    assert(qbe_run(handle_program).status == 0)

    let exported_handle = emit(lower_source("pub extern type Handle = u64\nexport c func echo_handle(value: Handle) -> Handle: return value\n"))
    assert(strings.contains(exported_handle, "export function l $echo_handle(l %r0)"))
    qbe_accepts("integer extern handle ABI", exported_handle)

pub func test_qbe_uses_fixed_c_enum_values_only_at_explicit_boundaries():
    let source_text = "export c enum Status as i32:\n    running = -2\n    complete = 42\nextern func abs(value: Status) -> i32\nextern func tolower(value: i32) -> Status\nfunc identity(value: Status) -> Status: return value\nfunc callback_ok() -> bool:\n    let apply: cfunc(Status) -> Status = identity\n    match apply(.complete):\n        .running: return false\n        .complete: return true\nexport c func echo_status(value: Status) -> Status: return value\npub func main(arguments: slice[str]) -> i32!:\n    if not callback_ok(): return 2i32\n    match tolower(42i32):\n        .running: return 1i32\n        .complete: return abs(.running) + 40i32\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "export function w $echo_status(w %r0)"))
    assert(strings.contains(il, "call $abs(w"))
    assert(strings.contains(il, "call $tolower(w"))
    qbe_accepts("fixed C enum adapters", il)
    if has_qbe(): assert(qbe_run(program).status == 42)

pub func test_qbe_executes_nested_exported_c_structs_by_value_when_available():
    let source_text = files.read("examples/full/c_api.luc") catch reason:
        trap(reason)
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "type :luce_t"))
    assert(strings.contains(il, "export function :luce_t"))
    assert(strings.contains(il, "call $c_adjust(:luce_t"))
    qbe_accepts("nested exported C structs", il)
    if not has_qbe(): return

    # The record crosses four independently checked edges: C -> exported Luce,
    # semantic Luce -> extern C, C -> semantic Luce, and exported Luce -> C.
    # Its enum field also proves that the structural ABI shape contains the
    # fixed C value rather than the enum's internal semantic representation.
    let c_source = "#include <stdint.h>\n#include <math.h>\ntypedef struct { int32_t left; int32_t right; } Pair;\ntypedef struct { Pair pair; int32_t status; double weight; } Envelope;\nextern Envelope luce_adjust(Envelope value);\nEnvelope c_adjust(Envelope value) {\n    value.pair.left += 1;\n    value.pair.right -= 2;\n    value.status = 42;\n    value.weight *= 2.0;\n    return value;\n}\nint main(void) {\n    Envelope input = {{40, 44}, -2, 1.5};\n    Envelope output = luce_adjust(input);\n    return output.pair.left == 41 && output.pair.right == 42 &&\n           output.status == 42 && fabs(output.weight - 3.0) < 0.0001 ? 0 : 1;\n}\n"
    expect_qbe_status("nested exported C structs", qbe_run_with_c_source(program, c_source), 0)

    # This aggregate is reachable only from an indirect callback signature;
    # no named C definition or extern independently causes its declaration.
    let callback_only = emit(lower_source("export c struct Pair:\n    let left: i32\n    let right: i32\nextern func acquire() -> cfunc(Pair) -> i32\npub func answer() -> i32: return acquire()(Pair(left = 20i32, right = 22i32))\n"))
    assert(strings.contains(callback_only, "type :luce_t"))
    qbe_accepts("callback-only C aggregate", callback_only)

pub func test_qbe_executes_borrowed_c_strings_and_copies_results_when_available():
    if not has_qbe(): return
    # libc returns a pointer into the temporary input allocation. Successful
    # execution therefore proves NUL termination, UTF-8 copying, and that
    # result decoding precedes call-scoped input cleanup.
    let source_text = "extern func strchr(value: str, character: i32) -> str\npub func main(arguments: slice[str]) -> i32!:\n    let suffix = strchr(\"alpha\", 112i32)\n    return 42 if suffix == \"pha\" else 1\n"
    let program = lower_source_with_runtime(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $strchr(l"))
    let copy = find_runtime_binding(program, RuntimeService.c_string_copy) else trap("missing C string runtime binding")
    assert(strings.contains(il, "call $luce_f" + str(copy.value) + "(l"))
    assert(qbe_run(program).status == 42)

    let null_source = "extern func strchr(value: str, character: i32) -> str\npub func main(arguments: slice[str]) -> i32!:\n    discard(strchr(\"alpha\", 122i32))\n    return 0\n"
    assert(qbe_run(lower_source_with_runtime(null_source)).status != 0)

pub func test_qbe_copies_and_disposes_c_owned_memory_through_standard_helpers():
    if not has_qbe(): return
    let source = "import c\nextern func data() -> foreign\nextern func owned() -> foreign\nextern func release(value: foreign)\nexport c func verify() -> i32:\n    let raw = c.bytes_at(data(), 2u64)\n    let borrowed = c.cstring_at(data())\n    let taken = c.take_str(owned(), release)\n    return 42 if raw.length == 2u64 and raw[0u64] == 65u8 and raw[1u64] == 66u8 and borrowed == \"AB\" and taken == \"ok\" else 1\n"
    let program = lower_c_helpers_source(source)
    let builder_append = find_runtime_binding(program, RuntimeService.buffer_builder_append) else trap("missing buffer-builder append service")
    let il = emit(program)
    assert(strings.contains(il, "call $luce_f" + str(builder_append.value) + "(l"))
    let c_source = "#include <stdint.h>\nstatic unsigned char borrowed[] = {65, 66, 0};\nstatic unsigned char allocated[] = {111, 107, 0};\nstatic int disposals = 0;\nvoid *data(void) { return borrowed; }\nvoid *owned(void) { return allocated; }\nvoid release(void *value) { if (value == allocated) disposals += 1; }\nextern int32_t verify(void);\nint main(void) { return verify() == 42 && disposals == 1 ? 0 : 1; }\n"
    expect_qbe_status("inbound C memory helpers", qbe_run_with_c_source(program, c_source), 0)

pub func test_qbe_exposes_dense_borrowed_lists_to_real_libc_when_available():
    if not has_qbe(): return
    # `memcmp` observes all three elements through the pointer Luce lends it.
    # No C shim or packing path stands between the list runtime and libc.
    let source_text = "extern func memcmp(left: list[u8], right: list[u8], count: u64) -> i32\npub func main(arguments: slice[str]) -> i32!:\n    let left: list[u8] = [1u8, 2u8, 3u8]\n    let equal: list[u8] = [1u8, 2u8, 3u8]\n    let greater: list[u8] = [1u8, 2u8, 4u8]\n    return 42 if memcmp(left, equal, 3u64) == 0i32 and memcmp(left, greater, 3u64) < 0i32 else 1\n"
    let program = lower_source_with_runtime(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $memcmp(l"))
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_cfunc_adapters_and_extern_addresses_when_available():
    if not has_qbe(): return
    let local_source = "func negate(value: i32) -> i32: return -value\npub func main(arguments: slice[str]) -> i32!:\n    let callback: cfunc(i32) -> i32 = negate\n    return callback(-42i32)\n"
    let local = lower_source(local_source)
    let local_il = emit(local)
    assert(strings.contains(local_il, "function w $.luce_cfunc_"))
    assert(strings.contains(local_il, "call %r"))
    assert(qbe_run(local).status == 42)

    let extern_source = "extern func abs(value: i32) -> i32\npub func main(arguments: slice[str]) -> i32!:\n    let callback: cfunc(i32) -> i32 = abs\n    return callback(-42i32)\n"
    let external = lower_source(extern_source)
    let external_il = emit(external)
    assert(strings.contains(external_il, "copy extern $abs"))
    assert(strings.contains(external_il, "call %r"))
    assert(qbe_run(external).status == 42)

    # libc invokes the generated adapter after `main` returns, proving the
    # pointer passed out of Luce obeys the real host C calling convention.
    let callback_source = "extern func atexit(callback: cfunc() -> unit) -> i32\nfunc goodbye(): print(\"callback\")\npub func main(arguments: slice[str]) -> i32!:\n    let callback: cfunc() -> unit = goodbye\n    return atexit(callback)\n"
    let callback = qbe_run(lower_source(callback_source))
    assert(callback.status == 0)
    assert(callback.output == "callback\n")

    # Two real libc calls make a Luce adapter arrive back as an opaque C
    # function pointer: the second `signal` returns the handler installed by
    # the first. Calling that result proves it was not replaced by a symbolic
    # extern shortcut in either HIR or MIR.
    let returned_source = "type SignalHandler = cfunc(i32) -> unit\nextern func signal(number: i32, handler: SignalHandler?) -> SignalHandler?\nfunc receive(number: i32):\n    if number != 42i32: trap(\"wrong signal value\")\npub func main(arguments: slice[str]) -> i32!:\n    let handler: SignalHandler = receive\n    let initial = signal(1i32, handler)\n    let previous = signal(1i32, handler)\n    discard(signal(1i32, initial))\n    if let returned = previous:\n        returned(42i32)\n        return 0\n    return 2\n"
    let returned = lower_source_with_runtime(returned_source)
    let returned_il = emit(returned)
    assert(strings.contains(returned_il, "call $signal(w"))
    assert(strings.contains(returned_il, "call %r"))
    assert(qbe_run(returned).status == 0)

pub func test_qbe_links_and_mutates_real_c_globals_when_available():
    if not has_qbe(): return
    # `optind` is mutable process state owned by libc. Its dynamic-library
    # definition requires QBE's explicit GOT/PIC `extern $symbol` address,
    # proving the product toolchain can bind more than same-link objects.
    let source_text = "extern var optind: i32\npub func main(arguments: slice[str]) -> i32!:\n    optind = 40i32\n    optind += 2i32\n    return optind\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "storew"))
    assert(strings.contains(il, "extern $optind"))
    assert(strings.contains(il, "loadw extern $optind"))
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_pointer_handle_boundaries_when_available():
    if not has_qbe(): return
    let live = "extern type Allocation\nextern func malloc(size: u64) -> Allocation?\nextern func free(value: Allocation)\npub func main(arguments: slice[str]) -> i32!:\n    match malloc(16u64):\n        .some(memory):\n            free(memory)\n            return 0\n        .none: return 1\n"
    let live_program = lower_source(live)
    let live_il = emit(live_program)
    assert(strings.contains(live_il, "call $malloc(l"))
    assert(strings.contains(live_il, "call $free(l"))
    assert(qbe_run(live_program).status == 0)

    # This request exceeds PTRDIFF_MAX on the supported 64-bit oracle hosts,
    # so libc must report allocation failure with null.
    let nullable = "extern type Allocation\nextern func malloc(size: u64) -> Allocation?\nextern func free(value: Allocation)\npub func main(arguments: slice[str]) -> i32!:\n    match malloc(9223372036854775807u64):\n        .some(memory):\n            free(memory)\n            return 1\n        .none: return 0\n"
    assert(qbe_run(lower_source(nullable)).status == 0)

    let bare = "extern type Allocation\nextern func malloc(size: u64) -> Allocation\npub func main(arguments: slice[str]) -> i32!:\n    malloc(9223372036854775807u64)\n    return 0\n"
    assert(qbe_run(lower_source(bare)).status != 0)

    let exported = emit(lower_source("pub extern type Allocation\nexport c func echo_allocation(value: Allocation?) -> Allocation?: return value\n"))
    assert(strings.contains(exported, "export function l $echo_allocation(l %r0)"))
    qbe_accepts("pointer handle export adapter", exported)

pub func test_qbe_executes_foreign_data_pointers_through_real_libc_when_available():
    if not has_qbe(): return
    # POSIX `struct iovec` is one data pointer followed by `size_t` on every
    # supported 64-bit QBE oracle host. A zero-length vector never dereferences
    # its base, but still proves nullable allocation, narrowing, a bare
    # `foreign` input, and fieldwise extern-struct packing against real libc.
    let source_text = "extern struct NativeBuffer:\n    base: foreign\n    length: u64\nextern func malloc(size: u64) -> foreign?\nextern func free(value: foreign)\nextern func writev(fd: i32, value: NativeBuffer, count: i32) -> i64\npub func main(arguments: slice[str]) -> i32!:\n    match malloc(1u64):\n        .some(memory):\n            let written = writev(1i32, NativeBuffer(memory, 0u64), 1i32)\n            free(memory)\n            return 0 if written == 0 else 2\n        .none: return 1\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $malloc(l"))
    assert(strings.contains(il, "call $writev(w"))
    assert(strings.contains(il, "call $free(l"))
    assert(qbe_run(program).status == 0)

pub func test_qbe_executes_real_c_output_parameters_when_available():
    if not has_qbe(): return
    # `posix_memalign` puts the allocated pointer through its first C
    # argument. Luce callers pass only the two inputs and receive the declared
    # status followed by the nullable output in an ordinary tuple.
    let source_text = "extern type Allocation\nextern func posix_memalign(out memory: Allocation?, alignment: u64, size: u64) -> i32\nextern func free(memory: Allocation)\npub func main(arguments: slice[str]) -> i32!:\n    let (status, memory) = posix_memalign(16u64, 16u64)\n    if status != 0: return 1\n    match memory:\n        .some(value):\n            free(value)\n            return 0\n        .none: return 2\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $posix_memalign(l"))
    assert(strings.contains(il, "call $free(l"))
    assert(qbe_run(program).status == 0)

pub func test_qbe_executes_real_c_extern_struct_output_when_available():
    if not has_qbe(): return
    # POSIX `struct timespec` is two naturally aligned signed 64-bit fields on
    # every 64-bit QBE oracle host. The C function writes through its pointer;
    # Luce receives a fresh ordinary value struct after fieldwise unpacking.
    let source_text = "extern struct Timespec:\n    seconds: i64\n    nanoseconds: i64\n    func is_after_epoch(self) -> bool: return self.seconds > 0\nextern func clock_gettime(clock: i32, out value: Timespec) -> i32\npub func main(arguments: slice[str]) -> i32!:\n    let (status, value) = clock_gettime(0i32)\n    if status != 0: return 1\n    return 0 if value.is_after_epoch() else 2\n"
    let program = lower_source(source_text)
    let il = emit(program)
    assert(strings.contains(il, "call $clock_gettime(w"))
    assert(qbe_run(program).status == 0)

pub func test_qbe_executes_a_clang_generated_fiir_binding_against_real_c():
    if not has_qbe(): return
    let module = ClangFiirToolchain().inspect(
        "examples/full/c_import/temperature.h",
        ["-std=c11", "-Wall", "-Wextra", "-Werror"],
        ".",
        temperature_macro_constants(),
    ) catch reason:
        trap(reason)
    let recipe_document = files.read("examples/full/c_import/temperature.recipe.toml") catch reason:
        trap(reason)
    let recipe = parse_binding_recipe(recipe_document, "examples/full/c_import/temperature.recipe.toml", "temperature") catch reason:
        trap(reason)
    let binding = attach_binding_recipe(module, recipe) catch reason:
        trap(reason)
    let products = render_binding_products(binding, "temperature") catch reason:
        trap(reason)
    let main_source = (
        "import c\n"
        + "import temperature.raw as temperature\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let freezing = temperature.luce_celsius_to_fahrenheit(c.double(0.0))\n"
        + "    let halved = temperature.luce_half_celsius(c.float(42.0f32))\n"
        + "    let adjusted_half = temperature.luce_adjust_half(temperature.luce_half_value(1.0f16), temperature.luce_half_value(0.5f16))\n"
        + "    let adjusted = temperature.luce_adjust_celsius(c.int(40), c.int(2))\n"
        + "    let degrees = temperature.luce_echo_degrees(temperature.luce_degrees(42))\n"
        + "    let scale = temperature.luce_echo_scale(temperature.LUCE_SCALE_CELSIUS)\n"
        + "    let (scale_negative, scale_magnitude) = scale.portable()\n"
        + "    let (boiling_negative, boiling_magnitude) = temperature.LUCE_WATER_BOILING_CELSIUS.portable()\n"
        + "    let (default_scale_negative, default_scale_magnitude) = temperature.LUCE_TEMPERATURE_DEFAULT_SCALE.portable()\n"
        + "    let (open_scale_negative, open_scale_magnitude) = temperature.LUCE_TEMPERATURE_OPEN_SCALE.portable()\n"
        + "    let (minimum_negative, minimum_magnitude) = temperature.LUCE_TEMPERATURE_SIGNED_MINIMUM.portable()\n"
        + "    let (maximum_negative, maximum_magnitude) = temperature.LUCE_TEMPERATURE_UNSIGNED_MAXIMUM.portable()\n"
        + "    let (zero_negative, zero_magnitude) = temperature.LUCE_TEMPERATURE_ABSOLUTE_ZERO.portable()\n"
        + "    let (limit_negative, limit_magnitude) = temperature.LUCE_TEMPERATURE_SENSOR_LIMIT.portable()\n"
        + "    let constant_enabled = temperature.LUCE_TEMPERATURE_DEFAULT_ENABLED.portable()\n"
        + "    let constant_half = temperature.LUCE_TEMPERATURE_HALF_STEP.portable()\n"
        + "    let constant_zero = temperature.LUCE_TEMPERATURE_NEGATIVE_ZERO.portable()\n"
        + "    let constant_ratio = temperature.LUCE_TEMPERATURE_REFERENCE_RATIO.portable()\n"
        + "    let constant_infinity = temperature.LUCE_TEMPERATURE_POSITIVE_INFINITY.portable()\n"
        + "    let constant_undefined = temperature.LUCE_TEMPERATURE_UNDEFINED.portable()\n"
        + "    let macro_enabled = temperature.LUCE_TEMPERATURE_MACRO_ENABLED.portable()\n"
        + "    let macro_half = temperature.LUCE_TEMPERATURE_MACRO_HALF_STEP.portable()\n"
        + "    let macro_zero = temperature.LUCE_TEMPERATURE_MACRO_NEGATIVE_ZERO.portable()\n"
        + "    let macro_ratio = temperature.LUCE_TEMPERATURE_MACRO_REFERENCE_RATIO.portable()\n"
        + "    let macro_infinity = temperature.LUCE_TEMPERATURE_MACRO_POSITIVE_INFINITY.portable()\n"
        + "    let macro_undefined = temperature.LUCE_TEMPERATURE_MACRO_UNDEFINED.portable()\n"
        + "    let (macro_scale_negative, macro_scale_magnitude) = temperature.LUCE_TEMPERATURE_MACRO_OPEN_SCALE.portable()\n"
        + "    temperature.write_luce_temperature_offset(temperature.luce_degrees(42))\n"
        + "    temperature.write_luce_temperature_enabled(c.boolean(true))\n"
        + "    temperature.write_luce_temperature_ratio(c.double(1.5))\n"
        + "    temperature.write_luce_temperature_unit(temperature.LUCE_SCALE_FAHRENHEIT)\n"
        + "    let object_offset = temperature.read_luce_temperature_offset().portable()\n"
        + "    let object_capacity = temperature.read_luce_temperature_sensor_capacity().portable()\n"
        + "    let object_enabled = temperature.read_luce_temperature_enabled().portable()\n"
        + "    let object_ratio = temperature.read_luce_temperature_ratio().portable()\n"
        + "    let (object_unit_negative, object_unit_magnitude) = temperature.read_luce_temperature_unit().portable()\n"
        + "    let is_freezing = temperature.luce_is_freezing(c.boolean(true), c.double(0.0))\n"
        + "    let bounds = temperature.luce_temperature_range(c.double(-10.0), c.double(10.0))\n"
        + "    let shifted_range = temperature.luce_shift_range(bounds, c.double(5.0))\n"
        + "    let reading = temperature.luce_temperature_reading(bounds, temperature.luce_degrees(0), temperature.LUCE_SCALE_CELSIUS, temperature.luce_half_value(0.5f16))\n"
        + "    let shifted_reading = temperature.luce_shift_reading(reading, temperature.luce_degrees(5))\n"
        + "    let sensor = temperature.luce_temperature_sensor_open(temperature.luce_degrees(42))\n"
        + "    let sensor_value = temperature.luce_temperature_sensor_value(sensor).portable()\n"
        + "    let absent_sensor = temperature.luce_temperature_sensor_find(temperature.luce_degrees(-1))\n"
        + "    let found_sensor_value = match temperature.luce_temperature_sensor_find(temperature.luce_degrees(7)):\n"
        + "        .some(found) => temperature.luce_temperature_sensor_value(found).portable()\n"
        + "        .none => -1\n"
        + "    let handles_match = sensor_value == 42 and absent_sensor == none and found_sensor_value == 7 and temperature.luce_temperature_sensor_echo(sensor) != none\n"
        + "    return 0 if freezing.portable() == 32.0 and halved.portable() == 21.0f32 and adjusted_half.portable() == 1.5f16 and adjusted.portable() == 42 and degrees.portable() == 42 and scale_negative and scale_magnitude == 2u64 and not boiling_negative and boiling_magnitude == 100u64 and default_scale_negative and default_scale_magnitude == 2u64 and not open_scale_negative and open_scale_magnitude == 7u64 and minimum_negative and minimum_magnitude == 9223372036854775808u64 and not maximum_negative and maximum_magnitude == 18446744073709551615u64 and zero_negative and zero_magnitude == 273u64 and not limit_negative and limit_magnitude == 4095u64 and constant_enabled and constant_half == 0.5f16 and 1.0f32 / constant_zero < 0.0f32 and constant_ratio == 1.5 and constant_infinity > 1.7976931348623157e308 and constant_undefined != constant_undefined and macro_enabled and macro_half == 0.25f16 and 1.0f32 / macro_zero < 0.0f32 and macro_ratio == 1.25 and macro_infinity > 1.7976931348623157e308 and macro_undefined != macro_undefined and not macro_scale_negative and macro_scale_magnitude == 7u64 and object_offset == 42 and object_capacity == 4095u64 and object_enabled and object_ratio == 1.5 and not object_unit_negative and object_unit_magnitude == 42u64 and is_freezing.portable() and shifted_range.minimum.portable() == -5.0 and shifted_range.maximum.portable() == 15.0 and shifted_reading.range.minimum.portable() == -5.0 and shifted_reading.range.maximum.portable() == 15.0 and shifted_reading.current.portable() == 5 and shifted_reading.scale == temperature.LUCE_SCALE_CELSIUS and shifted_reading.fraction.portable() == 1.0f16 and handles_match else 1\n"
    )
    let program = lower_generated_c_binding(products.raw_module, main_source)
    let implementation = files.read("examples/full/c_import/temperature.c") catch reason:
        trap(reason)
    let scratch = files.make_temporary_directory(".", ".luce-fiir-qbe-test-") catch reason:
        trap(reason)
    let adapter_path = paths.join(scratch, "temperature.adapter.c")
    let implementation_path = paths.join(scratch, "temperature.c")
    let executable = paths.join(scratch, "temperature")
    files.write(adapter_path, products.c_adapter) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    files.write(implementation_path, implementation) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    QbeToolchain().materialize(
        program,
        executable,
        [adapter_path, implementation_path],
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-I", ".", "-I", "examples/full/c_import"],
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let diagnostic = paths.join(scratch, "temperature.stderr")
    let result = run_capturing_stderr(executable, diagnostic) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(result.status == 0)

    let safe_source = products.safe_module else trap("recipe binding did not generate a safe module")
    let safe_main = (
        "import temperature.raw as raw\n"
        + "import temperature.safe as safe\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    let sensor = safe.luce_temperature_sensor_open(raw.luce_degrees(42))\n"
        + "    let borrowed = sensor.borrow()\n"
        + "    try safe.luce_temperature_sensor_validate(borrowed)\n"
        + "    let value = safe.luce_temperature_sensor_value(borrowed).portable()\n"
        + "    let echoed_value = match safe.luce_temperature_sensor_echo(borrowed):\n"
        + "        .some(echoed) => safe.luce_temperature_sensor_value(echoed).portable()\n"
        + "        .none => -1\n"
        + "    if safe.luce_temperature_sensor_present(none).portable(): return 2\n"
        + "    match safe.luce_temperature_sensor_find(raw.luce_degrees(-1)):\n"
        + "        .some(found):\n"
        + "            found.close()\n"
        + "            return 3\n"
        + "        .none: discard(arguments)\n"
        + "    sensor.close()\n"
        + "    sensor.close()\n"
        + "    if value != 42 or echoed_value != 42: return 4\n"
        + "    let invalid = safe.luce_temperature_sensor_open(raw.luce_degrees(-1))\n"
        + "    safe.luce_temperature_sensor_validate(invalid.borrow()) catch failure:\n"
        + "        invalid.close()\n"
        + "        return 0\n"
        + "    return 5\n"
    )
    let safe_program = lower_generated_safe_c_binding(products.raw_module, safe_source, safe_main)
    let safe_il = emit(safe_program)
    assert(strings.contains(safe_il, "call $luce_fiir_temperature_luce_temperature_sensor_close("))
    assert(strings.contains(safe_il, "call $luce_fiir_temperature_luce_temperature_sensor_validate("))
    let safe_executable = paths.join(scratch, "temperature-safe")
    QbeToolchain().materialize(
        safe_program,
        safe_executable,
        [adapter_path, implementation_path],
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-I", ".", "-I", "examples/full/c_import"],
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let safe_diagnostic = paths.join(scratch, "temperature-safe.stderr")
    let safe_result = run_capturing_stderr(safe_executable, safe_diagnostic) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(safe_result.status == 0)

    let shortened_module = ClangFiirToolchain().inspect(
        "examples/full/c_import/temperature.h",
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-fshort-enums"],
        ".",
        temperature_macro_constants(),
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let shortened_products = render_binding_products(shortened_module, "temperature") catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(strings.replace(shortened_products.raw_module, " -fshort-enums", "") == products.raw_module)
    assert(shortened_products.c_adapter != products.c_adapter)
    let shortened_program = lower_generated_c_binding(shortened_products.raw_module, main_source)
    let shortened_adapter_path = paths.join(scratch, "temperature-short-enums.adapter.c")
    files.write(shortened_adapter_path, shortened_products.c_adapter) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let shortened_executable = paths.join(scratch, "temperature-short-enums")
    QbeToolchain().materialize(
        shortened_program,
        shortened_executable,
        [shortened_adapter_path, implementation_path],
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-fshort-enums", "-I", ".", "-I", "examples/full/c_import"],
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let shortened_diagnostic = paths.join(scratch, "temperature-short-enums.stderr")
    let shortened_result = run_capturing_stderr(shortened_executable, shortened_diagnostic) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(shortened_result.status == 0)

    let invalid_object_enum_implementation = strings.replace(
        implementation,
        "luce_temperature_scale luce_temperature_unit = LUCE_SCALE_CELSIUS;",
        "luce_temperature_scale luce_temperature_unit = (luce_temperature_scale)7;",
    )
    let invalid_object_enum_implementation_path = paths.join(scratch, "temperature-invalid-object-enum.c")
    files.write(invalid_object_enum_implementation_path, invalid_object_enum_implementation) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let invalid_object_enum_source = (
        "import temperature.raw as temperature\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    discard(temperature.read_luce_temperature_unit())\n"
        + "    return 0\n"
    )
    let invalid_object_enum_program = lower_generated_c_binding(products.raw_module, invalid_object_enum_source)
    let invalid_object_enum_executable = paths.join(scratch, "temperature-invalid-object-enum")
    QbeToolchain().materialize(
        invalid_object_enum_program,
        invalid_object_enum_executable,
        [adapter_path, invalid_object_enum_implementation_path],
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-I", ".", "-I", "examples/full/c_import"],
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let invalid_object_enum_diagnostic = paths.join(scratch, "temperature-invalid-object-enum.stderr")
    let invalid_object_enum_result = run_capturing_stderr(invalid_object_enum_executable, invalid_object_enum_diagnostic) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(invalid_object_enum_result.status != 0)
    assert(strings.contains(invalid_object_enum_result.output, "native_enum_value"))

    var signed_int_bits = u16(64)
    for value_type in module.types:
        match value_type.form:
            Integer(kind, bits, is_signed):
                if kind == FiirCIntegerKind.signed_int: signed_int_bits = bits
            else: pass
    if signed_int_bits < u16(64):
        let first_invalid = u64(1) << u64(signed_int_bits - u16(1))
        let invalid_source = (
            "import temperature.raw as temperature\n"
            + "pub func main(arguments: slice[str]) -> i32!:\n"
            + "    temperature.write_luce_temperature_offset(temperature.luce_degrees(" + str(first_invalid) + "))\n"
            + "    return 0\n"
        )
        let invalid_program = lower_generated_c_binding(products.raw_module, invalid_source)
        let invalid_executable = paths.join(scratch, "temperature-invalid")
        QbeToolchain().materialize(
            invalid_program,
            invalid_executable,
            [adapter_path, implementation_path],
            ["-std=c11", "-Wall", "-Wextra", "-Werror", "-I", ".", "-I", "examples/full/c_import"],
        ) catch reason:
            files.remove_all(scratch) catch cleanup_reason:
                trap(reason + "; cleanup failed: " + cleanup_reason)
            trap(reason)
        let invalid_diagnostic = paths.join(scratch, "temperature-invalid.stderr")
        let invalid_result = run_capturing_stderr(invalid_executable, invalid_diagnostic) catch reason:
            files.remove_all(scratch) catch cleanup_reason:
                trap(reason + "; cleanup failed: " + cleanup_reason)
            trap(reason)
        assert(invalid_result.status != 0)
        assert(strings.contains(invalid_result.output, "native_integer_range"))

    let invalid_enum_source = (
        "import temperature.raw as temperature\n"
        + "pub func main(arguments: slice[str]) -> i32!:\n"
        + "    discard(temperature.luce_invalid_scale())\n"
        + "    return 0\n"
    )
    let invalid_enum_program = lower_generated_c_binding(products.raw_module, invalid_enum_source)
    let invalid_enum_executable = paths.join(scratch, "temperature-invalid-enum")
    QbeToolchain().materialize(
        invalid_enum_program,
        invalid_enum_executable,
        [adapter_path, implementation_path],
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-I", ".", "-I", "examples/full/c_import"],
    ) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    let invalid_enum_diagnostic = paths.join(scratch, "temperature-invalid-enum.stderr")
    let invalid_enum_result = run_capturing_stderr(invalid_enum_executable, invalid_enum_diagnostic) catch reason:
        files.remove_all(scratch) catch cleanup_reason:
            trap(reason + "; cleanup failed: " + cleanup_reason)
        trap(reason)
    assert(invalid_enum_result.status != 0)
    assert(strings.contains(invalid_enum_result.output, "native_enum_value"))
    files.remove_all(scratch) catch reason:
        trap(reason)

# mark: Toolchain diagnostics and atomic output ================================================

pub func test_qbe_toolchain_preserves_output_and_cleans_scratch_when_qbe_fails():
    let parent = files.make_temporary_directory(".", ".luce-qbe-failure-") catch reason:
        trap(reason)
    let output = paths.join(parent, "program")
    files.write(output, "previous artifact") catch reason:
        trap(reason)

    let program = lower_source("pub func main(arguments: slice[str]) -> i32!: return 0\n")
    QbeToolchain("/luce-test/missing-qbe", "cc").materialize(program, output) catch reason:
        assert(strings.contains(reason, "qbe toolchain: qbe exited with status"))
        assert(strings.contains(reason, "/luce-test/missing-qbe"))
        let previous = files.read(output) catch read_reason:
            trap(read_reason)
        assert(previous == "previous artifact")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 1)
        assert(entries[0].name == "program")
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return

    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected a missing QBE executable to fail")

pub func test_qbe_toolchain_preserves_output_and_reports_linker_failure():
    if not has_qbe(): return
    let parent = files.make_temporary_directory(".", ".luce-qbe-failure-") catch reason:
        trap(reason)
    let output = paths.join(parent, "program")
    files.write(output, "previous artifact") catch reason:
        trap(reason)
    let compiler = paths.join(parent, "failing-cc")
    files.write(compiler, "#!/bin/sh\nif [ \"$1\" = \"-dumpmachine\" ]; then echo arm64-apple-darwin; exit 0; fi\nexit 127\n") catch reason:
        trap(reason)
    let chmod = os.Process("chmod +x " + quoted(compiler)) catch reason:
        trap(reason)
    let chmod_status = chmod.wait() catch reason:
        trap(reason)
    if chmod_status != 0: trap("cannot make fake C compiler executable")

    let program = lower_source("pub func main(arguments: slice[str]) -> i32!: return 0\n")
    QbeToolchain("qbe", compiler).materialize(program, output) catch reason:
        assert(strings.contains(reason, "qbe toolchain: host compiler exited with status"))
        let previous = files.read(output) catch read_reason:
            trap(read_reason)
        assert(previous == "previous artifact")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 2)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return

    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected a missing host compiler to fail")

pub func test_qbe_toolchain_preserves_output_when_a_supplied_c_source_fails():
    if not has_qbe(): return
    let parent = files.make_temporary_directory(".", ".luce-qbe-c-failure-") catch reason:
        trap(reason)
    let output = paths.join(parent, "program")
    let invalid_source = paths.join(parent, "invalid.c")
    files.write(output, "previous artifact") catch reason:
        trap(reason)
    files.write(invalid_source, "#error intentional supplied C failure\n") catch reason:
        trap(reason)

    let program = lower_source("pub func main(arguments: slice[str]) -> i32!: return 0\n")
    QbeToolchain().materialize(program, output, [invalid_source], ["-std=c11"]) catch reason:
        assert(strings.contains(reason, "qbe toolchain: host compiler exited with status"))
        assert(strings.contains(reason, "intentional supplied C failure"))
        let previous = files.read(output) catch read_reason:
            trap(read_reason)
        assert(previous == "previous artifact")
        let entries = files.entries(parent) catch read_reason:
            trap(read_reason)
        assert(len(entries) == 2)
        files.remove_all(parent) catch cleanup_reason:
            trap(cleanup_reason)
        return

    files.remove_all(parent) catch reason:
        trap(reason)
    trap("expected the supplied C source to fail")

# mark: Luce Base ==============================================================================

## Every shared Base fixture (tests/compiler/profiles/base/fixtures.luc) runs
## natively: the exported `answer` is called from a C driver that prints it.
pub func test_qbe_executes_every_base_fixture_natively():
    if not has_qbe(): return
    let driver = "#include <stdio.h>\n#include <stdint.h>\nint64_t answer(void);\nint main(void) { printf(\"%lld\\n\", (long long) answer()); return 0; }\n"
    for fixture in base_fixtures():
        let result = qbe_run_with_c_source(base_fixture_lowered(fixture.source), driver)
        assert(result.status == 0)
        assert(result.output == fixture.expected_output + str(fixture.expected) + "\n")
