    let ops = OperandBuilder()
    var program = create_empty_mir_program()
    program.functions.append(c_main_function(ops, [i32_t()], [
        ins(InstructionForm.Const(result = r(0), value = MirConstant.SignedInt(value = 42))),
        ins(InstructionForm.Return(values = ops.run([r(0)]))),
    ]))
    assert(qbe_run(program).status == 42)

pub func test_qbe_executes_real_lowered_control_flow_when_available():
