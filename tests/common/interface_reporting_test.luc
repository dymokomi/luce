#==============================================================================================
#
#   interface_reporting_test - Product-facing existential cost accounting
#
#   DESCRIPTION:
#       Proves that `luce explain` distinguishes boxing, dynamic calls, value
#       copy-on-write, and class identity while constrained static dispatch
#       contributes no existential cost.
#
#==============================================================================================

from luce.compiler.frontend.parser import Parser
from luce.compiler.frontend.tokenizer import Tokenizer
from luce.compiler.hir.generation_model import SourceModule
from luce.compiler.hir.generator import HirGenerator
from luce.compiler.hir.ir import ModuleAuthority
from luce.compiler.reporting.interfaces import InterfaceCostReport, report_interface_costs
import std.strings

func report(source: str) -> InterfaceCostReport:
    let tokens = Tokenizer(source).tokenize() catch reason:
        trap(reason)
    let syntax = Parser(tokens).parse() catch reason:
        trap(reason)
    let program = HirGenerator("org.luce.interface-report", [SourceModule(
        name = "main", path = "main.luc", authority = ModuleAuthority.safe, syntax = syntax,
    )]).generate() catch reason:
        trap(reason)
    return report_interface_costs(program)

# mark: Cost sites ============================================================================

pub func test_interface_cost_report_exposes_boxing_dispatch_and_payload_semantics():
    let result = report(
        "interface Counter:\n"
        + "    mutating func increment(self)\n"
        + "struct Value implements Counter:\n"
        + "    pub mutating func increment(self): return\n"
        + "class Shared implements Counter:\n"
        + "    func init(self): return\n"
        + "    pub func increment(self): return\n"
        + "func use(value: Value, shared: Shared):\n"
        + "    var first: Counter = value\n"
        + "    var second: Counter = shared\n"
        + "    first.increment()\n"
        + "    second.increment()\n"
    )
    assert(len(result.boxing_sites) == 2)
    assert(len(result.dispatch_sites) == 2)
    assert(result.boxing_sites[0].payload_semantics == "copy-on-write value")
    assert(result.boxing_sites[1].payload_semantics == "shared class identity")
    assert(result.dispatch_sites[0].is_mutating)
    let rendered = result.render()
    assert(strings.contains(rendered, "interface costs for `org.luce.interface-report`: 2 box(es), 2 dynamic call(s)"))
    assert(strings.contains(rendered, "main.luc:9:26: box `Value` as `Counter`"))
    assert(strings.contains(rendered, "main.luc:11:5: dynamic call `Counter.increment`"))
    assert(strings.contains(rendered, "value payload may detach; class payload keeps shared identity"))

pub func test_static_interface_constraints_have_no_existential_cost():
    let result = report(
        "interface Readable:\n"
        + "    func read(self) -> i64\n"
        + "struct Value implements Readable:\n"
        + "    pub func read(self) -> i64: return 42\n"
        + "func load[T: Readable](value: T) -> i64: return value.read()\n"
        + "func use() -> i64: return load(Value())\n"
    )
    assert(len(result.boxing_sites) == 0)
    assert(len(result.dispatch_sites) == 0)
