## The expression tree: an interface with a class per node, and the environment chain the
## nodes evaluate in. A function value is a closure over the environment it was defined in.
pub let bad_eval: ErrorCode = ErrorCode.package(2)

pub interface Expr:
    func eval(self, env: Env) -> float!
    func show(self) -> str

## A scope: values and functions, with the enclosing scope behind it.
pub class Env:
    let parent: Env?
    var values: map[str, float]
    var functions: map[str, Function]
    var lookups: int = 0

    pub func init(self, parent: Env?):
        self.parent = parent
        self.values = {}
        self.functions = {}

    pub func lookup(self, name: str) -> float?:
        self.lookups += 1
        if let v = self.values[name]:
            return v
        if let p = self.parent:
            return p.lookup(name)
        return none

    pub func define(self, name: str, value: float):
        self.values[name] = value

    pub func function(self, name: str) -> Function?:
        if let f = self.functions[name]:
            return f
        if let p = self.parent:
            return p.function(name)
        return none

    pub func define_function(self, name: str, f: Function):
        self.functions[name] = f

    ## How many names were looked up in this scope, its own or through it.
    pub func count(self) -> int:
        return self.lookups

## A user function: parameters, a body, and the scope it closes over.
pub class Function:
    let parameters: list[str]
    let body: Expr
    let closure: Env

    pub func init(self, parameters: list[str], body: Expr, closure: Env):
        self.parameters = parameters
        self.body = body
        self.closure = closure

    pub func apply(self, arguments: list[float]) -> float!:
        if arguments.length != self.parameters.length:
            error(bad_eval, f"expected {self.parameters.length} arguments, got {arguments.length}")
        let scope = Env(self.closure)
        var i = 0
        while i < arguments.length:
            scope.define(self.parameters[i], arguments[i])
            i += 1
        return try self.body.eval(scope)

pub class Number: Expr:
    let value: float

    pub func init(self, value: float):
        self.value = value

    pub func eval(self, env: Env) -> float!:
        return self.value

    pub func show(self) -> str:
        return str(self.value)

pub class Name: Expr:
    let text: str

    pub func init(self, text: str):
        self.text = text

    pub func eval(self, env: Env) -> float!:
        let v = env.lookup(self.text) else error(bad_eval, f"unknown name {self.text}")
        return v

    pub func show(self) -> str:
        return self.text

pub class Binary: Expr:
    let op: str
    let left: Expr
    let right: Expr

    pub func init(self, op: str, left: Expr, right: Expr):
        self.op = op
        self.left = left
        self.right = right

    pub func eval(self, env: Env) -> float!:
        let a = try self.left.eval(env)
        let b = try self.right.eval(env)
        match self.op:
            "+": return a + b
            "-": return a - b
            "*": return a * b
            "/":
                if b == 0.0:
                    error(bad_eval, "division by zero")
                return a / b
            "^": return a ** b
            _: error(bad_eval, f"unknown operator {self.op}")

    pub func show(self) -> str:
        return f"({self.left.show()} {self.op} {self.right.show()})"

pub class Negate: Expr:
    let operand: Expr

    pub func init(self, operand: Expr):
        self.operand = operand

    pub func eval(self, env: Env) -> float!:
        return -(try self.operand.eval(env))

    pub func show(self) -> str:
        return f"(-{self.operand.show()})"

pub class Call: Expr:
    let name: str
    let arguments: list[Expr]

    pub func init(self, name: str, arguments: list[Expr]):
        self.name = name
        self.arguments = arguments

    pub func eval(self, env: Env) -> float!:
        var values: list[float] = []
        for argument in self.arguments:
            values.append(try argument.eval(env))
        if let f = env.function(self.name):
            return try f.apply(values)
        return try builtin(self.name, values)

    pub func show(self) -> str:
        return f"{self.name}({self.arguments.map((a) => a.show()).join(", ")})"

func builtin(name: str, values: list[float]) -> float!:
    match name:
        "max":
            var best = values.first else error(bad_eval, "max of nothing")
            for v in values:
                if v > best:
                    best = v
            return best
        "min":
            var best = values.first else error(bad_eval, "min of nothing")
            for v in values:
                if v < best:
                    best = v
            return best
        "abs":
            if values.length != 1:
                error(bad_eval, "abs takes one argument")
            let v = values[0]
            return v if v >= 0.0 else -v
        "sum":
            var total = 0.0
            for v in values:
                total += v
            return total
        _: error(bad_eval, f"unknown function {name}")
