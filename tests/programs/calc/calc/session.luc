## A session runs lines: `name = expression` defines a value, `def f(a, b) = expression`
## a function, and any other line prints its value; a failing line is reported and the
## session goes on.
from calc.lexer import Token, tokenize, bad_input
from calc.parser import Parser
from calc.tree import Env, Function

pub struct Outcome:
    pub var line: str
    pub var text: str
    pub var failed: bool

pub class Session:
    let globals: Env
    var outcomes: list[Outcome]

    pub func init(self):
        self.globals = Env(none)
        self.outcomes = []

    pub func run(self, line: str) -> Outcome:
        let outcome = self.attempt(line) catch failure:
            recover Outcome(line = line, text = f"error: {failure.message}", failed = true)
        self.outcomes.append(outcome)
        return outcome

    func attempt(self, line: str) -> Outcome!:
        let tokens = try tokenize(line)
        if tokens.length > 3 and tokens[0] == Token.name(text = "def"):
            return try self.define(line, tokens)
        if tokens.length > 2 and tokens[1] == Token.symbol(text = "="):
            let name = match tokens[0]:
                .name(text) => text
                _ => ""
            if name != "":
                let value = try self.evaluate(tokens[2..])
                self.globals.define(name, value)
                return Outcome(line = line, text = f"{name} = {value}", failed = false)
        let value = try self.evaluate(tokens)
        return Outcome(line = line, text = str(value), failed = false)

    func evaluate(self, tokens: list[Token]) -> float!:
        let parser = Parser(tokens)
        let tree = try parser.parse()
        return try tree.eval(self.globals)

    ## `def name(p, q) = body`: the body is parsed now and evaluated at each call.
    func define(self, line: str, tokens: list[Token]) -> Outcome!:
        var at = 1
        let name = match tokens[at]:
            .name(text) => text
            _ => ""
        if name == "":
            error(bad_input, "def needs a name")
        at += 1
        if tokens[at] != Token.symbol(text = "("):
            error(bad_input, "def needs parameters")
        at += 1
        var parameters: list[str] = []
        while tokens[at] != Token.symbol(text = ")"):
            match tokens[at]:
                .name(text): parameters.append(text)
                .symbol(text):
                    if text != ",":
                        error(bad_input, f"unexpected {text} in parameters")
                _: error(bad_input, "bad parameter")
            at += 1
        at += 1
        if tokens[at] != Token.symbol(text = "="):
            error(bad_input, "def needs a body")
        at += 1
        let parser = Parser(tokens[at..])
        let body = try parser.parse()
        self.globals.define_function(name, Function(parameters, body, self.globals))
        return Outcome(line = line, text = f"def {name}({parameters.join(", ")}) = {body.show()}", failed = false)

    ## The lines that failed, in order.
    pub func failures(self) -> list[str]:
        return self.outcomes.filter((o) => o.failed).map((o) => o.line)

    pub func lookups(self) -> int:
        return self.globals.count()
