## The tokens of the little language, read from the text one scalar at a time.
pub let bad_input: ErrorCode = ErrorCode.package(1)

pub enum Token:
    number(value: float)
    name(text: str)
    symbol(text: str)
    end

func is_digit(c: str) -> bool:
    return c != "" and "0123456789".contains(c)

func is_letter(c: str) -> bool:
    return c != "" and ("abcdefghijklmnopqrstuvwxyz".contains(c) or c == "_")

## The text as tokens, ending with `end`; anything unexpected fails with its position.
pub func tokenize(text: str) -> list[Token]!:
    var tokens: list[Token] = []
    var at = 0
    while at < text.length:
        let c = text[at..<at + 1]
        if c == " " or c == "\n" or c == "\t":
            at += 1
        elif is_digit(c):
            var stop = at
            while stop < text.length and (is_digit(text[stop..<stop + 1]) or text[stop..<stop + 1] == "."):
                stop += 1
            let digits = text[at..<stop]
            let value = float(digits) catch failure:
                error(bad_input, f"bad number {digits} at {at}")
            tokens.append(Token.number(value = value))
            at = stop
        elif is_letter(c):
            var stop = at
            while stop < text.length and (is_letter(text[stop..<stop + 1]) or is_digit(text[stop..<stop + 1])):
                stop += 1
            tokens.append(Token.name(text = text[at..<stop]))
            at = stop
        elif "+-*/^(),=".contains(c):
            tokens.append(Token.symbol(text = c))
            at += 1
        else:
            error(bad_input, f"unexpected {c} at {at}")
    tokens.append(Token.end)
    return tokens

## A token's spelling for messages.
pub func spelling(t: Token) -> str:
    match t:
        .number(value): return str(value)
        .name(text): return text
        .symbol(text): return text
        .end: return "end of input"
