## Shunting-yard over the tokens: operators wait on one stack, operands on another, both
## generic over their element, until the precedence says to build a node.
from calc.lexer import Token, spelling, bad_input
from calc.tree import Expr, Number, Name, Binary, Negate, Call

pub class Stack[T]:
    var items: list[T]

    pub func init(self):
        self.items = []

    pub func push(self, item: T):
        self.items.append(item)

    pub func pop(self) -> T?:
        if self.items.length == 0:
            return none
        return self.items.pop()

    pub func top(self) -> T?:
        return self.items.last

    pub func depth(self) -> int:
        return self.items.length

## An operator waiting on the stack: its spelling, precedence, and whether it binds right.
struct Operator:
    var symbol: str
    var precedence: int
    var right: bool

func operator_of(symbol: str) -> Operator?:
    match symbol:
        "+": return Operator(symbol = "+", precedence = 1, right = false)
        "-": return Operator(symbol = "-", precedence = 1, right = false)
        "*": return Operator(symbol = "*", precedence = 2, right = false)
        "/": return Operator(symbol = "/", precedence = 2, right = false)
        "^": return Operator(symbol = "^", precedence = 3, right = true)
        _: return none

pub class Parser:
    let tokens: list[Token]
    var at: int = 0
    var operands: Stack[Expr]
    var operators: Stack[Operator]
    var nodes: int = 0

    pub func init(self, tokens: list[Token]):
        self.tokens = tokens
        self.operands = Stack()
        self.operators = Stack()

    func peek(self) -> Token:
        return self.tokens[self.at]

    func advance(self) -> Token:
        let t = self.tokens[self.at]
        if self.at + 1 < self.tokens.length:
            self.at += 1
        return t

    func is_symbol(self, text: str) -> bool:
        match self.peek():
            .symbol(spelled): return spelled == text
            _: return false

    func expect(self, text: str) -> unit!:
        if not self.is_symbol(text):
            error(bad_input, f"expected {text}, got {spelling(self.peek())}")
        discard(self.advance())

    ## The whole input as one expression.
    pub func parse(self) -> Expr!:
        let e = try self.expression()
        match self.peek():
            .end: return e
            _: error(bad_input, f"unexpected {spelling(self.peek())}")

    ## How many nodes the parser built.
    pub func built(self) -> int:
        return self.nodes

    func expression(self) -> Expr!:
        let floor = self.operators.depth()
        try self.operand()
        while let op = self.pending_operator():
            while let waiting = self.operators.top():
                if self.operators.depth() <= floor:
                    break
                if waiting.precedence > op.precedence or (waiting.precedence == op.precedence and not op.right):
                    try self.reduce()
                else:
                    break
            self.operators.push(op)
            discard(self.advance())
            try self.operand()
        while self.operators.depth() > floor:
            try self.reduce()
        let result = self.operands.pop() else error(bad_input, "nothing parsed")
        return result

    func pending_operator(self) -> Operator?:
        match self.peek():
            .symbol(text): return operator_of(text)
            _: return none

    ## The operator on top applied to the two operands on top.
    func reduce(self) -> unit!:
        let op = self.operators.pop() else error(bad_input, "no operator")
        let right = self.operands.pop() else error(bad_input, "missing operand")
        let left = self.operands.pop() else error(bad_input, "missing operand")
        self.nodes += 1
        self.operands.push(Binary(op.symbol, left, right))

    func operand(self) -> unit!:
        let t = self.advance()
        match t:
            .number(value):
                self.nodes += 1
                self.operands.push(Number(value))
            .name(text):
                if self.is_symbol("("):
                    discard(self.advance())
                    var arguments: list[Expr] = []
                    if not self.is_symbol(")"):
                        arguments.append(try self.expression())
                        while self.is_symbol(","):
                            discard(self.advance())
                            arguments.append(try self.expression())
                    try self.expect(")")
                    self.nodes += 1
                    self.operands.push(Call(text, arguments))
                else:
                    self.nodes += 1
                    self.operands.push(Name(text))
            .symbol(text):
                if text == "(":
                    let inner = try self.expression()
                    try self.expect(")")
                    self.operands.push(inner)
                elif text == "-":
                    try self.operand()
                    let operand = self.operands.pop() else error(bad_input, "missing operand")
                    self.nodes += 1
                    self.operands.push(Negate(operand))
                else:
                    error(bad_input, f"unexpected {text}")
            .end: error(bad_input, "unexpected end of input")
