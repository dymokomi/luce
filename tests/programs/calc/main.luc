# A calculator language over several modules: a lexer over scalars, a shunting-yard parser
# with generic stacks, an expression tree of classes behind an interface, closures over
# environment chains, failures reported per line, and a session that keeps going.
from calc.session import Session
from calc.lexer import tokenize, Token

pub func main(arguments: list[str]) -> int!:
    let session = Session()
    let lines = [
        "1 + 2 * 3",
        "(1 + 2) * 3",
        "2 ^ 3 ^ 2",
        "-2 ^ 2",
        "10 / 4 - 1",
        "x = 7",
        "y = x * 2 + 1",
        "max(x, y, 3) - min(1, 2)",
        "def square(n) = n * n",
        "def hyp(a, b) = square(a) + square(b)",
        "hyp(3, 4)",
        "def scaled(n) = n * y",
        "scaled(2)",
        "y = 100",
        "scaled(2)",
        "sum(1, 2, 3, 4) / abs(-2)",
        "1 / 0",
        "unknown + 1",
        "square(1, 2)",
        "3 +",
        "(1 + 2",
        "2 $ 3",
        "1.2.3 + 1",
        "def bad = 1",
        "abs()",
        "def deep(n) = n - 1",
        "deep(deep(deep(10)))",
    ]
    for line in lines:
        let outcome = session.run(line)
        print(f"{line} => {outcome.text}")
    print("failed:", session.failures())
    print("lookups:", session.lookups())
    let tokens = try tokenize("f(1, 2.5) ^ x")
    print(tokens)
    print(tokens[0] == Token.name(text = "f"), tokens.last == Token.end)
    return 0
