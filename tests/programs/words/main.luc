# A text tool: sentences and words cut by scalar, a tally over maps keyed by texts and
# tuples, ordered and displayable entries sorted by a declared compare, a generic top-n, a
# letter histogram, and a table laid out with padding.
from words.text import words_of, sentences_of, padded, right
from words.stats import Tally, Entry, Measured, top, mean_length, letters

let sample = "The quick brown fox jumps over the lazy dog. The dog sleeps; the fox does not! Does the fox dream of the dog? A résumé, a naïve café, and the fox's dog. Over and over, the dog and the fox."

func report(text: str):
    let tally = Tally()
    let sentences = sentences_of(text)
    var all: list[str] = []
    var index = 0
    for sentence in sentences:
        let words = words_of(sentence)
        print(f"{right(str(index), 2)}: {words.length} words: {sentence}")
        for word in words:
            tally.add(word)
            all.append(word)
        tally.boundary()
        index += 1
    print(f"{tally.seen()} words, {tally.unique()} unique, mean length {mean_length(all)}")
    print(padded("word", 10) + right("count", 5) + "  bar")
    for entry in top(tally.entries(), 8):
        print(padded(entry.word, 10) + right(str(entry.count), 5) + "  " + "#".repeat(entry.count))
    print("top:", top(tally.entries(), 3))
    var longest: list[Measured] = []
    for word in tally.entries():
        longest.append(Measured(word = word.word))
    print("longest:", top(longest, 4).map((m) => m.word))
    var shown: list[str] = []
    for (pair, count) in top(tally.pairs(), 3):
        let (a, b) = pair
        shown.append(f"{a} {b} x{count}")
    print("first pairs:", shown)
    let histogram = letters(all)
    var frequent: list[Entry] = []
    for (letter, count) in histogram:
        frequent.append(Entry(word = letter, count = count))
    print("letters:", top(frequent, 5), histogram.length)
    print("fox", tally.count_of("fox"), "cat", tally.count_of("cat"), "café", tally.count_of("café"))
    print(Entry(word = "a", count = 1) == Entry(word = "a", count = 1), Entry(word = "a", count = 2) < Entry(word = "b", count = 1))

pub func main(arguments: list[str]) -> int!:
    report(sample)
    report("")
    report("One. one! ONE?")
    return 0
