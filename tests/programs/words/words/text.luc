## Cutting a text into sentences and words, one scalar at a time.
func is_letter(c: str) -> bool:
    let lower = c.lower()
    return lower != "" and ("abcdefghijklmnopqrstuvwxyz".contains(lower) or lower == "é" or lower == "ï" or lower == "'")

## The words of the text, lowercased, letters and apostrophes only.
pub func words_of(text: str) -> list[str]:
    var out: list[str] = []
    var current = ""
    for c in text:
        if is_letter(c):
            current += c.lower()
        elif current != "":
            out.append(current)
            current = ""
    if current != "":
        out.append(current)
    return out

## The sentences: cut at `.`, `!` and `?`, trimmed, empty ones dropped.
pub func sentences_of(text: str) -> list[str]:
    var out: list[str] = []
    var current = ""
    for c in text:
        if c == "." or c == "!" or c == "?":
            let trimmed = current.trim()
            if trimmed != "":
                out.append(trimmed)
            current = ""
        else:
            current += c
    let rest = current.trim()
    if rest != "":
        out.append(rest)
    return out

## `text` padded with spaces on the right to `width` scalars, or cut to it.
pub func padded(text: str, width: int) -> str:
    if text.length >= width:
        return text[..<width]
    return text + " ".repeat(width - text.length)

## `text` padded on the left.
pub func right(text: str, width: int) -> str:
    if text.length >= width:
        return text
    return " ".repeat(width - text.length) + text
