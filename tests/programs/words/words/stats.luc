## Counting: a tally of words with an ordered, displayable entry per word, the top of
## any ordered list, and bigrams keyed by a tuple.
pub struct Entry: Equatable, Ordered, Display:
    pub var word: str
    pub var count: int

    func equals(self, other: Entry) -> bool:
        return self.word == other.word and self.count == other.count

    ## More frequent first, then alphabetical.
    func compare(self, other: Entry) -> int:
        if self.count != other.count:
            return other.count - self.count
        if self.word < other.word:
            return -1
        if self.word > other.word:
            return 1
        return 0

    func display(self) -> str:
        return f"{self.word}={self.count}"

pub struct Measured: Ordered, Equatable:
    pub var word: str

    func equals(self, other: Measured) -> bool:
        return self.word == other.word

    ## Longer first, then alphabetical.
    func compare(self, other: Measured) -> int:
        if self.word.length != other.word.length:
            return other.word.length - self.word.length
        if self.word < other.word:
            return -1
        if self.word > other.word:
            return 1
        return 0

pub class Tally:
    var counts: map[str, int]
    var bigrams: map[(str, str), int]
    var total: int = 0
    var previous: str? = none

    pub func init(self):
        self.counts = {}
        self.bigrams = {}

    pub func add(self, word: str):
        self.counts[word] = (self.counts[word] else 0) + 1
        self.total += 1
        if let p = self.previous:
            let key = (p, word)
            self.bigrams[key] = (self.bigrams[key] else 0) + 1
        self.previous = word

    ## A sentence boundary: the next word starts no bigram.
    pub func boundary(self):
        self.previous = none

    pub func entries(self) -> list[Entry]:
        var out: list[Entry] = []
        for (word, count) in self.counts:
            out.append(Entry(word = word, count = count))
        out.sort()
        return out

    pub func unique(self) -> int:
        return self.counts.length

    pub func seen(self) -> int:
        return self.total

    pub func pairs(self) -> list[((str, str), int)]:
        var out: list[((str, str), int)] = []
        for (pair, count) in self.bigrams:
            out.append((pair, count))
        out.sort()
        return out

    pub func count_of(self, word: str) -> int:
        return self.counts[word] else 0

## The first `n` of the values in their order.
pub func top[T: Ordered](values: list[T], n: int) -> list[T]:
    let sorted = values.sorted()
    if sorted.length <= n:
        return sorted
    return sorted[..<n]

## The mean length of the words, as a float.
pub func mean_length(words: list[str]) -> float:
    if words.length == 0:
        return 0.0
    var sum = 0
    for w in words:
        sum += w.length
    return float(sum) / float(words.length)

## A histogram of the scalars of the words.
pub func letters(words: list[str]) -> map[str, int]:
    var out: map[str, int] = {}
    for w in words:
        for c in w:
            out[c] = (out[c] else 0) + 1
    return out
