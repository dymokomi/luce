# A dependency scheduler: a graph of jobs is cut into levels, each level runs on workers
# spawned by recursion and waited in order, values cross by copy, and a broken job fails
# its level while the others are cancelled.
from scheduler.graph import Graph, Job
from scheduler.work import run_level, Outcome

func needs_of(spec: str) -> list[str]:
    return spec.split(" ").filter((s) => s != "")

func build(edges: list[(str, str, int)]) -> Graph!:
    let g = Graph()
    for (name, needs, cost) in edges:
        try g.add(name, needs_of(needs), cost)
    return g

func run(title: str, edges: list[(str, str, int)]) -> int:
    print(f"== {title}")
    let graph = build(edges) catch failure:
        print("graph:", failure.message)
        return 0
    let levels = graph.levels() catch failure:
        print("levels:", failure.message)
        return 0
    var seed = 7
    var results: map[str, Outcome] = {}
    var index = 0
    for level in levels:
        var jobs: list[Job] = []
        for name in level:
            if let job = graph.job(name):
                jobs.append(job)
        let outcomes = run_level(jobs, 0, seed) catch failure:
            print(f"level {index} ({level.join(" ")}) failed: {failure.message}")
            return 0
        for outcome in outcomes:
            results[outcome.name] = outcome
            seed = (seed + outcome.checksum) % 1000003
        print(f"level {index}: {level.join(" ")}")
        index += 1
    var total = 0
    for name in results.keys().sorted():
        if let outcome = results[name]:
            print(f"  {name}: {outcome.steps} steps, {outcome.checksum}")
            total += outcome.checksum
    print(f"{graph.size()} jobs, {levels.length} levels, total {total}")
    return total

pub func main(arguments: list[str]) -> int!:
    var sum = 0
    sum += run("diamond", [("fetch", "", 5), ("parse", "fetch", 8), ("lint", "fetch", 3), ("build", "parse lint", 13), ("ship", "build", 2)])
    sum += run("chain", [("a", "", 1), ("b", "a", 2), ("c", "b", 3), ("d", "c", 4), ("e", "d", 5), ("f", "e", 6)])
    sum += run("wide", [("w1", "", 10), ("w2", "", 20), ("w3", "", 30), ("w4", "", 40), ("w5", "", 50), ("w6", "", 60), ("join", "w1 w2 w3 w4 w5 w6", 1)])
    sum += run("broken", [("ok", "", 4), ("bad", "", -1), ("also", "", 4), ("after", "ok bad", 1)])
    sum += run("cycle", [("x", "z", 1), ("y", "x", 1), ("z", "y", 1), ("free", "", 1)])
    sum += run("missing", [("x", "ghost", 1)])
    sum += run("twice", [("x", "", 1), ("x", "", 2)])
    sum += run("empty", [])
    print("sum", sum)
    return 0
