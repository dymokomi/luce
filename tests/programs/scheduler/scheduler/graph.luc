## A job graph: jobs by name with the jobs they need, and the levels a run proceeds in.
pub let bad_graph: ErrorCode = ErrorCode.package(1)

pub struct Job:
    pub var name: str
    pub var needs: list[str]
    pub var cost: int

pub class Graph:
    var jobs: map[str, Job]
    var order: list[str]

    pub func init(self):
        self.jobs = {}
        self.order = []

    pub func add(self, name: str, needs: list[str], cost: int) -> unit!:
        if name in self.jobs:
            error(bad_graph, f"{name} is declared twice")
        self.jobs[name] = Job(name = name, needs = needs, cost = cost)
        self.order.append(name)

    pub func job(self, name: str) -> Job?:
        return self.jobs[name]

    pub func size(self) -> int:
        return self.order.length

    ## The jobs in levels: every job of a level needs only jobs of earlier levels; a
    ## missing dependency or a cycle fails naming it.
    pub func levels(self) -> list[list[str]]!:
        for name in self.order:
            let job = self.jobs[name] else continue
            for need in job.needs:
                if not (need in self.jobs):
                    error(bad_graph, f"{name} needs {need}, which is not declared")
        var placed: set[str] = {}
        var out: list[list[str]] = []
        while placed.length < self.order.length:
            var level: list[str] = []
            for name in self.order:
                if name in placed:
                    continue
                let job = self.jobs[name] else continue
                var ready = true
                for need in job.needs:
                    if not (need in placed):
                        ready = false
                if ready:
                    level.append(name)
            if level.length == 0:
                var stuck: list[str] = []
                for name in self.order:
                    if not (name in placed):
                        stuck.append(name)
                error(bad_graph, f"a cycle among {stuck.join(", ")}")
            for name in level:
                placed.insert(name)
            out.append(level)
        return out
