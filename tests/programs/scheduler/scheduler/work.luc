## What a worker does with a job: a deterministic computation over its cost, failing when
## the job is broken; the outcome is a value that crosses back from the worker.
from scheduler.graph import Job

pub let bad_job: ErrorCode = ErrorCode.package(2)

pub struct Outcome:
    pub var name: str
    pub var steps: int
    pub var checksum: int

pub func perform(job: Job, seed: int) -> Outcome!:
    if job.cost < 0:
        error(bad_job, f"{job.name} is broken")
    var h = seed
    var steps = 0
    var i = 0
    while i < job.cost:
        h = (h * 31 + i + job.name.length) % 1000003
        steps += 1
        i += 1
    for need in job.needs:
        h = (h + need.length) % 1000003
    return Outcome(name = job.name, steps = steps, checksum = h)

## A level run at once: a task per job, spawned by recursion so that they all run
## together, and waited in the order of the level; a failure ends the level.
pub func run_level(jobs: list[Job], at: int, seed: int) -> list[Outcome]!:
    if at >= jobs.length:
        return []
    let pending = spawn perform(jobs[at], seed)
    let rest = try run_level(jobs, at + 1, seed)
    let first = try wait pending
    return [first] + rest
