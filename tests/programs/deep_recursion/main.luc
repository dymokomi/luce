## The interpreter walks a Luce call through a deep chain of large Base frames, so it runs
## on a wide stack: recursion into the thousands is a clean run, not a stack fault, and past
## `interp.max_depth` it is a "call depth exceeded" trap rather than a crash. A thousand
## frames far exceed what the host's default stack holds one interpreter frame at a time.
pub func deep(n: int) -> int:
    if n <= 0:
        return 0
    return deep(n - 1) + 1

pub func main(arguments: list[str]) -> int!:
    print(deep(1000))
    return 0
