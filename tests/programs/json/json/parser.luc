## A JSON reader over the text's scalars: recursive descent, one value per document.
from json.value import Value

pub let bad_json: ErrorCode = ErrorCode.package(1)

pub class Parser:
    let text: str
    var at: int = 0

    pub func init(self, text: str):
        self.text = text

    ## The document's one value, with nothing but spaces after it.
    pub func parse(self) -> Value!:
        let v = try self.value()
        self.skip_spaces()
        if self.at != self.text.length:
            error(bad_json, f"trailing text at {self.at}")
        return v

    func peek(self) -> str:
        if self.at >= self.text.length:
            return ""
        return self.text[self.at..<self.at + 1]

    func skip_spaces(self):
        while self.peek() == " " or self.peek() == "\n":
            self.at += 1

    func expect(self, want: str) -> unit!:
        if self.peek() != want:
            error(bad_json, f"expected `{want}` at {self.at}")
        self.at += 1

    func value(self) -> Value!:
        self.skip_spaces()
        let c = self.peek()
        if c == "{":
            return try self.object()
        if c == "[":
            return try self.array()
        if c == "\"":
            return Value.text(content = try self.string())
        if c == "t":
            try self.word("true")
            return Value.boolean(flag = true)
        if c == "f":
            try self.word("false")
            return Value.boolean(flag = false)
        if c == "n":
            try self.word("null")
            return Value.null
        if c == "-" or (c >= "0" and c <= "9"):
            return try self.number()
        error(bad_json, f"unexpected `{c}` at {self.at}")

    func word(self, expected: str) -> unit!:
        var i = 0
        while i < expected.length:
            if self.peek() != expected[i..<i + 1]:
                error(bad_json, f"expected `{expected}` at {self.at}")
            self.at += 1
            i += 1

    func number(self) -> Value!:
        let start = self.at
        if self.peek() == "-":
            self.at += 1
        while self.peek() >= "0" and self.peek() <= "9" and self.peek() != "":
            self.at += 1
        if self.peek() == ".":
            self.at += 1
            while self.peek() >= "0" and self.peek() <= "9" and self.peek() != "":
                self.at += 1
        let spelled = self.text[start..<self.at]
        let amount = float(spelled) catch failure:
            error(bad_json, f"bad number `{spelled}` at {start}")
        return Value.number(amount = amount)

    func string(self) -> str!:
        try self.expect("\"")
        var pieces: list[str] = []
        while true:
            let c = self.peek()
            if c == "":
                error(bad_json, "unterminated text")
            if c == "\"":
                self.at += 1
                break
            if c == "\\":
                self.at += 1
                let escaped = self.peek()
                self.at += 1
                if escaped == "n":
                    pieces.append("\n")
                elif escaped == "t":
                    pieces.append("\t")
                elif escaped == "\"" or escaped == "\\" or escaped == "/":
                    pieces.append(escaped)
                else:
                    error(bad_json, f"unknown escape `\\{escaped}` at {self.at - 1}")
                continue
            pieces.append(c)
            self.at += 1
        return pieces.join("")

    func array(self) -> Value!:
        try self.expect("[")
        var items: list[Value] = []
        self.skip_spaces()
        if self.peek() == "]":
            self.at += 1
            return Value.array(items = items)
        while true:
            items.append(try self.value())
            self.skip_spaces()
            if self.peek() == ",":
                self.at += 1
                continue
            try self.expect("]")
            break
        return Value.array(items = items)

    func object(self) -> Value!:
        try self.expect("{")
        var members: map[str, Value] = {}
        self.skip_spaces()
        if self.peek() == "}":
            self.at += 1
            return Value.object(members = members)
        while true:
            self.skip_spaces()
            let key = try self.string()
            self.skip_spaces()
            try self.expect(":")
            members[key] = try self.value()
            self.skip_spaces()
            if self.peek() == ",":
                self.at += 1
                continue
            try self.expect("}")
            break
        return Value.object(members = members)

## The document's value.
pub func parse(text: str) -> Value!:
    return try Parser(text).parse()
