## A JSON document as a value: the six kinds, arrays and objects holding values in turn.
pub enum Value:
    null
    boolean(flag: bool)
    number(amount: float)
    text(content: str)
    array(items: list[Value])
    object(members: map[str, Value])

## How many values the document holds, itself included.
pub func size(v: Value) -> int:
    match v:
        .array(items):
            var n = 1
            for item in items:
                n += size(item)
            return n
        .object(members):
            var n = 1
            for (key, member) in members:
                discard(key)
                n += size(member)
            return n
        _: return 1

## The sum of every number in the document.
pub func total(v: Value) -> float:
    match v:
        .number(amount): return amount
        .array(items):
            var sum = 0.0
            for item in items:
                sum += total(item)
            return sum
        .object(members):
            var sum = 0.0
            for (key, member) in members:
                discard(key)
                sum += total(member)
            return sum
        _: return 0.0

## The value at a path of keys and indexes, `["users", "0", "name"]`, or none.
pub func get(v: Value, path: list[str]) -> Value?:
    var current = v
    for step in path:
        match current:
            .object(members):
                current = members[step] else return none
            .array(items):
                let index = int(step) catch failure:
                    return none
                if index < 0 or index >= items.length:
                    return none
                current = items[index]
            _: return none
    return current
