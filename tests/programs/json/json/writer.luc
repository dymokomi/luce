## JSON written back: compact on one line, or indented by two spaces per level.
from json.value import Value

pub func compact(v: Value) -> str:
    match v:
        .null: return "null"
        .boolean(flag): return "true" if flag else "false"
        .number(amount): return show_number(amount)
        .text(content): return quoted(content)
        .array(items): return "[" + items.map(compact).join(",") + "]"
        .object(members):
            var parts: list[str] = []
            for (key, member) in members:
                parts.append(quoted(key) + ":" + compact(member))
            return "{" + parts.join(",") + "}"

pub func pretty(v: Value) -> str:
    return pretty_at(v, 0)

func pretty_at(v: Value, depth: int) -> str:
    let pad = "  ".repeat(depth + 1)
    let close = "  ".repeat(depth)
    match v:
        .array(items):
            if items.length == 0:
                return "[]"
            var lines: list[str] = []
            for item in items:
                lines.append(pad + pretty_at(item, depth + 1))
            return "[\n" + lines.join(",\n") + "\n" + close + "]"
        .object(members):
            if members.length == 0:
                return "{}"
            var lines: list[str] = []
            for (key, member) in members:
                lines.append(pad + quoted(key) + ": " + pretty_at(member, depth + 1))
            return "{\n" + lines.join(",\n") + "\n" + close + "}"
        _: return compact(v)

## A whole number prints without its `.0`, as JSON writers do.
func show_number(amount: float) -> str:
    let whole = int(amount)
    if float(whole) == amount:
        return str(whole)
    return str(amount)

func quoted(text: str) -> str:
    var out: list[str] = ["\""]
    for c in text:
        if c == "\"":
            out.append("\\\"")
        elif c == "\\":
            out.append("\\\\")
        elif c == "\n":
            out.append("\\n")
        else:
            out.append(c)
    out.append("\"")
    return out.join("")
