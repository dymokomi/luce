# A JSON parser and writer over several modules: recursive enums with payloads holding
# lists and maps of themselves, a class walking a text by scalars, failures with messages,
# structural equality over the whole document, and a query by path.
import json.parser as reader
import json.writer as writer
from json.value import Value, size, total, get

func describe(text: str):
    let v = reader.parse(text) catch failure:
        print("error:", failure.message)
        return
    print(writer.compact(v))
    print(size(v), total(v))

pub func main(arguments: list[str]) -> int!:
    describe("{\"name\": \"luce\", \"tags\": [\"lang\", \"base\"], \"version\": 0.5, \"stable\": false, \"next\": null}")
    describe("[1, 2.5, -3, [4, [5]], {\"six\": 6}]")
    describe("\"esc\\\"aped\\n\"")
    describe("{\"a\": [1, 2,]}")
    describe("[1 2]")
    describe("{\"a\": tru}")
    describe("")
    let document = try reader.parse("{\"users\": [{\"name\": \"ada\", \"age\": 36}, {\"name\": \"grace\", \"age\": 45}], \"count\": 2}")
    print(writer.pretty(document))
    if let name = get(document, ["users", "1", "name"]):
        print(writer.compact(name))
    print(get(document, ["users", "5"]) == none, get(document, ["count", "x"]) == none)
    let again = try reader.parse(writer.compact(document))
    print(again == document, again == Value.null, size(document))
    var members: map[str, Value] = {}
    members["k"] = Value.array(items = [Value.number(amount = 1.0), Value.null])
    print(writer.compact(Value.object(members = members)))
    return 0
