#prisma 4.0
def package "luce-compiler" {
    str owner = "dymokomi"
    str version = "0.8.3"
    str kind = "tool"
    str language = "luce-base"
    str description = "The application language of the Luce project, and its compiler."
    str readme = "README.md"
    str entry = "src/main.lucb"

    def native "inputs" {
        str[] sources = ["src/support/sandbox_abi.c"]
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
